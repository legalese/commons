IMPORT prelude
IMPORT daydate
IMPORT `je54-nouns`
IMPORT `je54-vintage`
IMPORT `je54-v1-arts-6-16-17`

-- je54-tests-v1-arts-6-16-17: Articles 6, 16 and 17, which are in V1 only.  Expected values were written from the text of the Articles in V1 before this module was run.
-- Each of the six later texts (V2a to V2f) has the inert placeholder only, and every function refuses for them with the same wording; the two texts before 1 January 2019 refuse with the first-consolidated-version wording.

`text V1` MEANS `V1, 1 January 2019 to 27 September 2021`
`text V2a` MEANS `V2a, 28 September 2021 to 30 January 2022`
`text V2b` MEANS `V2b, 31 January 2022 to 31 August 2022`
`text V2c` MEANS `V2c, 1 September 2022 to 10 January 2024`
`text V2d` MEANS `V2d, 11 January 2024 to 23 November 2025`
`text V2e` MEANS `V2e, 24 November 2025 to 18 June 2026`
`text V2f` MEANS `V2f, 19 June 2026 to current`
`text inferred` MEANS `the inferred text from 28 March 2003 to 31 December 2018`
`text none` MEANS `no text before 28 March 2003`

GIVEN y IS A NUMBER
      mo IS A NUMBER
      d IS A NUMBER
      h IS A NUMBER
      mi IS A NUMBER
      s IS A NUMBER
GIVETH A DATETIME
`an instant in UTC` y mo d h mi s MEANS
    DATETIME_FROM_DTZ (YMD y mo d) (TIME_FROM_HMS h mi s) "Etc/UTC"

`the law passed after the commencement` MEANS `a Law passed after the commencement of the Law`

§ `Article 6(1): a repeal of a repealing enactment does not revive the enactment previously repealed, unless words are added`

#ASSERT `Article 6(1): the repeal is not construed as reviving the enactment previously repealed` `text V1` TRUE FALSE
#ASSERT NOT `Article 6(1): the repeal is not construed as reviving the enactment previously repealed` `text V1` TRUE TRUE
#ASSERT REFUSED `Article 6(1): the repeal is not construed as reviving the enactment previously repealed` `text V1` FALSE FALSE
        BECAUSE "Article 6(1) deals only where an enactment repeals a repealing enactment"

#ASSERT REFUSED `Article 6(1): the repeal is not construed as reviving the enactment previously repealed` `text V2a` TRUE FALSE
        BECAUSE "Article 6 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 6(1): the repeal is not construed as reviving the enactment previously repealed` `text V2b` TRUE FALSE
        BECAUSE "Article 6 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 6(1): the repeal is not construed as reviving the enactment previously repealed` `text V2c` TRUE FALSE
        BECAUSE "Article 6 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 6(1): the repeal is not construed as reviving the enactment previously repealed` `text V2d` TRUE FALSE
        BECAUSE "Article 6 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 6(1): the repeal is not construed as reviving the enactment previously repealed` `text V2e` TRUE FALSE
        BECAUSE "Article 6 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 6(1): the repeal is not construed as reviving the enactment previously repealed` `text V2f` TRUE FALSE
        BECAUSE "Article 6 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 6(1): the repeal is not construed as reviving the enactment previously repealed` `text inferred` TRUE FALSE
        BECAUSE "before the first consolidated version (1 January 2019)"

§ `Article 6(2): the repealed provisions remain in force until the substituted provisions come into operation`

-- The substituted provisions come into operation at the start of 1 April 2020, UTC.  The instant itself is the first moment at which they are in operation.
#ASSERT `Article 6(2): the repealed provisions remain in force` `text V1` TRUE (`an instant in UTC` 2020 3 31 23 59 59) (JUST (`an instant in UTC` 2020 4 1 0 0 0))
#ASSERT NOT `Article 6(2): the repealed provisions remain in force` `text V1` TRUE (`an instant in UTC` 2020 4 1 0 0 0) (JUST (`an instant in UTC` 2020 4 1 0 0 0))
#ASSERT NOT `Article 6(2): the repealed provisions remain in force` `text V1` TRUE (`an instant in UTC` 2020 4 1 0 0 1) (JUST (`an instant in UTC` 2020 4 1 0 0 0))
#ASSERT `Article 6(2): the repealed provisions remain in force` `text V1` TRUE (`an instant in UTC` 2030 1 1 0 0 0) NOTHING
#ASSERT REFUSED `Article 6(2): the repealed provisions remain in force` `text V1` FALSE (`an instant in UTC` 2020 3 31 23 59 59) (JUST (`an instant in UTC` 2020 4 1 0 0 0))
        BECAUSE "Article 6(2) deals only where an enactment repeals wholly or partially a former enactment and substitutes provisions for the enactment repealed"
#ASSERT REFUSED `Article 6(2): the repealed provisions remain in force` `text V2a` TRUE (`an instant in UTC` 2020 3 31 23 59 59) (JUST (`an instant in UTC` 2020 4 1 0 0 0))
        BECAUSE "Article 6 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 6(2): the repealed provisions remain in force` `text V2b` TRUE (`an instant in UTC` 2020 3 31 23 59 59) (JUST (`an instant in UTC` 2020 4 1 0 0 0))
        BECAUSE "Article 6 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 6(2): the repealed provisions remain in force` `text V2c` TRUE (`an instant in UTC` 2020 3 31 23 59 59) (JUST (`an instant in UTC` 2020 4 1 0 0 0))
        BECAUSE "Article 6 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 6(2): the repealed provisions remain in force` `text V2d` TRUE (`an instant in UTC` 2020 3 31 23 59 59) (JUST (`an instant in UTC` 2020 4 1 0 0 0))
        BECAUSE "Article 6 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 6(2): the repealed provisions remain in force` `text V2e` TRUE (`an instant in UTC` 2020 3 31 23 59 59) (JUST (`an instant in UTC` 2020 4 1 0 0 0))
        BECAUSE "Article 6 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 6(2): the repealed provisions remain in force` `text V2f` TRUE (`an instant in UTC` 2020 3 31 23 59 59) (JUST (`an instant in UTC` 2020 4 1 0 0 0))
        BECAUSE "Article 6 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 6(2): the repealed provisions remain in force` `text none` TRUE (`an instant in UTC` 2020 3 31 23 59 59) NOTHING
        BECAUSE "before the first consolidated version (1 January 2019)"

§ `Article 6(3): the repeal of an amended enactment includes the repeal of the provisions that amended it`

#ASSERT `Article 6(3): the repeal includes the repeal of the provision` `text V1` TRUE TRUE FALSE
#ASSERT NOT `Article 6(3): the repeal includes the repeal of the provision` `text V1` TRUE FALSE FALSE
#ASSERT REFUSED `Article 6(3): the repeal includes the repeal of the provision` `text V1` FALSE TRUE FALSE
        BECAUSE "Article 6(3) deals only where an enactment which has been amended by any other enactment is repealed"
#ASSERT REFUSED `Article 6(3): the repeal includes the repeal of the provision` `text V1` TRUE TRUE TRUE
        BECAUSE "a contrary intention appears: Article 6(3) does not say what the repeal then includes"
#ASSERT REFUSED `Article 6(3): the repeal includes the repeal of the provision` `text V2a` TRUE TRUE FALSE
        BECAUSE "Article 6 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 6(3): the repeal includes the repeal of the provision` `text V2b` TRUE TRUE FALSE
        BECAUSE "Article 6 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 6(3): the repeal includes the repeal of the provision` `text V2c` TRUE TRUE FALSE
        BECAUSE "Article 6 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 6(3): the repeal includes the repeal of the provision` `text V2d` TRUE TRUE FALSE
        BECAUSE "Article 6 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 6(3): the repeal includes the repeal of the provision` `text V2e` TRUE TRUE FALSE
        BECAUSE "Article 6 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 6(3): the repeal includes the repeal of the provision` `text V2f` TRUE TRUE FALSE
        BECAUSE "Article 6 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 6(3): the repeal includes the repeal of the provision` `text inferred` TRUE TRUE FALSE
        BECAUSE "before the first consolidated version (1 January 2019)"

§ `Article 16(1) and 16(2): a power may be exercised after the passing of a Law and before it comes into operation`

-- A Law passed on 1 June 2020, not to come into operation immediately, conferring a power; the power is exercised on 2 June 2020.
#ASSERT `Article 16(1) and 16(2): the power may be exercised before the Law comes into operation` `text V1` `the law passed after the commencement` (YMD 2020 6 1) TRUE (YMD 2020 6 2) TRUE FALSE
#ASSERT `Article 16(1) and 16(2): the power may be exercised before the Law comes into operation` `text V1` `Regulations passed by the States` (YMD 2020 6 1) TRUE (YMD 2020 6 2) TRUE FALSE
#ASSERT NOT `Article 16(1) and 16(2): the power may be exercised before the Law comes into operation` `text V1` `the law passed after the commencement` (YMD 2020 6 1) TRUE (YMD 2020 6 2) FALSE FALSE
-- The power exercised before the Law was passed: the Article gives no such power.
#ASSERT NOT `Article 16(1) and 16(2): the power may be exercised before the Law comes into operation` `text V1` `the law passed after the commencement` (YMD 2020 6 1) TRUE (YMD 2020 5 31) TRUE FALSE
-- A Law passed before the commencement of the Law (21 August 1954): Article 16 does not reach it.
#ASSERT NOT `Article 16(1) and 16(2): the power may be exercised before the Law comes into operation` `text V1` `the law passed after the commencement` (YMD 1954 8 20) TRUE (YMD 2020 6 2) TRUE FALSE
#ASSERT `Article 16(1) and 16(2): the power may be exercised before the Law comes into operation` `text V1` `the law passed after the commencement` (YMD 1954 8 22) TRUE (YMD 1954 8 23) TRUE FALSE
-- The same day as the passing, or as the commencement of the Law: the Article cannot say, because no time of day is given.
#ASSERT REFUSED `Article 16(1) and 16(2): the power may be exercised before the Law comes into operation` `text V1` `the law passed after the commencement` (YMD 2020 6 1) TRUE (YMD 2020 6 1) TRUE FALSE
        BECAUSE "the day alone does not show whether the power was exercised after the passing of the Law, or whether the Law was passed after the commencement of the Law on 21 August 1954, for which the Law gives no time of day"
#ASSERT REFUSED `Article 16(1) and 16(2): the power may be exercised before the Law comes into operation` `text V1` `the law passed after the commencement` (YMD 1954 8 21) TRUE (YMD 2020 6 2) TRUE FALSE
        BECAUSE "the day alone does not show whether the power was exercised after the passing of the Law, or whether the Law was passed after the commencement of the Law on 21 August 1954, for which the Law gives no time of day"
#ASSERT REFUSED `Article 16(1) and 16(2): the power may be exercised before the Law comes into operation` `text V1` `the law passed after the commencement` (YMD 2020 6 1) FALSE (YMD 2020 6 2) TRUE FALSE
        BECAUSE "Article 16(1) deals only where a Law is not to come into operation immediately on its passing and confers power to make an appointment, to pass an enactment, to give notices, to prescribe forms or to do any other thing for the purposes of the Law"
#ASSERT REFUSED `Article 16(1) and 16(2): the power may be exercised before the Law comes into operation` `text V1` `some other instrument` (YMD 2020 6 1) TRUE (YMD 2020 6 2) TRUE FALSE
        BECAUSE "Article 16 deals with a Law passed after the commencement of the Law and, by Article 16(2), with Regulations passed by the States"
#ASSERT REFUSED `Article 16(1) and 16(2): the power may be exercised before the Law comes into operation` `text V1` `the law passed after the commencement` (YMD 2020 6 1) TRUE (YMD 2020 6 2) TRUE TRUE
        BECAUSE "a contrary intention appears: Article 16(1) does not say when the power may then be exercised"
#ASSERT REFUSED `Article 16(1) and 16(2): the power may be exercised before the Law comes into operation` `text V2a` `the law passed after the commencement` (YMD 2020 6 1) TRUE (YMD 2020 6 2) TRUE FALSE
        BECAUSE "Article 16 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 16(1) and 16(2): the power may be exercised before the Law comes into operation` `text V2b` `the law passed after the commencement` (YMD 2020 6 1) TRUE (YMD 2020 6 2) TRUE FALSE
        BECAUSE "Article 16 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 16(1) and 16(2): the power may be exercised before the Law comes into operation` `text V2c` `the law passed after the commencement` (YMD 2020 6 1) TRUE (YMD 2020 6 2) TRUE FALSE
        BECAUSE "Article 16 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 16(1) and 16(2): the power may be exercised before the Law comes into operation` `text V2d` `the law passed after the commencement` (YMD 2020 6 1) TRUE (YMD 2020 6 2) TRUE FALSE
        BECAUSE "Article 16 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 16(1) and 16(2): the power may be exercised before the Law comes into operation` `text V2e` `the law passed after the commencement` (YMD 2020 6 1) TRUE (YMD 2020 6 2) TRUE FALSE
        BECAUSE "Article 16 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 16(1) and 16(2): the power may be exercised before the Law comes into operation` `text V2f` `the law passed after the commencement` (YMD 2020 6 1) TRUE (YMD 2020 6 2) TRUE FALSE
        BECAUSE "Article 16 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 16(1) and 16(2): the power may be exercised before the Law comes into operation` `text inferred` `the law passed after the commencement` (YMD 2020 6 1) TRUE (YMD 2020 6 2) TRUE FALSE
        BECAUSE "before the first consolidated version (1 January 2019)"

-- The restriction: an enactment passed under the power does not come into operation until the Law does, unless the contrary intention appears in the Law or the contrary is necessary for bringing the Law into operation.
-- The Law comes into operation at the start of 1 September 2020, UTC.
#ASSERT NOT `Article 16(1): the enactment passed under the power may come into operation at that instant` `text V1` `the law passed after the commencement` (`an instant in UTC` 2020 8 31 23 59 59) (`an instant in UTC` 2020 9 1 0 0 0) FALSE FALSE
#ASSERT `Article 16(1): the enactment passed under the power may come into operation at that instant` `text V1` `the law passed after the commencement` (`an instant in UTC` 2020 9 1 0 0 0) (`an instant in UTC` 2020 9 1 0 0 0) FALSE FALSE
#ASSERT `Article 16(1): the enactment passed under the power may come into operation at that instant` `text V1` `the law passed after the commencement` (`an instant in UTC` 2020 9 1 0 0 1) (`an instant in UTC` 2020 9 1 0 0 0) FALSE FALSE
#ASSERT `Article 16(1): the enactment passed under the power may come into operation at that instant` `text V1` `Regulations passed by the States` (`an instant in UTC` 2020 8 1 0 0 0) (`an instant in UTC` 2020 9 1 0 0 0) TRUE FALSE
#ASSERT `Article 16(1): the enactment passed under the power may come into operation at that instant` `text V1` `Regulations passed by the States` (`an instant in UTC` 2020 8 1 0 0 0) (`an instant in UTC` 2020 9 1 0 0 0) FALSE TRUE
#ASSERT NOT `Article 16(1): the enactment passed under the power may come into operation at that instant` `text V1` `Regulations passed by the States` (`an instant in UTC` 2020 8 1 0 0 0) (`an instant in UTC` 2020 9 1 0 0 0) FALSE FALSE
#ASSERT REFUSED `Article 16(1): the enactment passed under the power may come into operation at that instant` `text V1` `some other instrument` (`an instant in UTC` 2020 9 2 0 0 0) (`an instant in UTC` 2020 9 1 0 0 0) FALSE FALSE
        BECAUSE "Article 16 deals with a Law passed after the commencement of the Law and, by Article 16(2), with Regulations passed by the States"
#ASSERT REFUSED `Article 16(1): the enactment passed under the power may come into operation at that instant` `text V2a` `the law passed after the commencement` (`an instant in UTC` 2020 9 2 0 0 0) (`an instant in UTC` 2020 9 1 0 0 0) FALSE FALSE
        BECAUSE "Article 16 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 16(1): the enactment passed under the power may come into operation at that instant` `text V2b` `the law passed after the commencement` (`an instant in UTC` 2020 9 2 0 0 0) (`an instant in UTC` 2020 9 1 0 0 0) FALSE FALSE
        BECAUSE "Article 16 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 16(1): the enactment passed under the power may come into operation at that instant` `text V2c` `the law passed after the commencement` (`an instant in UTC` 2020 9 2 0 0 0) (`an instant in UTC` 2020 9 1 0 0 0) FALSE FALSE
        BECAUSE "Article 16 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 16(1): the enactment passed under the power may come into operation at that instant` `text V2d` `the law passed after the commencement` (`an instant in UTC` 2020 9 2 0 0 0) (`an instant in UTC` 2020 9 1 0 0 0) FALSE FALSE
        BECAUSE "Article 16 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 16(1): the enactment passed under the power may come into operation at that instant` `text V2e` `the law passed after the commencement` (`an instant in UTC` 2020 9 2 0 0 0) (`an instant in UTC` 2020 9 1 0 0 0) FALSE FALSE
        BECAUSE "Article 16 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 16(1): the enactment passed under the power may come into operation at that instant` `text V2f` `the law passed after the commencement` (`an instant in UTC` 2020 9 2 0 0 0) (`an instant in UTC` 2020 9 1 0 0 0) FALSE FALSE
        BECAUSE "Article 16 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 16(1): the enactment passed under the power may come into operation at that instant` `text none` `the law passed after the commencement` (`an instant in UTC` 2020 9 2 0 0 0) (`an instant in UTC` 2020 9 1 0 0 0) FALSE FALSE
        BECAUSE "before the first consolidated version (1 January 2019)"

§ `Article 17(1): a reference to provisions repealed and re-enacted is a reference to the provisions re-enacted`

#ASSERT `Article 17(1): a reference in another enactment to the provisions repealed is construed as a reference to the provisions re-enacted` `text V1` TRUE FALSE
#ASSERT REFUSED `Article 17(1): a reference in another enactment to the provisions repealed is construed as a reference to the provisions re-enacted` `text V1` FALSE FALSE
        BECAUSE "Article 17(1) deals only where an enactment repeals and re-enacts, with or without modification, provisions of a former enactment"
#ASSERT REFUSED `Article 17(1): a reference in another enactment to the provisions repealed is construed as a reference to the provisions re-enacted` `text V1` TRUE TRUE
        BECAUSE "a contrary intention appears: Article 17(1) does not say what a reference to the provisions repealed is then taken to be"
#ASSERT REFUSED `Article 17(1): a reference in another enactment to the provisions repealed is construed as a reference to the provisions re-enacted` `text V2a` TRUE FALSE
        BECAUSE "Article 17 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 17(1): a reference in another enactment to the provisions repealed is construed as a reference to the provisions re-enacted` `text V2b` TRUE FALSE
        BECAUSE "Article 17 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 17(1): a reference in another enactment to the provisions repealed is construed as a reference to the provisions re-enacted` `text V2c` TRUE FALSE
        BECAUSE "Article 17 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 17(1): a reference in another enactment to the provisions repealed is construed as a reference to the provisions re-enacted` `text V2d` TRUE FALSE
        BECAUSE "Article 17 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 17(1): a reference in another enactment to the provisions repealed is construed as a reference to the provisions re-enacted` `text V2e` TRUE FALSE
        BECAUSE "Article 17 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 17(1): a reference in another enactment to the provisions repealed is construed as a reference to the provisions re-enacted` `text V2f` TRUE FALSE
        BECAUSE "Article 17 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 17(1): a reference in another enactment to the provisions repealed is construed as a reference to the provisions re-enacted` `text inferred` TRUE FALSE
        BECAUSE "before the first consolidated version (1 January 2019)"

§ `Article 17(2): a repeal does not revive, and does not affect what was done, acquired, incurred or begun`

#ASSERT `Article 17(2): the repeal does not` `text V1` TRUE `reviving anything not in force or not existing at the time at which the repeal takes effect` FALSE
#ASSERT `Article 17(2): the repeal does not` `text V1` TRUE `affecting the previous operation of the enactment repealed or anything duly done or suffered under it` FALSE
#ASSERT `Article 17(2): the repeal does not` `text V1` TRUE `affecting any right, privilege, obligation or liability acquired, accrued or incurred under the enactment repealed` FALSE
#ASSERT `Article 17(2): the repeal does not` `text V1` TRUE `affecting any penalty, forfeiture or punishment incurred in respect of any offence committed against the enactment repealed` FALSE
#ASSERT `Article 17(2): the repeal does not` `text V1` TRUE `affecting any investigation, legal proceedings or remedy in respect of any such right, privilege, obligation, liability, penalty, forfeiture or punishment` FALSE
#ASSERT NOT `Article 17(2): the repeal does not` `text V1` TRUE `some other effect` FALSE
#ASSERT REFUSED `Article 17(2): the repeal does not` `text V1` FALSE `affecting any right, privilege, obligation or liability acquired, accrued or incurred under the enactment repealed` FALSE
        BECAUSE "Article 17(2) deals only where an enactment repeals any other enactment"
#ASSERT REFUSED `Article 17(2): the repeal does not` `text V1` TRUE `affecting any right, privilege, obligation or liability acquired, accrued or incurred under the enactment repealed` TRUE
        BECAUSE "a contrary intention appears: Article 17(2) does not say what the repeal then does"
#ASSERT REFUSED `Article 17(2): the repeal does not` `text V2a` TRUE `some other effect` FALSE
        BECAUSE "Article 17 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 17(2): the repeal does not` `text V2b` TRUE `some other effect` FALSE
        BECAUSE "Article 17 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 17(2): the repeal does not` `text V2c` TRUE `some other effect` FALSE
        BECAUSE "Article 17 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 17(2): the repeal does not` `text V2d` TRUE `some other effect` FALSE
        BECAUSE "Article 17 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 17(2): the repeal does not` `text V2e` TRUE `some other effect` FALSE
        BECAUSE "Article 17 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 17(2): the repeal does not` `text V2f` TRUE `some other effect` FALSE
        BECAUSE "Article 17 of the Interpretation (Jersey) Law 1954 is deleted from 28 September 2021 (L.8/2021); it is not in the text of the Law in force on this day"
#ASSERT REFUSED `Article 17(2): the repeal does not` `text none` TRUE `some other effect` FALSE
        BECAUSE "before the first consolidated version (1 January 2019)"

-- The closing words of 17(2).

#ASSERT `Article 17(2): the thing may be done as if the repealing enactment had not been passed` `text V1` TRUE `instituting, continuing or enforcing an investigation, legal proceeding or remedy` FALSE
#ASSERT `Article 17(2): the thing may be done as if the repealing enactment had not been passed` `text V1` TRUE `imposing a penalty, forfeiture or punishment` FALSE
#ASSERT NOT `Article 17(2): the thing may be done as if the repealing enactment had not been passed` `text V1` TRUE `something else` FALSE
#ASSERT REFUSED `Article 17(2): the thing may be done as if the repealing enactment had not been passed` `text V1` FALSE `imposing a penalty, forfeiture or punishment` FALSE
        BECAUSE "Article 17(2) deals only where an enactment repeals any other enactment"
#ASSERT REFUSED `Article 17(2): the thing may be done as if the repealing enactment had not been passed` `text V1` TRUE `imposing a penalty, forfeiture or punishment` TRUE
        BECAUSE "a contrary intention appears: Article 17(2) does not say what the repeal then does"
