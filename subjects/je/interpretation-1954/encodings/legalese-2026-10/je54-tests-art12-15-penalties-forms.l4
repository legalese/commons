#ASSERT `Article 13(3): the penalties may be imposed` `text V2d` TRUE `alternatively` FALSE
#ASSERT `Article 13(3): the penalties may be imposed` `text V2e` TRUE `alternatively` FALSE
#ASSERT `Article 13(3): the penalties may be imposed` `text V2f` TRUE `alternatively` FALSE
#ASSERT `Article 13(3): the penalties may be imposed` `text V1` TRUE `cumulatively` FALSE
#ASSERT `Article 13(3): the penalties may be imposed` `text V2a` TRUE `cumulatively` FALSE
#ASSERT `Article 13(3): the penalties may be imposed` `text V2b` TRUE `cumulatively` FALSE
#ASSERT `Article 13(3): the penalties may be imposed` `text V2c` TRUE `cumulatively` FALSE
#ASSERT `Article 13(3): the penalties may be imposed` `text V2d` TRUE `cumulatively` FALSE
#ASSERT `Article 13(3): the penalties may be imposed` `text V2e` TRUE `cumulatively` FALSE
