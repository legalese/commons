#ASSERT REFUSED `Article 13(3): the penalties may be imposed` `text V1` FALSE `cumulatively` FALSE
        BECAUSE "Article 13(3) deals only where, in an enactment, more than one penalty is specified for an offence and the word and is used; it says nothing of the word or or of any other way of joining penalties"
#ASSERT REFUSED `Article 13(3): the penalties may be imposed` `text V2f` TRUE `alternatively` TRUE
        BECAUSE "a contrary intention appears: Article 13(3) does not say how the penalties may then be imposed"
#ASSERT REFUSED `Article 13(3): the penalties may be imposed` `text inferred` TRUE `alternatively` FALSE
        BECAUSE "before the first consolidated version (1 January 2019)"

