IMPORT prelude
IMPORT daydate
IMPORT `je54-nouns`
IMPORT `je54-vintage`
IMPORT `je54-art02-05-words`

-- je54-tests-art02-05-words: Articles 2, 3 and 5.  Expected values were written from the text of the Articles (and of the Schedule definition of "person") before this module was run.

`text V1` MEANS `V1, 1 January 2019 to 27 September 2021`
`text V2c` MEANS `V2c, 1 September 2022 to 10 January 2024`
`text V2f` MEANS `V2f, 19 June 2026 to current`
`text inferred` MEANS `the inferred text from 28 March 2003 to 31 December 2018`
`text none` MEANS `no text before 28 March 2003`

§ `Article 2: gender, number and grammatical variations`

-- (a) words importing the masculine gender include females; the Article says nothing of the feminine.
#ASSERT `Article 2: how a word is read` `text V1` `a word importing the masculine gender` FALSE EQUALS `the word includes females`
#ASSERT `Article 2: how a word is read` `text V2f` `a word importing the masculine gender` FALSE EQUALS `the word includes females`
#ASSERT REFUSED `Article 2: how a word is read` `text V1` `a word importing the feminine gender` FALSE
        BECAUSE "Article 2(a) says that words importing the masculine gender include females; it says nothing about words importing the feminine gender"
-- (b) singular and plural.
#ASSERT `Article 2: how a word is read` `text V1` `a word in the singular` FALSE EQUALS `the word includes the plural`
#ASSERT `Article 2: how a word is read` `text V2c` `a word in the plural` FALSE EQUALS `the word includes the singular`
-- (c) grammatical variations of defined words.
#ASSERT `Article 2: how a word is read` `text V2f` `a grammatical variation of a word to which a definition is assigned` FALSE EQUALS `the word is construed in accordance with the definition`
-- Unless the contrary intention appears.
#ASSERT REFUSED `Article 2: how a word is read` `text V1` `a word in the singular` TRUE
        BECAUSE "a contrary intention appears: Article 2 does not say how the word is then read"
-- Before 1 January 2019.
#ASSERT REFUSED `Article 2: how a word is read` `text inferred` `a word in the singular` FALSE
        BECAUSE "before the first consolidated version (1 January 2019)"
#ASSERT REFUSED `Article 2: how a word is read` `text none` `a word in the singular` FALSE
        BECAUSE "before the first consolidated version (1 January 2019)"

§ `Article 3: person includes a body corporate in an enactment relating to a punishable offence`

-- The act is after 21 August 1954 (the date of the commencement of the Law).
#ASSERT `Article 3: person includes a body corporate` `text V1` TRUE FALSE (YMD 2020 1 1) TRUE
#ASSERT `Article 3: person includes a body corporate` `text V2f` TRUE FALSE (YMD 2026 1 1) FALSE
-- Not an enactment relating to a punishable offence: Article 3 does not deal with it.
#ASSERT REFUSED `Article 3: person includes a body corporate` `text V1` FALSE FALSE (YMD 2020 1 1) TRUE
        BECAUSE "Article 3 deals only with an enactment relating to a punishable offence; for any other enactment see the Schedule definition of person"
-- Unless the contrary intention appears.
#ASSERT REFUSED `Article 3: person includes a body corporate` `text V1` TRUE TRUE (YMD 2020 1 1) TRUE
        BECAUSE "a contrary intention appears: Article 3 does not say whether person then includes a body corporate"
#ASSERT REFUSED `Article 3: person includes a body corporate` `text inferred` TRUE FALSE (YMD 2020 1 1) TRUE
        BECAUSE "before the first consolidated version (1 January 2019)"

§§ `The proviso: acts before 21 August 1954`

-- An act or omission before the date of the commencement of the Law, by a body corporate that would not have been liable before that date: the proviso withholds liability.
#ASSERT `the proviso to Article 3 withholds liability` (YMD 1954 8 20) FALSE
#ASSERT `the proviso to Article 3 withholds liability` (YMD 1900 1 1) FALSE
-- It would have been liable before that date anyway: the proviso withholds nothing.
#ASSERT NOT `the proviso to Article 3 withholds liability` (YMD 1954 8 20) TRUE
-- On 21 August 1954 itself the act is not before the date of the commencement.
#ASSERT NOT `the proviso to Article 3 withholds liability` (YMD 1954 8 21) FALSE
#ASSERT NOT `the proviso to Article 3 withholds liability` (YMD 1954 8 22) FALSE
-- The text of the Law is selected by the day the question is about (here 2026), so the proviso can be asked about a 1950 act.
#ASSERT NOT `Article 3: person includes a body corporate` `text V2f` TRUE FALSE (YMD 1950 6 1) FALSE
#ASSERT `Article 3: person includes a body corporate` `text V2f` TRUE FALSE (YMD 1950 6 1) TRUE
#ASSERT `Article 3: person includes a body corporate` `text V2f` TRUE FALSE (YMD 1954 8 21) FALSE

§ `Article 3 with the Schedule definition of person (fork I5)`

-- A body corporate, a penal enactment, an act in 2020: both routes.
#ASSERT `how person reaches the body` `text V1` `a body corporate` TRUE FALSE (YMD 2020 1 1) FALSE `the proviso limits Article 3 only` EQUALS `by Article 3 and by the Schedule`
-- A body corporate, an enactment that is not penal: the Schedule only.
#ASSERT `how person reaches the body` `text V1` `a body corporate` FALSE FALSE (YMD 2020 1 1) FALSE `the proviso limits Article 3 only` EQUALS `by the Schedule only`
-- An unincorporated body, a penal enactment: Article 3 says body corporate, so the Schedule only.
#ASSERT `how person reaches the body` `text V2f` `a body of persons that is unincorporated` TRUE FALSE (YMD 2026 1 1) FALSE `the proviso limits Article 3 only` EQUALS `by the Schedule only`
-- The discriminating case: a body corporate, a penal enactment, an act in 1950 that it would not then have been liable for.
-- Reading taken (the proviso says "nothing in this Article"): the Schedule's definition still reaches it.
#ASSERT `how person reaches the body` `text V2f` `a body corporate` TRUE FALSE (YMD 1950 6 1) FALSE `the proviso limits Article 3 only` EQUALS `by the Schedule only`
-- The other reading: the proviso also limits the Schedule definition, so nothing reaches it.
#ASSERT `how person reaches the body` `text V2f` `a body corporate` TRUE FALSE (YMD 1950 6 1) FALSE `the proviso also limits the Schedule definition of person` EQUALS `not at all`
-- The proviso does not bite where the body would have been liable anyway: both readings agree.
#ASSERT `how person reaches the body` `text V2f` `a body corporate` TRUE FALSE (YMD 1950 6 1) TRUE `the proviso also limits the Schedule definition of person` EQUALS `by Article 3 and by the Schedule`
-- The proviso never touches an unincorporated body.
#ASSERT `how person reaches the body` `text V2f` `a body of persons that is unincorporated` TRUE FALSE (YMD 1950 6 1) FALSE `the proviso also limits the Schedule definition of person` EQUALS `by the Schedule only`
-- An act on 21 August 1954 is not before the commencement: the readings agree.
#ASSERT `how person reaches the body` `text V2f` `a body corporate` TRUE FALSE (YMD 1954 8 21) FALSE `the proviso also limits the Schedule definition of person` EQUALS `by Article 3 and by the Schedule`
-- Contrary intention, and no text.
#ASSERT REFUSED `how person reaches the body` `text V1` `a body corporate` TRUE TRUE (YMD 2020 1 1) FALSE `the proviso limits Article 3 only`
        BECAUSE "a contrary intention appears: Article 3 does not say whether person then includes a body corporate"
#ASSERT REFUSED `how person reaches the body` `text none` `a body corporate` TRUE FALSE (YMD 2020 1 1) FALSE `the proviso limits Article 3 only`
        BECAUSE "before the first consolidated version (1 January 2019)"

§ `Article 5: commonly used names`

#ASSERT `Article 5: what a commonly used name means` `text V1` "the Bailiff's Chambers" FALSE EQUALS "the Bailiff's Chambers"
#ASSERT `Article 5: what a commonly used name means` `text V2f` "the Royal Court House" FALSE EQUALS "the Royal Court House"
#ASSERT REFUSED `Article 5: what a commonly used name means` `text V1` "the Royal Court House" TRUE
        BECAUSE "the context otherwise requires: Article 5 does not say what the name then means"
#ASSERT REFUSED `Article 5: what a commonly used name means` `text inferred` "the Royal Court House" FALSE
        BECAUSE "before the first consolidated version (1 January 2019)"
