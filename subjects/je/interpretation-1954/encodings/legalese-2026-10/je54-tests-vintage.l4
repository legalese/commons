IMPORT prelude
IMPORT daydate
IMPORT `je54-nouns`
IMPORT `je54-vintage`

-- je54-tests-vintage: the text of the Law in force on a day.  The expected texts were read off the banners of the seven deposited pages ("Showing the law from ... to ...", the .meta.json beside each .html) and off the
-- Table of Legislation History of the current text before this module was run: V1 1 Jan 2019 to 27 Sep 2021; V2a 28 Sep 2021 to 30 Jan 2022; V2b 31 Jan 2022 to 31 Aug 2022; V2c 1 Sep 2022 to 10 Jan 2024;
-- V2d 11 Jan 2024 to 23 Nov 2025; V2e 24 Nov 2025 to 18 Jun 2026; V2f 19 Jun 2026 to current.  Both sides of every edge.

§ `The text in force on a day: both sides of every edge`

§§ `Before the first consolidated version`

#ASSERT `the text of the Law in force on` (YMD 1900 1 1) EQUALS `no text before 28 March 2003`
#ASSERT `the text of the Law in force on` (YMD 1954 8 21) EQUALS `no text before 28 March 2003`
#ASSERT `the text of the Law in force on` (YMD 2003 3 27) EQUALS `no text before 28 March 2003`
#ASSERT `the text of the Law in force on` (YMD 2003 3 28) EQUALS `the inferred text from 28 March 2003 to 31 December 2018`
#ASSERT `the text of the Law in force on` (YMD 2010 6 15) EQUALS `the inferred text from 28 March 2003 to 31 December 2018`
#ASSERT `the text of the Law in force on` (YMD 2018 12 31) EQUALS `the inferred text from 28 March 2003 to 31 December 2018`

§§ `V1 and V2a (the edge is the commencement of the Legislation (Jersey) Law 2021, 28 September 2021)`

#ASSERT `the text of the Law in force on` (YMD 2019 1 1) EQUALS `V1, 1 January 2019 to 27 September 2021`
#ASSERT `the text of the Law in force on` (YMD 2020 2 29) EQUALS `V1, 1 January 2019 to 27 September 2021`
#ASSERT `the text of the Law in force on` (YMD 2021 9 27) EQUALS `V1, 1 January 2019 to 27 September 2021`
#ASSERT `the text of the Law in force on` (YMD 2021 9 28) EQUALS `V2a, 28 September 2021 to 30 January 2022`
#ASSERT `the text of the Law in force on` (YMD 2022 1 30) EQUALS `V2a, 28 September 2021 to 30 January 2022`

§§ `V2b (the bank limb, 31 January 2022)`

#ASSERT `the text of the Law in force on` (YMD 2022 1 31) EQUALS `V2b, 31 January 2022 to 31 August 2022`
#ASSERT `the text of the Law in force on` (YMD 2022 8 31) EQUALS `V2b, 31 January 2022 to 31 August 2022`

§§ `V2c (the limited liability company limb, 1 September 2022)`

#ASSERT `the text of the Law in force on` (YMD 2022 9 1) EQUALS `V2c, 1 September 2022 to 10 January 2024`
#ASSERT `the text of the Law in force on` (YMD 2023 12 31) EQUALS `V2c, 1 September 2022 to 10 January 2024`
#ASSERT `the text of the Law in force on` (YMD 2024 1 10) EQUALS `V2c, 1 September 2022 to 10 January 2024`

§§ `V2d (the editorial revision of Article 1(1), 11 January 2024)`

#ASSERT `the text of the Law in force on` (YMD 2024 1 11) EQUALS `V2d, 11 January 2024 to 23 November 2025`
#ASSERT `the text of the Law in force on` (YMD 2025 11 23) EQUALS `V2d, 11 January 2024 to 23 November 2025`

§§ `V2e (child and parent, 24 November 2025)`

#ASSERT `the text of the Law in force on` (YMD 2025 11 24) EQUALS `V2e, 24 November 2025 to 18 June 2026`
#ASSERT `the text of the Law in force on` (YMD 2026 6 18) EQUALS `V2e, 24 November 2025 to 18 June 2026`

§§ `V2f (the administration order limb, 19 June 2026), to the day of the deposit`

#ASSERT `the text of the Law in force on` (YMD 2026 6 19) EQUALS `V2f, 19 June 2026 to current`
#ASSERT `the text of the Law in force on` (YMD 2026 10 28) EQUALS `V2f, 19 June 2026 to current`
#ASSERT `the text of the Law in force on` (YMD 2040 1 1) EQUALS `V2f, 19 June 2026 to current`

§ `The amendment that began a text, and the deposited file that shows it`

#ASSERT `the deposited file that shows the text of the Law in force on` (YMD 2019 1 1) EQUALS "l_17_1954_20210927"
#ASSERT `the deposited file that shows the text of the Law in force on` (YMD 2021 9 28) EQUALS "l_17_1954_20220130"
#ASSERT `the deposited file that shows the text of the Law in force on` (YMD 2022 1 31) EQUALS "l_17_1954_20220831"
#ASSERT `the deposited file that shows the text of the Law in force on` (YMD 2022 9 1) EQUALS "l_17_1954_20240110"
#ASSERT `the deposited file that shows the text of the Law in force on` (YMD 2024 1 11) EQUALS "l_17_1954_20251123"
#ASSERT `the deposited file that shows the text of the Law in force on` (YMD 2025 11 24) EQUALS "l_17_1954_20260618"
#ASSERT `the deposited file that shows the text of the Law in force on` (YMD 2026 6 19) EQUALS "l_17_1954.current"

-- The days from 28 March 2003 to 31 December 2018 have no deposited file of their own: the row points at V1's, whose endnotes are the evidence.
#ASSERT `the deposited file that shows the text of the Law in force on` (YMD 2010 1 1) EQUALS "l_17_1954_20210927"

#ASSERT `the amendment that began the text of the Law in force on` (YMD 2021 9 28) EQUALS "the Legislation (Jersey) Law 2021 (L.8/2021), in force 28 September 2021 (R&O.112/2021): it deleted Articles 1(2), 1(5), 1(6), 6, 11(3), 11(4), 16 and 17, amended Article 9(3) and inserted Article 11A"
#ASSERT `the amendment that began the text of the Law in force on` (YMD 2026 6 19) EQUALS "the Companies (Jersey) Amendment No. 2 Law 2026 (L.33/2026), in force 19 June 2026: it added a limb to Article 8 for an administration order"

§ `The Law's own days`

#ASSERT `the day on which the Interpretation (Jersey) Law 1954 came into force` EQUALS YMD 1954 8 21
#ASSERT `the day on which the Interpretation (Amendment) (Jersey) Law 2003 came into force` EQUALS YMD 2003 3 28
#ASSERT `the first day of the first consolidated version` EQUALS YMD 2019 1 1

§ `Article 18: the name by which the Law may be cited`

#ASSERT `the name by which Article 18 says the Law may be cited` EQUALS "Interpretation (Jersey) Law 1954"

§ `The refusals`

-- No file, and no amendment, for a day before 28 March 2003: the wording is the one the brief fixes.
#ASSERT REFUSED `the deposited file that shows the text of the Law in force on` (YMD 2003 3 27)
        BECAUSE "before the first consolidated version (1 January 2019)"
#ASSERT REFUSED `the amendment that began the text of the Law in force on` (YMD 1954 8 20)
        BECAUSE "before the first consolidated version (1 January 2019)"
#ASSERT REFUSED `the Law has no deposited text for a day before the first consolidated version`
        BECAUSE "before the first consolidated version (1 January 2019)"
