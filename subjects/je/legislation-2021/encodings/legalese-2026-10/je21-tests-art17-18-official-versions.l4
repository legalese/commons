IMPORT prelude
IMPORT daydate
IMPORT `je21-nouns`
IMPORT `je21-art17-18-official-versions`

-- je21-tests-art17-18-official-versions: tests for Articles 17 and 18.
-- The expected values were written by hand from the text of Articles 17 and 18 before the module was run.

§ `Articles 17 and 18 -- tests`

§§ `Names for the texts`

-- Each text is described by the five facts the reader states: its kind, Jersey legislation, the statement, the website version, the printed version.

`as-enacted Jersey text with no statement and no website` MEANS `Facts about a text` OF `as-enacted legislation`, TRUE, FALSE, FALSE, FALSE
`as-enacted UK extended text with no statement` MEANS `Facts about a text` OF `as-enacted legislation`, FALSE, FALSE, FALSE, FALSE
`consolidated Jersey text with the statement, shown on the website` MEANS `Facts about a text` OF `consolidated legislation`, TRUE, TRUE, TRUE, FALSE
`consolidated Jersey text with the statement, printed by the Principal Legislative Drafter` MEANS `Facts about a text` OF `consolidated legislation`, TRUE, TRUE, FALSE, TRUE
`consolidated Jersey text with the statement, both website and printed` MEANS `Facts about a text` OF `consolidated legislation`, TRUE, TRUE, TRUE, TRUE
`consolidated Jersey text with the statement but neither website nor printed` MEANS `Facts about a text` OF `consolidated legislation`, TRUE, TRUE, FALSE, FALSE
`consolidated Jersey text shown on the website but without the statement` MEANS `Facts about a text` OF `consolidated legislation`, TRUE, FALSE, TRUE, FALSE
`consolidated Jersey text printed but without the statement` MEANS `Facts about a text` OF `consolidated legislation`, TRUE, FALSE, FALSE, TRUE
`consolidated UK extended text with the statement, shown on the website` MEANS `Facts about a text` OF `consolidated legislation`, FALSE, TRUE, TRUE, FALSE
`revised Jersey text with the statement, printed by the Principal Legislative Drafter` MEANS `Facts about a text` OF `revised legislation`, TRUE, TRUE, FALSE, TRUE
`revised Jersey text without the statement` MEANS `Facts about a text` OF `revised legislation`, TRUE, FALSE, TRUE, TRUE

§§ `Names for the readings`

`L11 only route` MEANS `Article 17(2) is the only route, so consolidated legislation that does not meet it is not an official version`
`L11 sufficient route` MEANS `Article 17(2) is a sufficient route, so whether other consolidated legislation is an official version is not answered`

§§ `17(1) and (2) Which texts the Article makes official`

-- 17(1): all as-enacted legislation, whatever its statement and whatever it is shown on, and whether or not it is Jersey legislation.
#ASSERT `Article 17(1) and (2): the text is made an official version` `as-enacted Jersey text with no statement and no website`
#ASSERT `Article 17(1) and (2): the text is made an official version` `as-enacted UK extended text with no statement`
-- 17(2): Jersey consolidated legislation with the statement and either the website version or the printed version.
#ASSERT `Article 17(1) and (2): the text is made an official version` `consolidated Jersey text with the statement, shown on the website`
#ASSERT `Article 17(1) and (2): the text is made an official version` `consolidated Jersey text with the statement, printed by the Principal Legislative Drafter`
#ASSERT `Article 17(1) and (2): the text is made an official version` `consolidated Jersey text with the statement, both website and printed`
#ASSERT `Article 17(1) and (2): the text is made an official version` `revised Jersey text with the statement, printed by the Principal Legislative Drafter`
-- Each condition missing in turn, and the text not Jersey legislation.
#ASSERT NOT `Article 17(1) and (2): the text is made an official version` `consolidated Jersey text with the statement but neither website nor printed`
#ASSERT NOT `Article 17(1) and (2): the text is made an official version` `consolidated Jersey text shown on the website but without the statement`
#ASSERT NOT `Article 17(1) and (2): the text is made an official version` `consolidated Jersey text printed but without the statement`
#ASSERT NOT `Article 17(1) and (2): the text is made an official version` `consolidated UK extended text with the statement, shown on the website`
#ASSERT NOT `Article 17(1) and (2): the text is made an official version` `revised Jersey text without the statement`

§§ `17(1) and (2) Whether a text is an official version (fork L11)`

-- A text the Article makes official is one on both readings.
#ASSERT `Article 17(1) and (2): the text is an official version` `as-enacted Jersey text with no statement and no website` `L11 only route`
#ASSERT `Article 17(1) and (2): the text is an official version` `as-enacted Jersey text with no statement and no website` `L11 sufficient route`
#ASSERT `Article 17(1) and (2): the text is an official version` `as-enacted UK extended text with no statement` `L11 only route`
#ASSERT `Article 17(1) and (2): the text is an official version` `as-enacted UK extended text with no statement` `L11 sufficient route`
#ASSERT `Article 17(1) and (2): the text is an official version` `consolidated Jersey text with the statement, shown on the website` `L11 only route`
#ASSERT `Article 17(1) and (2): the text is an official version` `consolidated Jersey text with the statement, shown on the website` `L11 sufficient route`
#ASSERT `Article 17(1) and (2): the text is an official version` `revised Jersey text with the statement, printed by the Principal Legislative Drafter` `L11 only route`
#ASSERT `Article 17(1) and (2): the text is an official version` `revised Jersey text with the statement, printed by the Principal Legislative Drafter` `L11 sufficient route`
-- A consolidated text the Article does not make official: not official on the first reading, refused on the second.
#ASSERT NOT `Article 17(1) and (2): the text is an official version` `consolidated Jersey text with the statement but neither website nor printed` `L11 only route`
#ASSERT REFUSED `Article 17(1) and (2): the text is an official version` `consolidated Jersey text with the statement but neither website nor printed` `L11 sufficient route` BECAUSE "Article 17(2) says consolidated legislation that meets its conditions is an official version, and the Law does not say whether other consolidated legislation is one"
#ASSERT NOT `Article 17(1) and (2): the text is an official version` `consolidated Jersey text shown on the website but without the statement` `L11 only route`
#ASSERT REFUSED `Article 17(1) and (2): the text is an official version` `consolidated Jersey text shown on the website but without the statement` `L11 sufficient route` BECAUSE "Article 17(2) says consolidated legislation that meets its conditions is an official version, and the Law does not say whether other consolidated legislation is one"
#ASSERT NOT `Article 17(1) and (2): the text is an official version` `consolidated UK extended text with the statement, shown on the website` `L11 only route`
#ASSERT REFUSED `Article 17(1) and (2): the text is an official version` `consolidated UK extended text with the statement, shown on the website` `L11 sufficient route` BECAUSE "Article 17(2) says consolidated legislation that meets its conditions is an official version, and the Law does not say whether other consolidated legislation is one"
#ASSERT NOT `Article 17(1) and (2): the text is an official version` `revised Jersey text without the statement` `L11 only route`
#ASSERT REFUSED `Article 17(1) and (2): the text is an official version` `revised Jersey text without the statement` `L11 sufficient route` BECAUSE "Article 17(2) says consolidated legislation that meets its conditions is an official version, and the Law does not say whether other consolidated legislation is one"

§§ `17(3) The text of as-enacted legislation`

#ASSERT `Article 17(3): the official version is taken to set out the text of the as-enacted legislation correctly` `as-enacted Jersey text with no statement and no website`
#ASSERT `Article 17(3): the official version is taken to set out the text of the as-enacted legislation correctly` `as-enacted UK extended text with no statement`
#ASSERT REFUSED `Article 17(3): the official version is taken to set out the text of the as-enacted legislation correctly` `consolidated Jersey text with the statement, shown on the website` BECAUSE "Article 17(3) speaks of an official version of as-enacted legislation, and this text is not as-enacted legislation"
#ASSERT REFUSED `Article 17(3): the official version is taken to set out the text of the as-enacted legislation correctly` `revised Jersey text with the statement, printed by the Principal Legislative Drafter` BECAUSE "Article 17(3) speaks of an official version of as-enacted legislation, and this text is not as-enacted legislation"

§§ `17(4) The consolidated legislation, as at the date it is stated to be consolidated`

-- Official, no contrary shown, question about the stated date: taken to be correct.
#ASSERT `Article 17(4): the official version is taken to set out the consolidated legislation correctly` `consolidated Jersey text with the statement, shown on the website` FALSE TRUE
#ASSERT `Article 17(4): the official version is taken to set out the consolidated legislation correctly` `consolidated Jersey text with the statement, printed by the Principal Legislative Drafter` FALSE TRUE
#ASSERT `Article 17(4): the official version is taken to set out the consolidated legislation correctly` `revised Jersey text with the statement, printed by the Principal Legislative Drafter` FALSE TRUE
-- The contrary is shown: no longer taken to be correct.
#ASSERT NOT `Article 17(4): the official version is taken to set out the consolidated legislation correctly` `consolidated Jersey text with the statement, shown on the website` TRUE TRUE
#ASSERT NOT `Article 17(4): the official version is taken to set out the consolidated legislation correctly` `revised Jersey text with the statement, printed by the Principal Legislative Drafter` TRUE TRUE
-- Outside the paragraph.
#ASSERT REFUSED `Article 17(4): the official version is taken to set out the consolidated legislation correctly` `as-enacted Jersey text with no statement and no website` FALSE TRUE BECAUSE "Article 17(4) speaks of an official version of consolidated legislation, and this text is as-enacted legislation, which Article 17(3) deals with"
#ASSERT REFUSED `Article 17(4): the official version is taken to set out the consolidated legislation correctly` `consolidated Jersey text with the statement but neither website nor printed` FALSE TRUE BECAUSE "Article 17(4) speaks of an official version of consolidated legislation, and Article 17(2) does not make this text one"
#ASSERT REFUSED `Article 17(4): the official version is taken to set out the consolidated legislation correctly` `consolidated UK extended text with the statement, shown on the website` FALSE TRUE BECAUSE "Article 17(4) speaks of an official version of consolidated legislation, and Article 17(2) does not make this text one"
#ASSERT REFUSED `Article 17(4): the official version is taken to set out the consolidated legislation correctly` `revised Jersey text without the statement` FALSE TRUE BECAUSE "Article 17(4) speaks of an official version of consolidated legislation, and Article 17(2) does not make this text one"
#ASSERT REFUSED `Article 17(4): the official version is taken to set out the consolidated legislation correctly` `consolidated Jersey text with the statement, shown on the website` FALSE FALSE BECAUSE "Article 17(4) speaks only of the legislation as at the date on which the text is stated to be consolidated, and the Law does not say what the text is taken to set out for any other date"
#ASSERT REFUSED `Article 17(4): the official version is taken to set out the consolidated legislation correctly` `consolidated Jersey text with the statement, shown on the website` TRUE FALSE BECAUSE "Article 17(4) speaks only of the legislation as at the date on which the text is stated to be consolidated, and the Law does not say what the text is taken to set out for any other date"

§§ `17(5) Admissibility and judicial notice`

#ASSERT `Article 17(5): the text is admissible in evidence in any proceedings` `as-enacted Jersey text with no statement and no website`
#ASSERT `Article 17(5): a court or person acting judicially must take judicial notice of the text` `as-enacted Jersey text with no statement and no website`
#ASSERT `Article 17(5): the text is admissible in evidence in any proceedings` `as-enacted UK extended text with no statement`
#ASSERT `Article 17(5): a court or person acting judicially must take judicial notice of the text` `as-enacted UK extended text with no statement`
#ASSERT `Article 17(5): the text is admissible in evidence in any proceedings` `consolidated Jersey text with the statement, shown on the website`
#ASSERT `Article 17(5): a court or person acting judicially must take judicial notice of the text` `consolidated Jersey text with the statement, shown on the website`
#ASSERT `Article 17(5): the text is admissible in evidence in any proceedings` `consolidated Jersey text with the statement, printed by the Principal Legislative Drafter`
#ASSERT `Article 17(5): a court or person acting judicially must take judicial notice of the text` `consolidated Jersey text with the statement, printed by the Principal Legislative Drafter`
#ASSERT `Article 17(5): the text is admissible in evidence in any proceedings` `revised Jersey text with the statement, printed by the Principal Legislative Drafter`
#ASSERT `Article 17(5): a court or person acting judicially must take judicial notice of the text` `revised Jersey text with the statement, printed by the Principal Legislative Drafter`
#ASSERT REFUSED `Article 17(5): the text is admissible in evidence in any proceedings` `consolidated Jersey text with the statement but neither website nor printed` BECAUSE "Article 17(5) speaks of an official version of legislation, and Article 17(1) and (2) do not make this text one; the Law does not say whether any other text is admissible"
#ASSERT REFUSED `Article 17(5): a court or person acting judicially must take judicial notice of the text` `consolidated Jersey text with the statement but neither website nor printed` BECAUSE "Article 17(5) speaks of an official version of legislation, and Article 17(1) and (2) do not make this text one; the Law does not say whether a court must take notice of any other text"
#ASSERT REFUSED `Article 17(5): the text is admissible in evidence in any proceedings` `consolidated Jersey text shown on the website but without the statement` BECAUSE "Article 17(5) speaks of an official version of legislation, and Article 17(1) and (2) do not make this text one; the Law does not say whether any other text is admissible"
#ASSERT REFUSED `Article 17(5): a court or person acting judicially must take judicial notice of the text` `consolidated Jersey text shown on the website but without the statement` BECAUSE "Article 17(5) speaks of an official version of legislation, and Article 17(1) and (2) do not make this text one; the Law does not say whether a court must take notice of any other text"
#ASSERT REFUSED `Article 17(5): the text is admissible in evidence in any proceedings` `consolidated UK extended text with the statement, shown on the website` BECAUSE "Article 17(5) speaks of an official version of legislation, and Article 17(1) and (2) do not make this text one; the Law does not say whether any other text is admissible"
#ASSERT REFUSED `Article 17(5): a court or person acting judicially must take judicial notice of the text` `consolidated UK extended text with the statement, shown on the website` BECAUSE "Article 17(5) speaks of an official version of legislation, and Article 17(1) and (2) do not make this text one; the Law does not say whether a court must take notice of any other text"
#ASSERT REFUSED `Article 17(5): the text is admissible in evidence in any proceedings` `revised Jersey text without the statement` BECAUSE "Article 17(5) speaks of an official version of legislation, and Article 17(1) and (2) do not make this text one; the Law does not say whether any other text is admissible"
#ASSERT REFUSED `Article 17(5): a court or person acting judicially must take judicial notice of the text` `revised Jersey text without the statement` BECAUSE "Article 17(5) speaks of an official version of legislation, and Article 17(1) and (2) do not make this text one; the Law does not say whether a court must take notice of any other text"

§§ `18(1) and (2) What the Regulations may amend, and for what`

#ASSERT `Article 18(1) and (2): Statute Law Revision Regulations may make the amendment` TRUE `the amendment is necessary or desirable to clarify an ambiguity in the legislation`
#ASSERT `Article 18(1) and (2): Statute Law Revision Regulations may make the amendment` TRUE `the amendment is necessary or desirable to reconcile inconsistencies between different provisions of the legislation, or between any of its provisions and provisions of any other Jersey legislation`
#ASSERT `Article 18(1) and (2): Statute Law Revision Regulations may make the amendment` TRUE `the amendment uses a power set out in Article 14`
#ASSERT `Article 18(1) and (2): Statute Law Revision Regulations may make the amendment` TRUE `the amendment uses a power set out in Schedule 1`
#ASSERT NOT `Article 18(1) and (2): Statute Law Revision Regulations may make the amendment` TRUE `the amendment rests on none of these`
-- Not Jersey legislation (UK extended legislation): not within "any Jersey legislation", whatever the ground.
#ASSERT NOT `Article 18(1) and (2): Statute Law Revision Regulations may make the amendment` FALSE `the amendment is necessary or desirable to clarify an ambiguity in the legislation`
#ASSERT NOT `Article 18(1) and (2): Statute Law Revision Regulations may make the amendment` FALSE `the amendment is necessary or desirable to reconcile inconsistencies between different provisions of the legislation, or between any of its provisions and provisions of any other Jersey legislation`
#ASSERT NOT `Article 18(1) and (2): Statute Law Revision Regulations may make the amendment` FALSE `the amendment uses a power set out in Article 14`
#ASSERT NOT `Article 18(1) and (2): Statute Law Revision Regulations may make the amendment` FALSE `the amendment uses a power set out in Schedule 1`
#ASSERT NOT `Article 18(1) and (2): Statute Law Revision Regulations may make the amendment` FALSE `the amendment rests on none of these`

§§ `18(3) Amendments lodged to the proposition`

-- Not barred when the Bailiff is not of the opinion that it would alter the effect of legislation, whatever the ground and whatever is amended.
#ASSERT `Article 18(3): the amendment is not barred from being lodged` TRUE FALSE TRUE `the amendment is necessary or desirable to clarify an ambiguity in the legislation`
#ASSERT `Article 18(3): the amendment is not barred from being lodged` TRUE FALSE TRUE `the amendment rests on none of these`
#ASSERT `Article 18(3): the amendment is not barred from being lodged` TRUE FALSE FALSE `the amendment is necessary or desirable to clarify an ambiguity in the legislation`
#ASSERT `Article 18(3): the amendment is not barred from being lodged` TRUE FALSE FALSE `the amendment rests on none of these`
-- Barred when the Bailiff is of that opinion and the amendment is outside paragraphs (1) and (2): no ground, or the legislation is not Jersey legislation.
#ASSERT NOT `Article 18(3): the amendment is not barred from being lodged` TRUE TRUE TRUE `the amendment rests on none of these`
#ASSERT NOT `Article 18(3): the amendment is not barred from being lodged` TRUE TRUE FALSE `the amendment rests on none of these`
#ASSERT NOT `Article 18(3): the amendment is not barred from being lodged` TRUE TRUE FALSE `the amendment is necessary or desirable to clarify an ambiguity in the legislation`
#ASSERT NOT `Article 18(3): the amendment is not barred from being lodged` TRUE TRUE FALSE `the amendment is necessary or desirable to reconcile inconsistencies between different provisions of the legislation, or between any of its provisions and provisions of any other Jersey legislation`
#ASSERT NOT `Article 18(3): the amendment is not barred from being lodged` TRUE TRUE FALSE `the amendment uses a power set out in Article 14`
#ASSERT NOT `Article 18(3): the amendment is not barred from being lodged` TRUE TRUE FALSE `the amendment uses a power set out in Schedule 1`
-- Not barred when the Bailiff is of that opinion and the amendment is within the scope of (1) or (2).
#ASSERT `Article 18(3): the amendment is not barred from being lodged` TRUE TRUE TRUE `the amendment is necessary or desirable to clarify an ambiguity in the legislation`
#ASSERT `Article 18(3): the amendment is not barred from being lodged` TRUE TRUE TRUE `the amendment is necessary or desirable to reconcile inconsistencies between different provisions of the legislation, or between any of its provisions and provisions of any other Jersey legislation`
#ASSERT `Article 18(3): the amendment is not barred from being lodged` TRUE TRUE TRUE `the amendment uses a power set out in Article 14`
#ASSERT `Article 18(3): the amendment is not barred from being lodged` TRUE TRUE TRUE `the amendment uses a power set out in Schedule 1`
-- Outside the paragraph: the proposition is not for Regulations under Article 18.
#ASSERT REFUSED `Article 18(3): the amendment is not barred from being lodged` FALSE TRUE TRUE `the amendment rests on none of these` BECAUSE "Article 18(3) speaks of a proposition lodged in respect of Regulations to be made under Article 18, and this proposition is not one"
#ASSERT REFUSED `Article 18(3): the amendment is not barred from being lodged` FALSE FALSE TRUE `the amendment rests on none of these` BECAUSE "Article 18(3) speaks of a proposition lodged in respect of Regulations to be made under Article 18, and this proposition is not one"

§§ `18(4) What else the Regulations may contain`

#ASSERT `Article 18(4): Statute Law Revision Regulations may make the provision` TRUE TRUE
#ASSERT NOT `Article 18(4): Statute Law Revision Regulations may make the provision` TRUE FALSE
#ASSERT NOT `Article 18(4): Statute Law Revision Regulations may make the provision` FALSE TRUE
#ASSERT NOT `Article 18(4): Statute Law Revision Regulations may make the provision` FALSE FALSE
