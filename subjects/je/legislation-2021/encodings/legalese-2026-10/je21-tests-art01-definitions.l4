IMPORT prelude
IMPORT daydate
IMPORT `je21-nouns`
IMPORT `je21-art01-definitions`

-- je21-tests-art01-definitions: tests for Article 1 (Interpretation).
-- The expected values were written by hand from the definitions in Article 1 before the module was run.
-- The instruments are described by the facts of Article 1, in the field order of `Facts about an instrument`.

§ `Article 1 -- tests`

§§ `Instruments`

--                                                              Regs/Order  in Jersey  made under                                                              adopted  relies  UK Act  registered
`the Legislation (Jersey) Law 2021 itself`        MEANS `Facts about an instrument` OF FALSE,      TRUE,      `neither of these`,                                                      TRUE,    FALSE,  FALSE,  FALSE
`Regulations made under a Law`                    MEANS `Facts about an instrument` OF TRUE,       TRUE,      `Jersey legislation`,                                                    TRUE,    TRUE,   FALSE,  FALSE
`an Order of a Minister made under a Law`         MEANS `Facts about an instrument` OF TRUE,       TRUE,      `Jersey legislation`,                                                    FALSE,   TRUE,   FALSE,  FALSE
`an Order made under a registered Order in Council` MEANS `Facts about an instrument` OF TRUE,     TRUE,      `UK extended legislation or an Order in Council registered in the Royal Court`, FALSE, TRUE, FALSE,  FALSE
`an Order made in London`                         MEANS `Facts about an instrument` OF TRUE,       FALSE,     `Jersey legislation`,                                                    FALSE,   TRUE,   FALSE,  FALSE
`an Order made under nothing the Law names`       MEANS `Facts about an instrument` OF TRUE,       TRUE,      `neither of these`,                                                      FALSE,   TRUE,   FALSE,  FALSE
`a registered provision of a UK Act`              MEANS `Facts about an instrument` OF FALSE,      FALSE,     `neither of these`,                                                      FALSE,   FALSE,  TRUE,   TRUE
`an unregistered provision of a UK Act`           MEANS `Facts about an instrument` OF FALSE,      FALSE,     `neither of these`,                                                      FALSE,   FALSE,  TRUE,   FALSE

§§ `"Law"`

#ASSERT `Article 1 "Law": the instrument is a Law` `the Legislation (Jersey) Law 2021 itself` FALSE
#ASSERT NOT `Article 1 "Law": the instrument is a Law` `Regulations made under a Law` FALSE
#ASSERT NOT `Article 1 "Law": the instrument is a Law` `an Order of a Minister made under a Law` FALSE
#ASSERT NOT `Article 1 "Law": the instrument is a Law` `a registered provision of a UK Act` FALSE
#ASSERT REFUSED `Article 1 "Law": the instrument is a Law` `the Legislation (Jersey) Law 2021 itself` TRUE BECAUSE "Article 1 gives its definitions unless the context indicates otherwise, and the Law does not say what the context supplies instead"

§§ `"Jersey subordinate legislation"`

#ASSERT `Article 1 "Jersey subordinate legislation": the instrument is Jersey subordinate legislation` `Regulations made under a Law` FALSE
#ASSERT `Article 1 "Jersey subordinate legislation": the instrument is Jersey subordinate legislation` `an Order of a Minister made under a Law` FALSE
#ASSERT `Article 1 "Jersey subordinate legislation": the instrument is Jersey subordinate legislation` `an Order made under a registered Order in Council` FALSE
#ASSERT NOT `Article 1 "Jersey subordinate legislation": the instrument is Jersey subordinate legislation` `an Order made in London` FALSE
#ASSERT NOT `Article 1 "Jersey subordinate legislation": the instrument is Jersey subordinate legislation` `an Order made under nothing the Law names` FALSE
#ASSERT NOT `Article 1 "Jersey subordinate legislation": the instrument is Jersey subordinate legislation` `the Legislation (Jersey) Law 2021 itself` FALSE
#ASSERT NOT `Article 1 "Jersey subordinate legislation": the instrument is Jersey subordinate legislation` `a registered provision of a UK Act` FALSE
#ASSERT REFUSED `Article 1 "Jersey subordinate legislation": the instrument is Jersey subordinate legislation` `Regulations made under a Law` TRUE BECAUSE "Article 1 gives its definitions unless the context indicates otherwise, and the Law does not say what the context supplies instead"

§§ `"Jersey legislation"`

#ASSERT `Article 1 "Jersey legislation": the instrument is Jersey legislation` `the Legislation (Jersey) Law 2021 itself` FALSE
#ASSERT `Article 1 "Jersey legislation": the instrument is Jersey legislation` `Regulations made under a Law` FALSE
#ASSERT `Article 1 "Jersey legislation": the instrument is Jersey legislation` `an Order made under a registered Order in Council` FALSE
#ASSERT NOT `Article 1 "Jersey legislation": the instrument is Jersey legislation` `an Order made in London` FALSE
#ASSERT NOT `Article 1 "Jersey legislation": the instrument is Jersey legislation` `a registered provision of a UK Act` FALSE

§§ `"UK extended legislation" and "legislation"`

#ASSERT `Article 1 "UK extended legislation": the instrument is UK extended legislation` `a registered provision of a UK Act` FALSE
#ASSERT NOT `Article 1 "UK extended legislation": the instrument is UK extended legislation` `an unregistered provision of a UK Act` FALSE
#ASSERT NOT `Article 1 "UK extended legislation": the instrument is UK extended legislation` `Regulations made under a Law` FALSE
#ASSERT `Article 1 "legislation": the instrument is legislation` `a registered provision of a UK Act` FALSE
#ASSERT `Article 1 "legislation": the instrument is legislation` `Regulations made under a Law` FALSE
#ASSERT `Article 1 "legislation": the instrument is legislation` `the Legislation (Jersey) Law 2021 itself` FALSE
#ASSERT NOT `Article 1 "legislation": the instrument is legislation` `an unregistered provision of a UK Act` FALSE
#ASSERT NOT `Article 1 "legislation": the instrument is legislation` `an Order made under nothing the Law names` FALSE
#ASSERT REFUSED `Article 1 "UK extended legislation": the instrument is UK extended legislation` `a registered provision of a UK Act` TRUE BECAUSE "Article 1 gives its definitions unless the context indicates otherwise, and the Law does not say what the context supplies instead"
#ASSERT REFUSED `Article 1 "legislation": the instrument is legislation` `a registered provision of a UK Act` TRUE BECAUSE "Article 1 gives its definitions unless the context indicates otherwise, and the Law does not say what the context supplies instead"

§§ `"triennial Regulations"`

#ASSERT `Article 1 "triennial Regulations": the Regulations are triennial Regulations` TRUE TRUE FALSE FALSE
#ASSERT `Article 1 "triennial Regulations": the Regulations are triennial Regulations` TRUE FALSE TRUE FALSE
#ASSERT `Article 1 "triennial Regulations": the Regulations are triennial Regulations` TRUE TRUE TRUE FALSE
#ASSERT NOT `Article 1 "triennial Regulations": the Regulations are triennial Regulations` TRUE FALSE FALSE FALSE
#ASSERT NOT `Article 1 "triennial Regulations": the Regulations are triennial Regulations` FALSE TRUE TRUE FALSE
#ASSERT REFUSED `Article 1 "triennial Regulations": the Regulations are triennial Regulations` TRUE TRUE FALSE TRUE BECAUSE "Article 1 gives its definitions unless the context indicates otherwise, and the Law does not say what the context supplies instead"

§§ `"repeal"`

#ASSERT `Article 1 "repeal": what the Law does is a repeal` `the word repeal` FALSE
#ASSERT `Article 1 "repeal": what the Law does is a repeal` `the word delete` FALSE
#ASSERT `Article 1 "repeal": what the Law does is a repeal` `the word rescind` FALSE
#ASSERT `Article 1 "repeal": what the Law does is a repeal` `the word revoke` FALSE
#ASSERT REFUSED `Article 1 "repeal": what the Law does is a repeal` `another word` FALSE BECAUSE "Article 1 says only that repeal includes delete, rescind and revoke, and does not say whether any other word is a repeal"
#ASSERT REFUSED `Article 1 "repeal": what the Law does is a repeal` `the word repeal` TRUE BECAUSE "Article 1 gives its definitions unless the context indicates otherwise, and the Law does not say what the context supplies instead"

§§ `"revised"`

#ASSERT `Article 1 "revised": the legislation is revised` TRUE FALSE
#ASSERT NOT `Article 1 "revised": the legislation is revised` FALSE FALSE
#ASSERT REFUSED `Article 1 "revised": the legislation is revised` TRUE TRUE BECAUSE "Article 1 gives its definitions unless the context indicates otherwise, and the Law does not say what the context supplies instead"

§§ `"publish"`

#ASSERT `Article 1 "publish": the legislation is published` TRUE TRUE TRUE FALSE
#ASSERT NOT `Article 1 "publish": the legislation is published` FALSE TRUE TRUE FALSE
#ASSERT NOT `Article 1 "publish": the legislation is published` TRUE FALSE TRUE FALSE
#ASSERT NOT `Article 1 "publish": the legislation is published` TRUE TRUE FALSE FALSE
#ASSERT REFUSED `Article 1 "publish": the legislation is published` TRUE TRUE TRUE TRUE BECAUSE "Article 1 gives its definitions unless the context indicates otherwise, and the Law does not say what the context supplies instead"

§§ `"Legislative Drafter"`

#ASSERT `Article 1 "Legislative Drafter": the person is a Legislative Drafter` `employed, including under a contract for services, to draft legislation for the Legislative Drafting Office` FALSE
#ASSERT `Article 1 "Legislative Drafter": the person is a Legislative Drafter` `the Principal Legislative Drafter` FALSE
#ASSERT `Article 1 "Legislative Drafter": the person is a Legislative Drafter` `a trainee Legislative Drafter` FALSE
#ASSERT NOT `Article 1 "Legislative Drafter": the person is a Legislative Drafter` `none of these` FALSE
#ASSERT REFUSED `Article 1 "Legislative Drafter": the person is a Legislative Drafter` `the Principal Legislative Drafter` TRUE BECAUSE "Article 1 gives its definitions unless the context indicates otherwise, and the Law does not say what the context supplies instead"
