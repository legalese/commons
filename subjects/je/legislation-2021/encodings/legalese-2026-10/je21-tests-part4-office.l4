IMPORT prelude
IMPORT daydate
IMPORT `je21-nouns`
IMPORT `je21-part4-office`

-- je21-tests-part4-office: tests for Article 22.
-- The expected values were written by hand from the text of Article 22 before the module was run.

§ `Article 22 -- tests`

§§ `Names for the people`

`a Member of the States` MEANS `Facts about a provider of instructions` OF TRUE, FALSE, FALSE, FALSE
`an officer in a department established by the States` MEANS `Facts about a provider of instructions` OF FALSE, TRUE, FALSE, FALSE
`an officer in a body established on behalf of the States` MEANS `Facts about a provider of instructions` OF FALSE, FALSE, TRUE, FALSE
`another person who gives instructions to the Legislative Drafting Office` MEANS `Facts about a provider of instructions` OF FALSE, FALSE, FALSE, TRUE
`a person who gives no instructions and holds none of those offices` MEANS `Facts about a provider of instructions` OF FALSE, FALSE, FALSE, FALSE

§§ `Names for the other party`

`a Legislative Drafter employed under a contract for services` MEANS `employed, including under a contract for services, to draft legislation for the Legislative Drafting Office`
`the Principal Legislative Drafter as other party` MEANS `the Principal Legislative Drafter`
`a trainee Legislative Drafter as other party` MEANS `a trainee Legislative Drafter`
`someone who is none of these` MEANS `none of these`

§§ `Names for the communications`

`instructions` MEANS `instructions to draft legislation received by the Legislative Drafting Office`
`client communication` MEANS `a communication between a client of the Legislative Drafting Office and a Legislative Drafter that relates to the subject matter of the instructions`
`unpublished draft` MEANS `an unpublished draft of legislation prepared by or on behalf of the Legislative Drafting Office`
`other communication` MEANS `any other communication`

§§ `22(2) provider of instructions`

#ASSERT `Article 22(2): the person is a provider of instructions` `a Member of the States`
#ASSERT `Article 22(2): the person is a provider of instructions` `an officer in a department established by the States`
#ASSERT `Article 22(2): the person is a provider of instructions` `an officer in a body established on behalf of the States`
#ASSERT `Article 22(2): the person is a provider of instructions` `another person who gives instructions to the Legislative Drafting Office`
#ASSERT NOT `Article 22(2): the person is a provider of instructions` `a person who gives no instructions and holds none of those offices`

§§ `22(2) confidential communications`

#ASSERT `Article 22(2): the communication is a confidential communication` `instructions` TRUE
#ASSERT `Article 22(2): the communication is a confidential communication` `instructions` FALSE
#ASSERT `Article 22(2): the communication is a confidential communication` `client communication` TRUE
#ASSERT `Article 22(2): the communication is a confidential communication` `client communication` FALSE
#ASSERT `Article 22(2): the communication is a confidential communication` `unpublished draft` TRUE
#ASSERT `Article 22(2): the communication is a confidential communication` `unpublished draft` FALSE
#ASSERT `Article 22(2): the communication is a confidential communication` `other communication` TRUE
#ASSERT NOT `Article 22(2): the communication is a confidential communication` `other communication` FALSE

§§ `22(1) the privilege`

-- The Article names a provider of instructions and a Legislative Drafter, and a confidential communication.
#ASSERT `Article 22(1): the communication is subject to legal professional privilege` `a Member of the States` `a Legislative Drafter employed under a contract for services` `instructions` TRUE
#ASSERT `Article 22(1): the communication is subject to legal professional privilege` `an officer in a department established by the States` `a Legislative Drafter employed under a contract for services` `instructions` TRUE
#ASSERT `Article 22(1): the communication is subject to legal professional privilege` `an officer in a body established on behalf of the States` `a Legislative Drafter employed under a contract for services` `instructions` TRUE
#ASSERT `Article 22(1): the communication is subject to legal professional privilege` `another person who gives instructions to the Legislative Drafting Office` `a Legislative Drafter employed under a contract for services` `instructions` TRUE
#ASSERT NOT `Article 22(1): the communication is subject to legal professional privilege` `a person who gives no instructions and holds none of those offices` `a Legislative Drafter employed under a contract for services` `instructions` TRUE
-- Every kind of Legislative Drafter the Law names counts; a person who is none of them does not.
#ASSERT `Article 22(1): the communication is subject to legal professional privilege` `a Member of the States` `the Principal Legislative Drafter as other party` `client communication` FALSE
#ASSERT `Article 22(1): the communication is subject to legal professional privilege` `a Member of the States` `a trainee Legislative Drafter as other party` `client communication` FALSE
#ASSERT NOT `Article 22(1): the communication is subject to legal professional privilege` `a Member of the States` `someone who is none of these` `client communication` TRUE
-- Each kind of confidential communication gives privilege without more; any other communication only if confidential in fact.
#ASSERT `Article 22(1): the communication is subject to legal professional privilege` `a Member of the States` `a Legislative Drafter employed under a contract for services` `instructions` FALSE
#ASSERT `Article 22(1): the communication is subject to legal professional privilege` `a Member of the States` `a Legislative Drafter employed under a contract for services` `client communication` FALSE
#ASSERT `Article 22(1): the communication is subject to legal professional privilege` `a Member of the States` `a Legislative Drafter employed under a contract for services` `unpublished draft` FALSE
#ASSERT `Article 22(1): the communication is subject to legal professional privilege` `a Member of the States` `a trainee Legislative Drafter as other party` `other communication` TRUE
#ASSERT NOT `Article 22(1): the communication is subject to legal professional privilege` `a Member of the States` `a trainee Legislative Drafter as other party` `other communication` FALSE
