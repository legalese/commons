IMPORT prelude
IMPORT daydate
IMPORT domain
IMPORT `g8-nouns`
IMPORT `g8-penalties`
IMPORT `g8-art26-demand`
IMPORT `g8-tests-fixtures`

-- g8-tests-art26: tests of Article 26 and of the penalties of g8-penalties.  Every expected value was decided from the text of the Law (and from the daydate calendar by hand)
-- BEFORE the module was run; none was edited to match what the code computed.  Both sides of every threshold, every date edge on both sides, each route through each list,
-- one case per branch of each rule, and both readings of every fork Article 26 depends on.  A DEONTIC cannot be compared in #ASSERT, so each trace carries an EXPECT comment
-- above it that work/g8/check-traces.py checks.

§ `Tests of Article 26`

§§ `26(2) -- the persons`

`T26 a registered charity in the general section` MEANS
    `Person addressed by a notice under Article 26` WITH
        `capacity of the person under Article 26(2)` IS `the entity itself`
        `standing of the entity on the register` IS `entered in the general section`
        `the entity was formerly a registered charity` IS FALSE
        `governor while the entity was registered` IS FALSE

`T26 a registered charity in the restricted section` MEANS
    `Person addressed by a notice under Article 26` WITH
        `capacity of the person under Article 26(2)` IS `the entity itself`
        `standing of the entity on the register` IS `entered in the restricted section`
        `the entity was formerly a registered charity` IS FALSE
        `governor while the entity was registered` IS FALSE

`T26 an entity in the historic section` MEANS
    `Person addressed by a notice under Article 26` WITH
        `capacity of the person under Article 26(2)` IS `the entity itself`
        `standing of the entity on the register` IS `formerly registered and entered in the historic section`
        `the entity was formerly a registered charity` IS FALSE
        `governor while the entity was registered` IS FALSE

-- An applicant that was once a registered charity: "an entity that was formerly a registered charity".
`T26 an applicant that was formerly a registered charity` MEANS
    `Person addressed by a notice under Article 26` WITH
        `capacity of the person under Article 26(2)` IS `the entity itself`
        `standing of the entity on the register` IS `an applicant for registration`
        `the entity was formerly a registered charity` IS TRUE
        `governor while the entity was registered` IS FALSE

`T26 an applicant that was never registered` MEANS
    `Person addressed by a notice under Article 26` WITH
        `capacity of the person under Article 26(2)` IS `the entity itself`
        `standing of the entity on the register` IS `an applicant for registration`
        `the entity was formerly a registered charity` IS FALSE
        `governor while the entity was registered` IS FALSE

`T26 a body not on the register that was never registered` MEANS
    `Person addressed by a notice under Article 26` WITH
        `capacity of the person under Article 26(2)` IS `the entity itself`
        `standing of the entity on the register` IS `not on the register`
        `the entity was formerly a registered charity` IS FALSE
        `governor while the entity was registered` IS FALSE

`T26 a governor of a registered charity` MEANS
    `Person addressed by a notice under Article 26` WITH
        `capacity of the person under Article 26(2)` IS `a governor or former governor of the entity`
        `standing of the entity on the register` IS `entered in the general section`
        `the entity was formerly a registered charity` IS FALSE
        `governor while the entity was registered` IS TRUE

`T26 a former governor of a formerly registered entity` MEANS
    `Person addressed by a notice under Article 26` WITH
        `capacity of the person under Article 26(2)` IS `a governor or former governor of the entity`
        `standing of the entity on the register` IS `formerly registered and entered in the historic section`
        `the entity was formerly a registered charity` IS TRUE
        `governor while the entity was registered` IS TRUE

`T26 a governor of an applicant that was never registered` MEANS
    `Person addressed by a notice under Article 26` WITH
        `capacity of the person under Article 26(2)` IS `a governor or former governor of the entity`
        `standing of the entity on the register` IS `an applicant for registration`
        `the entity was formerly a registered charity` IS FALSE
        `governor while the entity was registered` IS FALSE

-- Someone who was a governor of the entity only before it was registered (F8.17): the entity is registered now, the person is no longer a governor.
`T26 a governor of an entity before it was registered` MEANS
    `Person addressed by a notice under Article 26` WITH
        `capacity of the person under Article 26(2)` IS `a governor or former governor of the entity`
        `standing of the entity on the register` IS `entered in the general section`
        `the entity was formerly a registered charity` IS FALSE
        `governor while the entity was registered` IS FALSE

`T26 an employee of a registered charity` MEANS
    `Person addressed by a notice under Article 26` WITH
        `capacity of the person under Article 26(2)` IS `a person of any other description`
        `standing of the entity on the register` IS `entered in the general section`
        `the entity was formerly a registered charity` IS FALSE
        `governor while the entity was registered` IS FALSE

#ASSERT `Art 26(2) the person falls within Article 26(2)` `the favoured interpretation` `T26 a registered charity in the general section`
#ASSERT `Art 26(2) the person falls within Article 26(2)` `the favoured interpretation` `T26 a registered charity in the restricted section`
#ASSERT `Art 26(2) the person falls within Article 26(2)` `the favoured interpretation` `T26 an entity in the historic section`
#ASSERT `Art 26(2) the person falls within Article 26(2)` `the favoured interpretation` `T26 an applicant that was formerly a registered charity`
#ASSERT NOT `Art 26(2) the person falls within Article 26(2)` `the favoured interpretation` `T26 an applicant that was never registered`
#ASSERT NOT `Art 26(2) the person falls within Article 26(2)` `the favoured interpretation` `T26 a body not on the register that was never registered`
#ASSERT `Art 26(2) the person falls within Article 26(2)` `the favoured interpretation` `T26 a governor of a registered charity`
#ASSERT `Art 26(2) the person falls within Article 26(2)` `the favoured interpretation` `T26 a former governor of a formerly registered entity`
#ASSERT NOT `Art 26(2) the person falls within Article 26(2)` `the favoured interpretation` `T26 a governor of an applicant that was never registered`
#ASSERT NOT `Art 26(2) the person falls within Article 26(2)` `the favoured interpretation` `T26 an employee of a registered charity`

-- 26(2)(a) and (b) separately.
#ASSERT `Art 26(2)(a) the person is a registered charity or an entity that was formerly one` `T26 a registered charity in the general section`
#ASSERT NOT `Art 26(2)(a) the person is a registered charity or an entity that was formerly one` `T26 a governor of a registered charity`
#ASSERT `Art 26(2)(b) the person is a governor or former governor of a registered charity or of a formerly registered entity` `the favoured interpretation` `T26 a governor of a registered charity`
#ASSERT NOT `Art 26(2)(b) the person is a governor or former governor of a registered charity or of a formerly registered entity` `the favoured interpretation` `T26 a registered charity in the general section`

-- F8.17: a person who was a governor only before the entity was registered.  Reading A (taken): within.  Reading B: not within.
#ASSERT `Art 26(2) the person falls within Article 26(2)` `the favoured interpretation` `T26 a governor of an entity before it was registered`
#ASSERT NOT `Art 26(2) the person falls within Article 26(2)` `the interpretation with the other reading of F8.17` `T26 a governor of an entity before it was registered`
-- ... and the two readings agree on a governor while registered, and on a governor of an applicant.
#ASSERT `Art 26(2) the person falls within Article 26(2)` `the interpretation with the other reading of F8.17` `T26 a governor of a registered charity`
#ASSERT NOT `Art 26(2) the person falls within Article 26(2)` `the interpretation with the other reading of F8.17` `T26 a governor of an applicant that was never registered`

§§ `26(1) -- the power`

`T26 a demand for the notice purpose, reasonably required` MEANS
    `Demand for information under Article 26(1)` WITH
        `purpose of the demand` IS `determining whether to serve a required steps notice`
        `the Commissioner reasonably requires what is demanded for that purpose` IS TRUE

`T26 a demand for the notice purpose, not reasonably required` MEANS
    `Demand for information under Article 26(1)` WITH
        `purpose of the demand` IS `determining whether to serve a required steps notice`
        `the Commissioner reasonably requires what is demanded for that purpose` IS FALSE

-- T23: an application for registration is a purpose of 26(10), not of 26(1).
`T26 a demand for an application, reasonably required` MEANS
    `Demand for information under Article 26(1)` WITH
        `purpose of the demand` IS `an application for registration`
        `the Commissioner reasonably requires what is demanded for that purpose` IS TRUE

`T26 a demand for another purpose, reasonably required` MEANS
    `Demand for information under Article 26(1)` WITH
        `purpose of the demand` IS `some other purpose`
        `the Commissioner reasonably requires what is demanded for that purpose` IS TRUE

#ASSERT `Art 26(1) the Commissioner has the power to demand` `the favoured interpretation` `T26 a registered charity in the general section` `T26 a demand for the notice purpose, reasonably required`
#ASSERT `Art 26(1) the Commissioner has the power to demand` `the favoured interpretation` `T26 a governor of a registered charity` `T26 a demand for the notice purpose, reasonably required`
#ASSERT NOT `Art 26(1) the Commissioner has the power to demand` `the favoured interpretation` `T26 a registered charity in the general section` `T26 a demand for the notice purpose, not reasonably required`
#ASSERT NOT `Art 26(1) the Commissioner has the power to demand` `the favoured interpretation` `T26 a registered charity in the general section` `T26 a demand for an application, reasonably required`
#ASSERT NOT `Art 26(1) the Commissioner has the power to demand` `the favoured interpretation` `T26 a registered charity in the general section` `T26 a demand for another purpose, reasonably required`
-- An applicant is not within 26(2), so no demand to an applicant for the notice purpose either: the Law answers (a closed list), it is not a gap.
#ASSERT NOT `Art 26(1) the Commissioner has the power to demand` `the favoured interpretation` `T26 an applicant that was never registered` `T26 a demand for the notice purpose, reasonably required`
#ASSERT NOT `Art 26(1) the Commissioner has the power to demand` `the favoured interpretation` `T26 an applicant that was never registered` `T26 a demand for an application, reasonably required`
-- A former registered charity is within.
#ASSERT `Art 26(1) the Commissioner has the power to demand` `the favoured interpretation` `T26 an entity in the historic section` `T26 a demand for the notice purpose, reasonably required`

-- With the power, the MAY stands (an unexercised permission is not a breach); exercised, it is discharged; without the power there is nothing to exercise.
-- EXPECT: STANDING MAY
#TRACE `Art 26(1) the Commissioner may require the person to provide information or attend` `the favoured interpretation` `T26 a registered charity in the general section` `T26 a demand for the notice purpose, reasonably required` AT 0 WITH
    -- no events

-- EXPECT: FULFILLED
#TRACE `Art 26(1) the Commissioner may require the person to provide information or attend` `the favoured interpretation` `T26 a registered charity in the general section` `T26 a demand for the notice purpose, reasonably required` AT 0 WITH
    PARTY `the Commissioner` DOES `serve a notice in writing requiring information, a document or attendance` AT 4

-- EXPECT: FULFILLED
#TRACE `Art 26(1) the Commissioner may require the person to provide information or attend` `the favoured interpretation` `T26 an applicant that was never registered` `T26 a demand for the notice purpose, reasonably required` AT 0 WITH
    -- no events

-- EXPECT: FULFILLED
#TRACE `Art 26(1) the Commissioner may require the person to provide information or attend` `the favoured interpretation` `T26 a registered charity in the general section` `T26 a demand for an application, reasonably required` AT 0 WITH
    -- no events

§§ `26(1)(a), (b) and 27(2) -- the time the notice specifies (F8.7)`

`T26 the first of June 2026` MEANS YMD 2026 6 1

`T26 a date fixed by the notice, the twentieth of June 2026` MEANS `a date fixed by the notice` (YMD 2026 6 20)

`T26 a period of fourteen days` MEANS `a period of days fixed by the notice` 14

-- A date is the date, on either reading.
#ASSERT `Art 26(1) the last day allowed by the notice` `the favoured interpretation` `T26 a date fixed by the notice, the twentieth of June 2026` `T26 the first of June 2026` EQUALS YMD 2026 6 20
#ASSERT `Art 26(1) the last day allowed by the notice` `the interpretation with the other reading of F8.7` `T26 a date fixed by the notice, the twentieth of June 2026` `T26 the first of June 2026` EQUALS YMD 2026 6 20
-- 14 days from service on 1 June: the 15th (day of service not counted, taken) or the 14th (day of service is day 1).
#ASSERT `Art 26(1) the last day allowed by the notice` `the favoured interpretation` `T26 a period of fourteen days` `T26 the first of June 2026` EQUALS YMD 2026 6 15
#ASSERT `Art 26(1) the last day allowed by the notice` `the interpretation with the other reading of F8.7` `T26 a period of fourteen days` `T26 the first of June 2026` EQUALS YMD 2026 6 14
-- The same as a number of days from service.
#ASSERT `Art 26(1) the days allowed by the notice` `the favoured interpretation` `T26 a period of fourteen days` `T26 the first of June 2026` EQUALS 14
#ASSERT `Art 26(1) the days allowed by the notice` `the interpretation with the other reading of F8.7` `T26 a period of fourteen days` `T26 the first of June 2026` EQUALS 13
#ASSERT `Art 26(1) the days allowed by the notice` `the favoured interpretation` `T26 a date fixed by the notice, the twentieth of June 2026` `T26 the first of June 2026` EQUALS 19
-- A period running over a month end: 14 days from 25 June 2026 is 9 July (taken); 8 July on the other reading.
#ASSERT `Art 26(1) the last day allowed by the notice` `the favoured interpretation` `T26 a period of fourteen days` (YMD 2026 6 25) EQUALS YMD 2026 7 9
#ASSERT `Art 26(1) the last day allowed by the notice` `the interpretation with the other reading of F8.7` `T26 a period of fourteen days` (YMD 2026 6 25) EQUALS YMD 2026 7 8

§§ `26(3) -- a lien`

#ASSERT `Art 26(3) the effect on a lien of providing the document` TRUE EQUALS `the lien is unaffected by the provision`
#ASSERT `Art 26(3) the effect on a lien of providing the document` FALSE EQUALS `there is no lien for Article 26(3) to preserve`

§§ `26(4) -- retaining a document, an explanation, and where the document is`

-- (a) arises when the power was exercised and the document is provided; (b) when it was exercised and the document is not provided.
-- EXPECT: STANDING MAY
#TRACE `Art 26(4)(a) the Commissioner may retain or copy the document and require an explanation` TRUE TRUE AT 0 WITH
    -- no events

-- EXPECT: FULFILLED
#TRACE `Art 26(4)(a) the Commissioner may retain or copy the document and require an explanation` TRUE FALSE AT 0 WITH
    -- no events

-- EXPECT: FULFILLED
#TRACE `Art 26(4)(a) the Commissioner may retain or copy the document and require an explanation` FALSE TRUE AT 0 WITH
    -- no events

-- EXPECT: STANDING MAY
#TRACE `Art 26(4)(b) the Commissioner may require a statement of where the document is` TRUE FALSE AT 0 WITH
    -- no events

-- EXPECT: FULFILLED
#TRACE `Art 26(4)(b) the Commissioner may require a statement of where the document is` TRUE TRUE AT 0 WITH
    -- no events

-- EXPECT: FULFILLED
#TRACE `Art 26(4)(b) the Commissioner may require a statement of where the document is` FALSE FALSE AT 0 WITH
    -- no events

-- EXPECT: FULFILLED
#TRACE `Art 26(4)(a) the Commissioner may retain or copy the document and require an explanation` TRUE TRUE AT 0 WITH
    PARTY `the Commissioner` DOES `retain or copy a document provided and require an explanation of it` AT 2

-- From whom an explanation may be required (F8.19).
`T26 the provider of the document` MEANS
    `Person asked for an explanation of a document` WITH
        `provided the document` IS TRUE
        `appears to be in possession of relevant information` IS FALSE
        `appears to be a governor or employee of the charity` IS FALSE
        `the charity is registered now` IS FALSE
        `the entity was formerly a registered charity` IS FALSE

`T26 an employee of a charity registered now` MEANS
    `Person asked for an explanation of a document` WITH
        `provided the document` IS FALSE
        `appears to be in possession of relevant information` IS TRUE
        `appears to be a governor or employee of the charity` IS TRUE
        `the charity is registered now` IS TRUE
        `the entity was formerly a registered charity` IS FALSE

`T26 an employee of a formerly registered entity` MEANS
    `Person asked for an explanation of a document` WITH
        `provided the document` IS FALSE
        `appears to be in possession of relevant information` IS TRUE
        `appears to be a governor or employee of the charity` IS TRUE
        `the charity is registered now` IS FALSE
        `the entity was formerly a registered charity` IS TRUE

`T26 an employee who appears to hold no relevant information` MEANS
    `Person asked for an explanation of a document` WITH
        `provided the document` IS FALSE
        `appears to be in possession of relevant information` IS FALSE
        `appears to be a governor or employee of the charity` IS TRUE
        `the charity is registered now` IS TRUE
        `the entity was formerly a registered charity` IS FALSE

`T26 a stranger who holds relevant information` MEANS
    `Person asked for an explanation of a document` WITH
        `provided the document` IS FALSE
        `appears to be in possession of relevant information` IS TRUE
        `appears to be a governor or employee of the charity` IS FALSE
        `the charity is registered now` IS TRUE
        `the entity was formerly a registered charity` IS FALSE

#ASSERT `Art 26(4)(a) an explanation of the document may be required of the person` `the favoured interpretation` `T26 the provider of the document`
#ASSERT `Art 26(4)(a) an explanation of the document may be required of the person` `the favoured interpretation` `T26 an employee of a charity registered now`
#ASSERT NOT `Art 26(4)(a) an explanation of the document may be required of the person` `the favoured interpretation` `T26 an employee who appears to hold no relevant information`
#ASSERT NOT `Art 26(4)(a) an explanation of the document may be required of the person` `the favoured interpretation` `T26 a stranger who holds relevant information`
-- F8.19: an employee of a formerly registered entity.  Reading A (taken): "the registered charity" is a charity registered now, so no.  Reading B: yes.
#ASSERT NOT `Art 26(4)(a) an explanation of the document may be required of the person` `the favoured interpretation` `T26 an employee of a formerly registered entity`
#ASSERT `Art 26(4)(a) an explanation of the document may be required of the person` `the interpretation with the other reading of F8.19` `T26 an employee of a formerly registered entity`
-- The provider is asked on either reading, and the readings agree on a charity registered now.
#ASSERT `Art 26(4)(a) an explanation of the document may be required of the person` `the interpretation with the other reading of F8.19` `T26 the provider of the document`
#ASSERT `Art 26(4)(a) an explanation of the document may be required of the person` `the interpretation with the other reading of F8.19` `T26 an employee of a charity registered now`

§§ `26(5) -- the retention period (F8.1, F8.9, F8.10)`

-- The document is provided on 20 February 2026 under a notice of 1 February 2026.
`T26 retention, no proceedings` MEANS
    `Facts of the retention of a document under Article 26(5)` WITH
        `day the document was provided or retained` IS YMD 2026 2 20
        `day of the notice` IS YMD 2026 2 1
        `day proceedings were commenced` IS NOTHING
        `day proceedings concluded` IS NOTHING

-- The discriminating case for F8.1: proceedings commenced on 10 February 2027, not concluded.
`T26 retention, proceedings commenced on 10 February 2027 and not concluded` MEANS
    `Facts of the retention of a document under Article 26(5)` WITH
        `day the document was provided or retained` IS YMD 2026 2 20
        `day of the notice` IS YMD 2026 2 1
        `day proceedings were commenced` IS JUST (YMD 2027 2 10)
        `day proceedings concluded` IS NOTHING

-- Commenced inside the year and concluded before the year ends: the year is the longer.
`T26 retention, proceedings commenced and concluded within the year` MEANS
    `Facts of the retention of a document under Article 26(5)` WITH
        `day the document was provided or retained` IS YMD 2026 2 20
        `day of the notice` IS YMD 2026 2 1
        `day proceedings were commenced` IS JUST (YMD 2026 6 1)
        `day proceedings concluded` IS JUST (YMD 2026 9 30)

-- Commenced inside the year and concluded after it ends: the proceedings are the longer.
`T26 retention, proceedings concluded after the year` MEANS
    `Facts of the retention of a document under Article 26(5)` WITH
        `day the document was provided or retained` IS YMD 2026 2 20
        `day of the notice` IS YMD 2026 2 1
        `day proceedings were commenced` IS JUST (YMD 2026 6 1)
        `day proceedings concluded` IS JUST (YMD 2027 5 15)

-- Commenced on the last day of the year (the anniversary, 20 February 2027), and the day after it.
`T26 retention, proceedings commenced on the anniversary` MEANS
    `Facts of the retention of a document under Article 26(5)` WITH
        `day the document was provided or retained` IS YMD 2026 2 20
        `day of the notice` IS YMD 2026 2 1
        `day proceedings were commenced` IS JUST (YMD 2027 2 20)
        `day proceedings concluded` IS NOTHING

`T26 retention, proceedings commenced the day after the anniversary` MEANS
    `Facts of the retention of a document under Article 26(5)` WITH
        `day the document was provided or retained` IS YMD 2026 2 20
        `day of the notice` IS YMD 2026 2 1
        `day proceedings were commenced` IS JUST (YMD 2027 2 21)
        `day proceedings concluded` IS NOTHING

-- Commenced before the document was provided (10 February 2026), after the notice (1 February 2026).
`T26 retention, proceedings commenced between the notice and the provision` MEANS
    `Facts of the retention of a document under Article 26(5)` WITH
        `day the document was provided or retained` IS YMD 2026 2 20
        `day of the notice` IS YMD 2026 2 1
        `day proceedings were commenced` IS JUST (YMD 2026 2 10)
        `day proceedings concluded` IS NOTHING

-- Leap day: provided on 29 February 2028.
`T26 retention from 29 February 2028, proceedings commenced on 1 March 2029` MEANS
    `Facts of the retention of a document under Article 26(5)` WITH
        `day the document was provided or retained` IS YMD 2028 2 29
        `day of the notice` IS YMD 2028 2 15
        `day proceedings were commenced` IS JUST (YMD 2029 3 1)
        `day proceedings concluded` IS NOTHING

`T26 retention from 29 February 2028, no proceedings` MEANS
    `Facts of the retention of a document under Article 26(5)` WITH
        `day the document was provided or retained` IS YMD 2028 2 29
        `day of the notice` IS YMD 2028 2 15
        `day proceedings were commenced` IS NOTHING
        `day proceedings concluded` IS NOTHING

-- The year: from 20 February 2026 it ends on 20 February 2027 (anniversary, taken) or 19 February 2027 (day before).
#ASSERT `Art 26(5)(a) the first day of the retention year` `the favoured interpretation` `T26 retention, no proceedings` EQUALS YMD 2026 2 20
#ASSERT `Art 26(5)(a) the first day of the retention year` `the interpretation with the other reading of F8.1` `T26 retention, no proceedings` EQUALS YMD 2026 2 1
#ASSERT `Art 26(5)(a) the last day of the retention year` `the favoured interpretation` (YMD 2026 2 20) EQUALS YMD 2027 2 20
#ASSERT `Art 26(5)(a) the last day of the retention year` `the interpretation with the other reading of F8.9` (YMD 2026 2 20) EQUALS YMD 2027 2 19
-- From 29 February 2028 a year ends on 28 February 2029 (clamp, taken) or 1 March 2029 (roll); with the day before: 27 February or 28 February.
#ASSERT `Art 26(5)(a) the last day of the retention year` `the favoured interpretation` (YMD 2028 2 29) EQUALS YMD 2029 2 28
#ASSERT `Art 26(5)(a) the last day of the retention year` `the interpretation with the other reading of F8.10` (YMD 2028 2 29) EQUALS YMD 2029 3 1
#ASSERT `Art 26(5)(a) the last day of the retention year` `the interpretation with the other reading of F8.9` (YMD 2028 2 29) EQUALS YMD 2029 2 27
-- An ordinary day of a leap year: 29 February 2028 is the only day the two year-readings differ on, so 1 March 2028 gives 1 March 2029 on both.
#ASSERT `Art 26(5)(a) the last day of the retention year` `the favoured interpretation` (YMD 2028 3 1) EQUALS YMD 2029 3 1
#ASSERT `Art 26(5)(a) the last day of the retention year` `the interpretation with the other reading of F8.10` (YMD 2028 3 1) EQUALS YMD 2029 3 1

-- No proceedings: keep it to the last day of the year, on both sides of the edge.
#ASSERT `Art 26(5) the Commissioner may keep the document until` `the favoured interpretation` `T26 retention, no proceedings` EQUALS `retention is permitted up to and including` (YMD 2027 2 20)
#ASSERT `Art 26(5) retention is permitted on` `the favoured interpretation` `T26 retention, no proceedings` (YMD 2027 2 20)
#ASSERT NOT `Art 26(5) retention is permitted on` `the favoured interpretation` `T26 retention, no proceedings` (YMD 2027 2 21)
#ASSERT `Art 26(5) retention is permitted on` `the favoured interpretation` `T26 retention, no proceedings` (YMD 2026 2 20)
-- F8.9 other reading: the year ends the day before the anniversary.
#ASSERT `Art 26(5) retention is permitted on` `the interpretation with the other reading of F8.9` `T26 retention, no proceedings` (YMD 2027 2 19)
#ASSERT NOT `Art 26(5) retention is permitted on` `the interpretation with the other reading of F8.9` `T26 retention, no proceedings` (YMD 2027 2 20)
-- F8.1 other reading: the year runs from the notice of 1 February 2026 to 1 February 2027.
#ASSERT `Art 26(5) retention is permitted on` `the interpretation with the other reading of F8.1` `T26 retention, no proceedings` (YMD 2027 2 1)
#ASSERT NOT `Art 26(5) retention is permitted on` `the interpretation with the other reading of F8.1` `T26 retention, no proceedings` (YMD 2027 2 2)

-- The F8.1 case: proceedings commenced on 10 February 2027.  Taken: within the year (to 20 Feb 2027), not concluded - kept until they conclude.
-- Other reading: the year ended on 1 February 2027, before they were commenced - kept to 1 February 2027 only.
#ASSERT `Art 26(5) the Commissioner may keep the document until` `the favoured interpretation` `T26 retention, proceedings commenced on 10 February 2027 and not concluded` EQUALS `retention is permitted until proceedings conclude, and they have not concluded`
#ASSERT `Art 26(5) the Commissioner may keep the document until` `the interpretation with the other reading of F8.1` `T26 retention, proceedings commenced on 10 February 2027 and not concluded` EQUALS `retention is permitted up to and including` (YMD 2027 2 1)
#ASSERT `Art 26(5) retention is permitted on` `the favoured interpretation` `T26 retention, proceedings commenced on 10 February 2027 and not concluded` (YMD 2030 1 1)
#ASSERT NOT `Art 26(5) retention is permitted on` `the interpretation with the other reading of F8.1` `T26 retention, proceedings commenced on 10 February 2027 and not concluded` (YMD 2027 2 2)

-- Concluded within the year: the year is the longer.  Concluded after it: the proceedings are.
#ASSERT `Art 26(5) the Commissioner may keep the document until` `the favoured interpretation` `T26 retention, proceedings commenced and concluded within the year` EQUALS `retention is permitted up to and including` (YMD 2027 2 20)
#ASSERT `Art 26(5) the Commissioner may keep the document until` `the favoured interpretation` `T26 retention, proceedings concluded after the year` EQUALS `retention is permitted up to and including` (YMD 2027 5 15)
#ASSERT `Art 26(5) retention is permitted on` `the favoured interpretation` `T26 retention, proceedings concluded after the year` (YMD 2027 5 15)
#ASSERT NOT `Art 26(5) retention is permitted on` `the favoured interpretation` `T26 retention, proceedings concluded after the year` (YMD 2027 5 16)

-- Commenced on the last day of the year: within it (taken, the last day is the anniversary).  The day after: not within.
#ASSERT `Art 26(5)(b) proceedings were commenced within the retention year` `the favoured interpretation` `T26 retention, proceedings commenced on the anniversary`
#ASSERT NOT `Art 26(5)(b) proceedings were commenced within the retention year` `the favoured interpretation` `T26 retention, proceedings commenced the day after the anniversary`
#ASSERT `Art 26(5) the Commissioner may keep the document until` `the favoured interpretation` `T26 retention, proceedings commenced on the anniversary` EQUALS `retention is permitted until proceedings conclude, and they have not concluded`
#ASSERT `Art 26(5) the Commissioner may keep the document until` `the favoured interpretation` `T26 retention, proceedings commenced the day after the anniversary` EQUALS `retention is permitted up to and including` (YMD 2027 2 20)
-- F8.9 other reading: the last day is 19 February 2027, so proceedings commenced on 20 February 2027 are after the year.
#ASSERT NOT `Art 26(5)(b) proceedings were commenced within the retention year` `the interpretation with the other reading of F8.9` `T26 retention, proceedings commenced on the anniversary`

-- Commenced before the document was provided but after the notice: not within the year when it runs from the provision (taken); within it when it runs from the notice.
#ASSERT NOT `Art 26(5)(b) proceedings were commenced within the retention year` `the favoured interpretation` `T26 retention, proceedings commenced between the notice and the provision`
#ASSERT `Art 26(5)(b) proceedings were commenced within the retention year` `the interpretation with the other reading of F8.1` `T26 retention, proceedings commenced between the notice and the provision`

-- 29 February 2028: the year ends 28 February 2029 (clamp), so proceedings commenced on 1 March 2029 are after it; on the roll reading the year ends 1 March 2029 and they are within it.
#ASSERT `Art 26(5)(a) the last day of the retention year` `the favoured interpretation` (YMD 2028 2 29) EQUALS YMD 2029 2 28
#ASSERT NOT `Art 26(5)(b) proceedings were commenced within the retention year` `the favoured interpretation` `T26 retention from 29 February 2028, proceedings commenced on 1 March 2029`
#ASSERT `Art 26(5)(b) proceedings were commenced within the retention year` `the interpretation with the other reading of F8.10` `T26 retention from 29 February 2028, proceedings commenced on 1 March 2029`
#ASSERT `Art 26(5) the Commissioner may keep the document until` `the favoured interpretation` `T26 retention from 29 February 2028, no proceedings` EQUALS `retention is permitted up to and including` (YMD 2029 2 28)
#ASSERT `Art 26(5) the Commissioner may keep the document until` `the interpretation with the other reading of F8.10` `T26 retention from 29 February 2028, no proceedings` EQUALS `retention is permitted up to and including` (YMD 2029 3 1)

§§ `26(6) -- a copy for a person who needs the document for business (F8.2)`

`T26 a request for a copy, copy supplied on 20 May 2026` MEANS
    `Request for a copy of a retained document` WITH
        `the person requires the document for the purpose of the person's business` IS TRUE
        `the person has requested the document` IS TRUE
        `day of the request` IS YMD 2026 5 1
        `day the copy was supplied` IS JUST (YMD 2026 5 20)

`T26 a request for a copy, copy supplied on 7 May 2026` MEANS
    `Request for a copy of a retained document` WITH
        `the person requires the document for the purpose of the person's business` IS TRUE
        `the person has requested the document` IS TRUE
        `day of the request` IS YMD 2026 5 1
        `day the copy was supplied` IS JUST (YMD 2026 5 7)

`T26 a request for a copy, copy supplied on 8 May 2026` MEANS
    `Request for a copy of a retained document` WITH
        `the person requires the document for the purpose of the person's business` IS TRUE
        `the person has requested the document` IS TRUE
        `day of the request` IS YMD 2026 5 1
        `day the copy was supplied` IS JUST (YMD 2026 5 8)

`T26 a request for a copy, copy supplied on 9 May 2026` MEANS
    `Request for a copy of a retained document` WITH
        `the person requires the document for the purpose of the person's business` IS TRUE
        `the person has requested the document` IS TRUE
        `day of the request` IS YMD 2026 5 1
        `day the copy was supplied` IS JUST (YMD 2026 5 9)

`T26 a request for a copy, no copy supplied` MEANS
    `Request for a copy of a retained document` WITH
        `the person requires the document for the purpose of the person's business` IS TRUE
        `the person has requested the document` IS TRUE
        `day of the request` IS YMD 2026 5 1
        `day the copy was supplied` IS NOTHING

`T26 a request by a person who does not need the document for business` MEANS
    `Request for a copy of a retained document` WITH
        `the person requires the document for the purpose of the person's business` IS FALSE
        `the person has requested the document` IS TRUE
        `day of the request` IS YMD 2026 5 1
        `day the copy was supplied` IS NOTHING

`T26 a person who needs the document for business but has not asked` MEANS
    `Request for a copy of a retained document` WITH
        `the person requires the document for the purpose of the person's business` IS TRUE
        `the person has requested the document` IS FALSE
        `day of the request` IS YMD 2026 5 1
        `day the copy was supplied` IS NOTHING

-- Taken: promptness is the caller's judgement.
#ASSERT `Art 26(6) the copy was supplied as soon as practicable` `the favoured interpretation` `T26 a request for a copy, copy supplied on 20 May 2026` NOTHING TRUE
#ASSERT NOT `Art 26(6) the copy was supplied as soon as practicable` `the favoured interpretation` `T26 a request for a copy, copy supplied on 20 May 2026` NOTHING FALSE
-- Other reading, N = 7 (the discriminating case: request 1 May 2026, copy 20 May 2026): 19 days is over 7.  The judgement is not read.
#ASSERT NOT `Art 26(6) the copy was supplied as soon as practicable` `the interpretation with the other reading of F8.2` `T26 a request for a copy, copy supplied on 20 May 2026` (JUST 7) TRUE
-- Both sides of the edge: 6 days and 7 days are within seven days, 8 is not.
#ASSERT `Art 26(6) the copy was supplied as soon as practicable` `the interpretation with the other reading of F8.2` `T26 a request for a copy, copy supplied on 7 May 2026` (JUST 7) FALSE
#ASSERT `Art 26(6) the copy was supplied as soon as practicable` `the interpretation with the other reading of F8.2` `T26 a request for a copy, copy supplied on 8 May 2026` (JUST 7) FALSE
#ASSERT NOT `Art 26(6) the copy was supplied as soon as practicable` `the interpretation with the other reading of F8.2` `T26 a request for a copy, copy supplied on 9 May 2026` (JUST 7) TRUE
-- No copy supplied: not supplied as soon as practicable, on either reading.
#ASSERT NOT `Art 26(6) the copy was supplied as soon as practicable` `the favoured interpretation` `T26 a request for a copy, no copy supplied` NOTHING TRUE
#ASSERT NOT `Art 26(6) the copy was supplied as soon as practicable` `the interpretation with the other reading of F8.2` `T26 a request for a copy, no copy supplied` (JUST 7) TRUE
-- The days reading with no number supplied: the Law gives none, so a named refusal.
#ASSERT REFUSED `Art 26(6) the copy was supplied as soon as practicable` `the interpretation with the other reading of F8.2` `T26 a request for a copy, copy supplied on 8 May 2026` NOTHING TRUE BECAUSE "Article 26(6) gives no number of days, and none was supplied for the days reading"

-- Third reading of F8.2: seven days with the day of the request (1 May) as the first, so the seventh day is 7 May: a copy supplied on 7 May (6 days after) is in time, on 8 May (7 days after) is not.
#ASSERT `Art 26(6) the copy was supplied as soon as practicable` `the interpretation with the third reading of F8.2` `T26 a request for a copy, copy supplied on 7 May 2026` (JUST 7) FALSE
#ASSERT NOT `Art 26(6) the copy was supplied as soon as practicable` `the interpretation with the third reading of F8.2` `T26 a request for a copy, copy supplied on 8 May 2026` (JUST 7) FALSE
#ASSERT NOT `Art 26(6) the copy was supplied as soon as practicable` `the interpretation with the third reading of F8.2` `T26 a request for a copy, copy supplied on 9 May 2026` (JUST 7) FALSE
#ASSERT NOT `Art 26(6) the copy was supplied as soon as practicable` `the interpretation with the third reading of F8.2` `T26 a request for a copy, no copy supplied` (JUST 7) TRUE
#ASSERT REFUSED `Art 26(6) the copy was supplied as soon as practicable` `the interpretation with the third reading of F8.2` `T26 a request for a copy, copy supplied on 8 May 2026` NOTHING TRUE BECAUSE "Article 26(6) gives no number of days, and none was supplied for the days reading"

-- The duty.  Taken: no deadline, so it stands until the copy is supplied.
-- EXPECT: STANDING MUST
#TRACE `Art 26(6) the Commissioner must supply a copy of the retained document` `the favoured interpretation` `T26 a request for a copy, no copy supplied` NOTHING AT 0 WITH
    (`WAIT UNTIL` 400)

-- EXPECT: FULFILLED
#TRACE `Art 26(6) the Commissioner must supply a copy of the retained document` `the favoured interpretation` `T26 a request for a copy, no copy supplied` NOTHING AT 0 WITH
    PARTY `the Commissioner` DOES `supply a copy of a retained document` AT 19

-- EXPECT: FULFILLED
#TRACE `Art 26(6) the Commissioner must supply a copy of the retained document` `the favoured interpretation` `T26 a request by a person who does not need the document for business` NOTHING AT 0 WITH
    (`WAIT UNTIL` 400)

-- EXPECT: FULFILLED
#TRACE `Art 26(6) the Commissioner must supply a copy of the retained document` `the favoured interpretation` `T26 a person who needs the document for business but has not asked` NOTHING AT 0 WITH
    (`WAIT UNTIL` 400)

-- Other reading, 7 days: supplying on day 7 is in time, on day 8 is a breach, and letting day 8 pass unfulfilled is a breach.
-- EXPECT: FULFILLED
#TRACE `Art 26(6) the Commissioner must supply a copy of the retained document` `the interpretation with the other reading of F8.2` `T26 a request for a copy, no copy supplied` (JUST 7) AT 0 WITH
    PARTY `the Commissioner` DOES `supply a copy of a retained document` AT 7

-- EXPECT: BREACH Article 26(6)
#TRACE `Art 26(6) the Commissioner must supply a copy of the retained document` `the interpretation with the other reading of F8.2` `T26 a request for a copy, no copy supplied` (JUST 7) AT 0 WITH
    PARTY `the Commissioner` DOES `supply a copy of a retained document` AT 8

-- EXPECT: BREACH Article 26(6)
#TRACE `Art 26(6) the Commissioner must supply a copy of the retained document` `the interpretation with the other reading of F8.2` `T26 a request for a copy, no copy supplied` (JUST 7) AT 0 WITH
    (`WAIT UNTIL` 8)

-- Third reading, 7 days with the day of the request counted: due within 6 days of the request.
-- EXPECT: FULFILLED
#TRACE `Art 26(6) the Commissioner must supply a copy of the retained document` `the interpretation with the third reading of F8.2` `T26 a request for a copy, no copy supplied` (JUST 7) AT 0 WITH
    PARTY `the Commissioner` DOES `supply a copy of a retained document` AT 6

-- EXPECT: BREACH Article 26(6)
#TRACE `Art 26(6) the Commissioner must supply a copy of the retained document` `the interpretation with the third reading of F8.2` `T26 a request for a copy, no copy supplied` (JUST 7) AT 0 WITH
    PARTY `the Commissioner` DOES `supply a copy of a retained document` AT 7

§§ `26(7) and 26(8) -- contravening a requirement; legal professional privilege`

`T26 a contravention, requirement valid, not complied with, no privilege, no excuse` MEANS
    `Facts of a contravention under Article 26(7)` WITH
        `the requirement was validly imposed under Article 26(1) or (4)` IS TRUE
        `the person did what was required` IS FALSE
        `what is withheld is subject to legal professional privilege` IS FALSE
        `the person has a reasonable excuse` IS FALSE

`T26 a contravention, but the person complied` MEANS
    `Facts of a contravention under Article 26(7)` WITH
        `the requirement was validly imposed under Article 26(1) or (4)` IS TRUE
        `the person did what was required` IS TRUE
        `what is withheld is subject to legal professional privilege` IS FALSE
        `the person has a reasonable excuse` IS FALSE

`T26 a contravention, but what is withheld is privileged` MEANS
    `Facts of a contravention under Article 26(7)` WITH
        `the requirement was validly imposed under Article 26(1) or (4)` IS TRUE
        `the person did what was required` IS FALSE
        `what is withheld is subject to legal professional privilege` IS TRUE
        `the person has a reasonable excuse` IS FALSE

`T26 a contravention, but the person has a reasonable excuse` MEANS
    `Facts of a contravention under Article 26(7)` WITH
        `the requirement was validly imposed under Article 26(1) or (4)` IS TRUE
        `the person did what was required` IS FALSE
        `what is withheld is subject to legal professional privilege` IS FALSE
        `the person has a reasonable excuse` IS TRUE

`T26 a contravention, but no valid requirement` MEANS
    `Facts of a contravention under Article 26(7)` WITH
        `the requirement was validly imposed under Article 26(1) or (4)` IS FALSE
        `the person did what was required` IS FALSE
        `what is withheld is subject to legal professional privilege` IS FALSE
        `the person has a reasonable excuse` IS FALSE

#ASSERT `Art 26(7) the person commits an offence` `T26 a contravention, requirement valid, not complied with, no privilege, no excuse`
#ASSERT NOT `Art 26(7) the person commits an offence` `T26 a contravention, but the person complied`
#ASSERT NOT `Art 26(7) the person commits an offence` `T26 a contravention, but what is withheld is privileged`
#ASSERT NOT `Art 26(7) the person commits an offence` `T26 a contravention, but the person has a reasonable excuse`
#ASSERT NOT `Art 26(7) the person commits an offence` `T26 a contravention, but no valid requirement`

-- The penalty is 3 months and a fine of level 3 on the standard scale, only where an offence is committed.
#ASSERT `Art 26(7) the penalty the person is liable to` `T26 a contravention, requirement valid, not complied with, no privilege, no excuse` EQUALS JUST (`Penalty provided` OF (JUST 3), (`a fine of a level on the standard scale` 3))
#ASSERT `Art 26(7) the penalty the person is liable to` `T26 a contravention, but the person complied` EQUALS NOTHING
#ASSERT `Art 26(7) the penalty provided for the offence`'s `imprisonment up to, in months` EQUALS JUST 3
#ASSERT `Art 26(7) the penalty provided for the offence`'s `fine` EQUALS `a fine of a level on the standard scale` 3
#ASSERT REFUSED `Art 26(7) the amount of a fine of level 3 on the standard scale` BECAUSE "the amount of level 3 on the standard scale is not in the sources"

-- 26(8): a requirement does not reach what is privileged.
#ASSERT NOT `Art 26(8) a requirement under Article 26 extends to what is withheld` TRUE
#ASSERT `Art 26(8) a requirement under Article 26 extends to what is withheld` FALSE

-- The duty: 14 days from service on 1 June 2026 (taken, day of service not counted): done on day 14 is in time, on day 15 is a breach.
-- EXPECT: FULFILLED
#TRACE `Art 26(7) the person must comply with the requirement` `the favoured interpretation` `T26 a period of fourteen days` `T26 the first of June 2026` AT 0 WITH
    PARTY `any person` DOES `comply with a requirement imposed under Article 26` AT 14

-- EXPECT: BREACH Article 26(7)
#TRACE `Art 26(7) the person must comply with the requirement` `the favoured interpretation` `T26 a period of fourteen days` `T26 the first of June 2026` AT 0 WITH
    PARTY `any person` DOES `comply with a requirement imposed under Article 26` AT 15

-- EXPECT: BREACH Article 26(7)
#TRACE `Art 26(7) the person must comply with the requirement` `the favoured interpretation` `T26 a period of fourteen days` `T26 the first of June 2026` AT 0 WITH
    (`WAIT UNTIL` 15)

-- The other reading of F8.7: the day of service is day 1, so day 14 is already late.
-- EXPECT: BREACH Article 26(7)
#TRACE `Art 26(7) the person must comply with the requirement` `the interpretation with the other reading of F8.7` `T26 a period of fourteen days` `T26 the first of June 2026` AT 0 WITH
    PARTY `any person` DOES `comply with a requirement imposed under Article 26` AT 14

-- EXPECT: FULFILLED
#TRACE `Art 26(7) the person must comply with the requirement` `the interpretation with the other reading of F8.7` `T26 a period of fourteen days` `T26 the first of June 2026` AT 0 WITH
    PARTY `any person` DOES `comply with a requirement imposed under Article 26` AT 13

-- A date fixed by the notice: 20 June 2026 is 19 days after 1 June.
-- EXPECT: FULFILLED
#TRACE `Art 26(7) the person must comply with the requirement` `the favoured interpretation` `T26 a date fixed by the notice, the twentieth of June 2026` `T26 the first of June 2026` AT 0 WITH
    PARTY `any person` DOES `comply with a requirement imposed under Article 26` AT 19

-- EXPECT: BREACH Article 26(7)
#TRACE `Art 26(7) the person must comply with the requirement` `the favoured interpretation` `T26 a date fixed by the notice, the twentieth of June 2026` `T26 the first of June 2026` AT 0 WITH
    (`WAIT UNTIL` 20)

§§ `26(9) -- use of a statement`

`T26 a statement made in compliance, tendered in a prosecution for an unrelated offence` MEANS
    `Statement made under Article 26` WITH
        `made in compliance with a requirement imposed under Article 26` IS TRUE
        `tendered against the person who made it` IS TRUE
        `proceedings` IS `any other criminal proceedings`

`T26 a statement made in compliance, tendered in proceedings under 26(7)` MEANS
    `Statement made under Article 26` WITH
        `made in compliance with a requirement imposed under Article 26` IS TRUE
        `tendered against the person who made it` IS TRUE
        `proceedings` IS `criminal proceedings for an offence under Article 26(7)`

`T26 a statement made in compliance, tendered in proceedings under 26(10)` MEANS
    `Statement made under Article 26` WITH
        `made in compliance with a requirement imposed under Article 26` IS TRUE
        `tendered against the person who made it` IS TRUE
        `proceedings` IS `criminal proceedings for an offence under Article 26(10)`

`T26 a statement made in compliance, tendered in proceedings that are not criminal` MEANS
    `Statement made under Article 26` WITH
        `made in compliance with a requirement imposed under Article 26` IS TRUE
        `tendered against the person who made it` IS TRUE
        `proceedings` IS `proceedings that are not criminal proceedings`

`T26 a statement made in compliance, tendered against someone else` MEANS
    `Statement made under Article 26` WITH
        `made in compliance with a requirement imposed under Article 26` IS TRUE
        `tendered against the person who made it` IS FALSE
        `proceedings` IS `any other criminal proceedings`

`T26 a statement not made in compliance` MEANS
    `Statement made under Article 26` WITH
        `made in compliance with a requirement imposed under Article 26` IS FALSE
        `tendered against the person who made it` IS TRUE
        `proceedings` IS `any other criminal proceedings`

#ASSERT `Art 26(9) the prosecution is barred from using the statement` `T26 a statement made in compliance, tendered in a prosecution for an unrelated offence`
#ASSERT NOT `Art 26(9) the statement may be used by the prosecution` `T26 a statement made in compliance, tendered in a prosecution for an unrelated offence`
#ASSERT `Art 26(9) the statement may be used by the prosecution` `T26 a statement made in compliance, tendered in proceedings under 26(7)`
#ASSERT `Art 26(9) the statement may be used by the prosecution` `T26 a statement made in compliance, tendered in proceedings under 26(10)`
#ASSERT `Art 26(9) the statement may be used by the prosecution` `T26 a statement made in compliance, tendered in proceedings that are not criminal`
#ASSERT `Art 26(9) the statement may be used by the prosecution` `T26 a statement made in compliance, tendered against someone else`
#ASSERT `Art 26(9) the statement may be used by the prosecution` `T26 a statement not made in compliance`
#ASSERT NOT `Art 26(9) the prosecution is barred from using the statement` `T26 a statement made in compliance, tendered in proceedings under 26(7)`

§§ `26(10) and 26(11) -- false information`

-- The prohibition: the act carries what the person knew and intended, and only the combination is the prohibited act.
-- EXPECT: BREACH Article 26(10)
#TRACE `Art 26(10) the person must not give false information` AT 0 WITH
    PARTY `any person` DOES `provide information to the Commissioner` TRUE TRUE AT 3

-- EXPECT: STANDING MUST NOT
#TRACE `Art 26(10) the person must not give false information` AT 0 WITH
    PARTY `any person` DOES `provide information to the Commissioner` TRUE FALSE AT 3

-- EXPECT: STANDING MUST NOT
#TRACE `Art 26(10) the person must not give false information` AT 0 WITH
    PARTY `any person` DOES `provide information to the Commissioner` FALSE TRUE AT 3

-- EXPECT: STANDING MUST NOT
#TRACE `Art 26(10) the person must not give false information` AT 0 WITH
    (`WAIT UNTIL` 500)

`T26 false information for an application, in a document, under Article 26` MEANS
    `Facts of providing information under Article 26(10)` WITH
        `the person provided information to the Commissioner` IS TRUE
        `known by the person to be false in a material particular` IS TRUE
        `intended for an application for registration` IS TRUE
        `intended for deciding whether to serve a required steps notice` IS FALSE
        `contained in a document` IS TRUE
        `provided under Article 26` IS TRUE

`T26 false information for an application, not in a document, not under Article 26` MEANS
    `Facts of providing information under Article 26(10)` WITH
        `the person provided information to the Commissioner` IS TRUE
        `known by the person to be false in a material particular` IS TRUE
        `intended for an application for registration` IS TRUE
        `intended for deciding whether to serve a required steps notice` IS FALSE
        `contained in a document` IS FALSE
        `provided under Article 26` IS FALSE

`T26 false information for an application, in a document, not under Article 26` MEANS
    `Facts of providing information under Article 26(10)` WITH
        `the person provided information to the Commissioner` IS TRUE
        `known by the person to be false in a material particular` IS TRUE
        `intended for an application for registration` IS TRUE
        `intended for deciding whether to serve a required steps notice` IS FALSE
        `contained in a document` IS TRUE
        `provided under Article 26` IS FALSE

`T26 false information for an application, not in a document, under Article 26` MEANS
    `Facts of providing information under Article 26(10)` WITH
        `the person provided information to the Commissioner` IS TRUE
        `known by the person to be false in a material particular` IS TRUE
        `intended for an application for registration` IS TRUE
        `intended for deciding whether to serve a required steps notice` IS FALSE
        `contained in a document` IS FALSE
        `provided under Article 26` IS TRUE

`T26 false information for deciding on a notice` MEANS
    `Facts of providing information under Article 26(10)` WITH
        `the person provided information to the Commissioner` IS TRUE
        `known by the person to be false in a material particular` IS TRUE
        `intended for an application for registration` IS FALSE
        `intended for deciding whether to serve a required steps notice` IS TRUE
        `contained in a document` IS FALSE
        `provided under Article 26` IS TRUE

`T26 false information for neither purpose` MEANS
    `Facts of providing information under Article 26(10)` WITH
        `the person provided information to the Commissioner` IS TRUE
        `known by the person to be false in a material particular` IS TRUE
        `intended for an application for registration` IS FALSE
        `intended for deciding whether to serve a required steps notice` IS FALSE
        `contained in a document` IS TRUE
        `provided under Article 26` IS TRUE

`T26 information not known to be false` MEANS
    `Facts of providing information under Article 26(10)` WITH
        `the person provided information to the Commissioner` IS TRUE
        `known by the person to be false in a material particular` IS FALSE
        `intended for an application for registration` IS TRUE
        `intended for deciding whether to serve a required steps notice` IS TRUE
        `contained in a document` IS TRUE
        `provided under Article 26` IS TRUE

`T26 nothing provided` MEANS
    `Facts of providing information under Article 26(10)` WITH
        `the person provided information to the Commissioner` IS FALSE
        `known by the person to be false in a material particular` IS TRUE
        `intended for an application for registration` IS TRUE
        `intended for deciding whether to serve a required steps notice` IS TRUE
        `contained in a document` IS TRUE
        `provided under Article 26` IS TRUE

#ASSERT `Art 26(10) the person commits an offence` `T26 false information for an application, in a document, under Article 26`
#ASSERT `Art 26(10) the person commits an offence` `T26 false information for deciding on a notice`
#ASSERT NOT `Art 26(10) the person commits an offence` `T26 false information for neither purpose`
#ASSERT NOT `Art 26(10) the person commits an offence` `T26 information not known to be false`
#ASSERT NOT `Art 26(10) the person commits an offence` `T26 nothing provided`
-- 26(11): whether the information is in a document and whether it is provided under Article 26 are irrelevant - all four combinations give the same answer.
#ASSERT `Art 26(10) the person commits an offence` `T26 false information for an application, not in a document, not under Article 26`
#ASSERT `Art 26(10) the person commits an offence` `T26 false information for an application, in a document, not under Article 26`
#ASSERT `Art 26(10) the person commits an offence` `T26 false information for an application, not in a document, under Article 26`
-- The penalty: 2 years (24 months) and a fine with no maximum stated.
#ASSERT `Art 26(10) the penalty the person is liable to` `T26 false information for deciding on a notice` EQUALS JUST (`Penalty provided` OF (JUST 24), `a fine with no maximum stated in the Law`)
#ASSERT `Art 26(10) the penalty the person is liable to` `T26 information not known to be false` EQUALS NOTHING
#ASSERT `Art 26(10) the penalty provided for the offence`'s `imprisonment up to, in months` EQUALS JUST 24
#ASSERT `Art 26(10) the penalty provided for the offence`'s `fine` EQUALS `a fine with no maximum stated in the Law`
#ASSERT REFUSED `Art 26(10) the maximum fine` BECAUSE "Article 26(10) states no maximum for the fine"

