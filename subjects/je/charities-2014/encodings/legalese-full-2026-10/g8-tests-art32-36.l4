#TRACE `Art 34(3)(b) the tribunal may award costs` TRUE AT 0 WITH
    -- no events

-- EXPECT: FULFILLED
#TRACE `Art 34(3)(b) the tribunal may award costs` TRUE AT 0 WITH
    PARTY `the Charity Tribunal` DOES `award costs` AT 20

-- EXPECT: FULFILLED
#TRACE `Art 34(3)(b) the tribunal may award costs` FALSE AT 0 WITH
    -- no events

-- EXPECT: STANDING MAY
#TRACE `Art 34(3)(c) the tribunal may make a recommendation to the Commissioner` TRUE AT 0 WITH
    -- no events

-- EXPECT: FULFILLED
#TRACE `Art 34(3)(c) the tribunal may make a recommendation to the Commissioner` TRUE AT 0 WITH
    PARTY `the Charity Tribunal` DOES `make a recommendation to the Commissioner` AT 20

