IMPORT prelude
IMPORT daydate
IMPORT domain
IMPORT `g8-nouns`
IMPORT `g8-art26-demand`
IMPORT `g8-art27-28-required-steps`
IMPORT `g8-tests-fixtures`

-- g8-tests-art27-28: tests of Articles 27 and 28.  Expected values were decided from the text of the Law before the module was run.
-- Every limb of 27(1) on both readings of F8.14, every relevant person of 27(3), each precondition of 27(2) failing in turn, 27(4) on both readings of F8.15 and with the
-- organized-religious-charity bar, the status of Article 28 under each shape of Order, F8.3 on a humanist association, and the partial invalidity of 28(3).

§ `Tests of Articles 27 and 28`

§§ `Fixtures`

`T27 belief (a)` MEANS `there has been misconduct by a registered charity`
`T27 belief (b)` MEANS `a registered charity does not pass the charity test`
`T27 belief (c)` MEANS `a governor of a registered charity has engaged in misconduct`
`T27 belief (d)` MEANS `a governor of a registered charity is unfit by reason of a reportable matter`
`T27 belief (e)` MEANS `a registered charity has ceased to meet the requirements of Article 11(4)(c) or (d)`

`T27 a governor with a reportable matter` MEANS
    Governor WITH
        name IS "Alice"
        `is a natural person` IS TRUE
        `is resident in Jersey` IS TRUE
        `is itself a Jersey entity by virtue of Article 2(3)(a)` IS FALSE
        `reportable matters` IS LIST `bankruptcy or other insolvency`

`T27 a governor with no reportable matter` MEANS
    Governor WITH
        name IS "Bob"
        `is a natural person` IS TRUE
        `is resident in Jersey` IS TRUE
        `is itself a Jersey entity by virtue of Article 2(3)(a)` IS FALSE
        `reportable matters` IS EMPTY

`T27 an entity whose governor has a reportable matter` MEANS
    Entity WITH
        name IS "Example Trust"
        `standing on the register` IS `entered in the general section`
        `kinds of entity` IS LIST `the trustees of a trust`
        `is a Jersey entity` IS TRUE
        governors IS LIST `T27 a governor with a reportable matter`
        purposes IS EMPTY

`T27 an entity whose governors have no reportable matter` MEANS
    Entity WITH
        name IS "Example Trust"
        `standing on the register` IS `entered in the general section`
        `kinds of entity` IS LIST `the trustees of a trust`
        `is a Jersey entity` IS TRUE
        governors IS LIST `T27 a governor with no reportable matter`
        purposes IS EMPTY

-- Neutral facts: no misconduct, charity test met, no governor misconduct, no unfit governor, both Article 11(4) requirements met.
GIVEN interp IS AN `Interpretation of Articles 26 to 36`
      registered IS A BOOLEAN
      beliefs IS A LIST OF `Belief that prompts a required steps notice`
      misconduct IS A BOOLEAN
      meetsTest IS A BOOLEAN
      governorMisconduct IS A BOOLEAN
      unfit IS A BOOLEAN
      req4c IS A BOOLEAN
      req4d IS A BOOLEAN
GIVETH A LIST OF `Belief that prompts a required steps notice`
`T27 the grounds, on the reading and with the facts` interp registered beliefs misconduct meetsTest governorMisconduct unfit req4c req4d MEANS
    `Art 27(1) the Commissioner has a ground to serve a required steps notice` interp registered beliefs misconduct meetsTest governorMisconduct `T27 an entity whose governor has a reportable matter` unfit req4c req4d

§§ `27(1) -- the beliefs that are a ground (F8.14)`

-- (a): the belief that the charity has been guilty of misconduct.  Taken: the belief alone; other: it must be borne out by IP12.
#ASSERT `T27 the grounds, on the reading and with the facts` `the favoured interpretation` TRUE (LIST `T27 belief (a)`) FALSE TRUE FALSE FALSE TRUE TRUE EQUALS LIST `T27 belief (a)`
#ASSERT `T27 the grounds, on the reading and with the facts` `the interpretation with the other reading of F8.14` TRUE (LIST `T27 belief (a)`) FALSE TRUE FALSE FALSE TRUE TRUE EQUALS EMPTY
#ASSERT `T27 the grounds, on the reading and with the facts` `the interpretation with the other reading of F8.14` TRUE (LIST `T27 belief (a)`) TRUE TRUE FALSE FALSE TRUE TRUE EQUALS LIST `T27 belief (a)`
-- (b): the charity does not pass the charity test.
#ASSERT `T27 the grounds, on the reading and with the facts` `the favoured interpretation` TRUE (LIST `T27 belief (b)`) FALSE TRUE FALSE FALSE TRUE TRUE EQUALS LIST `T27 belief (b)`
#ASSERT `T27 the grounds, on the reading and with the facts` `the interpretation with the other reading of F8.14` TRUE (LIST `T27 belief (b)`) FALSE TRUE FALSE FALSE TRUE TRUE EQUALS EMPTY
#ASSERT `T27 the grounds, on the reading and with the facts` `the interpretation with the other reading of F8.14` TRUE (LIST `T27 belief (b)`) FALSE FALSE FALSE FALSE TRUE TRUE EQUALS LIST `T27 belief (b)`
-- (c): a governor has engaged in misconduct.
#ASSERT `T27 the grounds, on the reading and with the facts` `the favoured interpretation` TRUE (LIST `T27 belief (c)`) FALSE TRUE FALSE FALSE TRUE TRUE EQUALS LIST `T27 belief (c)`
#ASSERT `T27 the grounds, on the reading and with the facts` `the interpretation with the other reading of F8.14` TRUE (LIST `T27 belief (c)`) FALSE TRUE FALSE FALSE TRUE TRUE EQUALS EMPTY
#ASSERT `T27 the grounds, on the reading and with the facts` `the interpretation with the other reading of F8.14` TRUE (LIST `T27 belief (c)`) FALSE TRUE TRUE FALSE TRUE TRUE EQUALS LIST `T27 belief (c)`
-- (d): a governor is, by reason of a reportable matter, unfit.  Borne out needs a governor WITH a reportable matter and the unfitness determination.
#ASSERT `T27 the grounds, on the reading and with the facts` `the favoured interpretation` TRUE (LIST `T27 belief (d)`) FALSE TRUE FALSE FALSE TRUE TRUE EQUALS LIST `T27 belief (d)`
#ASSERT `T27 the grounds, on the reading and with the facts` `the interpretation with the other reading of F8.14` TRUE (LIST `T27 belief (d)`) FALSE TRUE FALSE FALSE TRUE TRUE EQUALS EMPTY
#ASSERT `T27 the grounds, on the reading and with the facts` `the interpretation with the other reading of F8.14` TRUE (LIST `T27 belief (d)`) FALSE TRUE FALSE TRUE TRUE TRUE EQUALS LIST `T27 belief (d)`
#ASSERT `Art 27(1) the Commissioner has a ground to serve a required steps notice` `the interpretation with the other reading of F8.14` TRUE (LIST `T27 belief (d)`) FALSE TRUE FALSE `T27 an entity whose governors have no reportable matter` TRUE TRUE TRUE EQUALS EMPTY
-- (e): the charity has ceased to meet the requirements of Article 11(4)(c) or (d): either failing bears it out.
#ASSERT `T27 the grounds, on the reading and with the facts` `the favoured interpretation` TRUE (LIST `T27 belief (e)`) FALSE TRUE FALSE FALSE TRUE TRUE EQUALS LIST `T27 belief (e)`
#ASSERT `T27 the grounds, on the reading and with the facts` `the interpretation with the other reading of F8.14` TRUE (LIST `T27 belief (e)`) FALSE TRUE FALSE FALSE TRUE TRUE EQUALS EMPTY
#ASSERT `T27 the grounds, on the reading and with the facts` `the interpretation with the other reading of F8.14` TRUE (LIST `T27 belief (e)`) FALSE TRUE FALSE FALSE FALSE TRUE EQUALS LIST `T27 belief (e)`
#ASSERT `T27 the grounds, on the reading and with the facts` `the interpretation with the other reading of F8.14` TRUE (LIST `T27 belief (e)`) FALSE TRUE FALSE FALSE TRUE FALSE EQUALS LIST `T27 belief (e)`
-- Not a registered charity: no ground on either reading.
#ASSERT `T27 the grounds, on the reading and with the facts` `the favoured interpretation` FALSE (LIST `T27 belief (a)`) TRUE FALSE TRUE TRUE FALSE FALSE EQUALS EMPTY
#ASSERT `T27 the grounds, on the reading and with the facts` `the interpretation with the other reading of F8.14` FALSE (LIST `T27 belief (a)`) TRUE FALSE TRUE TRUE FALSE FALSE EQUALS EMPTY
-- Two beliefs, only the second borne out.
#ASSERT `T27 the grounds, on the reading and with the facts` `the favoured interpretation` TRUE (LIST `T27 belief (a)`, `T27 belief (b)`) FALSE FALSE FALSE FALSE TRUE TRUE EQUALS LIST `T27 belief (a)`, `T27 belief (b)`
#ASSERT `T27 the grounds, on the reading and with the facts` `the interpretation with the other reading of F8.14` TRUE (LIST `T27 belief (a)`, `T27 belief (b)`) FALSE FALSE FALSE FALSE TRUE TRUE EQUALS LIST `T27 belief (b)`
-- No belief held: no ground, and paragraph (2) does not apply.
#ASSERT `T27 the grounds, on the reading and with the facts` `the favoured interpretation` TRUE EMPTY TRUE FALSE TRUE TRUE FALSE FALSE EQUALS EMPTY
#ASSERT NOT `Art 27(1) paragraph (2) applies` EMPTY
#ASSERT `Art 27(1) paragraph (2) applies` (LIST `T27 belief (c)`)

§§ `27(3) -- the relevant persons`

#ASSERT `Art 27(3) the person is a relevant person` TRUE FALSE
#ASSERT `Art 27(3) the person is a relevant person` FALSE TRUE
#ASSERT NOT `Art 27(3) the person is a relevant person` FALSE FALSE

§§ `27(2) -- the power to serve the notice`

-- All five conditions met: the permission stands.
-- EXPECT: STANDING MAY
#TRACE `Art 27(2) the Commissioner may serve a required steps notice` (LIST `T27 belief (c)`) `T27 belief (c)` TRUE TRUE TRUE TRUE AT 0 WITH
    -- no events

-- EXPECT: FULFILLED
#TRACE `Art 27(2) the Commissioner may serve a required steps notice` (LIST `T27 belief (c)`) `T27 belief (c)` TRUE TRUE TRUE TRUE AT 0 WITH
    PARTY `the Commissioner` DOES `serve a required steps notice` AT 5

-- Each condition failing in turn leaves nothing to exercise.  The belief relied on is not among the grounds:
-- EXPECT: FULFILLED
#TRACE `Art 27(2) the Commissioner may serve a required steps notice` (LIST `T27 belief (c)`) `T27 belief (a)` TRUE TRUE TRUE TRUE AT 0 WITH
    -- no events

-- no grounds at all:
-- EXPECT: FULFILLED
#TRACE `Art 27(2) the Commissioner may serve a required steps notice` EMPTY `T27 belief (c)` TRUE TRUE TRUE TRUE AT 0 WITH
    -- no events

-- the person to be served is not a relevant person:
-- EXPECT: FULFILLED
#TRACE `Art 27(2) the Commissioner may serve a required steps notice` (LIST `T27 belief (c)`) `T27 belief (c)` FALSE TRUE TRUE TRUE AT 0 WITH
    -- no events

-- the notice specifies no steps or no time:
-- EXPECT: FULFILLED
#TRACE `Art 27(2) the Commissioner may serve a required steps notice` (LIST `T27 belief (c)`) `T27 belief (c)` TRUE FALSE TRUE TRUE AT 0 WITH
    -- no events

-- the Commissioner is not of the opinion that the steps are appropriate:
-- EXPECT: FULFILLED
#TRACE `Art 27(2) the Commissioner may serve a required steps notice` (LIST `T27 belief (c)`) `T27 belief (c)` TRUE TRUE FALSE TRUE AT 0 WITH
    -- no events

-- an Order under Article 27(5) is not met:
-- EXPECT: FULFILLED
#TRACE `Art 27(2) the Commissioner may serve a required steps notice` (LIST `T27 belief (c)`) `T27 belief (c)` TRUE TRUE TRUE FALSE AT 0 WITH
    -- no events

-- IP19: the record of one service.  Served on 1 June 2026, fourteen days: the last day is 15 June (day of service not counted) or 14 June.
`T27 a requirement to remove a governor of the charity` MEANS
    `Requirement in a required steps notice` WITH
        `kind of requirement` IS `a requirement to remove a governor`
        `the governor concerned is a governor of the charity` IS TRUE

`T27 a requirement to prepare a report` MEANS
    `Requirement in a required steps notice` WITH
        `kind of requirement` IS `any other requirement`
        `the governor concerned is a governor of the charity` IS FALSE

`T27 a requirement to suspend a governor of another charity` MEANS
    `Requirement in a required steps notice` WITH
        `kind of requirement` IS `a requirement to suspend a governor`
        `the governor concerned is a governor of the charity` IS FALSE

#ASSERT `Art 27(2) the required steps notice served` `the favoured interpretation` `the registered charity` `T27 belief (c)` (YMD 2026 6 1) (`a period of days fixed by the notice` 14) (LIST `T27 a requirement to remove a governor of the charity`, `T27 a requirement to prepare a report`) FALSE EQUALS `Required steps notice` OF `the registered charity`, `T27 belief (c)`, (YMD 2026 6 1), (JUST (YMD 2026 6 15)), TRUE, FALSE
#ASSERT `Art 27(2) the required steps notice served` `the interpretation with the other reading of F8.7` `a governor of the registered charity` `T27 belief (c)` (YMD 2026 6 1) (`a period of days fixed by the notice` 14) (LIST `T27 a requirement to prepare a report`) TRUE EQUALS `Required steps notice` OF `a governor of the registered charity`, `T27 belief (c)`, (YMD 2026 6 1), (JUST (YMD 2026 6 14)), FALSE, TRUE
-- A date fixed by the notice is the date, on either reading.
#ASSERT `Art 27(2) the required steps notice served` `the favoured interpretation` `the registered charity` `T27 belief (b)` (YMD 2026 6 1) (`a date fixed by the notice` (YMD 2026 6 30)) (LIST `T27 a requirement to prepare a report`) FALSE EQUALS `Required steps notice` OF `the registered charity`, `T27 belief (b)`, (YMD 2026 6 1), (JUST (YMD 2026 6 30)), FALSE, FALSE

§§ `27(4) -- steps that suspend, remove or replace a governor (F8.15)`

-- Not an organized religious charity.  Taken: only notices under (1)(c) or (d).
#ASSERT `Art 27(4) the steps may include suspension, removal or replacement` `the favoured interpretation` `T27 belief (c)` FALSE
#ASSERT `Art 27(4) the steps may include suspension, removal or replacement` `the favoured interpretation` `T27 belief (d)` FALSE
#ASSERT NOT `Art 27(4) the steps may include suspension, removal or replacement` `the favoured interpretation` `T27 belief (a)` FALSE
#ASSERT NOT `Art 27(4) the steps may include suspension, removal or replacement` `the favoured interpretation` `T27 belief (b)` FALSE
#ASSERT NOT `Art 27(4) the steps may include suspension, removal or replacement` `the favoured interpretation` `T27 belief (e)` FALSE
-- Other reading: any ground.
#ASSERT `Art 27(4) the steps may include suspension, removal or replacement` `the interpretation with the other reading of F8.15` `T27 belief (a)` FALSE
#ASSERT `Art 27(4) the steps may include suspension, removal or replacement` `the interpretation with the other reading of F8.15` `T27 belief (b)` FALSE
#ASSERT `Art 27(4) the steps may include suspension, removal or replacement` `the interpretation with the other reading of F8.15` `T27 belief (e)` FALSE
#ASSERT `Art 27(4) the steps may include suspension, removal or replacement` `the interpretation with the other reading of F8.15` `T27 belief (c)` FALSE
-- An organized religious charity: never, on either reading ("subject to Article 28").
#ASSERT NOT `Art 27(4) the steps may include suspension, removal or replacement` `the favoured interpretation` `T27 belief (c)` TRUE
#ASSERT NOT `Art 27(4) the steps may include suspension, removal or replacement` `the favoured interpretation` `T27 belief (d)` TRUE
#ASSERT NOT `Art 27(4) the steps may include suspension, removal or replacement` `the interpretation with the other reading of F8.15` `T27 belief (a)` TRUE
#ASSERT NOT `Art 27(4) the steps may include suspension, removal or replacement` `the interpretation with the other reading of F8.15` `T27 belief (c)` TRUE
-- Which requirements are about a governor.
#ASSERT `Art 27(4) the requirement is to suspend, remove or replace a governor` `T27 a requirement to remove a governor of the charity`
#ASSERT `Art 27(4) the requirement is to suspend, remove or replace a governor` `T27 a requirement to suspend a governor of another charity`
#ASSERT NOT `Art 27(4) the requirement is to suspend, remove or replace a governor` `T27 a requirement to prepare a report`

§§ `27(5) -- the Minister may make an Order on procedure`

-- EXPECT: STANDING MAY
#TRACE `Art 27(5) the Minister may by Order make further provision` AT 0 WITH
    -- no events

-- EXPECT: FULFILLED
#TRACE `Art 27(5) the Minister may by Order make further provision` AT 0 WITH
    PARTY `the Minister` DOES `make an Order on the procedure for and restrictions on serving a required steps notice` AT 30

§§ `28(1) -- the Minister may categorize organized religious charities (F8.3)`

`T28 a philosophical belief purpose` MEANS
    Purpose WITH
        description IS "the advancement of humanism"
        head IS JUST `any other purpose that may reasonably be regarded as analogous to one of the above`
        `is purely ancillary or incidental to a charitable purpose of the entity` IS FALSE
        `is advancing a political party or promoting a candidate for election` IS FALSE
        `is advancing a philosophical belief` IS TRUE

`T28 a purpose that advances religion` MEANS
    Purpose WITH
        description IS "the advancement of religion"
        head IS JUST `the advancement of religion`
        `is purely ancillary or incidental to a charitable purpose of the entity` IS FALSE
        `is advancing a political party or promoting a candidate for election` IS FALSE
        `is advancing a philosophical belief` IS FALSE

`T28 a humanist association` MEANS
    Entity WITH
        name IS "Jersey Humanists"
        `standing on the register` IS `entered in the general section`
        `kinds of entity` IS LIST `a company`
        `is a Jersey entity` IS TRUE
        governors IS EMPTY
        purposes IS LIST `T28 a philosophical belief purpose`

`T28 a church` MEANS
    Entity WITH
        name IS "Jersey Church"
        `standing on the register` IS `entered in the general section`
        `kinds of entity` IS LIST `a company`
        `is a Jersey entity` IS TRUE
        governors IS EMPTY
        purposes IS LIST `T28 a purpose that advances religion`

-- (a) reading A: the charity test met and a purpose within 6(1)(c) itself.
#ASSERT `Art 28(1)(a) the charity meets the charity test by virtue of Article 6(1)(c)` `the favoured interpretation` TRUE TRUE `T28 a church`
#ASSERT NOT `Art 28(1)(a) the charity meets the charity test by virtue of Article 6(1)(c)` `the favoured interpretation` FALSE TRUE `T28 a church`
#ASSERT NOT `Art 28(1)(a) the charity meets the charity test by virtue of Article 6(1)(c)` `the favoured interpretation` TRUE FALSE `T28 a church`
-- The discriminating case: a humanist association (it meets the charity test through 6(1)(p), not within 6(1)(c) itself).
#ASSERT NOT `Art 28(1)(a) the charity meets the charity test by virtue of Article 6(1)(c)` `the favoured interpretation` TRUE FALSE `T28 a humanist association`
#ASSERT `Art 28(1)(a) the charity meets the charity test by virtue of Article 6(1)(c)` `the interpretation with the other reading of F8.3` TRUE FALSE `T28 a humanist association`
-- The readings agree on a church, and the other reading still needs the charity test.
#ASSERT `Art 28(1)(a) the charity meets the charity test by virtue of Article 6(1)(c)` `the interpretation with the other reading of F8.3` TRUE TRUE `T28 a church`
#ASSERT NOT `Art 28(1)(a) the charity meets the charity test by virtue of Article 6(1)(c)` `the interpretation with the other reading of F8.3` FALSE FALSE `T28 a humanist association`
#ASSERT NOT `Art 28(1)(a) the charity meets the charity test by virtue of Article 6(1)(c)` `the interpretation with the other reading of F8.3` TRUE FALSE `T28 a church`

-- (b) is the Minister's appearance.  Eligibility: a registered charity, (a) and (b).
#ASSERT `Art 28(1) the charity is eligible to be categorized as an organized religious charity` `the favoured interpretation` TRUE TRUE TRUE `T28 a church` TRUE
#ASSERT NOT `Art 28(1) the charity is eligible to be categorized as an organized religious charity` `the favoured interpretation` TRUE TRUE TRUE `T28 a church` FALSE
#ASSERT NOT `Art 28(1) the charity is eligible to be categorized as an organized religious charity` `the favoured interpretation` FALSE TRUE TRUE `T28 a church` TRUE
#ASSERT NOT `Art 28(1) the charity is eligible to be categorized as an organized religious charity` `the favoured interpretation` TRUE TRUE FALSE `T28 a humanist association` TRUE
#ASSERT `Art 28(1) the charity is eligible to be categorized as an organized religious charity` `the interpretation with the other reading of F8.3` TRUE TRUE FALSE `T28 a humanist association` TRUE

-- The power: stands for an eligible charity, nothing to exercise for an ineligible one.
-- EXPECT: STANDING MAY
#TRACE `Art 28(1) the Minister may by Order provide for the charity to be categorized` TRUE AT 0 WITH
    -- no events

-- EXPECT: FULFILLED
#TRACE `Art 28(1) the Minister may by Order provide for the charity to be categorized` FALSE AT 0 WITH
    -- no events

-- EXPECT: FULFILLED
#TRACE `Art 28(1) the Minister may by Order provide for the charity to be categorized` TRUE AT 0 WITH
    PARTY `the Minister` DOES `make an Order categorizing registered charities as organized religious charities` AT 10

§§ `28(2) -- the Commissioner's discretion; the status`

-- EXPECT: STANDING MAY
#TRACE `Art 28(2)(a) the Commissioner may grant or withdraw the status` TRUE AT 0 WITH
    -- no events

-- EXPECT: FULFILLED
#TRACE `Art 28(2)(a) the Commissioner may grant or withdraw the status` FALSE AT 0 WITH
    -- no events

`T28 an Order that categorizes the charity` MEANS
    `Order under Article 28 as it applies to a charity` WITH
        `the Order categorizes the charity as an organized religious charity` IS TRUE
        `the Order gives the Commissioner discretion to grant or withdraw the status` IS FALSE
        `the Commissioner has granted the status` IS FALSE
        `the Commissioner has withdrawn the status` IS FALSE

`T28 an Order that does not categorize the charity` MEANS
    `Order under Article 28 as it applies to a charity` WITH
        `the Order categorizes the charity as an organized religious charity` IS FALSE
        `the Order gives the Commissioner discretion to grant or withdraw the status` IS FALSE
        `the Commissioner has granted the status` IS FALSE
        `the Commissioner has withdrawn the status` IS FALSE

-- Without a discretion, a grant or withdrawal is not read.
`T28 an Order without discretion, with a grant and a withdrawal recorded` MEANS
    `Order under Article 28 as it applies to a charity` WITH
        `the Order categorizes the charity as an organized religious charity` IS FALSE
        `the Order gives the Commissioner discretion to grant or withdraw the status` IS FALSE
        `the Commissioner has granted the status` IS TRUE
        `the Commissioner has withdrawn the status` IS TRUE

`T28 an Order with discretion, status granted` MEANS
    `Order under Article 28 as it applies to a charity` WITH
        `the Order categorizes the charity as an organized religious charity` IS FALSE
        `the Order gives the Commissioner discretion to grant or withdraw the status` IS TRUE
        `the Commissioner has granted the status` IS TRUE
        `the Commissioner has withdrawn the status` IS FALSE

`T28 an Order with discretion, status not granted` MEANS
    `Order under Article 28 as it applies to a charity` WITH
        `the Order categorizes the charity as an organized religious charity` IS FALSE
        `the Order gives the Commissioner discretion to grant or withdraw the status` IS TRUE
        `the Commissioner has granted the status` IS FALSE
        `the Commissioner has withdrawn the status` IS FALSE

`T28 an Order that categorizes the charity, with discretion, status withdrawn` MEANS
    `Order under Article 28 as it applies to a charity` WITH
        `the Order categorizes the charity as an organized religious charity` IS TRUE
        `the Order gives the Commissioner discretion to grant or withdraw the status` IS TRUE
        `the Commissioner has granted the status` IS FALSE
        `the Commissioner has withdrawn the status` IS TRUE

`T28 an Order that categorizes the charity, with discretion, status not withdrawn` MEANS
    `Order under Article 28 as it applies to a charity` WITH
        `the Order categorizes the charity as an organized religious charity` IS TRUE
        `the Order gives the Commissioner discretion to grant or withdraw the status` IS TRUE
        `the Commissioner has granted the status` IS FALSE
        `the Commissioner has withdrawn the status` IS FALSE

#ASSERT `Art 28 the entity is an organized religious charity` TRUE `T28 an Order that categorizes the charity`
#ASSERT NOT `Art 28 the entity is an organized religious charity` TRUE `T28 an Order that does not categorize the charity`
#ASSERT NOT `Art 28 the entity is an organized religious charity` TRUE `T28 an Order without discretion, with a grant and a withdrawal recorded`
#ASSERT `Art 28 the entity is an organized religious charity` TRUE `T28 an Order with discretion, status granted`
#ASSERT NOT `Art 28 the entity is an organized religious charity` TRUE `T28 an Order with discretion, status not granted`
#ASSERT NOT `Art 28 the entity is an organized religious charity` TRUE `T28 an Order that categorizes the charity, with discretion, status withdrawn`
#ASSERT `Art 28 the entity is an organized religious charity` TRUE `T28 an Order that categorizes the charity, with discretion, status not withdrawn`
-- Only a registered charity can be an organized religious charity.
#ASSERT NOT `Art 28 the entity is an organized religious charity` FALSE `T28 an Order that categorizes the charity`

§§ `28(3) -- partial invalidity`

-- A notice served on an organized religious charity, requiring the removal of a governor of that charity and also a report: only the first is void.
#ASSERT `Art 28(3) the required steps notice is invalid to the extent` TRUE `T27 a requirement to remove a governor of the charity`
#ASSERT NOT `Art 28(3) the required steps notice is invalid to the extent` TRUE `T27 a requirement to prepare a report`
-- A requirement about a governor of another charity is not within "a governor of that charity".
#ASSERT NOT `Art 28(3) the required steps notice is invalid to the extent` TRUE `T27 a requirement to suspend a governor of another charity`
-- A charity that is not an organized religious charity: nothing is invalid.
#ASSERT NOT `Art 28(3) the required steps notice is invalid to the extent` FALSE `T27 a requirement to remove a governor of the charity`
#ASSERT `Art 28(3) the requirements of the notice that remain valid` TRUE (LIST `T27 a requirement to remove a governor of the charity`, `T27 a requirement to prepare a report`) EQUALS LIST `T27 a requirement to prepare a report`
#ASSERT `Art 28(3) the requirements of the notice that remain valid` FALSE (LIST `T27 a requirement to remove a governor of the charity`, `T27 a requirement to prepare a report`) EQUALS LIST `T27 a requirement to remove a governor of the charity`, `T27 a requirement to prepare a report`
#ASSERT `Art 28(3) the requirements of the notice that remain valid` TRUE (LIST `T27 a requirement to remove a governor of the charity`) EQUALS EMPTY
#ASSERT `Art 28(3) the requirements of the notice that remain valid` TRUE (LIST `T27 a requirement to suspend a governor of another charity`) EQUALS LIST `T27 a requirement to suspend a governor of another charity`

§ `Tests of the private readings of Articles 27 and 28, called directly`

-- 27(1): each belief borne out and not, by the fact that bears on it (IP12, IP8, IP14, the entity's governors and the unfitness, IP15 and IP16).
-- The arguments after the belief: IP12, IP8, IP14, the entity, the unfitness determination, IP15, IP16.
#ASSERT `Art 27(1) the belief is borne out` `T27 belief (a)` TRUE TRUE FALSE `T27 an entity whose governor has a reportable matter` FALSE TRUE TRUE
#ASSERT NOT `Art 27(1) the belief is borne out` `T27 belief (a)` FALSE TRUE FALSE `T27 an entity whose governor has a reportable matter` FALSE TRUE TRUE
#ASSERT `Art 27(1) the belief is borne out` `T27 belief (b)` FALSE FALSE FALSE `T27 an entity whose governor has a reportable matter` FALSE TRUE TRUE
#ASSERT NOT `Art 27(1) the belief is borne out` `T27 belief (b)` FALSE TRUE FALSE `T27 an entity whose governor has a reportable matter` FALSE TRUE TRUE
#ASSERT `Art 27(1) the belief is borne out` `T27 belief (c)` FALSE TRUE TRUE `T27 an entity whose governor has a reportable matter` FALSE TRUE TRUE
#ASSERT NOT `Art 27(1) the belief is borne out` `T27 belief (c)` FALSE TRUE FALSE `T27 an entity whose governor has a reportable matter` FALSE TRUE TRUE
#ASSERT `Art 27(1) the belief is borne out` `T27 belief (d)` FALSE TRUE FALSE `T27 an entity whose governor has a reportable matter` TRUE TRUE TRUE
#ASSERT NOT `Art 27(1) the belief is borne out` `T27 belief (d)` FALSE TRUE FALSE `T27 an entity whose governor has a reportable matter` FALSE TRUE TRUE
#ASSERT NOT `Art 27(1) the belief is borne out` `T27 belief (d)` FALSE TRUE FALSE `T27 an entity whose governors have no reportable matter` TRUE TRUE TRUE
#ASSERT `Art 27(1) the belief is borne out` `T27 belief (e)` FALSE TRUE FALSE `T27 an entity whose governor has a reportable matter` FALSE FALSE TRUE
#ASSERT `Art 27(1) the belief is borne out` `T27 belief (e)` FALSE TRUE FALSE `T27 an entity whose governor has a reportable matter` FALSE TRUE FALSE
#ASSERT NOT `Art 27(1) the belief is borne out` `T27 belief (e)` FALSE TRUE FALSE `T27 an entity whose governor has a reportable matter` FALSE TRUE TRUE

-- 27(4), reading A: only the beliefs of (1)(c) and (d).
#ASSERT `Art 27(4) reading A: the belief is one under Article 27(1)(c) or (d)` `T27 belief (c)`
#ASSERT `Art 27(4) reading A: the belief is one under Article 27(1)(c) or (d)` `T27 belief (d)`
#ASSERT NOT `Art 27(4) reading A: the belief is one under Article 27(1)(c) or (d)` `T27 belief (a)`
#ASSERT NOT `Art 27(4) reading A: the belief is one under Article 27(1)(c) or (d)` `T27 belief (b)`
#ASSERT NOT `Art 27(4) reading A: the belief is one under Article 27(1)(c) or (d)` `T27 belief (e)`

-- 28(1)(a), the two readings (F8.3).
#ASSERT `Art 28(1)(a) reading A: meets the charity test by virtue of Article 6(1)(c)` TRUE TRUE
#ASSERT NOT `Art 28(1)(a) reading A: meets the charity test by virtue of Article 6(1)(c)` TRUE FALSE
#ASSERT NOT `Art 28(1)(a) reading A: meets the charity test by virtue of Article 6(1)(c)` FALSE TRUE
#ASSERT `Art 28(1)(a) reading B: meets the charity test by virtue of Article 6(1)(c) or an analogous philosophical belief purpose` TRUE FALSE `T28 a humanist association`
#ASSERT NOT `Art 28(1)(a) reading B: meets the charity test by virtue of Article 6(1)(c) or an analogous philosophical belief purpose` TRUE FALSE `T28 a church`
#ASSERT `Art 28(1)(a) reading B: meets the charity test by virtue of Article 6(1)(c) or an analogous philosophical belief purpose` TRUE TRUE `T28 a church`
#ASSERT NOT `Art 28(1)(a) reading B: meets the charity test by virtue of Article 6(1)(c) or an analogous philosophical belief purpose` FALSE FALSE `T28 a humanist association`

-- 28(1)(b) is the Minister's appearance and nothing more.
#ASSERT `Art 28(1)(b) the supervision and discipline of the governors is adequate to justify Article 28(3)` TRUE
#ASSERT NOT `Art 28(1)(b) the supervision and discipline of the governors is adequate to justify Article 28(3)` FALSE

