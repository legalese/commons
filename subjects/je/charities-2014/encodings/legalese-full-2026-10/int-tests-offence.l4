        name IS "Les Pommiers Limited"
        standing IS `not on the register`
        purposes IS LIST (`Int fx a purpose with clear facts` (`Int fx a charitable purpose` "to relieve poverty in Jersey" `the prevention or relief of poverty`))
        facts IS `Int fx a Jersey company` (LIST (`Int fx a natural person resident in Jersey called` "P. Gallichan"))
        model IS `Int fx clear model facts`
        people IS LIST (`Int fx a director with nothing to report called` "P. Gallichan")

