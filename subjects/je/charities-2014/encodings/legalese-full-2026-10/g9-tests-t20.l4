IMPORT prelude
IMPORT daydate
IMPORT domain
IMPORT `g9-interpretation`
IMPORT `g9-common`
IMPORT `g9-sched1-commissioner`
IMPORT `g9-sched2-tribunal`

-- g9-tests-t20.l4: trap T20. Schedules 1 and 2 are parallel and their figures differ in two places, which the Law's own text and the PDF text layer agree on:
--   resignation: not less than 3 months' notice (Schedule 1 paragraph 3(1)(a), src:780) against not less than one month's notice (Schedule 2 paragraph 2(1)(a), src:826);
--   absence: longer than 4 consecutive weeks (Schedule 1 paragraph 3(2)(a), src:784) against longer than 8 consecutive weeks (Schedule 2 paragraph 2(2)(a), src:830).
-- Every other period is the same in both: 2 weeks before appointing, 6 years, 2 weeks after terminating, 12 years, 4 months after the end of the year.
-- This module imports both Schedule modules, so it also proves that their names do not collide. Expected values come from the text of the Law.

`A` MEANS `the favoured interpretation`

§ `The figures that differ`
#ASSERT `Sch 1 para 3(1)(a) the notice of resignation must be for not less than this many months` EQUALS 3
#ASSERT `Sch 2 para 2(1)(a) the notice of resignation must be for not less than this many months` EQUALS 1
#ASSERT `Sch 1 para 3(2)(a) the absence must be for a period longer than this many consecutive weeks` EQUALS 4
#ASSERT `Sch 2 para 2(2)(a) the absence must be for a period longer than this many consecutive weeks` EQUALS 8

§ `The figures that are the same`
#ASSERT `Sch 1 para 1(3) the notice of intention must be presented at least this many weeks before appointing` EQUALS `Sch 2 para 1(3) the notice of intention must be presented at least this many weeks before appointing`
#ASSERT `Sch 1 para 1(5) the period of the appointment is not more than this many years` EQUALS `Sch 2 para 1(5) the period of the appointment is not more than this many years`
#ASSERT `Sch 1 para 3(3) the notice of the termination must be presented not more than this many weeks after terminating` EQUALS `Sch 2 para 2(3) the notice of the termination must be presented not more than this many weeks after terminating`
#ASSERT `Sch 1 para 4(9) the report must be provided in no case later than this many months after the end of the year` EQUALS `Sch 2 para 3(4) the report must be provided in no case later than this many months after the end of the year`

§ `The same facts, asked of each Schedule`
-- a notice given on 30 November 2026 to take effect on 30 December 2026 (one month): a resignation of a member, not of the Commissioner
#ASSERT `Sch 2 para 2(1)(a) the day the position ends by resignation` `A` (`Notice of resignation of a member of the tribunal` OF (YMD 2026 11 30), TRUE, (YMD 2026 12 30)) EQUALS JUST (YMD 2026 12 30)
#ASSERT `Sch 1 para 3(1)(a) the day the office ends by resignation` `A` (`Notice of resignation of the Commissioner` OF (YMD 2026 11 30), TRUE, (YMD 2026 12 30)) EQUALS NOTHING
-- a notice of 3 months satisfies both
#ASSERT `Sch 2 para 2(1)(a) the day the position ends by resignation` `A` (`Notice of resignation of a member of the tribunal` OF (YMD 2026 11 30), TRUE, (YMD 2027 2 28)) EQUALS JUST (YMD 2027 2 28)
#ASSERT `Sch 1 para 3(1)(a) the day the office ends by resignation` `A` (`Notice of resignation of the Commissioner` OF (YMD 2026 11 30), TRUE, (YMD 2027 2 28)) EQUALS JUST (YMD 2027 2 28)
-- absent from 1 March to 4 April 2026, 5 weeks (35 days), the Minister satisfied: a ground for terminating the Commissioner and not a ground for terminating a member
#ASSERT `Sch 1 para 3(2) the Minister has satisfied himself or herself on a ground for terminating` `A` (`Grounds for terminating the appointment of the Commissioner` OF (JUST (YMD 2026 3 1)), (JUST (YMD 2026 4 4)), TRUE, FALSE, FALSE, FALSE)
#ASSERT NOT `Sch 2 para 2(2) the Minister has satisfied himself or herself on a ground for terminating` `A` (`Grounds for terminating the appointment of a member of the tribunal` OF (JUST (YMD 2026 3 1)), (JUST (YMD 2026 4 4)), TRUE, FALSE, FALSE, FALSE)
-- absent from 1 March to 26 April 2026, 57 days: a ground for both
#ASSERT `Sch 1 para 3(2) the Minister has satisfied himself or herself on a ground for terminating` `A` (`Grounds for terminating the appointment of the Commissioner` OF (JUST (YMD 2026 3 1)), (JUST (YMD 2026 4 26)), TRUE, FALSE, FALSE, FALSE)
#ASSERT `Sch 2 para 2(2) the Minister has satisfied himself or herself on a ground for terminating` `A` (`Grounds for terminating the appointment of a member of the tribunal` OF (JUST (YMD 2026 3 1)), (JUST (YMD 2026 4 26)), TRUE, FALSE, FALSE, FALSE)
-- the 6-year cap, the 12-year cap and the 2 week notice before appointing are asked identically of both
#ASSERT `Sch 1 para 1(5) the period of the appointment is within the limit` `A` (`Appointment of the Commissioner` OF (YMD 2026 3 1), (YMD 2026 3 1), (YMD 2032 3 1), TRUE, NOTHING, NOTHING, FALSE, FALSE, NOTHING, EMPTY)
#ASSERT `Sch 2 para 1(5) the period of the appointment is within the limit` `A` (`Appointment of a member of the tribunal` OF (YMD 2026 3 1), (YMD 2026 3 1), (YMD 2032 3 1), TRUE, TRUE, NOTHING, NOTHING, FALSE, FALSE, NOTHING, EMPTY)
