IMPORT prelude
IMPORT daydate
IMPORT domain
IMPORT `g5-interpretation`
IMPORT `g5-nouns`

-- g5-tests-fixtures.l4: the named cases the G5 test modules share.  Values only: no rule, no #ASSERT, no #TRACE.
-- Every fact here is a fact a witness could state; each name says what the case is, not what the answer is.

§ `Fixtures of group G5`

§§ `Governors, purposes and entities`

`governor Alice` MEANS Governor WITH
    name IS "Alice Le Brun"
    `is a natural person` IS TRUE
    `is resident in Jersey` IS TRUE
    `is itself a Jersey entity by virtue of Article 2(3)(a)` IS FALSE
    `reportable matters` IS EMPTY

`governor Bob, bankrupt` MEANS Governor WITH
    name IS "Bob Renouf"
    `is a natural person` IS TRUE
    `is resident in Jersey` IS TRUE
    `is itself a Jersey entity by virtue of Article 2(3)(a)` IS FALSE
    `reportable matters` IS LIST `bankruptcy or other insolvency`

`purpose to advance education` MEANS Purpose WITH
    description IS "to advance education in Jersey"
    head IS JUST `the advancement of education`
    `is purely ancillary or incidental to a charitable purpose of the entity` IS FALSE
    `is advancing a political party or promoting a candidate for election` IS FALSE
    `is advancing a philosophical belief` IS FALSE

`purpose to promote a candidate for election` MEANS Purpose WITH
    description IS "to promote a candidate for election to office in Jersey"
    head IS NOTHING
    `is purely ancillary or incidental to a charitable purpose of the entity` IS FALSE
    `is advancing a political party or promoting a candidate for election` IS TRUE
    `is advancing a philosophical belief` IS FALSE

-- Article 6(5): political whatever head it might otherwise fall under.
`purpose to educate voters for a candidate` MEANS Purpose WITH
    description IS "to educate voters so as to return a named candidate"
    head IS JUST `the advancement of education`
    `is purely ancillary or incidental to a charitable purpose of the entity` IS FALSE
    `is advancing a political party or promoting a candidate for election` IS TRUE
    `is advancing a philosophical belief` IS FALSE

`purpose to run a cafe` MEANS Purpose WITH
    description IS "to run a cafe whose profits fund the concerts"
    head IS NOTHING
    `is purely ancillary or incidental to a charitable purpose of the entity` IS TRUE
    `is advancing a political party or promoting a candidate for election` IS FALSE
    `is advancing a philosophical belief` IS FALSE

`purpose to advance a philosophical belief` MEANS Purpose WITH
    description IS "to advance humanism"
    head IS NOTHING
    `is purely ancillary or incidental to a charitable purpose of the entity` IS FALSE
    `is advancing a political party or promoting a candidate for election` IS FALSE
    `is advancing a philosophical belief` IS TRUE

`purpose to run a members' social club` MEANS Purpose WITH
    description IS "to run a social club for its members"
    head IS NOTHING
    `is purely ancillary or incidental to a charitable purpose of the entity` IS FALSE
    `is advancing a political party or promoting a candidate for election` IS FALSE
    `is advancing a philosophical belief` IS FALSE

`the Arts Trust entity` MEANS Entity WITH
    name IS "Jersey Arts Trust"
    `standing on the register` IS `entered in the general section`
    `kinds of entity` IS LIST `the trustees of a trust`
    `is a Jersey entity` IS TRUE
    governors IS LIST `governor Alice`, `governor Bob, bankrupt`
    purposes IS LIST `purpose to advance education`

`the Arts Trust entity, in the restricted section` MEANS Entity WITH
    name IS "Jersey Arts Trust"
    `standing on the register` IS `entered in the restricted section`
    `kinds of entity` IS LIST `the trustees of a trust`
    `is a Jersey entity` IS TRUE
    governors IS LIST `governor Alice`, `governor Bob, bankrupt`
    purposes IS LIST `purpose to advance education`

`the fideicommis entity` MEANS Entity WITH
    name IS "Les Pas Fideicommis"
    `standing on the register` IS `entered in the general section`
    `kinds of entity` IS LIST `the fidéicommissaires of a court-approved fidéicommis`
    `is a Jersey entity` IS TRUE
    governors IS LIST `governor Alice`
    purposes IS LIST `purpose to advance education`

`the 1862 association entity` MEANS Entity WITH
    name IS "Societe des Amis"
    `standing on the register` IS `entered in the general section`
    `kinds of entity` IS LIST `an incorporated 1862 association`
    `is a Jersey entity` IS TRUE
    governors IS LIST `governor Alice`
    purposes IS LIST `purpose to advance education`

§§ `Registered charities`

-- Registered on 1 March 2019 and never deregistered.
`the Arts Trust` MEANS `Registered charity` WITH
    entity IS `the Arts Trust entity`
    `registration number` IS "C-0001"
    `registered name` IS "Jersey Arts Trust"
    `alternative registered names` IS EMPTY
    `date registered` IS YMD 2019 3 1
    `date deregistered` IS NOTHING
    `registered charitable purposes` IS LIST "to advance education in Jersey"
    `registered public benefit statement` IS "The Trust gives free concerts to the public of Jersey"
    `is an organized religious charity` IS FALSE

-- Deregistered with effect from 30 June 2022 (the notice may have been given later: Article 17(3) lets the effect be retrospective).
`the Arts Trust, deregistered with effect from 30 June 2022` MEANS `Registered charity` WITH
    entity IS `the Arts Trust entity`
    `registration number` IS "C-0001"
    `registered name` IS "Jersey Arts Trust"
    `alternative registered names` IS EMPTY
    `date registered` IS YMD 2019 3 1
    `date deregistered` IS JUST (YMD 2022 6 30)
    `registered charitable purposes` IS LIST "to advance education in Jersey"
    `registered public benefit statement` IS "The Trust gives free concerts to the public of Jersey"
    `is an organized religious charity` IS FALSE

`the Arts Trust, in the restricted section` MEANS `Registered charity` WITH
    entity IS `the Arts Trust entity, in the restricted section`
    `registration number` IS "C-0001"
    `registered name` IS "Jersey Arts Trust"
    `alternative registered names` IS EMPTY
    `date registered` IS YMD 2019 3 1
    `date deregistered` IS NOTHING
    `registered charitable purposes` IS LIST "to advance education in Jersey"
    `registered public benefit statement` IS "The Trust gives free concerts to the public of Jersey"
    `is an organized religious charity` IS FALSE

`the fideicommis charity` MEANS `Registered charity` WITH
    entity IS `the fideicommis entity`
    `registration number` IS "C-0002"
    `registered name` IS "Les Pas Fideicommis"
    `alternative registered names` IS EMPTY
    `date registered` IS YMD 2019 3 1
    `date deregistered` IS NOTHING
    `registered charitable purposes` IS LIST "to advance education in Jersey"
    `registered public benefit statement` IS "The fideicommis teaches"
    `is an organized religious charity` IS FALSE

`the 1862 association charity` MEANS `Registered charity` WITH
    entity IS `the 1862 association entity`
    `registration number` IS "C-0003"
    `registered name` IS "Societe des Amis"
    `alternative registered names` IS EMPTY
    `date registered` IS YMD 2019 3 1
    `date deregistered` IS NOTHING
    `registered charitable purposes` IS LIST "to advance education in Jersey"
    `registered public benefit statement` IS "The association teaches"
    `is an organized religious charity` IS FALSE

-- Registered on 29 February 2020 (fork F5.11).
`the leap day charity` MEANS `Registered charity` WITH
    entity IS `the Arts Trust entity`
    `registration number` IS "C-0004"
    `registered name` IS "Leap Day Trust"
    `alternative registered names` IS EMPTY
    `date registered` IS YMD 2020 2 29
    `date deregistered` IS NOTHING
    `registered charitable purposes` IS LIST "to advance education in Jersey"
    `registered public benefit statement` IS "The Trust teaches"
    `is an organized religious charity` IS FALSE

§§ `Provisions of a constitution about amending the purposes`

`a provision permitting a political purpose` MEANS `Provision about amending purposes` WITH
    `forms part of the entity's constitution or constitutional Law` IS TRUE
    `purports to permit an amendment to include any purpose whatever` IS FALSE
    `purposes whose addition or substitution it purports to permit` IS LIST `purpose to promote a candidate for election`
    `an order of the court under the Loi of 1862 exists, made before or after registration` IS FALSE
    `that order is inconsistent with paragraph (2) or (3) as applied to the provision` IS FALSE

`a provision permitting only education` MEANS `Provision about amending purposes` WITH
    `forms part of the entity's constitution or constitutional Law` IS TRUE
    `purports to permit an amendment to include any purpose whatever` IS FALSE
    `purposes whose addition or substitution it purports to permit` IS LIST `purpose to advance education`
    `an order of the court under the Loi of 1862 exists, made before or after registration` IS FALSE
    `that order is inconsistent with paragraph (2) or (3) as applied to the provision` IS FALSE

`a provision permitting any purpose` MEANS `Provision about amending purposes` WITH
    `forms part of the entity's constitution or constitutional Law` IS TRUE
    `purports to permit an amendment to include any purpose whatever` IS TRUE
    `purposes whose addition or substitution it purports to permit` IS EMPTY
    `an order of the court under the Loi of 1862 exists, made before or after registration` IS FALSE
    `that order is inconsistent with paragraph (2) or (3) as applied to the provision` IS FALSE

`a provision permitting a purely ancillary purpose` MEANS `Provision about amending purposes` WITH
    `forms part of the entity's constitution or constitutional Law` IS TRUE
    `purports to permit an amendment to include any purpose whatever` IS FALSE
    `purposes whose addition or substitution it purports to permit` IS LIST `purpose to run a cafe`
    `an order of the court under the Loi of 1862 exists, made before or after registration` IS FALSE
    `that order is inconsistent with paragraph (2) or (3) as applied to the provision` IS FALSE

`a provision permitting a philosophical purpose` MEANS `Provision about amending purposes` WITH
    `forms part of the entity's constitution or constitutional Law` IS TRUE
    `purports to permit an amendment to include any purpose whatever` IS FALSE
    `purposes whose addition or substitution it purports to permit` IS LIST `purpose to advance a philosophical belief`
    `an order of the court under the Loi of 1862 exists, made before or after registration` IS FALSE
    `that order is inconsistent with paragraph (2) or (3) as applied to the provision` IS FALSE

`a provision permitting a social club` MEANS `Provision about amending purposes` WITH
    `forms part of the entity's constitution or constitutional Law` IS TRUE
    `purports to permit an amendment to include any purpose whatever` IS FALSE
    `purposes whose addition or substitution it purports to permit` IS LIST `purpose to run a members' social club`
    `an order of the court under the Loi of 1862 exists, made before or after registration` IS FALSE
    `that order is inconsistent with paragraph (2) or (3) as applied to the provision` IS FALSE

`a provision permitting a political purpose that has a head` MEANS `Provision about amending purposes` WITH
    `forms part of the entity's constitution or constitutional Law` IS TRUE
    `purports to permit an amendment to include any purpose whatever` IS FALSE
    `purposes whose addition or substitution it purports to permit` IS LIST `purpose to educate voters for a candidate`
    `an order of the court under the Loi of 1862 exists, made before or after registration` IS FALSE
    `that order is inconsistent with paragraph (2) or (3) as applied to the provision` IS FALSE

`a provision permitting education and a political purpose` MEANS `Provision about amending purposes` WITH
    `forms part of the entity's constitution or constitutional Law` IS TRUE
    `purports to permit an amendment to include any purpose whatever` IS FALSE
    `purposes whose addition or substitution it purports to permit` IS LIST `purpose to advance education`, `purpose to promote a candidate for election`
    `an order of the court under the Loi of 1862 exists, made before or after registration` IS FALSE
    `that order is inconsistent with paragraph (2) or (3) as applied to the provision` IS FALSE

`a provision that is not part of the constitution` MEANS `Provision about amending purposes` WITH
    `forms part of the entity's constitution or constitutional Law` IS FALSE
    `purports to permit an amendment to include any purpose whatever` IS TRUE
    `purposes whose addition or substitution it purports to permit` IS EMPTY
    `an order of the court under the Loi of 1862 exists, made before or after registration` IS FALSE
    `that order is inconsistent with paragraph (2) or (3) as applied to the provision` IS FALSE

-- An order of the court under the Loi of 1862 exists and is inconsistent with paragraphs (2) and (3) as they would apply to the provision.
`a provision permitting any purpose, with an inconsistent order under the Loi of 1862` MEANS `Provision about amending purposes` WITH
    `forms part of the entity's constitution or constitutional Law` IS TRUE
    `purports to permit an amendment to include any purpose whatever` IS TRUE
    `purposes whose addition or substitution it purports to permit` IS EMPTY
    `an order of the court under the Loi of 1862 exists, made before or after registration` IS TRUE
    `that order is inconsistent with paragraph (2) or (3) as applied to the provision` IS TRUE

-- An order under the Loi of 1862 exists but is consistent with paragraphs (2) and (3).
`a provision permitting any purpose, with a consistent order under the Loi of 1862` MEANS `Provision about amending purposes` WITH
    `forms part of the entity's constitution or constitutional Law` IS TRUE
    `purports to permit an amendment to include any purpose whatever` IS TRUE
    `purposes whose addition or substitution it purports to permit` IS EMPTY
    `an order of the court under the Loi of 1862 exists, made before or after registration` IS TRUE
    `that order is inconsistent with paragraph (2) or (3) as applied to the provision` IS FALSE

§§ `The condition of the restricted section`

-- Fields in order: meets the original condition; ceased to meet it; a permission was given to remain on a different condition; that permission was
-- given before the cessation; meets the different condition.
`a charity that still meets its condition and has no permission` MEANS `Facts about the condition of the restricted section` WITH
    `meets the condition as to which the Commissioner was satisfied under Article 9(6)(b)` IS TRUE
    `ceased to meet that condition` IS FALSE
    `the Commissioner gave permission to remain entered on the basis of a different condition` IS FALSE
    `that permission was given before the charity ceased to meet the original condition` IS FALSE
    `meets the different condition as specified in the permission` IS FALSE

`a charity that ceased to meet its condition and has no permission` MEANS `Facts about the condition of the restricted section` WITH
    `meets the condition as to which the Commissioner was satisfied under Article 9(6)(b)` IS FALSE
    `ceased to meet that condition` IS TRUE
    `the Commissioner gave permission to remain entered on the basis of a different condition` IS FALSE
    `that permission was given before the charity ceased to meet the original condition` IS FALSE
    `meets the different condition as specified in the permission` IS FALSE

`a charity that ceased to meet its condition, with a prior permission, and meets the different condition` MEANS `Facts about the condition of the restricted section` WITH
    `meets the condition as to which the Commissioner was satisfied under Article 9(6)(b)` IS FALSE
    `ceased to meet that condition` IS TRUE
    `the Commissioner gave permission to remain entered on the basis of a different condition` IS TRUE
    `that permission was given before the charity ceased to meet the original condition` IS TRUE
    `meets the different condition as specified in the permission` IS TRUE

`a charity that ceased to meet its condition, with a prior permission, and fails the different condition` MEANS `Facts about the condition of the restricted section` WITH
    `meets the condition as to which the Commissioner was satisfied under Article 9(6)(b)` IS FALSE
    `ceased to meet that condition` IS TRUE
    `the Commissioner gave permission to remain entered on the basis of a different condition` IS TRUE
    `that permission was given before the charity ceased to meet the original condition` IS TRUE
    `meets the different condition as specified in the permission` IS FALSE

-- The permission was given only AFTER the charity ceased to meet its condition: not a prior permission.
`a charity that ceased to meet its condition, with a permission given afterwards, and meets the different condition` MEANS `Facts about the condition of the restricted section` WITH
    `meets the condition as to which the Commissioner was satisfied under Article 9(6)(b)` IS FALSE
    `ceased to meet that condition` IS TRUE
    `the Commissioner gave permission to remain entered on the basis of a different condition` IS TRUE
    `that permission was given before the charity ceased to meet the original condition` IS FALSE
    `meets the different condition as specified in the permission` IS TRUE

-- Fork F5.8: a prior permission exists, the charity has not ceased to meet its original condition, and it does not meet the different condition.
`a charity with a prior permission that still meets its original condition and fails the different one` MEANS `Facts about the condition of the restricted section` WITH
    `meets the condition as to which the Commissioner was satisfied under Article 9(6)(b)` IS TRUE
    `ceased to meet that condition` IS FALSE
    `the Commissioner gave permission to remain entered on the basis of a different condition` IS TRUE
    `that permission was given before the charity ceased to meet the original condition` IS TRUE
    `meets the different condition as specified in the permission` IS FALSE

-- Fork F5.8: the charity never met its original condition (so it has not "ceased to meet" it), a prior permission was given, and it meets the different condition.
`a charity that never met its condition, with a prior permission, and meets the different condition` MEANS `Facts about the condition of the restricted section` WITH
    `meets the condition as to which the Commissioner was satisfied under Article 9(6)(b)` IS FALSE
    `ceased to meet that condition` IS FALSE
    `the Commissioner gave permission to remain entered on the basis of a different condition` IS TRUE
    `that permission was given before the charity ceased to meet the original condition` IS TRUE
    `meets the different condition as specified in the permission` IS TRUE

§§ `Payments and the statements of intentions they are judged by`

`a statement provided on 10 January 2022 that the payment contradicts` MEANS `Statement of intentions as to payments` WITH
    `date provided` IS YMD 2022 1 10
    `the payment is inconsistent with it` IS TRUE

`a statement provided on 10 January 2022 that the payment fits` MEANS `Statement of intentions as to payments` WITH
    `date provided` IS YMD 2022 1 10
    `the payment is inconsistent with it` IS FALSE

`a statement provided on 1 February 2023 that the payment fits` MEANS `Statement of intentions as to payments` WITH
    `date provided` IS YMD 2023 2 1
    `the payment is inconsistent with it` IS FALSE

-- Provided on 1 June 2023, after the payments below (10 May 2023).
`a statement provided on 1 June 2023 that the payment contradicts` MEANS `Statement of intentions as to payments` WITH
    `date provided` IS YMD 2023 6 1
    `the payment is inconsistent with it` IS TRUE

-- Provided on 10 May 2023, the day of the payments below: a statement provided on the day of the payment counts.
`a statement provided on 10 May 2023 that the payment contradicts` MEANS `Statement of intentions as to payments` WITH
    `date provided` IS YMD 2023 5 10
    `the payment is inconsistent with it` IS TRUE

`a payment inconsistent with the statement of intentions` MEANS `Payment by the charity` WITH
    description IS "a bonus of 20,000 pounds to a governor"
    `date of the payment` IS YMD 2023 5 10
    `statements provided` IS LIST `a statement provided on 10 January 2022 that the payment contradicts`

`a payment consistent with the statement of intentions` MEANS `Payment by the charity` WITH
    description IS "a fee of 500 pounds to a governor for a talk"
    `date of the payment` IS YMD 2023 5 10
    `statements provided` IS LIST `a statement provided on 10 January 2022 that the payment fits`

-- Fork F5.14: the first statement is contradicted by the payment, the amended statement of 1 February 2023 is not.
`a payment that fits the amended statement but not the first` MEANS `Payment by the charity` WITH
    description IS "a bonus of 10,000 pounds to a governor"
    `date of the payment` IS YMD 2023 5 10
    `statements provided` IS LIST `a statement provided on 10 January 2022 that the payment contradicts`, `a statement provided on 1 February 2023 that the payment fits`

-- A statement provided after the payment cannot bind the payment.
`a payment that contradicts only a later statement` MEANS `Payment by the charity` WITH
    description IS "a bonus of 10,000 pounds to a governor"
    `date of the payment` IS YMD 2023 5 10
    `statements provided` IS LIST `a statement provided on 10 January 2022 that the payment fits`, `a statement provided on 1 June 2023 that the payment contradicts`

`a payment made before any statement was provided` MEANS `Payment by the charity` WITH
    description IS "a bonus of 10,000 pounds to a governor"
    `date of the payment` IS YMD 2023 5 10
    `statements provided` IS LIST `a statement provided on 1 June 2023 that the payment contradicts`

`a payment when no statement has been provided` MEANS `Payment by the charity` WITH
    description IS "a bonus of 10,000 pounds to a governor"
    `date of the payment` IS YMD 2023 5 10
    `statements provided` IS EMPTY

`a payment on the day a contradicting statement was provided` MEANS `Payment by the charity` WITH
    description IS "a bonus of 10,000 pounds to a governor"
    `date of the payment` IS YMD 2023 5 10
    `statements provided` IS LIST `a statement provided on 10 January 2022 that the payment fits`, `a statement provided on 10 May 2023 that the payment contradicts`

