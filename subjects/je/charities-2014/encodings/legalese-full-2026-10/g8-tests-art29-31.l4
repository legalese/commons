        `consent of the person from whom the information was received` IS FALSE

-- Article 30: the Commissioner discloses to the Comptroller because the Comptroller requires it (and for no limb of Article 31).
`T30 a disclosure the Commissioner must make to the Comptroller` MEANS
    `Disclosure of information` WITH
        `by or on behalf of the Commissioner` IS TRUE
        `recipient` IS `a disclosure to the Comptroller`
        `to enable the Commissioner to discharge a function` IS FALSE
        `to enable the recipient to discharge a function` IS FALSE
        `to enable the recipient to discharge a function in relation to charities` IS FALSE
        `for the investigation or prosecution of an offence` IS FALSE
        `for taking or deciding whether to take proceedings under this Law` IS FALSE
        `in circumstances prescribed by Regulations` IS FALSE
        `required by the recipient for its functions` IS TRUE
        `consent of the person to whom the information relates` IS FALSE
        `consent of the person from whom the information was received` IS FALSE

`T30 a disclosure the Commissioner must make to the JFSC` MEANS
    `Disclosure of information` WITH
        `by or on behalf of the Commissioner` IS TRUE
        `recipient` IS `a disclosure to the Jersey Financial Services Commission`
        `to enable the Commissioner to discharge a function` IS FALSE
        `to enable the recipient to discharge a function` IS FALSE
        `to enable the recipient to discharge a function in relation to charities` IS FALSE
        `for the investigation or prosecution of an offence` IS FALSE
        `for taking or deciding whether to take proceedings under this Law` IS FALSE
        `in circumstances prescribed by Regulations` IS FALSE
        `required by the recipient for its functions` IS TRUE
        `consent of the person to whom the information relates` IS FALSE
        `consent of the person from whom the information was received` IS FALSE

-- The recipient requires it, but the discloser is not the Commissioner: Article 30 is a duty of the Commissioner.
`T30 a private person discloses to the Comptroller who requires it` MEANS
    `Disclosure of information` WITH
        `by or on behalf of the Commissioner` IS FALSE
        `recipient` IS `a disclosure to the Comptroller`
        `to enable the Commissioner to discharge a function` IS FALSE
        `to enable the recipient to discharge a function` IS FALSE
        `to enable the recipient to discharge a function in relation to charities` IS FALSE
        `for the investigation or prosecution of an offence` IS FALSE
        `for taking or deciding whether to take proceedings under this Law` IS FALSE
        `in circumstances prescribed by Regulations` IS FALSE
        `required by the recipient for its functions` IS TRUE
        `consent of the person to whom the information relates` IS FALSE
        `consent of the person from whom the information was received` IS FALSE

-- The Commissioner discloses to a stranger who "requires" it: Article 30 reaches only the Comptroller and the JFSC.
`T30 the Commissioner discloses to a stranger who requires it` MEANS
    `Disclosure of information` WITH
        `by or on behalf of the Commissioner` IS TRUE
        `recipient` IS `a disclosure to any other person`
        `to enable the Commissioner to discharge a function` IS FALSE
        `to enable the recipient to discharge a function` IS FALSE
        `to enable the recipient to discharge a function in relation to charities` IS FALSE
        `for the investigation or prosecution of an offence` IS FALSE
        `for taking or deciding whether to take proceedings under this Law` IS FALSE
        `in circumstances prescribed by Regulations` IS FALSE
        `required by the recipient for its functions` IS TRUE
        `consent of the person to whom the information relates` IS FALSE
        `consent of the person from whom the information was received` IS FALSE

§§ `29(2) -- this Article does not apply`

#ASSERT `Art 29(2) this Article does not apply to the information` TRUE `T29 information received under the Law`
#ASSERT `Art 29(2)(a) the information is registered in the public parts of the register` TRUE
#ASSERT NOT `Art 29(2)(a) the information is registered in the public parts of the register` FALSE
#ASSERT `Art 29(2) this Article does not apply to the information` FALSE `T29 information already available to the public from other sources`
#ASSERT `Art 29(2)(b) the information is or has already been made available to the public from other sources` `T29 information already available to the public from other sources`
#ASSERT `Art 29(2) this Article does not apply to the information` FALSE `T29 a summary that identifies no particular person`
#ASSERT `Art 29(2)(c) the information is in a form that identifies no particular person` `T29 a summary that identifies no particular person`
#ASSERT NOT `Art 29(2) this Article does not apply to the information` FALSE `T29 information received under the Law`
#ASSERT NOT `Art 29(2)(b) the information is or has already been made available to the public from other sources` `T29 information received under the Law`
#ASSERT NOT `Art 29(2)(c) the information is in a form that identifies no particular person` `T29 information received under the Law`

§§ `29(1) -- who is caught`

#ASSERT `Art 29(1) the person received information within Article 29(1)` `T29 information received under the Law`
#ASSERT `Art 29(1) the person received information within Article 29(1)` `T29 information received from a person who received it under the Law`
#ASSERT `Art 29(1) the person received information within Article 29(1)` `T29 information received both ways`
#ASSERT NOT `Art 29(1) the person received information within Article 29(1)` `T29 information that relates to no one's affairs`
#ASSERT NOT `Art 29(1) the person received information within Article 29(1)` `T29 information received neither way`

§§ `29(1) -- the offence, and the consent (F8.11)`

-- Received under the Law, disclosed without consent: an offence.  With the consent of the person it relates to: none.
#ASSERT `Art 29(1) the person commits an offence` `the favoured interpretation` FALSE `T29 information received under the Law` `T29 a disclosure with no consent`
#ASSERT NOT `Art 29(1) the person commits an offence` `the favoured interpretation` FALSE `T29 information received under the Law` `T29 a disclosure with the consent of the person it relates to`
-- Where (b) does not apply the consent of the source is not asked for, so it does not help alone.
#ASSERT `Art 29(1) the person commits an offence` `the favoured interpretation` FALSE `T29 information received under the Law` `T29 a disclosure with the consent of the person it was received from`
#ASSERT NOT `Art 29(1) the person commits an offence` `the favoured interpretation` FALSE `T29 information received under the Law` `T29 a disclosure with both consents`
-- Received from another recipient (b).  Taken: both consents are needed, so one is not enough.
#ASSERT `Art 29(1) the person commits an offence` `the favoured interpretation` FALSE `T29 information received from a person who received it under the Law` `T29 a disclosure with no consent`
#ASSERT `Art 29(1) the person commits an offence` `the favoured interpretation` FALSE `T29 information received from a person who received it under the Law` `T29 a disclosure with the consent of the person it relates to`
#ASSERT `Art 29(1) the person commits an offence` `the favoured interpretation` FALSE `T29 information received from a person who received it under the Law` `T29 a disclosure with the consent of the person it was received from`
#ASSERT NOT `Art 29(1) the person commits an offence` `the favoured interpretation` FALSE `T29 information received from a person who received it under the Law` `T29 a disclosure with both consents`
-- Other reading: either consent suffices, so only a disclosure with neither is an offence.
#ASSERT `Art 29(1) the person commits an offence` `the interpretation with the other reading of F8.11` FALSE `T29 information received from a person who received it under the Law` `T29 a disclosure with no consent`
#ASSERT NOT `Art 29(1) the person commits an offence` `the interpretation with the other reading of F8.11` FALSE `T29 information received from a person who received it under the Law` `T29 a disclosure with the consent of the person it relates to`
#ASSERT NOT `Art 29(1) the person commits an offence` `the interpretation with the other reading of F8.11` FALSE `T29 information received from a person who received it under the Law` `T29 a disclosure with the consent of the person it was received from`
#ASSERT NOT `Art 29(1) the person commits an offence` `the interpretation with the other reading of F8.11` FALSE `T29 information received from a person who received it under the Law` `T29 a disclosure with both consents`
-- Where (b) does not apply the two readings agree: only the consent of the person it relates to.
#ASSERT `Art 29(1) the person commits an offence` `the interpretation with the other reading of F8.11` FALSE `T29 information received under the Law` `T29 a disclosure with the consent of the person it was received from`
#ASSERT NOT `Art 29(1) the person commits an offence` `the interpretation with the other reading of F8.11` FALSE `T29 information received under the Law` `T29 a disclosure with the consent of the person it relates to`
-- Received both ways: (b) applies.
#ASSERT `Art 29(1) the person commits an offence` `the favoured interpretation` FALSE `T29 information received both ways` `T29 a disclosure with the consent of the person it relates to`
#ASSERT NOT `Art 29(1) the person commits an offence` `the interpretation with the other reading of F8.11` FALSE `T29 information received both ways` `T29 a disclosure with the consent of the person it relates to`
-- Not caught: not about anyone's affairs, or not received either way.
#ASSERT NOT `Art 29(1) the person commits an offence` `the favoured interpretation` FALSE `T29 information that relates to no one's affairs` `T29 a disclosure with no consent`
#ASSERT NOT `Art 29(1) the person commits an offence` `the favoured interpretation` FALSE `T29 information received neither way` `T29 a disclosure with no consent`
-- Subject to paragraph (2): in the public parts, already public, a summary.
#ASSERT NOT `Art 29(1) the person commits an offence` `the favoured interpretation` TRUE `T29 information received under the Law` `T29 a disclosure with no consent`
#ASSERT NOT `Art 29(1) the person commits an offence` `the favoured interpretation` FALSE `T29 information already available to the public from other sources` `T29 a disclosure with no consent`
#ASSERT NOT `Art 29(1) the person commits an offence` `the favoured interpretation` FALSE `T29 a summary that identifies no particular person` `T29 a disclosure with no consent`

§§ `29(1) with Articles 30 and 31`

-- Subject to Article 31: a permitted disclosure is no offence, a disclosure to a stranger for a generic function is.
#ASSERT NOT `Art 29(1) the person commits an offence` `the favoured interpretation` FALSE `T29 information received under the Law` `T31 a disclosure by the Commissioner to enable the Commissioner to discharge a function`
#ASSERT NOT `Art 29(1) the person commits an offence` `the favoured interpretation` FALSE `T29 information received under the Law` `T31 a disclosure to the Comptroller to enable the Comptroller to discharge a function`
#ASSERT NOT `Art 29(1) the person commits an offence` `the favoured interpretation` FALSE `T29 information received under the Law` `T31 a disclosure to any person for the investigation of an offence`
#ASSERT `Art 29(1) the person commits an offence` `the favoured interpretation` FALSE `T29 information received under the Law` `T31 a disclosure to a stranger to enable the stranger to discharge a function`
#ASSERT `Art 29(1) the person commits an offence` `the favoured interpretation` FALSE `T29 information received under the Law` `T31 a disclosure to the Comptroller for no function`
-- Subject to Article 30: the Commissioner's required disclosure is no offence, whatever Article 31 says.
#ASSERT NOT `Art 29(1) the person commits an offence` `the favoured interpretation` FALSE `T29 information received under the Law` `T30 a disclosure the Commissioner must make to the Comptroller`
#ASSERT NOT `Art 29(1) the person commits an offence` `the favoured interpretation` FALSE `T29 information received under the Law` `T30 a disclosure the Commissioner must make to the JFSC`
-- ... but a private person's disclosure to a recipient who requires it is not Article 30's, and the Commissioner's to a stranger is not either.
#ASSERT `Art 29(1) the person commits an offence` `the favoured interpretation` FALSE `T29 information received under the Law` `T30 a private person discloses to the Comptroller who requires it`
#ASSERT `Art 29(1) the person commits an offence` `the favoured interpretation` FALSE `T29 information received under the Law` `T30 the Commissioner discloses to a stranger who requires it`
#ASSERT `Art 30 the disclosure is one the Commissioner must make` `T30 a disclosure the Commissioner must make to the Comptroller`
#ASSERT `Art 30 the disclosure is one the Commissioner must make` `T30 a disclosure the Commissioner must make to the JFSC`
#ASSERT NOT `Art 30 the disclosure is one the Commissioner must make` `T30 a private person discloses to the Comptroller who requires it`
#ASSERT NOT `Art 30 the disclosure is one the Commissioner must make` `T30 the Commissioner discloses to a stranger who requires it`

-- The penalty: 2 years (24 months) and a fine with no maximum stated, only where an offence is committed.
#ASSERT `Art 29(1) the penalty the person is liable to` `the favoured interpretation` FALSE `T29 information received under the Law` `T29 a disclosure with no consent` EQUALS JUST (`Penalty provided` OF (JUST 24), `a fine with no maximum stated in the Law`)
#ASSERT `Art 29(1) the penalty the person is liable to` `the favoured interpretation` FALSE `T29 information received under the Law` `T29 a disclosure with both consents` EQUALS NOTHING

-- The prohibition as it bears on a disclosure that would be an offence: it stands, and the disclosure breaches it.
-- EXPECT: STANDING MUST NOT
#TRACE `Art 29(1) the person must not disclose the information` `the favoured interpretation` FALSE `T29 information received under the Law` `T29 a disclosure with no consent` AT 0 WITH
    -- no events

-- EXPECT: BREACH Article 29(1)
#TRACE `Art 29(1) the person must not disclose the information` `the favoured interpretation` FALSE `T29 information received under the Law` `T29 a disclosure with no consent` AT 0 WITH
    PARTY `any person` DOES `disclose restricted information` AT 6

-- With the consent the Article requires (or a permitted purpose, or an exception), there is nothing prohibited.
-- EXPECT: FULFILLED
#TRACE `Art 29(1) the person must not disclose the information` `the favoured interpretation` FALSE `T29 information received under the Law` `T29 a disclosure with the consent of the person it relates to` AT 0 WITH
    -- no events

-- EXPECT: FULFILLED
#TRACE `Art 29(1) the person must not disclose the information` `the favoured interpretation` TRUE `T29 information received under the Law` `T29 a disclosure with no consent` AT 0 WITH
    -- no events

-- Received from another recipient, consent of one only: prohibited on the taken reading, nothing prohibited on the other.
-- EXPECT: STANDING MUST NOT
#TRACE `Art 29(1) the person must not disclose the information` `the favoured interpretation` FALSE `T29 information received from a person who received it under the Law` `T29 a disclosure with the consent of the person it relates to` AT 0 WITH
    -- no events

-- EXPECT: FULFILLED
#TRACE `Art 29(1) the person must not disclose the information` `the interpretation with the other reading of F8.11` FALSE `T29 information received from a person who received it under the Law` `T29 a disclosure with the consent of the person it relates to` AT 0 WITH
    -- no events

§§ `30 -- the Commissioner must disclose`

-- EXPECT: STANDING MUST
#TRACE `Art 30(1) the Commissioner must disclose information to the Comptroller` TRUE AT 0 WITH
    -- no events

