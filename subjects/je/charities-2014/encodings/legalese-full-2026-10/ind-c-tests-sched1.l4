-- S1.3-09, S1.3-10: expiry of the period; membership of the States
#ASSERT `Sch 1 para 3(4) the day on which the appointment expires` `the favoured interpretation` (`ind-c Commissioner appointment` (YMD 2026 3 1) (YMD 2026 3 1) (YMD 2032 3 1) NOTHING NOTHING FALSE NOTHING EMPTY) EQUALS YMD 2032 3 1
#ASSERT `Sch 1 para 3(4) the day on which the appointment expires` `the favoured interpretation` (`ind-c Commissioner appointment` (YMD 2026 3 1) (YMD 2026 3 1) (YMD 2032 3 1) NOTHING NOTHING FALSE (JUST (YMD 2028 6 1)) EMPTY) EQUALS YMD 2028 6 1
-- S1.3-11: twelve years of service.  Consecutive: six years then a re-appointment from 1 March 2026 completes twelve on 1 March 2032.
#ASSERT `Sch 1 para 3(4) the day on which the appointment expires` `the favoured interpretation` (`ind-c Commissioner appointment` (YMD 2026 3 1) (YMD 2026 3 1) (YMD 2032 3 1) NOTHING NOTHING TRUE NOTHING (LIST (`ind-c service` (YMD 2020 3 1) (YMD 2026 3 1)))) EQUALS YMD 2032 3 1
-- aggregate 6 + 6 with a gap has expired by the end of the second six; 6 + 5 has not
#ASSERT `Sch 1 para 3(4) the appointment has expired by the day` `the favoured interpretation` (`ind-c Commissioner appointment` (YMD 2022 3 1) (YMD 2022 3 1) (YMD 2028 3 1) NOTHING NOTHING TRUE NOTHING (LIST (`ind-c service` (YMD 2014 3 1) (YMD 2020 3 1)))) (YMD 2028 3 1)
#ASSERT NOT `Sch 1 para 3(4) the appointment has expired by the day` `the favoured interpretation` (`ind-c Commissioner appointment` (YMD 2022 3 1) (YMD 2022 3 1) (YMD 2028 3 1) NOTHING NOTHING TRUE NOTHING (LIST (`ind-c service` (YMD 2014 3 1) (YMD 2020 3 1)))) (YMD 2027 3 1)
-- S1.3-12: ten years served, re-appointed for six: the appointment expires after two more years
#ASSERT `Sch 1 para 3(4) the day on which the appointment expires` `the favoured interpretation` (`ind-c Commissioner appointment` (YMD 2026 3 1) (YMD 2026 3 1) (YMD 2032 3 1) NOTHING NOTHING FALSE NOTHING (LIST (`ind-c service` (YMD 2016 3 1) (YMD 2026 3 1)))) EQUALS YMD 2028 3 1

§ `ind-c Schedule 1 paragraph 4 -- staff, the relevant person and the report`

-- S1.4-01 .. S1.4-07: what staff may and may not decide
#ASSERT NOT `ind-c staff may` `the favoured interpretation` `whether to register an applicant, Article 11` `ind-c does` TRUE
#ASSERT NOT `ind-c staff may` `the favoured interpretation` `whether to register an applicant, Article 11` `ind-c refuses` TRUE
#ASSERT NOT `ind-c staff may` `the favoured interpretation` `whether to deregister a charity on its own application, Article 15(3)` `ind-c refuses` TRUE
-- S1.4-03 (pre-committed ambiguous; reading A taken): granting deregistration on application is reserved too; reading B lets staff do it
#ASSERT NOT `ind-c staff may` `the favoured interpretation` `whether to deregister a charity on its own application, Article 15(3)` `ind-c does` TRUE
#ASSERT `ind-c staff may` `the favoured interpretation, but F9.8 is read as B` `whether to deregister a charity on its own application, Article 15(3)` `ind-c does` TRUE
#ASSERT NOT `ind-c staff may` `the favoured interpretation` `whether to deregister a charity in other cases, Article 16` `ind-c does` TRUE
#ASSERT `ind-c staff may` `the favoured interpretation` `whether to impose a requirement contained in a notice under Article 26` `ind-c does` TRUE
#ASSERT NOT `ind-c staff may` `the favoured interpretation` `whether to impose a requirement contained in a notice under Article 26` `ind-c does` FALSE
#ASSERT `ind-c staff may` `the favoured interpretation` `whether to impose a requirement contained in a required steps notice` `ind-c does` TRUE
#ASSERT `ind-c staff may` `the favoured interpretation` `whether to enter a charity in the restricted section, Article 9(6) and (7)` `ind-c refuses` TRUE
#ASSERT `ind-c staff may` `the favoured interpretation` `whether to permit a change or addition of registered name, Article 12(4)` `ind-c refuses` TRUE
-- S1.4-08 .. S1.4-10: the designated relevant person
#ASSERT `Sch 1 para 4(5) the relevant person is treated as the Commissioner` TRUE TRUE FALSE
#ASSERT NOT `Sch 1 para 4(5) the relevant person is treated as the Commissioner` TRUE FALSE FALSE
#ASSERT `Sch 1 para 4(5) the relevant person is treated as the Commissioner` TRUE FALSE TRUE
#ASSERT NOT `Sch 1 para 4(5) the relevant person is treated as the Commissioner` FALSE FALSE TRUE
#ASSERT NOT `Sch 1 para 4(5) someone is treated as the Commissioner` FALSE FALSE TRUE
-- S1.4-11: a States' employee made available, under the Commissioner's direction
#ASSERT `Sch 1 para 4(2) the employee is to be treated as a member of the Commissioner's staff for the function` TRUE TRUE TRUE
#ASSERT NOT `Sch 1 para 4(2) the employee is to be treated as a member of the Commissioner's staff for the function` TRUE TRUE FALSE
-- S1.4-13 (pre-committed ambiguous on 1 May; reading A taken): the report for 2025
#ASSERT `Sch 1 para 4(9) the Commissioner provided the Minister with the report in time` `the favoured interpretation` (`ind-c report` 2025 (JUST (YMD 2026 4 30)) TRUE TRUE)
#ASSERT NOT `Sch 1 para 4(9) the Commissioner provided the Minister with the report in time` `the favoured interpretation` (`ind-c report` 2025 (JUST (YMD 2026 5 1)) TRUE TRUE)
#ASSERT `Sch 1 para 4(9) the Commissioner provided the Minister with the report in time` `the favoured interpretation, but F9.7 is read as B` (`ind-c report` 2025 (JUST (YMD 2026 5 1)) TRUE TRUE)
#ASSERT NOT `Sch 1 para 4(9) the Commissioner provided the Minister with the report in time` `the favoured interpretation, but F9.7 is read as B` (`ind-c report` 2025 (JUST (YMD 2026 5 2)) TRUE TRUE)
#ASSERT NOT `Sch 1 para 4(9) the Commissioner provided the Minister with the report in time` `the favoured interpretation` (`ind-c report` 2025 (JUST (YMD 2026 5 2)) TRUE TRUE)
#ASSERT `Sch 1 para 4(9) the last day for providing the Minister with the report` `the favoured interpretation` 2025 EQUALS YMD 2026 4 30
-- S1.4-14: prepared but not published
#ASSERT NOT `Sch 1 para 4(8) the Commissioner has prepared and published the report` (`ind-c report` 2025 NOTHING TRUE FALSE)
#ASSERT `Sch 1 para 4(8) the Commissioner has prepared and published the report` (`ind-c report` 2025 NOTHING TRUE TRUE)
-- S1.4-18 .. S1.4-20: directions on the report
#ASSERT NOT `Sch 1 para 4(12) the directions are within the limit` TRUE TRUE
