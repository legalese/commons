#ASSERT `Art 21 the penalty for the contravention` `paragraph (2) of Article 21` EQUALS `the penalty of imprisonment for a term of 2 years and a fine`
#ASSERT `Art 21 the penalty for the contravention` `paragraph (4) of Article 21` EQUALS `the penalty of imprisonment for a term of 2 years and a fine`
#ASSERT `Art 21 the penalty for the contravention` `paragraph (6) of Article 21` EQUALS `the penalty of imprisonment for a term of 2 years and a fine`
#ASSERT `Art 23 the penalty for the contravention` `paragraph (1) of Article 23` EQUALS `the penalty of a fine of level 3 on the standard scale`
#ASSERT `Art 23 the penalty for the contravention` `paragraph (2) of Article 23` EQUALS `the penalty of imprisonment for a term of 2 years and a fine`
#ASSERT `Art 21 and 23 the penalty for the contravention` `paragraph (1) of Article 21` EQUALS `the penalty of a fine of level 3 on the standard scale`
#ASSERT `Art 21 and 23 the penalty for the contravention` `paragraph (2) of Article 21` EQUALS `the penalty of imprisonment for a term of 2 years and a fine`
#ASSERT `Art 21 and 23 the penalty for the contravention` `paragraph (3) of Article 21` EQUALS `the penalty of a fine of level 3 on the standard scale`
#ASSERT `Art 21 and 23 the penalty for the contravention` `paragraph (4) of Article 21` EQUALS `the penalty of imprisonment for a term of 2 years and a fine`
