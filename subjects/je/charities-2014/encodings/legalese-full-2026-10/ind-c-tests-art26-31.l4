#ASSERT NOT `Art 26(10) the person commits an offence` (`ind-c false information` TRUE TRUE FALSE FALSE TRUE TRUE)
#ASSERT `Art 26(10) the person commits an offence` (`ind-c false information` TRUE TRUE TRUE FALSE FALSE TRUE)
#ASSERT `Art 26(10) the person commits an offence` (`ind-c false information` TRUE TRUE TRUE FALSE TRUE FALSE)
