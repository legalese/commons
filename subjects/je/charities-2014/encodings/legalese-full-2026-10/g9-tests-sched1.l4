#ASSERT `Sch 1 para 4(10) the Minister laid a copy of the report before the States as soon as practicable` `B of F9.10, 28 days` (`build a report` 2026 TRUE TRUE (JUST (YMD 2027 2 1)) TRUE (JUST (YMD 2027 3 1)) FALSE) (YMD 2027 2 1)
#ASSERT NOT `Sch 1 para 4(10) the Minister laid a copy of the report before the States as soon as practicable` `A` (`build a report` 2026 TRUE TRUE (JUST (YMD 2027 2 1)) TRUE NOTHING TRUE) (YMD 2027 2 1)

