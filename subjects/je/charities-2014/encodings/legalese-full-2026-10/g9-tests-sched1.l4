-- EXPECT: BREACH BY `the Minister`
#TRACE `Sch 1 para 4(10) the Minister must lay a copy of the report so provided before the States as soon as practicable after receiving it` `B of F9.10, 28 days` (JUST (YMD 2027 2 1)) AT (DATE_SERIAL (YMD 2027 2 1)) WITH
    PARTY `the Minister` DOES `Sch 1: the Minister lays a copy of the report before the States` AT (DATE_SERIAL (YMD 2027 3 2))

-- laid on 15 March 2027: as soon as practicable is a judgement on reading A, 42 days on reading B
#ASSERT `Sch 1 para 4(10) the Minister laid a copy of the report before the States as soon as practicable` `A` (`build a report` 2026 TRUE TRUE (JUST (YMD 2027 2 1)) TRUE (JUST (YMD 2027 3 15)) TRUE) (YMD 2027 2 1)
#ASSERT NOT `Sch 1 para 4(10) the Minister laid a copy of the report before the States as soon as practicable` `A` (`build a report` 2026 TRUE TRUE (JUST (YMD 2027 2 1)) TRUE (JUST (YMD 2027 3 15)) FALSE) (YMD 2027 2 1)
