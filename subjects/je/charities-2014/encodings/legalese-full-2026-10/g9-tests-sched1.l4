#ASSERT `Sch 1 para 2(4)(a) the remuneration of the Commissioner must be paid out of the annual income of the States` `B of F9.9` `the text of 31 May 2019` TRUE
#ASSERT `Sch 1 para 2(4)(a) the remuneration of the Commissioner must be paid out of the annual income of the States` `A` `the text of 16 December 2019` FALSE
#ASSERT NOT `Sch 1 para 2(4)(a) the remuneration of the Commissioner must be paid out of the annual income of the States` `A` `the text of 16 December 2019` TRUE
#ASSERT `Sch 1 para 2(4)(a) the remuneration of the Commissioner must be paid out of the annual income of the States` `B of F9.9` `the text of 16 December 2019` TRUE
#ASSERT `Sch 1 para 2(4)(a) the remuneration of the Commissioner must be paid out of the annual income of the States` `B of F9.9` `the text of 16 December 2019` FALSE
#ASSERT NOT `Sch 1 para 2(4)(a) the remuneration of the Commissioner must be paid out of the annual income of the States` `A` `the text of 2 October 2026` TRUE
#ASSERT `Sch 1 para 2(4)(a) the remuneration of the Commissioner must be paid out of the annual income of the States` `A` `the text of 2 October 2026` FALSE
#ASSERT `Sch 1 para 2(4)(a) the remuneration of the Commissioner must be paid out of the annual income of the States` `B of F9.9` `the text of 2 October 2026` TRUE
#ASSERT `Sch 1 para 2(4)(a) the remuneration of the Commissioner must be paid out of the annual income of the States` `A` `the text of 12 April 2023` FALSE
#ASSERT NOT `Sch 1 para 2(4)(a) the remuneration of the Commissioner must be paid out of the annual income of the States` `A` `the text of 27 February 2024` TRUE
#ASSERT REFUSED `Sch 1 para 2(4)(a) the remuneration of the Commissioner must be paid out of the annual income of the States` `A` `before the first consolidated version` TRUE
