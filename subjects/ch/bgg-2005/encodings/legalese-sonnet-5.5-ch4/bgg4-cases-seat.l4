IMPORT prelude
IMPORT daydate
IMPORT `bgg3-nouns`
IMPORT `bgg4-nouns`
IMPORT `bgg4-seat`

-- bgg4-cases-seat: asserted cases for the seat questions of bgg4-seat.  At least one case per question, and for each question
-- a case in which the answer is NOTHING where the text leaves a case undecided.  Expected values are written from the German text
-- (and, where a question calls chapter 3, from the chapter 3 text), not from the code's output.
-- The record questions are asserted field by field.


§ `Which decisions can I appeal (Art 90 to 94)`

#ASSERT `Art 90 to 93 the appeal is admissible against my decision` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Art 90 to 93 the appeal is admissible against my decision` FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Art 90 to 93 the appeal is admissible against my decision` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `Art 90 to 93 the appeal is admissible against my decision` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `Art 92(2) my decision on jurisdiction or recusal can be challenged later` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Art 92(2) my decision on jurisdiction or recusal can be challenged later` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `Art 93(3) my other preliminary decision can be challenged by the appeal against the final decision` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 93(3) my other preliminary decision can be challenged by the appeal against the final decision` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Art 93(3) my other preliminary decision can be challenged by the appeal against the final decision` FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `Art 94 the appeal lies against the unlawful refusal or delay of my decision` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 94 the appeal lies against the unlawful refusal or delay of my decision` FALSE FALSE FALSE EQUALS NOTHING

§ `On what grounds (Art 95 to 98)`

#ASSERT `Art 95 I can complain of the violation of this source of law` FALSE `federal law` EQUALS JUST TRUE
#ASSERT `Art 95 I can complain of the violation of this source of law` FALSE `another source of law` EQUALS NOTHING
#ASSERT `Art 95 I can complain of the violation of this source of law` TRUE `international law` EQUALS NOTHING
#ASSERT `Art 96 I can complain about the application of foreign law` FALSE `foreign law was not applied as Swiss private international law prescribes` FALSE EQUALS JUST TRUE
#ASSERT `Art 96 I can complain about the application of foreign law` FALSE `foreign law that Swiss private international law makes applicable was applied wrongly` TRUE EQUALS JUST FALSE
#ASSERT `Art 96 I can complain about the application of foreign law` FALSE `foreign law that Swiss private international law makes applicable was applied wrongly` FALSE EQUALS JUST TRUE
#ASSERT `Art 96 I can complain about the application of foreign law` FALSE `another complaint about foreign law` FALSE EQUALS NOTHING
#ASSERT `Art 97 I can complain about the finding of the facts` FALSE FALSE FALSE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 97 I can complain about the finding of the facts` FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Art 97 I can complain about the finding of the facts` FALSE TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Art 97 I can complain about the finding of the facts` FALSE TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `Art 98 I can raise this complaint against the decision on provisional measures` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 98 I can raise this complaint against the decision on provisional measures` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 98 I can raise this complaint against the decision on provisional measures` FALSE FALSE FALSE EQUALS NOTHING

§ `New submissions (Art 99)`

#ASSERT `Art 99(1) I may put forward the new fact or new evidence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 99(1) I may put forward the new fact or new evidence` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 99(1) I may put forward the new fact or new evidence` FALSE FALSE EQUALS NOTHING
#ASSERT `Art 99(2) my new claim is admissible` TRUE EQUALS JUST FALSE
#ASSERT `Art 99(2) my new claim is admissible` FALSE EQUALS NOTHING

§ `By when must I appeal (Art 100 and 101)`

#ASSERT `Art 100 the number of days I have to appeal against a decision` `a decision of none of these kinds` FALSE EQUALS 30
#ASSERT `Art 100 the number of days I have to appeal against a decision` `(3)(b) decision of a cantonal government on an appeal against a federal vote` FALSE EQUALS 5
#ASSERT `Art 100 the number of days I have to appeal against a decision` `(4) decision of a cantonal government on an appeal against a National Council election` FALSE EQUALS 3
#ASSERT `Art 100 the number of days I have to appeal against a decision` `(2)(a) decision of a cantonal supervisory authority in debt enforcement and bankruptcy matters` FALSE EQUALS 10
#ASSERT `Art 100 the number of days I have to appeal against a decision` `(2)(a) decision of a cantonal supervisory authority in debt enforcement and bankruptcy matters` TRUE EQUALS 5
