#ASSERT `Art 102(1) the Court must send my appeal to this recipient and set a time limit` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 102(1) the Court must send my appeal to this recipient and set a time limit` FALSE FALSE EQUALS NOTHING
