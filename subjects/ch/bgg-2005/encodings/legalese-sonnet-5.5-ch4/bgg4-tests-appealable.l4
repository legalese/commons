IMPORT prelude
IMPORT `bgg4-nouns`
IMPORT `bgg4-appealable`

-- bgg4-tests-appealable: tests for Art 90 to 94.  Every expected value is written from the
-- text before the run (the quoted German is beside the assertion); no value was copied from
-- the code's own output.  JUST TRUE = the text says yes, JUST FALSE = the text says no in
-- its own words, NOTHING = not covered.

§ `Art 90 tests`

-- "Die Beschwerde ist zulässig gegen Entscheide, die das Verfahren abschliessen."
#ASSERT `Art 90 the appeal is admissible against the decision` TRUE EQUALS JUST TRUE
-- A decision that does not end the proceedings: the Article is silent (Art 91 to 93 take it).
#ASSERT `Art 90 the appeal is admissible against the decision` FALSE EQUALS NOTHING

§ `Art 91 tests`

-- (a) "nur einen Teil der gestellten Begehren behandelt, wenn diese Begehren unabhängig von den anderen beurteilt werden können"
#ASSERT `Art 91(a) the appeal is admissible against the decision that deals with only some of the claims` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 91(a) the appeal is admissible against the decision that deals with only some of the claims` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 91(a) the appeal is admissible against the decision that deals with only some of the claims` FALSE TRUE EQUALS NOTHING
#ASSERT `Art 91(a) the appeal is admissible against the decision that deals with only some of the claims` FALSE FALSE EQUALS NOTHING
-- (b) "das Verfahren nur für einen Teil der Streitgenossen und Streitgenossinnen abschliesst"
#ASSERT `Art 91(b) the appeal is admissible against the decision that ends the proceedings for only some of the joint litigants` TRUE EQUALS JUST TRUE
#ASSERT `Art 91(b) the appeal is admissible against the decision that ends the proceedings for only some of the joint litigants` FALSE EQUALS NOTHING
-- the whole Article: limb (a) holds
#ASSERT `Art 91 the appeal is admissible against the partial decision` TRUE TRUE FALSE EQUALS JUST TRUE
-- limb (b) holds
#ASSERT `Art 91 the appeal is admissible against the partial decision` FALSE FALSE TRUE EQUALS JUST TRUE
-- limb (a) engaged but its "wenn" fails, limb (b) does not hold
#ASSERT `Art 91 the appeal is admissible against the partial decision` TRUE FALSE FALSE EQUALS JUST FALSE
-- limb (a) engaged but its "wenn" fails, limb (b) holds: (b) still says yes
#ASSERT `Art 91 the appeal is admissible against the partial decision` TRUE FALSE TRUE EQUALS JUST TRUE
-- neither kind of decision: not covered
#ASSERT `Art 91 the appeal is admissible against the partial decision` FALSE FALSE FALSE EQUALS NOTHING

§ `Art 92 tests`

-- (1) "Gegen selbständig eröffnete Vor- und Zwischenentscheide über die Zuständigkeit und über Ausstandsbegehren ist die Beschwerde zulässig."
#ASSERT `Art 92(1) the appeal is admissible against the preliminary or interlocutory decision on jurisdiction or recusal` TRUE TRUE TRUE EQUALS JUST TRUE
-- not notified independently
#ASSERT `Art 92(1) the appeal is admissible against the preliminary or interlocutory decision on jurisdiction or recusal` TRUE FALSE TRUE EQUALS NOTHING
-- not on jurisdiction or recusal
#ASSERT `Art 92(1) the appeal is admissible against the preliminary or interlocutory decision on jurisdiction or recusal` TRUE TRUE FALSE EQUALS NOTHING
-- not a preliminary decision at all
#ASSERT `Art 92(1) the appeal is admissible against the preliminary or interlocutory decision on jurisdiction or recusal` FALSE TRUE TRUE EQUALS NOTHING
-- (2) "Diese Entscheide können später nicht mehr angefochten werden."
#ASSERT `Art 92(2) the decision can be challenged later` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Art 92(2) the decision can be challenged later` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `Art 92(2) the decision can be challenged later` FALSE TRUE TRUE EQUALS NOTHING

§ `Art 93 tests`

-- (1)(a) "wenn sie einen nicht wieder gutzumachenden Nachteil bewirken können"
#ASSERT `Art 93(1)(a) the appeal is admissible because the decision may cause irreparable harm` TRUE EQUALS JUST TRUE
#ASSERT `Art 93(1)(a) the appeal is admissible because the decision may cause irreparable harm` FALSE EQUALS JUST FALSE
-- (1)(b) "wenn die Gutheissung der Beschwerde sofort einen Endentscheid herbeiführen und damit einen bedeutenden Aufwand ... ersparen würde": both facts needed
#ASSERT `Art 93(1)(b) the appeal is admissible because allowing it would immediately bring about a final decision` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 93(1)(b) the appeal is admissible because allowing it would immediately bring about a final decision` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 93(1)(b) the appeal is admissible because allowing it would immediately bring about a final decision` FALSE TRUE EQUALS JUST FALSE
-- (1) the paragraph: argument order is prelim, independent, jurisdiction-or-recusal, harm, immediate, saves
-- limb (a) alone
#ASSERT `Art 93(1) the appeal is admissible against the other preliminary or interlocutory decision` TRUE TRUE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- limb (b) alone
#ASSERT `Art 93(1) the appeal is admissible against the other preliminary or interlocutory decision` TRUE TRUE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
-- neither limb
#ASSERT `Art 93(1) the appeal is admissible against the other preliminary or interlocutory decision` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- a decision of Art 92 is not an "andere" decision
#ASSERT `Art 93(1) the appeal is admissible against the other preliminary or interlocutory decision` TRUE TRUE TRUE TRUE FALSE FALSE EQUALS NOTHING
-- not notified independently
#ASSERT `Art 93(1) the appeal is admissible against the other preliminary or interlocutory decision` TRUE FALSE FALSE TRUE FALSE FALSE EQUALS NOTHING
-- not a preliminary decision
#ASSERT `Art 93(1) the appeal is admissible against the other preliminary or interlocutory decision` FALSE TRUE FALSE TRUE FALSE FALSE EQUALS NOTHING
-- (2): argument order is prelim, legal assistance, asylum, extradition detention, seizure, independent, jurisdiction-or-recusal, harm, immediate, saves
-- legal assistance, a decision on a different subject: "nicht anfechtbar"
#ASSERT `Art 93(2) the appeal is admissible against the preliminary or interlocutory decision in the field` TRUE TRUE FALSE FALSE FALSE TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
-- asylum, a different subject: "nicht anfechtbar"
#ASSERT `Art 93(2) the appeal is admissible against the preliminary or interlocutory decision in the field` TRUE FALSE TRUE FALSE FALSE TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
-- legal assistance, extradition detention, and the conditions of paragraph 1 are met: reserved
#ASSERT `Art 93(2) the appeal is admissible against the preliminary or interlocutory decision in the field` TRUE TRUE FALSE TRUE FALSE TRUE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- legal assistance, seizure of assets, conditions of paragraph 1 met through limb (b): reserved
#ASSERT `Art 93(2) the appeal is admissible against the preliminary or interlocutory decision in the field` TRUE TRUE FALSE FALSE TRUE TRUE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
-- legal assistance, extradition detention, conditions of paragraph 1 not met: the bar stands
#ASSERT `Art 93(2) the appeal is admissible against the preliminary or interlocutory decision in the field` TRUE TRUE FALSE TRUE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- another field: not covered by this paragraph
#ASSERT `Art 93(2) the appeal is admissible against the preliminary or interlocutory decision in the field` TRUE FALSE FALSE FALSE FALSE TRUE FALSE TRUE FALSE FALSE EQUALS NOTHING
-- not a preliminary decision: not covered by this paragraph
#ASSERT `Art 93(2) the appeal is admissible against the preliminary or interlocutory decision in the field` FALSE TRUE FALSE TRUE FALSE TRUE FALSE TRUE FALSE FALSE EQUALS NOTHING
-- (3): argument order is other-prelim, not admissible under 1-2, not used, affects content
#ASSERT `Art 93(3) the preliminary or interlocutory decision can be challenged by the appeal against the final decision` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 93(3) the preliminary or interlocutory decision can be challenged by the appeal against the final decision` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
-- the appeal under 1 and 2 was admissible and was used: the "Ist ..., so" is not met
#ASSERT `Art 93(3) the preliminary or interlocutory decision can be challenged by the appeal against the final decision` TRUE FALSE FALSE TRUE EQUALS JUST FALSE
-- the decision does not affect the content: "soweit" limits the grant
#ASSERT `Art 93(3) the preliminary or interlocutory decision can be challenged by the appeal against the final decision` TRUE TRUE FALSE FALSE EQUALS NOTHING
-- a decision of Art 92 or a final decision is not one of paragraphs 1 and 2
#ASSERT `Art 93(3) the preliminary or interlocutory decision can be challenged by the appeal against the final decision` FALSE TRUE FALSE TRUE EQUALS NOTHING

§ `Art 94 tests`

-- "Gegen das unrechtmässige Verweigern oder Verzögern eines anfechtbaren Entscheids kann Beschwerde geführt werden."
#ASSERT `Art 94 the appeal lies against the unlawful refusal or delay of a decision` TRUE TRUE TRUE EQUALS JUST TRUE
-- lawful refusal or delay: not covered
#ASSERT `Art 94 the appeal lies against the unlawful refusal or delay of a decision` TRUE FALSE TRUE EQUALS NOTHING
-- the decision refused could not itself be appealed: not covered
#ASSERT `Art 94 the appeal lies against the unlawful refusal or delay of a decision` TRUE TRUE FALSE EQUALS NOTHING
-- nothing refused or delayed
#ASSERT `Art 94 the appeal lies against the unlawful refusal or delay of a decision` FALSE TRUE TRUE EQUALS NOTHING

§ `Arts 90 to 93 together: tests`

-- argument order: ends proceedings, deals with only some claims, independent, ends for some joint litigants, prelim, independent notification, jurisdiction-or-recusal, legal assistance, asylum, extradition detention, seizure, harm, immediate, saves
-- a final decision (Art 90)
#ASSERT `Art 90 to 93 the appeal is admissible against the decision` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- a partial decision with independent claims (Art 91(a))
#ASSERT `Art 90 to 93 the appeal is admissible against the decision` FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- a partial decision whose claims are not independent (Art 91(a) fails, nothing else holds)
#ASSERT `Art 90 to 93 the appeal is admissible against the decision` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- a decision ending the case for some joint litigants (Art 91(b))
#ASSERT `Art 90 to 93 the appeal is admissible against the decision` FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- an independently notified decision on jurisdiction (Art 92(1))
#ASSERT `Art 90 to 93 the appeal is admissible against the decision` FALSE FALSE FALSE FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- another preliminary decision with irreparable harm (Art 93(1)(a))
#ASSERT `Art 90 to 93 the appeal is admissible against the decision` FALSE FALSE FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- another preliminary decision with neither limb (Art 93(1))
#ASSERT `Art 90 to 93 the appeal is admissible against the decision` FALSE FALSE FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- a preliminary decision in international legal assistance with irreparable harm, not on detention or seizure: Art 93(2) bars it although Art 93(1)(a) would grant
#ASSERT `Art 90 to 93 the appeal is admissible against the decision` FALSE FALSE FALSE FALSE TRUE TRUE FALSE TRUE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
-- the same on extradition detention with irreparable harm: the reservation lifts the bar
#ASSERT `Art 90 to 93 the appeal is admissible against the decision` FALSE FALSE FALSE FALSE TRUE TRUE FALSE TRUE FALSE TRUE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- a decision that is none of these kinds: not covered
#ASSERT `Art 90 to 93 the appeal is admissible against the decision` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
