IMPORT prelude
IMPORT `bgg4-nouns`
IMPORT `bgg4-simplified`

-- bgg4-tests-simplified: tests for Art 108 and 109.  Expected values are written from the text.

§ `Art 108 tests`

-- (1)(a) "Nichteintreten auf offensichtlich unzulässige Beschwerden"
#ASSERT `Art 108(1)(a) the president of the division decides in the simplified procedure on non-entry because the appeal is obviously inadmissible` TRUE EQUALS JUST TRUE
#ASSERT `Art 108(1)(a) the president of the division decides in the simplified procedure on non-entry because the appeal is obviously inadmissible` FALSE EQUALS NOTHING
-- (1)(b) "Nichteintreten auf Beschwerden, die offensichtlich keine hinreichende Begründung (Art. 42 Abs. 2) enthalten"
#ASSERT `Art 108(1)(b) the president of the division decides in the simplified procedure on non-entry because the appeal obviously lacks sufficient reasoning` TRUE EQUALS JUST TRUE
#ASSERT `Art 108(1)(b) the president of the division decides in the simplified procedure on non-entry because the appeal obviously lacks sufficient reasoning` FALSE EQUALS NOTHING
-- (1)(c) "Nichteintreten auf querulatorische oder rechtsmissbräuchliche Beschwerden"
#ASSERT `Art 108(1)(c) the president of the division decides in the simplified procedure on non-entry because the appeal is querulous or an abuse of rights` TRUE EQUALS JUST TRUE
#ASSERT `Art 108(1)(c) the president of the division decides in the simplified procedure on non-entry because the appeal is querulous or an abuse of rights` FALSE EQUALS NOTHING
-- (1) the paragraph: each limb alone, then none
#ASSERT `Art 108(1) the president of the division decides in the simplified procedure on non-entry` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Art 108(1) the president of the division decides in the simplified procedure on non-entry` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Art 108(1) the president of the division decides in the simplified procedure on non-entry` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 108(1) the president of the division decides in the simplified procedure on non-entry` FALSE FALSE FALSE EQUALS NOTHING
-- (2) "Er oder sie kann einen anderen Richter oder eine andere Richterin damit betrauen."
#ASSERT `Art 108(2) the president of the division may entrust another judge with the decision` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 108(2) the president of the division may entrust another judge with the decision` TRUE FALSE EQUALS NOTHING
#ASSERT `Art 108(2) the president of the division may entrust another judge with the decision` FALSE TRUE EQUALS NOTHING
-- (3) "Die Begründung des Entscheids beschränkt sich auf eine kurze Angabe des Unzulässigkeitsgrundes."
#ASSERT `Art 108(3) the reasons of the decision are confined to a short statement of the ground of inadmissibility` TRUE EQUALS JUST TRUE
#ASSERT `Art 108(3) the reasons of the decision are confined to a short statement of the ground of inadmissibility` FALSE EQUALS NOTHING

§ `Art 109 tests`

-- (1) first sentence: order is condition, legal question arises, particularly important case
#ASSERT `Art 109(1) the division decides in a bench of three on non-entry` `only if a legal question of fundamental importance arises` FALSE FALSE EQUALS JUST TRUE
#ASSERT `Art 109(1) the division decides in a bench of three on non-entry` `only if a legal question of fundamental importance arises` FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 109(1) the division decides in a bench of three on non-entry` `only if a legal question of fundamental importance arises` TRUE FALSE EQUALS NOTHING
#ASSERT `Art 109(1) the division decides in a bench of three on non-entry` `only if the case is a particularly important case` FALSE FALSE EQUALS JUST TRUE
#ASSERT `Art 109(1) the division decides in a bench of three on non-entry` `only if the case is a particularly important case` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Art 109(1) the division decides in a bench of three on non-entry` `only if the case is a particularly important case` FALSE TRUE EQUALS NOTHING
#ASSERT `Art 109(1) the division decides in a bench of three on non-entry` `only if a legal question of fundamental importance arises or the case is a particularly important case` FALSE FALSE EQUALS JUST TRUE
#ASSERT `Art 109(1) the division decides in a bench of three on non-entry` `only if a legal question of fundamental importance arises or the case is a particularly important case` TRUE FALSE EQUALS NOTHING
#ASSERT `Art 109(1) the division decides in a bench of three on non-entry` `only if a legal question of fundamental importance arises or the case is a particularly important case` FALSE TRUE EQUALS NOTHING
#ASSERT `Art 109(1) the division decides in a bench of three on non-entry` `on neither of these conditions` FALSE FALSE EQUALS NOTHING
-- (1) second sentence: "Artikel 58 Absatz 1 Buchstabe b findet keine Anwendung."
#ASSERT `Art 109(1) Art 58(1)(b) is applicable to the decision` `only if a legal question of fundamental importance arises` FALSE FALSE EQUALS JUST FALSE
#ASSERT `Art 109(1) Art 58(1)(b) is applicable to the decision` `only if a legal question of fundamental importance arises` TRUE FALSE EQUALS NOTHING
#ASSERT `Art 109(1) Art 58(1)(b) is applicable to the decision` `on neither of these conditions` FALSE FALSE EQUALS NOTHING
-- (2)(a) "Abweisung offensichtlich unbegründeter Beschwerden", bei Einstimmigkeit
#ASSERT `Art 109(2)(a) the division decides in a bench of three on dismissing the obviously unfounded appeal` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 109(2)(a) the division decides in a bench of three on dismissing the obviously unfounded appeal` FALSE TRUE EQUALS NOTHING
#ASSERT `Art 109(2)(a) the division decides in a bench of three on dismissing the obviously unfounded appeal` TRUE FALSE EQUALS NOTHING
-- (2)(b) "Gutheissung offensichtlich begründeter Beschwerden, insbesondere wenn der angefochtene Akt von der Rechtsprechung des Bundesgerichts abweicht und kein Anlass besteht, diese zu überprüfen"
#ASSERT `Art 109(2)(b) the division decides in a bench of three on upholding the obviously well founded appeal` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Art 109(2)(b) the division decides in a bench of three on upholding the obviously well founded appeal` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 109(2)(b) the division decides in a bench of three on upholding the obviously well founded appeal` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `Art 109(2)(b) the division decides in a bench of three on upholding the obviously well founded appeal` TRUE FALSE FALSE EQUALS NOTHING
-- (2) the paragraph: unanimous, obviously unfounded, obviously well founded, departs from case law
#ASSERT `Art 109(2) the division decides in a bench of three` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Art 109(2) the division decides in a bench of three` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Art 109(2) the division decides in a bench of three` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `Art 109(2) the division decides in a bench of three` TRUE FALSE FALSE FALSE EQUALS NOTHING
-- (3) "Der Entscheid wird summarisch begründet. Es kann ganz oder teilweise auf den angefochtenen Entscheid verwiesen werden."
#ASSERT `Art 109(3) the decision is given summary reasons` TRUE EQUALS JUST TRUE
#ASSERT `Art 109(3) the decision is given summary reasons` FALSE EQUALS NOTHING
#ASSERT `Art 109(3) the reasons may refer wholly or in part to the challenged decision` TRUE EQUALS JUST TRUE
#ASSERT `Art 109(3) the reasons may refer wholly or in part to the challenged decision` FALSE EQUALS NOTHING
