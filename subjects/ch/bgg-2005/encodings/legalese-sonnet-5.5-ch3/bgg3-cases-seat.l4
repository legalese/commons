#ASSERT `Art 89(2)(c) a municipality or other public-law corporation like me is also entitled to appeal` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 89(2)(c) a municipality or other public-law corporation like me is also entitled to appeal` FALSE TRUE EQUALS NOTHING

-- Art 89(2)(d) input: (another federal statute gives this right)
#ASSERT `Art 89(2)(d) another federal statute may give me the right to appeal` TRUE EQUALS JUST TRUE
#ASSERT `Art 89(2)(d) another federal statute may give me the right to appeal` FALSE EQUALS NOTHING

