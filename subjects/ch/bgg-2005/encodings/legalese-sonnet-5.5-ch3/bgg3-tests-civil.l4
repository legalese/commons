IMPORT prelude
IMPORT `bgg3-nouns`
IMPORT `bgg3-civil`

-- bgg3-tests-civil: tests for bgg3-civil (BGG Art. 72 to 77).
-- Every expected value was decided by reading the German text of the provision, written
-- down beside the assertion, and only then run.  JUST TRUE / JUST FALSE / NOTHING are the
-- text's yes, the text's no, and not covered.

§ `Constants for the tests`

`kind 1 recognition` MEANS `recognition and enforcement of judgments, or legal assistance in civil matters`
`kind 2 register` MEANS `keeping of a land, civil status, commercial or intellectual-property register`
`kind 3 name` MEANS `permission to change a name`
`kind 4 foundations` MEANS `supervision of foundations`
`kind 5 executors` MEANS `supervision of executors and other succession-law representatives`
`kind 6 protection` MEANS `child and adult protection`
`kind other` MEANS `another kind of decision`

§ `Art 72 tests`

-- Art 72(1): "Das Bundesgericht beurteilt Beschwerden gegen Entscheide in Zivilsachen."
#ASSERT `Art 72(1) the appeal in civil matters lies against the decision` TRUE EQUALS JUST TRUE           -- a decision in a civil matter: yes
#ASSERT `Art 72(1) the appeal in civil matters lies against the decision` FALSE EQUALS NOTHING            -- not a civil matter: the subsection is silent

-- Art 72(2)(a): "Entscheide in Schuldbetreibungs- und Konkurssachen"
#ASSERT `Art 72(2)(a) the appeal in civil matters also lies against the decision in a debt enforcement or bankruptcy matter` TRUE EQUALS JUST TRUE
#ASSERT `Art 72(2)(a) the appeal in civil matters also lies against the decision in a debt enforcement or bankruptcy matter` FALSE EQUALS NOTHING

-- Art 72(2)(b)(1) to (6): a public-law decision of the listed kind is listed "insbesondere"; anything else is not covered.
#ASSERT `Art 72(2)(b)(1) the public-law decision on recognition, enforcement or legal assistance is one in immediate connection with civil law` TRUE `kind 1 recognition` EQUALS JUST TRUE
#ASSERT `Art 72(2)(b)(1) the public-law decision on recognition, enforcement or legal assistance is one in immediate connection with civil law` FALSE `kind 1 recognition` EQUALS NOTHING     -- not a public-law decision
#ASSERT `Art 72(2)(b)(1) the public-law decision on recognition, enforcement or legal assistance is one in immediate connection with civil law` TRUE `kind 2 register` EQUALS NOTHING         -- another item's kind
#ASSERT `Art 72(2)(b)(2) the public-law decision on keeping a register is one in immediate connection with civil law` TRUE `kind 2 register` EQUALS JUST TRUE
#ASSERT `Art 72(2)(b)(2) the public-law decision on keeping a register is one in immediate connection with civil law` FALSE `kind 2 register` EQUALS NOTHING
#ASSERT `Art 72(2)(b)(2) the public-law decision on keeping a register is one in immediate connection with civil law` TRUE `kind 3 name` EQUALS NOTHING
#ASSERT `Art 72(2)(b)(3) the public-law decision on a name change is one in immediate connection with civil law` TRUE `kind 3 name` EQUALS JUST TRUE
#ASSERT `Art 72(2)(b)(3) the public-law decision on a name change is one in immediate connection with civil law` FALSE `kind 3 name` EQUALS NOTHING
#ASSERT `Art 72(2)(b)(3) the public-law decision on a name change is one in immediate connection with civil law` TRUE `kind other` EQUALS NOTHING
-- item 4: foundations "mit Ausnahme der Vorsorge- und Freizügigkeitseinrichtungen"
#ASSERT `Art 72(2)(b)(4) the public-law decision on supervising a foundation is one in immediate connection with civil law` TRUE `kind 4 foundations` FALSE EQUALS JUST TRUE
#ASSERT `Art 72(2)(b)(4) the public-law decision on supervising a foundation is one in immediate connection with civil law` TRUE `kind 4 foundations` TRUE EQUALS NOTHING     -- a pension or vested-benefits institution: excepted
#ASSERT `Art 72(2)(b)(4) the public-law decision on supervising a foundation is one in immediate connection with civil law` FALSE `kind 4 foundations` FALSE EQUALS NOTHING
#ASSERT `Art 72(2)(b)(4) the public-law decision on supervising a foundation is one in immediate connection with civil law` TRUE `kind 5 executors` FALSE EQUALS NOTHING
#ASSERT `Art 72(2)(b)(5) the public-law decision on supervising an executor or succession-law representative is one in immediate connection with civil law` TRUE `kind 5 executors` EQUALS JUST TRUE
#ASSERT `Art 72(2)(b)(5) the public-law decision on supervising an executor or succession-law representative is one in immediate connection with civil law` FALSE `kind 5 executors` EQUALS NOTHING
#ASSERT `Art 72(2)(b)(5) the public-law decision on supervising an executor or succession-law representative is one in immediate connection with civil law` TRUE `kind 6 protection` EQUALS NOTHING
#ASSERT `Art 72(2)(b)(6) the public-law decision on child and adult protection is one in immediate connection with civil law` TRUE `kind 6 protection` EQUALS JUST TRUE
#ASSERT `Art 72(2)(b)(6) the public-law decision on child and adult protection is one in immediate connection with civil law` FALSE `kind 6 protection` EQUALS NOTHING
#ASSERT `Art 72(2)(b)(6) the public-law decision on child and adult protection is one in immediate connection with civil law` TRUE `kind other` EQUALS NOTHING

-- Art 72(2)(b): public-law decisions in immediate connection with civil law (args: public-law, connection, kind, pension foundation)
#ASSERT `Art 72(2)(b) the appeal in civil matters also lies against the public-law decision` TRUE TRUE `kind other` FALSE EQUALS JUST TRUE             -- connection stated, kind not listed: the main clause
#ASSERT `Art 72(2)(b) the appeal in civil matters also lies against the public-law decision` TRUE FALSE `kind 3 name` FALSE EQUALS JUST TRUE          -- listed "insbesondere": no separate connection needed
#ASSERT `Art 72(2)(b) the appeal in civil matters also lies against the public-law decision` TRUE FALSE `kind other` FALSE EQUALS NOTHING             -- no connection, not listed
#ASSERT `Art 72(2)(b) the appeal in civil matters also lies against the public-law decision` FALSE TRUE `kind 3 name` FALSE EQUALS NOTHING            -- not a public-law decision
#ASSERT `Art 72(2)(b) the appeal in civil matters also lies against the public-law decision` TRUE FALSE `kind 4 foundations` TRUE EQUALS NOTHING      -- pension institution is outside item 4, and no connection stated
#ASSERT `Art 72(2)(b) the appeal in civil matters also lies against the public-law decision` TRUE TRUE `kind 4 foundations` TRUE EQUALS JUST TRUE      -- pension institution but the connection is stated: the main clause

-- Art 72(2): (a) or (b)   (args: debt, public-law, connection, kind, pension foundation)
#ASSERT `Art 72(2) the appeal in civil matters also lies against the decision` TRUE FALSE FALSE `kind other` FALSE EQUALS JUST TRUE
#ASSERT `Art 72(2) the appeal in civil matters also lies against the decision` FALSE TRUE FALSE `kind 6 protection` FALSE EQUALS JUST TRUE
#ASSERT `Art 72(2) the appeal in civil matters also lies against the decision` FALSE FALSE FALSE `kind other` FALSE EQUALS NOTHING
#ASSERT `Art 72(2) the appeal in civil matters also lies against the decision` FALSE TRUE FALSE `kind other` FALSE EQUALS NOTHING

-- Art 72 as a whole   (args: civil, debt, public-law, connection, kind, pension foundation)
#ASSERT `Art 72 the appeal in civil matters lies against the decision` TRUE FALSE FALSE FALSE `kind other` FALSE EQUALS JUST TRUE
#ASSERT `Art 72 the appeal in civil matters lies against the decision` FALSE TRUE FALSE FALSE `kind other` FALSE EQUALS JUST TRUE
#ASSERT `Art 72 the appeal in civil matters lies against the decision` FALSE FALSE TRUE TRUE `kind other` FALSE EQUALS JUST TRUE
#ASSERT `Art 72 the appeal in civil matters lies against the decision` FALSE FALSE FALSE FALSE `kind other` FALSE EQUALS NOTHING

§ `Art 73 tests`

-- Art 73: "Die Beschwerde ist unzulässig gegen Entscheide, die im Rahmen des Widerspruchsverfahrens gegen eine Marke getroffen worden sind."
#ASSERT `Art 73 the appeal in civil matters is admissible against the decision` TRUE EQUALS JUST FALSE
#ASSERT `Art 73 the appeal in civil matters is admissible against the decision` FALSE EQUALS NOTHING

§ `Art 74 tests (the thresholds: 15 000 and 30 000 francs)`

-- Art 74(1)(a): args (pecuniary, employment, tenancy, value).  "mindestens" 15 000: 15 000 is enough, 14 999 is not.
#ASSERT `Art 74(1)(a) the value in dispute is enough in an employment or tenancy law case` TRUE TRUE FALSE 15000 EQUALS JUST TRUE
#ASSERT `Art 74(1)(a) the value in dispute is enough in an employment or tenancy law case` TRUE TRUE FALSE 14999 EQUALS JUST FALSE
#ASSERT `Art 74(1)(a) the value in dispute is enough in an employment or tenancy law case` TRUE TRUE FALSE 14999.5 EQUALS JUST FALSE
#ASSERT `Art 74(1)(a) the value in dispute is enough in an employment or tenancy law case` TRUE FALSE TRUE 15000 EQUALS JUST TRUE
#ASSERT `Art 74(1)(a) the value in dispute is enough in an employment or tenancy law case` TRUE FALSE TRUE 14999 EQUALS JUST FALSE
#ASSERT `Art 74(1)(a) the value in dispute is enough in an employment or tenancy law case` TRUE TRUE TRUE 20000 EQUALS JUST TRUE       -- both: "und" read as a union (fork F2)
#ASSERT `Art 74(1)(a) the value in dispute is enough in an employment or tenancy law case` FALSE TRUE FALSE 1 EQUALS NOTHING         -- not a pecuniary matter
#ASSERT `Art 74(1)(a) the value in dispute is enough in an employment or tenancy law case` TRUE FALSE FALSE 15000 EQUALS NOTHING    -- neither employment nor tenancy: item (b) governs

-- Art 74(1)(b): "30 000 Franken in allen übrigen Fällen": 30 000 is enough, 29 999 is not.
#ASSERT `Art 74(1)(b) the value in dispute is enough in all other cases` TRUE FALSE FALSE 30000 EQUALS JUST TRUE
#ASSERT `Art 74(1)(b) the value in dispute is enough in all other cases` TRUE FALSE FALSE 29999 EQUALS JUST FALSE
#ASSERT `Art 74(1)(b) the value in dispute is enough in all other cases` TRUE TRUE FALSE 30000 EQUALS NOTHING                        -- an employment law case: item (a) governs
#ASSERT `Art 74(1)(b) the value in dispute is enough in all other cases` TRUE FALSE TRUE 30000 EQUALS NOTHING
#ASSERT `Art 74(1)(b) the value in dispute is enough in all other cases` FALSE FALSE FALSE 30000 EQUALS NOTHING                     -- not a pecuniary matter

-- Art 74(1): the two items together
#ASSERT `Art 74(1) the value in dispute is enough` TRUE TRUE FALSE 15000 EQUALS JUST TRUE
#ASSERT `Art 74(1) the value in dispute is enough` TRUE TRUE FALSE 14999 EQUALS JUST FALSE
#ASSERT `Art 74(1) the value in dispute is enough` TRUE FALSE TRUE 20000 EQUALS JUST TRUE       -- tenancy case: 15 000 is the amount, so 20 000 is enough
#ASSERT `Art 74(1) the value in dispute is enough` TRUE FALSE FALSE 30000 EQUALS JUST TRUE
#ASSERT `Art 74(1) the value in dispute is enough` TRUE FALSE FALSE 29999 EQUALS JUST FALSE
#ASSERT `Art 74(1) the value in dispute is enough` TRUE FALSE FALSE 15000 EQUALS JUST FALSE     -- any other case: 15 000 is not enough
#ASSERT `Art 74(1) the value in dispute is enough` FALSE FALSE FALSE 1 EQUALS NOTHING            -- not pecuniary: the subsection is silent

-- Art 74(2) limbs
#ASSERT `Art 74(2)(a) the appeal is admissible although the value is short, because a legal question of fundamental importance arises` TRUE EQUALS JUST TRUE
#ASSERT `Art 74(2)(a) the appeal is admissible although the value is short, because a legal question of fundamental importance arises` FALSE EQUALS JUST FALSE
#ASSERT `Art 74(2)(b) the appeal is admissible although the value is short, because a federal statute provides for a single cantonal instance` TRUE EQUALS JUST TRUE
#ASSERT `Art 74(2)(b) the appeal is admissible although the value is short, because a federal statute provides for a single cantonal instance` FALSE EQUALS JUST FALSE
#ASSERT `Art 74(2)(c) the appeal is admissible although the value is short against a decision of a cantonal supervisory authority` TRUE EQUALS JUST TRUE
#ASSERT `Art 74(2)(c) the appeal is admissible although the value is short against a decision of a cantonal supervisory authority` FALSE EQUALS NOTHING
#ASSERT `Art 74(2)(d) the appeal is admissible although the value is short against a decision of the bankruptcy and composition judge` TRUE EQUALS JUST TRUE
#ASSERT `Art 74(2)(d) the appeal is admissible although the value is short against a decision of the bankruptcy and composition judge` FALSE EQUALS NOTHING
#ASSERT `Art 74(2)(e) the appeal is admissible although the value is short against a decision of the Federal Patent Court` `Federal Patent Court` EQUALS JUST TRUE
#ASSERT `Art 74(2)(e) the appeal is admissible although the value is short against a decision of the Federal Patent Court` `last cantonal instance` EQUALS NOTHING

-- Art 74(2) as a whole: args (pecuniary, employment, tenancy, value, legal question, single cantonal instance, supervisory authority, bankruptcy judge, body)
#ASSERT `Art 74(2) the appeal is admissible although the value is short` TRUE FALSE FALSE 29999 TRUE FALSE FALSE FALSE `another body` EQUALS JUST TRUE    -- short, legal question
#ASSERT `Art 74(2) the appeal is admissible although the value is short` TRUE FALSE FALSE 29999 FALSE TRUE FALSE FALSE `another body` EQUALS JUST TRUE    -- short, single cantonal instance
#ASSERT `Art 74(2) the appeal is admissible although the value is short` TRUE FALSE FALSE 29999 FALSE FALSE TRUE FALSE `another body` EQUALS JUST TRUE    -- short, supervisory authority
#ASSERT `Art 74(2) the appeal is admissible although the value is short` TRUE FALSE FALSE 29999 FALSE FALSE FALSE TRUE `another body` EQUALS JUST TRUE    -- short, bankruptcy judge
#ASSERT `Art 74(2) the appeal is admissible although the value is short` TRUE FALSE FALSE 29999 FALSE FALSE FALSE FALSE `Federal Patent Court` EQUALS JUST TRUE    -- short, Patent Court
#ASSERT `Art 74(2) the appeal is admissible although the value is short` TRUE FALSE FALSE 29999 FALSE FALSE FALSE FALSE `another body` EQUALS JUST FALSE   -- short, no limb: no saving
#ASSERT `Art 74(2) the appeal is admissible although the value is short` TRUE FALSE FALSE 30000 FALSE FALSE FALSE FALSE `another body` EQUALS NOTHING      -- value enough: the subsection is not engaged
#ASSERT `Art 74(2) the appeal is admissible although the value is short` TRUE TRUE FALSE 14999 TRUE FALSE FALSE FALSE `another body` EQUALS JUST TRUE     -- employment case, short of 15 000, legal question
#ASSERT `Art 74(2) the appeal is admissible although the value is short` TRUE TRUE FALSE 15000 FALSE FALSE FALSE FALSE `another body` EQUALS NOTHING     -- employment case, exactly 15 000: not short
#ASSERT `Art 74(2) the appeal is admissible although the value is short` FALSE FALSE FALSE 1 TRUE FALSE FALSE FALSE `another body` EQUALS NOTHING         -- not a pecuniary matter: Art 74(1) does not apply

§ `Art 75 tests`

-- Art 75(1): "Die Beschwerde ist zulässig gegen Entscheide letzter kantonaler Instanzen, des Bundesverwaltungsgerichts und des Bundespatentgerichts."
#ASSERT `Art 75(1) the appeal in civil matters is admissible against the decision of this body` `last cantonal instance` EQUALS JUST TRUE
#ASSERT `Art 75(1) the appeal in civil matters is admissible against the decision of this body` `Federal Administrative Court` EQUALS JUST TRUE
#ASSERT `Art 75(1) the appeal in civil matters is admissible against the decision of this body` `Federal Patent Court` EQUALS JUST TRUE
#ASSERT `Art 75(1) the appeal in civil matters is admissible against the decision of this body` `Federal Criminal Court Complaints Chamber` EQUALS NOTHING
#ASSERT `Art 75(1) the appeal in civil matters is admissible against the decision of this body` `independent complaints authority for radio and television` EQUALS NOTHING
#ASSERT `Art 75(1) the appeal in civil matters is admissible against the decision of this body` `another body` EQUALS NOTHING

-- Art 75(2)(a), (b), (c)
#ASSERT `Art 75(2)(a) the exception applies, because a federal statute provides for a single cantonal instance` TRUE EQUALS JUST TRUE
#ASSERT `Art 75(2)(a) the exception applies, because a federal statute provides for a single cantonal instance` FALSE EQUALS NOTHING
#ASSERT `Art 75(2)(b) the exception applies, because a specialised commercial court decided as the single cantonal instance` TRUE EQUALS JUST TRUE
#ASSERT `Art 75(2)(b) the exception applies, because a specialised commercial court decided as the single cantonal instance` FALSE EQUALS NOTHING
#ASSERT `Art 75(2)(c) the exception applies, because an action of at least 100000 francs was filed directly with the upper court` TRUE 100000 EQUALS JUST TRUE          -- "mindestens 100 000": exactly 100 000 is enough
#ASSERT `Art 75(2)(c) the exception applies, because an action of at least 100000 francs was filed directly with the upper court` TRUE 99999 EQUALS NOTHING
#ASSERT `Art 75(2)(c) the exception applies, because an action of at least 100000 francs was filed directly with the upper court` FALSE 500000 EQUALS NOTHING         -- no consent / not filed directly

-- Art 75(2): args (upper court, decided as appeal instance, federal statute single instance, commercial court, filed directly with consent, value)
#ASSERT `Art 75(2) the last cantonal instance is an upper court deciding as an appeal instance, or an exception applies` TRUE TRUE FALSE FALSE FALSE 0 EQUALS JUST TRUE
#ASSERT `Art 75(2) the last cantonal instance is an upper court deciding as an appeal instance, or an exception applies` TRUE FALSE FALSE FALSE FALSE 0 EQUALS NOTHING     -- upper court but not as appeal instance, no exception
#ASSERT `Art 75(2) the last cantonal instance is an upper court deciding as an appeal instance, or an exception applies` FALSE TRUE FALSE FALSE FALSE 0 EQUALS NOTHING     -- appeal instance but not an upper court
#ASSERT `Art 75(2) the last cantonal instance is an upper court deciding as an appeal instance, or an exception applies` FALSE FALSE TRUE FALSE FALSE 0 EQUALS JUST TRUE
#ASSERT `Art 75(2) the last cantonal instance is an upper court deciding as an appeal instance, or an exception applies` FALSE FALSE FALSE TRUE FALSE 0 EQUALS JUST TRUE
#ASSERT `Art 75(2) the last cantonal instance is an upper court deciding as an appeal instance, or an exception applies` FALSE FALSE FALSE FALSE TRUE 100000 EQUALS JUST TRUE
#ASSERT `Art 75(2) the last cantonal instance is an upper court deciding as an appeal instance, or an exception applies` FALSE FALSE FALSE FALSE TRUE 99999 EQUALS NOTHING

-- Art 75(2) as a duty of the cantons, run as a trace.  The stable binary prints the outcome but cannot compare a DEONTIC in an #ASSERT (NOTES.md, finding on the binary).
#TRACE `Art 75(2) the cantons' duty to set up an upper court as last cantonal instance` AT 0 WITH
    PARTY Canton DOES `set up an upper court as last cantonal instance, deciding as an appeal instance` AT 5
#TRACE `Art 75(2) the cantons' duty to set up an upper court as last cantonal instance` AT 0 WITH

§ `Art 76 tests`

-- Art 76(1)(a): took part, or had no chance to take part
#ASSERT `Art 76(1)(a) the person took part before the lower instance or had no chance to` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Art 76(1)(a) the person took part before the lower instance or had no chance to` FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 76(1)(a) the person took part before the lower instance or had no chance to` FALSE FALSE EQUALS JUST FALSE
-- Art 76(1)(b): specially affected AND an interest worthy of protection
#ASSERT `Art 76(1)(b) the person is especially affected and has an interest worthy of protection` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 76(1)(b) the person is especially affected and has an interest worthy of protection` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 76(1)(b) the person is especially affected and has an interest worthy of protection` FALSE TRUE EQUALS JUST FALSE
-- Art 76(1): (a) AND (b); args (took part, no chance, affected, interest)
#ASSERT `Art 76(1) the person is entitled to appeal in civil matters` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 76(1) the person is entitled to appeal in civil matters` FALSE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 76(1) the person is entitled to appeal in civil matters` FALSE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Art 76(1) the person is entitled to appeal in civil matters` TRUE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Art 76(1) the person is entitled to appeal in civil matters` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
-- Art 76(2): args (decision under Art 72(2), chancellery or department, subordinate service with federal-law right, can violate federal legislation)
#ASSERT `Art 76(2) the federal authority is also entitled to appeal in civil matters` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 76(2) the federal authority is also entitled to appeal in civil matters` TRUE TRUE FALSE FALSE EQUALS JUST FALSE    -- "wenn der angefochtene Entscheid die Bundesgesetzgebung ... verletzen kann" fails
#ASSERT `Art 76(2) the federal authority is also entitled to appeal in civil matters` TRUE FALSE TRUE TRUE EQUALS JUST TRUE     -- a subordinate service, where federal law provides it
#ASSERT `Art 76(2) the federal authority is also entitled to appeal in civil matters` TRUE FALSE FALSE TRUE EQUALS NOTHING     -- a subordinate service without a federal-law right: "soweit das Bundesrecht es vorsieht"
#ASSERT `Art 76(2) the federal authority is also entitled to appeal in civil matters` FALSE TRUE FALSE TRUE EQUALS NOTHING     -- not a decision under Art 72(2)

§ `Art 77 tests`

-- Art 77(1)(a): args (arbitral tribunal decision, international, Arts 190-192 IPRG conditions met)
#ASSERT `Art 77(1)(a) the appeal in civil matters is admissible against the international arbitral award whatever the value in dispute` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 77(1)(a) the appeal in civil matters is admissible against the international arbitral award whatever the value in dispute` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `Art 77(1)(a) the appeal in civil matters is admissible against the international arbitral award whatever the value in dispute` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `Art 77(1)(a) the appeal in civil matters is admissible against the international arbitral award whatever the value in dispute` TRUE TRUE FALSE EQUALS NOTHING     -- the conditions of the other Act are not met: not covered
-- Art 77(1)(b): args (arbitral tribunal decision, national, Arts 389-395 ZPO conditions met)
#ASSERT `Art 77(1)(b) the appeal in civil matters is admissible against the national arbitral award whatever the value in dispute` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 77(1)(b) the appeal in civil matters is admissible against the national arbitral award whatever the value in dispute` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `Art 77(1)(b) the appeal in civil matters is admissible against the national arbitral award whatever the value in dispute` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `Art 77(1)(b) the appeal in civil matters is admissible against the national arbitral award whatever the value in dispute` TRUE TRUE FALSE EQUALS NOTHING
-- Art 77(1): args (arbitral, international, national, IPRG conditions, ZPO conditions)
#ASSERT `Art 77(1) the appeal in civil matters is admissible against the arbitral award whatever the value in dispute` TRUE TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Art 77(1) the appeal in civil matters is admissible against the arbitral award whatever the value in dispute` TRUE FALSE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 77(1) the appeal in civil matters is admissible against the arbitral award whatever the value in dispute` TRUE TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `Art 77(1) the appeal in civil matters is admissible against the arbitral award whatever the value in dispute` FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING
-- Art 77(2): args (appeal under Art 77(1), article, paragraph, used to let the Court decide itself); the listed provisions are "nicht anwendbar"
#ASSERT `Art 77(2) the listed provision is applicable to the appeal against the arbitral award` TRUE 48 3 FALSE EQUALS JUST FALSE
#ASSERT `Art 77(2) the listed provision is applicable to the appeal against the arbitral award` TRUE 48 1 FALSE EQUALS NOTHING      -- another paragraph of Art 48: not named
#ASSERT `Art 77(2) the listed provision is applicable to the appeal against the arbitral award` TRUE 89 1 FALSE EQUALS NOTHING      -- just below the range 90-98
#ASSERT `Art 77(2) the listed provision is applicable to the appeal against the arbitral award` TRUE 90 1 FALSE EQUALS JUST FALSE   -- first of 90-98
#ASSERT `Art 77(2) the listed provision is applicable to the appeal against the arbitral award` TRUE 95 0 FALSE EQUALS JUST FALSE   -- the whole of Art 95
#ASSERT `Art 77(2) the listed provision is applicable to the appeal against the arbitral award` TRUE 98 2 FALSE EQUALS JUST FALSE   -- last of 90-98
#ASSERT `Art 77(2) the listed provision is applicable to the appeal against the arbitral award` TRUE 99 1 FALSE EQUALS NOTHING      -- just above the range
#ASSERT `Art 77(2) the listed provision is applicable to the appeal against the arbitral award` TRUE 103 2 FALSE EQUALS JUST FALSE
#ASSERT `Art 77(2) the listed provision is applicable to the appeal against the arbitral award` TRUE 103 1 FALSE EQUALS NOTHING
#ASSERT `Art 77(2) the listed provision is applicable to the appeal against the arbitral award` TRUE 105 2 FALSE EQUALS JUST FALSE
#ASSERT `Art 77(2) the listed provision is applicable to the appeal against the arbitral award` TRUE 105 1 FALSE EQUALS NOTHING
#ASSERT `Art 77(2) the listed provision is applicable to the appeal against the arbitral award` TRUE 106 1 FALSE EQUALS JUST FALSE
#ASSERT `Art 77(2) the listed provision is applicable to the appeal against the arbitral award` TRUE 106 2 FALSE EQUALS NOTHING
#ASSERT `Art 77(2) the listed provision is applicable to the appeal against the arbitral award` TRUE 107 2 TRUE EQUALS JUST FALSE     -- as far as it lets the Court decide itself
#ASSERT `Art 77(2) the listed provision is applicable to the appeal against the arbitral award` TRUE 107 2 FALSE EQUALS NOTHING     -- outside that limit: not covered
#ASSERT `Art 77(2) the listed provision is applicable to the appeal against the arbitral award` TRUE 107 1 TRUE EQUALS NOTHING
#ASSERT `Art 77(2) the listed provision is applicable to the appeal against the arbitral award` FALSE 48 3 FALSE EQUALS NOTHING     -- not an Art 77(1) case: "in diesen Fällen" does not reach it
-- Art 77(2bis): "Rechtsschriften können in englischer Sprache abgefasst werden."
#ASSERT `Art 77(2bis) the written submission may be drafted in English` TRUE EQUALS JUST TRUE
#ASSERT `Art 77(2bis) the written submission may be drafted in English` FALSE EQUALS NOTHING
-- Art 77(3): args (appeal under Art 77(1), complaint raised, complaint reasoned)
#ASSERT `Art 77(3) the complaint meets the condition for being examined` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 77(3) the complaint meets the condition for being examined` TRUE TRUE FALSE EQUALS JUST FALSE     -- raised, not reasoned
#ASSERT `Art 77(3) the complaint meets the condition for being examined` TRUE FALSE TRUE EQUALS JUST FALSE     -- reasoned, not raised
#ASSERT `Art 77(3) the complaint meets the condition for being examined` FALSE TRUE TRUE EQUALS NOTHING        -- not an Art 77(1) appeal
