IMPORT prelude
IMPORT `bgg3-nouns`
IMPORT `bgg3-criminal`

-- bgg3-tests-criminal: tests for bgg3-criminal (BGG Art. 78 to 81).
-- Expected values were decided from the German text and written beside each assertion before running.

§ `Constants for the tests`

`the accused` MEANS `accused person`
`the representative` MEANS `legal representative of the accused person`
`the prosecutor` MEANS `public prosecutor's office`
`the private claimant` MEANS `private claimant`
`the complainant` MEANS `person who files the criminal complaint`
`the federal prosecutor` MEANS `federal public prosecutor's office or the administration involved in an administrative criminal matter`
`someone else` MEANS `another person`

§ `Art 78 tests`

-- Art 78(1): "Das Bundesgericht beurteilt Beschwerden gegen Entscheide in Strafsachen."
#ASSERT `Art 78(1) the appeal in criminal matters lies against the decision` TRUE EQUALS JUST TRUE
#ASSERT `Art 78(1) the appeal in criminal matters lies against the decision` FALSE EQUALS NOTHING
-- Art 78(2)(a): args (decision on civil claims, to be dealt with together with the criminal matter)
#ASSERT `Art 78(2)(a) the appeal in criminal matters also lies against the decision on civil claims` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 78(2)(a) the appeal in criminal matters also lies against the decision on civil claims` TRUE FALSE EQUALS JUST FALSE     -- "wenn diese zusammen mit der Strafsache zu behandeln sind" fails
#ASSERT `Art 78(2)(a) the appeal in criminal matters also lies against the decision on civil claims` FALSE TRUE EQUALS NOTHING        -- not a decision on civil claims
#ASSERT `Art 78(2)(a) the appeal in criminal matters also lies against the decision on civil claims` FALSE FALSE EQUALS NOTHING
-- Art 78(2)(b)
#ASSERT `Art 78(2)(b) the appeal in criminal matters also lies against the decision on the execution of penalties and measures` TRUE EQUALS JUST TRUE
#ASSERT `Art 78(2)(b) the appeal in criminal matters also lies against the decision on the execution of penalties and measures` FALSE EQUALS NOTHING
-- Art 78(2): args (civil claims, together, execution)
#ASSERT `Art 78(2) the appeal in criminal matters also lies against the decision` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Art 78(2) the appeal in criminal matters also lies against the decision` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 78(2) the appeal in criminal matters also lies against the decision` TRUE FALSE FALSE EQUALS JUST FALSE     -- civil claims not to be dealt with together, no other item
#ASSERT `Art 78(2) the appeal in criminal matters also lies against the decision` TRUE FALSE TRUE EQUALS JUST TRUE       -- the execution item holds
#ASSERT `Art 78(2) the appeal in criminal matters also lies against the decision` FALSE FALSE FALSE EQUALS NOTHING
-- Art 78 as a whole: args (criminal matter, civil claims, together, execution)
#ASSERT `Art 78 the appeal in criminal matters lies against the decision` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Art 78 the appeal in criminal matters lies against the decision` FALSE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Art 78 the appeal in criminal matters lies against the decision` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 78 the appeal in criminal matters lies against the decision` FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Art 78 the appeal in criminal matters lies against the decision` FALSE FALSE FALSE FALSE EQUALS NOTHING

§ `Art 79 tests`

-- Art 79: "unzulässig gegen Entscheide der Beschwerdekammer des Bundesstrafgerichts, soweit es sich nicht um Entscheide über Zwangsmassnahmen handelt."  Args (body, coercive measures)
#ASSERT `Art 79 the appeal in criminal matters is admissible against the decision of this body` `Federal Criminal Court Complaints Chamber` FALSE EQUALS JUST FALSE
#ASSERT `Art 79 the appeal in criminal matters is admissible against the decision of this body` `Federal Criminal Court Complaints Chamber` TRUE EQUALS NOTHING     -- coercive measures: the bar does not reach them
#ASSERT `Art 79 the appeal in criminal matters is admissible against the decision of this body` `Federal Criminal Court Appeals Chamber` FALSE EQUALS NOTHING       -- another chamber
#ASSERT `Art 79 the appeal in criminal matters is admissible against the decision of this body` `last cantonal instance` FALSE EQUALS NOTHING
#ASSERT `Art 79 the appeal in criminal matters is admissible against the decision of this body` `another chamber of the Federal Criminal Court` FALSE EQUALS NOTHING

§ `Art 80 tests`

-- Art 80(1)
#ASSERT `Art 80(1) the appeal in criminal matters is admissible against the decision of this body` `last cantonal instance` EQUALS JUST TRUE
#ASSERT `Art 80(1) the appeal in criminal matters is admissible against the decision of this body` `Federal Criminal Court Complaints Chamber` EQUALS JUST TRUE
#ASSERT `Art 80(1) the appeal in criminal matters is admissible against the decision of this body` `Federal Criminal Court Appeals Chamber` EQUALS JUST TRUE
#ASSERT `Art 80(1) the appeal in criminal matters is admissible against the decision of this body` `another chamber of the Federal Criminal Court` EQUALS NOTHING
#ASSERT `Art 80(1) the appeal in criminal matters is admissible against the decision of this body` `Federal Administrative Court` EQUALS NOTHING
#ASSERT `Art 80(1) the appeal in criminal matters is admissible against the decision of this body` `another body` EQUALS NOTHING
-- Art 80(2): args (upper court, decided as appeal instance, StPO single-instance exception)
#ASSERT `Art 80(2) the last cantonal instance is an upper court deciding as an appeal instance, or the exception applies` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Art 80(2) the last cantonal instance is an upper court deciding as an appeal instance, or the exception applies` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 80(2) the last cantonal instance is an upper court deciding as an appeal instance, or the exception applies` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `Art 80(2) the last cantonal instance is an upper court deciding as an appeal instance, or the exception applies` FALSE TRUE FALSE EQUALS NOTHING
-- Art 80(2) as a duty of the cantons, run as a trace (printed, not asserted: NOTES.md)
#TRACE `Art 80(2) the cantons' duty to set up an upper court as last cantonal instance` AT 0 WITH
    PARTY Canton DOES `set up an upper court as last cantonal instance, deciding as an appeal instance` AT 2
#TRACE `Art 80(2) the cantons' duty to set up an upper court as last cantonal instance` AT 0 WITH

§ `Art 81 tests`

-- Art 81(1)(a)
#ASSERT `Art 81(1)(a) the person took part before the lower instance or had no chance to` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Art 81(1)(a) the person took part before the lower instance or had no chance to` FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 81(1)(a) the person took part before the lower instance or had no chance to` FALSE FALSE EQUALS JUST FALSE
-- Art 81(1)(b) items
#ASSERT `Art 81(1)(b)(1) the accused person has a legally protected interest in quashing or changing the decision` `the accused` EQUALS JUST TRUE
#ASSERT `Art 81(1)(b)(1) the accused person has a legally protected interest in quashing or changing the decision` `the prosecutor` EQUALS NOTHING
#ASSERT `Art 81(1)(b)(2) the legal representative of the accused person has a legally protected interest in quashing or changing the decision` `the representative` EQUALS JUST TRUE
#ASSERT `Art 81(1)(b)(2) the legal representative of the accused person has a legally protected interest in quashing or changing the decision` `the accused` EQUALS NOTHING
-- item 3: args (person, decision on investigative or security detention)
#ASSERT `Art 81(1)(b)(3) the public prosecutor's office has a legally protected interest in quashing or changing the decision` `the prosecutor` FALSE EQUALS JUST TRUE
#ASSERT `Art 81(1)(b)(3) the public prosecutor's office has a legally protected interest in quashing or changing the decision` `the prosecutor` TRUE EQUALS NOTHING      -- "ausser bei Entscheiden über ... Untersuchungs- und Sicherheitshaft"
#ASSERT `Art 81(1)(b)(3) the public prosecutor's office has a legally protected interest in quashing or changing the decision` `the accused` FALSE EQUALS NOTHING
-- item 5: args (person, decision can affect the civil claims)
#ASSERT `Art 81(1)(b)(5) the private claimant has a legally protected interest in quashing or changing the decision` `the private claimant` TRUE EQUALS JUST TRUE
#ASSERT `Art 81(1)(b)(5) the private claimant has a legally protected interest in quashing or changing the decision` `the private claimant` FALSE EQUALS NOTHING
#ASSERT `Art 81(1)(b)(5) the private claimant has a legally protected interest in quashing or changing the decision` `the accused` TRUE EQUALS NOTHING
-- item 6: args (person, the appeal concerns the right to file a criminal complaint as such)
#ASSERT `Art 81(1)(b)(6) the person who files the criminal complaint has a legally protected interest in quashing or changing the decision` `the complainant` TRUE EQUALS JUST TRUE
#ASSERT `Art 81(1)(b)(6) the person who files the criminal complaint has a legally protected interest in quashing or changing the decision` `the complainant` FALSE EQUALS NOTHING     -- "soweit es um das Strafantragsrecht als solches geht"
#ASSERT `Art 81(1)(b)(6) the person who files the criminal complaint has a legally protected interest in quashing or changing the decision` `the accused` TRUE EQUALS NOTHING
-- item 7
#ASSERT `Art 81(1)(b)(7) the federal public prosecutor's office or the administration involved has a legally protected interest in quashing or changing the decision` `the federal prosecutor` EQUALS JUST TRUE
#ASSERT `Art 81(1)(b)(7) the federal public prosecutor's office or the administration involved has a legally protected interest in quashing or changing the decision` `the prosecutor` EQUALS NOTHING
-- Art 81(1)(b): args (person, detention decision, civil claims effect, complaint right, general interest)
#ASSERT `Art 81(1)(b) the person has a legally protected interest in quashing or changing the decision` `the accused` FALSE FALSE FALSE FALSE EQUALS JUST TRUE         -- listed: the accused
#ASSERT `Art 81(1)(b) the person has a legally protected interest in quashing or changing the decision` `the prosecutor` FALSE FALSE FALSE FALSE EQUALS JUST TRUE       -- listed: the prosecutor, no detention decision
#ASSERT `Art 81(1)(b) the person has a legally protected interest in quashing or changing the decision` `the prosecutor` TRUE FALSE FALSE FALSE EQUALS JUST FALSE      -- prosecutor, detention decision, no interest otherwise
#ASSERT `Art 81(1)(b) the person has a legally protected interest in quashing or changing the decision` `the prosecutor` TRUE FALSE FALSE TRUE EQUALS JUST TRUE        -- prosecutor, detention decision, but an interest is stated
#ASSERT `Art 81(1)(b) the person has a legally protected interest in quashing or changing the decision` `the private claimant` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Art 81(1)(b) the person has a legally protected interest in quashing or changing the decision` `the private claimant` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Art 81(1)(b) the person has a legally protected interest in quashing or changing the decision` `the complainant` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Art 81(1)(b) the person has a legally protected interest in quashing or changing the decision` `the representative` FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Art 81(1)(b) the person has a legally protected interest in quashing or changing the decision` `the federal prosecutor` FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Art 81(1)(b) the person has a legally protected interest in quashing or changing the decision` `someone else` FALSE FALSE FALSE TRUE EQUALS JUST TRUE         -- not listed, but states the interest
#ASSERT `Art 81(1)(b) the person has a legally protected interest in quashing or changing the decision` `someone else` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- Art 81(1): args (took part, no chance, person, detention, civil claims effect, complaint right, general interest)
#ASSERT `Art 81(1) the person is entitled to appeal in criminal matters` TRUE FALSE `the accused` FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Art 81(1) the person is entitled to appeal in criminal matters` FALSE TRUE `the accused` FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Art 81(1) the person is entitled to appeal in criminal matters` FALSE FALSE `the accused` FALSE FALSE FALSE FALSE EQUALS JUST FALSE    -- (a) fails
#ASSERT `Art 81(1) the person is entitled to appeal in criminal matters` TRUE FALSE `someone else` FALSE FALSE FALSE FALSE EQUALS JUST FALSE      -- (b) fails
-- Art 81(2): args (federal authority, federal law provides communication of the decision)
#ASSERT `Art 81(2) the federal authority is entitled to appeal in criminal matters` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 81(2) the federal authority is entitled to appeal in criminal matters` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 81(2) the federal authority is entitled to appeal in criminal matters` FALSE TRUE EQUALS NOTHING
-- Art 81(3): args (decision under Art 78(2)(b), chancellery or department, subordinate service with federal-law right, can violate federal legislation)
#ASSERT `Art 81(3) the federal chancellery or department is also entitled to appeal in criminal matters` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 81(3) the federal chancellery or department is also entitled to appeal in criminal matters` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Art 81(3) the federal chancellery or department is also entitled to appeal in criminal matters` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 81(3) the federal chancellery or department is also entitled to appeal in criminal matters` TRUE FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `Art 81(3) the federal chancellery or department is also entitled to appeal in criminal matters` FALSE TRUE FALSE TRUE EQUALS NOTHING
