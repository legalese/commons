#ASSERT `Art 83(c)(5) the appeal is admissible against the foreigners law decision on a deviation from the admission requirements` TRUE FALSE EQUALS NOTHING
#ASSERT `Art 83(c)(6) the appeal is admissible against the foreigners law decision on commuters and travel papers` TRUE TRUE EQUALS JUST FALSE
#ASSERT `Art 83(c)(6) the appeal is admissible against the foreigners law decision on commuters and travel papers` TRUE FALSE EQUALS NOTHING
