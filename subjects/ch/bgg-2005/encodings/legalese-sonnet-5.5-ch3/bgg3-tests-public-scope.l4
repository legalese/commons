#ASSERT `Art 83(b) the appeal is admissible against the decision on ordinary naturalisation` TRUE EQUALS JUST FALSE
#ASSERT `Art 83(b) the appeal is admissible against the decision on ordinary naturalisation` FALSE EQUALS NOTHING
