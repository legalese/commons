#ASSERT `Art 83(a) the appeal is admissible against the decision on security and foreign affairs` TRUE TRUE EQUALS NOTHING
#ASSERT `Art 83(a) the appeal is admissible against the decision on security and foreign affairs` FALSE FALSE EQUALS NOTHING
