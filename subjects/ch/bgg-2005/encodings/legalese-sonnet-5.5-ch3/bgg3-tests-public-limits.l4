IMPORT prelude
IMPORT `bgg3-nouns`
IMPORT `bgg3-public-limits`

-- bgg3-tests-public-limits: tests for bgg3-public-limits (BGG Art. 84, 84a and 85).
-- Expected values were decided from the German text and written beside each assertion before running.

§ `Art 84 tests`

-- Art 84(2): args (elementary procedural principles violated, serious defects abroad): "insbesondere" two cases
#ASSERT `Art 84(2) the case is a particularly important case` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Art 84(2) the case is a particularly important case` FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 84(2) the case is a particularly important case` FALSE FALSE EQUALS NOTHING

-- Art 84(1): args (legal assistance field, subject, elementary principles violated, serious defects abroad, particularly important for other reasons)
#ASSERT `Art 84(1) the condition for an appeal on international legal assistance in criminal matters is met` TRUE `extradition` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 84(1) the condition for an appeal on international legal assistance in criminal matters is met` TRUE `seizure` TRUE FALSE FALSE EQUALS JUST TRUE                     -- important by Art 84(2)
#ASSERT `Art 84(1) the condition for an appeal on international legal assistance in criminal matters is met` TRUE `handing over of objects or assets` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Art 84(1) the condition for an appeal on international legal assistance in criminal matters is met` TRUE `transmission of information from the secret sphere` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 84(1) the condition for an appeal on international legal assistance in criminal matters is met` TRUE `extradition` FALSE FALSE FALSE EQUALS JUST FALSE                -- a named subject, but not a particularly important case
#ASSERT `Art 84(1) the condition for an appeal on international legal assistance in criminal matters is met` TRUE `another subject` TRUE TRUE TRUE EQUALS JUST FALSE                  -- important, but not one of the four subjects
#ASSERT `Art 84(1) the condition for an appeal on international legal assistance in criminal matters is met` FALSE `extradition` TRUE TRUE TRUE EQUALS NOTHING                     -- not a legal assistance decision

§ `Art 84a tests`

-- args (tax assistance field, legal question, elementary principles violated, serious defects abroad, particularly important for other reasons)
#ASSERT `Art 84a the condition for an appeal on international administrative assistance in tax matters is met` TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Art 84a the condition for an appeal on international administrative assistance in tax matters is met` TRUE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 84a the condition for an appeal on international administrative assistance in tax matters is met` TRUE FALSE TRUE FALSE FALSE EQUALS JUST TRUE         -- "im Sinne von Artikel 84 Absatz 2"
#ASSERT `Art 84a the condition for an appeal on international administrative assistance in tax matters is met` TRUE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Art 84a the condition for an appeal on international administrative assistance in tax matters is met` TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Art 84a the condition for an appeal on international administrative assistance in tax matters is met` FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING

§ `Art 85 tests (the thresholds: 30 000 and 15 000 francs)`

-- Art 85(1)(a): args (pecuniary, state liability, value): "weniger als 30 000": 29 999 is below, 30 000 is not
#ASSERT `Art 85(1)(a) the appeal is admissible in a state liability matter` TRUE TRUE 29999 EQUALS JUST FALSE
#ASSERT `Art 85(1)(a) the appeal is admissible in a state liability matter` TRUE TRUE 29999.5 EQUALS JUST FALSE
#ASSERT `Art 85(1)(a) the appeal is admissible in a state liability matter` TRUE TRUE 30000 EQUALS NOTHING
#ASSERT `Art 85(1)(a) the appeal is admissible in a state liability matter` FALSE TRUE 100 EQUALS NOTHING      -- not a pecuniary matter
#ASSERT `Art 85(1)(a) the appeal is admissible in a state liability matter` TRUE FALSE 100 EQUALS NOTHING      -- not state liability
-- Art 85(1)(b): "weniger als 15 000"
#ASSERT `Art 85(1)(b) the appeal is admissible in a public-law employment matter` TRUE TRUE 14999 EQUALS JUST FALSE
#ASSERT `Art 85(1)(b) the appeal is admissible in a public-law employment matter` TRUE TRUE 15000 EQUALS NOTHING
#ASSERT `Art 85(1)(b) the appeal is admissible in a public-law employment matter` FALSE TRUE 100 EQUALS NOTHING
#ASSERT `Art 85(1)(b) the appeal is admissible in a public-law employment matter` TRUE FALSE 100 EQUALS NOTHING
-- Art 85(1): args (pecuniary, state liability, public-law employment, value)
#ASSERT `Art 85(1) the appeal is admissible in a pecuniary matter` TRUE TRUE FALSE 29999 EQUALS JUST FALSE
#ASSERT `Art 85(1) the appeal is admissible in a pecuniary matter` TRUE TRUE FALSE 30000 EQUALS NOTHING
#ASSERT `Art 85(1) the appeal is admissible in a pecuniary matter` TRUE TRUE FALSE 15000 EQUALS JUST FALSE         -- state liability: 15 000 is below 30 000
#ASSERT `Art 85(1) the appeal is admissible in a pecuniary matter` TRUE FALSE TRUE 14999 EQUALS JUST FALSE
#ASSERT `Art 85(1) the appeal is admissible in a pecuniary matter` TRUE FALSE TRUE 15000 EQUALS NOTHING
#ASSERT `Art 85(1) the appeal is admissible in a pecuniary matter` TRUE FALSE TRUE 29999 EQUALS NOTHING           -- public-law employment: 29 999 is above 15 000
#ASSERT `Art 85(1) the appeal is admissible in a pecuniary matter` FALSE TRUE TRUE 1 EQUALS NOTHING
#ASSERT `Art 85(1) the appeal is admissible in a pecuniary matter` TRUE FALSE FALSE 1 EQUALS NOTHING
-- Art 85(2): args (pecuniary, state liability, public-law employment, value, legal question of fundamental importance)
#ASSERT `Art 85(2) the appeal is admissible although the value is short` TRUE TRUE FALSE 29999 TRUE EQUALS JUST TRUE
#ASSERT `Art 85(2) the appeal is admissible although the value is short` TRUE TRUE FALSE 29999 FALSE EQUALS JUST FALSE
#ASSERT `Art 85(2) the appeal is admissible although the value is short` TRUE TRUE FALSE 30000 TRUE EQUALS NOTHING         -- the value reaches the amount: not engaged
#ASSERT `Art 85(2) the appeal is admissible although the value is short` TRUE FALSE TRUE 14999 TRUE EQUALS JUST TRUE
#ASSERT `Art 85(2) the appeal is admissible although the value is short` TRUE FALSE TRUE 15000 FALSE EQUALS NOTHING
#ASSERT `Art 85(2) the appeal is admissible although the value is short` FALSE TRUE FALSE 1 TRUE EQUALS NOTHING          -- not a pecuniary matter
