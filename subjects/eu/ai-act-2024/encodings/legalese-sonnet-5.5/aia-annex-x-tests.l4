IMPORT prelude
IMPORT `aia-core`
IMPORT `aia-annex-x`

-- Tests of aia-annex-x.l4. Expected values are read off Annex X (consolidated lines 1889-1907), not off the code.
-- Annex X lists 12 acts under 7 points: 1 SIS (3 acts), 2 VIS (2), 3 Eurodac (1), 4 EES (1), 5 ETIAS (2), 6 ECRIS-TCN (1), 7 Interoperability (2).

§ `The table has the Annex's twelve rows`

#ASSERT count `Annex X the entries` EQUALS 12
#ASSERT count (filter (GIVEN e YIELD e's point EQUALS 1) `Annex X the entries`) EQUALS 3
#ASSERT count (filter (GIVEN e YIELD e's point EQUALS 2) `Annex X the entries`) EQUALS 2
#ASSERT count (filter (GIVEN e YIELD e's point EQUALS 3) `Annex X the entries`) EQUALS 1
#ASSERT count (filter (GIVEN e YIELD e's point EQUALS 4) `Annex X the entries`) EQUALS 1
#ASSERT count (filter (GIVEN e YIELD e's point EQUALS 5) `Annex X the entries`) EQUALS 2
#ASSERT count (filter (GIVEN e YIELD e's point EQUALS 6) `Annex X the entries`) EQUALS 1
#ASSERT count (filter (GIVEN e YIELD e's point EQUALS 7) `Annex X the entries`) EQUALS 2

§ `Each act of the Annex is listed (one assertion per act)`

#ASSERT `Annex X the act is listed` "Regulation (EU) 2018/1860"
#ASSERT `Annex X the act is listed` "Regulation (EU) 2018/1861"
#ASSERT `Annex X the act is listed` "Regulation (EU) 2018/1862"
#ASSERT `Annex X the act is listed` "Regulation (EU) 2021/1133"
#ASSERT `Annex X the act is listed` "Regulation (EU) 2021/1134"
#ASSERT `Annex X the act is listed` "Regulation (EU) 2024/1358"
#ASSERT `Annex X the act is listed` "Regulation (EU) 2017/2226"
#ASSERT `Annex X the act is listed` "Regulation (EU) 2018/1240"
#ASSERT `Annex X the act is listed` "Regulation (EU) 2018/1241"
#ASSERT `Annex X the act is listed` "Regulation (EU) 2019/816"
#ASSERT `Annex X the act is listed` "Regulation (EU) 2019/817"
#ASSERT `Annex X the act is listed` "Regulation (EU) 2019/818"

§ `An act that is not on the list`

-- FALSE-kind (the text hands the question to the list). The Regulation itself, and Regulation (EU) 2016/679 (GDPR), are not on it.
#ASSERT NOT (`Annex X the act is listed` "Regulation (EU) 2024/1689")
#ASSERT NOT (`Annex X the act is listed` "Regulation (EU) 2016/679")
#ASSERT NOT (`Annex X the act is listed` "")
-- Near misses: the designation must be the whole of it.
#ASSERT NOT (`Annex X the act is listed` "Regulation (EU) 2018/186")
#ASSERT NOT (`Annex X the act is listed` "Regulation (EU) 2019/81")

§ `The system an act establishes`

#ASSERT `Annex X the large-scale IT system the act establishes` "Regulation (EU) 2018/1861" EQUALS JUST "Schengen Information System"
#ASSERT `Annex X the large-scale IT system the act establishes` "Regulation (EU) 2021/1134" EQUALS JUST "Visa Information System"
#ASSERT `Annex X the large-scale IT system the act establishes` "Regulation (EU) 2024/1358" EQUALS JUST "Eurodac"
#ASSERT `Annex X the large-scale IT system the act establishes` "Regulation (EU) 2017/2226" EQUALS JUST "Entry/Exit System"
#ASSERT `Annex X the large-scale IT system the act establishes` "Regulation (EU) 2018/1241" EQUALS JUST "European Travel Information and Authorisation System"
#ASSERT `Annex X the large-scale IT system the act establishes` "Regulation (EU) 2019/816" EQUALS JUST "European Criminal Records Information System on third-country nationals and stateless persons"
#ASSERT `Annex X the large-scale IT system the act establishes` "Regulation (EU) 2019/818" EQUALS JUST "Interoperability"
-- NOTHING-kind (silent): an act that is not listed names no system.
#ASSERT `Annex X the large-scale IT system the act establishes` "Regulation (EU) 2016/679" EQUALS NOTHING

§ `The fact a seat states: a component of a large-scale IT system established by a listed act`

#ASSERT `Annex X the large-scale IT system is established by a listed legal act` TRUE "Regulation (EU) 2018/1862"
#ASSERT NOT (`Annex X the large-scale IT system is established by a listed legal act` TRUE "Regulation (EU) 2016/679")
#ASSERT NOT (`Annex X the large-scale IT system is established by a listed legal act` FALSE "Regulation (EU) 2018/1862")
#ASSERT NOT (`Annex X the large-scale IT system is established by a listed legal act` FALSE "Regulation (EU) 2016/679")
