#ASSERT `Annex III point 1(a) the AI system is listed` TRUE FALSE FALSE
#ASSERT `Annex III point 1(a) the AI system is listed` TRUE FALSE TRUE
#ASSERT `Annex III point 1(a) the AI system is listed` TRUE TRUE FALSE
#ASSERT NOT (`Annex III point 1(a) the AI system is listed` TRUE TRUE TRUE)

