IMPORT prelude
IMPORT daydate
IMPORT `aia-core`
IMPORT `aia-timeline`
IMPORT `aia-definitions`
IMPORT `P8-gate`
IMPORT `P8-art75b`

-- Tests of Article 75b (inserted by the Omnibus). The group General applies from 2 August 2026 (Art 113).

`Art 75b test on` MEANS Date 2 8 2026
`Art 75b test before` MEANS Date 1 8 2026

#ASSERT `Art 75b first sentence the AI Office may make the commitments binding on the operator and declare that there are no further grounds for action` `Art 75b test on` TRUE EQUALS JUST TRUE
#ASSERT `Art 75b first sentence the AI Office may make the commitments binding on the operator and declare that there are no further grounds for action` `Art 75b test on` FALSE EQUALS NOTHING
#ASSERT `Art 75b first sentence the AI Office may make the commitments binding on the operator and declare that there are no further grounds for action` `Art 75b test before` TRUE EQUALS NOTHING
-- EXPECT FULFILLED
#TRACE `Art 75b first sentence the AI Office's choice to make the commitments binding on the operator` `Art 75b test on` TRUE AT (Day (Date 3 8 2026)) WITH
    PARTY `Arts 72 to 79 party AI Office` DOES `Art 75b make the commitments binding on the operator by decision and declare that there are no further grounds for action` AT (Day (Date 4 8 2026))
-- EXPECT RESIDUAL
#TRACE `Art 75b first sentence the AI Office's choice to make the commitments binding on the operator` `Art 75b test on` TRUE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
-- EXPECT FULFILLED
#TRACE `Art 75b first sentence the AI Office's choice to make the commitments binding on the operator` `Art 75b test on` FALSE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
-- EXPECT FULFILLED
#TRACE `Art 75b first sentence the AI Office's choice to make the commitments binding on the operator` `Art 75b test on` TRUE AT (Day (Date 3 8 2026)) WITH
    PARTY `Arts 72 to 79 party AI Office` DOES `Art 75b make the commitments binding on the operator by decision and declare that there are no further grounds for action` AT (Day (Date 4 8 2026))
-- EXPECT RESIDUAL
#TRACE `Art 75b first sentence the AI Office's choice to make the commitments binding on the operator` `Art 75b test on` TRUE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
-- EXPECT FULFILLED
#TRACE `Art 75b first sentence the AI Office's choice to make the commitments binding on the operator` `Art 75b test before` TRUE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
#ASSERT `Art 75b second sentence the AI Office may reopen the proceedings` `Art 75b test on` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Art 75b second sentence the AI Office may reopen the proceedings` `Art 75b test on` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Art 75b second sentence the AI Office may reopen the proceedings` `Art 75b test on` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 75b second sentence the AI Office may reopen the proceedings` `Art 75b test on` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 75b second sentence the AI Office may reopen the proceedings` `Art 75b test on` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Art 75b second sentence the AI Office may reopen the proceedings` `Art 75b test on` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Art 75b second sentence the AI Office may reopen the proceedings` `Art 75b test before` TRUE FALSE FALSE EQUALS NOTHING
-- EXPECT FULFILLED
#TRACE `Art 75b second sentence the AI Office's choice to reopen the proceedings` `Art 75b test on` TRUE FALSE FALSE AT (Day (Date 3 8 2026)) WITH
    PARTY `Arts 72 to 79 party AI Office` DOES `Art 75b reopen the proceedings` AT (Day (Date 4 8 2026))
-- EXPECT RESIDUAL
#TRACE `Art 75b second sentence the AI Office's choice to reopen the proceedings` `Art 75b test on` TRUE FALSE FALSE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
-- EXPECT FULFILLED
#TRACE `Art 75b second sentence the AI Office's choice to reopen the proceedings` `Art 75b test on` FALSE FALSE FALSE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
-- EXPECT FULFILLED
#TRACE `Art 75b second sentence the AI Office's choice to reopen the proceedings` `Art 75b test on` FALSE TRUE FALSE AT (Day (Date 3 8 2026)) WITH
    PARTY `Arts 72 to 79 party AI Office` DOES `Art 75b reopen the proceedings` AT (Day (Date 4 8 2026))
-- EXPECT RESIDUAL
#TRACE `Art 75b second sentence the AI Office's choice to reopen the proceedings` `Art 75b test on` FALSE TRUE FALSE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
-- EXPECT FULFILLED
#TRACE `Art 75b second sentence the AI Office's choice to reopen the proceedings` `Art 75b test on` FALSE FALSE FALSE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
-- EXPECT FULFILLED
