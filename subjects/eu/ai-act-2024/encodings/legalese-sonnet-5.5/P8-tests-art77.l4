IMPORT prelude
IMPORT daydate
IMPORT `aia-core`
IMPORT `aia-timeline`
IMPORT `aia-definitions`
IMPORT `P8-gate`
IMPORT `P8-art77`

-- Tests of Article 77. The group General applies from 2 August 2026 (Art 113).

`Art 77 test on` MEANS Date 2 8 2026
`Art 77 test before` MEANS Date 1 8 2026

#ASSERT `Art 77(1) as enacted the national public authority or body has the power to request and access any documentation created or maintained under this Regulation` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 77(1) as enacted the national public authority or body has the power to request and access any documentation created or maintained under this Regulation` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 77(1) as enacted the national public authority or body has the power to request and access any documentation created or maintained under this Regulation` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `Art 77(1) as enacted the national public authority or body has the power to request and access any documentation created or maintained under this Regulation` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `Art 77(1) as enacted the national public authority or body has the power to request and access any documentation created or maintained under this Regulation` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `Art 77(1) as enacted second sentence the authority or body must inform the market surveillance authority of the Member State concerned of the request` TRUE EQUALS JUST TRUE
#ASSERT `Art 77(1) as enacted second sentence the authority or body must inform the market surveillance authority of the Member State concerned of the request` FALSE EQUALS NOTHING
-- EXPECT FULFILLED
#TRACE `Art 77(1) as enacted the authority's duty to inform the market surveillance authority of the request` TRUE AT (Day (Date 3 8 2026)) WITH
    PARTY `Arts 72 to 79 party national public authority protecting fundamental rights` DOES `Art 77(1) as enacted inform the market surveillance authority of the Member State concerned of the request` AT (Day (Date 4 8 2026))
-- EXPECT RESIDUAL
#TRACE `Art 77(1) as enacted the authority's duty to inform the market surveillance authority of the request` TRUE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
-- EXPECT FULFILLED
#TRACE `Art 77(1) as enacted the authority's duty to inform the market surveillance authority of the request` FALSE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
