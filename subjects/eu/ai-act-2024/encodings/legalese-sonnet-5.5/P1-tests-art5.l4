IMPORT prelude
IMPORT daydate
IMPORT `aia-core`
IMPORT `aia-timeline`
IMPORT `P1-art5`

-- P1-tests-art5: tests for Article 5(1). Expected values come from the text (consolidated text lines 175 to 200, base text for what stands unchanged), one case per
-- element and per carve-out. Result words: JUST TRUE the point prohibits the practice; JUST FALSE the text's own carve-out; NOTHING not covered.
-- Dates: Chapter II applies from 2 February 2025; points (ba), (bb), paragraphs 1a and 1b from 2 December 2026; the Omnibus text is in force from 27 July 2026.


§ `Article 5(1)(a)`
#ASSERT `Art 5(1)(a) the AI practice is prohibited` (Date 3 2 2025) TRUE FALSE TRUE TRUE TRUE EQUALS JUST TRUE
-- subliminal techniques alone are enough (line 176: 'subliminal techniques ... or purposefully manipulative or deceptive techniques')
#ASSERT `Art 5(1)(a) the AI practice is prohibited` (Date 3 2 2025) TRUE FALSE TRUE TRUE TRUE EQUALS JUST TRUE
-- manipulative or deceptive techniques alone are enough
#ASSERT `Art 5(1)(a) the AI practice is prohibited` (Date 3 2 2025) FALSE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- neither technique: not covered (an element is missing)
#ASSERT `Art 5(1)(a) the AI practice is prohibited` (Date 3 2 2025) FALSE FALSE TRUE TRUE TRUE EQUALS NOTHING
-- no material distortion of behaviour: not covered
#ASSERT `Art 5(1)(a) the AI practice is prohibited` (Date 3 2 2025) TRUE FALSE FALSE TRUE TRUE EQUALS NOTHING
-- no decision that would not otherwise have been taken: not covered
#ASSERT `Art 5(1)(a) the AI practice is prohibited` (Date 3 2 2025) TRUE FALSE TRUE FALSE TRUE EQUALS NOTHING
-- no significant harm (caused or reasonably likely): not covered
#ASSERT `Art 5(1)(a) the AI practice is prohibited` (Date 3 2 2025) TRUE FALSE TRUE TRUE FALSE EQUALS NOTHING
-- the day before Article 5 applies (1 February 2025): not covered
#ASSERT `Art 5(1)(a) the AI practice is prohibited` (Date 1 2 2025) TRUE FALSE TRUE TRUE TRUE EQUALS NOTHING
-- the first day Article 5 applies (2 February 2025)
#ASSERT `Art 5(1)(a) the AI practice is prohibited` (Date 2 2 2025) TRUE FALSE TRUE TRUE TRUE EQUALS JUST TRUE
-- under the Omnibus text (27 July 2026): the point is unchanged
#ASSERT `Art 5(1)(a) the AI practice is prohibited` (Date 27 7 2026) TRUE FALSE TRUE TRUE TRUE EQUALS JUST TRUE
-- before the Regulation is in force (31 July 2024): not covered
#ASSERT `Art 5(1)(a) the AI practice is prohibited` (Date 31 7 2024) TRUE FALSE TRUE TRUE TRUE EQUALS NOTHING

