-- the putting into service for this specific purpose
#ASSERT `Art 5(1)(d) the AI practice is prohibited` (Date 3 2 2025) `Art 5(1) act putting into service` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- the putting into service NOT for this specific purpose: not covered
#ASSERT `Art 5(1)(d) the AI practice is prohibited` (Date 3 2 2025) `Art 5(1) act putting into service` FALSE TRUE TRUE FALSE FALSE EQUALS NOTHING
-- no risk assessment of the risk of committing a criminal offence: not covered
#ASSERT `Art 5(1)(d) the AI practice is prohibited` (Date 3 2 2025) `Art 5(1) act use` FALSE FALSE TRUE FALSE FALSE EQUALS NOTHING
