#ASSERT `Art 5(1)(b) the AI practice is prohibited` (Date 3 2 2025) TRUE TRUE TRUE EQUALS JUST TRUE
-- no exploitation of a vulnerability: not covered
#ASSERT `Art 5(1)(b) the AI practice is prohibited` (Date 3 2 2025) FALSE TRUE TRUE EQUALS NOTHING
