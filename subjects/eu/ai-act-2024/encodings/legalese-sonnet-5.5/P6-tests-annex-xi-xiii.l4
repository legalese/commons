-- (d) missing
#ASSERT `Annex XI Section 1 point 2 the detailed description of the elements and of the process contains the information` `Annex test a later day` `Annex test model` TRUE TRUE TRUE TRUE TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
-- (c) applicable and not included
#ASSERT `Annex XI Section 1 point 2 the detailed description of the elements and of the process contains the information` `Annex test a later day` `Annex test model` TRUE TRUE TRUE TRUE FALSE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
-- (c) not applicable, not included: not required
#ASSERT `Annex XI Section 1 point 2 the detailed description of the elements and of the process contains the information` `Annex test a later day` `Annex test model` TRUE TRUE TRUE FALSE FALSE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- (e): no figure, and the figure is not said to be unknown
#ASSERT `Annex XI Section 1 point 2 the detailed description of the elements and of the process contains the information` `Annex test a later day` `Annex test model` TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
