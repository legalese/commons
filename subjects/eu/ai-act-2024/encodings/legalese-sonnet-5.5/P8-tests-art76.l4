IMPORT prelude
IMPORT daydate
IMPORT `aia-core`
IMPORT `aia-timeline`
IMPORT `aia-definitions`
IMPORT `P8-gate`
IMPORT `P8-art76`

-- Tests of Article 76. The group General applies from 2 August 2026 (Art 113).

`Art 76 test on` MEANS Date 2 8 2026
`Art 76 test before` MEANS Date 1 8 2026

#ASSERT `Art 76(1) first paragraph the market surveillance authorities have competences and powers to ensure that testing in real world conditions is in accordance with this Regulation` `Art 76 test on` EQUALS JUST TRUE
#ASSERT `Art 76(1) first paragraph the market surveillance authorities have competences and powers to ensure that testing in real world conditions is in accordance with this Regulation` `Art 76 test before` EQUALS NOTHING
#ASSERT `Art 76(1) second paragraph any reference to a market surveillance authority is construed as a reference to the national competent authority or appropriate authority under the Union harmonisation legislation listed in Section B of Annex I` `Art 76 test on` TRUE EQUALS JUST TRUE
#ASSERT `Art 76(1) second paragraph any reference to a market surveillance authority is construed as a reference to the national competent authority or appropriate authority under the Union harmonisation legislation listed in Section B of Annex I` `Art 76 test on` FALSE EQUALS JUST FALSE
#ASSERT `Art 76(1) second paragraph any reference to a market surveillance authority is construed as a reference to the national competent authority or appropriate authority under the Union harmonisation legislation listed in Section B of Annex I` `Art 76 test before` TRUE EQUALS NOTHING
#ASSERT `Art 76(1) second paragraph references to Article 60 are construed as references to Article 60a` `Art 76 test on` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 76(1) second paragraph references to Article 60 are construed as references to Article 60a` `Art 76 test on` TRUE FALSE EQUALS NOTHING
#ASSERT `Art 76(1) second paragraph references to Article 60 are construed as references to Article 60a` `Art 76 test on` FALSE TRUE EQUALS JUST FALSE
#ASSERT `Art 76(1) second paragraph references to Article 60 are construed as references to Article 60a` `Art 76 test on` FALSE FALSE EQUALS JUST FALSE
#ASSERT `Art 76(1) second paragraph references to Article 60 are construed as references to Article 60a` `Art 76 test before` TRUE TRUE EQUALS NOTHING
#ASSERT `Art 76(2) first sentence the market surveillance authorities must verify the compliance with Article 60 as part of their supervisory role for the AI regulatory sandbox` `Art 76 test on` TRUE EQUALS JUST TRUE
#ASSERT `Art 76(2) first sentence the market surveillance authorities must verify the compliance with Article 60 as part of their supervisory role for the AI regulatory sandbox` `Art 76 test on` FALSE EQUALS JUST FALSE
#ASSERT `Art 76(2) first sentence the market surveillance authorities must verify the compliance with Article 60 as part of their supervisory role for the AI regulatory sandbox` `Art 76 test before` TRUE EQUALS NOTHING
-- EXPECT FULFILLED
#TRACE `Art 76(2) first sentence the market surveillance authority's duty to verify the compliance with Article 60` `Art 76 test on` TRUE AT (Day (Date 3 8 2026)) WITH
    PARTY `Arts 72 to 79 party market surveillance authority` DOES `Art 76(2) verify the compliance with Article 60 as part of the supervisory role for the AI regulatory sandbox` AT (Day (Date 4 8 2026))
-- EXPECT RESIDUAL
#TRACE `Art 76(2) first sentence the market surveillance authority's duty to verify the compliance with Article 60` `Art 76 test on` TRUE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
-- EXPECT FULFILLED
#TRACE `Art 76(2) first sentence the market surveillance authority's duty to verify the compliance with Article 60` `Art 76 test on` FALSE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
-- EXPECT FULFILLED
#TRACE `Art 76(2) first sentence the market surveillance authority's duty to verify the compliance with Article 60` `Art 76 test on` TRUE AT (Day (Date 3 8 2026)) WITH
    PARTY `Arts 72 to 79 party market surveillance authority` DOES `Art 76(2) verify the compliance with Article 60 as part of the supervisory role for the AI regulatory sandbox` AT (Day (Date 4 8 2026))
-- EXPECT RESIDUAL
#TRACE `Art 76(2) first sentence the market surveillance authority's duty to verify the compliance with Article 60` `Art 76 test on` TRUE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
-- EXPECT FULFILLED
#TRACE `Art 76(2) first sentence the market surveillance authority's duty to verify the compliance with Article 60` `Art 76 test before` TRUE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
#ASSERT `Art 76(2) second sentence the market surveillance authorities may allow the testing to be conducted by the provider or prospective provider in derogation from the conditions set out in Article 60(4), points (f) and (g)` `Art 76 test on` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 76(2) second sentence the market surveillance authorities may allow the testing to be conducted by the provider or prospective provider in derogation from the conditions set out in Article 60(4), points (f) and (g)` `Art 76 test on` TRUE FALSE EQUALS NOTHING
#ASSERT `Art 76(2) second sentence the market surveillance authorities may allow the testing to be conducted by the provider or prospective provider in derogation from the conditions set out in Article 60(4), points (f) and (g)` `Art 76 test on` FALSE TRUE EQUALS JUST FALSE
#ASSERT `Art 76(2) second sentence the market surveillance authorities may allow the testing to be conducted by the provider or prospective provider in derogation from the conditions set out in Article 60(4), points (f) and (g)` `Art 76 test on` FALSE FALSE EQUALS JUST FALSE
#ASSERT `Art 76(2) second sentence the market surveillance authorities may allow the testing to be conducted by the provider or prospective provider in derogation from the conditions set out in Article 60(4), points (f) and (g)` `Art 76 test before` TRUE TRUE EQUALS NOTHING
-- EXPECT FULFILLED
#TRACE `Art 76(2) second sentence the market surveillance authority's choice to allow the testing in derogation` `Art 76 test on` TRUE TRUE AT (Day (Date 3 8 2026)) WITH
    PARTY `Arts 72 to 79 party market surveillance authority` DOES `Art 76(2) allow the testing in real world conditions to be conducted by the provider or prospective provider in derogation from the conditions set out in Article 60(4), points (f) and (g)` AT (Day (Date 4 8 2026))
-- EXPECT RESIDUAL
#TRACE `Art 76(2) second sentence the market surveillance authority's choice to allow the testing in derogation` `Art 76 test on` TRUE TRUE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
-- EXPECT FULFILLED
#TRACE `Art 76(2) second sentence the market surveillance authority's choice to allow the testing in derogation` `Art 76 test on` TRUE FALSE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
-- EXPECT FULFILLED
#TRACE `Art 76(2) second sentence the market surveillance authority's choice to allow the testing in derogation` `Art 76 test on` TRUE TRUE AT (Day (Date 3 8 2026)) WITH
    PARTY `Arts 72 to 79 party market surveillance authority` DOES `Art 76(2) allow the testing in real world conditions to be conducted by the provider or prospective provider in derogation from the conditions set out in Article 60(4), points (f) and (g)` AT (Day (Date 4 8 2026))
-- EXPECT RESIDUAL
#TRACE `Art 76(2) second sentence the market surveillance authority's choice to allow the testing in derogation` `Art 76 test on` TRUE TRUE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
-- EXPECT FULFILLED
#TRACE `Art 76(2) second sentence the market surveillance authority's choice to allow the testing in derogation` `Art 76 test before` TRUE TRUE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
-- EXPECT FULFILLED
#TRACE `Art 76(2) second sentence the market surveillance authority's choice to allow the testing in derogation` `Art 76 test on` TRUE TRUE AT (Day (Date 3 8 2026)) WITH
    PARTY `Arts 72 to 79 party market surveillance authority` DOES `Art 76(2) allow the testing in real world conditions to be conducted by the provider or prospective provider in derogation from the conditions set out in Article 60(4), points (f) and (g)` AT (Day (Date 4 8 2026))
-- EXPECT RESIDUAL
#TRACE `Art 76(2) second sentence the market surveillance authority's choice to allow the testing in derogation` `Art 76 test on` TRUE TRUE AT (Day (Date 3 8 2026)) WITH
