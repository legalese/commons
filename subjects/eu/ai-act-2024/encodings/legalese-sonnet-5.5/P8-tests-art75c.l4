IMPORT prelude
IMPORT daydate
IMPORT `aia-core`
IMPORT `aia-timeline`
IMPORT `aia-definitions`
IMPORT `P8-gate`
IMPORT `P8-art75c`

-- Tests of Article 75c (inserted by the Omnibus). The group General applies from 2 August 2026 (Art 113).

`Art 75c test on` MEANS Date 2 8 2026
`Art 75c test before` MEANS Date 1 8 2026

#ASSERT `Art 75c(1) the AI Office must adopt a decision establishing the non-compliance` `Art 75c test on` TRUE EQUALS JUST TRUE
#ASSERT `Art 75c(1) the AI Office must adopt a decision establishing the non-compliance` `Art 75c test on` FALSE EQUALS JUST FALSE
#ASSERT `Art 75c(1) the AI Office must adopt a decision establishing the non-compliance` `Art 75c test before` TRUE EQUALS NOTHING
-- EXPECT FULFILLED
#TRACE `Art 75c(1) the AI Office's duty to adopt a decision establishing the non-compliance` `Art 75c test on` TRUE AT (Day (Date 3 8 2026)) WITH
    PARTY `Arts 72 to 79 party AI Office` DOES `Art 75c(1) adopt a decision establishing the non-compliance` AT (Day (Date 4 8 2026))
-- EXPECT RESIDUAL
#TRACE `Art 75c(1) the AI Office's duty to adopt a decision establishing the non-compliance` `Art 75c test on` TRUE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
-- EXPECT FULFILLED
#TRACE `Art 75c(1) the AI Office's duty to adopt a decision establishing the non-compliance` `Art 75c test on` FALSE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
-- EXPECT FULFILLED
#TRACE `Art 75c(1) the AI Office's duty to adopt a decision establishing the non-compliance` `Art 75c test on` TRUE AT (Day (Date 3 8 2026)) WITH
    PARTY `Arts 72 to 79 party AI Office` DOES `Art 75c(1) adopt a decision establishing the non-compliance` AT (Day (Date 4 8 2026))
-- EXPECT RESIDUAL
#TRACE `Art 75c(1) the AI Office's duty to adopt a decision establishing the non-compliance` `Art 75c test on` TRUE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
-- EXPECT FULFILLED
#TRACE `Art 75c(1) the AI Office's duty to adopt a decision establishing the non-compliance` `Art 75c test before` TRUE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
