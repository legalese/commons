IMPORT prelude
IMPORT daydate
IMPORT `aia-core`
IMPORT `aia-timeline`
IMPORT `aia-scope`

-- Tests of aia-scope.l4 (Articles 1 and 2). Every expected value is written by hand from the text of the paragraph.
-- Dates: 1 February 2025 is the day before Chapter I applies (Art 113(a): 2 February 2025), so every paragraph answers NOTHING there;
-- 2 February 2025 is the first day it applies. 26 July 2026 is under the text as enacted; 27 July 2026 is under the text as amended.
-- A paragraph that says no answers JUST FALSE; the combinator puts a JUST FALSE before a JUST TRUE.
-- The tests below were laid out as tables: D = the date asked, then the facts in the order of the GIVEN lines.


§ `The gate: Chapter I applies from 2 February 2025`

#ASSERT NOT (`Art 2 Chapter I has begun to apply on the date asked` (Date 1 2 2025))
#ASSERT `Art 2 Chapter I has begun to apply on the date asked` (Date 2 2 2025)
#ASSERT `Art 2 Chapter I has begun to apply on the date asked` (Date 27 7 2026)

§ `Article 2(1)(a): providers (a list that does not close: a case outside it is NOTHING, not FALSE)`

#ASSERT `Art 2(1)(a) the Regulation applies to the provider` (Date 1 2 2025) TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `Art 2(1)(a) the Regulation applies to the provider` (Date 2 2 2025) TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Art 2(1)(a) the Regulation applies to the provider` (Date 2 2 2025) TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 2(1)(a) the Regulation applies to the provider` (Date 2 2 2025) TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `Art 2(1)(a) the Regulation applies to the provider` (Date 2 2 2025) FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `Art 2(1)(a) the Regulation applies to the provider` (Date 27 7 2026) TRUE TRUE FALSE EQUALS JUST TRUE

§ `Article 2(1)(b): deployers in the Union`

#ASSERT `Art 2(1)(b) the Regulation applies to the deployer in the Union` (Date 1 2 2025) TRUE `Established or located in the Union` EQUALS NOTHING
#ASSERT `Art 2(1)(b) the Regulation applies to the deployer in the Union` (Date 2 2 2025) TRUE `Established or located in the Union` EQUALS JUST TRUE
#ASSERT `Art 2(1)(b) the Regulation applies to the deployer in the Union` (Date 2 2 2025) TRUE `Established or located in a third country` EQUALS NOTHING
#ASSERT `Art 2(1)(b) the Regulation applies to the deployer in the Union` (Date 2 2 2025) FALSE `Established or located in the Union` EQUALS NOTHING

§ `Article 2(1)(c): providers and deployers in a third country whose output is used in the Union`

#ASSERT `Art 2(1)(c) the Regulation applies to the provider or deployer in a third country whose output is used in the Union` (Date 1 2 2025) TRUE `Established or located in a third country` TRUE EQUALS NOTHING
#ASSERT `Art 2(1)(c) the Regulation applies to the provider or deployer in a third country whose output is used in the Union` (Date 2 2 2025) TRUE `Established or located in a third country` TRUE EQUALS JUST TRUE
#ASSERT `Art 2(1)(c) the Regulation applies to the provider or deployer in a third country whose output is used in the Union` (Date 2 2 2025) TRUE `Established or located in a third country` FALSE EQUALS NOTHING
#ASSERT `Art 2(1)(c) the Regulation applies to the provider or deployer in a third country whose output is used in the Union` (Date 2 2 2025) TRUE `Established or located in the Union` TRUE EQUALS NOTHING
#ASSERT `Art 2(1)(c) the Regulation applies to the provider or deployer in a third country whose output is used in the Union` (Date 2 2 2025) FALSE `Established or located in a third country` TRUE EQUALS NOTHING

§ `Article 2(1)(d): importers and distributors`

#ASSERT `Art 2(1)(d) the Regulation applies to the importer or distributor` (Date 1 2 2025) TRUE FALSE EQUALS NOTHING
#ASSERT `Art 2(1)(d) the Regulation applies to the importer or distributor` (Date 2 2 2025) TRUE FALSE EQUALS JUST TRUE
#ASSERT `Art 2(1)(d) the Regulation applies to the importer or distributor` (Date 2 2 2025) FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 2(1)(d) the Regulation applies to the importer or distributor` (Date 2 2 2025) FALSE FALSE EQUALS NOTHING

§ `Article 2(1)(e): product manufacturers placing an AI system on the market with their product under their own name`

#ASSERT `Art 2(1)(e) the Regulation applies to the product manufacturer` (Date 1 2 2025) TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `Art 2(1)(e) the Regulation applies to the product manufacturer` (Date 2 2 2025) TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 2(1)(e) the Regulation applies to the product manufacturer` (Date 2 2 2025) FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `Art 2(1)(e) the Regulation applies to the product manufacturer` (Date 2 2 2025) TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `Art 2(1)(e) the Regulation applies to the product manufacturer` (Date 2 2 2025) TRUE TRUE FALSE EQUALS NOTHING

§ `Article 2(1)(f): authorised representatives of providers not established in the Union (fork F-2-1-f)`

#ASSERT `Art 2(1)(f) the Regulation applies to the authorised representative of a provider not established in the Union` (Date 1 2 2025) TRUE FALSE EQUALS NOTHING
#ASSERT `Art 2(1)(f) the Regulation applies to the authorised representative of a provider not established in the Union` (Date 2 2 2025) TRUE FALSE EQUALS JUST TRUE
#ASSERT `Art 2(1)(f) the Regulation applies to the authorised representative of a provider not established in the Union` (Date 2 2 2025) TRUE TRUE EQUALS NOTHING
#ASSERT `Art 2(1)(f) the Regulation applies to the authorised representative of a provider not established in the Union` (Date 2 2 2025) FALSE FALSE EQUALS NOTHING

§ `Article 2(1)(g): affected persons located in the Union`

#ASSERT `Art 2(1)(g) the Regulation applies to the affected person in the Union` (Date 1 2 2025) TRUE `Established or located in the Union` EQUALS NOTHING
#ASSERT `Art 2(1)(g) the Regulation applies to the affected person in the Union` (Date 2 2 2025) TRUE `Established or located in the Union` EQUALS JUST TRUE
#ASSERT `Art 2(1)(g) the Regulation applies to the affected person in the Union` (Date 2 2 2025) TRUE `Established or located in a third country` EQUALS NOTHING
#ASSERT `Art 2(1)(g) the Regulation applies to the affected person in the Union` (Date 2 2 2025) FALSE `Established or located in the Union` EQUALS NOTHING

