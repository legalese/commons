#ASSERT `Art 49(4)(b) as enacted the Section B point is within the restricted registration` 8 EQUALS JUST TRUE
#ASSERT `Art 49(4)(b) as enacted the Section B point is within the restricted registration` 9 EQUALS JUST TRUE
