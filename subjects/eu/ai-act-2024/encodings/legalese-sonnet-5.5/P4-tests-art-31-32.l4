IMPORT prelude
IMPORT daydate
IMPORT `aia-core`
IMPORT `aia-timeline`
IMPORT `P4-gate`
IMPORT `P4-art-31-32`

-- Tests of Articles 31 and 32 (consolidated lines 567-583). Expected values are written from the text.
-- Each gated function: a case before (1 August 2025), on (2 August 2025) and after the date Chapter III Section 4 applies.

§ `Article 31(1), (2), (3)`

-- args: date asked, established under the national law of a Member State, has legal personality
#ASSERT `Art 31(1) the notified body is established as required` (Date 2 8 2025) TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 31(1) the notified body is established as required` (Date 2 8 2025) TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 31(1) the notified body is established as required` (Date 2 8 2025) FALSE TRUE EQUALS JUST FALSE
#ASSERT `Art 31(1) the notified body is established as required` (Date 1 8 2025) TRUE TRUE EQUALS NOTHING
#ASSERT `Art 31(1) the notified body is established as required` (Date 1 12 2026) TRUE TRUE EQUALS JUST TRUE
-- args: date asked, organisational, quality management, resources and process requirements, cybersecurity requirements
#ASSERT `Art 31(2) the notified body satisfies the requirements as required` (Date 2 8 2025) TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 31(2) the notified body satisfies the requirements as required` (Date 2 8 2025) FALSE TRUE EQUALS JUST FALSE
#ASSERT `Art 31(2) the notified body satisfies the requirements as required` (Date 2 8 2025) TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 31(2) the notified body satisfies the requirements as required` (Date 1 8 2025) TRUE TRUE EQUALS NOTHING
-- args: date asked, the structure and operation ensure confidence
#ASSERT `Art 31(3) the organisational structure ensures confidence` (Date 2 8 2025) TRUE EQUALS JUST TRUE
#ASSERT `Art 31(3) the organisational structure ensures confidence` (Date 2 8 2025) FALSE EQUALS JUST FALSE
#ASSERT `Art 31(3) the organisational structure ensures confidence` (Date 1 8 2025) TRUE EQUALS NOTHING

§ `Article 31(4)`

-- args: date asked, independent of the provider, independent of any other operator with an economic interest, independent of competitors
#ASSERT `Art 31(4) first and second sentences the notified body is independent` (Date 2 8 2025) TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 31(4) first and second sentences the notified body is independent` (Date 2 8 2025) FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Art 31(4) first and second sentences the notified body is independent` (Date 2 8 2025) TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Art 31(4) first and second sentences the notified body is independent` (Date 2 8 2025) TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 31(4) first and second sentences the notified body is independent` (Date 1 8 2025) TRUE TRUE TRUE EQUALS NOTHING
-- args: date asked, the use is of assessed systems necessary for the body's operations, the use is for personal purposes
#ASSERT `Art 31(4) third sentence the independence requirement precludes the use of the assessed high-risk AI system` (Date 2 8 2025) TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 31(4) third sentence the independence requirement precludes the use of the assessed high-risk AI system` (Date 2 8 2025) FALSE TRUE EQUALS JUST FALSE
#ASSERT `Art 31(4) third sentence the independence requirement precludes the use of the assessed high-risk AI system` (Date 2 8 2025) TRUE TRUE EQUALS JUST FALSE
#ASSERT `Art 31(4) third sentence the independence requirement precludes the use of the assessed high-risk AI system` (Date 2 8 2025) FALSE FALSE EQUALS NOTHING
#ASSERT `Art 31(4) third sentence the independence requirement precludes the use of the assessed high-risk AI system` (Date 1 8 2025) TRUE FALSE EQUALS NOTHING

§ `Article 31(5)`

-- args: date asked, directly involved in design, development, marketing or use, represent the parties engaged, conflicting activity, consultancy services
#ASSERT `Art 31(5) the conformity assessment body, its management and its personnel have kept to the bar on involvement and conflicting activity` (Date 2 8 2025) FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Art 31(5) the conformity assessment body, its management and its personnel have kept to the bar on involvement and conflicting activity` (Date 2 8 2025) TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Art 31(5) the conformity assessment body, its management and its personnel have kept to the bar on involvement and conflicting activity` (Date 2 8 2025) FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Art 31(5) the conformity assessment body, its management and its personnel have kept to the bar on involvement and conflicting activity` (Date 2 8 2025) FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 31(5) the conformity assessment body, its management and its personnel have kept to the bar on involvement and conflicting activity` (Date 2 8 2025) FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Art 31(5) the conformity assessment body, its management and its personnel have kept to the bar on involvement and conflicting activity` (Date 1 8 2025) FALSE FALSE FALSE FALSE EQUALS NOTHING

§ `Article 31(6)`

-- args: date asked, organised and operated to safeguard independence, documented structure and procedures, implemented them
#ASSERT `Art 31(6) the notified body is organised and operated as required` (Date 2 8 2025) TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 31(6) the notified body is organised and operated as required` (Date 2 8 2025) FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Art 31(6) the notified body is organised and operated as required` (Date 2 8 2025) TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Art 31(6) the notified body is organised and operated as required` (Date 2 8 2025) TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 31(6) the notified body is organised and operated as required` (Date 1 8 2025) TRUE TRUE TRUE EQUALS NOTHING
-- EXPECT FULFILLED
#TRACE `Art 31(6) the duty of the notified body to document and implement a structure and procedures` (Date 2 8 2025) AT 0 WITH
    PARTY `Art 31 notified body` DOES `Art 31(6) document and implement a structure and procedures to safeguard impartiality` AT 90
-- EXPECT RESIDUAL
#TRACE `Art 31(6) the duty of the notified body to document and implement a structure and procedures` (Date 2 8 2025) AT 0 WITH
    WAITUNTIL 400

§ `Article 31(7), (8)`

-- args: date asked, documented confidentiality procedures, staff bound by professional secrecy
#ASSERT `Art 31(7) the notified body has the procedures and the professional secrecy required` (Date 2 8 2025) TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 31(7) the notified body has the procedures and the professional secrecy required` (Date 2 8 2025) FALSE TRUE EQUALS JUST FALSE
#ASSERT `Art 31(7) the notified body has the procedures and the professional secrecy required` (Date 2 8 2025) TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 31(7) the notified body has the procedures and the professional secrecy required` (Date 1 8 2025) TRUE TRUE EQUALS NOTHING
-- args: date asked, takes account of size, of sector, of structure, of complexity of the AI system
#ASSERT `Art 31(8) the notified body has procedures that take due account of the provider and the AI system` (Date 2 8 2025) TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 31(8) the notified body has procedures that take due account of the provider and the AI system` (Date 2 8 2025) FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Art 31(8) the notified body has procedures that take due account of the provider and the AI system` (Date 2 8 2025) TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Art 31(8) the notified body has procedures that take due account of the provider and the AI system` (Date 2 8 2025) TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Art 31(8) the notified body has procedures that take due account of the provider and the AI system` (Date 2 8 2025) TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 31(8) the notified body has procedures that take due account of the provider and the AI system` (Date 1 8 2025) TRUE TRUE TRUE TRUE EQUALS NOTHING

§ `Article 31(9)`

-- args: date asked, has taken out appropriate liability insurance, liability assumed by the Member State, the Member State is directly responsible
#ASSERT `Art 31(9) the notified body has the liability insurance required` (Date 2 8 2025) TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Art 31(9) the notified body has the liability insurance required` (Date 2 8 2025) FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Art 31(9) the notified body has the liability insurance required` (Date 2 8 2025) FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 31(9) the notified body has the liability insurance required` (Date 2 8 2025) FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Art 31(9) the notified body has the liability insurance required` (Date 1 8 2025) FALSE FALSE FALSE EQUALS NOTHING
