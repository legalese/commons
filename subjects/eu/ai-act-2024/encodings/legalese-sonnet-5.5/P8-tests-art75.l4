§ `Art 75(1a): serious incidents of systems under the AI Office`

#ASSERT `Art 75(1a) first sentence the provider must report the serious incident to the AI Office` `Art 75 test on` `Art 75 test route` `Art 75 test placed` FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 75(1a) first sentence the provider must report the serious incident to the AI Office` `Art 75 test on` `Art 75 test route` `Art 75 test placed` FALSE FALSE FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `Art 75(1a) first sentence the provider must report the serious incident to the AI Office` `Art 75 test on` `Art 75 test route` `Art 75 test placed` FALSE FALSE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `Art 75(1a) first sentence the provider must report the serious incident to the AI Office` `Art 75 test before` `Art 75 test route` `Art 75 test placed` FALSE FALSE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `Art 75(1a) first sentence the provider must report the serious incident to the AI Office` (Date 1 1 2027) `Art 75 test route` `Art 75 test placed earlier` FALSE FALSE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `Art 75(1a) first sentence the provider must report the serious incident to the AI Office` `Art 75 test on` `Route neither` `Art 75 test placed` FALSE FALSE FALSE TRUE TRUE EQUALS NOTHING
-- fifteen days
-- EXPECT FULFILLED
#TRACE `Art 75(1a) the provider's duty to report the serious incident to the AI Office` `Art 75 test on` `Art 75 test route` `Art 75 test placed` FALSE FALSE FALSE TRUE (Date 3 8 2026) FALSE FALSE FALSE AT (Day (Date 3 8 2026)) WITH
    PARTY `Arts 72 to 79 party provider` DOES `Art 75(1a) report the serious incident to the AI Office` AT (Day (Date 18 8 2026))
-- EXPECT BREACH
#TRACE `Art 75(1a) the provider's duty to report the serious incident to the AI Office` `Art 75 test on` `Art 75 test route` `Art 75 test placed` FALSE FALSE FALSE TRUE (Date 3 8 2026) FALSE FALSE FALSE AT (Day (Date 3 8 2026)) WITH
    PARTY `Arts 72 to 79 party provider` DOES `Art 75(1a) report the serious incident to the AI Office` AT (Day (Date 19 8 2026))
-- EXPECT BREACH
#TRACE `Art 75(1a) the provider's duty to report the serious incident to the AI Office` `Art 75 test on` `Art 75 test route` `Art 75 test placed` FALSE FALSE FALSE TRUE (Date 3 8 2026) FALSE FALSE FALSE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 19 8 2026))
-- two days (widespread infringement)
-- EXPECT FULFILLED
#TRACE `Art 75(1a) the provider's duty to report the serious incident to the AI Office` `Art 75 test on` `Art 75 test route` `Art 75 test placed` FALSE FALSE FALSE TRUE (Date 3 8 2026) TRUE FALSE FALSE AT (Day (Date 3 8 2026)) WITH
    PARTY `Arts 72 to 79 party provider` DOES `Art 75(1a) report the serious incident to the AI Office` AT (Day (Date 5 8 2026))
-- EXPECT BREACH
#TRACE `Art 75(1a) the provider's duty to report the serious incident to the AI Office` `Art 75 test on` `Art 75 test route` `Art 75 test placed` FALSE FALSE FALSE TRUE (Date 3 8 2026) TRUE FALSE FALSE AT (Day (Date 3 8 2026)) WITH
    PARTY `Arts 72 to 79 party provider` DOES `Art 75(1a) report the serious incident to the AI Office` AT (Day (Date 6 8 2026))
-- ten days (death)
-- EXPECT FULFILLED
#TRACE `Art 75(1a) the provider's duty to report the serious incident to the AI Office` `Art 75 test on` `Art 75 test route` `Art 75 test placed` FALSE FALSE FALSE TRUE (Date 3 8 2026) FALSE FALSE TRUE AT (Day (Date 3 8 2026)) WITH
    PARTY `Arts 72 to 79 party provider` DOES `Art 75(1a) report the serious incident to the AI Office` AT (Day (Date 13 8 2026))
-- EXPECT BREACH
#TRACE `Art 75(1a) the provider's duty to report the serious incident to the AI Office` `Art 75 test on` `Art 75 test route` `Art 75 test placed` FALSE FALSE FALSE TRUE (Date 3 8 2026) FALSE FALSE TRUE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 14 8 2026))
-- the system is not subject to the competence of the AI Office: nothing is owed to it
-- EXPECT FULFILLED
#TRACE `Art 75(1a) the provider's duty to report the serious incident to the AI Office` `Art 75 test on` `Art 75 test route` `Art 75 test placed` FALSE FALSE FALSE FALSE (Date 3 8 2026) FALSE FALSE FALSE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
-- the group does not apply on 1 August 2026: nothing is owed
-- EXPECT FULFILLED
#TRACE `Art 75(1a) the provider's duty to report the serious incident to the AI Office` `Art 75 test before` `Art 75 test route` `Art 75 test placed` FALSE FALSE FALSE TRUE (Date 3 8 2026) FALSE FALSE FALSE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
-- saved by Art 111(2): nothing is owed
-- EXPECT FULFILLED
#TRACE `Art 75(1a) the provider's duty to report the serious incident to the AI Office` (Date 1 1 2027) `Art 75 test route` `Art 75 test placed earlier` FALSE FALSE FALSE TRUE (Date 3 1 2027) FALSE FALSE FALSE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))

