#ASSERT `Art 65(6) the Board may establish other standing or temporary sub-groups` (Date 2 8 2025) TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 65(6) the Board may establish other standing or temporary sub-groups` (Date 2 8 2025) TRUE FALSE EQUALS NOTHING
#ASSERT `Art 65(6) the Board may establish other standing or temporary sub-groups` (Date 2 8 2025) FALSE TRUE EQUALS NOTHING
