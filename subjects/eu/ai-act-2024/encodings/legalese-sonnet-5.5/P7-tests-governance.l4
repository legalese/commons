IMPORT prelude
IMPORT daydate
IMPORT `aia-core`
IMPORT `aia-timeline`
IMPORT `P7-governance`

-- P7-tests-governance: tests for P7-governance. Every expected value is written from the text beside the assertion, never copied from the output.
-- Each assertion is on one line; NOTHING is "not covered".

-- 64(1)
#ASSERT `Art 64(1) the Commission has developed Union expertise and capabilities in the field of AI through the AI Office` (Date 1 8 2025) TRUE EQUALS NOTHING
#ASSERT `Art 64(1) the Commission has developed Union expertise and capabilities in the field of AI through the AI Office` (Date 2 8 2025) TRUE EQUALS JUST TRUE
#ASSERT `Art 64(1) the Commission has developed Union expertise and capabilities in the field of AI through the AI Office` (Date 2 8 2025) FALSE EQUALS JUST FALSE
-- 64(2)
#ASSERT `Art 64(2) the Member States have facilitated the tasks entrusted to the AI Office` (Date 1 8 2025) TRUE EQUALS NOTHING
#ASSERT `Art 64(2) the Member States have facilitated the tasks entrusted to the AI Office` (Date 2 8 2025) TRUE EQUALS JUST TRUE
#ASSERT `Art 64(2) the Member States have facilitated the tasks entrusted to the AI Office` (Date 2 8 2025) FALSE EQUALS JUST FALSE
-- Art 64(3) as amended
#ASSERT `Art 64(3) as amended the AI Office has been allocated adequate resources` TRUE EQUALS JUST TRUE
#ASSERT `Art 64(3) as amended the AI Office has been allocated adequate resources` FALSE EQUALS JUST FALSE
-- Art 64(3), inserted: nothing before 27 July 2026 (the as-enacted Article has two paragraphs), the duty from that day
-- args: date asked, adequate resources allocated
#ASSERT `Art 64(3) the AI Office has been allocated adequate resources` (Date 1 8 2025) TRUE EQUALS NOTHING
#ASSERT `Art 64(3) the AI Office has been allocated adequate resources` (Date 2 8 2025) TRUE EQUALS NOTHING
#ASSERT `Art 64(3) the AI Office has been allocated adequate resources` (Date 2 8 2025) FALSE EQUALS NOTHING
#ASSERT `Art 64(3) the AI Office has been allocated adequate resources` (Date 26 7 2026) TRUE EQUALS NOTHING
#ASSERT `Art 64(3) the AI Office has been allocated adequate resources` (Date 27 7 2026) TRUE EQUALS JUST TRUE
#ASSERT `Art 64(3) the AI Office has been allocated adequate resources` (Date 27 7 2026) FALSE EQUALS JUST FALSE
#ASSERT `Art 64(3) the AI Office has been allocated adequate resources` (Date 2 8 2027) FALSE EQUALS JUST FALSE
#ASSERT `Art 64(3) as amended the AI Office has been allocated adequate resources` TRUE EQUALS JUST TRUE
#ASSERT `Art 64(3) as amended the AI Office has been allocated adequate resources` FALSE EQUALS JUST FALSE
-- 64(3) prejudice
#ASSERT `Art 64(3) the allocation of resources prejudices the budgetary procedure` (Date 1 8 2025) TRUE EQUALS NOTHING
#ASSERT `Art 64(3) the allocation of resources prejudices the budgetary procedure` (Date 2 8 2025) TRUE EQUALS JUST FALSE
#ASSERT `Art 64(3) the allocation of resources prejudices the budgetary procedure` (Date 2 8 2025) FALSE EQUALS NOTHING
-- Art 65(1): "is hereby established": the Board exists from the day Chapter VII applies (2 August 2025)
#ASSERT `Art 65(1) the European Artificial Intelligence Board is established on the date asked` (Date 1 8 2025) EQUALS NOTHING
#ASSERT `Art 65(1) the European Artificial Intelligence Board is established on the date asked` (Date 2 8 2025) EQUALS JUST TRUE
#ASSERT `Art 65(1) the European Artificial Intelligence Board is established on the date asked` (Date 2 8 2027) EQUALS JUST TRUE
-- Art 65(2): who sits where
#ASSERT `Art 65(2) the participant's place in the Board's meetings` (Date 2 8 2025) `Art 65(2) a representative of a Member State` FALSE EQUALS JUST `Art 65(2) member of the Board`
#ASSERT `Art 65(2) the participant's place in the Board's meetings` (Date 2 8 2025) `Art 65(2) the European Data Protection Supervisor` FALSE EQUALS JUST `Art 65(2) observer`
#ASSERT `Art 65(2) the participant's place in the Board's meetings` (Date 2 8 2025) `Art 65(2) the AI Office` FALSE EQUALS JUST `Art 65(2) attends the meetings without taking part in the votes`
#ASSERT `Art 65(2) the participant's place in the Board's meetings` (Date 2 8 2025) `Art 65(2) another national or Union authority, body or expert` TRUE EQUALS JUST `Art 65(2) invited to the meetings by the Board case by case`
#ASSERT `Art 65(2) the participant's place in the Board's meetings` (Date 2 8 2025) `Art 65(2) another national or Union authority, body or expert` FALSE EQUALS NOTHING
#ASSERT `Art 65(2) the participant's place in the Board's meetings` (Date 1 8 2025) `Art 65(2) a representative of a Member State` TRUE EQUALS NOTHING
-- Art 65(3): "a period of three years, renewable once"
#ASSERT `Art 65(3) the date on which the designation of the representative ends` (Date 2 8 2025) (Date 15 9 2025) EQUALS JUST (Date 15 9 2028)
#ASSERT `Art 65(3) the date on which the designation of the representative ends` (Date 2 8 2025) (Date 29 2 2028) EQUALS JUST (Date 28 2 2031)
#ASSERT `Art 65(3) the date on which the designation of the representative ends` (Date 1 8 2025) (Date 15 9 2025) EQUALS NOTHING
#ASSERT `Art 65(3) the designation of the representative may be renewed` (Date 2 8 2025) 0 EQUALS JUST TRUE
#ASSERT `Art 65(3) the designation of the representative may be renewed` (Date 2 8 2025) 1 EQUALS JUST FALSE
#ASSERT `Art 65(3) the designation of the representative may be renewed` (Date 2 8 2025) 2 EQUALS JUST FALSE
#ASSERT `Art 65(3) the designation of the representative may be renewed` (Date 1 8 2025) 0 EQUALS NOTHING
-- 65(4)(a)
#ASSERT `Art 65(4)(a) the Member State has ensured that its representative has the relevant competences and powers` (Date 1 8 2025) TRUE EQUALS NOTHING
#ASSERT `Art 65(4)(a) the Member State has ensured that its representative has the relevant competences and powers` (Date 2 8 2025) TRUE EQUALS JUST TRUE
#ASSERT `Art 65(4)(a) the Member State has ensured that its representative has the relevant competences and powers` (Date 2 8 2025) FALSE EQUALS JUST FALSE
-- 65(4)(b) 1
#ASSERT `Art 65(4)(b) the Member State has ensured that its representative is designated as a single contact point vis-a-vis the Board` (Date 1 8 2025) TRUE EQUALS NOTHING
#ASSERT `Art 65(4)(b) the Member State has ensured that its representative is designated as a single contact point vis-a-vis the Board` (Date 2 8 2025) TRUE EQUALS JUST TRUE
#ASSERT `Art 65(4)(b) the Member State has ensured that its representative is designated as a single contact point vis-a-vis the Board` (Date 2 8 2025) FALSE EQUALS JUST FALSE
-- 65(4)(b) 2
#ASSERT `Art 65(4)(b) the Member State has ensured that its representative is designated as a single contact point for stakeholders` (Date 1 8 2025) TRUE TRUE EQUALS NOTHING
#ASSERT `Art 65(4)(b) the Member State has ensured that its representative is designated as a single contact point for stakeholders` (Date 2 8 2025) TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 65(4)(b) the Member State has ensured that its representative is designated as a single contact point for stakeholders` (Date 2 8 2025) TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 65(4)(b) the Member State has ensured that its representative is designated as a single contact point for stakeholders` (Date 2 8 2025) FALSE TRUE EQUALS NOTHING
-- 65(4)(c)
#ASSERT `Art 65(4)(c) the Member State has ensured that its representative is empowered to facilitate consistency and coordination` (Date 1 8 2025) TRUE EQUALS NOTHING
#ASSERT `Art 65(4)(c) the Member State has ensured that its representative is empowered to facilitate consistency and coordination` (Date 2 8 2025) TRUE EQUALS JUST TRUE
#ASSERT `Art 65(4)(c) the Member State has ensured that its representative is empowered to facilitate consistency and coordination` (Date 2 8 2025) FALSE EQUALS JUST FALSE
-- Art 65(5): a two-thirds majority of the designated representatives (27 Member States: 18 votes are enough, 17 are not)
#ASSERT `Art 65(5) the Board's rules of procedure have been adopted by a two-thirds majority` (Date 2 8 2025) 18 27 EQUALS JUST TRUE
#ASSERT `Art 65(5) the Board's rules of procedure have been adopted by a two-thirds majority` (Date 2 8 2025) 17 27 EQUALS JUST FALSE
#ASSERT `Art 65(5) the Board's rules of procedure have been adopted by a two-thirds majority` (Date 2 8 2025) 27 27 EQUALS JUST TRUE
#ASSERT `Art 65(5) the Board's rules of procedure have been adopted by a two-thirds majority` (Date 2 8 2025) 2 3 EQUALS JUST TRUE
#ASSERT `Art 65(5) the Board's rules of procedure have been adopted by a two-thirds majority` (Date 1 8 2025) 27 27 EQUALS NOTHING
-- 65(5) 2
#ASSERT `Art 65(5) the rules of procedure lay down the procedures and arrangements listed` (Date 1 8 2025) TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `Art 65(5) the rules of procedure lay down the procedures and arrangements listed` (Date 2 8 2025) TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 65(5) the rules of procedure lay down the procedures and arrangements listed` (Date 2 8 2025) FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Art 65(5) the rules of procedure lay down the procedures and arrangements listed` (Date 2 8 2025) TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Art 65(5) the rules of procedure lay down the procedures and arrangements listed` (Date 2 8 2025) TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Art 65(5) the rules of procedure lay down the procedures and arrangements listed` (Date 2 8 2025) TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Art 65(5) the rules of procedure lay down the procedures and arrangements listed` (Date 2 8 2025) TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
