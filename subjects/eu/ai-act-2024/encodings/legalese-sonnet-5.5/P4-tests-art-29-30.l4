IMPORT prelude
IMPORT daydate
IMPORT `aia-core`
IMPORT `aia-timeline`
IMPORT `P4-gate`
IMPORT `P4-art-29-30`

-- Tests of Articles 29 and 30. Expected values are written from the text (consolidated lines 546-566; as enacted: base lines 1069-1082).
-- A case before (1 August 2025), on (2 August 2025) and after the date from which Chapter III Section 4 applies; and on each side of 27 July 2026
-- for the provisions the Omnibus replaced (Art 29(4), Art 30(2)).

§ `Article 29(1)`

-- args: date asked, the body has submitted an application, it was submitted to the notifying authority of the Member State where the body is established
#ASSERT `Art 29(1) the conformity assessment body has submitted its application to the right notifying authority` (Date 2 8 2025) TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 29(1) the conformity assessment body has submitted its application to the right notifying authority` (Date 2 8 2025) TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 29(1) the conformity assessment body has submitted its application to the right notifying authority` (Date 2 8 2025) FALSE FALSE EQUALS JUST FALSE
#ASSERT `Art 29(1) the conformity assessment body has submitted its application to the right notifying authority` (Date 1 8 2025) TRUE TRUE EQUALS NOTHING
#ASSERT `Art 29(1) the conformity assessment body has submitted its application to the right notifying authority` (Date 1 12 2026) TRUE TRUE EQUALS JUST TRUE
-- EXPECT FULFILLED
#TRACE `Art 29(1) the duty of the conformity assessment body to submit an application for notification` (Date 2 8 2025) AT 0 WITH
    PARTY `Art 29 conformity assessment body` DOES `Art 29(1) submit an application for notification to the notifying authority of the Member State in which the body is established` AT 4
-- EXPECT RESIDUAL
#TRACE `Art 29(1) the duty of the conformity assessment body to submit an application for notification` (Date 2 8 2025) AT 0 WITH
    WAITUNTIL 400
-- EXPECT FULFILLED
#TRACE `Art 29(1) the duty of the conformity assessment body to submit an application for notification` (Date 1 8 2025) AT 0 WITH
    WAITUNTIL 400

§ `Article 29(2)`

-- args: date asked, activities described, modules described, types of AI systems described, an accreditation certificate exists, the certificate accompanies the application
#ASSERT `Art 29(2) first subparagraph the application for notification is accompanied as required` (Date 2 8 2025) TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 29(2) first subparagraph the application for notification is accompanied as required` (Date 2 8 2025) TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Art 29(2) first subparagraph the application for notification is accompanied as required` (Date 2 8 2025) TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 29(2) first subparagraph the application for notification is accompanied as required` (Date 2 8 2025) FALSE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Art 29(2) first subparagraph the application for notification is accompanied as required` (Date 2 8 2025) TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Art 29(2) first subparagraph the application for notification is accompanied as required` (Date 2 8 2025) TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Art 29(2) first subparagraph the application for notification is accompanied as required` (Date 1 8 2025) TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING
-- args: date asked, a valid document on an existing designation exists, every such document has been added
#ASSERT `Art 29(2) second subparagraph the valid documents on existing designations have been added` (Date 2 8 2025) TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 29(2) second subparagraph the valid documents on existing designations have been added` (Date 2 8 2025) TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 29(2) second subparagraph the valid documents on existing designations have been added` (Date 2 8 2025) FALSE FALSE EQUALS NOTHING
#ASSERT `Art 29(2) second subparagraph the valid documents on existing designations have been added` (Date 1 8 2025) TRUE TRUE EQUALS NOTHING

§ `Article 29(3)`

-- args: date asked, the body cannot provide an accreditation certificate, it has provided the documentary evidence
#ASSERT `Art 29(3) the conformity assessment body has provided the documentary evidence` (Date 2 8 2025) TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 29(3) the conformity assessment body has provided the documentary evidence` (Date 2 8 2025) TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 29(3) the conformity assessment body has provided the documentary evidence` (Date 2 8 2025) FALSE FALSE EQUALS NOTHING
#ASSERT `Art 29(3) the conformity assessment body has provided the documentary evidence` (Date 1 8 2025) TRUE TRUE EQUALS NOTHING
-- EXPECT FULFILLED
#TRACE `Art 29(3) the duty of the conformity assessment body to provide the documentary evidence` (Date 2 8 2025) AT 0 WITH
    PARTY `Art 29 conformity assessment body` DOES `Art 29(3) provide the notifying authority with all the documentary evidence necessary` AT 20
-- EXPECT RESIDUAL
#TRACE `Art 29(3) the duty of the conformity assessment body to provide the documentary evidence` (Date 2 8 2025) AT 0 WITH
    WAITUNTIL 400

§ `Article 29(4): both versions, on each side of 27 July 2026`

-- First subparagraph, the text as enacted and as amended tested through their own functions.
-- args: designated under (pursuant to) other legislation, the documents are used to support (and expedite) the designation procedure
#ASSERT `Art 29(4) as enacted first sentence the documents and certificates may be used` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 29(4) as enacted first sentence the documents and certificates may be used` FALSE TRUE EQUALS NOTHING
#ASSERT `Art 29(4) as enacted first sentence the documents and certificates may be used` TRUE FALSE EQUALS NOTHING
#ASSERT `Art 29(4) as amended first subparagraph the documents and certificates may be used` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 29(4) as amended first subparagraph the documents and certificates may be used` FALSE TRUE EQUALS NOTHING
#ASSERT `Art 29(4) as amended first subparagraph the documents and certificates may be used` TRUE FALSE EQUALS NOTHING
-- The two versions give the same answer on these facts (the Omnibus added "and expedite" and "pursuant to"; fork F-29-4).
#ASSERT `Art 29(4) first subparagraph the documents and certificates may be used` (Date 26 7 2026) TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 29(4) first subparagraph the documents and certificates may be used` (Date 27 7 2026) TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 29(4) first subparagraph the documents and certificates may be used` (Date 26 7 2026) FALSE TRUE EQUALS NOTHING
#ASSERT `Art 29(4) first subparagraph the documents and certificates may be used` (Date 27 7 2026) FALSE TRUE EQUALS NOTHING
#ASSERT `Art 29(4) first subparagraph the documents and certificates may be used` (Date 1 8 2025) TRUE TRUE EQUALS NOTHING

-- Second subparagraph (inserted): args: designated pursuant to Section A legislation, undergoes the unified assessment, has submitted the single application
#ASSERT `Art 29(4) as amended second subparagraph the notified body has submitted the single application` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 29(4) as amended second subparagraph the notified body has submitted the single application` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 29(4) as amended second subparagraph the notified body has submitted the single application` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `Art 29(4) as amended second subparagraph the notified body has submitted the single application` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `Art 29(4) second subparagraph the notified body has submitted the single application` (Date 26 7 2026) TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `Art 29(4) second subparagraph the notified body has submitted the single application` (Date 27 7 2026) TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 29(4) second subparagraph the notified body has submitted the single application` (Date 27 7 2026) TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 29(4) second subparagraph the notified body has submitted the single application` (Date 1 8 2025) TRUE TRUE TRUE EQUALS NOTHING
-- EXPECT FULFILLED
#TRACE `Art 29(4) the duty of the notified body to submit the single application` (Date 26 7 2026) AT 0 WITH
    WAITUNTIL 400
-- EXPECT RESIDUAL
#TRACE `Art 29(4) the duty of the notified body to submit the single application` (Date 27 7 2026) AT 0 WITH
    WAITUNTIL 400
-- EXPECT FULFILLED
#TRACE `Art 29(4) the duty of the notified body to submit the single application` (Date 27 7 2026) AT 0 WITH
    PARTY `Art 29 notified body` DOES `Art 29(4) submit the single application for assessment to the notifying authority designated pursuant to the Union harmonisation legislation` AT 30

-- Third subparagraph: the same answer before and after 27 July 2026 (the sentence is unchanged). args: relevant changes occurred, documentation updated
#ASSERT `Art 29(4) third subparagraph the notified body has updated the documentation` (Date 26 7 2026) TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 29(4) third subparagraph the notified body has updated the documentation` (Date 27 7 2026) TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 29(4) third subparagraph the notified body has updated the documentation` (Date 26 7 2026) TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 29(4) third subparagraph the notified body has updated the documentation` (Date 27 7 2026) TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 29(4) third subparagraph the notified body has updated the documentation` (Date 27 7 2026) FALSE FALSE EQUALS NOTHING
#ASSERT `Art 29(4) third subparagraph the notified body has updated the documentation` (Date 1 8 2025) TRUE TRUE EQUALS NOTHING
-- EXPECT FULFILLED
#TRACE `Art 29(4) the duty of the notified body to update the documentation` (Date 2 8 2025) AT 0 WITH
    PARTY `Art 29 notified body` DOES `Art 29(4) update the documentation whenever relevant changes occur` AT 60
-- EXPECT RESIDUAL
#TRACE `Art 29(4) the duty of the notified body to update the documentation` (Date 2 8 2025) AT 0 WITH
    WAITUNTIL 400

§ `Article 30(1)`

-- args: date asked, the body has satisfied the requirements laid down in Article 31
#ASSERT `Art 30(1) the notifying authority may notify the conformity assessment body` (Date 2 8 2025) TRUE EQUALS JUST TRUE
#ASSERT `Art 30(1) the notifying authority may notify the conformity assessment body` (Date 2 8 2025) FALSE EQUALS JUST FALSE
#ASSERT `Art 30(1) the notifying authority may notify the conformity assessment body` (Date 1 8 2025) TRUE EQUALS NOTHING
#ASSERT `Art 30(1) the notifying authority may notify the conformity assessment body` (Date 1 8 2025) FALSE EQUALS NOTHING

§ `Article 30(2): both versions, on each side of 27 July 2026`

-- args: notified the Commission and the other Member States, used the electronic notification tool, based on the Annex XIV list
#ASSERT `Art 30(2) as enacted the notifying authority has notified the conformity assessment body` TRUE TRUE EQUALS TRUE
#ASSERT `Art 30(2) as enacted the notifying authority has notified the conformity assessment body` TRUE FALSE EQUALS FALSE
#ASSERT `Art 30(2) as enacted the notifying authority has notified the conformity assessment body` FALSE TRUE EQUALS FALSE
#ASSERT `Art 30(2) as amended first subparagraph the notifying authority has notified the conformity assessment body` TRUE TRUE TRUE EQUALS TRUE
#ASSERT `Art 30(2) as amended first subparagraph the notifying authority has notified the conformity assessment body` TRUE TRUE FALSE EQUALS FALSE
#ASSERT `Art 30(2) as amended first subparagraph the notifying authority has notified the conformity assessment body` TRUE FALSE TRUE EQUALS FALSE
#ASSERT `Art 30(2) as amended first subparagraph the notifying authority has notified the conformity assessment body` FALSE TRUE TRUE EQUALS FALSE
-- The two versions differ for a notification not based on the Annex XIV list: as enacted it complies, as amended it does not.
#ASSERT `Art 30(2) first subparagraph the notifying authority has notified the conformity assessment body` (Date 26 7 2026) TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Art 30(2) first subparagraph the notifying authority has notified the conformity assessment body` (Date 27 7 2026) TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 30(2) first subparagraph the notifying authority has notified the conformity assessment body` (Date 26 7 2026) TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 30(2) first subparagraph the notifying authority has notified the conformity assessment body` (Date 27 7 2026) TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 30(2) first subparagraph the notifying authority has notified the conformity assessment body` (Date 27 7 2026) TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Art 30(2) first subparagraph the notifying authority has notified the conformity assessment body` (Date 1 8 2025) TRUE TRUE TRUE EQUALS NOTHING
-- EXPECT FULFILLED
#TRACE `Art 30(2) the duty of the notifying authority to notify the Commission and the other Member States` (Date 2 8 2025) AT 0 WITH
    PARTY `Art 30 notifying authority` DOES `Art 30(2) notify the Commission and the other Member States of each conformity assessment body` AT 2
-- EXPECT RESIDUAL
#TRACE `Art 30(2) the duty of the notifying authority to notify the Commission and the other Member States` (Date 27 7 2026) AT 0 WITH
    WAITUNTIL 400

§ `Article 30(3)`

-- args: date asked, full details of the activities, of the modules, of the types of AI systems, the attestation of competence
#ASSERT `Art 30(3) first sentence the notification includes the full details` (Date 2 8 2025) TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 30(3) first sentence the notification includes the full details` (Date 2 8 2025) FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Art 30(3) first sentence the notification includes the full details` (Date 2 8 2025) TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Art 30(3) first sentence the notification includes the full details` (Date 2 8 2025) TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Art 30(3) first sentence the notification includes the full details` (Date 2 8 2025) TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 30(3) first sentence the notification includes the full details` (Date 1 8 2025) TRUE TRUE TRUE TRUE EQUALS NOTHING
-- args: date asked, the notification is not based on an accreditation certificate, the authority has provided the documentary evidence
#ASSERT `Art 30(3) second sentence the notifying authority has provided the documentary evidence` (Date 2 8 2025) TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 30(3) second sentence the notifying authority has provided the documentary evidence` (Date 2 8 2025) TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 30(3) second sentence the notifying authority has provided the documentary evidence` (Date 2 8 2025) FALSE FALSE EQUALS NOTHING
#ASSERT `Art 30(3) second sentence the notifying authority has provided the documentary evidence` (Date 1 8 2025) TRUE TRUE EQUALS NOTHING
-- EXPECT FULFILLED
#TRACE `Art 30(3) the duty of the notifying authority to provide the documentary evidence` (Date 2 8 2025) AT 0 WITH
    PARTY `Art 30 notifying authority` DOES `Art 30(3) provide the Commission and the other Member States with documentary evidence` AT 6
-- EXPECT RESIDUAL
#TRACE `Art 30(3) the duty of the notifying authority to provide the documentary evidence` (Date 2 8 2025) AT 0 WITH
    WAITUNTIL 400

§ `Article 30(4): two weeks and two months, on each side of the end of the period`

-- args: includes an accreditation certificate, includes documentary evidence, the date of the notification
#ASSERT `Art 30(4) the last day on which an objection may be raised` TRUE FALSE (Date 1 9 2025) EQUALS JUST (Date 15 9 2025)
#ASSERT `Art 30(4) the last day on which an objection may be raised` FALSE TRUE (Date 1 9 2025) EQUALS JUST (Date 1 11 2025)
#ASSERT `Art 30(4) the last day on which an objection may be raised` FALSE TRUE (Date 31 12 2025) EQUALS JUST (Date 28 2 2026)
#ASSERT `Art 30(4) the last day on which an objection may be raised` TRUE TRUE (Date 1 9 2025) EQUALS NOTHING
#ASSERT `Art 30(4) the last day on which an objection may be raised` FALSE FALSE (Date 1 9 2025) EQUALS NOTHING
-- args: date asked, includes certificate, includes documentary evidence, date of notification, an objection was raised within the period
-- Accreditation certificate: two weeks from 1 September 2025 end on 15 September 2025; no objection: the body may act from 16 September.
#ASSERT `Art 30(4) the conformity assessment body may perform the activities of a notified body` (Date 15 9 2025) TRUE FALSE (Date 1 9 2025) FALSE EQUALS JUST FALSE
#ASSERT `Art 30(4) the conformity assessment body may perform the activities of a notified body` (Date 16 9 2025) TRUE FALSE (Date 1 9 2025) FALSE EQUALS JUST TRUE
#ASSERT `Art 30(4) the conformity assessment body may perform the activities of a notified body` (Date 16 9 2025) TRUE FALSE (Date 1 9 2025) TRUE EQUALS JUST FALSE
-- Documentary evidence: two months from 1 September 2025 end on 1 November 2025.
#ASSERT `Art 30(4) the conformity assessment body may perform the activities of a notified body` (Date 1 11 2025) FALSE TRUE (Date 1 9 2025) FALSE EQUALS JUST FALSE
#ASSERT `Art 30(4) the conformity assessment body may perform the activities of a notified body` (Date 2 11 2025) FALSE TRUE (Date 1 9 2025) FALSE EQUALS JUST TRUE
#ASSERT `Art 30(4) the conformity assessment body may perform the activities of a notified body` (Date 2 11 2025) FALSE TRUE (Date 1 9 2025) TRUE EQUALS JUST FALSE
-- Both or neither: no period is given.
#ASSERT `Art 30(4) the conformity assessment body may perform the activities of a notified body` (Date 2 11 2025) TRUE TRUE (Date 1 9 2025) FALSE EQUALS NOTHING
#ASSERT `Art 30(4) the conformity assessment body may perform the activities of a notified body` (Date 2 11 2025) FALSE FALSE (Date 1 9 2025) FALSE EQUALS NOTHING
-- Before 2 August 2025 the group does not apply.
#ASSERT `Art 30(4) the conformity assessment body may perform the activities of a notified body` (Date 1 8 2025) TRUE FALSE (Date 1 7 2025) FALSE EQUALS NOTHING

§ `Article 30(5)`

-- args: date asked, objections have been raised, the Commission has entered into consultations
#ASSERT `Art 30(5) first sentence the Commission has entered into consultations` (Date 2 8 2025) TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 30(5) first sentence the Commission has entered into consultations` (Date 2 8 2025) TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 30(5) first sentence the Commission has entered into consultations` (Date 2 8 2025) FALSE FALSE EQUALS NOTHING
#ASSERT `Art 30(5) first sentence the Commission has entered into consultations` (Date 1 8 2025) TRUE TRUE EQUALS NOTHING
-- args: date asked, objections have been raised, decided, addressed to the Member State, addressed to the body
#ASSERT `Art 30(5) second and third sentences the Commission has decided and addressed its decision` (Date 2 8 2025) TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 30(5) second and third sentences the Commission has decided and addressed its decision` (Date 2 8 2025) TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Art 30(5) second and third sentences the Commission has decided and addressed its decision` (Date 2 8 2025) TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Art 30(5) second and third sentences the Commission has decided and addressed its decision` (Date 2 8 2025) TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 30(5) second and third sentences the Commission has decided and addressed its decision` (Date 2 8 2025) FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `Art 30(5) second and third sentences the Commission has decided and addressed its decision` (Date 1 8 2025) TRUE TRUE TRUE TRUE EQUALS NOTHING
-- EXPECT FULFILLED
#TRACE `Art 30(5) the duty of the Commission to enter into consultations` (Date 2 8 2025) AT 0 WITH
    PARTY `Art 30 Commission` DOES `Art 30(5) enter into consultations with the relevant Member States and the conformity assessment body` AT 3
-- EXPECT RESIDUAL
#TRACE `Art 30(5) the duty of the Commission to decide whether the authorisation is justified` (Date 2 8 2025) AT 0 WITH
    WAITUNTIL 400
-- EXPECT FULFILLED
#TRACE `Art 30(5) the duty of the Commission to decide whether the authorisation is justified` (Date 2 8 2025) AT 0 WITH
    PARTY `Art 30 Commission` DOES `Art 30(5) decide whether the authorisation is justified` AT 30
-- EXPECT FULFILLED
#TRACE `Art 30(5) the duty of the Commission to address its decision` (Date 2 8 2025) AT 0 WITH
    PARTY `Art 30 Commission` DOES `Art 30(5) address the decision to the Member State concerned and to the relevant conformity assessment body` AT 31
