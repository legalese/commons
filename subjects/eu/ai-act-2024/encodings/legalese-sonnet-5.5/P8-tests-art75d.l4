-- EXPECT FULFILLED
#TRACE `Art 75d(4) first sentence the AI Office's duty to publish the decisions` `Art 75d test on` FALSE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
-- EXPECT FULFILLED
#TRACE `Art 75d(4) first sentence the AI Office's duty to publish the decisions` `Art 75d test on` TRUE AT (Day (Date 3 8 2026)) WITH
    PARTY `Arts 72 to 79 party AI Office` DOES `Art 75d(4) publish the decisions adopted pursuant to Articles 75b and 75c` AT (Day (Date 4 8 2026))
-- EXPECT RESIDUAL
#TRACE `Art 75d(4) first sentence the AI Office's duty to publish the decisions` `Art 75d test on` TRUE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
-- EXPECT FULFILLED
#TRACE `Art 75d(4) first sentence the AI Office's duty to publish the decisions` `Art 75d test before` TRUE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
#ASSERT `Art 75d(4) second sentence the publication states the names of the parties and the main content of the decision, including any penalties imposed` `Art 75d test on` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 75d(4) second sentence the publication states the names of the parties and the main content of the decision, including any penalties imposed` `Art 75d test on` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Art 75d(4) second sentence the publication states the names of the parties and the main content of the decision, including any penalties imposed` `Art 75d test on` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Art 75d(4) second sentence the publication states the names of the parties and the main content of the decision, including any penalties imposed` `Art 75d test on` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 75d(4) second sentence the publication states the names of the parties and the main content of the decision, including any penalties imposed` `Art 75d test before` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `Art 75d(4) third sentence the publication has regard to the rights and legitimate interests of any person concerned in the protection of their confidential information` `Art 75d test on` TRUE EQUALS JUST TRUE
#ASSERT `Art 75d(4) third sentence the publication has regard to the rights and legitimate interests of any person concerned in the protection of their confidential information` `Art 75d test on` FALSE EQUALS JUST FALSE
#ASSERT `Art 75d(4) third sentence the publication has regard to the rights and legitimate interests of any person concerned in the protection of their confidential information` `Art 75d test before` TRUE EQUALS NOTHING
