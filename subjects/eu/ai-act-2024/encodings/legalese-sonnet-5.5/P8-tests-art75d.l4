IMPORT prelude
IMPORT daydate
IMPORT `aia-core`
IMPORT `aia-timeline`
IMPORT `aia-definitions`
IMPORT `P8-gate`
IMPORT `P8-art75d`

-- Tests of Article 75d (inserted by the Omnibus). The group General applies from 2 August 2026 (Art 113).

`Art 75d test on` MEANS Date 2 8 2026
`Art 75d test before` MEANS Date 1 8 2026

#ASSERT `Art 75d(1) Article 18 of Regulation (EU) 2019/1020 applies mutatis mutandis to the operator` `Art 75d test on` TRUE EQUALS JUST TRUE
#ASSERT `Art 75d(1) Article 18 of Regulation (EU) 2019/1020 applies mutatis mutandis to the operator` `Art 75d test on` FALSE EQUALS NOTHING
#ASSERT `Art 75d(1) Article 18 of Regulation (EU) 2019/1020 applies mutatis mutandis to the operator` `Art 75d test before` TRUE EQUALS NOTHING
#ASSERT `Art 75d(2) first sentence the rights of defence and of access to the file of the operator are fully respected in proceedings` `Art 75d test on` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 75d(2) first sentence the rights of defence and of access to the file of the operator are fully respected in proceedings` `Art 75d test on` FALSE TRUE EQUALS NOTHING
#ASSERT `Art 75d(2) first sentence the rights of defence and of access to the file of the operator are fully respected in proceedings` `Art 75d test on` TRUE FALSE EQUALS NOTHING
#ASSERT `Art 75d(2) first sentence the rights of defence and of access to the file of the operator are fully respected in proceedings` `Art 75d test before` TRUE TRUE EQUALS NOTHING
-- EXPECT FULFILLED
#TRACE `Art 75d(2) first sentence the AI Office's duty to respect the rights of defence and of access to the file` `Art 75d test on` TRUE TRUE AT (Day (Date 3 8 2026)) WITH
    PARTY `Arts 72 to 79 party AI Office` DOES `Art 75d(2) respect fully the rights of defence and of access to the file of the operator` AT (Day (Date 4 8 2026))
-- EXPECT RESIDUAL
#TRACE `Art 75d(2) first sentence the AI Office's duty to respect the rights of defence and of access to the file` `Art 75d test on` TRUE TRUE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
-- EXPECT FULFILLED
#TRACE `Art 75d(2) first sentence the AI Office's duty to respect the rights of defence and of access to the file` `Art 75d test on` TRUE FALSE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
-- EXPECT FULFILLED
#TRACE `Art 75d(2) first sentence the AI Office's duty to respect the rights of defence and of access to the file` `Art 75d test on` TRUE TRUE AT (Day (Date 3 8 2026)) WITH
    PARTY `Arts 72 to 79 party AI Office` DOES `Art 75d(2) respect fully the rights of defence and of access to the file of the operator` AT (Day (Date 4 8 2026))
-- EXPECT RESIDUAL
#TRACE `Art 75d(2) first sentence the AI Office's duty to respect the rights of defence and of access to the file` `Art 75d test on` TRUE TRUE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
-- EXPECT FULFILLED
#TRACE `Art 75d(2) first sentence the AI Office's duty to respect the rights of defence and of access to the file` `Art 75d test before` TRUE TRUE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
-- EXPECT FULFILLED
#TRACE `Art 75d(2) first sentence the AI Office's duty to respect the rights of defence and of access to the file` `Art 75d test on` TRUE TRUE AT (Day (Date 3 8 2026)) WITH
    PARTY `Arts 72 to 79 party AI Office` DOES `Art 75d(2) respect fully the rights of defence and of access to the file of the operator` AT (Day (Date 4 8 2026))
-- EXPECT RESIDUAL
#TRACE `Art 75d(2) first sentence the AI Office's duty to respect the rights of defence and of access to the file` `Art 75d test on` TRUE TRUE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
-- EXPECT FULFILLED
#TRACE `Art 75d(2) first sentence the AI Office's duty to respect the rights of defence and of access to the file` `Art 75d test on` FALSE TRUE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
#ASSERT `Art 75d(2) second sentence the operator is entitled to have access to the AI Office file under the terms of a negotiated disclosure` `Art 75d test on` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 75d(2) second sentence the operator is entitled to have access to the AI Office file under the terms of a negotiated disclosure` `Art 75d test on` FALSE TRUE EQUALS NOTHING
#ASSERT `Art 75d(2) second sentence the operator is entitled to have access to the AI Office file under the terms of a negotiated disclosure` `Art 75d test on` TRUE FALSE EQUALS NOTHING
#ASSERT `Art 75d(2) second sentence the operator is entitled to have access to the AI Office file under the terms of a negotiated disclosure` `Art 75d test before` TRUE TRUE EQUALS NOTHING
#ASSERT `Art 75d(2) third sentence the AI Office may adopt decisions setting out the terms of disclosure` `Art 75d test on` TRUE EQUALS JUST TRUE
#ASSERT `Art 75d(2) third sentence the AI Office may adopt decisions setting out the terms of disclosure` `Art 75d test on` FALSE EQUALS JUST FALSE
#ASSERT `Art 75d(2) third sentence the AI Office may adopt decisions setting out the terms of disclosure` `Art 75d test before` TRUE EQUALS NOTHING
-- EXPECT FULFILLED
#TRACE `Art 75d(2) third sentence the AI Office's choice to adopt decisions setting out the terms of disclosure` `Art 75d test on` TRUE AT (Day (Date 3 8 2026)) WITH
    PARTY `Arts 72 to 79 party AI Office` DOES `Art 75d(2) adopt a decision setting out the terms of disclosure` AT (Day (Date 4 8 2026))
-- EXPECT RESIDUAL
#TRACE `Art 75d(2) third sentence the AI Office's choice to adopt decisions setting out the terms of disclosure` `Art 75d test on` TRUE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
-- EXPECT FULFILLED
#TRACE `Art 75d(2) third sentence the AI Office's choice to adopt decisions setting out the terms of disclosure` `Art 75d test on` FALSE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
-- EXPECT FULFILLED
#TRACE `Art 75d(2) third sentence the AI Office's choice to adopt decisions setting out the terms of disclosure` `Art 75d test on` TRUE AT (Day (Date 3 8 2026)) WITH
    PARTY `Arts 72 to 79 party AI Office` DOES `Art 75d(2) adopt a decision setting out the terms of disclosure` AT (Day (Date 4 8 2026))
-- EXPECT RESIDUAL
#TRACE `Art 75d(2) third sentence the AI Office's choice to adopt decisions setting out the terms of disclosure` `Art 75d test on` TRUE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
-- EXPECT FULFILLED
#TRACE `Art 75d(2) third sentence the AI Office's choice to adopt decisions setting out the terms of disclosure` `Art 75d test before` TRUE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
#ASSERT `Art 75d(2) fourth and fifth sentences the right of access to the file is barred from extending to the material` `Art 75d test on` TRUE EQUALS JUST TRUE
#ASSERT `Art 75d(2) fourth and fifth sentences the right of access to the file is barred from extending to the material` `Art 75d test on` FALSE EQUALS NOTHING
#ASSERT `Art 75d(2) fourth and fifth sentences the right of access to the file is barred from extending to the material` `Art 75d test before` TRUE EQUALS NOTHING
-- EXPECT BREACH
#TRACE `Art 75d(2) the operator's bar on obtaining access to the confidential information and internal documents` `Art 75d test on` TRUE AT (Day (Date 3 8 2026)) WITH
    PARTY `Arts 72 to 79 party operator` DOES `Art 75d(2) obtain access to confidential information or internal documents of the AI Office, the Board, competent market surveillance authorities or other public authorities of the Member States` AT (Day (Date 4 8 2026))
-- EXPECT RESIDUAL
#TRACE `Art 75d(2) the operator's bar on obtaining access to the confidential information and internal documents` `Art 75d test on` TRUE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
-- EXPECT FULFILLED
#TRACE `Art 75d(2) the operator's bar on obtaining access to the confidential information and internal documents` `Art 75d test on` FALSE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
-- EXPECT FULFILLED
#TRACE `Art 75d(2) the operator's bar on obtaining access to the confidential information and internal documents` `Art 75d test before` TRUE AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
#ASSERT `Art 75d(2) sixth sentence nothing in the paragraph prevents the AI Office from disclosing and using the information` `Art 75d test on` TRUE EQUALS JUST TRUE
#ASSERT `Art 75d(2) sixth sentence nothing in the paragraph prevents the AI Office from disclosing and using the information` `Art 75d test on` FALSE EQUALS NOTHING
#ASSERT `Art 75d(2) sixth sentence nothing in the paragraph prevents the AI Office from disclosing and using the information` `Art 75d test before` TRUE EQUALS NOTHING
#ASSERT `Art 75d(3) the Commission may adopt implementing acts concerning the practical arrangements for access to the file and the negotiated disclosure of information` `Art 75d test on` EQUALS JUST TRUE
#ASSERT `Art 75d(3) the Commission may adopt implementing acts concerning the practical arrangements for access to the file and the negotiated disclosure of information` `Art 75d test before` EQUALS NOTHING
-- EXPECT FULFILLED
#TRACE `Art 75d(3) the Commission's choice to adopt implementing acts` `Art 75d test on` AT (Day (Date 3 8 2026)) WITH
    PARTY `Arts 72 to 79 party Commission` DOES `Art 75d(3) adopt implementing acts concerning the practical arrangements for access to the file and the negotiated disclosure of information` AT (Day (Date 4 8 2026))
-- EXPECT RESIDUAL
#TRACE `Art 75d(3) the Commission's choice to adopt implementing acts` `Art 75d test on` AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
-- EXPECT FULFILLED
#TRACE `Art 75d(3) the Commission's choice to adopt implementing acts` `Art 75d test before` AT (Day (Date 3 8 2026)) WITH
    WAITUNTIL (Day (Date 31 12 2030))
#ASSERT `Art 75d(4) first sentence the AI Office must publish the decisions it adopts pursuant to Articles 75b and 75c` `Art 75d test on` TRUE EQUALS JUST TRUE
#ASSERT `Art 75d(4) first sentence the AI Office must publish the decisions it adopts pursuant to Articles 75b and 75c` `Art 75d test on` FALSE EQUALS NOTHING
#ASSERT `Art 75d(4) first sentence the AI Office must publish the decisions it adopts pursuant to Articles 75b and 75c` `Art 75d test before` TRUE EQUALS NOTHING
-- EXPECT FULFILLED
#TRACE `Art 75d(4) first sentence the AI Office's duty to publish the decisions` `Art 75d test on` TRUE AT (Day (Date 3 8 2026)) WITH
    PARTY `Arts 72 to 79 party AI Office` DOES `Art 75d(4) publish the decisions adopted pursuant to Articles 75b and 75c` AT (Day (Date 4 8 2026))
-- EXPECT RESIDUAL
#TRACE `Art 75d(4) first sentence the AI Office's duty to publish the decisions` `Art 75d test on` TRUE AT (Day (Date 3 8 2026)) WITH
