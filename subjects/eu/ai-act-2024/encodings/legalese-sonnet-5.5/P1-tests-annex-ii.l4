IMPORT prelude
IMPORT daydate
IMPORT `P1-annex-ii`

-- P1-tests-annex-ii: tests for Annex II. Expected values are the Annex's own words, copied from lines 1703 to 1718 of the consolidated text,
-- and the closed-list rule of Article 5(1)(h)(iii) (an offence not on the list is not one it refers to).

§ `Each entry has the wording of the Annex`

-- line 1703 of the text
#ASSERT `Annex II the wording of the entry` `Annex II 1 terrorism` EQUALS JUST "terrorism"
-- line 1704 of the text
#ASSERT `Annex II the wording of the entry` `Annex II 2 trafficking in human beings` EQUALS JUST "trafficking in human beings"
-- line 1705 of the text
#ASSERT `Annex II the wording of the entry` `Annex II 3 sexual exploitation of children, and child pornography` EQUALS JUST "sexual exploitation of children, and child pornography"
-- line 1706 of the text
#ASSERT `Annex II the wording of the entry` `Annex II 4 illicit trafficking in narcotic drugs or psychotropic substances` EQUALS JUST "illicit trafficking in narcotic drugs or psychotropic substances"
-- line 1707 of the text
#ASSERT `Annex II the wording of the entry` `Annex II 5 illicit trafficking in weapons, munitions or explosives` EQUALS JUST "illicit trafficking in weapons, munitions or explosives"
-- line 1708 of the text
#ASSERT `Annex II the wording of the entry` `Annex II 6 murder, grievous bodily injury` EQUALS JUST "murder, grievous bodily injury"
-- line 1709 of the text
#ASSERT `Annex II the wording of the entry` `Annex II 7 illicit trade in human organs or tissue` EQUALS JUST "illicit trade in human organs or tissue"
-- line 1710 of the text
#ASSERT `Annex II the wording of the entry` `Annex II 8 illicit trafficking in nuclear or radioactive materials` EQUALS JUST "illicit trafficking in nuclear or radioactive materials"
-- line 1711 of the text
#ASSERT `Annex II the wording of the entry` `Annex II 9 kidnapping, illegal restraint or hostage-taking` EQUALS JUST "kidnapping, illegal restraint or hostage-taking"
-- line 1712 of the text
#ASSERT `Annex II the wording of the entry` `Annex II 10 crimes within the jurisdiction of the International Criminal Court` EQUALS JUST "crimes within the jurisdiction of the International Criminal Court"
-- line 1713 of the text
#ASSERT `Annex II the wording of the entry` `Annex II 11 unlawful seizure of aircraft or ships` EQUALS JUST "unlawful seizure of aircraft or ships"
-- line 1714 of the text
#ASSERT `Annex II the wording of the entry` `Annex II 12 rape` EQUALS JUST "rape"
-- line 1715 of the text
#ASSERT `Annex II the wording of the entry` `Annex II 13 environmental crime` EQUALS JUST "environmental crime"
-- line 1716 of the text
#ASSERT `Annex II the wording of the entry` `Annex II 14 organised or armed robbery` EQUALS JUST "organised or armed robbery"
-- line 1717 of the text
#ASSERT `Annex II the wording of the entry` `Annex II 15 sabotage` EQUALS JUST "sabotage"
-- line 1718 of the text
#ASSERT `Annex II the wording of the entry` `Annex II 16 participation in a criminal organisation involved in one or more of the offences listed above` EQUALS JUST "participation in a criminal organisation involved in one or more of the offences listed above"
-- An offence the Annex does not name has no wording (NOTHING-kind, silent).
#ASSERT `Annex II the wording of the entry` `Annex II no listed offence` EQUALS NOTHING

§ `The offence is listed`

#ASSERT `Annex II the offence is listed` `Annex II 1 terrorism` FALSE
#ASSERT `Annex II the offence is listed` `Annex II 2 trafficking in human beings` FALSE
#ASSERT `Annex II the offence is listed` `Annex II 3 sexual exploitation of children, and child pornography` FALSE
#ASSERT `Annex II the offence is listed` `Annex II 4 illicit trafficking in narcotic drugs or psychotropic substances` FALSE
#ASSERT `Annex II the offence is listed` `Annex II 5 illicit trafficking in weapons, munitions or explosives` FALSE
#ASSERT `Annex II the offence is listed` `Annex II 6 murder, grievous bodily injury` FALSE
#ASSERT `Annex II the offence is listed` `Annex II 7 illicit trade in human organs or tissue` FALSE
#ASSERT `Annex II the offence is listed` `Annex II 8 illicit trafficking in nuclear or radioactive materials` FALSE
#ASSERT `Annex II the offence is listed` `Annex II 9 kidnapping, illegal restraint or hostage-taking` FALSE
#ASSERT `Annex II the offence is listed` `Annex II 10 crimes within the jurisdiction of the International Criminal Court` FALSE
#ASSERT `Annex II the offence is listed` `Annex II 11 unlawful seizure of aircraft or ships` FALSE
#ASSERT `Annex II the offence is listed` `Annex II 12 rape` FALSE
#ASSERT `Annex II the offence is listed` `Annex II 13 environmental crime` FALSE
#ASSERT `Annex II the offence is listed` `Annex II 14 organised or armed robbery` FALSE
#ASSERT `Annex II the offence is listed` `Annex II 15 sabotage` FALSE
-- Entries 1 to 15 are listed whether or not the organisation fact is stated: that fact matters only for entry 16.
#ASSERT `Annex II the offence is listed` `Annex II 1 terrorism` TRUE
-- Entry 16 is listed only where the organisation is involved in one or more of the offences listed above.
#ASSERT `Annex II the offence is listed` `Annex II 16 participation in a criminal organisation involved in one or more of the offences listed above` TRUE
#ASSERT NOT (`Annex II the offence is listed` `Annex II 16 participation in a criminal organisation involved in one or more of the offences listed above` FALSE)
-- An offence the Annex does not name is not listed (FALSE-kind: the class is handed to the list).
#ASSERT NOT (`Annex II the offence is listed` `Annex II no listed offence` TRUE)
#ASSERT NOT (`Annex II the offence is listed` `Annex II no listed offence` FALSE)
