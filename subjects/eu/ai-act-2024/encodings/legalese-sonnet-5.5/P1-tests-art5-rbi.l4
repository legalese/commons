IMPORT prelude
IMPORT daydate
IMPORT `aia-core`
IMPORT `aia-timeline`
IMPORT `P1-art5`
IMPORT `P1-art5-rbi`

-- P1-tests-art5-rbi: tests for Article 5(2) to (8). Expected values come from the text (consolidated text lines 202 to 212), one case per element, per threshold and per branch.
-- Dates: Article 5 applies from 2 February 2025 (Article 113 third paragraph, point (a)); the text of these paragraphs is the same as enacted and as amended (27 July 2026).

§ `Article 5(2): only to confirm the identity`
-- the use only confirms the identity of the specifically targeted individual
#ASSERT `Art 5(2) the use satisfies the limit of being deployed only to confirm the identity of the specifically targeted individual` (Date 3 2 2025) TRUE TRUE TRUE EQUALS JUST TRUE
-- the use goes beyond confirming the identity: 'only to confirm'
#ASSERT `Art 5(2) the use satisfies the limit of being deployed only to confirm the identity of the specifically targeted individual` (Date 3 2 2025) TRUE TRUE FALSE EQUALS JUST FALSE
-- not a use of that kind: not covered
#ASSERT `Art 5(2) the use satisfies the limit of being deployed only to confirm the identity of the specifically targeted individual` (Date 3 2 2025) FALSE TRUE TRUE EQUALS NOTHING
-- not for one of the objectives of point (h): not covered
#ASSERT `Art 5(2) the use satisfies the limit of being deployed only to confirm the identity of the specifically targeted individual` (Date 3 2 2025) TRUE FALSE TRUE EQUALS NOTHING
-- the day before Article 5 applies (1 February 2025)
#ASSERT `Art 5(2) the use satisfies the limit of being deployed only to confirm the identity of the specifically targeted individual` (Date 1 2 2025) TRUE TRUE TRUE EQUALS NOTHING
-- the first day Article 5 applies (2 February 2025)
#ASSERT `Art 5(2) the use satisfies the limit of being deployed only to confirm the identity of the specifically targeted individual` (Date 2 2 2025) TRUE TRUE TRUE EQUALS JUST TRUE
-- under the Omnibus text (27 July 2026) the paragraph is unchanged
#ASSERT `Art 5(2) the use satisfies the limit of being deployed only to confirm the identity of the specifically targeted individual` (Date 27 7 2026) TRUE TRUE FALSE EQUALS JUST FALSE

§ `Article 5(2): the conditions for being authorised`
-- impact assessment completed and system registered
#ASSERT `Art 5(2) the use satisfies the conditions for being authorised` (Date 3 2 2025) TRUE TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- registered but no fundamental rights impact assessment: 'only if'
#ASSERT `Art 5(2) the use satisfies the conditions for being authorised` (Date 3 2 2025) TRUE TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
-- assessment completed, not registered, no urgency: 'only if'
#ASSERT `Art 5(2) the use satisfies the conditions for being authorised` (Date 3 2 2025) TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- not registered, but a duly justified case of urgency and registration completed without undue delay
#ASSERT `Art 5(2) the use satisfies the conditions for being authorised` (Date 3 2 2025) TRUE TRUE TRUE FALSE TRUE TRUE EQUALS JUST TRUE
-- urgency, but registration is not completed without undue delay: 'provided that'
#ASSERT `Art 5(2) the use satisfies the conditions for being authorised` (Date 3 2 2025) TRUE TRUE TRUE FALSE TRUE FALSE EQUALS JUST FALSE
-- urgency lets the registration wait, not the impact assessment
#ASSERT `Art 5(2) the use satisfies the conditions for being authorised` (Date 3 2 2025) TRUE TRUE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
-- not a use of that kind: not covered
#ASSERT `Art 5(2) the use satisfies the conditions for being authorised` (Date 3 2 2025) FALSE TRUE TRUE TRUE FALSE FALSE EQUALS NOTHING
-- not for one of the objectives of point (h): not covered
#ASSERT `Art 5(2) the use satisfies the conditions for being authorised` (Date 3 2 2025) TRUE FALSE TRUE TRUE FALSE FALSE EQUALS NOTHING
-- before Article 5 applies
#ASSERT `Art 5(2) the use satisfies the conditions for being authorised` (Date 1 2 2025) TRUE TRUE TRUE TRUE FALSE FALSE EQUALS NOTHING

§ `Article 5(3): may the use be commenced`
-- a prior authorisation has been granted
#ASSERT `Art 5(3) the use may be commenced` (Date 3 2 2025) TRUE TRUE FALSE FALSE 0 EQUALS JUST TRUE
-- urgency, requested without undue delay, within 24 hours: 24 hours is inside the limit
#ASSERT `Art 5(3) the use may be commenced` (Date 3 2 2025) TRUE FALSE TRUE TRUE 24 EQUALS JUST TRUE
-- urgency, requested after 23 hours
#ASSERT `Art 5(3) the use may be commenced` (Date 3 2 2025) TRUE FALSE TRUE TRUE 23 EQUALS JUST TRUE
-- urgency, requested after 25 hours: 'at the latest within 24 hours'
#ASSERT `Art 5(3) the use may be commenced` (Date 3 2 2025) TRUE FALSE TRUE TRUE 25 EQUALS JUST FALSE
-- urgency, but the authorisation is not requested without undue delay: 'provided that'
#ASSERT `Art 5(3) the use may be commenced` (Date 3 2 2025) TRUE FALSE TRUE FALSE 2 EQUALS JUST FALSE
-- no authorisation and no urgency: 'shall be subject to a prior authorisation'
#ASSERT `Art 5(3) the use may be commenced` (Date 3 2 2025) TRUE FALSE FALSE TRUE 2 EQUALS JUST FALSE
-- not a use of that kind: not covered
#ASSERT `Art 5(3) the use may be commenced` (Date 3 2 2025) FALSE FALSE FALSE FALSE 0 EQUALS NOTHING
-- before Article 5 applies
#ASSERT `Art 5(3) the use may be commenced` (Date 1 2 2025) TRUE TRUE FALSE FALSE 0 EQUALS NOTHING

§ `Article 5(3): stop and delete after a rejection`
-- the authorisation is rejected
#ASSERT `Art 5(3) the use must be stopped and the data discarded and deleted` (Date 3 2 2025) TRUE TRUE EQUALS JUST TRUE
-- the authorisation is not rejected: 'If such authorisation is rejected'
#ASSERT `Art 5(3) the use must be stopped and the data discarded and deleted` (Date 3 2 2025) TRUE FALSE EQUALS JUST FALSE
-- the use did not start in urgency without an authorisation: the sentence is not about it
#ASSERT `Art 5(3) the use must be stopped and the data discarded and deleted` (Date 3 2 2025) FALSE TRUE EQUALS NOTHING
-- before Article 5 applies
#ASSERT `Art 5(3) the use must be stopped and the data discarded and deleted` (Date 1 2 2025) TRUE TRUE EQUALS NOTHING

§ `Article 5(3): the authority grants only where satisfied`
-- satisfied on objective evidence, and limited to what is strictly necessary
#ASSERT `Art 5(3) the authority may grant the authorisation` (Date 3 2 2025) TRUE TRUE TRUE EQUALS JUST TRUE
-- not satisfied: 'only where it is satisfied'
#ASSERT `Art 5(3) the authority may grant the authorisation` (Date 3 2 2025) TRUE FALSE TRUE EQUALS JUST FALSE
-- not limited to what is strictly necessary as to period, geographic and personal scope
#ASSERT `Art 5(3) the authority may grant the authorisation` (Date 3 2 2025) TRUE TRUE FALSE EQUALS JUST FALSE
-- not a use of that kind: not covered
#ASSERT `Art 5(3) the authority may grant the authorisation` (Date 3 2 2025) FALSE TRUE TRUE EQUALS NOTHING
-- before Article 5 applies
#ASSERT `Art 5(3) the authority may grant the authorisation` (Date 1 2 2025) TRUE TRUE TRUE EQUALS NOTHING

§ `Article 5(3): no decision on the output alone`
-- adverse legal effect, based solely on the output
#ASSERT `Art 5(3) the decision is barred because it produces an adverse legal effect and rests solely on the output` (Date 3 2 2025) TRUE TRUE EQUALS JUST TRUE
-- a human also took other material into account: the bar does not speak of it
#ASSERT `Art 5(3) the decision is barred because it produces an adverse legal effect and rests solely on the output` (Date 3 2 2025) TRUE FALSE EQUALS NOTHING
-- no adverse legal effect: the bar does not speak of it
#ASSERT `Art 5(3) the decision is barred because it produces an adverse legal effect and rests solely on the output` (Date 3 2 2025) FALSE TRUE EQUALS NOTHING
-- before Article 5 applies
#ASSERT `Art 5(3) the decision is barred because it produces an adverse legal effect and rests solely on the output` (Date 1 2 2025) TRUE TRUE EQUALS NOTHING

§ `Article 5(5): may the Member State provide for the possibility`
-- within the limits and under the conditions of point (h) and paragraphs 2 and 3
#ASSERT `Art 5(5) the Member State may provide for the possibility to authorise the use` (Date 3 2 2025) TRUE TRUE EQUALS JUST TRUE
-- outside the limits and conditions: not covered, not forbidden by this sentence
#ASSERT `Art 5(5) the Member State may provide for the possibility to authorise the use` (Date 3 2 2025) TRUE FALSE EQUALS NOTHING
-- not a use of that kind: not covered
#ASSERT `Art 5(5) the Member State may provide for the possibility to authorise the use` (Date 3 2 2025) FALSE TRUE EQUALS NOTHING
-- before Article 5 applies
#ASSERT `Art 5(5) the Member State may provide for the possibility to authorise the use` (Date 1 2 2025) TRUE TRUE EQUALS NOTHING
-- in accordance with Union law
#ASSERT `Art 5(5) the Member State may introduce more restrictive laws on the use of remote biometric identification systems` (Date 3 2 2025) TRUE EQUALS JUST TRUE
-- not in accordance with Union law: outside the power, not forbidden by this sentence
#ASSERT `Art 5(5) the Member State may introduce more restrictive laws on the use of remote biometric identification systems` (Date 3 2 2025) FALSE EQUALS NOTHING
-- before Article 5 applies
#ASSERT `Art 5(5) the Member State may introduce more restrictive laws on the use of remote biometric identification systems` (Date 1 2 2025) TRUE EQUALS NOTHING

§ `Article 5(7): no sensitive operational data in the reports`
-- the report includes sensitive operational data of the related law enforcement activities
#ASSERT `Art 5(7) the report is barred from including sensitive operational data` (Date 3 2 2025) TRUE EQUALS JUST TRUE
-- no such data in the report
#ASSERT `Art 5(7) the report is barred from including sensitive operational data` (Date 3 2 2025) FALSE EQUALS NOTHING
-- before Article 5 applies
#ASSERT `Art 5(7) the report is barred from including sensitive operational data` (Date 1 2 2025) TRUE EQUALS NOTHING

§ `Article 5(8): other Union law`
-- the practice infringes other Union law: 'shall not affect'
#ASSERT `Art 5(8) Article 5 affects the prohibitions that apply under other Union law` (Date 3 2 2025) TRUE EQUALS JUST FALSE
-- the practice does not infringe other Union law: the sentence is silent
#ASSERT `Art 5(8) Article 5 affects the prohibitions that apply under other Union law` (Date 3 2 2025) FALSE EQUALS NOTHING
-- before Article 5 applies
#ASSERT `Art 5(8) Article 5 affects the prohibitions that apply under other Union law` (Date 1 2 2025) TRUE EQUALS NOTHING

§ `Article 5(2) and (4): the scope questions`
-- a use of that kind for one of the objectives of point (h)
#ASSERT `Art 5(2) the use must take the elements into account and comply with the safeguards and conditions of national law` (Date 3 2 2025) TRUE TRUE EQUALS JUST TRUE
-- not for one of the objectives: not covered
#ASSERT `Art 5(2) the use must take the elements into account and comply with the safeguards and conditions of national law` (Date 3 2 2025) TRUE FALSE EQUALS NOTHING
-- not a use of that kind: not covered
#ASSERT `Art 5(2) the use must take the elements into account and comply with the safeguards and conditions of national law` (Date 3 2 2025) FALSE TRUE EQUALS NOTHING
-- before Article 5 applies
#ASSERT `Art 5(2) the use must take the elements into account and comply with the safeguards and conditions of national law` (Date 1 2 2025) TRUE TRUE EQUALS NOTHING
-- each use of that kind shall be notified
#ASSERT `Art 5(4) the use must be notified to the market surveillance authority and the data protection authority` (Date 3 2 2025) TRUE EQUALS JUST TRUE
-- not a use of that kind: not covered
#ASSERT `Art 5(4) the use must be notified to the market surveillance authority and the data protection authority` (Date 3 2 2025) FALSE EQUALS NOTHING
-- before Article 5 applies
#ASSERT `Art 5(4) the use must be notified to the market surveillance authority and the data protection authority` (Date 1 2 2025) TRUE EQUALS NOTHING
-- the notification of each use of that kind shall not include sensitive operational data
#ASSERT `Art 5(4) the notification is barred from including sensitive operational data` (Date 3 2 2025) TRUE EQUALS JUST TRUE
-- not a use of that kind: not covered
#ASSERT `Art 5(4) the notification is barred from including sensitive operational data` (Date 3 2 2025) FALSE EQUALS NOTHING
-- before Article 5 applies
#ASSERT `Art 5(4) the notification is barred from including sensitive operational data` (Date 1 2 2025) TRUE EQUALS NOTHING

§ `The rules: traces`
-- Rules with a clock: Article 5(3) 24 hours (1 day), Article 5(3) immediate effect (0 days), Article 5(5) 30 days; the prohibition of Article 5(4).
-- EXPECT FULFILLED (requested on the day after the use commenced: 1 day)
#TRACE `Art 5(3) the duty to request the authorisation after commencing the use in a situation of urgency` (Date 3 2 2025) TRUE AT 0 WITH
    PARTY Operator DOES `Art 5(3) request the authorisation without undue delay` AT 1
-- EXPECT BREACH (requested two days after)
#TRACE `Art 5(3) the duty to request the authorisation after commencing the use in a situation of urgency` (Date 3 2 2025) TRUE AT 0 WITH
    PARTY Operator DOES `Art 5(3) request the authorisation without undue delay` AT 2
-- EXPECT FULFILLED (not a use that began in urgency without authorisation: nothing owed)
#TRACE `Art 5(3) the duty to request the authorisation after commencing the use in a situation of urgency` (Date 3 2 2025) FALSE AT 0 WITH
    WAITUNTIL 400
-- EXPECT FULFILLED (before Article 5 applies: nothing owed)
#TRACE `Art 5(3) the duty to request the authorisation after commencing the use in a situation of urgency` (Date 1 2 2025) TRUE AT 0 WITH
    WAITUNTIL 400
-- EXPECT FULFILLED (stopped at once)
#TRACE `Art 5(3) the duty to stop the use and discard and delete the data` (Date 3 2 2025) TRUE TRUE AT 0 WITH
    PARTY Operator DOES `Art 5(3) stop the use and discard and delete the data, the results and the outputs` AT 0
-- EXPECT BREACH (stopped a day later: 'immediate effect')
#TRACE `Art 5(3) the duty to stop the use and discard and delete the data` (Date 3 2 2025) TRUE TRUE AT 0 WITH
    PARTY Operator DOES `Art 5(3) stop the use and discard and delete the data, the results and the outputs` AT 1
-- EXPECT FULFILLED (authorisation not rejected: nothing owed)
#TRACE `Art 5(3) the duty to stop the use and discard and delete the data` (Date 3 2 2025) TRUE FALSE AT 0 WITH
    WAITUNTIL 400
-- EXPECT FULFILLED (notified on the 30th day after adoption)
#TRACE `Art 5(5) the duty of the Member State to notify the national rules to the Commission` (Date 3 2 2025) TRUE AT 0 WITH
    PARTY Operator DOES `Art 5(5) notify the national rules to the Commission` AT 30
-- EXPECT BREACH (notified on the 31st day)
#TRACE `Art 5(5) the duty of the Member State to notify the national rules to the Commission` (Date 3 2 2025) TRUE AT 0 WITH
    PARTY Operator DOES `Art 5(5) notify the national rules to the Commission` AT 31
-- EXPECT FULFILLED (no rules adopted: nothing owed)
#TRACE `Art 5(5) the duty of the Member State to notify the national rules to the Commission` (Date 3 2 2025) FALSE AT 0 WITH
    WAITUNTIL 400
-- EXPECT BREACH (sensitive operational data included in the notification)
#TRACE `Art 5(4) the prohibition on including sensitive operational data in the notification` (Date 3 2 2025) TRUE AT 0 WITH
    PARTY Operator DOES `Art 5(4) include sensitive operational data in the notification` AT 3
-- EXPECT FULFILLED (no use of that kind: nothing owed)
#TRACE `Art 5(4) the prohibition on including sensitive operational data in the notification` (Date 3 2 2025) FALSE AT 0 WITH
    PARTY Operator DOES `Art 5(4) include sensitive operational data in the notification` AT 3
-- EXPECT the duty stays on the party (MUST), the time passes and nothing breaches it: the rules with no breach path
#TRACE `Art 5(2) the duty to take into account the nature of the situation and the consequences of the use` (Date 3 2 2025) TRUE TRUE AT 0 WITH
    WAITUNTIL 4000
#TRACE `Art 5(2) the duty to comply with the safeguards and conditions of the national law authorising the use` (Date 3 2 2025) TRUE TRUE AT 0 WITH
    WAITUNTIL 4000
#TRACE `Art 5(3) the duty of the authority to take into account the elements referred to in paragraph 2` (Date 3 2 2025) TRUE AT 0 WITH
    WAITUNTIL 4000
#TRACE `Art 5(4) the duty to notify the use to the market surveillance authority and the data protection authority` (Date 3 2 2025) TRUE AT 0 WITH
    WAITUNTIL 4000
#TRACE `Art 5(4) the duty to include in the notification the information specified under paragraph 6` (Date 3 2 2025) TRUE AT 0 WITH
    WAITUNTIL 4000
#TRACE `Art 5(5) the duty of the Member State to lay down the detailed rules in national law` (Date 3 2 2025) TRUE AT 0 WITH
    WAITUNTIL 4000
#TRACE `Art 5(6) the duty of the authority to submit annual reports to the Commission` (Date 3 2 2025) TRUE AT 0 WITH
    WAITUNTIL 4000
#TRACE `Art 5(6) the duty of the Commission to provide a template` (Date 3 2 2025) AT 0 WITH
    WAITUNTIL 4000
#TRACE `Art 5(7) the duty of the Commission to publish annual reports` (Date 3 2 2025) AT 0 WITH
    WAITUNTIL 4000
-- EXPECT FULFILLED (before Article 5 applies: nothing owed)
#TRACE `Art 5(7) the duty of the Commission to publish annual reports` (Date 1 2 2025) AT 0 WITH
    WAITUNTIL 400
