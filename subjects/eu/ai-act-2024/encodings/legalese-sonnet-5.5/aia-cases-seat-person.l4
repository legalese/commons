#ASSERT `Under Article 5, as a person affected by an AI system, is the AI practice used on me prohibited by Article 5(1)(f) (inferring emotions in the workplace and education institutions)` (Date 3 2 2025) TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- medical or safety reasons: 'except where'
#ASSERT `Under Article 5, as a person affected by an AI system, is the AI practice used on me prohibited by Article 5(1)(f) (inferring emotions in the workplace and education institutions)` (Date 3 2 2025) TRUE TRUE FALSE TRUE EQUALS JUST FALSE
-- neither the workplace nor education: not covered
#ASSERT `Under Article 5, as a person affected by an AI system, is the AI practice used on me prohibited by Article 5(1)(f) (inferring emotions in the workplace and education institutions)` (Date 3 2 2025) TRUE FALSE FALSE FALSE EQUALS NOTHING

-- Under Article 5, as a person affected by an AI system, is the AI practice used on me prohibited by Article 5(1)(g) (biometric categorisation to infer race, political opinions, trade union membership, religious or philosophical beliefs, sex life or sexual orientation)?
-- the facts of point (g)
#ASSERT `Under Article 5, as a person affected by an AI system, is the AI practice used on me prohibited by Article 5(1)(g) (biometric categorisation to infer race, political opinions, trade union membership, religious or philosophical beliefs, sex life or sexual orientation)` (Date 3 2 2025) TRUE TRUE FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- labelling or filtering of lawfully acquired datasets: 'does not cover'
#ASSERT `Under Article 5, as a person affected by an AI system, is the AI practice used on me prohibited by Article 5(1)(g) (biometric categorisation to infer race, political opinions, trade union membership, religious or philosophical beliefs, sex life or sexual orientation)` (Date 3 2 2025) TRUE TRUE FALSE FALSE TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- not categorising for the listed characteristics: not covered
#ASSERT `Under Article 5, as a person affected by an AI system, is the AI practice used on me prohibited by Article 5(1)(g) (biometric categorisation to infer race, political opinions, trade union membership, religious or philosophical beliefs, sex life or sexual orientation)` (Date 3 2 2025) TRUE TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- ancillary to another commercial service and strictly necessary for objective technical reasons: excluded from the definition of a biometric categorisation system (Article 3(40)): not covered
#ASSERT `Under Article 5, as a person affected by an AI system, is the AI practice used on me prohibited by Article 5(1)(g) (biometric categorisation to infer race, political opinions, trade union membership, religious or philosophical beliefs, sex life or sexual orientation)` (Date 3 2 2025) TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- ancillary to another commercial service but not strictly necessary: still a biometric categorisation system, through the definition's own facts
#ASSERT `Under Article 5, as a person affected by an AI system, is the AI practice used on me prohibited by Article 5(1)(g) (biometric categorisation to infer race, political opinions, trade union membership, religious or philosophical beliefs, sex life or sexual orientation)` (Date 3 2 2025) TRUE TRUE TRUE FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- not for the purpose of assigning natural persons to specific categories: not a biometric categorisation system: not covered
#ASSERT `Under Article 5, as a person affected by an AI system, is the AI practice used on me prohibited by Article 5(1)(g) (biometric categorisation to infer race, political opinions, trade union membership, religious or philosophical beliefs, sex life or sexual orientation)` (Date 3 2 2025) FALSE TRUE FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- categorising biometric data in the area of law enforcement: 'does not cover'
#ASSERT `Under Article 5, as a person affected by an AI system, is the AI practice used on me prohibited by Article 5(1)(g) (biometric categorisation to infer race, political opinions, trade union membership, religious or philosophical beliefs, sex life or sexual orientation)` (Date 3 2 2025) TRUE TRUE FALSE FALSE TRUE TRUE TRUE TRUE TRUE FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- the dataset does not relate to physical, physiological or behavioural characteristics, so it is not biometric data (Article 3(34)): the labelling carve-out does not apply
#ASSERT `Under Article 5, as a person affected by an AI system, is the AI practice used on me prohibited by Article 5(1)(g) (biometric categorisation to infer race, political opinions, trade union membership, religious or philosophical beliefs, sex life or sexual orientation)` (Date 3 2 2025) TRUE TRUE FALSE FALSE TRUE TRUE TRUE TRUE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE

-- Under Article 5, as a person affected by an AI system, is the AI practice used on me prohibited by Article 5(1)(h) ('real-time' remote biometric identification in publicly accessible spaces for law enforcement)?
-- a real-time remote biometric identification use for law enforcement, no objective of the exception
-- MIRROR: the same facts are asked in P1-cases-seat-deployer.l4 (the deployer's question on the same provision), and the answers agree
#ASSERT `Under Article 5, as a person affected by an AI system, is the AI practice used on me prohibited by Article 5(1)(h) ('real-time' remote biometric identification in publicly accessible spaces for law enforcement)` (Date 3 2 2025) TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE 0 EQUALS JUST TRUE
-- strictly necessary for the targeted search for victims: 'unless'
#ASSERT `Under Article 5, as a person affected by an AI system, is the AI practice used on me prohibited by Article 5(1)(h) ('real-time' remote biometric identification in publicly accessible spaces for law enforcement)` (Date 3 2 2025) TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE 0 EQUALS JUST FALSE
-- objective (iii), an Annex II offence, three years: below the four-year threshold
#ASSERT `Under Article 5, as a person affected by an AI system, is the AI practice used on me prohibited by Article 5(1)(h) ('real-time' remote biometric identification in publicly accessible spaces for law enforcement)` (Date 3 2 2025) TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE TRUE TRUE 3 EQUALS JUST TRUE
-- objective (iii), an Annex II offence, four years
#ASSERT `Under Article 5, as a person affected by an AI system, is the AI practice used on me prohibited by Article 5(1)(h) ('real-time' remote biometric identification in publicly accessible spaces for law enforcement)` (Date 3 2 2025) TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE TRUE TRUE 4 EQUALS JUST FALSE
-- not in a publicly accessible space: not covered
#ASSERT `Under Article 5, as a person affected by an AI system, is the AI practice used on me prohibited by Article 5(1)(h) ('real-time' remote biometric identification in publicly accessible spaces for law enforcement)` (Date 3 2 2025) TRUE TRUE TRUE TRUE FALSE FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE 0 EQUALS NOTHING
-- a post-remote system: the capturing and the identification do not occur without a significant delay, so it is not a 'real-time' remote biometric identification system (Article 3(42)): not covered
#ASSERT `Under Article 5, as a person affected by an AI system, is the AI practice used on me prohibited by Article 5(1)(h) ('real-time' remote biometric identification in publicly accessible spaces for law enforcement)` (Date 3 2 2025) TRUE TRUE TRUE FALSE TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE 0 EQUALS NOTHING
-- not identifying natural persons by comparison with a reference database, so not a remote biometric identification system (Article 3(41)): not covered
#ASSERT `Under Article 5, as a person affected by an AI system, is the AI practice used on me prohibited by Article 5(1)(h) ('real-time' remote biometric identification in publicly accessible spaces for law enforcement)` (Date 3 2 2025) TRUE TRUE FALSE TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE 0 EQUALS NOTHING
-- the place is not accessible to an undetermined number of natural persons, so not a publicly accessible space (Article 3(44)): not covered
#ASSERT `Under Article 5, as a person affected by an AI system, is the AI practice used on me prohibited by Article 5(1)(h) ('real-time' remote biometric identification in publicly accessible spaces for law enforcement)` (Date 3 2 2025) TRUE TRUE TRUE TRUE TRUE FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE 0 EQUALS NOTHING
-- the use is carried out only on behalf of law enforcement authorities: law enforcement through the 'on behalf of' limb of Article 3(46)
#ASSERT `Under Article 5, as a person affected by an AI system, is the AI practice used on me prohibited by Article 5(1)(h) ('real-time' remote biometric identification in publicly accessible spaces for law enforcement)` (Date 3 2 2025) TRUE TRUE TRUE TRUE TRUE TRUE FALSE TRUE TRUE FALSE FALSE FALSE FALSE 0 EQUALS JUST TRUE
-- the use is not for the prevention, investigation, detection or prosecution of criminal offences: not law enforcement (Article 3(46)): not covered
#ASSERT `Under Article 5, as a person affected by an AI system, is the AI practice used on me prohibited by Article 5(1)(h) ('real-time' remote biometric identification in publicly accessible spaces for law enforcement)` (Date 3 2 2025) TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE 0 EQUALS NOTHING

