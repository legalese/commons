IMPORT prelude
IMPORT daydate
IMPORT `aia-core`
IMPORT `aia-timeline`
IMPORT `P7-gates`

-- P7-tests-gates: tests for P7-gates. Every expected value is written from the text beside the assertion, never copied from the output.
-- Each assertion is on one line; NOTHING is "not covered".

-- The two gates: a day before, the day of, and a year after each date of application.
-- Group General: from 2 August 2026 (Art 113 second paragraph). Group of Chapter VII: from 2 August 2025 (Art 113(b)).
#ASSERT NOT (`Art 57 the group General applies on the date asked` (Date 1 8 2026))
#ASSERT `Art 57 the group General applies on the date asked` (Date 2 8 2026)
#ASSERT `Art 57 the group General applies on the date asked` (Date 2 8 2027)
#ASSERT NOT (`Art 64 the group of Chapter VII applies on the date asked` (Date 1 8 2025))
#ASSERT `Art 64 the group of Chapter VII applies on the date asked` (Date 2 8 2025)
#ASSERT `Art 64 the group of Chapter VII applies on the date asked` (Date 2 8 2027)
-- The Regulation as amended (from 27 July 2026) does not change the group of Chapter VII, so it applies on both sides of that day.
#ASSERT `Art 64 the group of Chapter VII applies on the date asked` (Date 26 7 2026)
#ASSERT `Art 64 the group of Chapter VII applies on the date asked` (Date 27 7 2026)
-- Group General is not yet in force on either side of 27 July 2026.
#ASSERT NOT (`Art 57 the group General applies on the date asked` (Date 26 7 2026))
#ASSERT NOT (`Art 57 the group General applies on the date asked` (Date 27 7 2026))
-- Seam S14, a call to the keel's Art 2(2). Article 2(2) as amended: for a high-risk AI system under Article 6(1) related to Section B products "only Article 6(1), Article 60a and Articles 102 to 112 shall apply.
-- Articles 57, 58 and 59 shall apply only in so far as the requirements for high-risk AI systems under this Regulation have been integrated in that Union harmonisation legislation."
-- args: date asked, route, Section B products, requirements integrated, Article number, letter, paragraph
#ASSERT NOT (`Art 57 Article 2(2) leaves the provision to apply` (Date 2 8 2026) `Route Article 6(1) and Annex I` TRUE FALSE 60 "" 1)
#ASSERT NOT (`Art 57 Article 2(2) leaves the provision to apply` (Date 2 8 2026) `Route Article 6(1) and Annex I` TRUE TRUE 60 "" 1)
#ASSERT `Art 57 Article 2(2) leaves the provision to apply` (Date 2 8 2026) `Route Article 6(1) and Annex I` TRUE FALSE 60 "a" 1
#ASSERT NOT (`Art 57 Article 2(2) leaves the provision to apply` (Date 2 8 2026) `Route Article 6(1) and Annex I` TRUE FALSE 57 "" 7)
#ASSERT `Art 57 Article 2(2) leaves the provision to apply` (Date 2 8 2026) `Route Article 6(1) and Annex I` TRUE TRUE 57 "" 7
#ASSERT NOT (`Art 57 Article 2(2) leaves the provision to apply` (Date 2 8 2026) `Route Article 6(1) and Annex I` TRUE FALSE 58 "" 2)
#ASSERT `Art 57 Article 2(2) leaves the provision to apply` (Date 2 8 2026) `Route Article 6(1) and Annex I` TRUE TRUE 58 "" 2
#ASSERT NOT (`Art 57 Article 2(2) leaves the provision to apply` (Date 2 8 2026) `Route Article 6(1) and Annex I` TRUE FALSE 59 "" 1)
#ASSERT `Art 57 Article 2(2) leaves the provision to apply` (Date 2 8 2026) `Route Article 6(1) and Annex I` TRUE TRUE 59 "" 1
-- a system that is not under Article 6(1), or whose products are not Section B products, is not spoken to by Article 2(2): the provision answers for itself
#ASSERT `Art 57 Article 2(2) leaves the provision to apply` (Date 2 8 2026) `Route Article 6(2) and Annex III` TRUE FALSE 60 "" 1
#ASSERT `Art 57 Article 2(2) leaves the provision to apply` (Date 2 8 2026) `Route Article 6(1) and Annex I` FALSE FALSE 60 "" 1
#ASSERT `Art 57 Article 2(2) leaves the provision to apply` (Date 2 8 2026) `Route neither` FALSE FALSE 57 "" 7
-- the text as enacted (a date before 27 July 2026): "only Article 6(1), Articles 102 to 109 and Article 112 apply. Article 57 applies only in so far as the requirements ... have been integrated"
#ASSERT `Art 57 Article 2(2) leaves the provision to apply` (Date 26 7 2026) `Route Article 6(1) and Annex I` TRUE TRUE 57 "" 7
#ASSERT NOT (`Art 57 Article 2(2) leaves the provision to apply` (Date 26 7 2026) `Route Article 6(1) and Annex I` TRUE TRUE 58 "" 2)
#ASSERT NOT (`Art 57 Article 2(2) leaves the provision to apply` (Date 26 7 2026) `Route Article 6(1) and Annex I` TRUE TRUE 60 "a" 1)
