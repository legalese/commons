#ASSERT `Art 71(6) the Commission is the controller of the EU database` (Date 1 8 2026) TRUE EQUALS NOTHING
#ASSERT `Art 71(6) the Commission is the controller of the EU database` (Date 2 8 2026) TRUE EQUALS JUST TRUE
#ASSERT `Art 71(6) the Commission is the controller of the EU database` (Date 2 8 2026) FALSE EQUALS JUST FALSE
