IMPORT prelude
IMPORT daydate
IMPORT `aia-core`
IMPORT `aia-timeline`
IMPORT `P7-database`

-- P7-tests-database: tests for P7-database. Every expected value is written from the text beside the assertion, never copied from the output.
-- Each assertion is on one line; NOTHING is "not covered".

-- 71(1) a
#ASSERT `Art 71(1) the Commission has set up and maintained an EU database in collaboration with the Member States` (Date 1 8 2026) TRUE TRUE EQUALS NOTHING
#ASSERT `Art 71(1) the Commission has set up and maintained an EU database in collaboration with the Member States` (Date 2 8 2026) TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 71(1) the Commission has set up and maintained an EU database in collaboration with the Member States` (Date 2 8 2026) FALSE TRUE EQUALS JUST FALSE
#ASSERT `Art 71(1) the Commission has set up and maintained an EU database in collaboration with the Member States` (Date 2 8 2026) TRUE FALSE EQUALS JUST FALSE
-- Art 71(1): Annex III systems registered under Articles 49 or 60, and systems taken out of high-risk by Article 6(3) and registered under Article 6(4) and Article 49
-- args: date asked, route, registered under Art 49, testing registered under Art 60, not high-risk under Art 6(3), registered under Art 6(4)
#ASSERT `Art 71(1) the EU database contains information concerning the AI system` (Date 1 8 2026) `Route Article 6(2) and Annex III` TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `Art 71(1) the EU database contains information concerning the AI system` (Date 2 8 2026) `Route Article 6(2) and Annex III` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Art 71(1) the EU database contains information concerning the AI system` (Date 2 8 2026) `Route Article 6(2) and Annex III` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Art 71(1) the EU database contains information concerning the AI system` (Date 2 8 2026) `Route Article 6(2) and Annex III` FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `Art 71(1) the EU database contains information concerning the AI system` (Date 2 8 2026) `Route Article 6(1) and Annex I` TRUE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `Art 71(1) the EU database contains information concerning the AI system` (Date 2 8 2026) `Route neither` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 71(1) the EU database contains information concerning the AI system` (Date 2 8 2026) `Route neither` TRUE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `Art 71(1) the EU database contains information concerning the AI system` (Date 2 8 2026) `Route neither` FALSE FALSE TRUE TRUE EQUALS NOTHING
-- 71(1) c
#ASSERT `Art 71(1) the Commission has consulted the relevant experts when setting the functional specifications of the database` (Date 1 8 2026) TRUE TRUE EQUALS NOTHING
#ASSERT `Art 71(1) the Commission has consulted the relevant experts when setting the functional specifications of the database` (Date 2 8 2026) TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 71(1) the Commission has consulted the relevant experts when setting the functional specifications of the database` (Date 2 8 2026) TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 71(1) the Commission has consulted the relevant experts when setting the functional specifications of the database` (Date 2 8 2026) FALSE TRUE EQUALS NOTHING
-- 71(1) d
#ASSERT `Art 71(1) the Commission has consulted the Board when updating the functional specifications of the database` (Date 1 8 2026) TRUE TRUE EQUALS NOTHING
#ASSERT `Art 71(1) the Commission has consulted the Board when updating the functional specifications of the database` (Date 2 8 2026) TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 71(1) the Commission has consulted the Board when updating the functional specifications of the database` (Date 2 8 2026) TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 71(1) the Commission has consulted the Board when updating the functional specifications of the database` (Date 2 8 2026) FALSE TRUE EQUALS NOTHING
-- 71(2)
#ASSERT `Art 71(2) the data listed in Sections A and B of Annex VIII have been entered into the EU database` (Date 1 8 2026) TRUE TRUE EQUALS NOTHING
#ASSERT `Art 71(2) the data listed in Sections A and B of Annex VIII have been entered into the EU database` (Date 2 8 2026) TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 71(2) the data listed in Sections A and B of Annex VIII have been entered into the EU database` (Date 2 8 2026) FALSE FALSE EQUALS JUST FALSE
-- 71(3)
#ASSERT `Art 71(3) the data listed in Section C of Annex VIII have been entered into the EU database by the deployer` (Date 1 8 2026) TRUE TRUE EQUALS NOTHING
#ASSERT `Art 71(3) the data listed in Section C of Annex VIII have been entered into the EU database by the deployer` (Date 2 8 2026) TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 71(3) the data listed in Section C of Annex VIII have been entered into the EU database by the deployer` (Date 2 8 2026) TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 71(3) the data listed in Section C of Annex VIII have been entered into the EU database by the deployer` (Date 2 8 2026) FALSE TRUE EQUALS NOTHING
-- 71(4) a
#ASSERT `Art 71(4) the information registered in accordance with Article 49 is accessible and publicly available in a user-friendly manner` (Date 1 8 2026) TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `Art 71(4) the information registered in accordance with Article 49 is accessible and publicly available in a user-friendly manner` (Date 2 8 2026) TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 71(4) the information registered in accordance with Article 49 is accessible and publicly available in a user-friendly manner` (Date 2 8 2026) TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Art 71(4) the information registered in accordance with Article 49 is accessible and publicly available in a user-friendly manner` (Date 2 8 2026) TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Art 71(4) the information registered in accordance with Article 49 is accessible and publicly available in a user-friendly manner` (Date 2 8 2026) TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 71(4) the information registered in accordance with Article 49 is accessible and publicly available in a user-friendly manner` (Date 2 8 2026) FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `Art 71(4) the information registered in accordance with Article 49 is accessible and publicly available in a user-friendly manner` (Date 2 8 2026) TRUE FALSE TRUE TRUE TRUE EQUALS NOTHING
-- 71(4) b
#ASSERT `Art 71(4) the information is easily navigable and machine-readable` (Date 1 8 2026) TRUE TRUE EQUALS NOTHING
#ASSERT `Art 71(4) the information is easily navigable and machine-readable` (Date 2 8 2026) TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 71(4) the information is easily navigable and machine-readable` (Date 2 8 2026) FALSE TRUE EQUALS NOTHING
#ASSERT `Art 71(4) the information is easily navigable and machine-readable` (Date 2 8 2026) TRUE FALSE EQUALS NOTHING
-- Art 71(4): "accessible only to market surveillance authorities and the Commission, unless the prospective provider or provider has given consent"
-- args: date asked, the person is a market surveillance authority, the person is the Commission, consent to public access
#ASSERT `Art 71(4) the person may access the information registered in accordance with Article 60` (Date 2 8 2026) TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Art 71(4) the person may access the information registered in accordance with Article 60` (Date 2 8 2026) FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Art 71(4) the person may access the information registered in accordance with Article 60` (Date 2 8 2026) FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 71(4) the person may access the information registered in accordance with Article 60` (Date 2 8 2026) FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Art 71(4) the person may access the information registered in accordance with Article 60` (Date 1 8 2026) FALSE FALSE FALSE EQUALS NOTHING
-- 71(5) a
#ASSERT `Art 71(5) the EU database contains personal data only in so far as necessary for collecting and processing information in accordance with this Regulation` (Date 1 8 2026) TRUE EQUALS NOTHING
#ASSERT `Art 71(5) the EU database contains personal data only in so far as necessary for collecting and processing information in accordance with this Regulation` (Date 2 8 2026) TRUE EQUALS JUST TRUE
#ASSERT `Art 71(5) the EU database contains personal data only in so far as necessary for collecting and processing information in accordance with this Regulation` (Date 2 8 2026) FALSE EQUALS JUST FALSE
