    WHERE
        `the model` MEANS `AI model` WITH
            `date placed on the market` IS `the date the general-purpose AI model was placed on the market`
            -- Placeholder: this function does not read the compute of the model.
            `cumulative compute used for its training, in floating-point operations` IS 0

