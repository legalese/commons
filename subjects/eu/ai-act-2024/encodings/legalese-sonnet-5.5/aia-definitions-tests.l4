IMPORT prelude
IMPORT daydate
IMPORT `aia-core`
IMPORT `aia-timeline`
IMPORT `aia-definitions`

-- Tests of aia-definitions.l4 (Article 3). Every expected value is written by hand from the text of the definition.
-- A definition that says "means" is a conjunction (or a disjunction where the text says "or"): the pattern of the tests is
--   all elements met -> TRUE; one element unmet at a time -> FALSE; and, where the text has an "or", each alternative alone -> TRUE.
-- Argument order is the order of the GIVEN lines in aia-definitions.l4.

§ `(1) AI system: four elements; adaptiveness is not one`

#ASSERT `Art 3(1) the system is an AI system` TRUE TRUE TRUE TRUE
#ASSERT NOT (`Art 3(1) the system is an AI system` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`Art 3(1) the system is an AI system` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`Art 3(1) the system is an AI system` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`Art 3(1) the system is an AI system` TRUE TRUE TRUE FALSE)

§ `(2) Risk: the two parts, kept apart`

#ASSERT (`Art 3(2) the risk is the combination of probability and severity` 0.2 3)'s `probability of an occurrence of harm` EQUALS 0.2
#ASSERT (`Art 3(2) the risk is the combination of probability and severity` 0.2 3)'s `severity of that harm` EQUALS 3

§ `(3) Provider: develops or has developed, and places or puts into service, under its own name`

-- args: develops, has developed, places on the market or puts into service, under its own name or trademark
#ASSERT `Art 3(3) the party is a provider` TRUE FALSE TRUE TRUE
#ASSERT `Art 3(3) the party is a provider` FALSE TRUE TRUE TRUE
#ASSERT NOT (`Art 3(3) the party is a provider` FALSE FALSE TRUE TRUE)
#ASSERT NOT (`Art 3(3) the party is a provider` TRUE FALSE FALSE TRUE)
#ASSERT NOT (`Art 3(3) the party is a provider` TRUE FALSE TRUE FALSE)
-- fork F-3-3: a developer that has not placed anything on the market under its name is not a provider on the reading taken.
#ASSERT NOT (`Art 3(3) the party is a provider` TRUE TRUE FALSE FALSE)

§ `(4) Deployer: uses under its authority, except in a personal non-professional activity`

-- args: uses an AI system under its authority, the use is in the course of a personal non-professional activity
#ASSERT `Art 3(4) the party is a deployer` TRUE FALSE
#ASSERT NOT (`Art 3(4) the party is a deployer` FALSE FALSE)
#ASSERT NOT (`Art 3(4) the party is a deployer` TRUE TRUE)
#ASSERT NOT (`Art 3(4) the party is a deployer` FALSE TRUE)

§ `(5) Authorised representative: in the Union, with a written mandate to act for the provider`

-- args: place, mandate received and accepted, mandate is to perform the obligations
#ASSERT `Art 3(5) the party is an authorised representative` `Established or located in the Union` TRUE TRUE
#ASSERT NOT (`Art 3(5) the party is an authorised representative` `Established or located in a third country` TRUE TRUE)
#ASSERT NOT (`Art 3(5) the party is an authorised representative` `Established or located in the Union` FALSE TRUE)
#ASSERT NOT (`Art 3(5) the party is an authorised representative` `Established or located in the Union` TRUE FALSE)

§ `(6) Importer: in the Union, places on the market a system bearing a third-country person's name`

-- args: place, places an AI system on the market, the system bears a third-country person's name or trademark
#ASSERT `Art 3(6) the party is an importer` `Established or located in the Union` TRUE TRUE
#ASSERT NOT (`Art 3(6) the party is an importer` `Established or located in a third country` TRUE TRUE)
#ASSERT NOT (`Art 3(6) the party is an importer` `Established or located in the Union` FALSE TRUE)
#ASSERT NOT (`Art 3(6) the party is an importer` `Established or located in the Union` TRUE FALSE)

§ `(7) Distributor: in the supply chain, other than the provider or the importer, makes available on the Union market`

-- args: in the supply chain, is the provider, is the importer, makes the AI system available on the Union market
#ASSERT `Art 3(7) the party is a distributor` TRUE FALSE FALSE TRUE
#ASSERT NOT (`Art 3(7) the party is a distributor` FALSE FALSE FALSE TRUE)
#ASSERT NOT (`Art 3(7) the party is a distributor` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`Art 3(7) the party is a distributor` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`Art 3(7) the party is a distributor` TRUE FALSE FALSE FALSE)

§ `(8) Operator: the six roles, and not a notified body or an affected person`

#ASSERT `Art 3(8) the role is an operator` Provider
#ASSERT `Art 3(8) the role is an operator` `Product manufacturer`
#ASSERT `Art 3(8) the role is an operator` Deployer
#ASSERT `Art 3(8) the role is an operator` `Authorised representative`
#ASSERT `Art 3(8) the role is an operator` Importer
#ASSERT `Art 3(8) the role is an operator` Distributor
#ASSERT `Art 3(8) the role is an operator` Operator
#ASSERT NOT (`Art 3(8) the role is an operator` `Notified body`)
#ASSERT NOT (`Art 3(8) the role is an operator` `Affected person`)

§ `(9) Placing on the market: the first making available`

-- args: the supply is a making available on the Union market, it is the first
#ASSERT `Art 3(9) the supply is a placing on the market` TRUE TRUE
#ASSERT NOT (`Art 3(9) the supply is a placing on the market` TRUE FALSE)
#ASSERT NOT (`Art 3(9) the supply is a placing on the market` FALSE TRUE)

§ `(10) Making available on the market: supply for distribution or use, in the course of a commercial activity`

#ASSERT `Art 3(10) the supply is a making available on the market` TRUE TRUE
#ASSERT NOT (`Art 3(10) the supply is a making available on the market` TRUE FALSE)
#ASSERT NOT (`Art 3(10) the supply is a making available on the market` FALSE TRUE)

§ `(11) Putting into service: first use, directly to the deployer or for own use, for the intended purpose`

-- args: supply for first use, directly to the deployer, for own use in the Union, first use is for the intended purpose
#ASSERT `Art 3(11) the supply is a putting into service` TRUE TRUE FALSE TRUE
#ASSERT `Art 3(11) the supply is a putting into service` TRUE FALSE TRUE TRUE
#ASSERT NOT (`Art 3(11) the supply is a putting into service` TRUE FALSE FALSE TRUE)
#ASSERT NOT (`Art 3(11) the supply is a putting into service` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`Art 3(11) the supply is a putting into service` TRUE TRUE TRUE FALSE)

§ `(12) Intended purpose: the use the provider intends, specified in any of the named sources`

-- args: the use is the one the provider intends, in the instructions for use, in promotional or sales materials, in the technical documentation
#ASSERT `Art 3(12) the use is the intended purpose` TRUE TRUE FALSE FALSE
#ASSERT `Art 3(12) the use is the intended purpose` TRUE FALSE TRUE FALSE
#ASSERT `Art 3(12) the use is the intended purpose` TRUE FALSE FALSE TRUE
#ASSERT NOT (`Art 3(12) the use is the intended purpose` TRUE FALSE FALSE FALSE)
#ASSERT NOT (`Art 3(12) the use is the intended purpose` FALSE TRUE TRUE TRUE)

§ `(13) Reasonably foreseeable misuse`

#ASSERT `Art 3(13) the use is a reasonably foreseeable misuse` TRUE TRUE
#ASSERT NOT (`Art 3(13) the use is a reasonably foreseeable misuse` FALSE TRUE)
#ASSERT NOT (`Art 3(13) the use is a reasonably foreseeable misuse` TRUE FALSE)

§ `(14) Safety component: a case on each side of 27 July 2026 (the Omnibus replaced the text)`

-- args: the date asked, is a component of a product or AI system, fulfils a safety function, failure endangers health and safety, intended purpose is to prevent or mitigate risk
-- Fulfils a safety function by some other route, intended purpose not to prevent or mitigate risk: TRUE as enacted, FALSE as amended.
#ASSERT `Art 3(14) the component is a safety component` (Date 26 7 2026) TRUE TRUE FALSE FALSE
#ASSERT NOT (`Art 3(14) the component is a safety component` (Date 27 7 2026) TRUE TRUE FALSE FALSE)
-- Intended purpose is to prevent or mitigate risk, not otherwise said to fulfil a safety function: FALSE as enacted, TRUE as amended.
#ASSERT NOT (`Art 3(14) the component is a safety component` (Date 26 7 2026) TRUE FALSE FALSE TRUE)
#ASSERT `Art 3(14) the component is a safety component` (Date 27 7 2026) TRUE FALSE FALSE TRUE
-- Failure or malfunctioning endangers health and safety: TRUE in both texts.
#ASSERT `Art 3(14) the component is a safety component` (Date 26 7 2026) TRUE FALSE TRUE FALSE
#ASSERT `Art 3(14) the component is a safety component` (Date 27 7 2026) TRUE FALSE TRUE FALSE
-- Not a component of a product or of an AI system: FALSE in both.
#ASSERT NOT (`Art 3(14) the component is a safety component` (Date 26 7 2026) FALSE TRUE TRUE TRUE)
#ASSERT NOT (`Art 3(14) the component is a safety component` (Date 27 7 2026) FALSE TRUE TRUE TRUE)
-- None of the three: FALSE in both.
#ASSERT NOT (`Art 3(14) the component is a safety component` (Date 26 7 2026) TRUE FALSE FALSE FALSE)
#ASSERT NOT (`Art 3(14) the component is a safety component` (Date 27 7 2026) TRUE FALSE FALSE FALSE)

§ `(14a) and (14b): inserted by the Omnibus, so there is no text as enacted`

#ASSERT `Art 3(14a) the enterprise is a micro, small and medium-sized enterprise` (Date 26 7 2026) TRUE EQUALS NOTHING
#ASSERT `Art 3(14a) the enterprise is a micro, small and medium-sized enterprise` (Date 27 7 2026) TRUE EQUALS JUST TRUE
#ASSERT `Art 3(14a) the enterprise is a micro, small and medium-sized enterprise` (Date 27 7 2026) FALSE EQUALS JUST FALSE
#ASSERT `Art 3(14b) the enterprise is a small mid-cap enterprise` (Date 26 7 2026) TRUE EQUALS NOTHING
#ASSERT `Art 3(14b) the enterprise is a small mid-cap enterprise` (Date 27 7 2026) TRUE EQUALS JUST TRUE
#ASSERT `Art 3(14b) the enterprise is a small mid-cap enterprise` (Date 27 7 2026) FALSE EQUALS JUST FALSE

