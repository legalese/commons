IMPORT prelude
IMPORT daydate
IMPORT `aia-core`
IMPORT `aia-timeline`
IMPORT `P8-gate`

-- Tests of P8-gate: each helper agrees with the keel's applicability function (the expected values are
-- the dates of Art 113 as the keel gives them: General from 2 August 2026, the group of Article 78 from 2 August 2025).

`the Annex III route` MEANS `Route Article 6(2) and Annex III`

-- General: the day before, the day of, and after 2 August 2026 (Art 113 second paragraph).
#ASSERT NOT (`Arts 72 to 79 the group General applies on the date asked` (Date 1 8 2026))
#ASSERT `Arts 72 to 79 the group General applies on the date asked` (Date 2 8 2026)
#ASSERT `Arts 72 to 79 the group General applies on the date asked` (Date 3 8 2026)
-- A system placed on the market before 2 December 2027 under Annex III and unchanged is saved by Art 111(2) as amended.
#ASSERT NOT (`Arts 72 to 79 the group General applies to the AI system` (Date 3 8 2026) `the Annex III route` (Date 1 1 2026) FALSE)
#ASSERT `Arts 72 to 79 the group General applies to the AI system` (Date 3 8 2026) `the Annex III route` (Date 1 1 2026) TRUE
#ASSERT `Arts 72 to 79 the group General applies to the AI system` (Date 3 8 2026) `the Annex III route` (Date 3 12 2027) FALSE
-- Article 78 applies from 2 August 2025 (Art 113 third paragraph point (b)).
#ASSERT NOT (`Art 78 the group of Article 78 applies on the date asked` (Date 1 8 2025))
#ASSERT `Art 78 the group of Article 78 applies on the date asked` (Date 2 8 2025)
#ASSERT `Art 78 the group of Article 78 applies to the AI system` (Date 2 8 2025) `Route neither` (Date 1 1 2020) FALSE
-- The classification seam: high-risk by either route, not high-risk by neither.
#ASSERT `Arts 72 to 79 the AI system is a high-risk AI system` `Route Article 6(1) and Annex I`
#ASSERT `Arts 72 to 79 the AI system is a high-risk AI system` `Route Article 6(2) and Annex III`
#ASSERT NOT (`Arts 72 to 79 the AI system is a high-risk AI system` `Route neither`)

-- Seam S14: the helper answers TRUE only where the keel's Art 2(2) answers JUST FALSE for the provision.
-- (The keel's Art 2(2) begins to apply with Chapter I on 2 February 2025; the date asked below is after it unless said.)
#ASSERT `Arts 72 to 79 Article 2(2) cuts off the provision` (Date 3 8 2026) `Route Article 6(1) and Annex I` TRUE TRUE 72 1
-- the integration fact matters to Articles 57 to 59 only, so it does not move the answer for a provision of this part
#ASSERT `Arts 72 to 79 Article 2(2) cuts off the provision` (Date 3 8 2026) `Route Article 6(1) and Annex I` TRUE FALSE 79 2
#ASSERT `Arts 72 to 79 Article 2(2) cuts off the provision` (Date 3 8 2026) `Route Article 6(1) and Annex I` TRUE FALSE 74 12
-- not that route: Article 2(2) does not speak
#ASSERT NOT (`Arts 72 to 79 Article 2(2) cuts off the provision` (Date 3 8 2026) `Route Article 6(2) and Annex III` TRUE TRUE 72 1)
#ASSERT NOT (`Arts 72 to 79 Article 2(2) cuts off the provision` (Date 3 8 2026) `Route neither` TRUE TRUE 72 1)
-- products not covered by Section B: Article 2(2) does not speak
#ASSERT NOT (`Arts 72 to 79 Article 2(2) cuts off the provision` (Date 3 8 2026) `Route Article 6(1) and Annex I` FALSE TRUE 72 1)
-- before Chapter I applies (2 February 2025) the keel answers NOTHING, so the helper does not cut off
#ASSERT NOT (`Arts 72 to 79 Article 2(2) cuts off the provision` (Date 1 8 2024) `Route Article 6(1) and Annex I` TRUE TRUE 72 1)
#ASSERT `Arts 72 to 79 Article 2(2) cuts off the provision` (Date 3 2 2025) `Route Article 6(1) and Annex I` TRUE TRUE 78 1
