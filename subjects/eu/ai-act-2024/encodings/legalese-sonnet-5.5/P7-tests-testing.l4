#ASSERT `Art 60(1) as amended the provider may conduct testing in real world conditions outside the sandboxes` `Route Article 6(1) and Annex I` FALSE TRUE EQUALS NOTHING
#ASSERT `Art 60(1) as amended the provider may conduct testing in real world conditions outside the sandboxes` `Route Article 6(1) and Annex I` TRUE FALSE EQUALS NOTHING
#ASSERT `Art 60(1) as amended the provider may conduct testing in real world conditions outside the sandboxes` `Route neither` TRUE TRUE EQUALS NOTHING
