-- solely non-safety aspects: 'shall not qualify as safety components'
#ASSERT `Under Article 6, as a product manufacturer, is my AI system high-risk under Article 6(1) with Annex I` (Date 2 8 2028) (Date 2 8 2028) FALSE TRUE TRUE FALSE TRUE TRUE FALSE FALSE `Annex I item 11 Regulation (EU) 2017/745` FALSE TRUE FALSE EQUALS JUST FALSE
-- no third-party conformity assessment
#ASSERT `Under Article 6, as a product manufacturer, is my AI system high-risk under Article 6(1) with Annex I` (Date 2 8 2028) (Date 2 8 2028) FALSE TRUE TRUE FALSE TRUE FALSE FALSE FALSE `Annex I item 11 Regulation (EU) 2017/745` FALSE FALSE FALSE EQUALS JUST FALSE
-- a safety component only through its intended purpose to prevent or mitigate risks, as amended (Article 3(14)): the definition's own facts
#ASSERT `Under Article 6, as a product manufacturer, is my AI system high-risk under Article 6(1) with Annex I` (Date 2 8 2028) (Date 2 8 2028) FALSE TRUE FALSE FALSE TRUE FALSE FALSE FALSE `Annex I item 11 Regulation (EU) 2017/745` FALSE TRUE FALSE EQUALS JUST TRUE
-- a safety component only because its failure would endanger health and safety (Article 3(14))
#ASSERT `Under Article 6, as a product manufacturer, is my AI system high-risk under Article 6(1) with Annex I` (Date 2 8 2028) (Date 2 8 2028) FALSE TRUE FALSE TRUE FALSE FALSE FALSE FALSE `Annex I item 11 Regulation (EU) 2017/745` FALSE TRUE FALSE EQUALS JUST TRUE
-- the part is not a component of a product or of an AI system, so not a safety component (Article 3(14)), and the AI system is not itself a product
#ASSERT `Under Article 6, as a product manufacturer, is my AI system high-risk under Article 6(1) with Annex I` (Date 2 8 2028) (Date 2 8 2028) FALSE FALSE TRUE FALSE TRUE FALSE FALSE FALSE `Annex I item 11 Regulation (EU) 2017/745` FALSE TRUE FALSE EQUALS JUST FALSE

-- Under Article 6, as a product manufacturer, does my AI system qualify as a safety component under Article 6(1a) and (1b)?
-- intended as a safety component, nothing excludes it
#ASSERT `Under Article 6, as a product manufacturer, does my AI system qualify as a safety component under Article 6(1a) and (1b)` (Date 2 8 2028) TRUE TRUE FALSE TRUE FALSE FALSE
-- solely non-safety aspects: 'shall not qualify'
#ASSERT NOT (`Under Article 6, as a product manufacturer, does my AI system qualify as a safety component under Article 6(1a) and (1b)` (Date 2 8 2028) TRUE TRUE FALSE TRUE TRUE FALSE)
-- failure would endanger health and safety: 'shall qualify'
#ASSERT `Under Article 6, as a product manufacturer, does my AI system qualify as a safety component under Article 6(1a) and (1b)` (Date 2 8 2028) FALSE FALSE FALSE FALSE FALSE TRUE
-- a safety component only through its intended purpose (Article 3(14)): the definition's own facts
#ASSERT `Under Article 6, as a product manufacturer, does my AI system qualify as a safety component under Article 6(1a) and (1b)` (Date 2 8 2028) TRUE FALSE FALSE TRUE FALSE FALSE
-- the part is not a component of a product or of an AI system and its failure would not endanger health and safety: not a safety component (Article 3(14))
#ASSERT NOT (`Under Article 6, as a product manufacturer, does my AI system qualify as a safety component under Article 6(1a) and (1b)` (Date 2 8 2028) FALSE TRUE FALSE TRUE FALSE FALSE)

-- Under Article 6, as a product manufacturer, does my product fulfil the condition of Article 6(1), point (b), given why a third-party conformity assessment is required?
