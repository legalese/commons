#ASSERT `Under Article 6, as a product manufacturer, does my product fulfil the condition of Article 6(1), point (b), given why a third-party conformity assessment is required` TRUE FALSE
-- required solely for other risks: 'shall not be considered as fulfilling'
#ASSERT NOT (`Under Article 6, as a product manufacturer, does my product fulfil the condition of Article 6(1), point (b), given why a third-party conformity assessment is required` TRUE TRUE)

