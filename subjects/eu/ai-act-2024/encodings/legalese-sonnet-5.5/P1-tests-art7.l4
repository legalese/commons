IMPORT prelude
IMPORT daydate
IMPORT `aia-core`
IMPORT `aia-timeline`
IMPORT `P1-art7`

-- P1-tests-art7: tests for Article 7 (consolidated text lines 242 to 261). Chapter III Sections 1 to 3 apply from 2 December 2027 on the Annex III route.

§ `Article 7(1)`
-- both conditions fulfilled
#ASSERT `Art 7(1) the Commission may adopt delegated acts adding or modifying use-cases of high-risk AI systems` (Date 2 12 2027) TRUE TRUE TRUE EQUALS JUST TRUE
-- not in an area listed in Annex III
#ASSERT `Art 7(1) the Commission may adopt delegated acts adding or modifying use-cases of high-risk AI systems` (Date 2 12 2027) FALSE TRUE TRUE EQUALS JUST FALSE
-- no risk of harm or adverse impact
#ASSERT `Art 7(1) the Commission may adopt delegated acts adding or modifying use-cases of high-risk AI systems` (Date 2 12 2027) TRUE FALSE TRUE EQUALS JUST FALSE
-- the risk is lower than that of the systems already in Annex III
#ASSERT `Art 7(1) the Commission may adopt delegated acts adding or modifying use-cases of high-risk AI systems` (Date 2 12 2027) TRUE TRUE FALSE EQUALS JUST FALSE
-- the day before Chapter III applies
#ASSERT `Art 7(1) the Commission may adopt delegated acts adding or modifying use-cases of high-risk AI systems` (Date 1 12 2027) TRUE TRUE TRUE EQUALS NOTHING
-- before the Omnibus: the text as enacted gave Chapter III an earlier date that never arrived
#ASSERT `Art 7(1) the Commission may adopt delegated acts adding or modifying use-cases of high-risk AI systems` (Date 26 7 2026) TRUE TRUE TRUE EQUALS NOTHING

§ `Article 7(2): the eleven criteria`
-- all of the criteria (a) to (k) taken into account
#ASSERT `Art 7(2) the Commission has taken all the criteria into account` (Date 2 12 2027) TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- criterion (a) not taken into account
#ASSERT `Art 7(2) the Commission has taken all the criteria into account` (Date 2 12 2027) FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- criterion (b) not taken into account
#ASSERT `Art 7(2) the Commission has taken all the criteria into account` (Date 2 12 2027) TRUE FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- criterion (c) not taken into account
#ASSERT `Art 7(2) the Commission has taken all the criteria into account` (Date 2 12 2027) TRUE TRUE FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- criterion (d) not taken into account
#ASSERT `Art 7(2) the Commission has taken all the criteria into account` (Date 2 12 2027) TRUE TRUE TRUE FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- criterion (e) not taken into account
#ASSERT `Art 7(2) the Commission has taken all the criteria into account` (Date 2 12 2027) TRUE TRUE TRUE TRUE FALSE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- criterion (f) not taken into account
#ASSERT `Art 7(2) the Commission has taken all the criteria into account` (Date 2 12 2027) TRUE TRUE TRUE TRUE TRUE FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- criterion (g) not taken into account
#ASSERT `Art 7(2) the Commission has taken all the criteria into account` (Date 2 12 2027) TRUE TRUE TRUE TRUE TRUE TRUE FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- criterion (h) not taken into account
#ASSERT `Art 7(2) the Commission has taken all the criteria into account` (Date 2 12 2027) TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
-- criterion (i) not taken into account
#ASSERT `Art 7(2) the Commission has taken all the criteria into account` (Date 2 12 2027) TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
-- criterion (j) not taken into account
#ASSERT `Art 7(2) the Commission has taken all the criteria into account` (Date 2 12 2027) TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
-- criterion (k) not taken into account
#ASSERT `Art 7(2) the Commission has taken all the criteria into account` (Date 2 12 2027) TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- the day before Chapter III applies
#ASSERT `Art 7(2) the Commission has taken all the criteria into account` (Date 1 12 2027) TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING

§ `Article 7(3)`
-- both conditions fulfilled
#ASSERT `Art 7(3) the Commission may adopt delegated acts removing high-risk AI systems from the list in Annex III` (Date 2 12 2027) TRUE TRUE EQUALS JUST TRUE
-- the system still poses a significant risk
#ASSERT `Art 7(3) the Commission may adopt delegated acts removing high-risk AI systems from the list in Annex III` (Date 2 12 2027) FALSE TRUE EQUALS JUST FALSE
-- the deletion decreases the overall level of protection
#ASSERT `Art 7(3) the Commission may adopt delegated acts removing high-risk AI systems from the list in Annex III` (Date 2 12 2027) TRUE FALSE EQUALS JUST FALSE
-- the day before Chapter III applies
#ASSERT `Art 7(3) the Commission may adopt delegated acts removing high-risk AI systems from the list in Annex III` (Date 1 12 2027) TRUE TRUE EQUALS NOTHING

§ `The rule: no breach path`
-- EXPECT the duty stays on the Commission (no time limit and no stated consequence)
#TRACE `Art 7(2) the duty of the Commission to take the criteria into account` (Date 2 12 2027) AT 0 WITH
    WAITUNTIL 4000
-- EXPECT FULFILLED (taken into account)
#TRACE `Art 7(2) the duty of the Commission to take the criteria into account` (Date 2 12 2027) AT 0 WITH
    PARTY Operator DOES `Art 7(2) take into account the criteria` AT 5
-- EXPECT FULFILLED (before Chapter III applies: nothing owed)
#TRACE `Art 7(2) the duty of the Commission to take the criteria into account` (Date 1 12 2027) AT 0 WITH
    WAITUNTIL 4000
