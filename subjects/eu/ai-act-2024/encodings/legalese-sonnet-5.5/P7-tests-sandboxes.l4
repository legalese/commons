IMPORT prelude
IMPORT daydate
IMPORT `aia-core`
IMPORT `aia-timeline`
IMPORT `P7-sandboxes`

-- P7-tests-sandboxes: tests for P7-sandboxes. Every expected value is written from the text beside the assertion, never copied from the output.
-- Each assertion is on one line; NOTHING is "not covered".

-- Art 57(1) first subparagraph, third sentence (line 848): the Commission may provide technical support, advice and tools
#ASSERT `Art 57(1) the Commission may provide technical support, advice and tools` (Date 1 8 2026) TRUE EQUALS NOTHING
#ASSERT `Art 57(1) the Commission may provide technical support, advice and tools` (Date 2 8 2026) TRUE EQUALS JUST TRUE
#ASSERT `Art 57(1) the Commission may provide technical support, advice and tools` (Date 2 8 2026) FALSE EQUALS NOTHING
-- Art 57(1) second subparagraph (850)
#ASSERT `Art 57(1) second subparagraph the obligation is fulfilled by participation in an existing sandbox` (Date 1 8 2026) TRUE TRUE EQUALS NOTHING
#ASSERT `Art 57(1) second subparagraph the obligation is fulfilled by participation in an existing sandbox` (Date 2 8 2026) TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 57(1) second subparagraph the obligation is fulfilled by participation in an existing sandbox` (Date 2 8 2026) FALSE TRUE EQUALS NOTHING
#ASSERT `Art 57(1) second subparagraph the obligation is fulfilled by participation in an existing sandbox` (Date 2 8 2026) TRUE FALSE EQUALS NOTHING
-- Art 57(2)
#ASSERT `Art 57(2) an additional AI regulatory sandbox may be established` (Date 1 8 2026) TRUE TRUE EQUALS NOTHING
#ASSERT `Art 57(2) an additional AI regulatory sandbox may be established` (Date 2 8 2026) TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 57(2) an additional AI regulatory sandbox may be established` (Date 2 8 2026) FALSE FALSE EQUALS NOTHING
-- Art 57(3a) first sentence (line 855): the AI Office may establish a Union level sandbox
#ASSERT `Art 57(3a) the AI Office may establish an AI regulatory sandbox at Union level` (Date 1 8 2026) TRUE EQUALS NOTHING
#ASSERT `Art 57(3a) the AI Office may establish an AI regulatory sandbox at Union level` (Date 2 8 2026) TRUE EQUALS JUST TRUE
#ASSERT `Art 57(3a) the AI Office may establish an AI regulatory sandbox at Union level` (Date 2 8 2026) FALSE EQUALS NOTHING
-- Art 57(3a) second sentence
#ASSERT `Art 57(3a) the body that a reference to national competent authorities in Chapter VI is read as for the Union level sandbox` (Date 1 8 2026) TRUE TRUE EQUALS NOTHING
#ASSERT `Art 57(3a) the body that a reference to national competent authorities in Chapter VI is read as for the Union level sandbox` (Date 2 8 2026) TRUE TRUE EQUALS JUST "the AI Office"
#ASSERT `Art 57(3a) the body that a reference to national competent authorities in Chapter VI is read as for the Union level sandbox` (Date 2 8 2026) FALSE TRUE EQUALS NOTHING
#ASSERT `Art 57(3a) the body that a reference to national competent authorities in Chapter VI is read as for the Union level sandbox` (Date 2 8 2026) TRUE FALSE EQUALS NOTHING
-- Art 57(3a) third sentence
#ASSERT `Art 57(3a) the Union level sandbox is implemented as the text requires` (Date 1 8 2026) TRUE TRUE EQUALS NOTHING
#ASSERT `Art 57(3a) the Union level sandbox is implemented as the text requires` (Date 2 8 2026) TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 57(3a) the Union level sandbox is implemented as the text requires` (Date 2 8 2026) FALSE TRUE EQUALS JUST FALSE
#ASSERT `Art 57(3a) the Union level sandbox is implemented as the text requires` (Date 2 8 2026) TRUE FALSE EQUALS JUST FALSE
-- Art 57(3a) second subparagraph
#ASSERT `Art 57(3a) the establishment of a Union level sandbox prejudices the competences of Member States` (Date 1 8 2026) TRUE EQUALS NOTHING
#ASSERT `Art 57(3a) the establishment of a Union level sandbox prejudices the competences of Member States` (Date 2 8 2026) TRUE EQUALS JUST FALSE
#ASSERT `Art 57(3a) the establishment of a Union level sandbox prejudices the competences of Member States` (Date 2 8 2026) FALSE EQUALS NOTHING
-- Art 57(1): "which shall be operational by 2 August 2027" (as enacted 2 August 2026): by that date the sandbox is operational or the duty is met by participation (second subparagraph)
-- args: date asked, a national sandbox is operational, fulfilled by participation
-- as enacted: not yet failed on 2 August 2026 itself (by that date), failed from 3 August 2026
#ASSERT `Art 57(1) as enacted the Member State has ensured that a national AI regulatory sandbox is operational` (Date 2 8 2026) FALSE FALSE EQUALS NOTHING
#ASSERT `Art 57(1) as enacted the Member State has ensured that a national AI regulatory sandbox is operational` (Date 3 8 2026) FALSE FALSE EQUALS JUST FALSE
#ASSERT `Art 57(1) as enacted the Member State has ensured that a national AI regulatory sandbox is operational` (Date 3 8 2026) TRUE FALSE EQUALS JUST TRUE
#ASSERT `Art 57(1) as enacted the Member State has ensured that a national AI regulatory sandbox is operational` (Date 3 8 2026) FALSE TRUE EQUALS JUST TRUE
-- as amended: the same, a year later
#ASSERT `Art 57(1) as amended the Member State has ensured that a national AI regulatory sandbox is operational` (Date 3 8 2026) FALSE FALSE EQUALS NOTHING
#ASSERT `Art 57(1) as amended the Member State has ensured that a national AI regulatory sandbox is operational` (Date 2 8 2027) FALSE FALSE EQUALS NOTHING
#ASSERT `Art 57(1) as amended the Member State has ensured that a national AI regulatory sandbox is operational` (Date 3 8 2027) FALSE FALSE EQUALS JUST FALSE
#ASSERT `Art 57(1) as amended the Member State has ensured that a national AI regulatory sandbox is operational` (Date 3 8 2027) TRUE FALSE EQUALS JUST TRUE
#ASSERT `Art 57(1) as amended the Member State has ensured that a national AI regulatory sandbox is operational` (Date 3 8 2027) FALSE TRUE EQUALS JUST TRUE
-- the two texts differ on 3 August 2026 for a Member State with no sandbox: as enacted the duty is already breached, as amended it is not yet due
-- dispatcher: Chapter VI applies from 2 August 2026, and from then the amended text is the text in force, so the as-enacted branch is dead behind the gate
#ASSERT `Art 57(1) the Member State has ensured that a national AI regulatory sandbox is operational` (Date 1 8 2026) FALSE FALSE EQUALS NOTHING
#ASSERT `Art 57(1) the Member State has ensured that a national AI regulatory sandbox is operational` (Date 26 7 2026) FALSE FALSE EQUALS NOTHING
#ASSERT `Art 57(1) the Member State has ensured that a national AI regulatory sandbox is operational` (Date 27 7 2026) FALSE FALSE EQUALS NOTHING
#ASSERT `Art 57(1) the Member State has ensured that a national AI regulatory sandbox is operational` (Date 3 8 2026) FALSE FALSE EQUALS NOTHING
#ASSERT `Art 57(1) the Member State has ensured that a national AI regulatory sandbox is operational` (Date 3 8 2027) FALSE FALSE EQUALS JUST FALSE
#ASSERT `Art 57(1) the Member State has ensured that a national AI regulatory sandbox is operational` (Date 3 8 2027) TRUE FALSE EQUALS JUST TRUE
-- the dates themselves
#ASSERT `Art 57(1) as enacted the date by which a national AI regulatory sandbox must be operational` EQUALS Date 2 8 2026
#ASSERT `Art 57(1) as amended the date by which a national AI regulatory sandbox must be operational` EQUALS Date 2 8 2027
-- Art 57(1) second subparagraph: fulfilled by taking part in an existing sandbox in so far as coverage is equivalent
-- args: date asked, participates in an existing sandbox, equivalent coverage
#ASSERT `Art 57(1) second subparagraph the obligation is fulfilled by participation in an existing sandbox` (Date 1 8 2026) TRUE TRUE EQUALS NOTHING
#ASSERT `Art 57(1) second subparagraph the obligation is fulfilled by participation in an existing sandbox` (Date 2 8 2026) TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 57(1) second subparagraph the obligation is fulfilled by participation in an existing sandbox` (Date 2 8 2026) TRUE FALSE EQUALS NOTHING
#ASSERT `Art 57(1) second subparagraph the obligation is fulfilled by participation in an existing sandbox` (Date 2 8 2026) FALSE TRUE EQUALS NOTHING
-- Art 57(3), the European Data Protection Supervisor. As enacted and as amended it may establish a sandbox for Union institutions, bodies, offices and agencies.
#ASSERT `Art 57(3) as enacted the European Data Protection Supervisor may establish an AI regulatory sandbox` TRUE EQUALS JUST TRUE
#ASSERT `Art 57(3) as enacted the European Data Protection Supervisor may establish an AI regulatory sandbox` FALSE EQUALS NOTHING
#ASSERT `Art 57(3) as amended the European Data Protection Supervisor may establish an AI regulatory sandbox` TRUE EQUALS JUST TRUE
#ASSERT `Art 57(3) as amended the European Data Protection Supervisor may establish an AI regulatory sandbox` FALSE EQUALS NOTHING
-- the wording changed and no answer did: both versions give the same answer
#ASSERT `Art 57(3) as enacted the European Data Protection Supervisor may establish an AI regulatory sandbox` TRUE EQUALS `Art 57(3) as amended the European Data Protection Supervisor may establish an AI regulatory sandbox` TRUE
#ASSERT `Art 57(3) the European Data Protection Supervisor may establish an AI regulatory sandbox` (Date 1 8 2026) TRUE EQUALS NOTHING
#ASSERT `Art 57(3) the European Data Protection Supervisor may establish an AI regulatory sandbox` (Date 2 8 2026) TRUE EQUALS JUST TRUE
#ASSERT `Art 57(3) the European Data Protection Supervisor may establish an AI regulatory sandbox` (Date 2 8 2026) FALSE EQUALS NOTHING
-- the reading rule: as enacted the Supervisor exercises the roles and tasks of the national competent authorities; as amended references to them are construed as references to it
#ASSERT `Art 57(3) as enacted the body whose roles and tasks the European Data Protection Supervisor exercises in the sandbox` TRUE EQUALS JUST "the European Data Protection Supervisor, in the roles and tasks of the national competent authorities"
#ASSERT `Art 57(3) as amended the body that a reference to national competent authorities in Chapter VI is read as` TRUE EQUALS JUST "the European Data Protection Supervisor"
#ASSERT `Art 57(3) as amended the body that a reference to national competent authorities in Chapter VI is read as` FALSE EQUALS NOTHING
#ASSERT `Art 57(3) the body that a reference to national competent authorities in Chapter VI is read as` (Date 2 8 2026) TRUE EQUALS JUST "the European Data Protection Supervisor"
#ASSERT `Art 57(3) the body that a reference to national competent authorities in Chapter VI is read as` (Date 1 8 2026) TRUE EQUALS NOTHING
-- Art 57(3a): inserted by the Omnibus, so only the text as amended; Chapter VI applies from 2 August 2026
-- Art 57(1): the duty and its breach path. The clock is a day number; the duty runs from 2 August 2026 and the date to be met is 2 August 2027 (as amended).
-- EXPECT FULFILLED
#TRACE `Art 57(1) as amended the Member State's duty to have a national AI regulatory sandbox operational` AT (Day (Date 2 8 2026)) WITH
    PARTY `Art 57 Member State` DOES `Art 57(1) have a national AI regulatory sandbox operational` AT (Day (Date 2 8 2027))
-- EXPECT BREACH
#TRACE `Art 57(1) as amended the Member State's duty to have a national AI regulatory sandbox operational` AT (Day (Date 2 8 2026)) WITH
    PARTY `Art 57 Member State` DOES `Art 57(1) have a national AI regulatory sandbox operational` AT (Day (Date 3 8 2027))
-- EXPECT BREACH
#TRACE `Art 57(1) as amended the Member State's duty to have a national AI regulatory sandbox operational` AT (Day (Date 2 8 2026)) WITH
    WAITUNTIL (Day (Date 4 8 2027))
-- as enacted the date was 2 August 2026, the day Chapter VI applies: a sandbox on that day is in time, the day after is late
-- EXPECT FULFILLED
#TRACE `Art 57(1) as enacted the Member State's duty to have a national AI regulatory sandbox operational` AT (Day (Date 2 8 2026)) WITH
    PARTY `Art 57 Member State` DOES `Art 57(1) have a national AI regulatory sandbox operational` AT (Day (Date 2 8 2026))
-- EXPECT BREACH
#TRACE `Art 57(1) as enacted the Member State's duty to have a national AI regulatory sandbox operational` AT (Day (Date 2 8 2026)) WITH
    PARTY `Art 57 Member State` DOES `Art 57(1) have a national AI regulatory sandbox operational` AT (Day (Date 3 8 2026))
-- the dispatcher: before Chapter VI applies nothing is owed, so even a long wait does not breach
-- EXPECT FULFILLED
#TRACE `Art 57(1) the Member State's duty to have a national AI regulatory sandbox operational` (Date 1 8 2026) AT (Day (Date 2 8 2026)) WITH
    WAITUNTIL (Day (Date 4 8 2028))
-- from 2 August 2026 the text as amended is the text in force, and a missed date is a breach
-- EXPECT BREACH
#TRACE `Art 57(1) the Member State's duty to have a national AI regulatory sandbox operational` (Date 2 8 2026) AT (Day (Date 2 8 2026)) WITH
    WAITUNTIL (Day (Date 4 8 2027))
-- EXPECT FULFILLED
#TRACE `Art 57(1) the Member State's duty to have a national AI regulatory sandbox operational` (Date 2 8 2026) AT (Day (Date 2 8 2026)) WITH
    PARTY `Art 57 Member State` DOES `Art 57(1) have a national AI regulatory sandbox operational` AT (Day (Date 2 8 2027))
