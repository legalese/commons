IMPORT prelude
IMPORT daydate
IMPORT `aia-core`
IMPORT `aia-timeline`
IMPORT `P7-sme`

-- P7-tests-sme: tests for P7-sme. Every expected value is written from the text beside the assertion, never copied from the output.
-- Each assertion is on one line; NOTHING is "not covered".

-- 62(1) lead
#ASSERT `Art 62(1) the Member State has undertaken the actions listed` (Date 1 8 2026) TRUE EQUALS NOTHING
#ASSERT `Art 62(1) the Member State has undertaken the actions listed` (Date 2 8 2026) TRUE EQUALS JUST TRUE
#ASSERT `Art 62(1) the Member State has undertaken the actions listed` (Date 2 8 2026) FALSE EQUALS JUST FALSE
-- 62(1)(a) 1
#ASSERT `Art 62(1)(a) the Member State has provided the SME with priority access to the AI regulatory sandboxes` (Date 1 8 2026) TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `Art 62(1)(a) the Member State has provided the SME with priority access to the AI regulatory sandboxes` (Date 2 8 2026) TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 62(1)(a) the Member State has provided the SME with priority access to the AI regulatory sandboxes` (Date 2 8 2026) TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 62(1)(a) the Member State has provided the SME with priority access to the AI regulatory sandboxes` (Date 2 8 2026) FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `Art 62(1)(a) the Member State has provided the SME with priority access to the AI regulatory sandboxes` (Date 2 8 2026) TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `Art 62(1)(a) the Member State has provided the SME with priority access to the AI regulatory sandboxes` (Date 2 8 2026) TRUE TRUE FALSE TRUE EQUALS NOTHING
-- 62(1)(a) 2
#ASSERT `Art 62(1)(a) the priority access precludes another SME from access to the AI regulatory sandbox` (Date 1 8 2026) TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `Art 62(1)(a) the priority access precludes another SME from access to the AI regulatory sandbox` (Date 2 8 2026) TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Art 62(1)(a) the priority access precludes another SME from access to the AI regulatory sandbox` (Date 2 8 2026) TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `Art 62(1)(a) the priority access precludes another SME from access to the AI regulatory sandbox` (Date 2 8 2026) TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `Art 62(1)(a) the priority access precludes another SME from access to the AI regulatory sandbox` (Date 2 8 2026) FALSE TRUE TRUE EQUALS NOTHING
-- 62(1)(b) 1
#ASSERT `Art 62(1)(b) the Member State has organised specific awareness raising and training activities tailored to the needs of SMEs and deployers` (Date 1 8 2026) TRUE TRUE EQUALS NOTHING
#ASSERT `Art 62(1)(b) the Member State has organised specific awareness raising and training activities tailored to the needs of SMEs and deployers` (Date 2 8 2026) TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 62(1)(b) the Member State has organised specific awareness raising and training activities tailored to the needs of SMEs and deployers` (Date 2 8 2026) FALSE TRUE EQUALS JUST FALSE
#ASSERT `Art 62(1)(b) the Member State has organised specific awareness raising and training activities tailored to the needs of SMEs and deployers` (Date 2 8 2026) TRUE FALSE EQUALS JUST FALSE
-- 62(1)(b) 2
#ASSERT `Art 62(1)(b) the Member State has tailored the activities to the needs of local public authorities` (Date 1 8 2026) TRUE TRUE EQUALS NOTHING
#ASSERT `Art 62(1)(b) the Member State has tailored the activities to the needs of local public authorities` (Date 2 8 2026) TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 62(1)(b) the Member State has tailored the activities to the needs of local public authorities` (Date 2 8 2026) TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 62(1)(b) the Member State has tailored the activities to the needs of local public authorities` (Date 2 8 2026) FALSE TRUE EQUALS NOTHING
-- 62(1)(c) 1
#ASSERT `Art 62(1)(c) the Member State has utilised the existing dedicated channels to provide advice and respond to queries` (Date 1 8 2026) TRUE EQUALS NOTHING
#ASSERT `Art 62(1)(c) the Member State has utilised the existing dedicated channels to provide advice and respond to queries` (Date 2 8 2026) TRUE EQUALS JUST TRUE
#ASSERT `Art 62(1)(c) the Member State has utilised the existing dedicated channels to provide advice and respond to queries` (Date 2 8 2026) FALSE EQUALS JUST FALSE
-- 62(1)(c) 2
#ASSERT `Art 62(1)(c) the Member State has established new channels where appropriate` (Date 1 8 2026) TRUE TRUE EQUALS NOTHING
#ASSERT `Art 62(1)(c) the Member State has established new channels where appropriate` (Date 2 8 2026) TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 62(1)(c) the Member State has established new channels where appropriate` (Date 2 8 2026) TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 62(1)(c) the Member State has established new channels where appropriate` (Date 2 8 2026) FALSE TRUE EQUALS NOTHING
-- 62(1)(c) 3
#ASSERT `Art 62(1)(c) the Member State has used the channels for communication with local public authorities` (Date 1 8 2026) TRUE TRUE EQUALS NOTHING
#ASSERT `Art 62(1)(c) the Member State has used the channels for communication with local public authorities` (Date 2 8 2026) TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 62(1)(c) the Member State has used the channels for communication with local public authorities` (Date 2 8 2026) TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 62(1)(c) the Member State has used the channels for communication with local public authorities` (Date 2 8 2026) FALSE TRUE EQUALS NOTHING
-- 62(1)(d)
#ASSERT `Art 62(1)(d) the Member State has facilitated the participation of SMEs and other relevant stakeholders in the standardisation development process` (Date 1 8 2026) TRUE EQUALS NOTHING
#ASSERT `Art 62(1)(d) the Member State has facilitated the participation of SMEs and other relevant stakeholders in the standardisation development process` (Date 2 8 2026) TRUE EQUALS JUST TRUE
#ASSERT `Art 62(1)(d) the Member State has facilitated the participation of SMEs and other relevant stakeholders in the standardisation development process` (Date 2 8 2026) FALSE EQUALS JUST FALSE
-- 62(2)
#ASSERT `Art 62(2) the specific interests and needs of the SME providers have been taken into account when setting the fees for conformity assessment` (Date 1 8 2026) TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `Art 62(2) the specific interests and needs of the SME providers have been taken into account when setting the fees for conformity assessment` (Date 2 8 2026) TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 62(2) the specific interests and needs of the SME providers have been taken into account when setting the fees for conformity assessment` (Date 2 8 2026) TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Art 62(2) the specific interests and needs of the SME providers have been taken into account when setting the fees for conformity assessment` (Date 2 8 2026) TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 62(2) the specific interests and needs of the SME providers have been taken into account when setting the fees for conformity assessment` (Date 2 8 2026) FALSE TRUE TRUE EQUALS NOTHING
-- 62(3) lead
#ASSERT `Art 62(3) the AI Office has undertaken the actions listed` (Date 1 8 2026) TRUE EQUALS NOTHING
#ASSERT `Art 62(3) the AI Office has undertaken the actions listed` (Date 2 8 2026) TRUE EQUALS JUST TRUE
#ASSERT `Art 62(3) the AI Office has undertaken the actions listed` (Date 2 8 2026) FALSE EQUALS JUST FALSE
-- 62(3)(a)
#ASSERT `Art 62(3)(a) the AI Office has provided standardised templates for areas covered by this Regulation` (Date 1 8 2026) TRUE EQUALS NOTHING
#ASSERT `Art 62(3)(a) the AI Office has provided standardised templates for areas covered by this Regulation` (Date 2 8 2026) TRUE EQUALS JUST TRUE
#ASSERT `Art 62(3)(a) the AI Office has provided standardised templates for areas covered by this Regulation` (Date 2 8 2026) FALSE EQUALS JUST FALSE
-- 62(3)(b)
#ASSERT `Art 62(3)(b) the AI Office has developed and maintained a single information platform` (Date 1 8 2026) TRUE TRUE EQUALS NOTHING
#ASSERT `Art 62(3)(b) the AI Office has developed and maintained a single information platform` (Date 2 8 2026) TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 62(3)(b) the AI Office has developed and maintained a single information platform` (Date 2 8 2026) FALSE TRUE EQUALS JUST FALSE
#ASSERT `Art 62(3)(b) the AI Office has developed and maintained a single information platform` (Date 2 8 2026) TRUE FALSE EQUALS JUST FALSE
-- 62(3)(c)
#ASSERT `Art 62(3)(c) the AI Office has organised appropriate communication campaigns` (Date 1 8 2026) TRUE EQUALS NOTHING
#ASSERT `Art 62(3)(c) the AI Office has organised appropriate communication campaigns` (Date 2 8 2026) TRUE EQUALS JUST TRUE
#ASSERT `Art 62(3)(c) the AI Office has organised appropriate communication campaigns` (Date 2 8 2026) FALSE EQUALS JUST FALSE
-- 62(3)(d)
#ASSERT `Art 62(3)(d) the AI Office has evaluated and promoted the convergence of best practices in public procurement procedures` (Date 1 8 2026) TRUE EQUALS NOTHING
#ASSERT `Art 62(3)(d) the AI Office has evaluated and promoted the convergence of best practices in public procurement procedures` (Date 2 8 2026) TRUE EQUALS JUST TRUE
#ASSERT `Art 62(3)(d) the AI Office has evaluated and promoted the convergence of best practices in public procurement procedures` (Date 2 8 2026) FALSE EQUALS JUST FALSE
-- Art 63(1) as enacted
#ASSERT `Art 63(1) as enacted the microenterprise may comply with certain elements of the quality management system in a simplified manner` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 63(1) as enacted the microenterprise may comply with certain elements of the quality management system in a simplified manner` FALSE TRUE EQUALS NOTHING
#ASSERT `Art 63(1) as enacted the microenterprise may comply with certain elements of the quality management system in a simplified manner` TRUE FALSE EQUALS NOTHING
-- Art 63(1) as amended
#ASSERT `Art 63(1) as amended the SME may comply with certain elements of the quality management system in a simplified manner` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 63(1) as amended the SME may comply with certain elements of the quality management system in a simplified manner` FALSE TRUE EQUALS NOTHING
#ASSERT `Art 63(1) as amended the SME may comply with certain elements of the quality management system in a simplified manner` TRUE FALSE EQUALS NOTHING
-- Art 63(1): as enacted only microenterprises, as amended SMEs including start-ups; "provided that they do not have partner enterprises or linked enterprises" in both
-- args (the dispatcher): date asked, microenterprise, SME, no partner or linked enterprises
#ASSERT `Art 63(1) the enterprise may comply with certain elements of the quality management system in a simplified manner` (Date 1 8 2026) TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `Art 63(1) the enterprise may comply with certain elements of the quality management system in a simplified manner` (Date 2 8 2026) TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 63(1) the enterprise may comply with certain elements of the quality management system in a simplified manner` (Date 2 8 2026) FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 63(1) the enterprise may comply with certain elements of the quality management system in a simplified manner` (Date 2 8 2026) FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `Art 63(1) the enterprise may comply with certain elements of the quality management system in a simplified manner` (Date 2 8 2026) FALSE TRUE FALSE EQUALS NOTHING
-- the version in force (the dispatcher cannot reach the as-enacted text: the group applies only from 2 August 2026): direct calls
#ASSERT `Art 63(1) as enacted the microenterprise may comply with certain elements of the quality management system in a simplified manner` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 63(1) as enacted the microenterprise may comply with certain elements of the quality management system in a simplified manner` FALSE TRUE EQUALS NOTHING
#ASSERT `Art 63(1) as enacted the microenterprise may comply with certain elements of the quality management system in a simplified manner` TRUE FALSE EQUALS NOTHING
#ASSERT `Art 63(1) as amended the SME may comply with certain elements of the quality management system in a simplified manner` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 63(1) as amended the SME may comply with certain elements of the quality management system in a simplified manner` FALSE TRUE EQUALS NOTHING
#ASSERT `Art 63(1) as amended the SME may comply with certain elements of the quality management system in a simplified manner` TRUE FALSE EQUALS NOTHING
