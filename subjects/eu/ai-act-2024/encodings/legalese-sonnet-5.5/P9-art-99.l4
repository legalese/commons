             IF `Art 99(4) the group Chapter III Sections 1 to 3 applies to the AI system` `the date asked` `the AI system` THEN JUST TRUE ELSE NOTHING  -- NOTHING-kind (limited by its own wording): Article 113(c) gives Chapter III Sections 1 to 3 their date for this route, and Article 111(2) may save the system
         WHEN `Art 99(4)(d) non-compliance with the obligations of distributors pursuant to Article 24` THEN
             IF `Art 99(4) the group Chapter III Sections 1 to 3 applies to the AI system` `the date asked` `the AI system` THEN JUST TRUE ELSE NOTHING  -- NOTHING-kind (limited by its own wording): Article 113(c) gives Chapter III Sections 1 to 3 their date for this route, and Article 111(2) may save the system
         WHEN `Art 99(4)(da) non-compliance with the obligations of providers and operators pursuant to Article 25(2) and (4)` THEN
             IF `Art 99(4) the group Chapter III Sections 1 to 3 applies to the AI system` `the date asked` `the AI system` THEN JUST TRUE ELSE NOTHING  -- NOTHING-kind (limited by its own wording): Article 113(c) gives Chapter III Sections 1 to 3 their date for this route, and Article 111(2) may save the system
         WHEN `Art 99(4)(e) non-compliance with the obligations of deployers pursuant to Article 26` THEN
             IF `Art 99(4) the group Chapter III Sections 1 to 3 applies to the AI system` `the date asked` `the AI system` THEN JUST TRUE ELSE NOTHING  -- NOTHING-kind (limited by its own wording): Article 113(c) gives Chapter III Sections 1 to 3 their date for this route, and Article 111(2) may save the system
         WHEN `Art 99(4)(f) non-compliance with the requirements and obligations of notified bodies pursuant to Article 31, Article 33(1), (3) and (4) or Article 34` THEN JUST TRUE
         WHEN `Art 99(4)(g) non-compliance with the transparency obligations for providers and deployers pursuant to Article 50` THEN
             IF `Art 99(4)(g) the group General applies to the AI system for Article 50` `the date asked` `the AI system` THEN JUST TRUE ELSE NOTHING  -- NOTHING-kind (limited by its own wording): Article 113 gives Article 50 its date of application, and Article 111(2) may save the system
         WHEN `Art 99(5) the supply of incorrect, incomplete or misleading information to notified bodies or national competent authorities in reply to a request` THEN JUST TRUE
         WHEN `Art 99 another infringement` THEN NOTHING  -- NOTHING-kind (list not closed): no paragraph names a fine for it

