DECLARE `Annex I section` IS ONE OF
    `Annex I Section A`   -- "List of Union harmonisation legislation based on the New Legislative Framework"
    `Annex I Section B`   -- "List of other Union harmonisation legislation"

-- The items of the Annex by their number and act. Item 1 stood in Section A as enacted and is deleted as amended;
-- item 21 was added to Section B by the Omnibus. `Annex I no listed legislation` is the case outside the list.
DECLARE `Annex I item` IS ONE OF
    `Annex I item 1 Directive 2006/42/EC`   -- as enacted only: deleted by the Omnibus (Section A)
    `Annex I item 2 Directive 2009/48/EC`
    `Annex I item 3 Directive 2013/53/EU`
    `Annex I item 4 Directive 2014/33/EU`
    `Annex I item 5 Directive 2014/34/EU`
    `Annex I item 6 Directive 2014/53/EU`
    `Annex I item 7 Directive 2014/68/EU`
    `Annex I item 8 Regulation (EU) 2016/424`
    `Annex I item 9 Regulation (EU) 2016/425`
    `Annex I item 10 Regulation (EU) 2016/426`
    `Annex I item 11 Regulation (EU) 2017/745`
    `Annex I item 12 Regulation (EU) 2017/746`
    `Annex I item 13 Regulation (EC) No 300/2008`
    `Annex I item 14 Regulation (EU) No 168/2013`
    `Annex I item 15 Regulation (EU) No 167/2013`
    `Annex I item 16 Directive 2014/90/EU`
    `Annex I item 17 Directive (EU) 2016/797`
    `Annex I item 18 Regulation (EU) 2018/858`
    `Annex I item 19 Regulation (EU) 2019/2144`
    `Annex I item 20 Regulation (EU) 2018/1139`
    `Annex I item 21 Regulation (EU) 2023/1230`   -- as amended only: added by the Omnibus (Section B)
    `Annex I no listed legislation`

-- One entry of the Annex: its number, the section it stands in, the act, the date of its adoption, what it is about and where it was published.
DECLARE `Annex I entry` HAS
    `item number`   IS A NUMBER
    `section`       IS AN `Annex I section`
    `act`           IS A STRING
    `adopted on`    IS A STRING
    `subject`       IS A STRING
    `OJ reference`  IS A STRING

GIVEN `the item` IS AN `Annex I item`
GIVETH A NUMBER
`Annex I the number of the item` MEANS
    CONSIDER `the item`
    WHEN `Annex I item 1 Directive 2006/42/EC` THEN 1
    WHEN `Annex I item 2 Directive 2009/48/EC` THEN 2
    WHEN `Annex I item 3 Directive 2013/53/EU` THEN 3
    WHEN `Annex I item 4 Directive 2014/33/EU` THEN 4
    WHEN `Annex I item 5 Directive 2014/34/EU` THEN 5
    WHEN `Annex I item 6 Directive 2014/53/EU` THEN 6
    WHEN `Annex I item 7 Directive 2014/68/EU` THEN 7
    WHEN `Annex I item 8 Regulation (EU) 2016/424` THEN 8
    WHEN `Annex I item 9 Regulation (EU) 2016/425` THEN 9
    WHEN `Annex I item 10 Regulation (EU) 2016/426` THEN 10
    WHEN `Annex I item 11 Regulation (EU) 2017/745` THEN 11
    WHEN `Annex I item 12 Regulation (EU) 2017/746` THEN 12
    WHEN `Annex I item 13 Regulation (EC) No 300/2008` THEN 13
    WHEN `Annex I item 14 Regulation (EU) No 168/2013` THEN 14
    WHEN `Annex I item 15 Regulation (EU) No 167/2013` THEN 15
    WHEN `Annex I item 16 Directive 2014/90/EU` THEN 16
    WHEN `Annex I item 17 Directive (EU) 2016/797` THEN 17
    WHEN `Annex I item 18 Regulation (EU) 2018/858` THEN 18
    WHEN `Annex I item 19 Regulation (EU) 2019/2144` THEN 19
    WHEN `Annex I item 20 Regulation (EU) 2018/1139` THEN 20
    WHEN `Annex I item 21 Regulation (EU) 2023/1230` THEN 21
    WHEN `Annex I no listed legislation` THEN 0   -- the case outside the list

