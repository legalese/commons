IMPORT prelude
IMPORT `gdpr-core`
IMPORT `P1-art-6`

-- ============================================================================
-- P1-tests-art-6.l4 -- tests of Art 6(1) and (2).  Expected values written from the text (src:88-96).
-- ============================================================================

§ `Art 6(1)(a): consent`

#ASSERT `Art 6(1)(a) point (a) applies: the data subject has given consent to the processing for one or more specific purposes` TRUE TRUE TRUE EQUALS JUST TRUE
-- no consent
#ASSERT `Art 6(1)(a) point (a) applies: the data subject has given consent to the processing for one or more specific purposes` FALSE TRUE TRUE EQUALS JUST FALSE
-- consent for no specific purpose (a blanket consent)
#ASSERT `Art 6(1)(a) point (a) applies: the data subject has given consent to the processing for one or more specific purposes` TRUE FALSE TRUE EQUALS JUST FALSE
-- consent given for one purpose; the processing is for another
#ASSERT `Art 6(1)(a) point (a) applies: the data subject has given consent to the processing for one or more specific purposes` TRUE TRUE FALSE EQUALS JUST FALSE

§ `Art 6(1)(b): contract, or steps before one`

-- necessary for the performance of a contract to which the data subject is party
#ASSERT `Art 6(1)(b) point (b) applies: the processing is necessary for a contract with the data subject or for steps before one` TRUE FALSE EQUALS JUST TRUE
-- necessary to take steps at the request of the data subject prior to entering into a contract
#ASSERT `Art 6(1)(b) point (b) applies: the processing is necessary for a contract with the data subject or for steps before one` FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 6(1)(b) point (b) applies: the processing is necessary for a contract with the data subject or for steps before one` TRUE TRUE EQUALS JUST TRUE
-- neither (a contract with someone else)
#ASSERT `Art 6(1)(b) point (b) applies: the processing is necessary for a contract with the data subject or for steps before one` FALSE FALSE EQUALS JUST FALSE

§ `Art 6(1)(c): legal obligation`

#ASSERT `Art 6(1)(c) point (c) applies: the processing is necessary for compliance with a legal obligation to which the controller is subject` TRUE TRUE EQUALS JUST TRUE
-- necessary for an obligation to which the controller is not subject (a foreign law)
#ASSERT `Art 6(1)(c) point (c) applies: the processing is necessary for compliance with a legal obligation to which the controller is subject` TRUE FALSE EQUALS JUST FALSE
-- not necessary
#ASSERT `Art 6(1)(c) point (c) applies: the processing is necessary for compliance with a legal obligation to which the controller is subject` FALSE TRUE EQUALS JUST FALSE

§ `Art 6(1)(d): vital interests of the data subject or of another natural person`

#ASSERT `Art 6(1)(d) point (d) applies: the processing is necessary in order to protect the vital interests of the data subject or of another natural person` TRUE `Art 6(1)(d) the data subject's` EQUALS JUST TRUE
#ASSERT `Art 6(1)(d) point (d) applies: the processing is necessary in order to protect the vital interests of the data subject or of another natural person` TRUE `Art 6(1)(d) another natural person's` EQUALS JUST TRUE
-- just outside: the interests of a company are not "vital interests of ... a natural person"
#ASSERT `Art 6(1)(d) point (d) applies: the processing is necessary in order to protect the vital interests of the data subject or of another natural person` TRUE `Art 6(1)(d) the interests of something that is not a natural person` EQUALS JUST FALSE
-- not necessary to protect them
#ASSERT `Art 6(1)(d) point (d) applies: the processing is necessary in order to protect the vital interests of the data subject or of another natural person` FALSE `Art 6(1)(d) the data subject's` EQUALS JUST FALSE

§ `Art 6(1)(e): a task in the public interest, or official authority`

#ASSERT `Art 6(1)(e) point (e) applies: the processing is necessary for a task in the public interest or in the exercise of official authority vested in the controller` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Art 6(1)(e) point (e) applies: the processing is necessary for a task in the public interest or in the exercise of official authority vested in the controller` FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 6(1)(e) point (e) applies: the processing is necessary for a task in the public interest or in the exercise of official authority vested in the controller` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 6(1)(e) point (e) applies: the processing is necessary for a task in the public interest or in the exercise of official authority vested in the controller` FALSE FALSE EQUALS JUST FALSE

§ `Art 6(1)(f): legitimate interests`

-- necessary for the controller's or a third party's legitimate interests, not overridden, an ordinary private controller
#ASSERT `Art 6(1)(f) point (f) applies: the processing is necessary for legitimate interests that are not overridden` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- overridden by the data subject's interests or rights
#ASSERT `Art 6(1)(f) point (f) applies: the processing is necessary for legitimate interests that are not overridden` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
-- the data subject is a child and the interests are overridden
#ASSERT `Art 6(1)(f) point (f) applies: the processing is necessary for legitimate interests that are not overridden` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- the data subject is a child but the interests are not overridden: "in particular where" does not itself override (F6-2)
#ASSERT `Art 6(1)(f) point (f) applies: the processing is necessary for legitimate interests that are not overridden` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
-- not necessary
#ASSERT `Art 6(1)(f) point (f) applies: the processing is necessary for legitimate interests that are not overridden` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- second subparagraph: a public authority in the performance of its tasks, even if necessary and not overridden
#ASSERT `Art 6(1)(f) point (f) applies: the processing is necessary for legitimate interests that are not overridden` TRUE FALSE FALSE TRUE EQUALS JUST FALSE
-- just outside the second subparagraph: the same body when it is not performing its tasks (running a staff social club)
#ASSERT `Art 6(1)(f) point (f) applies: the processing is necessary for legitimate interests that are not overridden` TRUE FALSE FALSE FALSE EQUALS JUST TRUE

§ `Art 6(1): at least one of points (a) to (f)`

-- one point applies, the others do not
#ASSERT `Art 6(1) the condition is met that at least one of points (a) to (f) applies` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `Art 6(1) the condition is met that at least one of points (a) to (f) applies` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
-- several points apply
#ASSERT `Art 6(1) the condition is met that at least one of points (a) to (f) applies` (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
-- one applies and another's answer is not covered: still met
#ASSERT `Art 6(1) the condition is met that at least one of points (a) to (f) applies` NOTHING (JUST TRUE) NOTHING (JUST FALSE) (JUST FALSE) NOTHING EQUALS JUST TRUE
-- none applies: "only if"
#ASSERT `Art 6(1) the condition is met that at least one of points (a) to (f) applies` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
-- not covered: no point applies yet one point's answer is not covered
#ASSERT `Art 6(1) the condition is met that at least one of points (a) to (f) applies` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `Art 6(1) the condition is met that at least one of points (a) to (f) applies` NOTHING NOTHING NOTHING NOTHING NOTHING NOTHING EQUALS NOTHING
-- end to end: a shop that relies on a sales contract with the customer (point (b)) and has no consent
#ASSERT `Art 6(1) the condition is met that at least one of points (a) to (f) applies` (`Art 6(1)(a) point (a) applies: the data subject has given consent to the processing for one or more specific purposes` FALSE TRUE TRUE) (`Art 6(1)(b) point (b) applies: the processing is necessary for a contract with the data subject or for steps before one` TRUE FALSE) (`Art 6(1)(c) point (c) applies: the processing is necessary for compliance with a legal obligation to which the controller is subject` FALSE FALSE) (`Art 6(1)(d) point (d) applies: the processing is necessary in order to protect the vital interests of the data subject or of another natural person` FALSE `Art 6(1)(d) the data subject's`) (`Art 6(1)(e) point (e) applies: the processing is necessary for a task in the public interest or in the exercise of official authority vested in the controller` FALSE FALSE) (`Art 6(1)(f) point (f) applies: the processing is necessary for legitimate interests that are not overridden` FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
-- end to end: nothing applies
#ASSERT `Art 6(1) the condition is met that at least one of points (a) to (f) applies` (`Art 6(1)(a) point (a) applies: the data subject has given consent to the processing for one or more specific purposes` FALSE FALSE FALSE) (`Art 6(1)(b) point (b) applies: the processing is necessary for a contract with the data subject or for steps before one` FALSE FALSE) (`Art 6(1)(c) point (c) applies: the processing is necessary for compliance with a legal obligation to which the controller is subject` FALSE FALSE) (`Art 6(1)(d) point (d) applies: the processing is necessary in order to protect the vital interests of the data subject or of another natural person` FALSE `Art 6(1)(d) the data subject's`) (`Art 6(1)(e) point (e) applies: the processing is necessary for a task in the public interest or in the exercise of official authority vested in the controller` FALSE FALSE) (`Art 6(1)(f) point (f) applies: the processing is necessary for legitimate interests that are not overridden` FALSE FALSE FALSE FALSE) EQUALS JUST FALSE

§ `Art 6(2): Member States may adapt points (c) and (e)`

#ASSERT `Art 6(2) a Member State may maintain or introduce more specific provisions to adapt the application of this Regulation to the processing` `Art 6(1)(c) legal obligation` EQUALS JUST TRUE
#ASSERT `Art 6(2) a Member State may maintain or introduce more specific provisions to adapt the application of this Regulation to the processing` `Art 6(1)(e) public interest or official authority` EQUALS JUST TRUE
-- not covered: the other four bases
#ASSERT `Art 6(2) a Member State may maintain or introduce more specific provisions to adapt the application of this Regulation to the processing` `Art 6(1)(a) consent` EQUALS NOTHING
#ASSERT `Art 6(2) a Member State may maintain or introduce more specific provisions to adapt the application of this Regulation to the processing` `Art 6(1)(b) contract` EQUALS NOTHING
#ASSERT `Art 6(2) a Member State may maintain or introduce more specific provisions to adapt the application of this Regulation to the processing` `Art 6(1)(d) vital interests` EQUALS NOTHING
#ASSERT `Art 6(2) a Member State may maintain or introduce more specific provisions to adapt the application of this Regulation to the processing` `Art 6(1)(f) legitimate interests` EQUALS NOTHING
