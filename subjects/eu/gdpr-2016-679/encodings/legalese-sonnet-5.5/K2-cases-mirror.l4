IMPORT prelude
IMPORT `gdpr-core`
IMPORT `gdpr-core-2`
IMPORT `K2-seat-subject`
IMPORT `K2-seat-controller`

-- ============================================================================
-- K2-cases-mirror.l4 -- the same facts put to the data subject's seat and the controller's seat, asserting that
-- the two answers are equal.  Only the questions that both seats ask are mirrored; the facts of each case
-- are those of the questions' own cases (notes/gen-seats.py), and each case's value is also asserted in
-- the two cases files.  A seat asks yes, no or not sure in its own type, so the values are mapped.
-- ============================================================================

-- 1(3): Art 1(3) the restriction or prohibition of the free movement of personal data within the Union for reasons connected with data protection is barred
#ASSERT (`Under Article 1(3), as a data subject, is a restriction or prohibition of the free movement of my personal data within the Union barred when its reason is the protection of natural persons` TRUE TRUE TRUE) EQUALS (`Under Article 1(3), as a controller, is a restriction or prohibition of the free movement of the personal data I process within the Union barred when its reason is the protection of natural persons` TRUE TRUE TRUE)
#ASSERT (`Under Article 1(3), as a data subject, is a restriction or prohibition of the free movement of my personal data within the Union barred when its reason is the protection of natural persons` TRUE TRUE FALSE) EQUALS (`Under Article 1(3), as a controller, is a restriction or prohibition of the free movement of the personal data I process within the Union barred when its reason is the protection of natural persons` TRUE TRUE FALSE)
#ASSERT (`Under Article 1(3), as a data subject, is a restriction or prohibition of the free movement of my personal data within the Union barred when its reason is the protection of natural persons` FALSE TRUE TRUE) EQUALS (`Under Article 1(3), as a controller, is a restriction or prohibition of the free movement of the personal data I process within the Union barred when its reason is the protection of natural persons` FALSE TRUE TRUE)
#ASSERT (`Under Article 1(3), as a data subject, is a restriction or prohibition of the free movement of my personal data within the Union barred when its reason is the protection of natural persons` TRUE FALSE TRUE) EQUALS (`Under Article 1(3), as a controller, is a restriction or prohibition of the free movement of the personal data I process within the Union barred when its reason is the protection of natural persons` TRUE FALSE TRUE)

-- 2(3)a: Art 2(3) Regulation (EC) No 45/2001 applies to the processing, where it is by the Union institutions, bodies, offices or agencies
#ASSERT (`Under Article 2(3), as a data subject, does Regulation (EC) No 45/2001 apply to the processing of my personal data` TRUE) EQUALS (`Under Article 2(3), as a controller, does Regulation (EC) No 45/2001 apply to my processing of personal data` TRUE)
#ASSERT (`Under Article 2(3), as a data subject, does Regulation (EC) No 45/2001 apply to the processing of my personal data` FALSE) EQUALS (`Under Article 2(3), as a controller, does Regulation (EC) No 45/2001 apply to my processing of personal data` FALSE)

-- 2(3)b: Art 2(3) this Regulation applies to the processing, where it is by the Union institutions, bodies, offices or agencies
#ASSERT (`Under Article 2(3), as a data subject, does this Regulation apply to the processing of my personal data by a Union institution, body, office or agency` TRUE) EQUALS (`Under Article 2(3), as a controller, does this Regulation apply to my processing of personal data, where I am a Union institution, body, office or agency` TRUE)
#ASSERT (`Under Article 2(3), as a data subject, does this Regulation apply to the processing of my personal data by a Union institution, body, office or agency` FALSE) EQUALS (`Under Article 2(3), as a controller, does this Regulation apply to my processing of personal data, where I am a Union institution, body, office or agency` FALSE)

-- 2(4): Art 2(4) this Regulation is without prejudice to the application of Directive 2000/31/EC
#ASSERT (`Under Article 2(4), as a data subject, is this Regulation without prejudice to the application of Directive 2000/31/EC` TRUE FALSE) EQUALS (`Under Article 2(4), as a controller, is this Regulation without prejudice to the application of Directive 2000/31/EC` TRUE FALSE)
#ASSERT (`Under Article 2(4), as a data subject, is this Regulation without prejudice to the application of Directive 2000/31/EC` FALSE TRUE) EQUALS (`Under Article 2(4), as a controller, is this Regulation without prejudice to the application of Directive 2000/31/EC` FALSE TRUE)
#ASSERT (`Under Article 2(4), as a data subject, is this Regulation without prejudice to the application of Directive 2000/31/EC` FALSE FALSE) EQUALS (`Under Article 2(4), as a controller, is this Regulation without prejudice to the application of Directive 2000/31/EC` FALSE FALSE)

-- 3(1): Art 3(1) the territorial limb: the processing is in the context of the activities of an establishment of a controller or a processor in the Union
#ASSERT (`Under Article 3(1), as a data subject, is the establishment limb met for the processing of my personal data` TRUE TRUE) EQUALS (`Under Article 3(1), as a controller, is the establishment limb met for my processing of personal data` TRUE TRUE)
#ASSERT (`Under Article 3(1), as a data subject, is the establishment limb met for the processing of my personal data` TRUE FALSE) EQUALS (`Under Article 3(1), as a controller, is the establishment limb met for my processing of personal data` TRUE FALSE)
#ASSERT (`Under Article 3(1), as a data subject, is the establishment limb met for the processing of my personal data` FALSE TRUE) EQUALS (`Under Article 3(1), as a controller, is the establishment limb met for my processing of personal data` FALSE TRUE)

-- 3(2): Art 3(2) the territorial limb: the processing is of data subjects in the Union by a controller or processor not established in the Union, and the activities are related to offering goods or services or to monitoring behaviour
#ASSERT (`Under Article 3(2), as a data subject, is the limb of data subjects in the Union and a controller or processor not established there met for the processing of my personal data` TRUE TRUE TRUE FALSE FALSE FALSE) EQUALS (`Under Article 3(2), as a controller, is the limb of data subjects in the Union and a controller or processor not established there met for my processing of personal data` TRUE TRUE TRUE FALSE FALSE FALSE)
#ASSERT (`Under Article 3(2), as a data subject, is the limb of data subjects in the Union and a controller or processor not established there met for the processing of my personal data` TRUE TRUE TRUE TRUE FALSE FALSE) EQUALS (`Under Article 3(2), as a controller, is the limb of data subjects in the Union and a controller or processor not established there met for my processing of personal data` TRUE TRUE TRUE TRUE FALSE FALSE)
#ASSERT (`Under Article 3(2), as a data subject, is the limb of data subjects in the Union and a controller or processor not established there met for the processing of my personal data` TRUE TRUE FALSE FALSE TRUE TRUE) EQUALS (`Under Article 3(2), as a controller, is the limb of data subjects in the Union and a controller or processor not established there met for my processing of personal data` TRUE TRUE FALSE FALSE TRUE TRUE)
#ASSERT (`Under Article 3(2), as a data subject, is the limb of data subjects in the Union and a controller or processor not established there met for the processing of my personal data` TRUE TRUE FALSE FALSE TRUE FALSE) EQUALS (`Under Article 3(2), as a controller, is the limb of data subjects in the Union and a controller or processor not established there met for my processing of personal data` TRUE TRUE FALSE FALSE TRUE FALSE)
#ASSERT (`Under Article 3(2), as a data subject, is the limb of data subjects in the Union and a controller or processor not established there met for the processing of my personal data` FALSE TRUE TRUE FALSE TRUE TRUE) EQUALS (`Under Article 3(2), as a controller, is the limb of data subjects in the Union and a controller or processor not established there met for my processing of personal data` FALSE TRUE TRUE FALSE TRUE TRUE)
#ASSERT (`Under Article 3(2), as a data subject, is the limb of data subjects in the Union and a controller or processor not established there met for the processing of my personal data` TRUE FALSE TRUE FALSE TRUE TRUE) EQUALS (`Under Article 3(2), as a controller, is the limb of data subjects in the Union and a controller or processor not established there met for my processing of personal data` TRUE FALSE TRUE FALSE TRUE TRUE)

-- 3(3): Art 3(3) the territorial limb: the processing is by a controller not established in the Union, in a place where Member State law applies by virtue of public international law
#ASSERT (`Under Article 3(3), as a data subject, is the limb of a place where Member State law applies by virtue of public international law met for the processing of my personal data` TRUE TRUE) EQUALS (`Under Article 3(3), as a controller, is the limb of a place where Member State law applies by virtue of public international law met for my processing of personal data` TRUE TRUE)
#ASSERT (`Under Article 3(3), as a data subject, is the limb of a place where Member State law applies by virtue of public international law met for the processing of my personal data` TRUE FALSE) EQUALS (`Under Article 3(3), as a controller, is the limb of a place where Member State law applies by virtue of public international law met for my processing of personal data` TRUE FALSE)
#ASSERT (`Under Article 3(3), as a data subject, is the limb of a place where Member State law applies by virtue of public international law met for the processing of my personal data` FALSE TRUE) EQUALS (`Under Article 3(3), as a controller, is the limb of a place where Member State law applies by virtue of public international law met for my processing of personal data` FALSE TRUE)

-- 3: Art 3 this Regulation applies to the processing of personal data
#ASSERT (`Under Article 3, as a data subject, does this Regulation apply to the processing of my personal data` `K2 subject answer: yes` FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS (`Under Article 3, as a controller, does this Regulation apply to my processing of personal data` `K2 controller answer: yes` FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
#ASSERT (`Under Article 3, as a data subject, does this Regulation apply to the processing of my personal data` `K2 subject answer: yes` FALSE FALSE FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE) EQUALS (`Under Article 3, as a controller, does this Regulation apply to my processing of personal data` `K2 controller answer: yes` FALSE FALSE FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE)
#ASSERT (`Under Article 3, as a data subject, does this Regulation apply to the processing of my personal data` `K2 subject answer: yes` FALSE FALSE FALSE TRUE TRUE FALSE FALSE TRUE TRUE FALSE FALSE) EQUALS (`Under Article 3, as a controller, does this Regulation apply to my processing of personal data` `K2 controller answer: yes` FALSE FALSE FALSE TRUE TRUE FALSE FALSE TRUE TRUE FALSE FALSE)
#ASSERT (`Under Article 3, as a data subject, does this Regulation apply to the processing of my personal data` `K2 subject answer: yes` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE) EQUALS (`Under Article 3, as a controller, does this Regulation apply to my processing of personal data` `K2 controller answer: yes` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE)
#ASSERT (`Under Article 3, as a data subject, does this Regulation apply to the processing of my personal data` `K2 subject answer: yes` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS (`Under Article 3, as a controller, does this Regulation apply to my processing of personal data` `K2 controller answer: yes` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
#ASSERT (`Under Article 3, as a data subject, does this Regulation apply to the processing of my personal data` `K2 subject answer: yes` TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS (`Under Article 3, as a controller, does this Regulation apply to my processing of personal data` `K2 controller answer: yes` TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
#ASSERT (`Under Article 3, as a data subject, does this Regulation apply to the processing of my personal data` `K2 subject answer: no` FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS (`Under Article 3, as a controller, does this Regulation apply to my processing of personal data` `K2 controller answer: no` FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
#ASSERT (`Under Article 3, as a data subject, does this Regulation apply to the processing of my personal data` `K2 subject answer: not sure` FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS (`Under Article 3, as a controller, does this Regulation apply to my processing of personal data` `K2 controller answer: not sure` FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)

-- 4(3): Art 4(3) the act is a restriction of processing
#ASSERT (`Under Article 4(3), as a data subject, is what was done to my stored personal data a restriction of processing` TRUE TRUE TRUE) EQUALS (`Under Article 4(3), as a controller, is what I did to stored personal data a restriction of processing` TRUE TRUE TRUE)
#ASSERT (`Under Article 4(3), as a data subject, is what was done to my stored personal data a restriction of processing` TRUE FALSE TRUE) EQUALS (`Under Article 4(3), as a controller, is what I did to stored personal data a restriction of processing` TRUE FALSE TRUE)
#ASSERT (`Under Article 4(3), as a data subject, is what was done to my stored personal data a restriction of processing` FALSE TRUE TRUE) EQUALS (`Under Article 4(3), as a controller, is what I did to stored personal data a restriction of processing` FALSE TRUE TRUE)
#ASSERT (`Under Article 4(3), as a data subject, is what was done to my stored personal data a restriction of processing` TRUE TRUE FALSE) EQUALS (`Under Article 4(3), as a controller, is what I did to stored personal data a restriction of processing` TRUE TRUE FALSE)

-- 4(4): Art 4(4) the processing is profiling
#ASSERT (`Under Article 4(4), as a data subject, was I profiled` TRUE TRUE TRUE `Art 4(4) economic situation` TRUE) EQUALS (`Under Article 4(4), as a controller, is my processing profiling` TRUE TRUE TRUE `Art 4(4) economic situation` TRUE)
#ASSERT (`Under Article 4(4), as a data subject, was I profiled` TRUE TRUE TRUE `Art 4(4) some other personal aspect` TRUE) EQUALS (`Under Article 4(4), as a controller, is my processing profiling` TRUE TRUE TRUE `Art 4(4) some other personal aspect` TRUE)
#ASSERT (`Under Article 4(4), as a data subject, was I profiled` TRUE FALSE TRUE `Art 4(4) behaviour` TRUE) EQUALS (`Under Article 4(4), as a controller, is my processing profiling` TRUE FALSE TRUE `Art 4(4) behaviour` TRUE)
#ASSERT (`Under Article 4(4), as a data subject, was I profiled` TRUE TRUE FALSE `Art 4(4) location` TRUE) EQUALS (`Under Article 4(4), as a controller, is my processing profiling` TRUE TRUE FALSE `Art 4(4) location` TRUE)
#ASSERT (`Under Article 4(4), as a data subject, was I profiled` FALSE TRUE TRUE `Art 4(4) health` TRUE) EQUALS (`Under Article 4(4), as a controller, is my processing profiling` FALSE TRUE TRUE `Art 4(4) health` TRUE)

-- 4(9)a: Art 4(9) the body is a recipient
#ASSERT (`Under Article 4(9), as a data subject, is the body my personal data were disclosed to a recipient` `legal person` TRUE FALSE FALSE FALSE) EQUALS (`Under Article 4(9), as a controller, is the body I disclose personal data to a recipient` `legal person` TRUE FALSE FALSE FALSE)
#ASSERT (`Under Article 4(9), as a data subject, is the body my personal data were disclosed to a recipient` `public authority` TRUE FALSE TRUE TRUE) EQUALS (`Under Article 4(9), as a controller, is the body I disclose personal data to a recipient` `public authority` TRUE FALSE TRUE TRUE)
#ASSERT (`Under Article 4(9), as a data subject, is the body my personal data were disclosed to a recipient` `legal person` FALSE FALSE FALSE FALSE) EQUALS (`Under Article 4(9), as a controller, is the body I disclose personal data to a recipient` `legal person` FALSE FALSE FALSE FALSE)
#ASSERT (`Under Article 4(9), as a data subject, is the body my personal data were disclosed to a recipient` `public authority` TRUE TRUE FALSE FALSE) EQUALS (`Under Article 4(9), as a controller, is the body I disclose personal data to a recipient` `public authority` TRUE TRUE FALSE FALSE)
#ASSERT (`Under Article 4(9), as a data subject, is the body my personal data were disclosed to a recipient` `agency` TRUE TRUE TRUE TRUE) EQUALS (`Under Article 4(9), as a controller, is the body I disclose personal data to a recipient` `agency` TRUE TRUE TRUE TRUE)

-- 4(9)b: Art 4(9) the processing by the public authority of the data it receives in a particular inquiry is in compliance with the applicable data protection rules
#ASSERT (`Under Article 4(9), as a data subject, is the processing by a public authority of my personal data that it received in a particular inquiry in compliance with the applicable data protection rules` `public authority` TRUE TRUE TRUE) EQUALS (`Under Article 4(9), as a controller, is the processing by a public authority of the personal data it received from me in a particular inquiry in compliance with the applicable data protection rules` `public authority` TRUE TRUE TRUE)
#ASSERT (`Under Article 4(9), as a data subject, is the processing by a public authority of my personal data that it received in a particular inquiry in compliance with the applicable data protection rules` `public authority` TRUE TRUE FALSE) EQUALS (`Under Article 4(9), as a controller, is the processing by a public authority of the personal data it received from me in a particular inquiry in compliance with the applicable data protection rules` `public authority` TRUE TRUE FALSE)
#ASSERT (`Under Article 4(9), as a data subject, is the processing by a public authority of my personal data that it received in a particular inquiry in compliance with the applicable data protection rules` `legal person` TRUE TRUE FALSE) EQUALS (`Under Article 4(9), as a controller, is the processing by a public authority of the personal data it received from me in a particular inquiry in compliance with the applicable data protection rules` `legal person` TRUE TRUE FALSE)

-- 4(10): Art 4(10) the body is a third party
#ASSERT (`Under Article 4(10), as a data subject, is the body a third party` `legal person` FALSE FALSE FALSE FALSE) EQUALS (`Under Article 4(10), as a controller, is the body a third party` `legal person` FALSE FALSE FALSE FALSE)
#ASSERT (`Under Article 4(10), as a data subject, is the body a third party` `natural person` TRUE FALSE FALSE FALSE) EQUALS (`Under Article 4(10), as a controller, is the body a third party` `natural person` TRUE FALSE FALSE FALSE)
#ASSERT (`Under Article 4(10), as a data subject, is the body a third party` `legal person` FALSE TRUE FALSE FALSE) EQUALS (`Under Article 4(10), as a controller, is the body a third party` `legal person` FALSE TRUE FALSE FALSE)
#ASSERT (`Under Article 4(10), as a data subject, is the body a third party` `legal person` FALSE FALSE TRUE FALSE) EQUALS (`Under Article 4(10), as a controller, is the body a third party` `legal person` FALSE FALSE TRUE FALSE)
#ASSERT (`Under Article 4(10), as a data subject, is the body a third party` `natural person` FALSE FALSE FALSE TRUE) EQUALS (`Under Article 4(10), as a controller, is the body a third party` `natural person` FALSE FALSE FALSE TRUE)

-- 4(11): Art 4(11) the indication is the consent of the data subject
#ASSERT (`Under Article 4(11), as a data subject, did I give consent` TRUE TRUE TRUE TRUE TRUE `Art 4(11) by a statement` TRUE) EQUALS (`Under Article 4(11), as a controller, is what the data subject gave me consent` TRUE TRUE TRUE TRUE TRUE `Art 4(11) by a statement` TRUE)
#ASSERT (`Under Article 4(11), as a data subject, did I give consent` TRUE TRUE TRUE TRUE TRUE `Art 4(11) by a clear affirmative action` TRUE) EQUALS (`Under Article 4(11), as a controller, is what the data subject gave me consent` TRUE TRUE TRUE TRUE TRUE `Art 4(11) by a clear affirmative action` TRUE)
#ASSERT (`Under Article 4(11), as a data subject, did I give consent` TRUE TRUE TRUE TRUE TRUE `Art 4(11) in some other way, with no statement and no clear affirmative action` TRUE) EQUALS (`Under Article 4(11), as a controller, is what the data subject gave me consent` TRUE TRUE TRUE TRUE TRUE `Art 4(11) in some other way, with no statement and no clear affirmative action` TRUE)
#ASSERT (`Under Article 4(11), as a data subject, did I give consent` TRUE TRUE FALSE TRUE TRUE `Art 4(11) by a clear affirmative action` TRUE) EQUALS (`Under Article 4(11), as a controller, is what the data subject gave me consent` TRUE TRUE FALSE TRUE TRUE `Art 4(11) by a clear affirmative action` TRUE)
#ASSERT (`Under Article 4(11), as a data subject, did I give consent` FALSE TRUE TRUE TRUE TRUE `Art 4(11) by a statement` TRUE) EQUALS (`Under Article 4(11), as a controller, is what the data subject gave me consent` FALSE TRUE TRUE TRUE TRUE `Art 4(11) by a statement` TRUE)
#ASSERT (`Under Article 4(11), as a data subject, did I give consent` TRUE TRUE TRUE TRUE TRUE `Art 4(11) by a statement` FALSE) EQUALS (`Under Article 4(11), as a controller, is what the data subject gave me consent` TRUE TRUE TRUE TRUE TRUE `Art 4(11) by a statement` FALSE)

-- 4(12): Art 4(12) the incident is a personal data breach
#ASSERT (`Under Article 4(12), as a data subject, is what happened to my personal data a personal data breach` TRUE `Art 4(12) unauthorised access to personal data` TRUE) EQUALS (`Under Article 4(12), as a controller, is the incident a personal data breach` TRUE `Art 4(12) unauthorised access to personal data` TRUE)
#ASSERT (`Under Article 4(12), as a data subject, is what happened to my personal data a personal data breach` TRUE `Art 4(12) accidental loss of personal data` TRUE) EQUALS (`Under Article 4(12), as a controller, is the incident a personal data breach` TRUE `Art 4(12) accidental loss of personal data` TRUE)
#ASSERT (`Under Article 4(12), as a data subject, is what happened to my personal data a personal data breach` TRUE `Art 4(12) some other consequence` TRUE) EQUALS (`Under Article 4(12), as a controller, is the incident a personal data breach` TRUE `Art 4(12) some other consequence` TRUE)
#ASSERT (`Under Article 4(12), as a data subject, is what happened to my personal data a personal data breach` FALSE `Art 4(12) unauthorised disclosure of personal data` TRUE) EQUALS (`Under Article 4(12), as a controller, is the incident a personal data breach` FALSE `Art 4(12) unauthorised disclosure of personal data` TRUE)

-- 4(13): Art 4(13) the data are genetic data
#ASSERT (`Under Article 4(13), as a data subject, are my personal data genetic data` TRUE TRUE TRUE TRUE) EQUALS (`Under Article 4(13), as a controller, are the data genetic data` TRUE TRUE TRUE TRUE)
#ASSERT (`Under Article 4(13), as a data subject, are my personal data genetic data` TRUE TRUE TRUE FALSE) EQUALS (`Under Article 4(13), as a controller, are the data genetic data` TRUE TRUE TRUE FALSE)
#ASSERT (`Under Article 4(13), as a data subject, are my personal data genetic data` TRUE FALSE TRUE TRUE) EQUALS (`Under Article 4(13), as a controller, are the data genetic data` TRUE FALSE TRUE TRUE)

-- 4(14): Art 4(14) the data are biometric data
#ASSERT (`Under Article 4(14), as a data subject, are my personal data biometric data` TRUE TRUE TRUE TRUE TRUE) EQUALS (`Under Article 4(14), as a controller, are the data biometric data` TRUE TRUE TRUE TRUE TRUE)
#ASSERT (`Under Article 4(14), as a data subject, are my personal data biometric data` TRUE FALSE TRUE TRUE TRUE) EQUALS (`Under Article 4(14), as a controller, are the data biometric data` TRUE FALSE TRUE TRUE TRUE)
#ASSERT (`Under Article 4(14), as a data subject, are my personal data biometric data` TRUE TRUE TRUE FALSE FALSE) EQUALS (`Under Article 4(14), as a controller, are the data biometric data` TRUE TRUE TRUE FALSE FALSE)

-- 4(15): Art 4(15) the data are data concerning health
#ASSERT (`Under Article 4(15), as a data subject, are my personal data data concerning health` TRUE TRUE FALSE TRUE) EQUALS (`Under Article 4(15), as a controller, are the data data concerning health` TRUE TRUE FALSE TRUE)
#ASSERT (`Under Article 4(15), as a data subject, are my personal data data concerning health` TRUE FALSE TRUE TRUE) EQUALS (`Under Article 4(15), as a controller, are the data data concerning health` TRUE FALSE TRUE TRUE)
#ASSERT (`Under Article 4(15), as a data subject, are my personal data data concerning health` TRUE TRUE TRUE FALSE) EQUALS (`Under Article 4(15), as a controller, are the data data concerning health` TRUE TRUE TRUE FALSE)

-- 4(13-15): Art 4(13) to (15) the category of Article 9(1) that the data fall in by these definitions
#ASSERT (`Under Article 4(13) to (15), as a data subject, which category of Article 9(1) do my personal data fall in by the definitions of genetic data, biometric data and data concerning health` `K2 subject answer: yes` `K2 subject answer: no` FALSE `K2 subject answer: no`) EQUALS (`Under Article 4(13) to (15), as a controller, which category of Article 9(1) do the data fall in by the definitions of genetic data, biometric data and data concerning health` `K2 controller answer: yes` `K2 controller answer: no` FALSE `K2 controller answer: no`)
#ASSERT (`Under Article 4(13) to (15), as a data subject, which category of Article 9(1) do my personal data fall in by the definitions of genetic data, biometric data and data concerning health` `K2 subject answer: no` `K2 subject answer: yes` TRUE `K2 subject answer: no`) EQUALS (`Under Article 4(13) to (15), as a controller, which category of Article 9(1) do the data fall in by the definitions of genetic data, biometric data and data concerning health` `K2 controller answer: no` `K2 controller answer: yes` TRUE `K2 controller answer: no`)
#ASSERT (`Under Article 4(13) to (15), as a data subject, which category of Article 9(1) do my personal data fall in by the definitions of genetic data, biometric data and data concerning health` `K2 subject answer: no` `K2 subject answer: yes` FALSE `K2 subject answer: no`) EQUALS (`Under Article 4(13) to (15), as a controller, which category of Article 9(1) do the data fall in by the definitions of genetic data, biometric data and data concerning health` `K2 controller answer: no` `K2 controller answer: yes` FALSE `K2 controller answer: no`)
#ASSERT (`Under Article 4(13) to (15), as a data subject, which category of Article 9(1) do my personal data fall in by the definitions of genetic data, biometric data and data concerning health` `K2 subject answer: no` `K2 subject answer: no` FALSE `K2 subject answer: yes`) EQUALS (`Under Article 4(13) to (15), as a controller, which category of Article 9(1) do the data fall in by the definitions of genetic data, biometric data and data concerning health` `K2 controller answer: no` `K2 controller answer: no` FALSE `K2 controller answer: yes`)
#ASSERT (`Under Article 4(13) to (15), as a data subject, which category of Article 9(1) do my personal data fall in by the definitions of genetic data, biometric data and data concerning health` `K2 subject answer: yes` `K2 subject answer: no` FALSE `K2 subject answer: yes`) EQUALS (`Under Article 4(13) to (15), as a controller, which category of Article 9(1) do the data fall in by the definitions of genetic data, biometric data and data concerning health` `K2 controller answer: yes` `K2 controller answer: no` FALSE `K2 controller answer: yes`)
#ASSERT (`Under Article 4(13) to (15), as a data subject, which category of Article 9(1) do my personal data fall in by the definitions of genetic data, biometric data and data concerning health` `K2 subject answer: no` `K2 subject answer: no` FALSE `K2 subject answer: no`) EQUALS (`Under Article 4(13) to (15), as a controller, which category of Article 9(1) do the data fall in by the definitions of genetic data, biometric data and data concerning health` `K2 controller answer: no` `K2 controller answer: no` FALSE `K2 controller answer: no`)
#ASSERT (`Under Article 4(13) to (15), as a data subject, which category of Article 9(1) do my personal data fall in by the definitions of genetic data, biometric data and data concerning health` `K2 subject answer: not sure` `K2 subject answer: not sure` FALSE `K2 subject answer: not sure`) EQUALS (`Under Article 4(13) to (15), as a controller, which category of Article 9(1) do the data fall in by the definitions of genetic data, biometric data and data concerning health` `K2 controller answer: not sure` `K2 controller answer: not sure` FALSE `K2 controller answer: not sure`)

-- 4(17): Art 4(17) the person is a representative
#ASSERT (`Under Article 4(17), as a data subject, is the person a representative` `legal person` TRUE TRUE TRUE) EQUALS (`Under Article 4(17), as a controller, is the person I designated a representative` `legal person` TRUE TRUE TRUE)
#ASSERT (`Under Article 4(17), as a data subject, is the person a representative` `legal person` FALSE TRUE TRUE) EQUALS (`Under Article 4(17), as a controller, is the person I designated a representative` `legal person` FALSE TRUE TRUE)
#ASSERT (`Under Article 4(17), as a data subject, is the person a representative` `public authority` TRUE TRUE TRUE) EQUALS (`Under Article 4(17), as a controller, is the person I designated a representative` `public authority` TRUE TRUE TRUE)

-- 4(21): Art 4(21) the body is a supervisory authority
#ASSERT (`Under Article 4(21), as a data subject, is the body a supervisory authority` `public authority` TRUE TRUE TRUE) EQUALS (`Under Article 4(21), as a controller, is the body a supervisory authority` `public authority` TRUE TRUE TRUE)
#ASSERT (`Under Article 4(21), as a data subject, is the body a supervisory authority` `public authority` FALSE TRUE TRUE) EQUALS (`Under Article 4(21), as a controller, is the body a supervisory authority` `public authority` FALSE TRUE TRUE)
#ASSERT (`Under Article 4(21), as a data subject, is the body a supervisory authority` `other body` TRUE TRUE TRUE) EQUALS (`Under Article 4(21), as a controller, is the body a supervisory authority` `other body` TRUE TRUE TRUE)

-- 4(22): Art 4(22) the supervisory authority is a supervisory authority concerned by the processing
#ASSERT (`Under Article 4(22), as a data subject, is the supervisory authority a supervisory authority concerned by the processing of my personal data` TRUE TRUE FALSE FALSE FALSE) EQUALS (`Under Article 4(22), as a controller, is the supervisory authority a supervisory authority concerned by my processing` TRUE TRUE FALSE FALSE FALSE)
#ASSERT (`Under Article 4(22), as a data subject, is the supervisory authority a supervisory authority concerned by the processing of my personal data` TRUE FALSE FALSE FALSE TRUE) EQUALS (`Under Article 4(22), as a controller, is the supervisory authority a supervisory authority concerned by my processing` TRUE FALSE FALSE FALSE TRUE)
#ASSERT (`Under Article 4(22), as a data subject, is the supervisory authority a supervisory authority concerned by the processing of my personal data` TRUE FALSE FALSE FALSE FALSE) EQUALS (`Under Article 4(22), as a controller, is the supervisory authority a supervisory authority concerned by my processing` TRUE FALSE FALSE FALSE FALSE)

-- 4(25): Art 4(25) the service is an information society service
#ASSERT (`Under Article 4(25), as a data subject, is the service an information society service` TRUE) EQUALS (`Under Article 4(25), as a controller, is my service an information society service` TRUE)
#ASSERT (`Under Article 4(25), as a data subject, is the service an information society service` FALSE) EQUALS (`Under Article 4(25), as a controller, is my service an information society service` FALSE)

-- 4(26): Art 4(26) the body is an international organisation
#ASSERT (`Under Article 4(26), as a data subject, is the body my personal data went to an international organisation` TRUE FALSE) EQUALS (`Under Article 4(26), as a controller, is the body I transfer personal data to an international organisation` TRUE FALSE)
#ASSERT (`Under Article 4(26), as a data subject, is the body my personal data went to an international organisation` FALSE TRUE) EQUALS (`Under Article 4(26), as a controller, is the body I transfer personal data to an international organisation` FALSE TRUE)
#ASSERT (`Under Article 4(26), as a data subject, is the body my personal data went to an international organisation` FALSE FALSE) EQUALS (`Under Article 4(26), as a controller, is the body I transfer personal data to an international organisation` FALSE FALSE)
