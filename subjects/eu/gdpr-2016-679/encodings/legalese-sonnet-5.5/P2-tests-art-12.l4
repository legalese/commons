IMPORT prelude
IMPORT daydate
IMPORT `gdpr-core`
IMPORT `P2-art-12`

-- ============================================================================
-- P2-tests-art-12.l4 -- tests of Article 12 (src:146-158).
-- Every expected value was written by hand from the text of the provision named in the comment above it,
-- before the first run, and none was copied from an output (notes/gen-tests-p2.py holds the cases).
-- A #TRACE result is not an assertion and check.sh does not count it; each trace comment gives the expected result.
-- ============================================================================

§ `Art 12(1) first sentence: appropriate measures, concise, transparent, intelligible, easily accessible, clear and plain`

-- all six requirements met; not addressed to a child
#ASSERT `Art 12(1) the controller takes appropriate measures to provide the information and communications in a concise, transparent, intelligible and easily accessible form, using clear and plain language` TRUE TRUE TRUE TRUE TRUE TRUE FALSE EQUALS JUST TRUE
-- all six met, and the information is addressed to a child: 'in particular' stresses a case and adds no test
#ASSERT `Art 12(1) the controller takes appropriate measures to provide the information and communications in a concise, transparent, intelligible and easily accessible form, using clear and plain language` TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- no appropriate measures taken: 'shall take appropriate measures'
#ASSERT `Art 12(1) the controller takes appropriate measures to provide the information and communications in a concise, transparent, intelligible and easily accessible form, using clear and plain language` FALSE TRUE TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- not concise
#ASSERT `Art 12(1) the controller takes appropriate measures to provide the information and communications in a concise, transparent, intelligible and easily accessible form, using clear and plain language` TRUE FALSE TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- not transparent
#ASSERT `Art 12(1) the controller takes appropriate measures to provide the information and communications in a concise, transparent, intelligible and easily accessible form, using clear and plain language` TRUE TRUE FALSE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- not intelligible
#ASSERT `Art 12(1) the controller takes appropriate measures to provide the information and communications in a concise, transparent, intelligible and easily accessible form, using clear and plain language` TRUE TRUE TRUE FALSE TRUE TRUE FALSE EQUALS JUST FALSE
-- not easily accessible
#ASSERT `Art 12(1) the controller takes appropriate measures to provide the information and communications in a concise, transparent, intelligible and easily accessible form, using clear and plain language` TRUE TRUE TRUE TRUE FALSE TRUE FALSE EQUALS JUST FALSE
-- not clear and plain language
#ASSERT `Art 12(1) the controller takes appropriate measures to provide the information and communications in a concise, transparent, intelligible and easily accessible form, using clear and plain language` TRUE TRUE TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
-- not clear and plain language, information addressed to a child: still JUST FALSE
#ASSERT `Art 12(1) the controller takes appropriate measures to provide the information and communications in a concise, transparent, intelligible and easily accessible form, using clear and plain language` TRUE TRUE TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
-- measures taken
#ASSERT `Art 12(1) the controller has taken appropriate measures` TRUE EQUALS JUST TRUE
-- no measures: 'shall take appropriate measures'
#ASSERT `Art 12(1) the controller has taken appropriate measures` FALSE EQUALS JUST FALSE

§ `Art 12(1) second sentence: in writing, or by other means`

-- in writing
#ASSERT `Art 12(1) the information is provided in writing, or by other means, including, where appropriate, by electronic means` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- by other means (oral, say)
#ASSERT `Art 12(1) the information is provided in writing, or by other means, including, where appropriate, by electronic means` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- by electronic means alone: an example of 'other means'
#ASSERT `Art 12(1) the information is provided in writing, or by other means, including, where appropriate, by electronic means` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
-- by electronic means, where appropriate
#ASSERT `Art 12(1) the information is provided in writing, or by other means, including, where appropriate, by electronic means` FALSE FALSE TRUE TRUE EQUALS JUST TRUE
-- in no form at all: 'shall be provided in writing, or by other means'
#ASSERT `Art 12(1) the information is provided in writing, or by other means, including, where appropriate, by electronic means` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- that electronic means would be appropriate does not supply the information
#ASSERT `Art 12(1) the information is provided in writing, or by other means, including, where appropriate, by electronic means` FALSE FALSE FALSE TRUE EQUALS JUST FALSE

§ `Art 12(1) third sentence: orally, when requested, provided that the identity is proven by other means`

-- requested by the data subject and identity proven by other means
#ASSERT `Art 12(1) the information may be provided orally` TRUE TRUE EQUALS JUST TRUE
-- not requested by the data subject: 'When requested by the data subject' (a failed 'When', ruling (b))
#ASSERT `Art 12(1) the information may be provided orally` FALSE TRUE EQUALS JUST FALSE
-- identity not proven by other means: 'provided that'
#ASSERT `Art 12(1) the information may be provided orally` TRUE FALSE EQUALS JUST FALSE
-- neither
#ASSERT `Art 12(1) the information may be provided orally` FALSE FALSE EQUALS JUST FALSE

§ `Art 12(1): the regulative rule (no time limit, no consequence: it can stand or be fulfilled, never be breached)`

-- the controller takes the measures: FULFILLED
#TRACE `Art 12(1) the controller must take appropriate measures to provide the information and communications` AT 0 WITH
    PARTY controller DOES `Art 12(1) take appropriate measures to provide the information and communications in the form that paragraph 1 requires` AT 1
-- no act, a long time later: the obligation still stands (a MUST with no WITHIN never breaches)
#TRACE `Art 12(1) the controller must take appropriate measures to provide the information and communications` AT 0 WITH
    (WAITUNTIL 1000)

§ `Art 12(2) first sentence: facilitate`

-- the controller has facilitated the exercise of the rights
#ASSERT `Art 12(2) the controller facilitates the exercise of data subject rights under Articles 15 to 22` TRUE EQUALS JUST TRUE
-- the controller has not: 'shall facilitate'
#ASSERT `Art 12(2) the controller facilitates the exercise of data subject rights under Articles 15 to 22` FALSE EQUALS JUST FALSE
-- the controller facilitates: FULFILLED
#TRACE `Art 12(2) the controller must facilitate the exercise of data subject rights under Articles 15 to 22` AT 0 WITH
    PARTY controller DOES `Art 12(2) facilitate the exercise of data subject rights under Articles 15 to 22` AT 1
-- no act: the obligation stands, no breach is possible (no time limit)
#TRACE `Art 12(2) the controller must facilitate the exercise of data subject rights under Articles 15 to 22` AT 0 WITH
    (WAITUNTIL 1000)

§ `Art 12(2) second sentence: in the cases referred to in Article 11(2), no refusal unless the controller demonstrates it cannot identify`

-- P1 says the case is outside Article 11(2): 'In the cases referred to in Article 11(2)' is not met, the text is silent
#ASSERT `Art 12(2) the controller shall not refuse to act on the request of the data subject in the cases referred to in Article 11(2)` NOTHING FALSE EQUALS NOTHING
-- outside Article 11(2), and the controller demonstrates it cannot identify: still not covered
#ASSERT `Art 12(2) the controller shall not refuse to act on the request of the data subject in the cases referred to in Article 11(2)` NOTHING TRUE EQUALS NOTHING
-- an Article 11(2) case, the controller has not demonstrated it cannot identify: it shall not refuse to act
#ASSERT `Art 12(2) the controller shall not refuse to act on the request of the data subject in the cases referred to in Article 11(2)` (JUST TRUE) FALSE EQUALS JUST TRUE
-- an Article 11(2) case, and the controller demonstrates it is not in a position to identify: 'unless'
#ASSERT `Art 12(2) the controller shall not refuse to act on the request of the data subject in the cases referred to in Article 11(2)` (JUST TRUE) TRUE EQUALS JUST FALSE
-- an Article 11(2) case in which the data subject provided identifying information: the controller shall not refuse
#ASSERT `Art 12(2) the controller shall not refuse to act on the request of the data subject in the cases referred to in Article 11(2)` (JUST FALSE) FALSE EQUALS JUST TRUE
-- the same, but the controller still demonstrates it cannot identify: 'unless'
#ASSERT `Art 12(2) the controller shall not refuse to act on the request of the data subject in the cases referred to in Article 11(2)` (JUST FALSE) TRUE EQUALS JUST FALSE
-- BREACH: refusing in an Article 11(2) case with no demonstration (the act is the breach)
#TRACE `Art 12(2) the controller shall not refuse to act on the request in the cases referred to in Article 11(2)` (JUST TRUE) FALSE AT 0 WITH
    PARTY controller DOES `Art 12(2) refuse to act on the request of the data subject` AT 1
-- BREACH: the data subject provided identifying information, the controller still refuses
#TRACE `Art 12(2) the controller shall not refuse to act on the request in the cases referred to in Article 11(2)` (JUST FALSE) FALSE AT 0 WITH
    PARTY controller DOES `Art 12(2) refuse to act on the request of the data subject` AT 1
-- FULFILLED: the controller demonstrates it cannot identify, so refusing is not barred
#TRACE `Art 12(2) the controller shall not refuse to act on the request in the cases referred to in Article 11(2)` (JUST TRUE) TRUE AT 0 WITH
    PARTY controller DOES `Art 12(2) refuse to act on the request of the data subject` AT 1
-- FULFILLED: outside Article 11(2) this sentence does not bar
#TRACE `Art 12(2) the controller shall not refuse to act on the request in the cases referred to in Article 11(2)` NOTHING FALSE AT 0 WITH
    PARTY controller DOES `Art 12(2) refuse to act on the request of the data subject` AT 1
-- no refusal: the prohibition stands, unbroken
#TRACE `Art 12(2) the controller shall not refuse to act on the request in the cases referred to in Article 11(2)` (JUST TRUE) FALSE AT 0 WITH
    (WAITUNTIL 1000)

§ `Art 12(3) first and second sentences: one month, extended by two further months`

-- one month
#ASSERT `Art 12(3) the months within which the information on action taken is to be provided` FALSE EQUALS 1
-- one month extended by two further months
#ASSERT `Art 12(3) the months within which the information on action taken is to be provided` TRUE EQUALS 3
-- provided on the last day of the month: 15 March to 15 April
#ASSERT `Art 12(3) the controller provides information on action taken on the request without undue delay and within one month of receipt of the request` (Date 15 3 2026) (Date 15 4 2026) TRUE FALSE EQUALS JUST TRUE
-- one day after the month: 'in any event within one month'
#ASSERT `Art 12(3) the controller provides information on action taken on the request without undue delay and within one month of receipt of the request` (Date 15 3 2026) (Date 16 4 2026) TRUE FALSE EQUALS JUST FALSE
-- provided on the day of receipt
#ASSERT `Art 12(3) the controller provides information on action taken on the request without undue delay and within one month of receipt of the request` (Date 15 3 2026) (Date 15 3 2026) TRUE FALSE EQUALS JUST TRUE
-- 31 January plus one month ends on 28 February (the month is short)
#ASSERT `Art 12(3) the controller provides information on action taken on the request without undue delay and within one month of receipt of the request` (Date 31 1 2026) (Date 28 2 2026) TRUE FALSE EQUALS JUST TRUE
-- 1 March is after the month that began on 31 January
#ASSERT `Art 12(3) the controller provides information on action taken on the request without undue delay and within one month of receipt of the request` (Date 31 1 2026) (Date 1 3 2026) TRUE FALSE EQUALS JUST FALSE
-- extended by two further months: three months in all, last day
#ASSERT `Art 12(3) the controller provides information on action taken on the request without undue delay and within one month of receipt of the request` (Date 15 1 2026) (Date 15 4 2026) TRUE TRUE EQUALS JUST TRUE
-- extended, one day after the three months
#ASSERT `Art 12(3) the controller provides information on action taken on the request without undue delay and within one month of receipt of the request` (Date 15 1 2026) (Date 16 4 2026) TRUE TRUE EQUALS JUST FALSE
-- no extension: 20 February is after one month from 15 January
#ASSERT `Art 12(3) the controller provides information on action taken on the request without undue delay and within one month of receipt of the request` (Date 15 1 2026) (Date 20 2 2026) TRUE FALSE EQUALS JUST FALSE
-- within the month but with undue delay: 'without undue delay'
#ASSERT `Art 12(3) the controller provides information on action taken on the request without undue delay and within one month of receipt of the request` (Date 15 3 2026) (Date 20 3 2026) FALSE FALSE EQUALS JUST FALSE
-- necessary, taking into account the complexity and number of the requests
#ASSERT `Art 12(3) the period may be extended by two further months` TRUE EQUALS JUST TRUE
-- not necessary: 'where necessary' (a failed 'where', ruling (b))
#ASSERT `Art 12(3) the period may be extended by two further months` FALSE EQUALS JUST FALSE
-- no extension: 'any such extension' is not met, the text is silent
#ASSERT `Art 12(3) the controller informs the data subject of the extension within one month of receipt of the request, together with the reasons for the delay` FALSE (Date 10 1 2026) (Date 10 2 2026) TRUE EQUALS NOTHING
-- informed on the last day of the month with the reasons
#ASSERT `Art 12(3) the controller informs the data subject of the extension within one month of receipt of the request, together with the reasons for the delay` TRUE (Date 10 1 2026) (Date 10 2 2026) TRUE EQUALS JUST `the duty arises and is met`
-- informed one day after the month
#ASSERT `Art 12(3) the controller informs the data subject of the extension within one month of receipt of the request, together with the reasons for the delay` TRUE (Date 10 1 2026) (Date 11 2 2026) TRUE EQUALS JUST `the duty arises and is not met`
-- informed in time but without the reasons for the delay
#ASSERT `Art 12(3) the controller informs the data subject of the extension within one month of receipt of the request, together with the reasons for the delay` TRUE (Date 10 1 2026) (Date 20 1 2026) FALSE EQUALS JUST `the duty arises and is not met`
-- FULFILLED: provided at month 1, the last moment of the first month (the deadline is inclusive)
#TRACE `Art 12(3) the controller must provide the data subject with information on action taken on the request` FALSE AT 0 WITH
    PARTY controller DOES `Art 12(3) provide the data subject with information on action taken on the request` AT 1
-- BREACH: provided at month 2, after one month, with no extension
#TRACE `Art 12(3) the controller must provide the data subject with information on action taken on the request` FALSE AT 0 WITH
    PARTY controller DOES `Art 12(3) provide the data subject with information on action taken on the request` AT 2
-- BREACH: nothing provided by month 2
#TRACE `Art 12(3) the controller must provide the data subject with information on action taken on the request` FALSE AT 0 WITH
    (WAITUNTIL 2)
-- extended by two further months: at month 2 the obligation still stands (residual)
#TRACE `Art 12(3) the controller must provide the data subject with information on action taken on the request` TRUE AT 0 WITH
    (WAITUNTIL 2)
-- BREACH: extended, nothing provided by month 4 (three months allowed)
#TRACE `Art 12(3) the controller must provide the data subject with information on action taken on the request` TRUE AT 0 WITH
    (WAITUNTIL 4)
-- FULFILLED: extended, provided at month 3
#TRACE `Art 12(3) the controller must provide the data subject with information on action taken on the request` TRUE AT 0 WITH
    PARTY controller DOES `Art 12(3) provide the data subject with information on action taken on the request` AT 3
-- FULFILLED: the extension notified at month 1
#TRACE `Art 12(3) the controller must inform the data subject of the extension within one month of receipt of the request` TRUE AT 0 WITH
    PARTY controller DOES `Art 12(3) inform the data subject of the extension, with the reasons for the delay` AT 1
-- BREACH: an extension and no notice within one month
#TRACE `Art 12(3) the controller must inform the data subject of the extension within one month of receipt of the request` TRUE AT 0 WITH
    (WAITUNTIL 2)
-- FULFILLED: no extension, nothing to inform of
#TRACE `Art 12(3) the controller must inform the data subject of the extension within one month of receipt of the request` FALSE AT 0 WITH
    (WAITUNTIL 2)

§ `Art 12(3) fourth sentence: by electronic means where the request is by electronic form means`

-- electronic request, possible, not requested otherwise, provided electronically
#ASSERT `Art 12(3) the information is provided by electronic means where the request is made by electronic form means` TRUE TRUE FALSE TRUE EQUALS JUST `the duty arises and is met`
-- electronic request, possible, not requested otherwise, but provided on paper
#ASSERT `Art 12(3) the information is provided by electronic means where the request is made by electronic form means` TRUE TRUE FALSE FALSE EQUALS JUST `the duty arises and is not met`
-- the request was not made by electronic form means: 'Where' fails
#ASSERT `Art 12(3) the information is provided by electronic means where the request is made by electronic form means` FALSE TRUE FALSE FALSE EQUALS JUST `the duty does not arise`
-- not possible: 'where possible'
#ASSERT `Art 12(3) the information is provided by electronic means where the request is made by electronic form means` TRUE FALSE FALSE FALSE EQUALS JUST `the duty does not arise`
-- the data subject requested otherwise: 'unless otherwise requested'
#ASSERT `Art 12(3) the information is provided by electronic means where the request is made by electronic form means` TRUE TRUE TRUE FALSE EQUALS JUST `the duty does not arise`

§ `Art 12(4): the reasons for not taking action`

-- the controller does take action: 'If the controller does not take action' fails
#ASSERT `Art 12(4) the controller informs the data subject of the reasons for not taking action and of the possibilities of a complaint and a judicial remedy` FALSE (Date 1 2 2026) (Date 1 3 2026) TRUE TRUE TRUE TRUE EQUALS JUST `the duty does not arise`
-- no action; informed on the last day of the month, without delay, with the three contents
#ASSERT `Art 12(4) the controller informs the data subject of the reasons for not taking action and of the possibilities of a complaint and a judicial remedy` TRUE (Date 1 2 2026) (Date 1 3 2026) TRUE TRUE TRUE TRUE EQUALS JUST `the duty arises and is met`
-- informed one day after the month
#ASSERT `Art 12(4) the controller informs the data subject of the reasons for not taking action and of the possibilities of a complaint and a judicial remedy` TRUE (Date 1 2 2026) (Date 2 3 2026) TRUE TRUE TRUE TRUE EQUALS JUST `the duty arises and is not met`
-- within the month but not 'without delay'
#ASSERT `Art 12(4) the controller informs the data subject of the reasons for not taking action and of the possibilities of a complaint and a judicial remedy` TRUE (Date 1 2 2026) (Date 5 2 2026) FALSE TRUE TRUE TRUE EQUALS JUST `the duty arises and is not met`
-- no reasons for not taking action
#ASSERT `Art 12(4) the controller informs the data subject of the reasons for not taking action and of the possibilities of a complaint and a judicial remedy` TRUE (Date 1 2 2026) (Date 5 2 2026) TRUE FALSE TRUE TRUE EQUALS JUST `the duty arises and is not met`
-- no mention of the possibility of lodging a complaint with a supervisory authority
#ASSERT `Art 12(4) the controller informs the data subject of the reasons for not taking action and of the possibilities of a complaint and a judicial remedy` TRUE (Date 1 2 2026) (Date 5 2 2026) TRUE TRUE FALSE TRUE EQUALS JUST `the duty arises and is not met`
-- no mention of the possibility of seeking a judicial remedy
#ASSERT `Art 12(4) the controller informs the data subject of the reasons for not taking action and of the possibilities of a complaint and a judicial remedy` TRUE (Date 1 2 2026) (Date 5 2 2026) TRUE TRUE TRUE FALSE EQUALS JUST `the duty arises and is not met`
-- FULFILLED: informed at month 1
#TRACE `Art 12(4) the controller must inform the data subject of the reasons for not taking action within one month of receipt of the request` TRUE AT 0 WITH
    PARTY controller DOES `Art 12(4) inform the data subject of the reasons for not taking action and of the possibilities of a complaint and a judicial remedy` AT 1
-- BREACH: no action taken and no reasons given within one month
#TRACE `Art 12(4) the controller must inform the data subject of the reasons for not taking action within one month of receipt of the request` TRUE AT 0 WITH
    (WAITUNTIL 2)
-- FULFILLED: the controller takes action, so this duty does not arise
#TRACE `Art 12(4) the controller must inform the data subject of the reasons for not taking action within one month of receipt of the request` FALSE AT 0 WITH
    (WAITUNTIL 2)

§ `Art 12(5): free of charge, a reasonable fee, refusal, the burden`

-- no fee charged
#ASSERT `Art 12(5) the information, communication or action is provided free of charge` FALSE EQUALS JUST TRUE
-- a fee is charged: 'shall be provided free of charge'
#ASSERT `Art 12(5) the information, communication or action is provided free of charge` TRUE EQUALS JUST FALSE
-- manifestly unfounded or excessive, demonstrated, reasonable fee
#ASSERT `Art 12(5)(a) the controller may charge a reasonable fee` TRUE TRUE TRUE EQUALS JUST TRUE
-- the request is not manifestly unfounded or excessive: 'Where' fails
#ASSERT `Art 12(5)(a) the controller may charge a reasonable fee` FALSE TRUE TRUE EQUALS JUST FALSE
-- the controller has not borne the burden of demonstrating the character of the request
#ASSERT `Art 12(5)(a) the controller may charge a reasonable fee` TRUE FALSE TRUE EQUALS JUST FALSE
-- a fee that is not reasonable or not based on the administrative costs is outside the grant, which the text limits by its own wording
#ASSERT `Art 12(5)(a) the controller may charge a reasonable fee` TRUE TRUE FALSE EQUALS NOTHING
-- none of the three
#ASSERT `Art 12(5)(a) the controller may charge a reasonable fee` FALSE FALSE FALSE EQUALS JUST FALSE
-- manifestly unfounded or excessive and demonstrated
#ASSERT `Art 12(5)(b) the controller may refuse to act on the request` TRUE TRUE EQUALS JUST TRUE
-- not manifestly unfounded or excessive
#ASSERT `Art 12(5)(b) the controller may refuse to act on the request` FALSE TRUE EQUALS JUST FALSE
-- the burden of demonstrating has not been borne
#ASSERT `Art 12(5)(b) the controller may refuse to act on the request` TRUE FALSE EQUALS JUST FALSE
-- demonstrated
#ASSERT `Art 12(5) the controller has borne the burden of demonstrating the manifestly unfounded or excessive character of the request` TRUE EQUALS JUST TRUE
-- not demonstrated: 'shall bear the burden of demonstrating'
#ASSERT `Art 12(5) the controller has borne the burden of demonstrating the manifestly unfounded or excessive character of the request` FALSE EQUALS JUST FALSE

§ `Art 12(6): additional information to confirm identity`

-- reasonable doubts, and the information is necessary to confirm identity
#ASSERT `Art 12(6) the controller may request the provision of additional information necessary to confirm the identity of the data subject` TRUE TRUE EQUALS JUST TRUE
-- no reasonable doubts: 'where' fails
#ASSERT `Art 12(6) the controller may request the provision of additional information necessary to confirm the identity of the data subject` FALSE TRUE EQUALS JUST FALSE
-- reasonable doubts, but the information asked for is not necessary to confirm identity: outside the grant
#ASSERT `Art 12(6) the controller may request the provision of additional information necessary to confirm the identity of the data subject` TRUE FALSE EQUALS NOTHING
-- no reasonable doubts and not necessary
#ASSERT `Art 12(6) the controller may request the provision of additional information necessary to confirm the identity of the data subject` FALSE FALSE EQUALS JUST FALSE

§ `Art 12(7): standardised icons`

-- information under Article 13 or 14
#ASSERT `Art 12(7) the information may be provided in combination with standardised icons` TRUE EQUALS JUST TRUE
-- information under another Article: outside the grant, and the text does not say no
#ASSERT `Art 12(7) the information may be provided in combination with standardised icons` FALSE EQUALS NOTHING
-- presented electronically and machine-readable
#ASSERT `Art 12(7) the icons presented electronically are machine-readable` TRUE TRUE EQUALS JUST `the duty arises and is met`
-- presented electronically and not machine-readable: 'shall be machine-readable'
#ASSERT `Art 12(7) the icons presented electronically are machine-readable` TRUE FALSE EQUALS JUST `the duty arises and is not met`
-- not presented electronically: 'Where' fails
#ASSERT `Art 12(7) the icons presented electronically are machine-readable` FALSE TRUE EQUALS JUST `the duty does not arise`
-- not presented electronically, not machine-readable: the duty does not arise
#ASSERT `Art 12(7) the icons presented electronically are machine-readable` FALSE FALSE EQUALS JUST `the duty does not arise`

§ `Art 12(3) third sentence and Art 12(4): the months allowed (R10)`

-- 'within one month of receipt of the request': one month, with no extension of its own
#ASSERT `Art 12(3) the months within which the data subject is to be informed of the extension` EQUALS 1
-- 'without delay and at the latest within one month of receipt of the request'
#ASSERT `Art 12(4) the months within which the data subject is to be informed of the reasons for not taking action` EQUALS 1
