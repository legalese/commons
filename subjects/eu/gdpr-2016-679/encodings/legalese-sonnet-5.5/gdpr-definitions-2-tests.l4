IMPORT prelude
IMPORT `gdpr-core`
IMPORT `gdpr-core-2`
IMPORT `gdpr-definitions-2`

-- ============================================================================
-- gdpr-definitions-2-tests.l4 -- tests of Art 4 lead-in and points (3), (4), (5), (9) to (26).
-- Every expected value is written from the text of the point (src:36-73), never from the output of
-- the functions.  For each point: a case that meets every element, one case for each element the
-- text requires failing alone, and a case just outside.  JUST TRUE is the text's yes, JUST FALSE the
-- "means" no, NOTHING is not covered.  Booleans are positional, in the order of the GIVEN.
-- ============================================================================

§ `Art 4 lead-in: the definitions are for the purposes of this Regulation`

-- the term is used in this Regulation: the lead-in says the definitions are for its purposes
#ASSERT `Art 4 lead-in the definitions of Article 4 apply to the term` TRUE EQUALS JUST TRUE
-- a use outside this Regulation: the lead-in is silent
#ASSERT `Art 4 lead-in the definitions of Article 4 apply to the term` FALSE EQUALS NOTHING

§ `Art 4(3): restriction of processing = marking of stored personal data with the aim of limiting their processing in the future`

-- stored data, marked, with the stated aim
#ASSERT `Art 4(3) the act is a restriction of processing` TRUE TRUE TRUE EQUALS JUST TRUE
-- the data are not stored (they are in transit): the definition says 'stored personal data'
#ASSERT `Art 4(3) the act is a restriction of processing` FALSE TRUE TRUE EQUALS JUST FALSE
-- the data are erased, not marked: the definition says 'the marking'
#ASSERT `Art 4(3) the act is a restriction of processing` TRUE FALSE TRUE EQUALS JUST FALSE
-- marked for another aim (a billing label): the definition requires the aim of limiting future processing
#ASSERT `Art 4(3) the act is a restriction of processing` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 4(3) the act is a restriction of processing` FALSE FALSE FALSE EQUALS JUST FALSE

§ `Art 4(4): profiling = automated processing of personal data to evaluate certain personal aspects relating to a natural person`

-- the aspect evaluated is: performance at work
#ASSERT `Art 4(4) the processing is profiling` TRUE TRUE (LIST `Art 4(4) performance at work`) TRUE EQUALS JUST TRUE
-- the aspect evaluated is: economic situation
#ASSERT `Art 4(4) the processing is profiling` TRUE TRUE (LIST `Art 4(4) economic situation`) TRUE EQUALS JUST TRUE
-- the aspect evaluated is: health
#ASSERT `Art 4(4) the processing is profiling` TRUE TRUE (LIST `Art 4(4) health`) TRUE EQUALS JUST TRUE
-- the aspect evaluated is: personal preferences
#ASSERT `Art 4(4) the processing is profiling` TRUE TRUE (LIST `Art 4(4) personal preferences`) TRUE EQUALS JUST TRUE
-- the aspect evaluated is: interests
#ASSERT `Art 4(4) the processing is profiling` TRUE TRUE (LIST `Art 4(4) interests`) TRUE EQUALS JUST TRUE
-- the aspect evaluated is: reliability
#ASSERT `Art 4(4) the processing is profiling` TRUE TRUE (LIST `Art 4(4) reliability`) TRUE EQUALS JUST TRUE
-- the aspect evaluated is: behaviour
#ASSERT `Art 4(4) the processing is profiling` TRUE TRUE (LIST `Art 4(4) behaviour`) TRUE EQUALS JUST TRUE
-- the aspect evaluated is: location
#ASSERT `Art 4(4) the processing is profiling` TRUE TRUE (LIST `Art 4(4) location`) TRUE EQUALS JUST TRUE
-- the aspect evaluated is: movements
#ASSERT `Art 4(4) the processing is profiling` TRUE TRUE (LIST `Art 4(4) movements`) TRUE EQUALS JUST TRUE
-- the aspect evaluated is: some other personal aspect
#ASSERT `Art 4(4) the processing is profiling` TRUE TRUE (LIST `Art 4(4) some other personal aspect`) TRUE EQUALS JUST TRUE
-- several aspects at once
#ASSERT `Art 4(4) the processing is profiling` TRUE TRUE (LIST `Art 4(4) health`, `Art 4(4) location`, `Art 4(4) movements`) TRUE EQUALS JUST TRUE
-- the processing is not of personal data
#ASSERT `Art 4(4) the processing is profiling` FALSE TRUE (LIST `Art 4(4) behaviour`) TRUE EQUALS JUST FALSE
-- the evaluation is made by hand: the definition says 'automated processing'
#ASSERT `Art 4(4) the processing is profiling` TRUE FALSE (LIST `Art 4(4) behaviour`) TRUE EQUALS JUST FALSE
-- nothing is evaluated: the definition requires the use 'to evaluate certain personal aspects'
#ASSERT `Art 4(4) the processing is profiling` TRUE TRUE EMPTY TRUE EQUALS JUST FALSE
-- the aspects do not relate to a natural person (a company's finances)
#ASSERT `Art 4(4) the processing is profiling` TRUE TRUE (LIST `Art 4(4) economic situation`) FALSE EQUALS JUST FALSE

§ `Art 4(5): pseudonymisation`

-- all four elements
#ASSERT `Art 4(5) the processing is pseudonymisation` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- not processing of personal data
#ASSERT `Art 4(5) the processing is pseudonymisation` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
-- the data can still be attributed to a specific data subject without additional information
#ASSERT `Art 4(5) the processing is pseudonymisation` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
-- the additional information is kept with the data: the 'provided that' proviso fails
#ASSERT `Art 4(5) the processing is pseudonymisation` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
-- the additional information is kept separately but is not subject to technical and organisational measures: the proviso fails
#ASSERT `Art 4(5) the processing is pseudonymisation` TRUE TRUE TRUE FALSE EQUALS JUST FALSE

§ `Art 4(9): recipient`

-- a natural person to which the personal data are disclosed, not a third party
#ASSERT `Art 4(9) the body is a recipient` `natural person` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- a natural person to which the personal data are disclosed, a third party: 'whether a third party or not'
#ASSERT `Art 4(9) the body is a recipient` `natural person` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- a legal person to which the personal data are disclosed, not a third party
#ASSERT `Art 4(9) the body is a recipient` `legal person` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- a legal person to which the personal data are disclosed, a third party: 'whether a third party or not'
#ASSERT `Art 4(9) the body is a recipient` `legal person` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- a public authority to which the personal data are disclosed, not a third party
#ASSERT `Art 4(9) the body is a recipient` `public authority` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- a public authority to which the personal data are disclosed, a third party: 'whether a third party or not'
#ASSERT `Art 4(9) the body is a recipient` `public authority` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- a agency to which the personal data are disclosed, not a third party
#ASSERT `Art 4(9) the body is a recipient` `agency` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- a agency to which the personal data are disclosed, a third party: 'whether a third party or not'
#ASSERT `Art 4(9) the body is a recipient` `agency` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- a other body to which the personal data are disclosed, not a third party
#ASSERT `Art 4(9) the body is a recipient` `other body` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- a other body to which the personal data are disclosed, a third party: 'whether a third party or not'
#ASSERT `Art 4(9) the body is a recipient` `other body` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- a tool is none of the bodies the definition names
#ASSERT `Art 4(9) the body is a recipient` `not a person or body` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- the personal data are not disclosed to it
#ASSERT `Art 4(9) the body is a recipient` `legal person` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- a public authority receiving data in a particular inquiry in accordance with law 'shall not be regarded as recipients'
#ASSERT `Art 4(9) the body is a recipient` `public authority` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
-- the exception holds whether or not the authority is a third party
#ASSERT `Art 4(9) the body is a recipient` `public authority` TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- an inquiry, but the receipt is not in accordance with Union or Member State law: the exception does not hold
#ASSERT `Art 4(9) the body is a recipient` `public authority` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
-- in accordance with law, but not in the framework of a particular inquiry: the exception does not hold
#ASSERT `Art 4(9) the body is a recipient` `public authority` TRUE FALSE FALSE TRUE EQUALS JUST TRUE
-- the exception names public authorities only
#ASSERT `Art 4(9) the body is a recipient` `legal person` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
-- the exception names public authorities only
#ASSERT `Art 4(9) the body is a recipient` `agency` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
-- those public authorities process in compliance with the applicable rules
#ASSERT `Art 4(9) the processing by the public authority of the data it receives in a particular inquiry is in compliance with the applicable data protection rules` `public authority` TRUE TRUE TRUE EQUALS JUST TRUE
-- those public authorities process, and the processing is not in compliance: 'shall be in compliance'
#ASSERT `Art 4(9) the processing by the public authority of the data it receives in a particular inquiry is in compliance with the applicable data protection rules` `public authority` TRUE TRUE FALSE EQUALS JUST FALSE
-- a body that is not a public authority is outside 'those public authorities'
#ASSERT `Art 4(9) the processing by the public authority of the data it receives in a particular inquiry is in compliance with the applicable data protection rules` `legal person` TRUE TRUE TRUE EQUALS NOTHING
-- not in the framework of a particular inquiry: outside 'those public authorities'
#ASSERT `Art 4(9) the processing by the public authority of the data it receives in a particular inquiry is in compliance with the applicable data protection rules` `public authority` FALSE TRUE TRUE EQUALS NOTHING
-- the receipt is not in accordance with Union or Member State law: outside 'those public authorities'
#ASSERT `Art 4(9) the processing by the public authority of the data it receives in a particular inquiry is in compliance with the applicable data protection rules` `public authority` TRUE FALSE FALSE EQUALS NOTHING

-- The regulative rule: the party does the act (FULFILLED), and the obligation stands when nothing happens.
-- It states no time limit and no consequence, so no trace of it breaches (NOTES: Rules with no breach path).
#TRACE `Art 4(9) the public authority must process the data it receives in a particular inquiry in compliance with the applicable data protection rules` AT 0 WITH
    PARTY `Art 4(9) public authority receiving personal data in a particular inquiry` DOES `Art 4(9) process the data in compliance with the applicable data protection rules according to the purposes of the processing` AT 5

#TRACE `Art 4(9) the public authority must process the data it receives in a particular inquiry in compliance with the applicable data protection rules` AT 0 WITH
    (WAITUNTIL 1000)

§ `Art 4(10): third party`

-- a natural person that is none of the excluded persons
#ASSERT `Art 4(10) the body is a third party` `natural person` FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- a legal person that is none of the excluded persons
#ASSERT `Art 4(10) the body is a third party` `legal person` FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- a public authority that is none of the excluded persons
#ASSERT `Art 4(10) the body is a third party` `public authority` FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- a agency that is none of the excluded persons
#ASSERT `Art 4(10) the body is a third party` `agency` FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- a other body that is none of the excluded persons
#ASSERT `Art 4(10) the body is a third party` `other body` FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- a tool is none of the bodies the definition names
#ASSERT `Art 4(10) the body is a third party` `not a person or body` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- the data subject is excluded: 'other than the data subject'
#ASSERT `Art 4(10) the body is a third party` `natural person` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- the controller is excluded
#ASSERT `Art 4(10) the body is a third party` `legal person` FALSE TRUE FALSE FALSE EQUALS JUST FALSE
-- the processor is excluded
#ASSERT `Art 4(10) the body is a third party` `legal person` FALSE FALSE TRUE FALSE EQUALS JUST FALSE
-- a person under the direct authority of the controller or processor authorised to process personal data is excluded
#ASSERT `Art 4(10) the body is a third party` `natural person` FALSE FALSE FALSE TRUE EQUALS JUST FALSE
-- every exclusion at once
#ASSERT `Art 4(10) the body is a third party` `natural person` TRUE TRUE TRUE TRUE EQUALS JUST FALSE

§ `Art 4(11): consent`

-- freely given, specific, informed, unambiguous, of the data subject's wishes, signified by a statement, to the processing of personal data relating to him or her
#ASSERT `Art 4(11) the indication is the consent of the data subject` TRUE TRUE TRUE TRUE TRUE `Art 4(11) by a statement` TRUE EQUALS JUST TRUE
-- the same, signified by a clear affirmative action (a ticked box)
#ASSERT `Art 4(11) the indication is the consent of the data subject` TRUE TRUE TRUE TRUE TRUE `Art 4(11) by a clear affirmative action` TRUE EQUALS JUST TRUE
-- signified by silence or a pre-ticked box: neither a statement nor a clear affirmative action
#ASSERT `Art 4(11) the indication is the consent of the data subject` TRUE TRUE TRUE TRUE TRUE `Art 4(11) in some other way, with no statement and no clear affirmative action` TRUE EQUALS JUST FALSE
-- not freely given
#ASSERT `Art 4(11) the indication is the consent of the data subject` FALSE TRUE TRUE TRUE TRUE `Art 4(11) by a statement` TRUE EQUALS JUST FALSE
-- not specific
#ASSERT `Art 4(11) the indication is the consent of the data subject` TRUE FALSE TRUE TRUE TRUE `Art 4(11) by a statement` TRUE EQUALS JUST FALSE
-- not informed
#ASSERT `Art 4(11) the indication is the consent of the data subject` TRUE TRUE FALSE TRUE TRUE `Art 4(11) by a statement` TRUE EQUALS JUST FALSE
-- not unambiguous
#ASSERT `Art 4(11) the indication is the consent of the data subject` TRUE TRUE TRUE FALSE TRUE `Art 4(11) by a statement` TRUE EQUALS JUST FALSE
-- not an indication of the data subject's wishes (given by someone else)
#ASSERT `Art 4(11) the indication is the consent of the data subject` TRUE TRUE TRUE TRUE FALSE `Art 4(11) by a statement` TRUE EQUALS JUST FALSE
-- the agreement is not to the processing of personal data relating to him or her (it is to a term of a contract)
#ASSERT `Art 4(11) the indication is the consent of the data subject` TRUE TRUE TRUE TRUE TRUE `Art 4(11) by a statement` FALSE EQUALS JUST FALSE

§ `Art 4(12): personal data breach`

-- a breach of security leading to: accidental destruction of personal data
#ASSERT `Art 4(12) the incident is a personal data breach` TRUE (LIST `Art 4(12) accidental destruction of personal data`) TRUE EQUALS JUST TRUE
-- a breach of security leading to: unlawful destruction of personal data
#ASSERT `Art 4(12) the incident is a personal data breach` TRUE (LIST `Art 4(12) unlawful destruction of personal data`) TRUE EQUALS JUST TRUE
-- a breach of security leading to: accidental loss of personal data
#ASSERT `Art 4(12) the incident is a personal data breach` TRUE (LIST `Art 4(12) accidental loss of personal data`) TRUE EQUALS JUST TRUE
-- a breach of security leading to: unlawful loss of personal data
#ASSERT `Art 4(12) the incident is a personal data breach` TRUE (LIST `Art 4(12) unlawful loss of personal data`) TRUE EQUALS JUST TRUE
-- a breach of security leading to: accidental alteration of personal data
#ASSERT `Art 4(12) the incident is a personal data breach` TRUE (LIST `Art 4(12) accidental alteration of personal data`) TRUE EQUALS JUST TRUE
-- a breach of security leading to: unlawful alteration of personal data
#ASSERT `Art 4(12) the incident is a personal data breach` TRUE (LIST `Art 4(12) unlawful alteration of personal data`) TRUE EQUALS JUST TRUE
-- a breach of security leading to: unauthorised disclosure of personal data
#ASSERT `Art 4(12) the incident is a personal data breach` TRUE (LIST `Art 4(12) unauthorised disclosure of personal data`) TRUE EQUALS JUST TRUE
-- a breach of security leading to: unauthorised access to personal data
#ASSERT `Art 4(12) the incident is a personal data breach` TRUE (LIST `Art 4(12) unauthorised access to personal data`) TRUE EQUALS JUST TRUE
-- two consequences at once
#ASSERT `Art 4(12) the incident is a personal data breach` TRUE (LIST `Art 4(12) accidental loss of personal data`, `Art 4(12) unauthorised access to personal data`) TRUE EQUALS JUST TRUE
-- a consequence the definition does not name, with one it does
#ASSERT `Art 4(12) the incident is a personal data breach` TRUE (LIST `Art 4(12) some other consequence`, `Art 4(12) unauthorised access to personal data`) TRUE EQUALS JUST TRUE
-- a breach of security that leads only to a consequence the definition does not name (for example a delay)
#ASSERT `Art 4(12) the incident is a personal data breach` TRUE (LIST `Art 4(12) some other consequence`) TRUE EQUALS JUST FALSE
-- a breach of security that leads to nothing the definition names
#ASSERT `Art 4(12) the incident is a personal data breach` TRUE EMPTY TRUE EQUALS JUST FALSE
-- no breach of security
#ASSERT `Art 4(12) the incident is a personal data breach` FALSE (LIST `Art 4(12) unauthorised access to personal data`) TRUE EQUALS JUST FALSE
-- the data are not personal data transmitted, stored or otherwise processed
#ASSERT `Art 4(12) the incident is a personal data breach` TRUE (LIST `Art 4(12) unauthorised access to personal data`) FALSE EQUALS JUST FALSE

§ `Art 4(13): genetic data`

-- personal data relating to inherited or acquired genetic characteristics, giving unique information about physiology or health, from an analysis of a biological sample
#ASSERT `Art 4(13) the data are genetic data` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- the same, not from a sample analysis: 'in particular' makes the analysis an example
#ASSERT `Art 4(13) the data are genetic data` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
-- not personal data
#ASSERT `Art 4(13) the data are genetic data` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
-- the data do not relate to genetic characteristics
#ASSERT `Art 4(13) the data are genetic data` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
-- the data give no unique information about the physiology or the health of the person
#ASSERT `Art 4(13) the data are genetic data` TRUE TRUE FALSE TRUE EQUALS JUST FALSE

§ `Art 4(14): biometric data`

-- facial images from specific technical processing, allowing unique identification
#ASSERT `Art 4(14) the data are biometric data` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- a voice print: 'such as' makes facial images and dactyloscopic data examples
#ASSERT `Art 4(14) the data are biometric data` TRUE TRUE TRUE TRUE FALSE EQUALS JUST TRUE
-- not personal data
#ASSERT `Art 4(14) the data are biometric data` FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- a photograph not resulting from specific technical processing
#ASSERT `Art 4(14) the data are biometric data` TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
-- the data do not relate to physical, physiological or behavioural characteristics
#ASSERT `Art 4(14) the data are biometric data` TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
-- the data neither allow nor confirm unique identification
#ASSERT `Art 4(14) the data are biometric data` TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE

§ `Art 4(15): data concerning health`

-- personal data related to physical or mental health that reveal the health status
#ASSERT `Art 4(15) the data are data concerning health` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
-- personal data related to the provision of health care services that reveal the health status: 'including the provision of health care services'
#ASSERT `Art 4(15) the data are data concerning health` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
-- both relations
#ASSERT `Art 4(15) the data are data concerning health` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- related neither to health nor to health care
#ASSERT `Art 4(15) the data are data concerning health` TRUE FALSE FALSE TRUE EQUALS JUST FALSE
-- related to health but revealing no information about the health status (an appointment time)
#ASSERT `Art 4(15) the data are data concerning health` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- not personal data
#ASSERT `Art 4(15) the data are data concerning health` FALSE TRUE TRUE TRUE EQUALS JUST FALSE

§ `Art 4(13) to (15): the categories of Article 9(1) that the three definitions give`

-- genetic data only
#ASSERT `Art 4(13) to (15) the categories of Article 9(1) that the data fall in by these definitions` (JUST TRUE) (JUST FALSE) FALSE (JUST FALSE) EQUALS JUST (LIST `Art 9(1) genetic data`)
-- biometric data processed to uniquely identify a natural person
#ASSERT `Art 4(13) to (15) the categories of Article 9(1) that the data fall in by these definitions` (JUST FALSE) (JUST TRUE) TRUE (JUST FALSE) EQUALS JUST (LIST `Art 9(1) biometric data for the purpose of uniquely identifying a natural person`)
-- biometric data processed for another purpose: Art 9(1) names biometric data only 'for the purpose of uniquely identifying a natural person', so this is the member just outside
#ASSERT `Art 4(13) to (15) the categories of Article 9(1) that the data fall in by these definitions` (JUST FALSE) (JUST TRUE) FALSE (JUST FALSE) EQUALS JUST (LIST `Art 9(1) biometric data not for the purpose of uniquely identifying a natural person`)
-- data concerning health only
#ASSERT `Art 4(13) to (15) the categories of Article 9(1) that the data fall in by these definitions` (JUST FALSE) (JUST FALSE) FALSE (JUST TRUE) EQUALS JUST (LIST `Art 9(1) data concerning health`)
-- genetic data that are also data concerning health: both categories, in the order genetic, biometric, health
#ASSERT `Art 4(13) to (15) the categories of Article 9(1) that the data fall in by these definitions` (JUST TRUE) (JUST FALSE) FALSE (JUST TRUE) EQUALS JUST (LIST `Art 9(1) genetic data`, `Art 9(1) data concerning health`)
-- all three
#ASSERT `Art 4(13) to (15) the categories of Article 9(1) that the data fall in by these definitions` (JUST TRUE) (JUST TRUE) TRUE (JUST TRUE) EQUALS JUST (LIST `Art 9(1) genetic data`, `Art 9(1) biometric data for the purpose of uniquely identifying a natural person`, `Art 9(1) data concerning health`)
-- none of the three definitions is met: no category from these three (the five other categories of Art 9(1) are not defined in Art 4)
#ASSERT `Art 4(13) to (15) the categories of Article 9(1) that the data fall in by these definitions` (JUST FALSE) (JUST FALSE) FALSE (JUST FALSE) EQUALS JUST EMPTY
-- no definition gives an answer
#ASSERT `Art 4(13) to (15) the categories of Article 9(1) that the data fall in by these definitions` NOTHING NOTHING FALSE NOTHING EQUALS NOTHING
-- two definitions say no and one gives no answer
#ASSERT `Art 4(13) to (15) the categories of Article 9(1) that the data fall in by these definitions` (JUST FALSE) (JUST FALSE) FALSE NOTHING EQUALS NOTHING
-- CHANGED after the adversarial review (R3, wrong answer): this case used to expect JUST (LIST genetic data), on the old comment that the category is given whatever the others answer.
-- That list was incomplete: two of the three definitions give no answer, and either may be met too, so the list is not decided.
-- The list function now answers NOTHING whenever any definition answers NOTHING; the single-choice function below keeps its answer.
#ASSERT `Art 4(13) to (15) the categories of Article 9(1) that the data fall in by these definitions` (JUST TRUE) NOTHING FALSE NOTHING EQUALS NOTHING
-- each position of NOTHING with a definition that is met elsewhere: not decided (R3: genetic data met, data concerning health gives no answer)
#ASSERT `Art 4(13) to (15) the categories of Article 9(1) that the data fall in by these definitions` (JUST TRUE) (JUST FALSE) FALSE NOTHING EQUALS NOTHING
#ASSERT `Art 4(13) to (15) the categories of Article 9(1) that the data fall in by these definitions` (JUST TRUE) NOTHING FALSE (JUST FALSE) EQUALS NOTHING
#ASSERT `Art 4(13) to (15) the categories of Article 9(1) that the data fall in by these definitions` NOTHING (JUST TRUE) TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `Art 4(13) to (15) the categories of Article 9(1) that the data fall in by these definitions` (JUST FALSE) (JUST TRUE) TRUE NOTHING EQUALS NOTHING
#ASSERT `Art 4(13) to (15) the categories of Article 9(1) that the data fall in by these definitions` NOTHING (JUST FALSE) FALSE (JUST TRUE) EQUALS NOTHING
#ASSERT `Art 4(13) to (15) the categories of Article 9(1) that the data fall in by these definitions` (JUST FALSE) NOTHING FALSE (JUST TRUE) EQUALS NOTHING
-- each position of NOTHING with the other two saying no: not decided
#ASSERT `Art 4(13) to (15) the categories of Article 9(1) that the data fall in by these definitions` NOTHING (JUST FALSE) FALSE (JUST FALSE) EQUALS NOTHING
#ASSERT `Art 4(13) to (15) the categories of Article 9(1) that the data fall in by these definitions` (JUST FALSE) NOTHING FALSE (JUST FALSE) EQUALS NOTHING
-- two definitions met and the third gives no answer: not decided
#ASSERT `Art 4(13) to (15) the categories of Article 9(1) that the data fall in by these definitions` (JUST TRUE) (JUST TRUE) TRUE NOTHING EQUALS NOTHING
-- genetic data only
#ASSERT `Art 4(13) to (15) the category of Article 9(1) that the data fall in by these definitions` (JUST TRUE) (JUST FALSE) FALSE (JUST FALSE) EQUALS JUST `Art 9(1) genetic data`
-- biometric data to uniquely identify
#ASSERT `Art 4(13) to (15) the category of Article 9(1) that the data fall in by these definitions` (JUST FALSE) (JUST TRUE) TRUE (JUST FALSE) EQUALS JUST `Art 9(1) biometric data for the purpose of uniquely identifying a natural person`
-- biometric data for another purpose
#ASSERT `Art 4(13) to (15) the category of Article 9(1) that the data fall in by these definitions` (JUST FALSE) (JUST TRUE) FALSE (JUST FALSE) EQUALS JUST `Art 9(1) biometric data not for the purpose of uniquely identifying a natural person`
-- health only
#ASSERT `Art 4(13) to (15) the category of Article 9(1) that the data fall in by these definitions` (JUST FALSE) (JUST FALSE) FALSE (JUST TRUE) EQUALS JUST `Art 9(1) data concerning health`
-- genetic and health: the first in the order genetic, biometric, health
#ASSERT `Art 4(13) to (15) the category of Article 9(1) that the data fall in by these definitions` (JUST TRUE) (JUST FALSE) FALSE (JUST TRUE) EQUALS JUST `Art 9(1) genetic data`
-- none of the three definitions is met: the data may be in one of the five categories Art 4 does not define, or in none
#ASSERT `Art 4(13) to (15) the category of Article 9(1) that the data fall in by these definitions` (JUST FALSE) (JUST FALSE) FALSE (JUST FALSE) EQUALS NOTHING
-- no definition gives an answer
#ASSERT `Art 4(13) to (15) the category of Article 9(1) that the data fall in by these definitions` NOTHING NOTHING FALSE NOTHING EQUALS NOTHING
-- the single-choice function keeps its meaning (R3): any definition that is met brings the data into Art 9(1), whatever the others answer
#ASSERT `Art 4(13) to (15) the category of Article 9(1) that the data fall in by these definitions` (JUST TRUE) (JUST FALSE) FALSE NOTHING EQUALS JUST `Art 9(1) genetic data`
#ASSERT `Art 4(13) to (15) the category of Article 9(1) that the data fall in by these definitions` (JUST TRUE) NOTHING FALSE NOTHING EQUALS JUST `Art 9(1) genetic data`
#ASSERT `Art 4(13) to (15) the category of Article 9(1) that the data fall in by these definitions` NOTHING (JUST TRUE) TRUE (JUST FALSE) EQUALS JUST `Art 9(1) biometric data for the purpose of uniquely identifying a natural person`
#ASSERT `Art 4(13) to (15) the category of Article 9(1) that the data fall in by these definitions` NOTHING (JUST TRUE) FALSE NOTHING EQUALS JUST `Art 9(1) biometric data not for the purpose of uniquely identifying a natural person`
#ASSERT `Art 4(13) to (15) the category of Article 9(1) that the data fall in by these definitions` NOTHING (JUST FALSE) FALSE (JUST TRUE) EQUALS JUST `Art 9(1) data concerning health`
-- none is met and one gives no answer: not decided
#ASSERT `Art 4(13) to (15) the category of Article 9(1) that the data fall in by these definitions` (JUST FALSE) (JUST FALSE) FALSE NOTHING EQUALS NOTHING
#ASSERT `Art 4(13) to (15) the category of Article 9(1) that the data fall in by these definitions` (JUST FALSE) NOTHING FALSE (JUST FALSE) EQUALS NOTHING

§ `Art 4(16)(a): main establishment of a controller`

-- establishments in more than one Member State, central administration in the Union, decisions taken there
#ASSERT `Art 4(16)(a) the main establishment of a controller` TRUE TRUE FALSE FALSE EQUALS JUST `Art 4(16)(a) the place of the controller's central administration in the Union`
-- the decisions are taken in another establishment in the Union that has the power to have them implemented: the 'unless' holds
#ASSERT `Art 4(16)(a) the main establishment of a controller` TRUE TRUE TRUE TRUE EQUALS JUST `Art 4(16)(a) the establishment of the controller that took the decisions on the purposes and means`
-- decisions taken elsewhere but that establishment lacks the power: the 'unless' does not hold
#ASSERT `Art 4(16)(a) the main establishment of a controller` TRUE TRUE TRUE FALSE EQUALS JUST `Art 4(16)(a) the place of the controller's central administration in the Union`
-- the power without the decisions being taken there: the 'unless' does not hold
#ASSERT `Art 4(16)(a) the main establishment of a controller` TRUE TRUE FALSE TRUE EQUALS JUST `Art 4(16)(a) the place of the controller's central administration in the Union`
-- central administration outside the Union, but the decisions are taken in another Union establishment with the power
#ASSERT `Art 4(16)(a) the main establishment of a controller` TRUE FALSE TRUE TRUE EQUALS JUST `Art 4(16)(a) the establishment of the controller that took the decisions on the purposes and means`
-- central administration outside the Union and no exception: the text names only a central administration in the Union
#ASSERT `Art 4(16)(a) the main establishment of a controller` TRUE FALSE FALSE FALSE EQUALS NOTHING
-- establishments in one Member State only: outside 'with establishments in more than one Member State'
#ASSERT `Art 4(16)(a) the main establishment of a controller` FALSE TRUE FALSE FALSE EQUALS NOTHING
-- establishments in one Member State only, even with the exception's facts
#ASSERT `Art 4(16)(a) the main establishment of a controller` FALSE TRUE TRUE TRUE EQUALS NOTHING

§ `Art 4(16)(b): main establishment of a processor`

-- central administration in the Union
#ASSERT `Art 4(16)(b) the main establishment of a processor` TRUE TRUE FALSE FALSE EQUALS JUST `Art 4(16)(b) the place of the processor's central administration in the Union`
-- central administration in the Union: the second limb is only for a processor with none
#ASSERT `Art 4(16)(b) the main establishment of a processor` TRUE TRUE TRUE TRUE EQUALS JUST `Art 4(16)(b) the place of the processor's central administration in the Union`
-- no central administration in the Union: the establishment where the main processing activities take place, the processor being subject to specific obligations
#ASSERT `Art 4(16)(b) the main establishment of a processor` TRUE FALSE TRUE TRUE EQUALS JUST `Art 4(16)(b) the establishment of the processor in the Union where the main processing activities take place`
-- no central administration in the Union and not subject to specific obligations: 'to the extent that the processor is subject to specific obligations'
#ASSERT `Art 4(16)(b) the main establishment of a processor` TRUE FALSE TRUE FALSE EQUALS NOTHING
-- no central administration in the Union and no such establishment: the text is silent
#ASSERT `Art 4(16)(b) the main establishment of a processor` TRUE FALSE FALSE TRUE EQUALS NOTHING
-- nothing in the Union
#ASSERT `Art 4(16)(b) the main establishment of a processor` TRUE FALSE FALSE FALSE EQUALS NOTHING
-- establishments in one Member State only: outside 'with establishments in more than one Member State'
#ASSERT `Art 4(16)(b) the main establishment of a processor` FALSE TRUE TRUE TRUE EQUALS NOTHING

§ `Art 4(17): representative`

-- a natural person established in the Union, designated in writing, representing the controller or processor
#ASSERT `Art 4(17) the person is a representative` `natural person` TRUE TRUE TRUE EQUALS JUST TRUE
-- a legal person
#ASSERT `Art 4(17) the person is a representative` `legal person` TRUE TRUE TRUE EQUALS JUST TRUE
-- the definition says 'a natural or legal person': public authority
#ASSERT `Art 4(17) the person is a representative` `public authority` TRUE TRUE TRUE EQUALS JUST FALSE
-- the definition says 'a natural or legal person': agency
#ASSERT `Art 4(17) the person is a representative` `agency` TRUE TRUE TRUE EQUALS JUST FALSE
-- the definition says 'a natural or legal person': other body
#ASSERT `Art 4(17) the person is a representative` `other body` TRUE TRUE TRUE EQUALS JUST FALSE
-- the definition says 'a natural or legal person': not a person or body
#ASSERT `Art 4(17) the person is a representative` `not a person or body` TRUE TRUE TRUE EQUALS JUST FALSE
-- not established in the Union
#ASSERT `Art 4(17) the person is a representative` `legal person` FALSE TRUE TRUE EQUALS JUST FALSE
-- not designated in writing pursuant to Article 27
#ASSERT `Art 4(17) the person is a representative` `legal person` TRUE FALSE TRUE EQUALS JUST FALSE
-- does not represent the controller or processor with regard to their obligations
#ASSERT `Art 4(17) the person is a representative` `legal person` TRUE TRUE FALSE EQUALS JUST FALSE

§ `Art 4(18): enterprise`

-- a natural person engaged in an economic activity
#ASSERT `Art 4(18) the body is an enterprise` `natural person` TRUE FALSE FALSE EQUALS JUST TRUE
-- a legal person engaged in an economic activity
#ASSERT `Art 4(18) the body is an enterprise` `legal person` TRUE FALSE FALSE EQUALS JUST TRUE
-- a natural person not engaged in an economic activity
#ASSERT `Art 4(18) the body is an enterprise` `natural person` FALSE FALSE FALSE EQUALS JUST FALSE
-- a legal person not engaged in an economic activity
#ASSERT `Art 4(18) the body is an enterprise` `legal person` FALSE FALSE FALSE EQUALS JUST FALSE
-- 'including partnerships or associations regularly engaged in an economic activity'
#ASSERT `Art 4(18) the body is an enterprise` `other body` FALSE TRUE TRUE EQUALS JUST TRUE
-- a partnership regularly engaged
#ASSERT `Art 4(18) the body is an enterprise` `other body` TRUE TRUE TRUE EQUALS JUST TRUE
-- a partnership engaged only occasionally: the text names those 'regularly engaged' and says nothing of others
#ASSERT `Art 4(18) the body is an enterprise` `other body` TRUE TRUE FALSE EQUALS NOTHING
-- an other body engaged in an economic activity that is not a partnership or association: the text does not say
#ASSERT `Art 4(18) the body is an enterprise` `other body` TRUE FALSE FALSE EQUALS NOTHING
-- a public authority engaged in an economic activity: the text does not say
#ASSERT `Art 4(18) the body is an enterprise` `public authority` TRUE FALSE FALSE EQUALS NOTHING
-- an agency engaged in an economic activity: the text does not say
#ASSERT `Art 4(18) the body is an enterprise` `agency` TRUE FALSE FALSE EQUALS NOTHING
-- a tool is neither a natural or legal person nor a partnership or association
#ASSERT `Art 4(18) the body is an enterprise` `not a person or body` TRUE FALSE FALSE EQUALS JUST FALSE

§ `Art 4(19): group of undertakings`

-- a controlling undertaking and its controlled undertakings
#ASSERT `Art 4(19) the set of undertakings is a group of undertakings` TRUE TRUE EQUALS JUST TRUE
-- no controlling undertaking in the set
#ASSERT `Art 4(19) the set of undertakings is a group of undertakings` FALSE TRUE EQUALS JUST FALSE
-- a controlling undertaking, but the others are not controlled by it
#ASSERT `Art 4(19) the set of undertakings is a group of undertakings` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 4(19) the set of undertakings is a group of undertakings` FALSE FALSE EQUALS JUST FALSE

§ `Art 4(20): binding corporate rules`

-- within a group of undertakings
#ASSERT `Art 4(20) the policies are binding corporate rules` TRUE TRUE TRUE TRUE TRUE FALSE EQUALS JUST TRUE
-- within a group of enterprises engaged in a joint economic activity
#ASSERT `Art 4(20) the policies are binding corporate rules` TRUE TRUE TRUE TRUE FALSE TRUE EQUALS JUST TRUE
-- both
#ASSERT `Art 4(20) the policies are binding corporate rules` TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- within neither kind of group
#ASSERT `Art 4(20) the policies are binding corporate rules` TRUE TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
-- not personal data protection policies
#ASSERT `Art 4(20) the policies are binding corporate rules` FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- not adhered to by a controller or processor established on the territory of a Member State
#ASSERT `Art 4(20) the policies are binding corporate rules` TRUE FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- not for transfers of personal data
#ASSERT `Art 4(20) the policies are binding corporate rules` TRUE TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
-- not for transfers to a controller or processor in a third country
#ASSERT `Art 4(20) the policies are binding corporate rules` TRUE TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE

§ `Art 4(21): supervisory authority`

-- an independent public authority established by a Member State pursuant to Article 51
#ASSERT `Art 4(21) the body is a supervisory authority` `public authority` TRUE TRUE TRUE EQUALS JUST TRUE
-- not a public authority: natural person
#ASSERT `Art 4(21) the body is a supervisory authority` `natural person` TRUE TRUE TRUE EQUALS JUST FALSE
-- not a public authority: legal person
#ASSERT `Art 4(21) the body is a supervisory authority` `legal person` TRUE TRUE TRUE EQUALS JUST FALSE
-- not a public authority: agency
#ASSERT `Art 4(21) the body is a supervisory authority` `agency` TRUE TRUE TRUE EQUALS JUST FALSE
-- not a public authority: other body
#ASSERT `Art 4(21) the body is a supervisory authority` `other body` TRUE TRUE TRUE EQUALS JUST FALSE
-- not a public authority: not a person or body
#ASSERT `Art 4(21) the body is a supervisory authority` `not a person or body` TRUE TRUE TRUE EQUALS JUST FALSE
-- not independent
#ASSERT `Art 4(21) the body is a supervisory authority` `public authority` FALSE TRUE TRUE EQUALS JUST FALSE
-- not established by a Member State
#ASSERT `Art 4(21) the body is a supervisory authority` `public authority` TRUE FALSE TRUE EQUALS JUST FALSE
-- not established pursuant to Article 51
#ASSERT `Art 4(21) the body is a supervisory authority` `public authority` TRUE TRUE FALSE EQUALS JUST FALSE

§ `Art 4(22): supervisory authority concerned`

-- (a): the controller or processor is established in its Member State
#ASSERT `Art 4(22) the supervisory authority is a supervisory authority concerned by the processing` TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- (b): data subjects residing in its Member State are substantially affected
#ASSERT `Art 4(22) the supervisory authority is a supervisory authority concerned by the processing` TRUE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- (b): data subjects residing in its Member State are likely to be substantially affected
#ASSERT `Art 4(22) the supervisory authority is a supervisory authority concerned by the processing` TRUE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
-- (c): a complaint has been lodged with it
#ASSERT `Art 4(22) the supervisory authority is a supervisory authority concerned by the processing` TRUE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- all grounds
#ASSERT `Art 4(22) the supervisory authority is a supervisory authority concerned by the processing` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- a supervisory authority concerned on no ground
#ASSERT `Art 4(22) the supervisory authority is a supervisory authority concerned by the processing` TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- the body is not a supervisory authority
#ASSERT `Art 4(22) the supervisory authority is a supervisory authority concerned by the processing` FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE

§ `Art 4(23): cross-border processing`

-- (a): in the context of the activities of establishments in more than one Member State, the controller or processor being established in more than one
#ASSERT `Art 4(23) the processing is cross-border processing` TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- (a) without the 'where': established in one Member State only, and (b) not met
#ASSERT `Art 4(23) the processing is cross-border processing` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- (b): a single establishment, substantially affecting data subjects in more than one Member State
#ASSERT `Art 4(23) the processing is cross-border processing` TRUE FALSE FALSE TRUE TRUE FALSE EQUALS JUST TRUE
-- (b): a single establishment, likely to substantially affect data subjects in more than one Member State
#ASSERT `Art 4(23) the processing is cross-border processing` TRUE FALSE FALSE TRUE FALSE TRUE EQUALS JUST TRUE
-- (a) fails its 'where' but (b) holds: the limbs are alternatives
#ASSERT `Art 4(23) the processing is cross-border processing` TRUE TRUE FALSE TRUE TRUE FALSE EQUALS JUST TRUE
-- a single establishment, no substantial effect in more than one Member State
#ASSERT `Art 4(23) the processing is cross-border processing` TRUE FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
-- not in the context of the activities of an establishment of either kind
#ASSERT `Art 4(23) the processing is cross-border processing` TRUE FALSE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
-- not processing of personal data
#ASSERT `Art 4(23) the processing is cross-border processing` FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE

§ `Art 4(24): relevant and reasoned objection`

-- to a draft decision, on infringement or compliance, clearly demonstrating the risks to rights and freedoms; the free flow is not at issue so 'where applicable' is not asked
#ASSERT `Art 4(24) the objection is a relevant and reasoned objection` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- the free flow is at issue and the risks to it are clearly demonstrated
#ASSERT `Art 4(24) the objection is a relevant and reasoned objection` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- the free flow is at issue and the risks to it are not demonstrated: the 'where applicable' gate fails (periods ruling (b))
#ASSERT `Art 4(24) the objection is a relevant and reasoned objection` TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- not an objection to a draft decision
#ASSERT `Art 4(24) the objection is a relevant and reasoned objection` FALSE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
-- not as to whether there is an infringement or whether the envisaged action complies
#ASSERT `Art 4(24) the objection is a relevant and reasoned objection` TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
-- does not clearly demonstrate the significance of the risks to the fundamental rights and freedoms of data subjects
#ASSERT `Art 4(24) the objection is a relevant and reasoned objection` TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE

§ `Art 4(25): information society service`

-- a service as defined in point (b) of Article 1(1) of Directive (EU) 2015/1535 (the borrowed fact, taken as input)
#ASSERT `Art 4(25) the service is an information society service` TRUE EQUALS JUST TRUE
-- not such a service
#ASSERT `Art 4(25) the service is an information society service` FALSE EQUALS JUST FALSE

§ `Art 4(26): international organisation`

-- an organisation governed by public international law, or a subordinate body of one
#ASSERT `Art 4(26) the body is an international organisation` TRUE FALSE EQUALS JUST TRUE
-- any other body set up by, or on the basis of, an agreement between two or more countries
#ASSERT `Art 4(26) the body is an international organisation` FALSE TRUE EQUALS JUST TRUE
-- both
#ASSERT `Art 4(26) the body is an international organisation` TRUE TRUE EQUALS JUST TRUE
-- neither
#ASSERT `Art 4(26) the body is an international organisation` FALSE FALSE EQUALS JUST FALSE
