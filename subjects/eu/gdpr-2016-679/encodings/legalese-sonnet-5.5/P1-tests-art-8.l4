IMPORT prelude
IMPORT `gdpr-core`
IMPORT `P1-art-8`

-- ============================================================================
-- P1-tests-art-8.l4 -- tests of Art 8.  Expected values written from the text (src:115-118):
-- 16 is the age; a Member State may provide a lower age "not below 13 years"; below the age the processing
-- is lawful "only if and to the extent that consent is given or authorised" by the holder of parental
-- responsibility.  Boundary values on both sides of 16 and of 13.
-- ============================================================================

§ `Art 8(1): the two figures`

#ASSERT `Art 8(1) the age from which a child may consent unless a Member State has provided otherwise` EQUALS 16
#ASSERT `Art 8(1) the lowest age a Member State may provide by law` EQUALS 13

§ `Art 8(1): what a Member State may provide`

#ASSERT `Art 8(1) a Member State may provide by law for the lower age` 12 EQUALS JUST FALSE
#ASSERT `Art 8(1) a Member State may provide by law for the lower age` 0 EQUALS JUST FALSE
-- 13, 14 and 15 are lower than 16 and not below 13
#ASSERT `Art 8(1) a Member State may provide by law for the lower age` 13 EQUALS JUST TRUE
#ASSERT `Art 8(1) a Member State may provide by law for the lower age` 14 EQUALS JUST TRUE
#ASSERT `Art 8(1) a Member State may provide by law for the lower age` 15 EQUALS JUST TRUE
-- not covered: 16 or more is not "a lower age"
#ASSERT `Art 8(1) a Member State may provide by law for the lower age` 16 EQUALS NOTHING
#ASSERT `Art 8(1) a Member State may provide by law for the lower age` 17 EQUALS NOTHING

§ `Art 8(1): the age that applies`

#ASSERT `Art 8(1) the age from which the child may consent in this Member State` NOTHING EQUALS 16
#ASSERT `Art 8(1) the age from which the child may consent in this Member State` (JUST 13) EQUALS 13
#ASSERT `Art 8(1) the age from which the child may consent in this Member State` (JUST 14) EQUALS 14
#ASSERT `Art 8(1) the age from which the child may consent in this Member State` (JUST 15) EQUALS 15
-- a Member State's age below 13 is not allowed by the text: 16 stays (fork F8-1)
#ASSERT `Art 8(1) the age from which the child may consent in this Member State` (JUST 12) EQUALS 16
-- an age that is not lower than 16 changes nothing
#ASSERT `Art 8(1) the age from which the child may consent in this Member State` (JUST 16) EQUALS 16
#ASSERT `Art 8(1) the age from which the child may consent in this Member State` (JUST 17) EQUALS 16

§ `Art 8(1): the processing of a child's personal data on consent, offered information society services directly to a child`

-- no Member State provision: 15 without authorisation, 15 with, 16, 17
#ASSERT `Art 8(1) the processing of a child's personal data meets the condition of Art 8(1)` TRUE TRUE 15 NOTHING FALSE EQUALS JUST FALSE
#ASSERT `Art 8(1) the processing of a child's personal data meets the condition of Art 8(1)` TRUE TRUE 15 NOTHING TRUE EQUALS JUST TRUE
#ASSERT `Art 8(1) the processing of a child's personal data meets the condition of Art 8(1)` TRUE TRUE 16 NOTHING FALSE EQUALS JUST TRUE
#ASSERT `Art 8(1) the processing of a child's personal data meets the condition of Art 8(1)` TRUE TRUE 17 NOTHING FALSE EQUALS JUST TRUE
#ASSERT `Art 8(1) the processing of a child's personal data meets the condition of Art 8(1)` TRUE TRUE 0 NOTHING FALSE EQUALS JUST FALSE
-- a Member State that provides 13: 12 is below it, 13 is at it
#ASSERT `Art 8(1) the processing of a child's personal data meets the condition of Art 8(1)` TRUE TRUE 12 (JUST 13) FALSE EQUALS JUST FALSE
#ASSERT `Art 8(1) the processing of a child's personal data meets the condition of Art 8(1)` TRUE TRUE 12 (JUST 13) TRUE EQUALS JUST TRUE
#ASSERT `Art 8(1) the processing of a child's personal data meets the condition of Art 8(1)` TRUE TRUE 13 (JUST 13) FALSE EQUALS JUST TRUE
#ASSERT `Art 8(1) the processing of a child's personal data meets the condition of Art 8(1)` TRUE TRUE 15 (JUST 13) FALSE EQUALS JUST TRUE
-- a Member State that provides 14
#ASSERT `Art 8(1) the processing of a child's personal data meets the condition of Art 8(1)` TRUE TRUE 13 (JUST 14) FALSE EQUALS JUST FALSE
#ASSERT `Art 8(1) the processing of a child's personal data meets the condition of Art 8(1)` TRUE TRUE 14 (JUST 14) FALSE EQUALS JUST TRUE
-- a Member State that provides 12: not allowed, so 16 applies
#ASSERT `Art 8(1) the processing of a child's personal data meets the condition of Art 8(1)` TRUE TRUE 14 (JUST 12) FALSE EQUALS JUST FALSE
#ASSERT `Art 8(1) the processing of a child's personal data meets the condition of Art 8(1)` TRUE TRUE 16 (JUST 12) FALSE EQUALS JUST TRUE
-- a Member State that provides 16, or 17 (not a lower age)
#ASSERT `Art 8(1) the processing of a child's personal data meets the condition of Art 8(1)` TRUE TRUE 15 (JUST 16) FALSE EQUALS JUST FALSE
#ASSERT `Art 8(1) the processing of a child's personal data meets the condition of Art 8(1)` TRUE TRUE 16 (JUST 17) FALSE EQUALS JUST TRUE
-- "Where point (a) of Article 6(1) applies" fails: a "where" gate, so the text says no (periods ruling (b) of 2026-11-05, taken literally; fork F8-5)
#ASSERT `Art 8(1) the processing of a child's personal data meets the condition of Art 8(1)` FALSE TRUE 5 NOTHING FALSE EQUALS JUST FALSE
#ASSERT `Art 8(1) the processing of a child's personal data meets the condition of Art 8(1)` FALSE FALSE 20 NOTHING TRUE EQUALS JUST FALSE
-- point (a) applies but the services are not offered directly to a child: "in relation to the offer of information society services directly to a child" has no gate word, so NOTHING (periods ruling (c); fork F8-5)
#ASSERT `Art 8(1) the processing of a child's personal data meets the condition of Art 8(1)` TRUE FALSE 5 NOTHING FALSE EQUALS NOTHING
#ASSERT `Art 8(1) the processing of a child's personal data meets the condition of Art 8(1)` TRUE FALSE 20 NOTHING TRUE EQUALS NOTHING

§ `Art 8(1): the cases in which the holder of parental responsibility must consent`

-- the same arms as the decision function above (fork F8-5): below the age consent is needed, at or above it is not, and outside the cases of the paragraph the answer is NOTHING
#ASSERT `Art 8(1) the case is one in which the consent of the holder of parental responsibility is needed` TRUE TRUE 15 NOTHING EQUALS JUST TRUE
#ASSERT `Art 8(1) the case is one in which the consent of the holder of parental responsibility is needed` TRUE TRUE 16 NOTHING EQUALS JUST FALSE
#ASSERT `Art 8(1) the case is one in which the consent of the holder of parental responsibility is needed` TRUE TRUE 12 (JUST 13) EQUALS JUST TRUE
#ASSERT `Art 8(1) the case is one in which the consent of the holder of parental responsibility is needed` TRUE TRUE 13 (JUST 13) EQUALS JUST FALSE
#ASSERT `Art 8(1) the case is one in which the consent of the holder of parental responsibility is needed` TRUE TRUE 15 (JUST 16) EQUALS JUST TRUE
#ASSERT `Art 8(1) the case is one in which the consent of the holder of parental responsibility is needed` TRUE TRUE 12 (JUST 12) EQUALS JUST TRUE
-- Art 6(1)(a) does not apply: "Where point (a) of Article 6(1) applies" fails, JUST FALSE (periods ruling (b); fork F8-5)
#ASSERT `Art 8(1) the case is one in which the consent of the holder of parental responsibility is needed` FALSE TRUE 10 NOTHING EQUALS JUST FALSE
#ASSERT `Art 8(1) the case is one in which the consent of the holder of parental responsibility is needed` FALSE FALSE 10 NOTHING EQUALS JUST FALSE
-- point (a) applies but the services are not offered directly to a child: NOTHING (periods ruling (c); fork F8-5)
#ASSERT `Art 8(1) the case is one in which the consent of the holder of parental responsibility is needed` TRUE FALSE 10 NOTHING EQUALS NOTHING

§ `Art 8(2): verification`

#ASSERT `Art 8(2) the controller makes reasonable efforts to verify that consent is given or authorised, taking available technology into consideration` (JUST TRUE) TRUE TRUE EQUALS JUST `the duty arises and is met`
-- efforts made without taking available technology into consideration
#ASSERT `Art 8(2) the controller makes reasonable efforts to verify that consent is given or authorised, taking available technology into consideration` (JUST TRUE) TRUE FALSE EQUALS JUST `the duty arises and is not met`
#ASSERT `Art 8(2) the controller makes reasonable efforts to verify that consent is given or authorised, taking available technology into consideration` (JUST TRUE) FALSE TRUE EQUALS JUST `the duty arises and is not met`
#ASSERT `Art 8(2) the controller makes reasonable efforts to verify that consent is given or authorised, taking available technology into consideration` (JUST TRUE) FALSE FALSE EQUALS JUST `the duty arises and is not met`
-- "in such cases" only: a 16-year-old, say, or a service not offered to a child. "in such cases" is a scope pointer with no gate word, the same phrase that Art 11(2) second sentence reads as a scope limit, so the answer is NOTHING (periods ruling (c) of 2026-11-05; fork F8-4, the other reading is `the duty does not arise`)
#ASSERT `Art 8(2) the controller makes reasonable efforts to verify that consent is given or authorised, taking available technology into consideration` (JUST FALSE) FALSE FALSE EQUALS NOTHING
#ASSERT `Art 8(2) the controller makes reasonable efforts to verify that consent is given or authorised, taking available technology into consideration` NOTHING FALSE FALSE EQUALS NOTHING
#ASSERT `Art 8(2) the controller makes reasonable efforts to verify that consent is given or authorised, taking available technology into consideration` (JUST FALSE) TRUE TRUE EQUALS NOTHING
-- end to end: a service offered to a 14-year-old in a Member State with no lower age: verification is due
#ASSERT `Art 8(2) the controller makes reasonable efforts to verify that consent is given or authorised, taking available technology into consideration` (`Art 8(1) the case is one in which the consent of the holder of parental responsibility is needed` TRUE TRUE 14 NOTHING) FALSE FALSE EQUALS JUST `the duty arises and is not met`
-- a 16-year-old: not "such cases"
#ASSERT `Art 8(2) the controller makes reasonable efforts to verify that consent is given or authorised, taking available technology into consideration` (`Art 8(1) the case is one in which the consent of the holder of parental responsibility is needed` TRUE TRUE 16 NOTHING) FALSE FALSE EQUALS NOTHING

#TRACE `Art 8(2) the controller must make reasonable efforts to verify` TRUE AT 0 WITH
    PARTY `controller` DOES `Art 8(2) make reasonable efforts to verify that consent is given or authorised by the holder of parental responsibility` AT 2
-- expected: FULFILLED
#TRACE `Art 8(2) the controller must make reasonable efforts to verify` TRUE AT 0 WITH
    (WAITUNTIL 1000)
-- expected: still standing, never a breach (no time limit in the text)
#TRACE `Art 8(2) the controller must make reasonable efforts to verify` FALSE AT 0 WITH
    (WAITUNTIL 1000)
-- expected: FULFILLED (not "such cases")

§ `Art 8(3): general contract law`

#ASSERT `Art 8(3) paragraph 1 affects the rule of the general contract law of a Member State` TRUE `Art 8(3) the validity of a contract in relation to a child` EQUALS JUST FALSE
#ASSERT `Art 8(3) paragraph 1 affects the rule of the general contract law of a Member State` TRUE `Art 8(3) the formation of a contract in relation to a child` EQUALS JUST FALSE
#ASSERT `Art 8(3) paragraph 1 affects the rule of the general contract law of a Member State` TRUE `Art 8(3) the effect of a contract in relation to a child` EQUALS JUST FALSE
#ASSERT `Art 8(3) paragraph 1 affects the rule of the general contract law of a Member State` TRUE `Art 8(3) another rule of general contract law` EQUALS JUST FALSE
-- not covered: a rule that is not part of the general contract law of a Member State (a data protection rule)
#ASSERT `Art 8(3) paragraph 1 affects the rule of the general contract law of a Member State` FALSE `Art 8(3) another rule of general contract law` EQUALS NOTHING
#ASSERT `Art 8(3) paragraph 1 affects the rule of the general contract law of a Member State` FALSE `Art 8(3) the validity of a contract in relation to a child` EQUALS NOTHING
