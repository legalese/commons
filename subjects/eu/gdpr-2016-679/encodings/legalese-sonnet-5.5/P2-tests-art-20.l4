IMPORT prelude
IMPORT `gdpr-core`
IMPORT `P2-art-20`

-- ============================================================================
-- P2-tests-art-20.l4 -- tests of Article 20 (src:253-260).
-- Every expected value was written by hand from the text of the provision named in the comment above it,
-- before the first run, and none was copied from an output (notes/gen-tests-p2.py holds the cases).
-- A #TRACE result is not an assertion and check.sh does not count it; each trace comment gives the expected result.
-- ============================================================================

§ `Art 20(1): the right to receive and the right to transmit`

-- (receive) consent-based, automated, provided by the data subject
#ASSERT `Art 20(1) the data subject has the right to receive the personal data concerning him or her which he or she has provided to a controller, in a structured, commonly used and machine-readable format` TRUE TRUE TRUE TRUE (JUST FALSE) TRUE FALSE NOTHING EQUALS JUST TRUE
-- (receive) based on a contract pursuant to point (b) of Article 6(1)
#ASSERT `Art 20(1) the data subject has the right to receive the personal data concerning him or her which he or she has provided to a controller, in a structured, commonly used and machine-readable format` TRUE TRUE TRUE FALSE (JUST TRUE) TRUE FALSE NOTHING EQUALS JUST TRUE
-- (receive) based on neither consent nor contract: 'where: (a)' fails
#ASSERT `Art 20(1) the data subject has the right to receive the personal data concerning him or her which he or she has provided to a controller, in a structured, commonly used and machine-readable format` TRUE TRUE TRUE FALSE (JUST FALSE) TRUE FALSE NOTHING EQUALS JUST FALSE
-- (receive) not on consent and the contract basis is not decided: not covered
#ASSERT `Art 20(1) the data subject has the right to receive the personal data concerning him or her which he or she has provided to a controller, in a structured, commonly used and machine-readable format` TRUE TRUE TRUE FALSE NOTHING TRUE FALSE NOTHING EQUALS NOTHING
-- (receive) consent-based: the contract limb is not needed
#ASSERT `Art 20(1) the data subject has the right to receive the personal data concerning him or her which he or she has provided to a controller, in a structured, commonly used and machine-readable format` TRUE TRUE TRUE TRUE NOTHING TRUE FALSE NOTHING EQUALS JUST TRUE
-- (receive) not carried out by automated means: 'where: ... (b)' fails
#ASSERT `Art 20(1) the data subject has the right to receive the personal data concerning him or her which he or she has provided to a controller, in a structured, commonly used and machine-readable format` TRUE TRUE TRUE TRUE (JUST FALSE) FALSE FALSE NOTHING EQUALS JUST FALSE
-- (receive) the processing is necessary for a task in the public interest: 'That right shall not apply'
#ASSERT `Art 20(1) the data subject has the right to receive the personal data concerning him or her which he or she has provided to a controller, in a structured, commonly used and machine-readable format` TRUE TRUE TRUE TRUE (JUST FALSE) TRUE TRUE NOTHING EQUALS JUST FALSE
-- (receive) data the data subject did not provide: outside the grant
#ASSERT `Art 20(1) the data subject has the right to receive the personal data concerning him or her which he or she has provided to a controller, in a structured, commonly used and machine-readable format` TRUE TRUE FALSE TRUE (JUST FALSE) TRUE FALSE NOTHING EQUALS NOTHING
-- (receive) Article 11(2) disapplies Articles 15 to 20
#ASSERT `Art 20(1) the data subject has the right to receive the personal data concerning him or her which he or she has provided to a controller, in a structured, commonly used and machine-readable format` TRUE TRUE TRUE TRUE (JUST FALSE) TRUE FALSE (JUST TRUE) EQUALS JUST FALSE
-- (receive) an Article 11(2) case with identifying information: the right applies
#ASSERT `Art 20(1) the data subject has the right to receive the personal data concerning him or her which he or she has provided to a controller, in a structured, commonly used and machine-readable format` TRUE TRUE TRUE TRUE (JUST FALSE) TRUE FALSE (JUST FALSE) EQUALS JUST TRUE
-- (receive) not the data subject
#ASSERT `Art 20(1) the data subject has the right to receive the personal data concerning him or her which he or she has provided to a controller, in a structured, commonly used and machine-readable format` FALSE TRUE TRUE TRUE (JUST FALSE) TRUE FALSE NOTHING EQUALS NOTHING
-- (receive) not the controller
#ASSERT `Art 20(1) the data subject has the right to receive the personal data concerning him or her which he or she has provided to a controller, in a structured, commonly used and machine-readable format` TRUE FALSE TRUE TRUE (JUST FALSE) TRUE FALSE NOTHING EQUALS NOTHING
-- (transmit) consent-based, automated, provided by the data subject
#ASSERT `Art 20(1) the data subject has the right to transmit those data to another controller without hindrance from the controller to which the personal data have been provided` TRUE TRUE TRUE TRUE (JUST FALSE) TRUE FALSE NOTHING EQUALS JUST TRUE
-- (transmit) based on a contract pursuant to point (b) of Article 6(1)
#ASSERT `Art 20(1) the data subject has the right to transmit those data to another controller without hindrance from the controller to which the personal data have been provided` TRUE TRUE TRUE FALSE (JUST TRUE) TRUE FALSE NOTHING EQUALS JUST TRUE
-- (transmit) based on neither consent nor contract: 'where: (a)' fails
#ASSERT `Art 20(1) the data subject has the right to transmit those data to another controller without hindrance from the controller to which the personal data have been provided` TRUE TRUE TRUE FALSE (JUST FALSE) TRUE FALSE NOTHING EQUALS JUST FALSE
-- (transmit) not on consent and the contract basis is not decided: not covered
#ASSERT `Art 20(1) the data subject has the right to transmit those data to another controller without hindrance from the controller to which the personal data have been provided` TRUE TRUE TRUE FALSE NOTHING TRUE FALSE NOTHING EQUALS NOTHING
-- (transmit) consent-based: the contract limb is not needed
#ASSERT `Art 20(1) the data subject has the right to transmit those data to another controller without hindrance from the controller to which the personal data have been provided` TRUE TRUE TRUE TRUE NOTHING TRUE FALSE NOTHING EQUALS JUST TRUE
-- (transmit) not carried out by automated means: 'where: ... (b)' fails
#ASSERT `Art 20(1) the data subject has the right to transmit those data to another controller without hindrance from the controller to which the personal data have been provided` TRUE TRUE TRUE TRUE (JUST FALSE) FALSE FALSE NOTHING EQUALS JUST FALSE
-- (transmit) the processing is necessary for a task in the public interest: 'That right shall not apply'
#ASSERT `Art 20(1) the data subject has the right to transmit those data to another controller without hindrance from the controller to which the personal data have been provided` TRUE TRUE TRUE TRUE (JUST FALSE) TRUE TRUE NOTHING EQUALS JUST FALSE
-- (transmit) data the data subject did not provide: outside the grant
#ASSERT `Art 20(1) the data subject has the right to transmit those data to another controller without hindrance from the controller to which the personal data have been provided` TRUE TRUE FALSE TRUE (JUST FALSE) TRUE FALSE NOTHING EQUALS NOTHING
-- (transmit) Article 11(2) disapplies Articles 15 to 20
#ASSERT `Art 20(1) the data subject has the right to transmit those data to another controller without hindrance from the controller to which the personal data have been provided` TRUE TRUE TRUE TRUE (JUST FALSE) TRUE FALSE (JUST TRUE) EQUALS JUST FALSE
-- (transmit) an Article 11(2) case with identifying information: the right applies
#ASSERT `Art 20(1) the data subject has the right to transmit those data to another controller without hindrance from the controller to which the personal data have been provided` TRUE TRUE TRUE TRUE (JUST FALSE) TRUE FALSE (JUST FALSE) EQUALS JUST TRUE
-- (transmit) not the data subject
#ASSERT `Art 20(1) the data subject has the right to transmit those data to another controller without hindrance from the controller to which the personal data have been provided` FALSE TRUE TRUE TRUE (JUST FALSE) TRUE FALSE NOTHING EQUALS NOTHING
-- (transmit) not the controller
#ASSERT `Art 20(1) the data subject has the right to transmit those data to another controller without hindrance from the controller to which the personal data have been provided` TRUE FALSE TRUE TRUE (JUST FALSE) TRUE FALSE NOTHING EQUALS NOTHING
-- BREACH: the controller hinders a transmission the data subject has the right to make (the act is the breach)
#TRACE `Art 20(1) the controller shall not hinder the transmission of the personal data to another controller` (JUST TRUE) AT 0 WITH
    PARTY controller DOES `Art 20(1) hinder the transmission of the personal data to another controller` AT 1
-- no hindrance: the prohibition stands, unbroken
#TRACE `Art 20(1) the controller shall not hinder the transmission of the personal data to another controller` (JUST TRUE) AT 0 WITH
    (WAITUNTIL 1000)
-- FULFILLED: no right to transmit on these facts, so hindering is not barred by this paragraph
#TRACE `Art 20(1) the controller shall not hinder the transmission of the personal data to another controller` (JUST FALSE) AT 0 WITH
    PARTY controller DOES `Art 20(1) hinder the transmission of the personal data to another controller` AT 1
-- FULFILLED: the right is not established (not covered), so the rule creates no bar
#TRACE `Art 20(1) the controller shall not hinder the transmission of the personal data to another controller` NOTHING AT 0 WITH
    PARTY controller DOES `Art 20(1) hinder the transmission of the personal data to another controller` AT 1

§ `Art 20(2): direct transmission, where technically feasible`

-- in exercising the right of paragraph 1, technically feasible
#ASSERT `Art 20(2) the data subject has the right to have the personal data transmitted directly from one controller to another, where technically feasible` TRUE TRUE TRUE TRUE NOTHING EQUALS JUST TRUE
-- not technically feasible: 'where technically feasible' fails
#ASSERT `Art 20(2) the data subject has the right to have the personal data transmitted directly from one controller to another, where technically feasible` TRUE TRUE TRUE FALSE NOTHING EQUALS JUST FALSE
-- not in exercising the right of paragraph 1: outside the sentence
#ASSERT `Art 20(2) the data subject has the right to have the personal data transmitted directly from one controller to another, where technically feasible` TRUE TRUE FALSE TRUE NOTHING EQUALS NOTHING
-- Article 11(2) disapplies Articles 15 to 20
#ASSERT `Art 20(2) the data subject has the right to have the personal data transmitted directly from one controller to another, where technically feasible` TRUE TRUE TRUE TRUE (JUST TRUE) EQUALS JUST FALSE
-- not the data subject
#ASSERT `Art 20(2) the data subject has the right to have the personal data transmitted directly from one controller to another, where technically feasible` FALSE TRUE TRUE TRUE NOTHING EQUALS NOTHING

§ `Art 20(3) and (4): the limits`

-- the exercise of the right is 'without prejudice to Article 17'
#ASSERT `Art 20(3) the exercise of the right referred to in paragraph 1 prejudices the right to erasure under Article 17` TRUE EQUALS JUST FALSE
-- no exercise of the right: outside the sentence
#ASSERT `Art 20(3) the exercise of the right referred to in paragraph 1 prejudices the right to erasure under Article 17` FALSE EQUALS NOTHING
-- processing necessary for a task in the public interest or official authority: 'That right shall not apply'
#ASSERT `Art 20(3) the right to data portability does not apply to processing necessary for the performance of a task carried out in the public interest or in the exercise of official authority` TRUE EQUALS JUST TRUE
-- other processing: outside the sentence
#ASSERT `Art 20(3) the right to data portability does not apply to processing necessary for the performance of a task carried out in the public interest or in the exercise of official authority` FALSE EQUALS NOTHING
-- the exercise would adversely affect the rights and freedoms of others: 'shall not adversely affect'
#ASSERT `Art 20(4) the right referred to in paragraph 1 is limited because its exercise would adversely affect the rights and freedoms of others` TRUE EQUALS JUST TRUE
-- no adverse effect: the limit is not engaged and the paragraph is silent
#ASSERT `Art 20(4) the right referred to in paragraph 1 is limited because its exercise would adversely affect the rights and freedoms of others` FALSE EQUALS NOTHING

§ `Art 20(1) and (2): the controller must provide the data and transmit them directly (R8)`

-- FULFILLED: the controller provides the data in the format
#TRACE `Art 20(1) the controller must give the data subject the personal data in a structured, commonly used and machine-readable format` (JUST TRUE) AT 0 WITH
    PARTY controller DOES `Art 20(1) provide the data subject with the personal data in a structured, commonly used and machine-readable format` AT 1
-- no act: the obligation stands; no breach is possible (no time limit)
#TRACE `Art 20(1) the controller must give the data subject the personal data in a structured, commonly used and machine-readable format` (JUST TRUE) AT 0 WITH
    (WAITUNTIL 1000)
-- FULFILLED: no right to receive on these facts
#TRACE `Art 20(1) the controller must give the data subject the personal data in a structured, commonly used and machine-readable format` (JUST FALSE) AT 0 WITH
    (WAITUNTIL 1000)
-- FULFILLED: the controller transmits the data directly
#TRACE `Art 20(2) the controller must transmit the personal data directly to another controller` (JUST TRUE) AT 0 WITH
    PARTY controller DOES `Art 20(2) transmit the personal data directly to another controller` AT 1
-- no act: the obligation stands; no breach is possible (no time limit)
#TRACE `Art 20(2) the controller must transmit the personal data directly to another controller` (JUST TRUE) AT 0 WITH
    (WAITUNTIL 1000)
-- FULFILLED: not technically feasible, or no exercise of portability: no right to direct transmission
#TRACE `Art 20(2) the controller must transmit the personal data directly to another controller` (JUST FALSE) AT 0 WITH
    (WAITUNTIL 1000)
-- FULFILLED: the right is not established (not covered)
#TRACE `Art 20(2) the controller must transmit the personal data directly to another controller` NOTHING AT 0 WITH
    (WAITUNTIL 1000)
