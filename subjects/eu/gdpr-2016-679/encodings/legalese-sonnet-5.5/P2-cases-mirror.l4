IMPORT prelude
IMPORT `gdpr-core`
IMPORT `gdpr-definitions-2`
IMPORT `P2-seat-subject`
IMPORT `P2-seat-controller`

-- ============================================================================
-- P2-cases-mirror.l4 -- the same facts put to the data subject's seat and the controller's seat, asserting that the two answers
-- are equal.  Only the questions that both seats ask are mirrored.  Each case is a layer-1 case of notes/gen-tests-p2.py (its
-- expected value was written by hand from the text); a role fact that one seat fixes is TRUE in the case (the data subject and
-- the controller are the two parties of one relation), and a seat that asks it is given TRUE.  A seat asks yes, no or not sure in
-- its own type, so the values are mapped.  The same cases are asserted against their expected values in the two cases files.
-- ============================================================================

-- 12(1)a: Art 12(1) the controller takes appropriate measures to provide the information and communications in a concise, transparent, intelligible and easily accessible form, using clear and plain language
#ASSERT (`Under Article 12(1), as a data subject, is the information and communication I am given in a concise, transparent, intelligible and easily accessible form, using clear and plain language` TRUE TRUE TRUE TRUE TRUE TRUE FALSE) EQUALS (`Under Article 12(1), as a controller, have I taken appropriate measures to provide the information and communications in a concise, transparent, intelligible and easily accessible form, using clear and plain language` TRUE TRUE TRUE TRUE TRUE TRUE FALSE)
#ASSERT (`Under Article 12(1), as a data subject, is the information and communication I am given in a concise, transparent, intelligible and easily accessible form, using clear and plain language` FALSE TRUE TRUE TRUE TRUE TRUE FALSE) EQUALS (`Under Article 12(1), as a controller, have I taken appropriate measures to provide the information and communications in a concise, transparent, intelligible and easily accessible form, using clear and plain language` FALSE TRUE TRUE TRUE TRUE TRUE FALSE)
#ASSERT (`Under Article 12(1), as a data subject, is the information and communication I am given in a concise, transparent, intelligible and easily accessible form, using clear and plain language` TRUE TRUE TRUE TRUE TRUE TRUE TRUE) EQUALS (`Under Article 12(1), as a controller, have I taken appropriate measures to provide the information and communications in a concise, transparent, intelligible and easily accessible form, using clear and plain language` TRUE TRUE TRUE TRUE TRUE TRUE TRUE)

-- 12(1)b: Art 12(1) the information is provided in writing, or by other means, including, where appropriate, by electronic means
#ASSERT (`Under Article 12(1), as a data subject, has the information been provided to me in writing, or by other means` TRUE FALSE FALSE FALSE) EQUALS (`Under Article 12(1), as a controller, have I provided the information in writing, or by other means, including by electronic means where appropriate` TRUE FALSE FALSE FALSE)
#ASSERT (`Under Article 12(1), as a data subject, has the information been provided to me in writing, or by other means` FALSE FALSE FALSE FALSE) EQUALS (`Under Article 12(1), as a controller, have I provided the information in writing, or by other means, including by electronic means where appropriate` FALSE FALSE FALSE FALSE)
#ASSERT (`Under Article 12(1), as a data subject, has the information been provided to me in writing, or by other means` FALSE TRUE FALSE FALSE) EQUALS (`Under Article 12(1), as a controller, have I provided the information in writing, or by other means, including by electronic means where appropriate` FALSE TRUE FALSE FALSE)

-- 12(1)c: Art 12(1) the information may be provided orally
#ASSERT (`Under Article 12(1), as a data subject, may the information be provided to me orally` TRUE TRUE) EQUALS (`Under Article 12(1), as a controller, may I provide the information orally` TRUE TRUE)
#ASSERT (`Under Article 12(1), as a data subject, may the information be provided to me orally` FALSE TRUE) EQUALS (`Under Article 12(1), as a controller, may I provide the information orally` FALSE TRUE)
#ASSERT (`Under Article 12(1), as a data subject, may the information be provided to me orally` TRUE FALSE) EQUALS (`Under Article 12(1), as a controller, may I provide the information orally` TRUE FALSE)

-- 12(2)a: Art 12(2) the controller facilitates the exercise of data subject rights under Articles 15 to 22
#ASSERT (`Under Article 12(2), as a data subject, has the controller facilitated the exercise of my rights under Articles 15 to 22` TRUE) EQUALS (`Under Article 12(2), as a controller, have I facilitated the exercise of data subject rights under Articles 15 to 22` TRUE)
#ASSERT (`Under Article 12(2), as a data subject, has the controller facilitated the exercise of my rights under Articles 15 to 22` FALSE) EQUALS (`Under Article 12(2), as a controller, have I facilitated the exercise of data subject rights under Articles 15 to 22` FALSE)

-- 12(2)b: Art 12(2) the controller shall not refuse to act on the request of the data subject in the cases referred to in Article 11(2)
#ASSERT (`Under Article 12(2), as a data subject, is the controller barred from refusing to act on my request in the cases referred to in Article 11(2)` FALSE FALSE FALSE) EQUALS (`Under Article 12(2), as a controller, am I barred from refusing to act on the data subject's request in the cases referred to in Article 11(2)` FALSE FALSE FALSE)
#ASSERT (`Under Article 12(2), as a data subject, is the controller barred from refusing to act on my request in the cases referred to in Article 11(2)` TRUE FALSE FALSE) EQUALS (`Under Article 12(2), as a controller, am I barred from refusing to act on the data subject's request in the cases referred to in Article 11(2)` TRUE FALSE FALSE)
#ASSERT (`Under Article 12(2), as a data subject, is the controller barred from refusing to act on my request in the cases referred to in Article 11(2)` TRUE FALSE TRUE) EQUALS (`Under Article 12(2), as a controller, am I barred from refusing to act on the data subject's request in the cases referred to in Article 11(2)` TRUE FALSE TRUE)

-- 12(3)m: Art 12(3) the months within which the information on action taken is to be provided
#ASSERT (`Under Article 12(3), as a data subject, within how many months must the controller provide me with information on action taken on my request` FALSE) EQUALS (`Under Article 12(3), as a controller, within how many months must I provide the data subject with information on action taken on the request` FALSE)
#ASSERT (`Under Article 12(3), as a data subject, within how many months must the controller provide me with information on action taken on my request` TRUE) EQUALS (`Under Article 12(3), as a controller, within how many months must I provide the data subject with information on action taken on the request` TRUE)

-- 12(3)a: Art 12(3) the controller provides information on action taken on the request without undue delay and within one month of receipt of the request
#ASSERT (`Under Article 12(3), as a data subject, was I given information on action taken on my request without undue delay and within one month of receipt of the request` (Date 15 3 2026) (Date 15 4 2026) TRUE FALSE) EQUALS (`Under Article 12(3), as a controller, did I provide information on action taken on the request without undue delay and within one month of its receipt` (Date 15 3 2026) (Date 15 4 2026) TRUE FALSE)
#ASSERT (`Under Article 12(3), as a data subject, was I given information on action taken on my request without undue delay and within one month of receipt of the request` (Date 15 3 2026) (Date 16 4 2026) TRUE FALSE) EQUALS (`Under Article 12(3), as a controller, did I provide information on action taken on the request without undue delay and within one month of its receipt` (Date 15 3 2026) (Date 16 4 2026) TRUE FALSE)
#ASSERT (`Under Article 12(3), as a data subject, was I given information on action taken on my request without undue delay and within one month of receipt of the request` (Date 15 3 2026) (Date 15 3 2026) TRUE FALSE) EQUALS (`Under Article 12(3), as a controller, did I provide information on action taken on the request without undue delay and within one month of its receipt` (Date 15 3 2026) (Date 15 3 2026) TRUE FALSE)

-- 12(3)b: Art 12(3) the period may be extended by two further months
#ASSERT (`Under Article 12(3), as a data subject, may the period for acting on my request be extended by two further months` TRUE) EQUALS (`Under Article 12(3), as a controller, may I extend the period by two further months` TRUE)
#ASSERT (`Under Article 12(3), as a data subject, may the period for acting on my request be extended by two further months` FALSE) EQUALS (`Under Article 12(3), as a controller, may I extend the period by two further months` FALSE)

-- 12(3)c: Art 12(3) the controller informs the data subject of the extension within one month of receipt of the request, together with the reasons for the delay
#ASSERT (`Under Article 12(3), as a data subject, was I informed of the extension within one month of receipt of my request, together with the reasons for the delay` FALSE (Date 10 1 2026) (Date 10 2 2026) TRUE) EQUALS (`Under Article 12(3), as a controller, have I informed the data subject of the extension within one month of receipt of the request, together with the reasons for the delay` FALSE (Date 10 1 2026) (Date 10 2 2026) TRUE)
#ASSERT (`Under Article 12(3), as a data subject, was I informed of the extension within one month of receipt of my request, together with the reasons for the delay` TRUE (Date 10 1 2026) (Date 10 2 2026) TRUE) EQUALS (`Under Article 12(3), as a controller, have I informed the data subject of the extension within one month of receipt of the request, together with the reasons for the delay` TRUE (Date 10 1 2026) (Date 10 2 2026) TRUE)
#ASSERT (`Under Article 12(3), as a data subject, was I informed of the extension within one month of receipt of my request, together with the reasons for the delay` TRUE (Date 10 1 2026) (Date 11 2 2026) TRUE) EQUALS (`Under Article 12(3), as a controller, have I informed the data subject of the extension within one month of receipt of the request, together with the reasons for the delay` TRUE (Date 10 1 2026) (Date 11 2 2026) TRUE)

-- 12(3)n: Art 12(3) the months within which the data subject is to be informed of the extension
#ASSERT (`Under Article 12(3), as a data subject, within how many months must the controller inform me of any extension of the period`) EQUALS (`Under Article 12(3), as a controller, within how many months must I inform the data subject of any extension of the period`)

-- 12(3)d: Art 12(3) the information is provided by electronic means where the request is made by electronic form means
#ASSERT (`Under Article 12(3), as a data subject, has the information been provided to me by electronic means, where I made my request by electronic form means` TRUE TRUE FALSE TRUE) EQUALS (`Under Article 12(3), as a controller, have I provided the information by electronic means, where the request was made by electronic form means` TRUE TRUE FALSE TRUE)
#ASSERT (`Under Article 12(3), as a data subject, has the information been provided to me by electronic means, where I made my request by electronic form means` TRUE TRUE FALSE FALSE) EQUALS (`Under Article 12(3), as a controller, have I provided the information by electronic means, where the request was made by electronic form means` TRUE TRUE FALSE FALSE)
#ASSERT (`Under Article 12(3), as a data subject, has the information been provided to me by electronic means, where I made my request by electronic form means` FALSE TRUE FALSE FALSE) EQUALS (`Under Article 12(3), as a controller, have I provided the information by electronic means, where the request was made by electronic form means` FALSE TRUE FALSE FALSE)

-- 12(4): Art 12(4) the controller informs the data subject of the reasons for not taking action and of the possibilities of a complaint and a judicial remedy
#ASSERT (`Under Article 12(4), as a data subject, was I informed of the reasons for not taking action on my request and of the possibilities of a complaint and a judicial remedy` FALSE (Date 1 2 2026) (Date 1 3 2026) TRUE TRUE TRUE TRUE) EQUALS (`Under Article 12(4), as a controller, where I do not take action on a request, have I informed the data subject of the reasons and of the possibilities of lodging a complaint and seeking a judicial remedy` FALSE (Date 1 2 2026) (Date 1 3 2026) TRUE TRUE TRUE TRUE)
#ASSERT (`Under Article 12(4), as a data subject, was I informed of the reasons for not taking action on my request and of the possibilities of a complaint and a judicial remedy` TRUE (Date 1 2 2026) (Date 1 3 2026) TRUE TRUE TRUE TRUE) EQUALS (`Under Article 12(4), as a controller, where I do not take action on a request, have I informed the data subject of the reasons and of the possibilities of lodging a complaint and seeking a judicial remedy` TRUE (Date 1 2 2026) (Date 1 3 2026) TRUE TRUE TRUE TRUE)
#ASSERT (`Under Article 12(4), as a data subject, was I informed of the reasons for not taking action on my request and of the possibilities of a complaint and a judicial remedy` TRUE (Date 1 2 2026) (Date 2 3 2026) TRUE TRUE TRUE TRUE) EQUALS (`Under Article 12(4), as a controller, where I do not take action on a request, have I informed the data subject of the reasons and of the possibilities of lodging a complaint and seeking a judicial remedy` TRUE (Date 1 2 2026) (Date 2 3 2026) TRUE TRUE TRUE TRUE)

-- 12(4)n: Art 12(4) the months within which the data subject is to be informed of the reasons for not taking action
#ASSERT (`Under Article 12(4), as a data subject, within how many months must the controller inform me of the reasons for not taking action on my request`) EQUALS (`Under Article 12(4), as a controller, within how many months must I inform the data subject of the reasons for not taking action on the request`)

-- 12(5)a: Art 12(5) the information, communication or action is provided free of charge
#ASSERT (`Under Article 12(5), as a data subject, was the information, communication or action provided to me free of charge` FALSE) EQUALS (`Under Article 12(5), as a controller, have I provided the information, communication or action free of charge` FALSE)
#ASSERT (`Under Article 12(5), as a data subject, was the information, communication or action provided to me free of charge` TRUE) EQUALS (`Under Article 12(5), as a controller, have I provided the information, communication or action free of charge` TRUE)

-- 12(5)b: Art 12(5)(a) the controller may charge a reasonable fee
#ASSERT (`Under Article 12(5), as a data subject, may the controller charge me a reasonable fee for my request` TRUE TRUE TRUE) EQUALS (`Under Article 12(5), as a controller, may I charge a reasonable fee for a request that is manifestly unfounded or excessive` TRUE TRUE TRUE)
#ASSERT (`Under Article 12(5), as a data subject, may the controller charge me a reasonable fee for my request` FALSE TRUE TRUE) EQUALS (`Under Article 12(5), as a controller, may I charge a reasonable fee for a request that is manifestly unfounded or excessive` FALSE TRUE TRUE)
#ASSERT (`Under Article 12(5), as a data subject, may the controller charge me a reasonable fee for my request` TRUE TRUE FALSE) EQUALS (`Under Article 12(5), as a controller, may I charge a reasonable fee for a request that is manifestly unfounded or excessive` TRUE TRUE FALSE)

-- 12(5)c: Art 12(5)(b) the controller may refuse to act on the request
#ASSERT (`Under Article 12(5), as a data subject, may the controller refuse to act on my request` TRUE TRUE) EQUALS (`Under Article 12(5), as a controller, may I refuse to act on a request that is manifestly unfounded or excessive` TRUE TRUE)
#ASSERT (`Under Article 12(5), as a data subject, may the controller refuse to act on my request` FALSE TRUE) EQUALS (`Under Article 12(5), as a controller, may I refuse to act on a request that is manifestly unfounded or excessive` FALSE TRUE)
#ASSERT (`Under Article 12(5), as a data subject, may the controller refuse to act on my request` TRUE FALSE) EQUALS (`Under Article 12(5), as a controller, may I refuse to act on a request that is manifestly unfounded or excessive` TRUE FALSE)

-- 12(5)d: Art 12(5) the controller has borne the burden of demonstrating the manifestly unfounded or excessive character of the request
#ASSERT (`Under Article 12(5), as a data subject, has the controller borne the burden of demonstrating that my request is manifestly unfounded or excessive` TRUE) EQUALS (`Under Article 12(5), as a controller, have I borne the burden of demonstrating that the request is manifestly unfounded or excessive` TRUE)
#ASSERT (`Under Article 12(5), as a data subject, has the controller borne the burden of demonstrating that my request is manifestly unfounded or excessive` FALSE) EQUALS (`Under Article 12(5), as a controller, have I borne the burden of demonstrating that the request is manifestly unfounded or excessive` FALSE)

-- 12(6): Art 12(6) the controller may request the provision of additional information necessary to confirm the identity of the data subject
#ASSERT (`Under Article 12(6), as a data subject, may the controller ask me for additional information to confirm my identity` TRUE TRUE) EQUALS (`Under Article 12(6), as a controller, may I request additional information necessary to confirm the identity of the data subject` TRUE TRUE)
#ASSERT (`Under Article 12(6), as a data subject, may the controller ask me for additional information to confirm my identity` FALSE TRUE) EQUALS (`Under Article 12(6), as a controller, may I request additional information necessary to confirm the identity of the data subject` FALSE TRUE)
#ASSERT (`Under Article 12(6), as a data subject, may the controller ask me for additional information to confirm my identity` TRUE FALSE) EQUALS (`Under Article 12(6), as a controller, may I request additional information necessary to confirm the identity of the data subject` TRUE FALSE)

-- 12(7)a: Art 12(7) the information may be provided in combination with standardised icons
#ASSERT (`Under Article 12(7), as a data subject, may the information I am entitled to under Article 13 or 14 be provided to me in combination with standardised icons` TRUE) EQUALS (`Under Article 12(7), as a controller, may I provide the information required by Article 13 or 14 in combination with standardised icons` TRUE)
#ASSERT (`Under Article 12(7), as a data subject, may the information I am entitled to under Article 13 or 14 be provided to me in combination with standardised icons` FALSE) EQUALS (`Under Article 12(7), as a controller, may I provide the information required by Article 13 or 14 in combination with standardised icons` FALSE)

-- 12(7)b: Art 12(7) the icons presented electronically are machine-readable
#ASSERT (`Under Article 12(7), as a data subject, are the icons presented to me electronically machine-readable` TRUE TRUE) EQUALS (`Under Article 12(7), as a controller, are the icons I present electronically machine-readable` TRUE TRUE)
#ASSERT (`Under Article 12(7), as a data subject, are the icons presented to me electronically machine-readable` TRUE FALSE) EQUALS (`Under Article 12(7), as a controller, are the icons I present electronically machine-readable` TRUE FALSE)
#ASSERT (`Under Article 12(7), as a data subject, are the icons presented to me electronically machine-readable` FALSE TRUE) EQUALS (`Under Article 12(7), as a controller, are the icons I present electronically machine-readable` FALSE TRUE)

-- 13(1): Art 13(1) the controller provides the data subject with all of the following information
#ASSERT (`Under Article 13(1), as a data subject, has the controller, at the time it obtained my personal data from me, provided me with all of the following information` FALSE FALSE FALSE `P2 subject answer: no` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE) EQUALS (`Under Article 13(1), as a controller, where I collect personal data from the data subject, have I provided, at the time I obtain them, all of the information that paragraph 1 lists` FALSE FALSE FALSE `P2 controller answer: no` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE)
#ASSERT (`Under Article 13(1), as a data subject, has the controller, at the time it obtained my personal data from me, provided me with all of the following information` TRUE FALSE FALSE `P2 subject answer: no` FALSE FALSE TRUE FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE TRUE) EQUALS (`Under Article 13(1), as a controller, where I collect personal data from the data subject, have I provided, at the time I obtain them, all of the information that paragraph 1 lists` TRUE FALSE FALSE `P2 controller answer: no` FALSE FALSE TRUE FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE TRUE)
#ASSERT (`Under Article 13(1), as a data subject, has the controller, at the time it obtained my personal data from me, provided me with all of the following information` TRUE FALSE FALSE `P2 subject answer: no` FALSE FALSE FALSE FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE TRUE) EQUALS (`Under Article 13(1), as a controller, where I collect personal data from the data subject, have I provided, at the time I obtain them, all of the information that paragraph 1 lists` TRUE FALSE FALSE `P2 controller answer: no` FALSE FALSE FALSE FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE TRUE)
#ASSERT (`Under Article 13(1), as a data subject, has the controller, at the time it obtained my personal data from me, provided me with all of the following information` TRUE FALSE FALSE `P2 subject answer: not sure` FALSE FALSE TRUE FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE TRUE) EQUALS (`Under Article 13(1), as a controller, where I collect personal data from the data subject, have I provided, at the time I obtain them, all of the information that paragraph 1 lists` TRUE FALSE FALSE `P2 controller answer: not sure` FALSE FALSE TRUE FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE TRUE)

-- 13(1)i: Art 13(1) the controller owes the data subject the item of information
#ASSERT (`Under Article 13(1), as a data subject, where the controller collected my personal data from me, am I entitled to be given the item of information I name` TRUE `Art 13(1)(a) the identity and the contact details of the controller` FALSE FALSE `P2 subject answer: no` FALSE FALSE FALSE) EQUALS (`Under Article 13(1), as a controller, where I collect personal data from the data subject, must I give the data subject the item of information he or she names` TRUE `Art 13(1)(a) the identity and the contact details of the controller` FALSE FALSE `P2 controller answer: no` FALSE FALSE FALSE)
#ASSERT (`Under Article 13(1), as a data subject, where the controller collected my personal data from me, am I entitled to be given the item of information I name` TRUE `Art 13(1)(a) the identity and the contact details of the controller's representative` FALSE FALSE `P2 subject answer: no` FALSE FALSE FALSE) EQUALS (`Under Article 13(1), as a controller, where I collect personal data from the data subject, must I give the data subject the item of information he or she names` TRUE `Art 13(1)(a) the identity and the contact details of the controller's representative` FALSE FALSE `P2 controller answer: no` FALSE FALSE FALSE)
#ASSERT (`Under Article 13(1), as a data subject, where the controller collected my personal data from me, am I entitled to be given the item of information I name` TRUE `Art 13(1)(d) the legitimate interests pursued by the controller or by a third party` FALSE FALSE `P2 subject answer: not sure` FALSE FALSE FALSE) EQUALS (`Under Article 13(1), as a controller, where I collect personal data from the data subject, must I give the data subject the item of information he or she names` TRUE `Art 13(1)(d) the legitimate interests pursued by the controller or by a third party` FALSE FALSE `P2 controller answer: not sure` FALSE FALSE FALSE)

-- 13(2): Art 13(2) the controller provides the data subject with the following further information necessary to ensure fair and transparent processing
#ASSERT (`Under Article 13(2), as a data subject, has the controller, at the time it obtained my personal data from me, provided me with the further information necessary to ensure fair and transparent processing` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE) EQUALS (`Under Article 13(2), as a controller, where I collect personal data from the data subject, have I provided, at the time I obtain them, the further information that paragraph 2 lists` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE)
#ASSERT (`Under Article 13(2), as a data subject, has the controller, at the time it obtained my personal data from me, provided me with the further information necessary to ensure fair and transparent processing` TRUE FALSE FALSE TRUE TRUE FALSE TRUE TRUE FALSE FALSE TRUE) EQUALS (`Under Article 13(2), as a controller, where I collect personal data from the data subject, have I provided, at the time I obtain them, the further information that paragraph 2 lists` TRUE FALSE FALSE TRUE TRUE FALSE TRUE TRUE FALSE FALSE TRUE)
