#ASSERT (`Under Article 20(4), as a data subject, is my right to data portability limited because its exercise would adversely affect the rights and freedoms of others` FALSE) EQUALS (`Under Article 20(4), as a controller, is the data subject's right to data portability limited because its exercise would adversely affect the rights and freedoms of others` FALSE)

-- 21(1)a: Art 21(1) the data subject has the right to object, on grounds relating to his or her particular situation, to processing which is based on point (e) or (f) of Article 6(1)
#ASSERT (`Under Article 21(1), as a data subject, am I entitled to object, on grounds relating to my particular situation, to processing of my personal data based on point (e) or (f) of Article 6(1)` TRUE TRUE `P2 subject answer: yes` `P2 subject answer: no`) EQUALS (`Under Article 21(1), as a controller, may the data subject object, on grounds relating to his or her particular situation, to my processing based on point (e) or (f) of Article 6(1)` TRUE TRUE `P2 controller answer: yes` `P2 controller answer: no`)
#ASSERT (`Under Article 21(1), as a data subject, am I entitled to object, on grounds relating to my particular situation, to processing of my personal data based on point (e) or (f) of Article 6(1)` TRUE TRUE `P2 subject answer: no` `P2 subject answer: no`) EQUALS (`Under Article 21(1), as a controller, may the data subject object, on grounds relating to his or her particular situation, to my processing based on point (e) or (f) of Article 6(1)` TRUE TRUE `P2 controller answer: no` `P2 controller answer: no`)
#ASSERT (`Under Article 21(1), as a data subject, am I entitled to object, on grounds relating to my particular situation, to processing of my personal data based on point (e) or (f) of Article 6(1)` TRUE TRUE `P2 subject answer: no` `P2 subject answer: yes`) EQUALS (`Under Article 21(1), as a controller, may the data subject object, on grounds relating to his or her particular situation, to my processing based on point (e) or (f) of Article 6(1)` TRUE TRUE `P2 controller answer: no` `P2 controller answer: yes`)

-- 21(1)b: Art 21(1) the controller shall no longer process the personal data unless the controller demonstrates compelling legitimate grounds
#ASSERT (`Under Article 21(1), as a data subject, after I objected, is the controller barred from processing my personal data any longer` TRUE FALSE FALSE) EQUALS (`Under Article 21(1), as a controller, after the data subject objected, am I barred from processing his or her personal data any longer` TRUE FALSE FALSE)
#ASSERT (`Under Article 21(1), as a data subject, after I objected, is the controller barred from processing my personal data any longer` TRUE TRUE FALSE) EQUALS (`Under Article 21(1), as a controller, after the data subject objected, am I barred from processing his or her personal data any longer` TRUE TRUE FALSE)
#ASSERT (`Under Article 21(1), as a data subject, after I objected, is the controller barred from processing my personal data any longer` FALSE FALSE FALSE) EQUALS (`Under Article 21(1), as a controller, after the data subject objected, am I barred from processing his or her personal data any longer` FALSE FALSE FALSE)

-- 21(2): Art 21(2) the data subject has the right to object at any time to processing of personal data concerning him or her for direct marketing
#ASSERT (`Under Article 21(2), as a data subject, am I entitled to object at any time to processing of my personal data for direct marketing` TRUE TRUE) EQUALS (`Under Article 21(2), as a controller, may the data subject object at any time to my processing of his or her personal data for direct marketing` TRUE TRUE)
#ASSERT (`Under Article 21(2), as a data subject, am I entitled to object at any time to processing of my personal data for direct marketing` TRUE FALSE) EQUALS (`Under Article 21(2), as a controller, may the data subject object at any time to my processing of his or her personal data for direct marketing` TRUE FALSE)

-- 21(3): Art 21(3) the personal data shall no longer be processed for direct marketing purposes
#ASSERT (`Under Article 21(3), as a data subject, after I objected to direct marketing, are my personal data barred from being processed for that purpose any longer` TRUE) EQUALS (`Under Article 21(3), as a controller, after the data subject objected to direct marketing, are the personal data barred from being processed by me for that purpose any longer` TRUE)
#ASSERT (`Under Article 21(3), as a data subject, after I objected to direct marketing, are my personal data barred from being processed for that purpose any longer` FALSE) EQUALS (`Under Article 21(3), as a controller, after the data subject objected to direct marketing, are the personal data barred from being processed by me for that purpose any longer` FALSE)

-- 21(4): Art 21(4) the right to object is explicitly brought to the attention of the data subject, clearly and separately, at the latest at the time of the first communication
#ASSERT (`Under Article 21(4), as a data subject, was my right to object explicitly brought to my attention, clearly and separately, at the latest at the time of the first communication with me` TRUE TRUE TRUE) EQUALS (`Under Article 21(4), as a controller, have I explicitly brought the right to object to the data subject's attention, clearly and separately, at the latest at the time of the first communication` TRUE TRUE TRUE)
#ASSERT (`Under Article 21(4), as a data subject, was my right to object explicitly brought to my attention, clearly and separately, at the latest at the time of the first communication with me` TRUE TRUE FALSE) EQUALS (`Under Article 21(4), as a controller, have I explicitly brought the right to object to the data subject's attention, clearly and separately, at the latest at the time of the first communication` TRUE TRUE FALSE)
#ASSERT (`Under Article 21(4), as a data subject, was my right to object explicitly brought to my attention, clearly and separately, at the latest at the time of the first communication with me` TRUE FALSE TRUE) EQUALS (`Under Article 21(4), as a controller, have I explicitly brought the right to object to the data subject's attention, clearly and separately, at the latest at the time of the first communication` TRUE FALSE TRUE)

-- 21(5): Art 21(5) the data subject may exercise the right to object by automated means using technical specifications
#ASSERT (`Under Article 21(5), as a data subject, may I exercise my right to object by automated means using technical specifications` TRUE) EQUALS (`Under Article 21(5), as a controller, may the data subject exercise the right to object by automated means using technical specifications` TRUE)
#ASSERT (`Under Article 21(5), as a data subject, may I exercise my right to object by automated means using technical specifications` FALSE) EQUALS (`Under Article 21(5), as a controller, may the data subject exercise the right to object by automated means using technical specifications` FALSE)

-- 21(6): Art 21(6) the data subject has the right to object to processing for scientific or historical research purposes or statistical purposes
#ASSERT (`Under Article 21(6), as a data subject, am I entitled to object to processing of my personal data for scientific or historical research or statistical purposes` TRUE `Art 5(1)(b) scientific research purposes` TRUE TRUE FALSE) EQUALS (`Under Article 21(6), as a controller, may the data subject object to my processing of his or her personal data for scientific or historical research or statistical purposes` TRUE `Art 5(1)(b) scientific research purposes` TRUE TRUE FALSE)
#ASSERT (`Under Article 21(6), as a data subject, am I entitled to object to processing of my personal data for scientific or historical research or statistical purposes` TRUE `Art 5(1)(b) archiving purposes in the public interest` TRUE TRUE FALSE) EQUALS (`Under Article 21(6), as a controller, may the data subject object to my processing of his or her personal data for scientific or historical research or statistical purposes` TRUE `Art 5(1)(b) archiving purposes in the public interest` TRUE TRUE FALSE)
#ASSERT (`Under Article 21(6), as a data subject, am I entitled to object to processing of my personal data for scientific or historical research or statistical purposes` TRUE `Art 5(1)(b) scientific research purposes` TRUE FALSE FALSE) EQUALS (`Under Article 21(6), as a controller, may the data subject object to my processing of his or her personal data for scientific or historical research or statistical purposes` TRUE `Art 5(1)(b) scientific research purposes` TRUE FALSE FALSE)

-- 22(2)(a): Art 22(2)(a) point (a) applies: the decision is necessary for entering into, or performance of, a contract between the data subject and a data controller
#ASSERT (`Under Article 22(2), as a data subject, does point (a) apply to the decision about me: the decision is necessary for entering into, or performance of, a contract between me and a controller` TRUE) EQUALS (`Under Article 22(2), as a controller, does point (a) apply to my decision: the decision is necessary for entering into, or performance of, a contract between the data subject and a controller` TRUE)
#ASSERT (`Under Article 22(2), as a data subject, does point (a) apply to the decision about me: the decision is necessary for entering into, or performance of, a contract between me and a controller` FALSE) EQUALS (`Under Article 22(2), as a controller, does point (a) apply to my decision: the decision is necessary for entering into, or performance of, a contract between the data subject and a controller` FALSE)

-- 22(2)(b): Art 22(2)(b) point (b) applies: the decision is authorised by Union or Member State law which also lays down suitable measures
#ASSERT (`Under Article 22(2), as a data subject, does point (b) apply to the decision about me: the decision is authorised by Union or Member State law which also lays down suitable measures` TRUE TRUE) EQUALS (`Under Article 22(2), as a controller, does point (b) apply to my decision: the decision is authorised by Union or Member State law which also lays down suitable measures` TRUE TRUE)
#ASSERT (`Under Article 22(2), as a data subject, does point (b) apply to the decision about me: the decision is authorised by Union or Member State law which also lays down suitable measures` TRUE FALSE) EQUALS (`Under Article 22(2), as a controller, does point (b) apply to my decision: the decision is authorised by Union or Member State law which also lays down suitable measures` TRUE FALSE)
#ASSERT (`Under Article 22(2), as a data subject, does point (b) apply to the decision about me: the decision is authorised by Union or Member State law which also lays down suitable measures` FALSE TRUE) EQUALS (`Under Article 22(2), as a controller, does point (b) apply to my decision: the decision is authorised by Union or Member State law which also lays down suitable measures` FALSE TRUE)

-- 22(2)(c): Art 22(2)(c) point (c) applies: the decision is based on the data subject's explicit consent
#ASSERT (`Under Article 22(2), as a data subject, does point (c) apply to the decision about me: the decision is based on my explicit consent` TRUE) EQUALS (`Under Article 22(2), as a controller, does point (c) apply to my decision: the decision is based on the data subject's explicit consent` TRUE)
#ASSERT (`Under Article 22(2), as a data subject, does point (c) apply to the decision about me: the decision is based on my explicit consent` FALSE) EQUALS (`Under Article 22(2), as a controller, does point (c) apply to my decision: the decision is based on the data subject's explicit consent` FALSE)

-- 22(2): Art 22(2) paragraph 1 does not apply
#ASSERT (`Under Article 22(2), as a data subject, does paragraph 1 not apply to the decision about me` `P2 subject answer: yes` `P2 subject answer: no` `P2 subject answer: no`) EQUALS (`Under Article 22(2), as a controller, does paragraph 1 not apply to my decision` `P2 controller answer: yes` `P2 controller answer: no` `P2 controller answer: no`)
#ASSERT (`Under Article 22(2), as a data subject, does paragraph 1 not apply to the decision about me` `P2 subject answer: no` `P2 subject answer: no` `P2 subject answer: no`) EQUALS (`Under Article 22(2), as a controller, does paragraph 1 not apply to my decision` `P2 controller answer: no` `P2 controller answer: no` `P2 controller answer: no`)
#ASSERT (`Under Article 22(2), as a data subject, does paragraph 1 not apply to the decision about me` `P2 subject answer: no` `P2 subject answer: no` `P2 subject answer: not sure`) EQUALS (`Under Article 22(2), as a controller, does paragraph 1 not apply to my decision` `P2 controller answer: no` `P2 controller answer: no` `P2 controller answer: not sure`)

-- 22(1): Art 22(1) the data subject has the right not to be subject to a decision based solely on automated processing which produces legal effects or similarly significantly affects him or her
#ASSERT (`Under Article 22(1), as a data subject, am I entitled not to be subject to a decision based solely on automated processing that produces legal effects concerning me or similarly significantly affects me` TRUE FALSE TRUE FALSE `P2 subject answer: no`) EQUALS (`Under Article 22(1), as a controller, must I refrain from subjecting the data subject to a decision based solely on automated processing that produces legal effects or similarly significantly affects him or her` TRUE TRUE FALSE TRUE FALSE `P2 controller answer: no`)
#ASSERT (`Under Article 22(1), as a data subject, am I entitled not to be subject to a decision based solely on automated processing that produces legal effects concerning me or similarly significantly affects me` TRUE FALSE FALSE FALSE `P2 subject answer: no`) EQUALS (`Under Article 22(1), as a controller, must I refrain from subjecting the data subject to a decision based solely on automated processing that produces legal effects or similarly significantly affects him or her` TRUE TRUE FALSE FALSE FALSE `P2 controller answer: no`)
#ASSERT (`Under Article 22(1), as a data subject, am I entitled not to be subject to a decision based solely on automated processing that produces legal effects concerning me or similarly significantly affects me` TRUE FALSE TRUE FALSE `P2 subject answer: yes`) EQUALS (`Under Article 22(1), as a controller, must I refrain from subjecting the data subject to a decision based solely on automated processing that produces legal effects or similarly significantly affects him or her` TRUE TRUE FALSE TRUE FALSE `P2 controller answer: yes`)

-- 22(3): Art 22(3) in the cases of points (a) and (c) of paragraph 2 the controller implements suitable measures, at least the right to human intervention, to express a point of view and to contest the decision
#ASSERT (`Under Article 22(3), as a data subject, in a decision under point (a) or (c) of paragraph 2, has the controller implemented suitable measures, at least the right to human intervention, to express my point of view and to contest the decision` `P2 subject answer: yes` `P2 subject answer: no` TRUE TRUE TRUE TRUE) EQUALS (`Under Article 22(3), as a controller, in a decision under point (a) or (c) of paragraph 2, have I implemented suitable measures, at least the right to human intervention, to express a point of view and to contest the decision` `P2 controller answer: yes` `P2 controller answer: no` TRUE TRUE TRUE TRUE)
#ASSERT (`Under Article 22(3), as a data subject, in a decision under point (a) or (c) of paragraph 2, has the controller implemented suitable measures, at least the right to human intervention, to express my point of view and to contest the decision` `P2 subject answer: yes` `P2 subject answer: no` TRUE FALSE TRUE TRUE) EQUALS (`Under Article 22(3), as a controller, in a decision under point (a) or (c) of paragraph 2, have I implemented suitable measures, at least the right to human intervention, to express a point of view and to contest the decision` `P2 controller answer: yes` `P2 controller answer: no` TRUE FALSE TRUE TRUE)
#ASSERT (`Under Article 22(3), as a data subject, in a decision under point (a) or (c) of paragraph 2, has the controller implemented suitable measures, at least the right to human intervention, to express my point of view and to contest the decision` `P2 subject answer: no` `P2 subject answer: no` TRUE TRUE TRUE TRUE) EQUALS (`Under Article 22(3), as a controller, in a decision under point (a) or (c) of paragraph 2, have I implemented suitable measures, at least the right to human intervention, to express a point of view and to contest the decision` `P2 controller answer: no` `P2 controller answer: no` TRUE TRUE TRUE TRUE)

-- 22(4): Art 22(4) decisions referred to in paragraph 2 shall not be based on special categories of personal data referred to in Article 9(1)
#ASSERT (`Under Article 22(4), as a data subject, is a decision referred to in paragraph 2 barred from being based on special categories of my personal data` TRUE TRUE `P2 subject answer: yes` `P2 subject answer: no` TRUE) EQUALS (`Under Article 22(4), as a controller, am I barred from basing a decision referred to in paragraph 2 on special categories of personal data` TRUE TRUE `P2 controller answer: yes` `P2 controller answer: no` TRUE)
#ASSERT (`Under Article 22(4), as a data subject, is a decision referred to in paragraph 2 barred from being based on special categories of my personal data` TRUE TRUE `P2 subject answer: yes` `P2 subject answer: no` FALSE) EQUALS (`Under Article 22(4), as a controller, am I barred from basing a decision referred to in paragraph 2 on special categories of personal data` TRUE TRUE `P2 controller answer: yes` `P2 controller answer: no` FALSE)
#ASSERT (`Under Article 22(4), as a data subject, is a decision referred to in paragraph 2 barred from being based on special categories of my personal data` TRUE TRUE `P2 subject answer: not sure` `P2 subject answer: no` TRUE) EQUALS (`Under Article 22(4), as a controller, am I barred from basing a decision referred to in paragraph 2 on special categories of personal data` TRUE TRUE `P2 controller answer: not sure` `P2 controller answer: no` TRUE)

