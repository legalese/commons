IMPORT prelude
IMPORT `gdpr-core`
IMPORT `P2-art-18`

-- ============================================================================
-- P2-tests-art-18.l4 -- tests of Article 18 (src:241-249).
-- Every expected value was written by hand from the text of the provision named in the comment above it,
-- before the first run, and none was copied from an output (notes/gen-tests-p2.py holds the cases).
-- A #TRACE result is not an assertion and check.sh does not count it; each trace comment gives the expected result.
-- ============================================================================

§ `Art 18(1)(a) to (d): the four points`

-- (a) accuracy contested, for a period enabling verification
#ASSERT `Art 18(1)(a) point (a) applies: the accuracy of the personal data is contested, for a period enabling the controller to verify the accuracy` TRUE TRUE EQUALS JUST TRUE
-- (a) contested, but the period enabling verification has ended
#ASSERT `Art 18(1)(a) point (a) applies: the accuracy of the personal data is contested, for a period enabling the controller to verify the accuracy` TRUE FALSE EQUALS JUST FALSE
-- (a) accuracy not contested
#ASSERT `Art 18(1)(a) point (a) applies: the accuracy of the personal data is contested, for a period enabling the controller to verify the accuracy` FALSE TRUE EQUALS JUST FALSE
-- (b) unlawful, the data subject opposes erasure and requests restriction instead
#ASSERT `Art 18(1)(b) point (b) applies: the processing is unlawful and the data subject opposes erasure and requests restriction instead` TRUE TRUE TRUE EQUALS JUST TRUE
-- (b) the data subject does not request restriction
#ASSERT `Art 18(1)(b) point (b) applies: the processing is unlawful and the data subject opposes erasure and requests restriction instead` TRUE TRUE FALSE EQUALS JUST FALSE
-- (b) the data subject does not oppose erasure
#ASSERT `Art 18(1)(b) point (b) applies: the processing is unlawful and the data subject opposes erasure and requests restriction instead` TRUE FALSE TRUE EQUALS JUST FALSE
-- (b) the processing is lawful
#ASSERT `Art 18(1)(b) point (b) applies: the processing is unlawful and the data subject opposes erasure and requests restriction instead` FALSE TRUE TRUE EQUALS JUST FALSE
-- (c) no longer needed by the controller, required by the data subject for legal claims
#ASSERT `Art 18(1)(c) point (c) applies: the controller no longer needs the personal data but the data subject requires them for legal claims` TRUE TRUE EQUALS JUST TRUE
-- (c) not required by the data subject for legal claims
#ASSERT `Art 18(1)(c) point (c) applies: the controller no longer needs the personal data but the data subject requires them for legal claims` TRUE FALSE EQUALS JUST FALSE
-- (c) the controller still needs the data
#ASSERT `Art 18(1)(c) point (c) applies: the controller no longer needs the personal data but the data subject requires them for legal claims` FALSE TRUE EQUALS JUST FALSE
-- (d) objected pursuant to Article 21(1), verification pending
#ASSERT `Art 18(1)(d) point (d) applies: the data subject has objected pursuant to Article 21(1) pending the verification whether the controller's grounds override` TRUE TRUE EQUALS JUST TRUE
-- (d) objected, but the verification is complete
#ASSERT `Art 18(1)(d) point (d) applies: the data subject has objected pursuant to Article 21(1) pending the verification whether the controller's grounds override` TRUE FALSE EQUALS JUST FALSE
-- (d) no objection
#ASSERT `Art 18(1)(d) point (d) applies: the data subject has objected pursuant to Article 21(1) pending the verification whether the controller's grounds override` FALSE TRUE EQUALS JUST FALSE
-- point (a) holds
#ASSERT `Art 18(1) the data subject has the right to obtain from the controller restriction of processing` TRUE TRUE (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) NOTHING EQUALS JUST TRUE
-- point (b) holds
#ASSERT `Art 18(1) the data subject has the right to obtain from the controller restriction of processing` TRUE TRUE (JUST FALSE) (JUST TRUE) (JUST FALSE) (JUST FALSE) NOTHING EQUALS JUST TRUE
-- point (c) holds
#ASSERT `Art 18(1) the data subject has the right to obtain from the controller restriction of processing` TRUE TRUE (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST FALSE) NOTHING EQUALS JUST TRUE
-- point (d) holds
#ASSERT `Art 18(1) the data subject has the right to obtain from the controller restriction of processing` TRUE TRUE (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) NOTHING EQUALS JUST TRUE
-- no point holds: 'where one of the following applies' fails
#ASSERT `Art 18(1) the data subject has the right to obtain from the controller restriction of processing` TRUE TRUE (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) NOTHING EQUALS JUST FALSE
-- no point holds and (d) is not decided: not covered
#ASSERT `Art 18(1) the data subject has the right to obtain from the controller restriction of processing` TRUE TRUE (JUST FALSE) (JUST FALSE) (JUST FALSE) NOTHING NOTHING EQUALS NOTHING
-- (b) holds whatever (a) is
#ASSERT `Art 18(1) the data subject has the right to obtain from the controller restriction of processing` TRUE TRUE NOTHING (JUST TRUE) (JUST FALSE) (JUST FALSE) NOTHING EQUALS JUST TRUE
-- Article 11(2) disapplies Articles 15 to 20 (Article 18 is among them)
#ASSERT `Art 18(1) the data subject has the right to obtain from the controller restriction of processing` TRUE TRUE (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
-- an Article 11(2) case with identifying information: the right applies
#ASSERT `Art 18(1) the data subject has the right to obtain from the controller restriction of processing` TRUE TRUE (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
-- not the data subject
#ASSERT `Art 18(1) the data subject has the right to obtain from the controller restriction of processing` FALSE TRUE (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) NOTHING EQUALS NOTHING
-- not the controller
#ASSERT `Art 18(1) the data subject has the right to obtain from the controller restriction of processing` TRUE FALSE (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) NOTHING EQUALS NOTHING

§ `Art 18(2): processing of restricted data`

-- restricted data, storage only: 'with the exception of storage'
#ASSERT `Art 18(2) the restricted personal data are processed, with the exception of storage, only with the data subject's consent or for one of the three purposes that paragraph 2 names` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST `the duty arises and is met`
-- with the data subject's consent
#ASSERT `Art 18(2) the restricted personal data are processed, with the exception of storage, only with the data subject's consent or for one of the three purposes that paragraph 2 names` TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST `the duty arises and is met`
-- for the establishment, exercise or defence of legal claims
#ASSERT `Art 18(2) the restricted personal data are processed, with the exception of storage, only with the data subject's consent or for one of the three purposes that paragraph 2 names` TRUE FALSE FALSE TRUE FALSE FALSE EQUALS JUST `the duty arises and is met`
-- for the protection of the rights of another natural or legal person
#ASSERT `Art 18(2) the restricted personal data are processed, with the exception of storage, only with the data subject's consent or for one of the three purposes that paragraph 2 names` TRUE FALSE FALSE FALSE TRUE FALSE EQUALS JUST `the duty arises and is met`
-- for reasons of important public interest of the Union or of a Member State
#ASSERT `Art 18(2) the restricted personal data are processed, with the exception of storage, only with the data subject's consent or for one of the three purposes that paragraph 2 names` TRUE FALSE FALSE FALSE FALSE TRUE EQUALS JUST `the duty arises and is met`
-- any other processing of restricted data: the list is closed with 'only'
#ASSERT `Art 18(2) the restricted personal data are processed, with the exception of storage, only with the data subject's consent or for one of the three purposes that paragraph 2 names` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST `the duty arises and is not met`
-- the processing has not been restricted: 'Where processing has been restricted' fails
#ASSERT `Art 18(2) the restricted personal data are processed, with the exception of storage, only with the data subject's consent or for one of the three purposes that paragraph 2 names` FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST `the duty does not arise`

§ `Art 18(3): informing the data subject before the restriction is lifted`

-- informed before the restriction was lifted
#ASSERT `Art 18(3) the controller informs the data subject who has obtained restriction of processing before the restriction is lifted` TRUE TRUE EQUALS JUST `the duty arises and is met`
-- not informed before: 'shall be informed by the controller before'
#ASSERT `Art 18(3) the controller informs the data subject who has obtained restriction of processing before the restriction is lifted` TRUE FALSE EQUALS JUST `the duty arises and is not met`
-- no restriction obtained under paragraph 1: outside 'A data subject who has obtained restriction'
#ASSERT `Art 18(3) the controller informs the data subject who has obtained restriction of processing before the restriction is lifted` FALSE TRUE EQUALS NOTHING
-- FULFILLED: informed before the restriction is lifted at 5
#TRACE `Art 18(3) the controller must inform the data subject before the restriction of processing is lifted` TRUE 5 AT 0 WITH
    PARTY controller DOES `Art 18(3) inform the data subject before the restriction of processing is lifted` AT 4
-- BREACH: informed after the restriction was lifted
#TRACE `Art 18(3) the controller must inform the data subject before the restriction of processing is lifted` TRUE 5 AT 0 WITH
    PARTY controller DOES `Art 18(3) inform the data subject before the restriction of processing is lifted` AT 6
-- BREACH: not informed by the time the restriction is lifted
#TRACE `Art 18(3) the controller must inform the data subject before the restriction of processing is lifted` TRUE 5 AT 0 WITH
    (WAITUNTIL 6)
-- FULFILLED: no restriction obtained
#TRACE `Art 18(3) the controller must inform the data subject before the restriction of processing is lifted` FALSE 5 AT 0 WITH
    (WAITUNTIL 6)

§ `Art 18(1): the controller must restrict the processing (R8)`

-- FULFILLED: the controller restricts the processing
#TRACE `Art 18(1) the controller must restrict the processing of the personal data` (JUST TRUE) AT 0 WITH
    PARTY controller DOES `Art 18(1) restrict the processing of the personal data concerning the data subject` AT 1
-- no act: the obligation stands; no breach is possible (no time limit)
#TRACE `Art 18(1) the controller must restrict the processing of the personal data` (JUST TRUE) AT 0 WITH
    (WAITUNTIL 1000)
-- FULFILLED: no ground applies, so there is no right to restriction
#TRACE `Art 18(1) the controller must restrict the processing of the personal data` (JUST FALSE) AT 0 WITH
    (WAITUNTIL 1000)
-- FULFILLED: the right is not established (not covered)
#TRACE `Art 18(1) the controller must restrict the processing of the personal data` NOTHING AT 0 WITH
    (WAITUNTIL 1000)
