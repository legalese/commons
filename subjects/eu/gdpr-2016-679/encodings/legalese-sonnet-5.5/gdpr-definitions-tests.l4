IMPORT prelude
IMPORT `gdpr-core`
IMPORT `gdpr-definitions`

-- ============================================================================
-- gdpr-definitions-tests.l4 -- tests of Art 4 points (1), (2), (6), (7), (8).
-- Every expected value is written from the text of the point (src:39, 40, 44, 45, 46), never from
-- the output of the functions.  For each point: one case for each member the text names, and one
-- case just outside it.  "JUST TRUE" is the text's yes; "JUST FALSE" is the "means" no;
-- NOTHING is "not covered".
-- ============================================================================

§ `Art 4(1): each way of identifying a natural person makes the person identifiable (the list is open: the last one is any other means)`

#ASSERT `Art 4(1) the natural person is an identifiable natural person` (LIST `Art 4(1) a name`) EQUALS JUST TRUE
#ASSERT `Art 4(1) the natural person is an identifiable natural person` (LIST `Art 4(1) an identification number`) EQUALS JUST TRUE
#ASSERT `Art 4(1) the natural person is an identifiable natural person` (LIST `Art 4(1) location data`) EQUALS JUST TRUE
#ASSERT `Art 4(1) the natural person is an identifiable natural person` (LIST `Art 4(1) an online identifier`) EQUALS JUST TRUE
#ASSERT `Art 4(1) the natural person is an identifiable natural person` (LIST `Art 4(1) a factor specific to the physical identity`) EQUALS JUST TRUE
#ASSERT `Art 4(1) the natural person is an identifiable natural person` (LIST `Art 4(1) a factor specific to the physiological identity`) EQUALS JUST TRUE
#ASSERT `Art 4(1) the natural person is an identifiable natural person` (LIST `Art 4(1) a factor specific to the genetic identity`) EQUALS JUST TRUE
#ASSERT `Art 4(1) the natural person is an identifiable natural person` (LIST `Art 4(1) a factor specific to the mental identity`) EQUALS JUST TRUE
#ASSERT `Art 4(1) the natural person is an identifiable natural person` (LIST `Art 4(1) a factor specific to the economic identity`) EQUALS JUST TRUE
#ASSERT `Art 4(1) the natural person is an identifiable natural person` (LIST `Art 4(1) a factor specific to the cultural identity`) EQUALS JUST TRUE
#ASSERT `Art 4(1) the natural person is an identifiable natural person` (LIST `Art 4(1) a factor specific to the social identity`) EQUALS JUST TRUE
#ASSERT `Art 4(1) the natural person is an identifiable natural person` (LIST `Art 4(1) some other means of identification`) EQUALS JUST TRUE
-- just outside: no way of identifying the person at all
#ASSERT `Art 4(1) the natural person is an identifiable natural person` EMPTY EQUALS JUST FALSE
-- two ways at once
#ASSERT `Art 4(1) the natural person is an identifiable natural person` (LIST `Art 4(1) a name`, `Art 4(1) location data`) EQUALS JUST TRUE

§ `Art 4(1): personal data`

-- Information about a natural person who is already identified (a name is on the file).
#ASSERT `Art 4(1) the information is personal data` TRUE TRUE EMPTY EQUALS JUST TRUE
-- Information about a natural person who is not identified but can be identified by an online identifier.
#ASSERT `Art 4(1) the information is personal data` TRUE FALSE (LIST `Art 4(1) an online identifier`) EQUALS JUST TRUE
-- Several factors together: a postcode-like location and a social factor.
#ASSERT `Art 4(1) the information is personal data` TRUE FALSE (LIST `Art 4(1) location data`, `Art 4(1) a factor specific to the social identity`) EQUALS JUST TRUE
-- Just outside: information about a natural person who is neither identified nor identifiable (an anonymous statistic).
#ASSERT `Art 4(1) the information is personal data` TRUE FALSE EMPTY EQUALS JUST FALSE
-- Just outside: information that does not relate to a natural person (a company's turnover), even if some name is attached.
#ASSERT `Art 4(1) the information is personal data` FALSE TRUE (LIST `Art 4(1) a name`) EQUALS JUST FALSE
#ASSERT `Art 4(1) the information is personal data` FALSE FALSE EMPTY EQUALS JUST FALSE

§ `Art 4(1): data subject`

#ASSERT `Art 4(1) the person is a data subject` TRUE TRUE TRUE EMPTY EQUALS JUST TRUE
#ASSERT `Art 4(1) the person is a data subject` TRUE TRUE FALSE (LIST `Art 4(1) an identification number`) EQUALS JUST TRUE
-- Just outside: identifiable by no means.
#ASSERT `Art 4(1) the person is a data subject` TRUE TRUE FALSE EMPTY EQUALS JUST FALSE
-- Just outside: the information does not relate to this person.
#ASSERT `Art 4(1) the person is a data subject` TRUE FALSE TRUE (LIST `Art 4(1) a name`) EQUALS JUST FALSE
-- Just outside: not a natural person (a company).
#ASSERT `Art 4(1) the person is a data subject` FALSE TRUE TRUE (LIST `Art 4(1) a name`) EQUALS JUST FALSE

§ `Art 4(2): each operation the text names is processing when performed on personal data`

#ASSERT `Art 4(2) the operations are processing` (LIST `Art 4(2) collection`) TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 4(2) the operations are processing` (LIST `Art 4(2) recording`) TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 4(2) the operations are processing` (LIST `Art 4(2) organisation`) TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 4(2) the operations are processing` (LIST `Art 4(2) structuring`) TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 4(2) the operations are processing` (LIST `Art 4(2) storage`) TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 4(2) the operations are processing` (LIST `Art 4(2) adaptation`) TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 4(2) the operations are processing` (LIST `Art 4(2) alteration`) TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 4(2) the operations are processing` (LIST `Art 4(2) retrieval`) TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 4(2) the operations are processing` (LIST `Art 4(2) consultation`) TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 4(2) the operations are processing` (LIST `Art 4(2) use`) TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 4(2) the operations are processing` (LIST `Art 4(2) disclosure by transmission`) TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 4(2) the operations are processing` (LIST `Art 4(2) dissemination`) TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 4(2) the operations are processing` (LIST `Art 4(2) otherwise making available`) TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 4(2) the operations are processing` (LIST `Art 4(2) alignment`) TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 4(2) the operations are processing` (LIST `Art 4(2) combination`) TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 4(2) the operations are processing` (LIST `Art 4(2) restriction`) TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 4(2) the operations are processing` (LIST `Art 4(2) erasure`) TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 4(2) the operations are processing` (LIST `Art 4(2) destruction`) TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 4(2) the operations are processing` (LIST `Art 4(2) some other operation`) TRUE FALSE TRUE EQUALS JUST TRUE
-- a set of operations
#ASSERT `Art 4(2) the operations are processing` (LIST `Art 4(2) collection`, `Art 4(2) storage`, `Art 4(2) erasure`) TRUE FALSE TRUE EQUALS JUST TRUE
-- "whether or not by automated means": the same answer when not automated (a paper file)
#ASSERT `Art 4(2) the operations are processing` (LIST `Art 4(2) storage`) TRUE FALSE FALSE EQUALS JUST TRUE
-- "performed on personal data or on sets of personal data": the first limb alone, `on personal data` (the second limb alone is tested at the end of this section)
#ASSERT `Art 4(2) the operations are processing` (LIST `Art 4(2) combination`) TRUE FALSE FALSE EQUALS JUST TRUE
-- Just outside: operations on something that is not personal data (a weather dataset).
#ASSERT `Art 4(2) the operations are processing` (LIST `Art 4(2) storage`) FALSE FALSE TRUE EQUALS JUST FALSE
-- Just outside: no operation at all.
#ASSERT `Art 4(2) the operations are processing` EMPTY TRUE FALSE TRUE EQUALS JUST FALSE
-- The OR in "performed on personal data or on sets of personal data" is two inputs, `on personal data` and `on sets of personal data`: each of the next four asserts exercises the fork.
-- Second limb alone: an operation on a set of personal data (the set is the object) and on no single item is processing.
#ASSERT `Art 4(2) the operations are processing` (LIST `Art 4(2) combination`) FALSE TRUE TRUE EQUALS JUST TRUE
-- Second limb alone, not by automated means (a paper file): "whether or not by automated means" does not touch the second limb.
#ASSERT `Art 4(2) the operations are processing` (LIST `Art 4(2) storage`) FALSE TRUE FALSE EQUALS JUST TRUE
-- Both limbs: an operation on personal data that is also an operation on a set of personal data is processing (OR, not exclusive or).
#ASSERT `Art 4(2) the operations are processing` (LIST `Art 4(2) retrieval`) TRUE TRUE TRUE EQUALS JUST TRUE
-- Just outside: neither limb, an operation on something that is neither personal data nor a set of personal data (a weather dataset), not automated either.
#ASSERT `Art 4(2) the operations are processing` (LIST `Art 4(2) combination`) FALSE FALSE FALSE EQUALS JUST FALSE

§ `Art 4(6): a structured set of personal data accessible according to specific criteria, however arranged`

#ASSERT `Art 4(6) the set is a filing system` TRUE TRUE TRUE `Art 4(6) centralised` EQUALS JUST TRUE
#ASSERT `Art 4(6) the set is a filing system` TRUE TRUE TRUE `Art 4(6) decentralised` EQUALS JUST TRUE
#ASSERT `Art 4(6) the set is a filing system` TRUE TRUE TRUE `Art 4(6) dispersed on a functional basis` EQUALS JUST TRUE
#ASSERT `Art 4(6) the set is a filing system` TRUE TRUE TRUE `Art 4(6) dispersed on a geographical basis` EQUALS JUST TRUE
#ASSERT `Art 4(6) the set is a filing system` TRUE TRUE TRUE `Art 4(6) arranged in some other way` EQUALS JUST TRUE
-- Just outside: a heap of papers with no structure.
#ASSERT `Art 4(6) the set is a filing system` FALSE TRUE TRUE `Art 4(6) centralised` EQUALS JUST FALSE
-- Just outside: a structured set of something that is not personal data.
#ASSERT `Art 4(6) the set is a filing system` TRUE FALSE TRUE `Art 4(6) centralised` EQUALS JUST FALSE
-- Just outside: personal data in a structure but not accessible according to specific criteria.
#ASSERT `Art 4(6) the set is a filing system` TRUE TRUE FALSE `Art 4(6) decentralised` EQUALS JUST FALSE

§ `Art 4(7): controller`

-- natural person that decides purposes and means
#ASSERT `Art 4(7) the body is a controller` `natural person` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- legal person that decides purposes and means
#ASSERT `Art 4(7) the body is a controller` `legal person` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- public authority that decides purposes and means
#ASSERT `Art 4(7) the body is a controller` `public authority` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- agency that decides purposes and means
#ASSERT `Art 4(7) the body is a controller` `agency` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- other body that decides purposes and means
#ASSERT `Art 4(7) the body is a controller` `other body` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- Just outside the list of bodies: a tool is not a controller even if it "decides".
#ASSERT `Art 4(7) the body is a controller` `not a person or body` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
-- Deciding the purposes only, the means only, or neither: not a controller.
#ASSERT `Art 4(7) the body is a controller` `legal person` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Art 4(7) the body is a controller` `legal person` FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Art 4(7) the body is a controller` `legal person` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- Second limb: Union or Member State law determines the purposes and means and names the body (a public authority).
#ASSERT `Art 4(7) the body is a controller` `public authority` FALSE FALSE TRUE TRUE EQUALS JUST TRUE
-- Second limb unmet: the law determines the purposes and means but names nobody and sets no criteria the body meets.
#ASSERT `Art 4(7) the body is a controller` `public authority` FALSE FALSE TRUE FALSE EQUALS JUST FALSE
-- Second limb unmet: a law "names" the body but does not determine the purposes and means.
#ASSERT `Art 4(7) the body is a controller` `public authority` FALSE FALSE FALSE TRUE EQUALS JUST FALSE
-- Not a person or body, even if the law names it.
#ASSERT `Art 4(7) the body is a controller` `not a person or body` FALSE FALSE TRUE TRUE EQUALS JUST FALSE

-- "alone or jointly with others"
#ASSERT `Art 4(7) how the body determines the purposes and means` TRUE TRUE FALSE EQUALS JUST `Art 4(7) alone`
#ASSERT `Art 4(7) how the body determines the purposes and means` TRUE TRUE TRUE EQUALS JUST `Art 4(7) jointly with others`
-- Not covered: a body that decides only the purposes, only the means, or neither, is not asked "alone or jointly".
#ASSERT `Art 4(7) how the body determines the purposes and means` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `Art 4(7) how the body determines the purposes and means` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `Art 4(7) how the body determines the purposes and means` FALSE FALSE TRUE EQUALS NOTHING

§ `Art 4(8): processor`

#ASSERT `Art 4(8) the body is a processor` `natural person` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 4(8) the body is a processor` `legal person` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 4(8) the body is a processor` `public authority` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 4(8) the body is a processor` `agency` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 4(8) the body is a processor` `other body` TRUE TRUE EQUALS JUST TRUE
-- Just outside: a tool.
#ASSERT `Art 4(8) the body is a processor` `not a person or body` TRUE TRUE EQUALS JUST FALSE
-- Just outside: a body that processes personal data on its own behalf (it is not a processor of someone else's data).
#ASSERT `Art 4(8) the body is a processor` `legal person` TRUE FALSE EQUALS JUST FALSE
-- Just outside: acts for the controller but does not process personal data (a cleaner).
#ASSERT `Art 4(8) the body is a processor` `legal person` FALSE TRUE EQUALS JUST FALSE
#ASSERT `Art 4(8) the body is a processor` `natural person` FALSE FALSE EQUALS JUST FALSE

§ `The core's types that no P1 rule reads: each member resolves, and neighbours are distinct`

-- the ten grounds of Art 9(2), by their labels (a) to (j) (src:122-132)
#ASSERT elem `Art 9(2)(a) explicit consent` (LIST `Art 9(2)(a) explicit consent`, `Art 9(2)(b) employment and social security and social protection law`, `Art 9(2)(c) vital interests where the data subject cannot give consent`, `Art 9(2)(d) a not-for-profit body and its members`, `Art 9(2)(e) data manifestly made public by the data subject`, `Art 9(2)(f) legal claims or courts acting in their judicial capacity`, `Art 9(2)(g) substantial public interest`, `Art 9(2)(h) health or social care`, `Art 9(2)(i) public interest in the area of public health`, `Art 9(2)(j) archiving, research or statistical purposes`)
#ASSERT elem `Art 9(2)(b) employment and social security and social protection law` (LIST `Art 9(2)(a) explicit consent`, `Art 9(2)(b) employment and social security and social protection law`, `Art 9(2)(c) vital interests where the data subject cannot give consent`, `Art 9(2)(d) a not-for-profit body and its members`, `Art 9(2)(e) data manifestly made public by the data subject`, `Art 9(2)(f) legal claims or courts acting in their judicial capacity`, `Art 9(2)(g) substantial public interest`, `Art 9(2)(h) health or social care`, `Art 9(2)(i) public interest in the area of public health`, `Art 9(2)(j) archiving, research or statistical purposes`)
#ASSERT elem `Art 9(2)(c) vital interests where the data subject cannot give consent` (LIST `Art 9(2)(a) explicit consent`, `Art 9(2)(b) employment and social security and social protection law`, `Art 9(2)(c) vital interests where the data subject cannot give consent`, `Art 9(2)(d) a not-for-profit body and its members`, `Art 9(2)(e) data manifestly made public by the data subject`, `Art 9(2)(f) legal claims or courts acting in their judicial capacity`, `Art 9(2)(g) substantial public interest`, `Art 9(2)(h) health or social care`, `Art 9(2)(i) public interest in the area of public health`, `Art 9(2)(j) archiving, research or statistical purposes`)
#ASSERT elem `Art 9(2)(d) a not-for-profit body and its members` (LIST `Art 9(2)(a) explicit consent`, `Art 9(2)(b) employment and social security and social protection law`, `Art 9(2)(c) vital interests where the data subject cannot give consent`, `Art 9(2)(d) a not-for-profit body and its members`, `Art 9(2)(e) data manifestly made public by the data subject`, `Art 9(2)(f) legal claims or courts acting in their judicial capacity`, `Art 9(2)(g) substantial public interest`, `Art 9(2)(h) health or social care`, `Art 9(2)(i) public interest in the area of public health`, `Art 9(2)(j) archiving, research or statistical purposes`)
#ASSERT elem `Art 9(2)(e) data manifestly made public by the data subject` (LIST `Art 9(2)(a) explicit consent`, `Art 9(2)(b) employment and social security and social protection law`, `Art 9(2)(c) vital interests where the data subject cannot give consent`, `Art 9(2)(d) a not-for-profit body and its members`, `Art 9(2)(e) data manifestly made public by the data subject`, `Art 9(2)(f) legal claims or courts acting in their judicial capacity`, `Art 9(2)(g) substantial public interest`, `Art 9(2)(h) health or social care`, `Art 9(2)(i) public interest in the area of public health`, `Art 9(2)(j) archiving, research or statistical purposes`)
#ASSERT elem `Art 9(2)(f) legal claims or courts acting in their judicial capacity` (LIST `Art 9(2)(a) explicit consent`, `Art 9(2)(b) employment and social security and social protection law`, `Art 9(2)(c) vital interests where the data subject cannot give consent`, `Art 9(2)(d) a not-for-profit body and its members`, `Art 9(2)(e) data manifestly made public by the data subject`, `Art 9(2)(f) legal claims or courts acting in their judicial capacity`, `Art 9(2)(g) substantial public interest`, `Art 9(2)(h) health or social care`, `Art 9(2)(i) public interest in the area of public health`, `Art 9(2)(j) archiving, research or statistical purposes`)
#ASSERT elem `Art 9(2)(g) substantial public interest` (LIST `Art 9(2)(a) explicit consent`, `Art 9(2)(b) employment and social security and social protection law`, `Art 9(2)(c) vital interests where the data subject cannot give consent`, `Art 9(2)(d) a not-for-profit body and its members`, `Art 9(2)(e) data manifestly made public by the data subject`, `Art 9(2)(f) legal claims or courts acting in their judicial capacity`, `Art 9(2)(g) substantial public interest`, `Art 9(2)(h) health or social care`, `Art 9(2)(i) public interest in the area of public health`, `Art 9(2)(j) archiving, research or statistical purposes`)
#ASSERT elem `Art 9(2)(h) health or social care` (LIST `Art 9(2)(a) explicit consent`, `Art 9(2)(b) employment and social security and social protection law`, `Art 9(2)(c) vital interests where the data subject cannot give consent`, `Art 9(2)(d) a not-for-profit body and its members`, `Art 9(2)(e) data manifestly made public by the data subject`, `Art 9(2)(f) legal claims or courts acting in their judicial capacity`, `Art 9(2)(g) substantial public interest`, `Art 9(2)(h) health or social care`, `Art 9(2)(i) public interest in the area of public health`, `Art 9(2)(j) archiving, research or statistical purposes`)
#ASSERT elem `Art 9(2)(i) public interest in the area of public health` (LIST `Art 9(2)(a) explicit consent`, `Art 9(2)(b) employment and social security and social protection law`, `Art 9(2)(c) vital interests where the data subject cannot give consent`, `Art 9(2)(d) a not-for-profit body and its members`, `Art 9(2)(e) data manifestly made public by the data subject`, `Art 9(2)(f) legal claims or courts acting in their judicial capacity`, `Art 9(2)(g) substantial public interest`, `Art 9(2)(h) health or social care`, `Art 9(2)(i) public interest in the area of public health`, `Art 9(2)(j) archiving, research or statistical purposes`)
#ASSERT elem `Art 9(2)(j) archiving, research or statistical purposes` (LIST `Art 9(2)(a) explicit consent`, `Art 9(2)(b) employment and social security and social protection law`, `Art 9(2)(c) vital interests where the data subject cannot give consent`, `Art 9(2)(d) a not-for-profit body and its members`, `Art 9(2)(e) data manifestly made public by the data subject`, `Art 9(2)(f) legal claims or courts acting in their judicial capacity`, `Art 9(2)(g) substantial public interest`, `Art 9(2)(h) health or social care`, `Art 9(2)(i) public interest in the area of public health`, `Art 9(2)(j) archiving, research or statistical purposes`)
#ASSERT NOT (`Art 9(2)(a) explicit consent` EQUALS `Art 9(2)(b) employment and social security and social protection law`)
#ASSERT NOT (`Art 9(2)(b) employment and social security and social protection law` EQUALS `Art 9(2)(c) vital interests where the data subject cannot give consent`)
#ASSERT NOT (`Art 9(2)(c) vital interests where the data subject cannot give consent` EQUALS `Art 9(2)(d) a not-for-profit body and its members`)
#ASSERT NOT (`Art 9(2)(d) a not-for-profit body and its members` EQUALS `Art 9(2)(e) data manifestly made public by the data subject`)
#ASSERT NOT (`Art 9(2)(e) data manifestly made public by the data subject` EQUALS `Art 9(2)(f) legal claims or courts acting in their judicial capacity`)
#ASSERT NOT (`Art 9(2)(f) legal claims or courts acting in their judicial capacity` EQUALS `Art 9(2)(g) substantial public interest`)
#ASSERT NOT (`Art 9(2)(g) substantial public interest` EQUALS `Art 9(2)(h) health or social care`)
#ASSERT NOT (`Art 9(2)(h) health or social care` EQUALS `Art 9(2)(i) public interest in the area of public health`)
#ASSERT NOT (`Art 9(2)(i) public interest in the area of public health` EQUALS `Art 9(2)(j) archiving, research or statistical purposes`)

-- the nine roles
#ASSERT elem `data subject` (LIST `data subject`, `controller`, `joint controller`, `processor`, `recipient`, `third party`, `representative`, `supervisory authority`, `child`)
#ASSERT elem `controller` (LIST `data subject`, `controller`, `joint controller`, `processor`, `recipient`, `third party`, `representative`, `supervisory authority`, `child`)
#ASSERT elem `joint controller` (LIST `data subject`, `controller`, `joint controller`, `processor`, `recipient`, `third party`, `representative`, `supervisory authority`, `child`)
#ASSERT elem `processor` (LIST `data subject`, `controller`, `joint controller`, `processor`, `recipient`, `third party`, `representative`, `supervisory authority`, `child`)
#ASSERT elem `recipient` (LIST `data subject`, `controller`, `joint controller`, `processor`, `recipient`, `third party`, `representative`, `supervisory authority`, `child`)
#ASSERT elem `third party` (LIST `data subject`, `controller`, `joint controller`, `processor`, `recipient`, `third party`, `representative`, `supervisory authority`, `child`)
#ASSERT elem `representative` (LIST `data subject`, `controller`, `joint controller`, `processor`, `recipient`, `third party`, `representative`, `supervisory authority`, `child`)
#ASSERT elem `supervisory authority` (LIST `data subject`, `controller`, `joint controller`, `processor`, `recipient`, `third party`, `representative`, `supervisory authority`, `child`)
#ASSERT elem `child` (LIST `data subject`, `controller`, `joint controller`, `processor`, `recipient`, `third party`, `representative`, `supervisory authority`, `child`)
#ASSERT NOT (`data subject` EQUALS `controller`)
#ASSERT NOT (`controller` EQUALS `joint controller`)
#ASSERT NOT (`joint controller` EQUALS `processor`)
#ASSERT NOT (`processor` EQUALS `recipient`)
#ASSERT NOT (`recipient` EQUALS `third party`)
#ASSERT NOT (`third party` EQUALS `representative`)
#ASSERT NOT (`representative` EQUALS `supervisory authority`)
#ASSERT NOT (`supervisory authority` EQUALS `child`)

-- the seven principles of Art 5 are distinct from the six lawful bases of Art 6(1) by type; a principle equals itself
#ASSERT `Art 5(2) accountability` EQUALS `Art 5(2) accountability`
