IMPORT prelude
IMPORT `gdpr-core`
IMPORT `P1-art-11`

-- ============================================================================
-- P1-tests-art-11.l4 -- tests of Art 11.  Expected values written from the text (src:140-141).
-- ============================================================================

§ `Art 11(1)`

-- the purposes do not require identification, and the information would be kept for the sole purpose of complying with this Regulation
#ASSERT `Art 11(1) the controller is obliged to maintain, acquire or process additional information in order to identify the data subject` TRUE TRUE EQUALS JUST FALSE
-- not covered: the purposes do require identification, or the information would serve another purpose
#ASSERT `Art 11(1) the controller is obliged to maintain, acquire or process additional information in order to identify the data subject` FALSE TRUE EQUALS NOTHING
#ASSERT `Art 11(1) the controller is obliged to maintain, acquire or process additional information in order to identify the data subject` TRUE FALSE EQUALS NOTHING
#ASSERT `Art 11(1) the controller is obliged to maintain, acquire or process additional information in order to identify the data subject` FALSE FALSE EQUALS NOTHING

§ `Art 11(2), first sentence`

-- all the conditions hold and the controller informed the data subject
#ASSERT `Art 11(2) the controller informs the data subject that it is not in a position to identify the data subject` TRUE TRUE TRUE TRUE EQUALS JUST `the duty arises and is met`
-- all hold and it did not
#ASSERT `Art 11(2) the controller informs the data subject that it is not in a position to identify the data subject` TRUE TRUE TRUE FALSE EQUALS JUST `the duty arises and is not met`
-- "if possible": it was not possible (no contact details at all)
#ASSERT `Art 11(2) the controller informs the data subject that it is not in a position to identify the data subject` TRUE TRUE FALSE FALSE EQUALS JUST `the duty does not arise`
-- the controller cannot demonstrate that it is not in a position to identify: the duty is not triggered
#ASSERT `Art 11(2) the controller informs the data subject that it is not in a position to identify the data subject` TRUE FALSE TRUE FALSE EQUALS JUST `the duty does not arise`
-- not a case of paragraph 1
#ASSERT `Art 11(2) the controller informs the data subject that it is not in a position to identify the data subject` FALSE TRUE TRUE FALSE EQUALS JUST `the duty does not arise`

#TRACE `Art 11(2) the controller must inform the data subject accordingly` TRUE AT 0 WITH
    PARTY `controller` DOES `Art 11(2) inform the data subject accordingly` AT 4
-- expected: FULFILLED
#TRACE `Art 11(2) the controller must inform the data subject accordingly` TRUE AT 0 WITH
    (WAITUNTIL 1000)
-- expected: still standing, never a breach (no time limit in the text)
#TRACE `Art 11(2) the controller must inform the data subject accordingly` FALSE AT 0 WITH
    (WAITUNTIL 1000)
-- expected: FULFILLED (the duty does not arise)

§ `Art 11(2), second sentence: Articles 15 to 20`

-- such a case and no identifying information given: Articles 15 to 20 shall not apply
#ASSERT `Art 11(2) Articles 15 to 20 are disapplied` TRUE TRUE FALSE EQUALS JUST TRUE
-- "except where": the data subject provides additional information enabling identification
#ASSERT `Art 11(2) Articles 15 to 20 are disapplied` TRUE TRUE TRUE EQUALS JUST FALSE
-- not covered: not "such cases"
#ASSERT `Art 11(2) Articles 15 to 20 are disapplied` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `Art 11(2) Articles 15 to 20 are disapplied` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `Art 11(2) Articles 15 to 20 are disapplied` FALSE FALSE TRUE EQUALS NOTHING
