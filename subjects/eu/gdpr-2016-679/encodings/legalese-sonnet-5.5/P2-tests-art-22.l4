IMPORT prelude
IMPORT `gdpr-core`
IMPORT `P2-art-22`

-- ============================================================================
-- P2-tests-art-22.l4 -- tests of Article 22 (src:271-279).
-- Every expected value was written by hand from the text of the provision named in the comment above it,
-- before the first run, and none was copied from an output (notes/gen-tests-p2.py holds the cases).
-- A #TRACE result is not an assertion and check.sh does not count it; each trace comment gives the expected result.
-- ============================================================================

§ `Art 22(2)(a) to (c): the three points`

-- (a) necessary for entering into or performing a contract between the data subject and a controller
#ASSERT `Art 22(2)(a) point (a) applies: the decision is necessary for entering into, or performance of, a contract between the data subject and a data controller` TRUE EQUALS JUST TRUE
-- (a) not necessary: 'if' fails
#ASSERT `Art 22(2)(a) point (a) applies: the decision is necessary for entering into, or performance of, a contract between the data subject and a data controller` FALSE EQUALS JUST FALSE
-- (b) authorised by law which also lays down suitable measures
#ASSERT `Art 22(2)(b) point (b) applies: the decision is authorised by Union or Member State law which also lays down suitable measures` TRUE TRUE EQUALS JUST TRUE
-- (b) authorised, but the law lays down no suitable measures: 'and which also lays down'
#ASSERT `Art 22(2)(b) point (b) applies: the decision is authorised by Union or Member State law which also lays down suitable measures` TRUE FALSE EQUALS JUST FALSE
-- (b) not authorised by law
#ASSERT `Art 22(2)(b) point (b) applies: the decision is authorised by Union or Member State law which also lays down suitable measures` FALSE TRUE EQUALS JUST FALSE
-- (c) based on the data subject's explicit consent
#ASSERT `Art 22(2)(c) point (c) applies: the decision is based on the data subject's explicit consent` TRUE EQUALS JUST TRUE
-- (c) no explicit consent
#ASSERT `Art 22(2)(c) point (c) applies: the decision is based on the data subject's explicit consent` FALSE EQUALS JUST FALSE
-- point (a) holds
#ASSERT `Art 22(2) paragraph 1 does not apply` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
-- point (b) holds
#ASSERT `Art 22(2) paragraph 1 does not apply` (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
-- point (c) holds
#ASSERT `Art 22(2) paragraph 1 does not apply` (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
-- no point holds: 'if' fails in each
#ASSERT `Art 22(2) paragraph 1 does not apply` (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
-- no point holds and (c) is not decided: not covered
#ASSERT `Art 22(2) paragraph 1 does not apply` (JUST FALSE) (JUST FALSE) NOTHING EQUALS NOTHING

§ `Art 22(1): the right not to be subject to an automated decision`

-- solely automated, legal effects, no exception
#ASSERT `Art 22(1) the data subject has the right not to be subject to a decision based solely on automated processing which produces legal effects or similarly significantly affects him or her` TRUE TRUE FALSE TRUE FALSE (JUST FALSE) EQUALS JUST TRUE
-- profiling (not read), a similarly significant effect, no exception
#ASSERT `Art 22(1) the data subject has the right not to be subject to a decision based solely on automated processing which produces legal effects or similarly significantly affects him or her` TRUE TRUE TRUE FALSE TRUE (JUST FALSE) EQUALS JUST TRUE
-- no legal effect and no similarly significant effect: outside the grant
#ASSERT `Art 22(1) the data subject has the right not to be subject to a decision based solely on automated processing which produces legal effects or similarly significantly affects him or her` TRUE TRUE FALSE FALSE FALSE (JUST FALSE) EQUALS NOTHING
-- not based solely on automated processing: outside the grant
#ASSERT `Art 22(1) the data subject has the right not to be subject to a decision based solely on automated processing which produces legal effects or similarly significantly affects him or her` TRUE FALSE FALSE TRUE FALSE (JUST FALSE) EQUALS NOTHING
-- not the data subject
#ASSERT `Art 22(1) the data subject has the right not to be subject to a decision based solely on automated processing which produces legal effects or similarly significantly affects him or her` FALSE TRUE FALSE TRUE FALSE (JUST FALSE) EQUALS NOTHING
-- paragraph 2 takes the decision out of paragraph 1: 'shall not apply'
#ASSERT `Art 22(1) the data subject has the right not to be subject to a decision based solely on automated processing which produces legal effects or similarly significantly affects him or her` TRUE TRUE FALSE TRUE FALSE (JUST TRUE) EQUALS JUST FALSE
-- whether paragraph 2 applies is not decided
#ASSERT `Art 22(1) the data subject has the right not to be subject to a decision based solely on automated processing which produces legal effects or similarly significantly affects him or her` TRUE TRUE FALSE TRUE FALSE NOTHING EQUALS NOTHING
-- BREACH: the controller subjects the data subject to such a decision (the act is the breach)
#TRACE `Art 22(1) the controller shall not subject the data subject to a decision based solely on automated processing` (JUST TRUE) AT 0 WITH
    PARTY controller DOES `Art 22(1) subject the data subject to a decision based solely on automated processing` AT 1
-- no such decision: the prohibition stands, unbroken
#TRACE `Art 22(1) the controller shall not subject the data subject to a decision based solely on automated processing` (JUST TRUE) AT 0 WITH
    (WAITUNTIL 1000)
-- FULFILLED: paragraph 2 applies (or no right), so the decision is not barred by paragraph 1
#TRACE `Art 22(1) the controller shall not subject the data subject to a decision based solely on automated processing` (JUST FALSE) AT 0 WITH
    PARTY controller DOES `Art 22(1) subject the data subject to a decision based solely on automated processing` AT 1

§ `Art 22(3): suitable measures in the cases of points (a) and (c)`

-- point (a) case, all three safeguards
#ASSERT `Art 22(3) in the cases of points (a) and (c) of paragraph 2 the controller implements suitable measures, at least the right to human intervention, to express a point of view and to contest the decision` (JUST TRUE) (JUST FALSE) TRUE TRUE TRUE TRUE EQUALS JUST `the duty arises and is met`
-- point (c) case, all three safeguards
#ASSERT `Art 22(3) in the cases of points (a) and (c) of paragraph 2 the controller implements suitable measures, at least the right to human intervention, to express a point of view and to contest the decision` (JUST FALSE) (JUST TRUE) TRUE TRUE TRUE TRUE EQUALS JUST `the duty arises and is met`
-- no right to obtain human intervention: 'at least'
#ASSERT `Art 22(3) in the cases of points (a) and (c) of paragraph 2 the controller implements suitable measures, at least the right to human intervention, to express a point of view and to contest the decision` (JUST TRUE) (JUST FALSE) TRUE FALSE TRUE TRUE EQUALS JUST `the duty arises and is not met`
-- no right to express a point of view
#ASSERT `Art 22(3) in the cases of points (a) and (c) of paragraph 2 the controller implements suitable measures, at least the right to human intervention, to express a point of view and to contest the decision` (JUST TRUE) (JUST FALSE) TRUE TRUE FALSE TRUE EQUALS JUST `the duty arises and is not met`
-- no right to contest the decision
#ASSERT `Art 22(3) in the cases of points (a) and (c) of paragraph 2 the controller implements suitable measures, at least the right to human intervention, to express a point of view and to contest the decision` (JUST TRUE) (JUST FALSE) TRUE TRUE TRUE FALSE EQUALS JUST `the duty arises and is not met`
-- no suitable measures at all
#ASSERT `Art 22(3) in the cases of points (a) and (c) of paragraph 2 the controller implements suitable measures, at least the right to human intervention, to express a point of view and to contest the decision` (JUST TRUE) (JUST FALSE) FALSE TRUE TRUE TRUE EQUALS JUST `the duty arises and is not met`
-- a point (b) decision, or none: outside 'the cases referred to in points (a) and (c)'
#ASSERT `Art 22(3) in the cases of points (a) and (c) of paragraph 2 the controller implements suitable measures, at least the right to human intervention, to express a point of view and to contest the decision` (JUST FALSE) (JUST FALSE) TRUE TRUE TRUE TRUE EQUALS NOTHING
-- point (a) not decided and (c) not met: not covered
#ASSERT `Art 22(3) in the cases of points (a) and (c) of paragraph 2 the controller implements suitable measures, at least the right to human intervention, to express a point of view and to contest the decision` NOTHING (JUST FALSE) TRUE TRUE TRUE TRUE EQUALS NOTHING
-- FULFILLED: the measures are implemented
#TRACE `Art 22(3) the controller must implement suitable measures in the cases of points (a) and (c) of paragraph 2` (JUST TRUE) (JUST FALSE) AT 0 WITH
    PARTY controller DOES `Art 22(3) implement suitable measures to safeguard the data subject's rights and freedoms and legitimate interests` AT 1
-- no act: the obligation stands; no breach is possible (no time limit)
#TRACE `Art 22(3) the controller must implement suitable measures in the cases of points (a) and (c) of paragraph 2` (JUST TRUE) (JUST FALSE) AT 0 WITH
    (WAITUNTIL 1000)
-- FULFILLED: not a point (a) or (c) case
#TRACE `Art 22(3) the controller must implement suitable measures in the cases of points (a) and (c) of paragraph 2` (JUST FALSE) (JUST FALSE) AT 0 WITH
    (WAITUNTIL 1000)

§ `Art 22(4): special categories of personal data`

-- point (a) of Article 9(2) applies and suitable measures are in place: 'unless'
#ASSERT `Art 22(4) decisions referred to in paragraph 2 shall not be based on special categories of personal data referred to in Article 9(1)` TRUE TRUE (JUST TRUE) (JUST FALSE) TRUE EQUALS JUST FALSE
-- point (g) applies and suitable measures are in place
#ASSERT `Art 22(4) decisions referred to in paragraph 2 shall not be based on special categories of personal data referred to in Article 9(1)` TRUE TRUE (JUST FALSE) (JUST TRUE) TRUE EQUALS JUST FALSE
-- point (a) applies but suitable measures are not in place: the bar stands
#ASSERT `Art 22(4) decisions referred to in paragraph 2 shall not be based on special categories of personal data referred to in Article 9(1)` TRUE TRUE (JUST TRUE) (JUST FALSE) FALSE EQUALS JUST TRUE
-- neither point applies: the bar stands
#ASSERT `Art 22(4) decisions referred to in paragraph 2 shall not be based on special categories of personal data referred to in Article 9(1)` TRUE TRUE (JUST FALSE) (JUST FALSE) TRUE EQUALS JUST TRUE
-- neither applies, no measures
#ASSERT `Art 22(4) decisions referred to in paragraph 2 shall not be based on special categories of personal data referred to in Article 9(1)` TRUE TRUE (JUST FALSE) (JUST FALSE) FALSE EQUALS JUST TRUE
-- (a) and (g) both apply, but no suitable measures are in place: the 'unless' needs point (a) or (g) AND the measures, so the bar stands (R2)
#ASSERT `Art 22(4) decisions referred to in paragraph 2 shall not be based on special categories of personal data referred to in Article 9(1)` TRUE TRUE (JUST TRUE) (JUST TRUE) FALSE EQUALS JUST TRUE
-- (a) applies, (g) not decided, but no suitable measures are in place: the 'unless' needs point (a) or (g) AND the measures, so the bar stands (R2)
#ASSERT `Art 22(4) decisions referred to in paragraph 2 shall not be based on special categories of personal data referred to in Article 9(1)` TRUE TRUE (JUST TRUE) NOTHING FALSE EQUALS JUST TRUE
-- (a) fails, (g) applies, but no suitable measures are in place: the 'unless' needs point (a) or (g) AND the measures, so the bar stands (R2)
#ASSERT `Art 22(4) decisions referred to in paragraph 2 shall not be based on special categories of personal data referred to in Article 9(1)` TRUE TRUE (JUST FALSE) (JUST TRUE) FALSE EQUALS JUST TRUE
-- (a) fails, (g) not decided, but no suitable measures are in place: the 'unless' needs point (a) or (g) AND the measures, so the bar stands (R2)
#ASSERT `Art 22(4) decisions referred to in paragraph 2 shall not be based on special categories of personal data referred to in Article 9(1)` TRUE TRUE (JUST FALSE) NOTHING FALSE EQUALS JUST TRUE
-- (a) not decided, (g) applies, but no suitable measures are in place: the 'unless' needs point (a) or (g) AND the measures, so the bar stands (R2)
#ASSERT `Art 22(4) decisions referred to in paragraph 2 shall not be based on special categories of personal data referred to in Article 9(1)` TRUE TRUE NOTHING (JUST TRUE) FALSE EQUALS JUST TRUE
-- (a) not decided, (g) fails, but no suitable measures are in place: the 'unless' needs point (a) or (g) AND the measures, so the bar stands (R2)
#ASSERT `Art 22(4) decisions referred to in paragraph 2 shall not be based on special categories of personal data referred to in Article 9(1)` TRUE TRUE NOTHING (JUST FALSE) FALSE EQUALS JUST TRUE
-- neither decided, but no suitable measures are in place: the 'unless' needs point (a) or (g) AND the measures, so the bar stands (R2)
#ASSERT `Art 22(4) decisions referred to in paragraph 2 shall not be based on special categories of personal data referred to in Article 9(1)` TRUE TRUE NOTHING NOTHING FALSE EQUALS JUST TRUE
-- point (a) not decided, (g) fails: not covered
#ASSERT `Art 22(4) decisions referred to in paragraph 2 shall not be based on special categories of personal data referred to in Article 9(1)` TRUE TRUE NOTHING (JUST FALSE) TRUE EQUALS NOTHING
-- point (g) applies with measures: lifts the bar whatever (a) is
#ASSERT `Art 22(4) decisions referred to in paragraph 2 shall not be based on special categories of personal data referred to in Article 9(1)` TRUE TRUE NOTHING (JUST TRUE) TRUE EQUALS JUST FALSE
-- not based on special categories: the bar is not engaged
#ASSERT `Art 22(4) decisions referred to in paragraph 2 shall not be based on special categories of personal data referred to in Article 9(1)` TRUE FALSE (JUST FALSE) (JUST FALSE) FALSE EQUALS NOTHING
-- not a decision referred to in paragraph 2: outside the paragraph
#ASSERT `Art 22(4) decisions referred to in paragraph 2 shall not be based on special categories of personal data referred to in Article 9(1)` FALSE TRUE (JUST FALSE) (JUST FALSE) FALSE EQUALS NOTHING
