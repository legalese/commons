IMPORT prelude
IMPORT `gdpr-core`
IMPORT `K2-art-2b`

-- ============================================================================
-- K2-tests-art-2b.l4 -- tests of Art 2(3) and (4) (src:27-28).  Expected values are written from the text.
-- ============================================================================

§ `Art 2(3) first sentence: Regulation (EC) No 45/2001 applies to processing by the Union bodies`

-- processing by a Union institution, body, office or agency: the text says Regulation (EC) No 45/2001 applies
#ASSERT `Art 2(3) Regulation (EC) No 45/2001 applies to the processing, where it is by the Union institutions, bodies, offices or agencies` TRUE EQUALS JUST TRUE
-- processing by a private company: the sentence says nothing of Regulation (EC) No 45/2001
#ASSERT `Art 2(3) Regulation (EC) No 45/2001 applies to the processing, where it is by the Union institutions, bodies, offices or agencies` FALSE EQUALS NOTHING

§ `Art 2(3) first sentence read as displacing this Regulation (reading A, FK2-1, a marginal reading)`

-- processing by a Union body: reading A, the other instrument applies and this Regulation does not
#ASSERT `Art 2(3) this Regulation applies to the processing, where it is by the Union institutions, bodies, offices or agencies` TRUE EQUALS JUST FALSE
-- processing by anyone else: the sentence does not say whether this Regulation applies
#ASSERT `Art 2(3) this Regulation applies to the processing, where it is by the Union institutions, bodies, offices or agencies` FALSE EQUALS NOTHING

§ `Art 2(3) second sentence: the Union legal acts are to be adapted in accordance with Article 98`

-- an act applicable to such processing that has been adapted
#ASSERT `Art 2(3) the Union legal act applicable to such processing is adapted to the principles and rules of this Regulation in accordance with Article 98` TRUE TRUE EQUALS JUST TRUE
-- an act applicable to such processing that has not been adapted: 'shall be adapted'
#ASSERT `Art 2(3) the Union legal act applicable to such processing is adapted to the principles and rules of this Regulation in accordance with Article 98` TRUE FALSE EQUALS JUST FALSE
-- an act not applicable to such processing, adapted anyway: outside the sentence
#ASSERT `Art 2(3) the Union legal act applicable to such processing is adapted to the principles and rules of this Regulation in accordance with Article 98` FALSE TRUE EQUALS NOTHING
-- an act not applicable to such processing, not adapted: outside the sentence
#ASSERT `Art 2(3) the Union legal act applicable to such processing is adapted to the principles and rules of this Regulation in accordance with Article 98` FALSE FALSE EQUALS NOTHING

§ `Art 2(4): without prejudice to Directive 2000/31/EC`

-- the application of the Directive in general
#ASSERT `Art 2(4) this Regulation is without prejudice to the application of Directive 2000/31/EC` TRUE FALSE EQUALS JUST TRUE
-- the liability rules of intermediary service providers in Articles 12 to 15: 'in particular'
#ASSERT `Art 2(4) this Regulation is without prejudice to the application of Directive 2000/31/EC` TRUE TRUE EQUALS JUST TRUE
-- the liability rules alone: they are the Directive's application in particular
#ASSERT `Art 2(4) this Regulation is without prejudice to the application of Directive 2000/31/EC` FALSE TRUE EQUALS JUST TRUE
-- some other instrument: the provision saves only Directive 2000/31/EC
#ASSERT `Art 2(4) this Regulation is without prejudice to the application of Directive 2000/31/EC` FALSE FALSE EQUALS NOTHING
