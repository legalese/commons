IMPORT prelude
IMPORT `gdpr-core`
IMPORT `P2-art-13`

-- ============================================================================
-- P2-tests-art-13.l4 -- tests of Article 13 (src:161-178).
-- Every expected value was written by hand from the text of the provision named in the comment above it,
-- before the first run, and none was copied from an output (notes/gen-tests-p2.py holds the cases).
-- A #TRACE result is not an assertion and check.sh does not count it; each trace comment gives the expected result.
-- ============================================================================

§ `Art 13(1): the information at the time when the data are obtained`

-- the data are not collected from the data subject: 'Where personal data ... are collected from the data subject' fails
#ASSERT `Art 13(1) the controller provides the data subject with all of the following information` FALSE FALSE FALSE (JUST FALSE) FALSE FALSE EMPTY EMPTY TRUE EQUALS JUST `the duty does not arise`
-- collected; no representative, officer, recipients or transfer; point (f) not relied on; points (a) and (c) provided
#ASSERT `Art 13(1) the controller provides the data subject with all of the following information` TRUE FALSE FALSE (JUST FALSE) FALSE FALSE (LIST `Art 13(1)(a) the identity and the contact details of the controller`, `Art 13(1)(c) the purposes of the processing for which the personal data are intended`, `Art 13(1)(c) the legal basis for the processing`) EMPTY TRUE EQUALS JUST `the duty arises and is met`
-- (a) the identity and contact details of the controller not provided
#ASSERT `Art 13(1) the controller provides the data subject with all of the following information` TRUE FALSE FALSE (JUST FALSE) FALSE FALSE (LIST `Art 13(1)(c) the purposes of the processing for which the personal data are intended`, `Art 13(1)(c) the legal basis for the processing`) EMPTY TRUE EQUALS JUST `the duty arises and is not met`
-- (c) the purposes not provided
#ASSERT `Art 13(1) the controller provides the data subject with all of the following information` TRUE FALSE FALSE (JUST FALSE) FALSE FALSE (LIST `Art 13(1)(a) the identity and the contact details of the controller`, `Art 13(1)(c) the legal basis for the processing`) EMPTY TRUE EQUALS JUST `the duty arises and is not met`
-- (c) the legal basis not provided
#ASSERT `Art 13(1) the controller provides the data subject with all of the following information` TRUE FALSE FALSE (JUST FALSE) FALSE FALSE (LIST `Art 13(1)(a) the identity and the contact details of the controller`, `Art 13(1)(c) the purposes of the processing for which the personal data are intended`) EMPTY TRUE EQUALS JUST `the duty arises and is not met`
-- nothing provided
#ASSERT `Art 13(1) the controller provides the data subject with all of the following information` TRUE FALSE FALSE (JUST FALSE) FALSE FALSE EMPTY EMPTY TRUE EQUALS JUST `the duty arises and is not met`
-- (a) 'where applicable, of the controller's representative': there is one and its identity was not provided
#ASSERT `Art 13(1) the controller provides the data subject with all of the following information` TRUE TRUE FALSE (JUST FALSE) FALSE FALSE (LIST `Art 13(1)(a) the identity and the contact details of the controller`, `Art 13(1)(c) the purposes of the processing for which the personal data are intended`, `Art 13(1)(c) the legal basis for the processing`) EMPTY TRUE EQUALS JUST `the duty arises and is not met`
-- the representative's identity and contact details provided too
#ASSERT `Art 13(1) the controller provides the data subject with all of the following information` TRUE TRUE FALSE (JUST FALSE) FALSE FALSE (LIST `Art 13(1)(a) the identity and the contact details of the controller`, `Art 13(1)(c) the purposes of the processing for which the personal data are intended`, `Art 13(1)(c) the legal basis for the processing`, `Art 13(1)(a) the identity and the contact details of the controller's representative`) EMPTY TRUE EQUALS JUST `the duty arises and is met`
-- (b) 'where applicable': there is an officer and the contact details were not provided
#ASSERT `Art 13(1) the controller provides the data subject with all of the following information` TRUE FALSE TRUE (JUST FALSE) FALSE FALSE (LIST `Art 13(1)(a) the identity and the contact details of the controller`, `Art 13(1)(c) the purposes of the processing for which the personal data are intended`, `Art 13(1)(c) the legal basis for the processing`) EMPTY TRUE EQUALS JUST `the duty arises and is not met`
-- (b) provided
#ASSERT `Art 13(1) the controller provides the data subject with all of the following information` TRUE FALSE TRUE (JUST FALSE) FALSE FALSE (LIST `Art 13(1)(a) the identity and the contact details of the controller`, `Art 13(1)(c) the purposes of the processing for which the personal data are intended`, `Art 13(1)(c) the legal basis for the processing`, `Art 13(1)(b) the contact details of the data protection officer`) EMPTY TRUE EQUALS JUST `the duty arises and is met`
-- (e) 'if any': there are recipients and they were not named
#ASSERT `Art 13(1) the controller provides the data subject with all of the following information` TRUE FALSE FALSE (JUST FALSE) TRUE FALSE (LIST `Art 13(1)(a) the identity and the contact details of the controller`, `Art 13(1)(c) the purposes of the processing for which the personal data are intended`, `Art 13(1)(c) the legal basis for the processing`) EMPTY TRUE EQUALS JUST `the duty arises and is not met`
-- (e) provided
#ASSERT `Art 13(1) the controller provides the data subject with all of the following information` TRUE FALSE FALSE (JUST FALSE) TRUE FALSE (LIST `Art 13(1)(a) the identity and the contact details of the controller`, `Art 13(1)(c) the purposes of the processing for which the personal data are intended`, `Art 13(1)(c) the legal basis for the processing`, `Art 13(1)(e) the recipients or categories of recipients of the personal data`) EMPTY TRUE EQUALS JUST `the duty arises and is met`
-- (f) 'where applicable': a transfer is intended and it was not disclosed
#ASSERT `Art 13(1) the controller provides the data subject with all of the following information` TRUE FALSE FALSE (JUST FALSE) FALSE TRUE (LIST `Art 13(1)(a) the identity and the contact details of the controller`, `Art 13(1)(c) the purposes of the processing for which the personal data are intended`, `Art 13(1)(c) the legal basis for the processing`) EMPTY TRUE EQUALS JUST `the duty arises and is not met`
-- (f) provided
#ASSERT `Art 13(1) the controller provides the data subject with all of the following information` TRUE FALSE FALSE (JUST FALSE) FALSE TRUE (LIST `Art 13(1)(a) the identity and the contact details of the controller`, `Art 13(1)(c) the purposes of the processing for which the personal data are intended`, `Art 13(1)(c) the legal basis for the processing`, `Art 13(1)(f) the intended transfer to a third country or international organisation and the adequacy decision or the safeguards`) EMPTY TRUE EQUALS JUST `the duty arises and is met`
-- (d) 'where the processing is based on point (f) of Article 6(1)': it is, and the legitimate interests were not provided
#ASSERT `Art 13(1) the controller provides the data subject with all of the following information` TRUE FALSE FALSE (JUST TRUE) FALSE FALSE (LIST `Art 13(1)(a) the identity and the contact details of the controller`, `Art 13(1)(c) the purposes of the processing for which the personal data are intended`, `Art 13(1)(c) the legal basis for the processing`) EMPTY TRUE EQUALS JUST `the duty arises and is not met`
-- (d) provided
#ASSERT `Art 13(1) the controller provides the data subject with all of the following information` TRUE FALSE FALSE (JUST TRUE) FALSE FALSE (LIST `Art 13(1)(a) the identity and the contact details of the controller`, `Art 13(1)(c) the purposes of the processing for which the personal data are intended`, `Art 13(1)(c) the legal basis for the processing`, `Art 13(1)(d) the legitimate interests pursued by the controller or by a third party`) EMPTY TRUE EQUALS JUST `the duty arises and is met`
-- (d) not owed: point (f) does not apply
#ASSERT `Art 13(1) the controller provides the data subject with all of the following information` TRUE FALSE FALSE (JUST FALSE) FALSE FALSE (LIST `Art 13(1)(a) the identity and the contact details of the controller`, `Art 13(1)(c) the purposes of the processing for which the personal data are intended`, `Art 13(1)(c) the legal basis for the processing`) EMPTY TRUE EQUALS JUST `the duty arises and is met`
-- whether point (f) applies is not answered (P1): item (d) is neither provided nor shown not to be owed
#ASSERT `Art 13(1) the controller provides the data subject with all of the following information` TRUE FALSE FALSE NOTHING FALSE FALSE (LIST `Art 13(1)(a) the identity and the contact details of the controller`, `Art 13(1)(c) the purposes of the processing for which the personal data are intended`, `Art 13(1)(c) the legal basis for the processing`) EMPTY TRUE EQUALS NOTHING
-- point (f) not answered, but (d) was provided in any event
#ASSERT `Art 13(1) the controller provides the data subject with all of the following information` TRUE FALSE FALSE NOTHING FALSE FALSE (LIST `Art 13(1)(a) the identity and the contact details of the controller`, `Art 13(1)(c) the purposes of the processing for which the personal data are intended`, `Art 13(1)(c) the legal basis for the processing`, `Art 13(1)(d) the legitimate interests pursued by the controller or by a third party`) EMPTY TRUE EQUALS JUST `the duty arises and is met`
-- point (f) not answered, but item (a) is missing: unmet whatever (d) is
#ASSERT `Art 13(1) the controller provides the data subject with all of the following information` TRUE FALSE FALSE NOTHING FALSE FALSE (LIST `Art 13(1)(c) the purposes of the processing for which the personal data are intended`, `Art 13(1)(c) the legal basis for the processing`) EMPTY TRUE EQUALS JUST `the duty arises and is not met`
-- (c) the legal basis: not provided, but the data subject already has it ('where and insofar as', paragraph 4)
#ASSERT `Art 13(1) the controller provides the data subject with all of the following information` TRUE FALSE FALSE (JUST FALSE) FALSE FALSE (LIST `Art 13(1)(a) the identity and the contact details of the controller`, `Art 13(1)(c) the purposes of the processing for which the personal data are intended`) (LIST `Art 13(1)(c) the legal basis for the processing`) TRUE EQUALS JUST `the duty arises and is met`
-- the data subject already has everything
#ASSERT `Art 13(1) the controller provides the data subject with all of the following information` TRUE FALSE FALSE (JUST FALSE) FALSE FALSE EMPTY (LIST `Art 13(1)(a) the identity and the contact details of the controller`, `Art 13(1)(c) the purposes of the processing for which the personal data are intended`, `Art 13(1)(c) the legal basis for the processing`) TRUE EQUALS JUST `the duty arises and is met`
-- the data subject already has the legal basis, but not the purposes
#ASSERT `Art 13(1) the controller provides the data subject with all of the following information` TRUE FALSE FALSE (JUST FALSE) FALSE FALSE (LIST `Art 13(1)(a) the identity and the contact details of the controller`) (LIST `Art 13(1)(c) the legal basis for the processing`) TRUE EQUALS JUST `the duty arises and is not met`
-- every point applies and every item is provided
#ASSERT `Art 13(1) the controller provides the data subject with all of the following information` TRUE TRUE TRUE (JUST TRUE) TRUE TRUE (LIST `Art 13(1)(a) the identity and the contact details of the controller`, `Art 13(1)(c) the purposes of the processing for which the personal data are intended`, `Art 13(1)(c) the legal basis for the processing`, `Art 13(1)(a) the identity and the contact details of the controller's representative`, `Art 13(1)(b) the contact details of the data protection officer`, `Art 13(1)(d) the legitimate interests pursued by the controller or by a third party`, `Art 13(1)(e) the recipients or categories of recipients of the personal data`, `Art 13(1)(f) the intended transfer to a third country or international organisation and the adequacy decision or the safeguards`) EMPTY TRUE EQUALS JUST `the duty arises and is met`
-- items provided that do not apply are harmless
#ASSERT `Art 13(1) the controller provides the data subject with all of the following information` TRUE FALSE FALSE (JUST FALSE) FALSE FALSE (LIST `Art 13(1)(a) the identity and the contact details of the controller`, `Art 13(1)(c) the purposes of the processing for which the personal data are intended`, `Art 13(1)(c) the legal basis for the processing`, `Art 13(1)(a) the identity and the contact details of the controller's representative`, `Art 13(1)(b) the contact details of the data protection officer`, `Art 13(1)(d) the legitimate interests pursued by the controller or by a third party`, `Art 13(1)(e) the recipients or categories of recipients of the personal data`, `Art 13(1)(f) the intended transfer to a third country or international organisation and the adequacy decision or the safeguards`) EMPTY TRUE EQUALS JUST `the duty arises and is met`
-- FULFILLED: provided at the time the data are obtained (the deadline, WITHIN 0, is inclusive)
#TRACE `Art 13(1) the controller must provide the data subject with all of the following information at the time when the personal data are obtained` TRUE AT 0 WITH
    PARTY controller DOES `Art 13(1) provide the data subject with all of the following information` AT 0
-- BREACH: provided one instant after the data were obtained
#TRACE `Art 13(1) the controller must provide the data subject with all of the following information at the time when the personal data are obtained` TRUE AT 0 WITH
    PARTY controller DOES `Art 13(1) provide the data subject with all of the following information` AT 1
-- BREACH: nothing provided when the time passes
#TRACE `Art 13(1) the controller must provide the data subject with all of the following information at the time when the personal data are obtained` TRUE AT 0 WITH
    (WAITUNTIL 1)
-- FULFILLED: the data are not collected from the data subject, so Article 14 and not this paragraph
#TRACE `Art 13(1) the controller must provide the data subject with all of the following information at the time when the personal data are obtained` FALSE AT 0 WITH
    (WAITUNTIL 1)

§ `Art 13(2): the further information`

-- data not collected from the data subject: 'In addition to the information referred to in paragraph 1' is not met, the text is silent
#ASSERT `Art 13(2) the controller provides the data subject with the following further information necessary to ensure fair and transparent processing` FALSE FALSE FALSE EMPTY EMPTY TRUE EQUALS NOTHING
-- (a), (b), (d), (e) provided; no consent basis and no automated decision-making
#ASSERT `Art 13(2) the controller provides the data subject with the following further information necessary to ensure fair and transparent processing` TRUE FALSE FALSE (LIST `Art 13(2)(a) the period for which the personal data will be stored, or the criteria used to determine that period`, `Art 13(2)(b) the existence of the rights of access, rectification, erasure, restriction, objection and data portability`, `Art 13(2)(d) the right to lodge a complaint with a supervisory authority`, `Art 13(2)(e) whether the provision of personal data is a statutory or contractual requirement, whether the data subject is obliged to provide the data and the possible consequences of failure`) EMPTY TRUE EQUALS JUST `the duty arises and is met`
-- (a) the storage period or criteria not provided
#ASSERT `Art 13(2) the controller provides the data subject with the following further information necessary to ensure fair and transparent processing` TRUE FALSE FALSE (LIST `Art 13(2)(b) the existence of the rights of access, rectification, erasure, restriction, objection and data portability`, `Art 13(2)(d) the right to lodge a complaint with a supervisory authority`, `Art 13(2)(e) whether the provision of personal data is a statutory or contractual requirement, whether the data subject is obliged to provide the data and the possible consequences of failure`) EMPTY TRUE EQUALS JUST `the duty arises and is not met`
-- (b) the existence of the rights not provided
#ASSERT `Art 13(2) the controller provides the data subject with the following further information necessary to ensure fair and transparent processing` TRUE FALSE FALSE (LIST `Art 13(2)(a) the period for which the personal data will be stored, or the criteria used to determine that period`, `Art 13(2)(d) the right to lodge a complaint with a supervisory authority`, `Art 13(2)(e) whether the provision of personal data is a statutory or contractual requirement, whether the data subject is obliged to provide the data and the possible consequences of failure`) EMPTY TRUE EQUALS JUST `the duty arises and is not met`
-- (d) the right to lodge a complaint not provided
#ASSERT `Art 13(2) the controller provides the data subject with the following further information necessary to ensure fair and transparent processing` TRUE FALSE FALSE (LIST `Art 13(2)(a) the period for which the personal data will be stored, or the criteria used to determine that period`, `Art 13(2)(b) the existence of the rights of access, rectification, erasure, restriction, objection and data portability`, `Art 13(2)(e) whether the provision of personal data is a statutory or contractual requirement, whether the data subject is obliged to provide the data and the possible consequences of failure`) EMPTY TRUE EQUALS JUST `the duty arises and is not met`
-- (e) statutory or contractual requirement not provided
#ASSERT `Art 13(2) the controller provides the data subject with the following further information necessary to ensure fair and transparent processing` TRUE FALSE FALSE (LIST `Art 13(2)(a) the period for which the personal data will be stored, or the criteria used to determine that period`, `Art 13(2)(b) the existence of the rights of access, rectification, erasure, restriction, objection and data portability`, `Art 13(2)(d) the right to lodge a complaint with a supervisory authority`) EMPTY TRUE EQUALS JUST `the duty arises and is not met`
-- (c) 'where the processing is based on point (a) of Article 6(1) or point (a) of Article 9(2)': it is, and the right to withdraw consent was not provided
#ASSERT `Art 13(2) the controller provides the data subject with the following further information necessary to ensure fair and transparent processing` TRUE TRUE FALSE (LIST `Art 13(2)(a) the period for which the personal data will be stored, or the criteria used to determine that period`, `Art 13(2)(b) the existence of the rights of access, rectification, erasure, restriction, objection and data portability`, `Art 13(2)(d) the right to lodge a complaint with a supervisory authority`, `Art 13(2)(e) whether the provision of personal data is a statutory or contractual requirement, whether the data subject is obliged to provide the data and the possible consequences of failure`) EMPTY TRUE EQUALS JUST `the duty arises and is not met`
-- (c) provided
#ASSERT `Art 13(2) the controller provides the data subject with the following further information necessary to ensure fair and transparent processing` TRUE TRUE FALSE (LIST `Art 13(2)(a) the period for which the personal data will be stored, or the criteria used to determine that period`, `Art 13(2)(b) the existence of the rights of access, rectification, erasure, restriction, objection and data portability`, `Art 13(2)(d) the right to lodge a complaint with a supervisory authority`, `Art 13(2)(e) whether the provision of personal data is a statutory or contractual requirement, whether the data subject is obliged to provide the data and the possible consequences of failure`, `Art 13(2)(c) the existence of the right to withdraw consent at any time, without affecting the lawfulness of processing before its withdrawal`) EMPTY TRUE EQUALS JUST `the duty arises and is met`
-- (f) there is automated decision-making referred to in Article 22(1) and (4), and its existence and logic were not provided
#ASSERT `Art 13(2) the controller provides the data subject with the following further information necessary to ensure fair and transparent processing` TRUE FALSE TRUE (LIST `Art 13(2)(a) the period for which the personal data will be stored, or the criteria used to determine that period`, `Art 13(2)(b) the existence of the rights of access, rectification, erasure, restriction, objection and data portability`, `Art 13(2)(d) the right to lodge a complaint with a supervisory authority`, `Art 13(2)(e) whether the provision of personal data is a statutory or contractual requirement, whether the data subject is obliged to provide the data and the possible consequences of failure`) EMPTY TRUE EQUALS JUST `the duty arises and is not met`
-- (f) provided
#ASSERT `Art 13(2) the controller provides the data subject with the following further information necessary to ensure fair and transparent processing` TRUE FALSE TRUE (LIST `Art 13(2)(a) the period for which the personal data will be stored, or the criteria used to determine that period`, `Art 13(2)(b) the existence of the rights of access, rectification, erasure, restriction, objection and data portability`, `Art 13(2)(d) the right to lodge a complaint with a supervisory authority`, `Art 13(2)(e) whether the provision of personal data is a statutory or contractual requirement, whether the data subject is obliged to provide the data and the possible consequences of failure`, `Art 13(2)(f) the existence of automated decision-making, including profiling, and meaningful information about the logic involved, the significance and the envisaged consequences`) EMPTY TRUE EQUALS JUST `the duty arises and is met`
-- items provided that do not apply are harmless
#ASSERT `Art 13(2) the controller provides the data subject with the following further information necessary to ensure fair and transparent processing` TRUE FALSE FALSE (LIST `Art 13(2)(a) the period for which the personal data will be stored, or the criteria used to determine that period`, `Art 13(2)(b) the existence of the rights of access, rectification, erasure, restriction, objection and data portability`, `Art 13(2)(d) the right to lodge a complaint with a supervisory authority`, `Art 13(2)(e) whether the provision of personal data is a statutory or contractual requirement, whether the data subject is obliged to provide the data and the possible consequences of failure`, `Art 13(2)(c) the existence of the right to withdraw consent at any time, without affecting the lawfulness of processing before its withdrawal`, `Art 13(2)(f) the existence of automated decision-making, including profiling, and meaningful information about the logic involved, the significance and the envisaged consequences`) EMPTY TRUE EQUALS JUST `the duty arises and is met`
-- (e) not provided but the data subject already has it (paragraph 4)
#ASSERT `Art 13(2) the controller provides the data subject with the following further information necessary to ensure fair and transparent processing` TRUE FALSE FALSE (LIST `Art 13(2)(a) the period for which the personal data will be stored, or the criteria used to determine that period`, `Art 13(2)(b) the existence of the rights of access, rectification, erasure, restriction, objection and data portability`, `Art 13(2)(d) the right to lodge a complaint with a supervisory authority`) (LIST `Art 13(2)(e) whether the provision of personal data is a statutory or contractual requirement, whether the data subject is obliged to provide the data and the possible consequences of failure`) TRUE EQUALS JUST `the duty arises and is met`
-- every point applies and every item is provided
#ASSERT `Art 13(2) the controller provides the data subject with the following further information necessary to ensure fair and transparent processing` TRUE TRUE TRUE (LIST `Art 13(2)(a) the period for which the personal data will be stored, or the criteria used to determine that period`, `Art 13(2)(b) the existence of the rights of access, rectification, erasure, restriction, objection and data portability`, `Art 13(2)(d) the right to lodge a complaint with a supervisory authority`, `Art 13(2)(e) whether the provision of personal data is a statutory or contractual requirement, whether the data subject is obliged to provide the data and the possible consequences of failure`, `Art 13(2)(c) the existence of the right to withdraw consent at any time, without affecting the lawfulness of processing before its withdrawal`, `Art 13(2)(f) the existence of automated decision-making, including profiling, and meaningful information about the logic involved, the significance and the envisaged consequences`) EMPTY TRUE EQUALS JUST `the duty arises and is met`
-- FULFILLED: provided at the time the data are obtained
#TRACE `Art 13(2) the controller must provide the data subject with the further information at the time when the personal data are obtained` TRUE AT 0 WITH
    PARTY controller DOES `Art 13(2) provide the data subject with the further information necessary to ensure fair and transparent processing` AT 0
-- BREACH: not provided at the time
#TRACE `Art 13(2) the controller must provide the data subject with the further information at the time when the personal data are obtained` TRUE AT 0 WITH
    (WAITUNTIL 1)
-- FULFILLED: the data are not collected from the data subject
#TRACE `Art 13(2) the controller must provide the data subject with the further information at the time when the personal data are obtained` FALSE AT 0 WITH
    (WAITUNTIL 1)

§ `Art 13(3): further processing for another purpose`

-- no further processing intended: 'Where' fails
#ASSERT `Art 13(3) the controller provides the data subject, prior to the further processing, with information on the other purpose and any relevant further information` FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST `the duty does not arise`
-- both kinds of information provided before the further processing
#ASSERT `Art 13(3) the controller provides the data subject, prior to the further processing, with information on the other purpose and any relevant further information` TRUE TRUE TRUE TRUE FALSE FALSE EQUALS JUST `the duty arises and is met`
-- provided, but not before the further processing: 'prior to that further processing'
#ASSERT `Art 13(3) the controller provides the data subject, prior to the further processing, with information on the other purpose and any relevant further information` TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST `the duty arises and is not met`
-- no information on the other purpose
#ASSERT `Art 13(3) the controller provides the data subject, prior to the further processing, with information on the other purpose and any relevant further information` TRUE FALSE TRUE TRUE FALSE FALSE EQUALS JUST `the duty arises and is not met`
-- no relevant further information
#ASSERT `Art 13(3) the controller provides the data subject, prior to the further processing, with information on the other purpose and any relevant further information` TRUE TRUE FALSE TRUE FALSE FALSE EQUALS JUST `the duty arises and is not met`
-- nothing provided, but the data subject already has both kinds of information (paragraph 4): the time is then immaterial
#ASSERT `Art 13(3) the controller provides the data subject, prior to the further processing, with information on the other purpose and any relevant further information` TRUE FALSE FALSE FALSE TRUE TRUE EQUALS JUST `the duty arises and is met`
-- the data subject already has the purpose information; the further information was provided before
#ASSERT `Art 13(3) the controller provides the data subject, prior to the further processing, with information on the other purpose and any relevant further information` TRUE FALSE TRUE TRUE TRUE FALSE EQUALS JUST `the duty arises and is met`
-- the further information was provided too late
#ASSERT `Art 13(3) the controller provides the data subject, prior to the further processing, with information on the other purpose and any relevant further information` TRUE FALSE TRUE FALSE TRUE FALSE EQUALS JUST `the duty arises and is not met`
-- FULFILLED: provided before the further processing is to begin (at instant 5)
#TRACE `Art 13(3) the controller must provide the data subject, prior to the further processing, with information on the other purpose and any relevant further information` TRUE 5 AT 0 WITH
    PARTY controller DOES `Art 13(3) provide the data subject, prior to the further processing, with information on the other purpose and any relevant further information` AT 4
-- FULFILLED: provided at the instant the further processing begins (inclusive deadline: marginal reading F13-2)
#TRACE `Art 13(3) the controller must provide the data subject, prior to the further processing, with information on the other purpose and any relevant further information` TRUE 5 AT 0 WITH
    PARTY controller DOES `Art 13(3) provide the data subject, prior to the further processing, with information on the other purpose and any relevant further information` AT 5
-- BREACH: provided after the further processing began
#TRACE `Art 13(3) the controller must provide the data subject, prior to the further processing, with information on the other purpose and any relevant further information` TRUE 5 AT 0 WITH
    PARTY controller DOES `Art 13(3) provide the data subject, prior to the further processing, with information on the other purpose and any relevant further information` AT 6
-- BREACH: nothing provided by the time the further processing begins
#TRACE `Art 13(3) the controller must provide the data subject, prior to the further processing, with information on the other purpose and any relevant further information` TRUE 5 AT 0 WITH
    (WAITUNTIL 6)
-- FULFILLED: no further processing intended
#TRACE `Art 13(3) the controller must provide the data subject, prior to the further processing, with information on the other purpose and any relevant further information` FALSE 5 AT 0 WITH
    (WAITUNTIL 6)

§ `Art 13(4): where and insofar as the data subject already has the information`

-- the data subject already has the information: the paragraphs 'shall not apply'
#ASSERT `Art 13(4) paragraphs 1, 2 and 3 do not apply where and insofar as the data subject already has the information` TRUE EQUALS JUST TRUE
-- the data subject does not have the information: the 'where' fails, so the paragraphs apply
#ASSERT `Art 13(4) paragraphs 1, 2 and 3 do not apply where and insofar as the data subject already has the information` FALSE EQUALS JUST FALSE

§ `Art 13(1): the information must be provided at the time when the data are obtained (R4)`

-- every item provided, but not at the time when the data were obtained: 'at the time when personal data are obtained, provide'
#ASSERT `Art 13(1) the controller provides the data subject with all of the following information` TRUE FALSE FALSE (JUST FALSE) FALSE FALSE (LIST `Art 13(1)(a) the identity and the contact details of the controller`, `Art 13(1)(c) the purposes of the processing for which the personal data are intended`, `Art 13(1)(c) the legal basis for the processing`) EMPTY FALSE EQUALS JUST `the duty arises and is not met`
-- every point applies and every item is provided, late
#ASSERT `Art 13(1) the controller provides the data subject with all of the following information` TRUE TRUE TRUE (JUST TRUE) TRUE TRUE (LIST `Art 13(1)(a) the identity and the contact details of the controller`, `Art 13(1)(c) the purposes of the processing for which the personal data are intended`, `Art 13(1)(c) the legal basis for the processing`, `Art 13(1)(a) the identity and the contact details of the controller's representative`, `Art 13(1)(b) the contact details of the data protection officer`, `Art 13(1)(d) the legitimate interests pursued by the controller or by a third party`, `Art 13(1)(e) the recipients or categories of recipients of the personal data`, `Art 13(1)(f) the intended transfer to a third country or international organisation and the adequacy decision or the safeguards`) EMPTY FALSE EQUALS JUST `the duty arises and is not met`
-- the controller provided nothing, because the data subject already has everything: nothing is late
#ASSERT `Art 13(1) the controller provides the data subject with all of the following information` TRUE FALSE FALSE (JUST FALSE) FALSE FALSE EMPTY (LIST `Art 13(1)(a) the identity and the contact details of the controller`, `Art 13(1)(c) the purposes of the processing for which the personal data are intended`, `Art 13(1)(c) the legal basis for the processing`) FALSE EQUALS JUST `the duty arises and is met`
-- the data subject already has the legal basis; the rest was provided late
#ASSERT `Art 13(1) the controller provides the data subject with all of the following information` TRUE FALSE FALSE (JUST FALSE) FALSE FALSE (LIST `Art 13(1)(a) the identity and the contact details of the controller`, `Art 13(1)(c) the purposes of the processing for which the personal data are intended`) (LIST `Art 13(1)(c) the legal basis for the processing`) FALSE EQUALS JUST `the duty arises and is not met`
-- late, and point (f) is not answered: the lateness is decided whatever (d) is
#ASSERT `Art 13(1) the controller provides the data subject with all of the following information` TRUE FALSE FALSE NOTHING FALSE FALSE (LIST `Art 13(1)(a) the identity and the contact details of the controller`, `Art 13(1)(c) the purposes of the processing for which the personal data are intended`, `Art 13(1)(c) the legal basis for the processing`) EMPTY FALSE EQUALS JUST `the duty arises and is not met`
-- data not collected from the data subject: the time does not matter
#ASSERT `Art 13(1) the controller provides the data subject with all of the following information` FALSE FALSE FALSE (JUST FALSE) FALSE FALSE EMPTY EMPTY FALSE EQUALS JUST `the duty does not arise`
-- an item missing and late: unmet
#ASSERT `Art 13(1) the controller provides the data subject with all of the following information` TRUE FALSE FALSE (JUST FALSE) FALSE FALSE (LIST `Art 13(1)(c) the purposes of the processing for which the personal data are intended`, `Art 13(1)(c) the legal basis for the processing`) EMPTY FALSE EQUALS JUST `the duty arises and is not met`

§ `Art 13(2): the further information must be provided at the time when the data are obtained (R4)`

-- every item provided, but not at the time when the data were obtained
#ASSERT `Art 13(2) the controller provides the data subject with the following further information necessary to ensure fair and transparent processing` TRUE FALSE FALSE (LIST `Art 13(2)(a) the period for which the personal data will be stored, or the criteria used to determine that period`, `Art 13(2)(b) the existence of the rights of access, rectification, erasure, restriction, objection and data portability`, `Art 13(2)(d) the right to lodge a complaint with a supervisory authority`, `Art 13(2)(e) whether the provision of personal data is a statutory or contractual requirement, whether the data subject is obliged to provide the data and the possible consequences of failure`) EMPTY FALSE EQUALS JUST `the duty arises and is not met`
-- the controller provided nothing, because the data subject already has everything: nothing is late
#ASSERT `Art 13(2) the controller provides the data subject with the following further information necessary to ensure fair and transparent processing` TRUE FALSE FALSE EMPTY (LIST `Art 13(2)(a) the period for which the personal data will be stored, or the criteria used to determine that period`, `Art 13(2)(b) the existence of the rights of access, rectification, erasure, restriction, objection and data portability`, `Art 13(2)(d) the right to lodge a complaint with a supervisory authority`, `Art 13(2)(e) whether the provision of personal data is a statutory or contractual requirement, whether the data subject is obliged to provide the data and the possible consequences of failure`) FALSE EQUALS JUST `the duty arises and is met`
-- data not collected from the data subject: outside the paragraph
#ASSERT `Art 13(2) the controller provides the data subject with the following further information necessary to ensure fair and transparent processing` FALSE FALSE FALSE EMPTY EMPTY FALSE EQUALS NOTHING

§ `Art 13(1): is this item owed? (one item at a time, R10)`

-- (a) the identity and contact details of the controller: owed in every case
#ASSERT `Art 13(1) the controller owes the data subject the item of information` TRUE `Art 13(1)(a) the identity and the contact details of the controller` FALSE FALSE (JUST FALSE) FALSE FALSE FALSE EQUALS JUST TRUE
-- (c) the purposes: owed in every case
#ASSERT `Art 13(1) the controller owes the data subject the item of information` TRUE `Art 13(1)(c) the purposes of the processing for which the personal data are intended` FALSE FALSE (JUST FALSE) FALSE FALSE FALSE EQUALS JUST TRUE
-- (c) the legal basis: owed in every case
#ASSERT `Art 13(1) the controller owes the data subject the item of information` TRUE `Art 13(1)(c) the legal basis for the processing` FALSE FALSE (JUST FALSE) FALSE FALSE FALSE EQUALS JUST TRUE
-- (a) the representative: 'where applicable', and the controller has none
#ASSERT `Art 13(1) the controller owes the data subject the item of information` TRUE `Art 13(1)(a) the identity and the contact details of the controller's representative` FALSE FALSE (JUST FALSE) FALSE FALSE FALSE EQUALS JUST FALSE
-- (a) the representative: the controller has one
#ASSERT `Art 13(1) the controller owes the data subject the item of information` TRUE `Art 13(1)(a) the identity and the contact details of the controller's representative` TRUE FALSE (JUST FALSE) FALSE FALSE FALSE EQUALS JUST TRUE
-- (b) the officer's contact details: 'where applicable', and none was designated
#ASSERT `Art 13(1) the controller owes the data subject the item of information` TRUE `Art 13(1)(b) the contact details of the data protection officer` FALSE FALSE (JUST FALSE) FALSE FALSE FALSE EQUALS JUST FALSE
-- (b) the officer's contact details: an officer was designated
#ASSERT `Art 13(1) the controller owes the data subject the item of information` TRUE `Art 13(1)(b) the contact details of the data protection officer` FALSE TRUE (JUST FALSE) FALSE FALSE FALSE EQUALS JUST TRUE
-- (d) 'where the processing is based on point (f) of Article 6(1)': it is
#ASSERT `Art 13(1) the controller owes the data subject the item of information` TRUE `Art 13(1)(d) the legitimate interests pursued by the controller or by a third party` FALSE FALSE (JUST TRUE) FALSE FALSE FALSE EQUALS JUST TRUE
-- (d) not owed: the processing is not based on point (f)
#ASSERT `Art 13(1) the controller owes the data subject the item of information` TRUE `Art 13(1)(d) the legitimate interests pursued by the controller or by a third party` FALSE FALSE (JUST FALSE) FALSE FALSE FALSE EQUALS JUST FALSE
-- (d): P1 does not answer whether the processing is based on point (f)
#ASSERT `Art 13(1) the controller owes the data subject the item of information` TRUE `Art 13(1)(d) the legitimate interests pursued by the controller or by a third party` FALSE FALSE NOTHING FALSE FALSE FALSE EQUALS NOTHING
-- (d), point (f) not answered, but the data subject already has it: paragraph 4 lifts the item whatever (f) says
#ASSERT `Art 13(1) the controller owes the data subject the item of information` TRUE `Art 13(1)(d) the legitimate interests pursued by the controller or by a third party` FALSE FALSE NOTHING FALSE FALSE TRUE EQUALS JUST FALSE
-- (e) 'if any': there are no recipients
#ASSERT `Art 13(1) the controller owes the data subject the item of information` TRUE `Art 13(1)(e) the recipients or categories of recipients of the personal data` FALSE FALSE (JUST FALSE) FALSE FALSE FALSE EQUALS JUST FALSE
-- (e) there are recipients
#ASSERT `Art 13(1) the controller owes the data subject the item of information` TRUE `Art 13(1)(e) the recipients or categories of recipients of the personal data` FALSE FALSE (JUST FALSE) TRUE FALSE FALSE EQUALS JUST TRUE
-- (f) 'where applicable': no transfer is intended
#ASSERT `Art 13(1) the controller owes the data subject the item of information` TRUE `Art 13(1)(f) the intended transfer to a third country or international organisation and the adequacy decision or the safeguards` FALSE FALSE (JUST FALSE) FALSE FALSE FALSE EQUALS JUST FALSE
-- (f) a transfer is intended
#ASSERT `Art 13(1) the controller owes the data subject the item of information` TRUE `Art 13(1)(f) the intended transfer to a third country or international organisation and the adequacy decision or the safeguards` FALSE FALSE (JUST FALSE) FALSE TRUE FALSE EQUALS JUST TRUE
-- the data are not collected from the data subject: 'Where personal data ... are collected from the data subject' fails
#ASSERT `Art 13(1) the controller owes the data subject the item of information` FALSE `Art 13(1)(a) the identity and the contact details of the controller` FALSE FALSE (JUST FALSE) FALSE FALSE FALSE EQUALS JUST FALSE
-- the data subject already has the legal basis: paragraph 4, 'where and insofar as'
#ASSERT `Art 13(1) the controller owes the data subject the item of information` TRUE `Art 13(1)(c) the legal basis for the processing` FALSE FALSE (JUST FALSE) FALSE FALSE TRUE EQUALS JUST FALSE

§ `Art 13(2): is this item owed? (one item at a time, R10)`

-- (a) the storage period: owed
#ASSERT `Art 13(2) the controller owes the data subject the item of further information` TRUE `Art 13(2)(a) the period for which the personal data will be stored, or the criteria used to determine that period` FALSE FALSE FALSE EQUALS JUST TRUE
-- (b) the rights: owed
#ASSERT `Art 13(2) the controller owes the data subject the item of further information` TRUE `Art 13(2)(b) the existence of the rights of access, rectification, erasure, restriction, objection and data portability` FALSE FALSE FALSE EQUALS JUST TRUE
-- (d) the complaint: owed
#ASSERT `Art 13(2) the controller owes the data subject the item of further information` TRUE `Art 13(2)(d) the right to lodge a complaint with a supervisory authority` FALSE FALSE FALSE EQUALS JUST TRUE
-- (e) the statutory or contractual requirement: owed
#ASSERT `Art 13(2) the controller owes the data subject the item of further information` TRUE `Art 13(2)(e) whether the provision of personal data is a statutory or contractual requirement, whether the data subject is obliged to provide the data and the possible consequences of failure` FALSE FALSE FALSE EQUALS JUST TRUE
-- (c) the right to withdraw consent: 'where the processing is based on point (a) of Article 6(1) or point (a) of Article 9(2)', and it is not
#ASSERT `Art 13(2) the controller owes the data subject the item of further information` TRUE `Art 13(2)(c) the existence of the right to withdraw consent at any time, without affecting the lawfulness of processing before its withdrawal` FALSE FALSE FALSE EQUALS JUST FALSE
-- (c) the processing is based on consent
#ASSERT `Art 13(2) the controller owes the data subject the item of further information` TRUE `Art 13(2)(c) the existence of the right to withdraw consent at any time, without affecting the lawfulness of processing before its withdrawal` TRUE FALSE FALSE EQUALS JUST TRUE
-- (f) no automated decision-making referred to in Article 22(1) and (4)
#ASSERT `Art 13(2) the controller owes the data subject the item of further information` TRUE `Art 13(2)(f) the existence of automated decision-making, including profiling, and meaningful information about the logic involved, the significance and the envisaged consequences` FALSE FALSE FALSE EQUALS JUST FALSE
-- (f) there is such decision-making
#ASSERT `Art 13(2) the controller owes the data subject the item of further information` TRUE `Art 13(2)(f) the existence of automated decision-making, including profiling, and meaningful information about the logic involved, the significance and the envisaged consequences` FALSE TRUE FALSE EQUALS JUST TRUE
-- data not collected from the data subject: outside the paragraph
#ASSERT `Art 13(2) the controller owes the data subject the item of further information` FALSE `Art 13(2)(a) the period for which the personal data will be stored, or the criteria used to determine that period` FALSE FALSE FALSE EQUALS NOTHING
-- the data subject already has the storage period: paragraph 4
#ASSERT `Art 13(2) the controller owes the data subject the item of further information` TRUE `Art 13(2)(a) the period for which the personal data will be stored, or the criteria used to determine that period` FALSE FALSE TRUE EQUALS JUST FALSE
-- consent basis, but the data subject already has the information
#ASSERT `Art 13(2) the controller owes the data subject the item of further information` TRUE `Art 13(2)(c) the existence of the right to withdraw consent at any time, without affecting the lawfulness of processing before its withdrawal` TRUE FALSE TRUE EQUALS JUST FALSE
