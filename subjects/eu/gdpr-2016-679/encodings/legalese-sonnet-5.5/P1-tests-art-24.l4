IMPORT prelude
IMPORT `gdpr-core`
IMPORT `P1-art-24`

-- ============================================================================
-- P1-tests-art-24.l4 -- tests of Art 24.  Expected values written from the text (src:310-312).
-- ============================================================================

§ `Art 24(1), first sentence`

#ASSERT `Art 24(1) the controller implements appropriate technical and organisational measures to ensure and to be able to demonstrate that processing is performed in accordance with this Regulation` (LIST `Art 24(1) the nature of the processing`, `Art 24(1) the scope of the processing`, `Art 24(1) the context of the processing`, `Art 24(1) the purposes of the processing`, `Art 24(1) the risks of varying likelihood and severity for the rights and freedoms of natural persons`) TRUE TRUE TRUE EQUALS JUST TRUE
-- one of the five matters not taken into account (the risks)
#ASSERT `Art 24(1) the controller implements appropriate technical and organisational measures to ensure and to be able to demonstrate that processing is performed in accordance with this Regulation` (LIST `Art 24(1) the nature of the processing`, `Art 24(1) the scope of the processing`, `Art 24(1) the context of the processing`, `Art 24(1) the purposes of the processing`) TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Art 24(1) the controller implements appropriate technical and organisational measures to ensure and to be able to demonstrate that processing is performed in accordance with this Regulation` EMPTY TRUE TRUE TRUE EQUALS JUST FALSE
-- the measures are not implemented, do not ensure, or do not allow demonstration
#ASSERT `Art 24(1) the controller implements appropriate technical and organisational measures to ensure and to be able to demonstrate that processing is performed in accordance with this Regulation` (LIST `Art 24(1) the nature of the processing`, `Art 24(1) the scope of the processing`, `Art 24(1) the context of the processing`, `Art 24(1) the purposes of the processing`, `Art 24(1) the risks of varying likelihood and severity for the rights and freedoms of natural persons`) FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Art 24(1) the controller implements appropriate technical and organisational measures to ensure and to be able to demonstrate that processing is performed in accordance with this Regulation` (LIST `Art 24(1) the nature of the processing`, `Art 24(1) the scope of the processing`, `Art 24(1) the context of the processing`, `Art 24(1) the purposes of the processing`, `Art 24(1) the risks of varying likelihood and severity for the rights and freedoms of natural persons`) TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Art 24(1) the controller implements appropriate technical and organisational measures to ensure and to be able to demonstrate that processing is performed in accordance with this Regulation` (LIST `Art 24(1) the nature of the processing`, `Art 24(1) the scope of the processing`, `Art 24(1) the context of the processing`, `Art 24(1) the purposes of the processing`, `Art 24(1) the risks of varying likelihood and severity for the rights and freedoms of natural persons`) TRUE TRUE FALSE EQUALS JUST FALSE

#TRACE `Art 24(1) the controller must implement appropriate technical and organisational measures` AT 0 WITH
    PARTY `controller` DOES `Art 24(1) implement appropriate technical and organisational measures` AT 20
-- expected: FULFILLED
#TRACE `Art 24(1) the controller must implement appropriate technical and organisational measures` AT 0 WITH
    (WAITUNTIL 1000)
-- expected: still standing, never a breach (no time limit and no consequence in the text)

§ `Art 24(1), second sentence`

#ASSERT `Art 24(1) the measures are reviewed and updated where necessary` TRUE TRUE EQUALS JUST `the duty arises and is met`
#ASSERT `Art 24(1) the measures are reviewed and updated where necessary` TRUE FALSE EQUALS JUST `the duty arises and is not met`
-- "where necessary": not necessary, so no duty (reviewed or not)
#ASSERT `Art 24(1) the measures are reviewed and updated where necessary` FALSE FALSE EQUALS JUST `the duty does not arise`
#ASSERT `Art 24(1) the measures are reviewed and updated where necessary` FALSE TRUE EQUALS JUST `the duty does not arise`

§ `Art 24(2)`

#ASSERT `Art 24(2) the measures include the implementation of appropriate data protection policies by the controller` TRUE TRUE EQUALS JUST `the duty arises and is met`
#ASSERT `Art 24(2) the measures include the implementation of appropriate data protection policies by the controller` TRUE FALSE EQUALS JUST `the duty arises and is not met`
-- "Where proportionate": it is not proportionate (a one-person business that keeps a customer list), so no duty
#ASSERT `Art 24(2) the measures include the implementation of appropriate data protection policies by the controller` FALSE FALSE EQUALS JUST `the duty does not arise`
#ASSERT `Art 24(2) the measures include the implementation of appropriate data protection policies by the controller` FALSE TRUE EQUALS JUST `the duty does not arise`

#TRACE `Art 24(2) the controller must implement appropriate data protection policies where proportionate` TRUE AT 0 WITH
    PARTY `controller` DOES `Art 24(2) implement appropriate data protection policies` AT 9
-- expected: FULFILLED
#TRACE `Art 24(2) the controller must implement appropriate data protection policies where proportionate` TRUE AT 0 WITH
    (WAITUNTIL 1000)
-- expected: still standing, never a breach
#TRACE `Art 24(2) the controller must implement appropriate data protection policies where proportionate` FALSE AT 0 WITH
    (WAITUNTIL 1000)
-- expected: FULFILLED (not proportionate: the duty does not arise)

§ `Art 24(3)`

#ASSERT `Art 24(3) adherence may be used as an element by which to demonstrate compliance with the obligations of the controller` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Art 24(3) adherence may be used as an element by which to demonstrate compliance with the obligations of the controller` FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 24(3) adherence may be used as an element by which to demonstrate compliance with the obligations of the controller` TRUE TRUE EQUALS JUST TRUE
-- not covered: adherence to neither (the text does not say that nothing else may be used)
#ASSERT `Art 24(3) adherence may be used as an element by which to demonstrate compliance with the obligations of the controller` FALSE FALSE EQUALS NOTHING
