IMPORT prelude
IMPORT `gdpr-core`
IMPORT `K2-art-2b`
IMPORT `K2-art-3`

-- ============================================================================
-- K2-tests-art-3.l4 -- tests of Art 3 (src:29-35) and of the combined answer `Art 3 this Regulation applies
-- to the processing of personal data`.  Expected values are written from the text.
-- ============================================================================

§ `Art 3(1): in the context of the activities of an establishment of a controller or a processor in the Union`

-- an establishment in the Union, processing in the Union
#ASSERT `Art 3(1) the territorial limb: the processing is in the context of the activities of an establishment of a controller or a processor in the Union` TRUE TRUE EQUALS JUST TRUE
-- an establishment in the Union, processing outside the Union: 'regardless of whether the processing takes place in the Union or not'
#ASSERT `Art 3(1) the territorial limb: the processing is in the context of the activities of an establishment of a controller or a processor in the Union` TRUE FALSE EQUALS JUST TRUE
-- no establishment in the Union, processing in the Union: Art 3(1) does not say
#ASSERT `Art 3(1) the territorial limb: the processing is in the context of the activities of an establishment of a controller or a processor in the Union` FALSE TRUE EQUALS NOTHING
-- neither
#ASSERT `Art 3(1) the territorial limb: the processing is in the context of the activities of an establishment of a controller or a processor in the Union` FALSE FALSE EQUALS NOTHING

§ `Art 3(2): data subjects in the Union, a controller or processor not established in the Union, offering or monitoring`

-- (a): goods or services offered free to data subjects in the Union
#ASSERT `Art 3(2) the territorial limb: the processing is of data subjects in the Union by a controller or processor not established in the Union, and the activities are related to offering goods or services or to monitoring behaviour` TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- (a): a payment is required: 'irrespective of whether a payment of the data subject is required'
#ASSERT `Art 3(2) the territorial limb: the processing is of data subjects in the Union by a controller or processor not established in the Union, and the activities are related to offering goods or services or to monitoring behaviour` TRUE TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- (b): behaviour monitored, and it takes place within the Union
#ASSERT `Art 3(2) the territorial limb: the processing is of data subjects in the Union by a controller or processor not established in the Union, and the activities are related to offering goods or services or to monitoring behaviour` TRUE TRUE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
-- (a) and (b) together
#ASSERT `Art 3(2) the territorial limb: the processing is of data subjects in the Union by a controller or processor not established in the Union, and the activities are related to offering goods or services or to monitoring behaviour` TRUE TRUE TRUE FALSE TRUE TRUE EQUALS JUST TRUE
-- (a) holds although the monitored behaviour is outside the Union
#ASSERT `Art 3(2) the territorial limb: the processing is of data subjects in the Union by a controller or processor not established in the Union, and the activities are related to offering goods or services or to monitoring behaviour` TRUE TRUE TRUE FALSE TRUE FALSE EQUALS JUST TRUE
-- monitoring only of behaviour that takes place outside the Union: 'as far as their behaviour takes place within the Union'; the 'where' gate fails (periods ruling (b), marginal reading FK3-1)
#ASSERT `Art 3(2) the territorial limb: the processing is of data subjects in the Union by a controller or processor not established in the Union, and the activities are related to offering goods or services or to monitoring behaviour` TRUE TRUE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
-- data subjects in the Union, a controller outside, but neither offering nor monitoring: the 'where' gate fails
#ASSERT `Art 3(2) the territorial limb: the processing is of data subjects in the Union by a controller or processor not established in the Union, and the activities are related to offering goods or services or to monitoring behaviour` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- the data subjects are not in the Union: outside 'data subjects who are in the Union'
#ASSERT `Art 3(2) the territorial limb: the processing is of data subjects in the Union by a controller or processor not established in the Union, and the activities are related to offering goods or services or to monitoring behaviour` FALSE TRUE TRUE FALSE TRUE TRUE EQUALS NOTHING
-- the controller is established in the Union: outside 'a controller or processor not established in the Union'
#ASSERT `Art 3(2) the territorial limb: the processing is of data subjects in the Union by a controller or processor not established in the Union, and the activities are related to offering goods or services or to monitoring behaviour` TRUE FALSE TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `Art 3(2) the territorial limb: the processing is of data subjects in the Union by a controller or processor not established in the Union, and the activities are related to offering goods or services or to monitoring behaviour` FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING

§ `Art 3(3): a controller not established in the Union, in a place where Member State law applies by virtue of public international law`

-- an embassy or a ship under a Member State's flag, the controller not established in the Union
#ASSERT `Art 3(3) the territorial limb: the processing is by a controller not established in the Union, in a place where Member State law applies by virtue of public international law` TRUE TRUE EQUALS JUST TRUE
-- not in such a place
#ASSERT `Art 3(3) the territorial limb: the processing is by a controller not established in the Union, in a place where Member State law applies by virtue of public international law` TRUE FALSE EQUALS NOTHING
-- the controller is established in the Union: outside 'a controller not established in the Union'
#ASSERT `Art 3(3) the territorial limb: the processing is by a controller not established in the Union, in a place where Member State law applies by virtue of public international law` FALSE TRUE EQUALS NOTHING
#ASSERT `Art 3(3) the territorial limb: the processing is by a controller not established in the Union, in a place where Member State law applies by virtue of public international law` FALSE FALSE EQUALS NOTHING

§ `Art 3 combined: this Regulation applies to the processing of personal data`

-- material scope met, Art 3(1): an establishment in the Union
#ASSERT `Art 3 this Regulation applies to the processing of personal data` (JUST TRUE) FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- material scope met, Art 3(1), processing outside the Union
#ASSERT `Art 3 this Regulation applies to the processing of personal data` (JUST TRUE) FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- material scope met, Art 3(2)(a)
#ASSERT `Art 3 this Regulation applies to the processing of personal data` (JUST TRUE) FALSE FALSE FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- material scope met, Art 3(2)(b)
#ASSERT `Art 3 this Regulation applies to the processing of personal data` (JUST TRUE) FALSE FALSE FALSE TRUE TRUE FALSE FALSE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- material scope met, Art 3(3)
#ASSERT `Art 3 this Regulation applies to the processing of personal data` (JUST TRUE) FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
-- material scope met, none of the three limbs: Art 3 says 'applies' three times and 'only' never
#ASSERT `Art 3 this Regulation applies to the processing of personal data` (JUST TRUE) FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- material scope met, Art 3(2)'s gate failed and no other limb: the combined answer does not turn a failed limb into a no
#ASSERT `Art 3 this Regulation applies to the processing of personal data` (JUST TRUE) FALSE FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- material scope met, monitoring of behaviour outside the Union only
#ASSERT `Art 3 this Regulation applies to the processing of personal data` (JUST TRUE) FALSE FALSE FALSE TRUE TRUE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS NOTHING
-- material scope met and an establishment in the Union, but the processing is by a Union body: Art 2(3) (reading A, FK2-1)
#ASSERT `Art 3 this Regulation applies to the processing of personal data` (JUST TRUE) TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- a household activity (Art 2(2)(c)) by someone with an establishment in the Union: Art 2(2) says the Regulation does not apply
#ASSERT `Art 3 this Regulation applies to the processing of personal data` (JUST FALSE) FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- outside the material scope and outside every limb
#ASSERT `Art 3 this Regulation applies to the processing of personal data` (JUST FALSE) FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- the material scope is not answered, a limb is met
#ASSERT `Art 3 this Regulation applies to the processing of personal data` NOTHING FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- the material scope is not answered, no limb is met
#ASSERT `Art 3 this Regulation applies to the processing of personal data` NOTHING FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- the material scope is not answered but the processing is by a Union body: Art 2(3) (FK2-1)
#ASSERT `Art 3 this Regulation applies to the processing of personal data` NOTHING TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- a Union body and outside the material scope
#ASSERT `Art 3 this Regulation applies to the processing of personal data` (JUST FALSE) TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
