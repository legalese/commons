IMPORT prelude
IMPORT `gdpr-core`
IMPORT `P1-art-6`
IMPORT `P1-art-9`

-- ============================================================================
-- P1-tests-art-9.l4 -- tests of Art 9.  Expected values written from the text (src:121-134).
-- JUST TRUE for a point = the point applies; JUST FALSE = it does not.  For `is prohibited`: JUST TRUE = the
-- prohibition stands, JUST FALSE = a point of paragraph 2 lifts it, NOTHING = not covered.
-- ============================================================================

§ `Art 9(1): which categories the text names`

#ASSERT `Art 9(1) the categories processed include one that paragraph 1 names` (LIST `Art 9(1) data revealing racial or ethnic origin`) EQUALS TRUE
#ASSERT `Art 9(1) the categories processed include one that paragraph 1 names` (LIST `Art 9(1) data revealing political opinions`) EQUALS TRUE
#ASSERT `Art 9(1) the categories processed include one that paragraph 1 names` (LIST `Art 9(1) data revealing religious or philosophical beliefs`) EQUALS TRUE
#ASSERT `Art 9(1) the categories processed include one that paragraph 1 names` (LIST `Art 9(1) data revealing trade union membership`) EQUALS TRUE
#ASSERT `Art 9(1) the categories processed include one that paragraph 1 names` (LIST `Art 9(1) genetic data`) EQUALS TRUE
#ASSERT `Art 9(1) the categories processed include one that paragraph 1 names` (LIST `Art 9(1) biometric data for the purpose of uniquely identifying a natural person`) EQUALS TRUE
#ASSERT `Art 9(1) the categories processed include one that paragraph 1 names` (LIST `Art 9(1) data concerning health`) EQUALS TRUE
#ASSERT `Art 9(1) the categories processed include one that paragraph 1 names` (LIST `Art 9(1) data concerning a natural person's sex life or sexual orientation`) EQUALS TRUE
-- just outside
#ASSERT `Art 9(1) the categories processed include one that paragraph 1 names` (LIST `Art 9(1) biometric data not for the purpose of uniquely identifying a natural person`) EQUALS FALSE
-- just outside
#ASSERT `Art 9(1) the categories processed include one that paragraph 1 names` (LIST `Art 9(1) other personal data`) EQUALS FALSE
#ASSERT `Art 9(1) the categories processed include one that paragraph 1 names` EMPTY EQUALS FALSE
-- one special category among others
#ASSERT `Art 9(1) the categories processed include one that paragraph 1 names` (LIST `Art 9(1) other personal data`, `Art 9(1) data concerning health`) EQUALS TRUE

§ `Art 9(2)(a): explicit consent`

#ASSERT `Art 9(2)(a) point (a) applies: the data subject has given explicit consent to the processing for one or more specified purposes` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Art 9(2)(a) point (a) applies: the data subject has given explicit consent to the processing for one or more specified purposes` FALSE TRUE FALSE EQUALS JUST FALSE
-- consent for no specified purpose
#ASSERT `Art 9(2)(a) point (a) applies: the data subject has given explicit consent to the processing for one or more specified purposes` TRUE FALSE FALSE EQUALS JUST FALSE
-- "except where": the law says the prohibition may not be lifted by the data subject
#ASSERT `Art 9(2)(a) point (a) applies: the data subject has given explicit consent to the processing for one or more specified purposes` TRUE TRUE TRUE EQUALS JUST FALSE

§ `Art 9(2)(b): employment and social security and social protection law`

#ASSERT `Art 9(2)(b) point (b) applies: the processing is necessary for employment and social security and social protection law` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 9(2)(b) point (b) applies: the processing is necessary for employment and social security and social protection law` FALSE TRUE TRUE EQUALS JUST FALSE
-- necessary but not authorised by law or a collective agreement
#ASSERT `Art 9(2)(b) point (b) applies: the processing is necessary for employment and social security and social protection law` TRUE FALSE TRUE EQUALS JUST FALSE
-- authorised but with no appropriate safeguards
#ASSERT `Art 9(2)(b) point (b) applies: the processing is necessary for employment and social security and social protection law` TRUE TRUE FALSE EQUALS JUST FALSE

§ `Art 9(2)(c): vital interests where the data subject cannot give consent`

#ASSERT `Art 9(2)(c) point (c) applies: the processing is necessary to protect vital interests where the data subject cannot give consent` TRUE `Art 6(1)(d) the data subject's` TRUE EQUALS JUST TRUE
#ASSERT `Art 9(2)(c) point (c) applies: the processing is necessary to protect vital interests where the data subject cannot give consent` TRUE `Art 6(1)(d) another natural person's` TRUE EQUALS JUST TRUE
-- just outside: not the vital interests of a natural person
#ASSERT `Art 9(2)(c) point (c) applies: the processing is necessary to protect vital interests where the data subject cannot give consent` TRUE `Art 6(1)(d) the interests of something that is not a natural person` TRUE EQUALS JUST FALSE
-- "where the data subject is physically or legally incapable": the data subject could give consent
#ASSERT `Art 9(2)(c) point (c) applies: the processing is necessary to protect vital interests where the data subject cannot give consent` TRUE `Art 6(1)(d) the data subject's` FALSE EQUALS JUST FALSE
#ASSERT `Art 9(2)(c) point (c) applies: the processing is necessary to protect vital interests where the data subject cannot give consent` FALSE `Art 6(1)(d) the data subject's` TRUE EQUALS JUST FALSE

§ `Art 9(2)(d): a not-for-profit body and its members`

#ASSERT `Art 9(2)(d) point (d) applies: a foundation, association or other not-for-profit body processes data of its members and those in regular contact with it` TRUE `Art 9(2)(d) a foundation` `Art 9(2)(d) a political aim` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Art 9(2)(d) point (d) applies: a foundation, association or other not-for-profit body processes data of its members and those in regular contact with it` TRUE `Art 9(2)(d) an association` `Art 9(2)(d) a political aim` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Art 9(2)(d) point (d) applies: a foundation, association or other not-for-profit body processes data of its members and those in regular contact with it` TRUE `Art 9(2)(d) another not-for-profit body` `Art 9(2)(d) a political aim` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Art 9(2)(d) point (d) applies: a foundation, association or other not-for-profit body processes data of its members and those in regular contact with it` TRUE `Art 9(2)(d) an association` `Art 9(2)(d) a political aim` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Art 9(2)(d) point (d) applies: a foundation, association or other not-for-profit body processes data of its members and those in regular contact with it` TRUE `Art 9(2)(d) an association` `Art 9(2)(d) a philosophical aim` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Art 9(2)(d) point (d) applies: a foundation, association or other not-for-profit body processes data of its members and those in regular contact with it` TRUE `Art 9(2)(d) an association` `Art 9(2)(d) a religious aim` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Art 9(2)(d) point (d) applies: a foundation, association or other not-for-profit body processes data of its members and those in regular contact with it` TRUE `Art 9(2)(d) an association` `Art 9(2)(d) a trade union aim` TRUE FALSE FALSE EQUALS JUST TRUE
-- disclosed outside the body, with the consent of the data subjects: allowed
#ASSERT `Art 9(2)(d) point (d) applies: a foundation, association or other not-for-profit body processes data of its members and those in regular contact with it` TRUE `Art 9(2)(d) an association` `Art 9(2)(d) a religious aim` TRUE TRUE TRUE EQUALS JUST TRUE
-- disclosed outside the body without consent
#ASSERT `Art 9(2)(d) point (d) applies: a foundation, association or other not-for-profit body processes data of its members and those in regular contact with it` TRUE `Art 9(2)(d) an association` `Art 9(2)(d) a religious aim` TRUE TRUE FALSE EQUALS JUST FALSE
-- just outside: a company, not a not-for-profit body
#ASSERT `Art 9(2)(d) point (d) applies: a foundation, association or other not-for-profit body processes data of its members and those in regular contact with it` TRUE `Art 9(2)(d) a body that is not a not-for-profit body` `Art 9(2)(d) a political aim` TRUE FALSE FALSE EQUALS JUST FALSE
-- just outside: a sports club (some other aim)
#ASSERT `Art 9(2)(d) point (d) applies: a foundation, association or other not-for-profit body processes data of its members and those in regular contact with it` TRUE `Art 9(2)(d) an association` `Art 9(2)(d) some other aim` TRUE FALSE FALSE EQUALS JUST FALSE
-- not solely members: it processes data of the public as well
#ASSERT `Art 9(2)(d) point (d) applies: a foundation, association or other not-for-profit body processes data of its members and those in regular contact with it` TRUE `Art 9(2)(d) an association` `Art 9(2)(d) a religious aim` FALSE FALSE FALSE EQUALS JUST FALSE
-- not in the course of its legitimate activities with appropriate safeguards
#ASSERT `Art 9(2)(d) point (d) applies: a foundation, association or other not-for-profit body processes data of its members and those in regular contact with it` FALSE `Art 9(2)(d) an association` `Art 9(2)(d) a religious aim` TRUE FALSE FALSE EQUALS JUST FALSE

§ `Art 9(2)(e): manifestly made public by the data subject`

#ASSERT `Art 9(2)(e) point (e) applies: the processing relates to personal data which are manifestly made public by the data subject` TRUE TRUE EQUALS JUST TRUE
-- made public, but not manifestly by the data subject (a friend posted it)
#ASSERT `Art 9(2)(e) point (e) applies: the processing relates to personal data which are manifestly made public by the data subject` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 9(2)(e) point (e) applies: the processing relates to personal data which are manifestly made public by the data subject` FALSE FALSE EQUALS JUST FALSE

§ `Art 9(2)(f): legal claims, or courts acting in their judicial capacity`

#ASSERT `Art 9(2)(f) point (f) applies: the processing is necessary for legal claims or whenever courts are acting in their judicial capacity` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Art 9(2)(f) point (f) applies: the processing is necessary for legal claims or whenever courts are acting in their judicial capacity` FALSE TRUE EQUALS JUST TRUE
#ASSERT `Art 9(2)(f) point (f) applies: the processing is necessary for legal claims or whenever courts are acting in their judicial capacity` FALSE FALSE EQUALS JUST FALSE

§ `Art 9(2)(g): substantial public interest`

#ASSERT `Art 9(2)(g) point (g) applies: the processing is necessary for reasons of substantial public interest on the basis of proportionate law` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 9(2)(g) point (g) applies: the processing is necessary for reasons of substantial public interest on the basis of proportionate law` FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Art 9(2)(g) point (g) applies: the processing is necessary for reasons of substantial public interest on the basis of proportionate law` TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Art 9(2)(g) point (g) applies: the processing is necessary for reasons of substantial public interest on the basis of proportionate law` TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Art 9(2)(g) point (g) applies: the processing is necessary for reasons of substantial public interest on the basis of proportionate law` TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Art 9(2)(g) point (g) applies: the processing is necessary for reasons of substantial public interest on the basis of proportionate law` TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE

§ `Art 9(2)(h): health and social care`

#ASSERT `Art 9(2)(h) point (h) applies: the processing is necessary for preventive or occupational medicine, health or social care or treatment, or the management of health or social care systems` `Art 9(2)(h) preventive medicine` TRUE `Art 9(2)(h) Union law` TRUE EQUALS JUST TRUE
#ASSERT `Art 9(2)(h) point (h) applies: the processing is necessary for preventive or occupational medicine, health or social care or treatment, or the management of health or social care systems` `Art 9(2)(h) occupational medicine` TRUE `Art 9(2)(h) Union law` TRUE EQUALS JUST TRUE
#ASSERT `Art 9(2)(h) point (h) applies: the processing is necessary for preventive or occupational medicine, health or social care or treatment, or the management of health or social care systems` `Art 9(2)(h) the assessment of the working capacity of the employee` TRUE `Art 9(2)(h) Union law` TRUE EQUALS JUST TRUE
#ASSERT `Art 9(2)(h) point (h) applies: the processing is necessary for preventive or occupational medicine, health or social care or treatment, or the management of health or social care systems` `Art 9(2)(h) medical diagnosis` TRUE `Art 9(2)(h) Union law` TRUE EQUALS JUST TRUE
#ASSERT `Art 9(2)(h) point (h) applies: the processing is necessary for preventive or occupational medicine, health or social care or treatment, or the management of health or social care systems` `Art 9(2)(h) the provision of health or social care or treatment` TRUE `Art 9(2)(h) Union law` TRUE EQUALS JUST TRUE
#ASSERT `Art 9(2)(h) point (h) applies: the processing is necessary for preventive or occupational medicine, health or social care or treatment, or the management of health or social care systems` `Art 9(2)(h) the management of health or social care systems and services` TRUE `Art 9(2)(h) Union law` TRUE EQUALS JUST TRUE
#ASSERT `Art 9(2)(h) point (h) applies: the processing is necessary for preventive or occupational medicine, health or social care or treatment, or the management of health or social care systems` `Art 9(2)(h) medical diagnosis` TRUE `Art 9(2)(h) Union law` TRUE EQUALS JUST TRUE
#ASSERT `Art 9(2)(h) point (h) applies: the processing is necessary for preventive or occupational medicine, health or social care or treatment, or the management of health or social care systems` `Art 9(2)(h) medical diagnosis` TRUE `Art 9(2)(h) Member State law` TRUE EQUALS JUST TRUE
#ASSERT `Art 9(2)(h) point (h) applies: the processing is necessary for preventive or occupational medicine, health or social care or treatment, or the management of health or social care systems` `Art 9(2)(h) medical diagnosis` TRUE `Art 9(2)(h) a contract with a health professional` TRUE EQUALS JUST TRUE
-- just outside: some other purpose (marketing to patients)
#ASSERT `Art 9(2)(h) point (h) applies: the processing is necessary for preventive or occupational medicine, health or social care or treatment, or the management of health or social care systems` `Art 9(2)(h) some other purpose` TRUE `Art 9(2)(h) Union law` TRUE EQUALS JUST FALSE
#ASSERT `Art 9(2)(h) point (h) applies: the processing is necessary for preventive or occupational medicine, health or social care or treatment, or the management of health or social care systems` `Art 9(2)(h) medical diagnosis` FALSE `Art 9(2)(h) Union law` TRUE EQUALS JUST FALSE
#ASSERT `Art 9(2)(h) point (h) applies: the processing is necessary for preventive or occupational medicine, health or social care or treatment, or the management of health or social care systems` `Art 9(2)(h) medical diagnosis` TRUE `Art 9(2)(h) none of these` TRUE EQUALS JUST FALSE
#ASSERT `Art 9(2)(h) point (h) applies: the processing is necessary for preventive or occupational medicine, health or social care or treatment, or the management of health or social care systems` `Art 9(2)(h) medical diagnosis` TRUE `Art 9(2)(h) Union law` FALSE EQUALS JUST FALSE

§ `Art 9(2)(i): public health`

#ASSERT `Art 9(2)(i) point (i) applies: the processing is necessary for reasons of public interest in the area of public health on the basis of law with suitable measures` `Art 9(2)(i) protecting against serious cross-border threats to health` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 9(2)(i) point (i) applies: the processing is necessary for reasons of public interest in the area of public health on the basis of law with suitable measures` `Art 9(2)(i) ensuring high standards of quality and safety of health care and of medicinal products or medical devices` TRUE TRUE TRUE EQUALS JUST TRUE
-- "such as": any other reason of public interest in the area of public health
#ASSERT `Art 9(2)(i) point (i) applies: the processing is necessary for reasons of public interest in the area of public health on the basis of law with suitable measures` `Art 9(2)(i) another reason of public interest in the area of public health` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 9(2)(i) point (i) applies: the processing is necessary for reasons of public interest in the area of public health on the basis of law with suitable measures` `Art 9(2)(i) no reason of public interest in the area of public health` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Art 9(2)(i) point (i) applies: the processing is necessary for reasons of public interest in the area of public health on the basis of law with suitable measures` `Art 9(2)(i) protecting against serious cross-border threats to health` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Art 9(2)(i) point (i) applies: the processing is necessary for reasons of public interest in the area of public health on the basis of law with suitable measures` `Art 9(2)(i) protecting against serious cross-border threats to health` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Art 9(2)(i) point (i) applies: the processing is necessary for reasons of public interest in the area of public health on the basis of law with suitable measures` `Art 9(2)(i) protecting against serious cross-border threats to health` TRUE TRUE FALSE EQUALS JUST FALSE

§ `Art 9(2)(j): archiving, research and statistics`

#ASSERT `Art 9(2)(j) point (j) applies: the processing is necessary for archiving, research or statistical purposes in accordance with Article 89(1)` `Art 5(1)(b) archiving purposes in the public interest` TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 9(2)(j) point (j) applies: the processing is necessary for archiving, research or statistical purposes in accordance with Article 89(1)` `Art 5(1)(b) scientific research purposes` TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 9(2)(j) point (j) applies: the processing is necessary for archiving, research or statistical purposes in accordance with Article 89(1)` `Art 5(1)(b) historical research purposes` TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 9(2)(j) point (j) applies: the processing is necessary for archiving, research or statistical purposes in accordance with Article 89(1)` `Art 5(1)(b) statistical purposes` TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 9(2)(j) point (j) applies: the processing is necessary for archiving, research or statistical purposes in accordance with Article 89(1)` `Art 5(1)(b) some other purpose` TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Art 9(2)(j) point (j) applies: the processing is necessary for archiving, research or statistical purposes in accordance with Article 89(1)` `Art 5(1)(b) statistical purposes` FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Art 9(2)(j) point (j) applies: the processing is necessary for archiving, research or statistical purposes in accordance with Article 89(1)` `Art 5(1)(b) statistical purposes` TRUE FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Art 9(2)(j) point (j) applies: the processing is necessary for archiving, research or statistical purposes in accordance with Article 89(1)` `Art 5(1)(b) statistical purposes` TRUE TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Art 9(2)(j) point (j) applies: the processing is necessary for archiving, research or statistical purposes in accordance with Article 89(1)` `Art 5(1)(b) statistical purposes` TRUE TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Art 9(2)(j) point (j) applies: the processing is necessary for archiving, research or statistical purposes in accordance with Article 89(1)` `Art 5(1)(b) statistical purposes` TRUE TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Art 9(2)(j) point (j) applies: the processing is necessary for archiving, research or statistical purposes in accordance with Article 89(1)` `Art 5(1)(b) statistical purposes` TRUE TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE

§ `Art 9(2): one of points (a) to (j)`

#ASSERT `Art 9(2) one of points (a) to (j) applies` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `Art 9(2) one of points (a) to (j) applies` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `Art 9(2) one of points (a) to (j) applies` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST FALSE) NOTHING (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `Art 9(2) one of points (a) to (j) applies` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
-- not covered: none applies but one answer is not covered
#ASSERT `Art 9(2) one of points (a) to (j) applies` (JUST FALSE) (JUST FALSE) NOTHING (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS NOTHING

§ `Art 9(1) and (2): is the processing prohibited`

#ASSERT `Art 9(1) the processing of personal data of a category named in paragraph 1 is prohibited` (LIST `Art 9(1) data revealing racial or ethnic origin`) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `Art 9(1) the processing of personal data of a category named in paragraph 1 is prohibited` (LIST `Art 9(1) data revealing political opinions`) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `Art 9(1) the processing of personal data of a category named in paragraph 1 is prohibited` (LIST `Art 9(1) data revealing religious or philosophical beliefs`) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `Art 9(1) the processing of personal data of a category named in paragraph 1 is prohibited` (LIST `Art 9(1) data revealing trade union membership`) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `Art 9(1) the processing of personal data of a category named in paragraph 1 is prohibited` (LIST `Art 9(1) genetic data`) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `Art 9(1) the processing of personal data of a category named in paragraph 1 is prohibited` (LIST `Art 9(1) biometric data for the purpose of uniquely identifying a natural person`) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `Art 9(1) the processing of personal data of a category named in paragraph 1 is prohibited` (LIST `Art 9(1) data concerning health`) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `Art 9(1) the processing of personal data of a category named in paragraph 1 is prohibited` (LIST `Art 9(1) data concerning a natural person's sex life or sexual orientation`) (JUST FALSE) EQUALS JUST TRUE
-- a point of paragraph 2 applies: paragraph 1 does not
#ASSERT `Art 9(1) the processing of personal data of a category named in paragraph 1 is prohibited` (LIST `Art 9(1) data concerning health`) (JUST TRUE) EQUALS JUST FALSE
-- not covered: whether any point applies
#ASSERT `Art 9(1) the processing of personal data of a category named in paragraph 1 is prohibited` (LIST `Art 9(1) data concerning health`) NOTHING EQUALS NOTHING
-- not covered: other data, and biometric data not used to identify, whatever paragraph 2 says
#ASSERT `Art 9(1) the processing of personal data of a category named in paragraph 1 is prohibited` (LIST `Art 9(1) other personal data`) (JUST FALSE) EQUALS NOTHING
#ASSERT `Art 9(1) the processing of personal data of a category named in paragraph 1 is prohibited` (LIST `Art 9(1) biometric data not for the purpose of uniquely identifying a natural person`) (JUST FALSE) EQUALS NOTHING
#ASSERT `Art 9(1) the processing of personal data of a category named in paragraph 1 is prohibited` (LIST `Art 9(1) other personal data`) (JUST TRUE) EQUALS NOTHING
#ASSERT `Art 9(1) the processing of personal data of a category named in paragraph 1 is prohibited` EMPTY (JUST FALSE) EQUALS NOTHING
-- one special category among others
#ASSERT `Art 9(1) the processing of personal data of a category named in paragraph 1 is prohibited` (LIST `Art 9(1) other personal data`, `Art 9(1) genetic data`) (JUST FALSE) EQUALS JUST TRUE
-- end to end: health data, the data subject gave explicit consent for a specified purpose: point (a) applies, the prohibition does not
#ASSERT `Art 9(1) the processing of personal data of a category named in paragraph 1 is prohibited` (LIST `Art 9(1) data concerning health`) (`Art 9(2) one of points (a) to (j) applies` (`Art 9(2)(a) point (a) applies: the data subject has given explicit consent to the processing for one or more specified purposes` TRUE TRUE FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE)) EQUALS JUST FALSE
-- end to end: health data and consent that was not explicit enough: no point applies, the prohibition stands
#ASSERT `Art 9(1) the processing of personal data of a category named in paragraph 1 is prohibited` (LIST `Art 9(1) data concerning health`) (`Art 9(2) one of points (a) to (j) applies` (`Art 9(2)(a) point (a) applies: the data subject has given explicit consent to the processing for one or more specified purposes` FALSE TRUE FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE)) EQUALS JUST TRUE

-- the regulative form: the prohibition applies; the controller processes: breach
#TRACE `Art 9(1) the controller shall not process personal data of a category named in paragraph 1` TRUE AT 0 WITH
    PARTY `controller` DOES `Art 9(1) process personal data of a category named in paragraph 1` AT 5
-- expected: DEONTIC BREACHED, by the controller
#TRACE `Art 9(1) the controller shall not process personal data of a category named in paragraph 1` TRUE AT 0 WITH
    (WAITUNTIL 1000)
-- expected: the prohibition still standing and unbroken
#TRACE `Art 9(1) the controller shall not process personal data of a category named in paragraph 1` FALSE AT 0 WITH
    PARTY `controller` DOES `Art 9(1) process personal data of a category named in paragraph 1` AT 5
-- expected: FULFILLED (a point of paragraph 2 applies)

