IMPORT prelude
IMPORT `gdpr-core`
IMPORT `gdpr-definitions`
IMPORT `P1-art-2`

-- ============================================================================
-- P1-tests-art-2.l4 -- tests of Art 2(1) and (2).  Expected values are written from the text
-- (src:21-26) before running.  JUST TRUE = applies; JUST FALSE = the text's flat "does not apply";
-- NOTHING = not covered.
-- ============================================================================

§ `Art 2(1)`

-- first limb: wholly automated; partly automated (a person types and a program stores)
#ASSERT `Art 2(1) this Regulation applies to the processing of personal data` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- the first limb does not ask for a filing system
#ASSERT `Art 2(1) this Regulation applies to the processing of personal data` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- second limb: by hand, the data form part of a filing system
#ASSERT `Art 2(1) this Regulation applies to the processing of personal data` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
-- second limb: by hand, the data are intended to form part of a filing system
#ASSERT `Art 2(1) this Regulation applies to the processing of personal data` TRUE FALSE FALSE TRUE EQUALS JUST TRUE
-- outside: by hand, in no filing system and not intended to be (loose notes)
#ASSERT `Art 2(1) this Regulation applies to the processing of personal data` TRUE FALSE FALSE FALSE EQUALS NOTHING
-- outside: not processing of personal data at all
#ASSERT `Art 2(1) this Regulation applies to the processing of personal data` FALSE TRUE TRUE TRUE EQUALS NOTHING
-- through Art 4: storing a customer list by program is processing of personal data, so Art 2(1) applies
#ASSERT `Art 2(1) this Regulation applies to the processing of personal data` (`Art 4(2) the operations are processing` (LIST `Art 4(2) storage`) TRUE FALSE TRUE EQUALS JUST TRUE) TRUE FALSE FALSE EQUALS JUST TRUE
-- through Art 4: storing a weather dataset is not processing of personal data, so Art 2(1) says nothing
#ASSERT `Art 2(1) this Regulation applies to the processing of personal data` (`Art 4(2) the operations are processing` (LIST `Art 4(2) storage`) FALSE FALSE TRUE EQUALS JUST TRUE) TRUE FALSE FALSE EQUALS NOTHING

§ `Art 2(2)(a)`

#ASSERT `Art 2(2)(a) this Regulation applies to processing in the course of an activity outside the scope of Union law` TRUE EQUALS JUST FALSE
#ASSERT `Art 2(2)(a) this Regulation applies to processing in the course of an activity outside the scope of Union law` FALSE EQUALS NOTHING

§ `Art 2(2)(b)`

#ASSERT `Art 2(2)(b) this Regulation applies to processing by the Member States in activities within Chapter 2 of Title V of the TEU` TRUE TRUE EQUALS JUST FALSE
-- outside: a Member State, but in an activity outside Chapter 2 of Title V of the TEU (tax administration)
#ASSERT `Art 2(2)(b) this Regulation applies to processing by the Member States in activities within Chapter 2 of Title V of the TEU` TRUE FALSE EQUALS NOTHING
-- outside: an activity within Chapter 2 of Title V of the TEU carried out by someone who is not a Member State
#ASSERT `Art 2(2)(b) this Regulation applies to processing by the Member States in activities within Chapter 2 of Title V of the TEU` FALSE TRUE EQUALS NOTHING
#ASSERT `Art 2(2)(b) this Regulation applies to processing by the Member States in activities within Chapter 2 of Title V of the TEU` FALSE FALSE EQUALS NOTHING

§ `Art 2(2)(c)`

#ASSERT `Art 2(2)(c) this Regulation applies to processing by a natural person in the course of a purely personal or household activity` TRUE TRUE EQUALS JUST FALSE
-- outside: a natural person acting for business (a sole trader's customer list)
#ASSERT `Art 2(2)(c) this Regulation applies to processing by a natural person in the course of a purely personal or household activity` TRUE FALSE EQUALS NOTHING
-- outside: a company keeping a personal address book
#ASSERT `Art 2(2)(c) this Regulation applies to processing by a natural person in the course of a purely personal or household activity` FALSE TRUE EQUALS NOTHING
#ASSERT `Art 2(2)(c) this Regulation applies to processing by a natural person in the course of a purely personal or household activity` FALSE FALSE EQUALS NOTHING

§ `Art 2(2)(d): each purpose the text names, and one just outside`

#ASSERT `Art 2(2)(d) this Regulation applies to processing by competent authorities for the purposes of criminal justice and public security` TRUE `Art 2(2)(d) prevention of criminal offences` EQUALS JUST FALSE
#ASSERT `Art 2(2)(d) this Regulation applies to processing by competent authorities for the purposes of criminal justice and public security` TRUE `Art 2(2)(d) investigation of criminal offences` EQUALS JUST FALSE
#ASSERT `Art 2(2)(d) this Regulation applies to processing by competent authorities for the purposes of criminal justice and public security` TRUE `Art 2(2)(d) detection of criminal offences` EQUALS JUST FALSE
#ASSERT `Art 2(2)(d) this Regulation applies to processing by competent authorities for the purposes of criminal justice and public security` TRUE `Art 2(2)(d) prosecution of criminal offences` EQUALS JUST FALSE
#ASSERT `Art 2(2)(d) this Regulation applies to processing by competent authorities for the purposes of criminal justice and public security` TRUE `Art 2(2)(d) execution of criminal penalties` EQUALS JUST FALSE
#ASSERT `Art 2(2)(d) this Regulation applies to processing by competent authorities for the purposes of criminal justice and public security` TRUE `Art 2(2)(d) safeguarding against threats to public security` EQUALS JUST FALSE
#ASSERT `Art 2(2)(d) this Regulation applies to processing by competent authorities for the purposes of criminal justice and public security` TRUE `Art 2(2)(d) prevention of threats to public security` EQUALS JUST FALSE
-- outside: a competent authority processing for another purpose (paying its staff)
#ASSERT `Art 2(2)(d) this Regulation applies to processing by competent authorities for the purposes of criminal justice and public security` TRUE `Art 2(2)(d) another purpose` EQUALS NOTHING
-- outside: a body that is not a competent authority, for a named purpose (a private security firm)
#ASSERT `Art 2(2)(d) this Regulation applies to processing by competent authorities for the purposes of criminal justice and public security` FALSE `Art 2(2)(d) prevention of criminal offences` EQUALS NOTHING

§ `Art 2(2) together`

#ASSERT `Art 2(2) this Regulation applies to the processing of personal data, given points (a) to (d)` (JUST FALSE) NOTHING NOTHING NOTHING EQUALS JUST FALSE
#ASSERT `Art 2(2) this Regulation applies to the processing of personal data, given points (a) to (d)` NOTHING (JUST FALSE) NOTHING NOTHING EQUALS JUST FALSE
#ASSERT `Art 2(2) this Regulation applies to the processing of personal data, given points (a) to (d)` NOTHING NOTHING (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `Art 2(2) this Regulation applies to the processing of personal data, given points (a) to (d)` NOTHING NOTHING NOTHING (JUST FALSE) EQUALS JUST FALSE
#ASSERT `Art 2(2) this Regulation applies to the processing of personal data, given points (a) to (d)` NOTHING NOTHING NOTHING NOTHING EQUALS NOTHING

§ `Art 2(1) and (2) together: the material scope`

-- Art 2(1) applies and no exception: within the scope.
#ASSERT `Art 2(1) and (2) the processing is within the material scope of this Regulation` (JUST TRUE) NOTHING EQUALS JUST TRUE
-- Art 2(1) applies but an exception of Art 2(2) holds: not within the scope ("This Regulation does not apply").
#ASSERT `Art 2(1) and (2) the processing is within the material scope of this Regulation` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
-- An exception holds although Art 2(1) says nothing: still not within the scope.
#ASSERT `Art 2(1) and (2) the processing is within the material scope of this Regulation` NOTHING (JUST FALSE) EQUALS JUST FALSE
-- Neither speaks: not covered.
#ASSERT `Art 2(1) and (2) the processing is within the material scope of this Regulation` NOTHING NOTHING EQUALS NOTHING

-- A household example end to end: a person keeps her family's addresses in a spreadsheet (automated, personal data).
-- Art 2(1) says the Regulation applies; Art 2(2)(c) says it does not apply to a purely personal or household activity.
#ASSERT `Art 2(1) and (2) the processing is within the material scope of this Regulation` (`Art 2(1) this Regulation applies to the processing of personal data` TRUE TRUE FALSE FALSE) (`Art 2(2) this Regulation applies to the processing of personal data, given points (a) to (d)` NOTHING NOTHING (`Art 2(2)(c) this Regulation applies to processing by a natural person in the course of a purely personal or household activity` TRUE TRUE) NOTHING) EQUALS JUST FALSE
-- The same spreadsheet kept by a shop: no exception, so within the scope.
#ASSERT `Art 2(1) and (2) the processing is within the material scope of this Regulation` (`Art 2(1) this Regulation applies to the processing of personal data` TRUE TRUE FALSE FALSE) (`Art 2(2) this Regulation applies to the processing of personal data, given points (a) to (d)` NOTHING NOTHING (`Art 2(2)(c) this Regulation applies to processing by a natural person in the course of a purely personal or household activity` FALSE FALSE) NOTHING) EQUALS JUST TRUE
