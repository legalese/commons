#ASSERT `Under Article 10, as a data subject, is a comprehensive register of criminal convictions kept only under the control of official authority` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Under Article 10, as a data subject, is a comprehensive register of criminal convictions kept only under the control of official authority` FALSE FALSE EQUALS NOTHING

§ `Article 11 -- processing which does not require identification`

-- MIRROR 11_1
#ASSERT `Under Article 11(1), as a data subject, is the controller obliged to maintain, acquire or process additional information to identify me` TRUE TRUE EQUALS JUST FALSE
#ASSERT `Under Article 11(1), as a data subject, is the controller obliged to maintain, acquire or process additional information to identify me` FALSE TRUE EQUALS NOTHING
-- MIRROR 11_2a
#ASSERT `Under Article 11(2), as a data subject, must the controller inform me that it is not in a position to identify me, and has it` TRUE TRUE TRUE TRUE EQUALS JUST `the duty arises and is met`
#ASSERT `Under Article 11(2), as a data subject, must the controller inform me that it is not in a position to identify me, and has it` TRUE TRUE TRUE FALSE EQUALS JUST `the duty arises and is not met`
#ASSERT `Under Article 11(2), as a data subject, must the controller inform me that it is not in a position to identify me, and has it` TRUE TRUE FALSE FALSE EQUALS JUST `the duty does not arise`
-- MIRROR 11_2b
#ASSERT `Under Article 11(2), as a data subject, are Articles 15 to 20 disapplied for my request` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under Article 11(2), as a data subject, are Articles 15 to 20 disapplied for my request` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Under Article 11(2), as a data subject, are Articles 15 to 20 disapplied for my request` FALSE TRUE FALSE EQUALS NOTHING
