-- MIRROR 10a
#ASSERT `Under Article 10, as a data subject, does the processing of data about my criminal convictions meet the condition of Article 10` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under Article 10, as a data subject, does the processing of data about my criminal convictions meet the condition of Article 10` TRUE TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under Article 10, as a data subject, does the processing of data about my criminal convictions meet the condition of Article 10` TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Under Article 10, as a data subject, does the processing of data about my criminal convictions meet the condition of Article 10` FALSE TRUE FALSE FALSE FALSE EQUALS NOTHING
