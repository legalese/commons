-- ============================================================================
-- P1-cases-seat-subject.l4 -- cases for the seat of a data subject.  Expected values are written from the text (the layer-1 tests
-- in P1-tests-art-N.l4 hold the full set of branches); each case here is a person's facts and the answer the Regulation gives.
-- Cases marked -- MIRROR are asked from the other seat with the same facts, and the answers agree (P1-cases-mirror.l4 asserts it).
-- ============================================================================


§ `Article 2 -- does the Regulation reach the processing?`

-- MIRROR 2
#ASSERT `Under Article 2(1) and (2), as a data subject, is the processing of my personal data within the material scope of this Regulation` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `Art 2(2)(d) another purpose` EQUALS JUST TRUE
#ASSERT `Under Article 2(1) and (2), as a data subject, is the processing of my personal data within the material scope of this Regulation` TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE TRUE FALSE `Art 2(2)(d) another purpose` EQUALS JUST FALSE
#ASSERT `Under Article 2(1) and (2), as a data subject, is the processing of my personal data within the material scope of this Regulation` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE `Art 2(2)(d) detection of criminal offences` EQUALS JUST FALSE
#ASSERT `Under Article 2(1) and (2), as a data subject, is the processing of my personal data within the material scope of this Regulation` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `Art 2(2)(d) another purpose` EQUALS NOTHING

§ `Article 4 -- who and what the definitions pick out`

#ASSERT `Under Article 4(1), as a data subject, is the information about me personal data` TRUE TRUE FALSE `Art 4(1) a name` EQUALS JUST TRUE
#ASSERT `Under Article 4(1), as a data subject, is the information about me personal data` TRUE FALSE TRUE `Art 4(1) an online identifier` EQUALS JUST TRUE
#ASSERT `Under Article 4(1), as a data subject, is the information about me personal data` TRUE FALSE FALSE `Art 4(1) a name` EQUALS JUST FALSE
#ASSERT `Under Article 4(1), as a data subject, is the information about me personal data` FALSE TRUE TRUE `Art 4(1) a name` EQUALS JUST FALSE
#ASSERT `Under Article 4(1), as a data subject, am I a data subject in relation to this information` TRUE TRUE TRUE FALSE `Art 4(1) a name` EQUALS JUST TRUE
#ASSERT `Under Article 4(1), as a data subject, am I a data subject in relation to this information` TRUE TRUE FALSE FALSE `Art 4(1) a name` EQUALS JUST FALSE
#ASSERT `Under Article 4(1), as a data subject, am I a data subject in relation to this information` FALSE TRUE TRUE FALSE `Art 4(1) a name` EQUALS JUST FALSE
#ASSERT `Under Article 4(1), as a data subject, am I a data subject in relation to this information` TRUE FALSE TRUE FALSE `Art 4(1) a name` EQUALS JUST FALSE
#ASSERT `Under Article 4(2), as a data subject, is what was done with my personal data processing` `Art 4(2) storage` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under Article 4(2), as a data subject, is what was done with my personal data processing` `Art 4(2) erasure` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under Article 4(2), as a data subject, is what was done with my personal data processing` `Art 4(2) storage` FALSE TRUE EQUALS JUST FALSE
-- MIRROR 4_7
#ASSERT `Under Article 4(7), as a data subject, is a body that decides why and how my personal data are processed a controller` `legal person` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under Article 4(7), as a data subject, is a body that decides why and how my personal data are processed a controller` `public authority` FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under Article 4(7), as a data subject, is a body that decides why and how my personal data are processed a controller` `not a person or body` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Under Article 4(7), as a data subject, is a body that decides why and how my personal data are processed a controller` `legal person` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Under Article 4(7), as a data subject, is a controller that decides why and how my personal data are processed deciding alone or jointly with others` TRUE TRUE FALSE EQUALS JUST `Art 4(7) alone`
#ASSERT `Under Article 4(7), as a data subject, is a controller that decides why and how my personal data are processed deciding alone or jointly with others` TRUE TRUE TRUE EQUALS JUST `Art 4(7) jointly with others`
#ASSERT `Under Article 4(7), as a data subject, is a controller that decides why and how my personal data are processed deciding alone or jointly with others` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `Under Article 4(8), as a data subject, is the body that processes my personal data on behalf of another a processor` `legal person` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under Article 4(8), as a data subject, is the body that processes my personal data on behalf of another a processor` `legal person` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Under Article 4(8), as a data subject, is the body that processes my personal data on behalf of another a processor` `not a person or body` TRUE TRUE EQUALS JUST FALSE

§ `Article 5 -- the principles the processing must meet`

#ASSERT `Under Article 5(1)(a), as a data subject, are my personal data processed lawfully, fairly and in a transparent manner` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under Article 5(1)(a), as a data subject, are my personal data processed lawfully, fairly and in a transparent manner` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Under Article 5(1)(c), as a data subject, are the personal data processed about me adequate, relevant and limited to what is necessary` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under Article 5(1)(c), as a data subject, are the personal data processed about me adequate, relevant and limited to what is necessary` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Under Article 5(1)(d), as a data subject, are the personal data processed about me accurate and, where necessary, kept up to date` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under Article 5(1)(d), as a data subject, are the personal data processed about me accurate and, where necessary, kept up to date` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Under Article 5(1)(d), as a data subject, has every reasonable step been taken to erase or rectify inaccurate personal data about me without delay` TRUE TRUE EQUALS JUST `the duty arises and is met`
#ASSERT `Under Article 5(1)(d), as a data subject, has every reasonable step been taken to erase or rectify inaccurate personal data about me without delay` TRUE FALSE EQUALS JUST `the duty arises and is not met`
-- no inaccurate data: Art 5(1)(d) second limb is a scope limit with no gate word, so NOTHING (periods ruling (c); fork F5-2)
#ASSERT `Under Article 5(1)(d), as a data subject, has every reasonable step been taken to erase or rectify inaccurate personal data about me without delay` FALSE FALSE EQUALS NOTHING
#ASSERT `Under Article 5(1)(e), as a data subject, are the personal data about me kept in a form which permits my identification no longer than is necessary` TRUE FALSE `Art 5(1)(b) some other purpose` FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under Article 5(1)(e), as a data subject, are the personal data about me kept in a form which permits my identification no longer than is necessary` TRUE TRUE `Art 5(1)(b) statistical purposes` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under Article 5(1)(e), as a data subject, are the personal data about me kept in a form which permits my identification no longer than is necessary` TRUE TRUE `Art 5(1)(b) some other purpose` FALSE FALSE EQUALS JUST FALSE
-- identifiable, kept longer, statistical purposes but Article 89(1) is not met: the second limb answers NOTHING (grant ruling, limit 1; fork F5-3) and the first limb stands, so JUST FALSE
#ASSERT `Under Article 5(1)(e), as a data subject, are the personal data about me kept in a form which permits my identification no longer than is necessary` TRUE TRUE `Art 5(1)(b) statistical purposes` FALSE TRUE EQUALS JUST FALSE
-- MIRROR 5_2
#ASSERT `Under Article 5(2), as a data subject, is the controller able to demonstrate compliance with Article 5(1)` TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under Article 5(2), as a data subject, is the controller able to demonstrate compliance with Article 5(1)` TRUE TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE

§ `Article 6 -- a lawful basis for the processing`

-- MIRROR 6a
#ASSERT `Under Article 6(1)(a), as a data subject, have I consented to the processing of my personal data for one or more specific purposes` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under Article 6(1)(a), as a data subject, have I consented to the processing of my personal data for one or more specific purposes` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Under Article 6(1)(a), as a data subject, have I consented to the processing of my personal data for one or more specific purposes` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Under Article 6(1)(b), as a data subject, is the processing necessary for a contract to which I am party or for steps I asked for before one` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under Article 6(1)(b), as a data subject, is the processing necessary for a contract to which I am party or for steps I asked for before one` FALSE TRUE EQUALS JUST TRUE
#ASSERT `Under Article 6(1)(b), as a data subject, is the processing necessary for a contract to which I am party or for steps I asked for before one` FALSE FALSE EQUALS JUST FALSE
#ASSERT `Under Article 6(1)(f), as a data subject, does point (f) (legitimate interests) apply to the processing of my personal data` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under Article 6(1)(f), as a data subject, does point (f) (legitimate interests) apply to the processing of my personal data` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Under Article 6(1)(f), as a data subject, does point (f) (legitimate interests) apply to the processing of my personal data` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Under Article 6(1)(f), as a data subject, does point (f) (legitimate interests) apply to the processing of my personal data` TRUE FALSE FALSE TRUE EQUALS JUST FALSE

§ `Article 7 -- consent`

-- MIRROR 7_1
#ASSERT `Under Article 7(1), as a data subject, is the controller able to demonstrate that I have consented` TRUE TRUE EQUALS JUST `the duty arises and is met`
#ASSERT `Under Article 7(1), as a data subject, is the controller able to demonstrate that I have consented` TRUE FALSE EQUALS JUST `the duty arises and is not met`
#ASSERT `Under Article 7(1), as a data subject, is the controller able to demonstrate that I have consented` FALSE FALSE EQUALS JUST `the duty does not arise`
#ASSERT `Under Article 7(2), as a data subject, is the request for my consent presented clearly where my consent is given in a written declaration that also concerns other matters` TRUE TRUE TRUE TRUE EQUALS JUST `the duty arises and is met`
#ASSERT `Under Article 7(2), as a data subject, is the request for my consent presented clearly where my consent is given in a written declaration that also concerns other matters` TRUE TRUE FALSE TRUE EQUALS JUST `the duty arises and is not met`
#ASSERT `Under Article 7(2), as a data subject, is the request for my consent presented clearly where my consent is given in a written declaration that also concerns other matters` FALSE FALSE FALSE FALSE EQUALS JUST `the duty does not arise`
-- MIRROR 7_2b
#ASSERT `Under Article 7(2), as a data subject, is a part of a declaration I gave that infringes this Regulation binding on me` TRUE TRUE EQUALS JUST FALSE
#ASSERT `Under Article 7(2), as a data subject, is a part of a declaration I gave that infringes this Regulation binding on me` TRUE FALSE EQUALS NOTHING
-- MIRROR 7_3a
#ASSERT `Under Article 7(3), as a data subject, may I withdraw my consent at any time` TRUE (Date 25 5 2018) (Date 25 5 2026) EQUALS JUST TRUE
#ASSERT `Under Article 7(3), as a data subject, may I withdraw my consent at any time` TRUE (Date 25 5 2018) (Date 25 5 2018) EQUALS JUST TRUE
#ASSERT `Under Article 7(3), as a data subject, may I withdraw my consent at any time` FALSE (Date 25 5 2018) (Date 25 5 2026) EQUALS NOTHING
-- MIRROR 7_3b
#ASSERT `Under Article 7(3), as a data subject, does my withdrawal of consent affect the lawfulness of the processing before it` TRUE TRUE EQUALS JUST FALSE
#ASSERT `Under Article 7(3), as a data subject, does my withdrawal of consent affect the lawfulness of the processing before it` TRUE FALSE EQUALS NOTHING
#ASSERT `Under Article 7(3), as a data subject, does my withdrawal of consent affect the lawfulness of the processing before it` FALSE TRUE EQUALS NOTHING
#ASSERT `Under Article 7(3), as a data subject, was I informed of the right to withdraw consent before I gave consent` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under Article 7(3), as a data subject, was I informed of the right to withdraw consent before I gave consent` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Under Article 7(3), as a data subject, was I informed of the right to withdraw consent before I gave consent` FALSE FALSE EQUALS NOTHING
#ASSERT `Under Article 7(3), as a data subject, is it as easy for me to withdraw consent as to give it` TRUE EQUALS JUST TRUE
#ASSERT `Under Article 7(3), as a data subject, is it as easy for me to withdraw consent as to give it` FALSE EQUALS JUST FALSE
#ASSERT `Under Article 7(4), as a data subject, is the conditionality of the contract on my consent a matter of which utmost account is taken in assessing whether my consent is freely given` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under Article 7(4), as a data subject, is the conditionality of the contract on my consent a matter of which utmost account is taken in assessing whether my consent is freely given` TRUE TRUE TRUE EQUALS NOTHING
-- not an assessment of whether consent is freely given: the "When" gate fails (periods ruling (b) and (c); fork F7-1)
#ASSERT `Under Article 7(4), as a data subject, is the conditionality of the contract on my consent a matter of which utmost account is taken in assessing whether my consent is freely given` FALSE TRUE FALSE EQUALS JUST FALSE

§ `Article 8 -- a child's consent to information society services`

-- MIRROR 8_1
#ASSERT `Under Article 8(1), as a data subject, does the processing of my personal data as a child meet the condition of Article 8(1)` TRUE TRUE 15 FALSE 0 FALSE EQUALS JUST FALSE
#ASSERT `Under Article 8(1), as a data subject, does the processing of my personal data as a child meet the condition of Article 8(1)` TRUE TRUE 15 FALSE 0 TRUE EQUALS JUST TRUE
#ASSERT `Under Article 8(1), as a data subject, does the processing of my personal data as a child meet the condition of Article 8(1)` TRUE TRUE 16 FALSE 0 FALSE EQUALS JUST TRUE
#ASSERT `Under Article 8(1), as a data subject, does the processing of my personal data as a child meet the condition of Article 8(1)` TRUE TRUE 12 TRUE 13 FALSE EQUALS JUST FALSE
#ASSERT `Under Article 8(1), as a data subject, does the processing of my personal data as a child meet the condition of Article 8(1)` TRUE TRUE 13 TRUE 13 FALSE EQUALS JUST TRUE
-- Art 6(1)(a) does not apply: "Where point (a) of Article 6(1) applies" fails, JUST FALSE (periods ruling (b); fork F8-5)
#ASSERT `Under Article 8(1), as a data subject, does the processing of my personal data as a child meet the condition of Article 8(1)` FALSE TRUE 5 FALSE 0 FALSE EQUALS JUST FALSE
-- point (a) applies but the services are not offered directly to a child: NOTHING (periods ruling (c); fork F8-5)
#ASSERT `Under Article 8(1), as a data subject, does the processing of my personal data as a child meet the condition of Article 8(1)` TRUE FALSE 5 FALSE 0 FALSE EQUALS NOTHING
-- Art 8(1) cases (scope "Where point (a) of Article 6(1) applies, in relation to the offer ... directly to a child"; below the age "Where the child is below the age"): JUST TRUE
#ASSERT `Under Article 8(1), as a data subject, is the consent of my parent or guardian (the holder of parental responsibility) needed for the processing of my personal data` TRUE TRUE 15 FALSE 0 EQUALS JUST TRUE
-- Art 8(1) cases (scope "Where point (a) of Article 6(1) applies, in relation to the offer ... directly to a child"; below the age "Where the child is below the age"): JUST FALSE
#ASSERT `Under Article 8(1), as a data subject, is the consent of my parent or guardian (the holder of parental responsibility) needed for the processing of my personal data` TRUE TRUE 16 FALSE 0 EQUALS JUST FALSE
-- Art 8(1) cases (scope "Where point (a) of Article 6(1) applies, in relation to the offer ... directly to a child"; below the age "Where the child is below the age"): JUST TRUE
#ASSERT `Under Article 8(1), as a data subject, is the consent of my parent or guardian (the holder of parental responsibility) needed for the processing of my personal data` TRUE TRUE 12 TRUE 13 EQUALS JUST TRUE
-- Art 6(1)(a) does not apply: JUST FALSE (fork F8-5)
#ASSERT `Under Article 8(1), as a data subject, is the consent of my parent or guardian (the holder of parental responsibility) needed for the processing of my personal data` FALSE TRUE 10 FALSE 0 EQUALS JUST FALSE
-- point (a) applies but the services are not offered directly to a child: NOTHING (fork F8-5)
#ASSERT `Under Article 8(1), as a data subject, is the consent of my parent or guardian (the holder of parental responsibility) needed for the processing of my personal data` TRUE FALSE 10 FALSE 0 EQUALS NOTHING
#ASSERT `Under Article 8(1), as a data subject, from what age may I consent myself in my Member State` FALSE 0 EQUALS 16
#ASSERT `Under Article 8(1), as a data subject, from what age may I consent myself in my Member State` TRUE 13 EQUALS 13
#ASSERT `Under Article 8(1), as a data subject, from what age may I consent myself in my Member State` TRUE 12 EQUALS 16
#ASSERT `Under Article 8(1), as a data subject, from what age may I consent myself in my Member State` TRUE 14 EQUALS 14

§ `Article 9 -- special categories of personal data`

#ASSERT `Under Article 9(1), as a data subject, are the personal data about me of a category the Regulation names` `Art 9(1) data concerning health` EQUALS TRUE
#ASSERT `Under Article 9(1), as a data subject, are the personal data about me of a category the Regulation names` `Art 9(1) data revealing trade union membership` EQUALS TRUE
#ASSERT `Under Article 9(1), as a data subject, are the personal data about me of a category the Regulation names` `Art 9(1) other personal data` EQUALS FALSE
#ASSERT `Under Article 9(1), as a data subject, are the personal data about me of a category the Regulation names` `Art 9(1) biometric data not for the purpose of uniquely identifying a natural person` EQUALS FALSE
#ASSERT `Under Article 9(2)(a), as a data subject, does point (a) (explicit consent) apply to the processing of my personal data` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under Article 9(2)(a), as a data subject, does point (a) (explicit consent) apply to the processing of my personal data` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Under Article 9(2)(c), as a data subject, does point (c) (vital interests where the data subject cannot give consent) apply to the processing of my personal data` TRUE `Art 6(1)(d) the data subject's` TRUE EQUALS JUST TRUE
#ASSERT `Under Article 9(2)(c), as a data subject, does point (c) (vital interests where the data subject cannot give consent) apply to the processing of my personal data` TRUE `Art 6(1)(d) the data subject's` FALSE EQUALS JUST FALSE
#ASSERT `Under Article 9(2)(e), as a data subject, does point (e) (data manifestly made public by the data subject) apply to the processing of my personal data` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under Article 9(2)(e), as a data subject, does point (e) (data manifestly made public by the data subject) apply to the processing of my personal data` TRUE FALSE EQUALS JUST FALSE
