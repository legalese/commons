IMPORT prelude
IMPORT `gdpr-core`
IMPORT `P2-art-17`

-- ============================================================================
-- P2-tests-art-17.l4 -- tests of Article 17 (src:225-240).
-- Every expected value was written by hand from the text of the provision named in the comment above it,
-- before the first run, and none was copied from an output (notes/gen-tests-p2.py holds the cases).
-- A #TRACE result is not an assertion and check.sh does not count it; each trace comment gives the expected result.
-- ============================================================================

§ `Art 17(1)(a) to (f): the six grounds`

-- (a) no longer necessary for the purposes
#ASSERT `Art 17(1)(a) point (a) applies: the personal data are no longer necessary in relation to the purposes for which they were collected or otherwise processed` TRUE EQUALS JUST TRUE
-- (a) still necessary: 'where one of the following grounds applies' fails
#ASSERT `Art 17(1)(a) point (a) applies: the personal data are no longer necessary in relation to the purposes for which they were collected or otherwise processed` FALSE EQUALS JUST FALSE
-- (b) consent withdrawn, no other legal ground
#ASSERT `Art 17(1)(b) point (b) applies: the data subject withdraws consent and there is no other legal ground for the processing` TRUE FALSE EQUALS JUST TRUE
-- (b) consent withdrawn but there is another legal ground: 'where there is no other legal ground' fails
#ASSERT `Art 17(1)(b) point (b) applies: the data subject withdraws consent and there is no other legal ground for the processing` TRUE TRUE EQUALS JUST FALSE
-- (b) no withdrawal
#ASSERT `Art 17(1)(b) point (b) applies: the data subject withdraws consent and there is no other legal ground for the processing` FALSE FALSE EQUALS JUST FALSE
-- (b) no withdrawal, another ground
#ASSERT `Art 17(1)(b) point (b) applies: the data subject withdraws consent and there is no other legal ground for the processing` FALSE TRUE EQUALS JUST FALSE
-- (c) objection under Article 21(1), no overriding legitimate grounds
#ASSERT `Art 17(1)(c) point (c) applies: the data subject objects to the processing and there are no overriding legitimate grounds for it, or the objection is under Article 21(2)` TRUE FALSE FALSE EQUALS JUST TRUE
-- (c) objection under Article 21(1) but overriding legitimate grounds exist
#ASSERT `Art 17(1)(c) point (c) applies: the data subject objects to the processing and there are no overriding legitimate grounds for it, or the objection is under Article 21(2)` TRUE TRUE FALSE EQUALS JUST FALSE
-- (c) objection under Article 21(2) (direct marketing): no test of overriding grounds
#ASSERT `Art 17(1)(c) point (c) applies: the data subject objects to the processing and there are no overriding legitimate grounds for it, or the objection is under Article 21(2)` FALSE FALSE TRUE EQUALS JUST TRUE
-- (c) overriding grounds exist, but the objection is also under Article 21(2)
#ASSERT `Art 17(1)(c) point (c) applies: the data subject objects to the processing and there are no overriding legitimate grounds for it, or the objection is under Article 21(2)` TRUE TRUE TRUE EQUALS JUST TRUE
-- (c) no objection
#ASSERT `Art 17(1)(c) point (c) applies: the data subject objects to the processing and there are no overriding legitimate grounds for it, or the objection is under Article 21(2)` FALSE FALSE FALSE EQUALS JUST FALSE
-- (d) unlawfully processed
#ASSERT `Art 17(1)(d) point (d) applies: the personal data have been unlawfully processed` TRUE EQUALS JUST TRUE
-- (d) lawfully processed
#ASSERT `Art 17(1)(d) point (d) applies: the personal data have been unlawfully processed` FALSE EQUALS JUST FALSE
-- (e) erasure required by Union or Member State law
#ASSERT `Art 17(1)(e) point (e) applies: the personal data have to be erased for compliance with a legal obligation in Union or Member State law` TRUE EQUALS JUST TRUE
-- (e) no such legal obligation
#ASSERT `Art 17(1)(e) point (e) applies: the personal data have to be erased for compliance with a legal obligation in Union or Member State law` FALSE EQUALS JUST FALSE
-- (f) collected in relation to the offer of information society services to a child (Article 8(1))
#ASSERT `Art 17(1)(f) point (f) applies: the personal data have been collected in relation to the offer of information society services referred to in Article 8(1)` TRUE EQUALS JUST TRUE
-- (f) not so collected
#ASSERT `Art 17(1)(f) point (f) applies: the personal data have been collected in relation to the offer of information society services referred to in Article 8(1)` FALSE EQUALS JUST FALSE

§ `Art 17(3)(a) to (e): the five exceptions`

-- (a) necessary for exercising freedom of expression and information
#ASSERT `Art 17(3)(a) paragraphs 1 and 2 do not apply to the extent that processing is necessary for exercising the right of freedom of expression and information` TRUE EQUALS JUST TRUE
-- (a) not necessary for that
#ASSERT `Art 17(3)(a) paragraphs 1 and 2 do not apply to the extent that processing is necessary for exercising the right of freedom of expression and information` FALSE EQUALS JUST FALSE
-- (b) necessary for compliance with a legal obligation
#ASSERT `Art 17(3)(b) paragraphs 1 and 2 do not apply to the extent that processing is necessary for compliance with a legal obligation or for a task in the public interest` TRUE FALSE EQUALS JUST TRUE
-- (b) necessary for a task in the public interest or official authority
#ASSERT `Art 17(3)(b) paragraphs 1 and 2 do not apply to the extent that processing is necessary for compliance with a legal obligation or for a task in the public interest` FALSE TRUE EQUALS JUST TRUE
-- (b) neither
#ASSERT `Art 17(3)(b) paragraphs 1 and 2 do not apply to the extent that processing is necessary for compliance with a legal obligation or for a task in the public interest` FALSE FALSE EQUALS JUST FALSE
-- (c) public health reasons, in accordance with points (h) and (i) of Article 9(2) and Article 9(3)
#ASSERT `Art 17(3)(c) paragraphs 1 and 2 do not apply to the extent that processing is necessary for reasons of public interest in the area of public health` TRUE (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
-- (c) Article 9(3) not met
#ASSERT `Art 17(3)(c) paragraphs 1 and 2 do not apply to the extent that processing is necessary for reasons of public interest in the area of public health` TRUE (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
-- (c) point (h) not met
#ASSERT `Art 17(3)(c) paragraphs 1 and 2 do not apply to the extent that processing is necessary for reasons of public interest in the area of public health` TRUE (JUST FALSE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
-- (c) point (i) not met
#ASSERT `Art 17(3)(c) paragraphs 1 and 2 do not apply to the extent that processing is necessary for reasons of public interest in the area of public health` TRUE (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
-- (c) point (i) not decided, none failed: not covered
#ASSERT `Art 17(3)(c) paragraphs 1 and 2 do not apply to the extent that processing is necessary for reasons of public interest in the area of public health` TRUE (JUST TRUE) NOTHING (JUST TRUE) EQUALS NOTHING
-- (c) point (h) fails: fails whatever (i) is
#ASSERT `Art 17(3)(c) paragraphs 1 and 2 do not apply to the extent that processing is necessary for reasons of public interest in the area of public health` TRUE (JUST FALSE) NOTHING (JUST TRUE) EQUALS JUST FALSE
-- (c) not necessary for public health reasons
#ASSERT `Art 17(3)(c) paragraphs 1 and 2 do not apply to the extent that processing is necessary for reasons of public interest in the area of public health` FALSE (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
-- (d) archiving, research or statistical purposes in accordance with Article 89(1), and the right is likely to render impossible or seriously impair the objectives
#ASSERT `Art 17(3)(d) paragraphs 1 and 2 do not apply to the extent that processing is necessary for archiving, research or statistical purposes` TRUE TRUE TRUE EQUALS JUST TRUE
-- (d) not in accordance with Article 89(1)
#ASSERT `Art 17(3)(d) paragraphs 1 and 2 do not apply to the extent that processing is necessary for archiving, research or statistical purposes` TRUE FALSE TRUE EQUALS JUST FALSE
-- (d) the right would not impair the objectives: 'in so far as' fails
#ASSERT `Art 17(3)(d) paragraphs 1 and 2 do not apply to the extent that processing is necessary for archiving, research or statistical purposes` TRUE TRUE FALSE EQUALS JUST FALSE
-- (d) not for those purposes
#ASSERT `Art 17(3)(d) paragraphs 1 and 2 do not apply to the extent that processing is necessary for archiving, research or statistical purposes` FALSE TRUE TRUE EQUALS JUST FALSE
-- (e) legal claims
#ASSERT `Art 17(3)(e) paragraphs 1 and 2 do not apply to the extent that processing is necessary for the establishment, exercise or defence of legal claims` TRUE EQUALS JUST TRUE
-- (e) no legal claims
#ASSERT `Art 17(3)(e) paragraphs 1 and 2 do not apply to the extent that processing is necessary for the establishment, exercise or defence of legal claims` FALSE EQUALS JUST FALSE
-- exception (a) holds
#ASSERT `Art 17(3) paragraphs 1 and 2 do not apply` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
-- exception (e) holds
#ASSERT `Art 17(3) paragraphs 1 and 2 do not apply` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
-- no exception holds
#ASSERT `Art 17(3) paragraphs 1 and 2 do not apply` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
-- no exception holds and (e) is not decided
#ASSERT `Art 17(3) paragraphs 1 and 2 do not apply` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) NOTHING EQUALS NOTHING
-- one exception holds whatever the others are
#ASSERT `Art 17(3) paragraphs 1 and 2 do not apply` NOTHING (JUST TRUE) NOTHING (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE

§ `Art 17(1): the right to erasure and the obligation to erase`

-- ground (a) holds, no exception
#ASSERT `Art 17(1) the data subject has the right to obtain from the controller the erasure of personal data concerning him or her and the controller has the obligation to erase them` TRUE TRUE (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) NOTHING EQUALS JUST TRUE
-- ground (d) holds, no exception
#ASSERT `Art 17(1) the data subject has the right to obtain from the controller the erasure of personal data concerning him or her and the controller has the obligation to erase them` TRUE TRUE (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) NOTHING EQUALS JUST TRUE
-- ground (f) holds, no exception
#ASSERT `Art 17(1) the data subject has the right to obtain from the controller the erasure of personal data concerning him or her and the controller has the obligation to erase them` TRUE TRUE (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST FALSE) NOTHING EQUALS JUST TRUE
-- all six grounds hold
#ASSERT `Art 17(1) the data subject has the right to obtain from the controller the erasure of personal data concerning him or her and the controller has the obligation to erase them` TRUE TRUE (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST FALSE) NOTHING EQUALS JUST TRUE
-- no ground holds: 'where one of the following grounds applies' fails
#ASSERT `Art 17(1) the data subject has the right to obtain from the controller the erasure of personal data concerning him or her and the controller has the obligation to erase them` TRUE TRUE (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) NOTHING EQUALS JUST FALSE
-- a ground holds, but paragraph 3 disapplies paragraphs 1 and 2
#ASSERT `Art 17(1) the data subject has the right to obtain from the controller the erasure of personal data concerning him or her and the controller has the obligation to erase them` TRUE TRUE (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) NOTHING EQUALS JUST FALSE
-- a ground holds, and whether paragraph 3 applies is not decided: not covered
#ASSERT `Art 17(1) the data subject has the right to obtain from the controller the erasure of personal data concerning him or her and the controller has the obligation to erase them` TRUE TRUE (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) NOTHING NOTHING EQUALS NOTHING
-- ground (a) holds, (b) is not decided, no exception: the right exists
#ASSERT `Art 17(1) the data subject has the right to obtain from the controller the erasure of personal data concerning him or her and the controller has the obligation to erase them` TRUE TRUE (JUST TRUE) NOTHING (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) NOTHING EQUALS JUST TRUE
-- no ground holds, one is not decided: not covered
#ASSERT `Art 17(1) the data subject has the right to obtain from the controller the erasure of personal data concerning him or her and the controller has the obligation to erase them` TRUE TRUE NOTHING (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) NOTHING EQUALS NOTHING
-- Article 11(2) disapplies Articles 15 to 20 (Article 17 is among them)
#ASSERT `Art 17(1) the data subject has the right to obtain from the controller the erasure of personal data concerning him or her and the controller has the obligation to erase them` TRUE TRUE (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
-- an Article 11(2) case with identifying information: the right applies
#ASSERT `Art 17(1) the data subject has the right to obtain from the controller the erasure of personal data concerning him or her and the controller has the obligation to erase them` TRUE TRUE (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
-- not the data subject
#ASSERT `Art 17(1) the data subject has the right to obtain from the controller the erasure of personal data concerning him or her and the controller has the obligation to erase them` FALSE TRUE (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) NOTHING EQUALS NOTHING
-- not the controller
#ASSERT `Art 17(1) the data subject has the right to obtain from the controller the erasure of personal data concerning him or her and the controller has the obligation to erase them` TRUE FALSE (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) NOTHING EQUALS NOTHING
-- FULFILLED: the controller erases
#TRACE `Art 17(1) the controller must erase the personal data without undue delay` (JUST TRUE) AT 0 WITH
    PARTY controller DOES `Art 17(1) erase the personal data without undue delay` AT 1
-- no act: the obligation stands; 'without undue delay' is not a number, so nothing breaches
#TRACE `Art 17(1) the controller must erase the personal data without undue delay` (JUST TRUE) AT 0 WITH
    (WAITUNTIL 1000)
-- FULFILLED: no right to erasure
#TRACE `Art 17(1) the controller must erase the personal data without undue delay` (JUST FALSE) AT 0 WITH
    (WAITUNTIL 1000)
-- FULFILLED: the right is not established (not covered), so the rule creates no standing duty
#TRACE `Art 17(1) the controller must erase the personal data without undue delay` NOTHING AT 0 WITH
    (WAITUNTIL 1000)

§ `Art 17(2): informing the controllers that process the data`

-- made public, obliged to erase, reasonable steps taken
#ASSERT `Art 17(2) the controller takes reasonable steps, including technical measures, to inform controllers which are processing the personal data that the data subject has requested the erasure of any links to, or copy or replication of, those personal data` TRUE (JUST TRUE) (JUST FALSE) TRUE EQUALS JUST `the duty arises and is met`
-- made public, obliged to erase, no steps: 'shall take reasonable steps'
#ASSERT `Art 17(2) the controller takes reasonable steps, including technical measures, to inform controllers which are processing the personal data that the data subject has requested the erasure of any links to, or copy or replication of, those personal data` TRUE (JUST TRUE) (JUST FALSE) FALSE EQUALS JUST `the duty arises and is not met`
-- not made public: 'Where the controller has made the personal data public' fails
#ASSERT `Art 17(2) the controller takes reasonable steps, including technical measures, to inform controllers which are processing the personal data that the data subject has requested the erasure of any links to, or copy or replication of, those personal data` FALSE (JUST TRUE) (JUST FALSE) FALSE EQUALS JUST `the duty does not arise`
-- made public but not obliged to erase: 'and is obliged pursuant to paragraph 1' fails
#ASSERT `Art 17(2) the controller takes reasonable steps, including technical measures, to inform controllers which are processing the personal data that the data subject has requested the erasure of any links to, or copy or replication of, those personal data` TRUE (JUST FALSE) (JUST FALSE) FALSE EQUALS JUST `the duty does not arise`
-- paragraph 3 disapplies paragraphs 1 and 2
#ASSERT `Art 17(2) the controller takes reasonable steps, including technical measures, to inform controllers which are processing the personal data that the data subject has requested the erasure of any links to, or copy or replication of, those personal data` TRUE (JUST TRUE) (JUST TRUE) FALSE EQUALS JUST `the duty does not arise`
-- whether the controller is obliged is not decided
#ASSERT `Art 17(2) the controller takes reasonable steps, including technical measures, to inform controllers which are processing the personal data that the data subject has requested the erasure of any links to, or copy or replication of, those personal data` TRUE NOTHING (JUST FALSE) FALSE EQUALS NOTHING
-- no steps and paragraph 3 is not decided: not covered
#ASSERT `Art 17(2) the controller takes reasonable steps, including technical measures, to inform controllers which are processing the personal data that the data subject has requested the erasure of any links to, or copy or replication of, those personal data` TRUE (JUST TRUE) NOTHING FALSE EQUALS NOTHING
-- steps taken: met whatever paragraph 3 says
#ASSERT `Art 17(2) the controller takes reasonable steps, including technical measures, to inform controllers which are processing the personal data that the data subject has requested the erasure of any links to, or copy or replication of, those personal data` TRUE (JUST TRUE) NOTHING TRUE EQUALS JUST `the duty arises and is met`
-- FULFILLED: the steps are taken
#TRACE `Art 17(2) the controller must take reasonable steps to inform the controllers which are processing the personal data` TRUE (JUST TRUE) (JUST FALSE) AT 0 WITH
    PARTY controller DOES `Art 17(2) take reasonable steps, including technical measures, to inform the controllers which are processing the personal data of the erasure request` AT 1
-- no act: the obligation stands; no breach is possible (no time limit)
#TRACE `Art 17(2) the controller must take reasonable steps to inform the controllers which are processing the personal data` TRUE (JUST TRUE) (JUST FALSE) AT 0 WITH
    (WAITUNTIL 1000)
-- FULFILLED: the data were not made public
#TRACE `Art 17(2) the controller must take reasonable steps to inform the controllers which are processing the personal data` FALSE (JUST TRUE) (JUST FALSE) AT 0 WITH
    (WAITUNTIL 1000)
