-- ============================================================================
-- P1-cases-mirror.l4 -- MIRROR cases (Guide section 3): the same facts put to the controller's seat and to the data subject's seat, with answers that agree.
-- The facts are those of the controller's cases, so the cases of the two seat files and this file say the same thing three times.
-- ============================================================================

-- MIRROR 10a: JUST TRUE
#ASSERT (`Under Article 10, as a controller, does my processing of criminal convictions data meet the condition of Article 10` TRUE TRUE TRUE FALSE FALSE) EQUALS (`Under Article 10, as a data subject, does the processing of data about my criminal convictions meet the condition of Article 10` TRUE TRUE TRUE FALSE FALSE)
-- MIRROR 10a: JUST TRUE
#ASSERT (`Under Article 10, as a controller, does my processing of criminal convictions data meet the condition of Article 10` TRUE TRUE FALSE TRUE TRUE) EQUALS (`Under Article 10, as a data subject, does the processing of data about my criminal convictions meet the condition of Article 10` TRUE TRUE FALSE TRUE TRUE)
-- MIRROR 10a: JUST FALSE
#ASSERT (`Under Article 10, as a controller, does my processing of criminal convictions data meet the condition of Article 10` TRUE TRUE FALSE FALSE FALSE) EQUALS (`Under Article 10, as a data subject, does the processing of data about my criminal convictions meet the condition of Article 10` TRUE TRUE FALSE FALSE FALSE)
-- MIRROR 10a: NOTHING
#ASSERT (`Under Article 10, as a controller, does my processing of criminal convictions data meet the condition of Article 10` FALSE TRUE FALSE FALSE FALSE) EQUALS (`Under Article 10, as a data subject, does the processing of data about my criminal convictions meet the condition of Article 10` FALSE TRUE FALSE FALSE FALSE)
-- MIRROR 11_1: JUST FALSE
#ASSERT (`Under Article 11(1), as a controller, am I obliged to maintain, acquire or process additional information to identify the data subject` TRUE TRUE) EQUALS (`Under Article 11(1), as a data subject, is the controller obliged to maintain, acquire or process additional information to identify me` TRUE TRUE)
-- MIRROR 11_1: NOTHING
#ASSERT (`Under Article 11(1), as a controller, am I obliged to maintain, acquire or process additional information to identify the data subject` FALSE TRUE) EQUALS (`Under Article 11(1), as a data subject, is the controller obliged to maintain, acquire or process additional information to identify me` FALSE TRUE)
-- MIRROR 11_2a: JUST `the duty arises and is met`
#ASSERT (`Under Article 11(2), as a controller, must I inform the data subject that I am not in a position to identify him or her, and have I` TRUE TRUE TRUE TRUE) EQUALS (`Under Article 11(2), as a data subject, must the controller inform me that it is not in a position to identify me, and has it` TRUE TRUE TRUE TRUE)
-- MIRROR 11_2a: JUST `the duty arises and is not met`
#ASSERT (`Under Article 11(2), as a controller, must I inform the data subject that I am not in a position to identify him or her, and have I` TRUE TRUE TRUE FALSE) EQUALS (`Under Article 11(2), as a data subject, must the controller inform me that it is not in a position to identify me, and has it` TRUE TRUE TRUE FALSE)
-- MIRROR 11_2a: JUST `the duty does not arise`
#ASSERT (`Under Article 11(2), as a controller, must I inform the data subject that I am not in a position to identify him or her, and have I` TRUE TRUE FALSE FALSE) EQUALS (`Under Article 11(2), as a data subject, must the controller inform me that it is not in a position to identify me, and has it` TRUE TRUE FALSE FALSE)
-- MIRROR 11_2b: JUST TRUE
#ASSERT (`Under Article 11(2), as a controller, are Articles 15 to 20 disapplied for the data subject I cannot identify` TRUE TRUE FALSE) EQUALS (`Under Article 11(2), as a data subject, are Articles 15 to 20 disapplied for my request` TRUE TRUE FALSE)
-- MIRROR 11_2b: JUST FALSE
#ASSERT (`Under Article 11(2), as a controller, are Articles 15 to 20 disapplied for the data subject I cannot identify` TRUE TRUE TRUE) EQUALS (`Under Article 11(2), as a data subject, are Articles 15 to 20 disapplied for my request` TRUE TRUE TRUE)
-- MIRROR 11_2b: NOTHING
#ASSERT (`Under Article 11(2), as a controller, are Articles 15 to 20 disapplied for the data subject I cannot identify` FALSE TRUE FALSE) EQUALS (`Under Article 11(2), as a data subject, are Articles 15 to 20 disapplied for my request` FALSE TRUE FALSE)
-- MIRROR 2: JUST TRUE
#ASSERT (`Under Article 2(1) and (2), as a controller, is my processing of personal data within the material scope of this Regulation` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `Art 2(2)(d) another purpose`) EQUALS (`Under Article 2(1) and (2), as a data subject, is the processing of my personal data within the material scope of this Regulation` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `Art 2(2)(d) another purpose`)
-- MIRROR 2: JUST FALSE
#ASSERT (`Under Article 2(1) and (2), as a controller, is my processing of personal data within the material scope of this Regulation` TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE TRUE FALSE `Art 2(2)(d) another purpose`) EQUALS (`Under Article 2(1) and (2), as a data subject, is the processing of my personal data within the material scope of this Regulation` TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE TRUE FALSE `Art 2(2)(d) another purpose`)
-- MIRROR 2: JUST FALSE
#ASSERT (`Under Article 2(1) and (2), as a controller, is my processing of personal data within the material scope of this Regulation` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE `Art 2(2)(d) detection of criminal offences`) EQUALS (`Under Article 2(1) and (2), as a data subject, is the processing of my personal data within the material scope of this Regulation` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE `Art 2(2)(d) detection of criminal offences`)
-- MIRROR 2: NOTHING
#ASSERT (`Under Article 2(1) and (2), as a controller, is my processing of personal data within the material scope of this Regulation` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `Art 2(2)(d) another purpose`) EQUALS (`Under Article 2(1) and (2), as a data subject, is the processing of my personal data within the material scope of this Regulation` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `Art 2(2)(d) another purpose`)
-- MIRROR 4_7: JUST TRUE
#ASSERT (`Under Article 4(7), as a controller, am I a controller of this processing` `legal person` TRUE TRUE FALSE FALSE) EQUALS (`Under Article 4(7), as a data subject, is a body that decides why and how my personal data are processed a controller` `legal person` TRUE TRUE FALSE FALSE)
-- MIRROR 4_7: JUST TRUE
#ASSERT (`Under Article 4(7), as a controller, am I a controller of this processing` `public authority` FALSE FALSE TRUE TRUE) EQUALS (`Under Article 4(7), as a data subject, is a body that decides why and how my personal data are processed a controller` `public authority` FALSE FALSE TRUE TRUE)
-- MIRROR 4_7: JUST FALSE
#ASSERT (`Under Article 4(7), as a controller, am I a controller of this processing` `not a person or body` TRUE TRUE FALSE FALSE) EQUALS (`Under Article 4(7), as a data subject, is a body that decides why and how my personal data are processed a controller` `not a person or body` TRUE TRUE FALSE FALSE)
-- MIRROR 4_7: JUST FALSE
#ASSERT (`Under Article 4(7), as a controller, am I a controller of this processing` `legal person` TRUE FALSE FALSE FALSE) EQUALS (`Under Article 4(7), as a data subject, is a body that decides why and how my personal data are processed a controller` `legal person` TRUE FALSE FALSE FALSE)
-- MIRROR 5_2: JUST TRUE
#ASSERT (`Under Article 5(2), as a controller, am I able to demonstrate compliance with Article 5(1)` TRUE TRUE TRUE TRUE TRUE TRUE) EQUALS (`Under Article 5(2), as a data subject, is the controller able to demonstrate compliance with Article 5(1)` TRUE TRUE TRUE TRUE TRUE TRUE)
-- MIRROR 5_2: JUST FALSE
#ASSERT (`Under Article 5(2), as a controller, am I able to demonstrate compliance with Article 5(1)` TRUE TRUE TRUE FALSE TRUE TRUE) EQUALS (`Under Article 5(2), as a data subject, is the controller able to demonstrate compliance with Article 5(1)` TRUE TRUE TRUE FALSE TRUE TRUE)
-- MIRROR 6a: JUST TRUE
#ASSERT (`Under Article 6(1)(a), as a controller, has the data subject consented to the processing for one or more specific purposes` TRUE TRUE TRUE) EQUALS (`Under Article 6(1)(a), as a data subject, have I consented to the processing of my personal data for one or more specific purposes` TRUE TRUE TRUE)
-- MIRROR 6a: JUST FALSE
#ASSERT (`Under Article 6(1)(a), as a controller, has the data subject consented to the processing for one or more specific purposes` TRUE FALSE TRUE) EQUALS (`Under Article 6(1)(a), as a data subject, have I consented to the processing of my personal data for one or more specific purposes` TRUE FALSE TRUE)
-- MIRROR 6a: JUST FALSE
#ASSERT (`Under Article 6(1)(a), as a controller, has the data subject consented to the processing for one or more specific purposes` FALSE TRUE TRUE) EQUALS (`Under Article 6(1)(a), as a data subject, have I consented to the processing of my personal data for one or more specific purposes` FALSE TRUE TRUE)
-- MIRROR 7_1: JUST `the duty arises and is met`
#ASSERT (`Under Article 7(1), as a controller, am I able to demonstrate that the data subject has consented` TRUE TRUE) EQUALS (`Under Article 7(1), as a data subject, is the controller able to demonstrate that I have consented` TRUE TRUE)
-- MIRROR 7_1: JUST `the duty arises and is not met`
#ASSERT (`Under Article 7(1), as a controller, am I able to demonstrate that the data subject has consented` TRUE FALSE) EQUALS (`Under Article 7(1), as a data subject, is the controller able to demonstrate that I have consented` TRUE FALSE)
-- MIRROR 7_1: JUST `the duty does not arise`
#ASSERT (`Under Article 7(1), as a controller, am I able to demonstrate that the data subject has consented` FALSE FALSE) EQUALS (`Under Article 7(1), as a data subject, is the controller able to demonstrate that I have consented` FALSE FALSE)
-- MIRROR 7_2b: JUST FALSE
#ASSERT (`Under Article 7(2), as a controller, is a part of the declaration that infringes this Regulation binding` TRUE TRUE) EQUALS (`Under Article 7(2), as a data subject, is a part of a declaration I gave that infringes this Regulation binding on me` TRUE TRUE)
-- MIRROR 7_2b: NOTHING
#ASSERT (`Under Article 7(2), as a controller, is a part of the declaration that infringes this Regulation binding` TRUE FALSE) EQUALS (`Under Article 7(2), as a data subject, is a part of a declaration I gave that infringes this Regulation binding on me` TRUE FALSE)
-- MIRROR 7_3a: JUST TRUE
#ASSERT (`Under Article 7(3), as a controller, may the data subject withdraw his or her consent at any time` TRUE (Date 25 5 2018) (Date 25 5 2026)) EQUALS (`Under Article 7(3), as a data subject, may I withdraw my consent at any time` TRUE (Date 25 5 2018) (Date 25 5 2026))
-- MIRROR 7_3a: JUST TRUE
#ASSERT (`Under Article 7(3), as a controller, may the data subject withdraw his or her consent at any time` TRUE (Date 25 5 2018) (Date 25 5 2018)) EQUALS (`Under Article 7(3), as a data subject, may I withdraw my consent at any time` TRUE (Date 25 5 2018) (Date 25 5 2018))
-- MIRROR 7_3a: NOTHING
#ASSERT (`Under Article 7(3), as a controller, may the data subject withdraw his or her consent at any time` FALSE (Date 25 5 2018) (Date 25 5 2026)) EQUALS (`Under Article 7(3), as a data subject, may I withdraw my consent at any time` FALSE (Date 25 5 2018) (Date 25 5 2026))
-- MIRROR 7_3b: JUST FALSE
#ASSERT (`Under Article 7(3), as a controller, does the data subject's withdrawal of consent affect the lawfulness of my earlier processing` TRUE TRUE) EQUALS (`Under Article 7(3), as a data subject, does my withdrawal of consent affect the lawfulness of the processing before it` TRUE TRUE)
-- MIRROR 7_3b: NOTHING
#ASSERT (`Under Article 7(3), as a controller, does the data subject's withdrawal of consent affect the lawfulness of my earlier processing` TRUE FALSE) EQUALS (`Under Article 7(3), as a data subject, does my withdrawal of consent affect the lawfulness of the processing before it` TRUE FALSE)
-- MIRROR 7_3b: NOTHING
#ASSERT (`Under Article 7(3), as a controller, does the data subject's withdrawal of consent affect the lawfulness of my earlier processing` FALSE TRUE) EQUALS (`Under Article 7(3), as a data subject, does my withdrawal of consent affect the lawfulness of the processing before it` FALSE TRUE)
-- MIRROR 8_1: JUST FALSE
#ASSERT (`Under Article 8(1), as a controller, does the processing of the child's personal data meet the condition of Article 8(1)` TRUE TRUE 15 FALSE 0 FALSE) EQUALS (`Under Article 8(1), as a data subject, does the processing of my personal data as a child meet the condition of Article 8(1)` TRUE TRUE 15 FALSE 0 FALSE)
-- MIRROR 8_1: JUST TRUE
#ASSERT (`Under Article 8(1), as a controller, does the processing of the child's personal data meet the condition of Article 8(1)` TRUE TRUE 15 FALSE 0 TRUE) EQUALS (`Under Article 8(1), as a data subject, does the processing of my personal data as a child meet the condition of Article 8(1)` TRUE TRUE 15 FALSE 0 TRUE)
-- MIRROR 8_1: JUST TRUE
#ASSERT (`Under Article 8(1), as a controller, does the processing of the child's personal data meet the condition of Article 8(1)` TRUE TRUE 16 FALSE 0 FALSE) EQUALS (`Under Article 8(1), as a data subject, does the processing of my personal data as a child meet the condition of Article 8(1)` TRUE TRUE 16 FALSE 0 FALSE)
-- MIRROR 8_1: JUST FALSE
#ASSERT (`Under Article 8(1), as a controller, does the processing of the child's personal data meet the condition of Article 8(1)` TRUE TRUE 12 TRUE 13 FALSE) EQUALS (`Under Article 8(1), as a data subject, does the processing of my personal data as a child meet the condition of Article 8(1)` TRUE TRUE 12 TRUE 13 FALSE)
-- MIRROR 8_1: JUST TRUE
#ASSERT (`Under Article 8(1), as a controller, does the processing of the child's personal data meet the condition of Article 8(1)` TRUE TRUE 13 TRUE 13 FALSE) EQUALS (`Under Article 8(1), as a data subject, does the processing of my personal data as a child meet the condition of Article 8(1)` TRUE TRUE 13 TRUE 13 FALSE)
-- MIRROR 8_1: JUST FALSE
#ASSERT (`Under Article 8(1), as a controller, does the processing of the child's personal data meet the condition of Article 8(1)` FALSE TRUE 5 FALSE 0 FALSE) EQUALS (`Under Article 8(1), as a data subject, does the processing of my personal data as a child meet the condition of Article 8(1)` FALSE TRUE 5 FALSE 0 FALSE)
