#ASSERT (`Under Article 8(1), as a controller, is the consent of the holder of parental responsibility needed for my processing` TRUE TRUE 15 FALSE 0) EQUALS (`Under Article 8(1), as a data subject, is the consent of my parent or guardian (the holder of parental responsibility) needed for the processing of my personal data` TRUE TRUE 15 FALSE 0)
