#ASSERT `Under Article 24(1), as a controller, are my measures reviewed and updated where necessary` TRUE FALSE EQUALS JUST `the duty arises and is not met`
#ASSERT `Under Article 24(1), as a controller, are my measures reviewed and updated where necessary` FALSE FALSE EQUALS JUST `the duty does not arise`
