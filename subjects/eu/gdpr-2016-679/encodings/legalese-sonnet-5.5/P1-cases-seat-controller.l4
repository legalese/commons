#ASSERT `Under Article 4(7), as a controller, am I a controller of this processing` `legal person` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under Article 4(7), as a controller, am I a controller of this processing` `public authority` FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under Article 4(7), as a controller, am I a controller of this processing` `not a person or body` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Under Article 4(7), as a controller, am I a controller of this processing` `legal person` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Under Article 4(7), as a controller, do I decide the purposes and means alone or jointly with others` TRUE TRUE FALSE EQUALS JUST `Art 4(7) alone`
#ASSERT `Under Article 4(7), as a controller, do I decide the purposes and means alone or jointly with others` TRUE TRUE TRUE EQUALS JUST `Art 4(7) jointly with others`
#ASSERT `Under Article 4(7), as a controller, do I decide the purposes and means alone or jointly with others` FALSE TRUE FALSE EQUALS NOTHING
