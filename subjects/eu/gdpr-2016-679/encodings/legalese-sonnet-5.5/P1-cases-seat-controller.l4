#ASSERT `Under Article 7(3), as a controller, does the data subject's withdrawal of consent affect the lawfulness of my earlier processing` TRUE FALSE EQUALS NOTHING
#ASSERT `Under Article 7(3), as a controller, does the data subject's withdrawal of consent affect the lawfulness of my earlier processing` FALSE TRUE EQUALS NOTHING
