#ASSERT `Under Article 7(3), as a controller, was the data subject informed of the right to withdraw consent before giving consent` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Under Article 7(3), as a controller, was the data subject informed of the right to withdraw consent before giving consent` FALSE FALSE EQUALS NOTHING
