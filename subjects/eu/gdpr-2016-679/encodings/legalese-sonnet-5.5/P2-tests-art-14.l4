IMPORT prelude
IMPORT `gdpr-core`
IMPORT `P2-art-14`

-- ============================================================================
-- P2-tests-art-14.l4 -- tests of Article 14 (src:179-205).
-- Every expected value was written by hand from the text of the provision named in the comment above it,
-- before the first run, and none was copied from an output (notes/gen-tests-p2.py holds the cases).
-- A #TRACE result is not an assertion and check.sh does not count it; each trace comment gives the expected result.
-- ============================================================================

§ `Art 14(1): the information where the data have not been obtained from the data subject`

-- the data were obtained from the data subject: 'Where personal data have not been obtained' fails
#ASSERT `Art 14(1) the controller provides the data subject with the following information` FALSE (JUST FALSE) FALSE FALSE FALSE FALSE EMPTY EMPTY EQUALS JUST `the duty does not arise`
-- paragraph 5 (b), (c) or (d) disapplies paragraphs 1 to 4: 'shall not apply'
#ASSERT `Art 14(1) the controller provides the data subject with the following information` TRUE (JUST TRUE) FALSE FALSE FALSE FALSE EMPTY EMPTY EQUALS JUST `the duty does not arise`
-- (a), (c), (d) provided; no representative, officer, recipients or transfer
#ASSERT `Art 14(1) the controller provides the data subject with the following information` TRUE (JUST FALSE) FALSE FALSE FALSE FALSE (LIST `Art 14(1)(a) the identity and the contact details of the controller`, `Art 14(1)(c) the purposes of the processing for which the personal data are intended`, `Art 14(1)(c) the legal basis for the processing`, `Art 14(1)(d) the categories of personal data concerned`) EMPTY EQUALS JUST `the duty arises and is met`
-- (a) the identity and contact details of the controller not provided
#ASSERT `Art 14(1) the controller provides the data subject with the following information` TRUE (JUST FALSE) FALSE FALSE FALSE FALSE (LIST `Art 14(1)(c) the purposes of the processing for which the personal data are intended`, `Art 14(1)(c) the legal basis for the processing`, `Art 14(1)(d) the categories of personal data concerned`) EMPTY EQUALS JUST `the duty arises and is not met`
-- (c) the purposes not provided
#ASSERT `Art 14(1) the controller provides the data subject with the following information` TRUE (JUST FALSE) FALSE FALSE FALSE FALSE (LIST `Art 14(1)(a) the identity and the contact details of the controller`, `Art 14(1)(c) the legal basis for the processing`, `Art 14(1)(d) the categories of personal data concerned`) EMPTY EQUALS JUST `the duty arises and is not met`
-- (c) the legal basis not provided
#ASSERT `Art 14(1) the controller provides the data subject with the following information` TRUE (JUST FALSE) FALSE FALSE FALSE FALSE (LIST `Art 14(1)(a) the identity and the contact details of the controller`, `Art 14(1)(c) the purposes of the processing for which the personal data are intended`, `Art 14(1)(d) the categories of personal data concerned`) EMPTY EQUALS JUST `the duty arises and is not met`
-- (d) the categories of personal data concerned not provided
#ASSERT `Art 14(1) the controller provides the data subject with the following information` TRUE (JUST FALSE) FALSE FALSE FALSE FALSE (LIST `Art 14(1)(a) the identity and the contact details of the controller`, `Art 14(1)(c) the purposes of the processing for which the personal data are intended`, `Art 14(1)(c) the legal basis for the processing`) EMPTY EQUALS JUST `the duty arises and is not met`
-- (a) 'where applicable, of the controller's representative': there is one and it was not provided
#ASSERT `Art 14(1) the controller provides the data subject with the following information` TRUE (JUST FALSE) TRUE FALSE FALSE FALSE (LIST `Art 14(1)(a) the identity and the contact details of the controller`, `Art 14(1)(c) the purposes of the processing for which the personal data are intended`, `Art 14(1)(c) the legal basis for the processing`, `Art 14(1)(d) the categories of personal data concerned`) EMPTY EQUALS JUST `the duty arises and is not met`
-- the representative provided
#ASSERT `Art 14(1) the controller provides the data subject with the following information` TRUE (JUST FALSE) TRUE FALSE FALSE FALSE (LIST `Art 14(1)(a) the identity and the contact details of the controller`, `Art 14(1)(c) the purposes of the processing for which the personal data are intended`, `Art 14(1)(c) the legal basis for the processing`, `Art 14(1)(d) the categories of personal data concerned`, `Art 14(1)(a) the identity and the contact details of the controller's representative`) EMPTY EQUALS JUST `the duty arises and is met`
-- (b) 'where applicable': the officer's contact details not provided
#ASSERT `Art 14(1) the controller provides the data subject with the following information` TRUE (JUST FALSE) FALSE TRUE FALSE FALSE (LIST `Art 14(1)(a) the identity and the contact details of the controller`, `Art 14(1)(c) the purposes of the processing for which the personal data are intended`, `Art 14(1)(c) the legal basis for the processing`, `Art 14(1)(d) the categories of personal data concerned`) EMPTY EQUALS JUST `the duty arises and is not met`
-- (b) provided
#ASSERT `Art 14(1) the controller provides the data subject with the following information` TRUE (JUST FALSE) FALSE TRUE FALSE FALSE (LIST `Art 14(1)(a) the identity and the contact details of the controller`, `Art 14(1)(c) the purposes of the processing for which the personal data are intended`, `Art 14(1)(c) the legal basis for the processing`, `Art 14(1)(d) the categories of personal data concerned`, `Art 14(1)(b) the contact details of the data protection officer`) EMPTY EQUALS JUST `the duty arises and is met`
-- (e) 'if any': recipients exist and were not named
#ASSERT `Art 14(1) the controller provides the data subject with the following information` TRUE (JUST FALSE) FALSE FALSE TRUE FALSE (LIST `Art 14(1)(a) the identity and the contact details of the controller`, `Art 14(1)(c) the purposes of the processing for which the personal data are intended`, `Art 14(1)(c) the legal basis for the processing`, `Art 14(1)(d) the categories of personal data concerned`) EMPTY EQUALS JUST `the duty arises and is not met`
-- (e) provided
#ASSERT `Art 14(1) the controller provides the data subject with the following information` TRUE (JUST FALSE) FALSE FALSE TRUE FALSE (LIST `Art 14(1)(a) the identity and the contact details of the controller`, `Art 14(1)(c) the purposes of the processing for which the personal data are intended`, `Art 14(1)(c) the legal basis for the processing`, `Art 14(1)(d) the categories of personal data concerned`, `Art 14(1)(e) the recipients or categories of recipients of the personal data`) EMPTY EQUALS JUST `the duty arises and is met`
-- (f) 'where applicable': a transfer is intended and was not disclosed
#ASSERT `Art 14(1) the controller provides the data subject with the following information` TRUE (JUST FALSE) FALSE FALSE FALSE TRUE (LIST `Art 14(1)(a) the identity and the contact details of the controller`, `Art 14(1)(c) the purposes of the processing for which the personal data are intended`, `Art 14(1)(c) the legal basis for the processing`, `Art 14(1)(d) the categories of personal data concerned`) EMPTY EQUALS JUST `the duty arises and is not met`
-- (f) provided
#ASSERT `Art 14(1) the controller provides the data subject with the following information` TRUE (JUST FALSE) FALSE FALSE FALSE TRUE (LIST `Art 14(1)(a) the identity and the contact details of the controller`, `Art 14(1)(c) the purposes of the processing for which the personal data are intended`, `Art 14(1)(c) the legal basis for the processing`, `Art 14(1)(d) the categories of personal data concerned`, `Art 14(1)(f) the intended transfer to a recipient in a third country or international organisation and the adequacy decision or the safeguards`) EMPTY EQUALS JUST `the duty arises and is met`
-- (d) not provided but already held by the data subject (paragraph 5(a))
#ASSERT `Art 14(1) the controller provides the data subject with the following information` TRUE (JUST FALSE) FALSE FALSE FALSE FALSE (LIST `Art 14(1)(a) the identity and the contact details of the controller`, `Art 14(1)(c) the purposes of the processing for which the personal data are intended`, `Art 14(1)(c) the legal basis for the processing`) (LIST `Art 14(1)(d) the categories of personal data concerned`) EQUALS JUST `the duty arises and is met`
-- paragraph 5 not answered, but every item was provided: the duty is met either way
#ASSERT `Art 14(1) the controller provides the data subject with the following information` TRUE NOTHING FALSE FALSE FALSE FALSE (LIST `Art 14(1)(a) the identity and the contact details of the controller`, `Art 14(1)(c) the purposes of the processing for which the personal data are intended`, `Art 14(1)(c) the legal basis for the processing`, `Art 14(1)(d) the categories of personal data concerned`) EMPTY EQUALS JUST `the duty arises and is met`
-- paragraph 5 not answered and items missing: the text does not say whether the duty was taken away
#ASSERT `Art 14(1) the controller provides the data subject with the following information` TRUE NOTHING FALSE FALSE FALSE FALSE (LIST `Art 14(1)(a) the identity and the contact details of the controller`) EMPTY EQUALS NOTHING
-- paragraph 5 (b) to (d) do not apply and items are missing
#ASSERT `Art 14(1) the controller provides the data subject with the following information` TRUE (JUST FALSE) FALSE FALSE FALSE FALSE (LIST `Art 14(1)(a) the identity and the contact details of the controller`) EMPTY EQUALS JUST `the duty arises and is not met`
-- every point applies and every item is provided
#ASSERT `Art 14(1) the controller provides the data subject with the following information` TRUE (JUST FALSE) TRUE TRUE TRUE TRUE (LIST `Art 14(1)(a) the identity and the contact details of the controller`, `Art 14(1)(c) the purposes of the processing for which the personal data are intended`, `Art 14(1)(c) the legal basis for the processing`, `Art 14(1)(d) the categories of personal data concerned`, `Art 14(1)(a) the identity and the contact details of the controller's representative`, `Art 14(1)(b) the contact details of the data protection officer`, `Art 14(1)(e) the recipients or categories of recipients of the personal data`, `Art 14(1)(f) the intended transfer to a recipient in a third country or international organisation and the adequacy decision or the safeguards`) EMPTY EQUALS JUST `the duty arises and is met`

§ `Art 14(2): the further information`

-- data obtained from the data subject: 'In addition to the information referred to in paragraph 1' is not met, the text is silent
#ASSERT `Art 14(2) the controller provides the data subject with the following information necessary to ensure fair and transparent processing` FALSE (JUST FALSE) (JUST FALSE) FALSE FALSE EMPTY EMPTY EQUALS NOTHING
-- paragraph 5 (b) to (d) disapplies paragraphs 1 to 4
#ASSERT `Art 14(2) the controller provides the data subject with the following information necessary to ensure fair and transparent processing` TRUE (JUST TRUE) (JUST FALSE) FALSE FALSE EMPTY EMPTY EQUALS JUST `the duty does not arise`
-- (a), (c), (e), (f) provided; no point (f) basis, no consent basis, no automated decision-making
#ASSERT `Art 14(2) the controller provides the data subject with the following information necessary to ensure fair and transparent processing` TRUE (JUST FALSE) (JUST FALSE) FALSE FALSE (LIST `Art 14(2)(a) the period for which the personal data will be stored, or the criteria used to determine that period`, `Art 14(2)(c) the existence of the rights of access, rectification, erasure, restriction, objection and data portability`, `Art 14(2)(e) the right to lodge a complaint with a supervisory authority`, `Art 14(2)(f) the source from which the personal data originate and, if applicable, whether it came from publicly accessible sources`) EMPTY EQUALS JUST `the duty arises and is met`
-- (a) the storage period not provided
#ASSERT `Art 14(2) the controller provides the data subject with the following information necessary to ensure fair and transparent processing` TRUE (JUST FALSE) (JUST FALSE) FALSE FALSE (LIST `Art 14(2)(c) the existence of the rights of access, rectification, erasure, restriction, objection and data portability`, `Art 14(2)(e) the right to lodge a complaint with a supervisory authority`, `Art 14(2)(f) the source from which the personal data originate and, if applicable, whether it came from publicly accessible sources`) EMPTY EQUALS JUST `the duty arises and is not met`
-- (c) the existence of the rights not provided
#ASSERT `Art 14(2) the controller provides the data subject with the following information necessary to ensure fair and transparent processing` TRUE (JUST FALSE) (JUST FALSE) FALSE FALSE (LIST `Art 14(2)(a) the period for which the personal data will be stored, or the criteria used to determine that period`, `Art 14(2)(e) the right to lodge a complaint with a supervisory authority`, `Art 14(2)(f) the source from which the personal data originate and, if applicable, whether it came from publicly accessible sources`) EMPTY EQUALS JUST `the duty arises and is not met`
-- (e) the right to lodge a complaint not provided
#ASSERT `Art 14(2) the controller provides the data subject with the following information necessary to ensure fair and transparent processing` TRUE (JUST FALSE) (JUST FALSE) FALSE FALSE (LIST `Art 14(2)(a) the period for which the personal data will be stored, or the criteria used to determine that period`, `Art 14(2)(c) the existence of the rights of access, rectification, erasure, restriction, objection and data portability`, `Art 14(2)(f) the source from which the personal data originate and, if applicable, whether it came from publicly accessible sources`) EMPTY EQUALS JUST `the duty arises and is not met`
-- (f) the source not provided
#ASSERT `Art 14(2) the controller provides the data subject with the following information necessary to ensure fair and transparent processing` TRUE (JUST FALSE) (JUST FALSE) FALSE FALSE (LIST `Art 14(2)(a) the period for which the personal data will be stored, or the criteria used to determine that period`, `Art 14(2)(c) the existence of the rights of access, rectification, erasure, restriction, objection and data portability`, `Art 14(2)(e) the right to lodge a complaint with a supervisory authority`) EMPTY EQUALS JUST `the duty arises and is not met`
-- (b) 'where the processing is based on point (f) of Article 6(1)': it is, and the legitimate interests were not provided
#ASSERT `Art 14(2) the controller provides the data subject with the following information necessary to ensure fair and transparent processing` TRUE (JUST FALSE) (JUST TRUE) FALSE FALSE (LIST `Art 14(2)(a) the period for which the personal data will be stored, or the criteria used to determine that period`, `Art 14(2)(c) the existence of the rights of access, rectification, erasure, restriction, objection and data portability`, `Art 14(2)(e) the right to lodge a complaint with a supervisory authority`, `Art 14(2)(f) the source from which the personal data originate and, if applicable, whether it came from publicly accessible sources`) EMPTY EQUALS JUST `the duty arises and is not met`
-- (b) provided
#ASSERT `Art 14(2) the controller provides the data subject with the following information necessary to ensure fair and transparent processing` TRUE (JUST FALSE) (JUST TRUE) FALSE FALSE (LIST `Art 14(2)(a) the period for which the personal data will be stored, or the criteria used to determine that period`, `Art 14(2)(c) the existence of the rights of access, rectification, erasure, restriction, objection and data portability`, `Art 14(2)(e) the right to lodge a complaint with a supervisory authority`, `Art 14(2)(f) the source from which the personal data originate and, if applicable, whether it came from publicly accessible sources`, `Art 14(2)(b) the legitimate interests pursued by the controller or by a third party`) EMPTY EQUALS JUST `the duty arises and is met`
-- whether point (f) applies is not answered: item (b) neither provided nor shown not to be owed
#ASSERT `Art 14(2) the controller provides the data subject with the following information necessary to ensure fair and transparent processing` TRUE (JUST FALSE) NOTHING FALSE FALSE (LIST `Art 14(2)(a) the period for which the personal data will be stored, or the criteria used to determine that period`, `Art 14(2)(c) the existence of the rights of access, rectification, erasure, restriction, objection and data portability`, `Art 14(2)(e) the right to lodge a complaint with a supervisory authority`, `Art 14(2)(f) the source from which the personal data originate and, if applicable, whether it came from publicly accessible sources`) EMPTY EQUALS NOTHING
-- point (f) not answered, (b) provided in any event
#ASSERT `Art 14(2) the controller provides the data subject with the following information necessary to ensure fair and transparent processing` TRUE (JUST FALSE) NOTHING FALSE FALSE (LIST `Art 14(2)(a) the period for which the personal data will be stored, or the criteria used to determine that period`, `Art 14(2)(c) the existence of the rights of access, rectification, erasure, restriction, objection and data portability`, `Art 14(2)(e) the right to lodge a complaint with a supervisory authority`, `Art 14(2)(f) the source from which the personal data originate and, if applicable, whether it came from publicly accessible sources`, `Art 14(2)(b) the legitimate interests pursued by the controller or by a third party`) EMPTY EQUALS JUST `the duty arises and is met`
-- (d) 'where processing is based on point (a) of Article 6(1) or point (a) of Article 9(2)': it is, and the right to withdraw consent was not provided
#ASSERT `Art 14(2) the controller provides the data subject with the following information necessary to ensure fair and transparent processing` TRUE (JUST FALSE) (JUST FALSE) TRUE FALSE (LIST `Art 14(2)(a) the period for which the personal data will be stored, or the criteria used to determine that period`, `Art 14(2)(c) the existence of the rights of access, rectification, erasure, restriction, objection and data portability`, `Art 14(2)(e) the right to lodge a complaint with a supervisory authority`, `Art 14(2)(f) the source from which the personal data originate and, if applicable, whether it came from publicly accessible sources`) EMPTY EQUALS JUST `the duty arises and is not met`
-- (d) provided
#ASSERT `Art 14(2) the controller provides the data subject with the following information necessary to ensure fair and transparent processing` TRUE (JUST FALSE) (JUST FALSE) TRUE FALSE (LIST `Art 14(2)(a) the period for which the personal data will be stored, or the criteria used to determine that period`, `Art 14(2)(c) the existence of the rights of access, rectification, erasure, restriction, objection and data portability`, `Art 14(2)(e) the right to lodge a complaint with a supervisory authority`, `Art 14(2)(f) the source from which the personal data originate and, if applicable, whether it came from publicly accessible sources`, `Art 14(2)(d) the existence of the right to withdraw consent at any time, without affecting the lawfulness of processing before its withdrawal`) EMPTY EQUALS JUST `the duty arises and is met`
-- (g) automated decision-making referred to in Article 22(1) and (4): not provided
#ASSERT `Art 14(2) the controller provides the data subject with the following information necessary to ensure fair and transparent processing` TRUE (JUST FALSE) (JUST FALSE) FALSE TRUE (LIST `Art 14(2)(a) the period for which the personal data will be stored, or the criteria used to determine that period`, `Art 14(2)(c) the existence of the rights of access, rectification, erasure, restriction, objection and data portability`, `Art 14(2)(e) the right to lodge a complaint with a supervisory authority`, `Art 14(2)(f) the source from which the personal data originate and, if applicable, whether it came from publicly accessible sources`) EMPTY EQUALS JUST `the duty arises and is not met`
-- (g) provided
#ASSERT `Art 14(2) the controller provides the data subject with the following information necessary to ensure fair and transparent processing` TRUE (JUST FALSE) (JUST FALSE) FALSE TRUE (LIST `Art 14(2)(a) the period for which the personal data will be stored, or the criteria used to determine that period`, `Art 14(2)(c) the existence of the rights of access, rectification, erasure, restriction, objection and data portability`, `Art 14(2)(e) the right to lodge a complaint with a supervisory authority`, `Art 14(2)(f) the source from which the personal data originate and, if applicable, whether it came from publicly accessible sources`, `Art 14(2)(g) the existence of automated decision-making, including profiling, and meaningful information about the logic involved, the significance and the envisaged consequences`) EMPTY EQUALS JUST `the duty arises and is met`
-- paragraph 5 not answered and items missing
#ASSERT `Art 14(2) the controller provides the data subject with the following information necessary to ensure fair and transparent processing` TRUE NOTHING (JUST FALSE) FALSE FALSE (LIST `Art 14(2)(a) the period for which the personal data will be stored, or the criteria used to determine that period`) EMPTY EQUALS NOTHING
-- (f) not provided but already held
#ASSERT `Art 14(2) the controller provides the data subject with the following information necessary to ensure fair and transparent processing` TRUE (JUST FALSE) (JUST FALSE) FALSE FALSE (LIST `Art 14(2)(a) the period for which the personal data will be stored, or the criteria used to determine that period`, `Art 14(2)(c) the existence of the rights of access, rectification, erasure, restriction, objection and data portability`, `Art 14(2)(e) the right to lodge a complaint with a supervisory authority`) (LIST `Art 14(2)(f) the source from which the personal data originate and, if applicable, whether it came from publicly accessible sources`) EQUALS JUST `the duty arises and is met`
-- every point applies and every item is provided
#ASSERT `Art 14(2) the controller provides the data subject with the following information necessary to ensure fair and transparent processing` TRUE (JUST FALSE) (JUST TRUE) TRUE TRUE (LIST `Art 14(2)(a) the period for which the personal data will be stored, or the criteria used to determine that period`, `Art 14(2)(c) the existence of the rights of access, rectification, erasure, restriction, objection and data portability`, `Art 14(2)(e) the right to lodge a complaint with a supervisory authority`, `Art 14(2)(f) the source from which the personal data originate and, if applicable, whether it came from publicly accessible sources`, `Art 14(2)(b) the legitimate interests pursued by the controller or by a third party`, `Art 14(2)(d) the existence of the right to withdraw consent at any time, without affecting the lawfulness of processing before its withdrawal`, `Art 14(2)(g) the existence of automated decision-making, including profiling, and meaningful information about the logic involved, the significance and the envisaged consequences`) EMPTY EQUALS JUST `the duty arises and is met`

§ `Art 14(3): the time limit, the earliest of the applicable limits`

-- (a) at the latest within one month: no communication and no disclosure
#ASSERT `Art 14(3) the months within which the information is to be provided` FALSE 0 FALSE 0 EQUALS 1
-- (b) first communication after half a month: at the latest at the time of the first communication
#ASSERT `Art 14(3) the months within which the information is to be provided` TRUE 0.5 FALSE 0 EQUALS 0.5
-- (b) first communication after two months: the limit of (a) is earlier, so one month
#ASSERT `Art 14(3) the months within which the information is to be provided` TRUE 2 FALSE 0 EQUALS 1
-- (c) a disclosure envisaged after a quarter of a month: at the latest when first disclosed
#ASSERT `Art 14(3) the months within which the information is to be provided` FALSE 0 TRUE 0.25 EQUALS 0.25
-- both: the disclosure is earlier
#ASSERT `Art 14(3) the months within which the information is to be provided` TRUE 0.5 TRUE 0.25 EQUALS 0.25
-- both: the communication is earlier
#ASSERT `Art 14(3) the months within which the information is to be provided` TRUE 0.1 TRUE 0.25 EQUALS 0.1
-- both: the disclosure is later than the communication and than one month
#ASSERT `Art 14(3) the months within which the information is to be provided` TRUE 0.5 TRUE 3 EQUALS 0.5
-- the dates are not read where there is no communication and no disclosure
#ASSERT `Art 14(3) the months within which the information is to be provided` FALSE 0.1 FALSE 0.1 EQUALS 1
-- provided exactly one month after obtaining the data: 'at the latest within one month'
#ASSERT `Art 14(3) the controller provides the information referred to in paragraphs 1 and 2 within the time that paragraph 3 requires` TRUE 1 FALSE 0 FALSE 0 EQUALS JUST TRUE
-- provided after one month and a half
#ASSERT `Art 14(3) the controller provides the information referred to in paragraphs 1 and 2 within the time that paragraph 3 requires` TRUE 1.5 FALSE 0 FALSE 0 EQUALS JUST FALSE
-- within a month but not within 'a reasonable period ... having regard to the specific circumstances'
#ASSERT `Art 14(3) the controller provides the information referred to in paragraphs 1 and 2 within the time that paragraph 3 requires` FALSE 0.5 FALSE 0 FALSE 0 EQUALS JUST FALSE
-- (b) provided at the time of the first communication
#ASSERT `Art 14(3) the controller provides the information referred to in paragraphs 1 and 2 within the time that paragraph 3 requires` TRUE 0.5 TRUE 0.5 FALSE 0 EQUALS JUST TRUE
-- (b) provided after the first communication
#ASSERT `Art 14(3) the controller provides the information referred to in paragraphs 1 and 2 within the time that paragraph 3 requires` TRUE 0.6 TRUE 0.5 FALSE 0 EQUALS JUST FALSE
-- (c) provided when the data are first disclosed
#ASSERT `Art 14(3) the controller provides the information referred to in paragraphs 1 and 2 within the time that paragraph 3 requires` TRUE 0.2 FALSE 0 TRUE 0.2 EQUALS JUST TRUE
-- (c) provided after the first disclosure
#ASSERT `Art 14(3) the controller provides the information referred to in paragraphs 1 and 2 within the time that paragraph 3 requires` TRUE 0.3 FALSE 0 TRUE 0.2 EQUALS JUST FALSE
-- FULFILLED: provided at month 1, within the month
#TRACE `Art 14(1) and (2) the controller must provide the data subject with the information within the time that Art 14(3) requires` TRUE (JUST FALSE) FALSE 0 FALSE 0 AT 0 WITH
    PARTY controller DOES `Art 14(1) and (2) provide the data subject with the information that paragraphs 1 and 2 list` AT 1
-- BREACH: provided at month 2, after the month
#TRACE `Art 14(1) and (2) the controller must provide the data subject with the information within the time that Art 14(3) requires` TRUE (JUST FALSE) FALSE 0 FALSE 0 AT 0 WITH
    PARTY controller DOES `Art 14(1) and (2) provide the data subject with the information that paragraphs 1 and 2 list` AT 2
-- BREACH: nothing provided within the month
#TRACE `Art 14(1) and (2) the controller must provide the data subject with the information within the time that Art 14(3) requires` TRUE (JUST FALSE) FALSE 0 FALSE 0 AT 0 WITH
    (WAITUNTIL 2)
-- BREACH: provided at month 0.6, after the first communication at 0.5
#TRACE `Art 14(1) and (2) the controller must provide the data subject with the information within the time that Art 14(3) requires` TRUE (JUST FALSE) TRUE 0.5 FALSE 0 AT 0 WITH
    PARTY controller DOES `Art 14(1) and (2) provide the data subject with the information that paragraphs 1 and 2 list` AT 0.6
-- FULFILLED: provided at the time of the first communication
#TRACE `Art 14(1) and (2) the controller must provide the data subject with the information within the time that Art 14(3) requires` TRUE (JUST FALSE) TRUE 0.5 FALSE 0 AT 0 WITH
    PARTY controller DOES `Art 14(1) and (2) provide the data subject with the information that paragraphs 1 and 2 list` AT 0.5
-- BREACH: a disclosure at 0.25 and nothing provided by then
#TRACE `Art 14(1) and (2) the controller must provide the data subject with the information within the time that Art 14(3) requires` TRUE (JUST FALSE) FALSE 0 TRUE 0.25 AT 0 WITH
    (WAITUNTIL 0.5)
-- FULFILLED: paragraph 5 (b) to (d) disapplies paragraphs 1 to 4
#TRACE `Art 14(1) and (2) the controller must provide the data subject with the information within the time that Art 14(3) requires` TRUE (JUST TRUE) FALSE 0 FALSE 0 AT 0 WITH
    (WAITUNTIL 2)
-- FULFILLED: the data were obtained from the data subject (Article 13)
#TRACE `Art 14(1) and (2) the controller must provide the data subject with the information within the time that Art 14(3) requires` FALSE (JUST FALSE) FALSE 0 FALSE 0 AT 0 WITH
    (WAITUNTIL 2)

§ `Art 14(4): further processing for another purpose`

-- no further processing intended: 'Where' fails
#ASSERT `Art 14(4) the controller provides the data subject, prior to the further processing, with information on the other purpose and any relevant further information` FALSE (JUST FALSE) FALSE FALSE FALSE FALSE FALSE EQUALS JUST `the duty does not arise`
-- paragraph 5 (b) to (d) disapplies paragraphs 1 to 4
#ASSERT `Art 14(4) the controller provides the data subject, prior to the further processing, with information on the other purpose and any relevant further information` TRUE (JUST TRUE) FALSE FALSE FALSE FALSE FALSE EQUALS JUST `the duty does not arise`
-- both kinds provided before the further processing
#ASSERT `Art 14(4) the controller provides the data subject, prior to the further processing, with information on the other purpose and any relevant further information` TRUE (JUST FALSE) TRUE TRUE TRUE FALSE FALSE EQUALS JUST `the duty arises and is met`
-- provided too late
#ASSERT `Art 14(4) the controller provides the data subject, prior to the further processing, with information on the other purpose and any relevant further information` TRUE (JUST FALSE) TRUE TRUE FALSE FALSE FALSE EQUALS JUST `the duty arises and is not met`
-- no information on the other purpose
#ASSERT `Art 14(4) the controller provides the data subject, prior to the further processing, with information on the other purpose and any relevant further information` TRUE (JUST FALSE) FALSE TRUE TRUE FALSE FALSE EQUALS JUST `the duty arises and is not met`
-- no relevant further information
#ASSERT `Art 14(4) the controller provides the data subject, prior to the further processing, with information on the other purpose and any relevant further information` TRUE (JUST FALSE) TRUE FALSE TRUE FALSE FALSE EQUALS JUST `the duty arises and is not met`
-- the data subject already has both kinds of information
#ASSERT `Art 14(4) the controller provides the data subject, prior to the further processing, with information on the other purpose and any relevant further information` TRUE (JUST FALSE) FALSE FALSE FALSE TRUE TRUE EQUALS JUST `the duty arises and is met`
-- unmet, and paragraph 5 is not answered: the text does not say
#ASSERT `Art 14(4) the controller provides the data subject, prior to the further processing, with information on the other purpose and any relevant further information` TRUE NOTHING FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- met whatever paragraph 5 says
#ASSERT `Art 14(4) the controller provides the data subject, prior to the further processing, with information on the other purpose and any relevant further information` TRUE NOTHING TRUE TRUE TRUE FALSE FALSE EQUALS JUST `the duty arises and is met`
-- FULFILLED: provided before the further processing begins at 5
#TRACE `Art 14(4) the controller must provide the data subject, prior to the further processing, with information on the other purpose and any relevant further information` TRUE (JUST FALSE) 5 AT 0 WITH
    PARTY controller DOES `Art 14(4) provide the data subject, prior to the further processing, with information on the other purpose and any relevant further information` AT 4
-- BREACH: provided after the further processing began
#TRACE `Art 14(4) the controller must provide the data subject, prior to the further processing, with information on the other purpose and any relevant further information` TRUE (JUST FALSE) 5 AT 0 WITH
    PARTY controller DOES `Art 14(4) provide the data subject, prior to the further processing, with information on the other purpose and any relevant further information` AT 6
-- BREACH: nothing provided by the time the further processing begins
#TRACE `Art 14(4) the controller must provide the data subject, prior to the further processing, with information on the other purpose and any relevant further information` TRUE (JUST FALSE) 5 AT 0 WITH
    (WAITUNTIL 6)
-- FULFILLED: paragraph 5 (b) to (d) disapplies paragraph 4
#TRACE `Art 14(4) the controller must provide the data subject, prior to the further processing, with information on the other purpose and any relevant further information` TRUE (JUST TRUE) 5 AT 0 WITH
    (WAITUNTIL 6)
-- FULFILLED: no further processing intended
#TRACE `Art 14(4) the controller must provide the data subject, prior to the further processing, with information on the other purpose and any relevant further information` FALSE (JUST FALSE) 5 AT 0 WITH
    (WAITUNTIL 6)

§ `Art 14(5): where and insofar as paragraphs 1 to 4 do not apply`

-- the data subject already has the information
#ASSERT `Art 14(5)(a) paragraphs 1 to 4 do not apply where and insofar as the data subject already has the information` TRUE EQUALS JUST TRUE
-- the data subject does not have it: 'where' fails
#ASSERT `Art 14(5)(a) paragraphs 1 to 4 do not apply where and insofar as the data subject already has the information` FALSE EQUALS JUST FALSE
-- the provision proves impossible
#ASSERT `Art 14(5)(b) paragraphs 1 to 4 do not apply where and insofar as the provision of the information proves impossible or would involve a disproportionate effort` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- the provision would involve a disproportionate effort
#ASSERT `Art 14(5)(b) paragraphs 1 to 4 do not apply where and insofar as the provision of the information proves impossible or would involve a disproportionate effort` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- the obligation is likely to render impossible or seriously impair the objectives of the processing
#ASSERT `Art 14(5)(b) paragraphs 1 to 4 do not apply where and insofar as the provision of the information proves impossible or would involve a disproportionate effort` FALSE FALSE TRUE TRUE EQUALS JUST TRUE
-- research purposes subject to Article 89(1) alone: 'in particular' gives an example, not a ground of its own
#ASSERT `Art 14(5)(b) paragraphs 1 to 4 do not apply where and insofar as the provision of the information proves impossible or would involve a disproportionate effort` FALSE FALSE FALSE TRUE EQUALS JUST FALSE
-- none of the grounds: 'where and insofar as' fails
#ASSERT `Art 14(5)(b) paragraphs 1 to 4 do not apply where and insofar as the provision of the information proves impossible or would involve a disproportionate effort` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- point (b) applies and the controller took appropriate measures
#ASSERT `Art 14(5)(b) the controller takes appropriate measures to protect the data subject's rights and freedoms and legitimate interests, including making the information publicly available` (JUST TRUE) TRUE EQUALS JUST `the duty arises and is met`
-- point (b) applies and no measures were taken: 'In such cases the controller shall take appropriate measures'
#ASSERT `Art 14(5)(b) the controller takes appropriate measures to protect the data subject's rights and freedoms and legitimate interests, including making the information publicly available` (JUST TRUE) FALSE EQUALS JUST `the duty arises and is not met`
-- point (b) does not apply: 'In such cases' is not met, the text is silent
#ASSERT `Art 14(5)(b) the controller takes appropriate measures to protect the data subject's rights and freedoms and legitimate interests, including making the information publicly available` (JUST FALSE) TRUE EQUALS NOTHING
-- point (b) not answered
#ASSERT `Art 14(5)(b) the controller takes appropriate measures to protect the data subject's rights and freedoms and legitimate interests, including making the information publicly available` NOTHING FALSE EQUALS NOTHING
-- FULFILLED: the measures are taken
#TRACE `Art 14(5)(b) the controller must take appropriate measures to protect the data subject's rights and freedoms and legitimate interests` (JUST TRUE) AT 0 WITH
    PARTY controller DOES `Art 14(5)(b) take appropriate measures to protect the data subject's rights and freedoms and legitimate interests, including making the information publicly available` AT 1
-- no act: the obligation stands; no breach is possible (no time limit)
#TRACE `Art 14(5)(b) the controller must take appropriate measures to protect the data subject's rights and freedoms and legitimate interests` (JUST TRUE) AT 0 WITH
    (WAITUNTIL 1000)
-- FULFILLED: point (b) does not apply
#TRACE `Art 14(5)(b) the controller must take appropriate measures to protect the data subject's rights and freedoms and legitimate interests` (JUST FALSE) AT 0 WITH
    (WAITUNTIL 1000)
-- expressly laid down by Union or Member State law to which the controller is subject, which provides appropriate measures
#ASSERT `Art 14(5)(c) paragraphs 1 to 4 do not apply where and insofar as obtaining or disclosure is expressly laid down by Union or Member State law` TRUE TRUE EQUALS JUST TRUE
-- laid down, but the law does not provide appropriate measures: 'and which provides appropriate measures'
#ASSERT `Art 14(5)(c) paragraphs 1 to 4 do not apply where and insofar as obtaining or disclosure is expressly laid down by Union or Member State law` TRUE FALSE EQUALS JUST FALSE
-- not laid down by such law
#ASSERT `Art 14(5)(c) paragraphs 1 to 4 do not apply where and insofar as obtaining or disclosure is expressly laid down by Union or Member State law` FALSE TRUE EQUALS JUST FALSE
-- neither
#ASSERT `Art 14(5)(c) paragraphs 1 to 4 do not apply where and insofar as obtaining or disclosure is expressly laid down by Union or Member State law` FALSE FALSE EQUALS JUST FALSE
-- the data must remain confidential subject to professional secrecy
#ASSERT `Art 14(5)(d) paragraphs 1 to 4 do not apply where the personal data must remain confidential subject to an obligation of professional secrecy` TRUE EQUALS JUST TRUE
-- no obligation of professional secrecy: 'where' fails
#ASSERT `Art 14(5)(d) paragraphs 1 to 4 do not apply where the personal data must remain confidential subject to an obligation of professional secrecy` FALSE EQUALS JUST FALSE
-- point (b) holds
#ASSERT `Art 14(5) points (b) to (d) disapply paragraphs 1 to 4` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
-- point (c) holds
#ASSERT `Art 14(5) points (b) to (d) disapply paragraphs 1 to 4` (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
-- point (d) holds
#ASSERT `Art 14(5) points (b) to (d) disapply paragraphs 1 to 4` (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
-- none holds: 'where and insofar as' fails in each
#ASSERT `Art 14(5) points (b) to (d) disapply paragraphs 1 to 4` (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
-- none holds and point (d) is not answered: not covered
#ASSERT `Art 14(5) points (b) to (d) disapply paragraphs 1 to 4` (JUST FALSE) (JUST FALSE) NOTHING EQUALS NOTHING
-- point (b) is not answered
#ASSERT `Art 14(5) points (b) to (d) disapply paragraphs 1 to 4` NOTHING (JUST FALSE) (JUST FALSE) EQUALS NOTHING
-- point (c) holds whatever the others are
#ASSERT `Art 14(5) points (b) to (d) disapply paragraphs 1 to 4` NOTHING (JUST TRUE) NOTHING EQUALS JUST TRUE

§ `Art 14(1): is this item owed? (one item at a time, R10)`

-- (a) the identity of the controller: owed
#ASSERT `Art 14(1) the controller owes the data subject the item of information` TRUE (JUST FALSE) `Art 14(1)(a) the identity and the contact details of the controller` FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- (c) the purposes: owed
#ASSERT `Art 14(1) the controller owes the data subject the item of information` TRUE (JUST FALSE) `Art 14(1)(c) the purposes of the processing for which the personal data are intended` FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- (c) the legal basis: owed
#ASSERT `Art 14(1) the controller owes the data subject the item of information` TRUE (JUST FALSE) `Art 14(1)(c) the legal basis for the processing` FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- (d) the categories of personal data: owed
#ASSERT `Art 14(1) the controller owes the data subject the item of information` TRUE (JUST FALSE) `Art 14(1)(d) the categories of personal data concerned` FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- (a) the representative: the controller has none
#ASSERT `Art 14(1) the controller owes the data subject the item of information` TRUE (JUST FALSE) `Art 14(1)(a) the identity and the contact details of the controller's representative` FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- (a) the representative: there is one
#ASSERT `Art 14(1) the controller owes the data subject the item of information` TRUE (JUST FALSE) `Art 14(1)(a) the identity and the contact details of the controller's representative` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- (b) no officer designated
#ASSERT `Art 14(1) the controller owes the data subject the item of information` TRUE (JUST FALSE) `Art 14(1)(b) the contact details of the data protection officer` FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- (b) an officer was designated
#ASSERT `Art 14(1) the controller owes the data subject the item of information` TRUE (JUST FALSE) `Art 14(1)(b) the contact details of the data protection officer` FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- (e) 'if any': no recipients
#ASSERT `Art 14(1) the controller owes the data subject the item of information` TRUE (JUST FALSE) `Art 14(1)(e) the recipients or categories of recipients of the personal data` FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- (e) there are recipients
#ASSERT `Art 14(1) the controller owes the data subject the item of information` TRUE (JUST FALSE) `Art 14(1)(e) the recipients or categories of recipients of the personal data` FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- (f) 'where applicable': no transfer is intended
#ASSERT `Art 14(1) the controller owes the data subject the item of information` TRUE (JUST FALSE) `Art 14(1)(f) the intended transfer to a recipient in a third country or international organisation and the adequacy decision or the safeguards` FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- (f) a transfer is intended
#ASSERT `Art 14(1) the controller owes the data subject the item of information` TRUE (JUST FALSE) `Art 14(1)(f) the intended transfer to a recipient in a third country or international organisation and the adequacy decision or the safeguards` FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
-- the data were obtained from the data subject: 'Where personal data have not been obtained from the data subject' fails
#ASSERT `Art 14(1) the controller owes the data subject the item of information` FALSE (JUST FALSE) `Art 14(1)(a) the identity and the contact details of the controller` FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- paragraph 5 (b) to (d) disapplies paragraphs 1 to 4: 'shall not apply'
#ASSERT `Art 14(1) the controller owes the data subject the item of information` TRUE (JUST TRUE) `Art 14(1)(a) the identity and the contact details of the controller` FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- paragraph 5 is not answered: it may take the duty away
#ASSERT `Art 14(1) the controller owes the data subject the item of information` TRUE NOTHING `Art 14(1)(a) the identity and the contact details of the controller` FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- the data subject already has the information: paragraph 5(a)
#ASSERT `Art 14(1) the controller owes the data subject the item of information` TRUE (JUST FALSE) `Art 14(1)(a) the identity and the contact details of the controller` FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
-- (b) not owed whatever paragraph 5 says: no officer
#ASSERT `Art 14(1) the controller owes the data subject the item of information` TRUE NOTHING `Art 14(1)(b) the contact details of the data protection officer` FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE

§ `Art 14(2): is this item owed? (one item at a time, R10)`

-- (a) the storage period: owed
#ASSERT `Art 14(2) the controller owes the data subject the item of information` TRUE (JUST FALSE) (JUST FALSE) `Art 14(2)(a) the period for which the personal data will be stored, or the criteria used to determine that period` FALSE FALSE FALSE EQUALS JUST TRUE
-- (c) the rights: owed
#ASSERT `Art 14(2) the controller owes the data subject the item of information` TRUE (JUST FALSE) (JUST FALSE) `Art 14(2)(c) the existence of the rights of access, rectification, erasure, restriction, objection and data portability` FALSE FALSE FALSE EQUALS JUST TRUE
-- (e) the complaint: owed
#ASSERT `Art 14(2) the controller owes the data subject the item of information` TRUE (JUST FALSE) (JUST FALSE) `Art 14(2)(e) the right to lodge a complaint with a supervisory authority` FALSE FALSE FALSE EQUALS JUST TRUE
-- (f) the source: owed
#ASSERT `Art 14(2) the controller owes the data subject the item of information` TRUE (JUST FALSE) (JUST FALSE) `Art 14(2)(f) the source from which the personal data originate and, if applicable, whether it came from publicly accessible sources` FALSE FALSE FALSE EQUALS JUST TRUE
-- (b) 'where the processing is based on point (f) of Article 6(1)': it is
#ASSERT `Art 14(2) the controller owes the data subject the item of information` TRUE (JUST FALSE) (JUST TRUE) `Art 14(2)(b) the legitimate interests pursued by the controller or by a third party` FALSE FALSE FALSE EQUALS JUST TRUE
-- (b) not owed: the processing is not based on point (f)
#ASSERT `Art 14(2) the controller owes the data subject the item of information` TRUE (JUST FALSE) (JUST FALSE) `Art 14(2)(b) the legitimate interests pursued by the controller or by a third party` FALSE FALSE FALSE EQUALS JUST FALSE
-- (b): P1 does not answer whether the processing is based on point (f)
#ASSERT `Art 14(2) the controller owes the data subject the item of information` TRUE (JUST FALSE) NOTHING `Art 14(2)(b) the legitimate interests pursued by the controller or by a third party` FALSE FALSE FALSE EQUALS NOTHING
-- (d) the processing is not based on consent
#ASSERT `Art 14(2) the controller owes the data subject the item of information` TRUE (JUST FALSE) (JUST FALSE) `Art 14(2)(d) the existence of the right to withdraw consent at any time, without affecting the lawfulness of processing before its withdrawal` FALSE FALSE FALSE EQUALS JUST FALSE
-- (d) the processing is based on consent
#ASSERT `Art 14(2) the controller owes the data subject the item of information` TRUE (JUST FALSE) (JUST FALSE) `Art 14(2)(d) the existence of the right to withdraw consent at any time, without affecting the lawfulness of processing before its withdrawal` TRUE FALSE FALSE EQUALS JUST TRUE
-- (g) no automated decision-making referred to in Article 22(1) and (4)
#ASSERT `Art 14(2) the controller owes the data subject the item of information` TRUE (JUST FALSE) (JUST FALSE) `Art 14(2)(g) the existence of automated decision-making, including profiling, and meaningful information about the logic involved, the significance and the envisaged consequences` FALSE FALSE FALSE EQUALS JUST FALSE
-- (g) there is such decision-making
#ASSERT `Art 14(2) the controller owes the data subject the item of information` TRUE (JUST FALSE) (JUST FALSE) `Art 14(2)(g) the existence of automated decision-making, including profiling, and meaningful information about the logic involved, the significance and the envisaged consequences` FALSE TRUE FALSE EQUALS JUST TRUE
-- the data were obtained from the data subject: outside the paragraph
#ASSERT `Art 14(2) the controller owes the data subject the item of information` FALSE (JUST FALSE) (JUST FALSE) `Art 14(2)(a) the period for which the personal data will be stored, or the criteria used to determine that period` FALSE FALSE FALSE EQUALS NOTHING
-- paragraph 5 (b) to (d) disapplies paragraphs 1 to 4
#ASSERT `Art 14(2) the controller owes the data subject the item of information` TRUE (JUST TRUE) (JUST FALSE) `Art 14(2)(a) the period for which the personal data will be stored, or the criteria used to determine that period` FALSE FALSE FALSE EQUALS JUST FALSE
-- paragraph 5 is not answered
#ASSERT `Art 14(2) the controller owes the data subject the item of information` TRUE NOTHING (JUST FALSE) `Art 14(2)(a) the period for which the personal data will be stored, or the criteria used to determine that period` FALSE FALSE FALSE EQUALS NOTHING
-- the data subject already has the information
#ASSERT `Art 14(2) the controller owes the data subject the item of information` TRUE (JUST FALSE) (JUST FALSE) `Art 14(2)(a) the period for which the personal data will be stored, or the criteria used to determine that period` FALSE FALSE TRUE EQUALS JUST FALSE
