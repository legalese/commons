IMPORT prelude
IMPORT `gdpr-core`
IMPORT `gdpr-core-2`
IMPORT `K2-seat-controller`

-- ============================================================================
-- K2-cases-seat-controller.l4 -- cases for the questions of K2-seat-controller.l4, with the facts a real person in the
-- seat would state.  Every expected value was written by hand from the text of the provision named in the
-- comment above its group of cases (notes/gen-seats.py holds them); none was copied from an output.
-- ============================================================================


§§ `Article 1`

-- 1(3): Art 1(3) the restriction or prohibition of the free movement of personal data within the Union for reasons connected with data protection is barred
#ASSERT `Under Article 1(3), as a controller, is a restriction or prohibition of the free movement of the personal data I process within the Union barred when its reason is the protection of natural persons` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under Article 1(3), as a controller, is a restriction or prohibition of the free movement of the personal data I process within the Union barred when its reason is the protection of natural persons` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `Under Article 1(3), as a controller, is a restriction or prohibition of the free movement of the personal data I process within the Union barred when its reason is the protection of natural persons` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `Under Article 1(3), as a controller, is a restriction or prohibition of the free movement of the personal data I process within the Union barred when its reason is the protection of natural persons` TRUE FALSE TRUE EQUALS NOTHING


§§ `Article 2(3) and (4)`

-- 2(3)a: Art 2(3) Regulation (EC) No 45/2001 applies to the processing, where it is by the Union institutions, bodies, offices or agencies
#ASSERT `Under Article 2(3), as a controller, does Regulation (EC) No 45/2001 apply to my processing of personal data` TRUE EQUALS JUST TRUE
#ASSERT `Under Article 2(3), as a controller, does Regulation (EC) No 45/2001 apply to my processing of personal data` FALSE EQUALS NOTHING

-- 2(3)b: Art 2(3) this Regulation applies to the processing, where it is by the Union institutions, bodies, offices or agencies
#ASSERT `Under Article 2(3), as a controller, does this Regulation apply to my processing of personal data, where I am a Union institution, body, office or agency` TRUE EQUALS JUST FALSE
#ASSERT `Under Article 2(3), as a controller, does this Regulation apply to my processing of personal data, where I am a Union institution, body, office or agency` FALSE EQUALS NOTHING

-- 2(4): Art 2(4) this Regulation is without prejudice to the application of Directive 2000/31/EC
#ASSERT `Under Article 2(4), as a controller, is this Regulation without prejudice to the application of Directive 2000/31/EC` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under Article 2(4), as a controller, is this Regulation without prejudice to the application of Directive 2000/31/EC` FALSE TRUE EQUALS JUST TRUE
#ASSERT `Under Article 2(4), as a controller, is this Regulation without prejudice to the application of Directive 2000/31/EC` FALSE FALSE EQUALS NOTHING


§§ `Article 3`

-- 3(1): Art 3(1) the territorial limb: the processing is in the context of the activities of an establishment of a controller or a processor in the Union
#ASSERT `Under Article 3(1), as a controller, is the establishment limb met for my processing of personal data` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under Article 3(1), as a controller, is the establishment limb met for my processing of personal data` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under Article 3(1), as a controller, is the establishment limb met for my processing of personal data` FALSE TRUE EQUALS NOTHING

-- 3(2): Art 3(2) the territorial limb: the processing is of data subjects in the Union by a controller or processor not established in the Union, and the activities are related to offering goods or services or to monitoring behaviour
#ASSERT `Under Article 3(2), as a controller, is the limb of data subjects in the Union and a controller or processor not established there met for my processing of personal data` TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under Article 3(2), as a controller, is the limb of data subjects in the Union and a controller or processor not established there met for my processing of personal data` TRUE TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under Article 3(2), as a controller, is the limb of data subjects in the Union and a controller or processor not established there met for my processing of personal data` TRUE TRUE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under Article 3(2), as a controller, is the limb of data subjects in the Union and a controller or processor not established there met for my processing of personal data` TRUE TRUE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Under Article 3(2), as a controller, is the limb of data subjects in the Union and a controller or processor not established there met for my processing of personal data` FALSE TRUE TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `Under Article 3(2), as a controller, is the limb of data subjects in the Union and a controller or processor not established there met for my processing of personal data` TRUE FALSE TRUE FALSE TRUE TRUE EQUALS NOTHING

-- 3(3): Art 3(3) the territorial limb: the processing is by a controller not established in the Union, in a place where Member State law applies by virtue of public international law
#ASSERT `Under Article 3(3), as a controller, is the limb of a place where Member State law applies by virtue of public international law met for my processing of personal data` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under Article 3(3), as a controller, is the limb of a place where Member State law applies by virtue of public international law met for my processing of personal data` TRUE FALSE EQUALS NOTHING
#ASSERT `Under Article 3(3), as a controller, is the limb of a place where Member State law applies by virtue of public international law met for my processing of personal data` FALSE TRUE EQUALS NOTHING

-- 3: Art 3 this Regulation applies to the processing of personal data
#ASSERT `Under Article 3, as a controller, does this Regulation apply to my processing of personal data` `K2 controller answer: yes` FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under Article 3, as a controller, does this Regulation apply to my processing of personal data` `K2 controller answer: yes` FALSE FALSE FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under Article 3, as a controller, does this Regulation apply to my processing of personal data` `K2 controller answer: yes` FALSE FALSE FALSE TRUE TRUE FALSE FALSE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under Article 3, as a controller, does this Regulation apply to my processing of personal data` `K2 controller answer: yes` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under Article 3, as a controller, does this Regulation apply to my processing of personal data` `K2 controller answer: yes` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `Under Article 3, as a controller, does this Regulation apply to my processing of personal data` `K2 controller answer: yes` TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Under Article 3, as a controller, does this Regulation apply to my processing of personal data` `K2 controller answer: no` FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Under Article 3, as a controller, does this Regulation apply to my processing of personal data` `K2 controller answer: not sure` FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING


§§ `Article 4`

-- 4lead: Art 4 lead-in the definitions of Article 4 apply to the term
#ASSERT `Under Article 4, as a controller, do the definitions of Article 4 apply to a term I use` TRUE EQUALS JUST TRUE
#ASSERT `Under Article 4, as a controller, do the definitions of Article 4 apply to a term I use` FALSE EQUALS NOTHING

-- 4(3): Art 4(3) the act is a restriction of processing
#ASSERT `Under Article 4(3), as a controller, is what I did to stored personal data a restriction of processing` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under Article 4(3), as a controller, is what I did to stored personal data a restriction of processing` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Under Article 4(3), as a controller, is what I did to stored personal data a restriction of processing` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Under Article 4(3), as a controller, is what I did to stored personal data a restriction of processing` TRUE TRUE FALSE EQUALS JUST FALSE

-- 4(4): Art 4(4) the processing is profiling
#ASSERT `Under Article 4(4), as a controller, is my processing profiling` TRUE TRUE TRUE `Art 4(4) economic situation` TRUE EQUALS JUST TRUE
#ASSERT `Under Article 4(4), as a controller, is my processing profiling` TRUE TRUE TRUE `Art 4(4) some other personal aspect` TRUE EQUALS JUST TRUE
#ASSERT `Under Article 4(4), as a controller, is my processing profiling` TRUE FALSE TRUE `Art 4(4) behaviour` TRUE EQUALS JUST FALSE
#ASSERT `Under Article 4(4), as a controller, is my processing profiling` TRUE TRUE FALSE `Art 4(4) location` TRUE EQUALS JUST FALSE
#ASSERT `Under Article 4(4), as a controller, is my processing profiling` FALSE TRUE TRUE `Art 4(4) health` TRUE EQUALS JUST FALSE

-- 4(5): Art 4(5) the processing is pseudonymisation
#ASSERT `Under Article 4(5), as a controller, is my processing pseudonymisation` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under Article 4(5), as a controller, is my processing pseudonymisation` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Under Article 4(5), as a controller, is my processing pseudonymisation` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Under Article 4(5), as a controller, is my processing pseudonymisation` TRUE FALSE TRUE TRUE EQUALS JUST FALSE

-- 4(9)a: Art 4(9) the body is a recipient
#ASSERT `Under Article 4(9), as a controller, is the body I disclose personal data to a recipient` `legal person` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under Article 4(9), as a controller, is the body I disclose personal data to a recipient` `public authority` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Under Article 4(9), as a controller, is the body I disclose personal data to a recipient` `legal person` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Under Article 4(9), as a controller, is the body I disclose personal data to a recipient` `public authority` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under Article 4(9), as a controller, is the body I disclose personal data to a recipient` `agency` TRUE TRUE TRUE TRUE EQUALS JUST TRUE

-- 4(9)b: Art 4(9) the processing by the public authority of the data it receives in a particular inquiry is in compliance with the applicable data protection rules
#ASSERT `Under Article 4(9), as a controller, is the processing by a public authority of the personal data it received from me in a particular inquiry in compliance with the applicable data protection rules` `public authority` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under Article 4(9), as a controller, is the processing by a public authority of the personal data it received from me in a particular inquiry in compliance with the applicable data protection rules` `public authority` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Under Article 4(9), as a controller, is the processing by a public authority of the personal data it received from me in a particular inquiry in compliance with the applicable data protection rules` `legal person` TRUE TRUE FALSE EQUALS NOTHING

-- 4(10): Art 4(10) the body is a third party
#ASSERT `Under Article 4(10), as a controller, is the body a third party` `legal person` FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under Article 4(10), as a controller, is the body a third party` `natural person` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Under Article 4(10), as a controller, is the body a third party` `legal person` FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Under Article 4(10), as a controller, is the body a third party` `legal person` FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Under Article 4(10), as a controller, is the body a third party` `natural person` FALSE FALSE FALSE TRUE EQUALS JUST FALSE

-- 4(11): Art 4(11) the indication is the consent of the data subject
#ASSERT `Under Article 4(11), as a controller, is what the data subject gave me consent` TRUE TRUE TRUE TRUE TRUE `Art 4(11) by a statement` TRUE EQUALS JUST TRUE
#ASSERT `Under Article 4(11), as a controller, is what the data subject gave me consent` TRUE TRUE TRUE TRUE TRUE `Art 4(11) by a clear affirmative action` TRUE EQUALS JUST TRUE
#ASSERT `Under Article 4(11), as a controller, is what the data subject gave me consent` TRUE TRUE TRUE TRUE TRUE `Art 4(11) in some other way, with no statement and no clear affirmative action` TRUE EQUALS JUST FALSE
#ASSERT `Under Article 4(11), as a controller, is what the data subject gave me consent` TRUE TRUE FALSE TRUE TRUE `Art 4(11) by a clear affirmative action` TRUE EQUALS JUST FALSE
#ASSERT `Under Article 4(11), as a controller, is what the data subject gave me consent` FALSE TRUE TRUE TRUE TRUE `Art 4(11) by a statement` TRUE EQUALS JUST FALSE
#ASSERT `Under Article 4(11), as a controller, is what the data subject gave me consent` TRUE TRUE TRUE TRUE TRUE `Art 4(11) by a statement` FALSE EQUALS JUST FALSE

-- 4(12): Art 4(12) the incident is a personal data breach
#ASSERT `Under Article 4(12), as a controller, is the incident a personal data breach` TRUE `Art 4(12) unauthorised access to personal data` TRUE EQUALS JUST TRUE
#ASSERT `Under Article 4(12), as a controller, is the incident a personal data breach` TRUE `Art 4(12) accidental loss of personal data` TRUE EQUALS JUST TRUE
#ASSERT `Under Article 4(12), as a controller, is the incident a personal data breach` TRUE `Art 4(12) some other consequence` TRUE EQUALS JUST FALSE
#ASSERT `Under Article 4(12), as a controller, is the incident a personal data breach` FALSE `Art 4(12) unauthorised disclosure of personal data` TRUE EQUALS JUST FALSE

-- 4(13): Art 4(13) the data are genetic data
#ASSERT `Under Article 4(13), as a controller, are the data genetic data` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under Article 4(13), as a controller, are the data genetic data` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under Article 4(13), as a controller, are the data genetic data` TRUE FALSE TRUE TRUE EQUALS JUST FALSE

-- 4(14): Art 4(14) the data are biometric data
#ASSERT `Under Article 4(14), as a controller, are the data biometric data` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under Article 4(14), as a controller, are the data biometric data` TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Under Article 4(14), as a controller, are the data biometric data` TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE

-- 4(15): Art 4(15) the data are data concerning health
#ASSERT `Under Article 4(15), as a controller, are the data data concerning health` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Under Article 4(15), as a controller, are the data data concerning health` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under Article 4(15), as a controller, are the data data concerning health` TRUE TRUE TRUE FALSE EQUALS JUST FALSE

-- 4(13-15): Art 4(13) to (15) the category of Article 9(1) that the data fall in by these definitions
#ASSERT `Under Article 4(13) to (15), as a controller, which category of Article 9(1) do the data fall in by the definitions of genetic data, biometric data and data concerning health` `K2 controller answer: yes` `K2 controller answer: no` FALSE `K2 controller answer: no` EQUALS JUST `Art 9(1) genetic data`
#ASSERT `Under Article 4(13) to (15), as a controller, which category of Article 9(1) do the data fall in by the definitions of genetic data, biometric data and data concerning health` `K2 controller answer: no` `K2 controller answer: yes` TRUE `K2 controller answer: no` EQUALS JUST `Art 9(1) biometric data for the purpose of uniquely identifying a natural person`
#ASSERT `Under Article 4(13) to (15), as a controller, which category of Article 9(1) do the data fall in by the definitions of genetic data, biometric data and data concerning health` `K2 controller answer: no` `K2 controller answer: yes` FALSE `K2 controller answer: no` EQUALS JUST `Art 9(1) biometric data not for the purpose of uniquely identifying a natural person`
#ASSERT `Under Article 4(13) to (15), as a controller, which category of Article 9(1) do the data fall in by the definitions of genetic data, biometric data and data concerning health` `K2 controller answer: no` `K2 controller answer: no` FALSE `K2 controller answer: yes` EQUALS JUST `Art 9(1) data concerning health`
#ASSERT `Under Article 4(13) to (15), as a controller, which category of Article 9(1) do the data fall in by the definitions of genetic data, biometric data and data concerning health` `K2 controller answer: yes` `K2 controller answer: no` FALSE `K2 controller answer: yes` EQUALS JUST `Art 9(1) genetic data`
#ASSERT `Under Article 4(13) to (15), as a controller, which category of Article 9(1) do the data fall in by the definitions of genetic data, biometric data and data concerning health` `K2 controller answer: no` `K2 controller answer: no` FALSE `K2 controller answer: no` EQUALS NOTHING
#ASSERT `Under Article 4(13) to (15), as a controller, which category of Article 9(1) do the data fall in by the definitions of genetic data, biometric data and data concerning health` `K2 controller answer: not sure` `K2 controller answer: not sure` FALSE `K2 controller answer: not sure` EQUALS NOTHING

-- 4(16)a: Art 4(16)(a) the main establishment of a controller
#ASSERT `Under Article 4(16)(a), as a controller, where is my main establishment` TRUE TRUE FALSE FALSE EQUALS JUST `Art 4(16)(a) the place of the controller's central administration in the Union`
#ASSERT `Under Article 4(16)(a), as a controller, where is my main establishment` TRUE TRUE TRUE TRUE EQUALS JUST `Art 4(16)(a) the establishment of the controller that took the decisions on the purposes and means`
#ASSERT `Under Article 4(16)(a), as a controller, where is my main establishment` FALSE TRUE FALSE FALSE EQUALS NOTHING

-- 4(16)b: Art 4(16)(b) the main establishment of a processor
#ASSERT `Under Article 4(16)(b), as a controller, where is the main establishment of my processor` TRUE TRUE FALSE FALSE EQUALS JUST `Art 4(16)(b) the place of the processor's central administration in the Union`
#ASSERT `Under Article 4(16)(b), as a controller, where is the main establishment of my processor` TRUE FALSE TRUE TRUE EQUALS JUST `Art 4(16)(b) the establishment of the processor in the Union where the main processing activities take place`
#ASSERT `Under Article 4(16)(b), as a controller, where is the main establishment of my processor` TRUE FALSE TRUE FALSE EQUALS NOTHING

-- 4(17): Art 4(17) the person is a representative
#ASSERT `Under Article 4(17), as a controller, is the person I designated a representative` `legal person` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under Article 4(17), as a controller, is the person I designated a representative` `legal person` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Under Article 4(17), as a controller, is the person I designated a representative` `public authority` TRUE TRUE TRUE EQUALS JUST FALSE

-- 4(18): Art 4(18) the body is an enterprise
#ASSERT `Under Article 4(18), as a controller, is my body an enterprise` `legal person` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under Article 4(18), as a controller, is my body an enterprise` `natural person` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Under Article 4(18), as a controller, is my body an enterprise` `other body` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under Article 4(18), as a controller, is my body an enterprise` `other body` TRUE FALSE FALSE EQUALS NOTHING

-- 4(19): Art 4(19) the set of undertakings is a group of undertakings
#ASSERT `Under Article 4(19), as a controller, is the set of undertakings I belong to a group of undertakings` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under Article 4(19), as a controller, is the set of undertakings I belong to a group of undertakings` TRUE FALSE EQUALS JUST FALSE

-- 4(20): Art 4(20) the policies are binding corporate rules
#ASSERT `Under Article 4(20), as a controller, are my data protection policies binding corporate rules` TRUE TRUE TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under Article 4(20), as a controller, are my data protection policies binding corporate rules` TRUE TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE

-- 4(21): Art 4(21) the body is a supervisory authority
#ASSERT `Under Article 4(21), as a controller, is the body a supervisory authority` `public authority` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under Article 4(21), as a controller, is the body a supervisory authority` `public authority` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Under Article 4(21), as a controller, is the body a supervisory authority` `other body` TRUE TRUE TRUE EQUALS JUST FALSE

-- 4(22): Art 4(22) the supervisory authority is a supervisory authority concerned by the processing
#ASSERT `Under Article 4(22), as a controller, is the supervisory authority a supervisory authority concerned by my processing` TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under Article 4(22), as a controller, is the supervisory authority a supervisory authority concerned by my processing` TRUE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Under Article 4(22), as a controller, is the supervisory authority a supervisory authority concerned by my processing` TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE

-- 4(23): Art 4(23) the processing is cross-border processing
#ASSERT `Under Article 4(23), as a controller, is my processing cross-border processing` TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under Article 4(23), as a controller, is my processing cross-border processing` TRUE FALSE FALSE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under Article 4(23), as a controller, is my processing cross-border processing` TRUE FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE

-- 4(24): Art 4(24) the objection is a relevant and reasoned objection
#ASSERT `Under Article 4(24), as a controller, is the objection to the draft decision about me a relevant and reasoned objection` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under Article 4(24), as a controller, is the objection to the draft decision about me a relevant and reasoned objection` TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Under Article 4(24), as a controller, is the objection to the draft decision about me a relevant and reasoned objection` FALSE TRUE TRUE FALSE FALSE EQUALS JUST FALSE

-- 4(25): Art 4(25) the service is an information society service
#ASSERT `Under Article 4(25), as a controller, is my service an information society service` TRUE EQUALS JUST TRUE
#ASSERT `Under Article 4(25), as a controller, is my service an information society service` FALSE EQUALS JUST FALSE

-- 4(26): Art 4(26) the body is an international organisation
#ASSERT `Under Article 4(26), as a controller, is the body I transfer personal data to an international organisation` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under Article 4(26), as a controller, is the body I transfer personal data to an international organisation` FALSE TRUE EQUALS JUST TRUE
#ASSERT `Under Article 4(26), as a controller, is the body I transfer personal data to an international organisation` FALSE FALSE EQUALS JUST FALSE
