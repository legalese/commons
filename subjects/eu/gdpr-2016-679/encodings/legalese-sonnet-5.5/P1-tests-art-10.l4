IMPORT prelude
IMPORT `gdpr-core`
IMPORT `P1-art-10`

-- ============================================================================
-- P1-tests-art-10.l4 -- tests of Art 10.  Expected values written from the text (src:137).
-- ============================================================================

§ `Art 10, first sentence`

-- criminal-conviction data, based on Art 6(1), under the control of official authority
#ASSERT `Art 10 the processing of personal data relating to criminal convictions and offences or related security measures meets the condition of Art 10` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- not under official control, but authorised by law that provides safeguards
#ASSERT `Art 10 the processing of personal data relating to criminal convictions and offences or related security measures meets the condition of Art 10` TRUE TRUE FALSE TRUE TRUE EQUALS JUST TRUE
-- authorised by law that provides no appropriate safeguards
#ASSERT `Art 10 the processing of personal data relating to criminal convictions and offences or related security measures meets the condition of Art 10` TRUE TRUE FALSE TRUE FALSE EQUALS JUST FALSE
-- neither under official control nor authorised: "only"
#ASSERT `Art 10 the processing of personal data relating to criminal convictions and offences or related security measures meets the condition of Art 10` TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- safeguards in a law that does not authorise the processing
#ASSERT `Art 10 the processing of personal data relating to criminal convictions and offences or related security measures meets the condition of Art 10` TRUE TRUE FALSE FALSE TRUE EQUALS JUST FALSE
-- not covered: other personal data, or processing not based on Art 6(1)
#ASSERT `Art 10 the processing of personal data relating to criminal convictions and offences or related security measures meets the condition of Art 10` FALSE TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `Art 10 the processing of personal data relating to criminal convictions and offences or related security measures meets the condition of Art 10` TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING

§ `Art 10, second sentence`

#ASSERT `Art 10 the comprehensive register of criminal convictions is kept only under the control of official authority` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 10 the comprehensive register of criminal convictions is kept only under the control of official authority` TRUE FALSE EQUALS JUST FALSE
-- not covered: a register that is not a comprehensive register of criminal convictions (a company's list of its own employees' convictions)
#ASSERT `Art 10 the comprehensive register of criminal convictions is kept only under the control of official authority` FALSE FALSE EQUALS NOTHING
#ASSERT `Art 10 the comprehensive register of criminal convictions is kept only under the control of official authority` FALSE TRUE EQUALS NOTHING
