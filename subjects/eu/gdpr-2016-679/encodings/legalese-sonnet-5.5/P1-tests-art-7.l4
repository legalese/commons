IMPORT prelude
IMPORT daydate
IMPORT `gdpr-core`
IMPORT `P1-art-7`

-- ============================================================================
-- P1-tests-art-7.l4 -- tests of Art 7.  Expected values written from the text (src:109-112).
-- ============================================================================

§ `Art 7(1): demonstrate consent`

-- processing based on consent and the controller can demonstrate it
#ASSERT `Art 7(1) the controller is able to demonstrate that the data subject has consented` TRUE TRUE EQUALS JUST `the duty arises and is met`
-- based on consent and the controller cannot demonstrate it
#ASSERT `Art 7(1) the controller is able to demonstrate that the data subject has consented` TRUE FALSE EQUALS JUST `the duty arises and is not met`
-- not based on consent ("Where processing is based on consent"): no duty, whatever the controller can show
#ASSERT `Art 7(1) the controller is able to demonstrate that the data subject has consented` FALSE FALSE EQUALS JUST `the duty does not arise`
#ASSERT `Art 7(1) the controller is able to demonstrate that the data subject has consented` FALSE TRUE EQUALS JUST `the duty does not arise`

-- the regulative form, traced
#TRACE `Art 7(1) the controller must be able to demonstrate that the data subject has consented` TRUE AT 0 WITH
    PARTY `controller` DOES `Art 7(1) demonstrate that the data subject has consented` AT 3
-- expected: FULFILLED
#TRACE `Art 7(1) the controller must be able to demonstrate that the data subject has consented` TRUE AT 0 WITH
    (WAITUNTIL 1000)
-- expected: the obligation still standing; never a breach, because the text gives no time limit
#TRACE `Art 7(1) the controller must be able to demonstrate that the data subject has consented` FALSE AT 0 WITH
    (WAITUNTIL 1000)
-- expected: FULFILLED (not based on consent)

§ `Art 7(2): first sentence`

#ASSERT `Art 7(2) the request for consent is presented clearly where consent is given in a written declaration that also concerns other matters` TRUE TRUE TRUE TRUE EQUALS JUST `the duty arises and is met`
-- each of the three requirements missing
#ASSERT `Art 7(2) the request for consent is presented clearly where consent is given in a written declaration that also concerns other matters` TRUE FALSE TRUE TRUE EQUALS JUST `the duty arises and is not met`
#ASSERT `Art 7(2) the request for consent is presented clearly where consent is given in a written declaration that also concerns other matters` TRUE TRUE FALSE TRUE EQUALS JUST `the duty arises and is not met`
#ASSERT `Art 7(2) the request for consent is presented clearly where consent is given in a written declaration that also concerns other matters` TRUE TRUE TRUE FALSE EQUALS JUST `the duty arises and is not met`
-- just outside: consent is not given in a declaration that also concerns other matters (a stand-alone consent form)
#ASSERT `Art 7(2) the request for consent is presented clearly where consent is given in a written declaration that also concerns other matters` FALSE FALSE FALSE FALSE EQUALS JUST `the duty does not arise`

§ `Art 7(2): second sentence`

-- a part of such a declaration that infringes this Regulation is not binding
#ASSERT `Art 7(2) the part of the declaration is binding` TRUE TRUE EQUALS JUST FALSE
-- not covered: a part that does not infringe (the text says nothing), and a part of some other document
#ASSERT `Art 7(2) the part of the declaration is binding` TRUE FALSE EQUALS NOTHING
#ASSERT `Art 7(2) the part of the declaration is binding` FALSE TRUE EQUALS NOTHING

§ `Art 7(3): withdrawal at any time`

-- consent given on 25 May 2018; withdrawn the same day, a day later, and eight years later: always
#ASSERT `Art 7(3) the data subject may withdraw his or her consent at any time` TRUE (Date 25 5 2018) (Date 25 5 2018) EQUALS JUST TRUE
#ASSERT `Art 7(3) the data subject may withdraw his or her consent at any time` TRUE (Date 25 5 2018) (Date 26 5 2018) EQUALS JUST TRUE
#ASSERT `Art 7(3) the data subject may withdraw his or her consent at any time` TRUE (Date 25 5 2018) (Date 25 5 2026) EQUALS JUST TRUE
-- not covered: no consent has been given, so there is nothing to withdraw
#ASSERT `Art 7(3) the data subject may withdraw his or her consent at any time` FALSE (Date 25 5 2018) (Date 25 5 2026) EQUALS NOTHING
-- the regulative form: a permission, never a breach
#TRACE `Art 7(3) the data subject may withdraw consent` AT 0 WITH
    PARTY `data subject` DOES `Art 7(3) withdraw consent` AT 400
-- expected: FULFILLED
#TRACE `Art 7(3) the data subject may withdraw consent` AT 0 WITH
    (WAITUNTIL 1000)
-- expected: the open permission is printed (`PARTY data subject MAY ... HENCE FULFILLED`): a permission not used stays open and is not a breach

-- second sentence: processing based on consent before the withdrawal is unaffected
#ASSERT `Art 7(3) the withdrawal of consent affects the lawfulness of the processing` TRUE TRUE EQUALS JUST FALSE
-- not covered: processing after the withdrawal, and processing not based on consent
#ASSERT `Art 7(3) the withdrawal of consent affects the lawfulness of the processing` TRUE FALSE EQUALS NOTHING
#ASSERT `Art 7(3) the withdrawal of consent affects the lawfulness of the processing` FALSE TRUE EQUALS NOTHING

-- third sentence: informed before giving consent
#ASSERT `Art 7(3) the data subject was informed of the right to withdraw consent prior to giving consent` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 7(3) the data subject was informed of the right to withdraw consent prior to giving consent` TRUE FALSE EQUALS JUST FALSE
-- not covered: no consent yet
#ASSERT `Art 7(3) the data subject was informed of the right to withdraw consent prior to giving consent` FALSE FALSE EQUALS NOTHING
#ASSERT `Art 7(3) the data subject was informed of the right to withdraw consent prior to giving consent` FALSE TRUE EQUALS NOTHING

-- fourth sentence: as easy to withdraw as to give
#ASSERT `Art 7(3) it is as easy to withdraw consent as to give it` TRUE EQUALS JUST TRUE
#ASSERT `Art 7(3) it is as easy to withdraw consent as to give it` FALSE EQUALS JUST FALSE

§ `Art 7(4): consent as a condition of a contract`

-- assessing, contract conditional on consent, processing not necessary for the contract: the matter is present
#ASSERT `Art 7(4) the conditionality of the contract on consent that is not necessary for it is a matter of which utmost account is taken` TRUE TRUE FALSE EQUALS JUST TRUE
-- not covered: the processing is necessary for the contract; the contract is not conditional ("inter alia" leaves the list open)
#ASSERT `Art 7(4) the conditionality of the contract on consent that is not necessary for it is a matter of which utmost account is taken` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `Art 7(4) the conditionality of the contract on consent that is not necessary for it is a matter of which utmost account is taken` TRUE FALSE FALSE EQUALS NOTHING
-- not an assessment of whether consent is freely given: "When assessing whether consent is freely given, ..." is a "when" gate, which counts as "where", so the answer is JUST FALSE (periods ruling (b) with ruling (c) of 2026-11-05; fork F7-1)
#ASSERT `Art 7(4) the conditionality of the contract on consent that is not necessary for it is a matter of which utmost account is taken` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 7(4) the conditionality of the contract on consent that is not necessary for it is a matter of which utmost account is taken` FALSE FALSE TRUE EQUALS JUST FALSE
