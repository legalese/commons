IMPORT prelude
IMPORT `gdpr-core`
IMPORT `P1-art-5`

-- ============================================================================
-- P1-tests-art-5.l4 -- tests of Art 5.  Expected values written from the text (src:78-85) before running.
-- JUST TRUE = the principle is met; JUST FALSE = it is not; `Duty outcome` for the gated duty;
-- NOTHING = not covered.
-- ============================================================================

§ `Art 5(1)(a): all three words, and each one missing`

#ASSERT `Art 5(1)(a) the personal data are processed lawfully, fairly and in a transparent manner in relation to the data subject` TRUE TRUE TRUE EQUALS JUST TRUE
-- unlawful, unfair, opaque: each alone breaks it
#ASSERT `Art 5(1)(a) the personal data are processed lawfully, fairly and in a transparent manner in relation to the data subject` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Art 5(1)(a) the personal data are processed lawfully, fairly and in a transparent manner in relation to the data subject` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Art 5(1)(a) the personal data are processed lawfully, fairly and in a transparent manner in relation to the data subject` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 5(1)(a) the personal data are processed lawfully, fairly and in a transparent manner in relation to the data subject` FALSE FALSE FALSE EQUALS JUST FALSE

§ `Art 5(1)(b): the second limb names four purposes; a fifth is outside it`

#ASSERT `Art 5(1)(b) the further processing is considered incompatible with the initial purposes` `Art 5(1)(b) archiving purposes in the public interest` TRUE EQUALS JUST FALSE
#ASSERT `Art 5(1)(b) the further processing is considered incompatible with the initial purposes` `Art 5(1)(b) scientific research purposes` TRUE EQUALS JUST FALSE
#ASSERT `Art 5(1)(b) the further processing is considered incompatible with the initial purposes` `Art 5(1)(b) historical research purposes` TRUE EQUALS JUST FALSE
#ASSERT `Art 5(1)(b) the further processing is considered incompatible with the initial purposes` `Art 5(1)(b) statistical purposes` TRUE EQUALS JUST FALSE
-- without compliance with Article 89(1) the deeming does not apply: the text says nothing about compatibility
#ASSERT `Art 5(1)(b) the further processing is considered incompatible with the initial purposes` `Art 5(1)(b) archiving purposes in the public interest` FALSE EQUALS NOTHING
#ASSERT `Art 5(1)(b) the further processing is considered incompatible with the initial purposes` `Art 5(1)(b) scientific research purposes` FALSE EQUALS NOTHING
#ASSERT `Art 5(1)(b) the further processing is considered incompatible with the initial purposes` `Art 5(1)(b) historical research purposes` FALSE EQUALS NOTHING
#ASSERT `Art 5(1)(b) the further processing is considered incompatible with the initial purposes` `Art 5(1)(b) statistical purposes` FALSE EQUALS NOTHING
-- outside: some other further purpose (marketing)
#ASSERT `Art 5(1)(b) the further processing is considered incompatible with the initial purposes` `Art 5(1)(b) some other purpose` TRUE EQUALS NOTHING

§ `Art 5(1)(b): the principle`

-- specified, explicit, legitimate, and no incompatible further processing
#ASSERT `Art 5(1)(b) the personal data are collected for specified, explicit and legitimate purposes and not further processed in a manner that is incompatible with those purposes` TRUE TRUE TRUE FALSE NOTHING EQUALS JUST TRUE
-- each of the three words missing
#ASSERT `Art 5(1)(b) the personal data are collected for specified, explicit and legitimate purposes and not further processed in a manner that is incompatible with those purposes` FALSE TRUE TRUE FALSE NOTHING EQUALS JUST FALSE
#ASSERT `Art 5(1)(b) the personal data are collected for specified, explicit and legitimate purposes and not further processed in a manner that is incompatible with those purposes` TRUE FALSE TRUE FALSE NOTHING EQUALS JUST FALSE
#ASSERT `Art 5(1)(b) the personal data are collected for specified, explicit and legitimate purposes and not further processed in a manner that is incompatible with those purposes` TRUE TRUE FALSE FALSE NOTHING EQUALS JUST FALSE
-- further processing incompatible with the initial purposes (the second limb says nothing)
#ASSERT `Art 5(1)(b) the personal data are collected for specified, explicit and legitimate purposes and not further processed in a manner that is incompatible with those purposes` TRUE TRUE TRUE TRUE NOTHING EQUALS JUST FALSE
-- further processing for scientific research in accordance with Article 89(1): "not be considered to be incompatible"
#ASSERT `Art 5(1)(b) the personal data are collected for specified, explicit and legitimate purposes and not further processed in a manner that is incompatible with those purposes` TRUE TRUE TRUE TRUE (JUST FALSE) EQUALS JUST TRUE
-- the same facts end to end through the second limb
#ASSERT `Art 5(1)(b) the personal data are collected for specified, explicit and legitimate purposes and not further processed in a manner that is incompatible with those purposes` TRUE TRUE TRUE TRUE (`Art 5(1)(b) the further processing is considered incompatible with the initial purposes` `Art 5(1)(b) statistical purposes` TRUE) EQUALS JUST TRUE
#ASSERT `Art 5(1)(b) the personal data are collected for specified, explicit and legitimate purposes and not further processed in a manner that is incompatible with those purposes` TRUE TRUE TRUE TRUE (`Art 5(1)(b) the further processing is considered incompatible with the initial purposes` `Art 5(1)(b) statistical purposes` FALSE) EQUALS JUST FALSE

§ `Art 5(1)(c): adequate, relevant, limited to what is necessary`

#ASSERT `Art 5(1)(c) the personal data are adequate, relevant and limited to what is necessary in relation to the purposes for which they are processed` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 5(1)(c) the personal data are adequate, relevant and limited to what is necessary in relation to the purposes for which they are processed` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Art 5(1)(c) the personal data are adequate, relevant and limited to what is necessary in relation to the purposes for which they are processed` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Art 5(1)(c) the personal data are adequate, relevant and limited to what is necessary in relation to the purposes for which they are processed` TRUE TRUE FALSE EQUALS JUST FALSE

§ `Art 5(1)(d): accuracy`

-- accurate, and keeping up to date is not necessary: met whether or not kept up to date
#ASSERT `Art 5(1)(d) the personal data are accurate and, where necessary, kept up to date` TRUE FALSE FALSE EQUALS JUST TRUE
-- accurate, necessary to keep up to date, and kept up to date
#ASSERT `Art 5(1)(d) the personal data are accurate and, where necessary, kept up to date` TRUE TRUE TRUE EQUALS JUST TRUE
-- boundary: necessary to keep up to date and not kept
#ASSERT `Art 5(1)(d) the personal data are accurate and, where necessary, kept up to date` TRUE TRUE FALSE EQUALS JUST FALSE
-- inaccurate: not met even if kept up to date (reading F5-2: the two limbs are separate duties)
#ASSERT `Art 5(1)(d) the personal data are accurate and, where necessary, kept up to date` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Art 5(1)(d) the personal data are accurate and, where necessary, kept up to date` FALSE FALSE FALSE EQUALS JUST FALSE

-- second limb: no inaccurate data: the step is required only for "personal data that are inaccurate, having regard to the purposes ...", a scope limit with no gate word, so the answer is NOTHING (periods ruling (c); fork F5-2, the other reading is `the duty does not arise`)
#ASSERT `Art 5(1)(d) every reasonable step is taken to ensure that inaccurate personal data are erased or rectified without delay` FALSE FALSE EQUALS NOTHING
#ASSERT `Art 5(1)(d) every reasonable step is taken to ensure that inaccurate personal data are erased or rectified without delay` FALSE TRUE EQUALS NOTHING
-- inaccurate data and every reasonable step taken
#ASSERT `Art 5(1)(d) every reasonable step is taken to ensure that inaccurate personal data are erased or rectified without delay` TRUE TRUE EQUALS JUST `the duty arises and is met`
-- inaccurate data and not every reasonable step taken
#ASSERT `Art 5(1)(d) every reasonable step is taken to ensure that inaccurate personal data are erased or rectified without delay` TRUE FALSE EQUALS JUST `the duty arises and is not met`

§ `Art 5(1)(e): storage limitation`

#ASSERT `Art 5(1)(e) the personal data may be stored for longer periods` `Art 5(1)(b) archiving purposes in the public interest` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 5(1)(e) the personal data may be stored for longer periods` `Art 5(1)(b) scientific research purposes` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 5(1)(e) the personal data may be stored for longer periods` `Art 5(1)(b) historical research purposes` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 5(1)(e) the personal data may be stored for longer periods` `Art 5(1)(b) statistical purposes` TRUE TRUE EQUALS JUST TRUE
-- another purpose: "solely for archiving purposes in the public interest, scientific or historical research purposes or statistical purposes" closes the list of purposes, so the text says no: JUST FALSE (a list closed with "solely"; grant ruling, limit 2; fork F5-3)
#ASSERT `Art 5(1)(e) the personal data may be stored for longer periods` `Art 5(1)(b) some other purpose` TRUE TRUE EQUALS JUST FALSE
#ASSERT `Art 5(1)(e) the personal data may be stored for longer periods` `Art 5(1)(b) some other purpose` FALSE FALSE EQUALS JUST FALSE
-- one of the four purposes but Article 89(1) is not met: the grant is limited by "in accordance with Article 89(1) subject to implementation of the appropriate technical and organisational measures", which is not a marker on which the text says no, so the answer is NOTHING (grant ruling of 2026-11-12, limit 1; fork F5-3)
#ASSERT `Art 5(1)(e) the personal data may be stored for longer periods` `Art 5(1)(b) scientific research purposes` FALSE TRUE EQUALS NOTHING
#ASSERT `Art 5(1)(e) the personal data may be stored for longer periods` `Art 5(1)(b) archiving purposes in the public interest` FALSE TRUE EQUALS NOTHING
-- one of the four purposes but the measures are not implemented: NOTHING
#ASSERT `Art 5(1)(e) the personal data may be stored for longer periods` `Art 5(1)(b) scientific research purposes` TRUE FALSE EQUALS NOTHING
#ASSERT `Art 5(1)(e) the personal data may be stored for longer periods` `Art 5(1)(b) statistical purposes` TRUE FALSE EQUALS NOTHING
-- one of the four purposes and neither condition met: NOTHING
#ASSERT `Art 5(1)(e) the personal data may be stored for longer periods` `Art 5(1)(b) historical research purposes` FALSE FALSE EQUALS NOTHING

-- a form that does not permit identification: the sentence is not engaged
#ASSERT `Art 5(1)(e) the personal data are kept in a form which permits identification of data subjects for no longer than is necessary for the purposes for which they are processed` FALSE TRUE NOTHING EQUALS JUST TRUE
-- identifiable and kept no longer than necessary
#ASSERT `Art 5(1)(e) the personal data are kept in a form which permits identification of data subjects for no longer than is necessary for the purposes for which they are processed` TRUE FALSE NOTHING EQUALS JUST TRUE
-- identifiable, kept longer than necessary, no extension
#ASSERT `Art 5(1)(e) the personal data are kept in a form which permits identification of data subjects for no longer than is necessary for the purposes for which they are processed` TRUE TRUE NOTHING EQUALS JUST FALSE
#ASSERT `Art 5(1)(e) the personal data are kept in a form which permits identification of data subjects for no longer than is necessary for the purposes for which they are processed` TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
-- identifiable, kept longer than necessary, solely for archiving in accordance with Article 89(1) with the measures
#ASSERT `Art 5(1)(e) the personal data are kept in a form which permits identification of data subjects for no longer than is necessary for the purposes for which they are processed` TRUE TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `Art 5(1)(e) the personal data are kept in a form which permits identification of data subjects for no longer than is necessary for the purposes for which they are processed` TRUE TRUE (`Art 5(1)(e) the personal data may be stored for longer periods` `Art 5(1)(b) archiving purposes in the public interest` TRUE TRUE) EQUALS JUST TRUE
#ASSERT `Art 5(1)(e) the personal data are kept in a form which permits identification of data subjects for no longer than is necessary for the purposes for which they are processed` TRUE TRUE (`Art 5(1)(e) the personal data may be stored for longer periods` `Art 5(1)(b) archiving purposes in the public interest` TRUE FALSE) EQUALS JUST FALSE
-- identifiable, kept longer than necessary, another purpose: the second limb answers NOTHING, and the first limb stands and is not met
#ASSERT `Art 5(1)(e) the personal data are kept in a form which permits identification of data subjects for no longer than is necessary for the purposes for which they are processed` TRUE TRUE (`Art 5(1)(e) the personal data may be stored for longer periods` `Art 5(1)(b) some other purpose` TRUE TRUE) EQUALS JUST FALSE

§ `Art 5(1)(f): integrity and confidentiality`

#ASSERT `Art 5(1)(f) the personal data are processed in a manner that ensures appropriate security, using appropriate technical or organisational measures` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 5(1)(f) the personal data are processed in a manner that ensures appropriate security, using appropriate technical or organisational measures` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Art 5(1)(f) the personal data are processed in a manner that ensures appropriate security, using appropriate technical or organisational measures` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Art 5(1)(f) the personal data are processed in a manner that ensures appropriate security, using appropriate technical or organisational measures` TRUE TRUE FALSE EQUALS JUST FALSE

§ `Art 5(2): accountability`

#ASSERT `Art 5(2) the body is responsible for compliance with Art 5(1)` TRUE EQUALS JUST TRUE
-- outside: a processor or anyone else: the text does not say
#ASSERT `Art 5(2) the body is responsible for compliance with Art 5(1)` FALSE EQUALS NOTHING
-- all six principles can be demonstrated
#ASSERT `Art 5(2) the controller is able to demonstrate compliance with Art 5(1)` (LIST `Art 5(1)(a) lawfulness, fairness and transparency`, `Art 5(1)(b) purpose limitation`, `Art 5(1)(c) data minimisation`, `Art 5(1)(d) accuracy`, `Art 5(1)(e) storage limitation`, `Art 5(1)(f) integrity and confidentiality`) EQUALS JUST TRUE
-- the accountability principle itself is not one of the six that paragraph 1 lists, and adds nothing
#ASSERT `Art 5(2) the controller is able to demonstrate compliance with Art 5(1)` (LIST `Art 5(1)(a) lawfulness, fairness and transparency`, `Art 5(1)(b) purpose limitation`, `Art 5(1)(c) data minimisation`, `Art 5(1)(d) accuracy`, `Art 5(1)(e) storage limitation`, `Art 5(1)(f) integrity and confidentiality`, `Art 5(2) accountability`) EQUALS JUST TRUE
#ASSERT `Art 5(2) the controller is able to demonstrate compliance with Art 5(1)` (LIST `Art 5(2) accountability`) EQUALS JUST FALSE
#ASSERT `Art 5(2) the controller is able to demonstrate compliance with Art 5(1)` EMPTY EQUALS JUST FALSE
-- one of the six cannot be demonstrated: Art 5(1)(a) lawfulness, fairness and transparency
#ASSERT `Art 5(2) the controller is able to demonstrate compliance with Art 5(1)` (LIST `Art 5(1)(b) purpose limitation`, `Art 5(1)(c) data minimisation`, `Art 5(1)(d) accuracy`, `Art 5(1)(e) storage limitation`, `Art 5(1)(f) integrity and confidentiality`) EQUALS JUST FALSE
-- one of the six cannot be demonstrated: Art 5(1)(b) purpose limitation
#ASSERT `Art 5(2) the controller is able to demonstrate compliance with Art 5(1)` (LIST `Art 5(1)(a) lawfulness, fairness and transparency`, `Art 5(1)(c) data minimisation`, `Art 5(1)(d) accuracy`, `Art 5(1)(e) storage limitation`, `Art 5(1)(f) integrity and confidentiality`) EQUALS JUST FALSE
-- one of the six cannot be demonstrated: Art 5(1)(c) data minimisation
#ASSERT `Art 5(2) the controller is able to demonstrate compliance with Art 5(1)` (LIST `Art 5(1)(a) lawfulness, fairness and transparency`, `Art 5(1)(b) purpose limitation`, `Art 5(1)(d) accuracy`, `Art 5(1)(e) storage limitation`, `Art 5(1)(f) integrity and confidentiality`) EQUALS JUST FALSE
-- one of the six cannot be demonstrated: Art 5(1)(d) accuracy
#ASSERT `Art 5(2) the controller is able to demonstrate compliance with Art 5(1)` (LIST `Art 5(1)(a) lawfulness, fairness and transparency`, `Art 5(1)(b) purpose limitation`, `Art 5(1)(c) data minimisation`, `Art 5(1)(e) storage limitation`, `Art 5(1)(f) integrity and confidentiality`) EQUALS JUST FALSE
-- one of the six cannot be demonstrated: Art 5(1)(e) storage limitation
#ASSERT `Art 5(2) the controller is able to demonstrate compliance with Art 5(1)` (LIST `Art 5(1)(a) lawfulness, fairness and transparency`, `Art 5(1)(b) purpose limitation`, `Art 5(1)(c) data minimisation`, `Art 5(1)(d) accuracy`, `Art 5(1)(f) integrity and confidentiality`) EQUALS JUST FALSE
-- one of the six cannot be demonstrated: Art 5(1)(f) integrity and confidentiality
#ASSERT `Art 5(2) the controller is able to demonstrate compliance with Art 5(1)` (LIST `Art 5(1)(a) lawfulness, fairness and transparency`, `Art 5(1)(b) purpose limitation`, `Art 5(1)(c) data minimisation`, `Art 5(1)(d) accuracy`, `Art 5(1)(e) storage limitation`) EQUALS JUST FALSE

§ `Art 5(2): the regulative rule, traced`

#TRACE `Art 5(2) the controller must be able to demonstrate compliance with Art 5(1)` AT 0 WITH
    PARTY `controller` DOES `Art 5(2) demonstrate compliance with paragraph 1` AT 10
-- expected: FULFILLED (the controller demonstrated)
#TRACE `Art 5(2) the controller must be able to demonstrate compliance with Art 5(1)` AT 0 WITH
    (WAITUNTIL 1000)
-- expected: the obligation is still standing, never a breach: the text states no time limit and no consequence
