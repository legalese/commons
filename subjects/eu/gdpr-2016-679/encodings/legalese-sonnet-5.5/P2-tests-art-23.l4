IMPORT prelude
IMPORT `gdpr-core`
IMPORT `P2-art-23`

-- ============================================================================
-- P2-tests-art-23.l4 -- tests of Article 23 (src:282-303).
-- Every expected value was written by hand from the text of the provision named in the comment above it,
-- before the first run, and none was copied from an output (notes/gen-tests-p2.py holds the cases).
-- A #TRACE result is not an assertion and check.sh does not count it; each trace comment gives the expected result.
-- ============================================================================

§ `Art 23(1): what Union or Member State law may restrict`

-- objective (a): a legislative measure of Union or Member State law that respects the essence and is necessary and proportionate
#ASSERT `Art 23(1) Union or Member State law may restrict by way of a legislative measure the scope of the obligations and rights` TRUE TRUE `Art 23(1) an obligation or a right provided for in Articles 12 to 22` `Art 23(1)(a) national security` FALSE TRUE TRUE EQUALS JUST TRUE
-- objective (b): a legislative measure of Union or Member State law that respects the essence and is necessary and proportionate
#ASSERT `Art 23(1) Union or Member State law may restrict by way of a legislative measure the scope of the obligations and rights` TRUE TRUE `Art 23(1) an obligation or a right provided for in Articles 12 to 22` `Art 23(1)(b) defence` FALSE TRUE TRUE EQUALS JUST TRUE
-- objective (c): a legislative measure of Union or Member State law that respects the essence and is necessary and proportionate
#ASSERT `Art 23(1) Union or Member State law may restrict by way of a legislative measure the scope of the obligations and rights` TRUE TRUE `Art 23(1) an obligation or a right provided for in Articles 12 to 22` `Art 23(1)(c) public security` FALSE TRUE TRUE EQUALS JUST TRUE
-- objective (d): a legislative measure of Union or Member State law that respects the essence and is necessary and proportionate
#ASSERT `Art 23(1) Union or Member State law may restrict by way of a legislative measure the scope of the obligations and rights` TRUE TRUE `Art 23(1) an obligation or a right provided for in Articles 12 to 22` `Art 23(1)(d) the prevention, investigation, detection or prosecution of criminal offences or the execution of criminal penalties, including the safeguarding against and the prevention of threats to public security` FALSE TRUE TRUE EQUALS JUST TRUE
-- objective (e): a legislative measure of Union or Member State law that respects the essence and is necessary and proportionate
#ASSERT `Art 23(1) Union or Member State law may restrict by way of a legislative measure the scope of the obligations and rights` TRUE TRUE `Art 23(1) an obligation or a right provided for in Articles 12 to 22` `Art 23(1)(e) other important objectives of general public interest of the Union or of a Member State, in particular an important economic or financial interest, including monetary, budgetary and taxation matters, public health and social security` FALSE TRUE TRUE EQUALS JUST TRUE
-- objective (f): a legislative measure of Union or Member State law that respects the essence and is necessary and proportionate
#ASSERT `Art 23(1) Union or Member State law may restrict by way of a legislative measure the scope of the obligations and rights` TRUE TRUE `Art 23(1) an obligation or a right provided for in Articles 12 to 22` `Art 23(1)(f) the protection of judicial independence and judicial proceedings` FALSE TRUE TRUE EQUALS JUST TRUE
-- objective (g): a legislative measure of Union or Member State law that respects the essence and is necessary and proportionate
#ASSERT `Art 23(1) Union or Member State law may restrict by way of a legislative measure the scope of the obligations and rights` TRUE TRUE `Art 23(1) an obligation or a right provided for in Articles 12 to 22` `Art 23(1)(g) the prevention, investigation, detection and prosecution of breaches of ethics for regulated professions` FALSE TRUE TRUE EQUALS JUST TRUE
-- objective (i): a legislative measure of Union or Member State law that respects the essence and is necessary and proportionate
#ASSERT `Art 23(1) Union or Member State law may restrict by way of a legislative measure the scope of the obligations and rights` TRUE TRUE `Art 23(1) an obligation or a right provided for in Articles 12 to 22` `Art 23(1)(i) the protection of the data subject or the rights and freedoms of others` FALSE TRUE TRUE EQUALS JUST TRUE
-- objective (j): a legislative measure of Union or Member State law that respects the essence and is necessary and proportionate
#ASSERT `Art 23(1) Union or Member State law may restrict by way of a legislative measure the scope of the obligations and rights` TRUE TRUE `Art 23(1) an obligation or a right provided for in Articles 12 to 22` `Art 23(1)(j) the enforcement of civil law claims` FALSE TRUE TRUE EQUALS JUST TRUE
-- objective (h): a regulatory function connected to the exercise of official authority
#ASSERT `Art 23(1) Union or Member State law may restrict by way of a legislative measure the scope of the obligations and rights` TRUE TRUE `Art 23(1) an obligation or a right provided for in Articles 12 to 22` `Art 23(1)(h) a monitoring, inspection or regulatory function connected, even occasionally, to the exercise of official authority in the cases referred to in points (a) to (e) and (g)` TRUE TRUE TRUE EQUALS JUST TRUE
-- objective (h) with no such connection: not point (h)
#ASSERT `Art 23(1) Union or Member State law may restrict by way of a legislative measure the scope of the obligations and rights` TRUE TRUE `Art 23(1) an obligation or a right provided for in Articles 12 to 22` `Art 23(1)(h) a monitoring, inspection or regulatory function connected, even occasionally, to the exercise of official authority in the cases referred to in points (a) to (e) and (g)` FALSE TRUE TRUE EQUALS NOTHING
-- the obligation of Article 34
#ASSERT `Art 23(1) Union or Member State law may restrict by way of a legislative measure the scope of the obligations and rights` TRUE TRUE `Art 23(1) an obligation provided for in Article 34` `Art 23(1)(a) national security` FALSE TRUE TRUE EQUALS JUST TRUE
-- Article 5 in so far as it corresponds to Articles 12 to 22
#ASSERT `Art 23(1) Union or Member State law may restrict by way of a legislative measure the scope of the obligations and rights` TRUE TRUE `Art 23(1) Article 5, in so far as its provisions correspond to the rights and obligations provided for in Articles 12 to 22` `Art 23(1)(a) national security` FALSE TRUE TRUE EQUALS JUST TRUE
-- another provision of the Regulation: outside the grant
#ASSERT `Art 23(1) Union or Member State law may restrict by way of a legislative measure the scope of the obligations and rights` TRUE TRUE `Art 23(1) some other provision of the Regulation` `Art 23(1)(a) national security` FALSE TRUE TRUE EQUALS NOTHING
-- an objective outside points (a) to (j): the list is not closed with 'only'
#ASSERT `Art 23(1) Union or Member State law may restrict by way of a legislative measure the scope of the obligations and rights` TRUE TRUE `Art 23(1) an obligation or a right provided for in Articles 12 to 22` `Art 23(1) some other objective` FALSE TRUE TRUE EQUALS NOTHING
-- not Union or Member State law to which the controller or processor is subject
#ASSERT `Art 23(1) Union or Member State law may restrict by way of a legislative measure the scope of the obligations and rights` FALSE TRUE `Art 23(1) an obligation or a right provided for in Articles 12 to 22` `Art 23(1)(a) national security` FALSE TRUE TRUE EQUALS NOTHING
-- not by way of a legislative measure
#ASSERT `Art 23(1) Union or Member State law may restrict by way of a legislative measure the scope of the obligations and rights` TRUE FALSE `Art 23(1) an obligation or a right provided for in Articles 12 to 22` `Art 23(1)(a) national security` FALSE TRUE TRUE EQUALS NOTHING
-- the restriction does not respect the essence of the fundamental rights and freedoms: 'when' fails
#ASSERT `Art 23(1) Union or Member State law may restrict by way of a legislative measure the scope of the obligations and rights` TRUE TRUE `Art 23(1) an obligation or a right provided for in Articles 12 to 22` `Art 23(1)(a) national security` FALSE FALSE TRUE EQUALS JUST FALSE
-- not necessary and proportionate: 'when' fails
#ASSERT `Art 23(1) Union or Member State law may restrict by way of a legislative measure the scope of the obligations and rights` TRUE TRUE `Art 23(1) an obligation or a right provided for in Articles 12 to 22` `Art 23(1)(a) national security` FALSE TRUE FALSE EQUALS JUST FALSE
-- neither
#ASSERT `Art 23(1) Union or Member State law may restrict by way of a legislative measure the scope of the obligations and rights` TRUE TRUE `Art 23(1) an obligation or a right provided for in Articles 12 to 22` `Art 23(1)(a) national security` FALSE FALSE FALSE EQUALS JUST FALSE
-- national security, necessary and proportionate
#ASSERT `Art 23(1) the law is a necessary and proportionate measure in a democratic society to safeguard one of the objectives referred to in Article 23(1)` `Art 23(1)(a) national security` TRUE EQUALS JUST TRUE
-- the enforcement of civil law claims, necessary and proportionate
#ASSERT `Art 23(1) the law is a necessary and proportionate measure in a democratic society to safeguard one of the objectives referred to in Article 23(1)` `Art 23(1)(j) the enforcement of civil law claims` TRUE EQUALS JUST TRUE
-- not necessary and proportionate: 'when' fails
#ASSERT `Art 23(1) the law is a necessary and proportionate measure in a democratic society to safeguard one of the objectives referred to in Article 23(1)` `Art 23(1)(a) national security` FALSE EQUALS JUST FALSE
-- an objective outside points (a) to (j): not decided
#ASSERT `Art 23(1) the law is a necessary and proportionate measure in a democratic society to safeguard one of the objectives referred to in Article 23(1)` `Art 23(1) some other objective` TRUE EQUALS NOTHING

§ `Art 23(2): what the legislative measure must contain`

-- three relevant matters, all three provided for
#ASSERT `Art 23(2) the legislative measure contains specific provisions at least, where relevant, as to the matters that paragraph 2 lists` (LIST `Art 23(2)(a) the purposes of the processing or categories of processing`, `Art 23(2)(b) the categories of personal data`, `Art 23(2)(c) the scope of the restrictions introduced`) (LIST `Art 23(2)(a) the purposes of the processing or categories of processing`, `Art 23(2)(b) the categories of personal data`, `Art 23(2)(c) the scope of the restrictions introduced`) FALSE EQUALS JUST TRUE
-- one relevant matter (c) not provided for: 'shall contain ... at least, where relevant'
#ASSERT `Art 23(2) the legislative measure contains specific provisions at least, where relevant, as to the matters that paragraph 2 lists` (LIST `Art 23(2)(a) the purposes of the processing or categories of processing`, `Art 23(2)(b) the categories of personal data`, `Art 23(2)(c) the scope of the restrictions introduced`) (LIST `Art 23(2)(a) the purposes of the processing or categories of processing`, `Art 23(2)(b) the categories of personal data`) FALSE EQUALS JUST FALSE
-- nothing is relevant: nothing is required
#ASSERT `Art 23(2) the legislative measure contains specific provisions at least, where relevant, as to the matters that paragraph 2 lists` EMPTY EMPTY FALSE EQUALS JUST TRUE
-- the measure also provides for an irrelevant matter: 'at least'
#ASSERT `Art 23(2) the legislative measure contains specific provisions at least, where relevant, as to the matters that paragraph 2 lists` (LIST `Art 23(2)(a) the purposes of the processing or categories of processing`) (LIST `Art 23(2)(a) the purposes of the processing or categories of processing`, `Art 23(2)(d) the safeguards to prevent abuse or unlawful access or transfer`) FALSE EQUALS JUST TRUE
-- (h) informing the data subject may be prejudicial to the purpose of the restriction: not required ('unless')
#ASSERT `Art 23(2) the legislative measure contains specific provisions at least, where relevant, as to the matters that paragraph 2 lists` (LIST `Art 23(2)(h) the right of data subjects to be informed about the restriction`) EMPTY TRUE EQUALS JUST TRUE
-- (h) relevant, not prejudicial, and not provided for
#ASSERT `Art 23(2) the legislative measure contains specific provisions at least, where relevant, as to the matters that paragraph 2 lists` (LIST `Art 23(2)(h) the right of data subjects to be informed about the restriction`) EMPTY FALSE EQUALS JUST FALSE
-- (h) provided for
#ASSERT `Art 23(2) the legislative measure contains specific provisions at least, where relevant, as to the matters that paragraph 2 lists` (LIST `Art 23(2)(h) the right of data subjects to be informed about the restriction`) (LIST `Art 23(2)(h) the right of data subjects to be informed about the restriction`) FALSE EQUALS JUST TRUE
-- (a) provided for, (h) excused as prejudicial
#ASSERT `Art 23(2) the legislative measure contains specific provisions at least, where relevant, as to the matters that paragraph 2 lists` (LIST `Art 23(2)(a) the purposes of the processing or categories of processing`, `Art 23(2)(h) the right of data subjects to be informed about the restriction`) (LIST `Art 23(2)(a) the purposes of the processing or categories of processing`) TRUE EQUALS JUST TRUE
-- (h) excused, but (a) is missing
#ASSERT `Art 23(2) the legislative measure contains specific provisions at least, where relevant, as to the matters that paragraph 2 lists` (LIST `Art 23(2)(a) the purposes of the processing or categories of processing`, `Art 23(2)(h) the right of data subjects to be informed about the restriction`) (LIST `Art 23(2)(h) the right of data subjects to be informed about the restriction`) TRUE EQUALS JUST FALSE
