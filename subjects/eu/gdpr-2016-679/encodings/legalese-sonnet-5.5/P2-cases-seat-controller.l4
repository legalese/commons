§§ `Article 18: right to restriction of processing`

-- 18(1)(a): Art 18(1)(a) point (a) applies: the accuracy of the personal data is contested, for a period enabling the controller to verify the accuracy
-- (a) accuracy contested, for a period enabling verification
#ASSERT `Under Article 18(1), as a controller, does ground (a) apply: the accuracy of the personal data is contested, for a period enabling the controller to verify it` TRUE TRUE EQUALS JUST TRUE
-- (a) contested, but the period enabling verification has ended
#ASSERT `Under Article 18(1), as a controller, does ground (a) apply: the accuracy of the personal data is contested, for a period enabling the controller to verify it` TRUE FALSE EQUALS JUST FALSE
-- (a) accuracy not contested
#ASSERT `Under Article 18(1), as a controller, does ground (a) apply: the accuracy of the personal data is contested, for a period enabling the controller to verify it` FALSE TRUE EQUALS JUST FALSE

-- 18(1)(b): Art 18(1)(b) point (b) applies: the processing is unlawful and the data subject opposes erasure and requests restriction instead
-- (b) unlawful, the data subject opposes erasure and requests restriction instead
#ASSERT `Under Article 18(1), as a controller, does ground (b) apply: the processing is unlawful and the data subject opposes erasure and requests restriction instead` TRUE TRUE TRUE EQUALS JUST TRUE
-- (b) the data subject does not request restriction
#ASSERT `Under Article 18(1), as a controller, does ground (b) apply: the processing is unlawful and the data subject opposes erasure and requests restriction instead` TRUE TRUE FALSE EQUALS JUST FALSE
-- (b) the data subject does not oppose erasure
#ASSERT `Under Article 18(1), as a controller, does ground (b) apply: the processing is unlawful and the data subject opposes erasure and requests restriction instead` TRUE FALSE TRUE EQUALS JUST FALSE
-- (b) the processing is lawful
#ASSERT `Under Article 18(1), as a controller, does ground (b) apply: the processing is unlawful and the data subject opposes erasure and requests restriction instead` FALSE TRUE TRUE EQUALS JUST FALSE

-- 18(1)(c): Art 18(1)(c) point (c) applies: the controller no longer needs the personal data but the data subject requires them for legal claims
-- (c) no longer needed by the controller, required by the data subject for legal claims
#ASSERT `Under Article 18(1), as a controller, does ground (c) apply: the controller no longer needs the personal data but the data subject requires them for legal claims` TRUE TRUE EQUALS JUST TRUE
-- (c) not required by the data subject for legal claims
#ASSERT `Under Article 18(1), as a controller, does ground (c) apply: the controller no longer needs the personal data but the data subject requires them for legal claims` TRUE FALSE EQUALS JUST FALSE
-- (c) the controller still needs the data
#ASSERT `Under Article 18(1), as a controller, does ground (c) apply: the controller no longer needs the personal data but the data subject requires them for legal claims` FALSE TRUE EQUALS JUST FALSE

-- 18(1)(d): Art 18(1)(d) point (d) applies: the data subject has objected pursuant to Article 21(1) pending the verification whether the controller's grounds override
-- (d) objected pursuant to Article 21(1), verification pending
#ASSERT `Under Article 18(1), as a controller, does ground (d) apply: the data subject has objected pursuant to Article 21(1), pending the verification whether the controller's grounds override` TRUE TRUE EQUALS JUST TRUE
-- (d) objected, but the verification is complete
#ASSERT `Under Article 18(1), as a controller, does ground (d) apply: the data subject has objected pursuant to Article 21(1), pending the verification whether the controller's grounds override` TRUE FALSE EQUALS JUST FALSE
-- (d) no objection
#ASSERT `Under Article 18(1), as a controller, does ground (d) apply: the data subject has objected pursuant to Article 21(1), pending the verification whether the controller's grounds override` FALSE TRUE EQUALS JUST FALSE

-- 18(1): Art 18(1) the data subject has the right to obtain from the controller restriction of processing
-- point (a) holds
#ASSERT `Under Article 18(1), as a controller, must I restrict the processing of the data subject's personal data` TRUE `P2 controller answer: yes` `P2 controller answer: no` `P2 controller answer: no` `P2 controller answer: no` FALSE FALSE EQUALS JUST TRUE
-- point (b) holds
#ASSERT `Under Article 18(1), as a controller, must I restrict the processing of the data subject's personal data` TRUE `P2 controller answer: no` `P2 controller answer: yes` `P2 controller answer: no` `P2 controller answer: no` FALSE FALSE EQUALS JUST TRUE
-- point (c) holds
#ASSERT `Under Article 18(1), as a controller, must I restrict the processing of the data subject's personal data` TRUE `P2 controller answer: no` `P2 controller answer: no` `P2 controller answer: yes` `P2 controller answer: no` FALSE FALSE EQUALS JUST TRUE
-- point (d) holds
#ASSERT `Under Article 18(1), as a controller, must I restrict the processing of the data subject's personal data` TRUE `P2 controller answer: no` `P2 controller answer: no` `P2 controller answer: no` `P2 controller answer: yes` FALSE FALSE EQUALS JUST TRUE
-- no point holds: 'where one of the following applies' fails
#ASSERT `Under Article 18(1), as a controller, must I restrict the processing of the data subject's personal data` TRUE `P2 controller answer: no` `P2 controller answer: no` `P2 controller answer: no` `P2 controller answer: no` FALSE FALSE EQUALS JUST FALSE
-- no point holds and (d) is not decided: not covered
#ASSERT `Under Article 18(1), as a controller, must I restrict the processing of the data subject's personal data` TRUE `P2 controller answer: no` `P2 controller answer: no` `P2 controller answer: no` `P2 controller answer: not sure` FALSE FALSE EQUALS NOTHING
-- (b) holds whatever (a) is
#ASSERT `Under Article 18(1), as a controller, must I restrict the processing of the data subject's personal data` TRUE `P2 controller answer: not sure` `P2 controller answer: yes` `P2 controller answer: no` `P2 controller answer: no` FALSE FALSE EQUALS JUST TRUE

-- 18(2): Art 18(2) the restricted personal data are processed, with the exception of storage, only with the data subject's consent or for one of the three purposes that paragraph 2 names
-- restricted data, storage only: 'with the exception of storage'
#ASSERT `Under Article 18(2), as a controller, am I processing the restricted personal data, apart from storage, only with the data subject's consent or for one of the three purposes that paragraph 2 names` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST `the duty arises and is met`
-- with the data subject's consent
#ASSERT `Under Article 18(2), as a controller, am I processing the restricted personal data, apart from storage, only with the data subject's consent or for one of the three purposes that paragraph 2 names` TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST `the duty arises and is met`
-- for the establishment, exercise or defence of legal claims
#ASSERT `Under Article 18(2), as a controller, am I processing the restricted personal data, apart from storage, only with the data subject's consent or for one of the three purposes that paragraph 2 names` TRUE FALSE FALSE TRUE FALSE FALSE EQUALS JUST `the duty arises and is met`
-- for the protection of the rights of another natural or legal person
#ASSERT `Under Article 18(2), as a controller, am I processing the restricted personal data, apart from storage, only with the data subject's consent or for one of the three purposes that paragraph 2 names` TRUE FALSE FALSE FALSE TRUE FALSE EQUALS JUST `the duty arises and is met`
-- for reasons of important public interest of the Union or of a Member State
#ASSERT `Under Article 18(2), as a controller, am I processing the restricted personal data, apart from storage, only with the data subject's consent or for one of the three purposes that paragraph 2 names` TRUE FALSE FALSE FALSE FALSE TRUE EQUALS JUST `the duty arises and is met`
-- any other processing of restricted data: the list is closed with 'only'
#ASSERT `Under Article 18(2), as a controller, am I processing the restricted personal data, apart from storage, only with the data subject's consent or for one of the three purposes that paragraph 2 names` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST `the duty arises and is not met`
-- the processing has not been restricted: 'Where processing has been restricted' fails
#ASSERT `Under Article 18(2), as a controller, am I processing the restricted personal data, apart from storage, only with the data subject's consent or for one of the three purposes that paragraph 2 names` FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST `the duty does not arise`

-- 18(3): Art 18(3) the controller informs the data subject who has obtained restriction of processing before the restriction is lifted
-- informed before the restriction was lifted
#ASSERT `Under Article 18(3), as a controller, have I informed the data subject, before lifting the restriction of processing, that I am lifting it` TRUE TRUE EQUALS JUST `the duty arises and is met`
-- not informed before: 'shall be informed by the controller before'
#ASSERT `Under Article 18(3), as a controller, have I informed the data subject, before lifting the restriction of processing, that I am lifting it` TRUE FALSE EQUALS JUST `the duty arises and is not met`
-- no restriction obtained under paragraph 1: outside 'A data subject who has obtained restriction'
#ASSERT `Under Article 18(3), as a controller, have I informed the data subject, before lifting the restriction of processing, that I am lifting it` FALSE TRUE EQUALS NOTHING


§§ `Article 19: notification obligation regarding rectification or erasure or restriction`

-- 19a: Art 19 the controller communicates any rectification, erasure or restriction of processing to each recipient to whom the personal data have been disclosed
-- a rectification carried out, a recipient (a legal person to whom the data were disclosed), communicated
#ASSERT `Under Article 19, as a controller, have I communicated the rectification, erasure or restriction of processing to a recipient to whom the personal data were disclosed` TRUE `legal person` TRUE FALSE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST `the duty arises and is met`
-- not communicated: 'shall communicate'
#ASSERT `Under Article 19, as a controller, have I communicated the rectification, erasure or restriction of processing to a recipient to whom the personal data were disclosed` TRUE `legal person` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST `the duty arises and is not met`
-- the recipient is a third party: 'whether a third party or not' (Article 4(9)), so still a recipient
#ASSERT `Under Article 19, as a controller, have I communicated the rectification, erasure or restriction of processing to a recipient to whom the personal data were disclosed` TRUE `legal person` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST `the duty arises and is not met`
-- communicating proves impossible or involves disproportionate effort: 'unless'
#ASSERT `Under Article 19, as a controller, have I communicated the rectification, erasure or restriction of processing to a recipient to whom the personal data were disclosed` TRUE `legal person` TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST `the duty does not arise`
-- no rectification, erasure or restriction carried out: nothing to communicate; the text is silent
#ASSERT `Under Article 19, as a controller, have I communicated the rectification, erasure or restriction of processing to a recipient to whom the personal data were disclosed` FALSE `legal person` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- the data were not disclosed to the body: it is not a recipient (Article 4(9)), outside 'each recipient'
#ASSERT `Under Article 19, as a controller, have I communicated the rectification, erasure or restriction of processing to a recipient to whom the personal data were disclosed` TRUE `legal person` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- a public authority that receives the data in a particular inquiry in accordance with law is 'not regarded as a recipient' (Article 4(9))
#ASSERT `Under Article 19, as a controller, have I communicated the rectification, erasure or restriction of processing to a recipient to whom the personal data were disclosed` TRUE `public authority` TRUE FALSE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING

-- 19b: Art 19 the controller informs the data subject about those recipients if the data subject requests it
-- requested, and the controller informed the data subject
#ASSERT `Under Article 19, as a controller, where the data subject asks, have I informed the data subject about the recipients` TRUE TRUE FALSE FALSE EQUALS JUST `the duty arises and is met`
-- requested, and not informed: 'shall inform'
#ASSERT `Under Article 19, as a controller, where the data subject asks, have I informed the data subject about the recipients` TRUE FALSE FALSE FALSE EQUALS JUST `the duty arises and is not met`
-- not requested: 'if the data subject requests it' fails
#ASSERT `Under Article 19, as a controller, where the data subject asks, have I informed the data subject about the recipients` FALSE FALSE FALSE FALSE EQUALS JUST `the duty does not arise`
-- not requested, informed in any case: the duty did not arise
#ASSERT `Under Article 19, as a controller, where the data subject asks, have I informed the data subject about the recipients` FALSE TRUE FALSE FALSE EQUALS JUST `the duty does not arise`
-- Article 11(2) disapplies Articles 15 to 20 (Article 19 is among them): no duty to inform, whatever the controller did (R9)
#ASSERT `Under Article 19, as a controller, where the data subject asks, have I informed the data subject about the recipients` TRUE FALSE TRUE FALSE EQUALS JUST `the duty does not arise`
-- an Article 11(2) case with identifying information: the article applies; requested and not informed
#ASSERT `Under Article 19, as a controller, where the data subject asks, have I informed the data subject about the recipients` TRUE FALSE TRUE TRUE EQUALS JUST `the duty arises and is not met`
-- an Article 11(2) case with identifying information: requested and informed
#ASSERT `Under Article 19, as a controller, where the data subject asks, have I informed the data subject about the recipients` TRUE TRUE TRUE TRUE EQUALS JUST `the duty arises and is met`


§§ `Article 20: right to data portability`

-- 20(1)a: Art 20(1) the data subject has the right to receive the personal data concerning him or her which he or she has provided to a controller, in a structured, commonly used and machine-readable format
-- (receive) consent-based, automated, provided by the data subject
#ASSERT `Under Article 20(1), as a controller, must I give the data subject the personal data he or she provided to me in a structured, commonly used and machine-readable format` TRUE TRUE TRUE `P2 controller answer: no` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- (receive) based on a contract pursuant to point (b) of Article 6(1)
#ASSERT `Under Article 20(1), as a controller, must I give the data subject the personal data he or she provided to me in a structured, commonly used and machine-readable format` TRUE TRUE FALSE `P2 controller answer: yes` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- (receive) based on neither consent nor contract: 'where: (a)' fails
#ASSERT `Under Article 20(1), as a controller, must I give the data subject the personal data he or she provided to me in a structured, commonly used and machine-readable format` TRUE TRUE FALSE `P2 controller answer: no` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- (receive) not on consent and the contract basis is not decided: not covered
#ASSERT `Under Article 20(1), as a controller, must I give the data subject the personal data he or she provided to me in a structured, commonly used and machine-readable format` TRUE TRUE FALSE `P2 controller answer: not sure` TRUE FALSE FALSE FALSE EQUALS NOTHING
-- (receive) consent-based: the contract limb is not needed
#ASSERT `Under Article 20(1), as a controller, must I give the data subject the personal data he or she provided to me in a structured, commonly used and machine-readable format` TRUE TRUE TRUE `P2 controller answer: not sure` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- (receive) not carried out by automated means: 'where: ... (b)' fails
#ASSERT `Under Article 20(1), as a controller, must I give the data subject the personal data he or she provided to me in a structured, commonly used and machine-readable format` TRUE TRUE TRUE `P2 controller answer: no` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- (receive) the processing is necessary for a task in the public interest: 'That right shall not apply'
#ASSERT `Under Article 20(1), as a controller, must I give the data subject the personal data he or she provided to me in a structured, commonly used and machine-readable format` TRUE TRUE TRUE `P2 controller answer: no` TRUE TRUE FALSE FALSE EQUALS JUST FALSE

-- 20(1)b: Art 20(1) the data subject has the right to transmit those data to another controller without hindrance from the controller to which the personal data have been provided
-- (transmit) consent-based, automated, provided by the data subject
#ASSERT `Under Article 20(1), as a controller, must I allow the data subject to transmit his or her personal data to another controller without hindrance from me` TRUE TRUE TRUE `P2 controller answer: no` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- (transmit) based on a contract pursuant to point (b) of Article 6(1)
#ASSERT `Under Article 20(1), as a controller, must I allow the data subject to transmit his or her personal data to another controller without hindrance from me` TRUE TRUE FALSE `P2 controller answer: yes` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- (transmit) based on neither consent nor contract: 'where: (a)' fails
#ASSERT `Under Article 20(1), as a controller, must I allow the data subject to transmit his or her personal data to another controller without hindrance from me` TRUE TRUE FALSE `P2 controller answer: no` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- (transmit) not on consent and the contract basis is not decided: not covered
#ASSERT `Under Article 20(1), as a controller, must I allow the data subject to transmit his or her personal data to another controller without hindrance from me` TRUE TRUE FALSE `P2 controller answer: not sure` TRUE FALSE FALSE FALSE EQUALS NOTHING
-- (transmit) consent-based: the contract limb is not needed
#ASSERT `Under Article 20(1), as a controller, must I allow the data subject to transmit his or her personal data to another controller without hindrance from me` TRUE TRUE TRUE `P2 controller answer: not sure` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- (transmit) not carried out by automated means: 'where: ... (b)' fails
#ASSERT `Under Article 20(1), as a controller, must I allow the data subject to transmit his or her personal data to another controller without hindrance from me` TRUE TRUE TRUE `P2 controller answer: no` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- (transmit) the processing is necessary for a task in the public interest: 'That right shall not apply'
#ASSERT `Under Article 20(1), as a controller, must I allow the data subject to transmit his or her personal data to another controller without hindrance from me` TRUE TRUE TRUE `P2 controller answer: no` TRUE TRUE FALSE FALSE EQUALS JUST FALSE

-- 20(2): Art 20(2) the data subject has the right to have the personal data transmitted directly from one controller to another, where technically feasible
-- in exercising the right of paragraph 1, technically feasible
#ASSERT `Under Article 20(2), as a controller, must I transmit the data subject's personal data directly to another controller, where technically feasible` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- not technically feasible: 'where technically feasible' fails
#ASSERT `Under Article 20(2), as a controller, must I transmit the data subject's personal data directly to another controller, where technically feasible` TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- not in exercising the right of paragraph 1: outside the sentence
#ASSERT `Under Article 20(2), as a controller, must I transmit the data subject's personal data directly to another controller, where technically feasible` TRUE FALSE TRUE FALSE FALSE EQUALS NOTHING
-- Article 11(2) disapplies Articles 15 to 20
#ASSERT `Under Article 20(2), as a controller, must I transmit the data subject's personal data directly to another controller, where technically feasible` TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- not the data subject
#ASSERT `Under Article 20(2), as a controller, must I transmit the data subject's personal data directly to another controller, where technically feasible` FALSE TRUE TRUE FALSE FALSE EQUALS NOTHING

-- 20(3)a: Art 20(3) the exercise of the right referred to in paragraph 1 prejudices the right to erasure under Article 17
-- the exercise of the right is 'without prejudice to Article 17'
#ASSERT `Under Article 20(3), as a controller, does the data subject's exercise of the right to data portability prejudice his or her right to erasure under Article 17` TRUE EQUALS JUST FALSE
-- no exercise of the right: outside the sentence
#ASSERT `Under Article 20(3), as a controller, does the data subject's exercise of the right to data portability prejudice his or her right to erasure under Article 17` FALSE EQUALS NOTHING

-- 20(3)b: Art 20(3) the right to data portability does not apply to processing necessary for the performance of a task carried out in the public interest or in the exercise of official authority
-- processing necessary for a task in the public interest or official authority: 'That right shall not apply'
#ASSERT `Under Article 20(3), as a controller, does the right to data portability not apply to my processing, which is necessary for a task in the public interest or in the exercise of official authority` TRUE EQUALS JUST TRUE
-- other processing: outside the sentence
#ASSERT `Under Article 20(3), as a controller, does the right to data portability not apply to my processing, which is necessary for a task in the public interest or in the exercise of official authority` FALSE EQUALS NOTHING

-- 20(4): Art 20(4) the right referred to in paragraph 1 is limited because its exercise would adversely affect the rights and freedoms of others
-- the exercise would adversely affect the rights and freedoms of others: 'shall not adversely affect'
#ASSERT `Under Article 20(4), as a controller, is the data subject's right to data portability limited because its exercise would adversely affect the rights and freedoms of others` TRUE EQUALS JUST TRUE
-- no adverse effect: the limit is not engaged and the paragraph is silent
#ASSERT `Under Article 20(4), as a controller, is the data subject's right to data portability limited because its exercise would adversely affect the rights and freedoms of others` FALSE EQUALS NOTHING


§§ `Article 21: right to object`

-- 21(1)a: Art 21(1) the data subject has the right to object, on grounds relating to his or her particular situation, to processing which is based on point (e) or (f) of Article 6(1)
-- processing based on point (e), objection on grounds of the particular situation
#ASSERT `Under Article 21(1), as a controller, may the data subject object, on grounds relating to his or her particular situation, to my processing based on point (e) or (f) of Article 6(1)` TRUE TRUE `P2 controller answer: yes` `P2 controller answer: no` EQUALS JUST TRUE
-- processing based on point (f)
#ASSERT `Under Article 21(1), as a controller, may the data subject object, on grounds relating to his or her particular situation, to my processing based on point (e) or (f) of Article 6(1)` TRUE TRUE `P2 controller answer: no` `P2 controller answer: yes` EQUALS JUST TRUE
-- point (f) holds whatever (e) is
#ASSERT `Under Article 21(1), as a controller, may the data subject object, on grounds relating to his or her particular situation, to my processing based on point (e) or (f) of Article 6(1)` TRUE TRUE `P2 controller answer: not sure` `P2 controller answer: yes` EQUALS JUST TRUE
-- processing on another basis: outside 'which is based on point (e) or (f)'; the text does not say no
#ASSERT `Under Article 21(1), as a controller, may the data subject object, on grounds relating to his or her particular situation, to my processing based on point (e) or (f) of Article 6(1)` TRUE TRUE `P2 controller answer: no` `P2 controller answer: no` EQUALS NOTHING
-- neither holds and (e) is not decided: not covered
#ASSERT `Under Article 21(1), as a controller, may the data subject object, on grounds relating to his or her particular situation, to my processing based on point (e) or (f) of Article 6(1)` TRUE TRUE `P2 controller answer: not sure` `P2 controller answer: no` EQUALS NOTHING
-- an objection not on grounds relating to the particular situation: outside the grant
#ASSERT `Under Article 21(1), as a controller, may the data subject object, on grounds relating to his or her particular situation, to my processing based on point (e) or (f) of Article 6(1)` TRUE FALSE `P2 controller answer: yes` `P2 controller answer: no` EQUALS NOTHING
-- not the data subject
#ASSERT `Under Article 21(1), as a controller, may the data subject object, on grounds relating to his or her particular situation, to my processing based on point (e) or (f) of Article 6(1)` FALSE TRUE `P2 controller answer: yes` `P2 controller answer: no` EQUALS NOTHING

-- 21(1)b: Art 21(1) the controller shall no longer process the personal data unless the controller demonstrates compelling legitimate grounds
-- objected, and the controller demonstrates no compelling grounds: it shall no longer process
#ASSERT `Under Article 21(1), as a controller, after the data subject objected, am I barred from processing his or her personal data any longer` TRUE FALSE FALSE EQUALS JUST TRUE
-- compelling legitimate grounds that override the interests of the data subject: 'unless'
#ASSERT `Under Article 21(1), as a controller, after the data subject objected, am I barred from processing his or her personal data any longer` TRUE TRUE FALSE EQUALS JUST FALSE
-- compelling legitimate grounds for legal claims: 'unless'
#ASSERT `Under Article 21(1), as a controller, after the data subject objected, am I barred from processing his or her personal data any longer` TRUE FALSE TRUE EQUALS JUST FALSE
-- both
#ASSERT `Under Article 21(1), as a controller, after the data subject objected, am I barred from processing his or her personal data any longer` TRUE TRUE TRUE EQUALS JUST FALSE
-- no objection: the sentence follows an objection and the text is silent otherwise
#ASSERT `Under Article 21(1), as a controller, after the data subject objected, am I barred from processing his or her personal data any longer` FALSE FALSE FALSE EQUALS NOTHING

-- 21(2): Art 21(2) the data subject has the right to object at any time to processing of personal data concerning him or her for direct marketing
-- personal data processed for direct marketing purposes
#ASSERT `Under Article 21(2), as a controller, may the data subject object at any time to my processing of his or her personal data for direct marketing` TRUE TRUE EQUALS JUST TRUE
-- not processed for direct marketing: 'Where' fails
#ASSERT `Under Article 21(2), as a controller, may the data subject object at any time to my processing of his or her personal data for direct marketing` TRUE FALSE EQUALS JUST FALSE
-- not the data subject
#ASSERT `Under Article 21(2), as a controller, may the data subject object at any time to my processing of his or her personal data for direct marketing` FALSE TRUE EQUALS NOTHING

-- 21(3): Art 21(3) the personal data shall no longer be processed for direct marketing purposes
-- the data subject objects to processing for direct marketing: the data shall no longer be processed for those purposes
#ASSERT `Under Article 21(3), as a controller, after the data subject objected to direct marketing, are the personal data barred from being processed by me for that purpose any longer` TRUE EQUALS JUST TRUE
-- no objection: 'Where the data subject objects' fails
#ASSERT `Under Article 21(3), as a controller, after the data subject objected to direct marketing, are the personal data barred from being processed by me for that purpose any longer` FALSE EQUALS JUST FALSE

-- 21(4): Art 21(4) the right to object is explicitly brought to the attention of the data subject, clearly and separately, at the latest at the time of the first communication
-- explicitly brought to the attention, presented clearly and separately, at the time of the first communication
#ASSERT `Under Article 21(4), as a controller, have I explicitly brought the right to object to the data subject's attention, clearly and separately, at the latest at the time of the first communication` TRUE TRUE TRUE EQUALS JUST TRUE
-- not at the latest at the time of the first communication
#ASSERT `Under Article 21(4), as a controller, have I explicitly brought the right to object to the data subject's attention, clearly and separately, at the latest at the time of the first communication` TRUE TRUE FALSE EQUALS JUST FALSE
-- not presented clearly and separately
#ASSERT `Under Article 21(4), as a controller, have I explicitly brought the right to object to the data subject's attention, clearly and separately, at the latest at the time of the first communication` TRUE FALSE TRUE EQUALS JUST FALSE
-- not explicitly brought to the attention
#ASSERT `Under Article 21(4), as a controller, have I explicitly brought the right to object to the data subject's attention, clearly and separately, at the latest at the time of the first communication` FALSE TRUE TRUE EQUALS JUST FALSE

-- 21(5): Art 21(5) the data subject may exercise the right to object by automated means using technical specifications
-- in the context of the use of information society services
#ASSERT `Under Article 21(5), as a controller, may the data subject exercise the right to object by automated means using technical specifications` TRUE EQUALS JUST TRUE
-- another context: outside the grant
#ASSERT `Under Article 21(5), as a controller, may the data subject exercise the right to object by automated means using technical specifications` FALSE EQUALS NOTHING

-- 21(6): Art 21(6) the data subject has the right to object to processing for scientific or historical research purposes or statistical purposes
-- scientific research purposes pursuant to Article 89(1)
#ASSERT `Under Article 21(6), as a controller, may the data subject object to my processing of his or her personal data for scientific or historical research or statistical purposes` TRUE `Art 5(1)(b) scientific research purposes` TRUE TRUE FALSE EQUALS JUST TRUE
-- historical research purposes
#ASSERT `Under Article 21(6), as a controller, may the data subject object to my processing of his or her personal data for scientific or historical research or statistical purposes` TRUE `Art 5(1)(b) historical research purposes` TRUE TRUE FALSE EQUALS JUST TRUE
-- statistical purposes
#ASSERT `Under Article 21(6), as a controller, may the data subject object to my processing of his or her personal data for scientific or historical research or statistical purposes` TRUE `Art 5(1)(b) statistical purposes` TRUE TRUE FALSE EQUALS JUST TRUE
-- archiving purposes in the public interest are not on the list: 'Where' fails
#ASSERT `Under Article 21(6), as a controller, may the data subject object to my processing of his or her personal data for scientific or historical research or statistical purposes` TRUE `Art 5(1)(b) archiving purposes in the public interest` TRUE TRUE FALSE EQUALS JUST FALSE
-- another purpose: 'Where' fails
#ASSERT `Under Article 21(6), as a controller, may the data subject object to my processing of his or her personal data for scientific or historical research or statistical purposes` TRUE `Art 5(1)(b) some other purpose` TRUE TRUE FALSE EQUALS JUST FALSE
-- research purposes but not pursuant to Article 89(1)
#ASSERT `Under Article 21(6), as a controller, may the data subject object to my processing of his or her personal data for scientific or historical research or statistical purposes` TRUE `Art 5(1)(b) scientific research purposes` FALSE TRUE FALSE EQUALS JUST FALSE
-- an objection not on grounds relating to the particular situation: outside the grant
#ASSERT `Under Article 21(6), as a controller, may the data subject object to my processing of his or her personal data for scientific or historical research or statistical purposes` TRUE `Art 5(1)(b) scientific research purposes` TRUE FALSE FALSE EQUALS NOTHING


§§ `Article 22: automated individual decision-making, including profiling`

-- 22(2)(a): Art 22(2)(a) point (a) applies: the decision is necessary for entering into, or performance of, a contract between the data subject and a data controller
-- (a) necessary for entering into or performing a contract between the data subject and a controller
#ASSERT `Under Article 22(2), as a controller, does point (a) apply to my decision: the decision is necessary for entering into, or performance of, a contract between the data subject and a controller` TRUE EQUALS JUST TRUE
-- (a) not necessary: 'if' fails
#ASSERT `Under Article 22(2), as a controller, does point (a) apply to my decision: the decision is necessary for entering into, or performance of, a contract between the data subject and a controller` FALSE EQUALS JUST FALSE

-- 22(2)(b): Art 22(2)(b) point (b) applies: the decision is authorised by Union or Member State law which also lays down suitable measures
-- (b) authorised by law which also lays down suitable measures
#ASSERT `Under Article 22(2), as a controller, does point (b) apply to my decision: the decision is authorised by Union or Member State law which also lays down suitable measures` TRUE TRUE EQUALS JUST TRUE
-- (b) authorised, but the law lays down no suitable measures: 'and which also lays down'
#ASSERT `Under Article 22(2), as a controller, does point (b) apply to my decision: the decision is authorised by Union or Member State law which also lays down suitable measures` TRUE FALSE EQUALS JUST FALSE
-- (b) not authorised by law
#ASSERT `Under Article 22(2), as a controller, does point (b) apply to my decision: the decision is authorised by Union or Member State law which also lays down suitable measures` FALSE TRUE EQUALS JUST FALSE

-- 22(2)(c): Art 22(2)(c) point (c) applies: the decision is based on the data subject's explicit consent
-- (c) based on the data subject's explicit consent
#ASSERT `Under Article 22(2), as a controller, does point (c) apply to my decision: the decision is based on the data subject's explicit consent` TRUE EQUALS JUST TRUE
-- (c) no explicit consent
#ASSERT `Under Article 22(2), as a controller, does point (c) apply to my decision: the decision is based on the data subject's explicit consent` FALSE EQUALS JUST FALSE

-- 22(2): Art 22(2) paragraph 1 does not apply
-- point (a) holds
#ASSERT `Under Article 22(2), as a controller, does paragraph 1 not apply to my decision` `P2 controller answer: yes` `P2 controller answer: no` `P2 controller answer: no` EQUALS JUST TRUE
-- point (b) holds
#ASSERT `Under Article 22(2), as a controller, does paragraph 1 not apply to my decision` `P2 controller answer: no` `P2 controller answer: yes` `P2 controller answer: no` EQUALS JUST TRUE
-- point (c) holds
#ASSERT `Under Article 22(2), as a controller, does paragraph 1 not apply to my decision` `P2 controller answer: no` `P2 controller answer: no` `P2 controller answer: yes` EQUALS JUST TRUE
-- no point holds: 'if' fails in each
#ASSERT `Under Article 22(2), as a controller, does paragraph 1 not apply to my decision` `P2 controller answer: no` `P2 controller answer: no` `P2 controller answer: no` EQUALS JUST FALSE
-- no point holds and (c) is not decided: not covered
#ASSERT `Under Article 22(2), as a controller, does paragraph 1 not apply to my decision` `P2 controller answer: no` `P2 controller answer: no` `P2 controller answer: not sure` EQUALS NOTHING

-- 22(1): Art 22(1) the data subject has the right not to be subject to a decision based solely on automated processing which produces legal effects or similarly significantly affects him or her
-- solely automated, legal effects, no exception
#ASSERT `Under Article 22(1), as a controller, must I refrain from subjecting the data subject to a decision based solely on automated processing that produces legal effects or similarly significantly affects him or her` TRUE TRUE FALSE TRUE FALSE `P2 controller answer: no` EQUALS JUST TRUE
-- profiling (not read), a similarly significant effect, no exception
#ASSERT `Under Article 22(1), as a controller, must I refrain from subjecting the data subject to a decision based solely on automated processing that produces legal effects or similarly significantly affects him or her` TRUE TRUE TRUE FALSE TRUE `P2 controller answer: no` EQUALS JUST TRUE
-- no legal effect and no similarly significant effect: outside the grant
#ASSERT `Under Article 22(1), as a controller, must I refrain from subjecting the data subject to a decision based solely on automated processing that produces legal effects or similarly significantly affects him or her` TRUE TRUE FALSE FALSE FALSE `P2 controller answer: no` EQUALS NOTHING
-- not based solely on automated processing: outside the grant
#ASSERT `Under Article 22(1), as a controller, must I refrain from subjecting the data subject to a decision based solely on automated processing that produces legal effects or similarly significantly affects him or her` TRUE FALSE FALSE TRUE FALSE `P2 controller answer: no` EQUALS NOTHING
-- not the data subject
#ASSERT `Under Article 22(1), as a controller, must I refrain from subjecting the data subject to a decision based solely on automated processing that produces legal effects or similarly significantly affects him or her` FALSE TRUE FALSE TRUE FALSE `P2 controller answer: no` EQUALS NOTHING
-- paragraph 2 takes the decision out of paragraph 1: 'shall not apply'
#ASSERT `Under Article 22(1), as a controller, must I refrain from subjecting the data subject to a decision based solely on automated processing that produces legal effects or similarly significantly affects him or her` TRUE TRUE FALSE TRUE FALSE `P2 controller answer: yes` EQUALS JUST FALSE
-- whether paragraph 2 applies is not decided
#ASSERT `Under Article 22(1), as a controller, must I refrain from subjecting the data subject to a decision based solely on automated processing that produces legal effects or similarly significantly affects him or her` TRUE TRUE FALSE TRUE FALSE `P2 controller answer: not sure` EQUALS NOTHING

-- 22(3): Art 22(3) in the cases of points (a) and (c) of paragraph 2 the controller implements suitable measures, at least the right to human intervention, to express a point of view and to contest the decision
-- point (a) case, all three safeguards
#ASSERT `Under Article 22(3), as a controller, in a decision under point (a) or (c) of paragraph 2, have I implemented suitable measures, at least the right to human intervention, to express a point of view and to contest the decision` `P2 controller answer: yes` `P2 controller answer: no` TRUE TRUE TRUE TRUE EQUALS JUST `the duty arises and is met`
-- point (c) case, all three safeguards
#ASSERT `Under Article 22(3), as a controller, in a decision under point (a) or (c) of paragraph 2, have I implemented suitable measures, at least the right to human intervention, to express a point of view and to contest the decision` `P2 controller answer: no` `P2 controller answer: yes` TRUE TRUE TRUE TRUE EQUALS JUST `the duty arises and is met`
-- no right to obtain human intervention: 'at least'
#ASSERT `Under Article 22(3), as a controller, in a decision under point (a) or (c) of paragraph 2, have I implemented suitable measures, at least the right to human intervention, to express a point of view and to contest the decision` `P2 controller answer: yes` `P2 controller answer: no` TRUE FALSE TRUE TRUE EQUALS JUST `the duty arises and is not met`
-- no right to express a point of view
#ASSERT `Under Article 22(3), as a controller, in a decision under point (a) or (c) of paragraph 2, have I implemented suitable measures, at least the right to human intervention, to express a point of view and to contest the decision` `P2 controller answer: yes` `P2 controller answer: no` TRUE TRUE FALSE TRUE EQUALS JUST `the duty arises and is not met`
-- no right to contest the decision
#ASSERT `Under Article 22(3), as a controller, in a decision under point (a) or (c) of paragraph 2, have I implemented suitable measures, at least the right to human intervention, to express a point of view and to contest the decision` `P2 controller answer: yes` `P2 controller answer: no` TRUE TRUE TRUE FALSE EQUALS JUST `the duty arises and is not met`
-- no suitable measures at all
#ASSERT `Under Article 22(3), as a controller, in a decision under point (a) or (c) of paragraph 2, have I implemented suitable measures, at least the right to human intervention, to express a point of view and to contest the decision` `P2 controller answer: yes` `P2 controller answer: no` FALSE TRUE TRUE TRUE EQUALS JUST `the duty arises and is not met`
-- a point (b) decision, or none: outside 'the cases referred to in points (a) and (c)'
#ASSERT `Under Article 22(3), as a controller, in a decision under point (a) or (c) of paragraph 2, have I implemented suitable measures, at least the right to human intervention, to express a point of view and to contest the decision` `P2 controller answer: no` `P2 controller answer: no` TRUE TRUE TRUE TRUE EQUALS NOTHING

-- 22(4): Art 22(4) decisions referred to in paragraph 2 shall not be based on special categories of personal data referred to in Article 9(1)
-- point (a) of Article 9(2) applies and suitable measures are in place: 'unless'
#ASSERT `Under Article 22(4), as a controller, am I barred from basing a decision referred to in paragraph 2 on special categories of personal data` TRUE TRUE `P2 controller answer: yes` `P2 controller answer: no` TRUE EQUALS JUST FALSE
-- point (g) applies and suitable measures are in place
#ASSERT `Under Article 22(4), as a controller, am I barred from basing a decision referred to in paragraph 2 on special categories of personal data` TRUE TRUE `P2 controller answer: no` `P2 controller answer: yes` TRUE EQUALS JUST FALSE
-- point (a) applies but suitable measures are not in place: the bar stands
#ASSERT `Under Article 22(4), as a controller, am I barred from basing a decision referred to in paragraph 2 on special categories of personal data` TRUE TRUE `P2 controller answer: yes` `P2 controller answer: no` FALSE EQUALS JUST TRUE
-- neither point applies: the bar stands
#ASSERT `Under Article 22(4), as a controller, am I barred from basing a decision referred to in paragraph 2 on special categories of personal data` TRUE TRUE `P2 controller answer: no` `P2 controller answer: no` TRUE EQUALS JUST TRUE
-- neither applies, no measures
#ASSERT `Under Article 22(4), as a controller, am I barred from basing a decision referred to in paragraph 2 on special categories of personal data` TRUE TRUE `P2 controller answer: no` `P2 controller answer: no` FALSE EQUALS JUST TRUE
-- (a) and (g) both apply, but no suitable measures are in place: the 'unless' needs point (a) or (g) AND the measures, so the bar stands (R2)
#ASSERT `Under Article 22(4), as a controller, am I barred from basing a decision referred to in paragraph 2 on special categories of personal data` TRUE TRUE `P2 controller answer: yes` `P2 controller answer: yes` FALSE EQUALS JUST TRUE
-- point (a) not decided, (g) fails: not covered
#ASSERT `Under Article 22(4), as a controller, am I barred from basing a decision referred to in paragraph 2 on special categories of personal data` TRUE TRUE `P2 controller answer: not sure` `P2 controller answer: no` TRUE EQUALS NOTHING


§§ `Article 23: restrictions`

-- 23(1)a: Art 23(1) Union or Member State law may restrict by way of a legislative measure the scope of the obligations and rights
-- objective (a): a legislative measure of Union or Member State law that respects the essence and is necessary and proportionate
#ASSERT `Under Article 23(1), as a controller, may Union or Member State law restrict by a legislative measure the scope of my obligations under Articles 12 to 22` TRUE TRUE `Art 23(1) an obligation or a right provided for in Articles 12 to 22` `Art 23(1)(a) national security` FALSE TRUE TRUE EQUALS JUST TRUE
-- objective (b): a legislative measure of Union or Member State law that respects the essence and is necessary and proportionate
#ASSERT `Under Article 23(1), as a controller, may Union or Member State law restrict by a legislative measure the scope of my obligations under Articles 12 to 22` TRUE TRUE `Art 23(1) an obligation or a right provided for in Articles 12 to 22` `Art 23(1)(b) defence` FALSE TRUE TRUE EQUALS JUST TRUE
-- objective (c): a legislative measure of Union or Member State law that respects the essence and is necessary and proportionate
#ASSERT `Under Article 23(1), as a controller, may Union or Member State law restrict by a legislative measure the scope of my obligations under Articles 12 to 22` TRUE TRUE `Art 23(1) an obligation or a right provided for in Articles 12 to 22` `Art 23(1)(c) public security` FALSE TRUE TRUE EQUALS JUST TRUE
-- objective (d): a legislative measure of Union or Member State law that respects the essence and is necessary and proportionate
#ASSERT `Under Article 23(1), as a controller, may Union or Member State law restrict by a legislative measure the scope of my obligations under Articles 12 to 22` TRUE TRUE `Art 23(1) an obligation or a right provided for in Articles 12 to 22` `Art 23(1)(d) the prevention, investigation, detection or prosecution of criminal offences or the execution of criminal penalties, including the safeguarding against and the prevention of threats to public security` FALSE TRUE TRUE EQUALS JUST TRUE
-- objective (e): a legislative measure of Union or Member State law that respects the essence and is necessary and proportionate
#ASSERT `Under Article 23(1), as a controller, may Union or Member State law restrict by a legislative measure the scope of my obligations under Articles 12 to 22` TRUE TRUE `Art 23(1) an obligation or a right provided for in Articles 12 to 22` `Art 23(1)(e) other important objectives of general public interest of the Union or of a Member State, in particular an important economic or financial interest, including monetary, budgetary and taxation matters, public health and social security` FALSE TRUE TRUE EQUALS JUST TRUE
-- objective (h) with no such connection: not point (h)
#ASSERT `Under Article 23(1), as a controller, may Union or Member State law restrict by a legislative measure the scope of my obligations under Articles 12 to 22` TRUE TRUE `Art 23(1) an obligation or a right provided for in Articles 12 to 22` `Art 23(1)(h) a monitoring, inspection or regulatory function connected, even occasionally, to the exercise of official authority in the cases referred to in points (a) to (e) and (g)` FALSE TRUE TRUE EQUALS NOTHING
-- the restriction does not respect the essence of the fundamental rights and freedoms: 'when' fails
#ASSERT `Under Article 23(1), as a controller, may Union or Member State law restrict by a legislative measure the scope of my obligations under Articles 12 to 22` TRUE TRUE `Art 23(1) an obligation or a right provided for in Articles 12 to 22` `Art 23(1)(a) national security` FALSE FALSE TRUE EQUALS JUST FALSE

-- 23(1)b: Art 23(1) the law is a necessary and proportionate measure in a democratic society to safeguard one of the objectives referred to in Article 23(1)
-- national security, necessary and proportionate
#ASSERT `Under Article 23(1), as a controller, is the law that restricts my obligations a necessary and proportionate measure in a democratic society to safeguard one of the objectives that paragraph 1 names` `Art 23(1)(a) national security` TRUE EQUALS JUST TRUE
-- the enforcement of civil law claims, necessary and proportionate
#ASSERT `Under Article 23(1), as a controller, is the law that restricts my obligations a necessary and proportionate measure in a democratic society to safeguard one of the objectives that paragraph 1 names` `Art 23(1)(j) the enforcement of civil law claims` TRUE EQUALS JUST TRUE
-- not necessary and proportionate: 'when' fails
#ASSERT `Under Article 23(1), as a controller, is the law that restricts my obligations a necessary and proportionate measure in a democratic society to safeguard one of the objectives that paragraph 1 names` `Art 23(1)(a) national security` FALSE EQUALS JUST FALSE
-- an objective outside points (a) to (j): not decided
#ASSERT `Under Article 23(1), as a controller, is the law that restricts my obligations a necessary and proportionate measure in a democratic society to safeguard one of the objectives that paragraph 1 names` `Art 23(1) some other objective` TRUE EQUALS NOTHING

-- 23(2): Art 23(2) the legislative measure contains specific provisions at least, where relevant, as to the matters that paragraph 2 lists
-- three relevant matters, all three provided for
#ASSERT `Under Article 23(2), as a controller, does the legislative measure that restricts my obligations contain specific provisions at least, where relevant, as to the matters that paragraph 2 lists` TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- one relevant matter (c) not provided for: 'shall contain ... at least, where relevant'
#ASSERT `Under Article 23(2), as a controller, does the legislative measure that restricts my obligations contain specific provisions at least, where relevant, as to the matters that paragraph 2 lists` TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- nothing is relevant: nothing is required
#ASSERT `Under Article 23(2), as a controller, does the legislative measure that restricts my obligations contain specific provisions at least, where relevant, as to the matters that paragraph 2 lists` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- the measure also provides for an irrelevant matter: 'at least'
#ASSERT `Under Article 23(2), as a controller, does the legislative measure that restricts my obligations contain specific provisions at least, where relevant, as to the matters that paragraph 2 lists` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- (h) informing the data subject may be prejudicial to the purpose of the restriction: not required ('unless')
#ASSERT `Under Article 23(2), as a controller, does the legislative measure that restricts my obligations contain specific provisions at least, where relevant, as to the matters that paragraph 2 lists` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- (h) relevant, not prejudicial, and not provided for
#ASSERT `Under Article 23(2), as a controller, does the legislative measure that restricts my obligations contain specific provisions at least, where relevant, as to the matters that paragraph 2 lists` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- (h) provided for
#ASSERT `Under Article 23(2), as a controller, does the legislative measure that restricts my obligations contain specific provisions at least, where relevant, as to the matters that paragraph 2 lists` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
