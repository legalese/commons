IMPORT prelude
IMPORT `gdpr-core`
IMPORT `P2-art-15`

-- ============================================================================
-- P2-tests-art-15.l4 -- tests of Article 15 (src:206-219).
-- Every expected value was written by hand from the text of the provision named in the comment above it,
-- before the first run, and none was copied from an output (notes/gen-tests-p2.py holds the cases).
-- A #TRACE result is not an assertion and check.sh does not count it; each trace comment gives the expected result.
-- ============================================================================

§ `Art 15(1): confirmation`

-- a data subject and the controller; Article 11(2) does not apply to the case
#ASSERT `Art 15(1) the data subject has the right to obtain from the controller confirmation as to whether or not personal data concerning him or her are being processed` TRUE TRUE NOTHING EQUALS JUST TRUE
-- an Article 11(2) case in which the data subject provided identifying information: the articles apply again
#ASSERT `Art 15(1) the data subject has the right to obtain from the controller confirmation as to whether or not personal data concerning him or her are being processed` TRUE TRUE (JUST FALSE) EQUALS JUST TRUE
-- Article 11(2) disapplies Articles 15 to 20: 'shall not apply'
#ASSERT `Art 15(1) the data subject has the right to obtain from the controller confirmation as to whether or not personal data concerning him or her are being processed` TRUE TRUE (JUST TRUE) EQUALS JUST FALSE
-- the person is not the data subject: the grant is to the data subject, and the text is silent about anyone else
#ASSERT `Art 15(1) the data subject has the right to obtain from the controller confirmation as to whether or not personal data concerning him or her are being processed` FALSE TRUE NOTHING EQUALS NOTHING
-- the body asked is not the controller: the right is against the controller
#ASSERT `Art 15(1) the data subject has the right to obtain from the controller confirmation as to whether or not personal data concerning him or her are being processed` TRUE FALSE NOTHING EQUALS NOTHING

§ `Art 15(1): access, 'where that is the case'`

-- personal data concerning the data subject are being processed
#ASSERT `Art 15(1) the data subject has the right to obtain from the controller access to the personal data` TRUE TRUE TRUE NOTHING EQUALS JUST TRUE
-- no personal data are being processed: 'where that is the case' fails (ruling (b))
#ASSERT `Art 15(1) the data subject has the right to obtain from the controller access to the personal data` TRUE TRUE FALSE NOTHING EQUALS JUST FALSE
-- Article 11(2) disapplies Articles 15 to 20
#ASSERT `Art 15(1) the data subject has the right to obtain from the controller access to the personal data` TRUE TRUE TRUE (JUST TRUE) EQUALS JUST FALSE
-- both bars
#ASSERT `Art 15(1) the data subject has the right to obtain from the controller access to the personal data` TRUE TRUE FALSE (JUST TRUE) EQUALS JUST FALSE
-- not the data subject
#ASSERT `Art 15(1) the data subject has the right to obtain from the controller access to the personal data` FALSE TRUE TRUE NOTHING EQUALS NOTHING
-- not the controller
#ASSERT `Art 15(1) the data subject has the right to obtain from the controller access to the personal data` TRUE FALSE TRUE NOTHING EQUALS NOTHING
-- point (a) of paragraph 1: the right to the information, personal data being processed
#ASSERT `Art 15(1) the data subject has the right to obtain from the controller the following information` TRUE TRUE TRUE `Art 15(1)(a) the purposes of the processing` FALSE FALSE NOTHING EQUALS JUST TRUE
-- point (b) of paragraph 1: the right to the information, personal data being processed
#ASSERT `Art 15(1) the data subject has the right to obtain from the controller the following information` TRUE TRUE TRUE `Art 15(1)(b) the categories of personal data concerned` FALSE FALSE NOTHING EQUALS JUST TRUE
-- point (c) of paragraph 1: the right to the information, personal data being processed
#ASSERT `Art 15(1) the data subject has the right to obtain from the controller the following information` TRUE TRUE TRUE `Art 15(1)(c) the recipients or categories of recipient to whom the personal data have been or will be disclosed` FALSE FALSE NOTHING EQUALS JUST TRUE
-- point (d) of paragraph 1: the right to the information, personal data being processed
#ASSERT `Art 15(1) the data subject has the right to obtain from the controller the following information` TRUE TRUE TRUE `Art 15(1)(d) the envisaged period for which the personal data will be stored, or the criteria used to determine that period` FALSE FALSE NOTHING EQUALS JUST TRUE
-- point (e) of paragraph 1: the right to the information, personal data being processed
#ASSERT `Art 15(1) the data subject has the right to obtain from the controller the following information` TRUE TRUE TRUE `Art 15(1)(e) the existence of the right to request rectification or erasure of personal data or restriction of processing, or to object to such processing` FALSE FALSE NOTHING EQUALS JUST TRUE
-- point (f) of paragraph 1: the right to the information, personal data being processed
#ASSERT `Art 15(1) the data subject has the right to obtain from the controller the following information` TRUE TRUE TRUE `Art 15(1)(f) the right to lodge a complaint with a supervisory authority` FALSE FALSE NOTHING EQUALS JUST TRUE
-- (g) the data are not collected from the data subject: any available information as to the source
#ASSERT `Art 15(1) the data subject has the right to obtain from the controller the following information` TRUE TRUE TRUE `Art 15(1)(g) any available information as to the source of the personal data` TRUE FALSE NOTHING EQUALS JUST TRUE
-- (g) the data are collected from the data subject: 'where the personal data are not collected from the data subject' fails
#ASSERT `Art 15(1) the data subject has the right to obtain from the controller the following information` TRUE TRUE TRUE `Art 15(1)(g) any available information as to the source of the personal data` FALSE FALSE NOTHING EQUALS JUST FALSE
-- (h) automated decision-making referred to in Article 22(1) and (4) exists
#ASSERT `Art 15(1) the data subject has the right to obtain from the controller the following information` TRUE TRUE TRUE `Art 15(1)(h) the existence of automated decision-making, including profiling, and meaningful information about the logic involved, the significance and the envisaged consequences` FALSE TRUE NOTHING EQUALS JUST TRUE
-- (h) there is no such decision-making: nothing whose existence can be obtained; the text does not say no
#ASSERT `Art 15(1) the data subject has the right to obtain from the controller the following information` TRUE TRUE TRUE `Art 15(1)(h) the existence of automated decision-making, including profiling, and meaningful information about the logic involved, the significance and the envisaged consequences` FALSE FALSE NOTHING EQUALS NOTHING
-- no personal data are being processed: 'where that is the case' fails, whatever the item
#ASSERT `Art 15(1) the data subject has the right to obtain from the controller the following information` TRUE TRUE FALSE `Art 15(1)(a) the purposes of the processing` FALSE FALSE NOTHING EQUALS JUST FALSE
-- Article 11(2) disapplies Articles 15 to 20
#ASSERT `Art 15(1) the data subject has the right to obtain from the controller the following information` TRUE TRUE TRUE `Art 15(1)(a) the purposes of the processing` FALSE FALSE (JUST TRUE) EQUALS JUST FALSE
-- not the data subject
#ASSERT `Art 15(1) the data subject has the right to obtain from the controller the following information` FALSE TRUE TRUE `Art 15(1)(a) the purposes of the processing` FALSE FALSE NOTHING EQUALS NOTHING
-- not the controller
#ASSERT `Art 15(1) the data subject has the right to obtain from the controller the following information` TRUE FALSE TRUE `Art 15(1)(a) the purposes of the processing` FALSE FALSE NOTHING EQUALS NOTHING

§ `Art 15(2): safeguards for a transfer`

-- personal data are transferred to a third country: the right to be informed of the Article 46 safeguards
#ASSERT `Art 15(2) the data subject has the right to be informed of the appropriate safeguards pursuant to Article 46 relating to the transfer` TRUE TRUE TRUE NOTHING EQUALS JUST TRUE
-- no transfer: 'Where personal data are transferred' fails (ruling (b))
#ASSERT `Art 15(2) the data subject has the right to be informed of the appropriate safeguards pursuant to Article 46 relating to the transfer` TRUE TRUE FALSE NOTHING EQUALS JUST FALSE
-- Article 11(2) disapplies Articles 15 to 20
#ASSERT `Art 15(2) the data subject has the right to be informed of the appropriate safeguards pursuant to Article 46 relating to the transfer` TRUE TRUE TRUE (JUST TRUE) EQUALS JUST FALSE
-- not the data subject
#ASSERT `Art 15(2) the data subject has the right to be informed of the appropriate safeguards pursuant to Article 46 relating to the transfer` FALSE TRUE TRUE NOTHING EQUALS NOTHING
-- FULFILLED: the controller confirms and gives access
#TRACE `Art 15(1) the controller must confirm whether personal data concerning the data subject are being processed and give access` NOTHING AT 0 WITH
    PARTY controller DOES `Art 15(1) confirm to the data subject whether or not personal data concerning him or her are being processed, and give access` AT 1
-- no act: the obligation stands; no breach is possible (no time limit in the text)
#TRACE `Art 15(1) the controller must confirm whether personal data concerning the data subject are being processed and give access` NOTHING AT 0 WITH
    (WAITUNTIL 1000)
-- FULFILLED: Article 11(2) disapplies Articles 15 to 20
#TRACE `Art 15(1) the controller must confirm whether personal data concerning the data subject are being processed and give access` (JUST TRUE) AT 0 WITH
    (WAITUNTIL 1000)

§ `Art 15(3) and (4): the copy`

-- personal data undergoing processing, copy provided
#ASSERT `Art 15(3) the controller provides a copy of the personal data undergoing processing` TRUE TRUE NOTHING EQUALS JUST `the duty arises and is met`
-- undergoing processing, no copy: 'shall provide a copy'
#ASSERT `Art 15(3) the controller provides a copy of the personal data undergoing processing` TRUE FALSE NOTHING EQUALS JUST `the duty arises and is not met`
-- no personal data undergoing processing: nothing to copy; the text is silent
#ASSERT `Art 15(3) the controller provides a copy of the personal data undergoing processing` FALSE FALSE NOTHING EQUALS NOTHING
-- Article 11(2) disapplies Articles 15 to 20: 'shall not apply'
#ASSERT `Art 15(3) the controller provides a copy of the personal data undergoing processing` TRUE FALSE (JUST TRUE) EQUALS JUST `the duty does not arise`
-- an Article 11(2) case with identifying information: the article applies, and the copy was provided
#ASSERT `Art 15(3) the controller provides a copy of the personal data undergoing processing` TRUE TRUE (JUST FALSE) EQUALS JUST `the duty arises and is met`
-- FULFILLED: the copy is provided
#TRACE `Art 15(3) the controller must provide a copy of the personal data undergoing processing` TRUE NOTHING AT 0 WITH
    PARTY controller DOES `Art 15(3) provide a copy of the personal data undergoing processing` AT 1
-- no act: the obligation stands; no breach is possible (no time limit in the text)
#TRACE `Art 15(3) the controller must provide a copy of the personal data undergoing processing` TRUE NOTHING AT 0 WITH
    (WAITUNTIL 1000)
-- FULFILLED: nothing is undergoing processing
#TRACE `Art 15(3) the controller must provide a copy of the personal data undergoing processing` FALSE NOTHING AT 0 WITH
    (WAITUNTIL 1000)
-- FULFILLED: Article 11(2) disapplies Articles 15 to 20
#TRACE `Art 15(3) the controller must provide a copy of the personal data undergoing processing` TRUE (JUST TRUE) AT 0 WITH
    (WAITUNTIL 1000)
-- a further copy requested, a reasonable fee based on administrative costs
#ASSERT `Art 15(3) the controller may charge a reasonable fee based on administrative costs for any further copies requested by the data subject` TRUE TRUE EQUALS JUST TRUE
-- a further copy, but the fee is not reasonable or not based on costs: outside the grant
#ASSERT `Art 15(3) the controller may charge a reasonable fee based on administrative costs for any further copies requested by the data subject` TRUE FALSE EQUALS NOTHING
-- the first copy: 'any further copies' is not met; Article 12(5) answers it
#ASSERT `Art 15(3) the controller may charge a reasonable fee based on administrative costs for any further copies requested by the data subject` FALSE TRUE EQUALS NOTHING
-- neither
#ASSERT `Art 15(3) the controller may charge a reasonable fee based on administrative costs for any further copies requested by the data subject` FALSE FALSE EQUALS NOTHING
-- electronic request, not requested otherwise, provided in a commonly used electronic form
#ASSERT `Art 15(3) the information is provided in a commonly used electronic form where the request is made by electronic means` TRUE FALSE TRUE EQUALS JUST `the duty arises and is met`
-- electronic request, not requested otherwise, not provided electronically
#ASSERT `Art 15(3) the information is provided in a commonly used electronic form where the request is made by electronic means` TRUE FALSE FALSE EQUALS JUST `the duty arises and is not met`
-- the request is not by electronic means: 'Where' fails
#ASSERT `Art 15(3) the information is provided in a commonly used electronic form where the request is made by electronic means` FALSE FALSE FALSE EQUALS JUST `the duty does not arise`
-- the data subject requested otherwise: 'unless otherwise requested'
#ASSERT `Art 15(3) the information is provided in a commonly used electronic form where the request is made by electronic means` TRUE TRUE FALSE EQUALS JUST `the duty does not arise`
-- the copy would adversely affect the rights and freedoms of others: 'shall not adversely affect'
#ASSERT `Art 15(4) the right to obtain a copy is limited because the copy would adversely affect the rights and freedoms of others` TRUE EQUALS JUST TRUE
-- no adverse effect: the limit is not engaged and the paragraph is silent
#ASSERT `Art 15(4) the right to obtain a copy is limited because the copy would adversely affect the rights and freedoms of others` FALSE EQUALS NOTHING
