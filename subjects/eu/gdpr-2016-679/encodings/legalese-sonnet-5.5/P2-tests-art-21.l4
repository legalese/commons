IMPORT prelude
IMPORT `gdpr-core`
IMPORT `P2-art-21`

-- ============================================================================
-- P2-tests-art-21.l4 -- tests of Article 21 (src:263-270).
-- Every expected value was written by hand from the text of the provision named in the comment above it,
-- before the first run, and none was copied from an output (notes/gen-tests-p2.py holds the cases).
-- A #TRACE result is not an assertion and check.sh does not count it; each trace comment gives the expected result.
-- ============================================================================

§ `Art 21(1): the right to object to processing based on point (e) or (f)`

-- processing based on point (e), objection on grounds of the particular situation
#ASSERT `Art 21(1) the data subject has the right to object, on grounds relating to his or her particular situation, to processing which is based on point (e) or (f) of Article 6(1)` TRUE TRUE TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
-- processing based on point (f)
#ASSERT `Art 21(1) the data subject has the right to object, on grounds relating to his or her particular situation, to processing which is based on point (e) or (f) of Article 6(1)` TRUE TRUE TRUE (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
-- point (f) holds whatever (e) is
#ASSERT `Art 21(1) the data subject has the right to object, on grounds relating to his or her particular situation, to processing which is based on point (e) or (f) of Article 6(1)` TRUE TRUE TRUE NOTHING (JUST TRUE) EQUALS JUST TRUE
-- processing on another basis: outside 'which is based on point (e) or (f)'; the text does not say no
#ASSERT `Art 21(1) the data subject has the right to object, on grounds relating to his or her particular situation, to processing which is based on point (e) or (f) of Article 6(1)` TRUE TRUE TRUE (JUST FALSE) (JUST FALSE) EQUALS NOTHING
-- neither holds and (e) is not decided: not covered
#ASSERT `Art 21(1) the data subject has the right to object, on grounds relating to his or her particular situation, to processing which is based on point (e) or (f) of Article 6(1)` TRUE TRUE TRUE NOTHING (JUST FALSE) EQUALS NOTHING
-- an objection not on grounds relating to the particular situation: outside the grant
#ASSERT `Art 21(1) the data subject has the right to object, on grounds relating to his or her particular situation, to processing which is based on point (e) or (f) of Article 6(1)` TRUE TRUE FALSE (JUST TRUE) (JUST FALSE) EQUALS NOTHING
-- not the data subject
#ASSERT `Art 21(1) the data subject has the right to object, on grounds relating to his or her particular situation, to processing which is based on point (e) or (f) of Article 6(1)` FALSE TRUE TRUE (JUST TRUE) (JUST FALSE) EQUALS NOTHING
-- not the controller
#ASSERT `Art 21(1) the data subject has the right to object, on grounds relating to his or her particular situation, to processing which is based on point (e) or (f) of Article 6(1)` TRUE FALSE TRUE (JUST TRUE) (JUST FALSE) EQUALS NOTHING
-- objected, and the controller demonstrates no compelling grounds: it shall no longer process
#ASSERT `Art 21(1) the controller shall no longer process the personal data unless the controller demonstrates compelling legitimate grounds` TRUE FALSE FALSE EQUALS JUST TRUE
-- compelling legitimate grounds that override the interests of the data subject: 'unless'
#ASSERT `Art 21(1) the controller shall no longer process the personal data unless the controller demonstrates compelling legitimate grounds` TRUE TRUE FALSE EQUALS JUST FALSE
-- compelling legitimate grounds for legal claims: 'unless'
#ASSERT `Art 21(1) the controller shall no longer process the personal data unless the controller demonstrates compelling legitimate grounds` TRUE FALSE TRUE EQUALS JUST FALSE
-- both
#ASSERT `Art 21(1) the controller shall no longer process the personal data unless the controller demonstrates compelling legitimate grounds` TRUE TRUE TRUE EQUALS JUST FALSE
-- no objection: the sentence follows an objection and the text is silent otherwise
#ASSERT `Art 21(1) the controller shall no longer process the personal data unless the controller demonstrates compelling legitimate grounds` FALSE FALSE FALSE EQUALS NOTHING
-- BREACH: processing after the objection, with no compelling grounds (the act is the breach)
#TRACE `Art 21(1) the controller must no longer process the personal data after the objection` (JUST TRUE) AT 0 WITH
    PARTY controller DOES `Art 21(1) process the personal data after the objection` AT 1
-- no further processing: the prohibition stands, unbroken
#TRACE `Art 21(1) the controller must no longer process the personal data after the objection` (JUST TRUE) AT 0 WITH
    (WAITUNTIL 1000)
-- FULFILLED: the controller demonstrates compelling grounds, so the bar does not stand
#TRACE `Art 21(1) the controller must no longer process the personal data after the objection` (JUST FALSE) AT 0 WITH
    PARTY controller DOES `Art 21(1) process the personal data after the objection` AT 1
-- FULFILLED: no objection (not covered), so the rule creates no bar
#TRACE `Art 21(1) the controller must no longer process the personal data after the objection` NOTHING AT 0 WITH
    PARTY controller DOES `Art 21(1) process the personal data after the objection` AT 1

§ `Art 21(2) and (3): direct marketing`

-- personal data processed for direct marketing purposes
#ASSERT `Art 21(2) the data subject has the right to object at any time to processing of personal data concerning him or her for direct marketing` TRUE TRUE TRUE EQUALS JUST TRUE
-- not processed for direct marketing: 'Where' fails
#ASSERT `Art 21(2) the data subject has the right to object at any time to processing of personal data concerning him or her for direct marketing` TRUE TRUE FALSE EQUALS JUST FALSE
-- not the data subject
#ASSERT `Art 21(2) the data subject has the right to object at any time to processing of personal data concerning him or her for direct marketing` FALSE TRUE TRUE EQUALS NOTHING
-- not the controller
#ASSERT `Art 21(2) the data subject has the right to object at any time to processing of personal data concerning him or her for direct marketing` TRUE FALSE TRUE EQUALS NOTHING
-- the data subject objects to processing for direct marketing: the data shall no longer be processed for those purposes
#ASSERT `Art 21(3) the personal data shall no longer be processed for direct marketing purposes` TRUE EQUALS JUST TRUE
-- no objection: 'Where the data subject objects' fails
#ASSERT `Art 21(3) the personal data shall no longer be processed for direct marketing purposes` FALSE EQUALS JUST FALSE
-- BREACH: direct marketing after the objection
#TRACE `Art 21(3) the controller must no longer process the personal data for direct marketing purposes after the objection` TRUE AT 0 WITH
    PARTY controller DOES `Art 21(3) process the personal data for direct marketing purposes after the objection` AT 1
-- no direct marketing: the prohibition stands, unbroken
#TRACE `Art 21(3) the controller must no longer process the personal data for direct marketing purposes after the objection` TRUE AT 0 WITH
    (WAITUNTIL 1000)
-- FULFILLED: no objection
#TRACE `Art 21(3) the controller must no longer process the personal data for direct marketing purposes after the objection` FALSE AT 0 WITH
    PARTY controller DOES `Art 21(3) process the personal data for direct marketing purposes after the objection` AT 1

§ `Art 21(4) to (6)`

-- explicitly brought to the attention, presented clearly and separately, at the time of the first communication
#ASSERT `Art 21(4) the right to object is explicitly brought to the attention of the data subject, clearly and separately, at the latest at the time of the first communication` TRUE TRUE TRUE EQUALS JUST TRUE
-- not at the latest at the time of the first communication
#ASSERT `Art 21(4) the right to object is explicitly brought to the attention of the data subject, clearly and separately, at the latest at the time of the first communication` TRUE TRUE FALSE EQUALS JUST FALSE
-- not presented clearly and separately
#ASSERT `Art 21(4) the right to object is explicitly brought to the attention of the data subject, clearly and separately, at the latest at the time of the first communication` TRUE FALSE TRUE EQUALS JUST FALSE
-- not explicitly brought to the attention
#ASSERT `Art 21(4) the right to object is explicitly brought to the attention of the data subject, clearly and separately, at the latest at the time of the first communication` FALSE TRUE TRUE EQUALS JUST FALSE
-- in the context of the use of information society services
#ASSERT `Art 21(5) the data subject may exercise the right to object by automated means using technical specifications` TRUE EQUALS JUST TRUE
-- another context: outside the grant
#ASSERT `Art 21(5) the data subject may exercise the right to object by automated means using technical specifications` FALSE EQUALS NOTHING
-- scientific research purposes pursuant to Article 89(1)
#ASSERT `Art 21(6) the data subject has the right to object to processing for scientific or historical research purposes or statistical purposes` TRUE TRUE `Art 5(1)(b) scientific research purposes` TRUE TRUE FALSE EQUALS JUST TRUE
-- historical research purposes
#ASSERT `Art 21(6) the data subject has the right to object to processing for scientific or historical research purposes or statistical purposes` TRUE TRUE `Art 5(1)(b) historical research purposes` TRUE TRUE FALSE EQUALS JUST TRUE
-- statistical purposes
#ASSERT `Art 21(6) the data subject has the right to object to processing for scientific or historical research purposes or statistical purposes` TRUE TRUE `Art 5(1)(b) statistical purposes` TRUE TRUE FALSE EQUALS JUST TRUE
-- archiving purposes in the public interest are not on the list: 'Where' fails
#ASSERT `Art 21(6) the data subject has the right to object to processing for scientific or historical research purposes or statistical purposes` TRUE TRUE `Art 5(1)(b) archiving purposes in the public interest` TRUE TRUE FALSE EQUALS JUST FALSE
-- another purpose: 'Where' fails
#ASSERT `Art 21(6) the data subject has the right to object to processing for scientific or historical research purposes or statistical purposes` TRUE TRUE `Art 5(1)(b) some other purpose` TRUE TRUE FALSE EQUALS JUST FALSE
-- research purposes but not pursuant to Article 89(1)
#ASSERT `Art 21(6) the data subject has the right to object to processing for scientific or historical research purposes or statistical purposes` TRUE TRUE `Art 5(1)(b) scientific research purposes` FALSE TRUE FALSE EQUALS JUST FALSE
-- an objection not on grounds relating to the particular situation: outside the grant
#ASSERT `Art 21(6) the data subject has the right to object to processing for scientific or historical research purposes or statistical purposes` TRUE TRUE `Art 5(1)(b) scientific research purposes` TRUE FALSE FALSE EQUALS NOTHING
-- the processing is necessary for a task for reasons of public interest: 'unless'
#ASSERT `Art 21(6) the data subject has the right to object to processing for scientific or historical research purposes or statistical purposes` TRUE TRUE `Art 5(1)(b) scientific research purposes` TRUE TRUE TRUE EQUALS JUST FALSE
-- not the data subject
#ASSERT `Art 21(6) the data subject has the right to object to processing for scientific or historical research purposes or statistical purposes` FALSE TRUE `Art 5(1)(b) scientific research purposes` TRUE TRUE FALSE EQUALS NOTHING
