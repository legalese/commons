IMPORT prelude
IMPORT `gdpr-core`
IMPORT `P2-art-16`

-- ============================================================================
-- P2-tests-art-16.l4 -- tests of Article 16 (src:222-224).
-- Every expected value was written by hand from the text of the provision named in the comment above it,
-- before the first run, and none was copied from an output (notes/gen-tests-p2.py holds the cases).
-- A #TRACE result is not an assertion and check.sh does not count it; each trace comment gives the expected result.
-- ============================================================================

§ `Art 16 first sentence: rectification of inaccurate data`

-- inaccurate personal data, a data subject and the controller
#ASSERT `Art 16 the data subject has the right to obtain from the controller the rectification of inaccurate personal data concerning him or her` TRUE TRUE TRUE NOTHING EQUALS JUST TRUE
-- the data are accurate: outside 'inaccurate personal data'; the text does not say no
#ASSERT `Art 16 the data subject has the right to obtain from the controller the rectification of inaccurate personal data concerning him or her` TRUE TRUE FALSE NOTHING EQUALS NOTHING
-- Article 11(2) disapplies Articles 15 to 20 (Article 16 is among them)
#ASSERT `Art 16 the data subject has the right to obtain from the controller the rectification of inaccurate personal data concerning him or her` TRUE TRUE TRUE (JUST TRUE) EQUALS JUST FALSE
-- an Article 11(2) case with identifying information: the right applies
#ASSERT `Art 16 the data subject has the right to obtain from the controller the rectification of inaccurate personal data concerning him or her` TRUE TRUE TRUE (JUST FALSE) EQUALS JUST TRUE
-- not the data subject
#ASSERT `Art 16 the data subject has the right to obtain from the controller the rectification of inaccurate personal data concerning him or her` FALSE TRUE TRUE NOTHING EQUALS NOTHING
-- not the controller
#ASSERT `Art 16 the data subject has the right to obtain from the controller the rectification of inaccurate personal data concerning him or her` TRUE FALSE TRUE NOTHING EQUALS NOTHING

§ `Art 16 second sentence: completion, taking into account the purposes`

-- incomplete data, completion called for by the purposes
#ASSERT `Art 16 the data subject has the right to have incomplete personal data completed` TRUE TRUE TRUE TRUE FALSE NOTHING EQUALS JUST TRUE
-- a supplementary statement is provided: 'including by means of providing a supplementary statement' is an example, not a condition
#ASSERT `Art 16 the data subject has the right to have incomplete personal data completed` TRUE TRUE TRUE TRUE TRUE NOTHING EQUALS JUST TRUE
-- incomplete, but the purposes do not call for completion: outside the grant
#ASSERT `Art 16 the data subject has the right to have incomplete personal data completed` TRUE TRUE TRUE FALSE FALSE NOTHING EQUALS NOTHING
-- the data are complete
#ASSERT `Art 16 the data subject has the right to have incomplete personal data completed` TRUE TRUE FALSE TRUE FALSE NOTHING EQUALS NOTHING
-- Article 11(2) disapplies Articles 15 to 20
#ASSERT `Art 16 the data subject has the right to have incomplete personal data completed` TRUE TRUE TRUE TRUE FALSE (JUST TRUE) EQUALS JUST FALSE
-- not the data subject
#ASSERT `Art 16 the data subject has the right to have incomplete personal data completed` FALSE TRUE TRUE TRUE FALSE NOTHING EQUALS NOTHING
-- FULFILLED: the controller rectifies
#TRACE `Art 16 the controller must rectify the inaccurate personal data without undue delay` TRUE NOTHING AT 0 WITH
    PARTY controller DOES `Art 16 rectify the inaccurate personal data concerning the data subject without undue delay` AT 1
-- no act, a long time later: the obligation stands; 'without undue delay' is not a number, so nothing breaches
#TRACE `Art 16 the controller must rectify the inaccurate personal data without undue delay` TRUE NOTHING AT 0 WITH
    (WAITUNTIL 1000)
-- FULFILLED: no inaccurate data
#TRACE `Art 16 the controller must rectify the inaccurate personal data without undue delay` FALSE NOTHING AT 0 WITH
    (WAITUNTIL 1000)
-- FULFILLED: Article 11(2) disapplies Articles 15 to 20
#TRACE `Art 16 the controller must rectify the inaccurate personal data without undue delay` TRUE (JUST TRUE) AT 0 WITH
    (WAITUNTIL 1000)

§ `Art 16, second sentence: the controller must complete incomplete data (R8)`

-- FULFILLED: the controller completes the data
#TRACE `Art 16 the controller must complete the incomplete personal data` (JUST TRUE) AT 0 WITH
    PARTY controller DOES `Art 16 complete the incomplete personal data concerning the data subject` AT 1
-- no act: the obligation stands; no breach is possible (no time limit)
#TRACE `Art 16 the controller must complete the incomplete personal data` (JUST TRUE) AT 0 WITH
    (WAITUNTIL 1000)
-- FULFILLED: there is no right to completion on these facts
#TRACE `Art 16 the controller must complete the incomplete personal data` (JUST FALSE) AT 0 WITH
    (WAITUNTIL 1000)
-- FULFILLED: the right is not established (not covered), so the rule creates no standing duty
#TRACE `Art 16 the controller must complete the incomplete personal data` NOTHING AT 0 WITH
    (WAITUNTIL 1000)
