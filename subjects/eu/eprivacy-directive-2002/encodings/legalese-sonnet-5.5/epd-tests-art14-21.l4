IMPORT prelude
IMPORT daydate
IMPORT `epd-nouns`
IMPORT `epd-art14-21`

-- Tests for Articles 14 to 21 (the encoded rows). Expected values were decided from the text before the run.

§ `Art 14`
--  ruler: mandatory, for specific technical features, imposed on terminal or other equipment, could impede the placing on the market, paragraph 2 or 3 applies
#ASSERT `Art 14(1) the mandatory requirement for specific technical features may be imposed` TRUE  TRUE  TRUE  TRUE  FALSE EQUALS JUST FALSE
-- subject to paragraphs 2 and 3
#ASSERT `Art 14(1) the mandatory requirement for specific technical features may be imposed` TRUE  TRUE  TRUE  TRUE  TRUE  EQUALS NOTHING
-- one element of the sentence missing: not covered
#ASSERT `Art 14(1) the mandatory requirement for specific technical features may be imposed` FALSE TRUE  TRUE  TRUE  FALSE EQUALS NOTHING
#ASSERT `Art 14(1) the mandatory requirement for specific technical features may be imposed` TRUE  FALSE TRUE  TRUE  FALSE EQUALS NOTHING
#ASSERT `Art 14(1) the mandatory requirement for specific technical features may be imposed` TRUE  TRUE  FALSE TRUE  FALSE EQUALS NOTHING
#ASSERT `Art 14(1) the mandatory requirement for specific technical features may be imposed` TRUE  TRUE  TRUE  FALSE FALSE EQUALS NOTHING
#ASSERT `Art 14(2) the Member State must inform the Commission` TRUE  EQUALS JUST TRUE
#ASSERT `Art 14(2) the Member State must inform the Commission` FALSE EQUALS JUST FALSE
#ASSERT `Art 14(2) the Member State's duty to inform the Commission is met` TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 14(2) the Member State's duty to inform the Commission is met` TRUE  FALSE EQUALS JUST FALSE
#ASSERT `Art 14(2) the Member State's duty to inform the Commission is met` FALSE TRUE  EQUALS JUST FALSE
--  ruler: the measure is required, to ensure terminal equipment compatible with the users' right, in accordance with Directive 1999/5/EC and Decision 87/95/EEC
#ASSERT `Art 14(3) the measure may be adopted` TRUE  TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 14(3) the measure may be adopted` FALSE TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 14(3) the measure may be adopted` TRUE  FALSE TRUE  EQUALS NOTHING
#ASSERT `Art 14(3) the measure may be adopted` TRUE  TRUE  FALSE EQUALS NOTHING

§ `Art 15(1)`
--  ruler: a legislative measure, the provision, the purpose, necessary appropriate and proportionate
#ASSERT `Art 15(1) first sentence the Member State may adopt the legislative measure restricting the scope of the rights and obligations` TRUE `Article 5` `national security (State security)` TRUE  EQUALS JUST TRUE
#ASSERT `Art 15(1) first sentence the Member State may adopt the legislative measure restricting the scope of the rights and obligations` TRUE `Article 6` `defence` TRUE  EQUALS JUST TRUE
#ASSERT `Art 15(1) first sentence the Member State may adopt the legislative measure restricting the scope of the rights and obligations` TRUE `Article 8(1)` `public security` TRUE  EQUALS JUST TRUE
#ASSERT `Art 15(1) first sentence the Member State may adopt the legislative measure restricting the scope of the rights and obligations` TRUE `Article 8(2)` `the prevention, investigation, detection and prosecution of criminal offences or of unauthorised use of the electronic communication system` TRUE  EQUALS JUST TRUE
#ASSERT `Art 15(1) first sentence the Member State may adopt the legislative measure restricting the scope of the rights and obligations` TRUE `Article 8(3)` `defence` TRUE  EQUALS JUST TRUE
#ASSERT `Art 15(1) first sentence the Member State may adopt the legislative measure restricting the scope of the rights and obligations` TRUE `Article 8(4)` `defence` TRUE  EQUALS JUST TRUE
#ASSERT `Art 15(1) first sentence the Member State may adopt the legislative measure restricting the scope of the rights and obligations` TRUE `Article 9` `defence` TRUE  EQUALS JUST TRUE
-- not necessary, appropriate and proportionate: the "when" gate fails
#ASSERT `Art 15(1) first sentence the Member State may adopt the legislative measure restricting the scope of the rights and obligations` TRUE `Article 5` `defence` FALSE EQUALS JUST FALSE
-- another provision, another purpose, a measure that is not legislative: not covered
#ASSERT `Art 15(1) first sentence the Member State may adopt the legislative measure restricting the scope of the rights and obligations` TRUE `another provision of this Directive` `defence` TRUE  EQUALS NOTHING
#ASSERT `Art 15(1) first sentence the Member State may adopt the legislative measure restricting the scope of the rights and obligations` TRUE `Article 5` `another purpose` TRUE  EQUALS NOTHING
#ASSERT `Art 15(1) first sentence the Member State may adopt the legislative measure restricting the scope of the rights and obligations` FALSE `Article 5` `defence` TRUE  EQUALS NOTHING
--  ruler: a legislative retention measure, for a limited period, justified on the grounds laid down in paragraph 1
#ASSERT `Art 15(1) second sentence the Member State may adopt the legislative measure providing for the retention of data` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Art 15(1) second sentence the Member State may adopt the legislative measure providing for the retention of data` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `Art 15(1) second sentence the Member State may adopt the legislative measure providing for the retention of data` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `Art 15(1) second sentence the Member State may adopt the legislative measure providing for the retention of data` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `Art 15(1) third sentence the measure is in accordance with the general principles of Community law` TRUE  EQUALS JUST TRUE
#ASSERT `Art 15(1) third sentence the measure is in accordance with the general principles of Community law` FALSE EQUALS JUST FALSE

§ `Art 15(1a)`
--  ruler: the data is specifically required by Directive 2006/24/EC to be retained, for the purposes referred to in Article 1(1) of that Directive
#ASSERT `Art 15(1a) paragraph 1 applies to the data` TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 15(1a) paragraph 1 applies to the data` TRUE  FALSE EQUALS NOTHING
#ASSERT `Art 15(1a) paragraph 1 applies to the data` FALSE TRUE  EQUALS NOTHING
#ASSERT `Art 15(1a) paragraph 1 applies to the data` FALSE FALSE EQUALS NOTHING

§ `Art 15(1b)`
#ASSERT `Art 15(1b) first sentence the provider must establish internal procedures for responding to requests for access` TRUE  EQUALS JUST TRUE
#ASSERT `Art 15(1b) first sentence the provider must establish internal procedures for responding to requests for access` FALSE EQUALS NOTHING
#ASSERT `Art 15(1b) first sentence the provider's duty to establish internal procedures is met` TRUE  EQUALS JUST TRUE
#ASSERT `Art 15(1b) first sentence the provider's duty to establish internal procedures is met` FALSE EQUALS JUST FALSE
#ASSERT `Art 15(1b) second sentence the provider must provide the competent national authority with the information` TRUE  EQUALS JUST TRUE
#ASSERT `Art 15(1b) second sentence the provider must provide the competent national authority with the information` FALSE EQUALS JUST FALSE
--  ruler: procedures, number of requests, legal justification, response
#ASSERT `Art 15(1b) second sentence the provider's duty to provide the information is met` TRUE  TRUE  TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 15(1b) second sentence the provider's duty to provide the information is met` FALSE TRUE  TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 15(1b) second sentence the provider's duty to provide the information is met` TRUE  FALSE TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 15(1b) second sentence the provider's duty to provide the information is met` TRUE  TRUE  FALSE TRUE  EQUALS JUST FALSE
#ASSERT `Art 15(1b) second sentence the provider's duty to provide the information is met` TRUE  TRUE  TRUE  FALSE EQUALS JUST FALSE
-- TRACE-EXPECT: FULFILLED
#TRACE `Art 15(1b) second sentence the provider provides the authority with the information` AT 0 WITH
    PARTY `the provider` DOES `provide the authority with the information` AT 2
-- TRACE-EXPECT: STANDING
#TRACE `Art 15(1b) second sentence the provider provides the authority with the information` AT 0 WITH
    -- the information has not been provided: the duty stands

§ `Art 15(2) and (3)`
--  ruler: concerns national provisions adopted pursuant to this Directive, concerns an individual right derived from this Directive
#ASSERT `Art 15(2) Chapter III of Directive 95/46/EC on judicial remedies, liability and sanctions applies` TRUE  FALSE EQUALS JUST TRUE
#ASSERT `Art 15(2) Chapter III of Directive 95/46/EC on judicial remedies, liability and sanctions applies` FALSE TRUE  EQUALS JUST TRUE
#ASSERT `Art 15(2) Chapter III of Directive 95/46/EC on judicial remedies, liability and sanctions applies` TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 15(2) Chapter III of Directive 95/46/EC on judicial remedies, liability and sanctions applies` FALSE FALSE EQUALS NOTHING
#ASSERT `Art 15(3) the Working Party carries out the tasks laid down in Article 30 of Directive 95/46/EC with regard to the matter` TRUE  EQUALS JUST TRUE
#ASSERT `Art 15(3) the Working Party carries out the tasks laid down in Article 30 of Directive 95/46/EC with regard to the matter` FALSE EQUALS NOTHING

§ `Art 15a(1)`
#ASSERT `Art 15a(1) first sentence the Member State must lay down rules on penalties applicable to the infringement` TRUE  EQUALS JUST TRUE
#ASSERT `Art 15a(1) first sentence the Member State must lay down rules on penalties applicable to the infringement` FALSE EQUALS NOTHING
--  ruler: the infringement is of national provisions adopted pursuant to the Directive, criminal sanctions are appropriate
#ASSERT `Art 15a(1) first sentence the rules on penalties are to include criminal sanctions` TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 15a(1) first sentence the rules on penalties are to include criminal sanctions` TRUE  FALSE EQUALS JUST FALSE
#ASSERT `Art 15a(1) first sentence the rules on penalties are to include criminal sanctions` FALSE TRUE  EQUALS NOTHING
--  ruler: effective, proportionate, dissuasive
#ASSERT `Art 15a(1) second sentence the penalty is effective, proportionate and dissuasive` TRUE  TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 15a(1) second sentence the penalty is effective, proportionate and dissuasive` FALSE TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 15a(1) second sentence the penalty is effective, proportionate and dissuasive` TRUE  FALSE TRUE  EQUALS JUST FALSE
#ASSERT `Art 15a(1) second sentence the penalty is effective, proportionate and dissuasive` TRUE  TRUE  FALSE EQUALS JUST FALSE
#ASSERT `Art 15a(1) second sentence the penalty may be applied to cover the period of the breach, even if the breach has been rectified` TRUE  EQUALS JUST TRUE
#ASSERT `Art 15a(1) second sentence the penalty may be applied to cover the period of the breach, even if the breach has been rectified` FALSE EQUALS NOTHING
-- "by 25 May 2011": the last day is in time, the next day is not
#ASSERT `Art 15a(1) third sentence the Member State notified the provisions to the Commission in time` (Date 1 3 2011)  EQUALS JUST TRUE
#ASSERT `Art 15a(1) third sentence the Member State notified the provisions to the Commission in time` (Date 25 5 2011) EQUALS JUST TRUE
#ASSERT `Art 15a(1) third sentence the Member State notified the provisions to the Commission in time` (Date 26 5 2011) EQUALS JUST FALSE
#ASSERT `Art 15a(1) third sentence the Member State notified the subsequent amendment without delay` TRUE EQUALS JUST TRUE
#ASSERT `Art 15a(1) third sentence the Member State notified the subsequent amendment without delay` FALSE EQUALS JUST FALSE

§ `Art 15a(2), (3) and (4)`
--  ruler: the infringement is one referred to in paragraph 1, the competent national authority, another national body, it is relevant that the other body have the power
#ASSERT `Art 15a(2) the body must have the power to order the cessation of the infringement` TRUE TRUE  FALSE FALSE EQUALS JUST TRUE
#ASSERT `Art 15a(2) the body must have the power to order the cessation of the infringement` TRUE FALSE TRUE  TRUE  EQUALS JUST TRUE
-- "where relevant": another body for which it is not relevant
#ASSERT `Art 15a(2) the body must have the power to order the cessation of the infringement` TRUE FALSE TRUE  FALSE EQUALS JUST FALSE
-- a body that is neither
#ASSERT `Art 15a(2) the body must have the power to order the cessation of the infringement` TRUE FALSE FALSE FALSE EQUALS NOTHING
-- not an infringement paragraph 1 refers to
#ASSERT `Art 15a(2) the body must have the power to order the cessation of the infringement` FALSE TRUE FALSE FALSE EQUALS NOTHING
--  ruler: the competent national authority, another national body, it is relevant that the other body have the powers and resources
#ASSERT `Art 15a(3) the body must have the investigative powers and resources, including the power to obtain information` TRUE  FALSE FALSE EQUALS JUST TRUE
#ASSERT `Art 15a(3) the body must have the investigative powers and resources, including the power to obtain information` FALSE TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 15a(3) the body must have the investigative powers and resources, including the power to obtain information` FALSE TRUE  FALSE EQUALS JUST FALSE
#ASSERT `Art 15a(3) the body must have the investigative powers and resources, including the power to obtain information` FALSE FALSE FALSE EQUALS NOTHING
--  ruler: a relevant national regulatory authority, the measure is for cross-border cooperation or harmonised conditions
#ASSERT `Art 15a(4) first subparagraph the national regulatory authority may adopt the measure` TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 15a(4) first subparagraph the national regulatory authority may adopt the measure` FALSE TRUE  EQUALS NOTHING
#ASSERT `Art 15a(4) first subparagraph the national regulatory authority may adopt the measure` TRUE  FALSE EQUALS NOTHING

§ `Art 16`
--  ruler: already produced or placed on the market, printed or off-line electronic form, before the national provisions entered into force
#ASSERT `Art 16(1) Article 12 applies to the edition of the directory` TRUE  TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 16(1) Article 12 applies to the edition of the directory` FALSE TRUE  TRUE  EQUALS NOTHING
#ASSERT `Art 16(1) Article 12 applies to the edition of the directory` TRUE  FALSE TRUE  EQUALS NOTHING
#ASSERT `Art 16(1) Article 12 applies to the edition of the directory` TRUE  TRUE  FALSE EQUALS NOTHING
--  ruler: fixed or mobile voice telephony subscriber, included in conformity with 95/46/EC and Art 11 of 97/66/EC, before the national provisions, indicated otherwise, received complete information
#ASSERT `Art 16(2) the personal data of the subscriber may remain included in the public directory` TRUE TRUE TRUE FALSE TRUE  EQUALS JUST TRUE
#ASSERT `Art 16(2) the personal data of the subscriber may remain included in the public directory` TRUE TRUE TRUE TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 16(2) the personal data of the subscriber may remain included in the public directory` TRUE TRUE TRUE FALSE FALSE EQUALS NOTHING
-- the "Where" clause fails (not a fixed or mobile voice telephony subscriber): a failed "Where" on this grant answers JUST FALSE (periods ruling (b); grant and power ruling item 3, fork F11)
#ASSERT `Art 16(2) the personal data of the subscriber may remain included in the public directory` FALSE TRUE TRUE FALSE TRUE  EQUALS JUST FALSE
-- the "Where" clause fails (not included in conformity with Directive 95/46/EC and Article 11 of Directive 97/66/EC)
#ASSERT `Art 16(2) the personal data of the subscriber may remain included in the public directory` TRUE FALSE TRUE FALSE TRUE  EQUALS JUST FALSE
-- the "Where" clause fails (not included before the national provisions entered into force)
#ASSERT `Art 16(2) the personal data of the subscriber may remain included in the public directory` TRUE TRUE FALSE FALSE TRUE  EQUALS JUST FALSE
-- the "Where" clause is tested first: with it failing, the other limbs make no difference
#ASSERT `Art 16(2) the personal data of the subscriber may remain included in the public directory` TRUE FALSE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Art 16(2) the personal data of the subscriber may remain included in the public directory` FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE

§ `Art 19 second subparagraph and Art 21`
#ASSERT `Art 19 second subparagraph the reference is construed as made to this Directive` TRUE  EQUALS JUST TRUE
#ASSERT `Art 19 second subparagraph the reference is construed as made to this Directive` FALSE EQUALS NOTHING
#ASSERT `Art 21 the Directive is addressed to the body` TRUE  EQUALS JUST TRUE
#ASSERT `Art 21 the Directive is addressed to the body` FALSE EQUALS NOTHING
