IMPORT prelude
IMPORT `epd-nouns`
IMPORT `epd-art09-11`

-- Tests for Articles 9, 10 and 11. Expected values were decided from the text before the run.

§ `Art 9(1)`
--  ruler: location data other than traffic data of users or subscribers, made anonymous, consent given, to the extent and for the duration necessary for a value added service
#ASSERT `Art 9(1) first sentence the location data may be processed` TRUE  TRUE  FALSE FALSE EQUALS JUST TRUE
#ASSERT `Art 9(1) first sentence the location data may be processed` TRUE  FALSE TRUE  TRUE  EQUALS JUST TRUE
-- consent without the extent and duration limit is not enough
#ASSERT `Art 9(1) first sentence the location data may be processed` TRUE  FALSE TRUE  FALSE EQUALS JUST FALSE
#ASSERT `Art 9(1) first sentence the location data may be processed` TRUE  FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Art 9(1) first sentence the location data may be processed` TRUE  FALSE FALSE TRUE  EQUALS JUST FALSE
-- outside the paragraph's subject
#ASSERT `Art 9(1) first sentence the location data may be processed` FALSE TRUE  TRUE  TRUE  EQUALS NOTHING
--  ruler: obtaining consent
#ASSERT `Art 9(1) second sentence the service provider must inform the users or subscribers before obtaining their consent` TRUE  EQUALS JUST TRUE
#ASSERT `Art 9(1) second sentence the service provider must inform the users or subscribers before obtaining their consent` FALSE EQUALS NOTHING
--  ruler: type, purposes, duration, third-party transmission, prior to consent
#ASSERT `Art 9(1) second sentence the service provider's duty to inform is met` TRUE  TRUE  TRUE  TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 9(1) second sentence the service provider's duty to inform is met` FALSE TRUE  TRUE  TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 9(1) second sentence the service provider's duty to inform is met` TRUE  FALSE TRUE  TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 9(1) second sentence the service provider's duty to inform is met` TRUE  TRUE  FALSE TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 9(1) second sentence the service provider's duty to inform is met` TRUE  TRUE  TRUE  FALSE TRUE  EQUALS JUST FALSE
#ASSERT `Art 9(1) second sentence the service provider's duty to inform is met` TRUE  TRUE  TRUE  TRUE  FALSE EQUALS JUST FALSE
#ASSERT `Art 9(1) third sentence the users or subscribers must be given the possibility to withdraw their consent at any time` TRUE  EQUALS JUST TRUE
#ASSERT `Art 9(1) third sentence the users or subscribers must be given the possibility to withdraw their consent at any time` FALSE EQUALS NOTHING
#ASSERT `Art 9(1) third sentence the possibility to withdraw the consent at any time is given` TRUE  EQUALS JUST TRUE
#ASSERT `Art 9(1) third sentence the possibility to withdraw the consent at any time is given` FALSE EQUALS JUST FALSE

§ `Art 9(2)`
#ASSERT `Art 9(2) the user or subscriber must continue to have the possibility of temporarily refusing the processing` TRUE  EQUALS JUST TRUE
#ASSERT `Art 9(2) the user or subscriber must continue to have the possibility of temporarily refusing the processing` FALSE EQUALS JUST FALSE
--  ruler: has the possibility, simple means, free of charge, for each connection or transmission
#ASSERT `Art 9(2) the possibility of temporarily refusing the processing is as required` TRUE  TRUE  TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 9(2) the possibility of temporarily refusing the processing is as required` FALSE TRUE  TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 9(2) the possibility of temporarily refusing the processing is as required` TRUE  FALSE TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 9(2) the possibility of temporarily refusing the processing is as required` TRUE  TRUE  FALSE TRUE  EQUALS JUST FALSE
#ASSERT `Art 9(2) the possibility of temporarily refusing the processing is as required` TRUE  TRUE  TRUE  FALSE EQUALS JUST FALSE

§ `Art 9(3)`
--  ruler: in accordance with paragraphs 1 and 2, under the provider's authority, under the third party's authority, restricted to what is necessary
#ASSERT `Art 9(3) the processing of the location data is restricted as required` TRUE  TRUE  FALSE TRUE  EQUALS JUST TRUE
#ASSERT `Art 9(3) the processing of the location data is restricted as required` TRUE  FALSE TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 9(3) the processing of the location data is restricted as required` TRUE  TRUE  TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 9(3) the processing of the location data is restricted as required` TRUE  FALSE FALSE TRUE  EQUALS JUST FALSE
#ASSERT `Art 9(3) the processing of the location data is restricted as required` TRUE  TRUE  FALSE FALSE EQUALS JUST FALSE
#ASSERT `Art 9(3) the processing of the location data is restricted as required` FALSE TRUE  TRUE  TRUE  EQUALS NOTHING

§ `Art 10`
--  ruler: there is a procedure, it is transparent
#ASSERT `Art 10 the Member State has ensured transparent procedures governing the override` TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 10 the Member State has ensured transparent procedures governing the override` TRUE  FALSE EQUALS JUST FALSE
#ASSERT `Art 10 the Member State has ensured transparent procedures governing the override` FALSE FALSE EQUALS JUST FALSE
--  ruler: of CLI elimination, temporary, upon a subscriber's application, tracing malicious or nuisance calls
#ASSERT `Art 10(a) first sentence the provider may override the elimination of the presentation of calling line identification` TRUE  TRUE  TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 10(a) first sentence the provider may override the elimination of the presentation of calling line identification` FALSE TRUE  TRUE  TRUE  EQUALS NOTHING
#ASSERT `Art 10(a) first sentence the provider may override the elimination of the presentation of calling line identification` TRUE  FALSE TRUE  TRUE  EQUALS NOTHING
#ASSERT `Art 10(a) first sentence the provider may override the elimination of the presentation of calling line identification` TRUE  TRUE  FALSE TRUE  EQUALS NOTHING
#ASSERT `Art 10(a) first sentence the provider may override the elimination of the presentation of calling line identification` TRUE  TRUE  TRUE  FALSE EQUALS NOTHING
--  ruler: the provider has overridden under (a), in accordance with national law
#ASSERT `Art 10(a) second sentence the data identifying the calling subscriber will be stored and made available by the provider` TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 10(a) second sentence the data identifying the calling subscriber will be stored and made available by the provider` TRUE  FALSE EQUALS NOTHING
#ASSERT `Art 10(a) second sentence the data identifying the calling subscriber will be stored and made available by the provider` FALSE TRUE  EQUALS NOTHING
--  ruler: CLI elimination or location consent override, per-line, deals with emergency calls, recognised by a Member State, for responding to such calls
#ASSERT `Art 10(b) the provider may override for the organisation` TRUE  TRUE  TRUE  TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 10(b) the provider may override for the organisation` FALSE TRUE  TRUE  TRUE  TRUE  EQUALS NOTHING
#ASSERT `Art 10(b) the provider may override for the organisation` TRUE  FALSE TRUE  TRUE  TRUE  EQUALS NOTHING
#ASSERT `Art 10(b) the provider may override for the organisation` TRUE  TRUE  FALSE TRUE  TRUE  EQUALS NOTHING
#ASSERT `Art 10(b) the provider may override for the organisation` TRUE  TRUE  TRUE  FALSE TRUE  EQUALS NOTHING
#ASSERT `Art 10(b) the provider may override for the organisation` TRUE  TRUE  TRUE  TRUE  FALSE EQUALS NOTHING

§ `Art 11`
--  ruler: the person is a subscriber, the forwarding is automatic call forwarding by a third party to the subscriber's terminal
#ASSERT `Art 11 the subscriber must have the possibility of stopping the automatic call forwarding` TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 11 the subscriber must have the possibility of stopping the automatic call forwarding` FALSE TRUE  EQUALS NOTHING
#ASSERT `Art 11 the subscriber must have the possibility of stopping the automatic call forwarding` TRUE  FALSE EQUALS NOTHING
--  ruler: has the possibility, simple means, free of charge
#ASSERT `Art 11 the possibility of stopping the automatic call forwarding is as required` TRUE  TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 11 the possibility of stopping the automatic call forwarding is as required` FALSE TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 11 the possibility of stopping the automatic call forwarding is as required` TRUE  FALSE TRUE  EQUALS JUST FALSE
#ASSERT `Art 11 the possibility of stopping the automatic call forwarding is as required` TRUE  TRUE  FALSE EQUALS JUST FALSE
