IMPORT prelude
IMPORT daydate
IMPORT `epd-nouns`
IMPORT `epd-art05-06`

-- Tests for Articles 5 and 6. Expected values were decided from the text before the run and are written beside the assertion.

§ `Art 5(1)`
--  ruler: a communication or its related traffic data, by means of a public network or publicly available service
#ASSERT `Art 5(1) first sentence the Directive requires the confidentiality of the communication and the related traffic data` TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 5(1) first sentence the Directive requires the confidentiality of the communication and the related traffic data` TRUE  FALSE EQUALS NOTHING
#ASSERT `Art 5(1) first sentence the Directive requires the confidentiality of the communication and the related traffic data` FALSE TRUE  EQUALS NOTHING
--  ruler: listening/tapping/storage/interception/surveillance, of communications or related traffic data, by a person other than a user, users consented, legally authorised under Art 15(1)
#ASSERT `Art 5(1) second sentence the Directive requires the act to be prohibited` TRUE  TRUE  TRUE  FALSE FALSE EQUALS JUST TRUE
-- an act outside the words of the prohibition is not answered
#ASSERT `Art 5(1) second sentence the Directive requires the act to be prohibited` FALSE TRUE  TRUE  FALSE FALSE EQUALS NOTHING
#ASSERT `Art 5(1) second sentence the Directive requires the act to be prohibited` TRUE  FALSE TRUE  FALSE FALSE EQUALS NOTHING
#ASSERT `Art 5(1) second sentence the Directive requires the act to be prohibited` TRUE  TRUE  FALSE FALSE FALSE EQUALS NOTHING
-- "without the consent of the users concerned": with consent the words do not reach the act
#ASSERT `Art 5(1) second sentence the Directive requires the act to be prohibited` TRUE  TRUE  TRUE  TRUE  FALSE EQUALS NOTHING
-- "except when legally authorised": the exception applies
#ASSERT `Art 5(1) second sentence the Directive requires the act to be prohibited` TRUE  TRUE  TRUE  FALSE TRUE  EQUALS JUST FALSE
#ASSERT `Art 5(1) second sentence the Directive requires the act to be prohibited` TRUE  TRUE  TRUE  TRUE  TRUE  EQUALS JUST FALSE
-- an authorised act that is not within the prohibition's words stays unanswered
#ASSERT `Art 5(1) second sentence the Directive requires the act to be prohibited` FALSE TRUE  TRUE  FALSE TRUE  EQUALS NOTHING
-- the regulative form: SHANT, no time limit
-- TRACE-EXPECT: BREACH
#TRACE `Art 5(1) second sentence the person intercepting shall not intercept the communication` AT 0 WITH
    PARTY `the person intercepting` DOES `intercept the communication` AT 3
-- TRACE-EXPECT: STANDING
#TRACE `Art 5(1) second sentence the person intercepting shall not intercept the communication` AT 0 WITH
    -- no interception: the prohibition stays standing
--  ruler: technical storage necessary for the conveyance of a communication, without prejudice to the principle of confidentiality
#ASSERT `Art 5(1) third sentence the paragraph prevents the storage` TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 5(1) third sentence the paragraph prevents the storage` TRUE  FALSE EQUALS NOTHING
#ASSERT `Art 5(1) third sentence the paragraph prevents the storage` FALSE TRUE  EQUALS NOTHING
#ASSERT `Art 5(1) third sentence the paragraph prevents the storage` FALSE FALSE EQUALS NOTHING

§ `Art 5(2)`
--  ruler: legally authorised, of communications and related traffic data, in the course of lawful business practice, to provide evidence of a commercial transaction or other business communication
#ASSERT `Art 5(2) paragraph 1 affects the recording` TRUE  TRUE  TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 5(2) paragraph 1 affects the recording` FALSE TRUE  TRUE  TRUE  EQUALS NOTHING
#ASSERT `Art 5(2) paragraph 1 affects the recording` TRUE  FALSE TRUE  TRUE  EQUALS NOTHING
#ASSERT `Art 5(2) paragraph 1 affects the recording` TRUE  TRUE  FALSE TRUE  EQUALS NOTHING
#ASSERT `Art 5(2) paragraph 1 affects the recording` TRUE  TRUE  TRUE  FALSE EQUALS NOTHING

§ `Art 5(3)`
-- first sentence: the act is storing or gaining access in the terminal equipment of a subscriber or user
#ASSERT `Art 5(3) first sentence the storing or access is only allowed on condition of consent` TRUE  EQUALS JUST TRUE
#ASSERT `Art 5(3) first sentence the storing or access is only allowed on condition of consent` FALSE EQUALS NOTHING
--  ruler: has given consent, provided with clear and comprehensive information, in accordance with Directive 95/46/EC
#ASSERT `Art 5(3) first sentence the condition of consent is met` TRUE  TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 5(3) first sentence the condition of consent is met` FALSE TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 5(3) first sentence the condition of consent is met` TRUE  FALSE TRUE  EQUALS JUST FALSE
#ASSERT `Art 5(3) first sentence the condition of consent is met` TRUE  TRUE  FALSE EQUALS JUST FALSE
--  ruler: technical, sole purpose of transmission, ISS provider explicitly requested by the user, strictly necessary for that service
#ASSERT `Art 5(3) second sentence the first sentence prevents the storage or access` TRUE  TRUE  FALSE FALSE EQUALS JUST FALSE
#ASSERT `Art 5(3) second sentence the first sentence prevents the storage or access` TRUE  FALSE TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 5(3) second sentence the first sentence prevents the storage or access` TRUE  FALSE TRUE  FALSE EQUALS NOTHING
#ASSERT `Art 5(3) second sentence the first sentence prevents the storage or access` TRUE  FALSE FALSE TRUE  EQUALS NOTHING
#ASSERT `Art 5(3) second sentence the first sentence prevents the storage or access` FALSE TRUE  FALSE FALSE EQUALS NOTHING
#ASSERT `Art 5(3) second sentence the first sentence prevents the storage or access` TRUE  FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `Art 5(3) second sentence the first sentence prevents the storage or access` FALSE FALSE TRUE  TRUE  EQUALS NOTHING

§ `Art 6(1)`
--  ruler: traffic data processed and stored by the provider, no longer needed for the transmission, paragraph 2/3/5 or Art 15(1) applies
#ASSERT `Art 6(1) the provider must erase the traffic data or make it anonymous` TRUE  TRUE  FALSE EQUALS JUST TRUE
-- still needed for the transmission: "when it is no longer needed" is not met
#ASSERT `Art 6(1) the provider must erase the traffic data or make it anonymous` TRUE  FALSE FALSE EQUALS JUST FALSE
#ASSERT `Art 6(1) the provider must erase the traffic data or make it anonymous` TRUE  FALSE TRUE  EQUALS JUST FALSE
-- "without prejudice to paragraphs 2, 3 and 5 of this Article and Article 15(1)": what those allow is not decided here
#ASSERT `Art 6(1) the provider must erase the traffic data or make it anonymous` TRUE  TRUE  TRUE  EQUALS NOTHING
-- not traffic data of a provider: outside the paragraph
#ASSERT `Art 6(1) the provider must erase the traffic data or make it anonymous` FALSE TRUE  FALSE EQUALS NOTHING
-- the regulative form: no deadline apart from "when no longer needed"
-- TRACE-EXPECT: FULFILLED
#TRACE `Art 6(1) the provider erases the traffic data or makes it anonymous` AT 0 WITH
    PARTY `the provider` DOES `erase the traffic data or make it anonymous` AT 1
-- TRACE-EXPECT: STANDING
#TRACE `Art 6(1) the provider erases the traffic data or makes it anonymous` AT 0 WITH
    -- not erased yet: the duty stands

§ `Art 6(2)`
--  ruler: data necessary for billing and interconnection payments, date of the processing, last day of the challenge or payment period
#ASSERT `Art 6(2) the processing of the traffic data for billing is permissible on the date` TRUE  (Date 10 1 2025) (Date 31 1 2025) EQUALS JUST TRUE
-- "up to the end of the period": the last day itself is inside it, the next day is outside
#ASSERT `Art 6(2) the processing of the traffic data for billing is permissible on the date` TRUE  (Date 31 1 2025) (Date 31 1 2025) EQUALS JUST TRUE
#ASSERT `Art 6(2) the processing of the traffic data for billing is permissible on the date` TRUE  (Date 1 2 2025)  (Date 31 1 2025) EQUALS JUST FALSE
-- the paragraph is about traffic data necessary for billing: other data is not answered
#ASSERT `Art 6(2) the processing of the traffic data for billing is permissible on the date` FALSE (Date 10 1 2025) (Date 31 1 2025) EQUALS NOTHING

§ `Art 6(3)`
--  ruler: purpose is marketing electronic communications services or value added services, prior consent given, to the extent and for the duration necessary
#ASSERT `Art 6(3) first sentence the provider may process the traffic data` TRUE  TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 6(3) first sentence the provider may process the traffic data` TRUE  FALSE TRUE  EQUALS NOTHING
#ASSERT `Art 6(3) first sentence the provider may process the traffic data` TRUE  TRUE  FALSE EQUALS NOTHING
#ASSERT `Art 6(3) first sentence the provider may process the traffic data` TRUE  FALSE FALSE EQUALS NOTHING
#ASSERT `Art 6(3) first sentence the provider may process the traffic data` FALSE TRUE  TRUE  EQUALS NOTHING
-- second sentence: the possibility to withdraw consent for the processing of traffic data at any time
#ASSERT `Art 6(3) second sentence the user or subscriber has the possibility to withdraw the consent at any time` TRUE  EQUALS JUST TRUE
#ASSERT `Art 6(3) second sentence the user or subscriber has the possibility to withdraw the consent at any time` FALSE EQUALS NOTHING

§ `Art 6(4)`
#ASSERT `Art 6(4) the provider must inform the subscriber or user` TRUE  EQUALS JUST TRUE
#ASSERT `Art 6(4) the provider must inform the subscriber or user` FALSE EQUALS NOTHING
--  ruler: purpose is the paragraph 3 one, informed of the types, informed of the duration, did so prior to obtaining consent
#ASSERT `Art 6(4) the provider's duty to inform the subscriber or user is met` FALSE TRUE  TRUE  FALSE EQUALS JUST TRUE
#ASSERT `Art 6(4) the provider's duty to inform the subscriber or user is met` TRUE  TRUE  TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 6(4) the provider's duty to inform the subscriber or user is met` TRUE  TRUE  TRUE  FALSE EQUALS JUST FALSE
#ASSERT `Art 6(4) the provider's duty to inform the subscriber or user is met` FALSE FALSE TRUE  FALSE EQUALS JUST FALSE
#ASSERT `Art 6(4) the provider's duty to inform the subscriber or user is met` FALSE TRUE  FALSE FALSE EQUALS JUST FALSE
#ASSERT `Art 6(4) the provider's duty to inform the subscriber or user is met` TRUE  FALSE TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 6(4) the provider's duty to inform the subscriber or user is met` TRUE  TRUE  FALSE TRUE  EQUALS JUST FALSE

§ `Art 6(5)`
--  ruler: by a person under the authority of a provider, the activity, restricted to what is necessary
#ASSERT `Art 6(5) the processing of the traffic data is restricted as required` TRUE  `billing` TRUE EQUALS JUST TRUE
#ASSERT `Art 6(5) the processing of the traffic data is restricted as required` TRUE  `traffic management` TRUE EQUALS JUST TRUE
#ASSERT `Art 6(5) the processing of the traffic data is restricted as required` TRUE  `customer enquiries` TRUE EQUALS JUST TRUE
#ASSERT `Art 6(5) the processing of the traffic data is restricted as required` TRUE  `fraud detection` TRUE EQUALS JUST TRUE
#ASSERT `Art 6(5) the processing of the traffic data is restricted as required` TRUE  `marketing electronic communications services` TRUE EQUALS JUST TRUE
#ASSERT `Art 6(5) the processing of the traffic data is restricted as required` TRUE  `providing a value added service` TRUE EQUALS JUST TRUE
#ASSERT `Art 6(5) the processing of the traffic data is restricted as required` TRUE  `another activity` TRUE EQUALS JUST FALSE
#ASSERT `Art 6(5) the processing of the traffic data is restricted as required` FALSE `billing` TRUE EQUALS JUST FALSE
#ASSERT `Art 6(5) the processing of the traffic data is restricted as required` TRUE  `billing` FALSE EQUALS JUST FALSE

§ `Art 6(6)`
--  ruler: a competent body, in conformity with applicable legislation, with a view to settling disputes (interconnection or billing)
#ASSERT `Art 6(6) the competent body may be informed of the traffic data` TRUE  TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 6(6) the competent body may be informed of the traffic data` FALSE TRUE  TRUE  EQUALS NOTHING
#ASSERT `Art 6(6) the competent body may be informed of the traffic data` TRUE  FALSE TRUE  EQUALS NOTHING
#ASSERT `Art 6(6) the competent body may be informed of the traffic data` TRUE  TRUE  FALSE EQUALS NOTHING
