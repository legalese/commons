IMPORT prelude
IMPORT `epd-nouns`
IMPORT `epd-art04`

-- Tests for Article 4. Expected values were decided from the text before the run and are written beside the assertion.
-- The arguments of a rule are in the order of its GIVEN; the ruler above each group names them.

§ `Art 4(1) first sentence`
--  ruler: measures taken, conjunction with the network provider is necessary, acted in conjunction
#ASSERT `Art 4(1) first sentence the provider's duty to take appropriate measures is met` TRUE  FALSE FALSE EQUALS JUST TRUE
#ASSERT `Art 4(1) first sentence the provider's duty to take appropriate measures is met` TRUE  TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 4(1) first sentence the provider's duty to take appropriate measures is met` TRUE  FALSE TRUE  EQUALS JUST TRUE
#ASSERT `Art 4(1) first sentence the provider's duty to take appropriate measures is met` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Art 4(1) first sentence the provider's duty to take appropriate measures is met` FALSE TRUE  TRUE  EQUALS JUST FALSE
-- conjunction "if necessary", and not done
#ASSERT `Art 4(1) first sentence the provider's duty to take appropriate measures is met` TRUE  TRUE  FALSE EQUALS JUST FALSE

§ `Art 4(1) second sentence`
#ASSERT `Art 4(1) second sentence the measures ensure a level of security appropriate to the risk` TRUE  EQUALS JUST TRUE
#ASSERT `Art 4(1) second sentence the measures ensure a level of security appropriate to the risk` FALSE EQUALS JUST FALSE

§ `Art 4(1a)`
--  ruler: access only by authorised personnel, protection against destruction/loss/alteration/unauthorised processing, security policy
#ASSERT `Art 4(1a) the measures include at least what the three dashes require` TRUE  TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 4(1a) the measures include at least what the three dashes require` FALSE TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 4(1a) the measures include at least what the three dashes require` TRUE  FALSE TRUE  EQUALS JUST FALSE
#ASSERT `Art 4(1a) the measures include at least what the three dashes require` TRUE  TRUE  FALSE EQUALS JUST FALSE
-- the audit sentence names the relevant national authorities
#ASSERT `Art 4(1a) the national authority can audit the provider's measures and issue recommendations` TRUE  EQUALS JUST TRUE
#ASSERT `Art 4(1a) the national authority can audit the provider's measures and issue recommendations` FALSE EQUALS NOTHING

§ `Art 4(2)`
-- must inform concerning the risk: only in case of a particular risk
#ASSERT `Art 4(2) the provider must inform the subscribers concerning the risk` TRUE  EQUALS JUST TRUE
#ASSERT `Art 4(2) the provider must inform the subscribers concerning the risk` FALSE EQUALS JUST FALSE
--  ruler: a particular risk, the risk lies outside the scope of the provider's own measures
#ASSERT `Art 4(2) the provider must inform the subscribers of any possible remedies, including the likely costs` TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 4(2) the provider must inform the subscribers of any possible remedies, including the likely costs` TRUE  FALSE EQUALS JUST FALSE
#ASSERT `Art 4(2) the provider must inform the subscribers of any possible remedies, including the likely costs` FALSE TRUE  EQUALS JUST FALSE
--  ruler: informed of the risk, risk outside the provider's measures, informed of the remedies and likely costs
#ASSERT `Art 4(2) the provider's duty to inform the subscribers is met` TRUE  FALSE FALSE EQUALS JUST TRUE
#ASSERT `Art 4(2) the provider's duty to inform the subscribers is met` TRUE  TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 4(2) the provider's duty to inform the subscribers is met` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Art 4(2) the provider's duty to inform the subscribers is met` TRUE  TRUE  FALSE EQUALS JUST FALSE
#ASSERT `Art 4(2) the provider's duty to inform the subscribers is met` FALSE TRUE  TRUE  EQUALS JUST FALSE
-- the regulative form: no deadline is stated, so there is none
-- TRACE-EXPECT: FULFILLED
#TRACE `Art 4(2) the provider informs the subscribers of the risk` AT 0 WITH
    PARTY `the provider` DOES `inform the subscribers of the risk` AT 5
-- TRACE-EXPECT: STANDING
#TRACE `Art 4(2) the provider informs the subscribers of the risk` AT 0 WITH
    -- nothing happens: the obligation stays standing (no time limit to run out)

§ `Art 4(3) first and second subparagraphs`
#ASSERT `Art 4(3) first subparagraph the provider must notify the competent national authority` TRUE  EQUALS JUST TRUE
#ASSERT `Art 4(3) first subparagraph the provider must notify the competent national authority` FALSE EQUALS JUST FALSE
--  ruler: notified the authority, without undue delay
#ASSERT `Art 4(3) first subparagraph the provider's duty to notify the authority is met` TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 4(3) first subparagraph the provider's duty to notify the authority is met` TRUE  FALSE EQUALS JUST FALSE
#ASSERT `Art 4(3) first subparagraph the provider's duty to notify the authority is met` FALSE FALSE EQUALS JUST FALSE
--  ruler: there has been a breach, likely to adversely affect a subscriber or individual
#ASSERT `Art 4(3) second subparagraph the provider must also notify the subscriber or individual` TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 4(3) second subparagraph the provider must also notify the subscriber or individual` TRUE  FALSE EQUALS JUST FALSE
#ASSERT `Art 4(3) second subparagraph the provider must also notify the subscriber or individual` FALSE FALSE EQUALS JUST FALSE
--  ruler: notified the subscriber or individual, without undue delay
#ASSERT `Art 4(3) second subparagraph the provider's duty to notify the subscriber or individual is met` TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 4(3) second subparagraph the provider's duty to notify the subscriber or individual is met` TRUE  FALSE EQUALS JUST FALSE
#ASSERT `Art 4(3) second subparagraph the provider's duty to notify the subscriber or individual is met` FALSE FALSE EQUALS JUST FALSE
-- the regulative form with an illustrative 24 hours for "undue delay" (the 24 is a test input, not a figure of the text)
-- TRACE-EXPECT: FULFILLED
#TRACE `Art 4(3) first subparagraph the provider notifies the authority` 24 AT 0 WITH
    PARTY `the provider` DOES `notify the authority of the personal data breach` AT 10
-- TRACE-EXPECT: FULFILLED
#TRACE `Art 4(3) first subparagraph the provider notifies the authority` 24 AT 0 WITH
    PARTY `the provider` DOES `notify the authority of the personal data breach` AT 24
-- TRACE-EXPECT: BREACH
#TRACE `Art 4(3) first subparagraph the provider notifies the authority` 24 AT 0 WITH
    (WAITUNTIL 25)
-- TRACE-EXPECT: STANDING
#TRACE `Art 4(3) first subparagraph the provider notifies the authority` 24 AT 0 WITH
    -- no event and the clock has not moved: the duty is still standing
-- TRACE-EXPECT: FULFILLED
#TRACE `Art 4(3) second subparagraph the provider notifies the subscriber or individual` 24 AT 0 WITH
    PARTY `the provider` DOES `notify the subscriber or individual of the personal data breach` AT 24
-- TRACE-EXPECT: BREACH
#TRACE `Art 4(3) second subparagraph the provider notifies the subscriber or individual` 24 AT 0 WITH
    (WAITUNTIL 25)

§ `Art 4(3) third to fifth subparagraphs`
-- the exemption answers the question "is the notification required?": inside the conditions the text says it is not
--  ruler: demonstrated to the authority's satisfaction, applied to the data concerned, renders the data unintelligible
#ASSERT `Art 4(3) third subparagraph the notification to the subscriber or individual is required` TRUE  TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 4(3) third subparagraph the notification to the subscriber or individual is required` TRUE  TRUE  FALSE EQUALS NOTHING
#ASSERT `Art 4(3) third subparagraph the notification to the subscriber or individual is required` TRUE  FALSE TRUE  EQUALS NOTHING
#ASSERT `Art 4(3) third subparagraph the notification to the subscriber or individual is required` FALSE TRUE  TRUE  EQUALS NOTHING
#ASSERT `Art 4(3) third subparagraph the notification to the subscriber or individual is required` FALSE FALSE FALSE EQUALS NOTHING
--  ruler: the provider has not already notified, the authority has considered the likely adverse effects
#ASSERT `Art 4(3) fourth subparagraph the competent national authority may require the provider to notify the subscriber or individual` TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 4(3) fourth subparagraph the competent national authority may require the provider to notify the subscriber or individual` FALSE TRUE  EQUALS NOTHING
#ASSERT `Art 4(3) fourth subparagraph the competent national authority may require the provider to notify the subscriber or individual` TRUE  FALSE EQUALS NOTHING
#ASSERT `Art 4(3) fourth subparagraph the competent national authority may require the provider to notify the subscriber or individual` FALSE FALSE EQUALS NOTHING
--  ruler: describes nature, contact points, recommends mitigation
#ASSERT `Art 4(3) fifth subparagraph the notification to the subscriber or individual has the content required` TRUE  TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 4(3) fifth subparagraph the notification to the subscriber or individual has the content required` FALSE TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 4(3) fifth subparagraph the notification to the subscriber or individual has the content required` TRUE  FALSE TRUE  EQUALS JUST FALSE
#ASSERT `Art 4(3) fifth subparagraph the notification to the subscriber or individual has the content required` TRUE  TRUE  FALSE EQUALS JUST FALSE
--  ruler: nature, contact points, mitigation, consequences, measures proposed or taken
#ASSERT `Art 4(3) fifth subparagraph the notification to the competent national authority has the content required` TRUE  TRUE  TRUE  TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 4(3) fifth subparagraph the notification to the competent national authority has the content required` FALSE TRUE  TRUE  TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 4(3) fifth subparagraph the notification to the competent national authority has the content required` TRUE  FALSE TRUE  TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 4(3) fifth subparagraph the notification to the competent national authority has the content required` TRUE  TRUE  FALSE TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 4(3) fifth subparagraph the notification to the competent national authority has the content required` TRUE  TRUE  TRUE  FALSE TRUE  EQUALS JUST FALSE
#ASSERT `Art 4(3) fifth subparagraph the notification to the competent national authority has the content required` TRUE  TRUE  TRUE  TRUE  FALSE EQUALS JUST FALSE

§ `Art 4(4)`
--  ruler: concerns circumstances/format/manner of notification, is an instruction, instruction is necessary, implementing measures under paragraph 5 cover the point
#ASSERT `Art 4(4) first subparagraph the competent national authority may adopt the guideline or issue the instruction` TRUE  FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Art 4(4) first subparagraph the competent national authority may adopt the guideline or issue the instruction` TRUE  TRUE  TRUE  FALSE EQUALS JUST TRUE
#ASSERT `Art 4(4) first subparagraph the competent national authority may adopt the guideline or issue the instruction` TRUE  TRUE  FALSE FALSE EQUALS JUST FALSE
#ASSERT `Art 4(4) first subparagraph the competent national authority may adopt the guideline or issue the instruction` FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `Art 4(4) first subparagraph the competent national authority may adopt the guideline or issue the instruction` TRUE  FALSE FALSE TRUE  EQUALS NOTHING
#ASSERT `Art 4(4) first subparagraph the competent national authority may adopt the guideline or issue the instruction` TRUE  TRUE  TRUE  TRUE  EQUALS NOTHING
#ASSERT `Art 4(4) first subparagraph the competent national authority can audit the provider's compliance with its notification obligations` TRUE  EQUALS JUST TRUE
#ASSERT `Art 4(4) first subparagraph the competent national authority can audit the provider's compliance with its notification obligations` FALSE EQUALS NOTHING
#ASSERT `Art 4(4) first subparagraph the competent national authority must impose appropriate sanctions on the provider` TRUE  EQUALS JUST TRUE
#ASSERT `Art 4(4) first subparagraph the competent national authority must impose appropriate sanctions on the provider` FALSE EQUALS JUST FALSE
--  ruler: facts, effects, remedial action, sufficient to verify compliance, only the necessary information
#ASSERT `Art 4(4) second subparagraph the provider's inventory of personal data breaches is as required` TRUE  TRUE  TRUE  TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 4(4) second subparagraph the provider's inventory of personal data breaches is as required` FALSE TRUE  TRUE  TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 4(4) second subparagraph the provider's inventory of personal data breaches is as required` TRUE  FALSE TRUE  TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 4(4) second subparagraph the provider's inventory of personal data breaches is as required` TRUE  TRUE  FALSE TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 4(4) second subparagraph the provider's inventory of personal data breaches is as required` TRUE  TRUE  TRUE  FALSE TRUE  EQUALS JUST FALSE
#ASSERT `Art 4(4) second subparagraph the provider's inventory of personal data breaches is as required` TRUE  TRUE  TRUE  TRUE  FALSE EQUALS JUST FALSE
