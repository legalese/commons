IMPORT prelude
IMPORT `epd-nouns`
IMPORT `epd-art01-03`

-- Tests for Articles 1 to 3. Every expected value was decided from the text before the run and is written beside the assertion.
-- Where a rule takes several facts, the arguments are in the order of its GIVEN; the ruler above each group names them.
-- NOTHING = not covered; JUST FALSE = the text says no in its own words.

§ `Art 1(2)`
-- first sentence: the matter is within the purposes mentioned in paragraph 1
#ASSERT `Art 1(2) the Directive particularises and complements Directive 95/46/EC on the matter` TRUE EQUALS JUST TRUE
#ASSERT `Art 1(2) the Directive particularises and complements Directive 95/46/EC on the matter` FALSE EQUALS NOTHING
-- second sentence: a legal person is protected; for a natural person this sentence is silent
#ASSERT `Art 1(2) the Directive provides for protection of the subscriber's legitimate interests` TRUE EQUALS JUST TRUE
#ASSERT `Art 1(2) the Directive provides for protection of the subscriber's legitimate interests` FALSE EQUALS NOTHING

§ `Art 1(3)`
--  ruler:  outside-the-Treaty, public security, defence, State security, economic well-being, relates to State security matters, State criminal law
#ASSERT `Art 1(3) the Directive applies to the activity` TRUE  FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Art 1(3) the Directive applies to the activity` FALSE TRUE  FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Art 1(3) the Directive applies to the activity` FALSE FALSE TRUE  FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Art 1(3) the Directive applies to the activity` FALSE FALSE FALSE TRUE  FALSE FALSE FALSE EQUALS JUST FALSE
-- economic well-being of the State only counts "when the activities relate to State security matters"
#ASSERT `Art 1(3) the Directive applies to the activity` FALSE FALSE FALSE FALSE TRUE  FALSE FALSE EQUALS NOTHING
#ASSERT `Art 1(3) the Directive applies to the activity` FALSE FALSE FALSE FALSE TRUE  TRUE  FALSE EQUALS JUST FALSE
#ASSERT `Art 1(3) the Directive applies to the activity` FALSE FALSE FALSE FALSE FALSE TRUE  FALSE EQUALS NOTHING
#ASSERT `Art 1(3) the Directive applies to the activity` FALSE FALSE FALSE FALSE FALSE FALSE TRUE  EQUALS JUST FALSE
-- none of the exclusions: the sentence does not say the Directive applies (Art 3 does)
#ASSERT `Art 1(3) the Directive applies to the activity` FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING

§ `Art 2 chapeau and the defined-term table`
--  ruler: defined in 95/46/EC, defined in 2002/21/EC, this Directive otherwise provides
#ASSERT `Art 2 the borrowed definition of the term applies` TRUE  FALSE FALSE EQUALS JUST TRUE
#ASSERT `Art 2 the borrowed definition of the term applies` FALSE TRUE  FALSE EQUALS JUST TRUE
#ASSERT `Art 2 the borrowed definition of the term applies` TRUE  TRUE  FALSE EQUALS JUST TRUE
#ASSERT `Art 2 the borrowed definition of the term applies` FALSE FALSE FALSE EQUALS NOTHING
-- "Save as otherwise provided": where this Directive provides otherwise the borrowed definition does not apply
#ASSERT `Art 2 the borrowed definition of the term applies` TRUE  TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 2 the borrowed definition of the term applies` FALSE FALSE TRUE  EQUALS JUST FALSE
-- whether Directive 2002/21/EC's terms now read as the later instrument's is not decided: NOTHING
#ASSERT `Art 2 the reference to Directive 2002/21/EC reads as a reference to the instrument that repealed it` EQUALS NOTHING
-- the eight terms the Directive defines itself, one entry each
#ASSERT `Art 2 the paragraph of this Directive that defines the term` `user` EQUALS JUST "Art 2(a)"
#ASSERT `Art 2 the paragraph of this Directive that defines the term` `traffic data` EQUALS JUST "Art 2(b)"
#ASSERT `Art 2 the paragraph of this Directive that defines the term` `location data` EQUALS JUST "Art 2(c)"
#ASSERT `Art 2 the paragraph of this Directive that defines the term` `communication` EQUALS JUST "Art 2(d)"
#ASSERT `Art 2 the paragraph of this Directive that defines the term` `consent` EQUALS JUST "Art 2(f)"
#ASSERT `Art 2 the paragraph of this Directive that defines the term` `value added service` EQUALS JUST "Art 2(g)"
#ASSERT `Art 2 the paragraph of this Directive that defines the term` `electronic mail` EQUALS JUST "Art 2(h)"
#ASSERT `Art 2 the paragraph of this Directive that defines the term` `personal data breach` EQUALS JUST "Art 2(i)"
-- the terms used but borrowed: not answered here
#ASSERT `Art 2 the paragraph of this Directive that defines the term` `subscriber` EQUALS NOTHING
#ASSERT `Art 2 the paragraph of this Directive that defines the term` `personal data` EQUALS NOTHING
#ASSERT `Art 2 the paragraph of this Directive that defines the term` `data subject` EQUALS NOTHING
#ASSERT `Art 2 the paragraph of this Directive that defines the term` `publicly available electronic communications service` EQUALS NOTHING
#ASSERT `Art 2 the paragraph of this Directive that defines the term` `public communications network` EQUALS NOTHING
#ASSERT `Art 2 the paragraph of this Directive that defines the term` `terminal equipment` EQUALS NOTHING
#ASSERT `Art 2 the paragraph of this Directive that defines the term` `direct marketing` EQUALS NOTHING

§ `Art 2(a) user`
--  ruler: natural person, uses a publicly available electronic communications service
#ASSERT `Art 2(a) the person is a user` TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 2(a) the person is a user` TRUE  FALSE EQUALS JUST FALSE
#ASSERT `Art 2(a) the person is a user` FALSE TRUE  EQUALS JUST FALSE
#ASSERT `Art 2(a) the person is a user` FALSE FALSE EQUALS JUST FALSE

§ `Art 2(b) traffic data`
--  ruler: processed for conveyance, processed for billing
#ASSERT `Art 2(b) the data is traffic data` TRUE  FALSE EQUALS JUST TRUE
#ASSERT `Art 2(b) the data is traffic data` FALSE TRUE  EQUALS JUST TRUE
#ASSERT `Art 2(b) the data is traffic data` TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 2(b) the data is traffic data` FALSE FALSE EQUALS JUST FALSE

§ `Art 2(c) location data`
--  ruler: processed in the network, processed by the service, indicates the geographic position of a user's terminal equipment
#ASSERT `Art 2(c) the data is location data` TRUE  FALSE TRUE  EQUALS JUST TRUE
#ASSERT `Art 2(c) the data is location data` FALSE TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 2(c) the data is location data` TRUE  TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 2(c) the data is location data` FALSE FALSE TRUE  EQUALS JUST FALSE
#ASSERT `Art 2(c) the data is location data` TRUE  FALSE FALSE EQUALS JUST FALSE

§ `Art 2(d) communication`
--  ruler: between a finite number of parties, by a publicly available service
#ASSERT `Art 2(d) the information is a communication` TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 2(d) the information is a communication` TRUE  FALSE EQUALS JUST FALSE
#ASSERT `Art 2(d) the information is a communication` FALSE TRUE  EQUALS JUST FALSE
--  ruler: conveyed as part of a broadcasting service to the public, related to the identifiable subscriber or user
#ASSERT `Art 2(d) second sentence the information is a communication` TRUE  FALSE EQUALS JUST FALSE
#ASSERT `Art 2(d) second sentence the information is a communication` TRUE  TRUE  EQUALS NOTHING
#ASSERT `Art 2(d) second sentence the information is a communication` FALSE FALSE EQUALS NOTHING
#ASSERT `Art 2(d) second sentence the information is a communication` FALSE TRUE  EQUALS NOTHING

§ `Art 2(f) consent`
#ASSERT `Art 2(f) the act of the user or subscriber is consent` TRUE EQUALS JUST TRUE
#ASSERT `Art 2(f) the act of the user or subscriber is consent` FALSE EQUALS JUST FALSE

§ `Art 2(g) value added service`
--  ruler: needs traffic data beyond what is necessary, needs location data beyond what is necessary
#ASSERT `Art 2(g) the service is a value added service` TRUE  FALSE EQUALS JUST TRUE
#ASSERT `Art 2(g) the service is a value added service` FALSE TRUE  EQUALS JUST TRUE
#ASSERT `Art 2(g) the service is a value added service` FALSE FALSE EQUALS JUST FALSE

§ `Art 2(h) electronic mail`
--  ruler: a text, voice, sound or image message; sent over a public communications network; can be stored until collected
#ASSERT `Art 2(h) the message is electronic mail` TRUE  TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 2(h) the message is electronic mail` FALSE TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 2(h) the message is electronic mail` TRUE  FALSE TRUE  EQUALS JUST FALSE
#ASSERT `Art 2(h) the message is electronic mail` TRUE  TRUE  FALSE EQUALS JUST FALSE

§ `Art 2(i) personal data breach`
--  ruler: breach of security, destruction, loss, alteration, disclosure, access, personal data in the Community
#ASSERT `Art 2(i) the event is a personal data breach` TRUE  TRUE  FALSE FALSE FALSE FALSE TRUE  EQUALS JUST TRUE
#ASSERT `Art 2(i) the event is a personal data breach` TRUE  FALSE TRUE  FALSE FALSE FALSE TRUE  EQUALS JUST TRUE
#ASSERT `Art 2(i) the event is a personal data breach` TRUE  FALSE FALSE TRUE  FALSE FALSE TRUE  EQUALS JUST TRUE
#ASSERT `Art 2(i) the event is a personal data breach` TRUE  FALSE FALSE FALSE TRUE  FALSE TRUE  EQUALS JUST TRUE
#ASSERT `Art 2(i) the event is a personal data breach` TRUE  FALSE FALSE FALSE FALSE TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 2(i) the event is a personal data breach` TRUE  FALSE FALSE FALSE FALSE FALSE TRUE  EQUALS JUST FALSE
#ASSERT `Art 2(i) the event is a personal data breach` FALSE TRUE  FALSE FALSE FALSE FALSE TRUE  EQUALS JUST FALSE
#ASSERT `Art 2(i) the event is a personal data breach` TRUE  TRUE  FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE

§ `Art 3`
--  ruler: personal data, in connection with a publicly available service, public communications network, in the Community
#ASSERT `Art 3 the Directive applies to the processing` TRUE  TRUE  TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 3 the Directive applies to the processing` FALSE TRUE  TRUE  TRUE  EQUALS NOTHING
#ASSERT `Art 3 the Directive applies to the processing` TRUE  FALSE TRUE  TRUE  EQUALS NOTHING
#ASSERT `Art 3 the Directive applies to the processing` TRUE  TRUE  FALSE TRUE  EQUALS NOTHING
#ASSERT `Art 3 the Directive applies to the processing` TRUE  TRUE  TRUE  FALSE EQUALS NOTHING
