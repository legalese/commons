IMPORT prelude
IMPORT `epd-nouns`
IMPORT `epd-art07-08`

-- Tests for Articles 7 and 8. Expected values were decided from the text before the run.

§ `Art 7`
#ASSERT `Art 7(1) the subscriber has the right to receive non-itemised bills` TRUE  EQUALS JUST TRUE
#ASSERT `Art 7(1) the subscriber has the right to receive non-itemised bills` FALSE EQUALS NOTHING
#ASSERT `Art 7(2) the Member State must apply national provisions to reconcile the rights of subscribers receiving itemised bills with the privacy of calling users and called subscribers` TRUE  EQUALS JUST TRUE
#ASSERT `Art 7(2) the Member State must apply national provisions to reconcile the rights of subscribers receiving itemised bills with the privacy of calling users and called subscribers` FALSE EQUALS NOTHING
-- "for example": one way, the list is not closed
#ASSERT `Art 7(2) the national provisions reconcile the rights in the way the text gives as an example` TRUE  EQUALS JUST TRUE
#ASSERT `Art 7(2) the national provisions reconcile the rights in the way the text gives as an example` FALSE EQUALS NOTHING

§ `Art 8(1)`
#ASSERT `Art 8(1) first sentence the service provider must offer the calling user the possibility of preventing the presentation on a per-call basis` TRUE  EQUALS JUST TRUE
#ASSERT `Art 8(1) first sentence the service provider must offer the calling user the possibility of preventing the presentation on a per-call basis` FALSE EQUALS JUST FALSE
--  ruler: offers the possibility, per-call, simple means, free of charge
#ASSERT `Art 8(1) first sentence the service provider's duty to the calling user is met` TRUE  TRUE  TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 8(1) first sentence the service provider's duty to the calling user is met` FALSE TRUE  TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 8(1) first sentence the service provider's duty to the calling user is met` TRUE  FALSE TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 8(1) first sentence the service provider's duty to the calling user is met` TRUE  TRUE  FALSE TRUE  EQUALS JUST FALSE
#ASSERT `Art 8(1) first sentence the service provider's duty to the calling user is met` TRUE  TRUE  TRUE  FALSE EQUALS JUST FALSE
#ASSERT `Art 8(1) second sentence the calling subscriber must have the possibility on a per-line basis` TRUE  EQUALS JUST TRUE
#ASSERT `Art 8(1) second sentence the calling subscriber must have the possibility on a per-line basis` FALSE EQUALS JUST FALSE
--  ruler: has the possibility, on a per-line basis
#ASSERT `Art 8(1) second sentence the calling subscriber's possibility on a per-line basis is met` TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 8(1) second sentence the calling subscriber's possibility on a per-line basis is met` TRUE  FALSE EQUALS JUST FALSE
#ASSERT `Art 8(1) second sentence the calling subscriber's possibility on a per-line basis is met` FALSE TRUE  EQUALS JUST FALSE

§ `Art 8(2)`
#ASSERT `Art 8(2) the service provider must offer the called subscriber the possibility of preventing the presentation of the calling line identification of incoming calls` TRUE  EQUALS JUST TRUE
#ASSERT `Art 8(2) the service provider must offer the called subscriber the possibility of preventing the presentation of the calling line identification of incoming calls` FALSE EQUALS JUST FALSE
--  ruler: offers the possibility, simple means, use is reasonable, free of charge
#ASSERT `Art 8(2) the service provider's duty to the called subscriber is met` TRUE  TRUE  TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 8(2) the service provider's duty to the called subscriber is met` FALSE TRUE  TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 8(2) the service provider's duty to the called subscriber is met` TRUE  FALSE TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 8(2) the service provider's duty to the called subscriber is met` TRUE  TRUE  TRUE  FALSE EQUALS JUST FALSE
-- unreasonable use: "free of charge for reasonable use" does not say the possibility must be free then
#ASSERT `Art 8(2) the service provider's duty to the called subscriber is met` TRUE  TRUE  FALSE FALSE EQUALS NOTHING
#ASSERT `Art 8(2) the service provider's duty to the called subscriber is met` TRUE  TRUE  FALSE TRUE  EQUALS NOTHING

§ `Art 8(3)`
--  ruler: presentation offered, identification presented before the call is established
#ASSERT `Art 8(3) the service provider must offer the called subscriber the possibility of rejecting incoming calls whose presentation was prevented` TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 8(3) the service provider must offer the called subscriber the possibility of rejecting incoming calls whose presentation was prevented` TRUE  FALSE EQUALS JUST FALSE
#ASSERT `Art 8(3) the service provider must offer the called subscriber the possibility of rejecting incoming calls whose presentation was prevented` FALSE TRUE  EQUALS JUST FALSE
--  ruler: offers the possibility of rejecting, simple means
#ASSERT `Art 8(3) the service provider's duty to the called subscriber is met` TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 8(3) the service provider's duty to the called subscriber is met` TRUE  FALSE EQUALS JUST FALSE
#ASSERT `Art 8(3) the service provider's duty to the called subscriber is met` FALSE TRUE  EQUALS JUST FALSE

§ `Art 8(4)`
#ASSERT `Art 8(4) the service provider must offer the called subscriber the possibility of preventing the presentation of the connected line identification` TRUE  EQUALS JUST TRUE
#ASSERT `Art 8(4) the service provider must offer the called subscriber the possibility of preventing the presentation of the connected line identification` FALSE EQUALS JUST FALSE
--  ruler: offers the possibility, simple means, free of charge
#ASSERT `Art 8(4) the service provider's duty to the called subscriber is met` TRUE  TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 8(4) the service provider's duty to the called subscriber is met` FALSE TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 8(4) the service provider's duty to the called subscriber is met` TRUE  FALSE TRUE  EQUALS JUST FALSE
#ASSERT `Art 8(4) the service provider's duty to the called subscriber is met` TRUE  TRUE  FALSE EQUALS JUST FALSE

§ `Art 8(5)`
--  ruler: the call is to a third country, originates in the Community
#ASSERT `Art 8(5) first sentence paragraph 1 applies to the call` TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 8(5) first sentence paragraph 1 applies to the call` TRUE  FALSE EQUALS NOTHING
#ASSERT `Art 8(5) first sentence paragraph 1 applies to the call` FALSE TRUE  EQUALS NOTHING
--  ruler: the call is an incoming call, originates in a third country
#ASSERT `Art 8(5) second sentence paragraphs 2, 3 and 4 apply to the call` TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 8(5) second sentence paragraphs 2, 3 and 4 apply to the call` TRUE  FALSE EQUALS NOTHING
#ASSERT `Art 8(5) second sentence paragraphs 2, 3 and 4 apply to the call` FALSE TRUE  EQUALS NOTHING

§ `Art 8(6)`
#ASSERT `Art 8(6) the provider must inform the public of the line identification and of the possibilities` TRUE  EQUALS JUST TRUE
#ASSERT `Art 8(6) the provider must inform the public of the line identification and of the possibilities` FALSE EQUALS JUST FALSE
#ASSERT `Art 8(6) the provider's duty to inform the public is met` TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 8(6) the provider's duty to inform the public is met` TRUE  FALSE EQUALS JUST FALSE
#ASSERT `Art 8(6) the provider's duty to inform the public is met` FALSE TRUE  EQUALS JUST FALSE
#ASSERT `Art 8(6) the provider's duty to inform the public is met` FALSE FALSE EQUALS JUST FALSE
