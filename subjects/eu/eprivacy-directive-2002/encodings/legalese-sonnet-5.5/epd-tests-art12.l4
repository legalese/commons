IMPORT prelude
IMPORT `epd-nouns`
IMPORT `epd-art12`

-- Tests for Article 12. Expected values were decided from the text before the run.

§ `Art 12(1)`
--  ruler: a directory of the kind named, the subscriber's personal data can be included
#ASSERT `Art 12(1) the subscriber must be informed before inclusion in the directory` TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 12(1) the subscriber must be informed before inclusion in the directory` FALSE TRUE  EQUALS NOTHING
#ASSERT `Art 12(1) the subscriber must be informed before inclusion in the directory` TRUE  FALSE EQUALS NOTHING
--  ruler: informed of the purposes, the directory has search functions, informed of the further usage possibilities, free of charge, before inclusion
#ASSERT `Art 12(1) the subscriber's information before inclusion is as required` TRUE  TRUE  TRUE  TRUE  TRUE  EQUALS JUST TRUE
-- no search functions: the usage-possibilities limb has nothing to inform of
#ASSERT `Art 12(1) the subscriber's information before inclusion is as required` TRUE  FALSE FALSE TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 12(1) the subscriber's information before inclusion is as required` FALSE FALSE FALSE TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 12(1) the subscriber's information before inclusion is as required` TRUE  TRUE  FALSE TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 12(1) the subscriber's information before inclusion is as required` TRUE  FALSE FALSE FALSE TRUE  EQUALS JUST FALSE
#ASSERT `Art 12(1) the subscriber's information before inclusion is as required` TRUE  FALSE FALSE TRUE  FALSE EQUALS JUST FALSE

§ `Art 12(2)`
#ASSERT `Art 12(2) first sentence the subscriber must be given the opportunity to determine the inclusion of the personal data and to verify, correct or withdraw it` TRUE  EQUALS JUST TRUE
#ASSERT `Art 12(2) first sentence the subscriber must be given the opportunity to determine the inclusion of the personal data and to verify, correct or withdraw it` FALSE EQUALS NOTHING
--  ruler: determine whether included, data relevant for the directory's purpose, determine which, verify, correct, withdraw
#ASSERT `Art 12(2) first sentence the subscriber's opportunity is as required` TRUE  TRUE  TRUE  TRUE  TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 12(2) first sentence the subscriber's opportunity is as required` FALSE TRUE  TRUE  TRUE  TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 12(2) first sentence the subscriber's opportunity is as required` TRUE  TRUE  FALSE TRUE  TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 12(2) first sentence the subscriber's opportunity is as required` TRUE  TRUE  TRUE  FALSE TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 12(2) first sentence the subscriber's opportunity is as required` TRUE  TRUE  TRUE  TRUE  FALSE TRUE  EQUALS JUST FALSE
#ASSERT `Art 12(2) first sentence the subscriber's opportunity is as required` TRUE  TRUE  TRUE  TRUE  TRUE  FALSE EQUALS JUST FALSE
-- data that is not relevant for the purpose as the provider determines it: no choice of "which" is given by the text
#ASSERT `Art 12(2) first sentence the subscriber's opportunity is as required` TRUE  FALSE FALSE TRUE  TRUE  TRUE  EQUALS NOTHING
-- the verify/correct/withdraw limb is not limited by relevance
#ASSERT `Art 12(2) first sentence the subscriber's opportunity is as required` TRUE  FALSE FALSE FALSE TRUE  TRUE  EQUALS JUST FALSE
--  ruler: not being included, verifying, correcting, withdrawing: each free of charge
#ASSERT `Art 12(2) second sentence the subscriber's non-inclusion, verifying, correcting and withdrawing are free of charge` TRUE  TRUE  TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `Art 12(2) second sentence the subscriber's non-inclusion, verifying, correcting and withdrawing are free of charge` FALSE TRUE  TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 12(2) second sentence the subscriber's non-inclusion, verifying, correcting and withdrawing are free of charge` TRUE  FALSE TRUE  TRUE  EQUALS JUST FALSE
#ASSERT `Art 12(2) second sentence the subscriber's non-inclusion, verifying, correcting and withdrawing are free of charge` TRUE  TRUE  FALSE TRUE  EQUALS JUST FALSE
#ASSERT `Art 12(2) second sentence the subscriber's non-inclusion, verifying, correcting and withdrawing are free of charge` TRUE  TRUE  TRUE  FALSE EQUALS JUST FALSE

§ `Art 12(3)`
#ASSERT `Art 12(3) the Member State may require additional consent of the subscribers` TRUE  EQUALS JUST TRUE
#ASSERT `Art 12(3) the Member State may require additional consent of the subscribers` FALSE EQUALS NOTHING

§ `Art 12(4)`
#ASSERT `Art 12(4) first sentence paragraphs 1 and 2 apply to the subscriber` TRUE  EQUALS JUST TRUE
#ASSERT `Art 12(4) first sentence paragraphs 1 and 2 apply to the subscriber` FALSE EQUALS NOTHING
#ASSERT `Art 12(4) second sentence the Member State must ensure that the subscriber's legitimate interests with regard to their entry in public directories are sufficiently protected` FALSE EQUALS JUST TRUE
#ASSERT `Art 12(4) second sentence the Member State must ensure that the subscriber's legitimate interests with regard to their entry in public directories are sufficiently protected` TRUE  EQUALS NOTHING
