#ASSERT `Can the court excuse my notice before action` TRUE TRUE EQUALS `S50YES`
#ASSERT `Can the court excuse my notice before action` TRUE FALSE EQUALS `S50NO`

§§ `s 45A(1), (2): notice of the intended action (born 1 January 2010, injured 1 January 2020; last day 1 January 2031)`

#ASSERT `Must I give notice of my intended action` (D 1 1 2010) (D 1 1 2020) FALSE FALSE FALSE FALSE FALSE EQUALS `NOTICEALL` (D 1 1 2026)
#ASSERT `Must I give notice of my intended action` (D 1 1 2010) (D 1 1 2020) FALSE FALSE FALSE FALSE TRUE EQUALS `NOTICEINS` (D 1 1 2026)
#ASSERT `Must I give notice of my intended action` (D 1 1 2010) (D 1 1 2020) FALSE TRUE TRUE FALSE FALSE EQUALS `NOTORT`
#ASSERT `Must I give notice of my intended action` (D 1 1 2010) (D 1 1 2020) FALSE TRUE TRUE TRUE FALSE EQUALS `NOTICEOTHER` (D 1 1 2026)
#ASSERT `Must I give notice of my intended action` (D 1 1 2010) (D 1 1 2020) FALSE TRUE FALSE TRUE FALSE EQUALS `NOTICEALL` (D 1 1 2026)
#ASSERT `Must I give notice of my intended action` (D 1 1 2010) (D 1 1 2020) TRUE FALSE FALSE FALSE FALSE EQUALS `NOTSAY45A`
-- Injured on the 18th birthday: not a child.
#ASSERT `Must I give notice of my intended action` (D 1 1 2002) (D 1 1 2020) FALSE FALSE FALSE FALSE FALSE EQUALS `NOTCHILD`
-- Injured the day before the 18th birthday: a child, but the time runs to 1 January 2023, not beyond 6 years.
#ASSERT `Must I give notice of my intended action` (D 1 1 2002) (D 31 12 2019) FALSE FALSE FALSE FALSE FALSE EQUALS `NOTEXT`
-- Injured at exactly 15 (born 1 January 2005, 1 January 2020): the time runs to 1 January 2026, exactly 6 years: not more.
#ASSERT `Must I give notice of my intended action` (D 1 1 2005) (D 1 1 2020) FALSE FALSE FALSE FALSE FALSE EQUALS `NOTEXT`
-- A day younger (31 December 2019): the time runs to 1 January 2026, one day more than 6 years.
#ASSERT `Must I give notice of my intended action` (D 1 1 2005) (D 31 12 2019) FALSE FALSE FALSE FALSE FALSE EQUALS `NOTICEALL` (D 31 12 2025)
-- Law Reform (Ipp Recommendations) Act 2004 Sch 1 cl 1: s 45A does not reach an incident before 1 May 2004
-- (born 1 January 1995; injured 30 April 2004, then 1 May 2004, 6 years later 1 May 2010).
#ASSERT `Must I give notice of my intended action` (D 1 1 1995) (D 30 4 2004) FALSE FALSE FALSE FALSE FALSE EQUALS `NOTIPP`
#ASSERT `Must I give notice of my intended action` (D 1 1 1995) (D 1 5 2004) FALSE FALSE FALSE FALSE FALSE EQUALS `NOTICEALL` (D 1 5 2010)

