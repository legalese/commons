IMPORT prelude
IMPORT `mva-dates`
IMPORT `mva-core`
IMPORT `mva-seat-insured`

-- Motor Vehicles Act 1959 (SA), Part 4 -- cases for the insured owner's or driver's seat (mva-seat-insured.l4). Every
-- expected value was worked by hand from the deposited text, never copied from the encoding's output. Edges: a blood
-- alcohol concentration of exactly .1 and just under; fault of exactly 25% and 26%; payment on the last day of the month
-- and the day after; a CPI-indexed prescribed amount that rounds up and one that is already a multiple of $10.
--
-- BASELINE ENCODING. Not for public use as advice. See NOTES.md.

§ `Cases: the insured owner or driver`

`never` MEANS `the date` 1 1 2000

§§ `s 99A(8): the period of grace (mirror of the claimant's case)`

#ASSERT `Was my vehicle insured on the day of the accident` `registration (including trade plates)` (`the date` 1 7 2024) (`the date` 30 6 2025) FALSE `never` (`the date` 30 7 2025) EQUALS `insured: the accident was within the 30-day period of grace after the registration period ended (s 99A(8)(a))`
#ASSERT `Was my vehicle insured on the day of the accident` `registration (including trade plates)` (`the date` 1 7 2024) (`the date` 30 6 2025) FALSE `never` (`the date` 31 7 2025) EQUALS `not insured under this Part on that day: the period of grace had ended (s 99A(8)(a))`

§§ `s 124(1)-(6a): duties after the accident`

#ASSERT `Have I met my accident notice duty` FALSE FALSE `none of these` EQUALS `section 124 does not apply: the accident caused no death or bodily injury`
#ASSERT `Have I met my accident notice duty` TRUE TRUE `none of these` EQUALS `the notice was given as soon as practicable: no offence under s 124(2)`
#ASSERT `Have I met my accident notice duty` TRUE FALSE `none of these` EQUALS `you may be guilty of an offence: maximum penalty $1 250 or imprisonment for 3 months (s 124(2))`
#ASSERT `Have I met my accident notice duty` TRUE FALSE `I did not know of the accident` EQUALS `you have a defence under s 124(3)`
#ASSERT `Have I met my accident notice duty` TRUE FALSE `I believed on reasonable grounds that the notice had been given` EQUALS `you have a defence under s 124(3)`
#ASSERT `What must my accident notice state` EQUALS LIST `the fact of the accident`, `the time and place at which it occurred`, `the circumstances of the accident`, `the name, date of birth and address of the driver at the time`, `the name and address of any person killed or injured`, `the names and addresses of any witnesses`
#ASSERT `What is the largest fine for this duty` `giving the insurer written notice of the accident (s 124(1), (2))` EQUALS 1250
#ASSERT `What is the largest fine for this duty` `co-operating fully with the insurer on a claim (s 124(3a), (3b))` EQUALS 5000
#ASSERT `What is the largest fine for this duty` `giving the insurer notice of a claim made on me, and the information it reasonably requires (s 124(4))` EQUALS 750
#ASSERT `What is the largest fine for this duty` `producing my licence or the vehicle's documents when the insurer requires (s 124(5))` EQUALS 750
#ASSERT `What is the largest fine for this duty` `not giving false or misleading notice or information (s 124(6), (6a))` EQUALS 50000
#ASSERT `What is the longest imprisonment for this duty` `giving the insurer written notice of the accident (s 124(1), (2))` EQUALS 3
#ASSERT `What is the longest imprisonment for this duty` `not giving false or misleading notice or information (s 124(6), (6a))` EQUALS 12
#ASSERT `What is the longest imprisonment for this duty` `co-operating fully with the insurer on a claim (s 124(3a), (3b))` EQUALS 0

§§ `s 126: steps that need the insurer's written consent`

#ASSERT `May I take this step without the insurer` `admit liability` FALSE EQUALS `not without the insurer's written consent (s 126)`
#ASSERT `May I take this step without the insurer` `authorise repairs to, dismantle or wilfully damage the vehicle` FALSE EQUALS `not without the insurer's written consent (s 126)`
#ASSERT `May I take this step without the insurer` `offer or promise a payment or settlement` TRUE EQUALS `yes: the insurer has consented in writing (s 126)`
#ASSERT `May I take this step without the insurer` `truthfully answer a question a police officer reasonably asks` FALSE EQUALS `yes: s 126 does not stop you truthfully answering a police officer's reasonable question`
#ASSERT `May I take this step without the insurer` `something else` FALSE EQUALS `section 126 does not deal with this step`

§§ `ss 123, 124A: repaying the insurer. Inputs: intent, incapable, BAC, s 43, other term, s 124/126, prejudice, road race, no consent`

#ASSERT `Can the insurer make me repay` FALSE FALSE 0 FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `no recovery under s 123 or s 124A on these facts`
#ASSERT `Can the insurer make me repay` FALSE FALSE 0.1 FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `the insurer may recover all the money it paid and costs it incurred (s 124A(1))`
#ASSERT `Can the insurer make me repay` FALSE FALSE 0.099 FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `no recovery under s 123 or s 124A on these facts`
#ASSERT `Can the insurer make me repay` FALSE FALSE 0.15 FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `the insurer may recover all the money it paid and costs it incurred (s 124A(1))`
#ASSERT `Can the insurer make me repay` TRUE FALSE 0 FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `the insurer may recover all the money it paid and costs it incurred (s 124A(1))`
#ASSERT `Can the insurer make me repay` FALSE TRUE 0 FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `the insurer may recover all the money it paid and costs it incurred (s 124A(1))`
#ASSERT `Can the insurer make me repay` FALSE FALSE 0 TRUE FALSE FALSE TRUE FALSE FALSE EQUALS `the insurer may recover as much as the court thinks just and reasonable (s 124A(2), (4))`
#ASSERT `Can the insurer make me repay` FALSE FALSE 0 TRUE FALSE FALSE FALSE FALSE FALSE EQUALS `no recovery under s 123 or s 124A on these facts`
#ASSERT `Can the insurer make me repay` FALSE FALSE 0 FALSE TRUE FALSE TRUE FALSE FALSE EQUALS `the insurer may recover as much as the court thinks just and reasonable (s 124A(2), (4))`
#ASSERT `Can the insurer make me repay` FALSE FALSE 0 FALSE FALSE TRUE TRUE FALSE FALSE EQUALS `the insurer may recover as much as the court thinks just and reasonable (s 124A(2), (4))`
#ASSERT `Can the insurer make me repay` FALSE FALSE 0 FALSE FALSE FALSE FALSE TRUE FALSE EQUALS `the insurer recovers from the organiser of the road race, not under s 124A from you (s 124A(3))`
#ASSERT `Can the insurer make me repay` FALSE FALSE 0 FALSE FALSE FALSE FALSE FALSE TRUE EQUALS `the insurer may recover all the money it paid and costs it incurred (s 123)`
#ASSERT `Can the insurer make me repay` FALSE FALSE 0.12 FALSE FALSE FALSE FALSE TRUE FALSE EQUALS `the insurer may recover all the money it paid and costs it incurred (s 124A(1))`

§§ `s 124AB: the excess. CPI Sep 2010 = 100, CPI Sep 2023 = 130.25: $460 x 1.3025 = $599.15, rounded up to $600`

`acc` MEANS `the date` 15 3 2024
`req` MEANS `the date` 10 5 2024

#ASSERT `the prescribed amount for the year of the accident (s 124AB(3)-(5))` 2024 130.25 100 EQUALS 600
#ASSERT `the prescribed amount for the year of the accident (s 124AB(3)-(5))` 2024 150 100 EQUALS 690
#ASSERT `the prescribed amount for the year of the accident (s 124AB(3)-(5))` 2011 150 100 EQUALS 460
#ASSERT `How much excess can the insurer recover` 25 5000 `acc` 130.25 100 FALSE `req` TRUE (`the date` 20 5 2024) (`the date` 1 7 2024) EQUALS `no excess: the accident was not more than 25% your fault (s 124AB(1))`
#ASSERT `How much excess can the insurer recover` 26 5000 `acc` 130.25 100 TRUE `req` TRUE (`the date` 20 5 2024) (`the date` 1 7 2024) EQUALS `no excess: the insurer has used another right of recovery against you (s 124AB(2))`
#ASSERT `How much excess can the insurer recover` 30 5000 `acc` 130.25 100 FALSE `req` TRUE (`the date` 10 6 2024) (`the date` 1 7 2024) EQUALS `you paid within 1 month of the first request, so the excess is 95% (s 124AB(1)(a)(ii), (b)(ii))` 570
#ASSERT `How much excess can the insurer recover` 30 5000 `acc` 130.25 100 FALSE `req` TRUE (`the date` 11 6 2024) (`the date` 1 7 2024) EQUALS `the full excess is a debt you owe (s 124AB(1)(a)(i), (b)(i))` 600
#ASSERT `How much excess can the insurer recover` 30 5000 `acc` 130.25 100 FALSE `req` FALSE `never` (`the date` 1 6 2024) EQUALS `not yet paid: pay 95% by the last day, or the full excess after it` 570 600 (`the date` 10 6 2024)
#ASSERT `How much excess can the insurer recover` 30 5000 `acc` 130.25 100 FALSE `req` FALSE `never` (`the date` 11 6 2024) EQUALS `the full excess is a debt you owe (s 124AB(1)(a)(i), (b)(i))` 600
#ASSERT `How much excess can the insurer recover` 30 400 `acc` 130.25 100 FALSE `req` TRUE (`the date` 1 6 2024) (`the date` 1 7 2024) EQUALS `you paid within 1 month of the first request, so the excess is 95% (s 124AB(1)(a)(ii), (b)(ii))` 380
#ASSERT `How much excess can the insurer recover` 30 600 `acc` 130.25 100 FALSE `req` TRUE (`the date` 1 7 2024) (`the date` 1 7 2024) EQUALS `the full excess is a debt you owe (s 124AB(1)(a)(i), (b)(i))` 600
#ASSERT `How much excess can the insurer recover` 80 20000 `acc` 150 100 FALSE (`the date` 31 1 2025) TRUE (`the date` 28 2 2025) (`the date` 1 4 2025) EQUALS `you paid within 1 month of the first request, so the excess is 95% (s 124AB(1)(a)(ii), (b)(ii))` 655.5
#ASSERT `How much excess can the insurer recover` 80 20000 `acc` 150 100 FALSE (`the date` 31 1 2025) TRUE (`the date` 1 3 2025) (`the date` 1 4 2025) EQUALS `the full excess is a debt you owe (s 124AB(1)(a)(i), (b)(i))` 690
#ASSERT `How much excess can the insurer recover` 30 5000 (`the date` 30 6 2013) 130.25 100 FALSE `req` TRUE (`the date` 20 5 2024) (`the date` 1 7 2024) EQUALS `not covered: an accident before 1 July 2013`
#TRACE `s 124AB(1) -- the insured person may pay 95% of the excess within 1 month after the first request, otherwise the full excess` 31 AT 0 WITH
    PARTY `the insured person` DOES `pay the excess the insurer requests` AT 32
-- expect: the full-excess obligation still open (the payment on day 32 is not matched against it)

§§ `s 116(7)-(7e): the nominal defendant and the uninsured driver. Inputs: liable, intent, incapable, BAC, s 43, owner consent, did not know, unlicensed, unsafe`

#ASSERT `Can the nominal defendant make me repay` TRUE FALSE FALSE 0 FALSE TRUE TRUE FALSE FALSE EQUALS `you have a defence to recovery under s 116(7b) (s 116(7c))`
#ASSERT `Can the nominal defendant make me repay` FALSE TRUE FALSE 0.2 FALSE TRUE TRUE FALSE FALSE EQUALS `no recovery under s 116: you were not liable for the death or injury`
#ASSERT `Can the nominal defendant make me repay` TRUE FALSE FALSE 0.1 FALSE TRUE TRUE FALSE FALSE EQUALS `the nominal defendant may recover the whole sum it paid, with costs (s 116(7))`
#ASSERT `Can the nominal defendant make me repay` TRUE FALSE FALSE 0.099 FALSE TRUE TRUE FALSE FALSE EQUALS `you have a defence to recovery under s 116(7b) (s 116(7c))`
#ASSERT `Can the nominal defendant make me repay` TRUE TRUE FALSE 0 FALSE TRUE TRUE FALSE FALSE EQUALS `the nominal defendant may recover the whole sum it paid, with costs (s 116(7))`
#ASSERT `Can the nominal defendant make me repay` TRUE FALSE TRUE 0 FALSE TRUE TRUE FALSE FALSE EQUALS `the nominal defendant may recover the whole sum it paid, with costs (s 116(7))`
#ASSERT `Can the nominal defendant make me repay` TRUE FALSE FALSE 0 TRUE TRUE TRUE FALSE FALSE EQUALS `the nominal defendant may recover the sum, or the part the court thinks just and reasonable, with costs (s 116(7aa))`
#ASSERT `Can the nominal defendant make me repay` TRUE FALSE FALSE 0 FALSE FALSE TRUE FALSE FALSE EQUALS `the nominal defendant may recover the sum, or the part the court thinks just and reasonable, with costs (s 116(7b), (7e))`
#ASSERT `Can the nominal defendant make me repay` TRUE FALSE FALSE 0 FALSE TRUE FALSE FALSE FALSE EQUALS `the nominal defendant may recover the sum, or the part the court thinks just and reasonable, with costs (s 116(7b), (7e))`
#ASSERT `Can the nominal defendant make me repay` TRUE FALSE FALSE 0 FALSE TRUE TRUE TRUE FALSE EQUALS `the nominal defendant may recover the sum, or the part the court thinks just and reasonable, with costs (s 116(7b), (7e))`
#ASSERT `Can the nominal defendant make me repay` TRUE FALSE FALSE 0 FALSE TRUE TRUE FALSE TRUE EQUALS `the nominal defendant may recover the sum, or the part the court thinks just and reasonable, with costs (s 116(7b), (7e))`

§§ `s 113A: indemnity for kinds of damages (mirror of the claimant's case)`

#ASSERT `Will the insurer cover these damages for me` `compensatory damages for the death or bodily injury` EQUALS `yes: the CTP policy insures you against that liability (s 104(1)(a))`
#ASSERT `Will the insurer cover these damages for me` `exemplary or punitive damages` EQUALS `no: you are not entitled to be indemnified by the insurer for aggravated, exemplary or punitive damages (s 113A)`
#ASSERT `Will the insurer cover these damages for me` `aggravated damages` EQUALS `no: you are not entitled to be indemnified by the insurer for aggravated, exemplary or punitive damages (s 113A)`
