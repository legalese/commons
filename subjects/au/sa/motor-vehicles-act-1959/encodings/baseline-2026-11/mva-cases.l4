§§ `s 127B: a child under 16`

#ASSERT `Must the insurer pay my child's treatment and care` 10 TRUE FALSE (`the date` 5 5 2024) `driving` FALSE `a road car` TRUE `SA policy` EQUALS `yes: the insurer must pay all the necessary and reasonable expenses of the child's treatment, care and support needs from the injury, even after 16, whether or not anyone was at fault (s 127B(2), (3))`
#ASSERT `Must the insurer pay my child's treatment and care` 15 TRUE FALSE (`the date` 5 5 2024) `driving` FALSE `a road car` TRUE `SA policy` EQUALS `yes: the insurer must pay all the necessary and reasonable expenses of the child's treatment, care and support needs from the injury, even after 16, whether or not anyone was at fault (s 127B(2), (3))`
#ASSERT `Must the insurer pay my child's treatment and care` 16 TRUE FALSE (`the date` 5 5 2024) `driving` FALSE `a road car` TRUE `SA policy` EQUALS `no: the child had turned 16 (s 127B(2)(a))`
#ASSERT `Must the insurer pay my child's treatment and care` 10 FALSE FALSE (`the date` 5 5 2024) `driving` FALSE `a road car` TRUE `SA policy` EQUALS `no: the incident did not occur in South Australia (s 127B(2)(b))`
#ASSERT `Must the insurer pay my child's treatment and care` 10 TRUE TRUE (`the date` 5 5 2024) `driving` FALSE `a road car` TRUE `SA policy` EQUALS `no: the child is a participant in the Lifetime Support Scheme, which deals with those needs instead (s 127B(4))`
#ASSERT `Must the insurer pay my child's treatment and care` 5 TRUE FALSE (`the date` 5 5 2024) `driving` FALSE `a road car` TRUE `not insured at all` EQUALS `yes: the insurer must pay all the necessary and reasonable expenses of the child's treatment, care and support needs from the injury, even after 16, whether or not anyone was at fault (s 127B(2), (3))`
#ASSERT `Must the insurer pay my child's treatment and care` 5 TRUE FALSE (`the date` 5 5 2024) `driving` FALSE `a road car` TRUE `insured under a policy complying with another State's or Territory's law that covers its use in South Australia` EQUALS `no: there is no CTP insurer or nominal defendant for the claim under this Part`
#ASSERT `Must the insurer pay my child's treatment and care` 5 TRUE FALSE (`the date` 5 5 2024) `other way` FALSE `a road car` TRUE `SA policy` EQUALS `no: the injury was not caused by and did not arise out of the use of a motor vehicle (s 127B(2)(a))`
#ASSERT `Must the insurer pay my child's treatment and care` 5 TRUE FALSE (`the date` 30 6 2013) `driving` FALSE `a road car` TRUE `SA policy` EQUALS `not covered: an accident before 1 July 2013`

§§ `s 127C: costs`

`a 2024 accident` MEANS `the date` 5 5 2024

#ASSERT `Can my legal costs be paid` 25000 FALSE FALSE `a 2024 accident` EQUALS `no party and party costs may be awarded in your favour (s 127C(1)(a))`
#ASSERT `Can my legal costs be paid` 25000 TRUE FALSE `a 2024 accident` EQUALS `party and party costs may be awarded, because the court finds exceptional circumstances (s 127C(1)(a))`
#ASSERT `Can my legal costs be paid` 18000 FALSE TRUE `a 2024 accident` EQUALS `party and party costs only so far as directly related to obtaining the court's approval of the settlement for a person under a legal disability (s 127C(1)(a), (3))`
#ASSERT `Can my legal costs be paid` 25001 FALSE FALSE `a 2024 accident` EQUALS `costs may be awarded, but not above the Magistrates Court scale (s 127C(1)(b))`
#ASSERT `Can my legal costs be paid` 100000 TRUE FALSE `a 2024 accident` EQUALS `costs above the Magistrates Court scale may be awarded, because the court finds exceptional circumstances (s 127C(1)(b))`
#ASSERT `Can my legal costs be paid` 100000 FALSE FALSE `a 2024 accident` EQUALS `costs may be awarded, but not above the Magistrates Court scale (s 127C(1)(b))`
#ASSERT `Can my legal costs be paid` 100001 FALSE FALSE `a 2024 accident` EQUALS `section 127C does not limit the costs: the amount is over $100 000`
#ASSERT `Can my legal costs be paid` 20000 FALSE FALSE (`the date` 30 6 2013) EQUALS `not covered: an accident before 1 July 2013`
#ASSERT `Can I be made to pay the defendant's costs` 20000 FALSE `a 2024 accident` EQUALS `no party and party costs may be awarded to the defendant (s 127C(2)(a))`
#ASSERT `Can I be made to pay the defendant's costs` 20000 TRUE `a 2024 accident` EQUALS `party and party costs may be awarded to the defendant, because the court finds exceptional circumstances (s 127C(2)(a))`
#ASSERT `Can I be made to pay the defendant's costs` 60000 FALSE `a 2024 accident` EQUALS `costs may be awarded to the defendant, but not above the Magistrates Court scale (s 127C(2)(b))`
#ASSERT `Can I be made to pay the defendant's costs` 60000 TRUE `a 2024 accident` EQUALS `costs above the Magistrates Court scale may be awarded to the defendant, because the court finds exceptional circumstances (s 127C(2)(b))`
#ASSERT `Can I be made to pay the defendant's costs` 150000 FALSE `a 2024 accident` EQUALS `section 127C does not limit the costs: the amount is over $100 000`

§§ `ss 133, 134, 124(6b)`

#ASSERT `Is my agreement giving up my claim binding` `death or bodily injury` TRUE EQUALS `void to that extent: you keep your right to claim (s 133(1))`
#ASSERT `Is my agreement giving up my claim binding` `loss of or damage to property` TRUE EQUALS `section 133 does not apply to property claims (s 133(2))`
#ASSERT `Is my agreement giving up my claim binding` `death or bodily injury` FALSE EQUALS `section 133 does not deal with an agreement made after the death or injury`
#ASSERT `May this person act on my claim for a fee` `a qualified legal practitioner acting in the course of their profession` TRUE EQUALS `they may act for reward (s 134(2))`
#ASSERT `May this person act on my claim for a fee` `an officer of an employees' association acting for me as a member` TRUE EQUALS `they may act for reward (s 134(2))`
#ASSERT `May this person act on my claim for a fee` `a person employed or instructed by an approved insurer` TRUE EQUALS `they may act for reward (s 134(2))`
#ASSERT `May this person act on my claim for a fee` `anyone else` TRUE EQUALS `they must not act for reward (maximum penalty $750); an agreement to pay them is void and money paid is recoverable (s 134(1), (3))`
#ASSERT `May this person act on my claim for a fee` `anyone else` FALSE EQUALS `section 134 does not apply: no reward is given or expected`
#ASSERT `the maximum penalty for acting for reward (s 134(1))` EQUALS 750
#ASSERT `What can be recovered from me for false information` TRUE TRUE 12000 EQUALS `the payer may recover from you the financial benefit you gained, plus the costs the court considers appropriate (s 124(6b))` 12000
#ASSERT `What can be recovered from me for false information` TRUE FALSE 12000 EQUALS `no recovery under s 124(6b): it needs a payment to you and a finding of guilt under s 124(6) or (6a)`
#ASSERT `What can be recovered from me for false information` FALSE TRUE 12000 EQUALS `no recovery under s 124(6b): it needs a payment to you and a finding of guilt under s 124(6) or (6a)`
