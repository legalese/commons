#ASSERT `Was the vehicle insured on the day of the accident` `a permit` (`the date` 1 6 2025) (`the date` 30 6 2025) FALSE (`the date` 1 1 2000) (`the date` 1 7 2025) EQUALS `not insured under this Part on that day: the exemption or permit had ended (s 99A(8)(b))`
#ASSERT `Was the vehicle insured on the day of the accident` `an exemption from registration` (`the date` 1 6 2025) (`the date` 30 6 2025) FALSE (`the date` 1 1 2000) (`the date` 30 6 2025) EQUALS `insured: the accident was within the period of the registration, exemption or permit (s 99A(8))`

§§ `ss 99, 115, 116, 118A: who answers`

#ASSERT `Who answers my claim` (`the date` 5 5 2024) `driving` FALSE `a road car` TRUE `SA policy` FALSE EQUALS `the insurer answers`
#ASSERT `Who answers my claim` (`the date` 5 5 2024) `driving` FALSE `a road car` TRUE `SA policy` TRUE EQUALS `the nominal defendant, in place of an approved insurer declared under s 118A (s 118A(3))`
#ASSERT `Who answers my claim` (`the date` 5 5 2024) `driving` FALSE `a road car` FALSE `not identified after due inquiry and search` FALSE EQUALS `the nominal defendant, because the vehicle was not identified (s 115)`
#ASSERT `Who answers my claim` (`the date` 5 5 2024) `driving` FALSE `a road car` TRUE `not insured at all` FALSE EQUALS `the nominal defendant, because the vehicle was uninsured (s 116)`
#ASSERT `Who answers my claim` (`the date` 5 5 2024) `driving` FALSE `a road car` FALSE `not insured at all` FALSE EQUALS `no claim against the nominal defendant: the uninsured vehicle was not on a road (s 116(2))`
#ASSERT `Who answers my claim` (`the date` 5 5 2024) `driving` FALSE `a road car` TRUE `insured under a policy complying with another State's or Territory's law that covers its use in South Australia` FALSE EQUALS `not under this Part: the other State's or Territory's CTP insurer, under that law (s 116(1)(e))`
#ASSERT `Who answers my claim` (`the date` 5 5 2024) `driving` FALSE `a farm machine` TRUE `covered by a public liability or other policy that s 116(1)(a)-(d) accepts` FALSE EQUALS `not under this Part: the public liability or other insurer s 116(1)(a)-(d) names`
#ASSERT `Who answers my claim` (`the date` 5 5 2024) `other way` FALSE `a road car` TRUE `SA policy` FALSE EQUALS `no claim under this Part: the death or injury was not caused by and did not arise out of the use of a motor vehicle (s 99)`
#ASSERT `Who answers my claim` (`the date` 30 6 2013) `driving` FALSE `a road car` TRUE `SA policy` FALSE EQUALS `not covered: an accident before 1 July 2013`
#ASSERT `Who answers my claim` (`the date` 1 7 2013) `driving` FALSE `a road car` TRUE `SA policy` FALSE EQUALS `the insurer answers`

§§ `s 104(2): road race`

#ASSERT `Must the policy cover my road race injury` TRUE TRUE EQUALS `the Act does not require the policy to cover it; whether it does depends on the policy terms the CTP Regulator determines (s 104(2))`
#ASSERT `Must the policy cover my road race injury` TRUE FALSE EQUALS `the Act requires the policy to cover it (s 104(1)(a))`
#ASSERT `Must the policy cover my road race injury` FALSE FALSE EQUALS `the Act requires the policy to cover it (s 104(1)(a))`

§§ `s 116(3)(b): suing the uninsured driver`

#ASSERT `Can I sue the uninsured driver` (`the date` 5 5 2024) `driving` FALSE `a road car` TRUE `not insured at all` EQUALS `no: your action lies against the nominal defendant, and no action may be brought or continued against the uninsured owner or driver (s 116(3)(b))`
#ASSERT `Can I sue the uninsured driver` (`the date` 5 5 2024) `driving` FALSE `a road car` TRUE `SA policy` EQUALS `s 116(3)(b) does not stop it: your claim is not against the nominal defendant for an uninsured vehicle`
#ASSERT `Can I sue the uninsured driver` (`the date` 5 5 2024) `driving` FALSE `a road car` FALSE `not insured at all` EQUALS `s 116(3)(b) does not stop it: your claim is not against the nominal defendant for an uninsured vehicle`

