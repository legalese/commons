#ASSERT `the premises are a shared residence (s 71CB(1))` TRUE TRUE FALSE
#ASSERT NOT (`the premises are a shared residence (s 71CB(1))` TRUE TRUE TRUE)
#ASSERT NOT (`the premises are a shared residence (s 71CB(1))` TRUE FALSE FALSE)
#ASSERT `the transfer of the home is exempt (s 71CB(2)(a)(i))` TRUE TRUE `spouses or domestic partners` FALSE
#ASSERT `the transfer of the home is exempt (s 71CB(2)(a)(i))` TRUE TRUE `former spouses or former domestic partners` TRUE
#ASSERT NOT (`the transfer of the home is exempt (s 71CB(2)(a)(i))` TRUE TRUE `former spouses or former domestic partners` FALSE)
#ASSERT NOT (`the transfer of the home is exempt (s 71CB(2)(a)(i))` TRUE TRUE `neither` TRUE)
#ASSERT NOT (`the transfer of the home is exempt (s 71CB(2)(a)(i))` FALSE TRUE `spouses or domestic partners` FALSE)
#ASSERT NOT (`the transfer of the home is exempt (s 71CB(2)(a)(i))` TRUE FALSE `spouses or domestic partners` FALSE)
