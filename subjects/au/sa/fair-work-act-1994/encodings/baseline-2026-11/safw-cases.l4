#ASSERT `By what date must I apply for unfair dismissal relief` (dmy 20 12 2026) EQUALS dmy 10 1 2027
#ASSERT `Is my unfair dismissal application in time` (dmy 1 3 2026) (dmy 22 3 2026) FALSE FALSE EQUALS `ud in time`
#ASSERT `Is my unfair dismissal application in time` (dmy 1 3 2026) (dmy 23 3 2026) FALSE FALSE EQUALS `ud late`
#ASSERT `Is my unfair dismissal application in time` (dmy 1 3 2026) (dmy 1 3 2026) FALSE FALSE EQUALS `ud in time`
#ASSERT `Is my unfair dismissal application in time` (dmy 1 3 2026) (dmy 28 2 2026) FALSE FALSE EQUALS `too early: the dismissal had not taken effect when you applied (s 106(1))`
#ASSERT `Is my unfair dismissal application in time` (dmy 1 3 2026) (dmy 1 3 2027) TRUE FALSE EQUALS `in time: the 21 days do not apply, because the proceedings were referred to SAET under another law (s 106(3a))`
#ASSERT `Is my unfair dismissal application in time` (dmy 1 3 2026) (dmy 5 3 2026) FALSE TRUE EQUALS `no: you cannot bring proceedings for the dismissal before two or more adjudicating authorities at once (s 106(2))`
#ASSERT `Is my unfair dismissal application in time` (dmy 1 3 2026) (dmy 5 3 2026) TRUE TRUE EQUALS `no: you cannot bring proceedings for the dismissal before two or more adjudicating authorities at once (s 106(2))`

-- ss 108, 109 remedies: (found unfair, only redundancy pay, former job not workable, another job, none appropriate, cogent, under 50)
#ASSERT `What can SAET order for my dismissal` TRUE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS `re-employment in your former position, without prejudice to your former conditions of employment, the preferred remedy (s 109(1)(a), (1a))`
#ASSERT `What can SAET order for my dismissal` TRUE FALSE TRUE TRUE FALSE FALSE FALSE EQUALS `re-employment by the employer in another available position, on conditions SAET determines (s 109(1)(b))`
#ASSERT `What can SAET order for my dismissal` TRUE FALSE TRUE FALSE TRUE TRUE FALSE EQUALS `compensation from the employer, in an amount SAET determines up to the s 109(3) cap (s 109(1)(c), (3))`
#ASSERT `What can SAET order for my dismissal` TRUE FALSE TRUE TRUE TRUE FALSE TRUE EQUALS `compensation from the employer, in an amount SAET determines up to the s 109(3) cap (s 109(1)(c), (3))`
#ASSERT `What can SAET order for my dismissal` TRUE FALSE TRUE FALSE TRUE FALSE FALSE EQUALS `no remedy settled on these facts: re-employment is not ordered, yet SAET may award compensation only if satisfied that there are cogent reasons to believe re-employment would not be appropriate (s 109(1a)), unless the business has fewer than 50 employees (s 109(1b))`
#ASSERT `What can SAET order for my dismissal` FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `no relief: SAET is not satisfied that the dismissal was harsh, unjust or unreasonable (s 108(1), s 109(1))`
#ASSERT `What can SAET order for my dismissal` TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS `no relief: a dismissal with a redundancy payment under an industrial instrument cannot be harsh, unjust or unreasonable solely because the payment is inadequate (s 108(3))`

