IMPORT prelude
IMPORT `lta-common`
IMPORT `taa-procedure`

-- Taxation Administration Act 1996 (SA) -- cases for the procedure core (taa-procedure.l4).
--
-- Expected values worked by hand from the deposited text (the version of 2019-10-03, from the Open Australian Legal
-- Corpus; not the official text, and out of date), never copied from the encoding's output. Clock for the regulative
-- rules: days, from service of the assessment. Market rates are ASSUMED for the case.

§ `Cases -- the taxpayer (Taxation Administration Act 1996)`

§§ `ss 25-27 -- interest`

-- s 26(2)(a): the May average rounded to 2 decimal places, 0.005 up.
#ASSERT `the market rate from the May average` 4.355 EQUALS 4.36
#ASSERT `the market rate from the May average` 4.3549 EQUALS 4.35
#ASSERT `the interest rate, percent a year` 4.36 EQUALS 12.36
-- $10 000 unpaid after 31 July 2025, paid 12 October 2025 (73 days), market rate 4.00% assumed, so 12%:
-- $10 000 x 12% x 73/365 = $240.
#ASSERT `the interest on the tax default` 10000 4.00 (YMD 2025 7 31) (YMD 2025 10 12) EQUALS 240
-- $1 000 for 10 days at 12%: $3.29, under $20: none (s 27).
#ASSERT `the interest on the tax default` 1000 4.00 (YMD 2025 7 31) (YMD 2025 8 10) EQUALS 0
-- Paid on the last day: no interest.
#ASSERT `the interest on the tax default` 10000 4.00 (YMD 2025 7 31) (YMD 2025 7 31) EQUALS 0

§§ `ss 30-33 -- penalty tax`

GIVEN `unpaid` IS A NUMBER
      `deliberate` IS A BOOLEAN
      `satisfied` IS A BOOLEAN
      `disclosed outside an audit` IS A BOOLEAN
      `disclosed in an audit` IS A BOOLEAN
      `obstructive` IS A BOOLEAN
GIVETH A `Penalty tax facts`
`a default` MEANS
    `Penalty tax facts` WITH
        `the amount of tax unpaid`                                                                   IS `unpaid`
        `the tax default was deliberate`                                                             IS `deliberate`
        `the Commissioner is satisfied the default was not deliberate and not from a lack of reasonable care` IS `satisfied`
        `a sufficient disclosure was made while not subject to a tax audit`                          IS `disclosed outside an audit`
        `a sufficient disclosure was made while subject to a tax audit`                              IS `disclosed in an audit`
        `the Commissioner increases it for obstructive conduct during a tax audit`                   IS `obstructive`

-- $10 000 unpaid: 25% = $2 500; deliberate 75% = $7 500.
#ASSERT `the penalty tax` (`a default` 10000 FALSE FALSE FALSE FALSE FALSE) EQUALS 2500
#ASSERT `the penalty tax` (`a default` 10000 TRUE FALSE FALSE FALSE FALSE) EQUALS 7500
-- s 30(2): the Commissioner satisfied there was neither deliberation nor a lack of reasonable care: none.
#ASSERT `the penalty tax` (`a default` 10000 FALSE TRUE FALSE FALSE FALSE) EQUALS 0
-- A deliberate default cannot have s 30(2): $7 500 stays.
#ASSERT `the penalty tax` (`a default` 10000 TRUE TRUE FALSE FALSE FALSE) EQUALS 7500
-- s 31(2)(a): disclosed before any audit: 80% off $2 500 = $500. (b): disclosed during an audit: 20% off = $2 000.
#ASSERT `the penalty tax` (`a default` 10000 FALSE FALSE TRUE FALSE FALSE) EQUALS 500
#ASSERT `the penalty tax` (`a default` 10000 FALSE FALSE FALSE TRUE FALSE) EQUALS 2000
-- (c): obstruction, increased by 20%: $3 000; deliberate and obstructive: $9 000.
#ASSERT `the penalty tax` (`a default` 10000 FALSE FALSE FALSE FALSE TRUE) EQUALS 3000
#ASSERT `the penalty tax` (`a default` 10000 TRUE FALSE FALSE FALSE TRUE) EQUALS 9000
-- Deliberate, disclosed during the audit, and obstructive: $7 500 x 80% x 120% = $7 200.
#ASSERT `the penalty tax` (`a default` 10000 TRUE FALSE FALSE TRUE TRUE) EQUALS 7200
-- s 32: $70 at 25% is $17.50, under $20: none. $80 at 25% is $20: payable.
#ASSERT `the penalty tax` (`a default` 70 FALSE FALSE FALSE FALSE FALSE) EQUALS 0
#ASSERT `the penalty tax` (`a default` 80 FALSE FALSE FALSE FALSE FALSE) EQUALS 20
-- s 33: within the period the assessment specifies (30 days assumed).
#ASSERT EVALTRACE (`TAA s 33 -- pay the penalty tax within the period specified in the assessment` 30) 0 (LIST (EVENT `the taxpayer` `pay the penalty tax` 30)) EQUALS FULFILLED
-- expect: BREACH BY the taxpayer, "TAA s 33: penalty tax must be paid within the period specified in the assessment ..." (paid on day 31)
#TRACE `TAA s 33 -- pay the penalty tax within the period specified in the assessment` 30 AT 0 WITH
    PARTY `the taxpayer` DOES `pay the penalty tax` AT 31

§§ `ss 84, 86, 87, 91 -- objections`

-- s 84: a reassessment from $3 000 to $3 501 is open to objection only as to the $501 increase.
#ASSERT `the amount open to objection` TRUE 3000 3501 EQUALS 501
#ASSERT `the amount open to objection` TRUE 3501 3000 EQUALS 0
#ASSERT `the amount open to objection` FALSE 0 3501 EQUALS 3501
#ASSERT `the days to object` EQUALS 60
#ASSERT `the months within which the Minister may allow a late objection` EQUALS 12
#ASSERT NOT `an objection suspends recovery of the tax`

§§ `ss 92-95 -- appeals`

#ASSERT `the objector has a right of appeal under s 92` TRUE `the objection is disallowed` 0
#ASSERT `the objector has a right of appeal under s 92` TRUE `the objection is allowed in part only` 0
#ASSERT NOT (`the objector has a right of appeal under s 92` TRUE `the objection is allowed in full` 0)
-- s 92(b): no determination after 89 days: not yet; after 90 days (suspensions not counted): yes.
#ASSERT NOT (`the objector has a right of appeal under s 92` FALSE `the objection is disallowed` 89)
#ASSERT `the objector has a right of appeal under s 92` FALSE `the objection is disallowed` 90
-- s 93: half of $3 501 is $1 750.50.
#ASSERT `s 93 does not bar the appeal` 3501 1750.5 FALSE
#ASSERT NOT (`s 93 does not bar the appeal` 3501 1750 FALSE)
#ASSERT `s 93 does not bar the appeal` 3501 0 TRUE
#ASSERT `the days to appeal` EQUALS 60
#ASSERT `the days of notice to the Commissioner before an appeal on an undetermined objection` EQUALS 14
#ASSERT `the months within which the Supreme Court may allow a late appeal` EQUALS 12

§§ `Part 10 as a regulative rule`

-- Objected on day 50; disallowed on day 100; appealed on day 160 (60 days after the notice): in time.
#ASSERT EVALTRACE (`TAA Part 10 -- object within 60 days, then appeal within 60 days of the determination` 0) 0 (LIST (EVENT `the objector` `lodge a written notice of objection with the Minister, stating the grounds fully and in detail` 50), (EVENT `the Minister` (`give written notice of the determination of the objection, with reasons` `the objection is disallowed`) 100), (EVENT `the objector` `appeal to the Supreme Court` 160)) EQUALS FULFILLED
-- Allowed in full: nothing more.
#ASSERT EVALTRACE (`TAA Part 10 -- object within 60 days, then appeal within 60 days of the determination` 0) 0 (LIST (EVENT `the objector` `lodge a written notice of objection with the Minister, stating the grounds fully and in detail` 50), (EVENT `the Minister` (`give written notice of the determination of the objection, with reasons` `the objection is allowed in full`) 100)) EQUALS FULFILLED
-- An objection on day 61 is out of time: nothing follows from it (s 87 permission aside).
#ASSERT EVALTRACE (`TAA Part 10 -- object within 60 days, then appeal within 60 days of the determination` 0) 0 (LIST (EVENT `the objector` `lodge a written notice of objection with the Minister, stating the grounds fully and in detail` 61)) EQUALS FULFILLED
-- No determination within 90 days of the objection on day 50 (so by day 140): notice to the Commissioner on day 150,
-- appeal on day 170 (s 94(2)).
#ASSERT EVALTRACE (`TAA Part 10 -- object within 60 days, then appeal within 60 days of the determination` 0) 0 (LIST (EVENT `the objector` `lodge a written notice of objection with the Minister, stating the grounds fully and in detail` 50), (WAITUNTIL 141), (EVENT `the objector` `give the Commissioner written notice of the intention to appeal` 150), (EVENT `the objector` `appeal to the Supreme Court` 170)) EQUALS FULFILLED
-- A 20-day suspension under s 88 gives the Minister until day 160: a determination on day 155 (allowed in part) is in
-- time, and the appeal runs 60 days from it.
#ASSERT EVALTRACE (`TAA Part 10 -- object within 60 days, then appeal within 60 days of the determination` 20) 0 (LIST (EVENT `the objector` `lodge a written notice of objection with the Minister, stating the grounds fully and in detail` 50), (EVENT `the Minister` (`give written notice of the determination of the objection, with reasons` `the objection is allowed in part only`) 155), (EVENT `the objector` `appeal to the Supreme Court` 215)) EQUALS FULFILLED
-- expect: the objector's appeal to the Supreme Court still open, within 60 days of the determination served on day 100
#TRACE `TAA Part 10 -- object within 60 days, then appeal within 60 days of the determination` 0 AT 0 WITH
    PARTY `the objector` DOES `lodge a written notice of objection with the Minister, stating the grounds fully and in detail` AT 50
    PARTY `the Minister` DOES `give written notice of the determination of the objection, with reasons` `the objection is disallowed` AT 100
-- expect: the Minister's written notice of the determination pending (objection in time on day 50, day 120 not yet past day 140)
#TRACE `TAA Part 10 -- object within 60 days, then appeal within 60 days of the determination` 0 AT 0 WITH
    PARTY `the objector` DOES `lodge a written notice of objection with the Minister, stating the grounds fully and in detail` AT 50
    (WAITUNTIL 120)
