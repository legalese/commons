IMPORT prelude
IMPORT daydate
IMPORT `sa-interpretation-time`

-- Tests for sa-interpretation-time.l4.
-- Every expected value is worked out by hand from the text of the section named beside it,
-- with the calendar of the years concerned, before any run.
-- Weekdays used below: 15 and 16 July 2028 are a Saturday and a Sunday; 14 and 15 January 2030
-- are a Monday and a Tuesday; 31 August and 1 September 2030 are a Saturday and a Sunday;
-- 30 and 31 January 2026 are a Friday and a Saturday; 28 February 2026 is a Saturday;
-- 31 October and 1 November 2026 are a Saturday and a Sunday.
-- The abbreviations A, E and P in the names below stand for the three forms of s 44(1):
-- A = item 2 (begins at, on or with the day), E = item 3 (from the happening of an act or event on the day),
-- P = item 6 (begins after the day).

§ `Fixtures`

GIVETH A LIST OF `Public holiday`
`no public holidays` MEANS EMPTY

`a full-day public holiday on Monday 2 November 2026` MEANS
    `Public holiday` WITH `the day` IS Date 2 11 2026, `only part of the day` IS FALSE

`a part-day public holiday on Monday 2 November 2026` MEANS
    `Public holiday` WITH `the day` IS Date 2 11 2026, `only part of the day` IS TRUE

`a full-day public holiday on Monday 2 February 2026` MEANS
    `Public holiday` WITH `the day` IS Date 2 2 2026, `only part of the day` IS FALSE

§ `Days and moments (s 4 "day", s 28, s 30)`

-- s 4 "day": 24 hours ending at the stroke of midnight.
#ASSERT `s 4: seconds in a day` EQUALS 86400
-- s 28: comes into operation at the beginning of the day.
#ASSERT (`s 28: the moment an Act or provision comes into operation on a particular day` (Date 1 3 2026))'s `calendar day` EQUALS Date 1 3 2026
#ASSERT (`s 28: the moment an Act or provision comes into operation on a particular day` (Date 1 3 2026))'s `seconds into the day` EQUALS 0
-- s 30: continues to have effect until the end of the specified day.
#ASSERT (`s 30: the moment up to which an expiring provision continues to have effect` (Date 31 12 2026))'s `calendar day` EQUALS Date 31 12 2026
#ASSERT (`s 30: the moment up to which an expiring provision continues to have effect` (Date 31 12 2026))'s `seconds into the day` EQUALS 86400
-- In operation from the beginning of the commencement day: the instant just before is outside, the beginning is inside.
#ASSERT NOT (`ss 28 and 30: a provision is in operation at a moment` (`s 4: the beginning of a day` (Date 1 3 2026)) NOTHING ((Moment OF (Date 28 2 2026), 86399)))
#ASSERT `ss 28 and 30: a provision is in operation at a moment` (`s 4: the beginning of a day` (Date 1 3 2026)) NOTHING (`s 4: the beginning of a day` (Date 1 3 2026))
#ASSERT `ss 28 and 30: a provision is in operation at a moment` (`s 4: the beginning of a day` (Date 1 3 2026)) NOTHING ((Moment OF (Date 1 3 2026), 86399))
-- No expiry day: in operation for ever after commencement.
#ASSERT `ss 28 and 30: a provision is in operation at a moment` (`s 4: the beginning of a day` (Date 1 3 2026)) NOTHING (`s 4: the beginning of a day` (Date 1 1 2100))
-- Expiry day 31 December 2026: in operation through the last second of that day, not at the stroke of midnight after it.
#ASSERT `ss 28 and 30: a provision is in operation at a moment` (`s 4: the beginning of a day` (Date 1 3 2026)) (JUST (Date 31 12 2026)) ((Moment OF (Date 31 12 2026), 86399))
#ASSERT NOT (`ss 28 and 30: a provision is in operation at a moment` (`s 4: the beginning of a day` (Date 1 3 2026)) (JUST (Date 31 12 2026)) (`s 4: the end of a day` (Date 31 12 2026)))
#ASSERT NOT (`ss 28 and 30: a provision is in operation at a moment` (`s 4: the beginning of a day` (Date 1 3 2026)) (JUST (Date 31 12 2026)) (`s 4: the beginning of a day` (Date 1 1 2027)))

§ `Months, years and the other units (s 4)`

#ASSERT `s 4: is one of the 12 months of the calendar year` 1
#ASSERT `s 4: is one of the 12 months of the calendar year` 12
#ASSERT NOT (`s 4: is one of the 12 months of the calendar year` 0)
#ASSERT NOT (`s 4: is one of the 12 months of the calendar year` 13)
-- The text does not say what a week is.
#ASSERT `s 4: the number of days in a week the Act states` EQUALS NOTHING
-- s 4 "month": one month starting 15 January ends before 15 February.
#ASSERT `s 4 and s 44(1) item 8: the last day of a period of months beginning on a day` (Date 15 1 2025) 1 EQUALS Date 14 2 2025
-- A start on the 31st in a month with 30 days: no corresponding day in April, so the end of April.
#ASSERT `s 4 and s 44(1) item 8: the last day of a period of months beginning on a day` (Date 31 3 2025) 1 EQUALS Date 30 4 2025
-- A start on the 31st, February of a leap year (29 days) and of a common year (28 days).
#ASSERT `s 4 and s 44(1) item 8: the last day of a period of months beginning on a day` (Date 31 1 2024) 1 EQUALS Date 29 2 2024
#ASSERT `s 4 and s 44(1) item 8: the last day of a period of months beginning on a day` (Date 31 1 2025) 1 EQUALS Date 28 2 2025
-- A start on the 29th and the 30th, February of a common year.
#ASSERT `s 4 and s 44(1) item 8: the last day of a period of months beginning on a day` (Date 30 1 2025) 1 EQUALS Date 28 2 2025
#ASSERT `s 4 and s 44(1) item 8: the last day of a period of months beginning on a day` (Date 29 1 2025) 1 EQUALS Date 28 2 2025
-- A start on the 28th: the corresponding day exists, so the day before it.
#ASSERT `s 4 and s 44(1) item 8: the last day of a period of months beginning on a day` (Date 28 1 2025) 1 EQUALS Date 27 2 2025
-- A start on the 1st: the last day of the previous month.
#ASSERT `s 4 and s 44(1) item 8: the last day of a period of months beginning on a day` (Date 1 1 2026) 1 EQUALS Date 31 1 2026
-- Across the end of a year.
#ASSERT `s 4 and s 44(1) item 8: the last day of a period of months beginning on a day` (Date 15 12 2025) 1 EQUALS Date 14 1 2026
#ASSERT `s 4 and s 44(1) item 8: the last day of a period of months beginning on a day` (Date 15 11 2025) 3 EQUALS Date 14 2 2026
-- s 44(1) item 8: 2 or more months.
#ASSERT `s 4 and s 44(1) item 8: the last day of a period of months beginning on a day` (Date 31 12 2025) 2 EQUALS Date 28 2 2026
#ASSERT `s 4 and s 44(1) item 8: the last day of a period of months beginning on a day` (Date 30 12 2025) 2 EQUALS Date 28 2 2026
#ASSERT `s 4 and s 44(1) item 8: the last day of a period of months beginning on a day` (Date 28 12 2025) 2 EQUALS Date 27 2 2026
#ASSERT `s 4 and s 44(1) item 8: the last day of a period of months beginning on a day` (Date 31 1 2025) 2 EQUALS Date 30 3 2025
#ASSERT `s 4 and s 44(1) item 8: the last day of a period of months beginning on a day` (Date 30 11 2025) 3 EQUALS Date 28 2 2026
#ASSERT `s 4 and s 44(1) item 8: the last day of a period of months beginning on a day` (Date 15 1 2025) 12 EQUALS Date 14 1 2026
-- s 4 "year": ends immediately before the corresponding day of the next calendar year.
#ASSERT `s 4: the last day of a year beginning on a day` (Date 16 7 2025) EQUALS Date 15 7 2026
#ASSERT `s 4: the last day of a year beginning on a day` (Date 1 1 2025) EQUALS Date 31 12 2025
#ASSERT `s 4: the last day of a year beginning on a day` (Date 1 3 2024) EQUALS Date 28 2 2025
#ASSERT `s 4: the last day of a year beginning on a day` (Date 1 3 2027) EQUALS Date 29 2 2028
-- s 4 "year" (b): a year starting at the beginning of 29 February ends at the end of 28 February next year.
#ASSERT `s 4: the last day of a year beginning on a day` (Date 29 2 2024) EQUALS Date 28 2 2025
#ASSERT `s 4: the last day of a year beginning on a day` (Date 28 2 2024) EQUALS Date 27 2 2025
-- Several years: successive years.
#ASSERT `s 4: the last day of a period of years beginning on a day` (Date 16 7 2025) 3 EQUALS Date 15 7 2028
#ASSERT `s 4: the last day of a period of years beginning on a day` (Date 29 2 2024) 2 EQUALS Date 28 2 2026
#ASSERT `s 4: the last day of a period of years beginning on a day` (Date 29 2 2024) 4 EQUALS Date 29 2 2028
#ASSERT `s 4: the last day of a period of years beginning on a day` (Date 1 3 2024) 4 EQUALS Date 29 2 2028
-- Two readings that the encoding does not take, and where they part from the one it takes.
-- 2 months beginning 31 January 2025: item 8 gives 30 March; counting a month at a time gives 31 March.
#ASSERT `s 4 and s 44(1) item 8: the last day of a period of months beginning on a day` (Date 31 1 2025) 2 EQUALS Date 30 3 2025
#ASSERT `s 4 and s 44(1) item 8, alternative reading: the last day of a period of months counted one month at a time` (Date 31 1 2025) 2 EQUALS Date 31 3 2025
-- 2 months beginning 15 January 2025: the two agree.
#ASSERT `s 4 and s 44(1) item 8, alternative reading: the last day of a period of months counted one month at a time` (Date 15 1 2025) 2 EQUALS Date 14 3 2025
-- 4 years beginning 29 February 2024: successive years give 29 February 2028; one step gives 28 February 2028.
#ASSERT `s 4, alternative reading: the last day of a period of years counted in one step` (Date 29 2 2024) 4 EQUALS Date 28 2 2028
-- 2 years beginning 29 February 2024, and 3 years beginning 16 July 2025: the two agree.
#ASSERT `s 4, alternative reading: the last day of a period of years counted in one step` (Date 29 2 2024) 2 EQUALS Date 28 2 2026
#ASSERT `s 4, alternative reading: the last day of a period of years counted in one step` (Date 16 7 2025) 3 EQUALS Date 15 7 2028
-- s 4 "calendar year" and "financial year".
#ASSERT `s 4: the last day of the calendar year` 2025 EQUALS Date 31 12 2025
#ASSERT `s 4: the last day of the calendar year` 2024 EQUALS Date 31 12 2024
#ASSERT `s 4: the last day of the financial year starting on 1 July` 2025 EQUALS Date 30 6 2026
#ASSERT `s 4: the last day of the financial year starting on 1 July` 2027 EQUALS Date 30 6 2028

§ `Business days and public holidays (s 4, s 46, s 44(2))`

-- Saturday 31 October and Sunday 1 November 2026 are not business days; Monday 2 November is one.
#ASSERT NOT (`s 4: is a business day` (Date 31 10 2026) `no public holidays`)
#ASSERT NOT (`s 4: is a business day` (Date 1 11 2026) `no public holidays`)
#ASSERT `s 4: is a business day` (Date 2 11 2026) `no public holidays`
-- A full-day public holiday is not a business day; a part-day public holiday does not take the day out.
#ASSERT NOT (`s 4: is a business day` (Date 2 11 2026) (LIST `a full-day public holiday on Monday 2 November 2026`))
#ASSERT `s 4: is a business day` (Date 2 11 2026) (LIST `a part-day public holiday on Monday 2 November 2026`)
#ASSERT `s 4: is a business day` (Date 3 11 2026) (LIST `a full-day public holiday on Monday 2 November 2026`)
-- s 46: the exclusion reaches a part-day holiday only if the Act expressly says so.
#ASSERT `s 46: an exclusion of public holidays extends to a holiday` `a part-day public holiday on Monday 2 November 2026` FALSE EQUALS JUST FALSE
#ASSERT `s 46: an exclusion of public holidays extends to a holiday` `a part-day public holiday on Monday 2 November 2026` TRUE EQUALS JUST TRUE
#ASSERT `s 46: an exclusion of public holidays extends to a holiday` `a full-day public holiday on Monday 2 November 2026` FALSE EQUALS JUST TRUE
-- s 44(2): a last day that is not a business day moves to the next business day.
#ASSERT `s 44(2): the last day on which a thing may be done` (Date 31 10 2026) `no public holidays` EQUALS Date 2 11 2026
#ASSERT `s 44(2): the last day on which a thing may be done` (Date 1 11 2026) `no public holidays` EQUALS Date 2 11 2026
#ASSERT `s 44(2): the last day on which a thing may be done` (Date 2 11 2026) `no public holidays` EQUALS Date 2 11 2026
#ASSERT `s 44(2): the last day on which a thing may be done` (Date 30 10 2026) `no public holidays` EQUALS Date 30 10 2026
-- ... and past a public holiday that follows the weekend.
#ASSERT `s 44(2): the last day on which a thing may be done` (Date 31 10 2026) (LIST `a full-day public holiday on Monday 2 November 2026`) EQUALS Date 3 11 2026
#ASSERT `s 44(2): the last day on which a thing may be done` (Date 31 10 2026) (LIST `a part-day public holiday on Monday 2 November 2026`) EQUALS Date 2 11 2026

§ `Counting a period (s 44(1)): the worked cases`

-- First day counted.
#ASSERT `s 44(1): the first day counted in a period` `begins at, on or with a specified day` (Date 1 1 2026) EQUALS JUST (Date 1 1 2026)
#ASSERT `s 44(1): the first day counted in a period` `begins on, from or after the happening of an act or event` (Date 1 1 2026) EQUALS JUST (Date 2 1 2026)
#ASSERT `s 44(1): the first day counted in a period` `begins after a specified day` (Date 1 1 2026) EQUALS JUST (Date 2 1 2026)
#ASSERT `s 44(1): the first day counted in a period` `begins from a specified day` (Date 1 1 2026) EQUALS NOTHING

-- Case 1: three years from 2025-07-16.
-- A: first day 16 July 2025, last day 15 July 2028 (a Saturday).
#ASSERT `s 44(1): the last day of a period` `begins at, on or with a specified day` (Date 16 7 2025) (`a number of years` 3) EQUALS JUST (Date 15 7 2028)
-- E and P: first day 17 July 2025, last day 16 July 2028 (a Sunday).
#ASSERT `s 44(1): the last day of a period` `begins on, from or after the happening of an act or event` (Date 16 7 2025) (`a number of years` 3) EQUALS JUST (Date 16 7 2028)
#ASSERT `s 44(1): the last day of a period` `begins after a specified day` (Date 16 7 2025) (`a number of years` 3) EQUALS JUST (Date 16 7 2028)
#ASSERT `s 44(1): the last day of a period` `begins from a specified day` (Date 16 7 2025) (`a number of years` 3) EQUALS NOTHING
-- s 44(2): both fall on a weekend, so the thing may be done on Monday 17 July 2028.
#ASSERT `s 44(1) and (2): the last day on which a thing may be done within a period` `begins at, on or with a specified day` (Date 16 7 2025) (`a number of years` 3) `no public holidays` EQUALS JUST (Date 17 7 2028)
#ASSERT `s 44(1) and (2): the last day on which a thing may be done within a period` `begins on, from or after the happening of an act or event` (Date 16 7 2025) (`a number of years` 3) `no public holidays` EQUALS JUST (Date 17 7 2028)

-- Case 2: five years from 2025-01-15.
-- A: last day 14 January 2030 (a Monday).  E: last day 15 January 2030 (a Tuesday).  Both are business days.
#ASSERT `s 44(1) and (2): the last day on which a thing may be done within a period` `begins at, on or with a specified day` (Date 15 1 2025) (`a number of years` 5) `no public holidays` EQUALS JUST (Date 14 1 2030)
#ASSERT `s 44(1) and (2): the last day on which a thing may be done within a period` `begins on, from or after the happening of an act or event` (Date 15 1 2025) (`a number of years` 5) `no public holidays` EQUALS JUST (Date 15 1 2030)
#ASSERT `s 44(1) and (2): the last day on which a thing may be done within a period` `begins after a specified day` (Date 15 1 2025) (`a number of years` 5) `no public holidays` EQUALS JUST (Date 15 1 2030)

-- Case 3: five years from 2025-09-01.
-- A: last day 31 August 2030 (a Saturday).  E: last day 1 September 2030 (a Sunday).  Both move to Monday 2 September 2030.
#ASSERT `s 44(1): the last day of a period` `begins at, on or with a specified day` (Date 1 9 2025) (`a number of years` 5) EQUALS JUST (Date 31 8 2030)
#ASSERT `s 44(1): the last day of a period` `begins on, from or after the happening of an act or event` (Date 1 9 2025) (`a number of years` 5) EQUALS JUST (Date 1 9 2030)
#ASSERT `s 44(1) and (2): the last day on which a thing may be done within a period` `begins at, on or with a specified day` (Date 1 9 2025) (`a number of years` 5) `no public holidays` EQUALS JUST (Date 2 9 2030)
#ASSERT `s 44(1) and (2): the last day on which a thing may be done within a period` `begins on, from or after the happening of an act or event` (Date 1 9 2025) (`a number of years` 5) `no public holidays` EQUALS JUST (Date 2 9 2030)

-- Case 4: thirty days from 2026-01-01.
-- A: first day 1 January, last day 30 January 2026 (a Friday).  E: first day 2 January, last day 31 January (a Saturday), moving to Monday 2 February 2026.
#ASSERT `s 44(1): the last day of a period` `begins at, on or with a specified day` (Date 1 1 2026) (`a number of days` 30) EQUALS JUST (Date 30 1 2026)
#ASSERT `s 44(1): the last day of a period` `begins on, from or after the happening of an act or event` (Date 1 1 2026) (`a number of days` 30) EQUALS JUST (Date 31 1 2026)
#ASSERT `s 44(1): the last day of a period` `begins after a specified day` (Date 1 1 2026) (`a number of days` 30) EQUALS JUST (Date 31 1 2026)
#ASSERT `s 44(1) and (2): the last day on which a thing may be done within a period` `begins at, on or with a specified day` (Date 1 1 2026) (`a number of days` 30) `no public holidays` EQUALS JUST (Date 30 1 2026)
#ASSERT `s 44(1) and (2): the last day on which a thing may be done within a period` `begins on, from or after the happening of an act or event` (Date 1 1 2026) (`a number of days` 30) `no public holidays` EQUALS JUST (Date 2 2 2026)
-- If Monday 2 February 2026 were a full-day public holiday, the next business day is Tuesday 3 February.
#ASSERT `s 44(1) and (2): the last day on which a thing may be done within a period` `begins on, from or after the happening of an act or event` (Date 1 1 2026) (`a number of days` 30) (LIST `a full-day public holiday on Monday 2 February 2026`) EQUALS JUST (Date 3 2 2026)

-- Case 5: two months from 2025-12-31.
-- A: ending month February 2026, no 31st, so the end of February: 28 February 2026 (a Saturday).
-- E: first day 1 January 2026, ending month March, ends immediately before 1 March: 28 February 2026.
-- Both move to Monday 2 March 2026.
#ASSERT `s 44(1): the last day of a period` `begins at, on or with a specified day` (Date 31 12 2025) (`a number of months` 2) EQUALS JUST (Date 28 2 2026)
#ASSERT `s 44(1): the last day of a period` `begins on, from or after the happening of an act or event` (Date 31 12 2025) (`a number of months` 2) EQUALS JUST (Date 28 2 2026)
#ASSERT `s 44(1) and (2): the last day on which a thing may be done within a period` `begins at, on or with a specified day` (Date 31 12 2025) (`a number of months` 2) `no public holidays` EQUALS JUST (Date 2 3 2026)
#ASSERT `s 44(1) and (2): the last day on which a thing may be done within a period` `begins on, from or after the happening of an act or event` (Date 31 12 2025) (`a number of months` 2) `no public holidays` EQUALS JUST (Date 2 3 2026)

-- Case 6: one month from 2024-01-31.
-- A: February 2024 has 29 days, no 31st, so 29 February 2024 (a Thursday).
-- E: first day 1 February, ends immediately before 1 March: 29 February 2024.
#ASSERT `s 44(1): the last day of a period` `begins at, on or with a specified day` (Date 31 1 2024) (`a number of months` 1) EQUALS JUST (Date 29 2 2024)
#ASSERT `s 44(1): the last day of a period` `begins on, from or after the happening of an act or event` (Date 31 1 2024) (`a number of months` 1) EQUALS JUST (Date 29 2 2024)
#ASSERT `s 44(1) and (2): the last day on which a thing may be done within a period` `begins at, on or with a specified day` (Date 31 1 2024) (`a number of months` 1) `no public holidays` EQUALS JUST (Date 29 2 2024)

-- Case 7: one year from 2024-02-29.
-- A: a year starting on 29 February ends at the end of 28 February 2025 (a Friday).
-- E: first day 1 March 2024, ends immediately before 1 March 2025: 28 February 2025.
#ASSERT `s 44(1): the last day of a period` `begins at, on or with a specified day` (Date 29 2 2024) (`a number of years` 1) EQUALS JUST (Date 28 2 2025)
#ASSERT `s 44(1): the last day of a period` `begins on, from or after the happening of an act or event` (Date 29 2 2024) (`a number of years` 1) EQUALS JUST (Date 28 2 2025)
#ASSERT `s 44(1) and (2): the last day on which a thing may be done within a period` `begins on, from or after the happening of an act or event` (Date 29 2 2024) (`a number of years` 1) `no public holidays` EQUALS JUST (Date 28 2 2025)

-- Edge cases of the length.
#ASSERT `s 44(1): the last day of a period` `begins at, on or with a specified day` (Date 1 3 2026) (`a number of days` 1) EQUALS JUST (Date 1 3 2026)
#ASSERT `s 44(1): the last day of a period` `begins on, from or after the happening of an act or event` (Date 1 3 2026) (`a number of days` 1) EQUALS JUST (Date 2 3 2026)
#ASSERT `s 44(1): the last day of a period` `begins at, on or with a specified day` (Date 1 3 2026) (`a number of days` 0) EQUALS NOTHING
#ASSERT `s 44(1): the last day of a period` `begins at, on or with a specified day` (Date 1 3 2026) (`a number of months` 0) EQUALS NOTHING
#ASSERT `s 44(1): the last day of a period` `begins at, on or with a specified day` (Date 1 3 2026) (`a number of years` 0) EQUALS NOTHING
-- The text does not say what a week is, so a period of weeks is not counted, in any form.
#ASSERT `s 44(1): the last day of a period` `begins at, on or with a specified day` (Date 1 3 2026) (`a number of weeks` 4) EQUALS NOTHING
#ASSERT `s 44(1): the last day of a period` `begins on, from or after the happening of an act or event` (Date 1 3 2026) (`a number of weeks` 4) EQUALS NOTHING
#ASSERT `s 44(1) and (2): the last day on which a thing may be done within a period` `begins at, on or with a specified day` (Date 1 3 2026) (`a number of weeks` 4) `no public holidays` EQUALS NOTHING

-- s 44(1) items 1, 4, 5 and 7: a period that ends by reference to a day.
#ASSERT `s 44(1) items 4, 5 and 7: the last day of a period that ends by reference to a specified day` `continues until a specified day` (Date 15 6 2026) EQUALS Date 15 6 2026
#ASSERT `s 44(1) items 4, 5 and 7: the last day of a period that ends by reference to a specified day` `ends at, on or with a specified day` (Date 15 6 2026) EQUALS Date 15 6 2026
#ASSERT `s 44(1) items 4, 5 and 7: the last day of a period that ends by reference to a specified day` `ends before a specified day` (Date 15 6 2026) EQUALS Date 14 6 2026
#ASSERT `s 44(1) items 4, 5 and 7: the last day of a period that ends by reference to a specified day` `ends before a specified day` (Date 1 3 2026) EQUALS Date 28 2 2026
#ASSERT (`s 44(1) item 1: the days of a period expressed to occur between 2 days` (Date 1 6 2026) (Date 30 6 2026))'s `first day` EQUALS Date 1 6 2026
#ASSERT (`s 44(1) item 1: the days of a period expressed to occur between 2 days` (Date 1 6 2026) (Date 30 6 2026))'s `last day` EQUALS Date 30 6 2026
-- Item 1: both days named are among the days of the period, and so is every day between them; the day before and the day after are not.
#ASSERT `s 44(1) item 1: a day is one of the days of a period expressed to occur between 2 days` (Date 1 6 2026) (Date 30 6 2026) (Date 1 6 2026) EQUALS TRUE
#ASSERT `s 44(1) item 1: a day is one of the days of a period expressed to occur between 2 days` (Date 1 6 2026) (Date 30 6 2026) (Date 30 6 2026) EQUALS TRUE
#ASSERT `s 44(1) item 1: a day is one of the days of a period expressed to occur between 2 days` (Date 1 6 2026) (Date 30 6 2026) (Date 15 6 2026) EQUALS TRUE
#ASSERT `s 44(1) item 1: a day is one of the days of a period expressed to occur between 2 days` (Date 1 6 2026) (Date 30 6 2026) (Date 31 5 2026) EQUALS FALSE
#ASSERT `s 44(1) item 1: a day is one of the days of a period expressed to occur between 2 days` (Date 1 6 2026) (Date 30 6 2026) (Date 1 7 2026) EQUALS FALSE

§ `A thing required to be done with no period fixed (s 44(3))`

#ASSERT `s 44(3): the thing must be done as soon as is reasonably practicable` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 44(3): the thing must be done as soon as is reasonably practicable` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 44(3): the thing must be done as soon as is reasonably practicable` FALSE FALSE EQUALS JUST FALSE

§ `Commencement (s 27)`

#ASSERT `s 27(1): the day an Act with no commencement provision comes into operation` (Date 10 5 2026) EQUALS Date 10 5 2026
-- s 27(2): a reserved Bill is taken to be assented to on the day the assent is notified by proclamation.
#ASSERT `s 27(2): the day a Bill is taken to have been assented to` TRUE (Date 10 5 2026) (Date 20 5 2026) EQUALS Date 20 5 2026
#ASSERT `s 27(2): the day a Bill is taken to have been assented to` FALSE (Date 10 5 2026) (Date 20 5 2026) EQUALS Date 10 5 2026
-- s 27(3): one proclamation fixing a day.
#ASSERT `s 27(3) and (5): the day fixed by the proclamations made so far` EMPTY EQUALS NOTHING
#ASSERT `s 27(3) and (5): the day fixed by the proclamations made so far` (LIST (Proclamation OF (Date 1 3 2026), (JUST (Date 1 9 2026)))) EQUALS JUST (Date 1 9 2026)
-- s 27(5): a later proclamation made before the day fixed changes the day.
#ASSERT `s 27(3) and (5): the day fixed by the proclamations made so far` (LIST (Proclamation OF (Date 1 3 2026), (JUST (Date 1 9 2026))), (Proclamation OF (Date 1 8 2026), (JUST (Date 1 12 2026)))) EQUALS JUST (Date 1 12 2026)
-- ... one made on the day fixed, or after it, does not.
#ASSERT `s 27(3) and (5): the day fixed by the proclamations made so far` (LIST (Proclamation OF (Date 1 3 2026), (JUST (Date 1 9 2026))), (Proclamation OF (Date 1 9 2026), (JUST (Date 1 1 2027)))) EQUALS JUST (Date 1 9 2026)
-- s 27(3)(c): a suspension, then a later proclamation fixing a day.
#ASSERT `s 27(3) and (5): the day fixed by the proclamations made so far` (LIST (Proclamation OF (Date 1 3 2026), (NOTHING)), (Proclamation OF (Date 1 4 2026), (JUST (Date 1 10 2026)))) EQUALS JUST (Date 1 10 2026)
#ASSERT `s 27(3) and (5): the day fixed by the proclamations made so far` (LIST (Proclamation OF (Date 1 3 2026), (JUST (Date 1 9 2026))), (Proclamation OF (Date 1 8 2026), (NOTHING))) EQUALS NOTHING
-- s 27(6): the second anniversary of assent (assent on 1 March 2026 gives 1 March 2028).
#ASSERT `s 27(6) and (7): the day an Act or provision to be brought into operation by proclamation comes into operation` TRUE FALSE (Date 1 3 2026) (JUST (Date 1 1 2027)) EQUALS JUST (Date 1 1 2027)
#ASSERT `s 27(6) and (7): the day an Act or provision to be brought into operation by proclamation comes into operation` TRUE FALSE (Date 1 3 2026) (JUST (Date 1 3 2028)) EQUALS JUST (Date 1 3 2028)
#ASSERT `s 27(6) and (7): the day an Act or provision to be brought into operation by proclamation comes into operation` TRUE FALSE (Date 1 3 2026) (JUST (Date 1 1 2029)) EQUALS JUST (Date 1 3 2028)
#ASSERT `s 27(6) and (7): the day an Act or provision to be brought into operation by proclamation comes into operation` TRUE FALSE (Date 1 3 2026) NOTHING EQUALS JUST (Date 1 3 2028)
-- s 27(7): the Act or provision says that subsection (6) does not apply; or subsection (6) does not cover it.
#ASSERT `s 27(6) and (7): the day an Act or provision to be brought into operation by proclamation comes into operation` TRUE TRUE (Date 1 3 2026) NOTHING EQUALS NOTHING
#ASSERT `s 27(6) and (7): the day an Act or provision to be brought into operation by proclamation comes into operation` FALSE FALSE (Date 1 3 2026) (JUST (Date 1 1 2029)) EQUALS JUST (Date 1 1 2029)
-- Assent on 29 February: no provision gives the second anniversary.
#ASSERT `s 27(6): the anniversary of a day in a later year` (Date 29 2 2024) 2 EQUALS NOTHING
#ASSERT `s 27(6): the anniversary of a day in a later year` (Date 29 2 2024) 4 EQUALS JUST (Date 29 2 2028)
#ASSERT `s 27(6): the anniversary of a day in a later year` (Date 28 2 2024) 2 EQUALS JUST (Date 28 2 2026)
#ASSERT `s 27(6) and (7): the day an Act or provision to be brought into operation by proclamation comes into operation` TRUE FALSE (Date 29 2 2024) NOTHING EQUALS NOTHING

§ `Attaining an age (s 49)`

#ASSERT (`s 49: the moment a person attains an age in years` (Date 15 5 2008) 18)'s `calendar day` EQUALS Date 15 5 2026
#ASSERT (`s 49: the moment a person attains an age in years` (Date 15 5 2008) 18)'s `seconds into the day` EQUALS 0
-- s 49(2): born on 29 February, in a year that is not a leap year the age is attained at the beginning of 1 March.
#ASSERT (`s 49: the moment a person attains an age in years` (Date 29 2 2008) 18)'s `calendar day` EQUALS Date 1 3 2026
#ASSERT (`s 49: the moment a person attains an age in years` (Date 29 2 2008) 17)'s `calendar day` EQUALS Date 1 3 2025
-- ... and in a leap year, on 29 February.
#ASSERT (`s 49: the moment a person attains an age in years` (Date 29 2 2008) 16)'s `calendar day` EQUALS Date 29 2 2024
#ASSERT (`s 49: the moment a person attains an age in years` (Date 29 2 2008) 20)'s `calendar day` EQUALS Date 29 2 2028

§ `Service of a document by post (s 51(5))`

#ASSERT (`s 51(5): the moment service by post is taken to be effected` ((Moment OF (Date 5 6 2026), 36000)) FALSE NOTHING) EQUALS JUST ((Moment OF (Date 5 6 2026), 36000))
#ASSERT (`s 51(5): the moment service by post is taken to be effected` ((Moment OF (Date 5 6 2026), 36000)) TRUE (JUST ((Moment OF (Date 8 6 2026), 0)))) EQUALS JUST ((Moment OF (Date 8 6 2026), 0))
#ASSERT (`s 51(5): the moment service by post is taken to be effected` ((Moment OF (Date 5 6 2026), 36000)) TRUE NOTHING) EQUALS NOTHING
