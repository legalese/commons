-- Hand-written readings of the general function, on both sides of each branch.
-- "amend includes omit, insert, substitute, alter, vary": an open list.
#ASSERT `a thing falls within the Act's definition of a term` "amend" FALSE (LIST FALSE, FALSE, TRUE, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `a thing falls within the Act's definition of a term` "amend" FALSE (LIST FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS NOTHING
-- "internal Territory means ...": a closed definition, of one limb that names three Territories.
#ASSERT `a thing falls within the Act's definition of a term` "internal Territory" FALSE (LIST TRUE) EQUALS JUST TRUE
#ASSERT `a thing falls within the Act's definition of a term` "internal Territory" FALSE (LIST FALSE) EQUALS JUST FALSE
-- "Act means (a) ... or (b) ...": two alternatives.
#ASSERT `a thing falls within the Act's definition of a term` "Act" FALSE (LIST FALSE, TRUE) EQUALS JUST TRUE
#ASSERT `a thing falls within the Act's definition of a term` "Act" FALSE (LIST FALSE, FALSE) EQUALS JUST FALSE
-- "Australia Acts means (a) ... and (b) ...": the limbs are listed items; a thing that is one of them is within the definition.
#ASSERT `a thing falls within the Act's definition of a term` "Australia Acts" FALSE (LIST TRUE, FALSE) EQUALS JUST TRUE
#ASSERT `a thing falls within the Act's definition of a term` "Australia Acts" FALSE (LIST FALSE, TRUE) EQUALS JUST TRUE
#ASSERT `a thing falls within the Act's definition of a term` "Australia Acts" FALSE (LIST FALSE, FALSE) EQUALS JUST FALSE
-- "bank means an ADI that is permitted ... to assume or use (a) ... or (b) ...": the words before the limbs are a condition.
#ASSERT `a thing falls within the Act's definition of a term` "bank" TRUE (LIST FALSE, TRUE) EQUALS JUST TRUE
#ASSERT `a thing falls within the Act's definition of a term` "bank" FALSE (LIST TRUE, TRUE) EQUALS JUST FALSE
#ASSERT `a thing falls within the Act's definition of a term` "bank" TRUE (LIST FALSE, FALSE) EQUALS JUST FALSE
-- "administrative unit has the same meaning as in the Public Sector Act 2009": the other Act's meaning is an input.
#ASSERT `a thing falls within the Act's definition of a term` "administrative unit" TRUE EMPTY EQUALS JUST TRUE
#ASSERT `a thing falls within the Act's definition of a term` "administrative unit" FALSE EMPTY EQUALS JUST FALSE
-- "Australia" and "Commonwealth": means ... and includes ...: the general function says NOTHING; the dedicated one reads the places.
#ASSERT `a thing falls within the Act's definition of a term` "Australia" TRUE (LIST TRUE) EQUALS NOTHING
#ASSERT `a place is within Australia or the Commonwealth` `the Commonwealth of Australia` FALSE EQUALS JUST TRUE
#ASSERT `a place is within Australia or the Commonwealth` `Norfolk Island` TRUE EQUALS JUST TRUE
#ASSERT `a place is within Australia or the Commonwealth` `Norfolk Island` FALSE EQUALS NOTHING
#ASSERT `a place is within Australia or the Commonwealth` `the Territory of Christmas Island` TRUE EQUALS JUST TRUE
#ASSERT `a place is within Australia or the Commonwealth` `the Territory of Cocos (Keeling) Islands` TRUE EQUALS JUST TRUE
#ASSERT `a place is within Australia or the Commonwealth` `another external Territory` TRUE EQUALS JUST FALSE
#ASSERT `a place is within Australia or the Commonwealth` `another external Territory` FALSE EQUALS JUST FALSE
-- "sitting day": a day on which the House actually sits, but not a new day for the part of a sitting that runs past midnight.
#ASSERT `a day is a sitting day of a House` TRUE FALSE
#ASSERT NOT (`a day is a sitting day of a House` FALSE FALSE)
#ASSERT NOT (`a day is a sitting day of a House` TRUE TRUE)
#ASSERT NOT (`a day is a sitting day of a House` FALSE TRUE)
