#ASSERT `May my law practice sue me for its costs on this day` FALSE FALSE TRUE (`the date` 1 3 2025) TRUE TRUE (`the date` 20 3 2025) FALSE (`the date` 19 4 2025) EQUALS `yes: at least 30 days have passed since the bill (cll 31(1), 34(4), (5))`
#ASSERT `May my law practice sue me for its costs on this day` FALSE FALSE TRUE (`the date` 1 3 2025) TRUE FALSE `d` FALSE (`the date` 19 4 2025) EQUALS `not until it has given you the itemised bill you asked for, and 30 days have passed (cl 34(5))`
#ASSERT `May my law practice sue me for its costs on this day` FALSE FALSE FALSE `d` FALSE FALSE `d` FALSE (`the date` 19 4 2025) EQUALS `not until it has given you a bill in accordance with clauses 32 and 33, and 30 days have passed (cl 31(1))`
