IMPORT prelude

-- Carer Recognition Act 2010 (Cth) — THE NOUNS.
-- Source: ../registers/source-bundle/C2010A00123.txt. Seat: the carer.

§ `Nouns`

-- s 5(1)(a)-(d): why the other individual needs the care
DECLARE `Need for care` IS ONE OF
    `a disability`
    `a medical condition, including a terminal or chronic illness`
    `a mental illness`
    `being frail and aged`
    `none of these`

-- s 5(2): the basis on which the care is given
DECLARE `Basis of care` IS ONE OF
    `informally`
    `under a contract of service or for services`
    `voluntary work for a charitable, welfare or community organisation`
    `as part of a course of education or training`

-- s 4(1)-(3)
DECLARE `Kind of body` IS ONE OF
    `a public service care agency`
    `another public service agency`
    `an associated provider`
    `another body`

DECLARE `Carer case` HAS
    -- s 5(1): I provide personal care, support and assistance to another
    -- individual who needs it
    `I provide personal care, support and assistance`   IS A BOOLEAN
    `the need`                                          IS A `Need for care`
    `the basis`                                         IS A `Basis of care`
    `the body I deal with`                              IS A `Kind of body`

DECLARE `Carer position` HAS
    `I am a carer`                                      IS A BOOLEAN
    `the body must make its staff aware of the Statement` IS A BOOLEAN
    `the body must reflect the Statement in care supports` IS A BOOLEAN
    `the body must consult carers on care supports`     IS A BOOLEAN
    `I can enforce these obligations`                   IS A BOOLEAN
    `non-compliance invalidates a decision`             IS A BOOLEAN
