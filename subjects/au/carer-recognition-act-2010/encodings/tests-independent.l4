IMPORT prelude
IMPORT `carer-types`
IMPORT `carer-rules`

-- Independent tests: Carer Recognition Act 2010 (Cth).
-- Expectations fixed in independent-expectations.md before reading the code.

§ `Independent tests`

GIVEN gives IS A BOOLEAN
      why IS A `Need for care`
      how IS A `Basis of care`
      who IS A `Kind of body`
GIVETH A `Carer case`
`case of` gives why how who MEANS `Carer case` OF gives, why, how, who

-- s 5(1)(a)-(d): unpaid care for each need (scenarios 1-4)
#ASSERT `I am a carer under the Act` (`case of` TRUE (`a disability`) (`informally`) (`another body`))
#ASSERT `I am a carer under the Act` (`case of` TRUE (`a medical condition, including a terminal or chronic illness`) (`informally`) (`another body`))
#ASSERT `I am a carer under the Act` (`case of` TRUE (`a mental illness`) (`informally`) (`another body`))
#ASSERT `I am a carer under the Act` (`case of` TRUE (`being frail and aged`) (`informally`) (`another body`))

-- s 5(1): none of the four needs (scenario 5)
#ASSERT NOT (`I am a carer under the Act` (`case of` TRUE (`none of these`) (`informally`) (`another body`)))

-- s 5(3): relative / guardian / co-resident giving no care (scenarios 6-8)
#ASSERT NOT (`I am a carer under the Act` (`case of` FALSE (`a disability`) (`informally`) (`another body`)))
#ASSERT NOT (`I am a carer under the Act` (`case of` FALSE (`a mental illness`) (`informally`) (`a public service care agency`)))
#ASSERT NOT (`I am a carer under the Act` (`case of` FALSE (`being frail and aged`) (`informally`) (`another public service agency`)))

-- s 5(1)(b), 5(3): spouse who does give care (scenario 9)
#ASSERT `I am a carer under the Act` (`case of` TRUE (`a medical condition, including a terminal or chronic illness`) (`informally`) (`a public service care agency`))

-- s 5(2)(a)-(c) (scenarios 10-13)
#ASSERT NOT (`I am a carer under the Act` (`case of` TRUE (`a disability`) (`under a contract of service or for services`) (`another body`)))
#ASSERT NOT (`I am a carer under the Act` (`case of` TRUE (`a mental illness`) (`under a contract of service or for services`) (`a public service care agency`)))
#ASSERT NOT (`I am a carer under the Act` (`case of` TRUE (`a disability`) (`voluntary work for a charitable, welfare or community organisation`) (`another body`)))
#ASSERT NOT (`I am a carer under the Act` (`case of` TRUE (`being frail and aged`) (`as part of a course of education or training`) (`another body`)))

-- s 7 only: another public service agency (scenario 15)
#ASSERT `the body must make its staff aware of the Statement for` (`case of` TRUE (`a disability`) (`informally`) (`another public service agency`))
#ASSERT NOT (`the body must reflect the Statement in care supports for` (`case of` TRUE (`a disability`) (`informally`) (`another public service agency`)))
#ASSERT NOT (`the body must consult carers for` (`case of` TRUE (`a disability`) (`informally`) (`another public service agency`)))

-- ss 7, 8: public service care agency (scenario 16)
#ASSERT `the body must make its staff aware of the Statement for` (`case of` TRUE (`a disability`) (`informally`) (`a public service care agency`))
#ASSERT `the body must reflect the Statement in care supports for` (`case of` TRUE (`a disability`) (`informally`) (`a public service care agency`))
#ASSERT `the body must consult carers for` (`case of` TRUE (`a disability`) (`informally`) (`a public service care agency`))

-- s 9: associated provider (scenarios 19-20)
#ASSERT `the body must make its staff aware of the Statement for` (`case of` TRUE (`a mental illness`) (`informally`) (`an associated provider`))
#ASSERT `the body must reflect the Statement in care supports for` (`case of` TRUE (`a mental illness`) (`informally`) (`an associated provider`))
#ASSERT NOT (`the body must consult carers for` (`case of` TRUE (`a mental illness`) (`informally`) (`an associated provider`)))

-- another body, incl. a State under s 4(3) (scenarios 18, 21-23)
#ASSERT NOT (`the body must make its staff aware of the Statement for` (`case of` TRUE (`a disability`) (`informally`) (`another body`)))
#ASSERT NOT (`the body must reflect the Statement in care supports for` (`case of` TRUE (`a disability`) (`informally`) (`another body`)))
#ASSERT NOT (`the body must consult carers for` (`case of` TRUE (`a disability`) (`informally`) (`another body`)))

-- the agency's obligations do not depend on whether I am a carer: a paid
-- worker dealing with a care agency still sees ss 7-8 apply to that agency
#ASSERT `the body must consult carers for` (`case of` TRUE (`a disability`) (`under a contract of service or for services`) (`a public service care agency`))

-- s 10(1)-(2): never enforceable, never invalidates (scenarios 24-26)
#ASSERT NOT ((`the carer position for` (`case of` TRUE (`a disability`) (`informally`) (`a public service care agency`)))'s `I can enforce these obligations`)
#ASSERT NOT ((`the carer position for` (`case of` TRUE (`a disability`) (`informally`) (`a public service care agency`)))'s `non-compliance invalidates a decision`)
#ASSERT NOT ((`the carer position for` (`case of` TRUE (`a mental illness`) (`informally`) (`an associated provider`)))'s `I can enforce these obligations`)
#ASSERT NOT ((`the carer position for` (`case of` FALSE (`none of these`) (`as part of a course of education or training`) (`another body`)))'s `non-compliance invalidates a decision`)

-- top-level goal consistency: scenario 16 end to end
#ASSERT (`the carer position for` (`case of` TRUE (`a disability`) (`informally`) (`a public service care agency`)))'s `I am a carer`
#ASSERT (`the carer position for` (`case of` TRUE (`a disability`) (`informally`) (`a public service care agency`)))'s `the body must consult carers on care supports`
#ASSERT NOT ((`the carer position for` (`case of` TRUE (`a disability`) (`informally`) (`another public service agency`)))'s `the body must consult carers on care supports`)
#ASSERT NOT ((`the carer position for` (`case of` TRUE (`a disability`) (`voluntary work for a charitable, welfare or community organisation`) (`another body`)))'s `I am a carer`)
