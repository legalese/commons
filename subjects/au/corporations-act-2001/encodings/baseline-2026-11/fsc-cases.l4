IMPORT prelude
IMPORT `fsc-dates`
IMPORT `fsc-claimant`

-- Corporations Act 2001 (Cth) -- worked cases for the claimant's questions (fsc-claimant.l4) and the date helpers
-- (fsc-dates.l4). Every expected value was worked by hand from the deposited text, and every date by hand from the
-- calendar; none was copied from the encoding's output. Each assertion is a claim about the ENCODING on stated facts, not
-- about the law. The facts are illustrative.
-- BASELINE ENCODING. Not for public use as advice. See NOTES.md.

§ `cases`

`d` MEANS `the calendar date`
`any day` MEANS `d` 1 1 2000

§§ `the date helpers`

-- 1 January 1900 was a Monday; 2 March 2026 is a Monday (1 January 2026 a Thursday); 7 March 2026 a Saturday.
#ASSERT `the weekday number of` (`d` 1 1 1900) EQUALS 0
#ASSERT `the weekday number of` (`d` 2 3 2026) EQUALS 0
#ASSERT `the weekday number of` (`d` 7 3 2026) EQUALS 5
#ASSERT (`d` 8 3 2026) `falls on a weekend`
#ASSERT `the weekday` 5 `after` (`d` 2 3 2026) EQUALS `d` 9 3 2026
#ASSERT `the weekday` 5 `after` (`d` 7 3 2026) EQUALS `d` 13 3 2026
-- 6 years: the same date; from 29 February 2024, 28 February 2030; from 31 December 2025, 31 December 2031.
#ASSERT `the last day of 6 years after` (`d` 15 3 2020) EQUALS `d` 15 3 2026
#ASSERT `the last day of 6 years after` (`d` 29 2 2024) EQUALS `d` 28 2 2030
#ASSERT `the last day of 6 years after` (`d` 31 12 2025) EQUALS `d` 31 12 2031

§§ `Part 7.6 Division 6`

GIVEN a IS A NUMBER, b IS A NUMBER, c IS A BOOLEAN, e IS A NUMBER, f IS A BOOLEAN
GIVETH A `Licensee responsibility`
`relied` a b c e f MEANS `Is the licensee responsible to me for its representative` TRUE TRUE TRUE a b c e f

-- Not relied on in good faith: outside s 917A(1).
#ASSERT `Is the licensee responsible to me for its representative` TRUE TRUE FALSE 1 1 FALSE 1 FALSE EQUALS `Division 6 does not reach this conduct`
-- One licensee: responsible within authority or not (s 917B).
#ASSERT `relied` 1 1 FALSE 1 FALSE EQUALS `the licensee is responsible (s 917B)`
#ASSERT `relied` 1 1 FALSE 0 FALSE EQUALS `the licensee is responsible (s 917B)`
-- Outside authority and disclosed first: s 917D.
#ASSERT `relied` 1 1 FALSE 0 TRUE EQUALS `no licensee is responsible: the lack of authority was disclosed to me (s 917D)`
#ASSERT `relied` 3 2 TRUE 0 TRUE EQUALS `no licensee is responsible: the lack of authority was disclosed to me (s 917D)`
-- Disclosure is no answer where the conduct was within authority for a licensee.
#ASSERT `relied` 1 1 FALSE 1 TRUE EQUALS `the licensee is responsible (s 917B)`
-- Three licensees, only one for this class: s 917C(2).
#ASSERT `relied` 3 1 FALSE 0 FALSE EQUALS `the one licensee authorised for that class of service is responsible (s 917C(2))`
-- Two for the class, prescribed kind, within authority for one: (3)(d); for two: (3)(e).
#ASSERT `relied` 3 2 TRUE 1 FALSE EQUALS `the authorising licensee is responsible (s 917C(3)(d))`
#ASSERT `relied` 3 2 TRUE 2 FALSE EQUALS `the authorising licensees are jointly and severally responsible (s 917C(3)(e))`
-- Not a prescribed kind: s 917C(4), all of them.
#ASSERT `relied` 3 2 FALSE 1 FALSE EQUALS `all the licensees are jointly and severally responsible (s 917C(4))`
-- Prescribed kind but within authority for none (and not disclosed): s 917C(4).
#ASSERT `relied` 2 2 TRUE 0 FALSE EQUALS `all the licensees are jointly and severally responsible (s 917C(4))`

§§ `Part 7.7A Division 2`

`GI` MEANS `a general insurance product`
`BB` MEANS `a basic banking product`
`BBGI` MEANS `basic banking and general insurance products`
`CCI` MEANS `consumer credit insurance`
`other` MEANS `another financial product or subject`

-- s 961B
#ASSERT `Did my adviser meet the best interests duty` FALSE TRUE `other` FALSE TRUE TRUE EQUALS `Division 2 does not apply to this advice`
#ASSERT `Did my adviser meet the best interests duty` TRUE FALSE `other` FALSE TRUE TRUE EQUALS `Division 2 does not apply to this advice`
#ASSERT `Did my adviser meet the best interests duty` TRUE TRUE `other` FALSE TRUE TRUE EQUALS `the duty is satisfied: the adviser proves every s 961B(2) step`
#ASSERT `Did my adviser meet the best interests duty` TRUE TRUE `other` FALSE TRUE FALSE EQUALS `not shown to be satisfied: whether the adviser acted in my best interests is for the court under s 961B(1)`
#ASSERT `Did my adviser meet the best interests duty` TRUE TRUE `GI` FALSE TRUE FALSE EQUALS `the duty is satisfied: the adviser proves the s 961B(2)(a) to (c) steps, which suffice for this advice`
#ASSERT `Did my adviser meet the best interests duty` TRUE TRUE `BB` TRUE TRUE FALSE EQUALS `the duty is satisfied: the adviser proves the s 961B(2)(a) to (c) steps, which suffice for this advice`
#ASSERT `Did my adviser meet the best interests duty` TRUE TRUE `BBGI` TRUE TRUE FALSE EQUALS `the duty is satisfied: the adviser proves the s 961B(2)(a) to (c) steps, which suffice for this advice`
-- Basic banking advice by an adviser not acting for an ADI: s 961B(3) does not reach it.
#ASSERT `Did my adviser meet the best interests duty` TRUE TRUE `BB` FALSE TRUE FALSE EQUALS `not shown to be satisfied: whether the adviser acted in my best interests is for the court under s 961B(1)`
-- Consumer credit insurance by an ADI's adviser: (3) names it in the subject but gives the shortcut only for basic
-- banking and general insurance advice (finding 2).
#ASSERT `Did my adviser meet the best interests duty` TRUE TRUE `CCI` TRUE TRUE FALSE EQUALS `not shown to be satisfied: whether the adviser acted in my best interests is for the court under s 961B(1)`
#ASSERT `Did my adviser meet the best interests duty` TRUE TRUE `GI` FALSE FALSE TRUE EQUALS `not shown to be satisfied: whether the adviser acted in my best interests is for the court under s 961B(1)`

-- s 961G
#ASSERT `Did my adviser breach s 961G` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Did my adviser breach s 961G` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Did my adviser breach s 961G` FALSE TRUE FALSE EQUALS NOTHING

-- s 961H
#ASSERT `Did my adviser breach s 961H` TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Did my adviser breach s 961H` TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Did my adviser breach s 961H` TRUE TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Did my adviser breach s 961H` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Did my adviser breach s 961H` TRUE FALSE TRUE FALSE FALSE EQUALS NOTHING

-- s 961J
#ASSERT `Did my adviser breach s 961J` TRUE TRUE `GI` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Did my adviser breach s 961J` TRUE TRUE `BB` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Did my adviser breach s 961J` TRUE TRUE `BBGI` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Did my adviser breach s 961J` TRUE TRUE `BB` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Did my adviser breach s 961J` TRUE TRUE `CCI` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Did my adviser breach s 961J` TRUE TRUE `other` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Did my adviser breach s 961J` TRUE TRUE `other` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Did my adviser breach s 961J` TRUE TRUE `other` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Did my adviser breach s 961J` FALSE TRUE `other` FALSE TRUE FALSE EQUALS NOTHING

-- s 961M with s 961P
#ASSERT `Which licensee can be ordered to compensate me under s 961M` TRUE FALSE FALSE 1 1 FALSE 1 EQUALS `no order under s 961M on these facts`
#ASSERT `Which licensee can be ordered to compensate me under s 961M` FALSE TRUE FALSE 1 1 FALSE 1 EQUALS `no order under s 961M on these facts`
#ASSERT `Which licensee can be ordered to compensate me under s 961M` TRUE TRUE TRUE 0 0 FALSE 0 EQUALS `the licensee that gave the advice (s 961M(2)(a))`
#ASSERT `Which licensee can be ordered to compensate me under s 961M` TRUE TRUE FALSE 1 1 FALSE 0 EQUALS `the one licensee the adviser represents (s 961P(a))`
#ASSERT `Which licensee can be ordered to compensate me under s 961M` TRUE TRUE FALSE 2 1 FALSE 0 EQUALS `the licensee responsible under the s 917C rules (s 961P(b)(i))`
#ASSERT `Which licensee can be ordered to compensate me under s 961M` TRUE TRUE FALSE 3 3 TRUE 1 EQUALS `the licensee responsible under the s 917C rules (s 961P(b)(i))`
#ASSERT `Which licensee can be ordered to compensate me under s 961M` TRUE TRUE FALSE 3 3 TRUE 2 EQUALS `each licensee jointly and severally responsible under the s 917C rules (s 961P(b)(ii))`
#ASSERT `Which licensee can be ordered to compensate me under s 961M` TRUE TRUE FALSE 2 2 FALSE 1 EQUALS `each licensee jointly and severally responsible under the s 917C rules (s 961P(b)(ii))`

-- s 961M(6)
#ASSERT `By when must I sue under s 961M` (`d` 15 3 2020) EQUALS `d` 15 3 2026
#ASSERT `By when must I sue under s 961M` (`d` 29 2 2024) EQUALS `d` 28 2 2030

§§ `Part 7.9 Division 5 -- cooling-off`

-- Issued Monday 2 March 2026, no confirmation, no holidays: the fifth business day is Monday 9 March; the 14 days end on
-- 23 March 2026.
#ASSERT `What is the last day of my cooling-off period` (`d` 2 3 2026) FALSE `any day` 0 EQUALS `d` 23 3 2026
-- Confirmation on Wednesday 4 March, earlier than 9 March: the 14 days end on 18 March.
#ASSERT `What is the last day of my cooling-off period` (`d` 2 3 2026) TRUE (`d` 4 3 2026) 0 EQUALS `d` 18 3 2026
-- Confirmation on 12 March, later than the fifth business day: the 9 March start stands.
#ASSERT `What is the last day of my cooling-off period` (`d` 2 3 2026) TRUE (`d` 12 3 2026) 0 EQUALS `d` 23 3 2026
-- Issued Wednesday 1 April 2026, Good Friday (3 April) and Easter Monday (6 April) counted: business days 2, 7, 8, 9, 10
-- April; the 14 days end on 24 April.
#ASSERT `What is the last day of my cooling-off period` (`d` 1 4 2026) FALSE `any day` 2 EQUALS `d` 24 4 2026
-- Issued on Saturday 7 March 2026: business days 9 to 13 March; the 14 days end on 27 March.
#ASSERT `What is the last day of my cooling-off period` (`d` 7 3 2026) FALSE `any day` 0 EQUALS `d` 27 3 2026

`insurance` MEANS `a risk insurance product`
`issued` MEANS `it was issued to me`

#ASSERT `Can I return the product under the cooling-off period` `insurance` TRUE TRUE `issued` FALSE (`d` 2 3 2026) FALSE `any day` 0 FALSE FALSE (`d` 23 3 2026) TRUE EQUALS JUST TRUE
#ASSERT `Can I return the product under the cooling-off period` `insurance` TRUE TRUE `issued` FALSE (`d` 2 3 2026) FALSE `any day` 0 FALSE FALSE (`d` 24 3 2026) TRUE EQUALS JUST FALSE
#ASSERT `Can I return the product under the cooling-off period` `a superannuation product` TRUE TRUE `it was sold to me under an offer that s 1012C applies to` FALSE (`d` 2 3 2026) TRUE (`d` 4 3 2026) 0 FALSE FALSE (`d` 18 3 2026) TRUE EQUALS JUST TRUE
#ASSERT `Can I return the product under the cooling-off period` `a superannuation product` TRUE TRUE `issued` FALSE (`d` 2 3 2026) TRUE (`d` 4 3 2026) 0 FALSE FALSE (`d` 19 3 2026) TRUE EQUALS JUST FALSE
-- A claim made on the insurance ends the right (s 1019B(5)(a) and its Note).
#ASSERT `Can I return the product under the cooling-off period` `insurance` TRUE TRUE `issued` FALSE (`d` 2 3 2026) FALSE `any day` 0 TRUE FALSE (`d` 5 3 2026) TRUE EQUALS JUST FALSE
#ASSERT `Can I return the product under the cooling-off period` `insurance` TRUE TRUE `issued` FALSE (`d` 2 3 2026) FALSE `any day` 0 FALSE TRUE (`d` 5 3 2026) TRUE EQUALS JUST FALSE
#ASSERT `Can I return the product under the cooling-off period` `another kind of financial product` TRUE TRUE `issued` FALSE (`d` 2 3 2026) FALSE `any day` 0 FALSE FALSE (`d` 5 3 2026) TRUE EQUALS JUST FALSE
#ASSERT `Can I return the product under the cooling-off period` `a managed investment product` FALSE TRUE `issued` FALSE (`d` 2 3 2026) FALSE `any day` 0 FALSE FALSE (`d` 5 3 2026) TRUE EQUALS JUST FALSE
-- Not provided in this jurisdiction: s 1019A(1)(a).
#ASSERT `Can I return the product under the cooling-off period` `a managed investment product` TRUE FALSE `issued` FALSE (`d` 2 3 2026) FALSE `any day` 0 FALSE FALSE (`d` 5 3 2026) TRUE EQUALS JUST FALSE
#ASSERT `Can I return the product under the cooling-off period` `a managed investment product` TRUE TRUE `some other way` FALSE (`d` 2 3 2026) FALSE `any day` 0 FALSE FALSE (`d` 5 3 2026) TRUE EQUALS JUST FALSE
#ASSERT `Can I return the product under the cooling-off period` `an RSA` TRUE TRUE `issued` TRUE (`d` 2 3 2026) FALSE `any day` 0 FALSE FALSE (`d` 5 3 2026) TRUE EQUALS JUST FALSE
#ASSERT `Can I return the product under the cooling-off period` `an RSA` TRUE TRUE `issued` FALSE (`d` 2 3 2026) FALSE `any day` 0 FALSE FALSE (`d` 5 3 2026) FALSE EQUALS JUST FALSE

§§ `ss 1041H and 1041I`

#ASSERT `Can I recover my loss for misleading or deceptive conduct` TRUE TRUE TRUE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Can I recover my loss for misleading or deceptive conduct` TRUE TRUE FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Can I recover my loss for misleading or deceptive conduct` TRUE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Can I recover my loss for misleading or deceptive conduct` FALSE TRUE TRUE FALSE FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `Can I recover my loss for misleading or deceptive conduct` TRUE FALSE TRUE FALSE FALSE FALSE TRUE EQUALS NOTHING
-- A misleading PDS or FSG is dealt with under its own provisions (s 1041H(3)).
#ASSERT `Can I recover my loss for misleading or deceptive conduct` TRUE TRUE TRUE TRUE FALSE FALSE TRUE EQUALS JUST FALSE
-- A listed company's silence without knowledge, recklessness or negligence is not misleading conduct (s 1041H(4)).
#ASSERT `Can I recover my loss for misleading or deceptive conduct` TRUE TRUE TRUE FALSE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Can I recover my loss for misleading or deceptive conduct` TRUE TRUE TRUE FALSE TRUE TRUE TRUE EQUALS JUST TRUE

-- s 1041I(1B): $100,000 loss, a 25% share: $75,000.
#ASSERT `How much can I recover after my share of responsibility` 100000 TRUE TRUE FALSE 25 EQUALS 75000
#ASSERT `How much can I recover after my share of responsibility` 100000 TRUE TRUE TRUE 25 EQUALS 100000
#ASSERT `How much can I recover after my share of responsibility` 100000 TRUE FALSE FALSE 25 EQUALS 100000
#ASSERT `How much can I recover after my share of responsibility` 100000 FALSE TRUE FALSE 25 EQUALS 100000
#ASSERT `How much can I recover after my share of responsibility` 100000 TRUE TRUE FALSE 0 EQUALS 100000
#ASSERT `How much can I recover after my share of responsibility` 100000 TRUE TRUE FALSE 100 EQUALS 0
#ASSERT `How much can I recover after my share of responsibility` 80000 TRUE TRUE FALSE 12.5 EQUALS 70000

-- s 1041I(2)
#ASSERT `By when must I sue under s 1041I` (`d` 1 7 2021) EQUALS `d` 1 7 2027
#ASSERT `By when must I sue under s 1041I` (`d` 29 2 2028) EQUALS `d` 28 2 2034

§§ `ss 674A, 1043L, 1317HA and 1317K`

`entity` MEANS `the listed entity`
`officer` MEANS `a person involved in the entity's failure, such as a director or officer`

#ASSERT `Can I seek compensation for a failure to disclose` `entity` TRUE TRUE FALSE TRUE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Can I seek compensation for a failure to disclose` `entity` TRUE TRUE TRUE TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
-- No knowledge, recklessness or negligence: s 674(2) may be broken, but it is not a financial services civil penalty
-- provision, so s 1317HA gives no compensation (finding 6).
#ASSERT `Can I seek compensation for a failure to disclose` `entity` TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Can I seek compensation for a failure to disclose` `entity` TRUE TRUE FALSE TRUE TRUE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Can I seek compensation for a failure to disclose` `entity` TRUE TRUE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Can I seek compensation for a failure to disclose` `entity` TRUE FALSE FALSE TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Can I seek compensation for a failure to disclose` `entity` FALSE TRUE FALSE TRUE FALSE FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `Can I seek compensation for a failure to disclose` `officer` TRUE TRUE FALSE TRUE FALSE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Can I seek compensation for a failure to disclose` `officer` TRUE TRUE FALSE TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Can I seek compensation for a failure to disclose` `officer` TRUE TRUE FALSE TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE

-- s 1317K
#ASSERT `By when must I seek a compensation order` (`d` 20 8 2024) EQUALS `d` 20 8 2030

-- s 1317HA for the other financial services civil penalty provisions of the s 1317E(3) table.
`PDS` MEANS `giving a Product Disclosure Statement (ss 1012A(5), 1012B(6), 1012C(11))`
`DDO` MEANS `target market determinations, distribution and stop orders (ss 994B(2), (9), 994C(2), (4), (5), (7), 994D, 994E(1), (3), 994F(1), (3) to (6), (8), 994G, 994H(3), 994J(7), (8))`
`other provision` MEANS `another provision, such as a best interests duty (ss 961K, 961L, 961Q), s 674(2) or s 1041H`
#ASSERT `Can I seek a compensation order for a financial services contravention` `PDS` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Can I seek a compensation order for a financial services contravention` `DDO` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Can I seek a compensation order for a financial services contravention` `insider trading (s 1043A(1), (2))` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Can I seek a compensation order for a financial services contravention` `market manipulation, false trading, market rigging and spreading information about illegal transactions (ss 1041A, 1041B(1), 1041C(1), 1041D)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Can I seek a compensation order for a financial services contravention` `DDO` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Can I seek a compensation order for a financial services contravention` `PDS` FALSE TRUE EQUALS JUST FALSE
-- A best interests duty, s 674(2) or s 1041H is not a financial services civil penalty provision (findings 1 and 6).
#ASSERT `Can I seek a compensation order for a financial services contravention` `other provision` TRUE TRUE EQUALS JUST FALSE

-- s 1043L(3): I sold at $2.00 to an insider; the likely price had the news been out was $2.60: $0.60 a share.
`sold` MEANS `I sold the products to the insider, or to the person the insider procured`
`bought` MEANS `I bought the products from the insider, or from the person the insider procured`
#ASSERT `How much can I recover from an insider under s 1043L` `sold` TRUE FALSE FALSE 2.00 2.60 EQUALS 0.60
-- s 1043L(4): I bought at $5.00 from an insider; the likely price was $3.50: $1.50.
#ASSERT `How much can I recover from an insider under s 1043L` `bought` TRUE FALSE FALSE 5.00 3.50 EQUALS 1.50
-- The price moved the other way: no amount ("the amount (if any)").
#ASSERT `How much can I recover from an insider under s 1043L` `sold` TRUE FALSE FALSE 2.60 2.00 EQUALS 0
#ASSERT `How much can I recover from an insider under s 1043L` `bought` TRUE FALSE FALSE 3.50 5.00 EQUALS 0
-- No contravention of s 1043A(1), derivatives, or I had the information myself: s 1043L gives nothing.
#ASSERT `How much can I recover from an insider under s 1043L` `sold` FALSE FALSE FALSE 2.00 2.60 EQUALS 0
#ASSERT `How much can I recover from an insider under s 1043L` `sold` TRUE TRUE FALSE 2.00 2.60 EQUALS 0
#ASSERT `How much can I recover from an insider under s 1043L` `bought` TRUE FALSE TRUE 5.00 3.50 EQUALS 0

§§ `Part 7.10A -- AFCA`

#ASSERT `Is my complaint a superannuation complaint` `a fund trustee's decision about a member or beneficiary` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Is my complaint a superannuation complaint` `a fund trustee's decision about a member or beneficiary` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Is my complaint a superannuation complaint` `a fund trustee's decision about a member or beneficiary` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Is my complaint a superannuation complaint` `a fund trustee's decision about a member or beneficiary` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Is my complaint a superannuation complaint` `a death benefit decision` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Is my complaint a superannuation complaint` `an insurer's conduct in selling an annuity policy` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Is my complaint a superannuation complaint` `an insurer's conduct in selling an annuity policy` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Is my complaint a superannuation complaint` `an RSA provider's decision about an RSA holder` FALSE TRUE FALSE EQUALS JUST FALSE
-- s 1053(4) cannot reach an RSA complaint: the self managed fund answer is not used for (f) to (i).
#ASSERT `Is my complaint a superannuation complaint` `an RSA provider's decision about an RSA holder` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Is my complaint a superannuation complaint` `an insurer's decision on insurance paid for from an RSA` FALSE TRUE TRUE EQUALS JUST TRUE
-- A death benefit decision by a self managed fund's trustee is a decision s 1053(4)(a) reaches.
#ASSERT `Is my complaint a superannuation complaint` `a death benefit decision` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Is my complaint a superannuation complaint` `something else` TRUE TRUE FALSE EQUALS JUST FALSE

#ASSERT `Am I bound by AFCA's determination` `the complainant` EQUALS JUST FALSE
-- A person joined to a superannuation complaint: s 1051(4)(e) is silent.
#ASSERT `Am I bound by AFCA's determination` `a person joined as a party to a superannuation complaint, not the complainant` EQUALS NOTHING

#ASSERT `What must AFCA do with my superannuation complaint` `fair and reasonable in all the circumstances` EQUALS `AFCA must affirm the decision or conduct (s 1055(2), (3))`
#ASSERT `What must AFCA do with my superannuation complaint` `unfair or unreasonable, or both` EQUALS `AFCA may vary the decision, set it aside and substitute or remit it, or give the s 1055(6) remedies, only to remove the unfairness, and never contrary to law, the fund's rules or the policy terms (s 1055(4) to (7))`
#ASSERT `What must AFCA do with my superannuation complaint` `AFCA has not yet decided` EQUALS `nothing is decided until AFCA forms its view`

§§§ `death benefits`

-- Notice of the proposed decision on 1 February 2026: object by 1 March 2026. Notice of the decision on 10 March 2026:
-- complain by 7 April 2026.
#ASSERT `By when must I object to the proposed death benefit decision` (`d` 1 2 2026) EQUALS `d` 1 3 2026
#ASSERT `By when must I complain to AFCA about the death benefit decision` (`d` 10 3 2026) EQUALS `d` 7 4 2026

`told of proposal` MEANS `d` 1 2 2026
`told of decision` MEANS `d` 10 3 2026

#ASSERT `Can I complain to AFCA about the death benefit decision` FALSE TRUE `told of proposal` FALSE `any day` TRUE `told of decision` (`d` 1 4 2026) FALSE EQUALS JUST FALSE
-- Did not object; complains on the last day, and the day after.
#ASSERT `Can I complain to AFCA about the death benefit decision` TRUE TRUE `told of proposal` FALSE `any day` TRUE `told of decision` (`d` 7 4 2026) FALSE EQUALS JUST TRUE
#ASSERT `Can I complain to AFCA about the death benefit decision` TRUE TRUE `told of proposal` FALSE `any day` TRUE `told of decision` (`d` 8 4 2026) FALSE EQUALS JUST FALSE
-- Objected on the last day (1 March), complains late (30 April): s 1056(2) needs both failures (finding 4).
#ASSERT `Can I complain to AFCA about the death benefit decision` TRUE TRUE `told of proposal` TRUE (`d` 1 3 2026) TRUE `told of decision` (`d` 30 4 2026) FALSE EQUALS JUST TRUE
-- Objected a day late (2 March) and complained a day late (8 April): barred.
#ASSERT `Can I complain to AFCA about the death benefit decision` TRUE TRUE `told of proposal` TRUE (`d` 2 3 2026) TRUE `told of decision` (`d` 8 4 2026) FALSE EQUALS JUST FALSE
-- Neither notice given: only if AFCA is satisfied (s 1056(3)).
#ASSERT `Can I complain to AFCA about the death benefit decision` TRUE FALSE `any day` FALSE `any day` FALSE `any day` (`d` 1 9 2026) TRUE EQUALS JUST TRUE
#ASSERT `Can I complain to AFCA about the death benefit decision` TRUE FALSE `any day` FALSE `any day` FALSE `any day` (`d` 1 9 2026) FALSE EQUALS JUST FALSE
-- Only the decision notice given, complaint late: neither bar reaches the case (fork F6).
#ASSERT `Can I complain to AFCA about the death benefit decision` TRUE FALSE `any day` FALSE `any day` TRUE `told of decision` (`d` 1 9 2026) FALSE EQUALS JUST TRUE

-- s 1056A: AFCA notified the decision-maker on 2 March 2026; the 28 days end on 30 March 2026.
GIVEN a IS A BOOLEAN, b IS A DATE, c IS A DATE
GIVETH A `What became of the duty to tell me of the complaint`
`told` a b c MEANS `Was I told of the death benefit complaint in time` FALSE TRUE (`d` 2 3 2026) a b c
#ASSERT `told` TRUE (`d` 30 3 2026) (`d` 1 5 2026) EQUALS `told in time`
#ASSERT `told` TRUE (`d` 31 3 2026) (`d` 1 5 2026) EQUALS `not told in time`
#ASSERT `told` TRUE (`d` 2 3 2026) (`d` 1 5 2026) EQUALS `told in time`
#ASSERT `told` FALSE `any day` (`d` 30 3 2026) EQUALS `the time to tell me is still running`
#ASSERT `told` FALSE `any day` (`d` 31 3 2026) EQUALS `not told in time`
#ASSERT `Was I told of the death benefit complaint in time` TRUE TRUE (`d` 2 3 2026) FALSE `any day` (`d` 1 5 2026) EQUALS `the s 1056A duty does not reach me on these facts`
#ASSERT `Was I told of the death benefit complaint in time` FALSE FALSE (`d` 2 3 2026) FALSE `any day` (`d` 1 5 2026) EQUALS `the s 1056A duty does not reach me on these facts`

-- s 1056A(2)(c): told on 5 January 2026, apply by 2 February; with 14 more days allowed, by 16 February.
#ASSERT `By when must I apply to be joined` (`d` 5 1 2026) 0 EQUALS `d` 2 2 2026
#ASSERT `By when must I apply to be joined` (`d` 5 1 2026) 14 EQUALS `d` 16 2 2026

