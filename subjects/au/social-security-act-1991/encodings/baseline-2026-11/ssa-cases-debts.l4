IMPORT prelude
IMPORT `ssa-debts`

-- Social Security Act 1991 (Cth), Chapter 5 -- worked cases for ssa-debts.l4, from the seat of the person said to owe the debt.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Expected values were worked by hand from the
-- deposited text before running (the compounding interest and the present value with a calculator, independently of the
-- encoding). The base interest rates and the small debt amount are illustrative inputs, not figures in force.

§ `s 1223 -- does the payment make a debt`

-- A helper for the cases only: s 1223 with every special rule switched off, varying the reason and entitlement.
GIVEN r IS A NotEntitledReason, e IS A BOOLEAN
GIVETH A MAYBE BOOLEAN
`plain 1223` r e MEANS `Does section 1223 make my payment a debt` r e FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE

-- (1)(b) with (1AB)(c): the payment was not payable, so the person is taken not to have been entitled: a debt.
#ASSERT `plain 1223` `the payment was not payable` TRUE EQUALS JUST TRUE
-- (1AB)(a): a computer or administrative error is a reason in itself, even if otherwise entitled.
#ASSERT `plain 1223` `made by mistake as a result of a computer error or an administrative error` TRUE EQUALS JUST TRUE
-- No (1AB) reason, and entitled: the "if" of s 1223(1) fails, so no debt under s 1223.
#ASSERT `plain 1223` `none of these reasons` TRUE EQUALS JUST FALSE
-- No (1AB) reason, but not entitled for another reason (for example the rate rules gave less): a debt.
#ASSERT `plain 1223` `none of these reasons` FALSE EQUALS JUST TRUE
-- (1AA): benefit obtained afterwards from a payment made to the entitled person, no mistake by that person: s 1223(1) does not apply.
#ASSERT `Does section 1223 make my payment a debt` `the payment was not payable` FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- (1AA): the same, but obtained because of that person's mistake in the direction: a debt.
#ASSERT `Does section 1223 make my payment a debt` `the payment was not payable` FALSE FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- (1AF): a payment under s 47(2) or 51(2) of the Administration Act is not caught ...
#ASSERT `Does section 1223 make my payment a debt` `the payment was not payable` FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- (1AG): ... unless released after the expected release day.
#ASSERT `Does section 1223 make my payment a debt` `the payment was not payable` FALSE FALSE FALSE FALSE FALSE TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- (1B): carer payment overpaid because of the care receiver's underestimated income: not a debt ...
#ASSERT `Does section 1223 make my payment a debt` `the intended recipient was not qualified` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
-- (1C): ... unless it was reasonable for the carer to know.
#ASSERT `Does section 1223 make my payment a debt` `the intended recipient was not qualified` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE FALSE EQUALS JUST TRUE
-- (2): parenting payment paid only despite failing employment pathway plan requirements: not a debt.
#ASSERT `Does section 1223 make my payment a debt` `the intended recipient was not qualified` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
-- (1AD): an administrative-error payment under a determination in effect, caused by an unnotified change when no valid
-- notification requirement had been made, otherwise entitled: (1AC) does not apply, and the answer turns on the Administration Act.
#ASSERT `Does section 1223 make my payment a debt` `made by mistake as a result of a computer error or an administrative error` TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- The same with a valid notification requirement in place: (1AC) applies, so a debt.
#ASSERT `Does section 1223 make my payment a debt` `made by mistake as a result of a computer error or an administrative error` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE

§ `s 1224AB -- joint and several liability`

#ASSERT `Am I jointly liable for the other person's debt` TRUE TRUE EQUALS TRUE
#ASSERT `Am I jointly liable for the other person's debt` TRUE FALSE EQUALS FALSE

§ `s 1228B -- the 10% penalty`

-- Jobseeker payment is a social security benefit; 10% of $1,234.56 = $123.456, rounded down to 5 cents: $123.45.
#ASSERT `How much is my 10% penalty` `jobseeker payment` TRUE TRUE `refused or failed to provide the information` 1234.56 FALSE FALSE EQUALS 123.45
-- 10% of $1,000.49 = $100.049: $100.00.
#ASSERT `How much is my 10% penalty` `jobseeker payment` TRUE TRUE `refused or failed to provide the information` 1000.49 FALSE FALSE EQUALS 100
-- 10% of $333.33 = $33.333: $33.30.
#ASSERT `How much is my 10% penalty` `pension PP (single)` TRUE TRUE `refused or failed to provide the information` 333.33 FALSE FALSE EQUALS 33.3
-- Disability support pension, knowingly false information: 10% of $500 = $50.
#ASSERT `How much is my 10% penalty` `disability support pension` TRUE TRUE `knowingly or recklessly provided false or misleading information` 500 FALSE FALSE EQUALS 50
-- Youth allowance is a social security benefit: 10% of $10 = $1.
#ASSERT `How much is my 10% penalty` `youth allowance` TRUE TRUE `refused or failed to provide the information` 10 FALSE FALSE EQUALS 1
-- Age pension is not one of the payments in s 1228B(1)(b): no penalty.
#ASSERT `How much is my 10% penalty` `age pension` TRUE TRUE `refused or failed to provide the information` 1000 FALSE FALSE EQUALS 0
-- At or over pension age: no penalty.
#ASSERT `How much is my 10% penalty` `jobseeker payment` TRUE FALSE `refused or failed to provide the information` 1000 FALSE FALSE EQUALS 0
-- Under the minimum youth allowance age: no penalty.
#ASSERT `How much is my 10% penalty` `jobseeker payment` FALSE TRUE `refused or failed to provide the information` 1000 FALSE FALSE EQUALS 0
-- No failure about income from personal exertion: no penalty.
#ASSERT `How much is my 10% penalty` `jobseeker payment` TRUE TRUE `no such failure` 1000 FALSE FALSE EQUALS 0
-- s 1228B(4): the Secretary satisfied of a reasonable excuse: no penalty.
#ASSERT `How much is my 10% penalty` `jobseeker payment` TRUE TRUE `refused or failed to provide the information` 1000 TRUE FALSE EQUALS 0
-- s 1228B(5): a debt of interest charge under s 1229C attracts no penalty.
#ASSERT `How much is my 10% penalty` `jobseeker payment` TRUE TRUE `refused or failed to provide the information` 1000 FALSE TRUE EQUALS 0

§ `s 1229 -- notice and due day`

#ASSERT `Must I be given a debt notice` FALSE FALSE EQUALS TRUE
#ASSERT `Must I be given a debt notice` TRUE FALSE EQUALS FALSE
#ASSERT `Must I be given a debt notice` FALSE TRUE EQUALS FALSE
-- The 28th day after 3 March 2026 is 31 March 2026.
#ASSERT `By when must I pay my debt` (Date 3 3 2026) EQUALS Date 31 3 2026
-- Across a year end: the 28th day after 15 December 2026 is 12 January 2027.
#ASSERT `By when must I pay my debt` (Date 15 12 2026) EQUALS Date 12 1 2027

§ `ss 1229A-1229F -- interest charge`

-- Paid on the due day (31 March 2026): in time, no interest charge.
#ASSERT `Am I liable to interest charge on my unpaid debt` (Date 3 3 2026) TRUE (Date 31 3 2026) FALSE `none of these` FALSE FALSE EQUALS FALSE
-- Paid the day after the due day: liable.
#ASSERT `Am I liable to interest charge on my unpaid debt` (Date 3 3 2026) TRUE (Date 1 4 2026) FALSE `none of these` FALSE FALSE EQUALS TRUE
-- Not paid at all: liable.
#ASSERT `Am I liable to interest charge on my unpaid debt` (Date 3 3 2026) FALSE (Date 1 1 2026) FALSE `none of these` FALSE FALSE EQUALS TRUE
-- Not paid, but an arrangement under s 1234 in effect at the end of the due day: s 1229A(1)(c) fails.
#ASSERT `Am I liable to interest charge on my unpaid debt` (Date 3 3 2026) FALSE (Date 1 1 2026) TRUE `none of these` FALSE FALSE EQUALS FALSE
-- Not paid, but receiving a social security payment on the due day: exempt under s 1229E(1)(a).
#ASSERT `Am I liable to interest charge on my unpaid debt` (Date 3 3 2026) FALSE (Date 1 1 2026) FALSE `a social security payment` FALSE FALSE EQUALS FALSE
-- Not paid, receiving family tax benefit instalments: exempt under s 1229E(1)(c).
#ASSERT `Am I liable to interest charge on my unpaid debt` (Date 3 3 2026) FALSE (Date 1 1 2026) FALSE `instalments of family tax benefit` FALSE FALSE EQUALS FALSE
-- Not paid, a Secretary's determination under s 1229F: not payable.
#ASSERT `Am I liable to interest charge on my unpaid debt` (Date 3 3 2026) FALSE (Date 1 1 2026) FALSE `none of these` FALSE TRUE EQUALS FALSE
-- Arrangement payment due 10 April 2026, made that day: in time (s 1234(1A)).
#ASSERT `Am I liable to interest charge for a missed arrangement payment` (Date 10 4 2026) TRUE (Date 10 4 2026) `none of these` FALSE FALSE EQUALS FALSE
-- Made the next day: liable under s 1229B.
#ASSERT `Am I liable to interest charge for a missed arrangement payment` (Date 10 4 2026) TRUE (Date 11 4 2026) `none of these` FALSE FALSE EQUALS TRUE
-- Not made, but receiving instalments of family tax benefit: exempt.
#ASSERT `Am I liable to interest charge for a missed arrangement payment` (Date 10 4 2026) FALSE (Date 1 1 2026) `instalments of family tax benefit` FALSE FALSE EQUALS FALSE
-- s 1229B(4): terminated 20 June 2026; due on the 14th day after, 4 July 2026.
#ASSERT `By when must I pay after my arrangement ends` (Date 20 6 2026) EQUALS Date 4 7 2026
-- s 1229D(2) table: each quarter's month.
#ASSERT `Which month sets my base interest rate` (Date 15 2 2026) EQUALS "November 2025"
#ASSERT `Which month sets my base interest rate` (Date 1 4 2026) EQUALS "February 2026"
#ASSERT `Which month sets my base interest rate` (Date 30 9 2026) EQUALS "May 2026"
#ASSERT `Which month sets my base interest rate` (Date 31 12 2026) EQUALS "August 2026"
-- s 1229D(1): 3.60 + 7 = 10.60, divided by 365 days in 2026.
#ASSERT `What is the daily interest charge rate` 3.6 (Date 1 4 2026) EQUALS 10.6 / 365
-- 2028 is a leap year: divided by 366.
#ASSERT `What is the daily interest charge rate` 3.6 (Date 1 4 2028) EQUALS 10.6 / 366
-- s 1229D(4): 3.605 rounds up to 3.61; 3.6049 rounds to 3.60.
#ASSERT `What is the daily interest charge rate` 3.605 (Date 1 4 2026) EQUALS 10.61 / 365
#ASSERT `What is the daily interest charge rate` 3.6049 (Date 1 4 2026) EQUALS 10.6 / 365
-- s 1229A(3): $10,000 unpaid, 10.60% / 365 a day: one day = $2.9041..., $2.90.
#ASSERT `How much interest charge accrues` 10000 3.6 (Date 1 4 2026) 1 EQUALS 2.9
-- 30 days, compounding daily: 10000 x ((1 + 0.106/365)^30 - 1) = $87.4912 -> $87.49.
#ASSERT `How much interest charge accrues` 10000 3.6 (Date 1 4 2026) 30 EQUALS 87.49
-- 91 days (a whole April-June quarter): $267.7576 -> $267.76.
#ASSERT `How much interest charge accrues` 10000 3.6 (Date 1 4 2026) 91 EQUALS 267.76
-- $2,500 for 10 days in 2028 at 3.605 (rounded 3.61) + 7 = 10.61% / 366: $7.2567 -> $7.26.
#ASSERT `How much interest charge accrues` 2500 3.605 (Date 1 4 2028) 10 EQUALS 7.26
-- No days: nothing.
#ASSERT `How much interest charge accrues` 10000 3.6 (Date 1 4 2026) 0 EQUALS 0

§ `Part 5.3 -- recovery`

-- s 1230C(2): deductions or an arrangement first sought, and an arrangement refused: court action or garnishee open.
#ASSERT `Can my debt be recovered by court action or garnishee notice` TRUE FALSE TRUE FALSE EQUALS TRUE
-- Nothing sought first, and no s 1230C(3) determination: closed.
#ASSERT `Can my debt be recovered by court action or garnishee notice` FALSE FALSE TRUE TRUE EQUALS FALSE
-- s 1230C(3): the Secretary determined deductions and arrangements not appropriate; a missed payment established: open.
#ASSERT `Can my debt be recovered by court action or garnishee notice` FALSE TRUE FALSE TRUE EQUALS TRUE
-- Sought first, but no failure to enter or keep a reasonable arrangement can be established: closed.
#ASSERT `Can my debt be recovered by court action or garnishee notice` TRUE FALSE FALSE FALSE EQUALS FALSE
-- s 1231(2).
#ASSERT `Must my debt be deducted from my payment` TRUE FALSE FALSE EQUALS TRUE
#ASSERT `Must my debt be deducted from my payment` TRUE TRUE FALSE EQUALS FALSE
#ASSERT `Must my debt be deducted from my payment` FALSE FALSE FALSE EQUALS FALSE
-- s 1231(1A), (1AA), (1B): reduction to nil.
#ASSERT `Can my payment be reduced to nil` `a student start-up loan` TRUE TRUE TRUE FALSE EQUALS FALSE
#ASSERT `Can my payment be reduced to nil` `pension bonus` FALSE FALSE FALSE FALSE EQUALS TRUE
#ASSERT `Can my payment be reduced to nil` `arrears of social security payments` FALSE FALSE FALSE TRUE EQUALS FALSE
#ASSERT `Can my payment be reduced to nil` `an economic security strategy payment, essential medical equipment payment or training and learning bonus` TRUE FALSE FALSE FALSE EQUALS FALSE
#ASSERT `Can my payment be reduced to nil` `an economic security strategy payment, essential medical equipment payment or training and learning bonus` TRUE FALSE TRUE FALSE EQUALS TRUE
#ASSERT `Can my payment be reduced to nil` `another social security payment` TRUE FALSE FALSE FALSE EQUALS TRUE
#ASSERT `Can my payment be reduced to nil` `another social security payment` FALSE TRUE FALSE FALSE EQUALS TRUE
#ASSERT `Can my payment be reduced to nil` `another social security payment` FALSE FALSE FALSE FALSE EQUALS FALSE
#ASSERT `Can my payment be reduced to nil` `another social security payment` TRUE FALSE FALSE TRUE EQUALS FALSE
-- s 1233(2): notice given 1 May 2026, so not before 15 May 2026; money due 5 May -> 15 May; due 20 May -> 20 May; due 15 May -> 15 May.
#ASSERT `When can a garnishee notice first take my money` (Date 1 5 2026) (Date 5 5 2026) EQUALS Date 15 5 2026
#ASSERT `When can a garnishee notice first take my money` (Date 1 5 2026) (Date 20 5 2026) EQUALS Date 20 5 2026
#ASSERT `When can a garnishee notice first take my money` (Date 1 5 2026) (Date 15 5 2026) EQUALS Date 15 5 2026
-- s 1233(1)(e): a single specified amount is capped at the lesser of the debt and the money due or held.
#ASSERT `What is the most a garnishee notice can take` 5000 3000 EQUALS 3000
#ASSERT `What is the most a garnishee notice can take` 2000 3000 EQUALS 2000
#ASSERT `What is the most a garnishee notice can take` 3000 3000 EQUALS 3000
-- s 1234(4): at my request; after 28 days' notice (notice 1 May 2026, so from 29 May); without notice for non-disclosure.
#ASSERT `Can my arrangement be ended or changed` (Date 2 5 2026) TRUE FALSE (Date 1 1 2026) FALSE EQUALS JUST TRUE
#ASSERT `Can my arrangement be ended or changed` (Date 29 5 2026) FALSE TRUE (Date 1 5 2026) FALSE EQUALS JUST TRUE
#ASSERT `Can my arrangement be ended or changed` (Date 28 5 2026) FALSE TRUE (Date 1 5 2026) FALSE EQUALS NOTHING
#ASSERT `Can my arrangement be ended or changed` (Date 2 5 2026) FALSE FALSE (Date 1 1 2026) TRUE EQUALS JUST TRUE
#ASSERT `Can my arrangement be ended or changed` (Date 2 5 2026) FALSE FALSE (Date 1 1 2026) FALSE EQUALS NOTHING
-- s 1234B: a 20-year-old debt is not out of time.
#ASSERT `Is there a time limit on recovering my debt` 20 EQUALS FALSE

§ `Part 5.4 -- write-off and waiver`

-- s 1236(1B)(b): no proof capable of sustaining legal proceedings.
#ASSERT `Can my debt be written off` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS TRUE
-- s 1236(1B)(c): discharged bankrupt, debt before bankruptcy, not fraud.
#ASSERT `Can my debt be written off` FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS TRUE
-- The same, incurred by fraud: not irrecoverable at law.
#ASSERT `Can my debt be written off` FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS FALSE
-- s 1236(1C): recoverable by deductions, which would cause severe financial hardship: the deeming is lifted, but I say I have
-- capacity otherwise (for example savings), so no write-off ground.
#ASSERT `Can my debt be written off` FALSE FALSE FALSE FALSE TRUE TRUE FALSE FALSE EQUALS FALSE
-- The same with no capacity otherwise: (1A)(b) is met.
#ASSERT `Can my debt be written off` FALSE FALSE FALSE FALSE TRUE TRUE TRUE FALSE EQUALS TRUE
-- Recoverable by deductions without severe hardship: taken to have capacity, even if I say I have none.
#ASSERT `Can my debt be written off` FALSE FALSE FALSE FALSE TRUE FALSE TRUE FALSE EQUALS FALSE
-- Not recoverable by deductions, no capacity to repay.
#ASSERT `Can my debt be written off` FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS TRUE
-- s 1236(1A)(d): not cost effective.
#ASSERT `Can my debt be written off` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS TRUE
-- None of the grounds: "if, and only if" -- no write-off.
#ASSERT `Can my debt be written off` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS FALSE
-- s 1237A(1), (1A): first payment 1 January 2026; 6 weeks ends 12 February 2026. Raised that day: within 6 weeks, no waiver.
#ASSERT `How much is waived for administrative error` 1500 TRUE (Date 1 1 2026) FALSE (Date 1 1 2026) (Date 12 2 2026) EQUALS 0
-- Raised 13 February 2026: outside 6 weeks, the error part is waived.
#ASSERT `How much is waived for administrative error` 1500 TRUE (Date 1 1 2026) FALSE (Date 1 1 2026) (Date 13 2 2026) EQUALS 1500
-- Not in good faith: no waiver.
#ASSERT `How much is waived for administrative error` 1500 FALSE (Date 1 1 2026) FALSE (Date 1 1 2026) (Date 13 2 2026) EQUALS 0
-- Debt from complying with a notification obligation, notification period ending 1 March 2026: the later 6 weeks ends 12 April.
#ASSERT `How much is waived for administrative error` 1500 TRUE (Date 1 1 2026) TRUE (Date 1 3 2026) (Date 12 4 2026) EQUALS 0
#ASSERT `How much is waived for administrative error` 1500 TRUE (Date 1 1 2026) TRUE (Date 1 3 2026) (Date 13 4 2026) EQUALS 1500
-- Notification period ended before the first payment: the first payment's 6 weeks is the later.
#ASSERT `How much is waived for administrative error` 1500 TRUE (Date 1 1 2026) TRUE (Date 1 12 2025) (Date 13 2 2026) EQUALS 1500
-- s 1237A(2).
#ASSERT `How much is waived for an underestimate of property` 800 TRUE TRUE EQUALS 800
#ASSERT `How much is waived for an underestimate of property` 800 TRUE FALSE EQUALS 0
-- s 1237AA.
#ASSERT `How much is waived for a longer sentence` 2000 TRUE TRUE EQUALS 2000
#ASSERT `How much is waived for a longer sentence` 2000 TRUE FALSE EQUALS 0
-- s 1237AAA: less than $250 is waived; exactly $250 is not.
#ASSERT `Must my small debt be waived` 249.99 250 EQUALS TRUE
#ASSERT `Must my small debt be waived` 250 250 EQUALS FALSE
-- s 1230D.
#ASSERT `Can a debt be raised for this amount` 100 250 EQUALS JUST FALSE
#ASSERT `Can a debt be raised for this amount` 250 250 EQUALS NOTHING
-- s 1237AAB(1), (2): $10,000 settled for $6,000: $4,000 waived.
#ASSERT `How much is waived on settlement` 10000 6000 EQUALS 4000
#ASSERT `How much is waived on settlement` 5000 6000 EQUALS 0
-- s 1237AAB(3): 80% of $10,000 is $8,000. Recovered $8,000: $2,000 waived; $7,999: none.
#ASSERT `How much is waived after 80% is recovered` 10000 8000 TRUE TRUE EQUALS 2000
#ASSERT `How much is waived after 80% is recovered` 10000 7999 TRUE TRUE EQUALS 0
#ASSERT `How much is waived after 80% is recovered` 10000 8000 TRUE FALSE EQUALS 0
-- s 1237AAB(6), the Act's own example: $30,000 at $1,500 a year (20 years) at 5%: 30,000 x (1 - 1/1.05^20) = $18,693.3155, $18,693.32.
#ASSERT `What is the present value of my unpaid amount` 30000 1500 0.05 EQUALS 18693.32
-- s 1237AAB(5): the example's $20,000 offer clears the floor; one cent under the present value does not; exactly it does.
#ASSERT `Can my part-payment offer be accepted` 30000 20000 1500 0.05 EQUALS TRUE
#ASSERT `Can my part-payment offer be accepted` 30000 18693.31 1500 0.05 EQUALS FALSE
#ASSERT `Can my part-payment offer be accepted` 30000 18693.32 1500 0.05 EQUALS TRUE
-- s 1237AAB(4), the example: $30,000 - $20,000 = $10,000 waived.
#ASSERT `How much is waived under my part-payment agreement` 30000 20000 EQUALS 10000
-- s 1237AAC(4), (5).
#ASSERT `How much is waived for unclaimed parenting payment` 5000 TRUE TRUE 3000 EQUALS 3000
#ASSERT `How much is waived for unclaimed parenting payment` 5000 TRUE TRUE 7000 EQUALS 5000
#ASSERT `How much is waived for unclaimed parenting payment` 5000 FALSE TRUE 3000 EQUALS 0
-- s 1237AAD: (a)(i) no knowing misstatement by anyone, special circumstances, waiver more appropriate.
#ASSERT `Can my debt be waived for special circumstances` FALSE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS TRUE
-- My own unjustified knowing misstatement: no subparagraph applies.
#ASSERT `Can my debt be waived for special circumstances` TRUE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS FALSE
-- (a)(ii): mine, but justified.
#ASSERT `Can my debt be waived for special circumstances` TRUE TRUE FALSE FALSE FALSE TRUE TRUE EQUALS TRUE
-- (a)(iii): another person's, I did not know.
#ASSERT `Can my debt be waived for special circumstances` FALSE FALSE TRUE FALSE FALSE TRUE TRUE EQUALS TRUE
-- Another person's, I knew, not justified in not correcting it: no subparagraph applies.
#ASSERT `Can my debt be waived for special circumstances` FALSE FALSE TRUE TRUE FALSE TRUE TRUE EQUALS FALSE
-- No special circumstances: no.
#ASSERT `Can my debt be waived for special circumstances` FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS FALSE
-- Mine justified, and another's known and not justifiably left uncorrected: (a)(ii) applies on its words (NOTES.md finding 5).
#ASSERT `Can my debt be waived for special circumstances` TRUE TRUE TRUE TRUE FALSE TRUE TRUE EQUALS TRUE
