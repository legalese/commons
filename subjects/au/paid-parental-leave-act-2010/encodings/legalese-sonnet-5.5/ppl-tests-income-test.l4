IMPORT prelude
IMPORT daydate
IMPORT `ppl-time`
IMPORT `ppl-income-test`

-- Every expected value is written from the sections named beside it.
-- The December quarter index numbers are invented to exercise the arithmetic; the text prints none.

`the invented December quarter index numbers for the income tests` MEANS
    LIST
        (`December quarter index` OF 2007, 100)
      , (`December quarter index` OF 2018, 108)
      , (`December quarter index` OF 2019, 110)
      , (`December quarter index` OF 2020, 109)
      , (`December quarter index` OF 2021, 116)
      , (`December quarter index` OF 2022, 120)
      , (`December quarter index` OF 2023, 125)
      , (`December quarter index` OF 2024, 126)

§ `s 38 -- adjusted taxable income is the amount worked out elsewhere`

#ASSERT `a person's adjusted taxable income for an income year` 123456 EQUALS 123456

§ `s 39 -- the reference income year`

-- the income year that ended before the earlier of the claim day and the birth day
#ASSERT `the end day of the reference income year for a person` (Date 15 3 2025) (Date 20 3 2025) (LIST (Date 30 6 2023), (Date 30 6 2024), (Date 30 6 2025)) EQUALS JUST (Date 30 6 2024)
#ASSERT `the end day of the reference income year for a person` (Date 20 3 2025) (Date 15 3 2025) (LIST (Date 30 6 2023), (Date 30 6 2024), (Date 30 6 2025)) EQUALS JUST (Date 30 6 2024)
-- the earlier day is 30 June 2025 itself: an income year ending on that day has not ended before it
#ASSERT `the end day of the reference income year for a person` (Date 30 6 2025) (Date 1 8 2025) (LIST (Date 30 6 2023), (Date 30 6 2024), (Date 30 6 2025)) EQUALS JUST (Date 30 6 2024)
#ASSERT `the end day of the reference income year for a person` (Date 1 7 2025) (Date 1 8 2025) (LIST (Date 30 6 2023), (Date 30 6 2024), (Date 30 6 2025)) EQUALS JUST (Date 30 6 2025)
-- no income year has ended before the earlier day
#ASSERT `the end day of the reference income year for a person` (Date 1 1 2000) (Date 1 1 2001) (LIST (Date 30 6 2023)) EQUALS NOTHING

§ `s 40 -- the relevant limits apply on the earlier of the claim day and the birth day`

-- claim made 1 July 2024, child born 30 June 2024: the limit on 30 June 2024
#ASSERT `the relevant individual PPL income limit` (Date 1 7 2024) (Date 30 6 2024) `the invented December quarter index numbers for the income tests` EQUALS JUST 163631
#ASSERT `the relevant individual PPL income limit` (Date 30 6 2024) (Date 1 7 2024) `the invented December quarter index numbers for the income tests` EQUALS JUST 163631
#ASSERT `the relevant individual PPL income limit` (Date 1 7 2024) (Date 1 7 2024) `the invented December quarter index numbers for the income tests` EQUALS JUST 170504
#ASSERT `the relevant family PPL income limit` (Date 1 7 2024) (Date 30 6 2024) `the invented December quarter index numbers for the income tests` EQUALS JUST 350000
#ASSERT `the relevant family PPL income limit` (Date 1 7 2024) (Date 1 7 2024) `the invented December quarter index numbers for the income tests` EQUALS JUST 364700
-- before 1 July 2023 the text states no family limit
#ASSERT `the relevant family PPL income limit` (Date 1 7 2022) (Date 1 8 2022) `the invented December quarter index numbers for the income tests` EQUALS NOTHING

§ `s 37 -- the income test`

#ASSERT `an amount is not more than a limit` 150000 (JUST 150000) EQUALS JUST TRUE
#ASSERT `an amount is not more than a limit` 150001 (JUST 150000) EQUALS JUST FALSE
#ASSERT `an amount is not more than a limit` 149999 (JUST 150000) EQUALS JUST TRUE
#ASSERT `an amount is not more than a limit` 1 NOTHING EQUALS NOTHING
-- s 37(1): income not more than the individual limit ($150,000): day before the limit is crossed, the limit, day after
#ASSERT `a person satisfies the income test on a day` TRUE FALSE FALSE 149999 0 (JUST 150000) (JUST 350000) EQUALS JUST TRUE
#ASSERT `a person satisfies the income test on a day` TRUE FALSE FALSE 150000 0 (JUST 150000) NOTHING EQUALS JUST TRUE
#ASSERT `a person satisfies the income test on a day` TRUE FALSE FALSE 150000 0 (JUST 150000) (JUST 350000) EQUALS JUST TRUE
-- s 37(2): no partner, income not more than the family limit ($350,000) though over the individual limit
#ASSERT `a person satisfies the income test on a day` TRUE FALSE FALSE 350000 0 (JUST 150000) (JUST 350000) EQUALS JUST TRUE
#ASSERT `a person satisfies the income test on a day` TRUE FALSE FALSE 350001 0 (JUST 150000) (JUST 350000) EQUALS JUST FALSE
-- s 37(3): partner at the claim, the total of the two incomes not more than the family limit
#ASSERT `a person satisfies the income test on a day` TRUE FALSE TRUE 200000 150000 (JUST 150000) (JUST 350000) EQUALS JUST TRUE
#ASSERT `a person satisfies the income test on a day` TRUE FALSE TRUE 200000 150001 (JUST 150000) (JUST 350000) EQUALS JUST FALSE
-- a person with a partner whose own income is within the individual limit is within s 37(1)
#ASSERT `a person satisfies the income test on a day` TRUE FALSE TRUE 100000 900000 (JUST 150000) (JUST 350000) EQUALS JUST TRUE
-- the day on which a determination is made counts in place of a flexible PPL day
#ASSERT `a person satisfies the income test on a day` FALSE TRUE FALSE 150000 0 (JUST 150000) (JUST 350000) EQUALS JUST TRUE
#ASSERT `a person satisfies the income test on a day` FALSE TRUE FALSE 400000 0 (JUST 150000) (JUST 350000) EQUALS JUST FALSE
-- a day that is neither: the text does not say
#ASSERT `a person satisfies the income test on a day` FALSE FALSE FALSE 100 0 (JUST 150000) (JUST 350000) EQUALS NOTHING
-- no family limit stated, over the individual limit: the text does not say
#ASSERT `a person satisfies the income test on a day` TRUE FALSE FALSE 160000 0 (JUST 150000) NOTHING EQUALS NOTHING
-- no limit stated at all
#ASSERT `a person satisfies the income test on a day` TRUE FALSE FALSE 100 0 NOTHING NOTHING EQUALS NOTHING

§ `s 43(4) -- which index numbers are used`

#ASSERT `an index number is used in working out an amount under section 43` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `an index number is used in working out an amount under section 43` FALSE FALSE FALSE EQUALS JUST FALSE
-- a number published in substitution for an earlier one is disregarded unless published to take account of a change in the reference base
#ASSERT `an index number is used in working out an amount under section 43` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `an index number is used in working out an amount under section 43` TRUE TRUE TRUE EQUALS JUST TRUE
