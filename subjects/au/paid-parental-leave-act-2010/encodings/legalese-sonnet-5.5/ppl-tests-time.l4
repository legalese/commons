IMPORT prelude
IMPORT daydate
IMPORT `ppl-time`

-- Tests of ppl-time. Every expected value is written from the text of the section named beside it.
-- The December quarter index numbers below are made up to exercise the arithmetic of sections 42 to 44; the text does not print any.

§ `s 11D -- flexible PPL days`

-- a child born on 15 March 2024: second birthday 15 March 2026, last flexible PPL day 14 March 2026
#ASSERT `the second birthday of a child born on` (Date 15 3 2024) EQUALS JUST (Date 15 3 2026)
#ASSERT `the last flexible PPL day for a child born on` (Date 15 3 2024) EQUALS JUST (Date 14 3 2026)
#ASSERT `a day is a flexible PPL day for a child born on` (Date 14 3 2024) (Date 15 3 2024) EQUALS JUST FALSE
#ASSERT `a day is a flexible PPL day for a child born on` (Date 15 3 2024) (Date 15 3 2024) EQUALS JUST TRUE
#ASSERT `a day is a flexible PPL day for a child born on` (Date 14 3 2026) (Date 15 3 2024) EQUALS JUST TRUE
#ASSERT `a day is a flexible PPL day for a child born on` (Date 15 3 2026) (Date 15 3 2024) EQUALS JUST FALSE
#ASSERT `a day is a flexible PPL day for a child born on` (Date 16 3 2026) (Date 15 3 2024) EQUALS JUST FALSE
-- a child born on 31 January 2024: second birthday 31 January 2026
#ASSERT `the second birthday of a child born on` (Date 31 1 2024) EQUALS JUST (Date 31 1 2026)
-- a child born on 29 February 2024: the text does not say what the second birthday is
#ASSERT `the second birthday of a child born on` (Date 29 2 2024) EQUALS NOTHING
#ASSERT `the last flexible PPL day for a child born on` (Date 29 2 2024) EQUALS NOTHING
#ASSERT `a day is a flexible PPL day for a child born on` (Date 28 2 2024) (Date 29 2 2024) EQUALS JUST FALSE
#ASSERT `a day is a flexible PPL day for a child born on` (Date 1 3 2024) (Date 29 2 2024) EQUALS NOTHING

