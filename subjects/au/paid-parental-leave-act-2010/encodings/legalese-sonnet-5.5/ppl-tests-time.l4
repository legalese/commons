      , (`December quarter index` OF 2018, 108)
      , (`December quarter index` OF 2019, 110)
      , (`December quarter index` OF 2020, 109)
      , (`December quarter index` OF 2021, 116)
      , (`December quarter index` OF 2022, 120)
      , (`December quarter index` OF 2023, 125)
      , (`December quarter index` OF 2024, 126)

-- section 43(2)-(3): worked to 3 decimal places, increased by 0.001 if the fourth decimal place is more than 4, increased to 1 if less than 1
#ASSERT `the indexation factor rounded` 1.0344 EQUALS 1.034
#ASSERT `the indexation factor rounded` 1.0345 EQUALS 1.035
#ASSERT `the indexation factor rounded` 1.03449999 EQUALS 1.034
#ASSERT `the indexation factor rounded` 1.0005 EQUALS 1.001
#ASSERT `the indexation factor rounded` 1.0004 EQUALS 1
#ASSERT `the indexation factor rounded` 1 EQUALS 1
#ASSERT `the indexation factor rounded` 0.9999 EQUALS 1
#ASSERT `the indexation factor rounded` 0.5 EQUALS 1
-- section 44: a multiple of $1.00 stays; a multiple of $0.50 that is not one goes up; any other goes to the nearest dollar
#ASSERT `the indexed amount` 163630 EQUALS 163630
#ASSERT `the indexed amount` 163630.5 EQUALS 163631
#ASSERT `the indexed amount` 163630.4 EQUALS 163630
#ASSERT `the indexed amount` 163630.6 EQUALS 163631
#ASSERT `the indexed amount` 0.5 EQUALS 1
