IMPORT prelude
IMPORT daydate
IMPORT `ppl-logic`
IMPORT `ppl-time`
IMPORT `ppl-nouns`
IMPORT `ppl-definitions`
IMPORT `ppl-key-provisions`
IMPORT `ppl-determinations`

-- Every expected value is written from the section named beside it.
-- A permission record is: given, revoked, the number of flexible PPL days specified.

`a permission in place for 20 days` MEANS `A permission to claim flexible PPL days` OF TRUE, FALSE, 20
`a revoked permission for 20 days` MEANS `A permission to claim flexible PPL days` OF TRUE, TRUE, 20
`no permission` MEANS `A permission to claim flexible PPL days` OF FALSE, FALSE, 0

`a PPL claim base` MEANS `The facts for a determination under section 13(2)` OF (JUST TRUE), TRUE, (JUST TRUE), FALSE, (JUST TRUE), FALSE, FALSE, FALSE, (`a permission in place for 20 days`), (`no permission`), 10
`a special PPL claim base` MEANS `The facts for a determination under section 14(2)` OF TRUE, (JUST TRUE), FALSE, (`no permission`), 5

-- A relationship record is: child adopted, artificial conception, surrogacy, adoptive parent, parent under Family Law Act s 60H, s 60HB,
-- parent in the ordinary sense, birth mother, partner of the birth mother, partner of an adoptive parent, partner of a person covered by s 13(3)(a).
`the birth mother` MEANS `The parental relationship` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, TRUE, FALSE, FALSE, FALSE
`a parent who is not the birth mother` MEANS `The parental relationship` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE
`the partner of the birth mother` MEANS `The parental relationship` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE
`the partner of the other parent` MEANS `The parental relationship` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE
`an adoptive parent` MEANS `The parental relationship` OF TRUE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`the partner of an adoptive parent` MEANS `The parental relationship` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE

§ `s 13(3), (4) -- the persons covered`

#ASSERT `a person is covered by subsection 13(3)` (`a parent who is not the birth mother`)
#ASSERT `a person is covered by subsection 13(3)` (`the partner of the birth mother`)
#ASSERT `a person is covered by subsection 13(3)` (`the partner of the other parent`)
#ASSERT NOT `a person is covered by subsection 13(3)` (`the birth mother`)
#ASSERT NOT `a person is covered by subsection 13(3)` (`an adoptive parent`)
#ASSERT NOT `a person is covered by subsection 13(3)` (`the partner of an adoptive parent`)
#ASSERT `a person is covered by subsection 13(4)` (`an adoptive parent`) TRUE
#ASSERT NOT `a person is covered by subsection 13(4)` (`an adoptive parent`) FALSE
#ASSERT `a person is covered by subsection 13(4)` (`the partner of an adoptive parent`) FALSE
#ASSERT NOT `a person is covered by subsection 13(4)` (`a parent who is not the birth mother`) TRUE

