IMPORT prelude
IMPORT daydate
IMPORT `ppl-seat`

-- Worked cases for the seat layer, one or more for each question.
-- Every expected value is written from the section named beside the question, before the case is run.
-- The facts are those a real person in the seat would state; dates are invented.

§ `Is this a flexible PPL day, and how many can be paid?`

-- s 11D: a child born on 15 March 2024; the second birthday is 15 March 2026
#ASSERT `Is this day a flexible PPL day for my child` (Date 14 3 2026) (Date 15 3 2024) EQUALS JUST TRUE
#ASSERT `Is this day a flexible PPL day for my child` (Date 15 3 2026) (Date 15 3 2024) EQUALS JUST FALSE
#ASSERT `Is this day a flexible PPL day for my child` (Date 14 3 2024) (Date 15 3 2024) EQUALS JUST FALSE
#ASSERT `Is this day a flexible PPL day for my child` (Date 15 3 2024) (Date 15 3 2024) EQUALS JUST TRUE
-- a child born on 29 February 2024: the Act does not say when the second birthday is, so a day after the birth is not settled
#ASSERT `Is this day a flexible PPL day for my child` (Date 1 3 2024) (Date 29 2 2024) EQUALS NOTHING
-- s 31ABA(2) for a claimant with a partner, s 31ABA(1) for one without
#ASSERT `What is the most flexible PPL days that can be paid to me for my child` (Date 15 3 2024) TRUE EQUALS 90
#ASSERT `What is the most flexible PPL days that can be paid to me for my child` (Date 15 3 2024) FALSE EQUALS 100
#ASSERT `What is the most flexible PPL days that can be paid to me for my child` (Date 1 7 2024) TRUE EQUALS 100
#ASSERT `What is the most flexible PPL days that can be paid to me for my child` (Date 1 7 2024) FALSE EQUALS 110
#ASSERT `What is the most flexible PPL days that can be paid to me for my child` (Date 1 7 2025) TRUE EQUALS 105
#ASSERT `What is the most flexible PPL days that can be paid to me for my child` (Date 1 7 2025) FALSE EQUALS 120
#ASSERT `What is the most flexible PPL days that can be paid to me for my child` (Date 1 7 2026) TRUE EQUALS 110
#ASSERT `What is the most flexible PPL days that can be paid to me for my child` (Date 1 7 2026) FALSE EQUALS 130
#ASSERT `What is the most flexible PPL days that can be paid for my child counting everyone who claims` (Date 30 6 2024) EQUALS 100
#ASSERT `What is the most flexible PPL days that can be paid for my child counting everyone who claims` (Date 1 7 2024) EQUALS 110

§ `Am I eligible?`

-- the facts of the main rule: residency, caring, no paid work, both tests met, residency on the birth day
#ASSERT `Am I eligible for parental leave pay on this flexible PPL day` (Date 15 3 2024) TRUE TRUE 0 TRUE Yes Yes TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 0 0 0 0 FALSE FALSE FALSE EQUALS JUST TRUE
-- the work test answer is that the Act does not say
#ASSERT `Am I eligible for parental leave pay on this flexible PPL day` (Date 15 3 2024) TRUE TRUE 0 TRUE `The Act does not say` Yes TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 0 0 0 0 FALSE FALSE FALSE EQUALS NOTHING
-- 99 flexible PPL days are covered by determinations for anyone; the limit for a child born on 15 March 2024 is 100
#ASSERT `Am I eligible for parental leave pay on this flexible PPL day` (Date 15 3 2024) TRUE TRUE 0 TRUE Yes Yes TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 99 0 0 0 FALSE FALSE FALSE EQUALS JUST TRUE
-- 100 are covered: section 31AB(2) applies
#ASSERT `Am I eligible for parental leave pay on this flexible PPL day` (Date 15 3 2024) TRUE TRUE 0 TRUE Yes Yes TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 100 0 0 0 FALSE FALSE FALSE EQUALS JUST FALSE
-- the claimant is deceased on the day: section 31AB(7)
#ASSERT `Am I eligible for parental leave pay on this flexible PPL day` (Date 15 3 2024) TRUE TRUE 0 TRUE Yes Yes TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 0 0 0 0 TRUE FALSE FALSE EQUALS JUST FALSE
-- two hours of paid work on the day: the main rule fails and no other route applies
#ASSERT `Am I eligible for parental leave pay on this flexible PPL day` (Date 15 3 2024) TRUE TRUE 2 TRUE Yes Yes TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 0 0 0 0 FALSE FALSE FALSE EQUALS JUST FALSE
-- the child is stillborn: section 31AA(3)
#ASSERT `Am I eligible for parental leave pay on this flexible PPL day` (Date 15 3 2024) TRUE FALSE 8 TRUE Yes Yes TRUE FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 0 0 0 0 FALSE FALSE FALSE EQUALS JUST TRUE
-- the day is in a newly arrived resident's waiting period: section 31AB(8)
#ASSERT `Am I eligible for parental leave pay on this flexible PPL day` (Date 15 3 2024) TRUE TRUE 0 TRUE Yes Yes TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 0 0 0 0 FALSE TRUE FALSE EQUALS JUST FALSE
-- the same, but section 31A(7) or (7A) applies to the claimant on the day
#ASSERT `Am I eligible for parental leave pay on this flexible PPL day` (Date 15 3 2024) TRUE TRUE 0 TRUE Yes Yes TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 0 0 0 0 FALSE TRUE TRUE EQUALS JUST TRUE
-- not caring for the child, but the prescribed conditions of section 31AA(4)(e) are met
#ASSERT `Am I eligible for parental leave pay on this flexible PPL day` (Date 15 3 2024) TRUE FALSE 0 TRUE Yes Yes TRUE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE 0 0 0 0 FALSE FALSE FALSE EQUALS JUST TRUE
-- a special PPL claimant in exceptional circumstances meeting the conditions prescribed for section 31AA(5)(d)
#ASSERT `Am I eligible for parental leave pay on this flexible PPL day` (Date 15 3 2024) TRUE FALSE 0 TRUE Yes Yes TRUE FALSE FALSE FALSE FALSE TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE 0 0 0 0 FALSE FALSE FALSE EQUALS JUST TRUE
-- the claimant is partnered, the partner is in the prescribed exceptional circumstances, and determinations of either kind cover the 90 days that section 31ABA(2) allows a partnered claimant: section 31AB(6) applies
#ASSERT `Am I eligible for parental leave pay on this flexible PPL day` (Date 15 3 2024) TRUE TRUE 0 TRUE Yes Yes TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE FALSE TRUE 0 90 0 90 FALSE FALSE FALSE EQUALS JUST FALSE
-- one day fewer: the limit is not reached, so section 31AB(6) does not apply
#ASSERT `Am I eligible for parental leave pay on this flexible PPL day` (Date 15 3 2024) TRUE TRUE 0 TRUE Yes Yes TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE FALSE TRUE 0 89 0 89 FALSE FALSE FALSE EQUALS JUST TRUE

-- s 31A(2)-(4): the waiting period starts on the later of first entering Australia (10 February 2020) and becoming a permanent visa holder (1 March 2020)
#ASSERT `When does my newly arrived resident's waiting period start` TRUE FALSE FALSE (Date 1 1 2020) (Date 5 5 2019) (Date 10 2 2020) (Date 1 3 2020) EQUALS JUST (Date 1 3 2020)
-- subsection (2): the day the person applied for the visa
#ASSERT `When does my newly arrived resident's waiting period start` TRUE TRUE FALSE (Date 1 1 2020) (Date 5 5 2019) (Date 10 2 2020) (Date 1 3 2020) EQUALS JUST (Date 1 1 2020)
-- subsection (3): the day the person applied for the last of the earlier visas
#ASSERT `When does my newly arrived resident's waiting period start` TRUE TRUE TRUE (Date 1 1 2020) (Date 5 5 2019) (Date 10 2 2020) (Date 1 3 2020) EQUALS JUST (Date 5 5 2019)
-- not subject to a waiting period: the section gives no start day
#ASSERT `When does my newly arrived resident's waiting period start` FALSE FALSE FALSE (Date 1 1 2020) (Date 5 5 2019) (Date 10 2 2020) (Date 1 3 2020) EQUALS NOTHING

§ `Do I satisfy the income test?`

-- s 37(3): with a partner, the two incomes together are not more than the family limit ($350,000)
#ASSERT `Do I satisfy the income test on this day` TRUE FALSE TRUE 200000 150000 150000 350000 EQUALS JUST TRUE
#ASSERT `Do I satisfy the income test on this day` TRUE FALSE TRUE 200000 150001 150000 350000 EQUALS JUST FALSE
-- s 37(1): income not more than the individual limit ($150,000)
#ASSERT `Do I satisfy the income test on this day` TRUE FALSE FALSE 150000 0 150000 350000 EQUALS JUST TRUE
#ASSERT `Do I satisfy the income test on this day` TRUE FALSE FALSE 150001 0 150000 150000 EQUALS JUST FALSE
-- s 37(2): without a partner, income over the individual limit but not over the family limit
#ASSERT `Do I satisfy the income test on this day` TRUE FALSE FALSE 350000 0 150000 350000 EQUALS JUST TRUE
-- the day is neither a flexible PPL day nor a day on which a determination is made: section 37 does not say
#ASSERT `Do I satisfy the income test on this day` FALSE FALSE FALSE 100000 0 150000 350000 EQUALS NOTHING
-- s 41: the figures the Act itself states
#ASSERT `What individual PPL income limit does the Act itself state for this day` (Date 30 9 2010) EQUALS NOTHING
#ASSERT `What individual PPL income limit does the Act itself state for this day` (Date 1 10 2010) EQUALS JUST 150000
#ASSERT `What individual PPL income limit does the Act itself state for this day` (Date 30 6 2021) EQUALS JUST 150000
-- from 1 July 2021 the limit is indexed and section 41 states no figure
#ASSERT `What individual PPL income limit does the Act itself state for this day` (Date 1 7 2021) EQUALS NOTHING
#ASSERT `What family PPL income limit does the Act itself state for this day` (Date 30 6 2023) EQUALS NOTHING
#ASSERT `What family PPL income limit does the Act itself state for this day` (Date 1 7 2023) EQUALS JUST 350000
#ASSERT `What family PPL income limit does the Act itself state for this day` (Date 30 6 2024) EQUALS JUST 350000
#ASSERT `What family PPL income limit does the Act itself state for this day` (Date 1 7 2024) EQUALS NOTHING

§ `Do I satisfy the work test?`

-- s 33(1)(a): section 33(2A) applies and the person would fail the work test with the other period: counted back from the work cessation day, 1 February 2025
#ASSERT `Which day does my work test period count back from` FALSE TRUE (Date 1 2 2025) TRUE FALSE FALSE (Date 1 3 2025) (Date 1 4 2025) EQUALS Date 1 2 2025
-- s 33(1)(b): born after the expected date and would fail the work test counted from the birth: the expected date of birth
#ASSERT `Which day does my work test period count back from` FALSE FALSE (Date 1 2 2025) FALSE TRUE TRUE (Date 1 3 2025) (Date 1 4 2025) EQUALS Date 1 3 2025
-- s 33(1)(c): otherwise the day the child is born
#ASSERT `Which day does my work test period count back from` FALSE FALSE (Date 1 2 2025) FALSE FALSE FALSE (Date 1 3 2025) (Date 1 4 2025) EQUALS Date 1 4 2025
-- s 33(2): for an initial eligibility determination, otherwise the expected date of birth
#ASSERT `Which day does my work test period count back from` TRUE FALSE (Date 1 2 2025) FALSE FALSE FALSE (Date 1 3 2025) (Date 1 4 2025) EQUALS Date 1 3 2025
-- ss 32, 33, 33A: the lengths
#ASSERT `How many days long is my work test period` FALSE EQUALS 392
#ASSERT `How many days long is my work test period` TRUE EQUALS 600
#ASSERT `How many consecutive days must my qualifying period have` EQUALS 295
#ASSERT `How many hours of qualifying work must I have performed in a qualifying period` EQUALS 330
-- s 32: 392 days of two hours of paid work each (one block): a qualifying period with 590 hours
#ASSERT `Do I satisfy the work test by the method statement in section 32` FALSE (Date 1 7 2025) FALSE 0 FALSE 0 392 2 0 0 0 0 0 0 0 0 EQUALS JUST TRUE
-- 211 working days, 84 days off (a permissible break), 97 working days: still a qualifying period
#ASSERT `Do I satisfy the work test by the method statement in section 32` FALSE (Date 1 7 2025) FALSE 0 FALSE 0 211 2 84 0 97 2 0 0 0 0 EQUALS JUST TRUE
-- 100 working days, 90 days off (more than 84), 100 working days, 102 days off: no run of 295 days
#ASSERT `Do I satisfy the work test by the method statement in section 32` FALSE (Date 1 7 2025) FALSE 0 FALSE 0 100 2 90 0 100 2 102 0 0 0 EQUALS JUST FALSE
-- the blocks add up to 391 days, not 392: the facts do not describe the work test period
#ASSERT `Do I satisfy the work test by the method statement in section 32` FALSE (Date 1 7 2025) FALSE 0 FALSE 0 200 2 191 2 0 0 0 0 0 0 EQUALS NOTHING
-- a COVID-19 affected claimant has a work test period of 600 days
#ASSERT `Do I satisfy the work test by the method statement in section 32` TRUE (Date 1 7 2025) FALSE 0 FALSE 0 300 2 300 2 0 0 0 0 0 0 EQUALS JUST TRUE
-- ss 36A, 36AA: the child born prematurely, the person would otherwise have satisfied the test
#ASSERT `Can I satisfy the work test in another way` `I am the child's birth mother` TRUE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- complications of the pregnancy, for the birth mother
#ASSERT `Can I satisfy the work test in another way` `I am the child's birth mother` FALSE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- complications of the pregnancy do not help a parent who is not the birth mother
#ASSERT `Can I satisfy the work test in another way` `I am a parent of the child and not the birth mother` FALSE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
-- special circumstances
#ASSERT `Can I satisfy the work test in another way` `I am the partner of the child's birth mother` FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE

§ `When is another claimant's permission needed?`

-- s 13(2)(d): a parent who is not the birth mother needs a permission unless the prescribed circumstances apply
#ASSERT `Do I need another claimant's permission before the Secretary can determine my PPL claim` `I am a parent of the child and not the birth mother` FALSE FALSE FALSE
#ASSERT NOT `Do I need another claimant's permission before the Secretary can determine my PPL claim` `I am a parent of the child and not the birth mother` FALSE TRUE FALSE
#ASSERT `Do I need another claimant's permission before the Secretary can determine my PPL claim` `I am the partner of the child's birth mother` FALSE FALSE FALSE
-- the birth mother does not need another claimant's permission
#ASSERT NOT `Do I need another claimant's permission before the Secretary can determine my PPL claim` `I am the child's birth mother` FALSE FALSE FALSE
-- s 13(2)(e): an adoptive parent needs a permission only once a determination is in force for another adoptive parent; the partner of an adoptive parent needs one
#ASSERT `Do I need another claimant's permission before the Secretary can determine my PPL claim` `I am an adoptive parent of the child` TRUE FALSE FALSE
#ASSERT NOT `Do I need another claimant's permission before the Secretary can determine my PPL claim` `I am an adoptive parent of the child` FALSE FALSE FALSE
#ASSERT `Do I need another claimant's permission before the Secretary can determine my PPL claim` `I am the partner of an adoptive parent of the child` FALSE FALSE FALSE
-- s 14(2)(c)
#ASSERT `Do I need a permission before the Secretary can determine my special PPL claim` TRUE
#ASSERT NOT `Do I need a permission before the Secretary can determine my special PPL claim` FALSE
-- s 15(1): who may give permission
#ASSERT `May this person give me permission to claim flexible PPL days` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `May this person give me permission to claim flexible PPL days` FALSE TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `May this person give me permission to claim flexible PPL days` FALSE TRUE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `May this person give me permission to claim flexible PPL days` FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- s 15(2)
#ASSERT `May this person give me permission as a special PPL claimant` TRUE TRUE EQUALS JUST TRUE
#ASSERT `May this person give me permission as a special PPL claimant` TRUE FALSE EQUALS NOTHING

§ `Can the Secretary determine that parental leave pay is payable to me?`

-- a parent who is not the birth mother: eligible, the birth mother satisfies the work test, a permission for 20 days is in place, 10 days would be payable, the birth verified, no bar
#ASSERT `Can the Secretary determine that parental leave pay is payable to me as a PPL claimant` `I am a parent of the child and not the birth mother` TRUE Yes TRUE Yes FALSE Yes FALSE FALSE FALSE TRUE FALSE 20 10 TRUE FALSE (Date 15 3 2024) FALSE FALSE 0 FALSE EQUALS JUST TRUE
-- the permission has been given for 9 days only and 10 would be payable: section 13(2)(d)(iii) is not met
#ASSERT `Can the Secretary determine that parental leave pay is payable to me as a PPL claimant` `I am a parent of the child and not the birth mother` TRUE Yes TRUE Yes FALSE Yes FALSE FALSE FALSE TRUE FALSE 9 10 TRUE FALSE (Date 15 3 2024) FALSE FALSE 0 FALSE EQUALS JUST FALSE
-- no permission has been given
#ASSERT `Can the Secretary determine that parental leave pay is payable to me as a PPL claimant` `I am a parent of the child and not the birth mother` TRUE Yes TRUE Yes FALSE Yes FALSE FALSE FALSE FALSE FALSE 0 10 TRUE FALSE (Date 15 3 2024) FALSE FALSE 0 FALSE EQUALS JUST FALSE
-- the birth mother's own claim needs no permission
#ASSERT `Can the Secretary determine that parental leave pay is payable to me as a PPL claimant` `I am the child's birth mother` TRUE Yes TRUE Yes FALSE Yes FALSE FALSE FALSE FALSE FALSE 0 10 TRUE FALSE (Date 15 3 2024) FALSE FALSE 0 FALSE EQUALS JUST TRUE
-- eligibility is not settled by the Act
#ASSERT `Can the Secretary determine that parental leave pay is payable to me as a PPL claimant` `I am the child's birth mother` TRUE `The Act does not say` TRUE Yes FALSE Yes FALSE FALSE FALSE FALSE FALSE 0 10 TRUE FALSE (Date 15 3 2024) FALSE FALSE 0 FALSE EQUALS NOTHING
-- section 11B: not eligible
#ASSERT `Can the Secretary determine that parental leave pay is payable to me as a PPL claimant` `I am the child's birth mother` TRUE No TRUE Yes FALSE Yes FALSE FALSE FALSE FALSE FALSE 0 10 TRUE FALSE (Date 15 3 2024) FALSE FALSE 0 FALSE EQUALS JUST FALSE
-- section 11C: no effective claim for the day
#ASSERT `Can the Secretary determine that parental leave pay is payable to me as a PPL claimant` `I am the child's birth mother` FALSE Yes TRUE Yes FALSE Yes FALSE FALSE FALSE FALSE FALSE 0 10 TRUE FALSE (Date 15 3 2024) FALSE FALSE 0 FALSE EQUALS JUST FALSE
-- section 18: the child's birth has not been verified
#ASSERT `Can the Secretary determine that parental leave pay is payable to me as a PPL claimant` `I am the child's birth mother` TRUE Yes TRUE Yes FALSE Yes FALSE FALSE FALSE FALSE FALSE 0 10 FALSE FALSE (Date 15 3 2024) FALSE FALSE 0 FALSE EQUALS JUST FALSE
-- section 19B: a COVID-19 affected claimant whose child is born after 31 March 2021
#ASSERT `Can the Secretary determine that parental leave pay is payable to me as a PPL claimant` `I am the child's birth mother` TRUE Yes TRUE Yes FALSE Yes FALSE FALSE FALSE FALSE FALSE 0 10 TRUE TRUE (Date 1 4 2021) FALSE FALSE 0 FALSE EQUALS JUST FALSE
#ASSERT `Can the Secretary determine that parental leave pay is payable to me as a PPL claimant` `I am the child's birth mother` TRUE Yes TRUE Yes FALSE Yes FALSE FALSE FALSE FALSE FALSE 0 10 TRUE TRUE (Date 31 3 2021) FALSE FALSE 0 FALSE EQUALS JUST TRUE
-- section 20: multiple births
#ASSERT `Can the Secretary determine that parental leave pay is payable to me as a PPL claimant` `I am the child's birth mother` TRUE Yes TRUE Yes FALSE Yes FALSE FALSE FALSE FALSE FALSE 0 10 TRUE FALSE (Date 15 3 2024) TRUE TRUE 0 FALSE EQUALS JUST FALSE
-- section 21: for a child born on 30 June 2025 the limit is 10 days; on 1 July 2025 it is 20
#ASSERT `Can the Secretary determine that parental leave pay is payable to me as a PPL claimant` `I am the child's birth mother` TRUE Yes TRUE Yes FALSE Yes FALSE FALSE FALSE FALSE FALSE 0 10 TRUE FALSE (Date 30 6 2025) FALSE FALSE 10 TRUE EQUALS JUST FALSE
#ASSERT `Can the Secretary determine that parental leave pay is payable to me as a PPL claimant` `I am the child's birth mother` TRUE Yes TRUE Yes FALSE Yes FALSE FALSE FALSE FALSE FALSE 0 10 TRUE FALSE (Date 1 7 2025) FALSE FALSE 19 TRUE EQUALS JUST TRUE
-- special PPL claimants: a partner of a person in the prescribed circumstances, with a permission for 20 days, 5 days payable
#ASSERT `Can the Secretary determine that parental leave pay is payable to me as a special PPL claimant` TRUE TRUE Yes TRUE TRUE FALSE 20 5 TRUE FALSE (Date 15 3 2024) FALSE FALSE 0 FALSE EQUALS JUST TRUE
-- no payability determination under section 13 is in force
#ASSERT `Can the Secretary determine that parental leave pay is payable to me as a special PPL claimant` TRUE FALSE Yes TRUE TRUE FALSE 20 5 TRUE FALSE (Date 15 3 2024) FALSE FALSE 0 FALSE EQUALS JUST FALSE
-- a special PPL claimant who is not the partner of such a person and has no permission: the text does not say what paragraphs (d) and (e) ask of such a claimant
#ASSERT `Can the Secretary determine that parental leave pay is payable to me as a special PPL claimant` TRUE TRUE Yes FALSE FALSE FALSE 0 5 TRUE FALSE (Date 15 3 2024) FALSE FALSE 0 FALSE EQUALS NOTHING
-- no effective special PPL claim for the day
#ASSERT `Can the Secretary determine that parental leave pay is payable to me as a special PPL claimant` FALSE TRUE Yes TRUE TRUE FALSE 20 5 TRUE FALSE (Date 15 3 2024) FALSE FALSE 0 FALSE EQUALS JUST FALSE

§ `After a determination`

-- s 23: made on 10 June 2026, revoked from 20 June 2026 (the day of the request, s 25(2))
#ASSERT NOT `Is my payability determination in force on this day` (Date 9 6 2026) (Date 10 6 2026) TRUE (Date 20 6 2026) FALSE (Date 1 1 2000)
#ASSERT `Is my payability determination in force on this day` (Date 10 6 2026) (Date 10 6 2026) TRUE (Date 20 6 2026) FALSE (Date 1 1 2000)
#ASSERT `Is my payability determination in force on this day` (Date 19 6 2026) (Date 10 6 2026) TRUE (Date 20 6 2026) FALSE (Date 1 1 2000)
#ASSERT NOT `Is my payability determination in force on this day` (Date 20 6 2026) (Date 10 6 2026) TRUE (Date 20 6 2026) FALSE (Date 1 1 2000)
#ASSERT `Is my payability determination in force on this day` (Date 31 12 2030) (Date 10 6 2026) FALSE (Date 1 1 2000) FALSE (Date 1 1 2000)
-- s 25: a request on the day before the last day of the instalment period (10 June 2026), on that day, and after it
#ASSERT `Must the Secretary revoke my payability determination if I ask` TRUE TRUE (Date 9 6 2026) (Date 10 6 2026) TRUE EQUALS JUST TRUE
#ASSERT `Must the Secretary revoke my payability determination if I ask` TRUE TRUE (Date 10 6 2026) (Date 10 6 2026) TRUE EQUALS NOTHING
#ASSERT `Must the Secretary revoke my payability determination if I ask` TRUE TRUE (Date 11 6 2026) (Date 10 6 2026) TRUE EQUALS NOTHING
-- s 15(6): a determination for 20 days of which 12 have not yet occurred, the permission varied to 15 days
#ASSERT `How many days are removed from my determination when the permission I was given is varied` TRUE TRUE TRUE 20 12 15 EQUALS JUST 5
-- the permission is not varied: section 15(6) does not apply
#ASSERT `How many days are removed from my determination when the permission I was given is varied` TRUE TRUE FALSE 20 12 15 EQUALS NOTHING
