IMPORT prelude
IMPORT `ppl-logic`

§ `three-valued helpers`

#ASSERT `both results hold` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `both results hold` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `both results hold` (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `both results hold` NOTHING (JUST FALSE) EQUALS JUST FALSE
#ASSERT `both results hold` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `both results hold` NOTHING NOTHING EQUALS NOTHING
#ASSERT `either result holds` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `either result holds` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `either result holds` NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `either result holds` (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `either result holds` (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `either result holds` NOTHING NOTHING EQUALS NOTHING
#ASSERT `the opposite of a result` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `the opposite of a result` (JUST FALSE) EQUALS JUST TRUE
#ASSERT `the opposite of a result` NOTHING EQUALS NOTHING
#ASSERT `every result in a list holds` (LIST (JUST TRUE), (JUST TRUE)) EQUALS JUST TRUE
#ASSERT `every result in a list holds` (LIST (JUST TRUE), NOTHING, (JUST FALSE)) EQUALS JUST FALSE
#ASSERT `every result in a list holds` (LIST (JUST TRUE), NOTHING) EQUALS NOTHING
#ASSERT `every result in a list holds` (LIST (JUST TRUE)) EQUALS JUST TRUE
#ASSERT `some result in a list holds` (LIST (JUST FALSE), (JUST TRUE)) EQUALS JUST TRUE
#ASSERT `some result in a list holds` (LIST (JUST FALSE), NOTHING) EQUALS NOTHING
#ASSERT `some result in a list holds` (LIST (JUST FALSE), (JUST FALSE)) EQUALS JUST FALSE
