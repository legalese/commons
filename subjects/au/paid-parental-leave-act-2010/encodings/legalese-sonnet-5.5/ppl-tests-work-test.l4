IMPORT prelude
IMPORT daydate
IMPORT `ppl-logic`
IMPORT `ppl-time`
IMPORT `ppl-nouns`
IMPORT `ppl-work-test`

-- Every expected value is written from the section named beside it.
-- A day record is: hours of paid work, hours of paid leave, a flexible PPL day for a previous child on which parental leave pay was payable,
-- in a jobkeeper payment period, the hours taken for that, in a COVID-19 Australian Government payment period, the hours taken for that.

`an idle day` MEANS `A day in the work test period` OF 0, 0, FALSE, FALSE, 0, FALSE, 0
`a day with one hour of paid work` MEANS `A day in the work test period` OF 1, 0, FALSE, FALSE, 0, FALSE, 0
`a day with two hours of paid work` MEANS `A day in the work test period` OF 2, 0, FALSE, FALSE, 0, FALSE, 0
`a day with half an hour of paid work` MEANS `A day in the work test period` OF 0.5, 0, FALSE, FALSE, 0, FALSE, 0
`the first day of the invented work test period` MEANS Date 4 6 2024

§ `s 33(2A) -- work cessation because of hazards`

#ASSERT `subsection 33(2A) applies in relation to a claimant` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `subsection 33(2A) applies in relation to a claimant` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `subsection 33(2A) applies in relation to a claimant` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `subsection 33(2A) applies in relation to a claimant` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `subsection 33(2A) applies in relation to a claimant` TRUE TRUE TRUE FALSE EQUALS JUST FALSE

§ `s 34 -- qualifying work`

#ASSERT `a person performs qualifying work on a day` (`a day with one hour of paid work`)
#ASSERT NOT `a person performs qualifying work on a day` (`a day with half an hour of paid work`)
#ASSERT NOT `a person performs qualifying work on a day` (`an idle day`)
#ASSERT `a person performs qualifying work on a day` (`A day in the work test period` OF 0, 1, FALSE, FALSE, 0, FALSE, 0)
#ASSERT NOT `a person performs qualifying work on a day` (`A day in the work test period` OF 0, 0.99, FALSE, FALSE, 0, FALSE, 0)
#ASSERT `a person performs qualifying work on a day` (`A day in the work test period` OF 0, 0, TRUE, FALSE, 0, FALSE, 0)
#ASSERT `a person performs qualifying work on a day` (`A day in the work test period` OF 0, 0, FALSE, TRUE, 0, FALSE, 0)
#ASSERT `a person performs qualifying work on a day` (`A day in the work test period` OF 0, 0, FALSE, FALSE, 0, TRUE, 0)
#ASSERT `a period is a jobkeeper payment period for a person` TRUE FALSE EQUALS JUST TRUE
#ASSERT `a period is a jobkeeper payment period for a person` FALSE TRUE EQUALS JUST TRUE
#ASSERT `a period is a jobkeeper payment period for a person` FALSE FALSE EQUALS JUST FALSE
#ASSERT `a payment is a jobkeeper payment` TRUE TRUE EQUALS JUST TRUE
#ASSERT `a payment is a jobkeeper payment` TRUE FALSE EQUALS JUST FALSE
#ASSERT `a payment is a jobkeeper payment` FALSE TRUE EQUALS JUST FALSE
