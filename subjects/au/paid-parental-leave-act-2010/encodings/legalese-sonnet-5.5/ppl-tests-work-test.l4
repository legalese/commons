#ASSERT `a payment is a COVID-19 Australian Government payment` FALSE FALSE EQUALS JUST FALSE

§ `s 35 -- paid work`

-- work for another entity the person does not control
#ASSERT `a person performs paid work on a day` TRUE FALSE FALSE NOTHING EQUALS JUST TRUE
-- the other entity is controlled by the person: taken not to be paid work by subsection (1)
#ASSERT `a person performs paid work on a day` TRUE TRUE FALSE NOTHING EQUALS JUST FALSE
-- a business carried on for profit by the person: subsection (3)
#ASSERT `a person performs paid work on a day` FALSE FALSE TRUE NOTHING EQUALS JUST TRUE
#ASSERT `a person performs paid work on a day` TRUE TRUE TRUE NOTHING EQUALS JUST TRUE
#ASSERT `a person performs paid work on a day` FALSE FALSE FALSE NOTHING EQUALS JUST FALSE
-- subsection (5): the PPL rules may prescribe what is, or is not, taken to be paid work
#ASSERT `a person performs paid work on a day` FALSE FALSE FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `a person performs paid work on a day` TRUE FALSE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `a person controls an entity` TRUE EQUALS JUST TRUE
#ASSERT `a person controls an entity` FALSE EQUALS JUST FALSE

§ `s 35A, 35B, 35C -- the hours of qualifying work on a day`

-- section 35A(1): a flexible PPL day for a previous child and nothing else: 7.6 hours
#ASSERT `the hours of qualifying work a person is taken to have performed on a day` (`A day in the work test period` OF 0, 0, TRUE, FALSE, 0, FALSE, 0) EQUALS JUST 7.6
-- 35A(2): paid work of at least one hour on that day: the greater of 7.6 and the hours of paid work
#ASSERT `the hours of qualifying work a person is taken to have performed on a day` (`A day in the work test period` OF 8, 0, TRUE, FALSE, 0, FALSE, 0) EQUALS JUST 8
#ASSERT `the hours of qualifying work a person is taken to have performed on a day` (`A day in the work test period` OF 5, 0, TRUE, FALSE, 0, FALSE, 0) EQUALS JUST 7.6
#ASSERT `the hours of qualifying work a person is taken to have performed on a day` (`A day in the work test period` OF 7.6, 0, TRUE, FALSE, 0, FALSE, 0) EQUALS JUST 7.6
-- 35A(3): paid leave of at least one hour on that day: the greater of 7.6 and the hours of paid leave
#ASSERT `the hours of qualifying work a person is taken to have performed on a day` (`A day in the work test period` OF 0, 8, TRUE, FALSE, 0, FALSE, 0) EQUALS JUST 8
#ASSERT `the hours of qualifying work a person is taken to have performed on a day` (`A day in the work test period` OF 0, 5, TRUE, FALSE, 0, FALSE, 0) EQUALS JUST 7.6
-- paid work under one hour does not engage 35A(2): only 35A(1)
#ASSERT `the hours of qualifying work a person is taken to have performed on a day` (`A day in the work test period` OF 0.5, 0, TRUE, FALSE, 0, FALSE, 0) EQUALS JUST 7.6
-- both paid work and paid leave on a flexible PPL day for a previous child: subsections (2) and (3) give two answers
#ASSERT `the hours of qualifying work a person is taken to have performed on a day` (`A day in the work test period` OF 8, 9, TRUE, FALSE, 0, FALSE, 0) EQUALS NOTHING
#ASSERT `the hours of qualifying work a person is taken to have performed on a day` (`A day in the work test period` OF 8, 8, TRUE, FALSE, 0, FALSE, 0) EQUALS JUST 8
#ASSERT `the hours of qualifying work a person is taken to have performed on a day` (`A day in the work test period` OF 5, 6, TRUE, FALSE, 0, FALSE, 0) EQUALS JUST 7.6
-- 35B(2): the hours for a jobkeeper payment period day apply even if paid work was performed, and despite 35A
#ASSERT `the hours of qualifying work a person is taken to have performed on a day` (`A day in the work test period` OF 8, 0, FALSE, TRUE, 3, FALSE, 0) EQUALS JUST 3
#ASSERT `the hours of qualifying work a person is taken to have performed on a day` (`A day in the work test period` OF 0, 0, TRUE, TRUE, 3, FALSE, 0) EQUALS JUST 3
-- 35C(2): the same for a COVID-19 Australian Government payment period day
#ASSERT `the hours of qualifying work a person is taken to have performed on a day` (`A day in the work test period` OF 8, 0, FALSE, FALSE, 0, TRUE, 4) EQUALS JUST 4
#ASSERT `the hours of qualifying work a person is taken to have performed on a day` (`A day in the work test period` OF 0, 0, TRUE, FALSE, 0, TRUE, 4) EQUALS JUST 4
-- a day in both kinds of period: the two sections give two answers unless they agree
#ASSERT `the hours of qualifying work a person is taken to have performed on a day` (`A day in the work test period` OF 0, 0, FALSE, TRUE, 3, TRUE, 4) EQUALS NOTHING
#ASSERT `the hours of qualifying work a person is taken to have performed on a day` (`A day in the work test period` OF 0, 0, FALSE, TRUE, 3, TRUE, 3) EQUALS JUST 3
-- an ordinary day: hours of paid work of at least one hour, plus hours of paid leave of at least one hour
#ASSERT `the hours of qualifying work a person is taken to have performed on a day` (`A day in the work test period` OF 7.5, 0, FALSE, FALSE, 0, FALSE, 0) EQUALS JUST 7.5
#ASSERT `the hours of qualifying work a person is taken to have performed on a day` (`A day in the work test period` OF 2, 3, FALSE, FALSE, 0, FALSE, 0) EQUALS JUST 5
#ASSERT `the hours of qualifying work a person is taken to have performed on a day` (`A day in the work test period` OF 0.5, 3, FALSE, FALSE, 0, FALSE, 0) EQUALS JUST 3
#ASSERT `the hours of qualifying work a person is taken to have performed on a day` (`A day in the work test period` OF 0.5, 0.5, FALSE, FALSE, 0, FALSE, 0) EQUALS JUST 0

§ `s 32, 36 -- the method statement`

-- 392 days, each with two hours of paid work: every window of 295 days is a qualifying period with 590 hours
#ASSERT `a person satisfies the work test by the method statement in section 32` FALSE (`the first day of the invented work test period`) FALSE 0 FALSE 0 (replicate 392 (`a day with two hours of paid work`)) EQUALS JUST TRUE
-- the list does not have 392 days: the facts do not cover the work test period
#ASSERT `a person satisfies the work test by the method statement in section 32` FALSE (`the first day of the invented work test period`) FALSE 0 FALSE 0 (replicate 391 (`a day with two hours of paid work`)) EQUALS NOTHING
#ASSERT `a person satisfies the work test by the method statement in section 32` TRUE (`the first day of the invented work test period`) FALSE 0 FALSE 0 (replicate 392 (`a day with two hours of paid work`)) EQUALS NOTHING
-- a COVID-19 affected claimant has 600 days
#ASSERT `a person satisfies the work test by the method statement in section 32` TRUE (`the first day of the invented work test period`) FALSE 0 FALSE 0 (replicate 600 (`a day with two hours of paid work`)) EQUALS JUST TRUE
-- no qualifying work at all
#ASSERT `a person satisfies the work test by the method statement in section 32` FALSE (`the first day of the invented work test period`) FALSE 0 FALSE 0 (replicate 392 (`an idle day`)) EQUALS JUST FALSE
-- step 5: 330 hours in a qualifying period: 35 days of two hours and 260 days of one hour make 330; then 97 idle days that are no permissible break
#ASSERT `a person satisfies the work test by the method statement in section 32` FALSE (`the first day of the invented work test period`) FALSE 0 FALSE 0 (append (replicate 35 (`a day with two hours of paid work`)) (append (replicate 260 (`a day with one hour of paid work`)) (replicate 97 (`an idle day`)))) EQUALS JUST TRUE
#ASSERT `a person satisfies the work test by the method statement in section 32` FALSE (`the first day of the invented work test period`) FALSE 0 FALSE 0 (append (replicate 34 (`a day with two hours of paid work`)) (append (replicate 261 (`a day with one hour of paid work`)) (replicate 97 (`an idle day`)))) EQUALS JUST FALSE
-- section 36(2): a break of 84 days between two qualifying work days is permissible, a break of 85 is not
#ASSERT `a person satisfies the work test by the method statement in section 32` FALSE (`the first day of the invented work test period`) FALSE 0 FALSE 0 (append (replicate 211 (`a day with two hours of paid work`)) (append (replicate 84 (`an idle day`)) (replicate 97 (`a day with two hours of paid work`)))) EQUALS JUST TRUE
#ASSERT `a person satisfies the work test by the method statement in section 32` FALSE (`the first day of the invented work test period`) FALSE 0 FALSE 0 (append (replicate 211 (`a day with one hour of paid work`)) (append (replicate 84 (`an idle day`)) (replicate 97 (`a day with one hour of paid work`)))) EQUALS JUST FALSE
#ASSERT `a person satisfies the work test by the method statement in section 32` FALSE (`the first day of the invented work test period`) FALSE 0 FALSE 0 (append (replicate 211 (`a day with two hours of paid work`)) (append (replicate 85 (`an idle day`)) (replicate 96 (`a day with two hours of paid work`)))) EQUALS JUST FALSE
-- section 36(3): a qualifying work day 1 day before the first day, the next on the 84th day after the earlier one
#ASSERT `a person satisfies the work test by the method statement in section 32` FALSE (`the first day of the invented work test period`) TRUE 1 FALSE 0 (append (replicate 83 (`an idle day`)) (append (replicate 212 (`a day with two hours of paid work`)) (append (replicate 85 (`an idle day`)) (replicate 12 (`a day with two hours of paid work`))))) EQUALS JUST TRUE
#ASSERT `a person satisfies the work test by the method statement in section 32` FALSE (`the first day of the invented work test period`) TRUE 2 FALSE 0 (append (replicate 83 (`an idle day`)) (append (replicate 212 (`a day with two hours of paid work`)) (append (replicate 85 (`an idle day`)) (replicate 12 (`a day with two hours of paid work`))))) EQUALS JUST FALSE
#ASSERT `a person satisfies the work test by the method statement in section 32` FALSE (`the first day of the invented work test period`) FALSE 1 FALSE 0 (append (replicate 83 (`an idle day`)) (append (replicate 212 (`a day with two hours of paid work`)) (append (replicate 85 (`an idle day`)) (replicate 12 (`a day with two hours of paid work`))))) EQUALS JUST FALSE
-- section 36(2) with the later qualifying work day after the period: 1 day after the last day makes a break of 84 days
#ASSERT `a person satisfies the work test by the method statement in section 32` FALSE (`the first day of the invented work test period`) FALSE 0 TRUE 1 (append (replicate 12 (`a day with two hours of paid work`)) (append (replicate 85 (`an idle day`)) (append (replicate 211 (`a day with two hours of paid work`)) (replicate 84 (`an idle day`))))) EQUALS JUST TRUE
#ASSERT `a person satisfies the work test by the method statement in section 32` FALSE (`the first day of the invented work test period`) FALSE 0 TRUE 2 (append (replicate 12 (`a day with two hours of paid work`)) (append (replicate 85 (`an idle day`)) (append (replicate 211 (`a day with two hours of paid work`)) (replicate 84 (`an idle day`))))) EQUALS JUST FALSE
#ASSERT `a person satisfies the work test by the method statement in section 32` FALSE (`the first day of the invented work test period`) FALSE 0 FALSE 1 (append (replicate 12 (`a day with two hours of paid work`)) (append (replicate 85 (`an idle day`)) (append (replicate 211 (`a day with two hours of paid work`)) (replicate 84 (`an idle day`))))) EQUALS JUST FALSE
-- days whose hours the text does not settle (both kinds of payment period, different hours) in a qualifying period with fewer than 330 settled hours
#ASSERT `a person satisfies the work test by the method statement in section 32` FALSE (`the first day of the invented work test period`) FALSE 0 FALSE 0 (append (replicate 295 (`A day in the work test period` OF 0, 0, FALSE, TRUE, 3, TRUE, 4)) (replicate 97 (`an idle day`))) EQUALS NOTHING
-- the same days, but the settled hours alone reach 330 (two days of 330 hours each cannot occur, so the rest of the window carries them)
#ASSERT `a person satisfies the work test by the method statement in section 32` FALSE (`the first day of the invented work test period`) FALSE 0 FALSE 0 (append (replicate 5 (`A day in the work test period` OF 0, 0, FALSE, TRUE, 3, TRUE, 4)) (append (replicate 290 (`A day in the work test period` OF 2, 0, FALSE, FALSE, 0, FALSE, 0)) (replicate 97 (`an idle day`)))) EQUALS JUST TRUE

§ `s 36A, s 36AA, s 32 -- the work test on a day`

-- section 36A(1)(a)(i): the child born prematurely, for the birth mother, a parent who is not the birth mother, or the partner of the birth mother
#ASSERT `a person also satisfies the work test on a day under section 36A` TRUE FALSE FALSE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `a person also satisfies the work test on a day under section 36A` FALSE TRUE FALSE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `a person also satisfies the work test on a day under section 36A` FALSE FALSE TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `a person also satisfies the work test on a day under section 36A` FALSE FALSE FALSE TRUE FALSE TRUE EQUALS JUST FALSE
-- section 36A(1)(a)(ii): complications or illness, for the child's birth mother only
#ASSERT `a person also satisfies the work test on a day under section 36A` TRUE FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `a person also satisfies the work test on a day under section 36A` FALSE TRUE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
-- section 36A(1)(b): the person would have satisfied the work test but for the circumstance
#ASSERT `a person also satisfies the work test on a day under section 36A` TRUE FALSE FALSE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `a person also satisfies the work test on a day under section 36AA` TRUE TRUE EQUALS JUST TRUE
#ASSERT `a person also satisfies the work test on a day under section 36AA` TRUE FALSE EQUALS JUST FALSE
#ASSERT `a person also satisfies the work test on a day under section 36AA` FALSE TRUE EQUALS JUST FALSE
#ASSERT `a person satisfies the work test on a day` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `a person satisfies the work test on a day` (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `a person satisfies the work test on a day` (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `a person satisfies the work test on a day` (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `a person satisfies the work test on a day` NOTHING (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `a person satisfies the work test on a day` NOTHING (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE

§ `s 33(1A), (1B), 34(2) -- application and paid leave`

#ASSERT `section 33 applies to a claimant` FALSE EQUALS JUST TRUE
#ASSERT `section 33 applies to a claimant` TRUE EQUALS NOTHING
#ASSERT `section 33 applies to the first person as if they were the claimant` TRUE EQUALS JUST TRUE
#ASSERT `section 33 applies to the first person as if they were the claimant` FALSE EQUALS NOTHING
-- the PPL rules may prescribe what is, or is not, taken to be paid leave
#ASSERT `a period of leave is paid leave` TRUE NOTHING EQUALS JUST TRUE
#ASSERT `a period of leave is paid leave` FALSE NOTHING EQUALS JUST FALSE
#ASSERT `a period of leave is paid leave` FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `a period of leave is paid leave` TRUE (JUST FALSE) EQUALS JUST FALSE
