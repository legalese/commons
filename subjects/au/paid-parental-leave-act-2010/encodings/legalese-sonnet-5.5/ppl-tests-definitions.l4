IMPORT prelude
IMPORT daydate
IMPORT `ppl-time`
IMPORT `ppl-nouns`
IMPORT `ppl-definitions`

-- Every expected value is written from the Dictionary entry named beside it.

§ `s 6 -- the table of entries the in-scope text uses`

#ASSERT `the entry in the table for` "adjusted taxable income" EQUALS JUST (`the Dictionary entry for adjusted taxable income`)
#ASSERT (`the Dictionary entry for adjusted taxable income`)'s kind EQUALS SeeProvision
#ASSERT (`the Dictionary entry for adjusted taxable income`)'s `points to or borrows from` EQUALS "section 38"
#ASSERT (`the Dictionary entry for Australian residency test`)'s kind EQUALS SeeProvision
#ASSERT (`the Dictionary entry for Australian resident`)'s kind EQUALS SameMeaningAsInAnotherAct
#ASSERT (`the Dictionary entry for Social Security Act`)'s kind EQUALS NamesAnAct
#ASSERT (`the Dictionary entry for PPL`)'s kind EQUALS ShortFor
#ASSERT (`the Dictionary entry for claim`)'s kind EQUALS DefinedInTheDictionary
#ASSERT (`the Dictionary entry for employee`)'s kind EQUALS OrdinaryMeaningWith
#ASSERT `the entry in the table for` "a term the Dictionary does not define" EQUALS NOTHING

§ `s 6 -- born prematurely, stillborn`

#ASSERT `a child is born prematurely` 36 EQUALS JUST TRUE
#ASSERT `a child is born prematurely` 37 EQUALS JUST FALSE
#ASSERT `a child is stillborn` 400 10 FALSE FALSE EQUALS JUST TRUE
#ASSERT `a child is stillborn` 399 19 FALSE FALSE EQUALS JUST FALSE
#ASSERT `a child is stillborn` 399 20 FALSE FALSE EQUALS JUST TRUE
#ASSERT `a child is stillborn` 400 10 TRUE FALSE EQUALS JUST FALSE
#ASSERT `a child is stillborn` 400 10 FALSE TRUE EQUALS JUST FALSE

§ `s 6 -- parent`

-- a relationship record is: child adopted, artificial conception, surrogacy, adoptive parent, parent under Family Law Act s 60H, s 60HB, parent in the ordinary sense, ...
`an adopted child's adoptive parent` MEANS `The parental relationship` OF TRUE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`an adopted child's other adult` MEANS `The parental relationship` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`a parent under section 60H` MEANS `The parental relationship` OF FALSE, TRUE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`not a parent under section 60H` MEANS `The parental relationship` OF FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE
`a parent under section 60HB` MEANS `The parental relationship` OF FALSE, FALSE, TRUE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE
`a surrogacy arrangement without section 60HB` MEANS `The parental relationship` OF FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE
`a parent in the ordinary sense` MEANS `The parental relationship` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE
`no relationship` MEANS `The parental relationship` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE

#ASSERT `the person is a parent of the child under the Dictionary` (`an adopted child's adoptive parent`) EQUALS JUST TRUE
#ASSERT `the person is a parent of the child under the Dictionary` (`an adopted child's other adult`) EQUALS JUST FALSE
#ASSERT `the person is a parent of the child under the Dictionary` (`a parent under section 60H`) EQUALS JUST TRUE
#ASSERT `the person is a parent of the child under the Dictionary` (`not a parent under section 60H`) EQUALS JUST FALSE
#ASSERT `the person is a parent of the child under the Dictionary` (`a parent under section 60HB`) EQUALS JUST TRUE
-- "includes": a surrogacy arrangement without section 60HB, or a child neither adopted nor conceived by procedure nor born by arrangement: the Dictionary does not say
#ASSERT `the person is a parent of the child under the Dictionary` (`a surrogacy arrangement without section 60HB`) EQUALS NOTHING
#ASSERT `the person is a parent of the child under the Dictionary` (`a parent in the ordinary sense`) EQUALS NOTHING
#ASSERT `the person is a parent of the child, taking the ordinary sense where the Dictionary gives none` (`a parent in the ordinary sense`)
#ASSERT NOT `the person is a parent of the child, taking the ordinary sense where the Dictionary gives none` (`no relationship`)
#ASSERT `the person is a parent of the child, taking the ordinary sense where the Dictionary gives none` (`an adopted child's adoptive parent`)
#ASSERT NOT `the person is a parent of the child, taking the ordinary sense where the Dictionary gives none` (`an adopted child's other adult`)

§ `s 6 -- business, entity, claim, claimant`

#ASSERT `an occupation is a business` Profession EQUALS JUST TRUE
#ASSERT `an occupation is a business` Trade EQUALS JUST TRUE
#ASSERT `an occupation is a business` Employment EQUALS JUST TRUE
#ASSERT `an occupation is a business` Vocation EQUALS JUST TRUE
#ASSERT `an occupation is a business` Calling EQUALS JUST TRUE
#ASSERT `an occupation is a business` `Occupation as an employee` EQUALS JUST FALSE
#ASSERT `an occupation is a business` `Any other occupation` EQUALS NOTHING
#ASSERT `a party is an entity` `A natural person` EQUALS JUST TRUE
#ASSERT `a party is an entity` `A body corporate` EQUALS JUST TRUE
#ASSERT `a party is an entity` `A partnership` EQUALS JUST TRUE
#ASSERT `a party is an entity` `A trust` EQUALS JUST TRUE
#ASSERT `a party is an entity` `Any other kind of party` EQUALS JUST FALSE
#ASSERT `a request is a claim` TRUE FALSE EQUALS JUST TRUE
#ASSERT `a request is a claim` FALSE TRUE EQUALS JUST TRUE
#ASSERT `a request is a claim` FALSE FALSE EQUALS JUST FALSE
#ASSERT `a person is a claimant` TRUE FALSE EQUALS JUST TRUE
#ASSERT `a person is a claimant` FALSE TRUE EQUALS JUST TRUE
#ASSERT `a person is a claimant` FALSE FALSE EQUALS JUST FALSE
#ASSERT `a person is a PPL claimant` TRUE EQUALS JUST TRUE
#ASSERT `a person is a PPL claimant` FALSE EQUALS JUST FALSE
#ASSERT `a person is a special PPL claimant` TRUE TRUE EQUALS JUST TRUE
#ASSERT `a person is a special PPL claimant` TRUE FALSE EQUALS JUST FALSE
#ASSERT `a person is a special PPL claimant` FALSE TRUE EQUALS JUST FALSE
#ASSERT `a claim is an effective claim` TRUE TRUE EQUALS JUST TRUE
#ASSERT `a claim is an effective claim` TRUE FALSE EQUALS JUST FALSE
#ASSERT `a claim is an effective claim` FALSE TRUE EQUALS JUST FALSE

§ `s 6 -- determinations`

#ASSERT `a determination is a conditional eligibility determination` TRUE FALSE EQUALS JUST TRUE
#ASSERT `a determination is a conditional eligibility determination` FALSE TRUE EQUALS JUST TRUE
#ASSERT `a determination is a conditional eligibility determination` FALSE FALSE EQUALS JUST FALSE
#ASSERT `a determination is a payability determination` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `a determination is a payability determination` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `a determination is a payability determination` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `a determination is a payability determination` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `a person has not previously satisfied the work and income tests in relation to a child` FALSE FALSE EQUALS JUST TRUE
#ASSERT `a person has not previously satisfied the work and income tests in relation to a child` TRUE FALSE EQUALS JUST FALSE
#ASSERT `a person has not previously satisfied the work and income tests in relation to a child` FALSE TRUE EQUALS JUST FALSE
#ASSERT `a claim is made in exceptional circumstances` TRUE FALSE EQUALS JUST TRUE
#ASSERT `a claim is made in exceptional circumstances` FALSE TRUE EQUALS JUST TRUE
#ASSERT `a claim is made in exceptional circumstances` FALSE FALSE EQUALS JUST FALSE

§ `s 6 -- COVID-19 affected claimant`

-- the child born on 22 March 2020, the work test applies, working hours reduced, and the person would not satisfy the work test with the usual period
#ASSERT `a person is a COVID-19 affected claimant` (JUST (Date 22 3 2020)) FALSE (Date 1 4 2020) TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `a person is a COVID-19 affected claimant` (JUST (Date 21 3 2020)) FALSE (Date 1 4 2020) TRUE TRUE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `a person is a COVID-19 affected claimant` (JUST (Date 31 3 2021)) FALSE (Date 1 4 2020) TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `a person is a COVID-19 affected claimant` (JUST (Date 1 4 2021)) FALSE (Date 1 4 2020) TRUE TRUE FALSE FALSE TRUE EQUALS JUST FALSE
-- not yet born, the claim made before the birth, the child expected in the period
#ASSERT `a person is a COVID-19 affected claimant` NOTHING TRUE (Date 22 3 2020) TRUE FALSE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `a person is a COVID-19 affected claimant` NOTHING TRUE (Date 21 3 2020) TRUE FALSE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `a person is a COVID-19 affected claimant` NOTHING TRUE (Date 1 4 2021) TRUE FALSE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `a person is a COVID-19 affected claimant` NOTHING FALSE (Date 1 4 2020) TRUE FALSE TRUE FALSE TRUE EQUALS JUST FALSE
-- the work test does not apply, no circumstance applies, or the person would satisfy the work test anyway
#ASSERT `a person is a COVID-19 affected claimant` (JUST (Date 22 3 2020)) FALSE (Date 1 4 2020) FALSE TRUE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `a person is a COVID-19 affected claimant` (JUST (Date 22 3 2020)) FALSE (Date 1 4 2020) TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `a person is a COVID-19 affected claimant` (JUST (Date 22 3 2020)) FALSE (Date 1 4 2020) TRUE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `a person is a COVID-19 affected claimant` (JUST (Date 22 3 2020)) FALSE (Date 1 4 2020) TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE

§ `s 6 -- employee, employer, vocational placement, this Act, the Secretary`

#ASSERT `a person is an employee` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `a person is an employee` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `a person is an employee` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `a person is an employee` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `a person is an employer` TRUE FALSE EQUALS JUST TRUE
#ASSERT `a person is an employer` FALSE TRUE EQUALS JUST TRUE
#ASSERT `a person is an employer` FALSE FALSE EQUALS NOTHING
#ASSERT `a placement is a vocational placement` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `a placement is a vocational placement` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `a placement is a vocational placement` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `an instrument is part of this Act` `This Act as made and amended` EQUALS JUST TRUE
#ASSERT `an instrument is part of this Act` `The PPL rules` EQUALS JUST TRUE
#ASSERT `an instrument is part of this Act` `The regulations` EQUALS JUST TRUE
#ASSERT `an instrument is part of this Act` `Any other instrument` EQUALS NOTHING
#ASSERT `the rules are the PPL rules` TRUE EQUALS JUST TRUE
#ASSERT `the rules are the PPL rules` FALSE EQUALS JUST FALSE
#ASSERT `a person is the Secretary` TRUE EQUALS JUST TRUE
#ASSERT `a person is the Secretary` FALSE EQUALS JUST FALSE
#ASSERT `a payment is an instalment` TRUE EQUALS JUST TRUE
#ASSERT `a payment is an instalment` FALSE EQUALS JUST FALSE
#ASSERT `a payment is parental leave pay` TRUE EQUALS JUST TRUE
#ASSERT `a payment is parental leave pay` FALSE EQUALS JUST FALSE
