IMPORT prelude
IMPORT daydate
IMPORT `ppl-logic`
IMPORT `ppl-time`
IMPORT `ppl-nouns`
IMPORT `ppl-eligibility`

-- Every expected value is written from the section named beside it.
-- The child below is born on 15 March 2024, before 1 July 2024: the total limit is 100 flexible PPL days and the partnered claimant limit is 90 (section 31ABA).

`the invented birth date` MEANS Date 15 3 2024

-- a claimant who is eligible under the main rule: residency, caring, no paid work, both tests met, residency on the birth day, nothing else
`a claimant eligible under the main rule` MEANS
    `The claimant's facts on a flexible PPL day` OF
        TRUE, TRUE, 0, TRUE, (JUST TRUE), (JUST TRUE), TRUE, FALSE, FALSE,
        FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE,
        0, 0, 0, FALSE, FALSE, FALSE, 0

§ `s 31AA(2) -- the main eligibility rule`

#ASSERT `a person is eligible under the main eligibility rule` (`a claimant eligible under the main rule`) EQUALS JUST TRUE
#ASSERT `a person is eligible under the main eligibility rule` (`The claimant's facts on a flexible PPL day` OF FALSE, TRUE, 0, TRUE, (JUST TRUE), (JUST TRUE), TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, 0, 0, 0, FALSE, FALSE, FALSE, 0) EQUALS JUST FALSE
#ASSERT `a person is eligible under the main eligibility rule` (`The claimant's facts on a flexible PPL day` OF TRUE, FALSE, 0, TRUE, (JUST TRUE), (JUST TRUE), TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, 0, 0, 0, FALSE, FALSE, FALSE, 0) EQUALS JUST FALSE
-- (c): no more than one hour of paid work
#ASSERT `a person is eligible under the main eligibility rule` (`The claimant's facts on a flexible PPL day` OF TRUE, TRUE, 1, TRUE, (JUST TRUE), (JUST TRUE), TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, 0, 0, 0, FALSE, FALSE, FALSE, 0) EQUALS JUST TRUE
#ASSERT `a person is eligible under the main eligibility rule` (`The claimant's facts on a flexible PPL day` OF TRUE, TRUE, 1.5, TRUE, (JUST TRUE), (JUST TRUE), TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, 0, 0, 0, FALSE, FALSE, FALSE, 0) EQUALS JUST FALSE
-- (d): the work test and the income test, if not previously satisfied
#ASSERT `a person is eligible under the main eligibility rule` (`The claimant's facts on a flexible PPL day` OF TRUE, TRUE, 0, TRUE, (JUST FALSE), (JUST TRUE), TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, 0, 0, 0, FALSE, FALSE, FALSE, 0) EQUALS JUST FALSE
#ASSERT `a person is eligible under the main eligibility rule` (`The claimant's facts on a flexible PPL day` OF TRUE, TRUE, 0, TRUE, (JUST TRUE), (JUST FALSE), TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, 0, 0, 0, FALSE, FALSE, FALSE, 0) EQUALS JUST FALSE
#ASSERT `a person is eligible under the main eligibility rule` (`The claimant's facts on a flexible PPL day` OF TRUE, TRUE, 0, TRUE, NOTHING, (JUST TRUE), TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, 0, 0, 0, FALSE, FALSE, FALSE, 0) EQUALS NOTHING
#ASSERT `a person is eligible under the main eligibility rule` (`The claimant's facts on a flexible PPL day` OF TRUE, TRUE, 0, FALSE, (JUST FALSE), (JUST TRUE), TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, 0, 0, 0, FALSE, FALSE, FALSE, 0) EQUALS JUST TRUE
-- (e): the birth day
#ASSERT `a person is eligible under the main eligibility rule` (`The claimant's facts on a flexible PPL day` OF TRUE, TRUE, 0, TRUE, (JUST TRUE), (JUST TRUE), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, 0, 0, 0, FALSE, FALSE, FALSE, 0) EQUALS JUST FALSE
#ASSERT `a person is eligible under the main eligibility rule` (`The claimant's facts on a flexible PPL day` OF TRUE, TRUE, 0, TRUE, (JUST TRUE), (JUST TRUE), TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, 0, 0, 0, FALSE, FALSE, FALSE, 0) EQUALS JUST FALSE
#ASSERT `a person is eligible under the main eligibility rule` (`The claimant's facts on a flexible PPL day` OF TRUE, TRUE, 0, TRUE, (JUST TRUE), (JUST TRUE), TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, 0, 0, 0, FALSE, FALSE, FALSE, 0) EQUALS JUST TRUE

