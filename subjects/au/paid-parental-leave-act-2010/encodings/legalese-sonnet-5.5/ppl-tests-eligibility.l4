§ `s 31A -- the newly arrived resident's waiting period`

#ASSERT `a person is subject to a newly arrived resident's waiting period under subsection 31A(1)` TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `a person is subject to a newly arrived resident's waiting period under subsection 31A(1)` TRUE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `a person is subject to a newly arrived resident's waiting period under subsection 31A(1)` TRUE FALSE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `a person is subject to a newly arrived resident's waiting period under subsection 31A(1)` TRUE FALSE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `a person is subject to a newly arrived resident's waiting period under subsection 31A(1)` TRUE TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `a person is subject to a newly arrived resident's waiting period under subsection 31A(1)` FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `a person is subject to a newly arrived resident's waiting period under subsection 31A(1)` TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- subsections (2) to (4): when each starts the period
#ASSERT `the day a newly arrived resident's waiting period starts` FALSE TRUE TRUE (Date 1 1 2020) (Date 5 5 2019) (Date 10 2 2020) (Date 1 3 2020) EQUALS NOTHING
#ASSERT `the day a newly arrived resident's waiting period starts` TRUE TRUE TRUE (Date 1 1 2020) (Date 5 5 2019) (Date 10 2 2020) (Date 1 3 2020) EQUALS JUST (Date 5 5 2019)
#ASSERT `the day a newly arrived resident's waiting period starts` TRUE TRUE FALSE (Date 1 1 2020) (Date 5 5 2019) (Date 10 2 2020) (Date 1 3 2020) EQUALS JUST (Date 1 1 2020)
#ASSERT `the day a newly arrived resident's waiting period starts` TRUE FALSE TRUE (Date 1 1 2020) (Date 5 5 2019) (Date 10 2 2020) (Date 1 3 2020) EQUALS JUST (Date 5 5 2019)
#ASSERT `the day a newly arrived resident's waiting period starts` TRUE FALSE FALSE (Date 1 1 2020) (Date 5 5 2019) (Date 10 2 2020) (Date 1 3 2020) EQUALS JUST (Date 1 3 2020)
-- subsection (6A): claimed, receiving something on the day before, and on the day the child was born
#ASSERT `subsection 31A(1) does not apply under subsection 31A(6A) for a flexible PPL day` TRUE TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `subsection 31A(1) does not apply under subsection 31A(6A) for a flexible PPL day` FALSE TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `subsection 31A(1) does not apply under subsection 31A(6A) for a flexible PPL day` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `subsection 31A(1) does not apply under subsection 31A(6A) for a flexible PPL day` TRUE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `subsection 31A(1) does not apply under subsection 31A(6A) for a flexible PPL day` TRUE FALSE FALSE FALSE TRUE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- subsection (6B): a period of at least 10 consecutive week days, receiving something before the start and on the birth day
#ASSERT `subsection 31A(1) does not apply under subsection 31A(6B) to a period` TRUE TRUE TRUE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `subsection 31A(1) does not apply under subsection 31A(6B) to a period` FALSE TRUE TRUE FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `subsection 31A(1) does not apply under subsection 31A(6B) to a period` TRUE FALSE TRUE FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `subsection 31A(1) does not apply under subsection 31A(6B) to a period` TRUE TRUE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `subsection 31A(1) does not apply under subsection 31A(6B) to a period` TRUE TRUE FALSE FALSE TRUE FALSE FALSE TRUE EQUALS JUST TRUE
-- the claimed days: Friday 1 March 2024, Monday 4 March, Tuesday 5 March are consecutive week days
#ASSERT `every day claimed is a flexible PPL day that is a week day and follows the one before` (Date 1 3 2024) (Date 1 3 2024) (LIST (Date 4 3 2024), (Date 5 3 2024))
#ASSERT NOT `every day claimed is a flexible PPL day that is a week day and follows the one before` (Date 1 3 2024) (Date 1 3 2024) (LIST (Date 2 3 2024), (Date 4 3 2024))
#ASSERT NOT `every day claimed is a flexible PPL day that is a week day and follows the one before` (Date 1 3 2024) (Date 1 3 2024) (LIST (Date 5 3 2024))
#ASSERT NOT `every day claimed is a flexible PPL day that is a week day and follows the one before` (Date 1 3 2024) (Date 4 3 2024) (LIST (Date 5 3 2024))
#ASSERT `every day claimed is a flexible PPL day that is a week day and follows the one before` (Date 4 3 2024) (Date 1 3 2024) (LIST (Date 5 3 2024))
#ASSERT `the next week day after a day` (Date 1 3 2024) EQUALS Date 4 3 2024
#ASSERT `the next week day after a day` (Date 4 3 2024) EQUALS Date 5 3 2024
-- subsection (7): the day the person holds, or is the former holder of, a visa of the class determined for subsection 739A(6)
#ASSERT `subsection 31AB(8) does not apply under subsection 31A(7) to a day` TRUE EQUALS JUST TRUE
#ASSERT `subsection 31AB(8) does not apply under subsection 31A(7) to a day` FALSE EQUALS JUST FALSE
-- subsection (7A): refugee, family of a refugee, citizen, or special category visa holder residing in Australia
#ASSERT `subsection 31AB(8) does not apply under subsection 31A(7A) to a day` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `subsection 31AB(8) does not apply under subsection 31A(7A) to a day` FALSE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `subsection 31AB(8) does not apply under subsection 31A(7A) to a day` FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `subsection 31AB(8) does not apply under subsection 31A(7A) to a day` FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `subsection 31AB(8) does not apply under subsection 31A(7A) to a day` FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `subsection 31AB(8) does not apply under subsection 31A(7A) to a day` FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `subsection 31AB(8) does not apply under subsection 31A(7A) to a day` FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE

-- subsection (8): where the meanings of the terms in subsection (7A) come from
#ASSERT `the provision of the Social Security Act that gives the meaning of a term in subsection 31A(7A)` `family member` EQUALS "subsection 7(6D) of the Social Security Act"
#ASSERT `the provision of the Social Security Act that gives the meaning of a term in subsection 31A(7A)` `former refugee` EQUALS "subsection 7(1) of the Social Security Act"
#ASSERT `the provision of the Social Security Act that gives the meaning of a term in subsection 31A(7A)` refugee EQUALS "subsection 7(6B) of the Social Security Act"

