#ASSERT `a person is eligible when they meet prescribed conditions and are not a special PPL claimant in exceptional circumstances` (`a claimant eligible under the main rule`) EQUALS JUST FALSE
#ASSERT `a person is eligible when they meet prescribed conditions and are not a special PPL claimant in exceptional circumstances` (`The claimant's facts on a flexible PPL day` OF TRUE, TRUE, 0, TRUE, (JUST TRUE), (JUST TRUE), TRUE, FALSE, FALSE, FALSE, FALSE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, 0, 0, 0, FALSE, FALSE, FALSE, 0) EQUALS JUST FALSE
#ASSERT `a person is eligible when they meet prescribed conditions and are a special PPL claimant in exceptional circumstances` (`The claimant's facts on a flexible PPL day` OF TRUE, TRUE, 0, TRUE, (JUST TRUE), (JUST TRUE), TRUE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, 0, 0, 0, FALSE, FALSE, FALSE, 0) EQUALS JUST TRUE
