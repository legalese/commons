§ `s 31AB(1), s 31AA(1) -- not eligible, and eligible`

#ASSERT `a person is not eligible on a flexible PPL day under section 31AB` (`the invented birth date`) (`a claimant eligible under the main rule`) EQUALS JUST FALSE
#ASSERT `a person is not eligible on a flexible PPL day under section 31AB` (`the invented birth date`) (`The claimant's facts on a flexible PPL day` OF TRUE, TRUE, 0, TRUE, (JUST TRUE), (JUST TRUE), TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, 0, 0, 0, TRUE, FALSE, FALSE, 0) EQUALS JUST TRUE
#ASSERT `a person is not eligible on a flexible PPL day under section 31AB` (`the invented birth date`) (`The claimant's facts on a flexible PPL day` OF TRUE, TRUE, 0, TRUE, (JUST TRUE), (JUST TRUE), TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, 100, 0, 0, FALSE, FALSE, FALSE, 0) EQUALS JUST TRUE
#ASSERT `a person is eligible for parental leave pay on a flexible PPL day for a child` (`the invented birth date`) (`a claimant eligible under the main rule`) EQUALS JUST TRUE
#ASSERT `a person is eligible for parental leave pay on a flexible PPL day for a child` (`the invented birth date`) (`The claimant's facts on a flexible PPL day` OF TRUE, TRUE, 0, TRUE, (JUST TRUE), (JUST TRUE), TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, 0, 0, 0, TRUE, FALSE, FALSE, 0) EQUALS JUST FALSE
#ASSERT `a person is eligible for parental leave pay on a flexible PPL day for a child` (`the invented birth date`) (`The claimant's facts on a flexible PPL day` OF TRUE, TRUE, 0, TRUE, (JUST TRUE), (JUST TRUE), TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, 100, 0, 0, FALSE, FALSE, FALSE, 0) EQUALS JUST FALSE
