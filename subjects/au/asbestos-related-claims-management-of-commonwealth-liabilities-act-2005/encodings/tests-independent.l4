IMPORT prelude
IMPORT daydate
IMPORT `arc-rules`

-- Independent tests, written from the source text and BRIEF.md only.
-- Expected values come from independent-expectations.md and were not
-- adjusted to the code.

GIVEN cond IS A `Condition`
      who IS A `Who breached the duty`
      src IS A `Source of liability`
      agst IS A `Claim made against`
      dt IS A DATE
      decl IS A BOOLEAN
GIVETH A `Asbestos position`
`pos` cond who src agst dt decl MEANS
    `the asbestos position for` (`Asbestos case` OF cond, who, src, agst, dt, decl)

`breach` MEANS `the breach of duty, not yet settled or finally decided`
`cth` MEANS `the Commonwealth`
`auth` MEANS `a Commonwealth authority at the time of the breach`
`excl` MEANS `Comcare, Australia Post, Telstra, a body declared not to be an authority, or their subsidiary`
`cthOrAuth` MEANS `the Commonwealth or the authority`

-- 1: s 5(1), claim before commencement -> Comcare on 26 Oct 2005
`s1` MEANS `pos` `mesothelioma` `cth` `breach` `cthOrAuth` (Date 25 10 2005) FALSE
#ASSERT `s1`'s `mine is an asbestos-related claim` EQUALS TRUE
#ASSERT `s1`'s `I may claim against Comcare` EQUALS TRUE
#ASSERT `s1`'s `who is liable to me` EQUALS `Comcare`
#ASSERT `s1`'s `the liability passed to Comcare on` EQUALS JUST (Date 26 10 2005)

-- 2: s 5(1), claim on commencement day
`s2` MEANS `pos` `asbestosis` `cth` `breach` `cthOrAuth` (Date 26 10 2005) FALSE
#ASSERT `s2`'s `who is liable to me` EQUALS `Comcare`
#ASSERT `s2`'s `the liability passed to Comcare on` EQUALS JUST (Date 26 10 2005)

-- 3: s 5(2), claim the day after commencement
`s3` MEANS `pos` `asbestosis` `cth` `breach` `cthOrAuth` (Date 27 10 2005) FALSE
#ASSERT `s3`'s `who is liable to me` EQUALS `Comcare`
#ASSERT `s3`'s `the liability passed to Comcare on` EQUALS JUST (Date 27 10 2005)

-- 4: s 5(3), claim against Comcare in 2010, authority breach
`s4` MEANS `pos` `an asbestos-induced carcinoma` `auth` `breach` `Comcare` (Date 1 3 2010) FALSE
#ASSERT `s4`'s `mine is an asbestos-related claim` EQUALS TRUE
#ASSERT `s4`'s `I may claim against Comcare` EQUALS TRUE
#ASSERT `s4`'s `who is liable to me` EQUALS `Comcare`
#ASSERT `s4`'s `the liability passed to Comcare on` EQUALS JUST (Date 1 3 2010)

-- 5: no claim yet: nothing transferred
`s5` MEANS `pos` `an asbestos-related non-malignant pleural disease` `cth` `breach` `no one yet` (Date 1 1 2020) FALSE
#ASSERT `s5`'s `mine is an asbestos-related claim` EQUALS TRUE
#ASSERT `s5`'s `I may claim against Comcare` EQUALS TRUE
#ASSERT `s5`'s `who is liable to me` EQUALS `the Commonwealth or the authority, as before`
#ASSERT `s5`'s `the liability passed to Comcare on` EQUALS NOTHING

-- 6: s 3(1) condition (e)
`s6` MEANS `pos` `another condition caused by exposure to asbestos` `cth` `breach` `cthOrAuth` (Date 1 1 2007) FALSE
#ASSERT `s6`'s `mine is an asbestos-related claim` EQUALS TRUE
#ASSERT `s6`'s `the liability passed to Comcare on` EQUALS JUST (Date 1 1 2007)

-- 7: not an asbestos condition
`s7` MEANS `pos` `a condition not caused by asbestos` `cth` `breach` `cthOrAuth` (Date 1 1 2007) FALSE
#ASSERT `s7`'s `mine is an asbestos-related claim` EQUALS FALSE
#ASSERT `s7`'s `I may claim against Comcare` EQUALS FALSE
#ASSERT `s7`'s `who is liable to me` EQUALS `not affected by this Act`
#ASSERT `s7`'s `the liability passed to Comcare on` EQUALS NOTHING

-- 8: excluded body (s 3(1) authority (d)-(h))
`s8` MEANS `pos` `mesothelioma` `excl` `breach` `cthOrAuth` (Date 1 1 2007) FALSE
#ASSERT `s8`'s `mine is an asbestos-related claim` EQUALS FALSE
#ASSERT `s8`'s `I may claim against Comcare` EQUALS FALSE
#ASSERT `s8`'s `who is liable to me` EQUALS `not affected by this Act`

-- 9: someone else
`s9` MEANS `pos` `mesothelioma` `someone else` `breach` `cthOrAuth` (Date 1 1 2007) FALSE
#ASSERT `s9`'s `mine is an asbestos-related claim` EQUALS FALSE
#ASSERT `s9`'s `I may claim against Comcare` EQUALS FALSE

-- 10: liability under contract of insurance: still an asbestos-related claim,
-- may still claim against Comcare under s 5(3)(a), but no transfer
`s10` MEANS `pos` `mesothelioma` `cth` `a contract of insurance` `cthOrAuth` (Date 1 1 2007) FALSE
#ASSERT `s10`'s `mine is an asbestos-related claim` EQUALS TRUE
#ASSERT `s10`'s `I may claim against Comcare` EQUALS TRUE
#ASSERT `s10`'s `who is liable to me` EQUALS `not affected by this Act`
#ASSERT `s10`'s `the liability passed to Comcare on` EQUALS NOTHING

-- 11: final judgment at commencement
`s11` MEANS `pos` `mesothelioma` `cth` `a judgment not stayed or under appeal on 26 October 2005` `cthOrAuth` (Date 1 1 2005) FALSE
#ASSERT `s11`'s `mine is an asbestos-related claim` EQUALS TRUE
#ASSERT `s11`'s `I may claim against Comcare` EQUALS TRUE
#ASSERT `s11`'s `who is liable to me` EQUALS `not affected by this Act`
#ASSERT `s11`'s `the liability passed to Comcare on` EQUALS NOTHING

-- 12: written settlement before commencement
`s12` MEANS `pos` `mesothelioma` `cth` `a written settlement made before 26 October 2005` `cthOrAuth` (Date 1 1 2005) FALSE
#ASSERT `s12`'s `mine is an asbestos-related claim` EQUALS TRUE
#ASSERT `s12`'s `who is liable to me` EQUALS `not affected by this Act`
#ASSERT `s12`'s `the liability passed to Comcare on` EQUALS NOTHING

-- 13: s 6, authority liability transferred back
`s13` MEANS `pos` `mesothelioma` `auth` `breach` `cthOrAuth` (Date 1 1 2007) TRUE
#ASSERT `s13`'s `who is liable to me` EQUALS `the authority or its successor, after the Minister's declaration`

-- 14: s 6 cannot reach a Commonwealth liability
`s14` MEANS `pos` `mesothelioma` `cth` `breach` `cthOrAuth` (Date 1 1 2007) TRUE
#ASSERT `s14`'s `who is liable to me` EQUALS `Comcare`
#ASSERT `s14`'s `the liability passed to Comcare on` EQUALS JUST (Date 1 1 2007)

-- 15: s 5(2), authority, no declaration
`s15` MEANS `pos` `mesothelioma` `auth` `breach` `cthOrAuth` (Date 1 1 2007) FALSE
#ASSERT `s15`'s `who is liable to me` EQUALS `Comcare`
#ASSERT `s15`'s `the liability passed to Comcare on` EQUALS JUST (Date 1 1 2007)

-- 16: claim against Comcare before Part 2 commenced: s 5(3) applies only
-- on or after commencement, and s 5(1) covers claims against the
-- Commonwealth or an authority, not Comcare
`s16` MEANS `pos` `mesothelioma` `cth` `breach` `Comcare` (Date 1 10 2005) FALSE
#ASSERT `s16`'s `who is liable to me` EQUALS `the Commonwealth or the authority, as before`
#ASSERT `s16`'s `the liability passed to Comcare on` EQUALS NOTHING
