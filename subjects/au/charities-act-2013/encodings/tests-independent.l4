IMPORT prelude
IMPORT `charities-rules`

-- Independent tests, from independent-expectations.md (written before reading the rules).
-- Purpose fields: kind, found for the public benefit (6(1) both limbs),
--   achievement would be of public benefit (6(1)(a)), evidence to the contrary.
-- Entity fields: kind, not-for-profit, s 10 self-help group / contemplative order, purposes.

§ `Independent tests`

GIVEN ps IS A LIST OF `Purpose`
GIVETH A `Entity`
org ps MEANS `Entity` OF `an organisation`, TRUE, FALSE, ps

GIVEN ps IS A LIST OF `Purpose`
GIVETH A `Entity`
selfHelp ps MEANS `Entity` OF `an organisation`, TRUE, TRUE, ps

pEdu MEANS `Purpose` OF `advancing education`, FALSE, FALSE, FALSE
pEduContraNoPB MEANS `Purpose` OF `advancing education`, FALSE, FALSE, TRUE
pReligionContraPB MEANS `Purpose` OF `advancing religion`, TRUE, TRUE, TRUE
pReligionContraNoPB MEANS `Purpose` OF `advancing religion`, FALSE, FALSE, TRUE
pPoverty MEANS `Purpose` OF `relieving poverty, distress or disadvantage`, FALSE, FALSE, FALSE
pHealthPB MEANS `Purpose` OF `preventing or relieving sickness, disease or human suffering`, TRUE, TRUE, FALSE
-- s 12(1)(e) culture, (i) animals, (l) advocacy, (c) social welfare: all "another charitable purpose"
pCulturePB MEANS `Purpose` OF `another charitable purpose under s 12(1)`, TRUE, TRUE, FALSE
pCultureNoPB MEANS `Purpose` OF `another charitable purpose under s 12(1)`, FALSE, FALSE, FALSE
pAdvocacyEnvPB MEANS `Purpose` OF `another charitable purpose under s 12(1)`, TRUE, TRUE, FALSE
pAnimalsPB MEANS `Purpose` OF `another charitable purpose under s 12(1)`, TRUE, TRUE, FALSE
pWelfareNoPB MEANS `Purpose` OF `another charitable purpose under s 12(1)`, FALSE, FALSE, FALSE
pIncidental MEANS `Purpose` OF `incidental or ancillary to a charitable purpose`, FALSE, FALSE, FALSE
pCommercial MEANS `Purpose` OF `a purpose that is none of these`, FALSE, FALSE, FALSE
pPolitical MEANS `Purpose` OF `a disqualifying purpose`, FALSE, FALSE, FALSE
pUnlawful MEANS `Purpose` OF `a disqualifying purpose`, FALSE, FALSE, FALSE
pNeedyA MEANS `Purpose` OF `relieving necessitous circumstances of individuals in Australia`, FALSE, TRUE, FALSE
pNeedyNoA MEANS `Purpose` OF `relieving necessitous circumstances of individuals in Australia`, FALSE, FALSE, FALSE

-- 1: education, presumed
#ASSERT `we are a charity` (org (LIST pEdu)) EQUALS TRUE
-- 2: not not-for-profit
#ASSERT `we are a charity` (`Entity` OF `an organisation`, FALSE, FALSE, (LIST pEdu)) EQUALS FALSE
-- 3: individual
#ASSERT `we are a charity` (`Entity` OF `an individual`, TRUE, FALSE, (LIST pEdu)) EQUALS FALSE
-- 4: political party
#ASSERT `we are a charity` (`Entity` OF `a political party`, TRUE, FALSE, (LIST pEdu)) EQUALS FALSE
-- 5: government entity
#ASSERT `we are a charity` (`Entity` OF `a government entity`, TRUE, FALSE, (LIST pEdu)) EQUALS FALSE
-- 6: culture with public benefit found
#ASSERT `we are a charity` (org (LIST pCulturePB)) EQUALS TRUE
-- 7: culture, no public benefit finding
#ASSERT `we are a charity` (org (LIST pCultureNoPB)) EQUALS FALSE
-- 8: education, evidence to the contrary, 6(1) not met
#ASSERT `we are a charity` (org (LIST pEduContraNoPB)) EQUALS FALSE
-- 9: religion, evidence to the contrary, but 6(1) met
#ASSERT `we are a charity` (org (LIST pReligionContraPB)) EQUALS TRUE
-- 10: relieving poverty, presumed
#ASSERT `we are a charity` (org (LIST pPoverty)) EQUALS TRUE
-- 11: health plus incidental fundraising
#ASSERT `we are a charity` (org (LIST pHealthPB, pIncidental)) EQUALS TRUE
-- 12: charitable plus a commercial purpose
#ASSERT `we are a charity` (org (LIST pHealthPB, pCommercial)) EQUALS FALSE
-- 13: only an incidental purpose
#ASSERT `we are a charity` (org (LIST pIncidental)) EQUALS FALSE
-- 14: plus promoting a political party
#ASSERT `we are a charity` (org (LIST pHealthPB, pPolitical)) EQUALS FALSE
-- 15: plus promoting unlawful activities
#ASSERT `we are a charity` (org (LIST pCulturePB, pUnlawful)) EQUALS FALSE
-- 16: s 12(1)(l) advocacy for environmental law reform, PB found
#ASSERT `we are a charity` (org (LIST pAdvocacyEnvPB)) EQUALS TRUE
-- 17: animal suffering, PB found
#ASSERT `we are a charity` (org (LIST pAnimalsPB)) EQUALS TRUE
-- 18: necessitous circumstances, 6(1)(a) met, 6(1)(b) not
#ASSERT `we are a charity` (org (LIST pNeedyA)) EQUALS TRUE
-- 19: necessitous circumstances, 6(1)(a) not met either
#ASSERT `we are a charity` (org (LIST pNeedyNoA)) EQUALS FALSE
-- 22: s 10(1) self-help group, welfare purpose, no PB finding
#ASSERT `we are a charity` (selfHelp (LIST pWelfareNoPB)) EQUALS TRUE
-- 23: same but s 10(1)(e) fails: s 10 flag FALSE
#ASSERT `we are a charity` (org (LIST pWelfareNoPB)) EQUALS FALSE
-- 24: s 10(2) contemplative order, religion with contrary evidence and no PB
#ASSERT `we are a charity` (selfHelp (LIST pReligionContraNoPB)) EQUALS TRUE
-- 25: s 10 entity whose purpose is not charitable
#ASSERT `we are a charity` (selfHelp (LIST pCommercial)) EQUALS FALSE
-- s 10 does not lift s 5(c): self-help group with a disqualifying purpose
#ASSERT `we are a charity` (selfHelp (LIST pWelfareNoPB, pPolitical)) EQUALS FALSE
-- s 10 does not lift s 5(d)
#ASSERT `we are a charity` (`Entity` OF `a government entity`, TRUE, TRUE, (LIST pWelfareNoPB)) EQUALS FALSE
-- no purposes at all
#ASSERT `we are a charity` (org (LIST)) EQUALS FALSE
-- 20/21 (s 9 native title) cannot be expressed: no input for s 9.
