IMPORT prelude
IMPORT `charities-rules`

§ `Tests`

edu MEANS `Purpose` OF `advancing education`, FALSE, FALSE, FALSE
eduContra MEANS `Purpose` OF `advancing education`, FALSE, FALSE, TRUE
env MEANS `Purpose` OF `another charitable purpose under s 12(1)`, FALSE, FALSE, FALSE
envFound MEANS `Purpose` OF `another charitable purpose under s 12(1)`, TRUE, TRUE, FALSE
needy MEANS `Purpose` OF `relieving necessitous circumstances of individuals in Australia`, FALSE, TRUE, FALSE
anc MEANS `Purpose` OF `incidental or ancillary to a charitable purpose`, FALSE, FALSE, FALSE
bad MEANS `Purpose` OF `a disqualifying purpose`, FALSE, FALSE, FALSE
other MEANS `Purpose` OF `a purpose that is none of these`, FALSE, FALSE, FALSE

GIVEN ps IS A LIST OF `Purpose`
GIVETH A `Entity`
`an organisation with` ps MEANS `Entity` OF `an organisation`, TRUE, FALSE, ps

#ASSERT `we are a charity` (`an organisation with` (LIST edu))
#ASSERT `we are a charity` (`an organisation with` (LIST edu, anc))
#ASSERT NOT (`we are a charity` (`an organisation with` (LIST eduContra)))
#ASSERT NOT (`we are a charity` (`an organisation with` (LIST env)))
#ASSERT `we are a charity` (`an organisation with` (LIST envFound))
#ASSERT `we are a charity` (`an organisation with` (LIST needy))
#ASSERT NOT (`we are a charity` (`an organisation with` (LIST edu, bad)))
#ASSERT NOT (`we are a charity` (`an organisation with` (LIST edu, other)))
#ASSERT NOT (`we are a charity` (`an organisation with` (LIST anc)))
#ASSERT `we are a charity` (`Entity` OF `an organisation`, TRUE, TRUE, (LIST env))
#ASSERT NOT (`we are a charity` (`Entity` OF `an organisation`, FALSE, FALSE, (LIST edu)))
#ASSERT NOT (`we are a charity` (`Entity` OF `a political party`, TRUE, FALSE, (LIST edu)))
#ASSERT NOT (`we are a charity` (`Entity` OF `a government entity`, TRUE, FALSE, (LIST edu)))
