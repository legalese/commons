IMPORT prelude
IMPORT daydate
IMPORT `cbw-rules`

-- Independent tests: expected values from independent-expectations.md,
-- written from the source text before reading the rules module.

GIVEN who IS A `Kind of person`
      cit IS A BOOLEAN
      wh IS A `Where`
      hold IS A `What I hold`
      act IS A `What I do with it`
      seiz IS A MAYBE DATE
      pros IS A BOOLEAN
      ag IS A BOOLEAN
      cert IS A BOOLEAN
      hear IS A DATE
GIVETH A `Weapons position`
pos who cit wh hold act seiz pros ag cert hear MEANS
    `the weapons position for` (`Weapons case` OF who, cit, wh, hold, act, seiz, pros, ag, cert, hear)

DECIDE noJust IS `biological agents or toxins of types and quantities with no prophylactic, protective or other peaceful justification`
DECIDE weap IS `weapons, equipment or means of delivery designed to use them for hostile purposes or armed conflict`
DECIDE peace IS `agents or toxins justified for peaceful purposes`
DECIDE does IS `develop, produce, stockpile, acquire or retain it`
DECIDE inAus IS `in Australia or an external Territory`
DECIDE h IS Date 10 6 2024

-- 1: natural person, citizen, in Australia, no-justification agents
#ASSERT (pos `a natural person` TRUE inAus noJust does NOTHING FALSE FALSE FALSE h)'s `I commit an offence`
#ASSERT (pos `a natural person` TRUE inAus noJust does NOTHING FALSE FALSE FALSE h)'s `I may be imprisoned for life`
#ASSERT (pos `a natural person` TRUE inAus noJust does NOTHING FALSE FALSE FALSE h)'s `maximum fine in penalty units` EQUALS 100
-- 2: corporation, weapons
#ASSERT (pos `a corporation` FALSE inAus weap does NOTHING FALSE FALSE FALSE h)'s `I commit an offence`
#ASSERT (pos `a corporation` FALSE inAus weap does NOTHING FALSE FALSE FALSE h)'s `maximum fine in penalty units` EQUALS 2000
#ASSERT NOT ((pos `a corporation` FALSE inAus weap does NOTHING FALSE FALSE FALSE h)'s `I may be imprisoned for life`)
-- 3: peaceful justification
#ASSERT NOT ((pos `a natural person` TRUE inAus peace does NOTHING FALSE FALSE FALSE h)'s `I commit an offence`)
#ASSERT NOT ((pos `a natural person` TRUE inAus peace does NOTHING FALSE FALSE FALSE h)'s `it is forfeited to the Commonwealth`)
-- 4-5: non-citizen in Australia / external Territory
#ASSERT (pos `a natural person` FALSE inAus noJust does NOTHING FALSE FALSE FALSE h)'s `I commit an offence`
-- 6: citizen abroad
#ASSERT (pos `a natural person` TRUE `outside Australia` noJust does NOTHING FALSE FALSE FALSE h)'s `I commit an offence`
-- 7: non-citizen abroad: Act does not reach; no contravention, so no forfeiture under s 9(1)
#ASSERT NOT ((pos `a natural person` FALSE `outside Australia` noJust does NOTHING FALSE FALSE FALSE h)'s `I commit an offence`)
#ASSERT NOT ((pos `a natural person` FALSE `outside Australia` noJust does NOTHING FALSE FALSE FALSE h)'s `it is forfeited to the Commonwealth`)
-- 8: corporation abroad
#ASSERT NOT ((pos `a corporation` FALSE `outside Australia` weap does NOTHING FALSE FALSE FALSE h)'s `I commit an offence`)
-- 9: forfeiture
#ASSERT (pos `a natural person` TRUE inAus noJust does NOTHING FALSE FALSE FALSE h)'s `it is forfeited to the Commonwealth`
-- 10-12: retention
#ASSERT (pos `a natural person` TRUE inAus noJust does (JUST (Date 1 1 2023)) FALSE FALSE FALSE h)'s `the last day it may be retained without a prosecution` EQUALS JUST (Date 2 3 2023)
#ASSERT (pos `a natural person` TRUE inAus noJust does (JUST (Date 1 1 2024)) FALSE FALSE FALSE h)'s `the last day it may be retained without a prosecution` EQUALS JUST (Date 1 3 2024)
#ASSERT (pos `a natural person` TRUE inAus noJust does (JUST (Date 1 1 2024)) TRUE FALSE FALSE h)'s `the last day it may be retained without a prosecution` EQUALS NOTHING
-- 13-14: committal
#ASSERT (pos `a natural person` TRUE inAus noJust does NOTHING FALSE TRUE FALSE h)'s `I may be committed for trial`
#ASSERT NOT ((pos `a natural person` TRUE inAus noJust does NOTHING FALSE FALSE FALSE h)'s `I may be committed for trial`)
-- 15-16: certificate
#ASSERT (pos `a natural person` TRUE inAus noJust does NOTHING FALSE FALSE TRUE h)'s `the certificate can be used against me`
#ASSERT NOT ((pos `a natural person` TRUE inAus noJust does NOTHING FALSE FALSE FALSE h)'s `the certificate can be used against me`)
-- 17: at least 5 days' notice, read as 5 clear days: last day 4 Jun 2024
#ASSERT (pos `a natural person` TRUE inAus noJust does NOTHING FALSE FALSE TRUE h)'s `the last day to notify the prosecutor to call the analyst` EQUALS Date 4 6 2024
