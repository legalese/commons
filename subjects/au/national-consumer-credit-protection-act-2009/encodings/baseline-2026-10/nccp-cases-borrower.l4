`c052 variant: Chloe and Liam default, 40 days after notice, hardship refused 10 days ago` MEANS `My default` WITH
    `I am in default` IS TRUE
    `a complying default notice was given to me` IS TRUE
    `days the notice allowed me to remedy` IS 30
    `days since the date of the notice` IS 40
    `I remedied the default within that period` IS FALSE
    `the lender reasonably believes the default cannot be remedied` IS FALSE
    `an s 88(5) ground applies (fraud, cannot find me, court leave, goods at risk)` IS FALSE
    `I gave a hardship notice` IS TRUE
    `I gave another hardship notice in the 4 months before, on the same basis` IS FALSE
    `the lender gave me notice that it does not agree to a change` IS TRUE
    `days since that notice of refusal` IS 10

`c052 variant: the same, hardship refused 14 days ago` MEANS `My default` WITH
    `I am in default` IS TRUE
    `a complying default notice was given to me` IS TRUE
    `days the notice allowed me to remedy` IS 30
    `days since the date of the notice` IS 40
    `I remedied the default within that period` IS FALSE
    `the lender reasonably believes the default cannot be remedied` IS FALSE
    `an s 88(5) ground applies (fraud, cannot find me, court leave, goods at risk)` IS FALSE
    `I gave a hardship notice` IS TRUE
    `I gave another hardship notice in the 4 months before, on the same basis` IS FALSE
    `the lender gave me notice that it does not agree to a change` IS TRUE
    `days since that notice of refusal` IS 14

