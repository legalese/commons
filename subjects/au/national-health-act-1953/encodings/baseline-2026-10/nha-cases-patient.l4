IMPORT prelude
IMPORT daydate
IMPORT `nha-patient`

-- National Health Act 1953 Part VII -- worked cases, from the seat of the patient. Every assertion is a claim about the
-- ENCODING on stated facts, not about the law. Expected values were written by hand from the deposited text (Compilation
-- No. 157), never copied from the encoding's output. All facts are HYPOTHETICAL; no scenario raised this Act.
--
-- PRINTED FIGURES. The cases use the amounts as printed in the deposit -- general patient charge $25.00, reduced and
-- concessional charges $4.60, general patient safety net $1,457.10, increased discounting ceiling $42.50 -- as labelled
-- examples. The amounts in force are indexed under s 99G and differ; the encoding takes them as inputs.

-- ---------------------------------------------------------------------------------------------------------------------
-- Entitlement. A Perth resident with a GP's PBS prescription for a listed medicine, filled at her local pharmacy.
#ASSERT `Can I get this medicine on the PBS` TRUE TRUE TRUE TRUE FALSE EQUALS `yes: I am entitled to receive it as a pharmaceutical benefit, paying no more than the charge s 87 allows (ss 85, 86(1), 89)`
-- A tourist who is not an eligible person.
#ASSERT `Can I get this medicine on the PBS` FALSE TRUE TRUE TRUE FALSE EQUALS `no: I am not an eligible person under the Health Insurance Act 1973, nor treated as one (s 86(1)(a))`
-- A medicine not listed in that form.
#ASSERT `Can I get this medicine on the PBS` TRUE TRUE FALSE TRUE FALSE EQUALS `no: the medicine, in this form, is not a drug the Minister has declared for the PBS (s 85(2)-(3))`
-- Bought without a prescription.
#ASSERT `Can I get this medicine on the PBS` TRUE TRUE TRUE FALSE FALSE EQUALS `no: a pharmaceutical benefit must be supplied by an approved pharmacist on a PBS prescriber's prescription, or another way s 89 allows (s 89)`
-- A family member collecting it while the pharmacist believes the patient is overseas.
#ASSERT `Can I get this medicine on the PBS` TRUE TRUE TRUE TRUE TRUE EQUALS `no: the supplier must not supply it, having reason to believe I am not in Australia (s 86A(1))`
#ASSERT `Can I get this medicine on the PBS` TRUE FALSE TRUE TRUE FALSE EQUALS `no: it must be for treatment I am receiving from a medical practitioner, or a participating dentist, or an authorised optometrist, midwife, nurse practitioner or nurse prescriber (s 86(1)(b))`

-- Concessional beneficiary. A health care card holder; her child named on the card; a veteran with s 53A fringe benefits.
#ASSERT `Am I a concessional beneficiary` TRUE TRUE FALSE
#ASSERT `Am I a concessional beneficiary` FALSE TRUE TRUE
-- A veteran's entitlement but not an Australian resident.
#ASSERT (NOT (`Am I a concessional beneficiary` FALSE FALSE TRUE))
#ASSERT (NOT (`Am I a concessional beneficiary` FALSE TRUE FALSE))
-- The veteran's spouse and 19-year-old student son; not the veteran's brother.
#ASSERT `Am I the dependant of a veteran for the PBS` TRUE `the veteran's spouse` TRUE
#ASSERT `Am I the dependant of a veteran for the PBS` TRUE `a full-time student aged 16 to 24, wholly or substantially dependent on the veteran or the veteran's spouse, not paid a disability support pension` TRUE
#ASSERT (NOT (`Am I the dependant of a veteran for the PBS` TRUE `none of these` TRUE))
-- The spouse of someone who holds only a veterans' seniors health card (s 84(7)).
#ASSERT (NOT (`Am I the dependant of a veteran for the PBS` TRUE `the veteran's spouse` FALSE))

-- ---------------------------------------------------------------------------------------------------------------------
-- The charge, on the printed figures (general $25.00, reduced $4.60, concessional $4.60), no brand premium, one supply.
#ASSERT `The most the pharmacist may charge me` `I am a general patient below the safety net` FALSE 25 4.6 4.6 0 1 EQUALS 25
#ASSERT `The most the pharmacist may charge me` `I am a concessional beneficiary, or a veteran's dependant, without a safety net card` FALSE 25 4.6 4.6 0 1 EQUALS 4.6
#ASSERT `The most the pharmacist may charge me` `I am a general patient who has reached the safety net this year but has no card` FALSE 25 4.6 4.6 0 1 EQUALS 4.6
#ASSERT `The most the pharmacist may charge me` `I hold a safety net concession card` FALSE 25 4.6 4.6 0 1 EQUALS 4.6
-- An entitlement card holder pays nothing under s 87(2) ...
#ASSERT `The most the pharmacist may charge me` `I hold a safety net entitlement card` FALSE 25 4.6 4.6 0 1 EQUALS 0
-- ... except the concessional charge for an early supply (s 87(2)(a)(ii)) ...
#ASSERT `The most the pharmacist may charge me` `I hold a safety net entitlement card` TRUE 25 4.6 4.6 0 1 EQUALS 4.6
-- ... and a brand premium of $3.15 (s 87(2A)).
#ASSERT `The most the pharmacist may charge me` `I hold a safety net entitlement card` FALSE 25 4.6 4.6 3.15 1 EQUALS 3.15
-- A concession card holder's early supply is charged at the general patient charge (s 87(2)(a)(iii), (e)).
#ASSERT `The most the pharmacist may charge me` `I hold a safety net concession card` TRUE 25 4.6 4.6 0 1 EQUALS 25
-- A general patient's whole quantity supplied at once instead of one supply and 5 repeats: 6 charges (s 87(3)).
#ASSERT `The most the pharmacist may charge me` `I am a general patient below the safety net` FALSE 25 4.6 4.6 0 6 EQUALS 150
-- On hypothetical indexed figures: general $31.60, concessional $7.70, with a $2.00 premium.
#ASSERT `The most the pharmacist may charge me` `I am a general patient below the safety net` FALSE 31.6 7.7 7.7 2 1 EQUALS 33.6

-- Increased discounting: a $30 medicine for a general patient may be discounted below $25; a $50 one may not; nor a $20
-- one (its price is not above the charge); nor for a concession card holder.
#ASSERT `May the pharmacist discount below the general charge` `I am a general patient below the safety net` FALSE 30 25 42.5
#ASSERT (NOT (`May the pharmacist discount below the general charge` `I am a general patient below the safety net` FALSE 50 25 42.5))
#ASSERT (NOT (`May the pharmacist discount below the general charge` `I am a general patient below the safety net` FALSE 20 25 42.5))
#ASSERT (NOT (`May the pharmacist discount below the general charge` `I hold a safety net concession card` FALSE 30 25 42.5))
#ASSERT `May the pharmacist discount below the general charge` `I am a general patient below the safety net` FALSE 42.5 25 42.5

-- ---------------------------------------------------------------------------------------------------------------------
-- The safety net, printed figures. A general patient family at $1,400.00: $57.10 to go.
#ASSERT `Have I reached the PBS safety net` FALSE 1400 0 1457.1 4.6 EQUALS `not yet` 57.1
-- With today's $60.00 supply included, $1,460.00: reached at the time of this supply (s 84C(1B)).
#ASSERT `Have I reached the PBS safety net` FALSE 1460 0 1457.1 4.6 EQUALS `I have reached it: I am eligible for a safety net concession card, and pay the reduced charge for the rest of the year (ss 84C(1AA), (1B), 87(2)(b))`
-- Exactly at the safety net: "not less than".
#ASSERT `Have I reached the PBS safety net` FALSE 1457.1 0 1457.1 4.6 EQUALS `I have reached it: I am eligible for a safety net concession card, and pay the reduced charge for the rest of the year (ss 84C(1AA), (1B), 87(2)(b))`
-- A pensioner: the concessional safety net is 36 x $4.60 = $165.60. At $161.00 (35 scripts), $4.60 to go; at $165.60, reached.
#ASSERT `Have I reached the PBS safety net` TRUE 161 0 1457.1 4.6 EQUALS `not yet` 4.6
#ASSERT `Have I reached the PBS safety net` TRUE 165.6 0 1457.1 4.6 EQUALS `I have reached it: I am eligible for a safety net entitlement card, and pay nothing more for PBS medicines for the rest of the year apart from early supplies and brand premiums (ss 84C(1C), (1D), 87(2))`
-- She got her card in July after general-patient supplies counting $46.00 (ten scripts at $4.60 each): $119.60 since then
-- reaches it.
#ASSERT `Have I reached the PBS safety net` TRUE 119.6 46 1457.1 4.6 EQUALS `I have reached it: I am eligible for a safety net entitlement card, and pay nothing more for PBS medicines for the rest of the year apart from early supplies and brand premiums (ss 84C(1C), (1D), 87(2))`
-- On a hypothetical indexed concessional charge of $7.70: 36 x $7.70 = $277.20.
#ASSERT `Have I reached the PBS safety net` TRUE 270 0 1694.9 7.7 EQUALS `not yet` 7.2
-- Reg 17A: a $25.00 co-payment counts $25.00, the $3.15 brand premium not at all; a $4.60 concessional charge discounted
-- by $1.00 counts $3.60; an unlawful overcharge counts nothing; a private hospital supply is not encoded.
#ASSERT `How much of this supply counts towards my safety net` 25 TRUE FALSE EQUALS JUST 25
#ASSERT `How much of this supply counts towards my safety net` 3.6 TRUE FALSE EQUALS JUST 3.6
#ASSERT `How much of this supply counts towards my safety net` 30 FALSE FALSE EQUALS JUST 0
#ASSERT `How much of this supply counts towards my safety net` 25 TRUE TRUE EQUALS NOTHING
-- The transferred value: a $25.00 general-patient supply counts $4.60; a $3.80 one counts $3.80.
#ASSERT `The transferred value of a supply` 25 4.6 EQUALS 4.6
#ASSERT `The transferred value of a supply` 3.8 4.6 EQUALS 3.8

-- Family: spouse, child under 16, a 20-year-old full-time university student who depends on her; not a separated husband,
-- nor her mother.
#ASSERT `Do their medicines count towards my safety net` `my spouse or de facto partner, living with me (or apart only because of illness or infirmity)`
#ASSERT `Do their medicines count towards my safety net` `a child under 16 in my or my spouse's custody, care and control`
#ASSERT `Do their medicines count towards my safety net` `a full-time student aged 16 to 24, wholly or substantially dependent on me or my spouse`
#ASSERT (NOT (`Do their medicines count towards my safety net` `my spouse or de facto partner, living permanently separately and apart from me`))
#ASSERT (NOT (`Do their medicines count towards my safety net` `someone else`))

-- A card issued on 14 August 2026 has effect until 31 December 2026 (s 84J).
#ASSERT `The last day my safety net card has effect` (Date 14 8 2026) EQUALS Date 31 12 2026

-- ---------------------------------------------------------------------------------------------------------------------
-- Refund. She paid $25.00 before her card was issued but was already eligible for one; the Secretary is satisfied: $20.40.
#ASSERT `The refund I can get` 25 4.6 TRUE EQUALS 20.4
#ASSERT `The refund I can get` 25 4.6 FALSE EQUALS 0
#ASSERT `The refund I can get` 4.6 4.6 TRUE EQUALS 0
