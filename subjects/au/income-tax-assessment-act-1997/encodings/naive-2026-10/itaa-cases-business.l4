IMPORT prelude
IMPORT `itaa-business`

-- Income Tax Assessment Act 1997, ss 83A-25, 83A-33, 83A-45, 355-100, 360-20, 360-25 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_income-tax-assessment-act-1997.py). Expected results were written by
-- hand from the text.

`Chloe's Jarrah shares (c072, d04b)` MEANS EssInterest WITH
    `is a right rather than a share` IS FALSE
    `discount` IS 1000
    `market value` IS 10000
    `exercise price` IS 0
    `group has listed equity` IS FALSE
    `years incorporated before the last income year end` IS 2
    `aggregated turnover last year` IS 3000000
    `employer is an Australian resident` IS TRUE
    `employed by the company or a subsidiary` IS TRUE
    `scheme relates only to ordinary shares` IS TRUE
    `share trading company integrity case` IS FALSE
    `three-year disposal restriction` IS TRUE
    `holds more than 10 percent` IS FALSE
    `scheme broadly available` IS TRUE

