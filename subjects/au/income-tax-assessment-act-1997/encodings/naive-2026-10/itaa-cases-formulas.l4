IMPORT prelude
IMPORT `itaa-income`
IMPORT `itaa-super`
IMPORT `itaa-formulas`

-- Worked cases for itaa-formulas.l4 (24 October 2026). Expected results worked by hand from the text and the formulas in
-- ../../registers/source-bundle/C2004A05138.formulas.md. Index numbers are ASSUMED: CPI 110.0 (December 2016) and 138.8
-- (December 2024) from the encoder's recollection; AWOTE 1,500 and 1,810 invented. Jake k043's $31,000 is read as his labour
-- amounts with no labour deductions.

-- k043 (2028-29): net labour income 31,000; above the $18,200 threshold; the liability on it alone 1,792; offset 250.
#ASSERT `the net labour income` 31000 0 EQUALS 31000
#ASSERT `the working Australians tax offset from labour amounts` TRUE 31000 0 18200 1792 EQUALS 250
-- $20,000 less $3,000: 17,000, not above the threshold: nil.
#ASSERT `the working Australians tax offset from labour amounts` TRUE 20000 3000 18200 0 EQUALS 0
-- Concessional cap: 1,810 / 1,500 -> 1.207; 30,175 down to 30,000. General transfer balance cap: 138.8 / 110 -> 1.262;
-- 2,019,200 down to 2,000,000. A factor of 1 or less: the base amount.
#ASSERT `the concessional contributions cap from AWOTE` 1810 1500 EQUALS 30000
#ASSERT `the general transfer balance cap from CPI` 138.8 110 EQUALS 2000000
#ASSERT `the general transfer balance cap from CPI` 109 110 EQUALS 1600000
-- Non-concessional cap on those: 4 x 30,000 = 120,000 on a $500,000 balance; nil on $2,000,000.
#ASSERT `the non-concessional contributions cap from the index numbers` 1810 1500 138.8 110 500000 EQUALS 120000
#ASSERT `the non-concessional contributions cap from the index numbers` 1810 1500 138.8 110 2000000 EQUALS 0
-- First account in 2025-26: 2,000,000; in 2017-18: 1,600,000 whatever the index numbers.
#ASSERT `the transfer balance cap on first having an account from CPI` 2025 138.8 110 EQUALS 2000000
#ASSERT `the transfer balance cap on first having an account from CPI` 2017 138.8 110 EQUALS 1600000
