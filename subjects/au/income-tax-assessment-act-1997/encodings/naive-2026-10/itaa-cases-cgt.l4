IMPORT prelude
IMPORT `itaa-cgt`

-- Income Tax Assessment Act 1997, ss 102-5, 104-215, 115-5 to 115-102, 118-60, 118-110, 118-150, 128-10, 152-15 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_income-tax-assessment-act-1997.py). Expected results were written by
-- hand from the text.

`Byford (c080)` MEANS DwellingSale WITH
    `seller is an individual` IS TRUE
    `main residence from acquisition` IS FALSE
    `months from acquisition before it became the main residence` IS 17
    `main residence from then until the sale` IS TRUE
    `built on the land and moved in as soon as practicable` IS TRUE
    `lived in for at least 3 months` IS TRUE
    `chooses section 118-150` IS TRUE
    `inherited or held as trustee of an estate` IS FALSE
    `excluded foreign resident or failing the life events test` IS FALSE

`Byford without the choice` MEANS DwellingSale WITH
    `seller is an individual` IS TRUE
    `main residence from acquisition` IS FALSE
    `months from acquisition before it became the main residence` IS 17
    `main residence from then until the sale` IS TRUE
    `built on the land and moved in as soon as practicable` IS TRUE
    `lived in for at least 3 months` IS TRUE
    `chooses section 118-150` IS FALSE
    `inherited or held as trustee of an estate` IS FALSE
    `excluded foreign resident or failing the life events test` IS FALSE

`the East Perth apartment (d055)` MEANS DwellingSale WITH
    `seller is an individual` IS TRUE
    `main residence from acquisition` IS TRUE
    `months from acquisition before it became the main residence` IS 0
    `main residence from then until the sale` IS FALSE
    `built on the land and moved in as soon as practicable` IS FALSE
    `lived in for at least 3 months` IS FALSE
    `chooses section 118-150` IS FALSE
    `inherited or held as trustee of an estate` IS FALSE
    `excluded foreign resident or failing the life events test` IS FALSE

§ `ss 115-5 to 115-25`

-- d071: Daniel's Jarrah shares, held from registration (2031-03-15) to the sale (2050-06-30). A company cannot have one.
#ASSERT `the gain is a discount capital gain` `an individual` 20310315 20500630 FALSE
#ASSERT NOT `the gain is a discount capital gain` `a company` 20310315 20500630 FALSE

§ `ss 115-100, 115-102`

-- d071 and c085: an individual's gain from a CGT event on 30 June 2050 gets 0%, not the 50% the scenarios expect. Before
-- 1 July 2027, 50%. A new residential dwelling keeps 50% after it.
#ASSERT `the discount percentage` `an individual` 20500630 FALSE EQUALS 0
#ASSERT `the discount percentage` `an individual` 20260630 FALSE EQUALS 50
#ASSERT `the discount percentage` `an individual` 20500630 TRUE EQUALS 50

§ `s 102-5`

-- A hypothetical gain of 1,000,000: at 0% (an individual after 1 July 2027) all of it; at 50%, half.
#ASSERT `the net capital gain` 1000000 0 0 EQUALS 1000000
#ASSERT `the net capital gain` 1000000 0 50 EQUALS 500000

§ `ss 118-110, 118-150`

#ASSERT `the gain is disregarded as a main residence` `Byford (c080)`
#ASSERT NOT `the gain is disregarded as a main residence` `Byford without the choice`
#ASSERT `the gain is disregarded as a main residence` `the East Perth apartment (d055)`

§ `ss 152-10, 152-15`

-- d071: Jarrah sold for $40,000,000; the net value input is that figure (an inference: Daniel's shares and his connected company).
#ASSERT NOT `the maximum net asset value test is satisfied` 40000000
#ASSERT `the maximum net asset value test is satisfied` 6000000

§ `ss 128-10, 104-215, 118-60`

-- d093: the residue to the testamentary trust (resident trustee) -- disregarded; the gift to the Foundation (an exempt
-- entity) -- K3 would happen, but s 118-60(1) disregards a testamentary gift that would have been deductible; the same asset
-- to an exempt entity that is not such a gift -- a gain.
#ASSERT NOT `a capital gain arises on the death` `an Australian resident individual or ordinary trust` 20380520 FALSE
#ASSERT NOT `a capital gain arises on the death` `an exempt entity` 20400101 TRUE
#ASSERT `a capital gain arises on the death` `an exempt entity` 20400101 FALSE

