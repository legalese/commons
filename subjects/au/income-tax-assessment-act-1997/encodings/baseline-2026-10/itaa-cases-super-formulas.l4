IMPORT prelude
IMPORT `itaa-super`
IMPORT `itaa-super-formulas`

-- Income Tax Assessment Act 1997, ss 291-20(2), 292-85(2), 294-35, 294-40, 296-30 to 296-45, 303-4(1), 960-285 -- worked cases
-- for itaa-super-formulas.l4 (24 October 2026).
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Expected results were worked by hand from
-- the text and the formulas transcribed in ../../registers/source-bundle/C2004A05138.formulas.md, before the encoding was run.
--
-- THE INDEX NUMBERS ARE ASSUMED. No AWOTE or CPI figure is deposited. CPI 110.0 (December 2016) and 138.8 (December 2024) are
-- the encoder's recollection of the published figures, used as assumed inputs; AWOTE 1,500 and 1,810, CPI 140, 144 and 147
-- are invented round numbers. Balances and earnings are hypothetical.

§ `s 960-285(5), (6) -- the factor, to 3 decimal places`

-- 138.8 / 110 = 1.261818... -> 1.262.
#ASSERT `What is the super cap indexation factor` 138.8 110 EQUALS 1.262
-- 1.102795 -> 1.103 (fourth decimal 7); 1.1024999 -> 1.102 (fourth decimal 4).
#ASSERT `What is the super cap indexation factor` 1102795 1000000 EQUALS 1.103
#ASSERT `What is the super cap indexation factor` 11024999 10000000 EQUALS 1.102

§ `s 294-35(3) -- the general transfer balance cap`

-- 2017-18: $1,600,000, printed. 2016-17: before the provision -- NOTHING.
#ASSERT `What is the general transfer balance cap` 2017 110 110 EQUALS JUST 1600000
#ASSERT `What is the general transfer balance cap` 2016 110 110 EQUALS NOTHING
-- 2025-26 on CPI 138.8 / 110: 1,600,000 x 1.262 = 2,019,200, rounded down to a multiple of $100,000 = 2,000,000.
#ASSERT `What is the general transfer balance cap` 2025 138.8 110 EQUALS JUST 2000000
-- A factor of 1 or less (109 / 110 = 0.991): not indexed (s 960-285(4)) -- 1,600,000.
#ASSERT `What is the general transfer balance cap` 2018 109 110 EQUALS JUST 1600000

§ `s 291-20(2) -- the concessional contributions cap`

-- 2017-18: $25,000. 1,810 / 1,500 = 1.20666... -> 1.207; 25,000 x 1.207 = 30,175, down to a multiple of $2,500 = 30,000.
-- 1,700 / 1,500 = 1.1333... -> 1.133; 28,325 -> 27,500.
#ASSERT `What is the concessional contributions cap` 2017 1500 1500 EQUALS JUST 25000
#ASSERT `What is the concessional contributions cap` 2025 1810 1500 EQUALS JUST 30000
#ASSERT `What is the concessional contributions cap` 2021 1700 1500 EQUALS JUST 27500

§ `s 292-85(2) -- the non-concessional cap from the index numbers`

-- 2025-26: concessional cap 30,000 (above), general transfer balance cap 2,000,000 (above). A balance of $500,000: 4 x 30,000 =
-- 120,000. A balance of $2,000,000, equal to the general cap: nil.
#ASSERT `What is my non-concessional cap from the index numbers` 2025 1810 1500 138.8 110 500000 EQUALS JUST 120000
#ASSERT `What is my non-concessional cap from the index numbers` 2025 1810 1500 138.8 110 2000000 EQUALS JUST 0
#ASSERT `What is my non-concessional cap from the index numbers` 2016 1810 1500 138.8 110 500000 EQUALS NOTHING

§ `ss 296-30, 296-35 -- the Division 296 thresholds`

-- 2026-27: $3,000,000 and $10,000,000, printed. 2027-28 on CPI 144 / 140 = 1.02857... -> 1.029: 3,087,000 down to a multiple of
-- $150,000 = 3,000,000; 10,290,000 down to a multiple of $500,000 = 10,000,000. On 147 / 140 = 1.05: 3,150,000 and 10,500,000.
#ASSERT `What is the large superannuation balance threshold` 2026 140 140 EQUALS JUST 3000000
#ASSERT `What is the large superannuation balance threshold` 2027 144 140 EQUALS JUST 3000000
#ASSERT `What is the large superannuation balance threshold` 2027 147 140 EQUALS JUST 3150000
#ASSERT `What is the very large superannuation balance threshold` 2027 144 140 EQUALS JUST 10000000
#ASSERT `What is the very large superannuation balance threshold` 2027 147 140 EQUALS JUST 10500000
#ASSERT `What is the large superannuation balance threshold` 2025 147 140 EQUALS NOTHING

§ `s 294-40 -- proportional indexation of my own cap`

-- Highest balance $800,000 on a $1,600,000 cap: 50%, unused 50%. $1,000,000: 62.5% rounded down to 62, unused 38%. Below nil: 100%.
#ASSERT `What is my unused cap percentage` 800000 1600000 EQUALS 50
#ASSERT `What is my unused cap percentage` 1000000 1600000 EQUALS 38
#ASSERT `What is my unused cap percentage` (0 MINUS 5000) 1600000 EQUALS 100
-- The general cap rises from $1,600,000 to $1,700,000 (an increase of $100,000). Unused 50%: 1,600,000 + 50,000 = 1,650,000.
-- Unused 38%: + 38,000 = 1,638,000. Ever exceeded: no increase. General cap not increased: no increase.
#ASSERT `What is my transfer balance cap for a later year` 1600000 1700000 1600000 FALSE 800000 1600000 EQUALS 1650000
#ASSERT `What is my transfer balance cap for a later year` 1600000 1700000 1600000 FALSE 1000000 1600000 EQUALS 1638000
#ASSERT `What is my transfer balance cap for a later year` 1600000 1700000 1600000 TRUE 800000 1600000 EQUALS 1600000
#ASSERT `What is my transfer balance cap for a later year` 1600000 1600000 1600000 FALSE 800000 1600000 EQUALS 1600000
-- Credits of $1,700,000 against that $1,650,000 cap: excess $50,000. Credits of $1,600,000: none.
#ASSERT `What is my excess transfer balance in a later year` 1700000 0 1600000 1700000 1600000 FALSE 800000 1600000 EQUALS 50000
#ASSERT `What is my excess transfer balance in a later year` 1600000 0 1600000 1700000 1600000 FALSE 800000 1600000 EQUALS 0

§ `s 303-4(1) -- defined benefit income cap`

-- 1,600,000 / 16 = 100,000; 2,000,000 / 16 = 125,000; 1,700,001 / 16 = 106,250.0625, rounded up to 106,251.
#ASSERT `What is my defined benefit income cap` 1600000 EQUALS 100000
#ASSERT `What is my defined benefit income cap` 2000000 EQUALS 125000
#ASSERT `What is my defined benefit income cap` 1700001 EQUALS 106251

§ `ss 296-40, 296-45 -- Division 296 earnings`

-- Balances $4,000,000 and $5,000,000, threshold $3,000,000, earnings $200,000: reference amount 5,000,000; (2,000,000 /
-- 5,000,000) x 100 = 40.00%; 40% x 200,000 = 80,000.
#ASSERT `What are my taxable superannuation earnings` FALSE 4000000 5000000 3000000 200000 EQUALS 80000
-- Reference $3,300,000: 300,000 / 3,300,000 x 100 = 9.0909... -> 9.09%; on $100,000 of earnings, 9,090.
#ASSERT `What are my taxable superannuation earnings` FALSE 3300000 3100000 3000000 100000 EQUALS 9090
-- Both balances at or below the threshold; earnings not above nil; an exception: nil.
#ASSERT `What are my taxable superannuation earnings` FALSE 2900000 3000000 3000000 100000 EQUALS 0
#ASSERT `What are my taxable superannuation earnings` FALSE 4000000 5000000 3000000 (0 MINUS 50000) EQUALS 0
#ASSERT `What are my taxable superannuation earnings` TRUE 4000000 5000000 3000000 200000 EQUALS 0
-- Very large: balances $12,000,000 and $9,000,000, threshold $10,000,000, earnings $600,000: 2,000,000 / 12,000,000 x 100 =
-- 16.666... -> 16.67%; 100,020. Balances both $9,000,000: nil.
#ASSERT `What is my very large balance earnings component` 12000000 9000000 10000000 600000 EQUALS 100020
#ASSERT `What is my very large balance earnings component` 9000000 9000000 10000000 600000 EQUALS 0
-- s 296-45(1) has no "greater than nil" condition on the earnings: on -$100,000 the component reads as -16,670 (NOTES.md, finding 11).
#ASSERT `What is my very large balance earnings component` 12000000 9000000 10000000 (0 MINUS 100000) EQUALS (0 MINUS 16670)
