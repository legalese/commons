IMPORT prelude
IMPORT daydate
IMPORT `feg-maximum-weekly-wage`

-- Fair Entitlements Guarantee Act 2012 s 5 with the Fair Entitlements Guarantee (Indexation of Maximum Weekly Wage)
-- Regulations 2023 -- worked cases, from the employee's seat.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Expected values were worked by hand from
-- the deposited texts (Act s 5; Regulations s 6; the ABS releases deposited beside the Regulations), never copied from the
-- encoding's output. No scenario life raised this; the facts are the encoder's, HYPOTHETICAL throughout.
--
-- The chain, by hand (s 6(3), Steps 1-3):
--   2022-23: $2,585 (s 6(2)).
--   2023-24: 1,807.70 / 1,748.40 = 1.03392 -> 1.034; 2,585 x 1.034 = 2,672.89 -> $2,673.
--   2024-25: 1,888.80 / 1,807.70 = 1.04486 -> 1.045; 2,673 x 1.045 = 2,793.285 -> $2,793.
--   2025-26: 1,975.80 / 1,888.80 = 1.04606 -> 1.046; 2,793 x 1.046 = 2,921.478 -> $2,921.
--   2026-27: 2,051.10 / 1,975.80 = 1.03811 -> 1.038; 2,921 x 1.038 = 3,031.998 -> $3,032.

#ASSERT `What is the maximum weekly wage for the year starting 1 July` 2012 EQUALS `the maximum weekly wage is` 2364
#ASSERT `What is the maximum weekly wage for the year starting 1 July` 2022 EQUALS `the maximum weekly wage is` 2585
#ASSERT `What is the maximum weekly wage for the year starting 1 July` 2023 EQUALS `the maximum weekly wage is` 2673
#ASSERT `What is the maximum weekly wage for the year starting 1 July` 2024 EQUALS `the maximum weekly wage is` 2793
#ASSERT `What is the maximum weekly wage for the year starting 1 July` 2025 EQUALS `the maximum weekly wage is` 2921
#ASSERT `What is the maximum weekly wage for the year starting 1 July` 2026 EQUALS `the maximum weekly wage is` 3032
-- The years the encoding does not reach.
#ASSERT `What is the maximum weekly wage for the year starting 1 July` 2018 EQUALS `not covered: the year 2013-14 to 2021-22 was indexed under the repealed Fair Entitlements Guarantee (Indexation of Maximum Weekly Wage) Regulation 2013, which is not deposited`
#ASSERT `What is the maximum weekly wage for the year starting 1 July` 2027 EQUALS `not covered: the year starts on or after 1 July 2027, and the Australian Statistician's estimate published before that 1 July is not deposited`
#ASSERT `What is the maximum weekly wage for the year starting 1 July` 2011 EQUALS `not covered: the year starts before 1 July 2012, before the Act's $2,364`

-- The year of the end of the employment: 30 June 2026 is in 2025-26 ($2,921); 1 July 2026 in 2026-27 ($3,032).
#ASSERT `What maximum weekly wage caps my advance` (Date 30 6 2026) EQUALS `the maximum weekly wage is` 2921
#ASSERT `What maximum weekly wage caps my advance` (Date 1 7 2026) EQUALS `the maximum weekly wage is` 3032
#ASSERT `What maximum weekly wage caps my advance` (Date 14 4 2026) EQUALS `the maximum weekly wage is` 2921

-- ---------------------------------------------------------------------------------------------------------------------
-- The advance. Sam (from feg-cases-employee.l4), $1,500 a week, employment ended 14 April 2026: under the $2,921 cap, so ss 26
-- and 27 change nothing: $39,600, as before.
#ASSERT `How much is my advance with the maximum weekly wage worked out` FALSE (Date 14 4 2026) 1500 6000 9000 6000 15000 7 19500 13 TRUE 1500 FALSE 3900 0 0 0 0 12000 (Date 14 4 2026) FALSE FALSE 0 0 FALSE EQUALS `my advance is` 39600
-- The higher earner (HYPOTHETICAL) on $3,250 a week, employment ended 14 April 2026, cap $2,921 (not the $2,600 assumed in
-- feg-cases-employee.l4). s 26 counts 2,921/3,250 of each entitlement. Annual leave $13,000 (4 weeks) -> 4 x 2,921 =
-- $11,684. Notice $19,500 (6 weeks) -> $17,526, limited to 5 x 2,921 = $14,605 (s 22). Redundancy $52,000 (16 weeks) ->
-- $46,736, limited to 4 x 2,921 x 3 = $35,052 (s 23). Wages: regular rate over the cap, s 27(2): 13 x 2,921 = $37,973, less
-- PAYG $8,000, less $20,000 paid: $9,973. Total 11,684 + 0 + 14,605 + 35,052 + 9,973 = $71,314.
#ASSERT `How much is my advance with the maximum weekly wage worked out` FALSE (Date 14 4 2026) 3250 13000 0 19500 52000 3 42250 13 TRUE 3250 FALSE 8000 0 0 0 0 20000 (Date 14 4 2026) FALSE FALSE 0 0 FALSE EQUALS `my advance is` 71314
-- The same employment ended on 1 August 2026 (2026-27, cap $3,032): leave 4 x 3,032 = $12,128; notice 5 x 3,032 = $15,160;
-- redundancy 12 x 3,032 = $36,384; wages 13 x 3,032 = 39,416 - 8,000 - 20,000 = $11,416. Total $75,088.
#ASSERT `How much is my advance with the maximum weekly wage worked out` FALSE (Date 1 8 2026) 3250 13000 0 19500 52000 3 42250 13 TRUE 3250 FALSE 8000 0 0 0 0 20000 (Date 14 4 2026) FALSE FALSE 0 0 FALSE EQUALS `my advance is` 75088
-- Employment that ended in 2019 (2019-20): not covered.
#ASSERT `How much is my advance with the maximum weekly wage worked out` FALSE (Date 1 3 2020) 1500 6000 9000 6000 15000 7 19500 13 TRUE 1500 FALSE 3900 0 0 0 0 12000 (Date 14 4 2020) FALSE FALSE 0 0 FALSE EQUALS `not covered: the maximum weekly wage for the year my employment ended is not worked out here`
-- A partnership employer: not covered.
#ASSERT `How much is my advance with the maximum weekly wage worked out` TRUE (Date 14 4 2026) 1500 6000 9000 6000 15000 7 19500 13 TRUE 1500 FALSE 3900 0 0 0 0 12000 (Date 14 4 2026) FALSE FALSE 0 0 FALSE EQUALS `not covered: employment for a partnership by two or more of the partners is not encoded (s 10(2))`
