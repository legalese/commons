IMPORT prelude
IMPORT `dpa-types`
IMPORT `dpa-rules`

-- Independent tests, written from independent-expectations.md (scenarios 1-15).
-- The encoding has no offence-date input; s 3(4) makes the date irrelevant, so
-- rows that differ only by date share inputs. Expected values were fixed before
-- reading dpa-rules.l4 and are not changed to fit it.

-- Scenario 1: a law of the Commonwealth; provides death: TRUE; offence after 1973
`s1` MEANS `Offence` OF `a law of the Commonwealth`, TRUE
#ASSERT `the Act applies to` `s1` EQUALS TRUE
#ASSERT `death may be imposed for` `s1` EQUALS JUST FALSE
#ASSERT `the penalty in place of death for` `s1` EQUALS JUST `imprisonment for life`
#ASSERT `an offence within s 3(2)` `s1` EQUALS TRUE
#ASSERT (`the death penalty position for` `s1`)'s `death may be imposed` EQUALS JUST FALSE

-- Scenario 2: a law of the Commonwealth; provides death: TRUE; offence before 1973
`s2` MEANS `Offence` OF `a law of the Commonwealth`, TRUE
