§ `ss 2 and 4 -- the old Act, and who is a citizen (chloe c000, daniel d000)`

#ASSERT `Is my citizenship at that date a question for the 1948 Act` 20030314
#ASSERT (NOT (`Is my citizenship at that date a question for the 1948 Act` 20070701))

-- Chloe today: s 12(1)(b) since 2013, and a 1948 Act citizen before (ASSUMED). Daniel: only through s 4(1)(b).
#ASSERT `Am I an Australian citizen` TRUE FALSE TRUE FALSE
#ASSERT `Am I an Australian citizen` FALSE FALSE TRUE FALSE
#ASSERT (NOT (`Am I an Australian citizen` TRUE FALSE FALSE TRUE))

§ `s 5 -- permanent resident (daniel d041: Priya in London in 2027; on a temporary partner visa in 2025)`

#ASSERT `Am I a permanent resident` FALSE TRUE TRUE FALSE
#ASSERT (NOT (`Am I a permanent resident` TRUE FALSE FALSE FALSE))

§ `s 12 -- citizenship by birth (chloe c000, c062; jake k000, k051; daniel d000, d040)`

-- Transitionals Act Sch 3 item 4: s 12(1)(a) only for births on or after 1 July 2007; s 12(1)(b) for earlier births only if
-- the 10 years were not complete by then.
#ASSERT (NOT (`Am I a citizen by birth under s 12` `Chloe at KEMH, 14 Mar 2003, at birth`))
#ASSERT `Am I a citizen by birth under s 12` `Chloe at 10, in 2013, having lived in Australia since birth`
#ASSERT (NOT (`Am I a citizen by birth under s 12` `Jake at KEMH, 30 Aug 2006, at birth`))
#ASSERT `Am I a citizen by birth under s 12` `Jake at 10, in 2016, having lived in Australia since birth`
#ASSERT (NOT (`Am I a citizen by birth under s 12` `Daniel at KEMH, 9 Apr 1996, at birth`))
#ASSERT (NOT (`Am I a citizen by birth under s 12` `Daniel after his first 10 years, completed in April 2006`))
#ASSERT `Am I a citizen by birth under s 12` `Oliver at KEMH, 5 Sep 2030`
#ASSERT `Am I a citizen by birth under s 12` `Ruby at Armadale, 22 Jan 2033, her parents unmarried`
#ASSERT `Am I a citizen by birth under s 12` `Luca in Perth, 2 Feb 2030`
#ASSERT (NOT (`Am I a citizen by birth under s 12` `a child of temporary visa holders born in Perth in 2030`))
#ASSERT `Am I a citizen by birth under s 12` `a child of temporary visa holders born in Perth in 2000, resident until 2010`
#ASSERT (NOT (`Am I a citizen by birth under s 12` `a child born under enemy occupation to an enemy alien in 2030`))

§ `ss 16-19A -- citizenship by descent (daniel d036: Anjali; approval ASSUMED 1 Sep 2027)`

#ASSERT `Am I eligible for citizenship by descent` `Anjali, born in London on 14 Jun 2027`
#ASSERT (NOT (`Am I eligible for citizenship by descent` `a child born abroad to a citizen by descent who never lived in Australia`))
#ASSERT `Am I eligible for citizenship by descent` `the same child, stateless from birth`
#ASSERT (NOT (`Am I eligible for citizenship by descent` `an adult born abroad to a citizen, not of good character`))

#ASSERT `Must the Minister approve me by descent` `Anjali, born in London on 14 Jun 2027` TRUE FALSE
#ASSERT (NOT (`Must the Minister approve me by descent` `Anjali, born in London on 14 Jun 2027` FALSE FALSE))

#ASSERT (NOT (`Am I a citizen by descent on that date` `Anjali, born in London on 14 Jun 2027` TRUE 20270901 20270614))
#ASSERT `Am I a citizen by descent on that date` `Anjali, born in London on 14 Jun 2027` TRUE 20270901 20270901

-- Regulation s 6: registration is a record on the Department's data storage system, made after approval.
#ASSERT `Have I been registered as a citizen by descent` TRUE TRUE TRUE
#ASSERT (NOT (`Have I been registered as a citizen by descent` FALSE TRUE TRUE))

§ `s 22 -- the general residence requirement (daniel d041)`

