IMPORT daydate

-- National Disability Insurance Scheme Act 2013 (Cth), compensation encoding: the date arithmetic, kept in one small
-- module so that daydate is imported in one place only. See NOTES.md.

-- The day N days after a day (day + N).
GIVEN `the day` IS A DATE, `n` IS A NUMBER
GIVETH A DATE
`the day N days after` MEANS
    DATE_FROM_SERIAL (DATE_SERIAL `the day` PLUS `n`)

-- The same day of the month N months later; a day the later month lacks becomes its last day (31 August + 6 months is
-- 28 or 29 February).
GIVEN `the day` IS A DATE, `n` IS A NUMBER
GIVETH A DATE
`the day N months after` MEANS
    `add months` `the day` `n`

-- The number of days from the first day to the second (negative if the second is earlier).
GIVEN `from` IS A DATE, `to` IS A DATE
GIVETH A NUMBER
`days from` MEANS
    DATE_SERIAL `to` MINUS DATE_SERIAL `from`

-- A date from day, month and year, for the case file (which does not import daydate itself).
GIVEN `d` IS A NUMBER, `m` IS A NUMBER, `y` IS A NUMBER
GIVETH A DATE
`the date` MEANS
    Date `d` `m` `y`
