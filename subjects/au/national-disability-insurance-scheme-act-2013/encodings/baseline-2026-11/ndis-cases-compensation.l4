IMPORT prelude
IMPORT `ndis-comp-dates`
IMPORT `ndis-compensation`

-- Cases for ndis-compensation.l4. Every expected value is worked by hand from the deposited text (section cited), not
-- copied from the encoding's output. Edges: the 28-day minimum and its last day, the 29th day after a s 105(6) warning,
-- s 106(4) just biting and not, the s 106(5)/107(4) difference used up, a whole s 116 disregard, the s 110 "whichever is
-- later", the 3-month review period ending on 28 February, the s 183 recovery period's last day and the day after,
-- $200 in s 193, and 80% in s 194(3).

-- s 11 compensation
#ASSERT `Is this payment compensation` `compensation or damages for a personal injury` TRUE
#ASSERT `Is this payment compensation` `a personal injury, under a Commonwealth, State or Territory insurance or compensation scheme` TRUE
#ASSERT (NOT (`Is this payment compensation` `a personal injury, in settlement of a claim for damages or under such a scheme` FALSE))
#ASSERT `Is this payment compensation` `a personal injury, in settlement of a claim for damages or under such a scheme` TRUE
#ASSERT (NOT (`Is this payment compensation` `something else` TRUE))

-- s 104 the CEO's notice
#ASSERT `Can the CEO require me to take action to claim compensation` `a participant` TRUE `nothing` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Can the CEO require me to take action to claim compensation` `a prospective participant` TRUE `nothing reasonable` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Can the CEO require me to take action to claim compensation` `neither` TRUE `nothing` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Can the CEO require me to take action to claim compensation` `a participant` FALSE `nothing` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Can the CEO require me to take action to claim compensation` `a participant` TRUE `reasonable action` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Can the CEO require me to take action to claim compensation` `a participant` TRUE `nothing` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Can the CEO require me to take action to claim compensation` `a participant` TRUE `nothing` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `Can the CEO require me to take action to claim compensation` `a participant` TRUE `nothing` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Can the CEO require me to take action to claim compensation` `a participant` TRUE `reasonable action` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Can the CEO require me to take action to claim compensation` `a participant` TRUE `nothing` TRUE FALSE FALSE EQUALS JUST FALSE

-- ss 104(5), (5A), 105(1) the period: notice given 2 November 2026
#ASSERT `By when must I take the required action` (`the date` 2 11 2026) 28 0 EQUALS JUST (`the date` 30 11 2026)
#ASSERT `By when must I take the required action` (`the date` 2 11 2026) 27 0 EQUALS NOTHING
#ASSERT `By when must I take the required action` (`the date` 2 11 2026) 28 14 EQUALS JUST (`the date` 14 12 2026)
#ASSERT `By when must I take the required action` (`the date` 15 12 2026) 60 0 EQUALS JUST (`the date` 13 2 2027)
#ASSERT `Have I taken the required action in time` (`the date` 2 11 2026) 28 0 TRUE (`the date` 30 11 2026) EQUALS JUST TRUE
#ASSERT `Have I taken the required action in time` (`the date` 2 11 2026) 28 0 TRUE (`the date` 1 12 2026) EQUALS JUST FALSE
#ASSERT `Have I taken the required action in time` (`the date` 2 11 2026) 28 0 FALSE (`the date` 1 1 2026) EQUALS JUST FALSE
#ASSERT `Have I taken the required action in time` (`the date` 2 11 2026) 28 14 TRUE (`the date` 14 12 2026) EQUALS JUST TRUE
#ASSERT `Have I taken the required action in time` (`the date` 2 11 2026) 28 14 TRUE (`the date` 15 12 2026) EQUALS JUST FALSE
#ASSERT `Have I taken the required action in time` (`the date` 2 11 2026) 28 0 TRUE (`the date` 2 11 2026) EQUALS JUST TRUE
#ASSERT `Have I taken the required action in time` (`the date` 2 11 2026) 20 0 TRUE (`the date` 10 11 2026) EQUALS NOTHING

-- s 105(2), (3) the plan
#ASSERT `What happens to my plan if I do not act` TRUE `I am a participant` TRUE TRUE EQUALS `my plan is not affected`
#ASSERT `What happens to my plan if I do not act` FALSE `I am a participant` TRUE TRUE EQUALS `my plan is suspended from the end of the period until I take the required action`
#ASSERT `What happens to my plan if I do not act` FALSE `I am a participant` TRUE FALSE EQUALS `my plan is prepared but does not come into effect until I take the required action`
#ASSERT `What happens to my plan if I do not act` FALSE `I am a participant` FALSE TRUE EQUALS `my plan is not affected`
#ASSERT `What happens to my plan if I do not act` FALSE `I am a prospective participant` TRUE FALSE EQUALS `my access request may still be decided and my plan prepared, but the plan does not come into effect until I take the required action`
#ASSERT `What happens to my plan if I do not act` FALSE `I am a prospective participant` FALSE FALSE EQUALS `my access request may still be decided and my plan prepared, but the plan does not come into effect until I take the required action`

-- s 41(2) the suspension
#ASSERT `Can NDIS amounts be paid for a support during the suspension` TRUE TRUE EQUALS JUST FALSE
#ASSERT `Can NDIS amounts be paid for a support during the suspension` TRUE FALSE EQUALS NOTHING
#ASSERT `Can NDIS amounts be paid for a support during the suspension` FALSE TRUE EQUALS NOTHING
#ASSERT `Can I ask for a variation or reassessment during the suspension` TRUE EQUALS JUST FALSE
#ASSERT `Can I ask for a variation or reassessment during the suspension` FALSE EQUALS NOTHING

-- s 105(4), (6) the CEO claiming in my name: warning given 1 March 2027
#ASSERT `Can the CEO claim in my name or take over my claim` FALSE FALSE TRUE (`the date` 1 3 2027) (`the date` 30 3 2027)
#ASSERT (NOT (`Can the CEO claim in my name or take over my claim` FALSE FALSE TRUE (`the date` 1 3 2027) (`the date` 29 3 2027)))
#ASSERT (NOT (`Can the CEO claim in my name or take over my claim` FALSE TRUE TRUE (`the date` 1 3 2027) (`the date` 30 4 2027)))
#ASSERT (NOT (`Can the CEO claim in my name or take over my claim` TRUE FALSE TRUE (`the date` 1 3 2027) (`the date` 30 4 2027)))
#ASSERT (NOT (`Can the CEO claim in my name or take over my claim` FALSE FALSE FALSE (`the date` 1 3 2027) (`the date` 30 4 2027)))

-- s 105A(1) costs; s 105B balance
#ASSERT `How much of the costs does the Agency pay` 50000 5000 EQUALS 45000
#ASSERT `How much of the costs does the Agency pay` 10000 0 EQUALS 10000
#ASSERT `How much of the costs does the Agency pay` 10000 12000 EQUALS 0
#ASSERT `How much of the amount obtained is paid to me` 500000 120000 30000 EQUALS 350000
#ASSERT `How much of the amount obtained is paid to me` 100000 90000 20000 EQUALS 0

-- ss 106, 107, 108, 116 the recoverable amount
-- A: judgement not by consent, $1,000,000; past $150,000; component $100,000 (s 106(4) bites); charges $50,000.
#ASSERT `Do I owe the Agency a recoverable amount` `by a judgement that was not by consent` TRUE 1000000 0 150000 TRUE
#ASSERT `How much must I repay the Agency` `by a judgement that was not by consent` TRUE 1000000 0 150000 TRUE 100000 FALSE 0 50000 EQUALS 100000
-- B: component $200,000 (s 106(4) does not bite).
#ASSERT `How much must I repay the Agency` `by a judgement that was not by consent` TRUE 1000000 0 150000 TRUE 200000 FALSE 0 50000 EQUALS 150000
-- B2: component exactly $150,000 (the past amounts do not exceed it).
#ASSERT `How much must I repay the Agency` `by a judgement that was not by consent` TRUE 1000000 0 150000 TRUE 150000 FALSE 0 50000 EQUALS 150000
-- C: 25% apportioned to me: 150,000 x 75% = 112,500.
#ASSERT `How much must I repay the Agency` `by a judgement that was not by consent` TRUE 1000000 0 150000 TRUE 200000 TRUE 25 50000 EQUALS 112500
-- D: judgement not by consent with no past NDIS support component: s 106 does not apply, and s 107 does not either.
#ASSERT (NOT (`Do I owe the Agency a recoverable amount` `by a judgement that was not by consent` TRUE 1000000 0 150000 FALSE))
#ASSERT `How much must I repay the Agency` `by a judgement that was not by consent` TRUE 1000000 0 150000 FALSE 0 FALSE 0 50000 EQUALS 0
-- E: settlement $400,000; past $150,000; 20% apportioned = 120,000; charges $300,000 leave a difference of 100,000.
#ASSERT `How much must I repay the Agency` `by a settlement` TRUE 400000 0 150000 FALSE 0 TRUE 20 300000 EQUALS 100000
-- F: consent judgement $500,000; past $80,000; no charges.
#ASSERT `How much must I repay the Agency` `by a consent judgement` TRUE 500000 0 80000 FALSE 0 FALSE 0 0 EQUALS 80000
-- G: charges ($450,000) use up the settlement ($400,000): s 107 applies but the amount is nil.
#ASSERT `Do I owe the Agency a recoverable amount` `by a settlement` TRUE 400000 0 150000 FALSE
#ASSERT `How much must I repay the Agency` `by a settlement` TRUE 400000 0 150000 FALSE 0 FALSE 0 450000 EQUALS 0
-- G2: the difference is $1 short of the past amounts.
#ASSERT `How much must I repay the Agency` `by a settlement` TRUE 200000 0 150000 FALSE 0 FALSE 0 50001 EQUALS 149999
-- H: the injury did not cause the impairment.
#ASSERT (NOT (`Do I owe the Agency a recoverable amount` `by a settlement` FALSE 400000 0 150000 FALSE))
#ASSERT `How much must I repay the Agency` `by a settlement` FALSE 400000 0 150000 FALSE 0 FALSE 0 0 EQUALS 0
-- I: no NDIS amounts before the settlement.
#ASSERT (NOT (`Do I owe the Agency a recoverable amount` `by a settlement` TRUE 400000 0 0 FALSE))
-- J: s 116, the whole payment disregarded.
#ASSERT (NOT (`Do I owe the Agency a recoverable amount` `by a settlement` TRUE 400000 400000 150000 FALSE))
#ASSERT `How much must I repay the Agency` `by a settlement` TRUE 400000 400000 150000 FALSE 0 FALSE 0 0 EQUALS 0
-- K: s 116, $300,000 of $400,000 disregarded: the difference is 100,000.
#ASSERT `How much must I repay the Agency` `by a settlement` TRUE 400000 300000 150000 FALSE 0 FALSE 0 0 EQUALS 100000
-- L: not yet fixed.
#ASSERT (NOT (`Do I owe the Agency a recoverable amount` `it has not been fixed` TRUE 0 0 150000 FALSE))

-- s 110: by when the person I claim against must tell the CEO (the later of the two days, plus 7)
#ASSERT `By when must the person I claim against tell the CEO` (`the date` 1 3 2027) (`the date` 10 3 2027) EQUALS `the date` 17 3 2027
#ASSERT `By when must the person I claim against tell the CEO` (`the date` 1 3 2027) (`the date` 20 2 2027) EQUALS `the date` 8 3 2027
#ASSERT `By when must the person I claim against tell the CEO` (`the date` 1 3 2027) (`the date` 1 3 2027) EQUALS `the date` 8 3 2027

-- ss 112, 114: can I be paid
#ASSERT `Can the person I claim against pay me now` `no notice` FALSE FALSE FALSE EQUALS `the NDIS Act does not stop the payment`
#ASSERT `Can the person I claim against pay me now` `a preliminary notice under s 109` FALSE FALSE FALSE EQUALS `it must not pay me while the notice has effect`
#ASSERT `Can the person I claim against pay me now` `a preliminary notice under s 109` TRUE FALSE FALSE EQUALS `the NDIS Act does not stop the payment`
#ASSERT `Can the person I claim against pay me now` `a preliminary notice under s 109` FALSE TRUE FALSE EQUALS `it must not pay me while the notice has effect`
#ASSERT `Can the person I claim against pay me now` `a preliminary notice under s 109` FALSE FALSE TRUE EQUALS `the NDIS Act does not stop the payment`
#ASSERT `Can the person I claim against pay me now` `a recovery notice under s 111` FALSE TRUE FALSE EQUALS `the NDIS Act does not stop the payment`
#ASSERT `Can the person I claim against pay me now` `a recovery notice under s 111` TRUE FALSE FALSE EQUALS `it must not pay me while the notice has effect`
#ASSERT `Can the person I claim against pay me now` `a recovery notice under s 111` FALSE FALSE TRUE EQUALS `the NDIS Act does not stop the payment`

-- s 111(4): the lesser of the NDIS amounts and the recoverable amount (case A: 100,000)
#ASSERT `How much can the Agency recover from the person I claim against` 180000 `by a judgement that was not by consent` TRUE 1000000 0 150000 TRUE 100000 FALSE 0 50000 EQUALS JUST 100000
#ASSERT `How much can the Agency recover from the person I claim against` 90000 `by a judgement that was not by consent` TRUE 1000000 0 150000 TRUE 100000 FALSE 0 50000 EQUALS JUST 90000
#ASSERT `How much can the Agency recover from the person I claim against` 180000 `it has not been fixed` TRUE 0 0 150000 FALSE 0 FALSE 0 0 EQUALS NOTHING
#ASSERT `How much can the Agency recover from the person I claim against` 180000 `by a judgement that was not by consent` TRUE 1000000 0 150000 FALSE 0 FALSE 0 0 EQUALS NOTHING

-- s 113: discharge
#ASSERT `How much compensation is still owed to me` 500000 100000 EQUALS 400000
#ASSERT `How much compensation is still owed to me` 50000 60000 EQUALS 0
#ASSERT `How much do I still owe the Agency` 100000 100000 EQUALS 0
#ASSERT `How much do I still owe the Agency` 120000 100000 EQUALS 20000

-- ss 99, 100(2): review
#ASSERT `Can I ask for review of this decision` `a notice requiring me to take action to claim compensation (s 104)`
#ASSERT `Can I ask for review of this decision` `a refusal to extend the period to take that action (s 104(5A))`
#ASSERT `Can I ask for review of this decision` `a decision to claim compensation in my name (s 105(4)(a))`
#ASSERT `Can I ask for review of this decision` `a decision to take over my claim (s 105(4)(b))`
#ASSERT `Can I ask for review of this decision` `a recovery notice to the person I claim against (s 111)`
#ASSERT `Can I ask for review of this decision` `a decision not to disregard part of my compensation (s 116)`
#ASSERT `Can I ask for review of this decision` `a decision not to waive my debt as a small debt (s 193)`
#ASSERT `Can I ask for review of this decision` `a decision that the CEO is not required to waive part of my debt (s 194(3) or (4))`
#ASSERT `Can I ask for review of this decision` `a decision not to waive my debt in special circumstances (s 195)`
#ASSERT (NOT (`Can I ask for review of this decision` `the recoverable amount under s 106 or s 107`))
#ASSERT `By when must I ask for review` `a decision not to waive my debt in special circumstances (s 195)` (`the date` 31 8 2027) EQUALS JUST (`the date` 30 11 2027)
#ASSERT `By when must I ask for review` `a recovery notice to the person I claim against (s 111)` (`the date` 30 11 2026) EQUALS JUST (`the date` 28 2 2027)
#ASSERT `By when must I ask for review` `a notice requiring me to take action to claim compensation (s 104)` (`the date` 15 1 2027) EQUALS JUST (`the date` 15 4 2027)
#ASSERT `By when must I ask for review` `the recoverable amount under s 106 or s 107` (`the date` 15 1 2027) EQUALS NOTHING

-- s 183: the Agency became aware on 1 July 2027 (unless stated); 1 January 2000 stands for "no such day"
#ASSERT `By when must the Agency sue me for the debt` (`the date` 1 7 2027) FALSE (`the date` 1 1 2000) FALSE (`the date` 1 1 2000) FALSE (`the date` 1 1 2000) EQUALS `the date` 30 6 2033
#ASSERT `By when must the Agency sue me for the debt` (`the date` 1 7 2027) TRUE (`the date` 1 7 2030) FALSE (`the date` 1 1 2000) FALSE (`the date` 1 1 2000) EQUALS `the date` 30 6 2036
#ASSERT `By when must the Agency sue me for the debt` (`the date` 1 7 2027) TRUE (`the date` 1 7 2030) TRUE (`the date` 15 3 2031) FALSE (`the date` 1 1 2000) EQUALS `the date` 14 3 2037
#ASSERT `By when must the Agency sue me for the debt` (`the date` 1 7 2027) FALSE (`the date` 1 1 2000) FALSE (`the date` 1 1 2000) TRUE (`the date` 1 7 2032) EQUALS `the date` 1 7 2038
#ASSERT `By when must the Agency sue me for the debt` (`the date` 1 7 2027) TRUE (`the date` 30 6 2033) FALSE (`the date` 1 1 2000) FALSE (`the date` 1 1 2000) EQUALS `the date` 29 6 2039
#ASSERT `By when must the Agency sue me for the debt` (`the date` 1 7 2027) TRUE (`the date` 1 7 2033) FALSE (`the date` 1 1 2000) FALSE (`the date` 1 1 2000) EQUALS `the date` 30 6 2033
#ASSERT `By when must the Agency sue me for the debt` (`the date` 1 7 2027) TRUE (`the date` 1 6 2027) FALSE (`the date` 1 1 2000) FALSE (`the date` 1 1 2000) EQUALS `the date` 30 6 2033
#ASSERT `By when must the Agency sue me for the debt` (`the date` 29 2 2028) FALSE (`the date` 1 1 2000) FALSE (`the date` 1 1 2000) FALSE (`the date` 1 1 2000) EQUALS `the date` 28 2 2034
#ASSERT `By when must the Agency sue me for the debt` (`the date` 1 3 2028) FALSE (`the date` 1 1 2000) FALSE (`the date` 1 1 2000) FALSE (`the date` 1 1 2000) EQUALS `the date` 28 2 2034

-- s 193 small debt
#ASSERT `Can my debt be waived as a small debt` 199.99 TRUE
#ASSERT (NOT (`Can my debt be waived as a small debt` 200 TRUE))
#ASSERT (NOT (`Can my debt be waived as a small debt` 150 FALSE))

-- s 194 settlements and part recovery
#ASSERT `How much of my debt must be waived` `the Agency settled a civil action against me for less than the debt` 10000 6000 FALSE EQUALS 4000
#ASSERT `How much of my debt must be waived` `the CEO settled Tribunal proceedings on my paying less than the debt` 10000 7500 FALSE EQUALS 2500
#ASSERT `How much of my debt must be waived` `the Agency recovered at least part and agreed that is in full satisfaction` 10000 8000 TRUE EQUALS 2000
#ASSERT `How much of my debt must be waived` `the Agency recovered at least part and agreed that is in full satisfaction` 10000 7999 TRUE EQUALS 0
#ASSERT `How much of my debt must be waived` `the Agency recovered at least part and agreed that is in full satisfaction` 10000 9000 FALSE EQUALS 0
#ASSERT `How much of my debt must be waived` `the CEO agreed that a lesser amount fully satisfies the outstanding debt` 5000 4000 FALSE EQUALS 1000
#ASSERT `How much of my debt must be waived` `none of these` 5000 4000 TRUE EQUALS 0

-- s 195 special circumstances
#ASSERT `Can my debt be waived in special circumstances` FALSE TRUE TRUE
#ASSERT (NOT (`Can my debt be waived in special circumstances` TRUE TRUE TRUE))
#ASSERT (NOT (`Can my debt be waived in special circumstances` FALSE FALSE TRUE))
#ASSERT (NOT (`Can my debt be waived in special circumstances` FALSE TRUE FALSE))
