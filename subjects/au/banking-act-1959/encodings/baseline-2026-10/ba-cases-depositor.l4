    `interest accrued but not credited` IS 0
    `clearance adjustment under the regulations` IS 0
    `number of account-holders` IS 1

`Chloe's bank, failed and declared` MEANS Bank WITH
    `is an ADI` IS TRUE
    `is a foreign ADI` IS FALSE
    `APRA has applied under s 16AAA for it to be wound up` IS TRUE
    `a Banking Act statutory manager is in control` IS FALSE
    `the Minister has declared it under s 16AD` IS TRUE
    `the declaration time is on or after 12 October 2011` IS TRUE
    `was a declared ADI on 12 October 2011` IS FALSE
    `a transfer certificate under a transferred liabilities determination has issued` IS FALSE

`a failing bank not yet declared` MEANS Bank WITH
    `is an ADI` IS TRUE
    `is a foreign ADI` IS FALSE
    `APRA has applied under s 16AAA for it to be wound up` IS TRUE
    `a Banking Act statutory manager is in control` IS FALSE
    `the Minister has declared it under s 16AD` IS FALSE
    `the declaration time is on or after 12 October 2011` IS TRUE
    `was a declared ADI on 12 October 2011` IS FALSE
    `a transfer certificate under a transferred liabilities determination has issued` IS FALSE

`a healthy bank the Minister purports to declare` MEANS Bank WITH
    `is an ADI` IS TRUE
    `is a foreign ADI` IS FALSE
    `APRA has applied under s 16AAA for it to be wound up` IS FALSE
    `a Banking Act statutory manager is in control` IS FALSE
    `the Minister has declared it under s 16AD` IS TRUE
    `the declaration time is on or after 12 October 2011` IS TRUE
    `was a declared ADI on 12 October 2011` IS FALSE
    `a transfer certificate under a transferred liabilities determination has issued` IS FALSE

`a foreign ADI, failed and declared` MEANS Bank WITH
    `is an ADI` IS TRUE
    `is a foreign ADI` IS TRUE
    `APRA has applied under s 16AAA for it to be wound up` IS TRUE
    `a Banking Act statutory manager is in control` IS FALSE
    `the Minister has declared it under s 16AD` IS TRUE
    `the declaration time is on or after 12 October 2011` IS TRUE
    `was a declared ADI on 12 October 2011` IS FALSE
    `a transfer certificate under a transferred liabilities determination has issued` IS FALSE

`a bank under a statutory manager, declared` MEANS Bank WITH
    `is an ADI` IS TRUE
    `is a foreign ADI` IS FALSE
    `APRA has applied under s 16AAA for it to be wound up` IS FALSE
    `a Banking Act statutory manager is in control` IS TRUE
    `the Minister has declared it under s 16AD` IS TRUE
    `the declaration time is on or after 12 October 2011` IS TRUE
    `was a declared ADI on 12 October 2011` IS FALSE
    `a transfer certificate under a transferred liabilities determination has issued` IS FALSE

`a bank declared before 12 October 2011` MEANS Bank WITH
    `is an ADI` IS TRUE
    `is a foreign ADI` IS FALSE
    `APRA has applied under s 16AAA for it to be wound up` IS TRUE
    `a Banking Act statutory manager is in control` IS FALSE
    `the Minister has declared it under s 16AD` IS TRUE
    `the declaration time is on or after 12 October 2011` IS FALSE
    `was a declared ADI on 12 October 2011` IS FALSE
    `a transfer certificate under a transferred liabilities determination has issued` IS FALSE

`a bank that was already declared on 12 October 2011` MEANS Bank WITH
    `is an ADI` IS TRUE
    `is a foreign ADI` IS FALSE
    `APRA has applied under s 16AAA for it to be wound up` IS TRUE
    `a Banking Act statutory manager is in control` IS FALSE
    `the Minister has declared it under s 16AD` IS TRUE
    `the declaration time is on or after 12 October 2011` IS TRUE
    `was a declared ADI on 12 October 2011` IS TRUE
    `a transfer certificate under a transferred liabilities determination has issued` IS FALSE

`a declared bank whose accounts went to a receiving body` MEANS Bank WITH
    `is an ADI` IS TRUE
    `is a foreign ADI` IS FALSE
    `APRA has applied under s 16AAA for it to be wound up` IS TRUE
    `a Banking Act statutory manager is in control` IS FALSE
    `the Minister has declared it under s 16AD` IS TRUE
    `the declaration time is on or after 12 October 2011` IS TRUE
    `was a declared ADI on 12 October 2011` IS FALSE
    `a transfer certificate under a transferred liabilities determination has issued` IS TRUE

-- c012: Chloe's account (in her name) -- is she an account-holder, and is her mother, the signatory?
#ASSERT `Am I an account-holder` TRUE TRUE
#ASSERT NOT `Am I an account-holder` FALSE TRUE

-- c012: are Chloe's deposits protected, and what would she be paid if her bank failed?
#ASSERT `Is my account protected` `Chloe's children's savings account (c012)` `Chloe's bank, failed and declared`
#ASSERT `Can the scheme be switched on for my bank` `Chloe's bank, failed and declared`
#ASSERT `Is my bank a declared ADI` `Chloe's bank, failed and declared`
#ASSERT `My share of this account before the limit` `Chloe's children's savings account (c012)` `Chloe's bank, failed and declared` EQUALS 502
#ASSERT `How much does APRA pay me` (LIST `Chloe's children's savings account (c012)`) `Chloe's bank, failed and declared` 250000 EQUALS (`Paid by APRA` 502)
#ASSERT `Is all my protected money covered` (LIST `Chloe's children's savings account (c012)`) `Chloe's bank, failed and declared` 250000
#ASSERT `How much can I still claim from the bank` (LIST `Chloe's children's savings account (c012)`) `Chloe's bank, failed and declared` 250000 EQUALS 0
#ASSERT `Is my account a children's account` TRUE TRUE FALSE
-- c012: and if she left it untouched for 8 years -- a children's account is never unclaimed moneys (s 69(1A)(b)).
#ASSERT NOT `Is my money unclaimed` 8 0 FALSE TRUE FALSE FALSE FALSE

-- s 16AD: when the scheme can be switched on, and that it cannot be switched off.
#ASSERT NOT `Is my bank a declared ADI` `a failing bank not yet declared`
#ASSERT `Can the scheme be switched on for my bank` `a failing bank not yet declared`
#ASSERT NOT `Can the scheme be switched on for my bank` `a healthy bank the Minister purports to declare`
#ASSERT NOT `Is my bank a declared ADI` `a healthy bank the Minister purports to declare`
#ASSERT NOT `Can the scheme be switched on for my bank` `a foreign ADI, failed and declared`
#ASSERT `Is my bank a declared ADI` `a bank under a statutory manager, declared`
#ASSERT NOT `Can the declaration be revoked`

-- s 5(4)-(7): which accounts are protected.
#ASSERT NOT `Is my account protected` `a US dollar account` `Chloe's bank, failed and declared`
#ASSERT `Is my account protected` `a US dollar account` `a bank declared before 12 October 2011`
#ASSERT `Is my account protected` `a US dollar account` `a bank that was already declared on 12 October 2011`
#ASSERT NOT `Is my account protected` `an account the regulations exclude` `Chloe's bank, failed and declared`
#ASSERT NOT `Is my account protected` `a covered financial product that is not an account` `Chloe's bank, failed and declared`
#ASSERT `Is my account protected` `a covered financial product that is not an account` `a bank under a statutory manager, declared`
#ASSERT NOT `Is my account protected` `a fixed product not repayable on demand` `Chloe's bank, failed and declared`
#ASSERT `Is my account protected` `a fixed product the regulations prescribe as protected` `Chloe's bank, failed and declared`

-- s 16AF: balance plus accrued interest, adjusted for clearance; equal shares of a joint account.
#ASSERT `My share of this account before the limit` `a joint account of $300,000 with two holders` `Chloe's bank, failed and declared` EQUALS 150000
#ASSERT `My share of this account before the limit` `a joint account of $1,000 plus $10 interest with two holders` `Chloe's bank, failed and declared` EQUALS 505
#ASSERT `My share of this account before the limit` `an account of $1,000 with a $200 clearance debit` `Chloe's bank, failed and declared` EQUALS 800
#ASSERT `My share of this account before the limit` `an empty account` `Chloe's bank, failed and declared` EQUALS 0
#ASSERT `My share of this account before the limit` `Chloe's children's savings account (c012)` `a failing bank not yet declared` EQUALS 0

-- s 16AG: one limit per account-holder per bank.
#ASSERT `What is the most I can be paid at this bank` 250000 EQUALS 250000
#ASSERT `How much does APRA pay me` (LIST `a single account of $300,000`) `Chloe's bank, failed and declared` 250000 EQUALS (`Paid by APRA` 250000)
#ASSERT NOT `Is all my protected money covered` (LIST `a single account of $300,000`) `Chloe's bank, failed and declared` 250000
#ASSERT `How much does APRA pay me` (LIST `a joint account of $300,000 with two holders`) `Chloe's bank, failed and declared` 250000 EQUALS (`Paid by APRA` 150000)
#ASSERT `How much does APRA pay me` (LIST `a single account of $200,000`, `a joint account of $300,000 with two holders`) `Chloe's bank, failed and declared` 250000 EQUALS (`Paid by APRA` 250000)
#ASSERT `How much does APRA pay me` (LIST `a single account of $200,000`, `a US dollar account`) `Chloe's bank, failed and declared` 250000 EQUALS (`Paid by APRA` 200000)

-- s 16AI: what I still claim from the bank myself.
#ASSERT `How much can I still claim from the bank` (LIST `a single account of $300,000`) `Chloe's bank, failed and declared` 250000 EQUALS 50000
#ASSERT `How much can I still claim from the bank` (LIST `a single account of $200,000`, `a joint account of $300,000 with two holders`) `Chloe's bank, failed and declared` 250000 EQUALS 100000

-- When APRA pays nothing.
#ASSERT `How much does APRA pay me` (LIST `Chloe's children's savings account (c012)`) `a failing bank not yet declared` 250000 EQUALS `Nothing: the scheme has not been switched on for my bank`
#ASSERT `How much does APRA pay me` (LIST `an empty account`, `a US dollar account`) `Chloe's bank, failed and declared` 250000 EQUALS `Nothing: I have no protected account in credit with my bank`
#ASSERT `How much does APRA pay me` (LIST `Chloe's children's savings account (c012)`) `a declared bank whose accounts went to a receiving body` 250000 EQUALS `Nothing from APRA: my protected accounts went to a receiving body`

-- s 16AH, 16AHA: how I am paid, and my statement.
#ASSERT `How may I be paid` EQUALS LIST `paid to me as a single amount or in instalments`, `applied for my benefit, for example by opening an account for me with another ADI`, `partly paid to me and the rest applied for my benefit`
#ASSERT `Can APRA open an account for me without my consent` FALSE
#ASSERT NOT `Can APRA open an account for me without my consent` TRUE
#ASSERT `Must APRA open an account of the same kind for me` TRUE TRUE
#ASSERT NOT `Must APRA open an account of the same kind for me` TRUE FALSE
#ASSERT `Days after year end for my statement` EQUALS 14
#ASSERT `Must APRA send me a statement` 502
#ASSERT NOT `Must APRA send me a statement` 0

-- s 69(12): children's account.
#ASSERT NOT `Is my account a children's account` FALSE TRUE FALSE
#ASSERT `Is my account a children's account` TRUE FALSE TRUE

-- s 69(1)-(2): unclaimed moneys (args: years, regs years, time expired, children's, foreign, FMD, regs exclude).
#ASSERT `Years untouched before money is unclaimed` 0 EQUALS 7
#ASSERT `Is my money unclaimed` 7 0 FALSE FALSE FALSE FALSE FALSE
#ASSERT NOT `Is my money unclaimed` 6 0 FALSE FALSE FALSE FALSE FALSE
#ASSERT NOT `Is my money unclaimed` 8 10 FALSE FALSE FALSE FALSE FALSE
#ASSERT `Is my money unclaimed` 2 0 TRUE FALSE FALSE FALSE FALSE
#ASSERT NOT `Is my money unclaimed` 9 0 FALSE FALSE TRUE FALSE FALSE
#ASSERT NOT `Is my money unclaimed` 9 0 FALSE FALSE FALSE TRUE FALSE
#ASSERT NOT `Is my money unclaimed` 9 0 FALSE FALSE FALSE FALSE TRUE

-- s 69(3), (5): the handover to the Commonwealth (args: unclaimed, amount, threshold, RSA, used, told active).
#ASSERT `Will my money go to the Commonwealth` TRUE 150 100 FALSE FALSE FALSE
#ASSERT NOT `Will my money go to the Commonwealth` TRUE 99 100 FALSE FALSE FALSE
#ASSERT NOT `Will my money go to the Commonwealth` TRUE 150 100 FALSE TRUE FALSE
#ASSERT NOT `Will my money go to the Commonwealth` TRUE 150 100 FALSE FALSE TRUE
#ASSERT NOT `Will my money go to the Commonwealth` TRUE 150 100 TRUE FALSE FALSE
#ASSERT NOT `Will my money go to the Commonwealth` FALSE 150 100 FALSE FALSE FALSE
#ASSERT `Months after 31 December for the handover` EQUALS 3

-- s 69(7), (7AA): getting it back.
#ASSERT `How much do I get back` 150 TRUE TRUE 12 EQUALS 162
#ASSERT `How much do I get back` 150 FALSE TRUE 12 EQUALS 0
