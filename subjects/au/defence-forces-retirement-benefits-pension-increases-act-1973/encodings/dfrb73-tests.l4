IMPORT prelude
IMPORT daydate
IMPORT `dfrb73-rules`

§ `Tests`

-- CPI 100 → 110 (10%, ×1.4 = 14%); AWE 100 → 112 (12%): 12%.
GIVEN on IS A DATE
GIVETH A `DFRB pension`
`retired on` on MEANS `DFRB pension` OF 110, 100, 112, 100, 2000, on, FALSE

#ASSERT `the prescribed percentage for` (`retired on` (Date 1 1 1970)) EQUALS 12
-- 12% of 77.5% of $2,000 = $186.
#ASSERT `my DFRB pension increase for` (`retired on` (Date 1 1 1970)) EQUALS 186
-- CPI 100 → 105 (×1.4 = 7%) below AWE 12%: 7%.
#ASSERT `the prescribed percentage for` (`DFRB pension` OF 105, 100, 112, 100, 2000, Date 1 1 1970, FALSE) EQUALS 7
-- Rounding: 7.04 → 7.0; 7.05 → 7.1.
#ASSERT `rounded to a tenth` 7.04 EQUALS 7
#ASSERT `rounded to a tenth` 7.05 EQUALS 7.1
#ASSERT `my DFRB pension increase for` (`DFRB pension` OF 100, 100, 112, 100, 2000, Date 1 1 1970, FALSE) EQUALS 0
#ASSERT `my DFRB pension increase for` (`DFRB pension` OF 110, 100, 112, 100, 2000, Date 1 1 1970, TRUE) EQUALS 0
-- s 7: retired 30 September 1972: 1 October 1972 to 30 June 1973 is 9 months.
#ASSERT `the months for s 7 for` (`retired on` (Date 30 9 1972)) EQUALS 9
#ASSERT `my DFRB pension increase for` (`retired on` (Date 30 9 1972)) EQUALS 186 TIMES 9 DIVIDED BY 21
-- Retired 30 September 1971: before 1 October 1971, full increase.
#ASSERT `my DFRB pension increase for` (`retired on` (Date 30 9 1971)) EQUALS 186
-- Retired 1 October 1971: 2 Oct 1971 – 30 Jun 1973 is 20 months and 29 days: 21.
#ASSERT `the months for s 7 for` (`retired on` (Date 1 10 1971)) EQUALS 21
-- Retired 14 June 1973: 15–30 June is 16 days of 30, a half: 1.
#ASSERT `the months for s 7 for` (`retired on` (Date 14 6 1973)) EQUALS 1
-- Retired 25 June 1973: 5 days, under a month: 1 (s 7(4)).
#ASSERT `the months for s 7 for` (`retired on` (Date 25 6 1973)) EQUALS 1
-- Retired 10 April 1973: 11 April – 30 June: 2 months and 20 days (of 30): 3.
#ASSERT `the months for s 7 for` (`retired on` (Date 10 4 1973)) EQUALS 3
-- Retired 20 April 1973: 21 April – 30 June: 2 months and 10 days: 2.
#ASSERT `the months for s 7 for` (`retired on` (Date 20 4 1973)) EQUALS 2
