IMPORT prelude
IMPORT daydate
IMPORT `dfrb73-rules`

-- Independent tests, from independent-expectations.md (written before reading the rules).
-- Defaults: A 110, B 100, C 120, D 100, pension 1000, not a child's pension.

GIVEN rd IS A DATE
GIVETH A `DFRB pension`
`base retired on` rd MEANS `DFRB pension` OF 110, 100, 120, 100, 1000, rd, FALSE

GIVEN ca IS A NUMBER, cb IS A NUMBER, cc IS A NUMBER, cd IS A NUMBER, amt IS A NUMBER
GIVETH A `DFRB pension`
`indices` ca cb cc cd `pension` amt MEANS `DFRB pension` OF ca, cb, cc, cd, amt, Date 1 1 1970, FALSE

-- 1: CPI limb lower
#ASSERT `the prescribed percentage for` (`base retired on` (Date 1 1 1970)) EQUALS 14
#ASSERT `my DFRB pension increase for` (`base retired on` (Date 1 1 1970)) EQUALS 108.5
-- 2: earnings limb lower
#ASSERT `the prescribed percentage for` (`indices` 110 100 105 100 `pension` 2000) EQUALS 5
#ASSERT `my DFRB pension increase for` (`indices` 110 100 105 100 `pension` 2000) EQUALS 77.5
-- 3: tie at 7
#ASSERT `the prescribed percentage for` (`indices` 105 100 107 100 `pension` 1000) EQUALS 7
#ASSERT `my DFRB pension increase for` (`indices` 105 100 107 100 `pension` 1000) EQUALS 54.25
-- 4: 4.64 -> 4.6 (s 4(4)(a))
#ASSERT `the prescribed percentage for` (`indices` 110 100 10464 10000 `pension` 1000) EQUALS 4.6
#ASSERT `my DFRB pension increase for` (`indices` 110 100 10464 10000 `pension` 1000) EQUALS 35.65
-- 5: 4.65 -> 4.7 (s 4(4)(b), exactly half a tenth)
#ASSERT `the prescribed percentage for` (`indices` 110 100 10465 10000 `pension` 1000) EQUALS 4.7
#ASSERT `my DFRB pension increase for` (`indices` 110 100 10465 10000 `pension` 1000) EQUALS 36.425
-- 6: CPI limb 4.62 -> 4.6
#ASSERT `the prescribed percentage for` (`indices` 1033 1000 120 100 `pension` 1000) EQUALS 4.6
-- 7, 8: no rise, no increase
#ASSERT `my DFRB pension increase for` (`indices` 100 100 120 100 `pension` 1000) EQUALS 0
#ASSERT `my DFRB pension increase for` (`indices` 110 100 100 100 `pension` 1000) EQUALS 0
-- 9: child's pension
#ASSERT `my DFRB pension increase for` (`DFRB pension` OF 110, 100, 120, 100, 1000, Date 1 1 1970, TRUE) EQUALS 0
-- 10: retirement 30 Sept 1971, no s 7
#ASSERT `my DFRB pension increase for` (`base retired on` (Date 30 9 1971)) EQUALS 108.5
-- 11: retirement 1 Oct 1971: 21 months
#ASSERT `the months for s 7 for` (`base retired on` (Date 1 10 1971)) EQUALS 21
#ASSERT `my DFRB pension increase for` (`base retired on` (Date 1 10 1971)) EQUALS 108.5
-- 12: retirement 30 June 1972: 12 months
#ASSERT `the months for s 7 for` (`base retired on` (Date 30 6 1972)) EQUALS 12
#ASSERT `my DFRB pension increase for` (`base retired on` (Date 30 6 1972)) EQUALS 62
-- 13: retirement 15 Mar 1972: part of 15 days of 30 counts -> 16
#ASSERT `the months for s 7 for` (`base retired on` (Date 15 3 1972)) EQUALS 16
#ASSERT `my DFRB pension increase for` (`base retired on` (Date 15 3 1972)) EQUALS 248/3
-- 14: retirement 16 Mar 1972: part of 14 days dropped -> 15
#ASSERT `the months for s 7 for` (`base retired on` (Date 16 3 1972)) EQUALS 15
#ASSERT `my DFRB pension increase for` (`base retired on` (Date 16 3 1972)) EQUALS 77.5
-- 15: retirement 30 Sept 1972: 9 months
#ASSERT `the months for s 7 for` (`base retired on` (Date 30 9 1972)) EQUALS 9
#ASSERT `my DFRB pension increase for` (`base retired on` (Date 30 9 1972)) EQUALS 46.5
-- 16: widow, husband retired 1 Jan 1970 (s 4(5): retirement date governs)
#ASSERT `my DFRB pension increase for` (`base retired on` (Date 1 1 1970)) EQUALS 108.5
-- 17: widow, husband died in service 30 June 1972
#ASSERT `my DFRB pension increase for` (`base retired on` (Date 30 6 1972)) EQUALS 62
-- Reading of s 4(1): retirement after 30 Sept 1972 is not a "pension", so no increase
#ASSERT `my DFRB pension increase for` (`base retired on` (Date 1 10 1972)) EQUALS 0
#ASSERT `my DFRB pension increase for` (`base retired on` (Date 20 6 1973)) EQUALS 0
