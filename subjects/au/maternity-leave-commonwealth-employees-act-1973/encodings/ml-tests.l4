IMPORT prelude
IMPORT daydate
IMPORT `ml-rules`

-- Maternity Leave (Commonwealth Employees) Act 1973 (Cth) — the encoder's
-- tests.

§ `Tests`

-- Expected date of birth 1 July 2026; 6 weeks before is 20 May 2026.
GIVEN conf IS A MAYBE DATE, cont IS A MAYBE DATE, resume IS A MAYBE DATE, svc IS A DATE
GIVETH A `Maternity case`
`expecting with confinement` conf `working until` cont `resuming` resume `twelve months on` svc MEANS
    `Maternity case` OF TRUE, Date 1 7 2026, conf, cont, resume, svc, FALSE, FALSE

`usual` MEANS `expecting with confinement` (JUST (Date 3 7 2026)) `working until` NOTHING `resuming` NOTHING `twelve months on` (Date 1 1 2020)

-- s 6(1)(b)(i)
#ASSERT `the start for` `usual` EQUALS JUST (Date 20 5 2026)
#ASSERT `the end for` `usual` EQUALS JUST (Date 13 8 2026)
-- s 6(1)(a), (c): 52 weeks from 20 May 2026 end on 18 May 2027.
#ASSERT `the leave limit for` `usual` EQUALS JUST (Date 18 5 2027)
-- s 6(3): the first 12 weeks, 20 May to 11 August 2026.
#ASSERT `the paid start for` `usual` EQUALS JUST (Date 20 5 2026)
#ASSERT `the paid end for` `usual` EQUALS JUST (Date 11 8 2026)
-- s 6(1)(b)(ii): confined 1 May 2026, more than 6 weeks early.
#ASSERT `the start for` (`expecting with confinement` (JUST (Date 1 5 2026)) `working until` NOTHING `resuming` NOTHING `twelve months on` (Date 1 1 2020)) EQUALS JUST (Date 1 5 2026)
#ASSERT `the end for` (`expecting with confinement` (JUST (Date 1 5 2026)) `working until` NOTHING `resuming` NOTHING `twelve months on` (Date 1 1 2020)) EQUALS JUST (Date 11 6 2026)
-- s 7(1)-(2)(c): working until 10 June 2026, starting 11 June.
#ASSERT `the start for` (`expecting with confinement` (JUST (Date 3 7 2026)) `working until` (JUST (Date 10 6 2026)) `resuming` NOTHING `twelve months on` (Date 1 1 2020)) EQUALS JUST (Date 11 6 2026)
-- s 7(2)(b): confined 1 June, before that date: starts 1 June.
#ASSERT `the start for` (`expecting with confinement` (JUST (Date 1 6 2026)) `working until` (JUST (Date 10 6 2026)) `resuming` NOTHING `twelve months on` (Date 1 1 2020)) EQUALS JUST (Date 1 6 2026)
-- s 7(3): fit to resume 1 August 2026: the absence ends 31 July.
#ASSERT `the end for` (`expecting with confinement` (JUST (Date 3 7 2026)) `working until` NOTHING `resuming` (JUST (Date 1 8 2026)) `twelve months on` (Date 1 1 2020)) EQUALS JUST (Date 31 7 2026)
-- s 6(4): service exceeds 12 months on 1 July 2026: paid from then.
#ASSERT `the paid start for` (`expecting with confinement` (JUST (Date 3 7 2026)) `working until` NOTHING `resuming` NOTHING `twelve months on` (Date 1 7 2026)) EQUALS JUST (Date 1 7 2026)
#ASSERT `the paid end for` (`expecting with confinement` (JUST (Date 3 7 2026)) `working until` NOTHING `resuming` NOTHING `twelve months on` (Date 1 9 2026)) EQUALS NOTHING
-- s 3: a pregnancy ending more than 20 weeks early is not a confinement.
#ASSERT `the leave limit for` (`expecting with confinement` (JUST (Date 1 1 2026)) `working until` NOTHING `resuming` NOTHING `twelve months on` (Date 1 1 2020)) EQUALS NOTHING
#ASSERT `the paid end for` (`expecting with confinement` (JUST (Date 1 1 2026)) `working until` NOTHING `resuming` NOTHING `twelve months on` (Date 1 1 2020)) EQUALS NOTHING
-- s 6(4C)
#ASSERT `the paid end for` (`Maternity case` OF TRUE, Date 1 7 2026, JUST (Date 3 7 2026), NOTHING, NOTHING, Date 1 1 2020, TRUE, FALSE) EQUALS NOTHING
-- s 5
#ASSERT `the start for` (`Maternity case` OF FALSE, Date 1 7 2026, JUST (Date 3 7 2026), NOTHING, NOTHING, Date 1 1 2020, FALSE, FALSE) EQUALS NOTHING
