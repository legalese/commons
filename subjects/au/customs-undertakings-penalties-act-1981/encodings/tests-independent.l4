IMPORT prelude
IMPORT `cup-rules`

-- Independent tests from BRIEF.md and the Act (independent-expectations.md).
-- `Undertaking case` OF breached, %, unit value, units, value, required, entered
-- (only entries within the specified period(s) under a related tariff item
-- count as "entered in partial compliance": s 4(2)).

-- 1 breach, 10% of 100,000
#ASSERT `my undertaking penalty for` (`Undertaking case` OF TRUE, 10, NOTHING, 0, 100000, 0, 0) EQUALS 10000
-- 2 no breach
#ASSERT `my undertaking penalty for` (`Undertaking case` OF FALSE, 10, NOTHING, 0, 100000, 1000, 0) EQUALS 0
-- 3 quantity 400 of 1000
#ASSERT `my undertaking penalty for` (`Undertaking case` OF TRUE, 10, NOTHING, 0, 100000, 1000, 400) EQUALS 6000
-- 4 value 50,000 of 200,000
#ASSERT `my undertaking penalty for` (`Undertaking case` OF TRUE, 10, NOTHING, 0, 100000, 200000, 50000) EQUALS 7500
-- 5 unit value 50 x 2000, 5%
#ASSERT `my undertaking penalty for` (`Undertaking case` OF TRUE, 5, JUST 50, 2000, 0, 0, 0) EQUALS 5000
-- 6 / 7 entries outside the period or under an unrelated item do not count: entered 0
#ASSERT `my undertaking penalty for` (`Undertaking case` OF TRUE, 10, NOTHING, 0, 100000, 1000, 0) EQUALS 10000
-- 8 nothing entered
#ASSERT `my undertaking penalty for` (`Undertaking case` OF TRUE, 10, NOTHING, 0, 100000, 1000, 0) EQUALS 10000
-- 9 999 of 1000
#ASSERT `my undertaking penalty for` (`Undertaking case` OF TRUE, 10, NOTHING, 0, 100000, 1000, 999) EQUALS 10
-- 10 s 268(2) / varied undertaking: 20% of 30,000
#ASSERT `my undertaking penalty for` (`Undertaking case` OF TRUE, 20, NOTHING, 0, 30000, 0, 0) EQUALS 6000
-- 11 unit value and quantity reduction together
#ASSERT `my undertaking penalty for` (`Undertaking case` OF TRUE, 8, JUST 10, 500, 0, 500, 125) EQUALS 300
-- s 3(2) value helper
#ASSERT `the value of the goods for` (`Undertaking case` OF TRUE, 5, JUST 50, 2000, 0, 0, 0) EQUALS 100000
