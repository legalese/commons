IMPORT prelude
IMPORT daydate
IMPORT `sumlma-regulations`

-- Superannuation (Unclaimed Money and Lost Members) Regulations 2019 -- worked cases, from the member's seat.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Expected values were written by hand
-- from the deposited texts (the Act; the Regulations, compilation F2025C00752, and the reg 9(5) formula in
-- F2019L01617.formulas.md), never copied from the encoding's output. No scenario life raised this; the facts, and the CPI
-- numbers, are the encoder's, HYPOTHETICAL throughout.

-- ---------------------------------------------------------------------------------------------------------------------
-- reg 5. No higher age in the fund's rules: 65. Rules paying only at 67: 67. A rule saying 60 is not "greater than 65": 65.
#ASSERT `What is my eligibility age under the Regulations` 0 EQUALS 65
#ASSERT `What is my eligibility age under the Regulations` 67 EQUALS 67
#ASSERT `What is my eligibility age under the Regulations` 60 EQUALS 65

-- s 12(1) at the prescribed age. Joan, 62, a woman: the Act's own 60 would make her money unclaimed (sumlma-member.l4), but
-- reg 5 prescribes 65 for every member, so it is not unclaimed.
#ASSERT `Is my super unclaimed money, at the prescribed age` 0 62 30 FALSE 6 TRUE EQUALS `no: it is not unclaimed money under s 12(1)`
-- Joan at 66, nothing received for 30 months, no contact for 6 years, the fund cannot reach her: unclaimed money.
#ASSERT `Is my super unclaimed money, at the prescribed age` 0 66 30 FALSE 6 TRUE EQUALS `yes: it is unclaimed money (s 12(1)), and my fund must pay it to the Commissioner (s 17(1))`
-- The fund has not yet tried: it must make reasonable efforts first (s 13(1)).
#ASSERT `Is my super unclaimed money, at the prescribed age` 0 66 30 FALSE 6 FALSE EQUALS `not yet: but my fund must make reasonable efforts to contact me (s 13(1))`
-- The fund's rules pay only at 67: at 66, not yet eligible.
#ASSERT `Is my super unclaimed money, at the prescribed age` 67 66 30 FALSE 6 TRUE EQUALS `no: it is not unclaimed money under s 12(1)`

-- ---------------------------------------------------------------------------------------------------------------------
-- reg 7. Lena (sumlma-cases-member.l4) held a working holiday visa: another temporary visa, not prescribed -- a former
-- temporary resident after 7 months. Had she held a Subclass 410 (Retirement) or 405 (Investor Retirement) visa: not one.
#ASSERT `Am I a former temporary resident, given the visas reg 7 excludes` TRUE `another temporary visa` TRUE 7 FALSE FALSE FALSE
#ASSERT (NOT `Am I a former temporary resident, given the visas reg 7 excludes` TRUE `a Subclass 410 (Retirement) visa` TRUE 7 FALSE FALSE FALSE)
#ASSERT (NOT `Am I a former temporary resident, given the visas reg 7 excludes` TRUE `a Subclass 405 (Investor Retirement) visa` TRUE 7 FALSE FALSE FALSE)

-- ---------------------------------------------------------------------------------------------------------------------
-- reg 20. Aroha has emigrated to New Zealand, proved her Auckland address, opened a KiwiSaver account, given the details, and
-- the provider accepts; no untaxed element: met. With an untaxed element: not met. Without proof of address: not met.
#ASSERT `Are the KiwiSaver matters prescribed by reg 20 met` TRUE TRUE TRUE TRUE TRUE FALSE
#ASSERT (NOT `Are the KiwiSaver matters prescribed by reg 20 met` TRUE TRUE TRUE TRUE TRUE TRUE)
#ASSERT (NOT `Are the KiwiSaver matters prescribed by reg 20 met` TRUE FALSE TRUE TRUE TRUE FALSE)

-- ---------------------------------------------------------------------------------------------------------------------
-- reg 9. HYPOTHETICAL CPI numbers 133.2 and 137.6: 137.6 / 133.2 = 1.0330330...; a change of 3.3033033...%, rounded up at the
-- fourth place: 3.3034%. A fall (135.0 to 134.0) gives 0%.
#ASSERT `What is the reg 9 interest rate` 133.2 137.6 EQUALS 3.3034
#ASSERT `What is the reg 9 interest rate` 135 134 EQUALS 0
-- $10,000 held for the whole of a 365-day year at 3.3034%: 10,000 x 365 x 0.033034 / 365 = $330.34.
#ASSERT `How much interest for one financial year` 10000 365 365 133.2 137.6 EQUALS 330.34
-- $1,000 for 100 days of a 365-day year: 1,000 x 100 x 0.033034 / 365 = 9.0504...: $9.05.
#ASSERT `How much interest for one financial year` 1000 100 365 133.2 137.6 EQUALS 9.05
-- A year of falling prices: no interest.
#ASSERT `How much interest for one financial year` 10000 365 365 135 134 EQUALS 0

-- ---------------------------------------------------------------------------------------------------------------------
-- reg 13. The ATO pays Mia's money on 15 March 2027: the prescribed period runs from 1 July 2025 (the start of 2025-26) to
-- 14 March 2027. A contribution on 1 July 2025: in it. On 30 June 2025: not. On 15 March 2027, the day of payment: not.
#ASSERT `Did my fund receive an amount in the prescribed period` (Date 15 3 2027) (Date 1 7 2025)
#ASSERT (NOT `Did my fund receive an amount in the prescribed period` (Date 15 3 2027) (Date 30 6 2025))
#ASSERT (NOT `Did my fund receive an amount in the prescribed period` (Date 15 3 2027) (Date 15 3 2027))
-- Payment on 1 August 2026 (2026-27): from 1 July 2025; a contribution on 31 July 2026 is in it.
#ASSERT `Did my fund receive an amount in the prescribed period` (Date 1 8 2026) (Date 31 7 2026)

-- reg 14. Two of Mia's funds qualify. The ATO already paid one of them this year: that one. Otherwise the one most recently
-- receiving an amount; otherwise the largest balance; otherwise the Commissioner decides.
#ASSERT `Which fund must the ATO pay under reg 14` TRUE TRUE TRUE EQUALS `the fund the Commissioner has already paid for me this financial year (the most recently paid, if more than one) (reg 14(2)(a))`
#ASSERT `Which fund must the ATO pay under reg 14` FALSE TRUE TRUE EQUALS `the fund that most recently received an amount for me this financial year or last (reg 14(2)(b))`
#ASSERT `Which fund must the ATO pay under reg 14` FALSE FALSE TRUE EQUALS `the fund with the largest balance for me at the end of the last completed financial year (reg 14(2)(c))`
#ASSERT `Which fund must the ATO pay under reg 14` FALSE FALSE FALSE EQUALS `the fund the Commissioner determines (reg 14(2)(d))`
