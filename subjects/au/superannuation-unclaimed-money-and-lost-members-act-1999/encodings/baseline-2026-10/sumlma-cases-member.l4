IMPORT prelude
IMPORT daydate
IMPORT `sumlma-member`

-- Superannuation (Unclaimed Money and Lost Members) Act 1999 -- worked cases, from the member's seat.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Expected values were written by hand from
-- the deposited text (C2022C00273), never copied from the encoding's output. No scenario life raised this Act (REQ-0072 is a
-- scheduled priority-2 entry): the people and dates below are the encoder's, HYPOTHETICAL.

-- ---------------------------------------------------------------------------------------------------------------------
-- s 10: eligibility age. 65 for a man, 60 for a woman; a member the fund cannot sex is taken to be a man.
#ASSERT `What is my eligibility age` `my fund knows I am a woman` EQUALS 60
#ASSERT `What is my eligibility age` `my fund knows I am a man` EQUALS 65
#ASSERT `What is my eligibility age` `my fund does not know whether I am a man or a woman` EQUALS 65

-- ---------------------------------------------------------------------------------------------------------------------
-- s 12(1), s 13. Ron, 67, nothing paid in for 30 months, no contact for 6 years, the fund's letters and calls have failed.
#ASSERT `Is my super unclaimed money (s 12)` `my fund knows I am a man` 67 30 FALSE 6 TRUE EQUALS `yes: it is unclaimed money (s 12(1)), and my fund must pay it to the Commissioner (s 17(1))`
-- Rita, 61: a woman reaches eligibility age at 60.
#ASSERT `Is my super unclaimed money (s 12)` `my fund knows I am a woman` 61 30 FALSE 6 TRUE EQUALS `yes: it is unclaimed money (s 12(1)), and my fund must pay it to the Commissioner (s 17(1))`
-- A member of 62 the fund cannot sex is taken to be a man and has not reached 65.
#ASSERT `Is my super unclaimed money (s 12)` `my fund does not know whether I am a man or a woman` 62 30 FALSE 6 TRUE EQUALS `no: it is not unclaimed money under s 12(1)`
-- An amount was received 20 months ago: within the last 2 years.
#ASSERT `Is my super unclaimed money (s 12)` `my fund knows I am a man` 67 20 FALSE 6 TRUE EQUALS `no: it is not unclaimed money under s 12(1)`
-- Exactly 24 months: nothing within the last 2 years.
#ASSERT `Is my super unclaimed money (s 12)` `my fund knows I am a man` 67 24 FALSE 6 TRUE EQUALS `yes: it is unclaimed money (s 12(1)), and my fund must pay it to the Commissioner (s 17(1))`
-- Only 4 years since the fund last had contact.
#ASSERT `Is my super unclaimed money (s 12)` `my fund knows I am a man` 67 30 FALSE 4 TRUE EQUALS `no: it is not unclaimed money under s 12(1)`
-- 5 years have passed but the fund has not yet tried and failed: it must make reasonable efforts to contact him (s 13(1)).
#ASSERT `Is my super unclaimed money (s 12)` `my fund knows I am a man` 67 30 FALSE 6 FALSE EQUALS `not yet: but my fund must make reasonable efforts to contact me (s 13(1))`
-- A defined benefit accrued within the 2 years.
#ASSERT `Is my super unclaimed money (s 12)` `my fund knows I am a man` 67 30 TRUE 6 TRUE EQUALS `no: it is not unclaimed money under s 12(1)`

-- s 12(2), s 13(1A): the non-member spouse.
#ASSERT `Is my payment split amount unclaimed money (s 12(2))` TRUE TRUE EQUALS `yes: the amount is unclaimed money (s 12(2)), and the fund must pay it to the Commissioner (s 17(1))`
#ASSERT `Is my payment split amount unclaimed money (s 12(2))` TRUE FALSE EQUALS `not yet: but the fund must make reasonable efforts to ensure that I receive it (s 13(1A))`
#ASSERT `Is my payment split amount unclaimed money (s 12(2))` FALSE TRUE EQUALS `no: s 12(2) does not apply, because no payment split entitles me to be paid an amount`

-- ss 14, 15: a member has died; a lump sum death benefit is immediately payable; nothing paid in for 30 months.
#ASSERT `Is the dead member's benefit unclaimed money (s 14)` TRUE 30 FALSE TRUE EQUALS `yes: the benefit is unclaimed money (s 14), and the fund must pay it to the Commissioner (s 17(1))`
#ASSERT `Is the dead member's benefit unclaimed money (s 14)` TRUE 30 FALSE FALSE EQUALS `not yet: but the fund must make reasonable efforts to ensure that the person entitled receives it (s 15(1))`
-- Only a pension is payable (no lump sum determination): s 14(b) is not met.
#ASSERT `Is the dead member's benefit unclaimed money (s 14)` FALSE 30 FALSE TRUE EQUALS `no: s 14 does not apply to this benefit`
-- An amount was received 12 months ago.
#ASSERT `Is the dead member's benefit unclaimed money (s 14)` TRUE 12 FALSE TRUE EQUALS `no: s 14 does not apply to this benefit`

-- ---------------------------------------------------------------------------------------------------------------------
-- s 20QA. Mia, 34, left a job 18 months ago; her old MySuper account in a large fund holds $4,500 and has no insurance.
#ASSERT `Is my account an inactive low-balance account` `a regulated superannuation fund` TRUE TRUE 18 4500 FALSE FALSE FALSE FALSE
-- $6,000 is not "less than $6,000".
#ASSERT (NOT `Is my account an inactive low-balance account` `a regulated superannuation fund` TRUE TRUE 18 6000 FALSE FALSE FALSE FALSE)
-- 15 months is within the last 16 months.
#ASSERT (NOT `Is my account an inactive low-balance account` `a regulated superannuation fund` TRUE TRUE 15 4500 FALSE FALSE FALSE FALSE)
-- She made a binding beneficiary nomination in the last 16 months (s 20QA(1A)).
#ASSERT (NOT `Is my account an inactive low-balance account` `a regulated superannuation fund` TRUE TRUE 18 4500 FALSE FALSE FALSE TRUE)
-- The account carries insurance.
#ASSERT (NOT `Is my account an inactive low-balance account` `a regulated superannuation fund` TRUE TRUE 18 4500 FALSE FALSE TRUE FALSE)
-- A self managed fund with fewer than 7 members.
#ASSERT (NOT `Is my account an inactive low-balance account` `a regulated superannuation fund` FALSE TRUE 18 4500 FALSE FALSE FALSE FALSE)
-- An RSA: the member count, product and insurance limbs do not apply, nor does (1A).
#ASSERT `Is my account an inactive low-balance account` `an RSA (retirement savings account)` FALSE FALSE 18 4500 FALSE FALSE TRUE TRUE
-- An approved deposit fund where she has met a prescribed condition of release.
#ASSERT (NOT `Is my account an inactive low-balance account` `an approved deposit fund` FALSE FALSE 18 4500 TRUE FALSE FALSE FALSE)

-- s 24B.
#ASSERT `Is my account a lost member account (s 24B)` TRUE 3000 FALSE 2 FALSE EQUALS `yes: a small account of a lost member (s 24B(1))`
#ASSERT `Is my account a lost member account (s 24B)` TRUE 10000 FALSE 14 TRUE EQUALS `yes: an inactive account of an unidentifiable lost member (s 24B(2))`
-- $10,000 and an amount received 10 months ago: neither limb.
#ASSERT `Is my account a lost member account (s 24B)` TRUE 10000 FALSE 10 TRUE EQUALS `no: it is not a lost member account under s 24B`
#ASSERT `Is my account a lost member account (s 24B)` FALSE 3000 FALSE 14 TRUE EQUALS `no: it is not a lost member account under s 24B`
#ASSERT `Is my account a lost member account (s 24B)` TRUE 3000 TRUE 14 TRUE EQUALS `no: it is not a lost member account under s 24B`

-- ---------------------------------------------------------------------------------------------------------------------
-- s 20AA. Lena held a working holiday visa, left Australia, and 7 months have passed; she holds no visa and is a German citizen.
#ASSERT `Am I a former temporary resident` TRUE FALSE TRUE 7 FALSE FALSE FALSE
#ASSERT (NOT `Am I a former temporary resident` TRUE FALSE TRUE 5 FALSE FALSE FALSE)
-- A New Zealand citizen is never a former temporary resident.
#ASSERT (NOT `Am I a former temporary resident` TRUE FALSE TRUE 7 FALSE TRUE FALSE)
-- A permanent visa application not yet determined.
#ASSERT (NOT `Am I a former temporary resident` TRUE FALSE TRUE 7 FALSE FALSE TRUE)

-- ---------------------------------------------------------------------------------------------------------------------
-- When the fund must pay the Commissioner. Placeholder dates are ignored by the route not taken.
#ASSERT `By when must my fund pay the Commissioner` `my money is unclaimed money (s 17(1))` (Date 31 10 2026) (Date 1 1 2000) (Date 1 1 2000) (Date 1 1 2000) FALSE (Date 1 1 2000) FALSE EQUALS `by the end of` (Date 31 10 2026)
#ASSERT `By when must my fund pay the Commissioner` `my account is a lost member account (s 24E(1))` (Date 30 4 2027) (Date 1 1 2000) (Date 1 1 2000) (Date 1 1 2000) FALSE (Date 1 1 2000) FALSE EQUALS `by the end of` (Date 30 4 2027)
-- s 20F(1): the statute's own example (s 20E(2)): scheduled statement days 1 May and 1 November, notice on 15 April: 1 November.
#ASSERT `By when must my fund pay the Commissioner` `the Commissioner has given my fund a notice that I am a former temporary resident (s 20C)` (Date 1 1 2000) (Date 15 4 2027) (Date 1 5 2027) (Date 1 11 2027) FALSE (Date 1 1 2000) FALSE EQUALS `by the end of` (Date 1 11 2027)
-- Notice on 1 April, 30 days before 1 May: the next scheduled statement day.
#ASSERT `By when must my fund pay the Commissioner` `the Commissioner has given my fund a notice that I am a former temporary resident (s 20C)` (Date 1 1 2000) (Date 1 4 2027) (Date 1 5 2027) (Date 1 11 2027) FALSE (Date 1 1 2000) FALSE EQUALS `by the end of` (Date 1 5 2027)
-- Notice on 3 April, exactly 28 days before 1 May: not "less than 28 days", so 1 May.
#ASSERT `By when must my fund pay the Commissioner` `the Commissioner has given my fund a notice that I am a former temporary resident (s 20C)` (Date 1 1 2000) (Date 3 4 2027) (Date 1 5 2027) (Date 1 11 2027) FALSE (Date 1 1 2000) FALSE EQUALS `by the end of` (Date 1 5 2027)
-- Notice on 4 April, 27 days before: the following scheduled statement day.
#ASSERT `By when must my fund pay the Commissioner` `the Commissioner has given my fund a notice that I am a former temporary resident (s 20C)` (Date 1 1 2000) (Date 4 4 2027) (Date 1 5 2027) (Date 1 11 2027) FALSE (Date 1 1 2000) FALSE EQUALS `by the end of` (Date 1 11 2027)
-- A later day identified under the regulations (s 20F(1)(c)).
#ASSERT `By when must my fund pay the Commissioner` `the Commissioner has given my fund a notice that I am a former temporary resident (s 20C)` (Date 1 1 2000) (Date 15 4 2027) (Date 1 5 2027) (Date 1 11 2027) TRUE (Date 1 12 2027) FALSE EQUALS `by the end of` (Date 1 12 2027)
-- s 21C(2): eligible rollover fund accounts.
#ASSERT `By when must my fund pay the Commissioner` `my account is in an eligible rollover fund (s 21C)` (Date 1 1 2000) (Date 1 1 2000) (Date 1 1 2000) (Date 1 1 2000) FALSE (Date 1 1 2000) TRUE EQUALS `by the end of` (Date 30 6 2021)
#ASSERT `By when must my fund pay the Commissioner` `my account is in an eligible rollover fund (s 21C)` (Date 1 1 2000) (Date 1 1 2000) (Date 1 1 2000) (Date 1 1 2000) FALSE (Date 1 1 2000) FALSE EQUALS `by the end of` (Date 31 1 2022)
-- s 22: a voluntary payment has no day.
#ASSERT `By when must my fund pay the Commissioner` `my fund chooses to pay because it believes it is in my best interests (s 22)` (Date 1 1 2000) (Date 1 1 2000) (Date 1 1 2000) (Date 1 1 2000) FALSE (Date 1 1 2000) FALSE EQUALS `no day: my fund may pay the Commissioner under s 22 but is not required to`

-- ---------------------------------------------------------------------------------------------------------------------
-- Whom the Commissioner must pay. Argument order: where from, satisfied, died, death beneficiaries, direction, complying,
-- KiwiSaver matters, NZ amount, fund self managed or not notified, sex, age, NZ age reached, amount, terminal condition.
-- Ron (67) directs his unclaimed money to his current complying fund.
#ASSERT `Whom must the Commissioner pay` `unclaimed money my fund paid under s 17(1)` TRUE FALSE FALSE `I have directed payment to a single super fund` TRUE FALSE FALSE FALSE `my fund knows I am a man` 67 FALSE 20000 FALSE EQUALS `the single fund I directed`
-- He gives no direction: s 17(2)(d), to him.
#ASSERT `Whom must the Commissioner pay` `unclaimed money my fund paid under s 17(1)` TRUE FALSE FALSE `I have given no direction` FALSE FALSE FALSE FALSE `my fund knows I am a man` 67 FALSE 20000 FALSE EQUALS `me, directly`
-- With a New Zealand-sourced amount and short of the New Zealand age (s 17(2AAB)).
#ASSERT `Whom must the Commissioner pay` `unclaimed money my fund paid under s 17(1)` TRUE FALSE FALSE `I have given no direction` FALSE FALSE TRUE FALSE `my fund knows I am a man` 64 FALSE 20000 FALSE EQUALS `no one yet: the money includes a New Zealand-sourced amount and I have not reached the New Zealand eligibility age, so it cannot be paid to me directly`
-- He directs a fund that is not a complying superannuation plan: (a) is not met, so s 17(2)(d) pays him (finding 4).
#ASSERT `Whom must the Commissioner pay` `unclaimed money my fund paid under s 17(1)` TRUE FALSE FALSE `I have directed payment to a single super fund` FALSE FALSE FALSE FALSE `my fund knows I am a man` 67 FALSE 20000 FALSE EQUALS `me, directly`
-- Mia (34): a lost member account of $150, no direction: under $200, paid to her (s 24G(2A)(b)(ii)).
#ASSERT `Whom must the Commissioner pay` `a lost member account my fund paid under s 24E` TRUE FALSE FALSE `I have given no direction` FALSE FALSE FALSE FALSE `my fund knows I am a woman` 34 FALSE 150 FALSE EQUALS `me, directly`
-- $3,000, no direction, no terminal condition: she must direct a fund.
#ASSERT `Whom must the Commissioner pay` `a lost member account my fund paid under s 24E` TRUE FALSE FALSE `I have given no direction` FALSE FALSE FALSE FALSE `my fund knows I am a woman` 34 FALSE 3000 FALSE EQUALS `no one yet: I must direct the Commissioner to pay a complying super fund or a KiwiSaver provider, unless I reach eligibility age, the amount is under $200 or I have a terminal medical condition`
-- An inactive low-balance amount of $3,000 with a terminal medical condition: paid to her.
#ASSERT `Whom must the Commissioner pay` `an inactive low-balance account my fund paid under s 20QD` TRUE FALSE FALSE `I have given no direction` FALSE FALSE FALSE FALSE `my fund knows I am a woman` 34 FALSE 3000 TRUE EQUALS `me, directly`
-- An ERF amount with a New Zealand-sourced part, directed to her self managed fund (s 21E(2A)).
#ASSERT `Whom must the Commissioner pay` `an eligible rollover fund account paid under s 21C` TRUE FALSE FALSE `I have directed payment to a single super fund` TRUE FALSE TRUE TRUE `my fund knows I am a woman` 34 FALSE 3000 FALSE EQUALS `no one yet: the Commissioner must not pay the fund I directed, because the money includes a New Zealand-sourced amount and that fund is a self managed fund or has not notified that it accepts such amounts`
-- A voluntary s 22 amount of a member who has died, with death beneficiaries.
#ASSERT `Whom must the Commissioner pay` `a voluntary payment my fund made under s 22` TRUE TRUE TRUE `I have given no direction` FALSE FALSE FALSE FALSE `my fund knows I am a man` 70 FALSE 8000 FALSE EQUALS `the death beneficiaries, the share of each worked out by the formula (the whole amount if there is only one)`
-- A lost member account of a member who has died with no death beneficiaries: the legal personal representative.
#ASSERT `Whom must the Commissioner pay` `a lost member account my fund paid under s 24E` TRUE TRUE FALSE `I have given no direction` FALSE FALSE FALSE FALSE `my fund knows I am a man` 70 FALSE 8000 FALSE EQUALS `the dead member's legal personal representative`
-- The Commissioner is not yet satisfied it can pay.
#ASSERT `Whom must the Commissioner pay` `a lost member account my fund paid under s 24E` FALSE FALSE FALSE `I have given no direction` FALSE FALSE FALSE FALSE `my fund knows I am a man` 70 FALSE 8000 FALSE EQUALS `no one yet: the Commissioner is not satisfied that it is possible to pay in accordance with the Act`
-- Ron (67) directs his inactive low-balance amount to a fund that is not complying: a direction was given, so s 20QF(2)(d) is
-- not available even though he has reached eligibility age (finding 4).
#ASSERT `Whom must the Commissioner pay` `an inactive low-balance account my fund paid under s 20QD` TRUE FALSE FALSE `I have directed payment to a single super fund` FALSE FALSE FALSE FALSE `my fund knows I am a man` 67 FALSE 3000 FALSE EQUALS `no one yet: I must direct the Commissioner to pay a complying super fund or a KiwiSaver provider, unless I reach eligibility age, the amount is under $200 or I have a terminal medical condition`
-- Rita (61) with a New Zealand-sourced lost member amount and short of the New Zealand age: eligibility age alone is not enough.
#ASSERT `Whom must the Commissioner pay` `a lost member account my fund paid under s 24E` TRUE FALSE FALSE `I have given no direction` FALSE FALSE TRUE FALSE `my fund knows I am a woman` 61 FALSE 3000 FALSE EQUALS `no one yet: I must direct the Commissioner to pay a complying super fund or a KiwiSaver provider, unless I reach eligibility age, the amount is under $200 or I have a terminal medical condition`
-- Ron (67), no direction, lost member amount: eligibility age reached, paid to him.
#ASSERT `Whom must the Commissioner pay` `a lost member account my fund paid under s 24E` TRUE FALSE FALSE `I have given no direction` FALSE FALSE FALSE FALSE `my fund knows I am a man` 67 FALSE 3000 FALSE EQUALS `me, directly`

-- Death beneficiaries' shares.
#ASSERT `How much is my share as a death beneficiary` 12000 1 EQUALS `answered` 12000
#ASSERT `How much is my share as a death beneficiary` 12000 2 EQUALS `not covered` `the death-beneficiary formula is not in the deposited compilation (it was lost in conversion), so a share cannot be worked out where there is more than one death beneficiary`

-- Interest.
#ASSERT (NOT `Must the Commissioner also pay interest` `unclaimed money my fund paid under s 17(1)` (Date 1 3 2013))
#ASSERT `Must the Commissioner also pay interest` `unclaimed money my fund paid under s 17(1)` (Date 1 7 2013)
#ASSERT `Must the Commissioner also pay interest` `a lost member account my fund paid under s 24E` (Date 15 8 2026)
#ASSERT `Must the Commissioner also pay interest` `an inactive low-balance account my fund paid under s 20QD` (Date 15 8 2026)

-- ---------------------------------------------------------------------------------------------------------------------
-- s 20H. Lena (a former temporary resident) applies; the Commissioner holds an excess for her.
#ASSERT `Whom must the Commissioner pay under s 20H` TRUE TRUE FALSE FALSE `I have given no direction` FALSE FALSE FALSE FALSE FALSE EQUALS `me, directly (s 20H(2)(a)), less any tax withheld from a departing Australia superannuation payment`
-- Later a permanent resident, she directs a complying fund.
#ASSERT `Whom must the Commissioner pay under s 20H` TRUE TRUE FALSE FALSE `I have directed payment to a single super fund` TRUE TRUE FALSE FALSE FALSE EQUALS `the single complying super fund I directed (s 20H(2)(b))`
-- Not a citizen or permanent resident: her direction to a fund is not one (b) allows; she is paid under (a).
#ASSERT `Whom must the Commissioner pay under s 20H` TRUE TRUE FALSE FALSE `I have directed payment to a single super fund` TRUE FALSE FALSE FALSE FALSE EQUALS `me, directly (s 20H(2)(a)), less any tax withheld from a departing Australia superannuation payment`
#ASSERT `Whom must the Commissioner pay under s 20H` TRUE TRUE TRUE TRUE `I have given no direction` FALSE FALSE FALSE FALSE FALSE EQUALS `the death beneficiaries (s 20H(3))`
#ASSERT `Whom must the Commissioner pay under s 20H` TRUE TRUE TRUE FALSE `I have given no direction` FALSE FALSE FALSE FALSE FALSE EQUALS `the dead person's legal personal representative (s 20H(2)(c))`
#ASSERT `Whom must the Commissioner pay under s 20H` FALSE TRUE FALSE FALSE `I have given no direction` FALSE FALSE FALSE FALSE FALSE EQUALS `no one: s 20H does not apply on these facts`
#ASSERT `Whom must the Commissioner pay under s 20H` TRUE TRUE FALSE FALSE `I have directed payment to a single super fund` TRUE TRUE FALSE TRUE TRUE EQUALS `no one yet: the Commissioner must not pay the fund I directed, because the money includes a New Zealand-sourced amount and that fund is a self managed fund or has not notified that it accepts such amounts (s 20H(2AAA))`

-- ---------------------------------------------------------------------------------------------------------------------
-- s 24NA. The ATO holds $1,500 for Mia; satisfied on 1 March 2027; her active account holds $5,000: total $6,500. By 29 March.
#ASSERT `Will the ATO move my money to my active account (s 24NA)` TRUE TRUE (Date 1 3 2027) FALSE TRUE TRUE 5000 1500 TRUE FALSE FALSE FALSE FALSE EQUALS `answered` (`yes: the Commissioner must pay it into that account, with any interest the regulations give` (Date 29 3 2027))
-- $4,000 + $1,500 = $5,500: below $6,000.
#ASSERT `Will the ATO move my money to my active account (s 24NA)` TRUE TRUE (Date 1 3 2027) FALSE TRUE TRUE 4000 1500 TRUE FALSE FALSE FALSE FALSE EQUALS `answered` `no: s 24NA does not require the Commissioner to pay it into that account`
-- Exactly $6,000 is "equal to or greater than $6,000".
#ASSERT `Will the ATO move my money to my active account (s 24NA)` TRUE TRUE (Date 1 3 2027) FALSE TRUE TRUE 4500 1500 TRUE FALSE FALSE FALSE FALSE EQUALS `answered` (`yes: the Commissioner must pay it into that account, with any interest the regulations give` (Date 29 3 2027))
-- Two funds qualify (s 24NA(3)).
#ASSERT `Will the ATO move my money to my active account (s 24NA)` TRUE TRUE (Date 1 3 2027) FALSE TRUE TRUE 5000 1500 TRUE FALSE FALSE FALSE TRUE EQUALS `not covered` `more than one fund meets s 24NA(2)(b) to (e), so the Commissioner pays as the regulations provide (s 24NA(3)), and the regulations are not deposited`
-- A New Zealand-sourced amount, an APRA fund (not self managed) that has not notified: s 24NA(2)(f)(i) is met (finding 5).
#ASSERT `Will the ATO move my money to my active account (s 24NA)` TRUE TRUE (Date 1 3 2027) FALSE TRUE TRUE 5000 1500 TRUE TRUE FALSE FALSE FALSE EQUALS `answered` (`yes: the Commissioner must pay it into that account, with any interest the regulations give` (Date 29 3 2027))
-- The same into a self managed fund that has not notified.
#ASSERT `Will the ATO move my money to my active account (s 24NA)` TRUE TRUE (Date 1 3 2027) FALSE TRUE TRUE 5000 1500 TRUE TRUE TRUE FALSE FALSE EQUALS `answered` `no: s 24NA does not require the Commissioner to pay it into that account`
-- No contribution in the prescribed period.
#ASSERT `Will the ATO move my money to my active account (s 24NA)` TRUE TRUE (Date 1 3 2027) FALSE TRUE FALSE 5000 1500 TRUE FALSE FALSE FALSE FALSE EQUALS `answered` `no: s 24NA does not require the Commissioner to pay it into that account`

-- ---------------------------------------------------------------------------------------------------------------------
-- Recovery of an overpayment. Ron was paid $2,000 too much; notice on 1 March 2027 for $2,000.
#ASSERT `How much can the ATO now recover from me` `paid to me, or to me as legal personal representative, under Part 3, 3A, 3B, 3C, 3D or 4A` 2000 TRUE FALSE (Date 1 3 2027) 2000 0 (Date 20 3 2027) EQUALS 0
#ASSERT `How much can the ATO now recover from me` `paid to me, or to me as legal personal representative, under Part 3, 3A, 3B, 3C, 3D or 4A` 2000 TRUE FALSE (Date 1 3 2027) 2000 0 (Date 28 3 2027) EQUALS 0
#ASSERT `How much can the ATO now recover from me` `paid to me, or to me as legal personal representative, under Part 3, 3A, 3B, 3C, 3D or 4A` 2000 TRUE FALSE (Date 1 3 2027) 2000 0 (Date 29 3 2027) EQUALS 2000
-- The notice names $1,500: no more.
#ASSERT `How much can the ATO now recover from me` `paid to me, or to me as legal personal representative, under Part 3, 3A, 3B, 3C, 3D or 4A` 2000 TRUE FALSE (Date 1 3 2027) 1500 0 (Date 1 4 2027) EQUALS 1500
-- $1,200 of the same excess already recovered from his fund: $800 left.
#ASSERT `How much can the ATO now recover from me` `paid to me, or to me as legal personal representative, under Part 3, 3A, 3B, 3C, 3D or 4A` 2000 TRUE FALSE (Date 1 3 2027) 2000 1200 (Date 1 4 2027) EQUALS 800
-- The notice revoked.
#ASSERT `How much can the ATO now recover from me` `paid to me, or to me as legal personal representative, under Part 3, 3A, 3B, 3C, 3D or 4A` 2000 TRUE TRUE (Date 1 3 2027) 2000 0 (Date 1 4 2027) EQUALS 0
-- An overpaid transfer into his active account under s 24NA: recoverable only from the fund (s 24NAA(3)).
#ASSERT `How much can the ATO now recover from me` `paid into my active account under s 24NA` 2000 TRUE FALSE (Date 1 3 2027) 2000 0 (Date 1 4 2027) EQUALS 0

-- ---------------------------------------------------------------------------------------------------------------------
-- s 20P.
#ASSERT `Can I object to the decision` `a notice to my fund that I am a former temporary resident (s 20C)` EQUALS `yes: I may object under Part IVC of the Taxation Administration Act 1953 (s 20P)`
#ASSERT `Can I object to the decision` `a decision to recover an overpayment of my s 20H payment (s 20L)` EQUALS `yes: I may object under Part IVC of the Taxation Administration Act 1953 (s 20P)`
#ASSERT `Can I object to the decision` `a decision about unclaimed money, an inactive low-balance, ERF, voluntary or lost member amount (ss 17, 20QF, 21E, 22B, 24G)` EQUALS `this Act gives no right to object to that decision`
#ASSERT `Can I object to the decision` `a decision about transferring my money to my active account (s 24NA)` EQUALS `this Act gives no right to object to that decision`
