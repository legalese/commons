IMPORT prelude
IMPORT daydate
IMPORT `sga-time`
IMPORT `sga-part2`
IMPORT `sga-part3a`

-- sga-tests-part3a.l4: worked cases for sga-part3a.l4. Expected values are hand-written from sections 15B to 18B.

§ `Division 1: sections 15B and 15C`

#ASSERT `Part 3 treats the former employee as an employee of the person` TRUE EQUALS JUST TRUE
#ASSERT `Part 3 treats the former employee as an employee of the person` FALSE EQUALS NOTHING
-- 15C(2), (3): a resident employer: only the employer may apply; a non-resident employer: only a related entity may apply.
#ASSERT `an entity may apply in writing for a certificate of coverage` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `an entity may apply in writing for a certificate of coverage` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `an entity may apply in writing for a certificate of coverage` TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `an entity may apply in writing for a certificate of coverage` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
-- No agreement preventing double coverage: section 15C does not apply.
#ASSERT `an entity may apply in writing for a certificate of coverage` FALSE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `the Commissioner may give the entity that applied a certificate of coverage` TRUE EQUALS JUST TRUE
#ASSERT `the Commissioner may give the entity that applied a certificate of coverage` FALSE EQUALS JUST FALSE
#ASSERT `a certificate of coverage has the required content` TRUE TRUE TRUE
#ASSERT NOT (`a certificate of coverage has the required content` FALSE TRUE TRUE)
#ASSERT NOT (`a certificate of coverage has the required content` TRUE FALSE TRUE)
#ASSERT NOT (`a certificate of coverage has the required content` TRUE TRUE FALSE)
#ASSERT `the Commissioner may revoke or vary a certificate of coverage` TRUE EQUALS JUST TRUE
#ASSERT `the Commissioner may revoke or vary a certificate of coverage` FALSE EQUALS JUST FALSE
#ASSERT `the person may object against the decision in the manner set out in Part IVC of the Taxation Administration Act 1953` TRUE EQUALS JUST TRUE
#ASSERT `the person may object against the decision in the manner set out in Part IVC of the Taxation Administration Act 1953` FALSE EQUALS NOTHING
#ASSERT `this Part treats the entity that made the application as the employer of the employee` FALSE TRUE EQUALS JUST TRUE
#ASSERT `this Part treats the entity that made the application as the employer of the employee` TRUE TRUE EQUALS NOTHING
#ASSERT `this Part treats the entity that made the application as the employer of the employee` FALSE FALSE EQUALS NOTHING

§ `Section 16A`

#ASSERT `the charge on the shortfall of an employer for a QE day is payable by the employer` TRUE EQUALS JUST TRUE
#ASSERT `the charge on the shortfall of an employer for a QE day is payable by the employer` FALSE EQUALS NOTHING

§ `Sections 17A and 17B: the individual superannuation guarantee amount`

#ASSERT `the charge percentage` EQUALS 12
-- One payment of 10000 with nothing earlier in the year and a base of 250000: 10000 of qualifying earnings.
#ASSERT `the amount of the qualifying earnings on the QE day` 0 250000 (LIST 10000) EQUALS 10000
-- Two payments on the QE day: the sum of the amounts, 10000 + 5000.
#ASSERT `the amount of the qualifying earnings on the QE day` 0 250000 (LIST 10000, 5000) EQUALS 15000
-- 245000 already paid this year and a base of 250000: the first payment counts 5000 (up to the base), the second counts nil.
#ASSERT `the amount of the qualifying earnings on the QE day` 245000 250000 (LIST 10000, 5000) EQUALS 5000
#ASSERT `the amount of the qualifying earnings on the QE day` 0 250000 EMPTY EQUALS 0
-- 12% of 10000 is 1200; 12% of 15000 is 1800; 12% of the capped 5000 is 600.
#ASSERT `the individual superannuation guarantee amount` 0 250000 (LIST 10000) FALSE EQUALS JUST 1200
#ASSERT `the individual superannuation guarantee amount` 0 250000 (LIST 10000, 5000) FALSE EQUALS JUST 1800
#ASSERT `the individual superannuation guarantee amount` 245000 250000 (LIST 10000, 5000) FALSE EQUALS JUST 600
#ASSERT `the individual superannuation guarantee amount` 0 250000 (LIST 0) FALSE EQUALS JUST 0
-- No payment of qualifying earnings on the day: the Subdivision does not apply (the text does not say).
#ASSERT `the individual superannuation guarantee amount` 0 250000 EMPTY FALSE EQUALS NOTHING
-- An exemption certificate in force for the employer, the employee and a period including the QE day: nil.
#ASSERT `the individual superannuation guarantee amount` 0 250000 (LIST 10000) TRUE EQUALS JUST 0
#ASSERT `the individual superannuation guarantee amount` 0 250000 (LIST 10000, 5000) TRUE EQUALS JUST 0

§ `Sections 17C and 17D: exemption certificates`

#ASSERT `the Commissioner may issue an employer shortfall exemption certificate` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `the Commissioner may issue an employer shortfall exemption certificate` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `the Commissioner may issue an employer shortfall exemption certificate` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `the Commissioner may issue an employer shortfall exemption certificate` TRUE TRUE FALSE EQUALS JUST FALSE
-- 17C(4): in the approved form, specifying the employer, period and financial year, made 30 days or more before the first day (1 September 2026).
#ASSERT `an application for an employer shortfall exemption certificate meets section 17C(4)` TRUE TRUE (Date 2 8 2026) (Date 1 9 2026)
#ASSERT NOT (`an application for an employer shortfall exemption certificate meets section 17C(4)` TRUE TRUE (Date 3 8 2026) (Date 1 9 2026))
#ASSERT NOT (`an application for an employer shortfall exemption certificate meets section 17C(4)` FALSE TRUE (Date 2 8 2026) (Date 1 9 2026))
#ASSERT NOT (`an application for an employer shortfall exemption certificate meets section 17C(4)` TRUE FALSE (Date 2 8 2026) (Date 1 9 2026))
#ASSERT `the person may object against the decision under Part IVC of the Taxation Administration Act 1953` TRUE EQUALS JUST TRUE
#ASSERT `the person may object against the decision under Part IVC of the Taxation Administration Act 1953` FALSE EQUALS NOTHING
#ASSERT `the Commissioner may vary or revoke an employer shortfall exemption certificate` EQUALS JUST FALSE
#ASSERT `an employer shortfall exemption certificate may be issued after the first day of the period specified in it` EQUALS JUST TRUE
#ASSERT `an employer shortfall exemption certificate is a legislative instrument` EQUALS JUST FALSE
#ASSERT `the people the Commissioner must give written notice of a decision under subsection 17C(1) to` TRUE EQUALS LIST "the applicant", "the employer to which the certificate relates"
#ASSERT `the people the Commissioner must give written notice of a decision under subsection 17C(1) to` FALSE EQUALS LIST "the applicant"
#ASSERT `a notice of a decision to issue a certificate meets section 17D(2)` TRUE
#ASSERT NOT (`a notice of a decision to issue a certificate meets section 17D(2)` FALSE)

§ `Section 18A: eligible contributions`

-- Field order: sacrificed; to a complying fund; allocatable in the fund; as a defined benefit member; at a time a conversion notice has effect; to an RSA; allocatable in the RSA;
-- paid to the legal personal representative; notional contribution to a defined benefit scheme; written statement obtained; section 18B(2) applies.
#ASSERT `is an eligible contribution` (`Contribution made for the benefit of an employee` OF FALSE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `is an eligible contribution` (`Contribution made for the benefit of an employee` OF TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST FALSE
#ASSERT `is an eligible contribution` (`Contribution made for the benefit of an employee` OF FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST FALSE
#ASSERT `is an eligible contribution` (`Contribution made for the benefit of an employee` OF FALSE, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST FALSE
#ASSERT `is an eligible contribution` (`Contribution made for the benefit of an employee` OF FALSE, TRUE, TRUE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST FALSE
-- An RSA contribution, allocatable; not allocatable; sacrificed.
#ASSERT `is an eligible contribution` (`Contribution made for the benefit of an employee` OF FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `is an eligible contribution` (`Contribution made for the benefit of an employee` OF FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST FALSE
#ASSERT `is an eligible contribution` (`Contribution made for the benefit of an employee` OF TRUE, FALSE, FALSE, FALSE, FALSE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST FALSE
-- (c) the employee has died and an equivalent amount is paid to the legal personal representative; (d) a notional contribution to a defined benefit scheme.
#ASSERT `is an eligible contribution` (`Contribution made for the benefit of an employee` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `is an eligible contribution` (`Contribution made for the benefit of an employee` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE) EQUALS JUST TRUE
-- None of the limbs.
#ASSERT `is an eligible contribution` (`Contribution made for the benefit of an employee` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST FALSE
-- 18A(2): a fund that is not in fact complying, with a written statement, is conclusively presumed to be complying; the presumption does not reach the other elements (not sacrificed).
#ASSERT `is an eligible contribution` (`Contribution made for the benefit of an employee` OF FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE) EQUALS JUST TRUE
#ASSERT `is an eligible contribution` (`Contribution made for the benefit of an employee` OF TRUE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE) EQUALS JUST FALSE
-- 18B(1)(a): the presumption is unavailable where 18B(2) applies on the day.
#ASSERT `is an eligible contribution` (`Contribution made for the benefit of an employee` OF FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, TRUE) EQUALS JUST FALSE
#ASSERT `the contribution is treated as to a complying superannuation fund` (`Contribution made for the benefit of an employee` OF FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)
#ASSERT NOT (`the contribution is treated as to a complying superannuation fund` (`Contribution made for the benefit of an employee` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE))

§ `Section 18B(2)`

-- Field order: employer is trustee or manager; employer is an associate of it; it is an associate of the employer; belief: not a resident regulated fund; belief: contravention not ignorable.
#ASSERT `subsection 18B(2) applies on the day` TRUE FALSE FALSE TRUE FALSE
#ASSERT `subsection 18B(2) applies on the day` FALSE TRUE FALSE FALSE TRUE
#ASSERT `subsection 18B(2) applies on the day` FALSE FALSE TRUE TRUE TRUE
#ASSERT NOT (`subsection 18B(2) applies on the day` FALSE FALSE FALSE TRUE TRUE)
#ASSERT NOT (`subsection 18B(2) applies on the day` TRUE FALSE FALSE FALSE FALSE)

§ `Section 18A(3): the notional contribution for a defined benefit member`

-- Field order: certificate has effect; scheme operating for the member; certificate covers the class and specifies the rate; written statement held; 18B(2) applies; QE amount; rate as a percentage.
#ASSERT `the notional contribution for a defined benefit member` TRUE TRUE TRUE TRUE FALSE 10000 9.5 EQUALS JUST 950
#ASSERT `the notional contribution for a defined benefit member` TRUE TRUE TRUE TRUE FALSE 10000 11 EQUALS JUST 1100
#ASSERT `the notional contribution for a defined benefit member` FALSE TRUE TRUE TRUE FALSE 10000 9.5 EQUALS NOTHING
#ASSERT `the notional contribution for a defined benefit member` TRUE FALSE TRUE TRUE FALSE 10000 9.5 EQUALS NOTHING
#ASSERT `the notional contribution for a defined benefit member` TRUE TRUE FALSE TRUE FALSE 10000 9.5 EQUALS NOTHING
#ASSERT `the notional contribution for a defined benefit member` TRUE TRUE TRUE FALSE FALSE 10000 9.5 EQUALS NOTHING
#ASSERT `the notional contribution for a defined benefit member` TRUE TRUE TRUE TRUE TRUE 10000 9.5 EQUALS NOTHING
