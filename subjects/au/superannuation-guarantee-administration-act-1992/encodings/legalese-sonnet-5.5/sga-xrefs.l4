IMPORT prelude

IMPORT `sga-provisions`

-- sga-xrefs.l4: every reference in the text (sections 1 to 80) to a provision of the same text, and every reference to another
-- Act or instrument. GENERATED by a script that reads the text file. A reference to another instrument is not resolved here.
-- A reference is a row: the citing provision, the words of the citation as printed, the identifier it cites and the heading of the
-- cited provision as the text prints it. Each row has one assertion beneath the table.

DECLARE `Cross reference` HAS
    `citing provision` IS A STRING
    `words as printed` IS A STRING
    `cited identifier` IS A STRING
    `cited heading` IS A STRING

-- Rows of the first kind: the cited provision is in the text.
`internal references` MEANS LIST
      (`Cross reference` OF "4", "the definition of Australia", "6(1) definition: Australia", "Interpretation—general")
    , (`Cross reference` OF "5(2C)", "subsection (2B)", "5(2B)", "Application of Act to Commonwealth")
    , (`Cross reference` OF "5(3)", "Part 8", "Part 8", "Payments of amounts of shortfall components for the benefit of employees")
