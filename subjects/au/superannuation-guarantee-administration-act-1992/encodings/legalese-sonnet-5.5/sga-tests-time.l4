IMPORT prelude
IMPORT daydate
IMPORT `sga-time`

-- sga-tests-time.l4: worked cases for sga-time.l4. Every expected value is written by hand from the calendar and from
-- the text's own words, beside its assertion. The calendar facts used: 1 July 2026 is a Wednesday; 4 July 2026 is a Saturday.
-- No public holiday is in the text; the holiday lists below are inputs made up for the case (they are not claims about any State).

`no holidays` MEANS EMPTY
`a holiday on Friday 3 July 2026` MEANS LIST (Date 3 7 2026)
`a holiday on Monday 6 July 2026` MEANS LIST (Date 6 7 2026)

§ `What daydate does on the 31st and on 29 February (read from the binary, not assumed)`

-- add months and add years clamp to the last day of the target month; Date rolls an impossible day forward.
#ASSERT `add months` (Date 31 1 2026) 1 EQUALS Date 28 2 2026
#ASSERT `add years` (Date 29 2 2028) 1 EQUALS Date 28 2 2029
#ASSERT Date 29 2 2027 EQUALS Date 1 3 2027
#ASSERT Date 31 2 2026 EQUALS Date 3 3 2026

§ `s 6(1) "business day" and "usual period" and "extended usual period"`

-- Saturday and Sunday are not business days; a day listed as a public holiday is not; any other day is.
#ASSERT `a business day` (Date 6 7 2026) `no holidays`
#ASSERT NOT (`a business day` (Date 4 7 2026) `no holidays`)
#ASSERT NOT (`a business day` (Date 5 7 2026) `no holidays`)
#ASSERT NOT (`a business day` (Date 3 7 2026) `a holiday on Friday 3 July 2026`)
#ASSERT `a business day` (Date 3 7 2026) `no holidays`
-- The 7th business day after Wednesday 1 July 2026: Thu 2 (1), Fri 3 (2), Mon 6 (3), Tue 7 (4), Wed 8 (5), Thu 9 (6), Fri 10 (7).
#ASSERT `the last day of the usual period` (Date 1 7 2026) `no holidays` EQUALS Date 10 7 2026
-- With Friday 3 July a holiday: Thu 2 (1), Mon 6 (2), 7 (3), 8 (4), 9 (5), 10 (6), Mon 13 (7).
#ASSERT `the last day of the usual period` (Date 1 7 2026) `a holiday on Friday 3 July 2026` EQUALS Date 13 7 2026
-- A QE day on Saturday 4 July 2026: Mon 6 (1), 7 (2), 8 (3), 9 (4), 10 (5), Mon 13 (6), Tue 14 (7).
#ASSERT `the last day of the usual period` (Date 4 7 2026) `no holidays` EQUALS Date 14 7 2026
-- Saturday 4 July 2026 with Monday 6 July a holiday: Tue 7 (1), 8 (2), 9 (3), 10 (4), 13 (5), 14 (6), Wed 15 (7).
#ASSERT `the last day of the usual period` (Date 4 7 2026) `a holiday on Monday 6 July 2026` EQUALS Date 15 7 2026
-- At the limits of the usual period for QE day 1 July 2026 (no holidays): the day before, the QE day, the last day, the day after.
#ASSERT NOT (`a day is in the usual period` (Date 1 7 2026) (Date 30 6 2026) `no holidays`)
#ASSERT `a day is in the usual period` (Date 1 7 2026) (Date 1 7 2026) `no holidays`
#ASSERT `a day is in the usual period` (Date 1 7 2026) (Date 10 7 2026) `no holidays`
#ASSERT NOT (`a day is in the usual period` (Date 1 7 2026) (Date 11 7 2026) `no holidays`)
-- The 20th business day after Wednesday 1 July 2026 (no holidays): 7th is Fri 10; Mon 13 (8), 14 (9), 15 (10), 16 (11), 17 (12), Mon 20 (13), 21 (14), 22 (15), 23 (16), 24 (17), Mon 27 (18), 28 (19), Wed 29 (20).
#ASSERT `the last day of the extended usual period` (Date 1 7 2026) `no holidays` EQUALS Date 29 7 2026
-- With Friday 3 July a holiday the 20th is Thursday 30 July.
#ASSERT `the last day of the extended usual period` (Date 1 7 2026) `a holiday on Friday 3 July 2026` EQUALS Date 30 7 2026
#ASSERT NOT (`a day is in the extended usual period` (Date 1 7 2026) (Date 30 6 2026) `no holidays`)
#ASSERT `a day is in the extended usual period` (Date 1 7 2026) (Date 1 7 2026) `no holidays`
#ASSERT `a day is in the extended usual period` (Date 1 7 2026) (Date 29 7 2026) `no holidays`
#ASSERT NOT (`a day is in the extended usual period` (Date 1 7 2026) (Date 30 7 2026) `no holidays`)

§ `s 6(1) "quarter"`

-- 15 February 2026 is in the quarter beginning 1 January 2026, which ends on 31 March 2026.
#ASSERT `the first day of the quarter holding` (Date 15 2 2026) EQUALS Date 1 1 2026
#ASSERT `the last day of the quarter holding` (Date 15 2 2026) EQUALS Date 31 3 2026
#ASSERT `the first day of the quarter holding` (Date 31 3 2026) EQUALS Date 1 1 2026
#ASSERT `the first day of the quarter holding` (Date 1 4 2026) EQUALS Date 1 4 2026
#ASSERT `the last day of the quarter holding` (Date 1 4 2026) EQUALS Date 30 6 2026
#ASSERT `the first day of the quarter holding` (Date 30 9 2026) EQUALS Date 1 7 2026
#ASSERT `the last day of the quarter holding` (Date 30 9 2026) EQUALS Date 30 9 2026
#ASSERT `the first day of the quarter holding` (Date 31 12 2026) EQUALS Date 1 10 2026
#ASSERT `the last day of the quarter holding` (Date 31 12 2026) EQUALS Date 31 12 2026
-- The text does not say what a financial year is.
#ASSERT `the financial year in which a day falls` (Date 1 7 2026) EQUALS NOTHING

§ `s 6B(3): the earliest day a conversion notice may take effect`

-- (a) a notice given before 15 May in the quarter starting 1 April: 1 January (the previous quarter). Given on 14 May 2026 and on 1 April 2026.
#ASSERT `the earliest day a conversion notice may be expressed to take effect` (Date 14 5 2026) EQUALS Date 1 1 2026
#ASSERT `the earliest day a conversion notice may be expressed to take effect` (Date 1 4 2026) EQUALS Date 1 1 2026
-- (e) any other case: given on 15 May 2026 (not before 15 May) the first day of the quarter in which it is given, 1 April 2026.
#ASSERT `the earliest day a conversion notice may be expressed to take effect` (Date 15 5 2026) EQUALS Date 1 4 2026
-- (b) before 15 August in a quarter starting 1 July: 1 April.
#ASSERT `the earliest day a conversion notice may be expressed to take effect` (Date 14 8 2026) EQUALS Date 1 4 2026
#ASSERT `the earliest day a conversion notice may be expressed to take effect` (Date 15 8 2026) EQUALS Date 1 7 2026
-- (c) before 15 November in a quarter starting 1 October: 1 July.
#ASSERT `the earliest day a conversion notice may be expressed to take effect` (Date 14 11 2026) EQUALS Date 1 7 2026
#ASSERT `the earliest day a conversion notice may be expressed to take effect` (Date 15 11 2026) EQUALS Date 1 10 2026
-- (d) before 15 February in a quarter starting 1 January: 1 October of the year before.
#ASSERT `the earliest day a conversion notice may be expressed to take effect` (Date 14 2 2026) EQUALS Date 1 10 2025
#ASSERT `the earliest day a conversion notice may be expressed to take effect` (Date 3 1 2026) EQUALS Date 1 10 2025
#ASSERT `the earliest day a conversion notice may be expressed to take effect` (Date 15 2 2026) EQUALS Date 1 1 2026

§ `s 10(4): the earliest day a benefit certificate may be expressed to have effect`

-- Issued 20 May 2026 with no later day allowed: 15 May has passed, so the first day of the quarter, 1 April 2026.
#ASSERT `the earliest day a benefit certificate may be expressed to have effect` (Date 20 5 2026) NOTHING EQUALS Date 1 4 2026
-- Issued 20 May 2026 when the Commissioner allows 31 May 2026: still "before a later day", so 1 January 2026.
#ASSERT `the earliest day a benefit certificate may be expressed to have effect` (Date 20 5 2026) (JUST (Date 31 5 2026)) EQUALS Date 1 1 2026
-- Issued on the allowed day itself (31 May 2026): not before it, so 1 April 2026.
#ASSERT `the earliest day a benefit certificate may be expressed to have effect` (Date 31 5 2026) (JUST (Date 31 5 2026)) EQUALS Date 1 4 2026
#ASSERT `the earliest day a benefit certificate may be expressed to have effect` (Date 14 8 2026) NOTHING EQUALS Date 1 4 2026
#ASSERT `the earliest day a benefit certificate may be expressed to have effect` (Date 14 11 2026) NOTHING EQUALS Date 1 7 2026
#ASSERT `the earliest day a benefit certificate may be expressed to have effect` (Date 14 2 2026) NOTHING EQUALS Date 1 10 2025
-- (b): the effect day is no later than the issue day, and no earlier than the earliest day.
#ASSERT `a benefit certificate may be expressed to have effect from that day` (Date 20 5 2026) (Date 1 1 2026) (JUST (Date 31 5 2026))
#ASSERT NOT (`a benefit certificate may be expressed to have effect from that day` (Date 20 5 2026) (Date 31 12 2025) (JUST (Date 31 5 2026)))
#ASSERT NOT (`a benefit certificate may be expressed to have effect from that day` (Date 20 5 2026) (Date 21 5 2026) (JUST (Date 31 5 2026)))
#ASSERT `a benefit certificate may be expressed to have effect from that day` (Date 20 5 2026) (Date 20 5 2026) NOTHING

§ `Counting by the same day of the month`

#ASSERT `the same day n months after` (Date 15 1 2026) 1 EQUALS JUST (Date 15 2 2026)
-- 31 January plus one month has no counterpart: the text does not say whether it is 28 February or 3 March.
#ASSERT `the same day n months after` (Date 31 1 2026) 1 EQUALS NOTHING
#ASSERT `the same day n months after` (Date 31 1 2026) 2 EQUALS JUST (Date 31 3 2026)
#ASSERT `the same day n months after` (Date 31 12 2026) 2 EQUALS NOTHING
#ASSERT `the same day n months after` (Date 31 12 2026) 6 EQUALS NOTHING
-- 29 February plus 12 months has no counterpart; plus 48 months it has.
#ASSERT `the same day n months after` (Date 29 2 2028) 12 EQUALS NOTHING
#ASSERT `the same day n months after` (Date 29 2 2028) 48 EQUALS JUST (Date 29 2 2032)
#ASSERT `the same day n months after` (Date 1 7 2026) (0 MINUS 15) EQUALS JUST (Date 1 4 2025)
#ASSERT `the same day n months after` (Date 1 1 2026) (0 MINUS 1) EQUALS JUST (Date 1 12 2025)
#ASSERT `the same day n months after` (Date 31 3 2026) (0 MINUS 1) EQUALS NOTHING

§ `s 17C(4)(c) and s 17D(3)`

-- An application is made at least 30 days before the first day of the period (1 September 2026): 1 August (31 days), 2 August (30 days) pass; 3 August (29 days) does not.
#ASSERT `an application is made at least 30 days before the first day of the period` (Date 1 8 2026) (Date 1 9 2026)
#ASSERT `an application is made at least 30 days before the first day of the period` (Date 2 8 2026) (Date 1 9 2026)
#ASSERT NOT (`an application is made at least 30 days before the first day of the period` (Date 3 8 2026) (Date 1 9 2026))
#ASSERT NOT (`an application is made at least 30 days before the first day of the period` (Date 1 9 2026) (Date 1 9 2026))
-- The 60-day period starting on 10 August 2026 runs from 10 August to 8 October 2026.
#ASSERT NOT (`a day is in the 60-day period starting on the day an application was made` (Date 10 8 2026) (Date 9 8 2026))
#ASSERT `a day is in the 60-day period starting on the day an application was made` (Date 10 8 2026) (Date 10 8 2026)
#ASSERT `a day is in the 60-day period starting on the day an application was made` (Date 10 8 2026) (Date 8 10 2026)
#ASSERT NOT (`a day is in the 60-day period starting on the day an application was made` (Date 10 8 2026) (Date 9 10 2026))

§ `s 18C(1)(c)(ii): the 12-month period ending on the day before the QE day`

-- QE day 1 July 2026: the period is 1 July 2025 to 30 June 2026.
#ASSERT `the first day of the 12-month period ending on the day before` (Date 1 7 2026) EQUALS JUST (Date 1 7 2025)
#ASSERT `a day is in the 12-month period ending on the day before the QE day` (Date 1 7 2026) (Date 30 6 2025) EQUALS JUST FALSE
#ASSERT `a day is in the 12-month period ending on the day before the QE day` (Date 1 7 2026) (Date 1 7 2025) EQUALS JUST TRUE
#ASSERT `a day is in the 12-month period ending on the day before the QE day` (Date 1 7 2026) (Date 30 6 2026) EQUALS JUST TRUE
#ASSERT `a day is in the 12-month period ending on the day before the QE day` (Date 1 7 2026) (Date 1 7 2026) EQUALS JUST FALSE
-- QE day 29 February 2028: the start is "29 February 2027", a day that is not on the calendar; the text does not say which day is meant.
#ASSERT `the first day of the 12-month period ending on the day before` (Date 29 2 2028) EQUALS NOTHING
-- Both readings (start 28 February 2027 or 1 March 2027) put 1 March 2027 inside and 27 February 2027 outside; they differ only on 28 February 2027.
#ASSERT `a day is in the 12-month period ending on the day before the QE day` (Date 29 2 2028) (Date 1 3 2027) EQUALS JUST TRUE
#ASSERT `a day is in the 12-month period ending on the day before the QE day` (Date 29 2 2028) (Date 28 2 2027) EQUALS NOTHING
#ASSERT `a day is in the 12-month period ending on the day before the QE day` (Date 29 2 2028) (Date 27 2 2027) EQUALS JUST FALSE
#ASSERT `a day is in the 12-month period ending on the day before the QE day` (Date 29 2 2028) (Date 29 2 2028) EQUALS JUST FALSE

§ `s 18C(2) item 3: 20 business days starting on the day after a determination`

-- Determination made Tuesday 30 June 2026: the period starts on Wednesday 1 July, a business day, so the 20th business day is counted from 1 July: it is the 19th business day after 1 July, Tuesday 28 July 2026.
#ASSERT `the last day of the 20 business days starting on the day after a determination` (Date 30 6 2026) `no holidays` EQUALS Date 28 7 2026
-- Determination made Friday 3 July 2026: the period starts on Saturday 4 July, not a business day, so the 20th business day after 4 July is counted: Mon 6 (1) to ... Fri 31 July (20).
#ASSERT `the last day of the 20 business days starting on the day after a determination` (Date 3 7 2026) `no holidays` EQUALS Date 31 7 2026

§ `s 20B(2)(c) and s 20C(3)`

-- The certificate is provided no earlier than 15 months before the QE day (1 July 2026): 1 April 2025 is the first day.
#ASSERT `a certificate is provided no earlier than 15 months before the QE day` (Date 1 7 2026) (Date 31 3 2025) EQUALS JUST FALSE
#ASSERT `a certificate is provided no earlier than 15 months before the QE day` (Date 1 7 2026) (Date 1 4 2025) EQUALS JUST TRUE
#ASSERT `a certificate is provided no earlier than 15 months before the QE day` (Date 1 7 2026) (Date 2 4 2025) EQUALS JUST TRUE
-- QE day 31 May 2026: 15 months before is "31 February 2025", a day that is not on the calendar; the bound is 28 February or 1 March 2025.
#ASSERT `a certificate is provided no earlier than 15 months before the QE day` (Date 31 5 2026) (Date 1 3 2025) EQUALS JUST TRUE
#ASSERT `a certificate is provided no earlier than 15 months before the QE day` (Date 31 5 2026) (Date 28 2 2025) EQUALS NOTHING
#ASSERT `a certificate is provided no earlier than 15 months before the QE day` (Date 31 5 2026) (Date 27 2 2025) EQUALS JUST FALSE
-- A notice period begins on the latest of the day employment starts, the day after the previous notice period ended and 1 July 2026.
#ASSERT `the day a notice period begins` (Date 1 3 2026) NOTHING EQUALS Date 1 7 2026
#ASSERT `the day a notice period begins` (Date 15 8 2026) NOTHING EQUALS Date 15 8 2026
#ASSERT `the day a notice period begins` (Date 15 8 2026) (JUST (Date 20 9 2026)) EQUALS Date 20 9 2026
#ASSERT `the day a notice period begins` (Date 1 7 2026) NOTHING EQUALS Date 1 7 2026
#ASSERT `the day a notice period begins` (Date 30 6 2026) NOTHING EQUALS Date 1 7 2026

§ `s 32F: two months after a notice, and the pre-1 July 2005 choice`

#ASSERT `the day a chosen fund takes effect` (Date 15 9 2026) EQUALS JUST (Date 15 11 2026)
-- 31 December plus 2 months: no 31 February; the text does not say.
#ASSERT `the day a chosen fund takes effect` (Date 31 12 2026) EQUALS NOTHING
-- Chosen on 15 August 2005 and the employer fixes no earlier time: the later of 1 July 2005 and 15 October 2005.
#ASSERT `the day a pre-1 July 2005 chosen fund takes effect` (Date 15 8 2005) NOTHING EQUALS JUST (Date 15 10 2005)
-- Chosen on 15 May 2005: 2 months later is 15 July 2005, which is after 1 July 2005.
#ASSERT `the day a pre-1 July 2005 chosen fund takes effect` (Date 15 5 2005) NOTHING EQUALS JUST (Date 15 7 2005)
-- Chosen on 15 January 2005: 15 March 2005 is before 1 July 2005, so 1 July 2005 is the later.
#ASSERT `the day a pre-1 July 2005 chosen fund takes effect` (Date 15 1 2005) NOTHING EQUALS JUST (Date 1 7 2005)
-- The employer fixes 20 September 2005 for a choice made on 15 August 2005: after 1 July 2005 and within the 2 months, so 20 September 2005.
#ASSERT `the day a pre-1 July 2005 chosen fund takes effect` (Date 15 8 2005) (JUST (Date 20 9 2005)) EQUALS JUST (Date 20 9 2005)
-- An earlier time outside the 2 months (a day after them) does not count.
#ASSERT `the day a pre-1 July 2005 chosen fund takes effect` (Date 15 8 2005) (JUST (Date 16 10 2005)) EQUALS JUST (Date 15 10 2005)

§ `s 59A and s 59C: the 28-day period, the 50-day period, the payment period, the 24-month period`

-- A charge that became payable on 1 July 2026: the 28-day period 1 to 28 July; the trigger day is 29 July 2026.
#ASSERT `the current notice trigger day` (Date 1 7 2026) EQUALS Date 29 7 2026
-- 50-day period ending on the day before the trigger day (29 July): 9 June to 28 July 2026.
#ASSERT NOT (`a day is in the 50-day period ending on the day before the trigger day` (Date 29 7 2026) (Date 8 6 2026))
#ASSERT `a day is in the 50-day period ending on the day before the trigger day` (Date 29 7 2026) (Date 9 6 2026)
#ASSERT `a day is in the 50-day period ending on the day before the trigger day` (Date 29 7 2026) (Date 28 7 2026)
#ASSERT NOT (`a day is in the 50-day period ending on the day before the trigger day` (Date 29 7 2026) (Date 29 7 2026))
-- The day specified in the notice must be on or after the trigger day.
#ASSERT NOT (`the day specified in the notice is on or after the trigger day` (Date 29 7 2026) (Date 28 7 2026))
#ASSERT `the day specified in the notice is on or after the trigger day` (Date 29 7 2026) (Date 29 7 2026)
#ASSERT `the day specified in the notice is on or after the trigger day` (Date 29 7 2026) (Date 30 7 2026)
-- Day specified 29 July 2026: the payment period ends on the 28th day after, 26 August 2026.
#ASSERT `the last day of the current notice payment period` (Date 29 7 2026) EQUALS Date 26 8 2026
#ASSERT NOT (`a day is in the current notice payment period` (Date 29 7 2026) (Date 28 7 2026))
#ASSERT `a day is in the current notice payment period` (Date 29 7 2026) (Date 29 7 2026)
#ASSERT `a day is in the current notice payment period` (Date 29 7 2026) (Date 26 8 2026)
#ASSERT NOT (`a day is in the current notice payment period` (Date 29 7 2026) (Date 27 8 2026))
-- The 24-month period ends on the day after the payment period ends (27 August 2026) and starts on 28 August 2024.
#ASSERT `the first day of the 24-month period ending on the day after the end of the payment period` (Date 29 7 2026) EQUALS JUST (Date 28 8 2024)
#ASSERT `a day is in the 24-month period ending on the day after the end of the payment period` (Date 29 7 2026) (Date 27 8 2024) EQUALS JUST FALSE
#ASSERT `a day is in the 24-month period ending on the day after the end of the payment period` (Date 29 7 2026) (Date 28 8 2024) EQUALS JUST TRUE
#ASSERT `a day is in the 24-month period ending on the day after the end of the payment period` (Date 29 7 2026) (Date 27 8 2026) EQUALS JUST TRUE
#ASSERT `a day is in the 24-month period ending on the day after the end of the payment period` (Date 29 7 2026) (Date 28 8 2026) EQUALS JUST FALSE
-- A day specified on 30 January 2028: the payment period ends on 27 February 2028, so the period starts "29 February 2026", a day that is not on the calendar.
#ASSERT `the first day of the 24-month period ending on the day after the end of the payment period` (Date 30 1 2028) EQUALS NOTHING
#ASSERT `a day is in the 24-month period ending on the day after the end of the payment period` (Date 30 1 2028) (Date 1 3 2026) EQUALS JUST TRUE
#ASSERT `a day is in the 24-month period ending on the day after the end of the payment period` (Date 30 1 2028) (Date 28 2 2026) EQUALS NOTHING
#ASSERT `a day is in the 24-month period ending on the day after the end of the payment period` (Date 30 1 2028) (Date 27 2 2026) EQUALS JUST FALSE

§ `s 59D(3) and s 69(4)(b)`

-- A notice given on 1 September 2026: due at least 14 days after, so 15 September passes, 14 September does not.
#ASSERT `the due day is at least 14 days after the day the notice is given` (Date 1 9 2026) (Date 15 9 2026)
#ASSERT NOT (`the due day is at least 14 days after the day the notice is given` (Date 1 9 2026) (Date 14 9 2026))
#ASSERT `the due day is at least 14 days after the day the notice is given` (Date 1 9 2026) (Date 16 9 2026)
-- At least 28 days have passed since 1 September 2026: 29 September (28), 30 September (29) pass, 28 September (27) does not.
#ASSERT `at least 28 days have passed since the notice was given` (Date 1 9 2026) (Date 29 9 2026)
#ASSERT NOT (`at least 28 days have passed since the notice was given` (Date 1 9 2026) (Date 28 9 2026))
#ASSERT `at least 28 days have passed since the notice was given` (Date 1 9 2026) (Date 30 9 2026)

§ `s 74: the amnesty period`

-- The amnesty period started on 24 May 2018. A quarter ended 31 March 2018: 28 days after is 28 April 2018, before 24 May 2018.
#ASSERT `the amnesty period started after the end of the 28 days after the quarter` (Date 31 3 2018)
#ASSERT NOT (`the amnesty period started after the end of the 28 days after the quarter` (Date 30 6 2018))
-- At the limit: a quarter-end of 25 April 2018 (28 days after is 23 May) passes; 26 April 2018 (28 days after is 24 May) does not: 24 May is not after 24 May.
#ASSERT `the amnesty period started after the end of the 28 days after the quarter` (Date 25 4 2018)
#ASSERT NOT (`the amnesty period started after the end of the 28 days after the quarter` (Date 26 4 2018))
-- The text does not give the day of the Royal Assent: a made-up day, 15 January 2021, ends 15 July 2021; 31 August 2020 has no day 31 in February 2021.
#ASSERT `the last day of the amnesty period` (Date 15 1 2021) EQUALS JUST (Date 15 7 2021)
#ASSERT `the last day of the amnesty period` (Date 31 8 2020) EQUALS NOTHING

§ `"within 28 days of ...": the day of the event may or may not be the first day (s 32N)`

-- Event on 1 July 2026: the last day is 29 July (day not counted) or 28 July (day counted as the first).
#ASSERT `the last day of n days after an event` `the day of the event is not counted` (Date 1 7 2026) 28 EQUALS Date 29 7 2026
#ASSERT `the last day of n days after an event` `the day of the event is counted as the first day` (Date 1 7 2026) 28 EQUALS Date 28 7 2026
#ASSERT `an act is within n days of an event` (Date 30 6 2026) (Date 1 7 2026) 28 EQUALS NOTHING
#ASSERT `an act is within n days of an event` (Date 27 7 2026) (Date 1 7 2026) 28 EQUALS JUST TRUE
#ASSERT `an act is within n days of an event` (Date 28 7 2026) (Date 1 7 2026) 28 EQUALS JUST TRUE
#ASSERT `an act is within n days of an event` (Date 29 7 2026) (Date 1 7 2026) 28 EQUALS NOTHING
#ASSERT `an act is within n days of an event` (Date 30 7 2026) (Date 1 7 2026) 28 EQUALS JUST FALSE
#ASSERT `an act is within n days of an event` (Date 1 7 2026) (Date 1 7 2026) 28 EQUALS JUST TRUE

§ `"within 7 business days of the receipt": the day of the event may or may not be the first business day (s 6B(5))`

-- Receipt on Wednesday 1 July 2026 (a business day): the 7th business day is Friday 10 July (day not counted) or Thursday 9 July (day counted).
#ASSERT `the last day of n business days after an event` `the day of the event is not counted` (Date 1 7 2026) 7 `no holidays` EQUALS Date 10 7 2026
#ASSERT `the last day of n business days after an event` `the day of the event is counted as the first day` (Date 1 7 2026) 7 `no holidays` EQUALS Date 9 7 2026
#ASSERT `an act is within n business days of an event` (Date 8 7 2026) (Date 1 7 2026) 7 `no holidays` EQUALS JUST TRUE
#ASSERT `an act is within n business days of an event` (Date 9 7 2026) (Date 1 7 2026) 7 `no holidays` EQUALS JUST TRUE
#ASSERT `an act is within n business days of an event` (Date 10 7 2026) (Date 1 7 2026) 7 `no holidays` EQUALS NOTHING
#ASSERT `an act is within n business days of an event` (Date 11 7 2026) (Date 1 7 2026) 7 `no holidays` EQUALS JUST FALSE
-- Receipt on Saturday 4 July 2026 (not a business day): both readings give Tuesday 14 July.
#ASSERT `an act is within n business days of an event` (Date 14 7 2026) (Date 4 7 2026) 7 `no holidays` EQUALS JUST TRUE
#ASSERT `an act is within n business days of an event` (Date 15 7 2026) (Date 4 7 2026) 7 `no holidays` EQUALS JUST FALSE
#ASSERT `an act is within n business days of an event` (Date 3 7 2026) (Date 4 7 2026) 7 `no holidays` EQUALS NOTHING

§ `"within 4 years from the day" (s 37), "5 years from the date of issue" (s 10(3)(c)), "the end of 5 years after" (s 79(4))`

-- Event on 1 July 2026, 4 years: 1 July 2030 (day not counted) or 30 June 2030 (day counted).
#ASSERT `the last day of n years from an event` `the day of the event is not counted` (Date 1 7 2026) 4 EQUALS JUST (Date 1 7 2030)
#ASSERT `the last day of n years from an event` `the day of the event is counted as the first day` (Date 1 7 2026) 4 EQUALS JUST (Date 30 6 2030)
#ASSERT `an act is within n years from an event` (Date 29 6 2030) (Date 1 7 2026) 4 EQUALS JUST TRUE
#ASSERT `an act is within n years from an event` (Date 30 6 2030) (Date 1 7 2026) 4 EQUALS JUST TRUE
#ASSERT `an act is within n years from an event` (Date 1 7 2030) (Date 1 7 2026) 4 EQUALS NOTHING
#ASSERT `an act is within n years from an event` (Date 2 7 2030) (Date 1 7 2026) 4 EQUALS JUST FALSE
-- An event on 29 February 2028: 4 years later is 29 February 2032, which exists; 1 year later is "29 February 2029", which does not.
#ASSERT `the last day of n years from an event` `the day of the event is not counted` (Date 29 2 2028) 4 EQUALS JUST (Date 29 2 2032)
#ASSERT `the last day of n years from an event` `the day of the event is not counted` (Date 29 2 2028) 1 EQUALS NOTHING
#ASSERT `an act is within n years from an event` (Date 1 3 2028) (Date 29 2 2028) 1 EQUALS NOTHING
-- A benefit certificate issued 1 July 2026 (5 years).
#ASSERT `a benefit certificate has not yet reached the end of 5 years from its issue` (Date 30 6 2031) (Date 1 7 2026) EQUALS JUST TRUE
#ASSERT `a benefit certificate has not yet reached the end of 5 years from its issue` (Date 1 7 2031) (Date 1 7 2026) EQUALS NOTHING
#ASSERT `a benefit certificate has not yet reached the end of 5 years from its issue` (Date 2 7 2031) (Date 1 7 2026) EQUALS JUST FALSE
-- Records prepared on 1 July 2026 and the transactions completed on 1 October 2026: the later of the two ends is the one counted.
#ASSERT `the last day records must be retained` `the day of the event is not counted` (Date 1 7 2026) (Date 1 10 2026) EQUALS JUST (Date 1 10 2031)
#ASSERT `the last day records must be retained` `the day of the event is counted as the first day` (Date 1 7 2026) (Date 1 10 2026) EQUALS JUST (Date 30 9 2031)
#ASSERT `the retention period has not yet ended` (Date 30 9 2031) (Date 1 7 2026) (Date 1 10 2026) EQUALS JUST TRUE
#ASSERT `the retention period has not yet ended` (Date 1 10 2031) (Date 1 7 2026) (Date 1 10 2026) EQUALS NOTHING
#ASSERT `the retention period has not yet ended` (Date 2 10 2031) (Date 1 7 2026) (Date 1 10 2026) EQUALS JUST FALSE
-- Transactions completed before the records were prepared: the later end is still the one counted (the records' own end, 1 October 2031).
#ASSERT `the last day records must be retained` `the day of the event is not counted` (Date 1 10 2026) (Date 1 7 2026) EQUALS JUST (Date 1 10 2031)

§ `s 18C(2) table: the latest day under any applicable item`

-- QE day Wednesday 1 July 2026, no holidays: the extended usual period ends 29 July 2026.
#ASSERT `the latest day under the table of allowable longer periods` (Date 1 7 2026) `no holidays` FALSE NOTHING NOTHING NOTHING EQUALS NOTHING
#ASSERT `the latest day under the table of allowable longer periods` (Date 1 7 2026) `no holidays` TRUE NOTHING NOTHING NOTHING EQUALS JUST (Date 29 7 2026)
-- Item 2: the first standard QE day is Wednesday 15 July 2026; its usual period ends Friday 24 July 2026 (Thu 16 (1), Fri 17 (2), Mon 20 (3), 21, 22, 23 (6), Fri 24 (7)).
#ASSERT `the latest day under the table of allowable longer periods` (Date 1 7 2026) `no holidays` FALSE (JUST (Date 15 7 2026)) NOTHING NOTHING EQUALS JUST (Date 24 7 2026)
-- Item 3: a determination made on 15 July 2026: the 20 business days starting on 16 July end on Wednesday 12 August 2026, later than 29 July.
#ASSERT `the latest day under the table of allowable longer periods` (Date 1 7 2026) `no holidays` FALSE NOTHING (JUST (Date 15 7 2026)) NOTHING EQUALS JUST (Date 12 8 2026)
-- Item 3 with a determination made on 30 June 2026: the 20 business days end 28 July 2026, earlier than 29 July, so 29 July.
#ASSERT `the latest day under the table of allowable longer periods` (Date 1 7 2026) `no holidays` FALSE NOTHING (JUST (Date 30 6 2026)) NOTHING EQUALS JUST (Date 29 7 2026)
-- Item 4: the usual period ends 10 July 2026; a latest due day of 20 July 2026 is later, so it applies; 10 July and 9 July are not later.
#ASSERT `the latest day under the table of allowable longer periods` (Date 1 7 2026) `no holidays` FALSE NOTHING NOTHING (JUST (Date 20 7 2026)) EQUALS JUST (Date 20 7 2026)
#ASSERT `the latest day under the table of allowable longer periods` (Date 1 7 2026) `no holidays` FALSE NOTHING NOTHING (JUST (Date 10 7 2026)) EQUALS NOTHING
#ASSERT `the latest day under the table of allowable longer periods` (Date 1 7 2026) `no holidays` FALSE NOTHING NOTHING (JUST (Date 9 7 2026)) EQUALS NOTHING
-- Several items: the latest applies.
#ASSERT `the latest day under the table of allowable longer periods` (Date 1 7 2026) `no holidays` TRUE NOTHING NOTHING (JUST (Date 20 7 2026)) EQUALS JUST (Date 29 7 2026)
#ASSERT `the latest day under the table of allowable longer periods` (Date 1 7 2026) `no holidays` FALSE (JUST (Date 15 7 2026)) NOTHING (JUST (Date 20 7 2026)) EQUALS JUST (Date 24 7 2026)

§ `s 18C(1)(c): a day of receipt within the periods for the QE day`

-- QE day 1 July 2026, no holidays, no applicable item: the usual period is 1 to 10 July; the 12-month period is 1 July 2025 to 30 June 2026.
#ASSERT `a day of receipt is within the periods for the QE day` (Date 1 7 2026) (Date 30 6 2025) `no holidays` NOTHING EQUALS JUST FALSE
#ASSERT `a day of receipt is within the periods for the QE day` (Date 1 7 2026) (Date 1 7 2025) `no holidays` NOTHING EQUALS JUST TRUE
#ASSERT `a day of receipt is within the periods for the QE day` (Date 1 7 2026) (Date 30 6 2026) `no holidays` NOTHING EQUALS JUST TRUE
#ASSERT `a day of receipt is within the periods for the QE day` (Date 1 7 2026) (Date 1 7 2026) `no holidays` NOTHING EQUALS JUST TRUE
#ASSERT `a day of receipt is within the periods for the QE day` (Date 1 7 2026) (Date 10 7 2026) `no holidays` NOTHING EQUALS JUST TRUE
#ASSERT `a day of receipt is within the periods for the QE day` (Date 1 7 2026) (Date 11 7 2026) `no holidays` NOTHING EQUALS JUST FALSE
-- With an applicable item ending 29 July 2026: "before the end of the latest day" takes in 29 July, not 30 July, and has no lower bound.
#ASSERT `a day of receipt is within the periods for the QE day` (Date 1 7 2026) (Date 29 7 2026) `no holidays` (JUST (Date 29 7 2026)) EQUALS JUST TRUE
#ASSERT `a day of receipt is within the periods for the QE day` (Date 1 7 2026) (Date 30 7 2026) `no holidays` (JUST (Date 29 7 2026)) EQUALS JUST FALSE
#ASSERT `a day of receipt is within the periods for the QE day` (Date 1 7 2026) (Date 30 6 2025) `no holidays` (JUST (Date 29 7 2026)) EQUALS JUST TRUE
-- QE day 29 February 2028: a receipt on 28 February 2027 is the one day the two readings of the 12-month period differ on.
#ASSERT `a day of receipt is within the periods for the QE day` (Date 29 2 2028) (Date 28 2 2027) `no holidays` NOTHING EQUALS NOTHING
#ASSERT `a day of receipt is within the periods for the QE day` (Date 29 2 2028) (Date 1 3 2027) `no holidays` NOTHING EQUALS JUST TRUE
#ASSERT `a day of receipt is within the periods for the QE day` (Date 29 2 2028) (Date 27 2 2027) `no holidays` NOTHING EQUALS JUST FALSE
#ASSERT `either of two possibly unknown conditions holds` NOTHING NOTHING EQUALS NOTHING
#ASSERT `either of two possibly unknown conditions holds` (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `either of two possibly unknown conditions holds` NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `either of two possibly unknown conditions holds` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `either of two possibly unknown conditions holds` (JUST FALSE) NOTHING EQUALS NOTHING

§ `s 18D and s 6(1) "late period"`

-- QE day 1 July 2026, no item: the latest day a contribution can be applied is 10 July 2026; with an item ending 29 July it is 29 July; an item ending before the usual period ends does not move it.
#ASSERT `the latest day an eligible contribution is able to be applied for the QE day` (Date 1 7 2026) `no holidays` NOTHING EQUALS Date 10 7 2026
#ASSERT `the latest day an eligible contribution is able to be applied for the QE day` (Date 1 7 2026) `no holidays` (JUST (Date 29 7 2026)) EQUALS Date 29 7 2026
#ASSERT `the latest day an eligible contribution is able to be applied for the QE day` (Date 1 7 2026) `no holidays` (JUST (Date 5 7 2026)) EQUALS Date 10 7 2026
-- Latest day 10 July 2026, assessment made on 20 July 2026: the late period is 11 to 19 July 2026, nine days.
#ASSERT NOT (`a day is in the late period` (Date 10 7 2026) (Date 20 7 2026) (Date 10 7 2026))
#ASSERT `a day is in the late period` (Date 10 7 2026) (Date 20 7 2026) (Date 11 7 2026)
#ASSERT `a day is in the late period` (Date 10 7 2026) (Date 20 7 2026) (Date 19 7 2026)
#ASSERT NOT (`a day is in the late period` (Date 10 7 2026) (Date 20 7 2026) (Date 20 7 2026))
#ASSERT `the number of days in the late period` (Date 10 7 2026) (Date 20 7 2026) EQUALS 9
-- An assessment on the day after the latest day, or on the latest day, or before it: no days.
#ASSERT `the number of days in the late period` (Date 10 7 2026) (Date 11 7 2026) EQUALS 0
#ASSERT `the number of days in the late period` (Date 10 7 2026) (Date 10 7 2026) EQUALS 0
#ASSERT `the number of days in the late period` (Date 10 7 2026) (Date 5 7 2026) EQUALS 0
-- An assessment two days after the latest day: one day (the day between).
#ASSERT `the number of days in the late period` (Date 10 7 2026) (Date 12 7 2026) EQUALS 1

§ `s 17B and s 17D(3)`

-- A certificate period from 1 July 2026 to the end of the financial year, 30 June 2027.
#ASSERT NOT (`the period specified in the certificate includes the QE day` (Date 1 7 2026) (Date 30 6 2027) (Date 30 6 2026))
#ASSERT `the period specified in the certificate includes the QE day` (Date 1 7 2026) (Date 30 6 2027) (Date 1 7 2026)
#ASSERT `the period specified in the certificate includes the QE day` (Date 1 7 2026) (Date 30 6 2027) (Date 30 6 2027)
#ASSERT NOT (`the period specified in the certificate includes the QE day` (Date 1 7 2026) (Date 30 6 2027) (Date 1 7 2027))
-- Application made 1 September 2026: the 60-day period starting that day runs to 30 October 2026.
-- A notice given on 30 October 2026 is in the period: the deeming does not arise whatever day is asked about.
#ASSERT `the Commissioner is treated as having decided not to issue a certificate` (Date 1 9 2026) (Date 15 12 2026) (JUST (Date 30 10 2026)) EQUALS NOTHING
-- A notice given on 31 October 2026 is outside the period, so none was given during it.
#ASSERT `the Commissioner is treated as having decided not to issue a certificate` (Date 1 9 2026) (Date 15 12 2026) (JUST (Date 31 10 2026)) EQUALS JUST TRUE
-- No notice: on 30 October the period is not yet over; on 31 October it is.
#ASSERT `the Commissioner is treated as having decided not to issue a certificate` (Date 1 9 2026) (Date 30 10 2026) NOTHING EQUALS NOTHING
#ASSERT `the Commissioner is treated as having decided not to issue a certificate` (Date 1 9 2026) (Date 31 10 2026) NOTHING EQUALS JUST TRUE

§ `s 20C(3): the notice period that includes a QE day`

-- A notice period beginning 1 July 2026 with no notice yet that it has ended.
#ASSERT NOT (`a QE day is in the notice period` (Date 1 7 2026) NOTHING (Date 30 6 2026))
#ASSERT `a QE day is in the notice period` (Date 1 7 2026) NOTHING (Date 1 7 2026)
#ASSERT `a QE day is in the notice period` (Date 1 7 2026) NOTHING (Date 31 12 2030)
-- The Commissioner gave notice on 15 August 2026 that the period had ended: the day of the notice is the last day.
#ASSERT `a QE day is in the notice period` (Date 1 7 2026) (JUST (Date 15 8 2026)) (Date 15 8 2026)
#ASSERT NOT (`a QE day is in the notice period` (Date 1 7 2026) (JUST (Date 15 8 2026)) (Date 16 8 2026))

§ `Part 3A: stated days and the day a fund becomes a chosen fund`

#ASSERT `a day is before 29 July 2005` (Date 28 7 2005)
#ASSERT NOT (`a day is before 29 July 2005` (Date 29 7 2005))
#ASSERT `a day is before 1 July 2006` (Date 30 6 2006)
#ASSERT NOT (`a day is before 1 July 2006` (Date 1 7 2006))
#ASSERT `a day is before 1 January 2021` (Date 31 12 2020)
#ASSERT NOT (`a day is before 1 January 2021` (Date 1 1 2021))
#ASSERT `a day is before 1 July 2005` (Date 30 6 2005)
#ASSERT NOT (`a day is before 1 July 2005` (Date 1 7 2005))
-- A notice given on 15 September 2026: a fund becomes chosen 2 months after (15 November 2026), or at an earlier time the employer determines after the notice.
#ASSERT `the day a fund becomes a chosen fund` (Date 15 9 2026) NOTHING EQUALS JUST (Date 15 11 2026)
#ASSERT `the day a fund becomes a chosen fund` (Date 15 9 2026) (JUST (Date 14 11 2026)) EQUALS JUST (Date 14 11 2026)
#ASSERT `the day a fund becomes a chosen fund` (Date 15 9 2026) (JUST (Date 15 9 2026)) EQUALS JUST (Date 15 9 2026)
-- Not earlier than the 2 months, or before the notice: the 2 months govern.
#ASSERT `the day a fund becomes a chosen fund` (Date 15 9 2026) (JUST (Date 15 11 2026)) EQUALS JUST (Date 15 11 2026)
#ASSERT `the day a fund becomes a chosen fund` (Date 15 9 2026) (JUST (Date 14 9 2026)) EQUALS JUST (Date 15 11 2026)
-- A notice on 31 December 2026: there is no 31 February, so the day 2 months after is not fixed (28 February or 3 March 2027).
#ASSERT `the day a fund becomes a chosen fund` (Date 31 12 2026) NOTHING EQUALS NOTHING
#ASSERT `the day a fund becomes a chosen fund` (Date 31 12 2026) (JUST (Date 27 2 2027)) EQUALS JUST (Date 27 2 2027)

§ `Parts 4 to 7: lodging, assessments, general interest charge and the notice period`

-- 33(2)(a): lodged before the day an assessment is made (20 July 2026): 19 July passes; the day itself does not; 21 July does not.
#ASSERT `a statement is lodged before the day an assessment is made` (Date 19 7 2026) (Date 20 7 2026)
#ASSERT NOT (`a statement is lodged before the day an assessment is made` (Date 20 7 2026) (Date 20 7 2026))
#ASSERT NOT (`a statement is lodged before the day an assessment is made` (Date 21 7 2026) (Date 20 7 2026))
-- 36(3): a payment day of Friday 3 July 2026 gives a receipt day of Tuesday 14 July 2026 (Mon 6 (1), 7 (2), 8 (3), 9 (4), 10 (5), Mon 13 (6), Tue 14 (7)).
#ASSERT `the receipt day taken where the statement gives only a payment day` (Date 3 7 2026) `no holidays` EQUALS Date 14 7 2026
-- A payment day of Saturday 4 July 2026 gives Tuesday 14 July 2026 as well.
#ASSERT `the receipt day taken where the statement gives only a payment day` (Date 4 7 2026) `no holidays` EQUALS Date 14 7 2026
-- 49(3): due on 29 July 2026 and unpaid at the end of 29 July: one day; unpaid at the end of 31 July: three days; paid in full by the end of 28 July: none.
#ASSERT `the number of days for which general interest charge is payable` (Date 29 7 2026) (Date 29 7 2026) EQUALS 1
#ASSERT `the number of days for which general interest charge is payable` (Date 29 7 2026) (Date 31 7 2026) EQUALS 3
#ASSERT `the number of days for which general interest charge is payable` (Date 29 7 2026) (Date 28 7 2026) EQUALS 0
-- 59B: a notice specifying 29 July 2026: the payment period ends 26 August 2026.
#ASSERT `the current notice payment period has not expired on the day` (Date 29 7 2026) (Date 26 8 2026)
#ASSERT NOT (`the current notice payment period has not expired on the day` (Date 29 7 2026) (Date 27 8 2026))
-- 59C(2) item 1: imposition day 1 July 2026, the notice specifies 29 July 2026 so the period ends 26 August 2026.
-- A determination covering 20 June to 30 June 2026 does not reach it; one ending 1 July 2026 does; one starting 26 August does; one starting 27 August does not; an open-ended one from 1 June does.
#ASSERT NOT (`a determination covers the employer for some part of the period for item 1` (Date 1 7 2026) (Date 29 7 2026) (Date 20 6 2026) (JUST (Date 30 6 2026)))
#ASSERT `a determination covers the employer for some part of the period for item 1` (Date 1 7 2026) (Date 29 7 2026) (Date 20 6 2026) (JUST (Date 1 7 2026))
#ASSERT `a determination covers the employer for some part of the period for item 1` (Date 1 7 2026) (Date 29 7 2026) (Date 26 8 2026) (JUST (Date 31 8 2026))
#ASSERT NOT (`a determination covers the employer for some part of the period for item 1` (Date 1 7 2026) (Date 29 7 2026) (Date 27 8 2026) (JUST (Date 31 8 2026)))
#ASSERT `a determination covers the employer for some part of the period for item 1` (Date 1 7 2026) (Date 29 7 2026) (Date 1 6 2026) NOTHING

§ `Section 74(3): a disclosure during the amnesty period`

-- The text does not give the day of the Royal Assent; a made-up day, 15 January 2021, ends the period on 15 July 2021.
#ASSERT `a disclosure is made during the amnesty period` (Date 15 1 2021) (Date 23 5 2018) EQUALS JUST FALSE
#ASSERT `a disclosure is made during the amnesty period` (Date 15 1 2021) (Date 24 5 2018) EQUALS JUST TRUE
#ASSERT `a disclosure is made during the amnesty period` (Date 15 1 2021) (Date 15 7 2021) EQUALS JUST TRUE
#ASSERT `a disclosure is made during the amnesty period` (Date 15 1 2021) (Date 16 7 2021) EQUALS JUST FALSE
-- A made-up Royal Assent day of 31 August 2020: 6 months later is "31 February 2021"; the end is 28 February or 1 March 2021.
#ASSERT `a disclosure is made during the amnesty period` (Date 31 8 2020) (Date 28 2 2021) EQUALS JUST TRUE
#ASSERT `a disclosure is made during the amnesty period` (Date 31 8 2020) (Date 1 3 2021) EQUALS NOTHING
#ASSERT `a disclosure is made during the amnesty period` (Date 31 8 2020) (Date 2 3 2021) EQUALS JUST FALSE
#ASSERT `a day is on or before the day n months from` (Date 31 1 2026) (Date 31 1 2026) 1 EQUALS JUST TRUE
