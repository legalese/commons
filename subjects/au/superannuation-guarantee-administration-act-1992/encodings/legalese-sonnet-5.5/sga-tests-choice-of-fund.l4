#ASSERT `the other fund is taken to be a chosen fund from the time the transfer takes effect` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `the other fund is taken to be a chosen fund from the time the transfer takes effect` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `the other fund is taken to be a chosen fund from the time the transfer takes effect` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
