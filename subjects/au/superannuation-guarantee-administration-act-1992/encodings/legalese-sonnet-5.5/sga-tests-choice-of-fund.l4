§ `Divisions 7 and 8`

#ASSERT `is the stapled fund for an employee at a particular time` TRUE EQUALS JUST TRUE
#ASSERT `is the stapled fund for an employee at a particular time` FALSE EQUALS JUST FALSE
#ASSERT `a request to identify any stapled fund meets section 32R(1)` TRUE TRUE
#ASSERT NOT (`a request to identify any stapled fund meets section 32R(1)` TRUE FALSE)
#ASSERT NOT (`a request to identify any stapled fund meets section 32R(1)` FALSE TRUE)
#ASSERT `what the Commissioner must notify in writing, and to whom` FALSE FALSE EQUALS LIST "to the employer: that the Commissioner is not satisfied that there is a stapled fund"
#ASSERT `what the Commissioner must notify in writing, and to whom` TRUE FALSE EQUALS LIST "to the employer and the employer's agent: that the Commissioner is not satisfied that there is a stapled fund"
#ASSERT `what the Commissioner must notify in writing, and to whom` FALSE TRUE EQUALS LIST "to the employer: that the Commissioner is satisfied that there is a stapled fund", "to the employer: the details necessary for the employer to make contributions to that fund"
#ASSERT `what the Commissioner must notify in writing, and to whom` TRUE TRUE EQUALS LIST "to the employer and the employer's agent: that the Commissioner is satisfied that there is a stapled fund", "to the employer and the employer's agent: the details necessary for the employer to make contributions to that fund"
#ASSERT `who the Commissioner must give written notice of a change to an earlier notification` TRUE EQUALS LIST "the employer", "the employer's agent"
#ASSERT `who the Commissioner must give written notice of a change to an earlier notification` FALSE EQUALS LIST "the employer"
#ASSERT `a taxation officer may disclose the tax file number` TRUE TRUE EQUALS JUST TRUE
#ASSERT `a taxation officer may disclose the tax file number` TRUE FALSE EQUALS JUST FALSE
#ASSERT `a taxation officer may disclose the tax file number` FALSE TRUE EQUALS JUST FALSE
#ASSERT `the fund is a chosen fund in relation to a different employer of the employee` TRUE EQUALS JUST FALSE
#ASSERT `the requirement to contribute to a fund is enforceable to the extent the employer contributes instead` TRUE TRUE EQUALS JUST FALSE
#ASSERT `the requirement to contribute to a fund is enforceable to the extent the employer contributes instead` TRUE FALSE EQUALS NOTHING
#ASSERT `the requirement to contribute to a fund is enforceable to the extent the employer contributes instead` FALSE TRUE EQUALS NOTHING
#ASSERT `the blocking provisions have effect in relation to the fund` TRUE TRUE EQUALS JUST FALSE
#ASSERT `the blocking provisions have effect in relation to the fund` TRUE FALSE EQUALS NOTHING
#ASSERT `the employer is liable to compensate a person for loss or damage arising from anything done in complying with Part 3A` EQUALS JUST FALSE
