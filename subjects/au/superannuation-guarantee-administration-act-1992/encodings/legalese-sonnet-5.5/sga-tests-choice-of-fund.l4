#ASSERT `the employer may refuse to accept the fund chosen because the employee chose another fund within the previous 12 months` (Date 15 9 2026) (Date 14 9 2027) EQUALS JUST TRUE
#ASSERT `the employer may refuse to accept the fund chosen because the employee chose another fund within the previous 12 months` (Date 14 9 2026) (Date 14 9 2027) EQUALS JUST TRUE
#ASSERT `the employer may refuse to accept the fund chosen because the employee chose another fund within the previous 12 months` (Date 13 9 2026) (Date 14 9 2027) EQUALS JUST FALSE
#ASSERT `the employer may refuse to accept the fund chosen because the employee chose another fund within the previous 12 months` (Date 14 9 2027) (Date 14 9 2027) EQUALS JUST FALSE
#ASSERT `the fund chosen meets the limits on funds that may be chosen` TRUE TRUE
#ASSERT NOT (`the fund chosen meets the limits on funds that may be chosen` TRUE FALSE)
#ASSERT NOT (`the fund chosen meets the limits on funds that may be chosen` FALSE TRUE)
