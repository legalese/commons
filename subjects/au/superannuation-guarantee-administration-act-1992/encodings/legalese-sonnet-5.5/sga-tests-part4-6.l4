IMPORT prelude
IMPORT daydate
IMPORT `sga-time`
IMPORT `sga-part4-6`

-- sga-tests-part4-6.l4: worked cases for sga-part4-6.l4. Expected values are hand-written from sections 33 to 58.

§ `Section 33`

#ASSERT `the employer may lodge a statement about the shortfall` TRUE EQUALS JUST TRUE
#ASSERT `the employer may lodge a statement about the shortfall` FALSE EQUALS NOTHING
-- Lodged before the day an assessment is made (20 July 2026), and in the approved form.
#ASSERT `a statement is a voluntary disclosure statement` (Date 19 7 2026) (Date 20 7 2026) TRUE
#ASSERT NOT (`a statement is a voluntary disclosure statement` (Date 20 7 2026) (Date 20 7 2026) TRUE)
#ASSERT NOT (`a statement is a voluntary disclosure statement` (Date 19 7 2026) (Date 20 7 2026) FALSE)
#ASSERT `a voluntary disclosure statement may include` "the receipt day of an eligible contribution" EQUALS JUST TRUE
#ASSERT `a voluntary disclosure statement may include` "the payment day of an eligible contribution" EQUALS JUST TRUE
-- "Without limiting subsection (2)": any other item is not decided by the text.
#ASSERT `a voluntary disclosure statement may include` "the name of the fund" EQUALS NOTHING
#ASSERT `is an account for the purposes of section 33` TRUE EQUALS JUST TRUE
#ASSERT `is an account for the purposes of section 33` FALSE EQUALS NOTHING

§ `Sections 36 to 42`

#ASSERT `the Commissioner may at any time make an assessment of the shortfall and the charge payable on it` EQUALS JUST TRUE
#ASSERT `the day charge in relation to an assessment is payable` (Date 20 7 2026) EQUALS Date 20 7 2026
#ASSERT `the Commissioner may at any time amend an assessment, whether or not charge has been paid` EQUALS JUST TRUE
-- 37(2): no avoidance of charge: the subsection does not apply.
#ASSERT `the Commissioner may amend the assessment to correct an avoidance` FALSE FALSE (Date 1 7 2040) (Date 1 7 2026) EQUALS NOTHING
-- Fraud or evasion: at any time.
#ASSERT `the Commissioner may amend the assessment to correct an avoidance` TRUE TRUE (Date 1 7 2040) (Date 1 7 2026) EQUALS JUST TRUE
-- Any other case: within 4 years from the day the assessment is made (1 July 2026); the last day is 1 July 2030 or 30 June 2030.
#ASSERT `the Commissioner may amend the assessment to correct an avoidance` TRUE FALSE (Date 29 6 2030) (Date 1 7 2026) EQUALS JUST TRUE
#ASSERT `the Commissioner may amend the assessment to correct an avoidance` TRUE FALSE (Date 30 6 2030) (Date 1 7 2026) EQUALS JUST TRUE
#ASSERT `the Commissioner may amend the assessment to correct an avoidance` TRUE FALSE (Date 1 7 2030) (Date 1 7 2026) EQUALS NOTHING
#ASSERT `the Commissioner may amend the assessment to correct an avoidance` TRUE FALSE (Date 2 7 2030) (Date 1 7 2026) EQUALS JUST FALSE
#ASSERT `the Commissioner may amend the assessment to correct an avoidance` TRUE FALSE (Date 30 6 2026) (Date 1 7 2026) EQUALS NOTHING
-- 37(3): a reduction within 4 years of the assessment; (5) an application and the information lodged within the period; (6) giving effect to a review or appeal.
#ASSERT `an amendment effecting a reduction in the liability is effective` (Date 29 6 2030) (Date 1 7 2026) FALSE FALSE EQUALS JUST TRUE
#ASSERT `an amendment effecting a reduction in the liability is effective` (Date 1 7 2030) (Date 1 7 2026) FALSE FALSE EQUALS NOTHING
#ASSERT `an amendment effecting a reduction in the liability is effective` (Date 2 7 2030) (Date 1 7 2026) FALSE FALSE EQUALS JUST FALSE
#ASSERT `an amendment effecting a reduction in the liability is effective` (Date 2 7 2030) (Date 1 7 2026) TRUE FALSE EQUALS JUST TRUE
#ASSERT `an amendment effecting a reduction in the liability is effective` (Date 2 7 2030) (Date 1 7 2026) FALSE TRUE EQUALS JUST TRUE
-- 37(4): a further amendment within 4 years from the day charge became payable under the amended assessment.
#ASSERT `the Commissioner may make a further amendment to reduce the liability` (Date 29 6 2031) (Date 1 7 2027) EQUALS JUST TRUE
#ASSERT `the Commissioner may make a further amendment to reduce the liability` (Date 2 7 2031) (Date 1 7 2027) EQUALS JUST FALSE
#ASSERT `the day charge under an amended assessment is taken to have become payable` (Date 20 7 2026) EQUALS Date 20 7 2026
-- 38: 1000 + 50 of general interest charge + 20 of penalty + 10 of Part 4-25 penalty = 1080.
#ASSERT `the overpaid amount` 1000 50 20 10 EQUALS 1080
#ASSERT `the overpaid amount` 0 0 0 0 EQUALS 0
#ASSERT `the amount the Commissioner must refund` 1080 0 EQUALS JUST 1080
-- With a liability to the Commonwealth the text does not say which limb of (b) applies.
#ASSERT `the amount the Commissioner must refund` 1080 300 EQUALS NOTHING
#ASSERT `the amount applied against the liability to the Commonwealth under limb (ii)` 1080 300 EQUALS 300
#ASSERT `the amount applied against the liability to the Commonwealth under limb (ii)` 1080 2000 EQUALS 1080
#ASSERT `the amount applied against the liability to the Commonwealth under limb (ii)` 1080 0 EQUALS 0
#ASSERT `the reduction is taken, for section 49, never to have been payable` EQUALS JUST TRUE
#ASSERT `an amended assessment is taken to be an assessment for all the purposes of the Act` FALSE EQUALS JUST TRUE
#ASSERT `an amended assessment is taken to be an assessment for all the purposes of the Act` TRUE EQUALS NOTHING
#ASSERT `the Commissioner must give written notice of the assessment or amendment to the person liable as soon as practicable` EQUALS JUST TRUE
#ASSERT `non-compliance with a provision of this Act affects an assessment` EQUALS JUST FALSE
#ASSERT `the employer may object in the manner set out in Part IVC of the Taxation Administration Act 1953` TRUE EQUALS JUST TRUE
#ASSERT `the employer may object in the manner set out in Part IVC of the Taxation Administration Act 1953` FALSE EQUALS NOTHING

§ `Parts 5 and 6`

#ASSERT `the Commissioner has the general administration of this Act` EQUALS JUST TRUE
#ASSERT `the Commissioner must give the Treasurer a report on the working of this Act after the end of each year` EQUALS JUST TRUE
#ASSERT `the employer is liable to pay general interest charge on the unpaid amount` TRUE EQUALS JUST TRUE
-- Nothing remains unpaid after the time it was due: the condition in s 49(1) is not met.
#ASSERT `the employer is liable to pay general interest charge on the unpaid amount` FALSE EQUALS JUST FALSE
-- Due 29 July 2026 and unpaid at the end of 31 July: three days, so three daily amounts (10, 11 and 12) are expected; 33 in all.
#ASSERT `the general interest charge payable under section 49` (Date 29 7 2026) (Date 31 7 2026) (LIST 10, 11, 12) EQUALS JUST 33
#ASSERT `the general interest charge payable under section 49` (Date 29 7 2026) (Date 31 7 2026) (LIST 10, 11) EQUALS NOTHING
#ASSERT `the general interest charge payable under section 49` (Date 29 7 2026) (Date 28 7 2026) EMPTY EQUALS JUST 0
#ASSERT `the sum of a list` (LIST 1, 2, 3) EQUALS 6
-- Service on a company or the trustee of a trust estate.
#ASSERT `giving a notice or serving a document is sufficient service` `at the address for service of the public officer, or on the public officer` FALSE EQUALS JUST TRUE
#ASSERT `giving a notice or serving a document is sufficient service` `on a person acting or appearing to act in the business, there being no public officer` FALSE EQUALS JUST TRUE
#ASSERT `giving a notice or serving a document is sufficient service` `on a director, the secretary or another officer of the company` TRUE EQUALS JUST TRUE
#ASSERT `giving a notice or serving a document is sufficient service` `on a director, the secretary or another officer of the company` FALSE EQUALS NOTHING
#ASSERT `giving a notice or serving a document is sufficient service` `on an attorney or agent of the company or trustee` TRUE EQUALS JUST TRUE
#ASSERT `giving a notice or serving a document is sufficient service` `on an attorney or agent of the company or trustee` FALSE EQUALS NOTHING
#ASSERT `giving a notice or serving a document is sufficient service` `somewhere else` TRUE EQUALS NOTHING
#ASSERT `the person is the public officer for the purposes of this Act` TRUE EQUALS JUST TRUE
#ASSERT `the person is the public officer for the purposes of this Act` FALSE EQUALS NOTHING
#ASSERT `the public officer is answerable for the acts required of the company or trustee and is liable to the same penalties` EQUALS JUST TRUE
#ASSERT `the Act applies as if there were no requirement to appoint a public officer` TRUE EQUALS JUST TRUE
#ASSERT `the Act applies as if there were no requirement to appoint a public officer` FALSE EQUALS NOTHING
#ASSERT `the proceeding is taken to have been brought against the company or trustee, who is liable jointly with the public officer for any penalty` TRUE EQUALS JUST TRUE
#ASSERT `the proceeding is taken to have been brought against the company or trustee, who is liable jointly with the public officer for any penalty` FALSE EQUALS NOTHING
