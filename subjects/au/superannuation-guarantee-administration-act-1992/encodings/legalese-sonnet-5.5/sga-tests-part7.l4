IMPORT prelude
IMPORT daydate
IMPORT `sga-time`
IMPORT `sga-part7`

-- sga-tests-part7.l4: worked cases for sga-part7.l4. Expected values are hand-written from sections 59A to 59E.
-- Charge payable from 1 July 2026 (the imposition day): the current notice trigger day is 29 July 2026; the 50-day period ending on the day before it is 9 June to 28 July 2026.

§ `Section 59A`

#ASSERT `section 59A applies` TRUE EQUALS JUST TRUE
#ASSERT `section 59A applies` FALSE EQUALS NOTHING
-- Arguments: part of the amount is the 59A(1) amount; the remainder is unpaid charge; the specified amount; any higher prescribed amount; the trigger day; the day of any earlier notice; no part in an earlier notice.
#ASSERT `the Commissioner must give the employer a written notice to pay as soon as practicable after the current notice trigger day` TRUE TRUE 31 NOTHING (Date 29 7 2026) NOTHING TRUE EQUALS JUST TRUE
-- The amount must exceed $30: 30 does not, 31 does.
#ASSERT `the Commissioner must give the employer a written notice to pay as soon as practicable after the current notice trigger day` TRUE TRUE 30 NOTHING (Date 29 7 2026) NOTHING TRUE EQUALS JUST FALSE
-- A higher prescribed amount of 200 governs: 100 does not exceed it, 201 does; a prescribed amount lower than 30 does not lower the $30.
#ASSERT `the Commissioner must give the employer a written notice to pay as soon as practicable after the current notice trigger day` TRUE TRUE 100 (JUST 200) (Date 29 7 2026) NOTHING TRUE EQUALS JUST FALSE
#ASSERT `the Commissioner must give the employer a written notice to pay as soon as practicable after the current notice trigger day` TRUE TRUE 201 (JUST 200) (Date 29 7 2026) NOTHING TRUE EQUALS JUST TRUE
#ASSERT `the Commissioner must give the employer a written notice to pay as soon as practicable after the current notice trigger day` TRUE TRUE 31 (JUST 20) (Date 29 7 2026) NOTHING TRUE EQUALS JUST TRUE
#ASSERT `the Commissioner must give the employer a written notice to pay as soon as practicable after the current notice trigger day` TRUE TRUE 30 (JUST 20) (Date 29 7 2026) NOTHING TRUE EQUALS JUST FALSE
-- An earlier notice in the 50-day period (9 June to 28 July 2026): 9 June and 28 July are inside; 8 June is outside.
#ASSERT `the Commissioner must give the employer a written notice to pay as soon as practicable after the current notice trigger day` TRUE TRUE 31 NOTHING (Date 29 7 2026) (JUST (Date 9 6 2026)) TRUE EQUALS JUST FALSE
#ASSERT `the Commissioner must give the employer a written notice to pay as soon as practicable after the current notice trigger day` TRUE TRUE 31 NOTHING (Date 29 7 2026) (JUST (Date 28 7 2026)) TRUE EQUALS JUST FALSE
#ASSERT `the Commissioner must give the employer a written notice to pay as soon as practicable after the current notice trigger day` TRUE TRUE 31 NOTHING (Date 29 7 2026) (JUST (Date 8 6 2026)) TRUE EQUALS JUST TRUE
#ASSERT `the Commissioner must give the employer a written notice to pay as soon as practicable after the current notice trigger day` FALSE TRUE 31 NOTHING (Date 29 7 2026) NOTHING TRUE EQUALS JUST FALSE
#ASSERT `the Commissioner must give the employer a written notice to pay as soon as practicable after the current notice trigger day` TRUE FALSE 31 NOTHING (Date 29 7 2026) NOTHING TRUE EQUALS JUST FALSE
#ASSERT `the Commissioner must give the employer a written notice to pay as soon as practicable after the current notice trigger day` TRUE TRUE 31 NOTHING (Date 29 7 2026) NOTHING FALSE EQUALS JUST FALSE
-- 59A(3): the words, and a day specified on or after the trigger day.
#ASSERT `the notice meets section 59A(3)` TRUE (Date 29 7 2026) (Date 29 7 2026)
#ASSERT `the notice meets section 59A(3)` TRUE (Date 29 7 2026) (Date 30 7 2026)
#ASSERT NOT (`the notice meets section 59A(3)` TRUE (Date 29 7 2026) (Date 28 7 2026))
#ASSERT NOT (`the notice meets section 59A(3)` FALSE (Date 29 7 2026) (Date 29 7 2026))
#ASSERT `the notice creates a separate liability to pay the specified amount` EQUALS JUST FALSE

§ `Section 59B`

-- A notice specifying 29 July 2026: the payment period ends 26 August 2026.
#ASSERT `the specified amount in the current notice after a reduction` (Date 29 7 2026) (Date 26 8 2026) 5000 1000 EQUALS JUST 4000
#ASSERT `the specified amount in the current notice after a reduction` (Date 29 7 2026) (Date 27 8 2026) 5000 1000 EQUALS NOTHING
#ASSERT `the current notice is treated as revoked` (Date 29 7 2026) (Date 26 8 2026) TRUE EQUALS JUST TRUE
#ASSERT `the current notice is treated as revoked` (Date 29 7 2026) (Date 27 8 2026) TRUE EQUALS NOTHING
#ASSERT `the current notice is treated as revoked` (Date 29 7 2026) (Date 26 8 2026) FALSE EQUALS NOTHING

§ `Section 59C`

#ASSERT `the employer is liable to pay a penalty` 100 EQUALS JUST TRUE
#ASSERT `the employer is liable to pay a penalty` 0 EQUALS JUST FALSE
-- The notice specifies 29 July 2026: the 24-month period is 28 August 2024 to 27 August 2026.
#ASSERT `an earlier penalty falls in the 24-month period` (Date 29 7 2026) (LIST (Date 28 8 2024)) EQUALS JUST TRUE
#ASSERT `an earlier penalty falls in the 24-month period` (Date 29 7 2026) (LIST (Date 27 8 2024)) EQUALS JUST FALSE
#ASSERT `an earlier penalty falls in the 24-month period` (Date 29 7 2026) (LIST (Date 27 8 2026)) EQUALS JUST TRUE
#ASSERT `an earlier penalty falls in the 24-month period` (Date 29 7 2026) (LIST (Date 28 8 2026)) EQUALS JUST FALSE
#ASSERT `an earlier penalty falls in the 24-month period` (Date 29 7 2026) (LIST (Date 27 8 2024), (Date 1 1 2025)) EQUALS JUST TRUE
#ASSERT `an earlier penalty falls in the 24-month period` (Date 29 7 2026) EMPTY EQUALS JUST FALSE
-- Items 1, 2 and 3: 0%, 50%, 25%; item 1 prevails over item 2.
#ASSERT `the percentage used to work out the penalty` TRUE (JUST FALSE) EQUALS JUST 0
#ASSERT `the percentage used to work out the penalty` TRUE (JUST TRUE) EQUALS JUST 0
#ASSERT `the percentage used to work out the penalty` FALSE (JUST TRUE) EQUALS JUST 50
#ASSERT `the percentage used to work out the penalty` FALSE (JUST FALSE) EQUALS JUST 25
#ASSERT `the percentage used to work out the penalty` FALSE NOTHING EQUALS NOTHING
-- The penalty is a percentage of what remains unpaid at the end of the payment period: 25% of 1000 is 250; 50% is 500; 0% is 0.
#ASSERT `the amount of the penalty` 25 1000 EQUALS 250
#ASSERT `the amount of the penalty` 50 1000 EQUALS 500
#ASSERT `the amount of the penalty` 0 1000 EQUALS 0
#ASSERT `the amount of the penalty` 25 333 EQUALS 83.25

§ `Sections 59D and 59E`

#ASSERT `the Commissioner must make a penalty assessment` TRUE EQUALS JUST TRUE
#ASSERT `the Commissioner must make a penalty assessment` FALSE EQUALS JUST FALSE
#ASSERT `the Commissioner must give written notice of the penalty assessment to the employer` 250 EQUALS JUST TRUE
#ASSERT `the Commissioner must give written notice of the penalty assessment to the employer` 0 EQUALS JUST FALSE
-- Notice given on 1 September 2026: due at least 14 days later, 15 September 2026.
#ASSERT `the penalty is due for payment on the day specified in the notice` (Date 1 9 2026) (Date 15 9 2026)
#ASSERT NOT (`the penalty is due for payment on the day specified in the notice` (Date 1 9 2026) (Date 14 9 2026))
#ASSERT `the employer may object against the penalty assessment in the manner set out in Part IVC of the Taxation Administration Act 1953` TRUE EQUALS JUST TRUE
#ASSERT `the employer may object against the penalty assessment in the manner set out in Part IVC of the Taxation Administration Act 1953` FALSE EQUALS NOTHING
#ASSERT `general interest charge accrues on a late payment of the penalty` EQUALS JUST FALSE
#ASSERT `the Commissioner may remit all or a part of the penalty set out in a penalty assessment` EQUALS JUST FALSE
#ASSERT `the Commissioner must amend the penalty assessment` TRUE FALSE EQUALS JUST TRUE
#ASSERT `the Commissioner must amend the penalty assessment` FALSE TRUE EQUALS JUST TRUE
#ASSERT `the Commissioner must amend the penalty assessment` FALSE FALSE EQUALS JUST FALSE
#ASSERT `the penalty under an amended penalty assessment` 25 1000 EQUALS 250
#ASSERT `the penalty under an amended penalty assessment` 0 1000 EQUALS 0
