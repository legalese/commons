IMPORT prelude
IMPORT daydate
IMPORT `sga-time`
IMPORT `sga-parts8-9`

-- sga-tests-parts8-9.l4: worked cases for sga-parts8-9.l4. Expected values are hand-written from sections 63A to 80.
-- The value of a penalty unit is in section 4AA of the Crimes Act 1914, which is not among the sources; the cases use a made-up value of 100.

§ `Section 63A`

-- Arguments: assessed for a QE day; in the form of general interest charge on charge assessed for a QE day; made by or for an employer in respect of employees.
#ASSERT `Part 8 applies to the payment` TRUE FALSE TRUE
#ASSERT `Part 8 applies to the payment` FALSE TRUE TRUE
#ASSERT NOT (`Part 8 applies to the payment` FALSE FALSE TRUE)
#ASSERT NOT (`Part 8 applies to the payment` TRUE FALSE FALSE)
#ASSERT `the amount treated as a payment of superannuation guarantee charge for Part 8` 500 TRUE EQUALS JUST 500
#ASSERT `the amount treated as a payment of superannuation guarantee charge for Part 8` 500 FALSE EQUALS NOTHING
#ASSERT `the Commissioner is required to pay or deal with the shortfall component for the benefit of a benefiting employee` TRUE EQUALS JUST TRUE
#ASSERT `the Commissioner is required to pay or deal with the shortfall component for the benefit of a benefiting employee` FALSE EQUALS NOTHING

§ `Sections 64A and 64B`

-- 64A(3): 1000 + 100 + 50 + 20 = 1170, less previous payments but not below zero.
#ASSERT `the employee entitlement` 1000 100 50 20 0 EQUALS 1170
#ASSERT `the employee entitlement` 1000 100 50 20 200 EQUALS 970
#ASSERT `the employee entitlement` 1000 100 50 20 1170 EQUALS 0
#ASSERT `the employee entitlement` 1000 100 50 20 5000 EQUALS 0
-- 64A(2): the lesser of the payment and the entitlement.
#ASSERT `the shortfall component for one benefiting employee` 800 1170 EQUALS 800
#ASSERT `the shortfall component for one benefiting employee` 2000 1170 EQUALS 1170
#ASSERT `the shortfall component for one benefiting employee` 1170 1170 EQUALS 1170
-- 64B(4): 2000 + 200 + 100 + 40 = 2340, less previous payments but not below zero.
#ASSERT `the total employee entitlement` 2000 200 100 40 0 EQUALS 2340
#ASSERT `the total employee entitlement` 2000 200 100 40 340 EQUALS 2000
#ASSERT `the total employee entitlement` 2000 200 100 40 9999 EQUALS 0
-- 64B(3): the employee's 600 out of 2400 is 0.25; the Commissioner may vary it (64B(3A)); with no total the text does not say.
#ASSERT `an employee's proportion of an amount` 600 2400 NOTHING EQUALS JUST 0.25
#ASSERT `an employee's proportion of an amount` 600 2400 (JUST 0.2) EQUALS JUST 0.2
#ASSERT `an employee's proportion of an amount` 600 0 NOTHING EQUALS NOTHING
-- 64B(2): the employee's proportion of the lesser of the payment and the total entitlement.
#ASSERT `the shortfall component for a payment in respect of a particular employee` 1000 2340 0.25 EQUALS 250
#ASSERT `the shortfall component for a payment in respect of a particular employee` 3000 2000 0.25 EQUALS 500

§ `Sections 65 to 67`

-- Arguments: a case covered by 65AA, 65A, 66, 66A or 67; the employee has nominated an RSA or fund.
#ASSERT count (`the ways the Commissioner may deal with the shortfall component under section 65(1)` TRUE FALSE) EQUALS 0
#ASSERT count (`the ways the Commissioner may deal with the shortfall component under section 65(1)` FALSE TRUE) EQUALS 3
#ASSERT count (`the ways the Commissioner may deal with the shortfall component under section 65(1)` FALSE FALSE) EQUALS 2
#ASSERT `the payment is conclusively presumed to be a payment to a complying fund` TRUE TRUE EQUALS JUST TRUE
#ASSERT `the payment is conclusively presumed to be a payment to a complying fund` TRUE FALSE EQUALS NOTHING
#ASSERT `the payment is conclusively presumed to be a payment to a complying fund` FALSE TRUE EQUALS NOTHING
#ASSERT `the amount credited to the Superannuation Holding Accounts Special Account` 100 EQUALS 100
#ASSERT `the Commissioner must treat the shortfall component as paid by a superannuation provider under section 20F of that Act` TRUE EQUALS JUST TRUE
#ASSERT `the Commissioner must treat the shortfall component as paid by a superannuation provider under section 20F of that Act` FALSE EQUALS JUST FALSE
-- 65A: aged 65 or more and a request in the approved form.
#ASSERT `the Commissioner must pay the shortfall component directly to an employee who is over 65` FALSE 65 TRUE EQUALS JUST TRUE
#ASSERT `the Commissioner must pay the shortfall component directly to an employee who is over 65` FALSE 64 TRUE EQUALS JUST FALSE
#ASSERT `the Commissioner must pay the shortfall component directly to an employee who is over 65` FALSE 70 FALSE EQUALS JUST FALSE
#ASSERT `the Commissioner must pay the shortfall component directly to an employee who is over 65` TRUE 70 TRUE EQUALS NOTHING
-- 66: retired for incapacity or invalidity, written notice, and a certificate signed by 2 registered medical practitioners.
#ASSERT `the Commissioner must pay the shortfall component to an employee retired due to permanent incapacity or invalidity` FALSE TRUE TRUE 2 EQUALS JUST TRUE
#ASSERT `the Commissioner must pay the shortfall component to an employee retired due to permanent incapacity or invalidity` FALSE TRUE TRUE 3 EQUALS JUST TRUE
#ASSERT `the Commissioner must pay the shortfall component to an employee retired due to permanent incapacity or invalidity` FALSE TRUE TRUE 1 EQUALS JUST FALSE
#ASSERT `the Commissioner must pay the shortfall component to an employee retired due to permanent incapacity or invalidity` FALSE FALSE TRUE 2 EQUALS JUST FALSE
#ASSERT `the Commissioner must pay the shortfall component to an employee retired due to permanent incapacity or invalidity` FALSE TRUE FALSE 2 EQUALS JUST FALSE
#ASSERT `the Commissioner must pay the shortfall component to an employee retired due to permanent incapacity or invalidity` TRUE TRUE TRUE 2 EQUALS NOTHING
-- 66A and 67.
#ASSERT `the Commissioner must pay the shortfall component to an employee with a terminal medical condition` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `the Commissioner must pay the shortfall component to an employee with a terminal medical condition` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `the Commissioner must pay the shortfall component to an employee with a terminal medical condition` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `the Commissioner must pay the shortfall component to the legal personal representative of the employee` FALSE TRUE EQUALS JUST TRUE
#ASSERT `the Commissioner must pay the shortfall component to the legal personal representative of the employee` FALSE FALSE EQUALS JUST FALSE
#ASSERT `the Commissioner must pay the shortfall component to the legal personal representative of the employee` TRUE TRUE EQUALS NOTHING

§ `Sections 69, 69A and 71`

-- 69(4): notice given 1 July 2026; 28 days have passed on 29 July 2026 but not on 28 July 2026; the amount recovered is not more than the amount specified.
#ASSERT `the conditions for recovery are met` TRUE (Date 1 7 2026) (Date 29 7 2026) 500 500
#ASSERT NOT (`the conditions for recovery are met` TRUE (Date 1 7 2026) (Date 28 7 2026) 500 500)
#ASSERT NOT (`the conditions for recovery are met` TRUE (Date 1 7 2026) (Date 29 7 2026) 501 500)
#ASSERT NOT (`the conditions for recovery are met` FALSE (Date 1 7 2026) (Date 29 7 2026) 500 500)
#ASSERT `the Commissioner may recover the excess from the person` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `the Commissioner may recover the excess from the person` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `the Commissioner may recover the excess from the person` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `the Commissioner may recover the excess from the person` FALSE FALSE FALSE EQUALS JUST FALSE
-- 69(5)(b) and (7): an excess of 1000, 300 already recovered from other debtors: at most 700 more; from a benefitting employee no more than the benefits received.
#ASSERT `the most that can still be recovered from a debtor` 1000 300 NOTHING EQUALS 700
#ASSERT `the most that can still be recovered from a debtor` 1000 300 (JUST 500) EQUALS 500
#ASSERT `the most that can still be recovered from a debtor` 1000 300 (JUST 900) EQUALS 700
#ASSERT `the most that can still be recovered from a debtor` 1000 1200 NOTHING EQUALS 0
#ASSERT `a notice of proposed recovery is a legislative instrument` EQUALS JUST FALSE
#ASSERT `the amount to be debited from the account and from the Superannuation Holding Accounts Special Account` 1000 800 TRUE EQUALS JUST 200
#ASSERT `the amount to be debited from the account and from the Superannuation Holding Accounts Special Account` 800 800 TRUE EQUALS NOTHING
#ASSERT `the amount to be debited from the account and from the Superannuation Holding Accounts Special Account` 1000 800 FALSE EQUALS NOTHING
#ASSERT `amounts the Commissioner is required to pay under Part 8 are payable out of the Consolidated Revenue Fund` EQUALS JUST TRUE

§ `Sections 72 and 73`

#ASSERT `the obligation or the liability or the offence of a partnership or association falls on the partners, members or officers` EQUALS JUST TRUE
#ASSERT `it is a defence to an offence taken to have been committed by a partner or an officer` TRUE TRUE EQUALS JUST TRUE
#ASSERT `it is a defence to an offence taken to have been committed by a partner or an officer` TRUE FALSE EQUALS NOTHING
#ASSERT `it is a defence to an offence taken to have been committed by a partner or an officer` FALSE TRUE EQUALS NOTHING
#ASSERT `is an association for the purposes of section 73` TRUE FALSE
#ASSERT NOT (`is an association for the purposes of section 73` TRUE TRUE)
#ASSERT NOT (`is an association for the purposes of section 73` FALSE FALSE)

§ `Section 74`

-- Arguments: the day the Royal Assent was received (made up: 15 January 2021, so the amnesty period ends 15 July 2021); the day of the disclosure; in the approved form; relates to the amount of the shortfall; not disclosed before the amnesty period; the last day of the quarter; the Commissioner told the employer it is looking into compliance.
#ASSERT `an employer qualifies for an amnesty for the shortfall for a quarter` (Date 15 1 2021) (Date 1 7 2020) TRUE TRUE TRUE (Date 31 3 2018) FALSE EQUALS JUST TRUE
-- A quarter ending 31 March 2018: 28 days after is 28 April 2018, before the amnesty period started on 24 May 2018. A quarter ending 30 June 2018 gives 28 July 2018, after it started.
#ASSERT `an employer qualifies for an amnesty for the shortfall for a quarter` (Date 15 1 2021) (Date 1 7 2020) TRUE TRUE TRUE (Date 30 6 2018) FALSE EQUALS JUST FALSE
-- 28 days after 25 April is 23 May, and 24 May starts after it; 28 days after 26 April is 24 May, and 24 May does not start after it.
#ASSERT `an employer qualifies for an amnesty for the shortfall for a quarter` (Date 15 1 2021) (Date 1 7 2020) TRUE TRUE TRUE (Date 25 4 2018) FALSE EQUALS JUST TRUE
#ASSERT `an employer qualifies for an amnesty for the shortfall for a quarter` (Date 15 1 2021) (Date 1 7 2020) TRUE TRUE TRUE (Date 26 4 2018) FALSE EQUALS JUST FALSE
-- Outside the amnesty period; not in the approved form; the Commissioner already told the employer; the information relates to some other amount; the information was disclosed before.
#ASSERT `an employer qualifies for an amnesty for the shortfall for a quarter` (Date 15 1 2021) (Date 16 7 2021) TRUE TRUE TRUE (Date 31 3 2018) FALSE EQUALS JUST FALSE
#ASSERT `an employer qualifies for an amnesty for the shortfall for a quarter` (Date 15 1 2021) (Date 1 7 2020) FALSE TRUE TRUE (Date 31 3 2018) FALSE EQUALS JUST FALSE
#ASSERT `an employer qualifies for an amnesty for the shortfall for a quarter` (Date 15 1 2021) (Date 1 7 2020) TRUE TRUE TRUE (Date 31 3 2018) TRUE EQUALS JUST FALSE
#ASSERT `an employer qualifies for an amnesty for the shortfall for a quarter` (Date 15 1 2021) (Date 1 7 2020) TRUE FALSE TRUE (Date 31 3 2018) FALSE EQUALS JUST FALSE
#ASSERT `an employer qualifies for an amnesty for the shortfall for a quarter` (Date 15 1 2021) (Date 1 7 2020) TRUE TRUE FALSE (Date 31 3 2018) FALSE EQUALS JUST FALSE
-- With a Royal Assent day of 31 August 2020, a disclosure on 1 March 2021 is on the day the text does not settle.
#ASSERT `an employer qualifies for an amnesty for the shortfall for a quarter` (Date 31 8 2020) (Date 1 3 2021) TRUE TRUE TRUE (Date 31 3 2018) FALSE EQUALS NOTHING
-- 74(2): a shortfall of 500 with the information and none without it: 500; with 200 without it: only the increase, 300.
#ASSERT `the shortfall for which the employer qualifies for the amnesty` 500 0 EQUALS 500
#ASSERT `the shortfall for which the employer qualifies for the amnesty` 500 200 EQUALS 300
-- 74(5): arguments are paid on or before the day charge became payable; entered into an arrangement; failed to comply with it.
#ASSERT `the Commissioner may notify the employer that it has ceased to qualify for the amnesty` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `the Commissioner may notify the employer that it has ceased to qualify for the amnesty` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `the Commissioner may notify the employer that it has ceased to qualify for the amnesty` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `the Commissioner may notify the employer that it has ceased to qualify for the amnesty` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `the Commissioner may notify the employer that it has ceased to qualify for the amnesty` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `the employer ceases to qualify, and is taken never to have qualified, for the amnesty` TRUE EQUALS JUST TRUE
#ASSERT `the employer ceases to qualify, and is taken never to have qualified, for the amnesty` FALSE EQUALS JUST FALSE

§ `Section 79`

#ASSERT `the employer keeps the records section 79 requires` TRUE TRUE TRUE TRUE
#ASSERT NOT (`the employer keeps the records section 79 requires` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`the employer keeps the records section 79 requires` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`the employer keeps the records section 79 requires` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`the employer keeps the records section 79 requires` TRUE TRUE TRUE FALSE)
-- 79(4): records prepared 1 July 2026 and the acts completed 1 January 2027: retained until the end of 5 years after the later, about 1 January 2032.
#ASSERT `the employer must retain the records on the day` (Date 15 3 2030) (Date 1 7 2026) (Date 1 1 2027) FALSE FALSE EQUALS JUST TRUE
#ASSERT `the employer must retain the records on the day` (Date 15 3 2032) (Date 1 7 2026) (Date 1 1 2027) FALSE FALSE EQUALS JUST FALSE
#ASSERT `the employer must retain the records on the day` (Date 1 1 2032) (Date 1 7 2026) (Date 1 1 2027) FALSE FALSE EQUALS NOTHING
-- 79(5): no retention where the Commissioner has said it is not required, or where the company has been finally dissolved.
#ASSERT `the employer must retain the records on the day` (Date 15 3 2030) (Date 1 7 2026) (Date 1 1 2027) TRUE FALSE EQUALS JUST FALSE
#ASSERT `the employer must retain the records on the day` (Date 15 3 2030) (Date 1 7 2026) (Date 1 1 2027) FALSE TRUE EQUALS JUST FALSE
-- 79(6), (6A), (7): an offence for a contravention unless there is a reasonable excuse.
#ASSERT `the employer commits an offence against section 79` FALSE FALSE EQUALS NOTHING
#ASSERT `the employer commits an offence against section 79` TRUE TRUE EQUALS JUST FALSE
#ASSERT `the employer commits an offence against section 79` TRUE FALSE EQUALS JUST TRUE
-- 30 penalty units at 100 is 3000; section 80: 5 penalty units at 100 is 500.
#ASSERT `the largest fine for an offence against section 79` 100 EQUALS 3000
#ASSERT `the largest fine the regulations may prescribe for an offence against the regulations` 100 EQUALS 500
