IMPORT prelude
IMPORT daydate
IMPORT `nras-rules`

-- Independent tests from the source text and BRIEF.md only (see
-- independent-expectations.md). Expected values were not adjusted to the code.

`dw` MEANS `a dwelling, or a part capable of being lived in as a separate residence`

-- the base case of independent-expectations.md, with the varying inputs as parameters
GIVEN kind IS A `Kind of dwelling`
      rentp IS A BOOLEAN
      start IS A DATE
      livedBefore IS A BOOLEAN
      unfitRoute IS A BOOLEAN
      rented IS A BOOLEAN
      prescribed IS A BOOLEAN
      charges IS A LIST OF NUMBER
      disapplied IS A BOOLEAN
      vacancy IS A NUMBER
      day IS A DATE
GIVETH A `Dwelling position`
`pos` kind rentp start livedBefore unfitRoute rented prescribed charges disapplied vacancy day MEANS
    `the dwelling position for`
        (`Dwelling case` OF kind, rentp, start, livedBefore, unfitRoute, rented, prescribed, charges, 500, disapplied, vacancy, 30, day)

GIVEN p IS A `Dwelling position`
GIVETH A BOOLEAN
`meets all` p MEANS
        p's `the newness condition of s 7(2)(a) is met`
    AND p's `the rent condition is met this year`
    AND p's `the tenant or vacancy condition is met this year`

-- quick constructors: only the year's facts vary
GIVEN livedBefore IS A BOOLEAN
      unfitRoute IS A BOOLEAN
      rented IS A BOOLEAN
      prescribed IS A BOOLEAN
      charges IS A LIST OF NUMBER
      disapplied IS A BOOLEAN
      vacancy IS A NUMBER
GIVETH A BOOLEAN
`year ok` livedBefore unfitRoute rented prescribed charges disapplied vacancy MEANS
    `meets all` (`pos` `dw` TRUE (Date 1 7 2010) livedBefore unfitRoute rented prescribed charges disapplied vacancy (Date 1 8 2012))

GIVEN kind IS A `Kind of dwelling`
      rentp IS A BOOLEAN
GIVETH A BOOLEAN
`is rental` kind rentp MEANS
    (`pos` kind rentp (Date 1 7 2010) FALSE FALSE TRUE TRUE (LIST 400) FALSE 0 (Date 1 8 2012))'s `it is a rental dwelling under s 4`

GIVEN start IS A DATE
GIVETH A DATE
`period end` start MEANS
    (`pos` `dw` TRUE start FALSE FALSE TRUE TRUE (LIST 400) FALSE 0 (Date 1 8 2012))'s `the incentive period ends on`

GIVEN day IS A DATE
GIVETH A `Dwelling position`
`at` day MEANS
    `pos` `dw` TRUE (Date 1 7 2010) FALSE FALSE TRUE TRUE (LIST 400) FALSE 0 day

-- Rental dwelling, s 4
#ASSERT `is rental` `dw` TRUE EQUALS TRUE
#ASSERT `is rental` `a strata unit` TRUE EQUALS TRUE
#ASSERT `is rental` `a caravan, houseboat or other mobile dwelling` TRUE EQUALS FALSE
#ASSERT `is rental` `a dwelling the regulations exclude` TRUE EQUALS FALSE
#ASSERT `is rental` `dw` FALSE EQUALS FALSE

-- Incentive period end, s 4
#ASSERT `period end` (Date 1 7 2008) EQUALS Date 30 6 2018
#ASSERT `period end` (Date 1 5 2010) EQUALS Date 30 4 2020
#ASSERT `period end` (Date 15 3 2012) EQUALS Date 14 3 2022
#ASSERT `period end` (Date 29 2 2012) EQUALS Date 28 2 2022

-- NRAS year, s 4
#ASSERT (`at` (Date 30 6 2008))'s `the NRAS year starts on` EQUALS NOTHING
#ASSERT (`at` (Date 30 6 2008))'s `the NRAS year ends on` EQUALS NOTHING
#ASSERT (`at` (Date 1 7 2008))'s `the NRAS year starts on` EQUALS JUST (Date 1 7 2008)
#ASSERT (`at` (Date 1 7 2008))'s `the NRAS year ends on` EQUALS JUST (Date 30 4 2009)
#ASSERT (`at` (Date 30 4 2009))'s `the NRAS year starts on` EQUALS JUST (Date 1 7 2008)
#ASSERT (`at` (Date 30 4 2009))'s `the NRAS year ends on` EQUALS JUST (Date 30 4 2009)
#ASSERT (`at` (Date 1 5 2009))'s `the NRAS year starts on` EQUALS JUST (Date 1 5 2009)
#ASSERT (`at` (Date 1 5 2009))'s `the NRAS year ends on` EQUALS JUST (Date 30 4 2010)
#ASSERT (`at` (Date 30 4 2015))'s `the NRAS year starts on` EQUALS JUST (Date 1 5 2014)
#ASSERT (`at` (Date 30 4 2015))'s `the NRAS year ends on` EQUALS JUST (Date 30 4 2015)
#ASSERT (`at` (Date 1 5 2015))'s `the NRAS year starts on` EQUALS JUST (Date 1 5 2015)
#ASSERT (`at` (Date 1 5 2015))'s `the NRAS year ends on` EQUALS JUST (Date 30 4 2016)
#ASSERT (`at` (Date 1 1 2020))'s `the NRAS year starts on` EQUALS JUST (Date 1 5 2019)
#ASSERT (`at` (Date 1 1 2020))'s `the NRAS year ends on` EQUALS JUST (Date 30 4 2020)

-- Conditions, s 7(2), (5). Args: lived before, unfit route, rented, prescribed tenants, charges, disapplied, vacancy (allowed 30, MVR 500)
-- C1
#ASSERT `year ok` FALSE FALSE TRUE TRUE (LIST 400) FALSE 0 EQUALS TRUE
-- C2
#ASSERT `year ok` FALSE FALSE TRUE TRUE (LIST 401) FALSE 0 EQUALS FALSE
-- C3
#ASSERT `year ok` FALSE FALSE TRUE TRUE (LIST 300, 400) FALSE 0 EQUALS TRUE
-- C4
#ASSERT `year ok` FALSE FALSE TRUE TRUE (LIST 300, 450) FALSE 0 EQUALS FALSE
-- C5
#ASSERT `year ok` FALSE FALSE TRUE TRUE (LIST 401) TRUE 0 EQUALS TRUE
-- C6
#ASSERT `year ok` FALSE FALSE TRUE FALSE (LIST 400) FALSE 0 EQUALS FALSE
-- C7
#ASSERT `year ok` FALSE FALSE TRUE FALSE (LIST 400) TRUE 0 EQUALS FALSE
-- C8
#ASSERT `year ok` TRUE FALSE TRUE TRUE (LIST 400) FALSE 0 EQUALS FALSE
-- C9
#ASSERT `year ok` TRUE TRUE TRUE TRUE (LIST 400) FALSE 0 EQUALS TRUE
-- C10
#ASSERT `year ok` FALSE FALSE FALSE TRUE (LIST 400) FALSE 30 EQUALS TRUE
-- C11
#ASSERT `year ok` FALSE FALSE FALSE TRUE (LIST 400) FALSE 31 EQUALS FALSE
-- C12
#ASSERT `year ok` FALSE FALSE FALSE FALSE (LIST 900) FALSE 10 EQUALS TRUE
-- C13
#ASSERT `year ok` FALSE FALSE TRUE TRUE (LIST 400) FALSE 31 EQUALS FALSE
