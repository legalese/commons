IMPORT prelude
IMPORT daydate
IMPORT `nras-rules`

-- National Rental Affordability Scheme Act 2008 (Cth) — the encoder's tests.

§ `Tests`

`house` MEANS `a dwelling, or a part capable of being lived in as a separate residence`

GIVEN rents IS A LIST OF NUMBER
      vac IS A NUMBER
      asked IS A DATE
GIVETH A `Dwelling case`
`a new house rented at` rents `vacant` vac `asked on` asked MEANS
    `Dwelling case` OF `house`, TRUE, Date 1 7 2012, FALSE, FALSE, TRUE, TRUE, rents, 500, FALSE, vac, 90, asked

#ASSERT `it is a rental dwelling` (`a new house rented at` (LIST 400) `vacant` 0 `asked on` (Date 1 1 2015))
#ASSERT NOT (`it is a rental dwelling` (`Dwelling case` OF `a caravan, houseboat or other mobile dwelling`, TRUE, Date 1 7 2012, FALSE, FALSE, TRUE, TRUE, (LIST 400), 500, FALSE, 0, 90, Date 1 1 2015))
-- s 4: 1 July 2012 to 30 June 2022.
#ASSERT `the end of the incentive period for` (`a new house rented at` (LIST 400) `vacant` 0 `asked on` (Date 1 1 2015)) EQUALS Date 30 6 2022
-- s 7(2)(b)(ii): 400 is exactly 20% below 500; 401 is not.
#ASSERT `the rent condition is met` (`a new house rented at` (LIST 400, 380) `vacant` 0 `asked on` (Date 1 1 2015))
#ASSERT NOT (`the rent condition is met` (`a new house rented at` (LIST 400, 401) `vacant` 0 `asked on` (Date 1 1 2015)))
#ASSERT `the rent condition is met` (`Dwelling case` OF `house`, TRUE, Date 1 7 2012, FALSE, FALSE, TRUE, TRUE, (LIST 450), 500, TRUE, 0, 90, Date 1 1 2015)
-- s 7(2)(c)
#ASSERT `the tenant or vacancy condition is met` (`a new house rented at` (LIST 400) `vacant` 90 `asked on` (Date 1 1 2015))
#ASSERT NOT (`the tenant or vacancy condition is met` (`a new house rented at` (LIST 400) `vacant` 91 `asked on` (Date 1 1 2015)))
#ASSERT NOT (`the tenant or vacancy condition is met` (`Dwelling case` OF `house`, TRUE, Date 1 7 2012, FALSE, FALSE, TRUE, FALSE, (LIST 400), 500, FALSE, 0, 90, Date 1 1 2015))
-- s 7(2)(a)
#ASSERT `the newness condition is met` (`a new house rented at` (LIST 400) `vacant` 0 `asked on` (Date 1 1 2015))
#ASSERT NOT (`the newness condition is met` (`Dwelling case` OF `house`, TRUE, Date 1 7 2012, TRUE, FALSE, TRUE, TRUE, (LIST 400), 500, FALSE, 0, 90, Date 1 1 2015))
#ASSERT `the newness condition is met` (`Dwelling case` OF `house`, TRUE, Date 1 7 2012, TRUE, TRUE, TRUE, TRUE, (LIST 400), 500, FALSE, 0, 90, Date 1 1 2015)
-- s 4 NRAS year
#ASSERT `the NRAS year start for` (Date 1 1 2015) EQUALS JUST (Date 1 5 2014)
#ASSERT `the NRAS year end for` (Date 1 1 2015) EQUALS JUST (Date 30 4 2015)
#ASSERT `the NRAS year start for` (Date 1 5 2015) EQUALS JUST (Date 1 5 2015)
#ASSERT `the NRAS year start for` (Date 30 4 2009) EQUALS JUST (Date 1 7 2008)
#ASSERT `the NRAS year end for` (Date 1 7 2008) EQUALS JUST (Date 30 4 2009)
#ASSERT `the NRAS year start for` (Date 1 5 2009) EQUALS JUST (Date 1 5 2009)
#ASSERT `the NRAS year start for` (Date 30 6 2008) EQUALS NOTHING
