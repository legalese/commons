IMPORT prelude
IMPORT daydate
IMPORT `co-rules`

-- 1 s 3A(1): citizen with diplomatic immunity
#ASSERT (`the Act applies` (`Overseas case` OF `an Australian citizen`, `diplomatic, consular or international-organisation immunity`, TRUE, FALSE, FALSE, FALSE, TRUE, FALSE, (Date 20 3 2025), (Date 20 3 2025))) EQUALS TRUE

-- 1 s 4(1)
#ASSERT (`Jervis Bay law applies` (`Overseas case` OF `an Australian citizen`, `diplomatic, consular or international-organisation immunity`, TRUE, FALSE, FALSE, FALSE, TRUE, FALSE, (Date 20 3 2025), (Date 20 3 2025))) EQUALS TRUE

-- 2 s 3 Australian (b)
#ASSERT (`the Act applies` (`Overseas case` OF `a non-citizen permitted to remain in Australia indefinitely`, `diplomatic, consular or international-organisation immunity`, TRUE, FALSE, FALSE, FALSE, TRUE, FALSE, (Date 20 3 2025), (Date 20 3 2025))) EQUALS TRUE

-- 3 neither -> not Australian
#ASSERT (`the Act applies` (`Overseas case` OF `neither`, `diplomatic, consular or international-organisation immunity`, TRUE, FALSE, FALSE, FALSE, TRUE, FALSE, (Date 20 3 2025), (Date 20 3 2025))) EQUALS FALSE

-- 3b neither, declared country route
#ASSERT (`the Act applies` (`Overseas case` OF `neither`, `working for the Commonwealth in a declared foreign country or part`, TRUE, FALSE, FALSE, FALSE, TRUE, FALSE, (Date 20 3 2025), (Date 20 3 2025))) EQUALS FALSE

-- 4 s 3A(2): continuing local prosecution
#ASSERT (`the Act applies` (`Overseas case` OF `an Australian citizen`, `diplomatic, consular or international-organisation immunity`, TRUE, TRUE, FALSE, FALSE, TRUE, FALSE, (Date 20 3 2025), (Date 20 3 2025))) EQUALS FALSE

-- 5 s 3A(2) qualifies only (1): (3) route unaffected
#ASSERT (`the Act applies` (`Overseas case` OF `an Australian citizen`, `immune under a relevant agreement or arrangement while working under one`, TRUE, TRUE, FALSE, FALSE, TRUE, FALSE, (Date 20 3 2025), (Date 20 3 2025))) EQUALS TRUE

-- 6 s 3A(3)
#ASSERT (`the Act applies` (`Overseas case` OF `an Australian citizen`, `immune under a relevant agreement or arrangement while working under one`, TRUE, FALSE, FALSE, FALSE, TRUE, FALSE, (Date 20 3 2025), (Date 20 3 2025))) EQUALS TRUE

-- 7 s 3A(4)
#ASSERT (`the Act applies` (`Overseas case` OF `an Australian citizen`, `working under a declared agreement or arrangement`, TRUE, FALSE, FALSE, FALSE, TRUE, FALSE, (Date 20 3 2025), (Date 20 3 2025))) EQUALS TRUE

-- 8 s 3A(4)(d) outside category
#ASSERT (`the Act applies` (`Overseas case` OF `an Australian citizen`, `working under a declared agreement or arrangement`, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, (Date 20 3 2025), (Date 20 3 2025))) EQUALS FALSE

-- 9 s 3A(5),(6)
#ASSERT (`the Act applies` (`Overseas case` OF `an Australian citizen`, `working for the Commonwealth in a declared foreign country or part`, TRUE, FALSE, FALSE, FALSE, TRUE, FALSE, (Date 20 3 2025), (Date 20 3 2025))) EQUALS TRUE

-- 10 s 3A(5)(d) outside category
#ASSERT (`the Act applies` (`Overseas case` OF `an Australian citizen`, `working for the Commonwealth in a declared foreign country or part`, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, (Date 20 3 2025), (Date 20 3 2025))) EQUALS FALSE

-- 10b category irrelevant to s 3A(1)
#ASSERT (`the Act applies` (`Overseas case` OF `an Australian citizen`, `diplomatic, consular or international-organisation immunity`, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, (Date 20 3 2025), (Date 20 3 2025))) EQUALS TRUE

-- 11 ground none
#ASSERT (`the Act applies` (`Overseas case` OF `an Australian citizen`, `none`, TRUE, FALSE, FALSE, FALSE, TRUE, FALSE, (Date 20 3 2025), (Date 20 3 2025))) EQUALS FALSE

-- 12 s 3A(10)(a) ADF
#ASSERT (`the Act applies` (`Overseas case` OF `an Australian citizen`, `diplomatic, consular or international-organisation immunity`, TRUE, FALSE, TRUE, FALSE, TRUE, FALSE, (Date 20 3 2025), (Date 20 3 2025))) EQUALS FALSE

-- 12b s 3A(10) despite (3)
#ASSERT (`the Act applies` (`Overseas case` OF `an Australian citizen`, `working for the Commonwealth in a declared foreign country or part`, TRUE, FALSE, TRUE, FALSE, TRUE, FALSE, (Date 20 3 2025), (Date 20 3 2025))) EQUALS FALSE

-- 13 s 3A(10)(b) intelligence staff
#ASSERT (`the Act applies` (`Overseas case` OF `an Australian citizen`, `diplomatic, consular or international-organisation immunity`, TRUE, FALSE, FALSE, TRUE, TRUE, FALSE, (Date 20 3 2025), (Date 20 3 2025))) EQUALS FALSE

-- 14 s 4(1)(b) no breach
#ASSERT (`Jervis Bay law applies` (`Overseas case` OF `an Australian citizen`, `diplomatic, consular or international-organisation immunity`, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, (Date 20 3 2025), (Date 20 3 2025))) EQUALS FALSE

-- 15 s 4(2) no consent
#ASSERT (`proceedings may be commenced` (`Overseas case` OF `an Australian citizen`, `diplomatic, consular or international-organisation immunity`, TRUE, FALSE, FALSE, FALSE, TRUE, FALSE, (Date 20 3 2025), (Date 20 3 2025))) EQUALS FALSE

-- 15 s 4(4) arrest before consent
#ASSERT ((`the overseas position for` (`Overseas case` OF `an Australian citizen`, `diplomatic, consular or international-organisation immunity`, TRUE, FALSE, FALSE, FALSE, TRUE, FALSE, (Date 20 3 2025), (Date 20 3 2025)))'s `I may be arrested or charged before consent`) EQUALS TRUE

-- 16 s 4(2) consent
#ASSERT (`proceedings may be commenced` (`Overseas case` OF `an Australian citizen`, `diplomatic, consular or international-organisation immunity`, TRUE, FALSE, FALSE, FALSE, TRUE, TRUE, (Date 20 3 2025), (Date 20 3 2025))) EQUALS TRUE

-- 16b consent but Act not applying
#ASSERT (`proceedings may be commenced` (`Overseas case` OF `an Australian citizen`, `diplomatic, consular or international-organisation immunity`, TRUE, FALSE, TRUE, FALSE, TRUE, TRUE, (Date 20 3 2025), (Date 20 3 2025))) EQUALS FALSE

-- 17 s 8(6): 14 clear days before 20 Mar 2025
#ASSERT ((`the overseas position for` (`Overseas case` OF `an Australian citizen`, `diplomatic, consular or international-organisation immunity`, TRUE, FALSE, FALSE, FALSE, TRUE, FALSE, (Date 20 3 2025), (Date 20 3 2025)))'s `the last day to give me a copy of a certificate`) EQUALS (Date 5 3 2025)

-- 18 s 8(6): leap year
#ASSERT ((`the overseas position for` (`Overseas case` OF `an Australian citizen`, `diplomatic, consular or international-organisation immunity`, TRUE, FALSE, FALSE, FALSE, TRUE, FALSE, (Date 10 3 2024), (Date 20 3 2025)))'s `the last day to give me a copy of a certificate`) EQUALS (Date 24 2 2024)

-- 19 s 8(8)(a): 4 clear days before 20 Mar 2025
#ASSERT ((`the overseas position for` (`Overseas case` OF `an Australian citizen`, `diplomatic, consular or international-organisation immunity`, TRUE, FALSE, FALSE, FALSE, TRUE, FALSE, (Date 20 3 2025), (Date 20 3 2025)))'s `the last day to notify the prosecutor to call the issuer`) EQUALS (Date 15 3 2025)

-- 20 s 8(8)(a): leap year
#ASSERT ((`the overseas position for` (`Overseas case` OF `an Australian citizen`, `diplomatic, consular or international-organisation immunity`, TRUE, FALSE, FALSE, FALSE, TRUE, FALSE, (Date 20 3 2025), (Date 2 3 2024)))'s `the last day to notify the prosecutor to call the issuer`) EQUALS (Date 26 2 2024)
