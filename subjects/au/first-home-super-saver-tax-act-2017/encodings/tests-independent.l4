IMPORT prelude
IMPORT daydate
IMPORT `fhss-rules`

-- Independent tests, written from independent-expectations.md (Act and brief only).

`release of` payable amt d MEANS `FHSS release` OF payable, amt, d

-- 1. s 4: 20% of the amount
#ASSERT `my first home super saver tax for` (`release of` TRUE 10000 (Date 1 3 2019)) EQUALS JUST 2000
-- 2. 20% of nil: tax imposed, amount nil
#ASSERT `my first home super saver tax for` (`release of` TRUE 0 (Date 1 3 2019)) EQUALS JUST 0
-- 3. s 3: not payable under s 313-60, nothing imposed
#ASSERT `my first home super saver tax for` (`release of` FALSE 10000 (Date 1 3 2019)) EQUALS NOTHING
-- 4. commencement day itself
#ASSERT `my first home super saver tax for` (`release of` TRUE 5000 (Date 1 7 2018)) EQUALS JUST 1000
-- 5. day before commencement
#ASSERT `my first home super saver tax for` (`release of` TRUE 5000 (Date 30 6 2018)) EQUALS NOTHING
-- 6. assent day, before commencement
#ASSERT `my first home super saver tax for` (`release of` TRUE 5000 (Date 13 12 2017)) EQUALS NOTHING
-- 7. no rounding in the Act
#ASSERT `my first home super saver tax for` (`release of` TRUE 1234.56 (Date 15 7 2024)) EQUALS JUST 246.912
-- 8. no cap in this Act
#ASSERT `my first home super saver tax for` (`release of` TRUE 50000 (Date 1 1 2025)) EQUALS JUST 10000
