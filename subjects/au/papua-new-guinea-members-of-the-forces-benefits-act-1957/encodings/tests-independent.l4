IMPORT prelude
IMPORT daydate
IMPORT `pngf-rules`

-- Independent tests, written from BRIEF.md and the Act (see
-- independent-expectations.md). Field order of `Service record`:
-- male indigenous PNG/Pacific, served from, paid below min, ended,
-- occurrence, arose out of, pre-existing aggravated, default, self-inflicted,
-- breach of discipline.

GIVEN start IS A DATE
GIVETH A `Service record`
`a baseline member from` start MEANS
    `Service record` OF TRUE, start, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE

baseline MEANS `a baseline member from` (Date 1 3 1942)

-- 1 baseline: member
#ASSERT `a member of the Forces under s 3` baseline
-- 2 female / 6 State island: the single boolean is FALSE
#ASSERT NOT (`a member of the Forces under s 3` (`Service record` OF FALSE, Date 1 3 1942, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE))
-- 3 pay equal to the minimum (not less than)
#ASSERT NOT (`a member of the Forces under s 3` (`Service record` OF TRUE, Date 1 3 1942, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE))
-- 4 still serving
#ASSERT NOT (`a member of the Forces under s 3` (`Service record` OF TRUE, Date 1 3 1942, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE))
-- 5 / 7 terminated by death; Pacific island not part of a State: same booleans TRUE
#ASSERT `a member of the Forces under s 3` (`Service record` OF TRUE, Date 1 6 1943, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)
-- 8 service only from 1 Oct 1945
#ASSERT NOT (`a member of the Forces under s 3` (`a baseline member from` (Date 1 10 1945)))
-- 9 service only on 2 Sep 1939 (start 2 Sep 1939 and ended that day)
#ASSERT NOT (`a member of the Forces under s 3` (`a baseline member from` (Date 2 9 1939)))
-- 10 first day of the war
#ASSERT `a member of the Forces under s 3` (`a baseline member from` (Date 3 9 1939))
-- last day before 3 Sep 1945
#ASSERT `a member of the Forces under s 3` (`a baseline member from` (Date 2 9 1945))
-- 22 (added after reading the module) enlisted 1 Aug 1939, served on through 1942:
-- "served during the war" is met
#ASSERT `a member of the Forces under s 3` (`a baseline member from` (Date 1 8 1939))

-- 11 occurrence during service
#ASSERT `the Commonwealth is liable under s 5` (`Service record` OF TRUE, Date 1 3 1942, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE)
-- 12 arose out of / attributable
#ASSERT `the Commonwealth is liable under s 5` (`Service record` OF TRUE, Date 1 3 1942, TRUE, TRUE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE)
-- 13 pre-existing cause aggravated
#ASSERT `the Commonwealth is liable under s 5` (`Service record` OF TRUE, Date 1 3 1942, TRUE, TRUE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE)
-- 14 no connection
#ASSERT NOT (`the Commonwealth is liable under s 5` baseline)
-- 15 serious default
#ASSERT NOT (`the Commonwealth is liable under s 5` (`Service record` OF TRUE, Date 1 3 1942, TRUE, TRUE, TRUE, FALSE, FALSE, TRUE, FALSE, FALSE))
-- 16 self-inflicted
#ASSERT NOT (`the Commonwealth is liable under s 5` (`Service record` OF TRUE, Date 1 3 1942, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, TRUE, FALSE))
-- 17 serious breach of discipline
#ASSERT NOT (`the Commonwealth is liable under s 5` (`Service record` OF TRUE, Date 1 3 1942, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, TRUE))
-- 18 not a member
#ASSERT NOT (`the Commonwealth is liable under s 5` (`Service record` OF FALSE, Date 1 3 1942, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE))
-- 21 death from an occurrence: same booleans as 11
#ASSERT `the Commonwealth is liable under s 5` (`Service record` OF TRUE, Date 1 6 1944, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE)

-- 19, 20 via the exported position
#ASSERT (`the forces position for` baseline)'s `a member of the Forces`
#ASSERT (`the forces position for` baseline)'s `benefits are limited to this Act and the War Gratuity Act`
#ASSERT (`the forces position for` baseline)'s `pension is inalienable`
#ASSERT NOT ((`the forces position for` baseline)'s `the Commonwealth is liable for incapacity or death`)
#ASSERT (`the forces position for` (`Service record` OF TRUE, Date 1 3 1942, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE))'s `the Commonwealth is liable for incapacity or death`
