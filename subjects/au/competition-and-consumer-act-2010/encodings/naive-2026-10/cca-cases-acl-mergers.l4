    `of a kind ordinarily acquired for personal, domestic or household use` IS TRUE
    `a vehicle or trailer for transporting goods on public roads` IS FALSE
    `acquired for re-supply` IS FALSE
    `acquired to use up or transform in production or repair` IS FALSE

