#ASSERT `Must I pay the costs of the taxation?` TRUE FALSE 10000 8499 EQUALS JUST FALSE
#ASSERT `Must I pay the costs of the taxation?` TRUE FALSE 10000 12000 EQUALS JUST TRUE
#ASSERT `Must I pay the costs of the taxation?` FALSE TRUE 10000 20000 EQUALS NOTHING
