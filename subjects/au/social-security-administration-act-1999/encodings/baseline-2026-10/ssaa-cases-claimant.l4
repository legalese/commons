IMPORT prelude
IMPORT daydate
IMPORT `ssaa-claimant`

-- Social Security (Administration) Act 1999 -- worked cases, from the claimant's seat.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Expected values were written by hand from
-- the deposited text (C2026C00010), never copied from the encoding's output. No scenario life raised this Act (REQ-0073 is a
-- scheduled priority-2 entry): the claimant (Sam, a jobseeker in Perth) and the dates are the encoder's, HYPOTHETICAL.

-- ---------------------------------------------------------------------------------------------------------------------
-- s 11.
#ASSERT `Must I make a claim` `a social security payment`
#ASSERT (NOT `Must I make a claim` `a concession card that comes automatically with my pension or payment (1991 Act Part 2A.1 Division 1 or Division 3 Subdivision A)`)
#ASSERT (NOT `Must I make a claim` `a seniors health card the Secretary must issue to me under s 1061ZJA(3)-(5) of the 1991 Act`)
#ASSERT `Must I make a claim` `another concession card`

-- ss 29, 30.
#ASSERT `Can I claim from where I am` `another social security payment or a concession card` TRUE TRUE FALSE FALSE
-- Sam is an Australian resident but on holiday in Bali: the claim is taken not to have been made.
#ASSERT (NOT `Can I claim from where I am` `another social security payment or a concession card` TRUE FALSE FALSE FALSE)
#ASSERT (NOT `Can I claim from where I am` `another social security payment or a concession card` FALSE TRUE FALSE FALSE)
-- An exception (for example AVTOP) applies while overseas.
#ASSERT `Can I claim from where I am` `another social security payment or a concession card` FALSE FALSE FALSE TRUE
-- Special benefit: a non-resident in Australia holding a determined visa may claim; out of Australia may not.
#ASSERT `Can I claim from where I am` `special benefit` FALSE TRUE TRUE FALSE
#ASSERT (NOT `Can I claim from where I am` `special benefit` FALSE FALSE TRUE TRUE)
#ASSERT (NOT `Can I claim from where I am` `special benefit` FALSE TRUE FALSE FALSE)

-- ---------------------------------------------------------------------------------------------------------------------
-- s 13. Sam rings Services Australia on 1 March 2027, qualified and in the s 14A class.
#ASSERT `On what day is my claim taken to be made` (Date 1 3 2027) (Date 10 3 2027) TRUE TRUE FALSE `none of these` EQUALS Date 1 3 2027
-- Lodged on 15 March, the 14th day after: still within 14 days.
#ASSERT `On what day is my claim taken to be made` (Date 1 3 2027) (Date 15 3 2027) TRUE TRUE FALSE `none of these` EQUALS Date 1 3 2027
-- Lodged on 16 March with no reason: the actual day.
#ASSERT `On what day is my claim taken to be made` (Date 1 3 2027) (Date 16 3 2027) TRUE TRUE FALSE `none of these` EQUALS Date 16 3 2027
-- Lodged on 20 April, unwell throughout: back to 1 March.
#ASSERT `On what day is my claim taken to be made` (Date 1 3 2027) (Date 20 4 2027) TRUE TRUE FALSE `I had a medical condition that significantly hindered me` EQUALS Date 1 3 2027
-- 31 May 2027 is the last day of the 13 weeks; 1 June is past them.
#ASSERT `On what day is my claim taken to be made` (Date 1 3 2027) (Date 31 5 2027) TRUE TRUE FALSE `I had a medical condition that significantly hindered me` EQUALS Date 1 3 2027
#ASSERT `On what day is my claim taken to be made` (Date 1 3 2027) (Date 1 6 2027) TRUE TRUE FALSE `I had a medical condition that significantly hindered me` EQUALS Date 1 6 2027
-- Crisis payment: the medical-condition rule does not apply, the special-circumstances rule does.
#ASSERT `On what day is my claim taken to be made` (Date 1 3 2027) (Date 20 3 2027) TRUE TRUE TRUE `I had a medical condition that significantly hindered me` EQUALS Date 20 3 2027
#ASSERT `On what day is my claim taken to be made` (Date 1 3 2027) (Date 20 3 2027) TRUE TRUE TRUE `special circumstances made it not reasonably practicable to lodge earlier` EQUALS Date 1 3 2027
-- Not in the s 14A class, or not yet qualified on the day of contact: the actual day.
#ASSERT `On what day is my claim taken to be made` (Date 1 3 2027) (Date 10 3 2027) FALSE TRUE FALSE `none of these` EQUALS Date 10 3 2027
#ASSERT `On what day is my claim taken to be made` (Date 1 3 2027) (Date 10 3 2027) TRUE FALSE FALSE `none of these` EQUALS Date 10 3 2027

-- Schedule 2. Sam's claim day is 1 March 2027 and he is qualified then.
#ASSERT `From what day will my payment start` (Date 1 3 2027) TRUE (Date 1 1 2000) FALSE FALSE FALSE (Date 1 1 2000) FALSE EQUALS `answered` (`my start day is` (Date 1 3 2027))
-- Claimed early; he becomes qualified on 10 April 2027 (cl 4).
#ASSERT `From what day will my payment start` (Date 1 3 2027) FALSE (Date 10 4 2027) FALSE FALSE FALSE (Date 1 1 2000) FALSE EQUALS `answered` (`my start day is` (Date 10 4 2027))
-- Qualified on 31 May 2027, the last day of the 13 weeks; on 1 June, too late.
#ASSERT `From what day will my payment start` (Date 1 3 2027) FALSE (Date 31 5 2027) FALSE FALSE FALSE (Date 1 1 2000) FALSE EQUALS `answered` (`my start day is` (Date 31 5 2027))
#ASSERT `From what day will my payment start` (Date 1 3 2027) FALSE (Date 1 6 2027) FALSE FALSE FALSE (Date 1 1 2000) FALSE EQUALS `answered` `no start day: I was not qualified on the claim day and did not become qualified within 13 weeks after it, so the claim cannot be granted on these facts`
-- Special benefit cannot be claimed early.
#ASSERT `From what day will my payment start` (Date 1 3 2027) FALSE (Date 10 4 2027) TRUE FALSE FALSE (Date 1 1 2000) FALSE EQUALS `answered` `no start day: I was not qualified on the claim day and did not become qualified within 13 weeks after it, so the claim cannot be granted on these facts`
-- A liquid assets waiting period: the first day qualified, even past 13 weeks (cl 4(6)).
#ASSERT `From what day will my payment start` (Date 1 3 2027) FALSE (Date 20 6 2027) FALSE TRUE FALSE (Date 1 1 2000) FALSE EQUALS `answered` (`my start day is` (Date 20 6 2027))
-- An unemployment preclusion period ending 14 March 2027: the start day is 15 March (cl 5).
#ASSERT `From what day will my payment start` (Date 1 3 2027) TRUE (Date 1 1 2000) FALSE FALSE TRUE (Date 14 3 2027) FALSE EQUALS `answered` (`my start day is` (Date 15 3 2027))
-- An exclusion period that ended before the claim day does not move it.
#ASSERT `From what day will my payment start` (Date 1 3 2027) TRUE (Date 1 1 2000) FALSE FALSE TRUE (Date 28 2 2027) FALSE EQUALS `answered` (`my start day is` (Date 1 3 2027))
-- Required to attend an interview: clause 4A.
#ASSERT `From what day will my payment start` (Date 1 3 2027) TRUE (Date 1 1 2000) FALSE FALSE FALSE (Date 1 1 2000) TRUE EQUALS `not covered` `the start day of a jobseeker payment or youth allowance claimant required to attend an interview is worked out under Schedule 2 clause 4A, which is not encoded`

-- s 39: a claim lodged on 1 March 2027 not decided: rejected at the end of 31 May 2027; 10 days waiting for information: 10 June.
#ASSERT `On what day is my undecided claim taken to be rejected` (Date 1 3 2027) 0 EQUALS Date 31 5 2027
#ASSERT `On what day is my undecided claim taken to be rejected` (Date 1 3 2027) 10 EQUALS Date 10 6 2027

-- s 51.
#ASSERT `What is the most I can be advanced` TRUE TRUE 800 EQUALS 800
#ASSERT `What is the most I can be advanced` TRUE FALSE 800 EQUALS 0

-- ---------------------------------------------------------------------------------------------------------------------
-- ss 66A, 72. Sam starts part-time work on 3 March 2027.
#ASSERT `By when must I tell the Department` `a change of circumstances that might affect my payment (s 66A)` (Date 3 3 2027) EQUALS Date 17 3 2027
#ASSERT `By when must I tell the Department` `under a notice: that I have received, or will receive, a compensation payment` (Date 3 3 2027) EQUALS Date 10 3 2027
#ASSERT `By when must I tell the Department` `under a notice: the death of a person the notice names` (Date 3 3 2027) EQUALS Date 31 3 2027
#ASSERT `By when must I tell the Department` `under a notice: another event or change the notice names` (Date 3 3 2027) EQUALS Date 17 3 2027

-- ---------------------------------------------------------------------------------------------------------------------
-- s 42AC.
#ASSERT `Have I committed a mutual obligation failure` TRUE `I missed, or was late for, an appointment` FALSE FALSE
#ASSERT (NOT `Have I committed a mutual obligation failure` FALSE `I missed, or was late for, an appointment` FALSE FALSE)
-- A principal carer who does not take up 20 hours a week of work: no failure (s 42AC(1A)); 10 hours: a failure.
#ASSERT (NOT `Have I committed a mutual obligation failure` TRUE `I did not accept an offer of paid work, or do paid work` TRUE TRUE)
#ASSERT `Have I committed a mutual obligation failure` TRUE `I did not accept an offer of paid work, or do paid work` TRUE FALSE
#ASSERT `Have I committed a mutual obligation failure` TRUE `I did not accept an offer of paid work, or do paid work` FALSE TRUE

-- s 42AD.
#ASSERT `Have I committed a work refusal failure` TRUE TRUE FALSE FALSE FALSE
#ASSERT (NOT `Have I committed a work refusal failure` TRUE TRUE TRUE FALSE FALSE)
#ASSERT (NOT `Have I committed a work refusal failure` TRUE TRUE FALSE TRUE TRUE)
#ASSERT `Have I committed a work refusal failure` TRUE TRUE FALSE TRUE FALSE

-- s 42AE.
#ASSERT `Have I committed an unemployment failure` TRUE `I left the job voluntarily` FALSE FALSE TRUE
#ASSERT (NOT `Have I committed an unemployment failure` TRUE `I left the job voluntarily` TRUE FALSE TRUE)
#ASSERT `Have I committed an unemployment failure` TRUE `I was dismissed for misconduct` FALSE FALSE TRUE
#ASSERT (NOT `Have I committed an unemployment failure` TRUE `for another reason (for example redundancy, or the job ended)` FALSE FALSE TRUE)
-- A principal carer dismissed from a 38-hour job for misconduct: no failure (s 42AE(4)).
#ASSERT (NOT `Have I committed an unemployment failure` TRUE `I was dismissed for misconduct` FALSE TRUE TRUE)

-- ss 42AL, 42AM. Told of a reconnection requirement on 1 March 2027.
#ASSERT `What happens to my suspended payment` (Date 1 3 2027) (Date 10 3 2027) TRUE FALSE EQUALS `suspended until I meet the reconnection requirement; once I do, it is payable again back to the start of the suspension (back pay), less any s 42AN reduction (s 42AL)`
#ASSERT `What happens to my suspended payment` (Date 1 3 2027) (Date 29 3 2027) TRUE FALSE EQUALS `suspended until I meet the reconnection requirement; once I do, it is payable again back to the start of the suspension (back pay), less any s 42AN reduction (s 42AL)`
#ASSERT `What happens to my suspended payment` (Date 1 3 2027) (Date 30 3 2027) TRUE FALSE EQUALS `cancelled at the end of the 4 weeks after I was told of the reconnection requirement, because I did not meet it in time (s 42AM(3), (4)); the 4 weeks ended on` (Date 29 3 2027)
#ASSERT `What happens to my suspended payment` (Date 1 3 2027) (Date 1 1 2000) FALSE FALSE EQUALS `cancelled at the end of the 4 weeks after I was told of the reconnection requirement, because I did not meet it in time (s 42AM(3), (4)); the 4 weeks ended on` (Date 29 3 2027)
#ASSERT `What happens to my suspended payment` (Date 1 3 2027) (Date 1 1 2000) FALSE TRUE EQUALS `the suspension ended on the earlier day the Secretary chose; the payment is payable back to the start of the suspension (s 42AL(3)(b), (4))`

-- ss 42AO, 42AP. Sam quits without reason on 1 March 2027: 4 weeks from 1 March, payable again from 29 March 2027.
#ASSERT `From what day can I be paid again after an unemployment failure` (Date 1 3 2027) FALSE FALSE (Date 1 1 2000) EQUALS Date 29 3 2027
-- He had been paid relocation assistance for that job: 6 weeks, from 12 April 2027.
#ASSERT `From what day can I be paid again after an unemployment failure` (Date 1 3 2027) TRUE FALSE (Date 1 1 2000) EQUALS Date 12 4 2027
-- The Secretary cancels from a later instalment period starting 9 March 2027: 4 weeks from then, 6 April 2027.
#ASSERT `From what day can I be paid again after an unemployment failure` (Date 1 3 2027) FALSE TRUE (Date 9 3 2027) EQUALS Date 6 4 2027

-- ---------------------------------------------------------------------------------------------------------------------
-- s 118. The change happened on 3 March 2027; the decision was made on 20 March 2027.
#ASSERT `From what day does the decision against me take effect` `after I told the Department of a change, and no instalment was paid to me after the change and before the decision` (Date 3 3 2027) (Date 1 1 2000) FALSE (Date 20 3 2027) (Date 1 1 2000) EQUALS Date 3 3 2027
#ASSERT `From what day does the decision against me take effect` `after I gave a statement in response to a notice under s 67 or s 68` (Date 3 3 2027) (Date 1 1 2000) FALSE (Date 20 3 2027) (Date 1 1 2000) EQUALS Date 3 3 2027
#ASSERT `From what day does the decision against me take effect` `my false statement or misrepresentation, or my breach of the Act that delayed the decision` (Date 3 3 2027) (Date 1 1 2027) FALSE (Date 20 3 2027) (Date 1 1 2000) EQUALS Date 1 1 2027
#ASSERT `From what day does the decision against me take effect` `my payment was suspended under s 80, 81 or 82 and is now cancelled` (Date 3 3 2027) (Date 1 1 2000) FALSE (Date 20 3 2027) (Date 8 3 2027) EQUALS Date 8 3 2027
#ASSERT `From what day does the decision against me take effect` `any other way` (Date 3 3 2027) (Date 1 1 2000) FALSE (Date 20 3 2027) (Date 1 1 2000) EQUALS Date 20 3 2027
#ASSERT `From what day does the decision against me take effect` `any other way` (Date 3 3 2027) (Date 1 4 2027) TRUE (Date 20 3 2027) (Date 1 1 2000) EQUALS Date 1 4 2027

-- ---------------------------------------------------------------------------------------------------------------------
-- Review.
#ASSERT `How can I have the decision reviewed` `an officer's decision about my payment, claim or card` EQUALS `ask for internal review by the Secretary (s 129, no time limit), then apply to the ART (s 142, no time limit, s 147)`
#ASSERT `How can I have the decision reviewed` `an officer's decision about my pension bonus or essential medical equipment payment` EQUALS `ask for internal review within 13 weeks after notice of the decision (s 129(3)), then apply to the ART (s 142)`
#ASSERT `How can I have the decision reviewed` `a decision made personally by the Secretary or the Chief Executive Centrelink` EQUALS `apply directly to the ART (s 142(1)(b), no time limit, s 147)`
#ASSERT `How can I have the decision reviewed` `a decision to impose a reconnection requirement on me (s 42AM(1))` EQUALS `ask for internal review (s 129, no time limit); the ART cannot review this decision (s 144)`
#ASSERT `How can I have the decision reviewed` `a decision whether my payment continues while my review is decided (s 131 or s 145)` EQUALS `ask for internal review (s 129, no time limit); the ART cannot review this decision (s 144)`

-- s 109. Notice of a cancellation that took effect on 15 February 2027 was given on 1 March 2027.
#ASSERT `From what day will a successful review take effect` TRUE (Date 1 3 2027) (Date 20 4 2027) (Date 15 2 2027) EQUALS Date 15 2 2027
-- Applied on 31 May 2027, the last day of the 13 weeks: back to 15 February.
#ASSERT `From what day will a successful review take effect` TRUE (Date 1 3 2027) (Date 31 5 2027) (Date 15 2 2027) EQUALS Date 15 2 2027
-- Applied on 1 June 2027: only from the day of the application.
#ASSERT `From what day will a successful review take effect` TRUE (Date 1 3 2027) (Date 1 6 2027) (Date 15 2 2027) EQUALS Date 1 6 2027
-- Never given notice: back to the original day, however late.
#ASSERT `From what day will a successful review take effect` FALSE (Date 1 1 2000) (Date 1 12 2027) (Date 15 2 2027) EQUALS Date 15 2 2027

-- s 131.
#ASSERT `Can my payment continue during review (s 131)` TRUE FALSE TRUE EQUALS `the Secretary may declare that my payment continues until the review is decided, as if the decision had not been made (s 131); this is the Secretary's discretion and the ART cannot review it`
#ASSERT `Can my payment continue during review (s 131)` TRUE TRUE TRUE EQUALS `s 131 does not allow my payment to continue during the review`
#ASSERT `Can my payment continue during review (s 131)` TRUE FALSE FALSE EQUALS `s 131 does not allow my payment to continue during the review`
#ASSERT `Can my payment continue during review (s 131)` FALSE FALSE TRUE EQUALS `s 131 does not allow my payment to continue during the review`
