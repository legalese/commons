-- s 176.
#ASSERT `How much of my expenses must I bear` 500 300 EQUALS 200
#ASSERT `How much of my expenses must I bear` 500 500 EQUALS 0
#ASSERT `How much of my expenses must I bear` 300 500 EQUALS 0
#ASSERT `How much of my expenses must I bear` 500 0 EQUALS 500

-- s 181.
#ASSERT `Is my ART application taken to be dismissed` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Is my ART application taken to be dismissed` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Is my ART application taken to be dismissed` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Is my ART application taken to be dismissed` FALSE TRUE TRUE EQUALS NOTHING

-- s 182.
#ASSERT `Which decision does the ART review` FALSE FALSE EQUALS `the decision as it was when I applied`
#ASSERT `Which decision does the ART review` TRUE FALSE EQUALS `the decision as varied or substituted (s 182(1))`
#ASSERT `Which decision does the ART review` TRUE TRUE EQUALS `the decision as it was when referred: after referral to the guidance and appeals panel it cannot be altered outside the Tribunal's process (s 182(2), ART Act s 31)`

-- s 183.
#ASSERT `May the event be treated as having occurred` TRUE TRUE TRUE
#ASSERT (NOT `May the event be treated as having occurred` TRUE TRUE FALSE)
#ASSERT (NOT `May the event be treated as having occurred` FALSE TRUE TRUE)
