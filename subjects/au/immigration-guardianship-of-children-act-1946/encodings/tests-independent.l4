IMPORT prelude
IMPORT daydate
IMPORT `igc-rules`

-- Independent tests: expected values from independent-expectations.md,
-- written from the source text before reading the encoding.

GIVEN dob IS A DATE
      asked IS A DATE
      nonCit IS A BOOLEAN
      intends IS A BOOLEAN
      comp IS A `Companion`
      visaDeclared IS A BOOLEAN
      ward IS A BOOLEAN
      gone IS A BOOLEAN
      exempt IS A BOOLEAN
      act IS A `My act`
      excuse IS A BOOLEAN
GIVETH A `Child case`
`mk` dob asked nonCit intends comp visaDeclared ward gone exempt act excuse MEANS
  `Child case` OF nonCit, dob, asked, intends, comp, visaDeclared, ward, gone, exempt, act, excuse, NOTHING, NOTHING

GIVEN comp IS A `Companion`
GIVETH A `Child case`
`with` comp MEANS
  `mk` (Date 1 6 2015) (Date 1 1 2025) TRUE TRUE comp FALSE FALSE FALSE FALSE `none of these` FALSE

GIVEN act IS A `My act`
      excuse IS A BOOLEAN
GIVETH A `Child case`
`doing` act excuse MEANS
  `mk` (Date 1 6 2015) (Date 1 1 2025) TRUE TRUE `no one` FALSE FALSE FALSE FALSE act excuse

DECIDE base IS `with` `no one`

-- 1
#ASSERT (`the child position for` base)'s `the child is a non-citizen child under s 4AAA` EQUALS TRUE
#ASSERT (`the child position for` base)'s `the Minister is the child's guardian` EQUALS TRUE
#ASSERT (`the child position for` base)'s `the child may leave only with the Minister's written consent` EQUALS TRUE
-- 2
#ASSERT (`the child position for` (`with` `a parent`))'s `the child is a non-citizen child under s 4AAA` EQUALS FALSE
#ASSERT (`the child position for` (`with` `a parent`))'s `the Minister is the child's guardian` EQUALS FALSE
-- 3
#ASSERT (`the child position for` (`with` `a relative aged 21 or over, other than a parent`))'s `the child is a non-citizen child under s 4AAA` EQUALS FALSE
-- 4
#ASSERT (`the child position for` (`mk` (Date 1 6 2015) (Date 1 1 2025) TRUE TRUE `a relative aged 21 or over, other than a parent` FALSE TRUE FALSE FALSE `none of these` FALSE))'s `the child is a non-citizen child under s 4AAA` EQUALS TRUE
#ASSERT (`the child position for` (`mk` (Date 1 6 2015) (Date 1 1 2025) TRUE TRUE `a relative aged 21 or over, other than a parent` FALSE TRUE FALSE FALSE `none of these` FALSE))'s `the Minister is the child's guardian` EQUALS TRUE
-- 5
#ASSERT (`the child position for` (`with` `an intending adoptive parent`))'s `the child is a non-citizen child under s 4AAA` EQUALS FALSE
-- 6
#ASSERT (`the child position for` (`mk` (Date 1 6 2015) (Date 1 1 2025) TRUE TRUE `another adult aged 21 or over` TRUE FALSE FALSE FALSE `none of these` FALSE))'s `the child is a non-citizen child under s 4AAA` EQUALS FALSE
-- 7, 8 (the encoding folds visa and declared-State residence into one input)
#ASSERT (`the child position for` (`with` `another adult aged 21 or over`))'s `the child is a non-citizen child under s 4AAA` EQUALS TRUE
-- 9
#ASSERT (`the child position for` (`mk` (Date 1 6 2015) (Date 1 1 2025) TRUE FALSE `no one` FALSE FALSE FALSE FALSE `none of these` FALSE))'s `the child is a non-citizen child under s 4AAA` EQUALS FALSE
-- 10
#ASSERT (`the child position for` (`mk` (Date 1 6 2015) (Date 1 1 2025) FALSE TRUE `no one` FALSE FALSE FALSE FALSE `none of these` FALSE))'s `the child is a non-citizen child under s 4AAA` EQUALS FALSE
-- 11
#ASSERT (`the child position for` (`mk` (Date 15 1 2007) (Date 14 1 2025) TRUE TRUE `no one` FALSE FALSE FALSE FALSE `none of these` FALSE))'s `the child is a non-citizen child under s 4AAA` EQUALS TRUE
#ASSERT (`the child position for` (`mk` (Date 15 1 2007) (Date 14 1 2025) TRUE TRUE `no one` FALSE FALSE FALSE FALSE `none of these` FALSE))'s `the Minister is the child's guardian` EQUALS TRUE
-- 12
#ASSERT (`the child position for` (`mk` (Date 15 1 2007) (Date 15 1 2025) TRUE TRUE `no one` FALSE FALSE FALSE FALSE `none of these` FALSE))'s `the child is a non-citizen child under s 4AAA` EQUALS FALSE
#ASSERT (`the child position for` (`mk` (Date 15 1 2007) (Date 15 1 2025) TRUE TRUE `no one` FALSE FALSE FALSE FALSE `none of these` FALSE))'s `the Minister is the child's guardian` EQUALS FALSE
-- 13: guardianship runs "until the child reaches the age of 18": 1 June 2033
#ASSERT (`the child position for` base)'s `the guardianship ends at the latest on` EQUALS Date 1 6 2033
-- 14
#ASSERT (`the child position for` (`mk` (Date 1 6 2015) (Date 1 1 2025) TRUE TRUE `no one` FALSE FALSE TRUE FALSE `none of these` FALSE))'s `the Minister is the child's guardian` EQUALS FALSE
-- 15
#ASSERT (`the child position for` (`mk` (Date 1 6 2015) (Date 1 1 2025) TRUE TRUE `no one` FALSE FALSE FALSE TRUE `none of these` FALSE))'s `the Minister is the child's guardian` EQUALS FALSE
#ASSERT (`the child position for` (`mk` (Date 1 6 2015) (Date 1 1 2025) TRUE TRUE `no one` FALSE FALSE FALSE TRUE `help the child leave Australia without the Minister's consent` FALSE))'s `I commit an offence under ss 6A or 9` EQUALS FALSE
#ASSERT (`the child position for` (`mk` (Date 1 6 2015) (Date 1 1 2025) TRUE TRUE `no one` FALSE FALSE FALSE TRUE `knowingly harbour or conceal the child from the custodian` FALSE))'s `I commit an offence under ss 6A or 9` EQUALS FALSE
-- 16
#ASSERT (`the child position for` (`doing` `help the child leave Australia without the Minister's consent` FALSE))'s `I commit an offence under ss 6A or 9` EQUALS TRUE
-- 17
#ASSERT (`the child position for` (`doing` `help the child leave Australia without the Minister's consent` TRUE))'s `I commit an offence under ss 6A or 9` EQUALS TRUE
-- 18
#ASSERT (`the child position for` (`doing` `remove or entice the child from the custodian` FALSE))'s `I commit an offence under ss 6A or 9` EQUALS TRUE
-- 19
#ASSERT (`the child position for` (`doing` `knowingly harbour or conceal the child from the custodian` TRUE))'s `I commit an offence under ss 6A or 9` EQUALS FALSE
-- 20
#ASSERT (`the child position for` (`mk` (Date 1 6 2015) (Date 1 1 2025) TRUE TRUE `a parent` FALSE FALSE FALSE FALSE `knowingly harbour or conceal the child from the custodian` FALSE))'s `I commit an offence under ss 6A or 9` EQUALS FALSE
-- 21
#ASSERT (`the child position for` base)'s `I commit an offence under ss 6A or 9` EQUALS FALSE
-- 22, 23
#ASSERT (`the child position for` (`Child case` OF TRUE, Date 1 6 2015, Date 1 1 2025, TRUE, `no one`, FALSE, FALSE, FALSE, FALSE, `none of these`, FALSE, JUST (Date 1 3 2025), JUST (Date 1 3 2025)))'s `the last day to ask for reconsideration` EQUALS JUST (Date 29 3 2025)
#ASSERT (`the child position for` (`Child case` OF TRUE, Date 1 6 2015, Date 1 1 2025, TRUE, `no one`, FALSE, FALSE, FALSE, FALSE, `none of these`, FALSE, JUST (Date 1 3 2025), JUST (Date 1 3 2025)))'s `the last day for the Minister to reconsider` EQUALS JUST (Date 15 4 2025)
