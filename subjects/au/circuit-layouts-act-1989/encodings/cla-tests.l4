IMPORT prelude
IMPORT daydate
IMPORT `cla-rules`

-- Circuit Layouts Act 1989 (Cth) — the encoder's tests.

§ `Tests`

`copying` MEANS `copying the layout in a material form`
`exploiting` MEANS `commercially exploiting the layout, a copy or a circuit in Australia`
`part II` MEANS Date 1 10 1990

-- A layout made on 10 May 2015, first exploited in 2016.
GIVEN a IS A `My act`, d IS A DATE, p IS A `My purpose`
GIVETH A `Layout case`
`doing` a `on` d `for` p MEANS
    `Layout case` OF Date 10 5 2015, JUST 2016, TRUE, FALSE, TRUE, FALSE,
                     a, d, FALSE, TRUE, p, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, `part II`

`trade` MEANS `trade or another purpose`

-- s 5: 2016 + 10 = end of 2026.
#ASSERT `the end of the protection period for` (`doing` `copying` `on` (Date 1 1 2020) `for` `trade`) EQUALS Date 31 12 2026
#ASSERT `my act infringes` (`doing` `copying` `on` (Date 31 12 2026) `for` `trade`)
#ASSERT NOT (`my act infringes` (`doing` `copying` `on` (Date 1 1 2027) `for` `trade`))
-- before the layout was made
#ASSERT NOT (`my act infringes` (`doing` `copying` `on` (Date 9 5 2015) `for` `trade`))
-- never exploited: end of 2025; exploited in 2025 (within 10 years): end of 2035; in 2026: end of 2025.
#ASSERT `the end of the protection period for` (`Layout case` OF Date 10 5 2015, NOTHING, TRUE, FALSE, TRUE, FALSE, `copying`, Date 1 1 2020, FALSE, TRUE, `trade`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, `part II`) EQUALS Date 31 12 2025
#ASSERT `the end of the protection period for` (`Layout case` OF Date 10 5 2015, JUST 2025, TRUE, FALSE, TRUE, FALSE, `copying`, Date 1 1 2020, FALSE, TRUE, `trade`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, `part II`) EQUALS Date 31 12 2035
#ASSERT `the end of the protection period for` (`Layout case` OF Date 10 5 2015, JUST 2026, TRUE, FALSE, TRUE, FALSE, `copying`, Date 1 1 2020, FALSE, TRUE, `trade`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, `part II`) EQUALS Date 31 12 2025
-- s 11: commonplace
#ASSERT NOT (`the layout is eligible` (`Layout case` OF Date 10 5 2015, JUST 2016, TRUE, TRUE, TRUE, FALSE, `copying`, Date 1 1 2020, FALSE, TRUE, `trade`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, `part II`))
-- s 5: foreign maker, first exploited in Australia
#ASSERT `the layout is eligible` (`Layout case` OF Date 10 5 2015, JUST 2016, TRUE, FALSE, FALSE, TRUE, `copying`, Date 1 1 2020, FALSE, TRUE, `trade`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, `part II`)
#ASSERT NOT (`the layout is eligible` (`Layout case` OF Date 10 5 2015, JUST 2016, TRUE, FALSE, FALSE, FALSE, `copying`, Date 1 1 2020, FALSE, TRUE, `trade`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, `part II`))
-- licence
#ASSERT NOT (`my act infringes` (`Layout case` OF Date 10 5 2015, JUST 2016, TRUE, FALSE, TRUE, FALSE, `copying`, Date 1 1 2020, TRUE, TRUE, `trade`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, `part II`))
-- s 19(3): exploiting without knowing
#ASSERT `my act infringes` (`doing` `exploiting` `on` (Date 1 1 2020) `for` `trade`)
#ASSERT NOT (`my act infringes` (`Layout case` OF Date 10 5 2015, JUST 2016, TRUE, FALSE, TRUE, FALSE, `exploiting`, Date 1 1 2020, FALSE, FALSE, `trade`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, `part II`))
-- ss 21-23
#ASSERT NOT (`my act infringes` (`doing` `copying` `on` (Date 1 1 2020) `for` `my private use`))
#ASSERT `my act infringes` (`Layout case` OF Date 10 5 2015, JUST 2016, TRUE, FALSE, TRUE, FALSE, `copying`, Date 1 1 2020, FALSE, TRUE, `my private use`, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, `part II`)
#ASSERT NOT (`my act infringes` (`doing` `making an integrated circuit in accordance with the layout` `on` (Date 1 1 2020) `for` `research or teaching`))
#ASSERT NOT (`my act infringes` (`doing` `copying` `on` (Date 1 1 2020) `for` `evaluating or analysing the layout`))
-- s 20: innocent acquisition; once aware, only if paying
#ASSERT NOT (`my act infringes` (`Layout case` OF Date 10 5 2015, JUST 2016, TRUE, FALSE, TRUE, FALSE, `exploiting`, Date 1 1 2020, FALSE, TRUE, `trade`, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, `part II`))
#ASSERT `my act infringes` (`Layout case` OF Date 10 5 2015, JUST 2016, TRUE, FALSE, TRUE, FALSE, `exploiting`, Date 1 1 2020, FALSE, TRUE, `trade`, FALSE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, `part II`)
#ASSERT NOT (`my act infringes` (`Layout case` OF Date 10 5 2015, JUST 2016, TRUE, FALSE, TRUE, FALSE, `exploiting`, Date 1 1 2020, FALSE, TRUE, `trade`, FALSE, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, `part II`))
-- s 24, s 25
#ASSERT NOT (`my act infringes` (`Layout case` OF Date 10 5 2015, JUST 2016, TRUE, FALSE, TRUE, FALSE, `exploiting`, Date 1 1 2020, FALSE, TRUE, `trade`, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, `part II`))
#ASSERT NOT (`my act infringes` (`Layout case` OF Date 10 5 2015, JUST 2016, TRUE, FALSE, TRUE, FALSE, `copying`, Date 1 1 2020, FALSE, TRUE, `trade`, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, `part II`))
-- s 27(3)
#ASSERT `damages may be awarded` (`doing` `copying` `on` (Date 1 1 2020) `for` `trade`)
#ASSERT NOT (`damages may be awarded` (`Layout case` OF Date 10 5 2015, JUST 2016, TRUE, FALSE, TRUE, FALSE, `copying`, Date 1 1 2020, FALSE, TRUE, `trade`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, `part II`))
-- s 7: an act before Part II commenced
#ASSERT NOT (`an action lies` (`Layout case` OF Date 10 5 1989, JUST 1990, TRUE, FALSE, TRUE, FALSE, `copying`, Date 30 9 1990, FALSE, TRUE, `trade`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, `part II`))
#ASSERT `an action lies` (`Layout case` OF Date 10 5 1989, JUST 1990, TRUE, FALSE, TRUE, FALSE, `copying`, Date 1 10 1990, FALSE, TRUE, `trade`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, `part II`)
-- s 28
#ASSERT `the last day to sue for` (`doing` `copying` `on` (Date 15 3 2020) `for` `trade`) EQUALS JUST (Date 15 3 2026)
#ASSERT `the last day to sue for` (`doing` `copying` `on` (Date 29 2 2020) `for` `trade`) EQUALS JUST (Date 28 2 2026)
#ASSERT `the last day to sue for` (`doing` `copying` `on` (Date 15 3 2020) `for` `my private use`) EQUALS NOTHING
