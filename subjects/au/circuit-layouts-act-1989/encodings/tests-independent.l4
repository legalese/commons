IMPORT prelude
IMPORT daydate
IMPORT `cla-rules`

-- Independent tests: Circuit Layouts Act 1989. Expected values from independent-expectations.md,
-- written from the source text before reading the L4.
-- Baseline: layout made 15 Jun 2000, first exploited 2005, eligible maker; copy on 1 Mar 2015, no licence; Part II commenced 1 Oct 1990.

-- 1. never exploited: ends 31 Dec 2010 (s 5(b))
#ASSERT (`the layout position for` (`Layout case` OF (Date 15 6 2000), NOTHING, TRUE, FALSE, TRUE, FALSE, (`copying the layout in a material form`), (Date 1 3 2009), FALSE, TRUE, (`trade or another purpose`), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, (Date 1 10 1990)))'s `the protection period ends on` EQUALS (Date 31 12 2010)

-- 2. first exploited 2005: ends 31 Dec 2015 (s 5(a))
#ASSERT (`the layout position for` (`Layout case` OF (Date 15 6 2000), (JUST 2005), TRUE, FALSE, TRUE, FALSE, (`copying the layout in a material form`), (Date 1 3 2015), FALSE, TRUE, (`trade or another purpose`), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, (Date 1 10 1990)))'s `the protection period ends on` EQUALS (Date 31 12 2015)

-- 3. first exploited 2010: ends 31 Dec 2020 (s 5(a))
#ASSERT (`the layout position for` (`Layout case` OF (Date 15 6 2000), (JUST 2010), TRUE, FALSE, TRUE, FALSE, (`copying the layout in a material form`), (Date 1 3 2015), FALSE, TRUE, (`trade or another purpose`), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, (Date 1 10 1990)))'s `the protection period ends on` EQUALS (Date 31 12 2020)

-- 4. first exploited 2011: ends 31 Dec 2010 (s 5(b))
#ASSERT (`the layout position for` (`Layout case` OF (Date 15 6 2000), (JUST 2011), TRUE, FALSE, TRUE, FALSE, (`copying the layout in a material form`), (Date 1 3 2015), FALSE, TRUE, (`trade or another purpose`), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, (Date 1 10 1990)))'s `the protection period ends on` EQUALS (Date 31 12 2010)

-- 5. first exploited 2000: ends 31 Dec 2010
#ASSERT (`the layout position for` (`Layout case` OF (Date 15 6 2000), (JUST 2000), TRUE, FALSE, TRUE, FALSE, (`copying the layout in a material form`), (Date 1 3 2015), FALSE, TRUE, (`trade or another purpose`), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, (Date 1 10 1990)))'s `the protection period ends on` EQUALS (Date 31 12 2010)

-- 6a. copy on 14 June 2000, before made: outside period, no infringement
#ASSERT (`the layout position for` (`Layout case` OF (Date 15 6 2000), (JUST 2005), TRUE, FALSE, TRUE, FALSE, (`copying the layout in a material form`), (Date 14 6 2000), FALSE, TRUE, (`trade or another purpose`), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, (Date 1 10 1990)))'s `my act infringes` EQUALS FALSE

-- 6b. copy on 15 June 2000, day made: infringes
#ASSERT (`the layout position for` (`Layout case` OF (Date 15 6 2000), (JUST 2005), TRUE, FALSE, TRUE, FALSE, (`copying the layout in a material form`), (Date 15 6 2000), FALSE, TRUE, (`trade or another purpose`), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, (Date 1 10 1990)))'s `my act infringes` EQUALS TRUE

-- 7. baseline eligible
#ASSERT (`the layout position for` (`Layout case` OF (Date 15 6 2000), (JUST 2005), TRUE, FALSE, TRUE, FALSE, (`copying the layout in a material form`), (Date 1 3 2015), FALSE, TRUE, (`trade or another purpose`), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, (Date 1 10 1990)))'s `the layout is protected` EQUALS TRUE

-- 8. no creative contribution: not eligible (s 11(a))
#ASSERT (`the layout position for` (`Layout case` OF (Date 15 6 2000), (JUST 2005), FALSE, FALSE, TRUE, FALSE, (`copying the layout in a material form`), (Date 1 3 2015), FALSE, TRUE, (`trade or another purpose`), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, (Date 1 10 1990)))'s `the layout is protected` EQUALS FALSE

-- 8b. no creative contribution: no infringement
#ASSERT (`the layout position for` (`Layout case` OF (Date 15 6 2000), (JUST 2005), FALSE, FALSE, TRUE, FALSE, (`copying the layout in a material form`), (Date 1 3 2015), FALSE, TRUE, (`trade or another purpose`), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, (Date 1 10 1990)))'s `my act infringes` EQUALS FALSE

-- 9. commonplace: not eligible (s 11(b))
#ASSERT (`the layout position for` (`Layout case` OF (Date 15 6 2000), (JUST 2005), TRUE, TRUE, TRUE, FALSE, (`copying the layout in a material form`), (Date 1 3 2015), FALSE, TRUE, (`trade or another purpose`), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, (Date 1 10 1990)))'s `the layout is protected` EQUALS FALSE

-- 10. maker ineligible, first exploited in eligible country: eligible (s 5(b))
#ASSERT (`the layout position for` (`Layout case` OF (Date 15 6 2000), (JUST 2005), TRUE, FALSE, FALSE, TRUE, (`copying the layout in a material form`), (Date 1 3 2015), FALSE, TRUE, (`trade or another purpose`), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, (Date 1 10 1990)))'s `the layout is protected` EQUALS TRUE

-- 11. maker ineligible, not first exploited in Aus/eligible country: not eligible
#ASSERT (`the layout position for` (`Layout case` OF (Date 15 6 2000), (JUST 2005), TRUE, FALSE, FALSE, FALSE, (`copying the layout in a material form`), (Date 1 3 2015), FALSE, TRUE, (`trade or another purpose`), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, (Date 1 10 1990)))'s `the layout is protected` EQUALS FALSE

-- 12. copy without licence: infringes (s 19(1))
#ASSERT (`the layout position for` (`Layout case` OF (Date 15 6 2000), (JUST 2005), TRUE, FALSE, TRUE, FALSE, (`copying the layout in a material form`), (Date 1 3 2015), FALSE, TRUE, (`trade or another purpose`), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, (Date 1 10 1990)))'s `my act infringes` EQUALS TRUE

-- 13. copy with licence: no infringement
#ASSERT (`the layout position for` (`Layout case` OF (Date 15 6 2000), (JUST 2005), TRUE, FALSE, TRUE, FALSE, (`copying the layout in a material form`), (Date 1 3 2015), TRUE, TRUE, (`trade or another purpose`), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, (Date 1 10 1990)))'s `my act infringes` EQUALS FALSE

-- 14. copy on 1 Jan 2016, after period: no infringement
#ASSERT (`the layout position for` (`Layout case` OF (Date 15 6 2000), (JUST 2005), TRUE, FALSE, TRUE, FALSE, (`copying the layout in a material form`), (Date 1 1 2016), FALSE, TRUE, (`trade or another purpose`), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, (Date 1 10 1990)))'s `my act infringes` EQUALS FALSE

-- 14b. copy on 31 Dec 2015, last day of period: infringes
#ASSERT (`the layout position for` (`Layout case` OF (Date 15 6 2000), (JUST 2005), TRUE, FALSE, TRUE, FALSE, (`copying the layout in a material form`), (Date 31 12 2015), FALSE, TRUE, (`trade or another purpose`), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, (Date 1 10 1990)))'s `my act infringes` EQUALS TRUE

-- 15. make IC without licence: infringes (s 19(2))
#ASSERT (`the layout position for` (`Layout case` OF (Date 15 6 2000), (JUST 2005), TRUE, FALSE, TRUE, FALSE, (`making an integrated circuit in accordance with the layout`), (Date 1 3 2015), FALSE, TRUE, (`trade or another purpose`), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, (Date 1 10 1990)))'s `my act infringes` EQUALS TRUE

-- 15b. make IC without licence, does not know unlicensed: still infringes (no knowledge limb in s 19(2))
#ASSERT (`the layout position for` (`Layout case` OF (Date 15 6 2000), (JUST 2005), TRUE, FALSE, TRUE, FALSE, (`making an integrated circuit in accordance with the layout`), (Date 1 3 2015), FALSE, FALSE, (`trade or another purpose`), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, (Date 1 10 1990)))'s `my act infringes` EQUALS TRUE

-- 16. exploit, knows unlicensed: infringes (s 19(3))
#ASSERT (`the layout position for` (`Layout case` OF (Date 15 6 2000), (JUST 2005), TRUE, FALSE, TRUE, FALSE, (`commercially exploiting the layout, a copy or a circuit in Australia`), (Date 1 3 2015), FALSE, TRUE, (`trade or another purpose`), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, (Date 1 10 1990)))'s `my act infringes` EQUALS TRUE

-- 17. exploit, does not know nor ought: no infringement (s 19(3))
#ASSERT (`the layout position for` (`Layout case` OF (Date 15 6 2000), (JUST 2005), TRUE, FALSE, TRUE, FALSE, (`commercially exploiting the layout, a copy or a circuit in Australia`), (Date 1 3 2015), FALSE, FALSE, (`trade or another purpose`), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, (Date 1 10 1990)))'s `my act infringes` EQUALS FALSE

-- 18. private-use copy: no infringement (s 21(1))
#ASSERT (`the layout position for` (`Layout case` OF (Date 15 6 2000), (JUST 2005), TRUE, FALSE, TRUE, FALSE, (`copying the layout in a material form`), (Date 1 3 2015), FALSE, TRUE, (`my private use`), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, (Date 1 10 1990)))'s `my act infringes` EQUALS FALSE

-- 19. private-use copy distributed to owner prejudice: infringes (s 21(2))
#ASSERT (`the layout position for` (`Layout case` OF (Date 15 6 2000), (JUST 2005), TRUE, FALSE, TRUE, FALSE, (`copying the layout in a material form`), (Date 1 3 2015), FALSE, TRUE, (`my private use`), TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, (Date 1 10 1990)))'s `my act infringes` EQUALS TRUE

-- 20. research or teaching: no infringement (s 22)
#ASSERT (`the layout position for` (`Layout case` OF (Date 15 6 2000), (JUST 2005), TRUE, FALSE, TRUE, FALSE, (`copying the layout in a material form`), (Date 1 3 2015), FALSE, TRUE, (`research or teaching`), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, (Date 1 10 1990)))'s `my act infringes` EQUALS FALSE

-- 20b. IC made for research: no infringement (s 22)
#ASSERT (`the layout position for` (`Layout case` OF (Date 15 6 2000), (JUST 2005), TRUE, FALSE, TRUE, FALSE, (`making an integrated circuit in accordance with the layout`), (Date 1 3 2015), FALSE, TRUE, (`research or teaching`), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, (Date 1 10 1990)))'s `my act infringes` EQUALS FALSE

-- 21. evaluation copy: no infringement (s 23(1)(a))
#ASSERT (`the layout position for` (`Layout case` OF (Date 15 6 2000), (JUST 2005), TRUE, FALSE, TRUE, FALSE, (`copying the layout in a material form`), (Date 1 3 2015), FALSE, TRUE, (`evaluating or analysing the layout`), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, (Date 1 10 1990)))'s `my act infringes` EQUALS FALSE

-- 22. innocent acquirer, not since aware: no infringement (s 20(1))
#ASSERT (`the layout position for` (`Layout case` OF (Date 15 6 2000), (JUST 2005), TRUE, FALSE, TRUE, FALSE, (`commercially exploiting the layout, a copy or a circuit in Australia`), (Date 1 3 2015), FALSE, TRUE, (`trade or another purpose`), FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, (Date 1 10 1990)))'s `my act infringes` EQUALS FALSE

-- 23. innocent acquirer, since aware, no remuneration: infringes (s 20(2))
#ASSERT (`the layout position for` (`Layout case` OF (Date 15 6 2000), (JUST 2005), TRUE, FALSE, TRUE, FALSE, (`commercially exploiting the layout, a copy or a circuit in Australia`), (Date 1 3 2015), FALSE, TRUE, (`trade or another purpose`), FALSE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, (Date 1 10 1990)))'s `my act infringes` EQUALS TRUE

-- 24. innocent acquirer, since aware, pays remuneration: no infringement (s 20(2))
#ASSERT (`the layout position for` (`Layout case` OF (Date 15 6 2000), (JUST 2005), TRUE, FALSE, TRUE, FALSE, (`commercially exploiting the layout, a copy or a circuit in Australia`), (Date 1 3 2015), FALSE, TRUE, (`trade or another purpose`), FALSE, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, (Date 1 10 1990)))'s `my act infringes` EQUALS FALSE

-- 25. acquired from owner licensed exploitation: no infringement (s 24)
#ASSERT (`the layout position for` (`Layout case` OF (Date 15 6 2000), (JUST 2005), TRUE, FALSE, TRUE, FALSE, (`commercially exploiting the layout, a copy or a circuit in Australia`), (Date 1 3 2015), FALSE, TRUE, (`trade or another purpose`), FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, (Date 1 10 1990)))'s `my act infringes` EQUALS FALSE

-- 26. Commonwealth defence: no infringement (s 25)
#ASSERT (`the layout position for` (`Layout case` OF (Date 15 6 2000), (JUST 2005), TRUE, FALSE, TRUE, FALSE, (`copying the layout in a material form`), (Date 1 3 2015), FALSE, TRUE, (`trade or another purpose`), FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, (Date 1 10 1990)))'s `my act infringes` EQUALS FALSE

-- 27. copy on 1 Jan 1990, layout made 1989, before Part II commenced: no action (s 7)
#ASSERT (`the layout position for` (`Layout case` OF (Date 1 6 1989), NOTHING, TRUE, FALSE, TRUE, FALSE, (`copying the layout in a material form`), (Date 1 1 1990), FALSE, TRUE, (`trade or another purpose`), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, (Date 1 10 1990)))'s `an action lies against me` EQUALS FALSE

-- 27b. same act, still an infringement in the abstract? action does not lie; last day NOTHING
#ASSERT (`the layout position for` (`Layout case` OF (Date 1 6 1989), NOTHING, TRUE, FALSE, TRUE, FALSE, (`copying the layout in a material form`), (Date 1 1 1990), FALSE, TRUE, (`trade or another purpose`), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, (Date 1 10 1990)))'s `the last day I can be sued` EQUALS NOTHING

-- 28. infringing copy after commencement: action lies
#ASSERT (`the layout position for` (`Layout case` OF (Date 15 6 2000), (JUST 2005), TRUE, FALSE, TRUE, FALSE, (`copying the layout in a material form`), (Date 1 3 2015), FALSE, TRUE, (`trade or another purpose`), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, (Date 1 10 1990)))'s `an action lies against me` EQUALS TRUE

-- 29. innocent infringer: no damages (s 27(3))
#ASSERT (`the layout position for` (`Layout case` OF (Date 15 6 2000), (JUST 2005), TRUE, FALSE, TRUE, FALSE, (`copying the layout in a material form`), (Date 1 3 2015), FALSE, TRUE, (`trade or another purpose`), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, (Date 1 10 1990)))'s `damages may be awarded against me` EQUALS FALSE

-- 29b. innocent infringer: action still lies for account of profits
#ASSERT (`the layout position for` (`Layout case` OF (Date 15 6 2000), (JUST 2005), TRUE, FALSE, TRUE, FALSE, (`copying the layout in a material form`), (Date 1 3 2015), FALSE, TRUE, (`trade or another purpose`), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, (Date 1 10 1990)))'s `an action lies against me` EQUALS TRUE

-- 30. aware infringer: damages may be awarded
#ASSERT (`the layout position for` (`Layout case` OF (Date 15 6 2000), (JUST 2005), TRUE, FALSE, TRUE, FALSE, (`copying the layout in a material form`), (Date 1 3 2015), FALSE, TRUE, (`trade or another purpose`), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, (Date 1 10 1990)))'s `damages may be awarded against me` EQUALS TRUE

-- 31. infringement 1 Mar 2015: last day 1 Mar 2021 (s 28)
#ASSERT (`the layout position for` (`Layout case` OF (Date 15 6 2000), (JUST 2005), TRUE, FALSE, TRUE, FALSE, (`copying the layout in a material form`), (Date 1 3 2015), FALSE, TRUE, (`trade or another purpose`), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, (Date 1 10 1990)))'s `the last day I can be sued` EQUALS (JUST (Date 1 3 2021))

-- 31b. no infringement: no last day
#ASSERT (`the layout position for` (`Layout case` OF (Date 15 6 2000), (JUST 2005), TRUE, FALSE, TRUE, FALSE, (`copying the layout in a material form`), (Date 1 3 2015), TRUE, TRUE, (`trade or another purpose`), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, (Date 1 10 1990)))'s `the last day I can be sued` EQUALS NOTHING

