IMPORT prelude
IMPORT `scp-rules`

-- Independent tests from the source text (see independent-expectations.md).
-- Field order: high seas/EEZ, Telecom protection zone, Aus-registered, thing damaged, fault,
-- saving lives, precautions, proceedings, laying own, broke another, sacrificed gear, reasonable precautions.
-- 1: s 7(1), on indictment: offence, 12 months / 20 units
#ASSERT `I commit an offence` (`Cable case` OF TRUE, FALSE, TRUE, `a pipeline`, `my conduct resulted in the break or injury`, FALSE, FALSE, `on indictment`, FALSE, FALSE, FALSE, FALSE)
#ASSERT `the maximum months for` (`Cable case` OF TRUE, FALSE, TRUE, `a pipeline`, `my conduct resulted in the break or injury`, FALSE, FALSE, `on indictment`, FALSE, FALSE, FALSE, FALSE) EQUALS 12
#ASSERT `the maximum units for` (`Cable case` OF TRUE, FALSE, TRUE, `a pipeline`, `my conduct resulted in the break or injury`, FALSE, FALSE, `on indictment`, FALSE, FALSE, FALSE, FALSE) EQUALS 20
-- 2: s 7(1) summarily: 3 months / 10 units (s 10(2))
#ASSERT `I commit an offence` (`Cable case` OF TRUE, FALSE, TRUE, `a pipeline`, `my conduct resulted in the break or injury`, FALSE, FALSE, `summarily`, FALSE, FALSE, FALSE, FALSE)
#ASSERT `the maximum months for` (`Cable case` OF TRUE, FALSE, TRUE, `a pipeline`, `my conduct resulted in the break or injury`, FALSE, FALSE, `summarily`, FALSE, FALSE, FALSE, FALSE) EQUALS 3
#ASSERT `the maximum units for` (`Cable case` OF TRUE, FALSE, TRUE, `a pipeline`, `my conduct resulted in the break or injury`, FALSE, FALSE, `summarily`, FALSE, FALSE, FALSE, FALSE) EQUALS 10
-- 3: s 7(1A) negligent: 3 months / 10 units
#ASSERT `I commit an offence` (`Cable case` OF TRUE, FALSE, TRUE, `a pipeline`, `I was negligent as to whether my conduct would result in it`, FALSE, FALSE, `on indictment`, FALSE, FALSE, FALSE, FALSE)
#ASSERT `the maximum months for` (`Cable case` OF TRUE, FALSE, TRUE, `a pipeline`, `I was negligent as to whether my conduct would result in it`, FALSE, FALSE, `on indictment`, FALSE, FALSE, FALSE, FALSE) EQUALS 3
#ASSERT `the maximum units for` (`Cable case` OF TRUE, FALSE, TRUE, `a pipeline`, `I was negligent as to whether my conduct would result in it`, FALSE, FALSE, `on indictment`, FALSE, FALSE, FALSE, FALSE) EQUALS 10
-- 4: s 7(1A) summarily: 3 / 10
#ASSERT `the maximum months for` (`Cable case` OF TRUE, FALSE, TRUE, `a pipeline`, `I was negligent as to whether my conduct would result in it`, FALSE, FALSE, `summarily`, FALSE, FALSE, FALSE, FALSE) EQUALS 3
#ASSERT `the maximum units for` (`Cable case` OF TRUE, FALSE, TRUE, `a pipeline`, `I was negligent as to whether my conduct would result in it`, FALSE, FALSE, `summarily`, FALSE, FALSE, FALSE, FALSE) EQUALS 10
-- 5: no fault: no offence
#ASSERT NOT (`I commit an offence` (`Cable case` OF TRUE, FALSE, TRUE, `a pipeline`, `neither`, FALSE, FALSE, `on indictment`, FALSE, FALSE, FALSE, FALSE))
-- 6: foreign ship: no offence (s 7(1))
#ASSERT NOT (`I commit an offence` (`Cable case` OF TRUE, FALSE, FALSE, `a pipeline`, `my conduct resulted in the break or injury`, FALSE, FALSE, `on indictment`, FALSE, FALSE, FALSE, FALSE))
-- 7: not high seas or EEZ: Act does not apply (s 5(1)(a))
#ASSERT NOT (`I commit an offence` (`Cable case` OF FALSE, FALSE, TRUE, `a pipeline`, `my conduct resulted in the break or injury`, FALSE, FALSE, `on indictment`, FALSE, FALSE, FALSE, FALSE))
-- 8: Telecom Act cable in protection zone (s 5(1)(b))
#ASSERT NOT (`I commit an offence` (`Cable case` OF TRUE, TRUE, TRUE, `a pipeline`, `my conduct resulted in the break or injury`, FALSE, FALSE, `on indictment`, FALSE, FALSE, FALSE, FALSE))
-- 9: high-voltage cable (s 7(1)(c))
#ASSERT `I commit an offence` (`Cable case` OF TRUE, FALSE, TRUE, `a high-voltage cable`, `my conduct resulted in the break or injury`, FALSE, FALSE, `on indictment`, FALSE, FALSE, FALSE, FALSE)
#ASSERT `the maximum months for` (`Cable case` OF TRUE, FALSE, TRUE, `a high-voltage cable`, `my conduct resulted in the break or injury`, FALSE, FALSE, `on indictment`, FALSE, FALSE, FALSE, FALSE) EQUALS 12
-- 10: telegraph cable so as might interrupt (s 7(1)(a))
#ASSERT `I commit an offence` (`Cable case` OF TRUE, FALSE, TRUE, `a telegraph or telephone cable, so as might interrupt communications`, `my conduct resulted in the break or injury`, FALSE, FALSE, `on indictment`, FALSE, FALSE, FALSE, FALSE)
-- 11: telegraph cable not so as might interrupt: no offence
#ASSERT NOT (`I commit an offence` (`Cable case` OF TRUE, FALSE, TRUE, `a telegraph or telephone cable, not so as might interrupt communications`, `my conduct resulted in the break or injury`, FALSE, FALSE, `on indictment`, FALSE, FALSE, FALSE, FALSE))
-- 12: negligent, saving lives, all precautions: no offence (s 7(2) disapplies (1A))
#ASSERT NOT (`I commit an offence` (`Cable case` OF TRUE, FALSE, TRUE, `a pipeline`, `I was negligent as to whether my conduct would result in it`, TRUE, TRUE, `on indictment`, FALSE, FALSE, FALSE, FALSE))
-- 13: negligent, saving lives, precautions not taken: offence
#ASSERT `I commit an offence` (`Cable case` OF TRUE, FALSE, TRUE, `a pipeline`, `I was negligent as to whether my conduct would result in it`, TRUE, FALSE, `on indictment`, FALSE, FALSE, FALSE, FALSE)
-- 14: s 7(1) conduct, saving lives with all precautions: still an offence (s 7(2) reaches only the last preceding subsection, (1A))
#ASSERT `I commit an offence` (`Cable case` OF TRUE, FALSE, TRUE, `a pipeline`, `my conduct resulted in the break or injury`, TRUE, TRUE, `on indictment`, FALSE, FALSE, FALSE, FALSE)
-- 15: laying own cable, broke another: bear repair cost (s 8)
#ASSERT `I must bear the repair cost` (`Cable case` OF TRUE, FALSE, TRUE, `a pipeline`, `neither`, FALSE, FALSE, `on indictment`, TRUE, TRUE, FALSE, FALSE)
-- 16: not laying own cable: s 8 does not apply
#ASSERT NOT (`I must bear the repair cost` (`Cable case` OF TRUE, FALSE, TRUE, `a pipeline`, `neither`, FALSE, FALSE, `on indictment`, FALSE, TRUE, FALSE, FALSE))
-- 17: outside high seas/EEZ: s 8 does not apply (s 5)
#ASSERT NOT (`I must bear the repair cost` (`Cable case` OF FALSE, FALSE, TRUE, `a pipeline`, `neither`, FALSE, FALSE, `on indictment`, TRUE, TRUE, FALSE, FALSE))
-- 18: gear sacrificed after all reasonable precautions: indemnified (s 9)
#ASSERT `I am indemnified` (`Cable case` OF TRUE, FALSE, TRUE, `a pipeline`, `neither`, FALSE, FALSE, `on indictment`, FALSE, FALSE, TRUE, TRUE)
-- 19: without reasonable precautions: not indemnified
#ASSERT NOT (`I am indemnified` (`Cable case` OF TRUE, FALSE, TRUE, `a pipeline`, `neither`, FALSE, FALSE, `on indictment`, FALSE, FALSE, TRUE, FALSE))
-- 20: outside high seas/EEZ: not indemnified (s 5)
#ASSERT NOT (`I am indemnified` (`Cable case` OF FALSE, FALSE, TRUE, `a pipeline`, `neither`, FALSE, FALSE, `on indictment`, FALSE, FALSE, TRUE, TRUE))
