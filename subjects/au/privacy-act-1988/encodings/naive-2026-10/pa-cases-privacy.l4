#ASSERT `the s 20W retention period is over on` `default information` 20370601 20420601

§ `ss 6Q, 21D -- defaults`

`k064: Jake's $41,000, 90 days overdue, notice given` MEANS `Overdue payment` WITH
    `days overdue` IS 90
    `written notice requesting payment given` IS TRUE
    `recovery barred by a statute of limitations` IS FALSE
    `amount overdue` IS 41000
    `higher amount prescribed by the regulations` IS 0

`k064 variant: 45 days overdue` MEANS `Overdue payment` WITH
    `days overdue` IS 45
    `written notice requesting payment given` IS TRUE
    `recovery barred by a statute of limitations` IS FALSE
    `amount overdue` IS 41000
    `higher amount prescribed by the regulations` IS 0

`variant: 120 dollars, 90 days overdue` MEANS `Overdue payment` WITH
    `days overdue` IS 90
    `written notice requesting payment given` IS TRUE
    `recovery barred by a statute of limitations` IS FALSE
    `amount overdue` IS 120
    `higher amount prescribed by the regulations` IS 0

#ASSERT `it is default information` `k064: Jake's $41,000, 90 days overdue, notice given`
#ASSERT NOT `it is default information` `k064 variant: 45 days overdue`
#ASSERT NOT `it is default information` `variant: 120 dollars, 90 days overdue`

