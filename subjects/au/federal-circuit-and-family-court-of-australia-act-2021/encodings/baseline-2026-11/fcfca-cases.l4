§ `ss 237, 239, 241-244 -- vexatious proceedings`

#ASSERT `s 239 -- can a vexatious proceedings order be made against me` `general` TRUE FALSE FALSE TRUE EQUALS `yes: the Court may stay or dismiss my proceedings, bar me from bringing proceedings (or some kinds), or make other orders such as security for costs (s 239(2))`
#ASSERT `s 239 -- can a vexatious proceedings order be made against me` `general` TRUE FALSE FALSE FALSE EQUALS `not yet: the Court must first hear me or give me an opportunity to be heard (s 239(5))`
#ASSERT `s 239 -- can a vexatious proceedings order be made against me` `general` FALSE TRUE FALSE TRUE EQUALS `yes: the Court may stay or dismiss my proceedings, bar me from bringing proceedings (or some kinds), or make other orders such as security for costs (s 239(2))`
-- s 237: acting only as the other person's lawyer is not acting in concert.
#ASSERT `s 239 -- can a vexatious proceedings order be made against me` `general` FALSE TRUE TRUE TRUE EQUALS `no: the Court is not satisfied of either s 239(1) ground`
#ASSERT `s 239 -- can a vexatious proceedings order be made against me` `general` FALSE FALSE FALSE TRUE EQUALS `no: the Court is not satisfied of either s 239(1) ground`
#ASSERT `s 239 -- can a vexatious proceedings order be made against me` `family law` TRUE FALSE FALSE TRUE EQUALS `not under s 239(2): Family Law Act 1975 Part XIB governs (s 239(3))`
#ASSERT `s 239 -- can a vexatious proceedings order be made against me` `child support` TRUE FALSE FALSE TRUE EQUALS `yes: the Court may stay or dismiss my proceedings, bar me from bringing proceedings (or some kinds), or make other orders such as security for costs (s 239(2))`

#ASSERT `s 241 -- can I start a new proceeding under a vexatious proceedings order` TRUE TRUE FALSE FALSE FALSE EQUALS `I need the Court's leave first; without it the proceeding is stayed (s 241)`
#ASSERT `s 241 -- can I start a new proceeding under a vexatious proceedings order` TRUE TRUE FALSE FALSE TRUE EQUALS `I have leave: I may institute it, on the Court's conditions (s 244(3))`
#ASSERT `s 241 -- can I start a new proceeding under a vexatious proceedings order` FALSE TRUE FALSE FALSE FALSE EQUALS `the order does not cover it: I may institute it`
#ASSERT `s 241 -- can I start a new proceeding under a vexatious proceedings order` TRUE FALSE TRUE FALSE FALSE EQUALS `I need the Court's leave first; without it the proceeding is stayed (s 241)`
#ASSERT `s 241 -- can I start a new proceeding under a vexatious proceedings order` TRUE FALSE TRUE TRUE FALSE EQUALS `the order does not cover it: I may institute it`
#ASSERT `s 241 -- can I start a new proceeding under a vexatious proceedings order` TRUE FALSE FALSE FALSE FALSE EQUALS `the order does not cover it: I may institute it`

#ASSERT `ss 243, 244 -- my application for leave` TRUE TRUE TRUE FALSE EQUALS `it must be dismissed: the Court considers the proceeding vexatious (s 243(2))`
#ASSERT `ss 243, 244 -- my application for leave` FALSE FALSE TRUE TRUE EQUALS `it may be dismissed: my affidavit does not substantially comply with s 242(3) (s 243(1))`
#ASSERT `ss 243, 244 -- my application for leave` FALSE TRUE FALSE TRUE EQUALS `it cannot yet be granted: the Court must first order me to serve the proposed respondent and hear them (s 244(1))`
#ASSERT `ss 243, 244 -- my application for leave` FALSE TRUE TRUE TRUE EQUALS `it may be granted, on conditions (s 244(3), (4))`
#ASSERT `ss 243, 244 -- my application for leave` FALSE TRUE TRUE FALSE EQUALS `it cannot be granted: the Court is not satisfied the proceeding is not vexatious (s 244(4))`

#ASSERT `s 242(4) -- may I serve my leave application` TRUE
#ASSERT (NOT (`s 242(4) -- may I serve my leave application` FALSE))

§ `s 50 -- where a family law case starts`

#ASSERT `s 50 -- where my family law case starts` `family law` FALSE FALSE FALSE EQUALS `Division 2; it cannot be started in Division 1 (s 50(1))`
#ASSERT `s 50 -- where my family law case starts` `child support` FALSE TRUE FALSE EQUALS `it was started in Division 1 by mistake: it is transferred to Division 2 by force of s 50(2) and is as valid as if properly started`
#ASSERT `s 50 -- where my family law case starts` `family law` FALSE TRUE TRUE EQUALS `it was started in Division 1 by mistake and has been transferred to the Federal Court (s 50(2)(a))`
#ASSERT `s 50 -- where my family law case starts` `family law` TRUE TRUE FALSE EQUALS `s 50 does not reach it: an appeal, or not a family law or child support proceeding`
#ASSERT `s 50 -- where my family law case starts` `general` FALSE TRUE FALSE EQUALS `s 50 does not reach it: an appeal, or not a family law or child support proceeding`
