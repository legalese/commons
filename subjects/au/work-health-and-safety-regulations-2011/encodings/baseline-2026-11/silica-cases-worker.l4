IMPORT prelude
IMPORT daydate
IMPORT `silica-worker`

-- Cases for silica-worker.l4, from the worker's seat. Every expected value was worked by hand from the deposited text
-- (F2011L02664, Compilation No. 28) before the file was run. No scenario life raised these; the cases are hypothetical.

§ `reg 529A(2) -- crystalline silica substance: at least 1%`

#ASSERT `Is the material a crystalline silica substance` 1
#ASSERT (NOT (`Is the material a crystalline silica substance` 0.99))
#ASSERT `Is the material a crystalline silica substance` 93
#ASSERT (NOT (`Is the material a crystalline silica substance` 0))

§ `reg 529A(4) -- engineered stone`

-- A quartz-resin benchtop slab, 93% crystalline silica: engineered stone.
#ASSERT `Is the product engineered stone` 93 TRUE TRUE TRUE `none of these` TRUE
-- The same recipe at 0.5% silica is not a CSS, so not engineered stone (the threshold edge, 1% exactly, is in).
#ASSERT (NOT (`Is the product engineered stone` 0.5 TRUE TRUE TRUE `none of these` TRUE))
#ASSERT `Is the product engineered stone` 1 TRUE TRUE TRUE `none of these` FALSE
-- Natural granite: not artificial.
#ASSERT (NOT (`Is the product engineered stone` 30 FALSE FALSE TRUE `none of these` FALSE))
-- Excluded products: concrete, ceramic tile, roof tile.
#ASSERT (NOT (`Is the product engineered stone` 20 TRUE TRUE TRUE `a concrete or cement product` FALSE))
#ASSERT (NOT (`Is the product engineered stone` 20 TRUE TRUE TRUE `a ceramic wall or floor tile` FALSE))
#ASSERT (NOT (`Is the product engineered stone` 20 TRUE TRUE TRUE `a roof tile` TRUE))
-- Sintered stone and porcelain without resin are excluded; with resin they are not "sintered stone" or a "porcelain
-- product" (reg 5), so the exclusion falls away and the product is engineered stone.
#ASSERT (NOT (`Is the product engineered stone` 40 TRUE TRUE TRUE `sintered stone` FALSE))
#ASSERT `Is the product engineered stone` 40 TRUE TRUE TRUE `sintered stone` TRUE
#ASSERT (NOT (`Is the product engineered stone` 15 TRUE TRUE TRUE `a porcelain product` FALSE))
#ASSERT `Is the product engineered stone` 15 TRUE TRUE TRUE `a porcelain product` TRUE
-- Not hardened.
#ASSERT (NOT (`Is the product engineered stone` 93 TRUE TRUE FALSE `none of these` TRUE))

§ `reg 529A(1) -- processing`

#ASSERT `Is my task processing of a crystalline silica substance` 93 `crushing, cutting, grinding, trimming, sanding, abrasive polishing or drilling it with power tools or mechanical plant`
#ASSERT `Is my task processing of a crystalline silica substance` 2 `tunnelling through it`
#ASSERT `Is my task processing of a crystalline silica substance` 2 `quarrying it`
#ASSERT (NOT (`Is my task processing of a crystalline silica substance` 93 `other work with it (for example handling by hand with no dust exposure likely)`))
-- Below 1% nothing is processing of a CSS, whatever the task.
#ASSERT (NOT (`Is my task processing of a crystalline silica substance` 0.9 `tunnelling through it`))

§ `reg 529B -- controlled`

-- Wet cutting, so far as reasonably practicable, not still at risk: controlled without a respirator.
#ASSERT `Was my processing controlled` TRUE TRUE FALSE FALSE FALSE FALSE FALSE
-- Wet cutting but still at risk and no respirator: not controlled.
#ASSERT (NOT (`Was my processing controlled` TRUE TRUE FALSE TRUE FALSE FALSE FALSE))
-- Still at risk, compliant respirator given and worn: controlled.
#ASSERT `Was my processing controlled` TRUE TRUE FALSE TRUE TRUE TRUE TRUE
-- Respirator given but not to AS/NZS 1716 and 1715: not "respiratory protective equipment" (529B(3)): not controlled.
#ASSERT (NOT (`Was my processing controlled` TRUE TRUE FALSE TRUE TRUE FALSE TRUE))
-- Given but not worn: not controlled.
#ASSERT (NOT (`Was my processing controlled` TRUE TRUE FALSE TRUE TRUE TRUE FALSE))
-- No engineering measure used, though one was practicable: not controlled even with a respirator worn.
#ASSERT (NOT (`Was my processing controlled` TRUE FALSE FALSE TRUE TRUE TRUE TRUE))
-- No engineering measure practicable (529B(2)): a compliant respirator, given and worn, is enough.
#ASSERT `Was my processing controlled` FALSE FALSE TRUE TRUE TRUE TRUE TRUE
#ASSERT (NOT (`Was my processing controlled` FALSE FALSE TRUE TRUE FALSE FALSE FALSE))
-- Engineering measure used but control measures not implemented so far as reasonably practicable: not controlled.
#ASSERT (NOT (`Was my processing controlled` FALSE TRUE FALSE FALSE FALSE FALSE FALSE))

§ `reg 529C -- processing must be controlled`

#ASSERT `Did my employer let me process silica uncontrolled` (Date 1 7 2024) 93 `crushing, cutting, grinding, trimming, sanding, abrasive polishing or drilling it with power tools or mechanical plant` FALSE EQUALS JUST TRUE
#ASSERT `Did my employer let me process silica uncontrolled` (Date 1 7 2024) 93 `crushing, cutting, grinding, trimming, sanding, abrasive polishing or drilling it with power tools or mechanical plant` TRUE EQUALS JUST FALSE
-- The day before the regulation came in: not reached.
#ASSERT `Did my employer let me process silica uncontrolled` (Date 30 6 2024) 93 `crushing, cutting, grinding, trimming, sanding, abrasive polishing or drilling it with power tools or mechanical plant` FALSE EQUALS NOTHING
-- Not processing: not reached.
#ASSERT `Did my employer let me process silica uncontrolled` (Date 1 3 2025) 93 `other work with it (for example handling by hand with no dust exposure likely)` FALSE EQUALS NOTHING

§ `regs 529D to 529F, 689A, 698A -- the engineered stone prohibition`

-- Fabricating a kitchen benchtop on 1 July 2024 (the first day), ordinary work, contract of 2025: prohibited.
#ASSERT `What does the engineered stone ban say about my work` (Date 1 7 2024) `processing` TRUE `ordinary work (making, fitting or selling benchtops, panels or slabs)` TRUE FALSE (Date 1 5 2024) FALSE EQUALS `prohibited (reg 529D)`
-- The same on 30 June 2024: not yet in force.
#ASSERT `What does the engineered stone ban say about my work` (Date 30 6 2024) `processing` TRUE `ordinary work (making, fitting or selling benchtops, panels or slabs)` FALSE FALSE (Date 1 5 2024) FALSE EQUALS `the prohibition was not yet in force (before 1 July 2024)`
-- Manufacturing has no exception in 529E or 529F, even for research.
#ASSERT `What does the engineered stone ban say about my work` (Date 1 2 2025) `manufacturing` TRUE `genuine research and analysis` TRUE FALSE (Date 1 1 2025) FALSE EQUALS `prohibited (reg 529D)`
-- Installing for sampling: 529E.
#ASSERT `What does the engineered stone ban say about my work` (Date 1 2 2025) `installing` TRUE `sampling and identifying engineered stone` FALSE FALSE (Date 1 1 2025) FALSE EQUALS `allowed: research or sampling (reg 529E)`
-- Installing to repair installed stone is not within 529E (supply and installation only for research or sampling).
#ASSERT `What does the engineered stone ban say about my work` (Date 1 2 2025) `installing` TRUE `removing, repairing or making minor modifications to installed engineered stone` FALSE FALSE (Date 1 1 2025) FALSE EQUALS `prohibited (reg 529D)`
-- Cutting out an installed benchtop for removal, controlled: 529F.
#ASSERT `What does the engineered stone ban say about my work` (Date 1 2 2025) `processing` TRUE `removing, repairing or making minor modifications to installed engineered stone` TRUE FALSE (Date 1 1 2025) FALSE EQUALS `allowed: research, sampling, removal, repair, minor modification or disposal, and controlled (reg 529F)`
-- The same, uncontrolled: prohibited.
#ASSERT `What does the engineered stone ban say about my work` (Date 1 2 2025) `processing` TRUE `removing, repairing or making minor modifications to installed engineered stone` FALSE FALSE (Date 1 1 2025) FALSE EQUALS `prohibited (reg 529D)`
-- Disposal processing, controlled: 529F.
#ASSERT `What does the engineered stone ban say about my work` (Date 1 2 2025) `processing` TRUE `disposing of the engineered stone` TRUE FALSE (Date 1 1 2025) FALSE EQUALS `allowed: research, sampling, removal, repair, minor modification or disposal, and controlled (reg 529F)`
-- An exempted type of engineered stone (689A(2)).
#ASSERT `What does the engineered stone ban say about my work` (Date 1 2 2025) `manufacturing` TRUE `ordinary work (making, fitting or selling benchtops, panels or slabs)` FALSE TRUE (Date 1 1 2025) FALSE EQUALS `allowed: the type of engineered stone is exempted (reg 689A)`
-- Not a benchtop, panel or slab (say, an engineered stone sink cast whole): 529D does not reach it.
#ASSERT `What does the engineered stone ban say about my work` (Date 1 2 2025) `processing` FALSE `ordinary work (making, fitting or selling benchtops, panels or slabs)` FALSE FALSE (Date 1 1 2025) FALSE EQUALS `not engineered stone benchtops, panels or slabs: reg 529D does not reach it`
-- reg 698A(1): installing on 31 December 2024 (the last day) under a contract of 31 December 2023 (the last day).
#ASSERT `What does the engineered stone ban say about my work` (Date 31 12 2024) `installing` TRUE `ordinary work (making, fitting or selling benchtops, panels or slabs)` FALSE FALSE (Date 31 12 2023) TRUE EQUALS `allowed: work under a contract entered into by 31 December 2023 (reg 698A)`
-- One day later in either date: prohibited.
#ASSERT `What does the engineered stone ban say about my work` (Date 1 1 2025) `installing` TRUE `ordinary work (making, fitting or selling benchtops, panels or slabs)` FALSE FALSE (Date 31 12 2023) TRUE EQUALS `prohibited (reg 529D)`
#ASSERT `What does the engineered stone ban say about my work` (Date 31 12 2024) `installing` TRUE `ordinary work (making, fitting or selling benchtops, panels or slabs)` FALSE FALSE (Date 1 1 2024) TRUE EQUALS `prohibited (reg 529D)`
-- Without the State or Territory transition condition: prohibited.
#ASSERT `What does the engineered stone ban say about my work` (Date 1 10 2024) `installing` TRUE `ordinary work (making, fitting or selling benchtops, panels or slabs)` FALSE FALSE (Date 1 6 2023) FALSE EQUALS `prohibited (reg 529D)`
-- reg 698A(2): processing for a pre-2024 contract must be controlled.
#ASSERT `What does the engineered stone ban say about my work` (Date 1 10 2024) `processing` TRUE `ordinary work (making, fitting or selling benchtops, panels or slabs)` TRUE FALSE (Date 1 6 2023) TRUE EQUALS `allowed: work under a contract entered into by 31 December 2023 (reg 698A)`
#ASSERT `What does the engineered stone ban say about my work` (Date 1 10 2024) `processing` TRUE `ordinary work (making, fitting or selling benchtops, panels or slabs)` FALSE FALSE (Date 1 6 2023) TRUE EQUALS `prohibited (reg 529D)`
-- reg 698A reaches supplying, installing and processing, never manufacturing.
#ASSERT `What does the engineered stone ban say about my work` (Date 1 10 2024) `supplying` TRUE `ordinary work (making, fitting or selling benchtops, panels or slabs)` FALSE FALSE (Date 1 6 2023) TRUE EQUALS `allowed: work under a contract entered into by 31 December 2023 (reg 698A)`
#ASSERT `What does the engineered stone ban say about my work` (Date 1 10 2024) `manufacturing` TRUE `ordinary work (making, fitting or selling benchtops, panels or slabs)` TRUE FALSE (Date 1 6 2023) TRUE EQUALS `prohibited (reg 529D)`

§ `reg 529G -- notice to the regulator`

#ASSERT `Must my employer notify the regulator of this engineered stone work` (Date 3 3 2025) `processing` `removing, repairing or making minor modifications to installed engineered stone` TRUE EQUALS `notice was required before the work started`
#ASSERT `Must my employer notify the regulator of this engineered stone work` (Date 3 3 2025) `processing` `disposing of the engineered stone` FALSE EQUALS `notice was required as soon as practicable after the business became aware`
#ASSERT `Must my employer notify the regulator of this engineered stone work` (Date 3 3 2025) `processing` `genuine research and analysis` TRUE EQUALS `no notice is required for this work`
#ASSERT `Must my employer notify the regulator of this engineered stone work` (Date 3 3 2025) `installing` `removing, repairing or making minor modifications to installed engineered stone` TRUE EQUALS `no notice is required for this work`
#ASSERT `Must my employer notify the regulator of this engineered stone work` (Date 30 6 2024) `processing` `disposing of the engineered stone` TRUE EQUALS `no notice is required for this work`

§ `regs 529H, 529I, 529J -- later notices and keeping them`

-- 529H: change on 10 March 2025; 30 days after is 9 April 2025.
#ASSERT `By when must my employer notify a change in the engineered stone work` (Date 10 3 2025) EQUALS Date 9 4 2025
-- Change on 15 December 2024: 14 January 2025.
#ASSERT `By when must my employer notify a change in the engineered stone work` (Date 15 12 2024) EQUALS Date 14 1 2025
-- 529I: last notice 15 March 2025; the 12 months end 14 March 2026; 30 days later is 13 April 2026.
#ASSERT `By when must my employer notify that the engineered stone work continues` (Date 15 3 2025) EQUALS Date 13 4 2026
-- Last notice 29 February 2028 (leap day): the 12 months end 28 February 2029; 30 days later is 30 March 2029.
#ASSERT `By when must my employer notify that the engineered stone work continues` (Date 29 2 2028) EQUALS Date 30 3 2029
-- Last notice 1 March 2027: the 12 months end 29 February 2028 (a leap year); 30 days later is 30 March 2028.
#ASSERT `By when must my employer notify that the engineered stone work continues` (Date 1 3 2027) EQUALS Date 30 3 2028
-- 529J: notice given 1 August 2024: kept for 5 years beginning that day, to 31 July 2029.
#ASSERT `Until when can I see my employer's engineered stone notice` (Date 1 8 2024) EQUALS Date 31 7 2029
#ASSERT `Until when can I see my employer's engineered stone notice` (Date 1 1 2025) EQUALS Date 31 12 2029

§ `reg 529CA -- high risk`

#ASSERT `Is my silica processing high risk` `assessed as high risk` EQUALS JUST TRUE
#ASSERT `Is my silica processing high risk` `assessed as not high risk` EQUALS JUST FALSE
#ASSERT `Is my silica processing high risk` `the business could not determine whether it is high risk` EQUALS JUST TRUE
#ASSERT `Is my silica processing high risk` `no assessment was made` EQUALS NOTHING

§ `regs 529CB to 529CE -- what is owed for high-risk processing`

-- A stonemason doing high-risk processing on 1 September 2024 (the first day), not construction work: all seven
-- heads but the safe work method statement.
#ASSERT `What must my employer do because my silica processing is high risk` (Date 1 9 2024) TRUE TRUE TRUE FALSE EQUALS LIST `prepare a silica risk control plan before the processing starts (reg 529CB)`, `make the plan available to me and give it to me before I start the processing (reg 529CC(1))`, `stop the processing if it departs from the plan, and resume only in accordance with it (reg 529CC(2))`, `give me accredited or approved crystalline silica training (reg 529CD)`, `carry out air monitoring for respirable crystalline silica (reg 529CE(a), reg 50)`, `give me health monitoring (reg 529CE(c), Part 7.1 Division 6)`
-- The day before: none of these duties yet.
#ASSERT `What must my employer do because my silica processing is high risk` (Date 31 8 2024) TRUE TRUE TRUE FALSE EQUALS EMPTY
-- Not high risk: none.
#ASSERT `What must my employer do because my silica processing is high risk` (Date 1 3 2025) FALSE TRUE TRUE FALSE EQUALS EMPTY
-- High risk construction work under a safe work method statement; a labourer nearby who does not process but may be
-- exposed: the statement, the plan duties, training, and air monitoring, but not 529CE(c) health monitoring.
#ASSERT `What must my employer do because my silica processing is high risk` (Date 1 3 2025) TRUE FALSE TRUE TRUE EQUALS LIST `prepare a safe work method statement meeting reg 529CB(2) before the processing starts (reg 529CB(3))`, `make the plan available to me and give it to me before I start the processing (reg 529CC(1))`, `stop the processing if it departs from the plan, and resume only in accordance with it (reg 529CC(2))`, `give me accredited or approved crystalline silica training (reg 529CD)`, `carry out air monitoring for respirable crystalline silica (reg 529CE(a), reg 50)`
-- A worker neither processing nor at risk: no training, air monitoring still.
#ASSERT `What must my employer do because my silica processing is high risk` (Date 1 3 2025) TRUE FALSE FALSE FALSE EQUALS LIST `prepare a silica risk control plan before the processing starts (reg 529CB)`, `make the plan available to me and give it to me before I start the processing (reg 529CC(1))`, `stop the processing if it departs from the plan, and resume only in accordance with it (reg 529CC(2))`, `carry out air monitoring for respirable crystalline silica (reg 529CE(a), reg 50)`

§ `reg 529CD(2) -- training record`

-- Stopped 10 August 2025: kept to 10 August 2030.
#ASSERT `Until when must my silica training record be kept` (Date 10 8 2025) EQUALS Date 10 8 2030
-- Stopped 29 February 2028: the period begins 1 March 2028 and ends 28 February 2033.
#ASSERT `Until when must my silica training record be kept` (Date 29 2 2028) EQUALS Date 28 2 2033
-- Stopped 28 February 2027: begins 1 March 2027, ends 29 February 2032 (a leap year).
#ASSERT `Until when must my silica training record be kept` (Date 28 2 2027) EQUALS Date 29 2 2032
-- Stopped 31 December 2025: begins 1 January 2026, ends 31 December 2030.
#ASSERT `Until when must my silica training record be kept` (Date 31 12 2025) EQUALS Date 31 12 2030

§ `reg 529CE(b) -- air monitoring result over the standard`

-- Reported to the business 20 January 2025: no more than 14 days, 3 February 2025.
#ASSERT `By when must my employer report the silica air monitoring result` (Date 20 1 2025) TRUE EQUALS JUST (Date 3 2 2025)
-- Reported 25 February 2025: 11 March 2025 (February 2025 has 28 days).
#ASSERT `By when must my employer report the silica air monitoring result` (Date 25 2 2025) TRUE EQUALS JUST (Date 11 3 2025)
#ASSERT `By when must my employer report the silica air monitoring result` (Date 20 1 2025) FALSE EQUALS NOTHING
-- Before 1 September 2024: not yet in force.
#ASSERT `By when must my employer report the silica air monitoring result` (Date 31 8 2024) TRUE EQUALS NOTHING
#ASSERT `By when must my employer report the silica air monitoring result` (Date 1 9 2024) TRUE EQUALS JUST (Date 15 9 2024)

§ `regs 50(2), 378(1) -- 30-year records`

-- Air monitoring record made 5 May 2025: kept to 5 May 2055.
#ASSERT `Until when must the air monitoring record be kept` (Date 5 5 2025) EQUALS Date 5 5 2055
-- Health monitoring report made 12 November 2024: to 12 November 2054.
#ASSERT `Until when must my health monitoring report be kept` (Date 12 11 2024) EQUALS Date 12 11 2054
-- Made 29 February 2024: begins 1 March 2024, ends 28 February 2054 (2054 is a common year).
#ASSERT `Until when must my health monitoring report be kept` (Date 29 2 2024) EQUALS Date 28 2 2054

§ `regs 368, 529CE(c) -- health monitoring`

-- Ongoing work and significant risk (reg 368(a)), before Chapter 8A: owed.
#ASSERT `Must my employer give me silica health monitoring` (Date 1 1 2024) TRUE TRUE FALSE
-- No significant risk judged, but high-risk processing from 1 September 2024: owed under 529CE(c).
#ASSERT `Must my employer give me silica health monitoring` (Date 1 9 2024) TRUE FALSE TRUE
-- The same on 31 August 2024: not owed.
#ASSERT (NOT (`Must my employer give me silica health monitoring` (Date 31 8 2024) TRUE FALSE TRUE))
-- Occasional work, not ongoing, not high risk: not owed.
#ASSERT (NOT (`Must my employer give me silica health monitoring` (Date 1 3 2025) FALSE TRUE FALSE))

#ASSERT `What must my silica health monitoring include` FALSE EQUALS LIST `demographic, medical and occupational history`, `records of personal exposure`, `a standardised respiratory questionnaire`, `a standardised respiratory function test (for example FEV1, FVC and FEV1/FVC)`, `a full size PA chest X-ray`
#ASSERT `What must my silica health monitoring include` TRUE EQUALS LIST `an equal or better type of monitoring recommended by an experienced registered medical practitioner`

§ `reg 378(2), (3) -- disclosing my report`

#ASSERT `May my health monitoring report be disclosed` `the regulator` TRUE FALSE
#ASSERT (NOT (`May my health monitoring report be disclosed` `the regulator` FALSE FALSE))
#ASSERT `May my health monitoring report be disclosed` `another business that must also provide me health monitoring` FALSE FALSE
#ASSERT `May my health monitoring report be disclosed` `a person bound by a duty of professional confidentiality` FALSE FALSE
#ASSERT (NOT (`May my health monitoring report be disclosed` `anyone else (for example a new employer or an insurer)` TRUE FALSE))
#ASSERT `May my health monitoring report be disclosed` `anyone else (for example a new employer or an insurer)` FALSE TRUE

§ `Penalties -- printed amounts`

#ASSERT `What is the most my employer can be fined for this silica breach` `reg 529D: prohibited engineered stone work` TRUE EQUALS 42000
#ASSERT `What is the most my employer can be fined for this silica breach` `reg 529D: prohibited engineered stone work` FALSE EQUALS 8400
#ASSERT `What is the most my employer can be fined for this silica breach` `reg 529C: processing not controlled` TRUE EQUALS 42000
#ASSERT `What is the most my employer can be fined for this silica breach` `regs 529G to 529J: engineered stone notice not given or kept` TRUE EQUALS 25000
#ASSERT `What is the most my employer can be fined for this silica breach` `reg 529CC(3): plan not reviewed` FALSE EQUALS 5000
#ASSERT `What is the most my employer can be fined for this silica breach` `reg 378: health monitoring record not kept or disclosed` TRUE EQUALS 8500
#ASSERT `What is the most my employer can be fined for this silica breach` `reg 529CA(4): assessment not in writing` FALSE EQUALS 1700
#ASSERT `What is the most my employer can be fined for this silica breach` `reg 369, 371(2), 372(1) or 373: health monitoring information, consultation or cost` TRUE EQUALS 25000
#ASSERT `What is the most my employer can be fined for this silica breach` `reg 368, 370, 371(1), 374(1), 375, 376 or 377: health monitoring or its report` TRUE EQUALS 42000
#ASSERT `What is the most my employer can be fined for this silica breach` `reg 50(2): air monitoring record not kept` FALSE EQUALS 1700

§ `The regulative rules, traced (days from the day the duty arises)`

-- Prohibited work done on day 3: breached by the business.
#TRACE `the engineered stone prohibition` AT 0 WITH
    PARTY `the business` DOES `carry out, or direct or allow me to carry out, prohibited engineered stone work` AT 3

-- Result over the standard sent on day 14 (the last day): fulfilled.
#TRACE `the air monitoring reporting duty` AT 0 WITH
    PARTY `the business` DOES `give the air monitoring result to the regulator` AT 14

-- Sent on day 15: breached.
#TRACE `the air monitoring reporting duty` AT 0 WITH
    PARTY `the business` DOES `give the air monitoring result to the regulator` AT 15

-- Change notified on day 30: fulfilled.
#TRACE `the change notice duty` AT 0 WITH
    PARTY `the business` DOES `notify the regulator of the change` AT 30

-- Continuing work never notified: breached once day 30 has passed.
#TRACE `the continuing-work notice duty` AT 0 WITH
    (WAITUNTIL 31)

-- Report obtained on day 10, copy given to me on day 12: fulfilled.
#TRACE `the health monitoring report duty` AT 0 WITH
    PARTY `the business` DOES `obtain the health monitoring report` AT 10
    PARTY `the business` DOES `give me a copy of the health monitoring report` AT 12
