#ASSERT `Was treating me an offence` TRUE `major` TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Was treating me an offence` TRUE `major` FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Was treating me an offence` TRUE `special` FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
