#ASSERT `Was treating me an offence` TRUE `major` FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Was treating me an offence` FALSE `major` FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `Was treating me an offence` TRUE `not treatment` FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING

