§§ `s 18 -- how long`

#ASSERT `The last day my guardianship order can have effect` `continuing` `initial` (`d` 1 3 2026) FALSE EQUALS `d` 1 3 2027
#ASSERT `The last day my guardianship order can have effect` `continuing` `initial` (`d` 1 3 2026) TRUE EQUALS `d` 1 3 2029
#ASSERT `The last day my guardianship order can have effect` `continuing` `renewed` (`d` 1 3 2026) FALSE EQUALS `d` 1 3 2029
#ASSERT `The last day my guardianship order can have effect` `continuing` `renewed` (`d` 1 3 2026) TRUE EQUALS `d` 1 3 2031
-- Made on 29 February: one year on is 28 February (fork F1).
#ASSERT `The last day my guardianship order can have effect` `continuing` `initial` (`d` 29 2 2024) FALSE EQUALS `d` 28 2 2025
-- Temporary: 30 days, across a short February.
#ASSERT `The last day my guardianship order can have effect` `temporary` `initial` (`d` 1 3 2026) FALSE EQUALS `d` 31 3 2026
#ASSERT `The last day my guardianship order can have effect` `temporary` `renewed` (`d` 15 2 2026) TRUE EQUALS `d` 17 3 2026

#ASSERT `Can my temporary guardianship order be renewed` 0 EQUALS JUST TRUE
#ASSERT `Can my temporary guardianship order be renewed` 1 EQUALS JUST FALSE
#ASSERT `Can my temporary guardianship order be renewed` 2 EQUALS JUST FALSE

