#ASSERT `Can this person seek review of the Public Guardian's decision` TRUE FALSE `I am, as the person the decision is about` EQUALS NOTHING

§§ `s 101 -- confidentiality`

#ASSERT `May information about me be disclosed` `for none of these reasons` EQUALS JUST FALSE
#ASSERT `May information about me be disclosed` `with the consent of the person who gave the information` EQUALS JUST TRUE
#ASSERT `May information about me be disclosed` `for legal proceedings arising out of those Acts, or a report of them` EQUALS JUST TRUE
#ASSERT `May information about me be disclosed` `with some other lawful excuse` EQUALS JUST TRUE
#ASSERT `The most penalty units for unlawful disclosure` EQUALS 10
#ASSERT `The longest imprisonment in months for unlawful disclosure` EQUALS 12
