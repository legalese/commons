IMPORT prelude
IMPORT `ltcs-dates`
IMPORT `ltcs-scheme`

-- Motor Accidents (Lifetime Care and Support) Act 2006 (NSW) -- worked cases for every exported question in
-- ltcs-scheme.l4 (the injured person's seat). Every expected value was worked by hand from the deposited text; none was
-- copied from the encoding's output. Each assertion is a claim about the ENCODING on stated facts, not about the law.
-- Dates and amounts are illustrative. BASELINE ENCODING. Not for public use as advice. See NOTES.md.

§ `cases`

`d` MEANS `the date`

§§ `s 3(1) -- the relevant Scheme commencement date`

-- Under 16 at the accident: 1 October 2006; otherwise 1 October 2007.
#ASSERT `What is my relevant Scheme commencement date` (`d` 1 10 1990) (`d` 30 9 2006) EQUALS `d` 1 10 2006
-- 16th birthday on the day of the accident: not "under 16".
#ASSERT `What is my relevant Scheme commencement date` (`d` 1 10 1990) (`d` 1 10 2006) EQUALS `d` 1 10 2007
-- 16th birthday the day after the accident: still under 16.
#ASSERT `What is my relevant Scheme commencement date` (`d` 2 10 1990) (`d` 1 10 2006) EQUALS `d` 1 10 2006
#ASSERT `What is my relevant Scheme commencement date` (`d` 1 1 1980) (`d` 1 1 2020) EQUALS `d` 1 10 2007

§§ `ss 4, 7A, 7B -- does the Act apply`

-- Arguments: date of birth, day of accident, caused by a motor accident, in NSW, an insured vehicle involved.
-- An adult injured on 1 October 2007, the first day: applies.
#ASSERT `Does the Act apply to my motor accident injury` (`d` 1 1 1980) (`d` 1 10 2007) TRUE TRUE TRUE EQUALS `the Act applies to my injury`
-- An adult injured the day before: s 7A buy-in.
#ASSERT `Does the Act apply to my motor accident injury` (`d` 1 1 1980) (`d` 30 9 2007) TRUE TRUE TRUE EQUALS `the Act does not apply, but I may buy in because the accident was before the Scheme began (s 7A)`
-- A 15-year-old injured on 30 September 2007: the 2006 date applies.
#ASSERT `Does the Act apply to my motor accident injury` (`d` 1 1 1992) (`d` 30 9 2007) TRUE TRUE TRUE EQUALS `the Act applies to my injury`
-- A child injured on 30 September 2006: s 7A.
#ASSERT `Does the Act apply to my motor accident injury` (`d` 1 1 1995) (`d` 30 9 2006) TRUE TRUE TRUE EQUALS `the Act does not apply, but I may buy in because the accident was before the Scheme began (s 7A)`
-- Outside NSW, after the date: s 7B.
#ASSERT `Does the Act apply to my motor accident injury` (`d` 1 1 1980) (`d` 1 1 2020) TRUE FALSE TRUE EQUALS `the Act does not apply, but I may buy in because the accident was outside New South Wales (s 7B)`
-- Outside NSW and before the date: the Act does not say (fork F2).
#ASSERT `Does the Act apply to my motor accident injury` (`d` 1 1 1980) (`d` 1 1 2005) TRUE FALSE TRUE EQUALS `the Act does not say whether I may buy in for an accident both outside New South Wales and before the Scheme began`
-- Not caused by a motor accident; no insured vehicle (in and outside NSW).
#ASSERT `Does the Act apply to my motor accident injury` (`d` 1 1 1980) (`d` 1 1 2020) FALSE TRUE TRUE EQUALS `the Act does not apply to my injury`
#ASSERT `Does the Act apply to my motor accident injury` (`d` 1 1 1980) (`d` 1 1 2020) TRUE TRUE FALSE EQUALS `the Act does not apply to my injury`
#ASSERT `Does the Act apply to my motor accident injury` (`d` 1 1 1980) (`d` 1 1 2020) TRUE FALSE FALSE EQUALS `the Act does not apply to my injury`

§§ `s 7 -- eligibility`

`adult` MEANS `d` 1 1 1980
`lifetime` MEANS `the criteria for lifetime participation`
`interim only` MEANS `the criteria for interim participation only`

#ASSERT `Am I eligible to be a participant` `adult` (`d` 1 1 2020) TRUE TRUE TRUE `lifetime` FALSE EQUALS `I am eligible as a lifetime participant`
#ASSERT `Am I eligible to be a participant` `adult` (`d` 1 1 2020) TRUE TRUE TRUE `interim only` FALSE EQUALS `I am eligible as an interim participant`
#ASSERT `Am I eligible to be a participant` `adult` (`d` 1 1 2020) TRUE TRUE TRUE `neither` FALSE EQUALS `I am not eligible`
-- s 7(3): damages for future treatment and care already awarded.
#ASSERT `Am I eligible to be a participant` `adult` (`d` 1 1 2020) TRUE TRUE TRUE `lifetime` TRUE EQUALS `I am not eligible`
-- s 7A(3)(b): for a buy-in, the damages are disregarded.
#ASSERT `Am I eligible to be a participant` `adult` (`d` 1 1 2005) TRUE TRUE TRUE `lifetime` TRUE EQUALS `I am eligible as a lifetime participant if I buy in by paying the contribution the Authority determines`
#ASSERT `Am I eligible to be a participant` `adult` (`d` 1 1 2020) TRUE FALSE TRUE `lifetime` TRUE EQUALS `I am eligible as a lifetime participant if I buy in by paying the contribution the Authority determines`
-- A buy-in that meets only the interim criteria (fork F3).
#ASSERT `Am I eligible to be a participant` `adult` (`d` 1 1 2020) TRUE FALSE TRUE `interim only` FALSE EQUALS `the Act does not say whether I am eligible`
#ASSERT `Am I eligible to be a participant` `adult` (`d` 1 1 2020) TRUE FALSE TRUE `neither` FALSE EQUALS `I am not eligible`
#ASSERT `Am I eligible to be a participant` `adult` (`d` 1 1 2020) TRUE TRUE FALSE `lifetime` FALSE EQUALS `I am not eligible`
#ASSERT `Am I eligible to be a participant` `adult` (`d` 1 1 2005) TRUE FALSE TRUE `lifetime` FALSE EQUALS `the Act does not say whether I am eligible`

§§ `s 8 -- who may apply`

#ASSERT `Can this person apply for me` `I am, or someone is applying on my behalf` FALSE EQUALS JUST TRUE
#ASSERT `Can this person apply for me` `I am, or someone is applying on my behalf` TRUE EQUALS JUST TRUE
#ASSERT `Can this person apply for me` `the insurer of a claim I made for the injury` FALSE EQUALS JUST TRUE
#ASSERT `Can this person apply for me` `the insurer of a claim I made for the injury` TRUE EQUALS JUST FALSE
#ASSERT `Can this person apply for me` `someone else` FALSE EQUALS JUST FALSE

§§ `s 9 -- acceptance`

-- Arguments: what the Authority is satisfied of, duly made, already interim, buy-in, contribution paid, interim now.
#ASSERT `Must the Authority accept me as a participant` `that I am eligible as a lifetime participant` TRUE FALSE FALSE FALSE FALSE EQUALS `it must accept me as a lifetime participant`
#ASSERT `Must the Authority accept me as a participant` `that I am eligible as an interim participant` TRUE FALSE FALSE FALSE FALSE EQUALS `it must accept me as an interim participant`
-- s 9(6): never interim twice for one injury.
#ASSERT `Must the Authority accept me as a participant` `that I am eligible as an interim participant` TRUE TRUE FALSE FALSE FALSE EQUALS `it cannot accept me as an interim participant again`
-- s 9(7): after interim participation has ended, lifetime acceptance is still a duty on a duly made application (s 9(2)).
#ASSERT `Must the Authority accept me as a participant` `that I am eligible as a lifetime participant` TRUE TRUE FALSE FALSE FALSE EQUALS `it must accept me as a lifetime participant`
#ASSERT `Must the Authority accept me as a participant` `that I am eligible as a lifetime participant` FALSE FALSE FALSE FALSE FALSE EQUALS `the Act does not require it to accept me`
#ASSERT `Must the Authority accept me as a participant` `that I am not eligible` TRUE FALSE FALSE FALSE FALSE EQUALS `the Act does not require it to accept me`
-- s 9(3) (fork F14): during interim participation, the Authority becoming satisfied of lifetime eligibility is enough;
-- no duly made application is needed. Once interim participation has ended, it is.
#ASSERT `Must the Authority accept me as a participant` `that I am eligible as a lifetime participant` FALSE TRUE FALSE FALSE TRUE EQUALS `it must accept me as a lifetime participant`
#ASSERT `Must the Authority accept me as a participant` `that I am eligible as a lifetime participant` FALSE TRUE FALSE FALSE FALSE EQUALS `the Act does not require it to accept me`
-- Still interim and satisfied only of interim eligibility: s 9(6), no second interim acceptance.
#ASSERT `Must the Authority accept me as a participant` `that I am eligible as an interim participant` TRUE TRUE FALSE FALSE TRUE EQUALS `it cannot accept me as an interim participant again`
-- A buy-in: unpaid, paid (fork F4), and interim only (fork F3).
#ASSERT `Must the Authority accept me as a participant` `that I am eligible as a lifetime participant` TRUE FALSE TRUE FALSE FALSE EQUALS `the Act does not require it to accept me`
#ASSERT `Must the Authority accept me as a participant` `that I am eligible as a lifetime participant` TRUE FALSE TRUE TRUE FALSE EQUALS `it must accept me as a lifetime participant`
#ASSERT `Must the Authority accept me as a participant` `that I am eligible as an interim participant` TRUE FALSE TRUE TRUE FALSE EQUALS `the Act does not say`

§§ `s 9(5), (5A) -- the last day of interim participation`

-- Aged 3 or over: two years including the day of acceptance (fork F6).
#ASSERT `What is the last day of my interim participation` (`d` 1 1 2000) (`d` 15 3 2024) EQUALS `d` 14 3 2026
-- Born 10 June 2022: aged 2 on 1 January 2025, so until 5 (last day 9 June 2027); aged 3 on 1 July 2025, so two years.
#ASSERT `What is the last day of my interim participation` (`d` 10 6 2022) (`d` 1 1 2025) EQUALS `d` 9 6 2027
#ASSERT `What is the last day of my interim participation` (`d` 10 6 2022) (`d` 1 7 2025) EQUALS `d` 30 6 2027
-- Third birthday on the day of acceptance: "3 years of age or over".
#ASSERT `What is the last day of my interim participation` (`d` 10 6 2022) (`d` 10 6 2025) EQUALS `d` 9 6 2027
-- The day before the third birthday: "under 3", until 5.
#ASSERT `What is the last day of my interim participation` (`d` 10 6 2022) (`d` 9 6 2025) EQUALS `d` 9 6 2027
-- Accepted on 29 February 2024: the second anniversary is read as 28 February 2026 (fork F6).
#ASSERT `What is the last day of my interim participation` (`d` 1 1 2000) (`d` 29 2 2024) EQUALS `d` 27 2 2026
-- Born on 29 February 2020: turns 5 on 28 February 2025 (fork F7).
#ASSERT `What is the last day of my interim participation` (`d` 29 2 2020) (`d` 1 1 2022) EQUALS `d` 27 2 2025

§§ `s 9(4)-(5B) -- participation on a day`

`any day` MEANS `d` 1 1 2000

#ASSERT `Am I a participant on this day` `adult` TRUE (`d` 15 3 2024) FALSE `any day` (`d` 14 3 2024) EQUALS `I am not a participant`
#ASSERT `Am I a participant on this day` `adult` TRUE (`d` 15 3 2024) FALSE `any day` (`d` 15 3 2024) EQUALS `I am an interim participant`
#ASSERT `Am I a participant on this day` `adult` TRUE (`d` 15 3 2024) FALSE `any day` (`d` 14 3 2026) EQUALS `I am an interim participant`
#ASSERT `Am I a participant on this day` `adult` TRUE (`d` 15 3 2024) FALSE `any day` (`d` 15 3 2026) EQUALS `my interim participation has ended`
-- Accepted as a lifetime participant on 1 January 2025 (s 9(5B)).
#ASSERT `Am I a participant on this day` `adult` TRUE (`d` 15 3 2024) TRUE (`d` 1 1 2025) (`d` 31 12 2024) EQUALS `I am an interim participant`
#ASSERT `Am I a participant on this day` `adult` TRUE (`d` 15 3 2024) TRUE (`d` 1 1 2025) (`d` 1 1 2025) EQUALS `I am a lifetime participant, for life`
#ASSERT `Am I a participant on this day` `adult` TRUE (`d` 15 3 2024) TRUE (`d` 1 1 2025) (`d` 1 1 2060) EQUALS `I am a lifetime participant, for life`
-- s 9(7): accepted as a lifetime participant after interim participation ended.
#ASSERT `Am I a participant on this day` `adult` TRUE (`d` 15 3 2024) TRUE (`d` 1 6 2026) (`d` 1 4 2026) EQUALS `my interim participation has ended`
#ASSERT `Am I a participant on this day` `adult` TRUE (`d` 15 3 2024) TRUE (`d` 1 6 2026) (`d` 1 6 2026) EQUALS `I am a lifetime participant, for life`
#ASSERT `Am I a participant on this day` `adult` FALSE `any day` FALSE `any day` (`d` 1 1 2025) EQUALS `I am not a participant`
#ASSERT `Am I a participant on this day` `adult` FALSE `any day` TRUE (`d` 1 1 2025) (`d` 1 1 2030) EQUALS `I am a lifetime participant, for life`

§§ `s 11(2) -- time does not run`

`s 109` MEANS `section 109 of the Motor Accidents Compensation Act 1999`
`Limitation Act` MEANS `a provision of the Limitation Act 1969`
`another limit` MEANS `another time limit, for example under the Motor Accident Injuries Act 2017`

#ASSERT `Does section 11(2) stop time running on my damages claim` `adult` TRUE (`d` 15 3 2024) FALSE `any day` (`d` 15 3 2025) TRUE `s 109` EQUALS JUST TRUE
#ASSERT `Does section 11(2) stop time running on my damages claim` `adult` TRUE (`d` 15 3 2024) FALSE `any day` (`d` 15 3 2025) TRUE `Limitation Act` EQUALS JUST TRUE
-- A time limit s 11(2) does not name (finding 2).
#ASSERT `Does section 11(2) stop time running on my damages claim` `adult` TRUE (`d` 15 3 2024) FALSE `any day` (`d` 15 3 2025) TRUE `another limit` EQUALS NOTHING
#ASSERT `Does section 11(2) stop time running on my damages claim` `adult` TRUE (`d` 15 3 2024) FALSE `any day` (`d` 15 3 2025) FALSE `s 109` EQUALS JUST FALSE
-- The last day of interim participation, and the day after.
#ASSERT `Does section 11(2) stop time running on my damages claim` `adult` TRUE (`d` 15 3 2024) FALSE `any day` (`d` 14 3 2026) TRUE `s 109` EQUALS JUST TRUE
#ASSERT `Does section 11(2) stop time running on my damages claim` `adult` TRUE (`d` 15 3 2024) FALSE `any day` (`d` 15 3 2026) TRUE `s 109` EQUALS JUST FALSE
-- A lifetime participant: time runs.
#ASSERT `Does section 11(2) stop time running on my damages claim` `adult` TRUE (`d` 15 3 2024) TRUE (`d` 1 1 2025) (`d` 1 1 2025) TRUE `s 109` EQUALS JUST FALSE
#ASSERT `Does section 11(2) stop time running on my damages claim` `adult` FALSE `any day` FALSE `any day` (`d` 1 1 2025) TRUE `Limitation Act` EQUALS JUST FALSE

-- Days counted, both ends included (fork F8).
#ASSERT `How many days has my interim participation stopped time running` `adult` (`d` 15 3 2024) FALSE `any day` (`d` 15 3 2024) EQUALS 1
#ASSERT `How many days has my interim participation stopped time running` `adult` (`d` 15 3 2024) FALSE `any day` (`d` 14 3 2024) EQUALS 0
#ASSERT `How many days has my interim participation stopped time running` `adult` (`d` 15 3 2024) FALSE `any day` (`d` 1 1 2024) EQUALS 0
#ASSERT `How many days has my interim participation stopped time running` `adult` (`d` 15 3 2024) FALSE `any day` (`d` 15 4 2024) EQUALS 32
-- The whole two years: 15 March 2024 to 14 March 2026 is 730 days.
#ASSERT `How many days has my interim participation stopped time running` `adult` (`d` 15 3 2024) FALSE `any day` (`d` 1 1 2030) EQUALS 730
#ASSERT `How many days has my interim participation stopped time running` `adult` (`d` 15 3 2024) FALSE `any day` (`d` 14 3 2026) EQUALS 730
-- Lifetime from 1 January 2025: 15 March to 31 December 2024 is 292 days.
#ASSERT `How many days has my interim participation stopped time running` `adult` (`d` 15 3 2024) TRUE (`d` 1 1 2025) (`d` 1 1 2030) EQUALS 292

§§ `Part 2A -- will the Authority pay`

-- Arguments: kind, declared excluded, in assessed needs, participant when incurred, expense reasonable, provided free,
-- Guidelines require an approved provider, a medical practitioner's service, provider approved, special circumstances.
`medical` MEANS `medical treatment, including pharmaceuticals`
`attendant care` MEANS `attendant care services`
`must pay` MEANS `the Authority must pay the reasonable expense`
`may elect` MEANS `the Authority is not required to pay, but may elect to because it is of the opinion that special circumstances justify it`
`need not pay` MEANS `the Authority is not required to pay`
`nothing payable` MEANS `no expense is payable for it`

#ASSERT `Will the Authority pay for this` `medical` FALSE TRUE TRUE TRUE FALSE FALSE TRUE FALSE FALSE EQUALS `must pay`
-- Attendant care always needs an approved provider (s 11C(1)(a)).
#ASSERT `Will the Authority pay for this` `attendant care` FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS `need not pay`
#ASSERT `Will the Authority pay for this` `attendant care` FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE TRUE EQUALS `may elect`
#ASSERT `Will the Authority pay for this` `attendant care` FALSE TRUE TRUE TRUE FALSE FALSE FALSE TRUE FALSE EQUALS `must pay`
-- A Guidelines-listed service from an unapproved provider; a medical practitioner's service is outside s 11C(1)(b).
#ASSERT `Will the Authority pay for this` `rehabilitation` FALSE TRUE TRUE TRUE FALSE TRUE FALSE FALSE FALSE EQUALS `need not pay`
#ASSERT `Will the Authority pay for this` `medical` FALSE TRUE TRUE TRUE FALSE TRUE TRUE FALSE FALSE EQUALS `must pay`
-- Gratuitous care (s 11B(1)(a)), with and without the Authority's opinion of special circumstances.
#ASSERT `Will the Authority pay for this` `respite care` FALSE TRUE TRUE TRUE TRUE FALSE FALSE TRUE FALSE EQUALS `need not pay`
#ASSERT `Will the Authority pay for this` `respite care` FALSE TRUE TRUE TRUE TRUE FALSE FALSE TRUE TRUE EQUALS `may elect`
-- s 11A(3): excluded, or not assessed.
#ASSERT `Will the Authority pay for this` `aids and appliances` TRUE TRUE TRUE TRUE FALSE FALSE FALSE TRUE TRUE EQUALS `nothing payable`
#ASSERT `Will the Authority pay for this` `home and transport modification` FALSE FALSE TRUE TRUE FALSE FALSE FALSE TRUE TRUE EQUALS `nothing payable`
-- Not a participant when incurred; an unreasonable expense; something outside s 5A.
#ASSERT `Will the Authority pay for this` `dental treatment` FALSE TRUE FALSE TRUE FALSE FALSE FALSE TRUE FALSE EQUALS `need not pay`
#ASSERT `Will the Authority pay for this` `prostheses` FALSE TRUE TRUE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS `the Act does not say`
#ASSERT `Will the Authority pay for this` `something else` FALSE TRUE TRUE TRUE FALSE FALSE FALSE TRUE FALSE EQUALS `need not pay`
#ASSERT `Will the Authority pay for this` `a kind prescribed by the regulations` FALSE TRUE TRUE TRUE FALSE FALSE FALSE TRUE FALSE EQUALS `must pay`

-- s 11AA(2): the smaller of a reasonable contribution and what would otherwise be paid.
#ASSERT `What is the most the Authority will contribute to alternative expenditure` 5000 6000 EQUALS 5000
#ASSERT `What is the most the Authority will contribute to alternative expenditure` 6000 6000 EQUALS 6000
#ASSERT `What is the most the Authority will contribute to alternative expenditure` 6001 6000 EQUALS 6000

§§ `Disputes`

#ASSERT `Where does my dispute go` `whether my injury meets the eligibility criteria in the LTCS Guidelines` EQUALS `to an Assessment Panel of 3 assessors, referred by me, the insurer or the Authority (s 14)`
#ASSERT `Where does my dispute go` `whether my injury is a motor accident injury` EQUALS `to the Personal Injury Commission, referred by the Authority at my request (s 20)`
#ASSERT `Where does my dispute go` `the Authority's assessment of my treatment and care needs` EQUALS `to an assessor, referred by the Authority if I ask within 28 days after its certificate (s 24)`
#ASSERT `Where does my dispute go` `something else` EQUALS `the Act sets no dispute process for it`

-- s 15(1). Arguments: condition changed, new information, material, not per Guidelines, demonstrably incorrect.
#ASSERT `Can I have the Assessment Panel's determination reviewed` TRUE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Can I have the Assessment Panel's determination reviewed` TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Can I have the Assessment Panel's determination reviewed` FALSE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Can I have the Assessment Panel's determination reviewed` FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Can I have the Assessment Panel's determination reviewed` FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Can I have the Assessment Panel's determination reviewed` FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Can I have the Assessment Panel's determination reviewed` FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE

-- s 24(2): 28 days after the certificate. A certificate given 1 February 2026: the last day is 1 March 2026.
#ASSERT `What is the last day to ask for an assessor` (`d` 1 2 2026) EQUALS `d` 1 3 2026
#ASSERT `What is the last day to ask for an assessor` (`d` 10 1 2026) EQUALS `d` 7 2 2026
-- Across a year end and into a leap February.
#ASSERT `What is the last day to ask for an assessor` (`d` 15 12 2027) EQUALS `d` 12 1 2028
#ASSERT `What is the last day to ask for an assessor` (`d` 1 2 2028) EQUALS `d` 29 2 2028
#ASSERT `Must the Authority refer my dispute to an assessor` (`d` 1 2 2026) (`d` 1 2 2026) EQUALS JUST TRUE
#ASSERT `Must the Authority refer my dispute to an assessor` (`d` 1 2 2026) (`d` 1 3 2026) EQUALS JUST TRUE
#ASSERT `Must the Authority refer my dispute to an assessor` (`d` 1 2 2026) (`d` 2 3 2026) EQUALS JUST FALSE
#ASSERT `Must the Authority refer my dispute to an assessor` (`d` 1 2 2026) (`d` 31 1 2026) EQUALS NOTHING

-- s 25(2): 28 days after the assessor's certificate given 20 December 2025: the last day is 17 January 2026.
#ASSERT `What is the last day to refer the assessor's determination for review` (`d` 20 12 2025) EQUALS `d` 17 1 2026
#ASSERT `What is the last day to refer the assessor's determination for review` (`d` 1 2 2026) EQUALS `d` 1 3 2026
-- Arguments: certificate day, referral day, new information, not per Guidelines, demonstrably incorrect.
#ASSERT `Can I refer the assessor's determination for review` (`d` 20 12 2025) (`d` 17 1 2026) TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Can I refer the assessor's determination for review` (`d` 20 12 2025) (`d` 18 1 2026) TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Can I refer the assessor's determination for review` (`d` 20 12 2025) (`d` 1 1 2026) FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Can I refer the assessor's determination for review` (`d` 20 12 2025) (`d` 1 1 2026) FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Can I refer the assessor's determination for review` (`d` 20 12 2025) (`d` 1 1 2026) FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Can I refer the assessor's determination for review` (`d` 20 12 2025) (`d` 19 12 2025) TRUE FALSE FALSE EQUALS NOTHING

-- s 27.
#ASSERT `Must I comply with this request` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Must I comply with this request` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `Must I comply with this request` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `Must I comply with this request` TRUE FALSE TRUE EQUALS NOTHING

§§ `Costs`

#ASSERT `Will the Authority pay this cost of attending the panel` `my travel and accommodation to attend the panel` TRUE EQUALS JUST TRUE
#ASSERT `Will the Authority pay this cost of attending the panel` `the travel and accommodation of a parent or carer who goes with me` TRUE EQUALS JUST TRUE
#ASSERT `Will the Authority pay this cost of attending the panel` `my travel and accommodation to attend the panel` FALSE EQUALS NOTHING
#ASSERT `Will the Authority pay this cost of attending the panel` `some other cost` TRUE EQUALS NOTHING

#ASSERT `Will the Authority pay my legal costs` `a dispute about eligibility before an Assessment Panel or Review Panel` EQUALS JUST FALSE
#ASSERT `Will the Authority pay my legal costs` `a dispute about whether my injury is a motor accident injury` EQUALS JUST TRUE
#ASSERT `Will the Authority pay my legal costs` `an assessment of my treatment and care needs, or a dispute or review about it` EQUALS JUST FALSE
#ASSERT `Will the Authority pay my legal costs` `something else` EQUALS NOTHING

#ASSERT `How much of my legal costs will the Authority pay` 12000 FALSE 0 EQUALS 12000
#ASSERT `How much of my legal costs will the Authority pay` 12000 TRUE 10000 EQUALS 10000
#ASSERT `How much of my legal costs will the Authority pay` 9999 TRUE 10000 EQUALS 9999
#ASSERT `How much of my legal costs will the Authority pay` 10000 TRUE 10000 EQUALS 10000
#ASSERT `How much of my legal costs will the Authority pay` 10001 TRUE 10000 EQUALS 10000
