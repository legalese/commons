#ASSERT `Can the business charge me for health and safety` TRUE TRUE EQUALS JUST FALSE
#ASSERT `Can the business charge me for health and safety` TRUE FALSE EQUALS NOTHING
#ASSERT `Can the business charge me for health and safety` FALSE TRUE EQUALS NOTHING
