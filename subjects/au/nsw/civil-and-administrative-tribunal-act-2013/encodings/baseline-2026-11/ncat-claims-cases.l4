#ASSERT `The last day to ask for reasons` (d 10 2 2028) EQUALS d 9 3 2028
#ASSERT `The last day to ask for reasons` (d 15 12 2026) EQUALS d 12 1 2027

-- Arguments: day of notice; day of request.
#ASSERT `Is my request for reasons in time` (d 1 5 2026) (d 29 5 2026) EQUALS JUST TRUE
#ASSERT `Is my request for reasons in time` (d 1 5 2026) (d 30 5 2026) EQUALS JUST FALSE
#ASSERT `Is my request for reasons in time` (d 1 5 2026) (d 1 5 2026) EQUALS JUST TRUE
#ASSERT `Is my request for reasons in time` (d 10 2 2028) (d 9 3 2028) EQUALS JUST TRUE
#ASSERT `Is my request for reasons in time` (d 10 2 2028) (d 10 3 2028) EQUALS JUST FALSE
#ASSERT `Is my request for reasons in time` (d 15 12 2026) (d 13 1 2027) EQUALS JUST FALSE

-- 29 May 2026 + 28 = 26 June 2026.
#ASSERT `The last day for the Tribunal to give me reasons` (d 29 5 2026) EQUALS d 26 6 2026
#ASSERT `The last day for the Tribunal to give me reasons` (d 20 12 2026) EQUALS d 17 1 2027

`reasons in time` MEANS `the reasons were provided in time`
`reasons late` MEANS `the reasons were not provided within 28 days after my request`
`reasons not yet` MEANS `not yet provided, and the 28 days have not ended`

-- Arguments: day of request; reasons provided; day provided; today.
#ASSERT `Were my reasons given in time` (d 29 5 2026) TRUE (d 26 6 2026) `any day` EQUALS `reasons in time`
#ASSERT `Were my reasons given in time` (d 29 5 2026) TRUE (d 27 6 2026) `any day` EQUALS `reasons late`
#ASSERT `Were my reasons given in time` (d 29 5 2026) TRUE (d 1 6 2026) `any day` EQUALS `reasons in time`
#ASSERT `Were my reasons given in time` (d 29 5 2026) FALSE `any day` (d 26 6 2026) EQUALS `reasons not yet`
#ASSERT `Were my reasons given in time` (d 29 5 2026) FALSE `any day` (d 27 6 2026) EQUALS `reasons late`

§§ `s 78 -- enforcing a money order`

`not a penalty` MEANS `an amount that is not a penalty (including costs)`
`a penalty` MEANS `a civil or other penalty under other legislation`

-- Arguments: what was ordered; certified by a registrar; the court's jurisdiction covers the amount.
#ASSERT `How do I enforce my money order` `not a penalty` TRUE TRUE EQUALS `the registrar's certificate, filed in that court, operates as a judgment of that court for the amount`
#ASSERT `How do I enforce my money order` `not a penalty` FALSE TRUE EQUALS `have the amount certified by a registrar, identifying the person liable, and file the certificate in a court that can give judgment for that amount`
#ASSERT `How do I enforce my money order` `not a penalty` TRUE FALSE EQUALS `file the certificate in a court that can give judgment for a debt of that amount; this one cannot`
#ASSERT `How do I enforce my money order` `a penalty` TRUE TRUE EQUALS `the penalty may be registered as a judgment debt in a court of competent jurisdiction and enforced accordingly`
#ASSERT `How do I enforce my money order` `a penalty` FALSE FALSE EQUALS `the penalty may be registered as a judgment debt in a court of competent jurisdiction and enforced accordingly`

