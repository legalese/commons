#ASSERT `Must my employer give me suitable work` TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Must my employer give me suitable work` TRUE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Must my employer give me suitable work` FALSE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
