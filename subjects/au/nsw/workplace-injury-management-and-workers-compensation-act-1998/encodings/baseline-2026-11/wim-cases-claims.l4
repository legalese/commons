IMPORT prelude
IMPORT `wim-dates`
IMPORT `wim-claims`

-- Workplace Injury Management and Workers Compensation Act 1998 (NSW) -- worked cases for the claim questions
-- (wim-claims.l4) and the date counting (wim-dates.l4). Every expected value was worked by hand from the deposited text;
-- none was copied from the encoding's output. Each assertion is a claim about the ENCODING on stated facts, not about the
-- law. The facts are illustrative.
-- BASELINE ENCODING. Not for public use as advice. See NOTES.md.

§ `cases`

`d` MEANS `the calendar date`

§§ `Dates`

-- 31 August plus 6 months: no 31 February, so the last day of February (2026 is not a leap year; 2028 is).
#ASSERT `the date` 6 `months after` (`d` 31 8 2025) EQUALS `d` 28 2 2026
#ASSERT `the date` 6 `months after` (`d` 31 8 2027) EQUALS `d` 29 2 2028
#ASSERT `the date` 1 `months after` (`d` 31 1 2026) EQUALS `d` 28 2 2026
#ASSERT `the date` 6 `months after` (`d` 15 10 2025) EQUALS `d` 15 4 2026
#ASSERT `the date` 2 `months after` (`d` 15 11 2025) EQUALS `d` 15 1 2026
#ASSERT `the date` 3 `years after` (`d` 29 2 2024) EQUALS `d` 28 2 2027
#ASSERT `the date` 7 `days after` (`d` 28 12 2025) EQUALS `d` 4 1 2026

§§ `s 4 -- worker`

-- Arguments: contract, Schedule 1, police super, casual stint, association officer, pay from it, sporting participant.
#ASSERT `Am I a worker` TRUE FALSE FALSE FALSE FALSE 0 FALSE EQUALS JUST TRUE
#ASSERT `Am I a worker` TRUE FALSE TRUE FALSE FALSE 0 FALSE EQUALS JUST FALSE
#ASSERT `Am I a worker` TRUE FALSE FALSE TRUE FALSE 0 FALSE EQUALS JUST FALSE
-- (c): $700 a year "does not exceed $700": excluded; $701 is not.
#ASSERT `Am I a worker` TRUE FALSE FALSE FALSE TRUE 700 FALSE EQUALS JUST FALSE
#ASSERT `Am I a worker` TRUE FALSE FALSE FALSE TRUE 701 FALSE EQUALS JUST TRUE
#ASSERT `Am I a worker` TRUE FALSE FALSE FALSE FALSE 0 TRUE EQUALS JUST FALSE
#ASSERT `Am I a worker` TRUE TRUE FALSE FALSE FALSE 0 TRUE EQUALS NOTHING
#ASSERT `Am I a worker` FALSE TRUE FALSE FALSE FALSE 0 FALSE EQUALS NOTHING
#ASSERT `Am I a worker` FALSE FALSE FALSE FALSE FALSE 0 FALSE EQUALS JUST FALSE

