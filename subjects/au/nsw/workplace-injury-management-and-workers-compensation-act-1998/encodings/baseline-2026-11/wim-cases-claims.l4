#ASSERT `May the insurer stop my provisional payments for missing papers` FALSE (`d` 1 3 2026) FALSE (`d` 1 3 2026) (`d` 20 3 2026) EQUALS JUST FALSE
#ASSERT `May the insurer stop my provisional payments for missing papers` TRUE (`d` 1 3 2026) TRUE (`d` 8 3 2026) (`d` 20 3 2026) EQUALS JUST FALSE
#ASSERT `May the insurer stop my provisional payments for missing papers` TRUE (`d` 1 3 2026) TRUE (`d` 9 3 2026) (`d` 20 3 2026) EQUALS JUST TRUE
#ASSERT `May the insurer stop my provisional payments for missing papers` TRUE (`d` 1 3 2026) FALSE (`d` 1 3 2026) (`d` 8 3 2026) EQUALS JUST FALSE
#ASSERT `May the insurer stop my provisional payments for missing papers` TRUE (`d` 1 3 2026) FALSE (`d` 1 3 2026) (`d` 9 3 2026) EQUALS JUST TRUE

§§ `ss 274-282 -- deciding the claim`

-- Weekly payments claim 1 March 2026: 21 days is 22 March; a provisional period ending 24 May extends it, one ending
-- 10 March does not shorten it.
#ASSERT `By when must my weekly payments claim be decided` (`d` 1 3 2026) FALSE (`d` 1 3 2026) EQUALS `d` 22 3 2026
#ASSERT `By when must my weekly payments claim be decided` (`d` 1 3 2026) TRUE (`d` 24 5 2026) EQUALS `d` 24 5 2026
#ASSERT `By when must my weekly payments claim be decided` (`d` 1 3 2026) TRUE (`d` 10 3 2026) EQUALS `d` 22 3 2026
#ASSERT `By when must my medical expenses claim be decided` (`d` 1 3 2026) EQUALS `d` 22 3 2026
#ASSERT `How much medical expense can be accepted provisionally` FALSE EQUALS JUST 5000
#ASSERT `How much medical expense can be accepted provisionally` TRUE EQUALS NOTHING
#ASSERT `May I claim work injury damages` TRUE EQUALS JUST TRUE
#ASSERT `May I claim work injury damages` FALSE EQUALS JUST FALSE

-- s 281: particulars 15 January 2026, so 2 months is 15 March 2026.
-- Arguments: particulars, insurer said not yet ascertainable, now ascertainable, day it became so.
#ASSERT `By when must my lump sum or damages claim be decided` (`d` 15 1 2026) FALSE FALSE (`d` 15 1 2026) EQUALS `by` (`d` 15 3 2026)
#ASSERT `By when must my lump sum or damages claim be decided` (`d` 15 1 2026) TRUE TRUE (`d` 1 3 2026) EQUALS `by` (`d` 1 4 2026)
#ASSERT `By when must my lump sum or damages claim be decided` (`d` 15 1 2026) TRUE TRUE (`d` 10 1 2026) EQUALS `by` (`d` 15 3 2026)
#ASSERT `By when must my lump sum or damages claim be decided` (`d` 15 1 2026) TRUE FALSE (`d` 15 1 2026) EQUALS `one month after my impairment becomes fully ascertainable, and not before two months after my particulars` (`d` 15 3 2026)
-- Without the insurer's notice, a later "fully ascertainable" day does not delay the 2 months.
#ASSERT `By when must my lump sum or damages claim be decided` (`d` 15 1 2026) FALSE TRUE (`d` 1 3 2026) EQUALS `by` (`d` 15 3 2026)
#ASSERT `By when must my lump sum or damages claim be decided` (`d` 31 12 2025) FALSE FALSE (`d` 31 12 2025) EQUALS `by` (`d` 28 2 2026)

-- s 282(3): particulars 1 March 2026; a request on 15 March is within 2 weeks, on 16 March is not.
#ASSERT `May the insurer delay for insufficient particulars` (`d` 1 3 2026) TRUE (`d` 15 3 2026) EQUALS NOTHING
#ASSERT `May the insurer delay for insufficient particulars` (`d` 1 3 2026) TRUE (`d` 16 3 2026) EQUALS JUST FALSE
#ASSERT `May the insurer delay for insufficient particulars` (`d` 1 3 2026) FALSE (`d` 1 3 2026) EQUALS JUST FALSE

§§ `ss 80, 84 -- notice before payments stop or go down`

-- Payments since 1 January 2026. 25 March is 83 days on (under 12 weeks); 26 March is 84 (12 weeks); 1 January 2027 is
-- 1 year.
-- Arguments: run began, notice day, work capacity decision, step-down only.
#ASSERT `How much notice must I get before my payments stop` (`d` 1 1 2026) (`d` 25 3 2026) FALSE FALSE EQUALS `no required period, as I have had weekly payments for less than 12 weeks in a row`
#ASSERT `How much notice must I get before my payments stop` (`d` 1 1 2026) (`d` 26 3 2026) FALSE FALSE EQUALS `2 weeks`
#ASSERT `How much notice must I get before my payments stop` (`d` 1 1 2026) (`d` 26 3 2026) TRUE FALSE EQUALS `3 months`
#ASSERT `How much notice must I get before my payments stop` (`d` 1 1 2026) (`d` 26 3 2026) TRUE TRUE EQUALS `notice before the higher-rate period ends, but no required period`
#ASSERT `How much notice must I get before my payments stop` (`d` 1 1 2026) (`d` 31 12 2026) FALSE FALSE EQUALS `2 weeks`
#ASSERT `How much notice must I get before my payments stop` (`d` 1 1 2026) (`d` 1 1 2027) FALSE FALSE EQUALS `6 weeks`

#ASSERT `From when may my payments be stopped` (`d` 1 1 2026) (`d` 26 3 2026) FALSE FALSE EQUALS JUST (`d` 9 4 2026)
#ASSERT `From when may my payments be stopped` (`d` 1 1 2026) (`d` 26 3 2026) TRUE FALSE EQUALS JUST (`d` 26 6 2026)
#ASSERT `From when may my payments be stopped` (`d` 1 1 2026) (`d` 1 1 2027) FALSE FALSE EQUALS JUST (`d` 12 2 2027)
#ASSERT `From when may my payments be stopped` (`d` 1 1 2026) (`d` 25 3 2026) FALSE FALSE EQUALS NOTHING
#ASSERT `From when may my payments be stopped` (`d` 1 1 2026) (`d` 26 3 2026) FALSE TRUE EQUALS NOTHING

-- s 84. Arguments: run began, notice given, notice day, day stopped or cut, work capacity decision, step-down only,
-- weekly payment before, after.
-- Notice 26 March 2026 (2 weeks, to 9 April), stopped 2 April: 7 days short, $700 a week: $700.
#ASSERT `What can I recover for short notice` (`d` 1 1 2026) TRUE (`d` 26 3 2026) (`d` 2 4 2026) FALSE FALSE 700 0 EQUALS 700
#ASSERT `What can I recover for short notice` (`d` 1 1 2026) TRUE (`d` 26 3 2026) (`d` 9 4 2026) FALSE FALSE 700 0 EQUALS 0
-- No notice, stopped 26 March 2026 after 12 weeks: the whole 2 weeks, $1,400.
#ASSERT `What can I recover for short notice` (`d` 1 1 2026) FALSE (`d` 1 1 2026) (`d` 26 3 2026) FALSE FALSE 700 0 EQUALS 1400
-- No notice of a work capacity reduction from $700 to $400 on 1 April 2026: 3 months to 1 July, 91 days, 13 weeks of $300: $3,900.
#ASSERT `What can I recover for short notice` (`d` 1 1 2026) FALSE (`d` 1 1 2026) (`d` 1 4 2026) TRUE FALSE 700 400 EQUALS 3900
-- Under 12 weeks of payments: s 80 does not apply, so nothing under s 84.
#ASSERT `What can I recover for short notice` (`d` 1 1 2026) FALSE (`d` 1 1 2026) (`d` 1 3 2026) FALSE FALSE 700 0 EQUALS 0
-- After a year: notice 1 January 2027 (6 weeks, to 12 February), cut from $1,000 to $800 on 15 January: 28 days short, $800.
#ASSERT `What can I recover for short notice` (`d` 1 1 2026) TRUE (`d` 1 1 2027) (`d` 15 1 2027) FALSE FALSE 1000 800 EQUALS 800
