#ASSERT `Must my employer give me suitable work` TRUE TRUE TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Must my employer give me suitable work` TRUE TRUE TRUE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
