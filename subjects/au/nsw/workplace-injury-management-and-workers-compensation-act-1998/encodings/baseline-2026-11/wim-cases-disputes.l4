IMPORT prelude
IMPORT `wim-dates`
IMPORT `wim-claims`
IMPORT `wim-disputes`

-- Workplace Injury Management and Workers Compensation Act 1998 (NSW) -- worked cases for the dispute and damages
-- questions (wim-disputes.l4). Every expected value was worked by hand from the deposited text (and clause 42 of the
-- Workers Compensation Regulation 2016); none was copied from the encoding's output. Each assertion is a claim about the
-- ENCODING on stated facts, not about the law. The facts are illustrative.
-- BASELINE ENCODING. Not for public use as advice. See NOTES.md.

§ `cases`

`d` MEANS `the calendar date`

§§ `s 287A -- internal review`

-- Arguments: work capacity decision disputed, claim disputed by the insurer, already referred to the Commission.
#ASSERT `May I ask for an internal review` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `May I ask for an internal review` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `May I ask for an internal review` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `May I ask for an internal review` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `By when must I get the review decision` (`d` 1 3 2026) EQUALS `d` 15 3 2026

§§ `ss 288-289A -- referring a dispute`

-- Arguments: kind, wholly disputed, partly disputed, not decided in time, offer made, day of offer, day of claim, today,
-- only notified matters, interests of justice.
#ASSERT `May I refer my dispute to the Commission` `weekly payments` FALSE TRUE FALSE FALSE (`d` 1 1 2026) (`d` 1 1 2026) (`d` 1 3 2026) TRUE FALSE EQUALS JUST TRUE
#ASSERT `May I refer my dispute to the Commission` `weekly payments` FALSE FALSE FALSE FALSE (`d` 1 1 2026) (`d` 1 1 2026) (`d` 1 3 2026) TRUE FALSE EQUALS JUST FALSE
-- A failure to decide, with no notice of dispute: s 289A not applied (fork F9).
#ASSERT `May I refer my dispute to the Commission` `weekly payments` FALSE FALSE TRUE FALSE (`d` 1 1 2026) (`d` 1 1 2026) (`d` 1 3 2026) FALSE FALSE EQUALS JUST TRUE
#ASSERT `May I refer my dispute to the Commission` `weekly payments` TRUE FALSE FALSE FALSE (`d` 1 1 2026) (`d` 1 1 2026) (`d` 1 3 2026) FALSE FALSE EQUALS JUST FALSE
#ASSERT `May I refer my dispute to the Commission` `weekly payments` TRUE FALSE FALSE FALSE (`d` 1 1 2026) (`d` 1 1 2026) (`d` 1 3 2026) FALSE TRUE EQUALS JUST TRUE
#ASSERT `May I refer my dispute to the Commission` `weekly payments, on a work capacity decision` FALSE FALSE FALSE FALSE (`d` 1 1 2026) (`d` 1 1 2026) (`d` 1 3 2026) TRUE FALSE EQUALS JUST TRUE
#ASSERT `May I refer my dispute to the Commission` `medical expenses` FALSE FALSE FALSE FALSE (`d` 1 1 2026) (`d` 1 1 2026) (`d` 1 3 2026) TRUE FALSE EQUALS JUST FALSE
#ASSERT `May I refer my dispute to the Commission` `whether proposed treatment is reasonably necessary` FALSE FALSE FALSE FALSE (`d` 1 1 2026) (`d` 1 1 2026) (`d` 1 3 2026) TRUE FALSE EQUALS JUST TRUE
-- Lump sum: a part dispute is not a route; an offer opens it 1 month later (offer 15 January, so 15 February).
#ASSERT `May I refer my dispute to the Commission` `lump sum compensation` FALSE TRUE FALSE FALSE (`d` 1 1 2026) (`d` 1 1 2026) (`d` 1 3 2026) TRUE FALSE EQUALS JUST FALSE
#ASSERT `May I refer my dispute to the Commission` `lump sum compensation` FALSE FALSE FALSE TRUE (`d` 15 1 2026) (`d` 1 1 2026) (`d` 15 2 2026) TRUE FALSE EQUALS JUST TRUE
#ASSERT `May I refer my dispute to the Commission` `lump sum compensation` FALSE FALSE FALSE TRUE (`d` 15 1 2026) (`d` 1 1 2026) (`d` 14 2 2026) TRUE FALSE EQUALS JUST FALSE
#ASSERT `May I refer my dispute to the Commission` `lump sum compensation` TRUE FALSE FALSE FALSE (`d` 1 1 2026) (`d` 1 1 2026) (`d` 1 3 2026) TRUE FALSE EQUALS JUST TRUE
-- Property damage: claim 1 March 2026, so 28 days is 29 March.
#ASSERT `May I refer my dispute to the Commission` `property damage` FALSE FALSE FALSE FALSE (`d` 1 1 2026) (`d` 1 3 2026) (`d` 29 3 2026) TRUE FALSE EQUALS JUST TRUE
#ASSERT `May I refer my dispute to the Commission` `property damage` FALSE FALSE FALSE FALSE (`d` 1 1 2026) (`d` 1 3 2026) (`d` 28 3 2026) TRUE FALSE EQUALS JUST FALSE

§§ `s 289B -- stay of a work capacity decision`

-- Payments since 1 January 2026; notice 1 April 2026 (90 days on): 3 months, expiring 1 July 2026.
#ASSERT `Will my referral stay the work capacity decision` (`d` 1 1 2026) (`d` 1 4 2026) (`d` 30 6 2026) EQUALS JUST TRUE
#ASSERT `Will my referral stay the work capacity decision` (`d` 1 1 2026) (`d` 1 4 2026) (`d` 1 7 2026) EQUALS JUST FALSE
#ASSERT `Will my referral stay the work capacity decision` (`d` 1 1 2026) (`d` 25 3 2026) (`d` 30 3 2026) EQUALS NOTHING

§§ `ss 297-304 -- interim payment directions`

-- Arguments: minimal prospects, returned to work, not reported under s 44, insufficient medical evidence, s 78 notice.
#ASSERT `Is an interim payment direction presumed warranted` FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Is an interim payment direction presumed warranted` FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Is an interim payment direction presumed warranted` FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Is an interim payment direction presumed warranted` TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Is a medical interim payment direction presumed warranted` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Is a medical interim payment direction presumed warranted` FALSE TRUE EQUALS JUST FALSE
#ASSERT `Is a medical interim payment direction presumed warranted` TRUE FALSE EQUALS JUST FALSE
#ASSERT `The most a medical interim payment direction can give` FALSE EQUALS JUST 7500
#ASSERT `The most a medical interim payment direction can give` TRUE EQUALS NOTHING
-- Direction 1 June 2026: back to 23 March is 70 days (allowed), 22 March 71 (not); 23 March to 14 June is 84 days
-- inclusive (12 weeks).
#ASSERT `Can an interim payment direction cover this period` (`d` 1 6 2026) (`d` 23 3 2026) (`d` 14 6 2026) EQUALS JUST TRUE
#ASSERT `Can an interim payment direction cover this period` (`d` 1 6 2026) (`d` 22 3 2026) (`d` 1 6 2026) EQUALS JUST FALSE
-- Forward only: 1 June to 23 August is 84 days inclusive; to 24 August 85.
#ASSERT `Can an interim payment direction cover this period` (`d` 1 6 2026) (`d` 1 6 2026) (`d` 23 8 2026) EQUALS JUST TRUE
#ASSERT `Can an interim payment direction cover this period` (`d` 1 6 2026) (`d` 1 6 2026) (`d` 24 8 2026) EQUALS JUST FALSE
#ASSERT `Must I refund interim payments` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Must I refund interim payments` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Must I refund interim payments` FALSE TRUE EQUALS JUST FALSE

§§ `s 308 -- the President's recommendation`

-- Recommendation 1 March 2026: 14 days run to 15 March; 21 days to 22 March; a shorter "allowance" does not cut the 14.
#ASSERT `Do I lose weekly payments for ignoring a recommendation` (`d` 1 3 2026) 14 FALSE FALSE (`d` 15 3 2026) EQUALS JUST FALSE
#ASSERT `Do I lose weekly payments for ignoring a recommendation` (`d` 1 3 2026) 14 FALSE FALSE (`d` 16 3 2026) EQUALS JUST TRUE
#ASSERT `Do I lose weekly payments for ignoring a recommendation` (`d` 1 3 2026) 14 TRUE FALSE (`d` 16 3 2026) EQUALS JUST FALSE
#ASSERT `Do I lose weekly payments for ignoring a recommendation` (`d` 1 3 2026) 14 FALSE TRUE (`d` 16 3 2026) EQUALS JUST FALSE
#ASSERT `Do I lose weekly payments for ignoring a recommendation` (`d` 1 3 2026) 21 FALSE FALSE (`d` 22 3 2026) EQUALS JUST FALSE
#ASSERT `Do I lose weekly payments for ignoring a recommendation` (`d` 1 3 2026) 21 FALSE FALSE (`d` 23 3 2026) EQUALS JUST TRUE
#ASSERT `Do I lose weekly payments for ignoring a recommendation` (`d` 1 3 2026) 10 FALSE FALSE (`d` 15 3 2026) EQUALS JUST FALSE

§§ `Part 7 -- medical assessment`

#ASSERT `Can my impairment be assessed` FALSE FALSE EQUALS JUST TRUE
#ASSERT `Can my impairment be assessed` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Can my impairment be assessed` FALSE TRUE EQUALS JUST FALSE
-- s 323: the note's own example, 30% with the 10% assumption, is 27%.
#ASSERT `My impairment after the s 323 deduction` 30 0 TRUE FALSE EQUALS 27
#ASSERT `My impairment after the s 323 deduction` 30 20 FALSE FALSE EQUALS 24
#ASSERT `My impairment after the s 323 deduction` 30 20 TRUE TRUE EQUALS 24
#ASSERT `My impairment after the s 323 deduction` 25 0 FALSE FALSE EQUALS 25

-- s 327. Arguments: deterioration, new information, incorrect criteria, demonstrable error, day of assessment, day of
-- appeal, special circumstances, already determined or registered. Assessment 1 March 2026: 28 days to 29 March.
#ASSERT `May I appeal the medical assessment` FALSE FALSE TRUE FALSE (`d` 1 3 2026) (`d` 29 3 2026) FALSE FALSE EQUALS JUST TRUE
#ASSERT `May I appeal the medical assessment` FALSE FALSE TRUE FALSE (`d` 1 3 2026) (`d` 30 3 2026) FALSE FALSE EQUALS JUST FALSE
#ASSERT `May I appeal the medical assessment` FALSE FALSE FALSE TRUE (`d` 1 3 2026) (`d` 30 3 2026) TRUE FALSE EQUALS JUST TRUE
#ASSERT `May I appeal the medical assessment` TRUE FALSE FALSE FALSE (`d` 1 3 2026) (`d` 1 3 2027) FALSE FALSE EQUALS JUST TRUE
#ASSERT `May I appeal the medical assessment` FALSE TRUE FALSE FALSE (`d` 1 3 2026) (`d` 1 3 2027) FALSE FALSE EQUALS JUST TRUE
#ASSERT `May I appeal the medical assessment` TRUE FALSE FALSE FALSE (`d` 1 3 2026) (`d` 2 3 2026) FALSE TRUE EQUALS JUST FALSE
#ASSERT `May I appeal the medical assessment` FALSE FALSE FALSE FALSE (`d` 1 3 2026) (`d` 2 3 2026) FALSE FALSE EQUALS JUST FALSE
#ASSERT `By when must I appeal the medical assessment` (`d` 1 3 2026) EQUALS `d` 29 3 2026

-- s 330: wages $500, own travel $120, escort $80.
#ASSERT `What can I recover for attending a medical assessment` 500 120 80 TRUE EQUALS 700
#ASSERT `What can I recover for attending a medical assessment` 500 120 80 FALSE EQUALS 620

§§ `s 352 -- appeal to a presidential member`

-- Arguments: at issue, awarded, interlocutory, leave, day of decision, day of appeal, longer period allowed.
-- $5,000 at issue against $25,000 awarded is exactly 20%; against $25,001 it is under 20%.
#ASSERT `May I appeal the Commission decision` 5000 25000 FALSE FALSE (`d` 1 3 2026) (`d` 29 3 2026) FALSE EQUALS JUST TRUE
#ASSERT `May I appeal the Commission decision` 5000 25001 FALSE FALSE (`d` 1 3 2026) (`d` 29 3 2026) FALSE EQUALS JUST FALSE
#ASSERT `May I appeal the Commission decision` 4999 0 FALSE FALSE (`d` 1 3 2026) (`d` 29 3 2026) FALSE EQUALS JUST FALSE
#ASSERT `May I appeal the Commission decision` 6000 0 FALSE FALSE (`d` 1 3 2026) (`d` 30 3 2026) FALSE EQUALS JUST FALSE
#ASSERT `May I appeal the Commission decision` 6000 0 FALSE FALSE (`d` 1 3 2026) (`d` 30 3 2026) TRUE EQUALS JUST TRUE
#ASSERT `May I appeal the Commission decision` 6000 0 TRUE FALSE (`d` 1 3 2026) (`d` 2 3 2026) FALSE EQUALS JUST FALSE
#ASSERT `May I appeal the Commission decision` 6000 0 TRUE TRUE (`d` 1 3 2026) (`d` 2 3 2026) FALSE EQUALS JUST TRUE

