IMPORT prelude
IMPORT `ucpr-time`
IMPORT `ucpr-proceedings`

-- Uniform Civil Procedure Rules 2005 (NSW) -- worked cases for every exported question in ucpr-time.l4 and
-- ucpr-proceedings.l4. Every expected value was worked by hand from the deposited text (with a calendar for the days of
-- the week); none was copied from the encoding's output. Each assertion is a claim about the ENCODING on stated facts,
-- not about the law. Holidays used are illustrative.
-- BASELINE ENCODING. Not for public use as advice. See NOTES.md.

§ `cases -- time and proceedings`

`d` MEANS `the date`

-- Registry closures: weekends closed, no other days; weekends open; Easter 2025 (Good Friday 18 April, Easter Monday 21 April).
`no holidays` MEANS LIST `d` 1 1 1900
`Easter 2025` MEANS LIST `d` 18 4 2025, `d` 21 4 2025
`22 Sep holiday` MEANS LIST `d` 22 9 2025

`SC` MEANS `the Supreme Court`
`DC` MEANS `the District Court`
`LC` MEANS `the Local Court`
`LEC` MEANS `the Land and Environment Court`
`DDT` MEANS `the Dust Diseases Tribunal`

§§ `r 1.11 -- reckoning of time`

-- Arguments: given day, days, weekends closed, other closed days.
-- 28 days after Monday 3 March 2025: 31 March (Monday).
#ASSERT `What is my last day` (`d` 3 3 2025) 28 TRUE `no holidays` EQUALS `d` 31 3 2025
-- 28 days after Saturday 1 March: 29 March is a Saturday, so Monday 31 March (r 1.11(4)); with weekends open, 29 March.
#ASSERT `What is my last day` (`d` 1 3 2025) 28 TRUE `no holidays` EQUALS `d` 31 3 2025
#ASSERT `What is my last day` (`d` 1 3 2025) 28 FALSE `no holidays` EQUALS `d` 29 3 2025
-- 21 days after Friday 28 March: Good Friday 18 April; Saturday, Sunday, Easter Monday closed: Tuesday 22 April.
#ASSERT `What is my last day` (`d` 28 3 2025) 21 TRUE `Easter 2025` EQUALS `d` 22 4 2025
-- r 1.11(3): 5 days after Thursday 6 March counts open days only (Fri 7, Mon 10, Tue 11, Wed 12, Thu 13): 13 March; with
-- weekends open, 11 March. A 6-day period counts every day: 12 March, a day before the 5-day period ends (finding 2).
#ASSERT `What is my last day` (`d` 6 3 2025) 5 TRUE `no holidays` EQUALS `d` 13 3 2025
#ASSERT `What is my last day` (`d` 6 3 2025) 5 FALSE `no holidays` EQUALS `d` 11 3 2025
#ASSERT `What is my last day` (`d` 6 3 2025) 6 TRUE `no holidays` EQUALS `d` 12 3 2025
-- 1 day after Friday 7 March: Monday 10 March.
#ASSERT `What is my last day` (`d` 7 3 2025) 1 TRUE `no holidays` EQUALS `d` 10 3 2025

§§ `r 6.2 -- service of originating process`

-- Arguments: court, statement of claim only for a liquidated claim, defendant outside NSW, filed, extended, extended day,
-- weekends closed, other closed days.
-- Supreme Court, filed Friday 10 January 2025: 6 months, to Thursday 10 July 2025.
#ASSERT `Until when can I serve my originating process` `SC` FALSE FALSE (`d` 10 1 2025) FALSE (`d` 1 1 2000) TRUE `no holidays` EQUALS `d` 10 7 2025
#ASSERT `Until when can I serve my originating process` `LC` FALSE FALSE (`d` 10 1 2025) FALSE (`d` 1 1 2000) TRUE `no holidays` EQUALS `d` 10 7 2025
#ASSERT `Until when can I serve my originating process` `DDT` FALSE FALSE (`d` 10 1 2025) FALSE (`d` 1 1 2000) TRUE `no holidays` EQUALS `d` 10 7 2025
-- District Court: one month in general (Monday 10 February), 6 months for a liquidated-only statement of claim or a
-- defendant outside NSW.
#ASSERT `Until when can I serve my originating process` `DC` FALSE FALSE (`d` 10 1 2025) FALSE (`d` 1 1 2000) TRUE `no holidays` EQUALS `d` 10 2 2025
#ASSERT `Until when can I serve my originating process` `DC` TRUE FALSE (`d` 10 1 2025) FALSE (`d` 1 1 2000) TRUE `no holidays` EQUALS `d` 10 7 2025
#ASSERT `Until when can I serve my originating process` `DC` FALSE TRUE (`d` 10 1 2025) FALSE (`d` 1 1 2000) TRUE `no holidays` EQUALS `d` 10 7 2025
-- Month ends (fork F2): filed 31 January 2025, one month: 28 February 2025; filed 31 August 2023, 6 months: 29 February 2024.
#ASSERT `Until when can I serve my originating process` `DC` FALSE FALSE (`d` 31 1 2025) FALSE (`d` 1 1 2000) TRUE `no holidays` EQUALS `d` 28 2 2025
#ASSERT `Until when can I serve my originating process` `SC` FALSE FALSE (`d` 31 8 2023) FALSE (`d` 1 1 2000) TRUE `no holidays` EQUALS `d` 29 2 2024
-- Filed Monday 13 January 2025: 13 July 2025 is a Sunday, so Monday 14 July (r 1.11(4), fork F4).
#ASSERT `Until when can I serve my originating process` `SC` FALSE FALSE (`d` 13 1 2025) FALSE (`d` 1 1 2000) TRUE `no holidays` EQUALS `d` 14 7 2025
-- An order extending the time (r 1.12).
#ASSERT `Until when can I serve my originating process` `DC` FALSE FALSE (`d` 10 1 2025) TRUE (`d` 1 9 2025) TRUE `no holidays` EQUALS `d` 1 9 2025

-- Arguments as above, then served, day served, today.
-- Served on the last day, 10 July: valid.
#ASSERT `Was my originating process served in time` `SC` FALSE FALSE (`d` 10 1 2025) FALSE (`d` 1 1 2000) TRUE `no holidays` TRUE (`d` 10 7 2025) (`d` 20 7 2025) EQUALS `served while it was valid for service`
-- Served the day after, 11 July: lapsed; fresh proceedings may be started (r 6.2(5)).
#ASSERT `Was my originating process served in time` `SC` FALSE FALSE (`d` 10 1 2025) FALSE (`d` 1 1 2000) TRUE `no holidays` TRUE (`d` 11 7 2025) (`d` 20 7 2025) EQUALS `no longer valid for service, but I may start fresh proceedings by filing another originating process`
-- Not served: on 1 July and on the last day still valid; on 11 July lapsed.
#ASSERT `Was my originating process served in time` `SC` FALSE FALSE (`d` 10 1 2025) FALSE (`d` 1 1 2000) TRUE `no holidays` FALSE (`d` 1 1 2000) (`d` 1 7 2025) EQUALS `not yet served, and still valid for service`
#ASSERT `Was my originating process served in time` `SC` FALSE FALSE (`d` 10 1 2025) FALSE (`d` 1 1 2000) TRUE `no holidays` FALSE (`d` 1 1 2000) (`d` 10 7 2025) EQUALS `not yet served, and still valid for service`
#ASSERT `Was my originating process served in time` `SC` FALSE FALSE (`d` 10 1 2025) FALSE (`d` 1 1 2000) TRUE `no holidays` FALSE (`d` 1 1 2000) (`d` 11 7 2025) EQUALS `no longer valid for service, but I may start fresh proceedings by filing another originating process`
-- Served on Monday 14 July after a last day falling on Sunday 13 July: valid.
#ASSERT `Was my originating process served in time` `SC` FALSE FALSE (`d` 13 1 2025) FALSE (`d` 1 1 2000) TRUE `no holidays` TRUE (`d` 14 7 2025) (`d` 20 7 2025) EQUALS `served while it was valid for service`
-- District Court, one month from 10 January: served 11 February is too late.
#ASSERT `Was my originating process served in time` `DC` FALSE FALSE (`d` 10 1 2025) FALSE (`d` 1 1 2000) TRUE `no holidays` TRUE (`d` 11 2 2025) (`d` 20 2 2025) EQUALS `no longer valid for service, but I may start fresh proceedings by filing another originating process`

§§ `r 14.3, 16.2 -- the defence and default`

-- Arguments: served, court direction, directed day, weekends closed, other closed days.
#ASSERT `By when must the defendant file a defence` (`d` 3 3 2025) FALSE (`d` 1 1 2000) TRUE `no holidays` EQUALS `d` 31 3 2025
#ASSERT `By when must the defendant file a defence` (`d` 1 3 2025) FALSE (`d` 1 1 2000) TRUE `no holidays` EQUALS `d` 31 3 2025
#ASSERT `By when must the defendant file a defence` (`d` 3 3 2025) TRUE (`d` 30 4 2025) TRUE `no holidays` EQUALS `d` 30 4 2025

-- Arguments: by statement of claim, served, direction, directed day, weekends closed, other closed days, defence filed,
-- day filed, verifying affidavit missing, struck out, r 6.17 payment, r 20.34 acknowledgment, today.
-- Started by summons: Part 16 is silent (NOTHING).
#ASSERT `Is the defendant in default` FALSE (`d` 3 3 2025) FALSE (`d` 1 1 2000) TRUE `no holidays` FALSE (`d` 1 1 2000) FALSE FALSE FALSE FALSE (`d` 1 5 2025) EQUALS NOTHING
-- No defence: on the last day (31 March) not yet in default; the next day in default.
#ASSERT `Is the defendant in default` TRUE (`d` 3 3 2025) FALSE (`d` 1 1 2000) TRUE `no holidays` FALSE (`d` 1 1 2000) FALSE FALSE FALSE FALSE (`d` 31 3 2025) EQUALS JUST FALSE
#ASSERT `Is the defendant in default` TRUE (`d` 3 3 2025) FALSE (`d` 1 1 2000) TRUE `no holidays` FALSE (`d` 1 1 2000) FALSE FALSE FALSE FALSE (`d` 1 4 2025) EQUALS JUST TRUE
-- Defence filed on the last day: not in default.
#ASSERT `Is the defendant in default` TRUE (`d` 3 3 2025) FALSE (`d` 1 1 2000) TRUE `no holidays` TRUE (`d` 31 3 2025) FALSE FALSE FALSE FALSE (`d` 10 4 2025) EQUALS JUST FALSE
-- Defence filed late (2 April) but before any default judgment: not in default (r 16.2(2)(c)).
#ASSERT `Is the defendant in default` TRUE (`d` 3 3 2025) FALSE (`d` 1 1 2000) TRUE `no holidays` TRUE (`d` 2 4 2025) FALSE FALSE FALSE FALSE (`d` 10 4 2025) EQUALS JUST FALSE
-- A defence dated after "today" has not been filed yet: in default on 10 April.
#ASSERT `Is the defendant in default` TRUE (`d` 3 3 2025) FALSE (`d` 1 1 2000) TRUE `no holidays` TRUE (`d` 15 4 2025) FALSE FALSE FALSE FALSE (`d` 10 4 2025) EQUALS JUST TRUE
-- Paid under r 6.17, or acknowledged under r 20.34: never in default.
#ASSERT `Is the defendant in default` TRUE (`d` 3 3 2025) FALSE (`d` 1 1 2000) TRUE `no holidays` FALSE (`d` 1 1 2000) FALSE FALSE TRUE FALSE (`d` 10 4 2025) EQUALS JUST FALSE
#ASSERT `Is the defendant in default` TRUE (`d` 3 3 2025) FALSE (`d` 1 1 2000) TRUE `no holidays` FALSE (`d` 1 1 2000) FALSE FALSE FALSE TRUE (`d` 10 4 2025) EQUALS JUST FALSE
-- Defence struck out; defence filed in time without a required verifying affidavit: in default (r 16.2(1)(b), (c)).
#ASSERT `Is the defendant in default` TRUE (`d` 3 3 2025) FALSE (`d` 1 1 2000) TRUE `no holidays` TRUE (`d` 20 3 2025) FALSE TRUE FALSE FALSE (`d` 10 4 2025) EQUALS JUST TRUE
#ASSERT `Is the defendant in default` TRUE (`d` 3 3 2025) FALSE (`d` 1 1 2000) TRUE `no holidays` TRUE (`d` 20 3 2025) TRUE FALSE FALSE FALSE (`d` 10 4 2025) EQUALS JUST TRUE
-- Further time allowed to 30 April: not in default on 15 April, in default on 1 May.
#ASSERT `Is the defendant in default` TRUE (`d` 3 3 2025) TRUE (`d` 30 4 2025) TRUE `no holidays` FALSE (`d` 1 1 2000) FALSE FALSE FALSE FALSE (`d` 15 4 2025) EQUALS JUST FALSE
#ASSERT `Is the defendant in default` TRUE (`d` 3 3 2025) TRUE (`d` 30 4 2025) TRUE `no holidays` FALSE (`d` 1 1 2000) FALSE FALSE FALSE FALSE (`d` 1 5 2025) EQUALS JUST TRUE

§§ `r 16.3(4), 16.4-16.10 -- default judgment`

-- Arguments: sworn, filed, court ordered otherwise. Filed 20 March 2025: sworn 6 March (14 days before) is valid; 5 March
-- is not; sworn on the filing day is valid (fork F5); sworn after filing is not.
#ASSERT `Is my affidavit in support recent enough` (`d` 6 3 2025) (`d` 20 3 2025) FALSE EQUALS JUST TRUE
#ASSERT `Is my affidavit in support recent enough` (`d` 5 3 2025) (`d` 20 3 2025) FALSE EQUALS JUST FALSE
#ASSERT `Is my affidavit in support recent enough` (`d` 20 3 2025) (`d` 20 3 2025) FALSE EQUALS JUST TRUE
#ASSERT `Is my affidavit in support recent enough` (`d` 21 3 2025) (`d` 20 3 2025) FALSE EQUALS JUST FALSE
#ASSERT `Is my affidavit in support recent enough` (`d` 1 1 2025) (`d` 20 3 2025) TRUE EQUALS JUST TRUE

#ASSERT `What default judgment can I ask for` `possession of land only` EQUALS `judgment for possession of the land, and costs`
#ASSERT `What default judgment can I ask for` `detention of goods only` EQUALS `judgment for delivery of the goods or for their value, at my option, and costs`
#ASSERT `What default judgment can I ask for` `a debt or other liquidated claim` EQUALS `judgment for a sum not exceeding the sum claimed, interest up to judgment, and costs`
#ASSERT `What default judgment can I ask for` `unliquidated damages only` EQUALS `judgment for damages to be assessed, and costs`
#ASSERT `What default judgment can I ask for` `two or more of those claims and nothing else` EQUALS `judgment on any of those claims as if it were my only claim`
#ASSERT `What default judgment can I ask for` `something else` EQUALS `such judgment as I appear to be entitled to on my statement of claim`

§§ `r 14.4 -- reply`

#ASSERT `May I file a reply` `SC` FALSE EQUALS JUST TRUE
#ASSERT `May I file a reply` `DC` FALSE EQUALS JUST TRUE
#ASSERT `May I file a reply` `LC` FALSE EQUALS JUST FALSE
#ASSERT `May I file a reply` `LC` TRUE EQUALS JUST TRUE
#ASSERT `May I file a reply` `DDT` TRUE EQUALS NOTHING

-- 14 days after Friday 7 March: Friday 21 March. After Saturday 1 March: 15 March is a Saturday, so Monday 17 March.
#ASSERT `By when must I file my reply` (`d` 7 3 2025) TRUE `no holidays` EQUALS `d` 21 3 2025
#ASSERT `By when must I file my reply` (`d` 1 3 2025) TRUE `no holidays` EQUALS `d` 17 3 2025

§§ `r 15.12-15.17 -- particulars`

-- Arguments: personal injury, Compensation to Relatives Act, separate-trial motion, deferral motion.
#ASSERT `Must I serve a statement of particulars` TRUE FALSE FALSE FALSE EQUALS `yes: the rule 15.12 statement of injuries, disabilities and expenses, with the documents`
#ASSERT `Must I serve a statement of particulars` FALSE TRUE FALSE FALSE EQUALS `yes: the rule 15.13 statement for each dependant, with the documents`
#ASSERT `Must I serve a statement of particulars` TRUE TRUE FALSE FALSE EQUALS `yes: the rule 15.13 statement for each dependant, with the documents`
#ASSERT `Must I serve a statement of particulars` TRUE FALSE TRUE FALSE EQUALS `no: Division 2 of Part 15 does not apply because a motion accompanies my claim`
#ASSERT `Must I serve a statement of particulars` TRUE FALSE FALSE TRUE EQUALS `no: Division 2 of Part 15 does not apply because a motion accompanies my claim`
#ASSERT `Must I serve a statement of particulars` FALSE FALSE FALSE FALSE EQUALS `these rules do not ask for one`

-- Hearing Monday 3 November 2025: 42 days before is Monday 22 September. With 22 September closed, Tuesday 23 September
-- (r 1.11(4) as worded, fork F3). An order fixing another day governs.
#ASSERT `By when must I file my final statement of particulars` (`d` 3 11 2025) FALSE (`d` 1 1 2000) TRUE `no holidays` EQUALS `d` 22 9 2025
#ASSERT `By when must I file my final statement of particulars` (`d` 3 11 2025) FALSE (`d` 1 1 2000) TRUE `22 Sep holiday` EQUALS `d` 23 9 2025
#ASSERT `By when must I file my final statement of particulars` (`d` 3 11 2025) TRUE (`d` 1 10 2025) TRUE `no holidays` EQUALS `d` 1 10 2025

§§ `r 23.1-23.3 -- medical examination expenses`

-- Arguments: condition relevant, party, notice served, request made.
#ASSERT `Must the defendant pay my medical examination expenses` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Must the defendant pay my medical examination expenses` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Must the defendant pay my medical examination expenses` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Must the defendant pay my medical examination expenses` FALSE TRUE TRUE TRUE EQUALS NOTHING

§§ `r 12.1, 12.3, 12.4, 42.19 -- discontinuance`

#ASSERT `Can I discontinue my proceedings` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Can I discontinue my proceedings` FALSE TRUE EQUALS JUST TRUE
#ASSERT `Can I discontinue my proceedings` FALSE FALSE EQUALS NOTHING

-- Arguments: court ordered otherwise, notice provides otherwise, s 91 appeal, special circumstances.
#ASSERT `Must I pay the defendant's costs if I discontinue` FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Must I pay the defendant's costs if I discontinue` TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `Must I pay the defendant's costs if I discontinue` FALSE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `Must I pay the defendant's costs if I discontinue` FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Must I pay the defendant's costs if I discontinue` FALSE FALSE TRUE TRUE EQUALS JUST TRUE

-- Arguments: terms prevent, unpaid costs, same cause of action.
#ASSERT `Can I claim the same relief again after discontinuing` FALSE FALSE FALSE EQUALS `yes`
#ASSERT `Can I claim the same relief again after discontinuing` FALSE TRUE TRUE EQUALS `yes, but the court may stay them until I pay the costs of the discontinued proceedings`
#ASSERT `Can I claim the same relief again after discontinuing` FALSE TRUE FALSE EQUALS `yes`
#ASSERT `Can I claim the same relief again after discontinuing` TRUE TRUE TRUE EQUALS `no: the terms of the consent or leave prevent it`

§§ `r 12.8, 12.9 -- dismissal for lack of progress`

-- Arguments: court, last step, Possession List, statement of claim filed, day filed, defence or cross-claim within 9
-- months, default judgment application within 9 months, otherwise disposed of, listed for a future date, motion
-- pending, a party satisfies the court, weekends closed, other closed days, today.
-- Supreme Court, last step 10 January 2025: on 10 June (exactly 5 months) not "over 5 months"; on 11 June it is.
#ASSERT `Can the court dismiss my proceedings for lack of progress` `SC` (`d` 10 1 2025) FALSE FALSE (`d` 1 1 2000) FALSE FALSE FALSE FALSE FALSE FALSE TRUE `no holidays` (`d` 10 6 2025) EQUALS `no, rules 12.8 and 12.9 do not allow it on these facts`
#ASSERT `Can the court dismiss my proceedings for lack of progress` `SC` (`d` 10 1 2025) FALSE FALSE (`d` 1 1 2000) FALSE FALSE FALSE FALSE FALSE FALSE TRUE `no holidays` (`d` 11 6 2025) EQUALS `yes, after notice to me and a reasonable opportunity to be heard`
#ASSERT `Can the court dismiss my proceedings for lack of progress` `LEC` (`d` 10 1 2025) FALSE FALSE (`d` 1 1 2000) FALSE FALSE FALSE FALSE FALSE FALSE TRUE `no holidays` (`d` 11 6 2025) EQUALS `yes, after notice to me and a reasonable opportunity to be heard`
-- r 12.8(3): listed for a future date, a pending motion, a party satisfying the court: no.
#ASSERT `Can the court dismiss my proceedings for lack of progress` `SC` (`d` 10 1 2025) FALSE FALSE (`d` 1 1 2000) FALSE FALSE FALSE TRUE FALSE FALSE TRUE `no holidays` (`d` 11 6 2025) EQUALS `no, rules 12.8 and 12.9 do not allow it on these facts`
#ASSERT `Can the court dismiss my proceedings for lack of progress` `SC` (`d` 10 1 2025) FALSE FALSE (`d` 1 1 2000) FALSE FALSE FALSE FALSE TRUE FALSE TRUE `no holidays` (`d` 11 6 2025) EQUALS `no, rules 12.8 and 12.9 do not allow it on these facts`
#ASSERT `Can the court dismiss my proceedings for lack of progress` `SC` (`d` 10 1 2025) FALSE FALSE (`d` 1 1 2000) FALSE FALSE FALSE FALSE FALSE TRUE TRUE `no holidays` (`d` 11 6 2025) EQUALS `no, rules 12.8 and 12.9 do not allow it on these facts`
-- Possession List: over 9 months (11 October) without notice; at exactly 9 months (10 October) the 5-month rule with notice.
#ASSERT `Can the court dismiss my proceedings for lack of progress` `SC` (`d` 10 1 2025) TRUE FALSE (`d` 1 1 2000) FALSE FALSE FALSE FALSE FALSE FALSE TRUE `no holidays` (`d` 11 10 2025) EQUALS `yes, without notice, because the proceedings are in the Possession List and no step has been taken for over 9 months`
#ASSERT `Can the court dismiss my proceedings for lack of progress` `SC` (`d` 10 1 2025) TRUE FALSE (`d` 1 1 2000) FALSE FALSE FALSE FALSE FALSE FALSE TRUE `no holidays` (`d` 10 10 2025) EQUALS `yes, after notice to me and a reasonable opportunity to be heard`
-- District Court, statement of claim filed Friday 10 January 2025: 9 months end Friday 10 October; dismissal possible from 11 October.
#ASSERT `Can the court dismiss my proceedings for lack of progress` `DC` (`d` 1 1 2000) FALSE TRUE (`d` 10 1 2025) FALSE FALSE FALSE FALSE FALSE FALSE TRUE `no holidays` (`d` 10 10 2025) EQUALS `no, rules 12.8 and 12.9 do not allow it on these facts`
#ASSERT `Can the court dismiss my proceedings for lack of progress` `DC` (`d` 1 1 2000) FALSE TRUE (`d` 10 1 2025) FALSE FALSE FALSE FALSE FALSE FALSE TRUE `no holidays` (`d` 11 10 2025) EQUALS `yes, without notice to me`
#ASSERT `Can the court dismiss my proceedings for lack of progress` `LC` (`d` 1 1 2000) FALSE TRUE (`d` 10 1 2025) FALSE FALSE FALSE FALSE FALSE FALSE TRUE `no holidays` (`d` 11 10 2025) EQUALS `yes, without notice to me`
-- A defence filed, a default judgment application filed, proceedings disposed of, or a pending motion: no (fork F9).
#ASSERT `Can the court dismiss my proceedings for lack of progress` `DC` (`d` 1 1 2000) FALSE TRUE (`d` 10 1 2025) TRUE FALSE FALSE FALSE FALSE FALSE TRUE `no holidays` (`d` 11 10 2025) EQUALS `no, rules 12.8 and 12.9 do not allow it on these facts`
#ASSERT `Can the court dismiss my proceedings for lack of progress` `DC` (`d` 1 1 2000) FALSE TRUE (`d` 10 1 2025) FALSE TRUE FALSE FALSE FALSE FALSE TRUE `no holidays` (`d` 11 10 2025) EQUALS `no, rules 12.8 and 12.9 do not allow it on these facts`
#ASSERT `Can the court dismiss my proceedings for lack of progress` `DC` (`d` 1 1 2000) FALSE TRUE (`d` 10 1 2025) FALSE FALSE TRUE FALSE FALSE FALSE TRUE `no holidays` (`d` 11 10 2025) EQUALS `no, rules 12.8 and 12.9 do not allow it on these facts`
#ASSERT `Can the court dismiss my proceedings for lack of progress` `DC` (`d` 1 1 2000) FALSE TRUE (`d` 10 1 2025) FALSE FALSE FALSE FALSE TRUE FALSE TRUE `no holidays` (`d` 11 10 2025) EQUALS `no, rules 12.8 and 12.9 do not allow it on these facts`
-- Filed Sunday 12 January 2025: 12 October is a Sunday, so the 9 months end Monday 13 October; dismissal from 14 October.
#ASSERT `Can the court dismiss my proceedings for lack of progress` `DC` (`d` 1 1 2000) FALSE TRUE (`d` 12 1 2025) FALSE FALSE FALSE FALSE FALSE FALSE TRUE `no holidays` (`d` 13 10 2025) EQUALS `no, rules 12.8 and 12.9 do not allow it on these facts`
#ASSERT `Can the court dismiss my proceedings for lack of progress` `DC` (`d` 1 1 2000) FALSE TRUE (`d` 12 1 2025) FALSE FALSE FALSE FALSE FALSE FALSE TRUE `no holidays` (`d` 14 10 2025) EQUALS `yes, without notice to me`
-- No statement of claim in the District Court; the Dust Diseases Tribunal: the rules do not deal with them.
#ASSERT `Can the court dismiss my proceedings for lack of progress` `DC` (`d` 1 1 2000) FALSE FALSE (`d` 10 1 2025) FALSE FALSE FALSE FALSE FALSE FALSE TRUE `no holidays` (`d` 11 10 2025) EQUALS `rules 12.8 and 12.9 do not deal with these proceedings`
#ASSERT `Can the court dismiss my proceedings for lack of progress` `DDT` (`d` 10 1 2025) FALSE TRUE (`d` 10 1 2025) FALSE FALSE FALSE FALSE FALSE FALSE TRUE `no holidays` (`d` 11 10 2025) EQUALS `rules 12.8 and 12.9 do not deal with these proceedings`
