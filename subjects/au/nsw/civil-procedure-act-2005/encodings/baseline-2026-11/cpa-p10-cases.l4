IMPORT prelude
IMPORT `cpa-p10`

-- Civil Procedure Act 2005 (NSW), Part 10 -- worked cases for every exported question in cpa-p10.l4.
-- Every expected value was worked by hand from the deposited text; none was copied from the encoding's output. Each
-- assertion is a claim about the ENCODING on stated facts, not about the law. Dates are illustrative.
-- BASELINE ENCODING. Not for public use as advice. See NOTES.md.

§ `cases`

`d` MEANS `the calendar date`

`individual` MEANS `an individual, company or other person not listed in section 159(2)`
`a State` MEANS `the Commonwealth, a State or a Territory`
`a Minister` MEANS `a Minister of the Commonwealth, a State or a Territory`
`a public body` MEANS `a body corporate established for a public purpose by law, other than an incorporated company or association`
`an officer` MEANS `an officer of the Commonwealth, a State or a Territory, acting in that capacity`

`member` MEANS `a group member`
`sub-group member` MEANS `a sub-group member`
`rep` MEANS `the representative party`
`sub-group rep` MEANS `a sub-group representative party`

§§ `ss 157, 158 -- starting a class action`

-- Arguments: number with claims against the same person; I have a claim myself; same/similar/related circumstances;
-- substantial common question.
#ASSERT `Can I start a class action` 7 TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Can I start a class action` 6 TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Can I start a class action` 100 TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Can I start a class action` 7 FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Can I start a class action` 7 TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Can I start a class action` 7 TRUE TRUE FALSE EQUALS JUST FALSE

§§ `ss 155, 159, 160 -- who is a group member`

-- Arguments: within the group described; kind of person; written consent.
#ASSERT `Am I a group member` FALSE `individual` FALSE EQUALS JUST FALSE
#ASSERT `Am I a group member` TRUE `individual` FALSE EQUALS JUST TRUE
#ASSERT `Am I a group member` TRUE `a State` FALSE EQUALS JUST FALSE
#ASSERT `Am I a group member` TRUE `a State` TRUE EQUALS JUST TRUE
#ASSERT `Am I a group member` TRUE `a Minister` FALSE EQUALS JUST FALSE
#ASSERT `Am I a group member` TRUE `a public body` TRUE EQUALS JUST TRUE
#ASSERT `Am I a group member` TRUE `an officer` FALSE EQUALS JUST FALSE
#ASSERT `Am I a group member` FALSE `a State` TRUE EQUALS JUST FALSE

#ASSERT `Do I need a tutor to be a group member` TRUE EQUALS JUST FALSE
#ASSERT `Do I need a tutor to be a group member` FALSE EQUALS NOTHING
#ASSERT `Can I take a step without my tutor` TRUE EQUALS JUST FALSE
#ASSERT `Can I take a step without my tutor` FALSE EQUALS NOTHING

§§ `s 162 -- opting out`

-- "before the date": the last day is the day before, across month and year ends and 29 February.
#ASSERT `The last day to opt out` (`d` 1 3 2027) EQUALS `d` 28 2 2027
#ASSERT `The last day to opt out` (`d` 1 3 2028) EQUALS `d` 29 2 2028
#ASSERT `The last day to opt out` (`d` 1 1 2027) EQUALS `d` 31 12 2026

-- Date fixed 15 June 2027.
#ASSERT `Have I opted out in time` (`d` 15 6 2027) TRUE (`d` 14 6 2027) EQUALS `I have opted out in time`
#ASSERT `Have I opted out in time` (`d` 15 6 2027) TRUE (`d` 15 6 2027) EQUALS `my notice was not given before the date fixed, so it does not opt me out`
#ASSERT `Have I opted out in time` (`d` 15 6 2027) TRUE (`d` 16 6 2027) EQUALS `my notice was not given before the date fixed, so it does not opt me out`
#ASSERT `Have I opted out in time` (`d` 15 6 2027) TRUE (`d` 2 1 2027) EQUALS `I have opted out in time`
#ASSERT `Have I opted out in time` (`d` 15 6 2027) FALSE (`d` 14 6 2027) EQUALS `only a written notice given under the local rules opts me out`

-- s 162(4): hearing against the opt-out date of 15 June 2027.
#ASSERT `Can the hearing start then` (`d` 15 6 2027) (`d` 14 6 2027) FALSE EQUALS JUST FALSE
#ASSERT `Can the hearing start then` (`d` 15 6 2027) (`d` 14 6 2027) TRUE EQUALS JUST TRUE
#ASSERT `Can the hearing start then` (`d` 15 6 2027) (`d` 15 6 2027) FALSE EQUALS JUST TRUE
#ASSERT `Can the hearing start then` (`d` 15 6 2027) (`d` 1 9 2027) FALSE EQUALS JUST TRUE

§§ `s 163 -- a later cause of action`

-- Class action started 1 February 2027; the Court fixes 1 July 2027.
#ASSERT `Can the group be widened to include me` (`d` 1 2 2027) (`d` 2 2 2027) (`d` 1 7 2027) TRUE TRUE EQUALS JUST TRUE
#ASSERT `Can the group be widened to include me` (`d` 1 2 2027) (`d` 30 6 2027) (`d` 1 7 2027) TRUE TRUE EQUALS JUST TRUE
#ASSERT `Can the group be widened to include me` (`d` 1 2 2027) (`d` 2 2 2027) (`d` 1 7 2027) TRUE FALSE EQUALS JUST FALSE
#ASSERT `Can the group be widened to include me` (`d` 1 2 2027) (`d` 1 2 2027) (`d` 1 7 2027) TRUE TRUE EQUALS NOTHING
#ASSERT `Can the group be widened to include me` (`d` 1 2 2027) (`d` 1 7 2027) (`d` 1 7 2027) TRUE TRUE EQUALS NOTHING
#ASSERT `Can the group be widened to include me` (`d` 1 2 2027) (`d` 2 2 2027) (`d` 1 7 2027) FALSE TRUE EQUALS NOTHING

§§ `ss 164-167 -- the class action ending as a class action`

-- Arguments: fewer than 7 likely; money relief; defendant's application and excessive distribution cost; s 166 ground.
#ASSERT `Could the class action be stopped` TRUE FALSE FALSE `no section 166 ground` EQUALS JUST TRUE
#ASSERT `Could the class action be stopped` FALSE TRUE TRUE `no section 166 ground` EQUALS JUST TRUE
#ASSERT `Could the class action be stopped` FALSE FALSE TRUE `no section 166 ground` EQUALS JUST FALSE
#ASSERT `Could the class action be stopped` FALSE TRUE FALSE `no section 166 ground` EQUALS JUST FALSE
#ASSERT `Could the class action be stopped` FALSE FALSE FALSE `continuing as a class action is likely to cost more than separate proceedings` EQUALS JUST TRUE
#ASSERT `Could the class action be stopped` FALSE FALSE FALSE `the representative party cannot adequately represent the group members` EQUALS JUST TRUE
#ASSERT `Could the class action be stopped` FALSE FALSE FALSE `it is otherwise inappropriate to pursue the claims by a class action` EQUALS JUST TRUE
#ASSERT `Could the class action be stopped` FALSE FALSE FALSE `only that the group does not include everyone, or was put together for a litigation funding arrangement` EQUALS JUST FALSE
#ASSERT `Could the class action be stopped` FALSE FALSE FALSE `no section 166 ground` EQUALS JUST FALSE

#ASSERT `What can I do after the class action ends` `rep` TRUE EQUALS `I may continue the proceedings on my own behalf against the defendant`
#ASSERT `What can I do after the class action ends` `member` TRUE EQUALS `I may apply to be joined as a plaintiff, and the Court may order it`
#ASSERT `What can I do after the class action ends` `sub-group rep` TRUE EQUALS `I may apply to be joined as a plaintiff, and the Court may order it`
#ASSERT `What can I do after the class action ends` `member` FALSE EQUALS `section 167 does not apply: no order under section 164, 165 or 166 has been made`
#ASSERT `What can I do after the class action ends` `rep` FALSE EQUALS `section 167 does not apply: no order under section 164, 165 or 166 has been made`

§§ `ss 169, 181 -- costs`

#ASSERT `Can I be made to pay costs` `member` FALSE EQUALS `no costs can be awarded against me`
#ASSERT `Can I be made to pay costs` `member` TRUE EQUALS `only the costs of determining my individual question`
#ASSERT `Can I be made to pay costs` `sub-group member` TRUE EQUALS `only the costs of determining my individual question`
#ASSERT `Can I be made to pay costs` `sub-group rep` FALSE EQUALS `no costs can be awarded against me`
#ASSERT `Can I be made to pay costs` `rep` FALSE EQUALS `section 181 does not protect the representative party: the ordinary costs rules apply`
#ASSERT `Can I be made to pay costs` `rep` TRUE EQUALS `section 181 does not protect the representative party: the ordinary costs rules apply`

§§ `ss 171, 172 -- representation and stay`

#ASSERT `Can the Court replace our representative` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Can the Court replace our representative` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Can the Court replace our representative` FALSE TRUE EQUALS JUST FALSE

#ASSERT `Can my award be stayed` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Can my award be stayed` TRUE TRUE EQUALS JUST FALSE
#ASSERT `Can my award be stayed` FALSE FALSE EQUALS JUST FALSE

§§ `ss 173, 174, 175(4) -- settlement and withdrawal`

#ASSERT `Can the settlement be decided now` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Can the settlement be decided now` FALSE TRUE EQUALS JUST TRUE
#ASSERT `Can the settlement be decided now` FALSE FALSE EQUALS JUST FALSE

#ASSERT `Can it be settled` FALSE EQUALS JUST FALSE
#ASSERT `Can it be settled` TRUE EQUALS JUST TRUE

#ASSERT `Can our representative withdraw` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Can our representative withdraw` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Can our representative withdraw` FALSE TRUE EQUALS JUST FALSE

§§ `ss 175, 176 -- notices`

-- Arguments: matter; damages claimed; Court dispensed; Court ordered.
#ASSERT `Must I be given notice` `the start of the class action and my right to opt out by the date fixed` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Must I be given notice` `the start of the class action and my right to opt out by the date fixed` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Must I be given notice` `the start of the class action and my right to opt out by the date fixed` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Must I be given notice` `the defendant's application to dismiss for want of prosecution` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Must I be given notice` `the representative party's application for leave to withdraw` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Must I be given notice` `money brought into Court in answer to a cause of action in the class action` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Must I be given notice` `money brought into Court in answer to a cause of action in the class action` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Must I be given notice` `any other matter` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Must I be given notice` `any other matter` TRUE FALSE FALSE EQUALS NOTHING

#ASSERT `Does missing a notice undo anything` TRUE EQUALS JUST FALSE
#ASSERT `Does missing a notice undo anything` FALSE EQUALS NOTHING

§§ `ss 177, 178, 179 -- judgment, fund, who is bound`

#ASSERT `Can damages be awarded in aggregate` TRUE EQUALS JUST TRUE
#ASSERT `Can damages be awarded in aggregate` FALSE EQUALS JUST FALSE

-- Six months: same day, month-end clamping (2027 common, 2028 leap), year roll.
#ASSERT `Does the claim day give six months` (`d` 1 3 2027) (`d` 1 9 2027) EQUALS JUST TRUE
#ASSERT `Does the claim day give six months` (`d` 1 3 2027) (`d` 31 8 2027) EQUALS JUST FALSE
#ASSERT `Does the claim day give six months` (`d` 31 8 2027) (`d` 29 2 2028) EQUALS JUST TRUE
#ASSERT `Does the claim day give six months` (`d` 31 8 2027) (`d` 28 2 2028) EQUALS JUST FALSE
#ASSERT `Does the claim day give six months` (`d` 31 8 2026) (`d` 28 2 2027) EQUALS JUST TRUE
#ASSERT `Does the claim day give six months` (`d` 31 8 2026) (`d` 27 2 2027) EQUALS JUST FALSE
#ASSERT `Does the claim day give six months` (`d` 15 12 2026) (`d` 15 6 2027) EQUALS JUST TRUE
#ASSERT `Does the claim day give six months` (`d` 15 12 2026) (`d` 14 6 2027) EQUALS JUST FALSE

-- Day fixed for claims 30 September 2027 ("on or before").
#ASSERT `Is my fund claim in time` (`d` 30 9 2027) (`d` 30 9 2027) FALSE EQUALS `my claim is in time`
#ASSERT `Is my fund claim in time` (`d` 30 9 2027) (`d` 29 9 2027) TRUE EQUALS `my claim is in time`
#ASSERT `Is my fund claim in time` (`d` 30 9 2027) (`d` 1 10 2027) FALSE EQUALS `my claim is late, but the Court may allow it if it is just to do so`
#ASSERT `Is my fund claim in time` (`d` 30 9 2027) (`d` 1 10 2027) TRUE EQUALS `my claim is late and the Court cannot allow it, because the fund has been fully distributed or applied`

#ASSERT `Will the judgment bind me` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Will the judgment bind me` TRUE TRUE EQUALS JUST FALSE
#ASSERT `Will the judgment bind me` FALSE TRUE EQUALS JUST FALSE
#ASSERT `Will the judgment bind me` FALSE FALSE EQUALS NOTHING

§§ `s 180(3) -- appeal for the group`

#ASSERT `The last day for my appeal for the group` (`d` 10 12 2027) EQUALS `d` 31 12 2027
#ASSERT `The last day for my appeal for the group` (`d` 20 12 2027) EQUALS `d` 10 1 2028

-- Ordinary time ends 10 December 2027; the further 21 days end 31 December 2027.
#ASSERT `Can I appeal for the group` `member` FALSE (`d` 10 12 2027) (`d` 31 12 2027) EQUALS `I may bring the appeal as representing the group or sub-group`
#ASSERT `Can I appeal for the group` `member` FALSE (`d` 10 12 2027) (`d` 1 1 2028) EQUALS `the further 21 days have passed`
#ASSERT `Can I appeal for the group` `member` FALSE (`d` 10 12 2027) (`d` 11 12 2027) EQUALS `I may bring the appeal as representing the group or sub-group`
#ASSERT `Can I appeal for the group` `member` FALSE (`d` 10 12 2027) (`d` 10 12 2027) EQUALS `not yet: the representative party's own time to appeal has not run out`
#ASSERT `Can I appeal for the group` `sub-group member` FALSE (`d` 10 12 2027) (`d` 20 12 2027) EQUALS `I may bring the appeal as representing the group or sub-group`
#ASSERT `Can I appeal for the group` `member` TRUE (`d` 10 12 2027) (`d` 20 12 2027) EQUALS `section 180(3) does not apply: the representative party appealed in time`
#ASSERT `Can I appeal for the group` `rep` FALSE (`d` 10 12 2027) (`d` 20 12 2027) EQUALS `section 180(3) does not apply: it is for another member, not the representative party`

§§ `s 182 -- my own limitation period`

-- Arguments: last day apart from the class action; class action started; opted out; decided without disposing.
#ASSERT `Is my limitation period suspended` (`d` 1 3 2027) (`d` 1 3 2027) FALSE FALSE EQUALS `it is suspended while the class action runs`
#ASSERT `Is my limitation period suspended` (`d` 28 2 2027) (`d` 1 3 2027) FALSE FALSE EQUALS `the class action does not affect it: it had already expired when the class action started`
#ASSERT `Is my limitation period suspended` (`d` 28 2 2027) (`d` 1 3 2027) TRUE FALSE EQUALS `the class action does not affect it: it had already expired when the class action started`
#ASSERT `Is my limitation period suspended` (`d` 31 3 2027) (`d` 1 3 2027) TRUE FALSE EQUALS `it is running again`
#ASSERT `Is my limitation period suspended` (`d` 31 3 2027) (`d` 1 3 2027) FALSE TRUE EQUALS `it is running again`

-- 30 days left on 1 March 2027 (last day 31 March 2027).
#ASSERT `My last day now` (`d` 31 3 2027) (`d` 1 3 2027) TRUE (`d` 10 6 2027) FALSE (`d` 1 1 2000) EQUALS JUST (`d` 10 7 2027)
#ASSERT `My last day now` (`d` 31 3 2027) (`d` 1 3 2027) FALSE (`d` 1 1 2000) TRUE (`d` 1 5 2027) EQUALS JUST (`d` 31 5 2027)
#ASSERT `My last day now` (`d` 31 3 2027) (`d` 1 3 2027) TRUE (`d` 10 6 2027) TRUE (`d` 1 5 2027) EQUALS JUST (`d` 31 5 2027)
#ASSERT `My last day now` (`d` 31 3 2027) (`d` 1 3 2027) FALSE (`d` 1 1 2000) FALSE (`d` 1 1 2000) EQUALS NOTHING
-- Expired the day before the class action started; last day was the start day itself (0 days left).
#ASSERT `My last day now` (`d` 28 2 2027) (`d` 1 3 2027) TRUE (`d` 10 6 2027) FALSE (`d` 1 1 2000) EQUALS JUST (`d` 28 2 2027)
#ASSERT `My last day now` (`d` 1 3 2027) (`d` 1 3 2027) TRUE (`d` 10 6 2027) FALSE (`d` 1 1 2000) EQUALS JUST (`d` 10 6 2027)
-- 366 days left (the year to 1 March 2028 includes 29 February 2028); resumes 1 June 2027.
#ASSERT `My last day now` (`d` 1 3 2028) (`d` 1 3 2027) TRUE (`d` 1 6 2027) FALSE (`d` 1 1 2000) EQUALS JUST (`d` 1 6 2028)

§§ `s 184 -- reimbursing the representative party`

#ASSERT `The most the representative can be reimbursed` TRUE 500000 300000 EQUALS 200000
#ASSERT `The most the representative can be reimbursed` TRUE 300001 300000 EQUALS 1
#ASSERT `The most the representative can be reimbursed` TRUE 300000 300000 EQUALS 0
#ASSERT `The most the representative can be reimbursed` FALSE 500000 300000 EQUALS 0
