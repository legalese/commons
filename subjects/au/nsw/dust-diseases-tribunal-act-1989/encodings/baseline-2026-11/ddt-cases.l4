§§ `s 14 -- money judgments`

#ASSERT `What does my money judgment become` TRUE TRUE TRUE FALSE FALSE EQUALS JUST `taken to be a Supreme Court judgment for the money, and no filing fee is payable`
#ASSERT `What does my money judgment become` TRUE TRUE TRUE TRUE TRUE EQUALS JUST `taken to be a Supreme Court judgment for the money, and no filing fee is payable`
#ASSERT `What does my money judgment become` TRUE TRUE TRUE TRUE FALSE EQUALS JUST `not yet: file the certified copy and the affidavit in the Common Law Division registry of the Supreme Court`
#ASSERT `What does my money judgment become` TRUE FALSE TRUE FALSE FALSE EQUALS JUST `not yet: file the certified copy and the affidavit in the Common Law Division registry of the Supreme Court`
#ASSERT `What does my money judgment become` TRUE TRUE FALSE FALSE FALSE EQUALS JUST `not yet: file the certified copy and the affidavit in the Common Law Division registry of the Supreme Court`
#ASSERT `What does my money judgment become` FALSE TRUE TRUE FALSE FALSE EQUALS NOTHING

