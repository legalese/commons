#ASSERT `Can I be awarded provisional damages` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Can I be awarded provisional damages` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `Can I be awarded provisional damages` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `Can I be awarded provisional damages` FALSE TRUE TRUE EQUALS NOTHING

