IMPORT prelude
IMPORT `lpula-claims`

-- Cases for the client seat of the Legal Profession Uniform Law Application Act 2014 (NSW) baseline. Every expected value
-- was worked by hand from the deposited text, with the section; none was copied from the encoding's output.
-- Edges: $100,000 recovered and $100,000.01; 20% of the amount against the $10,000 floor ($50,000 is the crossover);
-- 15% against $7,500 (the same crossover); an offer equal to the award; $25,000 and $100,000 in dispute and a dollar
-- under; the 30th day after forwarding and the 31st; a certificate amount equal to the amount paid.

`placeholder day` MEANS `the calendar date` 1 1 2000

§ `s 59(2) -- fixed costs`

-- No fixed cost: s 59(2) is silent.
#ASSERT `Does a fixed cost stop this charge` FALSE 0 5000 EQUALS NOTHING
-- Charged $1,500 against a fixed $1,200: barred.
#ASSERT `Does a fixed cost stop this charge` TRUE 1200 1500 EQUALS JUST TRUE
-- Charged exactly the fixed cost: not barred by s 59(2).
#ASSERT `Does a fixed cost stop this charge` TRUE 1200 1200 EQUALS JUST FALSE

§ `Schedule 1 -- does the limit apply`

-- $60,000 settlement, nothing for costs or interest: within $100,000 (cl 2(1), cl 8(1)).
#ASSERT `Does the maximum costs limit apply to my claim` TRUE `another claim for personal injury damages` 60000 0 0 EQUALS JUST TRUE
-- Exactly $100,000: "does not exceed" -- applies.
#ASSERT `Does the maximum costs limit apply to my claim` TRUE `another claim for personal injury damages` 100000 0 0 EQUALS JUST TRUE
-- $100,000.01: exceeds -- no maximum.
#ASSERT `Does the maximum costs limit apply to my claim` TRUE `another claim for personal injury damages` 100000.01 0 0 EQUALS JUST FALSE
-- $115,000 paid of which $10,000 costs and $6,000 interest: $99,000 recovered (cl 8(2)) -- applies.
#ASSERT `Does the maximum costs limit apply to my claim` TRUE `another claim for personal injury damages` 115000 10000 6000 EQUALS JUST TRUE
-- $115,000 paid of which $10,000 costs and $4,000 interest: $101,000 -- does not apply.
#ASSERT `Does the maximum costs limit apply to my claim` TRUE `another claim for personal injury damages` 115000 10000 4000 EQUALS JUST FALSE
-- Excluded claims (cl 1(2)), whatever the amount.
#ASSERT `Does the maximum costs limit apply to my claim` TRUE `a claim under the Motor Accidents Act 1988 or the Motor Accidents Compensation Act 1999` 50000 0 0 EQUALS JUST FALSE
#ASSERT `Does the maximum costs limit apply to my claim` TRUE `a claim for work injury damages` 50000 0 0 EQUALS JUST FALSE
#ASSERT `Does the maximum costs limit apply to my claim` TRUE `a dust diseases claim of the kind in section 11 of the Dust Diseases Tribunal Act 1989` 50000 0 0 EQUALS JUST FALSE
-- A Motor Accident Injuries Act 2017 claim is not named in cl 1(2): literally the Schedule applies (fork F2, finding 1).
#ASSERT `Does the maximum costs limit apply to my claim` TRUE `a claim under the Motor Accident Injuries Act 2017` 50000 0 0 EQUALS JUST TRUE
-- Not a personal injury damages claim: outside the Schedule's scope (fork F1).
#ASSERT `Does the maximum costs limit apply to my claim` FALSE `another claim for personal injury damages` 50000 0 0 EQUALS NOTHING
-- Nothing recovered (the plaintiff lost): $0 does not exceed $100,000 -- applies.
#ASSERT `Does the maximum costs limit apply to my claim` TRUE `another claim for personal injury damages` 0 0 0 EQUALS JUST TRUE

§ `Schedule 1 -- the maximum`

-- Plaintiff, $60,000 recovered: 20% = $12,000 > $10,000 (cl 2(1)(a)).
#ASSERT `What are the maximum costs for my side` TRUE `another claim for personal injury damages` `the plaintiff` 60000 0 0 80000 FALSE FALSE FALSE EQUALS `the maximum costs are` 12000
-- Plaintiff, $30,000 recovered: 20% = $6,000 < $10,000, so $10,000.
#ASSERT `What are the maximum costs for my side` TRUE `another claim for personal injury damages` `the plaintiff` 30000 0 0 80000 FALSE FALSE FALSE EQUALS `the maximum costs are` 10000
-- Plaintiff, $50,000 recovered: 20% = $10,000 exactly.
#ASSERT `What are the maximum costs for my side` TRUE `another claim for personal injury damages` `the plaintiff` 50000 0 0 80000 FALSE FALSE FALSE EQUALS `the maximum costs are` 10000
-- Plaintiff, $100,000 recovered: $20,000.
#ASSERT `What are the maximum costs for my side` TRUE `another claim for personal injury damages` `the plaintiff` 100000 0 0 150000 FALSE FALSE FALSE EQUALS `the maximum costs are` 20000
-- Plaintiff, nothing recovered: $10,000.
#ASSERT `What are the maximum costs for my side` TRUE `another claim for personal injury damages` `the plaintiff` 0 0 0 90000 FALSE FALSE FALSE EQUALS `the maximum costs are` 10000
-- Defendant, $40,000 recovered, plaintiff sought $90,000 at the hearing: 20% of $90,000 = $18,000 (cl 2(1)(b), 2(6)).
#ASSERT `What are the maximum costs for my side` TRUE `another claim for personal injury damages` `the defendant` 40000 0 0 90000 FALSE FALSE FALSE EQUALS `the maximum costs are` 18000
-- Defendant, plaintiff sought $40,000: 20% = $8,000, so $10,000.
#ASSERT `What are the maximum costs for my side` TRUE `another claim for personal injury damages` `the defendant` 20000 0 0 40000 FALSE FALSE FALSE EQUALS `the maximum costs are` 10000
-- Over $100,000 recovered: no maximum.
#ASSERT `What are the maximum costs for my side` TRUE `another claim for personal injury damages` `the plaintiff` 150000 0 0 200000 FALSE FALSE FALSE EQUALS `Schedule 1 fixes no maximum for this claim`
-- Not personal injury damages: the Act does not settle it.
#ASSERT `What are the maximum costs for my side` FALSE `another claim for personal injury damages` `the plaintiff` 60000 0 0 80000 FALSE FALSE FALSE EQUALS `the Act does not settle it`
-- Plaintiff, District Court, rehearing after arbitration on the defendant's application: $12,000 + max(15% x 60,000 =
-- 9,000; 7,500) = $21,000 (cl 3(2), 3(4)(a)).
#ASSERT `What are the maximum costs for my side` TRUE `another claim for personal injury damages` `the plaintiff` 60000 0 0 80000 TRUE TRUE FALSE EQUALS `the maximum costs are` 21000
-- Plaintiff, District Court, respondent to an appeal only, $40,000 recovered: $10,000 + max(6,000; 7,500) = $17,500 (cl 3(3)).
#ASSERT `What are the maximum costs for my side` TRUE `another claim for personal injury damages` `the plaintiff` 40000 0 0 80000 TRUE FALSE TRUE EQUALS `the maximum costs are` 17500
-- Both: rehearing on the other side's application and respondent to the appeal, $60,000: $12,000 + 2 x $9,000 = $30,000.
#ASSERT `What are the maximum costs for my side` TRUE `another claim for personal injury damages` `the plaintiff` 60000 0 0 80000 TRUE TRUE TRUE EQUALS `the maximum costs are` 30000
-- Defendant, both increases, plaintiff sought $50,000: $10,000 + 2 x max(7,500; 7,500) = $25,000.
#ASSERT `What are the maximum costs for my side` TRUE `another claim for personal injury damages` `the defendant` 30000 0 0 50000 TRUE TRUE TRUE EQUALS `the maximum costs are` 25000
-- Not heard by the District Court: cl 3 does not apply even if the other flags are set.
#ASSERT `What are the maximum costs for my side` TRUE `another claim for personal injury damages` `the plaintiff` 60000 0 0 80000 FALSE TRUE TRUE EQUALS `the maximum costs are` 12000

§ `Schedule 1 cl 7 -- apportionment`

-- $60,000 recovered, maximum $12,000; the barrister's agreed share 25%: $3,000.
#ASSERT `What is the most one of my law practices may be paid` TRUE `another claim for personal injury damages` `the plaintiff` 60000 0 0 80000 FALSE FALSE FALSE 25 EQUALS `the maximum costs are` 3000
-- One practice: 100% of $12,000.
#ASSERT `What is the most one of my law practices may be paid` TRUE `another claim for personal injury damages` `the plaintiff` 60000 0 0 80000 FALSE FALSE FALSE 100 EQUALS `the maximum costs are` 12000
#ASSERT `What is the most one of my law practices may be paid` TRUE `a claim for work injury damages` `the plaintiff` 60000 0 0 80000 FALSE FALSE FALSE 25 EQUALS `Schedule 1 fixes no maximum for this claim`
#ASSERT `What is the most one of my law practices may be paid` FALSE `another claim for personal injury damages` `the plaintiff` 60000 0 0 80000 FALSE FALSE FALSE 25 EQUALS `the Act does not settle it`

§ `Schedule 1 cll 2(4)(a), 4, 6 -- my own law practice`

-- Limit applies, no costs agreement, no exclusion: the practice cannot charge more (cl 2(4)(a)).
#ASSERT `Does the maximum stop my law practice charging me more` TRUE `another claim for personal injury damages` 60000 0 0 FALSE FALSE FALSE EQUALS JUST TRUE
-- A compliant costs agreement providing for the costs: cl 4(1), the Schedule does not apply to that recovery.
#ASSERT `Does the maximum stop my law practice charging me more` TRUE `another claim for personal injury damages` 60000 0 0 TRUE FALSE FALSE EQUALS JUST FALSE
-- The same agreement, but the practice lost the benefit under cl 4(3) regulations: the limit applies.
#ASSERT `Does the maximum stop my law practice charging me more` TRUE `another claim for personal injury damages` 60000 0 0 TRUE TRUE FALSE EQUALS JUST TRUE
-- Services excluded by the court under cl 6.
#ASSERT `Does the maximum stop my law practice charging me more` TRUE `another claim for personal injury damages` 60000 0 0 FALSE FALSE TRUE EQUALS JUST FALSE
-- Over $100,000: no limit.
#ASSERT `Does the maximum stop my law practice charging me more` TRUE `another claim for personal injury damages` 100000.01 0 0 FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Does the maximum stop my law practice charging me more` FALSE `another claim for personal injury damages` 60000 0 0 FALSE FALSE FALSE EQUALS NOTHING

§ `Schedule 1 cll 2(4)(b), 5, 6 -- costs orders between the parties`

-- I am the plaintiff, $60,000 recovered; the defendant offered to pay $70,000, I did not accept; award $60,000 is no
-- less favourable to the defendant than paying $70,000 (cl 5(2)); costs after the offer: the limit does not stop an
-- indemnity costs order against me (cl 5(1)).
#ASSERT `Does the maximum protect me from paying the other side more` TRUE `another claim for personal injury damages` `the plaintiff` 60000 0 0 TRUE 70000 TRUE 60000 TRUE FALSE EQUALS JUST FALSE
-- Award equal to the offer ($60,000 offered, $60,000 awarded): still no less favourable -- reasonable.
#ASSERT `Does the maximum protect me from paying the other side more` TRUE `another claim for personal injury damages` `the plaintiff` 60000 0 0 TRUE 60000 TRUE 60000 TRUE FALSE EQUALS JUST FALSE
-- Defendant offered $50,000, award $60,000: less favourable to the defendant -- not reasonable; the limit protects me.
#ASSERT `Does the maximum protect me from paying the other side more` TRUE `another claim for personal injury damages` `the plaintiff` 60000 0 0 TRUE 50000 TRUE 60000 TRUE FALSE EQUALS JUST TRUE
-- Reasonable offer, but costs for services before the offer: the limit protects me.
#ASSERT `Does the maximum protect me from paying the other side more` TRUE `another claim for personal injury damages` `the plaintiff` 60000 0 0 TRUE 70000 TRUE 60000 FALSE FALSE EQUALS JUST TRUE
-- Claim settled, no court determination: the offer is not shown reasonable under cl 5(2); protected.
#ASSERT `Does the maximum protect me from paying the other side more` TRUE `another claim for personal injury damages` `the plaintiff` 60000 0 0 TRUE 70000 FALSE 0 TRUE FALSE EQUALS JUST TRUE
-- Services to the other side excluded under cl 6: not protected.
#ASSERT `Does the maximum protect me from paying the other side more` TRUE `another claim for personal injury damages` `the plaintiff` 60000 0 0 FALSE 0 TRUE 60000 FALSE TRUE EQUALS JUST FALSE
-- I am the defendant; the plaintiff offered to accept $40,000; award $45,000 is no less favourable to the plaintiff:
-- reasonable, so not protected for later services.
#ASSERT `Does the maximum protect me from paying the other side more` TRUE `another claim for personal injury damages` `the defendant` 45000 0 0 TRUE 40000 TRUE 45000 TRUE FALSE EQUALS JUST FALSE
-- The same with an award of $35,000: less favourable to the plaintiff than $40,000 -- protected.
#ASSERT `Does the maximum protect me from paying the other side more` TRUE `another claim for personal injury damages` `the defendant` 35000 0 0 TRUE 40000 TRUE 35000 TRUE FALSE EQUALS JUST TRUE
-- Over $100,000: no limit to protect me.
#ASSERT `Does the maximum protect me from paying the other side more` TRUE `another claim for personal injury damages` `the plaintiff` 120000 0 0 FALSE 0 TRUE 120000 FALSE FALSE EQUALS JUST FALSE
-- Mirror: I am the plaintiff and offered to accept $50,000; award $60,000 is no less favourable to me: the limit does
-- not stop the defendant being ordered to pay my later costs on an indemnity basis.
#ASSERT `Does the maximum limit what the other side can be ordered to pay me` TRUE `another claim for personal injury damages` `the plaintiff` 60000 0 0 TRUE 50000 TRUE 60000 TRUE FALSE EQUALS JUST FALSE
-- Mirror: my offer to accept $70,000 against an award of $60,000 -- not reasonable; the limit applies to my costs order.
#ASSERT `Does the maximum limit what the other side can be ordered to pay me` TRUE `another claim for personal injury damages` `the plaintiff` 60000 0 0 TRUE 70000 TRUE 60000 TRUE FALSE EQUALS JUST TRUE
#ASSERT `Does the maximum limit what the other side can be ordered to pay me` FALSE `another claim for personal injury damages` `the plaintiff` 60000 0 0 TRUE 70000 TRUE 60000 TRUE FALSE EQUALS NOTHING

§ `Schedule 1 cl 5(4) -- repayment by my law practice`

-- Plaintiff refused the defendant's $70,000 offer, awarded $60,000; increased costs; practice failed the disclosure
-- regulations: the court may order repayment.
#ASSERT `Can the court make my law practice repay the extra costs of refusing the offer` TRUE `the plaintiff` TRUE 70000 TRUE 60000 TRUE TRUE EQUALS JUST TRUE
-- The practice complied with the regulations: the condition fails.
#ASSERT `Can the court make my law practice repay the extra costs of refusing the offer` TRUE `the plaintiff` TRUE 70000 TRUE 60000 TRUE FALSE EQUALS JUST FALSE
-- The offer was $50,000 and the award $60,000: not a reasonable offer.
#ASSERT `Can the court make my law practice repay the extra costs of refusing the offer` TRUE `the plaintiff` TRUE 50000 TRUE 60000 TRUE TRUE EQUALS JUST FALSE
#ASSERT `Can the court make my law practice repay the extra costs of refusing the offer` FALSE `the plaintiff` TRUE 70000 TRUE 60000 TRUE TRUE EQUALS NOTHING

§ `Schedule 2 -- reasonable prospects`

#ASSERT `Can my law practice act on my claim or defence` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Can my law practice act on my claim or defence` TRUE FALSE FALSE EQUALS JUST FALSE
-- Preliminary work to assess prospects: cl 3, the Schedule does not apply.
#ASSERT `Can my law practice act on my claim or defence` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Can my law practice act on my claim or defence` FALSE FALSE FALSE EQUALS NOTHING

#ASSERT `Can my court document be filed` TRUE `an originating process, defence or further pleading` TRUE EQUALS JUST TRUE
#ASSERT `Can my court document be filed` TRUE `an originating process, defence or further pleading` FALSE EQUALS JUST FALSE
#ASSERT `Can my court document be filed` TRUE `a document amending an originating process, defence or further pleading` FALSE EQUALS JUST FALSE
#ASSERT `Can my court document be filed` TRUE `another document of a kind the local regulations prescribe` FALSE EQUALS JUST FALSE
#ASSERT `Can my court document be filed` TRUE `any other document` FALSE EQUALS NOTHING
#ASSERT `Can my court document be filed` FALSE `an originating process, defence or further pleading` FALSE EQUALS NOTHING

-- Ordered to pay costs; the trial court found no basis; not rebutted; no costs determination yet: the court may order.
#ASSERT `Can I seek repayment of the costs from my law practice` TRUE TRUE TRUE FALSE FALSE FALSE FALSE `placeholder day` (`the calendar date` 1 3 2026) EQUALS `the court may order my law practice to repay those costs`
-- The presumption rebutted, no other finding: the court cannot.
#ASSERT `Can I seek repayment of the costs from my law practice` TRUE TRUE TRUE FALSE TRUE FALSE FALSE `placeholder day` (`the calendar date` 1 3 2026) EQUALS `the court cannot make that order on these facts`
-- The Supreme Court is satisfied (cl 6(2)), not rebutted.
#ASSERT `Can I seek repayment of the costs from my law practice` TRUE TRUE FALSE TRUE FALSE FALSE FALSE `placeholder day` (`the calendar date` 1 3 2026) EQUALS `the court may order my law practice to repay those costs`
-- The court's own finding, without the presumption.
#ASSERT `Can I seek repayment of the costs from my law practice` TRUE TRUE FALSE FALSE FALSE TRUE FALSE `placeholder day` (`the calendar date` 1 3 2026) EQUALS `the court may order my law practice to repay those costs`
-- Not ordered to pay costs: nothing to repay under cl 5(1)(a).
#ASSERT `Can I seek repayment of the costs from my law practice` TRUE FALSE TRUE FALSE FALSE FALSE FALSE `placeholder day` (`the calendar date` 1 3 2026) EQUALS `the court cannot make that order on these facts`
-- Final determination on 10 February 2026, application on 11 February 2026: too late (cl 5(3)).
#ASSERT `Can I seek repayment of the costs from my law practice` TRUE TRUE TRUE FALSE FALSE FALSE TRUE (`the calendar date` 10 2 2026) (`the calendar date` 11 2 2026) EQUALS `it is too late to apply for that order`
-- Application the same day as the final determination: not "after" it (fork F5).
#ASSERT `Can I seek repayment of the costs from my law practice` TRUE TRUE TRUE FALSE FALSE FALSE TRUE (`the calendar date` 10 2 2026) (`the calendar date` 10 2 2026) EQUALS `the court may order my law practice to repay those costs`
-- Application the day before the final determination.
#ASSERT `Can I seek repayment of the costs from my law practice` TRUE TRUE TRUE FALSE FALSE FALSE TRUE (`the calendar date` 10 2 2026) (`the calendar date` 9 2 2026) EQUALS `the court may order my law practice to repay those costs`
#ASSERT `Can I seek repayment of the costs from my law practice` FALSE TRUE TRUE FALSE FALSE FALSE FALSE `placeholder day` (`the calendar date` 1 3 2026) EQUALS `Schedule 2 does not reach my claim`

#ASSERT `Can my law practice pass the indemnity on to me` TRUE EQUALS JUST FALSE
#ASSERT `Can my law practice pass the indemnity on to me` FALSE EQUALS NOTHING

§ `Part 7 -- costs assessment`

#ASSERT `Can I apply for assessment of ordered costs` TRUE TRUE `I have paid or am liable to pay them` EQUALS JUST TRUE
#ASSERT `Can I apply for assessment of ordered costs` TRUE TRUE `I have received or am entitled to receive them` EQUALS JUST TRUE
#ASSERT `Can I apply for assessment of ordered costs` TRUE TRUE `neither` EQUALS NOTHING
#ASSERT `Can I apply for assessment of ordered costs` TRUE FALSE `I have paid or am liable to pay them` EQUALS JUST FALSE
#ASSERT `Can I apply for assessment of ordered costs` FALSE TRUE `I have paid or am liable to pay them` EQUALS NOTHING

#ASSERT `Can my application fee be waived` TRUE EQUALS JUST TRUE
#ASSERT `Can my application fee be waived` FALSE EQUALS JUST FALSE

-- Paid $8,000; certificate $6,500: $1,500 recoverable (s 70(4)).
#ASSERT `How much overpaid can I recover` 8000 6500 EQUALS 1500
#ASSERT `How much overpaid can I recover` 6500 6500 EQUALS 0
#ASSERT `How much overpaid can I recover` 5000 6500 EQUALS 0

#ASSERT `Is the certificate a judgment` 4000 TRUE EQUALS JUST TRUE
#ASSERT `Is the certificate a judgment` 4000 FALSE EQUALS JUST FALSE
#ASSERT `Is the certificate a judgment` 0 TRUE EQUALS NOTHING

-- s 81: a 6% rate against a 6% cap; 6.5% against it.
#ASSERT `Can the assessor set this interest rate` 6 6 EQUALS JUST TRUE
#ASSERT `Can the assessor set this interest rate` 0 6 EQUALS JUST TRUE
#ASSERT `Can the assessor set this interest rate` 6.5 6 EQUALS NOTHING

-- s 83: forwarded 2 March 2026; 30 days after is 1 April 2026.
#ASSERT `By when must I apply for a review` (`the calendar date` 2 3 2026) FALSE `placeholder day` EQUALS `the calendar date` 1 4 2026
-- Forwarded 15 February 2028 (a leap year): 30 days after is 16 March 2028.
#ASSERT `By when must I apply for a review` (`the calendar date` 15 2 2028) FALSE `placeholder day` EQUALS `the calendar date` 16 3 2028
-- Extended by the Manager to 30 April 2026.
#ASSERT `By when must I apply for a review` (`the calendar date` 2 3 2026) TRUE (`the calendar date` 30 4 2026) EQUALS `the calendar date` 30 4 2026
-- Applied on 1 April 2026 (the 30th day): in time.
#ASSERT `Is my review application in time` (`the calendar date` 2 3 2026) FALSE `placeholder day` (`the calendar date` 1 4 2026) EQUALS `my application for review is in time`
-- Applied on 2 April 2026 (the 31st day): too late.
#ASSERT `Is my review application in time` (`the calendar date` 2 3 2026) FALSE `placeholder day` (`the calendar date` 2 4 2026) EQUALS `the time for applying for review has passed`
-- Applied on the day the certificate was forwarded: in time.
#ASSERT `Is my review application in time` (`the calendar date` 2 3 2026) FALSE `placeholder day` (`the calendar date` 2 3 2026) EQUALS `my application for review is in time`
-- Applied on 20 April 2026 with an extension to 30 April 2026: in time; on 1 May 2026: too late.
#ASSERT `Is my review application in time` (`the calendar date` 2 3 2026) TRUE (`the calendar date` 30 4 2026) (`the calendar date` 20 4 2026) EQUALS `my application for review is in time`
#ASSERT `Is my review application in time` (`the calendar date` 2 3 2026) TRUE (`the calendar date` 30 4 2026) (`the calendar date` 1 5 2026) EQUALS `the time for applying for review has passed`
-- An application dated before the certificate was forwarded.
#ASSERT `Is my review application in time` (`the calendar date` 2 3 2026) FALSE `placeholder day` (`the calendar date` 1 3 2026) EQUALS `the certificate has not been forwarded yet, so the 30 days have not begun`

#ASSERT `Is the determination suspended` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Is the determination suspended` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Is the determination suspended` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Is the determination suspended` FALSE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Is the determination suspended` FALSE FALSE FALSE FALSE EQUALS JUST FALSE

-- s 89: $24,999 in the District Court needs leave; $25,000 does not; $99,999 in the Supreme Court needs leave;
-- $100,000 does not.
#ASSERT `Can I appeal the review panel's decision` TRUE `the District Court` 24999 EQUALS `I can appeal only with the court's leave`
#ASSERT `Can I appeal the review panel's decision` TRUE `the District Court` 25000 EQUALS `I can appeal without leave`
#ASSERT `Can I appeal the review panel's decision` TRUE `the Supreme Court` 99999 EQUALS `I can appeal only with the court's leave`
#ASSERT `Can I appeal the review panel's decision` TRUE `the Supreme Court` 100000 EQUALS `I can appeal without leave`
#ASSERT `Can I appeal the review panel's decision` FALSE `the Supreme Court` 200000 EQUALS `section 89 gives me no appeal`

