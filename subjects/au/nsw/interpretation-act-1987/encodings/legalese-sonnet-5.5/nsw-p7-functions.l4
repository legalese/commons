#ASSERT `s 49(8)(b) the person for the time being occupying or acting in the office concerned is taken to be the delegator or delegate` TRUE EQUALS JUST TRUE
#ASSERT `s 49(8)(b) the person for the time being occupying or acting in the office concerned is taken to be the delegator or delegate` FALSE EQUALS JUST FALSE
#ASSERT `s 49(9) the function may, notwithstanding the delegation, be exercised by the delegator` TRUE EQUALS JUST TRUE
#ASSERT `s 49(9) the function may, notwithstanding the delegation, be exercised by the delegator` FALSE EQUALS NOTHING
