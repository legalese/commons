#ASSERT `s 49(3) the delegated function may be exercised` TRUE EQUALS NOTHING
#ASSERT `s 49(4) the delegate may, in the exercise of the delegated function, exercise the other function` TRUE EQUALS JUST TRUE
#ASSERT `s 49(4) the delegate may, in the exercise of the delegated function, exercise the other function` FALSE EQUALS NOTHING
