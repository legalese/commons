#ASSERT `s 49(10) section 49 applies to the sub-delegation in the same way as it applies to a delegation` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 49(10) section 49 applies to the sub-delegation in the same way as it applies to a delegation` FALSE TRUE EQUALS NOTHING
