IMPORT prelude
IMPORT `nsw-provisions`

-- Interpretation Act 1987 (New South Wales): the cross-references, as data.
--
-- One row for each reference, in the text file, from one provision to another provision of the same text,
-- to the unit that contains it ("this section", "this Part", "this Act"), or to another Act or instrument.
-- Generated by a script that reads the text file (see NOTES.md).
-- A row to another instrument carries the instrument and the provision as printed and is not resolved here.

DECLARE ReferenceKind IS ONE OF
    ToAProvisionOfThisText
    ToTheSameUnitOrTheWholeAct
    ToAnotherInstrument

DECLARE CrossReference HAS
    citingProvision IS A STRING
    wordsOfTheCitation IS A STRING
    kind IS A ReferenceKind
    citedIdentifier IS A STRING
    citedHeading IS A STRING
    instrument IS A STRING
    instrumentProvision IS A STRING
    line IS A NUMBER

-- citing provision, the words of the citation as printed, kind, identifier cited, heading of the cited provision as
-- printed, (another instrument:) instrument as printed, provision as printed, line of the text file
`the cross references` MEANS
  LIST

