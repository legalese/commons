IMPORT prelude
IMPORT `nsw-nouns`

-- Interpretation Act 1987 (New South Wales), Part 2 Words and expressions: sections 13 to 19.
-- References to the Sovereign, the Crown, the Governor, Ministers, British subjects, the Seal,
-- sitting days, tabling and office holders.

§ `Part 2 Words and expressions (continued)`

§§ `13 Sovereign and Crown`

-- The two references section 13 speaks of.
DECLARE SovereignOrCrownReference IS ONE OF
    AReferenceToTheSovereign
    AReferenceToTheCrown
    AReferenceToSomethingElse

-- What section 13 says such a reference is a reference to.
DECLARE SovereignOrCrownMeaning IS ONE OF
    TheSovereignForTheTimeBeing
    TheCrownInRightOfNewSouthWales

-- src:79 | In any Act or instrument—
-- src:80 | (a) a reference to the Sovereign (whether the words "Her Majesty" or "His Majesty" or any other words are used) is a reference to the Sovereign for the time being, and
-- src:81 | (b) a reference to the Crown is a reference to the Crown in right of New South Wales.
@ref s 13(a) and (b) (src:79-81)
GIVEN reference IS A SovereignOrCrownReference
GIVETH A MAYBE SovereignOrCrownMeaning
`s 13 what the reference to the Sovereign or the Crown is a reference to` MEANS
    CONSIDER reference
    WHEN AReferenceToTheSovereign THEN JUST TheSovereignForTheTimeBeing
    WHEN AReferenceToTheCrown THEN JUST TheCrownInRightOfNewSouthWales
    WHEN AReferenceToSomethingElse THEN NOTHING

§§ `13A NSW Government agencies and statutory bodies representing the Crown`

-- src:84 | (1) If an Act provides that a body is—
-- src:85 | (a) a NSW Government agency, or
-- src:86 | (b) a statutory body representing the Crown,
-- src:87 | the body has the status, privileges and immunities of the Crown.
@ref s 13A(1) (src:84-87)
GIVEN `an Act provides that the body is a NSW Government agency` IS A BOOLEAN
      `an Act provides that the body is a statutory body representing the Crown` IS A BOOLEAN
GIVETH A MAYBE BOOLEAN
`s 13A(1) the body has the status, privileges and immunities of the Crown` MEANS
    IF `an Act provides that the body is a NSW Government agency` OR `an Act provides that the body is a statutory body representing the Crown`
    THEN JUST TRUE
    ELSE JUST FALSE

-- src:88 | (2) If an Act provides that a body—
-- src:89 | (a) is not or does not represent the Crown, or
-- src:90 | (b) is not a NSW Government agency or a statutory body representing the Crown,
-- src:91 | the body does not have the status, privileges and immunities of the Crown.
@ref s 13A(2) (src:88-91)
GIVEN `an Act provides that the body is not or does not represent the Crown` IS A BOOLEAN
      `an Act provides that the body is not a NSW Government agency or a statutory body representing the Crown` IS A BOOLEAN
GIVETH A MAYBE BOOLEAN
`s 13A(2) the body has the status, privileges and immunities of the Crown` MEANS
    IF `an Act provides that the body is not or does not represent the Crown` OR `an Act provides that the body is not a NSW Government agency or a statutory body representing the Crown`
    THEN JUST FALSE
    ELSE NOTHING

-- What section 13A(3) extends to.
DECLARE Section13AExtension IS ONE OF
    AProvisionMadeForThePurposesOfAnyActOrMoreGenerally
    PrivilegesAndImmunitiesConferredExpresslyOrByConstruction
    ASomethingElseNotListedInSection13A3

-- src:92 | (3) This section extends (without limiting its operation)—
-- src:93 | (a) to a provision that is expressed to be made for the purposes of any Act or more generally, and
-- src:94 | (b) to privileges and immunities conferred by law expressly or as a matter of construction.
@ref s 13A(3) (src:92-94)
GIVEN thing IS A Section13AExtension
GIVETH A MAYBE BOOLEAN
`s 13A(3) section 13A extends to` MEANS
    CONSIDER thing
    WHEN AProvisionMadeForThePurposesOfAnyActOrMoreGenerally THEN JUST TRUE
    WHEN PrivilegesAndImmunitiesConferredExpresslyOrByConstruction THEN JUST TRUE
    WHEN ASomethingElseNotListedInSection13A3 THEN NOTHING

-- The two kinds of body in section 13A(4).
DECLARE AgencyKind IS ONE OF
    ANswGovernmentAgency
    AStatutoryBodyRepresentingTheCrown

-- src:95 | (4) In any Act or instrument—
-- src:96 | (a) a reference to a NSW Government agency includes a reference to a body that is declared to be a statutory body representing the Crown, or
-- src:97 | (b) a reference to a statutory body representing the Crown includes a reference to a body that is declared to be a NSW Government agency.
@ref s 13A(4) (src:95-97)
GIVEN `the reference is to` IS A AgencyKind
      `the body is declared to be` IS A AgencyKind
GIVETH A MAYBE BOOLEAN
`s 13A(4) the reference includes a reference to the body` MEANS
    CONSIDER `the reference is to`
    WHEN ANswGovernmentAgency THEN
        CONSIDER `the body is declared to be`
        WHEN AStatutoryBodyRepresentingTheCrown THEN JUST TRUE
        WHEN ANswGovernmentAgency THEN NOTHING
    WHEN AStatutoryBodyRepresentingTheCrown THEN
        CONSIDER `the body is declared to be`
        WHEN ANswGovernmentAgency THEN JUST TRUE
        WHEN AStatutoryBodyRepresentingTheCrown THEN NOTHING

-- What "the Crown" includes in section 13A(5).
DECLARE CrownIncludes IS ONE OF
    TheState
    TheGovernmentOfTheState
    AnotherBodyNotNamedInSection13A5

-- src:98 | (5) In this section, the Crown includes the State and the Government of the State.
@ref s 13A(5) (src:98)
GIVEN body IS A CrownIncludes
GIVETH A MAYBE BOOLEAN
`s 13A(5) in section 13A the Crown includes` MEANS
    CONSIDER body
    WHEN TheState THEN JUST TRUE
    WHEN TheGovernmentOfTheState THEN JUST TRUE
    WHEN AnotherBodyNotNamedInSection13A5 THEN NOTHING

§§ `14 Governor`

-- src:100 | 14 Governor
-- src:101 | In any Act or instrument, a reference to the Governor is a reference to the Governor with the advice of the Executive Council, and includes a reference to any person for the time being lawfully administering the Government.
@ref s 14 (src:100-101)
GIVEN `it is the Governor with the advice of the Executive Council` IS A BOOLEAN
      `it is a person for the time being lawfully administering the Government` IS A BOOLEAN
GIVETH A MAYBE BOOLEAN
`s 14 a reference to the Governor is a reference to it` MEANS
    IF `it is the Governor with the advice of the Executive Council` OR `it is a person for the time being lawfully administering the Government`
    THEN JUST TRUE
    ELSE NOTHING

§§ `15 Minister`

-- Which Minister a reference to "the Minister" means.
DECLARE WhichMinister IS ONE OF
    TheMinisterAdministeringTheAct
    TheMinisterAdministeringInTheRelevantRespect
    TheMinisterAdministeringTheRelevantPortion
    AnyOneOfTheMinistersAdministering

-- src:104 | (1) In any Act or instrument—
-- src:105 | (a) a reference to a Minister is a reference to a Minister of the Crown, and
-- src:106 | (b) a reference to a particular Minister includes a reference to any other Minister who is acting for or on behalf of the Minister.
@ref s 15(1)(a) (src:104-106)
GIVEN `it is a Minister of the Crown` IS A BOOLEAN
GIVETH A MAYBE BOOLEAN
`s 15(1)(a) a reference to a Minister is a reference to it` MEANS
    IF `it is a Minister of the Crown` THEN JUST TRUE ELSE NOTHING

-- src:106 | (b) a reference to a particular Minister includes a reference to any other Minister who is acting for or on behalf of the Minister.
@ref s 15(1)(b) (src:106)
GIVEN `the other Minister is acting for or on behalf of the particular Minister` IS A BOOLEAN
GIVETH A MAYBE BOOLEAN
`s 15(1)(b) a reference to a particular Minister includes a reference to the other Minister` MEANS
    IF `the other Minister is acting for or on behalf of the particular Minister` THEN JUST TRUE ELSE NOTHING

-- src:107 | (2) In any Act, a reference to "the Minister" is a reference to—
-- src:108 | (a) the Minister administering the Act,
-- src:109 | (b) if different Ministers are administering the Act in different respects—the Minister administering the Act in the relevant respect,
-- src:110 | (c) if different Ministers are administering different portions of the Act—the Minister administering the relevant portion of the Act, or
-- src:111 | (d) if paragraphs (b) and (c) do not apply and 2 or more Ministers are administering that Act or a portion of that Act—any one of the Ministers administering the Act or portion of the Act.
@ref s 15(2) (src:107-111)
GIVEN `different Ministers are administering the Act in different respects` IS A BOOLEAN
      `different Ministers are administering different portions of the Act` IS A BOOLEAN
      `2 or more Ministers are administering the Act or a portion of the Act` IS A BOOLEAN
GIVETH A MAYBE WhichMinister
`s 15(2) the Minister to whom a reference to the Minister in an Act is a reference` MEANS
    `which Minister is meant when paragraphs (b) and (c) are tested first` `different Ministers are administering the Act in different respects` `different Ministers are administering different portions of the Act` `2 or more Ministers are administering the Act or a portion of the Act`

-- src:112 | (3) In any instrument, a reference to "the Minister" is a reference to—
-- src:113 | (a) the Minister administering the Act under which the instrument is made,
-- src:114 | (b) if different Ministers are administering that Act in different respects—the Minister administering that Act in the respect in relation to which the instrument is made,
-- src:115 | (c) if different Ministers are administering different portions of that Act—the Minister administering the portion of that Act under which the instrument is made, or
-- src:116 | (d) if paragraphs (b) and (c) do not apply and 2 or more Ministers are administering that Act or a portion of that Act—any one of the Ministers administering the Act or the portion of the Act under which the instrument is made.
@ref s 15(3) (src:112-116)
GIVEN `different Ministers are administering the Act under which the instrument is made in different respects` IS A BOOLEAN
      `different Ministers are administering different portions of that Act` IS A BOOLEAN
      `2 or more Ministers are administering that Act or a portion of that Act` IS A BOOLEAN
GIVETH A MAYBE WhichMinister
`s 15(3) the Minister to whom a reference to the Minister in an instrument is a reference` MEANS
    `which Minister is meant when paragraphs (b) and (c) are tested first` `different Ministers are administering the Act under which the instrument is made in different respects` `different Ministers are administering different portions of that Act` `2 or more Ministers are administering that Act or a portion of that Act`

-- src:117 | (4) In an Act or instrument, a reference to the Minister administering another Act means—
-- src:118 | (a) the Minister administering the other Act, or
-- src:119 | (b) if different Ministers are administering the other Act in different respects—the Minister administering the other Act in the relevant respect, or
-- src:120 | (c) if different Ministers are administering different portions of the other Act—the Minister administering the relevant portion of the other Act, or
-- src:121 | (d) if paragraphs (b) and (c) do not apply and 2 or more Ministers are administering the other Act or a portion of the other Act—any 1 of the Ministers administering the other Act or portion of the other Act.
@ref s 15(4) (src:117-121)
GIVEN `different Ministers are administering the other Act in different respects` IS A BOOLEAN
      `different Ministers are administering different portions of the other Act` IS A BOOLEAN
      `2 or more Ministers are administering the other Act or a portion of the other Act` IS A BOOLEAN
GIVETH A MAYBE WhichMinister
`s 15(4) the Minister to whom a reference to the Minister administering another Act is a reference` MEANS
    `which Minister is meant when paragraphs (b) and (c) are tested first` `different Ministers are administering the other Act in different respects` `different Ministers are administering different portions of the other Act` `2 or more Ministers are administering the other Act or a portion of the other Act`

-- src:107 | (2) In any Act, a reference to "the Minister" is a reference to—
-- src:108 | (a) the Minister administering the Act,
-- src:109 | (b) if different Ministers are administering the Act in different respects—the Minister administering the Act in the relevant respect,
-- src:110 | (c) if different Ministers are administering different portions of the Act—the Minister administering the relevant portion of the Act, or
-- src:111 | (d) if paragraphs (b) and (c) do not apply and 2 or more Ministers are administering that Act or a portion of that Act—any one of the Ministers administering the Act or portion of the Act.
@ref s 15(2) to (4), paragraphs (a) to (d) (src:107-111)
GIVEN respects IS A BOOLEAN
      portions IS A BOOLEAN
      `two or more` IS A BOOLEAN
GIVETH A MAYBE WhichMinister
`which Minister is meant when paragraphs (b) and (c) are tested first` MEANS
    IF respects AND portions
    THEN NOTHING
    ELSE IF respects
         THEN JUST TheMinisterAdministeringInTheRelevantRespect
         ELSE IF portions
              THEN JUST TheMinisterAdministeringTheRelevantPortion
              ELSE IF `two or more`
                   THEN JUST AnyOneOfTheMinistersAdministering
                   ELSE JUST TheMinisterAdministeringTheAct

§§ `16 British subjects and aliens`

-- src:125 | (a) a reference to a British subject, or to a natural-born or naturalised subject of Her Majesty or to any other similar expression, is a reference to—
-- src:126 | (i) an Australian citizen, or
-- src:127 | (ii) any other person who would, had the relevant Commonwealth law continued in force, be a person who has the status of a British subject or the status of a British subject without citizenship, and
@ref s 16(1)(a) (src:125-127)
GIVEN `it is an Australian citizen` IS A BOOLEAN
      `it is any other person who would, had the relevant Commonwealth law continued in force, have the status of a British subject or of a British subject without citizenship` IS A BOOLEAN
GIVETH A MAYBE BOOLEAN
`s 16(1)(a) a reference to a British subject is a reference to it` MEANS
    IF `it is an Australian citizen` OR `it is any other person who would, had the relevant Commonwealth law continued in force, have the status of a British subject or of a British subject without citizenship`
    THEN JUST TRUE
    ELSE NOTHING

-- src:128 | (b) a reference to an alien is a reference to a person who would, had the relevant Commonwealth law continued in force, be a person who is an alien within the meaning of that law.
@ref s 16(1)(b) (src:128)
GIVEN `it is a person who would, had the relevant Commonwealth law continued in force, be an alien within the meaning of that law` IS A BOOLEAN
GIVETH A MAYBE BOOLEAN
`s 16(1)(b) a reference to an alien is a reference to it` MEANS
    IF `it is a person who would, had the relevant Commonwealth law continued in force, be an alien within the meaning of that law` THEN JUST TRUE ELSE NOTHING

-- src:129 | (2) If a rule of law applies to or in relation to, or has effect with respect to, a British subject, the rule of law shall apply to or in relation to, or have effect with respect to—
-- src:130 | (a) an Australian citizen, and
-- src:131 | (b) any other person who would, had the relevant Commonwealth law continued in force, be a person who has the status of a British subject or the status of a British subject without citizenship,
-- src:132 | as if the Australian citizen or other person were a British subject.
@ref s 16(2) (src:129-132)
GIVEN `the rule of law applies to or in relation to a British subject` IS A BOOLEAN
      `the person is an Australian citizen or another person who would, had the relevant Commonwealth law continued in force, have the status of a British subject` IS A BOOLEAN
GIVETH A MAYBE BOOLEAN
`s 16(2) the rule of law applies to the person as if the person were a British subject` MEANS
    IF `the rule of law applies to or in relation to a British subject` AND `the person is an Australian citizen or another person who would, had the relevant Commonwealth law continued in force, have the status of a British subject`
    THEN JUST TRUE
    ELSE JUST FALSE

-- src:133 | (3) If a rule of law applies to or in relation to, or has effect with respect to, an alien, the rule of law shall apply to or in relation to, or have effect with respect to, a person who would, had the relevant Commonwealth law continued in force, be a person who is an alien within the meaning of that law.
@ref s 16(3) (src:133)
GIVEN `the rule of law applies to or in relation to an alien` IS A BOOLEAN
      `the person would, had the relevant Commonwealth law continued in force, be an alien within the meaning of that law` IS A BOOLEAN
GIVETH A MAYBE BOOLEAN
`s 16(3) the rule of law applies to the person as if the person were an alien` MEANS
    IF `the rule of law applies to or in relation to an alien` AND `the person would, had the relevant Commonwealth law continued in force, be an alien within the meaning of that law`
    THEN JUST TRUE
    ELSE JUST FALSE

-- src:134 | (4) In this section, a reference to the relevant Commonwealth law is a reference to—
-- src:135 | (a) the Australian Citizenship Act 1948 of the Commonwealth, as in force immediately before the commencement of this subsection, and
-- src:136 | (b) the regulations in force immediately before the commencement of this subsection under the Australian Citizenship Act 1948 of the Commonwealth, as so in force.
@ref s 16(4) (src:134-136)
GIVETH A LIST OF STRING
`s 16(4) the relevant Commonwealth law consists of` MEANS
    LIST "the Australian Citizenship Act 1948 of the Commonwealth, as in force immediately before the commencement of this subsection",
         "the regulations in force immediately before the commencement of this subsection under the Australian Citizenship Act 1948 of the Commonwealth, as so in force"

§§ `17 Public Seal of the State`

-- The seals section 17 speaks of.
DECLARE SealReference IS ONE OF
    TheGreatSealOfTheState
    TheSealOfTheState
    ASealNotNamedInSection17

-- src:139 | In any Act or instrument, a reference to—
-- src:140 | (a) the Great Seal of the State, or
-- src:141 | (b) the Seal of the State,
-- src:142 | shall be read as a reference to the Public Seal of the State.
@ref s 17 (src:139-142)
GIVEN reference IS A SealReference
GIVETH A MAYBE STRING
`s 17 the seal the reference shall be read as a reference to` MEANS
    CONSIDER reference
    WHEN TheGreatSealOfTheState THEN JUST "the Public Seal of the State"
    WHEN TheSealOfTheState THEN JUST "the Public Seal of the State"
    WHEN ASealNotNamedInSection17 THEN NOTHING

§§ `18 Sitting days`

-- src:145 | In any Act or statutory rule—
-- src:146 | (a) a reference to a sitting day, in relation to a House of Parliament, is a reference to a day on which the House actually sits, and
@ref s 18(a) (src:145-146)
GIVEN kind IS A TextKind
      `the House actually sits on the day` IS A BOOLEAN
GIVETH A MAYBE BOOLEAN
`s 18(a) the day is a sitting day in relation to the House` MEANS
    CONSIDER kind
    WHEN AnActText THEN JUST `the House actually sits on the day`
    WHEN AStatutoryRuleText THEN JUST `the House actually sits on the day`
    WHEN AnEnvironmentalPlanningInstrumentText THEN NOTHING
    WHEN AnotherInstrumentText THEN NOTHING

-- src:147 | (b) a reference to a number of sitting days, in relation to a House of Parliament, is a reference to that number of sitting days, regardless of whether those days occur within the same or within different sessions of Parliament.
@ref s 18(b) (src:147)
GIVEN `the sitting days occur within the same session of Parliament` IS A BOOLEAN
GIVETH A BOOLEAN
`s 18(b) a number of sitting days counts sitting days in the same or in different sessions` MEANS
    TRUE

§§ `18A Tabling of documents`

-- src:150 | (1) In an Act or statutory rule, a reference to tabling a document in a House of Parliament includes taking any action allowed or required under the Standing Rules or Orders of the House to table the document when the House is not sitting.
@ref s 18A(1) (src:150)
GIVEN `the House is sitting` IS A BOOLEAN
      `the action is allowed or required under the Standing Rules or Orders of the House to table the document when the House is not sitting` IS A BOOLEAN
GIVETH A MAYBE BOOLEAN
`s 18A(1) the reference to tabling a document in a House includes taking the action` MEANS
    IF (NOT `the House is sitting`) AND `the action is allowed or required under the Standing Rules or Orders of the House to table the document when the House is not sitting`
    THEN JUST TRUE
    ELSE NOTHING

-- src:151 | (2) This section applies in relation to the tabling of a document before or after the commencement of this section.
@ref s 18A(2) (src:151)
GIVEN `the tabling is before the commencement of section 18A` IS A BOOLEAN
GIVETH A BOOLEAN
`s 18A(2) section 18A applies in relation to the tabling` MEANS
    TRUE

§§ `19 Holders of offices`

-- src:154 | (1) In any Act or instrument, a reference to a particular officer or to the holder of a particular office includes a reference to the person for the time being occupying or acting in the office concerned.
@ref s 19(1) (src:154)
GIVEN `the person is for the time being occupying the office` IS A BOOLEAN
      `the person is for the time being acting in the office` IS A BOOLEAN
GIVETH A MAYBE BOOLEAN
`s 19(1) the reference to the officer or the holder of the office includes a reference to the person` MEANS
    IF `the person is for the time being occupying the office` OR `the person is for the time being acting in the office`
    THEN JUST TRUE
    ELSE NOTHING

-- The three words section 19(2) speaks of.
DECLARE ChairWord IS ONE OF
    Chairperson
    Chairman
    Chairwoman

-- src:155 | (2) The office of chairperson, chairman or chairwoman may be referred to by whichever of those words is appropriate in relation to the particular holder of that office.
@ref s 19(2) (src:155)
GIVEN word IS A ChairWord
      `the word is appropriate in relation to the particular holder` IS A BOOLEAN
GIVETH A MAYBE BOOLEAN
`s 19(2) the office may be referred to by the word` MEANS
    IF `the word is appropriate in relation to the particular holder` THEN JUST TRUE ELSE NOTHING

§§ `Tests: sections 13 to 19`

-- s 13
#ASSERT `s 13 what the reference to the Sovereign or the Crown is a reference to` AReferenceToTheSovereign EQUALS JUST TheSovereignForTheTimeBeing
#ASSERT `s 13 what the reference to the Sovereign or the Crown is a reference to` AReferenceToTheCrown EQUALS JUST TheCrownInRightOfNewSouthWales
#ASSERT `s 13 what the reference to the Sovereign or the Crown is a reference to` AReferenceToSomethingElse EQUALS NOTHING
-- s 13A
#ASSERT `s 13A(1) the body has the status, privileges and immunities of the Crown` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 13A(1) the body has the status, privileges and immunities of the Crown` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 13A(1) the body has the status, privileges and immunities of the Crown` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 13A(2) the body has the status, privileges and immunities of the Crown` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 13A(2) the body has the status, privileges and immunities of the Crown` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 13A(2) the body has the status, privileges and immunities of the Crown` FALSE FALSE EQUALS NOTHING
#ASSERT `s 13A(3) section 13A extends to` AProvisionMadeForThePurposesOfAnyActOrMoreGenerally EQUALS JUST TRUE
#ASSERT `s 13A(3) section 13A extends to` PrivilegesAndImmunitiesConferredExpresslyOrByConstruction EQUALS JUST TRUE
#ASSERT `s 13A(3) section 13A extends to` ASomethingElseNotListedInSection13A3 EQUALS NOTHING
#ASSERT `s 13A(4) the reference includes a reference to the body` ANswGovernmentAgency AStatutoryBodyRepresentingTheCrown EQUALS JUST TRUE
#ASSERT `s 13A(4) the reference includes a reference to the body` AStatutoryBodyRepresentingTheCrown ANswGovernmentAgency EQUALS JUST TRUE
#ASSERT `s 13A(4) the reference includes a reference to the body` ANswGovernmentAgency ANswGovernmentAgency EQUALS NOTHING
#ASSERT `s 13A(5) in section 13A the Crown includes` TheState EQUALS JUST TRUE
#ASSERT `s 13A(5) in section 13A the Crown includes` TheGovernmentOfTheState EQUALS JUST TRUE
#ASSERT `s 13A(5) in section 13A the Crown includes` AnotherBodyNotNamedInSection13A5 EQUALS NOTHING
-- s 14
#ASSERT `s 14 a reference to the Governor is a reference to it` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 14 a reference to the Governor is a reference to it` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 14 a reference to the Governor is a reference to it` FALSE FALSE EQUALS NOTHING
-- s 15
#ASSERT `s 15(1)(a) a reference to a Minister is a reference to it` TRUE EQUALS JUST TRUE
#ASSERT `s 15(1)(a) a reference to a Minister is a reference to it` FALSE EQUALS NOTHING
#ASSERT `s 15(1)(b) a reference to a particular Minister includes a reference to the other Minister` TRUE EQUALS JUST TRUE
#ASSERT `s 15(1)(b) a reference to a particular Minister includes a reference to the other Minister` FALSE EQUALS NOTHING
#ASSERT `s 15(2) the Minister to whom a reference to the Minister in an Act is a reference` FALSE FALSE FALSE EQUALS JUST TheMinisterAdministeringTheAct
#ASSERT `s 15(2) the Minister to whom a reference to the Minister in an Act is a reference` TRUE FALSE FALSE EQUALS JUST TheMinisterAdministeringInTheRelevantRespect
#ASSERT `s 15(2) the Minister to whom a reference to the Minister in an Act is a reference` TRUE FALSE TRUE EQUALS JUST TheMinisterAdministeringInTheRelevantRespect
#ASSERT `s 15(2) the Minister to whom a reference to the Minister in an Act is a reference` FALSE TRUE FALSE EQUALS JUST TheMinisterAdministeringTheRelevantPortion
#ASSERT `s 15(2) the Minister to whom a reference to the Minister in an Act is a reference` FALSE FALSE TRUE EQUALS JUST AnyOneOfTheMinistersAdministering
-- paragraphs (b) and (c) both applying: the text does not say which prevails
#ASSERT `s 15(2) the Minister to whom a reference to the Minister in an Act is a reference` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 15(3) the Minister to whom a reference to the Minister in an instrument is a reference` FALSE FALSE FALSE EQUALS JUST TheMinisterAdministeringTheAct
#ASSERT `s 15(3) the Minister to whom a reference to the Minister in an instrument is a reference` FALSE TRUE FALSE EQUALS JUST TheMinisterAdministeringTheRelevantPortion
#ASSERT `s 15(3) the Minister to whom a reference to the Minister in an instrument is a reference` FALSE FALSE TRUE EQUALS JUST AnyOneOfTheMinistersAdministering
#ASSERT `s 15(4) the Minister to whom a reference to the Minister administering another Act is a reference` TRUE FALSE FALSE EQUALS JUST TheMinisterAdministeringInTheRelevantRespect
#ASSERT `s 15(4) the Minister to whom a reference to the Minister administering another Act is a reference` FALSE FALSE FALSE EQUALS JUST TheMinisterAdministeringTheAct
#ASSERT `s 15(4) the Minister to whom a reference to the Minister administering another Act is a reference` FALSE TRUE TRUE EQUALS JUST TheMinisterAdministeringTheRelevantPortion
-- s 16
#ASSERT `s 16(1)(a) a reference to a British subject is a reference to it` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 16(1)(a) a reference to a British subject is a reference to it` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 16(1)(a) a reference to a British subject is a reference to it` FALSE FALSE EQUALS NOTHING
#ASSERT `s 16(1)(b) a reference to an alien is a reference to it` TRUE EQUALS JUST TRUE
#ASSERT `s 16(1)(b) a reference to an alien is a reference to it` FALSE EQUALS NOTHING
#ASSERT `s 16(2) the rule of law applies to the person as if the person were a British subject` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 16(2) the rule of law applies to the person as if the person were a British subject` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 16(2) the rule of law applies to the person as if the person were a British subject` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 16(3) the rule of law applies to the person as if the person were an alien` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 16(3) the rule of law applies to the person as if the person were an alien` FALSE TRUE EQUALS JUST FALSE
#ASSERT count `s 16(4) the relevant Commonwealth law consists of` EQUALS 2
-- s 17
#ASSERT `s 17 the seal the reference shall be read as a reference to` TheGreatSealOfTheState EQUALS JUST "the Public Seal of the State"
#ASSERT `s 17 the seal the reference shall be read as a reference to` TheSealOfTheState EQUALS JUST "the Public Seal of the State"
#ASSERT `s 17 the seal the reference shall be read as a reference to` ASealNotNamedInSection17 EQUALS NOTHING
-- s 18
#ASSERT `s 18(a) the day is a sitting day in relation to the House` AnActText TRUE EQUALS JUST TRUE
#ASSERT `s 18(a) the day is a sitting day in relation to the House` AStatutoryRuleText FALSE EQUALS JUST FALSE
#ASSERT `s 18(a) the day is a sitting day in relation to the House` AnotherInstrumentText TRUE EQUALS NOTHING
#ASSERT `s 18(b) a number of sitting days counts sitting days in the same or in different sessions` TRUE EQUALS TRUE
#ASSERT `s 18(b) a number of sitting days counts sitting days in the same or in different sessions` FALSE EQUALS TRUE
-- s 18A
#ASSERT `s 18A(1) the reference to tabling a document in a House includes taking the action` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 18A(1) the reference to tabling a document in a House includes taking the action` TRUE TRUE EQUALS NOTHING
#ASSERT `s 18A(1) the reference to tabling a document in a House includes taking the action` FALSE FALSE EQUALS NOTHING
#ASSERT `s 18A(2) section 18A applies in relation to the tabling` TRUE EQUALS TRUE
#ASSERT `s 18A(2) section 18A applies in relation to the tabling` FALSE EQUALS TRUE
-- s 19
#ASSERT `s 19(1) the reference to the officer or the holder of the office includes a reference to the person` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 19(1) the reference to the officer or the holder of the office includes a reference to the person` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 19(1) the reference to the officer or the holder of the office includes a reference to the person` FALSE FALSE EQUALS NOTHING
#ASSERT `s 19(2) the office may be referred to by the word` Chairman TRUE EQUALS JUST TRUE
#ASSERT `s 19(2) the office may be referred to by the word` Chairwoman FALSE EQUALS NOTHING
