IMPORT prelude
IMPORT daydate
IMPORT `nsw-interpretation-time`

-- Interpretation Act 1987 (New South Wales), Schedule 4 Dictionary: the definitions that decide something, written as functions.
-- The table of every defined term, as printed, is nsw-dictionary.l4; this module holds the definitions whose words can be run.
-- "means" definitions answer TRUE or FALSE, because the text closes them. "includes" definitions answer NOTHING outside their list.
-- Terms that depend on other Acts (the Bankruptcy Act 1966, the Mental Health Act 2007) take the borrowed fact as a plain input.

§ `Schedule 4 Dictionary: definitions that decide something`

§§ `Terms that include other things`

-- A term, and what the text says it includes. Each row is one "includes" entry of the Dictionary.
DECLARE IncludedMeaning HAS
    includingTerm IS A STRING
    includedWords IS A LIST OF STRING

-- src:940 | affidavit, in the case of persons for the time being allowed by law to affirm, declare or promise, includes affirmation, declaration and promise.
@ref Schedule 4 includes: affidavit (src:940)
`Schedule 4 includes entry: affidavit` MEANS IncludedMeaning OF "affidavit", (LIST "affirmation", "declaration", "promise")

-- src:1059 | oath, in the case of persons for the time being allowed by law to affirm, declare or promise, includes affirmation, declaration and promise.
@ref Schedule 4 includes: oath (src:1059)
`Schedule 4 includes entry: oath` MEANS IncludedMeaning OF "oath", (LIST "affirmation", "declaration", "promise")

-- src:1103 | swear, in the case of persons for the time being allowed by law to affirm, declare or promise, includes affirm, declare and promise.
@ref Schedule 4 includes: swear (src:1103)
`Schedule 4 includes entry: swear` MEANS IncludedMeaning OF "swear", (LIST "affirm", "declare", "promise")

-- src:943 | amend, in relation to an Act or instrument, includes alter and vary.
@ref Schedule 4 includes: amend (src:943)
`Schedule 4 includes entry: amend` MEANS IncludedMeaning OF "amend", (LIST "alter", "vary")

-- src:984 | contravene includes fail to comply with.
@ref Schedule 4 includes: contravene (src:984)
`Schedule 4 includes entry: contravene` MEANS IncludedMeaning OF "contravene", (LIST "fail to comply with")

-- src:1008 | estate includes interest, charge, right, title, claim, demand, lien and encumbrance, whether at law or in equity.
@ref Schedule 4 includes: estate (src:1008)
`Schedule 4 includes entry: estate` MEANS IncludedMeaning OF "estate", (LIST "interest", "charge", "right", "title", "claim", "demand", "lien", "encumbrance")

-- src:1031 | land includes messuages, tenements and hereditaments, corporeal and incorporeal, of any tenure or description, and whatever may be the estate or interest therein.
@ref Schedule 4 includes: land (src:1031)
`Schedule 4 includes entry: land` MEANS IncludedMeaning OF "land", (LIST "messuages", "tenements", "hereditaments")

-- src:1039 | make, in relation to an instrument, includes issue and grant.
@ref Schedule 4 includes: make (src:1039)
`Schedule 4 includes entry: make` MEANS IncludedMeaning OF "make", (LIST "issue", "grant")

-- src:1060 | office includes position.
@ref Schedule 4 includes: office (src:1060)
`Schedule 4 includes entry: office` MEANS IncludedMeaning OF "office", (LIST "position")

-- src:1064 | penalty includes forfeiture and punishment.
@ref Schedule 4 includes: penalty (src:1064)
`Schedule 4 includes entry: penalty` MEANS IncludedMeaning OF "penalty", (LIST "forfeiture", "punishment")

-- src:1083 | repeal, in relation to an instrument, includes revoke and rescind.
@ref Schedule 4 includes: repeal (src:1083)
`Schedule 4 includes entry: repeal` MEANS IncludedMeaning OF "repeal", (LIST "revoke", "rescind")

-- src:1088 | sign includes the affixing of a seal and the making of a mark.
@ref Schedule 4 includes: sign (src:1088)
`Schedule 4 includes entry: sign` MEANS IncludedMeaning OF "sign", (LIST "the affixing of a seal", "the making of a mark")

-- src:1110 | writing includes printing, photography, photocopying, lithography, typewriting and any other mode of representing or reproducing words in visible form.
@ref Schedule 4 includes: writing (src:1110)
`Schedule 4 includes entry: writing` MEANS IncludedMeaning OF "writing", (LIST "printing", "photography", "photocopying", "lithography", "typewriting")

-- src:1078 | property means any legal or equitable estate or interest (whether present or future and whether vested or contingent) in real or personal property of any description, including money, and includes things in action.
@ref Schedule 4 includes: property (src:1078)
`Schedule 4 includes entry: property` MEANS IncludedMeaning OF "property", (LIST "things in action")

-- src:1066 | person includes an individual, a corporation and a body corporate or politic.
@ref Schedule 4 includes: person (src:1066)
`Schedule 4 includes entry: person` MEANS IncludedMeaning OF "person", (LIST "an individual", "a corporation", "a body corporate or politic")

-- src:1063 | party includes an individual, a corporation and a body corporate or politic.
@ref Schedule 4 includes: party (src:1063)
`Schedule 4 includes entry: party` MEANS IncludedMeaning OF "party", (LIST "an individual", "a corporation", "a body corporate or politic")

`Schedule 4 the terms that include other things` MEANS
    LIST
        `Schedule 4 includes entry: affidavit`,
        `Schedule 4 includes entry: oath`,
        `Schedule 4 includes entry: swear`,
        `Schedule 4 includes entry: amend`,
        `Schedule 4 includes entry: contravene`,
        `Schedule 4 includes entry: estate`,
        `Schedule 4 includes entry: land`,
        `Schedule 4 includes entry: make`,
        `Schedule 4 includes entry: office`,
        `Schedule 4 includes entry: penalty`,
        `Schedule 4 includes entry: repeal`,
        `Schedule 4 includes entry: sign`,
        `Schedule 4 includes entry: writing`,
        `Schedule 4 includes entry: property`,
        `Schedule 4 includes entry: person`,
        `Schedule 4 includes entry: party`

GIVEN term IS A STRING
      word IS A STRING
GIVETH A MAYBE BOOLEAN
`Schedule 4 the term includes the word` MEANS
    IF null found
    THEN NOTHING
    ELSE IF elem word (at found 0) THEN JUST TRUE ELSE NOTHING
    WHERE
        found MEANS map (GIVEN r YIELD r's includedWords) (filter (GIVEN r YIELD r's includingTerm EQUALS term) `Schedule 4 the terms that include other things`)

§§ `Months`

-- src:1046 | named month means January, February, March, April, May, June, July, August, September, October, November or December.
@ref Schedule 4 named month (src:1046)
GIVEN word IS A STRING
GIVETH A BOOLEAN
`Schedule 4 the word is a named month` MEANS
    elem word (LIST "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December")

DECLARE NamedMonthWithItsNumber HAS
    monthText IS A STRING
    monthNumber IS A NUMBER

-- src:1046 | named month means January, February, March, April, May, June, July, August, September, October, November or December.
@ref Schedule 4 named month number (src:1046)
`Schedule 4 the twelve named months in order` MEANS
    LIST
        (NamedMonthWithItsNumber OF "January", 1),
        (NamedMonthWithItsNumber OF "February", 2),
        (NamedMonthWithItsNumber OF "March", 3),
        (NamedMonthWithItsNumber OF "April", 4),
        (NamedMonthWithItsNumber OF "May", 5),
        (NamedMonthWithItsNumber OF "June", 6),
        (NamedMonthWithItsNumber OF "July", 7),
        (NamedMonthWithItsNumber OF "August", 8),
        (NamedMonthWithItsNumber OF "September", 9),
        (NamedMonthWithItsNumber OF "October", 10),
        (NamedMonthWithItsNumber OF "November", 11),
        (NamedMonthWithItsNumber OF "December", 12)

GIVEN word IS A STRING
GIVETH A MAYBE NUMBER
`Schedule 4 the number of the named month` MEANS
    IF null found THEN NOTHING ELSE JUST ((at found 0)'s monthNumber)
    WHERE
        found MEANS filter (GIVEN m YIELD m's monthText EQUALS word) `Schedule 4 the twelve named months in order`

§§ `Individuals and minors`

-- src:1022 | individual means a natural person.
@ref Schedule 4 individual (src:1022)
GIVEN `the person is a natural person` IS A BOOLEAN
GIVETH A BOOLEAN
`Schedule 4 the person is an individual` MEANS
    `the person is a natural person`

-- src:1043 | minor means an individual who is under the age of 18 years.
@ref Schedule 4 minor (src:1043)
GIVEN `the person is a natural person` IS A BOOLEAN
      `the date of birth` IS A DATE
      `the moment asked about` IS A DayPoint
GIVETH A MAYBE BOOLEAN
`Schedule 4 the person is a minor at the moment` MEANS
    IF NOT `the person is a natural person`
    THEN JUST FALSE
    ELSE `s 37 the person is under the age of n years at a moment` `the date of birth` 18 `the moment asked about`

§§ `Offences`

-- src:1021 | indictable offence means an offence for which proceedings may be taken on indictment, whether or not proceedings for the offence may also be taken otherwise than on indictment.
@ref Schedule 4 indictable offence (src:1021)
GIVEN `proceedings for the offence may be taken on indictment` IS A BOOLEAN
GIVETH A BOOLEAN
`Schedule 4 the offence is an indictable offence` MEANS
    `proceedings for the offence may be taken on indictment`

-- src:1100 | summary offence means an offence that is not an indictable offence.
@ref Schedule 4 summary offence (src:1100)
GIVEN `proceedings for the offence may be taken on indictment` IS A BOOLEAN
GIVETH A BOOLEAN
`Schedule 4 the offence is a summary offence` MEANS
    NOT `Schedule 4 the offence is an indictable offence` `proceedings for the offence may be taken on indictment`

-- src:1085 | serious indictable offence means an indictable offence that is punishable by imprisonment for life or for a term of 5 years or more.
@ref Schedule 4 serious indictable offence (src:1085)
GIVEN `proceedings for the offence may be taken on indictment` IS A BOOLEAN
      `the offence is punishable by imprisonment for life` IS A BOOLEAN
      `the term of imprisonment in years for which the offence is punishable` IS A NUMBER
GIVETH A BOOLEAN
`Schedule 4 the offence is a serious indictable offence` MEANS
    `Schedule 4 the offence is an indictable offence` `proceedings for the offence may be taken on indictment` AND (`the offence is punishable by imprisonment for life` OR `the term of imprisonment in years for which the offence is punishable` AT LEAST 5)

-- src:1044 | minor indictable offence means an indictable offence that is not a serious indictable offence.
@ref Schedule 4 minor indictable offence (src:1044)
GIVEN `proceedings for the offence may be taken on indictment` IS A BOOLEAN
      `the offence is punishable by imprisonment for life` IS A BOOLEAN
      `the term of imprisonment in years for which the offence is punishable` IS A NUMBER
GIVETH A BOOLEAN
`Schedule 4 the offence is a minor indictable offence` MEANS
    `Schedule 4 the offence is an indictable offence` `proceedings for the offence may be taken on indictment` AND (NOT `Schedule 4 the offence is a serious indictable offence` `proceedings for the offence may be taken on indictment` `the offence is punishable by imprisonment for life` `the term of imprisonment in years for which the offence is punishable`)

§§ `Statutory rule`

DECLARE KindOfInstrumentForTheDictionary IS ONE OF
    ARegulationByLawRuleOrOrdinanceMadeByTheGovernor
    ARegulationByLawRuleOrOrdinanceMadeByAnotherButRequiredByLawToBeApprovedOrConfirmedByTheGovernor
    ARuleOfCourtForTheDictionary
    SomeOtherKindOfInstrumentForTheDictionary

-- src:1095 | statutory rule means—
-- src:1096 | (a) a regulation, by-law, rule or ordinance—
-- src:1097 | (i) that is made by the Governor, or
-- src:1098 | (ii) that is made by a person or body other than the Governor, but is required by law to be approved or confirmed by the Governor, or
-- src:1099 | (b) a rule of court.
@ref Schedule 4 statutory rule (src:1095-1099)
GIVEN kind IS A KindOfInstrumentForTheDictionary
GIVETH A BOOLEAN
`Schedule 4 the instrument is a statutory rule` MEANS
    CONSIDER kind
    WHEN ARegulationByLawRuleOrOrdinanceMadeByTheGovernor THEN TRUE
    WHEN ARegulationByLawRuleOrOrdinanceMadeByAnotherButRequiredByLawToBeApprovedOrConfirmedByTheGovernor THEN TRUE
    WHEN ARuleOfCourtForTheDictionary THEN TRUE
    WHEN SomeOtherKindOfInstrumentForTheDictionary THEN FALSE

§§ `Insolvency and incapacity`

-- src:1067 | personally insolvent, for an individual, means the individual—
-- src:1068 | (a) under the Bankruptcy Act 1966 of the Commonwealth—
-- src:1069 | (i) is bankrupt, or
-- src:1070 | (ii) is a party to a debt agreement as a debtor, or
-- src:1071 | (iii) is a party to a personal insolvency agreement as a debtor and the obligations created by the agreement remain undischarged, or
-- src:1072 | (iv) authorises a controlling trustee to control the individual's property, whether or not the individual has entered into a personal insolvency agreement as a debtor, or
-- src:1073 | (b) has a status under a law of a foreign country substantially similar to an individual referred to in paragraph (a), or
-- src:1074 | (c) otherwise applies to take the benefit of a law for the relief of bankrupt or insolvent debtors.
@ref Schedule 4 personally insolvent (src:1067-1074)
GIVEN `the person is an individual` IS A BOOLEAN
      `under the Bankruptcy Act 1966 of the Commonwealth the individual is bankrupt` IS A BOOLEAN
      `under that Act the individual is a party to a debt agreement as a debtor` IS A BOOLEAN
      `under that Act the individual is a party to a personal insolvency agreement as a debtor and the obligations created by the agreement remain undischarged` IS A BOOLEAN
      `under that Act the individual authorises a controlling trustee to control the individual's property` IS A BOOLEAN
      `the individual has a status under a law of a foreign country substantially similar to an individual referred to in paragraph (a)` IS A BOOLEAN
      `the individual otherwise applies to take the benefit of a law for the relief of bankrupt or insolvent debtors` IS A BOOLEAN
GIVETH A BOOLEAN
`Schedule 4 the individual is personally insolvent` MEANS
        `the person is an individual`
    AND (   `under the Bankruptcy Act 1966 of the Commonwealth the individual is bankrupt`
         OR `under that Act the individual is a party to a debt agreement as a debtor`
         OR `under that Act the individual is a party to a personal insolvency agreement as a debtor and the obligations created by the agreement remain undischarged`
         OR `under that Act the individual authorises a controlling trustee to control the individual's property`
         OR `the individual has a status under a law of a foreign country substantially similar to an individual referred to in paragraph (a)`
         OR `the individual otherwise applies to take the benefit of a law for the relief of bankrupt or insolvent debtors`)

-- src:1041 | mentally incapacitated person means a person who is an involuntary patient or a forensic patient or a correctional patient within the meaning of the Mental Health Act 2007, or a protected person within the meaning of the NSW Trustee and Guardian Act 2009.
@ref Schedule 4 mentally incapacitated person (src:1041)
GIVEN `the person is an involuntary patient within the meaning of the Mental Health Act 2007` IS A BOOLEAN
      `the person is a forensic patient within the meaning of the Mental Health Act 2007` IS A BOOLEAN
      `the person is a correctional patient within the meaning of the Mental Health Act 2007` IS A BOOLEAN
      `the person is a protected person within the meaning of the NSW Trustee and Guardian Act 2009` IS A BOOLEAN
GIVETH A BOOLEAN
`Schedule 4 the person is a mentally incapacitated person` MEANS
    `the person is an involuntary patient within the meaning of the Mental Health Act 2007` OR `the person is a forensic patient within the meaning of the Mental Health Act 2007` OR `the person is a correctional patient within the meaning of the Mental Health Act 2007` OR `the person is a protected person within the meaning of the NSW Trustee and Guardian Act 2009`

§§ `Territories, Australia and the Commonwealth`

-- src:1028 | internal Territory means the Australian Capital Territory, the Jervis Bay Territory or the Northern Territory.
@ref Schedule 4 internal Territory (src:1028)
GIVEN name IS A STRING
GIVETH A BOOLEAN
`Schedule 4 the Territory is an internal Territory` MEANS
    elem name (LIST "the Australian Capital Territory", "the Jervis Bay Territory", "the Northern Territory")

-- src:1010 | external Territory means a Territory, not being an internal Territory, for the government of which as a Territory provision is made by a Commonwealth Act.
@ref Schedule 4 external Territory (src:1010)
GIVEN `it is a Territory` IS A BOOLEAN
      `it is an internal Territory` IS A BOOLEAN
      `provision is made for the government of it as a Territory by a Commonwealth Act` IS A BOOLEAN
GIVETH A BOOLEAN
`Schedule 4 the Territory is an external Territory` MEANS
    `it is a Territory` AND (NOT `it is an internal Territory`) AND `provision is made for the government of it as a Territory by a Commonwealth Act`

-- src:952 | Australia means the Commonwealth of Australia but, when used in a geographical sense, does not include an external Territory.
@ref Schedule 4 Australia in a geographical sense (src:952)
GIVEN `the word Australia is used in a geographical sense` IS A BOOLEAN
      `the place is an external Territory` IS A BOOLEAN
GIVETH A MAYBE BOOLEAN
`Schedule 4 Australia includes the place` MEANS
    IF `the word Australia is used in a geographical sense` AND `the place is an external Territory` THEN JUST FALSE ELSE NOTHING

-- src:981 | Commonwealth means the Commonwealth of Australia but, when used in a geographical sense, does not include an external Territory.
@ref Schedule 4 Commonwealth in a geographical sense (src:981)
GIVEN `the word Commonwealth is used in a geographical sense` IS A BOOLEAN
      `the place is an external Territory` IS A BOOLEAN
GIVETH A MAYBE BOOLEAN
`Schedule 4 the Commonwealth includes the place` MEANS
    IF `the word Commonwealth is used in a geographical sense` AND `the place is an external Territory` THEN JUST FALSE ELSE NOTHING

-- src:1012 | foreign country means any country (whether or not an independent sovereign state) outside Australia and its external Territories.
@ref Schedule 4 foreign country (src:1012)
GIVEN `it is a country, whether or not an independent sovereign state` IS A BOOLEAN
      `it is outside Australia and its external Territories` IS A BOOLEAN
GIVETH A BOOLEAN
`Schedule 4 the place is a foreign country` MEANS
    `it is a country, whether or not an independent sovereign state` AND `it is outside Australia and its external Territories`

§§ `British Parliament`

DECLARE ParliamentNamed IS ONE OF
    TheParliamentOfEngland
    TheParliamentOfGreatBritain
    TheParliamentOfTheUnitedKingdomOfGreatBritainAndIreland
    TheParliamentOfTheUnitedKingdomOfGreatBritainAndNorthernIreland
    SomeOtherParliament

-- src:961 | British Parliament or Imperial Parliament means—
-- src:962 | (a) the Parliament of England,
-- src:963 | (b) the Parliament of Great Britain,
-- src:964 | (c) the Parliament of the United Kingdom of Great Britain and Ireland, or
-- src:965 | (d) the Parliament of the United Kingdom of Great Britain and Northern Ireland,
-- src:966 | as the case requires.
@ref Schedule 4 British Parliament (src:961-966)
GIVEN parliament IS A ParliamentNamed
GIVETH A BOOLEAN
`Schedule 4 the Parliament is the British Parliament or Imperial Parliament` MEANS
    CONSIDER parliament
    WHEN TheParliamentOfEngland THEN TRUE
    WHEN TheParliamentOfGreatBritain THEN TRUE
    WHEN TheParliamentOfTheUnitedKingdomOfGreatBritainAndIreland THEN TRUE
    WHEN TheParliamentOfTheUnitedKingdomOfGreatBritainAndNorthernIreland THEN TRUE
    WHEN SomeOtherParliament THEN FALSE

§§ `Documents, the Gazette and proclamations`

DECLARE KindOfRecord IS ONE OF
    AnythingOnWhichThereIsWriting
    AnythingOnWhichThereAreMarksFiguresSymbolsOrPerforationsHavingAMeaningForQualifiedPersons
    AnythingFromWhichSoundsImagesOrWritingsCanBeReproduced
    AMapPlanDrawingOrPhotograph
    AnyOtherRecordOfInformation
    SomethingThatIsNotARecordOfInformation

-- src:999 | document means any record of information, and includes—
-- src:1000 | (a) anything on which there is writing, or
-- src:1001 | (b) anything on which there are marks, figures, symbols or perforations having a meaning for persons qualified to interpret them, or
-- src:1002 | (c) anything from which sounds, images or writings can be reproduced with or without the aid of anything else, or
-- src:1003 | (d) a map, plan, drawing or photograph.
@ref Schedule 4 document (src:999-1003)
GIVEN kind IS A KindOfRecord
GIVETH A MAYBE BOOLEAN
`Schedule 4 the thing is a document` MEANS
    CONSIDER kind
    WHEN AnythingOnWhichThereIsWriting THEN JUST TRUE
    WHEN AnythingOnWhichThereAreMarksFiguresSymbolsOrPerforationsHavingAMeaningForQualifiedPersons THEN JUST TRUE
    WHEN AnythingFromWhichSoundsImagesOrWritingsCanBeReproduced THEN JUST TRUE
    WHEN AMapPlanDrawingOrPhotograph THEN JUST TRUE
    WHEN AnyOtherRecordOfInformation THEN JUST TRUE
    WHEN SomethingThatIsNotARecordOfInformation THEN NOTHING

-- src:1013 | Gazette, or Government Gazette, means the New South Wales Government Gazette published—
-- src:1014 | (a) in print, or
-- src:1015 | (b) on a website authorised by the Parliamentary Counsel to provide public access to the Gazette.
@ref Schedule 4 Gazette (src:1013-1015)
GIVEN `it is the New South Wales Government Gazette` IS A BOOLEAN
      `it is published in print` IS A BOOLEAN
      `it is published on a website authorised by the Parliamentary Counsel to provide public access to the Gazette` IS A BOOLEAN
GIVETH A BOOLEAN
`Schedule 4 the thing is the Gazette` MEANS
    `it is the New South Wales Government Gazette` AND (`it is published in print` OR `it is published on a website authorised by the Parliamentary Counsel to provide public access to the Gazette`)

-- src:1077 | proclamation means a proclamation of the Governor published in the Gazette or on the NSW legislation website.
@ref Schedule 4 proclamation (src:1077)
GIVEN `it is a proclamation of the Governor` IS A BOOLEAN
      `it is published in the Gazette` IS A BOOLEAN
      `it is published on the NSW legislation website` IS A BOOLEAN
GIVETH A BOOLEAN
`Schedule 4 the thing is a proclamation` MEANS
    `it is a proclamation of the Governor` AND (`it is published in the Gazette` OR `it is published on the NSW legislation website`)

§§ `Tests: Schedule 4 definitions`

-- terms that include other things: the list is not closed
#ASSERT `Schedule 4 the term includes the word` "affidavit" "affirmation" EQUALS JUST TRUE
#ASSERT `Schedule 4 the term includes the word` "oath" "promise" EQUALS JUST TRUE
#ASSERT `Schedule 4 the term includes the word` "swear" "declare" EQUALS JUST TRUE
#ASSERT `Schedule 4 the term includes the word` "amend" "alter" EQUALS JUST TRUE
#ASSERT `Schedule 4 the term includes the word` "amend" "vary" EQUALS JUST TRUE
#ASSERT `Schedule 4 the term includes the word` "amend" "repeal" EQUALS NOTHING
#ASSERT `Schedule 4 the term includes the word` "contravene" "fail to comply with" EQUALS JUST TRUE
#ASSERT `Schedule 4 the term includes the word` "estate" "lien" EQUALS JUST TRUE
#ASSERT `Schedule 4 the term includes the word` "estate" "mortgage" EQUALS NOTHING
#ASSERT `Schedule 4 the term includes the word` "land" "hereditaments" EQUALS JUST TRUE
#ASSERT `Schedule 4 the term includes the word` "make" "grant" EQUALS JUST TRUE
#ASSERT `Schedule 4 the term includes the word` "office" "position" EQUALS JUST TRUE
#ASSERT `Schedule 4 the term includes the word` "penalty" "forfeiture" EQUALS JUST TRUE
#ASSERT `Schedule 4 the term includes the word` "repeal" "rescind" EQUALS JUST TRUE
#ASSERT `Schedule 4 the term includes the word` "sign" "the making of a mark" EQUALS JUST TRUE
#ASSERT `Schedule 4 the term includes the word` "writing" "lithography" EQUALS JUST TRUE
#ASSERT `Schedule 4 the term includes the word` "property" "things in action" EQUALS JUST TRUE
#ASSERT `Schedule 4 the term includes the word` "person" "a body corporate or politic" EQUALS JUST TRUE
#ASSERT `Schedule 4 the term includes the word` "party" "a corporation" EQUALS JUST TRUE
#ASSERT `Schedule 4 the term includes the word` "person" "a partnership" EQUALS NOTHING
#ASSERT `Schedule 4 the term includes the word` "month" "week" EQUALS NOTHING
-- named months
#ASSERT `Schedule 4 the word is a named month` "February" EQUALS TRUE
#ASSERT `Schedule 4 the word is a named month` "Smarch" EQUALS FALSE
#ASSERT `Schedule 4 the number of the named month` "January" EQUALS JUST 1
#ASSERT `Schedule 4 the number of the named month` "May" EQUALS JUST 5
#ASSERT `Schedule 4 the number of the named month` "December" EQUALS JUST 12
#ASSERT `Schedule 4 the number of the named month` "Sept" EQUALS NOTHING
-- individuals and minors: a person born 15 March 2008 attains 18 at the beginning of 15 March 2026, which is the same instant as the end of 14 March 2026
#ASSERT `Schedule 4 the person is an individual` TRUE EQUALS TRUE
#ASSERT `Schedule 4 the person is an individual` FALSE EQUALS FALSE
#ASSERT `Schedule 4 the person is a minor at the moment` TRUE (Date 15 3 2008) (EndOfDay (Date 13 3 2026)) EQUALS JUST TRUE
#ASSERT `Schedule 4 the person is a minor at the moment` TRUE (Date 15 3 2008) (EndOfDay (Date 14 3 2026)) EQUALS JUST FALSE
#ASSERT `Schedule 4 the person is a minor at the moment` TRUE (Date 15 3 2008) (BeginningOfDay (Date 15 3 2026)) EQUALS JUST FALSE
#ASSERT `Schedule 4 the person is a minor at the moment` FALSE (Date 15 3 2008) (EndOfDay (Date 13 3 2026)) EQUALS JUST FALSE
#ASSERT `Schedule 4 the person is a minor at the moment` TRUE (Date 29 2 2008) (BeginningOfDay (Date 1 3 2026)) EQUALS NOTHING
-- offences
#ASSERT `Schedule 4 the offence is an indictable offence` TRUE EQUALS TRUE
#ASSERT `Schedule 4 the offence is a summary offence` FALSE EQUALS TRUE
#ASSERT `Schedule 4 the offence is a summary offence` TRUE EQUALS FALSE
#ASSERT `Schedule 4 the offence is a serious indictable offence` TRUE FALSE 5 EQUALS TRUE
#ASSERT `Schedule 4 the offence is a serious indictable offence` TRUE FALSE 4 EQUALS FALSE
#ASSERT `Schedule 4 the offence is a serious indictable offence` TRUE TRUE 0 EQUALS TRUE
#ASSERT `Schedule 4 the offence is a serious indictable offence` FALSE TRUE 10 EQUALS FALSE
#ASSERT `Schedule 4 the offence is a minor indictable offence` TRUE FALSE 4 EQUALS TRUE
#ASSERT `Schedule 4 the offence is a minor indictable offence` TRUE FALSE 5 EQUALS FALSE
#ASSERT `Schedule 4 the offence is a minor indictable offence` FALSE FALSE 1 EQUALS FALSE
-- statutory rule
#ASSERT `Schedule 4 the instrument is a statutory rule` ARegulationByLawRuleOrOrdinanceMadeByTheGovernor EQUALS TRUE
#ASSERT `Schedule 4 the instrument is a statutory rule` ARegulationByLawRuleOrOrdinanceMadeByAnotherButRequiredByLawToBeApprovedOrConfirmedByTheGovernor EQUALS TRUE
#ASSERT `Schedule 4 the instrument is a statutory rule` ARuleOfCourtForTheDictionary EQUALS TRUE
#ASSERT `Schedule 4 the instrument is a statutory rule` SomeOtherKindOfInstrumentForTheDictionary EQUALS FALSE
-- personally insolvent: any one of six, and only for an individual
#ASSERT `Schedule 4 the individual is personally insolvent` TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS TRUE
#ASSERT `Schedule 4 the individual is personally insolvent` TRUE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS TRUE
#ASSERT `Schedule 4 the individual is personally insolvent` TRUE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS TRUE
#ASSERT `Schedule 4 the individual is personally insolvent` TRUE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS TRUE
#ASSERT `Schedule 4 the individual is personally insolvent` TRUE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS TRUE
#ASSERT `Schedule 4 the individual is personally insolvent` TRUE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS TRUE
#ASSERT `Schedule 4 the individual is personally insolvent` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS FALSE
#ASSERT `Schedule 4 the individual is personally insolvent` FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS FALSE
-- mentally incapacitated person
#ASSERT `Schedule 4 the person is a mentally incapacitated person` TRUE FALSE FALSE FALSE EQUALS TRUE
#ASSERT `Schedule 4 the person is a mentally incapacitated person` FALSE TRUE FALSE FALSE EQUALS TRUE
#ASSERT `Schedule 4 the person is a mentally incapacitated person` FALSE FALSE TRUE FALSE EQUALS TRUE
#ASSERT `Schedule 4 the person is a mentally incapacitated person` FALSE FALSE FALSE TRUE EQUALS TRUE
#ASSERT `Schedule 4 the person is a mentally incapacitated person` FALSE FALSE FALSE FALSE EQUALS FALSE
-- Territories, Australia and the Commonwealth
#ASSERT `Schedule 4 the Territory is an internal Territory` "the Australian Capital Territory" EQUALS TRUE
#ASSERT `Schedule 4 the Territory is an internal Territory` "the Jervis Bay Territory" EQUALS TRUE
#ASSERT `Schedule 4 the Territory is an internal Territory` "the Northern Territory" EQUALS TRUE
#ASSERT `Schedule 4 the Territory is an internal Territory` "Norfolk Island" EQUALS FALSE
#ASSERT `Schedule 4 the Territory is an external Territory` TRUE FALSE TRUE EQUALS TRUE
#ASSERT `Schedule 4 the Territory is an external Territory` TRUE TRUE TRUE EQUALS FALSE
#ASSERT `Schedule 4 the Territory is an external Territory` TRUE FALSE FALSE EQUALS FALSE
