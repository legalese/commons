IMPORT prelude

-- Interpretation Act 1987 (New South Wales): the index of provisions.
--
-- One entry for each Part, section, subsection, paragraph, Schedule, Schedule clause,
-- term defined in the Dictionary or in the text, and Schedule table row, with the identifier
-- and the heading as the text file prints them.
-- Generated by a script that reads the text file (see NOTES.md).
-- "s 36" is the section printed "36"; "Schedule 3 clause 5" is the clause printed "5" under Schedule 3;
-- the prefixes only keep a section number apart from a clause number.
-- A subsection or paragraph prints no heading, so its heading is "" and printedUnder gives the heading of the
-- enclosing unit that prints one.

DECLARE ProvisionKind IS ONE OF
    APart
    ASchedule
    ASection
    AScheduleClause
    ASubsectionOrSubclause
    AParagraph
    ADictionaryTerm
    ATermDefinedInTheText
    ATableRow
    TheActItself

DECLARE Provision HAS
    identifier IS A STRING
    kind IS A ProvisionKind
    heading IS A STRING
    printedUnder IS A STRING
    firstLine IS A NUMBER
    lastLine IS A NUMBER

-- identifier, kind, heading, heading of the enclosing unit that prints one, first line, last line of the text file
`the provisions of the Act` MEANS
  LIST

