    (Provision OF "s 23(8) 'published'", ATermDefinedInTheText, "published", "Commencement of Acts", 236, 236),
    (Provision OF "s 13A(5) 'the Crown'", ATermDefinedInTheText, "the Crown", "NSW Government agencies and statutory bodies representing the Crown", 98, 98),
    (Provision OF "Schedule 3 clause 1(2) 'the appointed day'", ATermDefinedInTheText, "the appointed day", "Commencement of certain Acts", 897, 897),
    (Provision OF "Schedule 3 clause 12(4) 'Government Printer'", ATermDefinedInTheText, "Government Printer", "Acts Printed by the NSW Government Printer", 937, 937)


GIVEN id IS A STRING
GIVETH A MAYBE Provision
`the provision printed as` MEANS
    IF null found THEN NOTHING ELSE JUST (at found 0)
    WHERE
        found MEANS filter (GIVEN p YIELD p's identifier EQUALS id) `the provisions of the Act`

GIVEN id IS A STRING
GIVETH A MAYBE STRING
`the heading printed for` MEANS
    CONSIDER `the provision printed as` id
    WHEN NOTHING THEN NOTHING
    WHEN JUST p THEN JUST (p's heading)
