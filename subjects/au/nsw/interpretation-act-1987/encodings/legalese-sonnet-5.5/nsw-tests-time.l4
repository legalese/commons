IMPORT prelude
IMPORT daydate
IMPORT `nsw-interpretation-time`

-- Tests for nsw-interpretation-time.l4.
-- Every expected value below was worked out by hand from the quoted provision
-- (see the comment beside each assertion) before the file was run.
-- A start on a day is written "from" a given day throughout; section 36(1)
-- reckons the time exclusive of the given day, so the first day counted is the next day.

§ `Days: section 36(1)`

-- 30 days from 1 January 2026: the days counted are 2 January to 31 January.
#ASSERT `s 36(1) the first day counted in a period dating from a given day` (Date 1 1 2026) EQUALS Date 2 1 2026
#ASSERT `s 36(1) the last day of a period of n days dating from a given day` (Date 1 1 2026) 30 EQUALS JUST (Date 31 1 2026)
-- the given day itself is not counted, the first and last days are, the day after the last is not
#ASSERT `s 36(1) the day falls within a period of n days dating from a given day` (Date 1 1 2026) (Date 1 1 2026) 30 EQUALS JUST FALSE
#ASSERT `s 36(1) the day falls within a period of n days dating from a given day` (Date 1 1 2026) (Date 2 1 2026) 30 EQUALS JUST TRUE
#ASSERT `s 36(1) the day falls within a period of n days dating from a given day` (Date 1 1 2026) (Date 31 1 2026) 30 EQUALS JUST TRUE
#ASSERT `s 36(1) the day falls within a period of n days dating from a given day` (Date 1 1 2026) (Date 1 2 2026) 30 EQUALS JUST FALSE
-- a period of one day: the next day only; across a year end and a leap day
#ASSERT `s 36(1) the last day of a period of n days dating from a given day` (Date 31 12 2025) 1 EQUALS JUST (Date 1 1 2026)
#ASSERT `s 36(1) the last day of a period of n days dating from a given day` (Date 28 2 2024) 2 EQUALS JUST (Date 1 3 2024)
-- a period must be a positive whole number of days: otherwise the Act does not say
#ASSERT `s 36(1) the last day of a period of n days dating from a given day` (Date 1 1 2026) 0 EQUALS NOTHING
#ASSERT `s 36(1) the last day of a period of n days dating from a given day` (Date 1 1 2026) 2.5 EQUALS NOTHING
#ASSERT `s 36(1) the day falls within a period of n days dating from a given day` (Date 1 1 2026) (Date 2 1 2026) 0 EQUALS NOTHING

§ `Calendar months: Schedule 4 and section 36(1)`

-- The calendar month commencing at the beginning of 1 February 2024 ends immediately
-- before the beginning of 1 March 2024, that is on 29 February 2024.
#ASSERT `Schedule 4 the last day of the calendar month commencing at the beginning of a day` (Date 1 2 2024) EQUALS Date 29 2 2024
-- a month that lacks the start day's number: from 31 January the next named month has no 31st,
-- so limb (b): the end of the next named month
#ASSERT `Schedule 4 the last day of the calendar month commencing at the beginning of a day` (Date 31 1 2025) EQUALS Date 28 2 2025
#ASSERT `Schedule 4 the last day of the calendar month commencing at the beginning of a day` (Date 30 1 2025) EQUALS Date 28 2 2025
#ASSERT `Schedule 4 the last day of the calendar month commencing at the beginning of a day` (Date 29 1 2025) EQUALS Date 28 2 2025
#ASSERT `Schedule 4 the last day of the calendar month commencing at the beginning of a day` (Date 29 1 2024) EQUALS Date 28 2 2024
#ASSERT `Schedule 4 the last day of the calendar month commencing at the beginning of a day` (Date 30 1 2024) EQUALS Date 29 2 2024
-- limb (a): the corresponding day exists
#ASSERT `Schedule 4 the last day of the calendar month commencing at the beginning of a day` (Date 28 1 2025) EQUALS Date 27 2 2025
#ASSERT `Schedule 4 the last day of the calendar month commencing at the beginning of a day` (Date 15 1 2025) EQUALS Date 14 2 2025
#ASSERT `Schedule 4 the last day of the calendar month commencing at the beginning of a day` (Date 29 2 2024) EQUALS Date 28 3 2024
#ASSERT `Schedule 4 the last day of the calendar month commencing at the beginning of a day` (Date 1 12 2025) EQUALS Date 31 12 2025
#ASSERT `Schedule 4 the last day of the calendar month commencing at the beginning of a day` (Date 16 12 2025) EQUALS Date 15 1 2026
#ASSERT `Schedule 4 the last day of the calendar month commencing at the beginning of a day` (Date 31 12 2025) EQUALS Date 30 1 2026
-- a month commencing on 31 March: April has no 31st
#ASSERT `Schedule 4 the last day of the calendar month commencing at the beginning of a day` (Date 31 3 2025) EQUALS Date 30 4 2025
-- n successive months
#ASSERT `Schedule 4 the last day of n successive calendar months, the first commencing at the beginning of a day` (Date 1 1 2026) 2 EQUALS Date 28 2 2026
#ASSERT `Schedule 4 the last day of n successive calendar months, the first commencing at the beginning of a day` (Date 1 1 2026) 12 EQUALS Date 31 12 2026

-- The worked cases of the brief, in months.
-- one month from 31 January 2024: counted from 1 February 2024, ending 29 February 2024 (a Thursday)
#ASSERT `s 36(1) and Schedule 4 the last day of a period of n calendar months dating from a given day` (Date 31 1 2024) 1 EQUALS JUST (Date 29 2 2024)
-- two months from 31 December 2025: counted from 1 January 2026; January ends 31 January, February ends 28 February 2026 (a Saturday)
#ASSERT `s 36(1) and Schedule 4 the last day of a period of n calendar months dating from a given day` (Date 31 12 2025) 2 EQUALS JUST (Date 28 2 2026)
-- more starts: the first day counted is the day after the given day
#ASSERT `s 36(1) and Schedule 4 the last day of a period of n calendar months dating from a given day` (Date 15 1 2025) 1 EQUALS JUST (Date 15 2 2025)
#ASSERT `s 36(1) and Schedule 4 the last day of a period of n calendar months dating from a given day` (Date 27 2 2025) 1 EQUALS JUST (Date 27 3 2025)
#ASSERT `s 36(1) and Schedule 4 the last day of a period of n calendar months dating from a given day` (Date 28 2 2025) 1 EQUALS JUST (Date 31 3 2025)
#ASSERT `s 36(1) and Schedule 4 the last day of a period of n calendar months dating from a given day` (Date 28 2 2024) 1 EQUALS JUST (Date 28 3 2024)
#ASSERT `s 36(1) and Schedule 4 the last day of a period of n calendar months dating from a given day` (Date 29 2 2024) 1 EQUALS JUST (Date 31 3 2024)
#ASSERT `s 36(1) and Schedule 4 the last day of a period of n calendar months dating from a given day` (Date 30 4 2025) 1 EQUALS JUST (Date 31 5 2025)
#ASSERT `s 36(1) and Schedule 4 the last day of a period of n calendar months dating from a given day` (Date 30 1 2025) 1 EQUALS JUST (Date 28 2 2025)
#ASSERT `s 36(1) and Schedule 4 the last day of a period of n calendar months dating from a given day` (Date 30 11 2025) 1 EQUALS JUST (Date 31 12 2025)
#ASSERT `s 36(1) and Schedule 4 the last day of a period of n calendar months dating from a given day` (Date 15 12 2025) 1 EQUALS JUST (Date 15 1 2026)
#ASSERT `s 36(1) and Schedule 4 the last day of a period of n calendar months dating from a given day` (Date 29 1 2025) 2 EQUALS JUST (Date 31 3 2025)
-- not a positive whole number of months
#ASSERT `s 36(1) and Schedule 4 the last day of a period of n calendar months dating from a given day` (Date 31 1 2024) 0 EQUALS NOTHING
#ASSERT `s 36(1) and Schedule 4 the last day of a period of n calendar months dating from a given day` (Date 31 1 2024) 1.5 EQUALS NOTHING

§ `Years and weeks: the Dictionary has no entry for "year" or "week"`

-- The Dictionary defines "calendar year" (a period of 12 months commencing on 1 January) and
-- "month" (a calendar month), and has no entry for "year", "week" or "day".
-- three years from 16 July 2025
#ASSERT `s 36 the last day of a period of n units dating from a given day` (Date 16 7 2025) PeriodOfYears 3 EQUALS NOTHING
-- five years from 15 January 2025 and from 1 September 2025
#ASSERT `s 36 the last day of a period of n units dating from a given day` (Date 15 1 2025) PeriodOfYears 5 EQUALS NOTHING
#ASSERT `s 36 the last day of a period of n units dating from a given day` (Date 1 9 2025) PeriodOfYears 5 EQUALS NOTHING
-- one year from 29 February 2024
#ASSERT `s 36 the last day of a period of n units dating from a given day` (Date 29 2 2024) PeriodOfYears 1 EQUALS NOTHING
-- a week
#ASSERT `s 36 the last day of a period of n units dating from a given day` (Date 1 1 2026) PeriodOfWeeks 1 EQUALS NOTHING
-- calendar years: a period of 12 months commencing on 1 January
#ASSERT `s 36(1) and Schedule 4 the last day of a period of n calendar years dating from a given day` (Date 31 12 2025) 1 EQUALS JUST (Date 31 12 2026)
#ASSERT `s 36(1) and Schedule 4 the last day of a period of n calendar years dating from a given day` (Date 31 12 2025) 2 EQUALS JUST (Date 31 12 2027)
#ASSERT `s 36(1) and Schedule 4 the last day of a period of n calendar years dating from a given day` (Date 31 12 2023) 1 EQUALS JUST (Date 31 12 2024)
-- a period that does not commence on 1 January is not a calendar year
#ASSERT `s 36(1) and Schedule 4 the last day of a period of n calendar years dating from a given day` (Date 15 1 2025) 1 EQUALS NOTHING
#ASSERT `s 36(1) and Schedule 4 the last day of a period of n calendar years dating from a given day` (Date 31 12 2025) 0 EQUALS NOTHING
-- through the one entry point
#ASSERT `s 36 the last day of a period of n units dating from a given day` (Date 31 12 2025) PeriodOfCalendarYears 1 EQUALS JUST (Date 31 12 2026)
#ASSERT `s 36 the last day of a period of n units dating from a given day` (Date 1 1 2026) PeriodOfDays 30 EQUALS JUST (Date 31 1 2026)
#ASSERT `s 36 the last day of a period of n units dating from a given day` (Date 31 1 2024) PeriodOfMonths 1 EQUALS JUST (Date 29 2 2024)

§ `Rest days: section 36(2)`

-- 31 January 2026 is a Saturday, 1 February a Sunday, 2 February a Monday.
#ASSERT `s 36(2) the day is a Saturday, a Sunday, or a public holiday or bank holiday in the place` (Date 31 1 2026) EMPTY EQUALS TRUE
#ASSERT `s 36(2) the day is a Saturday, a Sunday, or a public holiday or bank holiday in the place` (Date 1 2 2026) EMPTY EQUALS TRUE
#ASSERT `s 36(2) the day is a Saturday, a Sunday, or a public holiday or bank holiday in the place` (Date 2 2 2026) EMPTY EQUALS FALSE
#ASSERT `s 36(2) the day is a Saturday, a Sunday, or a public holiday or bank holiday in the place` (Date 2 2 2026) (LIST (Date 2 2 2026)) EQUALS TRUE
-- thirty days from 1 January 2026 ends on Saturday 31 January 2026; the thing may be done on Monday 2 February 2026
#ASSERT `s 36(2) the latest day on which the thing may be done when the period ends on a day` (Date 31 1 2026) EMPTY EQUALS Date 2 2 2026
#ASSERT `s 36 the latest day on which a thing may be done within a period of n units dating from a given day` (Date 1 1 2026) PeriodOfDays 30 EMPTY EQUALS JUST (Date 2 2 2026)
-- if 2 February is a public holiday in the place, the first day following that is not a rest day is 3 February
#ASSERT `s 36 the latest day on which a thing may be done within a period of n units dating from a given day` (Date 1 1 2026) PeriodOfDays 30 (LIST (Date 2 2 2026)) EQUALS JUST (Date 3 2 2026)
-- the rule applies to the last day of a period in months as in days:
-- two months from 31 December 2025 ends on Saturday 28 February 2026; the thing may be done on Monday 2 March 2026
#ASSERT `s 36 the latest day on which a thing may be done within a period of n units dating from a given day` (Date 31 12 2025) PeriodOfMonths 2 EMPTY EQUALS JUST (Date 2 3 2026)
-- one month from 15 January 2025 ends on Saturday 15 February 2025; Monday 17 February 2025
#ASSERT `s 36 the latest day on which a thing may be done within a period of n units dating from a given day` (Date 15 1 2025) PeriodOfMonths 1 EMPTY EQUALS JUST (Date 17 2 2025)
-- one month from 31 January 2024 ends on Thursday 29 February 2024, which is not a rest day
#ASSERT `s 36 the latest day on which a thing may be done within a period of n units dating from a given day` (Date 31 1 2024) PeriodOfMonths 1 EMPTY EQUALS JUST (Date 29 2 2024)
-- a Friday that is a public holiday: the first following day that is not a rest day is Monday
#ASSERT `s 36(2) the latest day on which the thing may be done when the period ends on a day` (Date 6 3 2026) (LIST (Date 6 3 2026)) EQUALS Date 9 3 2026
-- a Friday that is not a holiday is itself the last day
#ASSERT `s 36(2) the latest day on which the thing may be done when the period ends on a day` (Date 6 3 2026) EMPTY EQUALS Date 6 3 2026
-- years are not covered, so neither is the rest-day rule for them
#ASSERT `s 36 the latest day on which a thing may be done within a period of n units dating from a given day` (Date 16 7 2025) PeriodOfYears 3 EMPTY EQUALS NOTHING

§ `The moment within a day: sections 24, 30D and 71, Schedule 4 midnight`

#ASSERT `s 24 the moment an Act or statutory rule commences on a particular day` AnAct (Date 5 3 2026) EQUALS JUST (BeginningOfDay (Date 5 3 2026))
#ASSERT `s 24 the moment an Act or statutory rule commences on a particular day` AStatutoryRule (Date 5 3 2026) EQUALS JUST (BeginningOfDay (Date 5 3 2026))
-- section 24 speaks of an Act or statutory rule only
#ASSERT `s 24 the moment an Act or statutory rule commences on a particular day` AnotherInstrument (Date 5 3 2026) EQUALS NOTHING
#ASSERT `s 30D the moment a repeal on a day takes effect` (Date 5 3 2026) EQUALS BeginningOfDay (Date 5 3 2026)
#ASSERT `s 71 the moment an Act or instrument expressed to expire or remain in force until a day stops operating` (Date 5 3 2026) EQUALS EndOfDay (Date 5 3 2026)
#ASSERT `Schedule 4 midnight in relation to a particular day` (Date 5 3 2026) EQUALS EndOfDay (Date 5 3 2026)
-- midnight of one day is the instant at which the next day begins
#ASSERT `the instant a day point denotes, counted in half days` (EndOfDay (Date 28 2 2026)) EQUALS `the instant a day point denotes, counted in half days` (BeginningOfDay (Date 1 3 2026))
#ASSERT `day point is no later than day point` (BeginningOfDay (Date 5 3 2026)) (EndOfDay (Date 5 3 2026)) EQUALS TRUE
#ASSERT `day point is no later than day point` (EndOfDay (Date 5 3 2026)) (BeginningOfDay (Date 5 3 2026)) EQUALS FALSE
#ASSERT `day point is no later than day point` (EndOfDay (Date 5 3 2026)) (BeginningOfDay (Date 6 3 2026)) EQUALS TRUE

§ `Commencement of Acts: section 23`

-- assent on Wednesday 10 June 2026: the day occurring 28 days after is Wednesday 8 July 2026
#ASSERT `s 23(1)(a) the day an Act commences when nothing else provides` (Date 10 6 2026) EQUALS Date 8 7 2026
#ASSERT `s 23(1)(a) the day an Act commences when nothing else provides` (Date 31 12 2025) EQUALS Date 28 1 2026
-- the window of section 23(2): no earlier than the date of assent, no later than 28 days after
#ASSERT `s 23(2) the day appointed is no earlier than the date of assent and no later than the day occurring 28 days after` (Date 10 6 2026) (Date 9 6 2026) EQUALS FALSE
#ASSERT `s 23(2) the day appointed is no earlier than the date of assent and no later than the day occurring 28 days after` (Date 10 6 2026) (Date 10 6 2026) EQUALS TRUE
#ASSERT `s 23(2) the day appointed is no earlier than the date of assent and no later than the day occurring 28 days after` (Date 10 6 2026) (Date 8 7 2026) EQUALS TRUE
#ASSERT `s 23(2) the day appointed is no earlier than the date of assent and no later than the day occurring 28 days after` (Date 10 6 2026) (Date 9 7 2026) EQUALS FALSE
-- section 23(1): the four ways an Act's commencement is fixed
#ASSERT `s 23(1) and (5) the day an Act commences` (Date 10 6 2026) NothingProvided EQUALS JUST (Date 8 7 2026)
#ASSERT `s 23(1) and (5) the day an Act commences` (Date 10 6 2026) (ProvidedFixedDay (Date 1 9 2026)) EQUALS JUST (Date 1 9 2026)
-- (b) by a proclamation under the Act: published on or before the day appointed, the day appointed; later, the day of publication (5)(a)
#ASSERT `s 23(1) and (5) the day an Act commences` (Date 10 6 2026) (ProvidedProclamation (Date 1 7 2026) (Date 30 6 2026)) EQUALS JUST (Date 1 7 2026)
#ASSERT `s 23(1) and (5) the day an Act commences` (Date 10 6 2026) (ProvidedProclamation (Date 1 7 2026) (Date 1 7 2026)) EQUALS JUST (Date 1 7 2026)
#ASSERT `s 23(1) and (5) the day an Act commences` (Date 10 6 2026) (ProvidedProclamation (Date 1 7 2026) (Date 5 7 2026)) EQUALS JUST (Date 5 7 2026)
-- (c) a proclamation under section 23(2): the earlier of the day of publication and the day the Act would have commenced without it
#ASSERT `s 23(1) and (5) the day an Act commences` (Date 10 6 2026) (AppointedUnderSubsection2 (Date 20 6 2026) (Date 19 6 2026)) EQUALS JUST (Date 20 6 2026)
#ASSERT `s 23(1) and (5) the day an Act commences` (Date 10 6 2026) (AppointedUnderSubsection2 (Date 20 6 2026) (Date 25 6 2026)) EQUALS JUST (Date 25 6 2026)
#ASSERT `s 23(1) and (5) the day an Act commences` (Date 10 6 2026) (AppointedUnderSubsection2 (Date 20 6 2026) (Date 8 7 2026)) EQUALS JUST (Date 8 7 2026)
#ASSERT `s 23(1) and (5) the day an Act commences` (Date 10 6 2026) (AppointedUnderSubsection2 (Date 20 6 2026) (Date 15 7 2026)) EQUALS JUST (Date 8 7 2026)
-- a day outside the window of section 23(2) is not a proclamation under that subsection
#ASSERT `s 23(1) and (5) the day an Act commences` (Date 10 6 2026) (AppointedUnderSubsection2 (Date 9 7 2026) (Date 1 7 2026)) EQUALS NOTHING

§ `Commencement of statutory rules: section 39`

#ASSERT `s 39(1)(b) and (2A) the day a statutory rule commences` (Date 5 3 2026) NOTHING EQUALS Date 5 3 2026
#ASSERT `s 39(1)(b) and (2A) the day a statutory rule commences` (Date 5 3 2026) (JUST (Date 10 3 2026)) EQUALS Date 10 3 2026
#ASSERT `s 39(1)(b) and (2A) the day a statutory rule commences` (Date 5 3 2026) (JUST (Date 5 3 2026)) EQUALS Date 5 3 2026
-- a day earlier than publication: section 39(2A), the day of publication
#ASSERT `s 39(1)(b) and (2A) the day a statutory rule commences` (Date 5 3 2026) (JUST (Date 1 3 2026)) EQUALS Date 5 3 2026

§ `Repeal of amending Acts: section 30C`

-- all provisions have commenced by 1 September 2026, assent 1 July 2026: repealed 2 September
#ASSERT `s 30C(2) and (3) the day an amending Act is repealed` (Date 1 7 2026) (Date 1 9 2026) EQUALS Date 2 9 2026
-- commenced before the date of assent: repealed the day after the date of assent
#ASSERT `s 30C(2) and (3) the day an amending Act is repealed` (Date 1 7 2026) (Date 1 6 2026) EQUALS Date 2 7 2026
-- commenced on the date of assent: not before it
#ASSERT `s 30C(2) and (3) the day an amending Act is repealed` (Date 1 7 2026) (Date 1 7 2026) EQUALS Date 2 7 2026
-- after 1 January 2009
#ASSERT `s 30C(6) the amending Act was enacted after 1 January 2009` (Date 31 12 2008) EQUALS FALSE
#ASSERT `s 30C(6) the amending Act was enacted after 1 January 2009` (Date 1 1 2009) EQUALS FALSE
#ASSERT `s 30C(6) the amending Act was enacted after 1 January 2009` (Date 2 1 2009) EQUALS TRUE

§ `Age: section 37`

-- born 15 June 2000: attains 18 at the beginning of 15 June 2018
#ASSERT `s 37 the moment a person attains an age in years` (Date 15 6 2000) 18 EQUALS JUST (BeginningOfDay (Date 15 6 2018))
#ASSERT `s 37 the moment a person attains an age in years` (Date 15 6 2000) 0 EQUALS JUST (BeginningOfDay (Date 15 6 2000))
-- born 29 February 2000: 2020 has a 29 February, 2018 does not, and the Act does not say which day is the birthday then
#ASSERT `s 37 the moment a person attains an age in years` (Date 29 2 2000) 20 EQUALS JUST (BeginningOfDay (Date 29 2 2020))
#ASSERT `s 37 the moment a person attains an age in years` (Date 29 2 2000) 18 EQUALS NOTHING
#ASSERT `s 37 the moment a person attains an age in years` (Date 15 6 2000) 18.5 EQUALS NOTHING
#ASSERT `s 37 the moment a person attains an age in years` (Date 15 6 2000) (0 MINUS 1) EQUALS NOTHING
-- under 18 just before and from the beginning of the birthday
#ASSERT `s 37 the person is under the age of n years at a moment` (Date 15 6 2000) 18 (EndOfDay (Date 13 6 2018)) EQUALS JUST TRUE
#ASSERT `s 37 the person is under the age of n years at a moment` (Date 15 6 2000) 18 (EndOfDay (Date 14 6 2018)) EQUALS JUST FALSE
#ASSERT `s 37 the person is under the age of n years at a moment` (Date 15 6 2000) 18 (BeginningOfDay (Date 15 6 2018)) EQUALS JUST FALSE
#ASSERT `s 37 the person is under the age of n years at a moment` (Date 29 2 2000) 18 (BeginningOfDay (Date 15 6 2018)) EQUALS NOTHING

§ `Working days, business days and sitting days`

-- Thursday 5 March 2026: Friday 6 is the 1st working day after; Monday 16 March is the 7th
#ASSERT `s 76(1)(b) the day service by post in Australia or an external Territory is taken to be effected` (Date 5 3 2026) EMPTY EQUALS Date 16 3 2026
-- Monday 9 March a public holiday in the place of address: the 7th working day is Tuesday 17 March
#ASSERT `s 76(1)(b) the day service by post in Australia or an external Territory is taken to be effected` (Date 5 3 2026) (LIST (Date 9 3 2026)) EQUALS Date 17 3 2026
-- posted on Saturday 7 March 2026: Monday 9 is the 1st working day after, Tuesday 17 the 7th
#ASSERT `s 76(1)(b) the day service by post in Australia or an external Territory is taken to be effected` (Date 7 3 2026) EMPTY EQUALS Date 17 3 2026
#ASSERT `s 76 the nth working day after a day` (Date 5 3 2026) 0 EMPTY EQUALS Date 5 3 2026
#ASSERT `s 76(2) the day is a working day` (Date 6 3 2026) EMPTY EQUALS TRUE
#ASSERT `s 76(2) the day is a working day` (Date 7 3 2026) EMPTY EQUALS FALSE
#ASSERT `s 76(2) the day is a working day` (Date 6 3 2026) (LIST (Date 6 3 2026)) EQUALS FALSE
#ASSERT `Schedule 4 the day is a business day` (Date 2 3 2026) EMPTY EQUALS TRUE
#ASSERT `Schedule 4 the day is a business day` (Date 1 3 2026) EMPTY EQUALS FALSE
#ASSERT `Schedule 4 the day is a business day` (Date 2 3 2026) (LIST (Date 2 3 2026)) EQUALS FALSE
-- sitting days 3, 4, 10, 11 and 17 March 2026
#ASSERT `s 18 the nth sitting day of a House after a day` (LIST (Date 10 3 2026), (Date 3 3 2026), (Date 17 3 2026), (Date 4 3 2026), (Date 11 3 2026)) (Date 3 3 2026) 1 EQUALS JUST (Date 4 3 2026)
#ASSERT `s 18 the nth sitting day of a House after a day` (LIST (Date 10 3 2026), (Date 3 3 2026), (Date 17 3 2026), (Date 4 3 2026), (Date 11 3 2026)) (Date 3 3 2026) 4 EQUALS JUST (Date 17 3 2026)
#ASSERT `s 18 the nth sitting day of a House after a day` (LIST (Date 10 3 2026), (Date 3 3 2026), (Date 17 3 2026), (Date 4 3 2026), (Date 11 3 2026)) (Date 2 3 2026) 1 EQUALS JUST (Date 3 3 2026)
-- fewer than n sitting days are known after the day
#ASSERT `s 18 the nth sitting day of a House after a day` (LIST (Date 10 3 2026), (Date 3 3 2026), (Date 17 3 2026), (Date 4 3 2026), (Date 11 3 2026)) (Date 3 3 2026) 5 EQUALS NOTHING
#ASSERT `s 18 the nth sitting day of a House after a day` (LIST (Date 10 3 2026), (Date 3 3 2026)) (Date 3 3 2026) 0 EQUALS NOTHING
