#ASSERT `What is the shortest time my offer can be open` `after mediation under the claims resolution process has concluded` EQUALS JUST 7
#ASSERT `What is the shortest time my offer can be open` `removed from the claims resolution process under clause 20, before an Issues and Listing Conference` EQUALS JUST 14
#ASSERT `What is the shortest time my offer can be open` `removed from the claims resolution process under clause 20, after an Issues and Listing Conference` EQUALS JUST 7
#ASSERT `What is the shortest time my offer can be open` `never in the claims resolution process (not an asbestos claim, or not made by or through the sufferer)` EQUALS NOTHING

-- Offer made Monday 1 February 2027. No time limited: 28 days after = Monday 1 March 2027. Limited to 14 days: 15 February.
#ASSERT `Until when can the offer be accepted` `1 Feb 2027` FALSE 0 FALSE `1 Feb 2027` EQUALS `the regulation date` 1 3 2027
#ASSERT `Until when can the offer be accepted` `1 Feb 2027` TRUE 14 FALSE `1 Feb 2027` EQUALS `the regulation date` 15 2 2027
-- The Tribunal begins its decision on 10 February: the final deadline comes first. On 20 March: the offer's own end comes first.
#ASSERT `Until when can the offer be accepted` `1 Feb 2027` FALSE 0 TRUE (`the regulation date` 10 2 2027) EQUALS `the regulation date` 10 2 2027
#ASSERT `Until when can the offer be accepted` `1 Feb 2027` FALSE 0 TRUE (`the regulation date` 20 3 2027) EQUALS `the regulation date` 1 3 2027

-- cl 89, 90. Inputs: who made it, accepted, comparison, before the first trial day, exceptional order.
#ASSERT `What costs order follows the offer` `I did` FALSE `more favourable to me than the offer` TRUE FALSE EQUALS `cl 89: your costs, on the party and party basis up to the start of the day after the offer and on the indemnity basis from then`
#ASSERT `What costs order follows the offer` `I did` FALSE `as favourable to me as the offer` FALSE FALSE EQUALS `cl 89: your costs, on the party and party basis up to 11 am on the day after the offer and on the indemnity basis from then`
#ASSERT `What costs order follows the offer` `I did` FALSE `less favourable to me than the offer` TRUE FALSE EQUALS `cl 89 does not apply: your judgment is less favourable to you than your offer`
#ASSERT `What costs order follows the offer` `I did` FALSE `more favourable to me than the offer` TRUE TRUE EQUALS `the Tribunal ordered otherwise, in an exceptional case to avoid substantial injustice, and must give its reasons`
#ASSERT `What costs order follows the offer` `the defendant did` FALSE `as favourable to me as the offer` TRUE FALSE EQUALS `cl 90: your costs on the party and party basis up to the start of the day after the offer; the defendant's costs, on the indemnity basis, from then`
#ASSERT `What costs order follows the offer` `the defendant did` FALSE `less favourable to me than the offer` FALSE FALSE EQUALS `cl 90: your costs on the party and party basis up to 11 am on the day after the offer; the defendant's costs, on the indemnity basis, from then`
#ASSERT `What costs order follows the offer` `the defendant did` FALSE `more favourable to me than the offer` TRUE FALSE EQUALS `cl 90 does not apply: your judgment is more favourable to you than the defendant's offer`
#ASSERT `What costs order follows the offer` `the defendant did` TRUE `less favourable to me than the offer` TRUE FALSE EQUALS `cl 89 and 90 do not apply: the offer was accepted (cl 92)`

-- cl 93. Accepted Monday 1 February 2027; 28 days to pay: day 28 is Monday 1 March.
-- Not paid: withdrawing on 1 March is too early; on Tuesday 2 March (day 29) the right has arisen.
#ASSERT `Can I withdraw my acceptance` `1 Feb 2027` FALSE 0 FALSE `1 Feb 2027` (`the regulation date` 1 3 2027) FALSE EQUALS `not yet: the time for payment or performance has not ended`
#ASSERT `Can I withdraw my acceptance` `1 Feb 2027` FALSE 0 FALSE `1 Feb 2027` (`the regulation date` 2 3 2027) FALSE EQUALS `yes: the money was not paid, or the act not done, within the time (cl 93(1)(a))`
-- Paid on 20 February (in time): no right without leave; with leave, yes.
#ASSERT `Can I withdraw my acceptance` `1 Feb 2027` FALSE 0 TRUE (`the regulation date` 20 2 2027) (`the regulation date` 10 3 2027) FALSE EQUALS `no: it was paid or done in time; only with the Tribunal's leave (cl 93(1)(b))`
#ASSERT `Can I withdraw my acceptance` `1 Feb 2027` FALSE 0 TRUE (`the regulation date` 20 2 2027) (`the regulation date` 10 3 2027) TRUE EQUALS `yes: the Tribunal granted leave (cl 93(1)(b))`
-- Paid on day 29 (2 March), late: read literally, the right under (a) has arisen (fork F11).
#ASSERT `Can I withdraw my acceptance` `1 Feb 2027` FALSE 0 TRUE (`the regulation date` 2 3 2027) (`the regulation date` 10 3 2027) FALSE EQUALS `yes: the money was not paid, or the act not done, within the time (cl 93(1)(a))`
-- Paid on day 28 (1 March), the last day: in time.
#ASSERT `Can I withdraw my acceptance` `1 Feb 2027` FALSE 0 TRUE (`the regulation date` 1 3 2027) (`the regulation date` 10 3 2027) FALSE EQUALS `no: it was paid or done in time; only with the Tribunal's leave (cl 93(1)(b))`
-- The offer gives 7 days: not paid, day 7 (8 February) too early; day 8 (9 February) the right has arisen.
#ASSERT `Can I withdraw my acceptance` `1 Feb 2027` TRUE 7 FALSE `1 Feb 2027` (`the regulation date` 8 2 2027) FALSE EQUALS `not yet: the time for payment or performance has not ended`
#ASSERT `Can I withdraw my acceptance` `1 Feb 2027` TRUE 7 FALSE `1 Feb 2027` (`the regulation date` 9 2 2027) FALSE EQUALS `yes: the money was not paid, or the act not done, within the time (cl 93(1)(a))`
-- Leave granted before the time ends.
#ASSERT `Can I withdraw my acceptance` `1 Feb 2027` FALSE 0 FALSE `1 Feb 2027` (`the regulation date` 3 2 2027) TRUE EQUALS `yes: the Tribunal granted leave (cl 93(1)(b))`
#ASSERT `What can I do if the defendant does not comply` TRUE EQUALS `you may elect either judgment or orders giving effect to the accepted offer, or that the defence be struck out and judgment entered (cl 94(2)), unless the Tribunal orders otherwise`
#ASSERT `What can I do if the defendant does not comply` FALSE EQUALS `cl 94(2) does not arise: the defendant has not failed to comply`
