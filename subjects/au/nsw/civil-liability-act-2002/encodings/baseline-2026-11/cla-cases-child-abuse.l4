#ASSERT `Does the proper defendant stand in for the organisation` FALSE FALSE EQUALS NOTHING
#ASSERT `Does the proper defendant stand in for the organisation` TRUE TRUE EQUALS NOTHING

-- s 6P(2): limited to the value of the trust property.
#ASSERT `The most I can recover from the trustees` 500000 300000 EQUALS 300000
#ASSERT `The most I can recover from the trustees` 200000 300000 EQUALS 200000
#ASSERT `The most I can recover from the trustees` 300000 300000 EQUALS 300000

§§ `Part 1C -- setting aside settlements`

-- s 7C. Arguments: kind of claim (s 3B), s 6A applies, the agreement stops me suing, day of agreement, day s 6A commenced, day Part 1B
-- commenced, limitation period expired, liable organisation unincorporated, the court's finding that the agreement is
-- not just and reasonable.
-- (a): before s 6A commenced and the period had expired.
#ASSERT `Is my settlement an affected agreement` `general` TRUE TRUE (`d` 1 1 2010) `s 6A commenced` `commenced` TRUE FALSE `undecided` EQUALS JUST TRUE
#ASSERT `Is my settlement an affected agreement` `general` TRUE TRUE (`d` 16 3 2016) `s 6A commenced` `commenced` TRUE FALSE `undecided` EQUALS JUST TRUE
-- On the day s 6A commenced, (a) fails; (c) is still open because Part 1B had not commenced.
#ASSERT `Is my settlement an affected agreement` `general` TRUE TRUE (`d` 17 3 2016) `s 6A commenced` `commenced` TRUE FALSE `undecided` EQUALS NOTHING
-- (b): before Part 1B and the organisation unincorporated; the commencement day and the day before.
#ASSERT `Is my settlement an affected agreement` `general` TRUE TRUE (`d` 1 1 2017) `s 6A commenced` `commenced` FALSE TRUE `undecided` EQUALS JUST TRUE
#ASSERT `Is my settlement an affected agreement` `general` TRUE TRUE (`d` 30 11 2018) `s 6A commenced` `commenced` FALSE TRUE `undecided` EQUALS JUST TRUE
#ASSERT `Is my settlement an affected agreement` `general` TRUE TRUE (`d` 1 12 2018) `s 6A commenced` `commenced` FALSE TRUE `so` EQUALS JUST FALSE
-- (c): the court's finding.
#ASSERT `Is my settlement an affected agreement` `general` TRUE TRUE (`d` 1 1 2017) `s 6A commenced` `commenced` FALSE FALSE `so` EQUALS JUST TRUE
#ASSERT `Is my settlement an affected agreement` `general` TRUE TRUE (`d` 1 1 2017) `s 6A commenced` `commenced` FALSE FALSE `not so` EQUALS JUST FALSE
#ASSERT `Is my settlement an affected agreement` `general` TRUE TRUE (`d` 1 1 2017) `s 6A commenced` `commenced` FALSE FALSE `undecided` EQUALS NOTHING
#ASSERT `Is my settlement an affected agreement` `general` TRUE TRUE (`d` 1 1 2010) `s 6A commenced` `commenced` FALSE FALSE `not so` EQUALS JUST FALSE
-- Not a s 6A cause of action; an agreement that does not stop the action.
#ASSERT `Is my settlement an affected agreement` `general` FALSE TRUE (`d` 1 1 2010) `s 6A commenced` `commenced` TRUE TRUE `so` EQUALS JUST FALSE
#ASSERT `Is my settlement an affected agreement` `general` TRUE FALSE (`d` 1 1 2010) `s 6A commenced` `commenced` TRUE TRUE `so` EQUALS JUST FALSE

-- s 3B and Part 1C (finding 2): read literally, s 3B(1)(a) and (f) do not except Part 1C, so a settlement of a claim
-- against the abuser personally for sexual assault, or of work injury damages, is not an affected agreement; for
-- vicarious liability the answer is open (fork F1) unless s 7C itself fails.
#ASSERT `Is my settlement an affected agreement` `against the abuser` TRUE TRUE (`d` 1 1 2010) `s 6A commenced` `commenced` TRUE FALSE `undecided` EQUALS JUST FALSE
#ASSERT `Is my settlement an affected agreement` `work injury` TRUE TRUE (`d` 1 1 2010) `s 6A commenced` `commenced` TRUE FALSE `undecided` EQUALS JUST FALSE
#ASSERT `Is my settlement an affected agreement` `vicarious` TRUE TRUE (`d` 1 1 2010) `s 6A commenced` `commenced` TRUE FALSE `undecided` EQUALS NOTHING
#ASSERT `Is my settlement an affected agreement` `vicarious` TRUE TRUE (`d` 1 1 2017) `s 6A commenced` `commenced` FALSE FALSE `not so` EQUALS JUST FALSE
#ASSERT `Is my settlement an affected agreement` `vicarious` FALSE TRUE (`d` 1 1 2010) `s 6A commenced` `commenced` TRUE TRUE `so` EQUALS JUST FALSE
#ASSERT `Can the court set aside my settlement` `against the abuser` TRUE TRUE (`d` 1 1 2010) `s 6A commenced` `commenced` TRUE FALSE `undecided` `so` EQUALS JUST FALSE
#ASSERT `Can the court set aside my settlement` `vicarious` TRUE TRUE (`d` 1 1 2010) `s 6A commenced` `commenced` TRUE FALSE `undecided` `so` EQUALS NOTHING
#ASSERT `Can the court set aside my settlement` `vicarious` TRUE TRUE (`d` 1 1 2010) `s 6A commenced` `commenced` TRUE FALSE `undecided` `not so` EQUALS JUST FALSE

-- s 7D(2). The same arguments, then the court's finding that setting it aside is just and reasonable.
#ASSERT `Can the court set aside my settlement` `general` TRUE TRUE (`d` 1 1 2010) `s 6A commenced` `commenced` TRUE FALSE `undecided` `so` EQUALS JUST TRUE
#ASSERT `Can the court set aside my settlement` `general` TRUE TRUE (`d` 1 1 2010) `s 6A commenced` `commenced` TRUE FALSE `undecided` `not so` EQUALS JUST FALSE
#ASSERT `Can the court set aside my settlement` `general` TRUE TRUE (`d` 1 1 2010) `s 6A commenced` `commenced` TRUE FALSE `undecided` `undecided` EQUALS NOTHING
#ASSERT `Can the court set aside my settlement` `general` TRUE TRUE (`d` 1 1 2010) `s 6A commenced` `commenced` FALSE FALSE `not so` `so` EQUALS JUST FALSE
#ASSERT `Can the court set aside my settlement` `general` TRUE TRUE (`d` 1 1 2017) `s 6A commenced` `commenced` FALSE FALSE `undecided` `so` EQUALS NOTHING
#ASSERT `Can the court set aside my settlement` `general` TRUE TRUE (`d` 1 1 2017) `s 6A commenced` `commenced` FALSE FALSE `undecided` `not so` EQUALS JUST FALSE

