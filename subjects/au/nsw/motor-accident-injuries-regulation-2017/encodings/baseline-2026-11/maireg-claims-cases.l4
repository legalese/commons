#ASSERT `Is my claim exempt from claims assessment` FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Is my claim exempt from claims assessment` FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Is my claim exempt from claims assessment` FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Is my claim exempt from claims assessment` FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE

§§ `cl 15 -- the assessment acceptance day`

-- Certificate issued to the insurer 1 March 2025; the 21st day after is 22 March 2025.
#ASSERT `What is my assessment acceptance day` (`d` 1 3 2025) FALSE (`d` 1 1 2025) EQUALS `d` 22 3 2025
#ASSERT `What is my assessment acceptance day` (`d` 1 3 2025) TRUE (`d` 10 3 2025) EQUALS `d` 10 3 2025
#ASSERT `What is my assessment acceptance day` (`d` 1 3 2025) TRUE (`d` 22 3 2025) EQUALS `d` 22 3 2025
#ASSERT `What is my assessment acceptance day` (`d` 1 3 2025) TRUE (`d` 25 3 2025) EQUALS `d` 22 3 2025

§§ `cl 16 -- when the insurer must pay`

-- Acceptance received 10 March 2025: pay by 7 April 2025 (10 March plus 28 days).
#ASSERT `By what day must the insurer pay my assessed damages` (`d` 1 3 2025) TRUE (`d` 10 3 2025) TRUE FALSE FALSE (`d` 1 1 2025) EQUALS JUST (`d` 7 4 2025)
-- The insurer does not admit liability; the acceptance arrives a day late (23 March): not payable under s 7.38(2).
#ASSERT `By what day must the insurer pay my assessed damages` (`d` 1 3 2025) TRUE (`d` 10 3 2025) FALSE FALSE FALSE (`d` 1 1 2025) EQUALS NOTHING
#ASSERT `By what day must the insurer pay my assessed damages` (`d` 1 3 2025) TRUE (`d` 23 3 2025) TRUE FALSE FALSE (`d` 1 1 2025) EQUALS NOTHING
-- The claimant never answers (finding 10): an acceptance day arrives, but nothing is payable.
#ASSERT `By what day must the insurer pay my assessed damages` (`d` 1 3 2025) FALSE (`d` 1 1 2025) TRUE FALSE FALSE (`d` 1 1 2025) EQUALS NOTHING
-- Acceptance received on the 21st day (22 March): pay by 19 April 2025.
#ASSERT `By what day must the insurer pay my assessed damages` (`d` 1 3 2025) TRUE (`d` 22 3 2025) TRUE FALSE FALSE (`d` 1 1 2025) EQUALS JUST (`d` 19 4 2025)
-- Deductions: the last advice arrives 20 April 2025, so the balance is due 18 May 2025; advice not yet in: no date.
#ASSERT `By what day must the insurer pay my assessed damages` (`d` 1 3 2025) TRUE (`d` 10 3 2025) TRUE TRUE TRUE (`d` 20 4 2025) EQUALS JUST (`d` 18 5 2025)
#ASSERT `By what day must the insurer pay my assessed damages` (`d` 1 3 2025) TRUE (`d` 10 3 2025) TRUE TRUE FALSE (`d` 1 1 2025) EQUALS NOTHING

§§ `cl 16 -- interest (the regulative rule)`

#ASSERT `Is interest payable on my assessed damages` (`d` 1 3 2025) TRUE (`d` 10 3 2025) TRUE FALSE FALSE (`d` 1 1 2025) TRUE (`d` 7 4 2025) (`d` 1 6 2025) EQUALS `paid within the period, so no interest is payable`
#ASSERT `Is interest payable on my assessed damages` (`d` 1 3 2025) TRUE (`d` 10 3 2025) TRUE FALSE FALSE (`d` 1 1 2025) TRUE (`d` 8 4 2025) (`d` 1 6 2025) EQUALS `unpaid after the period for payment ended, so interest is payable`
#ASSERT `Is interest payable on my assessed damages` (`d` 1 3 2025) TRUE (`d` 10 3 2025) TRUE FALSE FALSE (`d` 1 1 2025) FALSE (`d` 1 1 2025) (`d` 7 4 2025) EQUALS `the period for payment has not ended`
#ASSERT `Is interest payable on my assessed damages` (`d` 1 3 2025) TRUE (`d` 10 3 2025) TRUE FALSE FALSE (`d` 1 1 2025) FALSE (`d` 1 1 2025) (`d` 8 4 2025) EQUALS `unpaid after the period for payment ended, so interest is payable`
#ASSERT `Is interest payable on my assessed damages` (`d` 1 3 2025) TRUE (`d` 10 3 2025) FALSE FALSE FALSE (`d` 1 1 2025) FALSE (`d` 1 1 2025) (`d` 8 4 2025) EQUALS `clause 16 does not apply, because the assessed damages are not payable under s 7.38(2)`
#ASSERT `Is interest payable on my assessed damages` (`d` 1 3 2025) TRUE (`d` 10 3 2025) TRUE TRUE FALSE (`d` 1 1 2025) FALSE (`d` 1 1 2025) (`d` 8 4 2025) EQUALS `the insurer has not yet received all the advice on deductions, so the payment period has not started`
#ASSERT `Is interest payable on my assessed damages` (`d` 1 3 2025) TRUE (`d` 10 3 2025) TRUE TRUE TRUE (`d` 20 4 2025) TRUE (`d` 18 5 2025) (`d` 1 6 2025) EQUALS `paid within the period, so no interest is payable`
#ASSERT `Is interest payable on my assessed damages` (`d` 1 3 2025) TRUE (`d` 10 3 2025) TRUE TRUE TRUE (`d` 20 4 2025) TRUE (`d` 19 5 2025) (`d` 1 6 2025) EQUALS `unpaid after the period for payment ended, so interest is payable`

-- 75% of the s 101 rate.
#ASSERT `At what rate is interest payable on my late assessed damages` 10.25 EQUALS 7.6875
#ASSERT `At what rate is interest payable on my late assessed damages` 8 EQUALS 6

