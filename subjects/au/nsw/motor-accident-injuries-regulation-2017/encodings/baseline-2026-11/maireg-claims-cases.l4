#ASSERT `Can I have my medical dispute assessed again` `another ground` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Can I have my medical dispute assessed again` `my injury has deteriorated` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Can I have my medical dispute assessed again` `my injury has deteriorated` FALSE FALSE EQUALS JUST FALSE
#ASSERT `Can I have my medical dispute assessed again` `there is additional relevant information about my injury` TRUE FALSE EQUALS JUST TRUE

