IMPORT prelude
IMPORT `maireg-dates`
IMPORT `maireg-claims`

-- Motor Accident Injuries Regulation 2017 (NSW) -- worked cases for every exported question in maireg-claims.l4.
-- Every expected value was worked by hand from the deposited text; none was copied from the encoding's output. Each
-- assertion is a claim about the ENCODING on stated facts, not about the law. Dates and amounts are illustrative.
-- BASELINE ENCODING. Not for public use as advice. See NOTES.md.

§ `cases`

`d` MEANS `the date`

`nerve root, signs` MEANS `an injury to a spinal nerve root showing neurological signs other than radiculopathy`
`nerve root, radiculopathy` MEANS `an injury to a spinal nerve root showing radiculopathy`

§§ `cl 4 -- threshold injury`

#ASSERT `Is my injury a threshold injury` `nerve root, signs` FALSE EQUALS JUST TRUE
#ASSERT `Is my injury a threshold injury` `nerve root, radiculopathy` FALSE EQUALS JUST FALSE
#ASSERT `Is my injury a threshold injury` `nerve root, radiculopathy` TRUE EQUALS JUST TRUE
#ASSERT `Is my injury a threshold injury` `acute stress disorder` FALSE EQUALS JUST TRUE
#ASSERT `Is my injury a threshold injury` `adjustment disorder` FALSE EQUALS JUST TRUE
#ASSERT `Is my injury a threshold injury` `another injury` FALSE EQUALS JUST FALSE
#ASSERT `Is my injury a threshold injury` `another injury` TRUE EQUALS JUST TRUE

§§ `cl 7 -- minimum weekly amount: 2.5% of the maximum`

#ASSERT `What is the minimum weekly statutory benefits amount` 3853 EQUALS 96.325
#ASSERT `What is the minimum weekly statutory benefits amount` 4000 EQUALS 100

§§ `cl 8 -- mental harm`

#ASSERT `Are my benefits limited by the victim's fault` FALSE TRUE EQUALS NOTHING
#ASSERT `Are my benefits limited by the victim's fault` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Are my benefits limited by the victim's fault` TRUE FALSE EQUALS JUST FALSE

§§ `s 6.13(2), cl 8A -- the deadlines`

-- 10 June 2024 plus 28 days: 8 July 2024.
#ASSERT `By what day must I claim to be paid weekly benefits from the accident` (`d` 10 6 2024) EQUALS `d` 8 7 2024
-- Three months after 10 June 2024: 10 September 2024; after 30 November 2023: 29 February 2024 (leap year); after
-- 31 January 2025: 30 April 2025.
#ASSERT `By what day must I claim to be back-paid for the weeks before a late claim` (`d` 10 6 2024) EQUALS `d` 10 9 2024
#ASSERT `By what day must I claim to be back-paid for the weeks before a late claim` (`d` 30 11 2023) EQUALS `d` 29 2 2024
#ASSERT `By what day must I claim to be back-paid for the weeks before a late claim` (`d` 31 1 2025) EQUALS `d` 30 4 2025

§§ `cl 8A(3) -- the explanation`

-- Explanation received 1 August 2024; the 14th day after is 15 August 2024.
#ASSERT `Is my explanation for the late claim full and satisfactory` FALSE (`d` 1 8 2024) FALSE (`d` 1 8 2024) TRUE EQUALS JUST FALSE
#ASSERT `Is my explanation for the late claim full and satisfactory` TRUE (`d` 1 8 2024) FALSE (`d` 1 8 2024) FALSE EQUALS JUST TRUE
#ASSERT `Is my explanation for the late claim full and satisfactory` TRUE (`d` 1 8 2024) TRUE (`d` 15 8 2024) FALSE EQUALS JUST FALSE
#ASSERT `Is my explanation for the late claim full and satisfactory` TRUE (`d` 1 8 2024) TRUE (`d` 15 8 2024) TRUE EQUALS JUST TRUE
#ASSERT `Is my explanation for the late claim full and satisfactory` TRUE (`d` 1 8 2024) TRUE (`d` 16 8 2024) FALSE EQUALS JUST TRUE

§§ `s 6.13(2), cl 8A, cl 42 -- back pay`

-- Accident 10 June 2024: 28 days end 8 July; 3 months end 10 September.
#ASSERT `Can I be paid weekly benefits for the time before my claim` (`d` 10 6 2024) (`d` 8 7 2024) FALSE (`d` 1 1 2024) FALSE (`d` 1 1 2024) FALSE EQUALS JUST TRUE
#ASSERT `Can I be paid weekly benefits for the time before my claim` (`d` 10 6 2024) (`d` 9 7 2024) FALSE (`d` 1 1 2024) FALSE (`d` 1 1 2024) FALSE EQUALS JUST FALSE
#ASSERT `Can I be paid weekly benefits for the time before my claim` (`d` 10 6 2024) (`d` 9 7 2024) TRUE (`d` 9 7 2024) FALSE (`d` 1 1 2024) FALSE EQUALS JUST TRUE
#ASSERT `Can I be paid weekly benefits for the time before my claim` (`d` 10 6 2024) (`d` 9 7 2024) TRUE (`d` 9 7 2024) TRUE (`d` 20 7 2024) FALSE EQUALS JUST FALSE
#ASSERT `Can I be paid weekly benefits for the time before my claim` (`d` 10 6 2024) (`d` 10 9 2024) TRUE (`d` 10 9 2024) FALSE (`d` 1 1 2024) FALSE EQUALS JUST TRUE
#ASSERT `Can I be paid weekly benefits for the time before my claim` (`d` 10 6 2024) (`d` 11 9 2024) TRUE (`d` 11 9 2024) FALSE (`d` 1 1 2024) TRUE EQUALS JUST FALSE
-- The accident before 1 April 2023 (cl 8A(4), cl 42), and on that day.
#ASSERT `Can I be paid weekly benefits for the time before my claim` (`d` 31 3 2023) (`d` 1 6 2023) TRUE (`d` 1 6 2023) FALSE (`d` 1 1 2024) FALSE EQUALS NOTHING
#ASSERT `Can I be paid weekly benefits for the time before my claim` (`d` 1 4 2023) (`d` 1 6 2023) TRUE (`d` 1 6 2023) FALSE (`d` 1 1 2024) FALSE EQUALS JUST TRUE

§§ `cl 9 -- accommodation and travel`

#ASSERT `Can I claim damages for this accommodation or travel` TRUE EQUALS JUST TRUE
#ASSERT `Can I claim damages for this accommodation or travel` FALSE EQUALS JUST FALSE

§§ `cl 10, 11 -- internal review first?`

#ASSERT `Must I ask for an internal review before a merit review` `whether a request made of me under s 6.24 is reasonable, or whether I had a reasonable excuse for not complying` FALSE EQUALS JUST FALSE
#ASSERT `Must I ask for an internal review before a merit review` `whether I gave the insurer all relevant particulars of my claim under s 6.25` FALSE EQUALS JUST FALSE
#ASSERT `Must I ask for an internal review before a merit review` `whether the insurer may give me a direction under s 6.26` FALSE EQUALS JUST FALSE
#ASSERT `Must I ask for an internal review before a merit review` `whether my costs and expenses under s 8.10 are reasonable and necessary` FALSE EQUALS JUST FALSE
#ASSERT `Must I ask for an internal review before a merit review` `another merit review matter` FALSE EQUALS JUST TRUE
#ASSERT `Must I ask for an internal review before a merit review` `another merit review matter` TRUE EQUALS JUST FALSE
#ASSERT `Must I ask for an internal review before a miscellaneous claims assessment` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Must I ask for an internal review before a miscellaneous claims assessment` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Must I ask for an internal review before a miscellaneous claims assessment` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Must I ask for an internal review before a miscellaneous claims assessment` FALSE FALSE FALSE EQUALS JUST TRUE

§§ `cl 12 -- review rights notice (the regulative rule)`

#ASSERT `Did the insurer tell me my review rights` FALSE FALSE FALSE EQUALS `the decision carries no right to internal or merit review, so clause 12 asks nothing of the insurer`
#ASSERT `Did the insurer tell me my review rights` TRUE TRUE TRUE EQUALS `the insurer told me my review rights in writing with the decision, as clause 12 requires`
#ASSERT `Did the insurer tell me my review rights` TRUE TRUE FALSE EQUALS `the insurer did not tell me my review rights in writing with the decision, as clause 12 requires`
#ASSERT `Did the insurer tell me my review rights` TRUE FALSE FALSE EQUALS `the insurer did not tell me my review rights in writing with the decision, as clause 12 requires`
#ASSERT `Did the insurer tell me my review rights` TRUE FALSE TRUE EQUALS `the insurer did not tell me my review rights in writing with the decision, as clause 12 requires`

