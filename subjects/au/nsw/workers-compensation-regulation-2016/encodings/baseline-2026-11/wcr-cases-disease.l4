IMPORT prelude
IMPORT `wcr-dates`
IMPORT `wcr-disease`

-- Workers Compensation Regulation 2016 (NSW) -- worked cases for Part 2 (wcr-disease.l4). Every expected value was worked
-- by hand from the deposited text; none was copied from the encoding's output. Each assertion is a claim about the
-- ENCODING on stated facts, not about the law. The facts are illustrative; no scenario life raises this Regulation.
-- BASELINE ENCODING. Not for public use as advice. See NOTES.md.

§ `cases -- Part 2`

`d` MEANS `the calendar day`

§§ `cl 4 and Schedule 1`

-- Lead poisoning is opposite "Employment in the polygraphic industries" (the lead row).
#ASSERT `Does Schedule 1 presume my disease is work-related` `poisoning by lead, its alloys or compounds` `employment in the polygraphic industries` TRUE EQUALS JUST TRUE
-- Hot gilding is opposite mercury poisoning, not lead poisoning.
#ASSERT `Does Schedule 1 presume my disease is work-related` `poisoning by lead, its alloys or compounds` `hot gilding` TRUE EQUALS JUST FALSE
#ASSERT `Does Schedule 1 presume my disease is work-related` `poisoning by mercury, its amalgams or compounds` `hot gilding` TRUE EQUALS JUST TRUE
-- s 19(1) "during a time when the worker is engaged in" that employment: not so engaged, no presumption.
#ASSERT `Does Schedule 1 presume my disease is work-related` `poisoning by mercury, its amalgams or compounds` `hot gilding` FALSE EQUALS JUST FALSE
-- The cattle row covers all three infections.
#ASSERT `Does Schedule 1 presume my disease is work-related` `Q fever` `slaughtering of cattle on the slaughter-floor of an abattoir or slaughter-house` TRUE EQUALS JUST TRUE
#ASSERT `Does Schedule 1 presume my disease is work-related` `leptospirosis` `penning up or running cattle through a race at an abattoir or slaughter-house` TRUE EQUALS JUST TRUE
#ASSERT `Does Schedule 1 presume my disease is work-related` `brucellosis` `handling of animal carcases or parts of them, including hides, hoofs and horns` TRUE EQUALS JUST FALSE
#ASSERT `Does Schedule 1 presume my disease is work-related` `anthrax infection` `loading, unloading or transport of merchandise that has touched anthrax-infected animals or carcases` TRUE EQUALS JUST TRUE
#ASSERT `Does Schedule 1 presume my disease is work-related` `primary epitheliomatous cancer of the skin` `a process handling or using tar, pitch, bitumen, mineral oil, paraffin or their compounds, products or residues` TRUE EQUALS JUST TRUE
#ASSERT `Does Schedule 1 presume my disease is work-related` `pathological manifestations due to radium, radioactive substances or X-rays` `a process involving exposure to radium, radioactive substances or X-rays` TRUE EQUALS JUST TRUE
-- Neither side in the Schedule: no presumption (fork F2).
#ASSERT `Does Schedule 1 presume my disease is work-related` `a disease not in Schedule 1` `employment not in Schedule 1` TRUE EQUALS JUST FALSE
#ASSERT `Does Schedule 1 presume my disease is work-related` `arsenic poisoning` `employment not in Schedule 1` TRUE EQUALS JUST FALSE

§§ `cl 5 and Schedule 2 Part 1`

-- Arguments: disease, test, for the purpose, days apart, fold rise, seroconversion, titre, detected, recent vaccination,
-- compatible illness, positive EIA IgM.
-- Brucella single titre: "An antibody titre of 640 or greater". 640 yes; 320 (the next titre down) no.
#ASSERT `Does my test show I contracted the disease` `brucellosis infection` `a single high Brucella agglutination titre or complement fixation test` TRUE 0 0 FALSE 640 FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Does my test show I contracted the disease` `brucellosis infection` `a single high Brucella agglutination titre or complement fixation test` TRUE 0 0 FALSE 320 FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- Brucella paired sera "taken at least 2 weeks apart": 14 days with a four-fold rise yes; 13 days no.
#ASSERT `Does my test show I contracted the disease` `brucellosis infection` `Brucella agglutination or complement fixation titres on paired acute and convalescent sera` TRUE 14 4 FALSE 0 FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Does my test show I contracted the disease` `brucellosis infection` `Brucella agglutination or complement fixation titres on paired acute and convalescent sera` TRUE 13 4 FALSE 0 FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- IgG seroconversion is enough without a four-fold rise.
#ASSERT `Does my test show I contracted the disease` `brucellosis infection` `Brucella agglutination or complement fixation titres on paired acute and convalescent sera` TRUE 21 2 TRUE 0 FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- A three-fold rise without seroconversion is not enough.
#ASSERT `Does my test show I contracted the disease` `brucellosis infection` `Brucella agglutination or complement fixation titres on paired acute and convalescent sera` TRUE 21 3 FALSE 0 FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- Q fever IgM: "in the absence of recent Q fever vaccination in a person with a clinically compatible illness".
#ASSERT `Does my test show I contracted the disease` `Q fever infection` `Q fever IgM` TRUE 0 0 FALSE 0 TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Does my test show I contracted the disease` `Q fever infection` `Q fever IgM` TRUE 0 0 FALSE 0 TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Does my test show I contracted the disease` `Q fever infection` `Q fever IgM` TRUE 0 0 FALSE 0 TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- Q fever phase II antigen, four-fold rise 14 days apart, but recently vaccinated: no.
#ASSERT `Does my test show I contracted the disease` `Q fever infection` `Q fever phase II antigen on paired sera tested in parallel` TRUE 14 4 FALSE 0 FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Does my test show I contracted the disease` `Q fever infection` `Q fever phase II antigen on paired sera tested in parallel` TRUE 14 4 FALSE 0 FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Does my test show I contracted the disease` `Q fever infection` `nucleic acid testing for Q fever` TRUE 0 0 FALSE 0 TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- Leptospira single titre: "Greater than or equal to 400", supported by a positive EIA IgM.
#ASSERT `Does my test show I contracted the disease` `leptospirosis infection` `a single Leptospira micro agglutination titre supported by an EIA IgM result` TRUE 0 0 FALSE 400 FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Does my test show I contracted the disease` `leptospirosis infection` `a single Leptospira micro agglutination titre supported by an EIA IgM result` TRUE 0 0 FALSE 400 FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Does my test show I contracted the disease` `leptospirosis infection` `a single Leptospira micro agglutination titre supported by an EIA IgM result` TRUE 0 0 FALSE 200 FALSE FALSE FALSE TRUE EQUALS JUST FALSE
-- Leptospira paired sera: only "A four-fold or greater increase" counts; seroconversion alone does not.
#ASSERT `Does my test show I contracted the disease` `leptospirosis infection` `Leptospira agglutination titres on paired acute and convalescent sera` TRUE 14 0 TRUE 0 FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Does my test show I contracted the disease` `leptospirosis infection` `Leptospira agglutination titres on paired acute and convalescent sera` TRUE 14 8 FALSE 0 FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Does my test show I contracted the disease` `leptospirosis infection` `a laboratory culture for Leptospira` TRUE 0 0 FALSE 0 TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- A Brucella test does not show Q fever.
#ASSERT `Does my test show I contracted the disease` `Q fever infection` `a laboratory culture for Brucella` TRUE 0 0 FALSE 0 TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- s 19(2)(b): the test must have been carried out to find out whether the worker had the disease.
#ASSERT `Does my test show I contracted the disease` `brucellosis infection` `a laboratory culture for Brucella` FALSE 0 0 FALSE 0 TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Does my test show I contracted the disease` `brucellosis infection` `another test` TRUE 0 0 FALSE 0 TRUE FALSE FALSE FALSE EQUALS JUST FALSE

§§ `cl 5A`

#ASSERT `Have I been engaged in firefighting employment` `the NSW Rural Fire Service` TRUE EQUALS JUST TRUE
#ASSERT `Have I been engaged in firefighting employment` `Sydney Trains` TRUE EQUALS JUST TRUE
#ASSERT `Have I been engaged in firefighting employment` `Sydney Trains` FALSE EQUALS JUST FALSE
#ASSERT `Have I been engaged in firefighting employment` `another body or agency` TRUE EQUALS JUST FALSE

§§ `cll 5B-5D`

-- cl 5D adds cafes, supermarkets, funeral homes and child care facilities.
#ASSERT `Is my work prescribed employment for COVID-19` `cafes` FALSE FALSE EQUALS JUST TRUE
#ASSERT `Is my work prescribed employment for COVID-19` `funeral homes` FALSE FALSE EQUALS JUST TRUE
#ASSERT `Is my work prescribed employment for COVID-19` `the health care sector, including ambulance officers and public health employees` FALSE FALSE EQUALS JUST TRUE
#ASSERT `Is my work prescribed employment for COVID-19` `a business providing only on-line retail` FALSE FALSE EQUALS JUST FALSE
#ASSERT `Is my work prescribed employment for COVID-19` `another kind of employment` FALSE FALSE EQUALS JUST FALSE
-- s 19B(6): a casual worker needs casual work there on 1 or more of the 21 days before the injury.
#ASSERT `Is my work prescribed employment for COVID-19` `supermarkets` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Is my work prescribed employment for COVID-19` `supermarkets` TRUE TRUE EQUALS JUST TRUE

#ASSERT `Does my test show I contracted COVID-19` `a SARS-CoV-2 nucleic acid test listed in the Australian Register of Therapeutic Goods` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Does my test show I contracted COVID-19` `a SARS-CoV-2 nucleic acid test listed in the Australian Register of Therapeutic Goods` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Does my test show I contracted COVID-19` `a laboratory culture confirmed with a PCR test listed in the Australian Register of Therapeutic Goods` TRUE TRUE EQUALS JUST TRUE
-- A rapid antigen test is not a prescribed test.
#ASSERT `Does my test show I contracted COVID-19` `another COVID-19 test` TRUE TRUE EQUALS JUST FALSE

-- cl 5C(1): the later of 21 days after the date of injury and the certificate's end date.
-- 1 February 2022 plus 21 days is 22 February 2022.
#ASSERT `Until when am I presumed unable to work` (`d` 1 2 2022) FALSE (`d` 1 1 2000) EQUALS `d` 22 2 2022
#ASSERT `Until when am I presumed unable to work` (`d` 1 2 2022) TRUE (`d` 28 2 2022) EQUALS `d` 28 2 2022
-- A certificate expecting an earlier end does not shorten the 21 days.
#ASSERT `Until when am I presumed unable to work` (`d` 1 2 2022) TRUE (`d` 10 2 2022) EQUALS `d` 22 2 2022
-- Over a year end: 20 December 2021 plus 21 days is 10 January 2022.
#ASSERT `Until when am I presumed unable to work` (`d` 20 12 2021) FALSE (`d` 1 1 2000) EQUALS `d` 10 1 2022

-- cl 5C(5). Arguments: presumption covers me, rebutted, s 33 anyway, in isolation, earnings, pre-injury capacity.
#ASSERT `Am I taken to be partially incapacitated during isolation` TRUE TRUE FALSE TRUE 0 1000 EQUALS JUST TRUE
#ASSERT `Am I taken to be partially incapacitated during isolation` TRUE TRUE FALSE TRUE 999 1000 EQUALS JUST TRUE
#ASSERT `Am I taken to be partially incapacitated during isolation` TRUE TRUE FALSE TRUE 1000 1000 EQUALS JUST FALSE
-- (b) nil earnings count even where the capacity figure is nil.
#ASSERT `Am I taken to be partially incapacitated during isolation` TRUE TRUE FALSE TRUE 0 0 EQUALS JUST TRUE
#ASSERT `Am I taken to be partially incapacitated during isolation` TRUE TRUE FALSE FALSE 0 1000 EQUALS JUST FALSE
#ASSERT `Am I taken to be partially incapacitated during isolation` TRUE TRUE TRUE TRUE 0 1000 EQUALS NOTHING
#ASSERT `Am I taken to be partially incapacitated during isolation` TRUE FALSE FALSE TRUE 0 1000 EQUALS NOTHING
