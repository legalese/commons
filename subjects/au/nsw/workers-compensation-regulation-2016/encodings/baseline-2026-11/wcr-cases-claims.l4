IMPORT prelude
IMPORT `wcr-dates`
IMPORT `wcr-claims`

-- Workers Compensation Regulation 2016 (NSW) -- worked cases for the claims procedure (wcr-claims.l4). Every expected
-- value was worked by hand from the deposited text; none was copied from the encoding's output. Each assertion is a claim
-- about the ENCODING on stated facts, not about the law. The facts are illustrative.
-- BASELINE ENCODING. Not for public use as advice. See NOTES.md.

§ `cases -- the claims procedure`

`d` MEANS `the calendar day`
`any day` MEANS `the calendar day` 1 1 2000

§§ `cl 37`

#ASSERT `To whom must I give notice of my hearing loss` TRUE TRUE EQUALS `my current employer, in whose employment the loss arose`
#ASSERT `To whom must I give notice of my hearing loss` TRUE FALSE EQUALS `the last employer in whose employment the loss arose`
#ASSERT `To whom must I give notice of my hearing loss` FALSE TRUE EQUALS `clause 37 does not apply`

§§ `cll 38, 38A`

#ASSERT `Does my dispute notice contain what clause 38 requires` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- No approved-form summary (h): not compliant.
#ASSERT `Does my dispute notice contain what clause 38 requires` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- Reports against the decision left out (b): not compliant.
#ASSERT `Does my dispute notice contain what clause 38 requires` TRUE TRUE FALSE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Does my dispute notice contain what clause 38 requires` FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `Does my damages dispute notice contain what clause 38A requires` TRUE TRUE TRUE TRUE TRUE EQUALS TRUE
#ASSERT `Does my damages dispute notice contain what clause 38A requires` TRUE FALSE TRUE TRUE TRUE EQUALS FALSE

§§ `cl 41`

-- Arguments: report, decision, in possession, relevant, already have it and listed, serious threat, Authority direction.
#ASSERT `Must the insurer send me a copy of the report` `a medical report, including a report of an examination the employer required (s 119)` `a decision to dispute liability for my claim or part of it` TRUE TRUE FALSE FALSE FALSE EQUALS `the insurer must give me a copy with the notice`
#ASSERT `Must the insurer send me a copy of the report` `clinical notes` `a review decision confirming one of those decisions` TRUE TRUE FALSE FALSE FALSE EQUALS `the insurer must give me a copy with the notice`
#ASSERT `Must the insurer send me a copy of the report` `an investigator's report` `a decision to discontinue or reduce my weekly payments` TRUE TRUE FALSE FALSE FALSE EQUALS `the insurer must give me a copy with the notice`
-- (5)(a) a certificate of capacity, serious threat: to the doctor I nominate; (5)(b) an investigator's report: to my lawyers.
#ASSERT `Must the insurer send me a copy of the report` `a certificate of capacity` `a decision to dispute liability for my claim or part of it` TRUE TRUE FALSE TRUE FALSE EQUALS `the insurer may give it to the doctor I nominate instead`
#ASSERT `Must the insurer send me a copy of the report` `an investigator's report` `a decision to dispute liability for my claim or part of it` TRUE TRUE FALSE TRUE FALSE EQUALS `the insurer may give it to my lawyers instead`
#ASSERT `Must the insurer send me a copy of the report` `an investigator's report` `a decision to dispute liability for my claim or part of it` TRUE TRUE FALSE TRUE TRUE EQUALS `it goes to whoever the Authority directs`
#ASSERT `Must the insurer send me a copy of the report` `a health service provider's report` `a decision to dispute liability for my claim or part of it` TRUE TRUE TRUE FALSE FALSE EQUALS `no copy is needed: I already have it and the notice identifies it`
-- (4) only relevant reports; (2) only the listed decisions; (1) only the listed reports in its possession.
#ASSERT `Must the insurer send me a copy of the report` `a medical report, including a report of an examination the employer required (s 119)` `a decision to dispute liability for my claim or part of it` TRUE FALSE FALSE FALSE FALSE EQUALS `clause 41 does not require a copy`
#ASSERT `Must the insurer send me a copy of the report` `a medical report, including a report of an examination the employer required (s 119)` `another decision` TRUE TRUE FALSE FALSE FALSE EQUALS `clause 41 does not require a copy`
#ASSERT `Must the insurer send me a copy of the report` `another kind of document` `a decision to dispute liability for my claim or part of it` TRUE TRUE FALSE FALSE FALSE EQUALS `clause 41 does not require a copy`
#ASSERT `Must the insurer send me a copy of the report` `a medical report, including a report of an examination the employer required (s 119)` `a decision to dispute liability for my claim or part of it` FALSE TRUE FALSE FALSE FALSE EQUALS `clause 41 does not require a copy`

§§ `cll 42A, 42B`

#ASSERT `Was my review dealt with as clause 42A requires` TRUE TRUE FALSE EQUALS `the review was dealt with as clause 42A requires`
#ASSERT `Was my review dealt with as clause 42A requires` TRUE TRUE TRUE EQUALS `the review was not dealt with as clause 42A requires`
#ASSERT `Was my review dealt with as clause 42A requires` TRUE FALSE FALSE EQUALS `the review was not dealt with as clause 42A requires`
#ASSERT `Was my review dealt with as clause 42A requires` FALSE TRUE FALSE EQUALS `my request does not meet clause 42A: it must be in writing`
#ASSERT `Does my review decision notice contain what clause 42B requires` TRUE TRUE TRUE TRUE EQUALS TRUE
#ASSERT `Does my review decision notice contain what clause 42B requires` TRUE TRUE TRUE FALSE EQUALS FALSE

§§ `Part 9`

-- cl 44(4). Arguments: specialist, has treated me, for this claim, for another claim, s 119 examination.
#ASSERT `Is this a forensic medical report` TRUE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Is this a forensic medical report` TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Is this a forensic medical report` TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Is this a forensic medical report` TRUE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
-- (c) before (b): a s 119 report obtained for another claim is not one in this claim (fork F12).
#ASSERT `Is this a forensic medical report` TRUE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Is this a forensic medical report` FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE

-- cl 44(1), (3) (fork F13).
#ASSERT `How many forensic medical reports may each side have admitted` 0 EQUALS 1
#ASSERT `How many forensic medical reports may each side have admitted` 1 EQUALS 1
#ASSERT `How many forensic medical reports may each side have admitted` 2 EQUALS 2
#ASSERT `How many forensic medical reports may each side have admitted` 3 EQUALS 2

-- cl 45. Arguments: clarifies, updates, omitted issues, answers the other side, original author wrote it, author stopped
-- practising, writer same specialty.
#ASSERT `May my supplementary report be admitted` FALSE TRUE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `May my supplementary report be admitted` FALSE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `May my supplementary report be admitted` FALSE FALSE FALSE TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `May my supplementary report be admitted` FALSE FALSE FALSE TRUE FALSE TRUE FALSE EQUALS JUST FALSE
-- Another doctor wrote it while the original author still practises: (3) not met.
#ASSERT `May my supplementary report be admitted` TRUE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE

-- cl 46. Arguments: admitted, admission decided, nominated, sole of its specialty, assessor called, another already sent.
#ASSERT `Must my forensic report go to the medical assessor` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Must my forensic report go to the medical assessor` FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Must my forensic report go to the medical assessor` FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- Decided and not admitted: nomination no longer helps.
#ASSERT `Must my forensic report go to the medical assessor` FALSE TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Must my forensic report go to the medical assessor` FALSE TRUE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Must my forensic report go to the medical assessor` FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- (3): not more than one on behalf of a party (fork F14).
#ASSERT `Must my forensic report go to the medical assessor` TRUE TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE

-- cl 47. Arguments: treatment, assessor's report, proceedings, admitted, disclosed, served, admissible or disclosable.
#ASSERT `Does clause 47 stop me recovering the cost of my report` TRUE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS FALSE
#ASSERT `Does clause 47 stop me recovering the cost of my report` FALSE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS FALSE
#ASSERT `Does clause 47 stop me recovering the cost of my report` FALSE FALSE TRUE TRUE FALSE FALSE FALSE EQUALS FALSE
#ASSERT `Does clause 47 stop me recovering the cost of my report` FALSE FALSE TRUE FALSE TRUE FALSE FALSE EQUALS FALSE
#ASSERT `Does clause 47 stop me recovering the cost of my report` FALSE FALSE TRUE FALSE FALSE TRUE TRUE EQUALS TRUE
#ASSERT `Does clause 47 stop me recovering the cost of my report` FALSE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS FALSE
#ASSERT `Does clause 47 stop me recovering the cost of my report` FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS TRUE
#ASSERT `Does clause 47 stop me recovering the cost of my report` FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS TRUE

§§ `cl 168`

#ASSERT `Must I pay the costs of the medical assessment` `the costs of the medical assessment` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Must I pay the costs of the medical assessment` `the costs of a further examination for that assessment` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Must I pay the costs of the medical assessment` `the costs of an appeal against the assessment` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `Must I pay the costs of the medical assessment` `the costs of a further hearing on that appeal` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Must I pay the costs of the medical assessment` `the costs of the medical assessment` TRUE FALSE TRUE EQUALS NOTHING

§§ `cll 94-99`

-- Arguments: ancillary, judgment, damages, wholly denied, mediation, mediation day, my offer certified, my offer, insurer
-- offer certified, insurer offer, President's certificate, its day, later offer, its day, its amount, pre-filing amount,
-- several defendants, my offers to all, insurer's offer settles all.
#ASSERT `Who pays the costs of my damages case` TRUE TRUE 300000 FALSE TRUE (`d` 31 1 2025) TRUE 300000 TRUE 200000 FALSE `any day` FALSE `any day` 0 500000 FALSE FALSE FALSE EQUALS `the court's rules decide: ancillary proceedings (cl 98)`
-- cl 95(2): no judgment.
#ASSERT `Who pays the costs of my damages case` FALSE FALSE 0 FALSE TRUE (`d` 31 1 2025) TRUE 300000 TRUE 200000 FALSE `any day` FALSE `any day` 0 500000 FALSE FALSE FALSE EQUALS `I must pay the insurer's costs, on a party and party basis (cl 95)`
-- cl 94: judgment equal to my certified offer is "no less favourable".
#ASSERT `Who pays the costs of my damages case` FALSE TRUE 300000 FALSE TRUE (`d` 31 1 2025) TRUE 300000 TRUE 200000 FALSE `any day` FALSE `any day` 0 500000 FALSE FALSE FALSE EQUALS `the insurer must pay my costs, on a party and party basis (cl 94)`
-- One dollar short of my offer and above the insurer's: each bears its own (cl 96).
#ASSERT `Who pays the costs of my damages case` FALSE TRUE 299999 FALSE TRUE (`d` 31 1 2025) TRUE 300000 TRUE 200000 FALSE `any day` FALSE `any day` 0 500000 FALSE FALSE FALSE EQUALS `each side bears its own costs (cl 96)`
-- Equal to the insurer's offer is not "less favourable": cl 96. Below it: cl 95(1).
#ASSERT `Who pays the costs of my damages case` FALSE TRUE 200000 FALSE TRUE (`d` 31 1 2025) TRUE 300000 TRUE 200000 FALSE `any day` FALSE `any day` 0 500000 FALSE FALSE FALSE EQUALS `each side bears its own costs (cl 96)`
#ASSERT `Who pays the costs of my damages case` FALSE TRUE 150000 FALSE TRUE (`d` 31 1 2025) TRUE 300000 TRUE 200000 FALSE `any day` FALSE `any day` 0 500000 FALSE FALSE FALSE EQUALS `I must pay the insurer's costs, on a party and party basis (cl 95)`
-- cl 97(1): wholly denied, no mediation, no later offer: my offer is the pre-filing statement's 500,000.
#ASSERT `Who pays the costs of my damages case` FALSE TRUE 500000 TRUE FALSE `any day` FALSE 0 FALSE 0 FALSE `any day` FALSE `any day` 0 500000 FALSE FALSE FALSE EQUALS `the insurer must pay my costs, on a party and party basis (cl 94)`
#ASSERT `Who pays the costs of my damages case` FALSE TRUE 400000 TRUE FALSE `any day` FALSE 0 FALSE 0 FALSE `any day` FALSE `any day` 0 500000 FALSE FALSE FALSE EQUALS `each side bears its own costs (cl 96)`
-- President's certificate 1 March 2025, later offer of 350,000 on 1 April 2025 (within one month): judgment 400,000.
#ASSERT `Who pays the costs of my damages case` FALSE TRUE 400000 TRUE FALSE `any day` FALSE 0 FALSE 0 TRUE (`d` 1 3 2025) TRUE (`d` 1 4 2025) 350000 500000 FALSE FALSE FALSE EQUALS `the insurer must pay my costs, on a party and party basis (cl 94)`
-- Later offer on 2 April 2025: outside the month, so the pre-filing 500,000 is the offer.
#ASSERT `Who pays the costs of my damages case` FALSE TRUE 400000 TRUE FALSE `any day` FALSE 0 FALSE 0 TRUE (`d` 1 3 2025) TRUE (`d` 2 4 2025) 350000 500000 FALSE FALSE FALSE EQUALS `each side bears its own costs (cl 96)`
-- cl 97(2): mediation concluded 31 January 2025; a later offer of 250,000 on 28 February 2025 is within one month
-- (31 January plus one month is 28 February 2025); judgment 260,000.
#ASSERT `Who pays the costs of my damages case` FALSE TRUE 260000 TRUE TRUE (`d` 31 1 2025) TRUE 300000 FALSE 0 FALSE `any day` TRUE (`d` 28 2 2025) 250000 500000 FALSE FALSE FALSE EQUALS `the insurer must pay my costs, on a party and party basis (cl 94)`
-- On 1 March 2025 it is late: the certified 300,000 counts.
#ASSERT `Who pays the costs of my damages case` FALSE TRUE 260000 TRUE TRUE (`d` 31 1 2025) TRUE 300000 FALSE 0 FALSE `any day` TRUE (`d` 1 3 2025) 250000 500000 FALSE FALSE FALSE EQUALS `each side bears its own costs (cl 96)`
-- cl 99: several defendants; my offer not made to all of them does not count.
#ASSERT `Who pays the costs of my damages case` FALSE TRUE 350000 FALSE TRUE (`d` 31 1 2025) TRUE 300000 TRUE 200000 FALSE `any day` FALSE `any day` 0 500000 TRUE FALSE TRUE EQUALS `each side bears its own costs (cl 96)`
#ASSERT `Who pays the costs of my damages case` FALSE TRUE 350000 FALSE TRUE (`d` 31 1 2025) TRUE 300000 TRUE 200000 FALSE `any day` FALSE `any day` 0 500000 TRUE TRUE TRUE EQUALS `the insurer must pay my costs, on a party and party basis (cl 94)`
-- The defendants' offer not binding them for the whole: it does not count.
#ASSERT `Who pays the costs of my damages case` FALSE TRUE 150000 FALSE TRUE (`d` 31 1 2025) TRUE 300000 TRUE 200000 FALSE `any day` FALSE `any day` 0 500000 TRUE TRUE FALSE EQUALS `each side bears its own costs (cl 96)`

§§ `cl 175(2)`

-- Earlier certificate 1-31 March 2025; later certificate 15 March-15 April 2025, provided 20 March 2025.
#ASSERT `Which certificate governs the day` (`d` 1 3 2025) (`d` 31 3 2025) (`d` 15 3 2025) (`d` 15 4 2025) (`d` 20 3 2025) (`d` 10 3 2025) EQUALS `the earlier certificate`
-- 17 March: the later certificate covers it, but before it was provided; the earlier governs.
#ASSERT `Which certificate governs the day` (`d` 1 3 2025) (`d` 31 3 2025) (`d` 15 3 2025) (`d` 15 4 2025) (`d` 20 3 2025) (`d` 17 3 2025) EQUALS `the earlier certificate`
#ASSERT `Which certificate governs the day` (`d` 1 3 2025) (`d` 31 3 2025) (`d` 15 3 2025) (`d` 15 4 2025) (`d` 20 3 2025) (`d` 20 3 2025) EQUALS `the later certificate`
#ASSERT `Which certificate governs the day` (`d` 1 3 2025) (`d` 31 3 2025) (`d` 15 3 2025) (`d` 15 4 2025) (`d` 20 3 2025) (`d` 25 3 2025) EQUALS `the later certificate`
#ASSERT `Which certificate governs the day` (`d` 1 3 2025) (`d` 31 3 2025) (`d` 15 3 2025) (`d` 15 4 2025) (`d` 20 3 2025) (`d` 10 4 2025) EQUALS `the later certificate`
#ASSERT `Which certificate governs the day` (`d` 1 3 2025) (`d` 31 3 2025) (`d` 15 3 2025) (`d` 15 4 2025) (`d` 20 3 2025) (`d` 20 4 2025) EQUALS `neither certificate covers the day`
