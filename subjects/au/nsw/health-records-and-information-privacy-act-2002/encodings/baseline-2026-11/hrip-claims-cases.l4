IMPORT prelude
IMPORT `hrip-claims`

-- Health Records and Information Privacy Act 2002 (NSW) -- worked cases for every exported question in hrip-claims.l4.
-- Every expected value was worked by hand from the deposited text; none was copied from the encoding's output. Each
-- assertion is a claim about the ENCODING on stated facts, not about the law. Dates are illustrative.
-- BASELINE ENCODING. Not for public use as advice. See NOTES.md.

§ `cases`

`d` MEANS `the calendar date`
`any day` MEANS `the calendar date` 1 1 2026

§§ `ss 5, 6 -- health information`

`about my health` MEANS `information or an opinion about my physical or mental health or a disability, at any time (s 6(a)(i))`
`about a service` MEANS `information or an opinion about a health service provided, or to be provided, to me (s 6(a)(iii))`
`genetic` MEANS `genetic information arising from a health service, in a form that is or could be predictive of my health or a genetic relative's (s 6(d))`
`identifier` MEANS `a healthcare identifier (s 6(e))`
`other` MEANS `other personal information about me`

-- Arguments: identifiable; kind; dead more than 30 years; s 5(3) excluded class; prescribed exempt.
#ASSERT `Is this my health information under the Act` TRUE `about my health` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Is this my health information under the Act` TRUE `about a service` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Is this my health information under the Act` TRUE `genetic` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Is this my health information under the Act` TRUE `identifier` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Is this my health information under the Act` TRUE `other` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Is this my health information under the Act` FALSE `about my health` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Is this my health information under the Act` TRUE `about my health` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Is this my health information under the Act` TRUE `about my health` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Is this my health information under the Act` TRUE `about my health` FALSE FALSE TRUE EQUALS JUST FALSE

§§ `ss 7, 8 -- authorised representatives`

`attorney` MEANS `my attorney under an enduring power of attorney`
`guardian` MEANS `my guardian under the Guardianship Act 1987, or my person responsible under Part 5 of that Act`
`parent` MEANS `a person with parental responsibility for me`
`empowered` MEANS `a person otherwise empowered by law to act as my agent or in my best interests`
`friend` MEANS `someone else, such as a friend or relative with no legal authority`

-- Arguments: who; I am under 18; inconsistent with an order; I am incapable; I expressly authorised.
#ASSERT `Can this person act for me` `attorney` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Can this person act for me` `attorney` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Can this person act for me` `attorney` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Can this person act for me` `guardian` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Can this person act for me` `guardian` FALSE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Can this person act for me` `parent` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Can this person act for me` `parent` FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Can this person act for me` `parent` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Can this person act for me` `parent` TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Can this person act for me` `empowered` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Can this person act for me` `friend` FALSE FALSE TRUE TRUE EQUALS JUST FALSE

§§ `ss 4, 11, 14, 17, 21, 42 -- where I complain`

`public` MEANS `a NSW public sector agency (a government department, statutory body, council, State owned corporation not under the Commonwealth Privacy Act, NSW Health and the like)`
`private` MEANS `a private sector person: a business, company, individual, partnership, trust or association that is not a small business operator or Commonwealth agency`
`small business` MEANS `a small business operator within the Commonwealth Privacy Act`
`Cth agency` MEANS `a Commonwealth agency within the Commonwealth Privacy Act`
`police` MEANS `ICAC, the NSW Police Force, LECC, the NSW Crime Commission, or the ICAC or LECC Inspector or their staff`
`household` MEANS `an individual dealing with the information only for personal, family or household affairs`
`internal review` MEANS `to the agency itself for internal review under Part 5 of the Privacy and Personal Information Protection Act 1998 (s 21)`
`Commissioner` MEANS `by written complaint to the Privacy Commissioner under Part 6 (s 42)`
`not applicable` MEANS `the Act does not apply to this organisation or this conduct`

-- Arguments: kind; health service or handles health information; administrative or educative functions; after commencement.
#ASSERT `Where do I take my health privacy complaint` `public` TRUE FALSE TRUE EQUALS `internal review`
#ASSERT `Where do I take my health privacy complaint` `private` TRUE FALSE TRUE EQUALS `Commissioner`
#ASSERT `Where do I take my health privacy complaint` `small business` TRUE FALSE TRUE EQUALS `not applicable`
#ASSERT `Where do I take my health privacy complaint` `Cth agency` TRUE FALSE TRUE EQUALS `not applicable`
#ASSERT `Where do I take my health privacy complaint` `police` TRUE FALSE TRUE EQUALS `not applicable`
#ASSERT `Where do I take my health privacy complaint` `police` TRUE TRUE TRUE EQUALS `internal review`
#ASSERT `Where do I take my health privacy complaint` `household` TRUE FALSE TRUE EQUALS `not applicable`
#ASSERT `Where do I take my health privacy complaint` `private` FALSE FALSE TRUE EQUALS `not applicable`
#ASSERT `Where do I take my health privacy complaint` `private` TRUE FALSE FALSE EQUALS `not applicable`
#ASSERT `Where do I take my health privacy complaint` `public` TRUE FALSE FALSE EQUALS `not applicable`

§§ `HPP 7, ss 19(3), 22, 23, 29, 30 -- access`

`must give` MEANS JUST `the organisation must give me access, without excessive delay or expense`
`need not` MEANS JUST `the organisation need not give me access, on the ground relied on`
`doctor route` MEANS JUST `the organisation need not give me access, but I may ask it to give access to a registered medical practitioner I nominate (s 30)`
`lawfully not` MEANS JUST `the organisation need not give me access, because it is lawfully authorised or required not to, or the law otherwise permits it`
`pre-2004` MEANS JUST `HPP 7 and Part 4 do not reach this information: it was collected before Schedule 1 commenced and is not a kind listed in section 19(3)`
`no ground` MEANS `no ground: none is relied on`
`threat to me` MEANS `access would pose a serious threat to my own life or health (s 29(a))`
`threat to another` MEANS `access would pose a serious threat to the life or health of another person (s 29(a))`
`proceedings` MEANS `the information relates to legal proceedings between us and is not discoverable or is privileged (s 29(c))`
`repeated` MEANS `I already had access and this is an unreasonable, repeated request in the same manner (s 29(k))`

-- Arguments: public sector agency; collected before Schedule 1; kind in s 19(3); ground; ground made out; lawfully authorised not to.
#ASSERT `Must they give me access to my health information` FALSE FALSE FALSE `no ground` FALSE FALSE EQUALS `must give`
#ASSERT `Must they give me access to my health information` TRUE FALSE FALSE `no ground` FALSE FALSE EQUALS `must give`
#ASSERT `Must they give me access to my health information` FALSE TRUE TRUE `no ground` FALSE FALSE EQUALS `must give`
#ASSERT `Must they give me access to my health information` FALSE TRUE FALSE `no ground` FALSE FALSE EQUALS `pre-2004`
#ASSERT `Must they give me access to my health information` FALSE FALSE FALSE `threat to me` TRUE FALSE EQUALS `doctor route`
#ASSERT `Must they give me access to my health information` FALSE FALSE FALSE `threat to another` TRUE FALSE EQUALS `need not`
#ASSERT `Must they give me access to my health information` FALSE FALSE FALSE `proceedings` TRUE FALSE EQUALS `need not`
#ASSERT `Must they give me access to my health information` FALSE FALSE FALSE `repeated` TRUE FALSE EQUALS `need not`
#ASSERT `Must they give me access to my health information` FALSE FALSE FALSE `proceedings` FALSE FALSE EQUALS `must give`
#ASSERT `Must they give me access to my health information` FALSE FALSE FALSE `no ground` FALSE TRUE EQUALS `lawfully not`
#ASSERT `Must they give me access to my health information` TRUE FALSE FALSE `no ground` FALSE TRUE EQUALS `lawfully not`
#ASSERT `Must they give me access to my health information` TRUE FALSE FALSE `proceedings` TRUE FALSE EQUALS NOTHING

§§ `s 27 -- answering an access request`

`answered` MEANS `the organisation answered within 45 days`
`deemed refused` MEANS `the organisation is taken to have refused my request, because it did not answer within 45 days`
`still running` MEANS `the 45 days have not yet ended`

#ASSERT `The last day to answer my access request` (d 1 3 2026) EQUALS d 15 4 2026
#ASSERT `The last day to answer my access request` (d 20 12 2026) EQUALS d 3 2 2027
#ASSERT `The last day to answer my access request` (d 1 2 2028) EQUALS d 17 3 2028

-- Arguments: day received; responded; day responded; today.
#ASSERT `Has my access request been answered in time` (d 1 3 2026) TRUE (d 15 4 2026) `any day` EQUALS `answered`
#ASSERT `Has my access request been answered in time` (d 1 3 2026) TRUE (d 16 4 2026) `any day` EQUALS `deemed refused`
#ASSERT `Has my access request been answered in time` (d 1 3 2026) TRUE (d 2 3 2026) `any day` EQUALS `answered`
#ASSERT `Has my access request been answered in time` (d 1 3 2026) FALSE `any day` (d 15 4 2026) EQUALS `still running`
#ASSERT `Has my access request been answered in time` (d 1 3 2026) FALSE `any day` (d 16 4 2026) EQUALS `deemed refused`
#ASSERT `Has my access request been answered in time` (d 20 12 2026) TRUE (d 3 2 2027) `any day` EQUALS `answered`
#ASSERT `Has my access request been answered in time` (d 20 12 2026) TRUE (d 4 2 2027) `any day` EQUALS `deemed refused`
#ASSERT `Has my access request been answered in time` (d 1 2 2028) TRUE (d 17 3 2028) `any day` EQUALS `answered`
#ASSERT `Has my access request been answered in time` (d 1 2 2028) TRUE (d 18 3 2028) `any day` EQUALS `deemed refused`

§§ `s 27(4) -- access after paying the fee`

-- Arguments: day received; day of fee notice; day paid.
#ASSERT `The day access can no longer be held back after I pay` (d 1 3 2026) (d 15 4 2026) (d 20 4 2026) EQUALS JUST (d 27 4 2026)
#ASSERT `The day access can no longer be held back after I pay` (d 1 3 2026) (d 10 3 2026) (d 28 12 2026) EQUALS JUST (d 4 1 2027)
#ASSERT `The day access can no longer be held back after I pay` (d 1 3 2026) (d 16 4 2026) (d 20 4 2026) EQUALS NOTHING

§§ `s 28 -- form of access`

`a copy` MEANS `a copy of the information`
`inspect` MEANS `an opportunity to inspect it and take notes`
`any form` MEANS `no particular form`

-- Arguments: form asked for; collected before s 28 commenced; requested form unreasonable or inappropriate.
#ASSERT `In what form will I get access` `a copy` FALSE FALSE EQUALS `in the form I asked for`
#ASSERT `In what form will I get access` `inspect` FALSE FALSE EQUALS `in the form I asked for`
#ASSERT `In what form will I get access` `a copy` FALSE TRUE EQUALS `in another form, because the form I asked for may be refused`
#ASSERT `In what form will I get access` `any form` FALSE FALSE EQUALS `either a copy or a reasonable opportunity to inspect and take notes`
#ASSERT `In what form will I get access` `a copy` TRUE FALSE EQUALS `an accurate summary of the information is enough, because it was collected before section 28 commenced`

§§ `s 30 -- a doctor nominated after a refusal`

`not ended` MEANS `the 21 days for nominating a doctor have not ended`
`missed` MEANS `I did not nominate a doctor within 21 days after receiving the notice of refusal`
`doctor in time` MEANS `the organisation gave my doctor access within 21 days after my nomination`
`doctor late` MEANS `the organisation did not give my doctor access within 21 days after my nomination`
`doctor running` MEANS `the organisation's 21 days to give my doctor access have not ended`

#ASSERT `The last day to nominate a doctor` (d 1 6 2026) EQUALS d 22 6 2026
#ASSERT `The last day to nominate a doctor` (d 20 12 2026) EQUALS d 10 1 2027

-- Arguments: notice received; nominated; day nominated; doctor given access; day given; today.
#ASSERT `Where does my doctor nomination stand` (d 1 6 2026) FALSE `any day` FALSE `any day` (d 22 6 2026) EQUALS `not ended`
#ASSERT `Where does my doctor nomination stand` (d 1 6 2026) FALSE `any day` FALSE `any day` (d 23 6 2026) EQUALS `missed`
#ASSERT `Where does my doctor nomination stand` (d 1 6 2026) TRUE (d 23 6 2026) FALSE `any day` (d 1 7 2026) EQUALS `missed`
#ASSERT `Where does my doctor nomination stand` (d 1 6 2026) TRUE (d 22 6 2026) TRUE (d 13 7 2026) `any day` EQUALS `doctor in time`
#ASSERT `Where does my doctor nomination stand` (d 1 6 2026) TRUE (d 22 6 2026) TRUE (d 14 7 2026) `any day` EQUALS `doctor late`
#ASSERT `Where does my doctor nomination stand` (d 1 6 2026) TRUE (d 10 6 2026) TRUE (d 11 6 2026) `any day` EQUALS `doctor in time`
#ASSERT `Where does my doctor nomination stand` (d 1 6 2026) TRUE (d 10 6 2026) FALSE `any day` (d 1 7 2026) EQUALS `doctor running`
#ASSERT `Where does my doctor nomination stand` (d 1 6 2026) TRUE (d 10 6 2026) FALSE `any day` (d 2 7 2026) EQUALS `doctor late`

§§ `HPP 8, ss 20, 23, 34, 35 -- amendment`

`must amend` MEANS `the organisation must amend the information`
`refuse (a)` MEANS `the organisation may refuse to amend, because it is satisfied the information is not incomplete, incorrect, irrelevant, out of date or misleading (s 34(3)(a))`
`refuse (b)` MEANS `the organisation may refuse to amend, because it is satisfied my request contains or comes with materially incorrect or misleading matter (s 34(3)(b))`
`lawfully need not` MEANS `the organisation need not amend, because it is lawfully authorised or required not to, or the law otherwise permits it`
`not required` MEANS `HPP 8 does not require an amendment: the information is accurate, relevant, up to date, complete and not misleading`

-- Arguments: public sector agency; deficient in fact; satisfied not deficient; satisfied request misleading; lawfully authorised not to.
#ASSERT `Must they correct my health information` TRUE TRUE FALSE FALSE FALSE EQUALS `must amend`
#ASSERT `Must they correct my health information` TRUE FALSE FALSE FALSE FALSE EQUALS `not required`
#ASSERT `Must they correct my health information` TRUE TRUE FALSE FALSE TRUE EQUALS `must amend`
#ASSERT `Must they correct my health information` FALSE TRUE FALSE FALSE FALSE EQUALS `must amend`
#ASSERT `Must they correct my health information` FALSE TRUE TRUE FALSE FALSE EQUALS `refuse (a)`
#ASSERT `Must they correct my health information` FALSE TRUE FALSE TRUE FALSE EQUALS `refuse (b)`
#ASSERT `Must they correct my health information` FALSE TRUE FALSE FALSE TRUE EQUALS `lawfully need not`
#ASSERT `Must they correct my health information` FALSE FALSE FALSE FALSE FALSE EQUALS `not required`

#ASSERT `The last day to answer my amendment request` (d 1 3 2026) EQUALS d 15 4 2026
#ASSERT `The last day to answer my amendment request` (d 31 12 2026) EQUALS d 14 2 2027

-- Arguments: day received; responded; day responded; today.
#ASSERT `Has my amendment request been answered in time` (d 1 3 2026) TRUE (d 15 4 2026) `any day` EQUALS `answered`
#ASSERT `Has my amendment request been answered in time` (d 1 3 2026) TRUE (d 16 4 2026) `any day` EQUALS `deemed refused`
#ASSERT `Has my amendment request been answered in time` (d 1 3 2026) FALSE `any day` (d 15 4 2026) EQUALS `still running`
#ASSERT `Has my amendment request been answered in time` (d 1 3 2026) FALSE `any day` (d 16 4 2026) EQUALS `deemed refused`
#ASSERT `Has my amendment request been answered in time` (d 31 12 2026) TRUE (d 14 2 2027) `any day` EQUALS `answered`
#ASSERT `Has my amendment request been answered in time` (d 31 12 2026) TRUE (d 15 2 2027) `any day` EQUALS `deemed refused`

#ASSERT `Can I make them add my statement to the record` TRUE EQUALS JUST TRUE
#ASSERT `Can I make them add my statement to the record` FALSE EQUALS JUST FALSE

#ASSERT `Can I have the recipients told of the correction` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Can I have the recipients told of the correction` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Can I have the recipients told of the correction` FALSE TRUE EQUALS JUST FALSE

