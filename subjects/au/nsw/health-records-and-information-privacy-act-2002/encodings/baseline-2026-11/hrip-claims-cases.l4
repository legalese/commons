§§ `ss 70, 73 -- intimidation and fees`

#ASSERT `The largest fine for pressuring me` `not to make or pursue, or to withdraw, a request for access to health information` TRUE EQUALS 100
#ASSERT `The largest fine for pressuring me` `not to make or pursue, or to withdraw, a complaint to the Privacy Commissioner or the Tribunal under Part 6` TRUE EQUALS 100
#ASSERT `The largest fine for pressuring me` `to give a consent under the Act, or to do without consent an act that needs consent` TRUE EQUALS 100
#ASSERT `The largest fine for pressuring me` `not to make or pursue, or to withdraw, a request for access to health information` FALSE EQUALS 0
#ASSERT `The largest fine for pressuring me` `something else` TRUE EQUALS 0

-- Arguments: what for; other matter prescribed; fee; maximum prescribed; maximum.
#ASSERT `Can they charge me this fee` `giving me a copy of my health information` FALSE 30 TRUE 30 EQUALS JUST TRUE
#ASSERT `Can they charge me this fee` `giving me a copy of my health information` FALSE 30.01 TRUE 30 EQUALS JUST FALSE
#ASSERT `Can they charge me this fee` `amending my health information at my request` FALSE 500 FALSE 0 EQUALS JUST TRUE
#ASSERT `Can they charge me this fee` `another matter` FALSE 20 FALSE 0 EQUALS NOTHING
#ASSERT `Can they charge me this fee` `another matter` TRUE 20 FALSE 0 EQUALS JUST TRUE
