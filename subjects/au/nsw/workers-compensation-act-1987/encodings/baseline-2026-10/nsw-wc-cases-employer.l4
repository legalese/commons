IMPORT prelude
IMPORT `nsw-wc-core`
IMPORT `nsw-wc-seat`
IMPORT `nsw-wc-seat-employer`

-- Cases for the employer's seat (nsw-wc-seat-employer.l4), the employer's regulative rules in nsw-wc-core.l4 (1998 Act
-- ss 44(2), 264(1), 264(2), 49; Regulation cl 35(3)), and MIRROR CASES: the same facts asked from the worker's seat
-- (nsw-wc-seat.l4), with answers that agree. Every expected value was worked by hand from the deposited texts, never
-- copied from the encoding's output. HYPOTHETICAL throughout.
--
-- A breached or still-pending DEONTIC cannot be asserted on the stable l4, so regulative rules are asserted where the
-- trace ends FULFILLED, and #TRACEd with an "-- expect:" line where it does not.

`3 Nov 2026`  MEANS DATE_FROM_DMY 3 11 2026
`9 Nov 2026`  MEANS DATE_FROM_DMY 9 11 2026
`10 Nov 2026` MEANS DATE_FROM_DMY 10 11 2026
`3 Nov 2031`  MEANS DATE_FROM_DMY 3 11 2031

-- =====================================================================================================================
-- CASE E1. Notifying the insurer (1998 Act s 44(2), (4)).
-- =====================================================================================================================

#ASSERT `Within how many hours must I notify my insurer` FALSE EQUALS JUST 48
#ASSERT `Within how many hours must I notify my insurer` TRUE EQUALS NOTHING
#ASSERT `Did I notify my insurer in time` FALSE 48
#ASSERT NOT (`Did I notify my insurer in time` FALSE 49)
-- A self-insurer has no s 44(2) duty, so it cannot be late.
#ASSERT `Did I notify my insurer in time` TRUE 100

-- =====================================================================================================================
-- CASE E2. The notification records (Regulation cl 35(2), (3)). Notified 3 November 2026; a request on 3 November 2026.
-- =====================================================================================================================

-- "at least 5 years after the notification": to 3 November 2031.
#ASSERT `Until when must I keep my notification records` `3 Nov 2026` EQUALS `3 Nov 2031`
-- "no later than 7 days after the date of" the request: 10 November 2026.
#ASSERT `By what day must I make my notification records available` `3 Nov 2026` EQUALS `10 Nov 2026`

-- =====================================================================================================================
-- CASE E3. A claim or a request from the insurer (1998 Act s 264). Received 3 November 2026: 7 days, to 10 November.
-- =====================================================================================================================

#ASSERT `By what day must I forward the claim` FALSE `3 Nov 2026` EQUALS JUST `10 Nov 2026`
#ASSERT `By what day must I forward the claim` TRUE `3 Nov 2026` EQUALS NOTHING
#ASSERT `By what day must I give the insurer what it asked for` `3 Nov 2026` EQUALS `10 Nov 2026`
-- MIRROR (worker's seat): on 9 November, not yet forwarded, the worker is told the same deadline.
#ASSERT `Has my employer missed the deadline to forward my claim` FALSE `3 Nov 2026` FALSE `3 Nov 2026` `9 Nov 2026` EQUALS `not yet done, and the deadline has not passed: it is` `10 Nov 2026`
#ASSERT `Has my employer missed the deadline to forward my claim` TRUE `3 Nov 2026` FALSE `3 Nov 2026` `9 Nov 2026` EQUALS `no such duty`

-- =====================================================================================================================
-- CASE E4. Suitable work (1998 Act s 49). Answers: able to return; asked; not reasonably practicable; left voluntarily;
-- ended by the employer for another reason.
-- =====================================================================================================================

#ASSERT `Must I provide suitable work` TRUE TRUE FALSE FALSE FALSE
#ASSERT NOT (`Must I provide suitable work` TRUE TRUE TRUE FALSE FALSE)
#ASSERT NOT (`Must I provide suitable work` TRUE TRUE FALSE FALSE TRUE)
-- MIRROR (worker's seat): the same facts give the same answer.
#ASSERT `Must I provide suitable work` TRUE TRUE FALSE FALSE FALSE EQUALS `Must my employer give me suitable work` TRUE TRUE FALSE FALSE FALSE
#ASSERT `Must I provide suitable work` TRUE TRUE FALSE TRUE FALSE EQUALS `Must my employer give me suitable work` TRUE TRUE FALSE TRUE FALSE
#ASSERT `Must I provide suitable work` TRUE FALSE FALSE FALSE FALSE EQUALS `Must my employer give me suitable work` TRUE FALSE FALSE FALSE FALSE

-- =====================================================================================================================
-- CASE E5. What follows if the employer misses a duty (Regulation cl 36, cl 35; 1998 Act ss 264, 49; Schedule 5).
-- =====================================================================================================================

#ASSERT (`What follows if I, the employer, miss this duty` `the employer's duty to notify the insurer within 48 hours (1998 Act s 44(2))`)'s `maximum penalty in penalty units` EQUALS 20
#ASSERT (`What follows if I, the employer, miss this duty` `the employer's duty to notify the insurer within 48 hours (1998 Act s 44(2))`)'s `penalty notice amount in dollars` EQUALS 550
#ASSERT (`What follows if I, the employer, miss this duty` `the employer's duty to forward a claim within 7 days (1998 Act s 264(1))`)'s `maximum penalty in penalty units` EQUALS 50
#ASSERT (`What follows if I, the employer, miss this duty` `the employer's duty to forward a claim within 7 days (1998 Act s 264(1))`)'s `penalty notice amount in dollars` EQUALS 1100
#ASSERT (`What follows if I, the employer, miss this duty` `the employer's duty to provide suitable work (1998 Act s 49)`)'s `maximum penalty in penalty units` EQUALS 50
#ASSERT (`What follows if I, the employer, miss this duty` `the employer's duty to provide suitable work (1998 Act s 49)`)'s `penalty notice amount in dollars` EQUALS 0
#ASSERT (`What follows if I, the employer, miss this duty` `the employer's duty to make notification records available within 7 days (Regulation cl 35(3))`)'s `maximum penalty in penalty units` EQUALS 20

-- =====================================================================================================================
-- CASE E6. The employer's regulative rules. Clock: hours from becoming aware (s 44(2)); days from receipt (s 264) or the
-- request (cl 35(3)).
-- =====================================================================================================================

#ASSERT EVALTRACE (`s 44(2) -- the employer must notify the insurer within 48 hours of becoming aware of the injury` FALSE) 0 (LIST (EVENT `the employer` `notify the insurer of the workplace injury` 48)) EQUALS FULFILLED
#ASSERT EVALTRACE (`s 44(2) -- the employer must notify the insurer within 48 hours of becoming aware of the injury` TRUE) 0 (LIST (WAITUNTIL 100)) EQUALS FULFILLED
-- expect: BREACH BY the employer, "1998 Act s 44(2): the employer must notify the insurer within 48 hours ..." (nothing
-- by hour 48; the trace reads hour 49)
#TRACE `s 44(2) -- the employer must notify the insurer within 48 hours of becoming aware of the injury` FALSE AT 0 WITH
    (WAITUNTIL 49)

#ASSERT EVALTRACE (`s 264(1) -- the employer must forward a claim to its insurer within 7 days` FALSE) 0 (LIST (EVENT `the employer` `forward the claim to the insurer` 7)) EQUALS FULFILLED
#ASSERT EVALTRACE (`s 264(1) -- the employer must forward a claim to its insurer within 7 days` TRUE) 0 (LIST (WAITUNTIL 30)) EQUALS FULFILLED
-- expect: BREACH BY the employer, "1998 Act s 264(1): the employer must forward a claim to its insurer within 7 days ..."
-- (forwarded on day 8)
#TRACE `s 264(1) -- the employer must forward a claim to its insurer within 7 days` FALSE AT 0 WITH
    PARTY `the employer` DOES `forward the claim to the insurer` AT 8

#ASSERT EVALTRACE `s 264(2) -- the employer must give the insurer the information it requests within 7 days` 0 (LIST (EVENT `the employer` `give the insurer the information it requested` 5)) EQUALS FULFILLED
-- expect: BREACH BY the employer, "1998 Act s 264(2): the employer must give the insurer the information ... within 7
-- days ..." (nothing by day 7; the trace reads day 8)
#TRACE `s 264(2) -- the employer must give the insurer the information it requests within 7 days` AT 0 WITH
    (WAITUNTIL 8)

#ASSERT EVALTRACE `Regulation cl 35(3) -- the employer must make its notification records available within 7 days of a request` 0 (LIST (EVENT `the employer` `make the notification records available` 7)) EQUALS FULFILLED
-- expect: BREACH BY the employer, "Regulation cl 35(3): the employer must make its records ... no later than 7 days
-- after a request ..." (nothing by day 7; the trace reads day 8)
#TRACE `Regulation cl 35(3) -- the employer must make its notification records available within 7 days of a request` AT 0 WITH
    (WAITUNTIL 8)

-- MIRROR (the worker's side of s 49): the worker asks on day 3 and the employer provides on day 10.
#ASSERT EVALTRACE (`s 49 -- at the worker's request, the employer must provide suitable employment` FALSE) 0 (LIST (EVENT `the worker` `request suitable employment` 3), (EVENT `the employer` `provide suitable employment` 10)) EQUALS FULFILLED
