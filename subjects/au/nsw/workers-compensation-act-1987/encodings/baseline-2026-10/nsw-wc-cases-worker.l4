#ASSERT NOT (`Must my employer give me suitable work` FALSE TRUE FALSE FALSE FALSE)

-- =====================================================================================================================
-- CASE W16. A return to work notice (1998 Act ss 48, 48A). Notice given 1 March 2026. Answers: notice day; date in it;
-- reason etc stated; complied; day complied; history in the 12 months; today.
-- =====================================================================================================================

-- A date 13 days ahead (14 March) is too soon; 14 days (15 March) is allowed; 60 days (30 April) is allowed; 61 days
-- (1 May) is too late.
#ASSERT `What can the insurer do after its return to work notice` `1 Mar 2026` `14 Mar 2026` TRUE FALSE `1 Mar 2026` FALSE `20 Mar 2026` EQUALS `the insurer may not suspend: the notice does not meet s 48A(2)`
#ASSERT `What can the insurer do after its return to work notice` `1 Mar 2026` `1 May 2026` TRUE FALSE `1 Mar 2026` FALSE `20 Mar 2026` EQUALS `the insurer may not suspend: the notice does not meet s 48A(2)`
#ASSERT `What can the insurer do after its return to work notice` `1 Mar 2026` `30 Apr 2026` TRUE FALSE `1 Mar 2026` FALSE `20 Mar 2026` EQUALS `no suspension yet: the worker has until the date in the notice to comply` `30 Apr 2026`
-- On 30 April itself, not yet complied: the suspension may run to 28 May (30 April + 28 days).
#ASSERT `What can the insurer do after its return to work notice` `1 Mar 2026` `30 Apr 2026` TRUE FALSE `1 Mar 2026` FALSE `30 Apr 2026` EQUALS `the insurer may suspend weekly payments for 28 days after the date in the notice, to` `28 May 2026`
-- Date 15 March: complied on 10 March, before it: no suspension.
#ASSERT `What can the insurer do after its return to work notice` `1 Mar 2026` `15 Mar 2026` TRUE TRUE `10 Mar 2026` FALSE `20 Mar 2026` EQUALS `the insurer may not suspend: the worker complied by the date in the notice`
-- Asked on 10 March, not yet complied: no suspension before 15 March.
#ASSERT `What can the insurer do after its return to work notice` `1 Mar 2026` `15 Mar 2026` TRUE FALSE `1 Mar 2026` FALSE `10 Mar 2026` EQUALS `no suspension yet: the worker has until the date in the notice to comply` `15 Mar 2026`
-- Not complied by 15 March; asked on 20 March: suspension may run 28 days after 15 March, to 12 April.
#ASSERT `What can the insurer do after its return to work notice` `1 Mar 2026` `15 Mar 2026` TRUE FALSE `1 Mar 2026` FALSE `20 Mar 2026` EQUALS `the insurer may suspend weekly payments for 28 days after the date in the notice, to` `12 Apr 2026`
-- Complied on 1 April, during the suspension: payments must resume from 1 April (s 48A(4)).
#ASSERT `What can the insurer do after its return to work notice` `1 Mar 2026` `15 Mar 2026` TRUE TRUE `1 Apr 2026` FALSE `13 Apr 2026` EQUALS `the insurer must resume weekly payments from the day the worker complied, and the suspended payments are forfeited (s 48A(4), (5))` `1 Apr 2026`
-- Not complied through 12 April; asked on 13 April: the insurer may terminate (s 48A(6)), or with the history, cease and
-- determine the entitlement (s 48A(7)).
#ASSERT `What can the insurer do after its return to work notice` `1 Mar 2026` `15 Mar 2026` TRUE FALSE `1 Mar 2026` FALSE `13 Apr 2026` EQUALS `the insurer may terminate weekly payments by written notice stating the reasons (s 48A(6))`
#ASSERT `What can the insurer do after its return to work notice` `1 Mar 2026` `15 Mar 2026` TRUE FALSE `1 Mar 2026` TRUE `13 Apr 2026` EQUALS `the insurer may cease and determine the entitlement to weekly payments by written notice stating the reasons (s 48A(7))`
-- A notice that does not state the consequences allows no suspension.
#ASSERT `What can the insurer do after its return to work notice` `1 Mar 2026` `15 Mar 2026` FALSE FALSE `1 Mar 2026` FALSE `20 Mar 2026` EQUALS `the insurer may not suspend: the notice does not meet s 48A(2)`

-- =====================================================================================================================
-- CASE W17. Regulative rules the worker is party to.
-- =====================================================================================================================

-- 1998 Act s 44 (hours from the injury). The worker notifies at hour 2; the employer has 48 hours from then (to hour 50).
#ASSERT EVALTRACE (`s 44 -- the worker must notify the employer as soon as possible, and the employer must then notify the insurer within 48 hours` FALSE) 0 (LIST (EVENT `the worker` `notify the employer of the workplace injury` 2), (EVENT `the employer` `notify the insurer of the workplace injury` 40)) EQUALS FULFILLED
#ASSERT EVALTRACE (`s 44 -- the worker must notify the employer as soon as possible, and the employer must then notify the insurer within 48 hours` FALSE) 0 (LIST (EVENT `the worker` `notify the employer of the workplace injury` 2), (EVENT `the employer` `notify the insurer of the workplace injury` 50)) EQUALS FULFILLED
-- A self-insurer has no s 44(2) duty: the worker's notice ends it.
#ASSERT EVALTRACE (`s 44 -- the worker must notify the employer as soon as possible, and the employer must then notify the insurer within 48 hours` TRUE) 0 (LIST (EVENT `the worker` `notify the employer of the workplace injury` 2)) EQUALS FULFILLED
-- expect: BREACH BY the employer, "1998 Act s 44(2): the employer must notify the insurer within 48 hours ..." (worker
-- notified at hour 2; nothing by hour 50)
#TRACE `s 44 -- the worker must notify the employer as soon as possible, and the employer must then notify the insurer within 48 hours` FALSE AT 0 WITH
    PARTY `the worker` DOES `notify the employer of the workplace injury` AT 2
    (WAITUNTIL 60)
-- expect: the worker's obligation to notify the employer, still open (no hours are set: "as soon as possible")
#TRACE `s 44 -- the worker must notify the employer as soon as possible, and the employer must then notify the insurer within 48 hours` FALSE AT 0 WITH
    (WAITUNTIL 1000)

-- 1998 Act s 261 (days from the injury on 15 March 2025): 6 months to 15 September 2025 = 184 days; 3 years to
-- 15 March 2028 = 365 + 365 + 366 = 1096 days. The late-claim rule starts at the event that shows the 6 months have
-- passed (here a WAITUNTIL at day 185), so its 912 days run from there.
#ASSERT EVALTRACE (`s 261 -- a claim within 6 months, or only an exception lets compensation be recovered` 184 1096 FALSE FALSE) 0 (LIST (EVENT `the worker` `make a claim for compensation` 100)) EQUALS FULFILLED
#ASSERT EVALTRACE (`s 261 -- a claim within 6 months, or only an exception lets compensation be recovered` 184 1096 FALSE FALSE) 0 (LIST (EVENT `the worker` `make a claim for compensation` 184)) EQUALS FULFILLED
-- Late, no reasonable cause: only the insurer's acceptance helps; it accepts on day 300.
#ASSERT EVALTRACE (`s 261 -- a claim within 6 months, or only an exception lets compensation be recovered` 184 1096 FALSE FALSE) 0 (LIST (WAITUNTIL 185), (EVENT `the insurer` `determine to accept the late claim` 300)) EQUALS FULFILLED
-- Late with reasonable cause: a claim on day 1000 is within the 3 years.
#ASSERT EVALTRACE (`s 261 -- a claim within 6 months, or only an exception lets compensation be recovered` 184 1096 TRUE FALSE) 0 (LIST (WAITUNTIL 185), (EVENT `the worker` `make a claim for compensation` 1000)) EQUALS FULFILLED
-- Reasonable cause and serious and permanent disablement: any time, here day 2000.
#ASSERT EVALTRACE (`s 261 -- a claim within 6 months, or only an exception lets compensation be recovered` 184 1096 TRUE TRUE) 0 (LIST (WAITUNTIL 185), (EVENT `the worker` `make a claim for compensation` 2000)) EQUALS FULFILLED
-- expect: the insurer's permission to determine to accept the late claim, still open (no claim by day 184, no reasonable
-- cause)
#TRACE `s 261 -- a claim within 6 months, or only an exception lets compensation be recovered` 184 1096 FALSE FALSE AT 0 WITH
    (WAITUNTIL 185)
-- expect: BREACH BY the worker, "1998 Act s 261(1), (4)(a): no claim within 3 years ..." (reasonable cause, but no claim
-- by day 185 + 912 = 1097)
#TRACE `s 261 -- a claim within 6 months, or only an exception lets compensation be recovered` 184 1096 TRUE FALSE AT 0 WITH
    (WAITUNTIL 185)
    (WAITUNTIL 1200)

-- 1998 Act ss 48, 48A (days from the notice): the date is 14 days ahead.
#ASSERT EVALTRACE (`ss 48, 48A -- a worker given a return to work notice complies by the date, or weekly payments may be suspended and then ended` 14 TRUE FALSE) 0 (LIST (EVENT `the worker` `comply with the s 48 obligation in the notice` 10)) EQUALS FULFILLED
-- Not complied by day 14; complies on day 30 (inside the 28 days from day 15); the insurer resumes on day 31.
#ASSERT EVALTRACE (`ss 48, 48A -- a worker given a return to work notice complies by the date, or weekly payments may be suspended and then ended` 14 TRUE FALSE) 0 (LIST (WAITUNTIL 15), (EVENT `the worker` `comply with the s 48 obligation in the notice` 30), (EVENT `the insurer` `resume weekly payments from the day the worker complied` 31)) EQUALS FULFILLED
-- Not complied through the suspension: the insurer may terminate, and does on day 50; with the s 48A(7)(b) history it
-- may cease and determine the entitlement instead.
#ASSERT EVALTRACE (`ss 48, 48A -- a worker given a return to work notice complies by the date, or weekly payments may be suspended and then ended` 14 TRUE FALSE) 0 (LIST (WAITUNTIL 15), (WAITUNTIL 44), (EVENT `the insurer` `terminate weekly payments by written notice` 50)) EQUALS FULFILLED
#ASSERT EVALTRACE (`ss 48, 48A -- a worker given a return to work notice complies by the date, or weekly payments may be suspended and then ended` 14 TRUE TRUE) 0 (LIST (WAITUNTIL 15), (WAITUNTIL 44), (EVENT `the insurer` `cease and determine the entitlement to weekly payments by written notice` 50)) EQUALS FULFILLED
-- expect: the insurer's obligation to resume weekly payments, still open (worker complied on day 30)
#TRACE `ss 48, 48A -- a worker given a return to work notice complies by the date, or weekly payments may be suspended and then ended` 14 TRUE FALSE AT 0 WITH
    (WAITUNTIL 15)
    PARTY `the worker` DOES `comply with the s 48 obligation in the notice` AT 30
-- expect: BREACH BY the insurer, "1998 Act s 48A(1)-(2): the insurer may suspend only in accordance with s 48A ..." (a
-- date only 10 days ahead; the insurer suspends on day 12)
#TRACE `ss 48, 48A -- a worker given a return to work notice complies by the date, or weekly payments may be suspended and then ended` 10 TRUE FALSE AT 0 WITH
    PARTY `the insurer` DOES `suspend weekly payments` AT 12

-- 1998 Act s 49 (days from the worker being able to return).
#ASSERT EVALTRACE (`s 49 -- at the worker's request, the employer must provide suitable employment` FALSE) 0 (LIST (EVENT `the worker` `request suitable employment` 3), (EVENT `the employer` `provide suitable employment` 10)) EQUALS FULFILLED
#ASSERT EVALTRACE (`s 49 -- at the worker's request, the employer must provide suitable employment` TRUE) 0 (LIST (WAITUNTIL 30)) EQUALS FULFILLED
-- expect: the employer's obligation to provide suitable employment, still open (requested on day 3; no days are set)
#TRACE `s 49 -- at the worker's request, the employer must provide suitable employment` FALSE AT 0 WITH
    PARTY `the worker` DOES `request suitable employment` AT 3
    (WAITUNTIL 100)
