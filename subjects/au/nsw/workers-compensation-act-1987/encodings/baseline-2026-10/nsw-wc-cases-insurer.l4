IMPORT prelude
IMPORT `nsw-wc-core`
IMPORT `nsw-wc-seat`
IMPORT `nsw-wc-seat-insurer`

-- Cases for the insurer's seat (nsw-wc-seat-insurer.l4), the insurer's regulative rules in nsw-wc-core.l4 (1998 Act
-- ss 267-269, 274; 1987 Act s 38(4), (5)), and MIRROR CASES: the same facts asked from the worker's seat (nsw-wc-seat.l4),
-- with answers that agree. Every expected value was worked by hand from the deposited texts, never copied from the
-- encoding's output. HYPOTHETICAL throughout.
--
-- A breached or still-pending DEONTIC cannot be asserted on the stable l4, so regulative rules are asserted where the
-- trace ends FULFILLED, and #TRACEd with an "-- expect:" line where it does not.

`15 Mar 2025` MEANS DATE_FROM_DMY 15 3 2025
`1 Mar 2026`  MEANS DATE_FROM_DMY 1 3 2026
`14 Mar 2026` MEANS DATE_FROM_DMY 14 3 2026
`15 Mar 2026` MEANS DATE_FROM_DMY 15 3 2026
`20 Mar 2026` MEANS DATE_FROM_DMY 20 3 2026
`1 Apr 2026`  MEANS DATE_FROM_DMY 1 4 2026
`13 Apr 2026` MEANS DATE_FROM_DMY 13 4 2026
`30 Apr 2026` MEANS DATE_FROM_DMY 30 4 2026
`1 May 2026`  MEANS DATE_FROM_DMY 1 5 2026
`2 Jul 2026`  MEANS DATE_FROM_DMY 2 7 2026
`2 Nov 2026`  MEANS DATE_FROM_DMY 2 11 2026
`3 Nov 2026`  MEANS DATE_FROM_DMY 3 11 2026
`5 Nov 2026`  MEANS DATE_FROM_DMY 5 11 2026
`9 Nov 2026`  MEANS DATE_FROM_DMY 9 11 2026
`12 Nov 2026` MEANS DATE_FROM_DMY 12 11 2026
`20 Nov 2026` MEANS DATE_FROM_DMY 20 11 2026
`23 Nov 2026` MEANS DATE_FROM_DMY 23 11 2026
`3 Dec 2026`  MEANS DATE_FROM_DMY 3 12 2026
`28 Jan 2027` MEANS DATE_FROM_DMY 28 1 2027
`1 Feb 2027`  MEANS DATE_FROM_DMY 1 2 2027
`30 Jun 2027` MEANS DATE_FROM_DMY 30 6 2027
`15 Mar 2028` MEANS DATE_FROM_DMY 15 3 2028
`16 Mar 2028` MEANS DATE_FROM_DMY 16 3 2028
`1 Feb 2029`  MEANS DATE_FROM_DMY 1 2 2029

-- =====================================================================================================================
-- CASE I1. After the initial notification (1998 Act ss 267, 268). Initial notification on 2 November 2026: 7 days, to
-- 9 November 2026.
-- =====================================================================================================================

#ASSERT `What must I do within 7 days of the initial notification` FALSE EQUALS `the insurer's duty to start provisional weekly payments within 7 days (1998 Act s 267)`
#ASSERT `What must I do within 7 days of the initial notification` TRUE EQUALS `the insurer's duty to give notice of a reasonable excuse within 7 days (1998 Act s 268)`
#ASSERT `By what day must I act on the initial notification` `2 Nov 2026` EQUALS `9 Nov 2026`
-- MIRROR (worker's seat): nothing done by 12 November; the worker is told the same deadline was missed.
#ASSERT `Has the insurer missed its 7-day deadline` `2 Nov 2026` FALSE `2 Nov 2026` FALSE `2 Nov 2026` `12 Nov 2026` EQUALS `missed: not done by the deadline` (`By what day must I act on the initial notification` `2 Nov 2026`)

-- =====================================================================================================================
-- CASE I2. Determining a claim for weekly payments (1998 Act s 274). Claim made 2 November 2026: 21 days, to
-- 23 November 2026.
-- =====================================================================================================================

#ASSERT `By what day must I determine the claim for weekly payments` `2 Nov 2026` 0 `2 Nov 2026` EQUALS `23 Nov 2026`
-- Provisional acceptance for 12 weeks from 5 November 2026: 84 days, to 28 January 2027 (s 274(3)).
#ASSERT `By what day must I determine the claim for weekly payments` `2 Nov 2026` 12 `5 Nov 2026` EQUALS `28 Jan 2027`
-- 4 weeks from 5 November: 28 days, to 3 December 2026, later than 23 November.
#ASSERT `By what day must I determine the claim for weekly payments` `2 Nov 2026` 4 `5 Nov 2026` EQUALS `3 Dec 2026`
-- 2 weeks from 3 November ends 17 November, before 23 November: s 274(3) only extends, so 23 November.
#ASSERT `By what day must I determine the claim for weekly payments` `2 Nov 2026` 2 `3 Nov 2026` EQUALS `23 Nov 2026`
-- 20 weeks is more than the Act allows: counted as 12, so 28 January 2027.
#ASSERT `By what day must I determine the claim for weekly payments` `2 Nov 2026` 20 `5 Nov 2026` EQUALS `28 Jan 2027`
-- May I accept provisionally (s 274(2), (4))? 12 weeks yes; 13 no; 0 no; not while Division 1 payments were running.
#ASSERT `May I accept liability provisionally for this many weeks` 12 FALSE
#ASSERT NOT (`May I accept liability provisionally for this many weeks` 13 FALSE)
#ASSERT NOT (`May I accept liability provisionally for this many weeks` 0 FALSE)
#ASSERT NOT (`May I accept liability provisionally for this many weeks` 6 TRUE)
-- MIRROR (worker's seat): undecided on 20 November, the worker is told the same day.
#ASSERT `Has the insurer missed its deadline to decide my weekly payments claim` `2 Nov 2026` 0 `2 Nov 2026` FALSE `2 Nov 2026` `20 Nov 2026` EQUALS `not yet done, and the deadline has not passed: it is` (`By what day must I determine the claim for weekly payments` `2 Nov 2026` 0 `2 Nov 2026`)
#ASSERT `Has the insurer missed its deadline to decide my weekly payments claim` `2 Nov 2026` 12 `5 Nov 2026` FALSE `2 Nov 2026` `20 Nov 2026` EQUALS `not yet done, and the deadline has not passed: it is` (`By what day must I determine the claim for weekly payments` `2 Nov 2026` 12 `5 Nov 2026`)

-- =====================================================================================================================
-- CASE I3. A late claim (1998 Act s 261(5)). Injury 15 March 2025; the 3 years end 15 March 2028.
-- =====================================================================================================================

#ASSERT `May I accept this late claim` `15 Mar 2025` `15 Mar 2025` `15 Mar 2028` FALSE
#ASSERT NOT (`May I accept this late claim` `15 Mar 2025` `15 Mar 2025` `16 Mar 2028` FALSE)
#ASSERT `May I accept this late claim` `15 Mar 2025` `15 Mar 2025` `16 Mar 2028` TRUE
-- MIRROR (worker's seat): the insurer accepted the claim made 16 March 2028 without the Authority's approval: the
-- acceptance does not help, and the worker's claim is barred.
#ASSERT `Is my claim in time` FALSE `15 Mar 2025` `15 Mar 2025` `16 Mar 2028` FALSE FALSE FALSE TRUE FALSE EQUALS `late, and compensation cannot be recovered (s 261(1))`
#ASSERT `Is my claim in time` FALSE `15 Mar 2025` `15 Mar 2025` `16 Mar 2028` FALSE FALSE FALSE TRUE TRUE EQUALS `late, but no bar: the insurer determined to accept it (s 261(5))`

-- =====================================================================================================================
-- CASE I4. A s 48A return to work notice given 1 March 2026.
-- =====================================================================================================================

#ASSERT `Is the date in my s 48A notice allowed` `1 Mar 2026` `15 Mar 2026`
#ASSERT NOT (`Is the date in my s 48A notice allowed` `1 Mar 2026` `14 Mar 2026`)
#ASSERT `Is the date in my s 48A notice allowed` `1 Mar 2026` `30 Apr 2026`
#ASSERT NOT (`Is the date in my s 48A notice allowed` `1 Mar 2026` `1 May 2026`)
-- MIRROR (worker's seat): the same facts give the same answer, from either seat.
#ASSERT `What may I do now under s 48A` `1 Mar 2026` `15 Mar 2026` TRUE FALSE `1 Mar 2026` FALSE `20 Mar 2026` EQUALS `What can the insurer do after its return to work notice` `1 Mar 2026` `15 Mar 2026` TRUE FALSE `1 Mar 2026` FALSE `20 Mar 2026`
#ASSERT `What may I do now under s 48A` `1 Mar 2026` `15 Mar 2026` TRUE TRUE `1 Apr 2026` FALSE `13 Apr 2026` EQUALS `What can the insurer do after its return to work notice` `1 Mar 2026` `15 Mar 2026` TRUE TRUE `1 Apr 2026` FALSE `13 Apr 2026`
#ASSERT `What may I do now under s 48A` `1 Mar 2026` `15 Mar 2026` TRUE FALSE `1 Mar 2026` TRUE `13 Apr 2026` EQUALS `the insurer may cease and determine the entitlement to weekly payments by written notice stating the reasons (s 48A(7))`
#ASSERT `What may I do now under s 48A` `1 Mar 2026` `14 Mar 2026` TRUE FALSE `1 Mar 2026` FALSE `20 Mar 2026` EQUALS `the insurer may not suspend: the notice does not meet s 48A(2)`

-- =====================================================================================================================
-- CASE I5. Work capacity assessments (1987 Act s 38(4), (5)). Second entitlement period's last day 30 June 2027: the
-- last 52 weeks run from 2 July 2026 (30 June 2027 less 363 days) to 30 June 2027.
-- =====================================================================================================================

#ASSERT `When must I conduct a work capacity assessment` FALSE FALSE `30 Jun 2027` FALSE `30 Jun 2027` EQUALS `conduct one during the last 52 weeks of the second entitlement period, between` `2 Jul 2026` `30 Jun 2027`
-- Assessed on 1 February 2027: the next by 1 February 2029 (s 38(4)(b)).
#ASSERT `When must I conduct a work capacity assessment` FALSE FALSE `30 Jun 2027` TRUE `1 Feb 2027` EQUALS `conduct the next one by` `1 Feb 2029`
#ASSERT `When must I conduct a work capacity assessment` TRUE FALSE `30 Jun 2027` FALSE `30 Jun 2027` EQUALS `not to be conducted: a worker with highest needs who has not asked for one (s 38(5))`
#ASSERT `When must I conduct a work capacity assessment` TRUE TRUE `30 Jun 2027` FALSE `30 Jun 2027` EQUALS `may be conducted, if the insurer thinks it appropriate: a worker with highest needs who asked for one (s 38(5))`

-- =====================================================================================================================
-- CASE I6. What follows if the insurer misses a duty (1998 Act ss 267(5), 268, 283; Regulation Schedule 5).
-- =====================================================================================================================

#ASSERT (`What follows if I, the insurer, miss this duty` `the insurer's duty to start provisional weekly payments within 7 days (1998 Act s 267)`)'s `maximum penalty in penalty units` EQUALS 50
#ASSERT (`What follows if I, the insurer, miss this duty` `the insurer's duty to start provisional weekly payments within 7 days (1998 Act s 267)`)'s `penalty notice amount in dollars` EQUALS 1100
#ASSERT (`What follows if I, the insurer, miss this duty` `the insurer's duty to give notice of a reasonable excuse within 7 days (1998 Act s 268)`)'s `maximum penalty in penalty units` EQUALS 50
#ASSERT (`What follows if I, the insurer, miss this duty` `the insurer's duty to determine a claim for weekly payments within 21 days (1998 Act ss 274, 283)`)'s `penalty notice amount in dollars` EQUALS 1100
-- The worker's s 48 duty carries no penalty: s 48A is the consequence.
#ASSERT (`What follows if I, the insurer, miss this duty` `the worker's duty to make reasonable efforts to return to work (1998 Act s 48)`)'s `maximum penalty in penalty units` EQUALS 0

-- =====================================================================================================================
-- CASE I7. The insurer's regulative rules. Clock: days from the initial notification (ss 267-269), from the claim
-- (s 274), or from the start of the last 52 weeks (s 38(4)).
-- =====================================================================================================================

-- ss 267-269, no reasonable excuse: payments start on day 7, and the s 269 notice follows on day 10.
#ASSERT EVALTRACE (`ss 267-269 -- the insurer must start provisional weekly payments within 7 days, or give notice of its reasonable excuse` FALSE) 0 (LIST (EVENT `the insurer` `commence provisional weekly payments` 7), (EVENT `the insurer` `give the worker notice of the s 269 matters` 10)) EQUALS FULFILLED
-- With a reasonable excuse: the s 268 notice on day 7.
#ASSERT EVALTRACE (`ss 267-269 -- the insurer must start provisional weekly payments within 7 days, or give notice of its reasonable excuse` TRUE) 0 (LIST (EVENT `the insurer` `give the worker written notice of the reasonable excuse` 7)) EQUALS FULFILLED
-- expect: the insurer's obligation to give the s 269 notice, still open ("as soon as practicable": no days are set)
#TRACE `ss 267-269 -- the insurer must start provisional weekly payments within 7 days, or give notice of its reasonable excuse` FALSE AT 0 WITH
    PARTY `the insurer` DOES `commence provisional weekly payments` AT 7
-- expect: BREACH BY the insurer, "1998 Act s 267(1), (5): without a reasonable excuse the insurer must start provisional
-- weekly payments within 7 days ..." (nothing by day 8)
#TRACE `ss 267-269 -- the insurer must start provisional weekly payments within 7 days, or give notice of its reasonable excuse` FALSE AT 0 WITH
    (WAITUNTIL 8)
-- expect: BREACH BY the insurer, "1998 Act s 268: an insurer with a reasonable excuse ... must give the worker written
-- notice of it within 7 days ..." (nothing by day 9)
#TRACE `ss 267-269 -- the insurer must start provisional weekly payments within 7 days, or give notice of its reasonable excuse` TRUE AT 0 WITH
    (WAITUNTIL 9)

-- s 274, no provisional payments already running: disputing on day 21, or accepting on day 10.
#ASSERT EVALTRACE (`s 274 -- the insurer must determine a claim for weekly payments within 21 days, or by the end of a provisional acceptance` 0) 0 (LIST (EVENT `the insurer` (`determine the claim for weekly payments` `disputing liability`) 21)) EQUALS FULFILLED
#ASSERT EVALTRACE (`s 274 -- the insurer must determine a claim for weekly payments within 21 days, or by the end of a provisional acceptance` 0) 0 (LIST (EVENT `the insurer` (`determine the claim for weekly payments` `accepting liability and commencing weekly payments`) 10)) EQUALS FULFILLED
-- Provisional acceptance for 12 weeks on day 5; final acceptance on day 89 (5 + 84).
#ASSERT EVALTRACE (`s 274 -- the insurer must determine a claim for weekly payments within 21 days, or by the end of a provisional acceptance` 0) 0 (LIST (EVENT `the insurer` (`determine the claim for weekly payments` (`accepting liability provisionally for` 12)) 5), (EVENT `the insurer` (`determine the claim for weekly payments` `accepting liability and commencing weekly payments`) 89)) EQUALS FULFILLED
-- Provisional payments already running with 40 days left (s 276(1)): disputing on day 35 is in time.
#ASSERT EVALTRACE (`s 274 -- the insurer must determine a claim for weekly payments within 21 days, or by the end of a provisional acceptance` 40) 0 (LIST (EVENT `the insurer` (`determine the claim for weekly payments` `disputing liability`) 35)) EQUALS FULFILLED
-- expect: BREACH BY the insurer, "1998 Act s 274(1), 283(1): the insurer must determine a claim for weekly payments
-- within 21 days ..." (nothing by day 22)
#TRACE `s 274 -- the insurer must determine a claim for weekly payments within 21 days, or by the end of a provisional acceptance` 0 AT 0 WITH
    (WAITUNTIL 22)
-- expect: BREACH BY the insurer, "1998 Act s 274(1), 283(1): ... within 21 days ..." (a 13-week provisional acceptance
-- is not one s 274(2) allows, so it does not count)
#TRACE `s 274 -- the insurer must determine a claim for weekly payments within 21 days, or by the end of a provisional acceptance` 0 AT 0 WITH
    PARTY `the insurer` DOES `determine the claim for weekly payments` (`accepting liability provisionally for` 13) AT 5
    (WAITUNTIL 22)
-- expect: BREACH BY the insurer, "1998 Act s 274(3), 283(1): after a provisional acceptance the insurer must determine
-- the claim by the end of the provisional period ..." (12 weeks from day 5 end on day 89; nothing by day 90)
#TRACE `s 274 -- the insurer must determine a claim for weekly payments within 21 days, or by the end of a provisional acceptance` 0 AT 0 WITH
    PARTY `the insurer` DOES `determine the claim for weekly payments` (`accepting liability provisionally for` 12) AT 5
    (WAITUNTIL 90)
-- expect: BREACH BY the insurer, "1998 Act ss 274(1), 276(1), 283(1): ..." (provisional payments already running with 40
-- days left; a further provisional acceptance on day 10 does not count, s 274(4); nothing final by day 41)
#TRACE `s 274 -- the insurer must determine a claim for weekly payments within 21 days, or by the end of a provisional acceptance` 40 AT 0 WITH
    PARTY `the insurer` DOES `determine the claim for weekly payments` (`accepting liability provisionally for` 6) AT 10
    (WAITUNTIL 41)

-- 1987 Act s 38(4), (5). A worker with highest needs who asked, the insurer thinking it appropriate: it may assess.
#ASSERT EVALTRACE (`s 38(4), (5) -- the insurer must ensure work capacity assessments, except for a worker with highest needs` TRUE TRUE) 0 (LIST (EVENT `the insurer` `conduct a work capacity assessment` 10)) EQUALS FULFILLED
-- expect: the s 38(4)(b) obligation to assess again within 730 days, still open (assessed on day 300 of the last 52
-- weeks)
#TRACE `s 38(4), (5) -- the insurer must ensure work capacity assessments, except for a worker with highest needs` FALSE FALSE AT 0 WITH
    PARTY `the insurer` DOES `conduct a work capacity assessment` AT 300
-- expect: BREACH BY the insurer, "1987 Act s 38(4)(a): the insurer must ensure a work capacity assessment during the
-- last 52 weeks ..." (none by day 363; the trace reads day 364)
#TRACE `s 38(4), (5) -- the insurer must ensure work capacity assessments, except for a worker with highest needs` FALSE FALSE AT 0 WITH
    (WAITUNTIL 364)
-- expect: BREACH BY the insurer, "1987 Act s 38(4)(b): ... at least once every 2 years" (assessed on day 300; none by
-- day 1030)
#TRACE `s 38(4), (5) -- the insurer must ensure work capacity assessments, except for a worker with highest needs` FALSE FALSE AT 0 WITH
    PARTY `the insurer` DOES `conduct a work capacity assessment` AT 300
    (WAITUNTIL 1100)
-- expect: BREACH BY the insurer, "1987 Act s 38(5): an insurer is not to conduct a work capacity assessment of a worker
-- with highest needs ..." (no request; assessed on day 10)
#TRACE `s 38(4), (5) -- the insurer must ensure work capacity assessments, except for a worker with highest needs` TRUE FALSE AT 0 WITH
    PARTY `the insurer` DOES `conduct a work capacity assessment` AT 10
