#ASSERT `Can my attorney use my property to benefit themselves or another` TRUE TRUE `my attorney` FALSE TRUE `some other expense` TRUE EQUALS JUST FALSE
#ASSERT `Can my attorney use my property to benefit themselves or another` TRUE TRUE `my attorney` FALSE TRUE `housing` FALSE EQUALS JUST FALSE
#ASSERT `Can my attorney use my property to benefit themselves or another` TRUE TRUE `a third party not named in it` FALSE TRUE `housing` TRUE EQUALS JUST FALSE
