IMPORT prelude
IMPORT `poa-dates`
IMPORT `poa-core`

-- Powers of Attorney Act 2003 (NSW) -- worked cases for every exported question in poa-core.l4 (the principal's seat).
-- Every expected value was worked by hand from the deposited text; none was copied from the encoding's output. Each
-- assertion is a claim about the ENCODING on stated facts, not about the law. Dates are illustrative.
-- BASELINE ENCODING. Not for public use as advice. See NOTES.md.

§ `cases -- the principal`

`d` MEANS `the date`

§§ `s 6`

#ASSERT `Which law governs my power of attorney` FALSE EQUALS `this Act`
#ASSERT `Which law governs my power of attorney` TRUE EQUALS `the continued Conveyancing Act 1919 provisions in Schedule 1, with s 25, Part 5 and Part 6 Division 3 of this Act`

§§ `s 19 -- enduring`

-- Arguments: says it continues; witness; witness is an attorney; certificate states all five.
#ASSERT `Does my document create an enduring power of attorney` TRUE `an Australian legal practitioner` FALSE TRUE EQUALS JUST TRUE
#ASSERT `Does my document create an enduring power of attorney` TRUE `a registrar of the Local Court` FALSE TRUE EQUALS JUST TRUE
#ASSERT `Does my document create an enduring power of attorney` TRUE `a licensed conveyancer who has completed the Minister's approved course` FALSE TRUE EQUALS JUST TRUE
#ASSERT `Does my document create an enduring power of attorney` TRUE `an employee of the NSW Trustee and Guardian who has completed the Minister's approved course` FALSE TRUE EQUALS JUST TRUE
#ASSERT `Does my document create an enduring power of attorney` TRUE `an employee of a trustee company who has completed the Minister's approved course` FALSE TRUE EQUALS JUST TRUE
#ASSERT `Does my document create an enduring power of attorney` TRUE `a legal practitioner qualified overseas, instructed and employed independently of any lawyer I appointed as attorney` FALSE TRUE EQUALS JUST TRUE
#ASSERT `Does my document create an enduring power of attorney` TRUE `a person the regulations prescribe as a witness` FALSE TRUE EQUALS JUST TRUE
-- Not a prescribed witness: a conveyancer without the course, a dependent overseas lawyer, anyone else (s 19(2) "means").
#ASSERT `Does my document create an enduring power of attorney` TRUE `a licensed conveyancer, or such an employee, who has not completed the approved course` FALSE TRUE EQUALS JUST FALSE
#ASSERT `Does my document create an enduring power of attorney` TRUE `a legal practitioner qualified overseas, not so independent` FALSE TRUE EQUALS JUST FALSE
#ASSERT `Does my document create an enduring power of attorney` TRUE `another person` FALSE TRUE EQUALS JUST FALSE
-- The witness is an attorney (s 19(1)(b)); no statement of intention (a); certificate missing a matter (c).
#ASSERT `Does my document create an enduring power of attorney` TRUE `an Australian legal practitioner` TRUE TRUE EQUALS JUST FALSE
#ASSERT `Does my document create an enduring power of attorney` FALSE `an Australian legal practitioner` FALSE TRUE EQUALS JUST FALSE
#ASSERT `Does my document create an enduring power of attorney` TRUE `an Australian legal practitioner` FALSE FALSE EQUALS JUST FALSE

§§ `s 20 -- acceptance`

#ASSERT `Is this attorney still barred from acting under my enduring power` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Is this attorney still barred from acting under my enduring power` TRUE TRUE EQUALS JUST FALSE
#ASSERT `Is this attorney still barred from acting under my enduring power` FALSE FALSE EQUALS NOTHING

§§ `s 15 -- irrevocable`

-- Arguments: says irrevocable; what I received; says given for valuable consideration.
#ASSERT `Does my document create an irrevocable power of attorney` TRUE `money, property or another real benefit` FALSE EQUALS JUST TRUE
#ASSERT `Does my document create an irrevocable power of attorney` TRUE `marriage` FALSE EQUALS JUST TRUE
-- Nominal consideration is not valuable consideration (s 3(1)), but the document's statement is enough (s 15(b)).
#ASSERT `Does my document create an irrevocable power of attorney` TRUE `only a nominal consideration` FALSE EQUALS JUST FALSE
#ASSERT `Does my document create an irrevocable power of attorney` TRUE `only a nominal consideration` TRUE EQUALS JUST TRUE
#ASSERT `Does my document create an irrevocable power of attorney` TRUE `nothing` FALSE EQUALS JUST FALSE
#ASSERT `Does my document create an irrevocable power of attorney` TRUE `nothing` TRUE EQUALS JUST TRUE
#ASSERT `Does my document create an irrevocable power of attorney` FALSE `money, property or another real benefit` TRUE EQUALS JUST FALSE

§§ `s 16 -- what does not end an irrevocable power`

-- Arguments: irrevocable; the event; the document provides otherwise.
#ASSERT `Does this event end my irrevocable power` TRUE `I died` FALSE EQUALS JUST FALSE
#ASSERT `Does this event end my irrevocable power` TRUE `I became bankrupt` FALSE EQUALS JUST FALSE
#ASSERT `Does this event end my irrevocable power` TRUE `I lost mental capacity` FALSE EQUALS JUST FALSE
#ASSERT `Does this event end my irrevocable power` TRUE `I became a mentally incapacitated person` FALSE EQUALS JUST FALSE
#ASSERT `Does this event end my irrevocable power` TRUE `I became a managed missing person` FALSE EQUALS JUST FALSE
#ASSERT `Does this event end my irrevocable power` TRUE `I did something about the power without my attorney's agreement` FALSE EQUALS JUST FALSE
#ASSERT `Does this event end my irrevocable power` TRUE `something else` FALSE EQUALS NOTHING
#ASSERT `Does this event end my irrevocable power` TRUE `I died` TRUE EQUALS NOTHING
#ASSERT `Does this event end my irrevocable power` FALSE `I died` FALSE EQUALS NOTHING

