§§ `ss 16, 18, 21 -- supervening incapacity`

-- Arguments: I understand the act; enduring; irrevocable; contrary intention.
#ASSERT `Can my attorney act for me in something I cannot understand` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Can my attorney act for me in something I cannot understand` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Can my attorney act for me in something I cannot understand` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Can my attorney act for me in something I cannot understand` FALSE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `Can my attorney act for me in something I cannot understand` FALSE FALSE FALSE FALSE EQUALS NOTHING
-- s 18 holds whatever the document says.
#ASSERT `Can my attorney act for me in something I cannot understand` TRUE TRUE FALSE TRUE EQUALS JUST TRUE

§§ `ss 17, 29-32 -- initial incapacity`

#ASSERT `Can my attorney do an act I could not understand when I gave the power` TRUE EQUALS JUST TRUE
#ASSERT `Can my attorney do an act I could not understand when I gave the power` FALSE EQUALS JUST FALSE

-- Arguments: within understanding when given; affirmed; capacity to affirm; incapacity continues; cannot understand
-- communications; cannot express; cannot be located; for my benefit; contrary intention.
#ASSERT `Can the Supreme Court confirm my power of attorney` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Can the Supreme Court confirm my power of attorney` FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- Affirmed without capacity: s 30 fails.
#ASSERT `Can the Supreme Court confirm my power of attorney` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Can the Supreme Court confirm my power of attorney` FALSE FALSE FALSE TRUE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
-- Incommunicate, each limb of s 4(1).
#ASSERT `Can the Supreme Court confirm my power of attorney` FALSE FALSE FALSE FALSE TRUE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Can the Supreme Court confirm my power of attorney` FALSE FALSE FALSE FALSE FALSE TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Can the Supreme Court confirm my power of attorney` FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE FALSE EQUALS JUST TRUE
-- Not for my benefit; contrary intention; no ground at all.
#ASSERT `Can the Supreme Court confirm my power of attorney` FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Can the Supreme Court confirm my power of attorney` FALSE FALSE FALSE TRUE FALSE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Can the Supreme Court confirm my power of attorney` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE

