IMPORT prelude
IMPORT `poa-dates`
IMPORT `poa-core`
IMPORT `poa-seat-family`

-- Powers of Attorney Act 2003 (NSW) -- worked cases for every exported question in poa-seat-family.l4 (the family
-- member, named beneficiary or interested person), with mirror cases against the principal's review question.
-- Every expected value was worked by hand from the deposited text; none was copied from the encoding's output. Each
-- assertion is a claim about the ENCODING on stated facts, not about the law. Dates are illustrative.
-- BASELINE ENCODING. Not for public use as advice. See NOTES.md.

§ `cases -- the family member, beneficiary or interested person`

`d` MEANS `the date`

§§ `s 22 -- my interest in what is left`

-- Arguments: named by name; by description or class; enduring power; attorney dealt under it; surplus left; s 83
-- applies; s 23 order.
#ASSERT `Do I keep my interest in what is left from the attorney's dealing` TRUE FALSE TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Do I keep my interest in what is left from the attorney's dealing` FALSE TRUE TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Do I keep my interest in what is left from the attorney's dealing` FALSE FALSE TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Do I keep my interest in what is left from the attorney's dealing` TRUE FALSE TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Do I keep my interest in what is left from the attorney's dealing` TRUE FALSE FALSE TRUE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `Do I keep my interest in what is left from the attorney's dealing` TRUE FALSE TRUE FALSE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `Do I keep my interest in what is left from the attorney's dealing` TRUE FALSE TRUE TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `Do I keep my interest in what is left from the attorney's dealing` TRUE FALSE TRUE TRUE TRUE FALSE TRUE EQUALS NOTHING

§§ `s 22(2)-(4) -- real or personal estate`

#ASSERT `Is it real estate or personal estate` `surplus money or property from selling or dealing with real estate` EQUALS `real estate`
#ASSERT `Is it real estate or personal estate` `surplus money or property from selling or dealing with personal property` EQUALS `personal estate`
#ASSERT `Is it real estate or personal estate` `money for equality of partition or exchange of real estate` EQUALS `real estate`
#ASSERT `Is it real estate or personal estate` `a fine, premium or sum received on granting or renewing a lease of real estate` EQUALS `real estate`
#ASSERT `Is it real estate or personal estate` `such a sum, where the deceased was only tenant for life of the leased property` EQUALS `personal estate`

§§ `s 23(3) -- the last day`

#ASSERT `By what day must I apply to the Supreme Court under s 23` (`d` 15 1 2026) EQUALS `d` 15 7 2026
-- A short February (fork F9): 31 August plus six months.
#ASSERT `By what day must I apply to the Supreme Court under s 23` (`d` 31 8 2025) EQUALS `d` 28 2 2026
#ASSERT `By what day must I apply to the Supreme Court under s 23` (`d` 31 8 2023) EQUALS `d` 29 2 2024
-- Across a year end.
#ASSERT `By what day must I apply to the Supreme Court under s 23` (`d` 31 10 2025) EQUALS `d` 30 4 2026
#ASSERT `By what day must I apply to the Supreme Court under s 23` (`d` 20 12 2025) EQUALS `d` 20 6 2026

§§ `s 23 -- in time`

-- Arguments: named beneficiary; Court considers proper interest; grant; day I apply; extension.
#ASSERT `Is my s 23 application in time` TRUE FALSE (`d` 31 8 2025) (`d` 1 12 2025) FALSE EQUALS JUST TRUE
-- The last day, and the day after.
#ASSERT `Is my s 23 application in time` TRUE FALSE (`d` 31 8 2025) (`d` 28 2 2026) FALSE EQUALS JUST TRUE
#ASSERT `Is my s 23 application in time` TRUE FALSE (`d` 31 8 2025) (`d` 1 3 2026) FALSE EQUALS JUST FALSE
#ASSERT `Is my s 23 application in time` TRUE FALSE (`d` 15 1 2026) (`d` 15 7 2026) FALSE EQUALS JUST TRUE
#ASSERT `Is my s 23 application in time` TRUE FALSE (`d` 15 1 2026) (`d` 16 7 2026) FALSE EQUALS JUST FALSE
-- The day of the grant itself, and before it (fork F10).
#ASSERT `Is my s 23 application in time` TRUE FALSE (`d` 15 1 2026) (`d` 15 1 2026) FALSE EQUALS JUST TRUE
#ASSERT `Is my s 23 application in time` TRUE FALSE (`d` 15 1 2026) (`d` 10 1 2026) FALSE EQUALS JUST TRUE
-- Out of time but extended, even after expiry (s 23(4)(b)).
#ASSERT `Is my s 23 application in time` TRUE FALSE (`d` 15 1 2026) (`d` 1 1 2027) TRUE EQUALS JUST TRUE
-- Not a named beneficiary: only with the Court's view of a proper interest.
#ASSERT `Is my s 23 application in time` FALSE TRUE (`d` 15 1 2026) (`d` 1 3 2026) FALSE EQUALS JUST TRUE
#ASSERT `Is my s 23 application in time` FALSE FALSE (`d` 15 1 2026) (`d` 1 3 2026) FALSE EQUALS JUST FALSE

§§ `ss 4, 27, 33, 35 -- review`

`NCAT` MEANS `the Civil and Administrative Tribunal`
`SC` MEANS `the Supreme Court`
`relative or friend` MEANS `someone else, such as a relative or friend`

-- Arguments: my place; tribunal's opinion of interest; tribunal; enduring; principal cannot understand; cannot express;
-- cannot be located; applied elsewhere; withdrawn.
#ASSERT `Can I apply for a review of the power of attorney` `relative or friend` TRUE `NCAT` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Can I apply for a review of the power of attorney` `relative or friend` FALSE `NCAT` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Can I apply for a review of the power of attorney` `I am the principal's guardian` FALSE `NCAT` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Can I apply for a review of the power of attorney` `I am the principal's enduring guardian` FALSE `SC` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Can I apply for a review of the power of attorney` `I am an attorney under the power, even if my appointment was purportedly revoked` FALSE `NCAT` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- A general power, the principal incommunicate: the Supreme Court only (s 33(3)).
#ASSERT `Can I apply for a review of the power of attorney` `relative or friend` TRUE `SC` FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Can I apply for a review of the power of attorney` `relative or friend` TRUE `SC` FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Can I apply for a review of the power of attorney` `relative or friend` TRUE `NCAT` FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Can I apply for a review of the power of attorney` `relative or friend` TRUE `SC` FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- s 27(2), (3).
#ASSERT `Can I apply for a review of the power of attorney` `relative or friend` TRUE `SC` TRUE FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Can I apply for a review of the power of attorney` `relative or friend` TRUE `SC` TRUE FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE

-- Mirror cases: the same facts asked from the principal's seat and from the family seat with "I am the principal".
#ASSERT `Can I apply for a review of the power of attorney` `I am the principal` FALSE `NCAT` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS `Can I apply for a review of my power of attorney` `NCAT` TRUE FALSE FALSE FALSE FALSE FALSE
#ASSERT `Can I apply for a review of the power of attorney` `I am the principal` FALSE `NCAT` FALSE TRUE FALSE FALSE FALSE FALSE EQUALS `Can I apply for a review of my power of attorney` `NCAT` FALSE TRUE FALSE FALSE FALSE FALSE
#ASSERT `Can I apply for a review of the power of attorney` `I am the principal` FALSE `SC` FALSE FALSE TRUE FALSE FALSE FALSE EQUALS `Can I apply for a review of my power of attorney` `SC` FALSE FALSE TRUE FALSE FALSE FALSE
#ASSERT `Can I apply for a review of the power of attorney` `I am the principal` FALSE `SC` TRUE FALSE FALSE FALSE TRUE FALSE EQUALS `Can I apply for a review of my power of attorney` `SC` TRUE FALSE FALSE FALSE TRUE FALSE

§§ `s 36(3)(b) -- invalid`

#ASSERT `Can the tribunal declare the power invalid` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Can the tribunal declare the power invalid` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Can the tribunal declare the power invalid` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Can the tribunal declare the power invalid` FALSE FALSE FALSE EQUALS JUST FALSE

§§ `s 36(4) -- remove the attorney or change the power`

#ASSERT `Can the tribunal remove the attorney or change the power` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Can the tribunal remove the attorney or change the power` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Can the tribunal remove the attorney or change the power` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Can the tribunal remove the attorney or change the power` TRUE TRUE TRUE EQUALS NOTHING
