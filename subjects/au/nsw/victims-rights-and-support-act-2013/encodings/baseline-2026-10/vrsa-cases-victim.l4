IMPORT prelude
IMPORT `vrsa-seat`

-- Victims Rights and Support Act 2013 (NSW) and Victims Rights and Support Regulation 2019 -- the victim's questions.
-- Each case gives the plain answers a victim would give, in the order of the question's inputs, and the answer the
-- deposited texts give, worked by hand (the reasoning is in the comment above each assertion). The positional calls
-- are formatted from a table by the scratchpad generator au-nsw-6/gen_vrsa_seat_cases.py; no expected value was
-- taken from the encoding's output. Where the same facts are tested in vrsa-cases-core.l4, the answers agree.
-- Not the current official text; it may be out of date.

§ `Cases -- the victim's questions`

§§ `What kind of act is it`

-- an assault in a pub in Sydney: s 19(1)
#ASSERT `what kind of act is it` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS (LIST `an act of violence (s 19)`)
-- a death by dangerous driving, the driver charged: a road crime only (s 19(3A))
#ASSERT `what kind of act is it` TRUE TRUE TRUE TRUE FALSE FALSE TRUE TRUE FALSE TRUE FALSE FALSE FALSE EQUALS (LIST `a road crime (s 19AB)`)
-- a vehicle terrorist attack: a road crime and, by s 25(2B), an act of violence
#ASSERT `what kind of act is it` TRUE TRUE TRUE TRUE FALSE FALSE TRUE TRUE FALSE TRUE FALSE FALSE TRUE EQUALS (LIST `an act of violence (s 19)`, `a road crime (s 19AB)`)
-- forced labour in NSW, without a violent offence: an act of modern slavery only
#ASSERT `what kind of act is it` FALSE FALSE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS (LIST `an act of modern slavery (s 19A)`)

§§ `Am I a victim, and am I excluded`

-- injured in a pub assault: a primary victim (s 20(1))
#ASSERT `am I a victim, and am I excluded` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `no family relationship` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS (LIST (`eligible as` `a primary victim (s 23(1), s 26)`))
-- my wife was stabbed to death: a family victim (s 22(1), (3)(a))
#ASSERT `am I a victim, and am I excluded` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE `spouse` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS (LIST (`eligible as` `a family victim of an act of violence (s 23(4), s 29)`))
-- my husband was killed by a dangerous driver: a family victim of a road crime (s 22(1A))
#ASSERT `am I a victim, and am I excluded` TRUE TRUE TRUE TRUE FALSE FALSE TRUE TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE `spouse` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS (LIST (`eligible as` `a family victim of a road crime (s 23(5), s 29A)`))
-- I saw a vehicle terrorist attack and was traumatised: s 25(2B) does not reach a secondary victim (finding 6)
#ASSERT `am I a victim, and am I excluded` TRUE TRUE TRUE TRUE FALSE FALSE TRUE TRUE FALSE TRUE FALSE FALSE TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE `no family relationship` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS (LIST (`not eligible as` `a secondary victim (s 23(3), s 28)` `the act took the form of, or the injury arose from, a motor accident (s 25(2))`))
-- forced into labour and injured, made to commit offences: s 25(3)(a) does not reach an act of modern slavery (finding 5)
#ASSERT `am I a victim, and am I excluded` FALSE FALSE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `no family relationship` FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS (LIST (`eligible as` `a primary victim (s 23(1), s 26)`))
-- assaulted in prison as a convicted inmate, no special circumstances found: s 25(4)
#ASSERT `am I a victim, and am I excluded` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `no family relationship` FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS (LIST (`not eligible as` `a primary victim (s 23(1), s 26)` `a convicted inmate when the act occurred, unless the Commissioner is satisfied that special circumstances justify an exception (s 25(4), (5))`))
-- my 15-year-old was assaulted and I was traumatised on learning of it: s 21(2)
#ASSERT `am I a victim, and am I excluded` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE TRUE FALSE FALSE FALSE `no family relationship` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS (LIST (`eligible as` `a secondary victim (s 23(3), s 28)`))
-- my husband drove and died in the crash he caused: s 25(3)(b)
#ASSERT `am I a victim, and am I excluded` TRUE TRUE TRUE TRUE FALSE FALSE TRUE FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE `spouse` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS (LIST (`not eligible as` `a family victim of a road crime (s 23(5), s 29A)` `a family victim of the road crime only as a member of the alleged offender's immediate family (s 25(3)(b))`))

§§ `What support can I get`

-- primary victim: counselling, immediate needs up to $5,000 (cl 10(1)), economic loss up to $30,000 (cl 10(2)), recognition payment
#ASSERT `what support can I get` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `no family relationship` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS (LIST `approved counselling services (ss 26(1)(a), 28, 29(1)(a), 29A)`, (`financial assistance for immediate needs (s 26(1)(b)), up to` 5000), (`financial assistance for economic loss (s 26(1)(c)), up to` 30000), `a recognition payment, if one is payable for the act (s 26(1)(d))`)
-- family victim: counselling, immediate needs $5,000, funeral $9,500 in total, justice expenses $5,000 (cl 12), category A
#ASSERT `what support can I get` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE `spouse` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS (LIST `approved counselling services (ss 26(1)(a), 28, 29(1)(a), 29A)`, (`financial assistance for immediate needs (s 29(1)(b)), up to` 5000), (`funeral expenses (s 29(1)(c)), up to this total for all the family victims` 9500), (`financial assistance for justice related expenses (s 29(1)(d)), up to` 5000), `a category A recognition payment, if one is payable to the person (s 29(3))`)
-- family victim of a road crime: counselling only (s 29A)
#ASSERT `what support can I get` TRUE TRUE TRUE TRUE FALSE FALSE TRUE TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE `spouse` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS (LIST `approved counselling services (ss 26(1)(a), 28, 29(1)(a), 29A)`)
-- excluded secondary victim: nothing
#ASSERT `what support can I get` TRUE TRUE TRUE TRUE FALSE FALSE TRUE TRUE FALSE TRUE FALSE FALSE TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE `no family relationship` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS EMPTY
-- secondary victim: counselling only (s 28)
#ASSERT `what support can I get` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE TRUE FALSE FALSE FALSE `no family relationship` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS (LIST `approved counselling services (ss 26(1)(a), 28, 29(1)(a), 29A)`)

§§ `How much financial assistance`

-- Immediate needs 3,200; earnings 900 x 12 = 10,800; medical 4,000 - 1,500 = 2,500; justice 800; clothing 2,000 capped at
-- 1,500 (cl 10(3)(e)); economic loss 15,600; total 18,800.
#ASSERT (`how much can I get as a primary victim` 3200 0 TRUE 900 12 0 700 0 4000 1500 800 0 2000 0 0)'s `in total` EQUALS 18800
#ASSERT (`how much can I get as a primary victim` 3200 0 TRUE 900 12 0 700 0 4000 1500 800 0 2000 0 0)'s `for economic loss, within the maximum` EQUALS 15600
#ASSERT (`how much can I get as a primary victim` 3200 0 TRUE 900 12 0 700 0 4000 1500 800 0 2000 0 0)'s `for out-of-pocket expenses` EQUALS 0
-- Every cap: immediate needs 5,000; earnings (30,000 - 4,000) capped at 20,000; medical 9,000; justice 5,000; clothing 500;
-- 34,500 capped at 30,000 (cl 10(2)); total 35,000.
#ASSERT (`how much can I get as a primary victim` 7000 0 TRUE 1500 20 4000 0 0 9000 0 6000 0 500 0 0)'s `in total` EQUALS 35000
#ASSERT (`how much can I get as a primary victim` 7000 0 TRUE 1500 20 4000 0 0 9000 0 6000 0 500 0 0)'s `for actual loss of earnings` EQUALS 20000
-- No actual loss of earnings shown: out-of-pocket (6,500 - 500) capped at 5,000 (cl 10(3)(b)).
#ASSERT (`how much can I get as a primary victim` 0 0 FALSE 800 5 0 6500 500 0 0 0 0 0 0 0)'s `in total` EQUALS 5000
-- s 26(2): the modest claim (18,800) less 4,000 paid to my mother under s 27: 14,800.
#ASSERT (`how much can I get as a primary victim` 3200 0 TRUE 900 12 0 700 0 4000 1500 800 0 2000 0 4000)'s `in total` EQUALS 14800
-- Carer: earnings 1,100 x 8 = 8,800; the child's medical 2,400 - 400 = 2,000; justice 300; clothing 200; 11,300, less
-- 2,000 paid to the child under s 26(1)(c) (s 27(2)): 9,300.
#ASSERT (`how much can I get as a carer of a child primary victim` TRUE 1100 8 0 0 0 2400 400 300 0 200 0 2000)'s `in total` EQUALS 9300
#ASSERT (`how much can I get as a carer of a child primary victim` TRUE 1100 8 0 0 0 2400 400 300 0 200 0 2000)'s `taken off under s 26(2) or s 27(2)` EQUALS 2000
-- Family victim: immediate needs 5,000 - 1,500 (s 47 clean-up) = 3,500; funeral 9,500 - 4,000 - 2,000 = 3,500; justice
-- 7,000 - 1,000 = 6,000, capped at 5,000; in all 12,000.
#ASSERT (`how much can I get as a family victim` 6000 0 1500 8000 4000 2000 7000 1000)'s `in all` EQUALS 12000
#ASSERT (`how much can I get as a family victim` 6000 0 1500 8000 4000 2000 7000 1000)'s `for the funeral` EQUALS 3500
-- One family victim, a funeral of 12,000: capped at 9,500 (cl 12(2)).
#ASSERT (`how much can I get as a family victim` 0 0 0 12000 0 0 0 0)'s `for the funeral` EQUALS 9500
-- s 47: a friend paid an 11,000 funeral and 7,000 of clean-up; the family has had 6,000 for the funeral: 3,500 and 5,000.
#ASSERT `how much can I be reimbursed for the funeral or the clean-up` FALSE 11000 7000 6000 EQUALS `up to these amounts, as far as the Commissioner considers them fair and reasonable (s 47(3))` 3500 5000
#ASSERT `how much can I be reimbursed for the funeral or the clean-up` TRUE 11000 7000 0 EQUALS `s 47 does not apply: a family victim claims these expenses under s 29`
-- Reg cl 9: not covered (finding 9).
#ASSERT `what is my cl 9 weekly rate` TRUE EQUALS `not covered` `the cl 9 rate: s 37 of the Workers Compensation Act 1987 as in force before the 2012 amendments, and its indexed amounts, are not deposited`
#ASSERT `what is my cl 9 weekly rate` FALSE EQUALS `cl 9 does not arise: no actual loss of earnings is demonstrated, so out-of-pocket expenses are assessed instead (cl 10(3)(b), 11(2)(b))`

§§ `My recognition payment`

-- a sexual assault with a weapon: B (s 35(2)(a)) and C (s 35(3)(a)) (finding 12)
#ASSERT `which recognition categories describe the act` FALSE TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS (LIST `category B (s 35(2))`, `category C (s 35(3))`)
-- physical assaults of a child in a series: C (s 35(3)(d)) and D (s 35(4)(d))
#ASSERT `which recognition categories describe the act` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE TRUE EQUALS (LIST `category C (s 35(3))`, `category D (s 35(4))`)
-- a homicide: A
#ASSERT `which recognition categories describe the act` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS (LIST `category A (s 35(1))`)
-- my husband, on whom I depended, was murdered: category A, s 36(1)(a), $15,000 (cl 14(a))
#ASSERT `which recognition payment do I get` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `spouse` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS (LIST (`a recognition payment` `category A (s 35(1))` 15000))
-- my father was murdered; I am 30 and was not dependent: none (finding 14)
#ASSERT `which recognition payment do I get` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `child` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS (LIST (`no recognition payment` `the act is category A, which s 36(1)(a) and (b) pay only to listed members of the family of the primary victim who died`))
-- my mother was murdered; I am 12: category A, s 36(1)(a)(ii), $15,000
#ASSERT `which recognition payment do I get` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `child` FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS (LIST (`a recognition payment` `category A (s 35(1))` 15000))
-- my son was murdered; I was not dependent on him: category A, s 36(1)(b)(i), $7,500 (cl 14(b))
#ASSERT `which recognition payment do I get` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `parent, guardian or step-parent` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS (LIST (`a recognition payment` `category A (s 35(1))` 7500))
-- my brother was murdered; I was not dependent: none
#ASSERT `which recognition payment do I get` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `brother, sister, half-brother, half-sister, step-brother or step-sister` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS (LIST (`no recognition payment` `the act is category A, which s 36(1)(a) and (b) pay only to listed members of the family of the primary victim who died`))
-- I was sexually assaulted at knifepoint: B, $10,000 (cl 14(c))
#ASSERT `which recognition payment do I get` FALSE TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE `no family relationship` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS (LIST (`a recognition payment` `category B (s 35(2))` 10000))
-- I was assaulted again by the same man, already paid for the series: none (s 36(2))
#ASSERT `which recognition payment do I get` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE TRUE TRUE FALSE `no family relationship` FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS (LIST (`no recognition payment` `only one recognition payment is payable for a series of related acts against the victim (s 36(2))`))
-- I was assaulted and have asked the Tribunal to review the decision: D, $1,500, suspended (s 53)
#ASSERT `which recognition payment do I get` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE TRUE FALSE `no family relationship` FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS (LIST (`a recognition payment, suspended pending the Tribunal's review (s 53)` `category D (s 35(4))` 1500))
-- I was injured trying to stop a violent robbery: a primary victim (s 20(2)); D, $1,500
#ASSERT `which recognition payment do I get` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE TRUE `no family relationship` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS (LIST (`a recognition payment` `category D (s 35(4))` 1500))
-- my husband was beaten to death in front of me and I was injured; not dependent: A $7,500 and D $1,500 (finding 13)
#ASSERT `which recognition payment do I get` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE TRUE FALSE `spouse` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS (LIST (`a recognition payment` `category A (s 35(1))` 7500), (`a recognition payment` `category D (s 35(4))` 1500))

§§ `My counselling`

-- A primary victim with 10 hours already: 22 - 10 = 12 more (cl 5(2)).
#ASSERT `how much counselling is paid for` `a primary or secondary victim` FALSE FALSE 0 FALSE 10 EQUALS `up to this many more hours, and further periods if the Commissioner considers it appropriate; more than 22 hours in all only for exceptional reasons (cl 5(2), (4))` 12
-- Counselling abroad at $256 an hour: the lesser of 22 hours ($5,632) and $5,500: $5,500, 5,500 / 256 hours (cl 5(5)).
#ASSERT `how much counselling is paid for` `a primary or secondary victim` FALSE TRUE 256 FALSE 0 EQUALS `outside Australia, up to this many more hours, and no more than this many more dollars (cl 5(5))` (5500 DIVIDED BY 256) 5500
-- Not yet known to be a victim: an initial 2 hours (cl 5(3)).
#ASSERT `how much counselling is paid for` `none of these` TRUE FALSE 0 FALSE 0 EQUALS `an initial 2 hours of counselling, while the Commissioner establishes whether the person is a victim (cl 5(3))`
-- Abused as a child: ongoing counselling (cl 7).
#ASSERT `how much counselling is paid for` `a primary or secondary victim` FALSE FALSE 0 TRUE 40 EQUALS `counselling on an ongoing basis, if the Commissioner authorises it (cl 7)`
-- A tier 2 counsellor, 6 hours plus a 3-hour trip: 9 x $144 = $1,296; GST $129.60 (within 10%); $50 costs: $1,475.60 (cl 8).
#ASSERT `how much is paid for my counselling` `a generalist counsellor tier 2` 6 3 129.6 50 TRUE EQUALS `the payment for the counselling is` 1475.6
-- A psychiatrist, 2 hours, a 2-hour trip (does not count): $512; GST $80 capped at $51.20: $563.20.
#ASSERT `how much is paid for my counselling` `a psychiatrist` 2 2 80 0 TRUE EQUALS `the payment for the counselling is` 563.2
-- Living abroad: cl 5(10), not the cl 8 scale.
#ASSERT `how much is paid for my counselling` `a generalist counsellor tier 1` 10 0 0 0 FALSE EQUALS `paid on an invoice, statement or other document, in the manner the Commissioner approves (cl 5(10)): the cl 8 scale is for victims resident in Australia`

§§ `Making my application`

-- s 38(1)(c): another person with a genuine interest may apply on a victim's behalf; nobody else may.
#ASSERT `may I make an application` `another person with a genuine interest in the victim's welfare, applying on the victim's behalf`
#ASSERT NOT (`may I make an application` `none of these`)
-- Lost earnings without the employer's statement (s 39(4)(b)).
#ASSERT `what evidence is missing` `financial assistance for actual loss of earnings` `a primary victim (s 23(1), s 26)` TRUE FALSE TRUE FALSE FALSE EQUALS LIST `the employer's name and address, the period of absence from work and the employer's statement (s 39(4)(b))`
-- A family victim's recognition payment with a police report but no report of the applicant's own injury (finding 18).
#ASSERT `what evidence is missing` `a recognition payment` `a family victim of an act of violence (s 23(4), s 29)` TRUE FALSE FALSE FALSE FALSE EQUALS LIST `a medical, dental or counselling report verifying the injury (s 39(2)(b)(ii))`
-- Everything there for immediate needs: nothing missing.
#ASSERT `what evidence is missing` `financial assistance for immediate needs` `a primary victim (s 23(1), s 26)` TRUE FALSE FALSE TRUE FALSE EQUALS EMPTY
-- An adult, immediate needs, assaulted 10 March 2023: by 10 March 2025 (s 40(1)).
#ASSERT `by when must I apply` `financial assistance for immediate needs` (DATE_FROM_DMY 1 1 1990) (DATE_FROM_DMY 10 3 2023) FALSE (DATE_FROM_DMY 1 1 2000) FALSE FALSE EQUALS (`apply on or before` (DATE_FROM_DMY 10 3 2025) `s 40(1): 2 years after the act`)
-- Abused at 9 (born 15 June 2010, act 1 February 2020) in the course of a sexual offence; a recognition payment: no limit (s 40(7)).
#ASSERT `by when must I apply` `a recognition payment` (DATE_FROM_DMY 15 6 2010) (DATE_FROM_DMY 1 2 2020) FALSE (DATE_FROM_DMY 1 1 2000) TRUE TRUE EQUALS `no time limit: s 40(7), for a child victim of a sexual offence`
-- The same child, immediate needs: 2 years after turning 18 on 15 June 2028: 15 June 2030.
#ASSERT `by when must I apply` `financial assistance for immediate needs` (DATE_FROM_DMY 15 6 2010) (DATE_FROM_DMY 1 2 2020) FALSE (DATE_FROM_DMY 1 1 2000) TRUE TRUE EQUALS (`apply on or before` (DATE_FROM_DMY 15 6 2030) `s 40(1): 2 years after the victim turns 18`)
-- My brother died on 1 July 2019; it was established on 1 September 2024 that the assault caused it; funeral expenses: 1 September 2026 (s 40(3)).
#ASSERT `by when must I apply` `funeral expenses` (DATE_FROM_DMY 1 1 1970) (DATE_FROM_DMY 1 7 2019) TRUE (DATE_FROM_DMY 1 9 2024) FALSE FALSE EQUALS (`apply on or before` (DATE_FROM_DMY 1 9 2026) `s 40(3): 2 years after it was established that the primary victim died as a direct result of the act`)
-- Counselling: no time limit (finding 19).
#ASSERT `by when must I apply` `approved counselling services` (DATE_FROM_DMY 1 1 1990) (DATE_FROM_DMY 10 3 2010) FALSE (DATE_FROM_DMY 1 1 2000) FALSE FALSE EQUALS `no time limit: s 40 applies only to applications for financial support or a recognition payment`
-- In time on 10 March 2025; out of time on 11 March 2025.
#ASSERT `is my application in time` (DATE_FROM_DMY 10 3 2025) `financial assistance for immediate needs` (DATE_FROM_DMY 1 1 1990) (DATE_FROM_DMY 10 3 2023) FALSE (DATE_FROM_DMY 1 1 2000) FALSE FALSE
#ASSERT NOT (`is my application in time` (DATE_FROM_DMY 11 3 2025) `financial assistance for immediate needs` (DATE_FROM_DMY 1 1 1990) (DATE_FROM_DMY 10 3 2023) FALSE (DATE_FROM_DMY 1 1 2000) FALSE FALSE)
-- A recognition payment for domestic violence, assaulted 10 March 2023: in time on 1 March 2033 (s 40(5)).
#ASSERT `is my application in time` (DATE_FROM_DMY 1 3 2033) `a recognition payment` (DATE_FROM_DMY 1 1 1990) (DATE_FROM_DMY 10 3 2023) FALSE (DATE_FROM_DMY 1 1 2000) TRUE FALSE
-- s 40(6): applied 1 July 2023; a claim on 1 July 2028 is the last day; on 2 July 2028 too late; once the maximum is given, none.
#ASSERT `can I still make claims` (DATE_FROM_DMY 1 7 2023) (DATE_FROM_DMY 1 7 2028) FALSE EQUALS `claims may be made under the application up to and including` (DATE_FROM_DMY 1 7 2028)
#ASSERT `can I still make claims` (DATE_FROM_DMY 1 7 2023) (DATE_FROM_DMY 2 7 2028) FALSE EQUALS `no further claims: 5 years have passed since the application was made (s 40(6)(a))`
#ASSERT `can I still make claims` (DATE_FROM_DMY 1 7 2023) (DATE_FROM_DMY 1 1 2025) TRUE EQUALS `no further claims: the total maximum amount of financial support has been given (s 40(6)(b))`
