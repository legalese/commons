§§ `s 27, Reg cl 11 -- a carer's financial assistance`

`claim: carer, earner` MEANS
    `Carer claim` WITH
        `can demonstrate actual loss of earnings`                                IS TRUE
        `weekly rate of actual loss of earnings under cl 9`                      IS 1100
        `weeks of actual loss of earnings`                                       IS 8
        `lost earnings paid or payable from another source`                      IS 0
        `out-of-pocket expenses`                                                 IS (`Expense` WITH `amount` IS 0, `paid or payable from another source` IS 0)
        `the child's medical and dental expenses not claimed as immediate needs` IS (`Expense` WITH `amount` IS 2400, `paid or payable from another source` IS 400)
        `justice related expenses`                                               IS (`Expense` WITH `amount` IS 300, `paid or payable from another source` IS 0)
        `the child's clothing and personal effects`                              IS (`Expense` WITH `amount` IS 200, `paid or payable from another source` IS 0)
        `paid or approved to the child under s 26(1)(c)`                         IS 0

-- earnings 1,100 x 8 = 8,800; the child's medical 2,400 - 400 = 2,000; justice 300; clothing 200; 11,300 (under $30,000); nothing paid to the child
#ASSERT (`the s 27 financial assistance for` `claim: carer, earner`)'s `for immediate needs` EQUALS 0
#ASSERT (`the s 27 financial assistance for` `claim: carer, earner`)'s `for actual loss of earnings` EQUALS 8800
#ASSERT (`the s 27 financial assistance for` `claim: carer, earner`)'s `for out-of-pocket expenses` EQUALS 0
#ASSERT (`the s 27 financial assistance for` `claim: carer, earner`)'s `for medical and dental expenses` EQUALS 2000
#ASSERT (`the s 27 financial assistance for` `claim: carer, earner`)'s `for justice related expenses` EQUALS 300
#ASSERT (`the s 27 financial assistance for` `claim: carer, earner`)'s `for clothing and personal effects` EQUALS 200
#ASSERT (`the s 27 financial assistance for` `claim: carer, earner`)'s `for economic loss, within the maximum` EQUALS 11300
#ASSERT (`the s 27 financial assistance for` `claim: carer, earner`)'s `taken off under s 26(2) or s 27(2)` EQUALS 0
#ASSERT (`the s 27 financial assistance for` `claim: carer, earner`)'s `in total` EQUALS 11300

`claim: carer, child paid 2,000` MEANS
    `Carer claim` WITH
        `can demonstrate actual loss of earnings`                                IS TRUE
        `weekly rate of actual loss of earnings under cl 9`                      IS 1100
        `weeks of actual loss of earnings`                                       IS 8
        `lost earnings paid or payable from another source`                      IS 0
        `out-of-pocket expenses`                                                 IS (`Expense` WITH `amount` IS 0, `paid or payable from another source` IS 0)
        `the child's medical and dental expenses not claimed as immediate needs` IS (`Expense` WITH `amount` IS 2400, `paid or payable from another source` IS 400)
        `justice related expenses`                                               IS (`Expense` WITH `amount` IS 300, `paid or payable from another source` IS 0)
        `the child's clothing and personal effects`                              IS (`Expense` WITH `amount` IS 200, `paid or payable from another source` IS 0)
        `paid or approved to the child under s 26(1)(c)`                         IS 2000

-- 11,300 less the 2,000 paid to the child under s 26(1)(c) (s 27(2)): 9,300
#ASSERT (`the s 27 financial assistance for` `claim: carer, child paid 2,000`)'s `for immediate needs` EQUALS 0
