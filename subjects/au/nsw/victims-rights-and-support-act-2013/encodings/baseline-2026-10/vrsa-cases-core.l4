§§ `s 47, Reg cl 13 -- a person who is not a family victim`

`claim: s 47, a friend paid the funeral and clean-up` MEANS
    `Section 47 claim` WITH
        `is eligible for immediate needs or funeral expenses under s 29 as a family victim` IS FALSE
        `funeral expenses of the primary victim incurred`                                   IS 11000
        `clean-up expenses incurred`                                                        IS 1800
        `funeral expenses already granted to the family victims`                            IS 0

-- funeral 11,000 capped at cl 13(b) 9,500; clean-up 1,800 (under cl 13(a) 5,000)
#ASSERT `the s 47 reimbursement for` `claim: s 47, a friend paid the funeral and clean-up` EQUALS (`up to these amounts, as far as the Commissioner considers them fair and reasonable (s 47(3))` 9500 1800)

`claim: s 47, family already granted 6,000` MEANS
    `Section 47 claim` WITH
        `is eligible for immediate needs or funeral expenses under s 29 as a family victim` IS FALSE
        `funeral expenses of the primary victim incurred`                                   IS 11000
        `clean-up expenses incurred`                                                        IS 7000
        `funeral expenses already granted to the family victims`                            IS 6000

-- funeral: 9,500 - 6,000 already granted to the family victims = 3,500 (READING, finding 11); clean-up 7,000 capped at 5,000
#ASSERT `the s 47 reimbursement for` `claim: s 47, family already granted 6,000` EQUALS (`up to these amounts, as far as the Commissioner considers them fair and reasonable (s 47(3))` 3500 5000)

`claim: s 47, a family victim` MEANS
    `Section 47 claim` WITH
        `is eligible for immediate needs or funeral expenses under s 29 as a family victim` IS TRUE
        `funeral expenses of the primary victim incurred`                                   IS 11000
        `clean-up expenses incurred`                                                        IS 1800
        `funeral expenses already granted to the family victims`                            IS 0

-- s 47(1): only for a person not eligible under s 29 as a family victim
#ASSERT `the s 47 reimbursement for` `claim: s 47, a family victim` EQUALS `s 47 does not apply: a family victim claims these expenses under s 29`

§§ `s 35 -- recognition payment categories`

`facts: a homicide` MEANS
    `Recognition facts` WITH
        `apparently occurred in the course of the commission of a homicide` IS TRUE
        `involved a sexual assault`                                         IS FALSE
        `the sexual assault resulted in serious bodily injury`              IS FALSE
        `the sexual assault involved an offensive weapon`                   IS FALSE
        `the sexual assault was carried out by 2 or more persons`           IS FALSE
        `involved sexual touching or a sexual act`                          IS FALSE
        `involved an attempted sexual assault`                              IS FALSE
        `the attempted sexual assault involved violence`                    IS FALSE
        `the attempted sexual assault resulted in serious bodily injury`    IS FALSE
        `involved an assault`                                               IS FALSE
        `the assault resulted in grievous bodily harm`                      IS FALSE
        `involved physical assault of a child`                              IS FALSE
        `involved a robbery involving violence`                             IS FALSE
        `is one of a series of related acts`                                IS FALSE

