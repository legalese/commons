`counselling: abroad at $256 an hour` MEANS
    `Counselling facts` WITH
        `counselling class`                                                       IS `a primary or secondary victim`
        `whether the person is a victim is still being established`               IS FALSE
        `the counselling is provided outside Australia`                           IS TRUE
        `the counsellor's hourly fee outside Australia`                           IS 256
        `is, or was while under 18, a victim of sexual assault or physical abuse` IS FALSE
        `hours of counselling already paid for the act`                           IS 0

-- 22 x 256 = 5,632; the lesser is $5,500; 5,500 / 256 = 21.484375 hours
#ASSERT `the counselling hours for` `counselling: abroad at $256 an hour` EQUALS (`outside Australia, up to this many more hours, and no more than this many more dollars (cl 5(5))` (5500 DIVIDED BY 256) 5500)

`counselling: abroad at $200 an hour, 5 hours used` MEANS
    `Counselling facts` WITH
        `counselling class`                                                       IS `a primary or secondary victim`
        `whether the person is a victim is still being established`               IS FALSE
        `the counselling is provided outside Australia`                           IS TRUE
        `the counsellor's hourly fee outside Australia`                           IS 200
        `is, or was while under 18, a victim of sexual assault or physical abuse` IS FALSE
        `hours of counselling already paid for the act`                           IS 5

-- 22 x 200 = 4,400 (under $5,500); less 5 x 200 = 1,000 used: 3,400, which is 17 hours
#ASSERT `the counselling hours for` `counselling: abroad at $200 an hour, 5 hours used` EQUALS (`outside Australia, up to this many more hours, and no more than this many more dollars (cl 5(5))` 17 3400)

`counselling: abroad at $300 an hour, 10 hours used` MEANS
    `Counselling facts` WITH
        `counselling class`                                                       IS `a primary or secondary victim`
        `whether the person is a victim is still being established`               IS FALSE
        `the counselling is provided outside Australia`                           IS TRUE
        `the counsellor's hourly fee outside Australia`                           IS 300
        `is, or was while under 18, a victim of sexual assault or physical abuse` IS FALSE
        `hours of counselling already paid for the act`                           IS 10

-- 22 x 300 = 6,600, so $5,500; less 3,000 used: 2,500, which is 8 1/3 hours
#ASSERT `the counselling hours for` `counselling: abroad at $300 an hour, 10 hours used` EQUALS (`outside Australia, up to this many more hours, and no more than this many more dollars (cl 5(5))` (2500 DIVIDED BY 300) 2500)

`counselling: a family victim abroad at $150 an hour` MEANS
    `Counselling facts` WITH
        `counselling class`                                                       IS `a family victim`
        `whether the person is a victim is still being established`               IS FALSE
        `the counselling is provided outside Australia`                           IS TRUE
        `the counsellor's hourly fee outside Australia`                           IS 150
        `is, or was while under 18, a victim of sexual assault or physical abuse` IS FALSE
        `hours of counselling already paid for the act`                           IS 0

-- cl 5(5) reaches every victim abroad: 22 x 150 = 3,300 (under $5,500)
#ASSERT `the counselling hours for` `counselling: a family victim abroad at $150 an hour` EQUALS (`outside Australia, up to this many more hours, and no more than this many more dollars (cl 5(5))` 22 3300)

§§ `s 33, Reg cl 8 -- counselling payments`

`sessions: tier 1, 10 hours` MEANS
    `Counselling services` WITH
        `the counsellor`                                      IS `a generalist counsellor tier 1`
        `hours of counselling`                                IS 10
        `hours of the counsellor's travel period`             IS 0
        `GST payable`                                         IS 0
        `costs the Commissioner determines to be appropriate` IS 0
        `the victim is resident in Australia`                 IS TRUE

-- 10 x $120 = $1,200
#ASSERT `the cl 8 payment for` `sessions: tier 1, 10 hours` EQUALS (`the payment for the counselling is` 1200)

`sessions: tier 2, 6 hours, 3 hours' travel` MEANS
    `Counselling services` WITH
        `the counsellor`                                      IS `a generalist counsellor tier 2`
        `hours of counselling`                                IS 6
        `hours of the counsellor's travel period`             IS 3
        `GST payable`                                         IS 129.6
        `costs the Commissioner determines to be appropriate` IS 50
        `the victim is resident in Australia`                 IS TRUE

-- travel over 2 hours counts: (6 + 3) x $144 = $1,296; GST $129.60 is within 10% ($129.60); plus $50 costs: $1,475.60
#ASSERT `the cl 8 payment for` `sessions: tier 2, 6 hours, 3 hours' travel` EQUALS (`the payment for the counselling is` 1475.6)

`sessions: psychiatrist, 2 hours, 2 hours' travel` MEANS
    `Counselling services` WITH
        `the counsellor`                                      IS `a psychiatrist`
        `hours of counselling`                                IS 2
        `hours of the counsellor's travel period`             IS 2
        `GST payable`                                         IS 80
        `costs the Commissioner determines to be appropriate` IS 0
        `the victim is resident in Australia`                 IS TRUE

-- travel of 2 hours does not count: 2 x $256 = $512; GST capped at 10%, $51.20: $563.20
#ASSERT `the cl 8 payment for` `sessions: psychiatrist, 2 hours, 2 hours' travel` EQUALS (`the payment for the counselling is` 563.2)

`sessions: tier 1, 1 hour, 2.5 hours' travel` MEANS
    `Counselling services` WITH
        `the counsellor`                                      IS `a generalist counsellor tier 1`
        `hours of counselling`                                IS 1
        `hours of the counsellor's travel period`             IS 2.5
        `GST payable`                                         IS 42
        `costs the Commissioner determines to be appropriate` IS 0
        `the victim is resident in Australia`                 IS TRUE

-- (1 + 2.5) x $120 = $420; GST $42 (10%): $462
#ASSERT `the cl 8 payment for` `sessions: tier 1, 1 hour, 2.5 hours' travel` EQUALS (`the payment for the counselling is` 462)

`sessions: tier 1, victim resident abroad` MEANS
    `Counselling services` WITH
        `the counsellor`                                      IS `a generalist counsellor tier 1`
        `hours of counselling`                                IS 10
        `hours of the counsellor's travel period`             IS 0
        `GST payable`                                         IS 0
        `costs the Commissioner determines to be appropriate` IS 0
        `the victim is resident in Australia`                 IS FALSE

-- cl 8(1) is for victims resident in Australia
#ASSERT `the cl 8 payment for` `sessions: tier 1, victim resident abroad` EQUALS `paid on an invoice, statement or other document, in the manner the Commissioner approves (cl 5(10)): the cl 8 scale is for victims resident in Australia`

-- The parts: hours counted and the scale amount.
#ASSERT `the hours counted under cl 8` `sessions: tier 2, 6 hours, 3 hours' travel` EQUALS 9
#ASSERT `the hours counted under cl 8` `sessions: psychiatrist, 2 hours, 2 hours' travel` EQUALS 2
#ASSERT `the cl 8(1)(a) scale amount for` `sessions: tier 2, 6 hours, 3 hours' travel` EQUALS 1296

