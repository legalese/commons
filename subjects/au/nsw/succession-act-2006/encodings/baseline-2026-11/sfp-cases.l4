#ASSERT `Does my release of my right to apply have effect` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Does my release of my right to apply have effect` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Does my release of my right to apply have effect` TRUE TRUE TRUE EQUALS JUST FALSE

