#ASSERT `Can the approval of my release be revoked` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Can the approval of my release be revoked` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Can the approval of my release be revoked` FALSE FALSE FALSE EQUALS JUST FALSE

§§ `s 70 -- Can an existing order be varied to provide for me`

#ASSERT `Can an existing order be varied to provide for me` TRUE EQUALS JUST TRUE
#ASSERT `Can an existing order be varied to provide for me` FALSE EQUALS JUST FALSE

§§ `ss 78(2), 99 -- Can my costs be paid out of the estate or notional estate`

#ASSERT `Can my costs be paid out of the estate or notional estate` `the estate` FALSE EQUALS JUST TRUE
#ASSERT `Can my costs be paid out of the estate or notional estate` `the notional estate` FALSE EQUALS JUST FALSE
#ASSERT `Can my costs be paid out of the estate or notional estate` `the notional estate` TRUE EQUALS JUST TRUE

§§ `s 72 -- How does an order for me take effect`

#ASSERT `How does an order for me take effect` TRUE FALSE EQUALS `as if the provision were made in a codicil to their will`
#ASSERT `How does an order for me take effect` FALSE FALSE EQUALS `as if the provision were made in a will of theirs`
#ASSERT `How does an order for me take effect` TRUE TRUE EQUALS `as the Court orders`
