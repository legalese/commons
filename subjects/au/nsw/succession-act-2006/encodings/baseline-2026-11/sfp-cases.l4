-- Arguments as above, without "commenced".
#ASSERT `Must the Court find factors warranting my application` TRUE FALSE `nc` `no rel` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Must the Court find factors warranting my application` FALSE FALSE `ch` `no rel` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
