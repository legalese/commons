IMPORT prelude
IMPORT `mac-dates`
IMPORT `mac-claims`

-- Motor Accidents Compensation Act 1999 (NSW) -- worked cases for every exported question in mac-claims.l4.
-- Every expected value was worked by hand from the deposited text; none was copied from the encoding's output. Each
-- assertion is a claim about the ENCODING on stated facts, not about the law. Dates and amounts are illustrative.
-- BASELINE ENCODING. Not for public use as advice. See NOTES.md.

§ `cases`

`d` MEANS `the date`

`owner or driver` MEANS `the owner or driver of a vehicle involved`
`blameless` MEANS `no one: a blameless accident`
`someone else` MEANS `only someone who is not an owner or driver of a vehicle involved, or only me`

`div 2` MEANS `no owner or driver was at fault, and the accident was not blameless (Division 2)`
`div 1` MEANS `the accident was blameless (Division 1)`
`driver at fault` MEANS `the owner or driver of a vehicle was at fault`

`uninsured` MEANS `it was not an insured motor vehicle`
`unidentified` MEANS `its identity cannot be established`
`insured` MEANS `it was an insured motor vehicle`

`late` MEANS `the claim was made late (s 73)`
`no police report` MEANS `the accident was not reported to police within 28 days (s 70)`
`bad form` MEANS `the notice of claim did not comply with s 74`
`no search` MEANS `no due inquiry and search was made to identify the vehicle (s 34A)`

`nothing done` MEANS `nothing`
`rejected` MEANS `it rejected the claim on that ground`
`asked` MEANS `it asked me for an explanation or to make due inquiry and search`

`any day` MEANS `d` 1 1 2000

§§ `ss 3AA, 3A, 3B -- does the scheme cover my claim`

-- Arguments: after 1999 commencement; after 2017 commencement; who was at fault; during driving etc.; gradual; cover; work injury.
#ASSERT `Does the 1999 scheme cover my claim` TRUE FALSE `owner or driver` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Does the 1999 scheme cover my claim` TRUE TRUE `owner or driver` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Does the 1999 scheme cover my claim` FALSE FALSE `owner or driver` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Does the 1999 scheme cover my claim` TRUE FALSE `owner or driver` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Does the 1999 scheme cover my claim` TRUE FALSE `owner or driver` FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Does the 1999 scheme cover my claim` TRUE FALSE `owner or driver` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- A work injury claim brings in Chapters 3-6 without cover (s 3B(1)(b)).
#ASSERT `Does the 1999 scheme cover my claim` TRUE FALSE `owner or driver` TRUE FALSE FALSE TRUE EQUALS JUST TRUE
-- No owner or driver at fault: Part 1.2 may deem fault (fork F3).
#ASSERT `Does the 1999 scheme cover my claim` TRUE FALSE `blameless` TRUE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `Does the 1999 scheme cover my claim` TRUE FALSE `someone else` TRUE FALSE TRUE FALSE EQUALS NOTHING

§§ `ss 7A-7E -- blameless accidents`

-- Arguments: after 2017; in NSW after Part 1.2; during driving etc.; no one at fault; cover; I was a driver whose act caused it.
#ASSERT `Can I claim for a blameless accident` FALSE TRUE TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Can I claim for a blameless accident` TRUE TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Can I claim for a blameless accident` FALSE FALSE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Can I claim for a blameless accident` FALSE TRUE FALSE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Can I claim for a blameless accident` FALSE TRUE TRUE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Can I claim for a blameless accident` FALSE TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
-- s 7E: a driver whose act or omission (even involuntary) caused it cannot recover under the Division.
#ASSERT `Can I claim for a blameless accident` FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE

§§ `ss 7J, 7K, 7P -- children`

-- Arguments: after 2017; in NSW after Part 1.2; under 16; resident; during driving etc.; how the case stands; cover; serious offence.
#ASSERT `Does my child have the special entitlement` FALSE TRUE TRUE TRUE TRUE `div 2` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Does my child have the special entitlement` TRUE TRUE TRUE TRUE TRUE `div 2` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Does my child have the special entitlement` FALSE FALSE TRUE TRUE TRUE `div 2` TRUE FALSE EQUALS JUST FALSE
-- 16 or over at the time: not a "child" (s 7J(6)).
#ASSERT `Does my child have the special entitlement` FALSE TRUE FALSE TRUE TRUE `div 2` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Does my child have the special entitlement` FALSE TRUE TRUE FALSE TRUE `div 2` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Does my child have the special entitlement` FALSE TRUE TRUE TRUE FALSE `div 2` TRUE FALSE EQUALS JUST FALSE
-- Blameless: Division 1 applies instead (s 7P(1)); owner or driver at fault: an ordinary claim (s 7J(1)).
#ASSERT `Does my child have the special entitlement` FALSE TRUE TRUE TRUE TRUE `div 1` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Does my child have the special entitlement` FALSE TRUE TRUE TRUE TRUE `driver at fault` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Does my child have the special entitlement` FALSE TRUE TRUE TRUE TRUE `div 2` FALSE FALSE EQUALS JUST FALSE
#ASSERT `Does my child have the special entitlement` FALSE TRUE TRUE TRUE TRUE `div 2` TRUE TRUE EQUALS JUST FALSE

#ASSERT `Does the special entitlement cover this expense` `hospital, medical and pharmaceutical expenses` EQUALS JUST TRUE
#ASSERT `Does the special entitlement cover this expense` `rehabilitation expenses` EQUALS JUST TRUE
#ASSERT `Does the special entitlement cover this expense` `respite care expenses` EQUALS JUST TRUE
#ASSERT `Does the special entitlement cover this expense` `attendant care services expenses` EQUALS JUST TRUE
#ASSERT `Does the special entitlement cover this expense` `funeral or cremation expenses` EQUALS JUST TRUE
#ASSERT `Does the special entitlement cover this expense` `another kind of loss` EQUALS JUST FALSE

-- Arguments: how the case stands; the kind of damages; otherwise meets the conditions.
#ASSERT `Can my child's damages be reduced for contributory negligence` `div 2` `hospital, medical and pharmaceutical expenses` TRUE EQUALS JUST FALSE
#ASSERT `Can my child's damages be reduced for contributory negligence` `div 2` `another kind of loss` TRUE EQUALS NOTHING
#ASSERT `Can my child's damages be reduced for contributory negligence` `div 1` `hospital, medical and pharmaceutical expenses` TRUE EQUALS JUST FALSE
#ASSERT `Can my child's damages be reduced for contributory negligence` `div 1` `hospital, medical and pharmaceutical expenses` FALSE EQUALS JUST TRUE
#ASSERT `Can my child's damages be reduced for contributory negligence` `div 1` `another kind of loss` TRUE EQUALS JUST TRUE
#ASSERT `Can my child's damages be reduced for contributory negligence` `driver at fault` `attendant care services expenses` TRUE EQUALS JUST FALSE
#ASSERT `Can my child's damages be reduced for contributory negligence` `driver at fault` `attendant care services expenses` FALSE EQUALS JUST TRUE
#ASSERT `Can my child's damages be reduced for contributory negligence` `driver at fault` `another kind of loss` TRUE EQUALS JUST TRUE

