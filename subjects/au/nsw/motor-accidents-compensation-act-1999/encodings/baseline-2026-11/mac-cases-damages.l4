IMPORT prelude
IMPORT `mac-damages`

-- Motor Accidents Compensation Act 1999 (NSW) -- worked cases for every exported question in mac-damages.l4.
-- Every expected value was worked by hand from the deposited text; none was copied from the encoding's output. Each
-- assertion is a claim about the ENCODING on stated facts, not about the law. Amounts are illustrative; the indexed
-- amounts used are not the declared ones.
-- BASELINE ENCODING. Not for public use as advice. See NOTES.md.

§ `cases`

§§ `ss 131-134 -- non-economic loss`

-- Arguments: degree of permanent impairment (%); threshold disputed; assessed by a medical assessor.
#ASSERT `Can I be awarded damages for non-economic loss` 11 FALSE FALSE EQUALS JUST TRUE
-- Exactly 10% is not "greater than 10%".
#ASSERT `Can I be awarded damages for non-economic loss` 10 FALSE FALSE EQUALS JUST FALSE
#ASSERT `Can I be awarded damages for non-economic loss` 0 FALSE FALSE EQUALS JUST FALSE
#ASSERT `Can I be awarded damages for non-economic loss` 11 TRUE FALSE EQUALS JUST FALSE
#ASSERT `Can I be awarded damages for non-economic loss` 11 TRUE TRUE EQUALS JUST TRUE
#ASSERT `Can I be awarded damages for non-economic loss` 10 TRUE TRUE EQUALS JUST FALSE

-- Arguments: as above, then the maximum at the date of the award.
#ASSERT `What is the most I can get for non-economic loss` 11 FALSE FALSE 284000 EQUALS 284000
#ASSERT `What is the most I can get for non-economic loss` 10 FALSE FALSE 284000 EQUALS 0
#ASSERT `What is the most I can get for non-economic loss` 40 FALSE FALSE 500000 EQUALS 500000
#ASSERT `What is the most I can get for non-economic loss` 40 TRUE FALSE 500000 EQUALS 0

§§ `ss 125, 127, 130 -- economic loss`

-- Arguments: net weekly earnings but for the accident; the weekly maximum.
#ASSERT `What weekly earnings are counted` 3000 2500 EQUALS 2500
#ASSERT `What weekly earnings are counted` 2000 2500 EQUALS 2000
#ASSERT `What weekly earnings are counted` 2500 2500 EQUALS 2500
#ASSERT `What weekly earnings are counted` 2501 2500 EQUALS 2500

-- Arguments: a percentage is prescribed; the percentage.
#ASSERT `What discount rate applies` FALSE 0 EQUALS 5
#ASSERT `What discount rate applies` TRUE 3 EQUALS 3

-- Arguments: economic loss; victims compensation; insurer payments; prescribed amounts.
#ASSERT `What economic loss is left after the s 130 reduction` 100000 5000 10000 0 EQUALS 85000
#ASSERT `What economic loss is left after the s 130 reduction` 100000 0 0 2500 EQUALS 97500
#ASSERT `What economic loss is left after the s 130 reduction` 10000 5000 10000 0 EQUALS 0

§§ `ss 138, 140 -- contributory negligence and voluntary assumption of risk`

-- Arguments: convicted of an alcohol or drug offence; it did not contribute; minor; voluntary passenger with impaired
-- driver; could not reasonably decline; no seat belt; no helmet.
#ASSERT `Must a finding of contributory negligence be made` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Must a finding of contributory negligence be made` TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `Must a finding of contributory negligence be made` FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Must a finding of contributory negligence be made` FALSE FALSE TRUE TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `Must a finding of contributory negligence be made` FALSE FALSE FALSE TRUE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `Must a finding of contributory negligence be made` FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
-- A minor without a seat belt: case (c) excludes minors; the helmet case (d) does not.
#ASSERT `Must a finding of contributory negligence be made` FALSE FALSE TRUE FALSE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `Must a finding of contributory negligence be made` FALSE FALSE TRUE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- A minor convicted of a drink-driving offence: case (a) has no minor exception.
#ASSERT `Must a finding of contributory negligence be made` TRUE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Must a finding of contributory negligence be made` FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING

-- Arguments: damages including the insurer's payments; those payments; percentage reduction.
-- 100,000 less 25% is 75,000; less 20,000 already paid leaves 55,000.
#ASSERT `How much is still to be paid after contributory negligence` 100000 20000 25 EQUALS 55000
#ASSERT `How much is still to be paid after contributory negligence` 100000 80000 25 EQUALS 0
#ASSERT `How much is still to be paid after contributory negligence` 100000 0 0 EQUALS 100000
#ASSERT `How much is still to be paid after contributory negligence` 100000 75000 25 EQUALS 0

`driver` MEANS `I was its driver`
`passenger` MEANS `I was a passenger in it`
`not in it` MEANS `I was not in it`

-- Arguments: motor racing; position; under 18 or lacking capacity.
#ASSERT `Can the defendant rely on voluntary assumption of risk` FALSE `driver` FALSE EQUALS JUST FALSE
#ASSERT `Can the defendant rely on voluntary assumption of risk` TRUE `driver` FALSE EQUALS JUST TRUE
#ASSERT `Can the defendant rely on voluntary assumption of risk` TRUE `driver` TRUE EQUALS JUST TRUE
#ASSERT `Can the defendant rely on voluntary assumption of risk` TRUE `passenger` FALSE EQUALS JUST TRUE
#ASSERT `Can the defendant rely on voluntary assumption of risk` TRUE `passenger` TRUE EQUALS JUST FALSE
#ASSERT `Can the defendant rely on voluntary assumption of risk` TRUE `not in it` FALSE EQUALS JUST FALSE
#ASSERT `Can the defendant rely on voluntary assumption of risk` FALSE `passenger` FALSE EQUALS JUST FALSE

§§ `ss 141A-144 -- care and kinds of damages`

-- Arguments: paid for; Lifetime Care participant; would have been given anyway; hours a week; consecutive months; average weekly total earnings.
-- 6 hours at one-fortieth of 1,800 a week: 270. 20 hours: 900.
#ASSERT `What is the most per week for gratuitous attendant care` FALSE FALSE FALSE 6 6 1800 EQUALS JUST 270
#ASSERT `What is the most per week for gratuitous attendant care` FALSE FALSE FALSE 20 12 1800 EQUALS JUST 900
#ASSERT `What is the most per week for gratuitous attendant care` FALSE FALSE FALSE 40 12 1800 EQUALS JUST 1800
#ASSERT `What is the most per week for gratuitous attendant care` FALSE FALSE FALSE 50 12 1800 EQUALS JUST 1800
#ASSERT `What is the most per week for gratuitous attendant care` FALSE FALSE FALSE 5 12 1800 EQUALS JUST 0
#ASSERT `What is the most per week for gratuitous attendant care` FALSE FALSE FALSE 20 5 1800 EQUALS JUST 0
#ASSERT `What is the most per week for gratuitous attendant care` FALSE FALSE TRUE 20 12 1800 EQUALS JUST 0
#ASSERT `What is the most per week for gratuitous attendant care` FALSE TRUE FALSE 20 12 1800 EQUALS JUST 0
#ASSERT `What is the most per week for gratuitous attendant care` TRUE FALSE FALSE 20 12 1800 EQUALS NOTHING

-- Arguments: the kind; a Compensation to Relatives Act action; seriously injured needing long-term constant care; reasonable and necessary.
#ASSERT `Can damages of this kind be awarded` `exemplary or punitive damages` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Can damages of this kind be awarded` `damages for the loss of another person's services` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Can damages of this kind be awarded` `damages for the loss of another person's services` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `Can damages of this kind be awarded` `damages for treatment and care needs while I am a Lifetime Care and Support participant` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Can damages of this kind be awarded` `compensation for respite care` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Can damages of this kind be awarded` `compensation for respite care` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `Can damages of this kind be awarded` `compensation for respite care` FALSE FALSE TRUE EQUALS NOTHING

§§ `s 137 -- interest`

`non-economic` MEANS `damages for non-economic loss`
`gratuitous care` MEANS `compensation for gratuitous attendant care services under s 141B`
`other head` MEANS `another head of damages`

-- Arguments: the damages; (i) no offer; (ii) no revised offer; (iii) s 83 failure; written offer made; highest offer;
-- damages awarded without interest; highest offer unreasonable.
#ASSERT `Can I get interest on my damages` `non-economic` TRUE TRUE TRUE FALSE 0 0 FALSE EQUALS JUST FALSE
#ASSERT `Can I get interest on my damages` `gratuitous care` TRUE TRUE TRUE FALSE 0 0 FALSE EQUALS JUST FALSE
#ASSERT `Can I get interest on my damages` `other head` TRUE FALSE FALSE FALSE 0 200000 FALSE EQUALS JUST TRUE
#ASSERT `Can I get interest on my damages` `other head` FALSE TRUE FALSE TRUE 100000 200000 FALSE EQUALS JUST TRUE
#ASSERT `Can I get interest on my damages` `other head` FALSE FALSE TRUE TRUE 100000 110000 FALSE EQUALS JUST TRUE
-- Case (iv): more than 20% above the highest offer (100,000): 120,000 is not more; 120,001 is.
#ASSERT `Can I get interest on my damages` `other head` FALSE FALSE FALSE TRUE 100000 120000 TRUE EQUALS JUST FALSE
#ASSERT `Can I get interest on my damages` `other head` FALSE FALSE FALSE TRUE 100000 120001 TRUE EQUALS JUST TRUE
#ASSERT `Can I get interest on my damages` `other head` FALSE FALSE FALSE TRUE 100000 120001 FALSE EQUALS JUST FALSE
#ASSERT `Can I get interest on my damages` `other head` FALSE FALSE FALSE FALSE 0 120001 TRUE EQUALS JUST FALSE

-- Three-quarters of the Civil Procedure Act rate.
#ASSERT `What is the interest rate on my damages` 8 EQUALS 6
#ASSERT `What is the interest rate on my damages` 6.1 EQUALS 4.575
#ASSERT `What is the interest rate on my damages` 0 EQUALS 0
