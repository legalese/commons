#ASSERT `Could it be professional misconduct` `medical` `care below` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Could it be professional misconduct` `another registered health profession` `none of these` FALSE FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `Could it be professional misconduct` `another registered health profession` `referral` FALSE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Could it be professional misconduct` `another registered health profession` `referral` FALSE FALSE FALSE TRUE EQUALS NOTHING

§§ `s 139 -- competent`

#ASSERT `Is the practitioner competent to practise` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Is the practitioner competent to practise` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Is the practitioner competent to practise` FALSE TRUE TRUE TRUE EQUALS JUST FALSE

§§ `ss 144D(3), 145G-145J -- referral`

-- Arguments: died, in writing with particulars, did not give particulars asked for, still registered, proceedings.
#ASSERT `Can my complaint be referred for a hearing` TRUE TRUE FALSE TRUE FALSE EQUALS `no: the practitioner has died`
#ASSERT `Can my complaint be referred for a hearing` TRUE FALSE TRUE FALSE TRUE EQUALS `no: the practitioner has died`
#ASSERT `Can my complaint be referred for a hearing` FALSE FALSE FALSE TRUE FALSE EQUALS `not yet: it must first be in writing with the particulars of the allegations`
#ASSERT `Can my complaint be referred for a hearing` FALSE TRUE TRUE TRUE FALSE EQUALS `it may be referred, but need not be: the further particulars asked for were not given`
#ASSERT `Can my complaint be referred for a hearing` FALSE TRUE FALSE FALSE FALSE EQUALS `it may be referred, but need not be: the practitioner is no longer registered`
-- s 145G: my own civil claim does not stop the complaint.
#ASSERT `Can my complaint be referred for a hearing` FALSE TRUE FALSE TRUE TRUE EQUALS `yes, even though civil or criminal proceedings on the same matter are under way`
#ASSERT `Can my complaint be referred for a hearing` FALSE TRUE FALSE TRUE FALSE EQUALS `yes`

§§ `s 145D -- the Tribunal`

-- Arguments: who holds it, opinion it could justify suspension or cancellation, solely or principally capacity, frivolous.
#ASSERT `Must my complaint go to the Tribunal` `the Council` FALSE FALSE FALSE EQUALS `section 145D does not require it to go to the Tribunal`
#ASSERT `Must my complaint go to the Tribunal` `the Council` FALSE TRUE TRUE EQUALS `section 145D does not require it to go to the Tribunal`
#ASSERT `Must my complaint go to the Tribunal` `the Council` TRUE FALSE TRUE EQUALS `not required: the Council or the Commission thinks it frivolous or vexatious`
#ASSERT `Must my complaint go to the Tribunal` `the Council` TRUE TRUE FALSE EQUALS `the Council may send it instead to a Committee or an Impaired Registrants Panel`
#ASSERT `Must my complaint go to the Tribunal` `the Commission` TRUE TRUE FALSE EQUALS `the Commission may send it instead to the Council`
#ASSERT `Must my complaint go to the Tribunal` `the Commission` TRUE FALSE FALSE EQUALS `it must be referred to the Tribunal`
#ASSERT `Must my complaint go to the Tribunal` `the Council` TRUE FALSE FALSE EQUALS `it must be referred to the Tribunal`

§§ `ss 145B, 146, 147A, 148 -- which bodies`

#ASSERT `Which bodies can hear my complaint` `medical` FALSE FALSE EQUALS (LIST `the Tribunal`, `PSC`)
#ASSERT `Which bodies can hear my complaint` `nursing and midwifery` TRUE FALSE EQUALS (LIST `the Tribunal`, `PSC`)
#ASSERT `Which bodies can hear my complaint` `pharmacy` TRUE FALSE EQUALS (LIST `the Tribunal`, `AC`, `council meeting`)
#ASSERT `Which bodies can hear my complaint` `pharmacy` FALSE FALSE EQUALS (LIST `the Tribunal`, `council meeting`)
-- s 147A(2): a complaint of bad character or a conviction cannot go to an Assessment Committee.
#ASSERT `Which bodies can hear my complaint` `another registered health profession` TRUE TRUE EQUALS (LIST `the Tribunal`, `council meeting`)

§§ `ss 145BA, 148H -- the outcome notice`

#ASSERT `When must the Council tell me the outcome` `dealt with it by inquiry at a Council meeting` (`d` 2 3 2026) EQUALS `the Council must give me written notice of the result, and a written statement of the decision with reasons, by` (`d` 1 4 2026)
#ASSERT `When must the Council tell me the outcome` `no further action` (`d` 15 12 2026) EQUALS `the Council must give me written notice of the outcome by` (`d` 14 1 2027)
-- Over February in a common year, and in a leap year.
#ASSERT `When must the Council tell me the outcome` `directed the practitioner to attend counselling` (`d` 31 1 2026) EQUALS `the Council must give me written notice of the outcome by` (`d` 2 3 2026)
#ASSERT `When must the Council tell me the outcome` `directed the practitioner to attend counselling` (`d` 31 1 2028) EQUALS `the Council must give me written notice of the outcome by` (`d` 1 3 2028)
#ASSERT `When must the Council tell me the outcome` `took action after referring the practitioner for a health or performance assessment or to an Impaired Registrants Panel` (`d` 1 6 2026) EQUALS `the Council must give me written notice of the outcome by` (`d` 1 7 2026)
#ASSERT `When must the Council tell me the outcome` `referred it to another entity, such as a National Board` (`d` 1 6 2026) EQUALS `the Council must give me written notice of the outcome by` (`d` 1 7 2026)
#ASSERT `When must the Council tell me the outcome` `referred it to the Tribunal` (`d` 1 6 2026) EQUALS `section 145BA does not require the Council to tell me of this step`
#ASSERT `When must the Council tell me the outcome` `made inquiries about it` (`d` 1 6 2026) EQUALS `section 145BA does not require the Council to tell me of this step`
#ASSERT `When must the Council tell me the outcome` `referred it to the Commission for investigation` (`d` 1 6 2026) EQUALS `section 145BA does not require the Council to tell me of this step`

-- Arguments: step, outcome day, given, day given, today. Day 30 is in time; day 31 is late (regulative rule).
#ASSERT `Was I told the outcome in time` `no further action` (`d` 1 3 2026) TRUE (`d` 31 3 2026) (`d` 1 5 2026) EQUALS `given in time`
#ASSERT `Was I told the outcome in time` `no further action` (`d` 1 3 2026) TRUE (`d` 1 4 2026) (`d` 1 5 2026) EQUALS `given late: more than 30 days after the outcome`
#ASSERT `Was I told the outcome in time` `no further action` (`d` 1 3 2026) TRUE (`d` 1 3 2026) (`d` 1 5 2026) EQUALS `given in time`
#ASSERT `Was I told the outcome in time` `no further action` (`d` 1 3 2026) FALSE (`d` 1 1 2026) (`d` 31 3 2026) EQUALS `not yet given, and not yet due`
#ASSERT `Was I told the outcome in time` `no further action` (`d` 1 3 2026) FALSE (`d` 1 1 2026) (`d` 1 4 2026) EQUALS `not yet given, and overdue`
#ASSERT `Was I told the outcome in time` `referred it to a Committee` (`d` 1 3 2026) FALSE (`d` 1 1 2026) (`d` 1 9 2026) EQUALS `section 145BA does not require notice of this step`
-- The regulative rule directly.
#ASSERT `outcome notice given in time` 30
#ASSERT NOT (`outcome notice given in time` 31)

