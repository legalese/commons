#ASSERT `What rate of interest is payable on my legacy` TRUE FALSE 0 FALSE 0 0.1 EQUALS JUST 2.1
#ASSERT `What rate of interest is payable on my legacy` TRUE TRUE 5 FALSE 0 4.35 EQUALS JUST 5
#ASSERT `What rate of interest is payable on my legacy` TRUE TRUE 5 TRUE 3 4.35 EQUALS JUST 3
#ASSERT `What rate of interest is payable on my legacy` FALSE FALSE 0 FALSE 0 4.35 EQUALS NOTHING

-- Arguments: annuity; legacy; satisfied by appropriation.
