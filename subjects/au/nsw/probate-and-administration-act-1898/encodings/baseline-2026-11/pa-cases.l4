IMPORT prelude
IMPORT `pa-dates`
IMPORT `pa-claims`

-- Probate and Administration Act 1898 (NSW) -- worked cases for every exported question in pa-claims.l4.
-- Every expected value was worked by hand from the deposited text; none was copied from the encoding's output. Each
-- assertion is a claim about the ENCODING on stated facts, not about the law. Dates and amounts are illustrative.
-- BASELINE ENCODING. Not for public use as advice. See NOTES.md.

§ `cases`

`d` MEANS `the date`

`spouse` MEANS `I was their spouse or de facto spouse`
`kin` MEANS `I am one of their next of kin`
`creditor` MEANS `I am their creditor`
`nobody` MEANS `none of these`

`interested` MEANS `I am interested in the estate`
`a creditor` MEANS `I am a creditor of the person who died`
`no standing` MEANS `neither`

`NSW Trustee` MEANS `the NSW Trustee and Guardian`
`trustee company` MEANS `a trustee company`
`other executor` MEANS `someone else`

`unprotected` MEANS `the executor is not protected by section 92 against my claim`
`protected` MEANS `the executor is not liable to me for the assets distributed, but I may follow them into the hands of those who received them`
`earlier s 92` MEANS `the earlier section 92 applies because the death was before the 2008 amendments, and it is not encoded here`

`s 93 n/a` MEANS `section 93 does not apply to my claim`
`3 months running` MEANS `the 3 months to take proceedings have not ended, so section 93 cannot yet bar my claim`
`no bar` MEANS `section 93 gives no bar while I satisfy the Court I am prosecuting my claim`
`may bar` MEANS `the Court may bar my claim against the executor on the executor's application`
`2 months running` MEANS `the 2 months to serve process on the NSW Trustee or trustee company have not ended`
`barred` MEANS `my claim is barred and irrecoverable against the NSW Trustee or trustee company`

`87 not yet` MEANS `the time for filing has not passed by a month, so section 87 does not yet arise`
`87 filed first month` MEANS `the executor filed within a month after the time fixed, so section 87 does not arise`
`87 notify` MEANS `the Registrar must notify the executor of the neglect`
`87 month running` MEANS `the executor has a month from the Registrar's notice to file`
`87 filed after notice` MEANS `the executor filed within a month of the Registrar's notice`
`87 show cause` MEANS `the Court may order the executor to show cause, on pain of contempt or a fine of up to 20 penalty units, with the costs personally`

§§ `the month arithmetic (fork F1)`

#ASSERT (d 31 8 2025) `plus months` 6 EQUALS d 28 2 2026
#ASSERT (d 31 8 2023) `plus months` 6 EQUALS d 29 2 2024
#ASSERT (d 15 11 2025) `plus months` 3 EQUALS d 15 2 2026
#ASSERT (d 29 2 2024) `plus months` 36 EQUALS d 28 2 2027

§§ `s 63 -- administration on intestacy`

-- Arguments: left a will; relationship; under 18; a fit spouse or next of kin in NSW.
#ASSERT `Can I be granted administration` FALSE `spouse` FALSE TRUE EQUALS JUST TRUE
#ASSERT `Can I be granted administration` FALSE `kin` FALSE TRUE EQUALS JUST TRUE
#ASSERT `Can I be granted administration` FALSE `kin` FALSE FALSE EQUALS JUST TRUE
-- (d) only "if there be no such person": a creditor is not eligible while a fit spouse or next of kin is in NSW.
#ASSERT `Can I be granted administration` FALSE `creditor` FALSE TRUE EQUALS JUST FALSE
#ASSERT `Can I be granted administration` FALSE `creditor` FALSE FALSE EQUALS JUST TRUE
#ASSERT `Can I be granted administration` FALSE `nobody` FALSE FALSE EQUALS JUST TRUE
#ASSERT `Can I be granted administration` FALSE `nobody` FALSE TRUE EQUALS JUST FALSE
-- "not being minors" (fork F2).
#ASSERT `Can I be granted administration` FALSE `spouse` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Can I be granted administration` FALSE `creditor` TRUE FALSE EQUALS JUST FALSE
-- A will: outside s 63.
#ASSERT `Can I be granted administration` TRUE `spouse` FALSE TRUE EQUALS NOTHING

§§ `s 75 -- the executor who does not prove the will`

-- Arguments: day of death; executor under 18 at the death; executor's 18th birthday.
-- 15 January + 3 months = 15 April; the Court may act from 16 April.
#ASSERT `From what day can I apply because the executor has not proved the will` (d 15 1 2025) FALSE (d 1 1 2000) EQUALS d 16 4 2025
-- 31 August + 3 months = 30 November (short month); from 1 December.
#ASSERT `From what day can I apply because the executor has not proved the will` (d 31 8 2025) FALSE (d 1 1 2000) EQUALS d 1 12 2025
-- A minor executor: the three months run from the 18th birthday (10 March 2026 -> 10 June -> 11 June).
#ASSERT `From what day can I apply because the executor has not proved the will` (d 1 1 2026) TRUE (d 10 3 2026) EQUALS d 11 6 2026

-- Arguments: standing; unknown or cannot be found; death; minor; 18th birthday; proved or renounced; day; day I apply.
-- The day after the three months: neglect within three months, the Court may act.
#ASSERT `Can I apply because the executor has not proved the will` `interested` FALSE (d 15 1 2025) FALSE (d 1 1 2000) FALSE (d 1 1 2000) (d 16 4 2025) EQUALS JUST TRUE
-- The last day of the three months: not yet.
#ASSERT `Can I apply because the executor has not proved the will` `interested` FALSE (d 15 1 2025) FALSE (d 1 1 2000) FALSE (d 1 1 2000) (d 15 4 2025) EQUALS JUST FALSE
-- Proved on the last day of the three months: no neglect.
#ASSERT `Can I apply because the executor has not proved the will` `a creditor` FALSE (d 15 1 2025) FALSE (d 1 1 2000) TRUE (d 15 4 2025) (d 1 6 2025) EQUALS JUST FALSE
-- Proved a day late: the neglect within three months happened (fork F3).
#ASSERT `Can I apply because the executor has not proved the will` `a creditor` FALSE (d 15 1 2025) FALSE (d 1 1 2000) TRUE (d 16 4 2025) (d 1 6 2025) EQUALS JUST TRUE
-- Unknown or cannot be found: no waiting.
#ASSERT `Can I apply because the executor has not proved the will` `a creditor` TRUE (d 15 1 2025) FALSE (d 1 1 2000) FALSE (d 1 1 2000) (d 16 1 2025) EQUALS JUST TRUE
-- Not among the applicants s 75 names (fork F4).
#ASSERT `Can I apply because the executor has not proved the will` `no standing` TRUE (d 15 1 2025) FALSE (d 1 1 2000) FALSE (d 1 1 2000) (d 16 6 2025) EQUALS NOTHING
-- A minor executor: from the 18th birthday.
#ASSERT `Can I apply because the executor has not proved the will` `interested` FALSE (d 1 1 2026) TRUE (d 10 3 2026) FALSE (d 1 1 2000) (d 10 6 2026) EQUALS JUST FALSE
#ASSERT `Can I apply because the executor has not proved the will` `interested` FALSE (d 1 1 2026) TRUE (d 10 3 2026) FALSE (d 1 1 2000) (d 11 6 2026) EQUALS JUST TRUE

§§ `ss 42(2), 101, 144`

#ASSERT `First day I can apply after publishing notice` (d 1 3 2026) EQUALS d 15 3 2026
#ASSERT `First day I can apply after publishing notice` (d 25 12 2025) EQUALS d 8 1 2026

#ASSERT `Can I apply to the Registrar for a small estate` 15000 EQUALS JUST TRUE
#ASSERT `Can I apply to the Registrar for a small estate` 15000.01 EQUALS JUST FALSE
#ASSERT `Can I apply to the Registrar for a small estate` 0 EQUALS JUST TRUE

#ASSERT `Can I lodge a caveat` FALSE EQUALS JUST TRUE
#ASSERT `Can I lodge a caveat` TRUE EQUALS JUST FALSE

§§ `ss 40B, 81B`

-- Arguments: leave given; caveat outstanding.
#ASSERT `Can the estate presumed dead be distributed` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Can the estate presumed dead be distributed` TRUE TRUE EQUALS JUST FALSE
#ASSERT `Can the estate presumed dead be distributed` FALSE FALSE EQUALS JUST FALSE

-- Arguments: died on or after 31 December 1981; disclosed.
#ASSERT `Can the executor complete the transfer to me` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Can the executor complete the transfer to me` TRUE TRUE EQUALS NOTHING
#ASSERT `Can the executor complete the transfer to me` FALSE FALSE EQUALS NOTHING

§§ `s 92A -- maintenance`

-- Arguments: survived; wholly or substantially dependent; entitled if surviving the period.
#ASSERT `Can the executor pay me maintenance now` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Can the executor pay me maintenance now` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Can the executor pay me maintenance now` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Can the executor pay me maintenance now` FALSE TRUE TRUE EQUALS JUST FALSE

#ASSERT `How much of my share is left after maintenance` 10000 3000 EQUALS JUST 7000
#ASSERT `How much of my share is left after maintenance` 3000 3000 EQUALS JUST 0
#ASSERT `How much of my share is left after maintenance` 3000 3000.5 EQUALS NOTHING

§§ `ss 92, 95 -- distribution after notice`

-- Arguments: day of death; day notice given; last day of the time in the notice.
-- Six months end 28 February 2026 (short month); the notice's time ended 1 October 2025: the later is 28 February.
#ASSERT `From what day can the executor distribute under section 92` (d 31 8 2025) (d 1 9 2025) (d 1 10 2025) EQUALS JUST (d 28 2 2026)
#ASSERT `From what day can the executor distribute under section 92` (d 31 8 2023) (d 1 9 2023) (d 1 10 2023) EQUALS JUST (d 29 2 2024)
-- The notice's time ends 15 July, after the six months (1 July): from 16 July.
#ASSERT `From what day can the executor distribute under section 92` (d 1 1 2025) (d 1 6 2025) (d 15 7 2025) EQUALS JUST (d 16 7 2025)
-- 29 days: s 92(1)(c) fails.
#ASSERT `From what day can the executor distribute under section 92` (d 31 8 2025) (d 1 9 2025) (d 30 9 2025) EQUALS NOTHING

-- Arguments: death; died before the 2008 amendments; notice given; notice day; last day; distribution day; knew of my
-- claim; BDM certificate would show it; Succession Act claim; that provision's conditions met; directed notices not given.
#ASSERT `What section 92 means for my claim` (d 1 1 2025) FALSE TRUE (d 1 6 2025) (d 15 7 2025) (d 16 7 2025) FALSE FALSE FALSE FALSE FALSE EQUALS `protected`
-- Distributed on the last day of the notice's time: (d) not met.
#ASSERT `What section 92 means for my claim` (d 1 1 2025) FALSE TRUE (d 1 6 2025) (d 15 7 2025) (d 15 7 2025) FALSE FALSE FALSE FALSE FALSE EQUALS `unprotected`
-- The six months: 27 February 2026 is too early, 28 February 2026 is at least six months.
#ASSERT `What section 92 means for my claim` (d 31 8 2025) FALSE TRUE (d 1 9 2025) (d 1 10 2025) (d 27 2 2026) FALSE FALSE FALSE FALSE FALSE EQUALS `unprotected`
#ASSERT `What section 92 means for my claim` (d 31 8 2025) FALSE TRUE (d 1 9 2025) (d 1 10 2025) (d 28 2 2026) FALSE FALSE FALSE FALSE FALSE EQUALS `protected`
-- A notice of 29 days.
#ASSERT `What section 92 means for my claim` (d 31 8 2025) FALSE TRUE (d 1 9 2025) (d 30 9 2025) (d 1 6 2026) FALSE FALSE FALSE FALSE FALSE EQUALS `unprotected`
-- The executor knew of my claim; a BDM certificate would have shown it (s 92(3)).
#ASSERT `What section 92 means for my claim` (d 1 1 2025) FALSE TRUE (d 1 6 2025) (d 15 7 2025) (d 16 7 2025) TRUE FALSE FALSE FALSE FALSE EQUALS `unprotected`
#ASSERT `What section 92 means for my claim` (d 1 1 2025) FALSE TRUE (d 1 6 2025) (d 15 7 2025) (d 16 7 2025) FALSE TRUE FALSE FALSE FALSE EQUALS `unprotected`
-- A Succession Act claim: protected only if that provision's circumstances are met (fork F6).
#ASSERT `What section 92 means for my claim` (d 1 1 2025) FALSE TRUE (d 1 6 2025) (d 15 7 2025) (d 16 7 2025) FALSE FALSE TRUE FALSE FALSE EQUALS `unprotected`
#ASSERT `What section 92 means for my claim` (d 1 1 2025) FALSE TRUE (d 1 6 2025) (d 15 7 2025) (d 16 7 2025) FALSE FALSE TRUE TRUE FALSE EQUALS `protected`
-- s 40B(4): directed notices not given.
#ASSERT `What section 92 means for my claim` (d 1 1 2025) FALSE TRUE (d 1 6 2025) (d 15 7 2025) (d 16 7 2025) FALSE FALSE FALSE FALSE TRUE EQUALS `unprotected`
-- No notice at all.
#ASSERT `What section 92 means for my claim` (d 1 1 2025) FALSE FALSE (d 1 6 2025) (d 15 7 2025) (d 16 7 2025) FALSE FALSE FALSE FALSE FALSE EQUALS `unprotected`
-- Sch 5 cl 8.
#ASSERT `What section 92 means for my claim` (d 1 1 2005) TRUE TRUE (d 1 6 2005) (d 15 7 2005) (d 16 7 2005) FALSE FALSE FALSE FALSE FALSE EQUALS `earlier s 92`

§§ `s 93 -- disputed claims`

#ASSERT `By when must I take proceedings on my disputed claim` (d 30 11 2025) EQUALS d 28 2 2026
#ASSERT `By when must I take proceedings on my disputed claim` (d 31 3 2026) EQUALS d 30 6 2026
#ASSERT `By when must I take proceedings on my disputed claim` (d 1 2 2026) EQUALS d 1 5 2026

-- Arguments: s 92 notices published; disputed and s 93 notice served; day served; commenced; day commenced; the Court
-- is satisfied I am prosecuting; who the executor is; further notice served; its day; process served; its day; waived;
-- the day asked about. Notice served 1 February 2026: the three months end 1 May 2026.
#ASSERT `Can my disputed claim be barred` FALSE TRUE (d 1 2 2026) FALSE (d 1 1 2000) FALSE `other executor` FALSE (d 1 1 2000) FALSE (d 1 1 2000) FALSE (d 1 6 2026) EQUALS `s 93 n/a`
#ASSERT `Can my disputed claim be barred` TRUE FALSE (d 1 2 2026) FALSE (d 1 1 2000) FALSE `other executor` FALSE (d 1 1 2000) FALSE (d 1 1 2000) FALSE (d 1 6 2026) EQUALS `s 93 n/a`
-- The last day of the three months: not yet.
#ASSERT `Can my disputed claim be barred` TRUE TRUE (d 1 2 2026) FALSE (d 1 1 2000) FALSE `other executor` FALSE (d 1 1 2000) FALSE (d 1 1 2000) FALSE (d 1 5 2026) EQUALS `3 months running`
-- The day after, nothing commenced: the Court may bar on the executor's application.
#ASSERT `Can my disputed claim be barred` TRUE TRUE (d 1 2 2026) FALSE (d 1 1 2000) FALSE `other executor` FALSE (d 1 1 2000) FALSE (d 1 1 2000) FALSE (d 2 5 2026) EQUALS `may bar`
-- Commenced on the last day and prosecuting: no bar; commenced but not prosecuting: the Court may still bar (s 93(2)).
#ASSERT `Can my disputed claim be barred` TRUE TRUE (d 1 2 2026) TRUE (d 1 5 2026) TRUE `other executor` FALSE (d 1 1 2000) FALSE (d 1 1 2000) FALSE (d 10 5 2026) EQUALS `no bar`
#ASSERT `Can my disputed claim be barred` TRUE TRUE (d 1 2 2026) TRUE (d 1 5 2026) FALSE `other executor` FALSE (d 1 1 2000) FALSE (d 1 1 2000) FALSE (d 10 5 2026) EQUALS `may bar`
-- The NSW Trustee: nothing commenced; further notice 10 May 2026, two months end 10 July 2026.
#ASSERT `Can my disputed claim be barred` TRUE TRUE (d 1 2 2026) FALSE (d 1 1 2000) FALSE `NSW Trustee` TRUE (d 10 5 2026) FALSE (d 1 1 2000) FALSE (d 10 7 2026) EQUALS `2 months running`
#ASSERT `Can my disputed claim be barred` TRUE TRUE (d 1 2 2026) FALSE (d 1 1 2000) FALSE `NSW Trustee` TRUE (d 10 5 2026) FALSE (d 1 1 2000) FALSE (d 11 7 2026) EQUALS `barred`
-- Waived (s 93(5)): back to s 93(2).
#ASSERT `Can my disputed claim be barred` TRUE TRUE (d 1 2 2026) FALSE (d 1 1 2000) TRUE `NSW Trustee` TRUE (d 10 5 2026) FALSE (d 1 1 2000) TRUE (d 11 7 2026) EQUALS `no bar`
-- Process served on the last day of the two months.
#ASSERT `Can my disputed claim be barred` TRUE TRUE (d 1 2 2026) FALSE (d 1 1 2000) TRUE `trustee company` TRUE (d 10 5 2026) TRUE (d 10 7 2026) FALSE (d 20 7 2026) EQUALS `no bar`
#ASSERT `Can my disputed claim be barred` TRUE TRUE (d 1 2 2026) FALSE (d 1 1 2000) FALSE `trustee company` TRUE (d 10 5 2026) TRUE (d 10 7 2026) FALSE (d 20 7 2026) EQUALS `may bar`
-- Commenced a day late, process never served: barred.
#ASSERT `Can my disputed claim be barred` TRUE TRUE (d 1 2 2026) TRUE (d 2 5 2026) TRUE `trustee company` TRUE (d 10 5 2026) FALSE (d 1 1 2000) FALSE (d 11 7 2026) EQUALS `barred`
-- Commenced in time: s 93(3) does not reach the claimant, whatever notice is served.
#ASSERT `Can my disputed claim be barred` TRUE TRUE (d 1 2 2026) TRUE (d 1 5 2026) TRUE `trustee company` TRUE (d 10 5 2026) FALSE (d 1 1 2000) FALSE (d 20 7 2026) EQUALS `no bar`
-- The NSW Trustee served no further notice: only s 93(2).
#ASSERT `Can my disputed claim be barred` TRUE TRUE (d 1 2 2026) FALSE (d 1 1 2000) FALSE `NSW Trustee` FALSE (d 1 1 2000) FALSE (d 1 1 2000) FALSE (d 20 7 2026) EQUALS `may bar`

