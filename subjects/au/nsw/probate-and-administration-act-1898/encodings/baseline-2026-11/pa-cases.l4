#ASSERT `On how much of my legacy can interest run` FALSE 10000 10000 EQUALS JUST 0
#ASSERT `On how much of my legacy can interest run` FALSE 10000 12000 EQUALS JUST 0
#ASSERT `On how much of my legacy can interest run` TRUE 10000 4000 EQUALS JUST 10000

§§ `ss 85(3), 86, 86A, 87 -- accounts and commission`

#ASSERT `From what day do allowed accounts operate as a release` (d 15 6 2023) EQUALS d 16 6 2026
#ASSERT `From what day do allowed accounts operate as a release` (d 29 2 2024) EQUALS d 1 3 2027

-- Arguments: day of order; day I challenge; error, omission or fraudulent entry shown.
#ASSERT `Can I still challenge the allowed accounts` (d 15 6 2023) (d 15 6 2026) FALSE EQUALS JUST TRUE
#ASSERT `Can I still challenge the allowed accounts` (d 15 6 2023) (d 16 6 2026) FALSE EQUALS JUST FALSE
#ASSERT `Can I still challenge the allowed accounts` (d 15 6 2023) (d 16 6 2026) TRUE EQUALS JUST TRUE

-- Arguments: neglected without good reason; the Court allows a just and reasonable commission.
#ASSERT `Can the executor be paid commission` TRUE TRUE EQUALS JUST FALSE
#ASSERT `Can the executor be paid commission` FALSE TRUE EQUALS JUST TRUE
#ASSERT `Can the executor be paid commission` FALSE FALSE EQUALS NOTHING

#ASSERT `Can the commission be reduced` TRUE EQUALS JUST TRUE
#ASSERT `Can the commission be reduced` FALSE EQUALS JUST FALSE

-- Arguments: last day fixed; filed; day filed; Registrar notified; day of notice; day asked about.
-- Last day fixed 31 January 2026: the month after ends 28 February 2026.
#ASSERT `What can happen if the executor files no accounts` (d 31 1 2026) TRUE (d 28 2 2026) FALSE (d 1 1 2000) (d 10 3 2026) EQUALS `87 filed first month`
#ASSERT `What can happen if the executor files no accounts` (d 31 1 2026) FALSE (d 1 1 2000) FALSE (d 1 1 2000) (d 28 2 2026) EQUALS `87 not yet`
#ASSERT `What can happen if the executor files no accounts` (d 31 1 2026) FALSE (d 1 1 2000) FALSE (d 1 1 2000) (d 1 3 2026) EQUALS `87 notify`
-- Notified 5 March 2026: the month ends 5 April 2026.
#ASSERT `What can happen if the executor files no accounts` (d 31 1 2026) FALSE (d 1 1 2000) TRUE (d 5 3 2026) (d 5 4 2026) EQUALS `87 month running`
#ASSERT `What can happen if the executor files no accounts` (d 31 1 2026) FALSE (d 1 1 2000) TRUE (d 5 3 2026) (d 6 4 2026) EQUALS `87 show cause`
#ASSERT `What can happen if the executor files no accounts` (d 31 1 2026) TRUE (d 5 4 2026) TRUE (d 5 3 2026) (d 10 4 2026) EQUALS `87 filed after notice`
#ASSERT `What can happen if the executor files no accounts` (d 31 1 2026) TRUE (d 6 4 2026) TRUE (d 5 3 2026) (d 10 4 2026) EQUALS `87 show cause`

#ASSERT `The most the executor can be fined in penalty units` EQUALS 20

§§ `s 46C, Sch 3`

#ASSERT `Is the estate solvent` 100000 100000 EQUALS JUST TRUE
#ASSERT `Is the estate solvent` 99999 100000 EQUALS JUST FALSE

#ASSERT `In what place is my gift used to pay the debts` `assets undisposed of by the will` TRUE FALSE EQUALS JUST 1
#ASSERT `In what place is my gift used to pay the debts` `assets in a residuary gift and not specifically disposed of` TRUE FALSE EQUALS JUST 2
#ASSERT `In what place is my gift used to pay the debts` `assets the will appropriates for paying debts` TRUE FALSE EQUALS JUST 3
#ASSERT `In what place is my gift used to pay the debts` `assets the will charges with paying debts` TRUE FALSE EQUALS JUST 4
#ASSERT `In what place is my gift used to pay the debts` `the fund kept back to meet pecuniary legacies` TRUE FALSE EQUALS JUST 5
#ASSERT `In what place is my gift used to pay the debts` `assets specifically disposed of by the will` TRUE FALSE EQUALS JUST 6
#ASSERT `In what place is my gift used to pay the debts` `assets specifically disposed of by the will` FALSE FALSE EQUALS NOTHING
#ASSERT `In what place is my gift used to pay the debts` `assets undisposed of by the will` TRUE TRUE EQUALS NOTHING
