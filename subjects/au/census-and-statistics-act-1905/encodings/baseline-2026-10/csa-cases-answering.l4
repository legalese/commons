#ASSERT NOT `May an officer enter my premises` `a dwelling-house` TRUE TRUE
#ASSERT NOT `May an officer enter my premises` `a part separately used for residence or sleeping` TRUE TRUE
#ASSERT `May an officer enter my premises` `business premises` TRUE TRUE
#ASSERT NOT `May an officer enter my premises` `business premises` TRUE FALSE

