IMPORT prelude
IMPORT `ceps-rules`

§ `Tests`

card MEANS `Surcharge case` OF TRUE, FALSE, `a charge for one payment method rather than another`, FALSE, FALSE
#ASSERT `this Act authorises the surcharge for` card EQUALS JUST TRUE
#ASSERT `this Act authorises the surcharge for` (`Surcharge case` OF TRUE, FALSE, `a charge for processing the payment, on top of it`, FALSE, TRUE) EQUALS JUST TRUE
#ASSERT `this Act authorises the surcharge for` (`Surcharge case` OF FALSE, FALSE, `a charge for processing the payment, on top of it`, FALSE, TRUE) EQUALS JUST FALSE
#ASSERT `this Act authorises the surcharge for` (`Surcharge case` OF TRUE, FALSE, `a charge for processing the payment, on top of it`, TRUE, TRUE) EQUALS JUST FALSE
-- Changed after the independent pass (F1).
#ASSERT `this Act authorises the surcharge for` (`Surcharge case` OF TRUE, TRUE, `a charge for processing the payment, on top of it`, FALSE, TRUE) EQUALS JUST FALSE
#ASSERT `this Act authorises the surcharge for` (`Surcharge case` OF TRUE, FALSE, `something else`, FALSE, TRUE) EQUALS JUST FALSE
#ASSERT (`the surcharge position for` card)'s `a refund is in the entity's discretion`
#ASSERT NOT ((`the surcharge position for` card)'s `non-compliance with policy invalidates it`)
#ASSERT NOT ((`the surcharge position for` (`Surcharge case` OF FALSE, FALSE, `a charge for processing the payment, on top of it`, FALSE, TRUE))'s `a refund is in the entity's discretion`)
