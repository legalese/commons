IMPORT prelude
IMPORT `ceps-rules`

-- Independent tests, from independent-expectations.md.
-- "May charge under s 5?" expected yes -> JUST TRUE, no -> JUST FALSE.

§ `Independent tests`

GIVEN collects IS A BOOLEAN
      already IS A BOOLEAN
      kind IS A `Kind of amount`
      taxation IS A BOOLEAN
      followed IS A BOOLEAN
GIVETH A `Surcharge position`
pos collects already kind taxation followed MEANS
    `the surcharge position for` (`Surcharge case` OF collects, already, kind, taxation, followed)

proc MEANS `a charge for processing the payment, on top of it`
meth MEANS `a charge for one payment method rather than another`
other MEANS `something else`

-- 1: defaults
s1 MEANS pos TRUE FALSE proc FALSE TRUE
#ASSERT s1's `this Act authorises the surcharge` EQUALS JUST TRUE
#ASSERT s1's `a refund is in the entity's discretion`
#ASSERT NOT (s1's `non-compliance with policy invalidates it`)

-- 2: limb (b) payment-method charge
s2 MEANS pos TRUE FALSE meth FALSE TRUE
#ASSERT s2's `this Act authorises the surcharge` EQUALS JUST TRUE
#ASSERT s2's `a refund is in the entity's discretion`

-- 3: not a payment surcharge at all: s 5 does not authorise it
s3 MEANS pos TRUE FALSE other FALSE TRUE
#ASSERT s3's `this Act authorises the surcharge` EQUALS JUST FALSE
#ASSERT NOT (s3's `a refund is in the entity's discretion`)
#ASSERT NOT (s3's `non-compliance with policy invalidates it`)

-- 4: no power to collect the base payment (s 5(1)(a))
s4 MEANS pos FALSE FALSE proc FALSE TRUE
#ASSERT s4's `this Act authorises the surcharge` EQUALS JUST FALSE
#ASSERT NOT (s4's `a refund is in the entity's discretion`)

-- 5: already a surchargeable payment (s 5(1)(b)): s 5 does not authorise
s5 MEANS pos TRUE TRUE proc FALSE TRUE
#ASSERT s5's `this Act authorises the surcharge` EQUALS JUST FALSE
#ASSERT NOT (s5's `a refund is in the entity's discretion`)

-- 6: amounts to taxation (s 5(2))
s6 MEANS pos TRUE FALSE proc TRUE TRUE
#ASSERT s6's `this Act authorises the surcharge` EQUALS JUST FALSE
#ASSERT NOT (s6's `a refund is in the entity's discretion`)

-- 7: policies not followed: validity unaffected (s 7(2))
s7 MEANS pos TRUE FALSE proc FALSE FALSE
#ASSERT s7's `this Act authorises the surcharge` EQUALS JUST TRUE
#ASSERT s7's `a refund is in the entity's discretion`
#ASSERT NOT (s7's `non-compliance with policy invalidates it`)

-- 8: no power and not followed
s8 MEANS pos FALSE FALSE meth FALSE FALSE
#ASSERT s8's `this Act authorises the surcharge` EQUALS JUST FALSE
#ASSERT NOT (s8's `non-compliance with policy invalidates it`)

-- 10: taxation and not followed
s10 MEANS pos TRUE FALSE meth TRUE FALSE
#ASSERT s10's `this Act authorises the surcharge` EQUALS JUST FALSE
#ASSERT NOT (s10's `a refund is in the entity's discretion`)
#ASSERT NOT (s10's `non-compliance with policy invalidates it`)
