IMPORT prelude
IMPORT daydate

-- Parliamentary Retiring Allowances (Increases) Act 1967 (Cth). Source:
-- ../registers/source-bundle/C1967A00092.txt. Seat: the pensioner or widow.

§ `Nouns`

DECLARE `Pension class` IS ONE OF
    -- s 3(1)(a)-(b): weekly pensions
    `a weekly pensioner under s 3`
    -- s 4(1): annual pensions (members of the twenty-fourth Parliament)
    `an annual pensioner under s 4`
    -- s 3(2), s 4(2)
    `the widow of a man whose pension rose under s 3`
    `the widow of a man whose pension rose under s 4`
    `none of these`

DECLARE `Pensioner` HAS
    `class`                                             IS A `Pension class`
    -- the amount immediately before 8 November 1967: weekly for s 3, annual
    -- for s 4
    `pension before the Act`                            IS A NUMBER
    -- s 7
    `first fortnightly payment after 8 November 1967`   IS A DATE

DECLARE `Increase position` HAS
    `the increase`                                      IS A MAYBE NUMBER
    `the widow's pension`                               IS A MAYBE NUMBER
    `from`                                              IS A MAYBE DATE

§ `Rules`

-- s 3(1): the weekly table.
@ref s 3(1)
GIVEN a IS A NUMBER
GIVETH A MAYBE NUMBER
`the weekly increase on` a MEANS
    BRANCH
        IF a EQUALS 30 THEN JUST 18.16
        IF a EQUALS 33 THEN JUST 23.89
        IF a EQUALS 36 THEN JUST 21.79
        IF a EQUALS 42 THEN JUST 21.79
        OTHERWISE           NOTHING

-- s 4(1): the annual table.
@ref s 4(1)
GIVEN a IS A NUMBER
GIVETH A MAYBE NUMBER
`the annual increase on` a MEANS
    BRANCH
        IF a EQUALS 2291.67 THEN JUST 437.5
        IF a EQUALS 2750    THEN JUST 525
        IF a EQUALS 3062    THEN JUST 525
        OTHERWISE                NOTHING

@ref ss 3, 4, 7
@export default What does the Parliamentary Retiring Allowances (Increases) Act 1967 (Cth) give me? For a weekly pension of $30, $33, $36 or $42 (s 3(1)), an increase of $18.16, $23.89, $21.79 or $21.79 a week; for an annual pension of $2,291.67, $2,750 or $3,062 (s 4(1)), an increase of $437.50, $525 or $525 a year; each from the first fortnightly payment after 8 November 1967 (s 7). The widow of a man whose pension rose under s 3 receives $48.16 a week, and under s 4 $2,729.17 a year. NOTHING for an amount not in the tables or a person outside these classes. DRAFT, not reviewed by an Australian lawyer.
GIVEN p IS A `Pensioner`  @desc The class, the pension before the Act, and the first fortnightly payment after it
GIVETH A `Increase position`
`the increase position for` p MEANS
    `Increase position` WITH
        `the increase`                                  IS increase
        `the widow's pension`                           IS
            CONSIDER p's `class`
            WHEN `the widow of a man whose pension rose under s 3` THEN JUST 48.16
            WHEN `the widow of a man whose pension rose under s 4` THEN JUST 2729.17
            OTHERWISE NOTHING
        `from`                                          IS
            CONSIDER increase
            WHEN NOTHING THEN NOTHING
            WHEN JUST x  THEN JUST (p's `first fortnightly payment after 8 November 1967`)
    WHERE
        increase MEANS
            CONSIDER p's `class`
            WHEN `a weekly pensioner under s 3`  THEN `the weekly increase on` (p's `pension before the Act`)
            WHEN `an annual pensioner under s 4` THEN `the annual increase on` (p's `pension before the Act`)
            OTHERWISE NOTHING
