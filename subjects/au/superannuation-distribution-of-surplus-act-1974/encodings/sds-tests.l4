IMPORT prelude
IMPORT daydate
IMPORT `sds-rules`

§ `Tests`

-- Fields: obliged, contributor at assent, pensioner on, died on, left
-- dependants, deferred by 30.6.72, deferred not payable, pension in period,
-- died before payment, widow alive.
contributor MEANS `Fund member` OF TRUE, TRUE, NOTHING, NOTHING, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
#ASSERT `who is paid the share of` contributor EQUALS `the member`
#ASSERT `who is paid the share of` (`Fund member` OF TRUE, FALSE, JUST (Date 1 1 1970), NOTHING, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS `the member`
#ASSERT `who is paid the share of` (`Fund member` OF TRUE, FALSE, JUST (Date 1 1 1960), NOTHING, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS `no one: not eligible`
#ASSERT `who is paid the share of` (`Fund member` OF TRUE, FALSE, NOTHING, JUST (Date 1 1 1973), TRUE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS `the member`
#ASSERT `who is paid the share of` (`Fund member` OF TRUE, FALSE, NOTHING, JUST (Date 1 1 1973), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS `no one: not eligible`
#ASSERT `who is paid the share of` (`Fund member` OF TRUE, TRUE, NOTHING, NOTHING, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE) EQUALS `no one: not eligible`
#ASSERT `who is paid the share of` (`Fund member` OF FALSE, FALSE, NOTHING, NOTHING, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE) EQUALS `the member`
#ASSERT `who is paid the share of` (`Fund member` OF FALSE, FALSE, NOTHING, NOTHING, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE) EQUALS `the member`
#ASSERT `who is paid the share of` (`Fund member` OF TRUE, TRUE, NOTHING, NOTHING, FALSE, FALSE, FALSE, FALSE, TRUE, TRUE) EQUALS `the widow`
#ASSERT `who is paid the share of` (`Fund member` OF TRUE, TRUE, NOTHING, NOTHING, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE) EQUALS `whoever the Board determines`
