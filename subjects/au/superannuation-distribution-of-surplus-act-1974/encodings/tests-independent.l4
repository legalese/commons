IMPORT prelude
IMPORT daydate
IMPORT `sds-rules`

§ `Independent tests`

-- Written from independent-expectations.md. Field order of `Fund member`:
-- obliged before end of period, contributor at assent, became pensioner on,
-- died while contributor on, left widow/eligible children, deferred benefits
-- applicable by 30.6.72, deferred benefits not yet payable on 30.6.72,
-- contributory pension in period, died before payment, widow alive at payment.

-- A1 contributor at assent
#ASSERT `an eligible contributor` (`Fund member` OF TRUE, TRUE, NOTHING, NOTHING, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)
-- A2 became pensioner 15 Jun 1968
#ASSERT `an eligible contributor` (`Fund member` OF TRUE, FALSE, JUST (Date 15 6 1968), NOTHING, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)
-- A3 became pensioner 30 Jun 1962: before the period
#ASSERT NOT (`an eligible contributor` (`Fund member` OF TRUE, FALSE, JUST (Date 30 6 1962), NOTHING, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE))
-- A4 became pensioner 1 Jul 1962: on the commencement day (my reading: within)
#ASSERT `an eligible contributor` (`Fund member` OF TRUE, FALSE, JUST (Date 1 7 1962), NOTHING, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)
-- A5 became pensioner on assent day: not before it
#ASSERT NOT (`an eligible contributor` (`Fund member` OF TRUE, FALSE, JUST (Date 11 4 1974), NOTHING, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE))
-- A5b became pensioner the day before assent
#ASSERT `an eligible contributor` (`Fund member` OF TRUE, FALSE, JUST (Date 10 4 1974), NOTHING, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)
-- A6 died 3 Mar 1970 as contributor leaving a widow
#ASSERT `an eligible contributor` (`Fund member` OF TRUE, FALSE, NOTHING, JUST (Date 3 3 1970), TRUE, FALSE, FALSE, FALSE, FALSE, FALSE)
-- A7 died leaving no widow or eligible children
#ASSERT NOT (`an eligible contributor` (`Fund member` OF TRUE, FALSE, NOTHING, JUST (Date 3 3 1970), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE))
-- A8 child became eligible since death: dependants flag true
#ASSERT `an eligible contributor` (`Fund member` OF TRUE, FALSE, NOTHING, JUST (Date 3 3 1970), TRUE, FALSE, FALSE, FALSE, FALSE, FALSE)
-- A6b died 1960, before the period
#ASSERT NOT (`an eligible contributor` (`Fund member` OF TRUE, FALSE, NOTHING, JUST (Date 3 3 1960), TRUE, FALSE, FALSE, FALSE, FALSE, FALSE))
-- A9 obligation arose 1 Jul 1972 (after the period): obliged flag false
#ASSERT NOT (`an eligible contributor` (`Fund member` OF FALSE, TRUE, NOTHING, NOTHING, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE))
-- A11 deferred benefits applicable 30 Jun 1972: excluded
#ASSERT NOT (`an eligible contributor` (`Fund member` OF TRUE, TRUE, NOTHING, NOTHING, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE))
-- A13 contributory pension in the period
#ASSERT `an eligible pensioner` (`Fund member` OF FALSE, FALSE, NOTHING, NOTHING, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE)
-- A14/A16 only a non-contributory pension, or pension only after the period
#ASSERT NOT (`an eligible pensioner` (`Fund member` OF FALSE, FALSE, NOTHING, NOTHING, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE))
-- A17 deferred benefits applicable 30 Jun 1972, not yet payable: deemed pensioner
#ASSERT `an eligible pensioner` (`Fund member` OF FALSE, FALSE, NOTHING, NOTHING, FALSE, TRUE, TRUE, FALSE, FALSE, FALSE)
-- A17b same person is not an eligible contributor even if contributing at assent, but is paid as a pensioner
#ASSERT `who is paid the share of` (`Fund member` OF TRUE, TRUE, NOTHING, NOTHING, FALSE, TRUE, TRUE, FALSE, FALSE, FALSE) EQUALS `the member`
-- A18 deferred benefits became payable by 30 Jun 1972, no pension otherwise: not deemed
#ASSERT `who is paid the share of` (`Fund member` OF FALSE, FALSE, NOTHING, NOTHING, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE) EQUALS `no one: not eligible`
-- A20 alive at payment
#ASSERT `who is paid the share of` (`Fund member` OF FALSE, FALSE, NOTHING, NOTHING, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE) EQUALS `the member`
-- A21 died before payment, widow alive
#ASSERT `who is paid the share of` (`Fund member` OF FALSE, FALSE, NOTHING, NOTHING, FALSE, FALSE, FALSE, TRUE, TRUE, TRUE) EQUALS `the widow`
-- A22 died before payment, no widow alive
#ASSERT `who is paid the share of` (`Fund member` OF TRUE, FALSE, JUST (Date 15 6 1968), NOTHING, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE) EQUALS `whoever the Board determines`
-- not eligible at all: no one paid even if a widow survives
#ASSERT `who is paid the share of` (`Fund member` OF TRUE, FALSE, JUST (Date 30 6 1962), NOTHING, FALSE, FALSE, FALSE, FALSE, TRUE, TRUE) EQUALS `no one: not eligible`
