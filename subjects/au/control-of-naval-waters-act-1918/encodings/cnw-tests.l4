IMPORT prelude
IMPORT daydate
IMPORT `cnw-rules`

-- Control of Naval Waters Act 1918 (Cth) — the encoder's tests.

§ `Tests`

GIVEN k IS A `Kind of craft`, w IS A `Place`, ok IS A BOOLEAN
GIVETH A `Naval case`
`a` k `found` w `complying` ok MEANS
    `Naval case` OF k, w, TRUE, TRUE, ok, FALSE, 0, NOTHING, FALSE, 0, 0

-- ss 6, 6A
#ASSERT `failing it is an offence` (`a` `another vessel` `found` `within naval waters` `complying` FALSE)
#ASSERT NOT (`failing it is an offence` (`a` `another vessel` `found` `within naval waters` `complying` TRUE))
#ASSERT NOT (`failing it is an offence` (`a` `a vessel of the Commonwealth or the Australian Navy` `found` `within naval waters` `complying` FALSE))
#ASSERT NOT (`failing it is an offence` (`a` `a foreign naval vessel declared exempt` `found` `on the foreshore of naval waters` `complying` FALSE))
#ASSERT `failing it is an offence` (`a` `a vehicle` `found` `on the foreshore of naval waters` `complying` FALSE)
#ASSERT `failing it is an offence` (`a` `an aircraft` `found` `on the foreshore of naval waters` `complying` FALSE)
-- s 6 covers only vessels in the waters.
#ASSERT NOT (`failing it is an offence` (`a` `an aircraft` `found` `within naval waters` `complying` FALSE))
#ASSERT NOT (`failing it is an offence` (`a` `another vessel` `found` `elsewhere` `complying` FALSE))
#ASSERT (`the naval position for` (`a` `another vessel` `found` `within naval waters` `complying` FALSE))'s `maximum penalty units` EQUALS 10

GIVEN dd IS A MAYBE DATE, settled IS A BOOLEAN, proceeds IS A NUMBER
GIVETH A `Naval case`
`a removal demanded on` dd `paid` settled `sold for` proceeds MEANS
    `Naval case` OF `another vessel`, `within naval waters`, FALSE, FALSE, FALSE, TRUE, 5000, dd, settled, proceeds, 500

-- s 8
#ASSERT `I must pay the expenses` (`a removal demanded on` NOTHING `paid` FALSE `sold for` 0)
#ASSERT `the earliest sale day for` (`a removal demanded on` (JUST (Date 10 1 2026)) `paid` FALSE `sold for` 0) EQUALS JUST (Date 11 4 2026)
#ASSERT `the earliest sale day for` (`a removal demanded on` (JUST (Date 30 11 2025)) `paid` FALSE `sold for` 0) EQUALS JUST (Date 1 3 2026)
#ASSERT `the earliest sale day for` (`a removal demanded on` (JUST (Date 10 1 2026)) `paid` TRUE `sold for` 0) EQUALS NOTHING
#ASSERT `the surplus for` (`a removal demanded on` (JUST (Date 10 1 2026)) `paid` FALSE `sold for` 8000) EQUALS 2500
#ASSERT `the deficiency for` (`a removal demanded on` (JUST (Date 10 1 2026)) `paid` FALSE `sold for` 8000) EQUALS 0
#ASSERT `the deficiency for` (`a removal demanded on` (JUST (Date 10 1 2026)) `paid` FALSE `sold for` 4000) EQUALS 1500
#ASSERT NOT (`I must pay the expenses` (`Naval case` OF `a vessel of the Commonwealth or the Australian Navy`, `within naval waters`, FALSE, FALSE, FALSE, TRUE, 5000, NOTHING, FALSE, 0, 0))
