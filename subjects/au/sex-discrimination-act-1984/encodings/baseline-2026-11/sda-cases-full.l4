IMPORT prelude
IMPORT `sda-dates`
IMPORT `sda-work`

-- Sex Discrimination Act 1984 (Cth), baseline 2026-11 -- worked cases for the questions that take the full facts.
-- Generated by gen.py in the session scratchpad from a table of fixtures; every expected value was written by hand
-- from the text (the comment on each assertion gives the provision). The facts are HYPOTHETICAL.

§ `Cases with the full facts`

-- s 28B(2), (6)/(8), (7): a fellow employee's sexual comments at work are unlawful
#ASSERT `Is the harassment of me unlawful under section 28B` (`the date` 1 3 2025) TRUE TRUE TRUE TRUE FALSE `an employee of the organisation` TRUE TRUE FALSE TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE

-- s 28B: a customer's advance at work is unlawful only through (6)/(8) (connected with my being an employee)
#ASSERT `Is the harassment of me unlawful under section 28B` (`the date` 1 3 2025) TRUE TRUE TRUE TRUE FALSE `someone else` TRUE FALSE TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE

-- s 28B: harassment outside every s 28B situation -- the section does not say (NOTHING); other Division 3 sections may
#ASSERT `Is the harassment of me unlawful under section 28B` (`the date` 1 3 2025) TRUE TRUE TRUE TRUE FALSE `someone else` FALSE FALSE TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING

-- s 28A: no reasonable-person anticipation, so no harassment at all: JUST FALSE
#ASSERT `Is the harassment of me unlawful under section 28B` (`the date` 1 3 2025) TRUE TRUE TRUE TRUE FALSE `an employee of the organisation` TRUE TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE

-- s 28B(1)(b) with s 28AA: the employer demeaning a job applicant because of her sex
#ASSERT `Is the harassment of me unlawful under section 28B` (`the date` 1 3 2025) TRUE TRUE FALSE FALSE TRUE `the organisation itself` FALSE FALSE FALSE FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE

-- s 28AA: demeaning conduct not by reason of sex is not harassment on the ground of sex
#ASSERT `Is the harassment of me unlawful under section 28B` (`the date` 1 3 2025) TRUE TRUE TRUE TRUE FALSE `an employee of the organisation` TRUE TRUE FALSE FALSE TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE

-- s 28B(4)(a): a fellow worker in a PCBU that is not an employer
#ASSERT `Is the harassment of me unlawful under section 28B` (`the date` 1 3 2025) FALSE TRUE FALSE TRUE FALSE `a worker in the business` TRUE TRUE FALSE TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE

-- s 28B: the fellow employee case is (2), (5)/(7) and (6)/(8)
#ASSERT `Which subsections of section 28B make the harassment of me unlawful` (`the date` 1 3 2025) TRUE TRUE TRUE TRUE FALSE `an employee of the organisation` TRUE TRUE FALSE TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS LIST "s 28B(2)", "s 28B(5) or (7)", "s 28B(6) or (8)"

-- s 28B: the customer at work is (6)/(8) only
#ASSERT `Which subsections of section 28B make the harassment of me unlawful` (`the date` 1 3 2025) TRUE TRUE TRUE TRUE FALSE `someone else` TRUE FALSE TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS LIST "s 28B(6) or (8)"

-- s 28B: the applicant demeaned by the employer is (1) and (3)
#ASSERT `Which subsections of section 28B make the harassment of me unlawful` (`the date` 1 3 2025) TRUE TRUE FALSE FALSE TRUE `the organisation itself` FALSE FALSE FALSE FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS LIST "s 28B(1)", "s 28B(3)"

-- s 28B: no harassment, no subsections
#ASSERT `Which subsections of section 28B make the harassment of me unlawful` (`the date` 1 3 2025) TRUE TRUE TRUE TRUE FALSE `an employee of the organisation` TRUE TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS EMPTY

-- s 47C(1)(a), (2)(b), (3)(b); (1)(b), (4)(a), (5)(a): a fellow employee's sexual harassment
#ASSERT `Does the positive duty require the organisation to take measures against this conduct` (`the date` 1 3 2025) TRUE TRUE TRUE TRUE FALSE `an employee of the organisation` TRUE TRUE FALSE TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE

-- s 47C: the day before Part IIA commenced (12 Dec 2022) the duty did not exist
#ASSERT `Does the positive duty require the organisation to take measures against this conduct` (`the date` 12 12 2022) TRUE TRUE TRUE TRUE FALSE `an employee of the organisation` TRUE TRUE FALSE TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE

-- s 47C: on the day Part IIA commenced (13 Dec 2022) it did
#ASSERT `Does the positive duty require the organisation to take measures against this conduct` (`the date` 13 12 2022) TRUE TRUE TRUE TRUE FALSE `an employee of the organisation` TRUE TRUE FALSE TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE

-- s 47C(1)(b), (4)(a), (5)(a): a customer harassing an employee at work is covered
#ASSERT `Does the positive duty require the organisation to take measures against this conduct` (`the date` 1 3 2025) TRUE TRUE TRUE TRUE FALSE `someone else` TRUE FALSE TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE

-- s 47C: a customer's advance outside any s 28B situation is not covered
#ASSERT `Does the positive duty require the organisation to take measures against this conduct` (`the date` 1 3 2025) TRUE TRUE TRUE TRUE FALSE `someone else` FALSE FALSE TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE

-- s 47C(1)(a), (2)(b), (3)(a): the employer itself harassing a job applicant is covered
#ASSERT `Does the positive duty require the organisation to take measures against this conduct` (`the date` 1 3 2025) TRUE TRUE FALSE FALSE TRUE `the organisation itself` FALSE FALSE FALSE FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE

-- s 47C(1)(a), (2)(c), (3)(c); (1)(b), (4)(b), (5)(b): a contractor's hostile posters
#ASSERT `Does the positive duty require the organisation to take measures against this conduct` (`the date` 1 3 2025) TRUE TRUE FALSE TRUE FALSE `a worker in the business` TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE

-- s 47C(1)(a), (2)(c), (3)(b); (1)(b), (4)(b): an employee's hostile workplace conduct
#ASSERT `Does the positive duty require the organisation to take measures against this conduct` (`the date` 1 3 2025) TRUE TRUE TRUE TRUE FALSE `an employee of the organisation` TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE

-- s 47C: hostile conduct the day before s 28M commenced is not unlawful under s 28M, so not covered
#ASSERT `Does the positive duty require the organisation to take measures against this conduct` (`the date` 12 12 2022) TRUE TRUE TRUE TRUE FALSE `an employee of the organisation` TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE

-- s 47C(1)(b), (4)(b): a visitor making my workplace hostile is covered
#ASSERT `Does the positive duty require the organisation to take measures against this conduct` (`the date` 1 3 2025) TRUE TRUE TRUE TRUE FALSE `someone else` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE

-- s 47C(1)(a), (2)(a), (3)(d): the employer's agent discriminating in hiring is covered
#ASSERT `Does the positive duty require the organisation to take measures against this conduct` (`the date` 1 3 2025) TRUE TRUE FALSE FALSE TRUE `an agent of the organisation` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE

-- s 47C(2)(d), (4)(c): victimisation for complaining of harassment is covered
#ASSERT `Does the positive duty require the organisation to take measures against this conduct` (`the date` 1 3 2025) TRUE TRUE TRUE TRUE FALSE `an employee of the organisation` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE TRUE EQUALS JUST TRUE

-- s 47C: victimisation about other matters is not covered by (2)(d) or (4)(c)
#ASSERT `Does the positive duty require the organisation to take measures against this conduct` (`the date` 1 3 2025) TRUE TRUE TRUE TRUE FALSE `an employee of the organisation` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE

-- s 47C(2)(d), (4)(c) say 'acts of victimisation (within the meaning of section 47A)', not 'unlawful under': the s 47A(3) defence, which operates in a proceeding, does not take the act out of the duty
#ASSERT `Does the positive duty require the organisation to take measures against this conduct` (`the date` 1 3 2025) TRUE TRUE TRUE TRUE FALSE `an employee of the organisation` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE TRUE EQUALS JUST TRUE

-- s 47C(1)(b), (5)(b): a volunteer harassed by a customer is a worker in the business
#ASSERT `Does the positive duty require the organisation to take measures against this conduct` (`the date` 1 3 2025) TRUE TRUE FALSE TRUE FALSE `someone else` TRUE FALSE TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE

-- s 47C(1): not an employer or a PCBU, so no duty holder
#ASSERT `Does the positive duty require the organisation to take measures against this conduct` (`the date` 1 3 2025) FALSE FALSE FALSE FALSE FALSE `someone else` TRUE TRUE FALSE TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE

-- s 47C(3)(b), (5)(a): an employer that is not a PCBU owes the duty about its employees
#ASSERT `Does the positive duty require the organisation to take measures against this conduct` (`the date` 1 3 2025) TRUE FALSE TRUE FALSE FALSE `an employee of the organisation` TRUE TRUE FALSE TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE

-- s 47C(3)(c), (5)(b): a PCBU that is not an employer owes it about its workers
#ASSERT `Does the positive duty require the organisation to take measures against this conduct` (`the date` 1 3 2025) FALSE TRUE FALSE TRUE FALSE `a worker in the business` TRUE TRUE FALSE TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE

-- s 47C: the fellow employee case
#ASSERT `Which parts of the positive duty cover this conduct` (`the date` 1 3 2025) TRUE TRUE TRUE TRUE FALSE `an employee of the organisation` TRUE TRUE FALSE TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS LIST "s 47C(1)(a), (2)(b): harassment unlawful under s 28B by the duty holder, its employees, workers or agents", "s 47C(1)(b), (4)(a): harassment of its employees or workers unlawful under s 28B(6) or (8)"

-- s 47C: the customer case is (1)(b) only
#ASSERT `Which parts of the positive duty cover this conduct` (`the date` 1 3 2025) TRUE TRUE TRUE TRUE FALSE `someone else` TRUE FALSE TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS LIST "s 47C(1)(b), (4)(a): harassment of its employees or workers unlawful under s 28B(6) or (8)"

-- s 47C: the agent case is (1)(a), (2)(a) only
#ASSERT `Which parts of the positive duty cover this conduct` (`the date` 1 3 2025) TRUE TRUE FALSE FALSE TRUE `an agent of the organisation` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS LIST "s 47C(1)(a), (2)(a): sex discrimination in work by the duty holder, its employees, workers or agents"

-- s 47C: victimisation for a harassment complaint
#ASSERT `Which parts of the positive duty cover this conduct` (`the date` 1 3 2025) TRUE TRUE TRUE TRUE FALSE `an employee of the organisation` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE TRUE EQUALS LIST "s 47C(1)(a), (2)(d): victimisation about such conduct by the duty holder, its employees, workers or agents", "s 47C(1)(b), (4)(c): victimisation of its employees or workers about such conduct"

-- s 47C: a contractor's hostile posters
#ASSERT `Which parts of the positive duty cover this conduct` (`the date` 1 3 2025) TRUE TRUE FALSE TRUE FALSE `a worker in the business` TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS LIST "s 47C(1)(a), (2)(c): a hostile workplace environment (s 28M) created by the duty holder, its employees, workers or agents", "s 47C(1)(b), (4)(b): a hostile workplace environment (s 28M) in a workplace where its employees or workers work"

-- s 47C: before commencement, nothing
#ASSERT `Which parts of the positive duty cover this conduct` (`the date` 12 12 2022) TRUE TRUE TRUE TRUE FALSE `an employee of the organisation` TRUE TRUE FALSE TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS EMPTY

-- s 106(1)(b): an employee's s 28B harassment in connection with the employment; no reasonable steps shown
#ASSERT `Is the organisation liable as if it had done what its employee or agent did` (`the date` 1 3 2025) TRUE TRUE TRUE TRUE FALSE `an employee of the organisation` TRUE TRUE FALSE TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE

-- s 106(2): all reasonable steps established
#ASSERT `Is the organisation liable as if it had done what its employee or agent did` (`the date` 1 3 2025) TRUE TRUE TRUE TRUE FALSE `an employee of the organisation` TRUE TRUE FALSE TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS JUST FALSE

-- s 106(1): not in connection with the employment
#ASSERT `Is the organisation liable as if it had done what its employee or agent did` (`the date` 1 3 2025) TRUE TRUE TRUE TRUE FALSE `an employee of the organisation` TRUE TRUE FALSE TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE

-- s 106(1)(a): the agent's discrimination in hiring
#ASSERT `Is the organisation liable as if it had done what its employee or agent did` (`the date` 1 3 2025) TRUE TRUE FALSE FALSE TRUE `an agent of the organisation` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE

-- s 106(1)(b): Division 3 includes s 28M -- an employee's hostile workplace conduct
#ASSERT `Is the organisation liable as if it had done what its employee or agent did` (`the date` 1 3 2025) TRUE TRUE TRUE TRUE FALSE `an employee of the organisation` TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE

-- s 106: a worker who is not an employee or agent -- s 106 does not speak (NOTHING)
#ASSERT `Is the organisation liable as if it had done what its employee or agent did` (`the date` 1 3 2025) TRUE TRUE FALSE TRUE FALSE `a worker in the business` TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS NOTHING

-- s 106: a customer is not the organisation's employee or agent (NOTHING)
#ASSERT `Is the organisation liable as if it had done what its employee or agent did` (`the date` 1 3 2025) TRUE TRUE TRUE TRUE FALSE `someone else` TRUE FALSE TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS NOTHING

-- s 106: victimisation is Division 5, outside s 106(1)
#ASSERT `Is the organisation liable as if it had done what its employee or agent did` (`the date` 1 3 2025) TRUE TRUE TRUE TRUE FALSE `an employee of the organisation` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE TRUE TRUE FALSE EQUALS JUST FALSE

-- s 105: a manager who instructed the harassment
#ASSERT `Is someone who caused or permitted it taken to have done it too` (`the date` 1 3 2025) TRUE TRUE TRUE TRUE FALSE `an employee of the organisation` TRUE TRUE FALSE TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE

-- s 105: no one caused or permitted it
#ASSERT `Is someone who caused or permitted it taken to have done it too` (`the date` 1 3 2025) TRUE TRUE TRUE TRUE FALSE `an employee of the organisation` TRUE TRUE FALSE TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE

-- s 105: victimisation is in Division 5, which s 105 reaches
#ASSERT `Is someone who caused or permitted it taken to have done it too` (`the date` 1 3 2025) TRUE TRUE TRUE TRUE FALSE `an employee of the organisation` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE TRUE TRUE EQUALS JUST TRUE

-- s 105: victimisation where the s 47A(3) defence is proved is not unlawful, so s 105 has nothing to attach to
#ASSERT `Is someone who caused or permitted it taken to have done it too` (`the date` 1 3 2025) TRUE TRUE TRUE TRUE FALSE `an employee of the organisation` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE

-- s 105: the act was not unlawful (no harassment)
#ASSERT `Is someone who caused or permitted it taken to have done it too` (`the date` 1 3 2025) TRUE TRUE TRUE TRUE FALSE `an employee of the organisation` TRUE TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE

-- s 105: harassment outside s 28B may be unlawful under ss 28C-28L, not encoded (NOTHING)
#ASSERT `Is someone who caused or permitted it taken to have done it too` (`the date` 1 3 2025) TRUE TRUE TRUE TRUE FALSE `someone else` FALSE FALSE TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS NOTHING
