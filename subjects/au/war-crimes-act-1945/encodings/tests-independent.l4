IMPORT prelude
IMPORT daydate
IMPORT `wc-rules`

-- Independent tests: expected values from independent-expectations.md, written before reading the L4.

-- scenario 1 base
#ASSERT `the war crime position for` (`War crime case` OF `murder, manslaughter, grievous bodily harm, wounding, rape, indecent assault or abduction, or a variant or complicity in one`, TRUE, `in the course of hostilities in a war`, TRUE, (Date 1 6 1942), TRUE, TRUE, FALSE, TRUE) EQUALS (`War crime position` OF TRUE, TRUE, TRUE, TRUE, TRUE, 0, FALSE)

-- scenario 2 first day 1 Sep 1939
#ASSERT `the war crime position for` (`War crime case` OF `murder, manslaughter, grievous bodily harm, wounding, rape, indecent assault or abduction, or a variant or complicity in one`, TRUE, `in the course of hostilities in a war`, TRUE, (Date 1 9 1939), TRUE, TRUE, FALSE, TRUE) EQUALS (`War crime position` OF TRUE, TRUE, TRUE, TRUE, TRUE, 0, FALSE)

-- scenario 3 31 Aug 1939
#ASSERT `the war crime position for` (`War crime case` OF `murder, manslaughter, grievous bodily harm, wounding, rape, indecent assault or abduction, or a variant or complicity in one`, TRUE, `in the course of hostilities in a war`, TRUE, (Date 31 8 1939), TRUE, TRUE, FALSE, TRUE) EQUALS (`War crime position` OF TRUE, FALSE, FALSE, FALSE, FALSE, 0, FALSE)

-- scenario 4 last day 8 May 1945
#ASSERT `the war crime position for` (`War crime case` OF `murder, manslaughter, grievous bodily harm, wounding, rape, indecent assault or abduction, or a variant or complicity in one`, TRUE, `in the course of hostilities in a war`, TRUE, (Date 8 5 1945), TRUE, TRUE, FALSE, TRUE) EQUALS (`War crime position` OF TRUE, TRUE, TRUE, TRUE, TRUE, 0, FALSE)

-- scenario 5 9 May 1945
#ASSERT `the war crime position for` (`War crime case` OF `murder, manslaughter, grievous bodily harm, wounding, rape, indecent assault or abduction, or a variant or complicity in one`, TRUE, `in the course of hostilities in a war`, TRUE, (Date 9 5 1945), TRUE, TRUE, FALSE, TRUE) EQUALS (`War crime position` OF TRUE, FALSE, FALSE, FALSE, FALSE, 0, FALSE)

-- scenario 6 not in Europe
#ASSERT `the war crime position for` (`War crime case` OF `murder, manslaughter, grievous bodily harm, wounding, rape, indecent assault or abduction, or a variant or complicity in one`, TRUE, `in the course of hostilities in a war`, FALSE, (Date 1 6 1942), TRUE, TRUE, FALSE, TRUE) EQUALS (`War crime position` OF TRUE, FALSE, FALSE, FALSE, FALSE, 0, FALSE)

-- scenario 7 not an offence under Australian law
#ASSERT `the war crime position for` (`War crime case` OF `murder, manslaughter, grievous bodily harm, wounding, rape, indecent assault or abduction, or a variant or complicity in one`, FALSE, `in the course of hostilities in a war`, TRUE, (Date 1 6 1942), TRUE, TRUE, FALSE, TRUE) EQUALS (`War crime position` OF FALSE, FALSE, FALSE, FALSE, FALSE, 0, FALSE)

-- scenario 8 another act
#ASSERT `the war crime position for` (`War crime case` OF `another act`, TRUE, `in the course of hostilities in a war`, TRUE, (Date 1 6 1942), TRUE, TRUE, FALSE, TRUE) EQUALS (`War crime position` OF FALSE, FALSE, FALSE, FALSE, FALSE, 0, FALSE)

-- scenario 9 deportation, occupation, no killing, local law irrelevant
#ASSERT `the war crime position for` (`War crime case` OF `deporting or interning a person in a death camp, slave labour camp or like place, or complicity in it`, FALSE, `in the course of an occupation`, TRUE, (Date 15 3 1943), FALSE, TRUE, FALSE, TRUE) EQUALS (`War crime position` OF TRUE, TRUE, TRUE, TRUE, FALSE, 25, FALSE)

-- scenario 10 complicity in deportation, war policy
#ASSERT `the war crime position for` (`War crime case` OF `deporting or interning a person in a death camp, slave labour camp or like place, or complicity in it`, TRUE, `in pursuing a war or occupation policy`, TRUE, (Date 1 6 1942), FALSE, TRUE, FALSE, TRUE) EQUALS (`War crime position` OF TRUE, TRUE, TRUE, TRUE, FALSE, 25, FALSE)

-- scenario 11 only incidental or remote
#ASSERT `the war crime position for` (`War crime case` OF `murder, manslaughter, grievous bodily harm, wounding, rape, indecent assault or abduction, or a variant or complicity in one`, TRUE, `only incidental or remote`, TRUE, (Date 1 6 1942), TRUE, TRUE, FALSE, TRUE) EQUALS (`War crime position` OF TRUE, FALSE, FALSE, FALSE, FALSE, 0, FALSE)

-- scenario 12 persecution in a country at war
#ASSERT `the war crime position for` (`War crime case` OF `murder, manslaughter, grievous bodily harm, wounding, rape, indecent assault or abduction, or a variant or complicity in one`, TRUE, `in persecution or genocide, in a country at war or occupied`, TRUE, (Date 1 6 1942), TRUE, TRUE, FALSE, TRUE) EQUALS (`War crime position` OF TRUE, TRUE, TRUE, TRUE, TRUE, 0, FALSE)

-- scenario 13 on behalf of a power at war
#ASSERT `the war crime position for` (`War crime case` OF `murder, manslaughter, grievous bodily harm, wounding, rape, indecent assault or abduction, or a variant or complicity in one`, TRUE, `on behalf of a power at war or occupying`, TRUE, (Date 1 6 1942), TRUE, TRUE, FALSE, TRUE) EQUALS (`War crime position` OF TRUE, TRUE, TRUE, TRUE, TRUE, 0, FALSE)

-- scenario 14 neither citizen nor resident
#ASSERT `the war crime position for` (`War crime case` OF `murder, manslaughter, grievous bodily harm, wounding, rape, indecent assault or abduction, or a variant or complicity in one`, TRUE, `in the course of hostilities in a war`, TRUE, (Date 1 6 1942), TRUE, FALSE, FALSE, TRUE) EQUALS (`War crime position` OF TRUE, TRUE, TRUE, FALSE, TRUE, 0, FALSE)

-- scenario 16 wounding, no wilful killing
#ASSERT `the war crime position for` (`War crime case` OF `murder, manslaughter, grievous bodily harm, wounding, rape, indecent assault or abduction, or a variant or complicity in one`, TRUE, `in the course of hostilities in a war`, TRUE, (Date 1 6 1942), FALSE, TRUE, FALSE, TRUE) EQUALS (`War crime position` OF TRUE, TRUE, TRUE, TRUE, FALSE, 25, FALSE)

-- scenario 17 permitted by laws of war, not crime against humanity
#ASSERT `the war crime position for` (`War crime case` OF `murder, manslaughter, grievous bodily harm, wounding, rape, indecent assault or abduction, or a variant or complicity in one`, TRUE, `in the course of hostilities in a war`, TRUE, (Date 1 6 1942), TRUE, TRUE, TRUE, FALSE) EQUALS (`War crime position` OF TRUE, TRUE, TRUE, TRUE, TRUE, 0, TRUE)

-- scenario 18 permitted but crime against humanity
#ASSERT `the war crime position for` (`War crime case` OF `murder, manslaughter, grievous bodily harm, wounding, rape, indecent assault or abduction, or a variant or complicity in one`, TRUE, `in the course of hostilities in a war`, TRUE, (Date 1 6 1942), TRUE, TRUE, TRUE, TRUE) EQUALS (`War crime position` OF TRUE, TRUE, TRUE, TRUE, TRUE, 0, FALSE)

-- scenario 20 attempt to murder, no killing
#ASSERT `the war crime position for` (`War crime case` OF `murder, manslaughter, grievous bodily harm, wounding, rape, indecent assault or abduction, or a variant or complicity in one`, TRUE, `in the course of an occupation`, TRUE, (Date 1 6 1942), FALSE, TRUE, FALSE, TRUE) EQUALS (`War crime position` OF TRUE, TRUE, TRUE, TRUE, FALSE, 25, FALSE)

-- scenario 15: resident only is collapsed into the single citizen-or-resident input; scenario 19: superior orders have no input (always no defence).
