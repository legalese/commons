IMPORT prelude
IMPORT daydate
IMPORT `usnc-rules`

-- Independent tests, written from BRIEF.md, the source text and
-- independent-expectations.md. Expected values are not tuned to the code.
-- Field order of `Station worker`: employed by US Govt at Station, US forces,
-- US citizen or national, agreed-terms with Australian union, ss 9/10 apply,
-- damages on Commonwealth hypothesis, date of injury/disease/death.

§ `Independent tests`

e1 MEANS `Station worker` OF TRUE, FALSE, FALSE, FALSE, TRUE, TRUE, Date 1 1 1970

-- E1 / E2 (instrumentality fed as employed by US Govt, s 3(2)): Act applies, CEC Act applies
#ASSERT `the Act applies to` e1
#ASSERT (`the station position for` e1)'s `this Act applies to me`
#ASSERT (`the station position for` e1)'s `the compensation Act applies to me`
-- E3 / E4: US citizen on agreed terms (registered organisation or WA union)
#ASSERT `the Act applies to` (`Station worker` OF TRUE, FALSE, TRUE, TRUE, FALSE, FALSE, Date 1 1 1970)
-- E5 / E6: US citizen or national on ordinary terms
#ASSERT NOT (`the Act applies to` (`Station worker` OF TRUE, FALSE, TRUE, FALSE, TRUE, TRUE, Date 1 1 1970))
#ASSERT NOT ((`the station position for` (`Station worker` OF TRUE, FALSE, TRUE, FALSE, TRUE, TRUE, Date 1 1 1970))'s `the compensation Act applies to me`)
-- E7: member of the US forces (even if not a US citizen, even on agreed terms)
#ASSERT NOT (`the Act applies to` (`Station worker` OF TRUE, TRUE, FALSE, FALSE, TRUE, TRUE, Date 1 1 1970))
#ASSERT NOT (`the Act applies to` (`Station worker` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, Date 1 1 1970))
-- E8 / E9: not employed by US Govt in connexion with the Station
#ASSERT NOT (`the Act applies to` (`Station worker` OF FALSE, FALSE, FALSE, FALSE, TRUE, TRUE, Date 1 1 1970))
-- E10: s 6(1) damages
#ASSERT `damages are recoverable for` e1
#ASSERT (`the station position for` e1)'s `damages recoverable from the Commonwealth`
-- E11: ss 9/10 do not apply
#ASSERT NOT (`damages are recoverable for` (`Station worker` OF TRUE, FALSE, FALSE, FALSE, FALSE, TRUE, Date 1 1 1970))
-- E12: no damages on the Commonwealth-employment hypothesis
#ASSERT NOT (`damages are recoverable for` (`Station worker` OF TRUE, FALSE, FALSE, FALSE, TRUE, FALSE, Date 1 1 1970))
-- E14: commencement day 24 June 1968
#ASSERT `damages are recoverable for` (`Station worker` OF TRUE, FALSE, FALSE, FALSE, TRUE, TRUE, Date 24 6 1968)
-- E15: 29 Aug 1966, first day of s 6(2)
#ASSERT `damages are recoverable for` (`Station worker` OF TRUE, FALSE, FALSE, FALSE, TRUE, TRUE, Date 29 8 1966)
-- E16: 28 Aug 1966, outside both windows
#ASSERT NOT (`damages are recoverable for` (`Station worker` OF TRUE, FALSE, FALSE, FALSE, TRUE, TRUE, Date 28 8 1966))
-- E17: 23 June 1968, last day of s 6(2)
#ASSERT `damages are recoverable for` (`Station worker` OF TRUE, FALSE, FALSE, FALSE, TRUE, TRUE, Date 23 6 1968)
-- E18: Act does not apply -> no damages, even with every other limb met
#ASSERT NOT (`damages are recoverable for` (`Station worker` OF TRUE, FALSE, TRUE, FALSE, TRUE, TRUE, Date 1 1 1970))
-- E18 variant: US forces member -> no damages
#ASSERT NOT (`damages are recoverable for` (`Station worker` OF TRUE, TRUE, FALSE, FALSE, TRUE, TRUE, Date 1 1 1970))
-- s 6(1) for a recent injury (no upper bound in the Act)
#ASSERT `damages are recoverable for` (`Station worker` OF TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, Date 1 7 2020)
