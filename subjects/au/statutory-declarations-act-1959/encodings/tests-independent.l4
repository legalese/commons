IMPORT prelude
IMPORT `sd-rules`

-- Independent tests from the source text and BRIEF.md only (see
-- independent-expectations.md). Expected values were not adjusted to the code.

`obs` MEANS `signed under the observation of a prescribed person`
`plat` MEANS `completed and signed on an approved online platform`
`hand` MEANS `by hand on a physical form`
`elec` MEANS `by electronic means on an electronic form`
`cthLaw` MEANS `for the purposes of, or a matter under, a Commonwealth or Territory law`

GIVEN form IS A BOOLEAN
      how IS A `How made`
      sig IS A `Signature`
      ident IS A BOOLEAN
      reliable IS A BOOLEAN
      seen IS A `Observation`
      ppSigned IS A BOOLEAN
      ppCopy IS A BOOLEAN
      idv IS A BOOLEAN
      platInfo IS A BOOLEAN
      use IS A `Use`
      contrary IS A BOOLEAN
      false IS A BOOLEAN
GIVETH A `Declaration position`
`pos` form how sig ident reliable seen ppSigned ppCopy idv platInfo use contrary false MEANS
    `the declaration position for`
        (`Declaration case` OF form, how, sig, ident, reliable, seen, ppSigned, ppCopy, idv, platInfo, use, contrary, false)

GIVEN p IS A `Declaration position`
GIVETH A BOOLEAN
`valid` p MEANS p's `my declaration is validly made`

-- Validity
-- V1
#ASSERT `valid` (`pos` TRUE `obs` `hand` TRUE TRUE `in person` TRUE FALSE FALSE FALSE `cthLaw` FALSE FALSE) EQUALS TRUE
-- V2
#ASSERT `valid` (`pos` FALSE `obs` `hand` TRUE TRUE `in person` TRUE FALSE FALSE FALSE `cthLaw` FALSE FALSE) EQUALS FALSE
-- V3
#ASSERT `valid` (`pos` TRUE `obs` `hand` TRUE TRUE `by video link` FALSE TRUE FALSE FALSE `cthLaw` FALSE FALSE) EQUALS TRUE
-- V4
#ASSERT `valid` (`pos` TRUE `obs` `hand` TRUE TRUE `in person` FALSE TRUE FALSE FALSE `cthLaw` FALSE FALSE) EQUALS FALSE
-- V5
#ASSERT `valid` (`pos` TRUE `obs` `hand` TRUE TRUE `in person` FALSE FALSE FALSE FALSE `cthLaw` FALSE FALSE) EQUALS FALSE
-- V6
#ASSERT `valid` (`pos` TRUE `plat` `elec` TRUE TRUE `in person` FALSE FALSE TRUE TRUE `cthLaw` FALSE FALSE) EQUALS TRUE
-- V7
#ASSERT `valid` (`pos` TRUE `plat` `elec` TRUE TRUE `in person` FALSE FALSE FALSE TRUE `cthLaw` FALSE FALSE) EQUALS FALSE
-- V8
#ASSERT `valid` (`pos` TRUE `plat` `elec` TRUE TRUE `in person` FALSE FALSE TRUE FALSE `cthLaw` FALSE FALSE) EQUALS FALSE
-- V9
#ASSERT `valid` (`pos` FALSE `plat` `elec` TRUE TRUE `in person` FALSE FALSE TRUE TRUE `cthLaw` FALSE FALSE) EQUALS FALSE
-- V10
#ASSERT `valid` (`pos` TRUE `neither` `hand` TRUE TRUE `in person` TRUE FALSE TRUE TRUE `cthLaw` FALSE FALSE) EQUALS FALSE
-- V11
#ASSERT `valid` (`pos` TRUE `obs` `hand` FALSE TRUE `in person` TRUE FALSE FALSE FALSE `cthLaw` FALSE FALSE) EQUALS FALSE
-- V12
#ASSERT `valid` (`pos` TRUE `obs` `hand` TRUE FALSE `in person` TRUE FALSE FALSE FALSE `cthLaw` FALSE FALSE) EQUALS FALSE
-- V13 (proven in fact: the single input is TRUE)
#ASSERT `valid` (`pos` TRUE `obs` `elec` TRUE TRUE `by video link` TRUE FALSE FALSE FALSE `cthLaw` FALSE FALSE) EQUALS TRUE
-- V14
#ASSERT `valid` (`pos` TRUE `obs` `otherwise` TRUE TRUE `in person` TRUE FALSE FALSE FALSE `cthLaw` FALSE FALSE) EQUALS FALSE
-- V15
#ASSERT `valid` (`pos` TRUE `obs` `elec` TRUE TRUE `by video link` TRUE FALSE FALSE FALSE `cthLaw` FALSE FALSE) EQUALS TRUE

-- Use, s 6
-- U1
#ASSERT (`pos` TRUE `obs` `hand` TRUE TRUE `in person` TRUE FALSE FALSE FALSE `cthLaw` FALSE FALSE)'s `this Act authorises the use` EQUALS JUST TRUE
-- U2
#ASSERT (`pos` TRUE `obs` `hand` TRUE TRUE `in person` TRUE FALSE FALSE FALSE `cthLaw` TRUE FALSE)'s `this Act authorises the use` EQUALS JUST FALSE
-- U3
#ASSERT (`pos` TRUE `obs` `hand` TRUE TRUE `in person` TRUE FALSE FALSE FALSE `in the administration of a Commonwealth Department` TRUE FALSE)'s `this Act authorises the use` EQUALS JUST TRUE
-- U4: s 6(3) does not authorise use as evidence
#ASSERT (`pos` TRUE `obs` `hand` TRUE TRUE `in person` TRUE FALSE FALSE FALSE `as evidence in a judicial proceeding` FALSE FALSE)'s `this Act authorises the use` EQUALS JUST FALSE
-- U5: s 6(2) does not reach another use
#ASSERT (`pos` TRUE `obs` `hand` TRUE TRUE `in person` TRUE FALSE FALSE FALSE `another use` FALSE FALSE)'s `this Act authorises the use` EQUALS JUST FALSE
-- U6
#ASSERT (`pos` FALSE `obs` `hand` TRUE TRUE `in person` TRUE FALSE FALSE FALSE `cthLaw` FALSE FALSE)'s `this Act authorises the use` EQUALS JUST FALSE

-- False statement, s 11
-- F1
#ASSERT (`pos` TRUE `obs` `hand` TRUE TRUE `in person` TRUE FALSE FALSE FALSE `cthLaw` FALSE TRUE)'s `I commit an offence under s 11` EQUALS TRUE
#ASSERT (`pos` TRUE `obs` `hand` TRUE TRUE `in person` TRUE FALSE FALSE FALSE `cthLaw` FALSE TRUE)'s `maximum imprisonment in years` EQUALS 4
-- F2
#ASSERT (`pos` TRUE `obs` `hand` TRUE TRUE `in person` TRUE FALSE FALSE FALSE `cthLaw` FALSE FALSE)'s `I commit an offence under s 11` EQUALS FALSE
#ASSERT (`pos` TRUE `obs` `hand` TRUE TRUE `in person` TRUE FALSE FALSE FALSE `cthLaw` FALSE FALSE)'s `maximum imprisonment in years` EQUALS 0
