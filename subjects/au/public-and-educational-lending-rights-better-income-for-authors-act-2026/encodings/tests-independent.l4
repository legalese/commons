IMPORT prelude
IMPORT daydate
IMPORT `plr-rules`

-- 1 s 5 citizen author
#ASSERT ((`the lending position for` (`Lending case` OF `an Australian citizen`, TRUE, `author of the whole or a part`, `not a publisher`, `a delegate of the Secretary`, (Date 1 7 2027), NOTHING, NOTHING, NOTHING, NOTHING))'s `I am an Australian creator under s 5`) EQUALS TRUE

-- 2 s 5 PR illustrator/translator
#ASSERT ((`the lending position for` (`Lending case` OF `a permanent resident of Australia`, TRUE, `illustrator or translator of the whole or a part`, `not a publisher`, `a delegate of the Secretary`, (Date 1 7 2027), NOTHING, NOTHING, NOTHING, NOTHING))'s `I am an Australian creator under s 5`) EQUALS TRUE

-- 3 s 5 significant original content
#ASSERT ((`the lending position for` (`Lending case` OF `an Australian citizen`, TRUE, `contributor of a significant proportion of original content`, `not a publisher`, `a delegate of the Secretary`, (Date 1 7 2027), NOTHING, NOTHING, NOTHING, NOTHING))'s `I am an Australian creator under s 5`) EQUALS TRUE

-- 4 no contribution
#ASSERT ((`the lending position for` (`Lending case` OF `an Australian citizen`, TRUE, `none of these`, `not a publisher`, `a delegate of the Secretary`, (Date 1 7 2027), NOTHING, NOTHING, NOTHING, NOTHING))'s `I am an Australian creator under s 5`) EQUALS FALSE

-- 5 neither citizen nor PR
#ASSERT ((`the lending position for` (`Lending case` OF `neither`, TRUE, `author of the whole or a part`, `not a publisher`, `a delegate of the Secretary`, (Date 1 7 2027), NOTHING, NOTHING, NOTHING, NOTHING))'s `I am an Australian creator under s 5`) EQUALS FALSE

-- 6 not an individual
#ASSERT ((`the lending position for` (`Lending case` OF `an Australian citizen`, FALSE, `author of the whole or a part`, `not a publisher`, `a delegate of the Secretary`, (Date 1 7 2027), NOTHING, NOTHING, NOTHING, NOTHING))'s `I am an Australian creator under s 5`) EQUALS FALSE

-- 7 s 5 publisher (a)
#ASSERT ((`the lending position for` (`Lending case` OF `neither`, FALSE, `none of these`, `a company incorporated in Australia publishing books in Australia`, `a delegate of the Secretary`, (Date 1 7 2027), NOTHING, NOTHING, NOTHING, NOTHING))'s `I am an Australian publisher under s 5`) EQUALS TRUE

-- 8 s 5 publisher (b)
#ASSERT ((`the lending position for` (`Lending case` OF `an Australian citizen`, FALSE, `author of the whole or a part`, `a registered charity publishing books in Australia, meeting any rules`, `a delegate of the Secretary`, (Date 1 7 2027), NOTHING, NOTHING, NOTHING, NOTHING))'s `I am an Australian publisher under s 5`) EQUALS TRUE

-- 9 s 5 publisher (c) creator self-publishing
#ASSERT ((`the lending position for` (`Lending case` OF `an Australian citizen`, TRUE, `author of the whole or a part`, `an Australian creator who also publishes the book in Australia`, `a delegate of the Secretary`, (Date 1 7 2027), NOTHING, NOTHING, NOTHING, NOTHING))'s `I am an Australian publisher under s 5`) EQUALS TRUE

-- 10 s 5 publisher (c) non-Australian self-publisher
#ASSERT ((`the lending position for` (`Lending case` OF `neither`, TRUE, `author of the whole or a part`, `an Australian creator who also publishes the book in Australia`, `a delegate of the Secretary`, (Date 1 7 2027), NOTHING, NOTHING, NOTHING, NOTHING))'s `I am an Australian publisher under s 5`) EQUALS FALSE

-- 11 s 5 publisher (d)
#ASSERT ((`the lending position for` (`Lending case` OF `an Australian citizen`, TRUE, `author of the whole or a part`, `another person or body meeting the rules`, `a delegate of the Secretary`, (Date 1 7 2027), NOTHING, NOTHING, NOTHING, NOTHING))'s `I am an Australian publisher under s 5`) EQUALS TRUE

-- 11b not a publisher
#ASSERT ((`the lending position for` (`Lending case` OF `an Australian citizen`, TRUE, `author of the whole or a part`, `not a publisher`, `a delegate of the Secretary`, (Date 1 7 2027), NOTHING, NOTHING, NOTHING, NOTHING))'s `I am an Australian publisher under s 5`) EQUALS FALSE

-- 12 s 33(2)(a): notified 1 Jul 2027
#ASSERT ((`the lending position for` (`Lending case` OF `an Australian citizen`, TRUE, `author of the whole or a part`, `not a publisher`, `a delegate of the Secretary`, (Date 1 7 2027), NOTHING, NOTHING, NOTHING, NOTHING))'s `the last day to request reconsideration`) EQUALS JUST (Date 28 7 2027)

-- 13 s 33(2)(a): notified 15 Feb 2028
#ASSERT ((`the lending position for` (`Lending case` OF `an Australian citizen`, TRUE, `author of the whole or a part`, `not a publisher`, `a delegate of the Secretary`, (Date 15 2 2028), NOTHING, NOTHING, NOTHING, NOTHING))'s `the last day to request reconsideration`) EQUALS JUST (Date 13 3 2028)

-- 14 s 33(2)(b): longer period to 29 Aug 2027
#ASSERT ((`the lending position for` (`Lending case` OF `an Australian citizen`, TRUE, `author of the whole or a part`, `not a publisher`, `a delegate of the Secretary`, (Date 1 7 2027), (JUST (Date 29 8 2027)), NOTHING, NOTHING, NOTHING))'s `the last day to request reconsideration`) EQUALS JUST (Date 29 8 2027)

-- 15/17 s 33(5): received 1 Aug 2027 -> decide by 29 Oct 2027
#ASSERT ((`the lending position for` (`Lending case` OF `an Australian citizen`, TRUE, `author of the whole or a part`, `not a publisher`, `a delegate of the Secretary`, (Date 1 7 2027), NOTHING, (JUST (Date 1 8 2027)), NOTHING, NOTHING))'s `the last day for the Secretary's reconsideration`) EQUALS JUST (Date 29 10 2027)

-- 15b s 33(5): received 28 Jul 2027 (last day) -> 25 Oct 2027
#ASSERT ((`the lending position for` (`Lending case` OF `an Australian citizen`, TRUE, `author of the whole or a part`, `not a publisher`, `a delegate of the Secretary`, (Date 1 7 2027), NOTHING, (JUST (Date 28 7 2027)), NOTHING, NOTHING))'s `the last day for the Secretary's reconsideration`) EQUALS JUST (Date 25 10 2027)

-- 18 s 33(8): notified on last day -> not deemed
#ASSERT ((`the lending position for` (`Lending case` OF `an Australian citizen`, TRUE, `author of the whole or a part`, `not a publisher`, `a delegate of the Secretary`, (Date 1 7 2027), NOTHING, (JUST (Date 1 8 2027)), (JUST (Date 29 10 2027)), NOTHING))'s `the decision is taken to be affirmed under s 33(8)`) EQUALS FALSE

-- 19 s 33(8): notified day after -> deemed
#ASSERT ((`the lending position for` (`Lending case` OF `an Australian citizen`, TRUE, `author of the whole or a part`, `not a publisher`, `a delegate of the Secretary`, (Date 1 7 2027), NOTHING, (JUST (Date 1 8 2027)), (JUST (Date 30 10 2027)), NOTHING))'s `the decision is taken to be affirmed under s 33(8)`) EQUALS TRUE

-- 19b s 33(8): never notified -> deemed
#ASSERT ((`the lending position for` (`Lending case` OF `an Australian citizen`, TRUE, `author of the whole or a part`, `not a publisher`, `a delegate of the Secretary`, (Date 1 7 2027), NOTHING, (JUST (Date 1 8 2027)), NOTHING, NOTHING))'s `the decision is taken to be affirmed under s 33(8)`) EQUALS TRUE

-- 20 s 34(1)(b): reconsideration made
#ASSERT ((`the lending position for` (`Lending case` OF `an Australian citizen`, TRUE, `author of the whole or a part`, `not a publisher`, `a delegate of the Secretary`, (Date 1 7 2027), NOTHING, (JUST (Date 1 7 2027)), (JUST (Date 1 9 2027)), NOTHING))'s `I may apply to the Administrative Review Tribunal`) EQUALS TRUE

-- 20b s 34(1)(b): deemed affirmance
#ASSERT ((`the lending position for` (`Lending case` OF `an Australian citizen`, TRUE, `author of the whole or a part`, `not a publisher`, `a delegate of the Secretary`, (Date 1 7 2027), NOTHING, (JUST (Date 1 7 2027)), NOTHING, NOTHING))'s `I may apply to the Administrative Review Tribunal`) EQUALS TRUE

-- 20c no request yet -> no ART for delegate decision
#ASSERT ((`the lending position for` (`Lending case` OF `an Australian citizen`, TRUE, `author of the whole or a part`, `not a publisher`, `a delegate of the Secretary`, (Date 1 7 2027), NOTHING, NOTHING, NOTHING, NOTHING))'s `I may apply to the Administrative Review Tribunal`) EQUALS FALSE

-- 16/21 s 33(2),(4),(8): late request (29 Jul 2027) -> no duty to reconsider, no deemed affirmance
#ASSERT ((`the lending position for` (`Lending case` OF `an Australian citizen`, TRUE, `author of the whole or a part`, `not a publisher`, `a delegate of the Secretary`, (Date 1 7 2027), NOTHING, (JUST (Date 29 7 2027)), NOTHING, NOTHING))'s `the decision is taken to be affirmed under s 33(8)`) EQUALS FALSE

-- 21 s 34(1): late request, never answered -> no ART
#ASSERT ((`the lending position for` (`Lending case` OF `an Australian citizen`, TRUE, `author of the whole or a part`, `not a publisher`, `a delegate of the Secretary`, (Date 1 7 2027), NOTHING, (JUST (Date 29 7 2027)), NOTHING, NOTHING))'s `I may apply to the Administrative Review Tribunal`) EQUALS FALSE

-- 22 s 34(1)(a): Secretary personally -> ART
#ASSERT ((`the lending position for` (`Lending case` OF `an Australian citizen`, TRUE, `author of the whole or a part`, `not a publisher`, `the Secretary personally`, (Date 1 7 2027), NOTHING, NOTHING, NOTHING, NOTHING))'s `I may apply to the Administrative Review Tribunal`) EQUALS TRUE

-- 22 s 33(1): Secretary personally -> no reconsideration deadline
#ASSERT ((`the lending position for` (`Lending case` OF `an Australian citizen`, TRUE, `author of the whole or a part`, `not a publisher`, `the Secretary personally`, (Date 1 7 2027), NOTHING, NOTHING, NOTHING, NOTHING))'s `the last day to request reconsideration`) EQUALS NOTHING

-- 23 s 38(2)(c): notice 10 Jan 2028
#ASSERT ((`the lending position for` (`Lending case` OF `an Australian citizen`, TRUE, `author of the whole or a part`, `not a publisher`, `a delegate of the Secretary`, (Date 1 7 2027), NOTHING, NOTHING, NOTHING, (JUST (Date 10 1 2028))))'s `the earliest last day an overpayment notice may set`) EQUALS JUST (Date 6 2 2028)

-- 24 s 38(2)(c): notice 1 Feb 2028
#ASSERT ((`the lending position for` (`Lending case` OF `an Australian citizen`, TRUE, `author of the whole or a part`, `not a publisher`, `a delegate of the Secretary`, (Date 1 7 2027), NOTHING, NOTHING, NOTHING, (JUST (Date 1 2 2028))))'s `the earliest last day an overpayment notice may set`) EQUALS JUST (Date 28 2 2028)
