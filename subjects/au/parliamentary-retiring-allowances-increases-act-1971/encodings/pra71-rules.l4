IMPORT prelude
IMPORT daydate

-- Parliamentary Retiring Allowances (Increases) Act 1971 (Cth). Source:
-- ../registers/source-bundle/C1971A00075.txt. Seat: the pensioner or widow.

§ `Nouns`

DECLARE `Pension class 1971` IS ONE OF
    `a weekly pensioner under s 3`
    `an annual pensioner under s 4`
    `an annual pensioner under s 5`
    `an office-holder under s 6`
    `an office-holder or widow under s 7`
    `a widow under s 3(2)`
    `a widow under s 4(2)`
    `a widow under s 5(2)`
    `a widow under s 6(2)`
    `a former Prime Minister's widow under s 8`
    `none of these`

DECLARE `Pensioner 1971` HAS
    `class`                                             IS A `Pension class 1971`
    -- weekly for ss 3, 6; annual for ss 4, 5, 7, 8
    `pension`                                           IS A NUMBER
    -- s 6(2): the husband's pension, for the table in s 6(1)
    `husband's pension`                                 IS A NUMBER
    -- s 12
    `first fortnightly payment after 1 October 1971`    IS A DATE

DECLARE `Increase position 1971` HAS
    `the increase`                                      IS A MAYBE NUMBER
    `the widow's pension`                               IS A MAYBE NUMBER
    `from`                                              IS A MAYBE DATE

§ `Rules`

@ref s 3(1)
GIVEN a IS A NUMBER
GIVETH A MAYBE NUMBER
`the s 3 increase on` a MEANS
    BRANCH
        IF a EQUALS 48.16 THEN JUST 13.98
        IF a EQUALS 56.89 THEN JUST 16.78
        IF a EQUALS 57.79 THEN JUST 16.78
        IF a EQUALS 63.79 THEN JUST 16.78
        OTHERWISE              NOTHING

@ref s 4(1)
GIVEN a IS A NUMBER
GIVETH A MAYBE NUMBER
`the s 4 increase on` a MEANS
    BRANCH
        IF a EQUALS 2729.17 THEN JUST 729.16
        IF a EQUALS 3275    THEN JUST 875
        IF a EQUALS 3587.86 THEN JUST 875
        OTHERWISE                NOTHING

@ref s 5(1)
GIVEN a IS A NUMBER
GIVETH A MAYBE NUMBER
`the s 5 increase on` a MEANS
    BRANCH
        IF a EQUALS 2916.67 THEN JUST 729.16
        IF a EQUALS 3500    THEN JUST 875
        IF a EQUALS 3812.86 THEN JUST 875
        OTHERWISE                NOTHING

@ref s 6(1)
GIVEN a IS A NUMBER
GIVETH A MAYBE NUMBER
`the s 6 increase on` a MEANS
    BRANCH
        IF a EQUALS 15    THEN JUST 7.12
        IF a EQUALS 18    THEN JUST 8.54
        IF a EQUALS 20    THEN JUST 10.33
        IF a EQUALS 23.33 THEN JUST 11.36
        IF a EQUALS 28    THEN JUST 13.63
        OTHERWISE              NOTHING

@ref s 7
GIVEN a IS A NUMBER
GIVETH A MAYBE NUMBER
`the s 7 increase on` a MEANS
    BRANCH
        IF a EQUALS 1050 THEN JUST 183.75
        IF a EQUALS 1260 THEN JUST 220.5
        IF a EQUALS 2500 THEN JUST 437.5
        IF a EQUALS 3000 THEN JUST 525
        OTHERWISE             NOTHING

@ref ss 3-8, 12
@export default What does the Parliamentary Retiring Allowances (Increases) Act 1971 (Cth) give me? The increase from the table for my class of pension (ss 3-7), or, for a widow, her fixed pension ($62.14 a week under s 3(2), $3,458.33 a year under s 4(2), $3,645.83 a year under s 5(2)), five-sixths of her husband's s 6 increase (s 6(2)), or half again of a former Prime Minister's widow's pension (s 8); from the first fortnightly payment after 1 October 1971 (s 12). NOTHING for an amount not in the tables or a person outside these classes. DRAFT, not reviewed by an Australian lawyer.
GIVEN p IS A `Pensioner 1971`  @desc The class, the pension (and the husband's, for s 6(2)), and the first fortnightly payment after commencement
GIVETH A `Increase position 1971`
`the increase position for` p MEANS
    `Increase position 1971` WITH
        `the increase`                                  IS increase
        `the widow's pension`                           IS
            CONSIDER p's `class`
            WHEN `a widow under s 3(2)` THEN JUST 62.14
            WHEN `a widow under s 4(2)` THEN JUST 3458.33
            WHEN `a widow under s 5(2)` THEN JUST 3645.83
            OTHERWISE NOTHING
        `from`                                          IS
            CONSIDER increase
            WHEN NOTHING THEN NOTHING
            WHEN JUST x  THEN JUST (p's `first fortnightly payment after 1 October 1971`)
    WHERE
        a MEANS p's `pension`
        increase MEANS
            CONSIDER p's `class`
            WHEN `a weekly pensioner under s 3`             THEN `the s 3 increase on` a
            WHEN `an annual pensioner under s 4`            THEN `the s 4 increase on` a
            WHEN `an annual pensioner under s 5`            THEN `the s 5 increase on` a
            WHEN `an office-holder under s 6`               THEN `the s 6 increase on` a
            WHEN `an office-holder or widow under s 7`      THEN `the s 7 increase on` a
            WHEN `a widow under s 6(2)`                     THEN
                CONSIDER `the s 6 increase on` (p's `husband's pension`)
                WHEN NOTHING THEN NOTHING
                WHEN JUST h  THEN JUST (5/6 TIMES h)
            WHEN `a former Prime Minister's widow under s 8` THEN JUST (a DIVIDED BY 2)
            OTHERWISE NOTHING
