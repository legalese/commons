IMPORT prelude
IMPORT daydate
IMPORT `spi61-rules`

§ `Independent tests`

-- Written from independent-expectations.md. Field order of `Pension increase case`:
-- adjusted unit entitlement, actual unit entitlement, actual unit contribution,
-- prescribed amount case, fraction for (c)/(d), 1957 increase, widow, excluded,
-- first fortnightly payment after commencement.

standardSix MEANS `Pension increase case` OF 10, 6, 6, `the standard case`, 0, 0, FALSE, FALSE, Date 7 12 1961

-- B1 standard case, 4 additional units
#ASSERT `the prescribed amount for` standardSix EQUALS 32.5
#ASSERT `my annual pension increase for` standardSix EQUALS 130
-- B2 adjusted equals actual
#ASSERT `my annual pension increase for` (`Pension increase case` OF 6, 6, 6, `the standard case`, 0, 0, FALSE, FALSE, Date 7 12 1961) EQUALS 0
-- B3 adjusted below actual
#ASSERT `my annual pension increase for` (`Pension increase case` OF 5, 6, 6, `the standard case`, 0, 0, FALSE, FALSE, Date 7 12 1961) EQUALS 0
-- B4 paragraph (b): 4 of 6 units
#ASSERT `the prescribed amount for` (`Pension increase case` OF 10, 6, 4, `contributed for fewer units than entitled`, 0, 0, FALSE, FALSE, Date 7 12 1961) EQUALS 65/3
#ASSERT `my annual pension increase for` (`Pension increase case` OF 10, 6, 4, `contributed for fewer units than entitled`, 0, 0, FALSE, FALSE, Date 7 12 1961) EQUALS 260/3
-- B5 s 4(2): less a 50 pound 1957 increase
#ASSERT `my annual pension increase for` (`Pension increase case` OF 10, 6, 6, `the standard case`, 0, 50, FALSE, FALSE, Date 7 12 1961) EQUALS 80
-- B6 1957 increase larger than the increase: nil, not negative
#ASSERT `my annual pension increase for` (`Pension increase case` OF 10, 6, 6, `the standard case`, 0, 200, FALSE, FALSE, Date 7 12 1961) EQUALS 0
-- B7 1957 increase exactly equal
#ASSERT `my annual pension increase for` (`Pension increase case` OF 10, 6, 6, `the standard case`, 0, 130, FALSE, FALSE, Date 7 12 1961) EQUALS 0
-- B8 widow: five-eighths of 130
#ASSERT `my annual pension increase for` (`Pension increase case` OF 10, 6, 6, `the standard case`, 0, 0, TRUE, FALSE, Date 7 12 1961) EQUALS 325/4
-- B9-B11 excluded pension (child's, s 58, s 57 without State Fund contributions)
#ASSERT `my annual pension increase for` (`Pension increase case` OF 10, 6, 6, `the standard case`, 0, 0, FALSE, TRUE, Date 7 12 1961) EQUALS 0
-- excluded widow's pension (e.g. s 57) also nil
#ASSERT `my annual pension increase for` (`Pension increase case` OF 10, 6, 6, `the standard case`, 0, 0, TRUE, TRUE, Date 7 12 1961) EQUALS 0
-- B12 paragraph (c), fraction 1/2
#ASSERT `the prescribed amount for` (`Pension increase case` OF 10, 6, 3, `a case under paragraph (c) or (d)`, 1/2, 0, FALSE, FALSE, Date 7 12 1961) EQUALS 65/4
#ASSERT `my annual pension increase for` (`Pension increase case` OF 10, 6, 3, `a case under paragraph (c) or (d)`, 1/2, 0, FALSE, FALSE, Date 7 12 1961) EQUALS 65
-- B13 paragraph (d), fraction 3/4 of the (a) amount
#ASSERT `the prescribed amount for` (`Pension increase case` OF 10, 6, 6, `a case under paragraph (c) or (d)`, 3/4, 0, FALSE, FALSE, Date 7 12 1961) EQUALS 195/8
#ASSERT `my annual pension increase for` (`Pension increase case` OF 10, 6, 6, `a case under paragraph (c) or (d)`, 3/4, 0, FALSE, FALSE, Date 7 12 1961) EQUALS 195/2
-- B14 s 7(1): effect from the first fortnightly payment after commencement
#ASSERT standardSix's `first fortnightly payment after commencement` EQUALS Date 7 12 1961
-- B15 s 52 applied, no neglect, contribution 4 < entitlement 6: paragraph (a), 32.5
#ASSERT `the prescribed amount for` (`Pension increase case` OF 10, 6, 4, `the standard case`, 0, 0, FALSE, FALSE, Date 7 12 1961) EQUALS 32.5
#ASSERT `my annual pension increase for` (`Pension increase case` OF 10, 6, 4, `the standard case`, 0, 0, FALSE, FALSE, Date 7 12 1961) EQUALS 130
-- fractional units: adjusted 7.5, actual 6, standard: 1.5 x 32.5
#ASSERT `my annual pension increase for` (`Pension increase case` OF 15/2, 6, 6, `the standard case`, 0, 0, FALSE, FALSE, Date 7 12 1961) EQUALS 195/4
