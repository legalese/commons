§ `ss 5, 7, 8 -- worker, PCBU, workplace (d044: Jarrah's employee; k085, d080: Jake on the stair)`

#ASSERT `Am I a worker` TRUE FALSE
#ASSERT NOT `Am I a worker` FALSE FALSE

#ASSERT `Does this person conduct a business or undertaking` `Sentinel Security Services, Jake's employer`
#ASSERT NOT `Does this person conduct a business or undertaking` `a supervisor employed by Sentinel`
#ASSERT NOT `Does this person conduct a business or undertaking` `a volunteer group that employs no one`
#ASSERT `Does this person conduct a business or undertaking` `a volunteer group that employs a coordinator`

#ASSERT `Is this place a workplace` FALSE TRUE

§ `ss 19, 20, 21 -- who owed me a duty (k085, d080: Sentinel, the tenant, the building manager; d044)`

#ASSERT `Does this person owe me the primary duty of care` `Sentinel Security Services, Jake's employer` TRUE TRUE FALSE TRUE
#ASSERT NOT `Does this person owe me the primary duty of care` `Jarrah Legal Technologies, the tenant` TRUE FALSE FALSE TRUE
#ASSERT `Does this person owe me the primary duty of care` `Jarrah Legal Technologies, the tenant` TRUE TRUE FALSE TRUE
#ASSERT NOT `Does this person owe me the primary duty of care` `a supervisor employed by Sentinel` TRUE FALSE TRUE TRUE

#ASSERT `Must this person ensure its work does not put me at risk` `Jarrah Legal Technologies, the tenant` TRUE

#ASSERT `Must my employer maintain my accommodation` TRUE TRUE

#ASSERT `Does this person owe me the workplace duty` `Jarrah Legal Technologies, the tenant` `the tenant controls the stairwell under its lease` TRUE
#ASSERT NOT `Does this person owe me the workplace duty` `Jarrah Legal Technologies, the tenant` `the tenant has no control of the stairwell` TRUE
#ASSERT `Does this person owe me the workplace duty` `the tower's building manager` `the manager controls the common areas` TRUE
#ASSERT NOT `Does this person owe me the workplace duty` `the tower's building manager` `a householder's own home` TRUE

#ASSERT `Does this person owe me the fixtures duty` `the tower's building manager` `the manager controls the common areas` TRUE

