IMPORT prelude
IMPORT `wcimr-dates`
IMPORT `wcimr-claims`

-- Workers Compensation and Injury Management Regulations 2024 (WA) -- worked cases for the claim questions
-- (wcimr-claims.l4). Every expected value was worked by hand from the deposited text; none was copied from the encoding's
-- output. The facts are illustrative. Each assertion is a claim about the ENCODING, not about the law.
-- BASELINE ENCODING. Not for public use as advice. See NOTES.md.

§ `cases`

`d` MEANS `the calendar date`

§§ `regs 19, 21(6), 22`

-- Received 1 March 2026: 120 days beginning that day end 28 June; the deemed day is 29 June 2026.
#ASSERT `my deemed liability acceptance day` (`d` 1 3 2026) FALSE (`d` 1 1 2000) EQUALS `d` 29 6 2026
-- Amended into an incapacity claim on 10 April 2026 and deferred: 8 August 2026.
#ASSERT `my deemed liability acceptance day` (`d` 1 3 2026) TRUE (`d` 10 4 2026) EQUALS `d` 8 8 2026
-- 28 days beginning 1 March end 28 March; the provisional payments day is 29 March 2026.
#ASSERT `my provisional payments day` (`d` 1 3 2026) FALSE (`d` 1 1 2000) EQUALS `d` 29 3 2026
#ASSERT `my provisional payments day` (`d` 1 3 2026) TRUE (`d` 10 4 2026) EQUALS `d` 8 5 2026

§§ `reg 20 -- notice of remunerated work`

-- 7 days beginning on the later of 10 May (started) and 1 May (told) end 16 May 2026.
#ASSERT `By when must I give notice of remunerated work` (`d` 10 5 2026) (`d` 1 5 2026) EQUALS `d` 16 5 2026
#ASSERT `By when must I give notice of remunerated work` (`d` 1 5 2026) (`d` 20 5 2026) EQUALS `d` 26 5 2026
-- Arguments: told, day told, day started, given, day given, today.
#ASSERT `Have I given notice of remunerated work in time` TRUE (`d` 1 5 2026) (`d` 10 5 2026) TRUE (`d` 16 5 2026) (`d` 1 6 2026) EQUALS `the duty was kept`
#ASSERT `Have I given notice of remunerated work in time` TRUE (`d` 1 5 2026) (`d` 10 5 2026) TRUE (`d` 17 5 2026) (`d` 1 6 2026) EQUALS `the duty was not kept`
#ASSERT `Have I given notice of remunerated work in time` TRUE (`d` 1 5 2026) (`d` 10 5 2026) FALSE (`d` 1 1 2000) (`d` 16 5 2026) EQUALS `the duty is still open`
#ASSERT `Have I given notice of remunerated work in time` TRUE (`d` 1 5 2026) (`d` 10 5 2026) FALSE (`d` 1 1 2000) (`d` 17 5 2026) EQUALS `the duty was not kept`
-- s 32(5): never told of the duty, so it does not arise.
#ASSERT `Have I given notice of remunerated work in time` FALSE (`d` 1 1 2000) (`d` 10 5 2026) FALSE (`d` 1 1 2000) (`d` 1 9 2026) EQUALS `the duty does not arise`
-- Contents: started, stopped, gives stopped, title, amount, name and address.
#ASSERT `Does my notice of remunerated work contain everything required` TRUE FALSE FALSE TRUE TRUE TRUE EQUALS TRUE
#ASSERT `Does my notice of remunerated work contain everything required` TRUE TRUE FALSE TRUE TRUE TRUE EQUALS FALSE
#ASSERT `Does my notice of remunerated work contain everything required` TRUE TRUE TRUE TRUE FALSE TRUE EQUALS FALSE

§§ `reg 21 -- a later certificate of capacity`

#ASSERT `Who must I give my later certificate of capacity to` TRUE EQUALS `the insurer`
#ASSERT `Who must I give my later certificate of capacity to` FALSE EQUALS `my employer`
#ASSERT `By when must I pass on my later certificate of capacity` (`d` 28 12 2026) EQUALS `d` 4 1 2027

§§ `regs 29, 30`

#ASSERT `By when must I give my next declarations` (`d` 31 8 2026) FALSE (`d` 1 1 2000) EQUALS `d` 30 11 2026
#ASSERT `By when must I give my next declarations` (`d` 31 8 2026) TRUE (`d` 15 1 2027) EQUALS `d` 15 4 2027
#ASSERT `By when must I give my next declarations` (`d` 30 11 2026) FALSE (`d` 1 1 2000) EQUALS `d` 28 2 2027
#ASSERT `Am I serving a term of imprisonment` TRUE EQUALS JUST TRUE
#ASSERT `Am I serving a term of imprisonment` FALSE EQUALS NOTHING

§§ `reg 32 -- health services`

#ASSERT `Can my treatment count as a medical and health expense` `Physiotherapy` TRUE EQUALS JUST TRUE
#ASSERT `Can my treatment count as a medical and health expense` `Physiotherapy` FALSE EQUALS JUST FALSE
#ASSERT `Can my treatment count as a medical and health expense` `Speech pathology` TRUE EQUALS JUST TRUE
#ASSERT `Can my treatment count as a medical and health expense` `Another health service` TRUE EQUALS NOTHING

§§ `regs 37, 39 -- workplace rehabilitation`

#ASSERT `May I choose my workplace rehabilitation provider` TRUE EQUALS JUST TRUE
#ASSERT `May I choose my workplace rehabilitation provider` FALSE EQUALS NOTHING
#ASSERT `Must my workplace rehabilitation service end` FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `Must my workplace rehabilitation service end` FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Must my workplace rehabilitation service end` FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE

§§ `regs 74, 81, 88`

#ASSERT `Must my employer give me its injury management system document` TRUE EQUALS JUST TRUE
#ASSERT `Must my employer give me its injury management system document` FALSE EQUALS JUST FALSE
-- Reg 81. Arguments: reasonable hours, arranged by my doctor, an earlier one, day of the last, day of this.
#ASSERT `Can I be required to attend this case conference` FALSE FALSE FALSE (`d` 1 1 2000) (`d` 1 7 2026) EQUALS JUST FALSE
-- 27 days after the last: too soon; 28 days: within the limit.
#ASSERT `Can I be required to attend this case conference` TRUE FALSE TRUE (`d` 1 6 2026) (`d` 28 6 2026) EQUALS JUST FALSE
#ASSERT `Can I be required to attend this case conference` TRUE FALSE TRUE (`d` 1 6 2026) (`d` 29 6 2026) EQUALS NOTHING
-- Arranged by my treating doctor: the 4-week limit does not apply.
#ASSERT `Can I be required to attend this case conference` TRUE TRUE TRUE (`d` 1 6 2026) (`d` 28 6 2026) EQUALS NOTHING
#ASSERT `Can I be required to attend this case conference` TRUE FALSE FALSE (`d` 1 1 2000) (`d` 28 6 2026) EQUALS NOTHING
-- Reg 88. Arguments: unreasonable hours, earlier one, day of last, day of this, specialists already, this one among them.
#ASSERT `Can I be required to attend this medical examination` TRUE FALSE (`d` 1 1 2000) (`d` 1 7 2026) 0 FALSE EQUALS JUST FALSE
-- 13 days after the last: too soon; 14 days: within the limit.
#ASSERT `Can I be required to attend this medical examination` FALSE TRUE (`d` 1 6 2026) (`d` 14 6 2026) 0 FALSE EQUALS JUST FALSE
#ASSERT `Can I be required to attend this medical examination` FALSE TRUE (`d` 1 6 2026) (`d` 15 6 2026) 0 FALSE EQUALS NOTHING
-- A fourth specialist in the same field: no; one of the three again: within the limit; a third: within the limit.
#ASSERT `Can I be required to attend this medical examination` FALSE TRUE (`d` 1 6 2026) (`d` 1 7 2026) 3 FALSE EQUALS JUST FALSE
#ASSERT `Can I be required to attend this medical examination` FALSE TRUE (`d` 1 6 2026) (`d` 1 7 2026) 3 TRUE EQUALS NOTHING
#ASSERT `Can I be required to attend this medical examination` FALSE TRUE (`d` 1 6 2026) (`d` 1 7 2026) 2 FALSE EQUALS NOTHING

§§ `reg 92`

#ASSERT `By when must I comply with the assessor's requirement` TRUE (`d` 25 12 2026) EQUALS NOTHING
#ASSERT `By when must I comply with the assessor's requirement` FALSE (`d` 25 12 2026) EQUALS JUST (`d` 1 1 2027)

§§ `reg 120 -- the election`

-- Arguments: form lodged, dust disease, supporting assessment, panel determination, s 426(5) agreement.
#ASSERT `Is my election made the way the regulations require` TRUE FALSE TRUE FALSE FALSE EQUALS TRUE
#ASSERT `Is my election made the way the regulations require` TRUE FALSE FALSE FALSE FALSE EQUALS FALSE
#ASSERT `Is my election made the way the regulations require` TRUE TRUE FALSE TRUE FALSE EQUALS TRUE
#ASSERT `Is my election made the way the regulations require` TRUE TRUE TRUE FALSE FALSE EQUALS FALSE
#ASSERT `Is my election made the way the regulations require` TRUE TRUE FALSE FALSE TRUE EQUALS TRUE
#ASSERT `Is my election made the way the regulations require` FALSE FALSE TRUE FALSE FALSE EQUALS FALSE
