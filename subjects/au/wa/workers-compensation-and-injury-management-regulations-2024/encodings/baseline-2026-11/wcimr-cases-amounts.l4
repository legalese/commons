IMPORT prelude
IMPORT `wcimr-amounts`

-- Workers Compensation and Injury Management Regulations 2024 (WA) -- worked cases for the amounts (wcimr-amounts.l4).
-- Every expected value was worked by hand from the deposited text; none was copied from the encoding's output. The index
-- figures (CPI 135 and 140, then 145; WPI 145 and 150) are ILLUSTRATIVE, not the published ones. Each assertion is a
-- claim about the ENCODING on stated facts, not about the law.
-- BASELINE ENCODING. Not for public use as advice. See NOTES.md.

§ `cases`

§§ `reg 4 and reg 35(2) -- rounding`

#ASSERT `rounded to the nearest whole dollar` 10.5 EQUALS 11
#ASSERT `rounded to the nearest whole dollar` 10.49 EQUALS 10
#ASSERT `rounded to the nearest whole cent` 0.565 EQUALS 0.57
#ASSERT `rounded to the nearest whole cent` 0.5649 EQUALS 0.56

§§ `reg 23 -- maximum weekly rate`

-- 2 x the average of $1,900 and $1,950 = $3,850.
#ASSERT `What is the most I can be paid a week` 1900 1950 3700 EQUALS 3850
-- s 538(5): never down; last year's $4,000 stays.
#ASSERT `What is the most I can be paid a week` 1900 1950 4000 EQUALS 4000
-- 2 x 1,925.375 = 3,850.75, rounded to $3,851.
#ASSERT `What is the most I can be paid a week` 1900.25 1950.5 3700 EQUALS 3851

§§ `reg 24 -- no minimum weekly rate`

#ASSERT `Do the regulations take away my minimum weekly rate` FALSE TRUE EQUALS JUST TRUE
#ASSERT `Do the regulations take away my minimum weekly rate` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Do the regulations take away my minimum weekly rate` TRUE TRUE EQUALS NOTHING

§§ `regs 25, 26 -- board and lodging`

-- 2024-25: $181 x 140/135 = $187.70, rounded $188.
#ASSERT `the maximum board and lodging daily amount` 2024 0 140 135 EQUALS JUST 188
-- 2024-25 with the CPI falling: not varied, $181.
#ASSERT `the maximum board and lodging daily amount` 2024 0 130 135 EQUALS JUST 181
-- 2025-26 from $188: x 145/140 = $194.71, rounded $195.
#ASSERT `the maximum board and lodging daily amount` 2025 188 145 140 EQUALS JUST 195
-- CPI unchanged: $188 stays.
#ASSERT `the maximum board and lodging daily amount` 2025 188 140 140 EQUALS JUST 188
-- Before 2024-25 the regulations set no amount.
#ASSERT `the maximum board and lodging daily amount` 2023 0 140 135 EQUALS NOTHING
-- Reg 25: 30 full days at $20 caps the value at $600.
#ASSERT `the monetary value of my board and lodging` TRUE 500 30 20 EQUALS 500
#ASSERT `the monetary value of my board and lodging` TRUE 600 30 20 EQUALS 600
#ASSERT `the monetary value of my board and lodging` TRUE 700 30 20 EQUALS 600
#ASSERT `the monetary value of my board and lodging` FALSE 0 30 20 EQUALS 600

§§ `regs 34, 35 -- wheelchair and travel`

-- $13,994 x 140/135 = $14,512.30, rounded $14,512.
#ASSERT `the wheelchair maximum` 2024 0 140 135 EQUALS JUST 14512
-- 55 cents x 140/135 = 57.04 cents, rounded 57 cents.
#ASSERT `the vehicle rate per kilometre` 2024 0 140 135 EQUALS JUST 0.57
-- 2025-26: 57 cents x 145/140 = 59.04 cents, rounded 59 cents.
#ASSERT `the vehicle rate per kilometre` 2025 0.57 145 140 EQUALS JUST 0.59
-- Half a cent rounds up: 50 cents x 101/100 = 50.5 cents, 51 cents.
#ASSERT `the vehicle rate per kilometre` 2026 0.50 101 100 EQUALS JUST 0.51
-- $139 x 140/135 = $144.15, rounded $144.
#ASSERT `the meals and accommodation daily rate` 2024 0 140 135 EQUALS JUST 144

§§ `regs 65, 66 -- after a worker's death`

-- $149 x 150/145 = $154.14, rounded $154.
#ASSERT `the eligible dependent child allowance` 2024 0 150 145 EQUALS JUST 154
-- 50 cents more than a whole dollar rounds up: $150 x 101/100 = $151.50, $152.
#ASSERT `the eligible dependent child allowance` 2026 150 101 100 EQUALS JUST 152
-- $11,739 x 140/135 = $12,173.78, rounded $12,174.
#ASSERT `the funeral expenses maximum amount` 2024 0 140 135 EQUALS JUST 12174

§§ `regs 122, 134 -- maximum damages and the general maximum amount`

-- $530,724 x 150/145 = $549,024.83, rounded $549,025.
#ASSERT `the maximum damages for less than 25% impairment` 2024 0 150 145 EQUALS JUST 549025
-- $252,724 x 150/145 = $261,438.62, rounded $261,439.
#ASSERT `the general maximum amount` 2024 0 150 145 EQUALS JUST 261439
-- 2026-27 from an illustrative $260,000: up 3% to $267,800; WPI down: $260,000 stays.
#ASSERT `the general maximum amount` 2026 260000 103 100 EQUALS JUST 267800
#ASSERT `the general maximum amount` 2026 260000 99 100 EQUALS JUST 260000

§§ `reg 108 -- interest`

-- 6% a year on $10,000: $600 for 365 days; $49.32 for 30 days, rounded $49; nothing for 0 days.
#ASSERT `the interest on the sum` 10000 365 EQUALS 600
#ASSERT `the interest on the sum` 10000 30 EQUALS 49
#ASSERT `the interest on the sum` 10000 0 EQUALS 0
