IMPORT prelude
IMPORT `wcimr-dates`
IMPORT `wcimr-diseases`

-- Workers Compensation and Injury Management Regulations 2024 (WA) -- worked cases for Part 2 (wcimr-diseases.l4) and the
-- date counting (wcimr-dates.l4). Every expected value was worked by hand from the deposited text; none was copied from
-- the encoding's output. The facts are illustrative. Each assertion is a claim about the ENCODING, not about the law.
-- BASELINE ENCODING. Not for public use as advice. See NOTES.md.

§ `cases`

`d` MEANS `the calendar date`

§§ `Dates`

#ASSERT `the date` 120 `days after` (`d` 1 3 2026) EQUALS `d` 29 6 2026
#ASSERT `the date` 3 `months after` (`d` 30 11 2026) EQUALS `d` 28 2 2027
#ASSERT `the date` 2 `years after` (`d` 29 2 2028) EQUALS `d` 28 2 2030
#ASSERT `the first day of the` 12 `months ending on` (`d` 15 6 2026) EQUALS `d` 16 6 2025
#ASSERT `the first day of the` 3 `months ending on` (`d` 1 7 2026) EQUALS `d` 2 4 2026

§§ `reg 7 -- the injury day`

#ASSERT `On what day am I taken to have suffered my disease` (`d` 10 3 2025) FALSE (`d` 1 1 2000) EQUALS `d` 10 3 2025
#ASSERT `On what day am I taken to have suffered my disease` (`d` 1 1 2000) TRUE (`d` 5 5 2025) EQUALS `d` 5 5 2025

§§ `regs 5-8 and Schedule 1`

-- Arguments: disease, kind of work, complete months, complete weeks, first diagnosis, died before diagnosis, day of death,
-- employer proves otherwise.
-- Item 26, lung, 5 years: 60 months is enough, 59 is not.
#ASSERT `Is my disease taken to be from my employment` `Primary malignant disease of the lung` TRUE 60 260 (`d` 1 8 2025) FALSE (`d` 1 1 2000) FALSE EQUALS TRUE
#ASSERT `Is my disease taken to be from my employment` `Primary malignant disease of the lung` TRUE 59 259 (`d` 1 8 2025) FALSE (`d` 1 1 2000) FALSE EQUALS FALSE
-- Reg 8: diagnosed 30 June 2024, too early; 1 July 2024, in.
#ASSERT `Is my disease taken to be from my employment` `Primary malignant disease of the lung` TRUE 60 260 (`d` 30 6 2024) FALSE (`d` 1 1 2000) FALSE EQUALS FALSE
#ASSERT `Is my disease taken to be from my employment` `Primary malignant disease of the lung` TRUE 60 260 (`d` 1 7 2024) FALSE (`d` 1 1 2000) FALSE EQUALS TRUE
-- Item 39, byssinosis, 4 weeks.
#ASSERT `Is my disease taken to be from my employment` `Byssinosis` TRUE 0 4 (`d` 1 8 2025) FALSE (`d` 1 1 2000) FALSE EQUALS TRUE
#ASSERT `Is my disease taken to be from my employment` `Byssinosis` TRUE 0 3 (`d` 1 8 2025) FALSE (`d` 1 1 2000) FALSE EQUALS FALSE
-- Item 1, anthrax: no qualifying period.
#ASSERT `Is my disease taken to be from my employment` `Anthrax` TRUE 0 0 (`d` 1 8 2025) FALSE (`d` 1 1 2000) FALSE EQUALS TRUE
-- Item 50, Raynaud's disease, 12 weeks.
#ASSERT `Is my disease taken to be from my employment` `Raynaud's disease` TRUE 2 12 (`d` 1 8 2025) FALSE (`d` 1 1 2000) FALSE EQUALS TRUE
#ASSERT `Is my disease taken to be from my employment` `Raynaud's disease` TRUE 2 11 (`d` 1 8 2025) FALSE (`d` 1 1 2000) FALSE EQUALS FALSE
-- Item 48, bursitis, 6 months.
#ASSERT `Is my disease taken to be from my employment` `Bursitis (at the elbow or knee)` TRUE 6 26 (`d` 1 8 2025) FALSE (`d` 1 1 2000) FALSE EQUALS TRUE
#ASSERT `Is my disease taken to be from my employment` `Bursitis (at the elbow or knee)` TRUE 5 25 (`d` 1 8 2025) FALSE (`d` 1 1 2000) FALSE EQUALS FALSE
-- Item 15, leukaemia, 2 years.
#ASSERT `Is my disease taken to be from my employment` `Primary leukaemia` TRUE 24 104 (`d` 1 8 2025) FALSE (`d` 1 1 2000) FALSE EQUALS TRUE
#ASSERT `Is my disease taken to be from my employment` `Primary leukaemia` TRUE 23 100 (`d` 1 8 2025) FALSE (`d` 1 1 2000) FALSE EQUALS FALSE
-- Item 38, peripheral neuropathy, 1 year.
#ASSERT `Is my disease taken to be from my employment` `Peripheral neuropathy` TRUE 12 52 (`d` 1 8 2025) FALSE (`d` 1 1 2000) FALSE EQUALS TRUE
#ASSERT `Is my disease taken to be from my employment` `Peripheral neuropathy` TRUE 11 48 (`d` 1 8 2025) FALSE (`d` 1 1 2000) FALSE EQUALS FALSE
-- Item 25: liver, (b) vinyl chloride needs 5 years; (a) bodily secretions with hepatitis needs none.
#ASSERT `Is my disease taken to be from my employment` `Primary malignant disease of the liver, from vinyl chloride monomer exposure` TRUE 59 259 (`d` 1 8 2025) FALSE (`d` 1 1 2000) FALSE EQUALS FALSE
#ASSERT `Is my disease taken to be from my employment` `Primary malignant disease of the liver, from bodily secretions and hepatitis B or C exposure` TRUE 0 0 (`d` 1 8 2025) FALSE (`d` 1 1 2000) FALSE EQUALS TRUE
-- Not in Schedule 1; not the kind of work; the employer proves otherwise.
#ASSERT `Is my disease taken to be from my employment` `A disease not listed in Schedule 1` TRUE 100 500 (`d` 1 8 2025) FALSE (`d` 1 1 2000) FALSE EQUALS FALSE
#ASSERT `Is my disease taken to be from my employment` `Anthrax` FALSE 100 500 (`d` 1 8 2025) FALSE (`d` 1 1 2000) FALSE EQUALS FALSE
#ASSERT `Is my disease taken to be from my employment` `Anthrax` TRUE 100 500 (`d` 1 8 2025) FALSE (`d` 1 1 2000) TRUE EQUALS FALSE
-- Reg 7(b): death before diagnosis fixes the day: 2 July 2024 in, 30 June 2024 out.
#ASSERT `Is my disease taken to be from my employment` `Primary malignant disease of the lung` TRUE 60 260 (`d` 1 1 2020) TRUE (`d` 2 7 2024) FALSE EQUALS TRUE
#ASSERT `Is my disease taken to be from my employment` `Primary malignant disease of the lung` TRUE 60 260 (`d` 1 1 2020) TRUE (`d` 30 6 2024) FALSE EQUALS FALSE

§§ `reg 9 -- COVID-19`

-- Arguments: work, qualifying test, day of diagnosis, died before such a diagnosis, day of death, employer proves otherwise.
#ASSERT `Is my COVID-19 taken to be from my employment` `a health professional` TRUE (`d` 1 3 2020) FALSE (`d` 1 1 2000) FALSE EQUALS TRUE
#ASSERT `Is my COVID-19 taken to be from my employment` `an ambulance officer` TRUE (`d` 15 2 2020) FALSE (`d` 1 1 2000) FALSE EQUALS FALSE
#ASSERT `Is my COVID-19 taken to be from my employment` `an ambulance officer` TRUE (`d` 16 2 2020) FALSE (`d` 1 1 2000) FALSE EQUALS TRUE
#ASSERT `Is my COVID-19 taken to be from my employment` `other work` TRUE (`d` 1 3 2021) FALSE (`d` 1 1 2000) FALSE EQUALS FALSE
#ASSERT `Is my COVID-19 taken to be from my employment` `a health professional` FALSE (`d` 1 3 2021) FALSE (`d` 1 1 2000) FALSE EQUALS FALSE
#ASSERT `Is my COVID-19 taken to be from my employment` `any work in a hospital, medical practice, clinic or facility for health screening, testing or treatment` FALSE (`d` 1 1 2000) TRUE (`d` 1 4 2020) FALSE EQUALS TRUE
#ASSERT `Is my COVID-19 taken to be from my employment` `a health professional` TRUE (`d` 1 3 2021) FALSE (`d` 1 1 2000) TRUE EQUALS FALSE

§§ `reg 10 -- post-traumatic stress disorder`

-- Arguments: work, DSM-5 diagnosis by a psychiatrist, day of first diagnosis, employer proves otherwise.
#ASSERT `Is my PTSD taken to be from my employment` `a paramedic` TRUE (`d` 1 2 2022) FALSE EQUALS TRUE
#ASSERT `Is my PTSD taken to be from my employment` `a paramedic` TRUE (`d` 31 1 2022) FALSE EQUALS FALSE
#ASSERT `Is my PTSD taken to be from my employment` `Crown employment in a firefighter classification under a firefighting award or agreement` TRUE (`d` 5 5 2023) FALSE EQUALS FALSE
#ASSERT `Is my PTSD taken to be from my employment` `Crown employment in a firefighter classification under a firefighting award or agreement` TRUE (`d` 6 5 2023) FALSE EQUALS TRUE
#ASSERT `Is my PTSD taken to be from my employment` `a communications systems officer receiving calls and dispatching emergency services for the fire and emergency services department` TRUE (`d` 1 1 2023) FALSE EQUALS FALSE
#ASSERT `Is my PTSD taken to be from my employment` `an ambulance emergency communications officer` TRUE (`d` 1 1 2023) FALSE EQUALS TRUE
#ASSERT `Is my PTSD taken to be from my employment` `a paramedic` FALSE (`d` 1 1 2025) FALSE EQUALS FALSE
#ASSERT `Is my PTSD taken to be from my employment` `other work` TRUE (`d` 1 1 2025) FALSE EQUALS FALSE
#ASSERT `Is my PTSD taken to be from my employment` `an ambulance officer` TRUE (`d` 1 1 2025) TRUE EQUALS FALSE

§§ `reg 11 -- firefighter cancers`

#ASSERT `the reg 11 qualifying period in years` `Malignant mesothelioma` EQUALS JUST 15
#ASSERT `the reg 11 qualifying period in years` `Primary site cervical cancer` EQUALS JUST 10
#ASSERT `the reg 11 qualifying period in years` `Primary site skin cancer` EQUALS JUST 15
#ASSERT `the reg 11 qualifying period in years` `Primary site thyroid cancer` EQUALS JUST 10
#ASSERT `the reg 11 qualifying period in years` `A cancer not in the reg 11 Table` EQUALS NOTHING
#ASSERT `Does reg 11(2) shut out s 11 for my cancer` `Primary site lung cancer` (`d` 12 11 2013) EQUALS JUST TRUE
#ASSERT `Does reg 11(2) shut out s 11 for my cancer` `Primary site lung cancer` (`d` 13 11 2013) EQUALS JUST FALSE
#ASSERT `Does reg 11(2) shut out s 11 for my cancer` `A cancer not in the reg 11 Table` (`d` 1 1 2000) EQUALS NOTHING
