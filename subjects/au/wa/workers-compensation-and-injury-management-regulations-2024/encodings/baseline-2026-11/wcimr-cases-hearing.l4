IMPORT prelude
IMPORT `wcimr-dates`
IMPORT `wcimr-hearing`

-- Workers Compensation and Injury Management Regulations 2024 (WA) -- worked cases for noise-induced hearing loss
-- (wcimr-hearing.l4). Every expected value was worked by hand from the deposited text; none was copied from the
-- encoding's output. The facts are illustrative. Each assertion is a claim about the ENCODING, not about the law.
-- BASELINE ENCODING. Not for public use as advice. See NOTES.md.

§ `cases`

`d` MEANS `the calendar date`

§§ `reg 40 -- noisy employment`

#ASSERT `Is my employment noisy employment` TRUE 86 0 EQUALS TRUE
-- "Exceeds": 85 dB(A) and 140 dB(C) exactly are not enough.
#ASSERT `Is my employment noisy employment` TRUE 85 140 EQUALS FALSE
#ASSERT `Is my employment noisy employment` TRUE 80 141 EQUALS TRUE
#ASSERT `Is my employment noisy employment` FALSE 100 150 EQUALS FALSE

§§ `regs 43, 44, 48 -- who pays`

-- Arguments: current noisy employer, day last noisy employment ended, day of test, employer paid an earlier test, its day.
#ASSERT `Who must pay for my hearing test` TRUE (`d` 1 1 2000) (`d` 1 7 2026) FALSE (`d` 1 1 2000) EQUALS `my current employer`
-- Reg 44: the employer paid for a test on 2 July 2024; a test on 1 July 2026 is less than 2 years on.
#ASSERT `Who must pay for my hearing test` TRUE (`d` 1 1 2000) (`d` 1 7 2026) TRUE (`d` 2 7 2024) EQUALS `not settled by the text: my noisy employer paid for a test less than 2 years ago`
-- Exactly 2 years on (1 July 2024 to 1 July 2026): the employer pays again.
#ASSERT `Who must pay for my hearing test` TRUE (`d` 1 1 2000) (`d` 1 7 2026) TRUE (`d` 1 7 2024) EQUALS `my current employer`
-- Reg 43(1)(b): the 3 months ending 1 July 2026 begin 2 April 2026.
#ASSERT `Who must pay for my hearing test` FALSE (`d` 2 4 2026) (`d` 1 7 2026) FALSE (`d` 1 1 2000) EQUALS `my last noisy employer`
#ASSERT `Who must pay for my hearing test` FALSE (`d` 1 4 2026) (`d` 1 7 2026) FALSE (`d` 1 1 2000) EQUALS `I do`
#ASSERT `Who must pay for my hearing test` FALSE (`d` 2 4 2026) (`d` 1 7 2026) TRUE (`d` 1 1 2025) EQUALS `not settled by the text: my noisy employer paid for a test less than 2 years ago`
-- Reg 48: the NIHL assessment follows the test's payer under reg 43(1)(a), (b).
#ASSERT `Who must pay for my NIHL assessment` TRUE (`d` 1 1 2000) (`d` 1 7 2026) EQUALS `my current employer`
#ASSERT `Who must pay for my NIHL assessment` FALSE (`d` 2 4 2026) (`d` 1 7 2026) EQUALS `my last noisy employer`
#ASSERT `Who must pay for my NIHL assessment` FALSE (`d` 31 3 2026) (`d` 1 7 2026) EQUALS `I do`
-- Regs 43(7), 48(3): paid back on a successful claim.
#ASSERT `What must my last employer pay me back` TRUE 300 TRUE 800 TRUE EQUALS JUST 1100
#ASSERT `What must my last employer pay me back` FALSE 0 TRUE 800 TRUE EQUALS JUST 800
#ASSERT `What must my last employer pay me back` FALSE 0 FALSE 0 TRUE EQUALS JUST 0
#ASSERT `What must my last employer pay me back` TRUE 300 TRUE 800 FALSE EQUALS NOTHING

§§ `regs 41, 46, 51 -- may I claim`

#ASSERT `May an ENT specialist assess my hearing loss` FALSE 10 EQUALS TRUE
#ASSERT `May an ENT specialist assess my hearing loss` FALSE 9.9 EQUALS FALSE
#ASSERT `May an ENT specialist assess my hearing loss` TRUE 5 EQUALS TRUE
#ASSERT `May an ENT specialist assess my hearing loss` TRUE 4 EQUALS FALSE
-- Arguments: audiologist, ENT, compensated before, per cent, day of assessment, day of claim.
-- The 12 months ending on 15 June 2026 begin 16 June 2025.
#ASSERT `May I claim NIHL compensation` TRUE TRUE FALSE 12 (`d` 16 6 2025) (`d` 15 6 2026) EQUALS TRUE
#ASSERT `May I claim NIHL compensation` TRUE TRUE FALSE 12 (`d` 15 6 2025) (`d` 15 6 2026) EQUALS FALSE
#ASSERT `May I claim NIHL compensation` TRUE TRUE FALSE 12 (`d` 15 6 2026) (`d` 15 6 2026) EQUALS TRUE
#ASSERT `May I claim NIHL compensation` TRUE TRUE FALSE 12 (`d` 16 6 2026) (`d` 15 6 2026) EQUALS FALSE
#ASSERT `May I claim NIHL compensation` FALSE TRUE FALSE 12 (`d` 1 6 2026) (`d` 15 6 2026) EQUALS FALSE
#ASSERT `May I claim NIHL compensation` TRUE TRUE FALSE 9 (`d` 1 6 2026) (`d` 15 6 2026) EQUALS FALSE
#ASSERT `May I claim NIHL compensation` TRUE TRUE TRUE 5 (`d` 1 6 2026) (`d` 15 6 2026) EQUALS TRUE
#ASSERT `Is this employer my last employer` TRUE FALSE FALSE EQUALS TRUE
#ASSERT `Is this employer my last employer` TRUE TRUE FALSE EQUALS FALSE
#ASSERT `Is this employer my last employer` FALSE TRUE TRUE EQUALS TRUE
#ASSERT `Have I made my NIHL claim` TRUE TRUE TRUE EQUALS TRUE
#ASSERT `Have I made my NIHL claim` TRUE FALSE TRUE EQUALS FALSE

§§ `regs 53, 54 -- passing the claim on`

-- Arguments: insured, day claimed, employer passed it on, day it did, today. Claimed 1 June 2026: the last day is 8 June.
#ASSERT `May I give my NIHL claim to the insurer myself` FALSE (`d` 1 6 2026) FALSE (`d` 1 1 2000) (`d` 1 7 2026) EQUALS NOTHING
#ASSERT `May I give my NIHL claim to the insurer myself` TRUE (`d` 1 6 2026) TRUE (`d` 8 6 2026) (`d` 1 7 2026) EQUALS JUST FALSE
#ASSERT `May I give my NIHL claim to the insurer myself` TRUE (`d` 1 6 2026) TRUE (`d` 9 6 2026) (`d` 1 7 2026) EQUALS JUST TRUE
#ASSERT `May I give my NIHL claim to the insurer myself` TRUE (`d` 1 6 2026) FALSE (`d` 1 1 2000) (`d` 8 6 2026) EQUALS JUST FALSE
#ASSERT `May I give my NIHL claim to the insurer myself` TRUE (`d` 1 6 2026) FALSE (`d` 1 1 2000) (`d` 9 6 2026) EQUALS JUST TRUE

§§ `regs 56, 57 -- the insurer's decision`

#ASSERT `By when must the insurer decide my NIHL claim` (`d` 1 6 2026) FALSE EQUALS `d` 15 6 2026
-- Deferred: before the day after 120 days beginning 1 June 2026, so by 28 September 2026.
#ASSERT `By when must the insurer decide my NIHL claim` (`d` 1 6 2026) TRUE EQUALS `d` 28 9 2026
-- Arguments: day given, decision notice, its day, deferral notice, its day, today.
#ASSERT `Is liability for my NIHL claim taken to be accepted` (`d` 1 6 2026) TRUE (`d` 15 6 2026) FALSE (`d` 1 1 2000) (`d` 1 7 2026) EQUALS FALSE
#ASSERT `Is liability for my NIHL claim taken to be accepted` (`d` 1 6 2026) FALSE (`d` 1 1 2000) FALSE (`d` 1 1 2000) (`d` 15 6 2026) EQUALS FALSE
#ASSERT `Is liability for my NIHL claim taken to be accepted` (`d` 1 6 2026) FALSE (`d` 1 1 2000) FALSE (`d` 1 1 2000) (`d` 16 6 2026) EQUALS TRUE
#ASSERT `Is liability for my NIHL claim taken to be accepted` (`d` 1 6 2026) TRUE (`d` 16 6 2026) FALSE (`d` 1 1 2000) (`d` 20 6 2026) EQUALS TRUE
#ASSERT `Is liability for my NIHL claim taken to be accepted` (`d` 1 6 2026) TRUE (`d` 28 9 2026) TRUE (`d` 10 6 2026) (`d` 1 10 2026) EQUALS FALSE
#ASSERT `Is liability for my NIHL claim taken to be accepted` (`d` 1 6 2026) TRUE (`d` 29 9 2026) TRUE (`d` 10 6 2026) (`d` 1 10 2026) EQUALS TRUE
#ASSERT `Is liability for my NIHL claim taken to be accepted` (`d` 1 6 2026) FALSE (`d` 1 1 2000) TRUE (`d` 10 6 2026) (`d` 28 9 2026) EQUALS FALSE
#ASSERT `Is liability for my NIHL claim taken to be accepted` (`d` 1 6 2026) FALSE (`d` 1 1 2000) TRUE (`d` 10 6 2026) (`d` 29 9 2026) EQUALS TRUE
-- A deferral after the 14 days does not count: accepted from day 15.
#ASSERT `Is liability for my NIHL claim taken to be accepted` (`d` 1 6 2026) FALSE (`d` 1 1 2000) TRUE (`d` 16 6 2026) (`d` 20 6 2026) EQUALS TRUE

§§ `regs 59, 60 -- disputes`

#ASSERT `May I apply to an arbitrator about my NIHL claim` `not accepted: I am not a worker` FALSE EQUALS JUST TRUE
#ASSERT `May I apply to an arbitrator about my NIHL claim` `not accepted: this employer is not my last employer` FALSE EQUALS JUST TRUE
#ASSERT `May I apply to an arbitrator about my NIHL claim` `liability accepted` FALSE EQUALS NOTHING
#ASSERT `May I apply to an arbitrator about my NIHL claim` `liability accepted` TRUE EQUALS JUST TRUE
#ASSERT `May I apply to an arbitrator about my NIHL claim` `not accepted: hearing loss matters are disputed` FALSE EQUALS NOTHING
#ASSERT `May I apply to an arbitrator about my NIHL claim` `not accepted: hearing loss matters are disputed` TRUE EQUALS JUST TRUE

§§ `reg 61 -- payment`

#ASSERT `By when must I be paid my NIHL compensation` (`d` 1 6 2026) FALSE (`d` 1 1 2000) EQUALS `d` 15 6 2026
#ASSERT `By when must I be paid my NIHL compensation` (`d` 1 6 2026) TRUE (`d` 1 7 2026) EQUALS `d` 8 7 2026
