#ASSERT `a power to appoint includes the power` `to remove or suspend a person appointed` EQUALS JUST TRUE
-- 200. s 52(1)(b): a person who is not eligible and qualified may not be appointed to act
#ASSERT `a person may be appointed to act temporarily` TRUE FALSE EQUALS FALSE
-- 201a. s 52(2)(a): illness is a cause
#ASSERT `the cause is included in section 52(1)(b)` `illness` EQUALS JUST TRUE
-- 201b. s 52(2)(c): conflict of interest is a cause
#ASSERT `the cause is included in section 52(1)(b)` `conflict of interest` EQUALS JUST TRUE
-- 201c. s 52(2)(b): temporary absence from the State is a cause
#ASSERT `the cause is included in section 52(1)(b)` `temporary absence from the State` EQUALS JUST TRUE
-- 202. s 52(3): the acts of an acting appointee cannot be challenged on the ground that the occasion had not arisen
#ASSERT `the validity of the thing done can be called in question on that ground` TRUE EQUALS JUST FALSE
-- 203. s 52(4): where the appointment needs another's approval and it has not been given, the removal power is not exercisable
#ASSERT `the powers in section 52(1)(a) to (c) are exercisable` TRUE FALSE EQUALS FALSE
-- 204. s 52(5): s 52 does not affect tenure fixed by an express provision
#ASSERT `section 52 affects the tenure` TRUE EQUALS FALSE
-- 205. s 53: an appointment of an office-holder is of the person from time to time holding the office
#ASSERT `the appointment is of the person from time to time holding, acting in, or performing the functions of the office` TRUE EQUALS TRUE
-- 206a. s 54(1): a body of 3 persons: a function may be performed by a majority (2 of 3)
#ASSERT `the function may be performed by those who agree` 3 2 EQUALS JUST TRUE
-- 206b. s 54(1): a body of 2 persons is not reached by s 54(1)
#ASSERT NOT (`the function may be performed by those who agree` 2 2 EQUALS JUST TRUE)
-- 207a. s 54(2)(a)(i): fixed body of 5: quorum 3
#ASSERT `the least number of members that make a quorum, with a fixed number of members` 5 EQUALS JUST 3
-- 207b. s 54(2)(a)(i): fixed body of 4: quorum 2
#ASSERT `the least number of members that make a quorum, with a fixed number of members` 4 EQUALS JUST 2
-- 207c. s 54(2)(a)(i): fixed body of 3: quorum 2
#ASSERT `the least number of members that make a quorum, with a fixed number of members` 3 EQUALS JUST 2
-- 207d. s 54(2)(a)(i): fixed body of 6: quorum 3
#ASSERT `the least number of members that make a quorum, with a fixed number of members` 6 EQUALS JUST 3
-- 207e. s 54(2)(a)(i): fixed body of 7: quorum 4
#ASSERT `the least number of members that make a quorum, with a fixed number of members` 7 EQUALS JUST 4
-- 208. s 54(2)(a)(ii): a body with a range of 5 to 9 members and 7 in office: quorum 4
#ASSERT `the least number of members that make a quorum, with a range of members` 7 TRUE EQUALS JUST 4
-- 209. s 54(2)(a)(ii): range 5 to 9 with 4 in office (outside the range): not covered
#ASSERT `the least number of members that make a quorum, with a range of members` 4 FALSE EQUALS NOTHING
-- 210a. s 54(2)(b): 3 present (quorum 3), 2 agree: deemed done by the association
#ASSERT `the act is deemed done by the association` 3 2 3 EQUALS TRUE
-- 210b. s 54(2)(b): 4 present, 2 agree, 2 against (quorum 3): not a majority
#ASSERT `the act is deemed done by the association` 4 2 3 EQUALS FALSE
-- 210c. s 54(2)(b): 2 present (quorum 3): no quorum
#ASSERT `the act is deemed done by the association` 2 2 3 EQUALS FALSE
-- 211. s 54(2): a body of 2 members: no quorum rule from s 54(2)
#ASSERT `the least number of members that make a quorum, with a fixed number of members` 2 EQUALS NOTHING
-- 212. s 55: an administrative power may be exercised again to correct an error
#ASSERT `the power or duty may be exercised again as often as is necessary to correct an error or omission` TRUE EQUALS JUST TRUE
-- 213. s 55: a judicial power: not covered
#ASSERT `the power or duty may be exercised again as often as is necessary to correct an error or omission` FALSE EQUALS NOTHING
-- 214. s 56(1): "may" in conferring a power: exercised or not, at discretion
#ASSERT `what the word means` `the word may, in conferring a power` EQUALS `the power may be exercised or not, at discretion`
-- 215. s 56(2): "shall" in conferring a function: it must be performed
#ASSERT `what the word means` `the word shall, in conferring a function` EQUALS `the function must be performed`
-- 216a. s 57(a): a vacancy does not affect the body's powers
#ASSERT `the powers of the body are affected by` `a vacancy in the membership of the body` EQUALS JUST FALSE
-- 216b. s 57(c): a minor irregularity does not affect the body's powers
#ASSERT `the powers of the body are affected by` `a minor irregularity in the convening or conduct of a meeting` EQUALS JUST FALSE
-- 216c. s 57(c): a major irregularity is not protected by s 57
#ASSERT NOT (`the powers of the body are affected by` `a major irregularity in the convening or conduct of a meeting` EQUALS JUST FALSE)
-- 217. s 58: a delegate acts on the delegate's own opinion
#ASSERT `whose opinion, belief or state of mind counts` TRUE EQUALS `the delegate's`
-- 218. s 59(1)(a): a delegation does not stop the delegator exercising the power
#ASSERT `a delegation has the feature` `the delegator may still exercise or perform the power or duty delegated, at any time` EQUALS JUST TRUE
-- 219. s 59(1)(e): a delegation may be revoked by a signed instrument in writing
#ASSERT `a delegation has the feature` `it may be amended or revoked by instrument in writing signed by the delegator` EQUALS JUST TRUE
-- 220. s 59(1)(f): a delegation by reference to an office survives a change of the person acting in it
#ASSERT `a delegation has the feature` `where the power is conferred by reference to an office, it does not cease to have effect only because the person acting in the office changes` EQUALS JUST TRUE
-- 221. s 59(2): delegating a power delegates the incidental duty
#ASSERT `the other function is deemed delegated too` TRUE EQUALS TRUE
-- 222. s 59(3): an act done to the delegate is effectually done
#ASSERT `the act is regarded as effectually done` TRUE TRUE EQUALS JUST TRUE
-- 223. s 60: where the Governor is to act, with the advice and consent of the Executive Council
#ASSERT `it is done by the Governor with the advice and consent of the Executive Council` TRUE EQUALS JUST TRUE

-- ===================== PART VIII: TIME AND DISTANCE (ss 61-65) =====================

-- 224. s 61(1)(a): 7 days beginning on 2024-01-01: last day 2024-01-07
#ASSERT `ti the last day by the calendar` (`reckon a period` (`ti period of` 7 `in days`) `begins at, on or with the day` (Date 1 1 2024) `ti no holidays`) EQUALS JUST (Date 7 1 2024)
-- 225. s 61(1)(b): 10 days after 2024-01-01: last day 2024-01-11
#ASSERT `ti the last day by the calendar` (`reckon a period` (`ti period of` 10 `in days`) `is reckoned from or after the day` (Date 1 1 2024) `ti no holidays`) EQUALS JUST (Date 11 1 2024)
-- 226. s 61(1)(b): 7 days from 2024-01-01: last day 2024-01-08
#ASSERT `ti the last day by the calendar` (`reckon a period` (`ti period of` 7 `in days`) `is reckoned from or after the day` (Date 1 1 2024) `ti no holidays`) EQUALS JUST (Date 8 1 2024)
-- 227a. s 61(1)(c): within 10 days before 2024-02-10: the last day that counts is 2024-02-09
#ASSERT `ti the last day by the calendar` (`the time within a time before a day` (`ti period of` 10 `in days`) (Date 10 2 2024) `ti no holidays`) EQUALS JUST (Date 9 2 2024)
-- 227b. s 61(1)(c): the first day that counts is 2024-01-31
#ASSERT `ti the first day of the period` (`the time within a time before a day` (`ti period of` 10 `in days`) (Date 10 2 2024) `ti no holidays`) EQUALS JUST (Date 31 1 2024)
-- 228. s 61(1)(d): a period to continue until 2024-01-31 includes 2024-01-31
#ASSERT (`the end of a period expressed to end on` (Date 31 1 2024) `ti no holidays`)'s `last day by the calendar` EQUALS Date 31 1 2024
-- 229. s 61(1)(f): 7 clear days between two events, the first on 2024-01-01: the second is no earlier than 2024-01-09 (8 days apart leaves 7 clear)
#ASSERT `the number of days counted between two events` `clear days` (Date 1 1 2024) (Date 9 1 2024) EQUALS 7
-- 230a. s 61(1)(f): "not less than 14 days" between events, first 2024-01-01: second 2024-01-16 gives 14
#ASSERT `the number of days counted between two events` `at least or not less than a number of days` (Date 1 1 2024) (Date 16 1 2024) EQUALS 14
-- 230b. s 61(1)(f): a second event on 2024-01-15 gives only 13
#ASSERT `the number of days counted between two events` `at least or not less than a number of days` (Date 1 1 2024) (Date 15 1 2024) EQUALS 13
-- 231. s 61(1)(g): 7 days (not clear) between events, first 2024-01-01: second 2024-01-08 gives 7
#ASSERT `the number of days counted between two events` `a number of days not expressed in either of those ways` (Date 1 1 2024) (Date 8 1 2024) EQUALS 7
-- 232. s 61(1)(f): "at least 3 days", first 2024-02-27 (leap year), second 2024-03-02 gives 3
#ASSERT `the number of days counted between two events` `at least or not less than a number of days` (Date 27 2 2024) (Date 2 3 2024) EQUALS 3
-- 233. s 61(1)(g): 3 days (plain), first 2024-02-27, second 2024-03-01 gives 3
#ASSERT `the number of days counted between two events` `a number of days not expressed in either of those ways` (Date 27 2 2024) (Date 1 3 2024) EQUALS 3
-- 234. s 61(1)(e): time expires on Saturday 2024-01-06: may be done by Monday 2024-01-08
#ASSERT `the next day that is not an excluded day, counting the day itself` (Date 6 1 2024) `ti no holidays` EQUALS Date 8 1 2024
-- 235. s 61(1)(e): expires on Sunday 2024-01-07: Monday 2024-01-08
#ASSERT `the next day that is not an excluded day, counting the day itself` (Date 7 1 2024) `ti no holidays` EQUALS Date 8 1 2024
-- 236. s 61(1)(e): expires Friday 2024-01-05, a statewide public holiday: Monday 2024-01-08
#ASSERT `the next day that is not an excluded day, counting the day itself` (Date 5 1 2024) (`ti holidays` EMPTY EMPTY (LIST (Date 5 1 2024))) EQUALS Date 8 1 2024
-- 237. s 61(1)(e): expires Thursday 2024-01-04, no holiday: that day
#ASSERT `the next day that is not an excluded day, counting the day itself` (Date 4 1 2024) `ti no holidays` EQUALS Date 4 1 2024
-- 238. s 61(1)(e): expires Saturday 2024-01-06 and Monday 2024-01-08 is a statewide public holiday: Tuesday 2024-01-09
#ASSERT `the next day that is not an excluded day, counting the day itself` (Date 6 1 2024) (`ti holidays` EMPTY EMPTY (LIST (Date 8 1 2024))) EQUALS Date 9 1 2024
-- 239. s 61(2): Tuesday 2024-01-09 is a public holiday only in a part of the State that is not relevant: not excluded (it is on no list for the relevant area)
#ASSERT `the next day that is not an excluded day, counting the day itself` (Date 9 1 2024) `ti no holidays` EQUALS Date 9 1 2024
-- 240. s 61(2): the same day is a public holiday in the relevant part: Wednesday 2024-01-10
#ASSERT `the next day that is not an excluded day, counting the day itself` (Date 9 1 2024) (`ti holidays` EMPTY EMPTY (LIST (Date 9 1 2024))) EQUALS Date 10 1 2024
-- 241. s 61(2) with s 5: Thursday 2024-01-04 is a public halfholiday only: not an excluded day (a halfholiday is on no list)
#ASSERT `is an excluded day` (Date 4 1 2024) `ti no holidays` EQUALS FALSE
-- 242. s 61(2): Tuesday 2024-01-09 is a public service holiday: Wednesday 2024-01-10
#ASSERT `the next day that is not an excluded day, counting the day itself` (Date 9 1 2024) (`ti holidays` (LIST (Date 9 1 2024)) EMPTY EMPTY) EQUALS Date 10 1 2024
-- 243. s 61(2): Tuesday 2024-01-09 is a bank holiday throughout the State: Wednesday 2024-01-10
#ASSERT `the next day that is not an excluded day, counting the day itself` (Date 9 1 2024) (`ti holidays` EMPTY (LIST (Date 9 1 2024)) EMPTY) EQUALS Date 10 1 2024
-- 244a. s 61(1)(h): an act directed for Saturday 2024-01-06: the latest day for it to be in due time is Monday 2024-01-08
#ASSERT `The day set for me is an excluded day: the latest day I can act` (Date 6 1 2024) EMPTY EMPTY EQUALS Date 8 1 2024
-- 244b. s 61(1)(h): done on Tuesday 2024-01-09 it is late (after the latest day)
#ASSERT NOT (Day (Date 9 1 2024) AT MOST Day (`The day set for me is an excluded day: the latest day I can act` (Date 6 1 2024) EMPTY EMPTY))
-- 245. s 61(1)(h): allowed on or before Friday 2024-01-05 (a statewide public holiday): done Monday 2024-01-08 is in due time
#ASSERT `The day set for me is an excluded day: the latest day I can act` (Date 5 1 2024) (LIST (Date 5 1 2024)) EMPTY EQUALS Date 8 1 2024
-- 246a. s 61(2): Saturday is an excluded day
#ASSERT `is an excluded day` (Date 6 1 2024) `ti no holidays` EQUALS TRUE
-- 246b. s 61(2): Sunday is an excluded day
#ASSERT `is an excluded day` (Date 7 1 2024) `ti no holidays` EQUALS TRUE
-- 246c. s 61(2): an ordinary Friday (2024-01-05) is not
#ASSERT `is an excluded day` (Date 5 1 2024) `ti no holidays` EQUALS FALSE
-- 246d. s 61(2): a public service holiday is
#ASSERT `is an excluded day` (Date 9 1 2024) (`ti holidays` (LIST (Date 9 1 2024)) EMPTY EMPTY) EQUALS TRUE
