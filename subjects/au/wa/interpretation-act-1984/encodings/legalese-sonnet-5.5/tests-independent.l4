#ASSERT `ti the last day for doing the thing` (`reckon a period` (`ti period of` 7 `in days`) `is reckoned from or after the day` (Date 30 12 2023) (`ti holidays` EMPTY EMPTY (LIST (Date 8 1 2024)))) EQUALS JUST (Date 9 1 2024)
-- 278a. s 63: no time fixed: must be done with all convenient speed
#ASSERT `the act or thing must be done with all convenient speed and as often as occasion arises` FALSE EQUALS TRUE
-- 279. s 63: no time fixed: no last day in days
#ASSERT `the last day for an act or thing when no time may be fixed` FALSE (Date 1 1 2024) EQUALS NOTHING
-- 280. s 64(1): a court's power to extend a time may be exercised after the time has expired (law made 1990)
#ASSERT `an application to extend may be made after the time has expired` TRUE (Date 1 1 1990) FALSE EQUALS JUST TRUE
-- 281. s 64(2): a written law made in 1970 is not reached by s 64
#ASSERT NOT (`an application to extend may be made after the time has expired` TRUE (Date 1 1 1970) FALSE EQUALS JUST TRUE)
-- 282. s 65: a place 3 m east and 4 m north of another, 100 m higher: the distance is 5 m (straight line on a horizontal plane)
#ASSERT `the distance measured for the purposes of a written law between` (`A place on the ground` WITH `metres east of the datum` IS 0, `metres north of the datum` IS 0, `metres above the datum` IS 0) (`A place on the ground` WITH `metres east of the datum` IS 3, `metres north of the datum` IS 4, `metres above the datum` IS 100) EQUALS 5

-- ===================== PART IX: PROCEDURES AND PENALTIES (ss 66-72) =====================

-- 283. s 66(1): rules made by the authority with power to regulate the court's practice and procedure are rules of court
#ASSERT `they are rules of court` TRUE EQUALS TRUE
-- 284. s 66(3): that authority may make rules, including as to costs, for a newly conferred jurisdiction
#ASSERT `the authority may make rules or orders, including about costs, for the practice and procedure in exercising the jurisdiction` `it confers jurisdiction` EQUALS JUST TRUE
-- 286a. s 67(1a): an offence designated a crime is indictable
#ASSERT `the kind of offence it is` `designated as a crime` EQUALS `an indictable offence`
-- 286b. s 67(1a): an offence designated a misdemeanour is indictable
#ASSERT `the kind of offence it is` `designated as a misdemeanour` EQUALS `an indictable offence`
-- 287. s 67(2): an offence not otherwise designated is simple
#ASSERT `the kind of offence it is` `not otherwise designated` EQUALS `a simple offence`
-- 288. s 69(1): an enactment on an offence punishable on indictment refers to bodies corporate as well as individuals
#ASSERT `the enactment refers to the person` TRUE TRUE EQUALS JUST TRUE
-- 289. s 69(2): a penalty payable to a party aggrieved is payable to a body corporate that is the party aggrieved
#ASSERT `the penalty or sum is payable to the body corporate` TRUE TRUE EQUALS JUST TRUE
-- 290. s 71(1)(e): convicted 2024-06-10, failure continues through 2024-06-20: 10 separate and further offences
#ASSERT `the number of separate and further offences` (Date 10 6 2024) (Date 20 6 2024) EQUALS 10
-- 291a. s 71(1)(f): the default penalty for each further offence is 50 dollars
#ASSERT `the penalty for each separate and further offence` NOTHING EQUALS 50
-- 291b. s 71(1)(f): where the law provides 100 dollars: 100
#ASSERT `the penalty for each separate and further offence` (JUST 100) EQUALS 100
-- 292. s 71(1)(e): the day of conviction itself is not a further offence day
#ASSERT `the number of separate and further offences` (Date 10 6 2024) (Date 10 6 2024) EQUALS 0
-- 293. s 71(1)(d): the obligation to do the act continues after the period has expired, until it is done
#ASSERT `the obligation to do the act or thing continues` TRUE FALSE EQUALS TRUE
-- 294. s 71(2): convicted 2024-06-10, failure continues through 2024-06-15: 5 separate and further offences
#ASSERT `the number of separate and further offences` (Date 10 6 2024) (Date 15 6 2024) EQUALS 5
-- 295. s 72(1)(a): a penalty at the foot of a section makes contravention of the section an offence
#ASSERT `what is an offence with the penalty specified` `at the foot of a section, without qualification` FALSE EQUALS JUST `a contravention of the section`
-- 298. s 72(3): a reference to a section or subsection includes a clause or subclause of a schedule
#ASSERT `a reference to a section or subsection of an Act in section 72 includes` `a clause of a schedule to an Act` EQUALS JUST TRUE
-- 299. s 72(4): s 72 applies to subsidiary legislation by which offences may be created
#ASSERT `section 72 applies to it, with any modifications that are necessary` `subsidiary legislation` TRUE EQUALS JUST TRUE

-- ===================== PART X: MISCELLANEOUS (ss 73-77) =====================

-- 300. s 73: the State is deemed established on 1829-06-01 for Imperial Acts
#ASSERT `the day the State is deemed to have been established, for the applicability of Imperial Acts` EQUALS Date 1 6 1829
-- 301. s 74: a deviation that does not materially affect the substance and is not likely to mislead does not invalidate the form
#ASSERT `the deviation invalidates the form used` FALSE FALSE EQUALS JUST FALSE
-- 302. s 74: a deviation likely to mislead is not saved by s 74
#ASSERT NOT (`the deviation invalidates the form used` FALSE TRUE EQUALS JUST FALSE)
-- 303a. s 75(1): properly addressed, prepaid, as a letter, to the last known address: service deemed effected on the day it would be delivered in the ordinary course of post (2024-06-06)
#ASSERT `the day service by post is deemed effected` TRUE TRUE TRUE TRUE (Date 6 6 2024) NOTHING EQUALS JUST (Date 6 6 2024)
-- 303b. s 75(1): not prepaid: service is not deemed effected
#ASSERT `the day service by post is deemed effected` TRUE FALSE TRUE TRUE (Date 6 6 2024) NOTHING EQUALS NOTHING
-- 305. s 75(1): the contrary is proved (delivered 2024-06-09): the deemed time is displaced
#ASSERT `the day service by post is deemed effected` TRUE TRUE TRUE TRUE (Date 6 6 2024) (JUST (Date 9 6 2024)) EQUALS JUST (Date 9 6 2024)
-- 306. s 75(2): registered post required, document eligible for certified mail: either method
#ASSERT `service may be effected either by registered post or by certified mail` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- 307. s 75(3): the law requires a signed acknowledgment of delivery: certified mail may not be used instead
#ASSERT NOT (`service may be effected either by registered post or by certified mail` TRUE TRUE FALSE TRUE EQUALS JUST TRUE)
-- 308. s 75(3): a contrary intention appears: s 75(1) does not apply
