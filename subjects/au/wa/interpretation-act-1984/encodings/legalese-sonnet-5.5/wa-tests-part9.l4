IMPORT prelude
IMPORT daydate
IMPORT `wa-interpretation-nouns`
IMPORT `wa-interpretation-time`
IMPORT `wa-interpretation-part9`

-- Tests for wa-interpretation-part9.l4 (ss 66 to 72).  Expected values are written from the text.
-- Weekdays: 1 Jan 2025 is a Wednesday.

§ `Tests -- Part IX`

-- s 66(1)
#ASSERT `they are rules of court` TRUE
#ASSERT NOT (`they are rules of court` FALSE)
-- s 66(2)
#ASSERT `the authority's power includes making rules of court for the purpose of the written law` TRUE EQUALS JUST TRUE
#ASSERT `the authority's power includes making rules of court for the purpose of the written law` FALSE EQUALS NOTHING
-- s 66(3)
#ASSERT `the authority may make rules or orders, including about costs, for the practice and procedure in exercising the jurisdiction` `it confers jurisdiction` EQUALS JUST TRUE
#ASSERT `the authority may make rules or orders, including about costs, for the practice and procedure in exercising the jurisdiction` `it extends jurisdiction` EQUALS JUST TRUE
#ASSERT `the authority may make rules or orders, including about costs, for the practice and procedure in exercising the jurisdiction` `it varies jurisdiction` EQUALS JUST TRUE
#ASSERT `the authority may make rules or orders, including about costs, for the practice and procedure in exercising the jurisdiction` `it does none of these` EQUALS NOTHING

-- s 67(1), (1a), (2): two kinds
#ASSERT `the kind of offence it is` `designated as a crime` EQUALS `an indictable offence`
#ASSERT `the kind of offence it is` `designated as a misdemeanour` EQUALS `an indictable offence`
#ASSERT `the kind of offence it is` `designated as an indictable offence` EQUALS `an indictable offence`
#ASSERT `the kind of offence it is` `designated as a simple offence` EQUALS `a simple offence`
#ASSERT `the kind of offence it is` `not otherwise designated` EQUALS `a simple offence`
#ASSERT NOT (`the kind of offence it is` `not otherwise designated` EQUALS `an indictable offence`)
-- s 67(3) and (5)
#ASSERT `the Act that sets out the procedure for prosecuting and dealing with offences` EQUALS "Criminal Procedure Act 2004"
#ASSERT NOT (`section 67 limits the operation of Part 3 of the Children's Court of Western Australia Act 1988`)

-- s 69(1)
#ASSERT `the enactment refers to the person` TRUE TRUE EQUALS JUST TRUE
#ASSERT `the enactment refers to the person` TRUE FALSE EQUALS JUST TRUE
#ASSERT `the enactment refers to the person` FALSE TRUE EQUALS NOTHING
-- s 69(2)
#ASSERT `the penalty or sum is payable to the body corporate` TRUE TRUE EQUALS JUST TRUE
#ASSERT `the penalty or sum is payable to the body corporate` TRUE FALSE EQUALS NOTHING
#ASSERT `the penalty or sum is payable to the body corporate` FALSE TRUE EQUALS NOTHING

-- s 71(1): all three of (a) to (c)
#ASSERT `the provisions of section 71(1)(d) to (f) have effect` TRUE TRUE TRUE
#ASSERT NOT (`the provisions of section 71(1)(d) to (f) have effect` TRUE TRUE FALSE)
#ASSERT NOT (`the provisions of section 71(1)(d) to (f) have effect` TRUE FALSE TRUE)
#ASSERT NOT (`the provisions of section 71(1)(d) to (f) have effect` FALSE TRUE TRUE)
-- s 71(1)(d): the obligation continues until the act is done
#ASSERT `the obligation to do the act or thing continues` TRUE FALSE
#ASSERT NOT (`the obligation to do the act or thing continues` TRUE TRUE)
#ASSERT NOT (`the obligation to do the act or thing continues` FALSE FALSE)
-- s 71(1)(e): the count.  Convicted Monday 6 Jan 2025; failure continues through Friday 10 Jan: the days after the day of
-- conviction are 7, 8, 9 and 10 January, four days.
#ASSERT `the number of separate and further offences` (Date 6 1 2025) (Date 10 1 2025) EQUALS 4
-- failure ends on the day of conviction: none
#ASSERT `the number of separate and further offences` (Date 6 1 2025) (Date 6 1 2025) EQUALS 0
-- failure ended before conviction (data error): none, not a negative count
#ASSERT `the number of separate and further offences` (Date 6 1 2025) (Date 3 1 2025) EQUALS 0
-- the day after: one
#ASSERT `the number of separate and further offences` (Date 6 1 2025) (Date 7 1 2025) EQUALS 1
-- across a month end: convicted 30 Jan, continues to 2 Feb: 31 Jan, 1 Feb, 2 Feb
#ASSERT `the number of separate and further offences` (Date 30 1 2025) (Date 2 2 2025) EQUALS 3
-- s 71(1)(f): $50 unless otherwise provided
#ASSERT `the penalty for each separate and further offence` NOTHING EQUALS 50
#ASSERT `the penalty for each separate and further offence` (JUST 200) EQUALS 200
-- s 71(1)(e) conviction limb
#ASSERT `the person is guilty of separate and further offences` TRUE TRUE
#ASSERT NOT (`the person is guilty of separate and further offences` TRUE FALSE)
#ASSERT NOT (`the person is guilty of separate and further offences` FALSE TRUE)
-- s 71(2)
#ASSERT `the daily offences of section 71(2) arise` TRUE TRUE TRUE
#ASSERT NOT (`the daily offences of section 71(2) arise` TRUE TRUE FALSE)
#ASSERT NOT (`the daily offences of section 71(2) arise` TRUE FALSE TRUE)
#ASSERT NOT (`the daily offences of section 71(2) arise` FALSE TRUE TRUE)

-- s 72(1): the three layouts, with and without an express contrary provision
#ASSERT `what is an offence with the penalty specified` `at the foot of a section, without qualification` FALSE EQUALS JUST `a contravention of the section`
#ASSERT `what is an offence with the penalty specified` `at the foot of a subsection, but not at the foot of the section` FALSE EQUALS JUST `a contravention of the subsection`
#ASSERT `what is an offence with the penalty specified` `at the foot of a section and expressed to apply to specified subsections` FALSE EQUALS JUST `a contravention of any of the specified subsections`
#ASSERT `what is an offence with the penalty specified` `somewhere else` FALSE EQUALS NOTHING
#ASSERT `what is an offence with the penalty specified` `at the foot of a section, without qualification` TRUE EQUALS NOTHING
-- s 72(2)
#ASSERT `the penalty on conviction` `at the foot of a section, without qualification` TRUE 500 EQUALS JUST 500
#ASSERT `the penalty on conviction` `at the foot of a subsection, but not at the foot of the section` TRUE 2000 EQUALS JUST 2000
#ASSERT `the penalty on conviction` `at the foot of a section, without qualification` FALSE 500 EQUALS NOTHING
#ASSERT `the penalty on conviction` `somewhere else` TRUE 500 EQUALS NOTHING
-- s 72(3)
#ASSERT `a reference to a section or subsection of an Act in section 72 includes` `a clause of a schedule to an Act` EQUALS JUST TRUE
#ASSERT `a reference to a section or subsection of an Act in section 72 includes` `a subclause of a schedule to an Act` EQUALS JUST TRUE
#ASSERT `a reference to a section or subsection of an Act in section 72 includes` `something else` EQUALS NOTHING
-- s 72(4)
#ASSERT `section 72 applies to it, with any modifications that are necessary` `an Act` FALSE EQUALS JUST TRUE
#ASSERT `section 72 applies to it, with any modifications that are necessary` `subsidiary legislation` TRUE EQUALS JUST TRUE
#ASSERT `section 72 applies to it, with any modifications that are necessary` `subsidiary legislation` FALSE EQUALS NOTHING
