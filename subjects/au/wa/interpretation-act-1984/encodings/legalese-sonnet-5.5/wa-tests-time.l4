IMPORT prelude
IMPORT daydate
IMPORT `wa-interpretation-time`

-- Tests for wa-interpretation-time.l4.  Each expected value is written from the section cited beside it,
-- before the module was run; a failing assertion would be a finding, never an edit of the expected value.
-- Weekdays used below, by hand calendar arithmetic: 1 Jan 2026 is a Thursday, so Sat 3 Jan, Sun 4 Jan, Mon 5 Jan,
-- Sat 31 Jan, Sun 1 Feb, Mon 2 Feb 2026, Sat 28 Feb 2026, Sun 1 Mar, Mon 2 Mar 2026;
-- 1 Jan 2025 is a Wednesday, so Fri 14 Feb, Sat 15 Feb, Sun 16 Feb, Mon 17 Feb 2025,
-- Sat 1 Mar, Sun 2 Mar, Mon 3 Mar 2025, Fri 28 Feb 2025;
-- Thu 29 Feb 2024; Sun 16 Jul 2028, Sat 15 Jul 2028, Mon 17 Jul 2028; Tue 15 Jan 2030, Mon 14 Jan 2030;
-- Sun 1 Sep 2030, Sat 31 Aug 2030, Mon 2 Sep 2030.

§ `Tests -- interpretation time`

GIVETH A `Holidays that make an excluded day`
`no holidays` MEANS
    `Holidays that make an excluded day` WITH
        `public service holidays`            IS EMPTY
        `bank holidays in the relevant area`   IS EMPTY
        `public holidays in the relevant area` IS EMPTY

GIVEN a IS A LIST OF DATE
      b IS A LIST OF DATE
      c IS A LIST OF DATE
GIVETH A `Holidays that make an excluded day`
`holidays` a b c MEANS
    `Holidays that make an excluded day` WITH
        `public service holidays`            IS a
        `bank holidays in the relevant area`   IS b
        `public holidays in the relevant area` IS c

GIVEN n IS A NUMBER
      u IS A `Unit of a period`
      tie IS A `How a period is tied to a day`
      named IS A DATE
      h IS A `Holidays that make an excluded day`
GIVETH A MAYBE DATE
`test first day` n u tie named h MEANS
    CONSIDER `reckon a period` (`Period of time` WITH `number of units` IS n, `unit` IS u) tie named h
    WHEN JUST r THEN JUST (r's `first day`)
    WHEN NOTHING THEN NOTHING

GIVEN n IS A NUMBER
      u IS A `Unit of a period`
      tie IS A `How a period is tied to a day`
      named IS A DATE
      h IS A `Holidays that make an excluded day`
GIVETH A MAYBE DATE
`test last day by the calendar` n u tie named h MEANS
    CONSIDER `reckon a period` (`Period of time` WITH `number of units` IS n, `unit` IS u) tie named h
    WHEN JUST r THEN JUST (r's `end`'s `last day by the calendar`)
    WHEN NOTHING THEN NOTHING

GIVEN n IS A NUMBER
      u IS A `Unit of a period`
      tie IS A `How a period is tied to a day`
      named IS A DATE
      h IS A `Holidays that make an excluded day`
GIVETH A MAYBE DATE
`test last day for doing the thing` n u tie named h MEANS
    CONSIDER `reckon a period` (`Period of time` WITH `number of units` IS n, `unit` IS u) tie named h
    WHEN JUST r THEN JUST (r's `end`'s `last day for doing the thing`)
    WHEN NOTHING THEN NOTHING

GIVEN n IS A NUMBER
      u IS A `Unit of a period`
      named IS A DATE
      h IS A `Holidays that make an excluded day`
GIVETH A MAYBE DATE
`test last day for doing the thing, other reading` n u named h MEANS
    CONSIDER `reckon a period counting the named day as its first day, the other reading` (`Period of time` WITH `number of units` IS n, `unit` IS u) named h
    WHEN JUST r THEN JUST (r's `end`'s `last day for doing the thing`)
    WHEN NOTHING THEN NOTHING

GIVEN n IS A NUMBER
      u IS A `Unit of a period`
      named IS A DATE
GIVETH A MAYBE DATE
`test before first day` n u named MEANS
    CONSIDER `the time within a time before a day` (`Period of time` WITH `number of units` IS n, `unit` IS u) named `no holidays`
    WHEN JUST r THEN JUST (r's `first day`)
    WHEN NOTHING THEN NOTHING

GIVEN n IS A NUMBER
      u IS A `Unit of a period`
      named IS A DATE
GIVETH A MAYBE DATE
`test before last day by the calendar` n u named MEANS
    CONSIDER `the time within a time before a day` (`Period of time` WITH `number of units` IS n, `unit` IS u) named `no holidays`
    WHEN JUST r THEN JUST (r's `end`'s `last day by the calendar`)
    WHEN NOTHING THEN NOTHING

GIVEN n IS A NUMBER
      u IS A `Unit of a period`
      named IS A DATE
GIVETH A MAYBE DATE
`test before last day for doing the thing` n u named MEANS
    CONSIDER `the time within a time before a day` (`Period of time` WITH `number of units` IS n, `unit` IS u) named `no holidays`
    WHEN JUST r THEN JUST (r's `end`'s `last day for doing the thing`)
    WHEN NOTHING THEN NOTHING


§§ `Section 62(2) and (3) examples, tying the period to the day it begins on (s 61(1)(a))`

-- s 62(2) example: a month beginning on 15 January ends on 14 February.
#ASSERT `test last day by the calendar` 1 `in months` `begins at, on or with the day` (Date 15 1 2025) `no holidays` EQUALS JUST (Date 14 2 2025)
#ASSERT `test last day by the calendar` 1 `in months` `begins at, on or with the day` (Date 15 1 2024) `no holidays` EQUALS JUST (Date 14 2 2024)
-- s 62(2) example: a month beginning on 30 or 31 January ends on 28 February (or 29 February in a leap year).
#ASSERT `test last day by the calendar` 1 `in months` `begins at, on or with the day` (Date 30 1 2025) `no holidays` EQUALS JUST (Date 28 2 2025)
#ASSERT `test last day by the calendar` 1 `in months` `begins at, on or with the day` (Date 31 1 2025) `no holidays` EQUALS JUST (Date 28 2 2025)
#ASSERT `test last day by the calendar` 1 `in months` `begins at, on or with the day` (Date 30 1 2024) `no holidays` EQUALS JUST (Date 29 2 2024)
#ASSERT `test last day by the calendar` 1 `in months` `begins at, on or with the day` (Date 31 1 2024) `no holidays` EQUALS JUST (Date 29 2 2024)
-- s 62(3) example: a period of 6 months beginning on 15 August ends on 14 February.
#ASSERT `test last day by the calendar` 6 `in months` `begins at, on or with the day` (Date 15 8 2025) `no holidays` EQUALS JUST (Date 14 2 2026)
-- s 62(3) example: 6 months beginning on 30 or 31 August ends on 28 February (or 29 February in a leap year).
#ASSERT `test last day by the calendar` 6 `in months` `begins at, on or with the day` (Date 30 8 2025) `no holidays` EQUALS JUST (Date 28 2 2026)
#ASSERT `test last day by the calendar` 6 `in months` `begins at, on or with the day` (Date 31 8 2025) `no holidays` EQUALS JUST (Date 28 2 2026)
#ASSERT `test last day by the calendar` 6 `in months` `begins at, on or with the day` (Date 30 8 2023) `no holidays` EQUALS JUST (Date 29 2 2024)
#ASSERT `test last day by the calendar` 6 `in months` `begins at, on or with the day` (Date 31 8 2023) `no holidays` EQUALS JUST (Date 29 2 2024)
-- The pair that separates 'less one' from 'last day of the month': 28 Jan 2025 has a corresponding 28 Feb, so less one is 27 Feb; 29 Jan 2025 has no 29 Feb, so the last day, 28 Feb; 29 Jan 2024 has a corresponding 29 Feb, so less one is 28 Feb.
#ASSERT `test last day by the calendar` 1 `in months` `begins at, on or with the day` (Date 28 1 2025) `no holidays` EQUALS JUST (Date 27 2 2025)
#ASSERT `test last day by the calendar` 1 `in months` `begins at, on or with the day` (Date 29 1 2025) `no holidays` EQUALS JUST (Date 28 2 2025)
#ASSERT `test last day by the calendar` 1 `in months` `begins at, on or with the day` (Date 29 1 2024) `no holidays` EQUALS JUST (Date 28 2 2024)
-- s 62(1) calendar month: a month beginning on the first day of a month ends on the last day of that month.
#ASSERT `test last day by the calendar` 1 `in months` `begins at, on or with the day` (Date 1 1 2025) `no holidays` EQUALS JUST (Date 31 1 2025)
#ASSERT `test last day by the calendar` 1 `in months` `begins at, on or with the day` (Date 1 2 2024) `no holidays` EQUALS JUST (Date 29 2 2024)
#ASSERT `test last day by the calendar` 1 `in months` `begins at, on or with the day` (Date 1 2 2025) `no holidays` EQUALS JUST (Date 28 2 2025)
#ASSERT `test last day by the calendar` 1 `in months` `begins at, on or with the day` (Date 1 12 2025) `no holidays` EQUALS JUST (Date 31 12 2025)
#ASSERT `test last day by the calendar` 2 `in months` `begins at, on or with the day` (Date 1 1 2026) `no holidays` EQUALS JUST (Date 28 2 2026)
-- A month with 30 days: 31 March plus one month has no 31 April, so 30 April; and across a year end.
#ASSERT `test last day by the calendar` 1 `in months` `begins at, on or with the day` (Date 31 3 2025) `no holidays` EQUALS JUST (Date 30 4 2025)
#ASSERT `test last day by the calendar` 3 `in months` `begins at, on or with the day` (Date 15 11 2025) `no holidays` EQUALS JUST (Date 14 2 2026)
#ASSERT `test last day by the calendar` 2 `in months` `begins at, on or with the day` (Date 31 12 2025) `no holidays` EQUALS JUST (Date 28 2 2026)

§§ `The brief's worked cases: s 61(1)(b) 'from' excludes the named day, then s 62 runs from the first day`

-- Three years from 2025-07-16: first day 17 Jul 2025; 36 months (s 5 'year', s 62(3)); 17 Jul 2028 less one is 16 Jul 2028, a Sunday, so the next day not excluded is Mon 17 Jul 2028.
#ASSERT `test first day` 3 `in years` `is reckoned from or after the day` (Date 16 7 2025) `no holidays` EQUALS JUST (Date 17 7 2025)
#ASSERT `test last day by the calendar` 3 `in years` `is reckoned from or after the day` (Date 16 7 2025) `no holidays` EQUALS JUST (Date 16 7 2028)
#ASSERT `test last day for doing the thing` 3 `in years` `is reckoned from or after the day` (Date 16 7 2025) `no holidays` EQUALS JUST (Date 17 7 2028)
-- Five years from 2025-01-15: first day 16 Jan 2025; last day 15 Jan 2030, a Tuesday.
#ASSERT `test last day by the calendar` 5 `in years` `is reckoned from or after the day` (Date 15 1 2025) `no holidays` EQUALS JUST (Date 15 1 2030)
#ASSERT `test last day for doing the thing` 5 `in years` `is reckoned from or after the day` (Date 15 1 2025) `no holidays` EQUALS JUST (Date 15 1 2030)
-- Five years from 2025-09-01: first day 2 Sep 2025; last day 1 Sep 2030, a Sunday, so Mon 2 Sep 2030.
#ASSERT `test last day by the calendar` 5 `in years` `is reckoned from or after the day` (Date 1 9 2025) `no holidays` EQUALS JUST (Date 1 9 2030)
#ASSERT `test last day for doing the thing` 5 `in years` `is reckoned from or after the day` (Date 1 9 2025) `no holidays` EQUALS JUST (Date 2 9 2030)
-- Thirty days from 2026-01-01: first day 2 Jan 2026 is day 1, so day 30 is 31 Jan 2026, a Saturday, so Mon 2 Feb 2026.
#ASSERT `test first day` 30 `in days` `is reckoned from or after the day` (Date 1 1 2026) `no holidays` EQUALS JUST (Date 2 1 2026)
#ASSERT `test last day by the calendar` 30 `in days` `is reckoned from or after the day` (Date 1 1 2026) `no holidays` EQUALS JUST (Date 31 1 2026)
#ASSERT `test last day for doing the thing` 30 `in days` `is reckoned from or after the day` (Date 1 1 2026) `no holidays` EQUALS JUST (Date 2 2 2026)
-- Two months from 2025-12-31: first day 1 Jan 2026; 1 Mar 2026 less one is 28 Feb 2026, a Saturday, so Mon 2 Mar 2026.
#ASSERT `test last day by the calendar` 2 `in months` `is reckoned from or after the day` (Date 31 12 2025) `no holidays` EQUALS JUST (Date 28 2 2026)
#ASSERT `test last day for doing the thing` 2 `in months` `is reckoned from or after the day` (Date 31 12 2025) `no holidays` EQUALS JUST (Date 2 3 2026)
-- One month from 2024-01-31: first day 1 Feb 2024; 1 Mar 2024 less one is 29 Feb 2024, a Thursday.
#ASSERT `test last day by the calendar` 1 `in months` `is reckoned from or after the day` (Date 31 1 2024) `no holidays` EQUALS JUST (Date 29 2 2024)
#ASSERT `test last day for doing the thing` 1 `in months` `is reckoned from or after the day` (Date 31 1 2024) `no holidays` EQUALS JUST (Date 29 2 2024)
-- One year from 2024-02-29: first day 1 Mar 2024; 12 months; 1 Mar 2025 less one is 28 Feb 2025, a Friday.
#ASSERT `test last day by the calendar` 1 `in years` `is reckoned from or after the day` (Date 29 2 2024) `no holidays` EQUALS JUST (Date 28 2 2025)
#ASSERT `test last day for doing the thing` 1 `in years` `is reckoned from or after the day` (Date 29 2 2024) `no holidays` EQUALS JUST (Date 28 2 2025)

§§ `The other reading of the fork (F1): s 62 runs from the named day itself.  Not the reading taken; shown so the answer table can print both columns`

#ASSERT `test last day for doing the thing, other reading` 3 `in years` (Date 16 7 2025) `no holidays` EQUALS JUST (Date 17 7 2028)
#ASSERT `test last day for doing the thing, other reading` 5 `in years` (Date 15 1 2025) `no holidays` EQUALS JUST (Date 14 1 2030)
#ASSERT `test last day for doing the thing, other reading` 5 `in years` (Date 1 9 2025) `no holidays` EQUALS JUST (Date 2 9 2030)
#ASSERT `test last day for doing the thing, other reading` 30 `in days` (Date 1 1 2026) `no holidays` EQUALS JUST (Date 30 1 2026)
#ASSERT `test last day for doing the thing, other reading` 2 `in months` (Date 31 12 2025) `no holidays` EQUALS JUST (Date 2 3 2026)
#ASSERT `test last day for doing the thing, other reading` 1 `in months` (Date 31 1 2024) `no holidays` EQUALS JUST (Date 29 2 2024)
#ASSERT `test last day for doing the thing, other reading` 1 `in years` (Date 29 2 2024) `no holidays` EQUALS JUST (Date 28 2 2025)

§§ `Section 61(1)(a) and (b): the first day of a period, and counting days`

#ASSERT `the first day of a period` `begins at, on or with the day` (Date 10 3 2025) EQUALS (Date 10 3 2025)
#ASSERT `the first day of a period` `is reckoned from or after the day` (Date 10 3 2025) EQUALS (Date 11 3 2025)
-- 10 days beginning on 20 Feb 2025 (day 1 is 20 Feb): day 10 is 1 Mar 2025, a Saturday, so Mon 3 Mar.
#ASSERT `test last day by the calendar` 10 `in days` `begins at, on or with the day` (Date 20 2 2025) `no holidays` EQUALS JUST (Date 1 3 2025)
#ASSERT `test last day for doing the thing` 10 `in days` `begins at, on or with the day` (Date 20 2 2025) `no holidays` EQUALS JUST (Date 3 3 2025)
-- 10 days from 20 Feb 2025: day 1 is 21 Feb, day 10 is 2 Mar 2025, a Sunday, so Mon 3 Mar.
#ASSERT `test last day by the calendar` 10 `in days` `is reckoned from or after the day` (Date 20 2 2025) `no holidays` EQUALS JUST (Date 2 3 2025)
#ASSERT `test last day for doing the thing` 10 `in days` `is reckoned from or after the day` (Date 20 2 2025) `no holidays` EQUALS JUST (Date 3 3 2025)
-- One day from Wed 5 Mar 2025: the period is Thu 6 Mar 2025.
#ASSERT `test last day for doing the thing` 1 `in days` `is reckoned from or after the day` (Date 5 3 2025) `no holidays` EQUALS JUST (Date 6 3 2025)

§§ `Not covered: weeks (the Act does not define 'week'), a count that is not a whole number of at least 1`

#ASSERT `test first day` 2 `in weeks` `is reckoned from or after the day` (Date 5 3 2025) `no holidays` EQUALS NOTHING
#ASSERT `test last day for doing the thing` 2 `in weeks` `begins at, on or with the day` (Date 5 3 2025) `no holidays` EQUALS NOTHING
#ASSERT `test first day` 0 `in days` `is reckoned from or after the day` (Date 5 3 2025) `no holidays` EQUALS NOTHING
#ASSERT `test first day` (0 MINUS 3) `in days` `is reckoned from or after the day` (Date 5 3 2025) `no holidays` EQUALS NOTHING
#ASSERT `test first day` 2.5 `in months` `is reckoned from or after the day` (Date 5 3 2025) `no holidays` EQUALS NOTHING

§§ `Section 61(1)(e) and (h) with s 61(2): an excluded day at the end of the time`

-- Last day Sat 31 Jan 2026 (30 days from 1 Jan 2026): Sun 1 Feb is not a holiday, Mon 2 Feb is.
#ASSERT `test last day for doing the thing` 30 `in days` `is reckoned from or after the day` (Date 1 1 2026) (`holidays` EMPTY (LIST (Date 2 2 2026)) EMPTY) EQUALS JUST (Date 3 2 2026)
#ASSERT `test last day for doing the thing` 30 `in days` `is reckoned from or after the day` (Date 1 1 2026) (`holidays` EMPTY EMPTY (LIST (Date 2 2 2026))) EQUALS JUST (Date 3 2 2026)
#ASSERT `test last day for doing the thing` 30 `in days` `is reckoned from or after the day` (Date 1 1 2026) (`holidays` (LIST (Date 2 2 2026)) EMPTY EMPTY) EQUALS JUST (Date 3 2 2026)
-- A holiday on the Friday before a Saturday last day changes nothing.
#ASSERT `test last day for doing the thing` 30 `in days` `is reckoned from or after the day` (Date 1 1 2026) (`holidays` EMPTY (LIST (Date 30 1 2026)) EMPTY) EQUALS JUST (Date 2 2 2026)
-- Last day Fri 14 Feb 2025 (1 month beginning on 15 Jan) listed as a bank holiday: Sat, Sun, so Mon 17 Feb.
#ASSERT `test last day by the calendar` 1 `in months` `begins at, on or with the day` (Date 15 1 2025) `no holidays` EQUALS JUST (Date 14 2 2025)
#ASSERT `test last day for doing the thing` 1 `in months` `begins at, on or with the day` (Date 15 1 2025) (`holidays` EMPTY (LIST (Date 14 2 2025)) EMPTY) EQUALS JUST (Date 17 2 2025)
#ASSERT `test last day for doing the thing` 1 `in months` `begins at, on or with the day` (Date 15 1 2025) `no holidays` EQUALS JUST (Date 14 2 2025)
-- Section 61(1)(e) is not limited to periods in days: it moves the end of a period in months and in years (fork F2).
#ASSERT `test last day for doing the thing` 1 `in years` `is reckoned from or after the day` (Date 29 2 2024) (`holidays` (LIST (Date 28 2 2025)) EMPTY EMPTY) EQUALS JUST (Date 3 3 2025)
-- Section 61(1)(h): an act directed for a certain day that is an excluded day may be done on the next day that is not.
#ASSERT `the next day that is not an excluded day, counting the day itself` (Date 1 2 2026) `no holidays` EQUALS (Date 2 2 2026)
#ASSERT `the next day that is not an excluded day, counting the day itself` (Date 3 2 2026) `no holidays` EQUALS (Date 3 2 2026)
#ASSERT `the next day that is not an excluded day, counting the day itself` (Date 30 1 2026) (`holidays` EMPTY (LIST (Date 30 1 2026)) EMPTY) EQUALS (Date 2 2 2026)

§§ `Section 61(2): excluded days`

#ASSERT `is an excluded day` (Date 3 1 2026) `no holidays`
#ASSERT `is an excluded day` (Date 4 1 2026) `no holidays`
#ASSERT NOT (`is an excluded day` (Date 5 1 2026) `no holidays`)
#ASSERT NOT (`is an excluded day` (Date 7 1 2026) `no holidays`)
#ASSERT `is an excluded day` (Date 7 1 2026) (`holidays` (LIST (Date 7 1 2026)) EMPTY EMPTY)
#ASSERT `is an excluded day` (Date 7 1 2026) (`holidays` EMPTY (LIST (Date 7 1 2026)) EMPTY)
#ASSERT `is an excluded day` (Date 7 1 2026) (`holidays` EMPTY EMPTY (LIST (Date 7 1 2026)))
-- A public half-holiday is part of a day and is not listed in s 61(2), so it is not an excluded day (the person lists no date).
#ASSERT NOT (`is an excluded day` (Date 7 1 2026) (`holidays` EMPTY EMPTY (LIST (Date 8 1 2026))))

§§ `Section 61(1)(c), (d): within a time before a day; a period expressed to end on a day`

-- Within 7 days before Mon 10 Mar 2025: 3 Mar to 9 Mar; the named day is not included.
#ASSERT `test before first day` 7 `in days` (Date 10 3 2025) EQUALS JUST (Date 3 3 2025)
#ASSERT `test before last day by the calendar` 7 `in days` (Date 10 3 2025) EQUALS JUST (Date 9 3 2025)
-- Fork F3: s 61(1)(e) read literally also moves that window's last day (Sunday 9 Mar) to the next day not excluded, Monday 10 Mar, the named day itself.
#ASSERT `test before last day for doing the thing` 7 `in days` (Date 10 3 2025) EQUALS JUST (Date 10 3 2025)
-- A time in months or in weeks before a day: s 62 reckons forward only, and 'week' is not defined: not covered.
#ASSERT `the time within a time before a day` (`Period of time` WITH `number of units` IS 2, `unit` IS `in months`) (Date 10 3 2025) `no holidays` EQUALS NOTHING
#ASSERT `the time within a time before a day` (`Period of time` WITH `number of units` IS 2, `unit` IS `in weeks`) (Date 10 3 2025) `no holidays` EQUALS NOTHING
-- A period expressed to end on Fri 14 Mar 2025 includes that day.
#ASSERT (`the end of a period expressed to end on` (Date 14 3 2025) `no holidays`)'s `last day by the calendar` EQUALS (Date 14 3 2025)
#ASSERT (`the end of a period expressed to end on` (Date 15 3 2025) `no holidays`)'s `last day for doing the thing` EQUALS (Date 17 3 2025)

§§ `Section 61(1)(f) and (g): a number of days between two events (events on 1 Mar and 10 Mar 2025)`

#ASSERT `the number of days counted between two events` `clear days` (Date 1 3 2025) (Date 10 3 2025) EQUALS 8
#ASSERT `the number of days counted between two events` `at least or not less than a number of days` (Date 1 3 2025) (Date 10 3 2025) EQUALS 8
#ASSERT `the number of days counted between two events` `a number of days not expressed in either of those ways` (Date 1 3 2025) (Date 10 3 2025) EQUALS 9
#ASSERT `the number of days counted between two events` `clear days` (Date 1 3 2025) (Date 2 3 2025) EQUALS 0
#ASSERT `the number of days counted between two events` `a number of days not expressed in either of those ways` (Date 1 3 2025) (Date 2 3 2025) EQUALS 1
-- Across the end of February: 27 Feb and 2 Mar 2025 (28 Feb and 1 Mar between them).
#ASSERT `the number of days counted between two events` `clear days` (Date 27 2 2025) (Date 2 3 2025) EQUALS 2

§§ `Section 63: no time fixed; section 64: extension after expiry`

#ASSERT `the act or thing must be done with all convenient speed and as often as occasion arises` FALSE
#ASSERT NOT (`the act or thing must be done with all convenient speed and as often as occasion arises` TRUE)
#ASSERT `the last day for an act or thing when no time may be fixed` FALSE (Date 10 3 2025) EQUALS NOTHING
#ASSERT `the last day for an act or thing when no time may be fixed` TRUE (Date 10 3 2025) EQUALS JUST (Date 10 3 2025)
#ASSERT `an application to extend may be made after the time has expired` TRUE (Date 1 7 1985) FALSE EQUALS JUST TRUE
#ASSERT `an application to extend may be made after the time has expired` TRUE (Date 1 7 1984) FALSE EQUALS JUST TRUE
#ASSERT `an application to extend may be made after the time has expired` TRUE (Date 30 6 1984) FALSE EQUALS NOTHING
#ASSERT `an application to extend may be made after the time has expired` TRUE (Date 1 1 1990) TRUE EQUALS NOTHING
#ASSERT `an application to extend may be made after the time has expired` FALSE (Date 1 1 1990) FALSE EQUALS NOTHING

§§ `Sections 2 and 3(3): the Act's own day, and the date gate`

#ASSERT `the day this Act came into operation` EQUALS (Date 1 7 1984)
#ASSERT `counts as passed or made after the commencement for ss 17, 25, 43(6), 50 and 64` (Date 1 7 1984) FALSE
#ASSERT NOT (`counts as passed or made after the commencement for ss 17, 25, 43(6), 50 and 64` (Date 30 6 1984) FALSE)
#ASSERT NOT (`counts as passed or made after the commencement for ss 17, 25, 43(6), 50 and 64` (Date 1 1 2020) TRUE)

§§ `Section 5: the Act's words for a length of time`

#ASSERT `what the Act says a word for a length of time means` `the word day` EQUALS NOTHING
#ASSERT `what the Act says a word for a length of time means` `the word week` EQUALS NOTHING
#ASSERT `what the Act says a word for a length of time means` `the word month` EQUALS JUST `a calendar month, reckoned under section 62`
#ASSERT `what the Act says a word for a length of time means` `the word year` EQUALS JUST `a period of 12 months`
#ASSERT `what the Act says a word for a length of time means` `the words financial year` EQUALS JUST `the period of 12 months ending on 30 June`
#ASSERT `the first day of the financial year ending in` 2026 EQUALS (Date 1 7 2025)
#ASSERT `the last day of the financial year ending in` 2026 EQUALS (Date 30 6 2026)
#ASSERT `the calendar year in which the financial year containing the date ends` (Date 15 6 2025) EQUALS 2025
#ASSERT `the calendar year in which the financial year containing the date ends` (Date 30 6 2025) EQUALS 2025
#ASSERT `the calendar year in which the financial year containing the date ends` (Date 1 7 2025) EQUALS 2026
#ASSERT `the calendar year in which the financial year containing the date ends` (Date 31 12 2025) EQUALS 2026
#ASSERT `the calendar year in which the financial year containing the date ends` (Date 1 1 2026) EQUALS 2026

§§ `Part III: when a written law comes into operation`

-- s 20(1): an Act assented to before 1 July 1984 comes into operation on the day of Royal Assent; the Interpretation Act 1984 was assented to on 31 May 1984 (compilation table).
#ASSERT `the day an Act comes into operation` `Royal Assent given` (Date 31 5 1984) NOTHING `nothing about it` EQUALS JUST (Date 31 5 1984)
#ASSERT `the day an Act comes into operation` `Royal Assent given` (Date 30 6 1984) NOTHING `nothing about it` EQUALS JUST (Date 30 6 1984)
-- s 20(2): assent on or after 1 July 1984: the 28th day after the day of assent.
#ASSERT `the day an Act comes into operation` `Royal Assent given` (Date 1 7 1984) NOTHING `nothing about it` EQUALS JUST (Date 29 7 1984)
#ASSERT `the day an Act comes into operation` `Royal Assent given` (Date 10 12 1997) NOTHING `nothing about it` EQUALS JUST (Date 7 1 1998)
#ASSERT `the day an Act comes into operation` `Royal Assent given` (Date 14 4 2022) NOTHING `nothing about it` EQUALS JUST (Date 12 5 2022)
-- s 20(3): an Act reserved for Her Majesty's pleasure on or after 1 July 1984 comes into operation on the day her assent is proclaimed in the Gazette.
#ASSERT `the day an Act comes into operation` `reserved for the signification of Her Majesty's pleasure` (Date 1 3 1985) (JUST (Date 5 8 1985)) `nothing about it` EQUALS JUST (Date 5 8 1985)
#ASSERT `the day an Act comes into operation` `reserved for the signification of Her Majesty's pleasure` (Date 1 3 1985) NOTHING `nothing about it` EQUALS NOTHING
#ASSERT `the day an Act comes into operation` `reserved for the signification of Her Majesty's pleasure` (Date 30 6 1984) (JUST (Date 5 8 1985)) `nothing about it` EQUALS NOTHING
-- 'Unless the contrary intention appears in the Act': this Act's own s 2 gives 1 July 1984; the Legislation Act 2021 (assent 24 Aug 2021) commenced on 1 Jul 2023 by proclamation (compilation table); the Assisted Reproductive Technology and Surrogacy Act 2025 is 'to be proclaimed'.
#ASSERT `the day an Act comes into operation` `Royal Assent given` (Date 31 5 1984) NOTHING (`a particular day` (Date 1 7 1984)) EQUALS JUST (Date 1 7 1984)
#ASSERT `the day an Act comes into operation` `Royal Assent given` (Date 24 8 2021) NOTHING (`a day to be fixed by proclamation` (JUST (Date 1 7 2023))) EQUALS JUST (Date 1 7 2023)
#ASSERT `the day an Act comes into operation` `Royal Assent given` (Date 18 12 2025) NOTHING (`a day to be fixed by proclamation` NOTHING) EQUALS NOTHING
-- s 21: at the beginning of the day.  Moments are (calendar day, second of the day).
#ASSERT `the moment a written law comes into operation` (Date 1 7 1984) EQUALS (`Moment of a day` WITH `the calendar day` IS (Date 1 7 1984), `second of the day` IS 0)
#ASSERT `a written law is in operation at` (`Moment of a day` WITH `the calendar day` IS (Date 1 7 1984), `second of the day` IS 0) `given that it comes into operation on` (Date 1 7 1984)
#ASSERT `a written law is in operation at` (`Moment of a day` WITH `the calendar day` IS (Date 1 7 1984), `second of the day` IS 86399) `given that it comes into operation on` (Date 1 7 1984)
#ASSERT `a written law is in operation at` (`Moment of a day` WITH `the calendar day` IS (Date 2 7 1984), `second of the day` IS 0) `given that it comes into operation on` (Date 1 7 1984)
#ASSERT NOT (`a written law is in operation at` (`Moment of a day` WITH `the calendar day` IS (Date 30 6 1984), `second of the day` IS 86399) `given that it comes into operation on` (Date 1 7 1984))
-- s 22: the commencement provision and the short title commence on the day of Royal Assent, unless expressly provided otherwise.
#ASSERT `the day the proclamation provision and the short title come into operation` (Date 10 12 1997) NOTHING EQUALS (Date 10 12 1997)
#ASSERT `the day the proclamation provision and the short title come into operation` (Date 10 12 1997) (JUST (Date 1 1 1998)) EQUALS (Date 1 1 1998)
-- s 23(a): the day fixed may be the day of publication, not an earlier day (unless express provision is made).
#ASSERT `the power to fix a day extends to a day not prior to publication` (Date 5 3 2025) (Date 5 3 2025) FALSE
#ASSERT `the power to fix a day extends to a day not prior to publication` (Date 5 3 2025) (Date 6 3 2025) FALSE
#ASSERT NOT (`the power to fix a day extends to a day not prior to publication` (Date 5 3 2025) (Date 4 3 2025) FALSE)
#ASSERT `the power to fix a day extends to a day not prior to publication` (Date 5 3 2025) (Date 4 3 2025) TRUE
-- s 23(b): one day only, unless express provision is made for different days.
#ASSERT `the power to fix a day extends to the number of different days fixed` 1 FALSE
#ASSERT NOT (`the power to fix a day extends to the number of different days fixed` 2 FALSE)
#ASSERT `the power to fix a day extends to the number of different days fixed` 2 TRUE
-- s 25(3): the later of the commencement day and the day it would have taken effect had the provision commenced.
#ASSERT `the day an instrument or notice made early takes effect` (Date 1 7 2025) (Date 15 3 2025) EQUALS (Date 1 7 2025)
#ASSERT `the day an instrument or notice made early takes effect` (Date 1 7 2025) (Date 10 8 2025) EQUALS (Date 10 8 2025)
#ASSERT `the day an instrument or notice made early takes effect` (Date 1 7 2025) (Date 1 7 2025) EQUALS (Date 1 7 2025)
-- s 27: the commencement of the appropriate provisions.
#ASSERT `the day a reference to commencement means` "Part 2" (LIST (`Commencement of one provision` WITH `the provision` IS "Part 1", `its commencement day` IS (Date 1 1 2000)), (`Commencement of one provision` WITH `the provision` IS "Part 2", `its commencement day` IS (Date 1 7 2000))) EQUALS JUST (Date 1 7 2000)
#ASSERT `the day a reference to commencement means` "Part 1" (LIST (`Commencement of one provision` WITH `the provision` IS "Part 1", `its commencement day` IS (Date 1 1 2000)), (`Commencement of one provision` WITH `the provision` IS "Part 2", `its commencement day` IS (Date 1 7 2000))) EQUALS JUST (Date 1 1 2000)
#ASSERT `the day a reference to commencement means` "Part 3" (LIST (`Commencement of one provision` WITH `the provision` IS "Part 1", `its commencement day` IS (Date 1 1 2000)), (`Commencement of one provision` WITH `the provision` IS "Part 2", `its commencement day` IS (Date 1 7 2000))) EQUALS NOTHING
-- s 41: subsidiary legislation commences on the day of publication or on the day specified.
#ASSERT `the day subsidiary legislation comes into operation` (Date 5 3 2025) NOTHING EQUALS (Date 5 3 2025)
#ASSERT `the day subsidiary legislation comes into operation` (Date 5 3 2025) (JUST (Date 1 4 2025)) EQUALS (Date 1 4 2025)
#ASSERT `the power to fix a day for subsidiary legislation extends to the number of different days fixed` 1 FALSE
#ASSERT NOT (`the power to fix a day for subsidiary legislation extends to the number of different days fixed` 2 FALSE)
#ASSERT `the power to fix a day for subsidiary legislation extends to the number of different days fixed` 2 TRUE

§§ `Section 48A: judicial acts and service of process on any day`

#ASSERT `the power may be exercised on` (Date 4 1 2026) `if` TRUE EQUALS JUST TRUE
#ASSERT `the power may be exercised on` (Date 25 12 2025) `if` TRUE EQUALS JUST TRUE
#ASSERT `the power may be exercised on` (Date 7 1 2026) `if` TRUE EQUALS JUST TRUE
#ASSERT `the power may be exercised on` (Date 4 1 2026) `if` FALSE EQUALS NOTHING

§§ `Section 75(1): service by post`

#ASSERT `the day service by post is deemed effected` TRUE TRUE TRUE TRUE (Date 10 3 2025) NOTHING EQUALS JUST (Date 10 3 2025)
#ASSERT `the day service by post is deemed effected` TRUE TRUE TRUE TRUE (Date 10 3 2025) (JUST (Date 12 3 2025)) EQUALS JUST (Date 12 3 2025)
#ASSERT `the day service by post is deemed effected` FALSE TRUE TRUE TRUE (Date 10 3 2025) NOTHING EQUALS NOTHING
#ASSERT `the day service by post is deemed effected` TRUE FALSE TRUE TRUE (Date 10 3 2025) NOTHING EQUALS NOTHING
#ASSERT `the day service by post is deemed effected` TRUE TRUE FALSE TRUE (Date 10 3 2025) NOTHING EQUALS NOTHING
#ASSERT `the day service by post is deemed effected` TRUE TRUE TRUE FALSE (Date 10 3 2025) NOTHING EQUALS NOTHING
