IMPORT prelude
IMPORT daydate
IMPORT `wa-interpretation-time`
IMPORT `wa-interpretation-nouns`
IMPORT `wa-interpretation-part2`

-- Tests for wa-interpretation-part2.l4 (ss 6 to 19).  Expected values are written from the text.

§ `Tests -- Part II, sections 6 to 19`

-- s 6
#ASSERT `a definition or rule of interpretation applies to the provision` `it is a provision that contains the definition or rule` EQUALS JUST TRUE
#ASSERT `a definition or rule of interpretation applies to the provision` `it is another provision of the same written law` EQUALS JUST TRUE
#ASSERT `a definition or rule of interpretation applies to the provision` `it is a provision of a different written law` EQUALS NOTHING

-- s 7
#ASSERT `the extent of validity of an enactment` FALSE EQUALS `valid in full`
#ASSERT `the extent of validity of an enactment` TRUE EQUALS `valid to the extent to which it is not in excess of the legislative power of the State`

-- s 8
#ASSERT `a present tense provision applies to the circumstance as it arises` (Date 1 1 2030) (Date 1 1 2000) EQUALS JUST TRUE
#ASSERT `a present tense provision applies to the circumstance as it arises` (Date 1 1 2000) (Date 1 1 2000) EQUALS JUST TRUE
#ASSERT `a present tense provision applies to the circumstance as it arises` (Date 31 12 1999) (Date 1 1 2000) EQUALS NOTHING

-- s 9
#ASSERT `the word has a corresponding meaning` TRUE EQUALS JUST TRUE
#ASSERT `the word has a corresponding meaning` FALSE EQUALS NOTHING

-- s 10(a), (c)
#ASSERT `a word indicating a person of a particular gender or sex includes` `an individual, of any gender or sex` EQUALS JUST TRUE
#ASSERT `a word indicating a person of a particular gender or sex includes` `a person that is not an individual` EQUALS JUST TRUE
#ASSERT `a word indicating a person of a particular gender or sex includes` `something that is not a person` EQUALS NOTHING
#ASSERT `the numbers a word in this number covers` `singular` EQUALS LIST `singular`, `plural`
#ASSERT `the numbers a word in this number covers` `plural` EQUALS LIST `singular`, `plural`

-- s 11
#ASSERT `the Sovereign meant by the reference` TRUE "the present Sovereign" EQUALS JUST "the present Sovereign"
#ASSERT `the Sovereign meant by the reference` FALSE "the present Sovereign" EQUALS NOTHING

-- s 12
#ASSERT `the Ministers a reference to the Minister covers` `an Act` "Minister A" NOTHING EQUALS LIST "Minister A"
#ASSERT `the Ministers a reference to the Minister covers` `subsidiary legislation` "Minister A" (JUST "Minister B") EQUALS LIST "Minister A", "Minister B"
#ASSERT `the Ministers a reference to the Minister covers` `an Act` "Minister A" (JUST "Minister B") EQUALS LIST "Minister A", "Minister B"

-- s 13(1): the section's own two definitions
#ASSERT `the Act that Commonwealth Act means in section 13` EQUALS "Australian Citizenship Act 1948"
#ASSERT `it is a law of the State` TRUE TRUE
#ASSERT NOT (`it is a law of the State` TRUE FALSE)
#ASSERT NOT (`it is a law of the State` FALSE TRUE)
-- s 13(2), (3)
#ASSERT `a reference to a British subject is read as a reference to the person` `an Australian citizen`
#ASSERT `a reference to a British subject is read as a reference to the person` `a person who has the status of a British subject under the Commonwealth Act`
#ASSERT `a reference to a British subject is read as a reference to the person` `a person who has the status of a British subject without citizenship under the Commonwealth Act`
#ASSERT NOT (`a reference to a British subject is read as a reference to the person` `a person with none of those statuses`)
#ASSERT `a rule of law about British subjects applies to the person as if a British subject` `an Australian citizen`
#ASSERT NOT (`a rule of law about British subjects applies to the person as if a British subject` `a person with none of those statuses`)

-- s 13A(1), (3): sex of the persons and other relationships make no difference; a legal marriage is not de facto
#ASSERT `a de facto relationship exists between two persons` TRUE FALSE TRUE FALSE
#ASSERT `a de facto relationship exists between two persons` TRUE FALSE FALSE FALSE
#ASSERT `a de facto relationship exists between two persons` TRUE FALSE TRUE TRUE
#ASSERT NOT (`a de facto relationship exists between two persons` FALSE FALSE TRUE FALSE)
#ASSERT NOT (`a de facto relationship exists between two persons` TRUE TRUE TRUE FALSE)
-- s 13A(2): the factors are counted; none of them is essential
#ASSERT `the number of indicators present` (`Indicators of a de facto relationship` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS 0
#ASSERT `the number of indicators present` (`Indicators of a de facto relationship` OF TRUE, TRUE, FALSE, FALSE, TRUE, FALSE, FALSE, TRUE, FALSE) EQUALS 4
#ASSERT `the number of indicators present` (`Indicators of a de facto relationship` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS 9
-- s 13A(4), (5)
#ASSERT `a person is a de facto partner` TRUE FALSE FALSE
#ASSERT `a person is a de facto partner` FALSE TRUE TRUE
#ASSERT NOT (`a person is a de facto partner` FALSE TRUE FALSE)
#ASSERT NOT (`a person is a de facto partner` FALSE FALSE TRUE)
#ASSERT `the other person is the de facto partner of the first person` TRUE
#ASSERT NOT (`the other person is the de facto partner of the first person` FALSE)

-- s 13B
#ASSERT `the body a reference to the Standards Association of Australia is read as` FALSE EQUALS JUST "Standards Australia"
#ASSERT `the body a reference to the Standards Association of Australia is read as` TRUE EQUALS NOTHING

-- s 13CA: the text's two examples, and a name that is not a district under the Local Government Act 1995
-- s 13CA(1)
#ASSERT `it is a local government district` TRUE
#ASSERT NOT (`it is a local government district` FALSE)
#ASSERT `the local government district a name refers to` "Perth" (LIST "Perth", "Narrogin (Shire)") EQUALS JUST "Perth"
#ASSERT `the local government district a name refers to` "Narrogin (Shire)" (LIST "Perth", "Narrogin (Shire)") EQUALS JUST "Narrogin (Shire)"
#ASSERT `the local government district a name refers to` "Narrogin" (LIST "Perth", "Narrogin (Shire)") EQUALS NOTHING

-- s 13C
#ASSERT `the person has died` TRUE FALSE
#ASSERT `the person has died` FALSE TRUE
#ASSERT `the person has died` TRUE TRUE
#ASSERT NOT (`the person has died` FALSE FALSE)

-- s 13D(1), (2)
#ASSERT `the person is a bankrupt` (`Insolvency facts about a person` OF TRUE, FALSE, FALSE, FALSE, FALSE)
#ASSERT `the person is a bankrupt` (`Insolvency facts about a person` OF FALSE, TRUE, FALSE, FALSE, FALSE)
#ASSERT NOT (`the person is a bankrupt` (`Insolvency facts about a person` OF FALSE, FALSE, TRUE, TRUE, TRUE))
#ASSERT `the person is a bankrupt or a person whose affairs are under insolvency laws` (`Insolvency facts about a person` OF TRUE, FALSE, FALSE, FALSE, FALSE)
#ASSERT `the person is a bankrupt or a person whose affairs are under insolvency laws` (`Insolvency facts about a person` OF FALSE, TRUE, FALSE, FALSE, FALSE)
#ASSERT `the person is a bankrupt or a person whose affairs are under insolvency laws` (`Insolvency facts about a person` OF FALSE, FALSE, TRUE, FALSE, FALSE)
#ASSERT `the person is a bankrupt or a person whose affairs are under insolvency laws` (`Insolvency facts about a person` OF FALSE, FALSE, FALSE, TRUE, FALSE)
#ASSERT `the person is a bankrupt or a person whose affairs are under insolvency laws` (`Insolvency facts about a person` OF FALSE, FALSE, FALSE, FALSE, TRUE)
#ASSERT NOT (`the person is a bankrupt or a person whose affairs are under insolvency laws` (`Insolvency facts about a person` OF FALSE, FALSE, FALSE, FALSE, FALSE))

-- s 14: first-mentioned and last-mentioned portions are both included
#ASSERT `the portions a reference covers` (LIST "1", "2", "3", "4", "5") "2" "4" EQUALS LIST "2", "3", "4"
#ASSERT `the portions a reference covers` (LIST "1", "2", "3", "4", "5") "1" "5" EQUALS LIST "1", "2", "3", "4", "5"
#ASSERT `the portions a reference covers` (LIST "1", "2", "3", "4", "5") "3" "3" EQUALS LIST "3"
#ASSERT `the portions a reference covers` (LIST "1", "2", "3", "4", "5") "6" "7" EQUALS EMPTY

-- s 15(1) to (3), (4)
#ASSERT `an internal reference points at` `a Part, Chapter, section, schedule, appendix or form` FALSE EQUALS `the Act in which the reference is made`
#ASSERT `an internal reference points at` `a subsection, paragraph, subparagraph or other division of a provision` FALSE EQUALS `the provision in which the reference is made`
#ASSERT `an internal reference points at` `a clause, subclause, paragraph or other division in a schedule` FALSE EQUALS `the schedule, or the provision of the schedule, in which the reference is made`
#ASSERT `an internal reference points at` `a Part, Chapter, section, schedule, appendix or form` TRUE EQUALS `the other Act, provision or schedule the context indicates`
#ASSERT `an internal reference points at` `a subsection, paragraph, subparagraph or other division of a provision` TRUE EQUALS `the other Act, provision or schedule the context indicates`
#ASSERT `section 15(1) to (3) applies to the written law with the necessary modifications` `an Act`
#ASSERT `section 15(1) to (3) applies to the written law with the necessary modifications` `subsidiary legislation`

-- s 15A
#ASSERT `a reference to a paragraph includes` `a paragraph` EQUALS JUST TRUE
#ASSERT `a reference to a paragraph includes` `a subparagraph` EQUALS JUST TRUE
#ASSERT `a reference to a paragraph includes` `an item` EQUALS JUST TRUE
#ASSERT `a reference to a paragraph includes` `a subitem` EQUALS JUST TRUE
#ASSERT `a reference to a paragraph includes` `any other similar provision` EQUALS JUST TRUE
#ASSERT `a reference to a paragraph includes` `a section` EQUALS NOTHING
#ASSERT `a reference to a paragraph includes the conjunction` TRUE EQUALS JUST TRUE
#ASSERT `a reference to a paragraph includes the conjunction` FALSE EQUALS NOTHING

-- s 16
#ASSERT `the reference includes the law as it may from time to time be amended` `a written law` EQUALS JUST TRUE
#ASSERT `the reference includes the law as it may from time to time be amended` `a provision of a written law` EQUALS JUST TRUE
#ASSERT `the reference includes the law as it may from time to time be amended` `an Imperial Act or a Commonwealth Act` EQUALS JUST TRUE
#ASSERT `the reference includes the law as it may from time to time be amended` `a provision of an Imperial Act or a Commonwealth Act` EQUALS JUST TRUE
#ASSERT `the reference includes the law as it may from time to time be amended` `a document that is not a written law` EQUALS NOTHING

-- s 17: only for a law passed or made after commencement (with s 3(3)); "similar" reverses it
#ASSERT `the word is read disjunctively and not as implying similarity` `the word or` (Date 1 1 2000) FALSE FALSE EQUALS JUST TRUE
#ASSERT `the word is read disjunctively and not as implying similarity` `the word other` (Date 1 1 2000) FALSE FALSE EQUALS JUST TRUE
#ASSERT `the word is read disjunctively and not as implying similarity` `the word otherwise` (Date 1 1 2000) FALSE FALSE EQUALS JUST TRUE
#ASSERT `the word is read disjunctively and not as implying similarity` `the word or` (Date 1 1 2000) FALSE TRUE EQUALS JUST FALSE
#ASSERT `the word is read disjunctively and not as implying similarity` `the word or` (Date 30 6 1984) FALSE FALSE EQUALS NOTHING
#ASSERT `the word is read disjunctively and not as implying similarity` `the word or` (Date 1 1 2000) TRUE FALSE EQUALS NOTHING

-- s 18
#ASSERT `the construction preferred` TRUE FALSE EQUALS `the first construction`
#ASSERT `the construction preferred` FALSE TRUE EQUALS `the second construction`
#ASSERT `the construction preferred` TRUE TRUE EQUALS `neither is preferred by this section`
#ASSERT `the construction preferred` FALSE FALSE EQUALS `neither is preferred by this section`

-- s 19(1)
#ASSERT `consideration may be given to the material` TRUE `to confirm that the meaning is the ordinary meaning conveyed by the text, taking account of its context and the purpose or object`
#ASSERT `consideration may be given to the material` TRUE `because the provision is ambiguous or obscure`
#ASSERT `consideration may be given to the material` TRUE `because the ordinary meaning leads to a result that is manifestly absurd or is unreasonable`
#ASSERT NOT (`consideration may be given to the material` TRUE `for some other reason`)
#ASSERT NOT (`consideration may be given to the material` FALSE `because the provision is ambiguous or obscure`)
-- s 19(2)
#ASSERT `material of this kind is among the material that may be considered` `a matter not forming part of the law, set out in an official version of the law under the Legislation Act 2021` FALSE EQUALS JUST TRUE
#ASSERT `material of this kind is among the material that may be considered` `a report of a Royal Commission, Law Reform Commission, committee of inquiry or other similar body, laid before either House of Parliament` TRUE EQUALS JUST TRUE
#ASSERT `material of this kind is among the material that may be considered` `a report of a Royal Commission, Law Reform Commission, committee of inquiry or other similar body, laid before either House of Parliament` FALSE EQUALS JUST FALSE
#ASSERT `material of this kind is among the material that may be considered` `a report of a committee of Parliament or of either House, made to Parliament or that House` TRUE EQUALS JUST TRUE
#ASSERT `material of this kind is among the material that may be considered` `a report of a committee of Parliament or of either House, made to Parliament or that House` FALSE EQUALS JUST FALSE
#ASSERT `material of this kind is among the material that may be considered` `a treaty or other international agreement referred to in the written law` FALSE EQUALS JUST TRUE
#ASSERT `material of this kind is among the material that may be considered` `an explanatory memorandum, or other relevant document, laid before or furnished to the members of either House by a Minister` TRUE EQUALS JUST TRUE
#ASSERT `material of this kind is among the material that may be considered` `an explanatory memorandum, or other relevant document, laid before or furnished to the members of either House by a Minister` FALSE EQUALS JUST FALSE
#ASSERT `material of this kind is among the material that may be considered` `the speech of a Minister moving the second reading of the Bill in a House` FALSE EQUALS JUST TRUE
#ASSERT `material of this kind is among the material that may be considered` `a document declared by the written law to be a relevant document for the purposes of section 19` FALSE EQUALS JUST TRUE
#ASSERT `material of this kind is among the material that may be considered` `relevant material in an official record of proceedings in either House` FALSE EQUALS JUST TRUE
#ASSERT `material of this kind is among the material that may be considered` `material of some other kind` TRUE EQUALS NOTHING
-- s 19(3): two matters
#ASSERT sum (map (GIVEN m YIELD 1) `the matters regard must be had to when deciding whether to consider material, and what weight to give it`) EQUALS 2
