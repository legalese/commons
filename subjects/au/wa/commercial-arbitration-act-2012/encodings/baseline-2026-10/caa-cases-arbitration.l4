§ `ss 1, 7 -- is my arbitration agreement binding (d038)`

#ASSERT `Is my arbitration agreement in writing` `a signed contract with an arbitration clause (d038)`
#ASSERT NOT `Is my arbitration agreement in writing` `an oral agreement to arbitrate, never recorded`
#ASSERT `Is my arbitration agreement in writing` `an agreement by email exchange`
#ASSERT `Is my arbitration agreement in writing` `an oral agreement alleged in the claim and not denied`
#ASSERT `Is my arbitration agreement in writing` `a contract incorporating standard terms with an arbitration clause`

#ASSERT `Do I have an arbitration agreement` `a signed contract with an arbitration clause (d038)`
#ASSERT NOT `Do I have an arbitration agreement` `an oral agreement to arbitrate, never recorded`
#ASSERT NOT `Do I have an arbitration agreement` `a recorded contract with no agreement to arbitrate`

#ASSERT `Is my arbitration a domestic commercial arbitration` `a signed contract with an arbitration clause (d038)`
#ASSERT NOT `Is my arbitration a domestic commercial arbitration` `a clause with a party based in Singapore`
#ASSERT NOT `Is my arbitration a domestic commercial arbitration` `a clause in an arbitration the Model Law governs`

#ASSERT `How much of the Act applies to my arbitration` `a signed contract with an arbitration clause (d038)` EQUALS `the whole Act`
#ASSERT `How much of the Act applies to my arbitration` `an oral agreement to arbitrate, never recorded` EQUALS `not this Act`
#ASSERT `How much of the Act applies to my arbitration` `a clause seated in Sydney` EQUALS `only sections 8, 9, 17H to 17J, 35 and 36`

§ `s 8 -- must the court refer my dispute to arbitration (d038: the other side sues; the client asks for a referral)`

#ASSERT `Must the court refer my dispute to arbitration` `a signed contract with an arbitration clause (d038)` TRUE TRUE FALSE
#ASSERT NOT `Must the court refer my dispute to arbitration` `a signed contract with an arbitration clause (d038)` TRUE FALSE FALSE
#ASSERT NOT `Must the court refer my dispute to arbitration` `a signed contract with an arbitration clause (d038)` TRUE TRUE TRUE
#ASSERT `Must the court refer my dispute to arbitration` `a clause seated in Sydney` TRUE TRUE FALSE
#ASSERT NOT `Must the court refer my dispute to arbitration` `an oral agreement to arbitrate, never recorded` TRUE TRUE FALSE

§ `ss 10, 11 -- who appoints the arbitrator`

#ASSERT `How many arbitrators will there be` 0 EQUALS 1
#ASSERT `How many arbitrators will there be` 3 EQUALS 3

#ASSERT `Who appoints the arbitrator` `an agreed procedure that works` EQUALS `as our agreed procedure provides`
#ASSERT `Who appoints the arbitrator` `an agreed institution that fails to act, no fallback` EQUALS `the Court, at a party's request`
#ASSERT `Who appoints the arbitrator` `a sole arbitrator the parties agree on` EQUALS `the parties together, by agreement`
#ASSERT `Who appoints the arbitrator` `a sole arbitrator the parties cannot agree on` EQUALS `the Court, at a party's request`
#ASSERT `Who appoints the arbitrator` `three arbitrators, the other side silent for 31 days` EQUALS `the Court, at a party's request`
#ASSERT `Who appoints the arbitrator` `three arbitrators, the other side silent for exactly 30 days` EQUALS `each party one, and those two the third`
#ASSERT `Who appoints the arbitrator` `three arbitrators, the two deadlocked on the third for 45 days` EQUALS `the Court, at a party's request`
#ASSERT `Who appoints the arbitrator` `three arbitrators and three parties` EQUALS `the Court, at a party's request`

§ `s 12 -- may I challenge the arbitrator`

#ASSERT `May I challenge the arbitrator` TRUE FALSE FALSE FALSE
#ASSERT NOT `May I challenge the arbitrator` TRUE FALSE TRUE FALSE
#ASSERT `May I challenge the arbitrator` TRUE FALSE TRUE TRUE

§ `ss 18, 24 -- my right to be heard`

#ASSERT `Must the tribunal hold an oral hearing` TRUE FALSE
#ASSERT NOT `Must the tribunal hold an oral hearing` TRUE TRUE

#ASSERT NOT `Have I been denied my right to be heard` `a fair arbitration with the hearing I asked for`
#ASSERT `Have I been denied my right to be heard` `the oral hearing I asked for refused`
#ASSERT NOT `Have I been denied my right to be heard` `no hearing, as we agreed`
#ASSERT `Have I been denied my right to be heard` `an expert report the tribunal relied on never shown to me`

§ `ss 27D, 30 -- a mediated settlement (d051: Jarrah's customer dispute, mediated under the contract, settled by deed)`

#ASSERT `May our arbitrator act as mediator` TRUE FALSE
#ASSERT NOT `May our arbitrator act as mediator` FALSE FALSE

#ASSERT `May the arbitrator who mediated now arbitrate` TRUE EQUALS `the same arbitrator may arbitrate, and I cannot object that they mediated`
#ASSERT `May the arbitrator who mediated now arbitrate` FALSE EQUALS `a substitute arbitrator must be appointed`

-- d051: no arbitration on foot (ASSUMED); the deed is not an award.
#ASSERT `How is my settlement enforced` FALSE FALSE FALSE EQUALS `only as a contract or deed: this Act does not enforce it`
#ASSERT `How is my settlement enforced` TRUE TRUE FALSE EQUALS `as an arbitral award, enforceable under section 35`
#ASSERT `How is my settlement enforced` TRUE TRUE TRUE EQUALS `the arbitration ends, and the settlement binds only as a contract or deed`

§ `ss 31, 33 -- the award`

#ASSERT `Must my award state its reasons` FALSE FALSE
#ASSERT NOT `Must my award state its reasons` FALSE TRUE

#ASSERT `Am I in time to ask for a correction` (Date 1 6 2030) (Date 1 7 2030) 0
#ASSERT NOT `Am I in time to ask for a correction` (Date 1 6 2030) (Date 2 7 2030) 0

§ `s 34 -- setting the award aside`

#ASSERT NOT `Am I in time to apply to set aside the award` `no proper notice, applying on 2 September 2030`
#ASSERT `Am I in time to apply to set aside the award` `no proper notice, applying on 1 September 2030`
#ASSERT `Am I in time to apply to set aside the award` `public policy, after a correction request disposed of on 1 July 2030, applying on 15 September 2030`
#ASSERT `Am I in time to apply to set aside the award` `an award received 30 November 2030, applying on 28 February 2031`
#ASSERT NOT `Am I in time to apply to set aside the award` `an award received 30 November 2030, applying on 1 March 2031`

#ASSERT `Can I have my award set aside` `no proper notice, applying on 15 August 2030` EQUALS `the Court may set aside the award`
#ASSERT `Can I have my award set aside` `no proper notice, applying on 2 September 2030` EQUALS `too late: 3 months have passed`
#ASSERT `Can I have my award set aside` `a separable excess of submission` EQUALS `the Court may set aside only the part beyond the submission`
#ASSERT `Can I have my award set aside` `no ground, only a wrong answer` EQUALS `no ground: the award stands`
#ASSERT `Can I have my award set aside` `public policy, after a correction request disposed of on 1 July 2030, applying on 15 September 2030` EQUALS `the Court may set aside the award`

§ `s 34A -- an appeal on a question of law`

#ASSERT `Can I appeal against my award` `a question of fact` EQUALS `no appeal: only a question of law may be appealed`
#ASSERT `Can I appeal against my award` `a question of law, no agreement to appeal` EQUALS `no appeal: the parties have not agreed to one`
#ASSERT `Can I appeal against my award` `a question of law, agreed, obviously wrong` EQUALS `an appeal lies if the Court grants leave`
#ASSERT `Can I appeal against my award` `a question of law, agreed, obviously wrong, lodged 5 September 2030` EQUALS `too late: the appeal period has ended`
#ASSERT `Can I appeal against my award` `a question of law, agreed, the decision merely arguable` EQUALS `no appeal: the Court must not grant leave`

#ASSERT `May the Court grant leave to appeal` `a question of law of general public importance, open to serious doubt`

§ `ss 35, 36 -- enforcement`

#ASSERT `Will the Court enforce my award` TRUE TRUE FALSE FALSE
#ASSERT NOT `Will the Court enforce my award` TRUE FALSE FALSE FALSE
#ASSERT NOT `Will the Court enforce my award` TRUE TRUE TRUE FALSE

#ASSERT `Can I resist enforcement of the award` FALSE TRUE

