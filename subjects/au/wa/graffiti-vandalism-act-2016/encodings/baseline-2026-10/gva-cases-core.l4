§§ `ss 27-30 Powers of entry (clock: minutes from the notice of entry)`

#ASSERT `ss 27(1), 29 -- the entry is authorised by consent or a warrant` TRUE FALSE
#ASSERT `ss 27(1), 29 -- the entry is authorised by consent or a warrant` FALSE TRUE
#ASSERT NOT (`ss 27(1), 29 -- the entry is authorised by consent or a warrant` FALSE FALSE)
#ASSERT `s 28(3) -- the minutes after the notice during which entry is not allowed` EQUALS 1439

-- With consent, or a warrant: entry permitted at once.
#ASSERT EVALTRACE (`ss 27, 28 -- the local government may enter only with consent, a warrant, or at least 24 hours' notice` TRUE FALSE FALSE FALSE) 0 (LIST (EVENT `the local government` `enter the land` 5)) EQUALS FULFILLED
#ASSERT EVALTRACE (`ss 27, 28 -- the local government may enter only with consent, a warrant, or at least 24 hours' notice` FALSE TRUE FALSE TRUE) 0 (LIST (EVENT `the local government` `enter the land` 5)) EQUALS FULFILLED
-- Notice given, no objection: entry exactly 24 hours (1 440 minutes) later is lawful.
#ASSERT EVALTRACE (`ss 27, 28 -- the local government may enter only with consent, a warrant, or at least 24 hours' notice` FALSE FALSE TRUE FALSE) 0 (LIST (WAITUNTIL 1440), (EVENT `the local government` `enter the land` 1440)) EQUALS FULFILLED
-- expect: BREACH BY the local government, "s 28(3): notice of an intended entry is to be given not less than 24 hours before ..." (entry 23 hours 59 minutes after the notice)
#TRACE `ss 27, 28 -- the local government may enter only with consent, a warrant, or at least 24 hours' notice` FALSE FALSE TRUE FALSE AT 0 WITH
    PARTY `the local government` DOES `enter the land` AT 1439
-- expect: BREACH BY the local government, "s 28(3): ..." (entry 10 hours after the notice)
#TRACE `ss 27, 28 -- the local government may enter only with consent, a warrant, or at least 24 hours' notice` FALSE FALSE TRUE FALSE AT 0 WITH
    PARTY `the local government` DOES `enter the land` AT 600
-- expect: BREACH BY the local government, "s 27(1), (2): entry by or on behalf of a local government is not lawful without ..." (notice given, but the occupier objects; entry two days later)
#TRACE `ss 27, 28 -- the local government may enter only with consent, a warrant, or at least 24 hours' notice` FALSE FALSE TRUE TRUE AT 0 WITH
    PARTY `the local government` DOES `enter the land` AT 2880
-- expect: BREACH BY the local government, "s 27(1), (2): ..." (no consent, no notice, no warrant)
#TRACE `ss 27, 28 -- the local government may enter only with consent, a warrant, or at least 24 hours' notice` FALSE FALSE FALSE FALSE AT 0 WITH
    PARTY `the local government` DOES `enter the land` AT 5
-- expect: the permission still open, PARTY the local government MAY enter the land (entry at minute 1440 with no WAITUNTIL: the
-- event that passes the 24 hours is not matched against the permission that follows, so the seat layer waits first)
#TRACE `ss 27, 28 -- the local government may enter only with consent, a warrant, or at least 24 hours' notice` FALSE FALSE TRUE FALSE AT 0 WITH
    PARTY `the local government` DOES `enter the land` AT 1440

#ASSERT `s 30 -- the person entering is to give particulars of the power of entry` TRUE
#ASSERT NOT (`s 30 -- the person entering is to give particulars of the power of entry` FALSE)
