IMPORT prelude
IMPORT `gva-dates`
IMPORT `gva-core`

-- Graffiti Vandalism Act 2016 (WA) -- cases for the seat-neutral core (gva-core.l4).
--
-- Every expected value is worked by hand from the deposited text (registers/source-bundle/mrdoc_29645.txt), never
-- copied from the encoding's output. Days are counted under the Interpretation Act 1984 (WA) s 61(1)(b): "within 28
-- days after" 1 March leaves 1 March out, so the last day is 29 March.
--
-- A breached or still-pending DEONTIC cannot be asserted on the stable l4 (EVALTRACE ... EQUALS on a breached trace
-- fails both ways), so a regulative rule is asserted where its trace ends FULFILLED, and #TRACEd with an "-- expect:"
-- line where it does not. Clock: days from the start of the rule (0), except the entry rule (minutes from the notice).
--
-- BASELINE. Not for public use as advice. See NOTES.md.

§ `Cases -- the core`

`1 March 2027`  MEANS YMD 2027 3 1
`10 March 2027` MEANS YMD 2027 3 10
`15 March 2027` MEANS YMD 2027 3 15
`16 March 2027` MEANS YMD 2027 3 16
`20 March 2027` MEANS YMD 2027 3 20
`29 March 2027` MEANS YMD 2027 3 29
`5 April 2027`  MEANS YMD 2027 4 5
`10 April 2027` MEANS YMD 2027 4 10
`12 April 2027` MEANS YMD 2027 4 12
`24 April 2027` MEANS YMD 2027 4 24
`25 April 2027` MEANS YMD 2027 4 25
`22 May 2027`   MEANS YMD 2027 5 22
`5 June 2027`   MEANS YMD 2027 6 5

§§ `Date helpers (gva-dates.l4)`

#ASSERT 28 `days after` `1 March 2027` EQUALS `29 March 2027`
#ASSERT `the days from` `1 March 2027` `to` `15 March 2027` EQUALS 14
#ASSERT `the days from` `15 March 2027` `to` `10 March 2027` EQUALS -5
#ASSERT `16 March 2027` `is after` `15 March 2027`
#ASSERT NOT (`15 March 2027` `is after` `15 March 2027`)
#ASSERT `the day number of` `16 March 2027` MINUS `the day number of` `15 March 2027` EQUALS 1

§§ `s 3 graffiti, s 4 child and graffiti implement`

#ASSERT `s 3 -- the mark is graffiti` `by spraying, writing, drawing, marking or otherwise applying paint or another marking substance`
#ASSERT `s 3 -- the mark is graffiti` `by scratching or etching`
#ASSERT NOT (`s 3 -- the mark is graffiti` `in some other way, such as sticking on a poster or sticker`)

#ASSERT `s 4 -- a person of this age is a child` 17
#ASSERT NOT (`s 4 -- a person of this age is a child` 18)

-- A can of spray paint is an implement whatever else is said of it.
#ASSERT `s 4 -- the item is a graffiti implement` `a can of spray paint` 0 FALSE
-- A permanent marker with a 7 mm tip is; one with a 6 mm tip is not ("over 6 mm"); a 10 mm water-soluble one is not.
#ASSERT `s 4 -- the item is a graffiti implement` `a pen or marker pen, or a similar implement` 7 TRUE
#ASSERT NOT (`s 4 -- the item is a graffiti implement` `a pen or marker pen, or a similar implement` 6 TRUE)
#ASSERT NOT (`s 4 -- the item is a graffiti implement` `a pen or marker pen, or a similar implement` 10 FALSE)
#ASSERT NOT (`s 4 -- the item is a graffiti implement` `something else` 20 TRUE)

§§ `s 5 Damaging property by graffiti`

-- Spray-painting a neighbour's fence without asking: an offence. With the neighbour's consent, or on one's own fence,
-- or by sticking on a poster: not this offence.
#ASSERT `s 5(1) -- putting the mark on the property is an offence` `by spraying, writing, drawing, marking or otherwise applying paint or another marking substance` TRUE FALSE
#ASSERT NOT (`s 5(1) -- putting the mark on the property is an offence` `by spraying, writing, drawing, marking or otherwise applying paint or another marking substance` TRUE TRUE)
#ASSERT NOT (`s 5(1) -- putting the mark on the property is an offence` `by spraying, writing, drawing, marking or otherwise applying paint or another marking substance` FALSE FALSE)
#ASSERT NOT (`s 5(1) -- putting the mark on the property is an offence` `in some other way, such as sticking on a poster or sticker` TRUE FALSE)
-- s 5(2): carving initials into a council tree (vegetation) without consent: scratching or etching, another's property.
#ASSERT `s 5(1) -- putting the mark on the property is an offence` `by scratching or etching` TRUE FALSE

#ASSERT `s 5(1) -- the maximum fine` EQUALS 24000
#ASSERT `s 5(1) -- the maximum imprisonment, in years` EQUALS 2
#ASSERT `s 5(1)(a), (b) -- the minimum penalty` 17 EQUALS `a youth community based order under the Young Offenders Act 1994`
#ASSERT `s 5(1)(a), (b) -- the minimum penalty` 18 EQUALS `a community based order under the Sentencing Act 1995`

-- The rule. With consent, putting the mark on is permitted: fulfilled.
#ASSERT EVALTRACE (`s 5(1) -- a person must not damage another person's property by graffiti without consent` `by spraying, writing, drawing, marking or otherwise applying paint or another marking substance` TRUE TRUE) 0 (LIST (EVENT `the person` `put the mark on the property` 1)) EQUALS FULFILLED
-- On one's own wall: permitted.
#ASSERT EVALTRACE (`s 5(1) -- a person must not damage another person's property by graffiti without consent` `by spraying, writing, drawing, marking or otherwise applying paint or another marking substance` FALSE FALSE) 0 (LIST (EVENT `the person` `put the mark on the property` 1)) EQUALS FULFILLED
-- expect: BREACH BY the person, "s 5(1): a person must not destroy, damage or deface the property of another person ..." (sprays a neighbour's fence without consent)
#TRACE `s 5(1) -- a person must not damage another person's property by graffiti without consent` `by spraying, writing, drawing, marking or otherwise applying paint or another marking substance` TRUE FALSE AT 0 WITH
    PARTY `the person` DOES `put the mark on the property` AT 1
-- expect: BREACH BY the person, "s 5(1): ..." (etches a council tree: s 5(2) vegetation)
#TRACE `s 5(1) -- a person must not damage another person's property by graffiti without consent` `by scratching or etching` TRUE FALSE AT 0 WITH
    PARTY `the person` DOES `put the mark on the property` AT 3
-- expect: the prohibition still in force, PARTY the person MUST NOT put the mark on the property (no WITHIN: time alone never ends it)
#TRACE `s 5(1) -- a person must not damage another person's property by graffiti without consent` `by spraying, writing, drawing, marking or otherwise applying paint or another marking substance` TRUE FALSE AT 0 WITH
    (WAITUNTIL 400)

§§ `s 6 Possessing thing with intent to apply graffiti`

#ASSERT `s 6(1), (2) -- the person has, or is presumed to have, the intention` TRUE FALSE FALSE
-- s 6(2): spray cans and a balaclava at 2 a.m. beside a freshly tagged wall: presumed, unless the contrary is proved.
#ASSERT `s 6(1), (2) -- the person has, or is presumed to have, the intention` FALSE TRUE FALSE
#ASSERT NOT (`s 6(1), (2) -- the person has, or is presumed to have, the intention` FALSE TRUE TRUE)
#ASSERT NOT (`s 6(1), (2) -- the person has, or is presumed to have, the intention` FALSE FALSE FALSE)
#ASSERT `s 6(1) -- the maximum fine` EQUALS 6000

-- A painter carrying spray cans to a job, no suspicious circumstances: permitted.
#ASSERT EVALTRACE (`s 6(1) -- a person must not possess a thing with the intention of applying graffiti with it` FALSE FALSE FALSE) 0 (LIST (EVENT `the person` `be in possession of the thing` 0)) EQUALS FULFILLED
-- expect: BREACH BY the person, "s 6(1), (2): a person must not be in possession of a thing with the intention ..." (presumed intention, not rebutted)
#TRACE `s 6(1) -- a person must not possess a thing with the intention of applying graffiti with it` FALSE TRUE FALSE AT 0 WITH
    PARTY `the person` DOES `be in possession of the thing` AT 0

§§ `s 7 Selling graffiti implement to child`

-- A hardware store sells a can of spray paint to a 16-year-old: an offence unless the s 7(2) defence is made out.
#ASSERT `s 7(1) -- selling the item to the buyer is an offence` `a can of spray paint` 0 FALSE 16
#ASSERT NOT (`s 7(1) -- selling the item to the buyer is an offence` `a can of spray paint` 0 FALSE 18)
#ASSERT NOT (`s 7(1) -- selling the item to the buyer is an offence` `a pen or marker pen, or a similar implement` 2 TRUE 16)
#ASSERT `s 7(1) -- the maximum fine` FALSE EQUALS 6000
#ASSERT `s 7(1) -- the maximum fine` TRUE EQUALS 12000
#ASSERT `s 7(2) -- the seller has a defence` TRUE TRUE
#ASSERT NOT (`s 7(2) -- the seller has a defence` TRUE FALSE)
#ASSERT NOT (`s 7(2) -- the seller has a defence` FALSE TRUE)

-- The rule. Sold to an 18-year-old: permitted.
#ASSERT EVALTRACE (`s 7 -- a person must not sell a graffiti implement to a child, unless they believed on reasonable grounds the buyer was an adult` `a can of spray paint` 0 FALSE 18 FALSE FALSE) 0 (LIST (EVENT `the seller` `sell the item to the buyer` 0)) EQUALS FULFILLED
-- A 2 mm permanent marker to a 16-year-old: not a graffiti implement, permitted.
#ASSERT EVALTRACE (`s 7 -- a person must not sell a graffiti implement to a child, unless they believed on reasonable grounds the buyer was an adult` `a pen or marker pen, or a similar implement` 2 TRUE 16 FALSE FALSE) 0 (LIST (EVENT `the seller` `sell the item to the buyer` 0)) EQUALS FULFILLED
-- To a 16-year-old who showed an adult's ID that the shop assistant checked: the defence, so no breach.
#ASSERT EVALTRACE (`s 7 -- a person must not sell a graffiti implement to a child, unless they believed on reasonable grounds the buyer was an adult` `a can of spray paint` 0 FALSE 16 TRUE TRUE) 0 (LIST (EVENT `the seller` `sell the item to the buyer` 0)) EQUALS FULFILLED
-- expect: BREACH BY the seller, "s 7(1): a person must not sell a graffiti implement to a child ..." (16-year-old, no belief that the buyer was an adult)
#TRACE `s 7 -- a person must not sell a graffiti implement to a child, unless they believed on reasonable grounds the buyer was an adult` `a can of spray paint` 0 FALSE 16 FALSE FALSE AT 0 WITH
    PARTY `the seller` DOES `sell the item to the buyer` AT 0
-- expect: BREACH BY the seller, "s 7(1): ..." (a 7 mm permanent marker; the seller believed the buyer an adult, but not on reasonable grounds)
#TRACE `s 7 -- a person must not sell a graffiti implement to a child, unless they believed on reasonable grounds the buyer was an adult` `a pen or marker pen, or a similar implement` 7 TRUE 15 TRUE FALSE AT 0 WITH
    PARTY `the seller` DOES `sell the item to the buyer` AT 0

§§ `ss 8, 10, 12, 13 Orders on conviction; owner's immunity`

#ASSERT `s 8(2) -- the court may order the offender to restore the property, or to pay another person to` TRUE
#ASSERT NOT (`s 8(2) -- the court may order the offender to restore the property, or to pay another person to` FALSE)
#ASSERT `s 10(1) -- the minimum hours of unpaid community work in a community order` EQUALS 10
#ASSERT `s 13 -- the court may order the thing forfeited on conviction` `a graffiti implement` TRUE
#ASSERT NOT (`s 13 -- the court may order the thing forfeited on conviction` `a graffiti implement` FALSE)
-- s 13(2)(b): the phone used to film the tag, on the prosecutor's application.
#ASSERT `s 13 -- the court may order the thing forfeited on conviction` `a thing the offender used to record, store or send images of the graffiti they caused` TRUE
#ASSERT NOT (`s 13 -- the court may order the thing forfeited on conviction` `a thing not used or intended to be used in connection with the offence` TRUE)
#ASSERT `s 12(2) -- an action in tort lies against the owner` TRUE
#ASSERT NOT (`s 12(2) -- an action in tort lies against the owner` FALSE)

§§ `s 18 Notice requiring removal of graffiti`

-- A mural the owner commissioned, visible from the street, which the council considers offensive: s 18 applies.
#ASSERT `s 18(1) -- section 18 applies to the graffiti` TRUE TRUE TRUE
#ASSERT NOT (`s 18(1) -- section 18 applies to the graffiti` TRUE FALSE TRUE)
#ASSERT NOT (`s 18(1) -- section 18 applies to the graffiti` FALSE TRUE TRUE)
#ASSERT NOT (`s 18(1) -- section 18 applies to the graffiti` TRUE TRUE FALSE)
#ASSERT `s 18(1), (2) -- the person must ensure the graffiti is obliterated` TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 18(1), (2) -- the person must ensure the graffiti is obliterated` FALSE TRUE TRUE TRUE)
#ASSERT `s 18(3) -- the owner is to be informed in writing that the notice was given` `the occupier, and not the owner`
#ASSERT NOT (`s 18(3) -- the owner is to be informed in writing that the notice was given` `the owner`)
#ASSERT NOT (`s 18(3) -- the owner is to be informed in writing that the notice was given` `both the owner and the occupier`)

-- Notice given 1 March 2027 allowing 14 days: the last day is 15 March 2027.
#ASSERT `s 18(2) -- the last day to comply with the notice` `1 March 2027` 14 EQUALS `15 March 2027`
-- Obliterated 20 March: 5 days or part days after the last day; 16 March: 1; on 15 or 10 March: none.
#ASSERT `s 18(5)(b) -- the days or part days after the last day to comply` `1 March 2027` 14 `20 March 2027` EQUALS 5
#ASSERT `s 18(5)(b) -- the days or part days after the last day to comply` `1 March 2027` 14 `16 March 2027` EQUALS 1
#ASSERT `s 18(5)(b) -- the days or part days after the last day to comply` `1 March 2027` 14 `15 March 2027` EQUALS 0
#ASSERT `s 18(5)(b) -- the days or part days after the last day to comply` `1 March 2027` 14 `10 March 2027` EQUALS 0
#ASSERT `s 18(5)(a) -- the maximum fine` EQUALS 5000
#ASSERT `s 18(5)(b) -- the further fine for each day or part of a day the offence continues` EQUALS 500
-- 5 days: $5 000 + 5 x $500 = $7 500.
#ASSERT `s 18(5) -- the maximum fine, with the further fine` 5 EQUALS 7500
#ASSERT `s 18(5) -- the maximum fine, with the further fine` 0 EQUALS 5000

-- The rule, 14 days. Obliterated acceptably on day 14 (the last day) or day 5: fulfilled.
#ASSERT EVALTRACE (`s 18(2), (5) -- the notice recipient must ensure the graffiti is obliterated within the time in the notice` 14 FALSE) 0 (LIST (EVENT `the notice recipient` (`ensure the graffiti is obliterated` `in a manner acceptable to the local government`) 14)) EQUALS FULFILLED
#ASSERT EVALTRACE (`s 18(2), (5) -- the notice recipient must ensure the graffiti is obliterated within the time in the notice` 14 FALSE) 0 (LIST (EVENT `the notice recipient` (`ensure the graffiti is obliterated` `in a manner acceptable to the local government`) 5)) EQUALS FULFILLED
-- A rough paint-over the council does not accept on day 5, then a proper job on day 12: fulfilled by the second.
#ASSERT EVALTRACE (`s 18(2), (5) -- the notice recipient must ensure the graffiti is obliterated within the time in the notice` 14 FALSE) 0 (LIST (EVENT `the notice recipient` (`ensure the graffiti is obliterated` `in a manner the local government does not accept`) 5), (EVENT `the notice recipient` (`ensure the graffiti is obliterated` `in a manner acceptable to the local government`) 12)) EQUALS FULFILLED
-- With a reasonable excuse, the time runs out (day 15), the council obliterates it on day 16 and is paid on day 30.
#ASSERT EVALTRACE (`s 18(2), (5) -- the notice recipient must ensure the graffiti is obliterated within the time in the notice` 14 TRUE) 0 (LIST (WAITUNTIL 15), (EVENT `the local government` `obliterate the graffiti` 16), (EVENT `the notice recipient` `pay the local government the reasonable cost of obliterating the graffiti` 30)) EQUALS FULFILLED
-- expect: BREACH BY the notice recipient, "s 18(5): failing to comply with the notice without a reasonable excuse is an offence ..." (obliterated on day 15, one day late)
#TRACE `s 18(2), (5) -- the notice recipient must ensure the graffiti is obliterated within the time in the notice` 14 FALSE AT 0 WITH
    PARTY `the notice recipient` DOES `ensure the graffiti is obliterated` `in a manner acceptable to the local government` AT 15
-- expect: BREACH BY the notice recipient, "s 18(5): ..." (only an unacceptable paint-over on day 5, and nothing more by day 20)
#TRACE `s 18(2), (5) -- the notice recipient must ensure the graffiti is obliterated within the time in the notice` 14 FALSE AT 0 WITH
    PARTY `the notice recipient` DOES `ensure the graffiti is obliterated` `in a manner the local government does not accept` AT 5
    (WAITUNTIL 20)
-- expect: no breach; the s 19 rule waiting: PARTY the local government MAY obliterate the graffiti HENCE PARTY the notice recipient MUST pay the local government the reasonable cost (reasonable excuse, time run out on day 15)
#TRACE `s 18(2), (5) -- the notice recipient must ensure the graffiti is obliterated within the time in the notice` 14 TRUE AT 0 WITH
    (WAITUNTIL 15)
-- expect: the duty still pending: PARTY the notice recipient MUST ensure the graffiti is obliterated in a manner acceptable to the local government, within the 4 days left (day 10 of 14)
#TRACE `s 18(2), (5) -- the notice recipient must ensure the graffiti is obliterated within the time in the notice` 14 FALSE AT 0 WITH
    (WAITUNTIL 10)

§§ `s 19 Additional powers when notice is given`

#ASSERT EVALTRACE `s 19(3), (4) -- the local government may obliterate the graffiti and recover its reasonable cost` 0 (LIST (EVENT `the local government` `obliterate the graffiti` 3), (EVENT `the notice recipient` `pay the local government the reasonable cost of obliterating the graffiti` 10)) EQUALS FULFILLED
-- expect: the debt still owed: PARTY the notice recipient MUST pay the local government the reasonable cost of obliterating the graffiti (the council obliterated it on day 3; no payment yet)
#TRACE `s 19(3), (4) -- the local government may obliterate the graffiti and recover its reasonable cost` AT 0 WITH
    PARTY `the local government` DOES `obliterate the graffiti` AT 3

#ASSERT `s 19(5), (6) -- who the court may order to pay the notice recipient` `the owner` TRUE EQUALS `the occupier`
#ASSERT `s 19(5), (6) -- who the court may order to pay the notice recipient` `the occupier, and not the owner` TRUE EQUALS `the owner`
#ASSERT `s 19(5), (6) -- who the court may order to pay the notice recipient` `both the owner and the occupier` TRUE EQUALS `no one, because the notice recipient is both the owner and the occupier`
#ASSERT `s 19(5), (6) -- who the court may order to pay the notice recipient` `the occupier, and not the owner` FALSE EQUALS `no one, because the notice recipient has no expense, fine or cost of the kind in s 19(5)`

§§ `ss 20-22 Affected person, reasons, objection`

#ASSERT `s 20 -- the person is an affected person` `to the person`
#ASSERT `s 20 -- the person is an affected person` `to the occupier of the person's property, and the person is its owner`
#ASSERT NOT (`s 20 -- the person is an affected person` `to someone else, or no notice has been given`)
#ASSERT `s 21 -- the person is to be given written reasons and told of the rights to object and to apply for review` `to the occupier of the person's property, and the person is its owner`
#ASSERT NOT (`s 21 -- the person is to be given written reasons and told of the rights to object and to apply for review` `to someone else, or no notice has been given`)
#ASSERT `s 22(1) -- the person may object to the notice` `to the person` FALSE
#ASSERT NOT (`s 22(1) -- the person may object to the notice` `to the person` TRUE)
#ASSERT NOT (`s 22(1) -- the person may object to the notice` `to someone else, or no notice has been given` FALSE)

#ASSERT `s 22(2) -- the days to object` 0 EQUALS 28
#ASSERT `s 22(2) -- the days to object` 7 EQUALS 35
-- Notice 1 March 2027: object by 29 March; with 7 further days allowed, by 5 April.
#ASSERT `s 22(2) -- the last day to object` `1 March 2027` 0 EQUALS `29 March 2027`
#ASSERT `s 22(2) -- the last day to object` `1 March 2027` 7 EQUALS `5 April 2027`

-- The rule. Lodged on day 28, or day 10: fulfilled. Day 35 with 7 further days: fulfilled.
#ASSERT EVALTRACE (`s 22(2) -- the affected person may object within 28 days after the notice is given, or any further time allowed` 0) 0 (LIST (EVENT `the affected person` `lodge an objection in the approved form with the CEO of the local government` 28)) EQUALS FULFILLED
#ASSERT EVALTRACE (`s 22(2) -- the affected person may object within 28 days after the notice is given, or any further time allowed` 0) 0 (LIST (EVENT `the affected person` `lodge an objection in the approved form with the CEO of the local government` 10)) EQUALS FULFILLED
#ASSERT EVALTRACE (`s 22(2) -- the affected person may object within 28 days after the notice is given, or any further time allowed` 7) 0 (LIST (EVENT `the affected person` `lodge an objection in the approved form with the CEO of the local government` 35)) EQUALS FULFILLED
-- expect: no breach; PARTY the local government MAY allow further time to object (lodged on day 29, one day late: the event that passes the deadline is not matched against the LEST)
#TRACE `s 22(2) -- the affected person may object within 28 days after the notice is given, or any further time allowed` 0 AT 0 WITH
    PARTY `the affected person` DOES `lodge an objection in the approved form with the CEO of the local government` AT 29
-- expect: FULFILLED (time ran out on day 29; the council then allowed further time on day 31)
#TRACE `s 22(2) -- the affected person may object within 28 days after the notice is given, or any further time allowed` 0 AT 0 WITH
    (WAITUNTIL 29)
    PARTY `the local government` DOES `allow further time to object` AT 31

§§ `s 23 Review by the State Administrative Tribunal`

#ASSERT `s 23(1), (2) -- the right to apply for review` FALSE FALSE 0 EQUALS `s 23(1)(a) -- no objection has been lodged`
#ASSERT `s 23(1), (2) -- the right to apply for review` TRUE TRUE 20 EQUALS `s 23(2) -- the objection has been decided and written notice of the decision given`
-- Day 36 after lodging with no written decision: "at the expiration of 35 days" has passed.
#ASSERT `s 23(1), (2) -- the right to apply for review` TRUE FALSE 36 EQUALS `s 23(1)(b) -- an objection was lodged and no written decision was given within 35 days`
-- Day 35: not yet.
#ASSERT `s 23(1), (2) -- the right to apply for review` TRUE FALSE 35 EQUALS `none yet -- an objection was lodged, is undecided, and 35 days have not yet passed`

#ASSERT `s 23(1), (2) -- the person may apply to the State Administrative Tribunal` `s 23(1)(a) -- no objection has been lodged` `to the person`
#ASSERT NOT (`s 23(1), (2) -- the person may apply to the State Administrative Tribunal` `none yet -- an objection was lodged, is undecided, and 35 days have not yet passed` `to the person`)
#ASSERT NOT (`s 23(1), (2) -- the person may apply to the State Administrative Tribunal` `s 23(1)(a) -- no objection has been lodged` `to someone else, or no notice has been given`)

-- (1)(a): notice 1 March 2027, no objection: 1 March to 12 April 2027 (42 days after 1 March).
#ASSERT `s 23(3) -- the first day to apply` `s 23(1)(a) -- no objection has been lodged` `1 March 2027` `20 March 2027` `10 April 2027` EQUALS `1 March 2027`
#ASSERT `s 23(3) -- the last day to apply` `s 23(1)(a) -- no objection has been lodged` `1 March 2027` `20 March 2027` `10 April 2027` EQUALS `12 April 2027`
-- (1)(b): objection lodged 20 March 2027, no written decision: the right arises 24 April (35 days after); the first
-- day is 25 April ("more than 35 days"); the last day 5 June (77 days after 20 March, and 42 after 24 April).
#ASSERT `s 23(3) -- the day the right to apply arose` `s 23(1)(b) -- an objection was lodged and no written decision was given within 35 days` `1 March 2027` `20 March 2027` `10 April 2027` EQUALS `24 April 2027`
#ASSERT `s 23(3) -- the first day to apply` `s 23(1)(b) -- an objection was lodged and no written decision was given within 35 days` `1 March 2027` `20 March 2027` `10 April 2027` EQUALS `25 April 2027`
#ASSERT `s 23(3) -- the last day to apply` `s 23(1)(b) -- an objection was lodged and no written decision was given within 35 days` `1 March 2027` `20 March 2027` `10 April 2027` EQUALS `5 June 2027`
#ASSERT `s 23(3) -- the last day to apply` `none yet -- an objection was lodged, is undecided, and 35 days have not yet passed` `1 March 2027` `20 March 2027` `10 April 2027` EQUALS `5 June 2027`
-- (2): objection decided 10 April 2027: by 22 May 2027.
#ASSERT `s 23(3) -- the first day to apply` `s 23(2) -- the objection has been decided and written notice of the decision given` `1 March 2027` `20 March 2027` `10 April 2027` EQUALS `10 April 2027`
#ASSERT `s 23(3) -- the last day to apply` `s 23(2) -- the objection has been decided and written notice of the decision given` `1 March 2027` `20 March 2027` `10 April 2027` EQUALS `22 May 2027`

-- The rule, from the day the right arose. Applied on day 42: fulfilled.
#ASSERT EVALTRACE `s 23(3) -- the affected person may apply for review within 42 days after the right to apply arose` 0 (LIST (EVENT `the affected person` `apply to the State Administrative Tribunal for a review` 42)) EQUALS FULFILLED
-- expect: no breach; PARTY the affected person MAY ask the State Administrative Tribunal to extend the time for applying (applied on day 43, one day late)
#TRACE `s 23(3) -- the affected person may apply for review within 42 days after the right to apply arose` AT 0 WITH
    PARTY `the affected person` DOES `apply to the State Administrative Tribunal for a review` AT 43
-- expect: FULFILLED (time ran out; the person asked the Tribunal for an extension on day 50)
#TRACE `s 23(3) -- the affected person may apply for review within 42 days after the right to apply arose` AT 0 WITH
    (WAITUNTIL 43)
    PARTY `the affected person` DOES `ask the State Administrative Tribunal to extend the time for applying` AT 50

§§ `s 24 Suspension of effect of notice`

#ASSERT `s 24(1) -- the effect of the notice is suspended` TRUE FALSE FALSE FALSE
#ASSERT NOT (`s 24(1) -- the effect of the notice is suspended` TRUE TRUE FALSE FALSE)
#ASSERT NOT (`s 24(1) -- the effect of the notice is suspended` TRUE FALSE TRUE FALSE)
#ASSERT NOT (`s 24(1) -- the effect of the notice is suspended` TRUE FALSE FALSE TRUE)
#ASSERT NOT (`s 24(1) -- the effect of the notice is suspended` FALSE FALSE FALSE FALSE)

-- The rule: objection decided on day 30. The council waits: fulfilled once day 30 has passed.
