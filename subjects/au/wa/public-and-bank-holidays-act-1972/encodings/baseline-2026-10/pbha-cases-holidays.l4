IMPORT prelude
IMPORT daydate
IMPORT `pbha-holidays`

-- Public and Bank Holidays Act 1972 (WA), ss 3, 5-10 and the Second Schedule -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or a Gazette.
--
-- Fixtures are generated from a table (scratchpad gen_wa_public-and-bank-holidays-act-1972_baseline.py). Expected
-- results were written by hand from the text, with weekdays worked from 1 January of each year.
--
-- Facts from the WA lives (workbench scenarios au/wa/cradle-to-grave-chloe): c042, 6 May 2024, Chloe asks which days
-- are public holidays in WA. The Sovereign's birthday is an input; the dates used (23 Sep 2024, 26 Sep 2022, 28 Sep 2026)
-- are the encoder's understanding of the proclaimed days, not read in the deposit. Proclamations under ss 7 and 8 are
-- the encoder's illustrations.

§ `Second Schedule -- on what day each holiday falls`

-- c042 (Chloe, 2024): Easter, Labour Day, Western Australia Day, the King's Birthday; no weekend extra days.
#ASSERT `On what day does this holiday fall` `Good Friday` 2024 (Date 23 9 2024) EQUALS (`falls on` (Date 29 3 2024))
#ASSERT `On what day does this holiday fall` `Easter Sunday` 2024 (Date 23 9 2024) EQUALS (`falls on` (Date 31 3 2024))
#ASSERT `On what day does this holiday fall` `Easter Monday` 2024 (Date 23 9 2024) EQUALS (`falls on` (Date 1 4 2024))
#ASSERT `On what day does this holiday fall` `Labour Day` 2024 (Date 23 9 2024) EQUALS (`falls on` (Date 4 3 2024))
#ASSERT `On what day does this holiday fall` `Western Australia Day` 2024 (Date 23 9 2024) EQUALS (`falls on` (Date 3 6 2024))
#ASSERT `On what day does this holiday fall` `the Sovereign's birthday` 2024 (Date 23 9 2024) EQUALS (`falls on` (Date 23 9 2024))
#ASSERT `On what day does this holiday fall` `the Monday after New Year's Day` 2024 (Date 23 9 2024) EQUALS `does not arise this year`

-- "Monday on or first Monday following": on the 1st itself when that is a Monday.
#ASSERT `On what day does this holiday fall` `Labour Day` 2027 (Date 28 9 2027) EQUALS (`falls on` (Date 1 3 2027))
#ASSERT `On what day does this holiday fall` `Western Australia Day` 2025 (Date 28 9 2025) EQUALS (`falls on` (Date 2 6 2025))

-- Australia Day moves to the Monday; it is not doubled.
#ASSERT `On what day does this holiday fall` `Australia Day` 2019 (Date 28 9 2019) EQUALS (`falls on` (Date 28 1 2019))
#ASSERT `On what day does this holiday fall` `Australia Day` 2020 (Date 28 9 2020) EQUALS (`falls on` (Date 27 1 2020))

-- New Year's Day, Anzac Day, Christmas Day on a weekend: the next Monday is "also" a holiday.
#ASSERT `On what day does this holiday fall` `the Monday after New Year's Day` 2023 (Date 28 9 2023) EQUALS (`falls on` (Date 2 1 2023))
#ASSERT `On what day does this holiday fall` `the Monday after Anzac Day` 2026 (Date 28 9 2026) EQUALS (`falls on` (Date 27 4 2026))
#ASSERT `On what day does this holiday fall` `the Monday after Christmas Day` 2021 (Date 28 9 2021) EQUALS (`falls on` (Date 27 12 2021))
#ASSERT `On what day does this holiday fall` `the Monday after Christmas Day` 2022 (Date 26 9 2022) EQUALS (`falls on` (Date 26 12 2022))

-- Boxing Day: Saturday gives the Monday; Sunday or Monday gives the Tuesday.
#ASSERT `On what day does this holiday fall` `the Monday after Boxing Day` 2026 (Date 28 9 2026) EQUALS (`falls on` (Date 28 12 2026))
#ASSERT `On what day does this holiday fall` `the Tuesday after Boxing Day` 2021 (Date 28 9 2021) EQUALS (`falls on` (Date 28 12 2021))
#ASSERT `On what day does this holiday fall` `the Tuesday after Boxing Day` 2022 (Date 26 9 2022) EQUALS (`falls on` (Date 27 12 2022))

§ `s 5 -- the year's list`

-- c042: Chloe's 2024 -- eleven days, none doubled.
#ASSERT `What are the public holidays in WA this year` 2024 (Date 23 9 2024) EQUALS (LIST (Date 1 1 2024), (Date 26 1 2024), (Date 4 3 2024), (Date 29 3 2024), (Date 31 3 2024), (Date 1 4 2024), (Date 25 4 2024), (Date 3 6 2024), (Date 23 9 2024), (Date 25 12 2024), (Date 26 12 2024))
#ASSERT `What are the public holidays in WA this year` 2022 (Date 26 9 2022) EQUALS (LIST (Date 1 1 2022), (Date 3 1 2022), (Date 26 1 2022), (Date 7 3 2022), (Date 15 4 2022), (Date 17 4 2022), (Date 18 4 2022), (Date 25 4 2022), (Date 6 6 2022), (Date 26 9 2022), (Date 25 12 2022), (Date 26 12 2022), (Date 27 12 2022))

#ASSERT `How many public holidays in WA this year` 2024 (Date 23 9 2024) EQUALS 11
#ASSERT `How many public holidays in WA this year` 2026 (Date 28 9 2026) EQUALS 13
#ASSERT `How many public holidays in WA this year` 2022 (Date 26 9 2022) EQUALS 13
#ASSERT `How many public holidays in WA this year` 2021 (Date 28 9 2021) EQUALS 14

-- Two Schedule days on one date: one day off, no further day.
#ASSERT `Which holidays fall on this day` (Date 25 4 2011) (Date 28 9 2011) EQUALS (LIST `Easter Monday`, `Anzac Day`)
#ASSERT `Which holidays fall on this day` (Date 26 4 2038) (Date 28 9 2038) EQUALS (LIST `Easter Monday`, `the Monday after Anzac Day`)
#ASSERT `Which holidays fall on this day` (Date 26 12 2022) (Date 26 9 2022) EQUALS (LIST `Boxing Day`, `the Monday after Christmas Day`)

§ `ss 5, 7, 8 -- is this day a public holiday for me`

-- c042: Chloe's Labour Day and Western Australia Day, and an ordinary Monday.
#ASSERT `Is this day a public holiday for me in WA` (Date 4 3 2024) (Date 23 9 2024) FALSE FALSE FALSE EQUALS `yes: a public holiday under s 5 and the Second Schedule`
#ASSERT `Is this day a public holiday for me in WA` (Date 3 6 2024) (Date 23 9 2024) FALSE FALSE FALSE EQUALS `yes: a public holiday under s 5 and the Second Schedule`
#ASSERT `Is this day a public holiday for me in WA` (Date 6 5 2024) (Date 23 9 2024) FALSE FALSE FALSE EQUALS `no: not a public holiday in WA`
#ASSERT `Is this day a public holiday for me in WA` (Date 26 1 2020) (Date 28 9 2020) FALSE FALSE FALSE EQUALS `no: not a public holiday in WA`
#ASSERT `Is this day a public holiday for me in WA` (Date 22 9 2022) (Date 26 9 2022) TRUE FALSE FALSE EQUALS `yes: a special public holiday by proclamation under s 7`
#ASSERT `Is this day a public holiday for me in WA` (Date 26 4 2011) (Date 28 9 2011) FALSE TRUE FALSE EQUALS `yes: a public holiday instead of a Schedule day, by proclamation under s 8`
#ASSERT `Is this day a public holiday for me in WA` (Date 3 6 2024) (Date 23 9 2024) FALSE FALSE TRUE EQUALS `no: the Governor has moved this day's holiday to another day under s 8`

§ `ss 5, 6, 10 -- bank holidays`

#ASSERT `Is this day a bank holiday in WA` (Date 6 1 2024) (Date 23 9 2024)
#ASSERT `Is this day a bank holiday in WA` (Date 4 3 2024) (Date 23 9 2024)

#ASSERT NOT `Must my bank close to the public on this day` (Date 6 1 2024) (Date 23 9 2024)
#ASSERT `Must my bank close to the public on this day` (Date 25 12 2021) (Date 28 9 2021)

§ `ss 3, 9 -- my industrial instrument against the Act`

#ASSERT `Does my award or this Act prevail` FALSE TRUE FALSE FALSE EQUALS `not decided by this Act: s 3 reaches only instruments under the WA Industrial Relations Act 1979`
#ASSERT `Does my award or this Act prevail` TRUE TRUE FALSE TRUE EQUALS `this Act: a substitute day for Easter Sunday because it falls on a weekend has no effect (s 3(3))`
#ASSERT `Does my award or this Act prevail` TRUE FALSE FALSE FALSE EQUALS `no inconsistency: both apply`
#ASSERT `Does my award or this Act prevail` TRUE TRUE TRUE FALSE EQUALS `the proclamation (s 9)`
#ASSERT `Does my award or this Act prevail` TRUE TRUE FALSE FALSE EQUALS `my industrial instrument (s 3(1))`

#ASSERT `Does my award's public holiday provision apply to Easter Sunday` TRUE TRUE

