    `it was used under and in accordance with a s 13(1) permit` IS FALSE
    `it was used with s 13(2) number plates and their requirements` IS FALSE
    `its use is authorised under the law of another jurisdiction` IS FALSE
    `a responsible person for it is ordinarily resident in WA` IS FALSE

`driving 16 days after expiry` MEANS `The use` WITH
    `it was used on a road, and I am its responsible person or I used it` IS TRUE
    `the licence` IS `expired`
    `days since the licence expired` IS 16
    `it was used under and in accordance with a s 13(1) permit` IS FALSE
    `it was used with s 13(2) number plates and their requirements` IS FALSE
    `its use is authorised under the law of another jurisdiction` IS FALSE
    `a responsible person for it is ordinarily resident in WA` IS FALSE

