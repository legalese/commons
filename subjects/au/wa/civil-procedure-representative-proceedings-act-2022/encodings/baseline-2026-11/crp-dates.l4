IMPORT prelude
IMPORT daydate

-- Civil Procedure (Representative Proceedings) Act 2022 (WA) -- the date arithmetic the rules need, kept in one small
-- module so that daydate is imported in one place only, with the Interpretation Act 1984 (WA) ss 61 and 62 as deposited
-- at subjects/au/wa/interpretation-act-1984/registers/source-bundle/mrdoc_49111.txt.
-- BASELINE ENCODING. Not for public use as advice. See NOTES.md.

§ `Dates`

-- A calendar date, day first.
GIVEN d IS A NUMBER, m IS A NUMBER, y IS A NUMBER
GIVETH A DATE
`the day` d m y MEANS Date d m y

GIVEN x IS A DATE, n IS A NUMBER
GIVETH A DATE
`the day n days after` x n MEANS DATE_FROM_SERIAL (DATE_SERIAL x PLUS n)

-- How many days from the first date to the second (negative if the second is earlier).
GIVEN a IS A DATE, b IS A DATE
GIVETH A NUMBER
`days from` a b MEANS DATE_SERIAL b MINUS DATE_SERIAL a

-- Interpretation Act 1984 s 61(1)(b): a period "reckoned from, or after, a specified day" does not include that day, so
-- it begins the next day. s 62(3): "a period ... of 2, 3 or more months ... shall be reckoned from the date on which it
-- is to begin to the date numerically corresponding, less one, in the ... successive month thereafter or, if there is no
-- such corresponding date, to the last day of the latter month." The last day of a period of n months after day x.
GIVEN x IS A DATE, n IS A NUMBER
GIVETH A DATE
`the last day of n months after` x n MEANS
    IF DATE_DAY `the corresponding day` EQUALS DATE_DAY `the first day`
    THEN `the day n days after` `the corresponding day` (0 MINUS 1)
    ELSE `the corresponding day`
    WHERE
        `the first day` MEANS `the day n days after` x 1
        -- daydate's `add months` gives the last day of the month where the month has no corresponding date.
        `the corresponding day` MEANS `add months` `the first day` n

-- Interpretation Act 1984 s 61(2): excluded days are Saturday, Sunday and public holidays. Only Saturday and Sunday are
-- computed here; public holidays are not (fork F11).
GIVEN x IS A DATE
GIVETH A BOOLEAN
DECIDE `a Saturday or Sunday` x IF
        `Weekday of` x EQUALS 6
    OR  `Weekday of` x EQUALS 0

-- s 61(1)(e): "where the time limited for the doing of a thing expires or falls upon an excluded day, the thing may be
-- done on the next day that is not an excluded day".
GIVEN x IS A DATE
GIVETH A DATE
`the next day not a Saturday or Sunday from` x MEANS
    IF `a Saturday or Sunday` x
    THEN `the next day not a Saturday or Sunday from` (`the day n days after` x 1)
    ELSE x
