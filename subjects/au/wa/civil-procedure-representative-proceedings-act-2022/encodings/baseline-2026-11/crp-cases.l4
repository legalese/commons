#ASSERT `Can the hearing start before my opt-out date?` (`the day` 1 7 2026) (`the day` 30 6 2026) FALSE EQUALS JUST TRUE
#ASSERT `Can the hearing start before my opt-out date?` (`the day` 29 6 2026) (`the day` 30 6 2026) FALSE EQUALS JUST FALSE
#ASSERT `Can the hearing start before my opt-out date?` (`the day` 29 6 2026) (`the day` 30 6 2026) TRUE EQUALS JUST TRUE
