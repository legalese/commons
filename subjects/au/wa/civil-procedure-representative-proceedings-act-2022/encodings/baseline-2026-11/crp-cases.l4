#ASSERT `Must I be given notice of this?` `another matter` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
-- s 26(4).
#ASSERT `Can the Court order personal notice to each of us?` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Can the Court order personal notice to each of us?` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Can the Court order personal notice to each of us?` FALSE TRUE EQUALS JUST FALSE
