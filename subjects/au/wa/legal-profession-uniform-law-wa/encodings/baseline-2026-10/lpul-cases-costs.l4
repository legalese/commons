§ `ss 170, 179 -- who Part 4.3 protects`

#ASSERT NOT `Is my client a commercial or government client` `an individual`
#ASSERT `Is my client a commercial or government client` `a public company, a large proprietary company, a foreign company, or a subsidiary of one`

#ASSERT NOT `Can my client require a costs agreement` `a law practice`

§ `s 174 -- d038: disclosure to the arbitration client`

#ASSERT `What costs disclosure must I give` `an individual` 80000 EQUALS `full written disclosure: the basis of calculation, an estimate of the total legal costs and the client's four rights, when or as soon as practicable after instructions (s 174(1), (2), (6))`
#ASSERT `What costs disclosure must I give` `an individual` 750 EQUALS `none required: costs are not likely to exceed the $750 lower threshold, though the standard form may be given (s 174(4))`
#ASSERT `What costs disclosure must I give` `an individual` 3000 EQUALS `the uniform standard disclosure form will do (Form 1, or Form 2 for a barrister), or full disclosure: costs are not likely to exceed the $3000 higher threshold (s 174(5), General Rules r 72)`

#ASSERT `Does my disclosure meet section 174` `Daniel's full disclosure`

#ASSERT `Must I give further disclosure` `none, as costs were below the lower threshold` 900 FALSE EQUALS `yes: tell the client in writing that costs will now exceed $750, and give the standard form or full disclosure (s 174(7))`
#ASSERT `Must I give further disclosure` `the uniform standard disclosure form` 5000 FALSE EQUALS `yes: tell the client in writing that costs will now exceed $3000, and give full disclosure (s 174(8))`

-- Settling the arbitration: if it is a litigious matter (one reading of the fork), and if it is not.
#ASSERT `Must I disclose costs before settlement` `an individual` TRUE TRUE FALSE
#ASSERT NOT `Must I disclose costs before settlement` `an individual` FALSE TRUE FALSE

#ASSERT `What follows from not disclosing` TRUE FALSE EQUALS `the costs agreement is void, the client need not pay until the costs are assessed or the dispute determined, my firm may not sue until then, and it may be a conduct matter against those involved (s 178(1))`
#ASSERT `What follows from not disclosing` TRUE TRUE EQUALS `s 178(1) does not apply: the decision-maker is satisfied of reasonable steps, rectification within 14 days, and no substantial effect (General Rules r 72A)`

§ `ss 187, 190 -- bills (costs payable 1 May 2029)`

#ASSERT `Can my client still ask for an itemised bill` TRUE (Date 1 5 2029) (Date 31 5 2029)
#ASSERT NOT `Can my client still ask for an itemised bill` TRUE (Date 1 5 2029) (Date 1 6 2029)

§ `ss 194, 198(7) -- may the firm sue`

#ASSERT `May my firm sue for its costs` `a bill given 1 May 2029` (Date 31 5 2029) EQUALS `yes: my firm may now commence proceedings`
#ASSERT `May my firm sue for its costs` `the bill, with an itemised bill received 10 Jun` (Date 1 7 2029) EQUALS `not yet: 30 days have not passed since the bill, or the itemised bill (s 194(2)(b))`
#ASSERT `May my firm sue for its costs` `the bill, with a costs assessment pending` (Date 1 9 2029) EQUALS `no: a costs assessment has been applied for and is not complete (s 198(7)(b))`

§ `s 195, General Rules r 75 -- interest (Cash Rate Target 4.1%, hypothetical)`

#ASSERT `What is the highest interest rate my firm may charge` 4.1 EQUALS 6.1

#ASSERT `May my firm charge this interest` `6% on a bill unpaid 45 days`
#ASSERT NOT `May my firm charge this interest` `7% on a bill unpaid 45 days`

§ `ss 170, 197, 198 -- costs assessment (bill given 15 Mar 2029)`

#ASSERT `Can my client have my costs assessed` `an individual` (Date 15 3 2029) (Date 15 3 2030) FALSE FALSE EQUALS `yes: the application is within 12 months (s 198(3))`
#ASSERT `Can my client have my costs assessed` `an individual` (Date 15 3 2029) (Date 16 3 2030) FALSE FALSE EQUALS `out of time: it can be dealt with only if the designated tribunal finds it just and fair (s 198(4))`
#ASSERT `Can my client have my costs assessed` `a government authority` (Date 15 3 2029) (Date 1 4 2029) FALSE FALSE EQUALS `not under Part 4.3: it does not apply to a commercial or government client (s 170(1))`

-- Billed $10,000: assessed at $8,500 is a 15% reduction; at $8,600, 14%.
#ASSERT `Who pays for the costs assessment` FALSE 10000 8500 FALSE EQUALS `my firm pays them (s 204(2))`
#ASSERT `Who pays for the costs assessment` FALSE 10000 8600 FALSE EQUALS `as the costs assessor determines (s 204(1))`

§ `ss 188, 207 -- d038: an unfair bill and Daniel`

-- Daniel, an employee involved in giving the bill (no defence); a responsible principal with no reason to suspect;
-- the same principal without that answer.
#ASSERT `Can an unfair bill be a conduct matter against me` TRUE FALSE FALSE TRUE FALSE
#ASSERT NOT `Can an unfair bill be a conduct matter against me` TRUE TRUE FALSE FALSE TRUE
#ASSERT `Can an unfair bill be a conduct matter against me` TRUE TRUE FALSE FALSE FALSE

