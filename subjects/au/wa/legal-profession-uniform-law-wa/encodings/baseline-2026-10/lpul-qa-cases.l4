§§ `For the lawyer, where the situation holds: worked by hand, and equal to the baseline`

-- d031: admitted and certified (qualified); admitted, not yet certified (not).
#ASSERT `Am I a qualified entity, as a lawyer` `as the lawyer` TRUE FALSE EQUALS yes
#ASSERT `Am I a qualified entity, as a lawyer` `as the lawyer` FALSE FALSE EQUALS no
#ASSERT `Am I a qualified entity, as a lawyer` `as the lawyer` FALSE FALSE EQUALS `yes if` (`Am I a qualified entity` TRUE FALSE FALSE)
#ASSERT `Am I presumed to have represented that I may practise` `as the lawyer` TRUE EQUALS yes
#ASSERT `Am I presumed to have represented that I may practise` `as the lawyer` TRUE EQUALS `yes if` (`Am I presumed to have represented that I am entitled to practise` TRUE)
-- "Solicitor" on a letterhead before the certificate issues: an offence.
#ASSERT `May I say I may practise` `as the lawyer` FALSE FALSE EQUALS `on holding out` `no: it would be an offence under Uniform Law s 11(1), up to 250 penalty units`
#ASSERT `May I say I may practise` `as the lawyer` TRUE FALSE EQUALS `on holding out` `yes: I am a qualified entity`
#ASSERT `May I say I may practise` `as the lawyer` FALSE FALSE EQUALS `on holding out` (`May I say I am entitled to engage in legal practice` TRUE FALSE FALSE)
#ASSERT `May I say my firm may practise` `as the lawyer` TRUE FALSE EQUALS `on my firm` `yes: the entity is a qualified entity`
#ASSERT `May I say my firm may practise` `as the lawyer` FALSE FALSE EQUALS `on my firm` `no: it would be an offence under Uniform Law s 11(2), up to 50 penalty units`
#ASSERT `May I say my firm may practise` `as the lawyer` FALSE FALSE EQUALS `on my firm` (`May I say my firm is entitled to engage in legal practice` FALSE FALSE)

-- Without a certificate, neither, and the category is not read.
