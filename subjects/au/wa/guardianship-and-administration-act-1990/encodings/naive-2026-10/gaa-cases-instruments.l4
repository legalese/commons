#ASSERT NOT `the enduring guardian may make the decision` `voting for the appointor in an election` TRUE FALSE
#ASSERT NOT `the enduring guardian may make the decision` `making a will for the appointor` TRUE FALSE
#ASSERT NOT `the enduring guardian may make the decision` `selling the appointor's house` TRUE FALSE
#ASSERT NOT `the enduring guardian may make the decision` `consenting to an abortion` TRUE FALSE

