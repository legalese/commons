#ASSERT `the person may make the instrument` `an enduring power of attorney` 18 TRUE
#ASSERT NOT `the person may make the instrument` `an enduring power of attorney` 17 TRUE
#ASSERT `the person may make the instrument` `an enduring power of guardianship` 18 TRUE
#ASSERT `the person may make the instrument` `an advance health directive` 18 TRUE
#ASSERT `the person may make the instrument` `an enduring power of attorney` 56 TRUE
#ASSERT NOT `the person may make the instrument` `an enduring power of attorney` 56 FALSE
#ASSERT `the person may make the instrument` `an advance health directive` 78 TRUE

