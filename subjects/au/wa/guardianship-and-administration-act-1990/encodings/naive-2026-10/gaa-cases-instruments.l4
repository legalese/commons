#ASSERT `the person is eligible to be appointed under the instrument` `an enduring power of attorney` 41 TRUE
#ASSERT NOT `the person is eligible to be appointed under the instrument` `an enduring power of attorney` 10 TRUE
#ASSERT `the person is eligible to be appointed under the instrument` `an enduring power of guardianship` 29 TRUE
#ASSERT `the person is eligible to be appointed under the instrument` `an enduring power of attorney` 30 TRUE
#ASSERT NOT `the person is eligible to be appointed under the instrument` `an enduring power of guardianship` 45 FALSE
#ASSERT NOT `the person is eligible to be appointed under the instrument` `an advance health directive` 41 TRUE

§ `s 104 -- creating an enduring power of attorney`

#ASSERT `an enduring power of attorney is created` `Chloe's power to Liam, executed as the Act requires` 37 TRUE
#ASSERT NOT `an enduring power of attorney is created` `Chloe's power to Liam, executed as the Act requires` 17 TRUE
#ASSERT NOT `an enduring power of attorney is created` `a power witnessed by an authorised witness and the donee` 37 TRUE
#ASSERT `an enduring power of attorney is created` `a power witnessed by two witnesses authorised to take declarations` 37 TRUE
#ASSERT NOT `an enduring power of attorney is created` `a power without the donee's statement of acceptance` 37 TRUE
#ASSERT NOT `an enduring power of attorney is created` `a power naming a substitute who has not signed an acceptance` 37 TRUE

§ `ss 104(1)(b), 105, 106 -- when the power is in force`

#ASSERT `the enduring power of attorney is in force` `a continuing power` FALSE
#ASSERT NOT `the enduring power of attorney is in force` `a power that springs on a section 106 declaration` FALSE
#ASSERT `the enduring power of attorney is in force` `a power that springs on a section 106 declaration` TRUE

#ASSERT `the Tribunal may declare the donor lacks legal capacity` `a power that springs on a section 106 declaration` TRUE TRUE

