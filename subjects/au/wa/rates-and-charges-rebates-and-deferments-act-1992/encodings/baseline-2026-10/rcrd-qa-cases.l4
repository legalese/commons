§§ `For the pensioner or senior ratepayer (the baseline's seat)`

-- Am I an eligible pensioner in my own right, under the Act?
-- k095: a pensioner concession card, within the means test (s 23(1)).
#ASSERT `Am I an eligible pensioner in my own right, under the Act` `as the ratepayer` `k095: Jake at 67, on the Age Pension with a pensioner concession card` EQUALS yes
#ASSERT `Am I an eligible pensioner in my own right, under the Act` `as the ratepayer` `k095: Jake at 67, on the Age Pension with a pensioner concession card` EQUALS (`yes if` (`Am I an eligible pensioner in my own right` `k095: Jake at 67, on the Age Pension with a pensioner concession card`))
-- s 23(5) is the only limb she meets.
#ASSERT `Am I an eligible pensioner in my own right, under the Act` `as the ratepayer` `a parent of a disabled adult son who lives in her house` EQUALS no
#ASSERT `Am I an eligible pensioner in my own right, under the Act` `as the ratepayer` `a parent of a disabled adult son who lives in her house` EQUALS (`yes if` (`Am I an eligible pensioner in my own right` `a parent of a disabled adult son who lives in her house`))
-- s 23(4).
#ASSERT `Am I an eligible pensioner in my own right, under the Act` `as the ratepayer` `a self-funded retiree with a seniors card and a Commonwealth seniors health card` EQUALS yes
#ASSERT `Am I an eligible pensioner in my own right, under the Act` `as the ratepayer` `a self-funded retiree with a seniors card and a Commonwealth seniors health card` EQUALS (`yes if` (`Am I an eligible pensioner in my own right` `a self-funded retiree with a seniors card and a Commonwealth seniors health card`))
#ASSERT `Am I an eligible pensioner in my own right, under the Act` `as the partner` `unasked cards` EQUALS `does not arise for you`
#ASSERT `Am I an eligible pensioner in my own right, under the Act` `as the buyer or executor` `unasked cards` EQUALS `does not arise for you`

-- Am I an eligible pensioner under the Act?
#ASSERT `Am I an eligible pensioner under the Act` `as the ratepayer` `k095: Jake at 67, on the Age Pension with a pensioner concession card` EQUALS yes
#ASSERT `Am I an eligible pensioner under the Act` `as the ratepayer` `k095: Jake at 67, on the Age Pension with a pensioner concession card` EQUALS (`yes if` (`Am I an eligible pensioner` `k095: Jake at 67, on the Age Pension with a pensioner concession card`))
-- s 23(1)(c): over the means test.
#ASSERT `Am I an eligible pensioner under the Act` `as the ratepayer` `a pension card holder over the means test` EQUALS no
#ASSERT `Am I an eligible pensioner under the Act` `as the ratepayer` `a pension card holder over the means test` EQUALS (`yes if` (`Am I an eligible pensioner` `a pension card holder over the means test`))
-- s 23(1)(c): unless permanently blind.
#ASSERT `Am I an eligible pensioner under the Act` `as the ratepayer` `a permanently blind pension card holder over the means test` EQUALS yes
#ASSERT `Am I an eligible pensioner under the Act` `as the ratepayer` `a permanently blind pension card holder over the means test` EQUALS (`yes if` (`Am I an eligible pensioner` `a permanently blind pension card holder over the means test`))
-- s 23(5).
#ASSERT `Am I an eligible pensioner under the Act` `as the ratepayer` `a parent of a disabled adult son who lives in her house` EQUALS yes
#ASSERT `Am I an eligible pensioner under the Act` `as the ratepayer` `a parent of a disabled adult son who lives in her house` EQUALS (`yes if` (`Am I an eligible pensioner` `a parent of a disabled adult son who lives in her house`))
#ASSERT `Am I an eligible pensioner under the Act` `as the partner` `unasked cards` EQUALS `does not arise for you`
#ASSERT `Am I an eligible pensioner under the Act` `as the buyer or executor` `unasked cards` EQUALS `does not arise for you`

-- Am I an eligible senior under the Act?
#ASSERT `Am I an eligible senior under the Act` `as the ratepayer` `a retiree with only a seniors card` EQUALS yes
#ASSERT `Am I an eligible senior under the Act` `as the ratepayer` `a retiree with only a seniors card` EQUALS (`yes if` (`Am I an eligible senior` `a retiree with only a seniors card`))
#ASSERT `Am I an eligible senior under the Act` `as the ratepayer` `k095: Jake at 67, on the Age Pension with a pensioner concession card` EQUALS no
#ASSERT `Am I an eligible senior under the Act` `as the ratepayer` `k095: Jake at 67, on the Age Pension with a pensioner concession card` EQUALS (`yes if` (`Am I an eligible senior` `k095: Jake at 67, on the Age Pension with a pensioner concession card`))
#ASSERT `Am I an eligible senior under the Act` `as the partner` `unasked cards` EQUALS `does not arise for you`
#ASSERT `Am I an eligible senior under the Act` `as the buyer or executor` `unasked cards` EQUALS `does not arise for you`

-- On which basis should I register, as a pensioner or as a senior?
#ASSERT `On which basis should I register, as a pensioner or as a senior` `as the ratepayer` `k095: Jake at 67, on the Age Pension with a pensioner concession card` EQUALS `register` `as an eligible pensioner`
#ASSERT `On which basis should I register, as a pensioner or as a senior` `as the ratepayer` `k095: Jake at 67, on the Age Pension with a pensioner concession card` EQUALS (`register` (`On which basis should I register` `k095: Jake at 67, on the Age Pension with a pensioner concession card`))
-- s 23(4): both cards make a pensioner.
#ASSERT `On which basis should I register, as a pensioner or as a senior` `as the ratepayer` `a self-funded retiree with a seniors card and a Commonwealth seniors health card` EQUALS `register` `as an eligible pensioner`
#ASSERT `On which basis should I register, as a pensioner or as a senior` `as the ratepayer` `a self-funded retiree with a seniors card and a Commonwealth seniors health card` EQUALS (`register` (`On which basis should I register` `a self-funded retiree with a seniors card and a Commonwealth seniors health card`))
#ASSERT `On which basis should I register, as a pensioner or as a senior` `as the ratepayer` `a retiree with only a seniors card` EQUALS `register` `as an eligible senior`
#ASSERT `On which basis should I register, as a pensioner or as a senior` `as the ratepayer` `a retiree with only a seniors card` EQUALS (`register` (`On which basis should I register` `a retiree with only a seniors card`))
#ASSERT `On which basis should I register, as a pensioner or as a senior` `as the ratepayer` `someone with no card` EQUALS `register` `not eligible`
#ASSERT `On which basis should I register, as a pensioner or as a senior` `as the ratepayer` `someone with no card` EQUALS (`register` (`On which basis should I register` `someone with no card`))
#ASSERT `On which basis should I register, as a pensioner or as a senior` `as the partner` `unasked cards` EQUALS `does not arise for you`
#ASSERT `On which basis should I register, as a pensioner or as a senior` `as the buyer or executor` `unasked cards` EQUALS `does not arise for you`

-- Is my home treated as belonging to me?
#ASSERT `Is my home treated as belonging to me` `as the ratepayer` `k095: Jake's Cockburn Central strata apartment, sole owner` EQUALS yes
#ASSERT `Is my home treated as belonging to me` `as the ratepayer` `k095: Jake's Cockburn Central strata apartment, sole owner` EQUALS (`yes if` (`Does my home belong to me` `k095: Jake's Cockburn Central strata apartment, sole owner`))
-- s 29A.
#ASSERT `Is my home treated as belonging to me` `as the ratepayer` `a retirement village unit with a charge arrangement` EQUALS yes
#ASSERT `Is my home treated as belonging to me` `as the ratepayer` `a retirement village unit with a charge arrangement` EQUALS (`yes if` (`Does my home belong to me` `a retirement village unit with a charge arrangement`))
#ASSERT `Is my home treated as belonging to me` `as the ratepayer` `a rented flat` EQUALS no
#ASSERT `Is my home treated as belonging to me` `as the ratepayer` `a rented flat` EQUALS (`yes if` (`Does my home belong to me` `a rented flat`))
#ASSERT `Is my home treated as belonging to me` `as the partner` `an unasked home` EQUALS `does not arise for you`
#ASSERT `Is my home treated as belonging to me` `as the buyer or executor` `an unasked home` EQUALS `does not arise for you`

-- Is my home still my ordinary place of residence?
-- s 30(1): left for care, belongings there, empty.
#ASSERT `Is my home still my ordinary place of residence` `as the ratepayer` `a home left for a nursing home, furniture still there, empty` EQUALS yes
#ASSERT `Is my home still my ordinary place of residence` `as the ratepayer` `a home left for a nursing home, furniture still there, empty` EQUALS (`yes if` (`Is my home my ordinary place of residence` `a home left for a nursing home, furniture still there, empty`))
-- Let at a rent.
#ASSERT `Is my home still my ordinary place of residence` `as the ratepayer` `the same home, let at a rent` EQUALS no
#ASSERT `Is my home still my ordinary place of residence` `as the ratepayer` `the same home, let at a rent` EQUALS (`yes if` (`Is my home my ordinary place of residence` `the same home, let at a rent`))
#ASSERT `Is my home still my ordinary place of residence` `as the partner` `an unasked home` EQUALS `does not arise for you`
#ASSERT `Is my home still my ordinary place of residence` `as the buyer or executor` `an unasked home` EQUALS `does not arise for you`

-- Must my entitlement to my home be registered?
-- k095.
#ASSERT `Must my entitlement to my home be registered` `as the ratepayer` `k095: Jake at 67, on the Age Pension with a pensioner concession card` `k095: Jake's Cockburn Central strata apartment, sole owner` EQUALS yes
#ASSERT `Must my entitlement to my home be registered` `as the ratepayer` `k095: Jake at 67, on the Age Pension with a pensioner concession card` `k095: Jake's Cockburn Central strata apartment, sole owner` EQUALS (`yes if` (`Must my entitlement be registered` `k095: Jake at 67, on the Age Pension with a pensioner concession card` `k095: Jake's Cockburn Central strata apartment, sole owner`))
#ASSERT `Must my entitlement to my home be registered` `as the ratepayer` `k095: Jake at 67, on the Age Pension with a pensioner concession card` `a rented flat` EQUALS no
#ASSERT `Must my entitlement to my home be registered` `as the ratepayer` `k095: Jake at 67, on the Age Pension with a pensioner concession card` `a rented flat` EQUALS (`yes if` (`Must my entitlement be registered` `k095: Jake at 67, on the Age Pension with a pensioner concession card` `a rented flat`))
-- s 23(5), s 32(4a).
#ASSERT `Must my entitlement to my home be registered` `as the ratepayer` `a parent of a disabled adult son who lives in her house` `a rented flat` EQUALS yes
#ASSERT `Must my entitlement to my home be registered` `as the ratepayer` `a parent of a disabled adult son who lives in her house` `a rented flat` EQUALS (`yes if` (`Must my entitlement be registered` `a parent of a disabled adult son who lives in her house` `a rented flat`))
#ASSERT `Must my entitlement to my home be registered` `as the partner` `unasked cards` `an unasked home` EQUALS `does not arise for you`
#ASSERT `Must my entitlement to my home be registered` `as the buyer or executor` `unasked cards` `an unasked home` EQUALS `does not arise for you`

-- Does my rates application also count for the emergency services levy?
#ASSERT `Does my rates application also count for the emergency services levy` `as the ratepayer` EQUALS yes
#ASSERT `Does my rates application also count for the emergency services levy` `as the ratepayer` EQUALS (`yes if` (`Does my rates application also cover the emergency services levy`))
#ASSERT `Does my rates application also count for the emergency services levy` `as the partner` EQUALS `does not arise for you`
#ASSERT `Does my rates application also count for the emergency services levy` `as the buyer or executor` EQUALS `does not arise for you`

-- With arrears outstanding, may I still pay only the rebated amount?
-- s 33(6) is for pensioners only.
#ASSERT `With arrears outstanding, may I still pay only the rebated amount` `as the ratepayer` `as an eligible senior` TRUE TRUE FALSE EQUALS no
#ASSERT `With arrears outstanding, may I still pay only the rebated amount` `as the ratepayer` `as an eligible senior` TRUE TRUE FALSE EQUALS (`yes if` (`May I pay only the rebated amount despite arrears` `as an eligible senior` TRUE TRUE FALSE))
#ASSERT `With arrears outstanding, may I still pay only the rebated amount` `as the ratepayer` `as an eligible pensioner` TRUE TRUE FALSE EQUALS yes
#ASSERT `With arrears outstanding, may I still pay only the rebated amount` `as the ratepayer` `as an eligible pensioner` TRUE TRUE FALSE EQUALS (`yes if` (`May I pay only the rebated amount despite arrears` `as an eligible pensioner` TRUE TRUE FALSE))
-- s 33(7).
#ASSERT `With arrears outstanding, may I still pay only the rebated amount` `as the ratepayer` `as an eligible pensioner` TRUE TRUE TRUE EQUALS no
#ASSERT `With arrears outstanding, may I still pay only the rebated amount` `as the ratepayer` `as an eligible pensioner` TRUE TRUE TRUE EQUALS (`yes if` (`May I pay only the rebated amount despite arrears` `as an eligible pensioner` TRUE TRUE TRUE))
#ASSERT `With arrears outstanding, may I still pay only the rebated amount` `as the ratepayer` `as an eligible senior` FALSE FALSE FALSE EQUALS yes
#ASSERT `With arrears outstanding, may I still pay only the rebated amount` `as the ratepayer` `as an eligible senior` FALSE FALSE FALSE EQUALS (`yes if` (`May I pay only the rebated amount despite arrears` `as an eligible senior` FALSE FALSE FALSE))
#ASSERT `With arrears outstanding, may I still pay only the rebated amount` `as the partner` `an unasked basis` `an unasked fact` `an unasked fact` `an unasked fact` EQUALS `does not arise for you`
#ASSERT `With arrears outstanding, may I still pay only the rebated amount` `as the buyer or executor` `an unasked basis` `an unasked fact` `an unasked fact` `an unasked fact` EQUALS `does not arise for you`

