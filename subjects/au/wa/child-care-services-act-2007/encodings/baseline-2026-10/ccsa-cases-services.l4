#ASSERT `May the provider advertise the service` TRUE FALSE
#ASSERT `May the provider advertise the service` FALSE TRUE
#ASSERT NOT `May the provider advertise the service` FALSE FALSE

§ `s 29(4)(b)(ii) -- a refund of fees`

#ASSERT `Could I be refunded my fees` `a creche the National Law excludes and the regulations prescribe (illustrative)` FALSE TRUE FALSE FALSE FALSE EQUALS `possible: the Tribunal may order the licensee to refund my fees, if the CEO alleges and the Tribunal is satisfied grounds exist`
#ASSERT `Could I be refunded my fees` `a creche the National Law excludes and the regulations prescribe (illustrative)` FALSE FALSE FALSE FALSE FALSE EQUALS `no: no ground for disciplinary action is stated`
#ASSERT `Could I be refunded my fees` `Oliver's long day care, three days a week (c066)` FALSE TRUE FALSE FALSE FALSE EQUALS `not under this Act: it does not license the service`

