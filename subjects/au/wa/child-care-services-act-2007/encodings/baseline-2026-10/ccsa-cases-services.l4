#ASSERT NOT `Must the supervising officer be present` `a creche the National Law excludes and the regulations prescribe (illustrative)` TRUE FALSE
#ASSERT NOT `Must the supervising officer be present` `Oliver's long day care, three days a week (c066)` FALSE FALSE

