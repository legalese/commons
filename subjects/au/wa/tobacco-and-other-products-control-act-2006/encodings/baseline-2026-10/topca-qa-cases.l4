#ASSERT `Does the seller who sold me tobacco have the s 13 defence` `as the young person` TRUE TRUE 13 TRUE TRUE EQUALS no
#ASSERT `Does the seller who sold me tobacco have the s 13 defence` `as the young person` TRUE TRUE 16 FALSE TRUE EQUALS `yes if` (`Does the seller have the s 13 defence` TRUE 16 FALSE TRUE)

