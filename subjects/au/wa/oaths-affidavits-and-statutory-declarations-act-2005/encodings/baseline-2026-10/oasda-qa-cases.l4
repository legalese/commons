#ASSERT `May I witness this affidavit, and how` `as the witness` `an affidavit made` `Daniel witnesses an affidavit in Perth for another firm's client (d034)` EQUALS `as a witness of this affidavit I am` `authorised: an experienced legal practitioner (s 9(6)(b))`
#ASSERT `May I witness this affidavit, and how` `as the witness` `an affidavit made` `Daniel witnesses an affidavit he helped prepare (d034)` EQUALS `as a witness of this affidavit I am` `not authorised: an experienced legal practitioner who took part in preparing it or in its proceedings (s 9(7))`
#ASSERT `May I witness this affidavit, and how` `as the witness` `an affidavit made` `Daniel in 2021, one year after admission (d031)` EQUALS `as a witness of this affidavit I am` `not authorised: not yet a legal practitioner for 2 years (s 8)`
#ASSERT `May I witness this affidavit, and how` `as the witness` `an affidavit made` `a JP who helped prepare the affidavit` EQUALS `as a witness of this affidavit I am` `authorised: a Justice of the Peace (s 9(6)(a))`
#ASSERT `May I witness this affidavit, and how` `as the witness` `an affidavit made` `Daniel witnesses an affidavit in Singapore` EQUALS `as a witness of this affidavit I am` (`May I witness this affidavit` `Daniel witnesses an affidavit in Singapore`)
#ASSERT `May I witness this affidavit, and how` `as the witness` `a declaration` `an unasked affidavit witness` EQUALS `does not arise for you`
#ASSERT `May I witness this affidavit, and how` `as the maker` `an unasked document` `an unasked affidavit witness` EQUALS `does not arise for you`

§§§ `ss 13, 17 (no situation input)`

-- Must I read the document aloud and certify it
-- A blind or illiterate maker: yes; otherwise: no.
#ASSERT `Must I read the document aloud and certify it` `as the witness` TRUE EQUALS yes
#ASSERT `Must I read the document aloud and certify it` `as the witness` FALSE EQUALS no
#ASSERT `Must I read the document aloud and certify it` `as the witness` TRUE EQUALS `yes if` (`Must I read it aloud and certify` TRUE)
#ASSERT `Must I read the document aloud and certify it` `as the maker` `an unasked fact` EQUALS `does not arise for you`

-- Do I commit the offence of pretending to be an authorised witness
