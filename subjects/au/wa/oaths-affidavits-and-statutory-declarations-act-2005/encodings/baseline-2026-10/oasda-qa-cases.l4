#ASSERT `Am I an experienced legal practitioner for affidavits` `as the witness` `an affidavit made` TRUE TRUE 1 EQUALS no
#ASSERT `Am I an experienced legal practitioner for affidavits` `as the witness` `an affidavit made` TRUE FALSE 5 EQUALS no
#ASSERT `Am I an experienced legal practitioner for affidavits` `as the witness` `an affidavit made` TRUE TRUE 2 EQUALS `yes if` (`Am I an experienced legal practitioner` TRUE TRUE 2)
#ASSERT `Am I an experienced legal practitioner for affidavits` `as the witness` `a declaration` `an unasked fact` `an unasked fact` `an unasked number` EQUALS `does not arise for you`
#ASSERT `Am I an experienced legal practitioner for affidavits` `as the maker` `an unasked document` `an unasked fact` `an unasked fact` `an unasked number` EQUALS `does not arise for you`

-- May I witness this affidavit, and how
