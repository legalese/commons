IMPORT prelude
IMPORT `lca-juveniles`

-- Liquor Control Act 1988 (WA), Part 4 Division 9 (juveniles) and s 167 -- worked cases from the seat of the young person.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked against a
-- decided case or the Liquor Control Regulations 1989 (not deposited).
--
-- Fixtures are generated from a table of arguments (scratchpad gen_wa_liquor-control-act-1988_baseline.py). Expected results
-- were written by hand from the text. Chloe's date of birth (14 March 2003) is from the WA cradle-to-grave scenario.

§ `s 3(1) and the seat's question -- life event c025, Chloe turns 18 (14 March 2021)`

#ASSERT `Am I a juvenile` 20030314 20210313
#ASSERT NOT `Am I a juvenile` 20030314 20210314

#ASSERT `May I buy and drink alcohol here now` 20030314 20210314 `licensed premises`
#ASSERT NOT `May I buy and drink alcohol here now` 20030314 20210313 `licensed premises`
#ASSERT `May I buy and drink alcohol here now` 20030314 20210313 `a private home or other private place`

§ `ss 120, 121(4)-(8) -- licensed premises`

#ASSERT `Is it an offence for me to be on licensed premises` `no particular reason` `nobody` FALSE FALSE
#ASSERT NOT `Is it an offence for me to be on licensed premises` `no particular reason` `my parent` TRUE TRUE
#ASSERT `Is it an offence for me to be on licensed premises` `no particular reason` `my parent` TRUE FALSE
#ASSERT `Is it an offence for me to be on licensed premises` `no particular reason` `another adult or friend` TRUE TRUE
#ASSERT NOT `Is it an offence for me to be on licensed premises` `to get a meal` `nobody` FALSE FALSE

#ASSERT `Can I be made to leave an out-of-bounds area` `to get a meal` TRUE
#ASSERT NOT `Can I be made to leave an out-of-bounds area` `I live there as family of the licensee, the manager or an employee` TRUE

#ASSERT `Have I committed an offence by not leaving` `no particular reason` TRUE TRUE FALSE

§ `s 122(3), (4) -- regulated premises`

#ASSERT `Is it an offence for me to be on regulated premises` `no particular reason` TRUE FALSE
#ASSERT NOT `Is it an offence for me to be on regulated premises` `to get a meal` TRUE FALSE

§ `ss 121(3), 123 -- buying, carrying and drinking`

#ASSERT `Is it an offence for me to buy or get liquor here` `licensed premises`
#ASSERT `Is it an offence for me to buy or get liquor here` `a road or footpath`
#ASSERT NOT `Is it an offence for me to buy or get liquor here` `a private home or other private place`

#ASSERT `Is it an offence for me to drink here` `licensed premises`
#ASSERT NOT `Is it an offence for me to drink here` `a private home or other private place`
#ASSERT `Is it an offence for me to drink here` `another place the public can go`

#ASSERT `Have I committed an offence by getting someone to buy for me` `licensed premises` TRUE

§ `ss 121(1), 122(2), 122A, 124, 125(1)(b) -- the person who gives me alcohol`

#ASSERT `Is it lawful for this person to give me alcohol here` `a private home or other private place` `my parent or guardian` FALSE FALSE TRUE FALSE FALSE
#ASSERT `Is it lawful for this person to give me alcohol here` `a private home or other private place` `another person, with my parent's or guardian's consent` FALSE FALSE FALSE TRUE FALSE
#ASSERT NOT `Is it lawful for this person to give me alcohol here` `a private home or other private place` `another person, with my parent's or guardian's consent` FALSE FALSE TRUE TRUE FALSE
#ASSERT NOT `Is it lawful for this person to give me alcohol here` `a private home or other private place` `another person, without that consent` FALSE FALSE FALSE TRUE FALSE
#ASSERT NOT `Is it lawful for this person to give me alcohol here` `licensed premises` `my parent or guardian` FALSE FALSE FALSE TRUE FALSE
#ASSERT NOT `Is it lawful for this person to give me alcohol here` `a road or footpath` `my parent or guardian` FALSE FALSE FALSE TRUE FALSE

#ASSERT `What is the most the supplier can be fined` `licensed premises` `anyone else who sold or supplied it` EQUALS 6000
#ASSERT `What is the most the supplier can be fined` `a private home or other private place` `anyone else who sold or supplied it` EQUALS 10000

#ASSERT NOT `Could the seller rely on believing I was 18` 15 TRUE
#ASSERT `Could the seller rely on believing I was 18` 16 TRUE

#ASSERT `Did the person who sent me commit an offence` `licensed premises` TRUE TRUE

§ `s 121(10), (11) -- serving liquor at work`

#ASSERT NOT `May I be employed to serve liquor` 15 TRUE TRUE TRUE TRUE
#ASSERT `May I be employed to serve liquor` 16 TRUE TRUE TRUE TRUE

§ `s 126 -- proof of age`

#ASSERT `Can I be required to show evidence of my age` `licensed premises` TRUE TRUE

#ASSERT `Does this count as evidence of my age` `evidence issued in digital form, shown in that form or by its QR code`
#ASSERT NOT `Does this count as evidence of my age` `a photograph on my phone of a physical card`
#ASSERT NOT `Does this count as evidence of my age` `a student card`

#ASSERT NOT `Can my ID be confiscated` `a current passport` TRUE
#ASSERT `Can my ID be confiscated` `a current WA photo card` TRUE

#ASSERT `Have I committed an offence answering the request for my age` FALSE FALSE TRUE

#ASSERT `Have I committed an offence by going back in` TRUE 23

§ `Penalties and infringement notices`

#ASSERT `What is the most I can be fined` `s 121(3) getting someone to buy liquor for me on licensed premises` EQUALS 2000

#ASSERT `What would an infringement notice ask me to pay` `s 123(2) having liquor in a public place` EQUALS 300

