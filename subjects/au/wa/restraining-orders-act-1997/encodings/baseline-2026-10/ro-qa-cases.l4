    `we are or were married` IS FALSE
    `we are or were in a de facto relationship` IS FALSE
    `we are or were related` IS FALSE
    `one of us is a child who lives or stays, or did, with the other` IS FALSE
    `one of us is or was a child of whom the other is a guardian` IS FALSE
    `we have or had an intimate or other personal relationship` IS FALSE
    `one of us is the former partner of the other's current partner` IS FALSE

