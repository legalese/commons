#ASSERT `Is it an offence for me to play` `no ban` `Ruby playing at dinner with Jake`
#ASSERT NOT `Is it an offence for me to play` `no ban` `an 18-year-old at the tables`

#ASSERT `What is the largest fine I risk for this visit` `Jake self-excluded` `Jake on payday at the tables` FALSE EQUALS 50000
#ASSERT `What is the largest fine I risk for this visit` `Jake self-excluded` `Jake walking in` FALSE EQUALS 10000
#ASSERT `What is the largest fine I risk for this visit` `an on-the-spot ban 3 hours old` `Jake walking in` FALSE EQUALS 5000
#ASSERT `What is the largest fine I risk for this visit` `no ban` `Ruby playing at dinner with Jake` FALSE EQUALS 2000
#ASSERT `What is the largest fine I risk for this visit` `no ban` `Ruby at dinner alone` FALSE EQUALS 1000
#ASSERT `What is the largest fine I risk for this visit` `no ban` `Jake on payday at the tables` FALSE EQUALS 0

#ASSERT `Is the game lawful in the casino` `Jake on payday at the tables`
#ASSERT NOT `Is the game lawful in the casino` `Jake at a poker machine`
#ASSERT NOT `Is the game lawful in the casino` `an adult at a game not played to the approved rules`

