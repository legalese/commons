#ASSERT `Is my agreement to cash out annual leave valid` `as the employee` FALSE TRUE 40 76 TRUE TRUE FALSE EQUALS no
#ASSERT `Is my agreement to cash out annual leave valid` `as the employee` FALSE TRUE 38 76 TRUE TRUE TRUE EQUALS no
#ASSERT `Is my agreement to cash out annual leave valid` `as the employee` FALSE FALSE 38 76 TRUE TRUE FALSE EQUALS `yes if` (`Is my cash-out agreement valid` FALSE 38 76 TRUE TRUE FALSE)

