IMPORT prelude
IMPORT `mce-employee`

-- Minimum Conditions of Employment Act 1993 (WA), the employee's questions -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_wa_minimum-conditions-of-employment-act-1993_baseline.py). Expected results were written by
-- hand from the text.

-- Facts are from the Western Australian lives (workbench scenarios/au/wa/cradle-to-grave-*), named by event id.
-- Figures marked HYPOTHETICAL are invented for the case. The State Wage rate is not deposited: 987.65 a week is
-- HYPOTHETICAL throughout.

-- c040: Chloe joins the graduate program at Ironbark Logistics Pty Ltd, $70,000 a year; Ironbark is a national system employer.
`Chloe at Ironbark (c040)` MEANS MyWork WITH
    `I work for someone for hire or reward` IS TRUE
    `in substance the relationship is employment, not contracting` IS TRUE
    `I am a police officer` IS FALSE
    `my employer is a national system employer` IS TRUE

-- HYPOTHETICAL: a clerk whose employer is not a national system employer.
`a State system clerk` MEANS MyWork WITH
    `I work for someone for hire or reward` IS TRUE
    `in substance the relationship is employment, not contracting` IS TRUE
    `I am a police officer` IS FALSE
    `my employer is a national system employer` IS FALSE

`a contractor in substance` MEANS MyWork WITH
    `I work for someone for hire or reward` IS TRUE
    `in substance the relationship is employment, not contracting` IS FALSE
    `I am a police officer` IS FALSE
    `my employer is a national system employer` IS FALSE

`a WA police officer` MEANS MyWork WITH
    `I work for someone for hire or reward` IS FALSE
    `in substance the relationship is employment, not contracting` IS FALSE
    `I am a police officer` IS TRUE
    `my employer is a national system employer` IS FALSE

§ `ss 3, 5, 6A -- does this Act apply to me`

-- c040: Chloe is an employee, but the Act gives her nothing: Ironbark is a national system employer (FW Act s 26).
#ASSERT `Am I an employee for this Act` `Chloe at Ironbark (c040)`
#ASSERT NOT `Am I an employee for this Act` `a contractor in substance`

#ASSERT NOT `Does this Act give me its minimum conditions` `Chloe at Ironbark (c040)`
#ASSERT `Does this Act give me its minimum conditions` `a State system clerk`
#ASSERT `Does this Act give me its minimum conditions` `a WA police officer`

#ASSERT NOT `Does the term bind me` TRUE FALSE
#ASSERT `Does the term bind me` TRUE TRUE

§ `s 8 -- cashing out annual leave`

-- 38 of 76 hours is exactly 50%: allowed. 40 of 76 is more than half. A job offer conditional on it voids it.
#ASSERT `Is my cash-out agreement valid` TRUE 38 76 TRUE TRUE FALSE
#ASSERT NOT `Is my cash-out agreement valid` TRUE 40 76 TRUE TRUE FALSE
#ASSERT NOT `Is my cash-out agreement valid` TRUE 38 76 TRUE TRUE TRUE

§ `ss 9A, 9B -- maximum hours`

#ASSERT `What are my ordinary weekly hours` FALSE 0 EQUALS 38

#ASSERT NOT `Can I be asked to work these hours` 45 38 FALSE
#ASSERT `Can I be asked to work these hours` 45 38 TRUE

§ `ss 10-14 -- minimum rates of pay`

-- s 13: 18 years, 70% of 987.65 = 691.355, to the nearest 10 cents 691.40; 15 years, 40% = 395.06, so 395.10.
#ASSERT `What is my minimum weekly rate` 25 FALSE 987.65 0 EQUALS 987.65
#ASSERT `What is my minimum weekly rate` 18 FALSE 987.65 0 EQUALS 691.4
#ASSERT `What is my minimum weekly rate` 15 FALSE 987.65 0 EQUALS 395.1
#ASSERT `What is my minimum weekly rate` 19 TRUE 987.65 600 EQUALS 600

-- s 10: 950 / 38 = 25.00 an hour; s 11: casual adds 25%, 31.25.
#ASSERT `What is my minimum hourly rate` 950 FALSE 0 EQUALS 25
#ASSERT `What is my minimum hourly rate` 950 TRUE 0 EQUALS 31.25

§ `ss 19-21 -- personal leave`

-- Full-time 38 hours: 76 hours, the same 10 days the Fair Work Act s 96 gives. Part-time 20 hours: 40.
#ASSERT `How many hours of personal leave a year` FALSE 38 EQUALS 76
#ASSERT `How many hours of personal leave a year` FALSE 20 EQUALS 40

#ASSERT `Am I paid for this personal leave` TRUE FALSE TRUE
#ASSERT NOT `Am I paid for this personal leave` TRUE TRUE TRUE

#ASSERT `How many days of unpaid personal leave` TRUE TRUE EQUALS 2

§ `ss 23-26 -- paid annual leave`

-- Full-time 38 hours: 152 hours, the same 4 weeks the Fair Work Act s 87 gives. A casual earns none.
#ASSERT `How many hours of annual leave a year` FALSE 38 EQUALS 152
#ASSERT `How many hours of annual leave a year` TRUE 38 EQUALS 0

#ASSERT `How many hours of annual leave accrued` FALSE 38 26 EQUALS 76

#ASSERT `Can I insist on my annual leave` FALSE 13 2
#ASSERT NOT `Can I insist on my annual leave` FALSE 6 4

#ASSERT `Must I be paid before my leave starts` TRUE

-- HYPOTHETICAL hours: 100 from completed years, 30 from the part-year, 40 from a year completed after misconduct.
#ASSERT `How many hours of annual leave must be paid out` `I resigned lawfully` 100 30 0 EQUALS 130
#ASSERT `How many hours of annual leave must be paid out` `my employer ended it for my misconduct` 100 30 40 EQUALS 60
#ASSERT `How many hours of annual leave must be paid out` `I walked out unlawfully` 100 30 0 EQUALS 100

§ `s 27 -- paid bereavement leave`

#ASSERT `How many days of bereavement leave` `my or my partner's parent, step-parent or grandparent` EQUALS 2
#ASSERT `How many days of bereavement leave` `another relative or a friend who did not live with me` EQUALS 0

§ `ss 30, 31 -- public holidays`

#ASSERT NOT `May I refuse to work the public holiday` TRUE FALSE
#ASSERT `May I refuse to work the public holiday` FALSE FALSE

#ASSERT NOT `Am I paid for the public holiday` TRUE TRUE FALSE

§ `ss 39B, 39C -- unpaid family and domestic violence leave`

#ASSERT `How many days of family violence leave can I take` TRUE TRUE TRUE 3 EQUALS 2
#ASSERT `How many days of family violence leave can I take` TRUE TRUE FALSE 0 EQUALS 0

§ `ss 40, 41, 43 -- redundancy`

#ASSERT NOT `Am I entitled to be told and consulted` TRUE TRUE FALSE

#ASSERT `How many hours of job interview leave` FALSE FALSE TRUE EQUALS 8
#ASSERT `How many hours of job interview leave` FALSE TRUE TRUE EQUALS 0

