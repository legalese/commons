IMPORT prelude
IMPORT daydate
IMPORT `cat-owner`

-- Cat Act 2011 (WA), Cat Regulations 2012 and Cat (Uniform Local Provisions) Regulations 2013 -- worked cases from the
-- seat of the cat owner.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or a local government's practice.
--
-- Fixtures are generated from a table (scratchpad gen_wa_cat-act-2011_baseline.py). Expected results were written by
-- hand from the text.
--
-- Facts from the WA lives (workbench scenarios au/wa/cradle-to-grave-chloe): c076, 14 February 2036, Chloe takes on a
-- cat, Biscuit, and has it sterilised, microchipped and registered. Biscuit's date of birth is not in the scenario:
-- 1 October 2035 below is an ASSUMED placeholder, so Biscuit is a kitten of about four and a half months on the event
-- day and reaches 6 months on 1 April 2036. The other people and cats are the encoder's illustrations.

§ `s 4 -- am I the owner`

#ASSERT `Am I the owner of this cat` `I am the person it is registered to` TRUE FALSE
#ASSERT NOT `Am I the owner of this cat` `I ordinarily keep and care for it` TRUE FALSE
#ASSERT `Am I the owner of this cat` `my child under 18 ordinarily keeps and cares for it` FALSE FALSE
#ASSERT NOT `Am I the owner of this cat` `my name is on its microchip database record` FALSE TRUE

§ `ss 5(1), 14(1), 18(1) -- the day my cat reaches 6 months`

-- c076: Biscuit (assumed born 1 October 2035) reaches 6 months on 1 April 2036.
#ASSERT `When does my cat reach 6 months of age` (Date 1 10 2035) EQUALS (Date 1 4 2036)
#ASSERT `When does my cat reach 6 months of age` (Date 31 8 2035) EQUALS (Date 1 3 2036)
#ASSERT `When does my cat reach 6 months of age` (Date 29 8 2035) EQUALS (Date 29 2 2036)

§ `s 5 and reg 9 -- registration`

-- c076: on the event day Biscuit is not yet 6 months old, so s 5 does not yet require registration.
#ASSERT `Must I have my cat registered` (Date 1 10 2035) (Date 14 2 2036) 30 5000 `at home with me` 0 FALSE EQUALS `no: my cat is not yet 6 months old (s 5(1))`
#ASSERT `Must I have my cat registered` (Date 1 10 2035) (Date 1 4 2036) 77 5000 `at home with me` 0 FALSE EQUALS `yes: register it with the local government of the district where it is ordinarily kept (s 5(1))`
#ASSERT `Must I have my cat registered` (Date 1 10 2035) (Date 1 4 2036) 77 5000 `at home with me` 0 TRUE EQUALS `yes, and it is registered: keep the registration current (s 5(1))`
#ASSERT `Must I have my cat registered` (Date 1 1 2030) (Date 14 2 2036) 10 5000 `at home with me` 0 FALSE EQUALS `no: I have kept the cat for less than 14 days (s 5(2)(a))`
#ASSERT `Must I have my cat registered` (Date 1 1 2030) (Date 14 2 2036) 14 5 `at home with me` 0 FALSE EQUALS `no: I have been resident in the State for less than 14 days (s 5(2)(b))`
#ASSERT `Must I have my cat registered` (Date 1 1 2030) (Date 14 2 2036) 100 5000 `in foster care placed by a SAFE entity` 10 FALSE EQUALS `no: my cat is in a class exempt from registration (s 5(2)(c), reg 9)`

§ `s 6 and reg 10 -- the tag`

#ASSERT `Must my cat be wearing its tag` TRUE TRUE FALSE
#ASSERT NOT `Must my cat be wearing its tag` TRUE TRUE TRUE

§ `s 14 -- microchipping`

-- c076: Biscuit need not yet be microchipped; from 1 April 2036 it must be.
#ASSERT `Must I have my cat microchipped` (Date 1 10 2035) (Date 14 2 2036) FALSE FALSE EQUALS `no: my cat is not yet 6 months old (s 14(1))`
#ASSERT `Must I have my cat microchipped` (Date 1 10 2035) (Date 1 4 2036) FALSE FALSE EQUALS `yes: have it microchipped by a microchip implanter (s 14(1), reg 8)`
#ASSERT `Must I have my cat microchipped` (Date 1 1 2030) (Date 14 2 2036) FALSE TRUE EQUALS `no: a veterinarian's certificate exempts my cat (s 14(2))`

§ `s 18 -- sterilisation`

-- c076: Biscuit need not yet be sterilised; once sterilised the duty from 1 April 2036 is met.
#ASSERT `Must I have my cat sterilised` (Date 1 10 2035) (Date 14 2 2036) FALSE FALSE FALSE EQUALS `no: my cat is not yet 6 months old (s 18(1))`
#ASSERT `Must I have my cat sterilised` (Date 1 10 2035) (Date 1 4 2036) TRUE FALSE FALSE EQUALS `yes, and it is sterilised (s 18(1))`
#ASSERT `Must I have my cat sterilised` (Date 1 1 2030) (Date 14 2 2036) FALSE FALSE TRUE EQUALS `no: I am an approved cat breeder and own it for breeding (s 18(2)(b))`

§ `s 9(2)-(4) -- must my application be refused`

-- c076: Chloe registers Biscuit early, already microchipped and sterilised: no ground for refusal.
-- A kitten not yet sterilised must be refused: s 9(4) protects only a cat exempt under s 18(2), and a kitten is
-- not exempt, merely not yet required to be sterilised. Nor can a vet's certificate exempt a kitten (s 14(3)).
#ASSERT `Must my registration be refused` (Date 1 10 2035) (Date 14 2 2036) FALSE `at home with me` 0 TRUE FALSE TRUE FALSE FALSE 0 EQUALS `not to be refused, if the local government is satisfied of none of the s 9(2) grounds`
#ASSERT `Must my registration be refused` (Date 1 10 2035) (Date 14 2 2036) FALSE `at home with me` 0 TRUE FALSE FALSE FALSE FALSE 0 EQUALS `refused: my cat is not sterilised (s 9(2)(d))`
#ASSERT `Must my registration be refused` (Date 1 10 2035) (Date 14 2 2036) FALSE `at home with me` 0 FALSE TRUE TRUE FALSE FALSE 0 EQUALS `refused: my cat is not microchipped (s 9(2)(c))`
#ASSERT `Must my registration be refused` (Date 1 1 2030) (Date 14 2 2036) TRUE `at home with me` 0 TRUE FALSE TRUE FALSE FALSE 0 EQUALS `refused: I am under 18 (s 9(2)(a))`
#ASSERT `Must my registration be refused` (Date 1 1 2030) (Date 14 2 2036) FALSE `at home with me` 0 TRUE FALSE TRUE FALSE FALSE 2 EQUALS `refused: 2 or more convictions within the previous 3 years (s 9(2)(e))`

§ `Cat Regulations 2012 Sch 3 -- the fee`

-- c076: a one-year grant applied for on 14 February 2036 costs at most $20.
#ASSERT `What is the most my registration fee can be` `one year` FALSE (Date 14 2 2036) FALSE EQUALS 20
#ASSERT `What is the most my registration fee can be` `one year` FALSE (Date 1 6 2036) FALSE EQUALS 10
#ASSERT `What is the most my registration fee can be` `one year` FALSE (Date 15 11 2036) FALSE EQUALS 20
#ASSERT `What is the most my registration fee can be` `one year` TRUE (Date 15 10 2036) FALSE EQUALS 20
#ASSERT `What is the most my registration fee can be` `3 years` FALSE (Date 14 2 2036) TRUE EQUALS 21.25
#ASSERT `What is the most my registration fee can be` `the life of the cat` FALSE (Date 14 2 2036) FALSE EQUALS 100

§ `Cat Regulations 2012 reg 12 -- how long registration lasts`

-- c076: a one-year registration taking effect on 14 February 2036 ends on 31 October 2036.
#ASSERT `When does my cat's registration end` `one year` (Date 14 2 2036) EQUALS (`on 31 October` (Date 31 10 2036))
#ASSERT `When does my cat's registration end` `one year` (Date 31 10 2036) EQUALS (`on 31 October` (Date 31 10 2037))
#ASSERT `When does my cat's registration end` `3 years` (Date 14 2 2036) EQUALS (`on 31 October` (Date 31 10 2038))
#ASSERT `When does my cat's registration end` `the life of the cat` (Date 14 2 2036) EQUALS `on the death of the cat, unless cancelled sooner`

#ASSERT `Can I renew today to take effect from 1 November` (Date 11 10 2036)
#ASSERT NOT `Can I renew today to take effect from 1 November` (Date 10 10 2036)

§ `s 23 and reg 19 -- giving my cat away`

#ASSERT `May I give away or sell my cat` FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `not unless it is microchipped first (s 23(1))`
#ASSERT `May I give away or sell my cat` FALSE TRUE FALSE FALSE FALSE FALSE TRUE EQUALS `yes (s 23)`
#ASSERT `May I give away or sell my cat` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `yes: the transfer is to a body named in reg 9 (reg 19)`

§ `s 25 -- telling them of a change`

#ASSERT `By when must I give notice of the change` (Date 14 2 2036) EQUALS (Date 21 2 2036)

§ `s 79(3)(h) and the ULP Regulations -- how many cats`

#ASSERT `How many cats may I keep here` FALSE 0 FALSE 0 EQUALS `no number is set by the Act or the uniform regulations; a local law may set one (s 79(3)(h))`
#ASSERT `How many cats may I keep here` TRUE 2 FALSE 0 EQUALS (`at most this many cats aged 6 months or more` 2)
#ASSERT `How many cats may I keep here` TRUE 2 TRUE 1 EQUALS (`at most this many cats aged 6 months or more` 7)

§ `Penalties`

#ASSERT `What is the most I can be fined` `cat not registered (s 5(1))` EQUALS 5000

#ASSERT `How much is the infringement notice` `keeping more than the standard number of cats (ULP reg 6(1))` EQUALS 200

