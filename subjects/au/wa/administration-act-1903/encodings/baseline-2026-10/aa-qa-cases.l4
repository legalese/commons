#ASSERT `Does the grant vest this asset in me as executor or administrator` `as executor` TRUE TRUE EQUALS no
#ASSERT `Does the grant vest this asset in me as executor or administrator` `as executor` FALSE FALSE EQUALS no

-- s 25: Ruby, 46, entitled, may be granted administration (k098); at 17, no; an adult not entitled while an entitled
