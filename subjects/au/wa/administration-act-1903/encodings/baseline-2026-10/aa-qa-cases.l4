#ASSERT `May I be granted administration of the estate` `as executor` `no will` 30 FALSE TRUE FALSE EQUALS no
#ASSERT `May I be granted administration of the estate` `as executor` `no will` 30 FALSE TRUE TRUE EQUALS yes

