#ASSERT `Is my relationship with my relative recognised` `as family` `no will` FALSE FALSE TRUE TRUE FALSE EQUALS no
#ASSERT `Is my relationship with my relative recognised` `as family` `no will` FALSE FALSE FALSE FALSE FALSE EQUALS no
#ASSERT `Is my relationship with my relative recognised` `as family` `no will` FALSE TRUE FALSE FALSE FALSE EQUALS yes

