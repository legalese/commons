#ASSERT `Can the Court give administration to someone else because I delayed` `as executor` TRUE FALSE FALSE 1 0 EQUALS no
#ASSERT `Can the Court give administration to someone else because I delayed` `as executor` TRUE FALSE TRUE 30 1 EQUALS no
#ASSERT `Can the Court give administration to someone else because I delayed` `as executor` TRUE TRUE FALSE 12 0 EQUALS no

-- s 44: within a month of the period's end, nothing yet; in the second month, notified; after two, an order; filed,
