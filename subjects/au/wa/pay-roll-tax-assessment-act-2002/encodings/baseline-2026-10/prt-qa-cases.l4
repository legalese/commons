#ASSERT `Is my business grouped with the other business` `as the agent` `Jarrah and Daniel's consulting practice` EQUALS yes
#ASSERT `Is my business grouped with the other business` `as the employer` `Jarrah and the practice, excluded by the Commissioner` EQUALS `yes if` (`Am I grouped with the other business` `Jarrah and the practice, excluded by the Commissioner`)
-- s 7(2): a group member during the period is liable for the group's tax; not for a nongroup employer.
#ASSERT `Can I be made to pay payroll tax owed on another group member's wages` `as the employer` `group member` TRUE EQUALS yes
#ASSERT `Can I be made to pay payroll tax owed on another group member's wages` `as the employer` `group member` FALSE EQUALS no
#ASSERT `Can I be made to pay payroll tax owed on another group member's wages` `as the agent` `group member` TRUE EQUALS yes
#ASSERT `Can I be made to pay payroll tax owed on another group member's wages` `as the employer` `group member` TRUE EQUALS `yes if` (`Can I be made to pay the group's payroll tax` TRUE)
#ASSERT `Can I be made to pay payroll tax owed on another group member's wages` `as the employer` `local nongroup` `an unasked fact` EQUALS `does not arise for you`
#ASSERT `Can I be made to pay payroll tax owed on another group member's wages` `as the employer` `interstate nongroup` `an unasked fact` EQUALS `does not arise for you`
#ASSERT `Can I be made to pay payroll tax owed on another group member's wages` `as the agent` `local nongroup` `an unasked fact` EQUALS `does not arise for you`
#ASSERT `Can I be made to pay payroll tax owed on another group member's wages` `as the agent` `interstate nongroup` `an unasked fact` EQUALS `does not arise for you`

