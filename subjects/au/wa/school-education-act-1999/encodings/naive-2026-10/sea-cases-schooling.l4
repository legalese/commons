IMPORT prelude
IMPORT `sea-schooling`

-- School Education Act 1999 (WA), ss 4, 5, 6, 9, 10, 11B, 23, 25, 38-42, 75-79 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_school-education-act-1999.py). Expected results were written by
-- hand from the text.

-- Dates are YYYYMMDD numbers. Children's dates of birth are those in the WA cradle-to-grave lives.

`Chloe` MEANS Child WITH
    `born year` IS 2003
    `born month` IS 3
    `born day` IS 14

`Jake` MEANS Child WITH
    `born year` IS 2006
    `born month` IS 8
    `born day` IS 30

`Daniel` MEANS Child WITH
    `born year` IS 1996
    `born month` IS 4
    `born day` IS 9

`Oliver` MEANS Child WITH
    `born year` IS 2030
    `born month` IS 9
    `born day` IS 5

`Luca` MEANS Child WITH
    `born year` IS 2030
    `born month` IS 2
    `born day` IS 2

`enrolled at the local school` MEANS Enrolment WITH
    `enrolled at a school` IS TRUE
    `a parent is registered as home educator` IS FALSE
    `exempt by the Minister and complying with the conditions` IS FALSE
    `a section 11D notice is in force` IS FALSE
    `a section 11H notice of full-time employment is in force` IS FALSE

`registered for home education` MEANS Enrolment WITH
    `enrolled at a school` IS FALSE
    `a parent is registered as home educator` IS TRUE
    `exempt by the Minister and complying with the conditions` IS FALSE
    `a section 11D notice is in force` IS FALSE
    `a section 11H notice of full-time employment is in force` IS FALSE

`not enrolled anywhere` MEANS Enrolment WITH
    `enrolled at a school` IS FALSE
    `a parent is registered as home educator` IS FALSE
    `exempt by the Minister and complying with the conditions` IS FALSE
    `a section 11D notice is in force` IS FALSE
    `a section 11H notice of full-time employment is in force` IS FALSE

`an unexplained absence` MEANS Absence WITH
    `prevented by temporary incapacity or other reasonable cause` IS FALSE
    `the cause was notified within 3 school days` IS FALSE
    `incapacity was the cause given` IS FALSE
    `the principal asked for a medical certificate` IS FALSE
    `a medical certificate was provided` IS FALSE
    `a home-education application was notified in writing within 3 school days` IS FALSE

`sick, notified in time, no certificate asked` MEANS Absence WITH
    `prevented by temporary incapacity or other reasonable cause` IS TRUE
    `the cause was notified within 3 school days` IS TRUE
    `incapacity was the cause given` IS TRUE
    `the principal asked for a medical certificate` IS FALSE
    `a medical certificate was provided` IS FALSE
    `a home-education application was notified in writing within 3 school days` IS FALSE

`sick, notified in time, certificate asked and not given` MEANS Absence WITH
    `prevented by temporary incapacity or other reasonable cause` IS TRUE
    `the cause was notified within 3 school days` IS TRUE
    `incapacity was the cause given` IS TRUE
    `the principal asked for a medical certificate` IS TRUE
    `a medical certificate was provided` IS FALSE
    `a home-education application was notified in writing within 3 school days` IS FALSE

`a home-education application notified in writing in time` MEANS Absence WITH
    `prevented by temporary incapacity or other reasonable cause` IS FALSE
    `the cause was notified within 3 school days` IS FALSE
    `incapacity was the cause given` IS FALSE
    `the principal asked for a medical certificate` IS FALSE
    `a medical certificate was provided` IS FALSE
    `a home-education application was notified in writing within 3 school days` IS TRUE

`Oliver living in the intake area` MEANS Applicant WITH
    `usually resides in the State` IS TRUE
    `entitled to reside permanently in Australia` IS TRUE
    `meets the regulations' criteria for other children` IS FALSE
    `of compulsory school age` IS TRUE
    `usually resides in the intake area` IS TRUE
    `an appropriate programme is available` IS TRUE
    `classroom accommodation is available` IS FALSE
    `other prescribed criteria are met` IS FALSE

`a child from outside the intake area with no classroom free` MEANS Applicant WITH
    `usually resides in the State` IS TRUE
    `entitled to reside permanently in Australia` IS TRUE
    `meets the regulations' criteria for other children` IS FALSE
    `of compulsory school age` IS TRUE
    `usually resides in the intake area` IS FALSE
    `an appropriate programme is available` IS TRUE
    `classroom accommodation is available` IS FALSE
    `other prescribed criteria are met` IS TRUE

`a child from outside the intake area with room and criteria met` MEANS Applicant WITH
    `usually resides in the State` IS TRUE
    `entitled to reside permanently in Australia` IS TRUE
    `meets the regulations' criteria for other children` IS FALSE
    `of compulsory school age` IS TRUE
    `usually resides in the intake area` IS FALSE
    `an appropriate programme is available` IS TRUE
    `classroom accommodation is available` IS TRUE
    `other prescribed criteria are met` IS TRUE

`a child in the intake area not entitled to reside permanently` MEANS Applicant WITH
    `usually resides in the State` IS TRUE
    `entitled to reside permanently in Australia` IS FALSE
    `meets the regulations' criteria for other children` IS FALSE
    `of compulsory school age` IS TRUE
    `usually resides in the intake area` IS TRUE
    `an appropriate programme is available` IS TRUE
    `classroom accommodation is available` IS FALSE
    `other prescribed criteria are met` IS FALSE

