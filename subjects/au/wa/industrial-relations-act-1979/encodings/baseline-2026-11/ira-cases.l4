#ASSERT (NOT (`Am I an employee under the Act` FALSE TRUE FALSE))
#ASSERT (NOT (`Am I an employee under the Act` TRUE FALSE FALSE))
#ASSERT `Am I an employee under the Act` FALSE FALSE TRUE

#ASSERT `Must the other party prove I was not their employee` TRUE TRUE EQUALS JUST TRUE
