#ASSERT `Must the other party prove I was not their employee` FALSE TRUE EQUALS NOTHING

§§ `unfair dismissal: can the Commission determine it (s 29(1)(c), s 29AA)`

-- A sole trader's employee, no FWC application, award applies, salary well above the test prescribed amount: yes.
#ASSERT `Can the Commission determine my unfair dismissal claim` FALSE FALSE TRUE FALSE FALSE TRUE 300000 185000 EQUALS JUST TRUE
-- A Pty Ltd employer, not declared: the FW Act decides.
#ASSERT `Can the Commission determine my unfair dismissal claim` TRUE FALSE TRUE FALSE FALSE TRUE 60000 185000 EQUALS NOTHING
-- A declared public sector employer: yes.
#ASSERT `Can the Commission determine my unfair dismissal claim` TRUE TRUE TRUE FALSE FALSE TRUE 60000 185000 EQUALS JUST TRUE
-- Not the employer's employee.
#ASSERT `Can the Commission determine my unfair dismissal claim` FALSE FALSE FALSE FALSE FALSE TRUE 60000 185000 EQUALS NOTHING
-- FWC application pending: no; withdrawn or rejected for jurisdiction: yes.
#ASSERT `Can the Commission determine my unfair dismissal claim` FALSE FALSE TRUE TRUE FALSE TRUE 60000 185000 EQUALS JUST FALSE
#ASSERT `Can the Commission determine my unfair dismissal claim` FALSE FALSE TRUE TRUE TRUE TRUE 60000 185000 EQUALS JUST TRUE
-- Salary bar, no instrument: $185 001 exceeds $185 000: no; $185 000 does not exceed: yes.
#ASSERT `Can the Commission determine my unfair dismissal claim` FALSE FALSE TRUE FALSE FALSE FALSE 185001 185000 EQUALS JUST FALSE
#ASSERT `Can the Commission determine my unfair dismissal claim` FALSE FALSE TRUE FALSE FALSE FALSE 185000 185000 EQUALS JUST TRUE
-- The Act's base figure: $90 001 exceeds $90 000.
#ASSERT `Can the Commission determine my unfair dismissal claim` FALSE FALSE TRUE FALSE FALSE FALSE 90001 90000 EQUALS JUST FALSE

§§ `unfair dismissal: the 28 days (s 29(2)(a), (3))`

-- Dismissed Monday 2 March 2026: day 28 is Monday 30 March.
#ASSERT `By when must I refer my unfair dismissal claim` (`d` 2 3 2026) EQUALS `d` 30 3 2026
-- Dismissed Saturday 14 March 2026: day 28 is Saturday 11 April, so Monday 13 April.
#ASSERT `By when must I refer my unfair dismissal claim` (`d` 14 3 2026) EQUALS `d` 13 4 2026
-- Dismissed Sunday 15 March 2026: day 28 is Sunday 12 April, so Monday 13 April.
#ASSERT `By when must I refer my unfair dismissal claim` (`d` 15 3 2026) EQUALS `d` 13 4 2026
-- Dismissed Tuesday 3 March 2026: Tuesday 31 March.
#ASSERT `By when must I refer my unfair dismissal claim` (`d` 3 3 2026) EQUALS `d` 31 3 2026

