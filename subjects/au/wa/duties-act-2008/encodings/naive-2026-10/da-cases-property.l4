    `includes a home` IS FALSE
    `where` IS `in the metropolitan or Peel region`
    `each transferee is a concessional first home owner` IS TRUE

`k074 variant: Jake not a concessional first home owner` MEANS `Home purchase` WITH
    `price` IS 390000
    `includes a home` IS TRUE
    `where` IS `in the metropolitan or Peel region`
    `each transferee is a concessional first home owner` IS FALSE

