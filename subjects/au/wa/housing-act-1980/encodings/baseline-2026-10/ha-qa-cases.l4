#ASSERT `Would this loan keep me within the Minister's limit, as I ask it` `as buyer` `a Part IV loan` 10000 382200 400000 EQUALS `yes if` (`Would this loan keep me within the Minister's limit` 10000 382200 400000)
#ASSERT `What security must I give for a Part IV loan, as I ask it` `as buyer` `a Part IV loan` EQUALS `the answer is` `What security must I give for a Part IV loan`
#ASSERT `What interest rate will I pay, as I ask it` `as buyer` `a Part IV loan` 7 EQUALS `percent a year` (`What interest rate will I pay` 7)
#ASSERT `Can the Housing Authority guarantee my borrowing, as I ask it` `as buyer` `another lender's loan` `Jake, 35, single, within the Authority's income conditions, buying his home` TRUE TRUE TRUE 350000 350000 EQUALS `yes if` (`Can the Housing Authority guarantee my borrowing` `Jake, 35, single, within the Authority's income conditions, buying his home` TRUE TRUE TRUE 350000 350000)
#ASSERT `Can the Housing Authority subsidise the interest on my loan, as I ask it` `as buyer` `another lender's loan` `Jake, over the Authority's income conditions, buying his home` TRUE TRUE TRUE TRUE EQUALS `yes if` (`Can the Housing Authority subsidise the interest on my loan` `Jake, over the Authority's income conditions, buying his home` TRUE TRUE TRUE TRUE)
#ASSERT `What does the Housing Act decide about my loan, as I ask it` `as buyer` `a lending institution under a State loan agreement` EQUALS `the answer is` (`What does the Housing Act decide about my loan from` `a lending institution under a State loan agreement`)
#ASSERT `Can my rent be credited towards the price I pay the Authority` `as buyer` `a Division 4 purchase` TRUE EQUALS `yes if` (`Can my rent be credited towards the price` TRUE TRUE)
#ASSERT `On what terms can the Housing Authority sell me this, as I ask it` `as buyer` `a Division 4 purchase` `Jake, 35, single, within the Authority's income conditions, buying his home` `something not held by the Authority` EQUALS `the answer is` (`On what terms can the Housing Authority sell me this` `Jake, 35, single, within the Authority's income conditions, buying his home` `something not held by the Authority`)
#ASSERT `Would the unpaid price stay within the Minister's limit, as I ask it` `as buyer` `a Division 4 purchase` 400000 400000 EQUALS `yes if` (`Would the unpaid price stay within the Minister's limit` 400000 400000)
#ASSERT `Can I be given more time to pay on my loan or purchase` `as buyer` `a Part IV loan` FALSE TRUE EQUALS `yes if` (`Can I be given more time to pay the Authority` FALSE TRUE)
#ASSERT `Can the Authority pay my duty and add it to what I owe, as I ask it` `as buyer` `a Division 4 purchase` EQUALS `yes if` (`Can the Authority pay my duty and add it to what I owe` TRUE)
#ASSERT `Can the Housing Authority rent me a house, as I ask it` `as tenant` `Jake, over the Authority's income conditions, buying his home` TRUE TRUE EQUALS `yes if` (`Can the Housing Authority rent me a house` `Jake, over the Authority's income conditions, buying his home` TRUE TRUE)
#ASSERT `How much rent must I pay, as I ask it` `as tenant` TRUE 400 150 EQUALS amount (`How much rent must I pay` 400 150)
#ASSERT `Can my rent be credited towards buying the house I rent` `as tenant` TRUE TRUE EQUALS `yes if` (`Can my rent be credited towards the price` TRUE TRUE)
#ASSERT `Can the Housing Authority house me in specialised housing, as I ask it` `as tenant` TRUE EQUALS `yes if` (`Can the Housing Authority house me in specialised housing` TRUE)
#ASSERT `Can I be given more time to pay my rent` `as tenant` TRUE TRUE TRUE EQUALS `yes if` (`Can I be given more time to pay the Authority` TRUE TRUE)

