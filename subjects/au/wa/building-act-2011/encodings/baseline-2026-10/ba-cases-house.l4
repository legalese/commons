    `kind` IS `building a new house or other building`
    `the regulations or a Ministerial order say it needs no building permit` IS FALSE
    `is to remain erected for no longer than one month` IS TRUE
    `members of the public will use it or be permitted access` IS FALSE
    `is done in accordance with a building order` IS FALSE
    `a building permit is in effect for it` IS FALSE

`a display home up for three weeks, open to the public` MEANS Work WITH
    `kind` IS `building a new house or other building`
    `the regulations or a Ministerial order say it needs no building permit` IS FALSE
    `is to remain erected for no longer than one month` IS TRUE
    `members of the public will use it or be permitted access` IS TRUE
    `is done in accordance with a building order` IS FALSE
    `a building permit is in effect for it` IS FALSE

`rectification work under a building order` MEANS Work WITH
    `kind` IS `renovating, altering, extending or repairing the house`
    `the regulations or a Ministerial order say it needs no building permit` IS FALSE
    `is to remain erected for no longer than one month` IS FALSE
    `members of the public will use it or be permitted access` IS FALSE
    `is done in accordance with a building order` IS TRUE
    `a building permit is in effect for it` IS FALSE

`demolishing the old house` MEANS Work WITH
    `kind` IS `demolishing the house`
    `the regulations or a Ministerial order say it needs no building permit` IS FALSE
    `is to remain erected for no longer than one month` IS FALSE
    `members of the public will use it or be permitted access` IS FALSE
    `is done in accordance with a building order` IS FALSE
    `a building permit is in effect for it` IS FALSE

`an independent private building surveyor` MEANS Surveyor WITH
    `is an owner of the land` IS FALSE
    `is an employee of an owner of the land` IS FALSE
    `is the proposed builder` IS FALSE
    `is an employee of the proposed builder` IS FALSE
    `is entitled under the Registration Act to sign certificates for this kind of building` IS TRUE

`a building surveyor employed by the builder` MEANS Surveyor WITH
    `is an owner of the land` IS FALSE
    `is an employee of an owner of the land` IS FALSE
    `is the proposed builder` IS FALSE
    `is an employee of the proposed builder` IS TRUE
    `is entitled under the Registration Act to sign certificates for this kind of building` IS TRUE

