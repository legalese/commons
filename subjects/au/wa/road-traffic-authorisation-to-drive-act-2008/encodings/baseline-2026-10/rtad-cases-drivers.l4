§ `Code r 17, r 65 -- k083: Jake, 25 km/h over on a motorcycle`

#ASSERT `How many demerit points does my speeding carry` 25 FALSE FALSE EQUALS 3
#ASSERT `How many demerit points does my speeding carry` 25 TRUE FALSE EQUALS 6
#ASSERT `How many demerit points does my speeding carry` 9 FALSE FALSE EQUALS 0

#ASSERT `What is the modified penalty for my speeding` 25 FALSE EQUALS 8

#ASSERT `How many demerit points does this offence carry` `a first offence of driving without authorisation by a type 1A novice, between midnight and 5 a.m. or over the passenger limit (s 49(1))` FALSE EQUALS 2

