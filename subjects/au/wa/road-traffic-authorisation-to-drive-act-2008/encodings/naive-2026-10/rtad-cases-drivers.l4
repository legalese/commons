IMPORT prelude
IMPORT `rtad-drivers`

-- Road Traffic (Authorisation to Drive) Act 2008 (WA), ss 2, 8, 10, 16, 40, 43-52, 66 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_road-traffic-authorisation-to-drive-act-2008.py). Expected results were written by
-- hand from the text.

-- Scenario facts used (workbench scenarios/au/wa/cradle-to-grave-*/facts.json): Chloe born 2003-03-14, a learner's permit on
-- 2019-03-14 (c021, 16) and a provisional licence on 2020-03-14 (c022, 17). Jake born 2006-08-30, a provisional licence on
-- 2023-08-30 (k032, 17) and a speeding infringement on a motorcycle on 2049-07-19 (k083, 42). Daniel born 1996-04-09, a learner's
-- permit on 2012-10-15 (d012, 16). The minimum age of 16 for a permit is the scenario's own premise (c021: "Turns 16: a learner's
-- permit"); the Act leaves the figure to the regulations, which were not retrieved. How many points 25 km/h over carries is
-- likewise a regulation figure and is not used. That Jake has held his licence since 2023 (310 months by 2049-07-19, if never
-- excluded from driving) is an inference from k032.

§ `helpers`

#ASSERT `age in completed years` 2003 3 14 2019 3 14 EQUALS 16
#ASSERT `age in completed years` 1996 4 9 2012 10 15 EQUALS 16
#ASSERT `age in completed years` 2006 8 30 2049 7 19 EQUALS 42

§ `s 2, s 66 -- commencement`

#ASSERT `the licensing and demerit provisions are in operation on` 2019 3 14
#ASSERT NOT `the licensing and demerit provisions are in operation on` 2012 10 15
#ASSERT `the licensing and demerit provisions are in operation on` 2015 4 27

#ASSERT `the old permit is taken to be a section 10 learner's permit` TRUE TRUE

§ `ss 10, 11A -- the learner's permit`

#ASSERT `the CEO is not barred from issuing a learner's permit` 16 16 FALSE TRUE TRUE
#ASSERT NOT `the CEO is not barred from issuing a learner's permit` 15 16 FALSE TRUE TRUE
#ASSERT `the CEO is not barred from issuing a learner's permit` 15 16 TRUE TRUE TRUE

#ASSERT `the learner's permit is in force` 2019 3 14 2022 3 14 FALSE
#ASSERT NOT `the learner's permit is in force` 2019 3 14 2022 3 15 FALSE

#ASSERT `the learner's permit authorises the driving` TRUE TRUE `a licensed driving instructor`
#ASSERT NOT `the learner's permit authorises the driving` TRUE TRUE `nobody`

§ `ss 8, 9 -- granting a driver's licence`

#ASSERT `the CEO is not barred from granting a driver's licence` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE
#ASSERT NOT `the CEO is not barred from granting a driver's licence` FALSE TRUE TRUE TRUE FALSE FALSE TRUE FALSE TRUE FALSE
#ASSERT `the CEO is not barred from granting a driver's licence` TRUE FALSE TRUE FALSE FALSE FALSE TRUE TRUE TRUE FALSE
#ASSERT `the CEO is not barred from granting a driver's licence` FALSE TRUE TRUE TRUE FALSE FALSE TRUE FALSE TRUE TRUE

§ `ss 16, 17 -- losing a provisional licence`

#ASSERT `the provisional licence is cancelled by operation of law` `convicted of an offence listed in section 16(1)`
#ASSERT `the provisional licence is cancelled by operation of law` `disqualified under Part 4`
#ASSERT NOT `the provisional licence is cancelled by operation of law` `disqualified by a fines enforcement licence suspension order`

#ASSERT `months of disqualification after a section 16 cancellation` 0 EQUALS 3
#ASSERT `months of disqualification after a section 16 cancellation` 6 EQUALS 6

§ `s 40 -- novice drivers`

#ASSERT `novice status` 0 EQUALS `novice driver (type 1)`
#ASSERT `novice status` 18 EQUALS `novice driver (type 2)`
#ASSERT `novice status` 310 EQUALS `not a novice driver`

§ `s 43 -- registry jurisdiction`

#ASSERT `WA is the demerit point registry jurisdiction` TRUE FALSE TRUE TRUE
#ASSERT NOT `WA is the demerit point registry jurisdiction` FALSE TRUE TRUE FALSE
#ASSERT `WA is the demerit point registry jurisdiction` TRUE TRUE TRUE FALSE
#ASSERT `WA is the demerit point registry jurisdiction` FALSE FALSE FALSE FALSE

§ `ss 40(1A), 44-46 -- incurring points`

#ASSERT `the offence is dealt with by infringement notice` TRUE TRUE FALSE
#ASSERT `the offence is dealt with by infringement notice` TRUE FALSE TRUE

#ASSERT `demerit point action is to be taken` TRUE TRUE TRUE TRUE `dealt with by infringement notice`
#ASSERT NOT `demerit point action is to be taken` TRUE TRUE TRUE TRUE `not yet dealt with`
#ASSERT NOT `demerit point action is to be taken` FALSE TRUE TRUE TRUE `dealt with by infringement notice`
#ASSERT `demerit point action is to be taken` TRUE TRUE TRUE FALSE `dealt with by infringement notice`
#ASSERT NOT `demerit point action is to be taken` TRUE TRUE TRUE TRUE `convicted and disqualified because of the conviction`

§ `s 48 -- expiry`

#ASSERT `the points are current` 2049 7 19 2052 7 19 FALSE
#ASSERT NOT `the points are current` 2049 7 19 2052 7 20 FALSE

§ `s 49 -- 12 or more points`

#ASSERT `months of disqualification in an excessive demerit points notice` 11 EQUALS 0
#ASSERT `months of disqualification in an excessive demerit points notice` 12 EQUALS 3
#ASSERT `months of disqualification in an excessive demerit points notice` 16 EQUALS 4
#ASSERT `months of disqualification in an excessive demerit points notice` 20 EQUALS 5

§ `s 50 -- novice drivers`

#ASSERT `an excessive demerit points (novice driver) notice is due` 4 `novice driver (type 1)`
#ASSERT NOT `an excessive demerit points (novice driver) notice is due` 3 `novice driver (type 1)`
#ASSERT NOT `an excessive demerit points (novice driver) notice is due` 4 `novice driver (type 2)`
#ASSERT `an excessive demerit points (novice driver) notice is due` 8 `novice driver (type 2)`

§ `ss 51, 52 -- the election`

#ASSERT `a section 51 election may be made` TRUE FALSE `not a novice driver` 21
#ASSERT NOT `a section 51 election may be made` TRUE TRUE `not a novice driver` 10
#ASSERT NOT `a section 51 election may be made` TRUE FALSE `novice driver (type 2)` 5

#ASSERT `the election is broken` 2 FALSE

#ASSERT `months of disqualification after a broken election` 3 EQUALS 6

