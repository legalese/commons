§ `s 4 -- liability`

-- c025: at 18 and enrolled, Chloe becomes liable to serve.
#ASSERT `Am I liable to serve as a juror` `Chloe turning 18 (c025)`
#ASSERT NOT `Am I liable to serve as a juror` `a 16-year-old enrolled provisionally`
#ASSERT NOT `Am I liable to serve as a juror` `an adult who never enrolled`
#ASSERT NOT `Am I liable to serve as a juror` `an overseas elector kept on the roll`

§ `s 5 and Schedule 1 -- eligibility and qualification`

#ASSERT `Am I eligible to serve` `Chloe turning 18 (c025)` `a criminal trial`
#ASSERT NOT `Am I eligible to serve` `a retiree aged 75` `a civil trial`
#ASSERT NOT `Am I eligible to serve` `a legal practitioner` `a civil trial`
#ASSERT `Am I eligible to serve` `a police officer` `a civil trial`
#ASSERT NOT `Am I eligible to serve` `a police officer` `a criminal trial`

#ASSERT `Does my criminal record disqualify me` `someone given 3 years in 2010`
#ASSERT NOT `Does my criminal record disqualify me` `someone given 18 months in 2010`
#ASSERT `Does my criminal record disqualify me` `someone with two recent WA imprisonable convictions`
#ASSERT NOT `Does my criminal record disqualify me` `someone with one recent WA and one NSW imprisonable conviction`
#ASSERT `Does my criminal record disqualify me` `someone with three recent WA road law convictions`
#ASSERT `Does my criminal record disqualify me` `someone on a community order in the last 5 years`

#ASSERT NOT `Am I qualified to serve` `someone on bail awaiting trial`

-- c025: Chloe at 18 stands liable to serve, unless excused.
#ASSERT `What is my standing for this trial` `Chloe turning 18 (c025)` `a criminal trial` EQUALS `liable to serve unless excused`
#ASSERT `What is my standing for this trial` `a 16-year-old enrolled provisionally` `a criminal trial` EQUALS `not liable -- not enrolled as s 4 requires`
#ASSERT `What is my standing for this trial` `a police officer` `a criminal trial` EQUALS `not eligible -- s 5(3)(a), (ba) or (bb)`
#ASSERT `What is my standing for this trial` `someone given 3 years in 2010` `a criminal trial` EQUALS `not qualified -- s 5(3)(b), (c) or (d)`

§ `s 33A and Schedule 2 -- disclosure`

#ASSERT `Which Schedule 2 items must I disclose` `Chloe summonsed at 33 (c077)` `a criminal trial` `nothing else` EQUALS EMPTY
#ASSERT `Which Schedule 2 items must I disclose` `a police officer` `a criminal trial` `nothing else` EQUALS LIST 3
#ASSERT `Which Schedule 2 items must I disclose` `a retiree aged 75` `a criminal trial` `a disability and a link to a party` EQUALS LIST 1, 8, 10

§ `ss 34E-34J -- excusal`

#ASSERT `Must I be excused` `a retiree aged 75` `a civil trial` `nothing else` TRUE
#ASSERT NOT `Must I be excused` `a retiree aged 75` `a civil trial` `nothing else` FALSE
#ASSERT `Must I be excused` `Chloe summonsed at 33 (c077)` `a criminal trial` `living outside the jury district` TRUE

-- c077: Jarrah cannot excuse Chloe; only a judge or the summoning officer can.
#ASSERT NOT `Can my employer excuse me` 

#ASSERT `Can I get a permanent excusal certificate` TRUE

-- c077: Chloe's work commitments are a good reason only if attending would cause undue hardship or serious inconvenience.
#ASSERT `Do I have a good reason` `my business or occupation` TRUE
#ASSERT NOT `Do I have a good reason` `my business or occupation` FALSE

-- c077: on a first summons, the most Chloe can get for a good reason is a deferral.
#ASSERT `What can I get for a good reason` TRUE TRUE FALSE FALSE FALSE EQUALS `a deferral of jury duty, at the discretion of the officer`
#ASSERT `What can I get for a good reason` FALSE TRUE FALSE FALSE FALSE EQUALS `nothing -- s 34H needs my own application`
#ASSERT `What can I get for a good reason` TRUE TRUE TRUE TRUE FALSE EQUALS `an excusal, at the discretion of the officer`
#ASSERT `What can I get for a good reason` TRUE TRUE TRUE FALSE FALSE EQUALS `no excusal -- I was deferred before and the reason is neither unforeseeable nor exceptional`

#ASSERT NOT `Must I be excused for not being indifferent` `the summoning officer` FALSE TRUE
#ASSERT `Must I be excused for not being indifferent` `a judge` FALSE TRUE

#ASSERT NOT `Can I be excused for recent service` TRUE TRUE FALSE

§ `ss 31, 32D, 32E, 32I, 42 -- service and attendance`

#ASSERT `Was my summons served in time` `a summons to a panel` 6 FALSE
#ASSERT NOT `Was my summons served in time` `a summons to a panel` 5 FALSE
#ASSERT `Was my summons served in time` `a summons to a jury pool` 4 TRUE

-- c077: Chloe's pool summons, HYPOTHETICALLY served 21 days ahead, must be obeyed.
#ASSERT `Must I attend` `Chloe summonsed at 33 (c077)` `a criminal trial` `a summons to a jury pool` 21 FALSE FALSE FALSE EQUALS `yes -- I must attend`
#ASSERT `Must I attend` `a retiree aged 75` `a criminal trial` `a summons to a jury pool` 21 FALSE FALSE FALSE EQUALS `yes -- I must attend, and claim under s 34G that I cannot serve`
#ASSERT `Must I attend` `Chloe summonsed at 33 (c077)` `a criminal trial` `a summons to a jury pool` 21 FALSE TRUE FALSE EQUALS `no -- I have been excused or deferred`
#ASSERT `Must I attend` `Chloe summonsed at 33 (c077)` `a criminal trial` `a summons to a panel` 4 FALSE FALSE FALSE EQUALS `no -- my summons was not served as the Act requires`

#ASSERT `Can I be required to attend today` `a summons to a jury pool` 5 5 FALSE
#ASSERT NOT `Can I be required to attend today` `a summons to a jury pool` 4 3 FALSE
#ASSERT `Can I be required to attend today` `a summons to a jury pool` 6 5 TRUE

#ASSERT `Is not obeying my summons an offence` TRUE TRUE FALSE FALSE
#ASSERT NOT `Is not obeying my summons an offence` TRUE TRUE TRUE FALSE

#ASSERT `What is the most I can be fined for not obeying`  EQUALS 5000

§ `s 56 -- the employer`

#ASSERT NOT `Am I doing jury service` FALSE TRUE

#ASSERT `Is it prejudicial action` `threatens to end my employment or cut or stop my pay or otherwise prejudice me`
#ASSERT NOT `Is it prejudicial action` `tells me I cannot go but threatens nothing and does nothing`

-- c077: if Jarrah threatens Chloe's job over the summons, or stops her pay while she serves, it commits the offence.
#ASSERT `Does my employer commit an offence` `threatens to end my employment or cut or stop my pay or otherwise prejudice me` TRUE FALSE FALSE
#ASSERT NOT `Does my employer commit an offence` `threatens to end my employment or cut or stop my pay or otherwise prejudice me` TRUE FALSE TRUE
#ASSERT `Does my employer commit an offence` `does not pay me the earnings I could reasonably expect while on jury service` TRUE TRUE TRUE
#ASSERT NOT `Does my employer commit an offence` `does not pay me the earnings I could reasonably expect while on jury service` TRUE FALSE FALSE

-- c077: HYPOTHETICAL 15 days at $400 a day: 15 x 400. No 10-day cap, unlike Fair Work Act s 111(5) (10 x 400 - 300 = 3700).
#ASSERT `What earnings must my employer keep paying me` 15 400 EQUALS 6000

-- c077: Jarrah is a body corporate.
#ASSERT `What is the most my employer can be fined` TRUE EQUALS 50000

-- c077: Chloe's $110,000 salary caps any compensation order.
#ASSERT `What is the most compensation I can be awarded` 110000 EQUALS 110000

#ASSERT NOT `Can the court order my re-employment` TRUE `cuts my pay`

§ `s 58B -- payments`

-- c077: if Jarrah keeps paying Chloe, the State's fees go to Jarrah; if not, to Chloe.
#ASSERT `Who gets the jury service fees` TRUE TRUE FALSE FALSE EQUALS `my employer`
#ASSERT `Who gets the jury service fees` TRUE FALSE FALSE FALSE EQUALS `me`
#ASSERT `Who gets the jury service fees` FALSE FALSE FALSE FALSE EQUALS `me`

-- c077: HYPOTHETICAL allowances $50, fees $300.
#ASSERT `How much does the State pay me` TRUE 50 300 `my employer` EQUALS 50
#ASSERT `How much does the State pay me` TRUE 50 300 `me` EQUALS 350

