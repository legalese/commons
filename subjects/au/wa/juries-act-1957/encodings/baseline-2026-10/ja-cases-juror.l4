#ASSERT `Is telling it an offence` `what was said or how votes went in the jury room` `anyone else` TRUE TRUE FALSE FALSE
#ASSERT NOT `Is telling it an offence` `that I was a juror in the trial` `anyone else` TRUE TRUE FALSE FALSE
