IMPORT prelude
IMPORT `dfa-fences`

-- Dividing Fences Act 1961 (WA), ss 5, 6, 7, 8, 9, 10, 13, 14, 15, 19, 21, 22 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_wa_dividing-fences-act-1961_baseline.py). Expected results were written by
-- hand from the text.

-- Facts from the WA lives (workbench scenarios au/wa/cradle-to-grave-chloe): c07b (August 2039), a dividing fence
-- with the new neighbour. Chloe and Liam own their Byford house (built on the first home owner grant, chapter 5), so
-- they hold the freehold in possession. The scenario's answer is "half each". It gives no cost and does not say whether
-- a fence already stands: the lands are taken as unfenced, and $4,000 is the encoder's figure, chosen for arithmetic.
-- The other cases are the encoder's illustrations, not scenario events.

§ `s 5 -- owner`

-- c07b: Chloe holds the freehold of the Byford lot in possession.
#ASSERT `Am I an owner under the Act` `I hold the freehold in possession` 0 FALSE
#ASSERT `Am I an owner under the Act` `I hold a lease` 5 FALSE
#ASSERT NOT `Am I an owner under the Act` `I hold a lease` 4 FALSE
#ASSERT NOT `Am I an owner under the Act` `I hold the freehold in possession` 0 TRUE

§ `s 5 -- sufficient fence`

#ASSERT `Is the fence a sufficient fence` TRUE TRUE FALSE FALSE FALSE FALSE FALSE
#ASSERT `Is the fence a sufficient fence` FALSE FALSE TRUE TRUE FALSE FALSE FALSE
#ASSERT NOT `Is the fence a sufficient fence` TRUE FALSE TRUE TRUE TRUE TRUE FALSE
#ASSERT `Is the fence a sufficient fence` FALSE FALSE FALSE FALSE FALSE TRUE FALSE
#ASSERT NOT `Is the fence a sufficient fence` TRUE FALSE FALSE FALSE FALSE TRUE FALSE

§ `ss 4, 6, 7 -- my share of a new fence`

-- c07b: Chloe and the new neighbour both own; the lots adjoin, are unfenced, and there is no agreement: half each.
#ASSERT `What share of a new dividing fence must I bear` TRUE TRUE TRUE FALSE FALSE EQUALS `half: we join in or contribute in equal proportions (s 7)`
#ASSERT `What share of a new dividing fence must I bear` TRUE TRUE TRUE TRUE FALSE EQUALS `nothing under s 7: our lands are already divided by a sufficient fence`
#ASSERT `What share of a new dividing fence must I bear` TRUE TRUE TRUE FALSE TRUE EQUALS `as our agreement says: the Act does not affect it (s 6(1))`
#ASSERT `What share of a new dividing fence must I bear` TRUE FALSE TRUE FALSE FALSE EQUALS `nothing under s 7: my neighbour is not an owner bound by the Act`

-- c07b: on a $4,000 fence (the encoder's figure) Chloe's half is $2,000.
#ASSERT `How much must I contribute to the new fence` 4000 TRUE TRUE TRUE FALSE EQUALS 2000
#ASSERT `How much must I contribute to the new fence` 4000 TRUE TRUE TRUE TRUE EQUALS 0

§ `ss 8, 22 -- notice to fence`

#ASSERT `Is my notice to fence valid` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT `Is my notice to fence valid` TRUE TRUE TRUE TRUE FALSE

§ `s 9 -- the Magistrates Court`

#ASSERT `May I apply to the Magistrates Court about the new fence` TRUE 22 FALSE
#ASSERT NOT `May I apply to the Magistrates Court about the new fence` TRUE 14 FALSE

§ `s 10 -- default`

#ASSERT `May I build the whole fence and recover half` TRUE FALSE 0 4
#ASSERT NOT `May I build the whole fence and recover half` TRUE FALSE 0 2
#ASSERT NOT `May I build the whole fence and recover half` TRUE FALSE 6 4

§ `s 13 -- a fence built without notice`

#ASSERT `Can I claim half the value of the fence I built` TRUE FALSE TRUE FALSE EQUALS `yes: I may give a notice claiming half the value as at the date of the claim (s 13(2))`
#ASSERT `Can I claim half the value of the fence I built` TRUE FALSE FALSE FALSE EQUALS `not yet: my neighbour has not built on, occupied or let a building on their land (s 13(2))`
#ASSERT `Can I claim half the value of the fence I built` TRUE TRUE TRUE FALSE EQUALS `not by s 13: I gave a notice to fence, so ss 9 and 10 apply`

#ASSERT `Must I pay my neighbour's claim for half` FALSE FALSE TRUE EQUALS `I must pay the amount claimed: I neither paid nor disputed it within one month (s 13(7))`
#ASSERT `Must I pay my neighbour's claim for half` FALSE TRUE TRUE EQUALS `the claim goes to the Magistrates Court if we cannot agree (s 13(4))`

§ `ss 14, 15 -- repairs`

#ASSERT `What can I recover for repairing the fence` `flood, fire, lightning, storm, tempest or accident, through nobody's neglect` FALSE FALSE 0 `no written reply` FALSE EQUALS `half: I may repair at once without notice and recover half (s 15(7)(b))`
#ASSERT `What can I recover for repairing the fence` `a fire or a falling tree through my neighbour's neglect` FALSE FALSE 0 `no written reply` TRUE EQUALS `the whole: I may repair and recover the whole cost from my neighbour (s 15(8))`
#ASSERT `What can I recover for repairing the fence` `a fire or a falling tree through my neighbour's neglect` FALSE FALSE 0 `no written reply` FALSE EQUALS `nothing yet: my neighbour is bound to repair it as soon as practicable (s 15(7)(c))`
#ASSERT `What can I recover for repairing the fence` `a fire or a falling tree through my neglect` FALSE FALSE 0 `no written reply` FALSE EQUALS `nothing: I am bound to repair it myself as soon as practicable (s 15(7)(c))`
#ASSERT `What can I recover for repairing the fence` `wear, age or ordinary deterioration` FALSE FALSE 0 `no written reply` FALSE EQUALS `nothing yet: I must give a repair notice and wait 14 days for a written reply (s 15(1), (3))`
#ASSERT `What can I recover for repairing the fence` `wear, age or ordinary deterioration` FALSE TRUE 15 `no written reply` FALSE EQUALS `half: my neighbour did not reply within 14 days, so I may repair and recover half (s 15(7))`
#ASSERT `What can I recover for repairing the fence` `wear, age or ordinary deterioration` TRUE TRUE 15 `no written reply` FALSE EQUALS `each of us bears the cost of repairing the part we built (s 15(7)(a))`
#ASSERT `What can I recover for repairing the fence` `wear, age or ordinary deterioration` FALSE TRUE 10 `disputes the need or objects to the repairs, in writing` FALSE EQUALS `the Magistrates Court decides: I may apply under s 15(4)`

#ASSERT `How much of the repair cost can I recover` `half: I may repair at once without notice and recover half (s 15(7)(b))` 1800 EQUALS 900

§ `s 19 -- landlord and tenant`

#ASSERT `What fraction of the fence cost do I bear as tenant` 5 EQUALS 0.25
#ASSERT `What fraction of the fence cost do I bear as tenant` 10 EQUALS 0.5
#ASSERT `What fraction of the fence cost do I bear as tenant` 12 EQUALS 1

§ `s 21 -- entry`

#ASSERT `May I enter my neighbour's land for the fence work` TRUE TRUE TRUE

