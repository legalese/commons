-- s 10: no time named, so 3 months; 4 months on (yes), 3 (no); 6 months named and 4 passed (no).
#ASSERT `May I build the whole fence, wanting the fence` `as the owner wanting the fence` TRUE TRUE FALSE 0 4 EQUALS yes
#ASSERT `May I build the whole fence, wanting the fence` `as the owner wanting the fence` TRUE TRUE FALSE 0 3 EQUALS no
#ASSERT `May I build the whole fence, wanting the fence` `as the owner wanting the fence` TRUE TRUE FALSE 6 4 EQUALS no
