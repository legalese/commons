IMPORT prelude
IMPORT `tla-title`

-- Transfer of Land Act 1893 (WA), ss 52(2), 53, 58, 60, 61, 68, 88, 105-110, 113, 121-123, 138-142, 148-149, 187, 199, 201, 211, 214A, 219-220, 227 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_wa_transfer-of-land-act-1893_baseline.py). Expected results were written by
-- hand from the text.

-- Life facts used are from the workbench scenarios au/wa/cradle-to-grave-{chloe,jake,daniel}: Chloe (25) and Liam
-- settle the Byford land on 15 May 2028 and the mortgage is registered (c052); the Baldivis townhouse in a community
-- titles scheme, $1,300,000, 28 April 2040 (c081); Jake (38) settles his strata apartment on 20 March 2045 (k076);
-- Graham and Sue hold the Armadale house as joint tenants and Graham dies on 19 August 2052, Chloe his executor
-- (c087); Liam dies on 9 February 2083, the apartment by survivorship to Chloe (c096); Giuseppe dies on 3 November
-- 2052 owning a house in Reggio Calabria (d074); Daniel dies on 15 November 2078, the house to Priya by survivorship
-- (d093). The lives do not say how Chloe and Liam, or Daniel and Priya, are registered: joint proprietorship is
-- ASSUMED where a life says "by survivorship". The signatures on the Byford mortgage, the hours in Jake's stay and
-- every dollar figure below are HYPOTHETICAL.

§ `fixtures`

`Chloe and Liam's Byford mortgage, registered at settlement on 15 May 2028` MEANS Mortgage WITH
    `registered` IS TRUE
    `a lodged counterpart is signed by the lender` IS TRUE
    `a lodged counterpart is signed by me` IS TRUE
    `I signed a counterpart before registration` IS TRUE

`a mortgage lodged with only the lender's counterpart, the owners never having signed` MEANS Mortgage WITH
    `registered` IS TRUE
    `a lodged counterpart is signed by the lender` IS TRUE
    `a lodged counterpart is signed by me` IS FALSE
    `I signed a counterpart before registration` IS FALSE

`a mortgage signed by everyone but never registered` MEANS Mortgage WITH
    `registered` IS FALSE
    `a lodged counterpart is signed by the lender` IS TRUE
    `a lodged counterpart is signed by me` IS TRUE
    `I signed a counterpart before registration` IS TRUE

§ `ss 52(2), 58, 53 -- registration and priority (c052, k076)`

-- c052: the Byford transfer is registered at settlement, so the land has passed. k076: before Jake's transfer is entered, it has not.
#ASSERT `Has the land passed to me` TRUE
#ASSERT (NOT (`Has the land passed to me` FALSE))

#ASSERT `Does my instrument have priority` 1 2

§ `ss 148, 149 -- the buyer's 48-hour stay (k076: Jake's settlement)`

#ASSERT `Does my transfer take priority under the stay` TRUE TRUE TRUE 47 TRUE
#ASSERT (NOT (`Does my transfer take priority under the stay` TRUE TRUE TRUE 49 TRUE))

§ `ss 68, 134 -- what binds my registered title (c052, c081, k076)`

-- c081: unpaid council rates on the Baldivis townhouse bind Chloe though not on the title.
#ASSERT `Am I bound by this interest` `unpaid rates` FALSE EQUALS `bound: section 68 does not free me from it`
#ASSERT `Am I bound by this interest` `an unregistered mortgage` FALSE EQUALS `free: section 68 frees me from it`
#ASSERT `Am I bound by this interest` `an unregistered interest I knew of when I took my transfer` FALSE EQUALS `free: section 68 frees me from it`
#ASSERT `Am I bound by this interest` `an unregistered mortgage` TRUE EQUALS `unprotected: my title is a case of fraud, and section 68 frees me from nothing`

-- k076 / c081: a strata company's or community corporation's unpaid levies -- this Act does not say.
#ASSERT `Am I bound by this interest` `unpaid levies of a strata company or community corporation` FALSE EQUALS `this Act does not say: whether such levies are unpaid rates is for the strata or community titles legislation`

-- registered, prior, term in years, tenant in actual possession
#ASSERT `Do I take subject to the lease` FALSE TRUE 5 TRUE
#ASSERT (NOT (`Do I take subject to the lease` FALSE TRUE 6 TRUE))

#ASSERT (NOT (`Is the option valid against me` FALSE FALSE))

§ `ss 199, 201, 211, 214A -- recovery, compensation, fraud`

#ASSERT `Can this person recover my land from me` `someone deprived by a fraud through which I was registered`
#ASSERT (NOT (`Can this person recover my land from me` `someone deprived by fraud, where I bought bona fide for value from the fraudster`))

-- deprived, dead, bankrupt, not found, liability capped by a bona fide transfer
#ASSERT `Can I recover damages from the State` TRUE TRUE FALSE FALSE FALSE
#ASSERT (NOT (`Can I recover damages from the State` TRUE FALSE FALSE FALSE FALSE))

-- months since deprived, under a disability, months since it ceased
#ASSERT (NOT (`Is it still time to sue for my land` 80 FALSE 0))
#ASSERT `Is it still time to sue for my land` 300 TRUE 24

#ASSERT (NOT (`Is it void against me` TRUE FALSE))

§ `ss 60, 61 -- joint tenants and no survivorship (c087: Graham and Sue)`

#ASSERT `Are we joint tenants` `as joint proprietors` 2
#ASSERT (NOT (`Are we joint tenants` `as tenants in common in undivided shares` 2))

#ASSERT (NOT (`May I deal with the property` TRUE FALSE FALSE))
#ASSERT `May I deal with the property` TRUE FALSE TRUE

§ `ss 227, 187, 219, 220 -- onto the register after a death (c087, c096, d074, d093)`

-- c087: Sue, surviving Graham on the Armadale house, applies under s 227; Chloe, as Graham's executor, has no route to it.
-- c096: Chloe, surviving Liam (joint proprietorship assumed).  d074: Giuseppe's house in Reggio Calabria is not under
-- this Act.  d093: Priya, surviving Daniel (joint proprietorship assumed).  Last: an executor of a tenant in common.
#ASSERT `How do I get onto the register after the death` TRUE `as joint proprietors` `the surviving joint proprietor` EQUALS `I may apply as survivor under section 227; no probate is needed`
#ASSERT `How do I get onto the register after the death` TRUE `as joint proprietors` `the executor or administrator` EQUALS `section 227 is the survivor's route; whether the deceased's estate keeps any interest is general law, not this Act`
#ASSERT `How do I get onto the register after the death` TRUE `as joint proprietors` `the surviving joint proprietor` EQUALS `I may apply as survivor under section 227; no probate is needed`
#ASSERT `How do I get onto the register after the death` FALSE `as sole proprietor` `someone else` EQUALS `the land is not under this Act, which says nothing about it`
#ASSERT `How do I get onto the register after the death` TRUE `as joint proprietors` `the surviving joint proprietor` EQUALS `I may apply as survivor under section 227; no probate is needed`
#ASSERT `How do I get onto the register after the death` TRUE `as tenants in common in undivided shares` `the executor or administrator` EQUALS `I may apply as executor or administrator under section 187, on the probate or letters`

#ASSERT (NOT (`May I be registered as survivor` TRUE TRUE FALSE))

#ASSERT `Must the Registrar register me as executor` TRUE TRUE

#ASSERT (NOT (`May we deal with the deceased's land` 2 1))

-- directed notice, days appointed, days since the advertisement, a caveat forbids
#ASSERT `May I be registered as devisee` TRUE 14 15 FALSE
#ASSERT (NOT (`May I be registered as devisee` TRUE 14 15 TRUE))

§ `ss 105, 105AA, 106(1), 123 -- my mortgage (c052)`

#ASSERT `Does my mortgage bind me` `Chloe and Liam's Byford mortgage, registered at settlement on 15 May 2028`
#ASSERT (NOT (`Does my mortgage bind me` `a mortgage lodged with only the lender's counterpart, the owners never having signed`))
#ASSERT (NOT (`Does my mortgage bind me` `a mortgage signed by everyone but never registered`))

#ASSERT (NOT (`May my lender lodge my mortgage electronically` TRUE FALSE))

#ASSERT `What does my registered mortgage do`  EQUALS `a security over my land; I remain the proprietor and the land is not transferred`

#ASSERT (NOT (`Is my land freed from the mortgage` TRUE FALSE))

§ `ss 113, 88, 131 -- implied covenants`

#ASSERT `Does my mortgage bind me to this` `to keep the buildings and improvements in repair` FALSE
#ASSERT (NOT (`Does my mortgage bind me to this` `to insure the buildings` FALSE))

#ASSERT `Must I indemnify the seller` TRUE FALSE
#ASSERT (NOT (`Must I indemnify the seller` TRUE TRUE))

§ `ss 106-108 -- default, notice and sale`

#ASSERT `How many months before a notice to pay` 0 EQUALS 1
#ASSERT `How many months before a notice to pay` 3 EQUALS 3

#ASSERT `May my lender serve a notice to pay` TRUE 1 0
#ASSERT (NOT (`May my lender serve a notice to pay` TRUE 1 2))

#ASSERT `Was the notice properly served on me` `left in a conspicuous place on the land`
#ASSERT (NOT (`Was the notice properly served on me` `ordinary post`))

-- on demand, demand made, notice served, how sent, months after notice or demand, months fixed for sale
#ASSERT (NOT (`May my lender sell my land` FALSE FALSE TRUE `ordinary post` 2 0))
#ASSERT `May my lender sell my land` TRUE TRUE FALSE `ordinary post` 1 0

§ `ss 109, 110 -- the sale money and the buyer's title`

-- price, expenses, owing on the mortgage, owing on later mortgages (dollars, hypothetical)
#ASSERT `How much of the sale money comes to me` 500000 10000 400000 50000 EQUALS 40000
#ASSERT `How much of the sale money comes to me` 300000 10000 400000 0 EQUALS 0

-- the selling mortgage itself, registered after it, a lease or easement the lender consented to
#ASSERT `Do I take free of it` FALSE TRUE FALSE
#ASSERT (NOT (`Do I take free of it` FALSE FALSE FALSE))

§ `ss 121, 122 -- foreclosure`

#ASSERT `May my lender apply to foreclose` 6 TRUE TRUE TRUE TRUE
#ASSERT (NOT (`May my lender apply to foreclose` 5 TRUE TRUE TRUE TRUE))

#ASSERT `Can a foreclosure order issue against me` TRUE 1 TRUE FALSE
#ASSERT (NOT (`Can a foreclosure order issue against me` TRUE 2 TRUE TRUE))

§ `ss 138, 138B, 138D, 139, 140, 142 -- caveats against my land`

-- in force, lodged after my instrument, kind, Commissioner's opinion, caveator consents, days since served, protested in time
#ASSERT (NOT (`Does the caveat stop my dealing` TRUE TRUE `an ordinary caveat claiming an interest` FALSE FALSE 0 FALSE))
#ASSERT `Does the caveat stop my dealing` TRUE FALSE `an ordinary caveat claiming an interest` FALSE FALSE 0 FALSE
#ASSERT (NOT (`Does the caveat stop my dealing` TRUE FALSE `a caveat by a beneficiary under a will or settlement` TRUE FALSE 15 FALSE))

#ASSERT `Has the caveat lapsed on my dealing` `an ordinary caveat claiming an interest` TRUE 14 FALSE
#ASSERT (NOT (`Has the caveat lapsed on my dealing` `a caveat by a beneficiary under a will or settlement` TRUE 30 FALSE))

#ASSERT `Has the caveat lapsed on my notice` `an ordinary caveat claiming an interest` TRUE 21 FALSE

#ASSERT (NOT (`May the caveator lodge another caveat` `lapsed under the 21-day notice` FALSE FALSE))
#ASSERT `May the caveator lodge another caveat` `withdrawn before any 21-day notice was served` FALSE FALSE

#ASSERT `Can I be compensated for the caveat` TRUE TRUE

