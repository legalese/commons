#ASSERT `Does a WA costs determination govern what the law practice may charge me` `as the client` `a determination and a void agreement` EQUALS yes
#ASSERT `Does a WA costs determination govern what the law practice may charge me` `as the lawyer` `an unasked My costs position` EQUALS `does not arise for you`
#ASSERT `Has the law practice breached its duty to tell me whether a costs determination applies` `as the client` TRUE FALSE EQUALS yes
#ASSERT `Has the law practice breached its duty to tell me whether a costs determination applies` `as the client` TRUE TRUE EQUALS no
#ASSERT `Has the law practice breached its duty to tell me whether a costs determination applies` `as the client` FALSE FALSE EQUALS no
#ASSERT `Has the law practice breached its duty to tell me whether a costs determination applies` `as the lawyer` `an unasked fact` `an unasked fact` EQUALS `does not arise for you`
#ASSERT `As the client can I still apply for review of the costs assessment` `as the client` TRUE (Date 1 3 2029) (Date 29 3 2029) EQUALS yes
#ASSERT `As the client can I still apply for review of the costs assessment` `as the client` TRUE (Date 1 3 2029) (Date 30 3 2029) EQUALS no
#ASSERT `As the client can I still apply for review of the costs assessment` `as the client` FALSE `an unasked date` `an unasked date` EQUALS `does not arise for you`
#ASSERT `As the client can I still apply for review of the costs assessment` `as the lawyer` `an unasked fact` `an unasked date` `an unasked date` EQUALS `does not arise for you`
#ASSERT `How much must the law practice repay me as excess over the assessed costs` `as the client` TRUE 12000 10000 EQUALS amount 2000
#ASSERT `How much must the law practice repay me as excess over the assessed costs` `as the client` FALSE `an unasked number` `an unasked number` EQUALS `does not arise for you`
#ASSERT `How much must the law practice repay me as excess over the assessed costs` `as the lawyer` `an unasked fact` `an unasked number` `an unasked number` EQUALS `does not arise for you`
-- s 10(2): advice from someone not admitted: nothing recoverable, and what was paid may be recovered as a debt; from a practitioner, or a r 10 exempt conveyancer, or policy work: s 10(2) does not apply.
#ASSERT `Can the person who did legal work for me recover fees if they were not entitled` `as the client` `give legal advice or other legal services` `not admitted` FALSE FALSE FALSE EQUALS `no: they were not entitled to engage in legal practice, so they may recover nothing for it and must repay what you paid, which you may recover from them as a debt (s 10(2))`
#ASSERT `Can the person who did legal work for me recover fees if they were not entitled` `as the client` `give legal advice or other legal services` `an Australian lawyer under the Uniform Law (WA)` TRUE FALSE FALSE EQUALS `s 10(2) does not stop them recovering: they were entitled to do it, or it was not legal practice`
#ASSERT `Can the person who did legal work for me recover fees if they were not entitled` `as the client` `give legal advice or other legal services` `not admitted` FALSE FALSE TRUE EQUALS `s 10(2) does not stop them recovering: they were entitled to do it, or it was not legal practice`
#ASSERT `Can the person who did legal work for me recover fees if they were not entitled` `as the client` `policy work only` `not admitted` FALSE FALSE FALSE EQUALS `s 10(2) does not stop them recovering: they were entitled to do it, or it was not legal practice`
#ASSERT `Can the person who did legal work for me recover fees if they were not entitled` `as the lawyer` `an unasked What I want to do` `an unasked My standing` `an unasked fact` `an unasked fact` `an unasked fact` EQUALS `does not arise for you`

§§ `Mirror cases: d038 from both seats`

#ASSERT (`Is my firm's conditional costs agreement valid, and if not what can it recover` `as the lawyer` TRUE `a conditional` `an arbitration` TRUE FALSE `the same with a 30% uplift` EQUALS `the answer is` `void: the uplift breaches s 182, so no part of the uplift fee is recoverable (s 185(3))`) AND (`Is my conditional costs agreement with the law practice valid` `as the client` `a conditional` `an arbitration` TRUE FALSE `the same with a 30% uplift` EQUALS `void: the uplift breaches s 182, so the law practice may recover no part of the uplift fee from you (s 185(3))`)
#ASSERT (`How much must my firm repay as excess over the assessed costs` `as the lawyer` TRUE TRUE 12000 10000 EQUALS amount 2000) AND (`How much must the law practice repay me as excess over the assessed costs` `as the client` TRUE 12000 10000 EQUALS amount 2000)
#ASSERT (`Does a WA costs determination govern what my firm may charge` `as the lawyer` TRUE `a determination and Daniel's valid agreement` EQUALS no) AND (`Does a WA costs determination govern what the law practice may charge me` `as the client` `a determination and Daniel's valid agreement` EQUALS no)
