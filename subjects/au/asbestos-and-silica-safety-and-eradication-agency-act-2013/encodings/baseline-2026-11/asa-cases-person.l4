IMPORT prelude
IMPORT `asa-person`

-- Asbestos and Silica Safety and Eradication Agency Act 2013 -- worked cases, from the seat of a person with, or caring for
-- someone with, an asbestos- or silica-related disease (and any person the Agency asks for information).
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Expected values were written by hand
-- from the deposited text (C2024C00186), never copied from the encoding's output. No scenario life raised these provisions;
-- the facts are the encoder's, HYPOTHETICAL throughout. The CEO's and the Minister's beliefs, satisfaction and agreement are
-- given as facts, as the encoding asks them.
--
-- A breached or still-pending DEONTIC cannot be asserted with EQUALS on the stable l4, so the regulative rules are asserted
-- through `ends fulfilled` (TRUE only for a trace that ends FULFILLED), and breaches are also #TRACEd with an "-- expect:" line.

GIVEN d IS A DEONTIC `Agency party` `Agency act`
GIVETH A BOOLEAN
`ends fulfilled` d MEANS
    CONSIDER d
    WHEN FULFILLED THEN TRUE
    OTHERWISE FALSE

-- ---------------------------------------------------------------------------------------------------------------------
-- ss 5A(2), 5B(2). "only if ... at least 6 of the governments": 6 is enough, 5 is not.
#ASSERT `Does the national plan commit governments question` `the Asbestos National Strategic Plan` 6 EQUALS JUST TRUE
#ASSERT `Does the national plan commit governments question` `the Asbestos National Strategic Plan` 5 EQUALS JUST FALSE
#ASSERT `Does the national plan commit governments question` `the Asbestos National Strategic Plan` 9 EQUALS JUST TRUE
#ASSERT `Does the national plan commit governments question` `the Silica National Strategic Plan` 6 EQUALS JUST TRUE
#ASSERT `Does the national plan commit governments question` `the Silica National Strategic Plan` 0 EQUALS JUST FALSE

-- ---------------------------------------------------------------------------------------------------------------------
-- s 8A(1), (3). The report on 1 July 2024 - 30 June 2025 is due before the end of 31 December 2025.
#ASSERT `By when must the Agency report on progress question` `the Asbestos National Strategic Plan` 2025 EQUALS DATE_FROM_DMY 31 12 2025
#ASSERT `By when must the Agency report on progress question` `the Silica National Strategic Plan` 2026 EQUALS DATE_FROM_DMY 31 12 2026

-- Prepared on 31 December 2025 (the last day): in time.
#ASSERT `Is the progress report on time question` `the Asbestos National Strategic Plan` 2025 TRUE (DATE_FROM_DMY 31 12 2025) (DATE_FROM_DMY 1 3 2026) EQUALS `prepared in time (before the end of 31 December)`
-- Prepared on 1 January 2026: one day late.
#ASSERT `Is the progress report on time question` `the Asbestos National Strategic Plan` 2025 TRUE (DATE_FROM_DMY 1 1 2026) (DATE_FROM_DMY 1 3 2026) EQUALS `prepared late (after 31 December)`
-- Prepared on 1 July 2025, the first day of the reporting year: in time.
#ASSERT `Is the progress report on time question` `the Silica National Strategic Plan` 2025 TRUE (DATE_FROM_DMY 1 7 2025) (DATE_FROM_DMY 1 3 2026) EQUALS `prepared in time (before the end of 31 December)`
-- Not prepared; today is 31 December 2025: still not due (it can be prepared today).
#ASSERT `Is the progress report on time question` `the Asbestos National Strategic Plan` 2025 FALSE (DATE_FROM_DMY 1 1 2000) (DATE_FROM_DMY 31 12 2025) EQUALS `not prepared yet, and still not due`
-- Not prepared; today is 1 January 2026: overdue.
#ASSERT `Is the progress report on time question` `the Asbestos National Strategic Plan` 2025 FALSE (DATE_FROM_DMY 1 1 2000) (DATE_FROM_DMY 1 1 2026) EQUALS `not prepared yet, and overdue (31 December has passed)`
-- Not prepared; today is 15 September 2025: still not due.
#ASSERT `Is the progress report on time question` `the Silica National Strategic Plan` 2025 FALSE (DATE_FROM_DMY 1 1 2000) (DATE_FROM_DMY 15 9 2025) EQUALS `not prepared yet, and still not due`
-- A leap year changes nothing (1 July to 31 December has no February): prepared 31 December 2024 is in time.
#ASSERT `Is the progress report on time question` `the Asbestos National Strategic Plan` 2024 TRUE (DATE_FROM_DMY 31 12 2024) (DATE_FROM_DMY 1 3 2025) EQUALS `prepared in time (before the end of 31 December)`

-- The rule itself: day 183 (31 December) fulfils, day 184 (1 January) does not.
#ASSERT `ends fulfilled` (EVALTRACE `s 8A(1), (3) -- the Agency must prepare the progress report before the end of 31 December` 0 (LIST (EVENT `the Agency` `prepare the progress report` 183)))
#ASSERT (NOT (`ends fulfilled` (EVALTRACE `s 8A(1), (3) -- the Agency must prepare the progress report before the end of 31 December` 0 (LIST (EVENT `the Agency` `prepare the progress report` 184)))))
-- expect: BREACH by the Agency ("not prepared before the end of 31 December")
#TRACE `s 8A(1), (3) -- the Agency must prepare the progress report before the end of 31 December` AT 0 WITH
    PARTY `the Agency` DOES `prepare the progress report` AT 184

-- s 8A(5). A prepared report must be made public; before it is prepared, s 8A(5) is silent.
#ASSERT `Must the Agency make the progress report public question` TRUE EQUALS JUST TRUE
#ASSERT `Must the Agency make the progress report public question` FALSE EQUALS NOTHING
#ASSERT `ends fulfilled` (EVALTRACE `s 8A(5) -- the Agency must make the report publicly available` 0 (LIST (EVENT `the Agency` `make the report publicly available` 30)))
-- Only looked at, never published: the duty is still open.
#ASSERT (NOT (`ends fulfilled` (EVALTRACE `s 8A(5) -- the Agency must make the report publicly available` 0 (LIST (EVENT `I, the person asked` `I check where things stand` 400)))))
-- expect: residual (the Agency must still make the report publicly available)
#TRACE `s 8A(5) -- the Agency must make the report publicly available` AT 0 WITH
    PARTY `I, the person asked` DOES `I check where things stand` AT 400

-- ---------------------------------------------------------------------------------------------------------------------
-- s 14A(1), (2). HYPOTHETICAL: Rosa, a former stonemason with silicosis, gets a letter from the CEO asking about the dust
-- controls at her old workplace. Every condition met: the CEO can ask.
#ASSERT `Can the CEO ask me for information question` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- Each condition failing in turn: s 14A does not reach the request.
#ASSERT `Can the CEO ask me for information question` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Can the CEO ask me for information question` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Can the CEO ask me for information question` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
-- Asked only by phone, with no written notice.
#ASSERT `Can the CEO ask me for information question` TRUE TRUE TRUE FALSE EQUALS JUST FALSE

-- s 14A(3). Given on 1 March 2026: the earliest last day is 15 March 2026.
#ASSERT `What is the earliest last day the notice can set question` (DATE_FROM_DMY 1 3 2026) EQUALS DATE_FROM_DMY 15 3 2026
-- Across a year end: 20 December 2026 -> 3 January 2027.
#ASSERT `What is the earliest last day the notice can set question` (DATE_FROM_DMY 20 12 2026) EQUALS DATE_FROM_DMY 3 1 2027
-- A leap year: 15 February 2028 -> 29 February 2028.
#ASSERT `What is the earliest last day the notice can set question` (DATE_FROM_DMY 15 2 2028) EQUALS DATE_FROM_DMY 29 2 2028

-- s 14A(3), (4). Given 1 March, answer by 15 March, by email: as required.
#ASSERT `Is the notice made as s 14A requires question` (DATE_FROM_DMY 1 3 2026) (DATE_FROM_DMY 15 3 2026) TRUE EQUALS JUST TRUE
-- Answer by 14 March: 13 days, too short.
#ASSERT `Is the notice made as s 14A requires question` (DATE_FROM_DMY 1 3 2026) (DATE_FROM_DMY 14 3 2026) TRUE EQUALS JUST FALSE
-- 30 days, but only by attending the Agency's office: not a s 51(v) service.
#ASSERT `Is the notice made as s 14A requires question` (DATE_FROM_DMY 1 3 2026) (DATE_FROM_DMY 31 3 2026) FALSE EQUALS JUST FALSE

-- s 14A(5). Rosa never answers, and it is now well after the date in the notice: she was never bound to answer.
#ASSERT `Must I give the CEO the information question` (DATE_FROM_DMY 1 3 2026) (DATE_FROM_DMY 15 3 2026) FALSE (DATE_FROM_DMY 1 1 2000) (DATE_FROM_DMY 1 6 2026) EQUALS JUST FALSE
-- She answers on 20 March, after the date: no breach.
#ASSERT `Must I give the CEO the information question` (DATE_FROM_DMY 1 3 2026) (DATE_FROM_DMY 15 3 2026) TRUE (DATE_FROM_DMY 20 3 2026) (DATE_FROM_DMY 1 6 2026) EQUALS JUST FALSE
-- She answers on 15 March, the last day: no breach either.
#ASSERT `Must I give the CEO the information question` (DATE_FROM_DMY 1 3 2026) (DATE_FROM_DMY 15 3 2026) TRUE (DATE_FROM_DMY 15 3 2026) (DATE_FROM_DMY 1 6 2026) EQUALS JUST FALSE
-- The permission itself: not answering ends FULFILLED.
#ASSERT `ends fulfilled` (EVALTRACE (`s 14A(5) -- I may give the CEO the information within the period in the notice` 14) 0 (LIST (EVENT `I, the person asked` `I check where things stand` 90)))

-- s 14A(6). A valid request: a Commonwealth or State law does not stop her answering.
#ASSERT `May I give the information despite another law question` TRUE TRUE TRUE TRUE `a Commonwealth Act or instrument other than this Act (such as the Privacy Act 1988)` EQUALS JUST TRUE
#ASSERT `May I give the information despite another law question` TRUE TRUE TRUE TRUE `a State or Territory Act or instrument (such as a State health records or privacy law)` EQUALS JUST TRUE
#ASSERT `May I give the information despite another law question` TRUE TRUE TRUE TRUE `nothing` EQUALS JUST TRUE
-- A confidentiality clause in a settlement deed: not plainly "a law" (fork line).
#ASSERT `May I give the information despite another law question` TRUE TRUE TRUE TRUE `a contract or a duty of confidence (not an Act)` EQUALS NOTHING
-- A phone request only: not a s 14A request, so s 14A(6) does not speak.
#ASSERT `May I give the information despite another law question` TRUE TRUE TRUE FALSE `a Commonwealth Act or instrument other than this Act (such as the Privacy Act 1988)` EQUALS NOTHING
-- The CEO is not satisfied the information is unavailable elsewhere: likewise.
#ASSERT `May I give the information despite another law question` TRUE TRUE FALSE TRUE `a State or Territory Act or instrument (such as a State health records or privacy law)` EQUALS NOTHING

-- ---------------------------------------------------------------------------------------------------------------------
-- ss 31, 32. HYPOTHETICAL: Dev, whose father died of mesothelioma and whom he cared for, seeks the Chair. The Minister is
-- satisfied of his lived experience only: eligible (s 32(3)(b)(ii)).
#ASSERT `Am I eligible to be appointed to the Council question` `the Chair (s 31(a))` FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- The Minister is satisfied of neither: not eligible.
#ASSERT `Am I eligible to be appointed to the Council question` `the Chair (s 31(a))` FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- An "other member" place, on knowledge of corporate governance: eligible.
#ASSERT `Am I eligible to be appointed to the Council question` `one of the 2 other members (s 31(f))` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- Rosa, nominated by an authorised workers' body, with silicosis, and the Minister agrees: eligible for a workers' place.
#ASSERT `Am I eligible to be appointed to the Council question` `a member representing the interests of workers (s 31(d))` FALSE TRUE TRUE TRUE FALSE EQUALS JUST TRUE
-- The same, but the Minister does not agree (s 32(4)(b)): not eligible.
#ASSERT `Am I eligible to be appointed to the Council question` `a member representing the interests of workers (s 31(d))` FALSE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
-- Nominated and agreed, but neither s 32(3) ground: not eligible.
#ASSERT `Am I eligible to be appointed to the Council question` `a member representing the interests of workers (s 31(d))` FALSE FALSE TRUE TRUE FALSE EQUALS JUST FALSE
-- An employers' place without a nomination (s 32(7)(a)): not eligible; with one: eligible.
#ASSERT `Am I eligible to be appointed to the Council question` `a member representing the interests of employers (s 31(e))` TRUE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Am I eligible to be appointed to the Council question` `a member representing the interests of employers (s 31(e))` TRUE FALSE TRUE TRUE FALSE EQUALS JUST TRUE
-- The government places: the Act sets no condition.
#ASSERT `Am I eligible to be appointed to the Council question` `the member representing the Commonwealth (s 31(b))` FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `Am I eligible to be appointed to the Council question` `a member representing State, Territory and local governments (s 31(c))` TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING
-- The expertise place: turns on expertise alone.
#ASSERT `Am I eligible to be appointed to the Council question` `the member with relevant expertise (s 31(ea))` FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Am I eligible to be appointed to the Council question` `the member with relevant expertise (s 31(ea))` TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE

-- s 34(2)-(4). Acting in an "other member" place on lived experience: eligible to act.
#ASSERT `Can I be appointed to act on the Council question` `one of the 2 other members (s 31(f))` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Can I be appointed to act on the Council question` `one of the 2 other members (s 31(f))` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- Acting in a workers' place without a nomination: not eligible (fork line: s 32(4) read in); with one: eligible.
#ASSERT `Can I be appointed to act on the Council question` `a member representing the interests of workers (s 31(d))` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Can I be appointed to act on the Council question` `a member representing the interests of workers (s 31(d))` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Can I be appointed to act on the Council question` `a member representing the interests of employers (s 31(e))` FALSE TRUE TRUE TRUE EQUALS JUST TRUE
-- Places s 34(3), (4) do not reach: no condition to answer.
#ASSERT `Can I be appointed to act on the Council question` `the Chair (s 31(a))` FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `Can I be appointed to act on the Council question` `a member representing State, Territory and local governments (s 31(c))` FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `Can I be appointed to act on the Council question` `the member with relevant expertise (s 31(ea))` TRUE TRUE TRUE TRUE EQUALS NOTHING

-- ---------------------------------------------------------------------------------------------------------------------
-- s 33. Three years exactly is allowed; 37 months is not.
#ASSERT `Is my Council term within the limit question` 36 EQUALS JUST TRUE
#ASSERT `Is my Council term within the limit question` 37 EQUALS JUST FALSE
#ASSERT `Is my Council term within the limit question` 12 EQUALS JUST TRUE

-- s 35(2).
#ASSERT `Am I entitled to Council remuneration question` `none of these (part-time public work, private work, self-employed, retired or not working)` EQUALS JUST TRUE
#ASSERT `Am I entitled to Council remuneration question` `full-time in the service or employment of a State` EQUALS JUST FALSE
#ASSERT `Am I entitled to Council remuneration question` `full-time with a State public statutory corporation (not a tertiary education institution)` EQUALS JUST FALSE
-- A full-time lecturer at a State university: the tertiary exception, so entitled.
#ASSERT `Am I entitled to Council remuneration question` `full-time with a tertiary education institution established by a State law` EQUALS JUST TRUE
#ASSERT `Am I entitled to Council remuneration question` `full-time with a State-owned company limited by guarantee` EQUALS JUST FALSE
#ASSERT `Am I entitled to Council remuneration question` `full-time with a company wholly owned by a State or a State public statutory corporation` EQUALS JUST FALSE
-- Full-time Commonwealth service: left to the Remuneration Tribunal Act 1973 (not deposited).
#ASSERT `Am I entitled to Council remuneration question` `full-time in the service of the Commonwealth or a Territory` EQUALS NOTHING

-- s 37(3).
#ASSERT `Am I taken not to have complied with the disclosure duty question` FALSE EQUALS JUST TRUE
#ASSERT `Am I taken not to have complied with the disclosure duty question` TRUE EQUALS JUST FALSE

-- s 39(2). Received 10 March 2026, naming 30 June 2026: 30 June.
#ASSERT `When does my Council resignation take effect question` (DATE_FROM_DMY 10 3 2026) TRUE (DATE_FROM_DMY 30 6 2026) EQUALS DATE_FROM_DMY 30 6 2026
-- Naming 1 March, before receipt: not "a later day", so 10 March.
#ASSERT `When does my Council resignation take effect question` (DATE_FROM_DMY 10 3 2026) TRUE (DATE_FROM_DMY 1 3 2026) EQUALS DATE_FROM_DMY 10 3 2026
-- Naming the day of receipt itself: 10 March.
#ASSERT `When does my Council resignation take effect question` (DATE_FROM_DMY 10 3 2026) TRUE (DATE_FROM_DMY 10 3 2026) EQUALS DATE_FROM_DMY 10 3 2026
-- Naming 11 March, one day later: 11 March.
#ASSERT `When does my Council resignation take effect question` (DATE_FROM_DMY 10 3 2026) TRUE (DATE_FROM_DMY 11 3 2026) EQUALS DATE_FROM_DMY 11 3 2026
-- Naming no day: 10 March.
#ASSERT `When does my Council resignation take effect question` (DATE_FROM_DMY 10 3 2026) FALSE (DATE_FROM_DMY 30 6 2026) EQUALS DATE_FROM_DMY 10 3 2026

-- s 40. Absent without leave from 3 consecutive meetings: may be terminated; from 2: no ground.
#ASSERT `Can the Minister terminate my Council appointment question` FALSE FALSE FALSE 3 FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Can the Minister terminate my Council appointment question` FALSE FALSE FALSE 2 FALSE TRUE FALSE EQUALS NOTHING
-- Misbehaviour; incapacity; bankruptcy.
#ASSERT `Can the Minister terminate my Council appointment question` TRUE FALSE FALSE 0 FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Can the Minister terminate my Council appointment question` FALSE TRUE FALSE 0 FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Can the Minister terminate my Council appointment question` FALSE FALSE TRUE 0 FALSE TRUE FALSE EQUALS JUST TRUE
-- Failed to disclose, without a reasonable excuse: a ground; with one: none.
#ASSERT `Can the Minister terminate my Council appointment question` FALSE FALSE FALSE 0 TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Can the Minister terminate my Council appointment question` FALSE FALSE FALSE 0 TRUE TRUE TRUE EQUALS NOTHING
-- Disclosed, but the Council did not record it (s 37(3)), and no reasonable excuse: a ground under s 40(e).
#ASSERT `Can the Minister terminate my Council appointment question` FALSE FALSE FALSE 0 FALSE FALSE FALSE EQUALS JUST TRUE
