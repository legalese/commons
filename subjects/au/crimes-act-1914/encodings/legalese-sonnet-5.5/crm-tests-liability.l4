IMPORT prelude
IMPORT daydate
IMPORT `crm-time`
IMPORT `crm-liability`

-- Tests for crm-liability.l4. Every expected value is written from the text
-- of ss 4K, 4L, 4M and 4N before the line was run; none is copied from output.

§ `Tests of the liability module`


§§ `Section 4K(1): the obligation continues`

-- The arguments: an act is required by a law of the Commonwealth within a period or before a time; the period has expired or the time has passed; the act has been done; a contrary intention appears.
#ASSERT `s 4K(1) the obligation to do that act or thing continues` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 4K(1) the obligation to do that act or thing continues` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 4K(1) the obligation to do that act or thing continues` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 4K(1) the obligation to do that act or thing continues` TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 4K(1) the obligation to do that act or thing continues` FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 4K(1) the obligation to do that act or thing continues` FALSE FALSE FALSE FALSE EQUALS JUST FALSE

§§ `Section 4K(2): an offence for each day`

#ASSERT `s 4K(2) the person commits an offence in respect of the day` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 4K(2) the person commits an offence in respect of the day` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 4K(2) the person commits an offence in respect of the day` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 4K(2) the person commits an offence in respect of the day` FALSE TRUE TRUE EQUALS JUST FALSE

§§ `Section 4K(3) and (4)`

-- The arguments: the same person; the same provision; the same facts; a series of offences of the same or a similar character.
#ASSERT `s 4K(3) the charges may be joined in the same information, complaint or summons` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 4K(3) the charges may be joined in the same information, complaint or summons` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 4K(3) the charges may be joined in the same information, complaint or summons` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 4K(3) the charges may be joined in the same information, complaint or summons` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 4K(3) the charges may be joined in the same information, complaint or summons` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 4K(3) the charges may be joined in the same information, complaint or summons` TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 4K(4) the court may impose one penalty in respect of both or all of those offences` TRUE EQUALS JUST TRUE
#ASSERT `s 4K(4) the court may impose one penalty in respect of both or all of those offences` FALSE EQUALS JUST FALSE
#ASSERT `s 4K(4) the most the one penalty may be` TRUE (LIST 10, 20) EQUALS JUST 30
#ASSERT `s 4K(4) the most the one penalty may be` TRUE (LIST 60, 60, 60) EQUALS JUST 180
#ASSERT `s 4K(4) the most the one penalty may be` TRUE (LIST 10) EQUALS NOTHING
#ASSERT `s 4K(4) the most the one penalty may be` FALSE (LIST 10, 20) EQUALS NOTHING
#ASSERT `s 4K(4) the most the one penalty may be` TRUE (LIST) EQUALS NOTHING

§§ `Section 4L: specified defences`

#ASSERT `s 4L the provision does not prevent the use of any defence that is otherwise available` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 4L the provision does not prevent the use of any defence that is otherwise available` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 4L the provision does not prevent the use of any defence that is otherwise available` FALSE FALSE EQUALS NOTHING
#ASSERT `s 4L the provision does not prevent the use of any defence that is otherwise available` FALSE TRUE EQUALS NOTHING

§§ `Sections 4M and 4N: children`

#ASSERT `s 4M a child can be liable for an offence against a law of the Commonwealth` 0 EQUALS JUST FALSE
#ASSERT `s 4M a child can be liable for an offence against a law of the Commonwealth` 5 EQUALS JUST FALSE
#ASSERT `s 4M a child can be liable for an offence against a law of the Commonwealth` 9 EQUALS JUST FALSE
#ASSERT `s 4M a child can be liable for an offence against a law of the Commonwealth` 9.5 EQUALS JUST FALSE
#ASSERT `s 4M a child can be liable for an offence against a law of the Commonwealth` 10 EQUALS NOTHING
#ASSERT `s 4M a child can be liable for an offence against a law of the Commonwealth` 13 EQUALS NOTHING
#ASSERT `s 4M a child can be liable for an offence against a law of the Commonwealth` 14 EQUALS NOTHING
#ASSERT `s 4M a child can be liable for an offence against a law of the Commonwealth` 40 EQUALS NOTHING
-- The arguments: the age in years; the child "knows that his or her conduct is wrong".
#ASSERT `s 4N(1) a child can be liable for an offence against a law of the Commonwealth` 10 FALSE EQUALS JUST FALSE
#ASSERT `s 4N(1) a child can be liable for an offence against a law of the Commonwealth` 13 FALSE EQUALS JUST FALSE
#ASSERT `s 4N(1) a child can be liable for an offence against a law of the Commonwealth` 13.9 FALSE EQUALS JUST FALSE
#ASSERT `s 4N(1) a child can be liable for an offence against a law of the Commonwealth` 10 TRUE EQUALS NOTHING
#ASSERT `s 4N(1) a child can be liable for an offence against a law of the Commonwealth` 13 TRUE EQUALS NOTHING
#ASSERT `s 4N(1) a child can be liable for an offence against a law of the Commonwealth` 14 FALSE EQUALS NOTHING
#ASSERT `s 4N(1) a child can be liable for an offence against a law of the Commonwealth` 14 TRUE EQUALS NOTHING
#ASSERT `s 4N(1) a child can be liable for an offence against a law of the Commonwealth` 9 FALSE EQUALS NOTHING
#ASSERT `s 4N(1) a child can be liable for an offence against a law of the Commonwealth` 9 TRUE EQUALS NOTHING
#ASSERT `s 4N(1) a child can be liable for an offence against a law of the Commonwealth` 30 FALSE EQUALS NOTHING
#ASSERT `ss 4M and 4N(1) a child can be liable for an offence against a law of the Commonwealth` 9 TRUE EQUALS JUST FALSE
#ASSERT `ss 4M and 4N(1) a child can be liable for an offence against a law of the Commonwealth` 9 FALSE EQUALS JUST FALSE
#ASSERT `ss 4M and 4N(1) a child can be liable for an offence against a law of the Commonwealth` 0 TRUE EQUALS JUST FALSE
#ASSERT `ss 4M and 4N(1) a child can be liable for an offence against a law of the Commonwealth` 10 FALSE EQUALS JUST FALSE
#ASSERT `ss 4M and 4N(1) a child can be liable for an offence against a law of the Commonwealth` 13 FALSE EQUALS JUST FALSE
#ASSERT `ss 4M and 4N(1) a child can be liable for an offence against a law of the Commonwealth` 10 TRUE EQUALS NOTHING
#ASSERT `ss 4M and 4N(1) a child can be liable for an offence against a law of the Commonwealth` 13 TRUE EQUALS NOTHING
#ASSERT `ss 4M and 4N(1) a child can be liable for an offence against a law of the Commonwealth` 14 FALSE EQUALS NOTHING
#ASSERT `ss 4M and 4N(1) a child can be liable for an offence against a law of the Commonwealth` 14 TRUE EQUALS NOTHING
#ASSERT `ss 4M and 4N(1) a child can be liable for an offence against a law of the Commonwealth` 50 FALSE EQUALS NOTHING
#ASSERT `s 4N(2) the question whether a child knows that his or her conduct is wrong is one of fact` EQUALS TRUE
#ASSERT `s 4N(2) the party on whom the burden of proving that the child knows rests` EQUALS Prosecution
#ASSERT NOT (`s 4N(2) the party on whom the burden of proving that the child knows rests` EQUALS Defence)
