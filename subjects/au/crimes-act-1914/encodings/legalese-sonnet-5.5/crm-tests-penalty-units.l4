IMPORT prelude
IMPORT daydate
IMPORT `crm-time`
IMPORT `crm-penalty-units`

-- Tests for crm-penalty-units.l4. Every expected value is written from the
-- text of ss 4AA and 4AB before the line was run; none is copied from output.

§ `Tests of the penalty unit module`

§§ `Section 4AA(1), (1A) and (2)`

#ASSERT `s 4AA(1) a penalty unit means the amount mentioned in that subsection` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 4AA(1) a penalty unit means the amount mentioned in that subsection` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 4AA(1) a penalty unit means the amount mentioned in that subsection` FALSE FALSE EQUALS NOTHING
#ASSERT `s 4AA(1) the number of dollars in a penalty of a number of penalty units` 5 330 EQUALS 1650
#ASSERT `s 4AA(1) the number of dollars in a penalty of a number of penalty units` 0 330 EQUALS 0
#ASSERT `s 4AA(1) the number of dollars in a penalty of a number of penalty units` 60 343 EQUALS 20580

-- "If the amount of a penalty unit is indexed under subsection (3), the Minister must, by notifiable instrument, publish the amount of a penalty unit."
#ASSERT `s 4AA(1A) the Minister must, by notifiable instrument, publish the amount of a penalty unit` TRUE EQUALS JUST TRUE
#ASSERT `s 4AA(1A) the Minister must, by notifiable instrument, publish the amount of a penalty unit` FALSE EQUALS JUST FALSE
-- "a failure by the Minister to do so does not invalidate the indexation".
#ASSERT `s 4AA(1A) a failure by the Minister to publish the amount invalidates the indexation` FALSE EQUALS JUST FALSE
#ASSERT `s 4AA(1A) a failure by the Minister to publish the amount invalidates the indexation` TRUE EQUALS NOTHING

-- Territory Ordinance: an ordinance made under an Act providing for the
-- acceptance, administration or government of a Territory that has not become
-- an enactment of the Australian Capital Territory, and a regulation made under
-- such an ordinance.
#ASSERT `s 4AA(2) a Territory Ordinance` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 4AA(2) a Territory Ordinance` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 4AA(2) a Territory Ordinance` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 4AA(2) a Territory Ordinance` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 4AA(2) a Territory Ordinance` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 4AA(2) a Territory Ordinance` TRUE TRUE TRUE TRUE EQUALS JUST TRUE

§§ `Section 4AA(3) to (6): the indexed amount`

-- 1 July 2026: reference quarter 1 Jan to 31 Mar 2026, base quarter 1 Jan to
-- 31 Mar 2023. 130 / 125 = 1.04; 330 x 1.04 = 343.2; to the nearest dollar 343.
#ASSERT `s 4AA(3) the dollar amount mentioned in subsection (1) after the indexation day` (Date 1 7 2026) 330 130 125 EQUALS JUST 343
-- 1 July 2029: 135 / 130 = 1.03846..., factor 1.038; 343 x 1.038 = 356.034; 356.
#ASSERT `s 4AA(3) the dollar amount mentioned in subsection (1) after the indexation day` (Date 1 7 2029) 343 135 130 EQUALS JUST 356
-- 100 x 1.005 = 100.5, rounded upwards: 101.
#ASSERT `s 4AA(3) the dollar amount mentioned in subsection (1) after the indexation day` (Date 1 7 2026) 100 201 200 EQUALS JUST 101
-- 100 x 1.004 = 100.4: 100.
#ASSERT `s 4AA(3) the dollar amount mentioned in subsection (1) after the indexation day` (Date 1 7 2026) 100 1004 1000 EQUALS JUST 100
-- A day that is not an indexation day.
#ASSERT `s 4AA(3) the dollar amount mentioned in subsection (1) after the indexation day` (Date 1 7 2027) 330 130 125 EQUALS NOTHING
#ASSERT `s 4AA(3) the dollar amount mentioned in subsection (1) after the indexation day` (Date 30 6 2026) 330 130 125 EQUALS NOTHING
#ASSERT `s 4AA(3) the dollar amount mentioned in subsection (1) after the indexation day` (Date 2 7 2026) 330 130 125 EQUALS NOTHING
-- A base index number of nought does not give a factor.
#ASSERT `s 4AA(3) the dollar amount mentioned in subsection (1) after the indexation day` (Date 1 7 2026) 330 130 0 EQUALS NOTHING

#ASSERT `s 4AA(4) the indexation factor for an indexation day` 130 125 EQUALS JUST 1.04
#ASSERT `s 4AA(4) the indexation factor for an indexation day` 135 130 EQUALS JUST 1.038
#ASSERT `s 4AA(4) the indexation factor for an indexation day` 100 100 EQUALS JUST 1
#ASSERT `s 4AA(4) the indexation factor for an indexation day` 130 0 EQUALS NOTHING

-- Base quarter: the March quarter 3 years before the reference quarter.
#ASSERT `s 4AA(4) a quarter is the base quarter for the indexation day` (Date 1 1 2023) (Date 31 3 2023) (Date 1 7 2026) EQUALS TRUE
#ASSERT `s 4AA(4) a quarter is the base quarter for the indexation day` (Date 1 1 2026) (Date 31 3 2026) (Date 1 7 2026) EQUALS FALSE
#ASSERT `s 4AA(4) a quarter is the base quarter for the indexation day` (Date 1 10 2022) (Date 31 12 2022) (Date 1 7 2026) EQUALS FALSE
#ASSERT `s 4AA(4) a quarter is the base quarter for the indexation day` (Date 1 1 2026) (Date 31 3 2026) (Date 1 7 2029) EQUALS TRUE
#ASSERT `s 4AA(4) a quarter is the base quarter for the indexation day` (Date 1 1 2023) (Date 31 3 2023) (Date 1 7 2029) EQUALS FALSE
-- Reference quarter: the March quarter immediately before the indexation day.
#ASSERT `s 4AA(4) a quarter is the reference quarter for the indexation day` (Date 1 1 2026) (Date 31 3 2026) (Date 1 7 2026) EQUALS TRUE
#ASSERT `s 4AA(4) a quarter is the reference quarter for the indexation day` (Date 1 1 2023) (Date 31 3 2023) (Date 1 7 2026) EQUALS FALSE
#ASSERT `s 4AA(4) a quarter is the reference quarter for the indexation day` (Date 1 4 2026) (Date 30 6 2026) (Date 1 7 2026) EQUALS FALSE
#ASSERT `s 4AA(4) a quarter is the reference quarter for the indexation day` (Date 1 1 2029) (Date 31 3 2029) (Date 1 7 2029) EQUALS TRUE
#ASSERT `s 4AA(4) a quarter is the reference quarter for the indexation day` (Date 1 1 2032) (Date 31 3 2032) (Date 1 7 2032) EQUALS TRUE

-- March quarter: a quarter ending on 31 March.
#ASSERT `s 4AA(4) a period is a March quarter` (Date 1 1 2026) (Date 31 3 2026) EQUALS TRUE
#ASSERT `s 4AA(4) a period is a March quarter` (Date 1 4 2026) (Date 30 6 2026) EQUALS FALSE
#ASSERT `s 4AA(4) a period is a March quarter` (Date 1 1 2026) (Date 30 3 2026) EQUALS FALSE
#ASSERT `s 4AA(4) a period is a March quarter` (Date 2 1 2026) (Date 31 3 2026) EQUALS FALSE

-- Index number: the All Groups CPI number, the weighted average of the 8
-- capital cities, published by the Australian Statistician for the quarter.
#ASSERT `s 4AA(4) a number is the index number for a quarter` TRUE TRUE TRUE EQUALS TRUE
#ASSERT `s 4AA(4) a number is the index number for a quarter` FALSE TRUE TRUE EQUALS FALSE
#ASSERT `s 4AA(4) a number is the index number for a quarter` TRUE FALSE TRUE EQUALS FALSE
#ASSERT `s 4AA(4) a number is the index number for a quarter` TRUE TRUE FALSE EQUALS FALSE

-- Rounding of the factor: 3 decimal places, up if the fourth place is 5 or more.
#ASSERT `s 4AA(5) an indexation factor calculated to 3 decimal places` 1.0345 EQUALS 1.035
#ASSERT `s 4AA(5) an indexation factor calculated to 3 decimal places` 1.0344 EQUALS 1.034
#ASSERT `s 4AA(5) an indexation factor calculated to 3 decimal places` 1.0349 EQUALS 1.035
-- Rounding of the amount: to the nearest whole dollar, 50 cents upwards.
#ASSERT `s 4AA(6) the amount worked out under subsection (3), rounded to the nearest whole dollar` 1.04 330 EQUALS 343
#ASSERT `s 4AA(6) the amount worked out under subsection (3), rounded to the nearest whole dollar` 1.005 100 EQUALS 101
#ASSERT `s 4AA(6) the amount worked out under subsection (3), rounded to the nearest whole dollar` 1.025 100 EQUALS 103
#ASSERT `s 4AA(6) the amount worked out under subsection (3), rounded to the nearest whole dollar` 1.015 100 EQUALS 102
#ASSERT `s 4AA(6) the amount worked out under subsection (3), rounded to the nearest whole dollar` 1.004 100 EQUALS 100
#ASSERT `s 4AA(6) the amount worked out under subsection (3), rounded to the nearest whole dollar` 1.001 330 EQUALS 330

§§ `Section 4AA(7): which index numbers are used`

#ASSERT `s 4AA(7) an index number is used in a calculation under subsection (4)` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 4AA(7) an index number is used in a calculation under subsection (4)` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 4AA(7) an index number is used in a calculation under subsection (4)` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 4AA(7) an index number is used in a calculation under subsection (4)` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 4AA(7) an index number is used in a calculation under subsection (4)` TRUE FALSE TRUE EQUALS JUST TRUE

§§ `Section 4AA(8): the increased amount applies only to later offences`

-- 1 July 2026, from $330 to $343.
#ASSERT `s 4AA(8) the increased amount applies to an offence` 330 343 (Date 30 6 2026) (Date 1 7 2026) EQUALS JUST FALSE
#ASSERT `s 4AA(8) the increased amount applies to an offence` 330 343 (Date 1 7 2026) (Date 1 7 2026) EQUALS JUST TRUE
#ASSERT `s 4AA(8) the increased amount applies to an offence` 330 343 (Date 2 7 2026) (Date 1 7 2026) EQUALS JUST TRUE
-- An amount that was not increased: the text says nothing.
#ASSERT `s 4AA(8) the increased amount applies to an offence` 330 330 (Date 30 6 2026) (Date 1 7 2026) EQUALS NOTHING
#ASSERT `s 4AA(8) the increased amount applies to an offence` 330 320 (Date 30 6 2026) (Date 1 7 2026) EQUALS NOTHING
-- Not an indexation day.
#ASSERT `s 4AA(8) the increased amount applies to an offence` 330 343 (Date 2 7 2026) (Date 1 7 2027) EQUALS NOTHING

#ASSERT `s 4AA(3), (8) the amount of a penalty unit for an offence` 330 343 (Date 30 6 2026) (Date 1 7 2026) EQUALS JUST 330
#ASSERT `s 4AA(3), (8) the amount of a penalty unit for an offence` 330 343 (Date 1 7 2026) (Date 1 7 2026) EQUALS JUST 343
#ASSERT `s 4AA(3), (8) the amount of a penalty unit for an offence` 330 343 (Date 1 1 2030) (Date 1 7 2026) EQUALS JUST 343
#ASSERT `s 4AA(3), (8) the amount of a penalty unit for an offence` 330 330 (Date 30 6 2026) (Date 1 7 2026) EQUALS JUST 330
#ASSERT `s 4AA(3), (8) the amount of a penalty unit for an offence` 330 320 (Date 30 6 2026) (Date 1 7 2026) EQUALS NOTHING
#ASSERT `s 4AA(3), (8) the amount of a penalty unit for an offence` 330 320 (Date 1 7 2026) (Date 1 7 2026) EQUALS JUST 320
#ASSERT `s 4AA(3), (8) the amount of a penalty unit for an offence` 330 343 (Date 30 6 2026) (Date 2 7 2026) EQUALS NOTHING

§§ `Section 4AB: conversion of pecuniary penalties expressed in dollar amounts`

#ASSERT `s 4AB(1) a reference to a pecuniary penalty of D dollars is taken to be a reference to a pecuniary penalty of P penalty units` TRUE EQUALS JUST TRUE
#ASSERT `s 4AB(1) a reference to a pecuniary penalty of D dollars is taken to be a reference to a pecuniary penalty of P penalty units` FALSE EQUALS NOTHING
-- D / 100 a whole number: that number. Otherwise the next highest whole number.
#ASSERT `s 4AB(1) P is` 0 EQUALS 0
#ASSERT `s 4AB(1) P is` 100 EQUALS 1
#ASSERT `s 4AB(1) P is` 200 EQUALS 2
#ASSERT `s 4AB(1) P is` 1 EQUALS 1
#ASSERT `s 4AB(1) P is` 50 EQUALS 1
#ASSERT `s 4AB(1) P is` 99 EQUALS 1
#ASSERT `s 4AB(1) P is` 101 EQUALS 2
#ASSERT `s 4AB(1) P is` 250 EQUALS 3
#ASSERT `s 4AB(1) P is` 1000 EQUALS 10
#ASSERT `s 4AB(1) P is` 1000.5 EQUALS 11

-- (2): a reference to the maximum amount of a penalty that is not imposed by a court or a service tribunal.
#ASSERT `s 4AB(2) subsection (1) applies` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 4AB(2) subsection (1) applies` TRUE TRUE EQUALS NOTHING
#ASSERT `s 4AB(2) subsection (1) applies` FALSE FALSE EQUALS NOTHING
-- (3): paragraphs (a) and (c).
#ASSERT `s 4AB(3) subsection (1) applies` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 4AB(3) subsection (1) applies` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 4AB(3) subsection (1) applies` FALSE FALSE EQUALS NOTHING
-- All the subsections together: the arguments are the reference is in a law of
-- the Commonwealth or a Territory Ordinance, the reference is to a maximum
-- amount, the penalty is imposed by a court or service tribunal, section 76 of
-- the Competition and Consumer Act 2010, a provision prescribed under (3).
#ASSERT `s 4AB the conversion of a penalty of D dollars to penalty units applies` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 4AB the conversion of a penalty of D dollars to penalty units applies` TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 4AB the conversion of a penalty of D dollars to penalty units applies` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 4AB the conversion of a penalty of D dollars to penalty units applies` TRUE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 4AB the conversion of a penalty of D dollars to penalty units applies` TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 4AB the conversion of a penalty of D dollars to penalty units applies` FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING

#ASSERT `s 4AB(4) a penalty includes` TRUE EQUALS JUST TRUE
#ASSERT `s 4AB(4) a penalty includes` FALSE EQUALS NOTHING
#ASSERT `s 4AB(4) Territory Ordinance has the same meaning as in section 4AA` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 4AB(4) Territory Ordinance has the same meaning as in section 4AA` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
