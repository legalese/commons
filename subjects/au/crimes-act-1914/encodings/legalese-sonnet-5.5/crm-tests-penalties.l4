IMPORT prelude
IMPORT daydate
IMPORT `crm-time`
IMPORT `crm-penalties`

-- Tests for crm-penalties.l4. Every expected value is written from the text
-- of ss 4B, 4D, 4E and 4F before the line was run; none is copied from output.

§ `Tests of the pecuniary penalties module`

§§ `Section 4B(1)`

#ASSERT `s 4B(1) a provision is deemed to refer to bodies corporate as well as to natural persons` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 4B(1) a provision is deemed to refer to bodies corporate as well as to natural persons` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 4B(1) a provision is deemed to refer to bodies corporate as well as to natural persons` FALSE FALSE EQUALS NOTHING

§§ `Section 4B(2) and (2A)`

-- The arguments: a natural person is convicted of an offence against a law of
-- the Commonwealth; the offence is punishable by imprisonment only; a contrary
-- intention appears; the court thinks it appropriate in all the circumstances.
#ASSERT `s 4B(2) the court may impose a pecuniary penalty instead of, or in addition to, imprisonment` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 4B(2) the court may impose a pecuniary penalty instead of, or in addition to, imprisonment` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 4B(2) the court may impose a pecuniary penalty instead of, or in addition to, imprisonment` TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 4B(2) the court may impose a pecuniary penalty instead of, or in addition to, imprisonment` FALSE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 4B(2) the court may impose a pecuniary penalty instead of, or in addition to, imprisonment` TRUE FALSE FALSE TRUE EQUALS JUST FALSE

-- Term of Imprisonment x 5, the term expressed in months.
#ASSERT `s 4B(2) the number of penalty units the pecuniary penalty may not exceed` TRUE TRUE FALSE TRUE (Months 12) EQUALS JUST 60
#ASSERT `s 4B(2) the number of penalty units the pecuniary penalty may not exceed` TRUE TRUE FALSE TRUE (Years 1) EQUALS JUST 60
#ASSERT `s 4B(2) the number of penalty units the pecuniary penalty may not exceed` TRUE TRUE FALSE TRUE (Months 6) EQUALS JUST 30
#ASSERT `s 4B(2) the number of penalty units the pecuniary penalty may not exceed` TRUE TRUE FALSE TRUE (Years 2) EQUALS JUST 120
#ASSERT `s 4B(2) the number of penalty units the pecuniary penalty may not exceed` TRUE TRUE FALSE TRUE (Years 10) EQUALS JUST 600
#ASSERT `s 4B(2) the number of penalty units the pecuniary penalty may not exceed` TRUE TRUE TRUE TRUE (Months 12) EQUALS NOTHING
#ASSERT `s 4B(2) the number of penalty units the pecuniary penalty may not exceed` TRUE TRUE FALSE FALSE (Months 12) EQUALS NOTHING
#ASSERT `s 4B(2) the number of penalty units the pecuniary penalty may not exceed` TRUE TRUE FALSE TRUE ForLife EQUALS NOTHING
#ASSERT `s 4B(2) the number of penalty units the pecuniary penalty may not exceed` TRUE TRUE FALSE TRUE NoImprisonment EQUALS NOTHING

-- The arguments: a natural person is convicted; a court may impose
-- imprisonment for life; a contrary intention appears; the court thinks it
-- appropriate.
#ASSERT `s 4B(2A) the court may impose a pecuniary penalty instead of, or in addition to, imprisonment for life` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 4B(2A) the court may impose a pecuniary penalty instead of, or in addition to, imprisonment for life` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 4B(2A) the court may impose a pecuniary penalty instead of, or in addition to, imprisonment for life` TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 4B(2A) the court may impose a pecuniary penalty instead of, or in addition to, imprisonment for life` TRUE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 4B(2A) the number of penalty units the pecuniary penalty may not exceed` TRUE TRUE FALSE TRUE EQUALS JUST 2000
#ASSERT `s 4B(2A) the number of penalty units the pecuniary penalty may not exceed` TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 4B(2A) the number of penalty units the pecuniary penalty may not exceed` FALSE TRUE FALSE TRUE EQUALS NOTHING

§§ `Section 4B(3) and (3A)`

#ASSERT `s 4B(3) the court may impose a pecuniary penalty on a body corporate` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 4B(3) the court may impose a pecuniary penalty on a body corporate` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 4B(3) the court may impose a pecuniary penalty on a body corporate` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 4B(3) the court may impose a pecuniary penalty on a body corporate` FALSE FALSE TRUE EQUALS JUST FALSE
-- 5 times the natural person's maximum.
#ASSERT `s 4B(3) the number of penalty units the pecuniary penalty on a body corporate may not exceed` TRUE FALSE TRUE 60 EQUALS JUST 300
#ASSERT `s 4B(3) the number of penalty units the pecuniary penalty on a body corporate may not exceed` TRUE FALSE TRUE 2000 EQUALS JUST 10000
#ASSERT `s 4B(3) the number of penalty units the pecuniary penalty on a body corporate may not exceed` TRUE FALSE TRUE 0 EQUALS JUST 0
#ASSERT `s 4B(3) the number of penalty units the pecuniary penalty on a body corporate may not exceed` TRUE TRUE TRUE 60 EQUALS NOTHING
#ASSERT `s 4B(3) the number of penalty units the pecuniary penalty on a body corporate may not exceed` TRUE FALSE FALSE 60 EQUALS NOTHING

-- The arguments: an Act confers power to make an instrument; the instrument
-- is a law of a Territory; the Act specifies the maximum pecuniary penalty; a
-- contrary intention appears.
#ASSERT `s 4B(3A)(a) the specified penalty is taken to be the maximum penalty that the instrument can prescribe for such offences by natural persons` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 4B(3A)(a) the specified penalty is taken to be the maximum penalty that the instrument can prescribe for such offences by natural persons` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 4B(3A)(a) the specified penalty is taken to be the maximum penalty that the instrument can prescribe for such offences by natural persons` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 4B(3A)(a) the specified penalty is taken to be the maximum penalty that the instrument can prescribe for such offences by natural persons` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 4B(3A)(a) the specified penalty is taken to be the maximum penalty that the instrument can prescribe for such offences by natural persons` FALSE FALSE TRUE FALSE EQUALS JUST FALSE
-- (b): the specifying of the penalty is not treated as an indication of a
-- contrary intention where a body corporate is convicted of such an offence.
#ASSERT `s 4B(3A)(b) the specifying of the penalty is treated as an indication of a contrary intention for the purposes of applying subsection (3)` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 4B(3A)(b) the specifying of the penalty is treated as an indication of a contrary intention for the purposes of applying subsection (3)` TRUE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 4B(3A)(b) the specifying of the penalty is treated as an indication of a contrary intention for the purposes of applying subsection (3)` TRUE TRUE TRUE TRUE EQUALS NOTHING

§§ `Section 4B(4)`

#ASSERT `s 4B(4) the forfeiture, penalty or reparation is payable to the body corporate` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 4B(4) the forfeiture, penalty or reparation is payable to the body corporate` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 4B(4) the forfeiture, penalty or reparation is payable to the body corporate` FALSE TRUE EQUALS JUST FALSE

§§ `Section 4D: penalties at the foot of a provision`

-- The four positions: foot of a section; foot of a subsection; foot of a
-- clause of a Schedule; foot of a subclause. A penalty at the foot of a
-- subsection that is also at the foot of the section containing it is at the
-- foot of a section, so the first field is true for it.
#ASSERT `s 4D(1A) subsection (1) applies to a penalty set out` (FootPosition OF TRUE, FALSE, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `s 4D(1A) subsection (1) applies to a penalty set out` (FootPosition OF FALSE, TRUE, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `s 4D(1A) subsection (1) applies to a penalty set out` (FootPosition OF TRUE, TRUE, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `s 4D(1A) subsection (1) applies to a penalty set out` (FootPosition OF FALSE, FALSE, TRUE, FALSE) EQUALS JUST TRUE
#ASSERT `s 4D(1A) subsection (1) applies to a penalty set out` (FootPosition OF FALSE, FALSE, FALSE, TRUE) EQUALS JUST TRUE
#ASSERT `s 4D(1A) subsection (1) applies to a penalty set out` (FootPosition OF FALSE, FALSE, TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `s 4D(1A) subsection (1) applies to a penalty set out` (FootPosition OF FALSE, FALSE, FALSE, FALSE) EQUALS NOTHING

-- The arguments: the position; the provision expressly creates an offence;
-- a contrary intention appears.
#ASSERT `s 4D(1)(a) the offence is punishable on conviction by a penalty not exceeding the penalty so set out` (FootPosition OF TRUE, FALSE, FALSE, FALSE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 4D(1)(a) the offence is punishable on conviction by a penalty not exceeding the penalty so set out` (FootPosition OF TRUE, FALSE, FALSE, FALSE) FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 4D(1)(a) the offence is punishable on conviction by a penalty not exceeding the penalty so set out` (FootPosition OF TRUE, FALSE, FALSE, FALSE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 4D(1)(a) the offence is punishable on conviction by a penalty not exceeding the penalty so set out` (FootPosition OF TRUE, TRUE, FALSE, FALSE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 4D(1)(a) the offence is punishable on conviction by a penalty not exceeding the penalty so set out` (FootPosition OF FALSE, FALSE, FALSE, FALSE) TRUE FALSE EQUALS NOTHING
#ASSERT `s 4D(1)(b) contravention of the provision is an offence against the provision, punishable on conviction by a penalty not exceeding the penalty so set out` (FootPosition OF TRUE, FALSE, FALSE, FALSE) FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 4D(1)(b) contravention of the provision is an offence against the provision, punishable on conviction by a penalty not exceeding the penalty so set out` (FootPosition OF TRUE, FALSE, FALSE, FALSE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 4D(1)(b) contravention of the provision is an offence against the provision, punishable on conviction by a penalty not exceeding the penalty so set out` (FootPosition OF TRUE, FALSE, FALSE, FALSE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 4D(1)(b) contravention of the provision is an offence against the provision, punishable on conviction by a penalty not exceeding the penalty so set out` (FootPosition OF FALSE, FALSE, FALSE, FALSE) FALSE FALSE EQUALS NOTHING

#ASSERT `s 4D(1) a penalty is not exceeding the penalty so set out` 10 10 EQUALS TRUE
#ASSERT `s 4D(1) a penalty is not exceeding the penalty so set out` 0 10 EQUALS TRUE
#ASSERT `s 4D(1) a penalty is not exceeding the penalty so set out` 11 10 EQUALS FALSE

#ASSERT `s 4D(1B) subsection (1) affects the operation of` `subsection 4B(2)` EQUALS JUST FALSE
#ASSERT `s 4D(1B) subsection (1) affects the operation of` `subsection 4B(2A)` EQUALS JUST FALSE
#ASSERT `s 4D(1B) subsection (1) affects the operation of` `subsection 4B(3)` EQUALS JUST FALSE
#ASSERT `s 4D(1B) subsection (1) affects the operation of` `another provision` EQUALS NOTHING

#ASSERT `s 4D(2) subsection (1) applies to the instrument` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 4D(2) subsection (1) applies to the instrument` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 4D(2) subsection (1) applies to the instrument` FALSE FALSE EQUALS NOTHING
#ASSERT `s 4D(2) subsection (1) applies to the instrument` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 4D(2) the rule, regulation or by-law is treated as a section of an Act` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 4D(2) the rule, regulation or by-law is treated as a section of an Act` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 4D(2) the rule, regulation or by-law is treated as a section of an Act` FALSE FALSE EQUALS NOTHING

§§ `Section 4E`

-- The arguments: a pecuniary penalty for an offence against a law of the
-- Commonwealth; a court of summary jurisdiction; a contrary intention appears.
#ASSERT `s 4E the pecuniary penalty may be recovered in the court` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 4E the pecuniary penalty may be recovered in the court` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 4E the pecuniary penalty may be recovered in the court` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 4E the pecuniary penalty may be recovered in the court` FALSE TRUE FALSE EQUALS NOTHING

§§ `Section 4F: effect of alterations in penalties`

-- The arguments: a provision increases the penalty; the day of the offence;
-- the day of commencement.
#ASSERT `s 4F(1) the penalty or maximum penalty as increased applies to the offence` TRUE (Date 2 1 2027) (Date 1 1 2027) EQUALS JUST TRUE
#ASSERT `s 4F(1) the penalty or maximum penalty as increased applies to the offence` TRUE (Date 31 12 2026) (Date 1 1 2027) EQUALS JUST FALSE
#ASSERT `s 4F(1) the penalty or maximum penalty as increased applies to the offence` TRUE (Date 1 1 2027) (Date 1 1 2027) EQUALS NOTHING
#ASSERT `s 4F(1) the penalty or maximum penalty as increased applies to the offence` FALSE (Date 2 1 2027) (Date 1 1 2027) EQUALS JUST FALSE
#ASSERT `s 4F(2) the penalty or maximum penalty as reduced extends to an offence committed before the commencement` TRUE (Date 31 12 2026) (Date 1 1 2027) EQUALS JUST TRUE
#ASSERT `s 4F(2) the penalty or maximum penalty as reduced extends to an offence committed before the commencement` TRUE (Date 2 1 2027) (Date 1 1 2027) EQUALS NOTHING
#ASSERT `s 4F(2) the penalty or maximum penalty as reduced extends to an offence committed before the commencement` TRUE (Date 1 1 2027) (Date 1 1 2027) EQUALS NOTHING
#ASSERT `s 4F(2) the penalty or maximum penalty as reduced extends to an offence committed before the commencement` FALSE (Date 31 12 2026) (Date 1 1 2027) EQUALS JUST FALSE
#ASSERT `s 4F(2) the reduction affects a penalty imposed before the commencement` TRUE (Date 31 12 2026) (Date 1 1 2027) EQUALS JUST FALSE
#ASSERT `s 4F(2) the reduction affects a penalty imposed before the commencement` TRUE (Date 2 1 2027) (Date 1 1 2027) EQUALS NOTHING
#ASSERT `s 4F(2) the reduction affects a penalty imposed before the commencement` TRUE (Date 1 1 2027) (Date 1 1 2027) EQUALS NOTHING
#ASSERT `s 4F(2) the reduction affects a penalty imposed before the commencement` FALSE (Date 31 12 2026) (Date 1 1 2027) EQUALS NOTHING
