IMPORT prelude

-- Crimes Act 1914 (Commonwealth) -- the provision index of the in-scope text.
-- Generated by work/gen_index.py from the text file: one entry for each
-- section of the in-scope text (section 3, which is in scope for the terms the
-- in-scope sections use, and sections 4A to 4N) and for the Part that holds
-- them. The identifier and the heading are as the text prints them, except
-- that the non-breaking space the text prints in "Part IA" is a plain space.
-- The lines each entry covers are the lines of the text file.

DECLARE ProvisionKind IS ONE OF
    Part
    Section

DECLARE Provision HAS
    `kind` IS A ProvisionKind
    `identifier as printed` IS A STRING
    `heading as printed` IS A STRING
    `first line of the text` IS A NUMBER
    `last line of the text` IS A NUMBER
    `subsections as printed` IS A LIST OF STRING

§ `Provision index of the in-scope text`


§§ `The entries`

GIVETH A LIST OF Provision
`the provision index` MEANS
    LIST
    (Provision OF Part, "Part I", "Preliminary", 37, 200, (LIST)),
    (Provision OF Part, "Part IA", "General", 4285, 4456, (LIST)),
    (Provision OF Section, "3", "Interpretation", 40, 200, (LIST "(1)", "(2)", "(3)")),
    (Provision OF Section, "4A", "Meaning of certain words", 4332, 4335, (LIST)),
    (Provision OF Section, "4AA", "Penalty units", 4336, 4359, (LIST "(1)", "(1A)", "(2)", "(3)", "(4)", "(5)", "(6)", "(7)", "(8)")),
    (Provision OF Section, "4AB", "Conversion of pecuniary penalties expressed in dollar amounts to penalty units", 4360, 4370, (LIST "(1)", "(2)", "(3)", "(4)")),
    (Provision OF Section, "4B", "Pecuniary penalties—natural persons and bodies corporate", 4371, 4381, (LIST "(1)", "(2)", "(2A)", "(3)", "(3A)", "(4)")),
    (Provision OF Section, "4C", "Offences under 2 or more laws", 4382, 4391, (LIST "(1)", "(2)", "(3)")),
    (Provision OF Section, "4D", "Penalties", 4392, 4402, (LIST "(1)", "(1A)", "(1B)", "(2)")),
    (Provision OF Section, "4E", "Pecuniary penalties", 4403, 4404, (LIST)),
    (Provision OF Section, "4F", "Effect of alterations in penalties", 4405, 4407, (LIST "(1)", "(2)")),
    (Provision OF Section, "4G", "Indictable offences", 4408, 4409, (LIST)),
    (Provision OF Section, "4H", "Summary offences", 4410, 4414, (LIST)),
    (Provision OF Section, "4J", "Certain indictable offences may be dealt with summarily", 4415, 4431, (LIST "(1)", "(2)", "(3)", "(4)", "(5)", "(6)", "(7)")),
    (Provision OF Section, "4JA", "Some indictable offences punishable by fine only may be dealt with summarily", 4432, 4444, (LIST "(1)", "(2)", "(3)", "(4)")),
    (Provision OF Section, "4K", "Continuing and multiple offences", 4445, 4449, (LIST "(1)", "(2)", "(3)", "(4)")),
    (Provision OF Section, "4L", "Specified defences not to preclude other defences", 4450, 4451, (LIST)),
    (Provision OF Section, "4M", "Children under 10", 4452, 4453, (LIST)),
    (Provision OF Section, "4N", "Children over 10 but under 14", 4454, 4456, (LIST "(1)", "(2)"))

-- A lookup by identifier. NOTHING where the index has no such identifier.
GIVEN `the identifier` IS A STRING
GIVETH A MAYBE Provision
DECIDE `the provision with the identifier` IS
    `find the provision` `the identifier` `the provision index`

GIVEN `the identifier` IS A STRING
      `the entries left to look at` IS A LIST OF Provision
GIVETH A MAYBE Provision
DECIDE `find the provision` IS
    CONSIDER `the entries left to look at`
    WHEN EMPTY THEN NOTHING
    WHEN p FOLLOWED BY rest THEN IF p's `identifier as printed` EQUALS `the identifier` THEN JUST p ELSE `find the provision` `the identifier` rest

GIVEN `the identifier` IS A STRING
GIVETH A MAYBE STRING
DECIDE `the heading as printed of the provision with the identifier` IS
    CONSIDER `the provision with the identifier` `the identifier`
    WHEN NOTHING THEN NOTHING
    WHEN JUST p THEN JUST (p's `heading as printed`)

GIVEN `the label` IS A STRING
      `the labels left to look at` IS A LIST OF STRING
GIVETH A BOOLEAN
DECIDE `a label is printed among` IF
    CONSIDER `the labels left to look at`
    WHEN EMPTY THEN FALSE
    WHEN x FOLLOWED BY rest THEN x EQUALS `the label` OR `a label is printed among` `the label` rest

GIVEN `the identifier` IS A STRING
      `the label` IS A STRING
GIVETH A BOOLEAN
DECIDE `the provision prints the subsection` IF
    CONSIDER `the provision with the identifier` `the identifier`
    WHEN NOTHING THEN FALSE
    WHEN JUST p THEN `a label is printed among` `the label` (p's `subsections as printed`)
