IMPORT prelude
IMPORT `crm-provisions`

-- Crimes Act 1914 (Commonwealth) -- the cross-references of the in-scope text.
-- Generated by work/gen_index.py from the text file: one row for each
-- reference, with the provision that cites, the words of the citation as the
-- text prints them (a non-breaking space is shown as a plain space), the
-- identifier cited, and the heading the text prints for the cited section.
-- A reference to another Act or instrument is a row of its own kind and is not
-- resolved here. Each row quotes the line that holds the citation.

DECLARE CrossReference HAS
    `row` IS A STRING
    `citing provision` IS A STRING
    `words as printed` IS A STRING
    `kind of reference` IS A STRING
    `identifier cited` IS A STRING
    `section cited` IS A STRING
    `subsection cited` IS A STRING
    `instrument cited` IS A STRING
    `heading of the cited section as printed` IS A STRING

§ `Cross-reference rows of the in-scope text`

-- src:52 | child: without limiting who is a child of a person for the purposes of this Act, someone is the child of a person if he or she is a child of the person within the meaning of the Family Law Act 1975.
@ref xref X001 3(1) cites Family Law Act 1975 (src:52)
GIVETH A CrossReference
`row X001` MEANS CrossReference OF "X001", "3(1)", "Family Law Act 1975", "another instrument", "", "", "", "Family Law Act 1975", ""

-- src:191 | (i) under Division 3 of Part XIII of the Customs Act 1901; or
@ref xref X002 3(2)(a)(i) cites Division 3 of Part XIII (src:191)
GIVETH A CrossReference
`row X002` MEANS CrossReference OF "X002", "3(2)(a)(i)", "Division 3 of Part XIII of the Customs Act 1901", "a provision of another instrument", "Division 3 of Part XIII", "", "", "Customs Act 1901", ""

