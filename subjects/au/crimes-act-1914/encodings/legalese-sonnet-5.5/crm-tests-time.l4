#ASSERT `the number of days in respect of each of which an offence is committed` (Date 28 2 2025) (Date 1 3 2025) EQUALS JUST 2

§§ `The ages of children (ss 4M, 4N)`

#ASSERT `s 4M the age below which a child cannot be liable, in years` EQUALS 10
#ASSERT `s 4N(1) the age from which a child can be liable, in years` EQUALS 10
#ASSERT `s 4N(1) the age below which a child can only be liable if the child knows the conduct is wrong, in years` EQUALS 14
-- The day before the tenth birthday, the birthday, the day after.
#ASSERT `the age in completed years` (Date 1 1 2016) (Date 31 12 2025) EQUALS JUST 9
#ASSERT `the age in completed years` (Date 1 1 2016) (Date 1 1 2026) EQUALS JUST 10
#ASSERT `the age in completed years` (Date 1 1 2016) (Date 2 1 2026) EQUALS JUST 10
-- The day before the fourteenth birthday, the birthday, the day after.
#ASSERT `the age in completed years` (Date 1 1 2016) (Date 31 12 2029) EQUALS JUST 13
#ASSERT `the age in completed years` (Date 1 1 2016) (Date 1 1 2030) EQUALS JUST 14
#ASSERT `the age in completed years` (Date 1 1 2016) (Date 2 1 2030) EQUALS JUST 14
-- The day of birth, and a day before it.
#ASSERT `the age in completed years` (Date 1 1 2016) (Date 1 1 2016) EQUALS JUST 0
#ASSERT `the age in completed years` (Date 1 1 2016) (Date 31 12 2015) EQUALS NOTHING
-- A birthday on the last day of a month, and on a 29 February.
#ASSERT `the age in completed years` (Date 31 1 2016) (Date 28 2 2026) EQUALS JUST 10
#ASSERT `the age in completed years` (Date 31 1 2016) (Date 30 1 2026) EQUALS JUST 9
#ASSERT `the age in completed years` (Date 29 2 2016) (Date 27 2 2026) EQUALS JUST 9
#ASSERT `the age in completed years` (Date 29 2 2016) (Date 28 2 2026) EQUALS NOTHING
#ASSERT `the age in completed years` (Date 29 2 2016) (Date 1 3 2026) EQUALS JUST 10
#ASSERT `the age in completed years` (Date 29 2 2016) (Date 28 2 2024) EQUALS JUST 7
#ASSERT `the age in completed years` (Date 29 2 2016) (Date 29 2 2024) EQUALS JUST 8
#ASSERT `the age in completed years` (Date 29 2 2016) (Date 1 3 2024) EQUALS JUST 8

-- s 4K(4): counting offences and summing their separate maxima
#ASSERT `the number of offences counted` (LIST) EQUALS 0
#ASSERT `the number of offences counted` (LIST 10) EQUALS 1
#ASSERT `the number of offences counted` (LIST 10, 20, 30) EQUALS 3
#ASSERT `the sum of the maximum penalties of 2 or more offences` (LIST) EQUALS NOTHING
#ASSERT `the sum of the maximum penalties of 2 or more offences` (LIST 10) EQUALS NOTHING
#ASSERT `the sum of the maximum penalties of 2 or more offences` (LIST 10, 20) EQUALS JUST 30
#ASSERT `the sum of the maximum penalties of 2 or more offences` (LIST 10, 20, 30) EQUALS JUST 60
#ASSERT `the sum of the maximum penalties of 2 or more offences` (LIST 60, 120, 0) EQUALS JUST 180
