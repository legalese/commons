IMPORT prelude
IMPORT daydate
IMPORT `crm-time`

-- Tests for crm-time.l4. Every expected value is written from the text
-- of ss 3(1), 4AA to 4N before the line was run; none is copied from output.

§ `Tests of the time module`

§§ `Terms of imprisonment (ss 4B(2), 4G, 4H, 4J)`

-- s 4B(2): "expressed in months"; the text defines neither a year nor a month,
-- so a year is taken as 12 months (NOTES.md, fork F1).
#ASSERT `the term of imprisonment expressed in months` (Months 12) EQUALS JUST 12
#ASSERT `the term of imprisonment expressed in months` (Months 1) EQUALS JUST 1
#ASSERT `the term of imprisonment expressed in months` (Months 0) EQUALS NOTHING
#ASSERT `the term of imprisonment expressed in months` (Years 1) EQUALS JUST 12
#ASSERT `the term of imprisonment expressed in months` (Years 5) EQUALS JUST 60
#ASSERT `the term of imprisonment expressed in months` (Years 10) EQUALS JUST 120
#ASSERT `the term of imprisonment expressed in months` (Years 0) EQUALS NOTHING
#ASSERT `the term of imprisonment expressed in months` ForLife EQUALS NOTHING
#ASSERT `the term of imprisonment expressed in months` NoImprisonment EQUALS NOTHING
#ASSERT `the number of months in a year` EQUALS 12
#ASSERT `the number of months in 12 months` EQUALS 12
#ASSERT `the number of months in 5 years` EQUALS 60
#ASSERT `the number of months in 10 years` EQUALS 120

-- The three thresholds, the day before / the day itself / the day after
-- (here: the month before, the month itself, the month after).
#ASSERT `the band of a term of imprisonment` (Months 11) EQUALS JUST `12 months or less`
#ASSERT `the band of a term of imprisonment` (Months 12) EQUALS JUST `12 months or less`
#ASSERT `the band of a term of imprisonment` (Months 13) EQUALS JUST `more than 12 months but not more than 5 years`
#ASSERT `the band of a term of imprisonment` (Months 12.5) EQUALS JUST `more than 12 months but not more than 5 years`
#ASSERT `the band of a term of imprisonment` (Months 59) EQUALS JUST `more than 12 months but not more than 5 years`
#ASSERT `the band of a term of imprisonment` (Months 60) EQUALS JUST `more than 12 months but not more than 5 years`
#ASSERT `the band of a term of imprisonment` (Months 61) EQUALS JUST `more than 5 years but not more than 10 years`
#ASSERT `the band of a term of imprisonment` (Months 119) EQUALS JUST `more than 5 years but not more than 10 years`
#ASSERT `the band of a term of imprisonment` (Months 120) EQUALS JUST `more than 5 years but not more than 10 years`
#ASSERT `the band of a term of imprisonment` (Months 121) EQUALS JUST `more than 10 years`
#ASSERT `the band of a term of imprisonment` (Years 1) EQUALS JUST `12 months or less`
#ASSERT `the band of a term of imprisonment` (Years 2) EQUALS JUST `more than 12 months but not more than 5 years`
#ASSERT `the band of a term of imprisonment` (Years 5) EQUALS JUST `more than 12 months but not more than 5 years`
#ASSERT `the band of a term of imprisonment` (Years 6) EQUALS JUST `more than 5 years but not more than 10 years`
#ASSERT `the band of a term of imprisonment` (Years 10) EQUALS JUST `more than 5 years but not more than 10 years`
#ASSERT `the band of a term of imprisonment` (Years 11) EQUALS JUST `more than 10 years`
#ASSERT `the band of a term of imprisonment` NoImprisonment EQUALS JUST `not punishable by imprisonment`
#ASSERT `the band of a term of imprisonment` ForLife EQUALS NOTHING
#ASSERT `the band of a term of imprisonment` (Months 0) EQUALS NOTHING

§§ `The indexation day (s 4AA(3))`

#ASSERT `the first indexation day` EQUALS Date 1 7 2026
#ASSERT `the number of years from one indexation day to the next` EQUALS 3
#ASSERT `the indexation day numbered` 0 EQUALS Date 1 7 2026
#ASSERT `the indexation day numbered` 1 EQUALS Date 1 7 2029
#ASSERT `the indexation day numbered` 2 EQUALS Date 1 7 2032
#ASSERT `the indexation day numbered` 3 EQUALS Date 1 7 2035
#ASSERT NOT (`a day is an indexation day` (Date 30 6 2026))
#ASSERT `a day is an indexation day` (Date 1 7 2026)
#ASSERT NOT (`a day is an indexation day` (Date 2 7 2026))
#ASSERT NOT (`a day is an indexation day` (Date 1 7 2025))
#ASSERT NOT (`a day is an indexation day` (Date 1 7 2027))
#ASSERT NOT (`a day is an indexation day` (Date 1 7 2028))
#ASSERT NOT (`a day is an indexation day` (Date 30 6 2029))
#ASSERT `a day is an indexation day` (Date 1 7 2029)
#ASSERT NOT (`a day is an indexation day` (Date 2 7 2029))
#ASSERT `a day is an indexation day` (Date 1 7 2032)
#ASSERT `a day is an indexation day` (Date 1 7 2035)
#ASSERT NOT (`a day is an indexation day` (Date 1 8 2029))
#ASSERT NOT (`a day is an indexation day` (Date 1 1 2029))
#ASSERT `the number of indexation days on or before` (Date 1 7 2025) EQUALS 0
#ASSERT `the number of indexation days on or before` (Date 30 6 2026) EQUALS 0
#ASSERT `the number of indexation days on or before` (Date 1 7 2026) EQUALS 1
#ASSERT `the number of indexation days on or before` (Date 2 7 2026) EQUALS 1
#ASSERT `the number of indexation days on or before` (Date 31 12 2028) EQUALS 1
#ASSERT `the number of indexation days on or before` (Date 30 6 2029) EQUALS 1
#ASSERT `the number of indexation days on or before` (Date 1 7 2029) EQUALS 2
#ASSERT `the number of indexation days on or before` (Date 2 1 2030) EQUALS 2
#ASSERT `the number of indexation days on or before` (Date 30 6 2035) EQUALS 3
#ASSERT `the number of indexation days on or before` (Date 1 7 2035) EQUALS 4

§§ `Quarters, the reference quarter and the base quarter (ss 3(1) and 4AA(4))`

#ASSERT `a quarter ends on` (Date 31 3 2026)
#ASSERT `a quarter ends on` (Date 30 6 2026)
#ASSERT `a quarter ends on` (Date 30 9 2026)
#ASSERT `a quarter ends on` (Date 31 12 2026)
#ASSERT NOT (`a quarter ends on` (Date 30 3 2026))
#ASSERT NOT (`a quarter ends on` (Date 1 4 2026))
#ASSERT NOT (`a quarter ends on` (Date 31 7 2026))
#ASSERT NOT (`a quarter ends on` (Date 29 6 2026))
#ASSERT NOT (`a quarter ends on` (Date 1 7 2026))
#ASSERT NOT (`a quarter ends on` (Date 28 2 2026))
#ASSERT `the first day of the quarter ending on` (Date 31 3 2026) EQUALS JUST (Date 1 1 2026)
#ASSERT `the first day of the quarter ending on` (Date 30 6 2026) EQUALS JUST (Date 1 4 2026)
#ASSERT `the first day of the quarter ending on` (Date 30 9 2026) EQUALS JUST (Date 1 7 2026)
#ASSERT `the first day of the quarter ending on` (Date 31 12 2026) EQUALS JUST (Date 1 10 2026)
#ASSERT `the first day of the quarter ending on` (Date 30 3 2026) EQUALS NOTHING
#ASSERT `a March quarter ends on` (Date 31 3 2026)
#ASSERT NOT (`a March quarter ends on` (Date 30 3 2026))
#ASSERT NOT (`a March quarter ends on` (Date 1 4 2026))
#ASSERT NOT (`a March quarter ends on` (Date 30 6 2026))
#ASSERT `the day on which the reference quarter ends` (Date 1 7 2026) EQUALS Date 31 3 2026
#ASSERT `the day on which the reference quarter ends` (Date 1 7 2029) EQUALS Date 31 3 2029
#ASSERT `the day on which the reference quarter ends` (Date 1 7 2032) EQUALS Date 31 3 2032
-- "immediately before the indexation day": on 31 March the quarter ending
-- that day has not yet ended; on 1 April it has.
#ASSERT `the day on which the reference quarter ends` (Date 31 3 2026) EQUALS Date 31 3 2025
#ASSERT `the day on which the reference quarter ends` (Date 1 4 2026) EQUALS Date 31 3 2026
#ASSERT `the day on which the base quarter ends` (Date 1 7 2026) EQUALS Date 31 3 2023
#ASSERT `the day on which the base quarter ends` (Date 1 7 2029) EQUALS Date 31 3 2026
#ASSERT `the day on which the base quarter ends` (Date 1 7 2032) EQUALS Date 31 3 2029

§§ `The indexation factor and the indexed amount (s 4AA(3) to (6))`

-- (5): 3 decimal places, "rounding up if the fourth decimal place is 5 or more".
#ASSERT `an indexation factor calculated to 3 decimal places` 1.0344 EQUALS 1.034
#ASSERT `an indexation factor calculated to 3 decimal places` 1.0345 EQUALS 1.035
#ASSERT `an indexation factor calculated to 3 decimal places` 1.0346 EQUALS 1.035
#ASSERT `an indexation factor calculated to 3 decimal places` 1.03449 EQUALS 1.034
#ASSERT `an indexation factor calculated to 3 decimal places` 1.0005 EQUALS 1.001
#ASSERT `an indexation factor calculated to 3 decimal places` 1.0004 EQUALS 1
#ASSERT `an indexation factor calculated to 3 decimal places` 1 EQUALS 1
#ASSERT `an indexation factor calculated to 3 decimal places` 0.9995 EQUALS 1
#ASSERT `an indexation factor calculated to 3 decimal places` 0.9994 EQUALS 0.999
#ASSERT `the indexation factor for an indexation day` 130 125 EQUALS JUST 1.04
#ASSERT `the indexation factor for an indexation day` 103.45 100 EQUALS JUST 1.035
#ASSERT `the indexation factor for an indexation day` 103.44 100 EQUALS JUST 1.034
#ASSERT `the indexation factor for an indexation day` 100 100 EQUALS JUST 1
#ASSERT `the indexation factor for an indexation day` 99 100 EQUALS JUST 0.99
#ASSERT `the indexation factor for an indexation day` 100 0 EQUALS NOTHING
-- (3) and (6): the amount is rounded to the nearest whole dollar, 50 cents upwards.
#ASSERT `the dollar amount after an indexation, to the nearest whole dollar` 1.035 330 EQUALS 342
#ASSERT `the dollar amount after an indexation, to the nearest whole dollar` 1.05 330 EQUALS 347
#ASSERT `the dollar amount after an indexation, to the nearest whole dollar` 1.04 330 EQUALS 343
#ASSERT `the dollar amount after an indexation, to the nearest whole dollar` 1.0015 330 EQUALS 330
#ASSERT `the dollar amount after an indexation, to the nearest whole dollar` 1.03 450 EQUALS 464
#ASSERT `the dollar amount after an indexation, to the nearest whole dollar` 1.001 500 EQUALS 501
#ASSERT `the dollar amount after an indexation, to the nearest whole dollar` 1 330 EQUALS 330
#ASSERT `the dollar amount after an indexation, to the nearest whole dollar` 0.99 330 EQUALS 327
#ASSERT `the amount of a penalty unit before any indexation, in dollars` EQUALS 330

§§ `Offences on or after the indexation day, and the day of commencement (ss 4AA(8), 4F)`

#ASSERT NOT (`an offence was committed on or after the indexation day` (Date 30 6 2026) (Date 1 7 2026))
#ASSERT `an offence was committed on or after the indexation day` (Date 1 7 2026) (Date 1 7 2026)
#ASSERT `an offence was committed on or after the indexation day` (Date 2 7 2026) (Date 1 7 2026)
#ASSERT `an offence was committed after the commencement` (Date 31 12 2026) (Date 1 1 2027) EQUALS JUST FALSE
#ASSERT `an offence was committed after the commencement` (Date 1 1 2027) (Date 1 1 2027) EQUALS NOTHING
#ASSERT `an offence was committed after the commencement` (Date 2 1 2027) (Date 1 1 2027) EQUALS JUST TRUE
#ASSERT `an offence was committed before the commencement` (Date 31 12 2026) (Date 1 1 2027) EQUALS JUST TRUE
#ASSERT `an offence was committed before the commencement` (Date 1 1 2027) (Date 1 1 2027) EQUALS NOTHING
#ASSERT `an offence was committed before the commencement` (Date 2 1 2027) (Date 1 1 2027) EQUALS JUST FALSE
#ASSERT `a penalty was imposed before the commencement` (Date 31 12 2026) (Date 1 1 2027) EQUALS JUST TRUE
#ASSERT `a penalty was imposed before the commencement` (Date 1 1 2027) (Date 1 1 2027) EQUALS NOTHING
#ASSERT `a penalty was imposed before the commencement` (Date 2 1 2027) (Date 1 1 2027) EQUALS JUST FALSE

