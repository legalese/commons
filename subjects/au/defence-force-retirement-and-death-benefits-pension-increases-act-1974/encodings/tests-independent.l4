IMPORT prelude
IMPORT daydate
IMPORT `dfrdb74-rules`

-- Independent tests, written from BRIEF.md and the Act before reading the rules.
-- See independent-expectations.md for the working. Index figures are hypothetical.

GIVEN ia IS A NUMBER
      ib IS A NUMBER
      ic IS A NUMBER
      id IS A NUMBER
GIVETH A NUMBER
`pct` ia ib ic id MEANS
    `the prescribed percentage for`
        (`Pension 1974` OF ia, ib, ic, id, `a DFRB pension under s 8`, 0, 0, (Date 1 7 1973))

GIVEN k IS A `Increase case 1974`
      p74 IS A NUMBER
      p73 IS A NUMBER
      st IS A DATE
GIVETH A NUMBER
`inc15` k p74 p73 st MEANS
    `my 1974 increase for` (`Pension 1974` OF 120, 100, 115, 100, k, p74, p73, st)

-- s 3: prescribed percentage
#ASSERT `pct` 120 100 115 100 EQUALS 15
#ASSERT `pct` 104 100 110 100 EQUALS 5.6
#ASSERT `pct` 120 100 104.25 100 EQUALS 4.3
#ASSERT `pct` 120 100 104.24 100 EQUALS 4.2
#ASSERT `pct` 120 100 104.26 100 EQUALS 4.3
#ASSERT `pct` 103.03 100 110 100 EQUALS 4.2

-- ss 7, 16: gate
#ASSERT `my 1974 increase for` (`Pension 1974` OF 100, 100, 115, 100, `a DFRB pension under s 8`, 2000, 1800, (Date 1 7 1973)) EQUALS 0
#ASSERT `my 1974 increase for` (`Pension 1974` OF 120, 100, 100, 100, `a DFRDB pension benefit under s 17`, 1400, 0, (Date 1 7 1973)) EQUALS 0
#ASSERT `inc15` `a child's DFRB pension` 2000 1800 (Date 1 7 1973) EQUALS 0

-- s 8
#ASSERT `inc15` `a DFRB pension under s 8` 2000 1800 (Date 1 7 1973) EQUALS 239.25
#ASSERT `my 1974 increase for` (`Pension 1974` OF 120, 100, 104.25, 100, `a DFRB pension under s 8`, 2000, 1800, (Date 1 7 1973)) EQUALS 68.585

-- s 9: months to 30 June 1974
#ASSERT `inc15` `a DFRB s 82ZB pension under s 9` 1200 0 (Date 1 7 1973) EQUALS 139.5
#ASSERT `inc15` `a DFRB s 82ZB pension under s 9` 1200 0 (Date 1 1 1974) EQUALS 69.75
#ASSERT `inc15` `a DFRB s 82ZB pension under s 9` 1200 0 (Date 16 1 1974) EQUALS 69.75
#ASSERT `inc15` `a DFRB s 82ZB pension under s 9` 1200 0 (Date 17 1 1974) EQUALS 58.125
#ASSERT `inc15` `a DFRB s 82ZB pension under s 9` 1200 0 (Date 15 6 1974) EQUALS 11.625
-- s 9(1): not a pension that became payable after 15 June 1974
#ASSERT `inc15` `a DFRB s 82ZB pension under s 9` 1200 0 (Date 16 6 1974) EQUALS 0

-- s 17
#ASSERT `inc15` `a DFRDB pension benefit under s 17` 1400 0 (Date 1 7 1973) EQUALS 150.003
-- child's pension: the additional pension is the input
#ASSERT `inc15` `a DFRDB pension benefit under s 17` 500 0 (Date 1 7 1973) EQUALS 53.5725

-- s 18: period from the day after retirement or death
#ASSERT `inc15` `a DFRDB pension benefit under s 18` 1400 0 (Date 1 1 1974) EQUALS 75.0015
#ASSERT `inc15` `a DFRDB pension benefit under s 18` 1400 0 (Date 2 7 1973) EQUALS 150.003
#ASSERT `inc15` `a DFRDB pension benefit under s 18` 1400 0 (Date 15 6 1974) EQUALS 12.50025
-- s 18(1)(b): s 78 benefit from the day payable
#ASSERT `inc15` `a DFRDB pension benefit under s 18` 1400 0 (Date 1 3 1974) EQUALS 50.001
#ASSERT `inc15` `a DFRDB pension benefit under s 18` 500 0 (Date 1 1 1974) EQUALS 26.78625
-- s 18(1): benefit payable after 15 June 1974 is outside s 18 (s 78 benefit from 20 June)
#ASSERT `inc15` `a DFRDB pension benefit under s 18` 1400 0 (Date 20 6 1974) EQUALS 0
