IMPORT prelude
IMPORT `fpc-rules`

-- Independent tests: expected values from independent-expectations.md.

GIVEN r IS A `Route`
      w IS A `Who I am`
      f IS A `Forum`
      k IS A NUMBER
      pr IS A NUMBER
      won IS A BOOLEAN
      app IS A BOOLEAN
      nt IS A BOOLEAN
GIVETH A `Costs position`
`pos` r w f k pr won app nt MEANS
  `the costs position for` (`Costs case` OF r, w, f, k, pr, won, app, nt)

DECIDE `r6` IS `respondent to a Federal appeal that succeeded on a question of law or on damages`
DECIDE `r7` IS `appellant whose respondent cannot pay, would suffer undue hardship, or cannot be found`
DECIDE `r7A` IS `appellant with no respondent, the appeal succeeding on a question of law`
DECIDE `r81` IS `party to a civil cause given a new trial on a question of law`
DECIDE `r82` IS `accused given a new trial on appeal against conviction on a question of law`
DECIDE `r9` IS `appellant in a family law appeal succeeding on law, each party bearing their own costs`
DECIDE `r10` IS `party to proceedings made abortive, or discontinued through no party's fault`
DECIDE `r10A` IS `party, other than the decision-maker, to a Tribunal review that must be reheard`
DECIDE `ind` IS `an individual`

DECIDE base IS `pos` `r6` `ind` `the High Court` 8000 0 FALSE FALSE TRUE

-- 1
#ASSERT base's `the court may grant me a certificate` EQUALS TRUE
#ASSERT base's `the most the Attorney-General may pay` EQUALS 5000
#ASSERT base's `my certificate is vacated under s 15` EQUALS FALSE
#ASSERT base's `the Attorney-General may pay now under s 17` EQUALS TRUE
-- 2
#ASSERT (`pos` `r6` `ind` `the High Court` 4000 0 FALSE FALSE TRUE)'s `the most the Attorney-General may pay` EQUALS 4000
-- 3
#ASSERT (`pos` `r6` `ind` `the High Court` 5000 0 FALSE FALSE TRUE)'s `the most the Attorney-General may pay` EQUALS 5000
-- 4
#ASSERT (`pos` `r6` `ind` `the Federal Court` 3500 0 FALSE FALSE TRUE)'s `the most the Attorney-General may pay` EQUALS 3000
-- 5
#ASSERT (`pos` `r6` `ind` `the Federal Circuit and Family Court` 2500 0 FALSE FALSE TRUE)'s `the most the Attorney-General may pay` EQUALS 2000
-- 6
#ASSERT (`pos` `r6` `ind` `a Territory Supreme Court` 3001 0 FALSE FALSE TRUE)'s `the most the Attorney-General may pay` EQUALS 3000
-- 7
#ASSERT (`pos` `r81` `ind` `another Territory court` 1500 0 FALSE FALSE TRUE)'s `the most the Attorney-General may pay` EQUALS 1000
-- 8
#ASSERT (`pos` `r10A` `ind` `the Administrative Review Tribunal` 2500 0 FALSE FALSE FALSE)'s `the court may grant me a certificate` EQUALS TRUE
#ASSERT (`pos` `r10A` `ind` `the Administrative Review Tribunal` 2500 0 FALSE FALSE FALSE)'s `the most the Attorney-General may pay` EQUALS 2000
#ASSERT (`pos` `r10A` `ind` `the Administrative Review Tribunal` 2500 0 FALSE FALSE FALSE)'s `the Attorney-General may pay now under s 17` EQUALS TRUE
-- 9
#ASSERT (`pos` `r10` `ind` `the Federal Court` 10000 0 FALSE FALSE TRUE)'s `the most the Attorney-General may pay` EQUALS 10000
-- 10
#ASSERT (`pos` `r10` `ind` `the High Court` 9000 0 FALSE FALSE TRUE)'s `the most the Attorney-General may pay` EQUALS 9000
-- 11
#ASSERT (`pos` `r6` `ind` `the High Court` 8000 6000 FALSE FALSE TRUE)'s `the most the Attorney-General may pay` EQUALS 6000
-- 12
#ASSERT (`pos` `r6` `ind` `the High Court` 8000 4000 FALSE FALSE TRUE)'s `the most the Attorney-General may pay` EQUALS 5000
-- 13
#ASSERT (`pos` `r6` `the Commonwealth, a State, the NT, their authority, or suing for them` `the High Court` 8000 0 FALSE FALSE TRUE)'s `the court may grant me a certificate` EQUALS FALSE
#ASSERT (`pos` `r6` `the Commonwealth, a State, the NT, their authority, or suing for them` `the High Court` 8000 0 FALSE FALSE TRUE)'s `the most the Attorney-General may pay` EQUALS 0
#ASSERT (`pos` `r6` `the Commonwealth, a State, the NT, their authority, or suing for them` `the High Court` 8000 0 FALSE FALSE TRUE)'s `the Attorney-General may pay now under s 17` EQUALS FALSE
-- 14
#ASSERT (`pos` `r6` `a company with paid-up capital of $200,000 or more, or related to one` `the High Court` 8000 0 FALSE FALSE TRUE)'s `the court may grant me a certificate` EQUALS FALSE
-- 15
#ASSERT (`pos` `r6` `a company with paid-up capital under $200,000, not related to a larger one` `the High Court` 8000 0 FALSE FALSE TRUE)'s `the court may grant me a certificate` EQUALS TRUE
#ASSERT (`pos` `r6` `a company with paid-up capital under $200,000, not related to a larger one` `the High Court` 8000 0 FALSE FALSE TRUE)'s `the most the Attorney-General may pay` EQUALS 5000
-- 16
#ASSERT (`pos` `none` `ind` `the High Court` 8000 0 FALSE FALSE TRUE)'s `the court may grant me a certificate` EQUALS FALSE
#ASSERT (`pos` `none` `ind` `the High Court` 8000 0 FALSE FALSE TRUE)'s `the Attorney-General may pay now under s 17` EQUALS FALSE
-- 17
#ASSERT (`pos` `r7` `ind` `the High Court` 8000 0 TRUE TRUE FALSE)'s `my certificate is vacated under s 15` EQUALS TRUE
#ASSERT (`pos` `r7` `ind` `the High Court` 8000 0 TRUE TRUE FALSE)'s `the Attorney-General may pay now under s 17` EQUALS FALSE
-- 18
#ASSERT (`pos` `r9` `ind` `the Federal Circuit and Family Court` 3000 0 TRUE TRUE FALSE)'s `my certificate is vacated under s 15` EQUALS TRUE
#ASSERT (`pos` `r9` `ind` `the Federal Circuit and Family Court` 3000 0 TRUE TRUE FALSE)'s `the Attorney-General may pay now under s 17` EQUALS FALSE
-- 19
#ASSERT (`pos` `r7` `ind` `the High Court` 8000 0 FALSE FALSE FALSE)'s `my certificate is vacated under s 15` EQUALS FALSE
#ASSERT (`pos` `r7` `ind` `the High Court` 8000 0 FALSE FALSE FALSE)'s `the Attorney-General may pay now under s 17` EQUALS FALSE
-- 20
#ASSERT (`pos` `r7` `ind` `the High Court` 8000 0 FALSE TRUE TRUE)'s `my certificate is vacated under s 15` EQUALS FALSE
#ASSERT (`pos` `r7` `ind` `the High Court` 8000 0 FALSE TRUE TRUE)'s `the Attorney-General may pay now under s 17` EQUALS FALSE
-- 21
#ASSERT (`pos` `r7A` `ind` `the High Court` 8000 0 FALSE TRUE FALSE)'s `the Attorney-General may pay now under s 17` EQUALS TRUE
#ASSERT (`pos` `r7A` `ind` `the High Court` 8000 0 FALSE TRUE FALSE)'s `my certificate is vacated under s 15` EQUALS FALSE
-- 22
#ASSERT (`pos` `r82` `ind` `the High Court` 8000 0 TRUE TRUE FALSE)'s `my certificate is vacated under s 15` EQUALS FALSE
-- 23
#ASSERT (`pos` `r10` `ind` `the Federal Court` 2000 0 FALSE TRUE FALSE)'s `the Attorney-General may pay now under s 17` EQUALS TRUE
-- 24
#ASSERT (`pos` `r6` `ind` `the High Court` 8000 0 TRUE TRUE TRUE)'s `my certificate is vacated under s 15` EQUALS FALSE
