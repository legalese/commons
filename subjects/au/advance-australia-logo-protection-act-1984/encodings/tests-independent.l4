IMPORT prelude
IMPORT daydate
IMPORT `aal-rules`

-- Independent tests: Advance Australia Logo Protection Act 1984. Expected values from
-- independent-expectations.md, written from the source text before reading the L4.
-- Baseline: applying the design, no licence, 1 July 1990, no purported licence.

-- 0. prescribed period ends 12 Oct 1999 (s 3(1))
#ASSERT (`the logo position for` (`Logo case` OF `applying the design to an article`, TRUE, FALSE, (Date 1 7 1990), FALSE))'s `the prescribed period ended on` EQUALS (Date 12 10 1999)

-- 1. apply on 13 Oct 1983, first day: infringes
#ASSERT (`the logo position for` (`Logo case` OF `applying the design to an article`, TRUE, FALSE, (Date 13 10 1983), FALSE))'s `I infringe the monopoly in the design` EQUALS TRUE

-- 2. apply on 12 Oct 1983: outside period
#ASSERT (`the logo position for` (`Logo case` OF `applying the design to an article`, TRUE, FALSE, (Date 12 10 1983), FALSE))'s `I infringe the monopoly in the design` EQUALS FALSE

-- 3. apply on 12 Oct 1999, last day: infringes
#ASSERT (`the logo position for` (`Logo case` OF `applying the design to an article`, TRUE, FALSE, (Date 12 10 1999), FALSE))'s `I infringe the monopoly in the design` EQUALS TRUE

-- 4. apply on 13 Oct 1999: outside period
#ASSERT (`the logo position for` (`Logo case` OF `applying the design to an article`, TRUE, FALSE, (Date 13 10 1999), FALSE))'s `I infringe the monopoly in the design` EQUALS FALSE

-- 5. apply, no licence: infringes (s 11(1)(a))
#ASSERT (`the logo position for` (`Logo case` OF `applying the design to an article`, TRUE, FALSE, (Date 1 7 1990), FALSE))'s `I infringe the monopoly in the design` EQUALS TRUE

-- 6. apply with licence: no infringement
#ASSERT (`the logo position for` (`Logo case` OF `applying the design to an article`, TRUE, TRUE, (Date 1 7 1990), FALSE))'s `I infringe the monopoly in the design` EQUALS FALSE

-- 7. apply an imitation (input TRUE covers imitation): infringes
#ASSERT (`the logo position for` (`Logo case` OF `applying the design to an article`, TRUE, FALSE, (Date 1 7 1990), FALSE))'s `I infringe the monopoly in the design` EQUALS TRUE

-- 8. neither design nor imitation: no infringement
#ASSERT (`the logo position for` (`Logo case` OF `applying the design to an article`, FALSE, FALSE, (Date 1 7 1990), FALSE))'s `I infringe the monopoly in the design` EQUALS FALSE

-- 12. sell infringing article, no licence: infringes (s 11(1)(b))
#ASSERT (`the logo position for` (`Logo case` OF `selling or hiring an article to which the design was applied in infringement`, TRUE, FALSE, (Date 1 7 1990), FALSE))'s `I infringe the monopoly in the design` EQUALS TRUE

-- 13. sell infringing article, with licence: no infringement
#ASSERT (`the logo position for` (`Logo case` OF `selling or hiring an article to which the design was applied in infringement`, TRUE, TRUE, (Date 1 7 1990), FALSE))'s `I infringe the monopoly in the design` EQUALS FALSE

-- 14. import, no licence: infringes (s 11(1)(c))
#ASSERT (`the logo position for` (`Logo case` OF `importing for sale or trade an article to which the design was applied outside Australia`, TRUE, FALSE, (Date 1 7 1990), FALSE))'s `I infringe the monopoly in the design` EQUALS TRUE

-- 15. import with licence: infringes (para (c) has no licence words)
#ASSERT (`the logo position for` (`Logo case` OF `importing for sale or trade an article to which the design was applied outside Australia`, TRUE, TRUE, (Date 1 7 1990), FALSE))'s `I infringe the monopoly in the design` EQUALS TRUE

-- 16. sell imported article, no licence: infringes (s 11(1)(d))
#ASSERT (`the logo position for` (`Logo case` OF `selling or hiring an imported article bearing the design`, TRUE, FALSE, (Date 1 7 1990), FALSE))'s `I infringe the monopoly in the design` EQUALS TRUE

-- 17. sell imported article with licence: infringes (para (d) has no licence words)
#ASSERT (`the logo position for` (`Logo case` OF `selling or hiring an imported article bearing the design`, TRUE, TRUE, (Date 1 7 1990), FALSE))'s `I infringe the monopoly in the design` EQUALS TRUE

-- 18. apply in period: no copyright infringement (s 19(2))
#ASSERT (`the logo position for` (`Logo case` OF `applying the design to an article`, TRUE, FALSE, (Date 1 7 1990), FALSE))'s `I infringe the copyright in the logo` EQUALS (JUST FALSE)

-- 19. apply after period: no copyright infringement (s 19(3))
#ASSERT (`the logo position for` (`Logo case` OF `applying the design to an article`, TRUE, FALSE, (Date 1 7 2005), FALSE))'s `I infringe the copyright in the logo` EQUALS (JUST FALSE)

-- 20. apply before period: s 19 gives no shelter, Copyright Act alone answers
#ASSERT (`the logo position for` (`Logo case` OF `applying the design to an article`, TRUE, FALSE, (Date 1 7 1983), FALSE))'s `I infringe the copyright in the logo` EQUALS NOTHING

-- 21. use 12 Oct 1983 under purported licence: no action lies (s 15(2))
#ASSERT (`the logo position for` (`Logo case` OF `applying the design to an article`, TRUE, FALSE, (Date 12 10 1983), TRUE))'s `no action lies against me` EQUALS TRUE

-- 22. use 12 Oct 1983, no purported licence: s 15(2) does not apply
#ASSERT (`the logo position for` (`Logo case` OF `applying the design to an article`, TRUE, FALSE, (Date 12 10 1983), FALSE))'s `no action lies against me` EQUALS FALSE

-- 23. use 13 Oct 1983 under purported licence: s 15(2) does not apply
#ASSERT (`the logo position for` (`Logo case` OF `applying the design to an article`, TRUE, FALSE, (Date 13 10 1983), TRUE))'s `no action lies against me` EQUALS FALSE

