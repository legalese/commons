#ASSERT `Can the class action be settled?` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Can the class action be settled?` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Can the class action be settled?` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Can the class action be settled?` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Can damages be awarded as a lump sum?` TRUE FALSE EQUALS NOTHING
#ASSERT `Can damages be awarded as a lump sum?` FALSE TRUE EQUALS JUST TRUE
#ASSERT `Can damages be awarded as a lump sum?` FALSE FALSE EQUALS JUST FALSE
#ASSERT `Can my award be held back?` TRUE EQUALS JUST TRUE
#ASSERT `Can my award be held back?` FALSE EQUALS JUST FALSE

§§ `s 33ZA -- the fund`

-- Six months after 31 Aug 2025: no 31 Feb 2026, so the last day of February (fork F9); 2028 is a leap year.
#ASSERT `What is the earliest fund claim day?` (`the day` 31 8 2025) EQUALS `the day` 28 2 2026
#ASSERT `What is the earliest fund claim day?` (`the day` 31 8 2027) EQUALS `the day` 29 2 2028
#ASSERT `What is the earliest fund claim day?` (`the day` 15 1 2026) EQUALS `the day` 15 7 2026
-- Order 1 Feb 2026, claim day 1 Sep 2026. On the claim day: in time ("on or before").
#ASSERT `Can I claim from the fund?` (`the day` 1 2 2026) (`the day` 1 9 2026) (`the day` 1 9 2026) FALSE FALSE EQUALS JUST TRUE
#ASSERT `Can I claim from the fund?` (`the day` 1 2 2026) (`the day` 1 9 2026) (`the day` 1 3 2026) FALSE FALSE EQUALS JUST TRUE
#ASSERT `Can I claim from the fund?` (`the day` 1 2 2026) (`the day` 1 9 2026) (`the day` 1 2 2026) FALSE FALSE EQUALS JUST TRUE
-- One day late: only under s 33ZA(4).
#ASSERT `Can I claim from the fund?` (`the day` 1 2 2026) (`the day` 1 9 2026) (`the day` 2 9 2026) FALSE FALSE EQUALS JUST FALSE
#ASSERT `Can I claim from the fund?` (`the day` 1 2 2026) (`the day` 1 9 2026) (`the day` 2 9 2026) FALSE TRUE EQUALS JUST TRUE
#ASSERT `Can I claim from the fund?` (`the day` 1 2 2026) (`the day` 1 9 2026) (`the day` 2 9 2026) TRUE TRUE EQUALS JUST FALSE
-- The duty itself (s 33ZA(3)(c)), run over a claim on the last day of the period and on the day after.
-- 1 Feb to 1 Sep 2026: 28+31+30+31+30+31+31 = 212 days.
#ASSERT `days from` (`the day` 1 2 2026) (`the day` 1 9 2026) EQUALS 212
#ASSERT `s 33ZA(3)(c) -- my claim was in time` (`the day` 1 2 2026) (`the day` 1 9 2026) (`the day` 1 9 2026) EQUALS TRUE
#ASSERT `s 33ZA(3)(c) -- my claim was in time` (`the day` 1 2 2026) (`the day` 1 9 2026) (`the day` 2 9 2026) EQUALS FALSE
#TRACE `s 33ZA(3)(c) -- I must claim by the claim day` 212 AT 0 WITH
    PARTY `the group member` DOES `make a claim for payment out of the fund` AT 212

§§ `s 33ZH -- consumer law orders`

#ASSERT `Am I a party for consumer law compensation orders?` TRUE EQUALS JUST TRUE
#ASSERT `Am I a party for consumer law compensation orders?` FALSE EQUALS NOTHING

§§ `s 33ZC(6) -- appeal by a group member`

-- Judgment 2 Mar 2026: representative's 28 days end 30 Mar 2026 (r 36.03(a), r 1.61(2)); 21 more: 20 Apr 2026.
#ASSERT `By when can I appeal for the group?` (`the day` 2 3 2026) FALSE (`the day` 1 1 2000) EQUALS `the day` 20 4 2026
-- Judgment 10 Dec 2025: 11-23 Dec counts 13; 24 Dec - 14 Jan not counted (r 1.61(5)); 15 more from 15 Jan: 29 Jan 2026;
-- 21 more (the Act's period, Christmas not excluded): 19 Feb 2026.
#ASSERT `By when can I appeal for the group?` (`the day` 10 12 2025) FALSE (`the day` 1 1 2000) EQUALS `the day` 19 2 2026
-- Judgment 1 Dec 2025: 2-23 Dec counts 22; 6 more: 15-20 Jan; 20 Jan 2026; +21: 10 Feb 2026.
#ASSERT `By when can I appeal for the group?` (`the day` 1 12 2025) FALSE (`the day` 1 1 2000) EQUALS `the day` 10 2 2026
-- Judgment 20 Nov 2025: 21-30 Nov counts 10, 1-18 Dec 18: 18 Dec 2025; +21 calendar days: 8 Jan 2026 (finding 4).
#ASSERT `By when can I appeal for the group?` (`the day` 20 11 2025) FALSE (`the day` 1 1 2000) EQUALS `the day` 8 1 2026
-- A fixed date later than the 28 days: 15 Apr 2026, +21: 6 May 2026; an earlier one: the 28 days (fork F12).
#ASSERT `By when can I appeal for the group?` (`the day` 2 3 2026) TRUE (`the day` 15 4 2026) EQUALS `the day` 6 5 2026
#ASSERT `By when can I appeal for the group?` (`the day` 2 3 2026) TRUE (`the day` 20 3 2026) EQUALS `the day` 20 4 2026
-- The 21-day window is 31 Mar to 20 Apr 2026.
#ASSERT `Can I appeal for the group?` (`the day` 2 3 2026) FALSE (`the day` 1 1 2000) FALSE (`the day` 31 3 2026) EQUALS JUST TRUE
#ASSERT `Can I appeal for the group?` (`the day` 2 3 2026) FALSE (`the day` 1 1 2000) FALSE (`the day` 20 4 2026) EQUALS JUST TRUE
#ASSERT `Can I appeal for the group?` (`the day` 2 3 2026) FALSE (`the day` 1 1 2000) FALSE (`the day` 30 3 2026) EQUALS JUST FALSE
#ASSERT `Can I appeal for the group?` (`the day` 2 3 2026) FALSE (`the day` 1 1 2000) FALSE (`the day` 21 4 2026) EQUALS JUST FALSE
#ASSERT `Can I appeal for the group?` (`the day` 2 3 2026) FALSE (`the day` 1 1 2000) TRUE (`the day` 31 3 2026) EQUALS JUST FALSE
