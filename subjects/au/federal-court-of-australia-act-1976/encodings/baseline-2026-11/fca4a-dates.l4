IMPORT prelude
IMPORT daydate

-- Federal Court of Australia Act 1976 (Cth), Part IVA -- the date arithmetic the rules need, kept in one small module so
-- that daydate is imported in one place only. BASELINE ENCODING. Not for public use as advice. See NOTES.md.

§ `Dates`

-- A calendar date, day first.
GIVEN d IS A NUMBER, m IS A NUMBER, y IS A NUMBER
GIVETH A DATE
`the day` d m y MEANS Date d m y

GIVEN x IS A DATE, n IS A NUMBER
GIVETH A DATE
`the day n days after` x n MEANS DATE_FROM_SERIAL (DATE_SERIAL x PLUS n)

-- How many days from the first date to the second (negative if the second is earlier).
GIVEN a IS A DATE, b IS A DATE
GIVETH A NUMBER
`days from` a b MEANS DATE_SERIAL b MINUS DATE_SERIAL a

-- Six calendar months after a day; where the day does not exist in the sixth month, the last day of that month
-- (31 August plus six months is the last day of February). Fork F9.
GIVEN x IS A DATE
GIVETH A DATE
`six months after` x MEANS `add months` x 6

GIVEN a IS A DATE, b IS A DATE
GIVETH A DATE
`the later date of` a b MEANS
    IF DATE_SERIAL a AT LEAST DATE_SERIAL b
    THEN a
    ELSE b

-- Federal Court Rules 2011 r 1.61(5): "If the time fixed includes a day in the period starting on 24 December in a year
-- and ending on 14 January in the next year, the day is not to be counted."
GIVEN x IS A DATE
GIVETH A BOOLEAN
DECIDE `in the Christmas break` x IF
        (DATE_MONTH x EQUALS 12 AND DATE_DAY x AT LEAST 24)
    OR  (DATE_MONTH x EQUALS 1 AND DATE_DAY x AT MOST 14)

-- r 1.61(2) and (5): the last day of a period of n days after a day, the day itself not counted and no day from
-- 24 December to 14 January counted.
GIVEN x IS A DATE, n IS A NUMBER
GIVETH A DATE
`the last day of n counted days after` x n MEANS
    IF n AT MOST 0
    THEN x
    ELSE IF `in the Christmas break` (`the day n days after` x 1)
         THEN `the last day of n counted days after` (`the day n days after` x 1) n
         ELSE `the last day of n counted days after` (`the day n days after` x 1) (n MINUS 1)
