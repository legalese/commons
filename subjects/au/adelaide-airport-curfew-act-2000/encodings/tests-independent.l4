IMPORT prelude
IMPORT daydate
IMPORT `aac-rules`

-- Independent tests: expected values from independent-expectations.md, written before reading the L4.

-- scenario 1 take-off 22:59 (outside curfew: no offence, no penalty)
#ASSERT (`the curfew position for` (`Curfew case` OF `take-off`, 22, 59, `another aircraft`, FALSE, `none`, NOTHING))'s `it is in the curfew period` EQUALS FALSE
#ASSERT (`the curfew position for` (`Curfew case` OF `take-off`, 22, 59, `another aircraft`, FALSE, `none`, NOTHING))'s `I commit an offence under s 6` EQUALS FALSE
#ASSERT (`the curfew position for` (`Curfew case` OF `take-off`, 22, 59, `another aircraft`, FALSE, `none`, NOTHING))'s `maximum penalty units` EQUALS 0

-- scenario 2 take-off 23:00 other
#ASSERT `the curfew position for` (`Curfew case` OF `take-off`, 23, 0, `another aircraft`, FALSE, `none`, NOTHING) EQUALS (`Curfew position` OF TRUE, FALSE, TRUE, 200, NOTHING)

-- scenario 3 landing 05:59 other
#ASSERT `the curfew position for` (`Curfew case` OF `landing`, 5, 59, `another aircraft`, FALSE, `none`, NOTHING) EQUALS (`Curfew position` OF TRUE, FALSE, TRUE, 200, NOTHING)

-- scenario 4 landing 06:00 (outside curfew: no offence, no penalty)
#ASSERT (`the curfew position for` (`Curfew case` OF `landing`, 6, 0, `another aircraft`, FALSE, `none`, NOTHING))'s `it is in the curfew period` EQUALS FALSE
#ASSERT (`the curfew position for` (`Curfew case` OF `landing`, 6, 0, `another aircraft`, FALSE, `none`, NOTHING))'s `I commit an offence under s 6` EQUALS FALSE
#ASSERT (`the curfew position for` (`Curfew case` OF `landing`, 6, 0, `another aircraft`, FALSE, `none`, NOTHING))'s `maximum penalty units` EQUALS 0

-- scenario 5 landing 01:00 other
#ASSERT `the curfew position for` (`Curfew case` OF `landing`, 1, 0, `another aircraft`, FALSE, `none`, NOTHING) EQUALS (`Curfew position` OF TRUE, FALSE, TRUE, 200, NOTHING)

-- scenario 6 international 23:30 in shoulder
#ASSERT `the curfew position for` (`Curfew case` OF `landing`, 23, 30, `an international aircraft with the Minister's shoulder-period permission`, FALSE, `none`, NOTHING) EQUALS (`Curfew position` OF TRUE, TRUE, FALSE, 0, NOTHING)

-- scenario 7 international 00:30 not shoulder
#ASSERT `the curfew position for` (`Curfew case` OF `landing`, 0, 30, `an international aircraft with the Minister's shoulder-period permission`, FALSE, `none`, NOTHING) EQUALS (`Curfew position` OF TRUE, FALSE, TRUE, 200, NOTHING)

-- scenario 8 international take-off 05:00
#ASSERT `the curfew position for` (`Curfew case` OF `take-off`, 5, 0, `an international aircraft with the Minister's shoulder-period permission`, FALSE, `none`, NOTHING) EQUALS (`Curfew position` OF TRUE, TRUE, FALSE, 0, NOTHING)

-- scenario 9 international take-off 04:59
#ASSERT `the curfew position for` (`Curfew case` OF `take-off`, 4, 59, `an international aircraft with the Minister's shoulder-period permission`, FALSE, `none`, NOTHING) EQUALS (`Curfew position` OF TRUE, FALSE, TRUE, 200, NOTHING)

-- scenario 10 LNHF 02:00
#ASSERT `the curfew position for` (`Curfew case` OF `landing`, 2, 0, `a low noise heavy freight aircraft with the Minister's curfew permission`, FALSE, `none`, NOTHING) EQUALS (`Curfew position` OF TRUE, TRUE, FALSE, 0, NOTHING)

-- scenario 11 propeller 02:00
#ASSERT `the curfew position for` (`Curfew case` OF `take-off`, 2, 0, `a propeller aircraft of 34,000 kg or less meeting the Annex noise standards`, FALSE, `none`, NOTHING) EQUALS (`Curfew position` OF TRUE, TRUE, FALSE, 0, NOTHING)

-- scenario 12 specified jet 03:00
#ASSERT `the curfew position for` (`Curfew case` OF `landing`, 3, 0, `a jet of 34,000 kg or less of a type the regulations specify`, FALSE, `none`, NOTHING) EQUALS (`Curfew position` OF TRUE, TRUE, FALSE, 0, NOTHING)

-- scenario 13 taxi clearance take-off 23:10
#ASSERT `the curfew position for` (`Curfew case` OF `take-off`, 23, 10, `another aircraft`, TRUE, `none`, NOTHING) EQUALS (`Curfew position` OF TRUE, TRUE, FALSE, 0, NOTHING)

-- scenario 14 taxi clearance landing 23:10 (s 14 take-off only)
#ASSERT `the curfew position for` (`Curfew case` OF `landing`, 23, 10, `another aircraft`, TRUE, `none`, NOTHING) EQUALS (`Curfew position` OF TRUE, FALSE, TRUE, 200, NOTHING)

-- scenario 15 emergency landing
#ASSERT `the curfew position for` (`Curfew case` OF `landing`, 1, 0, `another aircraft`, FALSE, `a declared in-flight emergency`, NOTHING) EQUALS (`Curfew position` OF TRUE, TRUE, FALSE, 0, NOTHING)

-- scenario 16 resuming interrupted flight, take-off
#ASSERT `the curfew position for` (`Curfew case` OF `take-off`, 1, 0, `another aircraft`, FALSE, `resuming a flight interrupted by such an emergency`, NOTHING) EQUALS (`Curfew position` OF TRUE, TRUE, FALSE, 0, NOTHING)

-- scenario 17 'resuming interrupted flight' on a LANDING: s 16(b) covers take-off only
#ASSERT `the curfew position for` (`Curfew case` OF `landing`, 1, 0, `another aircraft`, FALSE, `resuming a flight interrupted by such an emergency`, NOTHING) EQUALS (`Curfew position` OF TRUE, FALSE, TRUE, 200, NOTHING)

-- scenario 18 dispensation
#ASSERT `the curfew position for` (`Curfew case` OF `take-off`, 1, 0, `another aircraft`, FALSE, `a dispensation from the Minister, kept to its conditions`, NOTHING) EQUALS (`Curfew position` OF TRUE, TRUE, FALSE, 0, NOTHING)

-- scenario 19 national emergency
#ASSERT `the curfew position for` (`Curfew case` OF `landing`, 1, 0, `another aircraft`, FALSE, `use in a declared national emergency`, NOTHING) EQUALS (`Curfew position` OF TRUE, TRUE, FALSE, 0, NOTHING)

-- scenario 20: international weather landing 25 Dec 2024 -> return by 1 Jan 2025
#ASSERT (`the curfew position for` (`Curfew case` OF `landing`, 23, 30, `an international aircraft with the Minister's shoulder-period permission`, FALSE, `none`, (JUST (Date 25 12 2024))))'s `the last day to give the return` EQUALS JUST (Date 1 1 2025)

-- scenario 21: LNHF weather landing 26 Feb 2024 (leap year) -> return by 4 Mar 2024
#ASSERT (`the curfew position for` (`Curfew case` OF `landing`, 2, 0, `a low noise heavy freight aircraft with the Minister's curfew permission`, FALSE, `none`, (JUST (Date 26 2 2024))))'s `the last day to give the return` EQUALS JUST (Date 4 3 2024)
