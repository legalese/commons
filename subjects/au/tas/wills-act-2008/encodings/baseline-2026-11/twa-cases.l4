#ASSERT `Can the executor pay me maintenance on that day` TRUE TRUE TRUE (`d` 1 1 2025) (`d` 31 1 2025) EQUALS JUST TRUE
#ASSERT `Can the executor pay me maintenance on that day` TRUE TRUE TRUE (`d` 1 1 2025) (`d` 1 2 2025) EQUALS JUST FALSE
