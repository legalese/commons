IMPORT prelude

-- Wills Act 2008 (Tas) -- the dates, in one small module.
--
-- Built-in date functions only (DATE_FROM_DMY, DATE_SERIAL, DATE_FROM_SERIAL, DATE_DAY, DATE_MONTH, DATE_YEAR), not the
-- daydate library. The Act counts four periods: "6 months after" the grant of probate (s 13(2)), "within 3 months after
-- the date of the death" and "at least 3 months after the death" (s 42(2), (4)), and "within 30 days after the death"
-- (ss 49, 55, 64).
--
-- UNOFFICIAL. Based on material from the Tasmanian Legislation website at 6 November 2026 (c) State of Tasmania, CC BY
-- 4.0; not the authorised version. See SOURCE-LICENSE.md. BASELINE ENCODING. Not for public use as advice. See NOTES.md.

§ `Dates for the Wills Act 2008`

GIVEN d IS A NUMBER, m IS A NUMBER, y IS A NUMBER
GIVETH A DATE
`the calendar date` d m y MEANS DATE_FROM_DMY d m y

-- Plain days from one day to another (negative if the second is earlier).
GIVEN `the start` IS A DATE, `the end` IS A DATE
GIVETH A NUMBER
`the days from` `the start` `to` `the end` MEANS DATE_SERIAL `the end` MINUS DATE_SERIAL `the start`

-- The number of days in a month of a year.
GIVEN m IS A NUMBER, y IS A NUMBER
GIVETH A NUMBER
`the days in month` m `of` y MEANS
    IF m EQUALS 12
    THEN 31
    ELSE DATE_SERIAL (DATE_FROM_DMY 1 (m PLUS 1) y) MINUS DATE_SERIAL (DATE_FROM_DMY 1 m y)

-- The same day of the month n months later; a day the later month does not have falls on that month's last day
-- (30 November plus 3 months is 28 or 29 February): fork F1 in NOTES.md.
GIVEN n IS A NUMBER, `the start` IS A DATE
GIVETH A DATE
`the corresponding day` n `months after` `the start` MEANS
    DATE_FROM_DMY (min (DATE_DAY `the start`) (`the days in month` `the target month` `of` `the target year`)) `the target month` `the target year`
    WHERE
        `the months counted` MEANS (DATE_MONTH `the start` MINUS 1) PLUS n
        `the target year` MEANS DATE_YEAR `the start` PLUS FLOOR (`the months counted` DIVIDED BY 12)
        `the target month` MEANS (`the months counted` MODULO 12) PLUS 1

-- The day n days after a day.
GIVEN n IS A NUMBER, `the start` IS A DATE
GIVETH A DATE
`the day` n `days after` `the start` MEANS DATE_FROM_SERIAL (DATE_SERIAL `the start` PLUS n)
