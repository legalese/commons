IMPORT prelude

-- Acts Interpretation Act 1931 (Tasmania): the provision index.
-- One entry per section, subsection, paragraph, subparagraph, Schedule, Schedule clause and defined term of the deposited text,
-- with its identifier as printed and its heading as printed ("" where the text prints none).
-- The entries are written by a script that reads the text file; the line numbers are lines of that file.
-- A provision that the text shows only as a row of dots is marked `shown only as dots`.

DECLARE `Provision kind` IS ONE OF
    `a section`
    `a subsection`
    `a paragraph`
    `a subparagraph`
    `a Schedule`
    `a Schedule clause`
    `a defined term`

DECLARE Provision HAS
    `provision key`          IS A STRING
    `kind of provision`      IS A `Provision kind`
    `identifier as printed`  IS A STRING
    `heading as printed`     IS A STRING
    `first line`             IS A NUMBER
    `last line`              IS A NUMBER
    `shown only as dots`     IS A BOOLEAN

`the provision index` MEANS LIST
    (Provision OF "1", `a section`, "1", "Short title", 17, 19, FALSE)
  , (Provision OF "2", `a section`, "2", "Repeal", 21, 23, FALSE)
  , (Provision OF "2A", `a section`, "2A", "Meaning of \"regulation\"", 25, 29, FALSE)
  , (Provision OF "2A:regulation", `a defined term`, "regulation", "", 29, 29, FALSE)
  , (Provision OF "3", `a section`, "3", "Acts to be construed subject to legislative powers of State", 31, 33, FALSE)
  , (Provision OF "4", `a section`, "4", "Application of Act", 35, 61, FALSE)
  , (Provision OF "4(1)", `a subsection`, "(1)", "", 37, 41, FALSE)
  , (Provision OF "4(1)(a)", `a paragraph`, "(a)", "", 39, 39, FALSE)
  , (Provision OF "4(1)(b)", `a paragraph`, "(b)", "", 41, 41, FALSE)
