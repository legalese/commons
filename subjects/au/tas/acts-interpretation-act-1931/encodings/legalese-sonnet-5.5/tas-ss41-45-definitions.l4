#ASSERT NOT (`s 45(1): the person is the Minister` TRUE FALSE)
#ASSERT NOT (`s 45(1): the person is the Minister` FALSE TRUE)
#ASSERT `s 45(1): the order is an order-in-council` TRUE
#ASSERT NOT (`s 45(1): the order is an order-in-council` FALSE)
#ASSERT `s 45(1): the instrument is a proclamation` TRUE TRUE
#ASSERT NOT (`s 45(1): the instrument is a proclamation` TRUE FALSE)
#ASSERT NOT (`s 45(1): the instrument is a proclamation` FALSE TRUE)
