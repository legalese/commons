#ASSERT NOT (`s 43(1): the place is a British possession` TRUE TRUE)
#ASSERT NOT (`s 43(1): the place is a British possession` FALSE FALSE)
#ASSERT `s 43(1): the Government Printer includes the person` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 43(1): the Government Printer includes the person` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 43(1): the Government Printer includes the person` FALSE FALSE EQUALS NOTHING
#ASSERT `s 43(1): the Division of the State in which the place lies` 41.5 EQUALS JUST `the Northern Division`
#ASSERT `s 43(1): the Division of the State in which the place lies` 43.2 EQUALS JUST `the Southern Division`
#ASSERT `s 43(1): the Division of the State in which the place lies` 42 EQUALS NOTHING
#ASSERT `s 43(1): the Division of the State in which the place lies` 41.99 EQUALS JUST `the Northern Division`
#ASSERT `s 43(1): the Division of the State in which the place lies` 42.01 EQUALS JUST `the Southern Division`
#ASSERT `s 43(1): the person is the Governor` TRUE FALSE TRUE
#ASSERT `s 43(1): the person is the Governor` FALSE TRUE TRUE
