§ `s 46 and s 29(1): calendar months`

-- the day of the same number in the later month
#ASSERT `s 29(1) and s 46: the last day of a period of calendar months reckoned forwards from` (Date 16 7 2025) `for` 1 EQUALS JUST (Date 16 8 2025)
#ASSERT `s 29(1) and s 46: the last day of a period of calendar months reckoned forwards from` (Date 31 12 2025) `for` 1 EQUALS JUST (Date 31 1 2026)
#ASSERT `s 29(1) and s 46: the last day of a period of calendar months reckoned forwards from` (Date 30 4 2025) `for` 1 EQUALS JUST (Date 30 5 2025)
#ASSERT `s 29(1) and s 46: the last day of a period of calendar months reckoned forwards from` (Date 16 7 2025) `for` 36 EQUALS JUST (Date 16 7 2028)
#ASSERT `s 29(1) and s 46: the last day of a period of calendar months reckoned forwards from` (Date 15 1 2025) `for` 60 EQUALS JUST (Date 15 1 2030)
#ASSERT `s 29(1) and s 46: the last day of a period of calendar months reckoned forwards from` (Date 1 9 2025) `for` 60 EQUALS JUST (Date 1 9 2030)
#ASSERT `s 29(1) and s 46: the last day of a period of calendar months reckoned forwards from` (Date 29 2 2024) `for` 48 EQUALS JUST (Date 29 2 2028)
#ASSERT `s 29(1) and s 46: the last day of a period of calendar months reckoned forwards from` (Date 30 12 2025) `for` 1 EQUALS JUST (Date 30 1 2026)
-- a month that lacks the start day's number: the text does not say
#ASSERT `s 29(1) and s 46: the last day of a period of calendar months reckoned forwards from` (Date 31 12 2025) `for` 2 EQUALS NOTHING
#ASSERT `s 29(1) and s 46: the last day of a period of calendar months reckoned forwards from` (Date 31 1 2024) `for` 1 EQUALS NOTHING
#ASSERT `s 29(1) and s 46: the last day of a period of calendar months reckoned forwards from` (Date 31 3 2025) `for` 1 EQUALS NOTHING
#ASSERT `s 29(1) and s 46: the last day of a period of calendar months reckoned forwards from` (Date 30 12 2025) `for` 2 EQUALS NOTHING
#ASSERT `s 29(1) and s 46: the last day of a period of calendar months reckoned forwards from` (Date 29 2 2024) `for` 12 EQUALS NOTHING
#ASSERT `s 29(1) and s 46: the last day of a period of calendar months reckoned forwards from` (Date 29 2 2024) `for` 24 EQUALS NOTHING
-- backwards
#ASSERT `s 29(1) and s 46: the first day of a period of calendar months reckoned backwards from` (Date 16 8 2025) `for` 1 EQUALS JUST (Date 16 7 2025)
#ASSERT `s 29(1) and s 46: the first day of a period of calendar months reckoned backwards from` (Date 31 3 2025) `for` 2 EQUALS JUST (Date 31 1 2025)
#ASSERT `s 29(1) and s 46: the first day of a period of calendar months reckoned backwards from` (Date 15 1 2026) `for` 3 EQUALS JUST (Date 15 10 2025)
#ASSERT `s 29(1) and s 46: the first day of a period of calendar months reckoned backwards from` (Date 15 1 2026) `for` 13 EQUALS JUST (Date 15 12 2024)
#ASSERT `s 29(1) and s 46: the first day of a period of calendar months reckoned backwards from` (Date 31 3 2025) `for` 1 EQUALS NOTHING

§ `s 29(1) and s 46: weeks and years`

-- the Act defines neither a week nor a year
#ASSERT `s 29(1): the last day of a period of years reckoned forwards from` (Date 16 7 2025) `for` 3 EQUALS NOTHING
#ASSERT `s 29(1): the last day of a period of years reckoned forwards from` (Date 15 1 2025) `for` 5 EQUALS NOTHING
#ASSERT `s 29(1): the last day of a period of years reckoned forwards from` (Date 1 9 2025) `for` 5 EQUALS NOTHING
#ASSERT `s 29(1): the last day of a period of years reckoned forwards from` (Date 29 2 2024) `for` 1 EQUALS NOTHING
#ASSERT `s 29(1): the last day of a period of weeks reckoned forwards from` (Date 1 1 2026) `for` 2 EQUALS NOTHING

§ `s 29(3)(a) with s 46: a period of calendar months whose last day is an excluded day`

-- 36 months from 16 July 2025 ends Sunday 16 July 2028; Monday 17 July 2028.
#ASSERT `s 29(3)(a) and s 46: the last day on which an act is in due time, a period of calendar months reckoned forwards from` (Date 16 7 2025) `for` 36 `with the excluded days` `no holidays` EQUALS JUST (Date 17 7 2028)
-- 60 months from 15 January 2025 ends Tuesday 15 January 2030, which stands.
#ASSERT `s 29(3)(a) and s 46: the last day on which an act is in due time, a period of calendar months reckoned forwards from` (Date 15 1 2025) `for` 60 `with the excluded days` `no holidays` EQUALS JUST (Date 15 1 2030)
-- 60 months from 1 September 2025 ends Sunday 1 September 2030; Monday 2 September 2030.
#ASSERT `s 29(3)(a) and s 46: the last day on which an act is in due time, a period of calendar months reckoned forwards from` (Date 1 9 2025) `for` 60 `with the excluded days` `no holidays` EQUALS JUST (Date 2 9 2030)
-- a month that lacks the start day's number: the text does not say
#ASSERT `s 29(3)(a) and s 46: the last day on which an act is in due time, a period of calendar months reckoned forwards from` (Date 31 12 2025) `for` 2 `with the excluded days` `no holidays` EQUALS NOTHING

-- ---------------------------------------------------------------------------------------------------------------------
§ `s 45(1): the financial year`

#ASSERT `s 45(1): the first day of the financial year ending in the year` 2026 EQUALS Date 1 7 2025
#ASSERT `s 45(1): the last day of the financial year ending in the year` 2026 EQUALS Date 30 6 2026
-- 1 July 2025 to 30 June 2026 is 365 days; 1 July 2023 to 30 June 2024 contains 29 February 2024 and is 366 days.
#ASSERT (Day (`s 45(1): the last day of the financial year ending in the year` 2026) MINUS Day (`s 45(1): the first day of the financial year ending in the year` 2026)) PLUS 1 EQUALS 365
#ASSERT (Day (`s 45(1): the last day of the financial year ending in the year` 2024) MINUS Day (`s 45(1): the first day of the financial year ending in the year` 2024)) PLUS 1 EQUALS 366
#ASSERT `s 45(1): the year in which the financial year containing a day ends` (Date 30 6 2026) EQUALS 2026
#ASSERT `s 45(1): the year in which the financial year containing a day ends` (Date 1 7 2026) EQUALS 2027
#ASSERT `s 45(1): the year in which the financial year containing a day ends` (Date 1 1 2026) EQUALS 2026
#ASSERT `s 45(1): the year in which the financial year containing a day ends` (Date 31 12 2026) EQUALS 2027

-- ---------------------------------------------------------------------------------------------------------------------
§ `ss 9(5), 14(2), 16(4): the moment within a day`

-- An Act expressed to commence on 1 July 2026 takes effect immediately on the expiration of 30 June 2026.
#ASSERT `the position on the timeline of a moment` (`s 9(5): the moment at which an Act or instrument expressed to commence on a day takes effect` (Date 1 7 2026)) MINUS `the position on the timeline of a moment` (`s 9(5): the moment immediately before an Act or instrument expressed to commence on a day takes effect` (Date 1 7 2026)) EQUALS 1
#ASSERT `s 9(5): the moment immediately before an Act or instrument expressed to commence on a day takes effect` (Date 1 7 2026) EQUALS `Moment in a day` OF (Date 30 6 2026), `the last moment of the day`
#ASSERT `s 14(2): the last moment of operation of an enactment expressed to expire or remain in force until a specified day` (Date 31 12 2026) EQUALS `Moment in a day` OF (Date 31 12 2026), `the last moment of the day`
#ASSERT `s 16(4): the moment at which an Act or instrument expressed to expire or cease to have effect on a particular day expires` (Date 31 12 2026) EQUALS `s 14(2): the last moment of operation of an enactment expressed to expire or remain in force until a specified day` (Date 31 12 2026)
-- commencing 1 July 2026 and expiring 31 December 2026
#ASSERT `s 9(5) and s 14(2): an enactment commencing on a day and expiring on a day is in operation at a moment` (Date 1 7 2026) (Date 31 12 2026) (`Moment in a day` OF (Date 1 7 2026), `the first moment of the day`)
#ASSERT NOT (`s 9(5) and s 14(2): an enactment commencing on a day and expiring on a day is in operation at a moment` (Date 1 7 2026) (Date 31 12 2026) (`Moment in a day` OF (Date 30 6 2026), `the last moment of the day`))
#ASSERT `s 9(5) and s 14(2): an enactment commencing on a day and expiring on a day is in operation at a moment` (Date 1 7 2026) (Date 31 12 2026) (`Moment in a day` OF (Date 31 12 2026), `the last moment of the day`)
#ASSERT NOT (`s 9(5) and s 14(2): an enactment commencing on a day and expiring on a day is in operation at a moment` (Date 1 7 2026) (Date 31 12 2026) (`Moment in a day` OF (Date 1 1 2027), `the first moment of the day`))
#ASSERT `s 9(5) and s 14(2): an enactment commencing on a day and expiring on a day is in operation at a moment` (Date 1 7 2026) (Date 1 7 2026) (`Moment in a day` OF (Date 1 7 2026), `the last moment of the day`)

§ `s 9: when an Act commences`

-- Fixture: section 8 of the 1981 Amendment Act is taken to have commenced on 1 January 1982. The deposited text does not state the day.
-- s 9(2): the Act is dated 18 January 1932 in the text's own heading line.
#ASSERT `s 9(2): the day an Act assented to before the commencement of section 8 of the 1981 Amendment Act is deemed to have come into operation` (Date 18 1 1932) `with` (Date 1 1 1982) `and` FALSE EQUALS JUST (Date 18 1 1932)
#ASSERT `s 9(2): the day an Act assented to before the commencement of section 8 of the 1981 Amendment Act is deemed to have come into operation` (Date 31 12 1981) `with` (Date 1 1 1982) `and` FALSE EQUALS JUST (Date 31 12 1981)
#ASSERT `s 9(2): the day an Act assented to before the commencement of section 8 of the 1981 Amendment Act is deemed to have come into operation` (Date 1 1 1982) `with` (Date 1 1 1982) `and` FALSE EQUALS NOTHING
#ASSERT `s 9(2): the day an Act assented to before the commencement of section 8 of the 1981 Amendment Act is deemed to have come into operation` (Date 18 1 1932) `with` (Date 1 1 1982) `and` TRUE EQUALS NOTHING
-- s 9(3): the fourteenth day after the day of assent
#ASSERT `s 9(3): the day an Act assented to on or after the commencement of section 8 of the 1981 Amendment Act comes into operation` (Date 10 3 1990) `with` (Date 1 1 1982) `and` FALSE EQUALS JUST (Date 24 3 1990)
#ASSERT `s 9(3): the day an Act assented to on or after the commencement of section 8 of the 1981 Amendment Act comes into operation` (Date 1 1 1982) `with` (Date 1 1 1982) `and` FALSE EQUALS JUST (Date 15 1 1982)
#ASSERT `s 9(3): the day an Act assented to on or after the commencement of section 8 of the 1981 Amendment Act comes into operation` (Date 25 12 2025) `with` (Date 1 1 1982) `and` FALSE EQUALS JUST (Date 8 1 2026)
#ASSERT `s 9(3): the day an Act assented to on or after the commencement of section 8 of the 1981 Amendment Act comes into operation` (Date 31 12 1981) `with` (Date 1 1 1982) `and` FALSE EQUALS NOTHING
#ASSERT `s 9(3): the day an Act assented to on or after the commencement of section 8 of the 1981 Amendment Act comes into operation` (Date 10 3 1990) `with` (Date 1 1 1982) `and` TRUE EQUALS NOTHING
-- s 9(3A)
#ASSERT `s 9(3A): the day the provision for commencement by proclamation and the short title provision come into operation` (Date 10 3 1990) `where` TRUE `and` FALSE EQUALS JUST (Date 10 3 1990)
#ASSERT `s 9(3A): the day the provision for commencement by proclamation and the short title provision come into operation` (Date 10 3 1990) `where` TRUE `and` TRUE EQUALS NOTHING
#ASSERT `s 9(3A): the day the provision for commencement by proclamation and the short title provision come into operation` (Date 10 3 1990) `where` FALSE `and` FALSE EQUALS NOTHING
-- s 9(4): the day after the day on which the proclamation is published or notified
#ASSERT `s 9(4): the day an Act reserved for the signification of the Sovereign's pleasure comes into operation` (Date 20 6 1990) `after reservation on` (Date 1 6 1990) `with` (Date 1 1 1982) `and` FALSE EQUALS JUST (Date 21 6 1990)
#ASSERT `s 9(4): the day an Act reserved for the signification of the Sovereign's pleasure comes into operation` (Date 31 12 1990) `after reservation on` (Date 1 6 1990) `with` (Date 1 1 1982) `and` FALSE EQUALS JUST (Date 1 1 1991)
#ASSERT `s 9(4): the day an Act reserved for the signification of the Sovereign's pleasure comes into operation` (Date 20 6 1981) `after reservation on` (Date 1 6 1981) `with` (Date 1 1 1982) `and` FALSE EQUALS NOTHING
#ASSERT `s 9(4): the day an Act reserved for the signification of the Sovereign's pleasure comes into operation` (Date 20 6 1990) `after reservation on` (Date 1 6 1990) `with` (Date 1 1 1982) `and` TRUE EQUALS NOTHING

