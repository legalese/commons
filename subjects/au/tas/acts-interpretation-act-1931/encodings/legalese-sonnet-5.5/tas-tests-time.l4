IMPORT prelude
IMPORT daydate
IMPORT `tas-interpretation-time`

-- Tests for tas-interpretation-time.l4.
-- Every expected value was worked out by hand from the cited section before the module was run.
-- Weekdays used below, from a calendar: 1 January 2026 is a Thursday, so Sunday 4 January 2026, Sunday 25 January 2026, Monday 26 January 2026 (a holiday in these fixtures),
-- Saturday 31 January 2026, Sunday 1 February 2026; Sunday 16 July 2028; Tuesday 15 January 2030; Sunday 1 September 2030.
-- Fixture dates labelled "fixture" are values chosen for the test; the Act does not state them.

`no holidays` MEANS EMPTY
`Monday 26 January 2026 is a holiday` MEANS LIST (Date 26 1 2026)

-- ---------------------------------------------------------------------------------------------------------------------
§ `s 29(1): exclusive of the given day`

-- 30 days from 1 January 2026: 1 January is not counted, so the 30th day is 31 January 2026.
#ASSERT `s 29(1): the last day of a period of days reckoned forwards from` (Date 1 1 2026) `for` 30 EQUALS Date 31 1 2026
-- 1 day from 31 December 2025 is 1 January 2026.
#ASSERT `s 29(1): the last day of a period of days reckoned forwards from` (Date 31 12 2025) `for` 1 EQUALS Date 1 1 2026
-- 1 day from 28 February 2024 is 29 February 2024 (a leap year); 2 days from it is 1 March 2024.
#ASSERT `s 29(1): the last day of a period of days reckoned forwards from` (Date 28 2 2024) `for` 1 EQUALS Date 29 2 2024
#ASSERT `s 29(1): the last day of a period of days reckoned forwards from` (Date 28 2 2024) `for` 2 EQUALS Date 1 3 2024
-- 365 days from 1 January 2026 is 1 January 2027.
#ASSERT `s 29(1): the last day of a period of days reckoned forwards from` (Date 1 1 2026) `for` 365 EQUALS Date 1 1 2027
-- backwards: 30 days before 31 January 2026 is 1 January 2026.
#ASSERT `s 29(1): the first day of a period of days reckoned backwards from` (Date 31 1 2026) `for` 30 EQUALS Date 1 1 2026
#ASSERT `s 29(1): the first day of a period of days reckoned backwards from` (Date 1 3 2024) `for` 1 EQUALS Date 29 2 2024
-- the given day is not counted; the last day is counted; the day after the last is not.
#ASSERT NOT (`s 29(1): a day is counted in a period of days reckoned forwards from` (Date 1 1 2026) `for` 30 `namely` (Date 1 1 2026))
#ASSERT `s 29(1): a day is counted in a period of days reckoned forwards from` (Date 1 1 2026) `for` 30 `namely` (Date 2 1 2026)
#ASSERT `s 29(1): a day is counted in a period of days reckoned forwards from` (Date 1 1 2026) `for` 30 `namely` (Date 31 1 2026)
#ASSERT NOT (`s 29(1): a day is counted in a period of days reckoned forwards from` (Date 1 1 2026) `for` 30 `namely` (Date 1 2 2026))
#ASSERT NOT (`s 29(1): a day is counted in a period of days reckoned forwards from` (Date 1 1 2026) `for` 30 `namely` (Date 31 12 2025))

§ `s 29(2): clear days`

-- 5 clear days from 1 January 2026: 2 to 6 January are the clear days; the purpose may be fulfilled on 7 January.
#ASSERT `s 29(2): the earliest day on which the purpose may be fulfilled after a number of clear days from` (Date 1 1 2026) `for` 5 EQUALS Date 7 1 2026
-- backwards: 5 clear days before 20 January 2026: 15 to 19 January are the clear days; the latest purpose day is 14 January.
#ASSERT `s 29(2): the latest day on which the purpose may be fulfilled before a number of clear days from` (Date 20 1 2026) `for` 5 EQUALS Date 14 1 2026
-- a clear-day period ends one day later than the same number of ordinary days.
#ASSERT `s 29(2): the earliest day on which the purpose may be fulfilled after a number of clear days from` (Date 1 1 2026) `for` 30 EQUALS Date 1 2 2026

§ `s 29(3): Sundays and holidays are excluded days`

#ASSERT `s 29(3): a day is a Sunday` (Date 4 1 2026)
#ASSERT `s 29(3): a day is a Sunday` (Date 25 1 2026)
#ASSERT `s 29(3): a day is a Sunday` (Date 16 7 2028)
#ASSERT `s 29(3): a day is a Sunday` (Date 1 9 2030)
#ASSERT NOT (`s 29(3): a day is a Sunday` (Date 3 1 2026))
#ASSERT NOT (`s 29(3): a day is a Sunday` (Date 5 1 2026))
#ASSERT NOT (`s 29(3): a day is a Sunday` (Date 31 1 2026))
#ASSERT NOT (`s 29(3): a day is a Sunday` (Date 15 1 2030))
#ASSERT NOT (`s 29(3): a day is a Sunday` (Date 29 2 2024))
-- a Saturday is not an excluded day unless listed
#ASSERT NOT (`s 29(3): a day is an excluded day` (Date 31 1 2026) `no holidays`)
#ASSERT `s 29(3): a day is an excluded day` (Date 31 1 2026) (LIST (Date 31 1 2026))
#ASSERT `s 29(3): a day is an excluded day` (Date 4 1 2026) `no holidays`
#ASSERT `s 29(3): a day is an excluded day` (Date 26 1 2026) `Monday 26 January 2026 is a holiday`
#ASSERT NOT (`s 29(3): a day is an excluded day` (Date 26 1 2026) `no holidays`)
#ASSERT NOT (`s 29(3): a day is an excluded day` (Date 27 1 2026) `Monday 26 January 2026 is a holiday`)
-- next day afterwards not being an excluded day
#ASSERT `s 29(3): the next day afterwards not being an excluded day` (Date 23 1 2026) `Monday 26 January 2026 is a holiday` EQUALS Date 24 1 2026
#ASSERT `s 29(3): the next day afterwards not being an excluded day` (Date 24 1 2026) `Monday 26 January 2026 is a holiday` EQUALS Date 27 1 2026
#ASSERT `s 29(3): the next day afterwards not being an excluded day` (Date 25 1 2026) `Monday 26 January 2026 is a holiday` EQUALS Date 27 1 2026
#ASSERT `s 29(3): the next day afterwards not being an excluded day` (Date 31 12 2025) `no holidays` EQUALS Date 1 1 2026
-- next day before not being an excluded day
#ASSERT `s 29(3): the next day before not being an excluded day` (Date 27 1 2026) `Monday 26 January 2026 is a holiday` EQUALS Date 24 1 2026
#ASSERT `s 29(3): the next day before not being an excluded day` (Date 26 1 2026) `no holidays` EQUALS Date 24 1 2026
#ASSERT `s 29(3): the next day before not being an excluded day` (Date 6 1 2026) `no holidays` EQUALS Date 5 1 2026

§ `s 29(3)(a): a time reckoned forwards whose last day is an excluded day`

-- last day Sunday 4 January 2026: in due time if done on Monday 5 January 2026.
#ASSERT `s 29(3)(a): the last day on which an act is in due time, a time reckoned forwards ending on` (Date 4 1 2026) `no holidays` EQUALS Date 5 1 2026
-- last day Saturday 31 January 2026: a Saturday is not excluded, so the last day stands.
#ASSERT `s 29(3)(a): the last day on which an act is in due time, a time reckoned forwards ending on` (Date 31 1 2026) `no holidays` EQUALS Date 31 1 2026
-- last day Sunday 25 January 2026, Monday 26 January a holiday: Tuesday 27 January.
#ASSERT `s 29(3)(a): the last day on which an act is in due time, a time reckoned forwards ending on` (Date 25 1 2026) `Monday 26 January 2026 is a holiday` EQUALS Date 27 1 2026
-- last day a holiday Monday 26 January 2026: Tuesday 27 January.
#ASSERT `s 29(3)(a): the last day on which an act is in due time, a time reckoned forwards ending on` (Date 26 1 2026) `Monday 26 January 2026 is a holiday` EQUALS Date 27 1 2026
-- last day an ordinary Wednesday stands.
#ASSERT `s 29(3)(a): the last day on which an act is in due time, a time reckoned forwards ending on` (Date 28 1 2026) `Monday 26 January 2026 is a holiday` EQUALS Date 28 1 2026

§ `s 29(3)(b): a time reckoned backwards whose first day is an excluded day`

-- first day Sunday 25 January 2026: the next day before not being excluded is Saturday 24 January 2026.
#ASSERT `s 29(3)(b): the day on or before which an act is in due time, a time reckoned backwards ending on` (Date 25 1 2026) `no holidays` EQUALS Date 24 1 2026
-- first day the holiday Monday 26 January 2026: Saturday 24 January 2026.
#ASSERT `s 29(3)(b): the day on or before which an act is in due time, a time reckoned backwards ending on` (Date 26 1 2026) `Monday 26 January 2026 is a holiday` EQUALS Date 24 1 2026
-- first day Tuesday 27 January 2026 stands.
#ASSERT `s 29(3)(b): the day on or before which an act is in due time, a time reckoned backwards ending on` (Date 27 1 2026) `Monday 26 January 2026 is a holiday` EQUALS Date 27 1 2026

§ `s 29(4): the office is not open`

-- last day Saturday 31 January 2026, office shut, next open Monday 2 February 2026.
#ASSERT `s 29(4): the last day on which a document may be filed or registered` (Date 31 1 2026) `when` FALSE `and next open on` (Date 2 2 2026) EQUALS JUST (Date 2 2 2026)
-- office open on the last day.
#ASSERT `s 29(4): the last day on which a document may be filed or registered` (Date 30 1 2026) `when` TRUE `and next open on` (Date 2 2 2026) EQUALS JUST (Date 30 1 2026)
-- a next-open day that is not after the last day does not describe an ensuing day.
#ASSERT `s 29(4): the last day on which a document may be filed or registered` (Date 31 1 2026) `when` FALSE `and next open on` (Date 30 1 2026) EQUALS NOTHING
#ASSERT `s 29(4): the last day on which a document may be filed or registered` (Date 31 1 2026) `when` FALSE `and next open on` (Date 31 1 2026) EQUALS NOTHING

§ `s 29(5): a particular day fixed so that subsection (3) is not applicable`

#ASSERT `s 29(5): the day on which an act directed or allowed to be done on a particular day is in due time` (Date 4 1 2026) `where` FALSE `no holidays` EQUALS JUST (Date 5 1 2026)
#ASSERT `s 29(5): the day on which an act directed or allowed to be done on a particular day is in due time` (Date 5 1 2026) `where` FALSE `no holidays` EQUALS JUST (Date 5 1 2026)
#ASSERT `s 29(5): the day on which an act directed or allowed to be done on a particular day is in due time` (Date 25 1 2026) `where` FALSE `Monday 26 January 2026 is a holiday` EQUALS JUST (Date 27 1 2026)
-- where subsection (3) is applicable this subsection gives no day
#ASSERT `s 29(5): the day on which an act directed or allowed to be done on a particular day is in due time` (Date 4 1 2026) `where` TRUE `no holidays` EQUALS NOTHING

§ `s 29(6): a time not exceeding 6 days, excluded days not reckoned`

-- 3 days from Friday 2 January 2026: Saturday 3 (1), Sunday 4 skipped, Monday 5 (2), Tuesday 6 (3).
#ASSERT `s 29(6): the last day of a time not exceeding 6 days reckoned forwards from` (Date 2 1 2026) `for` 3 `excluding the excluded days` `no holidays` EQUALS JUST (Date 6 1 2026)
-- 6 days from Friday 2 January 2026: 3, 5, 6, 7, 8, 9 January.
#ASSERT `s 29(6): the last day of a time not exceeding 6 days reckoned forwards from` (Date 2 1 2026) `for` 6 `excluding the excluded days` `no holidays` EQUALS JUST (Date 9 1 2026)
-- 7 days exceeds 6, and 0 days is no time.
#ASSERT `s 29(6): the last day of a time not exceeding 6 days reckoned forwards from` (Date 2 1 2026) `for` 7 `excluding the excluded days` `no holidays` EQUALS NOTHING
#ASSERT `s 29(6): the last day of a time not exceeding 6 days reckoned forwards from` (Date 2 1 2026) `for` 0 `excluding the excluded days` `no holidays` EQUALS NOTHING
-- 3 days from Friday 23 January 2026 with Monday 26 January a holiday: Saturday 24 (1), Tuesday 27 (2), Wednesday 28 (3).
#ASSERT `s 29(6): the last day of a time not exceeding 6 days reckoned forwards from` (Date 23 1 2026) `for` 3 `excluding the excluded days` `Monday 26 January 2026 is a holiday` EQUALS JUST (Date 28 1 2026)
-- backwards: 2 days before Monday 5 January 2026: Sunday 4 skipped, Saturday 3 (1), Friday 2 (2).
#ASSERT `s 29(6): the first day of a time not exceeding 6 days reckoned backwards from` (Date 5 1 2026) `for` 2 `excluding the excluded days` `no holidays` EQUALS JUST (Date 2 1 2026)
#ASSERT `s 29(6): the first day of a time not exceeding 6 days reckoned backwards from` (Date 5 1 2026) `for` 7 `excluding the excluded days` `no holidays` EQUALS NOTHING

§ `s 29: the last day for doing an act, taken together`

-- 30 days from 1 January 2026 ends Saturday 31 January 2026, which stands.
#ASSERT `s 29: the last day for doing an act within a number of days reckoned forwards from` (Date 1 1 2026) `for` 30 `with the excluded days` `no holidays` EQUALS Date 31 1 2026
-- 30 days from Friday 5 December 2025 ends Sunday 4 January 2026; Monday 5 January 2026.
#ASSERT `s 29: the last day for doing an act within a number of days reckoned forwards from` (Date 5 12 2025) `for` 30 `with the excluded days` `no holidays` EQUALS Date 5 1 2026
-- 3 days uses subsection (6).
#ASSERT `s 29: the last day for doing an act within a number of days reckoned forwards from` (Date 2 1 2026) `for` 3 `with the excluded days` `no holidays` EQUALS Date 6 1 2026
-- 7 days uses subsections (1) and (3): 7 days from Friday 2 January 2026 ends Friday 9 January 2026.
#ASSERT `s 29: the last day for doing an act within a number of days reckoned forwards from` (Date 2 1 2026) `for` 7 `with the excluded days` `no holidays` EQUALS Date 9 1 2026

