#ASSERT EVALTRACE `the claim rules` 0 (LIST (EVENT `the employer` `notify the insurer of the claim` 3), (EVENT `the employer` `forward the completed claim and a copy to the licensed insurer` 6), (EVENT `the employer` `commence weekly payments` 8), (EVENT `the employer` `notify the worker in writing of the decision on liability, or why none has been made` 20)) EQUALS FULFILLED
-- The insurer sends the status notice instead (s 39(2)): met.
#ASSERT EVALTRACE `the claim rules` 0 (LIST (EVENT `the employer` `notify the insurer of the claim` 3), (EVENT `the employer` `forward the completed claim and a copy to the licensed insurer` 6), (EVENT `the employer` `commence weekly payments` 8), (EVENT `the employer's licensed insurer` `notify the worker in writing of the decision on liability, or why none has been made` 25)) EQUALS FULFILLED
-- expect: BREACH BY the employer, "s 36(1AA): the employer must notify its insurer of the claim within 3 working days ..." (notified day 6)
#TRACE `the claim rules` AT 0 WITH
    PARTY `the employer` DOES `notify the insurer of the claim` AT 6
    PARTY `the employer` DOES `forward the completed claim and a copy to the licensed insurer` AT 6
    PARTY `the employer` DOES `commence weekly payments` AT 8
    PARTY `the employer` DOES `notify the worker in writing of the decision on liability, or why none has been made` AT 20
-- expect: BREACH BY the employer, "s 81(1), (2): the employer must commence weekly payments on the worker's first pay day ..." (started day 9)
#TRACE `the claim rules` AT 0 WITH
    PARTY `the employer` DOES `notify the insurer of the claim` AT 3
    PARTY `the employer` DOES `forward the completed claim and a copy to the licensed insurer` AT 6
    PARTY `the employer` DOES `commence weekly payments` AT 9
    PARTY `the employer` DOES `notify the worker in writing of the decision on liability, or why none has been made` AT 20
-- expect: a breach of s 39(1), shown as FULFILLED AND (BREACH BY the employer ... OR BREACH BY the employer's licensed insurer ...) AND FULFILLED: no status notice from either by day 28
#TRACE `the claim rules` AT 0 WITH
    PARTY `the employer` DOES `notify the insurer of the claim` AT 3
    PARTY `the employer` DOES `forward the completed claim and a copy to the licensed insurer` AT 6
    PARTY `the employer` DOES `commence weekly payments` AT 8
    (WAITUNTIL 29)
-- A self-insurer: only the s 39 and s 81 duties; met.
#ASSERT EVALTRACE (`ss 36, 39, 81 -- the employer's duties on receiving a claim` FALSE TRUE `Mia's spans`) 0 (LIST (EVENT `the employer` `commence weekly payments` 8), (EVENT `the employer` `notify the worker in writing of the decision on liability, or why none has been made` 28)) EQUALS FULFILLED
-- A claim for expenses only, not weekly payments: s 36 and s 39 only; met.
#ASSERT EVALTRACE (`ss 36, 39, 81 -- the employer's duties on receiving a claim` TRUE FALSE `Mia's spans`) 0 (LIST (EVENT `the employer` `notify the insurer of the claim` 1), (EVENT `the employer` `forward the completed claim and a copy to the licensed insurer` 1), (EVENT `the employer` `notify the worker in writing of the decision on liability, or why none has been made` 10)) EQUALS FULFILLED

-- s 33A, day 0 the day the employer is informed (2 March 2026): informed the worker on day 10, met. Informed by the claim:
-- nothing owed.
#ASSERT EVALTRACE (`s 33A -- the employer must inform the worker of the right to claim within 14 days` FALSE) 0 (LIST (EVENT `the employer` `inform the worker of the right to claim, in the Schedule 1 form` 10)) EQUALS FULFILLED
#ASSERT EVALTRACE (`s 33A -- the employer must inform the worker of the right to claim within 14 days` TRUE) 0 (LIST (WAITUNTIL 30)) EQUALS FULFILLED
-- expect: BREACH BY the employer, "s 33A(1): the employer must, within 14 days of being informed of the injury, inform the worker ..." (nothing by day 14)
#TRACE `s 33A -- the employer must inform the worker of the right to claim within 14 days` FALSE AT 0 WITH
    (WAITUNTIL 15)

-- s 81A, day 0 the day the claim is received: the employer disputes and does all three steps on day 80: met.
#ASSERT EVALTRACE (`s 81A -- an employer who disputes liability must serve notice with reasons and refer it within 84 days` TRUE) 0 (LIST (EVENT `the employer` `serve notice disputing liability, give the reasons and refer the matter to the Tribunal` 80)) EQUALS FULFILLED
-- An employer that does not dispute owes nothing under s 81A.
#ASSERT EVALTRACE (`s 81A -- an employer who disputes liability must serve notice with reasons and refer it within 84 days` FALSE) 0 (LIST (WAITUNTIL 100)) EQUALS FULFILLED
-- expect: BREACH BY the employer, "s 81A(1), s 81AB: liability was not disputed in accordance with s 81A within 84 days ..." (nothing by day 84)
#TRACE `s 81A -- an employer who disputes liability must serve notice with reasons and refer it within 84 days` TRUE AT 0 WITH
    (WAITUNTIL 85)

-- s 36(3): 180 days with no refusal, hindrance or dismissal: met. A dismissal for claiming on day 20: a breach.
#ASSERT EVALTRACE (`s 36(3) -- the employer must not refuse a claim, hinder a claim or dismiss the worker for claiming` 180) 0 (LIST (WAITUNTIL 181)) EQUALS FULFILLED
-- expect: BREACH BY the employer, "s 36(3)(b): dismissing a worker only for giving or trying to give a claim is an offence ..."
#TRACE `s 36(3) -- the employer must not refuse a claim, hinder a claim or dismiss the worker for claiming` 180 AT 0 WITH
    PARTY `the employer` DOES `dismiss the worker for giving a claim` AT 20

-- The worker. s 32(1)(a), day 0 the injury (2 March 2026), notice practicable within 7 days: told the supervisor on day 0.
#ASSERT EVALTRACE (`s 32(1)(a) -- the worker must give notice of the injury as soon as practicable` 7) 0 (LIST (EVENT `the worker` `give notice of the injury` 0)) EQUALS FULFILLED
-- expect: BREACH BY the worker, "s 32(1)(a): no entitlement to compensation unless notice of the injury was given ..." (nothing by day 7)
#TRACE `s 32(1)(a) -- the worker must give notice of the injury as soon as practicable` 7 AT 0 WITH
    (WAITUNTIL 8)
-- s 32(1)(b): 2 March to 2 September 2026 is 184 days. Claim on day 9 (11 March): met.
#ASSERT `days from` (`the calendar date` 2 3 2026) `to` (`the calendar date` 2 9 2026) EQUALS 184
#ASSERT EVALTRACE (`s 32(1)(b) -- the worker must make the claim within 6 months` 184) 0 (LIST (EVENT `the worker` `make the claim for compensation` 9)) EQUALS FULFILLED
-- expect: BREACH BY the worker, "s 32(1)(b): no entitlement to compensation unless the claim ... is made within 6 months ..." (claim on day 185)
#TRACE `s 32(1)(b) -- the worker must make the claim within 6 months` 184 AT 0 WITH
    PARTY `the worker` DOES `make the claim for compensation` AT 185
