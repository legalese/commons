#ASSERT `s 319(5) -- by what day must I apply for a costs assessment` FALSE `any day` (`the calendar date` 10 1 2026) EQUALS `the calendar date` 11 3 2026

#ASSERT `s 319 -- can my costs be assessed` TRUE (`the calendar date` 1 6 2026) `any day` (`the calendar date` 31 7 2026) FALSE FALSE EQUALS `IN TIME`
#ASSERT `s 319 -- can my costs be assessed` TRUE (`the calendar date` 1 6 2026) `any day` (`the calendar date` 1 8 2026) FALSE FALSE EQUALS `COURT MAY EXTEND`
#ASSERT `s 319 -- can my costs be assessed` TRUE (`the calendar date` 1 6 2026) `any day` (`the calendar date` 1 8 2026) TRUE FALSE EQUALS `NO EXTENSION`
#ASSERT `s 319 -- can my costs be assessed` TRUE (`the calendar date` 1 6 2026) `any day` (`the calendar date` 31 7 2026) TRUE FALSE EQUALS `IN TIME`
#ASSERT `s 319 -- can my costs be assessed` TRUE (`the calendar date` 1 6 2026) `any day` (`the calendar date` 10 6 2026) TRUE TRUE EQUALS `CONTRACTED OUT`
-- Contracting out claimed by a client who is not sophisticated has no effect.
#ASSERT `s 319 -- can my costs be assessed` TRUE (`the calendar date` 1 6 2026) `any day` (`the calendar date` 10 6 2026) FALSE TRUE EQUALS `IN TIME`

#ASSERT `s 321(4) -- from what day can the law practice apply for assessment` TRUE (`the calendar date` 1 6 2026) `any day` FALSE `any day` EQUALS `the calendar date` 1 7 2026
#ASSERT `s 321(4) -- from what day can the law practice apply for assessment` TRUE (`the calendar date` 1 6 2026) `any day` TRUE (`the calendar date` 15 6 2026) EQUALS `the calendar date` 1 7 2026
#ASSERT `s 321(4) -- from what day can the law practice apply for assessment` FALSE `any day` (`the calendar date` 10 1 2026) FALSE `any day` EQUALS `the calendar date` 9 2 2026
-- s 319(4): a client who paid without a bill applied on 5 May; the law practice billed on 1 June. (c) comes first:
-- 5 May + 30 = 4 June, not 1 July.
#ASSERT `s 321(4) -- from what day can the law practice apply for assessment` TRUE (`the calendar date` 1 6 2026) `any day` TRUE (`the calendar date` 5 5 2026) EQUALS `the calendar date` 4 6 2026

