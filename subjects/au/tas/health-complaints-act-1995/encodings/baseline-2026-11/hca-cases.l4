#ASSERT `Must my identity be kept from the provider` TRUE EQUALS JUST TRUE
#ASSERT `Must my identity be kept from the provider` FALSE EQUALS NOTHING
#ASSERT `Am I protected from being sued for complaining` TRUE EQUALS JUST TRUE
#ASSERT `Am I protected from being sued for complaining` FALSE EQUALS NOTHING

