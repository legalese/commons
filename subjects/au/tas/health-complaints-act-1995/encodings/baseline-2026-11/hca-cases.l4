#ASSERT `Was the reprisal an offence` TRUE TRUE TRUE TRUE EQUALS `this section gives the person a defence on these facts`
#ASSERT `Was the reprisal an offence` TRUE FALSE FALSE FALSE EQUALS `not an offence under this section on these facts`
#ASSERT `Was the reprisal an offence` FALSE TRUE FALSE FALSE EQUALS `not an offence under this section on these facts`

