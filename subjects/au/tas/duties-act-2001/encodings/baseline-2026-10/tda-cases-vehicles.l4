IMPORT prelude
IMPORT `tda-common`
IMPORT `tda-vehicles`

-- Cases for the seat-neutral core of Duties Act 2001 Chapter 8 (tda-vehicles.l4). Every expected value was worked by
-- hand from s 197 and s 198 of the deposited text (act-2001-015.txt); the arithmetic is in the comment above each. The
-- vehicles are the encoder's, HYPOTHETICAL. "per $100, or part": a part of $100 counts as a whole $100.

`case: new registration` MEANS `an application to register a vehicle not previously registered under the Vehicle and Traffic Act 1999`
`case: transfer` MEANS `an application to register a vehicle in a name or names different from its last registration`

-- A vehicle, by kind. Arguments: dealing, heavy, motor cycle, for passengers, off-road or truck chassis, ute body,
-- more than 9 seats, new, fleet discount, price, market value, Commissioner satisfied the price is adequate.
GIVEN `dealing` IS A `Vehicle dealing`, `heavy` IS A BOOLEAN, `motor cycle` IS A BOOLEAN, `for passengers` IS A BOOLEAN
      `off-road` IS A BOOLEAN, `ute` IS A BOOLEAN, `more than 9` IS A BOOLEAN, `new` IS A BOOLEAN, `fleet` IS A BOOLEAN
      `price` IS A NUMBER, `market value` IS A NUMBER, `adequate` IS A BOOLEAN
GIVETH A `Vehicle facts`
`case: vehicle` `dealing` `heavy` `motor cycle` `for passengers` `off-road` `ute` `more than 9` `new` `fleet` `price` `market value` `adequate` MEANS
    `Vehicle facts` WITH
        `the day of the application`                                                             IS YearMonthDay 2026 10 24
        `the dealing`                                                                            IS `dealing`
        `is a heavy vehicle (Heavy Vehicle National Law, not a camper van)`                      IS `heavy`
        `is a motor cycle`                                                                       IS `motor cycle`
        `is constructed principally for the carriage of passengers`                              IS `for passengers`
        `is designed for not more than 9 adults and built on a truck chassis or with off-road features` IS `off-road`
        `has a utility or panel van body whose forward part and mechanics are those of the maker's passenger vehicle` IS `ute`
        `is equipped to seat more than 9 adults, including the driver`                           IS `more than 9`
        `is a new motor vehicle`                                                                 IS `new`
        `the manufacturer gave the purchaser a discount off the normal retail price not available to the general public` IS `fleet`
        `the consideration`                                                                      IS `price`
        `the market value`                                                                       IS `market value`
        `the Commissioner is satisfied the consideration is adequate for the value of the new vehicle (s 198(1A))` IS `adequate`
        `an exemption under ss 199 to 203 is claimed`                                            IS FALSE

-- A used sedan bought for `price`, worth `price`.
GIVEN `price` IS A NUMBER
GIVETH A `Vehicle facts`
`case: used car` `price` MEANS
    `case: vehicle` `case: transfer` FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE `price` `price` FALSE

GIVEN `v` IS A `Vehicle facts`
GIVETH A NUMBER
`case: duty` `v` MEANS
    CONSIDER `the vehicle duty on` `v`
    WHEN `the vehicle duty, in dollars, is` `d` `r` THEN `d`
    OTHERWISE -1

-- =====================================================================================================================
-- s 197(4)-(5): passenger vehicle.
-- =====================================================================================================================

#ASSERT `is a passenger vehicle (s 197(4)-(5))` (`case: used car` 25000)
-- A four-wheel drive seating 7, built with off-road features (s 197(4)(b)).
#ASSERT `is a passenger vehicle (s 197(4)-(5))` (`case: vehicle` `case: transfer` FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE 60000 60000 FALSE)
-- A ute whose front and mechanics are the maker's passenger car (s 197(5)(a)): not a passenger vehicle.
#ASSERT (NOT `is a passenger vehicle (s 197(4)-(5))` (`case: vehicle` `case: transfer` FALSE FALSE TRUE FALSE TRUE FALSE FALSE FALSE 45000 45000 FALSE))
-- A 12-seat minibus (s 197(5)(b)): not.
#ASSERT (NOT `is a passenger vehicle (s 197(4)-(5))` (`case: vehicle` `case: transfer` FALSE FALSE TRUE FALSE FALSE TRUE FALSE FALSE 50000 50000 FALSE))
-- A motor cycle, and a heavy vehicle (s 197(4)): not.
#ASSERT (NOT `is a passenger vehicle (s 197(4)-(5))` (`case: vehicle` `case: transfer` FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE 15000 15000 FALSE))
#ASSERT (NOT `is a passenger vehicle (s 197(4)-(5))` (`case: vehicle` `case: transfer` TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE 150000 150000 FALSE))

-- =====================================================================================================================
-- s 197(2): passenger vehicles.
-- =====================================================================================================================

-- $25 000: 3 x 250 = 750.
#ASSERT `case: duty` (`case: used car` 25000) EQUALS 750
-- $25 050: 3 x 251 = 753.
#ASSERT `case: duty` (`case: used car` 25050) EQUALS 753
-- $35 000: 3 x 350 = 1 050.
#ASSERT `case: duty` (`case: used car` 35000) EQUALS 1050
-- $35 001: 1 050 + 11 x 1 = 1 061.
#ASSERT `case: duty` (`case: used car` 35001) EQUALS 1061
-- $38 000: 1 050 + 11 x 30 = 1 380 (11% at the margin: finding 12).
#ASSERT `case: duty` (`case: used car` 38000) EQUALS 1380
-- $38 050: 1 050 + 11 x 31 = 1 391.
#ASSERT `case: duty` (`case: used car` 38050) EQUALS 1391
-- $40 000: 1 050 + 11 x 50 = 1 600.
#ASSERT `case: duty` (`case: used car` 40000) EQUALS 1600
-- $40 001: 4 x 401 (on the whole value) = 1 604.
#ASSERT `case: duty` (`case: used car` 40001) EQUALS 1604
-- $60 000: 4 x 600 = 2 400.
#ASSERT `case: duty` (`case: used car` 60000) EQUALS 2400
-- The 7-seat four-wheel drive at $60 000: also 2 400.
#ASSERT `case: duty` (`case: vehicle` `case: transfer` FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE 60000 60000 FALSE) EQUALS 2400

-- =====================================================================================================================
-- s 197(1), (3), (3A), (3B).
-- =====================================================================================================================

-- The ute at $45 000: the general rate, 3 x 450 = 1 350.
#ASSERT `case: duty` (`case: vehicle` `case: transfer` FALSE FALSE TRUE FALSE TRUE FALSE FALSE FALSE 45000 45000 FALSE) EQUALS 1350
#ASSERT `the s 197 rate for` (`case: vehicle` `case: transfer` FALSE FALSE TRUE FALSE TRUE FALSE FALSE FALSE 45000 45000 FALSE) EQUALS `the general rate, $3 per $100 or part (s 197(1))`
-- The minibus at $50 000: 3 x 500 = 1 500 (the passenger vehicle rate would have given 2 000).
#ASSERT `case: duty` (`case: vehicle` `case: transfer` FALSE FALSE TRUE FALSE FALSE TRUE FALSE FALSE 50000 50000 FALSE) EQUALS 1500
-- The motor cycle at $15 000: 3 x 150 = 450.
#ASSERT `case: duty` (`case: vehicle` `case: transfer` FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE 15000 15000 FALSE) EQUALS 450
-- A heavy vehicle at $150 000: 1 x 1 500 = 1 500 (s 197(3B)).
#ASSERT `case: duty` (`case: vehicle` `case: transfer` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 150000 150000 FALSE) EQUALS 1500
-- Heavy vehicles at $1 500 and $2 000: $20 (s 197(3)); at $2 001: 1 x 21 = 21.
#ASSERT `case: duty` (`case: vehicle` `case: transfer` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 1500 1500 FALSE) EQUALS 20
#ASSERT `case: duty` (`case: vehicle` `case: transfer` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 2000 2000 FALSE) EQUALS 20
#ASSERT `case: duty` (`case: vehicle` `case: transfer` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 2001 2001 FALSE) EQUALS 21
-- A car at $500 and at $600: $20 (s 197(3); (2)(a) would give $15 and $18); at $601: 3 x 7 = 21.
#ASSERT `case: duty` (`case: used car` 500) EQUALS 20
#ASSERT `case: duty` (`case: used car` 600) EQUALS 20
#ASSERT `case: duty` (`case: used car` 601) EQUALS 21
-- A new car bought with a manufacturer's fleet discount (s 197(3A)), price accepted as adequate:
-- $30 000: 3.50 x 300 = 1 050, more than the 900 a buyer without the discount pays (finding 12);
#ASSERT `case: duty` (`case: vehicle` `case: new registration` FALSE FALSE TRUE FALSE FALSE FALSE TRUE TRUE 30000 30000 TRUE) EQUALS 1050
#ASSERT `case: duty` (`case: vehicle` `case: new registration` FALSE FALSE TRUE FALSE FALSE FALSE TRUE FALSE 30000 30000 TRUE) EQUALS 900
-- $50 000: 3.50 x 500 = 1 750, less than the 2 000 at the passenger rate.
#ASSERT `case: duty` (`case: vehicle` `case: new registration` FALSE FALSE TRUE FALSE FALSE FALSE TRUE TRUE 50000 50000 TRUE) EQUALS 1750
-- A fleet discount on a used vehicle does not engage (3A), which is for a "new motor vehicle": the passenger rate, 2 000.
#ASSERT `case: duty` (`case: vehicle` `case: transfer` FALSE FALSE TRUE FALSE FALSE FALSE FALSE TRUE 50000 50000 FALSE) EQUALS 2000

-- =====================================================================================================================
-- s 198: dutiable value.
-- =====================================================================================================================

-- A used car bought for $18 000 with a market value of $20 000: the greater, 20 000; duty 3 x 200 = 600.
#ASSERT `the dutiable value of the vehicle (s 198)` (`case: vehicle` `case: transfer` FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE 18000 20000 FALSE) EQUALS 20000
#ASSERT `case: duty` (`case: vehicle` `case: transfer` FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE 18000 20000 FALSE) EQUALS 600
-- A new car for $45 000, market value $47 000, price accepted as adequate (s 198(1A)): 45 000; duty 4 x 450 = 1 800.
#ASSERT `the dutiable value of the vehicle (s 198)` (`case: vehicle` `case: new registration` FALSE FALSE TRUE FALSE FALSE FALSE TRUE FALSE 45000 47000 TRUE) EQUALS 45000
#ASSERT `case: duty` (`case: vehicle` `case: new registration` FALSE FALSE TRUE FALSE FALSE FALSE TRUE FALSE 45000 47000 TRUE) EQUALS 1800
-- ... not accepted: the greater, 47 000; duty 4 x 470 = 1 880.
#ASSERT `case: duty` (`case: vehicle` `case: new registration` FALSE FALSE TRUE FALSE FALSE FALSE TRUE FALSE 45000 47000 FALSE) EQUALS 1880

-- =====================================================================================================================
-- s 192 what is charged; s 195 who pays; not covered.
-- =====================================================================================================================

#ASSERT `the vehicle duty on` (`case: vehicle` `an application to register a vehicle in the same name or names as its last registration` FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE 20000 20000 FALSE) EQUALS `no duty: the application is not charged (s 192)`
#ASSERT `the vehicle duty on` (`case: vehicle` `a notice of a change of beneficial ownership` FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE 20000 20000 FALSE) EQUALS `the vehicle duty, in dollars, is` 600 `the passenger vehicle rate (s 197(2))`
#ASSERT `who pays the vehicle duty (s 195)` `a notice of a change of beneficial ownership` EQUALS `the person acquiring the beneficial ownership (s 195(b))`
#ASSERT `who pays the vehicle duty (s 195)` `case: new registration` EQUALS `the applicant for registration (s 195(a))`
#ASSERT `who pays the vehicle duty (s 195)` `an application to register a vehicle in the same name or names as its last registration` EQUALS `no one: the application is not charged (s 192)`
`case: exempt claim` MEANS
    `Vehicle facts` WITH
        `the day of the application`                                                             IS YearMonthDay 2026 10 24
        `the dealing`                                                                            IS `case: transfer`
        `is a heavy vehicle (Heavy Vehicle National Law, not a camper van)`                      IS FALSE
        `is a motor cycle`                                                                       IS FALSE
        `is constructed principally for the carriage of passengers`                              IS TRUE
        `is designed for not more than 9 adults and built on a truck chassis or with off-road features` IS FALSE
        `has a utility or panel van body whose forward part and mechanics are those of the maker's passenger vehicle` IS FALSE
        `is equipped to seat more than 9 adults, including the driver`                           IS FALSE
        `is a new motor vehicle`                                                                 IS FALSE
        `the manufacturer gave the purchaser a discount off the normal retail price not available to the general public` IS FALSE
        `the consideration`                                                                      IS 20000
        `the market value`                                                                       IS 20000
        `the Commissioner is satisfied the consideration is adequate for the value of the new vehicle (s 198(1A))` IS FALSE
        `an exemption under ss 199 to 203 is claimed`                                            IS TRUE
#ASSERT `the vehicle duty on` `case: exempt claim` EQUALS `not covered` `an exemption under ss 199 to 203 is claimed for the vehicle: those exemptions are not encoded`
`case: 2006 application` MEANS
    `Vehicle facts` WITH
        `the day of the application`                                                             IS YearMonthDay 2006 6 1
        `the dealing`                                                                            IS `case: transfer`
        `is a heavy vehicle (Heavy Vehicle National Law, not a camper van)`                      IS FALSE
        `is a motor cycle`                                                                       IS FALSE
        `is constructed principally for the carriage of passengers`                              IS TRUE
        `is designed for not more than 9 adults and built on a truck chassis or with off-road features` IS FALSE
        `has a utility or panel van body whose forward part and mechanics are those of the maker's passenger vehicle` IS FALSE
        `is equipped to seat more than 9 adults, including the driver`                           IS FALSE
        `is a new motor vehicle`                                                                 IS FALSE
        `the manufacturer gave the purchaser a discount off the normal retail price not available to the general public` IS FALSE
        `the consideration`                                                                      IS 20000
        `the market value`                                                                       IS 20000
        `the Commissioner is satisfied the consideration is adequate for the value of the new vehicle (s 198(1A))` IS FALSE
        `an exemption under ss 199 to 203 is claimed`                                            IS FALSE
#ASSERT `the vehicle duty on` `case: 2006 application` EQUALS `not covered` `the vehicle application is dated before 1 October 2007, when the s 197 rates were last amended (No. 18 of 2007); the rates in force before then are not in the deposited consolidation`

-- =====================================================================================================================
-- ss 193(1), 195, 196, 196A (regulative). Clock: days from the application or notice.
-- =====================================================================================================================

-- Who is bound: for an application, the applicant lodges the statement and pays (ss 193(1), 195(a)); for a notice of
-- a change of beneficial ownership, the person giving the notice lodges the statement (s 193(1)) and the person
-- acquiring the beneficial ownership pays (s 195(b)).
#ASSERT `the party who must lodge the statement (s 193(1))` `case: new registration` EQUALS `the applicant to register the vehicle`
#ASSERT `the party who must lodge the statement (s 193(1))` `a notice of a change of beneficial ownership` EQUALS `the person giving the notice of a change of beneficial ownership`
#ASSERT `the party who must pay the vehicle duty (s 195)` `case: transfer` EQUALS `the applicant to register the vehicle`
#ASSERT `the party who must pay the vehicle duty (s 195)` `a notice of a change of beneficial ownership` EQUALS `the person acquiring the beneficial ownership`
-- Statement lodged with the application (day 0); registered on day 3 and duty paid that day: fulfilled.
#ASSERT EVALTRACE (`ss 193(1), 196, 196A -- lodge the value statement with the application or notice and pay when duty is payable` `case: new registration` 3) 0 (LIST (EVENT `the applicant to register the vehicle` `lodge a statement of the dutiable value with the application` 0), (EVENT `the applicant to register the vehicle` `pay the duty` 3)) EQUALS FULFILLED
-- Re-registration in the same name: not charged, nothing to lodge or pay.
#ASSERT EVALTRACE (`ss 193(1), 196, 196A -- lodge the value statement with the application or notice and pay when duty is payable` `an application to register a vehicle in the same name or names as its last registration` 3) 0 (LIST (WAITUNTIL 30)) EQUALS FULFILLED
-- A notice of a change of beneficial ownership: the giver lodges the statement with it, and the acquirer pays on the
-- day it is lodged (s 196(a)(ii)): fulfilled.
#ASSERT EVALTRACE (`ss 193(1), 196, 196A -- lodge the value statement with the application or notice and pay when duty is payable` `a notice of a change of beneficial ownership` 0) 0 (LIST (EVENT `the person giving the notice of a change of beneficial ownership` `lodge a statement of the dutiable value with the application` 0), (EVENT `the person acquiring the beneficial ownership` `pay the duty` 0)) EQUALS FULFILLED
-- expect: BREACH BY the applicant to register the vehicle, "s 193(1): a statement of the dutiable value must be lodged
-- with the application ..." (statement lodged a day later)
#TRACE `ss 193(1), 196, 196A -- lodge the value statement with the application or notice and pay when duty is payable` `case: transfer` 3 AT 0 WITH
    PARTY `the applicant to register the vehicle` DOES `lodge a statement of the dutiable value with the application` AT 1
    PARTY `the applicant to register the vehicle` DOES `pay the duty` AT 3
-- expect: BREACH BY the applicant to register the vehicle, "ss 195, 196, 196A: ... a tax default ..." (paid on day 10)
#TRACE `ss 193(1), 196, 196A -- lodge the value statement with the application or notice and pay when duty is payable` `case: transfer` 3 AT 0 WITH
    PARTY `the applicant to register the vehicle` DOES `lodge a statement of the dutiable value with the application` AT 0
    PARTY `the applicant to register the vehicle` DOES `pay the duty` AT 10
-- expect: BREACH BY the person acquiring the beneficial ownership, "ss 195, 196, 196A: ... a tax default ..." (a notice;
-- the statement lodged with it, the duty paid two days after the notice was lodged)
#TRACE `ss 193(1), 196, 196A -- lodge the value statement with the application or notice and pay when duty is payable` `a notice of a change of beneficial ownership` 0 AT 0 WITH
    PARTY `the person giving the notice of a change of beneficial ownership` DOES `lodge a statement of the dutiable value with the application` AT 0
    PARTY `the person acquiring the beneficial ownership` DOES `pay the duty` AT 2
