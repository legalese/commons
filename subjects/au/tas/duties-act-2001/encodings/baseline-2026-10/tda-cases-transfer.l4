IMPORT prelude
IMPORT `tda-common`
IMPORT `fhog-terms`
IMPORT `tda-transfer`

-- Cases for the seat-neutral core of Duties Act 2001 Chapter 2 (tda-transfer.l4) and the residence requirement
-- (tda-common.l4). Every expected value was worked by hand from the deposited text (act-2001-015.txt), never copied from
-- the encoding's output; the arithmetic is in the comment above each assertion. The buyers are the encoder's,
-- HYPOTHETICAL throughout; no scenario life raised this Act.
--
-- A breached or still-pending DEONTIC cannot be asserted on the stable l4, so regulative rules are asserted where the
-- trace ends FULFILLED, and #TRACEd with an "-- expect:" line where it does not. Clock: days, as DATE_SERIAL numbers.

-- =====================================================================================================================
-- Case-local builders (names prefixed "case:" so they cannot clash with the seat's).
-- =====================================================================================================================

GIVEN `age` IS A NUMBER, `citizen` IS A BOOLEAN, `owned` IS A BOOLEAN, `grant` IS A BOOLEAN, `had 2A` IS A BOOLEAN
      `had exemption` IS A BOOLEAN, `intends` IS A BOOLEAN
GIVETH A `Transferee`
`case: buyer` `age` `citizen` `owned` `grant` `had 2A` `had exemption` `intends` MEANS
    `Transferee` WITH
        `is the Commonwealth or Housing Australia under a Help to Buy arrangement`                          IS FALSE
        `is a natural person`                                                                              IS TRUE
        `age at the transfer`                                                                              IS `age`
        `the Commissioner exempts the age requirement (ss 46C(2), 57E(2))`                                 IS FALSE
        `is an Australian citizen or a permanent resident`                                                 IS `citizen`
        `the person or spouse has previously been the owner of a home in Tasmania or any other State or a Territory` IS `owned`
        `the person or spouse has previously been paid a first home owner grant under the FHOG Act 2000`   IS `grant`
        `a previous transfer to the person or spouse attracted a Division 2A concession`                   IS `had 2A`
        `no duty was charged on a previous transfer to the person or spouse under Part 6 Division 2`       IS `had exemption`
        `intends to meet the residence requirement`                                                        IS `intends`
        `holds a Pensioner Concession Card under a relevant Act of the Commonwealth`                       IS FALSE
        `holds a Seniors Health Card (Social Security Act 1991)`                                           IS FALSE
        `receives a special rate pension (Veterans' Entitlements Act 1986)`                                IS FALSE
        `a previous transfer to the person or spouse attracted a Division 2B concession`                   IS FALSE

-- A first home buyer: 28, citizen, never owned, no grant, no earlier relief, intends to live there.
`case: Alex` MEANS `case: buyer` 28 TRUE FALSE FALSE FALSE FALSE TRUE

GIVEN `age` IS A NUMBER, `pcc` IS A BOOLEAN, `shc` IS A BOOLEAN, `had 2B` IS A BOOLEAN
GIVETH A `Transferee`
`case: pensioner` `age` `pcc` `shc` `had 2B` MEANS
    `Transferee` WITH
        `is the Commonwealth or Housing Australia under a Help to Buy arrangement`                          IS FALSE
        `is a natural person`                                                                              IS TRUE
        `age at the transfer`                                                                              IS `age`
        `the Commissioner exempts the age requirement (ss 46C(2), 57E(2))`                                 IS FALSE
        `is an Australian citizen or a permanent resident`                                                 IS TRUE
        `the person or spouse has previously been the owner of a home in Tasmania or any other State or a Territory` IS TRUE
        `the person or spouse has previously been paid a first home owner grant under the FHOG Act 2000`   IS FALSE
        `a previous transfer to the person or spouse attracted a Division 2A concession`                   IS FALSE
        `no duty was charged on a previous transfer to the person or spouse under Part 6 Division 2`       IS FALSE
        `intends to meet the residence requirement`                                                        IS TRUE
        `holds a Pensioner Concession Card under a relevant Act of the Commonwealth`                       IS `pcc`
        `holds a Seniors Health Card (Social Security Act 1991)`                                           IS `shc`
        `receives a special rate pension (Veterans' Entitlements Act 1986)`                                IS FALSE
        `a previous transfer to the person or spouse attracted a Division 2B concession`                   IS `had 2B`

`case: Housing Australia` MEANS
    `Transferee` WITH
        `is the Commonwealth or Housing Australia under a Help to Buy arrangement`                          IS TRUE
        `is a natural person`                                                                              IS FALSE
        `age at the transfer`                                                                              IS 0
        `the Commissioner exempts the age requirement (ss 46C(2), 57E(2))`                                 IS FALSE
        `is an Australian citizen or a permanent resident`                                                 IS FALSE
        `the person or spouse has previously been the owner of a home in Tasmania or any other State or a Territory` IS FALSE
        `the person or spouse has previously been paid a first home owner grant under the FHOG Act 2000`   IS FALSE
        `a previous transfer to the person or spouse attracted a Division 2A concession`                   IS FALSE
        `no duty was charged on a previous transfer to the person or spouse under Part 6 Division 2`       IS FALSE
        `intends to meet the residence requirement`                                                        IS FALSE
        `holds a Pensioner Concession Card under a relevant Act of the Commonwealth`                       IS FALSE
        `holds a Seniors Health Card (Social Security Act 1991)`                                           IS FALSE
        `receives a special rate pension (Veterans' Entitlements Act 1986)`                                IS FALSE
        `a previous transfer to the person or spouse attracted a Division 2B concession`                   IS FALSE

GIVEN `lived in before` IS A BOOLEAN
GIVETH A `Building facts`
`case: a house` `lived in before` MEANS
    `Building facts` WITH
        `is a building affixed to land`                                               IS TRUE
        `may lawfully be used as a place of residence`                                IS TRUE
        `is, in the Commissioner's opinion, suitable for use as a place of residence` IS TRUE
        `has previously been occupied or sold as a place of residence`                IS `lived in before`
        `would be new residential premises because of substantial renovations (GST Act s 40-75(1)(b))` IS FALSE
        `has been occupied or sold as a place of residence since those renovations`   IS FALSE

`case: no former home` MEANS
    `Former home` WITH
        `the pensioner has a former home in Tasmania that they lived in as principal place of residence`  IS FALSE
        `the day it was or will be transferred`                                                         IS YMD 2000 1 1
        `its dutiable value when transferred`                                                           IS 0
        `it was the principal place of residence for the 6 months before it was transferred (or a lesser period approved)` IS FALSE
        `it was the principal place of residence for the 6 months before the new purchase (or a lesser period approved)`  IS FALSE
        `the new home is in the same name or names as the former home, or the Commissioner is satisfied of good reasons`  IS FALSE
        `the pensioner or spouse owned another home (not the former or new home) at the time of the purchase`             IS FALSE

GIVEN `sold` IS A DATE, `worth` IS A NUMBER, `lived before sale` IS A BOOLEAN, `lived before purchase` IS A BOOLEAN
      `same names` IS A BOOLEAN, `another home` IS A BOOLEAN
GIVETH A `Former home`
`case: former home` `sold` `worth` `lived before sale` `lived before purchase` `same names` `another home` MEANS
    `Former home` WITH
        `the pensioner has a former home in Tasmania that they lived in as principal place of residence`  IS TRUE
        `the day it was or will be transferred`                                                         IS `sold`
        `its dutiable value when transferred`                                                           IS `worth`
        `it was the principal place of residence for the 6 months before it was transferred (or a lesser period approved)` IS `lived before sale`
        `it was the principal place of residence for the 6 months before the new purchase (or a lesser period approved)`  IS `lived before purchase`
        `the new home is in the same name or names as the former home, or the Commissioner is satisfied of good reasons`  IS `same names`
        `the pensioner or spouse owned another home (not the former or new home) at the time of the purchase`             IS `another home`

GIVEN `day` IS A DATE, `price` IS A NUMBER, `building` IS A `Building facts`
      `buyers` IS A LIST OF `Transferee`
      `former` IS A `Former home`, `foreign` IS A BOOLEAN
GIVETH A `Home transfer`
`case: transfer` `day` `price` `building` `buyers` `former` `foreign` MEANS
    `Home transfer` WITH
        `the day of the transfer`                                                                          IS `day`
        `the consideration`                                                                                IS `price`
        `the unencumbered value`                                                                           IS `price`
        `the land has a building on it`                                                                    IS TRUE
        `the building`                                                                                     IS `building`
        `the transferees`                                                                                  IS `buyers`
        `the former home`                                                                                  IS `former`
        `the Commissioner is satisfied there are good reasons why a transferee is not an eligible first home buyer` IS FALSE
        `is effected by a written instrument`                                                              IS TRUE
        `a transferee is a foreign person`                                                                 IS `foreign`
        `is of a dwelling bought off the plan before its occupancy permit under an agreement signed from 1 July 2024` IS FALSE

-- Alex alone buys an established house at `price` on `day`.
GIVEN `day` IS A DATE, `price` IS A NUMBER
GIVETH A `Home transfer`
`case: Alex buys` `day` `price` MEANS
    `case: transfer` `day` `price` (`case: a house` TRUE) (LIST `case: Alex`) `case: no former home` FALSE

`case: text` MEANS `the settings in the deposited text`

-- Hypothetical extension orders (none is deposited): the s 57C and s 46J periods extended to 30 June 2027.
`case: extended` MEANS
    `Duty settings` WITH
        `the last day of the s 57C eligible period`    IS YMD 2027 6 30
        `the s 57F(1)(d) cap`                           IS 750000
        `the last day of the s 46A eligible period`    IS YMD 2024 6 30
        `the s 46D(1)(d) cap`                           IS 600000
        `the last day of the s 46J eligible period`    IS YMD 2027 6 30
        `the s 46M(c) cap`                              IS 600000

`case: exemption` MEANS `the first home buyer duty exemption (Part 6 Division 2)`
`case: 2A`        MEANS `the first home buyer duty concession (Part 5 Division 2A)`

-- =====================================================================================================================
-- s 29: the general rate, band by band. Each band: base + rate x (number of $100 or part above the floor).
-- =====================================================================================================================

-- Not more than $3 000: $50.
#ASSERT `the duty at the s 29 general rate on` 2000 EQUALS 50
#ASSERT `the duty at the s 29 general rate on` 3000 EQUALS 50
-- $3 001: 50 + 1.75 x 1 (the $1 above $3 000 is a "part" of $100) = 51.75.
#ASSERT `the duty at the s 29 general rate on` 3001 EQUALS 51.75
-- $25 000: 50 + 1.75 x 220 = 435, which is the next band's base: the scale is continuous.
#ASSERT `the duty at the s 29 general rate on` 25000 EQUALS 435
-- $25 050: 435 + 2.25 x 1 = 437.25.
#ASSERT `the duty at the s 29 general rate on` 25050 EQUALS 437.25
-- $75 000: 435 + 2.25 x 500 = 1 560 (the next base).
#ASSERT `the duty at the s 29 general rate on` 75000 EQUALS 1560
-- $100 000: 1 560 + 3.50 x 250 = 2 435.
#ASSERT `the duty at the s 29 general rate on` 100000 EQUALS 2435
-- $200 000: 1 560 + 3.50 x 1 250 = 5 935 (the next base).
#ASSERT `the duty at the s 29 general rate on` 200000 EQUALS 5935
-- $300 000: 5 935 + 4 x 1 000 = 9 935.
#ASSERT `the duty at the s 29 general rate on` 300000 EQUALS 9935
-- $350 050.50: 150 050.50 above $200 000 is 1 501 parts; 5 935 + 4 x 1 501 = 11 939.
#ASSERT `the duty at the s 29 general rate on` 350050.50 EQUALS 11939
-- $375 000: 5 935 + 4 x 1 750 = 12 935 (the next base).
#ASSERT `the duty at the s 29 general rate on` 375000 EQUALS 12935
-- $400 000: 12 935 + 4.25 x 250 = 13 997.50.
#ASSERT `the duty at the s 29 general rate on` 400000 EQUALS 13997.50
-- $450 000: 12 935 + 4.25 x 750 = 16 122.50.
#ASSERT `the duty at the s 29 general rate on` 450000 EQUALS 16122.50
-- $500 000: 12 935 + 4.25 x 1 250 = 18 247.50.
#ASSERT `the duty at the s 29 general rate on` 500000 EQUALS 18247.50
-- $600 000: 12 935 + 4.25 x 2 250 = 22 497.50.
#ASSERT `the duty at the s 29 general rate on` 600000 EQUALS 22497.50
-- $650 000: 12 935 + 4.25 x 2 750 = 24 622.50.
#ASSERT `the duty at the s 29 general rate on` 650000 EQUALS 24622.50
-- $700 000: 12 935 + 4.25 x 3 250 = 26 747.50.
#ASSERT `the duty at the s 29 general rate on` 700000 EQUALS 26747.50
-- $725 000: 12 935 + 4.25 x 3 500 = 27 810 (the top band's base).
#ASSERT `the duty at the s 29 general rate on` 725000 EQUALS 27810
-- $750 000: 27 810 + 4.50 x 250 = 28 935.
#ASSERT `the duty at the s 29 general rate on` 750000 EQUALS 28935
-- $760 000: 27 810 + 4.50 x 350 = 29 385.
#ASSERT `the duty at the s 29 general rate on` 760000 EQUALS 29385
-- $1 000 000: 27 810 + 4.50 x 2 750 = 40 185.
#ASSERT `the duty at the s 29 general rate on` 1000000 EQUALS 40185

-- =====================================================================================================================
-- ss 18-20 dutiable value; s 12 joint tenants; s 32 Help to Buy.
-- =====================================================================================================================

-- s 18(1): the greater of a $480 000 price and a $500 000 unencumbered value.
#ASSERT `the dutiable value (s 18(1))` 480000 500000 EQUALS 500000
-- A $520 000 price (including a $20 000 debt taken over, s 19(1)) and a $500 000 value: $520 000.
#ASSERT `the dutiable value (s 18(1))` 520000 500000 EQUALS 520000
-- s 12: two joint tenants each hold one half; three, one third.
#ASSERT `the share of each joint tenant (s 12)` 2 EQUALS 0.5
#ASSERT `the share of each joint tenant (s 12)` 4 EQUALS 0.25
-- s 32: Alex buys with Housing Australia under Help to Buy; only Alex counts.
#ASSERT count (`the transferees counted (s 32)` (`case: transfer` (YMD 2026 8 1) 500000 (`case: a house` TRUE) (LIST `case: Alex`, `case: Housing Australia`) `case: no former home` FALSE)) EQUALS 1
-- ... so the exemption test sees no transferee who is not a natural person. On 1 August 2026 it fails only on the
-- period (finding 1); under a hypothetical extension to 30 June 2027 it passes.
#ASSERT `the first home buyer test under` `case: exemption` `case: extended` (`case: transfer` (YMD 2026 8 1) 500000 (`case: a house` TRUE) (LIST `case: Alex`, `case: Housing Australia`) `case: no former home` FALSE) EQUALS `yes: the transfer is an eligible transaction`

-- =====================================================================================================================
-- Part 6 Division 2: the first home buyer duty exemption (as deposited, 18 February 2024 to 30 June 2026, $750 000).
-- =====================================================================================================================

-- CASE A1. Alex, alone, buys an established house in Launceston for $500 000, transferred 1 March 2025: inside the
-- period, under the cap, eligible, intends to live there. Eligible transaction; duty nil (s 57G).
#ASSERT `the first home buyer test under` `case: exemption` `case: text` (`case: Alex buys` (YMD 2025 3 1) 500000) EQUALS `yes: the transfer is an eligible transaction`
#ASSERT `the transfer duty on` `case: text` (`case: Alex buys` (YMD 2025 3 1) 500000) EQUALS `the duty, in dollars, is` 0 `nil: the first home buyer duty exemption (s 57G)`

-- CASE A2 (finding 1). The same purchase transferred on 1 October 2026: after 30 June 2026, so not an eligible
-- transaction. No other relief: s 29 on $500 000 = 18 247.50.
#ASSERT `the first home buyer test under` `case: exemption` `case: text` (`case: Alex buys` (YMD 2026 10 1) 500000) EQUALS `no: the transfer is outside the eligible period` (YMD 2024 2 18) (YMD 2026 6 30)
#ASSERT `the transfer duty on` `case: text` (`case: Alex buys` (YMD 2026 10 1) 500000) EQUALS `the duty, in dollars, is` 18247.50 `the general rate (s 29)`
-- ... and the other side: had a s 57D order extended the period to 30 June 2027, duty would be nil.
#ASSERT `the transfer duty on` `case: extended` (`case: Alex buys` (YMD 2026 10 1) 500000) EQUALS `the duty, in dollars, is` 0 `nil: the first home buyer duty exemption (s 57G)`
-- The last day of the period, 30 June 2026, is inside it; the first, 18 February 2024, too; 17 February 2024 is not.
#ASSERT `the transfer duty on` `case: text` (`case: Alex buys` (YMD 2026 6 30) 500000) EQUALS `the duty, in dollars, is` 0 `nil: the first home buyer duty exemption (s 57G)`
#ASSERT `the first home buyer test under` `case: exemption` `case: text` (`case: Alex buys` (YMD 2024 2 18) 500000) EQUALS `yes: the transfer is an eligible transaction`
#ASSERT `the first home buyer test under` `case: exemption` `case: text` (`case: Alex buys` (YMD 2024 2 17) 500000) EQUALS `no: the transfer is outside the eligible period` (YMD 2024 2 18) (YMD 2026 6 30)

-- CASE A3. The cap: $750 000 exactly is not over it (nil); $760 000 is, and pays the general rate, 29 385.
#ASSERT `the transfer duty on` `case: text` (`case: Alex buys` (YMD 2025 3 1) 750000) EQUALS `the duty, in dollars, is` 0 `nil: the first home buyer duty exemption (s 57G)`
#ASSERT `the first home buyer test under` `case: exemption` `case: text` (`case: Alex buys` (YMD 2025 3 1) 760000) EQUALS `no: the dutiable value is over the cap` 750000
#ASSERT `the transfer duty on` `case: text` (`case: Alex buys` (YMD 2025 3 1) 760000) EQUALS `the duty, in dollars, is` 29385 `the general rate (s 29)`

-- CASE A4. A new home (never lived in or sold as a home) is not an established home: no exemption; s 29 applies.
#ASSERT `the first home buyer test under` `case: exemption` `case: text` (`case: transfer` (YMD 2025 3 1) 500000 (`case: a house` FALSE) (LIST `case: Alex`) `case: no former home` FALSE) EQUALS `no: the land has no established home on it`
#ASSERT `the transfer duty on` `case: text` (`case: transfer` (YMD 2025 3 1) 500000 (`case: a house` FALSE) (LIST `case: Alex`) `case: no former home` FALSE) EQUALS `the duty, in dollars, is` 18247.50 `the general rate (s 29)`

-- CASE A5. Bars on the buyer (s 57E(4)), each alone.
-- (a) Alex's spouse owned a home (even an investment property: finding 2): not eligible.
#ASSERT `the first home buyer test under` `case: exemption` `case: text` (`case: transfer` (YMD 2025 3 1) 500000 (`case: a house` TRUE) (LIST `case: buyer` 28 TRUE TRUE FALSE FALSE FALSE TRUE) `case: no former home` FALSE) EQUALS `no: a transferee is not an eligible first home buyer` `a transferee or their spouse has previously been the owner of a home`
-- (b) a first home owner grant was paid before.
#ASSERT `the first home buyer test under` `case: exemption` `case: text` (`case: transfer` (YMD 2025 3 1) 500000 (`case: a house` TRUE) (LIST `case: buyer` 28 TRUE FALSE TRUE FALSE FALSE TRUE) `case: no former home` FALSE) EQUALS `no: a transferee is not an eligible first home buyer` `a transferee or their spouse has previously been paid a first home owner grant`
-- (c) a Division 2A concession before.
#ASSERT `the first home buyer test under` `case: exemption` `case: text` (`case: transfer` (YMD 2025 3 1) 500000 (`case: a house` TRUE) (LIST `case: buyer` 28 TRUE FALSE FALSE TRUE FALSE TRUE) `case: no former home` FALSE) EQUALS `no: a transferee is not an eligible first home buyer` `a previous transfer to a transferee or their spouse attracted a Division 2A concession`
-- (d) a Part 6 Division 2 exemption before.
#ASSERT `the first home buyer test under` `case: exemption` `case: text` (`case: transfer` (YMD 2025 3 1) 500000 (`case: a house` TRUE) (LIST `case: buyer` 28 TRUE FALSE FALSE FALSE TRUE TRUE) `case: no former home` FALSE) EQUALS `no: a transferee is not an eligible first home buyer` `no duty was charged on a previous transfer to a transferee or their spouse under Part 6 Division 2`
-- under 18, not exempted.
#ASSERT `the first home buyer test under` `case: exemption` `case: text` (`case: transfer` (YMD 2025 3 1) 500000 (`case: a house` TRUE) (LIST `case: buyer` 17 TRUE FALSE FALSE FALSE FALSE TRUE) `case: no former home` FALSE) EQUALS `no: a transferee is not an eligible first home buyer` `a transferee is under 18 and the Commissioner has not exempted them`
-- alone and not a citizen or permanent resident.
#ASSERT `the first home buyer test under` `case: exemption` `case: text` (`case: transfer` (YMD 2025 3 1) 500000 (`case: a house` TRUE) (LIST `case: buyer` 28 FALSE FALSE FALSE FALSE FALSE TRUE) `case: no former home` FALSE) EQUALS `no: a transferee is not an eligible first home buyer` `no transferee is an Australian citizen or a permanent resident`
-- does not intend to live there.
#ASSERT `the first home buyer test under` `case: exemption` `case: text` (`case: transfer` (YMD 2025 3 1) 500000 (`case: a house` TRUE) (LIST `case: buyer` 28 TRUE FALSE FALSE FALSE FALSE FALSE) `case: no former home` FALSE) EQUALS `no: the Commissioner is not satisfied that each transferee intends to meet the residence requirement`
-- s 57F(2): the Commissioner is satisfied of good reasons why a transferee (here one whose spouse owned a home) is not an
-- eligible first home buyer: (1)(b) does not apply, and the transfer is an eligible transaction.
`case: good reasons transfer` MEANS
    `Home transfer` WITH
        `the day of the transfer`                                                                          IS YMD 2025 3 1
        `the consideration`                                                                                IS 500000
        `the unencumbered value`                                                                           IS 500000
        `the land has a building on it`                                                                    IS TRUE
        `the building`                                                                                     IS `case: a house` TRUE
        `the transferees`                                                                                  IS LIST `case: buyer` 28 TRUE TRUE FALSE FALSE FALSE TRUE
        `the former home`                                                                                  IS `case: no former home`
        `the Commissioner is satisfied there are good reasons why a transferee is not an eligible first home buyer` IS TRUE
        `is effected by a written instrument`                                                              IS TRUE
        `a transferee is a foreign person`                                                                 IS FALSE
        `is of a dwelling bought off the plan before its occupancy permit under an agreement signed from 1 July 2024` IS FALSE
#ASSERT `the first home buyer test under` `case: exemption` `case: text` `case: good reasons transfer` EQUALS `yes: the transfer is an eligible transaction`

-- CASE A6 (finding 8). Alex (citizen) buys with Kai, 27, on a temporary visa (a foreign person), both first home buyers,
-- on 1 March 2025: s 57E(3) lets Kai share the exemption, and s 57G makes duty "not chargeable under this Chapter" --
-- Part 3A included. Nil.
#ASSERT `the transfer duty on` `case: text` (`case: transfer` (YMD 2025 3 1) 500000 (`case: a house` TRUE) (LIST `case: Alex`, `case: buyer` 27 FALSE FALSE FALSE FALSE FALSE TRUE) `case: no former home` TRUE) EQUALS `the duty, in dollars, is` 0 `nil: the first home buyer duty exemption (s 57G)`
-- ... the same on 1 October 2026: no relief, and Part 3A (not encoded) applies to Kai's share: not covered.
#ASSERT `the transfer duty on` `case: text` (`case: transfer` (YMD 2026 10 1) 500000 (`case: a house` TRUE) (LIST `case: Alex`, `case: buyer` 27 FALSE FALSE FALSE FALSE FALSE TRUE) `case: no former home` TRUE) EQUALS `not covered` `a transferee is a foreign person: Part 3A additional duty for foreign purchasers (and the s 30J exemption) is not encoded`
-- ... and two joint buyers neither of whom is a citizen or resident: no transferee qualifies (s 57E(1)(c), (3)).
#ASSERT `the first home buyer test under` `case: exemption` `case: text` (`case: transfer` (YMD 2025 3 1) 500000 (`case: a house` TRUE) (LIST `case: buyer` 30 FALSE FALSE FALSE FALSE FALSE TRUE, `case: buyer` 27 FALSE FALSE FALSE FALSE FALSE TRUE) `case: no former home` TRUE) EQUALS `no: a transferee is not an eligible first home buyer` `no transferee is an Australian citizen or a permanent resident`

-- Not covered: a transfer before 21 October 2013, and an off-the-plan Division 2C purchase.
#ASSERT `the transfer duty on` `case: text` (`case: Alex buys` (YMD 2012 6 1) 300000) EQUALS `not covered` `the transfer is dated before 21 October 2013, when the s 29 scale was last amended (No. 41 of 2013); the scale in force before then is not in the deposited consolidation`
`case: off the plan transfer` MEANS
    `Home transfer` WITH
        `the day of the transfer`                                                                          IS YMD 2026 2 1
        `the consideration`                                                                                IS 500000
        `the unencumbered value`                                                                           IS 500000
        `the land has a building on it`                                                                    IS TRUE
        `the building`                                                                                     IS `case: a house` FALSE
        `the transferees`                                                                                  IS LIST `case: Alex`
        `the former home`                                                                                  IS `case: no former home`
        `the Commissioner is satisfied there are good reasons why a transferee is not an eligible first home buyer` IS FALSE
        `is effected by a written instrument`                                                              IS TRUE
        `a transferee is a foreign person`                                                                 IS FALSE
        `is of a dwelling bought off the plan before its occupancy permit under an agreement signed from 1 July 2024` IS TRUE
#ASSERT `the transfer duty on` `case: text` `case: off the plan transfer` EQUALS `not covered` `the home was bought off the plan before its occupancy permit, under an agreement signed from 1 July 2024: the Division 2C pre-completion duty concession is not encoded`

-- =====================================================================================================================
-- Part 5 Division 2A: the first home buyer duty concession (7 February 2018 to 30 June 2024; 50%; $600 000).
-- =====================================================================================================================

-- CASE B1. Alex buys an established house for $400 000, transferred 1 March 2022: 50% of 13 997.50 = 6 998.75.
#ASSERT `the first home buyer test under` `case: 2A` `case: text` (`case: Alex buys` (YMD 2022 3 1) 400000) EQUALS `yes: the transfer is an eligible transaction`
#ASSERT `the transfer duty on` `case: text` (`case: Alex buys` (YMD 2022 3 1) 400000) EQUALS `the duty, in dollars, is` 6998.75 `half the s 29 duty: the first home buyer duty concession (s 46E)`
-- CASE B2. $650 000 on 1 March 2022: over the $600 000 cap; general rate 24 622.50.
#ASSERT `the first home buyer test under` `case: 2A` `case: text` (`case: Alex buys` (YMD 2022 3 1) 650000) EQUALS `no: the dutiable value is over the cap` 600000
#ASSERT `the transfer duty on` `case: text` (`case: Alex buys` (YMD 2022 3 1) 650000) EQUALS `the duty, in dollars, is` 24622.50 `the general rate (s 29)`
-- CASE B3. $500 000 on 1 January 2024 (before the exemption began): 50% of 18 247.50 = 9 123.75.
#ASSERT `the transfer duty on` `case: text` (`case: Alex buys` (YMD 2024 1 1) 500000) EQUALS `the duty, in dollars, is` 9123.75 `half the s 29 duty: the first home buyer duty concession (s 46E)`
-- CASE B4 (finding 4). $500 000 on 1 May 2024: both Division 2A and Part 6 Division 2 apply; nil is taken.
#ASSERT `the first home buyer test under` `case: 2A` `case: text` (`case: Alex buys` (YMD 2024 5 1) 500000) EQUALS `yes: the transfer is an eligible transaction`
#ASSERT `the transfer duty on` `case: text` (`case: Alex buys` (YMD 2024 5 1) 500000) EQUALS `the duty, in dollars, is` 0 `nil: the first home buyer duty exemption (s 57G)`
-- $700 000 on 1 May 2024: over the Division 2A cap, under the exemption's: nil.
#ASSERT `the transfer duty on` `case: text` (`case: Alex buys` (YMD 2024 5 1) 700000) EQUALS `the duty, in dollars, is` 0 `nil: the first home buyer duty exemption (s 57G)`
-- CASE B5. A buyer whose spouse had a Part 6 Division 2 exemption buys again on 1 May 2024: s 46C(4) has no bar for an
-- earlier exemption, so Division 2A applies (half), while s 57E(4)(d) bars the exemption.
#ASSERT `the first home buyer test under` `case: 2A` `case: text` (`case: transfer` (YMD 2024 5 1) 500000 (`case: a house` TRUE) (LIST `case: buyer` 30 TRUE FALSE FALSE FALSE TRUE TRUE) `case: no former home` FALSE) EQUALS `yes: the transfer is an eligible transaction`
#ASSERT `the transfer duty on` `case: text` (`case: transfer` (YMD 2024 5 1) 500000 (`case: a house` TRUE) (LIST `case: buyer` 30 TRUE FALSE FALSE FALSE TRUE TRUE) `case: no former home` FALSE) EQUALS `the duty, in dollars, is` 9123.75 `half the s 29 duty: the first home buyer duty concession (s 46E)`
-- The concession's period: 7 February 2018 in, 6 February 2018 out (and the general rate then applies: 13 997.50).
#ASSERT `the first home buyer test under` `case: 2A` `case: text` (`case: Alex buys` (YMD 2018 2 7) 400000) EQUALS `yes: the transfer is an eligible transaction`
#ASSERT `the transfer duty on` `case: text` (`case: Alex buys` (YMD 2018 2 6) 400000) EQUALS `the duty, in dollars, is` 13997.50 `the general rate (s 29)`

-- =====================================================================================================================
-- Part 5 Division 2B: the pensioner duty concession (former home sold 10 February 2018 to 30 June 2025; $600 000).
-- =====================================================================================================================

-- Pat, 67, holds a Pensioner Concession Card; buys a $450 000 home in Kingston. Pat's former Hobart home, worth
-- $750 000, was the principal place of residence; same names; no other home.
-- CASE C1 (s 46N). Former home sold 1 March 2025, new home transferred 1 May 2025 (sale within the 6 months before, and
-- within the eligible period): 50% of 16 122.50 = 8 061.25.
#ASSERT `the pensioner concession test` `case: text` (`case: transfer` (YMD 2025 5 1) 450000 (`case: a house` TRUE) (LIST `case: pensioner` 67 TRUE FALSE FALSE) (`case: former home` (YMD 2025 3 1) 750000 TRUE TRUE TRUE FALSE) FALSE) EQUALS `yes: the former home was transferred within 6 months before the purchase (s 46N)`
#ASSERT `the transfer duty on` `case: text` (`case: transfer` (YMD 2025 5 1) 450000 (`case: a house` TRUE) (LIST `case: pensioner` 67 TRUE FALSE FALSE) (`case: former home` (YMD 2025 3 1) 750000 TRUE TRUE TRUE FALSE) FALSE) EQUALS `the duty, in dollars, is` 8061.25 `half the s 29 duty: the pensioner duty concession (s 46N(3) or s 46O(3))`
-- CASE C2 (finding 3). Sold 1 August 2026, bought 1 October 2026: the sale is after 30 June 2025, so no concession;
-- general rate 16 122.50.
#ASSERT `the pensioner concession test` `case: text` (`case: transfer` (YMD 2026 10 1) 450000 (`case: a house` TRUE) (LIST `case: pensioner` 67 TRUE FALSE FALSE) (`case: former home` (YMD 2026 8 1) 750000 TRUE TRUE TRUE FALSE) FALSE) EQUALS `no` (`the former home was not transferred within the eligible period` (YMD 2018 2 10) (YMD 2025 6 30))
#ASSERT `the transfer duty on` `case: text` (`case: transfer` (YMD 2026 10 1) 450000 (`case: a house` TRUE) (LIST `case: pensioner` 67 TRUE FALSE FALSE) (`case: former home` (YMD 2026 8 1) 750000 TRUE TRUE TRUE FALSE) FALSE) EQUALS `the duty, in dollars, is` 16122.50 `the general rate (s 29)`
-- ... and the other side: under a hypothetical s 46K extension to 30 June 2027, half: 8 061.25.
#ASSERT `the transfer duty on` `case: extended` (`case: transfer` (YMD 2026 10 1) 450000 (`case: a house` TRUE) (LIST `case: pensioner` 67 TRUE FALSE FALSE) (`case: former home` (YMD 2026 8 1) 750000 TRUE TRUE TRUE FALSE) FALSE) EQUALS `the duty, in dollars, is` 8061.25 `half the s 29 duty: the pensioner duty concession (s 46N(3) or s 46O(3))`
-- (finding 3) s 46M sets no period for the purchase: a purchase on 1 December 2025, after a sale on 30 June 2025 (the
-- last day of the period, within 6 months before), still gets the concession.
#ASSERT `the pensioner concession test` `case: text` (`case: transfer` (YMD 2025 12 1) 450000 (`case: a house` TRUE) (LIST `case: pensioner` 67 TRUE FALSE FALSE) (`case: former home` (YMD 2025 6 30) 750000 TRUE TRUE TRUE FALSE) FALSE) EQUALS `yes: the former home was transferred within 6 months before the purchase (s 46N)`
-- CASE C3 (s 46O). Bought 1 February 2025, sold 1 June 2025 (within 6 months after): yes.
#ASSERT `the pensioner concession test` `case: text` (`case: transfer` (YMD 2025 2 1) 450000 (`case: a house` TRUE) (LIST `case: pensioner` 67 TRUE FALSE FALSE) (`case: former home` (YMD 2025 6 1) 750000 FALSE TRUE TRUE FALSE) FALSE) EQUALS `yes: the former home was transferred within 6 months after the purchase (s 46O)`
-- ... sold 2 August 2025: more than 6 months after 1 February 2025 (the 6 months end on 1 August).
#ASSERT `the pensioner concession test` `case: text` (`case: transfer` (YMD 2025 2 1) 450000 (`case: a house` TRUE) (LIST `case: pensioner` 67 TRUE FALSE FALSE) (`case: former home` (YMD 2025 8 2) 750000 TRUE TRUE TRUE FALSE) FALSE) EQUALS `no` `the former home was not transferred within the 6 months before or after the purchase`
-- ... sold on 1 August 2025 exactly: within the 6 months after, but after 30 June 2025: outside the eligible period.
#ASSERT `the pensioner concession test` `case: text` (`case: transfer` (YMD 2025 2 1) 450000 (`case: a house` TRUE) (LIST `case: pensioner` 67 TRUE FALSE FALSE) (`case: former home` (YMD 2025 8 1) 750000 TRUE TRUE TRUE FALSE) FALSE) EQUALS `no` (`the former home was not transferred within the eligible period` (YMD 2018 2 10) (YMD 2025 6 30))
-- CASE C4. The other conditions, each alone (s 46N, sold 1 March 2025, bought 1 May 2025):
-- former home worth less ($400 000 against $450 000);
#ASSERT `the pensioner concession test` `case: text` (`case: transfer` (YMD 2025 5 1) 450000 (`case: a house` TRUE) (LIST `case: pensioner` 67 TRUE FALSE FALSE) (`case: former home` (YMD 2025 3 1) 400000 TRUE TRUE TRUE FALSE) FALSE) EQUALS `no` `the former home's dutiable value is not greater than the new home's`
-- not lived in for the 6 months before the sale;
#ASSERT `the pensioner concession test` `case: text` (`case: transfer` (YMD 2025 5 1) 450000 (`case: a house` TRUE) (LIST `case: pensioner` 67 TRUE FALSE FALSE) (`case: former home` (YMD 2025 3 1) 750000 FALSE TRUE TRUE FALSE) FALSE) EQUALS `no` `the former home was not the pensioner's principal place of residence for the 6 months required`
-- not in the same names;
#ASSERT `the pensioner concession test` `case: text` (`case: transfer` (YMD 2025 5 1) 450000 (`case: a house` TRUE) (LIST `case: pensioner` 67 TRUE FALSE FALSE) (`case: former home` (YMD 2025 3 1) 750000 TRUE TRUE FALSE FALSE) FALSE) EQUALS `no` `the new home is not in the same name or names as the former home`
-- a holiday home owned as well;
#ASSERT `the pensioner concession test` `case: text` (`case: transfer` (YMD 2025 5 1) 450000 (`case: a house` TRUE) (LIST `case: pensioner` 67 TRUE FALSE FALSE) (`case: former home` (YMD 2025 3 1) 750000 TRUE TRUE TRUE TRUE) FALSE) EQUALS `no` `the pensioner or spouse owned another home at the time of the purchase`
-- aged 59;
#ASSERT `the pensioner concession test` `case: text` (`case: transfer` (YMD 2025 5 1) 450000 (`case: a house` TRUE) (LIST `case: pensioner` 59 TRUE FALSE FALSE) (`case: former home` (YMD 2025 3 1) 750000 TRUE TRUE TRUE FALSE) FALSE) EQUALS `no` `no transferee is an eligible pensioner (aged 60 or over, with a Pensioner Concession Card, Seniors Health Card or special rate pension, and no earlier Division 2B concession)`
-- a Seniors Health Card instead of a Pensioner Concession Card: yes;
#ASSERT `the pensioner concession test` `case: text` (`case: transfer` (YMD 2025 5 1) 450000 (`case: a house` TRUE) (LIST `case: pensioner` 67 FALSE TRUE FALSE) (`case: former home` (YMD 2025 3 1) 750000 TRUE TRUE TRUE FALSE) FALSE) EQUALS `yes: the former home was transferred within 6 months before the purchase (s 46N)`
-- an earlier Division 2B concession;
#ASSERT `the pensioner concession test` `case: text` (`case: transfer` (YMD 2025 5 1) 450000 (`case: a house` TRUE) (LIST `case: pensioner` 67 TRUE FALSE TRUE) (`case: former home` (YMD 2025 3 1) 750000 TRUE TRUE TRUE FALSE) FALSE) EQUALS `no` `no transferee is an eligible pensioner (aged 60 or over, with a Pensioner Concession Card, Seniors Health Card or special rate pension, and no earlier Division 2B concession)`
-- the new home at $650 000 (and the former at $750 000): over the $600 000 cap.
#ASSERT `the pensioner concession test` `case: text` (`case: transfer` (YMD 2025 5 1) 650000 (`case: a house` TRUE) (LIST `case: pensioner` 67 TRUE FALSE FALSE) (`case: former home` (YMD 2025 3 1) 750000 TRUE TRUE TRUE FALSE) FALSE) EQUALS `no` (`the dutiable value is over the cap` 600000)
-- s 46N(1)(a)(i): the sale 6 months before the purchase to the day (1 November 2024 for 1 May 2025) is within; 31
-- October 2024 is not.
#ASSERT `the pensioner concession test` `case: text` (`case: transfer` (YMD 2025 5 1) 450000 (`case: a house` TRUE) (LIST `case: pensioner` 67 TRUE FALSE FALSE) (`case: former home` (YMD 2024 11 1) 750000 TRUE TRUE TRUE FALSE) FALSE) EQUALS `yes: the former home was transferred within 6 months before the purchase (s 46N)`
#ASSERT `the pensioner concession test` `case: text` (`case: transfer` (YMD 2025 5 1) 450000 (`case: a house` TRUE) (LIST `case: pensioner` 67 TRUE FALSE FALSE) (`case: former home` (YMD 2024 10 31) 750000 TRUE TRUE TRUE FALSE) FALSE) EQUALS `no` `the former home was not transferred within the 6 months before or after the purchase`

-- =====================================================================================================================
-- ss 13-15: lodge and pay within 3 months (s 242 month arithmetic). Clock: DATE_SERIAL days.
-- =====================================================================================================================

-- 15 March 2025 -> 15 June 2025; 30 November 2025 -> 28 February 2026 (s 242(3)(b)); 31 May 2025 -> 31 August 2025.
#ASSERT `the last day to lodge and pay` (YMD 2025 3 15) EQUALS YMD 2025 6 15
#ASSERT `the last day to lodge and pay` (YMD 2025 11 30) EQUALS YMD 2026 2 28
#ASSERT `the last day to lodge and pay` (YMD 2025 5 31) EQUALS YMD 2025 8 31
-- Transfer 15 March 2025 with duty payable: lodged and paid on 15 June 2025, the last day. Fulfilled.
#ASSERT EVALTRACE (`ss 13-15 -- the transferee must lodge and pay within 3 months` (YMD 2025 3 15) TRUE TRUE) (DATE_SERIAL (YMD 2025 3 15)) (LIST (EVENT `the transferee` `lodge the written instrument with the Commissioner` (DATE_SERIAL (YMD 2025 6 15))), (EVENT `the transferee` `pay the duty` (DATE_SERIAL (YMD 2025 6 15)))) EQUALS FULFILLED
-- With no written instrument, the written statement is what must be lodged.
#ASSERT EVALTRACE (`ss 13-15 -- the transferee must lodge and pay within 3 months` (YMD 2025 3 15) TRUE FALSE) (DATE_SERIAL (YMD 2025 3 15)) (LIST (EVENT `the transferee` `make and lodge a written statement in the approved form` (DATE_SERIAL (YMD 2025 4 1))), (EVENT `the transferee` `pay the duty` (DATE_SERIAL (YMD 2025 4 1)))) EQUALS FULFILLED
-- (finding 5) An exempt transfer: no duty is payable, and the rule binds nothing.
#ASSERT EVALTRACE (`ss 13-15 -- the transferee must lodge and pay within 3 months` (YMD 2025 3 1) FALSE TRUE) (DATE_SERIAL (YMD 2025 3 1)) (LIST (WAITUNTIL (DATE_SERIAL (YMD 2026 1 1)))) EQUALS FULFILLED
-- expect: BREACH BY the transferee, "s 15: duty not paid within 3 months ... is a tax default" (paid 16 June 2025)
#TRACE `ss 13-15 -- the transferee must lodge and pay within 3 months` (YMD 2025 3 15) TRUE TRUE AT DATE_SERIAL (YMD 2025 3 15) WITH
    PARTY `the transferee` DOES `lodge the written instrument with the Commissioner` AT DATE_SERIAL (YMD 2025 6 1)
    PARTY `the transferee` DOES `pay the duty` AT DATE_SERIAL (YMD 2025 6 16)

-- =====================================================================================================================
-- s 57H (and s 46F): the residence requirement after an exempt transfer. Transfer 1 March 2025; the last day to begin
-- is 1 March 2026; 6 months of occupation.
-- =====================================================================================================================

`case: 57H` MEANS `the first home buyer duty exemption (Duties Act s 57H)`

-- The days of occupation from 1 April 2025 for 6 months: to 1 October 2025, 183 days.
#ASSERT `the days of occupation required from` (DATE_SERIAL (YMD 2025 4 1)) `for` 6 EQUALS 183
-- Moved in 1 April 2025 and still there on 1 November 2025: fulfilled.
#ASSERT EVALTRACE (`the transferee's residence requirement` `case: 57H` FALSE (YMD 2025 3 1) 12 6) (DATE_SERIAL (YMD 2025 3 1)) (LIST (EVENT `the transferee` (`begin to occupy the home as principal place of residence` (DATE_SERIAL (YMD 2025 4 1))) (DATE_SERIAL (YMD 2025 4 1))), (WAITUNTIL (DATE_SERIAL (YMD 2025 11 1)))) EQUALS FULFILLED
-- Moved in 1 April 2025 and left on 1 October 2025, 6 months to the day: fulfilled.
#ASSERT EVALTRACE (`the transferee's residence requirement` `case: 57H` FALSE (YMD 2025 3 1) 12 6) (DATE_SERIAL (YMD 2025 3 1)) (LIST (EVENT `the transferee` (`begin to occupy the home as principal place of residence` (DATE_SERIAL (YMD 2025 4 1))) (DATE_SERIAL (YMD 2025 4 1))), (EVENT `the transferee` (`end the stay in the home` `by ceasing to occupy the home as principal place of residence` (DATE_SERIAL (YMD 2025 10 1))) (DATE_SERIAL (YMD 2025 10 1)))) EQUALS FULFILLED
-- Moved in on 1 March 2026, the last day to begin: fulfilled once 6 months pass.
#ASSERT EVALTRACE (`the transferee's residence requirement` `case: 57H` FALSE (YMD 2025 3 1) 12 6) (DATE_SERIAL (YMD 2025 3 1)) (LIST (EVENT `the transferee` (`begin to occupy the home as principal place of residence` (DATE_SERIAL (YMD 2026 3 1))) (DATE_SERIAL (YMD 2026 3 1))), (WAITUNTIL (DATE_SERIAL (YMD 2026 10 1)))) EQUALS FULFILLED
-- (finding 10) Left early on 30 September 2025, then moved back on 1 November 2025 (still before 1 March 2026) and
-- stayed 6 months: a fresh continuous period, fulfilled.
#ASSERT EVALTRACE (`the transferee's residence requirement` `case: 57H` FALSE (YMD 2025 3 1) 12 6) (DATE_SERIAL (YMD 2025 3 1)) (LIST (EVENT `the transferee` (`begin to occupy the home as principal place of residence` (DATE_SERIAL (YMD 2025 4 1))) (DATE_SERIAL (YMD 2025 4 1))), (EVENT `the transferee` (`end the stay in the home` `by ceasing to occupy the home as principal place of residence` (DATE_SERIAL (YMD 2025 9 30))) (DATE_SERIAL (YMD 2025 9 30))), (EVENT `the transferee` (`begin to occupy the home as principal place of residence` (DATE_SERIAL (YMD 2025 11 1))) (DATE_SERIAL (YMD 2025 11 1))), (WAITUNTIL (DATE_SERIAL (YMD 2026 6 1)))) EQUALS FULFILLED
-- s 57H(4): a joint transferee the Commissioner has exempted is bound to nothing.
#ASSERT EVALTRACE (`the transferee's residence requirement` `case: 57H` TRUE (YMD 2025 3 1) 12 6) (DATE_SERIAL (YMD 2025 3 1)) (LIST (WAITUNTIL (DATE_SERIAL (YMD 2027 1 1)))) EQUALS FULFILLED
-- A longer period approved (18 months to begin): moving in on 1 June 2026 is in time.
#ASSERT EVALTRACE (`the transferee's residence requirement` `case: 57H` FALSE (YMD 2025 3 1) 18 6) (DATE_SERIAL (YMD 2025 3 1)) (LIST (EVENT `the transferee` (`begin to occupy the home as principal place of residence` (DATE_SERIAL (YMD 2026 6 1))) (DATE_SERIAL (YMD 2026 6 1))), (WAITUNTIL (DATE_SERIAL (YMD 2027 1 1)))) EQUALS FULFILLED
-- expect: the s 57H(6) notice owed within 14 days, and the Commissioner's s 57I(2) power to reassess (never moved in;
-- the 12 months ended 1 March 2026)
#TRACE `the transferee's residence requirement` `case: 57H` FALSE (YMD 2025 3 1) 12 6 AT DATE_SERIAL (YMD 2025 3 1) WITH
    (WAITUNTIL (DATE_SERIAL (YMD 2026 3 2)))
-- expect: BREACH BY the transferee, "s 57H(6): written notice of the failure ... within 14 days ..." (no notice by 16 March)
#TRACE `the transferee's residence requirement` `case: 57H` FALSE (YMD 2025 3 1) 12 6 AT DATE_SERIAL (YMD 2025 3 1) WITH
    (WAITUNTIL (DATE_SERIAL (YMD 2026 3 2)))
    (WAITUNTIL (DATE_SERIAL (YMD 2026 3 20)))
-- expect: FULFILLED for the notice, leaving only the Commissioner's permission to reassess (notice given 10 March 2026)
#TRACE `the transferee's residence requirement` `case: 57H` FALSE (YMD 2025 3 1) 12 6 AT DATE_SERIAL (YMD 2025 3 1) WITH
    (WAITUNTIL (DATE_SERIAL (YMD 2026 3 2)))
    PARTY `the transferee` DOES `give the Commissioner written notice of the failure` AT DATE_SERIAL (YMD 2026 3 10)
-- expect: the notice owed from 1 August 2025 (the interest given up during the 6 months: s 57H(5), (6))
#TRACE `the transferee's residence requirement` `case: 57H` FALSE (YMD 2025 3 1) 12 6 AT DATE_SERIAL (YMD 2025 3 1) WITH
    PARTY `the transferee` DOES `begin to occupy the home as principal place of residence` (DATE_SERIAL (YMD 2025 4 1)) AT DATE_SERIAL (YMD 2025 4 1)
    PARTY `the transferee` DOES `end the stay in the home` `by ceasing to hold the interest in the land` (DATE_SERIAL (YMD 2025 8 1)) AT DATE_SERIAL (YMD 2025 8 1)
-- expect: the notice owed from 15 June 2026 (moved in 1 February 2026, left 15 June 2026 after the last day to begin)
#TRACE `the transferee's residence requirement` `case: 57H` FALSE (YMD 2025 3 1) 12 6 AT DATE_SERIAL (YMD 2025 3 1) WITH
    PARTY `the transferee` DOES `begin to occupy the home as principal place of residence` (DATE_SERIAL (YMD 2026 2 1)) AT DATE_SERIAL (YMD 2026 2 1)
    PARTY `the transferee` DOES `end the stay in the home` `by ceasing to occupy the home as principal place of residence` (DATE_SERIAL (YMD 2026 6 15)) AT DATE_SERIAL (YMD 2026 6 15)

-- s 46F (Division 2A, dated): the same rule. Transfer 1 March 2022, moved in 1 April 2022, there on 1 November 2022.
#ASSERT EVALTRACE (`the transferee's residence requirement` `the first home buyer duty concession (Duties Act s 46F)` FALSE (YMD 2022 3 1) 12 6) (DATE_SERIAL (YMD 2022 3 1)) (LIST (EVENT `the transferee` (`begin to occupy the home as principal place of residence` (DATE_SERIAL (YMD 2022 4 1))) (DATE_SERIAL (YMD 2022 4 1))), (WAITUNTIL (DATE_SERIAL (YMD 2022 11 1)))) EQUALS FULFILLED
-- On a failure the Commissioner may reassess at the general rate: $500 000 -> 18 247.50 (ss 46G(2), 57I(2)).
#ASSERT `the duty the Commissioner may reassess on a failure (ss 46G(2), 57I(2))` (`case: Alex buys` (YMD 2025 3 1) 500000) EQUALS 18247.50
