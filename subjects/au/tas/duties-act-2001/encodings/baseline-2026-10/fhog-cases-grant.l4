IMPORT prelude
IMPORT `tda-common`
IMPORT `fhog-terms`
IMPORT `fhog-grant`

-- Cases for the First Home Owner Grant Act 2000 terms (fhog-terms.l4) and grant core (fhog-grant.l4), with Regulations
-- 2021 regs 4, 5 and 5A. Every expected value was worked by hand from the deposited texts (act-2000-019.txt,
-- sr-2021-033.txt); the arithmetic or the provision is in the comment above each assertion. The applicants are the
-- encoder's, HYPOTHETICAL throughout.
--
-- A breached or still-pending DEONTIC cannot be asserted on the stable l4, so regulative rules are asserted where the
-- trace ends FULFILLED, and #TRACEd with an "-- expect:" line where it does not. Clock: days, as DATE_SERIAL numbers
-- (or plain days from 0 for s 38).

-- =====================================================================================================================
-- Case-local builders.
-- =====================================================================================================================

GIVEN `affixed` IS A BOOLEAN, `lived in before` IS A BOOLEAN, `renovated` IS A BOOLEAN, `lived in since` IS A BOOLEAN
GIVETH A `Building facts`
`case: building` `affixed` `lived in before` `renovated` `lived in since` MEANS
    `Building facts` WITH
        `is a building affixed to land`                                               IS `affixed`
        `may lawfully be used as a place of residence`                                IS TRUE
        `is, in the Commissioner's opinion, suitable for use as a place of residence` IS TRUE
        `has previously been occupied or sold as a place of residence`                IS `lived in before`
        `would be new residential premises because of substantial renovations (GST Act s 40-75(1)(b))` IS `renovated`
        `has been occupied or sold as a place of residence since those renovations`   IS `lived in since`

`case: new house`         MEANS `case: building` TRUE FALSE FALSE FALSE
`case: established house` MEANS `case: building` TRUE TRUE FALSE FALSE

GIVEN `kind` IS A `Kind of interest`, `approved` IS A BOOLEAN, `occupation` IS A BOOLEAN, `trust` IS A BOOLEAN
      `equitable` IS A BOOLEAN, `guardian` IS A BOOLEAN, `recognised` IS A BOOLEAN
GIVETH AN `Interest facts`
`case: interest` `kind` `approved` `occupation` `trust` `equitable` `guardian` `recognised` MEANS
    `Interest facts` WITH
        `kind`                                                                         IS `kind`
        `the Commissioner approves it, or is of the opinion or satisfied that s 5(2) requires` IS `approved`
        `gives a right to immediate occupation now or within 12 months (or a longer time allowed)` IS `occupation`
        `is held subject to a trust`                                                   IS `trust`
        `is an equitable interest`                                                     IS `equitable`
        `is held on trust by a guardian for a person under a legal disability`         IS `guardian`
        `the Commissioner recognises it as a non-conforming interest (s 5(4))`         IS `recognised`

`case: freehold` MEANS `case: interest` `an estate in fee simple` FALSE TRUE FALSE FALSE FALSE FALSE

GIVEN `married` IS A BOOLEAN, `significant` IS A BOOLEAN, `separated` IS A BOOLEAN
GIVETH A `Relationship facts`
`case: relationship` `married` `significant` `separated` MEANS
    `Relationship facts` WITH
        `are legally married`                                            IS `married`
        `are in a significant relationship (Relationships Act 2003)`     IS `significant`
        `are not cohabiting, with no intention of resuming cohabitation` IS `separated`

-- Applicant: age, age exempted, citizen, earlier grant, paid back, before 2000, owned and lived 6 months, intends,
-- residence exempted.
GIVEN `age` IS A NUMBER, `age exempted` IS A BOOLEAN, `citizen` IS A BOOLEAN, `earlier grant` IS A BOOLEAN
      `paid back` IS A BOOLEAN, `before 2000` IS A BOOLEAN, `owned and lived` IS A BOOLEAN, `intends` IS A BOOLEAN
      `residence exempted` IS A BOOLEAN
GIVETH A `Grant applicant`
`case: applicant` `age` `age exempted` `citizen` `earlier grant` `paid back` `before 2000` `owned and lived` `intends` `residence exempted` MEANS
    `Grant applicant` WITH
        `is a natural person`                                                                        IS TRUE
        `age`                                                                                        IS `age`
        `the Commissioner exempts the age requirement (s 8(2))`                                      IS `age exempted`
        `is an Australian citizen or a permanent resident`                                           IS `citizen`
        `the applicant or spouse was a party to an earlier application, under this Act or a corresponding law, on which a grant was paid` IS `earlier grant`
        `that earlier grant was paid back`                                                           IS `paid back`
        `the applicant or spouse held a relevant interest in residential property in Australia before 1 July 2000` IS `before 2000`
        `the applicant or spouse, before the commencement date, held a relevant interest in residential property in Australia and occupied it as a residence for a continuous 6 months` IS `owned and lived`
        `intends to meet, or has met, the residence requirement`                                     IS `intends`
        `the Commissioner exempts the applicant from the residence requirement (s 12(2))`            IS `residence exempted`

-- Jordan: 25, citizen, no earlier grant, never held property, intends to live there.
`case: Jordan` MEANS `case: applicant` 25 FALSE TRUE FALSE FALSE FALSE FALSE TRUE FALSE

-- A transaction: kind, building, commencement date, completion date, price; in Tasmania, completed, owner of the land,
-- no scheme, no HomeBuilder, no Division 2C, no extension, no replacement.
GIVEN `kind` IS A `Grant transaction kind`, `home` IS A `Building facts`, `commenced` IS A DATE, `completes` IS A DATE
      `price` IS A NUMBER
GIVETH A `Grant transaction`
`case: deal` `kind` `home` `commenced` `completes` `price` MEANS
    `Grant transaction` WITH
        `kind`                                                                                       IS `kind`
        `the home`                                                                                   IS `home`
        `is in Tasmania`                                                                             IS TRUE
        `the commencement date`                                                                      IS `commenced`
        `the completion date`                                                                        IS `completes`
        `has been completed`                                                                         IS TRUE
        `the consideration`                                                                          IS `price`
        `the applicant is, or on completion will be, the owner of the land`                          IS TRUE
        `the Commissioner is of the opinion it is part of a scheme to circumvent the Act (s 13(3))`  IS FALSE
        `the Tasmanian HomeBuilder grant was paid for it (s 7(4))`                                   IS FALSE
        `the Duties Act Division 2C pre-completion concession was applied to the transfer (Duties Act s 46X(2))` IS FALSE
        `the Commissioner extended the time for completion (ss 18D(3)-18M(2))`                       IS FALSE
        `the Commissioner considers it replaces an earlier transaction between substantially the same parties (ss 18D(4)-18M(3))` IS FALSE

`case: buy` MEANS `a contract to buy a home`

-- Jordan's contract for a new townhouse in Devonport: 1 August 2026, $520 000, settles 1 December 2026.
`case: Jordan's contract` MEANS `case: deal` `case: buy` `case: new house` (YMD 2026 8 1) (YMD 2026 12 1) 520000

-- =====================================================================================================================
-- ss 3-6: the shared terms.
-- =====================================================================================================================

-- s 4 home.
#ASSERT `is a home (FHOG Act s 4)` `case: new house`
#ASSERT (NOT `is a home (FHOG Act s 4)` (`case: building` FALSE FALSE FALSE FALSE))
-- s 3 new home: never occupied or sold -> new; occupied before -> not; substantially renovated, not occupied since ->
-- new; renovated but occupied since -> not.
#ASSERT `is a new home (FHOG Act s 3)` `case: new house`
#ASSERT (NOT `is a new home (FHOG Act s 3)` `case: established house`)
#ASSERT `is a new home (FHOG Act s 3)` (`case: building` TRUE TRUE TRUE FALSE)
#ASSERT (NOT `is a new home (FHOG Act s 3)` (`case: building` TRUE TRUE TRUE TRUE))
-- Duties Act ss 46A, 57C established home.
#ASSERT `is an established home (Duties Act ss 46A, 57C)` `case: established house`
#ASSERT (NOT `is an established home (Duties Act ss 46A, 57C)` `case: new house`)
#ASSERT `the kind of home` `case: established house` EQUALS `an established home (Duties Act ss 46A, 57C)`
#ASSERT `the kind of home` `case: new house` EQUALS `a new home (FHOG Act s 3)`
#ASSERT `the kind of home` (`case: building` FALSE TRUE FALSE FALSE) EQUALS `not a home (FHOG Act s 4)`
-- s 5 relevant interest: freehold with occupation -> yes.
#ASSERT `is a relevant interest in land (FHOG Act s 5(2)-(4))` `case: freehold`
-- (2A): a Help to Buy interest of Housing Australia is never one, even if the Commissioner "recognised" it.
#ASSERT (NOT `is a relevant interest in land (FHOG Act s 5(2)-(4))` (`case: interest` `an interest of the Commonwealth or Housing Australia under a Help to Buy arrangement` TRUE TRUE FALSE FALSE FALSE TRUE))
-- (3)(b): held subject to a trust -> no; (3)(c): equitable -> no, unless a guardian holds it for a person under a
-- legal disability -> yes; (3)(a): no right to occupy within 12 months -> no.
#ASSERT (NOT `is a relevant interest in land (FHOG Act s 5(2)-(4))` (`case: interest` `an estate in fee simple` FALSE TRUE TRUE FALSE FALSE FALSE))
#ASSERT (NOT `is a relevant interest in land (FHOG Act s 5(2)-(4))` (`case: interest` `an estate in fee simple` FALSE TRUE FALSE TRUE FALSE FALSE))
#ASSERT `is a relevant interest in land (FHOG Act s 5(2)-(4))` (`case: interest` `an estate in fee simple` FALSE TRUE FALSE TRUE TRUE FALSE)
#ASSERT (NOT `is a relevant interest in land (FHOG Act s 5(2)-(4))` (`case: interest` `an estate in fee simple` FALSE FALSE FALSE FALSE FALSE FALSE))
-- (2)(b): a life estate counts only if the Commissioner approves it.
#ASSERT (NOT `is a relevant interest in land (FHOG Act s 5(2)-(4))` (`case: interest` `a life estate` FALSE TRUE FALSE FALSE FALSE FALSE))
#ASSERT `is a relevant interest in land (FHOG Act s 5(2)-(4))` (`case: interest` `a life estate` TRUE TRUE FALSE FALSE FALSE FALSE)
-- (4): another interest the Commissioner recognises -> yes.
#ASSERT `is a relevant interest in land (FHOG Act s 5(2)-(4))` (`case: interest` `another interest` FALSE FALSE FALSE FALSE FALSE TRUE)
-- s 5(1) owner of a home: freehold land with a home on it -> yes; vacant land -> no.
#ASSERT `makes the holder an owner of a home (FHOG Act ss 3, 5(1))` `case: freehold` `case: established house` TRUE
#ASSERT (NOT `makes the holder an owner of a home (FHOG Act ss 3, 5(1))` `case: freehold` `case: established house` FALSE)
-- s 6 spouse (grant) against s 3 spouse (Duties Act), finding 9: a separated legal spouse is not a spouse for the grant
-- but is one for the duty exemption.
#ASSERT (NOT `is a spouse for the grant (FHOG Act s 6)` (`case: relationship` TRUE FALSE TRUE))
#ASSERT `is a spouse for the Duties Act (s 3)` (`case: relationship` TRUE FALSE TRUE)
#ASSERT `is a spouse for the grant (FHOG Act s 6)` (`case: relationship` FALSE TRUE FALSE)
#ASSERT `is a spouse for the Duties Act (s 3)` (`case: relationship` FALSE TRUE FALSE)
#ASSERT `is a spouse for the grant (FHOG Act s 6)` (`case: relationship` TRUE FALSE FALSE)
-- s 3(2) residential property.
#ASSERT `is residential property (FHOG Act s 3(2))` TRUE TRUE TRUE
#ASSERT (NOT `is residential property (FHOG Act s 3(2))` FALSE TRUE TRUE)

-- =====================================================================================================================
-- ss 8-12: the eligibility criteria.
-- =====================================================================================================================

-- Jordan meets every criterion.
#ASSERT `the eligibility criteria not met by` (LIST `case: Jordan`) EQUALS NOTHING
-- Criterion 1 (s 8): 17 and not exempted -> fails; exempted under s 8(2) -> meets.
#ASSERT `the eligibility criteria not met by` (LIST `case: applicant` 17 FALSE TRUE FALSE FALSE FALSE FALSE TRUE FALSE) EQUALS JUST `criterion 1: an applicant is not a natural person aged at least 18 (s 8)`
#ASSERT `the eligibility criteria not met by` (LIST `case: applicant` 17 TRUE TRUE FALSE FALSE FALSE FALSE TRUE FALSE) EQUALS NOTHING
-- Criterion 2 (s 9): a temporary visa holder alone -> fails; joint with Jordan (a citizen) -> both meet (s 9(2)).
#ASSERT `the eligibility criteria not met by` (LIST `case: applicant` 30 FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE) EQUALS JUST `criterion 2: no applicant is an Australian citizen or permanent resident (s 9)`
#ASSERT `the eligibility criteria not met by` (LIST `case: Jordan`, `case: applicant` 30 FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE) EQUALS NOTHING
-- Criterion 3 (s 10): an earlier grant (here or in another State) not paid back -> fails; paid back -> meets (s 10(2)).
#ASSERT `the eligibility criteria not met by` (LIST `case: applicant` 30 FALSE TRUE TRUE FALSE FALSE FALSE TRUE FALSE) EQUALS JUST `criterion 3: an applicant or spouse was paid an earlier grant and did not pay it back (s 10)`
#ASSERT `the eligibility criteria not met by` (LIST `case: applicant` 30 FALSE TRUE TRUE TRUE FALSE FALSE TRUE FALSE) EQUALS NOTHING
-- Criterion 4 (s 11): a relevant interest in residential property before 1 July 2000 -> fails (s 11(1)).
#ASSERT `the eligibility criteria not met by` (LIST `case: applicant` 50 FALSE TRUE FALSE FALSE TRUE FALSE TRUE FALSE) EQUALS JUST `criterion 4: an applicant or spouse held a relevant interest in residential property before 1 July 2000 (s 11(1))`
-- ... a home owned and lived in for 6 months before the commencement date -> fails (s 11(3)).
#ASSERT `the eligibility criteria not met by` (LIST `case: applicant` 40 FALSE TRUE FALSE FALSE FALSE TRUE TRUE FALSE) EQUALS JUST `criterion 4: an applicant or spouse held and lived in residential property for 6 months before (s 11(3))`
-- Criterion 5 (s 12): no intention to live there -> fails; a joint applicant exempted under s 12(2), with Jordan
-- intending to live there -> both meet.
#ASSERT `the eligibility criteria not met by` (LIST `case: applicant` 30 FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST `criterion 5: an applicant will not meet the residence requirement and is not exempted (s 12)`
#ASSERT `the eligibility criteria not met by` (LIST `case: Jordan`, `case: applicant` 30 FALSE TRUE FALSE FALSE FALSE FALSE FALSE TRUE) EQUALS NOTHING
-- ... but an exemption alone, with no co-applicant who meets the requirement, does not help (s 12(2)(a)-(b)).
#ASSERT `the eligibility criteria not met by` (LIST `case: applicant` 30 FALSE TRUE FALSE FALSE FALSE FALSE FALSE TRUE) EQUALS JUST `criterion 5: an applicant will not meet the residence requirement and is not exempted (s 12)`
-- (finding 2) An investment property owned but never lived in does not fail criterion 4 -- unlike s 57E(4)(a), where
-- any earlier ownership bars the duty exemption.
#ASSERT `the eligibility criteria not met by` (LIST `case: applicant` 35 FALSE TRUE FALSE FALSE FALSE FALSE TRUE FALSE) EQUALS NOTHING
-- (finding 11) Jordan buys with a parent who owned and lived in a home: the parent fails criterion 4.
#ASSERT `the eligibility criteria not met by` (LIST `case: Jordan`, `case: applicant` 55 FALSE TRUE FALSE FALSE FALSE TRUE TRUE FALSE) EQUALS JUST `criterion 4: an applicant or spouse held and lived in residential property for 6 months before (s 11(3))`

-- =====================================================================================================================
-- s 13: eligible transaction.
-- =====================================================================================================================

#ASSERT `the s 13 test for` `case: Jordan's contract` EQUALS `an eligible transaction (s 13(1))`
-- An established home bought under a contract of 1 August 2026: not eligible (s 13(1)(ab), finding 7).
#ASSERT `the s 13 test for` (`case: deal` `case: buy` `case: established house` (YMD 2026 8 1) (YMD 2026 12 1) 520000) EQUALS `not an eligible transaction: a contract made from 1 July 2014 must be for a new home (s 13(1)(ab))`
-- ... under a contract of 1 March 2014: eligible (s 13(1)(a)).
#ASSERT `the s 13 test for` (`case: deal` `case: buy` `case: established house` (YMD 2014 3 1) (YMD 2014 5 1) 300000) EQUALS `an eligible transaction (s 13(1))`
-- A comprehensive home building contract on land the applicant owns; and one where the client will not own the land.
#ASSERT `the s 13 test for` (`case: deal` `a comprehensive home building contract` `case: new house` (YMD 2026 8 1) (YMD 2027 6 1) 400000) EQUALS `an eligible transaction (s 13(1))`
#ASSERT `the s 13 test for` (`Grant transaction` WITH `kind` IS `a comprehensive home building contract`, `the home` IS `case: new house`, `is in Tasmania` IS TRUE, `the commencement date` IS YMD 2026 8 1, `the completion date` IS YMD 2027 6 1, `has been completed` IS TRUE, `the consideration` IS 400000, `the applicant is, or on completion will be, the owner of the land` IS FALSE, `the Commissioner is of the opinion it is part of a scheme to circumvent the Act (s 13(3))` IS FALSE, `the Tasmanian HomeBuilder grant was paid for it (s 7(4))` IS FALSE, `the Duties Act Division 2C pre-completion concession was applied to the transfer (Duties Act s 46X(2))` IS FALSE, `the Commissioner extended the time for completion (ss 18D(3)-18M(2))` IS FALSE, `the Commissioner considers it replaces an earlier transaction between substantially the same parties (ss 18D(4)-18M(3))` IS FALSE) EQUALS `not an eligible transaction: the builder's client is not, and will not be, the owner of the land (s 13(1)(b))`
-- An owner builder; and a moveable building (not covered).
#ASSERT `the s 13 test for` (`case: deal` `building the home as an owner builder` `case: new house` (YMD 2026 8 1) (YMD 2027 8 1) 300000) EQUALS `an eligible transaction (s 13(1))`
#ASSERT `the s 13 test for` (`case: deal` `buying a moveable building to put on my land (s 13(6))` `case: new house` (YMD 2026 8 1) (YMD 2026 9 1) 90000) EQUALS `not covered` `the grant is sought for a moveable building (s 13(6)): not encoded`
-- A contract made in June 2000, before the scheme began.
#ASSERT `the s 13 test for` (`case: deal` `case: buy` `case: new house` (YMD 2000 6 1) (YMD 2000 9 1) 150000) EQUALS `not an eligible transaction: it commenced before 1 July 2000`

-- =====================================================================================================================
-- s 18 with ss 18D-18M: the amount.
-- =====================================================================================================================

-- Jordan: commenced 1 August 2026 (s 18M period, 1 July 2026 to 30 June 2027), completed within 24 months: $20 000.
#ASSERT `the s 18 amount for` `case: Jordan's contract` EQUALS `the grant, in dollars, is` 20000 "s 18(2)(am), s 18M"
-- Commenced 1 August 2025 (s 18L), completed 1 March 2026: $30 000.
#ASSERT `the s 18 amount for` (`case: deal` `case: buy` `case: new house` (YMD 2025 8 1) (YMD 2026 3 1) 520000) EQUALS `the grant, in dollars, is` 30000 "s 18(2)(al), s 18L"
-- ... completed on 1 August 2027, 24 months to the day: still $30 000; on 2 August 2027: $10 000 (s 18(2)(b)(ii)).
#ASSERT `the s 18 amount for` (`case: deal` `case: buy` `case: new house` (YMD 2025 8 1) (YMD 2027 8 1) 520000) EQUALS `the grant, in dollars, is` 30000 "s 18(2)(al), s 18L"
#ASSERT `the s 18 amount for` (`case: deal` `case: buy` `case: new house` (YMD 2025 8 1) (YMD 2027 8 2) 520000) EQUALS `the grant, in dollars, is` 10000 "s 18(2)(b)(ii)"
-- (finding 7) Commenced 1 August 2024: no s 18D-18M period covers 1 July 2024 to 30 June 2025, so $10 000.
#ASSERT `the s 18 amount for` (`case: deal` `case: buy` `case: new house` (YMD 2024 8 1) (YMD 2025 3 1) 520000) EQUALS `the grant, in dollars, is` 10000 "s 18(2)(b)(ii)"
-- Commenced 1 August 2027, after s 18M: $10 000.
#ASSERT `the s 18 amount for` (`case: deal` `case: buy` `case: new house` (YMD 2027 8 1) (YMD 2028 1 1) 520000) EQUALS `the grant, in dollars, is` 10000 "s 18(2)(b)(ii)"
-- The dated table: 1 January 2017 (s 18D) $20 000; 1 October 2021 (s 18I) $30 000; 1 March 2016 (no period) $10 000.
#ASSERT `the s 18 amount for` (`case: deal` `case: buy` `case: new house` (YMD 2017 1 1) (YMD 2017 6 1) 400000) EQUALS `the grant, in dollars, is` 20000 "s 18(2)(ad), s 18D"
#ASSERT `the s 18 amount for` (`case: deal` `case: buy` `case: new house` (YMD 2021 10 1) (YMD 2022 6 1) 400000) EQUALS `the grant, in dollars, is` 30000 "s 18(2)(ai), s 18I"
#ASSERT `the s 18 amount for` (`case: deal` `case: buy` `case: new house` (YMD 2016 3 1) (YMD 2016 9 1) 400000) EQUALS `the grant, in dollars, is` 10000 "s 18(2)(b)(ii)"
-- The boundary of s 18H and s 18I: 31 March 2021 is in s 18H ($20 000), 1 April 2021 in s 18I ($30 000).
#ASSERT `the s 18 amount for` (`case: deal` `case: buy` `case: new house` (YMD 2021 3 31) (YMD 2021 9 1) 400000) EQUALS `the grant, in dollars, is` 20000 "s 18(2)(ah), s 18H"
#ASSERT `the s 18 amount for` (`case: deal` `case: buy` `case: new house` (YMD 2021 4 1) (YMD 2021 9 1) 400000) EQUALS `the grant, in dollars, is` 30000 "s 18(2)(ai), s 18I"
-- An established home under a 1 March 2014 contract: no s 18A-18C section reaches it; $7 000 (s 18(2)(b)(i)).
#ASSERT `the s 18 amount for` (`case: deal` `case: buy` `case: established house` (YMD 2014 3 1) (YMD 2014 5 1) 300000) EQUALS `the grant, in dollars, is` 7000 "s 18(2)(b)(i)"
-- A new home under a 1 March 2014 contract: s 18B's building conditions, not encoded.
#ASSERT `the s 18 amount for` (`case: deal` `case: buy` `case: new house` (YMD 2014 3 1) (YMD 2014 5 1) 300000) EQUALS `not covered` `the commencement date falls in a s 18A, 18B or 18C period (1 January 2013 to 31 December 2015) and the transaction is for a new home: those sections' building-commencement conditions are not encoded`
-- Before 1 January 2013: not covered.
#ASSERT `the s 18 amount for` (`case: deal` `case: buy` `case: new house` (YMD 2012 6 1) (YMD 2012 9 1) 300000) EQUALS `not covered` `the grant's commencement date is before 1 January 2013, when s 18 was substituted (No. 3 of 2013); the amount in force before then is not in the deposited consolidation`
-- The lesser of the consideration and the amount: an owner builder's actual costs of $15 000 in the s 18M period.
#ASSERT `the s 18 amount for` (`case: deal` `building the home as an owner builder` `case: new house` (YMD 2026 8 1) (YMD 2027 8 1) 15000) EQUALS `the grant, in dollars, is` 15000 "s 18(2)(am), s 18M"
-- Completed late (2 August 2028 after 1 August 2026), but the Commissioner extended the time: $20 000.
#ASSERT `the s 18 amount for` (`Grant transaction` WITH `kind` IS `case: buy`, `the home` IS `case: new house`, `is in Tasmania` IS TRUE, `the commencement date` IS YMD 2026 8 1, `the completion date` IS YMD 2028 8 2, `has been completed` IS TRUE, `the consideration` IS 520000, `the applicant is, or on completion will be, the owner of the land` IS TRUE, `the Commissioner is of the opinion it is part of a scheme to circumvent the Act (s 13(3))` IS FALSE, `the Tasmanian HomeBuilder grant was paid for it (s 7(4))` IS FALSE, `the Duties Act Division 2C pre-completion concession was applied to the transfer (Duties Act s 46X(2))` IS FALSE, `the Commissioner extended the time for completion (ss 18D(3)-18M(2))` IS TRUE, `the Commissioner considers it replaces an earlier transaction between substantially the same parties (ss 18D(4)-18M(3))` IS FALSE) EQUALS `the grant, in dollars, is` 20000 "s 18(2)(am), s 18M"
-- A replacement of an earlier transaction between the same parties (s 18M(3)): $10 000.
#ASSERT `the s 18 amount for` (`Grant transaction` WITH `kind` IS `case: buy`, `the home` IS `case: new house`, `is in Tasmania` IS TRUE, `the commencement date` IS YMD 2026 8 1, `the completion date` IS YMD 2026 12 1, `has been completed` IS TRUE, `the consideration` IS 520000, `the applicant is, or on completion will be, the owner of the land` IS TRUE, `the Commissioner is of the opinion it is part of a scheme to circumvent the Act (s 13(3))` IS FALSE, `the Tasmanian HomeBuilder grant was paid for it (s 7(4))` IS FALSE, `the Duties Act Division 2C pre-completion concession was applied to the transfer (Duties Act s 46X(2))` IS FALSE, `the Commissioner extended the time for completion (ss 18D(3)-18M(2))` IS FALSE, `the Commissioner considers it replaces an earlier transaction between substantially the same parties (ss 18D(4)-18M(3))` IS TRUE) EQUALS `the grant, in dollars, is` 10000 "s 18(2)(b)(ii)"

-- =====================================================================================================================
-- s 14(5)-(6) application period; s 15 joinder; s 7 entitlement; s 19(3).
-- =====================================================================================================================

-- Completion 1 December 2026: the period ends 1 December 2027. 15 January 2027 is in; 2 December 2027 is out.
#ASSERT `the last day of the application period for` `case: Jordan's contract` EQUALS YMD 2027 12 1
#ASSERT `the s 14(5) timing of` `case: Jordan's contract` (YMD 2027 1 15) FALSE EQUALS `within the application period, which ends on` (YMD 2027 12 1)
#ASSERT `the s 14(5) timing of` `case: Jordan's contract` (YMD 2027 12 2) FALSE EQUALS `outside the application period: only if the Commissioner allows it (s 14(6))` (YMD 2026 8 1) (YMD 2027 12 1)
-- ... the Commissioner has allowed the late application (s 14(6)).
#ASSERT `the s 14(5) timing of` `case: Jordan's contract` (YMD 2027 12 2) TRUE EQUALS `outside the application period, but the Commissioner has allowed it (s 14(6))`
-- Before the commencement date: outside too.
#ASSERT `the s 14(5) timing of` `case: Jordan's contract` (YMD 2026 7 1) FALSE EQUALS `outside the application period: only if the Commissioner allows it (s 14(6))` (YMD 2026 8 1) (YMD 2027 12 1)
-- The permission: applying on 15 January 2027 is within it; not applying at all is no breach.
#ASSERT EVALTRACE (`s 14(5) -- the applicant may apply for the grant within the application period` `case: Jordan's contract`) (DATE_SERIAL (YMD 2026 8 1)) (LIST (EVENT `the applicant for the grant` `apply for the grant` (DATE_SERIAL (YMD 2027 1 15)))) EQUALS FULFILLED
#ASSERT EVALTRACE (`s 14(5) -- the applicant may apply for the grant within the application period` `case: Jordan's contract`) (DATE_SERIAL (YMD 2026 8 1)) (LIST (WAITUNTIL (DATE_SERIAL (YMD 2028 1 1)))) EQUALS FULFILLED

-- s 15 and the Regulations: a co-owning person must join; Homes Tasmania (reg 5), Housing Australia under Help to Buy
-- (reg 5A) and the reg 4 holders need not.
#ASSERT `must join in the application (s 15)` `a person who is, or on completion will be, an owner of the home`
#ASSERT (NOT `must join in the application (s 15)` `Homes Tasmania (reg 5)`)
#ASSERT (NOT `must join in the application (s 15)` `the Commonwealth or Housing Australia under a Help to Buy arrangement (reg 5A, s 5(2A))`)
#ASSERT (NOT `must join in the application (s 15)` `another holder of a relevant interest, where the Commissioner recognised the applicant's non-conforming interest (reg 4)`)

-- s 7: Jordan alone, the new townhouse, completed: payable.
#ASSERT `the s 7 entitlement` (LIST `case: Jordan`) `case: Jordan's contract` (LIST `Homes Tasmania (reg 5)`) EQUALS `the grant is payable (s 7)`
-- ... buying with Housing Australia under Help to Buy, which does not apply: still payable.
#ASSERT `the s 7 entitlement` (LIST `case: Jordan`) `case: Jordan's contract` (LIST `the Commonwealth or Housing Australia under a Help to Buy arrangement (reg 5A, s 5(2A))`) EQUALS `the grant is payable (s 7)`
-- (finding 11) A parent on the title who does not apply: not payable (s 15); who does apply: fails criterion 4.
#ASSERT `the s 7 entitlement` (LIST `case: Jordan`) `case: Jordan's contract` (LIST `a person who is, or on completion will be, an owner of the home`) EQUALS `not payable: an interested person has not joined in the application (s 15)`
#ASSERT `the s 7 entitlement` (LIST `case: Jordan`, `case: applicant` 55 FALSE TRUE FALSE FALSE FALSE TRUE TRUE FALSE) `case: Jordan's contract` EMPTY EQUALS `not payable` `criterion 4: an applicant or spouse held and lived in residential property for 6 months before (s 11(3))`
-- An established home: the transaction is not eligible.
#ASSERT `the s 7 entitlement` (LIST `case: Jordan`) (`case: deal` `case: buy` `case: established house` (YMD 2026 8 1) (YMD 2026 12 1) 520000) EMPTY EQUALS `not payable: the transaction is not eligible` `not an eligible transaction: a contract made from 1 July 2014 must be for a new home (s 13(1)(ab))`
-- Not yet completed; HomeBuilder paid; Division 2C applied.
`case: not completed` MEANS
    `Grant transaction` WITH
        `kind`                                                                                       IS `case: buy`
        `the home`                                                                                   IS `case: new house`
        `is in Tasmania`                                                                             IS TRUE
        `the commencement date`                                                                      IS YMD 2026 8 1
        `the completion date`                                                                        IS YMD 2026 12 1
        `has been completed`                                                                         IS FALSE
        `the consideration`                                                                          IS 520000
        `the applicant is, or on completion will be, the owner of the land`                          IS TRUE
        `the Commissioner is of the opinion it is part of a scheme to circumvent the Act (s 13(3))`  IS FALSE
        `the Tasmanian HomeBuilder grant was paid for it (s 7(4))`                                   IS FALSE
        `the Duties Act Division 2C pre-completion concession was applied to the transfer (Duties Act s 46X(2))` IS FALSE
        `the Commissioner extended the time for completion (ss 18D(3)-18M(2))`                       IS FALSE
        `the Commissioner considers it replaces an earlier transaction between substantially the same parties (ss 18D(4)-18M(3))` IS FALSE
`case: homebuilder paid` MEANS
    `Grant transaction` WITH
        `kind`                                                                                       IS `case: buy`
        `the home`                                                                                   IS `case: new house`
        `is in Tasmania`                                                                             IS TRUE
        `the commencement date`                                                                      IS YMD 2020 8 1
        `the completion date`                                                                        IS YMD 2021 3 1
        `has been completed`                                                                         IS TRUE
        `the consideration`                                                                          IS 420000
        `the applicant is, or on completion will be, the owner of the land`                          IS TRUE
        `the Commissioner is of the opinion it is part of a scheme to circumvent the Act (s 13(3))`  IS FALSE
        `the Tasmanian HomeBuilder grant was paid for it (s 7(4))`                                   IS TRUE
        `the Duties Act Division 2C pre-completion concession was applied to the transfer (Duties Act s 46X(2))` IS FALSE
        `the Commissioner extended the time for completion (ss 18D(3)-18M(2))`                       IS FALSE
        `the Commissioner considers it replaces an earlier transaction between substantially the same parties (ss 18D(4)-18M(3))` IS FALSE
`case: div 2C applied` MEANS
    `Grant transaction` WITH
        `kind`                                                                                       IS `case: buy`
        `the home`                                                                                   IS `case: new house`
        `is in Tasmania`                                                                             IS TRUE
        `the commencement date`                                                                      IS YMD 2025 2 1
        `the completion date`                                                                        IS YMD 2026 9 1
        `has been completed`                                                                         IS TRUE
        `the consideration`                                                                          IS 600000
        `the applicant is, or on completion will be, the owner of the land`                          IS TRUE
        `the Commissioner is of the opinion it is part of a scheme to circumvent the Act (s 13(3))`  IS FALSE
        `the Tasmanian HomeBuilder grant was paid for it (s 7(4))`                                   IS FALSE
        `the Duties Act Division 2C pre-completion concession was applied to the transfer (Duties Act s 46X(2))` IS TRUE
        `the Commissioner extended the time for completion (ss 18D(3)-18M(2))`                       IS FALSE
        `the Commissioner considers it replaces an earlier transaction between substantially the same parties (ss 18D(4)-18M(3))` IS FALSE
#ASSERT `the s 7 entitlement` (LIST `case: Jordan`) `case: not completed` EMPTY EQUALS `not payable: the transaction has not been completed (s 7(1)(b)(ii))`
#ASSERT `the s 7 entitlement` (LIST `case: Jordan`) `case: homebuilder paid` EMPTY EQUALS `not payable: the HomeBuilder grant was paid (s 7(4))`
#ASSERT `the s 7 entitlement` (LIST `case: Jordan`) `case: div 2C applied` EMPTY EQUALS `not payable: the Duties Act Division 2C concession was applied (Duties Act s 46X(2))`

-- s 19(3): a new $520 000 townhouse pays the general rate (no exemption for a new home): 12 935 + 4.25 x 1 450 =
-- 19 097.50. A $20 000 grant applied to it leaves 0 to pay... no: 19 097.50 - 20 000 < 0, so duty 0 and 902.50 of grant
-- left. A $750 000 home's 28 935 duty less $20 000 leaves 8 935, and no grant left.
#ASSERT `the duty left after the grant is applied (s 19(3))` 19097.50 20000 EQUALS 0
#ASSERT `the grant left over after paying the duty (s 19(3))` 19097.50 20000 EQUALS 902.50
#ASSERT `the duty left after the grant is applied (s 19(3))` 28935 20000 EQUALS 8935
#ASSERT `the grant left over after paying the duty (s 19(3))` 28935 20000 EQUALS 0
-- The Commissioner's permission, used: fulfilled.
#ASSERT EVALTRACE `s 19(3) -- on request, the Commissioner may apply the grant towards the duty` 0 (LIST (EVENT `the Commissioner` `apply the grant towards a liability for State taxes` 5)) EQUALS FULFILLED

-- =====================================================================================================================
-- ss 12, 20: a grant paid in anticipation. Completion 1 December 2026; the last day to begin is 1 December 2027.
-- =====================================================================================================================

-- s 20(3)(a): the end of the period allowed for compliance: 1 December 2027 + 6 months = 1 June 2028.
#ASSERT `the end of the period allowed for compliance (s 20(3)(a))` (YMD 2026 12 1) 12 6 EQUALS YMD 2028 6 1
-- s 20(3): the relevant date is the earlier: it became apparent on 1 May 2027 -> 1 May 2027.
#ASSERT `the relevant date (s 20(3))` (YMD 2028 6 1) (YMD 2027 5 1) EQUALS YMD 2027 5 1
#ASSERT `the relevant date (s 20(3))` (YMD 2028 6 1) (YMD 2028 7 1) EQUALS YMD 2028 6 1
-- Moved in 1 January 2027 and still there on 1 August 2027: fulfilled.
#ASSERT EVALTRACE (`ss 12, 20 -- the applicant's residence requirement after a grant paid in anticipation` FALSE (YMD 2026 12 1) 12 6) (DATE_SERIAL (YMD 2026 12 1)) (LIST (EVENT `the applicant for the grant` (`begin to occupy the home as principal place of residence` (DATE_SERIAL (YMD 2027 1 1))) (DATE_SERIAL (YMD 2027 1 1))), (WAITUNTIL (DATE_SERIAL (YMD 2027 8 1)))) EQUALS FULFILLED
-- Never moved in; after 1 December 2027 the applicant gave notice and repaid on 10 December 2027: fulfilled.
#ASSERT EVALTRACE (`ss 12, 20 -- the applicant's residence requirement after a grant paid in anticipation` FALSE (YMD 2026 12 1) 12 6) (DATE_SERIAL (YMD 2026 12 1)) (LIST (WAITUNTIL (DATE_SERIAL (YMD 2027 12 2))), (EVENT `the applicant for the grant` `give the Commissioner written notice of the failure` (DATE_SERIAL (YMD 2027 12 10))), (EVENT `the applicant for the grant` `repay the grant` (DATE_SERIAL (YMD 2027 12 10)))) EQUALS FULFILLED
-- Moved in 1 January 2027, sold on 1 March 2027 (s 20(3A)); notice and repayment on 14 March 2027: fulfilled.
#ASSERT EVALTRACE (`ss 12, 20 -- the applicant's residence requirement after a grant paid in anticipation` FALSE (YMD 2026 12 1) 12 6) (DATE_SERIAL (YMD 2026 12 1)) (LIST (EVENT `the applicant for the grant` (`begin to occupy the home as principal place of residence` (DATE_SERIAL (YMD 2027 1 1))) (DATE_SERIAL (YMD 2027 1 1))), (EVENT `the applicant for the grant` (`end the stay in the home` `by ceasing to hold the interest in the land` (DATE_SERIAL (YMD 2027 3 1))) (DATE_SERIAL (YMD 2027 3 1))), (EVENT `the applicant for the grant` `give the Commissioner written notice of the failure` (DATE_SERIAL (YMD 2027 3 14))), (EVENT `the applicant for the grant` `repay the grant` (DATE_SERIAL (YMD 2027 3 15)))) EQUALS FULFILLED
-- A joint applicant exempted under s 12(2): bound to nothing.
#ASSERT EVALTRACE (`ss 12, 20 -- the applicant's residence requirement after a grant paid in anticipation` TRUE (YMD 2026 12 1) 12 6) (DATE_SERIAL (YMD 2026 12 1)) (LIST (WAITUNTIL (DATE_SERIAL (YMD 2028 12 1)))) EQUALS FULFILLED
-- The situation form, from the relevant date (day 0): notice on day 5, repayment on day 14: fulfilled.
#ASSERT EVALTRACE `s 20(2), (3A) -- after the relevant date, give notice and repay within 14 days` 0 (LIST (EVENT `the applicant for the grant` `give the Commissioner written notice of the failure` 5), (EVENT `the applicant for the grant` `repay the grant` 14)) EQUALS FULFILLED
-- expect: BREACH BY the applicant for the grant, "FHOG Act s 20(2)(b), (3A)(b), (4): the grant must be repaid within 14
-- days ..." (notice given, grant not repaid by day 14)
#TRACE `s 20(2), (3A) -- after the relevant date, give notice and repay within 14 days` AT 0 WITH
    PARTY `the applicant for the grant` DOES `give the Commissioner written notice of the failure` AT 5
    (WAITUNTIL 20)
-- expect: the notice and the repayment both owed (never moved in, the 12 months passed on 1 December 2027)
#TRACE `ss 12, 20 -- the applicant's residence requirement after a grant paid in anticipation` FALSE (YMD 2026 12 1) 12 6 AT DATE_SERIAL (YMD 2026 12 1) WITH
    (WAITUNTIL (DATE_SERIAL (YMD 2027 12 2)))

-- =====================================================================================================================
-- s 38: a written notice to repay (clock: days from the notice; the notice allows 30).
-- =====================================================================================================================

#ASSERT EVALTRACE (`s 38 -- repay within the time the notice allows, or the Commissioner may impose a penalty` 30) 0 (LIST (EVENT `the applicant for the grant` `repay the grant` 21)) EQUALS FULFILLED
-- expect: the Commissioner's permission to impose a penalty up to the amount to be repaid (not repaid by day 30)
#TRACE `s 38 -- repay within the time the notice allows, or the Commissioner may impose a penalty` 30 AT 0 WITH
    (WAITUNTIL 31)
-- s 38(3): a $20 000 repayment can attract a penalty of up to $20 000.
#ASSERT `the most penalty that can be imposed (s 38(3))` 20000 EQUALS 20000
