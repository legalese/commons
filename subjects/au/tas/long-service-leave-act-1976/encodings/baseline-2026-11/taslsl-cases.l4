#ASSERT `Can I refer my dispute` `something else` EQUALS JUST FALSE

#ASSERT `Am I barred from this representative` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Am I barred from this representative` TRUE TRUE EQUALS JUST FALSE
#ASSERT `Am I barred from this representative` FALSE FALSE EQUALS JUST FALSE

-- s 15(1): due 10 March 2023; an application on 10 March 2026 reaches it, on 11 March 2026 it does not.
#ASSERT `Can I still apply to a magistrate for this payment` (`d` 10 3 2023) (`d` 10 3 2026) EQUALS JUST TRUE
#ASSERT `Can I still apply to a magistrate for this payment` (`d` 10 3 2023) (`d` 11 3 2026) EQUALS JUST FALSE
#ASSERT `Can I still apply to a magistrate for this payment` (`d` 29 2 2024) (`d` 28 2 2027) EQUALS JUST TRUE
#ASSERT `Can I still apply to a magistrate for this payment` (`d` 29 2 2024) (`d` 1 3 2027) EQUALS JUST FALSE
#ASSERT `Can I still apply to a magistrate for this payment` (`d` 1 6 2026) (`d` 1 5 2026) EQUALS JUST FALSE
