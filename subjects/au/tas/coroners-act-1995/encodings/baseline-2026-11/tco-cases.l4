#ASSERT `Can I still make my 48-hour application` `na` TRUE TRUE (`d` 30 4 2026) 23 15 (`d` 3 5 2026) 0 0 EQUALS JUST FALSE
#ASSERT `Can I still make my 48-hour application` `na` FALSE TRUE (`d` 30 4 2026) 23 15 (`d` 1 5 2026) 10 0 EQUALS NOTHING
#ASSERT `Can I still make my 48-hour application` `na` TRUE FALSE (`d` 30 4 2026) 23 15 (`d` 1 5 2026) 10 0 EQUALS NOTHING
#ASSERT `Can I still make my 48-hour application` `ex` TRUE FALSE (`d` 5 8 2026) 9 0 (`d` 7 8 2026) 9 0 EQUALS JUST TRUE
#ASSERT `Can I still make my 48-hour application` `ex` TRUE FALSE (`d` 5 8 2026) 9 0 (`d` 7 8 2026) 9 1 EQUALS JUST FALSE
#ASSERT `Can I still make my 48-hour application` `ex` FALSE TRUE (`d` 5 8 2026) 9 0 (`d` 6 8 2026) 9 0 EQUALS NOTHING

