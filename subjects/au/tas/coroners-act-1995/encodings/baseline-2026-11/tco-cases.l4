#ASSERT `Who hears my records appeal` TRUE EQUALS `the Supreme Court`
#ASSERT `Who hears my records appeal` FALSE EQUALS `the Chief Magistrate, with a further appeal to the Supreme Court`

§§ `ss 58, 58A -- reopening`

#ASSERT `Can the investigation be reopened` TRUE FALSE FALSE `new facts or evidence affecting the findings` EQUALS `the Chief Magistrate may reopen the investigation on your application`
#ASSERT `Can the investigation be reopened` TRUE TRUE FALSE `new facts or evidence affecting the findings` EQUALS `the Chief Magistrate may not reopen it while a section 58A application is before the Supreme Court`
#ASSERT `Can the investigation be reopened` TRUE FALSE TRUE `fraud` EQUALS `the Chief Magistrate may not reopen it on substantially the grounds the Supreme Court rejected`
#ASSERT `Can the investigation be reopened` TRUE FALSE FALSE `no such ground` EQUALS `the Chief Magistrate may not reopen it without being satisfied of a ground; a refusal of your application can be appealed`
#ASSERT `Can the investigation be reopened` FALSE FALSE FALSE `fraud` EQUALS `you cannot apply, though the Chief Magistrate may reopen it on his or her own initiative`

#ASSERT `Can the Supreme Court void the inquest findings` TRUE `findings not supported by the evidence` EQUALS JUST TRUE
#ASSERT `Can the Supreme Court void the inquest findings` TRUE `no such ground` EQUALS JUST FALSE
#ASSERT `Can the Supreme Court void the inquest findings` FALSE `fraud` EQUALS NOTHING

§§ `ss 59A, 60-63 -- property`

`go on` MEANS `the investigation is continuing`
`ended` MEANS `the investigation has concluded, or the inquest is adjourned or concluded, and no order has yet been made`
`ordered` MEANS `the coroner has made an order about the item`

#ASSERT `What can I do about my property held by the coroner` TRUE TRUE `go on` FALSE FALSE EQUALS `you may apply to the coroner for orders about its care and control, and are entitled to be heard`
#ASSERT `What can I do about my property held by the coroner` TRUE TRUE `ended` FALSE FALSE EQUALS `the coroner must make orders for its custody or disposition, and you are entitled to be heard`
#ASSERT `What can I do about my property held by the coroner` TRUE TRUE `ended` TRUE FALSE EQUALS `the coroner need not make orders now: it is likely to be needed for other legal proceedings`
#ASSERT `What can I do about my property held by the coroner` TRUE TRUE `ordered` FALSE FALSE EQUALS `you may ask the Supreme Court to review the order`
#ASSERT `What can I do about my property held by the coroner` TRUE TRUE `ordered` FALSE TRUE EQUALS `you may ask the Supreme Court to review the order, or the coroner to vary or revoke it`
#ASSERT `What can I do about my property held by the coroner` FALSE TRUE `go on` FALSE FALSE EQUALS `section 60 does not apply to you`
#ASSERT `What can I do about my property held by the coroner` TRUE FALSE `go on` FALSE FALSE EQUALS `section 60 does not apply to you`

-- Taken 10 March 2026, no coroner then investigating; 12 months end 10 March 2027.
#ASSERT `What happens to my item the police took` FALSE (`d` 10 3 2026) FALSE `nd` FALSE (`d` 1 9 2026) EQUALS `the police may keep it until an investigation begins or 12 months pass`
#ASSERT `What happens to my item the police took` FALSE (`d` 10 3 2026) FALSE `nd` FALSE (`d` 10 3 2027) EQUALS `the police may keep it until an investigation begins or 12 months pass`
#ASSERT `What happens to my item the police took` FALSE (`d` 10 3 2026) FALSE `nd` FALSE (`d` 11 3 2027) EQUALS `it must be returned to the person it was taken from, or to the person entitled to it`
#ASSERT `What happens to my item the police took` FALSE (`d` 10 3 2026) FALSE `nd` TRUE (`d` 11 3 2027) EQUALS `it is to be disposed of as the Commissioner of Police directs`
#ASSERT `What happens to my item the police took` FALSE (`d` 10 3 2026) TRUE (`d` 10 3 2027) FALSE (`d` 1 4 2027) EQUALS `it is in the coroner's custody: section 60 applies to it`
#ASSERT `What happens to my item the police took` FALSE (`d` 10 3 2026) TRUE (`d` 11 3 2027) FALSE (`d` 1 4 2027) EQUALS `it must be returned to the person it was taken from, or to the person entitled to it`
#ASSERT `What happens to my item the police took` TRUE (`d` 10 3 2026) FALSE `nd` FALSE (`d` 1 4 2027) EQUALS `it is in the coroner's custody: section 60 applies to it`
