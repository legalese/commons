IMPORT prelude
IMPORT daydate
IMPORT `dba-types`
IMPORT `dba-rules`

-- Independent tests: Damage by Aircraft Act 1999 (Cth).
-- Expectations written in independent-expectations.md from BRIEF.md and the
-- source before any .l4 file was read. Scenario numbers match that file.

§ `Builders`

`baseline aircraft` MEANS `Aircraft facts` OF FALSE, FALSE, TRUE, TRUE

`baseline people` MEANS `People facts` OF TRUE, TRUE, FALSE, FALSE, TRUE, FALSE, FALSE

GIVEN ac IS A `Aircraft facts`
      cz IS A `Cause`
      mental IS A BOOLEAN
      dd IS A DATE
      pp IS A `People facts`
      dmg IS A NUMBER
      pct IS A NUMBER
GIVETH A `Harm case`
`case of` ac cz mental dd pp dmg pct MEANS
    `Harm case` OF ac, cz, mental, dd, pp, dmg, pct

`June 2014` MEANS Date 1 6 2014

`baseline` MEANS `case of` `baseline aircraft` `an impact with an aircraft in flight` FALSE `June 2014` `baseline people` 100000 25

GIVEN ac IS A `Aircraft facts`
GIVETH A `Harm case`
`with aircraft` ac MEANS `case of` ac `an impact with an aircraft in flight` FALSE `June 2014` `baseline people` 100000 25

GIVEN cz IS A `Cause`
GIVETH A `Harm case`
`with cause` cz MEANS `case of` `baseline aircraft` cz FALSE `June 2014` `baseline people` 100000 25

GIVEN dd IS A DATE
GIVETH A `Harm case`
`mental only at` dd MEANS `case of` `baseline aircraft` `an impact with an aircraft in flight` TRUE dd `baseline people` 100000 25

GIVEN pp IS A `People facts`
GIVETH A `Harm case`
`with people` pp MEANS `case of` `baseline aircraft` `an impact with an aircraft in flight` FALSE `June 2014` pp 100000 25

GIVEN dd IS A DATE
      pct IS A NUMBER
GIVETH A `Harm case`
`negligent at` dd pct MEANS `case of` `baseline aircraft` `an impact with an aircraft in flight` FALSE dd `baseline people` 100000 pct

GIVEN o IS A BOOLEAN
      w IS A BOOLEAN
      a IS A BOOLEAN
      c IS A BOOLEAN
GIVETH A MAYBE `Persons liable`
`liable` o w a c MEANS JUST (`Persons liable` OF o, w, a, c)

§ `s 4 and s 9`

-- 1
#ASSERT `s 10 applies to` `baseline`
-- 2 Defence Force aircraft
#ASSERT NOT (`s 10 applies to` (`with aircraft` (`Aircraft facts` OF TRUE, FALSE, TRUE, FALSE)))
-- 3 Defence Force aircraft also within a s 9(4) category
#ASSERT NOT (`s 10 applies to` (`with aircraft` (`Aircraft facts` OF TRUE, FALSE, TRUE, TRUE)))
-- 4 model aircraft
#ASSERT NOT (`s 10 applies to` (`with aircraft` (`Aircraft facts` OF FALSE, TRUE, TRUE, TRUE)))
-- 5 outside Australian territory
#ASSERT NOT (`s 10 applies to` (`with aircraft` (`Aircraft facts` OF FALSE, FALSE, FALSE, TRUE)))
-- 6 no s 9(4) category
#ASSERT NOT (`s 10 applies to` (`with aircraft` (`Aircraft facts` OF FALSE, FALSE, TRUE, FALSE)))
-- 6 knock-on: no liability, no s 11
#ASSERT `who is liable to me for` (`with aircraft` (`Aircraft facts` OF FALSE, FALSE, TRUE, FALSE)) EQUALS NOTHING
#ASSERT NOT (`I can recover without proof of fault for` (`with aircraft` (`Aircraft facts` OF TRUE, FALSE, TRUE, TRUE)))
-- 7, 8 are single-flag cases (s 9(4) is one boolean in the types): covered by 1.

§ `s 10(1)`

-- 9
#ASSERT `s 10 applies to` (`with cause` `an impact with an aircraft in flight`)
-- 10
#ASSERT `s 10 applies to` (`with cause` `an impact with part of an aircraft damaged in flight`)
-- 11
#ASSERT `s 10 applies to` (`with cause` `an impact with something that fell from an aircraft in flight`)
-- 12
#ASSERT `s 10 applies to` (`with cause` `a result of such an impact`)
-- 13
#ASSERT NOT (`s 10 applies to` (`with cause` `something else`))
#ASSERT `who is liable to me for` (`with cause` `something else`) EQUALS NOTHING
#ASSERT NOT (`I can recover without proof of fault for` (`with cause` `something else`))
#ASSERT `my damages after contributory negligence for` (`with cause` `something else`) EQUALS NOTHING

§ `s 10(1A)`

-- 14
#ASSERT NOT (`s 10 applies to` (`mental only at` (Date 1 6 2014)))
-- 15
#ASSERT NOT (`s 10 applies to` (`mental only at` (Date 31 3 2013)))
-- 16
#ASSERT `s 10 applies to` (`mental only at` (Date 30 3 2013))
-- 17 mental injury plus other injury: modelled as only-mental FALSE
#ASSERT `s 10 applies to` (`case of` `baseline aircraft` `an impact with an aircraft in flight` FALSE (Date 1 6 2014) `baseline people` 100000 0)

§ `s 10(2), (2A), (3)`

-- 18
#ASSERT `who is liable to me for` `baseline` EQUALS `liable` TRUE TRUE FALSE FALSE
-- 19 exclusive right only 10 days
#ASSERT `who is liable to me for` (`with people` (`People facts` OF TRUE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE)) EQUALS `liable` TRUE TRUE TRUE FALSE
-- 20 exactly 14 days: "more than 14" not met
#ASSERT `who is liable to me for` (`with people` (`People facts` OF TRUE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE)) EQUALS `liable` TRUE TRUE TRUE FALSE
-- 21 unauthorised use, no reasonable steps
#ASSERT `who is liable to me for` (`with people` (`People facts` OF TRUE, TRUE, TRUE, FALSE, TRUE, FALSE, FALSE)) EQUALS `liable` TRUE TRUE FALSE TRUE
-- 22 unauthorised use, all reasonable steps taken: s 10(3)
#ASSERT `who is liable to me for` (`with people` (`People facts` OF TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, FALSE)) EQUALS `liable` TRUE TRUE FALSE FALSE
-- 23 passive owner, lease
#ASSERT `who is liable to me for` (`with people` (`People facts` OF TRUE, TRUE, FALSE, FALSE, FALSE, TRUE, FALSE)) EQUALS `liable` TRUE FALSE FALSE FALSE
-- 24 passive owner, financial accommodation
#ASSERT `who is liable to me for` (`with people` (`People facts` OF TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, TRUE)) EQUALS `liable` TRUE FALSE FALSE FALSE
-- 25 active owner, lease
#ASSERT `who is liable to me for` (`with people` (`People facts` OF TRUE, TRUE, FALSE, FALSE, TRUE, TRUE, FALSE)) EQUALS `liable` TRUE TRUE FALSE FALSE
-- 26 passive owner, no lease, no finance
#ASSERT `who is liable to me for` (`with people` (`People facts` OF TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS `liable` TRUE TRUE FALSE FALSE

§ `s 11`

-- 27
#ASSERT `I can recover without proof of fault for` `baseline`
-- 28
#ASSERT NOT (`I can recover without proof of fault for` (`mental only at` (Date 1 6 2014)))
#ASSERT `who is liable to me for` (`mental only at` (Date 1 6 2014)) EQUALS NOTHING

§ `s 11A`

-- 29
#ASSERT `my damages after contributory negligence for` (`negligent at` (Date 1 6 2014) 25) EQUALS JUST 75000
-- 30
#ASSERT `my damages after contributory negligence for` (`negligent at` (Date 1 6 2014) 0) EQUALS JUST 100000
-- 31
#ASSERT `my damages after contributory negligence for` (`negligent at` (Date 1 6 2014) 100) EQUALS JUST 0
-- 32 before commencement
#ASSERT `my damages after contributory negligence for` (`negligent at` (Date 30 3 2013) 25) EQUALS NOTHING
-- 33 commencement day
#ASSERT `my damages after contributory negligence for` (`negligent at` (Date 31 3 2013) 50) EQUALS JUST 50000

§ `Top-level goal`

#ASSERT `the aircraft harm position for` `baseline` EQUALS
    (`Aircraft harm position` OF TRUE, (`liable` TRUE TRUE FALSE FALSE), TRUE, JUST 75000)
#ASSERT `the aircraft harm position for` (`negligent at` (Date 30 3 2013) 25) EQUALS
    (`Aircraft harm position` OF TRUE, (`liable` TRUE TRUE FALSE FALSE), TRUE, NOTHING)
#ASSERT `the aircraft harm position for` (`mental only at` (Date 1 6 2014)) EQUALS
    (`Aircraft harm position` OF FALSE, NOTHING, FALSE, NOTHING)
