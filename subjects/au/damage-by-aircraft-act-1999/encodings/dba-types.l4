IMPORT prelude
IMPORT daydate

-- Damage by Aircraft Act 1999 (Cth) — THE NOUNS.
-- Source: ../registers/source-bundle/C2004A00498.txt (compilation
-- C2013C00130, in force 31 March 2013). Seat: the person on the ground.

§ `Nouns`

-- s 10(1)(a)-(d)
DECLARE `Cause` IS ONE OF
    `an impact with an aircraft in flight`
    `an impact with part of an aircraft damaged in flight`
    `an impact with something that fell from an aircraft in flight`
    `a result of such an impact`
    `something else`

DECLARE `Aircraft facts` HAS
    -- s 9(2)
    `a Defence Force aircraft`                          IS A BOOLEAN
    -- s 4: "aircraft ... does not include model aircraft"
    `a model aircraft`                                  IS A BOOLEAN
    -- s 9(3)
    `within Australian territory`                       IS A BOOLEAN
    -- s 9(4)(a)-(c): a Commonwealth aircraft, one owned by a foreign or
    -- constitutional corporation, or one engaged in the kinds of air
    -- navigation listed
    `an aircraft within s 9(4)`                         IS A BOOLEAN

DECLARE `People facts` HAS
    -- s 10(2)(c)
    `the operator was authorised to use it`             IS A BOOLEAN
    `the operator had exclusive use for more than 14 consecutive days` IS A BOOLEAN
    -- s 10(2)(d), (3)
    `the operator used it without the navigation controller's authority` IS A BOOLEAN
    `the navigation controller took all reasonable steps to prevent it` IS A BOOLEAN
    -- s 10(2A)
    `the owner had an active role in its operation`     IS A BOOLEAN
    `another had exclusive use under a lease or arrangement` IS A BOOLEAN
    `another had exclusive use with the owner financing` IS A BOOLEAN

DECLARE `Harm case` HAS
    `the aircraft`                                      IS A `Aircraft facts`
    `the cause`                                         IS A `Cause`
    -- s 10(1A)
    `only mental injury`                                IS A BOOLEAN
    `suffered on`                                       IS A DATE
    `the people`                                        IS A `People facts`
    -- s 11A(2)-(3): the court's findings
    `damages but for my negligence`                     IS A NUMBER
    `my share of responsibility, percent`               IS A NUMBER

DECLARE `Persons liable` HAS
    `the operator`                                      IS A BOOLEAN
    `the owner`                                         IS A BOOLEAN
    `the person who authorised the use`                 IS A BOOLEAN
    `the person entitled to control navigation`         IS A BOOLEAN

DECLARE `Aircraft harm position` HAS
    `the Act applies`                                   IS A BOOLEAN
    `who is liable`                                     IS A MAYBE `Persons liable`
    `recoverable without proof of fault`                IS A BOOLEAN
    `damages after my contributory negligence`          IS A MAYBE NUMBER
