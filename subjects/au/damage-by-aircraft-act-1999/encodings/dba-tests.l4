IMPORT prelude
IMPORT daydate
IMPORT `dba-types`
IMPORT `dba-rules`

-- Damage by Aircraft Act 1999 (Cth) — the encoder's tests.

§ `Tests`

-- Fields: Defence Force, model, within Australian territory, within s 9(4).
plane MEANS `Aircraft facts` OF FALSE, FALSE, TRUE, TRUE
-- Fields: operator authorised, exclusive > 14 days, used without authority,
-- reasonable steps, owner active, exclusive lease, exclusive with finance.
owned MEANS `People facts` OF FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE
shortHire MEANS `People facts` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
longLease MEANS `People facts` OF TRUE, TRUE, FALSE, FALSE, FALSE, TRUE, FALSE
stolen MEANS `People facts` OF FALSE, FALSE, TRUE, FALSE, TRUE, FALSE, FALSE
stolenDespite MEANS `People facts` OF FALSE, FALSE, TRUE, TRUE, TRUE, FALSE, FALSE

GIVEN ac IS A `Aircraft facts`, cs IS A `Cause`, mental IS A BOOLEAN, day IS A DATE, pp IS A `People facts`
GIVETH A `Harm case`
`harm by` ac `through` cs `mental only` mental `on` day `people` pp MEANS
    `Harm case` OF ac, cs, mental, day, pp, 100000, 25

GIVEN pp IS A `People facts`
GIVETH A `Harm case`
`a crash on my house with` pp MEANS
    `harm by` plane `through` `an impact with an aircraft in flight` `mental only` FALSE `on` (Date 1 6 2020) `people` pp

#ASSERT `s 10 applies to` (`a crash on my house with` owned)
#ASSERT `I can recover without proof of fault for` (`a crash on my house with` owned)
#ASSERT `who is liable to me for` (`a crash on my house with` owned) EQUALS JUST (`Persons liable` OF TRUE, TRUE, FALSE, FALSE)
-- s 10(2)(c): a short hire makes the person who authorised it liable.
#ASSERT `who is liable to me for` (`a crash on my house with` shortHire) EQUALS JUST (`Persons liable` OF TRUE, TRUE, TRUE, FALSE)
-- s 10(2A): a passive owner under an exclusive lease is not liable.
#ASSERT `who is liable to me for` (`a crash on my house with` longLease) EQUALS JUST (`Persons liable` OF TRUE, FALSE, FALSE, FALSE)
-- s 10(2)(d), (3)
#ASSERT `who is liable to me for` (`a crash on my house with` stolen) EQUALS JUST (`Persons liable` OF TRUE, TRUE, FALSE, TRUE)
#ASSERT `who is liable to me for` (`a crash on my house with` stolenDespite) EQUALS JUST (`Persons liable` OF TRUE, TRUE, FALSE, FALSE)

-- s 9, s 4: no application.
#ASSERT NOT (`s 10 applies to` (`harm by` (`Aircraft facts` OF TRUE, FALSE, TRUE, TRUE) `through` `an impact with an aircraft in flight` `mental only` FALSE `on` (Date 1 6 2020) `people` owned))
#ASSERT NOT (`s 10 applies to` (`harm by` (`Aircraft facts` OF FALSE, TRUE, TRUE, TRUE) `through` `an impact with an aircraft in flight` `mental only` FALSE `on` (Date 1 6 2020) `people` owned))
#ASSERT NOT (`s 10 applies to` (`harm by` (`Aircraft facts` OF FALSE, FALSE, FALSE, TRUE) `through` `an impact with an aircraft in flight` `mental only` FALSE `on` (Date 1 6 2020) `people` owned))
#ASSERT NOT (`s 10 applies to` (`harm by` (`Aircraft facts` OF FALSE, FALSE, TRUE, FALSE) `through` `an impact with an aircraft in flight` `mental only` FALSE `on` (Date 1 6 2020) `people` owned))
#ASSERT `who is liable to me for` (`harm by` (`Aircraft facts` OF TRUE, FALSE, TRUE, TRUE) `through` `an impact with an aircraft in flight` `mental only` FALSE `on` (Date 1 6 2020) `people` owned) EQUALS NOTHING
-- s 10(1)(b)-(d)
#ASSERT `s 10 applies to` (`harm by` plane `through` `an impact with part of an aircraft damaged in flight` `mental only` FALSE `on` (Date 1 6 2020) `people` owned)
#ASSERT `s 10 applies to` (`harm by` plane `through` `an impact with something that fell from an aircraft in flight` `mental only` FALSE `on` (Date 1 6 2020) `people` owned)
#ASSERT `s 10 applies to` (`harm by` plane `through` `a result of such an impact` `mental only` FALSE `on` (Date 1 6 2020) `people` owned)
#ASSERT NOT (`s 10 applies to` (`harm by` plane `through` `something else` `mental only` FALSE `on` (Date 1 6 2020) `people` owned))
-- s 10(1A): mental injury alone from 31 March 2013.
#ASSERT NOT (`s 10 applies to` (`harm by` plane `through` `an impact with an aircraft in flight` `mental only` TRUE `on` (Date 31 3 2013) `people` owned))
#ASSERT `s 10 applies to` (`harm by` plane `through` `an impact with an aircraft in flight` `mental only` TRUE `on` (Date 30 3 2013) `people` owned)

-- s 11A: £100,000 less my 25% share; not before 31 March 2013.
#ASSERT `my damages after contributory negligence for` (`a crash on my house with` owned) EQUALS JUST 75000
#ASSERT `my damages after contributory negligence for` (`harm by` plane `through` `an impact with an aircraft in flight` `mental only` FALSE `on` (Date 30 3 2013) `people` owned) EQUALS NOTHING
#ASSERT `my damages after contributory negligence for` (`harm by` plane `through` `an impact with an aircraft in flight` `mental only` FALSE `on` (Date 31 3 2013) `people` owned) EQUALS JUST 75000
#ASSERT `my damages after contributory negligence for` (`Harm case` OF plane, `an impact with an aircraft in flight`, FALSE, Date 1 6 2020, owned, 100000, 0) EQUALS JUST 100000
#ASSERT `my damages after contributory negligence for` (`Harm case` OF plane, `an impact with an aircraft in flight`, FALSE, Date 1 6 2020, owned, 100000, 100) EQUALS JUST 0

-- The top-level goal.
#ASSERT (`the aircraft harm position for` (`a crash on my house with` shortHire))'s `the Act applies`
#ASSERT (`the aircraft harm position for` (`a crash on my house with` shortHire))'s `who is liable` EQUALS JUST (`Persons liable` OF TRUE, TRUE, TRUE, FALSE)
#ASSERT (`the aircraft harm position for` (`a crash on my house with` shortHire))'s `damages after my contributory negligence` EQUALS JUST 75000
