IMPORT prelude
IMPORT `jllp-rules`

-- Independent tests: expected values decided from the source text before
-- reading jllp-rules.l4 (see independent-expectations.md).

`fed` MEANS `a Judge of a federal court other than the High Court or the Federal Circuit and Family Court (Division 2)`
`resign` MEANS `I resign or my term ends`
`age` MEANS `I reach the age at which I must cease to hold office`
`removed` MEANS `I am removed under section 72 of the Constitution or a like provision`

GIVEN o IS A `Judicial office`
      how IS A `Ceasing`
      svc IS A NUMBER
      qual IS A NUMBER
GIVETH A `Judge case`
`simple` o how svc qual MEANS
    `Judge case` OF o, how, FALSE, svc, qual, 520000, FALSE, FALSE, FALSE, FALSE

GIVEN svc IS A NUMBER
      sp IS A BOOLEAN
      deps IS A BOOLEAN
GIVETH A `Judge case`
`death case` svc sp deps MEANS
    `Judge case` OF `fed`, `I die`, FALSE, svc, svc, 520000, FALSE, FALSE, sp, deps

-- 1
#ASSERT `the long leave position for` (`simple` `fed` `resign` 10 10) EQUALS `Long leave position` OF 52, 520000, `me`
-- 2
#ASSERT `the long leave position for` (`simple` `fed` `resign` 9.9 9.9) EQUALS `Long leave position` OF 0, 0, `no one`
-- 3
#ASSERT `the long leave position for` (`simple` `fed` `resign` 12 12) EQUALS `Long leave position` OF 52, 520000, `me`
-- 4
#ASSERT `the long leave position for` (`simple` `fed` `resign` 15 8) EQUALS `Long leave position` OF 41.6, 416000, `me`
-- 5
#ASSERT `the long leave position for` (`simple` `fed` `resign` 11 10.9) EQUALS `Long leave position` OF 52, 520000, `me`
-- 6
#ASSERT `the long leave position for` (`simple` `fed` `resign` 15 9.9) EQUALS `Long leave position` OF 46.8, 468000, `me`
-- 7-9
#ASSERT `the long leave position for` (`death case` 3 TRUE TRUE) EQUALS `Long leave position` OF 15.6, 156000, `my surviving spouse or de facto partner`
#ASSERT `the long leave position for` (`death case` 3 FALSE TRUE) EQUALS `Long leave position` OF 15.6, 156000, `my dependants`
#ASSERT `the long leave position for` (`death case` 3 FALSE FALSE) EQUALS `Long leave position` OF 15.6, 156000, `my legal personal representative`
-- 10: death after half a year: 0 completed years; payee still the spouse (low-stakes)
#ASSERT `the weeks payable for` (`death case` 0.5 TRUE FALSE) EQUALS 0
#ASSERT `the recipient for` (`death case` 0.5 TRUE FALSE) EQUALS `my surviving spouse or de facto partner`
-- 11-14: compulsory age
#ASSERT `the long leave position for` (`simple` `fed` `age` 6 6) EQUALS `Long leave position` OF 31.2, 312000, `me`
#ASSERT `the long leave position for` (`simple` `fed` `age` 5.9 5.9) EQUALS `Long leave position` OF 0, 0, `no one`
#ASSERT `the long leave position for` (`simple` `fed` `age` 9 9) EQUALS `Long leave position` OF 46.8, 468000, `me`
#ASSERT `the long leave position for` (`simple` `fed` `age` 20 20) EQUALS `Long leave position` OF 52, 520000, `me`
-- 15: disability certificate
#ASSERT `the long leave position for` (`Judge case` OF `fed`, `resign`, FALSE, 4, 4, 520000, TRUE, FALSE, FALSE, FALSE) EQUALS `Long leave position` OF 20.8, 208000, `me`
-- 16
#ASSERT `the weeks payable for` (`simple` `fed` `resign` 4 4) EQUALS 0
-- 17/18: removal
#ASSERT `the weeks payable for` (`simple` `fed` `removed` 15 15) EQUALS 0
#ASSERT `the long leave position for` (`Judge case` OF `fed`, `removed`, FALSE, 15, 15, 520000, FALSE, TRUE, FALSE, FALSE) EQUALS `Long leave position` OF 52, 520000, `me`
-- 19: consecutive appointment
#ASSERT `the weeks payable for` (`Judge case` OF `fed`, `resign`, TRUE, 15, 15, 520000, FALSE, FALSE, FALSE, FALSE) EQUALS 0
-- 20: High Court Justice
#ASSERT `the weeks payable for` (`simple` `a Justice of the High Court` `resign` 15 15) EQUALS 0
-- 21/22: other limbs of Judge
#ASSERT `the amount payable for` (`simple` `a person with the same status as such a Judge by virtue of an Act` `resign` 10 10) EQUALS 520000
#ASSERT `the amount payable for` (`simple` `a Judge of the ACT Supreme Court immediately before the 1992 transfer` `resign` 10 10) EQUALS 520000
-- 23: different salary
#ASSERT `the amount payable for` (`Judge case` OF `fed`, `resign`, FALSE, 10, 10, 400000, FALSE, FALSE, FALSE, FALSE) EQUALS 400000
