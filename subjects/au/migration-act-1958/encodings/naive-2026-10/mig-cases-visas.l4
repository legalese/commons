#ASSERT `is an eligible non-citizen under s 72` TRUE FALSE FALSE
#ASSERT NOT `is an eligible non-citizen under s 72` FALSE FALSE FALSE

#ASSERT `the Minister may grant a bridging visa under s 73` TRUE TRUE
#ASSERT NOT `the Minister may grant a bridging visa under s 73` TRUE FALSE

§ `s 82(2), (2AA), (3) -- which visa ceases`

-- Student visa when the 820 arrives; 820 when the 801 arrives; bridging visa when the 820 arrives; student visa when a bridging visa arrives;
-- bridging visa when a special purpose visa arrives; a maritime crew visa when a substantive visa of an instrument-specified class arrives.
#ASSERT `the held visa ceases when the new visa comes into effect` `an ordinary substantive visa` `an ordinary substantive visa` FALSE
#ASSERT `the held visa ceases when the new visa comes into effect` `a bridging visa` `an ordinary substantive visa` FALSE
#ASSERT NOT `the held visa ceases when the new visa comes into effect` `an ordinary substantive visa` `a bridging visa` FALSE
#ASSERT NOT `the held visa ceases when the new visa comes into effect` `a bridging visa` `a special purpose visa` FALSE
#ASSERT NOT `the held visa ceases when the new visa comes into effect` `a maritime crew visa` `an ordinary substantive visa` TRUE

§ `ss 79, 81(2), 82(5), (6), (8) -- leaving and returning`

#ASSERT NOT `the visa ceases when the holder leaves` `Priya's London year on her new permanent visa`
#ASSERT `the visa ceases when the holder leaves` `Priya leaving after the re-entry period`
#ASSERT NOT `the visa ceases when the holder leaves` `Priya returning after the re-entry period`
#ASSERT `the visa ceases when the holder leaves` `a visa to remain but not re-enter, granted in Australia`

#ASSERT `the holder may re-enter on the visa` `Priya's London year on her new permanent visa`
#ASSERT NOT `the holder may re-enter on the visa` `Priya returning after the re-entry period`

-- Priya abroad when the re-entry period ends; back home before it ends.
#ASSERT `the visa ceases at the end of its entry period under s 82(5)` TRUE FALSE
#ASSERT NOT `the visa ceases at the end of its entry period under s 82(5)` TRUE TRUE

