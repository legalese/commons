#ASSERT (NOT (`ends fulfilled` (EVALTRACE (`s 347(3) -- I must apply to the ART in time` 14) 0 (LIST (WAITUNTIL 15), (EVENT `I, the applicant` `apply to the ART for review` 15)))))
