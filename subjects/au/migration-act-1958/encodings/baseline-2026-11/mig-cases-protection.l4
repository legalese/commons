#ASSERT `Am I an unauthorised maritime arrival question` (`arrival of` FALSE FALSE FALSE FALSE FALSE TRUE TRUE FALSE)
#ASSERT (NOT (`Am I an unauthorised maritime arrival question` (`arrival of` FALSE FALSE FALSE FALSE FALSE TRUE TRUE TRUE)))
#ASSERT (NOT (`Am I an unauthorised maritime arrival question` (`arrival of` FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE)))

