IMPORT prelude
IMPORT `fa-families-formulas`

-- A New Tax System (Family Assistance) Act 1999, Sch 1 cl 35B and Sch 2 cl 3(2) -- worked cases for fa-families-formulas.l4.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Expected values were worked by hand from the
-- sidecar formulas before running. Dollar figures are the ones printed in Compilation No. 124 (indexed): labelled examples.

§ `Sch 2 cl 3(2) -- the CCS taper`

-- $100,000 against the printed $80,000: 90 - 20,000 / 5,000 = 86, the figure fa-cases-families.l4
-- supplied as the taper result (it agrees).
#ASSERT `the CCS taper result` 100000 80000 EQUALS 86
#ASSERT `the applicable percentage with the taper computed` 100000 80000 EQUALS 86
-- $82,345: 90 - 0.469 = 89.531, to 2 places 89.53.
#ASSERT `the applicable percentage with the taper computed` 82345 80000 EQUALS 89.53
-- $300,000: 90 - 44 = 46.
#ASSERT `the applicable percentage with the taper computed` 300000 80000 EQUALS 46
-- The ends are unchanged: 90% at the lower threshold, 0% from $530,000.
#ASSERT `the applicable percentage with the taper computed` 80000 80000 EQUALS 90
#ASSERT `the applicable percentage with the taper computed` 530000 80000 EQUALS 0

§ `Sch 1 cl 35B -- the newborn supplement`

-- $1,501.50 x 365 / 91 = $6,022.50 a year for a first child (k054: Tahlia, for Ruby); $500.50 x 365 / 91 = $2,007.50 otherwise.
#ASSERT `the newborn supplement a year` TRUE 1501.50 500.50 EQUALS 6022.5
#ASSERT `the newborn supplement a year` FALSE 1501.50 500.50 EQUALS 2007.5
