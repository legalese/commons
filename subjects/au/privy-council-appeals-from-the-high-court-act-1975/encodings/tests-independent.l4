IMPORT prelude
IMPORT `pcah-rules`

-- Independent tests, from independent-expectations.md. Fields in order:
-- special leave open under the 1968 Act, proceeding began before this Act commenced.
-- JUST FALSE = barred; JUST TRUE = not barred; NOTHING = this Act does not decide.

-- 1 open under 1968 s 3, after commencement: barred
#ASSERT `may I still ask for special leave from` (`High Court decision` OF TRUE, FALSE) EQUALS JUST FALSE
-- 2 open under 1968, pre-commencement proceeding: saved
#ASSERT `may I still ask for special leave from` (`High Court decision` OF TRUE, TRUE) EQUALS JUST TRUE
-- 3 not open under 1968, after: not decided
#ASSERT `may I still ask for special leave from` (`High Court decision` OF FALSE, FALSE) EQUALS NOTHING
-- 4 not open under 1968, before: the proviso does not create a right
#ASSERT `may I still ask for special leave from` (`High Court decision` OF FALSE, TRUE) EQUALS NOTHING
-- 5 (composition by hand) HC on appeal from State SC non-federal, no federal law,
--   post-1968 proceeding => open under 1968; begun after 1975 commencement => barred
#ASSERT `may I still ask for special leave from` (`High Court decision` OF TRUE, FALSE) EQUALS JUST FALSE
-- 6 the answer for the saved case is never NOTHING
#ASSERT NOT (`may I still ask for special leave from` (`High Court decision` OF TRUE, TRUE) EQUALS NOTHING)
