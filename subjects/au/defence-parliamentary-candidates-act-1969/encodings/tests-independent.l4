IMPORT prelude
IMPORT daydate
IMPORT `dpc-rules`

-- Independent tests from the source text and BRIEF.md only (see
-- independent-expectations.md). Expected values were not adjusted to the code.

`officer` MEANS `an officer of the Permanent Navy, Regular Army or Permanent Air Force`
`enlisted` MEANS `an enlisted member of the Permanent Navy, Regular Army or Permanent Air Force`
`cfts` MEANS `a Reserve member on continuous full-time service`

GIVEN svc IS A `My service`
      satisfied IS A BOOLEAN
      left IS A BOOLEAN
      declared IS A MAYBE DATE
      elected IS A BOOLEAN
      applied IS A MAYBE DATE
      further IS A BOOLEAN
      notice IS A MAYBE DATE
      reinstated IS A BOOLEAN
      grat IS A NUMBER
GIVETH A `Candidate position`
`pos` svc satisfied left declared elected applied further notice reinstated grat MEANS
    `the candidate position for` (`Candidate case` OF svc, satisfied, left, declared, elected, applied, further, notice, reinstated, grat)

`dd` MEANS JUST (Date 15 3 2020)

-- Routes, ss 7-9
#ASSERT (`pos` `officer` TRUE FALSE NOTHING FALSE NOTHING FALSE NOTHING FALSE 0)'s `my route out` EQUALS `transfer to the appropriate Reserve (s 7)`
#ASSERT (`pos` `enlisted` TRUE FALSE NOTHING FALSE NOTHING FALSE NOTHING FALSE 0)'s `my route out` EQUALS `discharge (s 8)`
#ASSERT (`pos` `cfts` TRUE FALSE NOTHING FALSE NOTHING FALSE NOTHING FALSE 0)'s `my route out` EQUALS `termination of continuous full-time service (s 9)`
#ASSERT (`pos` `another member` TRUE FALSE NOTHING FALSE NOTHING FALSE NOTHING FALSE 0)'s `my route out` EQUALS `no route under this Act`
#ASSERT (`pos` `officer` FALSE FALSE NOTHING FALSE NOTHING FALSE NOTHING FALSE 0)'s `my route out` EQUALS `no route under this Act`

-- Deadline to apply, ss 10(1), 11(1), 12(1)
#ASSERT (`pos` `officer` TRUE TRUE `dd` FALSE NOTHING FALSE NOTHING FALSE 0)'s `the last day to apply for reinstatement` EQUALS JUST (Date 15 5 2020)
#ASSERT (`pos` `enlisted` TRUE TRUE (JUST (Date 31 12 2019)) FALSE NOTHING FALSE NOTHING FALSE 0)'s `the last day to apply for reinstatement` EQUALS JUST (Date 29 2 2020)
#ASSERT (`pos` `cfts` TRUE TRUE (JUST (Date 31 12 2020)) FALSE NOTHING FALSE NOTHING FALSE 0)'s `the last day to apply for reinstatement` EQUALS JUST (Date 28 2 2021)
#ASSERT (`pos` `officer` TRUE TRUE (JUST (Date 30 11 2020)) FALSE NOTHING FALSE NOTHING FALSE 0)'s `the last day to apply for reinstatement` EQUALS JUST (Date 30 1 2021)

-- In time? A1-A3
#ASSERT (`pos` `officer` TRUE TRUE `dd` FALSE (JUST (Date 15 5 2020)) FALSE NOTHING FALSE 0)'s `my application is in time` EQUALS JUST TRUE
#ASSERT (`pos` `officer` TRUE TRUE `dd` FALSE (JUST (Date 16 5 2020)) FALSE NOTHING FALSE 0)'s `my application is in time` EQUALS JUST FALSE
#ASSERT (`pos` `officer` TRUE TRUE `dd` FALSE (JUST (Date 1 7 2020)) TRUE NOTHING FALSE 0)'s `my application is in time` EQUALS JUST TRUE

-- Compulsory reinstatement, ss 13-14
-- N1: officer, notice on 15 April (last day of the month)
`n1` MEANS `pos` `officer` TRUE TRUE `dd` FALSE NOTHING FALSE (JUST (Date 15 4 2020)) FALSE 0
#ASSERT `n1`'s `the last day the Chief may serve notice requiring me to apply` EQUALS JUST (Date 15 4 2020)
#ASSERT `n1`'s `I am deemed to have applied on` EQUALS JUST (Date 15 5 2020)
#ASSERT `n1`'s `I am deemed re-enlisted that day` EQUALS FALSE
-- N2: officer, notice one day late
`n2` MEANS `pos` `officer` TRUE TRUE `dd` FALSE NOTHING FALSE (JUST (Date 16 4 2020)) FALSE 0
#ASSERT `n2`'s `I am deemed to have applied on` EQUALS NOTHING
-- N3: enlisted, notice in time
`n3` MEANS `pos` `enlisted` TRUE TRUE `dd` FALSE NOTHING FALSE (JUST (Date 1 4 2020)) FALSE 3000
#ASSERT `n3`'s `I am deemed to have applied on` EQUALS JUST (Date 15 5 2020)
#ASSERT `n3`'s `I am deemed re-enlisted that day` EQUALS TRUE
-- deemed re-enlistment is under s 11, so s 11(2) and s 17 follow
#ASSERT `n3`'s `the time away counts for long service leave` EQUALS TRUE
#ASSERT `n3`'s `the amount I must repay` EQUALS 3000
-- N4: enlisted, notice late
`n4` MEANS `pos` `enlisted` TRUE TRUE `dd` FALSE NOTHING FALSE (JUST (Date 16 4 2020)) FALSE 3000
#ASSERT `n4`'s `I am deemed to have applied on` EQUALS NOTHING
#ASSERT `n4`'s `I am deemed re-enlisted that day` EQUALS FALSE
#ASSERT `n4`'s `the amount I must repay` EQUALS 0
-- N5: CFTS member: no compulsory reinstatement
`n5` MEANS `pos` `cfts` TRUE TRUE `dd` FALSE NOTHING FALSE (JUST (Date 1 4 2020)) FALSE 0
#ASSERT `n5`'s `the last day the Chief may serve notice requiring me to apply` EQUALS NOTHING
#ASSERT `n5`'s `I am deemed to have applied on` EQUALS NOTHING
-- N6: enlisted, elected
`n6` MEANS `pos` `enlisted` TRUE TRUE `dd` TRUE NOTHING FALSE (JUST (Date 1 4 2020)) FALSE 3000
#ASSERT `n6`'s `I am deemed to have applied on` EQUALS NOTHING
#ASSERT `n6`'s `I am deemed re-enlisted that day` EQUALS FALSE
-- N7: officer, no notice
`n7` MEANS `pos` `officer` TRUE TRUE `dd` FALSE NOTHING FALSE NOTHING FALSE 0
#ASSERT `n7`'s `I am deemed to have applied on` EQUALS NOTHING
-- N8: enlisted applied himself on 10 May
`n8` MEANS `pos` `enlisted` TRUE TRUE `dd` FALSE (JUST (Date 10 5 2020)) FALSE (JUST (Date 1 4 2020)) FALSE 0
#ASSERT `n8`'s `I am deemed to have applied on` EQUALS NOTHING
#ASSERT `n8`'s `my application is in time` EQUALS JUST TRUE

-- Time away and gratuity, ss 10-12, 17
`g1` MEANS `pos` `officer` TRUE TRUE `dd` FALSE (JUST (Date 1 5 2020)) FALSE NOTHING TRUE 5000
#ASSERT `g1`'s `the time away counts for long service leave` EQUALS TRUE
#ASSERT `g1`'s `the amount I must repay` EQUALS 5000
`g2` MEANS `pos` `enlisted` TRUE TRUE `dd` FALSE (JUST (Date 1 5 2020)) FALSE NOTHING TRUE 3000
#ASSERT `g2`'s `the time away counts for long service leave` EQUALS TRUE
#ASSERT `g2`'s `the amount I must repay` EQUALS 3000
`g3` MEANS `pos` `cfts` TRUE TRUE `dd` FALSE (JUST (Date 1 5 2020)) FALSE NOTHING TRUE 2000
#ASSERT `g3`'s `the time away counts for long service leave` EQUALS TRUE
#ASSERT `g3`'s `the amount I must repay` EQUALS 2000
`g4` MEANS `pos` `officer` TRUE TRUE `dd` FALSE NOTHING FALSE NOTHING FALSE 5000
#ASSERT `g4`'s `the time away counts for long service leave` EQUALS FALSE
#ASSERT `g4`'s `the amount I must repay` EQUALS 0
