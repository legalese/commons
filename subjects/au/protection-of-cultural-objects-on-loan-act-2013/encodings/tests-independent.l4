IMPORT prelude
IMPORT daydate
IMPORT `pcol-rules`

-- Independent tests: expected values from independent-expectations.md.

GIVEN who IS A `Lender kind`
      tla IS A BOOLEAN
      mainly IS A BOOLEAN
      approved IS A BOOLEAN
      conn IS A BOOLEAN
      contra IS A BOOLEAN
      classA IS A BOOLEAN
      excl IS A BOOLEAN
      imp IS A DATE
      exp IS A MAYBE DATE
      decl IS A MAYBE DATE
      asked IS A DATE
      proc IS A `Proceeding`
      pow IS A `Power`
GIVETH A `Loan position`
`pos` who tla mainly approved conn contra classA excl imp exp decl asked proc pow MEANS
  `the loan position for` (`Loan case` OF who, tla, mainly, approved, conn, contra, classA, excl, imp, exp, decl, asked, proc, pow)

-- defaults with a varying power and proceeding
GIVEN proc IS A `Proceeding`
      pow IS A `Power`
GIVETH A `Loan position`
`std` proc pow MEANS
  `pos` `an individual not ordinarily resident in Australia` TRUE TRUE TRUE TRUE FALSE FALSE FALSE (Date 15 3 2024) NOTHING NOTHING (Date 1 1 2025) proc pow

-- defaults with a varying asked day, import day, export and declaration
GIVEN imp IS A DATE
      exp IS A MAYBE DATE
      decl IS A MAYBE DATE
      asked IS A DATE
GIVETH A BOOLEAN
`protected at` imp exp decl asked MEANS
  (`pos` `an individual not ordinarily resident in Australia` TRUE TRUE TRUE TRUE FALSE FALSE FALSE imp exp decl asked `none` `an ordinary statutory power`)'s `it is protected on the day asked about`

-- 1
#ASSERT (`std` `a claim against me personally about the object` `an ordinary statutory power`)'s `Part 2 applies to my object under s 8(1)` EQUALS TRUE
#ASSERT (`std` `a claim against me personally about the object` `an ordinary statutory power`)'s `the proceeding is barred by ss 9-10` EQUALS TRUE
#ASSERT (`std` `a claim against me personally about the object` `an ordinary statutory power`)'s `it can be seized despite s 11` EQUALS FALSE
#ASSERT (`std` `a claim against me personally about the object` `an ordinary statutory power`)'s `it can be forfeited despite s 12` EQUALS FALSE
-- 2-8
#ASSERT (`pos` `an individual not ordinarily resident in Australia` FALSE TRUE TRUE TRUE FALSE FALSE FALSE (Date 15 3 2024) NOTHING NOTHING (Date 1 1 2025) `none` `an ordinary statutory power`)'s `Part 2 applies to my object under s 8(1)` EQUALS FALSE
#ASSERT (`pos` `an individual not ordinarily resident in Australia` TRUE FALSE TRUE TRUE FALSE FALSE FALSE (Date 15 3 2024) NOTHING NOTHING (Date 1 1 2025) `none` `an ordinary statutory power`)'s `Part 2 applies to my object under s 8(1)` EQUALS FALSE
#ASSERT (`pos` `an individual not ordinarily resident in Australia` TRUE TRUE FALSE TRUE FALSE FALSE FALSE (Date 15 3 2024) NOTHING NOTHING (Date 1 1 2025) `none` `an ordinary statutory power`)'s `Part 2 applies to my object under s 8(1)` EQUALS FALSE
#ASSERT (`pos` `an individual not ordinarily resident in Australia` TRUE TRUE TRUE FALSE FALSE FALSE FALSE (Date 15 3 2024) NOTHING NOTHING (Date 1 1 2025) `none` `an ordinary statutory power`)'s `Part 2 applies to my object under s 8(1)` EQUALS FALSE
#ASSERT (`pos` `an individual not ordinarily resident in Australia` TRUE TRUE TRUE TRUE TRUE FALSE FALSE (Date 15 3 2024) NOTHING NOTHING (Date 1 1 2025) `none` `an ordinary statutory power`)'s `Part 2 applies to my object under s 8(1)` EQUALS FALSE
#ASSERT (`pos` `an individual not ordinarily resident in Australia` TRUE TRUE TRUE TRUE FALSE TRUE FALSE (Date 15 3 2024) NOTHING NOTHING (Date 1 1 2025) `none` `an ordinary statutory power`)'s `Part 2 applies to my object under s 8(1)` EQUALS FALSE
#ASSERT (`pos` `an individual not ordinarily resident in Australia` TRUE TRUE TRUE TRUE FALSE FALSE TRUE (Date 15 3 2024) NOTHING NOTHING (Date 1 1 2025) `none` `an ordinary statutory power`)'s `Part 2 applies to my object under s 8(1)` EQUALS FALSE
-- 9
#ASSERT (`pos` `another person` TRUE TRUE TRUE TRUE FALSE FALSE FALSE (Date 15 3 2024) NOTHING NOTHING (Date 1 1 2025) `a claim against me personally about the object` `an ordinary statutory power`)'s `Part 2 applies to my object under s 8(1)` EQUALS FALSE
#ASSERT (`pos` `another person` TRUE TRUE TRUE TRUE FALSE FALSE FALSE (Date 15 3 2024) NOTHING NOTHING (Date 1 1 2025) `a claim against me personally about the object` `an ordinary statutory power`)'s `the proceeding is barred by ss 9-10` EQUALS FALSE
-- 10
#ASSERT (`pos` `a corporation incorporated under a foreign law` TRUE TRUE TRUE TRUE FALSE FALSE FALSE (Date 15 3 2024) NOTHING NOTHING (Date 1 1 2025) `none` `an ordinary statutory power`)'s `Part 2 applies to my object under s 8(1)` EQUALS TRUE
#ASSERT (`pos` `a body politic of a foreign country or part of one` TRUE TRUE TRUE TRUE FALSE FALSE FALSE (Date 15 3 2024) NOTHING NOTHING (Date 1 1 2025) `none` `an ordinary statutory power`)'s `Part 2 applies to my object under s 8(1)` EQUALS TRUE
-- 11
#ASSERT `protected at` (Date 15 3 2024) NOTHING NOTHING (Date 14 3 2026) EQUALS TRUE
#ASSERT `protected at` (Date 15 3 2024) NOTHING NOTHING (Date 15 3 2026) EQUALS FALSE
-- 12
#ASSERT `protected at` (Date 29 2 2024) NOTHING NOTHING (Date 28 2 2026) EQUALS TRUE
#ASSERT `protected at` (Date 29 2 2024) NOTHING NOTHING (Date 1 3 2026) EQUALS FALSE
-- 13
#ASSERT `protected at` (Date 15 3 2024) (JUST (Date 1 6 2025)) NOTHING (Date 31 5 2025) EQUALS TRUE
#ASSERT `protected at` (Date 15 3 2024) (JUST (Date 1 6 2025)) NOTHING (Date 2 6 2025) EQUALS FALSE
-- 14
#ASSERT `protected at` (Date 15 3 2024) NOTHING (JUST (Date 30 6 2026)) (Date 1 6 2026) EQUALS TRUE
#ASSERT `protected at` (Date 15 3 2024) NOTHING (JUST (Date 30 6 2026)) (Date 1 7 2026) EQUALS FALSE
-- 15
#ASSERT `protected at` (Date 15 3 2024) NOTHING (JUST (Date 1 1 2026)) (Date 1 2 2026) EQUALS TRUE
#ASSERT `protected at` (Date 15 3 2024) NOTHING (JUST (Date 1 1 2026)) (Date 15 3 2026) EQUALS FALSE
-- 16
#ASSERT `protected at` (Date 15 3 2024) NOTHING NOTHING (Date 14 3 2024) EQUALS FALSE
-- 17, 18
#ASSERT (`std` `a claim against the object itself` `an ordinary statutory power`)'s `the proceeding is barred by ss 9-10` EQUALS TRUE
#ASSERT (`std` `proceedings under the Proceeds of Crime Act 2002 or prescribed` `an ordinary statutory power`)'s `the proceeding is barred by ss 9-10` EQUALS FALSE
-- 19
#ASSERT (`std` `none` `Part IAA of the Crimes Act 1914`)'s `it can be seized despite s 11` EQUALS TRUE
#ASSERT (`std` `none` `Part IAA of the Crimes Act 1914`)'s `it can be forfeited despite s 12` EQUALS TRUE
-- 20
#ASSERT (`std` `none` `the Proceeds of Crime Act 2002`)'s `it can be seized despite s 11` EQUALS TRUE
#ASSERT (`std` `none` `the Proceeds of Crime Act 2002`)'s `it can be forfeited despite s 12` EQUALS TRUE
-- 21
#ASSERT (`std` `none` `a seizure power given only to police`)'s `it can be seized despite s 11` EQUALS TRUE
#ASSERT (`std` `none` `a seizure power given only to police`)'s `it can be forfeited despite s 12` EQUALS FALSE
-- 22
#ASSERT (`std` `none` `a prescribed law`)'s `it can be seized despite s 11` EQUALS TRUE
#ASSERT (`std` `none` `a prescribed law`)'s `it can be forfeited despite s 12` EQUALS TRUE
-- 23
#ASSERT (`std` `none` `an ordinary statutory power`)'s `protection ends on` EQUALS JUST (Date 14 3 2026)
