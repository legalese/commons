IMPORT prelude
IMPORT `sisr-dates`
IMPORT `sisr-claimant`

-- Superannuation Industry (Supervision) Regulations 1994 (Cth) -- cases for the claimant's seat (sisr-claimant.l4).
-- Every expected value was worked by hand from the deposited text (F2026C00541), regulation by regulation, before the
-- encoding was run. "N days after" a day excludes that day. 2 November 2026 is a Monday.
-- HYPOTHETICAL facts throughout. BASELINE ENCODING. Not for public use as advice.

GIVEN d IS A NUMBER, m IS A NUMBER, y IS A NUMBER
GIVETH A DATE
`on` d m y MEANS `the calendar date` d m y

GIVEN a IS A DATE, b IS A DATE
GIVETH A BOOLEAN
DECIDE `same day` a b IF DATE_SERIAL a EQUALS DATE_SERIAL b

GIVEN a IS A MAYBE DATE, b IS A DATE
GIVETH A BOOLEAN
`is just` a b MEANS
    CONSIDER a
    WHEN JUST x THEN DATE_SERIAL x EQUALS DATE_SERIAL b
    WHEN NOTHING THEN FALSE

GIVEN a IS A MAYBE DATE
GIVETH A BOOLEAN
`is nothing` a MEANS
    CONSIDER a
    WHEN JUST x THEN FALSE
    WHEN NOTHING THEN TRUE

-- The date helpers. 2 November 2026 is a Monday; 7 and 8 November are a Saturday and a Sunday.
#ASSERT `is a business day` (`on` 2 11 2026)
#ASSERT `is a business day` (`on` 6 11 2026)
#ASSERT (NOT (`is a business day` (`on` 7 11 2026)))
#ASSERT (NOT (`is a business day` (`on` 8 11 2026)))
#ASSERT `same day` (`the same day` 12 `months after` (`on` 29 2 2024)) (`on` 28 2 2025)
#ASSERT `same day` (`the same day` 24 `months after` (`on` 31 12 2025)) (`on` 31 12 2027)
#ASSERT `same day` (`the same day` 1 `months after` (`on` 31 1 2026)) (`on` 28 2 2026)

-- reg 6.01(2) preservation age: born 30 June 1960 -> 55; 1 July 1960 -> 56; 30 June 1964 -> 59; 1 July 1964 -> 60.
#ASSERT `the preservation age of a person born on` (`on` 30 6 1960) EQUALS 55
#ASSERT `the preservation age of a person born on` (`on` 1 7 1960) EQUALS 56
#ASSERT `the preservation age of a person born on` (`on` 1 1 1962) EQUALS 57
#ASSERT `the preservation age of a person born on` (`on` 30 6 1964) EQUALS 59
#ASSERT `the preservation age of a person born on` (`on` 1 7 1964) EQUALS 60

-- reg 6.01(5)(b): preservation age plus 39 weeks (273 days). Born 15 August 1966: 60 on 15 August 2026; + 273 days is
-- 15 May 2027 (16 to 31 August, then 30+31+30+31+31+28+31+30 to 30 April = 258, + 15). Born 1 January 1961: 56 on
-- 1 January 2017; + 273 days is 1 October 2017.
#ASSERT `same day` (`On what day do I reach my preservation age plus 39 weeks` (`on` 15 8 1966)) (`on` 15 5 2027)
#ASSERT `same day` (`On what day do I reach my preservation age plus 39 weeks` (`on` 1 1 1961)) (`on` 1 10 2017)

-- reg 6.01(5)(a), (5A): 26 weeks, receiving, evidence of 1 October 2026, application 22 October 2026 (21 days) -> yes.
#ASSERT `Am I in severe financial hardship on the 26-week ground` 26 TRUE TRUE (`on` 1 10 2026) (`on` 22 10 2026) TRUE
-- Application on 23 October 2026: the evidence is 22 days old, of no effect -> no.
#ASSERT (NOT (`Am I in severe financial hardship on the 26-week ground` 26 TRUE TRUE (`on` 1 10 2026) (`on` 23 10 2026) TRUE))
-- 25 weeks -> no.
#ASSERT (NOT (`Am I in severe financial hardship on the 26-week ground` 25 TRUE TRUE (`on` 1 10 2026) (`on` 22 10 2026) TRUE))
-- No longer receiving on the date of the evidence -> no.
#ASSERT (NOT (`Am I in severe financial hardship on the 26-week ground` 30 FALSE TRUE (`on` 1 10 2026) (`on` 22 10 2026) TRUE))
-- The trustee is not satisfied about family living expenses -> no.
#ASSERT (NOT (`Am I in severe financial hardship on the 26-week ground` 30 TRUE TRUE (`on` 1 10 2026) (`on` 22 10 2026) FALSE))
-- No written evidence from an agency -> no.
#ASSERT (NOT (`Am I in severe financial hardship on the 26-week ground` 30 TRUE FALSE (`on` 1 10 2026) (`on` 22 10 2026) TRUE))
-- Evidence dated after the application (25 October for a 22 October application) is not "more than 21 days before" -> yes.
#ASSERT `Am I in severe financial hardship on the 26-week ground` 26 TRUE TRUE (`on` 25 10 2026) (`on` 22 10 2026) TRUE

-- reg 6.01(5)(b): born 15 August 1966. Application on 14 May 2027 -> no (a day short); on 15 May 2027 -> yes.
#ASSERT (NOT (`Am I in severe financial hardship on the preservation-age ground` (`on` 15 8 1966) (`on` 14 5 2027) 39 TRUE FALSE))
#ASSERT `Am I in severe financial hardship on the preservation-age ground` (`on` 15 8 1966) (`on` 15 5 2027) 39 TRUE FALSE
-- 38 weeks -> no; working part-time on the application date -> no.
#ASSERT (NOT (`Am I in severe financial hardship on the preservation-age ground` (`on` 15 8 1966) (`on` 1 6 2027) 38 TRUE FALSE))
#ASSERT (NOT (`Am I in severe financial hardship on the preservation-age ground` (`on` 15 8 1966) (`on` 1 6 2027) 52 TRUE TRUE))

-- Item 105: the 26-week ground, balance $25,000, no earlier payment -> $10,000; balance $6,000 -> $6,000.
#ASSERT `What is the most my fund may pay me now for severe financial hardship` `the 26-week income support ground (reg 6.01(5)(a))` 25000 FALSE (`on` 1 1 2000) (`on` 1 11 2026) EQUALS 10000
#ASSERT `What is the most my fund may pay me now for severe financial hardship` `the 26-week income support ground (reg 6.01(5)(a))` 6000 FALSE (`on` 1 1 2000) (`on` 1 11 2026) EQUALS 6000
-- Paid on 1 March 2026: on 28 February 2027 the 12-month period has not ended -> $0; on 1 March 2027 -> $10,000.
#ASSERT `What is the most my fund may pay me now for severe financial hardship` `the 26-week income support ground (reg 6.01(5)(a))` 25000 TRUE (`on` 1 3 2026) (`on` 28 2 2027) EQUALS 0
#ASSERT `What is the most my fund may pay me now for severe financial hardship` `the 26-week income support ground (reg 6.01(5)(a))` 25000 TRUE (`on` 1 3 2026) (`on` 1 3 2027) EQUALS 10000
-- Paid on 29 February 2024: the next period begins on 28 February 2025 (no 29 February that year).
#ASSERT `What is the most my fund may pay me now for severe financial hardship` `the 26-week income support ground (reg 6.01(5)(a))` 25000 TRUE (`on` 29 2 2024) (`on` 27 2 2025) EQUALS 0
#ASSERT `What is the most my fund may pay me now for severe financial hardship` `the 26-week income support ground (reg 6.01(5)(a))` 25000 TRUE (`on` 29 2 2024) (`on` 28 2 2025) EQUALS 10000
-- The preservation-age ground: Nil restriction, the whole balance (reg 6.18(2)).
#ASSERT `What is the most my fund may pay me now for severe financial hardship` `the preservation-age ground (reg 6.01(5)(b))` 250000 TRUE (`on` 1 3 2026) (`on` 2 3 2026) EQUALS 250000

-- Item 105 for one lump sum, 26-week ground, balance $25,000: $10,000 yes; $10,000.01 no; $1,000 yes; $999 no.
#ASSERT `May my fund pay me this lump sum for severe financial hardship` `the 26-week income support ground (reg 6.01(5)(a))` 10000 25000 FALSE (`on` 1 1 2000) (`on` 1 11 2026) EQUALS JUST TRUE
#ASSERT `May my fund pay me this lump sum for severe financial hardship` `the 26-week income support ground (reg 6.01(5)(a))` 10000.01 25000 FALSE (`on` 1 1 2000) (`on` 1 11 2026) EQUALS JUST FALSE
#ASSERT `May my fund pay me this lump sum for severe financial hardship` `the 26-week income support ground (reg 6.01(5)(a))` 1000 25000 FALSE (`on` 1 1 2000) (`on` 1 11 2026) EQUALS JUST TRUE
#ASSERT `May my fund pay me this lump sum for severe financial hardship` `the 26-week income support ground (reg 6.01(5)(a))` 999 25000 FALSE (`on` 1 1 2000) (`on` 1 11 2026) EQUALS JUST FALSE
-- Balance $800 (below $1,000, so no floor): $800 yes; $500 yes (fork register); $900 no (more than the balance).
#ASSERT `May my fund pay me this lump sum for severe financial hardship` `the 26-week income support ground (reg 6.01(5)(a))` 800 800 FALSE (`on` 1 1 2000) (`on` 1 11 2026) EQUALS JUST TRUE
#ASSERT `May my fund pay me this lump sum for severe financial hardship` `the 26-week income support ground (reg 6.01(5)(a))` 500 800 FALSE (`on` 1 1 2000) (`on` 1 11 2026) EQUALS JUST TRUE
#ASSERT `May my fund pay me this lump sum for severe financial hardship` `the 26-week income support ground (reg 6.01(5)(a))` 900 800 FALSE (`on` 1 1 2000) (`on` 1 11 2026) EQUALS JUST FALSE
-- A second payment within the same 12-month period -> no.
#ASSERT `May my fund pay me this lump sum for severe financial hardship` `the 26-week income support ground (reg 6.01(5)(a))` 2000 25000 TRUE (`on` 1 3 2026) (`on` 1 11 2026) EQUALS JUST FALSE
-- The preservation-age ground: the whole balance yes; a dollar more no.
#ASSERT `May my fund pay me this lump sum for severe financial hardship` `the preservation-age ground (reg 6.01(5)(b))` 250000 250000 TRUE (`on` 1 3 2026) (`on` 2 3 2026) EQUALS JUST TRUE
#ASSERT `May my fund pay me this lump sum for severe financial hardship` `the preservation-age ground (reg 6.01(5)(b))` 250001 250000 TRUE (`on` 1 3 2026) (`on` 2 3 2026) EQUALS JUST FALSE

-- reg 6.01A: a joint certificate of 10 January 2026, death likely by 10 January 2028 (exactly 24 months).
#ASSERT `Do I have a terminal medical condition on this day` TRUE TRUE TRUE (`on` 10 1 2026) (`on` 10 1 2028) (`on` 1 1 2000) (`on` 1 1 2000) (`on` 10 1 2026)
#ASSERT `Do I have a terminal medical condition on this day` TRUE TRUE TRUE (`on` 10 1 2026) (`on` 10 1 2028) (`on` 1 1 2000) (`on` 1 1 2000) (`on` 10 1 2028)
-- The day after the certification period ends -> no; the day before the certificate -> no.
#ASSERT (NOT (`Do I have a terminal medical condition on this day` TRUE TRUE TRUE (`on` 10 1 2026) (`on` 10 1 2028) (`on` 1 1 2000) (`on` 1 1 2000) (`on` 11 1 2028)))
#ASSERT (NOT (`Do I have a terminal medical condition on this day` TRUE TRUE TRUE (`on` 10 1 2026) (`on` 10 1 2028) (`on` 1 1 2000) (`on` 1 1 2000) (`on` 9 1 2026)))
-- A certification period ending 11 January 2028, one day more than 24 months -> no condition at all.
#ASSERT (NOT (`Do I have a terminal medical condition on this day` TRUE TRUE TRUE (`on` 10 1 2026) (`on` 11 1 2028) (`on` 1 1 2000) (`on` 1 1 2000) (`on` 1 6 2026)))
-- Neither doctor a specialist in a related area -> no.
#ASSERT (NOT (`Do I have a terminal medical condition on this day` TRUE FALSE TRUE (`on` 10 1 2026) (`on` 10 1 2028) (`on` 1 1 2000) (`on` 1 1 2000) (`on` 1 6 2026)))
-- Separate certificates: 10 January 2026 (to 30 June 2027) and 20 February 2026 (to 31 December 2027).
-- 15 February 2026: only one doctor has certified -> no. 20 February 2026 -> yes. 1 July 2027: the first period has
-- ended -> no.
#ASSERT (NOT (`Do I have a terminal medical condition on this day` TRUE TRUE FALSE (`on` 10 1 2026) (`on` 30 6 2027) (`on` 20 2 2026) (`on` 31 12 2027) (`on` 15 2 2026)))
#ASSERT `Do I have a terminal medical condition on this day` TRUE TRUE FALSE (`on` 10 1 2026) (`on` 30 6 2027) (`on` 20 2 2026) (`on` 31 12 2027) (`on` 20 2 2026)
#ASSERT (NOT (`Do I have a terminal medical condition on this day` TRUE TRUE FALSE (`on` 10 1 2026) (`on` 30 6 2027) (`on` 20 2 2026) (`on` 31 12 2027) (`on` 1 7 2027)))
-- The second certificate's period ending 21 February 2028 (24 months after 20 February 2026 is 20 February 2028) -> no.
#ASSERT (NOT (`Do I have a terminal medical condition on this day` TRUE TRUE FALSE (`on` 10 1 2026) (`on` 30 6 2027) (`on` 20 2 2026) (`on` 21 2 2028) (`on` 1 3 2026)))
-- A certificate of 29 February 2024: 24 months later is 28 February 2026; a period to that day is in time, to 1 March is not.
#ASSERT `Do I have a terminal medical condition on this day` TRUE TRUE TRUE (`on` 29 2 2024) (`on` 28 2 2026) (`on` 1 1 2000) (`on` 1 1 2000) (`on` 1 3 2024)
#ASSERT (NOT (`Do I have a terminal medical condition on this day` TRUE TRUE TRUE (`on` 29 2 2024) (`on` 1 3 2026) (`on` 1 1 2000) (`on` 1 1 2000) (`on` 1 3 2024)))
-- How long it lasts: joint -> 10 January 2028; separate -> the earlier end, 30 June 2027; out of time -> NOTHING.
#ASSERT `is just` (`Until what day does my terminal medical condition last` TRUE TRUE TRUE (`on` 10 1 2026) (`on` 10 1 2028) (`on` 1 1 2000) (`on` 1 1 2000)) (`on` 10 1 2028)
#ASSERT `is just` (`Until what day does my terminal medical condition last` TRUE TRUE FALSE (`on` 10 1 2026) (`on` 30 6 2027) (`on` 20 2 2026) (`on` 31 12 2027)) (`on` 30 6 2027)
#ASSERT `is nothing` (`Until what day does my terminal medical condition last` TRUE TRUE TRUE (`on` 10 1 2026) (`on` 11 1 2028) (`on` 1 1 2000) (`on` 1 1 2000))

-- reg 6.19A: medical treatment with both certificates, the Regulator satisfied on (2)(a) and (b) -> must determine.
#ASSERT `Must the Regulator release my super on this compassionate ground` `medical treatment for me or a dependant (reg 6.19A(1)(a))` TRUE TRUE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
-- No certificate that the treatment is not readily available publicly -> (3) bars it.
#ASSERT `Must the Regulator release my super on this compassionate ground` `medical treatment for me or a dependant (reg 6.19A(1)(a))` TRUE FALSE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
-- Medical transport without certified treatment -> (4) bars it.
#ASSERT `Must the Regulator release my super on this compassionate ground` `medical transport for me or a dependant (reg 6.19A(1)(a))` FALSE FALSE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
-- The Regulator not satisfied that I lack the financial capacity -> no.
#ASSERT `Must the Regulator release my super on this compassionate ground` `medical treatment for me or a dependant (reg 6.19A(1)(a))` TRUE TRUE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
-- The mortgage ground with the mortgagee's statement and its figures -> yes; the statement without the figures -> no (fork).
#ASSERT `Must the Regulator release my super on this compassionate ground` `a loan payment to stop the mortgagee foreclosing on or selling my home (reg 6.19A(1)(b))` FALSE FALSE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Must the Regulator release my super on this compassionate ground` `a loan payment to stop the mortgagee foreclosing on or selling my home (reg 6.19A(1)(b))` FALSE FALSE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Must the Regulator release my super on this compassionate ground` `a loan payment to stop the mortgagee foreclosing on or selling my home (reg 6.19A(1)(b))` FALSE FALSE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
-- Palliative care needs no certificate under (3)-(5) -> yes if the Regulator is satisfied.
#ASSERT `Must the Regulator release my super on this compassionate ground` `my palliative care (reg 6.19A(1)(d))` FALSE FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE

-- Item 107: mortgage, determined $20,000, 3 months' repayments $7,500, 12 months' interest $9,000 -> cap $16,500.
#ASSERT `What is the most my fund may pay me on the compassionate-ground determination` `a loan payment to stop the mortgagee foreclosing on or selling my home (reg 6.19A(1)(b))` 20000 7500 9000 0 EQUALS 16500
#ASSERT `What is the most my fund may pay me on the compassionate-ground determination` `a loan payment to stop the mortgagee foreclosing on or selling my home (reg 6.19A(1)(b))` 12000 7500 9000 0 EQUALS 12000
-- $10,000 already paid in the period -> $6,500 left; $20,000 already paid -> nothing left.
#ASSERT `What is the most my fund may pay me on the compassionate-ground determination` `a loan payment to stop the mortgagee foreclosing on or selling my home (reg 6.19A(1)(b))` 20000 7500 9000 10000 EQUALS 6500
#ASSERT `What is the most my fund may pay me on the compassionate-ground determination` `a loan payment to stop the mortgagee foreclosing on or selling my home (reg 6.19A(1)(b))` 20000 7500 9000 20000 EQUALS 0
-- Medical treatment: the determined amount.
#ASSERT `What is the most my fund may pay me on the compassionate-ground determination` `medical treatment for me or a dependant (reg 6.19A(1)(a))` 35000 0 0 0 EQUALS 35000

-- Items 104, 111: $199.99 on leaving a sponsor's job on 1 July 1997 -> yes; on 30 June 1997 -> no; $200 -> no.
#ASSERT `Can I take my preserved super in full because the balance is under 200 dollars` `I left a job with a standard employer-sponsor of the fund (item 104)` 199.99 (`on` 1 7 1997)
#ASSERT (NOT (`Can I take my preserved super in full because the balance is under 200 dollars` `I left a job with a standard employer-sponsor of the fund (item 104)` 199.99 (`on` 30 6 1997)))
#ASSERT (NOT (`Can I take my preserved super in full because the balance is under 200 dollars` `I left a job with a standard employer-sponsor of the fund (item 104)` 200 (`on` 1 7 2026)))
#ASSERT `Can I take my preserved super in full because the balance is under 200 dollars` `I was a lost member and have been found (item 111)` 150 (`on` 1 1 2000)

-- reg 6.01B(1), (2).
#ASSERT `Am I limited to the temporary residents' conditions of release` TRUE FALSE FALSE
#ASSERT (NOT (`Am I limited to the temporary residents' conditions of release` TRUE TRUE FALSE))
#ASSERT (NOT (`Am I limited to the temporary residents' conditions of release` TRUE FALSE TRUE))
#ASSERT (NOT (`Am I limited to the temporary residents' conditions of release` FALSE FALSE FALSE))
-- reg 6.01B(3): a temporary resident cannot use severe financial hardship (105), the reg 6.19A compassionate ground (107)
-- or age 65 (106); can use a terminal medical condition (102A), temporary incapacity (109) or the coronavirus ground (107A).
#ASSERT `Does the temporary residents' rule stop me meeting this condition of release` TRUE FALSE FALSE `severe financial hardship (item 105)` FALSE
#ASSERT `Does the temporary residents' rule stop me meeting this condition of release` TRUE FALSE FALSE `the Regulator's compassionate-ground determination (item 107)` FALSE
#ASSERT `Does the temporary residents' rule stop me meeting this condition of release` TRUE FALSE FALSE `attaining age 65 (item 106)` FALSE
#ASSERT (NOT (`Does the temporary residents' rule stop me meeting this condition of release` TRUE FALSE FALSE `terminal medical condition (item 102A)` FALSE))
#ASSERT (NOT (`Does the temporary residents' rule stop me meeting this condition of release` TRUE FALSE FALSE `temporary incapacity (item 109)` FALSE))
#ASSERT (NOT (`Does the temporary residents' rule stop me meeting this condition of release` TRUE FALSE FALSE `the Regulator's coronavirus compassionate-ground determination (item 107A)` FALSE))
-- Met before 1 April 2009 -> not stopped; a permanent resident -> not stopped.
#ASSERT (NOT (`Does the temporary residents' rule stop me meeting this condition of release` TRUE FALSE FALSE `severe financial hardship (item 105)` TRUE))
#ASSERT (NOT (`Does the temporary residents' rule stop me meeting this condition of release` TRUE TRUE FALSE `retirement (item 101)` FALSE))

-- reg 6.20A: left Australia, visa ceased, not a citizen or permanent resident, asked; $4,999 with copies -> must pay.
#ASSERT `Must my fund pay out my super now that I have left Australia` TRUE FALSE TRUE TRUE TRUE 4999 TRUE FALSE FALSE EQUALS `my fund must pay me my withdrawal benefit as a lump sum within 28 days after my request was lodged (reg 6.20A)`
-- $5,000 with copies only: (2) is for less than $5,000, so (3) is needed -> not on these facts.
#ASSERT `Must my fund pay out my super now that I have left Australia` TRUE FALSE TRUE TRUE TRUE 5000 TRUE FALSE FALSE EQUALS `reg 6.20A and reg 6.20B do not require or allow payment on these facts`
-- $5,000 with the Immigration Department's statement -> must pay.
#ASSERT `Must my fund pay out my super now that I have left Australia` TRUE FALSE TRUE TRUE TRUE 5000 FALSE TRUE FALSE EQUALS `my fund must pay me my withdrawal benefit as a lump sum within 28 days after my request was lodged (reg 6.20A)`
-- An unfunded public sector scheme -> may pay (reg 6.20B).
#ASSERT `Must my fund pay out my super now that I have left Australia` TRUE FALSE TRUE TRUE TRUE 5000 FALSE TRUE TRUE EQUALS `my fund may pay me, but need not, because it is an unfunded public sector scheme (reg 6.20B)`
-- Still in Australia; visa not ceased; a permanent resident; no request -> not on these facts.
#ASSERT `Must my fund pay out my super now that I have left Australia` TRUE FALSE FALSE TRUE TRUE 4999 TRUE TRUE FALSE EQUALS `reg 6.20A and reg 6.20B do not require or allow payment on these facts`
#ASSERT `Must my fund pay out my super now that I have left Australia` TRUE FALSE TRUE FALSE TRUE 4999 TRUE TRUE FALSE EQUALS `reg 6.20A and reg 6.20B do not require or allow payment on these facts`
#ASSERT `Must my fund pay out my super now that I have left Australia` TRUE TRUE TRUE TRUE TRUE 4999 TRUE TRUE FALSE EQUALS `reg 6.20A and reg 6.20B do not require or allow payment on these facts`
#ASSERT `Must my fund pay out my super now that I have left Australia` TRUE FALSE TRUE TRUE FALSE 4999 TRUE TRUE FALSE EQUALS `reg 6.20A and reg 6.20B do not require or allow payment on these facts`

-- reg 6.20A(5)(b): lodged 3 November 2026 -> by 1 December 2026 (3 + 28 = 31 November, which is 1 December).
#ASSERT `same day` (`By when must my fund pay my departing super` (`on` 3 11 2026)) (`on` 1 12 2026)
#ASSERT `Has my fund paid my departing super in time` (`on` 3 11 2026) TRUE (`on` 1 12 2026) (`on` 5 12 2026) EQUALS `made in time`
#ASSERT `Has my fund paid my departing super in time` (`on` 3 11 2026) TRUE (`on` 3 11 2026) (`on` 5 12 2026) EQUALS `made in time`
#ASSERT `Has my fund paid my departing super in time` (`on` 3 11 2026) TRUE (`on` 2 12 2026) (`on` 5 12 2026) EQUALS `late: not made by the last day the regulation allows`
#ASSERT `Has my fund paid my departing super in time` (`on` 3 11 2026) FALSE (`on` 1 1 2000) (`on` 1 12 2026) EQUALS `not yet made, and not yet late`
#ASSERT `Has my fund paid my departing super in time` (`on` 3 11 2026) FALSE (`on` 1 1 2000) (`on` 2 12 2026) EQUALS `late: not made by the last day the regulation allows`

-- reg 6.34A(2): a request received on Monday 2 November 2026 -> by Thursday 5 November; on Thursday 5 November -> by
-- Tuesday 10 November (Friday 6, Monday 9, Tuesday 10); on Saturday 7 November -> by Wednesday 11 November.
#ASSERT `is just` (`By when must my old fund roll over my super` (`on` 2 11 2026) FALSE (`on` 1 1 2000) TRUE FALSE FALSE) (`on` 5 11 2026)
#ASSERT `is just` (`By when must my old fund roll over my super` (`on` 5 11 2026) FALSE (`on` 1 1 2000) TRUE FALSE FALSE) (`on` 10 11 2026)
#ASSERT `is just` (`By when must my old fund roll over my super` (`on` 7 11 2026) FALSE (`on` 1 1 2000) TRUE FALSE FALSE) (`on` 11 11 2026)
-- Further information asked for and received on Friday 6 November -> counted from then: by Wednesday 11 November.
#ASSERT `is just` (`By when must my old fund roll over my super` (`on` 2 11 2026) TRUE (`on` 6 11 2026) TRUE FALSE FALSE) (`on` 11 11 2026)
-- Christmas 2026: a request on Thursday 24 December -> Friday 25, Monday 28, Tuesday 29 December. Public holidays are not
-- skipped (fork register); skipping them would give 31 December.
#ASSERT `is just` (`By when must my old fund roll over my super` (`on` 24 12 2026) FALSE (`on` 1 1 2000) TRUE FALSE FALSE) (`on` 29 12 2026)
-- reg 6.34A(3): the new fund cannot receive under the standards -> 30 days, 2 December 2026.
#ASSERT `is just` (`By when must my old fund roll over my super` (`on` 2 11 2026) FALSE (`on` 1 1 2000) FALSE FALSE FALSE) (`on` 2 12 2026)
-- reg 6.34A(4)(b): an investment choice -> the outer 30 days, 2 December 2026.
#ASSERT `is just` (`By when must my old fund roll over my super` (`on` 2 11 2026) FALSE (`on` 1 1 2000) TRUE TRUE FALSE) (`on` 2 12 2026)
-- reg 6.34A(6): consent to a longer period for an illiquid investment -> no last day.
#ASSERT `is nothing` (`By when must my old fund roll over my super` (`on` 2 11 2026) FALSE (`on` 1 1 2000) TRUE TRUE TRUE)
-- In time or late: request Thursday 5 November, last day Tuesday 10 November.
#ASSERT `Has my old fund rolled over my super in time` (`on` 5 11 2026) FALSE (`on` 1 1 2000) TRUE FALSE FALSE TRUE (`on` 10 11 2026) (`on` 20 11 2026) EQUALS `made in time`
#ASSERT `Has my old fund rolled over my super in time` (`on` 5 11 2026) FALSE (`on` 1 1 2000) TRUE FALSE FALSE TRUE (`on` 11 11 2026) (`on` 20 11 2026) EQUALS `late: not made by the last day the regulation allows`
#ASSERT `Has my old fund rolled over my super in time` (`on` 5 11 2026) FALSE (`on` 1 1 2000) TRUE FALSE FALSE FALSE (`on` 1 1 2000) (`on` 10 11 2026) EQUALS `not yet made, and not yet late`
#ASSERT `Has my old fund rolled over my super in time` (`on` 5 11 2026) FALSE (`on` 1 1 2000) TRUE FALSE FALSE FALSE (`on` 1 1 2000) (`on` 11 11 2026) EQUALS `late: not made by the last day the regulation allows`
#ASSERT `Has my old fund rolled over my super in time` (`on` 5 11 2026) FALSE (`on` 1 1 2000) TRUE TRUE TRUE TRUE (`on` 1 3 2027) (`on` 1 3 2027) EQUALS `the regulation sets no last day on these facts`

-- reg 6.21(2C): all four limbs -> yes; no need for ongoing support services -> no.
#ASSERT `Do I have a reg 6.21(2C) disability` TRUE TRUE TRUE TRUE
#ASSERT (NOT (`Do I have a reg 6.21(2C) disability` TRUE TRUE TRUE FALSE))
-- reg 6.21(2B): born 10 March 2005, no earlier end -> the 25th birthday, 10 March 2030.
#ASSERT `is just` (`On what day must my death benefit pension be paid out as a lump sum` (`on` 10 3 2005) FALSE (`on` 1 1 2000) FALSE) (`on` 10 3 2030)
-- The pension commuted on 1 July 2028 -> 1 July 2028; ending on 1 July 2031 -> still 10 March 2030.
#ASSERT `is just` (`On what day must my death benefit pension be paid out as a lump sum` (`on` 10 3 2005) TRUE (`on` 1 7 2028) FALSE) (`on` 1 7 2028)
#ASSERT `is just` (`On what day must my death benefit pension be paid out as a lump sum` (`on` 10 3 2005) TRUE (`on` 1 7 2031) FALSE) (`on` 10 3 2030)
-- A (2C) disability on that day -> no compulsory day.
#ASSERT `is nothing` (`On what day must my death benefit pension be paid out as a lump sum` (`on` 10 3 2005) FALSE (`on` 1 1 2000) TRUE)
-- Born 29 February 2004: 25 in 2029, a common year -> taken as 1 March 2029 (fork register).
#ASSERT `is just` (`On what day must my death benefit pension be paid out as a lump sum` (`on` 29 2 2004) FALSE (`on` 1 1 2000) FALSE) (`on` 1 3 2029)

-- The two regulative rules, traced: reg 6.20A paid on day 28 -> fulfilled; on day 29 -> breach.
#TRACE `reg 6.20A -- my fund must pay my departing super within 28 days` AT 0 WITH
    PARTY `my fund's trustee` DOES `pay my departing super as a single lump sum` AT 28

#TRACE `reg 6.34A -- my fund must roll over my super in time` 5 AT 0 WITH
    (WAITUNTIL 6)
    PARTY `my fund's trustee` DOES `roll over or transfer my withdrawal benefit` AT 6
