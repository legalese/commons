#ASSERT NOT `Am I late telling the Registrar` `mine` TRUE TRUE 28 FALSE
#ASSERT `Am I late telling the Registrar` `a partnership I am a partner of` TRUE TRUE 35 FALSE

§ `s 15 -- answering the Registrar`

#ASSERT `Must I answer the Registrar` TRUE TRUE 14 EQUALS `I must give the information within the period stated`
#ASSERT `Must I answer the Registrar` TRUE TRUE 7 EQUALS `no duty yet: the request does not give me the 14 days s 15(2) requires`
#ASSERT `Must I answer the Registrar` FALSE TRUE 21 EQUALS `no duty: I am not registered`
#ASSERT `Must I answer the Registrar` TRUE FALSE 21 EQUALS `no duty: the information is not about my entitlement, my identity or my Register details`

§ `ss 18, 19 -- cancellation and reinstatement`

#ASSERT `Can my ABN registration be cancelled` `Jake, still riding, nothing against him` EQUALS `no: there is no ground to cancel it`
#ASSERT `Can my ABN registration be cancelled` `Jake, stopped riding, Registrar satisfied he is no longer entitled` EQUALS `yes, the Registrar may cancel it: I am no longer entitled`
#ASSERT `Can my ABN registration be cancelled` `Jake, stopped riding, asks to cancel` EQUALS `yes, the Registrar may cancel it at my request`
#ASSERT `Can my ABN registration be cancelled` `registered under a borrowed identity` EQUALS `yes, the Registrar may cancel it: I am registered under a false identity`
#ASSERT `Can my ABN registration be cancelled` `registered as an employee who was never an enterprise` EQUALS `yes, the Registrar may cancel it: I was never entitled`

#ASSERT `Must I be given reasons for the cancellation` FALSE
#ASSERT NOT `Must I be given reasons for the cancellation` TRUE

#ASSERT `Can the cancellation take effect from that date` 20300101 20290601

#ASSERT `Must my ABN be reinstated` TRUE

§ `s 21 -- objections`

