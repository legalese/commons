#ASSERT `s 11 -- access to places and facilities` FALSE `refused me access to or use of the place or vehicle, or allowed it only on less favourable terms` TRUE FALSE FALSE FALSE EQUALS `this section does not reach it on these facts`
#ASSERT `s 11 -- access to places and facilities` TRUE `none of these` TRUE FALSE FALSE FALSE EQUALS `this section does not reach it on these facts`
#ASSERT `s 11 -- access to places and facilities` TRUE `refused me use of its facilities, or allowed it only on less favourable terms` FALSE FALSE FALSE FALSE EQUALS `this section does not reach it on these facts`
#ASSERT `s 11 -- access to places and facilities` TRUE `refused me use of its facilities, or allowed it only on less favourable terms` TRUE FALSE TRUE FALSE EQUALS `not unlawful: a special measure (s 8(1))`

