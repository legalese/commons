§ `s 15 -- employment`

#ASSERT `s 15 -- employment` `my employer or prospective employer, or someone acting or purporting to act for them` `refused or failed to employ me on available work I am qualified for` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS `unlawful under this section`
#ASSERT `s 15 -- employment` `my employer or prospective employer, or someone acting or purporting to act for them` `dismissed me` FALSE TRUE FALSE FALSE FALSE FALSE EQUALS `unlawful under this section`
-- Paid less than co-workers with the same qualifications on the same work, because of race.
#ASSERT `s 15 -- employment` `my employer or prospective employer, or someone acting or purporting to act for them` `did not give me the same terms, conditions, training or promotion opportunities as others with the same qualifications in the same circumstances` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS `unlawful under this section`
#ASSERT `s 15 -- employment` `an employment agency or other person procuring employment or employees` `treated me less favourably than others in the same circumstances while I was seeking employment` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS `unlawful under this section`
#ASSERT `s 15 -- employment` `an employment agency or other person procuring employment or employees` `treated me less favourably than others in the same circumstances while I was seeking employment` FALSE TRUE FALSE FALSE FALSE FALSE EQUALS `unlawful under this section`
#ASSERT `s 15 -- employment` `an organisation of employers or employees, or someone acting or purporting to act for it` `prevented or tried to prevent me from offering for employment or staying in employment` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS `unlawful under this section`
-- s 5 does not extend s 15(3) to immigrant status (finding 2).
#ASSERT `s 15 -- employment` `an organisation of employers or employees, or someone acting or purporting to act for it` `prevented or tried to prevent me from offering for employment or staying in employment` FALSE TRUE FALSE FALSE FALSE FALSE EQUALS `this section does not reach it on these facts`
-- The act does not match the actor.
#ASSERT `s 15 -- employment` `my employer or prospective employer, or someone acting or purporting to act for them` `treated me less favourably than others in the same circumstances while I was seeking employment` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS `this section does not reach it on these facts`
#ASSERT `s 15 -- employment` `an employment agency or other person procuring employment or employees` `dismissed me` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS `this section does not reach it on these facts`
#ASSERT `s 15 -- employment` `someone else` `dismissed me` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS `this section does not reach it on these facts`
#ASSERT `s 15 -- employment` `my employer or prospective employer, or someone acting or purporting to act for them` `dismissed me` FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `this section does not reach it on these facts`
#ASSERT `s 15 -- employment` `my employer or prospective employer, or someone acting or purporting to act for them` `none of these` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS `this section does not reach it on these facts`
-- s 15(4) foreign ship; s 15(5) work in the employer's home.
#ASSERT `s 15 -- employment` `my employer or prospective employer, or someone acting or purporting to act for them` `dismissed me` TRUE FALSE TRUE FALSE FALSE FALSE EQUALS `not unlawful: the section's own exception applies`
#ASSERT `s 15 -- employment` `my employer or prospective employer, or someone acting or purporting to act for them` `refused or failed to employ me on available work I am qualified for` TRUE FALSE FALSE TRUE FALSE FALSE EQUALS `not unlawful: the section's own exception applies`
#ASSERT `s 15 -- employment` `my employer or prospective employer, or someone acting or purporting to act for them` `dismissed me` TRUE FALSE FALSE FALSE TRUE FALSE EQUALS `not unlawful: a special measure (s 8(1))`

