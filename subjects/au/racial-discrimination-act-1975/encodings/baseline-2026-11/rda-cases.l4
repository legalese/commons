§ `ss 18A, 18E -- the employer or principal`

-- A State answerable for its officers' acts in the course of duty.
#ASSERT `ss 18A, 18E -- the employer or principal is answerable` TRUE TRUE TRUE FALSE EQUALS `yes: the Act applies to the employer or principal as if it had done the act too (s 18A or 18E)`
#ASSERT `ss 18A, 18E -- the employer or principal is answerable` TRUE TRUE TRUE TRUE EQUALS `no: the employer or principal took all reasonable steps to prevent it (s 18A(2) or 18E(2))`
#ASSERT `ss 18A, 18E -- the employer or principal is answerable` FALSE TRUE TRUE FALSE EQUALS `no: the conditions of s 18A(1) or 18E(1) are not met`
#ASSERT `ss 18A, 18E -- the employer or principal is answerable` TRUE FALSE TRUE FALSE EQUALS `no: the conditions of s 18A(1) or 18E(1) are not met`
#ASSERT `ss 18A, 18E -- the employer or principal is answerable` TRUE TRUE FALSE FALSE EQUALS `no: the conditions of s 18A(1) or 18E(1) are not met`
#ASSERT `ss 18A, 18E -- the employer or principal is answerable` FALSE TRUE TRUE TRUE EQUALS `no: the conditions of s 18A(1) or 18E(1) are not met`

§ `ss 18AA, 26, 27(2) -- victimisation`

#ASSERT `s 18AA -- I was victimised` `dismissed me or threatened to dismiss me` `I made or proposed to make a complaint under this Act or the AHRC Act`
#ASSERT `s 18AA -- I was victimised` `refused to employ me` `I gave or proposed to give information or documents to a person exercising powers under either Act`
#ASSERT `s 18AA -- I was victimised` `intimidated or coerced me, or imposed a penalty on me` `I attended or proposed to attend a conference held under either Act`
#ASSERT `s 18AA -- I was victimised` `prejudiced me in my employment or threatened to` `I made or proposed to make a complaint under this Act or the AHRC Act`
#ASSERT (NOT (`s 18AA -- I was victimised` `prejudiced me in my employment or threatened to` `none of these`))
#ASSERT (NOT (`s 18AA -- I was victimised` `none of these` `I made or proposed to make a complaint under this Act or the AHRC Act`))
#ASSERT `ss 26, 27(2) -- is it a crime` `dismissed me or threatened to dismiss me` `I made or proposed to make a complaint under this Act or the AHRC Act` `a natural person` EQUALS `yes: an offence; up to 25 penalty units or 3 months' imprisonment, or both (s 27(2)(a))`
#ASSERT `ss 26, 27(2) -- is it a crime` `dismissed me or threatened to dismiss me` `I made or proposed to make a complaint under this Act or the AHRC Act` `a body corporate` EQUALS `yes: an offence; up to 100 penalty units (s 27(2)(b))`
#ASSERT `ss 26, 27(2) -- is it a crime` `none of these` `I made or proposed to make a complaint under this Act or the AHRC Act` `a natural person` EQUALS `no: under the Act it is unlawful but not an offence (s 26)`
#ASSERT `ss 26, 27(2) -- is it a crime` `none of these` `none of these` `a body corporate` EQUALS `no: under the Act it is unlawful but not an offence (s 26)`
-- A State itself victimises a complainant: unlawful, but the Crown is not prosecuted (s 6(2)); its officer would be.
#ASSERT `ss 26, 27(2) -- is it a crime` `intimidated or coerced me, or imposed a penalty on me` `I made or proposed to make a complaint under this Act or the AHRC Act` `the Crown (the Commonwealth, a State or a Territory, in any capacity)` EQUALS `no: the Act does not make the Crown liable to be prosecuted (s 6(2)), though it is unlawful (s 18AA)`
#ASSERT `ss 26, 27(2) -- is it a crime` `none of these` `none of these` `the Crown (the Commonwealth, a State or a Territory, in any capacity)` EQUALS `no: under the Act it is unlawful but not an offence (s 26)`

§ `Part IIA -- s 18C`

#ASSERT `ss 18B, 18C, 18D -- offensive behaviour because of race` `in a public place` TRUE TRUE `none of these` FALSE EQUALS `unlawful under s 18C`
#ASSERT `ss 18B, 18C, 18D -- offensive behaviour because of race` `communicated to the public (words, sounds, images or writing)` TRUE TRUE `a fair comment on an event or matter of public interest expressing their genuine belief` TRUE EQUALS `not unlawful: an exemption in s 18D applies`
-- The same comment, not made reasonably and in good faith: no exemption.
#ASSERT `ss 18B, 18C, 18D -- offensive behaviour because of race` `communicated to the public (words, sounds, images or writing)` TRUE TRUE `a fair comment on an event or matter of public interest expressing their genuine belief` FALSE EQUALS `unlawful under s 18C`
-- Good faith alone, with no s 18D head, exempts nothing.
#ASSERT `ss 18B, 18C, 18D -- offensive behaviour because of race` `in the sight or hearing of people in a public place` TRUE TRUE `none of these` TRUE EQUALS `unlawful under s 18C`
#ASSERT `ss 18B, 18C, 18D -- offensive behaviour because of race` `in private, as far as I know` TRUE TRUE `none of these` FALSE EQUALS `s 18C does not reach it: on these facts it was done in private`
#ASSERT `ss 18B, 18C, 18D -- offensive behaviour because of race` `in private, as far as I know` FALSE FALSE `none of these` FALSE EQUALS `s 18C does not reach it: on these facts it was done in private`
#ASSERT `ss 18B, 18C, 18D -- offensive behaviour because of race` `in a public place` FALSE TRUE `none of these` FALSE EQUALS `not unlawful under s 18C: it is not reasonably likely to offend, insult, humiliate or intimidate, or race was not a reason`
#ASSERT `ss 18B, 18C, 18D -- offensive behaviour because of race` `in a public place` TRUE FALSE `none of these` FALSE EQUALS `not unlawful under s 18C: it is not reasonably likely to offend, insult, humiliate or intimidate, or race was not a reason`
#ASSERT `ss 18B, 18C, 18D -- offensive behaviour because of race` `somewhere else, but a court would find it was not in private` TRUE TRUE `none of these` FALSE EQUALS `unlawful under s 18C`
#ASSERT `ss 18B, 18C, 18D -- offensive behaviour because of race` `in a public place` TRUE TRUE `performing, exhibiting or distributing an artistic work` TRUE EQUALS `not unlawful: an exemption in s 18D applies`
#ASSERT `ss 18B, 18C, 18D -- offensive behaviour because of race` `communicated to the public (words, sounds, images or writing)` TRUE TRUE `a fair and accurate report of an event or matter of public interest` TRUE EQUALS `not unlawful: an exemption in s 18D applies`

§ `AHRC Act s 46P, RDA s 6A(2) -- complaining`

#ASSERT `AHRC Act s 46P, RDA s 6A(2) -- can I complain` TRUE TRUE TRUE `I am aggrieved and lodge it for myself, or for myself and others aggrieved` FALSE FALSE EQUALS `yes: the complaint may be lodged with the Commission (AHRC Act s 46P)`
#ASSERT `AHRC Act s 46P, RDA s 6A(2) -- can I complain` TRUE TRUE TRUE `another person or a trade union lodges it for me` FALSE FALSE EQUALS `yes: the complaint may be lodged with the Commission (AHRC Act s 46P)`
#ASSERT `AHRC Act s 46P, RDA s 6A(2) -- can I complain` TRUE TRUE TRUE `two or more of us who are aggrieved lodge it together, for ourselves or for others too` FALSE FALSE EQUALS `yes: the complaint may be lodged with the Commission (AHRC Act s 46P)`
#ASSERT `AHRC Act s 46P, RDA s 6A(2) -- can I complain` TRUE TRUE TRUE `I am aggrieved and lodge it for myself, or for myself and others aggrieved` TRUE FALSE EQUALS `no: I already took action under a State or Territory law about the same act (RDA s 6A(2))`
#ASSERT `AHRC Act s 46P, RDA s 6A(2) -- can I complain` TRUE TRUE TRUE `I am aggrieved and lodge it for myself, or for myself and others aggrieved` FALSE TRUE EQUALS `no: I am a class member of a representative complaint on the same subject (AHRC Act s 46P(3))`
#ASSERT `AHRC Act s 46P, RDA s 6A(2) -- can I complain` FALSE TRUE TRUE `I am aggrieved and lodge it for myself, or for myself and others aggrieved` FALSE FALSE EQUALS `no: it must be in writing (AHRC Act s 46P(1))`
#ASSERT `AHRC Act s 46P, RDA s 6A(2) -- can I complain` TRUE TRUE FALSE `I am aggrieved and lodge it for myself, or for myself and others aggrieved` FALSE FALSE EQUALS `no: it must be reasonably arguable that it is unlawful discrimination (AHRC Act s 46P(1A))`
#ASSERT `AHRC Act s 46P, RDA s 6A(2) -- can I complain` TRUE FALSE TRUE `I am aggrieved and lodge it for myself, or for myself and others aggrieved` FALSE FALSE EQUALS `s 46P does not reach it: it does not allege unlawful discrimination, or is not lodged by or for a person aggrieved`
#ASSERT `AHRC Act s 46P, RDA s 6A(2) -- can I complain` TRUE TRUE TRUE `none of these` FALSE FALSE EQUALS `s 46P does not reach it: it does not allege unlawful discrimination, or is not lodged by or for a person aggrieved`
#ASSERT `AHRC Act s 46P, RDA s 6A(2) -- can I complain` FALSE FALSE FALSE `none of these` TRUE FALSE EQUALS `no: I already took action under a State or Territory law about the same act (RDA s 6A(2))`

