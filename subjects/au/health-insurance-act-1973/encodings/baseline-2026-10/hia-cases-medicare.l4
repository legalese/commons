    `out-of-pocket expenses on earlier claims this year` IS 350
    `I paid at least 20% of the out-of-pocket expenses directly to the professional` IS TRUE
    `I am a concessional person this year` IS FALSE
    `my registered family is an FTB(A) family this year` IS TRUE

