IMPORT prelude
IMPORT `spi67-rules`

§ `Tests`

-- 3 additional units at $65: $195.
#ASSERT `my annual pension increase for` (`Pension increase case` OF 10, 7, 7, `the standard case`, 0, 0, `not a widow`, FALSE) EQUALS 195
#ASSERT `my annual pension increase for` (`Pension increase case` OF 7, 7, 7, `the standard case`, 0, 0, `not a widow`, FALSE) EQUALS 0
-- (b): 6 of 8 units: $48.75 a unit; 2 additional: $97.50.
#ASSERT `my annual pension increase for` (`Pension increase case` OF 10, 8, 6, `contributed for fewer units than entitled`, 0, 0, `not a widow`, FALSE) EQUALS 97.5
-- s 4(2): less $150 of earlier increases.
#ASSERT `my annual pension increase for` (`Pension increase case` OF 10, 7, 7, `the standard case`, 0, 150, `not a widow`, FALSE) EQUALS 45
#ASSERT `my annual pension increase for` (`Pension increase case` OF 10, 7, 7, `the standard case`, 0, 300, `not a widow`, FALSE) EQUALS 0
-- s 4(3)
#ASSERT `my annual pension increase for` (`Pension increase case` OF 10, 7, 7, `the standard case`, 0, 0, `a widow whose husband elected out of section 26`, FALSE) EQUALS 97.5
#ASSERT `my annual pension increase for` (`Pension increase case` OF 10, 7, 7, `the standard case`, 0, 0, `any other widow`, FALSE) EQUALS 121.875
#ASSERT `my annual pension increase for` (`Pension increase case` OF 10, 7, 7, `the standard case`, 0, 0, `not a widow`, TRUE) EQUALS 0
#ASSERT `my annual pension increase for` (`Pension increase case` OF 10, 7, 7, `a case under paragraph (c), (d) or (e)`, 1/2, 0, `not a widow`, FALSE) EQUALS 97.5
