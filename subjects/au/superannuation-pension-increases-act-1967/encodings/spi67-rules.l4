IMPORT prelude

-- Superannuation (Pension Increases) Act 1967 (Cth). Source:
-- ../registers/source-bundle/C1967A00090.txt. Seat: the pensioner or widow.

§ `Nouns`

DECLARE `Relevant amount case` IS ONE OF
    -- s 3 "the relevant amount" (a)
    `the standard case`
    -- (b)
    `contributed for fewer units than entitled`
    -- (c)-(e): the proportion is given
    `a case under paragraph (c), (d) or (e)`

DECLARE `Widow case` IS ONE OF
    `not a widow`
    -- s 4(3)(c)
    `a widow whose husband elected out of section 26`
    -- s 4(3)(d)
    `any other widow`

DECLARE `Pension increase case` HAS
    `adjusted unit entitlement`                         IS A NUMBER
    `actual unit entitlement`                           IS A NUMBER
    `actual unit contribution`                          IS A NUMBER
    `relevant amount case`                              IS A `Relevant amount case`
    `fraction for paragraph (c), (d) or (e)`            IS A NUMBER
    -- s 4(2): the sum of the increases under the 1957 Act s 11, the 1961 Act
    -- s 4 and the 1963 Act s 26
    `earlier increases`                                 IS A NUMBER
    `widow`                                             IS A `Widow case`
    -- s 4(4)
    `an excluded pension`                               IS A BOOLEAN

§ `Rules`

@ref s 3 "the relevant amount"
GIVEN p IS A `Pension increase case`
GIVETH A NUMBER
`the relevant amount for` p MEANS
    CONSIDER p's `relevant amount case`
    WHEN `the standard case` THEN 65
    WHEN `contributed for fewer units than entitled` THEN 65 TIMES p's `actual unit contribution` DIVIDED BY p's `actual unit entitlement`
    WHEN `a case under paragraph (c), (d) or (e)` THEN 65 TIMES p's `fraction for paragraph (c), (d) or (e)`

@ref s 4(1)-(2)
GIVEN p IS A `Pension increase case`
GIVETH A NUMBER
`the pensioner's increase for` p MEANS
    IF net GREATER THAN 0 THEN net ELSE 0
    WHERE
        additional MEANS p's `adjusted unit entitlement` MINUS p's `actual unit entitlement`
        gross MEANS IF additional GREATER THAN 0 THEN `the relevant amount for` p TIMES additional ELSE 0
        net MEANS gross MINUS p's `earlier increases`

@ref s 4
@export default The increase in my annual pension under the Superannuation (Pension Increases) Act 1967 (Cth): the relevant amount ($65, or a proportion of it) for each unit by which my adjusted unit entitlement exceeds my actual unit entitlement, less the increases I received under the 1957 and 1963 Superannuation Acts and the 1961 Pension Increases Act; for a widow, one-half (if her husband elected out of s 26) or five-eighths of her husband's increase; nil for an excluded pension. DRAFT, not reviewed by an Australian lawyer.
GIVEN p IS A `Pension increase case`  @desc The unit figures, the relevant amount case, earlier increases, the widow's case, and whether excluded
GIVETH A NUMBER
`my annual pension increase for` p MEANS
    IF p's `an excluded pension` THEN 0
    ELSE
        CONSIDER p's `widow`
        WHEN `not a widow` THEN `the pensioner's increase for` p
        WHEN `a widow whose husband elected out of section 26` THEN 1/2 TIMES `the pensioner's increase for` p
        WHEN `any other widow` THEN 5/8 TIMES `the pensioner's increase for` p
