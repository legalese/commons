IMPORT prelude
IMPORT `rpt-rules`

§ `Tests`

base MEANS `Prisoner case` OF TRUE, FALSE, `life or health endangered by further imprisonment`, TRUE, TRUE, FALSE, TRUE, FALSE, FALSE
#ASSERT `removal may be recommended for` base
#ASSERT `removal is lawful for` base
#ASSERT `entitled to a free return for` base
#ASSERT NOT (`removal may be recommended for` (`Prisoner case` OF TRUE, TRUE, `life or health endangered by further imprisonment`, TRUE, TRUE, FALSE, TRUE, FALSE, FALSE))
#ASSERT NOT (`removal may be recommended for` (`Prisoner case` OF TRUE, FALSE, `no ground`, TRUE, TRUE, FALSE, TRUE, FALSE, FALSE))
#ASSERT NOT (`removal is lawful for` (`Prisoner case` OF TRUE, FALSE, `offence committed partly outside the Territory`, TRUE, FALSE, FALSE, TRUE, FALSE, FALSE))
#ASSERT NOT (`removal is lawful for` (`Prisoner case` OF TRUE, FALSE, `offence committed partly outside the Territory`, TRUE, TRUE, TRUE, TRUE, FALSE, FALSE))
#ASSERT NOT (`entitled to a free return for` (`Prisoner case` OF TRUE, FALSE, `no proper prison, removal expedient`, TRUE, TRUE, FALSE, TRUE, TRUE, FALSE))
#ASSERT NOT (`entitled to a free return for` (`Prisoner case` OF TRUE, FALSE, `no proper prison, removal expedient`, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE))
#ASSERT (`the prisoner position for` base)'s `escape stops the sentence running`
