IMPORT prelude
IMPORT `rpt-rules`

-- Independent tests, written from BRIEF.md, the source text and
-- independent-expectations.md. Expected values are not tuned to the code.
-- Field order of `Prisoner case`: sentenced in a Territory, NT, ground,
-- GG ordered, concurred, AG direction, discharged/released, breach, unlawful.

§ `Independent tests`

-- E12: full removal case on ground (b), discharged at expiry, nothing barring return
e12 MEANS `Prisoner case` OF TRUE, FALSE, `life or health endangered by further imprisonment`, TRUE, TRUE, FALSE, TRUE, FALSE, FALSE

-- E1 / E3 (commuted death sentence is fed as "sentenced to imprisonment"): prisoner, may be recommended
#ASSERT `removal may be recommended for` e12
-- E4: sentenced in a State, not a Territory -> not a prisoner, no recommendation
#ASSERT NOT (`removal may be recommended for` (`Prisoner case` OF FALSE, FALSE, `life or health endangered by further imprisonment`, TRUE, TRUE, FALSE, TRUE, FALSE, FALSE))
-- E4 continued: not a prisoner -> no lawful removal
#ASSERT NOT (`removal is lawful for` (`Prisoner case` OF FALSE, FALSE, `life or health endangered by further imprisonment`, TRUE, TRUE, FALSE, TRUE, FALSE, FALSE))
-- E5: ground (a)
#ASSERT `removal may be recommended for` (`Prisoner case` OF TRUE, FALSE, `no proper prison, removal expedient`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)
-- E7: ground (b)
#ASSERT `removal may be recommended for` (`Prisoner case` OF TRUE, FALSE, `life or health endangered by further imprisonment`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)
-- E8: ground (c)
#ASSERT `removal may be recommended for` (`Prisoner case` OF TRUE, FALSE, `offence committed partly outside the Territory`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)
-- E9: ground (d)
#ASSERT `removal may be recommended for` (`Prisoner case` OF TRUE, FALSE, `a class subject to removal under the Territory's law`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)
-- E10: Northern Territory, ground (b) -> no recommendation
#ASSERT NOT (`removal may be recommended for` (`Prisoner case` OF TRUE, TRUE, `life or health endangered by further imprisonment`, TRUE, TRUE, FALSE, TRUE, FALSE, FALSE))
-- E10 continued: and so no lawful removal
#ASSERT NOT (`removal is lawful for` (`Prisoner case` OF TRUE, TRUE, `life or health endangered by further imprisonment`, TRUE, TRUE, FALSE, TRUE, FALSE, FALSE))
-- E11 / E15: no ground -> no recommendation, no removal even if GG "orders" and State concurs
#ASSERT NOT (`removal may be recommended for` (`Prisoner case` OF TRUE, FALSE, `no ground`, TRUE, TRUE, FALSE, TRUE, FALSE, FALSE))
#ASSERT NOT (`removal is lawful for` (`Prisoner case` OF TRUE, FALSE, `no ground`, TRUE, TRUE, FALSE, TRUE, FALSE, FALSE))
-- E12: removal lawful
#ASSERT `removal is lawful for` e12
-- E12 variant: GG has not ordered
#ASSERT NOT (`removal is lawful for` (`Prisoner case` OF TRUE, FALSE, `life or health endangered by further imprisonment`, FALSE, TRUE, FALSE, TRUE, FALSE, FALSE))
-- E13: no concurrence
#ASSERT NOT (`removal is lawful for` (`Prisoner case` OF TRUE, FALSE, `life or health endangered by further imprisonment`, TRUE, FALSE, FALSE, TRUE, FALSE, FALSE))
-- E14: Attorney-General's s 8AA direction
#ASSERT NOT (`removal is lawful for` (`Prisoner case` OF TRUE, FALSE, `life or health endangered by further imprisonment`, TRUE, TRUE, TRUE, TRUE, FALSE, FALSE))
-- E17: removed prisoner's conviction questioned in the Territory of origin
#ASSERT (`the prisoner position for` e12)'s `conviction questioned in the Territory of origin`
-- E18 / E19: discharged or released, no bar -> free return
#ASSERT `entitled to a free return for` e12
#ASSERT (`the prisoner position for` e12)'s `entitled to a free return`
-- E20: return would breach licence condition
#ASSERT NOT (`entitled to a free return for` (`Prisoner case` OF TRUE, FALSE, `life or health endangered by further imprisonment`, TRUE, TRUE, FALSE, TRUE, TRUE, FALSE))
-- E21: return unlawful
#ASSERT NOT (`entitled to a free return for` (`Prisoner case` OF TRUE, FALSE, `life or health endangered by further imprisonment`, TRUE, TRUE, FALSE, TRUE, FALSE, TRUE))
-- E22: never removed (no concurrence, so never lawfully removed)
#ASSERT NOT (`entitled to a free return for` (`Prisoner case` OF TRUE, FALSE, `life or health endangered by further imprisonment`, TRUE, FALSE, FALSE, TRUE, FALSE, FALSE))
-- E23: still serving (neither discharged nor released)
#ASSERT NOT (`entitled to a free return for` (`Prisoner case` OF TRUE, FALSE, `life or health endangered by further imprisonment`, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE))
-- E25: s 7A - the sentence does not run while at large
#ASSERT (`the prisoner position for` e12)'s `escape stops the sentence running`
-- E25 for a prisoner in the NT, who was never removed: s 7A still applies to an escaped prisoner
#ASSERT (`the prisoner position for` (`Prisoner case` OF TRUE, TRUE, `no ground`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE))'s `escape stops the sentence running`
-- Position record agrees with the separate rules (NT case)
#ASSERT NOT ((`the prisoner position for` (`Prisoner case` OF TRUE, TRUE, `life or health endangered by further imprisonment`, TRUE, TRUE, FALSE, TRUE, FALSE, FALSE))'s `removal is lawful`)
-- E17 negative: not removed -> s 5(2)'s "as if not removed" is not engaged
#ASSERT NOT ((`the prisoner position for` (`Prisoner case` OF TRUE, FALSE, `life or health endangered by further imprisonment`, TRUE, TRUE, TRUE, TRUE, FALSE, FALSE))'s `conviction questioned in the Territory of origin`)
