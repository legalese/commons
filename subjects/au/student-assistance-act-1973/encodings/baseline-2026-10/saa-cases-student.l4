IMPORT prelude
IMPORT daydate
IMPORT `saa-student`

-- Student Assistance Act 1973 -- worked cases, from the student's seat.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Expected values were written by hand from
-- the deposited text (C2026C00238), never copied from the encoding's output. No scenario life raised this Act (REQ-0074 is a
-- scheduled priority-2 entry): the student (Jarrah) and the dates below are the encoder's, HYPOTHETICAL.

-- ---------------------------------------------------------------------------------------------------------------------
-- ss 7C, 7D. Jarrah, an ABSTUDY Living Allowance recipient studying full-time at university in 2027.
#ASSERT `Am I qualified for an ABSTUDY student start-up loan` TRUE TRUE TRUE TRUE TRUE FALSE FALSE EQUALS `yes: I am qualified for an ABSTUDY student start-up loan for this qualification period, of the s 7E amount ($1,025 as indexed each 1 January)`
-- He already has a start-up loan determination for this half-year.
#ASSERT `Am I qualified for an ABSTUDY student start-up loan` TRUE TRUE TRUE TRUE TRUE TRUE FALSE EQUALS `no: I already have a start-up loan determination (ABSTUDY or Social Security) for this qualification period (s 7D(a))`
-- He received a disqualifying education costs scholarship in the last 6 months.
#ASSERT `Am I qualified for an ABSTUDY student start-up loan` TRUE TRUE TRUE TRUE TRUE FALSE TRUE EQUALS `no: in the 6 months before my qualification test day I received (or was entitled to, but for a suspension) a disqualifying scholarship or an MRCA student start-up scholarship (s 7D(b))`
-- Part-time study.
#ASSERT `Am I qualified for an ABSTUDY student start-up loan` TRUE TRUE FALSE TRUE TRUE FALSE FALSE EQUALS `no: on my qualification test day I am not receiving ABSTUDY Living Allowance as a full-time student in an approved scholarship course (s 7C(1)(a))`
-- His Living Allowance is only rent assistance and pharmaceutical allowance.
#ASSERT `Am I qualified for an ABSTUDY student start-up loan` TRUE FALSE TRUE TRUE TRUE FALSE FALSE EQUALS `no: on my qualification test day I am not receiving ABSTUDY Living Allowance as a full-time student in an approved scholarship course (s 7C(1)(a))`
#ASSERT `Am I qualified for an ABSTUDY student start-up loan` TRUE TRUE TRUE FALSE TRUE FALSE FALSE EQUALS `no: the Secretary is not satisfied that I am unlikely to receive a disqualifying education costs scholarship in the next 6 months (s 7C(1)(b))`
#ASSERT `Am I qualified for an ABSTUDY student start-up loan` TRUE TRUE TRUE TRUE FALSE FALSE FALSE EQUALS `no: I have not notified the Secretary of my tax file number (s 7C(1)(c))`

-- s 7C(2): qualification test day. Claim for January-June 2027 decided 10 February 2027; course runs on.
#ASSERT `What is my qualification test day` (Date 1 1 2027) (Date 10 2 2027) FALSE (Date 1 1 2000) EQUALS Date 10 2 2027
-- July-December 2026; the course ends 15 November 2026; the claim is decided 20 November 2026: the course end comes first.
#ASSERT `What is my qualification test day` (Date 1 7 2026) (Date 20 11 2026) TRUE (Date 15 11 2026) EQUALS Date 15 11 2026
-- July-December 2026; the claim is decided on 8 January 2027, after the period: the last day of the period.
#ASSERT `What is my qualification test day` (Date 1 7 2026) (Date 8 1 2027) FALSE (Date 1 1 2000) EQUALS Date 31 12 2026

-- ss 8B, 38A. Period January-June 2027; course starts 22 February 2027; qualification test day 10 February (before the course):
-- the 35th day of the period from 22 February is 28 March. Paid 12 February: the debt is incurred the day after, 29 March 2027.
#ASSERT `What does my start-up loan become` (Date 12 2 2027) (Date 10 2 2027) (Date 22 2 2027) FALSE (Date 1 1 2000) FALSE FALSE FALSE EQUALS `an income-contingent ABSTUDY SSL debt, incurred on` (Date 29 3 2027)
-- Qualification test day 1 March 2027, after the course began: 35th day from 1 March is 4 April; paid 3 March: incurred 5 April.
#ASSERT `What does my start-up loan become` (Date 3 3 2027) (Date 1 3 2027) (Date 22 2 2027) FALSE (Date 1 1 2000) FALSE FALSE FALSE EQUALS `an income-contingent ABSTUDY SSL debt, incurred on` (Date 5 4 2027)
-- The course ends 15 March 2027: the enrolment test day is 15 March; incurred 16 March.
#ASSERT `What does my start-up loan become` (Date 12 2 2027) (Date 10 2 2027) (Date 22 2 2027) TRUE (Date 15 3 2027) FALSE FALSE FALSE EQUALS `an income-contingent ABSTUDY SSL debt, incurred on` (Date 16 3 2027)
-- Paid late, on 20 April 2027, after the enrolment test day: incurred the day it is paid.
#ASSERT `What does my start-up loan become` (Date 20 4 2027) (Date 10 2 2027) (Date 22 2 2027) FALSE (Date 1 1 2000) FALSE FALSE FALSE EQUALS `an income-contingent ABSTUDY SSL debt, incurred on` (Date 20 4 2027)
-- Second half of 2026: course from 14 July, qualification test day 20 July (35th day: 23 August), paid 22 July: 24 August.
#ASSERT `What does my start-up loan become` (Date 22 7 2026) (Date 20 7 2026) (Date 14 7 2026) FALSE (Date 1 1 2000) FALSE FALSE FALSE EQUALS `an income-contingent ABSTUDY SSL debt, incurred on` (Date 24 8 2026)
#ASSERT `What does my start-up loan become` (Date 12 2 2027) (Date 10 2 2027) (Date 22 2 2027) FALSE (Date 1 1 2000) TRUE FALSE FALSE EQUALS `no ABSTUDY SSL debt: I repaid the loan in full before the day it would have been incurred (s 8B(4)(a))`
-- He dropped to part-time in circumstances the Minister's instrument covers: an overpayment, a debt now.
#ASSERT `What does my start-up loan become` (Date 12 2 2027) (Date 10 2 2027) (Date 22 2 2027) FALSE (Date 1 1 2000) FALSE TRUE FALSE EQUALS `a debt I owe now: the loan is an ABSTUDY student start-up loan overpayment, a debt from the day I was paid it (ss 38A(1), 39)`
-- The same, but the Secretary accepts exceptional circumstances: no debt of either kind (finding 4).
#ASSERT `What does my start-up loan become` (Date 12 2 2027) (Date 10 2 2027) (Date 22 2 2027) FALSE (Date 1 1 2000) FALSE TRUE TRUE EQUALS `no debt at all: the Secretary is of the opinion that exceptional circumstances beyond my control stopped me meeting the study condition (ss 38A(3), 8B(4)(c))`

-- ss 8B(3), 8BA.
#ASSERT `How much is my ABSTUDY SSL debt` 1025 0 (Date 10 3 2025) EQUALS 820
#ASSERT `How much is my ABSTUDY SSL debt` 1025 0 (Date 1 6 2025) EQUALS 820
#ASSERT `How much is my ABSTUDY SSL debt` 1025 0 (Date 2 6 2025) EQUALS 1025
#ASSERT `How much is my ABSTUDY SSL debt` 1025 25 (Date 15 1 2025) EQUALS 800
#ASSERT `How much is my ABSTUDY SSL debt` 1025 0 (Date 31 12 2024) EQUALS 1025

-- s 9B. $2,000 + $1,025 - $500 - $300 = $2,225, times 1.04 = $2,314.
#ASSERT `What is my former accumulated ABSTUDY SSL debt` 2000 1025 500 300 0 0 1.04 FALSE EQUALS 2314
-- The 2024-25 year: step 7 takes 20% off, $1,780, times 1.04 = $1,851.20.
#ASSERT `What is my former accumulated ABSTUDY SSL debt` 2000 1025 500 300 0 0 1.04 TRUE EQUALS 1851.2
-- An amended assessment increased one compulsory amount by $50 and reduced another by $100: $2,275, times 1.02 = $2,320.50.
#ASSERT `What is my former accumulated ABSTUDY SSL debt` 2000 1025 500 300 50 100 1.02 FALSE EQUALS 2320.5

-- ss 10F, 12ZK.
#ASSERT `Must I make a compulsory repayment` `an accumulated ABSTUDY SSL debt` 80000 54435 TRUE TRUE EQUALS `answered` `no compulsory repayment: no Medicare levy is payable by me, or my Medicare levy is reduced, under s 8 of the Medicare Levy Act 1986`
#ASSERT `Must I make a compulsory repayment` `an accumulated ABSTUDY SSL debt` 50000 54435 TRUE FALSE EQUALS `answered` `no compulsory repayment: my repayment income does not exceed the minimum repayment income`
-- Income equal to the minimum does not "exceed" it.
#ASSERT `Must I make a compulsory repayment` `an accumulated ABSTUDY SSL debt` 54435 54435 TRUE FALSE EQUALS `answered` `no compulsory repayment: my repayment income does not exceed the minimum repayment income`
#ASSERT `Must I make a compulsory repayment` `an accumulated ABSTUDY SSL debt` 80000 54435 FALSE FALSE EQUALS `answered` `no compulsory repayment: I had no accumulated debt on the 1 June before the assessment`
#ASSERT `Must I make a compulsory repayment` `an accumulated ABSTUDY SSL debt` 80000 54435 TRUE FALSE EQUALS `not covered` `the formula in s 10F(1) is not in the deposited compilation (it was lost in conversion), so the compulsory ABSTUDY SSL repayment amount cannot be worked out`
#ASSERT `Must I make a compulsory repayment` `an accumulated Student Financial Supplement (FS) debt` 80000 54435 TRUE FALSE EQUALS `not covered` `the formula in s 12ZLC(1) is not in the deposited compilation (it was lost in conversion), so the compulsory FS repayment amount cannot be worked out`

-- s 48: a prescribed event on 3 March 2027: tell the Department by 17 March 2027.
#ASSERT `Must I tell the Department of the event` TRUE TRUE (Date 3 3 2027) EQUALS `yes: I must notify the Department, as the regulations require, by` (Date 17 3 2027)
#ASSERT `Must I tell the Department of the event` TRUE FALSE (Date 3 3 2027) EQUALS `no: s 48 does not require me to notify the Department of this event`
#ASSERT `Must I tell the Department of the event` FALSE TRUE (Date 3 3 2027) EQUALS `no: s 48 does not require me to notify the Department of this event`

-- ---------------------------------------------------------------------------------------------------------------------
-- s 40(2): a debt notice dated 1 March 2027 is due on the 28th day after: 29 March 2027.
#ASSERT `When is my debt due` (Date 1 3 2027) EQUALS Date 29 3 2027
-- s 41A(4): an arrangement terminated on 10 May 2027: due 24 May 2027.
#ASSERT `When is my debt due after my arrangement ends` (Date 10 5 2027) EQUALS Date 24 5 2027

-- s 41: nothing paid, no arrangement, no exempting payment: interest charge from 30 March 2027, the day after the due day.
#ASSERT `Does interest charge run on my debt` (Date 1 3 2027) FALSE FALSE FALSE FALSE EQUALS `interest charge runs on the unpaid amount from` (Date 30 3 2027)
#ASSERT `Does interest charge run on my debt` (Date 1 3 2027) TRUE FALSE FALSE FALSE EQUALS `no interest charge: nothing remained unpaid at the end of the due day`
#ASSERT `Does interest charge run on my debt` (Date 1 3 2027) FALSE TRUE FALSE FALSE EQUALS `no interest charge: a repayment arrangement was in effect at the end of the due day (s 41(1)(c))`
-- He is back on ABSTUDY Living Allowance.
#ASSERT `Does interest charge run on my debt` (Date 1 3 2027) FALSE FALSE TRUE FALSE EQUALS `no interest charge: on the day before it would start I was receiving ABSTUDY living allowance, AIC, family tax benefit, a social security payment or a veterans' pension or allowance (s 41D)`
#ASSERT `Does interest charge run on my debt` (Date 1 3 2027) FALSE FALSE FALSE TRUE EQUALS `no interest charge: the Secretary has determined it is not payable (s 41E)`

-- s 41C(2): which month's yield.
#ASSERT `Which month's yield sets the rate` (Date 15 2 2027) EQUALS `the preceding November`
#ASSERT `Which month's yield sets the rate` (Date 31 3 2027) EQUALS `the preceding November`
#ASSERT `Which month's yield sets the rate` (Date 1 4 2027) EQUALS `the preceding February`
#ASSERT `Which month's yield sets the rate` (Date 30 9 2027) EQUALS `the preceding May`
#ASSERT `Which month's yield sets the rate` (Date 1 10 2027) EQUALS `the preceding August`
-- s 41C(1), (4): a yield of 4.123% rounds to 4.12%; plus 7 = 11.12%, over 365 days.
#ASSERT `What is the daily interest charge rate` (Date 15 2 2027) 4.123 EQUALS 11.12 DIVIDED BY 365
-- 4.125% rounds up to 4.13%.
#ASSERT `What is the daily interest charge rate` (Date 15 2 2027) 4.125 EQUALS 11.13 DIVIDED BY 365
-- 2028 is a leap year: 366 days.
#ASSERT `What is the daily interest charge rate` (Date 15 2 2028) 3.5 EQUALS 10.5 DIVIDED BY 366

-- ---------------------------------------------------------------------------------------------------------------------
-- s 43B(1), (2): the first payment that caused the debt was on 1 February 2027; the 6 weeks end on 15 March 2027.
#ASSERT `Must the Secretary waive the error part of my debt` TRUE TRUE (Date 1 2 2027) FALSE (Date 1 1 2000) (Date 20 3 2027)
#ASSERT (NOT `Must the Secretary waive the error part of my debt` TRUE TRUE (Date 1 2 2027) FALSE (Date 1 1 2000) (Date 10 3 2027))
-- Raised on 15 March 2027, the last day of the 6 weeks: within them.
#ASSERT (NOT `Must the Secretary waive the error part of my debt` TRUE TRUE (Date 1 2 2027) FALSE (Date 1 1 2000) (Date 15 3 2027))
-- It arose from information he had to give by 1 March 2027: the later start; raised 20 March is within 6 weeks of that.
#ASSERT (NOT `Must the Secretary waive the error part of my debt` TRUE TRUE (Date 1 2 2027) TRUE (Date 1 3 2027) (Date 20 3 2027))
#ASSERT (NOT `Must the Secretary waive the error part of my debt` TRUE FALSE (Date 1 2 2027) FALSE (Date 1 1 2000) (Date 20 3 2027))
-- s 43D, with the $250 amount.
#ASSERT `Must the Secretary waive my small debt` 200 250
#ASSERT (NOT `Must the Secretary waive my small debt` 250 250)
-- s 43B(3).
#ASSERT `Must the Secretary waive the underestimate part` TRUE TRUE TRUE
#ASSERT (NOT `Must the Secretary waive the underestimate part` TRUE FALSE TRUE)
-- s 43E: the statute's own example (Terry): $6,000 outstanding, $4,700 agreed: $1,300 waived.
#ASSERT `How much must be waived on settlement` `an agreement that I pay an agreed lesser amount in full satisfaction` 6000 4700 FALSE EQUALS 1300
#ASSERT `How much must be waived on settlement` `a settlement of court or ART proceedings for less than the debt` 6000 4000 FALSE EQUALS 2000
-- 80% rule: $4,100 of a $5,000 debt recovered (82%), he can pay no more: $900 waived.
#ASSERT `How much must be waived on settlement` `at least 80% has been recovered and we agree that is full satisfaction` 5000 4100 TRUE EQUALS 900
-- $3,900 is 78%: no waiver under (3).
#ASSERT `How much must be waived on settlement` `at least 80% has been recovered and we agree that is full satisfaction` 5000 3900 TRUE EQUALS 0
#ASSERT `How much must be waived on settlement` `at least 80% has been recovered and we agree that is full satisfaction` 5000 4100 FALSE EQUALS 0
-- s 43F.
#ASSERT `Can the Secretary waive my debt in special circumstances` `no one knowingly made a false statement or failed to comply` TRUE TRUE EQUALS `the Secretary may waive all or part of it, if satisfied of the special circumstances and that waiver is more appropriate than write-off (s 43F)`
#ASSERT `Can the Secretary waive my debt in special circumstances` `someone else knowingly did, and I did not know` TRUE TRUE EQUALS `the Secretary may waive all or part of it, if satisfied of the special circumstances and that waiver is more appropriate than write-off (s 43F)`
#ASSERT `Can the Secretary waive my debt in special circumstances` `I knowingly did, and it was not justified` TRUE TRUE EQUALS `s 43F does not allow waiver on these facts`
#ASSERT `Can the Secretary waive my debt in special circumstances` `no one knowingly made a false statement or failed to comply` FALSE TRUE EQUALS `s 43F does not allow waiver on these facts`

-- ss 43G, 43P.
#ASSERT `May the Secretary stop me leaving Australia` TRUE FALSE TRUE
#ASSERT (NOT `May the Secretary stop me leaving Australia` TRUE TRUE TRUE)
#ASSERT `Must the Secretary give me a departure certificate` TRUE TRUE TRUE FALSE FALSE
#ASSERT (NOT `Must the Secretary give me a departure certificate` FALSE TRUE TRUE FALSE FALSE)
#ASSERT `Must the Secretary give me a departure certificate` FALSE TRUE FALSE TRUE FALSE

-- ---------------------------------------------------------------------------------------------------------------------
-- Review.
#ASSERT `How do I get the decision reviewed` `an officer's decision to recover ABSTUDY, AIC or start-up loan overpayments from me` EQUALS `ask the Secretary for internal review (s 304, no time limit), then apply to the ART (s 311, no time limit, s 312)`
#ASSERT `How do I get the decision reviewed` `the Commissioner's decision to defer or amend my ABSTUDY SSL assessment (s 10K, s 10L)` EQUALS `ask the Commissioner in writing to reconsider within 28 days of being notified, or longer if allowed (s 308F; confirmed if no answer in 45 days), then apply to the ART (s 308H)`
#ASSERT `How do I get the decision reviewed` `a departure prohibition order against me (s 43G)` EQUALS `appeal to the Federal Court or the Federal Circuit and Family Court (Division 2) (s 43U)`
#ASSERT `How do I get the decision reviewed` `a decision on revoking or varying my departure prohibition order, my departure certificate, or security (ss 43L, 43P, 43Q)` EQUALS `apply to the ART (s 43X)`
#ASSERT `How do I get the decision reviewed` `a decision on my claim for an ABSTUDY student start-up loan, or on ABSTUDY Living Allowance` EQUALS `this Act provides no review of that decision`
#ASSERT `By when must I ask the Commissioner to reconsider` (Date 4 3 2027) EQUALS Date 1 4 2027
