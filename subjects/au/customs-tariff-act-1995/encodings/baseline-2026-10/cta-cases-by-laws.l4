IMPORT prelude
IMPORT `cta-by-laws`

-- Customs Tariff Act 1995 Schedule 4 with the Customs By-Laws 2023 -- worked cases, from the importer's seat.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Expected values were written by hand
-- from the deposited texts (the Act's Schedule 4; the By-Laws 2023, Compilation No. 6), never copied from the encoding's
-- output. No scenario life raised this; the facts are the encoder's, HYPOTHETICAL throughout.

-- ---------------------------------------------------------------------------------------------------------------------
-- item 26. Kim orders a $400 jacket online (rate otherwise 5%): prescribed, and Free.
#ASSERT `Are my goods prescribed for item 26` 400 FALSE FALSE FALSE
#ASSERT `Does item 26 make my low-value goods Free` 400 FALSE FALSE FALSE 5 EQUALS `answered` `yes: the item applies, and the goods are Free (ss 8, 18(1), Schedule 4)`
-- Exactly $1,000: less than $1,000.01, Free. $1,000.01: not.
#ASSERT `Are my goods prescribed for item 26` 1000 FALSE FALSE FALSE
#ASSERT (NOT `Are my goods prescribed for item 26` 1000.01 FALSE FALSE FALSE)
#ASSERT `Does item 26 make my low-value goods Free` 1500 FALSE FALSE FALSE 5 EQUALS `answered` `no: the goods are not described in the item (or not prescribed by the by-law it needs) (s 8(1))`
-- A $60 bottle of wine: alcohol, not prescribed. Goods Kim carries in as a passenger: not item 26. Part of a bulk order: not.
#ASSERT (NOT `Are my goods prescribed for item 26` 60 TRUE FALSE FALSE)
#ASSERT (NOT `Are my goods prescribed for item 26` 400 FALSE TRUE FALSE)
#ASSERT (NOT `Are my goods prescribed for item 26` 400 FALSE FALSE TRUE)
-- Goods already Free under Schedule 3: item 26 gives no less duty, so s 18(1) leaves the Free rate standing.
#ASSERT `Does item 26 make my low-value goods Free` 400 FALSE FALSE FALSE 0 EQUALS `answered` `no: the item gives no less duty than the rate that otherwise applies, so it does not apply and that rate stands (s 18(1))`

-- ---------------------------------------------------------------------------------------------------------------------
-- item 37. Dev imports a used sedan (heading 8703, 5 seats) with a written import approval; rate otherwise 10%: 5%.
#ASSERT `Is my car prescribed for item 37` TRUE TRUE FALSE TRUE TRUE
#ASSERT `Does item 37 apply to my used car` TRUE TRUE FALSE TRUE TRUE 10 FALSE EQUALS `answered` `yes: item 37 applies, at 5% of the value (ss 8, 18(1), Schedule 4)`
-- Made in Canada: Free.
#ASSERT `Does item 37 apply to my used car` TRUE TRUE FALSE TRUE TRUE 10 TRUE EQUALS `answered` `yes: the item applies, and the goods are Free (ss 8, 18(1), Schedule 4)`
-- No import approval; or an off-road vehicle; or new: not prescribed.
#ASSERT (NOT `Is my car prescribed for item 37` TRUE TRUE FALSE TRUE FALSE)
#ASSERT (NOT `Is my car prescribed for item 37` TRUE TRUE TRUE TRUE TRUE)
#ASSERT (NOT `Is my car prescribed for item 37` TRUE TRUE FALSE FALSE TRUE)
#ASSERT `Does item 37 apply to my used car` TRUE TRUE FALSE TRUE FALSE 10 FALSE EQUALS `answered` `no: the goods are not described in the item (or not prescribed by the by-law it needs) (s 8(1))`
-- The rate otherwise is 5% (from a free trade schedule): item 37's 5% is no less, so it does not apply.
#ASSERT `Does item 37 apply to my used car` TRUE TRUE FALSE TRUE TRUE 5 FALSE EQUALS `answered` `no: the item gives no less duty than the rate that otherwise applies, so it does not apply and that rate stands (s 18(1))`

-- ---------------------------------------------------------------------------------------------------------------------
-- item 25. A crystal bowl (a household article) won in a golf competition in Fiji: prescribed. A trophy won overseas that is
-- not an office or household article: not. A medal awarded overseas: prescribed. A prize from a donor overseas for a club's
-- non-commercial competition, for display on a stand: prescribed; of an advertising nature: not. Something else: not.
#ASSERT `Is my award prescribed for item 25` `a trophy I won in a competition outside Australia` TRUE FALSE FALSE FALSE
#ASSERT (NOT `Is my award prescribed for item 25` `a trophy I won in a competition outside Australia` FALSE FALSE FALSE FALSE)
#ASSERT `Is my award prescribed for item 25` `a decoration, medallion or certificate awarded to me outside Australia` FALSE FALSE FALSE FALSE
#ASSERT `Is my award prescribed for item 25` `a trophy or prize sent by a donor living outside Australia` FALSE TRUE TRUE FALSE
#ASSERT (NOT `Is my award prescribed for item 25` `a trophy or prize sent by a donor living outside Australia` FALSE TRUE TRUE TRUE)
#ASSERT (NOT `Is my award prescribed for item 25` `a trophy or prize sent by a donor living outside Australia` FALSE FALSE TRUE FALSE)
#ASSERT (NOT `Is my award prescribed for item 25` `something else` TRUE TRUE TRUE FALSE)

-- ---------------------------------------------------------------------------------------------------------------------
-- item 28. A reading machine that turns print into speech: prescribed. Braille tiles designed for the blind: prescribed; not
-- so designed: not. A tape recorder meeting all seven conditions: prescribed; one stereo (not monophonic): not. A wheelchair:
-- not prescribed by these By-Laws.
#ASSERT `Is my aid prescribed for item 28` `a reading machine that converts print into tactile images or speech` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE
#ASSERT `Is my aid prescribed for item 28` `braille tiles or braille road rivets (pedestrian safety equipment)` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE
#ASSERT (NOT `Is my aid prescribed for item 28` `braille tiles or braille road rivets (pedestrian safety equipment)` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
#ASSERT `Is my aid prescribed for item 28` `a sound reproducer and recorder` FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE
#ASSERT (NOT `Is my aid prescribed for item 28` `a sound reproducer and recorder` FALSE TRUE TRUE FALSE TRUE TRUE TRUE TRUE)
#ASSERT (NOT `Is my aid prescribed for item 28` `another aid or appliance` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE)

-- ---------------------------------------------------------------------------------------------------------------------
-- item 17. A field instrument taken to Casey station (Antarctic Territory) for the season and brought back unaltered:
-- prescribed. The same, repaired there: not. A camera taken to Bali and brought back: not prescribed by the By-Laws 2023.
#ASSERT `Are my returned goods prescribed for item 17` `the Australian Antarctic Territory, or Heard Island and McDonald Islands` TRUE TRUE FALSE
#ASSERT (NOT `Are my returned goods prescribed for item 17` `the Australian Antarctic Territory, or Heard Island and McDonald Islands` TRUE FALSE FALSE)
#ASSERT (NOT `Are my returned goods prescribed for item 17` `somewhere else` TRUE TRUE FALSE)
