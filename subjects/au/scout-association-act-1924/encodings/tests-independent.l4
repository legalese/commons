IMPORT prelude
IMPORT `scout-rules`

-- Independent tests, from independent-expectations.md (written before reading the rules).
-- Field order: Lifesaving Scouts, used name, authorised for name,
--   used registered uniform, suggesting connection, proved authority (Association
--   or the Branch for the area), Minister consented.

§ `Independent tests`

GIVEN u IS A `Scout use`
GIVETH A `Scout position`
pos u MEANS `the scout position for` u

-- 1: name used without authority
#ASSERT (pos (`Scout use` OF FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, TRUE))'s `offence under s 2` EQUALS TRUE
#ASSERT (pos (`Scout use` OF FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, TRUE))'s `maximum penalty units` EQUALS 1
-- 2: with authority
#ASSERT (pos (`Scout use` OF FALSE, TRUE, TRUE, FALSE, FALSE, FALSE, TRUE))'s `offence under s 2` EQUALS FALSE
#ASSERT (pos (`Scout use` OF FALSE, TRUE, TRUE, FALSE, FALSE, FALSE, TRUE))'s `maximum penalty units` EQUALS 0
-- 3/4: implied name / Local Branch name, without authority (same input)
#ASSERT (pos (`Scout use` OF FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE))'s `offence under s 2` EQUALS TRUE
-- 5: registered uniform, suggesting authorisation, no authority
#ASSERT (pos (`Scout use` OF FALSE, FALSE, FALSE, TRUE, TRUE, FALSE, TRUE))'s `offence under s 4` EQUALS TRUE
#ASSERT (pos (`Scout use` OF FALSE, FALSE, FALSE, TRUE, TRUE, FALSE, TRUE))'s `maximum penalty units` EQUALS 1
-- 6: uniform not registered
#ASSERT (pos (`Scout use` OF FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, TRUE))'s `offence under s 4` EQUALS FALSE
-- 7: registered, but not used so as to suggest authorisation or connection
#ASSERT (pos (`Scout use` OF FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, TRUE))'s `offence under s 4` EQUALS FALSE
-- 8: authority of the Local Branch for the area
#ASSERT (pos (`Scout use` OF FALSE, FALSE, FALSE, TRUE, TRUE, TRUE, TRUE))'s `offence under s 4` EQUALS FALSE
-- 9/10: authority only of another area's Branch, or authority unproven: proof input FALSE
#ASSERT (pos (`Scout use` OF FALSE, FALSE, TRUE, TRUE, TRUE, FALSE, TRUE))'s `offence under s 4` EQUALS TRUE
-- 11: Lifesaving Scouts of the Salvation Army
#ASSERT (pos (`Scout use` OF TRUE, TRUE, FALSE, TRUE, TRUE, FALSE, TRUE))'s `offence under s 2` EQUALS FALSE
#ASSERT (pos (`Scout use` OF TRUE, TRUE, FALSE, TRUE, TRUE, FALSE, TRUE))'s `offence under s 4` EQUALS FALSE
#ASSERT (pos (`Scout use` OF TRUE, TRUE, FALSE, TRUE, TRUE, FALSE, TRUE))'s `maximum penalty units` EQUALS 0
-- 12: no Minister's consent: cannot be instituted
#ASSERT (pos (`Scout use` OF FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE))'s `prosecution may be instituted` EQUALS FALSE
-- 13: with consent
#ASSERT (pos (`Scout use` OF FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, TRUE))'s `prosecution may be instituted` EQUALS TRUE
-- 14: both offences: 1 unit each, 2 in total
#ASSERT (pos (`Scout use` OF FALSE, TRUE, FALSE, TRUE, TRUE, FALSE, TRUE))'s `offence under s 2` EQUALS TRUE
#ASSERT (pos (`Scout use` OF FALSE, TRUE, FALSE, TRUE, TRUE, FALSE, TRUE))'s `offence under s 4` EQUALS TRUE
#ASSERT (pos (`Scout use` OF FALSE, TRUE, FALSE, TRUE, TRUE, FALSE, TRUE))'s `maximum penalty units` EQUALS 2
