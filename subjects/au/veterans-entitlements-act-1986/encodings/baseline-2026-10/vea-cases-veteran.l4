IMPORT prelude
IMPORT daydate
IMPORT `vea-veteran`

-- Veterans' Entitlements Act 1986 -- worked cases, from the veteran's seat.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Expected values were written by hand from
-- the deposited text (C2026C00275), never copied from the encoding's output. No scenario life raised this Act (REQ-0070 is a
-- scheduled priority-2 entry): the veterans (Ray, a Vietnam veteran; Anne, his wife; Kerry, an allied veteran) and the dates are
-- the encoder's, HYPOTHETICAL. The rates "in force" used below are the printed figures, standing in for the indexed ones.

-- ---------------------------------------------------------------------------------------------------------------------
-- s 12AA: from 1 July 2026, no new Part II claims under the VEA.
#ASSERT `Can I claim this under the VEA` `a disability pension, or an increase in it, for a war-caused injury or disease (Part II)` (Date 15 8 2026) EQUALS `no: from 1 July 2026 this claim cannot be made under the VEA (s 12AA); it is made under the MRCA instead`
#ASSERT `Can I claim this under the VEA` `a disability pension, or an increase in it, for a war-caused injury or disease (Part II)` (Date 30 6 2026) EQUALS `yes: this claim can still be made under the Veterans' Entitlements Act`
#ASSERT `Can I claim this under the VEA` `an age or invalidity service pension (Part III)` (Date 15 8 2026) EQUALS `yes: this claim can still be made under the Veterans' Entitlements Act`
#ASSERT `Can I claim this under the VEA` `a war widow's or widower's pension, or an orphan's pension (Part II)` (Date 15 8 2026) EQUALS `no: from 1 July 2026 this claim cannot be made under the VEA (s 12AA); it is made under the MRCA instead`
#ASSERT `Can I claim this under the VEA` `a verification determination as a reinstated pensioner (Part II Division 2A)` (Date 15 8 2026) EQUALS `yes: this claim can still be made under the Veterans' Entitlements Act`
#ASSERT `Can I claim this under the VEA` `an allowance or benefit under s 111 (other than bereavement payment)` (Date 1 7 2026) EQUALS `no: from 1 July 2026 this claim cannot be made under the VEA (s 12AA); it is made under the MRCA instead`
#ASSERT `Can I claim this under the VEA` `a partner service pension (Part III) or income support supplement (Part IIIA)` (Date 15 8 2026) EQUALS `yes: this claim can still be made under the Veterans' Entitlements Act`

-- s 9A.
#ASSERT `Is my injury the MRCA's, not the VEA's` TRUE TRUE
#ASSERT (NOT `Is my injury the MRCA's, not the VEA's` TRUE FALSE)
#ASSERT (NOT `Is my injury the MRCA's, not the VEA's` FALSE TRUE)

-- ---------------------------------------------------------------------------------------------------------------------
-- s 5QA.
#ASSERT `What is my veteran pension age in months` `a man` (Date 15 8 1947) EQUALS 720
#ASSERT `What is my veteran pension age in months` `a woman` (Date 1 3 1939) EQUALS 660
#ASSERT `What is my veteran pension age in months` `a woman` (Date 1 7 1940) EQUALS 666
#ASSERT `What is my veteran pension age in months` `a woman` (Date 31 12 1941) EQUALS 666
#ASSERT `What is my veteran pension age in months` `a woman` (Date 1 1 1942) EQUALS 672
#ASSERT `What is my veteran pension age in months` `a woman` (Date 30 6 1952) EQUALS 708
#ASSERT `What is my veteran pension age in months` `a woman` (Date 15 3 1953) EQUALS 714
#ASSERT `What is my veteran pension age in months` `a woman` (Date 1 1 1954) EQUALS 720
-- A man born 15 August 1965 reaches 60 on 15 August 2025.
#ASSERT `Have I reached veteran pension age` `a man` (Date 15 8 1965) (Date 15 8 2025)
#ASSERT (NOT `Have I reached veteran pension age` `a man` (Date 15 8 1965) (Date 14 8 2025))
-- A woman born 10 January 1953: 59 years and 6 months on 10 July 2012.
#ASSERT `Have I reached veteran pension age` `a woman` (Date 10 1 1953) (Date 10 7 2012)
#ASSERT (NOT `Have I reached veteran pension age` `a woman` (Date 10 1 1953) (Date 9 7 2012))

-- s 7A.
#ASSERT `Have I rendered qualifying service` FALSE FALSE FALSE TRUE FALSE FALSE
#ASSERT `Have I rendered qualifying service` FALSE FALSE TRUE FALSE FALSE FALSE
#ASSERT (NOT `Have I rendered qualifying service` FALSE FALSE FALSE FALSE FALSE FALSE)

-- s 36. Ray, an Australian Vietnam veteran with qualifying service, past 60.
#ASSERT `Am I eligible for the age service pension` TRUE TRUE `an Australian veteran (Australian Defence Force or Australian mariner)` FALSE 0 0
#ASSERT (NOT `Am I eligible for the age service pension` FALSE TRUE `an Australian veteran (Australian Defence Force or Australian mariner)` FALSE 0 0)
-- Kerry, an allied veteran: 12 continuous years' residence.
#ASSERT `Am I eligible for the age service pension` TRUE TRUE `a Commonwealth veteran, allied veteran or allied mariner only` FALSE 12 12
-- Longest 7 years, total 13: the 10 years shrink by 3 to 7 (s 36(3)).
#ASSERT `Am I eligible for the age service pension` TRUE TRUE `a Commonwealth veteran, allied veteran or allied mariner only` FALSE 7 13
-- Longest 6, total 13: 6 is short of 7.
#ASSERT (NOT `Am I eligible for the age service pension` TRUE TRUE `a Commonwealth veteran, allied veteran or allied mariner only` FALSE 6 13)
-- Longest 4, total 15: the longest is under 5, no reduction.
#ASSERT (NOT `Am I eligible for the age service pension` TRUE TRUE `a Commonwealth veteran, allied veteran or allied mariner only` FALSE 4 15)
-- Longest 7, total exactly 10: the aggregate is not "more than 10 years".
#ASSERT (NOT `Am I eligible for the age service pension` TRUE TRUE `a Commonwealth veteran, allied veteran or allied mariner only` FALSE 7 10)
#ASSERT `Am I eligible for the age service pension` TRUE TRUE `a Commonwealth veteran, allied veteran or allied mariner only` TRUE 2 2

-- s 37.
#ASSERT `Am I eligible for the invalidity service pension` TRUE TRUE `an Australian veteran (Australian Defence Force or Australian mariner)` FALSE 0 0 FALSE
#ASSERT `Am I eligible for the invalidity service pension` TRUE TRUE `a Commonwealth veteran, allied veteran or allied mariner only` FALSE 3 3 TRUE
#ASSERT (NOT `Am I eligible for the invalidity service pension` TRUE TRUE `a Commonwealth veteran, allied veteran or allied mariner only` FALSE 3 3 FALSE)
#ASSERT (NOT `Am I eligible for the invalidity service pension` TRUE FALSE `an Australian veteran (Australian Defence Force or Australian mariner)` FALSE 0 0 FALSE)

-- s 36B. An improper claim on 1 March 2027 while eligible; told on 15 March 2027; 3 months end on 15 June 2027.
#ASSERT `From what day can my age service pension be paid` (Date 20 5 2027) TRUE (Date 1 3 2027) TRUE TRUE (Date 15 3 2027) EQUALS Date 1 3 2027
#ASSERT `From what day can my age service pension be paid` (Date 15 6 2027) TRUE (Date 1 3 2027) TRUE TRUE (Date 15 3 2027) EQUALS Date 1 3 2027
#ASSERT `From what day can my age service pension be paid` (Date 16 6 2027) TRUE (Date 1 3 2027) TRUE TRUE (Date 15 3 2027) EQUALS Date 16 6 2027
-- Never told: the earlier day, however late the proper claim.
#ASSERT `From what day can my age service pension be paid` (Date 1 12 2027) TRUE (Date 1 3 2027) TRUE FALSE (Date 1 1 2000) EQUALS Date 1 3 2027
#ASSERT `From what day can my age service pension be paid` (Date 20 5 2027) TRUE (Date 1 3 2027) FALSE TRUE (Date 15 3 2027) EQUALS Date 20 5 2027
#ASSERT `From what day can my age service pension be paid` (Date 20 5 2027) FALSE (Date 1 1 2000) FALSE FALSE (Date 1 1 2000) EQUALS Date 20 5 2027
-- Told on 30 November 2026: 3 months end on 28 February 2027, the last day of that month.
#ASSERT `From what day can my age service pension be paid` (Date 28 2 2027) TRUE (Date 1 11 2026) TRUE TRUE (Date 30 11 2026) EQUALS Date 1 11 2026
#ASSERT `From what day can my age service pension be paid` (Date 1 3 2027) TRUE (Date 1 11 2026) TRUE TRUE (Date 30 11 2026) EQUALS Date 1 3 2027

-- ---------------------------------------------------------------------------------------------------------------------
-- ss 22-24. Rates "in force" here: general $338.94, EDA $510.40, intermediate $619.80, special $1,595.66.
-- Ray: 80% incapacity, cannot work more than 8 hours, lost his job to it, claimed at 58: the special rate.
#ASSERT `What rate of disability pension am I paid` 80 FALSE `no more than 8 hours a week, because of my war-caused incapacity alone` TRUE TRUE FALSE 58 0 0 338.94 510.40 619.80 1595.66 EQUALS `the special rate (s 24), per fortnight` 1595.66
-- Part-time only: the intermediate rate.
#ASSERT `What rate of disability pension am I paid` 80 FALSE `only part-time or intermittently (under half of full-time hours, or under 20 hours a week), because of it alone` TRUE TRUE FALSE 58 0 0 338.94 510.40 619.80 1595.66 EQUALS `the intermediate rate (s 23), per fortnight` 619.80
-- He can still work: 80% of the general rate, $271.152.
#ASSERT `What rate of disability pension am I paid` 80 FALSE `more than that` TRUE TRUE FALSE 58 0 0 338.94 510.40 619.80 1595.66 EQUALS `the general rate pension (s 22(2)): my degree of incapacity as a percentage of the general rate, per fortnight` 271.152
-- 60% incapacity is under the 70% threshold for TPI: 60% of the general rate, $203.364.
#ASSERT `What rate of disability pension am I paid` 60 FALSE `no more than 8 hours a week, because of my war-caused incapacity alone` TRUE TRUE FALSE 58 0 0 338.94 510.40 619.80 1595.66 EQUALS `the general rate pension (s 22(2)): my degree of incapacity as a percentage of the general rate, per fortnight` 203.364
-- Blinded in both eyes: the special rate whatever the percentage (s 24(3)).
#ASSERT `What rate of disability pension am I paid` 40 TRUE `more than that` FALSE TRUE FALSE 58 0 0 338.94 510.40 619.80 1595.66 EQUALS `the special rate (s 24), per fortnight` 1595.66
-- 100%, aged 70, 75 impairment and 6 lifestyle points: the extreme disablement adjustment.
#ASSERT `What rate of disability pension am I paid` 100 FALSE `more than that` FALSE FALSE FALSE 70 75 6 338.94 510.40 619.80 1595.66 EQUALS `the extreme disablement adjustment rate (s 22(4)), per fortnight` 510.40
-- 100% at 64: not yet 65, so the general rate in full.
#ASSERT `What rate of disability pension am I paid` 100 FALSE `more than that` FALSE TRUE FALSE 64 75 6 338.94 510.40 619.80 1595.66 EQUALS `the general rate pension (s 22(2)): my degree of incapacity as a percentage of the general rate, per fortnight` 338.94
-- Claimed at 66 after working past 65, 10 years' continuous work begun before 65: special rate (s 24(2A)).
#ASSERT `What rate of disability pension am I paid` 80 FALSE `no more than 8 hours a week, because of my war-caused incapacity alone` TRUE FALSE TRUE 66 0 0 338.94 510.40 619.80 1595.66 EQUALS `the special rate (s 24), per fortnight` 1595.66
#ASSERT `What rate of disability pension am I paid` 80 FALSE `no more than 8 hours a week, because of my war-caused incapacity alone` TRUE FALSE FALSE 66 0 0 338.94 510.40 619.80 1595.66 EQUALS `the general rate pension (s 22(2)): my degree of incapacity as a percentage of the general rate, per fortnight` 271.152
-- Not stopped from work by the incapacity: no TPI.
#ASSERT `What rate of disability pension am I paid` 80 FALSE `no more than 8 hours a week, because of my war-caused incapacity alone` FALSE TRUE FALSE 58 0 0 338.94 510.40 619.80 1595.66 EQUALS `the general rate pension (s 22(2)): my degree of incapacity as a percentage of the general rate, per fortnight` 271.152
-- 100%, aged 70, TPI conditions met (claimed before 65): the special rate, not the EDA (s 22(4)(d)).
#ASSERT `What rate of disability pension am I paid` 100 FALSE `no more than 8 hours a week, because of my war-caused incapacity alone` TRUE TRUE FALSE 70 75 6 338.94 510.40 619.80 1595.66 EQUALS `the special rate (s 24), per fortnight` 1595.66

-- ss 13A, 30(1). Ray, on the special rate, dies on 10 September 2026: Anne's pension is paid from 11 September 2026.
#ASSERT `Do I get a war widow's pension without claiming` TRUE (Date 10 9 2026) EQUALS `paid automatically, without a claim, from the day after the veteran died (s 13A)` (Date 11 9 2026)
#ASSERT `Do I get a war widow's pension without claiming` FALSE (Date 10 9 2026) EQUALS `not automatic under s 13A; from 1 July 2026 a claim for it is made under the MRCA, not this Act (s 12AA)`
#ASSERT `Do I get a war widow's pension without claiming` FALSE (Date 10 3 2025) EQUALS `not automatic under s 13A; a claim under s 14 was possible before 1 July 2026`
-- An annual MBR of $31,200: $1,200 a fortnight, plus $35 and $25.60: $1,260.60.
#ASSERT `What is my war widow's pension a fortnight` 31200 35 25.6 EQUALS 1260.6

-- s 54.
#ASSERT `What is the latest day to report a change` (Date 3 3 2027) FALSE 0 EQUALS Date 17 3 2027
#ASSERT `What is the latest day to report a change` (Date 3 3 2027) TRUE 21 EQUALS Date 24 3 2027
#ASSERT `What is the latest day to report a change` (Date 3 3 2027) TRUE 40 EQUALS Date 31 3 2027

-- Review.
#ASSERT `How can I seek review of my veterans' pension decision` `a decision about my service pension, income support supplement or veteran payment` (Date 15 11 2026) EQUALS `ask the Repatriation Commission in writing, with grounds, lodged at a Department office in Australia, within 3 months after I was notified (s 57A); then the ART (s 175(2)). Last day:` (Date 15 2 2027)
#ASSERT `How can I seek review of my veterans' pension decision` `a decision about the rate of my disability pension, or cancelling or suspending it` (Date 31 8 2026) EQUALS `apply to the Veterans' Review Board under Chapter 8 of the MRCA within 3 months after I was served with the decision, but not later (s 135(5)). Last day:` (Date 30 11 2026)
