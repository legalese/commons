IMPORT prelude
IMPORT daydate
IMPORT `dom-rules`

-- Independent tests: expected values decided from the source text before
-- reading dom-rules.l4 (see independent-expectations.md).

-- Base: adult born 1950, unmarried, capable, home with neither, not adopted.
`base` MEANS `Domicile case` OF (Date 1 1 2020), (Date 1 1 1950), FALSE, FALSE, `with neither parent`, FALSE, TRUE, FALSE, `not adopted`, FALSE, FALSE, FALSE, FALSE

-- A child aged 10 (born 2010), unmarried, given home/separation/other-living/died
GIVEN h IS A `Principal home`
      sep IS A BOOLEAN
      other IS A BOOLEAN
      dead IS A BOOLEAN
      ad IS AN `Adoption`
      resc IS A BOOLEAN
GIVETH A `Domicile case`
`kid` h sep other dead ad resc MEANS
    `Domicile case` OF (Date 1 1 2020), (Date 1 1 2010), FALSE, FALSE, h, sep, other, dead, ad, resc, FALSE, FALSE, FALSE

-- 1: day before commencement
#ASSERT `may I have a domicile of my own` (`Domicile case` OF (Date 30 6 1982), (Date 1 1 1950), FALSE, FALSE, `with neither parent`, FALSE, TRUE, FALSE, `not adopted`, FALSE, FALSE, FALSE, FALSE) EQUALS NOTHING
-- 2: commencement day
#ASSERT `may I have a domicile of my own` (`Domicile case` OF (Date 1 7 1982), (Date 1 1 1950), FALSE, FALSE, `with neither parent`, FALSE, TRUE, FALSE, `not adopted`, FALSE, FALSE, FALSE, FALSE) EQUALS JUST TRUE
-- 3: day before 18th birthday
#ASSERT `may I have a domicile of my own` (`Domicile case` OF (Date 14 3 2020), (Date 15 3 2002), FALSE, FALSE, `with neither parent`, FALSE, TRUE, FALSE, `not adopted`, FALSE, FALSE, FALSE, FALSE) EQUALS JUST FALSE
#ASSERT `I am a child` (`Domicile case` OF (Date 14 3 2020), (Date 15 3 2002), FALSE, FALSE, `with neither parent`, FALSE, TRUE, FALSE, `not adopted`, FALSE, FALSE, FALSE, FALSE)
-- 4: 18th birthday
#ASSERT `may I have a domicile of my own` (`Domicile case` OF (Date 15 3 2020), (Date 15 3 2002), FALSE, FALSE, `with neither parent`, FALSE, TRUE, FALSE, `not adopted`, FALSE, FALSE, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT NOT (`I am a child` (`Domicile case` OF (Date 15 3 2020), (Date 15 3 2002), FALSE, FALSE, `with neither parent`, FALSE, TRUE, FALSE, `not adopted`, FALSE, FALSE, FALSE, FALSE))
-- 5/6: 16, married or previously married
#ASSERT `may I have a domicile of my own` (`Domicile case` OF (Date 1 1 2020), (Date 1 1 2004), TRUE, FALSE, `with neither parent`, FALSE, TRUE, FALSE, `not adopted`, FALSE, FALSE, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT NOT (`I am a child` (`Domicile case` OF (Date 1 1 2020), (Date 1 1 2004), TRUE, FALSE, `with neither parent`, FALSE, TRUE, FALSE, `not adopted`, FALSE, FALSE, FALSE, FALSE))
-- 7: mental incapacity
#ASSERT `may I have a domicile of my own` (`Domicile case` OF (Date 1 1 2020), (Date 1 1 1990), FALSE, TRUE, `with neither parent`, FALSE, TRUE, FALSE, `not adopted`, FALSE, FALSE, FALSE, FALSE) EQUALS NOTHING
-- 8: one parent, separated
#ASSERT `whose domicile I take as a child` (`kid` `with one of my parents` TRUE TRUE FALSE `not adopted` FALSE) EQUALS JUST `the domicile the parent I live with has from time to time`
-- 9: one parent, living together, other alive
#ASSERT `whose domicile I take as a child` (`kid` `with one of my parents` FALSE TRUE FALSE `not adopted` FALSE) EQUALS NOTHING
-- 10: one parent, other parent dead
#ASSERT `whose domicile I take as a child` (`kid` `with one of my parents` FALSE FALSE FALSE `not adopted` FALSE) EQUALS JUST `the domicile the parent I live with has from time to time`
-- 11: both parents
#ASSERT `whose domicile I take as a child` (`kid` `with both of my parents` TRUE TRUE FALSE `not adopted` FALSE) EQUALS NOTHING
-- 12: neither parent
#ASSERT `whose domicile I take as a child` (`kid` `with neither parent` TRUE TRUE FALSE `not adopted` FALSE) EQUALS NOTHING
-- 13: followed parent died
#ASSERT `whose domicile I take as a child` (`kid` `with one of my parents` TRUE TRUE TRUE `not adopted` FALSE) EQUALS JUST `the domicile that parent had at death`
-- 14: adopted by 2
#ASSERT `whose domicile I take as a child` (`kid` `with both of my parents` FALSE TRUE FALSE `adopted by 2 parents` FALSE) EQUALS JUST `the domicile I would have if born in wedlock to my adoptive parents`
-- 15: adopted by 1
#ASSERT `whose domicile I take as a child` (`kid` `with one of my parents` FALSE FALSE FALSE `adopted by 1 parent only` FALSE) EQUALS JUST `the domicile my sole adoptive parent has from time to time`
-- 15b: adopted by 1, principal home recorded as with neither (s 9(1) cannot apply)
#ASSERT `whose domicile I take as a child` (`kid` `with neither parent` FALSE FALSE FALSE `adopted by 1 parent only` FALSE) EQUALS JUST `the domicile my sole adoptive parent has from time to time`
-- 16: adopted by 1, rescinded
#ASSERT `whose domicile I take as a child` (`kid` `with one of my parents` FALSE FALSE FALSE `adopted by 1 parent only` TRUE) EQUALS JUST `as the rescission order provides, otherwise as if I had not been adopted`
-- 17: aged 19, had s 9 domicile, no domicile of choice
#ASSERT `do I keep my domicile from childhood` (`Domicile case` OF (Date 1 1 2020), (Date 1 1 2001), FALSE, FALSE, `with neither parent`, FALSE, TRUE, FALSE, `not adopted`, FALSE, TRUE, FALSE, FALSE) EQUALS JUST TRUE
-- 18: aged 19, no s 9 domicile on ceasing to be child (low confidence: JUST FALSE vs NOTHING)
#ASSERT `do I keep my domicile from childhood` (`Domicile case` OF (Date 1 1 2020), (Date 1 1 2001), FALSE, FALSE, `with neither parent`, FALSE, TRUE, FALSE, `not adopted`, FALSE, FALSE, FALSE, FALSE) EQUALS JUST FALSE
-- 19-21: domicile of choice, adult
#ASSERT `have I acquired a domicile of choice` (`Domicile case` OF (Date 1 1 2020), (Date 1 1 1950), FALSE, FALSE, `with neither parent`, FALSE, TRUE, FALSE, `not adopted`, FALSE, FALSE, TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `have I acquired a domicile of choice` (`Domicile case` OF (Date 1 1 2020), (Date 1 1 1950), FALSE, FALSE, `with neither parent`, FALSE, TRUE, FALSE, `not adopted`, FALSE, FALSE, TRUE, FALSE) EQUALS JUST FALSE
#ASSERT `have I acquired a domicile of choice` (`Domicile case` OF (Date 1 1 2020), (Date 1 1 1950), FALSE, FALSE, `with neither parent`, FALSE, TRUE, FALSE, `not adopted`, FALSE, FALSE, FALSE, TRUE) EQUALS JUST FALSE
-- 22: child (15) resides and intends
#ASSERT `have I acquired a domicile of choice` (`Domicile case` OF (Date 1 1 2020), (Date 1 1 2005), FALSE, FALSE, `with neither parent`, FALSE, TRUE, FALSE, `not adopted`, FALSE, FALSE, TRUE, TRUE) EQUALS JUST FALSE
-- 23/24: husband's domicile
#ASSERT `does my domicile follow my husband's` (`Domicile case` OF (Date 1 1 2020), (Date 1 1 1950), TRUE, FALSE, `with neither parent`, FALSE, TRUE, FALSE, `not adopted`, FALSE, FALSE, FALSE, FALSE) EQUALS JUST FALSE
#ASSERT `does my domicile follow my husband's` (`Domicile case` OF (Date 1 1 1980), (Date 1 1 1950), TRUE, FALSE, `with neither parent`, FALSE, TRUE, FALSE, `not adopted`, FALSE, FALSE, FALSE, FALSE) EQUALS NOTHING
-- 25: revival
#ASSERT `does my domicile of origin revive` base EQUALS JUST FALSE
-- top-level goal agrees
#ASSERT (`the domicile position for` base)'s `I may have a domicile of my own` EQUALS JUST TRUE
