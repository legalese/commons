IMPORT prelude
IMPORT `fwr-pay`

-- Cases for fwr-pay.l4. Expected values worked by hand from the text (regulation cited).

§ `reg 2.12A -- deduction authorisations`

-- Arguments: saved by cl 90; multiple or ongoing; purpose; dates; recipient; specified amounts; states amounts.
#ASSERT `Does my deduction authorisation include what is required` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `Does my deduction authorisation include what is required` FALSE FALSE TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- No purpose stated, (1)(a).
#ASSERT `Does my deduction authorisation include what is required` FALSE FALSE FALSE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
-- No recipient named, (1)(c).
#ASSERT `Does my deduction authorisation include what is required` FALSE FALSE TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- Ongoing deductions of specified amounts without the amounts, (2)(b).
#ASSERT `Does my deduction authorisation include what is required` FALSE TRUE TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Does my deduction authorisation include what is required` FALSE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- Ongoing deductions not of specified amounts (for example a percentage): (2)(b) does not arise.
#ASSERT `Does my deduction authorisation include what is required` FALSE TRUE TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE

§ `reg 2.12 -- reasonable deductions`

-- Arguments: goods or services from employer; ordinary course; public terms no better; private use costs; variable.
-- A health fund deducting its own premiums on public terms (Example 1).
#ASSERT `Is the deduction reasonable under the regulations` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- Personal calls on a work phone (Example 2 to (2)).
#ASSERT `Is the deduction reasonable under the regulations` FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
-- (3): an amount that may be varied from time to time, with neither (1) nor (2) met.
#ASSERT `Is the deduction reasonable under the regulations` FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
-- (3) is "subject to" (1) and (2): a variable amount for private use costs is still reasonable.
#ASSERT `Is the deduction reasonable under the regulations` FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
-- The public gets better terms, fixed amount: the regulations do not say.
#ASSERT `Is the deduction reasonable under the regulations` TRUE TRUE FALSE FALSE FALSE EQUALS NOTHING

§ `regs 3.45, 3.46(1) -- basic details`

#ASSERT `Does my pay slip show the basic details` TRUE TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`Does my pay slip show the basic details` TRUE TRUE TRUE TRUE TRUE FALSE)
-- Net shown but not gross.
#ASSERT NOT (`Does my pay slip show the basic details` TRUE TRUE TRUE FALSE TRUE TRUE)

§ `reg 3.46(2)-(4) -- deductions and rate`

-- Arguments: deducted; deductions shown; hourly; hourly details; annual; annual rate.
#ASSERT `Does my pay slip show my deductions and rate` FALSE FALSE TRUE TRUE FALSE FALSE
#ASSERT NOT (`Does my pay slip show my deductions and rate` TRUE FALSE TRUE TRUE FALSE FALSE)
#ASSERT NOT (`Does my pay slip show my deductions and rate` FALSE FALSE FALSE FALSE TRUE FALSE)
#ASSERT `Does my pay slip show my deductions and rate` TRUE TRUE FALSE FALSE TRUE TRUE
-- Paid neither hourly nor annually (for example piece rates), no deductions: nothing more needed.
#ASSERT `Does my pay slip show my deductions and rate` FALSE FALSE FALSE FALSE FALSE FALSE

§ `reg 3.46(5)-(6) -- superannuation`

-- Arguments: contributions; amounts shown; fund named; first-pay slip; no chosen fund; ATO not told.
#ASSERT `Does my pay slip show my super` FALSE FALSE FALSE FALSE FALSE FALSE
#ASSERT `Does my pay slip show my super` TRUE TRUE TRUE FALSE FALSE FALSE
-- (5A): first pay slip, no chosen fund, no stapled fund word from the ATO yet: the fund name can be left off.
#ASSERT `Does my pay slip show my super` TRUE TRUE FALSE TRUE TRUE TRUE
-- The ATO has already told the employer: the name is needed.
#ASSERT NOT (`Does my pay slip show my super` TRUE TRUE FALSE TRUE TRUE FALSE)
-- Not the first-pay slip: the name is needed.
#ASSERT NOT (`Does my pay slip show my super` TRUE TRUE FALSE FALSE TRUE TRUE)
#ASSERT NOT (`Does my pay slip show my super` TRUE FALSE TRUE FALSE FALSE FALSE)

§ `regs 3.47, 3.48 -- family and domestic violence leave`

-- Arguments: labelled as such leave; balance shown; reported as leave; asked for another kind of leave.
#ASSERT NOT (`Does my pay slip wrongly show family and domestic violence leave` FALSE FALSE FALSE FALSE)
#ASSERT `Does my pay slip wrongly show family and domestic violence leave` FALSE TRUE FALSE FALSE
#ASSERT `Does my pay slip wrongly show family and domestic violence leave` TRUE FALSE FALSE FALSE
#ASSERT `Does my pay slip wrongly show family and domestic violence leave` FALSE FALSE TRUE FALSE
-- Reported as annual leave because the employee asked (3.48(3)).
#ASSERT NOT (`Does my pay slip wrongly show family and domestic violence leave` FALSE FALSE TRUE TRUE)

§ `reg 2.03A -- a casual loading set off against a claim`

-- Arguments: employed as a casual; identifiable loading; in fact not casual; claiming in lieu of NES entitlements.
-- (1)(a)-(d) all met: (2) lets the employer claim the set-off.
#ASSERT `Can my employer claim to offset my casual loading` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- The loading was not clearly identifiable, (1)(b): the regulation does not apply and says nothing (F14).
#ASSERT `Can my employer claim to offset my casual loading` TRUE FALSE TRUE TRUE EQUALS NOTHING
-- Truly a casual throughout, (1)(c).
#ASSERT `Can my employer claim to offset my casual loading` TRUE TRUE FALSE TRUE EQUALS NOTHING
-- No claim made yet, (1)(d).
#ASSERT `Can my employer claim to offset my casual loading` TRUE TRUE TRUE FALSE EQUALS NOTHING
