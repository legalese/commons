IMPORT prelude
IMPORT `fwr-claims`

-- Cases for fwr-claims.l4. Expected values worked by hand from the text (regulation cited). Edges: 24 hours and 30; an
-- absence of exactly 3 months and one day more; a fee ratio whose fourth decimal place is 5; a fee result ending in 5
-- cents; a discontinuance 3 days and 2 days before the listed date.

§ `reg 3.01 -- s 352 absence`

-- Arguments: certificate given; hours; longer period reasonable; instrument requires; complied; paid-leave evidence;
-- absence start; absence end or dismissal; total over 3 months in 12; on paid leave throughout; workers compensation.
#ASSERT `Was my illness or injury protected under s 352` TRUE 20 FALSE FALSE FALSE FALSE (Date 1 3 2026) (Date 10 3 2026) FALSE FALSE FALSE EQUALS JUST TRUE
-- Exactly 24 hours is "within 24 hours".
#ASSERT `Was my illness or injury protected under s 352` TRUE 24 FALSE FALSE FALSE FALSE (Date 1 3 2026) (Date 10 3 2026) FALSE FALSE FALSE EQUALS JUST TRUE
-- 30 hours, no reason for the delay, no other route: the regulation does not say.
#ASSERT `Was my illness or injury protected under s 352` TRUE 30 FALSE FALSE FALSE FALSE (Date 1 3 2026) (Date 10 3 2026) FALSE FALSE FALSE EQUALS NOTHING
-- 30 hours, but that longer period was reasonable.
#ASSERT `Was my illness or injury protected under s 352` TRUE 30 TRUE FALSE FALSE FALSE (Date 1 3 2026) (Date 10 3 2026) FALSE FALSE FALSE EQUALS JUST TRUE
-- (3): the award required notice and substantiation and the employee complied.
#ASSERT `Was my illness or injury protected under s 352` FALSE 0 FALSE TRUE TRUE FALSE (Date 1 3 2026) (Date 10 3 2026) FALSE FALSE FALSE EQUALS JUST TRUE
-- (4): evidence for paid personal leave.
#ASSERT `Was my illness or injury protected under s 352` FALSE 0 FALSE FALSE FALSE TRUE (Date 1 3 2026) (Date 10 3 2026) FALSE FALSE FALSE EQUALS JUST TRUE
-- Exactly 3 months (1 March to 1 June) is not "more than 3 months".
#ASSERT `Was my illness or injury protected under s 352` TRUE 20 FALSE FALSE FALSE FALSE (Date 1 3 2026) (Date 1 6 2026) FALSE FALSE FALSE EQUALS JUST TRUE
-- One day more, not on paid personal leave: (5) says it is not a prescribed kind.
#ASSERT `Was my illness or injury protected under s 352` TRUE 20 FALSE FALSE FALSE FALSE (Date 1 3 2026) (Date 2 6 2026) FALSE FALSE FALSE EQUALS JUST FALSE
-- On paid personal leave for the whole absence: (5)(b) fails, so the exclusion does not apply.
#ASSERT `Was my illness or injury protected under s 352` TRUE 20 FALSE FALSE FALSE FALSE (Date 1 3 2026) (Date 2 6 2026) FALSE TRUE FALSE EQUALS JUST TRUE
-- (6): leave while on workers compensation is not paid personal leave, so the exclusion applies.
#ASSERT `Was my illness or injury protected under s 352` TRUE 20 FALSE FALSE FALSE FALSE (Date 1 3 2026) (Date 2 6 2026) FALSE TRUE TRUE EQUALS JUST FALSE
-- Absences totalling more than 3 months in 12, (5)(a)(ii).
#ASSERT `Was my illness or injury protected under s 352` TRUE 20 FALSE FALSE FALSE FALSE (Date 1 3 2026) (Date 10 3 2026) TRUE FALSE FALSE EQUALS JUST FALSE

§ `reg 6.04 -- s 772 absence`

-- Arguments as for s 352 without the paid-leave evidence.
#ASSERT `Was my illness or injury protected under s 772` TRUE 20 FALSE FALSE FALSE (Date 1 3 2026) (Date 10 3 2026) FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Was my illness or injury protected under s 772` FALSE 0 FALSE FALSE FALSE (Date 1 3 2026) (Date 10 3 2026) FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `Was my illness or injury protected under s 772` TRUE 20 FALSE FALSE FALSE (Date 30 11 2025) (Date 1 3 2026) FALSE FALSE FALSE EQUALS JUST FALSE
-- 30 November to 28 February is exactly 3 months (the month end clamps): not more.
#ASSERT `Was my illness or injury protected under s 772` TRUE 20 FALSE FALSE FALSE (Date 30 11 2025) (Date 28 2 2026) FALSE FALSE FALSE EQUALS JUST TRUE

§ `the fees`

#ASSERT `What was the starting application fee` `an unfair dismissal remedy (Part 3-2)` EQUALS 59.50
#ASSERT `What was the starting application fee` `a general protections dismissal dispute (s 365)` EQUALS 59.50
#ASSERT `What was the starting application fee` `a stop bullying order (s 789FC)` EQUALS 65.50
#ASSERT `What was the starting application fee` `an unfair deactivation or termination remedy (s 536LU)` EQUALS 87.20
#ASSERT `the year the starting fee applies to` `a review of a services contract (s 536ND)` EQUALS 2024
#ASSERT `the year the starting fee applies to` `an unlawful termination dispute (s 773)` EQUALS 2009
-- Factor 1.0384 rounds to 1.038; 59.50 x 1.038 = 61.761, to the nearest 10 cents 61.80.
#ASSERT `What is this year's application fee` 59.50 1.0384 EQUALS 61.8
-- Factor 1.0235: fourth place 5, so 1.024; 100 x 1.024 = 102.40.
#ASSERT `What is this year's application fee` 100 1.0235 EQUALS 102.4
#ASSERT `What is this year's application fee` 100 1.02349 EQUALS 102.3
-- 50 x 1.001 = 50.05, ends in 5 cents: up to 50.10.
#ASSERT `What is this year's application fee` 50 1.001 EQUALS 50.1
-- 40 x 1.001 = 40.04: down to 40.00.
#ASSERT `What is this year's application fee` 40 1.001 EQUALS 40
-- A falling CPI gives a factor below 1, and the fee falls (the fee regulations set no floor).
#ASSERT `What is this year's application fee` 100 0.99 EQUALS 99
#ASSERT `How much application fee must I pay` 90.30 TRUE EQUALS 0
#ASSERT `How much application fee must I pay` 90.30 FALSE EQUALS 90.30

§ `the refund`

-- Arguments: application; paid; discontinued; conference; conciliation; hearing; day discontinued; earliest listed day.
#ASSERT `Must my fee be repaid` `a general protections dismissal dispute (s 365)` TRUE TRUE FALSE FALSE FALSE (Date 10 3 2026) (Date 10 3 2026) EQUALS JUST TRUE
-- Conference on 13 March, discontinued 10 March: two clear days (11, 12).
#ASSERT `Must my fee be repaid` `a general protections dismissal dispute (s 365)` TRUE TRUE TRUE FALSE FALSE (Date 10 3 2026) (Date 13 3 2026) EQUALS JUST TRUE
-- Discontinued 11 March: one clear day only.
#ASSERT `Must my fee be repaid` `a general protections dismissal dispute (s 365)` TRUE TRUE TRUE FALSE FALSE (Date 11 3 2026) (Date 13 3 2026) EQUALS JUST FALSE
-- Reg 3.02 counts only a conference listing: listed only for a hearing, it has "not yet been listed for conducting a
-- conference", so the fee comes back even on the day before.
#ASSERT `Must my fee be repaid` `a general protections dismissal dispute (s 365)` TRUE TRUE FALSE FALSE TRUE (Date 12 3 2026) (Date 13 3 2026) EQUALS JUST TRUE
-- Unfair dismissal (reg 3.07(8), "a circumstance"): late discontinuance is not a "no" from the text.
#ASSERT `Must my fee be repaid` `an unfair dismissal remedy (Part 3-2)` TRUE TRUE FALSE TRUE FALSE (Date 11 3 2026) (Date 13 3 2026) EQUALS NOTHING
#ASSERT `Must my fee be repaid` `an unfair dismissal remedy (Part 3-2)` TRUE TRUE FALSE TRUE FALSE (Date 10 3 2026) (Date 13 3 2026) EQUALS JUST TRUE
-- Stop bullying (reg 6.07A(8)): once listed for a conference or hearing, no refund however early.
#ASSERT `Must my fee be repaid` `a stop bullying order (s 789FC)` TRUE TRUE TRUE FALSE FALSE (Date 1 3 2026) (Date 13 3 2026) EQUALS JUST FALSE
#ASSERT `Must my fee be repaid` `a stop bullying order (s 789FC)` TRUE TRUE FALSE FALSE FALSE (Date 1 3 2026) (Date 13 3 2026) EQUALS JUST TRUE
-- Unfair deactivation (reg 3A.03(8)): a hearing listing counts.
#ASSERT `Must my fee be repaid` `an unfair deactivation or termination remedy (s 536LU)` TRUE TRUE FALSE FALSE TRUE (Date 10 3 2026) (Date 13 3 2026) EQUALS JUST TRUE
#ASSERT `Must my fee be repaid` `an unfair deactivation or termination remedy (s 536LU)` TRUE TRUE FALSE FALSE TRUE (Date 12 3 2026) (Date 13 3 2026) EQUALS JUST FALSE
-- No fee paid (for example waived for hardship), or not discontinued.
#ASSERT `Must my fee be repaid` `a general protections dismissal dispute (s 365)` FALSE TRUE FALSE FALSE FALSE (Date 10 3 2026) (Date 10 3 2026) EQUALS JUST FALSE
#ASSERT `Must my fee be repaid` `an unlawful termination dispute (s 773)` TRUE FALSE FALSE FALSE FALSE (Date 10 3 2026) (Date 10 3 2026) EQUALS JUST FALSE
#ASSERT `How much fee must be repaid` `a general protections dismissal dispute (s 365)` 90.30 TRUE FALSE FALSE FALSE (Date 10 3 2026) (Date 10 3 2026) EQUALS JUST 90.30
#ASSERT `How much fee must be repaid` `a general protections dismissal dispute (s 365)` 0 TRUE FALSE FALSE FALSE (Date 10 3 2026) (Date 10 3 2026) EQUALS JUST 0
#ASSERT `How much fee must be repaid` `an unfair dismissal remedy (Part 3-2)` 90.30 TRUE TRUE FALSE FALSE (Date 11 3 2026) (Date 13 3 2026) EQUALS NOTHING
-- The FWC's duty: repaying the amount of the fee fulfils it.
#ASSERT EVALTRACE (`the FWC's duty to repay the fee` 90.30) 0 (LIST (EVENT `the FWC` (`repay the fee` 90.30) 5)) EQUALS FULFILLED
-- The text sets no time for the repayment, so a late repayment still fulfils it (no WITHIN).
#ASSERT EVALTRACE (`the FWC's duty to repay the fee` 90.30) 0 (LIST (EVENT `the FWC` (`repay the fee` 90.30) 400)) EQUALS FULFILLED
-- Repaying less does not: the trace is left with the duty still owed (shown, not asserted; the stable l4 cannot compare
-- a residual).
#TRACE `the FWC's duty to repay the fee` 90.30 AT 0 WITH
    PARTY `the FWC` DOES `repay the fee` 50 AT 5

§ `reg 3.29A -- defence members`

-- Arguments: defence member then; a respondent not one then; a respondent not one now; review outcome; not eligible for
-- Part 7; respondent would run the process.
#ASSERT `Can I apply for a stop sexual harassment order as a defence member` FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `Can I apply for a stop sexual harassment order as a defence member` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Can I apply for a stop sexual harassment order as a defence member` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- The respondent has since left the Defence Force (2)(b).
#ASSERT `Can I apply for a stop sexual harassment order as a defence member` TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Can I apply for a stop sexual harassment order as a defence member` TRUE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Can I apply for a stop sexual harassment order as a defence member` TRUE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Can I apply for a stop sexual harassment order as a defence member` TRUE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE

§ `reg 4.01 -- small claims`

-- Arguments: court rules prescribe; endorsed; separate paper; served papers; served separate paper.
#ASSERT `Have I asked for the small claims procedure properly` TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `Have I asked for the small claims procedure properly` FALSE TRUE FALSE TRUE FALSE EQUALS JUST TRUE
-- Endorsed but not served on every party, (1)(b).
#ASSERT `Have I asked for the small claims procedure properly` FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- A separate paper lodged but not served with the papers.
#ASSERT `Have I asked for the small claims procedure properly` FALSE FALSE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Have I asked for the small claims procedure properly` FALSE FALSE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Have I asked for the small claims procedure properly` FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Can an industrial association official represent me` `the Federal Circuit and Family Court (Division 2)` TRUE FALSE
#ASSERT `Can an industrial association official represent me` `a magistrates court` TRUE TRUE
#ASSERT NOT (`Can an industrial association official represent me` `a magistrates court` TRUE FALSE)
#ASSERT NOT (`Can an industrial association official represent me` `the Federal Circuit and Family Court (Division 2)` FALSE TRUE)

§ `regs 6.01A, 6.01B -- other proceedings`

#ASSERT `Are my other proceedings specified` TRUE TRUE `the Owner-Drivers (Contracts and Disputes) Act 2007 (WA)`
#ASSERT `Are my other proceedings specified` TRUE TRUE `Chapter 6 of the Industrial Relations Act 1996 (NSW)`
#ASSERT NOT (`Are my other proceedings specified` TRUE TRUE `some other law`)
-- Started by someone else (for example a union not acting for you), (a).
#ASSERT NOT (`Are my other proceedings specified` FALSE TRUE `the Owner Drivers and Forestry Contractors Act 2005 (Vic)`)
#ASSERT NOT (`Are my other proceedings specified` TRUE FALSE `Chapter 10A of the Industrial Relations Act 2016 (Qld)`)

§ `reg 1.07 -- examples of serious misconduct`

-- Arguments: employee; (a) wilful; (b) serious risk; (c) theft etc.; impaired; only a lawfully directed drug; unfit;
-- (e) refused instruction; can show (3).
-- (2)(a): wilful or deliberate behaviour.
#ASSERT `Is my conduct an example of serious misconduct` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- (2)(c) theft, but the employee shows (3): (c) does not apply; outside the examples, ordinary meaning (F13).
#ASSERT `Is my conduct an example of serious misconduct` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE TRUE EQUALS NOTHING
-- (2)(c) theft, (3) not shown.
#ASSERT `Is my conduct an example of serious misconduct` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- (4)(c) for an employee-like worker: (3) is for employees only, so showing it does not take the example away.
#ASSERT `Is my conduct an example of serious misconduct` FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- (2)(b) is not touched by (3).
#ASSERT `Is my conduct an example of serious misconduct` TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- (6): impaired by alcohol and unfit: intoxicated, (2)(d).
#ASSERT `Is my conduct an example of serious misconduct` TRUE FALSE FALSE FALSE TRUE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- (6): impaired only by a lawfully prescribed drug taken as directed: not taken to be intoxicated.
#ASSERT `Is my conduct an example of serious misconduct` TRUE FALSE FALSE FALSE TRUE TRUE TRUE FALSE FALSE EQUALS NOTHING
-- (6): impaired but not unfit for duty: not taken to be intoxicated.
#ASSERT `Is my conduct an example of serious misconduct` TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- (5)(e) for a road transport contractor: refusing a lawful and reasonable instruction.
#ASSERT `Is my conduct an example of serious misconduct` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
-- Nothing among the examples.
#ASSERT `Is my conduct an example of serious misconduct` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING

§ `reg 6.01C -- other services contract proceedings`

-- An unfair contract term declaration under s 250 of the ACL about the same contract.
#ASSERT `Are my other services contract proceedings specified` TRUE TRUE
-- Proceedings under some other provision (for example a State law, which is paragraph (a), not (b)).
#ASSERT NOT (`Are my other services contract proceedings specified` TRUE FALSE)
-- ACL proceedings about a different contract.
#ASSERT NOT (`Are my other services contract proceedings specified` FALSE TRUE)
