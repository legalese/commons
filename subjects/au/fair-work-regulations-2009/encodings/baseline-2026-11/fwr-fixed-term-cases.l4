IMPORT prelude
IMPORT `fwr-fixed-term`

-- Cases for fwr-fixed-term.l4. Expected values worked by hand from the text (regulation cited). Edges: a ratio whose
-- fourth decimal place is 5; earnings exactly at the threshold; the commencement days (6 December 2023, 1 November
-- 2024) and the last day of the window (31 October 2026); revenue exactly at each limit; 5 years and 7 years.

§ `reg 2.14 -- the part-time or part-year threshold`

-- No award hours and no comparable employees: 38 x 52 = 1,976 full-time hours (finding 4). 988 / 1976 = 0.5;
-- 0.5 x 183,100 = 91,550.
#ASSERT `What is my fixed term contract's high income threshold` 988 0 0 183100 EQUALS 91550
-- Award hours 1,900: 1000 / 1900 = 0.526315..., rounded 0.526; 0.526 x 183,100 = 96,310.60 (no rounding of the product).
#ASSERT `What is my fixed term contract's high income threshold` 1000 1900 0 183100 EQUALS 96310.6
-- Comparable employees' 2,000 hours: 1001 / 2000 = 0.5005, fourth place 5, so 0.501; x 183,100 = 91,733.10.
#ASSERT `What is my fixed term contract's high income threshold` 1001 0 2000 183100 EQUALS 91733.1
-- The award hours win over the comparable employees' hours (4)(a) before (b): 950 / 1900 = 0.5.
#ASSERT `What is my fixed term contract's high income threshold` 950 1900 2000 183100 EQUALS 91550

§ `s 333F(1)(e) with reg 2.14`

#ASSERT `Am I above the high income threshold for my fixed term contract` 95000 TRUE 988 0 0 183100
-- Exactly at the prorated 91,550: not "above".
#ASSERT NOT (`Am I above the high income threshold for my fixed term contract` 91550 TRUE 988 0 0 183100)
#ASSERT `Am I above the high income threshold for my fixed term contract` 91550.01 TRUE 988 0 0 183100
-- Full-time for the whole year: the full threshold.
#ASSERT NOT (`Am I above the high income threshold for my fixed term contract` 183100 FALSE 1976 0 0 183100)
#ASSERT `Am I above the high income threshold for my fixed term contract` 183101 FALSE 1976 0 0 183100

§ `reg 2.15(1) -- sport`

#ASSERT `Is my sport contract outside the limits` `an athlete in an organised sport` `a recognised National Sporting Organisation` (Date 6 12 2023)
#ASSERT NOT (`Is my sport contract outside the limits` `an athlete in an organised sport` `a recognised National Sporting Organisation` (Date 5 12 2023))
#ASSERT `Is my sport contract outside the limits` `a match official for an organised sport` `a member or affiliate of one of those bodies` (Date 1 2 2025)
#ASSERT NOT (`Is my sport contract outside the limits` `none of these` `a recognised National Sporting Organisation` (Date 1 2 2025))
#ASSERT NOT (`Is my sport contract outside the limits` `a coach for such an athlete` `none of those` (Date 1 2 2025))

§ `reg 2.15(3) -- international events`

#ASSERT `Is my international event contract outside the limits` TRUE TRUE TRUE TRUE (Date 1 1 2025)
-- An event regularly held in Australia, (b) fails.
#ASSERT NOT (`Is my international event contract outside the limits` TRUE FALSE TRUE TRUE (Date 1 1 2025))
#ASSERT NOT (`Is my international event contract outside the limits` TRUE TRUE TRUE TRUE (Date 5 12 2023))

§ `reg 2.15(7) -- charities and not-for-profits`

-- Arguments: philanthropic; own revenue; in a group; group revenue; evidence; funding; for the project; project years;
-- same period; continuity years; HE award; funding from 1 Nov 2024; contract day.
#ASSERT `Is my charity project contract outside the limits` TRUE 5000000 FALSE 0 FALSE TRUE TRUE 5 TRUE 7 FALSE TRUE (Date 31 10 2026)
-- The window closes: a contract made on 1 November 2026 is not "before 1 November 2026".
#ASSERT NOT (`Is my charity project contract outside the limits` TRUE 5000000 FALSE 0 FALSE TRUE TRUE 5 TRUE 7 FALSE TRUE (Date 1 11 2026))
#ASSERT `Is my charity project contract outside the limits` TRUE 5000000 FALSE 0 FALSE TRUE TRUE 5 TRUE 7 FALSE TRUE (Date 1 11 2024)
#ASSERT NOT (`Is my charity project contract outside the limits` TRUE 5000000 FALSE 0 FALSE TRUE TRUE 5 TRUE 7 FALSE TRUE (Date 31 10 2024))
-- Revenue exactly $10,000,000 is not "less than"; $9,999,999 is.
#ASSERT NOT (`Is my charity project contract outside the limits` TRUE 10000000 FALSE 0 FALSE TRUE TRUE 5 TRUE 7 FALSE TRUE (Date 1 3 2025))
#ASSERT `Is my charity project contract outside the limits` TRUE 9999999 FALSE 0 FALSE TRUE TRUE 5 TRUE 7 FALSE TRUE (Date 1 3 2025)
-- (7A): a reporting group at $12,000,000 deems the entity over the limit, unless it has evidence to the contrary.
#ASSERT NOT (`Is my charity project contract outside the limits` TRUE 5000000 TRUE 12000000 FALSE TRUE TRUE 5 TRUE 7 FALSE TRUE (Date 1 3 2025))
#ASSERT `Is my charity project contract outside the limits` TRUE 5000000 TRUE 12000000 TRUE TRUE TRUE 5 TRUE 7 FALSE TRUE (Date 1 3 2025)
-- A group under $10,000,000 does not deem anything.
#ASSERT `Is my charity project contract outside the limits` TRUE 5000000 TRUE 9000000 FALSE TRUE TRUE 5 TRUE 7 FALSE TRUE (Date 1 3 2025)
-- A project of 5.5 years, (d) fails; continuity of 7.5 years, (f) fails; a Higher Education award, (g) fails.
#ASSERT NOT (`Is my charity project contract outside the limits` TRUE 5000000 FALSE 0 FALSE TRUE TRUE 5.5 TRUE 7 FALSE TRUE (Date 1 3 2025))
#ASSERT NOT (`Is my charity project contract outside the limits` TRUE 5000000 FALSE 0 FALSE TRUE TRUE 5 TRUE 7.5 FALSE TRUE (Date 1 3 2025))
#ASSERT NOT (`Is my charity project contract outside the limits` TRUE 5000000 FALSE 0 FALSE TRUE TRUE 5 TRUE 7 TRUE TRUE (Date 1 3 2025))
-- Funding arrangements before 1 November 2024, (h) fails.
#ASSERT NOT (`Is my charity project contract outside the limits` TRUE 5000000 FALSE 0 FALSE TRUE TRUE 5 TRUE 7 FALSE FALSE (Date 1 3 2025))

§ `reg 2.15(9) -- medical and health research`

-- Arguments as (7) with "research" after funding.
#ASSERT `Is my research project contract outside the limits` TRUE 99999999 FALSE 0 FALSE TRUE TRUE TRUE 5 TRUE 7 FALSE TRUE (Date 1 3 2025)
#ASSERT NOT (`Is my research project contract outside the limits` TRUE 100000000 FALSE 0 FALSE TRUE TRUE TRUE 5 TRUE 7 FALSE TRUE (Date 1 3 2025))
-- Revenue of $20,000,000 is fine here though over the charity limit.
#ASSERT `Is my research project contract outside the limits` TRUE 20000000 FALSE 0 FALSE TRUE TRUE TRUE 5 TRUE 7 FALSE TRUE (Date 1 3 2025)
-- Work that is not primarily research of the four kinds, (c) fails.
#ASSERT NOT (`Is my research project contract outside the limits` TRUE 20000000 FALSE 0 FALSE TRUE FALSE TRUE 5 TRUE 7 FALSE TRUE (Date 1 3 2025))
#ASSERT NOT (`Is my research project contract outside the limits` TRUE 20000000 FALSE 0 FALSE TRUE TRUE TRUE 5 TRUE 7 FALSE TRUE (Date 1 11 2026))
