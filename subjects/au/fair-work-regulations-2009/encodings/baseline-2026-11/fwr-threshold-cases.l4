IMPORT prelude
IMPORT `fwr-threshold`

-- Cases for fwr-threshold.l4. Expected values worked by hand from the text (regulation cited). Edges: a ratio whose
-- fourth decimal place is 5; a ratio below 1; a result that is an exact multiple of $50; earnings exactly at the
-- threshold.

§ `reg 2.13(3) -- indexing the threshold`

-- 1023.5 / 1000 = 1.0235; fourth place 5, so 1.024; 175,000 x 1.024 = 179,200, already a multiple of $100.
#ASSERT `What is this year's high income threshold` 175000 1023.5 1000 EQUALS 179200
-- 1.02349 rounds to 1.023; 175,000 x 1.023 = 179,025, nearest multiple of $100 is 179,000.
#ASSERT `What is this year's high income threshold` 175000 1023.49 1000 EQUALS 179000
-- 990 / 1000 = 0.99, less than 1, so 1: the threshold stays at 175,000.
#ASSERT `What is this year's high income threshold` 175000 990 1000 EQUALS 175000
-- 150,000 x 1.001 = 150,150, a multiple of $50: rounded up to 150,200.
#ASSERT `What is this year's high income threshold` 150000 1001 1000 EQUALS 150200
-- 149,950 x 1.001 = 150,099.95: nearest multiple of $100 is 150,100.
#ASSERT `What is this year's high income threshold` 149950 1001 1000 EQUALS 150100

§ `reg 2.13(2) -- the 2009-10 threshold`

-- Steps 1-3: 1050 / 1000 = 1.05; $100,000 x 1.05 = 105,000. Steps 4-6: 1081.5 / 1050 = 1.03; 105,000 x 1.03 = 108,150,
-- a multiple of $50, so 108,200.
#ASSERT `What was the 2009-10 high income threshold` 1050 1000 1081.5 EQUALS 108200
-- Second ratio 1000 / 1050 = 0.952, below 1, so 1: 105,000.
#ASSERT `What was the 2009-10 high income threshold` 1050 1000 1000 EQUALS 105000

§ `reg 3.05(2)-(5) -- piece rates`

-- No piece rates set by output: nothing is counted under (3)-(5).
#ASSERT `What piece rates are counted` FALSE TRUE TRUE FALSE 30000 0 0 EQUALS 0
-- Piece rates that are really a rate for time worked fail (2)(b): 0.
#ASSERT `What piece rates are counted` TRUE FALSE TRUE FALSE 30000 0 0 EQUALS 0
-- (3): 12 months' continuous work, no leave without full pay: the 12 months' piece rates.
#ASSERT `What piece rates are counted` TRUE TRUE TRUE FALSE 30000 0 0 EQUALS 30000
-- (4): leave without full pay in the 12 months: 25,000 actually received plus the formula amount 4,000.
#ASSERT `What piece rates are counted` TRUE TRUE TRUE TRUE 30000 25000 4000 EQUALS 29000
-- (5): employed less than 12 months: the formula amount.
#ASSERT `What piece rates are counted` TRUE TRUE FALSE FALSE 0 0 18000 EQUALS 18000

§ `reg 3.05(6) -- a benefit other than money`

#ASSERT `What benefit value is counted` TRUE TRUE TRUE TRUE TRUE 5000 EQUALS 5000
-- The FWC is not satisfied it can estimate a value (c)(iii): nothing counted.
#ASSERT `What benefit value is counted` TRUE TRUE TRUE TRUE FALSE 5000 EQUALS 0
-- A money value was agreed, (c)(ii) fails: nothing counted.
#ASSERT `What benefit value is counted` TRUE TRUE TRUE FALSE TRUE 5000 EQUALS 0
-- A s 332(3) non-monetary benefit, (b) fails.
#ASSERT `What benefit value is counted` TRUE FALSE TRUE TRUE TRUE 5000 EQUALS 0

§ `s 382(b)(iii) with reg 3.05`

-- 170,000 + 10,000 + 3,000 = 183,000, less than 183,100.
#ASSERT `Am I under the high income threshold` 170000 10000 3000 183100
-- 170,100 + 10,000 + 3,000 = 183,100: not less than the threshold.
#ASSERT NOT (`Am I under the high income threshold` 170100 10000 3000 183100)
-- The piece rates take a person who would be under the threshold over it: 175,000 + 9,000 = 184,000.
#ASSERT NOT (`Am I under the high income threshold` 175000 9000 0 183100)
#ASSERT `Am I under the high income threshold` 175000 0 0 183100

§ `reg 3.06 -- leave without pay in the compensation cap`

-- Leave without pay: the 6,000 ordinarily received replaces the 0 actually paid: 20,000 + 6,000.
#ASSERT `How much remuneration am I taken to have received` 20000 TRUE 6000 0 EQUALS 26000
-- Leave without full pay (3,000 paid of 6,000): still taken as 6,000.
#ASSERT `How much remuneration am I taken to have received` 20000 TRUE 6000 3000 EQUALS 26000
-- No such leave: what was received.
#ASSERT `How much remuneration am I taken to have received` 26000 FALSE 0 0 EQUALS 26000

§ `reg 1.08AA -- the contractor high income threshold`

-- (2): $175,000 for the year starting 1 July 2024.
#ASSERT `What was the 2024-25 contractor high income threshold` EQUALS 175000
-- (3), Steps 1-3: 1,024 / 1,000 = 1.024; 175,000 x 1.024 = 179,200, a multiple of $100.
#ASSERT `What is this year's contractor high income threshold` 175000 1024 1000 EQUALS 179200
-- 1,000 / 1,010 = 0.990..., less than 1, becomes 1: the threshold does not fall (also s 15C(2) of the Act).
#ASSERT `What is this year's contractor high income threshold` 179200 1000 1010 EQUALS 179200
-- 2,003 / 2,000 = 1.0015, rounded up at the fourth place to 1.002; 175,000 x 1.002 = 175,350, a multiple of $50: up to 175,400.
#ASSERT `What is this year's contractor high income threshold` 175000 2003 2000 EQUALS 175400
