#ASSERT `s 68 -- was I victimised` FALSE `a complaint` TRUE FALSE EQUALS `NOT 68`
#ASSERT `s 68 -- was I victimised` TRUE `no discrimination action` TRUE FALSE EQUALS `NOT 68`
#ASSERT `s 68 -- was I victimised` TRUE `reasonably asserting rights under this Act` FALSE FALSE EQUALS `NOT 68`

#ASSERT `s 69 -- is the advertisement unlawful` TRUE FALSE EQUALS `AD UNLAWFUL`
#ASSERT `s 69 -- is the advertisement unlawful` FALSE TRUE EQUALS `AD UNLAWFUL`
#ASSERT `s 69 -- is the advertisement unlawful` FALSE FALSE EQUALS `AD NOT SHOWN`

§ `Who is answerable`

#ASSERT `s 121A -- is the employer answerable too` TRUE TRUE FALSE EQUALS `ANSWERABLE`
#ASSERT `s 121A -- is the employer answerable too` TRUE TRUE TRUE EQUALS `REASONABLE STEPS`
#ASSERT `s 121A -- is the employer answerable too` TRUE FALSE FALSE EQUALS `OUTSIDE AUTHORITY`
#ASSERT `s 121A -- is the employer answerable too` FALSE TRUE TRUE EQUALS `OUTSIDE AUTHORITY`

#ASSERT `s 73 -- is the helper taken to have done it` TRUE EQUALS `yes: they are taken to have done the unlawful act too (s 73)`
#ASSERT `s 73 -- is the helper taken to have done it` FALSE EQUALS `not shown: s 73 does not reach someone who did not aid, abet, counsel or procure it (NOTHING-kind)`

§ `Part 9 -- positive duties`

#ASSERT `s 74 -- did they fail to make reasonable adjustments for me` FALSE `employee` FALSE FALSE FALSE EQUALS `ADJ NO NEED`
#ASSERT `s 74 -- did they fail to make reasonable adjustments for me` TRUE `employee` FALSE FALSE FALSE EQUALS `ADJ UNLAWFUL`
#ASSERT `s 74 -- did they fail to make reasonable adjustments for me` TRUE `school` FALSE TRUE FALSE EQUALS `ADJ MADE`
#ASSERT `s 74 -- did they fail to make reasonable adjustments for me` TRUE `shop` FALSE FALSE TRUE EQUALS `ADJ HARDSHIP`
#ASSERT `s 74 -- did they fail to make reasonable adjustments for me` TRUE `private setting` FALSE FALSE FALSE EQUALS `ADJ NO DUTY`
#ASSERT `s 74 -- did they fail to make reasonable adjustments for me` TRUE `employee` TRUE FALSE FALSE EQUALS `ADJ NO DUTY`

#ASSERT DATE_SERIAL (`s 75 (4) -- from when does the positive duty apply` `government body`) EQUALS DATE_SERIAL `12 Apr 2025`
#ASSERT DATE_SERIAL (`s 75 (4) -- from when does the positive duty apply` `government manager`) EQUALS DATE_SERIAL `12 Apr 2025`
#ASSERT DATE_SERIAL (`s 75 (4) -- from when does the positive duty apply` `any business`) EQUALS DATE_SERIAL `12 Apr 2027`

