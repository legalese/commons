IMPORT prelude
IMPORT `rates-shared`
IMPORT `landtax-core`
IMPORT `rates-seat`

-- Cases for the owner's seat (rates-seat.l4) on land tax and the foreign ownership surcharge, and for the regulative
-- rules of landtax-core.l4. Rates cases are in rates-cases-owner.l4.
-- Every expected value was worked by hand from the deposited texts (A2004-4.txt, DI2026-152.txt, A2004-3.txt s 13A,
-- A1999-4.txt div 5.2), never copied from the encoding's output; the arithmetic is in the comment above each.
-- No scenario life raised this Act: the owners are the encoder's, HYPOTHETICAL throughout.
--
-- A breached or still-pending DEONTIC cannot be asserted on the stable l4, so regulative rules are asserted where the
-- trace ends FULFILLED, and #TRACEd with an "-- expect:" line where it does not. Clock: days.

-- =====================================================================================================================
-- Helpers
-- =====================================================================================================================

`house` MEANS `residential land that is not a unit`
`unit`  MEANS `a residential unit in a units plan`

`owner lives there` MEANS `an owner occupies it as their principal place of residence`
`life tenant`       MEANS `a person with a life or term interest in it under a will occupies it as their principal place of residence`
`rent-free`         MEANS `a person occupies it who pays no rent, or no more than the rates, repairs, maintenance and insurance`
`rented`            MEANS `it is rented to a tenant`
`empty`             MEANS `no one occupies it`

`no event`       MEANS `none of these`
`moved out`      MEANS `an owner stopped occupying it as their principal place of residence (s 11B)`
`bought to live` MEANS `the owner became the owner, to occupy it as their principal place of residence (s 11C)`
`rental ended`   MEANS `it stopped being rented so the owner could occupy it as their principal place of residence (s 11CA)`
`owner died`     MEANS `the owner who occupied it as their principal place of residence died (s 11D)`

`1 Jul 2026` MEANS DATE_FROM_DMY 1 7 2026
`1 Oct 2026` MEANS DATE_FROM_DMY 1 10 2026
`1 Jan 2027` MEANS DATE_FROM_DMY 1 1 2027
`1 Apr 2027` MEANS DATE_FROM_DMY 1 4 2027

-- Ana's house: unimproved values as at 1 January 2026, 2025, 2024, 2023, 2022 (AUV 430 000).
`Ana's values` MEANS LIST 460000, 440000, 430000, 420000, 400000
-- A building of residential units, parcel AUV 8 000 000.
`the building's values` MEANS LIST 8000000, 8000000, 8000000, 8000000, 8000000

-- The position for a quarter, with the facts for ss 11D-15 held at "no".
GIVEN `the quarter` IS A DATE, `kind` IS A `Kind of land`, `occupancy` IS AN `Occupancy on the 1st day of the quarter`, `event` IS AN `Earlier event`, `event day` IS A DATE, `moved in within 3 months` IS A BOOLEAN, `rented within 3 months` IS A BOOLEAN
GIVETH AN `Answer` `Land tax position`
`position` `the quarter` `kind` `occupancy` `event` `event day` `moved in within 3 months` `rented within 3 months` MEANS
    `Do I pay land tax for the quarter` `the quarter` `kind` FALSE `occupancy` `event` `event day` `moved in within 3 months` `rented within 3 months` FALSE FALSE FALSE FALSE FALSE FALSE `event day` FALSE FALSE FALSE

-- The land tax for a quarter with no earlier event, from who occupies it, the parcel's values and entitlements, and
-- (for s 15 / s 27(4)) the floor areas.
GIVEN `the quarter` IS A DATE
      `kind` IS A `Kind of land`
      `occupancy` IS AN `Occupancy on the 1st day of the quarter`
      `values` IS A LIST OF NUMBER
      `UE` IS A NUMBER, `TUER` IS A NUMBER, `TUE` IS A NUMBER
      `two dwellings` IS A BOOLEAN, `FA` IS A NUMBER, `TFA` IS A NUMBER
GIVETH AN `Answer` NUMBER
`land tax` `the quarter` `kind` `occupancy` `values` `UE` `TUER` `TUE` `two dwellings` `FA` `TFA` MEANS
    `How much land tax do I pay for the quarter` `the quarter` `kind` FALSE `occupancy` `no event` `the quarter` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `the quarter` FALSE FALSE `two dwellings` `values` `UE` `TUER` `TUE` `FA` `TFA`

GIVEN `a` IS AN `Answer` NUMBER, `b` IS AN `Answer` NUMBER
GIVETH A NUMBER
`the sum of` `a` `and` `b` MEANS
    CONSIDER `a`
    WHEN `answered` `x` THEN
        CONSIDER `b`
        WHEN `answered` `y` THEN `x` PLUS `y`
        OTHERWISE 0
    OTHERWISE 0

-- The surcharge for a foreign individual (not a citizen, no permanent visa, not ordinarily resident in Australia).
GIVEN `the quarter` IS A DATE
      `kind` IS A `Kind of land`
      `occupancy` IS AN `Occupancy on the 1st day of the quarter`
      `foreign share` IS A NUMBER
      `values` IS A LIST OF NUMBER
      `UE` IS A NUMBER, `TUER` IS A NUMBER, `TUE` IS A NUMBER
GIVETH AN `Answer` NUMBER
`surcharge for a foreign owner` `the quarter` `kind` `occupancy` `foreign share` `values` `UE` `TUER` `TUE` MEANS
    `How much foreign ownership surcharge do I pay for the quarter` `the quarter` `kind` `occupancy` FALSE FALSE FALSE `foreign share` `values` `UE` `TUER` `TUE`

-- =====================================================================================================================
-- Quarters (DI2026-152 s 4(2): "days in quarter")
-- =====================================================================================================================

-- 2026-27: July-September 31 + 31 + 30 = 92; October-December 31 + 30 + 31 = 92; January-March 31 + 28 + 31 = 90;
-- April-June 30 + 31 + 30 = 91; 365 in all.
#ASSERT `the days in the quarter starting` `1 Jul 2026` EQUALS 92
#ASSERT `the days in the quarter starting` `1 Oct 2026` EQUALS 92
#ASSERT `the days in the quarter starting` `1 Jan 2027` EQUALS 90
#ASSERT `the days in the quarter starting` `1 Apr 2027` EQUALS 91
#ASSERT `the days in the year 2026-27` EQUALS 365
-- The 1st quarter after a day: 10 August 2026 → 1 October 2026; 30 September 2026 → 1 October 2026; 1 October 2026
-- itself → 1 January 2027 (a quarter beginning on the day is not "after" it).
#ASSERT `the first day of the quarter after` (DATE_FROM_DMY 10 8 2026) EQUALS `1 Oct 2026`
#ASSERT `the first day of the quarter after` (DATE_FROM_DMY 30 9 2026) EQUALS `1 Oct 2026`
#ASSERT `the first day of the quarter after` `1 Oct 2026` EQUALS `1 Jan 2027`

-- =====================================================================================================================
-- The position for a quarter (ss 8-15)
-- =====================================================================================================================

-- Ana lives in her house on 1 October 2026: s 11A.
#ASSERT `position` `1 Oct 2026` `house` `owner lives there` `no event` `1 Oct 2026` FALSE FALSE EQUALS `answered` (`exempt` `s 11A: an owner's principal place of residence`)
-- Rented to a tenant: payable.
#ASSERT `position` `1 Oct 2026` `house` `rented` `no event` `1 Oct 2026` FALSE FALSE EQUALS `answered` `land tax is payable for the quarter (s 9)`
-- No one lives there and no exemption runs: payable (finding 14).
#ASSERT `position` `1 Oct 2026` `house` `empty` `no event` `1 Oct 2026` FALSE FALSE EQUALS `answered` `land tax is payable for the quarter (s 9)`
-- Ana moves out on 10 August 2026. On 1 October 2026 it is empty: the 1st quarter after, exempt under s 11B.
#ASSERT `position` `1 Oct 2026` `house` `empty` `moved out` (DATE_FROM_DMY 10 8 2026) FALSE FALSE EQUALS `answered` (`exempt` `s 11B: the 1st quarter after an owner moved out (and it is not rented)`)
-- If a tenant has it on 1 October 2026, s 11B(3): payable from that quarter.
#ASSERT `position` `1 Oct 2026` `house` `rented` `moved out` (DATE_FROM_DMY 10 8 2026) FALSE FALSE EQUALS `answered` `land tax is payable for the quarter (s 9)`
-- On 1 January 2027, rented or empty: payable (s 11B covers only the 1st quarter after).
#ASSERT `position` `1 Jan 2027` `house` `rented` `moved out` (DATE_FROM_DMY 10 8 2026) FALSE FALSE EQUALS `answered` `land tax is payable for the quarter (s 9)`
#ASSERT `position` `1 Jan 2027` `house` `empty` `moved out` (DATE_FROM_DMY 10 8 2026) FALSE FALSE EQUALS `answered` `land tax is payable for the quarter (s 9)`
-- Ben buys a house on 20 September 2026 to live in; empty on 1 October; he moves in on 15 November, within 3 months, and
-- does not rent it: s 11C.
#ASSERT `position` `1 Oct 2026` `house` `empty` `bought to live` (DATE_FROM_DMY 20 9 2026) TRUE FALSE EQUALS `answered` (`exempt` `s 11C: the 1st quarter after becoming the owner, to move in`)
-- He does not move in within 3 months: no s 11C, and on 1 October it is empty: payable.
#ASSERT `position` `1 Oct 2026` `house` `empty` `bought to live` (DATE_FROM_DMY 20 9 2026) FALSE FALSE EQUALS `answered` `land tax is payable for the quarter (s 9)`
-- The seller rents it back for 2 months, so on 1 October a tenant has it; Ben moves in within 3 months: s 11C still
-- applies (a lease back to the seller for up to 3 months does not count, s 11C(3)(b)).
#ASSERT `position` `1 Oct 2026` `house` `rented` `bought to live` (DATE_FROM_DMY 20 9 2026) TRUE FALSE EQUALS `answered` (`exempt` `s 11C: the 1st quarter after becoming the owner, to move in`)
-- Cara's tenant leaves on 5 December 2026 so she can move back; empty on 1 January 2027; she moves in on 20 January:
-- s 11CA.
#ASSERT `position` `1 Jan 2027` `house` `empty` `rental ended` (DATE_FROM_DMY 5 12 2026) TRUE FALSE EQUALS `answered` (`exempt` `s 11CA: the 1st quarter after a rental ended, to move in`)
-- She lets it again within 3 months instead: no s 11CA.
#ASSERT `position` `1 Jan 2027` `house` `empty` `rental ended` (DATE_FROM_DMY 5 12 2026) TRUE TRUE EQUALS `answered` `land tax is payable for the quarter (s 9)`
-- Dev, who lived in his house, died on 15 March 2025; the title stays in the executor's name. 1 January 2027 is within
-- the 2 years (to 15 March 2027): s 11D.
#ASSERT `Do I pay land tax for the quarter` `1 Jan 2027` `house` FALSE `empty` `owner died` (DATE_FROM_DMY 15 3 2025) FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE (DATE_FROM_DMY 15 3 2025) FALSE FALSE FALSE EQUALS `answered` (`exempt` `s 11D: 2 years after the death of the owner who lived there (or as extended)`)
-- 1 April 2027 is after the 2 years: payable, unless the Commissioner extended the period (s 11E).
#ASSERT `Do I pay land tax for the quarter` `1 Apr 2027` `house` FALSE `empty` `owner died` (DATE_FROM_DMY 15 3 2025) FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE (DATE_FROM_DMY 15 3 2025) FALSE FALSE FALSE EQUALS `answered` `land tax is payable for the quarter (s 9)`
#ASSERT `Do I pay land tax for the quarter` `1 Apr 2027` `house` FALSE `empty` `owner died` (DATE_FROM_DMY 15 3 2025) FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE (DATE_FROM_DMY 15 3 2025) FALSE FALSE FALSE EQUALS `answered` (`exempt` `s 11D: 2 years after the death of the owner who lived there (or as extended)`)
-- Transferred to a beneficiary's name in the 2 years: no s 11D.
#ASSERT `Do I pay land tax for the quarter` `1 Jan 2027` `house` FALSE `empty` `owner died` (DATE_FROM_DMY 15 3 2025) FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE (DATE_FROM_DMY 15 3 2025) FALSE FALSE FALSE EQUALS `answered` `land tax is payable for the quarter (s 9)`
-- A life tenant under a will lives there: s 11G. Someone lives there rent-free: s 11H.
#ASSERT `position` `1 Oct 2026` `house` `life tenant` `no event` `1 Oct 2026` FALSE FALSE EQUALS `answered` (`exempt` `s 11G: a life tenant's principal place of residence`)
#ASSERT `position` `1 Oct 2026` `house` `rent-free` `no event` `1 Oct 2026` FALSE FALSE EQUALS `answered` (`exempt` `s 11H: occupied rent-free, or for no more than the outgoings`)
-- Unfit for occupation (s 11I), empty, no certificate of occupancy yet: exempt.
#ASSERT `Do I pay land tax for the quarter` `1 Oct 2026` `house` FALSE `empty` `no event` `1 Oct 2026` FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE `1 Oct 2026` FALSE FALSE FALSE EQUALS `answered` (`exempt` `s 11I: unfit for occupation as a place of residence`)
-- A certificate of occupancy issued on 10 August 2026 (the July-September quarter): exempt to the end of the quarter
-- following, so 1 October 2026 is exempt and 1 January 2027 is not.
#ASSERT `Do I pay land tax for the quarter` `1 Oct 2026` `house` FALSE `empty` `no event` `1 Oct 2026` FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE (DATE_FROM_DMY 10 8 2026) FALSE FALSE FALSE EQUALS `answered` (`exempt` `s 11I: unfit for occupation as a place of residence`)
#ASSERT `Do I pay land tax for the quarter` `1 Jan 2027` `house` FALSE `empty` `no event` `1 Jan 2027` FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE (DATE_FROM_DMY 10 8 2026) FALSE FALSE FALSE EQUALS `answered` `land tax is payable for the quarter (s 9)`
-- Unfit but rented: s 11I(3), payable.
#ASSERT `Do I pay land tax for the quarter` `1 Oct 2026` `house` FALSE `rented` `no event` `1 Oct 2026` FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE `1 Oct 2026` FALSE FALSE FALSE EQUALS `answered` `land tax is payable for the quarter (s 9)`
-- A compassionate exemption covering the quarter (s 13, a fact): exempt.
#ASSERT `Do I pay land tax for the quarter` `1 Oct 2026` `house` FALSE `empty` `no event` `1 Oct 2026` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `1 Oct 2026` FALSE TRUE FALSE EQUALS `answered` (`exempt` `s 13: a compassionate exemption`)
-- s 11A(3): Eli and his partner own two homes and the exemption is taken for the other; he lives in this one: payable,
-- unless the Commissioner is satisfied they have separated for good.
#ASSERT `Do I pay land tax for the quarter` `1 Oct 2026` `house` FALSE `owner lives there` `no event` `1 Oct 2026` FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE `1 Oct 2026` FALSE FALSE FALSE EQUALS `answered` `land tax is payable for the quarter (s 9)`
#ASSERT `Do I pay land tax for the quarter` `1 Oct 2026` `house` FALSE `owner lives there` `no event` `1 Oct 2026` FALSE FALSE FALSE FALSE TRUE TRUE FALSE FALSE `1 Oct 2026` FALSE FALSE FALSE EQUALS `answered` (`exempt` `s 11A: an owner's principal place of residence`)
-- s 15: Ana lives in the house and rents out the granny flat: payable on the flat's share, though she lives there.
#ASSERT `Do I pay land tax for the quarter` `1 Oct 2026` `house` FALSE `owner lives there` `no event` `1 Oct 2026` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `1 Oct 2026` FALSE FALSE TRUE EQUALS `answered` `land tax is payable on the rented dwelling's share (s 15)`
-- Not covered: a quarter of another year; a day that is not the 1st of a quarter; commercial land; a corporate owner.
#ASSERT `position` (DATE_FROM_DMY 1 7 2027) `house` `rented` `no event` `1 Oct 2026` FALSE FALSE EQUALS `not covered` `the day is outside the year 1 July 2026 to 30 June 2027: only the 2026 determinations are deposited`
#ASSERT `position` (DATE_FROM_DMY 15 10 2026) `house` `rented` `no event` `1 Oct 2026` FALSE FALSE EQUALS `not covered` `the day is outside the year 1 July 2026 to 30 June 2027: only the 2026 determinations are deposited`
#ASSERT `position` `1 Oct 2026` `commercial land` `rented` `no event` `1 Oct 2026` FALSE FALSE EQUALS `not covered` `commercial land (DI2026-150 Table 3, the city centre levy, the commercial emergency services levy in Table 4) is not encoded`
#ASSERT `Do I pay land tax for the quarter` `1 Oct 2026` `house` TRUE `rented` `no event` `1 Oct 2026` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `1 Oct 2026` FALSE FALSE FALSE EQUALS `not covered` `land owned, wholly or partly, by a corporation or a trustee (Rates Act s 20A(2), Land Tax Act ss 16 and 27(5)) is not encoded`

-- =====================================================================================================================
-- The land tax for a quarter (s 9, s 15, s 27; DI2026-152 ss 4-6)
-- =====================================================================================================================

-- DI2026-152 Table 1: 0.54% × 150 000 = 810; 810 + 0.64% × 125 000 = 810 + 800 = 1 610; 1 610 + 1.24% × 725 000 =
-- 1 610 + 8 990 = 10 600; 10 600 + 1.25% × 1 000 000 = 23 100.
#ASSERT `the column 2 amount in` `DI2026-152 Table 1` `for` 150000 EQUALS 810
#ASSERT `the column 2 amount in` `DI2026-152 Table 1` `for` 275000 EQUALS 1610
#ASSERT `the column 2 amount in` `DI2026-152 Table 1` `for` 1000000 EQUALS 10600
#ASSERT `the column 2 amount in` `DI2026-152 Table 1` `for` 2000000 EQUALS 23100
-- The instrument's own example: $1 778 × 92/365 = $448.15.
#ASSERT `the amount for the quarter under DI2026-152 s 4 of` 1778 `starting` `1 Oct 2026` EQUALS 448.15

-- Ana's house rented all year, AUV 430 000. Table 1: 1 610 + 1.24% × (430 000 − 275 000) = 1 610 + 1 922 = 3 532; the
-- year's amount 1 778 + 3 532 = 5 310.
-- July (92 days): FC 1 778 × 92/365 = 448.153..., 448.15; P 3 532 × 92/365 = 890.257..., 890.26; 1 338.41.
#ASSERT `land tax` `1 Jul 2026` `house` `rented` `Ana's values` 1 1 1 FALSE 1 1 EQUALS `answered` 1338.41
-- October (92 days): the same, 1 338.41.
#ASSERT `land tax` `1 Oct 2026` `house` `rented` `Ana's values` 1 1 1 FALSE 1 1 EQUALS `answered` 1338.41
-- January (90 days): FC 1 778 × 90/365 = 438.410..., 438.41; P 3 532 × 90/365 = 870.904..., 870.90; 1 309.31.
#ASSERT `land tax` `1 Jan 2027` `house` `rented` `Ana's values` 1 1 1 FALSE 1 1 EQUALS `answered` 1309.31
-- April (91 days): FC 1 778 × 91/365 = 443.282..., 443.28; P 3 532 × 91/365 = 880.580..., 880.58; 1 323.86.
#ASSERT `land tax` `1 Apr 2027` `house` `rented` `Ana's values` 1 1 1 FALSE 1 1 EQUALS `answered` 1323.86
-- The four quarters add to 5 309.99, a cent short of the year's 5 310 (finding 16).
#ASSERT (`the sum of` (`land tax` `1 Jul 2026` `house` `rented` `Ana's values` 1 1 1 FALSE 1 1) `and` (`answered` (`the sum of` (`land tax` `1 Oct 2026` `house` `rented` `Ana's values` 1 1 1 FALSE 1 1) `and` (`answered` (`the sum of` (`land tax` `1 Jan 2027` `house` `rented` `Ana's values` 1 1 1 FALSE 1 1) `and` (`land tax` `1 Apr 2027` `house` `rented` `Ana's values` 1 1 1 FALSE 1 1)))))) EQUALS 5309.99
-- Lived in: exempt, nil.
#ASSERT `land tax` `1 Oct 2026` `house` `owner lives there` `Ana's values` 1 1 1 FALSE 1 1 EQUALS `answered` 0
-- A rented unit (UE 100, TUER = TUE = 10 000) in the $8 000 000 building: AUVRU 8 000 000; Table 1, 23 100 + 1.26% ×
-- 6 000 000 = 98 700. October: FC 448.15; 98 700 × 92/365 × 100/10 000 = 248.778..., 248.78; 696.93.
-- (The year's amount 1 778 + 987 = 2 765.)
#ASSERT `land tax` `1 Oct 2026` `unit` `rented` `the building's values` 100 10000 10000 FALSE 1 1 EQUALS `answered` 696.93
-- s 15: Ana lives in the house and rents the granny flat, 60 of the 240 square metres. AUV 430 000 × 60/240 = 107 500;
-- FC 1 778 × 60/240 = 444.50; Table 1, 0.54% × 107 500 = 580.50. October: 444.50 × 92/365 = 112.038..., 112.04;
-- 580.50 × 92/365 = 146.317..., 146.32; 258.36.
#ASSERT `land tax` `1 Oct 2026` `house` `owner lives there` `Ana's values` 1 1 1 TRUE 60 240 EQUALS `answered` 258.36
-- s 27(4): the unit owner lives in the unit and rents a quarter of its floor area: FC 1 778 × 1/4 × 92/365 =
-- 112.038..., 112.04; 98 700 × 100/10 000 × 1/4 × 92/365 = 62.194..., 62.19; 174.23.
#ASSERT `land tax` `1 Oct 2026` `unit` `owner lives there` `the building's values` 100 10000 10000 TRUE 25 100 EQUALS `answered` 174.23
-- No unimproved value given: not covered.
#ASSERT `land tax` `1 Oct 2026` `house` `rented` (LIST) 1 1 1 FALSE 1 1 EQUALS `not covered` `no unimproved value of the parcel was given (the valuation, Rates Act pt 2, is out of scope)`

-- =====================================================================================================================
-- From which quarter, after moving out (ss 8A(3), 11B)
-- =====================================================================================================================

-- Moved out 10 August 2026, a tenant in by 1 October 2026: from 1 October 2026.
#ASSERT `From which quarter do I pay land tax after moving out` (DATE_FROM_DMY 10 8 2026) TRUE EQUALS `1 Oct 2026`
-- Not rented on 1 October (rented later, or left empty): 1 October is exempt under s 11B, so from 1 January 2027.
#ASSERT `From which quarter do I pay land tax after moving out` (DATE_FROM_DMY 10 8 2026) FALSE EQUALS `1 Jan 2027`
-- Moved out on 1 October 2026 itself: the 1st quarter after is January (read as above), so from 1 April 2027 if not
-- rented on 1 January.
#ASSERT `From which quarter do I pay land tax after moving out` `1 Oct 2026` FALSE EQUALS `1 Apr 2027`

-- =====================================================================================================================
-- The foreign ownership surcharge (pt 2A)
-- =====================================================================================================================

-- s 17A: a citizen is not a foreign individual; a person with none of the three statuses is; a person ordinarily
-- resident in Australia on a temporary visa is not (finding 19).
#ASSERT `Am I a foreign individual` TRUE FALSE FALSE EQUALS FALSE
#ASSERT `Am I a foreign individual` FALSE FALSE FALSE EQUALS TRUE
#ASSERT `Am I a foreign individual` FALSE FALSE TRUE EQUALS FALSE
-- A foreign individual owns a rented house, AUV 430 000: 0.75% × 430 000 = 3 225 a year; October 3 225 × 92/365 =
-- 812.876..., 812.88 (on top of the 1 338.41 land tax).
#ASSERT `surcharge for a foreign owner` `1 Oct 2026` `house` `rented` 1 `Ana's values` 1 1 1 EQUALS `answered` 812.88
-- Left empty: also 812.88.
#ASSERT `surcharge for a foreign owner` `1 Oct 2026` `house` `empty` 1 `Ana's values` 1 1 1 EQUALS `answered` 812.88
-- Lived in as the owner's home: exempt under s 11A, so no surcharge (s 17E(2)(a)).
#ASSERT `surcharge for a foreign owner` `1 Oct 2026` `house` `owner lives there` 1 `Ana's values` 1 1 1 EQUALS `answered` 0
-- Lent rent-free: exempt from land tax under s 11H, but not from the surcharge, which excepts s 10(1)(a)(vii) (finding
-- 18): 812.88.
#ASSERT `surcharge for a foreign owner` `1 Oct 2026` `house` `rent-free` 1 `Ana's values` 1 1 1 EQUALS `answered` 812.88
-- Half the interests held by the foreign owner (s 17F): 3 225 × 1/2 × 92/365 = 406.438..., 406.44.
#ASSERT `surcharge for a foreign owner` `1 Oct 2026` `house` `rented` 0.5 `Ana's values` 1 1 1 EQUALS `answered` 406.44
-- A rented unit: 0.75% × 8 000 000 × 100/10 000 = 600 a year; × 92/365 = 151.232..., 151.23.
#ASSERT `surcharge for a foreign owner` `1 Oct 2026` `unit` `rented` 1 `the building's values` 100 10000 10000 EQUALS `answered` 151.23
-- An Australian citizen pays no surcharge.
#ASSERT `How much foreign ownership surcharge do I pay for the quarter` `1 Oct 2026` `house` `rented` TRUE FALSE TRUE 1 `Ana's values` 1 1 1 EQUALS `answered` 0

-- =====================================================================================================================
-- s 14, s 19A and TAA div 5.2 -- telling the Commissioner
-- =====================================================================================================================

-- The home is first rented on 1 September 2026: tell the Commissioner by 1 October 2026 (30 days); TAA s 67(2) maximum
-- 50 penalty units × $160 = $8 000.
#ASSERT `By when must I tell the Commissioner that land tax has become payable` (DATE_FROM_DMY 1 9 2026) 160 EQUALS (`Notice I must give` WITH `the last day to give it` IS `1 Oct 2026`, `the most I can be fined` IS 8000)
-- Not told; the 1st quarter of the tax begins 1 October 2026: s 19A interest from the end of 31 October 2026 (30 days
-- after). Penalty tax on the quarter's 1 338.41, nothing more than the default, no disclosure: 25%, 334.6025, 334.60.
#ASSERT `What follows if I did not tell the Commissioner` `1 Oct 2026` 1338.41 `nothing more than the default (TAA s 31(1))` `no disclosure` EQUALS (`If I did not tell the Commissioner` WITH `interest runs after` IS DATE_FROM_DMY 31 10 2026, `the penalty tax` IS 334.60)
-- Disclosed in writing before any investigation (s 32): 25% less 80% = 5%, 66.9205, 66.92.
#ASSERT `the penalty tax under s 19A(4) on` 1338.41 `for` `nothing more than the default (TAA s 31(1))` `with` `disclosure in writing before being told of an investigation (TAA s 32)` EQUALS 66.92
-- Disclosed after being told of an investigation, before it began (s 33): 25% less 20% = 20%, 267.682, 267.68.
#ASSERT `the penalty tax under s 19A(4) on` 1338.41 `for` `nothing more than the default (TAA s 31(1))` `with` `disclosure in writing after being told of an investigation, before it began (TAA s 33)` EQUALS 267.68
-- Reasonable care: none (s 31(5)).
#ASSERT `the penalty tax under s 19A(4) on` 1338.41 `for` `reasonable care, or circumstances beyond the owner's control (TAA s 31(5))` `with` `no disclosure` EQUALS 0
-- Intentional disregard: 75%, 1 003.8075, 1 003.81.
#ASSERT `the penalty tax under s 19A(4) on` 1338.41 `for` `intentional disregard of a tax law (TAA s 31(4))` `with` `no disclosure` EQUALS 1003.81
-- Concealment: 90% whatever the disclosure (table 34 item 6), 1 204.569, 1 204.57.
#ASSERT `the penalty tax under s 19A(4) on` 1338.41 `for` `concealment after being told of an investigation (TAA s 34)` `with` `disclosure in writing before being told of an investigation (TAA s 32)` EQUALS 1204.57
-- Under $20 (s 35): 25% of $60 is $15, so none.
#ASSERT `the penalty tax under s 19A(4) on` 60 `for` `nothing more than the default (TAA s 31(1))` `with` `no disclosure` EQUALS 0

-- s 17(5): a land tax notice dated 1 October 2026; 4 weeks after is 29 October 2026.
#ASSERT `Is the payment date on my land tax notice lawful` `1 Oct 2026` (DATE_FROM_DMY 29 10 2026) EQUALS TRUE
#ASSERT `Is the payment date on my land tax notice lawful` `1 Oct 2026` (DATE_FROM_DMY 28 10 2026) EQUALS FALSE

-- s 11D(3): Dev died on 15 March 2025; his executor must apply before 15 March 2027.
#ASSERT `Before what date must I apply to extend the exemption after the death` (DATE_FROM_DMY 15 3 2025) EQUALS DATE_FROM_DMY 15 3 2027

-- =====================================================================================================================
-- Regulative rules
-- =====================================================================================================================

-- s 14, from the date of the change: the owner tells on day 30: fulfilled. Her agent tells on day 10: fulfilled.
#ASSERT EVALTRACE (`s 14 -- a relevant person must tell the commissioner within 30 days of a change that makes land tax payable` `the owner`) 0 (LIST (EVENT `the owner` `tell the commissioner of the change in circumstances and its date` 30)) EQUALS FULFILLED
#ASSERT EVALTRACE (`s 14 -- a relevant person must tell the commissioner within 30 days of a change that makes land tax payable` `the owner's agent`) 0 (LIST (EVENT `the owner's agent` `tell the commissioner of the change in circumstances and its date` 10)) EQUALS FULFILLED
-- expect: BREACH BY the owner, "Land Tax Act s 14(2)-(3): the commissioner was not told of the change within 30 days; TAA s 67(2): maximum penalty 50 penalty units; s 19A: ..."
#TRACE `s 14 -- a relevant person must tell the commissioner within 30 days of a change that makes land tax payable` `the owner` AT 0 WITH
    (WAITUNTIL 31)

-- s 17, from the date of the notice, 28 days to the payment date: paid on day 28: fulfilled.
#ASSERT EVALTRACE (`s 17 -- the owner must pay the land tax by the payment date` 28) 0 (LIST (EVENT `the owner` `pay the land tax` 28)) EQUALS FULFILLED
-- expect: BREACH BY the owner, "Land Tax Act s 17: the land tax was not paid by the payment date; s 19: interest ..."
#TRACE `s 17 -- the owner must pay the land tax by the payment date` 28 AT 0 WITH
    (WAITUNTIL 29)

-- s 11D(3), from Dev's death on 15 March 2025: 730 days to 15 March 2027 (365 + 365). The executor applies on day 700,
-- the commissioner decides on day 750: fulfilled. No application: fulfilled (s 11F may still allow a late one).
#ASSERT `the number of days from` (DATE_FROM_DMY 15 3 2025) `to` (DATE_FROM_DMY 15 3 2027) EQUALS 730
#ASSERT EVALTRACE (`s 11D(3) -- the personal representative may apply before the 2 years end to extend the exemption` 730) 0 (LIST (EVENT `the personal representative` `apply in writing to extend the 2-year period` 700), (EVENT `the commissioner` `decide whether to extend the period` 750)) EQUALS FULFILLED
#ASSERT EVALTRACE (`s 11D(3) -- the personal representative may apply before the 2 years end to extend the exemption` 730) 0 (LIST (WAITUNTIL 731)) EQUALS FULFILLED
