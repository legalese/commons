#ASSERT `Am I entitled to treatment and care benefits` FALSE TRUE FALSE FALSE FALSE FALSE EQUALS `not entitled` `a limitation in division 2.2.2 ends or excludes these benefits (ss 43 to 50)`
#ASSERT `Am I entitled to treatment and care benefits` FALSE FALSE FALSE FALSE TRUE FALSE EQUALS `not entitled` `a limitation in division 2.2.2 ends or excludes these benefits (ss 43 to 50)`

