IMPORT prelude
IMPORT `act-nouns`
IMPORT `act-ch10-referring-to-laws`

-- Tests for act-ch10-referring-to-laws.l4.
-- Every expected value is read from the section named beside the assertion, and was written before the run.

§ `Tests: chapter 10, Referring to laws`

§§ `Section 97`

-- dictionary: another jurisdiction means the Commonwealth, a State, another Territory, the United Kingdom or New Zealand.
#ASSERT `dictionary: the jurisdiction is another jurisdiction` `the Commonwealth`
#ASSERT `dictionary: the jurisdiction is another jurisdiction` `a State`
#ASSERT `dictionary: the jurisdiction is another jurisdiction` `another Territory`
#ASSERT `dictionary: the jurisdiction is another jurisdiction` `the United Kingdom`
#ASSERT `dictionary: the jurisdiction is another jurisdiction` `New Zealand`
#ASSERT NOT (`dictionary: the jurisdiction is another jurisdiction` `the Territory`)
#ASSERT NOT (`dictionary: the jurisdiction is another jurisdiction` `somewhere else`)

-- s 97 (1): ACT law means an Act or statutory instrument.
#ASSERT `s 97 (1): the document is an ACT law` `the Territory` TRUE
#ASSERT NOT (`s 97 (1): the document is an ACT law` `the Territory` FALSE)
#ASSERT NOT (`s 97 (1): the document is an ACT law` `the Commonwealth` TRUE)

-- s 97 (1): law of another jurisdiction means an Act or statutory instrument of another jurisdiction, and includes a provision of one.
#ASSERT `s 97 (1): the document is a law of another jurisdiction` `a State` TRUE FALSE
#ASSERT `s 97 (1): the document is a law of another jurisdiction` `New Zealand` FALSE TRUE
#ASSERT NOT (`s 97 (1): the document is a law of another jurisdiction` `a State` FALSE FALSE)
#ASSERT NOT (`s 97 (1): the document is a law of another jurisdiction` `the Territory` TRUE TRUE)
#ASSERT NOT (`s 97 (1): the document is a law of another jurisdiction` `somewhere else` TRUE TRUE)

-- s 97 (1): law means an ACT law or a law of another jurisdiction.
#ASSERT `s 97 (1): the document is a law` `the Territory` TRUE FALSE
#ASSERT `s 97 (1): the document is a law` `the United Kingdom` TRUE FALSE
#ASSERT `s 97 (1): the document is a law` `another Territory` FALSE TRUE
#ASSERT NOT (`s 97 (1): the document is a law` `somewhere else` TRUE TRUE)
#ASSERT NOT (`s 97 (1): the document is a law` `the Territory` FALSE TRUE)

-- s 97 (2): Act, in relation to another Territory, includes ordinance.
#ASSERT `s 97 (2): the document is an Act in relation to the other Territory` TRUE EQUALS JUST TRUE
#ASSERT `s 97 (2): the document is an Act in relation to the other Territory` FALSE EQUALS NOTHING

-- s 97 (2): statutory instrument, of another jurisdiction, means an instrument made under (a), (b) or (c).
#ASSERT `s 97 (2): the instrument is a statutory instrument of another jurisdiction` TRUE FALSE FALSE
#ASSERT `s 97 (2): the instrument is a statutory instrument of another jurisdiction` FALSE TRUE FALSE
#ASSERT `s 97 (2): the instrument is a statutory instrument of another jurisdiction` FALSE FALSE TRUE
#ASSERT NOT (`s 97 (2): the instrument is a statutory instrument of another jurisdiction` FALSE FALSE FALSE)

§§ `Section 98`

-- s 98 Example: s 93 of the ABC Act 2001 says "If an Act authorises ...", and the reference to "an Act" includes the ABC Act 2001 itself.
#ASSERT `s 98: the reference includes a reference to the law itself` `an Act` `an Act` TRUE TRUE EQUALS JUST TRUE
-- s 98: the reference must be in an ACT law, in general terms, and to a law of the same kind.
#ASSERT `s 98: the reference includes a reference to the law itself` `a disallowable instrument` `a disallowable instrument` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 98: the reference includes a reference to the law itself` `a subordinate law` `an Act` TRUE TRUE EQUALS NOTHING
#ASSERT `s 98: the reference includes a reference to the law itself` `an Act` `an Act` FALSE TRUE EQUALS NOTHING
#ASSERT `s 98: the reference includes a reference to the law itself` `an Act` `an Act` TRUE FALSE EQUALS NOTHING

§§ `Section 99`

-- s 99: in a statutory instrument, a reference to Act or the Act, without mentioning a particular Act, is a reference to the Act under which the instrument is made or in force.
#ASSERT `s 99: the reference is a reference to the Act under which the instrument is made or in force` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 99: the reference is a reference to the Act under which the instrument is made or in force` FALSE TRUE EQUALS NOTHING
#ASSERT `s 99: the reference is a reference to the Act under which the instrument is made or in force` TRUE FALSE EQUALS NOTHING

§§ `Section 100`

-- s 100 (1): an Act may be referred to by (a) the name the Act gives to itself, or (b) the year it was passed and its number.
#ASSERT `s 100 (1): an Act may be referred to in the way` `by the name the Act gives to itself` EQUALS JUST TRUE
#ASSERT `s 100 (1): an Act may be referred to in the way` `by the year the Act was passed and its number` EQUALS JUST TRUE
#ASSERT `s 100 (1): an Act may be referred to in the way` `by some other way of naming an Act` EQUALS NOTHING

-- s 100 (2) (a): any name the instrument gives to itself.
#ASSERT `s 100 (2): a statutory instrument may be referred to in the way` `by a name the instrument gives to itself` FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- s 100 (2) (b): notified, and numbered under this Act or another territory law: the year it was notified and its number.
#ASSERT `s 100 (2): a statutory instrument may be referred to in the way` `by the year the instrument was notified and its number` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 100 (2): a statutory instrument may be referred to in the way` `by the year the instrument was notified and its number` FALSE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 100 (2): a statutory instrument may be referred to in the way` `by the year the instrument was notified and its number` TRUE FALSE FALSE FALSE EQUALS NOTHING
-- s 100 (2) (c): not notified but numbered under a territory law: the year it was made and its number.
#ASSERT `s 100 (2): a statutory instrument may be referred to in the way` `by the year the instrument was made and its number` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 100 (2): a statutory instrument may be referred to in the way` `by the year the instrument was made and its number` TRUE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 100 (2): a statutory instrument may be referred to in the way` `by the year the instrument was made and its number` FALSE FALSE FALSE FALSE EQUALS NOTHING
-- s 100 (2) (d): notified in the gazette before this Act commenced: the number, date and page of the gazette.
#ASSERT `s 100 (2): a statutory instrument may be referred to in the way` `by the number, date and page of the gazette where the instrument was notified` TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 100 (2): a statutory instrument may be referred to in the way` `by the number, date and page of the gazette where the instrument was notified` TRUE FALSE FALSE FALSE EQUALS NOTHING
-- s 100 (2) (e): the date it was made, together with a reference to the law under which it was made.
#ASSERT `s 100 (2): a statutory instrument may be referred to in the way` `by the date the instrument was made and the law under which it was made` FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 100 (2): a statutory instrument may be referred to in the way` `by some other way of naming a statutory instrument` TRUE TRUE TRUE TRUE EQUALS NOTHING

§§ `Section 101`

-- s 101 (1): a law of another jurisdiction may be referred to by (a) its own name, (b) a way sufficient in that jurisdiction, or (c) a way sufficient under current drafting practice for an ACT law, with a reference to the jurisdiction.
#ASSERT `s 101 (1): a law of another jurisdiction may be referred to in the way` `by the name the other law gives to itself` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 101 (1): a law of another jurisdiction may be referred to in the way` `in a way sufficient in a law of the other jurisdiction for referring to the law` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 101 (1): a law of another jurisdiction may be referred to in the way` `in a way that current legislative drafting practice would accept for an ACT law` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 101 (1): a law of another jurisdiction may be referred to in the way` `by some other way of naming a law of another jurisdiction` TRUE TRUE EQUALS NOTHING
-- The reference to the jurisdiction (or an abbreviation) goes with the way; without it the text does not say the reference may be made.
#ASSERT `s 101 (1): a law of another jurisdiction may be referred to in the way` `by the name the other law gives to itself` TRUE FALSE EQUALS NOTHING
#ASSERT `s 101 (1): a law of another jurisdiction may be referred to in the way` `by the name the other law gives to itself` FALSE TRUE EQUALS NOTHING

-- s 101 (2): a provision of a law of another jurisdiction may be referred to by (a) a way sufficient in that law, or (b) a way sufficient for a provision of an ACT law.
#ASSERT `s 101 (2): a provision of a law of another jurisdiction may be referred to in the way` `in a way sufficient in a law of the other jurisdiction for referring to the provision` TRUE EQUALS JUST TRUE
#ASSERT `s 101 (2): a provision of a law of another jurisdiction may be referred to in the way` `in a way that current legislative drafting practice would accept for a provision of an ACT law` TRUE EQUALS JUST TRUE
#ASSERT `s 101 (2): a provision of a law of another jurisdiction may be referred to in the way` `by some other way of naming a provision of a law of another jurisdiction` TRUE EQUALS NOTHING
#ASSERT `s 101 (2): a provision of a law of another jurisdiction may be referred to in the way` `in a way sufficient in a law of the other jurisdiction for referring to the provision` FALSE EQUALS NOTHING

-- s 101 (3): subsection (2) does not limit any other provision of this chapter.
#ASSERT NOT `s 101 (3): subsection (2) limits any other provision of this chapter`

§§ `Section 102`

-- s 102 (1) (a): the law as originally made, and as amended from time to time.
#ASSERT `s 102 (1): a reference to a law includes a reference to the version` `the law as originally made` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 102 (1): a reference to a law includes a reference to the version` `the law as amended from time to time since it was originally made` TRUE FALSE FALSE EQUALS JUST TRUE
-- s 102 (1) (b): if the law has been repealed and remade since the reference was made, the law as remade (or last remade) and as amended since.
#ASSERT `s 102 (1): a reference to a law includes a reference to the version` `the law as remade (or last remade)` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 102 (1): a reference to a law includes a reference to the version` `the law as amended from time to time since it was remade (or last remade)` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 102 (1): a reference to a law includes a reference to the version` `the law as remade (or last remade)` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 102 (1): a reference to a law includes a reference to the version` `the law as amended from time to time since it was remade (or last remade)` TRUE FALSE TRUE EQUALS NOTHING
-- s 102 (1) (c): if a relevant provision has been omitted and remade in another law since the reference was made, the law in which it was remade.
#ASSERT `s 102 (1): a reference to a law includes a reference to the version` `the law in which a relevant provision was remade (or last remade), as in force when the provision was remade` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 102 (1): a reference to a law includes a reference to the version` `the law in which a relevant provision was remade (or last remade), as amended from time to time since` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 102 (1): a reference to a law includes a reference to the version` `the law in which a relevant provision was remade (or last remade), as in force when the provision was remade` TRUE TRUE FALSE EQUALS NOTHING
-- s 102 (1): the rule is for a reference in an ACT law.
#ASSERT `s 102 (1): a reference to a law includes a reference to the version` `the law as originally made` FALSE FALSE FALSE EQUALS NOTHING

-- s 102 (2) (a): the provision as originally made, and as amended.
#ASSERT `s 102 (2): a reference to a provision of a law includes a reference to the version` `the provision as originally made` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 102 (2): a reference to a provision of a law includes a reference to the version` `the provision as amended from time to time since it was originally made` TRUE FALSE EQUALS JUST TRUE
-- s 102 (2) (b): if the provision has been omitted and remade since the reference was made.
#ASSERT `s 102 (2): a reference to a provision of a law includes a reference to the version` `the provision as remade (or last remade)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 102 (2): a reference to a provision of a law includes a reference to the version` `the provision as amended from time to time since it was remade (or last remade)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 102 (2): a reference to a provision of a law includes a reference to the version` `the provision as remade (or last remade)` TRUE FALSE EQUALS NOTHING
#ASSERT `s 102 (2): a reference to a provision of a law includes a reference to the version` `the provision as originally made` FALSE FALSE EQUALS NOTHING

-- s 102 (3): if the name of a law is amended, a reference in an ACT law to the law by its earlier name includes the law by its amended name.
#ASSERT `s 102 (3): the reference includes a reference to the law by its name as amended` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 102 (3): the reference includes a reference to the law by its name as amended` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 102 (3): the reference includes a reference to the law by its name as amended` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 102 (3): the reference includes a reference to the law by its name as amended` FALSE TRUE TRUE EQUALS NOTHING

-- s 102 (4): this section is subject to section 47.
#ASSERT `s 102 (4): the sections that s 102 is subject to` EQUALS LIST "47"

§§ `Sections 103 to 106A`

-- s 103: a reference to a law as repealed is a reference to the law as in force immediately before it was repealed.
#ASSERT `s 103: the reference is a reference to the law as in force immediately before it was repealed` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 103: the reference is a reference to the law as in force immediately before it was repealed` TRUE FALSE EQUALS NOTHING
#ASSERT `s 103: the reference is a reference to the law as in force immediately before it was repealed` FALSE TRUE EQUALS NOTHING

-- s 104 (1): a reference, generally or specifically, to a law includes the statutory instruments made or in force under the law.
#ASSERT `s 104 (1): the reference includes a reference to the statutory instrument` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 104 (1): the reference includes a reference to the statutory instrument` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 104 (1): the reference includes a reference to the statutory instrument` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 104 (1): the reference includes a reference to the statutory instrument` FALSE TRUE TRUE EQUALS NOTHING
-- s 104 (2): that includes any law or instrument applied, adopted or incorporated under the law.
#ASSERT `s 104 (2): the reference to the statutory instruments made or in force under the law includes a reference to the law or instrument` TRUE EQUALS JUST TRUE
#ASSERT `s 104 (2): the reference to the statutory instruments made or in force under the law includes a reference to the law or instrument` FALSE EQUALS NOTHING
-- s 104 (3): this chapter applies to an instrument applied, adopted or incorporated under a law as if it were a law.
#ASSERT `s 104 (3): this chapter applies to the instrument as if it were a law, with any other necessary changes made` TRUE EQUALS JUST TRUE
#ASSERT `s 104 (3): this chapter applies to the instrument as if it were a law, with any other necessary changes made` FALSE EQUALS NOTHING

-- s 105 Example: paragraph (b) of subsection (2) of section 10 of an Act may be referred to by the section, subsection and paragraph, as section 10 (2) (b).
#ASSERT `s 105: the provision of the law may be referred to in the way` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 105: the provision of the law may be referred to in the way` TRUE FALSE EQUALS NOTHING
#ASSERT `s 105: the provision of the law may be referred to in the way` FALSE TRUE EQUALS NOTHING

-- s 106 Example 1: a reference to "sections 5 to 9" includes both section 5 and section 9.
#ASSERT `s 106: the provision is within a reference to the part of the law` 5 5 9 EQUALS JUST TRUE
#ASSERT `s 106: the provision is within a reference to the part of the law` 9 5 9 EQUALS JUST TRUE
-- s 106 (c): any provision between the beginning and the end.
#ASSERT `s 106: the provision is within a reference to the part of the law` 7 5 9 EQUALS JUST TRUE
-- s 106 Example 2: a reference to "sections 260 to 264" includes a provision such as a part heading between section 260 and section 261.
#ASSERT `s 106: the provision is within a reference to the part of the law` 260.5 260 264 EQUALS JUST TRUE
-- s 106 Example 3: a reference to "from child to adult" includes both the word "child" and the word "adult" (words counted along the law).
#ASSERT `s 106: the provision is within a reference to the part of the law` 12 12 15 EQUALS JUST TRUE
#ASSERT `s 106: the provision is within a reference to the part of the law` 15 12 15 EQUALS JUST TRUE
-- Outside the part: before its beginning or after its end.
#ASSERT `s 106: the provision is within a reference to the part of the law` 4 5 9 EQUALS JUST FALSE
#ASSERT `s 106: the provision is within a reference to the part of the law` 10 5 9 EQUALS JUST FALSE

-- s 106A (1): a reference to a paragraph includes the words before or after it that are necessary or desirable to make the reference meaningful.
#ASSERT `s 106A (1): the reference includes the words` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 106A (1): the reference includes the words` TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 106A (1): the reference includes the words` TRUE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 106A (1): the reference includes the words` TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 106A (1): the reference includes the words` FALSE TRUE TRUE TRUE EQUALS NOTHING
