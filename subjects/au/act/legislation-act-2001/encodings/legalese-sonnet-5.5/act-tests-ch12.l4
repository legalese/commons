IMPORT prelude
IMPORT `act-ch12-scope`

-- Tests for act-ch12-scope.l4.
-- Every expected value is read from the section named beside the assertion, and was written before the run.

§ `Tests: chapter 12, Scope of Acts and statutory instruments`

§§ `Section 120`

-- s 120 (1): an Act is interpreted as operating to the full extent of, but not to exceed, the legislative power.
#ASSERT `s 120 (1): the interpretation of the Act is the one the section directs` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 120 (1): the interpretation of the Act is the one the section directs` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 120 (1): the interpretation of the Act is the one the section directs` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 120 (1): the interpretation of the Act is the one the section directs` FALSE FALSE EQUALS NOTHING

-- s 120 (2) (a): a provision that would be interpreted as exceeding the power is effective to the extent to which it does not exceed the power.
#ASSERT `s 120 (2) (a): the provision is effective as to the part` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 120 (2) (a): the provision is effective as to the part` TRUE TRUE EQUALS NOTHING
#ASSERT `s 120 (2) (a): the provision is effective as to the part` FALSE FALSE EQUALS NOTHING
-- s 120 (2) (b): the remainder of the Act is not affected.
#ASSERT `s 120 (2) (b): the remainder of the Act is affected` TRUE EQUALS JUST FALSE
#ASSERT `s 120 (2) (b): the remainder of the Act is affected` FALSE EQUALS NOTHING
-- s 120 (3): if the application of the provision to a matter would exceed the power, its application to other matters is not affected.
#ASSERT `s 120 (3): the provision's application to other matters is affected` TRUE EQUALS JUST FALSE
#ASSERT `s 120 (3): the provision's application to other matters is affected` FALSE EQUALS NOTHING
-- s 120 (4): this section is in addition to any provision of the Act itself.
#ASSERT `s 120 (4): this section is in addition to any provision of the Act itself`

§§ `Section 121`

-- s 121 (1): an Act binds everyone, including people who are not Australian citizens and all governments.
#ASSERT `s 121 (1), (2): the Act binds the subject` `an Australian citizen` FALSE EQUALS JUST TRUE
#ASSERT `s 121 (1), (2): the Act binds the subject` `a person who is not an Australian citizen` FALSE EQUALS JUST TRUE
#ASSERT `s 121 (1), (2): the Act binds the subject` `the Commonwealth (as a government)` FALSE EQUALS JUST TRUE
#ASSERT `s 121 (1), (2): the Act binds the subject` `a State (as a government)` FALSE EQUALS JUST TRUE
#ASSERT `s 121 (1), (2): the Act binds the subject` `another Territory (as a government)` FALSE EQUALS JUST TRUE
#ASSERT `s 121 (1), (2): the Act binds the subject` `New Zealand (as a government)` FALSE EQUALS JUST TRUE
#ASSERT `s 121 (1), (2): the Act binds the subject` `anyone or anything else` FALSE EQUALS JUST TRUE
#ASSERT `s 121 (1), (2): the Act binds the subject` `the Territory (as a government)` FALSE EQUALS JUST TRUE
-- s 121 (2): an Act does not bind the Territory to the extent that it requires payment of money that would form part of the public money of the Territory.
#ASSERT `s 121 (1), (2): the Act binds the subject` `the Territory (as a government)` TRUE EQUALS JUST FALSE
#ASSERT `s 121 (1), (2): the Act binds the subject` `the Commonwealth (as a government)` TRUE EQUALS JUST TRUE

-- s 121 (3): subsection (1) does not make a government liable to be prosecuted for an offence.
#ASSERT `s 121 (3): subsection (1) makes the subject liable to be prosecuted for an offence` `the Territory (as a government)` EQUALS JUST FALSE
#ASSERT `s 121 (3): subsection (1) makes the subject liable to be prosecuted for an offence` `the Commonwealth (as a government)` EQUALS JUST FALSE
#ASSERT `s 121 (3): subsection (1) makes the subject liable to be prosecuted for an offence` `a State (as a government)` EQUALS JUST FALSE
#ASSERT `s 121 (3): subsection (1) makes the subject liable to be prosecuted for an offence` `another Territory (as a government)` EQUALS JUST FALSE
#ASSERT `s 121 (3): subsection (1) makes the subject liable to be prosecuted for an offence` `New Zealand (as a government)` EQUALS JUST FALSE
#ASSERT `s 121 (3): subsection (1) makes the subject liable to be prosecuted for an offence` `an Australian citizen` EQUALS NOTHING
#ASSERT `s 121 (3): subsection (1) makes the subject liable to be prosecuted for an offence` `anyone or anything else` EQUALS NOTHING

-- s 121 (6): government includes the Territory, the Commonwealth, a State, another Territory or New Zealand.
#ASSERT `s 121 (6): the subject is a government` `the Territory (as a government)` EQUALS JUST TRUE
#ASSERT `s 121 (6): the subject is a government` `the Commonwealth (as a government)` EQUALS JUST TRUE
#ASSERT `s 121 (6): the subject is a government` `a State (as a government)` EQUALS JUST TRUE
#ASSERT `s 121 (6): the subject is a government` `another Territory (as a government)` EQUALS JUST TRUE
#ASSERT `s 121 (6): the subject is a government` `New Zealand (as a government)` EQUALS JUST TRUE
#ASSERT `s 121 (6): the subject is a government` `an Australian citizen` EQUALS NOTHING
#ASSERT `s 121 (6): the subject is a government` `a person who is not an Australian citizen` EQUALS NOTHING
#ASSERT `s 121 (6): the subject is a government` `anyone or anything else` EQUALS NOTHING

-- s 121 (6): government entity includes (a) an instrumentality, officer or employee of the government, and (b) a contractor or anyone else who exercises a function on its behalf.
#ASSERT `s 121 (6): the entity is a government entity` `an instrumentality of the government` EQUALS JUST TRUE
#ASSERT `s 121 (6): the entity is a government entity` `an officer or employee of the government` EQUALS JUST TRUE
#ASSERT `s 121 (6): the entity is a government entity` `a contractor who exercises a function on behalf of the government` EQUALS JUST TRUE
#ASSERT `s 121 (6): the entity is a government entity` `anyone else who exercises a function on behalf of the government` EQUALS JUST TRUE
#ASSERT `s 121 (6): the entity is a government entity` `some other kind of entity` EQUALS NOTHING

-- s 121 (6): authorised: (a) an instrumentality: within the scope of its functions; (b) an officer or employee: within the scope of the duties;
-- (c) a contractor: within the scope of the contract; (d) anyone else exercising a function for the government: within the scope of the person's engagement.
#ASSERT `s 121 (6): the act or omission of the government entity is authorised` `an instrumentality of the government` TRUE EQUALS JUST TRUE
#ASSERT `s 121 (6): the act or omission of the government entity is authorised` `an instrumentality of the government` FALSE EQUALS JUST FALSE
#ASSERT `s 121 (6): the act or omission of the government entity is authorised` `an officer or employee of the government` TRUE EQUALS JUST TRUE
#ASSERT `s 121 (6): the act or omission of the government entity is authorised` `an officer or employee of the government` FALSE EQUALS JUST FALSE
#ASSERT `s 121 (6): the act or omission of the government entity is authorised` `a contractor who exercises a function on behalf of the government` TRUE EQUALS JUST TRUE
#ASSERT `s 121 (6): the act or omission of the government entity is authorised` `a contractor who exercises a function on behalf of the government` FALSE EQUALS JUST FALSE
#ASSERT `s 121 (6): the act or omission of the government entity is authorised` `anyone else who exercises a function on behalf of the government` TRUE EQUALS JUST TRUE
#ASSERT `s 121 (6): the act or omission of the government entity is authorised` `anyone else who exercises a function on behalf of the government` FALSE EQUALS JUST FALSE
#ASSERT `s 121 (6): the act or omission of the government entity is authorised` `some other kind of entity` TRUE EQUALS NOTHING

-- s 121 (4): to the extent that an Act does not bind a government, the same degree of immunity extends to a government entity for an authorised act or omission.
#ASSERT `s 121 (4): the same degree of immunity extends to the government entity` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 121 (4): the same degree of immunity extends to the government entity` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 121 (4): the same degree of immunity extends to the government entity` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 121 (4): the same degree of immunity extends to the government entity` TRUE TRUE FALSE EQUALS NOTHING

§§ `Section 122`

-- s 122 (1) (a): a reference to an entity or position by name or description is a reference to the one in or for the Territory.
#ASSERT `s 122 (1) (a): the reference is a reference to the entity or position of that name or description in or for the Territory` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 122 (1) (a): the reference is a reference to the entity or position of that name or description in or for the Territory` FALSE TRUE EQUALS NOTHING
#ASSERT `s 122 (1) (a): the reference is a reference to the entity or position of that name or description in or for the Territory` TRUE FALSE EQUALS NOTHING
-- s 122 (1) (b): a reference to a place, jurisdiction or anything else by name or description is a reference to the one in or for the Territory.
#ASSERT `s 122 (1) (b): the reference is a reference to the place, jurisdiction or thing of that name or description in or for the Territory` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 122 (1) (b): the reference is a reference to the place, jurisdiction or thing of that name or description in or for the Territory` FALSE TRUE EQUALS NOTHING
#ASSERT `s 122 (1) (b): the reference is a reference to the place, jurisdiction or thing of that name or description in or for the Territory` TRUE FALSE EQUALS NOTHING
-- s 122 (2): where the name includes the words 'of the Australian Capital Territory' or the like, a reference need not include the words.
#ASSERT `s 122 (2): the reference must include the words` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 122 (2): the reference must include the words` TRUE FALSE EQUALS NOTHING
#ASSERT `s 122 (2): the reference must include the words` FALSE TRUE EQUALS NOTHING
