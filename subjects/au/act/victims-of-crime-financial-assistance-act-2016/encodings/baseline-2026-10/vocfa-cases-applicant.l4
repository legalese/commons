-- =====================================================================================================================
-- CASE 13. A leap day. HYPOTHETICAL: an assault on 29 February 2028 on an adult born 2 May 1991.
-- =====================================================================================================================

-- READING: 3 years after 29 February 2028 is 28 February 2031 (2031 has no 29 February).
#ASSERT `What is the last day to apply for financial assistance` `29 Feb 2028` `2 May 1991` EQUALS DATE_FROM_DMY 28 2 2031

-- =====================================================================================================================
-- REGULATIVE RULES (vocfa-core.l4). Clock: days.
-- =====================================================================================================================

-- ss 31 to 33. Mia (case 1): 14 March 2026 to 14 March 2029 is 1 096 days (2028 has 29 February).
-- A complying application on day 100, the s 33 notice on day 110.
#ASSERT EVALTRACE (`ss 31 to 33 -- the applicant may apply within 3 years, or later if the commissioner extends the time` 1096) 0 (LIST (EVENT `the applicant` (`apply for financial assistance` TRUE) 100), (EVENT `the commissioner` `give the applicant written notice about repayment and recovery (s 33)` 110)) EQUALS FULFILLED
-- An application that does not meet s 31 (2) does not count; the later complying one does.
#ASSERT EVALTRACE (`ss 31 to 33 -- the applicant may apply within 3 years, or later if the commissioner extends the time` 1096) 0 (LIST (EVENT `the applicant` (`apply for financial assistance` FALSE) 50), (EVENT `the applicant` (`apply for financial assistance` TRUE) 100), (EVENT `the commissioner` `give the applicant written notice about repayment and recovery (s 33)` 105)) EQUALS FULFILLED
-- Late, but the commissioner extends the time (s 32 (2)), then she applies and is given the notice.
#ASSERT EVALTRACE (`ss 31 to 33 -- the applicant may apply within 3 years, or later if the commissioner extends the time` 1096) 0 (LIST (WAITUNTIL 1100), (EVENT `the commissioner` `extend the time for making the application (s 32 (2))` 1120), (EVENT `the applicant` (`apply for financial assistance` TRUE) 1130), (EVENT `the commissioner` `give the applicant written notice about repayment and recovery (s 33)` 1140)) EQUALS FULFILLED
-- expect: still waiting on the commissioner's permission to extend (a late application on day 1101 does not count)
#TRACE `ss 31 to 33 -- the applicant may apply within 3 years, or later if the commissioner extends the time` 1096 AT 0 WITH
    (WAITUNTIL 1100)
    PARTY `the applicant` DOES `apply for financial assistance` TRUE AT 1101
-- expect: the commissioner still owes the s 33 notice (no time is set, so never a breach by time alone)
#TRACE `ss 31 to 33 -- the applicant may apply within 3 years, or later if the commissioner extends the time` 1096 AT 0 WITH
    PARTY `the applicant` DOES `apply for financial assistance` TRUE AT 100
    (WAITUNTIL 2000)

-- s 45. Notice on day 0; Mia answers on day 10; the commissioner decides no disqualifying circumstance on day 20.
#ASSERT EVALTRACE (`s 45 -- notice of a disqualifying circumstance, 14 days to answer, then the decision` FALSE) 0 (LIST (EVENT `the commissioner` `give the applicant written notice of the apparent disqualifying circumstance (s 45 (2))` 0), (EVENT `the applicant` `tell the commissioner in writing why the disqualifying circumstance does not apply` 10), (EVENT `the commissioner` `decide whether a disqualifying circumstance applies, and tell the applicant (s 45 (3))` 20)) EQUALS FULFILLED
-- She need not answer: after the 14 days the decision follows.
#ASSERT EVALTRACE (`s 45 -- notice of a disqualifying circumstance, 14 days to answer, then the decision` FALSE) 0 (LIST (EVENT `the commissioner` `give the applicant written notice of the apparent disqualifying circumstance (s 45 (2))` 0), (WAITUNTIL 15), (EVENT `the commissioner` `decide whether a disqualifying circumstance applies, and tell the applicant (s 45 (3))` 20)) EQUALS FULFILLED
-- expect: BREACH BY the commissioner, "s 45 (4): ..." (decided one applies on day 20, paid assistance on day 30)
#TRACE `s 45 -- notice of a disqualifying circumstance, 14 days to answer, then the decision` TRUE AT 0 WITH
    PARTY `the commissioner` DOES `give the applicant written notice of the apparent disqualifying circumstance (s 45 (2))` AT 0
    PARTY `the applicant` DOES `tell the commissioner in writing why the disqualifying circumstance does not apply` AT 5
    PARTY `the commissioner` DOES `decide whether a disqualifying circumstance applies, and tell the applicant (s 45 (3))` AT 20
    PARTY `the commissioner` DOES `give the applicant financial assistance` AT 30

-- ss 52, 54, 55. Sarah (case 5): 1 August 2026 to 1 August 2029 is 1 096 days. Applies on day 45; notice on day 50.
#ASSERT EVALTRACE (`ss 52, 54, 55 -- the applicant may apply for a funeral expense payment within 3 years after the death` 1096) 0 (LIST (EVENT `the applicant` (`apply for a funeral expense payment` TRUE) 45), (EVENT `the commissioner` `give the applicant written notice about repayment and recovery (s 55)` 50)) EQUALS FULFILLED
-- Not applying is no breach.
#ASSERT EVALTRACE (`ss 52, 54, 55 -- the applicant may apply for a funeral expense payment within 3 years after the death` 1096) 0 (LIST (WAITUNTIL 1100)) EQUALS FULFILLED
-- expect: the commissioner still owes the s 55 notice
#TRACE `ss 52, 54, 55 -- the applicant may apply for a funeral expense payment within 3 years after the death` 1096 AT 0 WITH
    PARTY `the applicant` DOES `apply for a funeral expense payment` TRUE AT 45
    (WAITUNTIL 400)

-- s 64, then ss 66, 67. Mia (case 9) receives the damages on day 0, with a repayment date 28 days after a direction.
-- She tells the commissioner on day 20; the arrangement notice comes on day 30; she contacts the commissioner on day 40.
#ASSERT EVALTRACE (`s 64 -- the assisted person must tell the commissioner about an associated payment within 28 days` TRUE 28) 0 (LIST (EVENT `the assisted person` `tell the commissioner in writing about the associated payment` 20), (EVENT `the commissioner` `give the assisted person a repayment arrangement notice (s 66 (1))` 30), (EVENT `the assisted person` (`respond to the repayment arrangement notice` `by contacting the commissioner to arrange to pay or vary the repayment amount`) 40)) EQUALS FULFILLED
-- No contact within 28 days of the arrangement notice: a direction notice on day 62; she pays on day 80 (by day 90).
#ASSERT EVALTRACE (`s 64 -- the assisted person must tell the commissioner about an associated payment within 28 days` TRUE 28) 0 (LIST (EVENT `the assisted person` `tell the commissioner in writing about the associated payment` 20), (EVENT `the commissioner` `give the assisted person a repayment arrangement notice (s 66 (1))` 30), (WAITUNTIL 60), (EVENT `the commissioner` `give the assisted person a repayment direction notice (s 67 (2))` 62), (EVENT `the assisted person` (`respond to the repayment direction notice` `by applying to the ACAT for review of the repayment direction notice`) 80)) EQUALS FULFILLED
-- Received before the assistance: s 64 does not apply.
#ASSERT EVALTRACE (`s 64 -- the assisted person must tell the commissioner about an associated payment within 28 days` FALSE 28) 0 (LIST (WAITUNTIL 100)) EQUALS FULFILLED
-- expect: BREACH BY the assisted person, "s 64 (2), (3): ... offence ..." (she says nothing; day 29 passes)
#TRACE `s 64 -- the assisted person must tell the commissioner about an associated payment within 28 days` TRUE 28 AT 0 WITH
    (WAITUNTIL 29)
-- expect: BREACH BY the assisted person, "s 65, s 67 (3): ... debt due to the Territory" (direction on day 62; nothing by day 90)
#TRACE `s 64 -- the assisted person must tell the commissioner about an associated payment within 28 days` TRUE 28 AT 0 WITH
    PARTY `the assisted person` DOES `tell the commissioner in writing about the associated payment` AT 20
    PARTY `the commissioner` DOES `give the assisted person a repayment arrangement notice (s 66 (1))` AT 30
    (WAITUNTIL 60)
    PARTY `the commissioner` DOES `give the assisted person a repayment direction notice (s 67 (2))` AT 62
    (WAITUNTIL 100)

-- s 96. expect: BREACH BY the applicant's lawyer, "s 96 (1), reg s 12: ..." ($2 000 for an application)
#TRACE `s 96 -- the applicant's lawyer must not charge more than the prescribed legal costs` `legal services for an application for financial assistance` AT 0 WITH
    PARTY `the applicant's lawyer` DOES `charge or seek to recover legal costs of` 2000 AT 10
-- expect: still in force, no breach ($1 455 is the limit, not over it)
#TRACE `s 96 -- the applicant's lawyer must not charge more than the prescribed legal costs` `legal services for an application for financial assistance` AT 0 WITH
    PARTY `the applicant's lawyer` DOES `charge or seek to recover legal costs of` 1455 AT 10
-- expect: still in force, no breach ($2 000 is under the $2 910 limit for a review)
#TRACE `s 96 -- the applicant's lawyer must not charge more than the prescribed legal costs` `legal services for an appeal or review process under the Act` AT 0 WITH
    PARTY `the applicant's lawyer` DOES `charge or seek to recover legal costs of` 2000 AT 10
