-- =====================================================================================================================
-- CASE 9. Repayment. HYPOTHETICAL: Mia (case 1) was given $65 459. On 10 February 2027 she receives $20 000 in damages
-- from the offender, $12 000 of it for lost earnings and medical costs (the same loss) and the rest for pain.
-- =====================================================================================================================

-- s 64 (2): within 28 days after 10 February 2027 (February 2027 has 28 days): 10 March 2027.
#ASSERT `Must I tell the commissioner about a payment, and by when` TRUE TRUE (DATE_FROM_DMY 10 2 2027) EQUALS `must tell the commissioner in writing, by` (DATE_FROM_DMY 10 3 2027)
-- Received before any assistance was paid: s 64 does not apply; s 47 (1) (a) reduces the assistance instead.
#ASSERT `Must I tell the commissioner about a payment, and by when` TRUE FALSE (DATE_FROM_DMY 10 2 2027) EQUALS `nothing to tell under s 64: it was received before any assistance was paid, so it may reduce the assistance instead (s 47 (1) (a))`
-- A payment not made as a result of the act is not an associated payment.
#ASSERT `Must I tell the commissioner about a payment, and by when` FALSE TRUE (DATE_FROM_DMY 10 2 2027) EQUALS `nothing to tell under s 64: it is not an associated payment, as it was not paid as a result of the act of violence`
-- s 62: the lesser of 65 459 and 12 000: 12 000.
#ASSERT `How much might I have to repay` 65459 12000 EQUALS 12000
-- Damages only for pain and suffering (no same loss): the repayment amount is 0, though s 64 still required her to tell.
#ASSERT `How much might I have to repay` 65459 0 EQUALS 0
-- A smaller grant of $5 000 against $12 000 for the same loss: 5 000.
#ASSERT `How much might I have to repay` 5000 12000 EQUALS 5000
-- s 66 (2): notice received 1 April 2027; 28 days later, 29 April 2027.
#ASSERT `By when must I contact the commissioner about repaying` (DATE_FROM_DMY 1 4 2027) EQUALS DATE_FROM_DMY 29 4 2027
-- s 65: a direction notice, neither paid nor reviewed by the repayment date: a debt due to the Territory.
#ASSERT `Am I liable to repay` TRUE TRUE FALSE FALSE FALSE EQUALS `liable: the repayment amount is a debt due to the Territory (s 65 (2), (3))`
-- s 67 (4): applied to the ACAT by the date: stayed. (5): dismissed: the stay ends.
#ASSERT `Am I liable to repay` TRUE TRUE FALSE TRUE FALSE EQUALS `liability stayed: an application to the ACAT for review was made by the repayment date (s 67 (4))`
#ASSERT `Am I liable to repay` TRUE TRUE FALSE TRUE TRUE EQUALS `liable: the ACAT dismissed the application for review, which removes the stay (s 67 (5))`
#ASSERT `Am I liable to repay` TRUE TRUE TRUE FALSE FALSE EQUALS `not liable: the repayment amount was paid by the repayment date`
#ASSERT `Am I liable to repay` TRUE FALSE FALSE FALSE FALSE EQUALS `not liable to repay under s 65 unless given a repayment direction notice and the repayment date passes`
#ASSERT `Am I liable to repay` FALSE FALSE FALSE FALSE FALSE EQUALS `not liable to repay under s 65: no associated payment after the assistance`

