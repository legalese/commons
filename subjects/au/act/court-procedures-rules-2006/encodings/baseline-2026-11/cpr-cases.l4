§ `r 1725 -- costs on a Supreme Court judgment the Magistrates Court could have given`

#ASSERT `r 1725 -- what costs do I get on a Supreme Court judgment under $175,000` TRUE TRUE 49999 FALSE EQUALS `1725 B`
#ASSERT `r 1725 -- what costs do I get on a Supreme Court judgment under $175,000` TRUE TRUE 50000 FALSE EQUALS `1725 C`
#ASSERT `r 1725 -- what costs do I get on a Supreme Court judgment under $175,000` TRUE TRUE 99999 FALSE EQUALS `1725 C`
#ASSERT `r 1725 -- what costs do I get on a Supreme Court judgment under $175,000` TRUE TRUE 100000 FALSE EQUALS `1725 D`
#ASSERT `r 1725 -- what costs do I get on a Supreme Court judgment under $175,000` TRUE TRUE 174999 FALSE EQUALS `1725 D`
#ASSERT `r 1725 -- what costs do I get on a Supreme Court judgment under $175,000` TRUE TRUE 175000 FALSE EQUALS `1725 NA`
#ASSERT `r 1725 -- what costs do I get on a Supreme Court judgment under $175,000` TRUE FALSE 60000 FALSE EQUALS `1725 NA`
#ASSERT `r 1725 -- what costs do I get on a Supreme Court judgment under $175,000` FALSE TRUE 60000 FALSE EQUALS `1725 NA`
#ASSERT `r 1725 -- what costs do I get on a Supreme Court judgment under $175,000` TRUE TRUE 60000 TRUE EQUALS `1725 ORDERED`

§ `r 1002 (5), r 1003, r 1004 -- making, accepting and withdrawing`

-- Trial set down for 15 November 2027; 2 months before is 15 September 2027.
#ASSERT `r 1002 (5) -- is the acceptance period long enough` (`on` 15 9 2027) TRUE (`on` 15 11 2027) (`on` 13 10 2027) FALSE
#ASSERT NOT (`r 1002 (5) -- is the acceptance period long enough` (`on` 15 9 2027) TRUE (`on` 15 11 2027) (`on` 12 10 2027) TRUE)
-- Made 16 September 2027: less than 2 months before, so the period need only be reasonable.
#ASSERT `r 1002 (5) -- is the acceptance period long enough` (`on` 16 9 2027) TRUE (`on` 15 11 2027) (`on` 20 9 2027) TRUE
#ASSERT NOT (`r 1002 (5) -- is the acceptance period long enough` (`on` 16 9 2027) TRUE (`on` 15 11 2027) (`on` 30 10 2027) FALSE)
-- No trial date set: read literally, only "reasonable" (finding 2).
#ASSERT NOT (`r 1002 (5) -- is the acceptance period long enough` (`on` 1 3 2026) FALSE `any day` (`on` 1 5 2026) FALSE)

#ASSERT `r 1003 -- can I still accept the offer` (`on` 30 6 2026) FALSE (`on` 30 6 2026)
#ASSERT NOT (`r 1003 -- can I still accept the offer` (`on` 30 6 2026) FALSE (`on` 1 7 2026))
#ASSERT NOT (`r 1003 -- can I still accept the offer` (`on` 30 6 2026) TRUE (`on` 20 6 2026))

-- Accepted 1 March 2026: payment due by 29 March 2026.
#ASSERT NOT (`r 1004 -- can I withdraw my acceptance for non-payment` (`on` 1 3 2026) FALSE 0 FALSE `any day` FALSE (`on` 29 3 2026))
#ASSERT `r 1004 -- can I withdraw my acceptance for non-payment` (`on` 1 3 2026) FALSE 0 FALSE `any day` FALSE (`on` 30 3 2026)
#ASSERT NOT (`r 1004 -- can I withdraw my acceptance for non-payment` (`on` 1 3 2026) FALSE 0 TRUE (`on` 29 3 2026) FALSE (`on` 10 4 2026))
-- Paid late, on 31 March 2026: the right has arisen (fork F13).
#ASSERT `r 1004 -- can I withdraw my acceptance for non-payment` (`on` 1 3 2026) FALSE 0 TRUE (`on` 31 3 2026) FALSE (`on` 10 4 2026)
#ASSERT `r 1004 -- can I withdraw my acceptance for non-payment` (`on` 1 3 2026) FALSE 0 TRUE (`on` 5 3 2026) TRUE (`on` 10 3 2026)
-- The offer allows 14 days: due by 15 March 2026.
#ASSERT NOT (`r 1004 -- can I withdraw my acceptance for non-payment` (`on` 1 3 2026) TRUE 14 FALSE `any day` FALSE (`on` 15 3 2026))
#ASSERT `r 1004 -- can I withdraw my acceptance for non-payment` (`on` 1 3 2026) TRUE 14 FALSE `any day` FALSE (`on` 16 3 2026)
-- Accepted 10 December 2026: due by 15 January 2027.
#ASSERT NOT (`r 1004 -- can I withdraw my acceptance for non-payment` (`on` 10 12 2026) FALSE 0 FALSE `any day` FALSE (`on` 15 1 2027))
#ASSERT `r 1004 -- can I withdraw my acceptance for non-payment` (`on` 10 12 2026) FALSE 0 FALSE `any day` FALSE (`on` 16 1 2027)

§ `r 1009 to r 1014 -- the costs that follow an offer`

#ASSERT `Part 2.10 -- what costs follow the offer` `DEF` `ACCEPTED` FALSE 100000 0 0 TRUE TRUE FALSE EQUALS `1009 P`
#ASSERT `Part 2.10 -- what costs follow the offer` `ME` `ACCEPTED` FALSE 0 0 0 FALSE TRUE FALSE EQUALS `1009 D`
#ASSERT `Part 2.10 -- what costs follow the offer` `DEF` `ACCEPTED` TRUE 100000 0 0 TRUE TRUE FALSE EQUALS `NO OFFER ORDER`
-- My offer of $100 000; judgment exactly $100 000.
#ASSERT `Part 2.10 -- what costs follow the offer` `ME` `FOR ME` FALSE 100000 100000 0 TRUE TRUE FALSE EQUALS `1010 A`
#ASSERT `Part 2.10 -- what costs follow the offer` `ME` `FOR ME` FALSE 100000 100000 0 FALSE TRUE FALSE EQUALS `1010 B`
#ASSERT `Part 2.10 -- what costs follow the offer` `ME` `FOR ME` FALSE 100000 99999 0 TRUE TRUE FALSE EQUALS `NO OFFER ORDER`
-- $105 000 of which $6 000 is interest after the offer: compared as $99 000 (r 1013).
#ASSERT `Part 2.10 -- what costs follow the offer` `ME` `FOR ME` FALSE 100000 105000 6000 TRUE TRUE FALSE EQUALS `NO OFFER ORDER`
#ASSERT `Part 2.10 -- what costs follow the offer` `ME` `FOR ME` FALSE 100000 105000 5000 TRUE TRUE FALSE EQUALS `1010 A`
-- The defendant's offer of $100 000.
#ASSERT `Part 2.10 -- what costs follow the offer` `DEF` `FOR ME` FALSE 100000 100000 0 TRUE TRUE FALSE EQUALS `1011 A`
#ASSERT `Part 2.10 -- what costs follow the offer` `DEF` `FOR ME` FALSE 100000 80000 0 FALSE TRUE FALSE EQUALS `1011 B`
#ASSERT `Part 2.10 -- what costs follow the offer` `DEF` `FOR ME` FALSE 100000 100001 0 TRUE TRUE FALSE EQUALS `NO OFFER ORDER`
#ASSERT `Part 2.10 -- what costs follow the offer` `DEF` `FOR ME` FALSE 100000 80000 0 TRUE FALSE FALSE EQUALS `NO OFFER ORDER`
#ASSERT `Part 2.10 -- what costs follow the offer` `DEF` `FOR DEF` FALSE 0 0 0 TRUE TRUE FALSE EQUALS `1012`
-- r 1014 (3) does not touch r 1012.
#ASSERT `Part 2.10 -- what costs follow the offer` `DEF` `FOR DEF` FALSE 50000 0 0 TRUE FALSE FALSE EQUALS `1012`
#ASSERT `Part 2.10 -- what costs follow the offer` `ME` `FOR DEF` FALSE 100000 0 0 TRUE TRUE FALSE EQUALS `NO OFFER ORDER`
#ASSERT `Part 2.10 -- what costs follow the offer` `ME` `FOR ME` FALSE 100000 200000 0 TRUE TRUE TRUE EQUALS `OFFER ORDERED OTHERWISE`

-- Offer made 1 March 2026, acceptance period to 29 March 2026, trial from 1 June 2026.
#ASSERT `r 1010 to r 1012 -- from when do the offer costs change` `SWITCH 1010 1011` (`on` 1 3 2026) (`on` 1 6 2026) (`on` 29 3 2026) EQUALS `from the start of` (`on` 29 3 2026)
#ASSERT `r 1010 to r 1012 -- from when do the offer costs change` `SWITCH 1012` (`on` 1 3 2026) (`on` 1 6 2026) (`on` 29 3 2026) EQUALS `from the start of` (`on` 2 3 2026)
-- Made on the first day of the trial, or later: 11 am on the next day.
#ASSERT `r 1010 to r 1012 -- from when do the offer costs change` `SWITCH 1010 1011` (`on` 1 6 2026) (`on` 1 6 2026) (`on` 3 6 2026) EQUALS `at and from 11 am on` (`on` 2 6 2026)
#ASSERT `r 1010 to r 1012 -- from when do the offer costs change` `SWITCH 1012` (`on` 3 6 2026) (`on` 1 6 2026) (`on` 5 6 2026) EQUALS `at and from 11 am on` (`on` 4 6 2026)

§ `r 1619 (7), (8) -- interest after the defendant's offer`

#ASSERT `r 1619 (7) -- can I get interest after the defendant's offer` TRUE TRUE 100000 110000 FALSE EQUALS `NO LATER INTEREST`
#ASSERT `r 1619 (7) -- can I get interest after the defendant's offer` TRUE TRUE 100000 110001 FALSE EQUALS `NOT SETTLED`
#ASSERT `r 1619 (7) -- can I get interest after the defendant's offer` TRUE TRUE 100000 90000 FALSE EQUALS `NO LATER INTEREST`
#ASSERT `r 1619 (7) -- can I get interest after the defendant's offer` TRUE TRUE 100000 105000 TRUE EQUALS `SPECIAL`
#ASSERT `r 1619 (7) -- can I get interest after the defendant's offer` TRUE FALSE 0 105000 FALSE EQUALS `NO OFFER`
#ASSERT `r 1619 (7) -- can I get interest after the defendant's offer` FALSE TRUE 100000 105000 FALSE EQUALS `NOT DAMAGES`

§ `r 1620 -- interest on the judgment`

-- Judgment took effect 1 March 2026: 28 days end 29 March 2026.
#ASSERT `r 1620 -- will interest run on my judgment` (`on` 1 3 2026) TRUE (`on` 29 3 2026) FALSE (`on` 1 4 2026) EQUALS `NO JUDGMENT INTEREST`
#ASSERT `r 1620 -- will interest run on my judgment` (`on` 1 3 2026) TRUE (`on` 30 3 2026) FALSE (`on` 1 4 2026) EQUALS `JUDGMENT INTEREST`
#ASSERT `r 1620 -- will interest run on my judgment` (`on` 1 3 2026) FALSE `any day` FALSE (`on` 29 3 2026) EQUALS `JUDGMENT INTEREST NOT YET`
#ASSERT `r 1620 -- will interest run on my judgment` (`on` 1 3 2026) FALSE `any day` FALSE (`on` 30 3 2026) EQUALS `JUDGMENT INTEREST`
#ASSERT `r 1620 -- will interest run on my judgment` (`on` 1 3 2026) FALSE `any day` TRUE (`on` 30 3 2026) EQUALS `JUDGMENT INTEREST ORDERED`
-- Took effect 10 December 2026: 28 days end 15 January 2027.
#ASSERT `r 1620 -- will interest run on my judgment` (`on` 10 12 2026) TRUE (`on` 15 1 2027) FALSE (`on` 20 1 2027) EQUALS `NO JUDGMENT INTEREST`

§ `Schedule 2 -- interest rates`

-- After 30 June 2010: cash rate 4.5 plus 4 (up to judgment) or plus 6 (after judgment).
#ASSERT `schedule 2 -- what is the interest rate` `UP TO` `SC` (`on` 1 7 2010) 4.5 `any day` EQUALS JUST 8.5
#ASSERT `schedule 2 -- what is the interest rate` `UP TO` `MC` (`on` 15 3 2026) 3.6 `any day` EQUALS JUST 7.6
#ASSERT `schedule 2 -- what is the interest rate` `AFTER` `SC` (`on` 1 7 2010) 4.5 `any day` EQUALS JUST 10.5
-- Table 2.1 (Supreme Court, up to judgment).
#ASSERT `schedule 2 -- what is the interest rate` `UP TO` `SC` (`on` 30 6 2010) 0 `any day` EQUALS JUST 9
#ASSERT `schedule 2 -- what is the interest rate` `UP TO` `SC` (`on` 1 1 1990) 0 `any day` EQUALS JUST 21
#ASSERT `schedule 2 -- what is the interest rate` `UP TO` `SC` (`on` 31 12 1989) 0 `any day` EQUALS JUST 16
#ASSERT `schedule 2 -- what is the interest rate` `UP TO` `SC` (`on` 1 1 1974) 0 `any day` EQUALS JUST 10
#ASSERT `schedule 2 -- what is the interest rate` `UP TO` `SC` (`on` 31 12 1973) 0 `any day` EQUALS NOTHING
-- Table 2.2 (Magistrates Court, up to judgment).
#ASSERT `schedule 2 -- what is the interest rate` `UP TO` `MC` (`on` 30 6 1981) 0 `any day` EQUALS JUST 13.375
#ASSERT `schedule 2 -- what is the interest rate` `UP TO` `MC` (`on` 1 7 1981) 0 `any day` EQUALS JUST 15
#ASSERT `schedule 2 -- what is the interest rate` `UP TO` `MC` (`on` 29 2 1988) 0 `any day` EQUALS JUST 18.75
#ASSERT `schedule 2 -- what is the interest rate` `UP TO` `MC` (`on` 1 3 1988) 0 `any day` EQUALS JUST 16.125
#ASSERT `schedule 2 -- what is the interest rate` `UP TO` `MC` (`on` 1 1 1990) 0 `any day` EQUALS JUST 20.75
#ASSERT `schedule 2 -- what is the interest rate` `UP TO` `MC` (`on` 9 1 2005) 0 `any day` EQUALS JUST 8.45
#ASSERT `schedule 2 -- what is the interest rate` `UP TO` `MC` (`on` 10 1 2005) 0 `any day` EQUALS JUST 9
-- Tables 2.3 and 2.4 (after judgment).
#ASSERT `schedule 2 -- what is the interest rate` `AFTER` `SC` (`on` 30 4 1986) 0 (`on` 30 9 1977) EQUALS JUST 5
#ASSERT `schedule 2 -- what is the interest rate` `AFTER` `SC` (`on` 30 4 1986) 0 (`on` 1 10 1977) EQUALS JUST 10
#ASSERT `schedule 2 -- what is the interest rate` `AFTER` `SC` (`on` 1 5 1986) 0 (`on` 1 10 1977) EQUALS JUST 15
#ASSERT `schedule 2 -- what is the interest rate` `AFTER` `SC` (`on` 10 1 2005) 0 `any day` EQUALS JUST 11
#ASSERT `schedule 2 -- what is the interest rate` `AFTER` `MC` (`on` 9 4 1995) 0 `any day` EQUALS JUST 12
#ASSERT `schedule 2 -- what is the interest rate` `AFTER` `MC` (`on` 10 4 1995) 0 `any day` EQUALS JUST 9
#ASSERT `schedule 2 -- what is the interest rate` `AFTER` `MC` (`on` 30 6 2010) 0 `any day` EQUALS JUST 11

§ `r 250 -- death claims`

-- Death 15 January 2026: 6 months end 15 July 2026.
#ASSERT `r 250 -- can I start the death claim` `PR` (`on` 15 1 2026) FALSE (`on` 1 2 2026) EQUALS `PR STARTS`
#ASSERT `r 250 -- can I start the death claim` `FAMILY` (`on` 15 1 2026) FALSE (`on` 15 7 2026) EQUALS `FAMILY NOT YET`
#ASSERT `r 250 -- can I start the death claim` `FAMILY` (`on` 15 1 2026) FALSE (`on` 16 7 2026) EQUALS `FAMILY MAY`
#ASSERT `r 250 -- can I start the death claim` `FAMILY` (`on` 15 1 2026) TRUE (`on` 16 7 2026) EQUALS `ONLY ONE`
#ASSERT `r 250 -- can I start the death claim` `PR` (`on` 15 1 2026) TRUE (`on` 16 7 2026) EQUALS `ONLY ONE`
#ASSERT `r 250 -- can I start the death claim` `OTHER PERSON` (`on` 15 1 2026) FALSE (`on` 16 7 2026) EQUALS `NOT YOU`
-- Death 31 August 2026: 6 months end 28 February 2027 (fork F3).
#ASSERT `r 250 -- can I start the death claim` `FAMILY` (`on` 31 8 2026) FALSE (`on` 28 2 2027) EQUALS `FAMILY NOT YET`
#ASSERT `r 250 -- can I start the death claim` `FAMILY` (`on` 31 8 2026) FALSE (`on` 1 3 2027) EQUALS `FAMILY MAY`
