-- =====================================================================================================================
-- CASE 11. Interest and penalty tax (Taxation Administration Act pt 5). HYPOTHETICAL amounts.
-- =====================================================================================================================
-- s 25, 26: 10,000 unpaid, market rate component 4% plus the 8% premium, 73 days: 10,000 x 12% x 73/365 = 240.
#ASSERT `How much interest do I owe on late duty` 10000 (DATE_FROM_DMY 21 10 2026) (DATE_FROM_DMY 2 1 2027) 4 EQUALS 240
-- s 27: 1,000 for 30 days: 1,000 x 12% x 30/365 = 9.86, under $20: nil. Paid on the last day: nil.
#ASSERT `How much interest do I owe on late duty` 1000 (DATE_FROM_DMY 21 10 2026) (DATE_FROM_DMY 20 11 2026) 4 EQUALS 0
#ASSERT `How much interest do I owe on late duty` 10000 (DATE_FROM_DMY 21 10 2026) (DATE_FROM_DMY 21 10 2026) 4 EQUALS 0
-- s 31, table 34 on 10,000: 25% = 2,500; with s 32 disclosure 500 (5%); with s 33 disclosure 2,000 (20%).
#ASSERT `What penalty tax can I be made to pay on late duty` 10000 `nothing more than the default` `no disclosure` EQUALS 2500
#ASSERT `What penalty tax can I be made to pay on late duty` 10000 `nothing more than the default` `told the commissioner first` EQUALS 500
#ASSERT `What penalty tax can I be made to pay on late duty` 10000 `nothing more than the default` `disclosure in writing after the commissioner said an investigation would be carried out, before it began (s 33)` EQUALS 2000
-- s 31(2): 50%, 10%, 40%. s 31(4): 75%, 15%, 60%. s 34: 90% whatever the disclosure. s 31(5): nil.
#ASSERT `What penalty tax can I be made to pay on late duty` 10000 `delay in paying or in giving information, incorrect, incomplete or misleading information, or a second or later default (s 31(2))` `no disclosure` EQUALS 5000
#ASSERT `What penalty tax can I be made to pay on late duty` 10000 `delay in paying or in giving information, incorrect, incomplete or misleading information, or a second or later default (s 31(2))` `told the commissioner first` EQUALS 1000
#ASSERT `What penalty tax can I be made to pay on late duty` 10000 `delay in paying or in giving information, incorrect, incomplete or misleading information, or a second or later default (s 31(2))` `disclosure in writing after the commissioner said an investigation would be carried out, before it began (s 33)` EQUALS 4000
#ASSERT `What penalty tax can I be made to pay on late duty` 10000 `intentional disregard of a tax law (s 31(4))` `no disclosure` EQUALS 7500
#ASSERT `What penalty tax can I be made to pay on late duty` 10000 `intentional disregard of a tax law (s 31(4))` `told the commissioner first` EQUALS 1500
#ASSERT `What penalty tax can I be made to pay on late duty` 10000 `intentional disregard of a tax law (s 31(4))` `disclosure in writing after the commissioner said an investigation would be carried out, before it began (s 33)` EQUALS 6000
#ASSERT `What penalty tax can I be made to pay on late duty` 10000 `concealment or obstruction after being told of an investigation (s 34)` `told the commissioner first` EQUALS 9000
#ASSERT `What penalty tax can I be made to pay on late duty` 10000 `the taxpayer took reasonable care, or the default happened solely because of circumstances beyond the taxpayer's control (s 31(5))` `no disclosure` EQUALS 0
-- s 35: 25% of 79 is 19.75, under $20: nil; 25% of 80 is exactly 20: payable.
#ASSERT `What penalty tax can I be made to pay on late duty` 79 `nothing more than the default` `no disclosure` EQUALS 0
#ASSERT `What penalty tax can I be made to pay on late duty` 80 `nothing more than the default` `no disclosure` EQUALS 20

-- =====================================================================================================================
-- Regulative rules (duties-core.l4). Day 0 is the day the rule starts.
-- =====================================================================================================================
-- s 15, from the transaction date. The registrar-general must tell the commissioner: nothing to do.
#ASSERT EVALTRACE (`s 15 -- the transferee must lodge the instrument or statement within 90 days` TRUE) 0 (LIST (WAITUNTIL 200)) EQUALS FULFILLED
-- Lodged by the transferee on day 60, or on day 90 exactly; or an electronic application by her conveyancer on day 10.
#ASSERT EVALTRACE (`s 15 -- the transferee must lodge the instrument or statement within 90 days` FALSE) 0 (LIST (EVENT `the transferee` `lodge the instrument or the written statement with the commissioner` 60)) EQUALS FULFILLED
#ASSERT EVALTRACE (`s 15 -- the transferee must lodge the instrument or statement within 90 days` FALSE) 0 (LIST (EVENT `the transferee` `lodge the instrument or the written statement with the commissioner` 90)) EQUALS FULFILLED
#ASSERT EVALTRACE (`s 15 -- the transferee must lodge the instrument or statement within 90 days` FALSE) 0 (LIST (EVENT `an approved person` `lodge an electronic application for assessment of duty` 10)) EQUALS FULFILLED
-- expect: BREACH BY the transferee, "Duties Act s 15(1): ...; TAA s 67(1): maximum penalty 50 penalty units" OR BREACH BY the transferee, "... (2)(b) ..." (nothing lodged by day 91)
#TRACE `s 15 -- the transferee must lodge the instrument or statement within 90 days` FALSE AT 0 WITH
    (WAITUNTIL 91)

-- s 16, from registration. Paid on day 14: no tax default.
#ASSERT EVALTRACE (`s 16 -- the transferee must pay the duty within 14 days of registration, lest interest and penalty tax` 14 30) 0 (LIST (EVENT `the transferee` `pay the duty` 14)) EQUALS FULFILLED
-- With 30 days allowed by the commissioner, paid on day 25.
#ASSERT EVALTRACE (`s 16 -- the transferee must pay the duty within 14 days of registration, lest interest and penalty tax` 30 30) 0 (LIST (EVENT `the transferee` `pay the duty` 25)) EQUALS FULFILLED
-- Not paid by day 14: a tax default is seen on day 15; the duty with interest and penalty tax, paid on day 40 within the
-- 30 days of the notice of assessment: fulfilled.
#ASSERT EVALTRACE (`s 16 -- the transferee must pay the duty within 14 days of registration, lest interest and penalty tax` 14 30) 0 (LIST (WAITUNTIL 15), (EVENT `the transferee` `pay the duty with interest and penalty tax` 40)) EQUALS FULFILLED
-- expect: BREACH BY the transferee, "Duties Act s 16(2) and TAA ss 25, 30 and 36: ..." (not paid by day 14, nor within 30 days after)
#TRACE `s 16 -- the transferee must pay the duty within 14 days of registration, lest interest and penalty tax` 14 30 AT 0 WITH
    (WAITUNTIL 15)
    (WAITUNTIL 46)

-- The notice duty, from the first of the s 1(2)/s 6(2)/s 5(2) events. Mia tells the Commissioner on day 10 and pays the
-- reassessment on day 35, within the 30 days of its notice: fulfilled. Day 14 exactly is in time.
#ASSERT EVALTRACE (`notice -- the transferee must tell the commissioner within 14 days that the transaction is not eligible` `the Home Buyer Concession Scheme (DI2026-157)` 30) 0 (LIST (EVENT `the transferee` `give the commissioner written notice that the transaction is not eligible` 10), (EVENT `the transferee` `pay the reassessed duty with interest and penalty tax` 35)) EQUALS FULFILLED
#ASSERT EVALTRACE (`notice -- the transferee must tell the commissioner within 14 days that the transaction is not eligible` `the eligible owner occupier rate (DI2026-155 Schedule 1)` 30) 0 (LIST (EVENT `the transferee` `give the commissioner written notice that the transaction is not eligible` 14), (EVENT `the transferee` `pay the reassessed duty with interest and penalty tax` 44)) EQUALS FULFILLED
-- expect: BREACH BY the transferee, "DI2026-159 s 5(2): written notice ... was not given within 14 days; TAA s 67(2): maximum penalty 50 penalty units; TAA s 32 then does not reduce the penalty tax"
#TRACE `notice -- the transferee must tell the commissioner within 14 days that the transaction is not eligible` `the Pensioner Duty Concession Scheme (DI2026-159)` 30 AT 0 WITH
    (WAITUNTIL 15)
-- expect: BREACH BY the transferee, "TAA ss 25, 30 and 36: the reassessed duty ... not paid ..." (told on day 5, unpaid by day 36)
#TRACE `notice -- the transferee must tell the commissioner within 14 days that the transaction is not eligible` `the Home Buyer Concession Scheme (DI2026-157)` 30 AT 0 WITH
    PARTY `the transferee` DOES `give the commissioner written notice that the transaction is not eligible` AT 5
    (WAITUNTIL 36)

-- The request for a shorter period or a later start, from the residence start date: 30 September 2026 to 30 March 2028
-- is 547 days (365 to 30 September 2027, then 31 + 30 + 31 + 31 + 29 + 30 = 182). Asked on day 500: fulfilled; not
-- asked: no breach.
#ASSERT `the number of days from` `30 Sep 2026` `to` (DATE_FROM_DMY 30 3 2028) EQUALS 547
#ASSERT EVALTRACE (`residence -- the transferee may ask in writing within 18 months for a shorter period or a later start` 547) 0 (LIST (EVENT `the transferee` `ask in writing for a shorter residence period or a later residence start date` 500), (WAITUNTIL 501)) EQUALS FULFILLED
#ASSERT EVALTRACE (`residence -- the transferee may ask in writing within 18 months for a shorter period or a later start` 547) 0 (LIST (WAITUNTIL 600)) EQUALS FULFILLED

-- The application for the concession, from lodgement: on lodgement (day 0), or with an extension request on day 200 of
-- 365: fulfilled; not at all: no breach.
#ASSERT EVALTRACE (`application -- the transferee may apply for the concession on lodgement, or ask within 12 months to extend the time` 365) 0 (LIST (EVENT `the transferee` (`apply for the duty concession` `on lodgement of the transfer with the registrar-general`) 0)) EQUALS FULFILLED
#ASSERT EVALTRACE (`application -- the transferee may apply for the concession on lodgement, or ask within 12 months to extend the time` 365) 0 (LIST (EVENT `the transferee` (`apply for the duty concession` `later, with a written application to extend the time`) 200)) EQUALS FULFILLED
#ASSERT EVALTRACE (`application -- the transferee may apply for the concession on lodgement, or ask within 12 months to extend the time` 365) 0 (LIST (WAITUNTIL 400)) EQUALS FULFILLED

-- TAA ss 100-104, from the notice of assessment. Objection on day 45, decided on day 120: fulfilled. No objection by
-- day 61: no breach.
#ASSERT EVALTRACE `TAA ss 100 to 104 -- the taxpayer may object within 60 days, and the commissioner must then decide` 0 (LIST (EVENT `the transferee` `lodge a written objection` 45), (EVENT `the commissioner` `allow or disallow the objection` 120)) EQUALS FULFILLED
#ASSERT EVALTRACE `TAA ss 100 to 104 -- the taxpayer may object within 60 days, and the commissioner must then decide` 0 (LIST (WAITUNTIL 61)) EQUALS FULFILLED
-- expect: the commissioner's duty to allow or disallow the objection still pending (s 104 states no period)
#TRACE `TAA ss 100 to 104 -- the taxpayer may object within 60 days, and the commissioner must then decide` AT 0 WITH
    PARTY `the transferee` DOES `lodge a written objection` AT 45
    (WAITUNTIL 400)
