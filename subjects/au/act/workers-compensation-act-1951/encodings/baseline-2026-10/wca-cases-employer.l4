IMPORT prelude
IMPORT `wca-core`
IMPORT `wca-seat`
IMPORT `wca-seat-employer`
IMPORT `wca-seat-insurer`

-- Cases for the employer's seat (wca-seat-employer.l4), the employer's regulative rules in wca-core.l4, and MIRROR
-- CASES: the same facts asked from the worker's seat (wca-seat.l4) or the insurer's (wca-seat-insurer.l4), with answers
-- that agree. Every expected value was worked by hand from the deposited text (A1951-2.txt), never copied from the
-- encoding's output. HYPOTHETICAL throughout: no scenario life raised this Act.
--
-- A breached or still-pending DEONTIC cannot be asserted on the stable l4, so regulative rules are asserted where the
-- trace ends FULFILLED, and #TRACEd with an "-- expect:" line where it does not.

`1 Oct 2026`  MEANS DATE_FROM_DMY 1 10 2026
`2 Oct 2026`  MEANS DATE_FROM_DMY 2 10 2026
`4 Oct 2026`  MEANS DATE_FROM_DMY 4 10 2026
`5 Oct 2026`  MEANS DATE_FROM_DMY 5 10 2026
`8 Oct 2026`  MEANS DATE_FROM_DMY 8 10 2026
`9 Oct 2026`  MEANS DATE_FROM_DMY 9 10 2026
`12 Oct 2026` MEANS DATE_FROM_DMY 12 10 2026
`14 Oct 2026` MEANS DATE_FROM_DMY 14 10 2026
`15 Oct 2026` MEANS DATE_FROM_DMY 15 10 2026
`19 Oct 2026` MEANS DATE_FROM_DMY 19 10 2026
`20 Oct 2026` MEANS DATE_FROM_DMY 20 10 2026
`27 Oct 2026` MEANS DATE_FROM_DMY 27 10 2026
`28 Oct 2026` MEANS DATE_FROM_DMY 28 10 2026

-- =====================================================================================================================
-- CASE E1. Weekly payments begin on notice (s 38(1)). A worker injured on 1 October 2026 tells the employer on
-- 5 October.
-- =====================================================================================================================

#ASSERT `Must I begin paying my worker weekly compensation` TRUE TRUE `5 Oct 2026` EQUALS `yes: weekly payments must begin on the day the worker gave notice of the injury` `5 Oct 2026`
#ASSERT `Must I begin paying my worker weekly compensation` TRUE FALSE `5 Oct 2026` EQUALS `not yet: the duty begins when the worker gives notice of the injury (s 38(1)(a))`
#ASSERT `Must I begin paying my worker weekly compensation` FALSE TRUE `5 Oct 2026` EQUALS `no: the worker is not, and may not be, entitled to compensation for the injury`

-- =====================================================================================================================
-- CASE E2. The injury notice to the insurer (s 93(2)-(3), s 94(3), s 95).
-- =====================================================================================================================

-- Insured employer: 48 hours; an oral notice to be given again in writing or electronically within 3 days.
#ASSERT `By when must I give my insurer the injury notice` FALSE EQUALS `give the insurer an injury notice within 48 hours of becoming aware of the injury; if given orally, give it again in writing or electronically within 3 days` 48 3
-- Licensed self-insurer: no notice (s 93(3)).
#ASSERT `By when must I give my insurer the injury notice` TRUE EQUALS `no injury notice to an insurer: I am a licensed self-insurer (s 93(3))`
-- Notice 30 hours after learning of the injury: in time, nothing extra.
#ASSERT `What does my late injury notice cost me` FALSE 30 `1 Oct 2026` `2 Oct 2026` EQUALS `no extra liability: the injury notice was given within 48 hours (s 93(2))`
-- At 48 hours exactly: still "within 48 hours".
#ASSERT `What does my late injury notice cost me` FALSE 48 `1 Oct 2026` `2 Oct 2026` EQUALS `no extra liability: the injury notice was given within 48 hours (s 93(2))`
-- At 60 hours, notice given on 4 October: the employer pays weekly compensation itself from the date of injury
-- (1 October) until the notice (4 October), without indemnity (s 95(2)-(3)).
#ASSERT `What does my late injury notice cost me` FALSE 60 `1 Oct 2026` `4 Oct 2026` EQUALS `the employer pays the weekly compensation itself, without indemnity, for the days` `1 Oct 2026` `4 Oct 2026`
-- A licensed self-insurer: s 95 does not apply.
#ASSERT `What does my late injury notice cost me` TRUE 60 `1 Oct 2026` `4 Oct 2026` EQUALS `no injury notice to an insurer is required: the employer is a licensed self-insurer (s 93(3))`
-- MIRROR (insurer's seat): on the same late notice the insurer may not recover from the worker, but may recover from
-- the employer what s 95 makes the employer liable for (s 134(3)).
#ASSERT `May I recover what I paid on the claim` TRUE FALSE EQUALS `the insurer may not recover it from the worker, but may recover from the employer what the employer owes under s 95 (s 134(3))`
-- MIRROR: notice in time: nothing recoverable from anyone.
#ASSERT `May I recover what I paid on the claim` FALSE FALSE EQUALS `the insurer may not recover it from the worker (s 128(2)(b), s 134(2))`

-- =====================================================================================================================
-- CASE E3. No claim within 7 days (s 38(2), (3)). The worker was injured on Thursday 1 October 2026.
-- =====================================================================================================================

-- The worker claimed on 8 October: payments continue.
#ASSERT `When may I stop weekly payments because my worker has not claimed` `1 Oct 2026` TRUE `8 Oct 2026` FALSE `1 Oct 2026` EQUALS `weekly payments continue: the worker claimed in time, or no day is lost (s 38(2), (3))`
-- Claimed on 9 October: payment ended at the end of 8 October, but the lost period (9 October to 8 October) is empty.
#ASSERT `When may I stop weekly payments because my worker has not claimed` `1 Oct 2026` TRUE `9 Oct 2026` FALSE `1 Oct 2026` EQUALS `weekly payments continue: the worker claimed in time, or no day is lost (s 38(2), (3))`
-- No claim yet: payments end unless the worker claims by 8 October; a later claim leaves nothing owed from 9 October.
#ASSERT `When may I stop weekly payments because my worker has not claimed` `1 Oct 2026` FALSE `1 Oct 2026` FALSE `1 Oct 2026` EQUALS `weekly payments end unless the worker claims by the last day; a later claim leaves no weekly compensation owed from the first day below to the day before the claim` `8 Oct 2026` `9 Oct 2026`
-- No claim yet, and the injury kept the worker from claiming until 20 October: the last day is 27 October.
#ASSERT `When may I stop weekly payments because my worker has not claimed` `1 Oct 2026` FALSE `1 Oct 2026` TRUE `20 Oct 2026` EQUALS `weekly payments end unless the worker claims by the last day; a later claim leaves no weekly compensation owed from the first day below to the day before the claim` `27 Oct 2026` `9 Oct 2026`
-- Claimed on 15 October: nothing owed from 9 October to the day before the claim.
#ASSERT `When may I stop weekly payments because my worker has not claimed` `1 Oct 2026` TRUE `15 Oct 2026` FALSE `1 Oct 2026` EQUALS `weekly payments have ended: no weekly compensation is owed from the first day below to the day before the claim` `9 Oct 2026` `15 Oct 2026`
-- MIRROR (worker's seat), the same facts: the worker loses 9 October to 14 October.
#ASSERT `Do I lose weekly compensation because I claimed late` `1 Oct 2026` `15 Oct 2026` FALSE `1 Oct 2026` EQUALS `no weekly compensation for the days` `9 Oct 2026` `14 Oct 2026`
-- Prevented until 20 October but claimed on 28 October: s 38(2) in full, from 9 October.
#ASSERT `When may I stop weekly payments because my worker has not claimed` `1 Oct 2026` TRUE `28 Oct 2026` TRUE `20 Oct 2026` EQUALS `weekly payments have ended: no weekly compensation is owed from the first day below to the day before the claim` `9 Oct 2026` `28 Oct 2026`
-- MIRROR (worker's seat): 9 October to 27 October.
#ASSERT `Do I lose weekly compensation because I claimed late` `1 Oct 2026` `28 Oct 2026` TRUE `20 Oct 2026` EQUALS `no weekly compensation for the days` `9 Oct 2026` `27 Oct 2026`
-- MIRROR (worker's seat): the last day to claim is the same from both seats.
#ASSERT `By what day must I claim to keep my weekly payments going` `1 Oct 2026` TRUE `20 Oct 2026` EQUALS `27 Oct 2026`

-- =====================================================================================================================
-- CASE E4. Forwarding the claim (s 126(1), (4)). Received on Monday 12 October 2026: forward by 19 October.
-- =====================================================================================================================

#ASSERT `By what day must I forward the claim to my insurer` FALSE `12 Oct 2026` EQUALS `forward the claim to the insurer no later than` `19 Oct 2026`
#ASSERT `By what day must I forward the claim to my insurer` TRUE `12 Oct 2026` EQUALS `no forwarding: I am a licensed self-insurer (s 126(4))`

-- =====================================================================================================================
-- Regulative rules (wca-core.l4).
-- =====================================================================================================================

-- s 93(2), s 94(3). Clock in hours from the employer becoming aware. A written notice at hour 30: fulfilled.
#ASSERT EVALTRACE (`s 93(2), s 94(3) -- the employer must give the insurer an injury notice within 48 hours, and confirm an oral one within 3 days` FALSE) 0 (LIST (EVENT `the employer` (`give the insurer an injury notice` `in writing`) 30)) EQUALS FULFILLED
-- An electronic notice at hour 48 exactly: in time.
#ASSERT EVALTRACE (`s 93(2), s 94(3) -- the employer must give the insurer an injury notice within 48 hours, and confirm an oral one within 3 days` FALSE) 0 (LIST (EVENT `the employer` (`give the insurer an injury notice` `in electronic form`) 48)) EQUALS FULFILLED
-- An oral notice at hour 10, confirmed in writing at hour 70 (60 hours later, within 3 days): fulfilled.
#ASSERT EVALTRACE (`s 93(2), s 94(3) -- the employer must give the insurer an injury notice within 48 hours, and confirm an oral one within 3 days` FALSE) 0 (LIST (EVENT `the employer` (`give the insurer an injury notice` `orally`) 10), (EVENT `the employer` `give the injury notice in writing or in electronic form` 70)) EQUALS FULFILLED
-- A licensed self-insurer owes no notice.
#ASSERT EVALTRACE (`s 93(2), s 94(3) -- the employer must give the insurer an injury notice within 48 hours, and confirm an oral one within 3 days` TRUE) 0 (LIST (WAITUNTIL 100)) EQUALS FULFILLED
-- expect: BREACH BY the employer, "s 94(3): an injury notice given orally must be given in writing ..." (oral at hour 10, written at hour 90: 80 hours later)
#TRACE `s 93(2), s 94(3) -- the employer must give the insurer an injury notice within 48 hours, and confirm an oral one within 3 days` FALSE AT 0 WITH
    PARTY `the employer` DOES `give the insurer an injury notice` `orally` AT 10
    PARTY `the employer` DOES `give the injury notice in writing or in electronic form` AT 90
-- expect: BREACH BY the employer, "s 93(2), s 95: the employer must give the insurer an injury notice within 48 hours ..." (no notice by hour 48)
#TRACE `s 93(2), s 94(3) -- the employer must give the insurer an injury notice within 48 hours, and confirm an oral one within 3 days` FALSE AT 0 WITH
    (WAITUNTIL 49)

-- s 126(1). Clock in days from receiving the claim. Forwarded on day 7: fulfilled. Self-insurer: nothing owed.
#ASSERT EVALTRACE (`s 126(1) -- the employer must forward the claim to the insurer within 7 days` FALSE) 0 (LIST (EVENT `the employer` `forward the claim to the insurer` 7)) EQUALS FULFILLED
#ASSERT EVALTRACE (`s 126(1) -- the employer must forward the claim to the insurer within 7 days` TRUE) 0 (LIST (WAITUNTIL 30)) EQUALS FULFILLED
-- expect: BREACH BY the employer, "s 126(1): the employer must forward a claim to the liable insurer within 7 days ..." (forwarded on day 8)
#TRACE `s 126(1) -- the employer must forward the claim to the insurer within 7 days` FALSE AT 0 WITH
    PARTY `the employer` DOES `forward the claim to the insurer` AT 8

-- s 38(1) from the employer's side (day 0 = the injury). The worker tells on day 4 (5 October) and the employer
-- begins paying that day: fulfilled. MIRROR of CASE E1.
#ASSERT EVALTRACE (`s 93(1), s 38(1) -- the worker tells the employer, and the employer must then begin weekly payments` TRUE) 0 (LIST (EVENT `the worker` `tell the employer about the injury` 4), (EVENT `the employer` `begin paying weekly compensation` 4)) EQUALS FULFILLED
