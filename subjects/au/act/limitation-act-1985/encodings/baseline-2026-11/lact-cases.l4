#ASSERT `s 37 -- does the estate's distribution stop an extension` TRUE FALSE TRUE FALSE EQUALS `no: s 37 does not stop the court extending the time`
#ASSERT `s 37 -- does the estate's distribution stop an extension` TRUE TRUE FALSE FALSE EQUALS `no: s 37 does not stop the court extending the time`

