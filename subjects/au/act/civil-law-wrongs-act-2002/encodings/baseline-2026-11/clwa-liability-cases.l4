§ `s 100 -- domestic services`

#ASSERT `s 100 -- can I claim for losing capacity to do domestic services` TRUE EQUALS `yes: the liability includes damages for that loss, whoever did or does the services, and whether or not anyone is paid (s 100)`
#ASSERT `s 100 -- can I claim for losing capacity to do domestic services` FALSE EQUALS `s 100 covers only services you might reasonably have been expected to perform for your household; it says nothing more (NOTHING-kind)`

§ `s 102 -- contributory negligence`

-- Arguments: (damages) (share %) (statutory duty) (occupier) (death) (pt 7.1 presumption stands) (limit applies) (limit).
#ASSERT `s 102 -- my damages after contributory negligence` 100000 25 FALSE FALSE FALSE FALSE FALSE 0 EQUALS 75000
#ASSERT `s 102 -- my damages after contributory negligence` 100000 0 FALSE FALSE FALSE FALSE FALSE 0 EQUALS 100000
-- s 47: a 100% reduction defeats the claim.
#ASSERT `s 102 -- my damages after contributory negligence` 100000 100 FALSE FALSE FALSE FALSE FALSE 0 EQUALS 0
#ASSERT `s 102 -- my damages after contributory negligence` 100000 25 TRUE FALSE FALSE FALSE FALSE 0 EQUALS 100000
-- Against an occupier, s 102 (2) does not apply (s 168 (3)).
#ASSERT `s 102 -- my damages after contributory negligence` 100000 25 TRUE TRUE FALSE FALSE FALSE 0 EQUALS 75000
-- A claim for a death: not reduced (s 27) ...
#ASSERT `s 102 -- my damages after contributory negligence` 100000 25 FALSE FALSE TRUE FALSE FALSE 0 EQUALS 100000
-- ... unless a part 7.1 presumption stands (fork F12).
#ASSERT `s 102 -- my damages after contributory negligence` 100000 25 FALSE FALSE TRUE TRUE FALSE 0 EQUALS 75000
#ASSERT `s 102 -- my damages after contributory negligence` 100000 25 TRUE FALSE FALSE TRUE FALSE 0 EQUALS 75000
-- A liability limit of $50,000 caps the $75,000; one of $80,000 does not.
#ASSERT `s 102 -- my damages after contributory negligence` 100000 25 FALSE FALSE FALSE FALSE TRUE 50000 EQUALS 50000
#ASSERT `s 102 -- my damages after contributory negligence` 100000 25 FALSE FALSE FALSE FALSE TRUE 80000 EQUALS 75000
#ASSERT `s 102 -- my damages after contributory negligence` 100000 25 FALSE FALSE FALSE FALSE TRUE 75000 EQUALS 75000
#ASSERT `s 102 -- my damages after contributory negligence` 250000 15 FALSE FALSE FALSE FALSE FALSE 0 EQUALS 212500
-- s 102 (3) caps only damages awarded because of s 102 (1) (fork F19): no reduction allowed, so no s 102 cap.
#ASSERT `s 102 -- my damages after contributory negligence` 100000 25 TRUE FALSE FALSE FALSE TRUE 50000 EQUALS 100000
#ASSERT `s 102 -- my damages after contributory negligence` 100000 25 FALSE FALSE TRUE FALSE TRUE 50000 EQUALS 100000

§ `ch 7A -- apportionable claims`

`APPORTIONABLE` MEANS `yes: an apportionable claim; each wrongdoer is liable only for the share the court considers just (ss 107B, 107F)`
`PI NOT APPORTIONABLE` MEANS `no: a claim arising out of personal injury is not an apportionable claim (the text's no, s 107B (3) (a)); chapter 7A does not limit any wrongdoer's liability`
#ASSERT `ch 7A -- is my claim apportionable` `personal injury (or loss arising out of it)` FALSE FALSE EQUALS `PI NOT APPORTIONABLE`
#ASSERT `ch 7A -- is my claim apportionable` `personal injury (or loss arising out of it)` TRUE FALSE EQUALS `PI NOT APPORTIONABLE`
#ASSERT `ch 7A -- is my claim apportionable` `economic loss or damage to property, from a failure to take reasonable care` FALSE FALSE EQUALS `APPORTIONABLE`
#ASSERT `ch 7A -- is my claim apportionable` `economic loss or damage to property, under the Australian Consumer Law (ACT) s 236 for a contravention of its part 3.1 (unfair practices)` FALSE FALSE EQUALS `APPORTIONABLE`
#ASSERT `ch 7A -- is my claim apportionable` `economic loss or damage to property, from a failure to take reasonable care` TRUE FALSE EQUALS `no: a consumer claim is not an apportionable claim (the text's no, s 107B (3) (b))`
#ASSERT `ch 7A -- is my claim apportionable` `economic loss or damage to property, from a failure to take reasonable care` FALSE TRUE EQUALS `no: Discrimination Act, motor accident common law and workers compensation claims are not apportionable claims (the text's no, s 107B (4))`
#ASSERT `ch 7A -- is my claim apportionable` `something else` FALSE FALSE EQUALS `chapter 7A applies only to the claims s 107B (2) lists; this is not one, and it says nothing more (NOTHING-kind)`

§ `s 113 -- roads`

#ASSERT `s 113 -- can the authority be liable for not repairing the road` TRUE TRUE TRUE TRUE EQUALS `chapter 8 does not apply to motor accident common law claims or workers compensation claims (the text's no, s 108 (3))`
#ASSERT `s 113 -- can the authority be liable for not repairing the road` FALSE TRUE TRUE TRUE EQUALS `s 113 does not bar the claim: the authority knew, or ought reasonably to have known, of the particular risk (s 113 (1)); whether it owed and breached a duty is decided as usual (s 113 (2))`
#ASSERT `s 113 -- can the authority be liable for not repairing the road` FALSE TRUE TRUE FALSE EQUALS `no: the authority is not liable for the failure unless it knew or ought reasonably to have known of the particular risk (the text's no, s 113 (1))`
#ASSERT `s 113 -- can the authority be liable for not repairing the road` FALSE FALSE TRUE FALSE EQUALS `s 113 is about a public or other authority's failure to maintain, repair or renew a road; it says nothing about this (NOTHING-kind)`

§ `ch 8A -- institutional child abuse`

`NOT YET IN FORCE` MEANS `no: division 8A.1A.2 applies only to child abuse on or after 16 May 2026 (the text's no, s 114BBB)`
`BREACH TAKEN` MEANS `yes: the organisation is taken to have breached its duty of care to prevent the child abuse (s 114BBD (3))`
-- On the day the division commenced, 16 May 2026 (A2026-7): it applies.
#ASSERT `s 114BBD -- is the organisation taken to have breached its duty` (`on` 16 5 2026) TRUE TRUE TRUE FALSE EQUALS `BREACH TAKEN`
-- The day before: it does not.
#ASSERT `s 114BBD -- is the organisation taken to have breached its duty` (`on` 15 5 2026) TRUE TRUE TRUE FALSE EQUALS `NOT YET IN FORCE`
-- 13 Nov 2025 (when A2025-32 commenced, which did not insert the division): it does not.
#ASSERT `s 114BBD -- is the organisation taken to have breached its duty` (`on` 13 11 2025) TRUE TRUE TRUE FALSE EQUALS `NOT YET IN FORCE`
#ASSERT `s 114BBD -- is the organisation taken to have breached its duty` (`on` 1 6 2026) TRUE TRUE TRUE TRUE EQUALS `no: the organisation established that it took reasonable precautions to prevent the abuse (the text's no, s 114BBD (3))`
#ASSERT `s 114BBD -- is the organisation taken to have breached its duty` (`on` 1 6 2026) TRUE FALSE TRUE FALSE EQUALS `s 114BBD (3) applies only where the organisation was responsible for the child and the abuser was associated with it and acted in connection with that responsibility; it says nothing here (NOTHING-kind)`
#ASSERT `s 114BBD -- is the organisation taken to have breached its duty` (`on` 1 6 2026) TRUE TRUE FALSE FALSE EQUALS `s 114BBD (3) applies only where the organisation was responsible for the child and the abuser was associated with it and acted in connection with that responsibility; it says nothing here (NOTHING-kind)`

#ASSERT `s 114BE -- is the organisation vicariously liable` TRUE TRUE TRUE TRUE EQUALS `yes: the organisation is vicariously liable for the child abuse its employee perpetrated (s 114BE (1)), whenever it happened (s 114BA)`
#ASSERT `s 114BE -- is the organisation vicariously liable` TRUE TRUE TRUE FALSE EQUALS `s 114BE does not make it liable on these facts; the common law of vicarious liability still applies (s 114BE (3)) (NOTHING-kind)`
#ASSERT `s 114BE -- is the organisation vicariously liable` FALSE TRUE TRUE TRUE EQUALS `s 114BE does not make it liable on these facts; the common law of vicarious liability still applies (s 114BE (3)) (NOTHING-kind)`

-- Proceeding started 1 Mar 2026: the 120th day after is 29 Jun 2026 (30 + 30 + 31 + 29).
`NOT YET` MEANS `not yet: the body has until the 120th day after the proceeding started to nominate a defendant (s 114D (3))`
`MAY APPLY (A)` MEANS `yes: the body did not nominate a defendant within 120 days after the proceeding started (s 114E (1) (a))`
`MAY APPLY (B)` MEANS `yes: the entity the body nominated is not capable of being sued, or lacks the assets to meet a judgment (s 114E (1) (b))`
#ASSERT `s 114E -- can I ask for a related trust to be appointed defendant` (`on` 1 3 2026) FALSE `ANY DAY` FALSE FALSE (`on` 29 6 2026) EQUALS `NOT YET`
#ASSERT `s 114E -- can I ask for a related trust to be appointed defendant` (`on` 1 3 2026) FALSE `ANY DAY` FALSE FALSE (`on` 30 6 2026) EQUALS `MAY APPLY (A)`
#ASSERT `s 114E -- can I ask for a related trust to be appointed defendant` (`on` 1 3 2026) TRUE (`on` 29 6 2026) TRUE TRUE (`on` 7 11 2026) EQUALS `no: the body nominated a defendant that can be sued and can meet a judgment; the claim goes against the nominee (the text's no, s 114D (4), s 114E (1))`
#ASSERT `s 114E -- can I ask for a related trust to be appointed defendant` (`on` 1 3 2026) TRUE (`on` 29 6 2026) FALSE TRUE (`on` 7 11 2026) EQUALS `MAY APPLY (B)`
#ASSERT `s 114E -- can I ask for a related trust to be appointed defendant` (`on` 1 3 2026) TRUE (`on` 1 5 2026) TRUE FALSE (`on` 7 11 2026) EQUALS `MAY APPLY (B)`
-- A nomination on the 121st day (without a court order) comes too late.
#ASSERT `s 114E -- can I ask for a related trust to be appointed defendant` (`on` 1 3 2026) TRUE (`on` 30 6 2026) TRUE TRUE (`on` 7 11 2026) EQUALS `MAY APPLY (A)`

§ `s 181 -- the most my lawyer can be paid`

#ASSERT `s 181 -- the most my lawyer can be paid` 30000 0 EQUALS JUST 10000
-- At $50,000, 20% is $10,000: the two limbs meet (finding 9).
#ASSERT `s 181 -- the most my lawyer can be paid` 50000 0 EQUALS JUST 10000
#ASSERT `s 181 -- the most my lawyer can be paid` 50001 0 EQUALS NOTHING
#ASSERT `s 181 -- the most my lawyer can be paid` 40000 2500 EQUALS JUST 12500
#ASSERT `s 181 -- the most my lawyer can be paid` 0 0 EQUALS JUST 10000
