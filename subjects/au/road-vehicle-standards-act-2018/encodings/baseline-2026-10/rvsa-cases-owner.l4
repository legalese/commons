IMPORT prelude
IMPORT `rvsa-owner`

-- Road Vehicle Standards Act 2018 -- worked cases, from the seat of the person importing, buying or selling a vehicle.
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Expected values were written by hand
-- from the deposited text (Compilation No. 3), never copied from the encoding's output. All facts are HYPOTHETICAL; no
-- scenario raised this Act.

-- ---------------------------------------------------------------------------------------------------------------------
-- s 6. A Japanese-market sedan: a road vehicle.
#ASSERT `Is my vehicle a road vehicle` TRUE FALSE FALSE FALSE FALSE FALSE
-- A box trailer for towing behind a car.
#ASSERT `Is my vehicle a road vehicle` FALSE TRUE FALSE FALSE FALSE FALSE
-- A farm quad bike not designed for public roads, and no instrument names it.
#ASSERT (NOT (`Is my vehicle a road vehicle` FALSE FALSE FALSE FALSE FALSE FALSE))
-- ... but within a class the Secretary has determined to be road vehicles.
#ASSERT `Is my vehicle a road vehicle` FALSE FALSE TRUE FALSE FALSE FALSE
-- A road car within a class the Secretary has excluded (s 6(4)(a)).
#ASSERT (NOT (`Is my vehicle a road vehicle` TRUE FALSE FALSE TRUE FALSE FALSE))
-- ... but named as a road vehicle by a notifiable instrument (s 6(4)(a), "not determined in an instrument under (6)(a)").
#ASSERT `Is my vehicle a road vehicle` TRUE FALSE FALSE TRUE TRUE FALSE
-- A vehicle in an included class but named as not a road vehicle (s 6(1)(c), (4)(b)).
#ASSERT (NOT (`Is my vehicle a road vehicle` FALSE FALSE TRUE FALSE FALSE TRUE))

-- ---------------------------------------------------------------------------------------------------------------------
-- s 22. Importing a used Nissan from Japan under a concessional RAV entry import approval that specifies it.
#ASSERT `May I import this vehicle` TRUE FALSE FALSE TRUE FALSE EQUALS `yes: I hold an import approval in force that specifies this vehicle (s 22(2)(c))`
-- A dealer's employee authorised in writing by the type approval holder.
#ASSERT `May I import this vehicle` TRUE FALSE TRUE FALSE FALSE EQUALS `yes: the holder of a road vehicle type approval in force for its type has authorised me in writing (s 22(2)(b))`
#ASSERT `May I import this vehicle` TRUE TRUE FALSE FALSE FALSE EQUALS `yes: I hold a road vehicle type approval in force for its type (s 22(2)(a))`
#ASSERT `May I import this vehicle` TRUE FALSE FALSE FALSE TRUE EQUALS `yes: a circumstance the rules set out applies (s 22(2)(d))`
-- No approval at all.
#ASSERT `May I import this vehicle` TRUE FALSE FALSE FALSE FALSE EQUALS `no: importing it would contravene s 22(1), an offence and a civil penalty of up to 120 penalty units`
#ASSERT `May I import this vehicle` FALSE FALSE FALSE FALSE FALSE EQUALS `the Act does not regulate importing it: it is not a road vehicle (s 6)`

-- ---------------------------------------------------------------------------------------------------------------------
-- s 24. Inputs: road vehicle; on the RAV; provided in Australia before; why; non-RAV entry import approval; Australian-made
-- and said not for road use.
-- A private importer sells her newly landed car before it is on the RAV.
#ASSERT `May I provide this vehicle` TRUE FALSE FALSE `to sell, give, lend, lease or hire it, or give access to it` FALSE FALSE EQUALS `no: providing it would contravene s 24(1), an offence and a civil penalty of up to 120 penalty units`
-- ... after it is entered on the RAV.
#ASSERT `May I provide this vehicle` TRUE TRUE FALSE `to sell, give, lend, lease or hire it, or give access to it` FALSE FALSE EQUALS `yes: it is on the RAV, so s 24 does not stop it`
-- ... she hands it to a workshop to have compliance work done (s 24(3)(a)).
#ASSERT `May I provide this vehicle` TRUE FALSE FALSE `to have work done on it` FALSE FALSE EQUALS `yes: providing it to have work done, to protect, store or transport it, or in a circumstance in the rules, is not caught (s 24(3))`
#ASSERT `May I provide this vehicle` TRUE FALSE FALSE `to transport it to the importer, after it was imported` FALSE FALSE EQUALS `yes: providing it to have work done, to protect, store or transport it, or in a circumstance in the rules, is not caught (s 24(3))`
-- A vehicle on a non-RAV entry import approval (for example, a temporary visitor's) lent by its holder.
#ASSERT `May I provide this vehicle` TRUE FALSE FALSE `to sell, give, lend, lease or hire it, or give access to it` TRUE FALSE EQUALS `yes: I hold a non-RAV entry import approval that relates to it (s 24(4)(a))`
-- A locally built race car sold as not for public roads.
#ASSERT `May I provide this vehicle` TRUE FALSE FALSE `to sell, give, lend, lease or hire it, or give access to it` FALSE TRUE EQUALS `yes: it is made in Australia and I make it clear it is not for use on a public road, or only in exceptional circumstances (s 24(4)(b))`
-- A second-hand sale of a vehicle already provided in Australia before.
#ASSERT `May I provide this vehicle` TRUE FALSE TRUE `to sell, give, lend, lease or hire it, or give access to it` FALSE FALSE EQUALS `yes: it has already been provided in Australia before, so this is not its first provision (s 24(1)(b))`
#ASSERT `May I provide this vehicle` FALSE FALSE FALSE `to sell, give, lend, lease or hire it, or give access to it` FALSE FALSE EQUALS `the Act does not regulate it: it is not a road vehicle (s 6)`

-- ---------------------------------------------------------------------------------------------------------------------
-- s 26. An owner lifts the suspension of the ute she bought new last year: the Act does not reach it.
#ASSERT `May I modify this vehicle` TRUE TRUE TRUE FALSE EQUALS `the Act does not restrict it: s 26 applies only before the vehicle is first provided to a consumer in Australia; State or Territory law governs later modifications and use`
-- A dealer fits a bull bar before sale that takes it out of its entry pathway, not allowed by the rules.
#ASSERT `May I modify this vehicle` TRUE FALSE TRUE FALSE EQUALS `no: the modification would contravene s 26, an offence and a civil penalty of up to 120 penalty units`
#ASSERT `May I modify this vehicle` TRUE FALSE TRUE TRUE EQUALS `yes: the rules allow the modification (s 26(1)(e))`
#ASSERT `May I modify this vehicle` TRUE FALSE FALSE FALSE EQUALS `yes: the modification does not take it outside the entry pathway it was entered on the RAV under (s 26(1)(d))`
#ASSERT `May I modify this vehicle` FALSE FALSE TRUE FALSE EQUALS `s 26 does not apply: the vehicle is not on the RAV`

-- ---------------------------------------------------------------------------------------------------------------------
-- s 78. A new car bought from a dealer company, on the RAV, compliant.
#ASSERT `Can my vehicle be used despite State standards` TRUE TRUE TRUE FALSE EQUALS `yes: it may be used on public roads even though it does not meet a State or Territory road vehicle standard (s 78(1))`
-- ... it has since become defective.
#ASSERT `Can my vehicle be used despite State standards` TRUE TRUE TRUE TRUE EQUALS `not under s 78: the State or Territory may prohibit or regulate its use, because it no longer complies with the national standards or has become defective (s 78(4))`
-- A used import: not new when first provided in Australia.
#ASSERT `Can my vehicle be used despite State standards` FALSE TRUE TRUE FALSE EQUALS `not under s 78: it was not a new vehicle on the RAV, complying with the national standards, when first provided in Australia (s 78(1)(a))`
-- A car built and sold by a sole trader, owned by an individual, used only in one State.
#ASSERT `Can my vehicle be used despite State standards` TRUE TRUE FALSE FALSE EQUALS `not under s 78: none of the links to Commonwealth power in s 78(1)(b) applies`

-- ---------------------------------------------------------------------------------------------------------------------
-- Penalties for an individual.
#ASSERT `The most I can be fined in penalty units` `imported a road vehicle without being permitted to` EQUALS 120
#ASSERT `The most I can be fined in penalty units` `provided a road vehicle for the first time in Australia when it was not on the RAV` EQUALS 120
#ASSERT `The most I can be fined in penalty units` `modified a vehicle on the RAV, before it first reached a consumer, out of its entry pathway` EQUALS 120
#ASSERT `The most I can be fined in penalty units` `entered incorrect information on the RAV` EQUALS 60
#ASSERT `The most I can be fined in penalty units` `gave false or misleading information under the Act` EQUALS 60
#ASSERT `The most I can be fined in penalty units` `did not export or destroy an imported vehicle within the period my import approval set` EQUALS 120
#ASSERT `The most I can be fined in penalty units` `each further day the vehicle is not exported or destroyed` EQUALS 12
#ASSERT `The most I can be fined in penalty units` `did not comply with a recall notice, or supplied recalled vehicles or components` EQUALS 1050
#ASSERT `The most I can be fined in penalty units` `did not give the Minister a copy of a recall notice as the rules require` EQUALS 16
-- Infringement notices: 12 units for one recall contravention, 24 for two in one notice; 6 for a notification; none set here
-- for a Part 2 civil penalty.
#ASSERT `The infringement notice amount in penalty units` `did not comply with a recall notice, or supplied recalled vehicles or components` 1 EQUALS JUST 12
#ASSERT `The infringement notice amount in penalty units` `did not comply with a recall notice, or supplied recalled vehicles or components` 2 EQUALS JUST 24
#ASSERT `The infringement notice amount in penalty units` `did not give the Minister a copy of a recall notice as the rules require` 1 EQUALS JUST 6
#ASSERT `The infringement notice amount in penalty units` `imported a road vehicle without being permitted to` 1 EQUALS NOTHING
-- 120 penalty units at a hypothetical $330 a unit.
#ASSERT `The penalty units in dollars` 120 330 EQUALS 39600
