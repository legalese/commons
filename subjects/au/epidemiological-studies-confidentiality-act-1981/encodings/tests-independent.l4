IMPORT prelude
IMPORT `esc-rules`

-- Independent tests, written from the source text (see independent-expectations.md).
-- Field order: study, my part, how I got it, another's affairs, what I do,
-- for the study, to whom, Minister's authorisation, non-identifying publication, oath required.

-- 1: VVS conductor divulges another's affairs to a stranger: offence, 6 months / 10 units (s 4)
#ASSERT `it is an offence` (`Study case` OF `the Vietnam Veterans Study`, `I conduct, supervise or assist in it`, `by assisting in the study`, TRUE, `divulge or communicate it`, FALSE, `someone else`, FALSE, FALSE, FALSE)
#ASSERT (`the study position for` (`Study case` OF `the Vietnam Veterans Study`, `I conduct, supervise or assist in it`, `by assisting in the study`, TRUE, `divulge or communicate it`, FALSE, `someone else`, FALSE, FALSE, FALSE))'s `maximum imprisonment in months` EQUALS 6
#ASSERT (`the study position for` (`Study case` OF `the Vietnam Veterans Study`, `I conduct, supervise or assist in it`, `by assisting in the study`, TRUE, `divulge or communicate it`, FALSE, `someone else`, FALSE, FALSE, FALSE))'s `maximum penalty units` EQUALS 10
-- 2: for the purpose of the study: no offence (s 4)
#ASSERT NOT (`it is an offence` (`Study case` OF `the Vietnam Veterans Study`, `I conduct, supervise or assist in it`, `by assisting in the study`, TRUE, `divulge or communicate it`, TRUE, `someone else`, FALSE, FALSE, FALSE))
-- 3: making a record: offence (s 4)
#ASSERT `it is an offence` (`Study case` OF `the Vietnam Veterans Study`, `I conduct, supervise or assist in it`, `by assisting in the study`, TRUE, `make a record of it`, FALSE, `someone else`, FALSE, FALSE, FALSE)
-- 4: only a subject: not a person assisting (s 3(2))
#ASSERT NOT (`it is an offence` (`Study case` OF `the Vietnam Veterans Study`, `I am only a subject or gave information about a subject`, `by assisting in the study`, TRUE, `divulge or communicate it`, FALSE, `someone else`, FALSE, FALSE, FALSE))
-- 5: non-prescribed study (s 3(1))
#ASSERT NOT (`it is an offence` (`Study case` OF `another study`, `I conduct, supervise or assist in it`, `by assisting in the study`, TRUE, `divulge or communicate it`, FALSE, `someone else`, FALSE, FALSE, FALSE))
-- 6: declared Commonwealth study (s 3(1)(b), s 9)
#ASSERT `it is an offence` (`Study case` OF `a Commonwealth study declared by the regulations`, `I conduct, supervise or assist in it`, `by assisting in the study`, TRUE, `divulge or communicate it`, FALSE, `someone else`, FALSE, FALSE, FALSE)
-- 7: to the supplier (s 7(a))
#ASSERT NOT (`it is an offence` (`Study case` OF `the Vietnam Veterans Study`, `I conduct, supervise or assist in it`, `by assisting in the study`, TRUE, `divulge or communicate it`, FALSE, `the person who supplied it`, FALSE, FALSE, FALSE))
-- 8: to the only person concerned (s 7(b))
#ASSERT NOT (`it is an offence` (`Study case` OF `the Vietnam Veterans Study`, `I conduct, supervise or assist in it`, `by assisting in the study`, TRUE, `divulge or communicate it`, FALSE, `the only person it concerns`, FALSE, FALSE, FALSE))
-- 9: to one of several, with others' consent (s 7(c))
#ASSERT NOT (`it is an offence` (`Study case` OF `the Vietnam Veterans Study`, `I conduct, supervise or assist in it`, `by assisting in the study`, TRUE, `divulge or communicate it`, FALSE, `one of the persons it concerns, with the others' consent`, FALSE, FALSE, FALSE))
-- 10: without consent the recipient is just someone else (s 4)
#ASSERT `it is an offence` (`Study case` OF `the Vietnam Veterans Study`, `I conduct, supervise or assist in it`, `by assisting in the study`, TRUE, `divulge or communicate it`, FALSE, `someone else`, FALSE, FALSE, FALSE)
-- 11: nominee (s 7(d))
#ASSERT NOT (`it is an offence` (`Study case` OF `the Vietnam Veterans Study`, `I conduct, supervise or assist in it`, `by assisting in the study`, TRUE, `divulge or communicate it`, FALSE, `a person nominated by one of those persons`, FALSE, FALSE, FALSE))
-- 12: access under Minister's authorisation (s 5)
#ASSERT NOT (`it is an offence` (`Study case` OF `the Vietnam Veterans Study`, `I conduct, supervise or assist in it`, `by assisting in the study`, TRUE, `give a person assisting another prescribed study access to a document`, FALSE, `someone else`, TRUE, FALSE, FALSE))
-- 13: same access without authorisation (s 4)
#ASSERT `it is an offence` (`Study case` OF `the Vietnam Veterans Study`, `I conduct, supervise or assist in it`, `by assisting in the study`, TRUE, `give a person assisting another prescribed study access to a document`, FALSE, `someone else`, FALSE, FALSE, FALSE)
-- 14: info from s 5 access, not for either study (s 6)
#ASSERT `it is an offence` (`Study case` OF `the Vietnam Veterans Study`, `I conduct, supervise or assist in it`, `by access to another study's document under a section 5 authorisation`, TRUE, `divulge or communicate it`, FALSE, `someone else`, FALSE, FALSE, FALSE)
-- 15: for either study (s 6)
#ASSERT NOT (`it is an offence` (`Study case` OF `the Vietnam Veterans Study`, `I conduct, supervise or assist in it`, `by access to another study's document under a section 5 authorisation`, TRUE, `divulge or communicate it`, TRUE, `someone else`, FALSE, FALSE, FALSE))
-- 16: own affairs only (s 4 "another person")
#ASSERT NOT (`it is an offence` (`Study case` OF `the Vietnam Veterans Study`, `I conduct, supervise or assist in it`, `by assisting in the study`, FALSE, `divulge or communicate it`, FALSE, `someone else`, FALSE, FALSE, FALSE))
-- 17: non-identifying publication (s 11(1))
#ASSERT NOT (`it is an offence` (`Study case` OF `the Vietnam Veterans Study`, `I conduct, supervise or assist in it`, `by assisting in the study`, TRUE, `divulge or communicate it`, FALSE, `someone else`, FALSE, TRUE, FALSE))
-- 18: identifying publication: not protected (s 11(1))
#ASSERT `it is an offence` (`Study case` OF `the Vietnam Veterans Study`, `I conduct, supervise or assist in it`, `by assisting in the study`, TRUE, `divulge or communicate it`, FALSE, `someone else`, FALSE, FALSE, FALSE)
-- 19: court cannot require (s 8(1))
#ASSERT `may I be required to give it to a court` (`Study case` OF `the Vietnam Veterans Study`, `I conduct, supervise or assist in it`, `by assisting in the study`, TRUE, `divulge or communicate it`, FALSE, `someone else`, FALSE, FALSE, FALSE) EQUALS JUST FALSE
-- 20: s 5 access holder: court cannot require (s 8(2))
#ASSERT `may I be required to give it to a court` (`Study case` OF `the Vietnam Veterans Study`, `I conduct, supervise or assist in it`, `by access to another study's document under a section 5 authorisation`, TRUE, `divulge or communicate it`, FALSE, `someone else`, FALSE, FALSE, FALSE) EQUALS JUST FALSE
-- 21: non-prescribed: the Act is silent
#ASSERT `may I be required to give it to a court` (`Study case` OF `another study`, `I conduct, supervise or assist in it`, `by assisting in the study`, TRUE, `divulge or communicate it`, FALSE, `someone else`, FALSE, FALSE, FALSE) EQUALS NOTHING
-- 22: oath required (s 10)
#ASSERT `must I take the oath` (`Study case` OF `the Vietnam Veterans Study`, `I conduct, supervise or assist in it`, `by assisting in the study`, TRUE, `divulge or communicate it`, FALSE, `someone else`, FALSE, FALSE, TRUE)
-- 23: oath not required (s 10)
#ASSERT NOT (`must I take the oath` (`Study case` OF `the Vietnam Veterans Study`, `I conduct, supervise or assist in it`, `by assisting in the study`, TRUE, `divulge or communicate it`, FALSE, `someone else`, FALSE, FALSE, FALSE))
-- 24: non-prescribed study: s 10 does not reach
#ASSERT NOT (`must I take the oath` (`Study case` OF `another study`, `I conduct, supervise or assist in it`, `by assisting in the study`, TRUE, `divulge or communicate it`, FALSE, `someone else`, FALSE, FALSE, TRUE))
