#ASSERT (`the explosives position for` (`Explosives case` OF `the Commonwealth's, or in its possession or control`, TRUE, 30, FALSE))'s `maximum fine in penalty units` EQUALS 70
-- 10
#ASSERT (`the explosives position for` (`Explosives case` OF `the Commonwealth's, or in its possession or control`, FALSE, 0, FALSE))'s `I commit an offence` EQUALS FALSE
-- 10
#ASSERT (`the explosives position for` (`Explosives case` OF `the Commonwealth's, or in its possession or control`, FALSE, 0, FALSE))'s `maximum imprisonment in months` EQUALS 0
