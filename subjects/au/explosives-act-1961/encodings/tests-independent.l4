IMPORT prelude
IMPORT `expl-rules`

-- Independent tests: expected values from independent-expectations.md.

-- 1
#ASSERT (`the explosives position for` (`Explosives case` OF `the Commonwealth's, or in its possession or control`, FALSE, 0, FALSE))'s `Part II reaches these explosives` EQUALS TRUE
-- 2
#ASSERT (`the explosives position for` (`Explosives case` OF `made by the Commonwealth and being exported under an arrangement with it`, FALSE, 0, FALSE))'s `Part II reaches these explosives` EQUALS TRUE
-- 3
#ASSERT (`the explosives position for` (`Explosives case` OF `a foreign government's or forces', here with Commonwealth approval for defence`, FALSE, 0, FALSE))'s `Part II reaches these explosives` EQUALS TRUE
-- 4
#ASSERT (`the explosives position for` (`Explosives case` OF `anyone else's`, FALSE, 0, FALSE))'s `Part II reaches these explosives` EQUALS FALSE
-- 5
#ASSERT (`the explosives position for` (`Explosives case` OF `the Commonwealth's, or in its possession or control`, TRUE, 0, FALSE))'s `I commit an offence` EQUALS TRUE
-- 5
#ASSERT (`the explosives position for` (`Explosives case` OF `the Commonwealth's, or in its possession or control`, TRUE, 0, FALSE))'s `maximum imprisonment in months` EQUALS 6
-- 5
#ASSERT (`the explosives position for` (`Explosives case` OF `the Commonwealth's, or in its possession or control`, TRUE, 0, FALSE))'s `maximum fine in penalty units` EQUALS 10
-- 5
#ASSERT (`the explosives position for` (`Explosives case` OF `the Commonwealth's, or in its possession or control`, TRUE, 0, FALSE))'s `a lesser prescribed penalty applies instead` EQUALS FALSE
-- 6
#ASSERT (`the explosives position for` (`Explosives case` OF `the Commonwealth's, or in its possession or control`, TRUE, 1, FALSE))'s `maximum fine in penalty units` EQUALS 12
-- 6
#ASSERT (`the explosives position for` (`Explosives case` OF `the Commonwealth's, or in its possession or control`, TRUE, 1, FALSE))'s `maximum imprisonment in months` EQUALS 6
