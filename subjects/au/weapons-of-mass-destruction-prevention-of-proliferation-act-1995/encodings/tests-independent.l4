IMPORT prelude
IMPORT daydate
IMPORT `wmd-rules`

-- 1 s 9(1)
#ASSERT ((`the WMD position for` (`WMD case` OF `supplying goods to another person`, `acting in Australia or an external Territory`, TRUE, FALSE, FALSE, `no notice`, FALSE, FALSE, NOTHING, FALSE, (Date 1 6 2025)))'s `I commit an offence under ss 9-11`) EQUALS TRUE

-- 1 8 years
#ASSERT ((`the WMD position for` (`WMD case` OF `supplying goods to another person`, `acting in Australia or an external Territory`, TRUE, FALSE, FALSE, `no notice`, FALSE, FALSE, NOTHING, FALSE, (Date 1 6 2025)))'s `maximum imprisonment in years`) EQUALS 8

-- 1 s 17(1) forfeited
#ASSERT ((`the WMD position for` (`WMD case` OF `supplying goods to another person`, `acting in Australia or an external Territory`, TRUE, FALSE, FALSE, `no notice`, FALSE, FALSE, NOTHING, FALSE, (Date 1 6 2025)))'s `goods are forfeited`) EQUALS TRUE

-- 2 s 10(1)
#ASSERT ((`the WMD position for` (`WMD case` OF `exporting goods that are not prohibited exports under the Customs Act`, `acting in Australia or an external Territory`, TRUE, FALSE, FALSE, `no notice`, FALSE, FALSE, NOTHING, FALSE, (Date 1 6 2025)))'s `I commit an offence under ss 9-11`) EQUALS TRUE

-- 2 s 17(1)
#ASSERT ((`the WMD position for` (`WMD case` OF `exporting goods that are not prohibited exports under the Customs Act`, `acting in Australia or an external Territory`, TRUE, FALSE, FALSE, `no notice`, FALSE, FALSE, NOTHING, FALSE, (Date 1 6 2025)))'s `goods are forfeited`) EQUALS TRUE

-- 3 s 11(1)
#ASSERT ((`the WMD position for` (`WMD case` OF `providing services to another person`, `acting in Australia or an external Territory`, TRUE, FALSE, FALSE, `no notice`, FALSE, FALSE, NOTHING, FALSE, (Date 1 6 2025)))'s `I commit an offence under ss 9-11`) EQUALS TRUE

-- 3 8 years
#ASSERT ((`the WMD position for` (`WMD case` OF `providing services to another person`, `acting in Australia or an external Territory`, TRUE, FALSE, FALSE, `no notice`, FALSE, FALSE, NOTHING, FALSE, (Date 1 6 2025)))'s `maximum imprisonment in years`) EQUALS 8

-- 3 services not forfeited
#ASSERT ((`the WMD position for` (`WMD case` OF `providing services to another person`, `acting in Australia or an external Territory`, TRUE, FALSE, FALSE, `no notice`, FALSE, FALSE, NOTHING, FALSE, (Date 1 6 2025)))'s `goods are forfeited`) EQUALS FALSE

-- 4 no belief
#ASSERT ((`the WMD position for` (`WMD case` OF `supplying goods to another person`, `acting in Australia or an external Territory`, FALSE, FALSE, FALSE, `no notice`, FALSE, FALSE, NOTHING, FALSE, (Date 1 6 2025)))'s `I commit an offence under ss 9-11`) EQUALS FALSE

-- 4 no forfeiture
#ASSERT ((`the WMD position for` (`WMD case` OF `supplying goods to another person`, `acting in Australia or an external Territory`, FALSE, FALSE, FALSE, `no notice`, FALSE, FALSE, NOTHING, FALSE, (Date 1 6 2025)))'s `goods are forfeited`) EQUALS FALSE

-- 4 max 0 (no offence)
#ASSERT ((`the WMD position for` (`WMD case` OF `supplying goods to another person`, `acting in Australia or an external Territory`, FALSE, FALSE, FALSE, `no notice`, FALSE, FALSE, NOTHING, FALSE, (Date 1 6 2025)))'s `maximum imprisonment in years`) EQUALS 0

-- 5 s 9(1)(c) permit kept
#ASSERT ((`the WMD position for` (`WMD case` OF `supplying goods to another person`, `acting in Australia or an external Territory`, TRUE, TRUE, FALSE, `no notice`, FALSE, FALSE, NOTHING, FALSE, (Date 1 6 2025)))'s `I commit an offence under ss 9-11`) EQUALS FALSE

-- 6 s 9(1)(c) permit conditions breached
#ASSERT ((`the WMD position for` (`WMD case` OF `supplying goods to another person`, `acting in Australia or an external Territory`, TRUE, FALSE, FALSE, `no notice`, FALSE, FALSE, NOTHING, FALSE, (Date 1 6 2025)))'s `I commit an offence under ss 9-11`) EQUALS TRUE

-- 7 s 9(1)(d) s 12 all-clear
#ASSERT ((`the WMD position for` (`WMD case` OF `supplying goods to another person`, `acting in Australia or an external Territory`, TRUE, FALSE, TRUE, `no notice`, FALSE, FALSE, NOTHING, FALSE, (Date 1 6 2025)))'s `I commit an offence under ss 9-11`) EQUALS FALSE

-- 8 s 6(3)(b) Australian abroad
#ASSERT ((`the WMD position for` (`WMD case` OF `supplying goods to another person`, `abroad, an Australian citizen, resident or body incorporated in Australia`, TRUE, FALSE, FALSE, `no notice`, FALSE, FALSE, NOTHING, FALSE, (Date 1 6 2025)))'s `I commit an offence under ss 9-11`) EQUALS TRUE

-- 9 s 6(3) foreigner abroad
#ASSERT ((`the WMD position for` (`WMD case` OF `supplying goods to another person`, `abroad, anyone else`, TRUE, FALSE, FALSE, `no notice`, FALSE, FALSE, NOTHING, FALSE, (Date 1 6 2025)))'s `I commit an offence under ss 9-11`) EQUALS FALSE

-- 10 s 9(2) complying with conditional notice
#ASSERT ((`the WMD position for` (`WMD case` OF `supplying goods to another person`, `acting in Australia or an external Territory`, TRUE, FALSE, FALSE, `a notice allowing it only on conditions`, TRUE, TRUE, (JUST (Date 1 3 2025)), FALSE, (Date 1 6 2025)))'s `I commit an offence under ss 9-11`) EQUALS FALSE

-- 10 s 14(6) no contravention
#ASSERT ((`the WMD position for` (`WMD case` OF `supplying goods to another person`, `acting in Australia or an external Territory`, TRUE, FALSE, FALSE, `a notice allowing it only on conditions`, TRUE, TRUE, (JUST (Date 1 3 2025)), FALSE, (Date 1 6 2025)))'s `I commit an offence under s 14(6)`) EQUALS FALSE

-- 11 s 14(6) breach of conditions
#ASSERT ((`the WMD position for` (`WMD case` OF `supplying goods to another person`, `acting in Australia or an external Territory`, TRUE, FALSE, FALSE, `a notice allowing it only on conditions`, FALSE, TRUE, (JUST (Date 1 3 2025)), FALSE, (Date 1 6 2025)))'s `I commit an offence under s 14(6)`) EQUALS TRUE

-- 11 s 9 too
#ASSERT ((`the WMD position for` (`WMD case` OF `supplying goods to another person`, `acting in Australia or an external Territory`, TRUE, FALSE, FALSE, `a notice allowing it only on conditions`, FALSE, TRUE, (JUST (Date 1 3 2025)), FALSE, (Date 1 6 2025)))'s `I commit an offence under ss 9-11`) EQUALS TRUE

-- 12 s 14(6) prohibiting notice
#ASSERT ((`the WMD position for` (`WMD case` OF `supplying goods to another person`, `acting in Australia or an external Territory`, FALSE, FALSE, FALSE, `a notice prohibiting the dealing`, FALSE, TRUE, (JUST (Date 1 3 2025)), FALSE, (Date 1 6 2025)))'s `I commit an offence under s 14(6)`) EQUALS TRUE

-- 12 s 17(1)
#ASSERT ((`the WMD position for` (`WMD case` OF `supplying goods to another person`, `acting in Australia or an external Territory`, FALSE, FALSE, FALSE, `a notice prohibiting the dealing`, FALSE, TRUE, (JUST (Date 1 3 2025)), FALSE, (Date 1 6 2025)))'s `goods are forfeited`) EQUALS TRUE

-- 12 8 years
#ASSERT ((`the WMD position for` (`WMD case` OF `supplying goods to another person`, `acting in Australia or an external Territory`, FALSE, FALSE, FALSE, `a notice prohibiting the dealing`, FALSE, TRUE, (JUST (Date 1 3 2025)), FALSE, (Date 1 6 2025)))'s `maximum imprisonment in years`) EQUALS 8

-- 13 s 14(6)(c) no knowledge
#ASSERT ((`the WMD position for` (`WMD case` OF `supplying goods to another person`, `acting in Australia or an external Territory`, FALSE, FALSE, FALSE, `a notice prohibiting the dealing`, FALSE, FALSE, (JUST (Date 1 3 2025)), FALSE, (Date 1 6 2025)))'s `I commit an offence under s 14(6)`) EQUALS FALSE

-- 14 s 14(4) given 15 Mar 2025
#ASSERT ((`the WMD position for` (`WMD case` OF `supplying goods to another person`, `acting in Australia or an external Territory`, TRUE, FALSE, FALSE, `a notice prohibiting the dealing`, FALSE, FALSE, (JUST (Date 15 3 2025)), FALSE, (Date 1 6 2025)))'s `the notice's last day in force`) EQUALS JUST (Date 14 3 2026)

-- 15 s 14(4) last day
#ASSERT ((`the WMD position for` (`WMD case` OF `supplying goods to another person`, `acting in Australia or an external Territory`, FALSE, FALSE, FALSE, `a notice prohibiting the dealing`, FALSE, TRUE, (JUST (Date 15 3 2025)), FALSE, (Date 14 3 2026)))'s `I commit an offence under s 14(6)`) EQUALS TRUE

-- 16 s 14(4) day after
#ASSERT ((`the WMD position for` (`WMD case` OF `supplying goods to another person`, `acting in Australia or an external Territory`, FALSE, FALSE, FALSE, `a notice prohibiting the dealing`, FALSE, TRUE, (JUST (Date 15 3 2025)), FALSE, (Date 15 3 2026)))'s `I commit an offence under s 14(6)`) EQUALS FALSE

-- 17 s 14(4) given 29 Feb 2024
#ASSERT ((`the WMD position for` (`WMD case` OF `supplying goods to another person`, `acting in Australia or an external Territory`, TRUE, FALSE, FALSE, `a notice prohibiting the dealing`, FALSE, FALSE, (JUST (Date 29 2 2024)), FALSE, (Date 1 6 2025)))'s `the notice's last day in force`) EQUALS JUST (Date 28 2 2025)

-- 17b s 14(4) given 31 Jan 2025
#ASSERT ((`the WMD position for` (`WMD case` OF `supplying goods to another person`, `acting in Australia or an external Territory`, TRUE, FALSE, FALSE, `a notice prohibiting the dealing`, FALSE, FALSE, (JUST (Date 31 1 2025)), FALSE, (Date 1 6 2025)))'s `the notice's last day in force`) EQUALS JUST (Date 30 1 2026)

-- 18 s 14(3) revoked
#ASSERT ((`the WMD position for` (`WMD case` OF `supplying goods to another person`, `acting in Australia or an external Territory`, FALSE, FALSE, FALSE, `a notice prohibiting the dealing`, FALSE, TRUE, (JUST (Date 1 3 2025)), TRUE, (Date 1 6 2025)))'s `I commit an offence under s 14(6)`) EQUALS FALSE

-- 19 dealing before notice
#ASSERT ((`the WMD position for` (`WMD case` OF `supplying goods to another person`, `acting in Australia or an external Territory`, FALSE, FALSE, FALSE, `a notice prohibiting the dealing`, FALSE, TRUE, (JUST (Date 1 3 2025)), FALSE, (Date 28 2 2025)))'s `I commit an offence under s 14(6)`) EQUALS FALSE

-- 20 s 14(6) services
#ASSERT ((`the WMD position for` (`WMD case` OF `providing services to another person`, `acting in Australia or an external Territory`, FALSE, FALSE, FALSE, `a notice prohibiting the dealing`, FALSE, TRUE, (JUST (Date 1 3 2025)), FALSE, (Date 1 6 2025)))'s `I commit an offence under s 14(6)`) EQUALS TRUE

-- 20 no forfeiture
#ASSERT ((`the WMD position for` (`WMD case` OF `providing services to another person`, `acting in Australia or an external Territory`, FALSE, FALSE, FALSE, `a notice prohibiting the dealing`, FALSE, TRUE, (JUST (Date 1 3 2025)), FALSE, (Date 1 6 2025)))'s `goods are forfeited`) EQUALS FALSE

