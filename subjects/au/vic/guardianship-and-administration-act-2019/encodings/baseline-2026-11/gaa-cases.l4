§§ `ss 150-164 -- rehearings and reassessments`

#ASSERT `Can I apply for a rehearing` `I was a party` `an order on an application` FALSE EQUALS `yes, as a party (s 150(1))`
#ASSERT `Can I apply for a rehearing` `I was entitled to notice but was not a party` `an order on an application` FALSE EQUALS `yes, if VCAT gives leave (s 150(2))`
#ASSERT `Can I apply for a rehearing` `neither` `an order on an application` FALSE EQUALS `not covered: the Act gives the right only to a party or a person entitled to notice`
#ASSERT `Can I apply for a rehearing` `I was a party` `an urgent order appointing a guardian or administrator` FALSE EQUALS `not covered: s 150 excludes urgent orders appointing a guardian or administrator`
#ASSERT `Can I apply for a rehearing` `I was a party` `an order on a reassessment VCAT conducted on its own initiative` FALSE EQUALS `yes, if VCAT gives leave (s 151)`
#ASSERT `Can I apply for a rehearing` `I was entitled to notice but was not a party` `an order on a reassessment VCAT conducted on its own initiative` FALSE EQUALS `yes, if VCAT gives leave (s 151)`
#ASSERT `Can I apply for a rehearing` `I was a party` `an order on an application` TRUE EQUALS `no: a rehearing cannot be sought of this (s 153)`
#ASSERT `Can I apply for a rehearing` `I was a party` `an order on a reassessment VCAT conducted on its own initiative` TRUE EQUALS `yes, if VCAT gives leave (s 151)`
#ASSERT `Can I apply for a rehearing` `I was a party` `an order on an application for a rehearing or for leave` FALSE EQUALS `no: a rehearing cannot be sought of this (s 153)`
#ASSERT `Can I apply for a rehearing` `I was a party` `an order on a reassessment someone applied for` FALSE EQUALS `yes, as a party (s 150(1))`
#ASSERT `Can I apply for a rehearing` `neither` `an order on a reassessment VCAT conducted on its own initiative` FALSE EQUALS `not covered: the Act gives the right only to a party or a person entitled to notice`

#ASSERT `By when must I apply for a rehearing` (`d` 1 3 2027) FALSE (`d` 1 1 2000) EQUALS `d` 29 3 2027
#ASSERT `By when must I apply for a rehearing` (`d` 1 3 2027) TRUE (`d` 10 3 2027) EQUALS `d` 7 4 2027

#ASSERT `Is my rehearing application in time` (`d` 1 3 2027) FALSE (`d` 1 1 2000) TRUE (`d` 29 3 2027) (`d` 1 6 2027) EQUALS `in time`
#ASSERT `Is my rehearing application in time` (`d` 1 3 2027) FALSE (`d` 1 1 2000) TRUE (`d` 30 3 2027) (`d` 1 6 2027) EQUALS `late`
#ASSERT `Is my rehearing application in time` (`d` 1 3 2027) FALSE (`d` 1 1 2000) FALSE (`d` 1 1 2000) (`d` 29 3 2027) EQUALS `still open`
#ASSERT `Is my rehearing application in time` (`d` 1 3 2027) FALSE (`d` 1 1 2000) FALSE (`d` 1 1 2000) (`d` 30 3 2027) EQUALS `passed`
#ASSERT `Is my rehearing application in time` (`d` 1 3 2027) TRUE (`d` 10 3 2027) TRUE (`d` 7 4 2027) (`d` 1 6 2027) EQUALS `in time`

#ASSERT `By when must VCAT next reassess my order` (`d` 1 3 2026) FALSE FALSE (`d` 1 1 2000) EQUALS JUST (`d` 1 3 2027)
#ASSERT `By when must VCAT next reassess my order` (`d` 1 3 2026) TRUE FALSE (`d` 1 1 2000) EQUALS NOTHING
#ASSERT `By when must VCAT next reassess my order` (`d` 1 3 2026) FALSE TRUE (`d` 15 2 2027) EQUALS JUST (`d` 1 3 2032)
#ASSERT `By when must VCAT next reassess my order` (`d` 1 3 2026) FALSE TRUE (`d` 1 3 2029) EQUALS JUST (`d` 1 3 2032)
#ASSERT `By when must VCAT next reassess my order` (`d` 1 3 2026) FALSE TRUE (`d` 2 3 2029) EQUALS JUST (`d` 1 3 2035)
#ASSERT `By when must VCAT next reassess my order` (`d` 1 3 2026) FALSE TRUE (`d` 1 6 2031) EQUALS JUST (`d` 1 3 2035)

#ASSERT `Have I asked for a reassessment hearing in time` (`d` 1 6 2027) TRUE (`d` 15 6 2027) (`d` 1 7 2027) EQUALS `in time`
#ASSERT `Have I asked for a reassessment hearing in time` (`d` 1 6 2027) TRUE (`d` 16 6 2027) (`d` 1 7 2027) EQUALS `late`
#ASSERT `Have I asked for a reassessment hearing in time` (`d` 1 6 2027) FALSE (`d` 1 1 2000) (`d` 15 6 2027) EQUALS `still open`
#ASSERT `Have I asked for a reassessment hearing in time` (`d` 1 6 2027) FALSE (`d` 1 1 2000) (`d` 16 6 2027) EQUALS `passed`
