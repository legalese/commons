#ASSERT `Can someone apply for an order for me` `GO` `a brain injury` 40 TRUE FALSE FALSE EQUALS `yes: anyone may apply to VCAT for this order for me (ss 22, 23, 79, 80)`
#ASSERT `Can someone apply for an order for me` `SAO` `a mental disorder` 40 TRUE FALSE TRUE EQUALS `yes, but only for my property that is in Victoria (ss 23(2), 80(2))`
#ASSERT `Can someone apply for an order for me` `SGO` `an intellectual impairment` 19 TRUE TRUE FALSE EQUALS `yes: anyone may apply to VCAT for this order for me (ss 22, 23, 79, 80)`

