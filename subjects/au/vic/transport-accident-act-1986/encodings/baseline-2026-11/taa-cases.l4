§§ `Regulative rules`

-- s 70(1): a response on day 21 meets the duty.
#ASSERT EVALTRACE (`s 70(1), (3) -- the Commission must respond to a claim within 21 days` 365) 0 (LIST (EVENT `the Commission` (`respond to the claim` `request further information or a medical examination`) 21)) EQUALS FULFILLED
#ASSERT EVALTRACE (`s 70(1), (3) -- the Commission must respond to a claim within 21 days` 365) 0 (LIST (EVENT `the Commission` (`respond to the claim` `accept liability`) 3)) EQUALS FULFILLED
-- No response by day 21: deemed rejection; the claimant may apply to the Tribunal (the trace still waits on that).
#ASSERT NOT (`ends fulfilled` (EVALTRACE (`s 70(1), (3) -- the Commission must respond to a claim within 21 days` 365) 0 (LIST (WAITUNTIL 22))))
#ASSERT EVALTRACE (`s 70(1), (3) -- the Commission must respond to a claim within 21 days` 365) 0 (LIST (WAITUNTIL 22), (EVENT `the claimant` `apply to the Tribunal for review of the deemed rejection` 300)) EQUALS FULFILLED
-- s 70(4): complied with on day 28; not by day 28: the claim lapses.
#ASSERT EVALTRACE `s 70(4) -- the claimant must comply with a request within 28 days` 0 (LIST (EVENT `the claimant` `give the further information or attend the medical examination` 28)) EQUALS FULFILLED
#ASSERT NOT (`ends fulfilled` (EVALTRACE `s 70(4) -- the claimant must comply with a request within 28 days` 0 (LIST (WAITUNTIL 29))))
-- s 64(1), s 66: the report on day 28; no report, and the penalty paid 14 days after the lapse is noticed (the trace
-- counts the 14 days from the WAITUNTIL at 29: so 43); not paid by then: breach.
#ASSERT EVALTRACE `s 64(1), s 66 -- the driver must report within 28 days, or pay the penalty within 14 days after` 0 (LIST (EVENT `the driver` `make the report in the prescribed form` 28)) EQUALS FULFILLED
#ASSERT EVALTRACE `s 64(1), s 66 -- the driver must report within 28 days, or pay the penalty within 14 days after` 0 (LIST (WAITUNTIL 29), (EVENT `the driver` `pay the penalty of $50` 43)) EQUALS FULFILLED
#ASSERT NOT (`ends fulfilled` (EVALTRACE `s 64(1), s 66 -- the driver must report within 28 days, or pay the penalty within 14 days after` 0 (LIST (WAITUNTIL 29), (EVENT `the driver` `pay the penalty of $50` 44))))
-- s 49(4): 15 August 2028 to 15 October 2028 is 61 days: the statement on day 61; none by day 61: breach.
#ASSERT DATE_SERIAL (`By what day must I give my statement of earnings` (`dt` 15 8 2027) 1) MINUS DATE_SERIAL (`dt` 15 8 2028) EQUALS 61
#ASSERT EVALTRACE (`s 49(4) -- the statement of earnings within two months after each anniversary` 61) 0 (LIST (EVENT `the person receiving weekly payments` `give the statement of earnings` 61)) EQUALS FULFILLED
#ASSERT NOT (`ends fulfilled` (EVALTRACE (`s 49(4) -- the statement of earnings within two months after each anniversary` 61) 0 (LIST (WAITUNTIL 62))))
-- s 46A(1A): 1 March 2026 to 1 March 2032 is 2192 days. Any of the three within them: fulfilled; none: breach.
#ASSERT DATE_SERIAL (`By what day must I apply for an impairment assessment` (`dt` 1 3 2026) (`dt` 1 3 2026) FALSE (`dt` 1 1 1990)) MINUS DATE_SERIAL (`dt` 1 3 2026) EQUALS 2192
#ASSERT EVALTRACE (`s 46A(1A) -- within 6 years, an impairment determination, advice or written application` 2192) 0 (LIST (EVENT `the injured person` `apply in writing for an impairment assessment` 2192)) EQUALS FULFILLED
#ASSERT EVALTRACE (`s 46A(1A) -- within 6 years, an impairment determination, advice or written application` 2192) 0 (LIST (EVENT `the Commission` `advise that an impairment benefit appears likely` 100)) EQUALS FULFILLED
#ASSERT NOT (`ends fulfilled` (EVALTRACE (`s 46A(1A) -- within 6 years, an impairment determination, advice or written application` 2192) 0 (LIST (WAITUNTIL 2193))))
