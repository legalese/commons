IMPORT prelude
IMPORT `tar-core`
IMPORT `tar-seat`

-- Cases for the individual's seat (tar-seat.l4) and the core's rules (tar-core.l4).
-- Every expected value is worked by hand from the deposited text (Version No. 002, with the Act's Version No. 159 for
-- the provisions restated), with the reasoning in the comment; none is copied from the encoding's output. Each
-- exported question has cases with its edges: 50% and 51% of the body burned, 10 and 11 degrees, an acuity of exactly
-- 6/60 and just under it, $50 000 and $50 001, the first and last day r 11 is known, the last day and the day after
-- for the statement and the report, 29 February and month ends.
-- Breached traces are asserted with CONSIDER ... WHEN FULFILLED (EVALTRACE ... EQUALS cannot test a breach).

§ `Cases`

GIVEN `dd` IS A NUMBER, `mm` IS A NUMBER, `yy` IS A NUMBER
GIVETH A DATE
`dt` `dd` `mm` `yy` MEANS DATE_FROM_DMY `dd` `mm` `yy`

GIVEN `the outcome` IS A DEONTIC `TAR party` `TAR action`
GIVETH A BOOLEAN
`ends fulfilled` `the outcome` MEANS
    CONSIDER `the outcome`
    WHEN FULFILLED THEN TRUE
    OTHERWISE FALSE

§§ `Severe injury (s 3(1), r 5)`

-- Helpers: `sev` and `route` ask the two seat questions; arguments in the order of the seat's inputs (head, % burned,
-- disfigurement, full-thickness burns to the listed parts, mobility, communication, self-care, field, right acuity,
-- left acuity, combination, brachial plexus, loss of a limb). `none` is an injury on no route: no head, no burns,
-- a full field (90), 6/6 in both eyes, no brachial plexus injury.
GIVEN `h` IS A `Head of s 3(1)(a) other than burns`, `pct` IS A NUMBER, `dis` IS A BOOLEAN, `ftb` IS A BOOLEAN
      `mob` IS A BOOLEAN, `com` IS A BOOLEAN, `sc` IS A BOOLEAN, `fld` IS A NUMBER, `ra` IS A NUMBER, `la` IS A NUMBER
      `comb` IS A BOOLEAN, `bp` IS A BOOLEAN, `limb` IS A BOOLEAN
GIVETH A BOOLEAN
`sev` `h` `pct` `dis` `ftb` `mob` `com` `sc` `fld` `ra` `la` `comb` `bp` `limb` MEANS
    `Is my injury a severe injury` `h` `pct` `dis` `ftb` `mob` `com` `sc` `fld` `ra` `la` `comb` `bp` `limb`

GIVEN `h` IS A `Head of s 3(1)(a) other than burns`, `pct` IS A NUMBER, `dis` IS A BOOLEAN, `ftb` IS A BOOLEAN
      `mob` IS A BOOLEAN, `com` IS A BOOLEAN, `sc` IS A BOOLEAN, `fld` IS A NUMBER, `ra` IS A NUMBER, `la` IS A NUMBER
      `comb` IS A BOOLEAN, `bp` IS A BOOLEAN, `limb` IS A BOOLEAN
GIVETH A `Severe injury route`
`route` `h` `pct` `dis` `ftb` `mob` `com` `sc` `fld` `ra` `la` `comb` `bp` `limb` MEANS
    `Which part of the definition makes my injury a severe injury` `h` `pct` `dis` `ftb` `mob` `com` `sc` `fld` `ra` `la` `comb` `bp` `limb`

-- No head, no burns, full sight, no brachial plexus injury: on no route, so not a severe injury.
#ASSERT `sev` `none of these` 0 FALSE FALSE FALSE FALSE FALSE 90 1 1 FALSE FALSE FALSE EQUALS FALSE
#ASSERT `route` `none of these` 0 FALSE FALSE FALSE FALSE FALSE 90 1 1 FALSE FALSE FALSE EQUALS `not a severe injury`
-- s 3(1)(a): paraplegia; quadriplegia; amputation; a significant acquired brain injury.
#ASSERT `sev` `paraplegia` 0 FALSE FALSE FALSE FALSE FALSE 90 1 1 FALSE FALSE FALSE EQUALS TRUE
#ASSERT `route` `quadriplegia` 0 FALSE FALSE FALSE FALSE FALSE 90 1 1 FALSE FALSE FALSE EQUALS `s 3(1)(a) -- a brain injury, paraplegia, quadriplegia or an amputation`
#ASSERT `sev` `amputation of a limb` 0 FALSE FALSE FALSE FALSE FALSE 90 1 1 FALSE FALSE FALSE EQUALS TRUE
#ASSERT `sev` `a significant acquired brain injury` 0 FALSE FALSE FALSE FALSE FALSE 90 1 1 FALSE FALSE FALSE EQUALS TRUE
-- s 3(1)(a): burns to 51% of the body, without disfigurement or full thickness: "more than 50%" is enough.
#ASSERT `sev` `none of these` 51 FALSE FALSE FALSE FALSE FALSE 90 1 1 FALSE FALSE FALSE EQUALS TRUE
#ASSERT `route` `none of these` 51 FALSE FALSE FALSE FALSE FALSE 90 1 1 FALSE FALSE FALSE EQUALS `s 3(1)(a) -- burns to more than 50% of the body`
-- 50% exactly is not "more than 50%": with nothing more, not severe.
#ASSERT `sev` `none of these` 50 FALSE FALSE FALSE FALSE FALSE 90 1 1 FALSE FALSE FALSE EQUALS FALSE
-- r 5(1)(b)(i): 50% ("not more than 50%"), severe disfigurement, full-thickness burns to the head etc.
#ASSERT `sev` `none of these` 50 TRUE TRUE FALSE FALSE FALSE 90 1 1 FALSE FALSE FALSE EQUALS TRUE
#ASSERT `route` `none of these` 50 TRUE TRUE FALSE FALSE FALSE 90 1 1 FALSE FALSE FALSE EQUALS `r 5(1)(b) -- full-thickness burns to not more than 50% of the body`
-- r 5(1)(b)(i) at 10%.
#ASSERT `sev` `none of these` 10 TRUE TRUE FALSE FALSE FALSE 90 1 1 FALSE FALSE FALSE EQUALS TRUE
-- r 5(1)(b)(ii): severe difficulties in all three of mobility, communication and self-care tasks.
#ASSERT `sev` `none of these` 30 TRUE FALSE TRUE TRUE TRUE 90 1 1 FALSE FALSE FALSE EQUALS TRUE
-- r 5(1)(b)(ii): two of the three only (fork line 3: all three read as needed).
#ASSERT `sev` `none of these` 30 TRUE FALSE TRUE TRUE FALSE 90 1 1 FALSE FALSE FALSE EQUALS FALSE
#ASSERT `sev` `none of these` 30 TRUE FALSE FALSE TRUE TRUE 90 1 1 FALSE FALSE FALSE EQUALS FALSE
-- r 5(1)(b): no severe disfigurement, so not severe even with full-thickness burns to the head.
#ASSERT `sev` `none of these` 30 FALSE TRUE TRUE TRUE TRUE 90 1 1 FALSE FALSE FALSE EQUALS FALSE
-- r 5(1)(b): disfigurement but neither (i) nor (ii).
#ASSERT `sev` `none of these` 30 TRUE FALSE FALSE FALSE FALSE 90 1 1 FALSE FALSE FALSE EQUALS FALSE
-- No burns at all (0%): r 5(1)(b) needs burns, whatever else is answered.
#ASSERT `sev` `none of these` 0 TRUE TRUE FALSE FALSE FALSE 90 1 1 FALSE FALSE FALSE EQUALS FALSE
-- r 5(2)(a): a field of 10 degrees in the better eye is "10 degrees or less", whatever the acuity.
#ASSERT `sev` `none of these` 0 FALSE FALSE FALSE FALSE FALSE 10 1 1 FALSE FALSE FALSE EQUALS TRUE
#ASSERT `route` `none of these` 0 FALSE FALSE FALSE FALSE FALSE 10 1 1 FALSE FALSE FALSE EQUALS `r 5(1)(a) -- an injury that results in permanent blindness`
-- 11 degrees is not.
#ASSERT `sev` `none of these` 0 FALSE FALSE FALSE FALSE FALSE 11 1 1 FALSE FALSE FALSE EQUALS FALSE
-- r 5(2)(b): 3/60 (0.05) in both eyes is less than 6/60.
#ASSERT `sev` `none of these` 0 FALSE FALSE FALSE FALSE FALSE 90 0.05 0.05 FALSE FALSE FALSE EQUALS TRUE
-- 6/60 (0.1) in both eyes is not "less than 6/60".
#ASSERT `sev` `none of these` 0 FALSE FALSE FALSE FALSE FALSE 90 0.1 0.1 FALSE FALSE FALSE EQUALS FALSE
-- Under 6/60 in one eye only: not "in both eyes".
#ASSERT `sev` `none of these` 0 FALSE FALSE FALSE FALSE FALSE 90 0.05 0.1 FALSE FALSE FALSE EQUALS FALSE
-- Just under 6/60 in the other eye too (0.099): both eyes.
#ASSERT `sev` `none of these` 0 FALSE FALSE FALSE FALSE FALSE 90 0.05 0.099 FALSE FALSE FALSE EQUALS TRUE
-- r 5(2)(c): a combination of defects assessed as the same degree of loss.
#ASSERT `sev` `none of these` 0 FALSE FALSE FALSE FALSE FALSE 90 1 1 TRUE FALSE FALSE EQUALS TRUE
-- r 5(1)(c): a brachial plexus injury that results in the loss of the use of a limb.
#ASSERT `sev` `none of these` 0 FALSE FALSE FALSE FALSE FALSE 90 1 1 FALSE TRUE TRUE EQUALS TRUE
#ASSERT `route` `none of these` 0 FALSE FALSE FALSE FALSE FALSE 90 1 1 FALSE TRUE TRUE EQUALS `r 5(1)(c) -- a brachial plexus injury that results in the loss of the use of a limb`
-- A brachial plexus injury without the loss of a limb's use; the loss of a limb's use without a brachial plexus injury.
#ASSERT `sev` `none of these` 0 FALSE FALSE FALSE FALSE FALSE 90 1 1 FALSE TRUE FALSE EQUALS FALSE
#ASSERT `sev` `none of these` 0 FALSE FALSE FALSE FALSE FALSE 90 1 1 FALSE FALSE TRUE EQUALS FALSE
-- Order of routes: paraplegia and blindness gives s 3(1)(a); blindness and qualifying burns of 40% gives r 5(1)(a).
#ASSERT `route` `paraplegia` 0 FALSE FALSE FALSE FALSE FALSE 5 1 1 FALSE FALSE FALSE EQUALS `s 3(1)(a) -- a brain injury, paraplegia, quadriplegia or an amputation`
#ASSERT `route` `none of these` 40 TRUE TRUE FALSE FALSE FALSE 5 1 1 FALSE FALSE FALSE EQUALS `r 5(1)(a) -- an injury that results in permanent blindness`
-- Burns of 60% and a brachial plexus injury: s 3(1)(a) burns comes first.
#ASSERT `route` `none of these` 60 FALSE FALSE FALSE FALSE FALSE 90 1 1 FALSE TRUE TRUE EQUALS `s 3(1)(a) -- burns to more than 50% of the body`

-- The permanent blindness question on its own (r 5(2)).
#ASSERT `Is my loss of sight permanent blindness` 10 1 1 FALSE EQUALS TRUE
#ASSERT `Is my loss of sight permanent blindness` 10.5 1 1 FALSE EQUALS FALSE
#ASSERT `Is my loss of sight permanent blindness` 0 0 0 FALSE EQUALS TRUE
#ASSERT `Is my loss of sight permanent blindness` 90 0.05 0.05 FALSE EQUALS TRUE
#ASSERT `Is my loss of sight permanent blindness` 90 0.1 0.05 FALSE EQUALS FALSE
#ASSERT `Is my loss of sight permanent blindness` 90 1 1 TRUE EQUALS TRUE
#ASSERT `Is my loss of sight permanent blindness` 90 1 1 FALSE EQUALS FALSE

§§ `Home and vehicle modification (s 60(3)-(5), r 11)`

-- Today (7 November 2026): $50 000 for the home (r 11), $10 000 for a vehicle (s 60(5); nothing prescribed for (3)).
#ASSERT `What is the most the Commission can pay for my modification without an agreement` `a payment or contribution for the home under s 60(4)` (`dt` 7 11 2026) EQUALS JUST 50000
#ASSERT `What is the most the Commission can pay for my modification without an agreement` `a payment or contribution for a motor vehicle under s 60(3)` (`dt` 7 11 2026) EQUALS JUST 10000
-- The first day of r 11 as substituted (23 October 2018), and the day before (the replaced r 11 is not deposited).
#ASSERT `What is the most the Commission can pay for my modification without an agreement` `a payment or contribution for the home under s 60(4)` (`dt` 23 10 2018) EQUALS JUST 50000
#ASSERT `What is the most the Commission can pay for my modification without an agreement` `a payment or contribution for the home under s 60(4)` (`dt` 22 10 2018) EQUALS NOTHING
#ASSERT `What is the most the Commission can pay for my modification without an agreement` `a payment or contribution for a motor vehicle under s 60(3)` (`dt` 22 10 2018) EQUALS NOTHING
-- The day before the sunset day in the endnotes (5 June 2027), and the sunset day (6 June 2027).
#ASSERT `What is the most the Commission can pay for my modification without an agreement` `a payment or contribution for the home under s 60(4)` (`dt` 5 6 2027) EQUALS JUST 50000
#ASSERT `What is the most the Commission can pay for my modification without an agreement` `a payment or contribution for the home under s 60(4)` (`dt` 6 6 2027) EQUALS NOTHING
-- An agreement is needed only for a payment that "exceeds" the amount: $50 000 for the home does not, $50 001 does.
#ASSERT `Must I enter into an agreement before the Commission pays for my modification` `a payment or contribution for the home under s 60(4)` 50000 (`dt` 7 11 2026) EQUALS JUST FALSE
#ASSERT `Must I enter into an agreement before the Commission pays for my modification` `a payment or contribution for the home under s 60(4)` 50001 (`dt` 7 11 2026) EQUALS JUST TRUE
#ASSERT `Must I enter into an agreement before the Commission pays for my modification` `a payment or contribution for the home under s 60(4)` 20000 (`dt` 7 11 2026) EQUALS JUST FALSE
-- A vehicle: $10 000 does not exceed, $10 001 does; $20 000 needs the agreement for a vehicle, not for a home.
#ASSERT `Must I enter into an agreement before the Commission pays for my modification` `a payment or contribution for a motor vehicle under s 60(3)` 10000 (`dt` 7 11 2026) EQUALS JUST FALSE
#ASSERT `Must I enter into an agreement before the Commission pays for my modification` `a payment or contribution for a motor vehicle under s 60(3)` 10001 (`dt` 7 11 2026) EQUALS JUST TRUE
#ASSERT `Must I enter into an agreement before the Commission pays for my modification` `a payment or contribution for a motor vehicle under s 60(3)` 20000 (`dt` 7 11 2026) EQUALS JUST TRUE
-- Before 23 October 2018: not known.
#ASSERT `Must I enter into an agreement before the Commission pays for my modification` `a payment or contribution for the home under s 60(4)` 60000 (`dt` 1 7 2018) EQUALS NOTHING

§§ `The prescribed forms (rr 7-9)`

#ASSERT `Which form must I use` `a statement of earnings under s 49(4), 50(4) or 51(5)` EQUALS `Form 1 -- statement of earnings by a loss of earning capacity beneficiary`
#ASSERT `Which form must I use` `a driver's report on the Commission's notice under s 64(1)` EQUALS `Form 2 -- driver's accident report`
#ASSERT `Which form must I use` `a report for a recreation vehicle on the Commission's notice under s 64(3)` EQUALS `Form 2 -- driver's accident report`
#ASSERT `Which form must I use` `a train or tram operator's or manager's report under s 64(2)` EQUALS `Form 3 -- transport authority accident report`
#ASSERT `Which form must I use` `a contract of insurance for a trailer under s 86` EQUALS `Form 4 -- contract of insurance`

§§ `The statement of earnings (ss 49(4), 50(4), 51(5), r 7)`

-- First payment 15 March 2024: first anniversary 15 March 2025; two months after, 15 May 2025.
#ASSERT `By what day must I give my statement of earnings` (`dt` 15 3 2024) 1 EQUALS `dt` 15 5 2025
#ASSERT `Is my statement of earnings given in time` (`dt` 15 3 2024) 1 (`dt` 15 5 2025) EQUALS TRUE
#ASSERT `Is my statement of earnings given in time` (`dt` 15 3 2024) 1 (`dt` 16 5 2025) EQUALS FALSE
-- On the anniversary itself: in time. The day before it: not given "after" the anniversary (fork line 6).
#ASSERT `Is my statement of earnings given in time` (`dt` 15 3 2024) 1 (`dt` 15 3 2025) EQUALS TRUE
#ASSERT `Is my statement of earnings given in time` (`dt` 15 3 2024) 1 (`dt` 14 3 2025) EQUALS FALSE
-- First payment 29 February 2024: first anniversary read as 28 February 2025; last day 28 April 2025.
#ASSERT `By what day must I give my statement of earnings` (`dt` 29 2 2024) 1 EQUALS `dt` 28 4 2025
#ASSERT `Is my statement of earnings given in time` (`dt` 29 2 2024) 1 (`dt` 29 4 2025) EQUALS FALSE
-- Its fourth anniversary is 29 February 2028; last day 29 April 2028.
#ASSERT `By what day must I give my statement of earnings` (`dt` 29 2 2024) 4 EQUALS `dt` 29 4 2028
-- First payment 31 December 2023: second anniversary 31 December 2025; two months after, the last day of February
-- 2026 (28th); fourth anniversary 31 December 2027, last day 29 February 2028 (a leap year).
#ASSERT `By what day must I give my statement of earnings` (`dt` 31 12 2023) 2 EQUALS `dt` 28 2 2026
#ASSERT `By what day must I give my statement of earnings` (`dt` 31 12 2023) 4 EQUALS `dt` 29 2 2028
#ASSERT `Is my statement of earnings given in time` (`dt` 31 12 2023) 2 (`dt` 1 3 2026) EQUALS FALSE
-- First payment 30 June 2024: first anniversary 30 June 2025; last day 30 August 2025.
#ASSERT `By what day must I give my statement of earnings` (`dt` 30 6 2024) 1 EQUALS `dt` 30 8 2025

§§ `Accident reports (s 64, r 8)`

-- s 64(1): a motor vehicle that is not a recreation vehicle, someone injured: the driver must report; the owner not.
#ASSERT `Am I the one who must report the accident if the Commission asks` FALSE TRUE `the driver` 40 50 EQUALS TRUE
#ASSERT `Am I the one who must report the accident if the Commission asks` FALSE TRUE `the owner` 40 50 EQUALS FALSE
-- s 64(1)(a): nobody was or may have been injured or killed: the section does not reach the driver (fork line 7).
#ASSERT `Am I the one who must report the accident if the Commission asks` FALSE FALSE `the driver` 40 50 EQUALS FALSE
-- s 64(3)(c): a recreation vehicle, the driver 15: the driver; the owner not.
#ASSERT `Am I the one who must report the accident if the Commission asks` TRUE TRUE `the driver` 15 50 EQUALS TRUE
#ASSERT `Am I the one who must report the accident if the Commission asks` TRUE TRUE `the owner` 15 50 EQUALS FALSE
-- s 64(3)(d): the driver 14, the owner 40: the owner; the driver not.
#ASSERT `Am I the one who must report the accident if the Commission asks` TRUE TRUE `the owner` 14 40 EQUALS TRUE
#ASSERT `Am I the one who must report the accident if the Commission asks` TRUE TRUE `the driver` 14 40 EQUALS FALSE
-- s 64(3)(d): the driver 14, the owner 14: the owner's parent or guardian; the owner not.
#ASSERT `Am I the one who must report the accident if the Commission asks` TRUE TRUE `the parent or guardian of the owner` 14 14 EQUALS TRUE
#ASSERT `Am I the one who must report the accident if the Commission asks` TRUE TRUE `the owner` 14 14 EQUALS FALSE
-- s 64(3)(d): the driver 14, the owner 15: the owner, not the parent.
#ASSERT `Am I the one who must report the accident if the Commission asks` TRUE TRUE `the parent or guardian of the owner` 14 15 EQUALS FALSE
-- 28 days of receiving the notice: 10 January 2026 gives 7 February 2026; 15 February 2024 gives 14 March 2024
-- (a leap February: 14 days to 29 February, 14 more); 20 December 2025 gives 17 January 2026.
#ASSERT `By what day must I make my accident report` (`dt` 10 1 2026) EQUALS `dt` 7 2 2026
#ASSERT `By what day must I make my accident report` (`dt` 15 2 2024) EQUALS `dt` 14 3 2024
#ASSERT `By what day must I make my accident report` (`dt` 20 12 2025) EQUALS `dt` 17 1 2026

§§ `The trailer contract (s 86, rr 9, 10, Form 4)`

-- r 9 and r 10: in Form 4; or a 2007 contract that complied with the 2007 form; neither.
#ASSERT `Is my trailer insurance contract in the prescribed form` TRUE FALSE EQUALS TRUE
#ASSERT `Is my trailer insurance contract in the prescribed form` FALSE TRUE EQUALS TRUE
#ASSERT `Is my trailer insurance contract in the prescribed form` FALSE FALSE EQUALS FALSE

-- Form 4 cl 2, 3(1). Arguments: owner or in charge, death or injury from use in Australia, in the period, workers'
-- compensation, only under another agreement, registered under the Interstate Road Transport Act 1985.
#ASSERT `Does my trailer insurance cover me for this liability` TRUE TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE
-- Outside the grant of cl 2(1): not owner or in charge; not a death or injury from the trailer's use in Australia.
#ASSERT `Does my trailer insurance cover me for this liability` FALSE TRUE TRUE FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `Does my trailer insurance cover me for this liability` TRUE FALSE TRUE FALSE FALSE TRUE EQUALS NOTHING
-- Outside the period of cl 2(2)(b).
#ASSERT `Does my trailer insurance cover me for this liability` TRUE TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
-- cl 3(1)(a), (b), (c).
#ASSERT `Does my trailer insurance cover me for this liability` TRUE TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Does my trailer insurance cover me for this liability` TRUE TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Does my trailer insurance cover me for this liability` TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- Outside the grant and the period: the grant decides first.
#ASSERT `Does my trailer insurance cover me for this liability` FALSE TRUE FALSE FALSE FALSE TRUE EQUALS NOTHING

-- cl 3(2): no other contract: the whole $100 000; another contract covering the owner, a half share: $50 000;
-- a third of $90 000: $30 000.
#ASSERT `What is the most the Commission is liable for under my trailer insurance` 100000 FALSE 0.5 EQUALS 100000
#ASSERT `What is the most the Commission is liable for under my trailer insurance` 100000 TRUE 0.5 EQUALS 50000
#ASSERT `What is the most the Commission is liable for under my trailer insurance` 90000 TRUE (1 DIVIDED BY 3) EQUALS 30000

§§ `Duties with deadlines`

-- r 7: 61 days from the anniversary of 15 March 2025 to 15 May 2025 (16 + 30 + 15). Given on day 61: fulfilled;
-- nothing by day 62: breached.
#ASSERT EVALTRACE (`r 7 -- the statement of earnings in Form 1 within two months after each anniversary` 61) 0 (LIST (EVENT `the person receiving weekly payments` `give the statement of earnings in Form 1` 61)) EQUALS FULFILLED
#ASSERT NOT (`ends fulfilled` (EVALTRACE (`r 7 -- the statement of earnings in Form 1 within two months after each anniversary` 61) 0 (LIST (WAITUNTIL 62))))
-- r 8(1): the report in Form 2 on day 28: fulfilled; nothing by day 29: breached.
#ASSERT EVALTRACE `r 8(1) -- the report in Form 2 within 28 days of receiving the notice` 0 (LIST (EVENT `the person asked to report` `make the report in Form 2` 28)) EQUALS FULFILLED
#ASSERT NOT (`ends fulfilled` (EVALTRACE `r 8(1) -- the report in Form 2 within 28 days of receiving the notice` 0 (LIST (WAITUNTIL 29))))
