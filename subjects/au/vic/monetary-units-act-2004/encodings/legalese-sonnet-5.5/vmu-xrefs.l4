IMPORT prelude
IMPORT `vmu-provisions`

-- Every reference in sections 1 to 12 of the text from one provision to another provision of the same text,
-- one row per cited provision, found by a script that reads the text file (lines 22 to 135).
-- A citation of several provisions ("sections 5 and 6") gives one row for each, with the words as printed.
-- A subsection, paragraph or subparagraph has no heading of its own, so its row carries the heading of its section.
-- A reference to another Act is a row of its own kind further down; it is not resolved here.

DECLARE `Cross-reference` HAS
    `citing provision` IS A STRING
    `line of the citation in the text file` IS A NUMBER
    `words as printed` IS A STRING
    `cited identifier` IS A STRING
    `heading of the cited provision` IS A STRING

DECLARE `Reference to another instrument` HAS
    `citing provision` IS A STRING
    `line of the citation in the text file` IS A NUMBER
    `words as printed` IS A STRING
    `instrument as printed` IS A STRING
    `provision as printed` IS A STRING

-- Ruler: citing provision, line in the text file, words as printed, cited identifier, heading of the cited provision.
`xref 001` MEANS `Cross-reference` OF "s 2(1)", 37, "This section", "s 2", "Commencement"
`xref 002` MEANS `Cross-reference` OF "s 2(1)", 37, "sections 1, 3, 9, 11 and 12", "s 1", "Purposes"
`xref 003` MEANS `Cross-reference` OF "s 2(1)", 37, "sections 1, 3, 9, 11 and 12", "s 3", "Definitions"
`xref 004` MEANS `Cross-reference` OF "s 2(1)", 37, "sections 1, 3, 9, 11 and 12", "s 9", "Regulations"
`xref 005` MEANS `Cross-reference` OF "s 2(1)", 37, "sections 1, 3, 9, 11 and 12", "s 11", "Provisions for 2012–2013"
`xref 006` MEANS `Cross-reference` OF "s 2(1)", 37, "sections 1, 3, 9, 11 and 12", "s 12", "Subordinate Legislation Act 1994"
`xref 007` MEANS `Cross-reference` OF "s 4", 53, "section 5(3)", "s 5(3)", "Calculation of value of fee and penalty units"
`xref 008` MEANS `Cross-reference` OF "s 5(3)", 58, "subsections (1) and (2)", "s 5(1)", "Calculation of value of fee and penalty units"
`xref 009` MEANS `Cross-reference` OF "s 5(3)", 58, "subsections (1) and (2)", "s 5(2)", "Calculation of value of fee and penalty units"
`xref 010` MEANS `Cross-reference` OF "s 5(5)", 60, "subsection (4)", "s 5(4)", "Calculation of value of fee and penalty units"
`xref 011` MEANS `Cross-reference` OF "s 5(8)", 64, "subsection (4)", "s 5(4)", "Calculation of value of fee and penalty units"
`xref 012` MEANS `Cross-reference` OF "s 7(1)", 73, "section 5", "s 5", "Calculation of value of fee and penalty units"
`xref 013` MEANS `Cross-reference` OF "s 7(2)", 74, "section 5", "s 5", "Calculation of value of fee and penalty units"
`xref 014` MEANS `Cross-reference` OF "s 7(3)", 75, "this section", "s 7", "Calculation of a fee or penalty"
`xref 015` MEANS `Cross-reference` OF "s 7(4)", 76, "this section", "s 7", "Calculation of a fee or penalty"
`xref 016` MEANS `Cross-reference` OF "s 9(2)", 94, "this section", "s 9", "Regulations"
`xref 017` MEANS `Cross-reference` OF "s 9(2)(a)", 95, "subsection (1)(a)", "s 9(1)(a)", "Regulations"
