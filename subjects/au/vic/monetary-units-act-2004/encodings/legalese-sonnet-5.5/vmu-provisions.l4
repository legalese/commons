IMPORT prelude

-- The provision index of Monetary Units Act 2004 (Victoria), sections 1 to 12, as the text file prints it.
-- Generated by a script that reads the text file (lines 22 to 135): one entry per section, subsection,
-- paragraph, subparagraph and defined term, with its identifier as printed and the heading of its section.
-- A subsection, paragraph or subparagraph has no heading of its own, so it carries the heading of its section.

DECLARE Provision HAS
    `identifier as printed` IS A STRING
    `kind` IS A STRING
    `heading as printed` IS A STRING
    `first line in the text file` IS A NUMBER

-- Ruler: identifier, kind, heading, first line in the text file.
`the provision index` MEANS
    LIST (Provision OF "s 1", "section", "Purposes", 22)
       , (Provision OF "s 1(a)", "paragraph", "Purposes", 24)
       , (Provision OF "s 1(b)", "paragraph", "Purposes", 25)
       , (Provision OF "s 1(c)", "paragraph", "Purposes", 26)
       , (Provision OF "s 1(d)", "paragraph", "Purposes", 27)
       , (Provision OF "s 1(d)(i)", "subparagraph", "Purposes", 28)
       , (Provision OF "s 1(d)(ii)", "subparagraph", "Purposes", 29)
       , (Provision OF "s 1(d)(iii)", "subparagraph", "Purposes", 30)
       , (Provision OF "s 1(d)(iv)", "subparagraph", "Purposes", 31)
       , (Provision OF "s 1(d)(v)", "subparagraph", "Purposes", 32)
       , (Provision OF "s 1(e)", "paragraph", "Purposes", 33)
       , (Provision OF "s 1(f)", "paragraph", "Purposes", 34)
       , (Provision OF "s 2", "section", "Commencement", 36)
       , (Provision OF "s 2(1)", "subsection", "Commencement", 37)
       , (Provision OF "s 2(2)", "subsection", "Commencement", 38)
       , (Provision OF "s 3", "section", "Definitions", 40)
       , (Provision OF "s 3 'fee'", "definition", "Definitions", 42)
       , (Provision OF "s 3 'instrument maker'", "definition", "Definitions", 44)
       , (Provision OF "s 3 'legislative instrument'", "definition", "Definitions", 46)
       , (Provision OF "s 3 'penalty'", "definition", "Definitions", 47)
       , (Provision OF "s 3 'penalty unit'", "definition", "Definitions", 48)
       , (Provision OF "s 3 'statutory rule'", "definition", "Definitions", 49)
       , (Provision OF "s 4", "section", "Meaning of fee unit", 52)
       , (Provision OF "s 5", "section", "Calculation of value of fee and penalty units", 55)
       , (Provision OF "s 5(1)", "subsection", "Calculation of value of fee and penalty units", 56)
       , (Provision OF "s 5(2)", "subsection", "Calculation of value of fee and penalty units", 57)
       , (Provision OF "s 5(3)", "subsection", "Calculation of value of fee and penalty units", 58)
       , (Provision OF "s 5(4)", "subsection", "Calculation of value of fee and penalty units", 59)
       , (Provision OF "s 5(5)", "subsection", "Calculation of value of fee and penalty units", 60)
       , (Provision OF "s 5(6)", "subsection", "Calculation of value of fee and penalty units", 61)
       , (Provision OF "s 5(7)", "subsection", "Calculation of value of fee and penalty units", 62)
       , (Provision OF "s 5(8)", "subsection", "Calculation of value of fee and penalty units", 64)
       , (Provision OF "s 6", "section", "Notification of values of fee and penalty units", 66)
       , (Provision OF "s 6(a)", "paragraph", "Notification of values of fee and penalty units", 68)
       , (Provision OF "s 6(b)", "paragraph", "Notification of values of fee and penalty units", 69)
       , (Provision OF "s 7", "section", "Calculation of a fee or penalty", 71)
       , (Provision OF "s 7(1)", "subsection", "Calculation of a fee or penalty", 73)
       , (Provision OF "s 7(2)", "subsection", "Calculation of a fee or penalty", 74)
       , (Provision OF "s 7(3)", "subsection", "Calculation of a fee or penalty", 75)
       , (Provision OF "s 7(4)", "subsection", "Calculation of a fee or penalty", 76)
       , (Provision OF "s 8", "section", "Certain monetary amounts to be construed in fee units or penalty units", 78)
       , (Provision OF "s 8(1)", "subsection", "Certain monetary amounts to be construed in fee units or penalty units", 80)
       , (Provision OF "s 8(1A)", "subsection", "Certain monetary amounts to be construed in fee units or penalty units", 82)
       , (Provision OF "s 8(2)", "subsection", "Certain monetary amounts to be construed in fee units or penalty units", 83)
       , (Provision OF "s 9", "section", "Regulations", 85)
       , (Provision OF "s 9(1)", "subsection", "Regulations", 86)
       , (Provision OF "s 9(1)(a)", "paragraph", "Regulations", 87)
       , (Provision OF "s 9(1)(b)", "paragraph", "Regulations", 88)
       , (Provision OF "s 9(1)(c)", "paragraph", "Regulations", 89)
       , (Provision OF "s 9(1)(d)", "paragraph", "Regulations", 90)
       , (Provision OF "s 9(1)(e)", "paragraph", "Regulations", 91)
       , (Provision OF "s 9(1)(f)", "paragraph", "Regulations", 92)
       , (Provision OF "s 9(1)(g)", "paragraph", "Regulations", 93)
       , (Provision OF "s 9(2)", "subsection", "Regulations", 94)
       , (Provision OF "s 9(2)(a)", "paragraph", "Regulations", 95)
       , (Provision OF "s 9(2)(a)(i)", "subparagraph", "Regulations", 96)
       , (Provision OF "s 9(2)(a)(ii)", "subparagraph", "Regulations", 97)
       , (Provision OF "s 9(2)(b)", "paragraph", "Regulations", 98)
       , (Provision OF "s 9(2)(b)(i)", "subparagraph", "Regulations", 99)
       , (Provision OF "s 9(2)(b)(ii)", "subparagraph", "Regulations", 100)
       , (Provision OF "s 9(2)(c)", "paragraph", "Regulations", 101)
       , (Provision OF "s 9(2)(d)", "paragraph", "Regulations", 102)
       , (Provision OF "s 9(2)(e)", "paragraph", "Regulations", 103)
       , (Provision OF "s 9(2)(f)", "paragraph", "Regulations", 104)
       , (Provision OF "s 9(2)(g)", "paragraph", "Regulations", 105)
       , (Provision OF "s 9(2)(h)", "paragraph", "Regulations", 106)
       , (Provision OF "s 9(3)", "subsection", "Regulations", 107)
       , (Provision OF "s 9(4)", "subsection", "Regulations", 108)
       , (Provision OF "s 9(5)", "subsection", "Regulations", 109)
       , (Provision OF "s 10", "section", "Notification of fees and penalties", 112)
       , (Provision OF "s 10(1)", "subsection", "Notification of fees and penalties", 113)
       , (Provision OF "s 10(2)", "subsection", "Notification of fees and penalties", 115)
       , (Provision OF "s 11", "section", "Provisions for 2012–2013", 118)
       , (Provision OF "s 11(1)", "subsection", "Provisions for 2012–2013", 119)
       , (Provision OF "s 11(1)(a)", "paragraph", "Provisions for 2012–2013", 120)
       , (Provision OF "s 11(1)(b)", "paragraph", "Provisions for 2012–2013", 121)
       , (Provision OF "s 11(2)", "subsection", "Provisions for 2012–2013", 122)
       , (Provision OF "s 11(3)", "subsection", "Provisions for 2012–2013", 123)
       , (Provision OF "s 11(4)", "subsection", "Provisions for 2012–2013", 124)
       , (Provision OF "s 12", "section", "Subordinate Legislation Act 1994", 126)
       , (Provision OF "s 12(a)", "paragraph", "Subordinate Legislation Act 1994", 128)
       , (Provision OF "s 12(b)", "paragraph", "Subordinate Legislation Act 1994", 129)

GIVEN identifier IS A STRING
GIVETH A MAYBE Provision
`the provision with the identifier` MEANS
    CONSIDER filter `has the identifier` `the provision index`
    WHEN EMPTY THEN NOTHING
    WHEN first FOLLOWED BY rest THEN JUST first
    WHERE
        `has the identifier` p MEANS p's `identifier as printed` EQUALS identifier

GIVEN identifier IS A STRING
GIVETH A BOOLEAN
`the identifier is in the index` MEANS
    CONSIDER `the provision with the identifier` identifier
    WHEN NOTHING THEN FALSE
    WHEN JUST p THEN TRUE

GIVEN identifier IS A STRING
GIVETH A MAYBE STRING
`the heading of the provision with the identifier` MEANS
    CONSIDER `the provision with the identifier` identifier
    WHEN NOTHING THEN NOTHING
    WHEN JUST p THEN JUST (p's `heading as printed`)
