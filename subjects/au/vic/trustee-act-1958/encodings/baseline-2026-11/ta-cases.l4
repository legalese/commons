#ASSERT `May my trustee sell at my written request` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `May my trustee sell at my written request` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `May my trustee sell at my written request` FALSE FALSE TRUE EQUALS JUST FALSE

