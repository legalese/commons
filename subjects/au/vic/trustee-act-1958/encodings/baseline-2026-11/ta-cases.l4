#ASSERT `May my trustee leave part of the price on mortgage` 500000 300000 TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `May my trustee leave part of the price on mortgage` 500000 300001 TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `May my trustee leave part of the price on mortgage` 500000 100000 FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `May my trustee leave part of the price on mortgage` 500000 100000 TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `May my trustee leave part of the price on mortgage` 500000 100000 TRUE TRUE TRUE EQUALS JUST TRUE

-- s 17(3). Price $400,000: one-tenth is $40,000. Arguments: price, deposit, prudent deposit, interest months, years,
-- arrears months, maintain and insure.
#ASSERT `Do the deferred payment terms meet the minimums` 400000 40000 30000 6 10 6 TRUE
#ASSERT (NOT (`Do the deferred payment terms meet the minimums` 400000 39999 30000 6 10 6 TRUE))
#ASSERT (NOT (`Do the deferred payment terms meet the minimums` 400000 40000 50000 6 10 6 TRUE))
#ASSERT (NOT (`Do the deferred payment terms meet the minimums` 400000 60000 50000 12 10 6 TRUE))
#ASSERT (NOT (`Do the deferred payment terms meet the minimums` 400000 60000 50000 6 11 6 TRUE))
#ASSERT (NOT (`Do the deferred payment terms meet the minimums` 400000 60000 50000 6 10 7 TRUE))
#ASSERT (NOT (`Do the deferred payment terms meet the minimums` 400000 60000 50000 6 10 3 FALSE))
#ASSERT `Do the deferred payment terms meet the minimums` 400000 60000 50000 3 5 3 TRUE

-- s 17(4). Price $400,000: two-fifths is $160,000.
#ASSERT `May my trustee transfer the land and take a mortgage back` 400000 160000 EQUALS JUST TRUE
#ASSERT `May my trustee transfer the land and take a mortgage back` 400000 159999 EQUALS JUST FALSE

-- s 23. Insurable value $600,000; $400,000 already on foot.
#ASSERT `May my trustee insure for this amount` 200000 400000 600000 TRUE EQUALS JUST TRUE
#ASSERT `May my trustee insure for this amount` 200001 400000 600000 TRUE EQUALS JUST FALSE
#ASSERT `May my trustee insure for this amount` 1000 0 600000 FALSE EQUALS NOTHING

§§ `ss 28, 36 -- who answers for a loss`

#ASSERT `Is my trustee shielded from this loss` `my trustee's own act, receipt, neglect or default` FALSE TRUE EQUALS JUST FALSE
#ASSERT `Is my trustee shielded from this loss` `another trustee's act, receipt, neglect or default` FALSE TRUE EQUALS JUST TRUE
#ASSERT `Is my trustee shielded from this loss` `another trustee's act, receipt, neglect or default` TRUE TRUE EQUALS JUST FALSE
#ASSERT `Is my trustee shielded from this loss` `a banker, broker or other person with whom trust money or securities were deposited` FALSE TRUE EQUALS JUST TRUE
#ASSERT `Is my trustee shielded from this loss` `an agent my trustee employed` FALSE TRUE EQUALS JUST TRUE
#ASSERT `Is my trustee shielded from this loss` `an agent my trustee employed` FALSE FALSE EQUALS JUST FALSE
#ASSERT `Is my trustee shielded from this loss` `the insufficiency or deficiency of securities` FALSE TRUE EQUALS JUST TRUE
#ASSERT `Is my trustee shielded from this loss` `money or securities my trustee signed a receipt for only for conformity and did not receive` FALSE TRUE EQUALS JUST TRUE
#ASSERT `Is my trustee shielded from this loss` `some other cause` TRUE TRUE EQUALS JUST FALSE

