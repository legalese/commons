#ASSERT `Can I challenge the sale for depreciatory conditions` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Can I challenge the sale for depreciatory conditions` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Can I challenge the sale for depreciatory conditions` TRUE TRUE TRUE TRUE EQUALS JUST TRUE

