IMPORT prelude
IMPORT `ta-dates`
IMPORT `ta-rules`
IMPORT `ta-seat`

-- Trustee Act 1958 (Vic) -- worked cases for the beneficiary's questions (ta-seat.l4) and the date helpers
-- (ta-dates.l4). Every expected value was worked by hand from the deposited text; none was copied from the encoding's
-- output. Each assertion is a claim about the ENCODING on stated facts, not about the law. The facts are illustrative:
-- most are a child's compensation or damages held on trust until the child turns 18.
-- BASELINE ENCODING. Not for public use as advice. See NOTES.md.

§ `cases`

`d` MEANS `the calendar date`

§§ `Dates`

-- Two months after 31 December 2026 is 28 February 2027 (no 31st: the last day, fork F1); twelve months after 29 February
-- 2028 is 28 February 2029; months roll over the year.
#ASSERT `the date` 2 `months after` (`d` 31 12 2026) EQUALS `d` 28 2 2027
#ASSERT `the date` 12 `months after` (`d` 29 2 2028) EQUALS `d` 28 2 2029
#ASSERT `the date` 2 `months after` (`d` 15 11 2026) EQUALS `d` 15 1 2027
#ASSERT `the date` 1 `months after` (`d` 15 1 2027) EQUALS `d` 15 2 2027
#ASSERT `the days from` (`d` 1 2 2027) `to` (`d` 1 3 2027) EQUALS 28
-- Born 10 May 2009: 18 on 10 May 2027; not on 9 May 2027. Born 29 February 2008: 18 on 28 February 2026 (fork F1).
#ASSERT `a person born on` (`d` 10 5 2009) `has attained` 18 `by` (`d` 10 5 2027)
#ASSERT (NOT (`a person born on` (`d` 10 5 2009) `has attained` 18 `by` (`d` 9 5 2027)))
#ASSERT `a person born on` (`d` 29 2 2008) `has attained` 18 `by` (`d` 28 2 2026)
#ASSERT (NOT (`a person born on` (`d` 29 2 2008) `has attained` 18 `by` (`d` 27 2 2026)))

§§ `s 3 -- which court`

#ASSERT `Which court can deal with my trust` TRUE EQUALS `the Supreme Court or the County Court`
#ASSERT `Which court can deal with my trust` FALSE EQUALS `the Supreme Court only`

§§ `ss 5, 6, 8, 11 -- investing`

#ASSERT `May my trustee make this investment` FALSE EQUALS JUST TRUE
#ASSERT `May my trustee make this investment` TRUE EQUALS JUST FALSE

-- s 6(1): a trustee company (professional) / a parent as trustee (not) / an instrument with its own standard.
#ASSERT `What standard must my trustee meet when investing` TRUE FALSE EQUALS JUST `that of a prudent person engaged in the profession, business or employment of acting as a trustee or investing for others`
#ASSERT `What standard must my trustee meet when investing` FALSE FALSE EQUALS JUST `that of a prudent person managing the affairs of other persons`
#ASSERT `What standard must my trustee meet when investing` FALSE TRUE EQUALS NOTHING

#ASSERT `Must my trustee get consent before investing` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Must my trustee get consent before investing` TRUE FALSE EQUALS NOTHING
#ASSERT `Must my trustee get consent before investing` FALSE FALSE EQUALS NOTHING

#ASSERT `Must my trustee consider this matter when investing` `(b) the desirability of diversifying trust investments` TRUE EQUALS JUST TRUE
#ASSERT `Must my trustee consider this matter when investing` `(l) the effect of the proposed investment on the tax liability of the trust` FALSE EQUALS NOTHING

-- ss 7(4), 8(2). Arguments: duty, independent, required, believed competent, reasonable costs.
#ASSERT `Can the cost of investment advice come out of my trust` FALSE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Can the cost of investment advice come out of my trust` TRUE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Can the cost of investment advice come out of my trust` FALSE FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `Can the cost of investment advice come out of my trust` TRUE TRUE TRUE TRUE FALSE EQUALS NOTHING

-- s 11. Arguments: arrangement, instrument forbids, unfair prejudice.
#ASSERT `May my trustee provide a home for me` `buying a dwelling house for me to live in` FALSE TRUE EQUALS JUST TRUE
#ASSERT `May my trustee provide a home for me` `buying a dwelling house for me to live in` TRUE FALSE EQUALS JUST FALSE
#ASSERT `May my trustee provide a home for me` `another arrangement giving me a right to live in a dwelling house` TRUE FALSE EQUALS JUST FALSE
#ASSERT `May my trustee provide a home for me` `keeping a dwelling house the trust already holds, for me to live in` TRUE FALSE EQUALS JUST TRUE
#ASSERT `May my trustee provide a home for me` `keeping a dwelling house the trust already holds, for me to live in` FALSE TRUE EQUALS JUST FALSE

§§ `s 6(3) -- the yearly review (regulative)`

-- Last review 1 July 2026; the year runs to 1 July 2027 (365 days). Reviewed 1 July 2027: in time (the anniversary);
-- 2 July 2027: late. Not reviewed: still open on 1 July 2027, late on 2 July 2027. Instrument otherwise: NOTHING.
#ASSERT `Has my trustee reviewed the investments in time` (`d` 1 7 2026) TRUE (`d` 15 3 2027) (`d` 1 8 2027) FALSE EQUALS JUST `done in time`
#ASSERT `Has my trustee reviewed the investments in time` (`d` 1 7 2026) TRUE (`d` 1 7 2027) (`d` 1 8 2027) FALSE EQUALS JUST `done in time`
#ASSERT `Has my trustee reviewed the investments in time` (`d` 1 7 2026) TRUE (`d` 2 7 2027) (`d` 1 8 2027) FALSE EQUALS JUST `not done in time`
#ASSERT `Has my trustee reviewed the investments in time` (`d` 1 7 2026) FALSE (`d` 1 7 2026) (`d` 1 7 2027) FALSE EQUALS JUST `still open`
#ASSERT `Has my trustee reviewed the investments in time` (`d` 1 7 2026) FALSE (`d` 1 7 2026) (`d` 2 7 2027) FALSE EQUALS JUST `not done in time`
#ASSERT `Has my trustee reviewed the investments in time` (`d` 1 7 2026) FALSE (`d` 1 7 2026) (`d` 2 7 2027) TRUE EQUALS NOTHING
-- Across 29 February 2028: last review 1 March 2027, the year ends 1 March 2028 (366 days); 1 March 2028 in time.
#ASSERT `Has my trustee reviewed the investments in time` (`d` 1 3 2027) TRUE (`d` 1 3 2028) (`d` 1 4 2028) FALSE EQUALS JUST `done in time`
#ASSERT `Has my trustee reviewed the investments in time` (`d` 1 3 2027) TRUE (`d` 2 3 2028) (`d` 1 4 2028) FALSE EQUALS JUST `not done in time`

§§ `ss 12, 12A, 12B, 12D, 12E -- liability for investments`

#ASSERT `Is my trustee liable just for keeping the investment` TRUE TRUE EQUALS JUST FALSE
#ASSERT `Is my trustee liable just for keeping the investment` TRUE FALSE EQUALS NOTHING

-- s 12A. Report value $300,000: two-thirds is $200,000. $200,000 protected; $200,001 not; a report not relied on, not.
#ASSERT `Is my trustee protected for the amount lent on a valuation` 200000 300000 TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Is my trustee protected for the amount lent on a valuation` 200001 300000 TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Is my trustee protected for the amount lent on a valuation` 150000 300000 TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Is my trustee protected for the amount lent on a valuation` 150000 300000 TRUE TRUE TRUE FALSE EQUALS JUST FALSE

-- s 12B. Advanced $250,000; proper for $200,000; interest $4,000: $54,000. Not smaller: NOTHING.
#ASSERT `How much must my trustee make good for advancing too much` 250000 200000 4000 EQUALS JUST 54000
#ASSERT `How much must my trustee make good for advancing too much` 200000 200000 0 EQUALS NOTHING

#ASSERT `Can the Court set gains off against the loss` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Can the Court set gains off against the loss` TRUE FALSE EQUALS JUST FALSE

-- s 12E. Arguments: forbidden, purpose, secured, insured.
#ASSERT `Is my trustee protected for an insured home loan` FALSE `(iii) to acquire a prescribed interest in land with a dwelling-house on it` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Is my trustee protected for an insured home loan` TRUE `(iii) to acquire a prescribed interest in land with a dwelling-house on it` TRUE TRUE EQUALS JUST FALSE
#ASSERT `Is my trustee protected for an insured home loan` FALSE `none of these purposes` TRUE TRUE EQUALS JUST FALSE
#ASSERT `Is my trustee protected for an insured home loan` FALSE `(ii) to build or finish a dwelling-house on land the borrower has a prescribed interest in` FALSE TRUE EQUALS JUST FALSE
#ASSERT `Is my trustee protected for an insured home loan` FALSE `(iv) to alter, improve or extend a dwelling-house on land the borrower has a prescribed interest in` TRUE FALSE EQUALS JUST FALSE

