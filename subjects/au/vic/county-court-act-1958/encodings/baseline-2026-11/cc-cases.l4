#ASSERT `Can I take my judgment to the Supreme Court` TRUE FALSE FALSE TRUE EQUALS JUST FALSE

#ASSERT `Can my employer be dealt with for prejudicing me` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Can my employer be dealt with for prejudicing me` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `Can my employer be dealt with for prejudicing me` FALSE TRUE TRUE EQUALS NOTHING

§§ `ss 17V, 47, 74, 75 -- where an appeal goes`

-- Arguments: who decided, agreed final, only value or place, Rules provide.
#ASSERT `Where can I appeal` `a judge` FALSE FALSE TRUE EQUALS `to the Court of Appeal, with the Court of Appeal's leave (s 74(1))`
#ASSERT `Where can I appeal` `an associate judge` FALSE FALSE TRUE EQUALS `to the Trial Division of the Supreme Court, with leave of the associate judge or of the Trial Division (s 75)`
#ASSERT `Where can I appeal` `a judicial registrar` FALSE FALSE TRUE EQUALS `an appeal or review as the County Court Rules provide (s 17V(1), (3))`
#ASSERT `Where can I appeal` `a judicial registrar` FALSE FALSE FALSE EQUALS `a hearing de novo by a judge of the County Court (s 17V(4))`
#ASSERT `Where can I appeal` `the Court acting as arbitrator by the parties' written agreement (s 47)` FALSE FALSE TRUE EQUALS `no appeal or question in any court (s 47)`
#ASSERT `Where can I appeal` `the Court acting as arbitrator by the parties' written agreement (s 47)` TRUE TRUE TRUE EQUALS `no appeal or question in any court (s 47)`
#ASSERT `Where can I appeal` `a judge` TRUE FALSE TRUE EQUALS `no appeal: the parties agreed in writing before it was pronounced that it would be final (s 74(7))`
#ASSERT `Where can I appeal` `an associate judge` TRUE FALSE TRUE EQUALS `no appeal: the parties agreed in writing before it was pronounced that it would be final (s 74(7))`
#ASSERT `Where can I appeal` `a judge` FALSE TRUE TRUE EQUALS `no appeal on that ground (s 74(6))`
#ASSERT `Where can I appeal` `a judge` TRUE TRUE TRUE EQUALS `no appeal: the parties agreed in writing before it was pronounced that it would be final (s 74(7))`

§§ `s 72 -- a jury on the Supreme Court re-hearing`

#ASSERT `Am I entitled to a jury on the re-hearing` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Am I entitled to a jury on the re-hearing` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Am I entitled to a jury on the re-hearing` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Am I entitled to a jury on the re-hearing` FALSE TRUE TRUE EQUALS NOTHING

-- The s 72(3) rule itself: notice of trial received at day 0; the fourth day after is the last (day 4).
#ASSERT `the defendant's notice is in time at day` 0
#ASSERT `the defendant's notice is in time at day` 4
#ASSERT NOT (`the defendant's notice is in time at day` 5)

-- Arguments: re-hearing directed, tried with jury, Court of Appeal ordered, side, notice of trial given, notice of trial day,
-- jury notice given, jury notice day, fees paid, today.
-- Defendant: notice of trial received 10 March 2027; the last day is 14 March 2027.
#ASSERT `Is my jury notice for the re-hearing in time` TRUE TRUE FALSE `the defendant side` TRUE (`d` 10 3 2027) TRUE (`d` 14 3 2027) TRUE (`d` 20 3 2027) EQUALS `the jury notice is in time and the jury fees are paid: a jury of six (s 72)`
#ASSERT `Is my jury notice for the re-hearing in time` TRUE TRUE FALSE `the defendant side` TRUE (`d` 10 3 2027) TRUE (`d` 15 3 2027) TRUE (`d` 20 3 2027) EQUALS `too late: the notice was not given in time (s 72(2), (3))`
#ASSERT `Is my jury notice for the re-hearing in time` TRUE TRUE FALSE `the defendant side` TRUE (`d` 10 3 2027) TRUE (`d` 10 3 2027) FALSE (`d` 11 3 2027) EQUALS `the jury notice is in time, but the jury fees are still to be paid (s 72(2), (3))`
#ASSERT `Is my jury notice for the re-hearing in time` TRUE TRUE FALSE `the defendant side` TRUE (`d` 10 3 2027) FALSE (`d` 1 1 2027) FALSE (`d` 14 3 2027) EQUALS `still open: the notice can still be given in time (s 72(2), (3))`
#ASSERT `Is my jury notice for the re-hearing in time` TRUE TRUE FALSE `the defendant side` TRUE (`d` 10 3 2027) FALSE (`d` 1 1 2027) FALSE (`d` 15 3 2027) EQUALS `too late: the notice was not given in time (s 72(2), (3))`
-- Across a month end in a leap year: received 27 February 2028, last day 2 March 2028.
#ASSERT `Is my jury notice for the re-hearing in time` TRUE FALSE TRUE `the defendant side` TRUE (`d` 27 2 2028) TRUE (`d` 2 3 2028) TRUE (`d` 2 3 2028) EQUALS `the jury notice is in time and the jury fees are paid: a jury of six (s 72)`
#ASSERT `Is my jury notice for the re-hearing in time` TRUE FALSE TRUE `the defendant side` TRUE (`d` 27 2 2028) TRUE (`d` 3 3 2028) TRUE (`d` 3 3 2028) EQUALS `too late: the notice was not given in time (s 72(2), (3))`
#ASSERT `Is my jury notice for the re-hearing in time` TRUE TRUE FALSE `the defendant side` FALSE (`d` 1 1 2027) FALSE (`d` 1 1 2027) FALSE (`d` 1 6 2027) EQUALS `still open: the notice can still be given in time (s 72(2), (3))`
-- Plaintiff: notice of trial given 1 February 2027; the jury notice goes with it.
#ASSERT `Is my jury notice for the re-hearing in time` TRUE TRUE FALSE `the plaintiff` TRUE (`d` 1 2 2027) TRUE (`d` 1 2 2027) TRUE (`d` 5 2 2027) EQUALS `the jury notice is in time and the jury fees are paid: a jury of six (s 72)`
#ASSERT `Is my jury notice for the re-hearing in time` TRUE TRUE FALSE `the plaintiff` TRUE (`d` 1 2 2027) TRUE (`d` 1 2 2027) FALSE (`d` 5 2 2027) EQUALS `the jury notice is in time, but the jury fees are still to be paid (s 72(2), (3))`
#ASSERT `Is my jury notice for the re-hearing in time` TRUE TRUE FALSE `the plaintiff` TRUE (`d` 1 2 2027) TRUE (`d` 2 2 2027) TRUE (`d` 5 2 2027) EQUALS `too late: the notice was not given in time (s 72(2), (3))`
#ASSERT `Is my jury notice for the re-hearing in time` TRUE TRUE FALSE `the plaintiff` TRUE (`d` 1 2 2027) FALSE (`d` 1 1 2027) FALSE (`d` 5 2 2027) EQUALS `too late: the notice was not given in time (s 72(2), (3))`
#ASSERT `Is my jury notice for the re-hearing in time` TRUE TRUE FALSE `the plaintiff` FALSE (`d` 1 1 2027) FALSE (`d` 1 1 2027) FALSE (`d` 5 2 2027) EQUALS `still open: the notice can still be given in time (s 72(2), (3))`
-- No entitlement under s 72(1): no jury as of right, whatever was done.
#ASSERT `Is my jury notice for the re-hearing in time` TRUE FALSE FALSE `the plaintiff` TRUE (`d` 1 2 2027) TRUE (`d` 1 2 2027) TRUE (`d` 5 2 2027) EQUALS `no jury as of right on the re-hearing (s 72(1))`

