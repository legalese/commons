IMPORT prelude
IMPORT `hca-dates`
IMPORT `hca-rules`
IMPORT `hca-seat`
IMPORT `hca-seat-provider`

-- Health Complaints Act 2016 (Vic) -- worked cases for the general health service provider's questions
-- (hca-seat-provider.l4), with mirror cases: the same facts asked from the complainant's seat (hca-seat.l4), with answers
-- that agree. Every expected value was worked by hand from the deposited text; none was copied from the encoding's output.
-- The facts are illustrative.
-- BASELINE ENCODING. Not for public use as advice. See NOTES.md.

§ `provider cases`

`dt` MEANS `the calendar date`
`no day` MEANS `dt` 1 1 2000

§§ `s 3 -- am I covered`

#ASSERT `Do I provide a general health service` `therapeutic counselling or psychotherapy` FALSE FALSE EQUALS TRUE
#ASSERT `Do I provide a general health service` `therapeutic counselling or psychotherapy` FALSE TRUE EQUALS FALSE
#ASSERT `Do I provide a general health service` `none of these` FALSE FALSE EQUALS FALSE
-- A registered nurse offering remedial massage outside nursing practice: general (finding 2).
#ASSERT `Do I provide a general health service` `an activity to assess, maintain or improve health, or to diagnose, prevent or treat illness, injury or disability` FALSE FALSE EQUALS TRUE

§§ `Schedule 2 -- the code, as the provider`

-- Safe practice: general; ten clause 1 facts; consent obtained; three clause 3 facts; belief of serious risk; referred.
-- cl 4: a reasonable belief of serious risk from another provider, not referred.
#ASSERT `Does my practice break the code on safe practice` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Does my practice break the code on safe practice` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Does my practice break the code on safe practice` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Does my practice break the code on safe practice` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Does my practice break the code on safe practice` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE

-- Events and health: general; event; no prompt measures; no first aid; serious and no help; not told; not reported;
-- infection; skin; transmissible; risk; advice not followed; under the influence; medication; no advice on it; treated
-- while it may impair; impairment risking harm; impairment that could risk; no advice sought.
-- cl 10(2): taking prescribed medication without advice on its effect.
#ASSERT `Does my practice break the code on events and health` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Does my practice break the code on events and health` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- cl 11(2): an impairment that could place clients at risk, no advice sought.
#ASSERT `Does my practice break the code on events and health` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Does my practice break the code on events and health` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
-- cl 7(2): a transmissible condition, advice not followed.
#ASSERT `Does my practice break the code on events and health` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Does my practice break the code on events and health` TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE

#ASSERT `Does my practice break the code on claims` TRUE FALSE TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Does my practice break the code on claims` TRUE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Does my practice break the code on money and conduct` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Does my practice break the code on records and information` TRUE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Does my practice break the code on records and information` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE

§§ `Mirror cases -- the same facts from both seats`

-- Unregistered naturopath: both seats say general.
#ASSERT `Was it a general health service` `an activity to assess, maintain or improve health, or to diagnose, prevent or treat illness, injury or disability` FALSE FALSE EQUALS `Do I provide a general health service` `an activity to assess, maintain or improve health, or to diagnose, prevent or treat illness, injury or disability` FALSE FALSE
-- A claim to cure cancer: both JUST TRUE.
#ASSERT `Did the provider break the code on claims` TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS `Does my practice break the code on claims` TRUE TRUE FALSE FALSE FALSE FALSE FALSE
#ASSERT `Does my practice break the code on claims` TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- A sexual relationship begun too soon after treatment ended, and nothing else: both NOTHING (cl 13(3) "should").
#ASSERT `Did the provider break the code on money and conduct` TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS `Does my practice break the code on money and conduct` TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE
#ASSERT `Does my practice break the code on money and conduct` TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS NOTHING
-- No indemnity insurance, and nothing else: both NOTHING (cl 16 "should"); the code not shown: both JUST TRUE.
#ASSERT `Did the provider break the code on records and information` TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS `Does my practice break the code on records and information` TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE
#ASSERT `Did the provider break the code on records and information` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS `Does my practice break the code on records and information` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE
-- No proper consent: both JUST TRUE.
#ASSERT `Did the provider break the code on safe practice` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `Does my practice break the code on safe practice` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE
-- A registered practitioner in their own profession: the code does not reach it, both JUST FALSE.
#ASSERT `Did the provider break the code on claims` FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS `Does my practice break the code on claims` FALSE TRUE FALSE FALSE FALSE FALSE FALSE
#ASSERT `Does my practice break the code on claims` FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- An adverse event not disclosed: both JUST TRUE.
#ASSERT `Did the provider break the code on events and health` TRUE TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `Does my practice break the code on events and health` TRUE TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE
-- Penalties: the same table.
#ASSERT `What is the most someone can be fined` `s 43 -- disclosing what was said, done or agreed in a conciliation` TRUE EQUALS `What is the most I can be fined` `s 43 -- disclosing what was said, done or agreed in a conciliation` TRUE
#ASSERT `What is the longest someone can be imprisoned` `s 102 -- providing a service prohibited in another State or Territory` FALSE EQUALS `What is the longest I can be imprisoned` `s 102 -- providing a service prohibited in another State or Territory` FALSE

§§ `ss 35, 39, 41, 52, 58 -- the Commissioner's requirements`

-- s 35: notice 1 March 2027, last day 29 March 2027.
#ASSERT `Have I done what the Commissioner required in time` `give the Commissioner a written response to each issue (s 35)` (`dt` 1 3 2027) (`dt` 29 3 2027) TRUE (`dt` 29 3 2027) (`dt` 2 4 2027) FALSE EQUALS `done in time`
#ASSERT `Have I done what the Commissioner required in time` `give the Commissioner a written response to each issue (s 35)` (`dt` 1 3 2027) (`dt` 29 3 2027) TRUE (`dt` 30 3 2027) (`dt` 2 4 2027) FALSE EQUALS `not done in time`
#ASSERT `Have I done what the Commissioner required in time` `give the Commissioner a written response to each issue (s 35)` (`dt` 1 3 2027) (`dt` 29 3 2027) FALSE `no day` (`dt` 29 3 2027) FALSE EQUALS `still open`
#ASSERT `Have I done what the Commissioner required in time` `give the Commissioner a written response to each issue (s 35)` (`dt` 1 3 2027) (`dt` 29 3 2027) FALSE `no day` (`dt` 30 3 2027) FALSE EQUALS `not done in time`
-- s 35 has no "without reasonable excuse": an excuse does not change the answer (fork F13).
#ASSERT `Have I done what the Commissioner required in time` `give the Commissioner a written response to each issue (s 35)` (`dt` 1 3 2027) (`dt` 29 3 2027) FALSE `no day` (`dt` 30 3 2027) TRUE EQUALS `not done in time`
-- s 52: response to an investigation report due 30 June 2027; late with a reasonable excuse, and without.
#ASSERT `Have I done what the Commissioner required in time` `give a written response to the investigation report (s 52)` (`dt` 1 5 2027) (`dt` 30 6 2027) FALSE `no day` (`dt` 1 7 2027) TRUE EQUALS `not done in time, but with a reasonable excuse (no offence)`
#ASSERT `Have I done what the Commissioner required in time` `give a written response to the investigation report (s 52)` (`dt` 1 5 2027) (`dt` 30 6 2027) FALSE `no day` (`dt` 1 7 2027) FALSE EQUALS `not done in time`
#ASSERT `Have I done what the Commissioner required in time` `give a written response to the investigation report (s 52)` (`dt` 1 5 2027) (`dt` 30 6 2027) TRUE (`dt` 30 6 2027) (`dt` 1 7 2027) TRUE EQUALS `done in time`
-- s 39: report on an undertaking, last day 15 January 2028; s 58 still open on the last day.
#ASSERT `Have I done what the Commissioner required in time` `report on implementing the undertaking (s 39)` (`dt` 15 1 2027) (`dt` 15 1 2028) TRUE (`dt` 16 1 2028) (`dt` 20 1 2028) FALSE EQUALS `not done in time`
#ASSERT `Have I done what the Commissioner required in time` `give a written response to the follow up report (s 58)` (`dt` 1 2 2028) (`dt` 29 2 2028) FALSE `no day` (`dt` 29 2 2028) FALSE EQUALS `still open`
#ASSERT `Have I done what the Commissioner required in time` `produce the documents or evidence (s 41)` (`dt` 1 2 2028) (`dt` 29 2 2028) TRUE (`dt` 1 3 2028) (`dt` 1 3 2028) TRUE EQUALS `not done in time`

-- The limits: 20 business days (ss 35, 41); 12 months after the undertaking (s 39); none for ss 52, 58.
#ASSERT `Is the time set within the Act's limit` `give the Commissioner a written response to each issue (s 35)` 20 `no day` `no day` EQUALS JUST TRUE
#ASSERT `Is the time set within the Act's limit` `give the Commissioner a written response to each issue (s 35)` 21 `no day` `no day` EQUALS JUST FALSE
#ASSERT `Is the time set within the Act's limit` `produce the documents or evidence (s 41)` 21 `no day` `no day` EQUALS JUST FALSE
#ASSERT `Is the time set within the Act's limit` `report on implementing the undertaking (s 39)` 0 (`dt` 15 1 2027) (`dt` 15 1 2028) EQUALS JUST TRUE
#ASSERT `Is the time set within the Act's limit` `report on implementing the undertaking (s 39)` 0 (`dt` 15 1 2027) (`dt` 16 1 2028) EQUALS JUST FALSE
#ASSERT `Is the time set within the Act's limit` `give a written response to the investigation report (s 52)` 100 `no day` `no day` EQUALS NOTHING

#ASSERT `Can my name be published for not responding` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Can my name be published for not responding` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Can my name be published for not responding` FALSE TRUE EQUALS JUST FALSE

