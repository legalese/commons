-- s 87 arguments: investigation begun, completed, Commissioner believes breach, satisfied of breach, prescribed
-- conviction, imminent serious risk, serious risk.
#ASSERT `Can a warning statement name me` TRUE FALSE TRUE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Can a warning statement name me` TRUE FALSE TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Can a warning statement name me` TRUE TRUE FALSE TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Can a warning statement name me` FALSE FALSE FALSE FALSE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Can a warning statement name me` FALSE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE

-- ss 90, 91 arguments: investigating, believes breach, prescribed conviction, DSSA order, copy given, notice and invitation,
-- satisfied of serious risk.
#ASSERT `Can an interim prohibition order be made against me` TRUE TRUE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Can an interim prohibition order be made against me` TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Can an interim prohibition order be made against me` FALSE TRUE FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Can an interim prohibition order be made against me` TRUE FALSE TRUE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Can an interim prohibition order be made against me` FALSE FALSE FALSE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Can an interim prohibition order be made against me` FALSE FALSE FALSE TRUE TRUE FALSE TRUE EQUALS JUST FALSE

