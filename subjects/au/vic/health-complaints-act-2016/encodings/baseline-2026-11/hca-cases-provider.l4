#ASSERT `When does the interim order end at the latest` (`dt` 6 12 2027) EQUALS `dt` 28 2 2028

#ASSERT `Can a prohibition order be made against me` TRUE TRUE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Can a prohibition order be made against me` TRUE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Can a prohibition order be made against me` FALSE FALSE FALSE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Can a prohibition order be made against me` FALSE FALSE FALSE TRUE FALSE TRUE TRUE EQUALS JUST FALSE

-- s 101: served 15 January 2027; 28 days later is 12 February 2027. Reasons given 1 February 2027: 1 March 2027.
#ASSERT `By when must I apply to VCAT` (`dt` 15 1 2027) FALSE FALSE `no day` EQUALS `dt` 12 2 2027
#ASSERT `By when must I apply to VCAT` (`dt` 15 1 2027) TRUE TRUE (`dt` 1 2 2027) EQUALS `dt` 1 3 2027
#ASSERT `By when must I apply to VCAT` (`dt` 15 1 2027) TRUE TRUE (`dt` 10 1 2027) EQUALS `dt` 12 2 2027
#ASSERT `Can I still apply to VCAT` (`dt` 15 1 2027) FALSE FALSE `no day` (`dt` 12 2 2027) EQUALS JUST TRUE
#ASSERT `Can I still apply to VCAT` (`dt` 15 1 2027) FALSE FALSE `no day` (`dt` 13 2 2027) EQUALS JUST FALSE
#ASSERT `Can I still apply to VCAT` (`dt` 15 1 2027) TRUE FALSE `no day` (`dt` 1 6 2027) EQUALS JUST TRUE
#ASSERT `Can I still apply to VCAT` (`dt` 15 1 2027) TRUE TRUE (`dt` 1 2 2027) (`dt` 1 3 2027) EQUALS JUST TRUE
#ASSERT `Can I still apply to VCAT` (`dt` 15 1 2027) TRUE TRUE (`dt` 1 2 2027) (`dt` 2 3 2027) EQUALS JUST FALSE

#ASSERT `May I provide this service in Victoria` TRUE FALSE EQUALS JUST FALSE
#ASSERT `May I provide this service in Victoria` FALSE TRUE EQUALS JUST FALSE
#ASSERT `May I provide this service in Victoria` FALSE FALSE EQUALS NOTHING

#ASSERT `What is the most I can be fined` `s 102 -- providing a service prohibited in another State or Territory` TRUE EQUALS 1200
#ASSERT `What is the most I can be fined` `s 35 -- not giving the written response the Commissioner required` FALSE EQUALS 20
#ASSERT `What is the most I can be fined` `s 52 -- not responding to an investigation report` TRUE EQUALS 300
#ASSERT `What is the longest I can be imprisoned` `s 102 -- providing a service prohibited in another State or Territory` FALSE EQUALS 24
#ASSERT `What is the longest I can be imprisoned` `s 93 -- not complying with an interim prohibition order` TRUE EQUALS 0
