§§ `Part 3 -- complaint resolution and conciliation`

#ASSERT `Can conciliation begin` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Can conciliation begin` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Can conciliation begin` FALSE TRUE EQUALS JUST FALSE

-- s 43: a party; consent covers what was said or done, not an agreement (finding 6); undertakings are outside s 43.
#ASSERT `Am I forbidden to disclose the conciliation` TRUE `something said or done in the conciliation` FALSE EQUALS JUST TRUE
#ASSERT `Am I forbidden to disclose the conciliation` TRUE `something said or done in the conciliation` TRUE EQUALS JUST FALSE
#ASSERT `Am I forbidden to disclose the conciliation` TRUE `an agreement reached in the conciliation` TRUE EQUALS JUST TRUE
#ASSERT `Am I forbidden to disclose the conciliation` TRUE `an undertaking the provider gave the Commissioner` FALSE EQUALS JUST FALSE
#ASSERT `Am I forbidden to disclose the conciliation` FALSE `something said or done in the conciliation` FALSE EQUALS NOTHING

