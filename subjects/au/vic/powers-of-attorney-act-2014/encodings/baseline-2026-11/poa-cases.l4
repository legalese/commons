#ASSERT `Can this person be my attorney` `ind` `for both` 45 FALSE FALSE FALSE TRUE TRUE FALSE FALSE FALSE EQUALS `yes: an individual eligible under s 28(1)`
#ASSERT `Can this person be my attorney` `ind` `for both` 45 FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS `no: my care worker, health provider or accommodation provider (s 28(1)(d))`
#ASSERT `Can this person be my attorney` `ind` `for both` 45 FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS `no: my care worker, health provider or accommodation provider (s 28(1)(d))`
#ASSERT `Can this person be my attorney` `TC` `for fin` 0 FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `yes: a trustee company eligible for financial matters (s 28(2))`
#ASSERT `Can this person be my attorney` `TC` `for fin` 0 FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS `no: a trustee company against which a winding up proceeding has commenced (s 28(2))`
