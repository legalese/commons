§§ `ss 73-79 -- compensation`

-- Arguments: contravention, court advice, invalid or revoked, good faith, relief, died.
#ASSERT `Can I be compensated by my attorney` FALSE FALSE FALSE FALSE `no relief` FALSE EQUALS `not covered: s 77 reaches only a loss caused by my attorney contravening the Act while acting as attorney`
#ASSERT `Can I be compensated by my attorney` TRUE FALSE FALSE FALSE `no relief` FALSE EQUALS `comp yes`
#ASSERT `Can I be compensated by my attorney` TRUE FALSE FALSE FALSE `no relief` TRUE EQUALS `yes: the Supreme Court or VCAT may order compensation, payable to my estate (s 77(2)(b))`
#ASSERT `Can I be compensated by my attorney` TRUE TRUE FALSE FALSE `no relief` FALSE EQUALS `no: my attorney acted on the advice, direction or order of the Supreme Court or VCAT and is taken to have complied (ss 76, 77(3))`
#ASSERT `Can I be compensated by my attorney` TRUE FALSE TRUE TRUE `no relief` FALSE EQUALS `no: my attorney relied in good faith on a power not known to be invalid or revoked (ss 73, 75(1), 77(3))`
#ASSERT `Can I be compensated by my attorney` TRUE FALSE TRUE FALSE `no relief` FALSE EQUALS `comp yes`
#ASSERT `Can I be compensated by my attorney` TRUE FALSE FALSE TRUE `no relief` FALSE EQUALS `comp yes`
