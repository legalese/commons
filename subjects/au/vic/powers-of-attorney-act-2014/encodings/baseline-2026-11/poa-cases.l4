#ASSERT `Who is my nearest relative` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS `my eldest adult nephew or niece (s 3, relative (h))`
#ASSERT `Who is my nearest relative` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `my spouse or domestic partner (s 3, relative (a))`
#ASSERT `Who is my nearest relative` FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS `my elder or eldest parent or step-parent (s 3, relative (c))`
#ASSERT `Who is my nearest relative` FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS `my eldest adult child (s 3, relative (b))`
#ASSERT `Who is my nearest relative` FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS `my eldest grandparent (s 3, relative (e))`

§§ `s 4 -- decision making capacity`

#ASSERT `Do I have decision making capacity` FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `yes: I am presumed to have it, as there is no evidence to the contrary (s 4(2))`
#ASSERT `Do I have decision making capacity` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS `yes: I am presumed to have it, as there is no evidence to the contrary (s 4(2))`
#ASSERT `Do I have decision making capacity` TRUE FALSE TRUE TRUE TRUE TRUE EQUALS `yes: I can understand, retain, use or weigh, and communicate the decision, with any practicable and appropriate support (s 4(1), (3), (4)(e))`
#ASSERT `Do I have decision making capacity` TRUE FALSE TRUE TRUE TRUE FALSE EQUALS `no: I do not have it for this matter, though I may for others, and it may be temporary (s 4(1), (4)(a), (b))`
#ASSERT `Do I have decision making capacity` TRUE FALSE FALSE TRUE TRUE TRUE EQUALS `no: I do not have it for this matter, though I may for others, and it may be temporary (s 4(1), (4)(a), (b))`

§§ `ss 22, 23, 26 -- making the power, and what it can cover`

#ASSERT `Can I make an enduring power of attorney` 17 FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `no: I am under 18 (s 23(1)(a))`
#ASSERT `Can I make an enduring power of attorney` 18 FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `yes: I am 18 or over and have decision making capacity to make it (s 23(1))`
#ASSERT `Can I make an enduring power of attorney` 18 TRUE FALSE FALSE TRUE TRUE TRUE EQUALS `no: I do not have decision making capacity to make it (s 23(1)(b))`
#ASSERT `Can I make an enduring power of attorney` 40 TRUE FALSE TRUE TRUE TRUE TRUE EQUALS `yes: I am 18 or over and have decision making capacity to make it (s 23(1))`

#ASSERT `Can I give my attorney this power` `running, settling or defending a legal claim for me, and receiving the money` EQUALS `yes: a financial matter (ss 3, 22)`
#ASSERT `Can I give my attorney this power` `managing my money, property and compensation` EQUALS `yes: a financial matter (ss 3, 22)`
#ASSERT `Can I give my attorney this power` `deciding where and with whom I live, and other personal matters` EQUALS `yes: a personal matter (ss 3, 22)`
#ASSERT `Can I give my attorney this power` `medical treatment decisions` EQUALS `not covered: medical treatment is outside personal matters (s 3); see the Medical Treatment Planning and Decisions Act 2016`
#ASSERT `Can I give my attorney this power` `making or revoking my will` EQUALS `no: s 26 says an enduring power of attorney cannot authorise it`
#ASSERT `Can I give my attorney this power` `voting for me in an election or referendum` EQUALS `no: s 26 says an enduring power of attorney cannot authorise it`
#ASSERT `Can I give my attorney this power` `managing my estate after my death` EQUALS `no: s 26 says an enduring power of attorney cannot authorise it`
#ASSERT `Can I give my attorney this power` `consenting to an unlawful act` EQUALS `no: s 26 says an enduring power of attorney cannot authorise it`
#ASSERT `Can I give my attorney this power` `something else a person can lawfully do by an attorney` EQUALS `yes: anything a person can lawfully do by an attorney (s 22(1))`
#ASSERT `Can I give my attorney this power` `something a person cannot lawfully do by an attorney` EQUALS `no: it is not something a person can lawfully do by an attorney (s 22(1))`

