#ASSERT `Can I be compensated by my attorney` TRUE FALSE FALSE FALSE `relieved of part` FALSE EQUALS `yes, but only for the part of the liability not relieved (ss 74, 77)`
#ASSERT `Can I be compensated by my attorney` TRUE FALSE FALSE FALSE `relieved of part` TRUE EQUALS `yes, but only for the part of the liability not relieved (ss 74, 77)`

