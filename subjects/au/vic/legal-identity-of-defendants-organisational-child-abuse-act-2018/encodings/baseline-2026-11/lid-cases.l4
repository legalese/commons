IMPORT prelude
IMPORT `lid-dates`
IMPORT `lid-core`
IMPORT `lid-seat`

-- Cases for the survivor's seat (lid-seat.l4) and the core's rule (lid-core.l4). Every expected value is worked by
-- hand from the deposited texts, with the reason or the count in the comment; none is copied from the encoding's
-- output. Weekdays: 2 March 2026 and 2 November 2026 are Mondays; 1 January 2027 is a Friday.
-- Breached traces are asserted with CONSIDER ... WHEN FULFILLED (EVALTRACE ... EQUALS cannot test a breach).
-- BASELINE ENCODING. Not for public use as advice. See NOTES.md.

§ `Cases`

GIVEN `the outcome` IS A DEONTIC `Party` `Step`
GIVETH A BOOLEAN
`ends fulfilled` `the outcome` MEANS
    CONSIDER `the outcome`
    WHEN FULFILLED THEN TRUE
    OTHERWISE FALSE

GIVEN `y` IS A NUMBER, `m` IS A NUMBER, `d` IS A NUMBER
GIVETH A DATE
`on` `y` `m` `d` MEANS DATE_FROM_DMY `d` `m` `y`

GIVEN `y` IS A NUMBER, `m` IS A NUMBER, `d` IS A NUMBER
GIVETH A NUMBER
`day` `y` `m` `d` MEANS DATE_SERIAL (DATE_FROM_DMY `d` `m` `y`)

§§ `s 3 -- child abuse`

-- Sexual misconduct at 17: a minor. At 18: not a minor (the reading of "minor" as under 18).
#ASSERT `Is what happened to me child abuse under the Act` 17 `sexual assault or other sexual misconduct`
#ASSERT NOT (`Is what happened to me child abuse under the Act` 18 `sexual assault or other sexual misconduct`)
#ASSERT `Is what happened to me child abuse under the Act` 10 `physical abuse`
-- Physical abuse does not include a lawful exercise of force.
#ASSERT NOT (`Is what happened to me child abuse under the Act` 10 `force with a lawful justification or excuse, or another lawful exercise of force`)
-- Psychological abuse counts only where it arises out of physical or sexual abuse ((b)).
#ASSERT NOT (`Is what happened to me child abuse under the Act` 10 `psychological abuse alone, not arising out of physical or sexual abuse`)
#ASSERT NOT (`Is what happened to me child abuse under the Act` 10 `other harm, such as neglect`)

§§ `s 5 -- NGO`

#ASSERT `Is the organisation an NGO under the Act` TRUE TRUE
#ASSERT NOT (`Is the organisation an NGO under the Act` TRUE FALSE)
#ASSERT NOT (`Is the organisation an NGO under the Act` FALSE TRUE)

§§ `ss 3, 6 -- associated trust`

-- Used for its activities, and any one of the seven heads of control is enough.
#ASSERT `Is this trust an associated trust of the organisation` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE
#ASSERT `Is this trust an associated trust of the organisation` TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE
#ASSERT `Is this trust an associated trust of the organisation` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE
#ASSERT `Is this trust an associated trust of the organisation` TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE
#ASSERT `Is this trust an associated trust of the organisation` TRUE FALSE FALSE FALSE FALSE TRUE FALSE FALSE
#ASSERT `Is this trust an associated trust of the organisation` TRUE FALSE FALSE FALSE FALSE FALSE TRUE FALSE
#ASSERT `Is this trust an associated trust of the organisation` TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE
-- No head of control: not controlled, so not an associated trust.
#ASSERT NOT (`Is this trust an associated trust of the organisation` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
-- Controlled in every way but not used to conduct the organisation's activities.
#ASSERT NOT (`Is this trust an associated trust of the organisation` FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE)

§§ `s 4(2) -- application`

#ASSERT `Does the Act apply to the organisation I want to sue` 12 `sexual assault or other sexual misconduct` TRUE TRUE TRUE TRUE
-- (a) fails: abuse at 18 is not child abuse.
#ASSERT NOT (`Does the Act apply to the organisation I want to sue` 18 `sexual assault or other sexual misconduct` TRUE TRUE TRUE TRUE)
-- Not an NGO: a government body; an incorporated body.
#ASSERT NOT (`Does the Act apply to the organisation I want to sue` 12 `physical abuse` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`Does the Act apply to the organisation I want to sue` 12 `physical abuse` TRUE FALSE TRUE TRUE)
-- (b) fails.
#ASSERT NOT (`Does the Act apply to the organisation I want to sue` 12 `physical abuse` TRUE TRUE FALSE TRUE)
-- (c) fails: no associated trust.
#ASSERT NOT (`Does the Act apply to the organisation I want to sue` 12 `physical abuse` TRUE TRUE TRUE FALSE)

§§ `ss 7, 8, 13 -- whom to sue`

-- The Act does not apply: it names no one.
#ASSERT `Whom do I sue` FALSE FALSE FALSE FALSE EQUALS NOTHING
-- No nomination, no order: the NGO in its own name (s 13).
#ASSERT `Whom do I sue` TRUE FALSE FALSE FALSE EQUALS JUST `the NGO itself, in its own name, until a proper defendant is nominated or appointed (s 13)`
-- A consented nomination of an entity that can be sued (s 7(2)).
#ASSERT `Whom do I sue` TRUE TRUE TRUE FALSE EQUALS JUST `the nominated entity, as the defendant on behalf of the NGO (s 7(2))`
-- A nominee that cannot be sued is no proper defendant under s 7(1): still the NGO (fork line 2 in NOTES.md).
#ASSERT `Whom do I sue` TRUE TRUE FALSE FALSE EQUALS JUST `the NGO itself, in its own name, until a proper defendant is nominated or appointed (s 13)`
-- A s 8(4) order: the trustees, with or without an earlier nomination.
#ASSERT `Whom do I sue` TRUE TRUE TRUE TRUE EQUALS JUST `the trustees of the associated trust, as the defendant on behalf of the NGO (s 8(5))`
#ASSERT `Whom do I sue` TRUE FALSE FALSE TRUE EQUALS JUST `the trustees of the associated trust, as the defendant on behalf of the NGO (s 8(5))`

-- s 13: pending a proper defendant, yes; after, no; the Act not applying, no.
#ASSERT `Can I sue the organisation in its own name` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Can I sue the organisation in its own name` TRUE TRUE EQUALS JUST FALSE
#ASSERT `Can I sue the organisation in its own name` FALSE FALSE EQUALS JUST FALSE

§§ `s 7(3) -- the 120 days`

-- Commenced Monday 2 March 2026: 29 days to 31 March, 30 in April (59), 31 in May (90), 30 in June (120): 30 June 2026.
#ASSERT `By when can the organisation nominate a proper defendant` (`on` 2026 3 2) FALSE (`on` 2000 1 1) EQUALS `on` 2026 6 30
-- The court ordered otherwise: its day.
#ASSERT `By when can the organisation nominate a proper defendant` (`on` 2026 3 2) TRUE (`on` 2026 8 31) EQUALS `on` 2026 8 31
-- The Act's 120 days run through the Christmas vacation (finding 6): 1 December 2025 + 30 (December) + 31 + 28 + 31 = 31 March 2026.
#ASSERT `By when can the organisation nominate a proper defendant` (`on` 2025 12 1) FALSE (`on` 2000 1 1) EQUALS `on` 2026 3 31

§§ `s 8(1) -- applying for the trust to be the proper defendant`

-- Commenced 2 March 2026; day 120 is 30 June 2026. No nomination; applying 1 July 2026, day 121: (a).
#ASSERT `Can I apply for my claim to proceed against the trustees of an associated trust` TRUE (`on` 2026 3 2) (`on` 2026 7 1) FALSE (`on` 2000 1 1) FALSE FALSE
-- Applying on 30 June 2026, day 120: the NGO has not yet failed.
#ASSERT NOT (`Can I apply for my claim to proceed against the trustees of an associated trust` TRUE (`on` 2026 3 2) (`on` 2026 6 30) FALSE (`on` 2000 1 1) FALSE FALSE)
-- Nominated on day 120 (30 June) an entity that can be sued, with enough assets: s 8 does not apply.
#ASSERT NOT (`Can I apply for my claim to proceed against the trustees of an associated trust` TRUE (`on` 2026 3 2) (`on` 2026 7 1) TRUE (`on` 2026 6 30) TRUE FALSE)
-- Nominated on day 121 (1 July): it failed to nominate within 120 days, (a) (fork line 1).
#ASSERT `Can I apply for my claim to proceed against the trustees of an associated trust` TRUE (`on` 2026 3 2) (`on` 2026 7 2) TRUE (`on` 2026 7 1) TRUE FALSE
-- (b): a nominee lacking the assets, or one that cannot be sued, even on day 40.
#ASSERT `Can I apply for my claim to proceed against the trustees of an associated trust` TRUE (`on` 2026 3 2) (`on` 2026 4 11) TRUE (`on` 2026 4 10) TRUE TRUE
#ASSERT `Can I apply for my claim to proceed against the trustees of an associated trust` TRUE (`on` 2026 3 2) (`on` 2026 4 11) TRUE (`on` 2026 4 10) FALSE FALSE
-- The Act does not apply to the organisation.
#ASSERT NOT (`Can I apply for my claim to proceed against the trustees of an associated trust` FALSE (`on` 2026 3 2) (`on` 2026 7 1) FALSE (`on` 2000 1 1) FALSE FALSE)

-- s 8(3) and ss 7(5), 8(9).
#ASSERT `Must the organisation identify its associated trusts` TRUE EQUALS JUST TRUE
#ASSERT `Must the organisation identify its associated trusts` FALSE EQUALS NOTHING
#ASSERT `Must the organisation still meet its obligations in the proceeding` TRUE EQUALS JUST TRUE
#ASSERT `Must the organisation still meet its obligations in the proceeding` FALSE EQUALS NOTHING

§§ `Order 85 -- service and amendment`

-- r 85.02(2): filed Monday 2 November 2026 + 7 = Monday 9 November 2026.
#ASSERT `By when must the organisation serve its nomination on me` (`on` 2026 11 2) EQUALS `on` 2026 11 9
-- Filed Monday 21 December 2026: 22, 23 December (2), 24 December-9 January left out, 10-14 January (7): Thursday 14 January 2027.
#ASSERT `By when must the organisation serve its nomination on me` (`on` 2026 12 21) EQUALS `on` 2027 1 14
-- Filed Thursday 17 December 2026: 18-23 December (6), 10 January (7), a Sunday: Monday 11 January 2027 (r 3.01(5)).
#ASSERT `By when must the organisation serve its nomination on me` (`on` 2026 12 17) EQUALS `on` 2027 1 11

-- r 85.03: served Monday 2 November 2026 before 4 pm + 28 = Monday 30 November 2026.
#ASSERT `By when must I file my amended originating process and statement of claim` (`on` 2026 11 2) FALSE FALSE (`on` 2000 1 1) EQUALS `on` 2026 11 30
-- After 4 pm: taken as served Tuesday 3 November; + 28 = Tuesday 1 December 2026.
#ASSERT `By when must I file my amended originating process and statement of claim` (`on` 2026 11 2) TRUE FALSE (`on` 2000 1 1) EQUALS `on` 2026 12 1
-- Friday 6 November after 4 pm, and Saturday 7 November: both taken as served Monday 9 November; + 28 = Monday 7 December.
#ASSERT `By when must I file my amended originating process and statement of claim` (`on` 2026 11 6) TRUE FALSE (`on` 2000 1 1) EQUALS `on` 2026 12 7
#ASSERT `By when must I file my amended originating process and statement of claim` (`on` 2026 11 7) FALSE FALSE (`on` 2000 1 1) EQUALS `on` 2026 12 7
-- Friday 6 November before 4 pm: + 28 = Friday 4 December.
#ASSERT `By when must I file my amended originating process and statement of claim` (`on` 2026 11 6) FALSE FALSE (`on` 2000 1 1) EQUALS `on` 2026 12 4
-- Tuesday 1 December 2026: 2-23 December (22), 10-15 January (28): Friday 15 January 2027.
#ASSERT `By when must I file my amended originating process and statement of claim` (`on` 2026 12 1) FALSE FALSE (`on` 2000 1 1) EQUALS `on` 2027 1 15
-- Thursday 3 December 2026: 4-23 December (20), 10-17 January (28), a Sunday: Monday 18 January 2027.
#ASSERT `By when must I file my amended originating process and statement of claim` (`on` 2026 12 3) FALSE FALSE (`on` 2000 1 1) EQUALS `on` 2027 1 18
-- Thursday 24 December 2026 (a weekday, office open): 10-31 January (22), 1-6 February (28), a Saturday: Monday 8 February 2027.
#ASSERT `By when must I file my amended originating process and statement of claim` (`on` 2026 12 24) FALSE FALSE (`on` 2000 1 1) EQUALS `on` 2027 2 8
-- The court directed otherwise.
#ASSERT `By when must I file my amended originating process and statement of claim` (`on` 2026 11 2) FALSE TRUE (`on` 2027 3 1) EQUALS `on` 2027 3 1

§§ `The steps as a rule (EVALTRACE)`

-- Commenced 2 March 2026. Nomination filed 30 June 2026 (day 120); served Tuesday 7 July (30 June + 7); amended
-- process filed Tuesday 4 August (7 July + 28): fulfilled.
#ASSERT EVALTRACE `ss 7, 8 and Order 85 -- nomination, service and amendment` (`day` 2026 3 2) (LIST (EVENT `the NGO` (`file a nomination of a proper defendant in Form 85A` (`on` 2026 6 30)) (`day` 2026 6 30)), (EVENT `the NGO` (`serve the nomination` (`on` 2026 7 7) FALSE) (`day` 2026 7 7)), (EVENT `the plaintiff` `file the amended originating process and statement of claim` (`day` 2026 8 4))) EQUALS FULFILLED
-- The amended process filed Wednesday 5 August: the plaintiff's breach of r 85.03.
#ASSERT NOT (`ends fulfilled` (EVALTRACE `ss 7, 8 and Order 85 -- nomination, service and amendment` (`day` 2026 3 2) (LIST (EVENT `the NGO` (`file a nomination of a proper defendant in Form 85A` (`on` 2026 6 30)) (`day` 2026 6 30)), (EVENT `the NGO` (`serve the nomination` (`on` 2026 7 7) FALSE) (`day` 2026 7 7)), (EVENT `the plaintiff` `file the amended originating process and statement of claim` (`day` 2026 8 5)))))
-- Served after 4 pm on 7 July: taken as served Wednesday 8 July, so 5 August is in time.
#ASSERT EVALTRACE `ss 7, 8 and Order 85 -- nomination, service and amendment` (`day` 2026 3 2) (LIST (EVENT `the NGO` (`file a nomination of a proper defendant in Form 85A` (`on` 2026 6 30)) (`day` 2026 6 30)), (EVENT `the NGO` (`serve the nomination` (`on` 2026 7 7) TRUE) (`day` 2026 7 7)), (EVENT `the plaintiff` `file the amended originating process and statement of claim` (`day` 2026 8 5))) EQUALS FULFILLED
-- Served Wednesday 8 July, a day late: the NGO's breach of r 85.02(2).
#ASSERT NOT (`ends fulfilled` (EVALTRACE `ss 7, 8 and Order 85 -- nomination, service and amendment` (`day` 2026 3 2) (LIST (EVENT `the NGO` (`file a nomination of a proper defendant in Form 85A` (`on` 2026 6 30)) (`day` 2026 6 30)), (EVENT `the NGO` (`serve the nomination` (`on` 2026 7 8) FALSE) (`day` 2026 7 8)), (EVENT `the plaintiff` `file the amended originating process and statement of claim` (`day` 2026 8 5)))))
-- No nomination by day 120: on 1 July the plaintiff may apply by summons; applying ends the rule.
#ASSERT EVALTRACE `ss 7, 8 and Order 85 -- nomination, service and amendment` (`day` 2026 3 2) (LIST (WAITUNTIL (`day` 2026 7 1)), (EVENT `the plaintiff` `apply by summons for an order that the claim proceed against the trustees of an associated trust` (`day` 2026 7 20))) EQUALS FULFILLED
-- A nomination filed on day 121 is too late to count; the plaintiff's application still ends the rule.
#ASSERT EVALTRACE `ss 7, 8 and Order 85 -- nomination, service and amendment` (`day` 2026 3 2) (LIST (EVENT `the NGO` (`file a nomination of a proper defendant in Form 85A` (`on` 2026 7 1)) (`day` 2026 7 1)), (EVENT `the plaintiff` `apply by summons for an order that the claim proceed against the trustees of an associated trust` (`day` 2026 7 20))) EQUALS FULFILLED
-- Day 121 with neither: not ended (the plaintiff's permission is still open), and no breach.
#ASSERT NOT (`ends fulfilled` (EVALTRACE `ss 7, 8 and Order 85 -- nomination, service and amendment` (`day` 2026 3 2) (LIST (WAITUNTIL (`day` 2026 7 1)))))

§§ `ss 9-12 -- getting paid`

-- s 9(2): the lesser of the liability and the value of the trust property.
#ASSERT `What is the most I can recover from the trustees of one associated trust` 500000 300000 EQUALS 300000
#ASSERT `What is the most I can recover from the trustees of one associated trust` 200000 300000 EQUALS 200000
#ASSERT `What is the most I can recover from the trustees of one associated trust` 300000 300000 EQUALS 300000
#ASSERT `What is the most I can recover from the trustees of one associated trust` 300001 300000 EQUALS 300000
-- A trust with no property: nothing from its trustees.
#ASSERT `What is the most I can recover from the trustees of one associated trust` 300000 0 EQUALS 0

-- ss 9(1), 11.
#ASSERT `May the trustees pay my judgment from the trust property` TRUE TRUE EQUALS JUST TRUE
#ASSERT `May the trustees pay my judgment from the trust property` TRUE FALSE EQUALS NOTHING
#ASSERT `May the trustees pay my judgment from the trust property` FALSE TRUE EQUALS NOTHING

-- s 10.
#ASSERT `Can the proper defendant rely on the defence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Can the proper defendant rely on the defence` TRUE FALSE EQUALS NOTHING
#ASSERT `Can the proper defendant rely on the defence` FALSE TRUE EQUALS NOTHING

-- s 12.
#ASSERT `Does the organisation's insurance cover the proper defendant` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Does the organisation's insurance cover the proper defendant` FALSE TRUE EQUALS NOTHING
#ASSERT `Does the organisation's insurance cover the proper defendant` TRUE FALSE EQUALS NOTHING

§§ `Read with the Wrongs Act and the Limitation of Actions Act`

-- Wrongs Act s 88(ba), s 93: abuse on 1 July 2017, the first day of Part XIII; on 30 June 2017, outside it.
#ASSERT `Is the organisation a relevant organisation under the Wrongs Act` (`on` 2017 7 1) TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Is the organisation a relevant organisation under the Wrongs Act` (`on` 2017 6 30) TRUE TRUE TRUE EQUALS NOTHING
-- This Act does not apply to it, or it has no care of children: (ba) does not make it one.
#ASSERT `Is the organisation a relevant organisation under the Wrongs Act` (`on` 2020 1 1) TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Is the organisation a relevant organisation under the Wrongs Act` (`on` 2020 1 1) TRUE FALSE TRUE EQUALS JUST FALSE

-- Limitation of Actions Act ss 27O, 27P, 27Q.
#ASSERT `Can I bring my action at any time` TRUE 15 `sexual assault or other sexual misconduct` FALSE EQUALS JUST TRUE
#ASSERT `Can I bring my action at any time` TRUE 17 `physical abuse` FALSE EQUALS JUST TRUE
-- A dependants' death claim under Wrongs Act Part III: 3 years from discoverability (s 27Q), not at any time.
#ASSERT `Can I bring my action at any time` TRUE 15 `sexual assault or other sexual misconduct` TRUE EQUALS JUST FALSE
-- Abuse at 18, lawful force, an action not for death or injury: outside Division 5.
#ASSERT `Can I bring my action at any time` TRUE 18 `sexual assault or other sexual misconduct` FALSE EQUALS NOTHING
#ASSERT `Can I bring my action at any time` TRUE 15 `force with a lawful justification or excuse, or another lawful exercise of force` FALSE EQUALS NOTHING
#ASSERT `Can I bring my action at any time` FALSE 15 `sexual assault or other sexual misconduct` FALSE EQUALS NOTHING
