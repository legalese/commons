#ASSERT `May my decision maker or support person get my health information` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `May my decision maker or support person get my health information` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `May my decision maker or support person get my health information` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `May my decision maker or support person get my health information` FALSE TRUE TRUE EQUALS NOTHING

