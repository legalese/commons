#ASSERT `By when must I apply for a rehearing` (`d` 1 3 2027) TRUE (`d` 10 3 2027) EQUALS `d` 7 4 2027
#ASSERT `By when must I apply for a rehearing` (`d` 1 2 2028) FALSE (`d` 1 1 2000) EQUALS `d` 29 2 2028
#ASSERT `By when must I apply for a rehearing` (`d` 1 2 2027) FALSE (`d` 1 1 2000) EQUALS `d` 1 3 2027
-- Arguments: order made on, written reasons requested, reasons given on, applied, applied on, today.
#ASSERT `Is my rehearing application in time` (`d` 1 3 2027) FALSE (`d` 1 1 2000) TRUE (`d` 29 3 2027) (`d` 1 6 2027) EQUALS `made in time (s 88(3))`
#ASSERT `Is my rehearing application in time` (`d` 1 3 2027) FALSE (`d` 1 1 2000) TRUE (`d` 30 3 2027) (`d` 1 6 2027) EQUALS `out of time: the 28 days have passed (s 88(3))`
#ASSERT `Is my rehearing application in time` (`d` 1 3 2027) FALSE (`d` 1 1 2000) TRUE (`d` 1 3 2027) (`d` 1 6 2027) EQUALS `made in time (s 88(3))`
#ASSERT `Is my rehearing application in time` (`d` 1 3 2027) FALSE (`d` 1 1 2000) FALSE (`d` 1 1 2000) (`d` 29 3 2027) EQUALS `still open: I can apply in time (s 88(3))`
#ASSERT `Is my rehearing application in time` (`d` 1 3 2027) FALSE (`d` 1 1 2000) FALSE (`d` 1 1 2000) (`d` 30 3 2027) EQUALS `out of time: the 28 days have passed (s 88(3))`
#ASSERT `Is my rehearing application in time` (`d` 1 3 2027) TRUE (`d` 10 3 2027) TRUE (`d` 7 4 2027) (`d` 1 6 2027) EQUALS `made in time (s 88(3))`
#ASSERT `Is my rehearing application in time` (`d` 1 3 2027) TRUE (`d` 10 3 2027) TRUE (`d` 8 4 2027) (`d` 1 6 2027) EQUALS `out of time: the 28 days have passed (s 88(3))`
#ASSERT `Is my rehearing application in time` (`d` 1 2 2028) FALSE (`d` 1 1 2000) TRUE (`d` 29 2 2028) (`d` 1 6 2028) EQUALS `made in time (s 88(3))`
#ASSERT `Is my rehearing application in time` (`d` 1 2 2028) FALSE (`d` 1 1 2000) TRUE (`d` 1 3 2028) (`d` 1 6 2028) EQUALS `out of time: the 28 days have passed (s 88(3))`

§§ `ss 14, 15, 41, 42, 84, 85 -- maximum penalties (in penalty units and years)`

#ASSERT (`penalty` `inducing me to give an advance care directive by dishonesty or undue influence (s 14(1))` `a natural person`)'s `penalty units` EQUALS 600
#ASSERT (`penalty` `inducing me to give an advance care directive by dishonesty or undue influence (s 14(1))` `a natural person`)'s `years of imprisonment` EQUALS 5
#ASSERT (`penalty` `inducing me to give an advance care directive by dishonesty or undue influence (s 14(1))` `a body corporate`)'s `penalty units` EQUALS 2400
#ASSERT (`penalty` `inducing me to give an advance care directive by dishonesty or undue influence (s 14(1))` `a body corporate`)'s `years of imprisonment` EQUALS 0
#ASSERT (`penalty` `knowingly making a false or misleading statement about my directive or my attempt to give one (s 15)` `a natural person`)'s `penalty units` EQUALS 600
#ASSERT (`penalty` `knowingly making a false or misleading statement about my directive or my attempt to give one (s 15)` `a body corporate`)'s `penalty units` EQUALS 2400
#ASSERT (`penalty` `purporting to act as my appointed decision maker or support person without being one (s 41)` `a natural person`)'s `years of imprisonment` EQUALS 5
#ASSERT (`penalty` `purporting to act as my appointed decision maker or support person without being one (s 41)` `a body corporate`)'s `penalty units` EQUALS 600
#ASSERT (`penalty` `inducing me to appoint a decision maker by dishonesty or undue influence (s 42(1))` `a body corporate`)'s `penalty units` EQUALS 2400
#ASSERT (`penalty` `inducing me to appoint a decision maker by dishonesty or undue influence (s 42(1))` `a natural person`)'s `penalty units` EQUALS 600
#ASSERT (`penalty` `giving me a research procedure in an unapproved project (s 84)` `a natural person`)'s `penalty units` EQUALS 240
#ASSERT (`penalty` `giving me a research procedure in an unapproved project (s 84)` `a natural person`)'s `years of imprisonment` EQUALS 0
#ASSERT (`penalty` `giving me a research procedure without consent or authorisation (s 85)` `a natural person`)'s `penalty units` EQUALS 240
#ASSERT (`penalty` `giving me a research procedure without consent or authorisation (s 85)` `a natural person`)'s `years of imprisonment` EQUALS 2
