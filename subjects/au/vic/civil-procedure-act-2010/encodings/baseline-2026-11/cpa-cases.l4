#ASSERT `Is my disclosure in time` (`d` 1 2 2027) FALSE (`d` 1 1 2000) (`d` 15 2 2027) FALSE (`d` 1 1 2000) (`d` 16 2 2027) EQUALS `not done in time`
-- The court directed 1 March 2027: disclosure on 20 February and on 1 March is in time, on 2 March late.
#ASSERT `Is my disclosure in time` (`d` 1 2 2027) TRUE (`d` 1 3 2027) (`d` 15 2 2027) TRUE (`d` 20 2 2027) (`d` 5 3 2027) EQUALS `done in time`
#ASSERT `Is my disclosure in time` (`d` 1 2 2027) TRUE (`d` 1 3 2027) (`d` 15 2 2027) TRUE (`d` 1 3 2027) (`d` 5 3 2027) EQUALS `done in time`
#ASSERT `Is my disclosure in time` (`d` 1 2 2027) TRUE (`d` 1 3 2027) (`d` 15 2 2027) TRUE (`d` 2 3 2027) (`d` 5 3 2027) EQUALS `not done in time`
#ASSERT `Is my disclosure in time` (`d` 1 2 2027) TRUE (`d` 1 3 2027) (`d` 15 2 2027) FALSE (`d` 1 1 2000) (`d` 20 2 2027) EQUALS `still open`

§§ `s 27 -- use and admission of disclosed documents`

#ASSERT `May I use disclosed documents outside the case` FALSE FALSE EQUALS JUST FALSE
#ASSERT `May I use disclosed documents outside the case` TRUE FALSE EQUALS JUST TRUE
#ASSERT `May I use disclosed documents outside the case` FALSE TRUE EQUALS JUST TRUE
#ASSERT `Can the exchanged document be admitted` FALSE EQUALS JUST FALSE
#ASSERT `Can the exchanged document be admitted` TRUE EQUALS NOTHING

§§ `ss 29 to 31 -- sanctions and applications`

#ASSERT `Can the court make orders against me for a breach` TRUE EQUALS JUST TRUE
#ASSERT `Can the court make orders against me for a breach` FALSE EQUALS JUST FALSE
-- Arguments: party or interested, finalised, did not know until after, time extended.
#ASSERT `Can I still apply for orders for a breach` TRUE FALSE FALSE FALSE EQUALS JUST `I may apply now, before the proceeding is finalised`
#ASSERT `Can I still apply for orders for a breach` TRUE TRUE FALSE FALSE EQUALS JUST `out of time, and no extension can be granted because I knew of the contravention in time`
#ASSERT `Can I still apply for orders for a breach` TRUE TRUE FALSE TRUE EQUALS JUST `out of time, and no extension can be granted because I knew of the contravention in time`
#ASSERT `Can I still apply for orders for a breach` TRUE TRUE TRUE FALSE EQUALS JUST `out of time, but I may apply for an extension, which the court may grant because I did not know in time`
#ASSERT `Can I still apply for orders for a breach` TRUE TRUE TRUE TRUE EQUALS JUST `out of time, and the court has extended the time: I may apply`
#ASSERT `Can I still apply for orders for a breach` FALSE FALSE FALSE FALSE EQUALS NOTHING

§§ `s 3 -- substantive documents`

#ASSERT `Is my document a substantive document` `a writ with a statement of claim, or with a statement of the nature of the claim, its cause and the relief sought` EQUALS TRUE
#ASSERT `Is my document a substantive document` `a writ with neither` EQUALS FALSE
#ASSERT `Is my document a substantive document` `a defence or a notice of defence` EQUALS TRUE
#ASSERT `Is my document a substantive document` `a claim for contribution under Part IV of the Wrongs Act 1958, or a response to one` EQUALS TRUE
#ASSERT `Is my document a substantive document` `an application under section 93(4)(d) of the Transport Accident Act 1986, or a response to one` EQUALS TRUE
#ASSERT `Is my document a substantive document` `an affidavit, summons or application that commences the proceeding or is my first response in it` EQUALS TRUE
#ASSERT `Is my document a substantive document` `an affidavit, summons or application that does neither` EQUALS FALSE
#ASSERT `Is my document a substantive document` `a claim for preliminary discovery` EQUALS TRUE
#ASSERT `Is my document a substantive document` `an originating motion` EQUALS TRUE
#ASSERT `Is my document a substantive document` `an originating motion filed under Chapter III of the Rules of the Supreme Court` EQUALS FALSE
#ASSERT `Is my document a substantive document` `an application under section 299 of the Workplace Injury Rehabilitation and Compensation Act 2013` EQUALS FALSE
#ASSERT `Is my document a substantive document` `a process that commences an appeal, or the first response to an appeal` EQUALS FALSE
#ASSERT `Is my document a substantive document` `a summons for taxation of costs` EQUALS FALSE
#ASSERT `Is my document a substantive document` `any other document` EQUALS FALSE

