#ASSERT `Can they rely on the health and safety exception` `pregnancy` FALSE TRUE EQUALS JUST FALSE
#ASSERT `Can they rely on the health and safety exception` `age` TRUE TRUE EQUALS NOTHING

§§ `Part 3 -- positive duty; s 127 investigation`

#ASSERT `Does the positive duty bind them` TRUE EQUALS JUST TRUE
#ASSERT `Does the positive duty bind them` FALSE EQUALS NOTHING

#ASSERT `Can the Commission investigate` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- Only one person affected: (a)(ii) not met.
#ASSERT `Can the Commission investigate` TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Can the Commission investigate` TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE

§§ `Part 6 -- sexual harassment`

-- Remarks with sexual connotations from a co-worker (s 93(2)(a)).
#ASSERT `Was I sexually harassed in breach of the Act` `other unwelcome conduct of a sexual nature` TRUE `a person employed by my employer or by the employer I was seeking work from` EQUALS JUST TRUE
-- An unwelcome request by the employer (s 93(1)).
#ASSERT `Was I sexually harassed in breach of the Act` `an unwelcome request for sexual favours` TRUE `my employer or the employer I was seeking work from` EQUALS JUST TRUE
-- At a shared workplace with another firm's worker (s 94).
#ASSERT `Was I sexually harassed in breach of the Act` `an unwelcome sexual advance` TRUE `a person at a place that is a workplace of both of us` EQUALS JUST TRUE
-- A customer harassing a shop worker (s 99(2)).
#ASSERT `Was I sexually harassed in breach of the Act` `other unwelcome conduct of a sexual nature` TRUE `a person providing or offering goods or services to me, or receiving them from me` EQUALS JUST TRUE
-- A reasonable person would not have anticipated offence.
#ASSERT `Was I sexually harassed in breach of the Act` `an unwelcome sexual advance` FALSE `my employer or the employer I was seeking work from` EQUALS JUST FALSE
-- Welcome conduct.
#ASSERT `Was I sexually harassed in breach of the Act` `conduct that was welcome or not sexual` TRUE `my employer or the employer I was seeking work from` EQUALS JUST FALSE
-- Harassment outside every relationship Part 6 names.
#ASSERT `Was I sexually harassed in breach of the Act` `an unwelcome sexual advance` TRUE `someone in none of these relationships with me` EQUALS NOTHING

§§ `Part 7 -- victimisation, authorising, information, vicarious liability`

#ASSERT `Was I victimised` `brought a dispute to the Commission` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Was I victimised` `alleged that someone contravened the Act` TRUE TRUE FALSE EQUALS JUST TRUE
-- (g) "unless the allegation is false and was not made in good faith".
#ASSERT `Was I victimised` `alleged that someone contravened the Act` TRUE TRUE TRUE EQUALS JUST FALSE
-- The bad-faith proviso does not reach other heads.
#ASSERT `Was I victimised` `refused to do something that would contravene the Act` TRUE TRUE TRUE EQUALS JUST TRUE
-- Not a substantial reason; no detriment; none of the protected acts.
#ASSERT `Was I victimised` `gave evidence, information or a document in proceedings or a Commission investigation` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Was I victimised` `brought a dispute to the Commission` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Was I victimised` `none of these` TRUE TRUE FALSE EQUALS JUST FALSE

#ASSERT `Can I claim against the person who instructed or helped` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Can I claim against the person who instructed or helped` TRUE FALSE EQUALS NOTHING
#ASSERT `Can I claim against the person who instructed or helped` FALSE TRUE EQUALS JUST FALSE

#ASSERT `Was the request for my information unlawful` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Was the request for my information unlawful` TRUE TRUE EQUALS JUST FALSE
#ASSERT `Was the request for my information unlawful` FALSE FALSE EQUALS NOTHING
#ASSERT `Must they destroy my information` FALSE EQUALS JUST TRUE
#ASSERT `Must they destroy my information` TRUE EQUALS JUST FALSE
#ASSERT `Are they forbidden to pass my information on` FALSE EQUALS JUST TRUE
#ASSERT `Are they forbidden to pass my information on` TRUE EQUALS JUST FALSE

#ASSERT `Is the employer liable too` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Is the employer liable too` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Is the employer liable too` FALSE TRUE FALSE EQUALS JUST FALSE

§§ `Part 8 -- bringing a dispute or VCAT claim`

#ASSERT `Can I bring a dispute or VCAT claim` `discrimination under Part 4` `I am, about a contravention in relation to me` EQUALS JUST TRUE
#ASSERT `Can I bring a dispute or VCAT claim` `sexual harassment under Part 6` `a person I authorised, because my disability prevents me` EQUALS JUST TRUE
#ASSERT `Can I bring a dispute or VCAT claim` `victimisation or another contravention of Part 7` `my parent, because I am a child` EQUALS JUST TRUE
#ASSERT `Can I bring a dispute or VCAT claim` `vilification under Part 6A` `another person for me as a child, with consent the Commission or VCAT accepts` EQUALS JUST TRUE
#ASSERT `Can I bring a dispute or VCAT claim` `discrimination under Part 4` `another person for me as a child, without that consent` EQUALS JUST FALSE
#ASSERT `Can I bring a dispute or VCAT claim` `discrimination under Part 4` `another person for me, in none of these ways` EQUALS NOTHING
-- s 15(3): Part 8 does not apply to the positive duty.
#ASSERT `Can I bring a dispute or VCAT claim` `only a breach of the positive duty in section 15` `I am, about a contravention in relation to me` EQUALS JUST FALSE
#ASSERT `Can I bring a dispute or VCAT claim` `only an offence such as discriminatory advertising` `I am, about a contravention in relation to me` EQUALS NOTHING

-- s 116(a): contravention 1 March 2025. Brought 1 March 2026: exactly 12 months, not "more than".
#ASSERT `Is my dispute more than 12 months late` (`the calendar date` 1 3 2025) (`the calendar date` 1 3 2026) EQUALS JUST FALSE
-- Brought 2 March 2026: more than 12 months.
#ASSERT `Is my dispute more than 12 months late` (`the calendar date` 1 3 2025) (`the calendar date` 2 3 2026) EQUALS JUST TRUE
-- Brought 28 February 2026: within.
#ASSERT `Is my dispute more than 12 months late` (`the calendar date` 1 3 2025) (`the calendar date` 28 2 2026) EQUALS JUST FALSE
-- Leap day: contravention 29 February 2024; 12 months before 28 February 2025 is 28 February 2024 (not more); before
-- 1 March 2025 is 1 March 2024, after 29 February 2024 (more).
#ASSERT `Is my dispute more than 12 months late` (`the calendar date` 29 2 2024) (`the calendar date` 28 2 2025) EQUALS JUST FALSE
#ASSERT `Is my dispute more than 12 months late` (`the calendar date` 29 2 2024) (`the calendar date` 1 3 2025) EQUALS JUST TRUE

#ASSERT `Can the Commission decline my dispute` (`the calendar date` 1 3 2025) (`the calendar date` 2 3 2026) FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Can the Commission decline my dispute` (`the calendar date` 1 3 2025) (`the calendar date` 1 3 2026) FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Can the Commission decline my dispute` (`the calendar date` 1 3 2025) (`the calendar date` 1 6 2025) FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Can the Commission decline my dispute` (`the calendar date` 1 3 2025) (`the calendar date` 1 6 2025) FALSE FALSE FALSE TRUE EQUALS JUST TRUE

#ASSERT `Has dispute resolution ended` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Has dispute resolution ended` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Has dispute resolution ended` FALSE FALSE FALSE TRUE EQUALS NOTHING

#ASSERT `Can it be used as evidence` TRUE TRUE EQUALS JUST FALSE
#ASSERT `Can it be used as evidence` TRUE FALSE EQUALS NOTHING

-- s 119(3): agreement 1 May 2026. Day 30 after is 31 May 2026 (in time); 1 June 2026 is day 31 (too late).
#ASSERT `Is my request for a settlement record in time` (`the calendar date` 1 5 2026) TRUE (`the calendar date` 31 5 2026) (`the calendar date` 10 6 2026) EQUALS `made in time`
#ASSERT `Is my request for a settlement record in time` (`the calendar date` 1 5 2026) TRUE (`the calendar date` 1 6 2026) (`the calendar date` 10 6 2026) EQUALS `made too late`
#ASSERT `Is my request for a settlement record in time` (`the calendar date` 1 5 2026) TRUE (`the calendar date` 1 5 2026) (`the calendar date` 10 6 2026) EQUALS `made in time`
-- Not yet made: still open on 31 May 2026, closed on 1 June 2026.
#ASSERT `Is my request for a settlement record in time` (`the calendar date` 1 5 2026) FALSE (`the calendar date` 1 1 2026) (`the calendar date` 31 5 2026) EQUALS `still open`
#ASSERT `Is my request for a settlement record in time` (`the calendar date` 1 5 2026) FALSE (`the calendar date` 1 1 2026) (`the calendar date` 1 6 2026) EQUALS `made too late`
#ASSERT `Is my request for a settlement record in time` (`the calendar date` 1 5 2026) TRUE (`the calendar date` 30 4 2026) (`the calendar date` 10 6 2026) EQUALS `made before the agreement was reached`

#ASSERT `Must VCAT register my agreement` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Must VCAT register my agreement` TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `Must VCAT register my agreement` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Must VCAT register my agreement` TRUE TRUE FALSE FALSE EQUALS JUST FALSE

#ASSERT `May I apply for an interim order` TRUE FALSE EQUALS JUST TRUE
#ASSERT `May I apply for an interim order` TRUE TRUE EQUALS JUST FALSE
#ASSERT `May I apply for an interim order` FALSE FALSE EQUALS NOTHING

#ASSERT `Can VCAT order compensation` TRUE EQUALS JUST TRUE
#ASSERT `Can VCAT order compensation` FALSE EQUALS JUST FALSE

#ASSERT `Can the Commission enforce my order` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Can the Commission enforce my order` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Can the Commission enforce my order` TRUE FALSE TRUE EQUALS JUST FALSE
