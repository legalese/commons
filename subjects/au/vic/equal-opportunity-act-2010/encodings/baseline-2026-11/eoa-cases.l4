#ASSERT `Can they rely on the religious employment exception` TRUE `sexual orientation` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Can they rely on the religious employment exception` FALSE `religious belief or activity` TRUE TRUE TRUE EQUALS NOTHING

#ASSERT `Can they rely on the health and safety exception` `disability` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Can they rely on the health and safety exception` `physical features` FALSE TRUE EQUALS JUST TRUE
#ASSERT `Can they rely on the health and safety exception` `disability` FALSE FALSE EQUALS JUST FALSE
#ASSERT `Can they rely on the health and safety exception` `pregnancy` TRUE FALSE EQUALS JUST TRUE
