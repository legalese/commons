-- Cases for wirc-regs-seat.l4 (the worker's seat). Expected values are worked by hand from the deposited text of the
-- Regulations (S.R. No. 35/2024, version 001) and the 2013 Act; none is copied from the encoding's output.

IMPORT prelude
IMPORT `wirc-regs-seat`

§ `Regulation 8 — full-time worker`

-- No award: 35 hours a week (reg 8). 35 is the edge.
#ASSERT `Am I a full-time worker` FALSE 0 35
#ASSERT `Am I a full-time worker` FALSE 0 36
#ASSERT (NOT (`Am I a full-time worker` FALSE 0 34.5))
-- An award applies: its normal hours govern, above or below 35.
#ASSERT `Am I a full-time worker` TRUE 38 38
#ASSERT (NOT (`Am I a full-time worker` TRUE 38 37.5))
#ASSERT `Am I a full-time worker` TRUE 30 32
#ASSERT (NOT (`Am I a full-time worker` TRUE 40 36))

§ `Regulation 9 — which items of Schedule 2 describe a worker with two employers`

-- (a) no award; 40 hours in one job, 10 in the other: item 3 only (the second job is under 38).
#ASSERT `Which items of Schedule 2 describe me` FALSE 0 40 FALSE 0 10 FALSE EQUALS (LIST 3)
-- (b) no award; 38 hours in each (the edge): items 3 and 6.
#ASSERT `Which items of Schedule 2 describe me` FALSE 0 38 FALSE 0 38 FALSE EQUALS (LIST 3, 6)
-- (c) no award; 37 hours and 10 hours: a full-time worker under reg 8 (35), but under the 38 of reg 9: item 8.
#ASSERT `Which items of Schedule 2 describe me` FALSE 0 37 FALSE 0 10 FALSE EQUALS (LIST 8)
-- (d) award hours (38 of 38) in one job, 20 hours with no award in the other: item 2 only.
#ASSERT `Which items of Schedule 2 describe me` TRUE 38 38 FALSE 0 20 FALSE EQUALS (LIST 2)
-- (e) award hours in one job, 40 hours with no award in the other: items 2 and 5.
#ASSERT `Which items of Schedule 2 describe me` TRUE 38 38 FALSE 0 40 FALSE EQUALS (LIST 2, 5)
-- (f) award hours in both (38 of 38, 30 of 30): items 2 and 4, and 5 too (the first job's 38 hours meet reg 9).
#ASSERT `Which items of Schedule 2 describe me` TRUE 38 38 TRUE 30 30 FALSE EQUALS (LIST 2, 4, 5)
-- (g) part-time in both, injury stops one job only: item 7.
#ASSERT `Which items of Schedule 2 describe me` TRUE 38 20 FALSE 0 15 TRUE EQUALS (LIST 7)
-- (h) part-time in both, injury stops both: item 8.
#ASSERT `Which items of Schedule 2 describe me` TRUE 38 20 FALSE 0 15 FALSE EQUALS (LIST 8)
-- (i) an award applies to the second job but its hours are not met; 40 hours in the first: item 3 fails on the
-- worker reading of "to whom no industrial award is applicable" (fork F2), and item 5 needs award hours: item 8.
#ASSERT `Which items of Schedule 2 describe me` FALSE 0 40 TRUE 38 10 FALSE EQUALS (LIST 8)

§ `Regulation 9 — item 8 pre-injury average weekly earnings`

-- (h) 20 h at $600 + 15 h at $450 = $1,050 for 35 h, $30 an hour; lesser of 38 and 35 is 35: $1,050.
#ASSERT `What are my pre-injury average weekly earnings under item 8` TRUE 38 20 600 FALSE 0 15 450 FALSE EQUALS JUST 1050
-- (c) 37 h at $1,110 + 10 h at $250 = $1,360 for 47 h; lesser of 38 and 47 is 38: 1360 x 38 / 47 = 51680/47.
#ASSERT `What are my pre-injury average weekly earnings under item 8` FALSE 0 37 1110 FALSE 0 10 250 FALSE EQUALS JUST (51680 DIVIDED BY 47)
-- Exactly 38 hours in all (30 h at $900 + 8 h at $200, no award, neither job 38): $1,100.
#ASSERT `What are my pre-injury average weekly earnings under item 8` FALSE 0 30 900 FALSE 0 8 200 FALSE EQUALS JUST 1100
-- 39 hours in all (31 h at $930 + 8 h at $240 = $1,170, $30 an hour): 30 x 38 = $1,140.
#ASSERT `What are my pre-injury average weekly earnings under item 8` FALSE 0 31 930 FALSE 0 8 240 FALSE EQUALS JUST 1140
-- Item 5 applies (case e), so item 8 does not: no answer here.
#ASSERT `What are my pre-injury average weekly earnings under item 8` TRUE 38 38 1500 FALSE 0 40 1200 FALSE EQUALS NOTHING
-- Item 7 applies (case g): no answer here.
#ASSERT `What are my pre-injury average weekly earnings under item 8` TRUE 38 20 600 FALSE 0 15 450 TRUE EQUALS NOTHING
-- No hours at all: no hourly rate can be worked out.
#ASSERT `What are my pre-injury average weekly earnings under item 8` FALSE 0 0 0 FALSE 0 0 0 FALSE EQUALS NOTHING

§ `Regulation 10 — timber contractors`

-- $10,000 including materials, contractor buys them: 25% off, $7,500.
#ASSERT `How much of my timber contract payment is my remuneration` TRUE 10000 TRUE TRUE FALSE EQUALS JUST 7500
-- Provides own materials instead of buying: still $7,500.
#ASSERT `How much of my timber contract payment is my remuneration` TRUE 10000 TRUE FALSE TRUE EQUALS JUST 7500
-- The amount does not include materials: no percentage, the full $10,000.
#ASSERT `How much of my timber contract payment is my remuneration` TRUE 10000 FALSE TRUE TRUE EQUALS JUST 10000
-- Includes materials but the contractor neither buys nor provides them: the full $10,000.
#ASSERT `How much of my timber contract payment is my remuneration` TRUE 10000 TRUE FALSE FALSE EQUALS JUST 10000
-- Not deemed a worker under clause 6: clause 6(3) does not speak.
#ASSERT `How much of my timber contract payment is my remuneration` FALSE 10000 TRUE TRUE FALSE EQUALS NOTHING

§ `Regulation 11 and Schedule 2 — contractors' percentages`

#ASSERT `What percentage of my contract payments is not remuneration` `bricklayers` FALSE 0 TRUE TRUE FALSE EQUALS JUST (30%)
#ASSERT `What percentage of my contract payments is not remuneration` `resilient floor layers` FALSE 0 TRUE FALSE TRUE EQUALS JUST (37%)
#ASSERT `What percentage of my contract payments is not remuneration` `painters` FALSE 0 TRUE TRUE FALSE EQUALS JUST (15%)
#ASSERT `What percentage of my contract payments is not remuneration` `architects` FALSE 0 TRUE TRUE FALSE EQUALS JUST (5%)
#ASSERT `What percentage of my contract payments is not remuneration` `plasterers` FALSE 0 TRUE TRUE FALSE EQUALS JUST (20%)
#ASSERT `What percentage of my contract payments is not remuneration` `blind fitters` FALSE 0 TRUE TRUE FALSE EQUALS JUST (25%)
-- Building supervisors: own vehicle and more than 6 sites. 7 sites qualify; 6 do not; no vehicle does not.
#ASSERT `What percentage of my contract payments is not remuneration` `building supervisors` TRUE 7 TRUE TRUE FALSE EQUALS JUST (25%)
#ASSERT `What percentage of my contract payments is not remuneration` `building supervisors` TRUE 6 TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `What percentage of my contract payments is not remuneration` `building supervisors` FALSE 10 TRUE TRUE FALSE EQUALS NOTHING
-- Driving instructors: own vehicle only.
#ASSERT `What percentage of my contract payments is not remuneration` `driving instructors` TRUE 0 TRUE TRUE FALSE EQUALS JUST (30%)
#ASSERT `What percentage of my contract payments is not remuneration` `driving instructors` FALSE 0 TRUE TRUE FALSE EQUALS NOTHING
-- A kind of contract the Table does not name.
#ASSERT `What percentage of my contract payments is not remuneration` `another kind of service` FALSE 0 TRUE TRUE FALSE EQUALS NOTHING
-- A carpenter whose payments include no materials: reg 11(2)(a) fails.
#ASSERT `What percentage of my contract payments is not remuneration` `carpenters` FALSE 0 FALSE TRUE FALSE EQUALS NOTHING

§ `Regulation 11 — contractors' deemed remuneration`

-- Carpenter, $80,000, circumstances met: 25% off, $60,000.
#ASSERT `How much of my contract payment is my remuneration` TRUE 80000 `carpenters` FALSE 0 TRUE TRUE FALSE 0 EQUALS JUST 60000
-- Architect, $100,000: 5% off, $95,000.
#ASSERT `How much of my contract payment is my remuneration` TRUE 100000 `architects` FALSE 0 TRUE FALSE TRUE 0 EQUALS JUST 95000
-- A service the Table does not name, $50,000 with $8,000 not for labour: cl 9(5)(c)(ii), $42,000.
#ASSERT `How much of my contract payment is my remuneration` TRUE 50000 `another kind of service` FALSE 0 TRUE TRUE FALSE 8000 EQUALS JUST 42000
-- Carpenter, circumstances not met, $5,000 not for labour: $75,000.
#ASSERT `How much of my contract payment is my remuneration` TRUE 80000 `carpenters` FALSE 0 FALSE FALSE FALSE 5000 EQUALS JUST 75000
-- Building supervisor with own vehicle but only 6 sites, $60,000 with $12,000 not for labour: $48,000.
#ASSERT `How much of my contract payment is my remuneration` TRUE 60000 `building supervisors` TRUE 6 TRUE TRUE FALSE 12000 EQUALS JUST 48000
-- Not deemed a worker under clause 9.
#ASSERT `How much of my contract payment is my remuneration` FALSE 80000 `carpenters` FALSE 0 TRUE TRUE FALSE 0 EQUALS NOTHING

§ `Regulation 12 — a worker living outside Australia`

#ASSERT `Must I prove my identity and incapacity every 3 months` TRUE TRUE
#ASSERT (NOT (`Must I prove my identity and incapacity every 3 months` FALSE TRUE))
#ASSERT (NOT (`Must I prove my identity and incapacity every 3 months` TRUE FALSE))

#ASSERT `What must I do to prove my identity and incapacity` TRUE TRUE EQUALS (LIST "Complete a statement of identity in the form approved by the Authority (reg 12(2)(a)); the Authority publishes its approved forms on its website (reg 12(3)).", "Submit to an examination by a medical practitioner (reg 12(2)(b)).", "Obtain from the medical practitioner a certificate completed in the form approved by the Authority (reg 12(2)(c)).", "Submit the completed statement and the completed certificate to the Authority or self-insurer (reg 12(2)(d)).", "Do this at intervals of 3 months (reg 12(4)).")
#ASSERT `What must I do to prove my identity and incapacity` FALSE TRUE EQUALS EMPTY

-- 3 months after 15 January 2027 is 15 April 2027.
#ASSERT `By when must I next prove my identity and incapacity` TRUE TRUE (Date 15 1 2027) EQUALS JUST (Date 15 4 2027)
-- 3 months after 30 November 2026: February 2027 has 28 days, so 28 February 2027.
#ASSERT `By when must I next prove my identity and incapacity` TRUE TRUE (Date 30 11 2026) EQUALS JUST (Date 28 2 2027)
-- 3 months after 31 August 2027: November has 30 days, so 30 November 2027.
#ASSERT `By when must I next prove my identity and incapacity` TRUE TRUE (Date 31 8 2027) EQUALS JUST (Date 30 11 2027)
-- Living in Australia: the requirement does not apply.
#ASSERT `By when must I next prove my identity and incapacity` FALSE TRUE (Date 15 1 2027) EQUALS NOTHING

-- Interval from 1 March 2027; 3 months is 1 June 2027. All steps done and the Authority satisfied.
-- Submitted on the last day: entitled.
#ASSERT `Am I entitled to my weekly payments for this interval while overseas` TRUE TRUE (Date 1 3 2027) TRUE TRUE TRUE TRUE (Date 1 6 2027) TRUE EQUALS JUST TRUE
-- Submitted the next day: not entitled for the interval.
#ASSERT `Am I entitled to my weekly payments for this interval while overseas` TRUE TRUE (Date 1 3 2027) TRUE TRUE TRUE TRUE (Date 2 6 2027) TRUE EQUALS JUST FALSE
-- Submitted on the first day of the interval: entitled.
#ASSERT `Am I entitled to my weekly payments for this interval while overseas` TRUE TRUE (Date 1 3 2027) TRUE TRUE TRUE TRUE (Date 1 3 2027) TRUE EQUALS JUST TRUE
-- Submitted in time but without a medical examination: not in the prescribed manner.
#ASSERT `Am I entitled to my weekly payments for this interval while overseas` TRUE TRUE (Date 1 3 2027) TRUE FALSE TRUE TRUE (Date 1 5 2027) TRUE EQUALS JUST FALSE
-- Submitted in time but the statement was not on the approved form.
#ASSERT `Am I entitled to my weekly payments for this interval while overseas` TRUE TRUE (Date 1 3 2027) FALSE TRUE TRUE TRUE (Date 1 5 2027) TRUE EQUALS JUST FALSE
-- Submitted in time, all steps, but the Authority is not satisfied.
#ASSERT `Am I entitled to my weekly payments for this interval while overseas` TRUE TRUE (Date 1 3 2027) TRUE TRUE TRUE TRUE (Date 1 5 2027) FALSE EQUALS JUST FALSE
-- Not submitted.
#ASSERT `Am I entitled to my weekly payments for this interval while overseas` TRUE TRUE (Date 1 3 2027) TRUE TRUE TRUE FALSE (Date 1 5 2027) TRUE EQUALS JUST FALSE
-- A submission dated before the interval began does not count for it.
#ASSERT `Am I entitled to my weekly payments for this interval while overseas` TRUE TRUE (Date 1 3 2027) TRUE TRUE TRUE TRUE (Date 28 2 2027) TRUE EQUALS JUST FALSE
-- Living in Australia: s 175(4) does not speak.
#ASSERT `Am I entitled to my weekly payments for this interval while overseas` FALSE TRUE (Date 1 3 2027) TRUE TRUE TRUE TRUE (Date 1 5 2027) TRUE EQUALS NOTHING

§ `Regulation 6 — inquiries into fraud`

#ASSERT `How must an inquiry into me be conducted` TRUE EQUALS (LIST "With due care (reg 6(a)).", "Objectively (reg 6(b)).", "With regard for your legal rights as a person whose activities are being inquired into or investigated (reg 6(c)).")
#ASSERT `How must an inquiry into me be conducted` FALSE EQUALS EMPTY
