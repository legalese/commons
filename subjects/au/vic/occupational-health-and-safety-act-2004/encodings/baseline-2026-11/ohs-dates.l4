IMPORT prelude

-- Occupational Health and Safety Act 2004 (Vic) -- small date helpers for ohs-core.l4 and ohs-seat.l4. Built on the
-- stable prelude's date primitives (DATE_FROM_DMY, DATE_SERIAL, DATE_FROM_SERIAL, DATE_DAY, DATE_MONTH, DATE_YEAR);
-- the daydate library is not imported, and no YMD is defined.
--
-- READINGS (the Interpretation of Legislation Act 1984 (Vic) is not deposited, so these are the encoder's):
-- * "within 6 months of" or "within 3 months after" a day ends on the same day of the later month; "within 2 years
--   after" and "not more than 1 year after" the same way (24 and 12 months). The day of the event is excluded and the
--   corresponding day is the last day.
-- * A period of months that starts on a day the end month does not have (31 August + 6 months; 29 February + 12
--   months) ends on the last day of the end month (28 or 29 February).
-- * "at least 5 years" for keeping a record: 60 months from the day the record was given.
--
-- BASELINE. Not for public use as advice. See NOTES.md.

§ `Dates`

GIVEN `x` IS A NUMBER
      `y` IS A NUMBER
GIVETH A NUMBER
`the smaller of` `x` `and` `y` MEANS
    IF `x` AT MOST `y` THEN `x` ELSE `y`

GIVEN `y` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `is a leap year` `y` IF
        (`y` MODULO 4 EQUALS 0 AND (NOT (`y` MODULO 100 EQUALS 0)))
    OR  `y` MODULO 400 EQUALS 0

GIVEN `m` IS A NUMBER
      `y` IS A NUMBER
GIVETH A NUMBER
`the days in month` `m` `of` `y` MEANS
    IF `m` EQUALS 2
    THEN IF `is a leap year` `y` THEN 29 ELSE 28
    ELSE IF `m` EQUALS 4 OR `m` EQUALS 6 OR `m` EQUALS 9 OR `m` EQUALS 11
         THEN 30
         ELSE 31

-- The same day n months later, or the last day of that month where it is shorter.
GIVEN `n`         IS A NUMBER
      `the start` IS A DATE
GIVETH A DATE
`the day` `n` `months after` `the start` MEANS
    DATE_FROM_DMY (`the smaller of` (DATE_DAY `the start`) `and` (`the days in month` `end month` `of` `end year`)) `end month` `end year`
    WHERE
        `months counted from year 0` MEANS ((DATE_YEAR `the start`) TIMES 12) PLUS ((DATE_MONTH `the start`) MINUS 1) PLUS `n`
        `end year`  MEANS TRUNC (`months counted from year 0` DIVIDED BY 12) 0
        `end month` MEANS `months counted from year 0` MINUS (`end year` TIMES 12) PLUS 1

GIVEN `a` IS A DATE
      `b` IS A DATE
GIVETH A BOOLEAN
DECIDE `a` `is no later than` `b` IF DATE_SERIAL `a` AT MOST DATE_SERIAL `b`

GIVEN `a` IS A DATE
      `b` IS A DATE
GIVETH A BOOLEAN
DECIDE `a` `is after` `b` IF DATE_SERIAL `a` GREATER THAN DATE_SERIAL `b`

GIVEN `a` IS A DATE
      `b` IS A DATE
GIVETH A NUMBER
`the days from` `a` `to` `b` MEANS DATE_SERIAL `b` MINUS DATE_SERIAL `a`

GIVEN `a` IS A DATE
      `b` IS A DATE
GIVETH A DATE
`the later of` `a` `and` `b` MEANS
    IF `a` `is no later than` `b` THEN `b` ELSE `a`

#ASSERT DATE_SERIAL (`the day` 6 `months after` (DATE_FROM_DMY 31 8 2025)) EQUALS DATE_SERIAL (DATE_FROM_DMY 28 2 2026)
#ASSERT DATE_SERIAL (`the day` 12 `months after` (DATE_FROM_DMY 29 2 2024)) EQUALS DATE_SERIAL (DATE_FROM_DMY 28 2 2025)
#ASSERT DATE_SERIAL (`the day` 24 `months after` (DATE_FROM_DMY 15 11 2024)) EQUALS DATE_SERIAL (DATE_FROM_DMY 15 11 2026)
#ASSERT DATE_SERIAL (`the day` 3 `months after` (DATE_FROM_DMY 30 11 2025)) EQUALS DATE_SERIAL (DATE_FROM_DMY 28 2 2026)
