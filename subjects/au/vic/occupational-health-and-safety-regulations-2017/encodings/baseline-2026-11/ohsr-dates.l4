IMPORT prelude

-- Occupational Health and Safety Regulations 2017 (Vic) -- small date helpers for ohsr-core.l4 and ohsr-seat.l4.
-- Built on the stable prelude's date primitives (DATE_FROM_DMY, DATE_SERIAL, DATE_FROM_SERIAL, DATE_DAY, DATE_MONTH,
-- DATE_YEAR); the daydate library is not imported, and no YMD is defined.
--
-- READINGS (the Interpretation of Legislation Act 1984 (Vic) is not deposited, so these are the encoder's):
-- * "within 3 months after", "within one month after", "at least every 2 years", "at intervals of not more than 2 years",
--   "30 years" end on the same day of the later month; a period of months that starts on a day the end month does not
--   have (31 August + 6 months; 29 February + 24 months) ends on the last day of the end month.
-- * "within 7 days after" and "within 30 days after" a day: the day itself is excluded and the 7th or 30th day after it is
--   the last day; "6 weeks after" is the 42nd day after.
-- * "the 2-year anniversary of the commencement of the Occupational Health and Safety Amendment Regulations 2018": that
--   statutory rule (S.R. No. 71/2018) commenced on 5 June 2018 (endnotes), so the anniversary is 5 June 2020.
--
-- BASELINE. Not for public use as advice. See NOTES.md.

§ `Dates`

GIVEN `x` IS A NUMBER
      `y` IS A NUMBER
GIVETH A NUMBER
`the lesser of` `x` `and` `y` MEANS
    IF `x` AT MOST `y` THEN `x` ELSE `y`

GIVEN `y` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `is a leap year` `y` IF
        (`y` MODULO 4 EQUALS 0 AND (NOT (`y` MODULO 100 EQUALS 0)))
    OR  `y` MODULO 400 EQUALS 0

GIVEN `m` IS A NUMBER
      `y` IS A NUMBER
GIVETH A NUMBER
`the number of days in month` `m` `of` `y` MEANS
    IF `m` EQUALS 2
    THEN IF `is a leap year` `y` THEN 29 ELSE 28
    ELSE IF `m` EQUALS 4 OR `m` EQUALS 6 OR `m` EQUALS 9 OR `m` EQUALS 11
         THEN 30
         ELSE 31

-- The same day n months later, or the last day of that month where it is shorter.
GIVEN `n`         IS A NUMBER
      `the start` IS A DATE
GIVETH A DATE
`the date` `n` `months after` `the start` MEANS
    DATE_FROM_DMY (`the lesser of` (DATE_DAY `the start`) `and` (`the number of days in month` `end month` `of` `end year`)) `end month` `end year`
    WHERE
        `months counted from year 0` MEANS ((DATE_YEAR `the start`) TIMES 12) PLUS ((DATE_MONTH `the start`) MINUS 1) PLUS `n`
        `end year`  MEANS TRUNC (`months counted from year 0` DIVIDED BY 12) 0
        `end month` MEANS `months counted from year 0` MINUS (`end year` TIMES 12) PLUS 1

GIVEN `n`         IS A NUMBER
      `the start` IS A DATE
GIVETH A DATE
`the date` `n` `days after` `the start` MEANS
    DATE_FROM_SERIAL (DATE_SERIAL `the start` PLUS `n`)

GIVEN `a` IS A DATE
      `b` IS A DATE
GIVETH A BOOLEAN
DECIDE `a` `is on or before` `b` IF DATE_SERIAL `a` AT MOST DATE_SERIAL `b`

GIVEN `a` IS A DATE
      `b` IS A DATE
GIVETH A BOOLEAN
DECIDE `a` `is before` `b` IF DATE_SERIAL `a` LESS THAN DATE_SERIAL `b`

GIVEN `a` IS A DATE
      `b` IS A DATE
GIVETH A NUMBER
`the number of days from` `a` `to` `b` MEANS DATE_SERIAL `b` MINUS DATE_SERIAL `a`

-- The day the lead figures of S.R. No. 71/2018 take over (rr 186(1A), 193(2), 198(1A), 199(1A), 200(3), 201(3A)).
GIVETH A DATE
`the 2-year anniversary of S.R. No. 71/2018` MEANS DATE_FROM_DMY 5 6 2020

-- r 319Y (substituted by S.R. No. 63/2024, which commenced on 1 July 2024).
GIVETH A DATE
`the engineered stone prohibition day` MEANS DATE_FROM_DMY 1 7 2024

-- r 558(1): the earlier cost threshold for principal contractors applies to a contract entered into before this day.
GIVETH A DATE
`1 July 2014` MEANS DATE_FROM_DMY 1 7 2014

#ASSERT DATE_SERIAL (`the date` 3 `months after` (DATE_FROM_DMY 30 11 2025)) EQUALS DATE_SERIAL (DATE_FROM_DMY 28 2 2026)
#ASSERT DATE_SERIAL (`the date` 24 `months after` (DATE_FROM_DMY 29 2 2024)) EQUALS DATE_SERIAL (DATE_FROM_DMY 28 2 2026)
#ASSERT DATE_SERIAL (`the date` 1 `months after` (DATE_FROM_DMY 31 1 2026)) EQUALS DATE_SERIAL (DATE_FROM_DMY 28 2 2026)
#ASSERT DATE_SERIAL (`the date` 7 `days after` (DATE_FROM_DMY 28 12 2026)) EQUALS DATE_SERIAL (DATE_FROM_DMY 4 1 2027)
#ASSERT DATE_SERIAL (`the date` 42 `days after` (DATE_FROM_DMY 1 3 2026)) EQUALS DATE_SERIAL (DATE_FROM_DMY 12 4 2026)
#ASSERT `the number of days from` (DATE_FROM_DMY 1 11 2026) `to` (DATE_FROM_DMY 4 11 2026) EQUALS 3
