#ASSERT `Must my employer carry out air monitoring` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Must my employer carry out air monitoring` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Must my employer carry out air monitoring` FALSE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Must my employer carry out air monitoring` TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- rr 168, 171, 204, 263, 283, 313: 30 years, or the Authority's period (not over 30); 29 February 2028 + 30 years falls
-- in 2058, not a leap year: 28 February 2058.
#ASSERT DATE_SERIAL (`Until when must my health records be kept` (`on` 1 7 2026) FALSE 0) EQUALS `day` 1 7 2056
#ASSERT DATE_SERIAL (`Until when must my health records be kept` (`on` 1 7 2026) TRUE 10) EQUALS `day` 1 7 2036
#ASSERT DATE_SERIAL (`Until when must my health records be kept` (`on` 1 7 2026) TRUE 40) EQUALS `day` 1 7 2056
#ASSERT DATE_SERIAL (`Until when must my health records be kept` (`on` 29 2 2028) FALSE 0) EQUALS `day` 28 2 2058

