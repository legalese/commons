§§ `s 71 -- the agency's duty to answer`

-- The trace helper on its own: 14 days allowed.
#ASSERT `what became of the agency's duty to answer` 14 TRUE 14 20 EQUALS `in time`
#ASSERT `what became of the agency's duty to answer` 14 TRUE 15 20 EQUALS `late`
#ASSERT `what became of the agency's duty to answer` 14 TRUE 0 20 EQUALS `in time`
#ASSERT `what became of the agency's duty to answer` 14 FALSE 0 14 EQUALS `running`
#ASSERT `what became of the agency's duty to answer` 14 FALSE 0 15 EQUALS `late`

-- A request on 5 January 2026 with 14 days specified: the last day is 19 January 2026.
#ASSERT `By when must the agency answer the Inspectorate` (`d` 5 1 2026) 14 EQUALS `d` 19 1 2026
#ASSERT `By when must the agency answer the Inspectorate` (`d` 20 12 2025) 30 EQUALS `d` 19 1 2026
#ASSERT `Has the agency answered the Inspectorate in time` TRUE TRUE TRUE (`d` 5 1 2026) TRUE 14 TRUE (`d` 19 1 2026) (`d` 1 3 2026) EQUALS `in time`
#ASSERT `Has the agency answered the Inspectorate in time` TRUE TRUE TRUE (`d` 5 1 2026) TRUE 14 TRUE (`d` 20 1 2026) (`d` 1 3 2026) EQUALS `late`
#ASSERT `Has the agency answered the Inspectorate in time` TRUE TRUE TRUE (`d` 5 1 2026) TRUE 14 TRUE (`d` 5 1 2026) (`d` 1 3 2026) EQUALS `in time`
#ASSERT `Has the agency answered the Inspectorate in time` TRUE TRUE TRUE (`d` 5 1 2026) TRUE 14 FALSE `any day` (`d` 19 1 2026) EQUALS `running`
#ASSERT `Has the agency answered the Inspectorate in time` TRUE TRUE TRUE (`d` 5 1 2026) TRUE 14 FALSE `any day` (`d` 20 1 2026) EQUALS `late`
#ASSERT `Has the agency answered the Inspectorate in time` TRUE TRUE TRUE (`d` 5 1 2026) FALSE 0 FALSE `any day` (`d` 1 3 2026) EQUALS `no time`
#ASSERT `Has the agency answered the Inspectorate in time` TRUE TRUE FALSE (`d` 5 1 2026) TRUE 14 FALSE `any day` (`d` 1 3 2026) EQUALS `no duty`
#ASSERT `Has the agency answered the Inspectorate in time` FALSE TRUE TRUE (`d` 5 1 2026) TRUE 14 FALSE `any day` (`d` 1 3 2026) EQUALS `no duty`
#ASSERT `Has the agency answered the Inspectorate in time` TRUE FALSE TRUE (`d` 5 1 2026) TRUE 14 FALSE `any day` (`d` 1 3 2026) EQUALS `no duty`
#ASSERT `Has the agency answered the Inspectorate in time` TRUE TRUE TRUE (`d` 16 12 2025) TRUE 14 FALSE `any day` (`d` 1 3 2026) EQUALS `no duty`
#ASSERT `Has the agency answered the Inspectorate in time` TRUE TRUE TRUE (`d` 17 12 2025) TRUE 14 TRUE (`d` 31 12 2025) (`d` 1 3 2026) EQUALS `in time`
#ASSERT `Has the agency answered the Inspectorate in time` TRUE TRUE TRUE (`d` 17 12 2025) TRUE 14 TRUE (`d` 1 1 2026) (`d` 1 3 2026) EQUALS `late`

