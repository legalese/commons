#ASSERT `Is it detriment under s 69A` `injury` EQUALS JUST TRUE
#ASSERT `Is it detriment under s 69A` `harassment` EQUALS JUST TRUE
#ASSERT `Is it detriment under s 69A` `ostracism` EQUALS JUST TRUE
#ASSERT `Is it detriment under s 69A` `damage to or loss of property` EQUALS JUST TRUE
#ASSERT `Is it detriment under s 69A` `adverse treatment` EQUALS JUST FALSE
#ASSERT `Is it detriment under s 69A` `dismissal` EQUALS JUST FALSE
#ASSERT `Is it detriment under s 69A` `discipline` EQUALS JUST FALSE
#ASSERT `Is it detriment under s 69A` `some other harm` EQUALS NOTHING

#ASSERT `Did they threaten to cause me detriment` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Did they threaten to cause me detriment` FALSE TRUE EQUALS JUST TRUE
#ASSERT `Did they threaten to cause me detriment` FALSE FALSE EQUALS JUST FALSE

