#ASSERT `Is it an offence to do this to me because I complained` (`d` 16 12 2025) `harassment` `done` FALSE FALSE `complained` TRUE EQUALS JUST FALSE
#ASSERT `Is it an offence to do this to me because I complained` (`d` 1 2 2026) `injury` `done` FALSE FALSE `gave info` TRUE EQUALS JUST TRUE
#ASSERT `Is it an offence to do this to me because I complained` (`d` 1 2 2026) `ostracism` `done` FALSE FALSE `considering` TRUE EQUALS JUST TRUE
#ASSERT `Is it an offence to do this to me because I complained` (`d` 1 2 2026) `damage to or loss of property` `done` FALSE FALSE `may give info` TRUE EQUALS JUST TRUE
#ASSERT `Is it an offence to do this to me because I complained` (`d` 1 2 2026) `harassment` `done` FALSE FALSE `took part` TRUE EQUALS JUST TRUE
#ASSERT `Is it an offence to do this to me because I complained` (`d` 1 2 2026) `harassment` `done` FALSE FALSE `may take part` TRUE EQUALS JUST TRUE
-- Dismissed for complaining: not detriment under s 69A (other law may protect the worker).
#ASSERT `Is it an offence to do this to me because I complained` (`d` 1 2 2026) `dismissal` `done` FALSE FALSE `complained` TRUE EQUALS JUST FALSE
#ASSERT `Is it an offence to do this to me because I complained` (`d` 1 2 2026) `adverse treatment` `done` FALSE FALSE `complained` TRUE EQUALS JUST FALSE
#ASSERT `Is it an offence to do this to me because I complained` (`d` 1 2 2026) `discipline` `threatened` TRUE FALSE `complained` TRUE EQUALS JUST FALSE
-- Threats.
#ASSERT `Is it an offence to do this to me because I complained` (`d` 1 2 2026) `injury` `threatened` TRUE FALSE `complained` TRUE EQUALS JUST TRUE
#ASSERT `Is it an offence to do this to me because I complained` (`d` 1 2 2026) `injury` `threatened` FALSE TRUE `complained` TRUE EQUALS JUST TRUE
#ASSERT `Is it an offence to do this to me because I complained` (`d` 1 2 2026) `injury` `threatened` FALSE FALSE `complained` TRUE EQUALS JUST FALSE
-- Outside the prohibition's own words.
#ASSERT `Is it an offence to do this to me because I complained` (`d` 1 2 2026) `injury` `neither` FALSE FALSE `complained` TRUE EQUALS NOTHING
#ASSERT `Is it an offence to do this to me because I complained` (`d` 1 2 2026) `injury` `done` FALSE FALSE `nothing known` TRUE EQUALS NOTHING
#ASSERT `Is it an offence to do this to me because I complained` (`d` 1 2 2026) `injury` `done` FALSE FALSE `complained` FALSE EQUALS NOTHING
#ASSERT `Is it an offence to do this to me because I complained` (`d` 1 2 2026) `some other harm` `done` FALSE FALSE `complained` TRUE EQUALS NOTHING

