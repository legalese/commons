IMPORT prelude
IMPORT `gp-dates`
IMPORT `gp-part4a`
IMPORT `gp-seat`

-- Supreme Court Act 1986 (Vic), Part 4A -- worked cases for the group member's questions (gp-seat.l4) and the date helpers
-- (gp-dates.l4). Every expected value was worked by hand from the deposited text; none was copied from the encoding's output.
-- Each assertion is a claim about the ENCODING on stated facts, not about the law. The facts are illustrative.
-- BASELINE ENCODING. Not for public use as advice. See NOTES.md.

§ `cases`

`d` MEANS `the calendar date`

§§ `Dates`

-- 6 months on: 15 July 2026 -> 15 January 2027; 31 August 2026 -> 28 February 2027 (no 31 February: last day, fork F7);
-- 30 August 2027 -> 29 February 2028 (a leap year); 31 October 2026 -> 30 April 2027.
#ASSERT `the date` 6 `months after` (`d` 15 7 2026) EQUALS `d` 15 1 2027
#ASSERT `the date` 6 `months after` (`d` 31 8 2026) EQUALS `d` 28 2 2027
#ASSERT `the date` 6 `months after` (`d` 30 8 2027) EQUALS `d` 29 2 2028
#ASSERT `the date` 6 `months after` (`d` 31 10 2026) EQUALS `d` 30 4 2027
#ASSERT `the date` 6 `months after` (`d` 1 12 2026) EQUALS `d` 1 6 2027
#ASSERT `the date` 21 `days after` (`d` 15 12 2026) EQUALS `d` 5 1 2027
#ASSERT `the days from` (`d` 1 1 2026) `to` (`d` 1 3 2026) EQUALS 59

§§ `s 33B, 33C, 33G -- can the claim be brought as a group proceeding`

-- Arguments: persons with claims, same circumstances, common question, kind, cross-vesting only.
#ASSERT `Can my claim be brought as a group proceeding` 7 TRUE TRUE `a claim of any other kind` FALSE EQUALS JUST TRUE
#ASSERT `Can my claim be brought as a group proceeding` 6 TRUE TRUE `a claim of any other kind` FALSE EQUALS JUST FALSE
#ASSERT `Can my claim be brought as a group proceeding` 1000 TRUE TRUE `a claim of any other kind` FALSE EQUALS JUST TRUE
#ASSERT `Can my claim be brought as a group proceeding` 7 FALSE TRUE `a claim of any other kind` FALSE EQUALS JUST FALSE
#ASSERT `Can my claim be brought as a group proceeding` 7 TRUE FALSE `a claim of any other kind` FALSE EQUALS JUST FALSE
#ASSERT `Can my claim be brought as a group proceeding` 50 TRUE TRUE `a proceeding concerning property subject to a trust` FALSE EQUALS JUST FALSE
#ASSERT `Can my claim be brought as a group proceeding` 50 TRUE TRUE `a proceeding concerning the administration of the estate of a deceased person` FALSE EQUALS JUST FALSE
#ASSERT `Can my claim be brought as a group proceeding` 50 TRUE TRUE `a proceeding under sections 34 and 35` FALSE EQUALS JUST FALSE
#ASSERT `Can my claim be brought as a group proceeding` 50 TRUE TRUE `a proceeding commenced under Order 18 of Chapter I of the Rules` FALSE EQUALS JUST FALSE
#ASSERT `Can my claim be brought as a group proceeding` 50 TRUE TRUE `a claim of any other kind` TRUE EQUALS JUST FALSE

§§ `s 33A, 33E, 33J, 33KA -- am I a group member`

-- Arguments: within the group, public person, written consent, opted out, reinstated, excluded by the Court.
#ASSERT `Am I a group member` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Am I a group member` FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Am I a group member` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Am I a group member` TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Am I a group member` TRUE FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Am I a group member` TRUE FALSE FALSE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Am I a group member` TRUE FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE

§§ `s 33J -- opting out`

-- "before the date so fixed": the last day is the day before.
#ASSERT `What is the last day I can opt out` (`d` 15 3 2027) EQUALS `d` 14 3 2027
#ASSERT `What is the last day I can opt out` (`d` 1 3 2027) EQUALS `d` 28 2 2027
#ASSERT `What is the last day I can opt out` (`d` 1 3 2028) EQUALS `d` 29 2 2028
#ASSERT `What is the last day I can opt out` (`d` 1 1 2027) EQUALS `d` 31 12 2026
#ASSERT `Can I still opt out today` (`d` 15 3 2027) (`d` 14 3 2027) EQUALS JUST TRUE
#ASSERT `Can I still opt out today` (`d` 15 3 2027) (`d` 15 3 2027) EQUALS JUST FALSE
#ASSERT `Can I still opt out today` (`d` 15 3 2027) (`d` 1 1 2027) EQUALS JUST TRUE
#ASSERT `Can I still opt out today` (`d` 15 3 2027) (`d` 16 3 2027) EQUALS JUST FALSE

§§ `s 33K -- a cause of action that accrued after commencement`

-- Arguments: leave, day accrued, day commenced (1 June 2026), date fixed with leave (1 October 2026), would have been included.
#ASSERT `Can the group be altered to include me` TRUE (`d` 1 8 2026) (`d` 1 6 2026) (`d` 1 10 2026) TRUE EQUALS JUST TRUE
#ASSERT `Can the group be altered to include me` TRUE (`d` 30 9 2026) (`d` 1 6 2026) (`d` 1 10 2026) TRUE EQUALS JUST TRUE
#ASSERT `Can the group be altered to include me` TRUE (`d` 1 10 2026) (`d` 1 6 2026) (`d` 1 10 2026) TRUE EQUALS JUST FALSE
#ASSERT `Can the group be altered to include me` FALSE (`d` 1 8 2026) (`d` 1 6 2026) (`d` 1 10 2026) TRUE EQUALS JUST FALSE
#ASSERT `Can the group be altered to include me` TRUE (`d` 1 8 2026) (`d` 1 6 2026) (`d` 1 10 2026) FALSE EQUALS JUST FALSE
#ASSERT `Can the group be altered to include me` TRUE (`d` 1 6 2026) (`d` 1 6 2026) (`d` 1 10 2026) TRUE EQUALS NOTHING
#ASSERT `Can the group be altered to include me` TRUE (`d` 2 6 2026) (`d` 1 6 2026) (`d` 1 10 2026) TRUE EQUALS JUST TRUE

