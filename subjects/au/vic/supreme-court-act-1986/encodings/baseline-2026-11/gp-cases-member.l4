#ASSERT `May I appeal for the group today` (`d` 28 1 2027) FALSE (`d` 29 1 2027) EQUALS JUST TRUE
#ASSERT `May I appeal for the group today` (`d` 28 1 2027) FALSE (`d` 18 2 2027) EQUALS JUST TRUE
