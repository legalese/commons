#ASSERT `May the group proceeding be settled` FALSE EQUALS JUST FALSE

§§ `s 33ZG -- a step by a date`

-- Order 1 March 2027, date 31 May 2027 (91 days on).
#ASSERT `Where do I stand on the step the Court set` (`d` 1 3 2027) (`d` 31 5 2027) TRUE (`d` 31 5 2027) (`d` 10 6 2027) EQUALS `done in time`
#ASSERT `Where do I stand on the step the Court set` (`d` 1 3 2027) (`d` 31 5 2027) TRUE (`d` 1 3 2027) (`d` 10 6 2027) EQUALS `done in time`
#ASSERT `Where do I stand on the step the Court set` (`d` 1 3 2027) (`d` 31 5 2027) TRUE (`d` 1 6 2027) (`d` 10 6 2027) EQUALS `not done in time`
#ASSERT `Where do I stand on the step the Court set` (`d` 1 3 2027) (`d` 31 5 2027) FALSE (`d` 1 1 2000) (`d` 31 5 2027) EQUALS `still open`
#ASSERT `Where do I stand on the step the Court set` (`d` 1 3 2027) (`d` 31 5 2027) FALSE (`d` 1 1 2000) (`d` 1 6 2027) EQUALS `not done in time`
#ASSERT `Where do I stand on the step the Court set` (`d` 1 3 2027) (`d` 31 5 2027) FALSE (`d` 1 1 2000) (`d` 15 4 2027) EQUALS `still open`

§§ `s 33ZA -- the fund`

#ASSERT `What is the earliest last day for fund claims` (`d` 1 2 2027) EQUALS `d` 1 8 2027
#ASSERT `What is the earliest last day for fund claims` (`d` 31 8 2026) EQUALS `d` 28 2 2027

-- Order 1 February 2027, day fixed 1 August 2027. Arguments: order, day fixed, claim made, day of claim, today, fully
-- distributed, late claim allowed.
#ASSERT `Is my fund claim in time or allowed` (`d` 1 2 2027) (`d` 1 8 2027) TRUE (`d` 1 8 2027) (`d` 1 9 2027) FALSE FALSE EQUALS JUST TRUE
#ASSERT `Is my fund claim in time or allowed` (`d` 1 2 2027) (`d` 1 8 2027) TRUE (`d` 2 8 2027) (`d` 1 9 2027) FALSE TRUE EQUALS JUST TRUE
#ASSERT `Is my fund claim in time or allowed` (`d` 1 2 2027) (`d` 1 8 2027) TRUE (`d` 2 8 2027) (`d` 1 9 2027) FALSE FALSE EQUALS JUST FALSE
#ASSERT `Is my fund claim in time or allowed` (`d` 1 2 2027) (`d` 1 8 2027) TRUE (`d` 2 8 2027) (`d` 1 9 2027) TRUE TRUE EQUALS JUST FALSE
#ASSERT `Is my fund claim in time or allowed` (`d` 1 2 2027) (`d` 1 8 2027) FALSE (`d` 1 1 2000) (`d` 1 8 2027) FALSE FALSE EQUALS JUST TRUE
#ASSERT `Is my fund claim in time or allowed` (`d` 1 2 2027) (`d` 1 8 2027) FALSE (`d` 1 1 2000) (`d` 2 8 2027) FALSE FALSE EQUALS JUST FALSE

