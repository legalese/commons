#ASSERT `Am I bound by the judgment` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Am I bound by the judgment` TRUE TRUE EQUALS JUST FALSE
#ASSERT `Am I bound by the judgment` FALSE FALSE EQUALS NOTHING

