#ASSERT `Must I be given notice` `an offer to compromise the proceeding` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Must I be given notice` `an application for the Court's approval of a settlement or discontinuance` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
