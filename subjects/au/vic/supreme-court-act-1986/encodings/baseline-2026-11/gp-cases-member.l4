-- Arguments: under 18, incapable, taking a step.
#ASSERT `Must I act through a litigation guardian` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Must I act through a litigation guardian` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Must I act through a litigation guardian` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Must I act through a litigation guardian` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Must I act through a litigation guardian` FALSE FALSE TRUE EQUALS NOTHING

§§ `s 33ZE -- the limitation period`

-- Commenced 1 January 2026; last day otherwise 10 January 2027; opted out 1 March 2026: suspended 59 days (31 + 28), so the
-- new last day is 10 January 2027 + 59 = 10 March 2027 (21 days to 31 January, 28 in February, 10 in March).
#ASSERT `What happens to my time limit` TRUE (`d` 1 1 2026) (`d` 10 1 2027) TRUE (`d` 1 3 2026) FALSE (`d` 1 1 2000) EQUALS `running again (s 33ZE(2)), with a new last day` (`d` 10 3 2027)
-- Commenced 1 July 2025; last day otherwise 30 June 2026 (364 days left); proceeding and appeals end on 1 July 2028 without
-- deciding the claim: 1 July 2028 + 364 = 30 June 2029 (the 1,096 days suspended include 29 February 2028).
#ASSERT `What happens to my time limit` TRUE (`d` 1 7 2025) (`d` 30 6 2026) FALSE (`d` 1 1 2000) TRUE (`d` 1 7 2028) EQUALS `running again (s 33ZE(2)), with a new last day` (`d` 30 6 2029)
-- The last day falls on the day of commencement: suspended with nothing left after it; opting out ten days later gives
-- 11 January 2026.
#ASSERT `What happens to my time limit` TRUE (`d` 1 1 2026) (`d` 1 1 2026) TRUE (`d` 11 1 2026) FALSE (`d` 1 1 2000) EQUALS `running again (s 33ZE(2)), with a new last day` (`d` 11 1 2026)
-- The last day was the day before commencement: already ended.
#ASSERT `What happens to my time limit` TRUE (`d` 1 1 2026) (`d` 31 12 2025) TRUE (`d` 11 1 2026) FALSE (`d` 1 1 2000) EQUALS `it had already ended before the group proceeding was commenced`
-- Neither opted out nor ended: suspended.
#ASSERT `What happens to my time limit` TRUE (`d` 1 1 2026) (`d` 10 1 2027) FALSE (`d` 1 1 2000) FALSE (`d` 1 1 2000) EQUALS `suspended, and not yet running again (s 33ZE(2))`
-- Not a claim the proceeding relates to.
#ASSERT `What happens to my time limit` FALSE (`d` 1 1 2026) (`d` 10 1 2027) FALSE (`d` 1 1 2000) FALSE (`d` 1 1 2000) EQUALS `not suspended by s 33ZE: my claim is not one the group proceeding relates to`

§§ `s 33Q(3), 33R(2), 33ZD, 33ZDA -- costs`

-- Arguments: sub-group representative, individual question, group costs order.
#ASSERT `What costs can I be made to pay` FALSE FALSE FALSE EQUALS EMPTY
#ASSERT `What costs can I be made to pay` TRUE FALSE FALSE EQUALS LIST `the costs of deciding the sub-group's common questions, as sub-group representative party (s 33Q(3))`
#ASSERT `What costs can I be made to pay` FALSE TRUE FALSE EQUALS LIST `the costs of deciding the question that relates only to my claim (s 33R(2))`
#ASSERT `What costs can I be made to pay` FALSE FALSE TRUE EQUALS LIST `a share of the legal costs of the law practice under the group costs order (s 33ZDA(1)(b))`
#ASSERT `What costs can I be made to pay` TRUE TRUE TRUE EQUALS LIST `the costs of deciding the sub-group's common questions, as sub-group representative party (s 33Q(3))`, `the costs of deciding the question that relates only to my claim (s 33R(2))`, `a share of the legal costs of the law practice under the group costs order (s 33ZDA(1)(b))`

-- 25% of a $10,000,000 settlement is $2,500,000; 24.5% of $1,000,000 is $245,000; nothing recovered, nothing payable.
#ASSERT `What are the legal costs under the group costs order` TRUE 25 10000000 EQUALS JUST 2500000
#ASSERT `What are the legal costs under the group costs order` TRUE 24.5 1000000 EQUALS JUST 245000
#ASSERT `What are the legal costs under the group costs order` TRUE 25 0 EQUALS JUST 0
#ASSERT `What are the legal costs under the group costs order` FALSE 25 10000000 EQUALS NOTHING

-- 25% of my $40,000: $10,000 in costs, $30,000 kept.
#ASSERT `How much of my recovery goes in legal costs` TRUE 25 TRUE 40000 EQUALS JUST (`My share under a group costs order` WITH `the legal costs I bear` IS 10000, `what I keep` IS 30000)
#ASSERT `How much of my recovery goes in legal costs` TRUE 25 FALSE 40000 EQUALS NOTHING
#ASSERT `How much of my recovery goes in legal costs` FALSE 25 TRUE 40000 EQUALS NOTHING

#ASSERT `Who pays the defendant's costs` TRUE EQUALS `the law practice representing the plaintiff and group members, which must also give any security for costs ordered (s 33ZDA(2))`
#ASSERT `Who pays the defendant's costs` FALSE EQUALS `the plaintiff, if the Court so orders (s 33ZD(1)(a))`

-- s 33ZJ: $500,000 incurred, $350,000 recoverable: at most $150,000.
#ASSERT `How much of the damages may go to the plaintiff's costs` TRUE TRUE 500000 350000 EQUALS 150000
#ASSERT `How much of the damages may go to the plaintiff's costs` TRUE FALSE 500000 350000 EQUALS 0
#ASSERT `How much of the damages may go to the plaintiff's costs` FALSE TRUE 500000 350000 EQUALS 0
#ASSERT `How much of the damages may go to the plaintiff's costs` TRUE TRUE 300000 350000 EQUALS 0

