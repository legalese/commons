#ASSERT `Can I be paid special financial assistance` `an assault` TRUE TRUE `physical` TRUE `category A` FALSE FALSE FALSE 1000 10000 EQUALS `eligible, but the decision maker is not yet satisfied of any significant adverse effect`
-- s 9(5): grief or distress only is enough for special financial assistance.
#ASSERT `Can I be paid special financial assistance` `a sexual offence` TRUE TRUE `grief or distress only` TRUE `category B` FALSE TRUE FALSE 2000 20000 EQUALS `the prescribed minimum for the category` 2000
#ASSERT `Can I be paid special financial assistance` `an assault` TRUE TRUE `physical` TRUE `not in a prescribed category` FALSE TRUE TRUE 1000 10000 EQUALS `no special financial assistance under s 11`
#ASSERT `Can I be paid special financial assistance` `an assault` TRUE TRUE `physical` TRUE `category A` TRUE TRUE TRUE 1000 10000 EQUALS `no special financial assistance under s 11`
#ASSERT `Can I be paid special financial assistance` `an assault` FALSE TRUE `physical` TRUE `category A` FALSE TRUE TRUE 1000 10000 EQUALS `no special financial assistance under s 11`
#ASSERT `Can I be paid special financial assistance` `an assault` TRUE TRUE `harm arising only from loss of or damage to property` TRUE `category A` FALSE TRUE TRUE 1000 10000 EQUALS `no special financial assistance under s 11`
#ASSERT `Can I be paid special financial assistance` `an assault` TRUE FALSE `physical` TRUE `category A` FALSE TRUE TRUE 1000 10000 EQUALS `no special financial assistance under s 11`
#ASSERT `Can I be paid special financial assistance` `an assault` TRUE TRUE `physical` FALSE `category D` FALSE TRUE TRUE 1000 10000 EQUALS `no special financial assistance under s 11`

§§ `s 72 -- indexation`

-- 60000 x 140 / 136 = 61764.70588... -> 61764.7059 -> 61765.
#ASSERT `What is the indexed maximum this year` 60000 60000 140 136 EQUALS 61765
-- A fall: 60000 x 135 / 136 = 59558.82... -> 59559, which does not take effect: 60000 (s 72(3)(a)).
#ASSERT `s 72(1), (2) -- the calculated amount` 60000 135 136 EQUALS 59559
#ASSERT `What is the indexed maximum this year` 60000 60000 135 136 EQUALS 60000
-- The next year P is the unreduced 59559: 59559 x 140 / 135 = 61764.888... -> 61765 (s 72(3)(b)).
#ASSERT `What is the indexed maximum this year` 59559 60000 140 135 EQUALS 61765
-- A calculation that ends in 5 rounds up: 20000 x 100.0025 / 100 = 20000.5 -> 20001.
#ASSERT `What is the indexed maximum this year` 20000 20000 100.0025 100 EQUALS 20001
#ASSERT `s 72(1), (2) -- the calculated amount` 50000 101 100 EQUALS 50500
-- Fork F9: 100 x 100.49996 / 100 = 100.49996 -> 100.5000 at 4 places -> 101 (direct rounding would give 100).
#ASSERT `s 72(1), (2) -- the calculated amount` 100 100.49996 100 EQUALS 101

§§ `s 23 -- the time for applying`

-- Arguments: who, day of the crime, day of the death, date of birth, child abuse, family violence, sexual offence,
-- counselling only prescribed.
#ASSERT `By when must I apply` `a primary victim` (`d` 10 3 2025) (`d` 10 3 2025) (`d` 1 1 1990) FALSE FALSE FALSE FALSE EQUALS `by the end of` (`d` 10 3 2028) "s 23(1)"
#ASSERT `By when must I apply` `a secondary victim` (`d` 10 3 2025) (`d` 10 3 2025) (`d` 1 1 1990) FALSE FALSE FALSE FALSE EQUALS `by the end of` (`d` 10 3 2028) "s 23(1)"
#ASSERT `By when must I apply` `a related victim` (`d` 10 3 2025) (`d` 20 5 2025) (`d` 1 1 1990) FALSE FALSE FALSE FALSE EQUALS `by the end of` (`d` 20 5 2028) "s 23(1)"
-- Finding 4: the funeral expense payer is not a "victim", so (2) to (5) do not reach them.
#ASSERT `By when must I apply` `the person who incurred the funeral expenses` (`d` 10 3 2025) (`d` 20 5 2025) (`d` 1 6 2010) TRUE TRUE TRUE TRUE EQUALS `by the end of` (`d` 20 5 2028) "s 23(1)(b)"
-- A child of 14: 3 years after turning 18 (1 June 2031) is later than 10 March 2028.
#ASSERT `By when must I apply` `a primary victim` (`d` 10 3 2025) (`d` 10 3 2025) (`d` 1 6 2010) FALSE FALSE FALSE FALSE EQUALS `by the end of` (`d` 1 6 2031) "s 23(1), (2)"
#ASSERT `By when must I apply` `a primary victim` (`d` 10 3 2025) (`d` 10 3 2025) (`d` 1 6 2010) FALSE TRUE FALSE FALSE EQUALS `at any time` "s 23(3)"
#ASSERT `By when must I apply` `a secondary victim` (`d` 10 3 2025) (`d` 10 3 2025) (`d` 1 6 2010) TRUE FALSE FALSE FALSE EQUALS `at any time` "s 23(3)"
-- A child sexual offence without child abuse or family violence: s 23(2), not (3) or (4).
#ASSERT `By when must I apply` `a primary victim` (`d` 10 3 2025) (`d` 10 3 2025) (`d` 1 6 2010) FALSE FALSE TRUE FALSE EQUALS `by the end of` (`d` 1 6 2031) "s 23(1), (2)"
#ASSERT `By when must I apply` `a primary victim` (`d` 10 3 2025) (`d` 10 3 2025) (`d` 1 1 1990) FALSE FALSE TRUE FALSE EQUALS `by the end of` (`d` 10 3 2035) "s 23(1), (4)"
#ASSERT `By when must I apply` `a primary victim` (`d` 10 3 2025) (`d` 10 3 2025) (`d` 1 1 1990) FALSE TRUE FALSE FALSE EQUALS `by the end of` (`d` 10 3 2035) "s 23(1), (4)"
#ASSERT `By when must I apply` `a primary victim` (`d` 10 3 2025) (`d` 10 3 2025) (`d` 1 1 1990) TRUE FALSE FALSE FALSE EQUALS `by the end of` (`d` 10 3 2028) "s 23(1)"
#ASSERT `By when must I apply` `a primary victim` (`d` 10 3 2025) (`d` 10 3 2025) (`d` 1 1 1990) FALSE FALSE FALSE TRUE EQUALS `at any time` "s 23(5) and the regulations"
-- Turning 18 on the day of the crime is not "under the age of 18"; a birthday one day later is.
#ASSERT `By when must I apply` `a primary victim` (`d` 10 3 2025) (`d` 10 3 2025) (`d` 10 3 2007) FALSE FALSE FALSE FALSE EQUALS `by the end of` (`d` 10 3 2028) "s 23(1)"
#ASSERT `By when must I apply` `a primary victim` (`d` 10 3 2025) (`d` 10 3 2025) (`d` 11 3 2007) FALSE FALSE FALSE FALSE EQUALS `by the end of` (`d` 11 3 2028) "s 23(1), (2)"
-- Fork F5: an adult related victim of family violence whose family member died years later keeps the longer s 23(1)(b) time.
#ASSERT `By when must I apply` `a related victim` (`d` 1 1 2020) (`d` 1 6 2029) (`d` 1 1 1990) FALSE TRUE FALSE FALSE EQUALS `by the end of` (`d` 1 6 2032) "s 23(1), (4)"
#ASSERT `By when must I apply` `a primary victim` (`d` 29 2 2024) (`d` 29 2 2024) (`d` 1 1 1990) FALSE FALSE FALSE FALSE EQUALS `by the end of` (`d` 28 2 2027) "s 23(1)"

