IMPORT prelude
IMPORT `cor-dates`
IMPORT `cor-rules`
IMPORT `cor-seat`

-- Coroners Act 2008 (Vic) -- worked cases for the family's questions (cor-seat.l4) and the date helpers (cor-dates.l4).
-- Every expected value was worked by hand from the deposited text; none was copied from the encoding's output. Each
-- assertion is a claim about the ENCODING on stated facts, not about the law. The facts are illustrative.
-- BASELINE ENCODING. Not for public use as advice. See NOTES.md.

§ `cases`

`d` MEANS `the calendar date`
`none` MEANS `not in custody or care`
`police` MEANS `in the custody of a police officer`

§§ `Dates`

-- 3 months after 30 November 2026 is 28 February 2027 (no 30th: last day, fork F3); 6 months after 31 August 2027 is 29
-- February 2028 (leap year); 3 months before 31 May 2027 is 28 February 2027; 50 years (600 months) before 1 January 2030
-- is 1 January 1980; 28 days after 1 March 2027 is 29 March 2027; 90 days after 1 January 2027 is 1 April 2027.
#ASSERT `the date` 3 `months after` (`d` 30 11 2026) EQUALS `d` 28 2 2027
#ASSERT `the date` 6 `months after` (`d` 31 8 2027) EQUALS `d` 29 2 2028
#ASSERT `the date` 3 `months before` (`d` 31 5 2027) EQUALS `d` 28 2 2027
#ASSERT `the date` 600 `months before` (`d` 1 1 2030) EQUALS `d` 1 1 1980
#ASSERT `the date` 1200 `months before` (`d` 1 1 2030) EQUALS `d` 1 1 1930
#ASSERT `the date` 28 `days after` (`d` 1 3 2027) EQUALS `d` 29 3 2027
#ASSERT `the date` 90 `days after` (`d` 1 1 2027) EQUALS `d` 1 4 2027
#ASSERT `the date` 1 `months after` (`d` 15 12 2026) EQUALS `d` 15 1 2027

§§ `s 3 -- senior next of kin, immediate family, domestic partner`

-- Arguments: relationship, 18 or over, spouse/partner available, adult child available, parent available, adult sibling
-- available, executor available, personal representative available, determined under s 3(3).
-- (a) the spouse or partner, whether or not "available" (finding 1).
#ASSERT `Am I the senior next of kin` `spouse or domestic partner` TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE EQUALS TRUE
#ASSERT `Am I the senior next of kin` `spouse or domestic partner` TRUE FALSE TRUE TRUE TRUE TRUE TRUE FALSE EQUALS TRUE
-- (b) an adult son or daughter only where no spouse or partner is available; not under 18.
#ASSERT `Am I the senior next of kin` `son or daughter` TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE EQUALS FALSE
#ASSERT `Am I the senior next of kin` `son or daughter` TRUE FALSE TRUE TRUE TRUE TRUE TRUE FALSE EQUALS TRUE
#ASSERT `Am I the senior next of kin` `son or daughter` FALSE FALSE FALSE TRUE TRUE TRUE TRUE FALSE EQUALS FALSE
-- (c) a parent where no spouse, partner or adult child is available; a child under 18 does not displace the parent
-- (fork F1, finding 2).
#ASSERT `Am I the senior next of kin` `parent` TRUE FALSE TRUE TRUE TRUE TRUE TRUE FALSE EQUALS FALSE
#ASSERT `Am I the senior next of kin` `parent` TRUE FALSE FALSE TRUE TRUE TRUE TRUE FALSE EQUALS TRUE
#ASSERT `Am I the senior next of kin` `parent` FALSE TRUE FALSE TRUE TRUE TRUE TRUE FALSE EQUALS FALSE
-- (d) an adult sibling where none of the above is available.
#ASSERT `Am I the senior next of kin` `sibling` TRUE FALSE FALSE FALSE TRUE TRUE TRUE FALSE EQUALS TRUE
#ASSERT `Am I the senior next of kin` `sibling` FALSE FALSE FALSE FALSE TRUE TRUE TRUE FALSE EQUALS FALSE
#ASSERT `Am I the senior next of kin` `sibling` TRUE FALSE FALSE TRUE TRUE TRUE TRUE FALSE EQUALS FALSE
-- (e), (f).
#ASSERT `Am I the senior next of kin` `executor named in the will` TRUE FALSE FALSE FALSE TRUE TRUE TRUE FALSE EQUALS FALSE
#ASSERT `Am I the senior next of kin` `executor named in the will` TRUE FALSE FALSE FALSE FALSE TRUE TRUE FALSE EQUALS TRUE
#ASSERT `Am I the senior next of kin` `personal representative` TRUE FALSE FALSE FALSE FALSE TRUE TRUE FALSE EQUALS FALSE
#ASSERT `Am I the senior next of kin` `personal representative` TRUE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS TRUE
-- (g) the coroner's determination, only where nobody above is available.
#ASSERT `Am I the senior next of kin` `none of these` TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS TRUE
#ASSERT `Am I the senior next of kin` `none of these` TRUE FALSE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS FALSE
#ASSERT `Am I the senior next of kin` `none of these` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS FALSE

#ASSERT `Am I immediate family` `son or daughter` FALSE EQUALS TRUE
#ASSERT `Am I immediate family` `executor named in the will` FALSE EQUALS TRUE
#ASSERT `Am I immediate family` `none of these` TRUE EQUALS TRUE
#ASSERT `Am I immediate family` `none of these` FALSE EQUALS FALSE

-- Arguments: registered, adult, married, couple, paid or agency carer.
#ASSERT `Was I their domestic partner` TRUE FALSE FALSE FALSE FALSE EQUALS TRUE
#ASSERT `Was I their domestic partner` FALSE TRUE FALSE TRUE FALSE EQUALS TRUE
#ASSERT `Was I their domestic partner` FALSE TRUE TRUE TRUE FALSE EQUALS FALSE
#ASSERT `Was I their domestic partner` FALSE FALSE FALSE TRUE FALSE EQUALS FALSE
#ASSERT `Was I their domestic partner` FALSE TRUE FALSE TRUE TRUE EQUALS FALSE
#ASSERT `Was I their domestic partner` TRUE FALSE FALSE FALSE TRUE EQUALS TRUE
#ASSERT `Was I their domestic partner` FALSE TRUE FALSE FALSE FALSE EQUALS FALSE

§§ `s 4 -- reportable death`

-- Arguments: body in Vic, died in Vic, cause in Vic, resided in Vic, still-birth, unexpected, unnatural or violent,
-- accident or injury, during a procedure, after a procedure and related, not expected by a doctor, custody or care,
-- mental health patient, Justice Secretary or police, supervision order, identity unknown, no death notice (h),
-- uncertified abroad (i), prescribed, voluntary assisted dying.
-- A Victorian killed in a road accident in Victoria.
#ASSERT `Is the death a reportable death` TRUE TRUE TRUE TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE `none` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS TRUE
-- An expected death at home from a known illness: no listed kind.
#ASSERT `Is the death a reportable death` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `none` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS FALSE
-- Unexpected, and nothing else.
#ASSERT `Is the death a reportable death` TRUE TRUE TRUE TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE `none` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS TRUE
-- No link with Victoria.
#ASSERT `Is the death a reportable death` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE `none` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS FALSE
-- Only that the person ordinarily lived in Victoria; a violent death interstate.
#ASSERT `Is the death a reportable death` FALSE FALSE FALSE TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE `none` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS TRUE
-- Medical procedure: during it, but a doctor would have expected the death: not reportable on that head.
#ASSERT `Is the death a reportable death` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE TRUE FALSE FALSE `none` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS FALSE
#ASSERT `Is the death a reportable death` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE TRUE FALSE TRUE `none` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS TRUE
#ASSERT `Is the death a reportable death` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE TRUE `none` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS TRUE
#ASSERT `Is the death a reportable death` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE `none` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS FALSE
-- In police custody; a mental health patient; identity unknown with only the body in Victoria; prescribed.
#ASSERT `Is the death a reportable death` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `police` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS TRUE
#ASSERT `Is the death a reportable death` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `none` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS TRUE
#ASSERT `Is the death a reportable death` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `none` FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS TRUE
#ASSERT `Is the death a reportable death` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `none` FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS TRUE
-- s 4(3): voluntary assisted dying under the 2017 Act, even if unexpected; note 1: a still-birth.
#ASSERT `Is the death a reportable death` TRUE TRUE TRUE TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE `none` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS FALSE
#ASSERT `Is the death a reportable death` TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE `none` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS FALSE
-- (h) no death notice: only for a death in Victoria.
#ASSERT `Is the death a reportable death` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `none` FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS TRUE
#ASSERT `Is the death a reportable death` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `none` FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS FALSE
-- (i) uncertified abroad: only for a death outside Victoria.
#ASSERT `Is the death a reportable death` FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `none` FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS TRUE
#ASSERT `Is the death a reportable death` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `none` FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS FALSE

§§ `s 5 -- reviewable death`

-- Arguments: under 18, second or later child of a parent to die, died in hospital, always in hospital, then the 20 s 4
-- facts as above.
-- A second child of a parent to die, at home, of an expected illness: reviewable though not reportable.
#ASSERT `Is the death a reviewable death` TRUE TRUE FALSE FALSE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `none` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS TRUE
#ASSERT `Is the death a reviewable death` TRUE FALSE FALSE FALSE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `none` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS FALSE
#ASSERT `Is the death a reviewable death` FALSE TRUE FALSE FALSE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `none` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS FALSE
-- s 5(2): born in and never out of hospital, died there, not reportable: not reviewable; if reportable (unexpected), it is.
#ASSERT `Is the death a reviewable death` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `none` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS FALSE
#ASSERT `Is the death a reviewable death` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE `none` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS TRUE
#ASSERT `Is the death a reviewable death` TRUE TRUE TRUE FALSE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `none` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS TRUE
-- No link with Victoria.
#ASSERT `Is the death a reviewable death` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `none` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS FALSE

§§ `Reporting`

#ASSERT `Must I report the death` TRUE EQUALS JUST TRUE
#ASSERT `Must I report the death` FALSE EQUALS JUST FALSE

-- Arguments: relationship, determined, discharged, day of discharge, day of death. The window includes the day exactly 3
-- months before the death (fork F3); from 31 May the window opens on 28 February.
#ASSERT `May I report the death after a mental health discharge` `parent` FALSE TRUE (`d` 10 1 2027) (`d` 10 4 2027) EQUALS JUST TRUE
#ASSERT `May I report the death after a mental health discharge` `parent` FALSE TRUE (`d` 9 1 2027) (`d` 10 4 2027) EQUALS JUST FALSE
#ASSERT `May I report the death after a mental health discharge` `sibling` FALSE TRUE (`d` 10 4 2027) (`d` 10 4 2027) EQUALS JUST TRUE
#ASSERT `May I report the death after a mental health discharge` `sibling` FALSE TRUE (`d` 11 4 2027) (`d` 10 4 2027) EQUALS JUST FALSE
#ASSERT `May I report the death after a mental health discharge` `spouse or domestic partner` FALSE TRUE (`d` 28 2 2027) (`d` 31 5 2027) EQUALS JUST TRUE
#ASSERT `May I report the death after a mental health discharge` `spouse or domestic partner` FALSE TRUE (`d` 27 2 2027) (`d` 31 5 2027) EQUALS JUST FALSE
#ASSERT `May I report the death after a mental health discharge` `parent` FALSE FALSE (`d` 10 4 2027) (`d` 10 4 2027) EQUALS JUST FALSE
#ASSERT `May I report the death after a mental health discharge` `none of these` FALSE TRUE (`d` 10 4 2027) (`d` 10 4 2027) EQUALS NOTHING

§§ `ss 14 to 16 -- the investigation`

-- Arguments: day of death, day reported, interstate coroner, reported under s 12(2), then the 20 s 4 facts.
-- A road death in Victoria reported the next day.
#ASSERT `Must a coroner investigate the death` (`d` 1 3 2026) (`d` 2 3 2026) FALSE FALSE TRUE TRUE TRUE TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE `none` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `a coroner must investigate (s 15)`
#ASSERT `Must a coroner investigate the death` (`d` 1 3 2026) (`d` 2 3 2026) TRUE FALSE TRUE TRUE TRUE TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE `none` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `a coroner may investigate (s 14)`
-- A Victorian killed interstate (neither death nor cause in Victoria): s 15(a) fails.
#ASSERT `Must a coroner investigate the death` (`d` 1 3 2026) (`d` 2 3 2026) FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE `none` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `a coroner may investigate (s 14)`
-- Remains found: exactly 50 years before the report is within 50 years; a day earlier is not.
#ASSERT `Must a coroner investigate the death` (`d` 1 1 1980) (`d` 1 1 2030) FALSE FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `none` FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS `a coroner must investigate (s 15)`
#ASSERT `Must a coroner investigate the death` (`d` 31 12 1979) (`d` 1 1 2030) FALSE FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `none` FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS `a coroner may investigate (s 14)`
-- Exactly 100 years is within s 14(1); a day more is "more than 100 years" (s 16(5)), reportable or not.
#ASSERT `Must a coroner investigate the death` (`d` 1 1 1930) (`d` 1 1 2030) FALSE FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `none` FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS `a coroner may investigate (s 14)`
#ASSERT `Must a coroner investigate the death` (`d` 31 12 1929) (`d` 1 1 2030) FALSE FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `none` FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS `the investigation must be discontinued, over 100 years (s 16(5))`
#ASSERT `Must a coroner investigate the death` (`d` 31 12 1929) (`d` 1 1 2030) FALSE FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `none` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `the investigation must be discontinued, over 100 years (s 16(5))`
-- Not reportable; but reported by family after a mental health discharge (s 14(2)).
#ASSERT `Must a coroner investigate the death` (`d` 1 3 2026) (`d` 2 3 2026) FALSE FALSE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `none` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `not a reportable death on these facts (ss 14(3), 16)`
#ASSERT `Must a coroner investigate the death` (`d` 1 3 2026) (`d` 2 3 2026) FALSE TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `none` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `a coroner may investigate (s 14)`

§§ `ss 17, 17A, 17B -- natural causes`

-- Arguments: medical investigator's natural-causes report, preliminary examination, pathologist's opinion, pathologist
-- willing to notify, under 18, second child to die, died in hospital, always in hospital, then the 20 s 4 facts.
-- An adult's unexpected death at home in Victoria.
#ASSERT `Can the investigation stop on natural causes` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE TRUE TRUE TRUE TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE `none` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `the coroner need not continue (s 17) and may discontinue (s 17A)`
#ASSERT `Can the investigation stop on natural causes` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE TRUE TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE `none` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `the coroner need not continue (s 17)`
#ASSERT `Can the investigation stop on natural causes` FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE TRUE TRUE TRUE TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE `none` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `the coroner may discontinue (s 17A)`
#ASSERT `Can the investigation stop on natural causes` FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE TRUE TRUE TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE `none` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `neither s 17 nor s 17A applies`
-- Unexpected and from an injury: not "only because" unexpected.
#ASSERT `Can the investigation stop on natural causes` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE TRUE TRUE TRUE TRUE FALSE TRUE FALSE TRUE FALSE FALSE FALSE `none` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `neither s 17 nor s 17A applies`
-- No death notice signed (s 4(2)(h)) and nothing else: within both sections.
#ASSERT `Can the investigation stop on natural causes` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `none` FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS `the coroner need not continue (s 17)`
-- Unexpected after a medical procedure a doctor would not have expected it to follow: s 4(2)(b) rules both out.
#ASSERT `Can the investigation stop on natural causes` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE TRUE TRUE TRUE TRUE FALSE TRUE FALSE FALSE FALSE TRUE TRUE `none` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `neither s 17 nor s 17A applies`
-- A child's reviewable death (second child of a parent to die).
#ASSERT `Can the investigation stop on natural causes` TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE TRUE TRUE TRUE TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE `none` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `neither s 17 nor s 17A applies`
-- Not reportable at all.
#ASSERT `Can the investigation stop on natural causes` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `none` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `neither s 17 nor s 17A applies`

-- Arguments: discontinued under s 17A, senior next of kin, leave, refused before on the same grounds.
#ASSERT `Can I apply to re-open the discontinued investigation` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Can I apply to re-open the discontinued investigation` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Can I apply to re-open the discontinued investigation` TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `Can I apply to re-open the discontinued investigation` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Can I apply to re-open the discontinued investigation` FALSE TRUE FALSE FALSE EQUALS NOTHING

