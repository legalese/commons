IMPORT prelude
IMPORT `wirc-core`
IMPORT `wirc-seat`

-- Cases for the injured worker's seat (wirc-seat.l4) and the core's rules (wirc-core.l4).
-- Every expected value is worked by hand from the deposited text and the Gazette notice of 30 June 2026, with the
-- arithmetic in the comment; none is copied from the encoding's output. Each exported question has cases, with the
-- edges: the last day, the day after, a threshold and just under it, a cap and just over it.
-- Breached traces are asserted with CONSIDER ... WHEN FULFILLED (EVALTRACE ... EQUALS cannot test a breach).

§ `Cases`

-- A trace that ends anywhere but FULFILLED (here, after the deadline has passed: a breach).
GIVEN `the outcome` IS A DEONTIC `WIRC party` `WIRC action`
GIVETH A BOOLEAN
`ends fulfilled` `the outcome` MEANS
    CONSIDER `the outcome`
    WHEN FULFILLED THEN TRUE
    OTHERWISE FALSE

§§ `Am I covered (ss 37, 39, 40)`

-- Helpers that fill the inputs a case does not turn on.
GIVEN `connected` IS A BOOLEAN, `arose` IS A BOOLEAN, `heart or disease` IS A BOOLEAN, `significant` IS A BOOLEAN
      `self-inflicted` IS A BOOLEAN, `misconduct` IS A BOOLEAN, `severe` IS A `Severe injury head`
GIVETH A MAYBE BOOLEAN
`physical case` `connected` `arose` `heart or disease` `significant` `self-inflicted` `misconduct` `severe` MEANS
    `Am I entitled to compensation for my injury` `connected` `a physical injury` (DATE_FROM_DMY 1 3 2026) `arose` FALSE FALSE FALSE FALSE FALSE FALSE `heart or disease` `significant` `self-inflicted` `misconduct` `severe`

GIVEN `the day` IS A DATE, `predominantly arose` IS A BOOLEAN, `management` IS A BOOLEAN, `stress` IS A BOOLEAN
      `traumatic` IS A BOOLEAN, `recurrence` IS A BOOLEAN, `predominant cause` IS A BOOLEAN
GIVETH A MAYBE BOOLEAN
`mental case` `the day` `predominantly arose` `management` `stress` `traumatic` `recurrence` `predominant cause` MEANS
    `Am I entitled to compensation for my injury` TRUE `a mental injury` `the day` FALSE `predominantly arose` `management` `stress` `traumatic` `recurrence` `predominant cause` FALSE FALSE FALSE FALSE `none of these`

-- s 39(1): a physical injury arising out of or in the course of employment.
#ASSERT `physical case` TRUE TRUE FALSE FALSE FALSE FALSE `none of these` EQUALS JUST TRUE
-- s 37(1): employment not connected with Victoria.
#ASSERT `physical case` FALSE TRUE FALSE FALSE FALSE FALSE `none of these` EQUALS JUST FALSE
-- Not arising out of or in the course of employment.
#ASSERT `physical case` TRUE FALSE FALSE FALSE FALSE FALSE `none of these` EQUALS JUST FALSE
-- s 40(2), (3): a heart attack, disease or aggravation needs employment as a significant contributing factor.
#ASSERT `physical case` TRUE TRUE TRUE FALSE FALSE FALSE `none of these` EQUALS JUST FALSE
#ASSERT `physical case` TRUE TRUE TRUE TRUE FALSE FALSE `none of these` EQUALS JUST TRUE
-- s 40(4): proved self-inflicted.
#ASSERT `physical case` TRUE TRUE FALSE FALSE TRUE FALSE `none of these` EQUALS JUST FALSE
-- s 40(5): proved serious and wilful misconduct; s 40(6): not if the injury is severe (an amputation).
#ASSERT `physical case` TRUE TRUE FALSE FALSE FALSE TRUE `none of these` EQUALS JUST FALSE
#ASSERT `physical case` TRUE TRUE FALSE FALSE FALSE TRUE `amputation of a limb, hand or foot` EQUALS JUST TRUE
#ASSERT `physical case` TRUE TRUE FALSE FALSE FALSE TRUE `permanent paraplegia` EQUALS JUST TRUE
-- s 625(1): a mental injury before 31 March 2024 is under the earlier text: nothing. On 31 March 2024: the new law.
#ASSERT `mental case` (DATE_FROM_DMY 30 3 2024) TRUE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `mental case` (DATE_FROM_DMY 31 3 2024) TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- s 39(1A): not predominantly arising out of employment.
#ASSERT `mental case` (DATE_FROM_DMY 1 5 2026) FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- s 40(1): reasonable management action.
#ASSERT `mental case` (DATE_FROM_DMY 1 5 2026) TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- s 40(1A): work related stress or burnout from usual events; s 39(2A): but usual traumatic events still entitle.
#ASSERT `mental case` (DATE_FROM_DMY 1 5 2026) TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `mental case` (DATE_FROM_DMY 1 5 2026) TRUE FALSE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `mental case` (DATE_FROM_DMY 1 5 2026) FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- s 39(2A) does not override s 40(1): traumatic events, but reasonable management action predominantly caused it.
#ASSERT `mental case` (DATE_FROM_DMY 1 5 2026) TRUE TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
-- s 40(2A): a recurrence of a pre-existing mental injury needs employment as the predominant cause.
#ASSERT `mental case` (DATE_FROM_DMY 1 5 2026) TRUE FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `mental case` (DATE_FROM_DMY 1 5 2026) TRUE FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE

§§ `Notice of injury and the claim`

-- s 18(1): aware 1 March 2026; 30 days after: 31 March 2026. Aware 15 January 2026: 14 February 2026.
#ASSERT `By what day must I give my employer notice of my injury` (DATE_FROM_DMY 1 3 2026) EQUALS DATE_FROM_DMY 31 3 2026
#ASSERT `By what day must I give my employer notice of my injury` (DATE_FROM_DMY 15 1 2026) EQUALS DATE_FROM_DMY 14 2 2026
-- s 18(5)-(7): notice on the last day; the day after (not waived, no s 18(7) reason; waived; absent from Victoria).
#ASSERT `What follows from when I gave notice of my injury` (DATE_FROM_DMY 1 3 2026) (DATE_FROM_DMY 31 3 2026) FALSE `none of these` EQUALS `notice was given in time (s 18(1))`
#ASSERT `What follows from when I gave notice of my injury` (DATE_FROM_DMY 1 3 2026) (DATE_FROM_DMY 1 4 2026) FALSE `none of these` EQUALS `notice was late: no compensation unless the Authority or self-insurer is satisfied of a ground in s 18(6) and waives or extends the time (s 18(5))`
#ASSERT `What follows from when I gave notice of my injury` (DATE_FROM_DMY 1 3 2026) (DATE_FROM_DMY 1 4 2026) TRUE `none of these` EQUALS `notice was late, and the Authority or self-insurer waived or extended the time (s 18(6))`
#ASSERT `What follows from when I gave notice of my injury` (DATE_FROM_DMY 1 3 2026) (DATE_FROM_DMY 1 4 2026) FALSE `being absent from Victoria` EQUALS `notice was late; s 18(7) treats it as not reasonably practicable, a ground on which the Authority or self-insurer may waive or extend the time (s 18(6)(a))`

-- s 20(8)(b): death 10 May 2025, 2 years after: 10 May 2027; death 29 February 2024: 28 February 2026.
#ASSERT `By what day must my claim be made` `a claim for compensation for the death of a worker` (DATE_FROM_DMY 10 5 2025) (DATE_FROM_DMY 1 1 2026) EQUALS JUST (DATE_FROM_DMY 10 5 2027)
#ASSERT `By what day must my claim be made` `a claim for compensation for the death of a worker` (DATE_FROM_DMY 29 2 2024) (DATE_FROM_DMY 1 1 2026) EQUALS JUST (DATE_FROM_DMY 28 2 2026)
-- s 20(8)(c): service 15 January 2026, 6 months after: 15 July 2026; service 31 August 2026: 28 February 2027.
#ASSERT `By what day must my claim be made` `a claim for medical and like services` (DATE_FROM_DMY 1 1 2020) (DATE_FROM_DMY 15 1 2026) EQUALS JUST (DATE_FROM_DMY 15 7 2026)
#ASSERT `By what day must my claim be made` `a claim for medical and like services` (DATE_FROM_DMY 1 1 2020) (DATE_FROM_DMY 31 8 2026) EQUALS JUST (DATE_FROM_DMY 28 2 2027)
-- s 20(8)(a): "as soon as practicable" fixes no day; a Division 5 claim has no limit in s 20(8).
#ASSERT `By what day must my claim be made` `a claim for weekly payments` (DATE_FROM_DMY 1 1 2020) (DATE_FROM_DMY 1 1 2020) EQUALS NOTHING
#ASSERT `By what day must my claim be made` `a claim for an impairment benefit` (DATE_FROM_DMY 1 1 2020) (DATE_FROM_DMY 1 1 2020) EQUALS NOTHING

-- s 75(1): received 2 March 2026 with a certificate: 28 days after, 30 March 2026. Without: certificate received
-- 10 March 2026, 7 April 2026.
#ASSERT `By what day must my weekly payments claim be decided` (DATE_FROM_DMY 2 3 2026) TRUE (DATE_FROM_DMY 1 1 2020) EQUALS DATE_FROM_DMY 30 3 2026
#ASSERT `By what day must my weekly payments claim be decided` (DATE_FROM_DMY 2 3 2026) FALSE (DATE_FROM_DMY 10 3 2026) EQUALS DATE_FROM_DMY 7 4 2026
-- Deemed accepted: not yet on 30 March (the last day); on 31 March with no decision, yes; a decision given on
-- 30 March, no; a decision first given on 31 March, too late, yes.
#ASSERT `Is my weekly payments claim taken to be accepted` (DATE_FROM_DMY 2 3 2026) TRUE (DATE_FROM_DMY 1 1 2020) FALSE (DATE_FROM_DMY 1 1 2020) (DATE_FROM_DMY 30 3 2026) EQUALS FALSE
#ASSERT `Is my weekly payments claim taken to be accepted` (DATE_FROM_DMY 2 3 2026) TRUE (DATE_FROM_DMY 1 1 2020) FALSE (DATE_FROM_DMY 1 1 2020) (DATE_FROM_DMY 31 3 2026) EQUALS TRUE
#ASSERT `Is my weekly payments claim taken to be accepted` (DATE_FROM_DMY 2 3 2026) TRUE (DATE_FROM_DMY 1 1 2020) TRUE (DATE_FROM_DMY 30 3 2026) (DATE_FROM_DMY 31 3 2026) EQUALS FALSE
#ASSERT `Is my weekly payments claim taken to be accepted` (DATE_FROM_DMY 2 3 2026) TRUE (DATE_FROM_DMY 1 1 2020) TRUE (DATE_FROM_DMY 31 3 2026) (DATE_FROM_DMY 1 4 2026) EQUALS TRUE
-- s 178(3): accepted 30 March 2026, 7 days after: 6 April 2026.
#ASSERT `By what day must my weekly payments begin` (DATE_FROM_DMY 30 3 2026) EQUALS DATE_FROM_DMY 6 4 2026

-- The rules. s 18: notice on day 30, acknowledged on day 31: fulfilled. Notice on day 31: breached.
#ASSERT EVALTRACE `s 18 -- the worker must give notice of the injury within 30 days, and the employer must acknowledge it` 0 (LIST (EVENT `the worker` `give the employer notice of the injury` 30), (EVENT `the employer` `acknowledge the notice in writing` 31)) EQUALS FULFILLED
#ASSERT NOT (`ends fulfilled` (EVALTRACE `s 18 -- the worker must give notice of the injury within 30 days, and the employer must acknowledge it` 0 (LIST (EVENT `the worker` `give the employer notice of the injury` 31))))
-- s 75(1), s 178(3): accepted on day 10, paid on day 17: fulfilled; paid on day 18: not. Rejected: fulfilled.
#ASSERT EVALTRACE `s 75(1), s 178(3) -- the Authority or self-insurer must decide a weekly payments claim within 28 days` 0 (LIST (EVENT `the Authority or self-insurer` (`give written notice of its decision on the claim` TRUE) 10), (EVENT `the Authority or self-insurer` `begin paying weekly payments` 17)) EQUALS FULFILLED
#ASSERT NOT (`ends fulfilled` (EVALTRACE `s 75(1), s 178(3) -- the Authority or self-insurer must decide a weekly payments claim within 28 days` 0 (LIST (EVENT `the Authority or self-insurer` (`give written notice of its decision on the claim` TRUE) 10), (EVENT `the Authority or self-insurer` `begin paying weekly payments` 18))))
#ASSERT EVALTRACE `s 75(1), s 178(3) -- the Authority or self-insurer must decide a weekly payments claim within 28 days` 0 (LIST (EVENT `the Authority or self-insurer` (`give written notice of its decision on the claim` FALSE) 20)) EQUALS FULFILLED
-- Silence past day 28: deemed accepted; payments by day 36 (7 days from day 29, when the lapse is read): fulfilled.
#ASSERT EVALTRACE `s 75(1), s 178(3) -- the Authority or self-insurer must decide a weekly payments claim within 28 days` 0 (LIST (WAITUNTIL 29), (EVENT `the Authority or self-insurer` `begin paying weekly payments` 36)) EQUALS FULFILLED
#ASSERT NOT (`ends fulfilled` (EVALTRACE `s 75(1), s 178(3) -- the Authority or self-insurer must decide a weekly payments claim within 28 days` 0 (LIST (WAITUNTIL 29), (EVENT `the Authority or self-insurer` `begin paying weekly payments` 37))))

§§ `Provisional payments for a mental injury`

-- s 263B: the Division commenced 1 July 2021. A claim that day: yes; the day before: no; a second claim for the same
-- mental injury and circumstances: no.
#ASSERT `Can I get provisional payments for my mental injury` (DATE_FROM_DMY 1 7 2021) FALSE EQUALS TRUE
#ASSERT `Can I get provisional payments for my mental injury` (DATE_FROM_DMY 30 6 2021) FALSE EQUALS FALSE
#ASSERT `Can I get provisional payments for my mental injury` (DATE_FROM_DMY 1 5 2026) TRUE EQUALS FALSE
-- s 263I: found entitled 1 March 2026, not accepted: 13 weeks (91 days) after, 31 May 2026; accepted 20 March 2026.
#ASSERT `Until what day are my provisional payments payable` (DATE_FROM_DMY 1 3 2026) FALSE (DATE_FROM_DMY 1 1 2020) EQUALS DATE_FROM_DMY 31 5 2026
#ASSERT `Until what day are my provisional payments payable` (DATE_FROM_DMY 1 3 2026) TRUE (DATE_FROM_DMY 20 3 2026) EQUALS DATE_FROM_DMY 20 3 2026

§§ `Weekly payments`

-- s 152: weeks 1-13 first, 14-130 second (13 + 117), 131 on after.
#ASSERT `Which entitlement period is this week in` 1 EQUALS `the first entitlement period`
#ASSERT `Which entitlement period is this week in` 13 EQUALS `the first entitlement period`
#ASSERT `Which entitlement period is this week in` 14 EQUALS `the second entitlement period`
#ASSERT `Which entitlement period is this week in` 130 EQUALS `the second entitlement period`
#ASSERT `Which entitlement period is this week in` 131 EQUALS `after the second entitlement period`

-- Weekly payments in a week of August 2026: twice the State average weekly earnings is $3000 (Gazette line 498).
-- s 161(a): week 5, PIAWE $1500, no capacity, no earnings: 95% x 1500 = 1425.
#ASSERT `How much are my weekly payments this week` (DATE_FROM_DMY 15 8 2026) 5 1500 0 FALSE 0 FALSE FALSE EQUALS JUST 1425
-- s 161(a)(ii): PIAWE $4000: 95% = 3800, capped at 3000.
#ASSERT `How much are my weekly payments this week` (DATE_FROM_DMY 15 8 2026) 5 4000 0 FALSE 0 FALSE FALSE EQUALS JUST 3000
-- s 161(b): PIAWE $1500, deductible $50, capacity, earning $600: lesser of 1425 - 50 - 600 = 775 and 3000 - 600 = 2400.
#ASSERT `How much are my weekly payments this week` (DATE_FROM_DMY 15 8 2026) 5 1500 50 TRUE 600 FALSE FALSE EQUALS JUST 775
-- s 161(b), no capacity but earning $200: 1425 - 200 = 1225 (against 2800).
#ASSERT `How much are my weekly payments this week` (DATE_FROM_DMY 15 8 2026) 5 1500 0 FALSE 200 FALSE FALSE EQUALS JUST 1225
-- s 161(b): earnings above the rate: 950 - 1000 is below nil, so nil (reading).
#ASSERT `How much are my weekly payments this week` (DATE_FROM_DMY 15 8 2026) 5 1000 0 TRUE 1000 FALSE FALSE EQUALS JUST 0
-- s 161 on the last day of the first period's week 13 and s 162 from week 14: 1425, then 80% x 1500 = 1200.
#ASSERT `How much are my weekly payments this week` (DATE_FROM_DMY 15 8 2026) 13 1500 0 FALSE 0 FALSE FALSE EQUALS JUST 1425
#ASSERT `How much are my weekly payments this week` (DATE_FROM_DMY 15 8 2026) 14 1500 0 FALSE 0 FALSE FALSE EQUALS JUST 1200
-- s 162(b): week 20, capacity, earning $500: lesser of 1200 - 400 = 800 and 3000 - 400 = 2600.
#ASSERT `How much are my weekly payments this week` (DATE_FROM_DMY 15 8 2026) 20 1500 0 TRUE 500 FALSE FALSE EQUALS JUST 800
-- s 162(b)(ii): PIAWE $5000, earning $1000: lesser of 4000 - 800 = 3200 and 3000 - 800 = 2200.
#ASSERT `How much are my weekly payments this week` (DATE_FROM_DMY 15 8 2026) 20 5000 0 TRUE 1000 FALSE FALSE EQUALS JUST 2200
-- Week 130 still s 162; week 131 with no s 163 or s 165: nil (s 163(1) "ceases").
#ASSERT `How much are my weekly payments this week` (DATE_FROM_DMY 15 8 2026) 130 1500 0 FALSE 0 FALSE FALSE EQUALS JUST 1200
#ASSERT `How much are my weekly payments this week` (DATE_FROM_DMY 15 8 2026) 131 1500 0 FALSE 0 FALSE FALSE EQUALS JUST 0
-- s 163(2): the determination made, no earnings: 1200. s 165(5): approved, earning $500: 1200 - 400 = 800.
#ASSERT `How much are my weekly payments this week` (DATE_FROM_DMY 15 8 2026) 131 1500 0 FALSE 0 TRUE FALSE EQUALS JUST 1200
#ASSERT `How much are my weekly payments this week` (DATE_FROM_DMY 15 8 2026) 131 1500 0 TRUE 500 FALSE TRUE EQUALS JUST 800
-- The cap by financial year: August 2025, $2930 (Gazette line 498, "before"); 30 June 2027, $3000; 1 July 2027, nothing.
#ASSERT `How much are my weekly payments this week` (DATE_FROM_DMY 15 8 2025) 5 4000 0 FALSE 0 FALSE FALSE EQUALS JUST 2930
#ASSERT `How much are my weekly payments this week` (DATE_FROM_DMY 30 6 2027) 5 4000 0 FALSE 0 FALSE FALSE EQUALS JUST 3000
#ASSERT `How much are my weekly payments this week` (DATE_FROM_DMY 1 7 2027) 5 4000 0 FALSE 0 FALSE FALSE EQUALS NOTHING
#ASSERT `How much are my weekly payments this week` (DATE_FROM_DMY 30 6 2025) 5 4000 0 FALSE 0 FALSE FALSE EQUALS NOTHING

-- s 163(1): no capacity indefinitely and 21% (more than 20): yes; 20%: no; capacity: no; s 625(2): nothing.
#ASSERT `Can my weekly payments go on after 130 weeks because I cannot work` TRUE 21 FALSE EQUALS JUST TRUE
#ASSERT `Can my weekly payments go on after 130 weeks because I cannot work` TRUE 20 FALSE EQUALS JUST FALSE
#ASSERT `Can my weekly payments go on after 130 weeks because I cannot work` FALSE 40 FALSE EQUALS JUST FALSE
#ASSERT `Can my weekly payments go on after 130 weeks because I cannot work` TRUE 40 TRUE EQUALS NOTHING

-- s 165(4): application 1 September 2026, minimum $257 (Gazette line 522): 15 hours, $257, unable to do more, 21%: yes.
#ASSERT `Can my weekly payments go on after 130 weeks while I work` (DATE_FROM_DMY 1 9 2026) 15 257 TRUE 21 FALSE EQUALS JUST TRUE
-- 14 hours; $256; 20%; able to do more: no.
#ASSERT `Can my weekly payments go on after 130 weeks while I work` (DATE_FROM_DMY 1 9 2026) 14 257 TRUE 21 FALSE EQUALS JUST FALSE
#ASSERT `Can my weekly payments go on after 130 weeks while I work` (DATE_FROM_DMY 1 9 2026) 15 256 TRUE 21 FALSE EQUALS JUST FALSE
#ASSERT `Can my weekly payments go on after 130 weeks while I work` (DATE_FROM_DMY 1 9 2026) 15 257 TRUE 20 FALSE EQUALS JUST FALSE
#ASSERT `Can my weekly payments go on after 130 weeks while I work` (DATE_FROM_DMY 1 9 2026) 15 257 FALSE 21 FALSE EQUALS JUST FALSE
-- September 2025: minimum $251: $251 is enough.
#ASSERT `Can my weekly payments go on after 130 weeks while I work` (DATE_FROM_DMY 1 9 2025) 15 251 TRUE 21 FALSE EQUALS JUST TRUE
-- Outside the two years; s 625(2).
#ASSERT `Can my weekly payments go on after 130 weeks while I work` (DATE_FROM_DMY 1 7 2027) 15 300 TRUE 21 FALSE EQUALS NOTHING
#ASSERT `Can my weekly payments go on after 130 weeks while I work` (DATE_FROM_DMY 1 9 2026) 15 300 TRUE 21 TRUE EQUALS NOTHING

-- ss 169, 171: injured 1 January 2026. 910 days later is 29 June 2028 (365 + 365 + 180: 1 January 2028 + 180 days, a
-- leap year). Pension age on 29 June 2028: within 130 weeks, so s 169; on 30 June 2028 (911 days): s 171. Injured after
-- pension age: s 169.
#ASSERT `Does my age limit my weekly payments` (DATE_FROM_DMY 1 1 2026) (DATE_FROM_DMY 29 6 2028) EQUALS `weekly payments for not more than the first 130 weeks of incapacity (s 169)`
#ASSERT `Does my age limit my weekly payments` (DATE_FROM_DMY 1 1 2026) (DATE_FROM_DMY 30 6 2028) EQUALS `weekly payments stop when the worker reaches retirement age (s 171)`
#ASSERT `Does my age limit my weekly payments` (DATE_FROM_DMY 1 1 2026) (DATE_FROM_DMY 1 1 2025) EQUALS `weekly payments for not more than the first 130 weeks of incapacity (s 169)`

-- s 189: 11 weeks: s 189 does not apply; 12 weeks: 14 days; 51 weeks: 14 days; 52 weeks (one year): 28 days; no
-- certificate: does not apply; expiry of the second entitlement period: 13 weeks, 91 days; s 165 ceasing: 28; employer
-- withdrawing the job under s 165: 91.
#ASSERT `How many days notice must I be given before my weekly payments stop or are cut` 11 TRUE `another reason` EQUALS NOTHING
#ASSERT `How many days notice must I be given before my weekly payments stop or are cut` 12 TRUE `another reason` EQUALS JUST 14
#ASSERT `How many days notice must I be given before my weekly payments stop or are cut` 51 TRUE `another reason` EQUALS JUST 14
#ASSERT `How many days notice must I be given before my weekly payments stop or are cut` 52 TRUE `another reason` EQUALS JUST 28
#ASSERT `How many days notice must I be given before my weekly payments stop or are cut` 60 FALSE `another reason` EQUALS NOTHING
#ASSERT `How many days notice must I be given before my weekly payments stop or are cut` 130 TRUE `the expiry of the second entitlement period` EQUALS JUST 91
#ASSERT `How many days notice must I be given before my weekly payments stop or are cut` 140 TRUE `ceasing to be entitled to s 165 payments` EQUALS JUST 28
#ASSERT `How many days notice must I be given before my weekly payments stop or are cut` 140 TRUE `the employer withdrew the employment while s 165 payments were made` EQUALS JUST 91

-- s 165(3): decided on day 28: fulfilled; nothing by day 29: breached.
#ASSERT EVALTRACE `s 165(3) -- the Authority or self-insurer must decide a s 165 application within 28 days` 0 (LIST (EVENT `the Authority or self-insurer` `decide the application under s 165` 28)) EQUALS FULFILLED
#ASSERT NOT (`ends fulfilled` (EVALTRACE `s 165(3) -- the Authority or self-insurer must decide a s 165 application within 28 days` 0 (LIST (WAITUNTIL 29))))

§§ `Impairment benefit`

-- s 197(2): injured 1 March 2025; 12 months after ends 1 March 2026; first day 2 March 2026. Injured 29 February
-- 2024: 12 months after is 28 February 2025; first day 1 March 2025.
#ASSERT `From what day can I claim an impairment benefit` (DATE_FROM_DMY 1 3 2025) EQUALS DATE_FROM_DMY 2 3 2026
#ASSERT `From what day can I claim an impairment benefit` (DATE_FROM_DMY 29 2 2024) EQUALS DATE_FROM_DMY 1 3 2025
#ASSERT `Can I make my impairment benefit claim on this day` (DATE_FROM_DMY 1 3 2025) (DATE_FROM_DMY 1 3 2026) FALSE FALSE EQUALS FALSE
#ASSERT `Can I make my impairment benefit claim on this day` (DATE_FROM_DMY 1 3 2025) (DATE_FROM_DMY 2 3 2026) FALSE FALSE EQUALS TRUE
#ASSERT `Can I make my impairment benefit claim on this day` (DATE_FROM_DMY 1 3 2025) (DATE_FROM_DMY 1 6 2025) FALSE TRUE EQUALS TRUE
#ASSERT `Can I make my impairment benefit claim on this day` (DATE_FROM_DMY 1 3 2025) (DATE_FROM_DMY 1 6 2025) TRUE FALSE EQUALS TRUE

-- s 211(2), injured 1 August 2026 and calculated 1 September 2026: the 2026-27 amounts (Gazette lines 534-555).
-- (a) 9%: nil.
#ASSERT `How much is my impairment benefit for a physical impairment` 9 `any other whole person impairment` (DATE_FROM_DMY 1 8 2026) (DATE_FROM_DMY 1 9 2026) EQUALS JUST 0
-- (c)(i) 10%: 26 530 + 0 x 3980 = 26 530.
#ASSERT `How much is my impairment benefit for a physical impairment` 10 `any other whole person impairment` (DATE_FROM_DMY 1 8 2026) (DATE_FROM_DMY 1 9 2026) EQUALS JUST 26530
-- (b)(i) modified whole person 10%: 16 430; 10.5%: 16 430 + 0.5 x 14 000 = 23 430.
#ASSERT `How much is my impairment benefit for a physical impairment` 10 `a modified whole person impairment (s 210(2)(a)(i))` (DATE_FROM_DMY 1 8 2026) (DATE_FROM_DMY 1 9 2026) EQUALS JUST 16430
#ASSERT `How much is my impairment benefit for a physical impairment` 10.5 `a modified whole person impairment (s 210(2)(a)(i))` (DATE_FROM_DMY 1 8 2026) (DATE_FROM_DMY 1 9 2026) EQUALS JUST 23430
-- (b)(ii) modified spinal 10.5%: 23 430 x 1.1 = 25 773.
#ASSERT `How much is my impairment benefit for a physical impairment` 10.5 `a modified spinal impairment (s 210(2)(a)(ii))` (DATE_FROM_DMY 1 8 2026) (DATE_FROM_DMY 1 9 2026) EQUALS JUST 25773
-- Modified whole person 11%: (b) no longer applies; (c)(i): 26 530 + 3980 = 30 510.
#ASSERT `How much is my impairment benefit for a physical impairment` 11 `a modified whole person impairment (s 210(2)(a)(i))` (DATE_FROM_DMY 1 8 2026) (DATE_FROM_DMY 1 9 2026) EQUALS JUST 30510
-- (c)(ii) spinal 20%: lesser of (26 530 + 10 x 3980) x 1.1 = 72 963 and 26 530 + 20 x 3980 = 106 130: 72 963.
#ASSERT `How much is my impairment benefit for a physical impairment` 20 `a spinal impairment (s 210(2)(a)(iii), or a spinal impairment otherwise)` (DATE_FROM_DMY 1 8 2026) (DATE_FROM_DMY 1 9 2026) EQUALS JUST 72963
-- (c)(ii) spinal 29%: (26 530 + 19 x 3980) x 1.1 = 102 150 x 1.1 = 112 365, so the cap of (B), 106 130.
#ASSERT `How much is my impairment benefit for a physical impairment` 29 `a spinal impairment (s 210(2)(a)(iii), or a spinal impairment otherwise)` (DATE_FROM_DMY 1 8 2026) (DATE_FROM_DMY 1 9 2026) EQUALS JUST 106130
-- Modified spinal 12% falls in (c)(ii) too: (26 530 + 2 x 3980) x 1.1 = 34 490 x 1.1 = 37 939.
