IMPORT prelude
IMPORT `limitation-core`
IMPORT `limitation-seat`

-- Cases for the seat of the person who wants to sue (limitation-seat.l4) and the core's bar rule (limitation-core.l4).
-- Every expected value is worked by hand from the deposited text, with the arithmetic or the reason in the comment;
-- none is copied from the encoding's output. Each exported question has cases with its edges: the day before and on
-- a commencement day, an 18th birthday on the day of the act, exactly 3 years before a death, 27 and 28 days of
-- incapacity, the first and last day of the 2024-2026 window and the day either side, the last day and the day after.
-- Breached traces are asserted with CONSIDER ... WHEN FULFILLED (EVALTRACE ... EQUALS cannot test a breach).

§ `Cases`

GIVEN `the outcome` IS A DEONTIC `Limitation party` `Limitation action`
GIVETH A BOOLEAN
`ends fulfilled` `the outcome` MEANS
    CONSIDER `the outcome`
    WHEN FULFILLED THEN TRUE
    OTHERWISE FALSE

GIVEN `y` IS A NUMBER, `m` IS A NUMBER, `d` IS A NUMBER
GIVETH A DATE
`on` `y` `m` `d` MEANS DATE_FROM_DMY `d` `m` `y`

§§ `Which time limit applies`

-- An ordinary injury claim, act in 2020: Part IIA (s 27B(1), s 27N(1)).
#ASSERT `Which time limit applies to my claim` `damages for my own personal injury` `no compensation scheme` FALSE FALSE FALSE FALSE FALSE (`on` 2020 1 1) EQUALS JUST `Part IIA -- 3 or 6 years from discoverability or the 12-year long-stop, whichever ends first (ss 27D-27J)`
-- s 27N: the day before 21 May 2003, and the day itself.
#ASSERT `Which time limit applies to my claim` `damages for my own personal injury` `no compensation scheme` FALSE FALSE FALSE FALSE FALSE (`on` 2003 5 20) EQUALS JUST `Part IIA, but no longer than the law before Part IIA -- act before 21 May 2003 (s 27N(4))`
#ASSERT `Which time limit applies to my claim` `damages for my own personal injury` `no compensation scheme` FALSE FALSE FALSE FALSE FALSE (`on` 2003 5 21) EQUALS JUST `Part IIA -- 3 or 6 years from discoverability or the 12-year long-stop, whichever ends first (ss 27D-27J)`
-- s 5(1)(a): contract or tort, not personal injury.
#ASSERT `Which time limit applies to my claim` `contract or tort, not for death or personal injury and not defamation` `no compensation scheme` FALSE FALSE FALSE FALSE FALSE (`on` 2020 1 1) EQUALS JUST `Part I -- contract or tort, 6 years (s 5(1)(a))`
-- Another kind of action: outside the encoding.
#ASSERT `Which time limit applies to my claim` `another kind of action` `no compensation scheme` FALSE FALSE FALSE FALSE FALSE (`on` 2020 1 1) EQUALS NOTHING
-- s 23AB: a worker's dust-related condition, the worker's own action and the dependants' Part III action.
#ASSERT `Which time limit applies to my claim` `damages for my own personal injury` `no compensation scheme` TRUE TRUE TRUE FALSE FALSE (`on` 1990 1 1) EQUALS JUST `no limitation period -- a worker's dust-related condition (s 23AB)`
#ASSERT `Which time limit applies to my claim` `a dependants' action for a death under Wrongs Act Part III` `no compensation scheme` TRUE TRUE TRUE FALSE FALSE (`on` 1990 1 1) EQUALS JUST `no limitation period -- a worker's dust-related condition (s 23AB)`
-- s 23AB comes before s 40 (s 23AB(2); s 40 "Subject to section 23AB").
#ASSERT `Which time limit applies to my claim` `damages for my own personal injury` `Accident Compensation Act 1985 Part IV or Workplace Injury Rehabilitation and Compensation Act 2013 Part 7` TRUE TRUE TRUE FALSE FALSE (`on` 1990 1 1) EQUALS JUST `no limitation period -- a worker's dust-related condition (s 23AB)`
-- s 23AB does not name the estate: a survivor action for a worker's dust disease, no scheme, is outside Part IIA
-- (s 27B(2)(d)) and takes its period from the Administration and Probate Act 1958 (s 33): nothing here. Finding 2.
#ASSERT `Which time limit applies to my claim` `a survivor action by the estate of a person who died` `no compensation scheme` TRUE TRUE TRUE FALSE FALSE (`on` 1990 1 1) EQUALS NOTHING
-- s 27B(2)(a)-(c), s 40: the workplace and transport accident schemes keep the old Act.
#ASSERT `Which time limit applies to my claim` `damages for my own personal injury` `Accident Compensation Act 1985 Part IV or Workplace Injury Rehabilitation and Compensation Act 2013 Part 7` FALSE FALSE FALSE FALSE FALSE (`on` 2020 1 1) EQUALS JUST `the Act as in force before the 2002 amendments -- workplace or transport accident claim (s 40)`
#ASSERT `Which time limit applies to my claim` `damages for my own personal injury` `Transport Accident Act 1986 Part 6 or Part 10` FALSE FALSE FALSE FALSE FALSE (`on` 2020 1 1) EQUALS JUST `the Act as in force before the 2002 amendments -- workplace or transport accident claim (s 40)`
#ASSERT `Which time limit applies to my claim` `damages for my own personal injury` `Workers Compensation Act 1958` FALSE FALSE FALSE FALSE FALSE (`on` 1980 1 1) EQUALS JUST `the Act as in force before the 2002 amendments -- workplace or transport accident claim (s 40)`
-- A dust-related condition not within s 23AB (not a worker; or a worker outside those Parts): s 27B(2)(d), Part I.
#ASSERT `Which time limit applies to my claim` `damages for my own personal injury` `no compensation scheme` TRUE FALSE FALSE FALSE FALSE (`on` 2020 1 1) EQUALS JUST `Part I -- personal injury, 3 years (s 5(1AA), (1A))`
#ASSERT `Which time limit applies to my claim` `damages for my own personal injury` `no compensation scheme` TRUE TRUE FALSE FALSE FALSE (`on` 2020 1 1) EQUALS JUST `Part I -- personal injury, 3 years (s 5(1AA), (1A))`
-- Tobacco: s 27B(2)(e), Part I for the injured person; the dependants' Part III action is left to the Wrongs Act.
#ASSERT `Which time limit applies to my claim` `damages for my own personal injury` `no compensation scheme` FALSE FALSE FALSE TRUE FALSE (`on` 2020 1 1) EQUALS JUST `Part I -- personal injury, 3 years (s 5(1AA), (1A))`
#ASSERT `Which time limit applies to my claim` `a dependants' action for a death under Wrongs Act Part III` `no compensation scheme` FALSE FALSE FALSE TRUE FALSE (`on` 2020 1 1) EQUALS NOTHING
-- Child abuse: s 27P for the survivor's own action (even for abuse in 1990: s 27N(6), s 27P(2)) and the estate; s 27Q
-- for a Part III action.
#ASSERT `Which time limit applies to my claim` `damages for my own personal injury` `no compensation scheme` FALSE FALSE FALSE FALSE TRUE (`on` 1990 1 1) EQUALS JUST `no limitation period -- child abuse (s 27P)`
#ASSERT `Which time limit applies to my claim` `a survivor action by the estate of a person who died` `no compensation scheme` FALSE FALSE FALSE FALSE TRUE (`on` 2010 1 1) EQUALS JUST `no limitation period -- child abuse (s 27P)`
#ASSERT `Which time limit applies to my claim` `a dependants' action for a death under Wrongs Act Part III` `no compensation scheme` FALSE FALSE FALSE FALSE TRUE (`on` 2010 1 1) EQUALS JUST `3 years from discoverability, no long-stop -- a dependants' action for a death from child abuse (s 27Q)`
-- Child abuse inside a workplace scheme: Part IIA does not apply, so neither does Division 5 (s 27O(1)(a)): s 40.
#ASSERT `Which time limit applies to my claim` `damages for my own personal injury` `Accident Compensation Act 1985 Part IV or Workplace Injury Rehabilitation and Compensation Act 2013 Part 7` FALSE FALSE FALSE FALSE TRUE (`on` 2010 1 1) EQUALS JUST `the Act as in force before the 2002 amendments -- workplace or transport accident claim (s 40)`

-- s 27B: Part IIA applies, does not apply ("does not apply to"), or the claim is outside its scope.
#ASSERT `Does Part IIA apply to my claim` `damages for my own personal injury` `no compensation scheme` FALSE FALSE EQUALS JUST TRUE
#ASSERT `Does Part IIA apply to my claim` `a survivor action by the estate of a person who died` `no compensation scheme` FALSE FALSE EQUALS JUST TRUE
#ASSERT `Does Part IIA apply to my claim` `a dependants' action for a death under Wrongs Act Part III` `no compensation scheme` FALSE FALSE EQUALS JUST TRUE
#ASSERT `Does Part IIA apply to my claim` `damages for my own personal injury` `Transport Accident Act 1986 Part 6 or Part 10` FALSE FALSE EQUALS JUST FALSE
#ASSERT `Does Part IIA apply to my claim` `damages for my own personal injury` `no compensation scheme` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Does Part IIA apply to my claim` `damages for my own personal injury` `no compensation scheme` FALSE TRUE EQUALS JUST FALSE
#ASSERT `Does Part IIA apply to my claim` `contract or tort, not for death or personal injury and not defamation` `no compensation scheme` FALSE FALSE EQUALS NOTHING

§§ `Discoverability (s 27F)`

-- Injury: the latest of (a) 1 March 2021, (b) 10 June 2021, (c) 15 January 2022 -> 15 January 2022.
#ASSERT `On what day did my claim become discoverable` (`on` 2021 3 1) (`on` 2021 6 10) (`on` 2022 1 15) FALSE FALSE (`on` 2000 1 1) EQUALS `on` 2022 1 15
-- Injury, (a) last: 1 May 2021.
#ASSERT `On what day did my claim become discoverable` (`on` 2021 5 1) (`on` 2021 4 1) (`on` 2021 2 1) FALSE FALSE (`on` 2000 1 1) EQUALS `on` 2021 5 1
-- A death: (c) does not count; the later of (a) and (b) -> 10 June 2021.
#ASSERT `On what day did my claim become discoverable` (`on` 2021 3 1) (`on` 2021 6 10) (`on` 2030 1 1) TRUE FALSE (`on` 2021 3 1) EQUALS `on` 2021 6 10
-- Part III: not before the death (s 27F(4)): fault known 10 January, death 1 April 2021 -> 1 April 2021; fault known
-- 1 September 2021 -> 1 September 2021.
#ASSERT `On what day did my claim become discoverable` (`on` 2021 4 1) (`on` 2021 1 10) (`on` 2030 1 1) TRUE TRUE (`on` 2021 4 1) EQUALS `on` 2021 4 1
#ASSERT `On what day did my claim become discoverable` (`on` 2021 4 1) (`on` 2021 9 1) (`on` 2030 1 1) TRUE TRUE (`on` 2021 4 1) EQUALS `on` 2021 9 1
-- Part III where the input (a) is before the death: still the death, 1 April 2021.
#ASSERT `On what day did my claim become discoverable` (`on` 2021 2 1) (`on` 2021 1 10) (`on` 2030 1 1) TRUE TRUE (`on` 2021 4 1) EQUALS `on` 2021 4 1

§§ `The last day for my own injury (ss 27D, 27E, 27I, 27J)`

-- Adult (born 1980). Act 10 March 2020, discoverable 1 February 2021: (a) 1 February 2024; (b) 10 March 2032.
#ASSERT `What is the last day I can sue for my injury` (`on` 2020 3 10) (`on` 2021 2 1) (`on` 1980 1 1) FALSE FALSE `no legal incapacity` (`on` 2000 1 1) (`on` 2000 1 1) EQUALS JUST (`on` 2024 2 1)
-- The long-stop ends first: act 30 June 2010, discoverable 1 January 2020: (a) 1 January 2023; (b) 30 June 2022.
#ASSERT `What is the last day I can sue for my injury` (`on` 2010 6 30) (`on` 2020 1 1) (`on` 1970 1 1) FALSE FALSE `no legal incapacity` (`on` 2000 1 1) (`on` 2000 1 1) EQUALS JUST (`on` 2022 6 30)
-- s 27E: a minor at the act (born 5 May 2010, act 15 January 2020): 6 years -> 15 January 2026; (b) 15 January 2032.
#ASSERT `What is the last day I can sue for my injury` (`on` 2020 1 15) (`on` 2020 1 15) (`on` 2010 5 5) FALSE FALSE `no legal incapacity` (`on` 2000 1 1) (`on` 2000 1 1) EQUALS JUST (`on` 2026 1 15)
-- 18th birthday on the day of the act (born 15 January 2002): not a minor, 3 years -> 15 January 2023.
#ASSERT `What is the last day I can sue for my injury` (`on` 2020 1 15) (`on` 2020 1 15) (`on` 2002 1 15) FALSE FALSE `no legal incapacity` (`on` 2000 1 1) (`on` 2000 1 1) EQUALS JUST (`on` 2023 1 15)
-- Born 16 January 2002: still 17 on 15 January 2020, 6 years -> 15 January 2026.
#ASSERT `What is the last day I can sue for my injury` (`on` 2020 1 15) (`on` 2020 1 15) (`on` 2002 1 16) FALSE FALSE `no legal incapacity` (`on` 2000 1 1) (`on` 2000 1 1) EQUALS JUST (`on` 2026 1 15)
-- s 3(2): of unsound mind at the act, an adult: 6 years from 1 February 2021 -> 1 February 2027; (b) 10 March 2032.
#ASSERT `What is the last day I can sue for my injury` (`on` 2020 3 10) (`on` 2021 2 1) (`on` 1980 1 1) TRUE FALSE `no legal incapacity` (`on` 2000 1 1) (`on` 2000 1 1) EQUALS JUST (`on` 2027 2 1)
-- s 27I: born 20 April 2005, injured by a parent on 1 August 2012, actually discoverable 1 January 2013. Deemed
-- discoverable at 25, 20 April 2030; a minor, so 6 years -> 20 April 2036; long-stop 12 years from 25 -> 20 April 2042.
#ASSERT `What is the last day I can sue for my injury` (`on` 2012 8 1) (`on` 2013 1 1) (`on` 2005 4 20) FALSE TRUE `no legal incapacity` (`on` 2000 1 1) (`on` 2000 1 1) EQUALS JUST (`on` 2036 4 20)
-- s 27I, actually discoverable later, 1 July 2033: 1 July 2039 (before 20 April 2042).
#ASSERT `What is the last day I can sue for my injury` (`on` 2012 8 1) (`on` 2033 7 1) (`on` 2005 4 20) FALSE TRUE `no legal incapacity` (`on` 2000 1 1) (`on` 2000 1 1) EQUALS JUST (`on` 2039 7 1)
-- s 27I, discoverable 1 January 2038: 1 January 2044 is after the long-stop, 20 April 2042.
#ASSERT `What is the last day I can sue for my injury` (`on` 2012 8 1) (`on` 2038 1 1) (`on` 2005 4 20) FALSE TRUE `no legal incapacity` (`on` 2000 1 1) (`on` 2000 1 1) EQUALS JUST (`on` 2042 4 20)
-- The same child, injured by a stranger: 6 years from 1 January 2013 -> 1 January 2019; long-stop 1 August 2024.
#ASSERT `What is the last day I can sue for my injury` (`on` 2012 8 1) (`on` 2013 1 1) (`on` 2005 4 20) FALSE FALSE `no legal incapacity` (`on` 2000 1 1) (`on` 2000 1 1) EQUALS JUST (`on` 2019 1 1)
-- s 27J: incapacitated 1 January to 1 March 2022 (59 days, at least 28). (a) 1 February 2024 + 59 days -> 31 March 2024
-- (28 to 29 February 2024, 31 more to 31 March); (b) 10 March 2032 + 59 -> 8 May 2032. The earlier: 31 March 2024.
#ASSERT `What is the last day I can sue for my injury` (`on` 2020 3 10) (`on` 2021 2 1) (`on` 1980 1 1) FALSE FALSE `an incapacitated person without a guardian authorised to sue for them` (`on` 2022 1 1) (`on` 2022 3 1) EQUALS JUST (`on` 2024 3 31)
-- 27 days of incapacity (1 to 28 January 2022): not a legal incapacity, no suspension -> 1 February 2024.
#ASSERT `What is the last day I can sue for my injury` (`on` 2020 3 10) (`on` 2021 2 1) (`on` 1980 1 1) FALSE FALSE `an incapacitated person without a guardian authorised to sue for them` (`on` 2022 1 1) (`on` 2022 1 28) EQUALS JUST (`on` 2024 2 1)
-- 28 days (1 to 29 January 2022): suspended 28 days -> 29 February 2024.
#ASSERT `What is the last day I can sue for my injury` (`on` 2020 3 10) (`on` 2021 2 1) (`on` 1980 1 1) FALSE FALSE `an incapacitated person without a guardian authorised to sue for them` (`on` 2022 1 1) (`on` 2022 1 29) EQUALS JUST (`on` 2024 2 29)
-- Incapacity from 1 June 2020 to 1 March 2021, partly before discoverability: (a) counts only from 1 February 2021,
-- 28 days -> 29 February 2024; (b) counts 273 days from 1 June 2020 -> later. 29 February 2024.
#ASSERT `What is the last day I can sue for my injury` (`on` 2020 3 10) (`on` 2021 2 1) (`on` 1980 1 1) FALSE FALSE `an incapacitated person without a guardian authorised to sue for them` (`on` 2020 6 1) (`on` 2021 3 1) EQUALS JUST (`on` 2024 2 29)
-- Incapacity that ended before the act: nothing suspended -> 1 February 2024.
#ASSERT `What is the last day I can sue for my injury` (`on` 2020 3 10) (`on` 2021 2 1) (`on` 1980 1 1) FALSE FALSE `an incapacitated person without a guardian authorised to sue for them` (`on` 2019 1 1) (`on` 2019 2 1) EQUALS JUST (`on` 2024 2 1)
-- A minor not in a capable parent's custody for 10 days (1 to 11 January 2021), no 28-day minimum: 15 January 2026
-- + 10 -> 25 January 2026; long-stop 25 January 2032.
#ASSERT `What is the last day I can sue for my injury` (`on` 2020 1 15) (`on` 2020 1 15) (`on` 2010 5 5) FALSE FALSE `a minor not in the custody of a capable parent or guardian` (`on` 2021 1 1) (`on` 2021 1 11) EQUALS JUST (`on` 2026 1 25)
-- s 27N(4): act on 20 May 2003 -> nothing; on 21 May 2003 -> 3 years from 21 May 2003, 21 May 2006.
#ASSERT `What is the last day I can sue for my injury` (`on` 2003 5 20) (`on` 2003 5 20) (`on` 1970 1 1) FALSE FALSE `no legal incapacity` (`on` 2000 1 1) (`on` 2000 1 1) EQUALS NOTHING
#ASSERT `What is the last day I can sue for my injury` (`on` 2003 5 21) (`on` 2003 5 21) (`on` 1970 1 1) FALSE FALSE `no legal incapacity` (`on` 2000 1 1) (`on` 2000 1 1) EQUALS JUST (`on` 2006 5 21)
-- Discoverable on 29 February 2020: 3 years on there is no 29 February -> 28 February 2023.
#ASSERT `What is the last day I can sue for my injury` (`on` 2020 2 29) (`on` 2020 2 29) (`on` 1980 1 1) FALSE FALSE `no legal incapacity` (`on` 2000 1 1) (`on` 2000 1 1) EQUALS JUST (`on` 2023 2 28)

§§ `The last day after a death (ss 27G, 27H, 27I(3), 27Q)`

-- s 27G(b): adult deceased, act 10 January 2018, discoverable by the deceased 1 March 2019 (not more than 3 years
-- before the death on 1 January 2021: 1 March 2022 is after it), plaintiff appointed 1 June 2021 and discoverable by
-- the plaintiff 1 February 2021 (before appointment) -> deemed 1 June 2021; 3 years -> 1 June 2024; long-stop 10
-- January 2030.
#ASSERT `What is the last day the estate can sue for the deceased's injury` (`on` 2018 1 10) (`on` 1960 1 1) FALSE FALSE TRUE (`on` 2019 3 1) (`on` 2021 1 1) (`on` 2021 6 1) (`on` 2021 2 1) EQUALS JUST (`on` 2024 6 1)
-- s 27G(a): discoverable by the deceased 1 January 2017, more than 3 years before the death (1 January 2020 is before
-- 1 January 2021) -> deemed 1 January 2017; 3 years -> 1 January 2020 (act 1 June 2016, long-stop 1 June 2028).
#ASSERT `What is the last day the estate can sue for the deceased's injury` (`on` 2016 6 1) (`on` 1960 1 1) FALSE FALSE TRUE (`on` 2017 1 1) (`on` 2021 1 1) (`on` 2021 6 1) (`on` 2021 2 1) EQUALS JUST (`on` 2020 1 1)
-- Exactly 3 years before the death (1 January 2018; death 1 January 2021): not "more than" -> (b), 1 June 2021 -> 1
-- June 2024.
#ASSERT `What is the last day the estate can sue for the deceased's injury` (`on` 2016 6 1) (`on` 1960 1 1) FALSE FALSE TRUE (`on` 2018 1 1) (`on` 2021 1 1) (`on` 2021 6 1) (`on` 2021 2 1) EQUALS JUST (`on` 2024 6 1)
-- s 27G(c): discoverable by the plaintiff 1 February 2022, after appointment (1 June 2021) -> 1 February 2025.
#ASSERT `What is the last day the estate can sue for the deceased's injury` (`on` 2018 1 10) (`on` 1960 1 1) FALSE FALSE FALSE (`on` 2000 1 1) (`on` 2021 1 1) (`on` 2021 6 1) (`on` 2022 2 1) EQUALS JUST (`on` 2025 2 1)
-- s 27I(3): born 20 April 2005, injured by a parent 1 August 2012, died 1 May 2020 aged 15. s 27G day: appointed 1
-- September 2020, discoverable by the plaintiff 1 August 2020 -> 1 September 2020. The death stands for turning 25:
-- deemed the later of 1 May 2020 and 1 September 2020; a minor at the act, 6 years -> 1 September 2026; long-stop 12
-- years from the death -> 1 May 2032. Answer 1 September 2026.
#ASSERT `What is the last day the estate can sue for the deceased's injury` (`on` 2012 8 1) (`on` 2005 4 20) FALSE TRUE FALSE (`on` 2000 1 1) (`on` 2020 5 1) (`on` 2020 9 1) (`on` 2020 8 1) EQUALS JUST (`on` 2026 9 1)
-- The same, injured by a stranger: 6 years -> 1 September 2026, but the long-stop from the act is 1 August 2024.
#ASSERT `What is the last day the estate can sue for the deceased's injury` (`on` 2012 8 1) (`on` 2005 4 20) FALSE FALSE FALSE (`on` 2000 1 1) (`on` 2020 5 1) (`on` 2020 9 1) (`on` 2020 8 1) EQUALS JUST (`on` 2024 8 1)
-- Act before 21 May 2003: nothing (s 27N(4)).
#ASSERT `What is the last day the estate can sue for the deceased's injury` (`on` 2003 5 20) (`on` 1960 1 1) FALSE FALSE FALSE (`on` 2000 1 1) (`on` 2021 1 1) (`on` 2021 6 1) (`on` 2021 2 1) EQUALS NOTHING

-- Part III: act 1 May 2019, death 10 February 2020, discoverable that day: 3 years -> 10 February 2023; long-stop
-- from the death (s 27H) 10 February 2032.
#ASSERT `What is the last day dependants can sue for the death` (`on` 2019 5 1) (`on` 2020 2 10) (`on` 2020 2 10) FALSE FALSE EQUALS JUST (`on` 2023 2 10)
-- Discoverable input before the death: not before the death (s 27F(4)) -> 10 February 2023.
#ASSERT `What is the last day dependants can sue for the death` (`on` 2019 5 1) (`on` 2020 2 10) (`on` 2019 6 1) FALSE FALSE EQUALS JUST (`on` 2023 2 10)
-- Discoverable 1 January 2030: 1 January 2033 is after the long-stop from the death, 10 February 2032.
#ASSERT `What is the last day dependants can sue for the death` (`on` 2019 5 1) (`on` 2020 2 10) (`on` 2030 1 1) FALSE FALSE EQUALS JUST (`on` 2032 2 10)
-- s 27Q: a death from child abuse, act 1995, death 10 February 2020, discoverable 1 January 2030: no long-stop, and
-- s 27N(4) does not apply (s 27N(6)) -> 1 January 2033.
#ASSERT `What is the last day dependants can sue for the death` (`on` 1995 1 1) (`on` 2020 2 10) (`on` 2030 1 1) TRUE FALSE EQUALS JUST (`on` 2033 1 1)
-- A child killed by a parent (s 27I against s 27H): nothing. Finding 4.
#ASSERT `What is the last day dependants can sue for the death` (`on` 2019 5 1) (`on` 2020 2 10) (`on` 2020 2 10) FALSE TRUE EQUALS NOTHING
-- Act before 21 May 2003, not child abuse: nothing (s 27N(4)).
#ASSERT `What is the last day dependants can sue for the death` (`on` 2003 5 20) (`on` 2020 2 10) (`on` 2020 2 10) FALSE FALSE EQUALS NOTHING

§§ `Extension by the court (ss 27K-27M, 23A)`

#ASSERT `Can I apply to a court to extend my time limit` `Part IIA -- 3 or 6 years from discoverability or the 12-year long-stop, whichever ends first (ss 27D-27J)` EQUALS JUST TRUE
-- s 27N(5): also for an act before 21 May 2003.
#ASSERT `Can I apply to a court to extend my time limit` `Part IIA, but no longer than the law before Part IIA -- act before 21 May 2003 (s 27N(4))` EQUALS JUST TRUE
-- s 27O(4): Division 3 applies to a s 27Q action.
#ASSERT `Can I apply to a court to extend my time limit` `3 years from discoverability, no long-stop -- a dependants' action for a death from child abuse (s 27Q)` EQUALS JUST TRUE
-- s 23A: personal injury outside Part IIA.
#ASSERT `Can I apply to a court to extend my time limit` `Part I -- personal injury, 3 years (s 5(1AA), (1A))` EQUALS JUST TRUE
-- s 27O(2): Divisions 2 and 3 do not apply to a s 27P action.
#ASSERT `Can I apply to a court to extend my time limit` `no limitation period -- child abuse (s 27P)` EQUALS JUST FALSE
-- No power in the text: nothing.
#ASSERT `Can I apply to a court to extend my time limit` `no limitation period -- a worker's dust-related condition (s 23AB)` EQUALS NOTHING
#ASSERT `Can I apply to a court to extend my time limit` `the Act as in force before the 2002 amendments -- workplace or transport accident claim (s 40)` EQUALS NOTHING
#ASSERT `Can I apply to a court to extend my time limit` `Part I -- contract or tort, 6 years (s 5(1)(a))` EQUALS NOTHING

-- s 27K(3): 1 February 2024 extended by 90 days -> 1 May 2024 (28 to 29 February, 31 to 31 March, 30 to 30 April,
-- 1 to 1 May); no order -> 1 February 2024.
#ASSERT `What is my last day after an extension by the court` (`on` 2024 2 1) TRUE 90 EQUALS `on` 2024 5 1
#ASSERT `What is my last day after an extension by the court` (`on` 2024 2 1) FALSE 90 EQUALS `on` 2024 2 1

§§ `Child abuse: earlier judgments and settlements (ss 27QA-27QF, 27R, 27T)`

-- No earlier outcome: s 27QA is not needed (s 27P).
#ASSERT `Can I sue again on my child abuse claim` `no earlier judgment or settlement` (`on` 2010 1 1) FALSE FALSE EQUALS NOTHING
-- s 27QA(1): dismissed as out of time in 2010, the period having expired before 1 July 2015.
#ASSERT `Can I sue again on my child abuse claim` `dismissed as out of time, or an extension refused` (`on` 2010 5 1) TRUE FALSE EQUALS JUST TRUE
-- Dismissed as out of time in 2016, period not expired before 1 July 2015, outside the window: s 27QA silent.
#ASSERT `Can I sue again on my child abuse claim` `dismissed as out of time, or an extension refused` (`on` 2016 3 1) FALSE FALSE EQUALS NOTHING
-- s 27QA(1A): another judgment in the window; the window's edges 13 November 2024 and 25 February 2026.
#ASSERT `Can I sue again on my child abuse claim` `another judgment or order, including a dismissal` (`on` 2025 1 10) FALSE FALSE EQUALS JUST TRUE
#ASSERT `Can I sue again on my child abuse claim` `another judgment or order, including a dismissal` (`on` 2024 11 12) FALSE FALSE EQUALS NOTHING
#ASSERT `Can I sue again on my child abuse claim` `another judgment or order, including a dismissal` (`on` 2024 11 13) FALSE FALSE EQUALS JUST TRUE
#ASSERT `Can I sue again on my child abuse claim` `another judgment or order, including a dismissal` (`on` 2026 2 25) FALSE FALSE EQUALS JUST TRUE
#ASSERT `Can I sue again on my child abuse claim` `another judgment or order, including a dismissal` (`on` 2026 2 26) FALSE FALSE EQUALS NOTHING
-- s 27QA(2) with s 27OA: settled before 1 July 2018 (30 June 2018 in; 1 July 2018 out), or in the window.
#ASSERT `Can I sue again on my child abuse claim` `settled by a settlement agreement` (`on` 2018 6 30) FALSE FALSE EQUALS JUST TRUE
#ASSERT `Can I sue again on my child abuse claim` `settled by a settlement agreement` (`on` 2018 7 1) FALSE FALSE EQUALS NOTHING
#ASSERT `Can I sue again on my child abuse claim` `settled by a settlement agreement` (`on` 2025 6 1) FALSE FALSE EQUALS JUST TRUE
-- s 27QA(3): a National Redress Scheme release -> the section does not apply.
#ASSERT `Can I sue again on my child abuse claim` `settled by a settlement agreement` (`on` 2010 1 1) FALSE TRUE EQUALS JUST FALSE

-- Setting aside (ss 27QB(3), 27QD(3), 27R(2), (3)), each with "just and reasonable" found unless said.
-- A settlement no court gave effect to: the court hearing the action may (fork line 5).
#ASSERT `Can the court set aside my earlier judgment or settlement` FALSE FALSE FALSE FALSE TRUE
-- The County Court setting aside its own judgment: yes; another court's: no.
#ASSERT `Can the court set aside my earlier judgment or settlement` TRUE TRUE FALSE FALSE TRUE
#ASSERT NOT (`Can the court set aside my earlier judgment or settlement` TRUE FALSE FALSE FALSE TRUE)
-- The Supreme Court setting aside another court's judgment: yes; the High Court's: no.
#ASSERT `Can the court set aside my earlier judgment or settlement` TRUE FALSE FALSE TRUE TRUE
#ASSERT NOT (`Can the court set aside my earlier judgment or settlement` TRUE FALSE TRUE TRUE TRUE)
-- Not just and reasonable: no.
#ASSERT NOT (`Can the court set aside my earlier judgment or settlement` TRUE TRUE FALSE FALSE FALSE)

-- s 27QF: once set aside, the payer cannot recover on that basis; nothing set aside: silent.
#ASSERT `Can the payer recover what it paid me` TRUE EQUALS JUST FALSE
#ASSERT `Can the payer recover what it paid me` FALSE EQUALS NOTHING
-- ss 27QC(2), 27QE(2).
#ASSERT `Can the court take into account what I was paid before` TRUE TRUE
#ASSERT NOT (`Can the court take into account what I was paid before` TRUE FALSE)
#ASSERT NOT (`Can the court take into account what I was paid before` FALSE TRUE)

-- s 27T: in the window yes; outside, or none of the heads, silent.
#ASSERT `Do the 2026 changes apply to my child abuse claim` `the claim was settled` (`on` 2025 1 1) EQUALS JUST TRUE
#ASSERT `Do the 2026 changes apply to my child abuse claim` `the claim was determined by a court, including by dismissal` (`on` 2024 11 12) EQUALS NOTHING
#ASSERT `Do the 2026 changes apply to my child abuse claim` `the claim was determined by a court, including by dismissal` (`on` 2024 11 13) EQUALS JUST TRUE
#ASSERT `Do the 2026 changes apply to my child abuse claim` `the claim was commenced and was still open on 25 February 2026` (`on` 2026 2 25) EQUALS JUST TRUE
#ASSERT `Do the 2026 changes apply to my child abuse claim` `the claim was commenced and was still open on 25 February 2026` (`on` 2026 2 26) EQUALS NOTHING
#ASSERT `Do the 2026 changes apply to my child abuse claim` `none of these` (`on` 2025 1 1) EQUALS NOTHING

§§ `Outside Part IIA (ss 5, 23, 27)`

-- s 5(1)(a): contract, accrued 1 July 2019 -> 1 July 2025.
#ASSERT `What is the last day I can sue outside Part IIA` `contract or tort, other than personal injury` (`on` 2019 7 1) (`on` 2000 1 1) FALSE (`on` 2000 1 1) FALSE (`on` 2000 1 1) FALSE EQUALS `on` 2025 7 1
-- s 5(1AA): personal injury, accrued 1 July 2019 -> 1 July 2022.
#ASSERT `What is the last day I can sue outside Part IIA` `personal injury` (`on` 2019 7 1) (`on` 2000 1 1) FALSE (`on` 2000 1 1) FALSE (`on` 2000 1 1) FALSE EQUALS `on` 2022 7 1
-- s 5(1A): a disease, first known (with its cause) 15 September 2020 -> 15 September 2023 (the 2015 accrual is ignored).
#ASSERT `What is the last day I can sue outside Part IIA` `personal injury that is a disease or disorder` (`on` 2015 1 1) (`on` 2020 9 15) FALSE (`on` 2000 1 1) FALSE (`on` 2000 1 1) FALSE EQUALS `on` 2023 9 15
-- s 27: fraud discovered 1 March 2022 -> 6 years from then, 1 March 2028; discovered before the accrual -> 1 July 2025.
#ASSERT `What is the last day I can sue outside Part IIA` `contract or tort, other than personal injury` (`on` 2019 7 1) (`on` 2000 1 1) TRUE (`on` 2022 3 1) FALSE (`on` 2000 1 1) FALSE EQUALS `on` 2028 3 1
#ASSERT `What is the last day I can sue outside Part IIA` `contract or tort, other than personal injury` (`on` 2019 7 1) (`on` 2000 1 1) TRUE (`on` 2018 3 1) FALSE (`on` 2000 1 1) FALSE EQUALS `on` 2025 7 1
-- s 23(1): a minor when the contract claim accrued, turned 18 on 1 May 2024 -> 6 years from then, 1 May 2030 (later
-- than 1 July 2025); claiming through a person not under a disability (proviso (a)) -> 1 July 2025.
#ASSERT `What is the last day I can sue outside Part IIA` `contract or tort, other than personal injury` (`on` 2019 7 1) (`on` 2000 1 1) FALSE (`on` 2000 1 1) TRUE (`on` 2024 5 1) FALSE EQUALS `on` 2030 5 1
#ASSERT `What is the last day I can sue outside Part IIA` `contract or tort, other than personal injury` (`on` 2019 7 1) (`on` 2000 1 1) FALSE (`on` 2000 1 1) TRUE (`on` 2024 5 1) TRUE EQUALS `on` 2025 7 1
-- s 23(1) with s 5(1AA): the "less number of years" proviso excepts s 5(1AA), so 6 years from ceasing, 1 January 2020
-- -> 1 January 2026 (later than 1 July 2022).
#ASSERT `What is the last day I can sue outside Part IIA` `personal injury` (`on` 2019 7 1) (`on` 2000 1 1) FALSE (`on` 2000 1 1) TRUE (`on` 2020 1 1) FALSE EQUALS `on` 2026 1 1
-- A disability that ended the day the claim accrued: 6 years from 1 July 2019 = 1 July 2025, later than 1 July 2022.
#ASSERT `What is the last day I can sue outside Part IIA` `personal injury` (`on` 2019 7 1) (`on` 2000 1 1) FALSE (`on` 2000 1 1) TRUE (`on` 2019 7 1) FALSE EQUALS `on` 2025 7 1

§§ `In time, and the bar as a rule`

#ASSERT `Am I in time if I start my action on this day` (`on` 2024 2 1) (`on` 2024 2 1)
#ASSERT NOT (`Am I in time if I start my action on this day` (`on` 2024 2 2) (`on` 2024 2 1))

-- 1 February 2021 to 1 February 2024 is 365 + 365 + 365 = 1095 days (29 February 2024 comes after).
#ASSERT `days from` (`on` 2021 2 1) `to` (`on` 2024 2 1) EQUALS 1095
-- Brought on day 1095 (the last day): in time. On day 1096, or never: barred.
#ASSERT EVALTRACE (`the limitation bar` 1095) 0 (LIST (EVENT `the plaintiff` `bring the action` 1095)) EQUALS FULFILLED
#ASSERT EVALTRACE (`the limitation bar` 1095) 0 (LIST (EVENT `the plaintiff` `bring the action` 10)) EQUALS FULFILLED
#ASSERT NOT (`ends fulfilled` (EVALTRACE (`the limitation bar` 1095) 0 (LIST (EVENT `the plaintiff` `bring the action` 1096))))
#ASSERT NOT (`ends fulfilled` (EVALTRACE (`the limitation bar` 1095) 0 (LIST (WAITUNTIL 1096))))
