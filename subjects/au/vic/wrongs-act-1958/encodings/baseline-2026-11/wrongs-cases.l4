IMPORT prelude
IMPORT `wrongs-core`
IMPORT `wrongs-seat`

-- Cases for the injured person's seat (wrongs-seat.l4) and the core's rules (wrongs-core.l4).
-- Every expected value is worked by hand from the deposited text (and, for s 28G, the Gazette row), with the
-- arithmetic or the reason in the comment; none is copied from the encoding's output. Each exported question has
-- cases with its edges: the threshold and either side of it, the last day and the day after, a cap and above it.
-- Breached traces are asserted with CONSIDER ... WHEN FULFILLED (EVALTRACE ... EQUALS cannot test a breach).

§ `Cases`

GIVEN `the outcome` IS A DEONTIC `Wrongs party` `Wrongs action`
GIVETH A BOOLEAN
`ends fulfilled` `the outcome` MEANS
    CONSIDER `the outcome`
    WHEN FULFILLED THEN TRUE
    OTHERWISE FALSE

GIVEN `y` IS A NUMBER, `m` IS A NUMBER, `d` IS A NUMBER
GIVETH A DATE
`on` `y` `m` `d` MEANS DATE_FROM_DMY `d` `m` `y`

§§ `Part VB applies (s 28C)`

-- Damages for injury caused by another's fault, no exclusion: the Part applies.
#ASSERT `Does Part VB apply to my award of personal injury damages` TRUE FALSE `no other scheme` FALSE EQUALS JUST TRUE
-- Not personal injury damages: s 28C(1) is silent.
#ASSERT `Does Part VB apply to my award of personal injury damages` FALSE FALSE `no other scheme` FALSE EQUALS NOTHING
-- s 28C(2)(a): intentional harm or sexual misconduct.
#ASSERT `Does Part VB apply to my award of personal injury damages` TRUE TRUE `no other scheme` FALSE EQUALS JUST FALSE
-- s 28C(2)(b), (c), (2A), (m), (n).
#ASSERT `Does Part VB apply to my award of personal injury damages` TRUE FALSE `Transport Accident Act 1986 Part 3, 6 or 10` FALSE EQUALS JUST FALSE
#ASSERT `Does Part VB apply to my award of personal injury damages` TRUE FALSE `Workplace Injury Rehabilitation and Compensation Act 2013 Part 7` FALSE EQUALS JUST FALSE
#ASSERT `Does Part VB apply to my award of personal injury damages` TRUE FALSE `Victims of Crime (Financial Assistance Scheme) Act 2022` FALSE EQUALS JUST FALSE
#ASSERT `Does Part VB apply to my award of personal injury damages` TRUE FALSE `superannuation or insurance` FALSE EQUALS JUST FALSE
#ASSERT `Does Part VB apply to my award of personal injury damages` TRUE FALSE `no other scheme` TRUE EQUALS JUST FALSE
-- WIRC Act Part 5 is not in the s 28C(2) list (Part 7 is): finding 3.
#ASSERT `Does Part VB apply to my award of personal injury damages` TRUE FALSE `Workplace Injury Rehabilitation and Compensation Act 2013 Part 5` FALSE EQUALS JUST TRUE

§§ `The caps (ss 28F-28IE)`

-- s 28F(2): 3 x $2000 = $6000; 3 x $1987.50 = $5962.50.
#ASSERT `What is the most I can be awarded for each week of lost earnings` 2000 EQUALS 6000
#ASSERT `What is the most I can be awarded for each week of lost earnings` 1987.5 EQUALS 5962.5

-- s 28G with the Gazette's s 340(b)(ii) row: $759 510 for 2025-26, $783 000 for 2026-27; outside: nothing.
#ASSERT `What is the most I can be awarded for non-economic loss` (`on` 2025 6 30) EQUALS NOTHING
#ASSERT `What is the most I can be awarded for non-economic loss` (`on` 2025 7 1) EQUALS JUST 759510
#ASSERT `What is the most I can be awarded for non-economic loss` (`on` 2026 6 30) EQUALS JUST 759510
#ASSERT `What is the most I can be awarded for non-economic loss` (`on` 2026 7 1) EQUALS JUST 783000
#ASSERT `What is the most I can be awarded for non-economic loss` (`on` 2027 6 30) EQUALS JUST 783000
#ASSERT `What is the most I can be awarded for non-economic loss` (`on` 2027 7 1) EQUALS NOTHING
-- The Act's own printed figure, for the record.
#ASSERT `the Act's own s 28G figure` EQUALS 577050

-- s 28I(2): no percentage prescribed -> 5; prescribed 3 -> 3.
#ASSERT `What discount rate applies to my future economic loss` FALSE 3 EQUALS 5
#ASSERT `What discount rate applies to my future economic loss` TRUE 3 EQUALS 3

-- s 28IA: (2) bars only care that is both under 6 hours a week and under 6 months.
#ASSERT `Can I be awarded damages for gratuitous attendant care` TRUE TRUE TRUE 6 1 EQUALS TRUE
#ASSERT `Can I be awarded damages for gratuitous attendant care` TRUE TRUE TRUE 5 5 EQUALS FALSE
#ASSERT `Can I be awarded damages for gratuitous attendant care` TRUE TRUE TRUE 5.99 5.99 EQUALS FALSE
#ASSERT `Can I be awarded damages for gratuitous attendant care` TRUE TRUE TRUE 5 6 EQUALS TRUE
#ASSERT `Can I be awarded damages for gratuitous attendant care` TRUE TRUE TRUE 2 24 EQUALS TRUE
-- s 28IA(1)(a)-(c): each condition needed.
#ASSERT `Can I be awarded damages for gratuitous attendant care` FALSE TRUE TRUE 40 12 EQUALS FALSE
#ASSERT `Can I be awarded damages for gratuitous attendant care` TRUE FALSE TRUE 40 12 EQUALS FALSE
#ASSERT `Can I be awarded damages for gratuitous attendant care` TRUE TRUE FALSE 40 12 EQUALS FALSE

-- s 28IB: 40 hours or more -> AWE ($2000); under 40 -> hours x $2000 / 40 = $50 an hour.
#ASSERT `What is the most I can be awarded per week for gratuitous attendant care` 40 2000 EQUALS 2000
#ASSERT `What is the most I can be awarded per week for gratuitous attendant care` 60 2000 EQUALS 2000
#ASSERT `What is the most I can be awarded per week for gratuitous attendant care` 39 2000 EQUALS 1950
#ASSERT `What is the most I can be awarded per week for gratuitous attendant care` 20 2000 EQUALS 1000

§§ `Loss of capacity to care for dependants (ss 28ID-28IF)`

GIVEN `kind` IS A `Kind of dependant`, `cared` IS A BOOLEAN, `hours` IS A NUMBER, `months` IS A NUMBER
      `recovered` IS A BOOLEAN, `dust` IS A BOOLEAN, `health` IS A BOOLEAN
GIVETH A BOOLEAN
`care case` `kind` `cared` `hours` `months` `recovered` `dust` `health` MEANS
    `Can I be awarded damages for loss of my capacity to care for my dependants` `kind` `cared` TRUE `hours` `months` TRUE `recovered` `dust` `health`

-- All of (2)(a)-(d) met, at the edges (6 hours, 6 months: "at least").
#ASSERT `care case` `persons dependent on the claimant when the liability arose` TRUE 6 6 FALSE FALSE FALSE EQUALS TRUE
#ASSERT `care case` `persons dependent on the claimant when the liability arose` TRUE 5 6 FALSE FALSE FALSE EQUALS FALSE
#ASSERT `care case` `persons dependent on the claimant when the liability arose` TRUE 6 5 FALSE FALSE FALSE EQUALS FALSE
-- (2)(a) only for existing dependants: no care before -> no; unborn children -> (a) does not ask.
#ASSERT `care case` `persons dependent on the claimant when the liability arose` FALSE 10 12 FALSE FALSE FALSE EQUALS FALSE
#ASSERT `care case` `unborn children of the claimant at that time, born after it` FALSE 10 12 FALSE FALSE FALSE EQUALS TRUE
-- (4): the dependant already recovered.
#ASSERT `care case` `persons dependent on the claimant when the liability arose` TRUE 10 12 TRUE FALSE FALSE EQUALS FALSE
-- (2)(b) and (d) each needed.
#ASSERT `Can I be awarded damages for loss of my capacity to care for my dependants` `persons dependent on the claimant when the liability arose` TRUE FALSE 10 12 TRUE FALSE FALSE FALSE EQUALS FALSE
#ASSERT `Can I be awarded damages for loss of my capacity to care for my dependants` `persons dependent on the claimant when the liability arose` TRUE TRUE 10 12 FALSE FALSE FALSE FALSE EQUALS FALSE
-- s 28IF: a dust or tobacco claim not about a health service -> (2)-(5) do not apply; about a health service -> they do.
#ASSERT `care case` `persons dependent on the claimant when the liability arose` TRUE 5 2 FALSE TRUE FALSE EQUALS TRUE
#ASSERT `care case` `persons dependent on the claimant when the liability arose` TRUE 5 2 FALSE TRUE TRUE EQUALS FALSE

-- s 28IE: same measure as s 28IB; s 28IF -> nothing.
#ASSERT `What is the most I can be awarded per week for loss of my capacity to care` 40 2000 FALSE FALSE EQUALS JUST 2000
#ASSERT `What is the most I can be awarded per week for loss of my capacity to care` 10 2000 FALSE FALSE EQUALS JUST 500
#ASSERT `What is the most I can be awarded per week for loss of my capacity to care` 10 2000 TRUE FALSE EQUALS NOTHING
#ASSERT `What is the most I can be awarded per week for loss of my capacity to care` 10 2000 TRUE TRUE EQUALS JUST 500

§§ `Threshold level and significant injury (ss 28LB, 28LF, 28LK)`

-- s 28LB: other injury "more than 5"; spinal "5 or more"; psychiatric "10 or more".
#ASSERT `Does my impairment satisfy the threshold level` `other injury` 5 EQUALS FALSE
#ASSERT `Does my impairment satisfy the threshold level` `other injury` 5.5 EQUALS TRUE
#ASSERT `Does my impairment satisfy the threshold level` `other injury` 6 EQUALS TRUE
#ASSERT `Does my impairment satisfy the threshold level` `spinal injury` 4 EQUALS FALSE
#ASSERT `Does my impairment satisfy the threshold level` `spinal injury` 5 EQUALS TRUE
#ASSERT `Does my impairment satisfy the threshold level` `psychiatric injury` 9 EQUALS FALSE
#ASSERT `Does my impairment satisfy the threshold level` `psychiatric injury` 10 EQUALS TRUE

-- s 28LK(1): 5 per cent NAL or less -> 0; more -> that percentage.
#ASSERT `What degree of impairment is assessed for my hearing loss` 4 EQUALS 0
#ASSERT `What degree of impairment is assessed for my hearing loss` 5 EQUALS 0
#ASSERT `What degree of impairment is assessed for my hearing loss` 5.5 EQUALS 5.5
#ASSERT `What degree of impairment is assessed for my hearing loss` 6 EQUALS 6
-- With s 28LB: 6 per cent hearing impairment (an "other" injury) satisfies the threshold; 5 does not.
#ASSERT `Does my impairment satisfy the threshold level` `other injury` (`What degree of impairment is assessed for my hearing loss` 6) EQUALS TRUE
#ASSERT `Does my impairment satisfy the threshold level` `other injury` (`What degree of impairment is assessed for my hearing loss` 5) EQUALS FALSE

GIVEN `psych` IS A BOOLEAN, `panel` IS A `Medical Panel determination`, `amp` IS A BOOLEAN, `lna` IS A BOOLEAN
      `foetus` IS A BOOLEAN, `child` IS A BOOLEAN, `breast` IS A BOOLEAN
GIVETH A BOOLEAN
`significant case` `psych` `panel` `amp` `lna` `foetus` `child` `breast` MEANS
    `Is my injury a significant injury` `psych` `panel` `amp` `lna` `foetus` `child` `breast` FALSE FALSE FALSE

-- Nothing shown: not significant.
#ASSERT `significant case` FALSE `no Medical Panel determination` FALSE FALSE FALSE FALSE FALSE EQUALS FALSE
-- s 28LF(1)(a), (aa): a practitioner's assessment or a s 28LNA certificate.
#ASSERT `significant case` FALSE `no Medical Panel determination` TRUE FALSE FALSE FALSE FALSE EQUALS TRUE
#ASSERT `significant case` TRUE `no Medical Panel determination` FALSE TRUE FALSE FALSE FALSE EQUALS TRUE
-- "unless a Medical Panel has made a determination", and s 28LZH(2): the Panel's "not satisfied" governs.
#ASSERT `significant case` FALSE `the Panel determined the threshold level is not satisfied` TRUE FALSE FALSE FALSE FALSE EQUALS FALSE
#ASSERT `significant case` FALSE `the Panel determined the threshold level is satisfied` FALSE FALSE FALSE FALSE FALSE EQUALS TRUE
-- Fork line 3: the Panel's "not satisfied" governs even for loss of a breast.
#ASSERT `significant case` FALSE `the Panel determined the threshold level is not satisfied` FALSE FALSE FALSE FALSE TRUE EQUALS FALSE
-- s 28LF(1)(c), (d): loss of a foetus or a breast, for an injury other than psychiatric.
#ASSERT `significant case` FALSE `no Medical Panel determination` FALSE FALSE TRUE FALSE FALSE EQUALS TRUE
#ASSERT `significant case` FALSE `no Medical Panel determination` FALSE FALSE FALSE FALSE TRUE EQUALS TRUE
#ASSERT `significant case` TRUE `no Medical Panel determination` FALSE FALSE TRUE FALSE FALSE EQUALS FALSE
-- s 28LF(1)(ca), fork line 2: counts for a psychiatric injury too.
#ASSERT `significant case` TRUE `no Medical Panel determination` FALSE FALSE FALSE TRUE FALSE EQUALS TRUE
#ASSERT `significant case` FALSE `no Medical Panel determination` FALSE FALSE FALSE TRUE FALSE EQUALS TRUE
-- s 28LF(3): waiver, deemed, court determination.
#ASSERT `Is my injury a significant injury` TRUE `no Medical Panel determination` FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS TRUE
#ASSERT `Is my injury a significant injury` FALSE `no Medical Panel determination` FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS TRUE
#ASSERT `Is my injury a significant injury` FALSE `no Medical Panel determination` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS TRUE

-- ss 28LC, 28LE.
#ASSERT `Can I recover damages for non-economic loss under Part VBA` FALSE `no other scheme` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Can I recover damages for non-economic loss under Part VBA` FALSE `no other scheme` FALSE FALSE FALSE EQUALS JUST FALSE
-- s 28LC(2)(a), (b), (c), (e), (3): the Part does not apply -> nothing.
#ASSERT `Can I recover damages for non-economic loss under Part VBA` TRUE `no other scheme` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `Can I recover damages for non-economic loss under Part VBA` FALSE `Transport Accident Act 1986 Part 3, 6 or 10` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `Can I recover damages for non-economic loss under Part VBA` FALSE `Workplace Injury Rehabilitation and Compensation Act 2013 Part 5` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `Can I recover damages for non-economic loss under Part VBA` FALSE `no other scheme` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `Can I recover damages for non-economic loss under Part VBA` FALSE `no other scheme` FALSE TRUE FALSE EQUALS NOTHING
-- Not in the s 28LC(2) list: WIRC Part 7, victims of crime, emergency compensation (finding 3).
#ASSERT `Can I recover damages for non-economic loss under Part VBA` FALSE `Workplace Injury Rehabilitation and Compensation Act 2013 Part 7` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Can I recover damages for non-economic loss under Part VBA` FALSE `emergency, police, juries or education compensation` FALSE FALSE TRUE EQUALS JUST TRUE

-- s 28LZN.
#ASSERT `Can the court determine that my injury is significant` TRUE FALSE TRUE EQUALS TRUE
#ASSERT `Can the court determine that my injury is significant` TRUE FALSE FALSE EQUALS FALSE
#ASSERT `Can the court determine that my injury is significant` FALSE TRUE TRUE EQUALS TRUE
#ASSERT `Can the court determine that my injury is significant` FALSE FALSE TRUE EQUALS FALSE

§§ `Division 4 deadlines and status (ss 28LO-28LWE, 28LV)`

-- 2 March 2026 + 60 days: 29 days to 31 March, 30 more to 30 April, 1 May is the 60th.
#ASSERT `By what day must the respondent answer my waiver request` (`on` 2026 3 2) EQUALS `on` 2026 5 1
-- 15 December 2026 + 60: 16 to 31 December, 31 to 31 January, 13 to 13 February 2027.
#ASSERT `By what day must the respondent answer my waiver request` (`on` 2026 12 15) EQUALS `on` 2027 2 13
-- 20 February 2026 + 14: 8 to 28 February, 6 to 6 March. In 2028 (leap): 9 to 29 February, 5 to 5 March.
#ASSERT `By what day must I reply to a respondent who says it is not the proper respondent` (`on` 2026 2 20) EQUALS `on` 2026 3 6
#ASSERT `By what day must I reply to a respondent who says it is not the proper respondent` (`on` 2028 2 20) EQUALS `on` 2028 3 5
-- 10 April 2026 + 60: 20 to 30 April, 31 to 31 May, 9 to 9 June.
#ASSERT `By what day must the respondent respond to my certificate of assessment` (`on` 2026 4 10) EQUALS `on` 2026 6 9

-- Status, received 10 April 2026, deadline 9 June 2026.
GIVEN `responded` IS A BOOLEAN, `response day` IS A DATE, `response` IS A `Response to a certificate`
      `referred` IS A BOOLEAN, `referral day` IS A DATE, `asked on` IS A DATE
GIVETH AN `Assessment status`
`status case` `responded` `response day` `response` `referred` `referral day` `asked on` MEANS
    `Has the respondent accepted my assessment` (`on` 2026 4 10) `responded` `response day` `response` `referred` `referral day` `asked on`

-- Accepted in writing in time.
#ASSERT `status case` TRUE (`on` 2026 5 1) `the respondent accepts the assessment` FALSE (`on` 2026 5 1) (`on` 2026 5 2) EQUALS `accepted`
-- No response: on the 60th day, not yet; the day after, deemed accepted (s 28LW(4)).
#ASSERT `status case` FALSE (`on` 2026 1 1) `the respondent accepts the assessment` FALSE (`on` 2026 1 1) (`on` 2026 6 9) EQUALS `not yet decided`
#ASSERT `status case` FALSE (`on` 2026 1 1) `the respondent accepts the assessment` FALSE (`on` 2026 1 1) (`on` 2026 6 10) EQUALS `deemed accepted`
-- A response on the 61st day comes too late: deemed accepted.
#ASSERT `status case` TRUE (`on` 2026 6 10) `the respondent will refer a medical question to a Medical Panel` TRUE (`on` 2026 6 10) (`on` 2026 6 11) EQUALS `deemed accepted`
-- "Will refer", referred on the 60th day: referred; referred on the 61st: deemed accepted (s 28LWE(3)).
#ASSERT `status case` TRUE (`on` 2026 5 1) `the respondent will refer a medical question to a Medical Panel` TRUE (`on` 2026 6 9) (`on` 2026 6 20) EQUALS `referred to a Medical Panel`
#ASSERT `status case` TRUE (`on` 2026 5 1) `the respondent will refer a medical question to a Medical Panel` TRUE (`on` 2026 6 10) (`on` 2026 6 20) EQUALS `deemed accepted`
#ASSERT `status case` TRUE (`on` 2026 5 1) `the respondent will refer a medical question to a Medical Panel` FALSE (`on` 2026 1 1) (`on` 2026 6 9) EQUALS `not yet decided`
#ASSERT `status case` TRUE (`on` 2026 5 1) `the respondent will refer a medical question to a Medical Panel` FALSE (`on` 2026 1 1) (`on` 2026 6 10) EQUALS `deemed accepted`
-- Further information or proper respondent: their own clocks (the rule below).
#ASSERT `status case` TRUE (`on` 2026 5 1) `the respondent asks for further information` FALSE (`on` 2026 1 1) (`on` 2026 7 1) EQUALS `on another path (further information or the proper respondent)`
#ASSERT `status case` TRUE (`on` 2026 5 1) `the respondent says it is not the proper respondent` FALSE (`on` 2026 1 1) (`on` 2026 7 1) EQUALS `on another path (further information or the proper respondent)`

-- s 28LV: 3 months after. 15 January -> 15 April; 30 November 2026 -> 28 February 2027; 30 November 2027 -> 29 February 2028.
#ASSERT `Until what day is my limitation period suspended` (`on` 2026 1 15) EQUALS `on` 2026 4 15
#ASSERT `Until what day is my limitation period suspended` (`on` 2026 11 30) EQUALS `on` 2027 2 28
#ASSERT `Until what day is my limitation period suspended` (`on` 2027 11 30) EQUALS `on` 2028 2 29

§§ `Division 4 as rules (EVALTRACE)`

-- s 28LO: an answer on day 60 is in time; silence past day 60 -> cannot be waived.
#ASSERT EVALTRACE `s 28LO-28LQ -- the respondent must answer a request to waive the assessment within 60 days` 0 (LIST (EVENT `the respondent` (`respond in writing to the waiver request` `agrees to waive the assessment`) 60)) EQUALS FULFILLED
#ASSERT EVALTRACE `s 28LO-28LQ -- the respondent must answer a request to waive the assessment within 60 days` 0 (LIST (EVENT `the respondent` (`respond in writing to the waiver request` `asks the claimant to obtain an assessment`) 1)) EQUALS FULFILLED
#ASSERT NOT (`ends fulfilled` (EVALTRACE `s 28LO-28LQ -- the respondent must answer a request to waive the assessment within 60 days` 0 (LIST (WAITUNTIL 61))))
-- s 28LP: further information asked on day 10, given on day 30; the second answer is due by day 90.
#ASSERT EVALTRACE `s 28LO-28LQ -- the respondent must answer a request to waive the assessment within 60 days` 0 (LIST (EVENT `the respondent` (`respond in writing to the waiver request` `asks for further information`) 10), (EVENT `the claimant` `give the further information` 30), (EVENT `the respondent` (`respond in writing to the waiver request` `agrees to waive the assessment`) 90)) EQUALS FULFILLED
#ASSERT NOT (`ends fulfilled` (EVALTRACE `s 28LO-28LQ -- the respondent must answer a request to waive the assessment within 60 days` 0 (LIST (EVENT `the respondent` (`respond in writing to the waiver request` `asks for further information`) 10), (EVENT `the claimant` `give the further information` 30), (EVENT `the respondent` (`respond in writing to the waiver request` `agrees to waive the assessment`) 91))))
-- s 28LQ: "not the proper respondent" on day 20; the claimant's notice by day 34; the respondent's reply by day 48.
#ASSERT EVALTRACE `s 28LO-28LQ -- the respondent must answer a request to waive the assessment within 60 days` 0 (LIST (EVENT `the respondent` (`respond in writing to the waiver request` `says it is not the proper respondent`) 20), (EVENT `the claimant` (`give notice about the proper respondent` TRUE) 34), (EVENT `the respondent` `respond in writing to the notice` 48)) EQUALS FULFILLED
#ASSERT NOT (`ends fulfilled` (EVALTRACE `s 28LO-28LQ -- the respondent must answer a request to waive the assessment within 60 days` 0 (LIST (EVENT `the respondent` (`respond in writing to the waiver request` `says it is not the proper respondent`) 20), (EVENT `the claimant` (`give notice about the proper respondent` TRUE) 34), (EVENT `the respondent` `respond in writing to the notice` 49))))
#ASSERT NOT (`ends fulfilled` (EVALTRACE `s 28LO-28LQ -- the respondent must answer a request to waive the assessment within 60 days` 0 (LIST (EVENT `the respondent` (`respond in writing to the waiver request` `says it is not the proper respondent`) 20), (EVENT `the claimant` (`give notice about the proper respondent` TRUE) 35))))
-- The claimant accepts it is not the proper respondent: the matter ends with that respondent.
#ASSERT EVALTRACE `s 28LO-28LQ -- the respondent must answer a request to waive the assessment within 60 days` 0 (LIST (EVENT `the respondent` (`respond in writing to the waiver request` `says it is not the proper respondent`) 20), (EVENT `the claimant` (`give notice about the proper respondent` FALSE) 30)) EQUALS FULFILLED

-- s 28LW: a response on day 59 or 60 is in time; silence past day 60 -> deemed accepted.
#ASSERT EVALTRACE `s 28LW-28LWB -- the respondent must respond to a certificate of assessment within 60 days` 0 (LIST (EVENT `the respondent` (`respond in writing to the certificate of assessment` `the respondent accepts the assessment`) 59)) EQUALS FULFILLED
#ASSERT EVALTRACE `s 28LW-28LWB -- the respondent must respond to a certificate of assessment within 60 days` 0 (LIST (EVENT `the respondent` (`respond in writing to the certificate of assessment` `the respondent will refer a medical question to a Medical Panel`) 60)) EQUALS FULFILLED
#ASSERT NOT (`ends fulfilled` (EVALTRACE `s 28LW-28LWB -- the respondent must respond to a certificate of assessment within 60 days` 0 (LIST (WAITUNTIL 61))))
-- s 28LWA: information asked day 5, given day 10, response due by day 70.
#ASSERT EVALTRACE `s 28LW-28LWB -- the respondent must respond to a certificate of assessment within 60 days` 0 (LIST (EVENT `the respondent` (`respond in writing to the certificate of assessment` `the respondent asks for further information`) 5), (EVENT `the claimant` `give the further information` 10), (EVENT `the respondent` (`respond in writing to the certificate of assessment` `the respondent accepts the assessment`) 70)) EQUALS FULFILLED
#ASSERT NOT (`ends fulfilled` (EVALTRACE `s 28LW-28LWB -- the respondent must respond to a certificate of assessment within 60 days` 0 (LIST (EVENT `the respondent` (`respond in writing to the certificate of assessment` `the respondent asks for further information`) 5), (EVENT `the claimant` `give the further information` 10), (WAITUNTIL 71))))
-- s 28LWB: "not the proper respondent" on day 1, notice requiring a response on day 15, reply due by day 29.
#ASSERT EVALTRACE `s 28LW-28LWB -- the respondent must respond to a certificate of assessment within 60 days` 0 (LIST (EVENT `the respondent` (`respond in writing to the certificate of assessment` `the respondent says it is not the proper respondent`) 1), (EVENT `the claimant` (`give notice about the proper respondent` TRUE) 15), (EVENT `the respondent` `respond in writing to the notice` 29)) EQUALS FULFILLED
#ASSERT NOT (`ends fulfilled` (EVALTRACE `s 28LW-28LWB -- the respondent must respond to a certificate of assessment within 60 days` 0 (LIST (EVENT `the respondent` (`respond in writing to the certificate of assessment` `the respondent says it is not the proper respondent`) 1), (EVENT `the claimant` (`give notice about the proper respondent` TRUE) 15), (EVENT `the respondent` `respond in writing to the notice` 30))))

