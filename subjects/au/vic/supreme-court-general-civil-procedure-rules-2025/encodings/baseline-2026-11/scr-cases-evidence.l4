IMPORT prelude
IMPORT `scr-dates`
IMPORT `scr-duties`
IMPORT `scr-evidence`

-- Supreme Court (General Civil Procedure) Rules 2025 (Vic) -- worked cases for the party's questions about discovery,
-- medical and expert evidence, trial and damages (scr-evidence.l4). Every expected value was worked by hand from the
-- deposited text; none was copied from the encoding's output. Each assertion is a claim about the ENCODING on stated
-- facts, not about the law. The facts are illustrative.
-- Calendar used: 2 November 2026 is a Monday; 1 December 2026 a Tuesday; 1 January 2027 a Friday; 1 February 2027 and
-- 1 March 2027 Mondays. The Christmas vacation (24 December to 9 January) is 17 days.
-- BASELINE ENCODING. Not for public use as advice. See NOTES.md.

§ `cases`

`d` MEANS `the calendar date`

§§ `Order 29 -- discovery`

-- Arguments: writ, Court order, possession, aware, rely, hurts mine, hurts or helps another, they have it, extra copy.
#ASSERT `Must I discover this document` TRUE FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Must I discover this document` TRUE FALSE TRUE TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Must I discover this document` TRUE FALSE TRUE TRUE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Must I discover this document` TRUE FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Must I discover this document` TRUE FALSE TRUE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Must I discover this document` TRUE FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Must I discover this document` TRUE FALSE TRUE TRUE TRUE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Must I discover this document` TRUE FALSE TRUE TRUE TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Must I discover this document` FALSE FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Must I discover this document` TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING

-- Notice served Monday 2 November 2026 after the pleadings closed (1 November): 42 days, Monday 14 December. Notice served
-- 2 November before the pleadings closed on 16 November: taken served on 17 November; 18 to 30 November (13), 1 to 23
-- December (23), then 10 to 15 January (6): Friday 15 January 2027. Served on the closing day: also taken as the 17th.
#ASSERT `By when must I make discovery` (`d` 2 11 2026) (`d` 1 11 2026) EQUALS `d` 14 12 2026
#ASSERT `By when must I make discovery` (`d` 2 11 2026) (`d` 16 11 2026) EQUALS `d` 15 1 2027
#ASSERT `By when must I make discovery` (`d` 16 11 2026) (`d` 16 11 2026) EQUALS `d` 15 1 2027

-- Arguments: notice served, pleadings closed, made, day made, today.
#ASSERT `Did I make discovery in time` (`d` 2 11 2026) (`d` 1 11 2026) TRUE (`d` 14 12 2026) (`d` 20 12 2026) EQUALS `taken in time`
#ASSERT `Did I make discovery in time` (`d` 2 11 2026) (`d` 1 11 2026) TRUE (`d` 15 12 2026) (`d` 20 12 2026) EQUALS `not taken in time`
#ASSERT `Did I make discovery in time` (`d` 2 11 2026) (`d` 1 11 2026) FALSE (`d` 1 1 2026) (`d` 14 12 2026) EQUALS `still open`
#ASSERT `Did I make discovery in time` (`d` 2 11 2026) (`d` 1 11 2026) FALSE (`d` 1 1 2026) (`d` 15 12 2026) EQUALS `not taken in time`
#ASSERT `Did I make discovery in time` (`d` 2 11 2026) (`d` 16 11 2026) FALSE (`d` 1 1 2026) (`d` 15 1 2027) EQUALS `still open`

-- 7 days (more than 5, so weekends count): served Monday 2 November, Monday 9; served Wednesday 18 November, Wednesday 25.
#ASSERT `By when must I appoint a time for inspection` (`d` 2 11 2026) EQUALS `d` 9 11 2026
#ASSERT `By when must I appoint a time for inspection` (`d` 18 11 2026) EQUALS `d` 25 11 2026

-- Default notice served Monday 2 November 2026: 7 days, Monday 9 November.
-- Arguments: side, served, made, day made, today.
#ASSERT `What can follow the default notice` `the plaintiff in the discovery` (`d` 2 11 2026) TRUE (`d` 9 11 2026) (`d` 12 11 2026) EQUALS `nothing under rule 29.12.1, discovery made in time`
#ASSERT `What can follow the default notice` `the plaintiff in the discovery` (`d` 2 11 2026) FALSE (`d` 1 1 2026) (`d` 9 11 2026) EQUALS `still time to make discovery after the default notice`
#ASSERT `What can follow the default notice` `the plaintiff in the discovery` (`d` 2 11 2026) FALSE (`d` 1 1 2026) (`d` 10 11 2026) EQUALS `the proceeding may be dismissed`
#ASSERT `What can follow the default notice` `a defendant in the discovery` (`d` 2 11 2026) FALSE (`d` 1 1 2026) (`d` 10 11 2026) EQUALS `the defence may be struck out, and judgment in default of defence may follow`
#ASSERT `What can follow the default notice` `the plaintiff in the discovery` (`d` 2 11 2026) TRUE (`d` 10 11 2026) (`d` 11 11 2026) EQUALS `the proceeding may be dismissed`

#ASSERT `Must I discover documents I got later` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Must I discover documents I got later` FALSE TRUE EQUALS NOTHING

