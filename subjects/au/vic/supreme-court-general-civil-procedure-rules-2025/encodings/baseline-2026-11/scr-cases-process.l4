#ASSERT `Do the 2025 Rules apply to my case` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Do the 2025 Rules apply to my case` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Do the 2025 Rules apply to my case` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Do the 2025 Rules apply to my case` FALSE FALSE FALSE EQUALS NOTHING

