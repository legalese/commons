§§ `ss 68, 132 -- the fee`

#ASSERT `Will VCAT act on my application without the fee` FALSE FALSE FALSE FALSE EQUALS `VCAT takes no further action on my application until the fee is paid, waived, or reduced and the reduced fee paid (s 68(3))`
#ASSERT `Will VCAT act on my application without the fee` TRUE FALSE FALSE FALSE EQUALS `VCAT acts on my application: the fee is paid, waived, postponed, or reduced and the reduced fee paid (s 68(3), (3A))`
#ASSERT `Will VCAT act on my application without the fee` FALSE TRUE FALSE FALSE EQUALS `VCAT acts on my application: the fee is paid, waived, postponed, or reduced and the reduced fee paid (s 68(3), (3A))`
#ASSERT `Will VCAT act on my application without the fee` FALSE FALSE TRUE FALSE EQUALS `VCAT acts on my application: the fee is paid, waived, postponed, or reduced and the reduced fee paid (s 68(3), (3A))`
#ASSERT `Will VCAT act on my application without the fee` FALSE FALSE FALSE TRUE EQUALS `VCAT acts on my application: the fee is paid, waived, postponed, or reduced and the reduced fee paid (s 68(3), (3A))`

