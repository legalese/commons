IMPORT prelude
IMPORT `vic-nouns`
IMPORT `vic-interpretation-time`
IMPORT `vic-part1-preliminary`
IMPORT `vic-part2-acts-a`
IMPORT `vic-part2-acts-b`

-- Tests for Parts I and II (ss 4 to 21A). Each expected value is written by hand from the section named beside it.
-- JUST FALSE is used where the section says no in its own words, where its own "where" or "if" condition fails, and where a contrary intention it allows for appears (the section then does not give the consequence).
-- NOTHING is used where the section is silent, where the case falls outside a limit the section sets with no "only", and where the answer is not a Boolean; the table of unless-clause sites in NOTES.md says which way each is taken.

§ `s 4`

-- s 4(1)(a): applies to Acts and instruments whether passed or made before or after the commencement (1 July 1984, s 2); a contrary intention switches it off.
#ASSERT `s4(1)(a) the provisions of this Act extend and apply to the enactment` VicAnAct (Date 1 1 1950) FALSE EQUALS JUST TRUE
#ASSERT `s4(1)(a) the provisions of this Act extend and apply to the enactment` VicAnAct (Date 1 1 2020) FALSE EQUALS JUST TRUE
#ASSERT `s4(1)(a) the provisions of this Act extend and apply to the enactment` VicASubordinateInstrument (Date 30 6 1984) FALSE EQUALS JUST TRUE
#ASSERT `s4(1)(a) the provisions of this Act extend and apply to the enactment` VicASubordinateInstrument (Date 2 7 1984) TRUE EQUALS JUST FALSE
#ASSERT `s4(1)(b) the provisions of this Act apply to the interpretation of this Act` FALSE EQUALS JUST TRUE
#ASSERT `s4(1)(b) the provisions of this Act apply to the interpretation of this Act` TRUE EQUALS JUST TRUE
-- s 4(2): a rule of construction that applies and is not inconsistent stays; an inconsistent one does not; one that does not apply is not covered.
#ASSERT `s4(2) this Act leaves the rule of construction applying` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s4(2) this Act leaves the rule of construction applying` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s4(2) this Act leaves the rule of construction applying` FALSE FALSE EQUALS NOTHING
-- s 4(3): an Act passed before 1 July 1984 is not affected; one passed on that day is outside the words of s 4(3).
#ASSERT `s4(3) the provision affects the construction of the enactment` TRUE (Date 30 6 1984) TRUE EQUALS JUST FALSE
#ASSERT `s4(3) the provision affects the construction of the enactment` TRUE (Date 1 7 1984) TRUE EQUALS NOTHING
#ASSERT `s4(3) the provision affects the construction of the enactment` FALSE (Date 30 6 1984) TRUE EQUALS NOTHING

§ `s 5`

#ASSERT `s5 this Act binds the Crown` VicCrownInRightOfTheStateOfVictoria FALSE EQUALS JUST TRUE
#ASSERT `s5 this Act binds the Crown` VicCrownInRightOfTheStateOfVictoria TRUE EQUALS JUST TRUE
#ASSERT `s5 this Act binds the Crown` VicCrownInAnotherCapacity TRUE EQUALS JUST TRUE
#ASSERT `s5 this Act binds the Crown` VicCrownInAnotherCapacity FALSE EQUALS JUST FALSE

§ `ss 6 to 9`

#ASSERT `s6(1) how a provision of an Act is construed against the limit of the legislative power of Victoria` TRUE EQUALS VicOperatesToTheExtentNotInExcessAndTheRemainderIsNotAffected
#ASSERT `s6(1) how a provision of an Act is construed against the limit of the legislative power of Victoria` FALSE EQUALS VicOperatesFully
#ASSERT `s6(2) s 6 takes the place of a provision of the Act on its construction or extent of operation` TRUE EQUALS JUST FALSE
#ASSERT `s6(2) s 6 takes the place of a provision of the Act on its construction or extent of operation` FALSE EQUALS NOTHING
#ASSERT `s7 a section of an Act has effect as a substantive enactment` TRUE EQUALS JUST TRUE
#ASSERT `s7 a section of an Act has effect as a substantive enactment` FALSE EQUALS JUST TRUE
#ASSERT `s8 an Act may be amended or repealed in the session` TRUE EQUALS JUST TRUE
#ASSERT `s8 an Act may be amended or repealed in the session` FALSE EQUALS NOTHING
-- s 9(1): the first Act of a year is number 1; with 6 already assented to, the next is 7.
#ASSERT `s9(1) number of an Act among the Acts of its calendar year` 0 EQUALS 1
#ASSERT `s9(1) number of an Act among the Acts of its calendar year` 6 EQUALS 7
-- s 9(2): before 1 January 1986 the number only; on or after, the year and number.
#ASSERT `s9(2) the way of referring to an Act is sufficient` (Date 31 12 1985) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s9(2) the way of referring to an Act is sufficient` (Date 1 1 1986) FALSE TRUE EQUALS JUST TRUE
#ASSERT `s9(2) the way of referring to an Act is sufficient` (Date 1 1 1986) TRUE FALSE EQUALS NOTHING
#ASSERT `s9(2) the way of referring to an Act is sufficient` (Date 31 12 1985) FALSE TRUE EQUALS NOTHING
#ASSERT `s9(3) a failure to number the Acts of a year in a regular series affects the operation or effect of an Act passed that year` TRUE EQUALS JUST FALSE
#ASSERT `s9(3) a failure to number the Acts of a year in a regular series affects the operation or effect of an Act passed that year` FALSE EQUALS NOTHING

§ `s 10`

#ASSERT `s10(1) this section permits citing the Act in that form` TRUE VicByTheShortTitleTheActAuthorises EQUALS JUST TRUE
#ASSERT `s10(1) this section permits citing the Act in that form` FALSE VicByTheShortTitleTheActAuthorises EQUALS NOTHING
#ASSERT `s10(1) this section permits citing the Act in that form` FALSE VicByTheTitleBeforeTheEnactingWordsOrPreamble EQUALS JUST TRUE
#ASSERT `s10(1) this section permits citing the Act in that form` TRUE VicByTheTitleBeforeTheEnactingWordsOrPreamble EQUALS JUST FALSE
#ASSERT `s10(2) the title before the enacting words forms part of the Act` FALSE EQUALS JUST TRUE
#ASSERT `s10(2) the title before the enacting words forms part of the Act` TRUE EQUALS JUST FALSE
#ASSERT `s10(2AA) a citation by the title is sufficient for s 10(1)` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s10(2AA) a citation by the title is sufficient for s 10(1)` TRUE TRUE EQUALS NOTHING
#ASSERT `s10(2AA) a citation by the title is sufficient for s 10(1)` FALSE FALSE EQUALS NOTHING
#ASSERT `s10(2A) word the Clerk of the Parliaments substitutes for the word Bill in the title` TRUE EQUALS JUST "Act"
#ASSERT `s10(2A) word the Clerk of the Parliaments substitutes for the word Bill in the title` FALSE EQUALS NOTHING
#ASSERT `s10(2B) the alteration to give effect to s 10(2A) is an amendment of the Bill` TRUE EQUALS JUST FALSE
#ASSERT `s10(2B) the alteration to give effect to s 10(2A) is an amendment of the Bill` FALSE EQUALS NOTHING
-- s 10(3): passed on or after 1 September 1985 with no short title: the long title is not part of the Act.
#ASSERT `s10(3) the long title of the Bill forms part of the Act` (Date 1 9 1985) FALSE EQUALS JUST FALSE
#ASSERT `s10(3) the long title of the Bill forms part of the Act` (Date 31 8 1985) FALSE EQUALS NOTHING
#ASSERT `s10(3) the long title of the Bill forms part of the Act` (Date 1 9 1985) TRUE EQUALS NOTHING

§ `s 10A and s 13`

#ASSERT `s10A(1) the Act confers power on the Governor in Council to fix a day by proclamation` TRUE EQUALS JUST TRUE
#ASSERT `s10A(1) the Act confers power on the Governor in Council to fix a day by proclamation` FALSE EQUALS JUST FALSE
#ASSERT `s10A(2) the Act confers power to fix the days by proclamation in that way` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s10A(2) the Act confers power to fix the days by proclamation in that way` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s13(1) s 13 applies` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s13(1) s 13 applies` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s13(1) s 13 applies` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s13(2) the power may be exercised after the passing and before the commencement` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s13(2) the power may be exercised after the passing and before the commencement` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s13(2) the power may be exercised after the passing and before the commencement` FALSE FALSE EQUALS JUST FALSE
-- the exercise confers no right or obligation before commencement, save where necessary or expedient
#ASSERT `s13(2) the exercise of the power confers a right or imposes an obligation before the commencement` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s13(2) the exercise of the power confers a right or imposes an obligation before the commencement` TRUE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s13(2) the exercise of the power confers a right or imposes an obligation before the commencement` TRUE FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s13(2) the exercise of the power confers a right or imposes an obligation before the commencement` TRUE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s13(2) the exercise of the power confers a right or imposes an obligation before the commencement` FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s13(3) an appointee or body may exercise the power before the commencement as if the Act were in operation` TRUE EQUALS JUST TRUE
#ASSERT `s13(3) an appointee or body may exercise the power before the commencement as if the Act were in operation` FALSE EQUALS JUST FALSE
-- s 13(4): the term of office cannot begin before the commencement day, and the bar is gone on that day.
#ASSERT `s13(4) the term of office cannot yet begin` (Date 30 6 2027) (Date 1 7 2027) EQUALS JUST TRUE
#ASSERT `s13(4) the term of office cannot yet begin` (Date 1 7 2027) (Date 1 7 2027) EQUALS JUST FALSE
#ASSERT `s13(4) the term of office cannot yet begin` (Date 2 7 2027) (Date 1 7 2027) EQUALS JUST FALSE

§ `s 14`

-- s 14(1): an earlier repealed Act is not revived, unless the contrary intention expressly appears.
#ASSERT `s14(1) the Act or provision that the ending Act or provision had repealed is construed as revived` VicRepealed FALSE EQUALS JUST FALSE
#ASSERT `s14(1) the Act or provision that the ending Act or provision had repealed is construed as revived` VicExpires FALSE EQUALS JUST FALSE
#ASSERT `s14(1) the Act or provision that the ending Act or provision had repealed is construed as revived` VicLapses FALSE EQUALS JUST FALSE
#ASSERT `s14(1) the Act or provision that the ending Act or provision had repealed is construed as revived` VicOtherwiseCeasesToHaveEffect FALSE EQUALS JUST FALSE
#ASSERT `s14(1) the Act or provision that the ending Act or provision had repealed is construed as revived` VicRepealed TRUE EQUALS NOTHING
-- s 14(2)(c) to (f)
#ASSERT `s14(2)(c)-(f) the repeal, amendment, expiry or lapsing revives or affects the thing` VicAnythingNotInForceOrExistingAtThatTime FALSE EQUALS JUST FALSE
#ASSERT `s14(2)(c)-(f) the repeal, amendment, expiry or lapsing revives or affects the thing` VicThePreviousOperationOrAnythingDulyDoneOrSuffered FALSE EQUALS JUST FALSE
#ASSERT `s14(2)(c)-(f) the repeal, amendment, expiry or lapsing revives or affects the thing` VicARightPrivilegeObligationOrLiabilityAcquiredAccruedOrIncurred FALSE EQUALS JUST FALSE
#ASSERT `s14(2)(c)-(f) the repeal, amendment, expiry or lapsing revives or affects the thing` VicAnImmunityOrIndemnityConferredOrGiven FALSE EQUALS JUST FALSE
#ASSERT `s14(2)(c)-(f) the repeal, amendment, expiry or lapsing revives or affects the thing` VicAPenaltyForfeitureOrPunishmentIncurredForAnOffence FALSE EQUALS JUST FALSE
#ASSERT `s14(2)(c)-(f) the repeal, amendment, expiry or lapsing revives or affects the thing` VicAPenaltyForfeitureOrPunishmentIncurredForAnOffence TRUE EQUALS NOTHING
#ASSERT `s14(2)(c)-(f) the repeal, amendment, expiry or lapsing revives or affects the thing` VicAnythingElse FALSE EQUALS NOTHING
-- s 14(2)(g) and the closing words
#ASSERT `s14(2)(g) the repeal, amendment, expiry or lapsing affects an investigation, legal proceeding or remedy` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s14(2)(g) the repeal, amendment, expiry or lapsing affects an investigation, legal proceeding or remedy` TRUE TRUE EQUALS NOTHING
#ASSERT `s14(2)(g) the repeal, amendment, expiry or lapsing affects an investigation, legal proceeding or remedy` FALSE FALSE EQUALS NOTHING
#ASSERT `s14(2) the proceeding may be instituted, continued or enforced, or the penalty imposed, as if the Act had not been repealed` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s14(2) the proceeding may be instituted, continued or enforced, or the penalty imposed, as if the Act had not been repealed` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s14(2) the proceeding may be instituted, continued or enforced, or the penalty imposed, as if the Act had not been repealed` FALSE FALSE EQUALS NOTHING
-- s 14(2A)
#ASSERT `s14(2A) the repeal, expiry or lapsing of the provision ends the effect it had` VicProvisionOfASavingsOrTransitionalNature FALSE EQUALS JUST FALSE
#ASSERT `s14(2A) the repeal, expiry or lapsing of the provision ends the effect it had` VicProvisionThatGivesEffectToAnythingThatIsOrMayOtherwiseBeIneffective FALSE EQUALS JUST FALSE
#ASSERT `s14(2A) the repeal, expiry or lapsing of the provision ends the effect it had` VicProvisionThatRequiresAReferenceToBeConstruedAsAReferenceToAnotherEntity FALSE EQUALS JUST FALSE
#ASSERT `s14(2A) the repeal, expiry or lapsing of the provision ends the effect it had` VicProvisionOfASavingsOrTransitionalNature TRUE EQUALS NOTHING
#ASSERT `s14(2A) the repeal, expiry or lapsing of the provision ends the effect it had` VicAnyOtherProvision FALSE EQUALS NOTHING
-- s 14(3)
#ASSERT `s14(3) the way of repealing is within the references to repeal in s 14(1), (2) and (2A)` VicRepealedByImplication EQUALS JUST TRUE
#ASSERT `s14(3) the way of repealing is within the references to repeal in s 14(1), (2) and (2A)` VicRepealedByAbrogatingOrLimitingItsEffect EQUALS JUST TRUE
#ASSERT `s14(3) the way of repealing is within the references to repeal in s 14(1), (2) and (2A)` VicRepealedByExcludingItsApplication EQUALS JUST TRUE
#ASSERT `s14(3) the way of repealing is within the references to repeal in s 14(1), (2) and (2A)` VicRepealedExpressly EQUALS NOTHING

§ `ss 15 and 16`

#ASSERT `s15(1) the ending of the amending Act or provision affects the direct amendments` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s15(1) the ending of the amending Act or provision affects the direct amendments` TRUE TRUE EQUALS NOTHING
#ASSERT `s15(1) the ending of the amending Act or provision affects the direct amendments` FALSE FALSE EQUALS NOTHING
#ASSERT `s15(2) s 15(1) applies to the amendment` TRUE EQUALS JUST TRUE
#ASSERT `s15(2) s 15(1) applies to the amendment` FALSE EQUALS NOTHING
#ASSERT `s16(a) a reference to the repealed Act or provision is construed as a reference to the re-enacted Act or provision` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s16(a) a reference to the repealed Act or provision is construed as a reference to the re-enacted Act or provision` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s16(a) a reference to the repealed Act or provision is construed as a reference to the re-enacted Act or provision` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s16(b) the instrument made or thing done has effect as if made or done under the re-enacted Act or provision` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s16(b) the instrument made or thing done has effect as if made or done under the re-enacted Act or provision` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s16(b) the instrument made or thing done has effect as if made or done under the re-enacted Act or provision` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s16(b) the instrument made or thing done has effect as if made or done under the re-enacted Act or provision` FALSE FALSE TRUE EQUALS JUST FALSE

§ `ss 17 and 18`

#ASSERT `s17(1) a reference in an Act to another enactment is construed as a reference to` VicHasBeenAmended FALSE EQUALS JUST VicTheEnactmentAsAmendedAndInForceForTheTimeBeing
#ASSERT `s17(1) a reference in an Act to another enactment is construed as a reference to` VicHasBeenReEnactedOrReMade FALSE EQUALS JUST VicTheEnactmentAsReEnactedOrReMadeAndInForceForTheTimeBeing
#ASSERT `s17(1) a reference in an Act to another enactment is construed as a reference to` VicHasBeenReEnactedOrReMadeAndSubsequentlyAmended FALSE EQUALS JUST VicTheEnactmentAsReEnactedOrReMadeAndSubsequentlyAmendedAndInForceForTheTimeBeing
#ASSERT `s17(1) a reference in an Act to another enactment is construed as a reference to` VicHasBeenRepealedAndNotReEnactedOrReMade FALSE EQUALS JUST VicTheEnactmentAsInForceImmediatelyBeforeItsRepeal
#ASSERT `s17(1) a reference in an Act to another enactment is construed as a reference to` VicStillAsFirstMade FALSE EQUALS NOTHING
#ASSERT `s17(1) a reference in an Act to another enactment is construed as a reference to` VicHasBeenAmended TRUE EQUALS NOTHING
#ASSERT `s17(1A) a reference in an Act to a provision that has been renumbered or relocated is construed as a reference to` TRUE TRUE FALSE EQUALS JUST VicTheProvisionAsRenumberedOrRelocatedAndInForceForTheTimeBeing
#ASSERT `s17(1A) a reference in an Act to a provision that has been renumbered or relocated is construed as a reference to` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s17(1A) a reference in an Act to a provision that has been renumbered or relocated is construed as a reference to` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s17(1A) a reference in an Act to a provision that has been renumbered or relocated is construed as a reference to` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s17(2)(a) a reference to an Act in s 17 includes` VicACommonwealthAct EQUALS JUST TRUE
#ASSERT `s17(2)(a) a reference to an Act in s 17 includes` VicAnActOrOrdinanceOfAnotherStateOrOfATerritory EQUALS JUST TRUE
#ASSERT `s17(2)(a) a reference to an Act in s 17 includes` VicAnythingElse2 EQUALS NOTHING
#ASSERT `s17(2)(b) a reference to a subordinate instrument in s 17 includes` VicAnInstrumentOfALegislativeCharacterMadeUnderACommonwealthAct EQUALS JUST TRUE
#ASSERT `s17(2)(b) a reference to a subordinate instrument in s 17 includes` VicAnInstrumentOfALegislativeCharacterMadeUnderAnActOrOrdinanceOfAnotherStateOrOfATerritory EQUALS JUST TRUE
#ASSERT `s17(2)(b) a reference to a subordinate instrument in s 17 includes` VicACommonwealthAct EQUALS NOTHING
#ASSERT `s18 the reference is construed as a reference to one contained in a subordinate instrument made under that Act` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s18 the reference is construed as a reference to one contained in a subordinate instrument made under that Act` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s18 the reference is construed as a reference to one contained in a subordinate instrument made under that Act` FALSE FALSE EQUALS NOTHING

