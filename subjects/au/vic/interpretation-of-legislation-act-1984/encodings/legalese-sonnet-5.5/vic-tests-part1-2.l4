#ASSERT `s19(1) a reference to a unit by number is construed as a reference to the unit` VicSubSubclause FALSE FALSE FALSE FALSE EQUALS JUST VicInTheSubSubclauseOfTheSubclauseInWhichTheReferenceOccurs
#ASSERT `s19(1) a reference to a unit by number is construed as a reference to the unit` VicChapter FALSE FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s19(1) a reference to a unit by number is construed as a reference to the unit` VicSubsection FALSE FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s19(2) the designation is a number for s 19(1)` VicANumberExpressedInWordsOrFigures EQUALS JUST TRUE
#ASSERT `s19(2) the designation is a number for s 19(1)` VicALetter EQUALS JUST TRUE
#ASSERT `s19(2) the designation is a number for s 19(1)` VicACombinationOfANumberSoExpressedAndALetter EQUALS JUST TRUE
#ASSERT `s19(2) the designation is a number for s 19(1)` VicSomethingElseAsADesignation EQUALS JUST FALSE
-- s 20: a portion from position 3 to position 7 takes in both ends.
#ASSERT `s20 the division at a position is within the portion cited` 3 7 3 FALSE EQUALS JUST TRUE
#ASSERT `s20 the division at a position is within the portion cited` 3 7 7 FALSE EQUALS JUST TRUE
#ASSERT `s20 the division at a position is within the portion cited` 3 7 5 FALSE EQUALS JUST TRUE
