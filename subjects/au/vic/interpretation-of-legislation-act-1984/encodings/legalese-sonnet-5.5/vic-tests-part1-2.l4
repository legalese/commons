§ `s 21 and s 21A`

#ASSERT `s21(1) a reference in an old Act is construed as a reference to` VicTheColonyOrTheTerritoryOrDistrictOfPortPhillip TRUE FALSE EQUALS JUST "Victoria"
#ASSERT `s21(1) a reference in an old Act is construed as a reference to` VicTheGovernorOfTheColonyOfNewSouthWales TRUE FALSE EQUALS JUST "the Governor of Victoria"
#ASSERT `s21(1) a reference in an old Act is construed as a reference to` VicTheColonialSecretaryOrSuperintendentOfPortPhillip TRUE FALSE EQUALS JUST "the responsible Minister of the Crown in Victoria for the time being administering the provision in which the reference occurs"
#ASSERT `s21(1) a reference in an old Act is construed as a reference to` VicTheSupremeCourtOrAnotherCourtOfTheColonyOrItsJudgeJusticeOrPresidingPerson TRUE FALSE EQUALS JUST "the court, judge or other person having a similar jurisdiction in Victoria"
#ASSERT `s21(1) a reference in an old Act is construed as a reference to` VicAJusticeOfThePeaceOfTheColony TRUE FALSE EQUALS JUST "a justice of the peace in and for Victoria"
#ASSERT `s21(1) a reference in an old Act is construed as a reference to` VicAnOfficerOrPersonInThePublicServiceOfTheColony TRUE FALSE EQUALS JUST "an officer or other person having similar duties in the public service of Victoria"
#ASSERT `s21(1) a reference in an old Act is construed as a reference to` VicTheGovernmentGazetteOfTheColony TRUE FALSE EQUALS JUST "the Victoria Government Gazette"
#ASSERT `s21(1) a reference in an old Act is construed as a reference to` VicTheGovernmentGazetteOfTheColony FALSE FALSE EQUALS NOTHING
#ASSERT `s21(1) a reference in an old Act is construed as a reference to` VicTheGovernmentGazetteOfTheColony TRUE TRUE EQUALS NOTHING
#ASSERT `s21(2) a reference to the Legislative Council in an old Act is construed as a reference to` TRUE FALSE EQUALS JUST "the Legislative Council of Victoria and the Legislative Assembly of Victoria"
#ASSERT `s21(2) a reference to the Legislative Council in an old Act is construed as a reference to` FALSE FALSE EQUALS NOTHING
#ASSERT `s21(2) a reference to the Legislative Council in an old Act is construed as a reference to` TRUE TRUE EQUALS NOTHING
#ASSERT `s21(3) a reference to naval or military forces or service includes` VicAirForcesOrServiceWithThem FALSE EQUALS JUST TRUE
#ASSERT `s21(3) a reference to naval or military forces or service includes` VicOtherForce FALSE EQUALS NOTHING
#ASSERT `s21(3) a reference to naval or military forces or service includes` VicAirForcesOrServiceWithThem TRUE EQUALS JUST FALSE
#ASSERT `s21A(1) the reprint of the Act is as amended` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s21A(1) the reprint of the Act is as amended` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s21A(1) the reprint of the Act is as amended` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s21A(2) the reprint must show the amending Acts and instruments and the amended provisions` TRUE EQUALS JUST TRUE
#ASSERT `s21A(2) the reprint must show the amending Acts and instruments and the amended provisions` FALSE EQUALS NOTHING
#ASSERT `s21A(3) the reprint may omit the indorsement of the date of passing` TRUE EQUALS JUST TRUE
#ASSERT `s21A(3) the reprint may omit the indorsement of the date of passing` FALSE EQUALS NOTHING
#ASSERT `s21A(4) omitting the indorsement in a reprint affects its status as part of the Act` TRUE EQUALS JUST FALSE
#ASSERT `s21A(4) omitting the indorsement in a reprint affects its status as part of the Act` FALSE EQUALS NOTHING
