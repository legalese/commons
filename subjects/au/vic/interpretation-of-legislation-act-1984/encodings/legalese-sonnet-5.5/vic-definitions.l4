IMPORT prelude
IMPORT `vic-nouns`

-- Interpretation of Legislation Act 1984 (Victoria): the defined terms of ss 3, 38, 38A to 38L, 38EA, 60, 64A and 64B.
-- Each definition is a row of a table: the term (or terms), whether the text says "means", "includes" or points to another instrument,
-- the wording after the verb as the text prints it, the members the definition names, and what it points at.
-- The definitions that sit inside other sections (ss 32(1), 36B, 44(4), 46A, 51, 54, 55, 57) are with those sections.
-- The rules of reading in the rest of the Act are in the Part modules.

DECLARE VicDefinitionKind IS ONE OF
    VicMeans                      -- "means": the text closes the term
    VicIncludes                   -- "includes": the text leaves the term open
    VicHasTheSameMeaningAs        -- the meaning is the one given in another Act or provision
    VicConstruedInAccordanceWith  -- the term is construed as another provision says
    VicDefinedByParagraphs        -- the text gives the term by paragraphs, each with its own condition

DECLARE VicDefinition HAS
    `terms`                          IS A LIST OF STRING
    `kind`                           IS A VicDefinitionKind
    `when it applies`                IS A STRING
    `the wording after the verb`     IS A STRING
    `the members it names`           IS A LIST OF STRING
    `what it points at`              IS A STRING
    `defined in`                     IS A STRING

-- src:33 | amended, in relation to a subordinate instrument, includes altered or varied;
@ref s 3 "amended" (src:33)
`s3 definition 001 of amended` MEANS
    VicDefinition OF (LIST "amended"), VicIncludes, "in relation to a subordinate instrument", "altered or varied;", EMPTY, "", "s 3"

-- src:34 | made, in relation to a subordinate instrument, includes issued or granted;
@ref s 3 "made" (src:34)
`s3 definition 002 of made` MEANS
    VicDefinition OF (LIST "made"), VicIncludes, "in relation to a subordinate instrument", "issued or granted;", EMPTY, "", "s 3"

-- src:35 | repealed, in relation to a subordinate instrument, includes revoked or rescinded.
@ref s 3 "repealed" (src:35)
`s3 definition 003 of repealed` MEANS
    VicDefinition OF (LIST "repealed"), VicIncludes, "in relation to a subordinate instrument", "revoked or rescinded.", EMPTY, "", "s 3"

