#ASSERT `s43 the distance is measured in a straight line on a horizontal plane` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s43 the distance is measured in a straight line on a horizontal plane` FALSE FALSE EQUALS JUST FALSE
