IMPORT prelude
IMPORT `vic-nouns`
IMPORT `vic-interpretation-time`
IMPORT `vic-part4-b-powers`

-- Tests for Part IV, ss 40 to 43. Each expected value is written by hand from the section named beside it.

§ `s 40`

#ASSERT `s40(a) the power may be exercised and the duty performed from time to time as occasion requires` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s40(a) the power may be exercised and the duty performed from time to time as occasion requires` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s40(a) the power may be exercised and the duty performed from time to time as occasion requires` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s40(b) the person is the one by whom the power may be exercised and the duty shall be performed` TRUE FALSE VicThePersonForTheTimeBeingHoldingTheOffice EQUALS JUST TRUE
#ASSERT `s40(b) the person is the one by whom the power may be exercised and the duty shall be performed` TRUE FALSE VicThePersonForTheTimeBeingActingInTheOffice EQUALS JUST TRUE
#ASSERT `s40(b) the person is the one by whom the power may be exercised and the duty shall be performed` TRUE FALSE VicThePersonForTheTimeBeingPerformingTheDutiesOfTheOffice EQUALS JUST TRUE
#ASSERT `s40(b) the person is the one by whom the power may be exercised and the duty shall be performed` TRUE FALSE VicSomeoneElse EQUALS NOTHING
#ASSERT `s40(b) the person is the one by whom the power may be exercised and the duty shall be performed` FALSE FALSE VicThePersonForTheTimeBeingHoldingTheOffice EQUALS JUST FALSE
#ASSERT `s40(b) the person is the one by whom the power may be exercised and the duty shall be performed` TRUE TRUE VicThePersonForTheTimeBeingHoldingTheOffice EQUALS JUST FALSE

§ `s 41`

-- s 41(1)(a) to (c): the powers that need no further fact.
#ASSERT `s41(1) the power to appoint includes the power` TRUE FALSE VicAppointAPersonToActUntilAPersonIsAppointedToTheOffice FALSE FALSE EQUALS JUST TRUE
#ASSERT `s41(1) the power to appoint includes the power` TRUE FALSE VicAppointAPersonToActDuringAVacancyInTheOffice FALSE FALSE EQUALS JUST TRUE
#ASSERT `s41(1) the power to appoint includes the power` TRUE FALSE VicRemoveAPersonAppointedToTheOffice FALSE FALSE EQUALS JUST TRUE
#ASSERT `s41(1) the power to appoint includes the power` TRUE FALSE VicSuspendAPersonAppointedAndAppointAnotherTemporarilyInTheirPlace FALSE FALSE EQUALS JUST TRUE
-- s 41(1)(d) needs the holder to be absent or unable; (e) needs the holder to be unable on a particular occasion.
#ASSERT `s41(1) the power to appoint includes the power` TRUE FALSE VicAppointAPersonToActInPlaceOfAnAbsentOrUnableHolder TRUE FALSE EQUALS JUST TRUE
#ASSERT `s41(1) the power to appoint includes the power` TRUE FALSE VicAppointAPersonToActInPlaceOfAnAbsentOrUnableHolder FALSE FALSE EQUALS JUST FALSE
#ASSERT `s41(1) the power to appoint includes the power` TRUE FALSE VicAppointAPersonToPerformAParticularFunctionOnAParticularOccasion FALSE TRUE EQUALS JUST TRUE
#ASSERT `s41(1) the power to appoint includes the power` TRUE FALSE VicAppointAPersonToPerformAParticularFunctionOnAParticularOccasion FALSE FALSE EQUALS JUST FALSE
-- the condition of the opening words, the contrary intention, and a power the paragraphs do not list ("includes": not closed).
#ASSERT `s41(1) the power to appoint includes the power` FALSE FALSE VicRemoveAPersonAppointedToTheOffice FALSE FALSE EQUALS JUST FALSE
#ASSERT `s41(1) the power to appoint includes the power` TRUE TRUE VicRemoveAPersonAppointedToTheOffice FALSE FALSE EQUALS JUST FALSE
#ASSERT `s41(1) the power to appoint includes the power` TRUE FALSE VicAnyOtherPowerRelatedToTheAppointment FALSE FALSE EQUALS NOTHING
-- s 41(2)
#ASSERT `s41(2) the incident follows from the appointment` VicAppointmentToActInTheOffice VicAppointerMayDetermineTheTermsAndConditionsIncludingRemunerationAndAllowances FALSE EQUALS JUST TRUE
#ASSERT `s41(2) the incident follows from the appointment` VicAppointmentToActInTheOffice VicAppointerMayTerminateTheAppointmentAtAnyTime FALSE EQUALS JUST TRUE
#ASSERT `s41(2) the incident follows from the appointment` VicAppointmentToActInTheOffice VicAppointmentCeasesToHaveEffectOnTheAppointeesResignationInWritingDeliveredToTheAppointer TRUE EQUALS JUST TRUE
#ASSERT `s41(2) the incident follows from the appointment` VicAppointmentToActInTheOffice VicAppointmentCeasesToHaveEffectOnTheAppointeesResignationInWritingDeliveredToTheAppointer FALSE EQUALS JUST FALSE
#ASSERT `s41(2) the incident follows from the appointment` VicAppointmentToActInTheOffice VicAppointeeHasAndMayExerciseAllThePowersAndPerformsAllTheFunctionsAndDutiesOfTheHolder TRUE EQUALS JUST TRUE
#ASSERT `s41(2) the incident follows from the appointment` VicAppointmentToPerformAFunctionOnAParticularOccasion VicAppointeeHasAndMayExerciseAllThePowersAndPerformsAllTheFunctionsAndDutiesOfTheHolder TRUE EQUALS JUST FALSE
#ASSERT `s41(2) the incident follows from the appointment` VicAppointmentToPerformAFunctionOnAParticularOccasion VicAppointeeHasAndMayExerciseAllThePowersNecessaryForPerformingThatFunctionOrDuty TRUE EQUALS JUST TRUE
#ASSERT `s41(2) the incident follows from the appointment` VicAppointmentToActInTheOffice VicAppointeeHasAndMayExerciseAllThePowersNecessaryForPerformingThatFunctionOrDuty TRUE EQUALS JUST FALSE
#ASSERT `s41(2) the incident follows from the appointment` VicAppointmentToActInTheOffice VicTheActAppliesInRelationToTheAppointmentAsIfTheAppointeeWereTheHolder TRUE EQUALS JUST TRUE
#ASSERT `s41(2) the incident follows from the appointment` VicAppointmentToPerformAFunctionOnAParticularOccasion VicTheActAppliesInRelationToTheAppointmentAsIfTheAppointeeWereTheHolder TRUE EQUALS JUST TRUE
#ASSERT `s41(2) the incident follows from the appointment` VicAppointmentNotMadeUnderSubsection1 VicAppointerMayTerminateTheAppointmentAtAnyTime TRUE EQUALS JUST FALSE
-- s 41(3)
#ASSERT `s41(3) the power is only exercisable on the recommendation, or subject to the approval or consent, of that other person or body` TRUE FALSE VicRemoveAPersonAppointedToTheOffice EQUALS JUST TRUE
#ASSERT `s41(3) the power is only exercisable on the recommendation, or subject to the approval or consent, of that other person or body` TRUE FALSE VicSuspendAPersonAppointedAndAppointAnotherTemporarilyInTheirPlace EQUALS JUST TRUE
#ASSERT `s41(3) the power is only exercisable on the recommendation, or subject to the approval or consent, of that other person or body` TRUE FALSE VicAppointAPersonToActDuringAVacancyInTheOffice EQUALS JUST TRUE
#ASSERT `s41(3) the power is only exercisable on the recommendation, or subject to the approval or consent, of that other person or body` TRUE TRUE VicRemoveAPersonAppointedToTheOffice EQUALS JUST FALSE
#ASSERT `s41(3) the power is only exercisable on the recommendation, or subject to the approval or consent, of that other person or body` FALSE FALSE VicRemoveAPersonAppointedToTheOffice EQUALS JUST FALSE
#ASSERT `s41(3) the power is only exercisable on the recommendation, or subject to the approval or consent, of that other person or body` TRUE FALSE VicAppointAPersonToPerformAParticularFunctionOnAParticularOccasion EQUALS NOTHING

