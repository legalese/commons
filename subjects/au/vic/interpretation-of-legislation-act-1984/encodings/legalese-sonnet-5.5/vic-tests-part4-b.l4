#ASSERT `s42A(2) a delegation may be made to the person` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s42A(2) a delegation may be made to the person` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s42A(2) a delegation may be made to the person` FALSE FALSE TRUE EQUALS JUST FALSE
-- s 42A(3),(4): on and after the commencement of the amendment.
#ASSERT `s42A(3),(4) the delegation includes the additional or altered function on the day` TRUE TRUE (Date 13 11 2025) (Date 13 11 2025) EQUALS JUST TRUE
#ASSERT `s42A(3),(4) the delegation includes the additional or altered function on the day` TRUE TRUE (Date 13 11 2025) (Date 12 11 2025) EQUALS JUST FALSE
#ASSERT `s42A(3),(4) the delegation includes the additional or altered function on the day` TRUE FALSE (Date 13 11 2025) (Date 14 11 2025) EQUALS JUST FALSE
#ASSERT `s42A(3),(4) the delegation includes the additional or altered function on the day` FALSE TRUE (Date 13 11 2025) (Date 14 11 2025) EQUALS JUST FALSE
#ASSERT `s42C(1) the appointment, or what the person did, is ineffective because of the irregularity` TRUE EQUALS JUST FALSE
#ASSERT `s42C(1) the appointment, or what the person did, is ineffective because of the irregularity` FALSE EQUALS NOTHING
#ASSERT `s42C(2) the delegation, or what was done under it, is ineffective because of the irregularity` TRUE EQUALS JUST FALSE
#ASSERT `s42C(2) the delegation, or what was done under it, is ineffective because of the irregularity` FALSE EQUALS NOTHING

§ `s 43`

#ASSERT `s43 length of the straight line on a horizontal plane between two positions` 0 0 3 4 EQUALS 5
#ASSERT `s43 length of the straight line on a horizontal plane between two positions` 1 1 1 1 EQUALS 0
#ASSERT `s43 length of the straight line on a horizontal plane between two positions` 6 8 0 0 EQUALS 10
