#ASSERT `s41AA the acting appointment has the incident` TRUE TRUE VicActingAppointerMayTerminateTheAppointmentAtAnyTime FALSE FALSE EQUALS JUST FALSE
-- s 41AA(c): the continued acting ends on whichever event first occurs.
#ASSERT `s41AA(c) the day on which the continued acting ends, whichever event first occurs` (JUST (Date 10 3 2026)) (JUST (Date 20 3 2026)) EQUALS JUST (Date 10 3 2026)
#ASSERT `s41AA(c) the day on which the continued acting ends, whichever event first occurs` (JUST (Date 20 3 2026)) (JUST (Date 10 3 2026)) EQUALS JUST (Date 10 3 2026)
#ASSERT `s41AA(c) the day on which the continued acting ends, whichever event first occurs` NOTHING (JUST (Date 10 3 2026)) EQUALS JUST (Date 10 3 2026)
#ASSERT `s41AA(c) the day on which the continued acting ends, whichever event first occurs` (JUST (Date 10 3 2026)) NOTHING EQUALS JUST (Date 10 3 2026)
#ASSERT `s41AA(c) the day on which the continued acting ends, whichever event first occurs` NOTHING NOTHING EQUALS NOTHING
#ASSERT `s41AA(c) which event ends the continued acting` (JUST (Date 10 3 2026)) (JUST (Date 20 3 2026)) EQUALS VicTheAppointerDirectsOtherwise
#ASSERT `s41AA(c) which event ends the continued acting` (JUST (Date 20 3 2026)) (JUST (Date 10 3 2026)) EQUALS VicAPersonIsAppointedToTheOfficeOrTheVacancyIsFilled
#ASSERT `s41AA(c) which event ends the continued acting` (JUST (Date 10 3 2026)) (JUST (Date 10 3 2026)) EQUALS VicBothHappenOnTheSameDay
#ASSERT `s41AA(c) which event ends the continued acting` NOTHING (JUST (Date 10 3 2026)) EQUALS VicAPersonIsAppointedToTheOfficeOrTheVacancyIsFilled
#ASSERT `s41AA(c) which event ends the continued acting` (JUST (Date 10 3 2026)) NOTHING EQUALS VicTheAppointerDirectsOtherwise
#ASSERT `s41AA(c) which event ends the continued acting` NOTHING NOTHING EQUALS VicNeitherHasHappened

§ `s 41A`

#ASSERT `s41A the power includes a power to repeal, revoke, rescind, amend, alter or vary an instrument made in the exercise of it` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s41A the power includes a power to repeal, revoke, rescind, amend, alter or vary an instrument made in the exercise of it` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s41A the power includes a power to repeal, revoke, rescind, amend, alter or vary an instrument made in the exercise of it` FALSE FALSE EQUALS JUST FALSE

§ `ss 42, 42A, 42C`

#ASSERT `s42(1) the delegate may act upon the delegate's own opinion, belief or state of mind` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s42(1) the delegate may act upon the delegate's own opinion, belief or state of mind` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s42(1) the delegate may act upon the delegate's own opinion, belief or state of mind` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s42(1) the delegate may act upon the delegate's own opinion, belief or state of mind` FALSE TRUE FALSE EQUALS JUST FALSE
