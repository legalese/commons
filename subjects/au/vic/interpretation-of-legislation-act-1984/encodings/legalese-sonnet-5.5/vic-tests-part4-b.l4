#ASSERT `s42(2) subsection (1) applies to the delegation` TRUE (Date 30 6 1984) EQUALS JUST TRUE
#ASSERT `s42(2) subsection (1) applies to the delegation` TRUE (Date 1 7 1984) EQUALS JUST TRUE
#ASSERT `s42(2) subsection (1) applies to the delegation` FALSE (Date 1 7 1984) EQUALS NOTHING
#ASSERT `s42A(1) the proposition about the delegation holds` TRUE FALSE VicTheDelegationMayBeMadeSubjectToConditionsOrLimitations EQUALS JUST TRUE
#ASSERT `s42A(1) the proposition about the delegation holds` TRUE FALSE VicTheDelegatedMatterWhenDischargedByTheDelegateIsTakenToBeDischargedByThePersonOrBody EQUALS JUST TRUE
#ASSERT `s42A(1) the proposition about the delegation holds` TRUE FALSE VicTheExistingPowerToDelegateIncludesThePowerToDelegateThatPowerOfDelegation EQUALS JUST FALSE
#ASSERT `s42A(1) the proposition about the delegation holds` TRUE FALSE VicTheDelegationPreventsTheDischargeByThePersonOrBody EQUALS JUST FALSE
#ASSERT `s42A(1) the proposition about the delegation holds` TRUE TRUE VicTheDelegationMayBeMadeSubjectToConditionsOrLimitations EQUALS JUST FALSE
#ASSERT `s42A(1) the proposition about the delegation holds` FALSE FALSE VicTheDelegationMayBeMadeSubjectToConditionsOrLimitations EQUALS JUST FALSE
#ASSERT `s42A(1) the proposition about the delegation holds` TRUE TRUE VicTheDelegationPreventsTheDischargeByThePersonOrBody EQUALS NOTHING
#ASSERT `s42A(1) the proposition about the delegation holds` FALSE FALSE VicTheExistingPowerToDelegateIncludesThePowerToDelegateThatPowerOfDelegation EQUALS NOTHING
