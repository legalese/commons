IMPORT prelude
IMPORT `vic-nouns`
IMPORT `vic-interpretation-time`
IMPORT `vic-part5-6-schedule1`

-- Tests for Parts V and VI and Schedule 1. Each expected value is written by hand from the section named beside it.

§ `Part V`

#ASSERT `s61 Part V derogates from s 54` TRUE EQUALS JUST FALSE
#ASSERT `s61 Part V derogates from s 54` FALSE EQUALS NOTHING
#ASSERT `s62(1) the Chief Parliamentary Counsel may authorise the version` TRUE EQUALS JUST TRUE
#ASSERT `s62(1) the Chief Parliamentary Counsel may authorise the version` FALSE EQUALS NOTHING
-- s 62(2),(3): all three paragraphs (the reading taken); one missing means the version is not an authorised electronic version.
#ASSERT `s62(2),(3) the electronic version is an authorised electronic version` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s62(2),(3) the electronic version is an authorised electronic version` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s62(2),(3) the electronic version is an authorised electronic version` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s62(2),(3) the electronic version is an authorised electronic version` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s62(2),(3) the electronic version is an authorised electronic version` FALSE TRUE TRUE TRUE EQUALS NOTHING
-- s 63 with the definition of authorised version in s 60.
#ASSERT `s63 the document is an authorised version` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s63 the document is an authorised version` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s63 the document is an authorised version` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s63 the document is an authorised version` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s64(1) the document is admissible on its mere production` TRUE EQUALS JUST TRUE
#ASSERT `s64(1) the document is admissible on its mere production` FALSE EQUALS NOTHING
#ASSERT `s64(2) the document is presumed to be an authorised version` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s64(2) the document is presumed to be an authorised version` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s64(2) the document is presumed to be an authorised version` FALSE FALSE EQUALS NOTHING

§ `Part VI`

#ASSERT `s64A the fact that the person is a non-citizen of itself affects eligibility for appointment to a public office or disqualifies the person` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s64A the fact that the person is a non-citizen of itself affects eligibility for appointment to a public office or disqualifies the person` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s64A the fact that the person is a non-citizen of itself affects eligibility for appointment to a public office or disqualifies the person` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s64A the fact that the person is a non-citizen of itself affects eligibility for appointment to a public office or disqualifies the person` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s64A the fact that the person is a non-citizen of itself affects eligibility for appointment to a public office or disqualifies the person` FALSE FALSE FALSE EQUALS NOTHING
-- s 64B(1): made on or after 3 March 1986 and before the day s 64A came into operation (10 December 2025 on the endnote's day).
#ASSERT `s64B(1) the appointment is a purported appointment` TRUE (Date 3 3 1986) (Date 10 12 2025) EQUALS JUST TRUE
#ASSERT `s64B(1) the appointment is a purported appointment` TRUE (Date 9 12 2025) (Date 10 12 2025) EQUALS JUST TRUE
#ASSERT `s64B(1) the appointment is a purported appointment` TRUE (Date 2 3 1986) (Date 10 12 2025) EQUALS JUST FALSE
#ASSERT `s64B(1) the appointment is a purported appointment` TRUE (Date 10 12 2025) (Date 10 12 2025) EQUALS JUST FALSE
#ASSERT `s64B(1) the appointment is a purported appointment` FALSE (Date 1 1 2000) (Date 10 12 2025) EQUALS JUST FALSE
#ASSERT `s64B(2) the purported appointment has the force and effect it would have had if s 64A had been in operation when it was made` TRUE EQUALS JUST TRUE
#ASSERT `s64B(2) the purported appointment has the force and effect it would have had if s 64A had been in operation when it was made` FALSE EQUALS NOTHING
#ASSERT `s64B(3) the act or omission is ineffective because the officer was not lawfully appointed` TRUE EQUALS JUST FALSE
#ASSERT `s64B(3) the act or omission is ineffective because the officer was not lawfully appointed` FALSE EQUALS NOTHING
#ASSERT `s64B(4) the act or thing done in reliance on the purported appointment is ineffective because the officer was not lawfully appointed` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s64B(4) the act or thing done in reliance on the purported appointment is ineffective because the officer was not lawfully appointed` FALSE TRUE EQUALS NOTHING
#ASSERT `s64B(4) the act or thing done in reliance on the purported appointment is ineffective because the officer was not lawfully appointed` TRUE FALSE EQUALS NOTHING
#ASSERT `s64B(5) the act or thing is one the acts and things referred to in subsection (4) include` VicAJudgmentOrOrderOfACourtOrAnOrderOfATribunal EQUALS JUST TRUE
#ASSERT `s64B(5) the act or thing is one the acts and things referred to in subsection (4) include` VicTheIssueOfAWarrantSummonsOrOtherProcess EQUALS JUST TRUE
#ASSERT `s64B(5) the act or thing is one the acts and things referred to in subsection (4) include` VicAnyOtherActOrThing EQUALS NOTHING
#ASSERT `s64B(6) the fact that the officer was not lawfully appointed is to be disregarded in determining the question` VicWhetherEvidenceObtainedAsAResultOfAnActOrOmissionOughtToBeAdmitted EQUALS JUST TRUE
#ASSERT `s64B(6) the fact that the officer was not lawfully appointed is to be disregarded in determining the question` VicWhetherARightPrivilegeObligationOrLiabilityHasBeenAcquiredAccruedOrIncurred EQUALS JUST TRUE
#ASSERT `s64B(6) the fact that the officer was not lawfully appointed is to be disregarded in determining the question` VicAnyOtherQuestion EQUALS NOTHING

§ `Schedule 1`

-- Clause 1 and the Table: the eight rows, and an expression not in column 1.
#ASSERT `Sch 1 cl 1 the expression substituted for the expression` "Sub-division" EQUALS JUST "Subdivision"
#ASSERT `Sch 1 cl 1 the expression substituted for the expression` "sub-section" EQUALS JUST "subsection"
#ASSERT `Sch 1 cl 1 the expression substituted for the expression` "sub-paragraph" EQUALS JUST "subparagraph"
#ASSERT `Sch 1 cl 1 the expression substituted for the expression` "sub-sub-paragraph" EQUALS JUST "sub-subparagraph"
#ASSERT `Sch 1 cl 1 the expression substituted for the expression` "sub-clause" EQUALS JUST "subclause"
#ASSERT `Sch 1 cl 1 the expression substituted for the expression` "sub-sub-clause" EQUALS JUST "sub-subclause"
#ASSERT `Sch 1 cl 1 the expression substituted for the expression` "sub-regulation" EQUALS JUST "subregulation"
#ASSERT `Sch 1 cl 1 the expression substituted for the expression` "sub-rule" EQUALS JUST "subrule"
#ASSERT `Sch 1 cl 1 the expression substituted for the expression` "section" EQUALS NOTHING
#ASSERT `Sch 1 table row 1` EQUALS VicStyleChangeRow OF "Sub-division", "Subdivision"
-- Clauses 2 to 8.
#ASSERT `Sch 1 cl 2 to 8 the style change` VicHeadingToAPartDivisionOrSubdivision FALSE EQUALS JUST VicSubstituteTheHeadingFormattedInTheSentenceCaseStyle
#ASSERT `Sch 1 cl 2 to 8 the style change` VicHeadingToAPartDivisionOrSubdivision TRUE EQUALS NOTHING
#ASSERT `Sch 1 cl 2 to 8 the style change` VicScheduleHeadingNumberAndTitle FALSE EQUALS JUST VicSubstituteACombinedHeadingSeparatedByAnEmRuleInTheSentenceCaseStyle
#ASSERT `Sch 1 cl 2 to 8 the style change` VicOtherScheduleHeadingOrPartHeadingWithinASchedule FALSE EQUALS JUST VicSubstituteTheHeadingFormattedInTheSentenceCaseStyle
#ASSERT `Sch 1 cl 2 to 8 the style change` VicFormHeadingNumberAndTitle FALSE EQUALS JUST VicSubstituteACombinedHeadingSeparatedByAnEmRuleInTheSentenceCaseStyle
#ASSERT `Sch 1 cl 2 to 8 the style change` VicNoteAtTheFootOfAProvisionNotUnderTheHeadingNoteOrNotes FALSE EQUALS JUST VicSubstituteTheNoteUnderTheHeadingNoteOrNotes
#ASSERT `Sch 1 cl 2 to 8 the style change` VicNoteAtTheFootOfAProvisionNotUnderTheHeadingNoteOrNotes TRUE EQUALS NOTHING
#ASSERT `Sch 1 cl 2 to 8 the style change` VicNoteReformattedUnderClause3 FALSE EQUALS JUST VicOmitNoteColonAndMoveAnyNumberToTheBeginningOfTheNote
#ASSERT `Sch 1 cl 2 to 8 the style change` VicDoubleQuotationMarksAroundADefinedWordOrExpression FALSE EQUALS JUST VicOmitTheDoubleQuotationMarks
#ASSERT `Sch 1 cl 2 to 8 the style change` VicFullStopFollowingTheProvisionNumberAtTheBeginningOfAProvision FALSE EQUALS JUST VicOmitTheFullStop
#ASSERT `Sch 1 cl 2 to 8 the style change` VicTitleOfAnActOrStatutoryRuleNotInItalicsWithoutBolding FALSE EQUALS JUST VicSubstituteTheTitleInItalicsWithoutBolding
#ASSERT `Sch 1 cl 2 to 8 the style change` VicLineAtTheEndOfAPartIndicatingTheEndOfThePart FALSE EQUALS JUST VicOmitTheLine
#ASSERT `Sch 1 cl 2 to 8 the style change` VicAnyOtherSituation FALSE EQUALS NOTHING
