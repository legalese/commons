#ASSERT `s32(13A) the conditions of office may be prescribed by reference to those fixed under another Act` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s32(13B) s 32(13A) applies` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s32(13B) s 32(13A) applies` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s32(14) the document or matter is applied, adopted or incorporated` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s32(14) the document or matter is applied, adopted or incorporated` TRUE FALSE EQUALS NOTHING
#ASSERT `s32(14) the document or matter is applied, adopted or incorporated` FALSE TRUE EQUALS NOTHING

§ `ss 33 and 34`

#ASSERT `s33(1) a reference to a unit by number is construed as a reference to` VicSiChapter FALSE FALSE FALSE EQUALS JUST "the Chapter, designated by that number, of the subordinate instrument in which the reference occurs"
#ASSERT `s33(1) a reference to a unit by number is construed as a reference to` VicSiPart TRUE FALSE FALSE EQUALS JUST "the Part, designated by that number, of the Chapter in which the reference occurs"
#ASSERT `s33(1) a reference to a unit by number is construed as a reference to` VicSiPart FALSE FALSE FALSE EQUALS JUST "the Part, designated by that number, of the subordinate instrument in which the reference occurs"
#ASSERT `s33(1) a reference to a unit by number is construed as a reference to` VicSiRegulationRuleByLawLocalLawOrSchedule FALSE FALSE FALSE EQUALS JUST "the regulation, rule, by-law, local law or Schedule, designated by that number, of or to the subordinate instrument in which the reference occurs"
#ASSERT `s33(1) a reference to a unit by number is construed as a reference to` VicSiScheduleNotCitedByNumber FALSE TRUE FALSE EQUALS JUST "the Schedule to the subordinate instrument in which the reference occurs"
#ASSERT `s33(1) a reference to a unit by number is construed as a reference to` VicSiScheduleNotCitedByNumber FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s33(1) a reference to a unit by number is construed as a reference to` VicSiDivision FALSE FALSE FALSE EQUALS JUST "the Division, designated by that number, of the Part in which the reference occurs"
#ASSERT `s33(1) a reference to a unit by number is construed as a reference to` VicSiSubdivision FALSE FALSE FALSE EQUALS JUST "the Subdivision, designated by that number, of the Division in which the reference occurs"
#ASSERT `s33(1) a reference to a unit by number is construed as a reference to` VicSiSubregulationOrClauseOfARegulation FALSE FALSE FALSE EQUALS JUST "the subregulation or clause, designated by that number, of the regulation in which the reference occurs"
#ASSERT `s33(1) a reference to a unit by number is construed as a reference to` VicSiSubruleOrClauseOfARule FALSE FALSE FALSE EQUALS JUST "the subrule or clause, designated by that number, of the rule in which the reference occurs"
#ASSERT `s33(1) a reference to a unit by number is construed as a reference to` VicSiClauseOfAByLawOrLocalLaw FALSE FALSE FALSE EQUALS JUST "the clause, designated by that number, of the by-law or local law in which the reference occurs"
#ASSERT `s33(1) a reference to a unit by number is construed as a reference to` VicSiParagraphOfAProvisionInterpretationOrSchedule FALSE FALSE FALSE EQUALS JUST "the paragraph, designated by that number, of the regulation, rule, by-law, local law, subregulation, subrule, clause of a by-law, local law, clause, subclause, interpretation or Schedule in which the reference occurs"
#ASSERT `s33(1) a reference to a unit by number is construed as a reference to` VicSiParagraphOfAClauseSubclauseItemColumnTableOrFormInASchedule FALSE FALSE FALSE EQUALS JUST "the paragraph, designated by that number, of the clause, subclause, item, column, table or form or in the Schedule in which the reference occurs"
#ASSERT `s33(1) a reference to a unit by number is construed as a reference to` VicSiSubparagraph FALSE FALSE FALSE EQUALS JUST "the subparagraph, designated by that number, of the paragraph in which the reference occurs"
#ASSERT `s33(1) a reference to a unit by number is construed as a reference to` VicSiSubSubparagraph FALSE FALSE FALSE EQUALS JUST "the sub-subparagraph, designated by that number, of the subparagraph in which the reference occurs"
#ASSERT `s33(1) a reference to a unit by number is construed as a reference to` VicSiClauseItemColumnTableOrFormOfASchedule FALSE FALSE FALSE EQUALS JUST "the clause, item, column, table or form, designated by that number, of or in the Schedule in which the reference occurs"
#ASSERT `s33(1) a reference to a unit by number is construed as a reference to` VicSiSubclause FALSE FALSE FALSE EQUALS JUST "the subclause, designated by that number, of the clause in which the reference occurs"
#ASSERT `s33(1) a reference to a unit by number is construed as a reference to` VicSiSubSubclause FALSE FALSE FALSE EQUALS JUST "the sub-subclause, designated by that number, of the subclause in which the reference occurs"
#ASSERT `s33(1) a reference to a unit by number is construed as a reference to` VicSiChapter FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s33(2) the designation is a number for s 33(1)` VicSiANumberExpressedInWordsOrFigures EQUALS JUST TRUE
#ASSERT `s33(2) the designation is a number for s 33(1)` VicSiALetter EQUALS JUST TRUE
#ASSERT `s33(2) the designation is a number for s 33(1)` VicSiACombinationOfANumberSoExpressedAndALetter EQUALS JUST TRUE
