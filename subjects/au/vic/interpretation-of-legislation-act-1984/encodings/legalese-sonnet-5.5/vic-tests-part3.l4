IMPORT prelude
IMPORT `vic-nouns`
IMPORT `vic-part3-subordinate`

-- Tests for Part III (ss 22 to 34). Each expected value is written by hand from the section named beside it.

§ `ss 22, 23, 26, 27`

#ASSERT `s22(1) how a provision of a subordinate instrument is construed against the limit of its power` VicLegislativePowerOfTheStateOfVictoria TRUE EQUALS VicInstrumentOperatesToTheExtentNotInExcessAndTheRemainderIsNotAffected
#ASSERT `s22(1) how a provision of a subordinate instrument is construed against the limit of its power` VicPowerToMakeTheInstrumentConferredByTheEmpoweringAct TRUE EQUALS VicInstrumentOperatesToTheExtentNotInExcessAndTheRemainderIsNotAffected
#ASSERT `s22(1) how a provision of a subordinate instrument is construed against the limit of its power` VicPowerToMakeTheInstrumentConferredByTheEmpoweringAct FALSE EQUALS VicInstrumentOperatesFully
#ASSERT `s22(2) s 22 takes the place of a provision on the construction or extent of operation of the instrument` TRUE EQUALS JUST FALSE
#ASSERT `s22(2) s 22 takes the place of a provision on the construction or extent of operation of the instrument` FALSE EQUALS NOTHING
#ASSERT `s23 an expression in the instrument has the same meaning as in the Act conferring the power` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s23 an expression in the instrument has the same meaning as in the Act conferring the power` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s23 an expression in the instrument has the same meaning as in the Act conferring the power` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s26(1) s 26 applies` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s26(1) s 26 applies` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s26(2) the power may be exercised after the making and before the commencement` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s26(2) the power may be exercised after the making and before the commencement` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s26(2) the power may be exercised after the making and before the commencement` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s26(2) the exercise of the power confers a right or imposes an obligation before the commencement` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s26(2) the exercise of the power confers a right or imposes an obligation before the commencement` TRUE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s26(2) the exercise of the power confers a right or imposes an obligation before the commencement` TRUE FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s26(2) the exercise of the power confers a right or imposes an obligation before the commencement` TRUE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s26(3) an appointee or body may exercise the power before the commencement as if the instrument were in operation` TRUE EQUALS JUST TRUE
#ASSERT `s26(3) an appointee or body may exercise the power before the commencement as if the instrument were in operation` FALSE EQUALS JUST FALSE
#ASSERT `s26(4) the term of office cannot yet begin` (Date 30 6 2027) (Date 1 7 2027) EQUALS JUST TRUE
#ASSERT `s26(4) the term of office cannot yet begin` (Date 1 7 2027) (Date 1 7 2027) EQUALS JUST FALSE
#ASSERT `s27 the power to make the instrument includes a power to repeal or amend it` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s27 the power to make the instrument includes a power to repeal or amend it` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s27 the power to make the instrument includes a power to repeal or amend it` FALSE FALSE EQUALS JUST FALSE

§ `ss 28 to 31`

#ASSERT `s28(1) the instrument or provision that the ending instrument or provision had repealed is construed as revived` VicRepealed FALSE EQUALS JUST FALSE
#ASSERT `s28(1) the instrument or provision that the ending instrument or provision had repealed is construed as revived` VicExpires TRUE EQUALS NOTHING
#ASSERT `s28(2)(c)-(f) the repeal, amendment, expiry or lapsing revives or affects the thing` VicInstrumentAnythingNotInForceOrExistingAtThatTime FALSE EQUALS JUST FALSE
#ASSERT `s28(2)(c)-(f) the repeal, amendment, expiry or lapsing revives or affects the thing` VicInstrumentThePreviousOperationOrAnythingDulyDoneOrSuffered FALSE EQUALS JUST FALSE
#ASSERT `s28(2)(c)-(f) the repeal, amendment, expiry or lapsing revives or affects the thing` VicInstrumentARightPrivilegeObligationOrLiabilityAcquiredAccruedOrIncurred FALSE EQUALS JUST FALSE
#ASSERT `s28(2)(c)-(f) the repeal, amendment, expiry or lapsing revives or affects the thing` VicInstrumentAPenaltyForfeitureOrPunishmentIncurredForAnOffence FALSE EQUALS JUST FALSE
#ASSERT `s28(2)(c)-(f) the repeal, amendment, expiry or lapsing revives or affects the thing` VicInstrumentAPenaltyForfeitureOrPunishmentIncurredForAnOffence TRUE EQUALS NOTHING
#ASSERT `s28(2)(c)-(f) the repeal, amendment, expiry or lapsing revives or affects the thing` VicInstrumentAnythingElse FALSE EQUALS NOTHING
#ASSERT `s28(2)(g) the repeal, amendment, expiry or lapsing affects an investigation, legal proceeding or remedy` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s28(2)(g) the repeal, amendment, expiry or lapsing affects an investigation, legal proceeding or remedy` TRUE TRUE EQUALS NOTHING
#ASSERT `s28(2)(g) the repeal, amendment, expiry or lapsing affects an investigation, legal proceeding or remedy` FALSE FALSE EQUALS NOTHING
#ASSERT `s28(2) the proceeding may be instituted, continued or enforced, or the penalty imposed, as if the instrument had not been repealed` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s28(2) the proceeding may be instituted, continued or enforced, or the penalty imposed, as if the instrument had not been repealed` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s28(2) the proceeding may be instituted, continued or enforced, or the penalty imposed, as if the instrument had not been repealed` FALSE FALSE EQUALS NOTHING
#ASSERT `s28(2A) the repeal, expiry or lapsing of the provision ends the effect it had` VicProvisionOfASavingsOrTransitionalNature FALSE EQUALS JUST FALSE
#ASSERT `s28(2A) the repeal, expiry or lapsing of the provision ends the effect it had` VicProvisionOfASavingsOrTransitionalNature TRUE EQUALS NOTHING
#ASSERT `s28(2A) the repeal, expiry or lapsing of the provision ends the effect it had` VicAnyOtherProvision FALSE EQUALS NOTHING
#ASSERT `s28(3) the way of repealing is within the references to repeal in s 28(1), (2) and (2A)` VicRepealedByImplication EQUALS JUST TRUE
#ASSERT `s28(3) the way of repealing is within the references to repeal in s 28(1), (2) and (2A)` VicRepealedByAbrogatingOrLimitingItsEffect EQUALS JUST TRUE
#ASSERT `s28(3) the way of repealing is within the references to repeal in s 28(1), (2) and (2A)` VicRepealedByExcludingItsApplication EQUALS JUST TRUE
#ASSERT `s28(3) the way of repealing is within the references to repeal in s 28(1), (2) and (2A)` VicRepealedExpressly EQUALS NOTHING
#ASSERT `s29(1) the ending of the amending instrument or provision affects the direct amendments` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s29(1) the ending of the amending instrument or provision affects the direct amendments` TRUE TRUE EQUALS NOTHING
#ASSERT `s29(1) the ending of the amending instrument or provision affects the direct amendments` FALSE FALSE EQUALS NOTHING
#ASSERT `s29(2) s 29(1) applies to the amendment` TRUE EQUALS JUST TRUE
#ASSERT `s29(2) s 29(1) applies to the amendment` FALSE EQUALS NOTHING
#ASSERT `s30(a) a reference to the repealed instrument or provision is construed as a reference to the re-made instrument or provision` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s30(a) a reference to the repealed instrument or provision is construed as a reference to the re-made instrument or provision` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s30(a) a reference to the repealed instrument or provision is construed as a reference to the re-made instrument or provision` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s30(b) the instrument made or thing done has effect as if made or done under the re-made instrument or provision` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s30(b) the instrument made or thing done has effect as if made or done under the re-made instrument or provision` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s30(b) the instrument made or thing done has effect as if made or done under the re-made instrument or provision` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s30(b) the instrument made or thing done has effect as if made or done under the re-made instrument or provision` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s31(1) a reference in a subordinate instrument to another enactment is construed as a reference to` VicHasBeenAmended FALSE EQUALS JUST VicTheEnactmentAsAmendedAndInForceForTheTimeBeing
#ASSERT `s31(1) a reference in a subordinate instrument to another enactment is construed as a reference to` VicHasBeenReEnactedOrReMade FALSE EQUALS JUST VicTheEnactmentAsReEnactedOrReMadeAndInForceForTheTimeBeing
#ASSERT `s31(1) a reference in a subordinate instrument to another enactment is construed as a reference to` VicHasBeenReEnactedOrReMadeAndSubsequentlyAmended FALSE EQUALS JUST VicTheEnactmentAsReEnactedOrReMadeAndSubsequentlyAmendedAndInForceForTheTimeBeing
#ASSERT `s31(1) a reference in a subordinate instrument to another enactment is construed as a reference to` VicHasBeenRepealedAndNotReEnactedOrReMade FALSE EQUALS JUST VicTheEnactmentAsInForceImmediatelyBeforeItsRepeal
#ASSERT `s31(1) a reference in a subordinate instrument to another enactment is construed as a reference to` VicStillAsFirstMade FALSE EQUALS NOTHING
#ASSERT `s31(1) a reference in a subordinate instrument to another enactment is construed as a reference to` VicHasBeenAmended TRUE EQUALS NOTHING
#ASSERT `s31(1A) a reference in a subordinate instrument to a provision that has been renumbered or relocated is construed as a reference to` TRUE TRUE FALSE EQUALS JUST VicTheProvisionAsRenumberedOrRelocatedAndInForceForTheTimeBeing
#ASSERT `s31(1A) a reference in a subordinate instrument to a provision that has been renumbered or relocated is construed as a reference to` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s31(1A) a reference in a subordinate instrument to a provision that has been renumbered or relocated is construed as a reference to` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s31(2)(a) a reference to an Act in s 31 includes` VicACommonwealthActS31 EQUALS JUST TRUE
#ASSERT `s31(2)(a) a reference to an Act in s 31 includes` VicAnActOrOrdinanceOfAnotherStateOrOfATerritoryS31 EQUALS JUST TRUE
#ASSERT `s31(2)(a) a reference to an Act in s 31 includes` VicAnythingElseS31 EQUALS NOTHING
#ASSERT `s31(2)(b) a reference to a subordinate instrument in s 31 includes` VicAnInstrumentOfALegislativeCharacterMadeUnderACommonwealthActS31 EQUALS JUST TRUE
#ASSERT `s31(2)(b) a reference to a subordinate instrument in s 31 includes` VicAnInstrumentOfALegislativeCharacterMadeUnderAnActOrOrdinanceOfAnotherStateOrOfATerritoryS31 EQUALS JUST TRUE
#ASSERT `s31(2)(b) a reference to a subordinate instrument in s 31 includes` VicACommonwealthActS31 EQUALS NOTHING

§ `s 32`

#ASSERT `s32(1) relevant day` (Date 1 7 1991) EQUALS Date 1 7 1991
-- The twelve named Codes and Laws of paragraphs (a) to (l) (paragraph (k) is blank in the text), each a Code.
#ASSERT `s32(1) the thing is a Code` "the Companies (Victoria) Code" FALSE FALSE EQUALS TRUE
#ASSERT `s32(1) the thing is a Code` "the Companies (Acquisition of Shares) (Victoria) Code" FALSE FALSE EQUALS TRUE
#ASSERT `s32(1) the thing is a Code` "the Futures Industry (Victoria) Code" FALSE FALSE EQUALS TRUE
#ASSERT `s32(1) the thing is a Code` "the Securities Industry (Victoria) Code" FALSE FALSE EQUALS TRUE
#ASSERT `s32(1) the thing is a Code` "the Companies and Securities (Interpretation and Miscellaneous Provisions) (Victoria) Code" FALSE FALSE EQUALS TRUE
#ASSERT `s32(1) the thing is a Code` "the ASIC Law of Victoria" FALSE FALSE EQUALS TRUE
#ASSERT `s32(1) the thing is a Code` "the Corporations Law of Victoria" FALSE FALSE EQUALS TRUE
#ASSERT `s32(1) the thing is a Code` "the National Electricity (Victoria) Law" FALSE FALSE EQUALS TRUE
#ASSERT `s32(1) the thing is a Code` "the AFIC (Victoria) Code" FALSE FALSE EQUALS TRUE
#ASSERT `s32(1) the thing is a Code` "the Financial Institutions (Victoria) Code" FALSE FALSE EQUALS TRUE
#ASSERT `s32(1) the thing is a Code` "the National Gas (Victoria) Law" FALSE FALSE EQUALS TRUE
#ASSERT `s32(1) the thing is a Code` "the Friendly Societies (Victoria) Code" FALSE FALSE EQUALS TRUE
-- Paragraph (f): any other Code to which the 1981 Application of Laws Act applies; paragraph (m): a regulation or rule made under one of them.
#ASSERT `s32(1) the thing is a Code` "some other Code" TRUE FALSE EQUALS TRUE
#ASSERT `s32(1) the thing is a Code` "a regulation under the Corporations Law of Victoria" FALSE TRUE EQUALS TRUE
-- "means": anything else is not a Code.
#ASSERT `s32(1) the thing is a Code` "the Road Safety Act 1986" FALSE FALSE EQUALS FALSE
-- s 32(2)
