#ASSERT `s32(3)(b) where a copy of the matter is kept available for inspection by the public without charge` FALSE EQUALS VicThePrincipalOfficeOfTheBodyThatMadeTheInstrumentOrAnotherPublicOfficeTheMinisterSpecifiesByGazetteNotice
#ASSERT `s32(4)(a) the Minister must cause the amended copy to be lodged, the notice published and the notice laid` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s32(4)(a) the Minister must cause the amended copy to be lodged, the notice published and the notice laid` TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s32(4)(a) the Minister must cause the amended copy to be lodged, the notice published and the notice laid` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s32(4)(c) where a copy of the amended matter is kept available for inspection by the public without charge` TRUE EQUALS VicTheDepartmentOfTheMinisterOrAnotherPublicOfficeTheMinisterSpecifiesByGazetteNotice
#ASSERT `s32(4)(c) where a copy of the amended matter is kept available for inspection by the public without charge` FALSE EQUALS VicThePrincipalOfficeOfTheBodyThatMadeTheInstrumentOrAnotherPublicOfficeTheMinisterSpecifiesByGazetteNotice
