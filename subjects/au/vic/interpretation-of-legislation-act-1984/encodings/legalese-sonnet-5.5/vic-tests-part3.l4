#ASSERT `s32(12)(a) the person may be convicted of the offence of contravening the instrument` TRUE FALSE EQUALS NOTHING
#ASSERT `s32(12)(a) the person may be convicted of the offence of contravening the instrument` FALSE TRUE EQUALS NOTHING
#ASSERT `s32(12)(b) the person is prejudicially affected or subject to a liability by the instrument` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s32(12)(b) the person is prejudicially affected or subject to a liability by the instrument` TRUE FALSE EQUALS NOTHING
