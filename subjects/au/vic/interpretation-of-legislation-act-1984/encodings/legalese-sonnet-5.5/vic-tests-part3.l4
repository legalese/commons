#ASSERT `s32(2) the subordinate instrument may apply, adopt or incorporate the matter` TRUE (Date 1 7 1991) (Date 1 7 1991) FALSE VicAnyOtherDocumentApplied VicAsInForceAtAParticularTime EQUALS JUST FALSE
#ASSERT `s32(2) the subordinate instrument may apply, adopt or incorporate the matter` TRUE (Date 1 7 1992) (Date 1 7 1991) TRUE VicAnyOtherDocumentApplied VicAsInForceAtAParticularTime EQUALS JUST FALSE
-- s 32(3), (4)
#ASSERT `s32(3)(a) the Minister must cause the copy to be lodged, the notice published and the notice laid` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s32(3)(a) the Minister must cause the copy to be lodged, the notice published and the notice laid` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s32(3)(a) the Minister must cause the copy to be lodged, the notice published and the notice laid` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s32(3)(a) the Minister must cause the copy to be lodged, the notice published and the notice laid` TRUE FALSE TRUE EQUALS JUST FALSE
