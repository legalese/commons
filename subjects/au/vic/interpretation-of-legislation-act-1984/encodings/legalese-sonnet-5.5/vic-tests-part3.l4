#ASSERT `s32(13) the amounts may be prescribed by reference to those fixed under another Act` TRUE FALSE EQUALS NOTHING
#ASSERT `s32(13) the amounts may be prescribed by reference to those fixed under another Act` FALSE TRUE EQUALS JUST FALSE
