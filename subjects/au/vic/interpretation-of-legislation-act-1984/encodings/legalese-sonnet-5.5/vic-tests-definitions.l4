#ASSERT `wording of the definition of a term` "s 38" "Australian legal practitioner" FALSE EQUALS JUST "—"
#ASSERT `members the definition of a term names` "s 38" "Australian legal practitioner" FALSE EQUALS JUST (LIST "an Australian legal practitioner within the meaning of the Legal Profession Uniform Law (Victoria)", "a non-participant legal practitioner within the meaning of Schedule 3 to the Legal Profession Uniform Law (Victoria)")
-- s 38 def "bail justice"
#ASSERT `kind of the definition of a term` "s 38" "bail justice" FALSE EQUALS JUST VicMeans
