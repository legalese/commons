#ASSERT `members the definition of a term names` "s 60" "electronic version" FALSE EQUALS JUST EMPTY
-- s 60 def "legislation"
#ASSERT `kind of the definition of a term` "s 60" "legislation" FALSE EQUALS JUST VicMeans
#ASSERT `wording of the definition of a term` "s 60" "legislation" FALSE EQUALS JUST "—"
#ASSERT `members the definition of a term names` "s 60" "legislation" FALSE EQUALS JUST (LIST "an Act", "a statutory rule", "a consolidation of an Act as amended from time to time prepared by the Chief Parliamentary Counsel", "a consolidation of a statutory rule as amended from time to time prepared by the Chief Parliamentary Counsel")
-- s 60 def "Victorian Legislation Website"
#ASSERT `kind of the definition of a term` "s 60" "Victorian Legislation Website" FALSE EQUALS JUST VicMeans
#ASSERT `wording of the definition of a term` "s 60" "Victorian Legislation Website" FALSE EQUALS JUST "www.legislation.vic.gov.au."
#ASSERT `members the definition of a term names` "s 60" "Victorian Legislation Website" FALSE EQUALS JUST EMPTY
-- s 64A(3) def "non-citizen"
#ASSERT `kind of the definition of a term` "s 64A(3)" "non-citizen" FALSE EQUALS JUST VicIncludes
#ASSERT `wording of the definition of a term` "s 64A(3)" "non-citizen" FALSE EQUALS JUST "a person who is not an Australian citizen or who is an alien as known at common law."
#ASSERT `members the definition of a term names` "s 64A(3)" "non-citizen" FALSE EQUALS JUST EMPTY
-- s 64B(1) def "act or omission"
#ASSERT `kind of the definition of a term` "s 64B(1)" "act or omission" FALSE EQUALS JUST VicMeans
#ASSERT `wording of the definition of a term` "s 64B(1)" "act or omission" FALSE EQUALS JUST "an act or thing done or omitted to be done by an officer in the course of purportedly performing the functions and duties of a public office—"
#ASSERT `members the definition of a term names` "s 64B(1)" "act or omission" FALSE EQUALS JUST (LIST "whether before, on or after the commencement of section 64A", "whether or not under a power conferred by or under an Act or a subordinate instrument")
-- s 64B(1) def "non-citizen"
#ASSERT `kind of the definition of a term` "s 64B(1)" "non-citizen" FALSE EQUALS JUST VicHasTheSameMeaningAs
#ASSERT `wording of the definition of a term` "s 64B(1)" "non-citizen" FALSE EQUALS JUST "as in section 64A;"
#ASSERT `members the definition of a term names` "s 64B(1)" "non-citizen" FALSE EQUALS JUST EMPTY
-- s 64B(1) def "officer"
#ASSERT `kind of the definition of a term` "s 64B(1)" "officer" FALSE EQUALS JUST VicMeans
#ASSERT `wording of the definition of a term` "s 64B(1)" "officer" FALSE EQUALS JUST "a person who was purportedly appointed to a public office by a purported appointment;"
#ASSERT `members the definition of a term names` "s 64B(1)" "officer" FALSE EQUALS JUST EMPTY
-- s 64B(1) def "purported appointment"
#ASSERT `kind of the definition of a term` "s 64B(1)" "purported appointment" FALSE EQUALS JUST VicMeans
#ASSERT `wording of the definition of a term` "s 64B(1)" "purported appointment" FALSE EQUALS JUST "a purported appointment of a non-citizen to a public office that was made during the period beginning on 3 March 1986 and ending immediately before section 64A came into operation."
#ASSERT `members the definition of a term names` "s 64B(1)" "purported appointment" FALSE EQUALS JUST EMPTY
