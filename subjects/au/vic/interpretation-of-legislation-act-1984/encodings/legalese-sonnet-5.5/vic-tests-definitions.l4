#ASSERT `wording of the definition of a term` "s 38" "audio link" FALSE EQUALS JUST "given by Part IIA of the Evidence (Miscellaneous Provisions) Act 1958;"
#ASSERT `members the definition of a term names` "s 38" "audio link" FALSE EQUALS JUST EMPTY
