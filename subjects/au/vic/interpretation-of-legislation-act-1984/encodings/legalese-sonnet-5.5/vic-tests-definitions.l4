IMPORT prelude
IMPORT `vic-nouns`
IMPORT `vic-definitions`

-- Tests for vic-definitions.l4. One block per defined term: the term is found, its kind is the one the verb in the text gives,
-- its wording is the text's wording after the verb, and it names as many members as the text has paragraphs under it.

-- s 3 def "amended"
#ASSERT `kind of the definition of a term` "s 3" "amended" FALSE EQUALS JUST VicIncludes
#ASSERT `wording of the definition of a term` "s 3" "amended" FALSE EQUALS JUST "altered or varied;"
#ASSERT `members the definition of a term names` "s 3" "amended" FALSE EQUALS JUST EMPTY
-- s 3 def "made"
#ASSERT `kind of the definition of a term` "s 3" "made" FALSE EQUALS JUST VicIncludes
#ASSERT `wording of the definition of a term` "s 3" "made" FALSE EQUALS JUST "issued or granted;"
#ASSERT `members the definition of a term names` "s 3" "made" FALSE EQUALS JUST EMPTY
-- s 3 def "repealed"
#ASSERT `kind of the definition of a term` "s 3" "repealed" FALSE EQUALS JUST VicIncludes
#ASSERT `wording of the definition of a term` "s 3" "repealed" FALSE EQUALS JUST "revoked or rescinded."
#ASSERT `members the definition of a term names` "s 3" "repealed" FALSE EQUALS JUST EMPTY
-- s 38 def "Act"
#ASSERT `kind of the definition of a term` "s 38" "Act" FALSE EQUALS JUST VicMeans
#ASSERT `wording of the definition of a term` "s 38" "Act" FALSE EQUALS JUST "an Act passed by the Parliament of Victoria;"
#ASSERT `members the definition of a term names` "s 38" "Act" FALSE EQUALS JUST EMPTY
