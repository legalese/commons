#ASSERT `kind of the definition of a term` "s 38" "audio visual link" FALSE EQUALS JUST VicHasTheSameMeaningAs
#ASSERT `wording of the definition of a term` "s 38" "audio visual link" FALSE EQUALS JUST "given by Part IIA of the Evidence (Miscellaneous Provisions) Act 1958;"
#ASSERT `members the definition of a term names` "s 38" "audio visual link" FALSE EQUALS JUST EMPTY
-- s 38 def "Australia"
#ASSERT `kind of the definition of a term` "s 38" "Australia" FALSE EQUALS JUST VicIncludes
#ASSERT `wording of the definition of a term` "s 38" "Australia" FALSE EQUALS JUST "the Territory of Christmas Island and the Territory of Cocos (Keeling) Islands, but does not include any other external Territory;"
#ASSERT `members the definition of a term names` "s 38" "Australia" FALSE EQUALS JUST EMPTY
