#ASSERT `s39A the inserted definition is taken to be inserted in the appropriate alphabetical position` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s39A the inserted definition is taken to be inserted in the appropriate alphabetical position` FALSE FALSE EQUALS JUST FALSE
