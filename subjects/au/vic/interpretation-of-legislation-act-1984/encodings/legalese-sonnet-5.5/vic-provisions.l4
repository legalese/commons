IMPORT prelude

-- Provision index of the Interpretation of Legislation Act 1984 (Victoria): one entry for each Part, section, Schedule and Schedule clause.
-- Generated by a script that reads only the text file: a Part line, a number-and-heading line, a Schedule line or a clause number starts an entry.
-- The identifier is written "s 35", "Part IV", "Sch 1" or "Sch 1 cl 2A"; the number as printed and the heading as printed follow.
-- A heading is the words after the number on the heading line, with a converter mark such as [endnote 4] removed; clauses of the Schedule carry no heading.

DECLARE VicProvisionKind IS ONE OF
    VicPartOfTheAct
    VicSection
    VicSchedule
    VicClause

DECLARE VicProvisionEntry HAS
    `identifier`              IS A STRING
    `kind`                    IS A VicProvisionKind
    `number as printed`       IS A STRING
    `heading as printed`      IS A STRING
    `line in the text`        IS A NUMBER

`provision index` MEANS
    LIST
      (VicProvisionEntry OF "Part I", VicPartOfTheAct, "Part I", "Preliminary", 23)
      , (VicProvisionEntry OF "s 1", VicSection, "1", "Short title", 25)
      , (VicProvisionEntry OF "s 2", VicSection, "2", "Commencement", 28)
      , (VicProvisionEntry OF "s 3", VicSection, "3", "Definitions", 31)
      , (VicProvisionEntry OF "s 4", VicSection, "4", "Application, construction and repeal provisions", 41)
      , (VicProvisionEntry OF "s 5", VicSection, "5", "Act to bind Crown", 49)
      , (VicProvisionEntry OF "Part II", VicPartOfTheAct, "Part II", "Provisions applicable to Acts", 52)
