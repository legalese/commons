IMPORT prelude
IMPORT `vic-nouns`
IMPORT `vic-interpretation-time`
IMPORT `vic-part4-b-powers`
IMPORT `vic-part4-c-general`

-- Tests for Part IV, ss 45 to 58. Each expected value is written by hand from the section named beside it.

§ `s 45`

#ASSERT `s45(1) the power may be exercised, or not, at discretion` VicMay TRUE EQUALS JUST TRUE
#ASSERT `s45(1) the power may be exercised, or not, at discretion` VicShall TRUE EQUALS JUST FALSE
#ASSERT `s45(1) the power may be exercised, or not, at discretion` VicMay FALSE EQUALS JUST FALSE
#ASSERT `s45(2) the power must be exercised` VicShall TRUE EQUALS JUST TRUE
#ASSERT `s45(2) the power must be exercised` VicMay TRUE EQUALS JUST FALSE
#ASSERT `s45(2) the power must be exercised` VicShall FALSE EQUALS JUST FALSE
#ASSERT `s45(3) the rule of construction to the contrary applies` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s45(3) the rule of construction to the contrary applies` TRUE FALSE EQUALS NOTHING
#ASSERT `s45(3) the rule of construction to the contrary applies` FALSE TRUE EQUALS NOTHING

§ `s 46`

#ASSERT `s46(1) the reference is a reference to the Sovereign for the time being` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s46(1) the reference is a reference to the Sovereign for the time being` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s46(1) the reference is a reference to the Sovereign for the time being` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s46(2) the expression is construed as a reference to` VicTheSovereignIsTheQueen "His Majesty" FALSE EQUALS JUST "Her Majesty"
#ASSERT `s46(2) the expression is construed as a reference to` VicTheSovereignIsTheQueen "the King" FALSE EQUALS JUST "the Queen"
#ASSERT `s46(2) the expression is construed as a reference to` VicTheSovereignIsTheKing "Her Majesty" FALSE EQUALS JUST "His Majesty"
#ASSERT `s46(2) the expression is construed as a reference to` VicTheSovereignIsTheKing "the Queen" FALSE EQUALS JUST "the King"
#ASSERT `s46(2) the expression is construed as a reference to` VicTheSovereignIsTheQueen "Her Majesty" FALSE EQUALS NOTHING
#ASSERT `s46(2) the expression is construed as a reference to` VicTheSovereignIsTheKing "His Majesty" FALSE EQUALS NOTHING
#ASSERT `s46(2) the expression is construed as a reference to` VicTheSovereignIsTheQueen "His Majesty" TRUE EQUALS NOTHING

§ `s 46A`

#ASSERT `s46A the entity has the status, privileges and immunities of the Crown` (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s46A the entity has the status, privileges and immunities of the Crown` (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s46A the entity has the status, privileges and immunities of the Crown` NOTHING FALSE EQUALS NOTHING
#ASSERT `s46A the entity has the status, privileges and immunities of the Crown` (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s46A(4) the thing is within the Crown as the section uses the word` "the State" EQUALS JUST TRUE
#ASSERT `s46A(4) the thing is within the Crown as the section uses the word` "a statutory authority" EQUALS NOTHING

§ `ss 47, 48`

#ASSERT `s47 the person is within the reference` TRUE FALSE VicThePersonForTheTimeBeingHoldingTheOffice EQUALS JUST TRUE
#ASSERT `s47 the person is within the reference` TRUE FALSE VicThePersonForTheTimeBeingActingInTheOffice EQUALS JUST TRUE
#ASSERT `s47 the person is within the reference` TRUE FALSE VicThePersonForTheTimeBeingPerformingTheDutiesOfTheOffice EQUALS JUST TRUE
#ASSERT `s47 the person is within the reference` TRUE FALSE VicSomeoneElse EQUALS NOTHING
#ASSERT `s47 the person is within the reference` FALSE FALSE VicThePersonForTheTimeBeingHoldingTheOffice EQUALS JUST FALSE
#ASSERT `s47 the person is within the reference` TRUE TRUE VicThePersonForTheTimeBeingHoldingTheOffice EQUALS JUST FALSE
#ASSERT `s48 the reference is a reference to the officer, office, locality, jurisdiction, matter or thing in and for or of Victoria` VicReferenceToAnOfficerOrOffice FALSE TRUE EQUALS JUST TRUE
#ASSERT `s48 the reference is a reference to the officer, office, locality, jurisdiction, matter or thing in and for or of Victoria` VicReferenceToAnOfficerOrOffice FALSE FALSE EQUALS JUST FALSE
#ASSERT `s48 the reference is a reference to the officer, office, locality, jurisdiction, matter or thing in and for or of Victoria` VicReferenceToALocalityJurisdictionOrOtherMatterOrThing FALSE TRUE EQUALS JUST TRUE
#ASSERT `s48 the reference is a reference to the officer, office, locality, jurisdiction, matter or thing in and for or of Victoria` VicReferenceToALocalityJurisdictionOrOtherMatterOrThing TRUE TRUE EQUALS JUST FALSE
#ASSERT `s48 the reference is a reference to the officer, office, locality, jurisdiction, matter or thing in and for or of Victoria` VicAnyOtherReference48 FALSE TRUE EQUALS NOTHING

§ `ss 50, 51, 52, 53`

#ASSERT `s50 the authority may make the rule or order` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s50 the authority may make the rule or order` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s50 the authority may make the rule or order` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s50 the authority may make the rule or order` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s51(2) the thing is a law` VicAnActOrAProvisionOfAnAct EQUALS JUST TRUE
#ASSERT `s51(2) the thing is a law` VicASubordinateInstrumentOrAProvisionOfOne EQUALS JUST TRUE
#ASSERT `s51(2) the thing is a law` VicCommonLaw EQUALS JUST TRUE
#ASSERT `s51(2) the thing is a law` VicSomethingThatIsNotALaw EQUALS JUST FALSE
#ASSERT `s51(1) the offender is liable to be prosecuted under any or all of those laws` 2 FALSE EQUALS JUST TRUE
#ASSERT `s51(1) the offender is liable to be prosecuted under any or all of those laws` 3 FALSE EQUALS JUST TRUE
#ASSERT `s51(1) the offender is liable to be prosecuted under any or all of those laws` 1 FALSE EQUALS JUST FALSE
#ASSERT `s51(1) the offender is liable to be prosecuted under any or all of those laws` 2 TRUE EQUALS JUST FALSE
#ASSERT `s51(1) the offender is liable to be punished more than once for the same act or omission` 2 FALSE EQUALS JUST FALSE
#ASSERT `s51(1) the offender is liable to be punished more than once for the same act or omission` 1 FALSE EQUALS NOTHING
#ASSERT `s51(1) the offender is liable to be punished more than once for the same act or omission` 2 TRUE EQUALS NOTHING
#ASSERT `s52 the proceeding or matter must be heard and determined only by or before the Magistrates' Court` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s52 the proceeding or matter must be heard and determined only by or before the Magistrates' Court` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s52 the proceeding or matter must be heard and determined only by or before the Magistrates' Court` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s52 the proceeding or matter must be heard and determined only by or before the Magistrates' Court` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s52 the proceeding or matter must be heard and determined only by or before the Magistrates' Court` TRUE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s53 the form used is sufficient in law` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s53 the form used is sufficient in law` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s53 the form used is sufficient in law` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s53 the form used is sufficient in law` TRUE TRUE TRUE EQUALS JUST FALSE

§ `s 54`

#ASSERT `s54(1) the copy of the Imperial Act the reference points at` TRUE FALSE FALSE EQUALS JUST VicTheRevisedEditionOfTheStatutesPrintedByAuthority
#ASSERT `s54(1) the copy of the Imperial Act the reference points at` FALSE TRUE FALSE EQUALS JUST VicTheEditionPreparedUnderTheDirectionOfTheRecordCommission
#ASSERT `s54(1) the copy of the Imperial Act the reference points at` FALSE FALSE FALSE EQUALS JUST VicACopyPrintedByTheKingsPrinterOrUnderTheAuthorityOfHisMajestysStationeryOffice
#ASSERT `s54(1) the copy of the Imperial Act the reference points at` TRUE TRUE FALSE EQUALS JUST VicTheRevisedEditionOfTheStatutesPrintedByAuthority
#ASSERT `s54(1) the copy of the Imperial Act the reference points at` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s54(2) the reference is a reference to a copy printed by the government printer of that State` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s54(2) the reference is a reference to a copy printed by the government printer of that State` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s54(2) the reference is a reference to a copy printed by the government printer of that State` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s54(2A) the document is admissible on its mere production` TRUE VicGovernmentPrinterOfAnAustralasianState EQUALS JUST TRUE
#ASSERT `s54(2A) the document is admissible on its mere production` TRUE VicSomeOtherPrinter EQUALS NOTHING
#ASSERT `s54(2A) the document is admissible on its mere production` FALSE VicGovernmentPrinterOfAnAustralasianState EQUALS NOTHING
#ASSERT `s54(2B) the document is admissible on its mere production` TRUE VicGovernmentPrinterForVictoria TRUE EQUALS JUST TRUE
#ASSERT `s54(2B) the document is admissible on its mere production` TRUE VicGovernmentPrinterForVictoria FALSE EQUALS NOTHING
#ASSERT `s54(2B) the document is admissible on its mere production` TRUE VicGovernmentPrinterOfAnAustralasianStateOtherThanVictoria TRUE EQUALS NOTHING
#ASSERT `s54(2C) the document is admissible on its mere production` TRUE VicGovernmentPrinterOfAnAustralasianStateOtherThanVictoria TRUE EQUALS JUST TRUE
#ASSERT `s54(2C) the document is admissible on its mere production` TRUE VicGovernmentPrinterOfAnAustralasianStateOtherThanVictoria FALSE EQUALS JUST FALSE
#ASSERT `s54(2C) the document is admissible on its mere production` TRUE VicGovernmentPrinterForVictoria TRUE EQUALS NOTHING
#ASSERT `s54(3) where the meaning of the expression is found` "Act" EQUALS JUST "Divisions 4 and 6 of Part III of the Evidence (Miscellaneous Provisions) Act 1958"
#ASSERT `s54(3) where the meaning of the expression is found` "Australasian State" EQUALS JUST "Divisions 4 and 6 of Part III of the Evidence (Miscellaneous Provisions) Act 1958"
#ASSERT `s54(3) where the meaning of the expression is found` "government printer" EQUALS JUST "Divisions 4 and 6 of Part III of the Evidence (Miscellaneous Provisions) Act 1958"
#ASSERT `s54(3) where the meaning of the expression is found` "Crown" EQUALS NOTHING

