#ASSERT `s54A(4) the alteration to a statutory rule has effect for the purpose as if it had been made by a statutory rule` FALSE VicAnyOtherPurposeOfTheAlteration EQUALS JUST FALSE

§ `s 55`

#ASSERT `s55(1)(b) the thing is a law of Victoria` VicAnActAsALawOfVictoria EQUALS JUST TRUE
#ASSERT `s55(1)(b) the thing is a law of Victoria` VicASubordinateInstrumentAsALawOfVictoria EQUALS JUST TRUE
