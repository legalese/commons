#ASSERT `s55(2) the person is one to whom a reference to a British subject is construed as referring` FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s55(2) the person is one to whom a reference to a British subject is construed as referring` FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
