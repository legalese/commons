IMPORT prelude
IMPORT `aca-dates`
IMPORT `aca-amounts`
IMPORT `aca-damages`

-- Accident Compensation Act 1985 (Vic) -- worked cases for the damages questions (aca-damages.l4), and for the date
-- counting of aca-dates.l4. Every expected value was worked by hand from the deposited text (and, for the thresholds and
-- maximums, from Gazette S 363 of 30 June 2026); none was copied from the encoding's output. Each assertion is a claim
-- about the ENCODING on stated facts, not about the law. The facts are illustrative.
-- BASELINE ENCODING. Not for public use as advice. See NOTES.md.

§ `cases`

`d` MEANS `the calendar date`

§§ `s 134AB(6A) -- the count that leaves out 24 December to 9 January`

-- 20 December 2026 to 12 January 2027: 21, 22, 23 December and 10, 11, 12 January: 6 days.
#ASSERT `the counted days from` (`d` 20 12 2026) `to` (`d` 12 1 2027) EQUALS 6
-- 120 counted days after 1 November 2026: 29 (November) + 23 (December) + 22 (January) + 28 (February) + 18 = 18 March 2027.
#ASSERT `the date` 120 `counted days after` (`d` 1 11 2026) EQUALS `d` 18 3 2027
-- A period cannot end in the left-out days: 13 counted days after 10 December 2026 is 23 December; 14 is 10 January 2027.
#ASSERT `the date` 13 `counted days after` (`d` 10 12 2026) EQUALS `d` 23 12 2026
#ASSERT `the date` 14 `counted days after` (`d` 10 12 2026) EQUALS `d` 10 1 2027
#ASSERT (`d` 24 12 2026) `falls in the Christmas period of s 134AB(6A)` EQUALS TRUE
#ASSERT (`d` 9 1 2027) `falls in the Christmas period of s 134AB(6A)` EQUALS TRUE
#ASSERT (`d` 10 1 2027) `falls in the Christmas period of s 134AB(6A)` EQUALS FALSE
#ASSERT (`d` 23 12 2026) `falls in the Christmas period of s 134AB(6A)` EQUALS FALSE

§§ `Which section`

-- Arguments: injury, dust condition, transport accident.
#ASSERT `Which section decides whether I can sue for damages` (`d` 1 3 1996) FALSE FALSE EQUALS JUST `section 135A, for employment before 12 November 1997`
#ASSERT `Which section decides whether I can sue for damages` (`d` 11 11 1997) FALSE FALSE EQUALS JUST `section 135A, for employment before 12 November 1997`
#ASSERT `Which section decides whether I can sue for damages` (`d` 12 11 1997) FALSE FALSE EQUALS JUST `no damages of any kind, under section 134A(1)`
#ASSERT `Which section decides whether I can sue for damages` (`d` 12 11 1997) TRUE FALSE EQUALS JUST `section 134AB, through section 134AB(2A), for a dust condition`
#ASSERT `Which section decides whether I can sue for damages` (`d` 19 10 1999) FALSE FALSE EQUALS JUST `no damages of any kind, under section 134A(1)`
#ASSERT `Which section decides whether I can sue for damages` (`d` 20 10 1999) FALSE FALSE EQUALS JUST `section 134AB, for employment from 20 October 1999 to 30 June 2014`
#ASSERT `Which section decides whether I can sue for damages` (`d` 30 6 2014) FALSE FALSE EQUALS JUST `section 134AB, for employment from 20 October 1999 to 30 June 2014`
#ASSERT `Which section decides whether I can sue for damages` (`d` 1 7 2014) FALSE FALSE EQUALS NOTHING
#ASSERT `Which section decides whether I can sue for damages` (`d` 31 8 1985) FALSE FALSE EQUALS NOTHING
#ASSERT `Which section decides whether I can sue for damages` (`d` 1 9 1985) FALSE FALSE EQUALS JUST `section 135A, for employment before 12 November 1997`
#ASSERT `Which section decides whether I can sue for damages` (`d` 1 3 2005) FALSE TRUE EQUALS NOTHING

§§ `s 134AB(15)`

#ASSERT `Is my injury deemed serious by its impairment` TRUE 30 EQUALS JUST TRUE
#ASSERT `Is my injury deemed serious by its impairment` TRUE 29 EQUALS JUST FALSE
#ASSERT `Is my injury deemed serious by its impairment` FALSE 40 EQUALS JUST FALSE

§§ `s 134AB(3), (4), (4A), (21) -- the application`

-- Arguments: route, applied before, accepted determinations, directions allow, event day, application day, s 98C claim,
-- determined and accepted, entitlement accepted.
#ASSERT `May I make my serious injury application now` `after determinations of my impairment under s 104B` FALSE TRUE FALSE (`d` 1 1 2012) (`d` 1 3 2012) FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `May I make my serious injury application now` `after determinations of my impairment under s 104B` FALSE FALSE FALSE (`d` 1 1 2012) (`d` 1 3 2012) FALSE FALSE FALSE EQUALS JUST FALSE
-- A second application: no.
#ASSERT `May I make my serious injury application now` `after determinations of my impairment under s 104B` TRUE TRUE FALSE (`d` 1 1 2012) (`d` 1 3 2012) FALSE FALSE FALSE EQUALS JUST FALSE
-- Electing: 18 months after 1 January 2012 is 1 July 2013.
#ASSERT `May I make my serious injury application now` `by electing to apply on the ground that I have a serious injury` FALSE FALSE TRUE (`d` 1 1 2012) (`d` 1 7 2013) FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `May I make my serious injury application now` `by electing to apply on the ground that I have a serious injury` FALSE FALSE TRUE (`d` 1 1 2012) (`d` 30 6 2013) FALSE FALSE FALSE EQUALS JUST FALSE
-- 18 months after 15 September 2012 is 15 March 2014.
#ASSERT `May I make my serious injury application now` `by electing to apply on the ground that I have a serious injury` FALSE FALSE TRUE (`d` 15 9 2012) (`d` 15 3 2014) FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `May I make my serious injury application now` `by electing to apply on the ground that I have a serious injury` FALSE FALSE TRUE (`d` 15 9 2012) (`d` 14 3 2014) FALSE FALSE FALSE EQUALS JUST FALSE
-- The Minister's directions do not allow the election.
#ASSERT `May I make my serious injury application now` `by electing to apply on the ground that I have a serious injury` FALSE FALSE FALSE (`d` 1 1 2012) (`d` 1 7 2014) FALSE FALSE FALSE EQUALS JUST FALSE
-- A s 98C claim: both acceptances needed.
#ASSERT `May I make my serious injury application now` `after determinations of my impairment under s 104B` FALSE TRUE FALSE (`d` 1 1 2012) (`d` 1 3 2012) TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `May I make my serious injury application now` `after determinations of my impairment under s 104B` FALSE TRUE FALSE (`d` 1 1 2012) (`d` 1 3 2012) TRUE TRUE FALSE EQUALS JUST FALSE

§§ `s 134AB(7), (9) -- WorkSafe's answer`

-- Arguments: received, advised, day of advice, today, days disregarded, directions.
-- Received 1 November 2026: the last day is 18 March 2027.
#ASSERT `By when must my serious injury application be answered` (`d` 1 11 2026) 0 EQUALS `d` 18 3 2027
#ASSERT `By when must my serious injury application be answered` (`d` 1 11 2026) 5 EQUALS `d` 23 3 2027
-- No Christmas in the way: 1 March 2026 + 120 days = 29 June 2026.
#ASSERT `By when must my serious injury application be answered` (`d` 1 3 2026) 0 EQUALS `d` 29 6 2026
-- Advised on the last day: not deemed. A day late: deemed.
#ASSERT `Am I deemed to have a serious injury because the answer was late` (`d` 1 11 2026) TRUE (`d` 18 3 2027) (`d` 1 4 2027) 0 FALSE EQUALS JUST FALSE
#ASSERT `Am I deemed to have a serious injury because the answer was late` (`d` 1 11 2026) TRUE (`d` 19 3 2027) (`d` 1 4 2027) 0 FALSE EQUALS JUST TRUE
-- No advice yet: on 18 March 2027 the duty is still open; on 19 March deemed.
#ASSERT `Am I deemed to have a serious injury because the answer was late` (`d` 1 11 2026) FALSE (`d` 1 1 2000) (`d` 18 3 2027) 0 FALSE EQUALS JUST FALSE
#ASSERT `Am I deemed to have a serious injury because the answer was late` (`d` 1 11 2026) FALSE (`d` 1 1 2000) (`d` 19 3 2027) 0 FALSE EQUALS JUST TRUE
-- 5 days disregarded: 23 March in time, 24 March late.
#ASSERT `Am I deemed to have a serious injury because the answer was late` (`d` 1 11 2026) TRUE (`d` 23 3 2027) (`d` 1 4 2027) 5 FALSE EQUALS JUST FALSE
#ASSERT `Am I deemed to have a serious injury because the answer was late` (`d` 1 11 2026) TRUE (`d` 24 3 2027) (`d` 1 4 2027) 5 FALSE EQUALS JUST TRUE
-- Directions set another period.
#ASSERT `Am I deemed to have a serious injury because the answer was late` (`d` 1 11 2026) TRUE (`d` 24 3 2027) (`d` 1 4 2027) 0 TRUE EQUALS NOTHING

§§ `s 134AB(16)(b), (37), (12)(b), (13) -- the dates after the answer`

-- Leave: 30 counted days. From 10 December 2026: 13 in December, 17 in January: 26 January 2027. From 1 March 2026: 31 March.
#ASSERT `By when must I apply for leave to sue` (`d` 10 12 2026) EQUALS `d` 26 1 2027
#ASSERT `By when must I apply for leave to sue` (`d` 1 3 2026) EQUALS `d` 31 3 2026
-- The response date: 28 plain days.
#ASSERT `What is my response date` (`d` 1 3 2026) EQUALS `d` 29 3 2026
#ASSERT `What is my response date` (`d` 10 12 2026) EQUALS `d` 7 1 2027
-- The statutory offer: 60 counted days after the response date of 29 March 2026: 28 May 2026.
#ASSERT `By when must the statutory offer be made` (`d` 29 3 2026) EQUALS `d` 28 5 2026

§§ `s 134AB(12), (14), (20A) -- commencing proceedings`

-- Arguments: conference held, statutory offer day, counter offer made, counter offer day, counter offer accepted, consent,
-- day of commencing.
-- Offer 1 March 2026, counter offer 15 March: from 5 April (21 days) to 5 May 2026 (51 days).
#ASSERT `May I commence my proceedings on this day` TRUE (`d` 1 3 2026) TRUE (`d` 15 3 2026) FALSE FALSE (`d` 4 4 2026) EQUALS JUST FALSE
#ASSERT `May I commence my proceedings on this day` TRUE (`d` 1 3 2026) TRUE (`d` 15 3 2026) FALSE FALSE (`d` 5 4 2026) EQUALS JUST TRUE
#ASSERT `May I commence my proceedings on this day` TRUE (`d` 1 3 2026) TRUE (`d` 15 3 2026) FALSE FALSE (`d` 5 5 2026) EQUALS JUST TRUE
#ASSERT `May I commence my proceedings on this day` TRUE (`d` 1 3 2026) TRUE (`d` 15 3 2026) FALSE FALSE (`d` 6 5 2026) EQUALS JUST FALSE
-- With the Authority's consent under (20A): yes.
#ASSERT `May I commence my proceedings on this day` TRUE (`d` 1 3 2026) TRUE (`d` 15 3 2026) FALSE TRUE (`d` 6 5 2026) EQUALS JUST TRUE
-- The counter offer accepted: settled, no proceedings. No conference: no.
#ASSERT `May I commence my proceedings on this day` TRUE (`d` 1 3 2026) TRUE (`d` 15 3 2026) TRUE FALSE (`d` 10 4 2026) EQUALS JUST FALSE
#ASSERT `May I commence my proceedings on this day` FALSE (`d` 1 3 2026) TRUE (`d` 15 3 2026) FALSE FALSE (`d` 10 4 2026) EQUALS JUST FALSE
-- No counter offer: deemed made on 22 March 2026 (21 days); proceedings up to 21 April 2026 (30 days), from 23 March.
#ASSERT `May I commence my proceedings on this day` TRUE (`d` 1 3 2026) FALSE (`d` 1 1 2000) FALSE FALSE (`d` 21 4 2026) EQUALS JUST TRUE
#ASSERT `May I commence my proceedings on this day` TRUE (`d` 1 3 2026) FALSE (`d` 1 1 2000) FALSE FALSE (`d` 22 4 2026) EQUALS JUST FALSE
#ASSERT `May I commence my proceedings on this day` TRUE (`d` 1 3 2026) FALSE (`d` 1 1 2000) FALSE FALSE (`d` 22 3 2026) EQUALS JUST FALSE
#ASSERT `May I commence my proceedings on this day` TRUE (`d` 1 3 2026) FALSE (`d` 1 1 2000) FALSE FALSE (`d` 23 3 2026) EQUALS JUST TRUE
-- The last day.
#ASSERT `What is the last day I may commence my proceedings` (`d` 1 3 2026) TRUE (`d` 15 3 2026) EQUALS `d` 5 5 2026
#ASSERT `What is the last day I may commence my proceedings` (`d` 1 3 2026) FALSE (`d` 1 1 2000) EQUALS `d` 21 4 2026
-- Over Christmas: counter offer 20 December 2026: 51 counted days is 26 February 2027; 21 counted days is 27 January 2027.
#ASSERT `What is the last day I may commence my proceedings` (`d` 10 12 2026) TRUE (`d` 20 12 2026) EQUALS `d` 26 2 2027
#ASSERT `May I commence my proceedings on this day` TRUE (`d` 10 12 2026) TRUE (`d` 20 12 2026) FALSE FALSE (`d` 26 1 2027) EQUALS JUST FALSE
#ASSERT `May I commence my proceedings on this day` TRUE (`d` 10 12 2026) TRUE (`d` 20 12 2026) FALSE FALSE (`d` 27 1 2027) EQUALS JUST TRUE

§§ `s 134AB(15)-(17), (21A) -- what I may sue for`

-- Arguments: deemed, certificate, leave, grounds, (21A).
#ASSERT `What damages may I sue for under s 134AB` TRUE FALSE FALSE `the pain and suffering consequence only` FALSE EQUALS `pecuniary loss damages and pain and suffering damages`
#ASSERT `What damages may I sue for under s 134AB` FALSE TRUE FALSE `the pain and suffering consequence only` FALSE EQUALS `pain and suffering damages only`
#ASSERT `What damages may I sue for under s 134AB` FALSE FALSE TRUE `both the pain and suffering and the loss of earning capacity consequences` FALSE EQUALS `pecuniary loss damages and pain and suffering damages`
#ASSERT `What damages may I sue for under s 134AB` FALSE FALSE FALSE `both the pain and suffering and the loss of earning capacity consequences` FALSE EQUALS `no proceedings yet`
#ASSERT `What damages may I sue for under s 134AB` TRUE FALSE FALSE `both the pain and suffering and the loss of earning capacity consequences` TRUE EQUALS `no damages for this injury`

§§ `s 134AB(38)(e)-(g) -- loss of earning capacity`

-- Arguments: earning, capable of, without the injury, young, found, permanent, after rehabilitation.
-- $100,000 before; $50,000 earned, $55,000 capable: a 45% loss; rehabilitation to $60,000 is not more than 60%: met.
#ASSERT `Do I meet the loss of earning capacity test` 50000 55000 100000 FALSE 0 TRUE 60000 EQUALS JUST TRUE
-- $60,001 after rehabilitation is more than 60%: (g) bars it.
#ASSERT `Do I meet the loss of earning capacity test` 50000 55000 100000 FALSE 0 TRUE 60001 EQUALS JUST FALSE
-- Capable of $60,000: exactly 40%: met; $60,001: just under 40%: not met.
#ASSERT `Do I meet the loss of earning capacity test` 50000 60000 100000 FALSE 0 TRUE 60000 EQUALS JUST TRUE
#ASSERT `Do I meet the loss of earning capacity test` 50000 60001 100000 FALSE 0 TRUE 60000 EQUALS JUST FALSE
-- Not permanent: not met.
#ASSERT `Do I meet the loss of earning capacity test` 50000 55000 100000 FALSE 0 FALSE 60000 EQUALS JUST FALSE
-- Under 26: the loss found (40%) counts, not the (f) comparison.
#ASSERT `Do I meet the loss of earning capacity test` 90000 90000 100000 TRUE 40 TRUE 60000 EQUALS JUST TRUE
#ASSERT `Do I meet the loss of earning capacity test` 50000 50000 100000 TRUE 39 TRUE 50000 EQUALS JUST FALSE
-- No pre-injury income: nothing to measure.
#ASSERT `Do I meet the loss of earning capacity test` 0 0 0 FALSE 0 TRUE 0 EQUALS NOTHING

§§ `s 135A(2), (2A), s 135AC`

-- Arguments: injury, serious, significant, incapacity known, determined, applied for a determination, Limitation Act.
#ASSERT `May I recover damages under s 135A` (`d` 1 3 1995) TRUE TRUE (`d` 1 3 1995) TRUE (`d` 1 6 2000) TRUE EQUALS JUST TRUE
#ASSERT `May I recover damages under s 135A` (`d` 1 3 1995) TRUE TRUE (`d` 1 3 1995) TRUE (`d` 31 8 2000) TRUE EQUALS JUST TRUE
#ASSERT `May I recover damages under s 135A` (`d` 1 3 1995) TRUE TRUE (`d` 1 3 1995) TRUE (`d` 1 9 2000) TRUE EQUALS JUST FALSE
#ASSERT `May I recover damages under s 135A` (`d` 1 3 1995) TRUE TRUE (`d` 1 3 1995) TRUE (`d` 1 6 2000) FALSE EQUALS JUST FALSE
#ASSERT `May I recover damages under s 135A` (`d` 1 3 1995) TRUE FALSE (`d` 1 3 1995) TRUE (`d` 1 6 2000) TRUE EQUALS JUST FALSE
#ASSERT `May I recover damages under s 135A` (`d` 1 3 1995) TRUE TRUE (`d` 1 3 1995) FALSE (`d` 1 6 2000) TRUE EQUALS JUST FALSE
-- Injured 1 March 1990: the incapacity must not be known until 1 December 1992 or later.
#ASSERT `May I recover damages under s 135A` (`d` 1 3 1990) TRUE FALSE (`d` 1 3 1991) TRUE (`d` 1 6 2000) TRUE EQUALS JUST FALSE
#ASSERT `May I recover damages under s 135A` (`d` 1 3 1990) TRUE FALSE (`d` 1 12 1992) TRUE (`d` 1 6 2000) TRUE EQUALS JUST TRUE
-- Incapacity known 1 March 2005: an application by 1 March 2008 (3 years) is in time, 2 March 2008 is not.
#ASSERT `May I recover damages under s 135A` (`d` 1 3 1995) TRUE TRUE (`d` 1 3 2005) TRUE (`d` 1 3 2008) FALSE EQUALS JUST TRUE
#ASSERT `May I recover damages under s 135A` (`d` 1 3 1995) TRUE TRUE (`d` 1 3 2005) TRUE (`d` 2 3 2008) FALSE EQUALS JUST FALSE
-- Known on 12 November 1997 itself: paragraph (a) and the 1 September 2000 date.
#ASSERT `May I recover damages under s 135A` (`d` 1 3 1995) TRUE TRUE (`d` 12 11 1997) TRUE (`d` 1 10 2000) TRUE EQUALS JUST FALSE
#ASSERT `May I recover damages under s 135A` (`d` 1 3 1995) TRUE TRUE (`d` 13 11 1997) TRUE (`d` 1 10 2000) TRUE EQUALS JUST TRUE
-- An injury on 12 November 1997: not s 135A.
#ASSERT `May I recover damages under s 135A` (`d` 12 11 1997) TRUE TRUE (`d` 12 11 1997) TRUE (`d` 1 6 2000) TRUE EQUALS NOTHING

