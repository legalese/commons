#ASSERT `When may my records be deleted` (`d` 10 6 2010) TRUE (`d` 15 3 2020) FALSE EQUALS JUST (`d` 10 6 2035)
-- An adult throughout, last service 31 December 2026: 31 December 2033, first day after 1 January 2034.
#ASSERT `When may my records be deleted` (`d` 10 6 1980) FALSE (`d` 31 12 2026) FALSE EQUALS JUST (`d` 1 1 2034)
-- Born 29 February 2004: 25 in February 2029, which has no 29th, so 28 February 2029 (fork F2); 7 years after 1
-- January 2010 ends 1 January 2017; the later is 28 February 2029.
#ASSERT `When may my records be deleted` (`d` 29 2 2004) TRUE (`d` 1 1 2010) FALSE EQUALS JUST (`d` 28 2 2029)
-- Last service 29 February 2024: 84 months on is February 2031, no 29th, so 28 February 2031; first day after 1 March.
#ASSERT `When may my records be deleted` (`d` 10 6 1980) FALSE (`d` 29 2 2024) FALSE EQUALS JUST (`d` 1 3 2031)
#ASSERT `When may my records be deleted` (`d` 10 6 1980) FALSE (`d` 31 12 2026) TRUE EQUALS NOTHING

