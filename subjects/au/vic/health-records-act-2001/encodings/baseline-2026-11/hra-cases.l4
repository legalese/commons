#ASSERT `Does the Act apply to them` TRUE FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Does the Act apply to them` TRUE FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Does the Act apply to them` TRUE FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
