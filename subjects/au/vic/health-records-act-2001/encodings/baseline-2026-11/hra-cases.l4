§§ `s 34 -- by when, and in time`

-- 45 days after 1 March 2027 is 15 April 2027; 45 days after 20 December 2026: 11 to 31 December, 31 to 31 January, 3
-- to 3 February 2027.
#ASSERT `By when must the organisation answer my access request` (`d` 1 3 2027) FALSE EQUALS JUST (`d` 15 4 2027)
#ASSERT `By when must the organisation answer my access request` (`d` 20 12 2026) FALSE EQUALS JUST (`d` 3 2 2027)
#ASSERT `By when must the organisation answer my access request` (`d` 1 3 2027) TRUE EQUALS NOTHING

-- Paid 10 April: 17 April is later than 15 April. Paid 5 March: 12 March is earlier, so 15 April. Paid 8 April: both
-- are 15 April.
#ASSERT `By when must I be given access after paying` (`d` 1 3 2027) (`d` 10 4 2027) EQUALS `d` 17 4 2027
#ASSERT `By when must I be given access after paying` (`d` 1 3 2027) (`d` 5 3 2027) EQUALS `d` 15 4 2027
#ASSERT `By when must I be given access after paying` (`d` 1 3 2027) (`d` 8 4 2027) EQUALS `d` 15 4 2027

-- Received 1 March 2027; the last day is 15 April 2027.
#ASSERT `Has my access request been answered in time` (`d` 1 3 2027) TRUE (`d` 15 4 2027) (`d` 20 4 2027) EQUALS `done in time`
#ASSERT `Has my access request been answered in time` (`d` 1 3 2027) TRUE (`d` 16 4 2027) (`d` 20 4 2027) EQUALS `not done in time`
#ASSERT `Has my access request been answered in time` (`d` 1 3 2027) TRUE (`d` 1 3 2027) (`d` 20 4 2027) EQUALS `done in time`
#ASSERT `Has my access request been answered in time` (`d` 1 3 2027) FALSE `any day` (`d` 15 4 2027) EQUALS `still open`
#ASSERT `Has my access request been answered in time` (`d` 1 3 2027) FALSE `any day` (`d` 16 4 2027) EQUALS `not done in time`

-- Received 1 March 2027, fee paid 10 April 2027; the last day is 17 April 2027.
#ASSERT `Have I been given access in time after paying` (`d` 1 3 2027) (`d` 10 4 2027) TRUE (`d` 17 4 2027) (`d` 20 4 2027) EQUALS `done in time`
#ASSERT `Have I been given access in time after paying` (`d` 1 3 2027) (`d` 10 4 2027) TRUE (`d` 18 4 2027) (`d` 20 4 2027) EQUALS `not done in time`
#ASSERT `Have I been given access in time after paying` (`d` 1 3 2027) (`d` 10 4 2027) FALSE `any day` (`d` 17 4 2027) EQUALS `still open`
#ASSERT `Have I been given access in time after paying` (`d` 1 3 2027) (`d` 10 4 2027) FALSE `any day` (`d` 18 4 2027) EQUALS `not done in time`

#ASSERT `Is it taken to have refused me access` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Is it taken to have refused me access` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Is it taken to have refused me access` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Is it taken to have refused me access` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Is it taken to have refused me access` FALSE FALSE FALSE TRUE EQUALS JUST TRUE

