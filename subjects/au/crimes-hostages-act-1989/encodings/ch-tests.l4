IMPORT prelude
IMPORT daydate
IMPORT `ch-rules`

-- Crimes (Hostages) Act 1989 (Cth) — the encoder's tests.

§ `Tests`

GIVEN pl IS A `Place of the act`, cit IS A BOOLEAN, here IS A BOOLEAN, aim IS A BOOLEAN
GIVETH A `Hostage case`
`a hostage-taking` pl `citizen` cit `present` here `aimed at Australia` aim MEANS
    `Hostage case` OF TRUE, TRUE, TRUE, Date 1 1 2020, Date 20 6 1990, pl, cit, here, aim, FALSE, FALSE, FALSE, FALSE, NOTHING

`abroad` MEANS `elsewhere outside Australia`

-- s 7
#ASSERT `it is hostage-taking` (`a hostage-taking` `in Australia` `citizen` FALSE `present` FALSE `aimed at Australia` FALSE)
#ASSERT NOT (`it is hostage-taking` (`Hostage case` OF TRUE, FALSE, TRUE, Date 1 1 2020, Date 20 6 1990, `in Australia`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING))
#ASSERT NOT (`it is hostage-taking` (`Hostage case` OF TRUE, TRUE, FALSE, Date 1 1 2020, Date 20 6 1990, `in Australia`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING))
-- s 8(1): before the Convention was in force
#ASSERT NOT (`it is an offence` (`Hostage case` OF TRUE, TRUE, TRUE, Date 1 1 1990, Date 20 6 1990, `in Australia`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING))
-- s 8(3)
#ASSERT `I may be charged` (`a hostage-taking` `in Australia` `citizen` FALSE `present` FALSE `aimed at Australia` FALSE)
#ASSERT `I may be charged` (`a hostage-taking` `on an Australian ship or aircraft` `citizen` FALSE `present` FALSE `aimed at Australia` FALSE)
#ASSERT NOT (`I may be charged` (`a hostage-taking` `abroad` `citizen` FALSE `present` FALSE `aimed at Australia` FALSE))
#ASSERT `I may be charged` (`a hostage-taking` `abroad` `citizen` TRUE `present` FALSE `aimed at Australia` FALSE)
#ASSERT `I may be charged` (`a hostage-taking` `abroad` `citizen` FALSE `present` TRUE `aimed at Australia` FALSE)
#ASSERT `I may be charged` (`a hostage-taking` `abroad` `citizen` FALSE `present` FALSE `aimed at Australia` TRUE)
-- s 9
#ASSERT NOT (`I may be charged` (`Hostage case` OF TRUE, TRUE, TRUE, Date 1 1 2020, Date 20 6 1990, `in Australia`, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, NOTHING))
#ASSERT NOT (`I may be charged` (`Hostage case` OF TRUE, TRUE, TRUE, Date 1 1 2020, Date 20 6 1990, `in Australia`, TRUE, TRUE, FALSE, FALSE, TRUE, FALSE, FALSE, NOTHING))
-- s 6(2)
#ASSERT NOT (`I may be convicted` (`Hostage case` OF TRUE, TRUE, TRUE, Date 1 1 2020, Date 20 6 1990, `in Australia`, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, NOTHING))
-- s 10
#ASSERT NOT (`I may be committed for trial` (`a hostage-taking` `in Australia` `citizen` FALSE `present` FALSE `aimed at Australia` FALSE))
#ASSERT `I may be committed for trial` (`Hostage case` OF TRUE, TRUE, TRUE, Date 1 1 2020, Date 20 6 1990, `in Australia`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, NOTHING)
-- s 12(1)
#ASSERT `the reappearance day for` (`Hostage case` OF TRUE, TRUE, TRUE, Date 1 1 2020, Date 20 6 1990, `on an Australian ship or aircraft`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, JUST (Date 10 3 2026)) EQUALS JUST (Date 7 4 2026)
