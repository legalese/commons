IMPORT prelude
IMPORT daydate
IMPORT `ch-rules`

-- 1 s 7
#ASSERT ((`the hostage position for` (`Hostage case` OF TRUE, TRUE, TRUE, (Date 1 6 2020), (Date 20 6 1990), `in Australia`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING))'s `hostage-taking (s 7)`) EQUALS TRUE

-- 1 s 8(1)
#ASSERT ((`the hostage position for` (`Hostage case` OF TRUE, TRUE, TRUE, (Date 1 6 2020), (Date 20 6 1990), `in Australia`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING))'s `an offence (s 8)`) EQUALS TRUE

-- 1 s 8(3)(a)(i)
#ASSERT ((`the hostage position for` (`Hostage case` OF TRUE, TRUE, TRUE, (Date 1 6 2020), (Date 20 6 1990), `in Australia`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING))'s `chargeable (ss 8(3), 9)`) EQUALS TRUE

-- 1 s 6(2)
#ASSERT ((`the hostage position for` (`Hostage case` OF TRUE, TRUE, TRUE, (Date 1 6 2020), (Date 20 6 1990), `in Australia`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING))'s `convictable (s 6(2))`) EQUALS TRUE

-- 1 s 8(2) life
#ASSERT ((`the hostage position for` (`Hostage case` OF TRUE, TRUE, TRUE, (Date 1 6 2020), (Date 20 6 1990), `in Australia`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING))'s `I may be imprisoned for life`) EQUALS TRUE

-- 2 s 7(a) no seizure
#ASSERT ((`the hostage position for` (`Hostage case` OF FALSE, TRUE, TRUE, (Date 1 6 2020), (Date 20 6 1990), `in Australia`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING))'s `hostage-taking (s 7)`) EQUALS FALSE

-- 3 s 7(b) no threat
#ASSERT ((`the hostage position for` (`Hostage case` OF TRUE, FALSE, TRUE, (Date 1 6 2020), (Date 20 6 1990), `in Australia`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING))'s `hostage-taking (s 7)`) EQUALS FALSE

-- 4 s 7 no intention
#ASSERT ((`the hostage position for` (`Hostage case` OF TRUE, TRUE, FALSE, (Date 1 6 2020), (Date 20 6 1990), `in Australia`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING))'s `an offence (s 8)`) EQUALS FALSE

-- 5 s 8(1): day before entry into force -> hostage-taking
#ASSERT ((`the hostage position for` (`Hostage case` OF TRUE, TRUE, TRUE, (Date 19 6 1990), (Date 20 6 1990), `in Australia`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING))'s `hostage-taking (s 7)`) EQUALS TRUE

-- 5 s 8(1): day before -> no offence
#ASSERT ((`the hostage position for` (`Hostage case` OF TRUE, TRUE, TRUE, (Date 19 6 1990), (Date 20 6 1990), `in Australia`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING))'s `an offence (s 8)`) EQUALS FALSE

-- 6 s 8(1): on the day of entry into force -> offence
#ASSERT ((`the hostage position for` (`Hostage case` OF TRUE, TRUE, TRUE, (Date 20 6 1990), (Date 20 6 1990), `in Australia`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING))'s `an offence (s 8)`) EQUALS TRUE

-- 7 s 8(1): day after
#ASSERT ((`the hostage position for` (`Hostage case` OF TRUE, TRUE, TRUE, (Date 21 6 1990), (Date 20 6 1990), `in Australia`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING))'s `an offence (s 8)`) EQUALS TRUE

-- 8 s 8(3)(a)(ii) Australian ship/aircraft
#ASSERT ((`the hostage position for` (`Hostage case` OF TRUE, TRUE, TRUE, (Date 1 6 2020), (Date 20 6 1990), `on an Australian ship or aircraft`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING))'s `chargeable (ss 8(3), 9)`) EQUALS TRUE

-- 9 s 8(3)(b)(i) citizen
#ASSERT ((`the hostage position for` (`Hostage case` OF TRUE, TRUE, TRUE, (Date 1 6 2020), (Date 20 6 1990), `elsewhere outside Australia`, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING))'s `chargeable (ss 8(3), 9)`) EQUALS TRUE

-- 10 s 8(3)(b)(ii) present
#ASSERT ((`the hostage position for` (`Hostage case` OF TRUE, TRUE, TRUE, (Date 1 6 2020), (Date 20 6 1990), `elsewhere outside Australia`, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING))'s `chargeable (ss 8(3), 9)`) EQUALS TRUE

-- 11 s 8(3)(b)(iii) Australian institution
#ASSERT ((`the hostage position for` (`Hostage case` OF TRUE, TRUE, TRUE, (Date 1 6 2020), (Date 20 6 1990), `elsewhere outside Australia`, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, NOTHING))'s `chargeable (ss 8(3), 9)`) EQUALS TRUE

-- 12 s 8(3) no link
#ASSERT ((`the hostage position for` (`Hostage case` OF TRUE, TRUE, TRUE, (Date 1 6 2020), (Date 20 6 1990), `elsewhere outside Australia`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING))'s `chargeable (ss 8(3), 9)`) EQUALS FALSE

-- 13 s 9(1) Art 12
#ASSERT ((`the hostage position for` (`Hostage case` OF TRUE, TRUE, TRUE, (Date 1 6 2020), (Date 20 6 1990), `in Australia`, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, NOTHING))'s `chargeable (ss 8(3), 9)`) EQUALS FALSE

-- 14 s 9(2) single State
#ASSERT ((`the hostage position for` (`Hostage case` OF TRUE, TRUE, TRUE, (Date 1 6 2020), (Date 20 6 1990), `in Australia`, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, NOTHING))'s `chargeable (ss 8(3), 9)`) EQUALS FALSE

-- 15 s 6(2): still chargeable
#ASSERT ((`the hostage position for` (`Hostage case` OF TRUE, TRUE, TRUE, (Date 1 6 2020), (Date 20 6 1990), `in Australia`, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, NOTHING))'s `chargeable (ss 8(3), 9)`) EQUALS TRUE

-- 15 s 6(2): not convictable
#ASSERT ((`the hostage position for` (`Hostage case` OF TRUE, TRUE, TRUE, (Date 1 6 2020), (Date 20 6 1990), `in Australia`, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, NOTHING))'s `convictable (s 6(2))`) EQUALS FALSE

-- 16 s 10(2): chargeable without consent
#ASSERT ((`the hostage position for` (`Hostage case` OF TRUE, TRUE, TRUE, (Date 1 6 2020), (Date 20 6 1990), `in Australia`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING))'s `chargeable (ss 8(3), 9)`) EQUALS TRUE

-- 16 s 10(1): no committal without consent
#ASSERT ((`the hostage position for` (`Hostage case` OF TRUE, TRUE, TRUE, (Date 1 6 2020), (Date 20 6 1990), `in Australia`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING))'s `committable for trial (s 10)`) EQUALS FALSE

-- 17 s 10(1) consent
#ASSERT ((`the hostage position for` (`Hostage case` OF TRUE, TRUE, TRUE, (Date 1 6 2020), (Date 20 6 1990), `in Australia`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, NOTHING))'s `committable for trial (s 10)`) EQUALS TRUE

-- 18 s 12(1) order 10 Jan 2025
#ASSERT ((`the hostage position for` (`Hostage case` OF TRUE, TRUE, TRUE, (Date 1 6 2020), (Date 20 6 1990), `in Australia`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, (JUST (Date 10 1 2025))))'s `the latest day to reappear after a change of venue`) EQUALS JUST (Date 7 2 2025)

-- 19 s 12(1) order 1 Feb 2024
#ASSERT ((`the hostage position for` (`Hostage case` OF TRUE, TRUE, TRUE, (Date 1 6 2020), (Date 20 6 1990), `in Australia`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, (JUST (Date 1 2 2024))))'s `the latest day to reappear after a change of venue`) EQUALS JUST (Date 29 2 2024)

-- 20 no offence, consent
#ASSERT ((`the hostage position for` (`Hostage case` OF FALSE, TRUE, TRUE, (Date 1 6 2020), (Date 20 6 1990), `in Australia`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, NOTHING))'s `committable for trial (s 10)`) EQUALS FALSE

-- no order -> no reappearance day
#ASSERT ((`the hostage position for` (`Hostage case` OF TRUE, TRUE, TRUE, (Date 1 6 2020), (Date 20 6 1990), `in Australia`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING))'s `the latest day to reappear after a change of venue`) EQUALS NOTHING
