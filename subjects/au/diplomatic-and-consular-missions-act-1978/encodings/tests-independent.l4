IMPORT prelude
IMPORT daydate
IMPORT `dcm-rules`

-- Independent tests from the source text (see independent-expectations.md).
-- Field order: mission, conduct, premises are mission's, implies another mission,
-- act for DOM, act for consented mission, engaged, likely, warrant issued on.
-- 1: sign at other premises, consented mission: caught, injunction, warrant (s 4(2)(a), 4(5)(a), 5(1))
#ASSERT `my conduct is caught` (`Missions case` OF `a diplomatic or consular mission of a country, established in Australia with the Commonwealth's consent`, `displaying a sign, flag or insignia, or causing or permitting it`, FALSE, TRUE, FALSE, FALSE, TRUE, FALSE, NOTHING)
#ASSERT `an injunction may be granted` (`Missions case` OF `a diplomatic or consular mission of a country, established in Australia with the Commonwealth's consent`, `displaying a sign, flag or insignia, or causing or permitting it`, FALSE, TRUE, FALSE, FALSE, TRUE, FALSE, NOTHING)
#ASSERT `a removal warrant may issue` (`Missions case` OF `a diplomatic or consular mission of a country, established in Australia with the Commonwealth's consent`, `displaying a sign, flag or insignia, or causing or permitting it`, FALSE, TRUE, FALSE, FALSE, TRUE, FALSE, NOTHING)
-- 2: at the mission's office: not caught (s 4(2)(a))
#ASSERT NOT (`my conduct is caught` (`Missions case` OF `a diplomatic or consular mission of a country, established in Australia with the Commonwealth's consent`, `displaying a sign, flag or insignia, or causing or permitting it`, TRUE, TRUE, FALSE, FALSE, TRUE, FALSE, NOTHING))
#ASSERT NOT (`an injunction may be granted` (`Missions case` OF `a diplomatic or consular mission of a country, established in Australia with the Commonwealth's consent`, `displaying a sign, flag or insignia, or causing or permitting it`, TRUE, TRUE, FALSE, FALSE, TRUE, FALSE, NOTHING))
#ASSERT NOT (`a removal warrant may issue` (`Missions case` OF `a diplomatic or consular mission of a country, established in Australia with the Commonwealth's consent`, `displaying a sign, flag or insignia, or causing or permitting it`, TRUE, TRUE, FALSE, FALSE, TRUE, FALSE, NOTHING))
-- 3: implies nothing: not caught (s 4(2)(a))
#ASSERT NOT (`my conduct is caught` (`Missions case` OF `a diplomatic or consular mission of a country, established in Australia with the Commonwealth's consent`, `displaying a sign, flag or insignia, or causing or permitting it`, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, NOTHING))
-- 4: representation: caught, injunction, no warrant (s 4(2)(b), 5(1))
#ASSERT `my conduct is caught` (`Missions case` OF `a diplomatic or consular mission of a country, established in Australia with the Commonwealth's consent`, `making or publishing a representation, or causing or permitting it`, FALSE, TRUE, FALSE, FALSE, TRUE, FALSE, NOTHING)
#ASSERT `an injunction may be granted` (`Missions case` OF `a diplomatic or consular mission of a country, established in Australia with the Commonwealth's consent`, `making or publishing a representation, or causing or permitting it`, FALSE, TRUE, FALSE, FALSE, TRUE, FALSE, NOTHING)
#ASSERT NOT (`a removal warrant may issue` (`Missions case` OF `a diplomatic or consular mission of a country, established in Australia with the Commonwealth's consent`, `making or publishing a representation, or causing or permitting it`, FALSE, TRUE, FALSE, FALSE, TRUE, FALSE, NOTHING))
-- 5/6: DOM staff in authorised capacity, or at their request: not caught (s 4(2)(c)-(d))
#ASSERT NOT (`my conduct is caught` (`Missions case` OF `a diplomatic or consular mission of a country, established in Australia with the Commonwealth's consent`, `displaying a sign, flag or insignia, or causing or permitting it`, FALSE, TRUE, TRUE, FALSE, TRUE, FALSE, NOTHING))
-- 7: DOM sign at other premises: caught, injunction, warrant (s 4(2A), 5(1))
#ASSERT `my conduct is caught` (`Missions case` OF `a designated overseas mission of a foreign territory`, `displaying a sign, flag or insignia, or causing or permitting it`, FALSE, TRUE, FALSE, FALSE, TRUE, FALSE, NOTHING)
#ASSERT `an injunction may be granted` (`Missions case` OF `a designated overseas mission of a foreign territory`, `displaying a sign, flag or insignia, or causing or permitting it`, FALSE, TRUE, FALSE, FALSE, TRUE, FALSE, NOTHING)
#ASSERT `a removal warrant may issue` (`Missions case` OF `a designated overseas mission of a foreign territory`, `displaying a sign, flag or insignia, or causing or permitting it`, FALSE, TRUE, FALSE, FALSE, TRUE, FALSE, NOTHING)
-- 8: DOM premises: not caught (s 4(2A)(c))
#ASSERT NOT (`my conduct is caught` (`Missions case` OF `a designated overseas mission of a foreign territory`, `displaying a sign, flag or insignia, or causing or permitting it`, TRUE, TRUE, FALSE, FALSE, TRUE, FALSE, NOTHING))
-- 9: acting for a consented mission: not caught (s 4(2A)(e))
#ASSERT NOT (`my conduct is caught` (`Missions case` OF `a designated overseas mission of a foreign territory`, `displaying a sign, flag or insignia, or causing or permitting it`, FALSE, TRUE, FALSE, TRUE, TRUE, FALSE, NOTHING))
-- 10: DOM representation: caught, no warrant (s 4(2B))
#ASSERT `my conduct is caught` (`Missions case` OF `a designated overseas mission of a foreign territory`, `making or publishing a representation, or causing or permitting it`, FALSE, TRUE, FALSE, FALSE, TRUE, FALSE, NOTHING)
#ASSERT `an injunction may be granted` (`Missions case` OF `a designated overseas mission of a foreign territory`, `making or publishing a representation, or causing or permitting it`, FALSE, TRUE, FALSE, FALSE, TRUE, FALSE, NOTHING)
#ASSERT NOT (`a removal warrant may issue` (`Missions case` OF `a designated overseas mission of a foreign territory`, `making or publishing a representation, or causing or permitting it`, FALSE, TRUE, FALSE, FALSE, TRUE, FALSE, NOTHING))
-- 11: DOM representation by consented-mission member: not caught (s 4(2B)(c))
#ASSERT NOT (`my conduct is caught` (`Missions case` OF `a designated overseas mission of a foreign territory`, `making or publishing a representation, or causing or permitting it`, FALSE, TRUE, FALSE, TRUE, TRUE, FALSE, NOTHING))
-- 12: no mission: not caught, no injunction (s 4(1))
#ASSERT NOT (`my conduct is caught` (`Missions case` OF `no such mission`, `displaying a sign, flag or insignia, or causing or permitting it`, FALSE, TRUE, FALSE, FALSE, TRUE, FALSE, NOTHING))
#ASSERT NOT (`an injunction may be granted` (`Missions case` OF `no such mission`, `displaying a sign, flag or insignia, or causing or permitting it`, FALSE, TRUE, FALSE, FALSE, TRUE, FALSE, NOTHING))
-- 13: likely only: injunction (s 4(6)(a))
#ASSERT `an injunction may be granted` (`Missions case` OF `a diplomatic or consular mission of a country, established in Australia with the Commonwealth's consent`, `displaying a sign, flag or insignia, or causing or permitting it`, FALSE, TRUE, FALSE, FALSE, FALSE, TRUE, NOTHING)
-- 15: likely only: no warrant (s 5(1) needs a finding)
#ASSERT NOT (`a removal warrant may issue` (`Missions case` OF `a diplomatic or consular mission of a country, established in Australia with the Commonwealth's consent`, `displaying a sign, flag or insignia, or causing or permitting it`, FALSE, TRUE, FALSE, FALSE, FALSE, TRUE, NOTHING))
-- 14: neither engaged nor likely: no injunction (s 4(5)(a), 4(6)(a))
#ASSERT NOT (`an injunction may be granted` (`Missions case` OF `a diplomatic or consular mission of a country, established in Australia with the Commonwealth's consent`, `displaying a sign, flag or insignia, or causing or permitting it`, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, NOTHING))
-- 16: issued 15 Jan 2026: in force at latest until 15 Jul 2026 (s 5(5))
#ASSERT `the last day of a removal warrant` (`Missions case` OF `a diplomatic or consular mission of a country, established in Australia with the Commonwealth's consent`, `displaying a sign, flag or insignia, or causing or permitting it`, FALSE, TRUE, FALSE, FALSE, TRUE, FALSE, (JUST (Date 15 1 2026))) EQUALS JUST (Date 15 7 2026)
-- 17: issued 31 Aug 2025: 28 Feb 2026
#ASSERT `the last day of a removal warrant` (`Missions case` OF `a diplomatic or consular mission of a country, established in Australia with the Commonwealth's consent`, `displaying a sign, flag or insignia, or causing or permitting it`, FALSE, TRUE, FALSE, FALSE, TRUE, FALSE, (JUST (Date 31 8 2025))) EQUALS JUST (Date 28 2 2026)
-- 18: issued 31 Aug 2023: 29 Feb 2024
#ASSERT `the last day of a removal warrant` (`Missions case` OF `a diplomatic or consular mission of a country, established in Australia with the Commonwealth's consent`, `displaying a sign, flag or insignia, or causing or permitting it`, FALSE, TRUE, FALSE, FALSE, TRUE, FALSE, (JUST (Date 31 8 2023))) EQUALS JUST (Date 29 2 2024)
-- 19: no warrant: NOTHING
#ASSERT `the last day of a removal warrant` (`Missions case` OF `a diplomatic or consular mission of a country, established in Australia with the Commonwealth's consent`, `displaying a sign, flag or insignia, or causing or permitting it`, FALSE, TRUE, FALSE, FALSE, TRUE, FALSE, NOTHING) EQUALS NOTHING
