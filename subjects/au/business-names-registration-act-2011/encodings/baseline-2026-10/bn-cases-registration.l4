§ `s 18 -- must I register the name`

#ASSERT `Must I register the business name` `Jarrah trading as Jarrah Legal, unregistered (d043)` EQUALS `yes: I must register it, or I commit the s 18(1) offence`
#ASSERT `Must I register the business name` `Jarrah trading as Jarrah Legal, registered (d043)` EQUALS `no: the name is registered to me`
#ASSERT `Must I register the business name` `Jarrah trading under its full company name (d043)` EQUALS `no: it is my own name`
#ASSERT `Must I register the business name` `Jarrah setting up under Jarrah Legal before its first client (d043)` EQUALS `yes: I must register it, or I commit the s 18(1) offence`
#ASSERT `Must I register the business name` `a sole trader under her own name` EQUALS `no: it is my own name`
#ASSERT `Must I register the business name` `two partners under both their names` EQUALS `no: it is my own name`
#ASSERT `Must I register the business name` `a family trust under the trustee's name` EQUALS `yes: I must register it, or I commit the s 18(1) offence`
#ASSERT `Must I register the business name` `an employee using a nickname at work` EQUALS `no: what I do is not a business under s 4`
#ASSERT `Must I register the business name` `a buyer trading in the 3 months after notifying the seller's consent` EQUALS `not yet: I may trade under it for 3 months after notifying ASIC of the holder's consent`

#ASSERT `Do I commit the unregistered business name offence` `Jarrah trading as Jarrah Legal, unregistered (d043)`
#ASSERT NOT `Do I commit the unregistered business name offence` `Jarrah trading under its full company name (d043)`

§ `penalties`

#ASSERT `Most penalty units for the offence` `trading under an unregistered business name (s 18)` FALSE EQUALS 30
#ASSERT `Most penalty units for the offence` `trading under an unregistered business name (s 18)` TRUE EQUALS 150

#ASSERT `Most dollars for the offence` `trading under an unregistered business name (s 18)` FALSE 330 EQUALS 9900

§ `s 19 -- documents`

#ASSERT `What must my business document show` `an invoice or other statement of account` TRUE FALSE EQUALS `the business name and my ABN`
#ASSERT `What must my business document show` `another business document, such as a letter or an advertisement` TRUE FALSE EQUALS `the business name`

§ `s 25 -- availability`

#ASSERT `Is the business name available to me` `Jarrah Legal, clear (d043)` EQUALS `available`
#ASSERT `Is the business name available to me` `a name already registered to a rival` EQUALS `not available: it is identical or nearly identical to a name already taken`
#ASSERT `Is the business name available to me` `a rival's name, with its consent and cancellation` EQUALS `available: the holder has consented and asked to cancel its registration`
#ASSERT `Is the business name available to me` `an offensive name` EQUALS `not available: it is undesirable`
#ASSERT `Is the business name available to me` `a name using a restricted word` EQUALS `not available: it includes a restricted word`

§ `s 32 -- disqualification`

#ASSERT NOT `Does this record disqualify me` `Daniel, no convictions (d043)`
#ASSERT `Does this record disqualify me` `a fraud conviction 2 years ago`
#ASSERT NOT `Does this record disqualify me` `a fraud conviction 6 years after release`
#ASSERT `Does this record disqualify me` `a foreign assault conviction punishable by 24 months`

§ `s 24 -- must ASIC register the name`

#ASSERT `What happens to my application for the name` TRUE TRUE `Jarrah Legal, clear (d043)` FALSE EQUALS `ASIC must register the name to me`
#ASSERT `What happens to my application for the name` FALSE TRUE `Jarrah Legal, clear (d043)` FALSE EQUALS `ASIC need not register it yet: I have no ABN (I may apply while my ABN application is pending)`
#ASSERT `What happens to my application for the name` TRUE TRUE `a name already registered to a rival` FALSE EQUALS `ASIC need not register it: the name is not available to me`

§ `ss 30, 34 -- unpaid fee and silence`

#ASSERT `Is my application refused for the unpaid fee` FALSE 10
#ASSERT NOT `Is my application refused for the unpaid fee` FALSE 9

#ASSERT `May I treat my business name application as refused` FALSE 29 0
#ASSERT NOT `May I treat my business name application as refused` FALSE 35 10

§ `s 33 -- registration period`

#ASSERT `May ASIC give me an alternative registration period` TRUE FALSE TRUE

#ASSERT `Longest alternative registration period in months` `3 years` EQUALS 42

§ `ss 49, 55 -- renewal and expiry`

#ASSERT NOT `May I renew now` 3 FALSE
#ASSERT `May I renew now` -1 FALSE

#ASSERT `Can ASIC cancel my expired name yet` 3 TRUE 42 FALSE
#ASSERT NOT `Can ASIC cancel my expired name yet` 4 FALSE 0 FALSE

