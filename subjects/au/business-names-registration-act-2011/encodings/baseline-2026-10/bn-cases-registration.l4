    `a law names me by it` IS FALSE
    `I am a notified successor for the name` IS FALSE
    `a prescribed exception applies` IS FALSE
    `I notified ASIC of the holder's consent within the last 3 months` IS FALSE
    `my registration was cancelled and its review period is running` IS FALSE

