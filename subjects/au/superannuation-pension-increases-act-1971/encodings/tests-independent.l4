IMPORT prelude
IMPORT `spi71-rules`

-- Independent tests: expected values from independent-expectations.md,
-- written from the source text before reading the rules module.

GIVEN adj IS A NUMBER
      act IS A NUMBER
      sc IS A `Scaling case`
      pay IS A NUMBER
      had IS A NUMBER
      un IS A NUMBER
      ear IS A NUMBER
      sp IS A `Spouse case`
      ex IS A BOOLEAN
GIVETH A NUMBER
inc adj act sc pay had un ear sp ex MEANS
    `my 1971 pension increase for` (`SPI 1971 case` OF adj, act, sc, pay, had, un, ear, sp, ex)

-- 1-4: s 4
#ASSERT inc 10 8 `no scaling` 0 0 0 0 `not a widow or widower` FALSE EQUALS 130
#ASSERT inc 8 8 `no scaling` 0 0 0 0 `not a widow or widower` FALSE EQUALS 0
#ASSERT inc 7 8 `no scaling` 0 0 0 0 `not a widow or widower` FALSE EQUALS 0
#ASSERT inc 9 8 `no scaling` 0 0 0 0 `not a widow or widower` FALSE EQUALS 65
-- 5: s 5
#ASSERT inc 10 8 `a case under section 5` 600 800 0 0 `not a widow or widower` FALSE EQUALS 97.5
-- 7-8: s 6
#ASSERT inc 10 8 `a deferred pension` 455 0 10 0 `not a widow or widower` FALSE EQUALS 65
#ASSERT inc 10 8 `a deferred pension` 455 0 5 0 `not a widow or widower` FALSE EQUALS 130
-- 9-10: s 7
#ASSERT inc 10 8 `no scaling` 0 0 0 50 `not a widow or widower` FALSE EQUALS 80
#ASSERT inc 10 8 `no scaling` 0 0 0 200 `not a widow or widower` FALSE EQUALS 0
-- 11: s 5 then s 7
#ASSERT inc 10 8 `a case under section 5` 600 800 0 50 `not a widow or widower` FALSE EQUALS 47.5
-- 12-14: s 8
#ASSERT inc 10 8 `no scaling` 0 0 0 0 `any other widow or widower` FALSE EQUALS 81.25
#ASSERT inc 10 8 `no scaling` 0 0 0 0 `a widow whose husband elected that section 26 should not apply` FALSE EQUALS 65
-- 15: s 9
#ASSERT inc 10 8 `no scaling` 0 0 0 0 `not a widow or widower` TRUE EQUALS 0
#ASSERT inc 10 8 `no scaling` 0 0 0 0 `any other widow or widower` TRUE EQUALS 0
-- 20: widow, spouse's increase after s 7
#ASSERT inc 10 8 `no scaling` 0 0 0 50 `any other widow or widower` FALSE EQUALS 50
