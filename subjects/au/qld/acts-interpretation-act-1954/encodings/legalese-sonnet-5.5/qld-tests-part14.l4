IMPORT prelude
IMPORT daydate
IMPORT `qld-part14-transitional`

-- Tests for Part 14 (qld-part14-transitional.l4).
-- Each expected value was worked out by hand from the text, as cited.
-- The commencement days used below are made up for the tests; the text does not state them.

§ `Tests of Part 14`

#ASSERT `s 53 applies in relation to the Bill (s 53(1))` TRUE EQUALS JUST TRUE
#ASSERT `s 53 applies in relation to the Bill (s 53(1))` FALSE EQUALS NOTHING
-- SAYS For a Bill introduced before the commencement of s 53, the speech in s 14B(3)(f) is taken to be the speech made in moving that the Bill be read a second time (s 53(2)).
#ASSERT `the speech that a reference in s 14B(3), definition extrinsic material, paragraph (f) is taken to be a reference to (s 53(2))` TRUE EQUALS JUST `the speech made by the member in moving a motion that the Bill be read a second time`
#ASSERT `the speech that a reference in s 14B(3), definition extrinsic material, paragraph (f) is taken to be a reference to (s 53(2))` FALSE EQUALS NOTHING
#ASSERT `commencement in div 2 means the commencement of s 54 (s 54, definition commencement)` TRUE EQUALS JUST TRUE
#ASSERT `commencement in div 2 means the commencement of s 54 (s 54, definition commencement)` FALSE EQUALS JUST FALSE
#ASSERT `the legislation is subordinate legislation in div 2 (s 54, definition subordinate legislation)` TRUE EQUALS JUST FALSE
#ASSERT `the legislation is subordinate legislation in div 2 (s 54, definition subordinate legislation)` FALSE EQUALS NOTHING
-- s 55, commencement on 1 January 2014: from that day a reference to s 36 includes schedule 1; a reference to s 48A is a reference to s 49; a reference to s 49 is a reference to s 48A.
#ASSERT `what the reference is taken to be (s 55)` `section 36` TRUE TRUE (Date 1 1 2014) (Date 1 1 2014) EQUALS JUST `a reference to section 36 including a reference to schedule 1`
#ASSERT `what the reference is taken to be (s 55)` `section 48A` TRUE TRUE (Date 1 1 2014) (Date 1 1 2014) EQUALS JUST `a reference to section 49`
#ASSERT `what the reference is taken to be (s 55)` `section 49` TRUE TRUE (Date 5 6 2020) (Date 1 1 2014) EQUALS JUST `a reference to section 48A`
#ASSERT `what the reference is taken to be (s 55)` `another section` TRUE TRUE (Date 1 1 2014) (Date 1 1 2014) EQUALS NOTHING
-- before the commencement, the context does not permit, or the reference was not made before the commencement in an instrument: s 55 does not answer
#ASSERT `what the reference is taken to be (s 55)` `section 49` TRUE TRUE (Date 31 12 2013) (Date 1 1 2014) EQUALS NOTHING
#ASSERT `what the reference is taken to be (s 55)` `section 49` TRUE FALSE (Date 5 6 2020) (Date 1 1 2014) EQUALS NOTHING
#ASSERT `what the reference is taken to be (s 55)` `section 49` FALSE TRUE (Date 5 6 2020) (Date 1 1 2014) EQUALS NOTHING
#ASSERT `what a reference to gazetted is taken to be a reference to (s 56)` TRUE EQUALS `notified or published in the gazette`
#ASSERT `what a reference to gazetted is taken to be a reference to (s 56)` FALSE EQUALS `notified under the Statutory Instruments Act 1992, section 47`
#ASSERT `what a reference to notified in the gazette is taken to be a reference to (s 57)` TRUE EQUALS `notified in the gazette under the Statutory Instruments Act 1992, section 47 as in force before the commencement`
#ASSERT `what a reference to notified in the gazette is taken to be a reference to (s 57)` FALSE EQUALS `notified under the Statutory Instruments Act 1992, section 47`
#ASSERT `s 58 applies (s 58(1))` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 58 applies (s 58(1))` TRUE FALSE EQUALS NOTHING
#ASSERT `s 58 applies (s 58(1))` FALSE TRUE EQUALS NOTHING
-- (2): on or after the day of commencement (here 1 July 2018).
#ASSERT `the entity may notify the approval or availability of the form under amended section 48 (s 58(2))` TRUE (Date 1 7 2018) (Date 1 7 2018) EQUALS JUST TRUE
#ASSERT `the entity may notify the approval or availability of the form under amended section 48 (s 58(2))` TRUE (Date 30 6 2018) (Date 1 7 2018) EQUALS NOTHING
#ASSERT `the entity may notify the approval or availability of the form under amended section 48 (s 58(2))` FALSE (Date 1 7 2018) (Date 1 7 2018) EQUALS NOTHING
#ASSERT `the section is amended section 48 (s 58(3), definition amended section 48)` TRUE EQUALS JUST TRUE
#ASSERT `the section is amended section 48 (s 58(3), definition amended section 48)` FALSE EQUALS JUST FALSE
#ASSERT `the law is the authorising law (s 58(3), definition authorising law)` TRUE EQUALS JUST TRUE
#ASSERT `the new version is a form in s 58 (s 58(3), definition form)` TRUE EQUALS JUST TRUE
#ASSERT `the new version is a form in s 58 (s 58(3), definition form)` FALSE EQUALS NOTHING
#ASSERT `the subsection is previous section 48(5) (s 58(3), definition previous section 48(5))` TRUE EQUALS JUST TRUE
#ASSERT `the subsection is previous section 48(5) (s 58(3), definition previous section 48(5))` FALSE EQUALS JUST FALSE
