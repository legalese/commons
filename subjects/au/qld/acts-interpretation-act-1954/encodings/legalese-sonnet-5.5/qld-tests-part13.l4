IMPORT prelude
IMPORT `qld-part13-miscellaneous`

-- Tests for Part 13 (qld-part13-miscellaneous.l4).
-- Each expected value was worked out by hand from the text, as cited.

§ `Tests of Part 13`

-- s 49 and its example: a document accompanying an application form must be verified by statutory declaration; lodged unverified, it has not been properly lodged.
-- src:999 | Example—
-- src:1000 | If an Act requires a document accompanying an application form to be verified by statutory declaration and the document is lodged without being verified in this way, the document has not been properly lodged for the purposes of the Act.
@ref s 49, example (src:999-1000)
#ASSERT `the purpose is fulfilled (s 49)` TRUE FALSE EQUALS JUST FALSE
-- SAYS Where an Act requires verification in a specified way, the purpose is not fulfilled unless the requirement is satisfied; that it is satisfied does not by itself say the purpose is fulfilled (s 49).
#ASSERT `the purpose is fulfilled (s 49)` TRUE TRUE EQUALS NOTHING
#ASSERT `the purpose is fulfilled (s 49)` FALSE FALSE EQUALS NOTHING
#ASSERT `the provision is taken to confer jurisdiction in the matter on the court or tribunal (s 49A)` TRUE EQUALS JUST TRUE
#ASSERT `the provision is taken to confer jurisdiction in the matter on the court or tribunal (s 49A)` FALSE EQUALS NOTHING
#ASSERT `the making or amendment affects the power of the empowered entity to amend or further amend the subordinate legislation or to repeal it (s 50(1)(a))` TRUE EQUALS JUST FALSE
#ASSERT `the making or amendment affects the power of the empowered entity to amend or further amend the subordinate legislation or to repeal it (s 50(1)(a))` FALSE EQUALS NOTHING
#ASSERT `the making or amendment affects the power of the other entity to approve, or to disapprove, an amendment, a further amendment or the repeal (s 50(1)(b))` TRUE TRUE EQUALS JUST FALSE
#ASSERT `the making or amendment affects the power of the other entity to approve, or to disapprove, an amendment, a further amendment or the repeal (s 50(1)(b))` TRUE FALSE EQUALS NOTHING
#ASSERT `the act is an approval (s 50(2), definition approve)` approve EQUALS JUST TRUE
#ASSERT `the act is an approval (s 50(2), definition approve)` confirm EQUALS JUST TRUE
#ASSERT `the act is an approval (s 50(2), definition approve)` `otherwise consent to` EQUALS JUST TRUE
#ASSERT `the act is an approval (s 50(2), definition approve)` disapprove EQUALS JUST FALSE
#ASSERT `the act is an approval (s 50(2), definition approve)` `anything else` EQUALS JUST FALSE
#ASSERT `the act is a disapproval (s 50(2), definition disapprove)` disapprove EQUALS JUST TRUE
#ASSERT `the act is a disapproval (s 50(2), definition disapprove)` `otherwise disallow` EQUALS JUST TRUE
#ASSERT `the act is a disapproval (s 50(2), definition disapprove)` approve EQUALS JUST FALSE
#ASSERT `the entity is the empowered entity for the subordinate legislation (s 50(2), definition empowered entity)` TRUE EQUALS JUST TRUE
#ASSERT `the entity is the empowered entity for the subordinate legislation (s 50(2), definition empowered entity)` FALSE EQUALS JUST FALSE
#ASSERT `the reference may be taken to be a reference to this Act (s 51A)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `the reference may be taken to be a reference to this Act (s 51A)` TRUE FALSE EQUALS NOTHING
#ASSERT `the reference is construed as a reference to the Sovereign for the time being (s 52(a))` `the Sovereign reigning at the time of the passing of the Act` EQUALS JUST TRUE
#ASSERT `the reference is construed as a reference to the Sovereign for the time being (s 52(a))` `Her Majesty` EQUALS JUST TRUE
#ASSERT `the reference is construed as a reference to the Sovereign for the time being (s 52(a))` `His Majesty` EQUALS JUST TRUE
#ASSERT `the reference is construed as a reference to the Sovereign for the time being (s 52(a))` `the Queen` EQUALS JUST TRUE
#ASSERT `the reference is construed as a reference to the Sovereign for the time being (s 52(a))` `the King` EQUALS JUST TRUE
#ASSERT `the reference is construed as a reference to the Sovereign for the time being (s 52(a))` `the Crown` EQUALS JUST TRUE
#ASSERT `the reference is construed as a reference to the Sovereign for the time being (s 52(a))` `anything else` EQUALS NOTHING
#ASSERT `the reference includes the heirs and successors of the Queen or King (s 52(a))` TRUE EQUALS JUST TRUE
#ASSERT `the reference includes the heirs and successors of the Queen or King (s 52(a))` FALSE EQUALS NOTHING
#ASSERT `the reference is construed as a reference to the style and titles for the time being adopted, with the assent of the Parliament of the Commonwealth of Australia, by the Sovereign for the time being (s 52(b))` TRUE EQUALS JUST TRUE
#ASSERT `the reference is construed as a reference to the style and titles for the time being adopted, with the assent of the Parliament of the Commonwealth of Australia, by the Sovereign for the time being (s 52(b))` FALSE EQUALS NOTHING
#ASSERT `the certificate is evidence of the matter (s 52A(1))` TRUE TRUE EQUALS JUST TRUE
#ASSERT `the certificate is evidence of the matter (s 52A(1))` TRUE FALSE EQUALS NOTHING
#ASSERT `the certificate is evidence of the matter (s 52A(1))` FALSE TRUE EQUALS NOTHING
#ASSERT `an approving entity may authorise a person to issue certificates under subsection (1) for the entity (s 52A(2))` TRUE EQUALS JUST TRUE
#ASSERT `an approving entity may authorise a person to issue certificates under subsection (1) for the entity (s 52A(2))` FALSE EQUALS NOTHING
#ASSERT `the entity is an approving entity (s 52A(3), definition approving entity)` TRUE EQUALS JUST TRUE
#ASSERT `the entity is an approving entity (s 52A(3), definition approving entity)` FALSE EQUALS JUST FALSE
#ASSERT `the law is the authorising law (s 52A(3), definition authorising law)` TRUE EQUALS JUST TRUE
#ASSERT `the new version is a form in s 52A (s 52A(3), definition form)` TRUE EQUALS JUST TRUE
#ASSERT `the new version is a form in s 52A (s 52A(3), definition form)` FALSE EQUALS NOTHING
