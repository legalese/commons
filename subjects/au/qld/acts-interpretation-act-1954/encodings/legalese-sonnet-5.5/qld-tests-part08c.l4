IMPORT prelude
IMPORT daydate
IMPORT `qld-part08c-provision-references`

-- Tests for Part 8, third group (qld-part08c-provision-references.l4).
-- Each expected value was worked out by hand from the text, as cited.

§ `Tests of Part 8, ss 35B to 36`

§§ `s 35B`

#ASSERT `the part is in the body of the Act (s 35B(1), definition body of the Act)` `the preamble` EQUALS JUST FALSE
#ASSERT `the part is in the body of the Act (s 35B(1), definition body of the Act)` `a schedule` EQUALS JUST FALSE
#ASSERT `the part is in the body of the Act (s 35B(1), definition body of the Act)` `an appendix` EQUALS JUST FALSE
#ASSERT `the part is in the body of the Act (s 35B(1), definition body of the Act)` `any other part of the Act` EQUALS JUST TRUE
#ASSERT `the unit is a provision unit (s 35B(1), definition provision unit)` `the body of the Act` EQUALS JUST TRUE
#ASSERT `the unit is a provision unit (s 35B(1), definition provision unit)` `the preamble` EQUALS JUST TRUE
#ASSERT `the unit is a provision unit (s 35B(1), definition provision unit)` `a schedule` EQUALS JUST TRUE
#ASSERT `the unit is a provision unit (s 35B(1), definition provision unit)` `an appendix` EQUALS JUST TRUE
#ASSERT `the unit is a provision unit (s 35B(1), definition provision unit)` `a chapter` EQUALS JUST TRUE
#ASSERT `the unit is a provision unit (s 35B(1), definition provision unit)` `a part` EQUALS JUST TRUE
#ASSERT `the unit is a provision unit (s 35B(1), definition provision unit)` `a division` EQUALS JUST TRUE
#ASSERT `the unit is a provision unit (s 35B(1), definition provision unit)` `a subdivision` EQUALS JUST TRUE
#ASSERT `the unit is a provision unit (s 35B(1), definition provision unit)` `a section` EQUALS JUST TRUE
#ASSERT `the unit is a provision unit (s 35B(1), definition provision unit)` `a subsection` EQUALS JUST TRUE
#ASSERT `the unit is a provision unit (s 35B(1), definition provision unit)` `a paragraph` EQUALS JUST TRUE
#ASSERT `the unit is a provision unit (s 35B(1), definition provision unit)` `a subparagraph` EQUALS JUST TRUE
#ASSERT `the unit is a provision unit (s 35B(1), definition provision unit)` `a sub-subparagraph` EQUALS JUST TRUE
#ASSERT `the unit is a provision unit (s 35B(1), definition provision unit)` `another provision of the body of the Act or a schedule or appendix of the Act` EQUALS JUST TRUE
#ASSERT `the unit is a provision unit (s 35B(1), definition provision unit)` `a provision of a preamble of the Act` EQUALS JUST TRUE
#ASSERT `the unit is a provision unit (s 35B(1), definition provision unit)` `something that is none of these` EQUALS JUST FALSE
-- (2), examples 1 to 4: 'chapter 10'; 'part 5, division 4'; 'section 10 of this Act'; 'paragraph (a) of this subsection' -- each designated by a number, none mentioning another Act.
-- src:728 | Examples of references to which section applies—
-- src:729 | 1 ‘chapter 10’
-- src:730 | 2 ‘part 5, division 4’
-- src:731 | 3 ‘section 10 of this Act’
-- src:732 | 4 ‘paragraph (a) of this subsection’
@ref s 35B(2), examples (src:728-732)
#ASSERT `s 35B explains the meaning of the reference (s 35B(2))` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 35B explains the meaning of the reference (s 35B(2))` TRUE FALSE EQUALS NOTHING
#ASSERT `s 35B explains the meaning of the reference (s 35B(2))` FALSE TRUE EQUALS NOTHING

-- (3), example 1: in the body, 'section 10 of this Act' is section 10 of the body of the Act: the reference itself indicates it.
-- src:735 | Examples—
-- src:736 | 1 A reference in the body of the Act to ‘section 10 of this Act’ is a reference to section 10 of the body of the Act concerned.
-- src:737 | 2 A reference in a schedule of an Act to ‘section 10 of this schedule’ is a reference to section 10 of the schedule where the reference occurs.
-- src:738 | 3 A reference to ‘paragraph (a) of this subsection’ is a reference to paragraph (a) of the subsection where the reference occurs.
@ref s 35B(3), examples (src:735-738)
#ASSERT `what a reference to a provision designated by a number refers to (s 35B(3) to (7))` `in the body of the Act` TRUE FALSE TRUE FALSE EQUALS `the provision the reference itself indicates`
-- (3), example 2: in a schedule, 'section 10 of this schedule' is section 10 of the schedule where the reference occurs.
#ASSERT `what a reference to a provision designated by a number refers to (s 35B(3) to (7))` `in a schedule` TRUE FALSE TRUE FALSE EQUALS `the provision the reference itself indicates`
-- (3), example 3: 'paragraph (a) of this subsection'.
#ASSERT `what a reference to a provision designated by a number refers to (s 35B(3) to (7))` `in the body of the Act` TRUE FALSE FALSE TRUE EQUALS `the provision the reference itself indicates`
-- (4), example: in a schedule, 'section 10 of the Act' is section 10 of the body of the Act.
-- src:740 | Example—
-- src:741 | A reference in a schedule of an Act to ‘section 10 of the Act’ is a reference to section 10 of the body of the Act.
@ref s 35B(4), example (src:740-741)
#ASSERT `what a reference to a provision designated by a number refers to (s 35B(3) to (7))` `in a schedule` TRUE TRUE TRUE FALSE EQUALS `the provision, designated by the number, of the body of the Act concerned`
#ASSERT `what a reference to a provision designated by a number refers to (s 35B(3) to (7))` `in an appendix` TRUE TRUE TRUE FALSE EQUALS `the provision, designated by the number, of the body of the Act concerned`
-- the words "of the Act" in the body: (4) is about schedules and appendices only
#ASSERT `what a reference to a provision designated by a number refers to (s 35B(3) to (7))` `in the body of the Act` TRUE TRUE TRUE FALSE EQUALS `the provision the reference itself indicates`

-- (5), examples 1 to 8: references in the body of an Act that do not mention the Act.
-- src:747 | Examples in the body of an Act—
-- src:748 | 1 A reference in the body of an Act to ‘chapter 10’ is a reference to chapter 10 of the body of the Act.
-- src:749 | 2 A reference to ‘part 1’ is a reference to—
-- src:750 | (a) if the body of the Act is divided into chapters (that is, at least 2 of the chapters are further divided into parts)—part 1 of the chapter where the reference occurs; or
-- src:751 | (b) if the body of the Act is not divided into chapters (that is, there is only 1 part 1)—part 1 of the body of the Act.
-- src:752 | 3 A reference in the body of an Act to ‘division 2’ is a reference to division 2 of the part of the Act where the reference occurs.
-- src:753 | 4 A reference in the body of an Act to ‘subdivision 3’ is a reference to subdivision 3 of the division of the Act where the reference occurs.
-- src:754 | 5 A reference in the body of an Act to ‘section 10’ is a reference to section 10 of the body of the Act.
-- src:755 | 6 A reference in the body of an Act to ‘subsection (1)’ is a reference to subsection (1) of the section of the Act where the reference occurs.
-- src:756 | 7 A reference in the body of an Act to ‘paragraph (a)’ is a reference to—
-- src:757 | (a) if the section where the reference occurs is divided into subsections—paragraph (a) of the subsection where the reference occurs; or
-- src:758 | (b) if the section where the reference occurs is not divided into subsections—paragraph (a) of the section of the Act where the reference occurs.
-- src:759 | 8 A reference to ‘subparagraph (i)’ is a reference to subparagraph (i) of the paragraph where the reference occurs.
@ref s 35B(5), examples (src:747-759)
-- example 1: 'chapter 10' -- chapter 10 of the body of the Act (only one chapter 10)
#ASSERT `what a reference to a provision designated by a number refers to (s 35B(3) to (7))` `in the body of the Act` FALSE FALSE FALSE FALSE EQUALS `the provision, designated by the number, of the body of the Act concerned`
-- example 2(a): 'part 1' in a body divided into chapters -- part 1 of the chapter where the reference occurs (2 such provisions)
#ASSERT `what a reference to a provision designated by a number refers to (s 35B(3) to (7))` `in the body of the Act` FALSE FALSE FALSE TRUE EQUALS `the provision, designated by the number, of the next larger, appropriate provision unit where the reference occurs`
-- example 2(b): 'part 1' in a body not divided into chapters -- part 1 of the body of the Act (only 1 part 1)
#ASSERT `what a reference to a provision designated by a number refers to (s 35B(3) to (7))` `in the body of the Act` FALSE FALSE FALSE FALSE EQUALS `the provision, designated by the number, of the body of the Act concerned`
-- examples 3, 4: 'division 2' -- division 2 of the part where it occurs; 'subdivision 3' -- subdivision 3 of the division where it occurs
#ASSERT `what a reference to a provision designated by a number refers to (s 35B(3) to (7))` `in the body of the Act` FALSE FALSE FALSE TRUE EQUALS `the provision, designated by the number, of the next larger, appropriate provision unit where the reference occurs`
-- example 5: 'section 10' -- section 10 of the body of the Act
#ASSERT `what a reference to a provision designated by a number refers to (s 35B(3) to (7))` `in the body of the Act` FALSE FALSE FALSE FALSE EQUALS `the provision, designated by the number, of the body of the Act concerned`
-- examples 6, 7, 8: 'subsection (1)', 'paragraph (a)', 'subparagraph (i)' -- of the section, subsection or paragraph where the reference occurs
#ASSERT `what a reference to a provision designated by a number refers to (s 35B(3) to (7))` `in the body of the Act` FALSE FALSE FALSE TRUE EQUALS `the provision, designated by the number, of the next larger, appropriate provision unit where the reference occurs`

-- (6), examples 1 and 2: in a schedule, a reference to a provision that does not occur in the schedule ('chapter 10'; 'section 30' in a dictionary schedule) is to the body of the Act.
-- src:766 | Examples—
-- src:767 | 1 A reference in a schedule that is not divided into chapters to ‘chapter 10’ is a reference to chapter 10 in the body of the Act.
-- src:768 | 2 A reference in a dictionary schedule to ‘section 30’ is a reference to section 30 in the body of the Act.
@ref s 35B(6), examples (src:766-768)
#ASSERT `what a reference to a provision designated by a number refers to (s 35B(3) to (7))` `in a schedule` FALSE FALSE FALSE FALSE EQUALS `the provision, designated by the number, of the body of the Act concerned`
#ASSERT `what a reference to a provision designated by a number refers to (s 35B(3) to (7))` `in the preamble` FALSE FALSE FALSE FALSE EQUALS `the provision, designated by the number, of the body of the Act concerned`
#ASSERT `what a reference to a provision designated by a number refers to (s 35B(3) to (7))` `in an appendix` FALSE FALSE FALSE TRUE EQUALS `the provision, designated by the number, of the body of the Act concerned`

-- (7), examples 1 to 4: the provision does occur in the schedule.
-- src:774 | Examples—
-- src:775 | 1 A reference in a schedule divided into parts to ‘part 1’ is a reference to—
-- src:776 | (a) if the schedule is divided into chapters (that is, at least 2 of the chapters are further divided into parts)—part 1 of the chapter where the reference occurs; or
-- src:777 | (b) if the schedule is not divided into chapters (that is, there is only 1 part 1)—part 1 of the schedule.
-- src:778 | 2 A reference in a schedule divided into sections to ‘section 10’ is a reference to section 10 of the schedule.
-- src:779 | 3 A reference in a schedule divided into a single series of items to ‘item 5’ is a reference to item 5 of the schedule.
-- src:780 | 4 A reference in a schedule divided into 2 or more series of items to ‘item 5’ is a reference to item 5 of the series in which the reference occurs.
@ref s 35B(7), examples (src:774-780)
-- example 1(a): 'part 1' in a schedule divided into chapters -- part 1 of the chapter where the reference occurs (2 such)
#ASSERT `what a reference to a provision designated by a number refers to (s 35B(3) to (7))` `in a schedule` FALSE FALSE TRUE TRUE EQUALS `the provision, designated by the number, of the next larger, appropriate provision unit where the reference occurs`
-- example 1(b): 'part 1' in a schedule not divided into chapters -- part 1 of the schedule (only 1)
#ASSERT `what a reference to a provision designated by a number refers to (s 35B(3) to (7))` `in a schedule` FALSE FALSE TRUE FALSE EQUALS `the provision, designated by the number, of the schedule, appendix or preamble where the reference occurs`
-- examples 2 and 3: 'section 10' in a schedule divided into sections; 'item 5' in a single series -- of the schedule
#ASSERT `what a reference to a provision designated by a number refers to (s 35B(3) to (7))` `in a schedule` FALSE FALSE TRUE FALSE EQUALS `the provision, designated by the number, of the schedule, appendix or preamble where the reference occurs`
-- example 4: 'item 5' in a schedule with 2 or more series -- item 5 of the series in which the reference occurs (2 such)
#ASSERT `what a reference to a provision designated by a number refers to (s 35B(3) to (7))` `in a schedule` FALSE FALSE TRUE TRUE EQUALS `the provision, designated by the number, of the next larger, appropriate provision unit where the reference occurs`
#ASSERT `what a reference to a provision designated by a number refers to (s 35B(3) to (7))` `in the preamble` FALSE FALSE TRUE FALSE EQUALS `the provision, designated by the number, of the schedule, appendix or preamble where the reference occurs`

§§ `ss 35C to 36`

#ASSERT `the heading forms part of the provision to which it is a heading (s 35C(1))` TRUE EQUALS JUST TRUE
#ASSERT `the heading forms part of the provision to which it is a heading (s 35C(1))` FALSE EQUALS NOTHING
-- (2) and its example: "This example forms part of subsection (2) and an amendment omitting subsection (2) would omit this example."
-- src:786 | Example of subsection (2)—
-- src:787 | This example forms part of subsection (2) and an amendment omitting subsection (2) would omit this example.
@ref s 35C(2), example (src:786-787)
#ASSERT `the example is part of the provision (s 35C(2))` TRUE FALSE EQUALS JUST TRUE
#ASSERT `the example is part of the provision (s 35C(2))` TRUE TRUE EQUALS NOTHING
#ASSERT `the example is part of the provision (s 35C(2))` FALSE FALSE EQUALS NOTHING
#ASSERT `the note is part of the provision (s 35C(3))` TRUE FALSE EQUALS JUST TRUE
#ASSERT `the note is part of the provision (s 35C(3))` TRUE TRUE EQUALS NOTHING
#ASSERT `what a penalty at the end of a subsection is part of (s 35C(4))` TRUE FALSE EQUALS JUST `the subsection`
#ASSERT `what a penalty at the end of a subsection is part of (s 35C(4))` TRUE TRUE EQUALS JUST `the section`
#ASSERT `what a penalty at the end of a subsection is part of (s 35C(4))` FALSE FALSE EQUALS NOTHING
#ASSERT `the penalty is part of the section (s 35C(5))` TRUE EQUALS JUST TRUE
#ASSERT `the penalty is part of the section (s 35C(5))` FALSE EQUALS NOTHING
#ASSERT `what the connecting word forms part of (s 35C(6) and (7))` TRUE `at the end of a paragraph, subparagraph, sub-subparagraph or another provision` EQUALS JUST `the provision concerned`
#ASSERT `what the connecting word forms part of (s 35C(6) and (7))` TRUE `between paragraphs, subparagraphs, sub-subparagraphs or other provisions` EQUALS JUST `the first of the provisions`
#ASSERT `what the connecting word forms part of (s 35C(6) and (7))` TRUE `elsewhere` EQUALS NOTHING
#ASSERT `what the connecting word forms part of (s 35C(6) and (7))` FALSE `elsewhere` EQUALS NOTHING
#ASSERT `the provision reference is part of the heading (s 35C(8))` TRUE EQUALS JUST TRUE
#ASSERT `the provision reference is part of the heading (s 35C(8))` FALSE EQUALS NOTHING
#ASSERT `the provision referred to by the provision reference is the authorising provision or another provision relevant to the schedule (s 35C(8), note)` TRUE FALSE EQUALS JUST TRUE
#ASSERT `the provision referred to by the provision reference is the authorising provision or another provision relevant to the schedule (s 35C(8), note)` FALSE TRUE EQUALS JUST TRUE
#ASSERT `the provision referred to by the provision reference is the authorising provision or another provision relevant to the schedule (s 35C(8), note)` FALSE FALSE EQUALS JUST FALSE
#ASSERT `the end item is taken to be at the end of the provision (s 35CA)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `the end item is taken to be at the end of the provision (s 35CA)` TRUE FALSE EQUALS JUST TRUE
#ASSERT `the end item is taken to be at the end of the provision (s 35CA)` FALSE TRUE EQUALS NOTHING
-- s 35D, example 1: 'sections 5 to 9' includes both section 5 and section 9.
-- src:805 | Example 1—
-- src:806 | A reference to ‘sections 5 to 9’ includes both section 5 and section 9. It is not necessary to refer to ‘sections 5 to 9 (both inclusive)’ to ensure that the reference is given an inclusive interpretation.
@ref s 35D, example 1 (src:805-806)
#ASSERT `the provision is within a reference to a part of a law (s 35D)` 5 5 9 EQUALS JUST TRUE
#ASSERT `the provision is within a reference to a part of a law (s 35D)` 9 5 9 EQUALS JUST TRUE
#ASSERT `the provision is within a reference to a part of a law (s 35D)` 7 5 9 EQUALS JUST TRUE
#ASSERT `the provision is within a reference to a part of a law (s 35D)` 4 5 9 EQUALS JUST FALSE
#ASSERT `the provision is within a reference to a part of a law (s 35D)` 10 5 9 EQUALS JUST FALSE
-- example 2: 'sections 260 to 264' includes a provision such as a part heading between sections 260 and 261 (position 260.5).
-- src:807 | Example 2—
-- src:808 | A reference to ‘sections 260 to 264’ includes a provision such as a part heading between sections 260 and 261.
@ref s 35D, example 2 (src:807-808)
#ASSERT `the provision is within a reference to a part of a law (s 35D)` 260.5 260 264 EQUALS JUST TRUE
#ASSERT `the provision is within a reference to a part of a law (s 35D)` 264.5 260 264 EQUALS JUST FALSE
-- s 35E and its example: the word 'by-law' means a by-law made under the Act in which the word is used.
-- src:811 | Example—
-- src:812 | The word ‘by-law’ means a by-law made under the Act in which the word is used.
@ref s 35E, example (src:811-812)
#ASSERT `the instrument is the instrument a reference to a type of statutory instrument is a reference to (s 35E)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `the instrument is the instrument a reference to a type of statutory instrument is a reference to (s 35E)` TRUE FALSE EQUALS JUST FALSE
#ASSERT `the instrument is the instrument a reference to a type of statutory instrument is a reference to (s 35E)` FALSE TRUE EQUALS JUST FALSE
#ASSERT `the term has the meaning stated in schedule 1 in an Act (s 36(1))` TRUE EQUALS JUST TRUE
#ASSERT `the term has the meaning stated in schedule 1 in an Act (s 36(1))` FALSE EQUALS NOTHING
#ASSERT `a reference to schedule 1 of this Act includes a reference to s 36 (s 36(2))` TRUE EQUALS JUST TRUE
#ASSERT `a reference to schedule 1 of this Act includes a reference to s 36 (s 36(2))` FALSE EQUALS NOTHING
