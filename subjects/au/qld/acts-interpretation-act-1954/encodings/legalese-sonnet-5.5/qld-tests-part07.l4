IMPORT prelude
IMPORT daydate
IMPORT `qld-part07-functions-and-powers`

-- Tests for Part 7 (qld-part07-functions-and-powers.l4).
-- Each expected value was worked out by hand from the text, as cited.

§ `Tests of Part 7`

§§ `ss 23 and 23A`

#ASSERT `the function may be performed, or the power may be exercised, as occasion requires (s 23(1))` TRUE EQUALS JUST TRUE
#ASSERT `the function may be performed, or the power may be exercised, as occasion requires (s 23(1))` FALSE EQUALS NOTHING
#ASSERT `the person may perform the function or exercise the power (s 23(2))` TRUE TRUE EQUALS JUST TRUE
#ASSERT `the person may perform the function or exercise the power (s 23(2))` TRUE FALSE EQUALS NOTHING
#ASSERT `the person may perform the function or exercise the power (s 23(2))` FALSE TRUE EQUALS NOTHING
-- SAYS The performance of a function, or the exercise of a power, by a body is not affected merely because of vacancies in its membership (s 23(3)).
#ASSERT `the performance of the function or the exercise of the power is affected merely because of vacancies in the membership of the body (s 23(3))` TRUE TRUE EQUALS JUST FALSE
#ASSERT `the performance of the function or the exercise of the power is affected merely because of vacancies in the membership of the body (s 23(3))` TRUE FALSE EQUALS NOTHING
#ASSERT `the provision is taken to confer the second power on the other entity (s 23A(1))` TRUE TRUE EQUALS JUST TRUE
#ASSERT `the provision is taken to confer the second power on the other entity (s 23A(1))` TRUE FALSE EQUALS NOTHING
#ASSERT `the thing is a power in s 23A (s 23A(2), definition power)` TRUE EQUALS JUST TRUE
#ASSERT `the thing is a power in s 23A (s 23A(2), definition power)` FALSE EQUALS NOTHING

§§ `ss 24AA and 24A`

#ASSERT `the power includes power to amend or repeal the instrument or decision (s 24AA(a))` TRUE EQUALS JUST TRUE
#ASSERT `the power includes power to amend or repeal the instrument or decision (s 24AA(a))` FALSE EQUALS NOTHING
#ASSERT `the power to amend or repeal is exercisable in the same way, and subject to the same conditions, as the power to make (s 24AA(b))` TRUE EQUALS JUST TRUE
#ASSERT `the person or body may make the appointment in the way (s 24A(1))` TRUE `by appointing a person or body by name` EQUALS JUST TRUE
#ASSERT `the person or body may make the appointment in the way (s 24A(1))` TRUE `by appointing a specified officer, or the holder of a specified office, by reference to the title of the office concerned` EQUALS JUST TRUE
#ASSERT `the person or body may make the appointment in the way (s 24A(1))` TRUE `in another way` EQUALS NOTHING
#ASSERT `the person or body may make the appointment in the way (s 24A(1))` FALSE `by appointing a person or body by name` EQUALS NOTHING
#ASSERT `the appointment is taken to be the appointment of the person for the time being occupying or acting in the office concerned (s 24A(2))` TRUE EQUALS JUST TRUE
#ASSERT `the appointment is taken to be the appointment of the person for the time being occupying or acting in the office concerned (s 24A(2))` FALSE EQUALS NOTHING

§§ `s 24B`

#ASSERT `the person or body may, in accordance with the Act, appoint to act in the office in the way (s 24B(1))` TRUE `by appointing a person or body by name` EQUALS JUST TRUE
#ASSERT `the person or body may, in accordance with the Act, appoint to act in the office in the way (s 24B(1))` TRUE `in another way` EQUALS NOTHING
#ASSERT `the appointment may be expressed to have effect only in the circumstances specified in the instrument of appointment (s 24B(2))` TRUE EQUALS JUST TRUE
#ASSERT `the appointer may do the thing (s 24B(3))` `determine the terms and conditions of the appointment, including remuneration and allowances` EQUALS JUST TRUE
#ASSERT `the appointer may do the thing (s 24B(3))` `end the appointment at any time` EQUALS JUST TRUE
#ASSERT `the appointer may do the thing (s 24B(3))` `anything else` EQUALS NOTHING
#ASSERT `the appointment may be made or ended by a resolution of the body (s 24B(3A))` TRUE EQUALS JUST TRUE
#ASSERT `the appointment may be made or ended by a resolution of the body (s 24B(3A))` FALSE EQUALS NOTHING
-- (4): in writing, signed by the appointer or, for a body, by a person it has authorised.
#ASSERT `the requirement for writing and signature is met (s 24B(4))` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `the requirement for writing and signature is met (s 24B(4))` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `the requirement for writing and signature is met (s 24B(4))` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `the requirement for writing and signature is met (s 24B(4))` FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `the requirement for writing and signature is met (s 24B(4))` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- (6): acting otherwise than because of a vacancy, the office becomes vacant: continue until the first of (a), (b), (c).
#ASSERT `the appointee may continue to act (s 24B(6))` TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `the appointee may continue to act (s 24B(6))` TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `the appointee may continue to act (s 24B(6))` TRUE TRUE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `the appointee may continue to act (s 24B(6))` TRUE TRUE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `the appointee may continue to act (s 24B(6))` FALSE TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `the appointee may continue to act (s 24B(6))` TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 24B(6)(c) prevents a further appointment of the appointee to act for a period ending later than a year from the day of the vacancy (s 24B(6A))` EQUALS FALSE
#ASSERT `the appointment ends (s 24B(7))` TRUE TRUE EQUALS JUST TRUE
#ASSERT `the appointment ends (s 24B(7))` TRUE FALSE EQUALS NOTHING
#ASSERT `the person's appointment to act because of the vacancy ends (s 24B(7A))` TRUE TRUE EQUALS JUST TRUE
#ASSERT `the person's appointment to act because of the vacancy ends (s 24B(7A))` TRUE FALSE EQUALS NOTHING
#ASSERT `the person's appointment to act because of the absence of the holder ends (s 24B(7B))` TRUE TRUE EQUALS JUST TRUE
#ASSERT `the person's appointment to act because of the absence of the holder ends (s 24B(7B))` FALSE TRUE EQUALS NOTHING
#ASSERT `subsections (7A) and (7B) apply (s 24B(7C))` TRUE EQUALS JUST TRUE
#ASSERT `subsections (7A) and (7B) apply (s 24B(7C))` FALSE EQUALS JUST TRUE
#ASSERT `a person's substantive appointment to an office ends merely because the person acts in another office (s 24B(7D))` TRUE EQUALS JUST FALSE
#ASSERT `a person's substantive appointment to an office ends merely because the person acts in another office (s 24B(7D))` FALSE EQUALS NOTHING
#ASSERT `subsections (7A) to (7D) change the law of Queensland (s 24B(7E))` EQUALS FALSE
#ASSERT `the appointee has all the functions and powers of the holder of the office, and laws apply as if the appointee were the holder (s 24B(8))` TRUE EQUALS JUST TRUE
#ASSERT `the appointee has all the functions and powers of the holder of the office, and laws apply as if the appointee were the holder (s 24B(8))` FALSE EQUALS NOTHING
-- SAYS Anything done by or in relation to a person purporting to act in an office is not invalid merely because the occasion for the appointment had not arisen, the appointment had ended, or the occasion to act had not arisen or had ended (s 24B(9)).
#ASSERT `the thing done is invalid merely because of the reason (s 24B(9))` TRUE `the occasion for the appointment had not arisen` EQUALS JUST FALSE
#ASSERT `the thing done is invalid merely because of the reason (s 24B(9))` TRUE `the appointment had ended` EQUALS JUST FALSE
#ASSERT `the thing done is invalid merely because of the reason (s 24B(9))` TRUE `the occasion for the person to act had not arisen or had ended` EQUALS JUST FALSE
#ASSERT `the thing done is invalid merely because of the reason (s 24B(9))` TRUE `another reason` EQUALS NOTHING
#ASSERT `the thing done is invalid merely because of the reason (s 24B(9))` FALSE `the appointment had ended` EQUALS NOTHING
#ASSERT `an appointment to act in the office may be made by the appointer (s 24B(10))` TRUE TRUE EQUALS JUST TRUE
#ASSERT `an appointment to act in the office may be made by the appointer (s 24B(10))` TRUE FALSE EQUALS JUST TRUE
#ASSERT `an appointment to act in the office may be made by the appointer (s 24B(10))` FALSE TRUE EQUALS NOTHING
#ASSERT `the appointment continues in force and the person for the time being occupying or acting in the office is taken to be the appointer (s 24B(11))` TRUE TRUE EQUALS JUST TRUE
#ASSERT `the appointment continues in force and the person for the time being occupying or acting in the office is taken to be the appointer (s 24B(11))` TRUE FALSE EQUALS NOTHING
#ASSERT `the appointment continues in force and the body as constituted for the time being is taken to be the appointer (s 24B(12))` TRUE TRUE EQUALS JUST TRUE
#ASSERT `the appointment continues in force and the body as constituted for the time being is taken to be the appointer (s 24B(12))` FALSE TRUE EQUALS NOTHING
#ASSERT `the writing is evidence of the appointment or the ending of the appointment (s 24B(13))` TRUE EQUALS JUST TRUE
#ASSERT `the writing is evidence of the appointment or the ending of the appointment (s 24B(13))` FALSE EQUALS NOTHING
#ASSERT `the certificate is evidence of the thing it states (s 24B(14))` TRUE TRUE EQUALS JUST TRUE
#ASSERT `the certificate is evidence of the thing it states (s 24B(14))` TRUE FALSE EQUALS NOTHING
#ASSERT `the document is taken to be the certificate, and to have been properly given (s 24B(15))` TRUE FALSE EQUALS JUST TRUE
#ASSERT `the document is taken to be the certificate, and to have been properly given (s 24B(15))` TRUE TRUE EQUALS NOTHING
#ASSERT `the document is taken to be the certificate, and to have been properly given (s 24B(15))` FALSE FALSE EQUALS NOTHING

§§ `ss 24C and 25`

#ASSERT `s 24C applies (s 24C(1))` TRUE EQUALS JUST TRUE
#ASSERT `s 24C applies (s 24C(1))` FALSE EQUALS NOTHING
#ASSERT `the nominated person has all the functions and powers, and laws apply as if the nominated person were the officer or holder of the office (s 24C(2))` TRUE TRUE EQUALS JUST TRUE
#ASSERT `the nominated person has all the functions and powers, and laws apply as if the nominated person were the officer or holder of the office (s 24C(2))` TRUE FALSE EQUALS NOTHING
#ASSERT `the thing done is invalid merely because the occasion for the nominated person to act had not happened or had ceased (s 24C(3))` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `the thing done is invalid merely because the occasion for the nominated person to act had not happened or had ceased (s 24C(3))` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `the power of appointment includes the power (s 25(1)(b))` TRUE `power to remove or suspend, at any time, a person appointed to the office` EQUALS JUST TRUE
#ASSERT `the power of appointment includes the power (s 25(1)(b))` TRUE `power to appoint another person to act in the office if a person appointed to the office is removed or suspended` EQUALS JUST TRUE
#ASSERT `the power of appointment includes the power (s 25(1)(b))` TRUE `power to reinstate or reappoint a person removed or suspended` EQUALS JUST TRUE
#ASSERT `the power of appointment includes the power (s 25(1)(b))` TRUE `power to appoint a person to act in the office if it is vacant (whether or not the office has ever been filled)` EQUALS JUST TRUE
#ASSERT `the power of appointment includes the power (s 25(1)(b))` TRUE `power to appoint a person to act in the office if the person appointed to the office is absent or is unable to discharge the functions of the office (whether because of illness or otherwise)` EQUALS JUST TRUE
#ASSERT `the power of appointment includes the power (s 25(1)(b))` TRUE `any other power` EQUALS NOTHING
#ASSERT `the power of appointment includes the power (s 25(1)(b))` FALSE `power to remove or suspend, at any time, a person appointed to the office` EQUALS NOTHING
#ASSERT `the power of appointment may be exercised as occasion requires (s 25(1)(a))` TRUE EQUALS JUST TRUE
#ASSERT `the power of appointment also includes power to reappoint the person to the office (s 25(1)(c))` TRUE TRUE EQUALS JUST TRUE
#ASSERT `the power of appointment also includes power to reappoint the person to the office (s 25(1)(c))` TRUE FALSE EQUALS NOTHING
#ASSERT `the power to remove or suspend a person under s 25(1)(b) may be exercised (s 25(2))` TRUE EQUALS JUST TRUE
#ASSERT `the power to remove or suspend a person under s 25(1)(b) may be exercised (s 25(2))` FALSE EQUALS JUST TRUE
#ASSERT `the power to make an appointment under s 25(1)(b) may be exercised as occasion requires (s 25(3))` EQUALS JUST TRUE
#ASSERT `an appointment under s 25(1)(b) may be expressed to have effect only in the circumstances specified in the instrument of appointment (s 25(4))` EQUALS JUST TRUE

§§ `ss 26 and 27`

-- SAYS The appointment of a person to an office, to act, to exercise a power or to do anything else is not "invalid" merely because of a "defect or irregularity" in relation to the appointment (s 26).
#ASSERT `the appointment is invalid merely because of a defect or irregularity in relation to the appointment (s 26)` `an appointment to an office` TRUE EQUALS JUST FALSE
#ASSERT `the appointment is invalid merely because of a defect or irregularity in relation to the appointment (s 26)` `an appointment to act in an office` TRUE EQUALS JUST FALSE
#ASSERT `the appointment is invalid merely because of a defect or irregularity in relation to the appointment (s 26)` `an appointment to exercise a power` TRUE EQUALS JUST FALSE
#ASSERT `the appointment is invalid merely because of a defect or irregularity in relation to the appointment (s 26)` `an appointment to do anything else` TRUE EQUALS JUST FALSE
#ASSERT `the appointment is invalid merely because of a defect or irregularity in relation to the appointment (s 26)` `an appointment to an office` FALSE EQUALS NOTHING
#ASSERT `the person or body has authority (s 27)` TRUE `to receive evidence` EQUALS JUST TRUE
#ASSERT `the person or body has authority (s 27)` TRUE `to examine witnesses, and to administer oaths to witnesses, who have been lawfully called before the person or body` EQUALS JUST TRUE
#ASSERT `the person or body has authority (s 27)` TRUE `anything else` EQUALS NOTHING
#ASSERT `the person or body has authority (s 27)` FALSE `to receive evidence` EQUALS NOTHING

§§ `s 27A`

#ASSERT `the person or body may, in accordance with the Act and any other applicable law, delegate the function or power in the way (s 27A(1))` TRUE `to a person or body by name` EQUALS JUST TRUE
#ASSERT `the person or body may, in accordance with the Act and any other applicable law, delegate the function or power in the way (s 27A(1))` TRUE `to a specified officer, or the holder of a specified office, by reference to the title of the office concerned` EQUALS JUST TRUE
#ASSERT `the person or body may, in accordance with the Act and any other applicable law, delegate the function or power in the way (s 27A(1))` TRUE `in another way` EQUALS NOTHING
#ASSERT `the person or body may, in accordance with the Act and any other applicable law, delegate the function or power in the way (s 27A(1))` FALSE `to a person or body by name` EQUALS NOTHING
#ASSERT `the delegation may be of the form (s 27A(2))` `general` EQUALS JUST TRUE
#ASSERT `the delegation may be of the form (s 27A(2))` `limited` EQUALS JUST TRUE
#ASSERT `the delegation may be of the form (s 27A(2))` `made from time to time` EQUALS JUST TRUE
#ASSERT `the delegation may be of the form (s 27A(2))` `revoked, wholly or partly, by the delegator` EQUALS JUST TRUE
#ASSERT `the delegation may be of the form (s 27A(2))` `any other form` EQUALS NOTHING
#ASSERT `the requirement for writing and signature is met (s 27A(3))` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `the requirement for writing and signature is met (s 27A(3))` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `the requirement for writing and signature is met (s 27A(3))` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `the requirement for writing and signature is met (s 27A(3))` FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `the delegation may be made or revoked by a resolution of the body (s 27A(3A))` TRUE EQUALS JUST TRUE
#ASSERT `the delegation may be made or revoked by a resolution of the body (s 27A(3A))` FALSE EQUALS NOTHING
#ASSERT `all conditions and preliminary steps required for the exercise of a delegation are presumed to have been satisfied and performed (s 27A(3B))` FALSE EQUALS JUST TRUE
#ASSERT `all conditions and preliminary steps required for the exercise of a delegation are presumed to have been satisfied and performed (s 27A(3B))` TRUE EQUALS NOTHING
#ASSERT `laws apply to the delegate, and to other persons in relationship to the delegate, as if the delegate were the delegator (s 27A(3C))` TRUE EQUALS JUST TRUE
#ASSERT `the thing is taken to have been done by or in relation to the delegator (s 27A(3D))` TRUE EQUALS JUST TRUE
#ASSERT `the thing is taken to have been done by or in relation to the delegator (s 27A(3D))` FALSE EQUALS NOTHING
-- The example: a certificate purporting to be signed by the delegate under a general power of delegation is taken, under (3C) and (3D) and (6) and (7), to have been signed by the delegator.
-- src:517 | Example—
-- src:518 | Under an Act an evidentiary certificate purporting to be signed by an office holder is evidence of the content in any proceeding (the facilitation provision). The Act confers a general power of delegation on the office holder. The office holder uses the power to delegate the function of issuing the certificate to someone else. Under subsections (3C) and (3D) (and (6) and (7)), the facilitation provision is taken to provide for the certificate purporting to be signed by the delegate as having been signed by the delegator.
@ref s 27A(3D), example (src:517-518)
#ASSERT `the thing is taken to have been done by or in relation to the delegator (s 27A(3D))` TRUE EQUALS JUST TRUE
#ASSERT `the delegated function or power is taken to have been properly performed or exercised by the delegate (s 27A(6))` TRUE FALSE EQUALS JUST TRUE
#ASSERT `the delegated function or power is taken to have been performed or exercised by the delegator (s 27A(7))` TRUE EQUALS JUST TRUE
-- SAYS A delegated function or power may be exercised only in accordance with the conditions of the delegation (s 27A(4)).
#ASSERT `a delegated function or power may be exercised (s 27A(4))` FALSE EQUALS JUST FALSE
#ASSERT `a delegated function or power may be exercised (s 27A(4))` TRUE EQUALS NOTHING
#ASSERT `the delegate may do the thing in the performance of the delegated function or the exercise of the delegated power (s 27A(5))` TRUE EQUALS JUST TRUE
#ASSERT `the delegate may do the thing in the performance of the delegated function or the exercise of the delegated power (s 27A(5))` FALSE EQUALS NOTHING
#ASSERT `the delegated function or power is taken to have been properly performed or exercised by the delegate (s 27A(6))` TRUE TRUE EQUALS NOTHING
#ASSERT `the delegated function or power is taken to have been properly performed or exercised by the delegate (s 27A(6))` FALSE FALSE EQUALS NOTHING
#ASSERT `the delegated function or power is taken to have been performed or exercised by the delegator (s 27A(7))` FALSE EQUALS NOTHING
#ASSERT `the function or power is dependent on the delegate's opinion, belief or state of mind (s 27A(8))` TRUE TRUE EQUALS JUST TRUE
#ASSERT `the function or power is dependent on the delegate's opinion, belief or state of mind (s 27A(8))` TRUE FALSE EQUALS NOTHING
#ASSERT `the delegation continues in force and the person for the time being occupying or acting in the office is taken to be the delegator (s 27A(8A))` TRUE TRUE EQUALS JUST TRUE
#ASSERT `the delegation continues in force and the person for the time being occupying or acting in the office is taken to be the delegator (s 27A(8A))` TRUE FALSE EQUALS NOTHING
#ASSERT `the delegation continues in force and the body as constituted for the time being is taken to be the delegator (s 27A(8B))` TRUE TRUE EQUALS JUST TRUE
#ASSERT `the delegation continues in force and the body as constituted for the time being is taken to be the delegator (s 27A(8B))` FALSE TRUE EQUALS NOTHING
#ASSERT `the delegation ceases to have effect merely because the person ceases to be the officer or holder (s 27A(9)(a))` TRUE TRUE EQUALS JUST FALSE
#ASSERT `the delegation ceases to have effect merely because the person ceases to be the officer or holder (s 27A(9)(a))` TRUE FALSE EQUALS NOTHING
#ASSERT `the person may perform the function or exercise the power (s 27A(9)(b))` TRUE TRUE EQUALS JUST TRUE
#ASSERT `the person may perform the function or exercise the power (s 27A(9)(b))` TRUE FALSE EQUALS NOTHING
#ASSERT `the delegator may, despite the delegation, perform the function or exercise the power (s 27A(10))` TRUE EQUALS JUST TRUE
#ASSERT `the delegation relieves the delegator of the delegator's obligation to ensure that the function or power is properly performed or exercised (s 27A(10A))` TRUE EQUALS JUST FALSE
#ASSERT `the delegation relieves the delegator of the delegator's obligation to ensure that the function or power is properly performed or exercised (s 27A(10A))` FALSE EQUALS NOTHING
#ASSERT `s 27A applies to the subdelegation in the same way as it applies to a delegation (s 27A(11))` TRUE EQUALS JUST TRUE
-- SAYS A function or power may be subdelegated only if the Act expressly authorises it to be subdelegated (s 27A(12)).
#ASSERT `the function or power may be subdelegated (s 27A(12))` TRUE TRUE EQUALS JUST TRUE
#ASSERT `the function or power may be subdelegated (s 27A(12))` TRUE FALSE EQUALS JUST FALSE
#ASSERT `the function or power may be subdelegated (s 27A(12))` FALSE FALSE EQUALS NOTHING
#ASSERT `the writing is evidence of the delegation or revocation (s 27A(13))` TRUE EQUALS JUST TRUE
#ASSERT `the certificate is evidence of the thing it states (s 27A(14))` TRUE TRUE EQUALS JUST TRUE
#ASSERT `the certificate is evidence of the thing it states (s 27A(14))` FALSE TRUE EQUALS NOTHING
#ASSERT `the document is taken to be the certificate, and to have been properly given (s 27A(15))` TRUE FALSE EQUALS JUST TRUE
#ASSERT `the document is taken to be the certificate, and to have been properly given (s 27A(15))` TRUE TRUE EQUALS NOTHING
#ASSERT `authority to delegate a person's or body's powers includes that authority (s 27A(15A))` TRUE EQUALS JUST TRUE
#ASSERT `authority to delegate a person's or body's powers includes that authority (s 27A(15A))` FALSE EQUALS NOTHING
#ASSERT `the thing is a power in s 27A (s 27A(16), definition power)` TRUE EQUALS JUST TRUE

§§ `ss 27B, 29 and 29B`

-- SAYS Where an Act requires a decision-maker to give written reasons, the instrument giving them must also set out the findings on material questions of fact and refer to the evidence on which the findings were based (s 27B).
#ASSERT `the instrument giving the reasons has the content s 27B requires (s 27B)` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `the instrument giving the reasons has the content s 27B requires (s 27B)` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `the instrument giving the reasons has the content s 27B requires (s 27B)` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `the instrument giving the reasons has the content s 27B requires (s 27B)` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `the resolution is interpreted as operating to the full extent of, but not to exceed, the Legislative Assembly's constitutional powers, subject to the Act, and distributively (s 29(1))` TRUE EQUALS JUST TRUE
#ASSERT `the resolution is interpreted as operating to the full extent of, but not to exceed, the Legislative Assembly's constitutional powers, subject to the Act, and distributively (s 29(1))` FALSE EQUALS NOTHING
#ASSERT `the resolution has effect to the extent to which it does not exceed authority (s 29(2)(a))` TRUE EQUALS JUST TRUE
#ASSERT `the remainder of the resolution is affected (s 29(2)(b))` TRUE EQUALS JUST FALSE
#ASSERT `the remainder of the resolution is affected (s 29(2)(b))` FALSE EQUALS NOTHING
#ASSERT `the part's application to other persons, matters or circumstances is affected (s 29(3))` TRUE EQUALS JUST FALSE
#ASSERT `the part's application to other persons, matters or circumstances is affected (s 29(3))` FALSE EQUALS NOTHING
#ASSERT `s 29 applies to an Act in addition to, and without limiting, any provision of the Act (s 29(4))` TRUE EQUALS JUST TRUE
-- s 29B: sitting days in different Parliaments and sessions are counted together.
`a sitting day in Parliament 56, session 1` MEANS `Sitting day of the Legislative Assembly` OF 56, 1, Date 10 3 2020
`a second sitting day in Parliament 56, session 1` MEANS `Sitting day of the Legislative Assembly` OF 56, 1, Date 11 3 2020
`a sitting day in Parliament 57, session 2` MEANS `Sitting day of the Legislative Assembly` OF 57, 2, Date 11 3 2021
`a sitting day in Parliament 57, session 3` MEANS `Sitting day of the Legislative Assembly` OF 57, 3, Date 12 3 2022

#ASSERT `the number of sitting days of the Legislative Assembly (s 29B)` (LIST `a sitting day in Parliament 56, session 1`, `a sitting day in Parliament 57, session 2`, `a sitting day in Parliament 57, session 3`) EQUALS 3
#ASSERT `the number of sitting days of the Legislative Assembly (s 29B)` (LIST `a sitting day in Parliament 56, session 1`, `a second sitting day in Parliament 56, session 1`) EQUALS 2
