IMPORT prelude
IMPORT `qld-part12-coastal-waters`

-- Tests for Part 12 (qld-part12-coastal-waters.l4).
-- Each expected value was worked out by hand from the text, as cited.

§ `Tests of Part 12`

#ASSERT `the scheme is the cooperative scheme (s 47, definition cooperative scheme)` TRUE EQUALS JUST TRUE
#ASSERT `the scheme is the cooperative scheme (s 47, definition cooperative scheme)` FALSE EQUALS JUST FALSE
#ASSERT `the law is a criminal law (s 47, definition criminal laws)` TRUE EQUALS JUST TRUE
#ASSERT `the law is a criminal law (s 47, definition criminal laws)` FALSE EQUALS JUST FALSE
-- SAYS The laws of the State are the laws in force in the State, written or unwritten, substantive or procedural, other than laws of the Commonwealth and criminal laws (s 47).
#ASSERT `the law is a law of the State (s 47, definition laws of the State)` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `the law is a law of the State (s 47, definition laws of the State)` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `the law is a law of the State (s 47, definition laws of the State)` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `the law is a law of the State (s 47, definition laws of the State)` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `the laws of the State apply in and in relation to the place (s 47A)` TRUE `the coastal waters of the State` EQUALS JUST TRUE
#ASSERT `the laws of the State apply in and in relation to the place (s 47A)` TRUE `the seabed and subsoil beneath the coastal waters of the State` EQUALS JUST TRUE
#ASSERT `the laws of the State apply in and in relation to the place (s 47A)` TRUE `the airspace above the coastal waters of the State` EQUALS JUST TRUE
#ASSERT `the laws of the State apply in and in relation to the place (s 47A)` TRUE `any other place` EQUALS NOTHING
#ASSERT `the laws of the State apply in and in relation to the place (s 47A)` FALSE `the coastal waters of the State` EQUALS NOTHING
#ASSERT `this part makes the provision applicable in or in relation to the place (s 47B(1))` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `this part makes the provision applicable in or in relation to the place (s 47B(1))` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `this part makes the provision applicable in or in relation to the place (s 47B(1))` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `this part makes the provision applicable in or in relation to the place (s 47B(1))` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `the provision is taken to be a provision to which s 47B(1) applies merely because of that limit (s 47B(2))` TRUE EQUALS JUST FALSE
#ASSERT `the provision is taken to be a provision to which s 47B(1) applies merely because of that limit (s 47B(2))` FALSE EQUALS NOTHING
#ASSERT `the person has and may perform the function as if the coastal waters of the State, as extending from time to time, were within the limits of the State (s 47C(1))` TRUE EQUALS JUST TRUE
#ASSERT `the person has and may perform the function as if the coastal waters of the State, as extending from time to time, were within the limits of the State (s 47C(1))` FALSE EQUALS NOTHING
#ASSERT `all courts of the State are invested with jurisdiction in the matter (s 47C(2))` TRUE EQUALS JUST TRUE
#ASSERT `all courts of the State are invested with jurisdiction in the matter (s 47C(2))` FALSE EQUALS NOTHING
#ASSERT `the provisions of this part are enacted under the power (s 47D)` TRUE EQUALS JUST TRUE
#ASSERT `the provisions of this part are enacted under the power (s 47D)` FALSE EQUALS NOTHING
#ASSERT `this part limits the law (s 47E)` TRUE EQUALS JUST FALSE
#ASSERT `this part limits the law (s 47E)` FALSE EQUALS NOTHING
#ASSERT `the provision is given in the note to s 47E as an example of a special application provision (s 47E, note)` "Fisheries Act 1994, section 11" EQUALS JUST TRUE
#ASSERT `the provision is given in the note to s 47E as an example of a special application provision (s 47E, note)` "Offshore Minerals Act 1998, section 16" EQUALS JUST TRUE
#ASSERT `the provision is given in the note to s 47E as an example of a special application provision (s 47E, note)` "Petroleum Act 1923, section 7A" EQUALS JUST TRUE
#ASSERT `the provision is given in the note to s 47E as an example of a special application provision (s 47E, note)` "Petroleum (Submerged Lands) Act 1982, section 14" EQUALS JUST TRUE
#ASSERT `the provision is given in the note to s 47E as an example of a special application provision (s 47E, note)` "Mining Act 1968, section 1" EQUALS NOTHING
