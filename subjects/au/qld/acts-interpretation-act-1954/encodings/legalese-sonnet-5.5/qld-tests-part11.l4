IMPORT prelude
IMPORT `qld-part11-offences`

-- Tests for Part 11 (qld-part11-offences.l4).
-- Each expected value was worked out by hand from the text, as cited.

§ `Tests of Part 11`

-- s 41(e): no minimum -- a penalty not more than the specified penalty (here 100).
#ASSERT `the offence is punishable by the penalty imposed (s 41)` TRUE NOTHING 100 100 EQUALS JUST TRUE
#ASSERT `the offence is punishable by the penalty imposed (s 41)` TRUE NOTHING 100 0 EQUALS JUST TRUE
#ASSERT `the offence is punishable by the penalty imposed (s 41)` TRUE NOTHING 100 101 EQUALS JUST FALSE
-- s 41(d): a minimum of 20 as well as a maximum of 100.
-- SAYS Where a minimum as well as a maximum penalty is specified at the end of a section, the offence is punishable by a penalty not less than the minimum and not more than the maximum (s 41(d)).
#ASSERT `the offence is punishable by the penalty imposed (s 41)` TRUE (JUST 20) 100 20 EQUALS JUST TRUE
#ASSERT `the offence is punishable by the penalty imposed (s 41)` TRUE (JUST 20) 100 100 EQUALS JUST TRUE
#ASSERT `the offence is punishable by the penalty imposed (s 41)` TRUE (JUST 20) 100 19 EQUALS JUST FALSE
#ASSERT `the offence is punishable by the penalty imposed (s 41)` TRUE (JUST 20) 100 101 EQUALS JUST FALSE
-- a penalty not at the end of a provision: s 41 does not answer
#ASSERT `the offence is punishable by the penalty imposed (s 41)` FALSE NOTHING 100 50 EQUALS NOTHING
-- s 41A(1): a penalty specified for an offence elsewhere in the provision
#ASSERT `the offence is punishable by the penalty imposed (s 41A)` TRUE FALSE NOTHING 100 100 EQUALS JUST TRUE
#ASSERT `the offence is punishable by the penalty imposed (s 41A)` TRUE FALSE NOTHING 100 101 EQUALS JUST FALSE
#ASSERT `the offence is punishable by the penalty imposed (s 41A)` TRUE FALSE (JUST 20) 100 19 EQUALS JUST FALSE
#ASSERT `the offence is punishable by the penalty imposed (s 41A)` TRUE FALSE (JUST 20) 100 60 EQUALS JUST TRUE
-- (2): a penalty to which s 41 applies is outside s 41A
#ASSERT `the offence is punishable by the penalty imposed (s 41A)` TRUE TRUE NOTHING 100 50 EQUALS NOTHING
#ASSERT `the offence is punishable by the penalty imposed (s 41A)` FALSE FALSE NOTHING 100 50 EQUALS NOTHING
#ASSERT `any person may take the proceeding (s 42)` TRUE EQUALS JUST TRUE
#ASSERT `any person may take the proceeding (s 42)` FALSE EQUALS NOTHING
-- s 43: an amount of $1000 recovered.
#ASSERT `subsection (2) applies (s 43(3))` FALSE
#ASSERT NOT `subsection (2) applies (s 43(3))` TRUE
#ASSERT `the order is within what subsection (2) allows (s 43(2))` 1000 500 FALSE
#ASSERT NOT `the order is within what subsection (2) allows (s 43(2))` 1000 501 FALSE
#ASSERT `the order is within what subsection (2) allows (s 43(2))` 1000 0 FALSE
#ASSERT NOT `the order is within what subsection (2) allows (s 43(2))` 1000 100 TRUE
-- SAYS The part of an amount recovered that is ordered to be paid to the party prosecuting is paid first, and the remaining part is paid to the consolidated fund (s 43(1)).
#ASSERT `the part of the amount paid to the consolidated fund (s 43(1)(b))` 1000 400 EQUALS 600
#ASSERT `the part of the amount paid to the consolidated fund (s 43(1)(b))` 1000 0 EQUALS 1000
#ASSERT `a proceeding for the offence is a summary proceeding under the Justices Act 1886 (s 44(1) and (2))` `a provision to the effect that a proceeding for the offence is to be heard and decided summarily` EQUALS JUST TRUE
#ASSERT `a proceeding for the offence is a summary proceeding under the Justices Act 1886 (s 44(1) and (2))` `a provision to the effect that a proceeding for the offence is to be heard and decided by or before justices or a magistrate` EQUALS JUST TRUE
#ASSERT `a proceeding for the offence is a summary proceeding under the Justices Act 1886 (s 44(1) and (2))` `a provision to the effect that the offence is a summary offence or is punishable on summary conviction or summarily` EQUALS JUST TRUE
#ASSERT `a proceeding for the offence is a summary proceeding under the Justices Act 1886 (s 44(1) and (2))` `a provision for an offence that does not expressly or impliedly make the offence an indictable offence` EQUALS JUST TRUE
#ASSERT `a proceeding for the offence is a summary proceeding under the Justices Act 1886 (s 44(1) and (2))` `any other provision` EQUALS NOTHING
#ASSERT `the other type of proceeding is a summary proceeding under the Justices Act 1886 (s 44(3))` TRUE EQUALS JUST TRUE
#ASSERT `the other type of proceeding is a summary proceeding under the Justices Act 1886 (s 44(3))` FALSE EQUALS NOTHING
#ASSERT `the penalty may be recovered, or the order made, under the Justices Act 1886 (s 44(4))` TRUE FALSE EQUALS JUST TRUE
#ASSERT `the penalty may be recovered, or the order made, under the Justices Act 1886 (s 44(4))` TRUE TRUE EQUALS NOTHING
#ASSERT `the penalty may be recovered, or the order made, under the Justices Act 1886 (s 44(4))` FALSE FALSE EQUALS NOTHING
-- SAYS If an act or omission is an offence under each of 2 or more laws, the offender may be prosecuted and punished under any of the laws, but may not be punished more than once for the same offence (s 45(1)).
#ASSERT `the offender may be prosecuted and punished under any of the laws (s 45(1))` TRUE FALSE EQUALS JUST TRUE
#ASSERT `the offender may be prosecuted and punished under any of the laws (s 45(1))` TRUE TRUE EQUALS NOTHING
#ASSERT `the offender may be prosecuted and punished under any of the laws (s 45(1))` FALSE FALSE EQUALS NOTHING
#ASSERT `the offender may be punished more than once for the same offence (s 45(1))` TRUE FALSE EQUALS JUST FALSE
#ASSERT `the offender may be punished more than once for the same offence (s 45(1))` TRUE TRUE EQUALS NOTHING
#ASSERT `the common law is a law in s 45 (s 45(3), definition law)` TRUE EQUALS JUST TRUE
#ASSERT `the common law is a law in s 45 (s 45(3), definition law)` FALSE EQUALS NOTHING
#ASSERT `the provision applies to the person (s 46)` TRUE `an individual` EQUALS JUST TRUE
#ASSERT `the provision applies to the person (s 46)` TRUE `a body corporate` EQUALS JUST TRUE
#ASSERT `the provision applies to the person (s 46)` TRUE `anyone else` EQUALS NOTHING
#ASSERT `the provision applies to the person (s 46)` FALSE `a body corporate` EQUALS NOTHING
