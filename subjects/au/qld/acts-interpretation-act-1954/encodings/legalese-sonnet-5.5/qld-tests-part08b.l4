IMPORT prelude
IMPORT daydate
IMPORT `qld-part08b-ministers-and-offices`

-- Tests for Part 8, second group (qld-part08b-ministers-and-offices.l4).
-- Each expected value was worked out by hand from the text, as cited.

§ `Tests of Part 8, ss 33 to 35A`

§§ `s 33`

#ASSERT `a reference to a Minister is a reference to the person (s 33(1)(a))` TRUE EQUALS JUST TRUE
#ASSERT `a reference to a Minister is a reference to the person (s 33(1)(a))` FALSE EQUALS JUST FALSE
#ASSERT `the reference includes a reference to the person (s 33(1)(b))` TRUE TRUE EQUALS JUST TRUE
#ASSERT `the reference includes a reference to the person (s 33(1)(b))` TRUE FALSE EQUALS NOTHING
#ASSERT `the reference includes a reference to the person (s 33(1)(b))` FALSE TRUE EQUALS NOTHING
-- (2): one Minister administers the provision -- that Minister (a).
#ASSERT `which Minister a reference to the Minister without specifying a particular Minister by title is a reference to (s 33(2))` FALSE 0 1 EQUALS JUST `the Minister administering the provision`
-- (2)(b)(i): different Ministers for different matters, 1 for the relevant matter.
#ASSERT `which Minister a reference to the Minister without specifying a particular Minister by title is a reference to (s 33(2))` TRUE 1 2 EQUALS JUST `the Minister who administers the provision in relation to the relevant matter`
-- (2)(b)(ii): 2 or more for the relevant matter -- any 1 of them.
#ASSERT `which Minister a reference to the Minister without specifying a particular Minister by title is a reference to (s 33(2))` TRUE 2 3 EQUALS JUST `any 1 of the Ministers who administer the provision in relation to the relevant matter`
-- (2)(c): (b) does not apply and 2 or more Ministers administer the provision -- any 1 of them.
#ASSERT `which Minister a reference to the Minister without specifying a particular Minister by title is a reference to (s 33(2))` FALSE 0 2 EQUALS JUST `any 1 of the Ministers who administer the provision`
-- no Minister for the matter, or none for the provision: the text does not say
#ASSERT `which Minister a reference to the Minister without specifying a particular Minister by title is a reference to (s 33(2))` TRUE 0 2 EQUALS NOTHING
#ASSERT `which Minister a reference to the Minister without specifying a particular Minister by title is a reference to (s 33(2))` FALSE 0 0 EQUALS NOTHING
#ASSERT `subsection (2) applies as if references to the provision were references to the specified Act or enactment (s 33(3))` TRUE EQUALS JUST TRUE
#ASSERT `subsection (2) applies as if references to the provision were references to the specified Act or enactment (s 33(3))` FALSE EQUALS NOTHING
#ASSERT `subsections (2) and (3) apply to the provision despite the definition (s 33(4))` TRUE EQUALS JUST TRUE
#ASSERT `subsections (2) and (3) apply to the provision despite the definition (s 33(4))` FALSE EQUALS NOTHING
#ASSERT `a reference to the specified Minister is a reference to the Minister specified by notification by the Governor in Council (s 33(5)(a))` TRUE EQUALS JUST TRUE
#ASSERT `a reference to the specified Minister is a reference to the Minister specified by notification by the Governor in Council (s 33(5)(a))` FALSE EQUALS NOTHING
#ASSERT `a reference to the specified Minister includes a reference to the person (s 33(5)(b))` TRUE TRUE EQUALS JUST TRUE
#ASSERT `a reference to the specified Minister includes a reference to the person (s 33(5)(b))` TRUE FALSE EQUALS NOTHING

§§ `ss 33AA to 33AC`

#ASSERT `a reference to a department is a reference to the entity (s 33AA(1))` TRUE EQUALS JUST TRUE
#ASSERT `a reference to a department is a reference to the entity (s 33AA(1))` FALSE EQUALS JUST FALSE
#ASSERT `which department a reference to the department is a reference to (s 33AA(2))` FALSE TRUE EQUALS JUST `the department of government that deals with the relevant matter and is administered by the Minister or Ministers administering the provision in relation to the matter`
#ASSERT `which department a reference to the department is a reference to (s 33AA(2))` FALSE FALSE EQUALS JUST `the department of government that deals with the matters to which the provision relates and is administered by the Minister or Ministers for the time being administering the provision`
#ASSERT `which department a reference to the department is a reference to (s 33AA(2))` TRUE FALSE EQUALS NOTHING
#ASSERT `a reference to the department is a reference to the department specified by notification by the Governor in Council (s 33AA(3))` TRUE EQUALS JUST TRUE
#ASSERT `a reference to the department is a reference to the department specified by notification by the Governor in Council (s 33AA(3))` FALSE EQUALS NOTHING
#ASSERT `subsection (2) applies as if references to the provision were references to the specified Act or enactment (s 33AA(4))` TRUE EQUALS JUST TRUE
#ASSERT `a reference to a chief executive is a reference to the entity (s 33AB(1))` TRUE EQUALS JUST TRUE
#ASSERT `a reference to a chief executive is a reference to the entity (s 33AB(1))` FALSE EQUALS JUST FALSE
#ASSERT `the chief executive of which public sector unit a reference to the chief executive is a reference to (s 33AB(2))` FALSE TRUE EQUALS JUST `the public sector unit that deals with the relevant matter and is administered by the Minister or Ministers administering the provision in relation to the matter`
#ASSERT `the chief executive of which public sector unit a reference to the chief executive is a reference to (s 33AB(2))` FALSE FALSE EQUALS JUST `the public sector unit that deals with the matters to which the provision relates and is administered by the Minister or Ministers for the time being administering the provision`
#ASSERT `the chief executive of which public sector unit a reference to the chief executive is a reference to (s 33AB(2))` TRUE TRUE EQUALS NOTHING
#ASSERT `subsection (2) applies as if references to the provision were references to the specified Act or enactment (s 33AB(3))` TRUE EQUALS JUST TRUE
-- SAYS Where a provision is administered by 2 or more Ministers and authorises anything to be done by or in relation to any 1 of them, it does not authorise or require it to be done in a particular case by or in relation to more than 1 of them (s 33AC).
#ASSERT `the provision authorises or requires it to be done in a particular case by or in relation to more than 1 of the Ministers (s 33AC)` TRUE TRUE EQUALS JUST FALSE
#ASSERT `the provision authorises or requires it to be done in a particular case by or in relation to more than 1 of the Ministers (s 33AC)` TRUE FALSE EQUALS NOTHING
#ASSERT `the provision authorises or requires it to be done in a particular case by or in relation to more than 1 of the Ministers (s 33AC)` FALSE TRUE EQUALS NOTHING

§§ `s 33A`

-- Examples 1 and 2: a law of a State, and a law of the Commonwealth or another State, include a law of the ACT and a law of the NT.
-- src:693 | Examples—
-- src:694 | 1 ‘A law of a State’ includes a law of the Australian Capital Territory and a law of the Northern Territory.
-- src:695 | 2 ‘A law of the Commonwealth or another State’ includes a law of the Australian Capital Territory and a law of the Northern Territory.
@ref s 33A(1), examples (src:693-695)
#ASSERT `a reference to a State includes a reference to the Territory (s 33A(1))` FALSE `the Australian Capital Territory` EQUALS JUST TRUE
#ASSERT `a reference to a State includes a reference to the Territory (s 33A(1))` FALSE `the Northern Territory` EQUALS JUST TRUE
#ASSERT `a reference to a State includes a reference to the Territory (s 33A(1))` FALSE `another Territory` EQUALS NOTHING
-- a reference to Queensland or to a particular State by name is outside the rule
#ASSERT `a reference to a State includes a reference to the Territory (s 33A(1))` TRUE `the Northern Territory` EQUALS NOTHING
#ASSERT `subsection (1) is displaced merely because there is an express reference to a Territory elsewhere in the Act (s 33A(2))` TRUE EQUALS JUST FALSE
#ASSERT `subsection (1) is displaced merely because there is an express reference to a Territory elsewhere in the Act (s 33A(2))` FALSE EQUALS NOTHING
-- (3): an Act (other than this Act) enacted before 1 July 1994 only if it has the definition.
#ASSERT `s 33A applies to the Act (s 33A(3))` FALSE (Date 30 6 1994) TRUE EQUALS JUST TRUE
#ASSERT `s 33A applies to the Act (s 33A(3))` FALSE (Date 30 6 1994) FALSE EQUALS JUST FALSE
#ASSERT `s 33A applies to the Act (s 33A(3))` FALSE (Date 1 7 1994) FALSE EQUALS NOTHING
#ASSERT `s 33A applies to the Act (s 33A(3))` TRUE (Date 1 1 1954) FALSE EQUALS NOTHING

§§ `ss 34 to 35A`

#ASSERT `the reference includes a reference to the person for the time being occupying or acting in the office concerned (s 34)` TRUE EQUALS JUST TRUE
#ASSERT `the reference includes a reference to the person for the time being occupying or acting in the office concerned (s 34)` FALSE EQUALS NOTHING
#ASSERT `the person holding the office may choose to be referred to by the title (s 34A(1))` TRUE TRUE EQUALS JUST TRUE
#ASSERT `the person holding the office may choose to be referred to by the title (s 34A(1))` TRUE FALSE EQUALS NOTHING
#ASSERT `it is relevant for performing functions and exercising powers that the person uses the alternative title (s 34A(2))` TRUE EQUALS JUST FALSE
#ASSERT `it is relevant for performing functions and exercising powers that the person uses the alternative title (s 34A(2))` FALSE EQUALS NOTHING
#ASSERT `the title is a chair title (s 34A(3), definition chair title)` "chair" FALSE EQUALS JUST TRUE
#ASSERT `the title is a chair title (s 34A(3), definition chair title)` "chairperson" FALSE EQUALS JUST TRUE
#ASSERT `the title is a chair title (s 34A(3), definition chair title)` "chairman" FALSE EQUALS JUST TRUE
#ASSERT `the title is a chair title (s 34A(3), definition chair title)` "chairwoman" FALSE EQUALS JUST TRUE
#ASSERT `the title is a chair title (s 34A(3), definition chair title)` "convenor" TRUE EQUALS JUST TRUE
#ASSERT `the title is a chair title (s 34A(3), definition chair title)` "secretary" FALSE EQUALS JUST FALSE
#ASSERT `the person holding the office may choose to be referred to by the deputy chair title (s 34B(1))` TRUE TRUE EQUALS JUST TRUE
#ASSERT `the person holding the office may choose to be referred to by the deputy chair title (s 34B(1))` FALSE TRUE EQUALS NOTHING
#ASSERT `it is relevant for performing functions and exercising powers that the person uses the alternative deputy chair title (s 34B(2))` TRUE EQUALS JUST FALSE
#ASSERT `the title is a deputy chair title (s 34B(3), definition deputy chair title)` "deputy chair" FALSE EQUALS JUST TRUE
#ASSERT `the title is a deputy chair title (s 34B(3), definition deputy chair title)` "deputy chairperson" FALSE EQUALS JUST TRUE
#ASSERT `the title is a deputy chair title (s 34B(3), definition deputy chair title)` "deputy chairman" FALSE EQUALS JUST TRUE
#ASSERT `the title is a deputy chair title (s 34B(3), definition deputy chair title)` "deputy chairwoman" FALSE EQUALS JUST TRUE
#ASSERT `the title is a deputy chair title (s 34B(3), definition deputy chair title)` "chair" FALSE EQUALS JUST FALSE
#ASSERT `the reference is a reference to such an officer, office or entity in and for Queensland (s 35(1)(a))` TRUE EQUALS JUST TRUE
#ASSERT `the reference is a reference to such an officer, office or entity in and for Queensland (s 35(1)(a))` FALSE EQUALS NOTHING
#ASSERT `the reference is a reference to such a locality, jurisdiction or other thing in and of Queensland (s 35(1)(b))` TRUE EQUALS JUST TRUE
#ASSERT `the reference need include the words Queensland or of Queensland (s 35(2))` TRUE TRUE EQUALS JUST FALSE
#ASSERT `the reference need include the words Queensland or of Queensland (s 35(2))` TRUE FALSE EQUALS NOTHING
#ASSERT `a reference to a person in the capacity includes a reference to the person included (s 35A)` proprietor `the person's personal representatives` EQUALS JUST TRUE
#ASSERT `a reference to a person in the capacity includes a reference to the person included (s 35A)` transferor `the person's successors` EQUALS JUST TRUE
#ASSERT `a reference to a person in the capacity includes a reference to the person included (s 35A)` transferee `the person's assigns` EQUALS JUST TRUE
#ASSERT `a reference to a person in the capacity includes a reference to the person included (s 35A)` mortgagor `the person's assigns` EQUALS JUST TRUE
#ASSERT `a reference to a person in the capacity includes a reference to the person included (s 35A)` mortgagee `the person's assigns` EQUALS JUST TRUE
#ASSERT `a reference to a person in the capacity includes a reference to the person included (s 35A)` lessor `the person's assigns` EQUALS JUST TRUE
#ASSERT `a reference to a person in the capacity includes a reference to the person included (s 35A)` lessee `the person's assigns` EQUALS JUST TRUE
#ASSERT `a reference to a person in the capacity includes a reference to the person included (s 35A)` trustee `the person's assigns` EQUALS JUST TRUE
#ASSERT `a reference to a person in the capacity includes a reference to the person included (s 35A)` `a person having an interest in land` `the person's successors` EQUALS JUST TRUE
#ASSERT `a reference to a person in the capacity includes a reference to the person included (s 35A)` `another capacity` `the person's assigns` EQUALS NOTHING
#ASSERT `a reference to a person in the capacity includes a reference to the person included (s 35A)` proprietor `anyone else` EQUALS NOTHING
