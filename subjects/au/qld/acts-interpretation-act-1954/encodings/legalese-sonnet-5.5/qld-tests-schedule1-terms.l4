IMPORT prelude
IMPORT daydate
IMPORT `qld-schedule1-terms`

-- Tests for qld-schedule1-terms.l4.
-- Each expected value was worked out by hand from the text, as cited.

§ `Tests of the Schedule 1 term functions`

-- SAYS An adult is an individual who is 18 or more; a minor, and a child where age rather than descendancy is relevant, is an individual who is under 18 (Schedule 1).
#ASSERT `the person is an adult (Schedule 1, definition adult)` TRUE 18 EQUALS JUST TRUE
#ASSERT `the person is an adult (Schedule 1, definition adult)` TRUE 17 EQUALS JUST FALSE
#ASSERT `the person is an adult (Schedule 1, definition adult)` TRUE 40 EQUALS JUST TRUE
#ASSERT `the person is an adult (Schedule 1, definition adult)` FALSE 40 EQUALS JUST FALSE
#ASSERT `the person is a minor (Schedule 1, definition minor)` TRUE 17 EQUALS JUST TRUE
#ASSERT `the person is a minor (Schedule 1, definition minor)` TRUE 18 EQUALS JUST FALSE
#ASSERT `the person is a minor (Schedule 1, definition minor)` FALSE 5 EQUALS JUST FALSE
#ASSERT `the person is a child (Schedule 1, definition child)` TRUE TRUE 17 EQUALS JUST TRUE
#ASSERT `the person is a child (Schedule 1, definition child)` TRUE TRUE 18 EQUALS JUST FALSE
#ASSERT `the person is a child (Schedule 1, definition child)` FALSE TRUE 5 EQUALS NOTHING
#ASSERT `the person is an individual (Schedule 1, definition individual)` TRUE EQUALS JUST TRUE
#ASSERT `the person is an individual (Schedule 1, definition individual)` FALSE EQUALS JUST FALSE
#ASSERT `person includes the entity (Schedule 1, definition person)` `an individual` EQUALS JUST TRUE
#ASSERT `person includes the entity (Schedule 1, definition person)` `a corporation` EQUALS JUST TRUE
#ASSERT `person includes the entity (Schedule 1, definition person)` `a de facto partner` EQUALS NOTHING
#ASSERT `party includes the entity (Schedule 1, definition party)` `an individual` EQUALS JUST TRUE
#ASSERT `party includes the entity (Schedule 1, definition party)` `a corporation` EQUALS JUST TRUE
#ASSERT `party includes the entity (Schedule 1, definition party)` `anything else` EQUALS NOTHING
#ASSERT `spouse includes the entity (Schedule 1, definition spouse)` `a de facto partner` EQUALS JUST TRUE
#ASSERT `spouse includes the entity (Schedule 1, definition spouse)` `a civil partner` EQUALS JUST TRUE
#ASSERT `spouse includes the entity (Schedule 1, definition spouse)` `an individual` EQUALS NOTHING
#ASSERT `the person is a civil partner (Schedule 1, definition civil partner)` TRUE EQUALS JUST TRUE
#ASSERT `the person is a civil partner (Schedule 1, definition civil partner)` FALSE EQUALS JUST FALSE
#ASSERT `the person is a Torres Strait Islander (Schedule 1, definition Torres Strait Islander)` TRUE EQUALS JUST TRUE
#ASSERT `the person is a Torres Strait Islander (Schedule 1, definition Torres Strait Islander)` FALSE EQUALS JUST FALSE
#ASSERT `they are Aboriginal people (Schedule 1, definition Aboriginal people)` TRUE EQUALS JUST TRUE
#ASSERT `they are Aboriginal people (Schedule 1, definition Aboriginal people)` FALSE EQUALS JUST FALSE
#ASSERT `the people are included in the community or group of Aboriginal people (Schedule 1, definition community or group of Aboriginal people)` TRUE FALSE EQUALS JUST TRUE
#ASSERT `the people are included in the community or group of Aboriginal people (Schedule 1, definition community or group of Aboriginal people)` FALSE TRUE EQUALS JUST TRUE
#ASSERT `the people are included in the community or group of Aboriginal people (Schedule 1, definition community or group of Aboriginal people)` FALSE FALSE EQUALS NOTHING

§§ `Places and bodies`

-- SAYS State means a State of the Commonwealth and includes the Australian Capital Territory and the Northern Territory; a Territory such as the Jervis Bay Territory is not a State (Schedule 1).
#ASSERT `the place is a State (Schedule 1, definition State)` `a State of the Commonwealth` EQUALS JUST TRUE
#ASSERT `the place is a State (Schedule 1, definition State)` `the Australian Capital Territory` EQUALS JUST TRUE
#ASSERT `the place is a State (Schedule 1, definition State)` `the Northern Territory` EQUALS JUST TRUE
#ASSERT `the place is a State (Schedule 1, definition State)` `the Jervis Bay Territory` EQUALS JUST FALSE
#ASSERT `the place is a State (Schedule 1, definition State)` `another Territory of the Commonwealth` EQUALS JUST FALSE
#ASSERT `the place is an internal Territory (Schedule 1, definition internal Territory)` `the Australian Capital Territory` EQUALS JUST TRUE
#ASSERT `the place is an internal Territory (Schedule 1, definition internal Territory)` `the Jervis Bay Territory` EQUALS JUST TRUE
#ASSERT `the place is an internal Territory (Schedule 1, definition internal Territory)` `the Northern Territory` EQUALS JUST TRUE
#ASSERT `the place is an internal Territory (Schedule 1, definition internal Territory)` `another Territory of the Commonwealth` EQUALS JUST FALSE
#ASSERT `the place is an external Territory (Schedule 1, definition external Territory)` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `the place is an external Territory (Schedule 1, definition external Territory)` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `the place is an external Territory (Schedule 1, definition external Territory)` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `the place is an external Territory (Schedule 1, definition external Territory)` FALSE FALSE TRUE EQUALS JUST FALSE
-- Australia: the Commonwealth of Australia but, in a geographical sense, not an external Territory.
#ASSERT `the place is within Australia (Schedule 1, definition Australia)` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `the place is within Australia (Schedule 1, definition Australia)` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `the place is within Australia (Schedule 1, definition Australia)` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `the place is within Australia (Schedule 1, definition Australia)` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `the place is within the Commonwealth (Schedule 1, definition Commonwealth)` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `the place is within the Commonwealth (Schedule 1, definition Commonwealth)` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `the waters are Queensland waters (Schedule 1, definition Queensland waters)` TRUE FALSE EQUALS JUST TRUE
#ASSERT `the waters are Queensland waters (Schedule 1, definition Queensland waters)` FALSE TRUE EQUALS JUST TRUE
#ASSERT `the waters are Queensland waters (Schedule 1, definition Queensland waters)` FALSE FALSE EQUALS JUST FALSE
#ASSERT `the waters are coastal waters of the State (Schedule 1, definition coastal waters of the State)` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `the waters are coastal waters of the State (Schedule 1, definition coastal waters of the State)` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `the waters are coastal waters of the State (Schedule 1, definition coastal waters of the State)` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `the waters are coastal waters of the State (Schedule 1, definition coastal waters of the State)` FALSE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `the body is a local government (Schedule 1, definition local government)` TRUE FALSE EQUALS JUST TRUE
#ASSERT `the body is a local government (Schedule 1, definition local government)` FALSE TRUE EQUALS JUST TRUE
#ASSERT `the body is a local government (Schedule 1, definition local government)` FALSE FALSE EQUALS JUST FALSE

§§ `Documents, numbers, dates and other terms`

#ASSERT `the thing is a number (Schedule 1, definition number)` `a number expressed in figures or words` EQUALS JUST TRUE
#ASSERT `the thing is a number (Schedule 1, definition number)` `a letter` EQUALS JUST TRUE
#ASSERT `the thing is a number (Schedule 1, definition number)` `a combination of a number so expressed and a letter` EQUALS JUST TRUE
#ASSERT `the thing is a number (Schedule 1, definition number)` `anything else` EQUALS JUST FALSE
#ASSERT `the date of assent of an Act (Schedule 1, definition date of assent)` (Date 5 4 1995) EQUALS Date 5 4 1995
#ASSERT `the day is a sitting day (Schedule 1, definition sitting day)` TRUE EQUALS JUST TRUE
#ASSERT `the day is a sitting day (Schedule 1, definition sitting day)` FALSE EQUALS JUST FALSE
#ASSERT `the day is a public holiday (Schedule 1, definition public holiday)` TRUE EQUALS JUST TRUE
#ASSERT `the day is a public holiday (Schedule 1, definition public holiday)` FALSE EQUALS JUST FALSE
-- year, without specifying the type of year, means calendar year
#ASSERT `the year is a calendar year (Schedule 1, definition year)` FALSE EQUALS JUST TRUE
#ASSERT `the year is a calendar year (Schedule 1, definition year)` TRUE EQUALS NOTHING
-- Standards Association of Australia: for anything done on or after 1 July 1999 includes Standards Australia Limited
#ASSERT `a reference to the Standards Association of Australia includes a reference to Standards Australia Limited ACN 087 326 690 (Schedule 1, definition Standards Association of Australia)` (Date 1 7 1999) EQUALS JUST TRUE
#ASSERT `a reference to the Standards Association of Australia includes a reference to Standards Australia Limited ACN 087 326 690 (Schedule 1, definition Standards Association of Australia)` (Date 30 6 1999) EQUALS NOTHING
#ASSERT `the conviction is a spent conviction (Schedule 1, definition spent conviction)` TRUE FALSE EQUALS JUST TRUE
#ASSERT `the conviction is a spent conviction (Schedule 1, definition spent conviction)` TRUE TRUE EQUALS JUST FALSE
#ASSERT `the conviction is a spent conviction (Schedule 1, definition spent conviction)` FALSE FALSE EQUALS JUST FALSE
#ASSERT `the thing is a document (Schedule 1, definition document)` `a record of information, however recorded` EQUALS JUST TRUE
#ASSERT `the thing is a document (Schedule 1, definition document)` `a thing on which there is writing` EQUALS JUST TRUE
#ASSERT `the thing is a document (Schedule 1, definition document)` `a thing on which there are marks, symbols or perforations having a meaning for persons qualified to interpret them` EQUALS JUST TRUE
#ASSERT `the thing is a document (Schedule 1, definition document)` `an electronic document` EQUALS JUST TRUE
#ASSERT `the thing is a document (Schedule 1, definition document)` `anything else` EQUALS NOTHING
#ASSERT `the thing is an electronic document (Schedule 1, definition electronic document)` `a thing from which sounds, images or writings can be reproduced with or without the aid of anything else` EQUALS JUST TRUE
#ASSERT `the thing is an electronic document (Schedule 1, definition electronic document)` `a record of information reproduced from a thing of that kind` EQUALS JUST TRUE
#ASSERT `the thing is an electronic document (Schedule 1, definition electronic document)` `a record of information that exists in digital form and is capable of being reproduced, transmitted, stored or duplicated by electronic means` EQUALS JUST TRUE
#ASSERT `the thing is an electronic document (Schedule 1, definition electronic document)` `anything else` EQUALS JUST FALSE
#ASSERT `the thing is an instrument (Schedule 1, definition instrument)` TRUE EQUALS JUST TRUE
#ASSERT `the thing is an instrument (Schedule 1, definition instrument)` FALSE EQUALS JUST FALSE
