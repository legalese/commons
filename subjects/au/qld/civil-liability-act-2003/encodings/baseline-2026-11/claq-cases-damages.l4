IMPORT prelude
IMPORT `claq-dates`
IMPORT `claq-damages`

-- Civil Liability Act 2003 (Queensland) -- worked cases for the claimant's questions in claq-damages.l4 (chapter 3;
-- s 73; the Civil Liability Indexation Notice 2026; the Civil Liability Regulation 2025 sch 2). Every expected value is
-- worked by hand from the deposited texts, never copied from the encoding's output. Average weekly earnings and bond
-- rates below are invented round figures, not the published ones.
--
-- Unofficial version. Based on content from the Queensland Legislation website at 6 November 2026. (c) The State of
-- Queensland, CC BY 4.0. See SOURCE-LICENSE.md.
-- BASELINE ENCODING. Not for public use as advice. See NOTES.md.

§ `Cases: damages for personal injury`

`an injury day in 2026-2027` MEANS `the calendar day` 14 8 2026

-- ===================================================================================================================
§§ `ss 61, 62; Notice 2026 s 4`
-- (hand-worked from the table: base amount plus (ISV - band floor) x rate)
-- ===================================================================================================================

-- Item 1: ISV x $2,010.
#ASSERT `What are my general damages` 0 `an injury day in 2026-2027` EQUALS JUST 0
#ASSERT `What are my general damages` 1 `an injury day in 2026-2027` EQUALS JUST 2010
#ASSERT `What are my general damages` 5 `an injury day in 2026-2027` EQUALS JUST 10050
-- Item 2: 10,050 + (6 - 5) x 2,360 = 12,410; at 10: 10,050 + 5 x 2,360 = 21,850.
#ASSERT `What are my general damages` 6 `an injury day in 2026-2027` EQUALS JUST 12410
#ASSERT `What are my general damages` 10 `an injury day in 2026-2027` EQUALS JUST 21850
-- Item 3: 21,850 + 1 x 2,770 = 24,620.
#ASSERT `What are my general damages` 11 `an injury day in 2026-2027` EQUALS JUST 24620
-- Item 4 at 20: 35,700 + 5 x 3,150 = 51,450. Item 5 at 21: 51,450 + 3,530 = 54,980.
#ASSERT `What are my general damages` 20 `an injury day in 2026-2027` EQUALS JUST 51450
#ASSERT `What are my general damages` 21 `an injury day in 2026-2027` EQUALS JUST 54980
-- Item 6 at 30: 69,100 + 5 x 3,960 = 88,900. Item 7 at 35: 88,900 + 5 x 4,350 = 110,650.
#ASSERT `What are my general damages` 30 `an injury day in 2026-2027` EQUALS JUST 88900
#ASSERT `What are my general damages` 35 `an injury day in 2026-2027` EQUALS JUST 110650
-- Item 9 at 41: 134,350 + 5,110 = 139,460; at 45: 134,350 + 5 x 5,110 = 159,900.
#ASSERT `What are my general damages` 41 `an injury day in 2026-2027` EQUALS JUST 139460
#ASSERT `What are my general damages` 45 `an injury day in 2026-2027` EQUALS JUST 159900
-- Item 10 at 55: 185,450 + 5 x 5,450 = 212,700. Item 11 at 60 (the band's top): 185,450 + 10 x 5,450 = 239,950.
#ASSERT `What are my general damages` 55 `an injury day in 2026-2027` EQUALS JUST 212700
#ASSERT `What are my general damages` 60 `an injury day in 2026-2027` EQUALS JUST 239950
-- Item 13 at 85: 359,750 + 5 x 6,540 = 392,450. Item 14 at 91: 425,150 + 6,900 = 432,050; at 100: 425,150 + 10 x
-- 6,900 = 494,150, the most general damages can be.
#ASSERT `What are my general damages` 85 `an injury day in 2026-2027` EQUALS JUST 392450
#ASSERT `What are my general damages` 91 `an injury day in 2026-2027` EQUALS JUST 432050
#ASSERT `What are my general damages` 100 `an injury day in 2026-2027` EQUALS JUST 494150
-- Outside the scale (s 61(1)(a)), or not a whole number (Regulation sch 2 s 14): not covered.
#ASSERT `What are my general damages` 101 `an injury day in 2026-2027` EQUALS NOTHING
#ASSERT `What are my general damages` 10.5 `an injury day in 2026-2027` EQUALS NOTHING
#ASSERT `What are my general damages` (0 MINUS 1) `an injury day in 2026-2027` EQUALS NOTHING
-- s 62(4) "for the period within which the injury arose": the first and last days of 2026-2027, and the days either
-- side (other notices not deposited).
#ASSERT `What are my general damages` 10 (`the calendar day` 1 7 2026) EQUALS JUST 21850
#ASSERT `What are my general damages` 10 (`the calendar day` 30 6 2027) EQUALS JUST 21850
#ASSERT `What are my general damages` 10 (`the calendar day` 30 6 2026) EQUALS NOTHING
#ASSERT `What are my general damages` 10 (`the calendar day` 1 7 2027) EQUALS NOTHING
-- s 62(1) "an injury arising after 1 December 2002".
#ASSERT `What are my general damages` 10 (`the calendar day` 1 12 2002) EQUALS NOTHING

-- Regulation sch 2 s 4, dominant maximum 40: 50 is exactly 25% above (10 = 25% of 40), 51 is more.
#ASSERT `How must the court explain an uplift for multiple injuries` 40 40 EQUALS `no uplift: the value is not above the maximum for the dominant injury`
#ASSERT `How must the court explain an uplift for multiple injuries` 50 40 EQUALS `an uplift of no more than 25%: the court states the factors that justify it (Act s 61(2))`
#ASSERT `How must the court explain an uplift for multiple injuries` 51 40 EQUALS `an uplift of more than 25%: the court must give detailed written reasons (Regulation sch 2 s 4(4)), and should rarely do this`
#ASSERT `How must the court explain an uplift for multiple injuries` 101 90 EQUALS `not possible: an injury scale value cannot be more than 100 (Regulation sch 2 s 4(3)(a))`

-- ===================================================================================================================
§§ `ss 54-56`
-- ===================================================================================================================

-- AWE $1,800 (invented): 3 x 1,800 = 5,400 a week; 52 past weeks and a present value of 400 for the future weeks:
-- 5,400 x 452 = 2,440,800.
#ASSERT `What is the most I can get for loss of earnings` 1800 52 400 EQUALS 2440800
#ASSERT `What is the most I can get for loss of earnings` 1800 10 0 EQUALS 54000
#ASSERT `What is the most I can get for loss of earnings` 1800 0 0 EQUALS 0
-- s 56: 12% of $100,000 = $12,000; 11.5% = $11,500.
#ASSERT `What is the most I can get for lost superannuation` 100000 12 EQUALS 12000
#ASSERT `What is the most I can get for lost superannuation` 100000 11.5 EQUALS 11500

-- ===================================================================================================================
§§ `s 58; Notice 2026 s 3`
-- ===================================================================================================================

#ASSERT `Can I claim for loss of consortium or servitium` TRUE 0 (`the calendar day` 1 3 2030) EQUALS `yes, s 58(1) allows it: the injured person died as a result of the injuries (s 58(1)(a))`
#ASSERT `Can I claim for loss of consortium or servitium` FALSE 59300 (`the calendar day` 15 3 2027) EQUALS `yes, s 58(1) allows it: general damages, before contributory negligence, are at least the amount fixed for the year ($59,300 in 2026-2027) (s 58(1)(b))`
#ASSERT `Can I claim for loss of consortium or servitium` FALSE 59299 (`the calendar day` 15 3 2027) EQUALS `no: the injured person did not die and general damages are below the amount fixed for the year ($59,300 in 2026-2027) (s 58(1))`
#ASSERT `Can I claim for loss of consortium or servitium` FALSE 100000 (`the calendar day` 30 6 2026) EQUALS `not covered: the amount fixed for the financial year of the assessment is not held here (only 2026-2027)`
#ASSERT `Can I claim for loss of consortium or servitium` FALSE 100000 (`the calendar day` 1 7 2026) EQUALS `yes, s 58(1) allows it: general damages, before contributory negligence, are at least the amount fixed for the year ($59,300 in 2026-2027) (s 58(1)(b))`
-- s 58(3): 3 x $1,800 = $5,400 a week.
#ASSERT `What is the weekly limit for loss of servitium` 1800 EQUALS 5400

-- ===================================================================================================================
§§ `s 59`
-- ===================================================================================================================

#ASSERT `Can I claim for care given to me free` TRUE TRUE 6 6 FALSE EQUALS `yes, s 59 allows damages for the gratuitous services (without interest, s 60(1)(b)); the amount allows for any benefit to the carer and time I am in hospital or another institution (s 59(3))`
#ASSERT `Can I claim for care given to me free` TRUE TRUE 5.9 12 FALSE EQUALS `no: the services are not provided for at least 6 hours a week (s 59(1)(c)(i))`
#ASSERT `Can I claim for care given to me free` TRUE TRUE 20 5 FALSE EQUALS `no: the services are not provided for at least 6 months (s 59(1)(c)(ii))`
#ASSERT `Can I claim for care given to me free` TRUE TRUE 20 12 TRUE EQUALS `no: gratuitous services of the same kind were already being provided to me before the breach of duty (s 59(2))`
#ASSERT `Can I claim for care given to me free` FALSE TRUE 20 12 FALSE EQUALS `no: the services are not necessary (s 59(1)(a))`
#ASSERT `Can I claim for care given to me free` TRUE FALSE 20 12 FALSE EQUALS `no: the need for the services does not arise solely out of the injury (s 59(1)(b))`

-- ===================================================================================================================
§§ `ss 59A-59D, 85`
-- (arguments: dust, dust concluded before 2010, breach day, died, general damages, day assessed, recipient lived with
-- me, provided before, recipient incapable, six hours six months, respite, s 59 care also, MAI rehab also, recipient
-- recovered)
-- ===================================================================================================================

`a September 2026 assessment` MEANS `the calendar day` 1 9 2026

-- A parent hurt on 1 July 2010 who cared for a disabled child at home: every condition met.
#ASSERT `Can I claim for the care I can no longer give` FALSE FALSE (`the calendar day` 1 7 2010) FALSE 59300 `a September 2026 assessment` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS `yes, the court may award section 59A damages if satisfied (s 59A(2)); they are assessed on my life expectancy before the injury, and general damages do not also cover this loss (s 59C)`
-- s 85(3): the day before 1 July 2010.
#ASSERT `Can I claim for the care I can no longer give` FALSE FALSE (`the calendar day` 30 6 2010) FALSE 59300 `a September 2026 assessment` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS `no: for a claim that is not dust-related, section 59A damages are only for a breach of duty on or after 1 July 2010 (s 85(3))`
-- s 85(1): a dust-related claim, breach in 1990; s 85(2): one settled before the 2010 Act.
#ASSERT `Can I claim for the care I can no longer give` TRUE FALSE (`the calendar day` 1 1 1990) FALSE 80000 `a September 2026 assessment` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS `yes, the court may award section 59A damages if satisfied (s 59A(2)); they are assessed on my life expectancy before the injury, and general damages do not also cover this loss (s 59C)`
#ASSERT `Can I claim for the care I can no longer give` TRUE TRUE (`the calendar day` 1 1 1990) FALSE 80000 `a September 2026 assessment` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS `no: the dust-related claim was settled, discontinued or decided before the 2010 amendments (s 85(2))`
-- s 59A(2)(a): $1 under the threshold; and an assessment in 2027-2028 (no notice held); but death meets (a) any year.
#ASSERT `Can I claim for the care I can no longer give` FALSE FALSE (`the calendar day` 1 1 2020) FALSE 59299 `a September 2026 assessment` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS `no: I did not die of the injuries, and general damages are below the amount for s 58 ($59,300 in 2026-2027) (s 59A(2)(a))`
#ASSERT `Can I claim for the care I can no longer give` FALSE FALSE (`the calendar day` 1 1 2020) FALSE 90000 (`the calendar day` 1 7 2027) TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS `not covered: the s 58 amount for the financial year of the assessment is not held here (only 2026-2027)`
#ASSERT `Can I claim for the care I can no longer give` FALSE FALSE (`the calendar day` 1 1 2020) TRUE 0 (`the calendar day` 1 7 2027) TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS `yes, the court may award section 59A damages if satisfied (s 59A(2)); they are assessed on my life expectancy before the injury, and general damages do not also cover this loss (s 59C)`
-- s 59A(2)(b), 59B(1): a parent living elsewhere.
#ASSERT `Can I claim for the care I can no longer give` FALSE FALSE (`the calendar day` 1 1 2020) FALSE 90000 `a September 2026 assessment` FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS `no: the recipient did not live at my usual residence and was not my unborn child at the relevant time (ss 59A(2)(b), 59B(1))`
#ASSERT `Can I claim for the care I can no longer give` FALSE FALSE (`the calendar day` 1 1 2020) FALSE 90000 `a September 2026 assessment` TRUE FALSE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS `no: I did not provide the services to the recipient before the injury (s 59A(2)(c))`
#ASSERT `Can I claim for the care I can no longer give` FALSE FALSE (`the calendar day` 1 1 2020) FALSE 90000 `a September 2026 assessment` TRUE TRUE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS `no: the recipient is not incapable of performing the services because of age or incapacity (s 59A(2)(d))`
-- s 59A(3), (4): a child in the other parent's care alternate weeks.
#ASSERT `Can I claim for the care I can no longer give` FALSE FALSE (`the calendar day` 1 1 2020) FALSE 90000 `a September 2026 assessment` TRUE TRUE TRUE FALSE TRUE FALSE FALSE FALSE EQUALS `yes, the court may award section 59A damages because respite accommodation or care explains the shorter hours or period, if it considers this reasonable (s 59A(3), (4))`
#ASSERT `Can I claim for the care I can no longer give` FALSE FALSE (`the calendar day` 1 1 2020) FALSE 90000 `a September 2026 assessment` TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS `no: the hours, period or reasonable need required by s 59A(2)(e), (f) are not met`
-- s 59B(2), (3), (4).
#ASSERT `Can I claim for the care I can no longer give` FALSE FALSE (`the calendar day` 1 1 2020) FALSE 90000 `a September 2026 assessment` TRUE TRUE TRUE TRUE FALSE TRUE FALSE FALSE EQUALS `no, to that extent: care given to me under s 59 also provides the recipient with those services (s 59B(2))`
#ASSERT `Can I claim for the care I can no longer give` FALSE FALSE (`the calendar day` 1 1 2020) FALSE 90000 `a September 2026 assessment` TRUE TRUE TRUE TRUE FALSE FALSE TRUE FALSE EQUALS `no, to that extent: a motor accident insurer pays for rehabilitation services that provide the recipient with those services (s 59B(3))`
#ASSERT `Can I claim for the care I can no longer give` FALSE FALSE (`the calendar day` 1 1 2020) FALSE 90000 `a September 2026 assessment` TRUE TRUE TRUE TRUE FALSE FALSE FALSE TRUE EQUALS `no: the recipient has already recovered damages for this loss (s 59B(4))`

-- ===================================================================================================================
§§ `s 60`
-- ===================================================================================================================

#ASSERT `Can I get interest on these damages` `general damages` EQUALS `no: a court cannot order interest on general damages (s 60(1)(a))`
#ASSERT `Can I get interest on these damages` `damages for gratuitous services provided to me` EQUALS `no: a court cannot order interest on damages for gratuitous services provided to me (s 60(1)(b))`
#ASSERT `Can I get interest on these damages` `damages for past monetary loss (for example lost wages or medical expenses already paid)` EQUALS `yes, limited: no more than interest at the 10 year Treasury bond rate at the start of the quarter of the award, related to the period over which the loss was incurred (s 60(2), (3))`
#ASSERT `Can I get interest on these damages` `damages for future loss` EQUALS `s 60 does not deal with interest on damages for future loss`
-- The s 60 example: a = 4.5 (invented), m = $10,000, p = 2 years: 4.5 x 10,000 / 100 = 450; x 2 = 900; x 0.5 = 450.
#ASSERT `How much interest on past expenses incurred evenly` 4.5 10000 2 EQUALS 450
#ASSERT `How much interest on past expenses incurred evenly` 4 20000 0.5 EQUALS 200

-- ===================================================================================================================
§§ `ss 52, 52B, 52C`
-- ===================================================================================================================

#ASSERT `Can I get exemplary damages` `negligence or another act not done with intent to injure` EQUALS `no: a court cannot award exemplary, punitive or aggravated damages on a personal injury claim (s 52(1))`
#ASSERT `Can I get exemplary damages` `an unlawful intentional act done with intent to cause personal injury` EQUALS `s 52 does not prevent them: the injury was caused by an unlawful intentional act done with intent to cause personal injury (s 52(2)(a)); the court decides`
#ASSERT `Can I get exemplary damages` `an unlawful sexual assault or other unlawful sexual misconduct` EQUALS `s 52 does not prevent them: the injury was caused by an unlawful sexual assault or other unlawful sexual misconduct (s 52(2)(b)); the court decides`
#ASSERT `Can I get damages for treatment care and support` `not a participant` TRUE 0 TRUE EQUALS `s 52B does not apply: I am not, and was not, a participant in the scheme for a serious personal injury from the motor accident`
#ASSERT `Can I get damages for treatment care and support` `an interim participant (a participant, not a lifetime participant)` TRUE 0 TRUE EQUALS `no: a court cannot award damages for treatment, care and support needs arising while I am or was a participant (s 52B(2)); the scheme meets them`
-- s 52C(1)(c)(ii): a reduction "by less than 50%": 49 qualifies, 50 does not.
#ASSERT `Can I get damages for treatment care and support` `a lifetime participant` TRUE 49 TRUE EQUALS `yes, the court may award treatment, care and support damages, without reducing them for contributory negligence (s 52C)`
#ASSERT `Can I get damages for treatment care and support` `a lifetime participant` TRUE 50 TRUE EQUALS `no: a court cannot award damages for treatment, care and support needs arising while I am or was a participant (s 52B(2)); the scheme meets them`
#ASSERT `Can I get damages for treatment care and support` `a lifetime participant` TRUE 0 FALSE EQUALS `no: a court cannot award damages for treatment, care and support needs arising while I am or was a participant (s 52B(2)); the scheme meets them`
#ASSERT `Can I get damages for treatment care and support` `a lifetime participant` FALSE 0 TRUE EQUALS `no: a court cannot award damages for treatment, care and support needs arising while I am or was a participant (s 52B(2)); the scheme meets them`

-- ===================================================================================================================
§§ `s 53`
-- ===================================================================================================================

#ASSERT `Can a mitigation notice cut my damages` FALSE FALSE FALSE FALSE EQUALS `no notice: s 53(4) does not apply, but my ordinary duty to mitigate remains (s 53(3))`
#ASSERT `Can a mitigation notice cut my damages` TRUE TRUE FALSE FALSE EQUALS `no cut under s 53: I followed the suggestions in the notice`
#ASSERT `Can a mitigation notice cut my damages` TRUE FALSE FALSE FALSE EQUALS `no cut under s 53: the court considers my failure to follow the suggestions was reasonable`
#ASSERT `Can a mitigation notice cut my damages` TRUE FALSE TRUE FALSE EQUALS `yes: the court must reduce my damages to an appropriate extent, because my failure to follow the suggestions was not reasonable (s 53(4)(c))`
#ASSERT `Can a mitigation notice cut my damages` TRUE FALSE TRUE TRUE EQUALS `s 53(4) does not apply: leave to start my proceeding was given under the Personal Injuries Proceedings Act 2002 s 43(1) and not stayed because s 43(4) applied (s 53(5))`

-- ===================================================================================================================
§§ `ss 64, 66, 73; Notice 2026 s 5`
-- ===================================================================================================================

#ASSERT `Must the court tell me of the award first` 197770 (`the calendar day` 1 2 2027) EQUALS `no: the award for future loss is not more than the amount fixed for the year ($197,770 in 2026-2027) (s 64(2))`
#ASSERT `Must the court tell me of the award first` 197771 (`the calendar day` 1 2 2027) EQUALS `yes: the award for future loss is more than the amount fixed for the year ($197,770 in 2026-2027), so the court must first notify the parties of its terms, to let us negotiate a structured settlement (s 64)`
#ASSERT `Must the court tell me of the award first` 500000 (`the calendar day` 30 6 2027) EQUALS `yes: the award for future loss is more than the amount fixed for the year ($197,770 in 2026-2027), so the court must first notify the parties of its terms, to let us negotiate a structured settlement (s 64)`
#ASSERT `Must the court tell me of the award first` 500000 (`the calendar day` 1 7 2027) EQUALS `not covered: the amount fixed for the financial year of the decision is not held here (only 2026-2027)`
#ASSERT (`Must my lawyer advise me and will a jury hear my claim` TRUE TRUE TRUE)'s `my lawyer must advise me in writing about structured settlements and independent financial advice (s 66)`
#ASSERT (`Must my lawyer advise me and will a jury hear my claim` TRUE TRUE TRUE)'s `my claim is decided by a judge without a jury (s 73)`
#ASSERT NOT ((`Must my lawyer advise me and will a jury hear my claim` TRUE FALSE TRUE)'s `my lawyer must advise me in writing about structured settlements and independent financial advice (s 66)`)
#ASSERT NOT ((`Must my lawyer advise me and will a jury hear my claim` TRUE TRUE FALSE)'s `my lawyer must advise me in writing about structured settlements and independent financial advice (s 66)`)
#ASSERT NOT ((`Must my lawyer advise me and will a jury hear my claim` FALSE TRUE TRUE)'s `my claim is decided by a judge without a jury (s 73)`)
