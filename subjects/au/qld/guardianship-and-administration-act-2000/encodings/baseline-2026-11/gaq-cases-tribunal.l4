IMPORT prelude
IMPORT `gaq-common`
IMPORT `gaq-tribunal`

-- Guardianship and Administration Act 2000 (Queensland) -- worked cases for gaq-tribunal.l4 (ss 114B, 115, 118, 119,
-- 123-127, 146, 147, 156-158, 163, 164, 247-247C).
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Expected values were written by hand
-- from the deposited text (act-2000-008, in force from 2026-04-28), never copied from the encoding's output. No scenario
-- life raised this Act; the facts are the encoder's, HYPOTHETICAL throughout.
--
-- Unofficial version. Based on content from the Queensland Legislation website at 6 November 2026. (c) The State of
-- Queensland, CC BY 4.0. See SOURCE-LICENSE.md.
-- BASELINE ENCODING. Not for public use as advice. See NOTES.md.

GIVEN d IS A NUMBER, m IS A NUMBER, y IS A NUMBER
GIVETH A DATE
`dmy` d m y MEANS DATE_FROM_DMY d m y

§ `ss 114B, 115 -- applying`

#ASSERT `Can I apply to the tribunal question` `the adult (me)` EQUALS `yes: you may apply, and no tribunal fee is payable (ss 114B(1), 115(2)(a))`
#ASSERT `Can I apply to the tribunal question` `an interested person for the adult` EQUALS `yes: as an interested person you may apply, unless the Act says otherwise for the order sought, and no tribunal fee is payable (ss 114B(1), 115(2)(b))`
#ASSERT `Can I apply to the tribunal question` `someone else` EQUALS `no: s 115 lets only the adult or an interested person apply`
#ASSERT `Is my application free question` FALSE EQUALS TRUE
#ASSERT `Is my application free question` TRUE EQUALS FALSE

§ `s 118 -- notice of the hearing`

-- Hearing on Friday 20 November 2026: notice by 13 November 2026 (fork F2: 7 clear days would need 12 November).
#ASSERT `Last day to give me notice of the hearing question` (`dmy` 20 11 2026) 7 EQUALS `dmy` 13 11 2026
#ASSERT `Last day to give me notice of the hearing question` (`dmy` 5 1 2027) 7 EQUALS `dmy` 29 12 2026
#ASSERT `Last day to give me notice of the hearing question` (`dmy` 20 11 2026) 3 EQUALS `dmy` 17 11 2026
-- Argument order: excused, given, day given, hearing, reduced, reduced days.
#ASSERT `Was I given proper notice of the hearing question` FALSE TRUE (`dmy` 13 11 2026) (`dmy` 20 11 2026) FALSE 0 EQUALS `yes: you were given notice in time (s 118(1)); it is valid even if you did not understand it (s 118(5))`
#ASSERT `Was I given proper notice of the hearing question` FALSE TRUE (`dmy` 1 11 2026) (`dmy` 20 11 2026) FALSE 0 EQUALS `yes: you were given notice in time (s 118(1)); it is valid even if you did not understand it (s 118(5))`
#ASSERT `Was I given proper notice of the hearing question` FALSE TRUE (`dmy` 14 11 2026) (`dmy` 20 11 2026) FALSE 0 EQUALS `no: you were not given notice in time, so the hearing and the tribunal's decision are invalid (s 118(7))`
#ASSERT `Was I given proper notice of the hearing question` FALSE FALSE (`dmy` 1 1 2000) (`dmy` 20 11 2026) FALSE 0 EQUALS `no: you were not given notice in time, so the hearing and the tribunal's decision are invalid (s 118(7))`
-- The tribunal reduced the time to 3 days (s 118(6)(b)).
#ASSERT `Was I given proper notice of the hearing question` FALSE TRUE (`dmy` 17 11 2026) (`dmy` 20 11 2026) TRUE 3 EQUALS `yes: you were given notice in time (s 118(1)); it is valid even if you did not understand it (s 118(5))`
#ASSERT `Was I given proper notice of the hearing question` FALSE TRUE (`dmy` 18 11 2026) (`dmy` 20 11 2026) TRUE 3 EQUALS `no: you were not given notice in time, so the hearing and the tribunal's decision are invalid (s 118(7))`
#ASSERT `Was I given proper notice of the hearing question` TRUE FALSE (`dmy` 1 1 2000) (`dmy` 20 11 2026) FALSE 0 EQUALS `notice to you was not required: the tribunal considered it prejudicial to you, you were evading the hearing, or you were unconscious or could not be located (s 118(3))`

§ `ss 119, 123-125 -- taking part`

#ASSERT `Can I take part in the proceeding question` `the adult the proceeding is about` EQUALS `yes: you are an active party; you may appear in person, and be represented by a lawyer or agent with the tribunal's leave; if you are not represented the tribunal may appoint a representative for your views, wishes and interests (ss 119(a), 123, 124(1), 125(1))`
#ASSERT `Can I take part in the proceeding question` `the applicant` EQUALS `yes: you are an active party; you may appear in person, and be represented by a lawyer or agent with the tribunal's leave (ss 119, 123, 124(1))`
#ASSERT `Can I take part in the proceeding question` `the person proposed for appointment or reappointment` EQUALS `yes: you are an active party; you may appear in person, and be represented by a lawyer or agent with the tribunal's leave (ss 119, 123, 124(1))`
#ASSERT `Can I take part in the proceeding question` `a current guardian, administrator or attorney for the adult` EQUALS `yes: you are an active party; you may appear in person, and be represented by a lawyer or agent with the tribunal's leave (ss 119, 123, 124(1))`
#ASSERT `Can I take part in the proceeding question` `a person the tribunal joined as a party` EQUALS `yes: you are an active party; you may appear in person, and be represented by a lawyer or agent with the tribunal's leave (ss 119, 123, 124(1))`
#ASSERT `Can I take part in the proceeding question` `someone else` EQUALS `no: you are not an active party; the tribunal may join you as a party (s 119(g))`

§ `s 127 -- costs`

#ASSERT `Must I pay costs question` FALSE FALSE EQUALS `no: each party bears their own costs (s 127(1))`
#ASSERT `Must I pay costs question` TRUE FALSE EQUALS `no: each party bears their own costs (s 127(1))`
-- Only an applicant can be ordered to pay costs under s 127(2).
#ASSERT `Must I pay costs question` FALSE TRUE EQUALS `no: each party bears their own costs (s 127(1))`
#ASSERT `Must I pay costs question` TRUE TRUE EQUALS `you may have to: as the applicant, the tribunal may order you to pay an active party's costs and the tribunal's costs in exceptional circumstances, such as a frivolous or vexatious application (s 127(2))`

§ `ss 146, 147 -- a declaration about capacity`

-- A claimant who signed a release of a compensation claim while brain-injured.
#ASSERT `Can I get a declaration about my capacity question` `the adult (me)` TRUE EQUALS `yes: you may ask the tribunal to declare your capacity to enter the contract; the declaration is evidence of your capacity in a later proceeding about whether the contract is valid (ss 146, 147)`
#ASSERT `Can I get a declaration about my capacity question` `the adult (me)` FALSE EQUALS `yes: you may ask the tribunal to declare your capacity for the matter; it must look at every reasonable way of helping you communicate (s 146(1)-(3))`
#ASSERT `Can I get a declaration about my capacity question` `an interested person for the adult` TRUE EQUALS `yes: you may ask the tribunal to declare your capacity to enter the contract; the declaration is evidence of your capacity in a later proceeding about whether the contract is valid (ss 146, 147)`
#ASSERT `Can I get a declaration about my capacity question` `someone else` TRUE EQUALS `no: only the person concerned or an interested person may apply; the tribunal may still act on its own initiative (s 146(2))`

§ `ss 156-158 -- the decision`

#ASSERT `Must I be given the decision question` TRUE FALSE EQUALS `yes: you must be notified and given a copy of the decision as soon as practicable, and a copy of any written reasons (or told you may ask for them) (ss 156(2), (5), 158(3)); the tribunal may postpone this for up to 14 days at a time (s 157)`
#ASSERT `Must I be given the decision question` TRUE TRUE EQUALS `yes: you must be notified and given a copy of the decision as soon as practicable, and a copy of any written reasons (or told you may ask for them) (ss 156(2), (5), 158(3)); the tribunal may postpone this for up to 14 days at a time (s 157)`
#ASSERT `Must I be given the decision question` FALSE TRUE EQUALS `yes: you must be notified and given a copy of the decision as soon as practicable, and told you may ask for written reasons if it has none (s 156(2), (5)); you get the reasons themselves only on request (s 158(4))`
#ASSERT `Must I be given the decision question` FALSE FALSE EQUALS `you are not a relevant person, but you may ask for a copy of the decision and of any written reasons (ss 156(3), 158(4))`

§ `ss 163, 164 -- appeal`

#ASSERT `Can I appeal question` `the person whose capacity was considered (me)` FALSE EQUALS `yes: you are an eligible person and may appeal under the QCAT Act, taken to be a party (s 163(1), (3))`
#ASSERT `Can I appeal question` `the applicant` FALSE EQUALS `yes: you are an eligible person and may appeal under the QCAT Act, taken to be a party (s 163(1), (3))`
#ASSERT `Can I appeal question` `a person whose power as guardian, administrator or attorney the decision changed or removed` FALSE EQUALS `yes: you are an eligible person and may appeal under the QCAT Act, taken to be a party (s 163(1), (3))`
#ASSERT `Can I appeal question` `a person given leave to appeal` FALSE EQUALS `yes: you are an eligible person and may appeal under the QCAT Act, taken to be a party (s 163(1), (3))`
#ASSERT `Can I appeal question` `someone else` FALSE EQUALS `no: you are not an eligible person unless the appeal tribunal or the Court of Appeal gives you leave (s 163(3))`
#ASSERT `Can I appeal question` `the person whose capacity was considered (me)` TRUE EQUALS `no: a decision to make a limitation order under s 110 cannot be appealed (s 163(2))`
-- Postponement ended 10 December 2026; reasons dated 1 December: 28 days after 10 December is 7 January 2027.
#ASSERT `Last day to appeal after a postponement question` (`dmy` 10 12 2026) (`dmy` 1 12 2026) EQUALS `dmy` 7 1 2027
#ASSERT `Last day to appeal after a postponement question` (`dmy` 10 12 2026) (`dmy` 20 12 2026) EQUALS `dmy` 17 1 2027
#ASSERT `Last day to appeal after a postponement question` (`dmy` 10 12 2026) (`dmy` 10 12 2026) EQUALS `dmy` 7 1 2027
#ASSERT `Last day to appeal after a postponement question` (`dmy` 1 2 2028) (`dmy` 1 1 2028) EQUALS `dmy` 29 2 2028

§ `s 247 -- reporting`

#ASSERT `Am I protected for reporting question` TRUE TRUE EQUALS `yes: you are not liable civilly, criminally or under an administrative process for the disclosure; you have absolute privilege against defamation and breach no duty of confidence (s 247(1), (2)); your liability for your own conduct is unchanged (s 247(3))`
-- A report to the police or a newspaper is not to an "official" (s 247(4)).
#ASSERT `Am I protected for reporting question` FALSE TRUE EQUALS `no: s 247 protects only a disclosure to an official: a QCAT registry officer, the public guardian or staff, the public advocate or staff, or a community visitor (s 247(4))`
#ASSERT `Am I protected for reporting question` TRUE FALSE EQUALS `no: s 247 gives no protection on these facts: it needs an honest belief, on reasonable grounds, that the information shows (or would help investigate a complaint of) a contravention, or neglect, exploitation or abuse of an adult (s 247(1))`

§ `ss 247A-247C -- reprisal`

-- A care worker dismissed after reporting a resident's exploitation to the public guardian.
#ASSERT `Can I sue for a reprisal question` TRUE TRUE EQUALS `yes: the reprisal is a tort; you may sue the person who took it for damages, including exemplary damages, tried by a judge without a jury, whether or not they are prosecuted, and the Workers' Compensation and Rehabilitation Act 2003 does not apply (s 247C)`
#ASSERT `Can I sue for a reprisal question` FALSE TRUE EQUALS `no: s 247C gives damages only for a reprisal: detriment caused because of (as a substantial ground) a disclosure or intended disclosure under s 247(1) (s 247A)`
#ASSERT `Can I sue for a reprisal question` TRUE FALSE EQUALS `no: s 247C gives damages only to a person who suffers detriment as a result of the reprisal`
