§§ `reasons for a reviewable decision`
-- ===================================================================================================================

#ASSERT `By when must I ask the decision-maker for reasons` (`d` 1 3 2027) EQUALS `d` 15 3 2027
-- The 14th day is in time; the 15th is not; asking on the day of notice is in time.
#ASSERT `Can I ask the decision-maker for reasons` FALSE (`d` 1 3 2027) TRUE (`d` 15 3 2027) EQUALS JUST TRUE
#ASSERT `Can I ask the decision-maker for reasons` FALSE (`d` 1 3 2027) TRUE (`d` 16 3 2027) EQUALS JUST FALSE
#ASSERT `Can I ask the decision-maker for reasons` FALSE (`d` 1 3 2027) TRUE (`d` 1 3 2027) EQUALS JUST TRUE
#ASSERT `Can I ask the decision-maker for reasons` TRUE (`d` 1 3 2027) TRUE (`d` 2 3 2027) EQUALS JUST FALSE
#ASSERT `Can I ask the decision-maker for reasons` FALSE (`d` 1 3 2027) FALSE (`d` 2 3 2027) EQUALS JUST FALSE
#ASSERT `By when must the decision-maker give me reasons` (`d` 1 3 2027) EQUALS `d` 29 3 2027

-- ===================================================================================================================
§§ `starting a proceeding`
-- ===================================================================================================================

`no 159` MEANS `I have not applied for an order under s 159`
`any` MEANS `d` 1 1 2027

-- s 33(4)(a): the day notified.
#ASSERT `By when must I apply for review` FALSE (`d` 1 3 2027) FALSE `any` FALSE `any` `no 159` `any` `any` EQUALS JUST (`d` 29 3 2027)
-- s 33(4)(b): asked 5 March; given 20 March (earlier than 2 April) -> 17 April; not given -> 2 April -> 30 April; given
-- late on 10 April -> 2 April -> 30 April.
#ASSERT `By when must I apply for review` FALSE (`d` 1 3 2027) TRUE (`d` 5 3 2027) TRUE (`d` 20 3 2027) `no 159` `any` `any` EQUALS JUST (`d` 17 4 2027)
#ASSERT `By when must I apply for review` FALSE (`d` 1 3 2027) TRUE (`d` 5 3 2027) FALSE `any` `no 159` `any` `any` EQUALS JUST (`d` 30 4 2027)
#ASSERT `By when must I apply for review` FALSE (`d` 1 3 2027) TRUE (`d` 5 3 2027) TRUE (`d` 10 4 2027) `no 159` `any` `any` EQUALS JUST (`d` 30 4 2027)
-- s 33(4)(c): order made, statement due 15 May, given 1 May -> 29 May; not given -> 12 June; refused, told 7 June -> 5
-- July; undecided -> NOTHING; another Act's period -> NOTHING.
#ASSERT `By when must I apply for review` FALSE (`d` 1 3 2027) TRUE (`d` 5 3 2027) TRUE (`d` 1 5 2027) `the tribunal made the order` (`d` 15 5 2027) `any` EQUALS JUST (`d` 29 5 2027)
#ASSERT `By when must I apply for review` FALSE (`d` 1 3 2027) TRUE (`d` 5 3 2027) FALSE `any` `the tribunal made the order` (`d` 15 5 2027) `any` EQUALS JUST (`d` 12 6 2027)
#ASSERT `By when must I apply for review` FALSE (`d` 1 3 2027) TRUE (`d` 5 3 2027) FALSE `any` `the tribunal refused to make the order` `any` (`d` 7 6 2027) EQUALS JUST (`d` 5 7 2027)
#ASSERT `By when must I apply for review` FALSE (`d` 1 3 2027) TRUE (`d` 5 3 2027) FALSE `any` `the tribunal has not yet decided` `any` `any` EQUALS NOTHING
#ASSERT `By when must I apply for review` TRUE (`d` 1 3 2027) FALSE `any` FALSE `any` `no 159` `any` `any` EQUALS NOTHING

-- Am I in time: the 28th day, the 29th, an extension, an undecided s 159 application, another Act's period.
#ASSERT `Am I in time to apply for review` FALSE (`d` 1 3 2027) FALSE `any` FALSE `any` `no 159` `any` `any` (`d` 29 3 2027) FALSE `any` EQUALS JUST TRUE
#ASSERT `Am I in time to apply for review` FALSE (`d` 1 3 2027) FALSE `any` FALSE `any` `no 159` `any` `any` (`d` 30 3 2027) FALSE `any` EQUALS JUST FALSE
#ASSERT `Am I in time to apply for review` FALSE (`d` 1 3 2027) FALSE `any` FALSE `any` `no 159` `any` `any` (`d` 30 3 2027) TRUE (`d` 30 4 2027) EQUALS JUST TRUE
#ASSERT `Am I in time to apply for review` FALSE (`d` 1 3 2027) FALSE `any` FALSE `any` `no 159` `any` `any` (`d` 1 5 2027) TRUE (`d` 30 4 2027) EQUALS JUST FALSE
#ASSERT `Am I in time to apply for review` FALSE (`d` 1 3 2027) TRUE (`d` 5 3 2027) FALSE `any` `no 159` `any` `any` (`d` 30 4 2027) FALSE `any` EQUALS JUST TRUE
#ASSERT `Am I in time to apply for review` FALSE (`d` 1 3 2027) TRUE (`d` 5 3 2027) FALSE `any` `no 159` `any` `any` (`d` 1 5 2027) FALSE `any` EQUALS JUST FALSE
#ASSERT `Am I in time to apply for review` FALSE (`d` 1 3 2027) TRUE (`d` 5 3 2027) FALSE `any` `the tribunal has not yet decided` `any` `any` (`d` 1 5 2027) FALSE `any` EQUALS NOTHING
#ASSERT `Am I in time to apply for review` TRUE (`d` 1 3 2027) FALSE `any` FALSE `any` `no 159` `any` `any` (`d` 2 3 2027) FALSE `any` EQUALS NOTHING

-- s 35: rejection grounds, in order.
#ASSERT `Can my application be rejected` TRUE FALSE TRUE TRUE TRUE EQUALS `no: there is no ground to reject it (s 35(3), (8))`
#ASSERT `Can my application be rejected` FALSE TRUE TRUE TRUE TRUE EQUALS `yes, it may be rejected: you are not authorised to make it (s 35(3)(a)); if it is rejected, you may ask without fee that the decision be referred to the tribunal for review (s 35(4), (5))`
#ASSERT `Can my application be rejected` TRUE TRUE TRUE TRUE TRUE EQUALS `yes, it may be rejected: it was made after the period for making it expired (s 35(3)(b)); if it is rejected, you may ask without fee that the decision be referred to the tribunal for review (s 35(4), (5)), and the tribunal may extend the time (s 61)`
#ASSERT `Can my application be rejected` TRUE FALSE FALSE TRUE TRUE EQUALS `yes, it may be rejected: it does not otherwise comply with the Act, the enabling Act or the rules, for example the form, the reasons or the filing (ss 33(2), 35(3)(c)); if it is rejected, you may ask without fee that the decision be referred to the tribunal for review (s 35(4), (5))`
#ASSERT `Can my application be rejected` TRUE FALSE TRUE FALSE TRUE EQUALS `yes, it may be rejected: it does not otherwise comply with the Act, the enabling Act or the rules, for example the form, the reasons or the filing (ss 33(2), 35(3)(c)); if it is rejected, you may ask without fee that the decision be referred to the tribunal for review (s 35(4), (5))`

-- ss 36, 38.
#ASSERT `Has my proceeding started` FALSE TRUE TRUE EQUALS `not yet: a proceeding starts only when the principal registrar accepts the application (s 36)`
#ASSERT `Has my proceeding started` TRUE TRUE FALSE EQUALS `yes, it has started (s 36), but the tribunal must not take any action on it until you pay the prescribed fee (s 38)`
#ASSERT `Has my proceeding started` TRUE TRUE TRUE EQUALS `yes, it has started (s 36), and the tribunal may deal with it`
#ASSERT `Has my proceeding started` TRUE FALSE FALSE EQUALS `yes, it has started (s 36), and the tribunal may deal with it`

-- s 37.
#ASSERT `Must I give a copy of my application to the other party` FALSE FALSE FALSE
#ASSERT NOT (`Must I give a copy of my application to the other party` TRUE FALSE FALSE)
#ASSERT NOT (`Must I give a copy of my application to the other party` FALSE TRUE FALSE)
#ASSERT NOT (`Must I give a copy of my application to the other party` FALSE FALSE TRUE)

-- s 61.
#ASSERT `Can the tribunal extend my time` TRUE EQUALS JUST FALSE
#ASSERT `Can the tribunal extend my time` FALSE EQUALS JUST TRUE

-- ===================================================================================================================
§§ `representation`
-- ===================================================================================================================

`rep yes` MEANS `yes: you may be represented by that person (s 43(2)(b)); you may always appear for yourself instead (s 43(2)(a))`
`rep needs leave` MEANS `no, not without the tribunal's leave: you must appear for yourself unless you are a child or a person with impaired capacity, the proceeding is about disciplinary action, an Act or the rules allow representation, or the tribunal gives leave (s 43(1), (2)); the tribunal may weigh the complexity of the case, whether another party is represented and whether all parties agree (s 43(3))`

#ASSERT `Can I be represented` 30 FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS `rep needs leave`
#ASSERT `Can I be represented` 18 FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS `rep needs leave`
#ASSERT `Can I be represented` 17 FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS `rep yes`
#ASSERT `Can I be represented` 40 TRUE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS `rep yes`
#ASSERT `Can I be represented` 40 FALSE TRUE FALSE FALSE FALSE TRUE FALSE EQUALS `rep yes`
#ASSERT `Can I be represented` 40 FALSE FALSE TRUE FALSE FALSE TRUE FALSE EQUALS `rep yes`
#ASSERT `Can I be represented` 40 FALSE FALSE FALSE TRUE FALSE TRUE FALSE EQUALS `rep yes`
#ASSERT `Can I be represented` 40 FALSE FALSE FALSE TRUE TRUE TRUE FALSE EQUALS `no: that person is disqualified under the rules from representing a party (s 43(4)(a))`
#ASSERT `Can I be represented` 40 FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS `no: that person is not an Australian legal practitioner or government legal officer, and the tribunal is not satisfied they are an appropriate person to represent you (s 43(4)(b))`
#ASSERT `Can I be represented` 40 FALSE FALSE FALSE TRUE FALSE FALSE TRUE EQUALS `rep yes`

-- ===================================================================================================================
§§ `withdrawing, and starting again`
-- ===================================================================================================================

#ASSERT `Can I withdraw my application` TRUE FALSE EQUALS `no: an application can be withdrawn only before the matter is heard and decided (s 46(1))`
#ASSERT `Can I withdraw my application` FALSE TRUE EQUALS `only with the tribunal's leave: applications under the Child Protection Act 1999, the Disability Services Act 2006 s 178(9), the Guardianship and Administration Act 2000 and the Powers of Attorney Act 1998 can be withdrawn only with leave (s 46(2))`
#ASSERT `Can I withdraw my application` FALSE FALSE EQUALS `yes: you may withdraw it, in the way stated in the rules (s 46(1)); you then need the tribunal's leave to bring a further application on the same facts (s 46(3))`

#ASSERT `Can I bring the same claim again` `I withdrew it` TRUE EQUALS `yes: the tribunal gave you leave to make a further application on the same facts (s 46(3))`
#ASSERT `Can I bring the same claim again` `I withdrew it` FALSE EQUALS `no, not without the tribunal's leave: after withdrawing you need leave to make a further application relating to the same facts or circumstances (s 46(3))`
#ASSERT `Can I bring the same claim again` `it was dismissed or struck out under s 47 or s 48` TRUE EQUALS `yes: the president or deputy president gave you leave to start another proceeding of the same kind on the same matter, and may have extended the time limit (s 49(2)-(4))`
#ASSERT `Can I bring the same claim again` `it was dismissed or struck out under s 47 or s 48` FALSE EQUALS `no, not without the leave of the president or deputy president, given if the interests of justice require it (s 49(2), (3)); if the dismissal was an error, you may ask the tribunal to reinstate the proceeding (s 49(5), (6))`
#ASSERT `Can I bring the same claim again` `it ended another way` FALSE EQUALS `not covered: ss 46(3) and 49 deal only with a withdrawn application and a proceeding dismissed or struck out under s 47 or s 48`

-- ===================================================================================================================
§§ `decision by default`
-- ===================================================================================================================

`money` MEANS `a debt or liquidated demand of money`
`damages` MEANS `an amount consisting of or including unliquidated damages`

#ASSERT `Can I get a decision by default` `something else` TRUE TRUE TRUE TRUE EQUALS `no: a decision by default is only for a claim for a debt, a liquidated demand of money or unliquidated damages (ss 50(1)(a), 50A(1)(a))`
#ASSERT `Can I get a decision by default` `money` FALSE TRUE TRUE TRUE EQUALS `no: no Act or rule requires the respondent to respond within a stated period (ss 50(1)(b), 50A(1)(b))`
#ASSERT `Can I get a decision by default` `money` TRUE FALSE TRUE TRUE EQUALS `no: the respondent responded within the stated period (ss 50(1)(c), 50A(1)(c))`
#ASSERT `Can I get a decision by default` `money` TRUE TRUE FALSE TRUE EQUALS `not yet: you must first prove the respondent has been given a copy of the application (ss 50(5), 50A(6))`
#ASSERT `Can I get a decision by default` `money` TRUE TRUE TRUE TRUE EQUALS `yes: you may apply for a decision by default for no more than the amount claimed, interest at the rate the tribunal considers appropriate, and the costs the rules allow for minor civil disputes; the principal registrar may make it, and it is a final decision (s 50(2)(a), (b), (c)(i), (3), (4))`
#ASSERT `Can I get a decision by default` `money` TRUE TRUE TRUE FALSE EQUALS `yes: you may apply for a decision by default for no more than the amount claimed, interest at the rate the tribunal considers appropriate, the application fee and legal costs on the rules' scale; the principal registrar may make it, and it is a final decision (s 50(2)(a), (b), (c)(ii), (3), (4))`
#ASSERT `Can I get a decision by default` `damages` TRUE TRUE TRUE TRUE EQUALS `yes: you may apply for a decision by default conditional on the tribunal assessing the unliquidated damages, also claiming any liquidated amount, interest, the application fee and scale costs; if given, it is a final decision and the tribunal must assess the damages (s 50A(2)-(5))`
#ASSERT `Can I get a decision by default` `damages` TRUE TRUE FALSE FALSE EQUALS `not yet: you must first prove the respondent has been given a copy of the application (ss 50(5), 50A(6))`

-- ===================================================================================================================
§§ `settlement`
-- ===================================================================================================================

`settled by officer` MEANS `yes: the person presiding at the conference, or the conciliator or mediator, may record the terms and make the orders needed to give effect to the settlement, which have the effect of a tribunal decision (ss 84(2), 85(2), 88(1))`
`settled, filed` MEANS `yes: the signed terms have been filed, so the tribunal may make the orders needed to give effect to the settlement, which have the effect of a tribunal decision (ss 85(5), 88(1))`
`settled, 7 days passed` MEANS `yes: no party gave notice of withdrawing from the settlement within 7 days after the signed terms were filed, so the tribunal may make the orders needed to give effect to it, which have the effect of a tribunal decision (ss 86(3), 88(1))`
`settled, not filed` MEANS `no: the signed written terms of the settlement have not been filed in the registry (ss 85(4), (5), 86(2), (3))`
`settled, withdrawn` MEANS `no: a party gave notice of withdrawing from the settlement within 7 days after the signed terms were filed (s 86(3))`

#ASSERT `Can our settlement be made an order` `in a compulsory conference` FALSE `any` FALSE `any` TRUE EQUALS `settled by officer`
#ASSERT `Can our settlement be made an order` `in a compulsory conference` FALSE `any` FALSE `any` FALSE EQUALS `no: an order giving effect to a settlement may be made only if the tribunal could make a decision in those terms or terms consistent with them (s 87)`
#ASSERT `Can our settlement be made an order` `at conciliation or mediation conducted by a member, an adjudicator or the principal registrar` FALSE `any` FALSE `any` TRUE EQUALS `settled by officer`
#ASSERT `Can our settlement be made an order` `at conciliation or mediation conducted by someone else` TRUE (`d` 3 5 2027) FALSE `any` TRUE EQUALS `settled, filed`
#ASSERT `Can our settlement be made an order` `at conciliation or mediation conducted by someone else` FALSE `any` FALSE `any` TRUE EQUALS `settled, not filed`
#ASSERT `Can our settlement be made an order` `elsewhere` FALSE `any` FALSE `any` TRUE EQUALS `settled, not filed`
-- Filed 3 May 2027: notice on 10 May (the 7th day) is in time; on 11 May it is not; on the day of filing it is.
#ASSERT `Can our settlement be made an order` `elsewhere` TRUE (`d` 3 5 2027) TRUE (`d` 10 5 2027) TRUE EQUALS `settled, withdrawn`
#ASSERT `Can our settlement be made an order` `elsewhere` TRUE (`d` 3 5 2027) TRUE (`d` 11 5 2027) TRUE EQUALS `settled, 7 days passed`
#ASSERT `Can our settlement be made an order` `elsewhere` TRUE (`d` 3 5 2027) TRUE (`d` 3 5 2027) TRUE EQUALS `settled, withdrawn`
#ASSERT `Can our settlement be made an order` `elsewhere` TRUE (`d` 3 5 2027) FALSE `any` TRUE EQUALS `settled, 7 days passed`
#ASSERT `Can our settlement be made an order` `elsewhere` TRUE (`d` 3 5 2027) FALSE `any` FALSE EQUALS `no: an order giving effect to a settlement may be made only if the tribunal could make a decision in those terms or terms consistent with them (s 87)`
#ASSERT `By when can a party withdraw from our settlement` (`d` 3 5 2027) EQUALS `d` 10 5 2027

#ASSERT `What can I ask for if an accepted offer is not kept` FALSE TRUE TRUE FALSE EQUALS `nothing under s 89: it applies only where you accepted an offer to settle and the party who made it has not complied with its terms (s 89(1), (2))`
#ASSERT `What can I ask for if an accepted offer is not kept` TRUE FALSE TRUE FALSE EQUALS `nothing under s 89: it applies only where you accepted an offer to settle and the party who made it has not complied with its terms (s 89(1), (2))`
#ASSERT `What can I ask for if an accepted offer is not kept` TRUE TRUE TRUE FALSE EQUALS `you may apply for an order giving effect to the terms of the offer, or an order awarding you any or all of the things you asked for in the proceeding (s 89(2)(a), (c))`
#ASSERT `What can I ask for if an accepted offer is not kept` TRUE TRUE FALSE TRUE EQUALS `you may apply for an order giving effect to the terms of the offer, dismissal of the proceeding, or an order awarding you any or all of the things asked for in your response (s 89(2)(a), (b))`
#ASSERT `What can I ask for if an accepted offer is not kept` TRUE TRUE FALSE FALSE EQUALS `you may apply for an order giving effect to the terms of the offer, or dismissal of the proceeding (s 89(2)(a), (b)(i))`

-- ===================================================================================================================
§§ `costs`
-- ===================================================================================================================

`child, no costs` MEANS `no: the tribunal must not award costs against a child (s 101(1)); a representative of yours may still be ordered to pay costs they caused (ss 101(2), 103)`

#ASSERT `Can I be ordered to pay the other party's costs` 17 FALSE FALSE TRUE EQUALS `child, no costs`
#ASSERT `Can I be ordered to pay the other party's costs` 17 TRUE FALSE TRUE EQUALS `child, no costs`
#ASSERT `Can I be ordered to pay the other party's costs` 18 TRUE FALSE TRUE EQUALS `not covered: the enabling Act provides for costs in this proceeding, and this encoding reads this Act alone (s 100)`
#ASSERT `Can I be ordered to pay the other party's costs` 18 FALSE TRUE FALSE EQUALS `no: each party bears their own costs (s 100), unless the tribunal considers the interests of justice require a costs order (s 102(1))`
#ASSERT `Can I be ordered to pay the other party's costs` 18 FALSE TRUE TRUE EQUALS `yes, if the tribunal considers the interests of justice require it, but in a minor civil dispute only the costs the rules allow for minor civil disputes (s 102(1), (2))`
#ASSERT `Can I be ordered to pay the other party's costs` 45 FALSE FALSE TRUE EQUALS `yes, if the tribunal considers the interests of justice require it: all or a stated part of the other party's costs (s 102(1)), fixed by the tribunal where possible or assessed under the rules (s 107)`

#ASSERT `Can I be ordered to give security for costs` 17 TRUE EQUALS `not covered: costs cannot be awarded against a child (s 101(1)), and s 109 does not say whether security can still be ordered`
#ASSERT `Can I be ordered to give security for costs` 18 FALSE EQUALS `no: only a party against whom a claim is made, or an outcome or decision sought, may apply for security (s 109(2))`
#ASSERT `Can I be ordered to give security for costs` 18 TRUE EQUALS `yes: on the other party's application, the tribunal may order you to give security for their costs within a stated period and stay the proceeding until you do; if you do not, it may dismiss the proceeding (s 109(2), (3)); it may weigh your finances and the merits and genuineness of your claim (s 109(4))`

-- ===================================================================================================================
§§ `the decision and its reasons`
-- ===================================================================================================================

`reasons in 45 days` MEANS `yes: the tribunal must give you written reasons within 45 days after your request, or a longer period the president allows (s 122(2), (3))`
`reasons late` MEANS `no: a request must be made within 14 days after the decision takes effect (ss 122(2), 127)`

#ASSERT `Can I ask the tribunal for written reasons` TRUE (`d` 1 3 2027) FALSE `any` (`d` 2 3 2027) FALSE EQUALS `no: the tribunal has already given written reasons for the decision (s 122(1))`
#ASSERT `Can I ask the tribunal for written reasons` FALSE (`d` 1 3 2027) FALSE `any` (`d` 15 3 2027) FALSE EQUALS `reasons in 45 days`
#ASSERT `Can I ask the tribunal for written reasons` FALSE (`d` 1 3 2027) FALSE `any` (`d` 16 3 2027) FALSE EQUALS `reasons late`
-- A decision made 1 March stating that it takes effect 10 March: the 14 days run from 10 March (s 127(b)).
#ASSERT `Can I ask the tribunal for written reasons` FALSE (`d` 1 3 2027) TRUE (`d` 10 3 2027) (`d` 24 3 2027) FALSE EQUALS `reasons in 45 days`
#ASSERT `Can I ask the tribunal for written reasons` FALSE (`d` 1 3 2027) TRUE (`d` 10 3 2027) (`d` 25 3 2027) FALSE EQUALS `reasons late`
#ASSERT `Can I ask the tribunal for written reasons` FALSE (`d` 1 3 2027) FALSE `any` (`d` 5 3 2027) TRUE EQUALS `yes, you may ask, but for this kind of procedural decision the tribunal is not required to give written reasons (s 122(4))`
#ASSERT `Can I ask the tribunal for written reasons` FALSE (`d` 1 3 2027) FALSE `any` (`d` 20 3 2027) TRUE EQUALS `reasons late`

#ASSERT `By when must I ask the tribunal for written reasons` (`d` 1 3 2027) FALSE `any` EQUALS `d` 15 3 2027
#ASSERT `By when must I ask the tribunal for written reasons` (`d` 20 12 2027) TRUE (`d` 31 12 2027) EQUALS `d` 14 1 2028
#ASSERT `By when must the tribunal give me written reasons` (`d` 1 3 2027) EQUALS `d` 15 4 2027

-- ===================================================================================================================
§§ `enforcing and renewing`
-- ===================================================================================================================

`money order` MEANS `file a copy of the decision in the registry of a court of competent jurisdiction; it is then a money order of that court and is enforced as one (s 131)`
`magistrates` MEANS `file a copy of the decision in the registry of a Magistrates Court; it is then a non-money order of that court and is enforced as one (s 132(2), (3), (6)(a))`
`supreme` MEANS `file a copy of the decision in the registry of the Supreme Court; it is then a non-money order of that court and is enforced as one (s 132(2), (3), (6)(b))`

#ASSERT `How do I enforce the tribunal's decision` `the final decision in the proceeding` TRUE TRUE EQUALS `money order`
#ASSERT `How do I enforce the tribunal's decision` `the final decision in the proceeding` TRUE FALSE EQUALS `money order`
#ASSERT `How do I enforce the tribunal's decision` `the final decision in the proceeding` FALSE TRUE EQUALS `magistrates`
#ASSERT `How do I enforce the tribunal's decision` `the final decision in the proceeding` FALSE FALSE EQUALS `supreme`
#ASSERT `How do I enforce the tribunal's decision` `a monetary decision that is not part of the final decision` FALSE FALSE EQUALS `money order`
#ASSERT `How do I enforce the tribunal's decision` `an injunction under s 59` FALSE TRUE EQUALS `magistrates`
#ASSERT `How do I enforce the tribunal's decision` `an interim order under s 58` FALSE FALSE EQUALS `supreme`
#ASSERT `How do I enforce the tribunal's decision` `another decision` TRUE TRUE EQUALS `not covered: part 7, division 4 enforces final decisions, interim orders, injunctions and monetary decisions (s 129)`

#ASSERT `What is the last day to bring an action on the decision` (`d` 15 6 2027) FALSE `any` EQUALS `d` 15 6 2039
#ASSERT `What is the last day to bring an action on the decision` (`d` 1 2 2028) TRUE (`d` 29 2 2028) EQUALS `d` 29 2 2040
#ASSERT `What is the last day to bring an action on the decision` (`d` 1 1 2088) TRUE (`d` 29 2 2088) EQUALS `d` 28 2 2100

#ASSERT `Can I apply to renew the decision` FALSE FALSE FALSE FALSE EQUALS `no: renewal is only where the decision cannot be complied with, or there are problems interpreting, implementing or enforcing it (s 133(1))`
#ASSERT `Can I apply to renew the decision` TRUE FALSE FALSE FALSE EQUALS `yes: you may apply to the tribunal to renew the final decision, in the approved form, stating your reasons, filed within the period in the rules, with a copy to each other party (s 133(2)-(4)); the tribunal may make the same decision or another it could have made (s 134(2))`
#ASSERT `Can I apply to renew the decision` FALSE TRUE FALSE FALSE EQUALS `yes: you may apply to the tribunal to renew the final decision, in the approved form, stating your reasons, filed within the period in the rules, with a copy to each other party (s 133(2)-(4)); the tribunal may make the same decision or another it could have made (s 134(2))`
#ASSERT `Can I apply to renew the decision` TRUE FALSE TRUE FALSE EQUALS `no: the decision is the subject of an appeal or an application for leave to appeal, decided or not (s 133(6), (7))`
#ASSERT `Can I apply to renew the decision` TRUE FALSE FALSE TRUE EQUALS `no: a renewed final decision cannot be renewed again (s 134(4))`

-- ===================================================================================================================
§§ `reopening`
-- ===================================================================================================================

#ASSERT `Can I apply to reopen my proceeding` TRUE TRUE TRUE FALSE FALSE FALSE EQUALS `no: reopening is not available for an appeal to the appeal tribunal (s 136)`
#ASSERT `Can I apply to reopen my proceeding` FALSE FALSE TRUE FALSE FALSE FALSE EQUALS `no: the proceeding has not yet been heard and decided (s 136)`
#ASSERT `Can I apply to reopen my proceeding` FALSE TRUE TRUE FALSE FALSE TRUE EQUALS `no: the proceeding has already been reopened once and cannot be reopened again (s 140(6))`
#ASSERT `Can I apply to reopen my proceeding` FALSE TRUE TRUE FALSE TRUE FALSE EQUALS `no: the decision is the subject of an appeal or an application for leave to appeal, decided or not (s 138(5), (6))`
#ASSERT `Can I apply to reopen my proceeding` FALSE TRUE TRUE FALSE FALSE FALSE EQUALS `yes: you did not appear at the hearing and had a reasonable excuse (schedule 3, reopening ground (a)); apply within the period in the rules, stating the ground, with the prescribed fee and a copy to each other party (s 138(2)-(4)); the tribunal grants it only if the ground exists and could be dealt with by reopening, and its decision is final (s 139(4), (5))`
#ASSERT `Can I apply to reopen my proceeding` FALSE TRUE FALSE TRUE FALSE FALSE EQUALS `yes: significant new evidence, not reasonably available when the proceeding was first heard and decided, means you would suffer a substantial injustice if it were not reopened (schedule 3, reopening ground (b)); apply within the period in the rules, stating the ground, with the prescribed fee and a copy to each other party (s 138(2)-(4)); the tribunal grants it only if the ground exists and could be dealt with by reopening, and its decision is final (s 139(4), (5))`
#ASSERT `Can I apply to reopen my proceeding` FALSE TRUE FALSE FALSE FALSE FALSE EQUALS `no: you have no reopening ground: neither a reasonable excuse for missing the hearing, nor significant new evidence that was not reasonably available (s 138(1); schedule 3)`

-- ===================================================================================================================
§§ `does the decision keep operating`
-- ===================================================================================================================

#ASSERT `Does the decision keep operating` `an application for review of a reviewable decision` FALSE TRUE EQUALS NOTHING
#ASSERT `Does the decision keep operating` `an application for review of a reviewable decision` FALSE FALSE EQUALS JUST TRUE
#ASSERT `Does the decision keep operating` `an application for review of a reviewable decision` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Does the decision keep operating` `the respondent's application to set aside a decision by default` FALSE FALSE EQUALS JUST TRUE
#ASSERT `Does the decision keep operating` `an application to reopen the proceeding` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Does the decision keep operating` `an appeal to the appeal tribunal` FALSE TRUE EQUALS JUST TRUE
#ASSERT `Does the decision keep operating` `an appeal to the Court of Appeal` TRUE FALSE EQUALS JUST FALSE

-- ===================================================================================================================
§§ `appeals to the appeal tribunal`
-- ===================================================================================================================

`law` MEANS `a question of law only`
`fact` MEANS `a question of fact, or of mixed law and fact`
`final` MEANS `the final decision`
`at no leave` MEANS `yes: you may appeal to the appeal tribunal without leave (s 142(1))`
`at leave` MEANS `yes, but only with the appeal tribunal's leave: you must first apply for leave to appeal (s 142(3))`
`at excluded` MEANS `no: a decision under s 35, a decision under s 51 to set aside a decision by default, and a cost-amount decision cannot be appealed to the appeal tribunal (s 142(2)); a cost-amount decision may go to the Court of Appeal (s 149(1))`

#ASSERT `Can I appeal to the appeal tribunal` FALSE `final` FALSE `law` FALSE EQUALS `at no leave`
#ASSERT `Can I appeal to the appeal tribunal` FALSE `final` TRUE `law` FALSE EQUALS `at leave`
#ASSERT `Can I appeal to the appeal tribunal` FALSE `a decision that is not the final decision` FALSE `law` FALSE EQUALS `at leave`
#ASSERT `Can I appeal to the appeal tribunal` FALSE `a costs order` FALSE `law` FALSE EQUALS `at leave`
#ASSERT `Can I appeal to the appeal tribunal` FALSE `final` FALSE `fact` FALSE EQUALS `at leave`
#ASSERT `Can I appeal to the appeal tribunal` TRUE `final` FALSE `law` FALSE EQUALS `no: a judicial member constituted the tribunal, so an appeal lies to the Court of Appeal instead (ss 142(1), 149(2))`
#ASSERT `Can I appeal to the appeal tribunal` FALSE `a decision under s 35 about accepting or rejecting an application` FALSE `law` FALSE EQUALS `at excluded`
#ASSERT `Can I appeal to the appeal tribunal` FALSE `a decision under s 51 to set aside a decision by default` FALSE `law` FALSE EQUALS `at excluded`
#ASSERT `Can I appeal to the appeal tribunal` FALSE `a cost-amount decision` FALSE `law` FALSE EQUALS `at excluded`
#ASSERT `Can I appeal to the appeal tribunal` TRUE `a decision under s 35 about accepting or rejecting an application` FALSE `law` FALSE EQUALS `at excluded`
#ASSERT `Can I appeal to the appeal tribunal` FALSE `a decision under s 139 on an application to reopen` FALSE `law` FALSE EQUALS `no: the tribunal's decision on an application to reopen is final and cannot be appealed (s 139(5))`
#ASSERT `Can I appeal to the appeal tribunal` FALSE `the appeal tribunal's final decision in an appeal` FALSE `law` FALSE EQUALS `no: a decision of the appeal tribunal is appealed to the Court of Appeal, not to the appeal tribunal (ss 142(1), 150)`
#ASSERT `Can I appeal to the appeal tribunal` FALSE `final` TRUE `law` TRUE EQUALS `not yet: no appeal or application for leave to appeal against the final decision until your application to reopen is finally dealt with (s 141)`
#ASSERT `Can I appeal to the appeal tribunal` FALSE `a costs order` FALSE `law` TRUE EQUALS `at leave`

`none made` MEANS `I made none within 28 days after getting written reasons`
`leave application` MEANS `an application for leave to appeal`
`appeal without leave` MEANS `an appeal that does not need leave`
`appeal after leave` MEANS `an appeal that needs leave, after leave was given`

