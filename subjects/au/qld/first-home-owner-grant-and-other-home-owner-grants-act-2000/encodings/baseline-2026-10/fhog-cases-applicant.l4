-- =====================================================================================================================
-- PLUMBING (no rule)
-- =====================================================================================================================

-- The twenty transaction answers. Fixed here: in Queensland, a building fixed to land, lawful and suitable to live in;
-- no s 5(4) scheme and no option before 1 July 2000. Varied: the rest.
GIVEN `kind`          IS A `Kind of transaction`
      `lived in`      IS A BOOLEAN
      `GST new`       IS A BOOLEAN
      `lived in since renovation` IS A BOOLEAN
      `land with home` IS A BOOLEAN
      `owns land`     IS A BOOLEAN
      `commenced`     IS A DATE
      `price`         IS A NUMBER
      `home value`    IS A NUMBER
      `land value`    IS A NUMBER
      `replaces`      IS A BOOLEAN
      `satisfied`     IS A BOOLEAN
      `scheme 25EA`   IS A BOOLEAN
GIVETH A `My transaction answer`
`transaction for` `kind` `lived in` `GST new` `lived in since renovation` `land with home` `owns land` `commenced` `price` `home value` `land value` `replaces` `satisfied` `scheme 25EA` MEANS
    `Is my purchase or build an eligible transaction` `kind` TRUE TRUE TRUE TRUE `lived in` `GST new` `lived in since renovation` `land with home` `owns land` `commenced` `price` `home value` `land value` FALSE FALSE `replaces` FALSE `satisfied` `scheme 25EA`

GIVEN `kind`          IS A `Kind of transaction`
      `lived in`      IS A BOOLEAN
      `GST new`       IS A BOOLEAN
      `lived in since renovation` IS A BOOLEAN
      `land with home` IS A BOOLEAN
      `owns land`     IS A BOOLEAN
      `commenced`     IS A DATE
      `price`         IS A NUMBER
      `home value`    IS A NUMBER
      `land value`    IS A NUMBER
      `replaces`      IS A BOOLEAN
      `satisfied`     IS A BOOLEAN
      `scheme 25EA`   IS A BOOLEAN
GIVETH AN `Amount answer`
`amount for` `kind` `lived in` `GST new` `lived in since renovation` `land with home` `owns land` `commenced` `price` `home value` `land value` `replaces` `satisfied` `scheme 25EA` MEANS
    `How much is the grant for my home` `kind` TRUE TRUE TRUE TRUE `lived in` `GST new` `lived in since renovation` `land with home` `owns land` `commenced` `price` `home value` `land value` FALSE FALSE `replaces` FALSE `satisfied` `scheme 25EA`

-- The twenty-four applicant answers for a person with no exemption, no earlier grant (own or partner's) and no
-- pre-2000 interest. Varied: individual, age, status, joint, other's status, the own and partner's post-2000 home,
-- and the relationship.
GIVEN `individual`    IS A BOOLEAN
      `age`           IS A NUMBER
      `status`        IS A `Citizenship or residence`
      `joint`         IS A BOOLEAN
      `other PR`      IS A BOOLEAN
      `own home since 2000` IS A BOOLEAN
      `rel`           IS A `Relationship`
      `together`      IS A BOOLEAN
      `years`         IS A NUMBER
      `partner home since 2000` IS A BOOLEAN
GIVETH A `Criteria answer`
`criteria for` `individual` `age` `status` `joint` `other PR` `own home since 2000` `rel` `together` `years` `partner home since 2000` MEANS
    `Do I meet eligibility criteria 1 to 4` `individual` `age` FALSE `status` `joint` `other PR` FALSE FALSE FALSE FALSE `own home since 2000` FALSE `rel` `together` `years` FALSE FALSE FALSE FALSE FALSE FALSE FALSE `partner home since 2000` FALSE

-- The fifty-eight payable answers. Fixed: Queensland, fixed, lawful, suitable, never lived in, no schemes or options;
-- an individual, no age exemption, no earlier grant or pre-2000 interest (own or partner's), not living apart; no
-- Regulation r 2(1) or Pathways owner. `complete` answers possession, title registered, ready and certificate alike.
GIVEN `kind`          IS A `Kind of transaction`
      `land with home` IS A BOOLEAN
      `owns land`     IS A BOOLEAN
      `commenced`     IS A DATE
      `price`         IS A NUMBER
      `home value`    IS A NUMBER
      `land value`    IS A NUMBER
      `complete`      IS A BOOLEAN
      `age`           IS A NUMBER
      `status`        IS A `Citizenship or residence`
      `joint`         IS A BOOLEAN
      `other PR`      IS A BOOLEAN
      `other meets`   IS A BOOLEAN
      `rel`           IS A `Relationship`
      `years`         IS A NUMBER
      `partner home since 2000` IS A BOOLEAN
      `owner not applying` IS A BOOLEAN
      `already paid`  IS A BOOLEAN
      `s 69A`         IS A BOOLEAN
GIVETH A `Payable answer`
`payable for` `kind` `land with home` `owns land` `commenced` `price` `home value` `land value` `complete` `age` `status` `joint` `other PR` `other meets` `rel` `years` `partner home since 2000` `owner not applying` `already paid` `s 69A` MEANS
    `Is the grant payable on my application` `kind` TRUE TRUE TRUE TRUE FALSE FALSE FALSE `land with home` `owns land` `commenced` `price` `home value` `land value` FALSE FALSE FALSE FALSE FALSE FALSE `complete` TRUE `complete` `complete` `complete` TRUE `age` FALSE `status` `joint` `other PR` FALSE FALSE FALSE FALSE FALSE FALSE `rel` TRUE `years` FALSE FALSE FALSE FALSE FALSE FALSE FALSE `partner home since 2000` FALSE `other meets` `owner not applying` FALSE FALSE FALSE FALSE FALSE `already paid` `s 69A`

-- The residence answers. Fixed: no s 15(2)(b) exemption, no s 15(4) exemption.
GIVEN `completion`    IS A DATE
      `shorter`       IS A BOOLEAN
      `months`        IS A NUMBER
      `longer`        IS A BOOLEAN
      `longer last day` IS A DATE
      `moved in`      IS A BOOLEAN
      `in day`        IS A DATE
      `moved out`     IS A BOOLEAN
      `out day`       IS A DATE
      `asked`         IS A DATE
GIVETH A `Residence answer`
`residence for` `completion` `shorter` `months` `longer` `longer last day` `moved in` `in day` `moved out` `out day` `asked` MEANS
    `Have I met the residence requirements` `completion` FALSE `shorter` `months` `longer` `longer last day` FALSE FALSE `moved in` `in day` `moved out` `out day` `asked`

-- =====================================================================================================================
-- CASE 1. Mia, 27, an Australian citizen with no partner, buys a new apartment off the plan in Brisbane. HYPOTHETICAL:
-- contract made 15 September 2026, price $640,000; the developer builds it before settlement; the apartment is valued
-- at $420,000 and her interest in the land at $220,000. Settlement (completion) 20 March 2028.
-- =====================================================================================================================

-- s 5(1)(a), (3)(b): a contract for a relevant interest in land on which a new home is to be built by the vendor.
-- s 6(2)(a): never occupied or sold as a residence. s 5(6): $640,000 < $750,000. s 5(7): $420,000 + $220,000 =
-- $640,000 < $750,000. Eligible.
#ASSERT `transaction for` `a contract to buy a home` FALSE FALSE FALSE TRUE FALSE `15 Sep 2026` 640000 420000 220000 FALSE FALSE FALSE EQUALS `yes, it is an eligible transaction for a new home (s 5(1))`
-- s 20(1): commencement on or after 1 July 2026, so s 20 as deposited: the lesser of $640,000 and $30,000 = $30,000.
#ASSERT `amount for` `a contract to buy a home` FALSE FALSE FALSE TRUE FALSE `15 Sep 2026` 640000 420000 220000 FALSE FALSE FALSE EQUALS `the grant is` 30000
-- ss 11 to 14: 27 >= 18, a citizen, no earlier grant or home, no partner.
#ASSERT `criteria for` TRUE 27 `an Australian citizen` FALSE FALSE FALSE `no partner` FALSE 0 FALSE EQUALS `meets criteria 1 to 4`
-- s 10(1): eligible, criteria 1 to 4 met; after settlement (possession and title registered) completed: payable
-- subject to criterion 5 (s 15), which s 22 lets the commissioner pay in anticipation of.
#ASSERT `payable for` `a contract to buy a home` TRUE FALSE `15 Sep 2026` 640000 420000 220000 TRUE 27 `an Australian citizen` FALSE FALSE FALSE `no partner` 0 FALSE FALSE FALSE FALSE EQUALS `payable, subject to the residence requirements (s 15), which the commissioner may pay in anticipation of (s 22)`
-- Before settlement: s 10(1)(b)(ii) not met; s 19(2) early payment is the commissioner's.
#ASSERT `payable for` `a contract to buy a home` TRUE FALSE `15 Sep 2026` 640000 420000 220000 FALSE 27 `an Australian citizen` FALSE FALSE FALSE `no partner` 0 FALSE FALSE FALSE FALSE EQUALS `not yet payable: the transaction is not completed, unless the commissioner authorises payment before completion (s 19(2))`
-- Schedule, completed (a): possession, and the title registered.
#ASSERT `Has my purchase or build been completed` `a contract to buy a home` TRUE TRUE TRUE FALSE FALSE
#ASSERT (NOT (`Has my purchase or build been completed` `a contract to buy a home` TRUE TRUE FALSE FALSE FALSE))
-- s 16(3)(b): the application period ends 1 year after completion: 20 March 2029.
#ASSERT `What is the last day I can apply` `20 Mar 2028` EQUALS `20 Mar 2029`
-- s 16(3)(a): from the commencement date (15 September 2026): 1 October 2026 is in; 10 September 2026 is before it.
#ASSERT `Can I apply on this day` `1 Oct 2026` `15 Sep 2026` `20 Mar 2028` FALSE
#ASSERT (NOT (`Can I apply on this day` `10 Sep 2026` `15 Sep 2026` `20 Mar 2028` FALSE))
-- s 16(3)(b): 20 March 2029 is the last day; 21 March 2029 is out, unless the commissioner allows it (s 16(4)).
#ASSERT `Can I apply on this day` `20 Mar 2029` `15 Sep 2026` `20 Mar 2028` FALSE
#ASSERT (NOT (`Can I apply on this day` `21 Mar 2029` `15 Sep 2026` `20 Mar 2028` FALSE))
#ASSERT `Can I apply on this day` `21 Mar 2029` `15 Sep 2026` `20 Mar 2028` TRUE
-- s 15(1), (3): move in within 1 year of completion (by 20 March 2029) and stay 6 continuous months.
#ASSERT `By when must I move in, and for how long` `20 Mar 2028` FALSE FALSE 0 FALSE `20 Mar 2029` FALSE FALSE EQUALS `move in by, and stay for` `20 Mar 2029` 6
-- She moves in on 1 April 2028. 6 months from 1 April ends on 1 October 2028 (she must live there every day before it).
-- On 30 September 2028, still there: not yet, still time. On 1 October 2028: complied with.
#ASSERT `residence for` `20 Mar 2028` FALSE 0 FALSE `20 Mar 2029` TRUE `1 Apr 2028` FALSE `1 Apr 2028` `30 Sep 2028` EQUALS `not yet complied with, and there is still time`
#ASSERT `residence for` `20 Mar 2028` FALSE 0 FALSE `20 Mar 2029` TRUE `1 Apr 2028` FALSE `1 Apr 2028` `1 Oct 2028` EQUALS `the residence requirements are complied with`
-- She moves out on 15 September 2028 (the first day it is no longer her home): before 1 October 2028.
#ASSERT `residence for` `20 Mar 2028` FALSE 0 FALSE `20 Mar 2029` TRUE `1 Apr 2028` TRUE `15 Sep 2028` `1 Dec 2029` EQUALS `not complied with: occupation ended before the required period (s 15(1))`
-- Moving out on 1 October 2028 itself is in time: she lived there 1 April to 30 September.
#ASSERT `residence for` `20 Mar 2028` FALSE 0 FALSE `20 Mar 2029` TRUE `1 Apr 2028` TRUE `1 Oct 2028` `1 Dec 2029` EQUALS `the residence requirements are complied with`
-- s 22(2), (3): paid in anticipation, she moves out on 15 September 2028. The period allowed for compliance ends 6
-- months after the last day to start: 20 March 2029 + 6 months = 20 September 2029. Relevant date = the earlier,
-- 15 September 2028. 14 days after: 29 September 2028.
#ASSERT `By when must I notify and repay for not living there` `20 Mar 2028` FALSE 0 FALSE `20 Mar 2029` `15 Sep 2028` EQUALS `29 Sep 2028`
-- If nothing made it apparent before 1 December 2029, the relevant date is the end of the period, 20 September 2029,
-- and 14 days after it is 4 October 2029.
#ASSERT `By when must I notify and repay for not living there` `20 Mar 2028` FALSE 0 FALSE `20 Mar 2029` `1 Dec 2029` EQUALS `4 Oct 2029`
-- s 22A(4)(c): a contract mentioned in s 5(3)(b) is a relevant transaction. Paid before settlement, and on completion
-- the apartment is valued at $560,000: $560,000 + $220,000 = $780,000 >= $750,000 (s 5(7)). Notice and repayment
-- within 28 days after 20 March 2028: 11 days to 31 March, 17 more: 17 April 2028.
#ASSERT `Must I notify and repay because my home is over the cap on completion` `a contract to buy a home` TRUE TRUE 640000 560000 220000 `20 Mar 2028` EQUALS `yes: give the Commissioner written notice and repay the grant by` `17 Apr 2028`
-- Not paid before completion: s 22A(1)(a) not met. Valued at $500,000: $720,000 < $750,000.
#ASSERT `Must I notify and repay because my home is over the cap on completion` `a contract to buy a home` TRUE FALSE 640000 560000 220000 `20 Mar 2028` EQUALS `no: s 22A does not apply to me`
#ASSERT `Must I notify and repay because my home is over the cap on completion` `a contract to buy a home` TRUE TRUE 640000 500000 220000 `20 Mar 2028` EQUALS `no: s 22A does not apply to me`
-- A home already standing when bought (not s 5(3)(b)) is not a relevant transaction (s 22A(4)).
#ASSERT `Must I notify and repay because my home is over the cap on completion` `a contract to buy a home` FALSE TRUE 640000 560000 220000 `20 Mar 2028` EQUALS `no: s 22A does not apply to me`

-- =====================================================================================================================
-- CASE 2. Sam, 31, an Australian citizen, and Priya, 29, on a temporary visa, de facto partners who have lived
-- together for 3 years, have a builder build a new home in Logan on land they own. HYPOTHETICAL: comprehensive home
-- building contract made 3 August 2026 for $480,000; land worth $260,000 on that day. Priya once owned and lived in
-- a unit in Sydney (2018 to 2022).
-- =====================================================================================================================

-- s 5(1)(b), (8): $480,000 + $260,000 = $740,000 < $750,000. Eligible; the grant is the lesser of $480,000 and
-- $30,000.
#ASSERT `transaction for` `a comprehensive home building contract` FALSE FALSE FALSE FALSE TRUE `3 Aug 2026` 480000 0 260000 FALSE FALSE FALSE EQUALS `yes, it is an eligible transaction for a new home (s 5(1))`
#ASSERT `amount for` `a comprehensive home building contract` FALSE FALSE FALSE FALSE TRUE `3 Aug 2026` 480000 0 260000 FALSE FALSE FALSE EQUALS `the grant is` 30000
-- Land worth $300,000: $780,000 >= $750,000 (s 5(8)), though the building price alone is under the cap.
#ASSERT `transaction for` `a comprehensive home building contract` FALSE FALSE FALSE FALSE TRUE `3 Aug 2026` 480000 0 300000 FALSE FALSE FALSE EQUALS `no, it is not an eligible transaction` `the home and land together are worth $750,000 or more (s 5(7) to (9))`
#ASSERT `amount for` `a comprehensive home building contract` FALSE FALSE FALSE FALSE TRUE `3 Aug 2026` 480000 0 300000 FALSE FALSE FALSE EQUALS `no grant: not an eligible transaction` `the home and land together are worth $750,000 or more (s 5(7) to (9))`
-- A building contract by someone who will not own the land (s 5(1)(b)).
#ASSERT `transaction for` `a comprehensive home building contract` FALSE FALSE FALSE FALSE FALSE `3 Aug 2026` 480000 0 260000 FALSE FALSE FALSE EQUALS `no, it is not an eligible transaction` `the person building does not own the land, now or on completion (s 5(1)(b), (c))`
-- Schedule, completed (b), Regulation r 6: ready for occupation and a final inspection certificate issued. Ready
-- without the certificate is not completed.
#ASSERT `Has my purchase or build been completed` `a comprehensive home building contract` FALSE FALSE FALSE TRUE TRUE
#ASSERT (NOT (`Has my purchase or build been completed` `a comprehensive home building contract` FALSE FALSE FALSE TRUE FALSE))
-- s 9(2): 3 years living together: Priya is Sam's spouse. s 14(4): she held a relevant interest in residential
-- property, used as her residence, after 1 July 2000. So Sam fails criterion 4.
#ASSERT `criteria for` TRUE 31 `an Australian citizen` TRUE FALSE FALSE `living together as a couple without being married or in a civil partnership` TRUE 3 TRUE EQUALS `fails criterion 4: the applicant or the applicant's spouse has held a relevant interest in residential property (s 14)`
-- Had they lived together only 1 year, she would not be his spouse (s 9(2)), and Sam meets criteria 1 to 4.
#ASSERT `criteria for` TRUE 31 `an Australian citizen` TRUE FALSE FALSE `living together as a couple without being married or in a civil partnership` TRUE 1 TRUE EQUALS `meets criteria 1 to 4`
-- Priya, from her own seat: not a citizen or permanent resident, but Sam, a joint applicant, is (s 12(2)): criterion 2
-- met; criterion 4 fails on her own unit.
#ASSERT `criteria for` TRUE 29 `none of these` TRUE TRUE TRUE `living together as a couple without being married or in a civil partnership` TRUE 3 FALSE EQUALS `fails criterion 4: the applicant or the applicant's spouse has held a relevant interest in residential property (s 14)`
-- Priya alone (no joint citizen): criterion 2 fails first.
#ASSERT `criteria for` TRUE 29 `none of these` FALSE FALSE FALSE `no partner` FALSE 0 FALSE EQUALS `fails criterion 2: not an Australian citizen or permanent resident, and no joint applicant is (s 12)`
-- Had the Sydney unit been let out and never lived in by either of them, s 14(4) would not bar them.
#ASSERT `criteria for` TRUE 31 `an Australian citizen` TRUE FALSE FALSE `living together as a couple without being married or in a civil partnership` TRUE 3 FALSE EQUALS `meets criteria 1 to 4`
-- s 10(1)(a): payable only if each applicant complies. From Sam's seat with 1 year together (he meets 1 to 4), Priya
-- does not: not payable.
#ASSERT `payable for` `a comprehensive home building contract` FALSE TRUE `3 Aug 2026` 480000 0 260000 TRUE 31 `an Australian citizen` TRUE FALSE FALSE `living together as a couple without being married or in a civil partnership` 1 TRUE FALSE FALSE FALSE EQUALS `not payable` `another joint applicant does not meet criteria 1 to 4`
-- With 3 years together, Sam himself fails criterion 4, and that is reported first.
#ASSERT `payable for` `a comprehensive home building contract` FALSE TRUE `3 Aug 2026` 480000 0 260000 TRUE 31 `an Australian citizen` TRUE FALSE FALSE `living together as a couple without being married or in a civil partnership` 3 TRUE FALSE FALSE FALSE EQUALS `not payable` (`an applicant does not meet criteria 1 to 4` `fails criterion 4: the applicant or the applicant's spouse has held a relevant interest in residential property (s 14)`)

-- =====================================================================================================================
-- CASE 3. Jack, 35, an Australian citizen, builds his own home in Toowoomba as an owner builder. HYPOTHETICAL: laying
-- the foundations starts 10 January 2027; his actual costs, without his own labour, are $210,000; the land is worth
-- $140,000.
-- =====================================================================================================================

-- s 5(1)(c), (9): $210,000 + $140,000 = $350,000 < $750,000. s 20: lesser of $210,000 and $30,000.
#ASSERT `amount for` `building a home as an owner builder` FALSE FALSE FALSE FALSE TRUE `10 Jan 2027` 210000 0 140000 FALSE FALSE FALSE EQUALS `the grant is` 30000
-- A small owner build costing $24,000: s 20(1)(a), the grant is the consideration, $24,000.
#ASSERT `amount for` `building a home as an owner builder` FALSE FALSE FALSE FALSE TRUE `10 Jan 2027` 24000 0 140000 FALSE FALSE FALSE EQUALS `the grant is` 24000
-- s 5(4) is about contracts; an owner build is not one, so a commissioner's scheme finding does not touch it here.
#ASSERT `Is my purchase or build an eligible transaction` `building a home as an owner builder` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE TRUE `10 Jan 2027` 210000 0 140000 TRUE FALSE FALSE FALSE FALSE FALSE EQUALS `yes, it is an eligible transaction for a new home (s 5(1))`
-- The same finding on a building contract excludes it (s 5(4)).
#ASSERT `Is my purchase or build an eligible transaction` `a comprehensive home building contract` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE TRUE `10 Jan 2027` 210000 0 140000 TRUE FALSE FALSE FALSE FALSE FALSE EQUALS `no, it is not an eligible transaction` `the contract is part of a scheme to circumvent the grant's limits (s 5(4), (5))`
-- s 5(5): an option granted before 1 July 2000 is presumed a scheme unless the commissioner is satisfied otherwise.
#ASSERT `Is my purchase or build an eligible transaction` `a contract to buy a home` TRUE TRUE TRUE TRUE FALSE FALSE FALSE TRUE FALSE `10 Jan 2027` 400000 250000 150000 FALSE TRUE FALSE FALSE FALSE FALSE EQUALS `no, it is not an eligible transaction` `the contract is part of a scheme to circumvent the grant's limits (s 5(4), (5))`
#ASSERT `Is my purchase or build an eligible transaction` `a contract to buy a home` TRUE TRUE TRUE TRUE FALSE FALSE FALSE TRUE FALSE `10 Jan 2027` 400000 250000 150000 FALSE TRUE FALSE FALSE TRUE FALSE EQUALS `yes, it is an eligible transaction for a new home (s 5(1))`
-- s 5(1): "in the State". A home in New South Wales is not an eligible transaction.
#ASSERT `Is my purchase or build an eligible transaction` `building a home as an owner builder` FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE TRUE `10 Jan 2027` 210000 0 140000 FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `no, it is not an eligible transaction` `the home is not in Queensland`
-- s 6(1): a building that may not lawfully be lived in is not a home.
#ASSERT `Is my purchase or build an eligible transaction` `building a home as an owner builder` TRUE TRUE FALSE TRUE FALSE FALSE FALSE FALSE TRUE `10 Jan 2027` 210000 0 140000 FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `no, it is not an eligible transaction` `it is not a home (s 6(1))`

-- =====================================================================================================================
-- CASE 4. The 2023 to 2026 window. Lena, 30, buys a new townhouse in Ipswich. HYPOTHETICAL: contract made 1 March 2025,
-- price $550,000; townhouse $350,000, land $200,000.
-- =====================================================================================================================

-- s 25EA(1)(a): a s 5(1) contract made between 20 November 2023 and 30 June 2026. s 25EB: lesser of $550,000 and
-- $30,000 = $30,000 (despite s 20; s 91 governs only s 20 as it stood).
#ASSERT `amount for` `a contract to buy a home` FALSE FALSE FALSE TRUE FALSE `1 Mar 2025` 550000 350000 200000 FALSE FALSE FALSE EQUALS `the grant is` 30000
#ASSERT `transaction for` `a contract to buy a home` FALSE FALSE FALSE TRUE FALSE `1 Mar 2025` 550000 350000 200000 FALSE FALSE FALSE EQUALS `yes, it is an eligible transaction for a new home (s 5(1))`
-- s 25EA(2): the commissioner is satisfied it is a scheme for the Division 7 amount. It stays an eligible transaction
-- (s 5), but its amount would come from s 20 as it stood before 1 July 2026 (s 91), not deposited: not covered.
#ASSERT `amount for` `a contract to buy a home` FALSE FALSE FALSE TRUE FALSE `1 Mar 2025` 550000 350000 200000 FALSE FALSE TRUE EQUALS `not covered: the amount is set by a version of the Act that is not deposited`
-- s 25EA(3)(a): it replaces a contract made before 20 November 2023 for the same home: a scheme is presumed unless the
-- commissioner is satisfied to the contrary.
#ASSERT `amount for` `a contract to buy a home` FALSE FALSE FALSE TRUE FALSE `1 Mar 2025` 550000 350000 200000 TRUE FALSE FALSE EQUALS `not covered: the amount is set by a version of the Act that is not deposited`
#ASSERT `amount for` `a contract to buy a home` FALSE FALSE FALSE TRUE FALSE `1 Mar 2025` 550000 350000 200000 TRUE TRUE FALSE EQUALS `the grant is` 30000
-- 30 June 2026 is the last day of Division 7 ("both dates inclusive"): $30,000 under s 25EB. 1 July 2026 is under
-- s 20 as deposited: also $30,000.
#ASSERT `amount for` `a contract to buy a home` FALSE FALSE FALSE TRUE FALSE `30 June 2026 contract` 550000 350000 200000 FALSE FALSE FALSE EQUALS `the grant is` 30000
#ASSERT `amount for` `a contract to buy a home` FALSE FALSE FALSE TRUE FALSE `1 July 2026 contract` 550000 350000 200000 FALSE FALSE FALSE EQUALS `the grant is` 30000
-- A contract made 19 November 2023 is before Division 7, and its version of the Act is not deposited: not covered,
-- for the transaction, the amount and payability alike.
#ASSERT `amount for` `a contract to buy a home` FALSE FALSE FALSE TRUE FALSE `19 Nov 2023` 550000 350000 200000 FALSE FALSE FALSE EQUALS `not covered: the amount is set by a version of the Act that is not deposited`
#ASSERT `transaction for` `a contract to buy a home` FALSE FALSE FALSE TRUE FALSE `19 Nov 2023` 550000 350000 200000 FALSE FALSE FALSE EQUALS `not covered: it commenced before 20 November 2023, and a version of the Act that is not deposited governs it`
#ASSERT `payable for` `a contract to buy a home` TRUE FALSE `19 Nov 2023` 550000 350000 200000 TRUE 30 `an Australian citizen` FALSE FALSE FALSE `no partner` 0 FALSE FALSE FALSE FALSE EQUALS `not covered: the transaction commenced before 20 November 2023`

-- =====================================================================================================================
-- CASE 5. Tom, 26, buys an established house in Cairns. HYPOTHETICAL: contract made 1 February 2027 for $520,000
-- (house $300,000, land $220,000); the house has been lived in for 30 years.
-- =====================================================================================================================

-- s 6(2)(a): previously occupied, so not a new home. s 5(2)(a): a non-new home only before 11 October 2012.
#ASSERT (NOT (`Is my home a new home` `a contract to buy a home` TRUE TRUE TRUE TRUE FALSE FALSE))
#ASSERT `transaction for` `a contract to buy a home` TRUE FALSE FALSE TRUE FALSE `1 Feb 2027` 520000 300000 220000 FALSE FALSE FALSE EQUALS `no, it is not an eligible transaction` `it is not a new home, and it commenced on or after 11 October 2012 (s 5(2))`
#ASSERT `amount for` `a contract to buy a home` TRUE FALSE FALSE TRUE FALSE `1 Feb 2027` 520000 300000 220000 FALSE FALSE FALSE EQUALS `no grant: not an eligible transaction` `it is not a new home, and it commenced on or after 11 October 2012 (s 5(2))`
-- s 6(2)(b), (3): renovated by a developer, sold as new residential premises (GST Act s 40-75(1)(b)) and not lived in
-- since: a substantially renovated home, so a new home; the grant is $30,000.
#ASSERT `Is my home a new home` `a contract to buy a home` TRUE TRUE TRUE TRUE TRUE FALSE
#ASSERT `amount for` `a contract to buy a home` TRUE TRUE FALSE TRUE FALSE `1 Feb 2027` 520000 300000 220000 FALSE FALSE FALSE EQUALS `the grant is` 30000
-- Lived in since the renovation: not new (s 6(3)(c)).
#ASSERT (NOT (`Is my home a new home` `a contract to buy a home` TRUE TRUE TRUE TRUE TRUE TRUE))
-- s 6(3)(a): substantial renovation counts only for a home bought under a contract.
#ASSERT (NOT (`Is my home a new home` `building a home as an owner builder` TRUE TRUE TRUE TRUE TRUE FALSE))
-- s 5(3): buying vacant land is not buying a home; the later building contract is the eligible transaction.
#ASSERT `transaction for` `a contract to buy a home` FALSE FALSE FALSE FALSE FALSE `1 Feb 2027` 200000 0 200000 FALSE FALSE FALSE EQUALS `no, it is not an eligible transaction` `the contract is not for land with the home on it or to be built by the vendor (s 5(3))`

-- =====================================================================================================================
-- CASE 6. The $750,000 caps (s 5(6), (7)). HYPOTHETICAL new homes contracted 1 February 2027.
-- =====================================================================================================================

-- s 5(6): consideration of exactly $750,000 is "$750,000 or more".
#ASSERT `transaction for` `a contract to buy a home` FALSE FALSE FALSE TRUE FALSE `1 Feb 2027` 750000 450000 250000 FALSE FALSE FALSE EQUALS `no, it is not an eligible transaction` `the consideration is $750,000 or more (s 5(6))`
-- $749,999, with values $500,000 + $249,999 = $749,999: eligible.
#ASSERT `transaction for` `a contract to buy a home` FALSE FALSE FALSE TRUE FALSE `1 Feb 2027` 749999 500000 249999 FALSE FALSE FALSE EQUALS `yes, it is an eligible transaction for a new home (s 5(1))`
-- s 5(7): price $700,000, but the home is worth $450,000 and the land $310,000: $760,000. Value, not price.
#ASSERT `transaction for` `a contract to buy a home` FALSE FALSE FALSE TRUE FALSE `1 Feb 2027` 700000 450000 310000 FALSE FALSE FALSE EQUALS `no, it is not an eligible transaction` `the home and land together are worth $750,000 or more (s 5(7) to (9))`

-- =====================================================================================================================
-- CASE 7. Criteria 1 to 4, one at a time. HYPOTHETICAL applicants.
-- =====================================================================================================================

-- s 11(1)(b): 17 on the commencement date, no exemption: fails. With the s 11(2) exemption: meets.
#ASSERT `criteria for` TRUE 17 `an Australian citizen` FALSE FALSE FALSE `no partner` FALSE 0 FALSE EQUALS `fails criterion 1: under 18 at the commencement date and not exempted (s 11(1)(b), (2))`
#ASSERT `Do I meet eligibility criteria 1 to 4` TRUE 17 TRUE `an Australian citizen` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `no partner` FALSE 0 FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `meets criteria 1 to 4`
-- s 11(1)(a): a company is not a natural person.
#ASSERT `criteria for` FALSE 40 `an Australian citizen` FALSE FALSE FALSE `no partner` FALSE 0 FALSE EQUALS `fails criterion 1: not a natural person (s 11(1)(a))`
-- s 12: a permanent visa holder, and a New Zealand citizen on a special category visa, are permanent residents.
#ASSERT `criteria for` TRUE 30 `the holder of a permanent visa` FALSE FALSE FALSE `no partner` FALSE 0 FALSE EQUALS `meets criteria 1 to 4`
#ASSERT `criteria for` TRUE 30 `a New Zealand citizen holding a special category visa` FALSE FALSE FALSE `no partner` FALSE 0 FALSE EQUALS `meets criteria 1 to 4`
-- s 13(1): she was a party to an earlier application on which a grant was paid: fails criterion 3.
#ASSERT `Do I meet eligibility criteria 1 to 4` TRUE 30 FALSE `an Australian citizen` FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE `no partner` FALSE 0 FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `fails criterion 3: the applicant or the applicant's spouse has received an earlier grant (s 13)`
-- s 13(2): it was paid back because s 10(1) was not met, with the s 47 penalty: not ineligible.
#ASSERT `Do I meet eligibility criteria 1 to 4` TRUE 30 FALSE `an Australian citizen` FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE `no partner` FALSE 0 FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `meets criteria 1 to 4`
-- s 13(1) with s 9: her husband, living with her, received a grant: fails criterion 3.
#ASSERT `Do I meet eligibility criteria 1 to 4` TRUE 30 FALSE `an Australian citizen` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `married` TRUE 4 FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS `fails criterion 3: the applicant or the applicant's spouse has received an earlier grant (s 13)`
-- s 9(3), (4): living apart, the commissioner satisfied neither intends to live together again: he is not her spouse.
#ASSERT `Do I meet eligibility criteria 1 to 4` TRUE 30 FALSE `an Australian citizen` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `married` FALSE 4 TRUE TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS `meets criteria 1 to 4`
-- s 14(1)(a): an investment flat held before 1 July 2000, never lived in, still counts (no residence test before 2000).
#ASSERT `Do I meet eligibility criteria 1 to 4` TRUE 50 FALSE `an Australian citizen` FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE `no partner` FALSE 0 FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `fails criterion 4: the applicant or the applicant's spouse has held a relevant interest in residential property (s 14)`
-- s 14(2): it was an instalment purchase ended within a year without the fee simple: not ineligible.
#ASSERT `Do I meet eligibility criteria 1 to 4` TRUE 50 FALSE `an Australian citizen` FALSE FALSE FALSE FALSE TRUE TRUE FALSE FALSE `no partner` FALSE 0 FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `meets criteria 1 to 4`
-- s 14(4): after 1 July 2000, an investment flat never lived in by her or a spouse does not count.
#ASSERT `criteria for` TRUE 30 `an Australian citizen` FALSE FALSE FALSE `no partner` FALSE 0 FALSE EQUALS `meets criteria 1 to 4`
-- s 14(4), (5): she owned and lived in a home since 2000, but it was the subject of her own earlier application and she
-- repaid that grant for failing criterion 5: taken not to have lived there. (Her earlier grant was repaid for a
-- failure to satisfy s 10(1), with any penalty: s 13(2).)
#ASSERT `Do I meet eligibility criteria 1 to 4` TRUE 30 FALSE `an Australian citizen` FALSE FALSE TRUE TRUE FALSE FALSE TRUE TRUE `no partner` FALSE 0 FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `meets criteria 1 to 4`
#ASSERT `Do I meet eligibility criteria 1 to 4` TRUE 30 FALSE `an Australian citizen` FALSE FALSE TRUE TRUE FALSE FALSE TRUE FALSE `no partner` FALSE 0 FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `fails criterion 4: the applicant or the applicant's spouse has held a relevant interest in residential property (s 14)`

-- =====================================================================================================================
-- CASE 8. Who is a spouse (s 9). HYPOTHETICAL couples.
-- =====================================================================================================================

-- s 9(2): de facto for 1.5 years: not a spouse; for 2 years: a spouse.
#ASSERT (NOT (`Is my partner my spouse for the grant` `living together as a couple without being married or in a civil partnership` TRUE 1.5 FALSE FALSE FALSE))
#ASSERT `Is my partner my spouse for the grant` `living together as a couple without being married or in a civil partnership` TRUE 2 FALSE FALSE FALSE
-- s 9(5), (6): de facto for 3 years, now apart, the commissioner satisfied they intend to live together again: a spouse.
#ASSERT `Is my partner my spouse for the grant` `living together as a couple without being married or in a civil partnership` FALSE 3 TRUE FALSE TRUE
#ASSERT (NOT (`Is my partner my spouse for the grant` `living together as a couple without being married or in a civil partnership` FALSE 3 TRUE FALSE FALSE))
-- s 9(1)(a), (3), (4): married and apart: a spouse unless the commissioner is satisfied they will not live together again.
#ASSERT `Is my partner my spouse for the grant` `married` FALSE 0 TRUE FALSE FALSE
#ASSERT (NOT (`Is my partner my spouse for the grant` `married` FALSE 0 TRUE TRUE FALSE))
-- s 9(1)(c): a civil partner living together is a spouse, whatever the years.
#ASSERT `Is my partner my spouse for the grant` `in a civil partnership` TRUE 0.5 FALSE FALSE FALSE
#ASSERT (NOT (`Is my partner my spouse for the grant` `no partner` FALSE 0 FALSE FALSE FALSE))

