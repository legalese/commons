-- s 10(3): only one grant for the same transaction. s 69A(6): refused for a disqualifying arrangement.
#ASSERT `payable for` `a contract to buy a home` TRUE FALSE `15 Sep 2026` 640000 420000 220000 TRUE 27 `an Australian citizen` FALSE FALSE FALSE `no partner` 0 FALSE FALSE TRUE FALSE EQUALS `not payable` `a grant has already been paid for this transaction (s 10(3))`
#ASSERT `payable for` `a contract to buy a home` TRUE FALSE `15 Sep 2026` 640000 420000 220000 TRUE 27 `an Australian citizen` FALSE FALSE FALSE `no partner` 0 FALSE FALSE FALSE TRUE EQUALS `not payable` `the commissioner has refused it for a disqualifying arrangement (s 69A)`
-- An ineligible transaction is reported with its s 5 reason.
#ASSERT `payable for` `a contract to buy a home` TRUE FALSE `15 Sep 2026` 760000 500000 260000 TRUE 27 `an Australian citizen` FALSE FALSE FALSE `no partner` 0 FALSE FALSE FALSE FALSE EQUALS `not payable` (`the transaction is not an eligible transaction` `the consideration is $750,000 or more (s 5(6))`)

-- =====================================================================================================================
-- CASE 10. The residence requirement, varied (s 15). HYPOTHETICAL, all completed 20 March 2028 unless said.
-- =====================================================================================================================

-- s 15(3): not moved in, asked on 20 March 2029 (the last day): still time. On 21 March 2029: too late.
#ASSERT `residence for` `20 Mar 2028` FALSE 0 FALSE `20 Mar 2029` FALSE `20 Mar 2029` FALSE `20 Mar 2029` `20 Mar 2029` EQUALS `not yet complied with, and there is still time`
#ASSERT `residence for` `20 Mar 2028` FALSE 0 FALSE `20 Mar 2029` FALSE `20 Mar 2029` FALSE `20 Mar 2029` `21 Mar 2029` EQUALS `not complied with: occupation did not start in time (s 15(3))`
-- Moved in on 21 March 2029, a day late.
#ASSERT `residence for` `20 Mar 2028` FALSE 0 FALSE `20 Mar 2029` TRUE `21 Mar 2029` FALSE `21 Mar 2029` `1 Dec 2029` EQUALS `not complied with: occupation did not start in time (s 15(3))`
-- s 15(3): the commissioner approved a longer period, to 30 June 2029; moved in 15 June 2029, still there 1 December
-- 2029 (6 months from 15 June ends 15 December 2029): still time.
#ASSERT `residence for` `20 Mar 2028` FALSE 0 TRUE `30 Jun 2029` TRUE `15 Jun 2029` FALSE `15 Jun 2029` `1 Dec 2029` EQUALS `not yet complied with, and there is still time`
#ASSERT `By when must I move in, and for how long` `20 Mar 2028` FALSE FALSE 0 TRUE `30 Jun 2029` FALSE FALSE EQUALS `move in by, and stay for` `30 Jun 2029` 6
-- s 15(2)(a): a shorter period of 3 months approved; moved in 1 May 2028, out on 1 August 2028 (3 months from 1 May
-- ends 1 August): complied with. Out on 31 July 2028: too soon.
#ASSERT `residence for` `20 Mar 2028` TRUE 3 FALSE `20 Mar 2029` TRUE `1 May 2028` TRUE `1 Aug 2028` `1 Dec 2029` EQUALS `the residence requirements are complied with`
#ASSERT `residence for` `20 Mar 2028` TRUE 3 FALSE `20 Mar 2029` TRUE `1 May 2028` TRUE `31 Jul 2028` `1 Dec 2029` EQUALS `not complied with: occupation ended before the required period (s 15(1))`
-- Month end: moved in 31 August 2028; 6 months on is 28 February 2029 (February 2029 has 28 days).
#ASSERT `residence for` `20 Mar 2028` FALSE 0 FALSE `20 Mar 2029` TRUE `31 Aug 2028` FALSE `31 Aug 2028` `27 Feb 2029` EQUALS `not yet complied with, and there is still time`
#ASSERT `residence for` `20 Mar 2028` FALSE 0 FALSE `20 Mar 2029` TRUE `31 Aug 2028` FALSE `31 Aug 2028` `28 Feb 2029` EQUALS `the residence requirements are complied with`
-- s 15(2)(b): exempt.
#ASSERT `Have I met the residence requirements` `20 Mar 2028` TRUE FALSE 0 FALSE `20 Mar 2029` FALSE FALSE FALSE `20 Mar 2029` FALSE `20 Mar 2029` `21 Mar 2029` EQUALS `exempt from the residence requirements (s 15(2)(b))`
#ASSERT `By when must I move in, and for how long` `20 Mar 2028` TRUE FALSE 0 FALSE `20 Mar 2029` FALSE FALSE EQUALS `I am exempt from living in the home (s 15(2)(b))`
-- s 15(4): a joint applicant exempted from the start time, the other applicant complying: no deadline to move in, but
-- (read literally) still 6 months. Moved in 1 December 2029, asked 1 December 2029: still time, not too late.
#ASSERT `By when must I move in, and for how long` `20 Mar 2028` FALSE FALSE 0 FALSE `20 Mar 2029` TRUE TRUE EQUALS `no deadline to move in (s 15(4)), but stay for` 6
#ASSERT `Have I met the residence requirements` `20 Mar 2028` FALSE FALSE 0 FALSE `20 Mar 2029` TRUE TRUE TRUE `1 Dec 2029` FALSE `1 Dec 2029` `1 Dec 2029` EQUALS `not yet complied with, and there is still time`
-- s 15(4)(b): the exemption needs another applicant who complies; without one, the deadline applies.
#ASSERT `By when must I move in, and for how long` `20 Mar 2028` FALSE FALSE 0 FALSE `20 Mar 2029` TRUE FALSE EQUALS `move in by, and stay for` `20 Mar 2029` 6
-- s 16(3)(b) for a 29 February completion: 1 year after is read as 28 February 2029.
#ASSERT `What is the last day I can apply` `29 Feb 2028` EQUALS `28 Feb 2029`

-- =====================================================================================================================
-- CASE 11. Repayment, penalty, debt and charge (ss 22(5), 22A(2), 23(4), 47 to 49; Regulation r 4). HYPOTHETICAL.
-- =====================================================================================================================

-- s 47(2): $30,000 paid in error because of a false statement: penalty up to $30,000. s 47(3): and not repaid: a
-- second penalty up to $30,000, so $60,000 in all (reading). Neither: no penalty, only the repayment.
#ASSERT `What is the most penalty on top of repaying` 30000 TRUE FALSE EQUALS 30000
#ASSERT `What is the most penalty on top of repaying` 30000 TRUE TRUE EQUALS 60000
#ASSERT `What is the most penalty on top of repaying` 30000 FALSE FALSE EQUALS 0
#ASSERT `What is the most penalty on top of repaying` 30000 FALSE TRUE EQUALS 30000
-- 40 penalty units at a HYPOTHETICAL $170 a unit: $6,800.
#ASSERT `What is the most I can be fined for not notifying and repaying` 170 EQUALS 6800
-- s 48(2): two joint applicants: joint and several. One: not.
#ASSERT `Is each of us liable for the whole amount` 2
#ASSERT (NOT (`Is each of us liable for the whole amount` 1))
-- Regulation r 4(2): a HYPOTHETICAL May yield of 3.8462% rounds to 3.85%, plus 8%: 11.85%. 4.125% rounds (half up) to
-- 4.13%: 12.13%.
#ASSERT `What interest can my instalment arrangement charge` 3.8462 EQUALS 11.85
#ASSERT `What interest can my instalment arrangement charge` 4.125 EQUALS 12.13
-- s 49(1), (2): owing a repayment and holding an interest in the land: a first charge. No interest in the land: no.
#ASSERT `Is what I owe a charge on my home` TRUE TRUE
#ASSERT (NOT (`Is what I owe a charge on my home` TRUE FALSE))
#ASSERT (NOT (`Is what I owe a charge on my home` FALSE TRUE))

