-- CASE 13. The core's own functions where the seat cannot reach them. HYPOTHETICAL.
-- =====================================================================================================================

-- s 20(1)(b)(ii): $7,000 for an eligible transaction that is not a new home eligible transaction (s 5(2), all before
-- 11 October 2012). Lesser of $5,000 and $7,000 = $5,000; of $200,000 and $7,000 = $7,000. For a new home: $30,000.
#ASSERT `the amount under s 20` FALSE 5000 EQUALS 5000
#ASSERT `the amount under s 20` FALSE 200000 EQUALS 7000
#ASSERT `the amount under s 20` TRUE 200000 EQUALS 30000
-- s 5(2)(a): an established home bought 1 March 2010 was an eligible transaction; the seat answers not covered (an
-- earlier version governs it, s 79), and so does the core's amount.
#ASSERT `the eligibility of the transaction (s 5)` (`my transaction from my answers` `a contract to buy a home` TRUE TRUE TRUE TRUE TRUE FALSE FALSE TRUE FALSE FALSE `1 Mar 2010` 300000 200000 100000 FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS `an eligible transaction for a home other than a new home (s 5(2))`
#ASSERT `the amount of the grant for` (`my transaction from my answers` `a contract to buy a home` TRUE TRUE TRUE TRUE TRUE FALSE FALSE TRUE FALSE FALSE `1 Mar 2010` 300000 200000 100000 FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS `not covered: the amount is set by a version of the Act that is not deposited`
#ASSERT `transaction for` `a contract to buy a home` TRUE FALSE FALSE TRUE FALSE `1 Mar 2010` 300000 200000 100000 FALSE FALSE FALSE EQUALS `not covered: it commenced before 20 November 2023, and a version of the Act that is not deposited governs it`
-- The occupation window from 1 April 2028: 183 days to 1 October 2028 (30 + 31 + 30 + 31 + 31 + 30), less 1 = 182.
-- From completion on 20 March 2028 to 20 March 2029: 365 days.
#ASSERT `the days the occupation must last from` `no exemptions` `1 Apr 2028` EQUALS 182
#ASSERT `the days from` `20 Mar 2028` `to` `20 Mar 2029` EQUALS 365

`no exemptions` MEANS `my residence from my answers` FALSE FALSE 0 FALSE `20 Mar 2029` FALSE FALSE

-- =====================================================================================================================
-- Regulative rules (fhog-core.l4). Day 0 is the day the rule starts.
-- =====================================================================================================================

-- s 15 with s 22(2), Mia (case 1): day 0 = completion, 20 March 2028; 365 days to move in; she moves in on day 12
-- (1 April 2028) and must not stop within 182 days of that (to 30 September 2028, day 194). Grant $30,000.
-- Stays past 1 October 2028 (day 195): fulfilled.
#ASSERT EVALTRACE (`s 15 and s 22(2) -- an applicant paid in anticipation must live in the home, or give notice and repay within 14 days` 365 TRUE 182 FALSE 30000) 0 (LIST (EVENT `the applicant` `start to occupy the home as principal place of residence` 12), (WAITUNTIL 200)) EQUALS FULFILLED
-- Moves out on 1 October 2028 (day 195): fulfilled.
#ASSERT EVALTRACE (`s 15 and s 22(2) -- an applicant paid in anticipation must live in the home, or give notice and repay within 14 days` 365 TRUE 182 FALSE 30000) 0 (LIST (EVENT `the applicant` `start to occupy the home as principal place of residence` 12), (EVENT `the applicant` `stop occupying the home as principal place of residence` 195)) EQUALS FULFILLED
-- Moves out on 15 September 2028 (day 179); notifies on day 185 and repays $30,000 on day 190, within 14 days (day
-- 193, 29 September 2028, the date the seat gives): fulfilled.
#ASSERT EVALTRACE (`s 15 and s 22(2) -- an applicant paid in anticipation must live in the home, or give notice and repay within 14 days` 365 TRUE 182 FALSE 30000) 0 (LIST (EVENT `the applicant` `start to occupy the home as principal place of residence` 12), (EVENT `the applicant` `stop occupying the home as principal place of residence` 179), (EVENT `the applicant` `give the commissioner written notice that the residence requirements are not complied with` 185), (EVENT `the applicant` (`repay the grant` 30000) 190)) EQUALS FULFILLED
-- expect: BREACH BY the applicant, "s 22(2)(b), (5): repay the grant within 14 days after the relevant date ..." (repaid on day 194)
#TRACE `s 15 and s 22(2) -- an applicant paid in anticipation must live in the home, or give notice and repay within 14 days` 365 TRUE 182 FALSE 30000 AT 0 WITH
    PARTY `the applicant` DOES `start to occupy the home as principal place of residence` AT 12
    PARTY `the applicant` DOES `stop occupying the home as principal place of residence` AT 179
    PARTY `the applicant` DOES `give the commissioner written notice that the residence requirements are not complied with` AT 185
    PARTY `the applicant` DOES `repay the grant` 30000 AT 194
-- expect: the s 22(2) duty, still pending (she moved out on 30 September 2028, day 194, one day short)
#TRACE `s 15 and s 22(2) -- an applicant paid in anticipation must live in the home, or give notice and repay within 14 days` 365 TRUE 182 FALSE 30000 AT 0 WITH
    PARTY `the applicant` DOES `start to occupy the home as principal place of residence` AT 12
    PARTY `the applicant` DOES `stop occupying the home as principal place of residence` AT 194
-- Never moves in: the deadline passes; noticed on day 366, she notifies on day 370 and repays on day 375: fulfilled.
#ASSERT EVALTRACE (`s 15 and s 22(2) -- an applicant paid in anticipation must live in the home, or give notice and repay within 14 days` 365 TRUE 182 FALSE 30000) 0 (LIST (WAITUNTIL 366), (EVENT `the applicant` `give the commissioner written notice that the residence requirements are not complied with` 370), (EVENT `the applicant` (`repay the grant` 30000) 375)) EQUALS FULFILLED
-- Repaying a wrong amount does not count (EXACTLY): $20,000 on day 375, then nothing.
-- expect: BREACH BY the applicant, "s 22(2)(b), (5): ..." (no repayment of $30,000 by day 380)
#TRACE `s 15 and s 22(2) -- an applicant paid in anticipation must live in the home, or give notice and repay within 14 days` 365 TRUE 182 FALSE 30000 AT 0 WITH
    (WAITUNTIL 366)
    PARTY `the applicant` DOES `give the commissioner written notice that the residence requirements are not complied with` AT 370
    PARTY `the applicant` DOES `repay the grant` 20000 AT 375
    (WAITUNTIL 400)
-- s 15(2)(b) exemption: nothing owed.
#ASSERT EVALTRACE (`s 15 and s 22(2) -- an applicant paid in anticipation must live in the home, or give notice and repay within 14 days` 365 TRUE 182 TRUE 30000) 0 (LIST (WAITUNTIL 500)) EQUALS FULFILLED
-- s 15(4): no start deadline; she moves in on day 400 and stays past day 600: fulfilled.
#ASSERT EVALTRACE (`s 15 and s 22(2) -- an applicant paid in anticipation must live in the home, or give notice and repay within 14 days` 365 FALSE 182 FALSE 30000) 0 (LIST (EVENT `the applicant` `start to occupy the home as principal place of residence` 400), (WAITUNTIL 600)) EQUALS FULFILLED

-- s 22A, Mia over the cap (case 1): day 0 = completion; notice day 10, repayment day 20: fulfilled. Repaid on day 29:
-- late. Not applicable: nothing owed.
#ASSERT EVALTRACE (`s 22A -- paid early and over the cap on completion, the applicant must give notice and repay within 28 days` TRUE 30000) 0 (LIST (EVENT `the applicant` `give the commissioner written notice that the transaction is not an eligible transaction` 10), (EVENT `the applicant` (`repay the grant` 30000) 20)) EQUALS FULFILLED
#ASSERT EVALTRACE (`s 22A -- paid early and over the cap on completion, the applicant must give notice and repay within 28 days` TRUE 30000) 0 (LIST (EVENT `the applicant` `give the commissioner written notice that the transaction is not an eligible transaction` 10), (EVENT `the applicant` (`repay the grant` 30000) 28)) EQUALS FULFILLED
-- expect: BREACH BY the applicant, "s 22A(2)(b): repay the grant within 28 days after completion ..." (repaid on day 29)
#TRACE `s 22A -- paid early and over the cap on completion, the applicant must give notice and repay within 28 days` TRUE 30000 AT 0 WITH
    PARTY `the applicant` DOES `give the commissioner written notice that the transaction is not an eligible transaction` AT 10
    PARTY `the applicant` DOES `repay the grant` 30000 AT 29
#ASSERT EVALTRACE (`s 22A -- paid early and over the cap on completion, the applicant must give notice and repay within 28 days` FALSE 30000) 0 (LIST (WAITUNTIL 60)) EQUALS FULFILLED

-- s 23: a HYPOTHETICAL condition allowing 7 days for notice and 30 to repay; broken on day 0; notice day 5, repayment
-- day 25: fulfilled. Condition kept: nothing owed.
#ASSERT EVALTRACE (`s 23 -- on breaking a condition of the grant, the applicant must give notice and repay within the periods the condition states` TRUE 7 30 30000) 0 (LIST (EVENT `the applicant` `give the commissioner notice of non-compliance with the condition` 5), (EVENT `the applicant` (`repay the grant` 30000) 25)) EQUALS FULFILLED
#ASSERT EVALTRACE (`s 23 -- on breaking a condition of the grant, the applicant must give notice and repay within the periods the condition states` FALSE 7 30 30000) 0 (LIST (WAITUNTIL 60)) EQUALS FULFILLED
-- expect: BREACH BY the applicant, "s 23(2)(a), (4): notice of non-compliance within the period the condition states ..." (notice on day 8)
#TRACE `s 23 -- on breaking a condition of the grant, the applicant must give notice and repay within the periods the condition states` TRUE 7 30 30000 AT 0 WITH
    PARTY `the applicant` DOES `give the commissioner notice of non-compliance with the condition` AT 8
    PARTY `the applicant` DOES `repay the grant` 30000 AT 9

-- s 47: a HYPOTHETICAL notice requiring $30,000 within 28 days. Repaid on day 20: fulfilled. Not repaid: the
-- commissioner may impose a penalty of up to $30,000; one of $40,000 is not one the section allows and does not count;
-- one of $30,000 on day 36, paid on day 50: fulfilled.
#ASSERT EVALTRACE (`s 47 -- the applicant must repay the error amount; if not, the commissioner may impose a penalty of up to that amount` 30000 28) 0 (LIST (EVENT `the applicant` (`repay the amount the notice requires` 30000) 20)) EQUALS FULFILLED
#ASSERT EVALTRACE (`s 47 -- the applicant must repay the error amount; if not, the commissioner may impose a penalty of up to that amount` 30000 28) 0 (LIST (WAITUNTIL 29), (EVENT `the commissioner` (`impose a penalty amount` 40000) 35), (EVENT `the commissioner` (`impose a penalty amount` 30000) 36), (EVENT `the applicant` (`pay the penalty amount` 30000) 50)) EQUALS FULFILLED
-- expect: PARTY the applicant MUST pay the penalty amount 15000, still pending (no period is stated)
#TRACE `s 47 -- the applicant must repay the error amount; if not, the commissioner may impose a penalty of up to that amount` 30000 28 AT 0 WITH
    (WAITUNTIL 29)
    PARTY `the commissioner` DOES `impose a penalty amount` 15000 AT 40
    (WAITUNTIL 400)

-- s 49(4): paid on day 10, the release lodged on day 20: fulfilled.
#ASSERT EVALTRACE `s 49(4) -- once the amount is paid, the commissioner must release the charge` 0 (LIST (EVENT `the applicant` `pay the amount the charge secures` 10), (EVENT `the commissioner` `lodge a request to release the charge` 20)) EQUALS FULFILLED
-- expect: PARTY the commissioner MUST lodge a request to release the charge, still pending ("as soon as practicable")
#TRACE `s 49(4) -- once the amount is paid, the commissioner must release the charge` AT 0 WITH
    PARTY `the applicant` DOES `pay the amount the charge secures` AT 10
    (WAITUNTIL 400)

-- ss 56 to 59: day 0 = notice of the decision received. Not objecting: fulfilled (a choice). Objecting on day 60, the
-- decision notified on day 100, QCAT applied to on day 160 (60 days after): fulfilled. Not applying to QCAT: fulfilled.
#ASSERT EVALTRACE (`ss 56 to 59 -- the applicant may object within 60 days, and then apply to QCAT within 60 days of the decision` 60) 0 (LIST (WAITUNTIL 61)) EQUALS FULFILLED
#ASSERT EVALTRACE (`ss 56 to 59 -- the applicant may object within 60 days, and then apply to QCAT within 60 days of the decision` 60) 0 (LIST (EVENT `the applicant` `lodge a written objection stating the grounds fully and in detail` 60), (EVENT `the commissioner` `give the objector written notice of the decision on the objection` 100), (EVENT `the applicant` `apply to QCAT for a review of the decision on the objection` 160)) EQUALS FULFILLED
#ASSERT EVALTRACE (`ss 56 to 59 -- the applicant may object within 60 days, and then apply to QCAT within 60 days of the decision` 60) 0 (LIST (EVENT `the applicant` `lodge a written objection stating the grounds fully and in detail` 60), (EVENT `the commissioner` `give the objector written notice of the decision on the objection` 100), (WAITUNTIL 161)) EQUALS FULFILLED
-- expect: PARTY the commissioner MUST give the objector written notice of the decision on the objection, still pending
#TRACE `ss 56 to 59 -- the applicant may object within 60 days, and then apply to QCAT within 60 days of the decision` 60 AT 0 WITH
    PARTY `the applicant` DOES `lodge a written objection stating the grounds fully and in detail` AT 30
    (WAITUNTIL 400)
-- expect: FULFILLED with nothing owed by the commissioner (objection on day 61, out of time without an extension)
#TRACE `ss 56 to 59 -- the applicant may object within 60 days, and then apply to QCAT within 60 days of the decision` 60 AT 0 WITH
    PARTY `the applicant` DOES `lodge a written objection stating the grounds fully and in detail` AT 61
-- s 56(4): the time extended to 90 days; an objection on day 85 must be decided.
-- expect: PARTY the commissioner MUST give the objector written notice of the decision on the objection, still pending
#TRACE `ss 56 to 59 -- the applicant may object within 60 days, and then apply to QCAT within 60 days of the decision` 90 AT 0 WITH
    PARTY `the applicant` DOES `lodge a written objection stating the grounds fully and in detail` AT 85
    (WAITUNTIL 400)
