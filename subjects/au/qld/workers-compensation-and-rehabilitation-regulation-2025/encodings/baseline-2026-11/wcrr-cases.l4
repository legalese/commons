§§ `ss 122-136, schedule 5 -- section 193A compensation`

#ASSERT `Am I entitled to section 193A compensation?` TRUE TRUE FALSE EQUALS TRUE
#ASSERT `Am I entitled to section 193A compensation?` FALSE TRUE FALSE EQUALS FALSE
#ASSERT `Am I entitled to section 193A compensation?` TRUE FALSE FALSE EQUALS FALSE
-- s 131(3): information not given in time: the condition is taken not to be satisfied.
#ASSERT `Am I entitled to section 193A compensation?` TRUE TRUE TRUE EQUALS FALSE
-- Schedule 5, s 4 example: DPI 5%, lawyer for information, meeting and a successful review: $31,490 + $1,700 + $2,000
-- + $1,000 = $36,190.
#ASSERT `How much section 193A compensation do I get?` TRUE TRUE FALSE 5 TRUE TRUE TRUE FALSE EQUALS JUST 36190
#ASSERT `How much section 193A compensation do I get?` TRUE TRUE FALSE 3 FALSE FALSE FALSE FALSE EQUALS JUST 18894
-- DPI 1% with all four legal cost amounts: 6,298 + 1,700 + 2,000 + 1,000 + 1,700 = 12,698.
#ASSERT `How much section 193A compensation do I get?` TRUE TRUE FALSE 1 TRUE TRUE TRUE TRUE EQUALS JUST 12698
#ASSERT `How much section 193A compensation do I get?` TRUE TRUE FALSE 6 FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `How much section 193A compensation do I get?` FALSE TRUE FALSE 5 TRUE FALSE FALSE FALSE EQUALS JUST 0
-- Schedule 5, s 3 example: paid on 3%, a later notice of 5%: the 2% amount, $12,596.
#ASSERT `What further DPI amount after a second notice?` 3 5 EQUALS JUST 12596
-- The later DPI must be "not more than 5%".
#ASSERT `What further DPI amount after a second notice?` 3 6 EQUALS JUST 0
#ASSERT `What further DPI amount after a second notice?` 5 3 EQUALS JUST 0
#ASSERT `What further DPI amount after a second notice?` 2 2 EQUALS JUST 0

-- s 130(2): 10 business days after Monday 7 September 2026 is Monday 21 September; with one public holiday, Tuesday 22.
#ASSERT `By when may I ask for reasons?` `7 Sep 2026` 0 EQUALS DATE_FROM_DMY 21 9 2026
#ASSERT `By when may I ask for reasons?` `7 Sep 2026` 1 EQUALS DATE_FROM_DMY 22 9 2026
-- s 131(2): 60 business days (12 weeks) after Monday 7 September 2026 is Monday 30 November; a later agreed day wins.
#ASSERT `By when may I give the insurer information?` `7 Sep 2026` 0 FALSE `unused day` EQUALS DATE_FROM_DMY 30 11 2026
#ASSERT `By when may I give the insurer information?` `7 Sep 2026` 0 TRUE (DATE_FROM_DMY 15 12 2026) EQUALS DATE_FROM_DMY 15 12 2026
#ASSERT `By when may I give the insurer information?` `7 Sep 2026` 0 TRUE (DATE_FROM_DMY 1 11 2026) EQUALS DATE_FROM_DMY 30 11 2026
-- s 132(3): information received Monday 7 September; 60th business day Monday 30 November.
-- No meeting: 30 November.
#ASSERT `By when must the insurer decide?` `7 Sep 2026` FALSE `unused day` 0 EQUALS DATE_FROM_DMY 30 11 2026
-- Meeting Monday 23 November: 10 business days on is Monday 7 December, later: 7 December.
#ASSERT `By when must the insurer decide?` `7 Sep 2026` TRUE (DATE_FROM_DMY 23 11 2026) 0 EQUALS DATE_FROM_DMY 7 12 2026
-- Meeting Monday 2 November: 16 November, earlier: 30 November.
#ASSERT `By when must the insurer decide?` `7 Sep 2026` TRUE (DATE_FROM_DMY 2 11 2026) 0 EQUALS DATE_FROM_DMY 30 11 2026
-- Meeting on the 60th business day itself (within the 60): 10 business days on is Monday 14 December.
#ASSERT `By when must the insurer decide?` `7 Sep 2026` TRUE (DATE_FROM_DMY 30 11 2026) 0 EQUALS DATE_FROM_DMY 14 12 2026
-- Meeting after the 60 business days: (b) does not apply.
#ASSERT `By when must the insurer decide?` `7 Sep 2026` TRUE (DATE_FROM_DMY 1 12 2026) 0 EQUALS DATE_FROM_DMY 30 11 2026
-- s 136(1): 20 business days after Thursday 1 October 2026 is Thursday 29 October; one public holiday, Friday 30.
#ASSERT `By when may I apply to the panel?` `1 Oct 2026` 0 EQUALS DATE_FROM_DMY 29 10 2026
#ASSERT `By when may I apply to the panel?` `1 Oct 2026` 1 EQUALS DATE_FROM_DMY 30 10 2026

-- Regulative rules, on a business-day (or, for s 115(4), calendar-day) clock starting at 0.
#ASSERT EVALTRACE `s 115(4) -- the registered person must report to the insurer within 10 days after the examination` 0 (LIST (EVENT `the registered person` `give the insurer a written report and an itemised account of the examination` 10)) EQUALS FULFILLED
#TRACE `s 115(4) -- the registered person must report to the insurer within 10 days after the examination` AT 0 WITH
    (WAITUNTIL 11)
-- expect: BREACH by the registered person (no report within 10 days)
#ASSERT EVALTRACE `s 130 -- the worker may ask for written reasons, and the insurer must then give them` 0 (LIST (EVENT `the worker` `ask the insurer for written reasons for the decision` 5), (EVENT `the insurer` `give the worker written reasons for the decision` 15)) EQUALS FULFILLED
#ASSERT EVALTRACE `s 130 -- the worker may ask for written reasons, and the insurer must then give them` 0 (LIST (WAITUNTIL 11)) EQUALS FULFILLED
#TRACE `s 130 -- the worker may ask for written reasons, and the insurer must then give them` AT 0 WITH
    PARTY `the worker` DOES `ask the insurer for written reasons for the decision` AT 5
    (WAITUNTIL 16)
-- expect: BREACH by the insurer (no reasons within 10 business days after the request)
#ASSERT EVALTRACE (`ss 131-132 -- the worker may give information, and the insurer must then decide` 60 60) 0 (LIST (EVENT `the worker` `give the insurer information relevant to the qualifying condition` 30), (EVENT `the insurer` (`decide the qualifying condition` `the qualifying condition is satisfied`) 80), (EVENT `the insurer` `give the worker a notice stating the amount of section 193A compensation` 85)) EQUALS FULFILLED
#ASSERT EVALTRACE (`ss 131-132 -- the worker may give information, and the insurer must then decide` 60 60) 0 (LIST (EVENT `the worker` `give the insurer information relevant to the qualifying condition` 30), (EVENT `the insurer` (`decide the qualifying condition` `the qualifying condition is not satisfied`) 50), (EVENT `the insurer` `give the worker written reasons for the decision` 52)) EQUALS FULFILLED
#ASSERT EVALTRACE (`ss 131-132 -- the worker may give information, and the insurer must then decide` 60 60) 0 (LIST (WAITUNTIL 61)) EQUALS FULFILLED
#TRACE (`ss 131-132 -- the worker may give information, and the insurer must then decide` 60 60) AT 0 WITH
    PARTY `the worker` DOES `give the insurer information relevant to the qualifying condition` AT 30
    (WAITUNTIL 91)
-- expect: BREACH by the insurer (s 132(3)); s 132(6) deems a decision against the worker
#ASSERT EVALTRACE `s 136 -- the worker may apply to the panel within 20 business days` 0 (LIST (EVENT `the worker` `apply to the panel for a review` 20), (EVENT `the insurer` `give the panel and the worker the information it considered` 25)) EQUALS FULFILLED
#ASSERT EVALTRACE `s 136 -- the worker may apply to the panel within 20 business days` 0 (LIST (WAITUNTIL 21)) EQUALS FULFILLED

§§ `Schedules 6-7 -- pneumoconiosis`

-- s 4(2): the same category twice: 2/2 scores 55.
#ASSERT `What is my pneumoconiosis score?` `category 2/2` `category 2/2` `no such reading taken` `no such reading taken` `no such reading taken` EQUALS `the pneumoconiosis score is` 55
-- s 4(3)(a): 0/0 and 0/1: 0.
#ASSERT `What is my pneumoconiosis score?` `category 0/0` `category 0/1` `no such reading taken` `no such reading taken` `no such reading taken` EQUALS `the pneumoconiosis score is` 0
-- s 4(3)(b) example: 2/2 and 2/3: 60. Also 3/3 and 3/+: 85.
#ASSERT `What is my pneumoconiosis score?` `category 2/2` `category 2/3` `no such reading taken` `no such reading taken` `no such reading taken` EQUALS `the pneumoconiosis score is` 60
#ASSERT `What is my pneumoconiosis score?` `category 3/3` `category 3/+` `no such reading taken` `no such reading taken` `no such reading taken` EQUALS `the pneumoconiosis score is` 85
-- s 4(3)(c) example: A and C: 100. B and C: 100.
#ASSERT `What is my pneumoconiosis score?` `category A` `category C` `no such reading taken` `no such reading taken` `no such reading taken` EQUALS `the pneumoconiosis score is` 100
#ASSERT `What is my pneumoconiosis score?` `category B` `category C` `no such reading taken` `no such reading taken` `no such reading taken` EQUALS `the pneumoconiosis score is` 100
-- 1/2 and 2/1 are not consecutive (schedule 6, s 3 example): a third reading is needed.
#ASSERT `What is my pneumoconiosis score?` `category 1/2` `category 2/1` `no such reading taken` `no such reading taken` `no such reading taken` EQUALS `a third reading of the same chest x-ray is needed (schedule 6, s 5)`
-- 0/- and 1/0: no s 4 rule.
#ASSERT `What is my pneumoconiosis score?` `category 0/-` `category 1/0` `no such reading taken` `no such reading taken` `no such reading taken` EQUALS `a third reading of the same chest x-ray is needed (schedule 6, s 5)`
-- s 5(4)(a) example: 1/2, 2/1, then 2/2: 55.
#ASSERT `What is my pneumoconiosis score?` `category 1/2` `category 2/1` `category 2/2` `no such reading taken` `no such reading taken` EQUALS `the pneumoconiosis score is` 55
-- s 5(4)(b) example: 3/+, A, then B: 95.
#ASSERT `What is my pneumoconiosis score?` `category 3/+` `category A` `category B` `no such reading taken` `no such reading taken` EQUALS `the pneumoconiosis score is` 95
-- s 5(3): the third matches the first: 2/1, 2/3, 2/1: 50.
#ASSERT `What is my pneumoconiosis score?` `category 2/1` `category 2/3` `category 2/1` `no such reading taken` `no such reading taken` EQUALS `the pneumoconiosis score is` 50
-- Finding 4 (READING): 2/1, 2/3, then 2/2 makes two consecutive pairs (55 and 60): the higher, 60.
#ASSERT `What is my pneumoconiosis score?` `category 2/1` `category 2/3` `category 2/2` `no such reading taken` `no such reading taken` EQUALS `the pneumoconiosis score is` 60
-- s 6 example: 1/2, 2/1, 2/3 settle nothing; fourth and fifth needed; with 1/2 and 2/1 the median is 2/1: 50.
#ASSERT `What is my pneumoconiosis score?` `category 1/2` `category 2/1` `category 2/3` `no such reading taken` `no such reading taken` EQUALS `a fourth and fifth reading of the same chest x-ray are needed (schedule 6, s 6)`
#ASSERT `What is my pneumoconiosis score?` `category 1/2` `category 2/1` `category 2/3` `category 1/2` `category 2/1` EQUALS `the pneumoconiosis score is` 50
-- Finding 3: 0/0, 1/1, then 0/1. Under s 4 two 0 categories would score 0, but s 5(4) has no such rule, so s 6
-- applies: with 0/0 and 1/0 the rows in order are 0/0, 0/0, 0/1, 1/0, 1/1; the median 0/1 scores 0.
#ASSERT `What is my pneumoconiosis score?` `category 0/0` `category 1/1` `category 0/1` `no such reading taken` `no such reading taken` EQUALS `a fourth and fifth reading of the same chest x-ray are needed (schedule 6, s 6)`
#ASSERT `What is my pneumoconiosis score?` `category 0/0` `category 1/1` `category 0/1` `category 0/0` `category 1/0` EQUALS `the pneumoconiosis score is` 0

-- Schedule 7: score 100 at 72: 80.97 x 1,994.50 = 161,494.665, less 2 x 5% = 10%: 145,345.1985.
#ASSERT `What lump sum does my pneumoconiosis give me?` 100 72 `1 Oct 2026` 0 EQUALS JUST 145345.1985
