IMPORT prelude
IMPORT `lpa-dates`
IMPORT `lpa-core`
IMPORT `lpa-seat`

-- Legal Profession Act 2007 (Qld), Part 3.4 -- cases from the seat of the client. Every expected value was worked by
-- hand from the deposited text (the section is named above each group, with the arithmetic), never copied from the
-- encoding's output. Edges: the s 300 thresholds ($1,500 and $3,000, and a cent over), the s 324(4) cap (exactly 25%
-- and a cent over), the last day of each period (s 332(2) 28 days, s 329 / s 332 30 days, s 321 30 days, s 335 12
-- months, the cooling-off days), and the s 342 15% reduction (exactly and a cent under).
--
-- The two regulative rules are tested with EVALTRACE ... EQUALS FULFILLED where the trace ends fulfilled, and with a
-- #TRACE carrying an "-- expect:" line where it ends in a breach. Clock: days from day 0.
--
-- BASELINE. Not for public use as advice. See NOTES.md.

`d` MEANS DATE_FROM_DMY

-- =====================================================================================================================
-- Date helpers (lpa-dates.l4).
-- =====================================================================================================================
-- 12 months after 29 February 2024: 2025 has no 29 February, so 28 February 2025.
#ASSERT `the day` 12 `months after` (`d` 29 2 2024) EQUALS `d` 28 2 2025
-- 12 months after 15 March 2025 is 15 March 2026.
#ASSERT `the day` 12 `months after` (`d` 15 3 2025) EQUALS `d` 15 3 2026
-- 28 days after 1 February 2028 (a leap year) is 29 February 2028.
#ASSERT `the day` 28 `days after` (`d` 1 2 2028) EQUALS `d` 29 2 2028

-- =====================================================================================================================
-- §§ Does Part 3.4 apply (ss 302-304)
-- Arguments: first instructed in Qld; cannot be decided; work mainly in / connected with Qld; accepted offer; gave
-- notice; notice more than 28 days late; work mainly elsewhere / connected elsewhere; chose the other law.
-- =====================================================================================================================
-- First instructions in Queensland: s 302.
#ASSERT `Does Queensland's costs law apply to my matter` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `yes: the client first instructed the law practice in this jurisdiction (s 302)`
-- First instructed in New South Wales, but the work is mainly in Queensland and the client accepted a written offer: s 303.
#ASSERT `Does Queensland's costs law apply to my matter` FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS `yes: by the client's acceptance of a written offer, or written notice, under s 303`
-- The same, by a written notice given in time: s 303(1)(c)(ii).
#ASSERT `Does Queensland's costs law apply to my matter` FALSE FALSE TRUE FALSE TRUE FALSE FALSE FALSE EQUALS `yes: by the client's acceptance of a written offer, or written notice, under s 303`
-- A notice given more than 28 days after being told of the right has no effect (s 303(4)), and there was no offer.
#ASSERT `Does Queensland's costs law apply to my matter` FALSE FALSE TRUE FALSE TRUE TRUE FALSE FALSE EQUALS `no: neither s 302 nor s 303 applies Part 3.4 on these facts`
-- No connection with Queensland: an accepted offer is not enough (s 303(1)(b)).
#ASSERT `Does Queensland's costs law apply to my matter` FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS `no: neither s 302 nor s 303 applies Part 3.4 on these facts`
-- Where first instructed cannot be decided, with a Queensland connection and an offer: s 303(1)(a)(ii).
#ASSERT `Does Queensland's costs law apply to my matter` FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS `yes: by the client's acceptance of a written offer, or written notice, under s 303`
-- First instructed in Queensland, the work is mainly in Victoria and the client chose the Victorian law: displaced (s 304).
#ASSERT `Does Queensland's costs law apply to my matter` TRUE FALSE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS `no: Part 3.4 has been displaced by the corresponding law of another jurisdiction (s 304)`
-- The work is mainly in Victoria but the client made no choice: s 302 still applies.
#ASSERT `Does Queensland's costs law apply to my matter` TRUE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS `yes: the client first instructed the law practice in this jurisdiction (s 302)`

-- =====================================================================================================================
-- §§ What my law practice must tell me (ss 307A, 307B, 308, 311)
-- Arguments: likely legal costs; listed in s 311(1)(c); tender; will not pay; disclosure in last 12 months; written
-- waiver; principal's decision.
-- =====================================================================================================================
-- Exactly $1,500 is "not likely to exceed" the disclosure threshold amount: s 307A.
#ASSERT `What must my law practice tell me about costs` 1500 FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `no disclosure is required: the legal costs are not likely to exceed the disclosure threshold amount (s 307A)`
-- A cent over $1,500, and not over $3,000: s 307B may be used, otherwise s 308(2).
#ASSERT `What must my law practice tell me about costs` 1500.01 FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `abbreviated disclosure under s 307B, or detailed disclosure under s 308; if there is no s 307B disclosure, s 308 applies`
#ASSERT `What must my law practice tell me about costs` 3000 FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `abbreviated disclosure under s 307B, or detailed disclosure under s 308; if there is no s 307B disclosure, s 308 applies`
-- A cent over $3,000: s 308(1), in writing (s 310A(3)).
#ASSERT `What must my law practice tell me about costs` 3000.01 FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `detailed disclosure in writing under s 308`
-- A personal injury claim likely to cost $60,000: detailed disclosure.
#ASSERT `What must my law practice tell me about costs` 60000 FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `detailed disclosure in writing under s 308`
-- A public company (s 311(1)(c)(ii)), and costs agreed by tender (s 311(1)(d)): sophisticated clients.
#ASSERT `What must my law practice tell me about costs` 60000 TRUE FALSE FALSE FALSE FALSE FALSE EQUALS `no disclosure is required: the client is a sophisticated client (s 311(1)(c)-(d))`
#ASSERT `What must my law practice tell me about costs` 60000 FALSE TRUE FALSE FALSE FALSE FALSE EQUALS `no disclosure is required: the client is a sophisticated client (s 311(1)(c)-(d))`
-- Pro bono: s 311(1)(e).
#ASSERT `What must my law practice tell me about costs` 60000 FALSE FALSE TRUE FALSE FALSE FALSE EQUALS `no disclosure is required: the client will not be required to pay the legal costs (s 311(1)(e))`
-- All three limbs of s 311(1)(b): not required, if the principal decided on reasonable grounds.
#ASSERT `What must my law practice tell me about costs` 60000 FALSE FALSE FALSE TRUE TRUE TRUE EQUALS `no disclosure is required, if the principal's decision that further disclosure is not warranted was made on reasonable grounds (s 311(1)(b))`
-- A waiver without the principal's decision is not enough.
#ASSERT `What must my law practice tell me about costs` 60000 FALSE FALSE FALSE TRUE TRUE FALSE EQUALS `detailed disclosure in writing under s 308`

-- s 313: arguments: uplift fee; listed in s 311(1)(c); tender.
#ASSERT `Must my law practice explain the uplift fee in writing first` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Must my law practice explain the uplift fee in writing first` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Must my law practice explain the uplift fee in writing first` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Must my law practice explain the uplift fee in writing first` TRUE FALSE TRUE EQUALS JUST FALSE

-- s 316: arguments: failed to disclose; failure solely because of the retained law practice; assessed.
#ASSERT `Need I pay costs that were not properly disclosed` FALSE FALSE FALSE EQUALS `s 316 does not hold back these costs: the law practice made every disclosure Division 3 required`
#ASSERT `Need I pay costs that were not properly disclosed` TRUE FALSE FALSE EQUALS `I need not pay these costs unless they have been assessed, and the law practice cannot sue me for them until then (s 316(1)-(2))`
#ASSERT `Need I pay costs that were not properly disclosed` TRUE FALSE TRUE EQUALS `the costs have been assessed, so s 316(1)-(2) no longer hold them back; the assessment may have reduced them for the failure (s 316(4))`
#ASSERT `Need I pay costs that were not properly disclosed` TRUE TRUE FALSE EQUALS `s 316(1)-(4) do not apply to the first law practice's own costs, to the extent its failure was caused by the retained law practice (s 316(5)(a))`

-- s 317: arguments: report; listed; tender; asking a retained law practice.
#ASSERT `Can I get a written report, and must I pay for it` `a written report of the progress of the matter` FALSE FALSE FALSE EQUALS `yes, on reasonable request; the law practice may charge a reasonable amount for it (s 317(1)(a), (2))`
#ASSERT `Can I get a written report, and must I pay for it` `a written report of the legal costs incurred to date or since the last bill` FALSE FALSE FALSE EQUALS `yes, on reasonable request, and the law practice must not charge for it (s 317(1)(b), (2))`
#ASSERT `Can I get a written report, and must I pay for it` `a written report of the legal costs incurred to date or since the last bill` TRUE FALSE FALSE EQUALS `no: a law practice need not give a report to a sophisticated client (s 317(5))`
#ASSERT `Can I get a written report, and must I pay for it` `a written report of the progress of the matter` FALSE FALSE TRUE EQUALS `not from this law practice: it was retained by my law practice, which must give me the report (s 317(3))`

-- =====================================================================================================================
-- §§ My costs agreement (ss 322-327)
-- A helper fixes the facts of a compliant written "no win, no fee" agreement and varies the ones the cases test.
-- =====================================================================================================================
GIVEN `x written` IS A BOOLEAN
      `x excludes assessment` IS A BOOLEAN
      `x conditional` IS A BOOLEAN
      `x criminal` IS A BOOLEAN
      `x signed` IS A BOOLEAN
      `x cooling days` IS A NUMBER
      `x uplift` IS A NUMBER
      `x costs` IS A NUMBER
      `x litigious` IS A BOOLEAN
      `x share` IS A BOOLEAN
      `x scale` IS A BOOLEAN
      `x listed client` IS A BOOLEAN
GIVETH A `Void answer`
`void answer for` `x written` `x excludes assessment` `x conditional` `x criminal` `x signed` `x cooling days` `x uplift` `x costs` `x litigious` `x share` `x scale` `x listed client` MEANS
    `Is my costs agreement void` `x written` FALSE TRUE `x excludes assessment` `x conditional` `x criminal` TRUE `x written` TRUE `x signed` TRUE `x cooling days` (`x uplift` GREATER THAN 0) TRUE TRUE `x litigious` `x uplift` `x costs` `x share` `x scale` FALSE `x listed client` FALSE

GIVEN `x written` IS A BOOLEAN
      `x excludes assessment` IS A BOOLEAN
      `x conditional` IS A BOOLEAN
      `x criminal` IS A BOOLEAN
      `x signed` IS A BOOLEAN
      `x cooling days` IS A NUMBER
      `x uplift` IS A NUMBER
      `x costs` IS A NUMBER
      `x litigious` IS A BOOLEAN
      `x share` IS A BOOLEAN
      `x scale` IS A BOOLEAN
      `x listed client` IS A BOOLEAN
GIVETH A LIST OF `Contravention`
`rules broken for` `x written` `x excludes assessment` `x conditional` `x criminal` `x signed` `x cooling days` `x uplift` `x costs` `x litigious` `x share` `x scale` `x listed client` MEANS
    `What rules does my costs agreement break` `x written` FALSE TRUE `x excludes assessment` `x conditional` `x criminal` TRUE `x written` TRUE `x signed` TRUE `x cooling days` (`x uplift` GREATER THAN 0) TRUE TRUE `x litigious` `x uplift` `x costs` `x share` `x scale` FALSE `x listed client` FALSE

-- Arguments to the helpers: written; excludes assessment; conditional; criminal/family; signed; cooling-off days; uplift
-- fee; undiscounted costs; litigious; share of recovery; adopts scale; listed in s 311(1)(c).

-- V1. A compliant "no win, no fee" agreement for a personal injury claim going to court: costs $100,000, uplift exactly
-- 25% = $25,000, 5 clear business days of cooling-off. Not void.
#ASSERT `void answer for` TRUE FALSE TRUE FALSE TRUE 5 25000 100000 TRUE FALSE FALSE FALSE EQUALS `not void under s 327(1) on these facts: it may be enforced like any other contract, subject to Divisions 5 and 7 (s 326)`
#ASSERT `rules broken for` TRUE FALSE TRUE FALSE TRUE 5 25000 100000 TRUE FALSE FALSE FALSE EQUALS EMPTY
-- V2. A cent over 25%: $25,000.01 > 0.25 x 100,000. Void, and no uplift fee (s 327(4)).
#ASSERT `void answer for` TRUE FALSE TRUE FALSE TRUE 5 25000.01 100000 TRUE FALSE FALSE FALSE EQUALS `void (s 327(1)), and the law practice may not recover any of the uplift fee and must repay any uplift fee received; other costs only under the scale or at fair and reasonable value, capped at the agreement (s 327(2)-(4))`
#ASSERT `rules broken for` TRUE FALSE TRUE FALSE TRUE 5 25000.01 100000 TRUE FALSE FALSE FALSE EQUALS LIST `the uplift fee is more than 25% of the legal costs otherwise payable (s 324(4))`
-- V3. The same uplift in a matter not going to court: s 324(4) sets no cap; not void.
#ASSERT `void answer for` TRUE FALSE TRUE FALSE TRUE 5 40000 100000 FALSE FALSE FALSE FALSE EQUALS `not void under s 327(1) on these facts: it may be enforced like any other contract, subject to Divisions 5 and 7 (s 326)`
-- V4. Only 4 clear business days of cooling-off: void under s 327(1), costs on the scale or fair value (s 327(2)-(3)).
#ASSERT `void answer for` TRUE FALSE TRUE FALSE TRUE 4 25000 100000 TRUE FALSE FALSE FALSE EQUALS `void (s 327(1)): the law practice may recover costs only under the applicable scale or at fair and reasonable value, and never more than the agreement would have given it; any excess must be repaid (s 327(2)-(3))`
#ASSERT `rules broken for` TRUE FALSE TRUE FALSE TRUE 4 25000 100000 TRUE FALSE FALSE FALSE EQUALS LIST `a cooling-off period of less than 5 clear business days (s 323(3)(e))`
-- V5. Not signed by the client: void.
#ASSERT `rules broken for` TRUE FALSE TRUE FALSE FALSE 5 25000 100000 TRUE FALSE FALSE FALSE EQUALS LIST `a conditional costs agreement not signed by the client (s 323(3)(c)(iii))`
-- V6. A public company (sophisticated client), unsigned and with no cooling-off: s 323(4)(b) lifts both; not void.
#ASSERT `void answer for` TRUE FALSE TRUE FALSE FALSE 0 25000 100000 TRUE FALSE FALSE TRUE EQUALS `not void under s 327(1) on these facts: it may be enforced like any other contract, subject to Divisions 5 and 7 (s 326)`
-- V7. A contingency fee (a share of the damages): void, and nothing is recoverable (s 327(5)).
#ASSERT `void answer for` TRUE FALSE FALSE FALSE TRUE 5 0 100000 TRUE TRUE FALSE FALSE EQUALS `void (s 327(1)), and the law practice may recover nothing for its legal services in the matter and must repay everything received for them (s 327(5))`
-- V8. A fee by reference to the recovery that only adopts an applicable scale of costs: s 325(2); not void.
#ASSERT `void answer for` TRUE FALSE FALSE FALSE TRUE 5 0 100000 TRUE TRUE TRUE FALSE EQUALS `not void under s 327(1) on these facts: it may be enforced like any other contract, subject to Divisions 5 and 7 (s 326)`
-- V9. Both an uplift over the cap ($30,000 > $25,000) and a contingency fee: s 327(5) governs; both are listed, in order.
#ASSERT `void answer for` TRUE FALSE TRUE FALSE TRUE 5 30000 100000 TRUE TRUE FALSE FALSE EQUALS `void (s 327(1)), and the law practice may recover nothing for its legal services in the matter and must repay everything received for them (s 327(5))`
#ASSERT `rules broken for` TRUE FALSE TRUE FALSE TRUE 5 30000 100000 TRUE TRUE FALSE FALSE EQUALS LIST `the uplift fee is more than 25% of the legal costs otherwise payable (s 324(4))`, `a contingency fee: the amount is calculated by reference to the award, settlement or property recovered (s 325(1))`
-- V10. An agreement excluding costs assessment: void for a client who is not sophisticated (s 322(5)); allowed for a
-- sophisticated client (s 344).
#ASSERT `rules broken for` TRUE TRUE FALSE FALSE TRUE 0 0 100000 TRUE FALSE FALSE FALSE EQUALS LIST `it says the costs are not subject to costs assessment (s 322(5))`
#ASSERT `void answer for` TRUE TRUE FALSE FALSE TRUE 0 0 100000 TRUE FALSE FALSE TRUE EQUALS `not void under s 327(1) on these facts: it may be enforced like any other contract, subject to Divisions 5 and 7 (s 326)`
-- V11. An ordinary hourly-rate agreement in writing, unsigned, no cooling-off: the conditional rules do not apply; not void.
#ASSERT `void answer for` TRUE FALSE FALSE FALSE FALSE 0 0 100000 TRUE FALSE FALSE FALSE EQUALS `not void under s 327(1) on these facts: it may be enforced like any other contract, subject to Divisions 5 and 7 (s 326)`
-- V12. A "no win, no fee" agreement in a criminal matter: void (s 323(2)).
#ASSERT `rules broken for` TRUE FALSE TRUE TRUE TRUE 5 0 100000 TRUE FALSE FALSE FALSE EQUALS LIST `a conditional costs agreement in a matter involving criminal or Family Law Act proceedings (s 323(2))`
-- V13. An oral "no win, no fee" agreement: not written or evidenced in writing (s 322(2)) and not in writing (s 323(3)(c)(i)).
#ASSERT `rules broken for` FALSE FALSE TRUE FALSE TRUE 5 0 100000 TRUE FALSE FALSE FALSE EQUALS LIST `not written or evidenced in writing (s 322(2))`, `a conditional costs agreement not in writing (s 323(3)(c)(i))`
-- V14. An uplift fee alone makes the agreement conditional (s 300): with "payment depends on winning" answered no but
-- an uplift fee and no cooling-off, the cooling-off rule still applies.
#ASSERT `rules broken for` TRUE FALSE FALSE FALSE TRUE 0 10000 100000 TRUE FALSE FALSE FALSE EQUALS LIST `a cooling-off period of less than 5 clear business days (s 323(3)(e))`
-- V15. The offer route: an agreement made by accepting an offer that did not state the s 322(4) matters.
#ASSERT `Is my costs agreement void` TRUE TRUE FALSE FALSE FALSE FALSE TRUE TRUE TRUE TRUE TRUE 0 FALSE TRUE TRUE FALSE 0 5000 FALSE FALSE FALSE FALSE FALSE EQUALS `void (s 327(1)): the law practice may recover costs only under the applicable scale or at fair and reasonable value, and never more than the agreement would have given it; any excess must be repaid (s 327(2)-(3))`
-- V16. The uplift basis not separately identified, and no estimate: two s 324 contraventions.
#ASSERT `What rules does my costs agreement break` TRUE FALSE TRUE FALSE TRUE FALSE TRUE TRUE TRUE TRUE TRUE 5 TRUE FALSE FALSE TRUE 10000 100000 FALSE FALSE FALSE FALSE FALSE EQUALS LIST `the basis of the uplift fee is not separately identified (s 324(2))`, `no estimate, or range of estimates, of the uplift fee (s 324(3))`
-- V17. Transfer of the client's interest in the proceedings: s 325(3), nothing recoverable (s 327(5)).
#ASSERT `Is my costs agreement void` TRUE FALSE TRUE FALSE FALSE FALSE TRUE TRUE TRUE TRUE TRUE 0 FALSE TRUE TRUE TRUE 0 5000 FALSE FALSE TRUE FALSE FALSE EQUALS `void (s 327(1)), and the law practice may recover nothing for its legal services in the matter and must repay everything received for them (s 327(5))`

-- s 324(4)-(5): 25% of the undiscounted legal costs. $100,000 -> $25,000; a practice that discounts $100,000 of fees
-- to $80,000 is still capped at 25% of $100,000; $80,000 undiscounted -> $20,000. Not litigious: no cap.
#ASSERT `What is the most uplift fee I can be charged` TRUE 100000 EQUALS JUST 25000
#ASSERT `What is the most uplift fee I can be charged` TRUE 80000 EQUALS JUST 20000
#ASSERT `What is the most uplift fee I can be charged` FALSE 100000 EQUALS NOTHING

-- s 323(3)(e), (5): arguments: payment depends on winning; uplift fee; listed; tender; cooling-off days; business days
-- ended before the notice. A 5-day period: 4 days ended -> in time; 5 ended -> over.
#ASSERT `Can I still cool off from my conditional costs agreement` TRUE FALSE FALSE FALSE 5 4 EQUALS `yes: I may terminate by written notice; the law practice may then recover only the costs of work done before termination on my instructions and with my knowledge that it would be done in the period, and no uplift fee (s 323(5))`
#ASSERT `Can I still cool off from my conditional costs agreement` TRUE FALSE FALSE FALSE 5 5 EQUALS `no: the cooling-off period in the agreement has ended`
-- A 10-day period: 9 ended -> in time; 10 ended -> over.
#ASSERT `Can I still cool off from my conditional costs agreement` TRUE TRUE FALSE FALSE 10 9 EQUALS `yes: I may terminate by written notice; the law practice may then recover only the costs of work done before termination on my instructions and with my knowledge that it would be done in the period, and no uplift fee (s 323(5))`
#ASSERT `Can I still cool off from my conditional costs agreement` TRUE TRUE FALSE FALSE 10 10 EQUALS `no: the cooling-off period in the agreement has ended`
-- An uplift fee alone makes it conditional.
#ASSERT `Can I still cool off from my conditional costs agreement` FALSE TRUE FALSE FALSE 5 0 EQUALS `yes: I may terminate by written notice; the law practice may then recover only the costs of work done before termination on my instructions and with my knowledge that it would be done in the period, and no uplift fee (s 323(5))`
#ASSERT `Can I still cool off from my conditional costs agreement` FALSE FALSE FALSE FALSE 5 0 EQUALS `s 323 gives no cooling-off: this is not a conditional costs agreement`
#ASSERT `Can I still cool off from my conditional costs agreement` TRUE FALSE TRUE FALSE 5 0 EQUALS `s 323(3)(e) does not apply to a sophisticated client (s 323(4)(b)); any cooling-off is only what the agreement says`
#ASSERT `Can I still cool off from my conditional costs agreement` TRUE FALSE FALSE FALSE 3 0 EQUALS `the agreement is void: its cooling-off period is shorter than 5 clear business days (ss 323(3)(e), 327(1))`

-- s 328.
#ASSERT `Can I ask to have my costs agreement set aside` TRUE EQUALS `yes: I may apply to the Supreme Court or QCAT, which may set the agreement aside if satisfied it is not fair or reasonable; it may then order what I pay, but not more than the agreement would have allowed (s 328(1), (4)-(6))`
#ASSERT `Can I ask to have my costs agreement set aside` FALSE EQUALS `no: only a client (a person to whom or for whom the legal services are or were provided), or an associated third party payer that is a party to the agreement, may apply (ss 322(6), 328(1), (10))`

-- =====================================================================================================================
-- §§ My bill (ss 321, 329, 332, 338, 316(2))
-- When can my law practice sue me. Arguments: bill given; bill day; lump sum; asked for itemised; day asked; itemised
-- given; day given; failed to disclose; assessed; assessment under way. Bill given 1 March 2026: + 30 = 31 March 2026.
-- =====================================================================================================================
#ASSERT `When can my law practice sue me for its costs` FALSE `a date not used` FALSE FALSE `a date not used` FALSE `a date not used` FALSE FALSE FALSE EQUALS `not yet: the law practice must first give me a bill (s 329(1))`
#ASSERT `When can my law practice sue me for its costs` TRUE (`d` 1 3 2026) FALSE FALSE `a date not used` FALSE `a date not used` FALSE FALSE FALSE EQUALS `not before` (`d` 31 3 2026)
-- A lump sum bill with an itemised bill asked for on 31 March 2026, the 30th day (in time): wait for the itemised bill.
#ASSERT `When can my law practice sue me for its costs` TRUE (`d` 1 3 2026) TRUE TRUE (`d` 31 3 2026) FALSE `a date not used` FALSE FALSE FALSE EQUALS `not until 30 days after it gives me the itemised bill I asked for (s 332(5))`
-- Itemised bill given 20 April 2026: + 30 = 20 May 2026.
#ASSERT `When can my law practice sue me for its costs` TRUE (`d` 1 3 2026) TRUE TRUE (`d` 31 3 2026) TRUE (`d` 20 4 2026) FALSE FALSE FALSE EQUALS `not before` (`d` 20 5 2026)
-- Asked on 1 April 2026, the 31st day: s 332(5) does not apply; 31 March 2026 stands (s 332(4)).
#ASSERT `When can my law practice sue me for its costs` TRUE (`d` 1 3 2026) TRUE TRUE (`d` 1 4 2026) FALSE `a date not used` FALSE FALSE FALSE EQUALS `not before` (`d` 31 3 2026)
-- A disclosure failure, not yet assessed: s 316(2). Once assessed, the ordinary 30 days.
#ASSERT `When can my law practice sue me for its costs` TRUE (`d` 1 3 2026) FALSE FALSE `a date not used` FALSE `a date not used` TRUE FALSE FALSE EQUALS `not until the costs have been assessed: the law practice did not make the disclosures Division 3 required (s 316(2))`
#ASSERT `When can my law practice sue me for its costs` TRUE (`d` 1 3 2026) FALSE FALSE `a date not used` FALSE `a date not used` TRUE TRUE FALSE EQUALS `not before` (`d` 31 3 2026)
-- An assessment under way: s 338(b).
#ASSERT `When can my law practice sue me for its costs` TRUE (`d` 1 3 2026) FALSE FALSE `a date not used` FALSE `a date not used` FALSE FALSE TRUE EQUALS `not until the costs assessment is completed, unless the court gives leave (s 338(b))`

-- s 329(1) as a rule. Day 0: the bill. Proceedings on day 30 are allowed: the prohibition ran through day 29.
#ASSERT EVALTRACE `s 329(1) -- the law practice must not start recovery proceedings until 30 days after the bill` 0 (LIST (EVENT `the law practice` `start proceedings to recover the legal costs` 30)) EQUALS FULFILLED
-- expect: BREACH BY the law practice, "s 329(1): proceedings to recover legal costs were started less than 30 days after the bill was given; the court must stay them (s 329(3))" (proceedings on day 29)
#TRACE `s 329(1) -- the law practice must not start recovery proceedings until 30 days after the bill` AT 0 WITH
    PARTY `the law practice` DOES `start proceedings to recover the legal costs` AT 29

-- s 332(2): itemised bill asked for on 5 January 2026: + 28 = 2 February 2026. Arguments: lump sum; day asked;
-- given; day given; day asked about.
#ASSERT `By when must I get my itemised bill` FALSE (`d` 5 1 2026) FALSE `a date not used` (`d` 10 1 2026) EQUALS `s 332 gives no right to an itemised bill: the bill I was given is already itemised`
#ASSERT `By when must I get my itemised bill` TRUE (`d` 5 1 2026) FALSE `a date not used` (`d` 2 2 2026) EQUALS `the law practice must give it to me free of charge by` (`d` 2 2 2026)
#ASSERT `By when must I get my itemised bill` TRUE (`d` 5 1 2026) FALSE `a date not used` (`d` 3 2 2026) EQUALS `the law practice is late: it had to give it to me by` (`d` 2 2 2026)
#ASSERT `By when must I get my itemised bill` TRUE (`d` 5 1 2026) TRUE (`d` 2 2 2026) (`d` 10 2 2026) EQUALS `it was given in time (s 332(2))`
#ASSERT `By when must I get my itemised bill` TRUE (`d` 5 1 2026) TRUE (`d` 3 2 2026) (`d` 10 2 2026) EQUALS `the law practice is late: it had to give it to me by` (`d` 2 2 2026)
-- Asked on 1 February 2028 (leap year): + 28 = 29 February 2028.
#ASSERT `By when must I get my itemised bill` TRUE (`d` 1 2 2028) FALSE `a date not used` (`d` 1 2 2028) EQUALS `the law practice must give it to me free of charge by` (`d` 29 2 2028)

-- s 332(2) as a rule. Day 0: the request. Given on day 28: in time.
#ASSERT EVALTRACE `s 332(2) -- the law practice must give the itemised bill within 28 days after the request` 0 (LIST (EVENT `the law practice` `give the itemised bill` 28)) EQUALS FULFILLED
-- expect: BREACH BY the law practice, "s 332(2): the itemised bill was not given within 28 days after the request" (given on day 29)
#TRACE `s 332(2) -- the law practice must give the itemised bill within 28 days after the request` AT 0 WITH
    PARTY `the law practice` DOES `give the itemised bill` AT 29

-- s 321: arguments: agreement provides interest; bill day; bill states interest and rate; rate; maximum rate; day
-- asked about. Bill given 10 June 2026: + 30 = 10 July 2026.
#ASSERT `Can my law practice charge me interest` TRUE (`d` 10 6 2026) FALSE 8 10 (`d` 1 8 2026) EQUALS `no: the bill does not state that interest is payable and the rate (s 321(2))`
#ASSERT `Can my law practice charge me interest` TRUE (`d` 10 6 2026) TRUE 12 10 (`d` 1 8 2026) EQUALS `no: the rate is more than the rate prescribed by regulation (s 321(3))`
#ASSERT `Can my law practice charge me interest` TRUE (`d` 10 6 2026) TRUE 10 10 (`d` 11 6 2026) EQUALS `yes, under the costs agreement (s 321(1)(a))`
#ASSERT `Can my law practice charge me interest` FALSE (`d` 10 6 2026) TRUE 8 10 (`d` 10 7 2026) EQUALS `yes: the costs have been unpaid 30 days or more after the bill (s 321(1)(b))`
#ASSERT `Can my law practice charge me interest` FALSE (`d` 10 6 2026) TRUE 8 10 (`d` 9 7 2026) EQUALS `not yet: interest can run only once the costs are unpaid 30 days after the bill, from` (`d` 10 7 2026)

-- =====================================================================================================================
-- §§ Costs assessment (ss 335, 340, 342)
-- s 335(5)-(6): arguments: bill or request; its day; paid; day paid; listed; tender; day of application.
-- Bill given 15 March 2025: + 12 months = 15 March 2026.
-- =====================================================================================================================
#ASSERT `By when must I apply for a costs assessment` TRUE (`d` 15 3 2025) FALSE `a date not used` FALSE FALSE (`d` 15 3 2026) EQUALS `in time: I may apply up to and including` (`d` 15 3 2026)
#ASSERT `By when must I apply for a costs assessment` TRUE (`d` 15 3 2025) FALSE `a date not used` FALSE FALSE (`d` 16 3 2026) EQUALS `out of time, but a costs assessor or the court may still deal with it after considering my reasons for the delay (s 335(6)); the last day was` (`d` 15 3 2026)
#ASSERT `By when must I apply for a costs assessment` TRUE (`d` 15 3 2025) FALSE `a date not used` TRUE FALSE (`d` 16 3 2026) EQUALS `out of time, and as a sophisticated client a late application cannot be dealt with under s 335(6); the last day was` (`d` 15 3 2026)
-- No bill or request; paid on 29 February 2024: + 12 months = 28 February 2025.
#ASSERT `By when must I apply for a costs assessment` FALSE `a date not used` TRUE (`d` 29 2 2024) FALSE FALSE (`d` 28 2 2025) EQUALS `in time: I may apply up to and including` (`d` 28 2 2025)
#ASSERT `By when must I apply for a costs assessment` FALSE `a date not used` TRUE (`d` 29 2 2024) FALSE FALSE (`d` 1 3 2025) EQUALS `out of time, but a costs assessor or the court may still deal with it after considering my reasons for the delay (s 335(6)); the last day was` (`d` 28 2 2025)
-- A bill and a later payment: the bill starts the 12 months (s 335(5)(a)).
#ASSERT `By when must I apply for a costs assessment` TRUE (`d` 15 3 2025) TRUE (`d` 1 6 2025) FALSE FALSE (`d` 1 5 2026) EQUALS `out of time, but a costs assessor or the court may still deal with it after considering my reasons for the delay (s 335(6)); the last day was` (`d` 15 3 2026)
#ASSERT `By when must I apply for a costs assessment` FALSE `a date not used` FALSE `a date not used` FALSE FALSE (`d` 1 5 2026) EQUALS `no time limit has started: there has been no bill, request for payment or payment`

-- s 340: arguments: agreement fixes amount or rate; set aside; assessor satisfied of an exception.
#ASSERT `Will the assessor go by my costs agreement` TRUE FALSE FALSE EQUALS `the costs assessor must assess the disputed costs by the costs agreement (s 340(1))`
#ASSERT `Will the assessor go by my costs agreement` FALSE FALSE FALSE EQUALS `s 340 does not tie the assessment to the agreement: no provision of it fixes the amount, or a rate or other means of calculating it (s 340(1)(a))`
#ASSERT `Will the assessor go by my costs agreement` TRUE TRUE FALSE EQUALS `s 340 does not tie the assessment to the agreement: it has been set aside under s 328 (s 340(1)(b))`
#ASSERT `Will the assessor go by my costs agreement` TRUE FALSE TRUE EQUALS `not by the agreement: the assessor is satisfied of a material disclosure failure, that Division 5 precludes recovery, or the parties agree otherwise (s 340(1)(c)-(e)); the costs are assessed as fair and reasonable (s 341)`

-- s 342: $10,000 billed, $8,500 assessed: reduced by $1,500 = 15% -> the law practice pays. $8,500.01: reduced by
-- $1,499.99, under 15% -> whoever the assessor orders, unless a Division 3 failure.
#ASSERT `Who pays for my costs assessment` 10000 8500 FALSE EQUALS `the law practice pays the costs of the assessment, unless the costs assessor orders otherwise (s 342(2))`
#ASSERT `Who pays for my costs assessment` 10000 8500.01 FALSE EQUALS `whoever the costs assessor orders pays the costs of the assessment (s 342(3))`
#ASSERT `Who pays for my costs assessment` 10000 8500.01 TRUE EQUALS `the law practice pays the costs of the assessment, unless the costs assessor orders otherwise (s 342(2))`
#ASSERT `Who pays for my costs assessment` 10000 10000 FALSE EQUALS `whoever the costs assessor orders pays the costs of the assessment (s 342(3))`
