IMPORT prelude
IMPORT `hoq-common`
IMPORT `hoq-outcomes`

-- Worked cases for hoq-outcomes.l4. Every expected value was worked by hand from the text.
-- BASELINE ENCODING. Not for public use as advice. See NOTES.md.

GIVETH A LIST OF NUMBER
`no extensions` MEANS EMPTY

-- ===================================================================================================================
-- s 85 -- the due day of an investigation
-- ===================================================================================================================

-- Decided 15 March 2026: 1 year -> 15 March 2027.
#ASSERT `By when must the investigation be completed question` (DATE_FROM_DMY 15 3 2026) `no extensions` FALSE EQUALS `the investigation must be completed by` (DATE_FROM_DMY 15 3 2027)
-- One extension of 3 months -> 15 June 2027.
#ASSERT `By when must the investigation be completed question` (DATE_FROM_DMY 15 3 2026) (LIST 3) FALSE EQUALS `the investigation must be completed by` (DATE_FROM_DMY 15 6 2027)
-- Two extensions, 1 then 2 months -> 15 April, then 15 June 2027.
#ASSERT `By when must the investigation be completed question` (DATE_FROM_DMY 15 3 2026) (LIST 1, 2) FALSE EQUALS `the investigation must be completed by` (DATE_FROM_DMY 15 6 2027)
-- An extension stated as 5 months counts as 3 (fork F8): 15 June, then 15 September 2027.
#ASSERT `By when must the investigation be completed question` (DATE_FROM_DMY 15 3 2026) (LIST 3, 5) FALSE EQUALS `the investigation must be completed by` (DATE_FROM_DMY 15 9 2027)
-- Decided 30 November 2026: 30 November 2027, plus 3 months -> 29 February 2028 (a leap year).
#ASSERT `By when must the investigation be completed question` (DATE_FROM_DMY 30 11 2026) (LIST 3) FALSE EQUALS `the investigation must be completed by` (DATE_FROM_DMY 29 2 2028)
-- A second 3 months runs from 29 February: 29 May 2028, not 30 May (finding 5).
#ASSERT `By when must the investigation be completed question` (DATE_FROM_DMY 30 11 2026) (LIST 3, 3) FALSE EQUALS `the investigation must be completed by` (DATE_FROM_DMY 29 5 2028)
-- Decided 29 February 2028: 1 year -> 28 February 2029 (fork F2).
#ASSERT `By when must the investigation be completed question` (DATE_FROM_DMY 29 2 2028) `no extensions` FALSE EQUALS `the investigation must be completed by` (DATE_FROM_DMY 28 2 2029)
#ASSERT `By when must the investigation be completed question` (DATE_FROM_DMY 15 3 2026) (LIST 3) TRUE EQUALS `s 85 does not apply: the Minister's direction to investigate states the time for completing it (s 85(9))`

-- s 85(4), (8): decided 15 March 2026.
#ASSERT `What follows from a long investigation question` (DATE_FROM_DMY 15 3 2026) FALSE (DATE_FROM_DMY 1 1 2026) (DATE_FROM_DMY 15 3 2027) FALSE EQUALS `nothing follows yet: it was completed, or is still within, 1 year after the decision`
#ASSERT `What follows from a long investigation question` (DATE_FROM_DMY 15 3 2026) FALSE (DATE_FROM_DMY 1 1 2026) (DATE_FROM_DMY 16 3 2027) FALSE EQUALS `it must be listed on the ombudsman's public register of investigations not completed within 1 year, without anything that identifies you (s 85(4)-(6))`
#ASSERT `What follows from a long investigation question` (DATE_FROM_DMY 15 3 2026) FALSE (DATE_FROM_DMY 1 1 2026) (DATE_FROM_DMY 15 3 2028) FALSE EQUALS `it must be listed on the ombudsman's public register of investigations not completed within 1 year, without anything that identifies you (s 85(4)-(6))`
#ASSERT `What follows from a long investigation question` (DATE_FROM_DMY 15 3 2026) FALSE (DATE_FROM_DMY 1 1 2026) (DATE_FROM_DMY 16 3 2028) FALSE EQUALS `it must be on the public register, and the Minister and the parliamentary committee must be told what it is about and why it is not complete (s 85(4), (8))`
-- Completed 10 March 2027, asked long after: within the year.
#ASSERT `What follows from a long investigation question` (DATE_FROM_DMY 15 3 2026) TRUE (DATE_FROM_DMY 10 3 2027) (DATE_FROM_DMY 1 1 2029) FALSE EQUALS `nothing follows yet: it was completed, or is still within, 1 year after the decision`
-- Completed 1 July 2027: it was on the register (1 year passed), not over 2 years.
#ASSERT `What follows from a long investigation question` (DATE_FROM_DMY 15 3 2026) TRUE (DATE_FROM_DMY 1 7 2027) (DATE_FROM_DMY 1 1 2029) FALSE EQUALS `it must be listed on the ombudsman's public register of investigations not completed within 1 year, without anything that identifies you (s 85(4)-(6))`
#ASSERT `What follows from a long investigation question` (DATE_FROM_DMY 15 3 2026) FALSE (DATE_FROM_DMY 1 1 2026) (DATE_FROM_DMY 16 3 2028) TRUE EQUALS `s 85 does not apply: the Minister's direction states the time (s 85(9))`

-- s 84: progress reports.
#ASSERT `By when must I get the next progress report question` TRUE FALSE FALSE (DATE_FROM_DMY 15 1 2026) FALSE (DATE_FROM_DMY 1 1 2026) EQUALS `the next progress report is due by` (DATE_FROM_DMY 15 4 2026)
-- Last report 30 November 2026: 3 months -> 28 February 2027.
#ASSERT `By when must I get the next progress report question` TRUE FALSE FALSE (DATE_FROM_DMY 15 1 2026) TRUE (DATE_FROM_DMY 30 11 2026) EQUALS `the next progress report is due by` (DATE_FROM_DMY 28 2 2027)
#ASSERT `By when must I get the next progress report question` TRUE FALSE FALSE (DATE_FROM_DMY 15 1 2026) TRUE (DATE_FROM_DMY 31 5 2027) EQUALS `the next progress report is due by` (DATE_FROM_DMY 31 8 2027)
#ASSERT `By when must I get the next progress report question` TRUE TRUE FALSE (DATE_FROM_DMY 15 1 2026) FALSE (DATE_FROM_DMY 1 1 2026) EQUALS `none is owed to you while your waiver stands (s 84(2)); you may withdraw it before the investigation is complete (s 84(3))`
#ASSERT `By when must I get the next progress report question` FALSE FALSE FALSE (DATE_FROM_DMY 15 1 2026) FALSE (DATE_FROM_DMY 1 1 2026) EQUALS `none is owed to you: the investigation does not relate to your complaint (s 84(1)(b))`
#ASSERT `By when must I get the next progress report question` TRUE FALSE TRUE (DATE_FROM_DMY 15 1 2026) FALSE (DATE_FROM_DMY 1 1 2026) EQUALS `none is owed: the investigation is complete`

-- ===================================================================================================================
-- What must I be told
-- ===================================================================================================================

#ASSERT `Must I be told question` `the ombudsman made a decision on my complaint (to act, take no further action, or not accept it)` TRUE FALSE EQUALS `yes: notice of the decision, the action to be taken and the reasons, within 5 business days (s 278)`
#ASSERT `Must I be told question` `the ombudsman made a decision on my complaint (to act, take no further action, or not accept it)` TRUE TRUE EQUALS `no: you waived notice of decisions (s 278(4))`
#ASSERT `Must I be told question` `the complaint was referred to Ahpra at its request after the ombudsman proposed no further action` TRUE FALSE EQUALS `yes: notice of the referral to Ahpra (s 35K(3))`
-- A waiver of s 278 notices does not reach s 35K(3), 71 or 90F.
#ASSERT `Must I be told question` `the complaint was referred to Ahpra at its request after the ombudsman proposed no further action` TRUE TRUE EQUALS `yes: notice of the referral to Ahpra (s 35K(3))`
#ASSERT `Must I be told question` `an interim prohibition order was issued to the practitioner` TRUE TRUE EQUALS `yes: notice of the details of the order that apply to the practitioner (ss 71, 90F)`
#ASSERT `Must I be told question` `a prohibition order was issued to the practitioner` TRUE FALSE EQUALS `yes: notice of the details of the order that apply to the practitioner (ss 71, 90F)`
#ASSERT `Must I be told question` `an interim prohibition order was issued to the practitioner` FALSE FALSE EQUALS `no: ss 71, 76(2), 90F, 90L(1) and 90M(2) require it only when the order was issued in response to a complaint`
#ASSERT `Must I be told question` `a prohibition order was issued to the practitioner` FALSE FALSE EQUALS `no: ss 71, 76(2), 90F, 90L(1) and 90M(2) require it only when the order was issued in response to a complaint`
#ASSERT `Must I be told question` `immediate registration action was taken against the practitioner (suspension, conditions or an accepted undertaking)` TRUE FALSE EQUALS `yes: notice of the immediate registration action (s 60(4))`
#ASSERT `Must I be told question` `a matter is before QCAT` TRUE FALSE EQUALS `yes: you are a person QCAT notices must be given to, and notices the practitioner would give you come from the ombudsman or the National Board (s 95)`
#ASSERT `Must I be told question` `a matter is before QCAT` FALSE FALSE EQUALS `no: s 95 applies only to a matter before QCAT arising from a health service complaint`
#ASSERT `Must I be told question` `the conciliation of my complaint ended` TRUE FALSE EQUALS `yes: a copy of the conciliator's results report, with any agreement reached (s 145(2), (4)); if you and the provider reached agreement, you may enter into a contract settling the complaint (s 146(1))`
#ASSERT `Must I be told question` `the conciliation of my complaint ended` FALSE FALSE EQUALS `the Act does not say on these facts`
-- Part 7 and Part 8A notices to the complainant (ss 58A(4), 58B(6), 60(4), 65(2), 76(2), 90L(1), 90M(2)).
#ASSERT `Must I be told question` `the immediate registration action was varied` TRUE FALSE EQUALS `yes: notice of the variation (ss 58A(4), 58B(6)(b)(ii), (7), 60(4))`
#ASSERT `Must I be told question` `the immediate registration action was varied` FALSE FALSE EQUALS `no: ss 58A(4), 58B(6), 60(4) and 65(2) require it only when the immediate registration action was taken in response to a complaint`
#ASSERT `Must I be told question` `the ombudsman revoked or removed the immediate registration action (s 65)` TRUE FALSE EQUALS `yes: notice of the revocation or removal (s 65(2)(b)(iii))`
#ASSERT `Must I be told question` `the ombudsman revoked or removed the immediate registration action (s 65)` FALSE FALSE EQUALS `no: ss 58A(4), 58B(6), 60(4) and 65(2) require it only when the immediate registration action was taken in response to a complaint`
#ASSERT `Must I be told question` `immediate registration action was taken against the practitioner (suspension, conditions or an accepted undertaking)` FALSE FALSE EQUALS `no: ss 58A(4), 58B(6), 60(4) and 65(2) require it only when the immediate registration action was taken in response to a complaint`
#ASSERT `Must I be told question` `an interim prohibition order was revoked` TRUE FALSE EQUALS `yes: notice of the revocation (s 76(2)(b))`
#ASSERT `Must I be told question` `an interim prohibition order was revoked` FALSE FALSE EQUALS `no: ss 71, 76(2), 90F, 90L(1) and 90M(2) require it only when the order was issued in response to a complaint`
#ASSERT `Must I be told question` `a prohibition order was varied` TRUE FALSE EQUALS `yes: notice of the details of the order, as varied, that apply to the practitioner (s 90L(1)(a)(ii))`
#ASSERT `Must I be told question` `a prohibition order was varied` FALSE FALSE EQUALS `no: ss 71, 76(2), 90F, 90L(1) and 90M(2) require it only when the order was issued in response to a complaint`
#ASSERT `Must I be told question` `a prohibition order was revoked` TRUE FALSE EQUALS `yes: notice of the revocation (s 90M(2)(b))`
#ASSERT `Must I be told question` `a prohibition order was revoked` FALSE FALSE EQUALS `no: ss 71, 76(2), 90F, 90L(1) and 90M(2) require it only when the order was issued in response to a complaint`
-- s 278(2)(a): an oral complaint not accepted may be answered orally when it is made; s 278(4) waiver still applies.
#ASSERT `Must I be told question` `the ombudsman decided not to accept my complaint, which I made orally` TRUE FALSE EQUALS `yes: notice of the decision and the reasons within 5 business days, which may be given orally at the time you make the complaint (s 278(1), (2)(a))`
#ASSERT `Must I be told question` `the ombudsman decided not to accept my complaint, which I made orally` TRUE TRUE EQUALS `no: you waived notice of decisions (s 278(4))`
-- s 139: good faith in conciliation.
#ASSERT `Must I negotiate in good faith question` TRUE EQUALS `yes: you and the provider must negotiate in good faith (s 139(1)); how far you each do may be weighed in deciding whether to end the conciliation and what to do next with your complaint (s 139(2))`
#ASSERT `Must I negotiate in good faith question` FALSE EQUALS `s 139 does not apply: your complaint is not in conciliation`

-- ===================================================================================================================
-- s 140 -- when conciliation may start; s 149 -- privilege
-- ===================================================================================================================

#ASSERT `When can conciliation start question` `none of these` FALSE FALSE FALSE EQUALS `s 140 does not hold it back: no action that delays conciliation has been taken`
#ASSERT `When can conciliation start question` `an investigation (part 8)` FALSE FALSE FALSE EQUALS `not yet: it must wait until the investigation is completed and its report prepared (s 140(3))`
#ASSERT `When can conciliation start question` `an investigation (part 8)` TRUE FALSE FALSE EQUALS `it may start now: the condition s 140 sets for that action has been met`
#ASSERT `When can conciliation start question` `an investigation (part 8)` FALSE TRUE TRUE EQUALS `it may start now, but only for arranging a financial settlement or other compensation with you (s 140(6))`
-- s 140(6) needs both limbs.
#ASSERT `When can conciliation start question` `an investigation (part 8)` FALSE TRUE FALSE EQUALS `not yet: it must wait until the investigation is completed and its report prepared (s 140(3))`
#ASSERT `When can conciliation start question` `an investigation (part 8)` FALSE FALSE TRUE EQUALS `not yet: it must wait until the investigation is completed and its report prepared (s 140(3))`
#ASSERT `When can conciliation start question` `immediate action against the practitioner (part 7)` FALSE FALSE FALSE EQUALS `not yet: it must wait until the immediate action ends, or the later action's condition is met (s 140(2))`
#ASSERT `When can conciliation start question` `a referral to Ahpra or another government body (part 9)` FALSE FALSE FALSE EQUALS `not yet: it must wait until Ahpra or the other body has finished dealing with the matter (s 140(4))`
#ASSERT `When can conciliation start question` `a referral to the director of proceedings (part 10)` FALSE FALSE FALSE EQUALS `not yet: it must wait until QCAT has decided the matter or the director has referred it back to the ombudsman (s 140(5))`
#ASSERT `When can conciliation start question` `a referral to the director of proceedings (part 10)` TRUE FALSE FALSE EQUALS `it may start now: the condition s 140 sets for that action has been met`

#ASSERT `Can what was said in conciliation be used question` `something said or admitted during the conciliation` `as evidence in a court, tribunal or disciplinary body (including a claim for damages or to enforce the settlement)` FALSE EQUALS `no: it cannot be used that way (s 149(2))`
#ASSERT `Can what was said in conciliation be used question` `something said or admitted during the conciliation` `as evidence in a court, tribunal or disciplinary body (including a claim for damages or to enforce the settlement)` TRUE EQUALS `s 149 does not stop it: everyone whose consent is needed has consented (s 149(4))`
#ASSERT `Can what was said in conciliation be used question` `a document prepared for or in the course of the conciliation` `by the ombudsman as a ground for, or evidence in, an investigation or inquiry` FALSE EQUALS `no: it cannot be used that way (s 149(2))`
#ASSERT `Can what was said in conciliation be used question` `a document prepared for or in the course of the conciliation` `by Ahpra or a National Board for health, conduct or performance action` FALSE EQUALS `no: it cannot be used that way (s 149(2))`
#ASSERT `Can what was said in conciliation be used question` `a document prepared for or in the course of the conciliation` `by Ahpra or a National Board for health, conduct or performance action` TRUE EQUALS `s 149 does not stop it: everyone whose consent is needed has consented (s 149(4))`
#ASSERT `Can what was said in conciliation be used question` `something said or admitted during the conciliation` `some other use` FALSE EQUALS `s 149 does not deal with that use (a conciliator, and those the conciliator tells, must keep it confidential: s 150)`

-- ===================================================================================================================
-- ss 261-263 reprisal; s 263A non-disclosure agreements; ss 264, 275; s 232
-- ===================================================================================================================

#ASSERT `Can I sue for a reprisal question` `a health service complaint or a National Law notification made in good faith` `dismissal or refusal to employ` TRUE TRUE EQUALS `yes: a reprisal; it is a tort and you may claim damages for the detriment you suffered (tried without a jury in the Supreme or District Court), and it is an offence (up to 375 penalty units or 2 years imprisonment for an individual, 750 penalty units for a corporation) (ss 261-263)`
#ASSERT `Can I sue for a reprisal question` `giving information, documents or other help to an investigation or for another purpose under this Act or the National Law` `detriment caused, or attempted or conspired at` TRUE TRUE EQUALS `yes: a reprisal; it is a tort and you may claim damages for the detriment you suffered (tried without a jury in the Supreme or District Court), and it is an offence (up to 375 penalty units or 2 years imprisonment for an individual, 750 penalty units for a corporation) (ss 261-263)`
#ASSERT `Can I sue for a reprisal question` `a health service complaint or a National Law notification made in good faith` `threats or intimidation to persuade someone not to take protected action` TRUE FALSE EQUALS `yes: a reprisal and an offence (ss 261, 262); damages under s 263 go to a person who suffers detriment as a result, which you say you have not`
#ASSERT `Can I sue for a reprisal question` `a complaint or notification not made in good faith` `dismissal or refusal to employ` TRUE TRUE EQUALS `no: the action was not protected action (complaints and notifications must be made in good faith) (s 261(7))`
#ASSERT `Can I sue for a reprisal question` `none` `dismissal or refusal to employ` TRUE TRUE EQUALS `no: the action was not protected action (complaints and notifications must be made in good faith) (s 261(7))`
#ASSERT `Can I sue for a reprisal question` `a health service complaint or a National Law notification made in good faith` `nothing of these kinds` TRUE TRUE EQUALS `no: s 261 covers detriment, threats or intimidation, and dismissal or refusal to employ`
#ASSERT `Can I sue for a reprisal question` `a health service complaint or a National Law notification made in good faith` `dismissal or refusal to employ` FALSE TRUE EQUALS `not shown: s 261(6) makes a substantial ground enough; the Act does not say whether a lesser ground is`

#ASSERT `Is my non-disclosure agreement void question` TRUE TRUE TRUE FALSE EQUALS LIST `the provision is void to the extent it stops or limits you making a good-faith complaint or notification, or helping the ombudsman or Ahpra (s 263A(1))`, `the other party, an employer or health service provider, entered it without stating clearly in writing that it does not limit complaints, notifications or help: an offence (up to 30 penalty units for an individual, 60 for a corporation) (s 263A(2))`
#ASSERT `Is my non-disclosure agreement void question` TRUE TRUE TRUE TRUE EQUALS LIST `the provision is void to the extent it stops or limits you making a good-faith complaint or notification, or helping the ombudsman or Ahpra (s 263A(1))`
#ASSERT `Is my non-disclosure agreement void question` TRUE TRUE FALSE FALSE EQUALS LIST `the provision is void to the extent it stops or limits you making a good-faith complaint or notification, or helping the ombudsman or Ahpra (s 263A(1))`
#ASSERT `Is my non-disclosure agreement void question` TRUE FALSE TRUE FALSE EQUALS LIST `the other party, an employer or health service provider, entered it without stating clearly in writing that it does not limit complaints, notifications or help: an offence (up to 30 penalty units for an individual, 60 for a corporation) (s 263A(2))`
#ASSERT `Is my non-disclosure agreement void question` TRUE FALSE FALSE TRUE EQUALS LIST `nothing in s 263A affects it on these facts`
#ASSERT `Is my non-disclosure agreement void question` FALSE TRUE TRUE FALSE EQUALS LIST `the agreement is not a non-disclosure agreement under s 263A (it does not restrict disclosure about a health service provider's health, conduct or performance)`

#ASSERT `Am I protected for giving information question` TRUE FALSE TRUE EQUALS `yes: you cannot be sued or made liable for giving it, you have absolute privilege against defamation, and you breach no duty of confidence or professional ethics by giving it (s 275)`
#ASSERT `Am I protected for giving information question` TRUE FALSE FALSE EQUALS `no: s 275 gives no protection on these facts; it protects only information given honestly and on reasonable grounds`
#ASSERT `Am I protected for giving information question` TRUE TRUE TRUE EQUALS `no: s 275 gives no protection on these facts, and giving information you know is false or misleading is an offence (up to 100 penalty units) (s 264)`
#ASSERT `Am I protected for giving information question` FALSE FALSE TRUE EQUALS `no: s 275 protects only information given to the health ombudsman, its staff or an authorised person`

#ASSERT `Can I claim compensation from the State question` TRUE FALSE EQUALS `yes: you may claim compensation (including costs and damage) from the State in a court; it may order payment only if satisfied it is just, having regard to any relevant offence you committed (s 232)`
#ASSERT `Can I claim compensation from the State question` TRUE TRUE EQUALS `no: loss from a lawful seizure or lawful forfeiture is excluded (s 232(2))`
#ASSERT `Can I claim compensation from the State question` FALSE FALSE EQUALS `no: s 232 covers only loss caused by an authorised person's exercise (or purported exercise) of a power, or by complying with a requirement they made`
