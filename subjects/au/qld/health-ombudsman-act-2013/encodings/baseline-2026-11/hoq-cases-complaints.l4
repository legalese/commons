IMPORT prelude
IMPORT `hoq-common`
IMPORT `hoq-complaints`

-- Worked cases for hoq-complaints.l4. Every expected value was worked by hand from the text, with a calendar:
-- November 2026 has Mondays on the 2nd, 9th, 16th, 23rd and 30th; December 2026 on the 7th, 14th, 21st and 28th.
-- The Queensland public holidays used are Friday 25 December 2026, Monday 28 December 2026 (Boxing Day, Saturday 26
-- December, observed) and Friday 1 January 2027; they are supplied as inputs, as the person would supply them.
-- BASELINE ENCODING. Not for public use as advice. See NOTES.md.

GIVETH A LIST OF DATE
`no public holidays` MEANS EMPTY

GIVETH A LIST OF DATE
`the Christmas 2026 holidays` MEANS LIST (DATE_FROM_DMY 25 12 2026), (DATE_FROM_DMY 28 12 2026), (DATE_FROM_DMY 1 1 2027)

-- ===================================================================================================================
-- Business days (hoq-common)
-- ===================================================================================================================

#ASSERT `is a business day` (DATE_FROM_DMY 6 11 2026) `no public holidays`
#ASSERT (NOT (`is a business day` (DATE_FROM_DMY 7 11 2026) `no public holidays`))
#ASSERT (NOT (`is a business day` (DATE_FROM_DMY 8 11 2026) `no public holidays`))
#ASSERT (NOT (`is a business day` (DATE_FROM_DMY 25 12 2026) `the Christmas 2026 holidays`))
#ASSERT `is a business day` (DATE_FROM_DMY 25 12 2026) `no public holidays`
#ASSERT `the business day after` 5 (DATE_FROM_DMY 20 11 2026) `no public holidays` EQUALS DATE_FROM_DMY 27 11 2026

-- ===================================================================================================================
-- ss 7, 8, 20-23, 31, 32 -- can I complain
-- ===================================================================================================================

-- A treatment by a current provider.
#ASSERT `Can I make this health service complaint question` TRUE FALSE FALSE FALSE FALSE `provides health services now` FALSE FALSE EQUALS `yes: any person may make a health service complaint (ss 31, 32)`
-- A cancer screening program (s 7(4)(a)), the person who was screened has died: on their behalf (s 23(2)).
#ASSERT `Can I make this health service complaint question` FALSE FALSE TRUE FALSE FALSE `provides health services now` FALSE TRUE EQUALS `yes: a complaint may be made on behalf of the person who died (ss 23(1)(a), (2), 32)`
-- A support service (s 7(3)).
#ASSERT `Can I make this health service complaint question` FALSE TRUE FALSE FALSE FALSE `provides health services now` FALSE FALSE EQUALS `yes: any person may make a health service complaint (ss 31, 32)`
-- Excluded by regulation (s 7(5)) and the provider gives no other health service: not a health service complaint.
#ASSERT `Can I make this health service complaint question` TRUE FALSE FALSE TRUE FALSE `provides health services now` FALSE FALSE EQUALS `no: the provider does not provide a health service, so this is not a health service complaint (ss 8, 31)`
-- Excluded by regulation, but the provider gives other health services: "other service" under s 31 (finding 2).
#ASSERT `Can I make this health service complaint question` TRUE FALSE FALSE TRUE TRUE `provides health services now` FALSE FALSE EQUALS `yes: any person may make a health service complaint (ss 31, 32)`
-- Not a health service at all, by someone who gives none.
#ASSERT `Can I make this health service complaint question` FALSE FALSE FALSE FALSE FALSE `provides health services now` FALSE FALSE EQUALS `no: the provider does not provide a health service, so this is not a health service complaint (ss 8, 31)`
-- Former provider (s 20) and former registered practitioner (s 21).
#ASSERT `Can I make this health service complaint question` TRUE FALSE FALSE FALSE FALSE `provided health services then, but no longer does (s 20)` FALSE FALSE EQUALS `yes: about their behaviour while they were a health service provider, as if they still were one (s 20)`
#ASSERT `Can I make this health service complaint question` TRUE FALSE FALSE FALSE FALSE `was a registered health practitioner then, but is no longer registered (s 21)` FALSE FALSE EQUALS `yes: about their behaviour while they were registered, as if they still were (s 21)`
-- Registered only under a corresponding prior Act (s 22(3)): both limbs.
#ASSERT `Can I make this health service complaint question` TRUE FALSE FALSE FALSE FALSE `is not registered now, but was registered in a health profession under a corresponding prior Act (s 22)` TRUE FALSE EQUALS `yes, but only to the extent a complaint about that behaviour could have been made under the corresponding prior Act (s 22(3))`
#ASSERT `Can I make this health service complaint question` TRUE FALSE FALSE FALSE FALSE `is not registered now, but was registered in a health profession under a corresponding prior Act (s 22)` FALSE FALSE EQUALS `no: s 22 applies only to the extent a complaint could have been made under the corresponding prior Act (s 22(3)(a))`

-- ===================================================================================================================
-- s 35A -- grounds for not accepting
-- ===================================================================================================================

#ASSERT `Can my complaint be not accepted question` FALSE TRUE TRUE EQUALS EMPTY
#ASSERT `Can my complaint be not accepted question` FALSE FALSE FALSE EQUALS EMPTY
#ASSERT `Can my complaint be not accepted question` FALSE FALSE TRUE EQUALS LIST `you have not first sought a resolution with the provider, and it is reasonable for you to do so first (s 35A(b))`
#ASSERT `Can my complaint be not accepted question` TRUE FALSE TRUE EQUALS LIST `another entity would more appropriately deal with it (s 35A(a))`, `you have not first sought a resolution with the provider, and it is reasonable for you to do so first (s 35A(b))`
#ASSERT `Can my complaint be not accepted question` TRUE TRUE FALSE EQUALS LIST `another entity would more appropriately deal with it (s 35A(a))`

-- ===================================================================================================================
-- s 35 -- 7 business days to decide and tell
-- ===================================================================================================================

-- Received Monday 2 November 2026: Tue 3, Wed 4, Thu 5, Fri 6, Mon 9, Tue 10, Wed 11 -> Wednesday 11 November.
#ASSERT `By when must the ombudsman decide whether to accept my complaint question` (DATE_FROM_DMY 2 11 2026) 0 `no public holidays` EQUALS DATE_FROM_DMY 11 11 2026
-- 2 business days with a s 34 request outstanding: Thu 12, Fri 13 -> Friday 13 November.
#ASSERT `By when must the ombudsman decide whether to accept my complaint question` (DATE_FROM_DMY 2 11 2026) 2 `no public holidays` EQUALS DATE_FROM_DMY 13 11 2026
-- Received on Saturday 7 November: Mon 9 ... Fri 13 (5), Mon 16 (6), Tue 17 (7).
#ASSERT `By when must the ombudsman decide whether to accept my complaint question` (DATE_FROM_DMY 7 11 2026) 0 `no public holidays` EQUALS DATE_FROM_DMY 17 11 2026
-- Received Monday 21 December 2026: Tue 22, Wed 23, Thu 24, (Fri 25, Mon 28 holidays) Tue 29, Wed 30, Thu 31,
-- (Fri 1 January holiday) Mon 4 January 2027.
#ASSERT `By when must the ombudsman decide whether to accept my complaint question` (DATE_FROM_DMY 21 12 2026) 0 `the Christmas 2026 holidays` EQUALS DATE_FROM_DMY 4 1 2027
-- The same with no holidays supplied: 22, 23, 24, 25, 28, 29, 30 December.
#ASSERT `By when must the ombudsman decide whether to accept my complaint question` (DATE_FROM_DMY 21 12 2026) 0 `no public holidays` EQUALS DATE_FROM_DMY 30 12 2026

-- The state, received Monday 2 November 2026, last day Wednesday 11 November; the notice must also be by then.
#ASSERT `Was my complaint decided and notified in time question` (DATE_FROM_DMY 2 11 2026) 0 `no public holidays` TRUE (DATE_FROM_DMY 11 11 2026) TRUE (DATE_FROM_DMY 11 11 2026) (DATE_FROM_DMY 20 11 2026) EQUALS `yes: the decision was made, and I was told of it, within the periods the Act allows`
#ASSERT `Was my complaint decided and notified in time question` (DATE_FROM_DMY 2 11 2026) 0 `no public holidays` TRUE (DATE_FROM_DMY 10 11 2026) TRUE (DATE_FROM_DMY 11 11 2026) (DATE_FROM_DMY 20 11 2026) EQUALS `yes: the decision was made, and I was told of it, within the periods the Act allows`
-- Decided Tuesday 10, told Thursday 12: within s 278's 5 business days, but after the s 35(1) 7 business days.
#ASSERT `Was my complaint decided and notified in time question` (DATE_FROM_DMY 2 11 2026) 0 `no public holidays` TRUE (DATE_FROM_DMY 10 11 2026) TRUE (DATE_FROM_DMY 12 11 2026) (DATE_FROM_DMY 20 11 2026) EQUALS `the decision was made in time, but I was told of it after the period the Act allows had ended`
#ASSERT `Was my complaint decided and notified in time question` (DATE_FROM_DMY 2 11 2026) 0 `no public holidays` TRUE (DATE_FROM_DMY 12 11 2026) TRUE (DATE_FROM_DMY 12 11 2026) (DATE_FROM_DMY 20 11 2026) EQUALS `the decision was made after the period the Act allows had ended`
-- With 1 day not counted the last day is Thursday 12 November: the same facts are in time.
#ASSERT `Was my complaint decided and notified in time question` (DATE_FROM_DMY 2 11 2026) 1 `no public holidays` TRUE (DATE_FROM_DMY 12 11 2026) TRUE (DATE_FROM_DMY 12 11 2026) (DATE_FROM_DMY 20 11 2026) EQUALS `yes: the decision was made, and I was told of it, within the periods the Act allows`
#ASSERT `Was my complaint decided and notified in time question` (DATE_FROM_DMY 2 11 2026) 0 `no public holidays` TRUE (DATE_FROM_DMY 10 11 2026) FALSE (DATE_FROM_DMY 1 1 2026) (DATE_FROM_DMY 11 11 2026) EQUALS `the decision was made in time; I have not been told yet, but the period for telling me has not ended`
#ASSERT `Was my complaint decided and notified in time question` (DATE_FROM_DMY 2 11 2026) 0 `no public holidays` TRUE (DATE_FROM_DMY 10 11 2026) FALSE (DATE_FROM_DMY 1 1 2026) (DATE_FROM_DMY 12 11 2026) EQUALS `the decision was made in time, but the period for telling me has ended and I have not been told`
#ASSERT `Was my complaint decided and notified in time question` (DATE_FROM_DMY 2 11 2026) 0 `no public holidays` FALSE (DATE_FROM_DMY 1 1 2026) FALSE (DATE_FROM_DMY 1 1 2026) (DATE_FROM_DMY 11 11 2026) EQUALS `not yet due: no decision yet, but the period for it has not ended`
#ASSERT `Was my complaint decided and notified in time question` (DATE_FROM_DMY 2 11 2026) 0 `no public holidays` FALSE (DATE_FROM_DMY 1 1 2026) FALSE (DATE_FROM_DMY 1 1 2026) (DATE_FROM_DMY 12 11 2026) EQUALS `overdue: the period for the decision has ended and no decision has been made`

-- s 34(5): the ombudsman need not deal with the complaint while a request is unanswered.
#ASSERT `Must the ombudsman deal with my complaint before I answer its request question` FALSE FALSE EQUALS `s 34(5) does not arise: there is no request under s 34 that you are still to answer`
#ASSERT `Must the ombudsman deal with my complaint before I answer its request question` TRUE FALSE EQUALS `no: until you comply with the request as far as you reasonably can, the ombudsman need not deal, or deal further, with your complaint (s 34(5)); the days the request is outstanding are not counted in the s 35 7 business days (s 35(2)(a))`
#ASSERT `Must the ombudsman deal with my complaint before I answer its request question` TRUE TRUE EQUALS `s 34(5) no longer holds it back: you have complied with the request as far as you reasonably can`

-- ===================================================================================================================
-- s 44 -- the 2-year ground and the other grounds
-- ===================================================================================================================

-- Arose and known 1 March 2024; complained 1 March 2026: exactly 2 years, "at least 2 years" is met.
#ASSERT `Is my complaint too old question` (DATE_FROM_DMY 1 3 2024) (DATE_FROM_DMY 1 3 2024) (DATE_FROM_DMY 1 3 2026) FALSE FALSE EQUALS `the 2-year ground is open: the matter arose, and you knew of it, at least 2 years before you complained; the ombudsman may decide to take no further action on that ground if it reasonably considers so (s 44(1)(b)(iii)). It is not a bar to complaining.`
-- Complained 28 February 2026: one day short.
#ASSERT `Is my complaint too old question` (DATE_FROM_DMY 1 3 2024) (DATE_FROM_DMY 1 3 2024) (DATE_FROM_DMY 28 2 2026) FALSE FALSE EQUALS `the 2-year ground does not apply: you complained less than 2 years after the matter arose or after you became aware of it (s 44(1)(b)(iii))`
-- Arose 1 January 2024, learned of it 10 June 2024: the later day counts. 9 June 2026 is short; 10 June 2026 is not.
#ASSERT `Is my complaint too old question` (DATE_FROM_DMY 1 1 2024) (DATE_FROM_DMY 10 6 2024) (DATE_FROM_DMY 9 6 2026) FALSE FALSE EQUALS `the 2-year ground does not apply: you complained less than 2 years after the matter arose or after you became aware of it (s 44(1)(b)(iii))`
#ASSERT `Is my complaint too old question` (DATE_FROM_DMY 1 1 2024) (DATE_FROM_DMY 10 6 2024) (DATE_FROM_DMY 10 6 2026) FALSE FALSE EQUALS `the 2-year ground is open: the matter arose, and you knew of it, at least 2 years before you complained; the ombudsman may decide to take no further action on that ground if it reasonably considers so (s 44(1)(b)(iii)). It is not a bar to complaining.`
-- 29 February 2024: 24 months on is read as 28 February 2026 (fork F4).
#ASSERT `Is my complaint too old question` (DATE_FROM_DMY 29 2 2024) (DATE_FROM_DMY 29 2 2024) (DATE_FROM_DMY 28 2 2026) FALSE FALSE EQUALS `the 2-year ground is open: the matter arose, and you knew of it, at least 2 years before you complained; the ombudsman may decide to take no further action on that ground if it reasonably considers so (s 44(1)(b)(iii)). It is not a bar to complaining.`
#ASSERT `Is my complaint too old question` (DATE_FROM_DMY 29 2 2024) (DATE_FROM_DMY 29 2 2024) (DATE_FROM_DMY 27 2 2026) FALSE FALSE EQUALS `the 2-year ground does not apply: you complained less than 2 years after the matter arose or after you became aware of it (s 44(1)(b)(iii))`
-- s 44(2): possible professional misconduct, or another ground to suspend or cancel, shuts the ground.
#ASSERT `Is my complaint too old question` (DATE_FROM_DMY 1 3 2020) (DATE_FROM_DMY 1 3 2020) (DATE_FROM_DMY 1 3 2026) TRUE FALSE EQUALS `the 2-year ground does not apply: the ombudsman considers there may be professional misconduct or a ground to suspend or cancel registration (s 44(2))`
#ASSERT `Is my complaint too old question` (DATE_FROM_DMY 1 3 2020) (DATE_FROM_DMY 1 3 2020) (DATE_FROM_DMY 1 3 2026) FALSE TRUE EQUALS `the 2-year ground does not apply: the ombudsman considers there may be professional misconduct or a ground to suspend or cancel registration (s 44(2))`

-- No ground open.
#ASSERT `On what grounds may the ombudsman take no further action question` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE (DATE_FROM_DMY 1 6 2026) (DATE_FROM_DMY 1 6 2026) (DATE_FROM_DMY 1 7 2026) FALSE FALSE FALSE EQUALS EMPTY
-- Withdrawn, and old: two grounds, in the Act's order.
#ASSERT `On what grounds may the ombudsman take no further action question` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE (DATE_FROM_DMY 1 3 2023) (DATE_FROM_DMY 1 3 2023) (DATE_FROM_DMY 1 7 2026) FALSE FALSE FALSE EQUALS LIST `you withdrew the complaint (s 44(1)(b)(ii))`, `the matter arose, and you knew of it, at least 2 years before you complained (s 44(1)(b)(iii))`
-- Old, but s 44(2) applies: only the other grounds.
#ASSERT `On what grounds may the ombudsman take no further action question` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE (DATE_FROM_DMY 1 3 2023) (DATE_FROM_DMY 1 3 2023) (DATE_FROM_DMY 1 7 2026) TRUE FALSE FALSE EQUALS LIST `misconceived or lacking in substance (s 44(1)(a)(ii))`
#ASSERT `On what grounds may the ombudsman take no further action question` TRUE FALSE TRUE TRUE TRUE TRUE TRUE FALSE (DATE_FROM_DMY 1 6 2026) (DATE_FROM_DMY 1 6 2026) (DATE_FROM_DMY 1 7 2026) FALSE FALSE TRUE EQUALS LIST `frivolous, vexatious, trivial or not made in good faith (s 44(1)(a)(i))`, `being adequately dealt with by another appropriate entity (s 44(1)(a)(iii))`, `already resolved or appropriately finalised (s 44(1)(a)(iv))`, `cannot be resolved despite reasonable efforts (s 44(1)(a)(v))`, `you did not cooperate with attempts to resolve it, without reasonable excuse (s 44(1)(b)(i)(A))`, `you did not comply with a request for information, without reasonable excuse (s 44(1)(b)(i)(B))`, `a complainant, provider or other relevant person has died and it is appropriate to stop (s 44(3))`

-- ===================================================================================================================
-- s 38(2) -- local resolution and conciliation; s 39(2) -- withdrawal
-- ===================================================================================================================

#ASSERT `Can my complaint go to local resolution or conciliation question` TRUE FALSE FALSE EQUALS `yes: the complaint is about a health service provided to you (s 38(2)(a))`
#ASSERT `Can my complaint go to local resolution or conciliation question` FALSE TRUE TRUE EQUALS `yes: you complained for someone else and the ombudsman is satisfied you have a sufficient interest (s 38(2)(b))`
#ASSERT `Can my complaint go to local resolution or conciliation question` FALSE TRUE FALSE EQUALS `no: local resolution and conciliation are available only for a service to you, or where the ombudsman is satisfied you have a sufficient interest (s 38(2))`
#ASSERT `Can my complaint go to local resolution or conciliation question` FALSE FALSE TRUE EQUALS `no: local resolution and conciliation are available only for a service to you, or where the ombudsman is satisfied you have a sufficient interest (s 38(2))`

#ASSERT `If I withdraw my complaint can the ombudsman keep dealing with it question` `investigation (part 8)` EQUALS `yes: withdrawing does not affect the ombudsman's power to take this action (s 39(2)); the ombudsman may instead decide to take no further action because you withdrew (s 44(1)(b)(ii))`
#ASSERT `If I withdraw my complaint can the ombudsman keep dealing with it question` `referral to the director of proceedings for QCAT (part 10)` EQUALS `yes: withdrawing does not affect the ombudsman's power to take this action (s 39(2)); the ombudsman may instead decide to take no further action because you withdrew (s 44(1)(b)(ii))`
#ASSERT `If I withdraw my complaint can the ombudsman keep dealing with it question` `conciliation (part 11)` EQUALS `s 39(2) does not keep this power alive after withdrawal (it excepts local resolution and conciliation) and the Act says nothing more; the ombudsman may decide to take no further action because you withdrew (s 44(1)(b)(ii))`
#ASSERT `If I withdraw my complaint can the ombudsman keep dealing with it question` `local resolution (part 6)` EQUALS `s 39(2) does not keep this power alive after withdrawal (it excepts local resolution and conciliation) and the Act says nothing more; the ombudsman may decide to take no further action because you withdrew (s 44(1)(b)(ii))`

-- ===================================================================================================================
-- ss 47, 48, 53, 54 -- requests to me
-- ===================================================================================================================

-- Notice Monday 2 November 2026: 10 business days end Monday 16 November.
#ASSERT `By when must I give submissions or information question` (DATE_FROM_DMY 2 11 2026) (DATE_FROM_DMY 16 11 2026) `no public holidays` EQUALS `by the day stated in the notice, which is within the Act's 10 business days` (DATE_FROM_DMY 16 11 2026)
#ASSERT `By when must I give submissions or information question` (DATE_FROM_DMY 2 11 2026) (DATE_FROM_DMY 9 11 2026) `no public holidays` EQUALS `by the day stated in the notice, which is within the Act's 10 business days` (DATE_FROM_DMY 9 11 2026)
#ASSERT `By when must I give submissions or information question` (DATE_FROM_DMY 2 11 2026) (DATE_FROM_DMY 17 11 2026) `no public holidays` EQUALS `the notice states a longer period than the Act allows; the Act's 10 business days end on` (DATE_FROM_DMY 16 11 2026)
-- Notice Friday 18 December 2026: 21, 22, 23, 24, 29, 30, 31 December, 4, 5, 6 January -> Wednesday 6 January 2027.
#ASSERT `By when must I give submissions or information question` (DATE_FROM_DMY 18 12 2026) (DATE_FROM_DMY 6 1 2027) `the Christmas 2026 holidays` EQUALS `by the day stated in the notice, which is within the Act's 10 business days` (DATE_FROM_DMY 6 1 2027)
#ASSERT `By when must I give submissions or information question` (DATE_FROM_DMY 18 12 2026) (DATE_FROM_DMY 7 1 2027) `the Christmas 2026 holidays` EQUALS `the notice states a longer period than the Act allows; the Act's 10 business days end on` (DATE_FROM_DMY 6 1 2027)

#ASSERT `Must I give the information required question` `an invitation to make submissions (s 47 or 53)` FALSE FALSE EQUALS `no: submissions are invited, not required; any you give within the stated period must be considered (ss 47(3), 53(3))`
#ASSERT `Must I give the information required question` `a requirement to give stated information or documents (s 48 or 54)` TRUE FALSE EQUALS `no: it is a reasonable excuse that the information might tend to incriminate you (ss 48(4), 54(4))`
#ASSERT `Must I give the information required question` `a requirement to give stated information or documents (s 48 or 54)` FALSE TRUE EQUALS `not if your excuse is a reasonable one (ss 48(3), 54(3)); failing without one may also let the ombudsman take no further action on your complaint (s 44(1)(b)(i)(B))`
#ASSERT `Must I give the information required question` `a requirement to give stated information or documents (s 48 or 54)` FALSE FALSE EQUALS `yes: you must comply; the maximum penalty is 50 penalty units (ss 48(3), 54(3)), and failing may let the ombudsman take no further action on your complaint (s 44(1)(b)(i)(B))`

-- ===================================================================================================================
-- s 49 -- assessment; s 55 -- local resolution
-- ===================================================================================================================

-- Decided Monday 2 November 2026; 22 business days: Nov 3-6 (4), 9-13 (9), 16-20 (14), 23-27 (19), 30 (20),
-- Dec 1 (21), Dec 2 (22) -> Wednesday 2 December.
#ASSERT `By when must the assessment be completed question` (DATE_FROM_DMY 2 11 2026) 0 0 `no public holidays` EQUALS DATE_FROM_DMY 2 12 2026
-- Extended by 5: Dec 3, 4, 7, 8, 9 -> Wednesday 9 December.
#ASSERT `By when must the assessment be completed question` (DATE_FROM_DMY 2 11 2026) 5 0 `no public holidays` EQUALS DATE_FROM_DMY 9 12 2026
-- Extended by 22 (the most): 44 business days: Dec 3-4 (24), 7-11 (29), 14-18 (34), 21-24 (38), (25, 28 holidays)
-- 29-31 (41), (1 Jan holiday) Jan 4, 5, 6 (44) -> Wednesday 6 January 2027.
#ASSERT `By when must the assessment be completed question` (DATE_FROM_DMY 2 11 2026) 22 0 `the Christmas 2026 holidays` EQUALS DATE_FROM_DMY 6 1 2027
-- An extension stated as 30 counts as 22 (fork F6): the same day.
#ASSERT `By when must the assessment be completed question` (DATE_FROM_DMY 2 11 2026) 30 0 `the Christmas 2026 holidays` EQUALS DATE_FROM_DMY 6 1 2027
-- 22 + 22 with no holidays supplied: Dec 21-25 (39), 28-31 (43), Jan 1 (44) -> Friday 1 January 2027.
#ASSERT `By when must the assessment be completed question` (DATE_FROM_DMY 2 11 2026) 22 0 `no public holidays` EQUALS DATE_FROM_DMY 1 1 2027
-- 3 days waiting on s 35J: Dec 3, 4, 7 -> Monday 7 December.
#ASSERT `By when must the assessment be completed question` (DATE_FROM_DMY 2 11 2026) 0 3 `no public holidays` EQUALS DATE_FROM_DMY 7 12 2026

-- The state: last day Wednesday 2 December; notice within 5 business days of the decision.
#ASSERT `Was the assessment decided and notified in time question` (DATE_FROM_DMY 2 11 2026) 0 0 `no public holidays` TRUE (DATE_FROM_DMY 2 12 2026) TRUE (DATE_FROM_DMY 9 12 2026) (DATE_FROM_DMY 20 12 2026) EQUALS `yes: the decision was made, and I was told of it, within the periods the Act allows`
#ASSERT `Was the assessment decided and notified in time question` (DATE_FROM_DMY 2 11 2026) 0 0 `no public holidays` TRUE (DATE_FROM_DMY 2 12 2026) TRUE (DATE_FROM_DMY 10 12 2026) (DATE_FROM_DMY 20 12 2026) EQUALS `the decision was made in time, but I was told of it after the period the Act allows had ended`
#ASSERT `Was the assessment decided and notified in time question` (DATE_FROM_DMY 2 11 2026) 0 0 `no public holidays` TRUE (DATE_FROM_DMY 3 12 2026) TRUE (DATE_FROM_DMY 3 12 2026) (DATE_FROM_DMY 20 12 2026) EQUALS `the decision was made after the period the Act allows had ended`
#ASSERT `Was the assessment decided and notified in time question` (DATE_FROM_DMY 2 11 2026) 1 0 `no public holidays` TRUE (DATE_FROM_DMY 3 12 2026) TRUE (DATE_FROM_DMY 3 12 2026) (DATE_FROM_DMY 20 12 2026) EQUALS `yes: the decision was made, and I was told of it, within the periods the Act allows`
#ASSERT `Was the assessment decided and notified in time question` (DATE_FROM_DMY 2 11 2026) 0 0 `no public holidays` TRUE (DATE_FROM_DMY 2 12 2026) FALSE (DATE_FROM_DMY 1 1 2026) (DATE_FROM_DMY 9 12 2026) EQUALS `the decision was made in time; I have not been told yet, but the period for telling me has not ended`
#ASSERT `Was the assessment decided and notified in time question` (DATE_FROM_DMY 2 11 2026) 0 0 `no public holidays` TRUE (DATE_FROM_DMY 2 12 2026) FALSE (DATE_FROM_DMY 1 1 2026) (DATE_FROM_DMY 10 12 2026) EQUALS `the decision was made in time, but the period for telling me has ended and I have not been told`
#ASSERT `Was the assessment decided and notified in time question` (DATE_FROM_DMY 2 11 2026) 0 0 `no public holidays` FALSE (DATE_FROM_DMY 1 1 2026) FALSE (DATE_FROM_DMY 1 1 2026) (DATE_FROM_DMY 2 12 2026) EQUALS `not yet due: no decision yet, but the period for it has not ended`
#ASSERT `Was the assessment decided and notified in time question` (DATE_FROM_DMY 2 11 2026) 0 0 `no public holidays` FALSE (DATE_FROM_DMY 1 1 2026) FALSE (DATE_FROM_DMY 1 1 2026) (DATE_FROM_DMY 3 12 2026) EQUALS `overdue: the period for the decision has ended and no decision has been made`

-- Local resolution decided Monday 16 November 2026, 1 day not counted: 23 business days: Nov 17-20 (4), 23-27 (9),
-- 30 (10), Dec 1-4 (14), 7-11 (19), 14, 15, 16, 17 (23) -> Thursday 17 December.
#ASSERT `By when must the ombudsman try to resolve my complaint locally question` (DATE_FROM_DMY 16 11 2026) 0 1 `no public holidays` EQUALS DATE_FROM_DMY 17 12 2026
#ASSERT `By when must the ombudsman try to resolve my complaint locally question` (DATE_FROM_DMY 16 11 2026) 0 0 `no public holidays` EQUALS DATE_FROM_DMY 16 12 2026

-- ===================================================================================================================
-- s 278 -- notice of a decision
-- ===================================================================================================================

-- Decision Friday 20 November 2026: Mon 23 ... Fri 27 -> Friday 27 November.
#ASSERT `Was I told of the decision in time question` (DATE_FROM_DMY 20 11 2026) FALSE TRUE (DATE_FROM_DMY 27 11 2026) (DATE_FROM_DMY 1 12 2026) `no public holidays` EQUALS `yes: you were told within 5 business days after the decision (s 278(1))`
#ASSERT `Was I told of the decision in time question` (DATE_FROM_DMY 20 11 2026) FALSE TRUE (DATE_FROM_DMY 20 11 2026) (DATE_FROM_DMY 1 12 2026) `no public holidays` EQUALS `yes: you were told within 5 business days after the decision (s 278(1))`
#ASSERT `Was I told of the decision in time question` (DATE_FROM_DMY 20 11 2026) FALSE TRUE (DATE_FROM_DMY 30 11 2026) (DATE_FROM_DMY 1 12 2026) `no public holidays` EQUALS `no: you were told, but after the 5 business days had ended (s 278(1))`
-- Told on Saturday 28 November: after the 5th business day.
#ASSERT `Was I told of the decision in time question` (DATE_FROM_DMY 20 11 2026) FALSE TRUE (DATE_FROM_DMY 28 11 2026) (DATE_FROM_DMY 1 12 2026) `no public holidays` EQUALS `no: you were told, but after the 5 business days had ended (s 278(1))`
#ASSERT `Was I told of the decision in time question` (DATE_FROM_DMY 20 11 2026) FALSE FALSE (DATE_FROM_DMY 1 1 2026) (DATE_FROM_DMY 27 11 2026) `no public holidays` EQUALS `not yet due: you have not been told, but the 5 business days have not ended`
#ASSERT `Was I told of the decision in time question` (DATE_FROM_DMY 20 11 2026) FALSE FALSE (DATE_FROM_DMY 1 1 2026) (DATE_FROM_DMY 28 11 2026) `no public holidays` EQUALS `overdue: the 5 business days have ended and you have not been told (s 278(1))`
#ASSERT `Was I told of the decision in time question` (DATE_FROM_DMY 20 11 2026) TRUE FALSE (DATE_FROM_DMY 1 1 2026) (DATE_FROM_DMY 28 12 2026) `no public holidays` EQUALS `no notice is owed to you: you waived it (s 278(4))`
-- Decision Thursday 24 December 2026: 29, 30, 31 December, 4, 5 January -> Tuesday 5 January 2027.
