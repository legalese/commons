-- A new owner must apply in the approved form, unless the Commissioner has sent a notice under s 76(3).
#ASSERT `Must I apply for the exemption` FALSE FALSE FALSE FALSE
#ASSERT (NOT (`Must I apply for the exemption` FALSE FALSE FALSE TRUE))

§§ `ss 77, 77A -- telling the Commissioner the exemption has ended or changed`

-- Exempt for 2025-26; let after moving out, so not exempt at 30 June 2026; same owner: notice by 31 July 2026.
#ASSERT `Must I tell the Commissioner my land is no longer exempt` TRUE TRUE TRUE 2026 EQUALS `yes: I must give the Commissioner notice no later than` (DATE_FROM_DMY 31 7 2026)
-- Sold instead: ownership changed, no s 77 notice.
#ASSERT `Must I tell the Commissioner my land is no longer exempt` TRUE TRUE FALSE 2026 EQUALS `no: this section does not require me to give notice`
#ASSERT EVALTRACE (`s 77 -- the owner must tell the Commissioner, by the end of July, that the land is no longer exempt` TRUE TRUE TRUE) 0 (LIST (EVENT `the owner` `give notice that the land is no longer exempt land` 30)) EQUALS FULFILLED
#ASSERT EVALTRACE (`s 77 -- the owner must tell the Commissioner, by the end of July, that the land is no longer exempt` TRUE TRUE FALSE) 0 (LIST (WAITUNTIL 60)) EQUALS FULFILLED
-- expect: BREACH BY the owner, "s 77(2), (3): ..." (notice on 1 August, day 31)
#TRACE (`s 77 -- the owner must tell the Commissioner, by the end of July, that the land is no longer exempt` TRUE TRUE TRUE) AT 0 WITH
    PARTY `the owner` DOES `give notice that the land is no longer exempt land` AT 31
-- s 77A: the salon grew from 2 rooms to 3, changing the exempt part: notice by 31 July 2026.
#ASSERT `Must I tell the Commissioner the exempt part has changed` TRUE TRUE FALSE TRUE 2026 EQUALS `yes: I must give the Commissioner notice no later than` (DATE_FROM_DMY 31 7 2026)
-- If the land is now wholly non-exempt, s 77 applies instead (s 77A(1)(c)).
#ASSERT `Must I tell the Commissioner the exempt part has changed` TRUE TRUE TRUE TRUE 2026 EQUALS `no: this section does not require me to give notice`
#ASSERT EVALTRACE (`s 77A -- the owner must tell the Commissioner, by the end of July, of a change to the exempt part of the land` TRUE TRUE FALSE TRUE) 0 (LIST (EVENT `the owner` `give notice of the change to the part of the land that is exempt` 10)) EQUALS FULFILLED

§§ `TAA s 28 -- an assessment that is too low`

-- Aware on 10 August 2026: advise by 9 September 2026 (10 August + 30 days).
#ASSERT `Must I tell the Commissioner my assessment is too low` TRUE (DATE_FROM_DMY 10 8 2026) EQUALS `yes: I must give the Commissioner notice no later than` (DATE_FROM_DMY 9 9 2026)
