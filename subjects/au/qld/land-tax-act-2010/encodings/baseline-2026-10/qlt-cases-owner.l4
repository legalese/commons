    (WAITUNTIL 31)

§§ `TAA s 30 -- paying by the date in the notice`

-- Notice given 1 September 2026, stated date 2 October 2026 (31 days): pay by 2 October 2026.
#ASSERT `By what date must I pay my land tax` (DATE_FROM_DMY 1 9 2026) (DATE_FROM_DMY 2 10 2026) EQUALS `I must pay in full by the date stated in the notice` (DATE_FROM_DMY 2 10 2026)
-- Exactly 30 days (1 October 2026) is allowed.
#ASSERT `By what date must I pay my land tax` (DATE_FROM_DMY 1 9 2026) (DATE_FROM_DMY 1 10 2026) EQUALS `I must pay in full by the date stated in the notice` (DATE_FROM_DMY 1 10 2026)
-- A stated date of 25 September 2026 (24 days) is too early; the earliest s 30(2) date is 1 October 2026.
#ASSERT `By what date must I pay my land tax` (DATE_FROM_DMY 1 9 2026) (DATE_FROM_DMY 25 9 2026) EQUALS `the stated date is less than the 30 days TAA s 30(2) requires, unless the Commissioner has stated an earlier date under TAA s 33; the earliest s 30(2) date is` (DATE_FROM_DMY 1 10 2026)
#ASSERT EVALTRACE (`TAA s 30(1)(e) -- the taxpayer must pay the land tax by the date stated in the assessment notice` 2500 31) 0 (LIST (EVENT `the taxpayer` (`pay the land tax in full` 2500) 31)) EQUALS FULFILLED
-- expect: BREACH BY the taxpayer, "TAA s 30(1)(e): ..." (paid on day 32)
#TRACE (`TAA s 30(1)(e) -- the taxpayer must pay the land tax by the date stated in the assessment notice` 2500 31) AT 0 WITH
    PARTY `the taxpayer` DOES `pay the land tax in full` 2500 AT 32
-- expect: BREACH BY the taxpayer, "TAA s 30(1)(e): ..." ($2,400 is not the tax; nothing else by day 31)
#TRACE (`TAA s 30(1)(e) -- the taxpayer must pay the land tax by the date stated in the assessment notice` 2500 31) AT 0 WITH
    PARTY `the taxpayer` DOES `pay the land tax in full` 2400 AT 20
    (WAITUNTIL 40)

§§ `ss 70 to 74, Regulation s 4 -- instalments`

-- s 70: only the Commissioner's ordinary assessment, not a default assessment, self assessment or reassessment.
#ASSERT `Can I pay by instalments` `an assessment by the Commissioner that is not a default assessment or a reassessment`
#ASSERT (NOT (`Can I pay by instalments` `a reassessment of land tax`))
#ASSERT (NOT (`Can I pay by instalments` `a default assessment`))
-- Regulation s 4(a)(i): elect within 35 days: notice 1 September 2026, last day 6 October 2026.
#ASSERT `By what date must I elect to pay by instalments` (DATE_FROM_DMY 1 9 2026) FALSE (DATE_FROM_DMY 1 1 2000) EQUALS DATE_FROM_DMY 6 10 2026
#ASSERT `By what date must I elect to pay by instalments` (DATE_FROM_DMY 1 9 2026) TRUE (DATE_FROM_DMY 20 10 2026) EQUALS DATE_FROM_DMY 20 10 2026
-- s 73(2): $2,500 / 3 = 833.333... -> $833.33. $7,800 / 3 = $2,600. $1,000.01 / 3 = 333.3366... -> $333.34.
#ASSERT `How much is each instalment` 2500 EQUALS 833.33
#ASSERT `How much is each instalment` 7800 EQUALS 2600
#ASSERT `How much is each instalment` 1000.01 EQUALS 333.34
-- The 3 instalments need not add up to the tax: 3 x 833.33 = 2,499.99; 3 x 333.34 = 1,000.02 (finding 13).
#ASSERT 3 TIMES `How much is each instalment` 2500 EQUALS 2499.99
#ASSERT 3 TIMES `How much is each instalment` 1000.01 EQUALS 1000.02
-- s 71(4): notice 1 September 2026: +45 = 16 October 2026; +90 = 30 November 2026; +150 = 29 January 2027.
#ASSERT `On what dates are my instalments due` (DATE_FROM_DMY 1 9 2026) EQUALS LIST (DATE_FROM_DMY 16 10 2026), (DATE_FROM_DMY 30 11 2026), (DATE_FROM_DMY 29 1 2027)
-- s 74: $2,500, notice 1 September 2026, full payment date 2 October 2026. Missing the first instalment (16 October):
-- all $2,500 is due by the later of 2 October and 16 October, so 16 October; interest from 3 October.
#ASSERT (`I missed an instalment: what now` 2500 1 (DATE_FROM_DMY 1 9 2026) (DATE_FROM_DMY 2 10 2026))'s `the outstanding land tax I must now pay in full, in dollars` EQUALS 2500
#ASSERT (`I missed an instalment: what now` 2500 1 (DATE_FROM_DMY 1 9 2026) (DATE_FROM_DMY 2 10 2026))'s `I must pay it no later than` EQUALS DATE_FROM_DMY 16 10 2026
#ASSERT (`I missed an instalment: what now` 2500 1 (DATE_FROM_DMY 1 9 2026) (DATE_FROM_DMY 2 10 2026))'s `unpaid tax interest runs from` EQUALS DATE_FROM_DMY 3 10 2026
-- Missing the second (30 November): 2,500 - 833.33 = $1,666.67, by 30 November; interest still from 3 October (finding 14).
#ASSERT (`I missed an instalment: what now` 2500 2 (DATE_FROM_DMY 1 9 2026) (DATE_FROM_DMY 2 10 2026))'s `the outstanding land tax I must now pay in full, in dollars` EQUALS 1666.67
#ASSERT (`I missed an instalment: what now` 2500 2 (DATE_FROM_DMY 1 9 2026) (DATE_FROM_DMY 2 10 2026))'s `I must pay it no later than` EQUALS DATE_FROM_DMY 30 11 2026
#ASSERT (`I missed an instalment: what now` 2500 2 (DATE_FROM_DMY 1 9 2026) (DATE_FROM_DMY 2 10 2026))'s `unpaid tax interest runs from` EQUALS DATE_FROM_DMY 3 10 2026
-- Missing the third: 2,500 - 2 x 833.33 = $833.34, a cent more than an instalment, by 29 January 2027.
#ASSERT (`I missed an instalment: what now` 2500 3 (DATE_FROM_DMY 1 9 2026) (DATE_FROM_DMY 2 10 2026))'s `the outstanding land tax I must now pay in full, in dollars` EQUALS 833.34
#ASSERT (`I missed an instalment: what now` 2500 3 (DATE_FROM_DMY 1 9 2026) (DATE_FROM_DMY 2 10 2026))'s `I must pay it no later than` EQUALS DATE_FROM_DMY 29 1 2027
-- A notice giving 59 days to pay in full (30 October 2026): missing the first instalment, pay by 30 October; interest from 31 October.
#ASSERT (`I missed an instalment: what now` 2500 1 (DATE_FROM_DMY 1 9 2026) (DATE_FROM_DMY 30 10 2026))'s `I must pay it no later than` EQUALS DATE_FROM_DMY 30 10 2026
#ASSERT (`I missed an instalment: what now` 2500 1 (DATE_FROM_DMY 1 9 2026) (DATE_FROM_DMY 30 10 2026))'s `unpaid tax interest runs from` EQUALS DATE_FROM_DMY 31 10 2026

-- The regulative rule: $2,500, 31 days to pay in full, 35 days to elect.
-- Paid in full on day 31: done.
#ASSERT EVALTRACE (`ss 71 to 74 and Regulation s 4 -- the taxpayer pays in full by the stated date, or elects within 35 days and pays 3 instalments` 2500 31 35) 0 (LIST (EVENT `the taxpayer` (`pay the land tax in full` 2500) 31)) EQUALS FULFILLED
-- Elected on day 20 and paid the 3 instalments on days 45, 90 and 150: done.
#ASSERT EVALTRACE (`ss 71 to 74 and Regulation s 4 -- the taxpayer pays in full by the stated date, or elects within 35 days and pays 3 instalments` 2500 31 35) 0 (LIST (EVENT `the taxpayer` `elect to pay by instalments by giving a direct debit authority` 20), (EVENT `the taxpayer` `pay the first instalment by direct debit` 45), (EVENT `the taxpayer` `pay the second instalment by direct debit` 90), (EVENT `the taxpayer` `pay the third instalment by direct debit` 150)) EQUALS FULFILLED
-- Elected on day 34, after the day-31 full payment date but within the 35 days: still allowed (finding 12).
#ASSERT EVALTRACE (`ss 71 to 74 and Regulation s 4 -- the taxpayer pays in full by the stated date, or elects within 35 days and pays 3 instalments` 2500 31 35) 0 (LIST (EVENT `the taxpayer` `elect to pay by instalments by giving a direct debit authority` 34), (EVENT `the taxpayer` `pay the first instalment by direct debit` 45), (EVENT `the taxpayer` `pay the second instalment by direct debit` 90), (EVENT `the taxpayer` `pay the third instalment by direct debit` 150)) EQUALS FULFILLED
-- The second instalment missed; the outstanding $1,666.67 paid at once: done (with interest from day 32).
#ASSERT EVALTRACE (`ss 71 to 74 and Regulation s 4 -- the taxpayer pays in full by the stated date, or elects within 35 days and pays 3 instalments` 2500 31 35) 0 (LIST (EVENT `the taxpayer` `elect to pay by instalments by giving a direct debit authority` 20), (EVENT `the taxpayer` `pay the first instalment by direct debit` 45), (WAITUNTIL 91), (EVENT `the taxpayer` (`pay the land tax in full` 1666.67) 91)) EQUALS FULFILLED
-- The third instalment missed; the outstanding $833.34 paid at once: done.
#ASSERT EVALTRACE (`ss 71 to 74 and Regulation s 4 -- the taxpayer pays in full by the stated date, or elects within 35 days and pays 3 instalments` 2500 31 35) 0 (LIST (EVENT `the taxpayer` `elect to pay by instalments by giving a direct debit authority` 20), (EVENT `the taxpayer` `pay the first instalment by direct debit` 45), (EVENT `the taxpayer` `pay the second instalment by direct debit` 90), (WAITUNTIL 151), (EVENT `the taxpayer` (`pay the land tax in full` 833.34) 151)) EQUALS FULFILLED
-- 59 days to pay in full: the first instalment missed (day 45); all $2,500 paid on day 59: done.
#ASSERT EVALTRACE (`ss 71 to 74 and Regulation s 4 -- the taxpayer pays in full by the stated date, or elects within 35 days and pays 3 instalments` 2500 59 35) 0 (LIST (EVENT `the taxpayer` `elect to pay by instalments by giving a direct debit authority` 20), (WAITUNTIL 46), (EVENT `the taxpayer` (`pay the land tax in full` 2500) 59)) EQUALS FULFILLED
-- expect: BREACH BY the taxpayer, "TAA s 30(1)(e): ..." OR BREACH BY the taxpayer, "s 74(2), (3): ..." (first instalment missed, nothing paid)
#TRACE (`ss 71 to 74 and Regulation s 4 -- the taxpayer pays in full by the stated date, or elects within 35 days and pays 3 instalments` 2500 31 35) AT 0 WITH
    PARTY `the taxpayer` DOES `elect to pay by instalments by giving a direct debit authority` AT 20
    (WAITUNTIL 46)
    (WAITUNTIL 50)
-- expect: BREACH BY the taxpayer, "TAA s 30(1)(e): ..." OR BREACH BY the taxpayer, "s 72 and Regulation s 4: ..." (no payment, no election)
#TRACE (`ss 71 to 74 and Regulation s 4 -- the taxpayer pays in full by the stated date, or elects within 35 days and pays 3 instalments` 2500 31 35) AT 0 WITH
    (WAITUNTIL 36)

§§ `TAA s 54 -- unpaid tax interest`

-- The s 54(5) example: a lodgement requirement due 10 March and met on 15 March is 5 days of noncompliance; with a due
-- date of 17 April the start date is 13 April.
#ASSERT `From what date does unpaid tax interest run` (DATE_FROM_DMY 17 4 2027) 5 EQUALS DATE_FROM_DMY 13 4 2027
#ASSERT `From what date does unpaid tax interest run` (DATE_FROM_DMY 12 4 2027) 0 EQUALS DATE_FROM_DMY 13 4 2027
-- 13 April to 24 April, both inclusive: 12 days.
#ASSERT `the days of interest, both dates inclusive (TAA s 54(2))` (DATE_FROM_DMY 13 4 2027) (DATE_FROM_DMY 24 4 2027) EQUALS 12
-- Paid before the start date: no days.
#ASSERT `the days of interest, both dates inclusive (TAA s 54(2))` (DATE_FROM_DMY 13 4 2027) (DATE_FROM_DMY 10 4 2027) EQUALS 0
-- The s 54(7) example: $10,000 at 10% a year for those 12 days is "$32.87": 10,000 x 0.10 x 12 / 365 = 32.8767..., which
-- the example cuts to the cent (finding 16).
#ASSERT TRUNC (`How much unpaid tax interest do I owe` 10000 10 (DATE_FROM_DMY 12 4 2027) 0 (DATE_FROM_DMY 24 4 2027)) 2 EQUALS 32.87
#ASSERT `How much unpaid tax interest do I owe` 10000 10 (DATE_FROM_DMY 12 4 2027) 0 (DATE_FROM_DMY 24 4 2027) GREATER THAN 32.875
#ASSERT `How much unpaid tax interest do I owe` 10000 10 (DATE_FROM_DMY 12 4 2027) 0 (DATE_FROM_DMY 24 4 2027) LESS THAN 32.88
-- The same tax and dates with a due date of 17 April and the 5 days of noncompliance: the same 12 days.
#ASSERT TRUNC (`How much unpaid tax interest do I owe` 10000 10 (DATE_FROM_DMY 17 4 2027) 5 (DATE_FROM_DMY 24 4 2027)) 2 EQUALS 32.87

§§ `TAA s 58 -- penalty tax`

-- A home found not to be exempt: reassessed from $2,500 to $7,800. Penalty tax 75% x 5,300 = $3,975; at most 20% more,
-- $4,770, if the Commissioner is satisfied the owner did not advise under s 28 or hindered the Commissioner.
#ASSERT `What is the most penalty tax I can be charged` `a reassessment of another assessment` 7800 2500 2500 FALSE EQUALS 3975
#ASSERT `What is the most penalty tax I can be charged` `a reassessment of another assessment` 7800 2500 2500 TRUE EQUALS 4770
-- No s 77 notice given, so a default assessment of $7,800: 75% = $5,850; with the increase, at most $7,020.
#ASSERT `What is the most penalty tax I can be charged` `a default assessment under TAA s 13(1)(a) or (b)` 7800 7800 7800 FALSE EQUALS 5850
#ASSERT `What is the most penalty tax I can be charged` `a default assessment under TAA s 13(1)(a) or (b)` 7800 7800 7800 TRUE EQUALS 7020
-- s 58(2)(d): original $5,000, an earlier reassessment $3,000, the last $4,000: 75% x (4,000 - 3,000) = $750.
#ASSERT `What is the most penalty tax I can be charged` `a reassessment of another assessment` 4000 5000 3000 FALSE EQUALS 750
-- A last reassessment back at the original $5,000 after an earlier $3,000: liable under s 58(1)(c), but neither (2)(c)
-- nor (2)(d) gives an amount: nil here (finding 17).
#ASSERT `What is the most penalty tax I can be charged` `a reassessment of another assessment` 5000 5000 3000 FALSE EQUALS 0
#ASSERT `What is the most penalty tax I can be charged` `an original assessment that is not a default assessment` 7800 7800 7800 TRUE EQUALS 0

§§ `ss 59, 60 -- unpaid land tax on land I bought`

-- The seller's unpaid tax was imposed before the purchase; with a clearance certificate showing none, the buyer is safe.
#ASSERT (NOT (`Can unpaid land tax be recovered from me` TRUE TRUE))
#ASSERT `Can unpaid land tax be recovered from me` TRUE FALSE
#ASSERT (NOT (`Is my land subject to the charge for unpaid land tax` TRUE TRUE FALSE))
#ASSERT `Is my land subject to the charge for unpaid land tax` TRUE FALSE FALSE
#ASSERT (NOT (`Is my land subject to the charge for unpaid land tax` FALSE FALSE TRUE))

§§ `s 81, TAA ss 63 to 69 -- objecting and appealing`

#ASSERT `Can I object on this ground` `an original assessment, not a compromise assessment` TRUE EQUALS `no: not on the ground that the Land Valuation Act value is excessive; that is objected to under the Land Valuation Act 2010 (s 81)`
#ASSERT `Can I object on this ground` `an original assessment, not a compromise assessment` FALSE EQUALS `yes: an objection may be made on any ground other than that the Land Valuation Act value is excessive (TAA s 64(1); s 81)`
#ASSERT `Can I object on this ground` `a compromise assessment` FALSE EQUALS `no: a compromise assessment cannot be objected to (TAA s 63(1))`
#ASSERT `Can I object on this ground` `a reassessment increasing the liability` FALSE EQUALS `yes, but only about the changes the reassessment made (TAA s 63(3))`
#ASSERT `Can I object on this ground` `another reassessment` FALSE EQUALS `no: this kind of reassessment cannot be objected to (TAA s 63(2))`
-- Notice 1 September 2026: object by 31 October 2026; or by an extended day.
#ASSERT `By what date must I lodge my objection` (DATE_FROM_DMY 1 9 2026) FALSE (DATE_FROM_DMY 1 1 2000) EQUALS DATE_FROM_DMY 31 10 2026
#ASSERT `By what date must I lodge my objection` (DATE_FROM_DMY 1 9 2026) TRUE (DATE_FROM_DMY 30 11 2026) EQUALS DATE_FROM_DMY 30 11 2026
-- Decision notice 1 March 2027: appeal or apply to QCAT by 30 April 2027, once the tax and interest are paid.
-- (1 March + 60 days: 30 days to 31 March, 30 more to 30 April.) The last day itself is in time; the day after is not.
#ASSERT `Can I appeal against the decision on my objection` FALSE (DATE_FROM_DMY 1 3 2027) TRUE (DATE_FROM_DMY 15 4 2027) EQUALS `an appeal to the Supreme Court, or an application to QCAT for a review, may be made no later than` (DATE_FROM_DMY 30 4 2027)
#ASSERT `Can I appeal against the decision on my objection` FALSE (DATE_FROM_DMY 1 3 2027) TRUE (DATE_FROM_DMY 30 4 2027) EQUALS `an appeal to the Supreme Court, or an application to QCAT for a review, may be made no later than` (DATE_FROM_DMY 30 4 2027)
#ASSERT `Can I appeal against the decision on my objection` FALSE (DATE_FROM_DMY 1 3 2027) FALSE (DATE_FROM_DMY 15 4 2027) EQUALS `not yet: the whole of the tax and late payment interest must first be paid (TAA s 69(1)(b)); the 60 days still run, ending on` (DATE_FROM_DMY 30 4 2027)
#ASSERT `Can I appeal against the decision on my objection` FALSE (DATE_FROM_DMY 1 3 2027) TRUE (DATE_FROM_DMY 1 5 2027) EQUALS `no: the 60 days after notice of the decision have passed, and they cannot be extended (TAA ss 69(2), (3), 70(3))`
#ASSERT `Can I appeal against the decision on my objection` TRUE (DATE_FROM_DMY 1 3 2027) TRUE (DATE_FROM_DMY 15 4 2027) EQUALS `no appeal or review is needed: the objection was allowed completely`

-- The regulative rule (60 days to object): objection on day 50, disallowed on day 120, appeal after paying on day 170.
#ASSERT EVALTRACE (`TAA ss 63 to 69 and s 81 -- objecting within 60 days, the Commissioner's decision, and appeal or review within 60 days after paying` 60) 0 (LIST (EVENT `the taxpayer` (`lodge an objection` FALSE TRUE) 50), (EVENT `the Commissioner` (`decide the objection and give written notice of the decision` FALSE) 120), (EVENT `the taxpayer` (`appeal to the Supreme Court or apply to QCAT for a review` TRUE) 170)) EQUALS FULFILLED
-- Allowed completely: nothing further.
#ASSERT EVALTRACE (`TAA ss 63 to 69 and s 81 -- objecting within 60 days, the Commissioner's decision, and appeal or review within 60 days after paying` 60) 0 (LIST (EVENT `the taxpayer` (`lodge an objection` FALSE TRUE) 50), (EVENT `the Commissioner` (`decide the objection and give written notice of the decision` TRUE) 120)) EQUALS FULFILLED
-- An "objection" on the valuation ground does not count (s 81); the 60 days lapse with nothing owed to the taxpayer.
#ASSERT EVALTRACE (`TAA ss 63 to 69 and s 81 -- objecting within 60 days, the Commissioner's decision, and appeal or review within 60 days after paying` 60) 0 (LIST (EVENT `the taxpayer` (`lodge an objection` TRUE TRUE) 50), (WAITUNTIL 61)) EQUALS FULFILLED
-- expect: PARTY the Commissioner MUST decide the objection and give written notice of the decision (still owed)
#TRACE (`TAA ss 63 to 69 and s 81 -- objecting within 60 days, the Commissioner's decision, and appeal or review within 60 days after paying` 60) AT 0 WITH
    PARTY `the taxpayer` DOES `lodge an objection` FALSE TRUE AT 50
-- expect: PARTY the taxpayer DO appeal ... PROVIDED paid, WITHIN the rest of the 60 days (an appeal before paying does not count)
#TRACE (`TAA ss 63 to 69 and s 81 -- objecting within 60 days, the Commissioner's decision, and appeal or review within 60 days after paying` 60) AT 0 WITH
    PARTY `the taxpayer` DOES `lodge an objection` FALSE TRUE AT 50
    PARTY `the Commissioner` DOES `decide the objection and give written notice of the decision` FALSE AT 120
    PARTY `the taxpayer` DOES `appeal to the Supreme Court or apply to QCAT for a review` FALSE AT 150
