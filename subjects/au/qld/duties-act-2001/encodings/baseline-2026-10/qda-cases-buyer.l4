-- =====================================================================================================================
-- 1. DUTIABLE VALUE AND THE GENERAL RATE (s 11(7), s 24(2), Schedule 3)
-- =====================================================================================================================

-- s 11(7)(b)(iii): value above the price, so the value. (b)(i): no consideration, so the value.
#ASSERT `What is the dutiable value of my purchase` 500000 520000 EQUALS 520000
#ASSERT `What is the dutiable value of my purchase` 0 400000 EQUALS 400000
#ASSERT `What is the dutiable value of my purchase` 610000 600000 EQUALS 610000

-- Not more than $5,000: nil. $5,001: one part of $100 over $5,000 at $1.50.
#ASSERT `How much transfer duty would I pay at the general rate` 5000 5000 EQUALS 0
#ASSERT `How much transfer duty would I pay at the general rate` 5001 0 EQUALS 1.5
-- $75,000: 1.50 x 700 = 1,050 (the next band's base).
#ASSERT `How much transfer duty would I pay at the general rate` 75000 75000 EQUALS 1050
#ASSERT `How much transfer duty would I pay at the general rate` 300000 300000 EQUALS 8925
#ASSERT `How much transfer duty would I pay at the general rate` 500000 500000 EQUALS 15925
-- $540,050: 17,325 + 4.50 x 1 (the $50 is a part of $100) = 17,329.50.
#ASSERT `How much transfer duty would I pay at the general rate` 540050 540050 EQUALS 17329.5
#ASSERT `How much transfer duty would I pay at the general rate` 600000 600000 EQUALS 20025
#ASSERT `How much transfer duty would I pay at the general rate` 1200000 1200000 EQUALS 49525

-- =====================================================================================================================
-- 2. THE HOME CONCESSION (s 91). HYPOTHETICAL: a citizen couple who have owned before buy an established house in
-- Brisbane; contract 3 July 2026, possession 1 August 2026, moving in 15 August 2026.
-- =====================================================================================================================

#ASSERT `Which home concession do I get` `residential land` 600000 600000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `an Australian citizen` TRUE FALSE TRUE FALSE EQUALS `the home concession (s 91)`
-- s 91(5): 3,500 + (20,025 - 10,675) = 12,850.
#ASSERT `How much transfer duty must I pay before AFAD` `residential land` 600000 600000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `an Australian citizen` TRUE FALSE TRUE FALSE EQUALS `the duty, in dollars, is` 12850
-- Saving: 20,025 - 12,850 = 7,175 (above $350,000 the saving is always 10,675 - 3,500).
#ASSERT `How much does my home concession save me` `residential land` 600000 600000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `an Australian citizen` TRUE FALSE TRUE FALSE EQUALS `the saving, in dollars, is` 7175
-- $300,000: s 91(3): $1 x 3,000 parts + (8,925 - 8,925) = 3,000; saving 8,925 - 3,000 = 5,925.
#ASSERT `How much transfer duty must I pay before AFAD` `residential land` 300000 300000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `an Australian citizen` TRUE FALSE TRUE FALSE EQUALS `the duty, in dollars, is` 3000
#ASSERT `How much does my home concession save me` `residential land` 300000 300000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `an Australian citizen` TRUE FALSE TRUE FALSE EQUALS `the saving, in dollars, is` 5925
-- $500,000 house with $20,000 of furniture: T = 520,000, residential land 500,000: 3,500 + (16,625 - 10,675) = 9,450.
#ASSERT `How much transfer duty must I pay before AFAD` `residential land` 520000 520000 20000 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `an Australian citizen` TRUE FALSE TRUE FALSE EQUALS `the duty, in dollars, is` 9450
-- s 86(1): moving in on 1 August 2027, the first anniversary of possession, is within 1 year; on 2 August 2027 it is not,
-- and the general rate applies (20,025).
#ASSERT `How much transfer duty must I pay before AFAD` `residential land` 600000 600000 0 TRUE `1 Aug 2026` TRUE `1 Aug 2027` `an Australian citizen` TRUE FALSE TRUE FALSE EQUALS `the duty, in dollars, is` 12850
#ASSERT `Which home concession do I get` `residential land` 600000 600000 0 TRUE `1 Aug 2026` TRUE `2 Aug 2027` `an Australian citizen` TRUE FALSE TRUE FALSE EQUALS `no home concession`
#ASSERT `How much transfer duty must I pay before AFAD` `residential land` 600000 600000 0 TRUE `1 Aug 2026` TRUE `2 Aug 2027` `an Australian citizen` TRUE FALSE TRUE FALSE EQUALS `the duty, in dollars, is` 20025
-- An investor who will not live there: general rate.
#ASSERT `How much transfer duty must I pay before AFAD` `residential land` 600000 600000 0 TRUE `1 Aug 2026` FALSE `15 Aug 2026` `an Australian citizen` TRUE FALSE TRUE FALSE EQUALS `the duty, in dollars, is` 20025
-- s 91(1)(c): a buyer who is not a specified resident gets no home concession.
#ASSERT `Which home concession do I get` `residential land` 600000 600000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `none of these` TRUE FALSE TRUE FALSE EQUALS `no home concession`
-- Schedule 6 "permanent resident" (b): a New Zealand citizen on a special category visa does get it.
#ASSERT `Which home concession do I get` `residential land` 600000 600000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `a New Zealand citizen holding a special category visa` TRUE FALSE TRUE FALSE EQUALS `the home concession (s 91)`
-- A trustee or company buyer: not covered.
#ASSERT `How much transfer duty must I pay before AFAD` `residential land` 600000 600000 0 FALSE `1 Aug 2026` TRUE `15 Aug 2026` `an Australian citizen` TRUE FALSE TRUE FALSE EQUALS `not covered` `a buyer is a trustee or not an individual: the trust concessions and trust rules are not encoded`
#ASSERT `How much does my home concession save me` `residential land` 600000 600000 0 FALSE `1 Aug 2026` TRUE `15 Aug 2026` `an Australian citizen` TRUE FALSE TRUE FALSE EQUALS `no saving is worked out` `a buyer is a trustee or not an individual: the trust concessions and trust rules are not encoded`

-- =====================================================================================================================
-- 3. THE FIRST HOME CONCESSION (s 92, Schedule 4A). HYPOTHETICAL: a 30-year-old citizen who has never owned property
-- buys an established unit; possession 1 August 2026, moving in 15 August 2026.
-- =====================================================================================================================

-- $600,000: s 91 duty 12,850; Schedule 4A first row: the lesser of 17,350 and 12,850 = 12,850; duty nil; saving 20,025.
#ASSERT `Which home concession do I get` `residential land` 600000 600000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `an Australian citizen` TRUE TRUE TRUE FALSE EQUALS `the first home concession (s 92)`
#ASSERT `How much transfer duty must I pay before AFAD` `residential land` 600000 600000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `an Australian citizen` TRUE TRUE TRUE FALSE EQUALS `the duty, in dollars, is` 0
#ASSERT `How much does my home concession save me` `residential land` 600000 600000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `an Australian citizen` TRUE TRUE TRUE FALSE EQUALS `the saving, in dollars, is` 20025
-- $700,000: s 91 duty 3,500 + 24,525 - 10,675 = 17,350, exactly the full concession: nil.
#ASSERT `How much transfer duty must I pay before AFAD` `residential land` 700000 700000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `an Australian citizen` TRUE TRUE TRUE FALSE EQUALS `the duty, in dollars, is` 0
-- $705,000: s 91 duty 3,500 + 24,750 - 10,675 = 17,575; less 17,350 = 225.
#ASSERT `How much transfer duty must I pay before AFAD` `residential land` 705000 705000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `an Australian citizen` TRUE TRUE TRUE FALSE EQUALS `the duty, in dollars, is` 225
-- $750,000 at arm's length (price = value, so s 92(1)(c)(ii) is met): s 91 duty 3,500 + 26,775 - 10,675 = 19,600;
-- Schedule 4A $750,000-$759,999.99 row 8,675; duty 10,925.
#ASSERT `How much transfer duty must I pay before AFAD` `residential land` 750000 750000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `an Australian citizen` TRUE TRUE TRUE FALSE EQUALS `the duty, in dollars, is` 10925
-- $750,000 paid for a unit worth $760,000: the value is over $700,000 and the price below it, so s 92 fails; s 91 on the
-- dutiable value 760,000: 3,500 + 27,225 - 10,675 = 20,050.
#ASSERT `Which home concession do I get` `residential land` 750000 760000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `an Australian citizen` TRUE TRUE TRUE FALSE EQUALS `the home concession (s 91)`
#ASSERT `How much transfer duty must I pay before AFAD` `residential land` 750000 760000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `an Australian citizen` TRUE TRUE TRUE FALSE EQUALS `the duty, in dollars, is` 20050
-- $650,000 paid for a unit worth $690,000: the value is not over $700,000, so s 92(1)(c)(i) is met; dutiable value
-- 690,000; s 91 duty 3,500 + 24,075 - 10,675 = 16,900; concession the lesser of 17,350 and 16,900; nil.
#ASSERT `How much transfer duty must I pay before AFAD` `residential land` 650000 690000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `an Australian citizen` TRUE TRUE TRUE FALSE EQUALS `the duty, in dollars, is` 0
-- $790,000: s 91 duty 3,500 + 28,575 - 10,675 = 21,400; less 1,735 = 19,665.
#ASSERT `How much transfer duty must I pay before AFAD` `residential land` 790000 790000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `an Australian citizen` TRUE TRUE TRUE FALSE EQUALS `the duty, in dollars, is` 19665
-- $799,999: Schedule 3 counts 2,600 parts (2,599.99 rounded up): 29,025; s 91 duty 21,850; less 1,735 = 20,115.
#ASSERT `How much transfer duty must I pay before AFAD` `residential land` 799999 799999 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `an Australian citizen` TRUE TRUE TRUE FALSE EQUALS `the duty, in dollars, is` 20115
-- $800,000: Schedule 4A nil; s 92 still "applies" but gives the s 91 duty, 3,500 + 29,025 - 10,675 = 21,850.
#ASSERT `Which home concession do I get` `residential land` 800000 800000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `an Australian citizen` TRUE TRUE TRUE FALSE EQUALS `the first home concession (s 92)`
#ASSERT `How much transfer duty must I pay before AFAD` `residential land` 800000 800000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `an Australian citizen` TRUE TRUE TRUE FALSE EQUALS `the duty, in dollars, is` 21850
-- Aged 17 on the contract day: s 92(1)(b)(i) fails; s 91 at $600,000: 12,850.
#ASSERT `How much transfer duty must I pay before AFAD` `residential land` 600000 600000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `an Australian citizen` FALSE TRUE TRUE FALSE EQUALS `the duty, in dollars, is` 12850
-- Owned an apartment overseas: s 86(2)(a) "in Queensland or elsewhere"; not a first home; s 91: 12,850.
#ASSERT `Which home concession do I get` `residential land` 600000 600000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `an Australian citizen` TRUE FALSE TRUE FALSE EQUALS `the home concession (s 91)`
-- A Subclass 405 retiree is a specified resident (s 90A(c)): the first home concession applies, nil.
#ASSERT `How much transfer duty must I pay before AFAD` `residential land` 600000 600000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `the holder of a Subclass 405 or 410 retirement visa` TRUE TRUE TRUE FALSE EQUALS `the duty, in dollars, is` 0
-- s 246(2)(b): a parent visa applicant who applied on or after 8 May 2018, whose last substantive visa was a Subclass 405
-- visa and whose application is undecided, is a specified foreign retiree, so a specified resident (s 90A(c)): s 92, nil.
#ASSERT `Which home concession do I get` `residential land` 600000 600000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `an undecided Subclass 103 or 143 parent visa applicant who applied on or after 8 May 2018 and whose last substantive visa was a Subclass 405 or 410 visa` TRUE TRUE TRUE FALSE EQUALS `the first home concession (s 92)`
#ASSERT `How much transfer duty must I pay before AFAD` `residential land` 600000 600000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `an undecided Subclass 103 or 143 parent visa applicant who applied on or after 8 May 2018 and whose last substantive visa was a Subclass 405 or 410 visa` TRUE TRUE TRUE FALSE EQUALS `the duty, in dollars, is` 0
-- One who applied before 8 May 2018 fails s 246(2)(b)(i) and answers "none of these": not a specified resident (s 90A),
-- so neither s 91 nor s 92; the general rate, 20,025.
#ASSERT `Which home concession do I get` `residential land` 600000 600000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `none of these` TRUE TRUE TRUE FALSE EQUALS `no home concession`
#ASSERT `How much transfer duty must I pay before AFAD` `residential land` 600000 600000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `none of these` TRUE TRUE TRUE FALSE EQUALS `the duty, in dollars, is` 20025

-- =====================================================================================================================
-- 4. FIRST HOME AND NEW HOME (s 92A). HYPOTHETICAL: a first home buyer buys a never-occupied apartment off a developer.
-- =====================================================================================================================

-- $900,000: s 92A(3): 33,525 - 33,525 = nil; saving 33,525. No value limit.
#ASSERT `Which home concession do I get` `residential land` 900000 900000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `an Australian citizen` TRUE TRUE TRUE TRUE EQUALS `the first home and new home concession (s 92A)`
#ASSERT `How much transfer duty must I pay before AFAD` `residential land` 900000 900000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `an Australian citizen` TRUE TRUE TRUE TRUE EQUALS `the duty, in dollars, is` 0
#ASSERT `How much does my home concession save me` `residential land` 900000 900000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `an Australian citizen` TRUE TRUE TRUE TRUE EQUALS `the saving, in dollars, is` 33525
-- $2,000,000 new house: nil; saving 95,525.
#ASSERT `How much does my home concession save me` `residential land` 2000000 2000000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `an Australian citizen` TRUE TRUE TRUE TRUE EQUALS `the saving, in dollars, is` 95525
-- $30,000 of furniture in a $930,000 price: 34,875 - 33,525 = 1,350 (the price 930,000 is at least the land's value
-- 900,000, s 92A(1)(d)).
#ASSERT `How much transfer duty must I pay before AFAD` `residential land` 930000 930000 30000 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `an Australian citizen` TRUE TRUE TRUE TRUE EQUALS `the duty, in dollars, is` 1350
-- A new home bought from family for $650,000 when it is worth $700,000: s 92A(1)(d) fails, and s 92 is closed to a new
-- home (s 92(1)(aa)); s 91 on 700,000: 3,500 + 24,525 - 10,675 = 17,350.
#ASSERT `Which home concession do I get` `residential land` 650000 700000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `an Australian citizen` TRUE TRUE TRUE TRUE EQUALS `the home concession (s 91)`
#ASSERT `How much transfer duty must I pay before AFAD` `residential land` 650000 700000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `an Australian citizen` TRUE TRUE TRUE TRUE EQUALS `the duty, in dollars, is` 17350

-- =====================================================================================================================
-- 5. FIRST HOME ON VACANT LAND (ss 86B, 92B). HYPOTHETICAL: a first home buyer buys a $400,000 block, possession
-- 1 August 2026, to build and move in.
-- =====================================================================================================================

-- Moving in on 1 July 2028, within 2 years: s 92B(3): 12,425 - 12,425 = nil; saving 12,425.
#ASSERT `Which home concession do I get` `vacant land` 400000 400000 0 TRUE `1 Aug 2026` TRUE `1 Jul 2028` `an Australian citizen` TRUE TRUE TRUE FALSE EQUALS `the first home vacant land concession (s 92B)`
#ASSERT `How much transfer duty must I pay before AFAD` `vacant land` 400000 400000 0 TRUE `1 Aug 2026` TRUE `1 Jul 2028` `an Australian citizen` TRUE TRUE TRUE FALSE EQUALS `the duty, in dollars, is` 0
#ASSERT `How much does my home concession save me` `vacant land` 400000 400000 0 TRUE `1 Aug 2026` TRUE `1 Jul 2028` `an Australian citizen` TRUE TRUE TRUE FALSE EQUALS `the saving, in dollars, is` 12425
-- 1 August 2028 is the second anniversary (within); 2 August 2028 is not: general rate, 12,425.
#ASSERT `How much transfer duty must I pay before AFAD` `vacant land` 400000 400000 0 TRUE `1 Aug 2026` TRUE `1 Aug 2028` `an Australian citizen` TRUE TRUE TRUE FALSE EQUALS `the duty, in dollars, is` 0
#ASSERT `How much transfer duty must I pay before AFAD` `vacant land` 400000 400000 0 TRUE `1 Aug 2026` TRUE `2 Aug 2028` `an Australian citizen` TRUE TRUE TRUE FALSE EQUALS `the duty, in dollars, is` 12425
-- Vacant land bought by someone who has owned before: no concession at all (s 91 needs a residence): 12,425.
#ASSERT `Which home concession do I get` `vacant land` 400000 400000 0 TRUE `1 Aug 2026` TRUE `1 Jul 2028` `an Australian citizen` TRUE FALSE TRUE FALSE EQUALS `no home concession`

-- =====================================================================================================================
-- 6. TWO BUYERS, ONLY ONE QUALIFIES (s 93(1)(c)(ii), (7)). HYPOTHETICAL: Ana, a citizen first home buyer, buys an
-- established $600,000 house half and half with her brother, who will not live there.
-- =====================================================================================================================

-- Concessional duty (s 93(8)(a)(ii)): 3,500 less the s 92(2) deduction, the lesser of 17,350 and the s 91 duty of
-- 12,850: 3,500 - 12,850 = -9,350. (a): 0.5 x -9,350 = -4,675. (b): the lesser of 0.5 x 600,000 = 300,000 and
-- 0.5 x 350,000 = 175,000 is 175,000; 20,025 - 4,550 = 15,475. Total 10,800.
#ASSERT `How much transfer duty do we pay when only one of us qualifies` `residential land` 600000 600000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `an Australian citizen` TRUE TRUE TRUE FALSE 0.5 FALSE EQUALS `the duty, in dollars, is` 10800
-- (A foreign spouse in the brother's place gives the same answer: the last answer stays "no", as he is not a specified
-- resident; see case 10 for his AFAD.) The same, if Ana has owned before (home only): (a) 0.5 x 3,500 = 1,750; total 1,750 + 15,475 = 17,225.
#ASSERT `How much transfer duty do we pay when only one of us qualifies` `residential land` 600000 600000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `an Australian citizen` TRUE FALSE TRUE FALSE 0.5 FALSE EQUALS `the duty, in dollars, is` 17225
-- $300,000, home only: concessional duty s 91(3)(a) = 3,000; (a) 1,500; (b) the lesser of 150,000 and 175,000 is
-- 150,000: 8,925 - 3,675 = 5,250. Total 6,750.
#ASSERT `How much transfer duty do we pay when only one of us qualifies` `residential land` 300000 300000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `an Australian citizen` TRUE FALSE TRUE FALSE 0.5 FALSE EQUALS `the duty, in dollars, is` 6750
-- At a 100% interest the s 93(7) formula gives the s 92 duty (nil) and the s 91 duty (12,850): checked through the core.
#ASSERT `the s 93(7) duty on` (`my purchase from my answers` `residential land` 600000 600000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `an Australian citizen` TRUE TRUE TRUE FALSE) `for an interest of` 1 EQUALS 0
#ASSERT `the s 93(7) duty on` (`my purchase from my answers` `residential land` 600000 600000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `an Australian citizen` TRUE FALSE TRUE FALSE) `for an interest of` 1 EQUALS 12850
-- Neither qualifies (Ana will not live there either): general rate, 20,025.
#ASSERT `How much transfer duty do we pay when only one of us qualifies` `residential land` 600000 600000 0 TRUE `1 Aug 2026` FALSE `15 Aug 2026` `an Australian citizen` TRUE TRUE TRUE FALSE 0.5 FALSE EQUALS `the duty, in dollars, is` 20025
-- Both qualify: not covered here.
#ASSERT `How much transfer duty do we pay when only one of us qualifies` `residential land` 600000 600000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `an Australian citizen` TRUE TRUE TRUE FALSE 0.5 TRUE EQUALS `not covered` `both buyers qualify: ask the question for all the buyers, or, for a home buyer with a first home buyer, s 93(6), which is not encoded`
-- A new home that is Ana's first home: s 93(3A) sends it to s 93A, not covered.
#ASSERT `How much transfer duty do we pay when only one of us qualifies` `residential land` 600000 600000 0 TRUE `1 Aug 2026` TRUE `15 Aug 2026` `an Australian citizen` TRUE TRUE TRUE TRUE 0.5 FALSE EQUALS `not covered` `the home is the first home and new home of the buyer who qualifies: s 93A is not encoded`
-- Vacant land, the block to be the first home of one buyer only (the other will not live there, or will but has owned
-- before): s 93B(1)(c), "but not all the transferees", not covered.
#ASSERT `How much transfer duty do we pay when only one of us qualifies` `vacant land` 400000 400000 0 TRUE `1 Aug 2026` TRUE `1 Jul 2028` `an Australian citizen` TRUE TRUE TRUE FALSE 0.5 FALSE EQUALS `not covered` `vacant land with two buyers of whom only one qualifies: s 93B is not encoded`
-- Vacant land where the home to be built will be the first home of both buyers: s 93B does not apply (it needs "not all
-- the transferees"), and the ordinary s 92B applies to them all, which the question for all the buyers answers (nil on
-- this $400,000 block, as in case 5).
#ASSERT `How much transfer duty do we pay when only one of us qualifies` `vacant land` 400000 400000 0 TRUE `1 Aug 2026` TRUE `1 Jul 2028` `an Australian citizen` TRUE TRUE TRUE FALSE 0.5 TRUE EQUALS `not covered` `both buyers of the vacant land will have the home to be built as their first home: s 93B does not apply, so ask the question for all the buyers (s 92B)`
#ASSERT `How much transfer duty must I pay before AFAD` `vacant land` 400000 400000 0 TRUE `1 Aug 2026` TRUE `1 Jul 2028` `an Australian citizen` TRUE TRUE TRUE FALSE EQUALS `the duty, in dollars, is` 0

-- =====================================================================================================================
-- 7. ELECTRONIC TRANSFERS (Duties Regulation 2023 s 5(1), Schedule 2 Part 1)
-- =====================================================================================================================

#ASSERT `Can my concession be applied in an electronic transfer` `the home concession (s 91)`
#ASSERT `Can my concession be applied in an electronic transfer` `the first home concession (s 92)`
#ASSERT `Can my concession be applied in an electronic transfer` `the first home and new home concession (s 92A)`
#ASSERT `Can my concession be applied in an electronic transfer` `the first home vacant land concession (s 92B)`
-- s 93 is not in Schedule 2 Part 1.
#ASSERT NOT (`Can my concession be applied in an electronic transfer` `the concession for one of two buyers (s 93)`)

-- =====================================================================================================================
-- 8. LODGING AND PAYING (ss 16, 19(3), 20, Schedule 2; Administration Act s 30)
-- =====================================================================================================================

-- Contract signed 3 August 2026: liability arises then (Schedule 2, agreement for transfer); 30 days after is
-- 2 September 2026 (28 days to 31 August, 2 more).
#ASSERT `By when must the contract be lodged for duty` `3 Aug 2026` EQUALS `2 Sep 2026`
-- s 30(1)(b): transaction statement lodged 10 August 2026; 14 days after is 24 August 2026.
#ASSERT `By when must I pay the transfer duty` `by a self assessor lodging a transaction statement` `10 Aug 2026` `1 Sep 2026` `1 Oct 2026` EQUALS `the duty must be paid by` `24 Aug 2026`
-- s 30(1)(e), (2): notice given 1 September 2026 stating 1 October 2026: exactly 30 days after; pay by 1 October.
#ASSERT `By when must I pay the transfer duty` `by the commissioner giving an assessment notice` `10 Aug 2026` `1 Sep 2026` `1 Oct 2026` EQUALS `the duty must be paid by` `1 Oct 2026`
-- A notice stating 20 September 2026 does not allow the 30 days.
#ASSERT `By when must I pay the transfer duty` `by the commissioner giving an assessment notice` `10 Aug 2026` `1 Sep 2026` `20 Sep 2026` EQUALS `the notice states a date less than 30 days after it was given, which s 30(2) does not allow; 30 days after it was given is` `1 Oct 2026`

-- ss 19(3), 20: the seller lodging on day 10 relieves the buyer; the buyer lodging on day 30 is in time.
#ASSERT EVALTRACE `ss 19(3), 20 -- the parties must lodge within 30 days after liability arises, and one party's lodging relieves the others` 0 (LIST (EVENT `another party to the transaction` `lodge the instrument and an approved form for the transaction` 10)) EQUALS FULFILLED
#ASSERT EVALTRACE `ss 19(3), 20 -- the parties must lodge within 30 days after liability arises, and one party's lodging relieves the others` 0 (LIST (EVENT `the transferee` `lodge the instrument and an approved form for the transaction` 30)) EQUALS FULFILLED
-- expect: BREACH BY the transferee, "s 19(3): ..." OR BREACH BY another party to the transaction (nobody lodged by day 30)
#TRACE `ss 19(3), 20 -- the parties must lodge within 30 days after liability arises, and one party's lodging relieves the others` AT 0 WITH
    (WAITUNTIL 31)

-- ss 30, 54(1): paid on day 14 of 14; or paid late, with interest.
#ASSERT EVALTRACE (`ss 30, 54(1) -- the taxpayer must pay by the due date, and after it must pay with unpaid tax interest` 14) 0 (LIST (EVENT `the taxpayer` `pay the tax` 14)) EQUALS FULFILLED
#ASSERT EVALTRACE (`ss 30, 54(1) -- the taxpayer must pay by the due date, and after it must pay with unpaid tax interest` 14) 0 (LIST (WAITUNTIL 15), (EVENT `the taxpayer` `pay the tax with the unpaid tax interest accrued on it` 40)) EQUALS FULFILLED
-- expect: the obligation still pending: the taxpayer MUST pay the tax with the unpaid tax interest accrued on it (no
