-- 4 February: late. The insurer and the agency agree, no court proceeding: may still be given.
#ASSERT `By when must I give my preservation notice` TRUE FALSE TRUE (`d` 20 1 2027) (`a date not used`) (`d` 4 2 2027) FALSE TRUE FALSE FALSE EQUALS `late: the notice may still be given, because the insurer and the agency agree (and any court has so ordered) (s 41(4))`
-- In court, the court has not ordered it: only if it does.
#ASSERT `By when must I give my preservation notice` TRUE FALSE TRUE (`d` 20 1 2027) (`a date not used`) (`d` 4 2 2027) FALSE TRUE TRUE FALSE EQUALS `late: the notice may be given only if the insurer and the agency agree and, if the claim is in court, the court orders it (s 41(4))`
#ASSERT `By when must I give my preservation notice` TRUE FALSE TRUE (`d` 20 1 2027) (`a date not used`) (`d` 4 2 2027) FALSE TRUE TRUE TRUE EQUALS `late: the notice may still be given, because the insurer and the agency agree (and any court has so ordered) (s 41(4))`
#ASSERT `By when must I give my preservation notice` TRUE FALSE TRUE (`d` 20 1 2027) (`a date not used`) (`d` 4 2 2027) TRUE TRUE FALSE FALSE EQUALS `late: a final judgment has been given or a settlement made, so the notice can no longer be given (s 41(4))`
-- Claim made first; notice of lifetime acceptance 15 August 2027: by 29 August 2027.
#ASSERT `By when must I give my preservation notice` TRUE FALSE FALSE (`a date not used`) (`d` 15 8 2027) (`d` 20 8 2027) FALSE FALSE FALSE FALSE EQUALS `I must give the s 41 notice to the agency and the insurer by` (`d` 29 8 2027)
#ASSERT `By when must I give my preservation notice` TRUE TRUE FALSE (`a date not used`) (`d` 15 8 2027) (`d` 20 8 2027) FALSE FALSE FALSE FALSE EQUALS `no: a court has ordered under s 43 that I may not be awarded treatment, care and support damages (s 43(5))`
#ASSERT `By when must I give my preservation notice` FALSE FALSE FALSE (`a date not used`) (`d` 15 8 2027) (`d` 20 8 2027) FALSE FALSE FALSE FALSE EQUALS `division 4 does not apply: not a lifetime participant with a claim against an insurer (s 40, s 13(5))`
#ASSERT EVALTRACE `s 41 -- the participant must give the preservation notice within 14 days, or later only with agreement` 0 (LIST (EVENT `the participant` `give the s 41 notice` 14)) EQUALS FULFILLED
