IMPORT prelude
IMPORT `wcra-core`
IMPORT `wcra-seat-insurer`
IMPORT `wcra-seat`

-- Cases for the insurer's seat (wcra-seat-insurer.l4), with MIRROR CASES: the same facts asked from the injured
-- worker's seat (wcra-seat.l4) and from the insurer's, with answers that agree. Every expected value was worked by hand
-- from the deposited Act, Regulation and QOTE Notice, never copied from the encoding's output; the arithmetic is in the
-- comment above each (the same worked figures as wcra-cases-worker.l4 where the facts are the same). HYPOTHETICAL
-- throughout. Calendar: 1 September 2026 is a Tuesday, 1 October a Thursday, 1 November a Sunday; Monday 5 October
-- 2026 is counted as a public holiday where a case says "1 public holiday".

`9 Sep 2026`  MEANS DATE_FROM_DMY 9 9 2026
`10 Sep 2026` MEANS DATE_FROM_DMY 10 9 2026
`2 Sep 2026`  MEANS DATE_FROM_DMY 2 9 2026
`3 Aug 2026`  MEANS DATE_FROM_DMY 3 8 2026
`2 Nov 2026`  MEANS DATE_FROM_DMY 2 11 2026
`1 Oct 2026`  MEANS DATE_FROM_DMY 1 10 2026
`19 Oct 2026` MEANS DATE_FROM_DMY 19 10 2026
`3 Mar 2027`  MEANS DATE_FROM_DMY 3 3 2027
`1 Jul 2027`  MEANS DATE_FROM_DMY 1 7 2027
`3 Sep 2026`  MEANS DATE_FROM_DMY 3 9 2026
`5 Oct 2026`  MEANS DATE_FROM_DMY 5 10 2026

-- =====================================================================================================================
-- Deciding the application. Mia's application, made on Wednesday 9 September 2026 (see the worker cases).
-- =====================================================================================================================

-- s 134(2): 20 business days after Wed 9 Sep, skipping Mon 5 Oct: Thu 8 Oct 2026. Mirror: the worker's answer agrees.
#ASSERT `By when must we decide this application` `9 Sep 2026` 1 EQUALS DATE_FROM_DMY 8 10 2026
#ASSERT (`By when must we decide this application` `9 Sep 2026` 1) EQUALS (`By when must the insurer decide my application` `9 Sep 2026` 1)
-- s 134(6): 5 more business days: Thu 15 Oct 2026. Mirror.
#ASSERT `By when must we tell the claimant why we have not decided` `9 Sep 2026` 1 EQUALS DATE_FROM_DMY 15 10 2026
#ASSERT (`By when must we tell the claimant why we have not decided` `9 Sep 2026` 1) EQUALS (`By when must the insurer tell me why it has not decided` `9 Sep 2026` 1)

-- s 131: entitlement 2 Sep 2026, lodged 3 Mar 2027 (one day past 2 Mar 2027). Mirror for each ground.
#ASSERT `Must or may we waive the time limit` `2 Sep 2026` `3 Mar 2027` TRUE FALSE FALSE EQUALS `late, but the insurer must waive the limit (s 131(4))`
#ASSERT `Must or may we waive the time limit` `2 Sep 2026` `3 Mar 2027` FALSE TRUE FALSE EQUALS `late, but the insurer may waive the limit (s 131(5))`
#ASSERT `Must or may we waive the time limit` `2 Sep 2026` `3 Mar 2027` FALSE FALSE TRUE EQUALS `late, but the insurer may waive the limit (s 131(6))`
#ASSERT `Must or may we waive the time limit` `2 Sep 2026` `3 Mar 2027` FALSE FALSE FALSE EQUALS `late: the application is not valid and enforceable (s 131(1))`
#ASSERT (`Must or may we waive the time limit` `2 Sep 2026` `3 Mar 2027` FALSE TRUE FALSE) EQUALS (`Is my application in time` `2 Sep 2026` `3 Mar 2027` FALSE TRUE FALSE)
#ASSERT (`Must or may we waive the time limit` `2 Sep 2026` `9 Sep 2026` FALSE FALSE FALSE) EQUALS (`Is my application in time` `2 Sep 2026` `9 Sep 2026` FALSE FALSE FALSE)

-- ss 131(2), 141(2): Ben, assessed and stopped work Mon 3 Aug 2026, lodged Mon 2 Nov 2026, 1 public holiday: liable
-- from Fri 2 Oct 2026 (20 business days before 2 Nov). Mirror.
#ASSERT `From what day are we liable for weekly compensation` `3 Aug 2026` `2 Nov 2026` `3 Aug 2026` `3 Aug 2026` 1 FALSE FALSE EQUALS DATE_FROM_DMY 2 10 2026
#ASSERT (`From what day are we liable for weekly compensation` `3 Aug 2026` `2 Nov 2026` `3 Aug 2026` `3 Aug 2026` 1 FALSE FALSE) EQUALS (`From what day will I be paid weekly compensation` `3 Aug 2026` `2 Nov 2026` `3 Aug 2026` `3 Aug 2026` 1 FALSE)
-- s 131(3): had the injury resulted in death, s 131(2) would not limit liability: from 4 Aug 2026 (s 141(2)(a)).
#ASSERT `From what day are we liable for weekly compensation` `3 Aug 2026` `2 Nov 2026` `3 Aug 2026` `3 Aug 2026` 1 TRUE FALSE EQUALS DATE_FROM_DMY 4 8 2026

-- s 146B(4)-(5): full time, 55% of 1,994.50 = 1,096.975; 19 of 38 hours, half that, 548.4875. Mirror.
#ASSERT `What basic weekly payment must we pay` `9 Sep 2026` 0 TRUE 0 38 EQUALS `we owe, in dollars` 1096.975
#ASSERT `What basic weekly payment must we pay` `1 Oct 2026` 0 FALSE 19 38 EQUALS `we owe, in dollars` 548.4875
#ASSERT `What basic weekly payment will I get while the insurer waits for information` `1 Oct 2026` 0 FALSE 19 38 EQUALS `the amount, in dollars, is` 548.4875
#ASSERT `What basic weekly payment must we pay` `1 Jul 2027` 0 TRUE 0 38 EQUALS `not covered: no deposited QOTE for that financial year (only 2026-27 is deposited)`
-- s 146B(3): allowed on Thu 10 Sep 2026; 5 business days after: Fri 11, Mon 14, Tue 15, Wed 16, Thu 17 Sep. The
-- excess period ends 17 Sep: 17 Sep. It ends Mon 21 Sep: 21 Sep (the later). It ends Sat 12 Sep: 17 Sep.
#ASSERT `By when must we start the basic weekly payment` `10 Sep 2026` (DATE_FROM_DMY 17 9 2026) 0 EQUALS DATE_FROM_DMY 17 9 2026
#ASSERT `By when must we start the basic weekly payment` `10 Sep 2026` (DATE_FROM_DMY 21 9 2026) 0 EQUALS DATE_FROM_DMY 21 9 2026
#ASSERT `By when must we start the basic weekly payment` `10 Sep 2026` (DATE_FROM_DMY 12 9 2026) 0 EQUALS DATE_FROM_DMY 17 9 2026

-- =====================================================================================================================
-- Paying weekly compensation (the worker cases' Mia, Tom, Lee and Ana).
-- =====================================================================================================================

-- Mia, s 150, week 1 (3 Sep 2026 is in it): the greater of 1,232.50 and 1,180: 1,232.50. Mirror.
#ASSERT `What weekly compensation do we owe` `3 Sep 2026` 0 `employment governed by an industrial instrument (s 150)` 1450 1180 FALSE FALSE 0 0 FALSE 575 1 1450 0 EQUALS `we owe, in dollars` 1232.50
#ASSERT `How much will I get for a week I cannot work at all` `3 Sep 2026` 0 `employment governed by an industrial instrument (s 150)` 1450 1180 FALSE FALSE 0 0 FALSE 575 1 1450 0 EQUALS `the amount, in dollars, is` 1232.50
-- Tom, s 151, week 110 (from Monday 5 Oct 2026) without a DPI over 15% shown: the single pension rate, 575. Mirror.
#ASSERT `What weekly compensation do we owe` `5 Oct 2026` 0 `employment not governed by an industrial instrument (s 151)` 2400 0 FALSE FALSE 0 0 FALSE 575 110 2400 0 EQUALS `we owe, in dollars` 575
#ASSERT `How much will I get for a week I cannot work at all` `5 Oct 2026` 0 `employment not governed by an industrial instrument (s 151)` 2400 0 FALSE FALSE 0 0 FALSE 575 110 2400 0 EQUALS `the amount, in dollars, is` 575
-- Ana, s 151 with s 153, casual, NWE 1,000: capped at NWE, 1,000.
#ASSERT `What weekly compensation do we owe` `1 Oct 2026` 0 `employment not governed by an industrial instrument (s 151)` 1000 0 TRUE FALSE 0 0 FALSE 575 1 1000 0 EQUALS `we owe, in dollars` 1000
-- s 152, a public service officer: NWE 1,800, contract amount 1,700: week 1, the greater of 1,530 and 1,700 = 1,700;
-- week 40, the greater of 1,350 and 1,396.15 = 1,396.15, under the 1,700 cap.
#ASSERT `What weekly compensation do we owe` `1 Oct 2026` 0 `a contract worker under s 152 (public service, government entity, university, electricity industry salaried, health service)` 1800 1700 FALSE FALSE 0 0 FALSE 575 1 1800 0 EQUALS `we owe, in dollars` 1700
#ASSERT `What weekly compensation do we owe` `1 Oct 2026` 0 `a contract worker under s 152 (public service, government entity, university, electricity industry salaried, health service)` 1800 1700 FALSE FALSE 0 0 FALSE 575 40 1800 0 EQUALS `we owe, in dollars` 1396.15
-- Lee (the worker cases), week 261 (28 Sep to 4 Oct 2026): nothing (past 5 years). Mirror.
#ASSERT `What weekly compensation do we owe` `1 Oct 2026` 0 `employment not governed by an industrial instrument (s 151)` 2400 0 FALSE FALSE 0 0 TRUE 575 261 2400 0 EQUALS `we owe nothing: past the first 5 years of the incapacity (ss 150-152, 144A)`
#ASSERT `How much will I get for a week I cannot work at all` `1 Oct 2026` 0 `employment not governed by an industrial instrument (s 151)` 2400 0 FALSE FALSE 0 0 TRUE 575 261 2400 0 EQUALS `none: past the first 5 years of the incapacity (ss 150-152, 144A)`

-- s 174: 217,799.40 - 100,000 = 117,799.40. Mirror.
#ASSERT `What is the most we may pay to redeem weekly payments` `1 Oct 2026` 0 100000 EQUALS `we owe, in dollars` 117799.40
#ASSERT `What is the most my redemption payment can be` `1 Oct 2026` 0 100000 EQUALS `the amount, in dollars, is` 117799.40
-- s 170: paid 5,000, entitled 4,200: 800. Mirror.
#ASSERT `How much overpaid compensation may we recover` 5000 4200 EQUALS 800
#ASSERT (`How much overpaid compensation may we recover` 5000 4200) EQUALS (`How much of an overpayment can the insurer recover from me` 5000 4200)

-- =====================================================================================================================
-- Permanent impairment (Mia: DPI 10%, assessment received Thu 1 Oct 2026, notice given Mon 19 Oct 2026).
-- =====================================================================================================================

-- s 185: Fri 16 Oct 2026 (10 business days, skipping Mon 5 Oct). Mirror.
#ASSERT `By when must we give the notice of assessment` `1 Oct 2026` 1 EQUALS DATE_FROM_DMY 16 10 2026
#ASSERT (`By when must we give the notice of assessment` `1 Oct 2026` 1) EQUALS (`By when must the insurer give me my notice of assessment` `1 Oct 2026` 1)
-- s 180, Regulation s 117: 431,115 x 10% = 43,111.50. Mirror.
#ASSERT `What lump sum must we offer` `19 Oct 2026` 0 10 0 0 EQUALS `we owe, in dollars` 43111.50
#ASSERT `What lump sum does my DPI give me` `19 Oct 2026` 0 10 0 0 EQUALS `the amount, in dollars, is` 43111.50
-- DPI 25%: 431,115 x 25% = 107,778.75.
#ASSERT `What lump sum must we offer` `19 Oct 2026` 0 25 0 0 EQUALS `we owe, in dollars` 107778.75
-- s 186(3): a request to reassess received Mon 2 Nov 2026: 10 business days: 3-6 Nov (1-4), 9-13 (5-9), Mon 16 Nov
-- 2026 (10).
#ASSERT `By when must we decide whether to have the injury assessed again` `2 Nov 2026` 0 EQUALS DATE_FROM_DMY 16 11 2026
-- s 189(2): DPI 10% or none: the sections and the advice; DPI 20% or 25%: not.
#ASSERT `Must we give the worker the election sections with the notice` 10 EQUALS TRUE
#ASSERT `Must we give the worker the election sections with the notice` 0 EQUALS TRUE
#ASSERT `Must we give the worker the election sections with the notice` 20 EQUALS FALSE
#ASSERT `Must we give the worker the election sections with the notice` 25 EQUALS FALSE

-- =====================================================================================================================
-- Rehabilitation. Mirrors of the worker cases.
-- =====================================================================================================================

#ASSERT `Must we refer the worker to a rehabilitation program` TRUE FALSE FALSE FALSE EQUALS TRUE
#ASSERT `Must we refer the worker to a rehabilitation program` FALSE TRUE TRUE FALSE EQUALS FALSE
#ASSERT (`Must we refer the worker to a rehabilitation program` FALSE TRUE FALSE FALSE) EQUALS (`Must the insurer refer me to a rehabilitation program` FALSE TRUE FALSE FALSE)
#ASSERT `May we suspend the worker's compensation for not taking part in rehabilitation` TRUE FALSE EQUALS TRUE
#ASSERT (`May we suspend the worker's compensation for not taking part in rehabilitation` TRUE TRUE) EQUALS (`Can the insurer suspend my compensation for not taking part in rehabilitation` TRUE TRUE)

-- =====================================================================================================================
-- Death. Mirrors of the worker cases (the insurer gives the day of death; here 1 October 2026).
-- =====================================================================================================================

-- Totally dependent husband, two children (4 and 9): 807,515 + 21,605 + 2 x 43,165 = 915,450. Mirror.
#ASSERT `What lump sum must we pay for the worker's death` `1 Oct 2026` 0 TRUE TRUE TRUE 1 2 0 TRUE FALSE EQUALS `we owe, in dollars` 915450
#ASSERT `What lump sum would be paid for my death` `1 Oct 2026` 0 TRUE TRUE TRUE 1 2 0 TRUE FALSE EQUALS `the amount, in dollars, is` 915450
-- s 201: partial dependants, the insurer considers $50,000 reasonable: the 15% floor, 121,127.25.
#ASSERT `What lump sum must we pay for the worker's death` `1 Oct 2026` 0 FALSE TRUE FALSE 0 0 50000 TRUE FALSE EQUALS `we owe, in dollars` 121127.25
-- s 201A: 80,751.50 to the estate.
#ASSERT `What lump sum must we pay for the worker's death` `1 Oct 2026` 0 FALSE FALSE FALSE 0 0 0 TRUE FALSE EQUALS `we owe, in dollars` 80751.50
-- s 194(2).
#ASSERT `What lump sum must we pay for the worker's death` `1 Oct 2026` 0 TRUE TRUE TRUE 1 2 0 TRUE TRUE EQUALS `we owe nothing under part 11: a terminal latent onset injury already compensated (s 194(2))`
-- A death on 1 July 2027: no deposited QOTE.
#ASSERT `What lump sum must we pay for the worker's death` `1 Jul 2027` 0 TRUE TRUE TRUE 1 2 0 TRUE FALSE EQUALS `not covered: no deposited QOTE for that financial year (only 2026-27 is deposited)`
