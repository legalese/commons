IMPORT prelude
IMPORT daydate
IMPORT `cmvl-rules`

-- Independent tests, from independent-expectations.md (written before reading the rules).
-- Field order: against Cth/authority, owned or leased, uninsured,
--              registered or licensed at all relevant times, occurred on, in Australia.

§ `Independent tests`

GIVEN agin IS A BOOLEAN, owned IS A BOOLEAN, unins IS A BOOLEAN, reg IS A BOOLEAN, d IS A DATE, inAus IS A BOOLEAN
GIVETH A `Vehicle claim`
mk agin owned unins reg d inAus MEANS `Vehicle claim` OF agin, owned, unins, reg, d, inAus

GIVEN c IS A `Vehicle claim`
GIVETH A BOOLEAN
pres c MEANS (`the vehicle claim position for` c)'s `the driver is presumed the Commonwealth's agent`

GIVEN c IS A `Vehicle claim`
GIVETH A BOOLEAN
jury c MEANS (`the vehicle claim position for` c)'s `jury decided as for an insured vehicle`

-- 1: owned, uninsured, unregistered, Sydney 2020
#ASSERT pres (mk TRUE TRUE TRUE FALSE (Date 15 3 2020) TRUE) EQUALS TRUE
#ASSERT jury (mk TRUE TRUE TRUE FALSE (Date 15 3 2020) TRUE) EQUALS TRUE
-- 2/3: registered or licensed at all relevant times: s 5(1A) excludes s 5 but not s 6
#ASSERT pres (mk TRUE TRUE TRUE TRUE (Date 15 3 2020) TRUE) EQUALS FALSE
#ASSERT jury (mk TRUE TRUE TRUE TRUE (Date 15 3 2020) TRUE) EQUALS TRUE
-- 4: registration lapsed part-way, so not "at all relevant times"
#ASSERT pres (mk TRUE TRUE TRUE FALSE (Date 1 7 2021) TRUE) EQUALS TRUE
-- 5: insured
#ASSERT pres (mk TRUE TRUE FALSE FALSE (Date 15 3 2020) TRUE) EQUALS FALSE
#ASSERT jury (mk TRUE TRUE FALSE FALSE (Date 15 3 2020) TRUE) EQUALS FALSE
-- 6: leased to an authority (same inputs as owned)
#ASSERT pres (mk TRUE TRUE TRUE FALSE (Date 2 2 2010) TRUE) EQUALS TRUE
-- 7: not owned or leased; s 6 still applies
#ASSERT pres (mk TRUE FALSE TRUE FALSE (Date 15 3 2020) TRUE) EQUALS FALSE
#ASSERT jury (mk TRUE FALSE TRUE FALSE (Date 15 3 2020) TRUE) EQUALS TRUE
-- 8: outside Australia
#ASSERT pres (mk TRUE TRUE TRUE FALSE (Date 15 3 2020) FALSE) EQUALS FALSE
#ASSERT jury (mk TRUE TRUE TRUE FALSE (Date 15 3 2020) FALSE) EQUALS FALSE
-- 9: 1 Jan 1959, before commencement, after 8 Sept 1958
#ASSERT pres (mk TRUE TRUE TRUE FALSE (Date 1 1 1959) TRUE) EQUALS TRUE
-- 10: 8 Sept 1958 exactly
#ASSERT pres (mk TRUE TRUE TRUE FALSE (Date 8 9 1958) TRUE) EQUALS FALSE
-- 11: 9 Sept 1958
#ASSERT pres (mk TRUE TRUE TRUE FALSE (Date 9 9 1958) TRUE) EQUALS TRUE
-- extra: long before 1958
#ASSERT pres (mk TRUE TRUE TRUE FALSE (Date 1 1 1950) TRUE) EQUALS FALSE
-- 13: claim against the Northern Territory: not a Commonwealth authority
#ASSERT pres (mk FALSE TRUE TRUE FALSE (Date 15 3 2020) TRUE) EQUALS FALSE
#ASSERT jury (mk FALSE TRUE TRUE FALSE (Date 15 3 2020) TRUE) EQUALS FALSE
-- 12 (contribution claim) and 14 (federal court) cannot be expressed: no inputs for them.
