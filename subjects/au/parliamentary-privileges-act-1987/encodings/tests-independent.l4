IMPORT prelude
IMPORT daydate
IMPORT `pp-rules`

-- Independent tests: Parliamentary Privileges Act 1987. Expected values from independent-expectations.md,
-- written from the source text before reading the L4. Baseline: a natural person, improper interference,
-- no ss 12-13 conduct, no role, asked about 10 March 2025, sitting day 10 March 2025.

-- 1a. natural person, improper interference: House may punish (s 4)
#ASSERT (`the privileges position for` (`Privileges case` OF `a natural person`, TRUE, FALSE, FALSE, `none of these`, FALSE, `none of these`, (Date 10 3 2025), (LIST (Date 10 3 2025))))'s `a House may punish my conduct` EQUALS TRUE

-- 1b. natural person: max 6 months (s 7(1))
#ASSERT (`the privileges position for` (`Privileges case` OF `a natural person`, TRUE, FALSE, FALSE, `none of these`, FALSE, `none of these`, (Date 10 3 2025), (LIST (Date 10 3 2025))))'s `most imprisonment a House may impose, in months` EQUALS 6

-- 1c. natural person: max fine $5,000 (s 7(5)(a))
#ASSERT (`the privileges position for` (`Privileges case` OF `a natural person`, TRUE, FALSE, FALSE, `none of these`, FALSE, `none of these`, (Date 10 3 2025), (LIST (Date 10 3 2025))))'s `most fine a House may impose, in dollars` EQUALS 5000

-- 2a. corporation, improper interference: House may punish
#ASSERT (`the privileges position for` (`Privileges case` OF `a corporation`, TRUE, FALSE, FALSE, `none of these`, FALSE, `none of these`, (Date 10 3 2025), (LIST (Date 10 3 2025))))'s `a House may punish my conduct` EQUALS TRUE

-- 2b. corporation: max fine $25,000 (s 7(5)(b))
#ASSERT (`the privileges position for` (`Privileges case` OF `a corporation`, TRUE, FALSE, FALSE, `none of these`, FALSE, `none of these`, (Date 10 3 2025), (LIST (Date 10 3 2025))))'s `most fine a House may impose, in dollars` EQUALS 25000

-- 3a. no improper interference: cannot punish (s 4)
#ASSERT (`the privileges position for` (`Privileges case` OF `a natural person`, FALSE, FALSE, FALSE, `none of these`, FALSE, `none of these`, (Date 10 3 2025), (LIST (Date 10 3 2025))))'s `a House may punish my conduct` EQUALS FALSE

-- 3b. no improper interference: fine 0
#ASSERT (`the privileges position for` (`Privileges case` OF `a natural person`, FALSE, FALSE, FALSE, `none of these`, FALSE, `none of these`, (Date 10 3 2025), (LIST (Date 10 3 2025))))'s `most fine a House may impose, in dollars` EQUALS 0

-- 4. only defamatory, outside presence: cannot punish (s 6(1))
#ASSERT (`the privileges position for` (`Privileges case` OF `a natural person`, TRUE, TRUE, FALSE, `none of these`, FALSE, `none of these`, (Date 10 3 2025), (LIST (Date 10 3 2025))))'s `a House may punish my conduct` EQUALS FALSE

-- 5. only defamatory, in presence of House: may punish (s 6(2))
#ASSERT (`the privileges position for` (`Privileges case` OF `a natural person`, TRUE, TRUE, TRUE, `none of these`, FALSE, `none of these`, (Date 10 3 2025), (LIST (Date 10 3 2025))))'s `a House may punish my conduct` EQUALS TRUE

-- 6. interference not merely defamatory: may punish
#ASSERT (`the privileges position for` (`Privileges case` OF `a natural person`, TRUE, FALSE, FALSE, `none of these`, FALSE, `none of these`, (Date 10 3 2025), (LIST (Date 10 3 2025))))'s `a House may punish my conduct` EQUALS TRUE

-- 7a. natural person intimidates witness: offence (s 12(1))
#ASSERT (`the privileges position for` (`Privileges case` OF `a natural person`, TRUE, FALSE, FALSE, `improperly influencing a witness's evidence, or inducing them not to give it`, FALSE, `none of these`, (Date 10 3 2025), (LIST (Date 10 3 2025))))'s `I commit an offence against this Act` EQUALS TRUE

-- 7b. natural person s 12(1): 6 months
#ASSERT (`the privileges position for` (`Privileges case` OF `a natural person`, TRUE, FALSE, FALSE, `improperly influencing a witness's evidence, or inducing them not to give it`, FALSE, `none of these`, (Date 10 3 2025), (LIST (Date 10 3 2025))))'s `most imprisonment for that offence, in months` EQUALS 6

-- 7c. natural person s 12(1): 50 penalty units
#ASSERT (`the privileges position for` (`Privileges case` OF `a natural person`, TRUE, FALSE, FALSE, `improperly influencing a witness's evidence, or inducing them not to give it`, FALSE, `none of these`, (Date 10 3 2025), (LIST (Date 10 3 2025))))'s `most penalty units for that offence` EQUALS 50

-- 8a. corporation s 12(1): offence
#ASSERT (`the privileges position for` (`Privileges case` OF `a corporation`, TRUE, FALSE, FALSE, `improperly influencing a witness's evidence, or inducing them not to give it`, FALSE, `none of these`, (Date 10 3 2025), (LIST (Date 10 3 2025))))'s `I commit an offence against this Act` EQUALS TRUE

-- 8b. corporation s 12(1): 250 penalty units
#ASSERT (`the privileges position for` (`Privileges case` OF `a corporation`, TRUE, FALSE, FALSE, `improperly influencing a witness's evidence, or inducing them not to give it`, FALSE, `none of these`, (Date 10 3 2025), (LIST (Date 10 3 2025))))'s `most penalty units for that offence` EQUALS 250

-- 9a. natural person injures on account of evidence: offence (s 12(2))
#ASSERT (`the privileges position for` (`Privileges case` OF `a natural person`, TRUE, FALSE, FALSE, `penalising or injuring a person on account of evidence`, FALSE, `none of these`, (Date 10 3 2025), (LIST (Date 10 3 2025))))'s `I commit an offence against this Act` EQUALS TRUE

-- 9b. s 12(2): 50 penalty units
#ASSERT (`the privileges position for` (`Privileges case` OF `a natural person`, TRUE, FALSE, FALSE, `penalising or injuring a person on account of evidence`, FALSE, `none of these`, (Date 10 3 2025), (LIST (Date 10 3 2025))))'s `most penalty units for that offence` EQUALS 50

-- 10a. unauthorised in camera disclosure, not published: offence (s 13)
#ASSERT (`the privileges position for` (`Privileges case` OF `a natural person`, TRUE, FALSE, FALSE, `publishing or disclosing in camera evidence without authority`, FALSE, `none of these`, (Date 10 3 2025), (LIST (Date 10 3 2025))))'s `I commit an offence against this Act` EQUALS TRUE

-- 10b. s 13: 6 months
#ASSERT (`the privileges position for` (`Privileges case` OF `a natural person`, TRUE, FALSE, FALSE, `publishing or disclosing in camera evidence without authority`, FALSE, `none of these`, (Date 10 3 2025), (LIST (Date 10 3 2025))))'s `most imprisonment for that offence, in months` EQUALS 6

-- 11. in camera evidence already published by a House: no offence (s 13)
