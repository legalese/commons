-- 13a. no ss 12-13 conduct: no offence
#ASSERT (`the privileges position for` (`Privileges case` OF `a natural person`, TRUE, FALSE, FALSE, `none of these`, FALSE, `none of these`, (Date 10 3 2025), (LIST (Date 10 3 2025))))'s `I commit an offence against this Act` EQUALS FALSE

-- 13b. no ss 12-13 conduct: 0 penalty units
#ASSERT (`the privileges position for` (`Privileges case` OF `a natural person`, TRUE, FALSE, FALSE, `none of these`, FALSE, `none of these`, (Date 10 3 2025), (LIST (Date 10 3 2025))))'s `most penalty units for that offence` EQUALS 0

-- 14. member, on sitting day: immune (s 14(1)(c))
#ASSERT (`the privileges position for` (`Privileges case` OF `a natural person`, TRUE, FALSE, FALSE, `none of these`, FALSE, `a member of a House`, (Date 10 3 2025), (LIST (Date 10 3 2025))))'s `I am immune from court attendance and civil arrest that day` EQUALS TRUE

