IMPORT prelude
IMPORT `taa-whistleblower`

-- Taxation Administration Act 1953 (Cth) Part IVD -- worked cases for the tax whistleblower's questions
-- (taa-whistleblower.l4). Every expected value was worked by hand from the deposited text of the Act (C2026C00393) and
-- the Regulations (F2026C00849); none was copied from the encoding's output. Each assertion is a claim about the
-- ENCODING on stated facts, not about the law. The facts are illustrative.
-- BASELINE ENCODING. Not for public use as advice. See NOTES.md.

§ `cases`

§§ `s 14ZZU -- eligible whistleblower`

-- Each head (a) to (g), now or in the past; no connection; not an entity.
#ASSERT `Am I an eligible whistleblower` TRUE `an officer of it` EQUALS TRUE
#ASSERT `Am I an eligible whistleblower` TRUE `an employee of it` EQUALS TRUE
#ASSERT `Am I an eligible whistleblower` TRUE `I supply services or goods to it, paid or unpaid` EQUALS TRUE
#ASSERT `Am I an eligible whistleblower` TRUE `an employee of someone who supplies services or goods to it, paid or unpaid` EQUALS TRUE
#ASSERT `Am I an eligible whistleblower` TRUE `an associate of it` EQUALS TRUE
#ASSERT `Am I an eligible whistleblower` TRUE `the spouse or child of a person in one of those groups` EQUALS TRUE
#ASSERT `Am I an eligible whistleblower` TRUE `a dependant of a person in one of those groups, or of their spouse` EQUALS TRUE
#ASSERT `Am I an eligible whistleblower` TRUE `no such connection` EQUALS FALSE
#ASSERT `Am I an eligible whistleblower` FALSE `an employee of it` EQUALS FALSE

§§ `s 14ZZV and Regulations s 13A -- eligible recipient`

`co` MEANS `a body corporate, such as a company`
`tr` MEANS `a trust`
`pa` MEANS `a partnership`
`other` MEANS `another kind of entity`

-- (1): for every kind of entity, including the Inspector-General (Regulations s 13A).
#ASSERT `Is the person I told an eligible recipient` `other` `an auditor of the entity, or a member of an audit team auditing it` EQUALS TRUE
#ASSERT `Is the person I told an eligible recipient` `tr` `a registered tax agent or BAS agent who provides it tax agent or BAS services` EQUALS TRUE
#ASSERT `Is the person I told an eligible recipient` `pa` `a person the entity has authorised to receive whistleblower disclosures` EQUALS TRUE
#ASSERT `Is the person I told an eligible recipient` `other` `the Inspector-General of Taxation` EQUALS TRUE
-- (2): only for a body corporate.
#ASSERT `Is the person I told an eligible recipient` `co` `a director, secretary or senior manager of the company` EQUALS TRUE
#ASSERT `Is the person I told an eligible recipient` `co` `another employee or officer of the company whose functions or duties relate to its tax affairs` EQUALS TRUE
#ASSERT `Is the person I told an eligible recipient` `tr` `a director, secretary or senior manager of the company` EQUALS FALSE
-- (3): only for a trust.
#ASSERT `Is the person I told an eligible recipient` `tr` `a trustee of the trust` EQUALS TRUE
#ASSERT `Is the person I told an eligible recipient` `tr` `a person a trustee has authorised to receive whistleblower disclosures` EQUALS TRUE
#ASSERT `Is the person I told an eligible recipient` `co` `a trustee of the trust` EQUALS FALSE
-- (4): only for a partnership.
#ASSERT `Is the person I told an eligible recipient` `pa` `a partner in the partnership` EQUALS TRUE
#ASSERT `Is the person I told an eligible recipient` `pa` `a person a partner has authorised to receive whistleblower disclosures` EQUALS TRUE
#ASSERT `Is the person I told an eligible recipient` `other` `a partner in the partnership` EQUALS FALSE
-- No head holds.
#ASSERT `Is the person I told an eligible recipient` `co` `someone else` EQUALS FALSE

§§ `s 14ZZT -- qualifying disclosure`

`Q1` MEANS `it qualifies: a disclosure to the Commissioner (s 14ZZT(1))`
`Q1A` MEANS `it qualifies: a disclosure to assist the Tax Practitioners Board (s 14ZZT(1A))`
`Q2` MEANS `it qualifies: a disclosure to an eligible recipient (s 14ZZT(2))`
`Q3` MEANS `it qualifies: a disclosure to a lawyer (s 14ZZT(3))`
`Q3B` MEANS `it qualifies: a disclosure to a doctor or psychologist (s 14ZZT(3B))`
`no` MEANS `it does not qualify for protection on these facts`
`ATO` MEANS `the Commissioner of Taxation`
`TPB` MEANS `the Tax Practitioners Board`
`ER` MEANS `an eligible recipient for the entity`

-- Argument order: eligible whistleblower; whom; helps Commissioner; helps TPB; reasonable grounds; helps recipient.
-- (1): to the Commissioner, thinking it may help; no reasonable grounds needed.
#ASSERT `Does my disclosure qualify for protection` TRUE `ATO` TRUE FALSE FALSE FALSE EQUALS `Q1`
-- (1) and (1A) both met: (1) is named.
#ASSERT `Does my disclosure qualify for protection` TRUE `ATO` TRUE TRUE FALSE FALSE EQUALS `Q1`
-- (1A) through the Commissioner.
#ASSERT `Does my disclosure qualify for protection` TRUE `ATO` FALSE TRUE FALSE FALSE EQUALS `Q1A`
-- To the Commissioner, thinking it helps no one.
#ASSERT `Does my disclosure qualify for protection` TRUE `ATO` FALSE FALSE TRUE TRUE EQUALS `no`
-- Not an eligible whistleblower.
#ASSERT `Does my disclosure qualify for protection` FALSE `ATO` TRUE TRUE TRUE TRUE EQUALS `no`
-- (1A) to the Board.
#ASSERT `Does my disclosure qualify for protection` TRUE `TPB` FALSE TRUE FALSE FALSE EQUALS `Q1A`
-- To the Board, thinking only that it may help the Commissioner: (1) needs the Commissioner as recipient.
#ASSERT `Does my disclosure qualify for protection` TRUE `TPB` TRUE FALSE FALSE FALSE EQUALS `no`
#ASSERT `Does my disclosure qualify for protection` FALSE `TPB` FALSE TRUE FALSE FALSE EQUALS `no`
-- (2): to an eligible recipient, with reasonable grounds and thinking it may help the recipient.
#ASSERT `Does my disclosure qualify for protection` TRUE `ER` FALSE FALSE TRUE TRUE EQUALS `Q2`
#ASSERT `Does my disclosure qualify for protection` TRUE `ER` TRUE TRUE FALSE TRUE EQUALS `no`
#ASSERT `Does my disclosure qualify for protection` TRUE `ER` FALSE FALSE TRUE FALSE EQUALS `no`
#ASSERT `Does my disclosure qualify for protection` FALSE `ER` FALSE FALSE TRUE TRUE EQUALS `no`
-- (3) and (3B): no other condition, not even being an eligible whistleblower.
#ASSERT `Does my disclosure qualify for protection` FALSE `a legal practitioner, for advice or representation about these protections` FALSE FALSE FALSE FALSE EQUALS `Q3`
#ASSERT `Does my disclosure qualify for protection` FALSE `a medical practitioner or psychologist, for care, treatment or counselling` FALSE FALSE FALSE FALSE EQUALS `Q3B`
-- (3A): no entity is prescribed in the deposited Regulations.
#ASSERT `Does my disclosure qualify for protection` TRUE `a body I am a member of, for help about these protections` TRUE TRUE TRUE TRUE EQUALS `no`
-- Someone else, such as a journalist: Part IVD has no public interest route.
#ASSERT `Does my disclosure qualify for protection` TRUE `someone else` TRUE TRUE TRUE TRUE EQUALS `no`

§§ `s 14ZZX -- immunity and evidence`

#ASSERT `Am I protected from liability for my disclosure` `Q1` EQUALS JUST TRUE
#ASSERT `Am I protected from liability for my disclosure` `Q2` EQUALS JUST TRUE
#ASSERT `Am I protected from liability for my disclosure` `Q3B` EQUALS JUST TRUE
#ASSERT `Am I protected from liability for my disclosure` `no` EQUALS NOTHING

-- (1)(c): only disclosures to the Commissioner or the Board; never in falsity proceedings.
#ASSERT `Is my disclosure kept out of evidence against me` `Q1` FALSE EQUALS JUST TRUE
#ASSERT `Is my disclosure kept out of evidence against me` `Q1A` FALSE EQUALS JUST TRUE
#ASSERT `Is my disclosure kept out of evidence against me` `Q1` TRUE EQUALS JUST FALSE
#ASSERT `Is my disclosure kept out of evidence against me` `Q2` FALSE EQUALS JUST FALSE
#ASSERT `Is my disclosure kept out of evidence against me` `Q3` FALSE EQUALS JUST FALSE
#ASSERT `Is my disclosure kept out of evidence against me` `no` FALSE EQUALS NOTHING

§§ `s 14ZZXA -- a claim for protection in court`

#ASSERT `Who must prove my claim to protection` TRUE TRUE EQUALS `the other side must now prove my claim is not made out; the claim is heard separately and the case against me is adjourned until then`
#ASSERT `Who must prove my claim to protection` TRUE FALSE EQUALS `I must first point to evidence suggesting a reasonable possibility that my claim is made out; the claim is heard separately and the case against me is adjourned until then`
#ASSERT `Who must prove my claim to protection` FALSE TRUE EQUALS `s 14ZZXA does not apply: these are not court proceedings brought against me`

§§ `s 14ZZZB -- identity before courts and tribunals`

#ASSERT `Am I shielded from revealing my identity to a court or tribunal` `Q2` FALSE FALSE EQUALS JUST TRUE
#ASSERT `Am I shielded from revealing my identity to a court or tribunal` `Q2` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Am I shielded from revealing my identity to a court or tribunal` `Q1` FALSE TRUE EQUALS JUST FALSE
#ASSERT `Am I shielded from revealing my identity to a court or tribunal` `no` FALSE FALSE EQUALS NOTHING

§§ `s 14ZZW -- the regulative rule and the offence of revealing my identity`

-- The trace helper on its own: a permitted act is no breach; an act not permitted is.
#ASSERT `revealing me broke the duty of confidentiality` TRUE EQUALS FALSE
#ASSERT `revealing me broke the duty of confidentiality` FALSE EQUALS TRUE

`ID` MEANS `my identity`
`clue` MEANS `information likely to lead to my identification`
`anyone` MEANS `anyone else`

-- Argument order: qualifies; what; obtained because of the disclosure; to whom; consent; necessary to investigate;
-- all reasonable steps.
-- A manager who learned who I am through my disclosure tells colleagues: an offence.
#ASSERT `Was revealing my identity an offence` TRUE `ID` TRUE `anyone` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Was revealing my identity an offence` TRUE `clue` TRUE `anyone` FALSE FALSE FALSE EQUALS JUST TRUE
-- Each authorised recipient in (2) and Regulations s 13B.
#ASSERT `Was revealing my identity an offence` TRUE `ID` TRUE `the Commissioner` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Was revealing my identity an offence` TRUE `ID` TRUE `a member of the Australian Federal Police` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Was revealing my identity an offence` TRUE `ID` TRUE `a lawyer, for advice or representation about these protections` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Was revealing my identity an offence` TRUE `ID` TRUE `the Inspector-General of Taxation, the Tax Practitioners Board or the ACNC Commissioner` FALSE FALSE FALSE EQUALS JUST FALSE
-- With my consent.
#ASSERT `Was revealing my identity an offence` TRUE `ID` TRUE `anyone` TRUE FALSE FALSE EQUALS JUST FALSE
-- (3): the investigation exception covers identifying information, never the identity itself, and needs both limbs.
#ASSERT `Was revealing my identity an offence` TRUE `clue` TRUE `anyone` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Was revealing my identity an offence` TRUE `ID` TRUE `anyone` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Was revealing my identity an offence` TRUE `clue` TRUE `anyone` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Was revealing my identity an offence` TRUE `clue` TRUE `anyone` FALSE FALSE TRUE EQUALS JUST TRUE
-- Not a qualifying disclosure; nothing identifying; learned otherwise than through the disclosure.
#ASSERT `Was revealing my identity an offence` FALSE `ID` TRUE `anyone` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Was revealing my identity an offence` TRUE `nothing that identifies me` TRUE `anyone` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Was revealing my identity an offence` TRUE `ID` FALSE `anyone` FALSE FALSE FALSE EQUALS JUST FALSE

§§ `s 14ZZY -- victimisation offence`

-- Argument order: detriment caused; belief or suspicion; threat; intent or recklessness as to fear; disclosure the
-- reason or part of it.
#ASSERT `Did they commit the victimisation offence` TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Did they commit the victimisation offence` TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Did they commit the victimisation offence` TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- A threat: no belief needed, only the "because" and the intent or recklessness.
#ASSERT `Did they commit the victimisation offence` FALSE FALSE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Did they commit the victimisation offence` FALSE FALSE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Did they commit the victimisation offence` FALSE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Did they commit the victimisation offence` FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE

§§ `penalties`

`O1` MEANS `revealing a whistleblower's identity (s 14ZZW)`
`O2` MEANS `causing detriment to a whistleblower (s 14ZZY(1))`
`O3` MEANS `threatening a whistleblower (s 14ZZY(2))`

#ASSERT `The longest prison term in months` `O1` EQUALS 6
#ASSERT `The longest prison term in months` `O2` EQUALS 24
#ASSERT `The longest prison term in months` `O3` EQUALS 24
-- 60 x $330 = $19,800; 240 x $330 = $79,200; with an indexed unit of $345, 240 x 345 = $82,800.
#ASSERT `The largest fine in dollars` `O1` 330 EQUALS 19800
#ASSERT `The largest fine in dollars` `O2` 330 EQUALS 79200
#ASSERT `The largest fine in dollars` `O3` 345 EQUALS 82800

§§ `s 14ZZZ -- can the court order a remedy`

`P1` MEANS `the person who harmed or threatened me`
`P2` MEANS `an officer or employee involved in their company's conduct`
`P3` MEANS `a company that had a duty to prevent another person's conduct`

-- Argument order: against whom; harmed or threatened; belief or suspicion; part of the reason; officer involved; duty;
-- failed in duty.
#ASSERT `Can the court order a remedy for the harm I suffered` `P1` TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Can the court order a remedy for the harm I suffered` `P1` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Can the court order a remedy for the harm I suffered` `P1` FALSE TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Can the court order a remedy for the harm I suffered` `P1` TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Can the court order a remedy for the harm I suffered` `P2` TRUE TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Can the court order a remedy for the harm I suffered` `P2` TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Can the court order a remedy for the harm I suffered` `P3` TRUE TRUE TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Can the court order a remedy for the harm I suffered` `P3` TRUE TRUE TRUE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Can the court order a remedy for the harm I suffered` `P3` TRUE TRUE TRUE FALSE FALSE TRUE EQUALS JUST FALSE

#ASSERT `Who must prove what in my compensation claim` TRUE EQUALS `the other side must now prove my claim is not made out`
#ASSERT `Who must prove what in my compensation claim` FALSE EQUALS `I must first point to evidence suggesting a reasonable possibility of the harm or threat (and, against a company with a duty, of that duty)`

§§ `s 14ZZZA -- the orders`

`comp` MEANS `compensation from the person for my loss, damage or injury`
`emp` MEANS `compensation from the person's employer, in part, jointly and severally with the person, or alone`
`inj` MEANS `an injunction to prevent, stop or remedy the effects of the conduct`
`sorry` MEANS `an apology`
`back` MEANS `reinstatement in my position or one at a comparable level`
`exem` MEANS `exemplary damages`
`any` MEANS `any other order the court thinks appropriate`

#ASSERT `What orders can the court make for me` TRUE TRUE TRUE EQUALS LIST `comp`, `emp`, `inj`, `sorry`, `back`, `exem`, `any`
#ASSERT `What orders can the court make for me` TRUE FALSE TRUE EQUALS LIST `comp`, `inj`, `sorry`, `back`, `exem`, `any`
#ASSERT `What orders can the court make for me` TRUE TRUE FALSE EQUALS LIST `comp`, `emp`, `inj`, `sorry`, `exem`, `any`
#ASSERT `What orders can the court make for me` TRUE FALSE FALSE EQUALS LIST `comp`, `inj`, `sorry`, `exem`, `any`
#ASSERT `What orders can the court make for me` FALSE TRUE TRUE EQUALS EMPTY

-- s 14ZZZA(2): dismissal or forced resignation, when compensation is ordered.
#ASSERT `Must the court consider how long I will be out of work` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Must the court consider how long I will be out of work` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Must the court consider how long I will be out of work` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Must the court consider how long I will be out of work` FALSE TRUE TRUE EQUALS NOTHING

§§ `s 14ZZZC -- costs`

#ASSERT `Can I be ordered to pay the other side's costs` FALSE FALSE EQUALS JUST FALSE
#ASSERT `Can I be ordered to pay the other side's costs` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Can I be ordered to pay the other side's costs` FALSE TRUE EQUALS JUST TRUE

§§ `a whole story`

-- An employee of a company tells its tax manager (an eligible recipient under s 14ZZV(2)(b)) of suspected sham invoices,
-- is identified to colleagues by the manager, and is then demoted because of it.
`am I` MEANS `Am I an eligible whistleblower` TRUE `an employee of it`
`is the manager` MEANS `Is the person I told an eligible recipient` `co` `another employee or officer of the company whose functions or duties relate to its tax affairs`
`my route` MEANS `Does my disclosure qualify for protection` `am I` (IF `is the manager` THEN `ER` ELSE `someone else`) FALSE FALSE TRUE TRUE
#ASSERT `my route` EQUALS `Q2`
#ASSERT `Am I protected from liability for my disclosure` `my route` EQUALS JUST TRUE
#ASSERT `Is my disclosure kept out of evidence against me` `my route` FALSE EQUALS JUST FALSE
#ASSERT `Was revealing my identity an offence` (`it qualified` `my route`) `ID` TRUE `anyone` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Can the court order a remedy for the harm I suffered` `P1` TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `What orders can the court make for me` TRUE TRUE FALSE EQUALS LIST `comp`, `emp`, `inj`, `sorry`, `exem`, `any`
