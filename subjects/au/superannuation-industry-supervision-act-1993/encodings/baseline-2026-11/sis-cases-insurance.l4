IMPORT prelude
IMPORT `sis-ins-dates`
IMPORT `sis-insurance`

-- Cases for sis-insurance.l4. Every expected value was worked by hand from the deposited text, with the provision
-- beside each group; none was copied from the encoding's output. The people and figures are hypothetical.

§ `s 52(7)(d) -- pursuing my insurance claim`

-- An APRA-regulated fund; a TPD claim with a reasonable prospect of success: the covenant requires everything
-- reasonable to pursue it.
#ASSERT `Must my fund pursue my insurance claim` TRUE TRUE EQUALS JUST TRUE
-- No reasonable prospect: the "if" fails, so (7)(d) does not require it.
#ASSERT `Must my fund pursue my insurance claim` TRUE FALSE EQUALS JUST FALSE
-- A self managed fund is not a registrable superannuation entity: s 52 is silent.
#ASSERT `Must my fund pursue my insurance claim` FALSE TRUE EQUALS NOTHING
#ASSERT `Must my fund pursue my insurance claim` FALSE FALSE EQUALS NOTHING

§ `s 52(7)(c) -- the cost covenant`

#ASSERT `Does the cost covenant stop my fund offering this insurance` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Does the cost covenant stop my fund offering this insurance` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Does the cost covenant stop my fund offering this insurance` FALSE TRUE EQUALS NOTHING

§ `reg 4.07D -- permitted insured events`

-- Joined 1 July 2014 (the first day the exception no longer covers), no pre-2014 approval.
#ASSERT `Does reg 4.07D stop my fund insuring me against this event` `my death` (`the date` 1 7 2014) FALSE EQUALS JUST FALSE
#ASSERT `Does reg 4.07D stop my fund insuring me against this event` `a terminal medical condition` (`the date` 1 7 2014) FALSE EQUALS JUST FALSE
#ASSERT `Does reg 4.07D stop my fund insuring me against this event` `permanent incapacity` (`the date` 1 7 2014) FALSE EQUALS JUST FALSE
#ASSERT `Does reg 4.07D stop my fund insuring me against this event` `temporary incapacity` (`the date` 1 7 2014) FALSE EQUALS JUST FALSE
-- Trauma cover for a member who joined on 1 July 2014: not consistent with items 102, 102A, 103 or 109.
#ASSERT `Does reg 4.07D stop my fund insuring me against this event` `another event` (`the date` 1 7 2014) FALSE EQUALS JUST TRUE
#ASSERT `Does reg 4.07D stop my fund insuring me against this event` `another event` (`the date` 15 3 2022) FALSE EQUALS JUST TRUE
-- Joined 30 June 2014, the last day before 1 July 2014: the continued provision is outside (2) (reg 4.07D(3)(a)).
#ASSERT `Does reg 4.07D stop my fund insuring me against this event` `another event` (`the date` 30 6 2014) FALSE EQUALS JUST FALSE
-- Under an approval granted before 1 July 2014 under s 62(1)(b)(v) (reg 4.07D(3)(b)).
#ASSERT `Does reg 4.07D stop my fund insuring me against this event` `another event` (`the date` 15 3 2022) TRUE EQUALS JUST FALSE

§ `reg 4.07E -- self-insurance`

`not self-insured` MEANS `My fund's cover` WITH
    `the fund self-insured this risk on 1 July 2013`              IS FALSE
    `I was transferred in from a fund that self-insured me`       IS FALSE
    `a government provides or guarantees the insured benefit`     IS FALSE
    `I am a defined benefit member`                               IS FALSE
    `APRA had prohibited self-insurance for defined benefit members by 1 July 2013` IS FALSE

`transferred in` MEANS `My fund's cover` WITH
    `the fund self-insured this risk on 1 July 2013`              IS FALSE
    `I was transferred in from a fund that self-insured me`       IS TRUE
    `a government provides or guarantees the insured benefit`     IS FALSE
    `I am a defined benefit member`                               IS FALSE
    `APRA had prohibited self-insurance for defined benefit members by 1 July 2013` IS FALSE

`self-insured` MEANS `My fund's cover` WITH
    `the fund self-insured this risk on 1 July 2013`              IS TRUE
    `I was transferred in from a fund that self-insured me`       IS FALSE
    `a government provides or guarantees the insured benefit`     IS FALSE
    `I am a defined benefit member`                               IS FALSE
    `APRA had prohibited self-insurance for defined benefit members by 1 July 2013` IS FALSE

`self-insured, government guaranteed` MEANS `My fund's cover` WITH
    `the fund self-insured this risk on 1 July 2013`              IS TRUE
    `I was transferred in from a fund that self-insured me`       IS FALSE
    `a government provides or guarantees the insured benefit`     IS TRUE
    `I am a defined benefit member`                               IS FALSE
    `APRA had prohibited self-insurance for defined benefit members by 1 July 2013` IS FALSE

`self-insured, defined benefit` MEANS `My fund's cover` WITH
    `the fund self-insured this risk on 1 July 2013`              IS TRUE
    `I was transferred in from a fund that self-insured me`       IS FALSE
    `a government provides or guarantees the insured benefit`     IS FALSE
    `I am a defined benefit member`                               IS TRUE
    `APRA had prohibited self-insurance for defined benefit members by 1 July 2013` IS FALSE

`self-insured, defined benefit, APRA condition` MEANS `My fund's cover` WITH
    `the fund self-insured this risk on 1 July 2013`              IS TRUE
    `I was transferred in from a fund that self-insured me`       IS FALSE
    `a government provides or guarantees the insured benefit`     IS FALSE
    `I am a defined benefit member`                               IS TRUE
    `APRA had prohibited self-insurance for defined benefit members by 1 July 2013` IS TRUE

-- (2): a fund that did not self-insure on 1 July 2013, from that day on.
#ASSERT `Must my cover be backed by an insurance policy` `not self-insured` (`the date` 30 6 2013) EQUALS JUST FALSE
#ASSERT `Must my cover be backed by an insurance policy` `not self-insured` (`the date` 1 7 2013) EQUALS JUST TRUE
#ASSERT `Must my cover be backed by an insurance policy` `not self-insured` (`the date` 7 11 2026) EQUALS JUST TRUE
-- (3): transferred in from a self-insuring fund: not on or before 1 July 2016; from 2 July 2016, yes.
#ASSERT `Must my cover be backed by an insurance policy` `transferred in` (`the date` 1 7 2016) EQUALS JUST FALSE
#ASSERT `Must my cover be backed by an insurance policy` `transferred in` (`the date` 2 7 2016) EQUALS JUST TRUE
-- (4): a self-insuring fund, from 1 July 2016.
#ASSERT `Must my cover be backed by an insurance policy` `self-insured` (`the date` 30 6 2016) EQUALS JUST FALSE
#ASSERT `Must my cover be backed by an insurance policy` `self-insured` (`the date` 1 7 2016) EQUALS JUST TRUE
-- (7): a government guarantee.
#ASSERT `Must my cover be backed by an insurance policy` `self-insured, government guaranteed` (`the date` 7 11 2026) EQUALS JUST FALSE
-- (8): defined benefit member, no APRA licence condition by 1 July 2013.
#ASSERT `Must my cover be backed by an insurance policy` `self-insured, defined benefit` (`the date` 7 11 2026) EQUALS JUST FALSE
#ASSERT `Must my cover be backed by an insurance policy` `self-insured, defined benefit, APRA condition` (`the date` 7 11 2026) EQUALS JUST TRUE

-- (9): the transition table, for a fund that self-insured on 1 July 2013.
#ASSERT `What does reg 4.07E(9) keep for me` TRUE `I was receiving an insured benefit` EQUALS JUST `to continue to receive the insured benefit`
#ASSERT `What does reg 4.07E(9) keep for me` TRUE `I had lodged a claim for an insured benefit` EQUALS JUST `to have the claim determined, and to receive the benefit if the trustee so determines`
#ASSERT `What does reg 4.07E(9) keep for me` TRUE `I was eligible to make a claim for an insured benefit` EQUALS JUST `to lodge a claim, have it determined, and receive the benefit if the trustee so determines`
#ASSERT `What does reg 4.07E(9) keep for me` TRUE `none of these` EQUALS JUST `no entitlement under reg 4.07E(9)`
#ASSERT `What does reg 4.07E(9) keep for me` FALSE `I had lodged a claim for an insured benefit` EQUALS NOTHING

§ `s 68AA(2)-(4) -- conditions on MySuper death and TPD cover`

GIVEN `mysuper` IS A BOOLEAN, `excluded` IS A BOOLEAN, `determined` IS A BOOLEAN, `policy terms` IS A BOOLEAN, `reasonable` IS A BOOLEAN, `met` IS A BOOLEAN
GIVETH A `My MySuper claim`
`a MySuper claim` MEANS `My MySuper claim` WITH
    `I am a MySuper member`                                          IS `mysuper`
    `I am a defined benefit member or an excluded ADF Super member`  IS `excluded`
    `the trustee determined conditions for the benefit`              IS `determined`
    `the conditions are the same as the insurance policy's terms`    IS `policy terms`
    `the conditions are otherwise reasonable`                        IS `reasonable`
    `I meet the conditions`                                          IS `met`

-- Conditions the same as the policy's terms (reasonable by (4)); a TPD claimant who does not meet them: excused.
#ASSERT `Is my fund excused from my MySuper death or TPD benefit` (`a MySuper claim` TRUE FALSE TRUE TRUE FALSE FALSE) EQUALS JUST TRUE
-- The same, but the conditions are met: not excused.
#ASSERT `Is my fund excused from my MySuper death or TPD benefit` (`a MySuper claim` TRUE FALSE TRUE TRUE FALSE TRUE) EQUALS JUST FALSE
-- Conditions not the policy's terms but otherwise reasonable, not met: excused.
#ASSERT `Is my fund excused from my MySuper death or TPD benefit` (`a MySuper claim` TRUE FALSE TRUE FALSE TRUE FALSE) EQUALS JUST TRUE
-- Conditions that are not reasonable are not conditions under (3): not excused.
#ASSERT `Is my fund excused from my MySuper death or TPD benefit` (`a MySuper claim` TRUE FALSE TRUE FALSE FALSE FALSE) EQUALS JUST FALSE
-- No conditions determined: not excused.
#ASSERT `Is my fund excused from my MySuper death or TPD benefit` (`a MySuper claim` TRUE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
-- Not a MySuper member, or a defined benefit member (s 68AA(9)): the section is silent.
#ASSERT `Is my fund excused from my MySuper death or TPD benefit` (`a MySuper claim` FALSE FALSE TRUE TRUE FALSE FALSE) EQUALS NOTHING
#ASSERT `Is my fund excused from my MySuper death or TPD benefit` (`a MySuper claim` TRUE TRUE TRUE TRUE FALSE FALSE) EQUALS NOTHING

§ `reg 6.01(2), Schedule 1 item 109 -- income protection`

GIVEN `stopped` IS A BOOLEAN, `ill-health` IS A BOOLEAN, `permanent` IS A BOOLEAN
GIVETH A `My incapacity`
`an incapacity` MEANS `My incapacity` WITH
    `I have stopped work, or stopped being paid under a continuing arrangement` IS `stopped`
    `ill-health caused me to stop`                                              IS `ill-health`
    `the trustee is satisfied my incapacity is permanent`                       IS `permanent`

#ASSERT `Am I temporarily incapacitated` (`an incapacity` TRUE TRUE FALSE) EQUALS JUST TRUE
-- Still working: not temporary incapacity.
#ASSERT `Am I temporarily incapacitated` (`an incapacity` FALSE TRUE FALSE) EQUALS JUST FALSE
-- Stopped for another reason (redundancy).
#ASSERT `Am I temporarily incapacitated` (`an incapacity` TRUE FALSE FALSE) EQUALS JUST FALSE
-- Permanent incapacity is excluded: that is the TPD route (item 103).
#ASSERT `Am I temporarily incapacitated` (`an incapacity` TRUE TRUE TRUE) EQUALS JUST FALSE

`incapacitated` MEANS `an incapacity` TRUE TRUE FALSE

GIVEN `form` IS A `A form of payment`, `amount` IS A NUMBER, `pay` IS A NUMBER, `last paid` IS A DATE, `ended` IS A BOOLEAN, `last incapacity` IS A DATE
GIVETH A `My income protection payment`
`a payment` MEANS `My income protection payment` WITH
    `the form`                                       IS `form`
    `the monthly amount`                             IS `amount`
    `my monthly pay before the incapacity`           IS `pay`
    `the last day paid for`                          IS `last paid`
    `my incapacity has ended`                        IS `ended`
    `the last day of my incapacity`                  IS `last incapacity`

-- $6,000 a month before; 75% ($4,500) paid monthly as a non-commutable income stream while still incapacitated.
#ASSERT `May my fund pay my temporary incapacity benefit this way` `incapacitated` (`a payment` `a non-commutable income stream` 4500 6000 (`the date` 31 12 2026) FALSE (`the date` 1 1 2026)) EQUALS JUST TRUE
-- The whole pay ($6,000): "in whole or part", allowed.
#ASSERT `May my fund pay my temporary incapacity benefit this way` `incapacitated` (`a payment` `a non-commutable income stream` 6000 6000 (`the date` 31 12 2026) FALSE (`the date` 1 1 2026)) EQUALS JUST TRUE
-- $1 over the pay: the purpose test is not a cap; NOTHING (fork).
#ASSERT `May my fund pay my temporary incapacity benefit this way` `incapacitated` (`a payment` `a non-commutable income stream` 6001 6000 (`the date` 31 12 2026) FALSE (`the date` 1 1 2026)) EQUALS NOTHING
-- Incapacity ended 30 June 2026: paid to 30 June 2026 (the last day), allowed; to 1 July 2026, beyond the period.
#ASSERT `May my fund pay my temporary incapacity benefit this way` `incapacitated` (`a payment` `a non-commutable income stream` 4500 6000 (`the date` 30 6 2026) TRUE (`the date` 30 6 2026)) EQUALS JUST TRUE
#ASSERT `May my fund pay my temporary incapacity benefit this way` `incapacitated` (`a payment` `a non-commutable income stream` 4500 6000 (`the date` 1 7 2026) TRUE (`the date` 30 6 2026)) EQUALS JUST FALSE
-- A lump sum, or a commutable income stream: not the cashing restriction.
#ASSERT `May my fund pay my temporary incapacity benefit this way` `incapacitated` (`a payment` `a lump sum` 4500 6000 (`the date` 31 12 2026) FALSE (`the date` 1 1 2026)) EQUALS JUST FALSE
#ASSERT `May my fund pay my temporary incapacity benefit this way` `incapacitated` (`a payment` `a commutable income stream` 4500 6000 (`the date` 31 12 2026) FALSE (`the date` 1 1 2026)) EQUALS JUST FALSE
-- Not temporarily incapacitated (the trustee accepts permanent incapacity): not under item 109.
#ASSERT `May my fund pay my temporary incapacity benefit this way` (`an incapacity` TRUE TRUE TRUE) (`a payment` `a non-commutable income stream` 4500 6000 (`the date` 31 12 2026) FALSE (`the date` 1 1 2026)) EQUALS JUST FALSE

§ `ss 29V(9), 29VA(10), 29VC(1) -- insurance fees in MySuper`

GIVEN `insurance` IS A BOOLEAN, `investment-linked` IS A BOOLEAN, `elsewhere` IS A BOOLEAN, `amount` IS A NUMBER, `cost` IS A NUMBER
GIVETH A `A fee`
`a fee` MEANS `A fee` WITH
    `it relates directly to insurance premiums or insurance costs for me`   IS `insurance`
    `it relates to an investment-linked policy`                             IS `investment-linked`
    `those premiums or costs are charged as another kind of fee`            IS `elsewhere`
    `the amount`                                                            IS `amount`
    `the cost recovery amount`                                              IS `cost`

#ASSERT `Is this fee an insurance fee` (`a fee` TRUE FALSE FALSE 300 300) EQUALS JUST TRUE
#ASSERT `Is this fee an insurance fee` (`a fee` FALSE FALSE FALSE 300 300) EQUALS JUST FALSE
#ASSERT `Is this fee an insurance fee` (`a fee` TRUE TRUE FALSE 300 300) EQUALS JUST FALSE
#ASSERT `Is this fee an insurance fee` (`a fee` TRUE FALSE TRUE 300 300) EQUALS JUST FALSE

-- $300 a year, cost recovery $300: at the limit, allowed; $300.01: over.
#ASSERT `May my fund charge me this insurance fee in MySuper` TRUE (`a fee` TRUE FALSE FALSE 300 300) EQUALS JUST TRUE
#ASSERT `May my fund charge me this insurance fee in MySuper` TRUE (`a fee` TRUE FALSE FALSE 300.01 300) EQUALS JUST FALSE
#ASSERT `May my fund charge me this insurance fee in MySuper` TRUE (`a fee` TRUE FALSE FALSE 250 300) EQUALS JUST TRUE
-- Not an insurance fee, or a choice product: these sections say nothing of it here.
#ASSERT `May my fund charge me this insurance fee in MySuper` TRUE (`a fee` TRUE TRUE FALSE 250 300) EQUALS NOTHING
#ASSERT `May my fund charge me this insurance fee in MySuper` FALSE (`a fee` TRUE FALSE FALSE 250 300) EQUALS NOTHING

§ `s 55 -- suing for loss`

-- Six years after the day the cause of action arose.
#ASSERT `The last day to begin my s 55 action` (`the date` 10 3 2020) EQUALS `the date` 10 3 2026
#ASSERT `The last day to begin my s 55 action` (`the date` 31 12 2021) EQUALS `the date` 31 12 2027
-- A cause on 29 February 2024: six years on there is no 29 February; the last day is 28 February 2030.
#ASSERT `The last day to begin my s 55 action` (`the date` 29 2 2024) EQUALS `the date` 28 2 2030

GIVEN `loss` IS A BOOLEAN, `director` IS A BOOLEAN, `leave` IS A BOOLEAN, `arose` IS A DATE, `begun` IS A DATE
GIVETH A `My s 55 action`
`an action` MEANS `My s 55 action` WITH
    `I suffered loss as a result of conduct in breach of a covenant`        IS `loss`
    `I sue a director of a corporate trustee for breach of a director's covenant` IS `director`
    `the court has given leave`                                             IS `leave`
    `the day the cause of action arose`                                     IS `arose`
    `the day I begin, or seek leave`                                        IS `begun`

-- A TPD claim the trustee did not pursue (s 52(7)(d)); the loss on 10 March 2020; sued on the last day.
#ASSERT `Can I bring my s 55 action` (`an action` TRUE FALSE FALSE (`the date` 10 3 2020) (`the date` 10 3 2026)) EQUALS JUST TRUE
-- One day late.
#ASSERT `Can I bring my s 55 action` (`an action` TRUE FALSE FALSE (`the date` 10 3 2020) (`the date` 11 3 2026)) EQUALS JUST FALSE
-- Against a director for breach of a director's covenant: only with leave.
#ASSERT `Can I bring my s 55 action` (`an action` TRUE TRUE FALSE (`the date` 10 3 2020) (`the date` 1 3 2026)) EQUALS JUST FALSE
#ASSERT `Can I bring my s 55 action` (`an action` TRUE TRUE TRUE (`the date` 10 3 2020) (`the date` 1 3 2026)) EQUALS JUST TRUE
-- Leave sought one day after the six years (s 55(4B)).
#ASSERT `Can I bring my s 55 action` (`an action` TRUE TRUE TRUE (`the date` 10 3 2020) (`the date` 11 3 2026)) EQUALS JUST FALSE
-- No loss from a breach of covenant: s 55 is silent.
#ASSERT `Can I bring my s 55 action` (`an action` FALSE FALSE FALSE (`the date` 10 3 2020) (`the date` 1 3 2026)) EQUALS NOTHING

-- The compliance defence covers investment and reserves losses only.
#ASSERT `Does the trustee have the s 55 compliance defence` `the making of an investment` TRUE EQUALS JUST TRUE
#ASSERT `Does the trustee have the s 55 compliance defence` `the making of an investment` FALSE EQUALS JUST FALSE
#ASSERT `Does the trustee have the s 55 compliance defence` `the management of reserves` TRUE EQUALS JUST TRUE
#ASSERT `Does the trustee have the s 55 compliance defence` `something else, e.g. how an insurance claim was handled` TRUE EQUALS NOTHING
#ASSERT `Does the trustee have the s 55 compliance defence` `something else, e.g. how an insurance claim was handled` FALSE EQUALS NOTHING

§ `s 101 -- complaints`

#ASSERT `Must my fund give written reasons on my complaint` `an APRA-regulated superannuation fund` EQUALS JUST TRUE
#ASSERT `Must my fund give written reasons on my complaint` `an exempt public sector scheme that has elected to join AFCA` EQUALS JUST TRUE
#ASSERT `Must my fund give written reasons on my complaint` `an approved deposit fund` EQUALS JUST TRUE
#ASSERT `Must my fund give written reasons on my complaint` `a self managed superannuation fund` EQUALS JUST FALSE
#ASSERT `Must my fund give written reasons on my complaint` `an exempt public sector scheme that has not elected to join AFCA` EQUALS NOTHING

#ASSERT `Where do my fund's AFCA duties come from` `an APRA-regulated superannuation fund` FALSE EQUALS JUST `this Act, s 101(1)(a)-(c)`
-- (1A) takes away (a)-(c) only; written reasons under (d) stay.
#ASSERT `Where do my fund's AFCA duties come from` `an APRA-regulated superannuation fund` TRUE EQUALS JUST `the Corporations Act, not s 101 (s 101(1A))`
#ASSERT `Where do my fund's AFCA duties come from` `a self managed superannuation fund` FALSE EQUALS JUST `s 101 does not impose them`
#ASSERT `Where do my fund's AFCA duties come from` `an exempt public sector scheme that has not elected to join AFCA` FALSE EQUALS NOTHING
