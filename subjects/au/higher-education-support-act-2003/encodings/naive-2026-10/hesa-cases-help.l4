§ `ss 36-5, 36-10`

#ASSERT `the student identifier requirements apply` `Chloe, Commerce at UWA, 2021`
#ASSERT NOT `the student identifier requirements apply` `Daniel, Commerce at UWA, 2014`

#ASSERT `is a Commonwealth supported student` `Chloe, Commerce at UWA, 2021`
#ASSERT NOT `is a Commonwealth supported student` `Chloe, had she not notified a student identifier`
#ASSERT `is a Commonwealth supported student` `Daniel, Commerce at UWA, 2014`
#ASSERT NOT `is a Commonwealth supported student` `Daniel, Juris Doctor at UWA, 2017, not advised`
#ASSERT `is a Commonwealth supported student` `a permanent visa holder, 2024`
#ASSERT NOT `is a Commonwealth supported student` `a student who opted out, 2024`

§ `ss 90-1, 90-5`

#ASSERT `is entitled to HECS-HELP assistance` `Chloe, Commerce at UWA, 2021`
#ASSERT NOT `is entitled to HECS-HELP assistance` `Chloe, had she not notified a student identifier`
#ASSERT `is entitled to HECS-HELP assistance` `Daniel, Commerce at UWA, 2014`
#ASSERT NOT `is entitled to HECS-HELP assistance` `Daniel, Juris Doctor at UWA, 2017, not advised`
#ASSERT `is entitled to HECS-HELP assistance` `Daniel, Juris Doctor, had UWA advised him`
#ASSERT NOT `is entitled to HECS-HELP assistance` `a permanent visa holder, 2024`
#ASSERT `is entitled to HECS-HELP assistance` `a permanent humanitarian visa holder, 2024`
#ASSERT NOT `is entitled to HECS-HELP assistance` `a student with no HELP balance left, 2024`

§ `ss 104-1, 104-5`

#ASSERT `is entitled to FEE-HELP assistance` `Daniel, Juris Doctor at UWA, 2017, not advised`
#ASSERT NOT `is entitled to FEE-HELP assistance` `Daniel, Juris Doctor, had UWA advised him`
#ASSERT NOT `is entitled to FEE-HELP assistance` `Chloe, Commerce at UWA, 2021`
#ASSERT `is entitled to FEE-HELP assistance` `a student who opted out, 2024`
#ASSERT `is entitled to FEE-HELP assistance` `a student at a non-Table A provider outside a national priority, 2024`
#ASSERT NOT `is entitled to FEE-HELP assistance` `a permanent visa holder, 2024`

