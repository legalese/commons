§ `s 44(i) -- foreign allegiance`

-- d060: Italian by descent, renunciation not yet effective -- still a citizen, so incapable.
#ASSERT `Am I still a citizen of a foreign power` `Daniel at the consulate`
#ASSERT NOT `Am I still a citizen of a foreign power` `Daniel renounced`

#ASSERT `Am I disqualified by foreign allegiance` `Daniel at the consulate`
#ASSERT NOT `Am I disqualified by foreign allegiance` `Daniel renounced`
#ASSERT `Am I disqualified by foreign allegiance` `a citizen whose foreign law forbids renunciation`
#ASSERT NOT `Am I disqualified by foreign allegiance` `an Australian-born sole citizen`
#ASSERT `Am I disqualified by foreign allegiance` `a person under oath of allegiance to a foreign power`
#ASSERT `Am I disqualified by foreign allegiance` `a person entitled to the privileges of a foreign citizen`

§ `s 44(ii)-(v)`

#ASSERT `Am I disqualified by a conviction` `a person attainted of treason`
#ASSERT `Am I disqualified by a conviction` `awaiting sentence for an offence punishable by 12 months`
#ASSERT NOT `Am I disqualified by a conviction` `awaiting sentence for an offence punishable by 6 months`
#ASSERT NOT `Am I disqualified by a conviction` `sentence served for an offence punishable by 10 years`

#ASSERT `Am I disqualified as a bankrupt` `an undischarged bankrupt`

#ASSERT `Am I disqualified by an office or pension` `a Commonwealth public servant`
#ASSERT NOT `Am I disqualified by an office or pension` `a State minister`
#ASSERT NOT `Am I disqualified by an office or pension` `an army reservist`
#ASSERT `Am I disqualified by an office or pension` `a full-time soldier`
#ASSERT `Am I disqualified by an office or pension` `a Crown pensioner`
#ASSERT NOT `Am I disqualified by an office or pension` `a pensioner of the navy of the Queen`

#ASSERT `Am I disqualified by an interest in a Commonwealth agreement` `a sole trader with a Commonwealth contract`
#ASSERT NOT `Am I disqualified by an interest in a Commonwealth agreement` `a shareholder in a listed company with a Commonwealth contract`
#ASSERT `Am I disqualified by an interest in a Commonwealth agreement` `a member of a 25-member company with a Commonwealth contract`
#ASSERT NOT `Am I disqualified by an interest in a Commonwealth agreement` `a member of a 26-member company with a Commonwealth contract`

-- The answer the Commonwealth Electoral Act baseline asks of Daniel as a fact: TRUE in March, FALSE at nomination.
#ASSERT `Am I incapable of being chosen under section 44` `Daniel at the consulate`
#ASSERT NOT `Am I incapable of being chosen under section 44` `Daniel renounced`
#ASSERT `Am I incapable of being chosen under section 44` `an undischarged bankrupt`

§ `ss 16, 34 -- qualifications`

#ASSERT `Do I have the section 34 qualifications` `Daniel renounced` (Date 23 6 2040)
#ASSERT NOT `Do I have the section 34 qualifications` `a young citizen born 1 July 2019` (Date 30 6 2040)
#ASSERT `Do I have the section 34 qualifications` `a young citizen born 1 July 2019` (Date 1 7 2040)
#ASSERT NOT `Do I have the section 34 qualifications` `a subject naturalized 3 years` (Date 23 6 2040)
#ASSERT `Do I have the section 34 qualifications` `a subject naturalized 5 years` (Date 23 6 2040)
#ASSERT NOT `Do I have the section 34 qualifications` `a newly arrived resident` (Date 23 6 2040)

-- s 34 gives way once the Parliament has provided: a 20-year-old qualified under the Parliament's law.
#ASSERT `Do I have the qualifications that apply` `a young citizen born 1 July 2019` (Date 30 6 2040) TRUE TRUE
#ASSERT NOT `Do I have the qualifications that apply` `a young citizen born 1 July 2019` (Date 30 6 2040) FALSE TRUE

§ `s 43 and the whole question`

#ASSERT `Does section 43 bar me` `a sitting senator` `the House of Representatives`

-- d060 / d061: Daniel, for the House of Representatives, with the Electoral Act s 163 qualifications.
#ASSERT NOT `Am I capable of being chosen` `Daniel at the consulate` `the House of Representatives` (Date 15 3 2040) TRUE TRUE
#ASSERT `Am I capable of being chosen` `Daniel renounced` `the House of Representatives` (Date 23 6 2040) TRUE TRUE
#ASSERT NOT `Am I capable of being chosen` `a sitting senator` `the House of Representatives` (Date 23 6 2040) TRUE TRUE

§ `ss 45, 46 -- once chosen`

#ASSERT NOT `Would my place become vacant` `Daniel renounced` FALSE FALSE
#ASSERT `Would my place become vacant` `Daniel renounced` TRUE FALSE
#ASSERT `Would my place become vacant` `Daniel renounced` FALSE TRUE

#ASSERT `What could I be made to pay for sitting while incapable` `Daniel at the consulate` `the House of Representatives` 10 EQUALS 1000
#ASSERT `What could I be made to pay for sitting while incapable` `Daniel renounced` `the House of Representatives` 10 EQUALS 0

