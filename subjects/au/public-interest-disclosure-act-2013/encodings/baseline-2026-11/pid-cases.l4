§§ `ss 10-12 -- the discloser's immunity`

#ASSERT `Am I protected from this liability for my disclosure?` TRUE `civil or criminal or administrative liability including disciplinary action for making it` FALSE FALSE EQUALS TRUE
#ASSERT `Am I protected from this liability for my disclosure?` TRUE `a contractual or other remedy or right enforced against me on the basis of it` FALSE FALSE EQUALS TRUE
#ASSERT `Am I protected from this liability for my disclosure?` TRUE `defamation proceedings about it` FALSE FALSE EQUALS TRUE
#ASSERT `Am I protected from this liability for my disclosure?` TRUE `termination of my contract on the basis that it breached the contract` FALSE FALSE EQUALS TRUE
#ASSERT `Am I protected from this liability for my disclosure?` TRUE `liability for knowingly making a false or misleading statement` FALSE FALSE EQUALS FALSE
#ASSERT `Am I protected from this liability for my disclosure?` TRUE `an offence against section 137.1 or 137.2 or 144.1 or 145.1 of the Criminal Code` FALSE FALSE EQUALS FALSE
-- s 11A: out only if the discloser knew AND had no reasonable excuse.
#ASSERT `Am I protected from this liability for my disclosure?` TRUE `liability for contravening a designated publication restriction` TRUE FALSE EQUALS FALSE
#ASSERT `Am I protected from this liability for my disclosure?` TRUE `liability for contravening a designated publication restriction` TRUE TRUE EQUALS TRUE
#ASSERT `Am I protected from this liability for my disclosure?` TRUE `liability for contravening a designated publication restriction` FALSE FALSE EQUALS TRUE
#ASSERT `Am I protected from this liability for my disclosure?` TRUE `liability for my own conduct that it reveals` FALSE FALSE EQUALS FALSE
#ASSERT `Am I protected from this liability for my disclosure?` FALSE `civil or criminal or administrative liability including disciplinary action for making it` FALSE FALSE EQUALS FALSE
#ASSERT `Am I protected from this liability for my disclosure?` FALSE `defamation proceedings about it` FALSE FALSE EQUALS FALSE

