IMPORT prelude
IMPORT daydate
IMPORT `hrsc-rules`

-- Independent tests, from independent-expectations.md (written before the
-- rules module was read). Expected values are the Act's, not the code's.

§ `Helpers`

GIVEN d IS A DATE
      dobs IS A LIST OF DATE
GIVETH A `Conduct`
`private consenting conduct on` d `among` dobs MEANS
    `Conduct` OF d, dobs, TRUE, TRUE, `a law of the Commonwealth, a State or a Territory`, TRUE

§ `Adulthood, s 4(2)`

-- 1. 18th birthday
#ASSERT `born on` (Date 15 3 2008) `is an adult on` (Date 15 3 2026)
-- 2. day before
#ASSERT NOT (`born on` (Date 15 3 2008) `is an adult on` (Date 14 3 2026))
-- 3. day after
#ASSERT `born on` (Date 15 3 2008) `is an adult on` (Date 16 3 2026)
-- 4. 29 Feb birthday, 28 Feb of a common year (brief's rule)
#ASSERT `born on` (Date 29 2 2008) `is an adult on` (Date 28 2 2026)
-- 5. 29 Feb birthday, 27 Feb
#ASSERT NOT (`born on` (Date 29 2 2008) `is an adult on` (Date 27 2 2026))
-- 6. 29 Feb birthday, 1 Mar
#ASSERT `born on` (Date 29 2 2008) `is an adult on` (Date 1 3 2026)
-- 7. 29 Feb 2000, 28 Feb 2018
#ASSERT `born on` (Date 29 2 2000) `is an adult on` (Date 28 2 2018)
-- 7b. 29 Feb 2000, 27 Feb 2018
#ASSERT NOT (`born on` (Date 29 2 2000) `is an adult on` (Date 27 2 2018))
-- 8. 31 Dec
#ASSERT `born on` (Date 31 12 2007) `is an adult on` (Date 31 12 2025)
#ASSERT NOT (`born on` (Date 31 12 2007) `is an adult on` (Date 30 12 2025))

§ `Protection, s 4(1)`

-- 9
#ASSERT `the conduct is protected for` (`private consenting conduct on` (Date 1 6 2026) `among` (LIST Date 1 1 1990, Date 1 1 1985))
-- 10
#ASSERT NOT (`the conduct is protected for` (`private consenting conduct on` (Date 14 3 2026) `among` (LIST Date 1 1 1990, Date 15 3 2008)))
#ASSERT NOT (`everyone involved is an adult for` (`private consenting conduct on` (Date 14 3 2026) `among` (LIST Date 1 1 1990, Date 15 3 2008)))
-- 11
#ASSERT `the conduct is protected for` (`private consenting conduct on` (Date 15 3 2026) `among` (LIST Date 1 1 1990, Date 15 3 2008))
-- 12 no consent
#ASSERT NOT (`the conduct is protected for` (`Conduct` OF Date 1 6 2026, (LIST Date 1 1 1990, Date 1 1 1985), FALSE, TRUE, `a law of the Commonwealth, a State or a Territory`, TRUE))
-- 13 not private
#ASSERT NOT (`the conduct is protected for` (`Conduct` OF Date 1 6 2026, (LIST Date 1 1 1990, Date 1 1 1985), TRUE, FALSE, `a law of the Commonwealth, a State or a Territory`, TRUE))
-- 14 three adults
#ASSERT `the conduct is protected for` (`private consenting conduct on` (Date 1 6 2026) `among` (LIST Date 1 1 1990, Date 1 1 1985, Date 29 2 1988))
-- 15 one adult alone
#ASSERT `the conduct is protected for` (`private consenting conduct on` (Date 1 6 2026) `among` (LIST Date 1 1 1990))
-- 21 nobody involved: not protected (the Act does not contemplate it)
#ASSERT NOT (`the conduct is protected for` (`private consenting conduct on` (Date 1 6 2026) `among` (LIST)))

§ `Interference`

-- 16 / 17 arbitrary interference under a State or Territory law: barred
#ASSERT `the interference is barred for` (`private consenting conduct on` (Date 1 6 2026) `among` (LIST Date 1 1 1990, Date 1 1 1985)) EQUALS JUST TRUE
-- 18 not arbitrary: not barred by s 4
#ASSERT `the interference is barred for` (`Conduct` OF Date 1 6 2026, (LIST Date 1 1 1990, Date 1 1 1985), TRUE, TRUE, `a law of the Commonwealth, a State or a Territory`, FALSE) EQUALS JUST FALSE
-- 19 a minor involved: s 4 does not bar it
#ASSERT `the interference is barred for` (`private consenting conduct on` (Date 14 3 2026) `among` (LIST Date 1 1 1990, Date 15 3 2008)) EQUALS JUST FALSE
-- 20 interference not under an Australian law: not barred by s 4
#ASSERT `the interference is barred for` (`Conduct` OF Date 1 6 2026, (LIST Date 1 1 1990, Date 1 1 1985), TRUE, TRUE, `some other law`, TRUE) EQUALS JUST FALSE

§ `Top level`

#ASSERT `the sexual conduct position for` (`private consenting conduct on` (Date 28 2 2026) `among` (LIST Date 29 2 2008, Date 1 1 1990)) EQUALS (`Sexual conduct position` OF TRUE, TRUE, (JUST TRUE))
#ASSERT `the sexual conduct position for` (`private consenting conduct on` (Date 27 2 2026) `among` (LIST Date 29 2 2008, Date 1 1 1990)) EQUALS (`Sexual conduct position` OF FALSE, FALSE, (JUST FALSE))
