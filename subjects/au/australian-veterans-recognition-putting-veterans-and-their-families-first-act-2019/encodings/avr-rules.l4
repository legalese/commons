IMPORT prelude
IMPORT daydate

-- Australian Veterans' Recognition (Putting Veterans and their Families
-- First) Act 2019 (Cth). Source: ../registers/source-bundle/C2019A00096.txt.
-- Seat: the veteran or family member.

§ `Nouns`

DECLARE `Veteran case` HAS
    -- s 4
    `served in the Permanent Forces or Reserves`        IS A BOOLEAN
    -- s 7(3)
    `claim received on`                                 IS A MAYBE DATE
    `requested information received on`                 IS A MAYBE DATE

DECLARE `Veteran position` HAS
    `I am a veteran`                                    IS A BOOLEAN
    `committed decision date for my MRC Act claim`      IS A MAYBE DATE
    `Part 2 is enforceable`                             IS A BOOLEAN

§ `Rules`

-- s 7(3): "within 90 days beginning on ... whichever occurs later".
@ref s 7(3)
GIVEN c IS A `Veteran case`
GIVETH A MAYBE DATE
`the committed decision date for` c MEANS
    CONSIDER c's `claim received on`
    WHEN NOTHING THEN NOTHING
    WHEN JUST r THEN
        JUST (Date (Day start PLUS 89))
        WHERE
            start MEANS
                CONSIDER c's `requested information received on`
                WHEN NOTHING THEN r
                WHEN JUST i  THEN `the later of` r i

@ref ss 4, 7(3), 10
@export default The veteran's position under the Australian Veterans' Recognition (Putting Veterans and their Families First) Act 2019 (Cth): whether I am a veteran (s 4), the last day of the 90 days within which the Commonwealth is committed to the Repatriation Commission deciding my MRC Act claim (s 7(3): beginning on the later of receipt of the claim and receipt of requested information), and that Part 2, including that commitment, is not legally enforceable (s 10). DRAFT, not reviewed by an Australian lawyer.
GIVEN c IS A `Veteran case`  @desc Service, and the dates the claim and any requested information were received
GIVETH A `Veteran position`
`the veteran position for` c MEANS
    `Veteran position` WITH
        `I am a veteran`                                IS c's `served in the Permanent Forces or Reserves`
        `committed decision date for my MRC Act claim`  IS `the committed decision date for` c
        `Part 2 is enforceable`                         IS FALSE
