IMPORT prelude
IMPORT `aa-rules`

-- 1 s 6(1): Cth-operated -> Part II
#ASSERT (`the Part for` (`Air case` OF `the Commonwealth or a Commonwealth authority`, FALSE, `none`, FALSE, FALSE, TRUE, 725000, 0, 500000, 0, 0, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS `Part II`

-- 1 s 8(1)(a): cap
#ASSERT (`the cap for` (`Air case` OF `the Commonwealth or a Commonwealth authority`, FALSE, `none`, FALSE, FALSE, TRUE, 725000, 0, 500000, 0, 0, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS 725000

-- 1 damages
#ASSERT (`the damages for` (`Air case` OF `the Commonwealth or a Commonwealth authority`, FALSE, `none`, FALSE, FALSE, TRUE, 725000, 0, 500000, 0, 0, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS 500000

-- 1 heard now
#ASSERT (`my action can be heard now` (`Air case` OF `the Commonwealth or a Commonwealth authority`, FALSE, `none`, FALSE, FALSE, TRUE, 725000, 0, 500000, 0, 0, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS TRUE

-- 2 s 6(1): Part IV CLA applies -> neither
#ASSERT (`the Part for` (`Air case` OF `the Commonwealth or a Commonwealth authority`, FALSE, `none`, TRUE, FALSE, TRUE, 725000, 0, 500000, 0, 0, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS `neither Part`

-- 2 damages nil
#ASSERT (`the damages for` (`Air case` OF `the Commonwealth or a Commonwealth authority`, FALSE, `none`, TRUE, FALSE, TRUE, 725000, 0, 500000, 0, 0, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS 0

-- 3 s 6(2): VEA pension -> neither
#ASSERT (`the Part for` (`Air case` OF `the Commonwealth or a Commonwealth authority`, FALSE, `none`, FALSE, TRUE, TRUE, 725000, 0, 500000, 0, 0, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS `neither Part`

-- 4 s 4: working crew of commercial Cth authority -> not passenger
#ASSERT (`the Part for` (`Air case` OF `the Commonwealth or a Commonwealth authority`, TRUE, `none`, FALSE, FALSE, TRUE, 725000, 0, 500000, 0, 0, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS `neither Part`

-- 4 damages nil
#ASSERT (`the damages for` (`Air case` OF `the Commonwealth or a Commonwealth authority`, TRUE, `none`, FALSE, FALSE, TRUE, 725000, 0, 500000, 0, 0, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS 0

-- 5 s 8(1)(a): prescribed lower -> 1AA cap
#ASSERT (`the cap for` (`Air case` OF `the Commonwealth or a Commonwealth authority`, FALSE, `none`, FALSE, FALSE, TRUE, 725000, 500000, 1000000, 0, 0, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS 725000

-- 5 damages capped
#ASSERT (`the damages for` (`Air case` OF `the Commonwealth or a Commonwealth authority`, FALSE, `none`, FALSE, FALSE, TRUE, 725000, 500000, 1000000, 0, 0, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS 725000

-- 6 s 8(1)(b): prescribed higher
#ASSERT (`the cap for` (`Air case` OF `the Commonwealth or a Commonwealth authority`, FALSE, `none`, FALSE, FALSE, TRUE, 725000, 900000, 1000000, 0, 0, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS 900000

-- 6 damages
#ASSERT (`the damages for` (`Air case` OF `the Commonwealth or a Commonwealth authority`, FALSE, `none`, FALSE, FALSE, TRUE, 725000, 900000, 1000000, 0, 0, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS 900000

-- 7 s 8(1): equal amounts
#ASSERT (`the cap for` (`Air case` OF `the Commonwealth or a Commonwealth authority`, FALSE, `none`, FALSE, FALSE, TRUE, 725000, 725000, 500000, 0, 0, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS 725000

-- 8 s 8(2)(a): insurance deducted
#ASSERT (`the damages for` (`Air case` OF `the Commonwealth or a Commonwealth authority`, FALSE, `none`, FALSE, FALSE, TRUE, 725000, 0, 500000, 100000, 0, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS 400000

-- 9 s 8(1),(2): cap then deduct
#ASSERT (`the damages for` (`Air case` OF `the Commonwealth or a Commonwealth authority`, FALSE, `none`, FALSE, FALSE, TRUE, 725000, 0, 1000000, 100000, 0, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS 625000

-- 10 s 10(1)(a): recovered otherwise -> nil under Part II
#ASSERT (`the damages for` (`Air case` OF `the Commonwealth or a Commonwealth authority`, FALSE, `none`, FALSE, FALSE, TRUE, 725000, 0, 500000, 0, 0, TRUE, FALSE, FALSE, FALSE, FALSE)) EQUALS 0

-- 11 s 11(1)(a): Cth employee -> Part III
#ASSERT (`the Part for` (`Air case` OF `another operator`, FALSE, `a Commonwealth employee or seaman travelling in the course of employment`, FALSE, FALSE, TRUE, 725000, 0, 500000, 0, 0, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS `Part III`

-- 11 s 12/14: damages
#ASSERT (`the damages for` (`Air case` OF `another operator`, FALSE, `a Commonwealth employee or seaman travelling in the course of employment`, FALSE, FALSE, TRUE, 725000, 0, 500000, 0, 0, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS 500000

-- 11 heard
#ASSERT (`my action can be heard now` (`Air case` OF `another operator`, FALSE, `a Commonwealth employee or seaman travelling in the course of employment`, FALSE, FALSE, TRUE, 725000, 0, 500000, 0, 0, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS TRUE

-- 12 s 11(1): no connection -> neither
#ASSERT (`the Part for` (`Air case` OF `another operator`, FALSE, `none`, FALSE, FALSE, TRUE, 725000, 0, 500000, 0, 0, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS `neither Part`

-- 12 damages nil
#ASSERT (`the damages for` (`Air case` OF `another operator`, FALSE, `none`, FALSE, FALSE, TRUE, 725000, 0, 500000, 0, 0, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS 0

-- 13/14 s 11(3A),(4): ACT/NT connection -> Part III
#ASSERT (`the Part for` (`Air case` OF `another operator`, FALSE, `the same connection with the ACT or the Northern Territory`, FALSE, FALSE, TRUE, 725000, 0, 500000, 0, 0, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS `Part III`

-- 13/14 damages
#ASSERT (`the damages for` (`Air case` OF `another operator`, FALSE, `the same connection with the ACT or the Northern Territory`, FALSE, FALSE, TRUE, 725000, 0, 500000, 0, 0, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS 500000

-- 15 s 11(2): declared State Act -> neither
#ASSERT (`the Part for` (`Air case` OF `another operator`, FALSE, `the Commonwealth or an authority bears the cost of carriage`, TRUE, FALSE, TRUE, 725000, 0, 500000, 0, 0, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS `neither Part`

-- 16 s 11(3): VEA -> neither
#ASSERT (`the Part for` (`Air case` OF `another operator`, FALSE, `the Commonwealth or an authority bears the cost of carriage`, FALSE, TRUE, TRUE, 725000, 0, 500000, 0, 0, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS `neither Part`

-- 17 s 12: not on board/embarking -> nil
#ASSERT (`the damages for` (`Air case` OF `another operator`, FALSE, `the Commonwealth or an authority bears the cost of carriage`, FALSE, FALSE, FALSE, 725000, 0, 500000, 0, 0, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS 0

-- 18 s 14(2): carrier and insurance deducted
#ASSERT (`the damages for` (`Air case` OF `another operator`, FALSE, `the Commonwealth or an authority bears the cost of carriage`, FALSE, FALSE, TRUE, 725000, 0, 500000, 50000, 200000, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS 250000

-- 19 s 14(2): floor at nil
#ASSERT (`the damages for` (`Air case` OF `another operator`, FALSE, `the Commonwealth or an authority bears the cost of carriage`, FALSE, FALSE, TRUE, 725000, 0, 500000, 0, 600000, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS 0

-- 20 s 16(1)(a): failed to pursue -> barred
#ASSERT (`the damages for` (`Air case` OF `another operator`, FALSE, `the Commonwealth or an authority bears the cost of carriage`, FALSE, FALSE, TRUE, 725000, 0, 500000, 0, 0, FALSE, TRUE, FALSE, FALSE, FALSE)) EQUALS 0

-- 21 s 16(1)(b): settled without consent -> barred
#ASSERT (`the damages for` (`Air case` OF `another operator`, FALSE, `the Commonwealth or an authority bears the cost of carriage`, FALSE, FALSE, TRUE, 725000, 0, 500000, 0, 0, FALSE, FALSE, TRUE, FALSE, FALSE)) EQUALS 0

-- 22 s 16(1)(c): refused request -> barred
#ASSERT (`the damages for` (`Air case` OF `another operator`, FALSE, `the Commonwealth or an authority bears the cost of carriage`, FALSE, FALSE, TRUE, 725000, 0, 500000, 0, 0, FALSE, FALSE, FALSE, TRUE, FALSE)) EQUALS 0

-- 23 s 17: pending -> not heard now
#ASSERT (`my action can be heard now` (`Air case` OF `another operator`, FALSE, `the Commonwealth or an authority bears the cost of carriage`, FALSE, FALSE, TRUE, 725000, 0, 500000, 0, 0, FALSE, FALSE, FALSE, FALSE, TRUE)) EQUALS FALSE

-- 23 s 17: not barred, damages still computed
#ASSERT (`the damages for` (`Air case` OF `another operator`, FALSE, `the Commonwealth or an authority bears the cost of carriage`, FALSE, FALSE, TRUE, 725000, 0, 500000, 0, 0, FALSE, FALSE, FALSE, FALSE, TRUE)) EQUALS 500000

-- 24 s 15(1)(a): recovered otherwise -> nil
#ASSERT (`the damages for` (`Air case` OF `another operator`, FALSE, `the Commonwealth or an authority bears the cost of carriage`, FALSE, FALSE, TRUE, 725000, 0, 500000, 0, 0, TRUE, FALSE, FALSE, FALSE, FALSE)) EQUALS 0

-- 25 s 4: corporation crew on board to work -> neither
#ASSERT (`the Part for` (`Air case` OF `another operator`, TRUE, `the Commonwealth or an authority bears the cost of carriage`, FALSE, FALSE, TRUE, 725000, 0, 500000, 0, 0, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS `neither Part`

-- 26 s 16 is Part III only: Part II not barred
#ASSERT (`the damages for` (`Air case` OF `the Commonwealth or a Commonwealth authority`, FALSE, `none`, FALSE, FALSE, TRUE, 725000, 0, 500000, 0, 0, FALSE, TRUE, FALSE, FALSE, FALSE)) EQUALS 500000

-- 26b s 17 is Part III only: Part II heard now
#ASSERT (`my action can be heard now` (`Air case` OF `the Commonwealth or a Commonwealth authority`, FALSE, `none`, FALSE, FALSE, TRUE, 725000, 0, 500000, 0, 0, FALSE, FALSE, FALSE, FALSE, TRUE)) EQUALS TRUE

-- s 11(1)(c): travelling for Cth purposes
#ASSERT (`the Part for` (`Air case` OF `another operator`, FALSE, `travelling for Commonwealth purposes under its arrangements`, FALSE, FALSE, TRUE, 725000, 0, 500000, 0, 0, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS `Part III`

-- s 14(1)(b),(2): cap 1m then less 100k
#ASSERT (`the damages for` (`Air case` OF `another operator`, FALSE, `the Commonwealth or an authority bears the cost of carriage`, FALSE, FALSE, TRUE, 725000, 1000000, 2000000, 0, 100000, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS 900000
