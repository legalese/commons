IMPORT prelude
IMPORT daydate
IMPORT `dfrb67-rules`

-- Independent tests: expected values decided from the source text before
-- reading dfrb67-rules.l4 (see independent-expectations.md).

`none` MEANS `no commutation or election`
`s74` MEANS `commuted under s 74 of the 1948 Act`
`s61` MEANS `an election under s 61A or 61B of the 1963-1965 Act`
`p4` MEANS `a pensioner under s 4`
`w8` MEANS `a widow under s 8`

GIVEN k IS A `DFRB 1967 class`
      d IS A DATE
      cur IS A NUMBER
      act IS A NUMBER
      bas IS A NUMBER
      red IS A `Reduction`
      pay IS A NUMBER
      without IS A NUMBER
      earlier IS A NUMBER
      halfel IS A BOOLEAN
      sup IS A BOOLEAN
GIVETH A `DFRB 1967 case`
`mk` k d cur act bas red pay without earlier halfel sup MEANS
    `DFRB 1967 case` OF k, d, cur, act, bas, red, pay, without, earlier, halfel, sup

-- 1
#ASSERT `my 1967 increase for` (`mk` `p4` (Date 1 1 1960) 1400 1000 700 `none` 1000 1000 0 FALSE FALSE) EQUALS JUST 500
-- 2
#ASSERT `my 1967 increase for` (`mk` `p4` (Date 1 1 1960) 1000 1000 700 `none` 1000 1000 0 FALSE FALSE) EQUALS JUST 0
-- 3
#ASSERT `my 1967 increase for` (`mk` `p4` (Date 1 1 1960) 1001 1000 1000 `none` 1000 1000 0 FALSE FALSE) EQUALS JUST (5/7)
-- 4/5 date edge
#ASSERT `my 1967 increase for` (`mk` `p4` (Date 29 6 1967) 1400 1000 700 `none` 1000 1000 0 FALSE FALSE) EQUALS JUST 500
#ASSERT `my 1967 increase for` (`mk` `p4` (Date 30 6 1967) 1400 1000 700 `none` 1000 1000 0 FALSE FALSE) EQUALS JUST 0
-- 6/7 s 5
#ASSERT `my 1967 increase for` (`mk` `p4` (Date 1 1 1960) 1400 1000 700 `s74` 800 1000 0 FALSE FALSE) EQUALS JUST 400
#ASSERT `my 1967 increase for` (`mk` `p4` (Date 1 1 1960) 1400 1000 700 `s61` 900 1000 0 FALSE FALSE) EQUALS JUST 450
-- 8-10 s 6
#ASSERT `my 1967 increase for` (`mk` `p4` (Date 1 1 1960) 1400 1000 700 `none` 1000 1000 100 FALSE FALSE) EQUALS JUST 400
#ASSERT `my 1967 increase for` (`mk` `p4` (Date 1 1 1960) 1400 1000 700 `s74` 800 1000 100 FALSE FALSE) EQUALS JUST 300
#ASSERT `my 1967 increase for` (`mk` `p4` (Date 1 1 1960) 1400 1000 700 `none` 1000 1000 600 FALSE FALSE) EQUALS JUST 0
-- 11 s 7
#ASSERT `my 1967 increase for` (`mk` `a pensioner under s 7` (Date 1 1 1960) 1400 1000 700 `none` 1000 1000 0 FALSE FALSE) EQUALS NOTHING
-- 12 s 13
#ASSERT `my 1967 increase for` (`mk` `p4` (Date 1 1 1960) 1400 1000 700 `none` 1000 1000 0 FALSE TRUE) EQUALS JUST 0
-- 13 s 10
#ASSERT `my 1967 increase for` (`mk` `a pensioner whose suspended pension again becomes payable (s 10)` (Date 1 1 1960) 1400 1000 700 `none` 1000 1000 0 FALSE FALSE) EQUALS JUST 500
-- 14-21 widows
#ASSERT `my 1967 increase for` (`mk` `w8` (Date 1 1 1960) 1400 1000 700 `none` 1000 1000 0 FALSE FALSE) EQUALS JUST 312.5
#ASSERT `my 1967 increase for` (`mk` `w8` (Date 1 1 1960) 1400 1000 700 `none` 1000 1000 0 TRUE FALSE) EQUALS JUST 250
#ASSERT `my 1967 increase for` (`mk` `w8` (Date 1 1 1960) 1400 1000 700 `s74` 800 1000 0 FALSE FALSE) EQUALS JUST 312.5
#ASSERT `my 1967 increase for` (`mk` `w8` (Date 1 1 1960) 1400 1000 700 `s61` 800 1000 0 FALSE FALSE) EQUALS JUST 250
#ASSERT `my 1967 increase for` (`mk` `w8` (Date 1 1 1960) 1400 1000 700 `none` 1000 1000 100 FALSE FALSE) EQUALS JUST 250
#ASSERT `my 1967 increase for` (`mk` `a widow under s 9` (Date 1 1 1960) 1400 1000 700 `none` 1000 1000 0 FALSE FALSE) EQUALS NOTHING
#ASSERT `my 1967 increase for` (`mk` `w8` (Date 1 1 1960) 1400 1000 700 `none` 1000 1000 0 FALSE TRUE) EQUALS JUST 312.5
#ASSERT `my 1967 increase for` (`mk` `w8` (Date 1 1 1960) 1000 1000 700 `none` 1000 1000 0 FALSE FALSE) EQUALS JUST 0
