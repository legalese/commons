IMPORT prelude
IMPORT `fwa2-orders`

-- Cases for fwa2-orders.l4. Expected values worked by hand from the text (section cited). Edges: the compensation cap
-- one dollar either side; the 24-month anniversary and the day after; the 60th day and the 61st; a removal notice that
-- ends before and after the 60 days.

§ `ss 390-392 -- unfair dismissal remedies`

#ASSERT `Can the FWC order my reinstatement` TRUE TRUE TRUE
-- No s 394 application: no order (s 390(2)).
#ASSERT NOT (`Can the FWC order my reinstatement` TRUE TRUE FALSE)
#ASSERT `Can the FWC order compensation instead of reinstatement` TRUE TRUE TRUE TRUE TRUE
-- Reinstatement not found inappropriate: no compensation (s 390(3)(a)).
#ASSERT NOT (`Can the FWC order compensation instead of reinstatement` TRUE TRUE TRUE FALSE TRUE)
#ASSERT `Who can be ordered to reinstate me` TRUE TRUE EQUALS `my employer, or the associated entity that now has my position`
#ASSERT `Who can be ordered to reinstate me` TRUE FALSE EQUALS `only my employer at the time of the dismissal`

-- Cap: received 40,000, entitled 42,000 (underpaid), no unpaid leave, threshold 183,100 (half 91,550): 42,000.
#ASSERT `What is the most unfair dismissal compensation` 40000 42000 0 183100 EQUALS 42000
-- A high earner: 26 weeks of 120,000 against half the threshold, 91,550.
#ASSERT `What is the most unfair dismissal compensation` 120000 120000 0 183100 EQUALS 91550
-- Unpaid leave in the 26 weeks: 30,000 worked plus 5,000 ordinary pay for the leave (reg 3.06) = 35,000.
#ASSERT `What is the most unfair dismissal compensation` 30000 30000 5000 180000 EQUALS 35000
-- One dollar over half the threshold: capped at 91,550; one dollar under: 91,549.
#ASSERT `What is the most unfair dismissal compensation` 91551 91551 0 183100 EQUALS 91550
#ASSERT `What is the most unfair dismissal compensation` 91549 91549 0 183100 EQUALS 91549
-- Assessed 50,000, misconduct reduction 10,000, cap 42,000: 40,000 (reduced first, then capped).
#ASSERT `How much unfair dismissal compensation would I get` 50000 10000 40000 42000 0 183100 EQUALS 40000
-- Assessed 60,000, no reduction: capped at 42,000.
#ASSERT `How much unfair dismissal compensation would I get` 60000 0 40000 42000 0 183100 EQUALS 42000
-- Reduction larger than the assessment: nil.
#ASSERT `How much unfair dismissal compensation would I get` 5000 8000 40000 42000 0 183100 EQUALS 0

§ `Part 6-4B -- bullying`

#ASSERT `Is it a constitutionally-covered business` `a trading or financial company` FALSE
#ASSERT NOT (`Is it a constitutionally-covered business` `a State government, sole trader, partnership or other` FALSE)
-- A sole trader in the ACT: conducted principally in a Territory.
#ASSERT `Is it a constitutionally-covered business` `a State government, sole trader, partnership or other` TRUE
#ASSERT `Is it a constitutionally-covered business` `the Commonwealth or a Commonwealth authority` FALSE
#ASSERT `Have I been bullied at work` TRUE TRUE TRUE FALSE
-- Reasonable management action carried out reasonably (s 789FD(2)).
#ASSERT NOT (`Have I been bullied at work` TRUE TRUE TRUE TRUE)
-- Not repeated.
#ASSERT NOT (`Have I been bullied at work` TRUE FALSE TRUE FALSE)
-- No risk to health and safety.
#ASSERT NOT (`Have I been bullied at work` TRUE TRUE FALSE FALSE)
#ASSERT `Can I apply for a stop bullying order` TRUE FALSE TRUE
-- A Defence Force member is not a worker for Part 6-4B (s 789FC(2)).
#ASSERT NOT (`Can I apply for a stop bullying order` TRUE TRUE TRUE)
-- Applied 1 May 2026: the FWC must start by 15 May.
#ASSERT `By when must the FWC start on my bullying application` (Date 1 5 2026) EQUALS Date 15 5 2026
#ASSERT `Can the FWC order the bullying to stop` TRUE TRUE TRUE
-- The bully has left the workplace: no risk of continuing, no order.
#ASSERT NOT (`Can the FWC order the bullying to stop` TRUE TRUE FALSE)

§ `Part 3-5A -- sexual harassment`

#ASSERT `Was I sexually harassed in breach of s 527D` `a worker in a business or undertaking` TRUE TRUE
#ASSERT `Was I sexually harassed in breach of s 527D` `seeking to become a worker in a particular business` TRUE TRUE
#ASSERT NOT (`Was I sexually harassed in breach of s 527D` `none of these` TRUE TRUE)
#ASSERT NOT (`Was I sexually harassed in breach of s 527D` `a worker in a business or undertaking` TRUE FALSE)
#ASSERT `Is the harasser's employer liable too` TRUE TRUE TRUE FALSE
-- The employer proves all reasonable steps (s 527E(2)).
#ASSERT NOT (`Is the harasser's employer liable too` TRUE TRUE TRUE TRUE)
#ASSERT `Can I ask for a stop sexual harassment order` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Can I ask for a stop sexual harassment order` TRUE TRUE EQUALS NOTHING
#ASSERT `Can I ask for a stop sexual harassment order` FALSE FALSE EQUALS JUST FALSE
-- Last incident 15 March 2024: 24 months after is 15 March 2026.
#ASSERT `By when should I apply about sexual harassment` (Date 15 3 2024) EQUALS Date 15 3 2026
#ASSERT NOT (`Can my sexual harassment application be dismissed as late` (Date 15 3 2024) (Date 15 3 2026))
#ASSERT `Can my sexual harassment application be dismissed as late` (Date 15 3 2024) (Date 16 3 2026)
-- 29 February 2024: 24 months after is taken as 28 February 2026 (no 29 February in 2026; NOTES.md finding 5).
#ASSERT `By when should I apply about sexual harassment` (Date 29 2 2024) EQUALS Date 28 2 2026
#ASSERT `Can the FWC order the sexual harassment to stop` TRUE TRUE TRUE
#ASSERT NOT (`Can the FWC order the sexual harassment to stop` FALSE TRUE TRUE)
#ASSERT `By when must the FWC start on my stop sexual harassment application` (Date 3 6 2026) EQUALS Date 17 6 2026
-- Certificate 1 July 2026: 60 days after is 30 August 2026.
#ASSERT `By when must we agree to arbitration of my sexual harassment dispute` (Date 1 7 2026) EQUALS Date 30 8 2026
#ASSERT `By when must I go to court about sexual harassment` (Date 1 7 2026) FALSE (Date 1 1 2026) EQUALS Date 30 8 2026
-- Removed, notice given 25 August: 14 days after is 8 September, later than 30 August.
#ASSERT `By when must I go to court about sexual harassment` (Date 1 7 2026) TRUE (Date 25 8 2026) EQUALS Date 8 9 2026
-- Removed, notice given 2 July: 16 July is earlier; the 60 days still run to 30 August.
#ASSERT `By when must I go to court about sexual harassment` (Date 1 7 2026) TRUE (Date 2 7 2026) EQUALS Date 30 8 2026
-- Arguments: certificate; its date; removed; notice date; filed; court allows; interim injunction; agreed to arbitration.
#ASSERT `Can I take my sexual harassment dispute to court` TRUE (Date 1 7 2026) FALSE (Date 1 1 2026) (Date 30 8 2026) FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Can I take my sexual harassment dispute to court` TRUE (Date 1 7 2026) FALSE (Date 1 1 2026) (Date 31 8 2026) FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Can I take my sexual harassment dispute to court` TRUE (Date 1 7 2026) TRUE (Date 25 8 2026) (Date 8 9 2026) FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Can I take my sexual harassment dispute to court` FALSE (Date 1 1 2026) FALSE (Date 1 1 2026) (Date 3 3 2026) FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Can I take my sexual harassment dispute to court` TRUE (Date 1 7 2026) FALSE (Date 1 1 2026) (Date 3 8 2026) FALSE FALSE TRUE EQUALS NOTHING
