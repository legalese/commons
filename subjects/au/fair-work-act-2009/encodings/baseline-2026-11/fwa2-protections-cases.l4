IMPORT prelude
IMPORT `fwa2-protections`

-- Cases for fwa2-protections.l4. Expected values worked by hand from the text (section cited). Edges: the 21st day and
-- the 22nd; the 14th day after the certificate and the 15th; an absence of exactly 3 months; a month end.

§ `s 341 -- workplace right`

#ASSERT NOT (`Do I have a workplace right` FALSE FALSE FALSE FALSE)
-- An employee who can complain about their employment (s 341(1)(c)(ii)), for example about unpaid overtime.
#ASSERT `Do I have a workplace right` FALSE FALSE FALSE TRUE
-- Entitled to a benefit under an award (s 341(1)(a)).
#ASSERT `Do I have a workplace right` TRUE FALSE FALSE FALSE

§ `s 342 -- adverse action`

-- Arguments: who I am; what they did; authorised by law; protected action stand down.
#ASSERT `Was it adverse action` `their employee` `dismissed me or ended my contract` FALSE FALSE
#ASSERT `Was it adverse action` `their employee` `altered my position to my prejudice` FALSE FALSE
-- Item 2 does not list dismissal for an applicant (there is nothing to dismiss).
#ASSERT NOT (`Was it adverse action` `someone applying to be their employee` `dismissed me or ended my contract` FALSE FALSE)
#ASSERT `Was it adverse action` `someone applying to be their employee` `refused to employ or engage me` FALSE FALSE
-- Item 3(e): refusing to supply goods or services to an engaged contractor.
#ASSERT `Was it adverse action` `an independent contractor they engaged` `refused to supply goods or services to me` FALSE FALSE
-- Item 1 does not list refusing to supply goods or services to an employee.
#ASSERT NOT (`Was it adverse action` `their employee` `refused to supply goods or services to me` FALSE FALSE)
#ASSERT `Was it adverse action` `an independent contractor they proposed to engage` `offered me worse terms than others` FALSE FALSE
#ASSERT NOT (`Was it adverse action` `their employee` `something else` FALSE FALSE)
-- Authorised by a Commonwealth law (s 342(3)): not adverse action.
#ASSERT NOT (`Was it adverse action` `their employee` `dismissed me or ended my contract` TRUE FALSE)
-- A stand down during protected action that the contract provides for (s 342(4)(a)).
#ASSERT NOT (`Was it adverse action` `their employee` `altered my position to my prejudice` FALSE TRUE)

§ `ss 340, 361 -- because of a workplace right`

-- Arguments: adverse; right; reason alleged; they prove otherwise; GAE offer; transfer of business.
-- A junior doctor who complained about unpaid overtime and lost a training rotation: presumed, not disproved.
#ASSERT `Did they break s 340` TRUE TRUE TRUE FALSE FALSE FALSE
-- The employer proves the complaint was not among its reasons (s 361).
#ASSERT NOT (`Did they break s 340` TRUE TRUE TRUE TRUE FALSE FALSE)
#ASSERT NOT (`Did they break s 340` TRUE FALSE TRUE FALSE FALSE FALSE)
#ASSERT NOT (`Did they break s 340` FALSE TRUE TRUE FALSE FALSE FALSE)
-- An offer conditional on a guarantee of annual earnings (s 341(4)).
#ASSERT NOT (`Did they break s 340` TRUE TRUE TRUE FALSE TRUE FALSE)

§ `s 351 -- discrimination`

-- Arguments: who I am; adverse; attribute; they prove otherwise; unlawful under an anti-discrimination law; inherent
-- requirements; religious institution.
#ASSERT `Did they break s 351` `their employee` TRUE `pregnancy` FALSE TRUE FALSE FALSE
#ASSERT `Did they break s 351` `someone applying to be their employee` TRUE `age` FALSE TRUE FALSE FALSE
-- A contractor is not an employee or prospective employee: s 351 does not reach.
#ASSERT NOT (`Did they break s 351` `an independent contractor they engaged` TRUE `pregnancy` FALSE TRUE FALSE FALSE)
#ASSERT NOT (`Did they break s 351` `their employee` TRUE `none of these` FALSE TRUE FALSE FALSE)
-- Inherent requirements of the position (s 351(2)(b)).
#ASSERT NOT (`Did they break s 351` `their employee` TRUE `physical or mental disability` FALSE TRUE TRUE FALSE)
-- Not unlawful under any anti-discrimination law where it happened (s 351(2)(a)).
#ASSERT NOT (`Did they break s 351` `their employee` TRUE `political opinion` FALSE FALSE FALSE FALSE)

§ `s 352, reg 3.01 -- off sick or injured`

-- Arguments: dismissed because absent; certificate in time; instrument terms followed; leave evidence; months this
-- absence; months in 12 months; on paid leave throughout; workers' compensation.
#ASSERT `Was I unlawfully dismissed for being off sick` TRUE TRUE FALSE FALSE 1 2 FALSE FALSE
-- No evidence given in any of the reg 3.01(2)-(4) ways: not a prescribed kind.
#ASSERT NOT (`Was I unlawfully dismissed for being off sick` TRUE FALSE FALSE FALSE 1 1 FALSE FALSE)
-- Absent 4 months, not on paid sick leave throughout: excluded (reg 3.01(5)).
#ASSERT NOT (`Was I unlawfully dismissed for being off sick` TRUE TRUE FALSE FALSE 4 4 FALSE FALSE)
-- Absent 4 months but on paid sick leave throughout: still prescribed.
#ASSERT `Was I unlawfully dismissed for being off sick` TRUE TRUE FALSE FALSE 4 4 TRUE FALSE
-- On "paid leave" while receiving workers' compensation: does not count (reg 3.01(6)), excluded.
#ASSERT NOT (`Was I unlawfully dismissed for being off sick` TRUE TRUE FALSE FALSE 4 4 TRUE TRUE)
-- Exactly 3 months, not on paid leave: not "more than 3 months", still prescribed.
#ASSERT `Was I unlawfully dismissed for being off sick` TRUE FALSE TRUE FALSE 3 3 FALSE FALSE
-- Total absences over the 12 months of 3.5 months, this absence 1 month, unpaid: excluded (reg 3.01(5)(a)(ii)).
#ASSERT NOT (`Was I unlawfully dismissed for being off sick` TRUE TRUE FALSE FALSE 1 3.5 FALSE FALSE)

§ `ss 357-359C -- sham arrangements`

#ASSERT `Did they break s 357` TRUE TRUE FALSE
-- The employer proves a reasonable belief (s 357(2)).
#ASSERT NOT (`Did they break s 357` TRUE TRUE TRUE)
-- In truth a contractor: no misrepresentation.
#ASSERT NOT (`Did they break s 357` FALSE TRUE FALSE)
#ASSERT `Was I dismissed to be re-engaged` TRUE TRUE TRUE
#ASSERT NOT (`Was I dismissed to be re-engaged` TRUE FALSE TRUE)
-- Arguments: employ(ed) me; new basis; employed other than as a casual; knew false; to persuade.
#ASSERT `Did they lie to change my basis` TRUE `an independent contractor` FALSE TRUE TRUE
-- Already a casual: s 359C reaches only someone employed other than as a casual.
#ASSERT NOT (`Did they lie to change my basis` TRUE `a casual employee` FALSE TRUE TRUE)
#ASSERT `Did they lie to change my basis` TRUE `a casual employee` TRUE TRUE TRUE
-- A statement not known to be false.
#ASSERT NOT (`Did they lie to change my basis` TRUE `an independent contractor` FALSE FALSE TRUE)

§ `ss 366-372 -- dismissal disputes`

-- Dismissal took effect 2 March 2026: the 21st day after is 23 March.
#ASSERT `By when must I apply about my general protections dismissal` (Date 2 3 2026) EQUALS Date 23 3 2026
-- Across a month end: 20 February 2026 + 21 days = 13 March 2026 (February 2026 has 28 days).
#ASSERT `By when must I apply about my general protections dismissal` (Date 20 2 2026) EQUALS Date 13 3 2026
#ASSERT `Is my general protections dismissal application in time` (Date 2 3 2026) (Date 23 3 2026) FALSE
#ASSERT NOT (`Is my general protections dismissal application in time` (Date 2 3 2026) (Date 24 3 2026) FALSE)
#ASSERT `Is my general protections dismissal application in time` (Date 2 3 2026) (Date 24 3 2026) TRUE
-- Certificate issued 10 April 2026: 14 days after is 24 April, for arbitration and for court.
#ASSERT `By when must we agree to arbitration of my dismissal dispute` (Date 10 4 2026) EQUALS Date 24 4 2026
#ASSERT `By when must I go to court about my dismissal` (Date 10 4 2026) EQUALS Date 24 4 2026
-- Arguments: certificate; its date; filed; court allows; interim injunction; agreed to arbitration.
#ASSERT `Can I take my dismissal dispute to court` TRUE (Date 10 4 2026) (Date 24 4 2026) FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Can I take my dismissal dispute to court` TRUE (Date 10 4 2026) (Date 25 4 2026) FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Can I take my dismissal dispute to court` TRUE (Date 10 4 2026) (Date 25 4 2026) TRUE FALSE FALSE EQUALS JUST TRUE
-- No certificate yet, but the application includes an interim injunction (s 370(b)).
#ASSERT `Can I take my dismissal dispute to court` FALSE (Date 1 1 2026) (Date 5 3 2026) FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Can I take my dismissal dispute to court` FALSE (Date 1 1 2026) (Date 5 3 2026) FALSE FALSE FALSE EQUALS JUST FALSE
-- Agreed to arbitration: ss 727, 728 not encoded.
#ASSERT `Can I take my dismissal dispute to court` TRUE (Date 10 4 2026) (Date 20 4 2026) FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `Can I ask the FWC about a non-dismissal dispute` TRUE FALSE
#ASSERT NOT (`Can I ask the FWC about a non-dismissal dispute` TRUE TRUE)
