§ `ss 12, 13 -- am I an employee`

-- c032: Chloe's internship pays $25 an hour, so it fails s 12(a); whether she is an employee is the s 15AA input.
#ASSERT NOT `Am I on a vocational placement` TRUE TRUE TRUE

#ASSERT `Am I a national system employee` TRUE TRUE FALSE

-- c020: Chloe at 15 in a supermarket.
#ASSERT `Am I a junior employee` 15

§ `ss 15P, 536KL-536KMA, 536LD, 536LU -- the platform worker`

-- k040: low bargaining power and low authority are ASSUMED for Jake; the scenario does not state them.
#ASSERT `Am I an employee-like worker` `Jake riding for the platform (k040)`
#ASSERT NOT `Am I an employee-like worker` `a rider with only low bargaining power`

-- k041: no super from the platform; can an order give it?
#ASSERT `Can an order give me this term` `superannuation` FALSE
#ASSERT NOT `Can an order give me this term` `overtime rates` TRUE
#ASSERT `Can an order give me this term` `penalty rates` TRUE
#ASSERT NOT `Can an order give me this term` `a term deeming me an employee` TRUE

-- Jake, HYPOTHETICAL: 8 months' regular riding, $40,000 a year, threshold unknown (0) -- the $175,000 floor answers it.
#ASSERT `Can I apply about an unfair deactivation` TRUE 8 40000 0 10
#ASSERT `Can I apply about an unfair deactivation` TRUE 8 180000 190000 10

§ `s 22 -- changing employer`

-- c056: Liam moves to Sparkies, not associated with his old employer: his service starts again.
#ASSERT NOT `Does my old service count` 0 FALSE FALSE
#ASSERT `Does my old service count` 2 TRUE FALSE

§ `ss 65, 65A -- flexible working`

-- c067: Chloe returns to Ironbark in March 2031 after 85 months (parental leave counts: s 22(4)).
#ASSERT `May I make a flexible working request` TRUE FALSE 85 FALSE TRUE
#ASSERT NOT `May I make a flexible working request` TRUE FALSE 11 FALSE TRUE

#ASSERT `How many days does my employer have to answer`  EQUALS 21

#ASSERT `May my employer refuse my request` TRUE TRUE FALSE TRUE TRUE
#ASSERT NOT `May my employer refuse my request` TRUE TRUE FALSE TRUE FALSE

§ `ss 67-84, reg 2.00 -- parental leave`

-- c061: Chloe (Ironbark since 5 Feb 2024) starts leave on 22 Aug 2030, two weeks before the due date, INFERRED as 5 Sep 2030.
#ASSERT `Am I entitled to unpaid parental leave` TRUE FALSE FALSE (Date 5 2 2024) (Date 5 9 2030) (Date 22 8 2030)

-- c063: Liam (Sparkies since 2 Sep 2029, INFERRED from c056) takes leave from the birth, 5 Sep 2030: 12 months and 3 days.
#ASSERT `Am I entitled to unpaid parental leave` TRUE FALSE FALSE (Date 2 9 2029) (Date 5 9 2030) (Date 5 9 2030)
#ASSERT NOT `Am I entitled to unpaid parental leave` TRUE FALSE FALSE (Date 2 10 2029) (Date 5 9 2030) (Date 5 9 2030)

#ASSERT `May my leave start that early` 2 FALSE

#ASSERT `May I take leave at the same time as the other parent` TRUE

#ASSERT `How many flexible days may I take` (Date 5 9 2030) EQUALS 130
#ASSERT `How many flexible days may I take` (Date 15 1 2024) EQUALS 100

#ASSERT `How many months of leave at most` 12 EQUALS 24

§ `ss 87-106A -- leave`

-- c042: Chloe, three months into a full-time salaried graduate job; d030: Daniel's graduate job at Swan & Partners
-- carries the same NES; c020: Chloe the casual gets no paid annual leave.
#ASSERT `How many weeks of annual leave a year` FALSE FALSE EQUALS 4
#ASSERT `How many weeks of annual leave a year` TRUE FALSE EQUALS 0

#ASSERT `How many days of personal leave a year` FALSE EQUALS 10

#ASSERT `How many weeks of annual leave accrued` FALSE FALSE 3 EQUALS 1

-- c072: Chloe leaves Ironbark with 76 untaken hours at a HYPOTHETICAL $40 base hourly rate.
#ASSERT `How much for untaken annual leave` 76 40 EQUALS 3040

#ASSERT `How many paid days of compassionate leave per occasion` FALSE EQUALS 2

#ASSERT `How many days of family and domestic violence leave`  EQUALS 10

§ `s 111 -- jury service`

-- c077: Chloe at Jarrah, HYPOTHETICAL $400 a day, 15 days, $300 jury pay for the first 10: 10 x 400 - 300.
#ASSERT `How much jury service pay from my employer` FALSE 15 400 300 TRUE TRUE EQUALS 3700
#ASSERT `How much jury service pay from my employer` FALSE 5 400 300 TRUE FALSE EQUALS 0

§ `ss 114-116 -- public holidays`

-- c042: Western Australia Day counts only because WA law declares it.
#ASSERT `Is this day a public holiday for me` `Western Australia Day` TRUE
#ASSERT NOT `Is this day a public holiday for me` `Melbourne Cup Day` FALSE

§ `s 116B -- superannuation`

-- c041 and d044: Chloe at $70,000, Daniel's first employees -- the SGAA charge would apply (an input from that Act).
#ASSERT `Must my employer pay my super` TRUE

§ `ss 117-123 -- notice and redundancy pay`

#ASSERT `How many weeks of notice must I get` `Jake made redundant at Sentinel at 49 after 21 years (k086)` EQUALS 5
#ASSERT `How many weeks of notice must I get` `Chloe resigns from Ironbark (c072)` EQUALS 0
#ASSERT `How many weeks of notice must I get` `Daniel resigns from Swan and Partners (d042)` EQUALS 0
#ASSERT `How many weeks of notice must I get` `a Jarrah employee of 9.5 years made redundant after the acquisition (d066)` EQUALS 4
#ASSERT `How many weeks of notice must I get` `an employee aged exactly 45` EQUALS 2
#ASSERT `How many weeks of notice must I get` `an employee aged 45 and a half` EQUALS 3

#ASSERT `How many weeks of redundancy pay do I get` `Jake made redundant at Sentinel at 49 after 21 years (k086)` EQUALS 12
#ASSERT `How many weeks of redundancy pay do I get` `a Jarrah employee of 9.5 years made redundant after the acquisition (d066)` EQUALS 16
#ASSERT `How many weeks of redundancy pay do I get` `one of Daniel's first employees made redundant at Jarrah of four (d044)` EQUALS 0
#ASSERT `How many weeks of redundancy pay do I get` `an employee of an insolvent employer` EQUALS 8

§ `s 45 -- modern awards`

-- k061: Jake's overtime paid at ordinary time under the Security Services award (the rate itself is an input);
-- k087: a Cleaning Services award minimum rate is enforced the same way.
#ASSERT `Has my employer contravened my award` TRUE TRUE

§ `ss 382-394, reg 2.13 -- unfair dismissal`

-- d044: Daniel's Jarrah has three employees; c040: Ironbark is large.
#ASSERT `How many months before I am protected` 4 EQUALS 12

-- c040: Chloe at $70,000, no award, threshold unknown (0): the $100,000 floor answers it. 'Probation' is not in the Act.
#ASSERT NOT `Am I protected from unfair dismissal` 3 200 FALSE FALSE 70000 0
#ASSERT `Am I protected from unfair dismissal` 7 200 FALSE FALSE 70000 0
#ASSERT NOT `Am I protected from unfair dismissal` 7 200 FALSE FALSE 120000 0

-- k060: Jake on the Security Services award is protected whatever he earns (s 382(b)(i)).
#ASSERT `Am I protected from unfair dismissal` 7 200 TRUE FALSE 120000 0

-- HYPOTHETICAL figures: 183,100 x (2000/1940 = 1.0309..., rounded 1.031) = 188,776.1, to the nearest $100 = 188,800.
#ASSERT `What is this year's high income threshold` 183100 2000 1940 EQUALS 188800

-- d066 / k086: the job went because the contract or business changed, consultation done, no redeployment.
#ASSERT `Was it a genuine redundancy` TRUE TRUE FALSE

#ASSERT `Was I unfairly dismissed` TRUE FALSE TRUE FALSE FALSE
#ASSERT NOT `Was I unfairly dismissed` TRUE FALSE TRUE FALSE TRUE

#ASSERT NOT `Am I in time to apply for unfair dismissal` 30 FALSE

-- HYPOTHETICAL: 26 weeks' pay of $100,000 against $150,000 (cap $75,000).
#ASSERT `What is the most compensation I can get` 100000 150000 EQUALS 75000

§ `s 530 -- Centrelink`

-- d066: twelve redundancies, so no Centrelink notice.
#ASSERT NOT `Must my employer tell Centrelink` 12 TRUE
#ASSERT `Must my employer tell Centrelink` 15 TRUE

§ `s 536, reg 3.46 -- pay slips`

#ASSERT NOT `Was my pay slip in time` 2

-- c041: Chloe is salaried ($70,000), Ironbark has an ABN, PAYG and HECS are withheld, super at 11% is paid.
#ASSERT `Is my pay slip complete` `Chloe's first Ironbark pay slip (c041)` TRUE TRUE FALSE TRUE TRUE
#ASSERT NOT `Is my pay slip complete` `Chloe's pay slip without the super line` TRUE TRUE FALSE TRUE TRUE

§ `ss 544, 545, 548 -- recovering an underpayment`

-- k061-k062: thirteen months of underpaid overtime, claimed about a year later; judgment for $4,100.
#ASSERT `Am I in time to claim` 1.1
#ASSERT NOT `Am I in time to claim` 7

#ASSERT `Can the court order my employer to pay` TRUE TRUE

#ASSERT `Can my claim be a small claim` 4100 TRUE
#ASSERT NOT `Can my claim be a small claim` 150000 TRUE

