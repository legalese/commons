§ `ss 12, 13, 15AA -- employee`

#ASSERT NOT `the placement is a vocational placement` TRUE TRUE TRUE
#ASSERT `the placement is a vocational placement` FALSE TRUE TRUE

#ASSERT `the individual is a national system employee` TRUE TRUE FALSE

#ASSERT `the employee is a junior employee` 15

