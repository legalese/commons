IMPORT prelude
IMPORT daydate
IMPORT `cipd-rules`

-- Independent tests, from independent-expectations.md (written before the
-- rules module was read). Expected values are the Act's, not the code's.

§ `Helpers`

-- Default suit: instituted 15 Jun 2026, served 22 Jun 2026, incapable.
GIVEN sat IS A LIST OF DATE
      prior IS A LIST OF DATE
GIVETH A `Suit`
`default suit with sittings` sat `and penalised` prior MEANS
    `Suit` OF TRUE, sat, Date 15 6 2026, Date 22 6 2026, prior

GIVEN sat IS A LIST OF DATE
GIVETH A NUMBER
`pay for sittings` sat MEANS
    `the sum I can be made to pay for` (`default suit with sittings` sat `and penalised` (LIST))

§ `Scenarios`

-- 1 not incapable
#ASSERT `the sum I can be made to pay for` (`Suit` OF FALSE, (LIST Date 1 6 2026), Date 15 6 2026, Date 22 6 2026, (LIST)) EQUALS 0
-- 2
#ASSERT `pay for sittings` (LIST Date 1 6 2026) EQUALS 200
-- 3 one sum for all pre-service sittings
#ASSERT `pay for sittings` (LIST Date 1 6 2026, Date 10 6 2026, Date 20 6 2026) EQUALS 200
-- 4 the service day itself is (a)
#ASSERT `pay for sittings` (LIST Date 22 6 2026) EQUALS 200
-- 5 the day after service only
#ASSERT `pay for sittings` (LIST Date 23 6 2026) EQUALS 200
-- 6
#ASSERT `pay for sittings` (LIST Date 1 6 2026, Date 22 6 2026, Date 23 6 2026, Date 24 6 2026) EQUALS 600
-- 7 exactly 12 months before institution: counts
#ASSERT `pay for sittings` (LIST Date 15 6 2025) EQUALS 200
-- 8 one day earlier: outside
#ASSERT `pay for sittings` (LIST Date 14 6 2025) EQUALS 0
-- 9
#ASSERT `pay for sittings` (LIST Date 14 6 2025, Date 23 6 2026) EQUALS 200
-- 10 instituted 29 Feb 2028: 28 Feb 2027 counts
#ASSERT `the sum I can be made to pay for` (`Suit` OF TRUE, (LIST Date 28 2 2027), Date 29 2 2028, Date 7 3 2028, (LIST)) EQUALS 200
-- 11 27 Feb 2027 does not
#ASSERT `the sum I can be made to pay for` (`Suit` OF TRUE, (LIST Date 27 2 2027), Date 29 2 2028, Date 7 3 2028, (LIST)) EQUALS 0
-- 12 a later day already penalised
#ASSERT `the sum I can be made to pay for` (`default suit with sittings` (LIST Date 1 6 2026, Date 23 6 2026, Date 24 6 2026) `and penalised` (LIST Date 23 6 2026)) EQUALS 400
-- 13 the only pre-service day already penalised: (a) not due
#ASSERT `the sum I can be made to pay for` (`default suit with sittings` (LIST Date 1 6 2026, Date 23 6 2026) `and penalised` (LIST Date 1 6 2026)) EQUALS 200
-- 14 the same day twice is one day
#ASSERT `pay for sittings` (LIST Date 23 6 2026, Date 23 6 2026) EQUALS 200
-- 15 order irrelevant
#ASSERT `pay for sittings` (LIST Date 24 6 2026, Date 1 6 2026, Date 23 6 2026) EQUALS 600
-- 16 no sittings
#ASSERT `pay for sittings` (LIST) EQUALS 0
-- 17 s 4
#ASSERT NOT (`the common informer position for` (`default suit with sittings` (LIST Date 1 6 2026) `and penalised` (LIST)))'s `I can be sued under s 46 of the Constitution`
#ASSERT `the common informer position for` (`default suit with sittings` (LIST Date 1 6 2026, Date 23 6 2026) `and penalised` (LIST)) EQUALS (`Common informer position` OF 400, FALSE)
