IMPORT prelude
IMPORT daydate
IMPORT `cdr-rules`

-- Independent tests: expected values from independent-expectations.md,
-- written from the source text before reading the rules.

GIVEN s IS A `My side`
      ct IS A `Court`
      civ IS A BOOLEAN
      k IS A `Kind of proceedings`
      prt IS A BOOLEAN
      fd IS A DATE
      cp IS A BOOLEAN
      hd IS A DATE
GIVETH A `Dispute position`
`pos` s ct civ k prt fd cp hd MEANS
    `the dispute position for` (`Dispute case` OF s, ct, civ, k, prt, fd, cp, hd)

-- 1
#ASSERT (`pos` `the applicant` `the Federal Court of Australia` TRUE `ordinary civil proceedings` FALSE (Date 1 3 2024) FALSE (Date 1 5 2024))'s `I must file a genuine steps statement` EQUALS TRUE
#ASSERT (`pos` `the applicant` `the Federal Court of Australia` TRUE `ordinary civil proceedings` FALSE (Date 1 3 2024) FALSE (Date 1 5 2024))'s `the last day to file it` EQUALS JUST (Date 1 3 2024)
#ASSERT (`pos` `the applicant` `the Federal Court of Australia` TRUE `ordinary civil proceedings` FALSE (Date 1 3 2024) FALSE (Date 1 5 2024))'s `it may leave out the excluded parts` EQUALS FALSE
-- 2
#ASSERT (`pos` `the applicant` `the Federal Circuit and Family Court of Australia (Division 2)` TRUE `ordinary civil proceedings` FALSE (Date 1 3 2024) FALSE (Date 1 5 2024))'s `the last day to file it` EQUALS JUST (Date 1 3 2024)
-- 3
#ASSERT (`pos` `the applicant` `another court` TRUE `ordinary civil proceedings` FALSE (Date 1 3 2024) FALSE (Date 1 5 2024))'s `I must file a genuine steps statement` EQUALS FALSE
#ASSERT (`pos` `the applicant` `another court` TRUE `ordinary civil proceedings` FALSE (Date 1 3 2024) FALSE (Date 1 5 2024))'s `the last day to file it` EQUALS NOTHING
-- 4
#ASSERT (`pos` `the applicant` `the Federal Court of Australia` FALSE `ordinary civil proceedings` FALSE (Date 1 3 2024) FALSE (Date 1 5 2024))'s `I must file a genuine steps statement` EQUALS FALSE
-- 5
#ASSERT (`pos` `the applicant` `the Federal Court of Australia` TRUE `ex parte` FALSE (Date 1 3 2024) FALSE (Date 1 5 2024))'s `I must file a genuine steps statement` EQUALS FALSE
-- 6
#ASSERT (`pos` `the applicant` `the Federal Court of Australia` TRUE `under a listed Act, such as the Fair Work, Family Law or Migration Act` FALSE (Date 1 3 2024) FALSE (Date 1 5 2024))'s `I must file a genuine steps statement` EQUALS FALSE
-- 7
#ASSERT (`pos` `the applicant` `the Federal Court of Australia` TRUE `in the appellate jurisdiction` FALSE (Date 1 3 2024) FALSE (Date 1 5 2024))'s `I must file a genuine steps statement` EQUALS FALSE
-- 8
#ASSERT (`pos` `the applicant` `the Federal Court of Australia` TRUE `for a pecuniary penalty for a civil penalty provision` TRUE (Date 1 3 2024) FALSE (Date 1 5 2024))'s `I must file a genuine steps statement` EQUALS TRUE
#ASSERT (`pos` `the applicant` `the Federal Court of Australia` TRUE `for a pecuniary penalty for a civil penalty provision` TRUE (Date 1 3 2024) FALSE (Date 1 5 2024))'s `it may leave out the excluded parts` EQUALS TRUE
-- 9: before commencement of Part 2
#ASSERT (`pos` `the applicant` `the Federal Court of Australia` TRUE `ordinary civil proceedings` FALSE (Date 31 7 2011) FALSE (Date 1 9 2011))'s `I must file a genuine steps statement` EQUALS FALSE
-- 10: on commencement
#ASSERT (`pos` `the applicant` `the Federal Court of Australia` TRUE `ordinary civil proceedings` FALSE (Date 1 8 2011) FALSE (Date 1 9 2011))'s `I must file a genuine steps statement` EQUALS TRUE
-- 11
#ASSERT (`pos` `the respondent` `the Federal Court of Australia` TRUE `ordinary civil proceedings` FALSE (Date 1 3 2024) TRUE (Date 15 4 2024))'s `I must file a genuine steps statement` EQUALS TRUE
#ASSERT (`pos` `the respondent` `the Federal Court of Australia` TRUE `ordinary civil proceedings` FALSE (Date 1 3 2024) TRUE (Date 15 4 2024))'s `the last day to file it` EQUALS JUST (Date 14 4 2024)
-- 12
#ASSERT (`pos` `the respondent` `the Federal Court of Australia` TRUE `ordinary civil proceedings` FALSE (Date 1 3 2024) FALSE (Date 15 4 2024))'s `I must file a genuine steps statement` EQUALS FALSE
-- 13
#ASSERT (`pos` `the respondent` `the Federal Court of Australia` TRUE `ordinary civil proceedings` FALSE (Date 1 3 2024) TRUE (Date 1 1 2025))'s `the last day to file it` EQUALS JUST (Date 31 12 2024)
-- 14
#ASSERT (`pos` `the respondent` `the Federal Court of Australia` TRUE `ordinary civil proceedings` FALSE (Date 1 1 2024) TRUE (Date 1 3 2024))'s `the last day to file it` EQUALS JUST (Date 29 2 2024)
-- 15
#ASSERT (`pos` `the applicant` `the Federal Court of Australia` TRUE `ordinary civil proceedings` FALSE (Date 1 3 2024) FALSE (Date 1 5 2024))'s `not filing invalidates the proceedings` EQUALS FALSE
#ASSERT (`pos` `the respondent` `the Federal Court of Australia` TRUE `ordinary civil proceedings` FALSE (Date 1 3 2024) TRUE (Date 15 4 2024))'s `not filing invalidates the proceedings` EQUALS FALSE
-- 16
#ASSERT (`pos` `the applicant` `the Federal Court of Australia` TRUE `ordinary civil proceedings` FALSE (Date 1 3 2024) FALSE (Date 1 5 2024))'s `the court may weigh my steps and statement, including on costs` EQUALS TRUE
-- 17
#ASSERT (`pos` `the applicant` `another court` TRUE `ordinary civil proceedings` FALSE (Date 1 3 2024) FALSE (Date 1 5 2024))'s `the court may weigh my steps and statement, including on costs` EQUALS FALSE
-- 18
#ASSERT (`pos` `the applicant` `the Federal Court of Australia` TRUE `ex parte` FALSE (Date 1 3 2024) FALSE (Date 1 5 2024))'s `the court may weigh my steps and statement, including on costs` EQUALS FALSE
-- 19 (low confidence): respondent given a copy in wholly excluded proceedings
#ASSERT (`pos` `the respondent` `the Federal Court of Australia` TRUE `ex parte` FALSE (Date 1 3 2024) TRUE (Date 15 4 2024))'s `I must file a genuine steps statement` EQUALS TRUE
