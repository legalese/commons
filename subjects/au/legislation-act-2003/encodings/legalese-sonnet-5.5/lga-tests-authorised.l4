IMPORT prelude
IMPORT `lga-authorised`

-- Tests of lga-authorised.l4 (Chapter 2 Part 3, sections 15Z to 15ZB).
-- Every expected value is written by hand from the text; the provision and the reading are named beside each group.


§§ `s 15Z: scope (text lines 632 to 636)`

#ASSERT `s 15Z: this Part applies in relation to the document` `a registered Act` EQUALS JUST TRUE
#ASSERT `s 15Z: this Part applies in relation to the document` `a registered legislative instrument or notifiable instrument` EQUALS JUST TRUE
#ASSERT `s 15Z: this Part applies in relation to the document` `a registered explanatory statement for a legislative instrument` EQUALS JUST TRUE
#ASSERT `s 15Z: this Part applies in relation to the document` `a registered compilation of an Act, legislative instrument or notifiable instrument` EQUALS JUST TRUE
#ASSERT `s 15Z: this Part applies in relation to the document` `any other document for section 15Z` EQUALS NOTHING

