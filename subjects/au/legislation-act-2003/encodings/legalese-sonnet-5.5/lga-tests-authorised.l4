§§ `s 15ZB: judicial notice (text lines 671 to 683)`

#ASSERT `s 15ZB(1): proof is not required about the matter` TRUE `(a): the assent, and the day of assent, of an Act` EQUALS JUST TRUE
#ASSERT `s 15ZB(1): proof is not required about the matter` FALSE `(a): the assent, and the day of assent, of an Act` EQUALS NOTHING
#ASSERT `s 15ZB(1): proof is not required about the matter` TRUE `(b): the making, and the day of making, of a registered legislative instrument or notifiable instrument` EQUALS JUST TRUE
#ASSERT `s 15ZB(1): proof is not required about the matter` FALSE `(b): the making, and the day of making, of a registered legislative instrument or notifiable instrument` EQUALS NOTHING
#ASSERT `s 15ZB(1): proof is not required about the matter` TRUE `(c): the text of a registered law or explanatory statement` EQUALS JUST TRUE
#ASSERT `s 15ZB(1): proof is not required about the matter` FALSE `(c): the text of a registered law or explanatory statement` EQUALS NOTHING
#ASSERT `s 15ZB(1): proof is not required about the matter` TRUE `(d): the registration, and day of registration, of a registered law or explanatory statement` EQUALS JUST TRUE
#ASSERT `s 15ZB(1): proof is not required about the matter` FALSE `(d): the registration, and day of registration, of a registered law or explanatory statement` EQUALS NOTHING
#ASSERT `s 15ZB(1): proof is not required about the matter` TRUE `(e): the commencement of a registered Act, legislative instrument or notifiable instrument, or any provision of one` EQUALS JUST TRUE
#ASSERT `s 15ZB(1): proof is not required about the matter` FALSE `(e): the commencement of a registered Act, legislative instrument or notifiable instrument, or any provision of one` EQUALS NOTHING
#ASSERT `s 15ZB(1): proof is not required about the matter` TRUE `(f): editorial changes made in preparing a registered compilation` EQUALS JUST TRUE
#ASSERT `s 15ZB(1): proof is not required about the matter` FALSE `(f): editorial changes made in preparing a registered compilation` EQUALS NOTHING
#ASSERT `s 15ZB(1): proof is not required about the matter` TRUE `(g): the text and compilation date of a registered compilation` EQUALS JUST TRUE
#ASSERT `s 15ZB(1): proof is not required about the matter` FALSE `(g): the text and compilation date of a registered compilation` EQUALS NOTHING
#ASSERT `s 15ZB(1): proof is not required about the matter` TRUE `(h): whether a copy of a registered law or explanatory statement is an authorised version` EQUALS JUST TRUE
#ASSERT `s 15ZB(1): proof is not required about the matter` FALSE `(h): whether a copy of a registered law or explanatory statement is an authorised version` EQUALS NOTHING
#ASSERT `s 15ZB(1): proof is not required about the matter` TRUE `any other matter` EQUALS NOTHING
#ASSERT `s 15ZB(1): proof is not required about the matter` FALSE `any other matter` EQUALS NOTHING
#ASSERT `s 15ZB(2): the court or tribunal may inform itself in that way` TRUE EQUALS JUST TRUE
#ASSERT `s 15ZB(2): the court or tribunal may inform itself in that way` FALSE EQUALS NOTHING
#ASSERT `s 15ZB(3): the court or tribunal must consider whether the source appears to be a reliable source of information` TRUE EQUALS JUST TRUE
#ASSERT `s 15ZB(3): the court or tribunal must consider whether the source appears to be a reliable source of information` FALSE EQUALS NOTHING
#ASSERT `s 15ZB(4): the authorised version is a reliable source of information` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 15ZB(4): the authorised version is a reliable source of information` TRUE TRUE EQUALS NOTHING
#ASSERT `s 15ZB(4): the authorised version is a reliable source of information` FALSE FALSE EQUALS NOTHING
#ASSERT `s 15ZB(4): the authorised version is a reliable source of information` FALSE TRUE EQUALS NOTHING
#ASSERT `s 15ZB(5): this section limits the other law` TRUE EQUALS JUST FALSE
#ASSERT `s 15ZB(5): this section limits the other law` FALSE EQUALS NOTHING
