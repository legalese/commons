IMPORT prelude
IMPORT `lga-defs`

-- Tests of lga-defs.l4 (sections 4, 5, 6 and 8 to 11).
-- Every expected value is written by hand from the text; the provision and the reading are named beside each group.


§§ `s 4: commencement instrument (text lines 75 to 77: "solely")`

-- Provides solely for the commencement of the Act or instrument: yes. Of a provision of it: yes. Also for something else: no. Neither: no ("means").
#ASSERT `s 4: the instrument is a commencement instrument` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 4: the instrument is a commencement instrument` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 4: the instrument is a commencement instrument` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 4: the instrument is a commencement instrument` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 4: the instrument is a commencement instrument` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 4: the instrument is a commencement instrument` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 4: the instrument is a commencement instrument` FALSE FALSE TRUE EQUALS JUST FALSE

§§ `s 4: compilation (text lines 79 to 82)`

#ASSERT `s 4: the document is a compilation` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 4: the document is a compilation` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 4: the document is a compilation` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 4: the document is a compilation` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 4: the document is a compilation` FALSE FALSE FALSE EQUALS JUST FALSE

§§ `s 4: primary law, enabling legislation (text lines 106 and 89)`

#ASSERT `s 4: the law is a primary law` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 4: the law is a primary law` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 4: the law is a primary law` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 4: the law is a primary law` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 4: the law is the enabling legislation for the instrument` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 4: the law is the enabling legislation for the instrument` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 4: the law is the enabling legislation for the instrument` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 4: the law is the enabling legislation for the instrument` FALSE FALSE EQUALS JUST FALSE

§§ `s 4: instrument, making (text lines 94 and 97)`

#ASSERT `s 4: the thing is an instrument` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 4: the thing is an instrument` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 4: the thing is an instrument` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 4: the thing is an instrument` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 4: the act is the making of the instrument` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 4: the act is the making of the instrument` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 4: the act is the making of the instrument` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 4: the act is the making of the instrument` FALSE FALSE EQUALS JUST FALSE

§§ `s 4: repeal "includes" revoke or rescind (text lines 109 and 110)`

-- Repeal, revoke and rescind are named; omit is not named, so it is not covered.
#ASSERT `s 4: the way of ending a provision is a repeal` repeal EQUALS JUST TRUE
#ASSERT `s 4: the way of ending a provision is a repeal` revoke EQUALS JUST TRUE
#ASSERT `s 4: the way of ending a provision is a repeal` rescind EQUALS JUST TRUE
#ASSERT `s 4: the way of ending a provision is a repeal` omit EQUALS NOTHING

§§ `s 4: power delegated by the Parliament "includes" (text lines 102 to 104), text "includes any writing" (118)`

#ASSERT `s 4: the instrument is made under a power delegated by the Parliament` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 4: the instrument is made under a power delegated by the Parliament` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 4: the instrument is made under a power delegated by the Parliament` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 4: the instrument is made under a power delegated by the Parliament` FALSE FALSE EQUALS NOTHING
#ASSERT `s 4: the thing is text` TRUE EQUALS JUST TRUE
#ASSERT `s 4: the thing is text` FALSE EQUALS NOTHING

§§ `s 4: terms that point at another Act or at section 15A or 61A (text lines 92, 101, 91, 107, 115)`

#ASSERT `s 4: the person is the First Parliamentary Counsel` TRUE EQUALS JUST TRUE
#ASSERT `s 4: the person is the First Parliamentary Counsel` FALSE EQUALS JUST FALSE
#ASSERT `s 4: the office is the Office of Parliamentary Counsel` TRUE EQUALS JUST TRUE
#ASSERT `s 4: the office is the Office of Parliamentary Counsel` FALSE EQUALS JUST FALSE
#ASSERT `s 4: the register is the Federal Register of Legislation` TRUE EQUALS JUST TRUE
#ASSERT `s 4: the register is the Federal Register of Legislation` FALSE EQUALS JUST FALSE
#ASSERT `s 4: to register is to register on the Federal Register of Legislation` TRUE EQUALS JUST TRUE
#ASSERT `s 4: to register is to register on the Federal Register of Legislation` FALSE EQUALS JUST FALSE
#ASSERT `s 4: the instrument is the rules` TRUE EQUALS JUST TRUE
#ASSERT `s 4: the instrument is the rules` FALSE EQUALS JUST FALSE

§§ `s 5(1): amend includes (text lines 121 to 130); s 5(2): modify (133)`

#ASSERT `s 5(1): the change is an amendment` `repeal or omit it, or a part of it` EQUALS JUST TRUE
#ASSERT `s 5(1): the change is an amendment` `substitute another provision for it, or a part of it` EQUALS JUST TRUE
#ASSERT `s 5(1): the change is an amendment` `insert another provision into it, or a part of it` EQUALS JUST TRUE
#ASSERT `s 5(1): the change is an amendment` `renumber it, or a part of it` EQUALS JUST TRUE
#ASSERT `s 5(1): the change is an amendment` `relocate it, or a part of it` EQUALS JUST TRUE
#ASSERT `s 5(1): the change is an amendment` `amend it by implication` EQUALS JUST TRUE
#ASSERT `s 5(1): the change is an amendment` `change its text in any other way` EQUALS JUST TRUE
#ASSERT `s 5(1): the change is an amendment` `a change that leaves its text as it is` EQUALS NOTHING
#ASSERT `s 5(2): the change is a modification` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 5(2): the change is a modification` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 5(2): the change is a modification` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 5(2): the change is a modification` FALSE TRUE EQUALS JUST FALSE

§§ `s 6: rule-maker and responsible person (text lines 135 to 146)`

#ASSERT `s 6(1): the rule-maker for the instrument` `made by the Governor-General under enabling legislation` EQUALS `the Minister currently responsible for administering the provision of the enabling legislation under which the instrument is made`
#ASSERT `s 6(1): the rule-maker for the instrument` `made by the Governor-General in any other case` EQUALS `the Prime Minister, or a Minister prescribed by regulation for the purposes of paragraph 6(1)(b)`
#ASSERT `s 6(1): the rule-maker for the instrument` `made by a person other than the Governor-General` EQUALS `a person currently authorised to make the instrument`
#ASSERT `s 6(2): the responsible person` `an Act or a provision of an Act` EQUALS `the Minister currently responsible for administering the Act or provision`
#ASSERT `s 6(2): the responsible person` `an instrument` EQUALS `the rule-maker for the instrument`
-- One Minister: the subsection does not apply. Two or more: each is a responsible person.
#ASSERT NOT `s 6(3)(a): each of those Ministers is a responsible person` 0
#ASSERT NOT `s 6(3)(a): each of those Ministers is a responsible person` 1
#ASSERT `s 6(3)(a): each of those Ministers is a responsible person` 2
#ASSERT `s 6(3)(a): each of those Ministers is a responsible person` 3
#ASSERT `s 6(3)(b): the performance of a function or duty by any of the Ministers discharges it` 1 1 EQUALS JUST FALSE
#ASSERT `s 6(3)(b): the performance of a function or duty by any of the Ministers discharges it` 2 1 EQUALS JUST TRUE
#ASSERT `s 6(3)(b): the performance of a function or duty by any of the Ministers discharges it` 2 0 EQUALS NOTHING
#ASSERT `s 6(3)(b): the performance of a function or duty by any of the Ministers discharges it` 3 3 EQUALS JUST TRUE
#ASSERT `s 6(3)(b): the performance of a function or duty by any of the Ministers discharges it` 1 0 EQUALS JUST FALSE

§§ `s 8: legislative instrument (text lines 166 to 199)`

-- ruler: (2) done by LI; delegated power; registered as LI; (4)(b)(i); (4)(b)(ii); declared by s 10 or 57A; (6)(a) declared not; (6)(b) prescribed; (8)(a); (8)(b); (8)(c); (8)(d); (8)(e)
-- (2) alone
#ASSERT `s 8: the instrument is a legislative instrument` (`Facts about an instrument for section 8` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST TRUE
-- (3): registered, made under delegated power
#ASSERT `s 8: the instrument is a legislative instrument` (`Facts about an instrument for section 8` OF FALSE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST TRUE
-- (3) and (6)(a): (7) keeps (6) away from registration under (3)
#ASSERT `s 8: the instrument is a legislative instrument` (`Facts about an instrument for section 8` OF FALSE, TRUE, TRUE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST TRUE
-- (3) and (6)(b)
#ASSERT `s 8: the instrument is a legislative instrument` (`Facts about an instrument for section 8` OF FALSE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST TRUE
-- (2) and (6)(a): (6) is "despite subsections (4) and (5)" only
#ASSERT `s 8: the instrument is a legislative instrument` (`Facts about an instrument for section 8` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST TRUE
-- (4) both limbs, delegated power
#ASSERT `s 8: the instrument is a legislative instrument` (`Facts about an instrument for section 8` OF FALSE, TRUE, FALSE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST TRUE
-- (4) first limb only
#ASSERT `s 8: the instrument is a legislative instrument` (`Facts about an instrument for section 8` OF FALSE, TRUE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST FALSE
-- (4) second limb only
#ASSERT `s 8: the instrument is a legislative instrument` (`Facts about an instrument for section 8` OF FALSE, TRUE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST FALSE
-- (4) limbs but not made under delegated power
#ASSERT `s 8: the instrument is a legislative instrument` (`Facts about an instrument for section 8` OF FALSE, FALSE, FALSE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST FALSE
-- (4) and (6)(a)
#ASSERT `s 8: the instrument is a legislative instrument` (`Facts about an instrument for section 8` OF FALSE, TRUE, FALSE, TRUE, TRUE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST FALSE
-- (4) and (6)(b)
#ASSERT `s 8: the instrument is a legislative instrument` (`Facts about an instrument for section 8` OF FALSE, TRUE, FALSE, TRUE, TRUE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST FALSE
-- (5) declared
#ASSERT `s 8: the instrument is a legislative instrument` (`Facts about an instrument for section 8` OF FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST TRUE
-- (5) and (6)(a)
#ASSERT `s 8: the instrument is a legislative instrument` (`Facts about an instrument for section 8` OF FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST FALSE
-- (5) and (6)(b)
#ASSERT `s 8: the instrument is a legislative instrument` (`Facts about an instrument for section 8` OF FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST FALSE
-- none of (2) to (5)
#ASSERT `s 8: the instrument is a legislative instrument` (`Facts about an instrument for section 8` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST FALSE
-- (3) and (8)(a): a notifiable instrument under 11(1)
#ASSERT `s 8: the instrument is a legislative instrument` (`Facts about an instrument for section 8` OF FALSE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST FALSE
-- (3) and (8)(b): a commencement instrument
#ASSERT `s 8: the instrument is a legislative instrument` (`Facts about an instrument for section 8` OF FALSE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE) EQUALS JUST FALSE
-- (3) and (8)(c): a compilation
#ASSERT `s 8: the instrument is a legislative instrument` (`Facts about an instrument for section 8` OF FALSE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE) EQUALS JUST FALSE
-- (3) and (8)(d): rules of court
#ASSERT `s 8: the instrument is a legislative instrument` (`Facts about an instrument for section 8` OF FALSE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE) EQUALS JUST FALSE
-- (3) and (8)(e): an explanatory statement
#ASSERT `s 8: the instrument is a legislative instrument` (`Facts about an instrument for section 8` OF FALSE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE) EQUALS JUST FALSE
-- (2) and (8)(a)
#ASSERT `s 8: the instrument is a legislative instrument` (`Facts about an instrument for section 8` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST FALSE
-- The limbs one by one.
#ASSERT `s 8(2): a primary law provides for the thing to be done by legislative instrument, and it is done` (`Facts about an instrument for section 8` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)
#ASSERT NOT `s 8(2): a primary law provides for the thing to be done by legislative instrument, and it is done` (`Facts about an instrument for section 8` OF FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE)
#ASSERT `s 8(3): the instrument is made under a power delegated by the Parliament and registered as a legislative instrument` (`Facts about an instrument for section 8` OF FALSE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)
#ASSERT NOT `s 8(3): the instrument is made under a power delegated by the Parliament and registered as a legislative instrument` (`Facts about an instrument for section 8` OF FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)
#ASSERT NOT `s 8(3): the instrument is made under a power delegated by the Parliament and registered as a legislative instrument` (`Facts about an instrument for section 8` OF FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)
#ASSERT `s 8(4): the instrument determines or alters the law and affects rights or obligations` (`Facts about an instrument for section 8` OF FALSE, TRUE, FALSE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)
#ASSERT NOT `s 8(4): the instrument determines or alters the law and affects rights or obligations` (`Facts about an instrument for section 8` OF FALSE, TRUE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)
#ASSERT `s 8(5): the instrument is declared by section 10 or 57A to be a legislative instrument` (`Facts about an instrument for section 8` OF FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)
#ASSERT NOT `s 8(5): the instrument is declared by section 10 or 57A to be a legislative instrument` (`Facts about an instrument for section 8` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)
#ASSERT `s 8(6): the instrument is declared or prescribed not to be a legislative instrument` (`Facts about an instrument for section 8` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)
#ASSERT `s 8(6): the instrument is declared or prescribed not to be a legislative instrument` (`Facts about an instrument for section 8` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE)
#ASSERT NOT `s 8(6): the instrument is declared or prescribed not to be a legislative instrument` (`Facts about an instrument for section 8` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)
#ASSERT NOT `s 8(8): the instrument cannot be a legislative instrument` (`Facts about an instrument for section 8` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE)

§§ `s 9: no inference of legislative character (text lines 202 to 206)`

#ASSERT `s 9(1): being a legislative instrument under subsection 8(2), (3) or (5) implies that the instrument is of legislative character` TRUE EQUALS JUST FALSE
#ASSERT `s 9(1): being a legislative instrument under subsection 8(2), (3) or (5) implies that the instrument is of legislative character` FALSE EQUALS NOTHING
#ASSERT `s 9(2): not being a legislative instrument under subsection 8(6) implies that the instrument is not of legislative character` TRUE EQUALS JUST FALSE
#ASSERT `s 9(2): not being a legislative instrument under subsection 8(6) implies that the instrument is not of legislative character` FALSE EQUALS NOTHING
#ASSERT `s 9(3): an inference may be drawn from the status of an instrument made under another provision of the primary law or any other primary law` TRUE EQUALS JUST FALSE
#ASSERT `s 9(3): an inference may be drawn from the status of an instrument made under another provision of the primary law or any other primary law` FALSE EQUALS NOTHING

§§ `s 10: instruments declared to be legislative instruments (text lines 209 to 217)`

#ASSERT `s 10(2): the Territory Ordinance is covered by this subsection` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 10(2): the Territory Ordinance is covered by this subsection` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 10(2): the Territory Ordinance is covered by this subsection` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 10(2): the Territory Ordinance is covered by this subsection` FALSE FALSE EQUALS NOTHING
-- (a) a regulation or Proclamation, but not a Proclamation that is a commencement instrument; (b) a covered Territory Ordinance; (c) prescribed; (d) amends or repeals another legislative instrument.
#ASSERT `s 10(1): section 10 declares the instrument to be a legislative instrument` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 10(1): section 10 declares the instrument to be a legislative instrument` TRUE TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 10(1): section 10 declares the instrument to be a legislative instrument` FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 10(1): section 10 declares the instrument to be a legislative instrument` FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 10(1): section 10 declares the instrument to be a legislative instrument` FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 10(1): section 10 declares the instrument to be a legislative instrument` FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 10(1): section 10 declares the instrument to be a legislative instrument` TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE

§§ `s 11: notifiable instrument (text lines 220 to 238)`

-- ruler: (1) done by NI; (2)(a) commencement instrument; is a legislative instrument; (2)(b) prescribed; (2)(c) registered as NI under delegated or other power; (2)(d) amends or repeals another NI
-- (1) alone
#ASSERT `s 11: the instrument is a notifiable instrument` (`Facts about an instrument for section 11` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST TRUE
-- (2)(a) commencement instrument
#ASSERT `s 11: the instrument is a notifiable instrument` (`Facts about an instrument for section 11` OF FALSE, TRUE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST TRUE
-- (2)(a) commencement instrument that is also a legislative instrument: (a) has no "other than" limit
#ASSERT `s 11: the instrument is a notifiable instrument` (`Facts about an instrument for section 11` OF FALSE, TRUE, TRUE, FALSE, FALSE, FALSE) EQUALS JUST TRUE
-- (2)(b) prescribed, not a legislative instrument
#ASSERT `s 11: the instrument is a notifiable instrument` (`Facts about an instrument for section 11` OF FALSE, FALSE, FALSE, TRUE, FALSE, FALSE) EQUALS JUST TRUE
-- (2)(b) prescribed, but a legislative instrument
#ASSERT `s 11: the instrument is a notifiable instrument` (`Facts about an instrument for section 11` OF FALSE, FALSE, TRUE, TRUE, FALSE, FALSE) EQUALS NOTHING
-- (2)(c) registered as a notifiable instrument, not a legislative instrument
#ASSERT `s 11: the instrument is a notifiable instrument` (`Facts about an instrument for section 11` OF FALSE, FALSE, FALSE, FALSE, TRUE, FALSE) EQUALS JUST TRUE
-- (2)(c) but a legislative instrument
#ASSERT `s 11: the instrument is a notifiable instrument` (`Facts about an instrument for section 11` OF FALSE, FALSE, TRUE, FALSE, TRUE, FALSE) EQUALS NOTHING
-- (2)(d) amends another notifiable instrument
#ASSERT `s 11: the instrument is a notifiable instrument` (`Facts about an instrument for section 11` OF FALSE, FALSE, FALSE, FALSE, FALSE, TRUE) EQUALS JUST TRUE
-- (2)(d) but a legislative instrument
#ASSERT `s 11: the instrument is a notifiable instrument` (`Facts about an instrument for section 11` OF FALSE, FALSE, TRUE, FALSE, FALSE, TRUE) EQUALS NOTHING
-- none
#ASSERT `s 11: the instrument is a notifiable instrument` (`Facts about an instrument for section 11` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS NOTHING
#ASSERT `s 11(1): a primary law provides for the thing to be done by notifiable instrument, and it is done` (`Facts about an instrument for section 11` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE)
#ASSERT NOT `s 11(1): a primary law provides for the thing to be done by notifiable instrument, and it is done` (`Facts about an instrument for section 11` OF FALSE, TRUE, FALSE, FALSE, FALSE, FALSE)
#ASSERT `s 11(2): the instrument is one that subsection (2) lists as a notifiable instrument` (`Facts about an instrument for section 11` OF FALSE, TRUE, FALSE, FALSE, FALSE, FALSE)
#ASSERT NOT `s 11(2): the instrument is one that subsection (2) lists as a notifiable instrument` (`Facts about an instrument for section 11` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE)
#ASSERT `s 11(3): the enabling legislation or a regulation under this Act may modify the operation of this Act in relation to the instrument` TRUE EQUALS JUST TRUE
#ASSERT `s 11(3): the enabling legislation or a regulation under this Act may modify the operation of this Act in relation to the instrument` FALSE EQUALS NOTHING
#ASSERT `s 11(4): the requirement to publish or notify is taken to be satisfied` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 11(4): the requirement to publish or notify is taken to be satisfied` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 11(4): the requirement to publish or notify is taken to be satisfied` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 11(4): the requirement to publish or notify is taken to be satisfied` FALSE TRUE FALSE EQUALS JUST FALSE
-- (7): a legislative instrument by registration under (3) is not displaced by (6); the s 8 rule above reaches (3) before (6), so the two agree.
#ASSERT `s 8(7): subsection (6) applies to the instrument` TRUE EQUALS JUST FALSE
#ASSERT `s 8(7): subsection (6) applies to the instrument` FALSE EQUALS NOTHING
