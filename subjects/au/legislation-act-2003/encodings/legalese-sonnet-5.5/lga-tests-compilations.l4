§§ `ss 15R and 15S: lodging a compilation (text lines 508 to 522)`

#ASSERT `s 15R(1): the rule-maker must prepare and lodge a compilation of the instrument for registration` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 15R(1): the rule-maker must prepare and lodge a compilation of the instrument for registration` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 15R(1): the rule-maker must prepare and lodge a compilation of the instrument for registration` FALSE FALSE EQUALS NOTHING
