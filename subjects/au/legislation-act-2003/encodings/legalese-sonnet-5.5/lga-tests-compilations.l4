#ASSERT `s 15R(2): the compilation date for the compilation` TRUE (Date 10 3 2026) EQUALS JUST (Date 10 3 2026)
#ASSERT `s 15R(2): the compilation date for the compilation` FALSE (Date 10 3 2026) EQUALS NOTHING
#ASSERT `s 15R(4): section 15R applies` TRUE EQUALS JUST FALSE
#ASSERT `s 15R(4): section 15R applies` FALSE EQUALS NOTHING
-- arguments: day of the event; day lodged; a longer period allowed; last day of the longer period. The event is on 10 March 2026, so the 28 days end on 7 April 2026.
#ASSERT `s 15R(3): the compilation is lodged in time` (Date 10 3 2026) (Date 7 4 2026) FALSE (Date 1 1 2026)
#ASSERT NOT `s 15R(3): the compilation is lodged in time` (Date 10 3 2026) (Date 8 4 2026) FALSE (Date 1 1 2026)
#ASSERT `s 15R(3): the compilation is lodged in time` (Date 10 3 2026) (Date 11 3 2026) FALSE (Date 1 1 2026)
#ASSERT `s 15R(3): the compilation is lodged in time` (Date 10 3 2026) (Date 10 3 2026) FALSE (Date 1 1 2026)
#ASSERT `s 15R(3): the compilation is lodged in time` (Date 10 3 2026) (Date 21 4 2026) TRUE (Date 21 4 2026)
#ASSERT NOT `s 15R(3): the compilation is lodged in time` (Date 10 3 2026) (Date 22 4 2026) TRUE (Date 21 4 2026)
#ASSERT `s 15R(3): the compilation is lodged in time` (Date 10 3 2026) (Date 8 4 2026) TRUE (Date 21 4 2026)
#ASSERT `s 15R(3): the compilation is lodged in time` (Date 10 3 2026) (Date 5 4 2026) TRUE (Date 1 4 2026)
#ASSERT `s 15R(3): the compilation is lodged in time` (Date 10 3 2026) (Date 7 4 2026) TRUE (Date 1 4 2026)
#ASSERT NOT `s 15R(3): the compilation is lodged in time` (Date 10 3 2026) (Date 8 4 2026) TRUE (Date 1 4 2026)
#ASSERT `s 15S(1): the First Parliamentary Counsel may by written notice require the rule-maker to prepare and lodge a compilation within the period stated` TRUE EQUALS JUST TRUE
#ASSERT `s 15S(1): the First Parliamentary Counsel may by written notice require the rule-maker to prepare and lodge a compilation within the period stated` FALSE EQUALS JUST FALSE
#ASSERT `s 15S(2): the compilation date for the compilation` TRUE (Date 5 6 2026) EQUALS JUST (Date 5 6 2026)
#ASSERT `s 15S(2): the compilation date for the compilation` FALSE (Date 5 6 2026) EQUALS NOTHING
#ASSERT `s 15S(3): the compilation is lodged within the period` TRUE (Date 15 4 2026) (Date 15 4 2026) EQUALS JUST TRUE
#ASSERT `s 15S(3): the compilation is lodged within the period` TRUE (Date 1 4 2026) (Date 15 4 2026) EQUALS JUST TRUE
#ASSERT `s 15S(3): the compilation is lodged within the period` TRUE (Date 16 4 2026) (Date 15 4 2026) EQUALS JUST FALSE
#ASSERT `s 15S(3): the compilation is lodged within the period` FALSE (Date 1 4 2026) (Date 15 4 2026) EQUALS NOTHING

