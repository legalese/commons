IMPORT prelude
IMPORT `lga-provisions`

-- Cross-references of the in-scope text, found by a script that reads the text file (no row is typed by hand).
-- A row is one reference to one provision of this same text: the citing provision, the words of the citation as printed,
-- the index key of the cited provision, its heading as the text prints it, and the scope the index gives it.
-- The kinds are: section (a reference to another section), same section (a reference to a subsection or paragraph
-- of the section that cites it), Part (a reference to a Part), this container (a reference to "this Part", "this Division",
-- "this Chapter" or "this Subdivision").
-- A reference to another Act is a row of its own kind, further down, and is not resolved here.
-- Citing provision labels follow the printed structure: section, subsection, paragraph, subparagraph, as far as the line shows.
-- A reference of the form "this section", "this subsection" or "this paragraph" points at the citing provision itself and has no row.

DECLARE `Cross-reference` HAS
    `citing provision`                           IS A STRING
    `words of the citation as printed`          IS A STRING
    `kind of reference`                          IS A STRING
    `cited identifier`                           IS A STRING
    `pinpoint inside the cited provision`        IS A STRING
    `the pinpoint is present in the text`        IS A BOOLEAN
    `heading of the cited provision as printed` IS A STRING
    `scope of the cited provision`               IS A STRING
    `source line`                                IS A NUMBER

-- ruler: citing provision, words as printed, kind, cited identifier, pinpoint, pinpoint present, heading of the cited provision, scope of the cited provision, source line
`cross-references` MEANS LIST
    (`Cross-reference` OF "4", "subsection 5(1)", "section", "5", "(1)", TRUE, "Definitions of amend and modify", "in scope", 72),
    (`Cross-reference` OF "4", "section 15C", "section", "15C", "", TRUE, "Federal Register of Legislation—access to registered material on approved website", "in scope", 73),
