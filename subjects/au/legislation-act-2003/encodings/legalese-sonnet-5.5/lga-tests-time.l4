#ASSERT `s 51A(2): the day specified is a 1 April or 1 October not more than 5 years after the earliest day` (Date 1 4 2026) (Date 1 4 2031) EQUALS JUST TRUE
#ASSERT `s 51A(2): the day specified is a 1 April or 1 October not more than 5 years after the earliest day` (Date 1 4 2026) (Date 1 10 2030) EQUALS JUST TRUE
#ASSERT `s 51A(2): the day specified is a 1 April or 1 October not more than 5 years after the earliest day` (Date 1 4 2026) (Date 1 10 2031) EQUALS JUST FALSE
#ASSERT `s 51A(2): the day specified is a 1 April or 1 October not more than 5 years after the earliest day` (Date 1 4 2026) (Date 15 6 2028) EQUALS JUST FALSE
#ASSERT `s 51A(2): the day specified is a 1 April or 1 October not more than 5 years after the earliest day` (Date 1 4 2026) (Date 1 10 2025) EQUALS JUST TRUE
#ASSERT `s 52(1): a day is a sunsetting day` (Date 1 4 2026) (Date 1 4 2026)
#ASSERT `s 52(1): a day is a sunsetting day` (Date 1 4 2026) (Date 1 10 2026)
#ASSERT `s 52(1): a day is a sunsetting day` (Date 1 4 2026) (Date 1 4 2027)
#ASSERT NOT `s 52(1): a day is a sunsetting day` (Date 1 4 2026) (Date 1 10 2025)
#ASSERT NOT `s 52(1): a day is a sunsetting day` (Date 1 4 2026) (Date 1 6 2026)
-- Sunsetting day 1 October 2026: the 18 months before it begin on 1 April 2025 (that day is in them); 31 March 2025 is not.
#ASSERT `s 52(1): the list tabling day for a House and a sunsetting day` `the second test calendar` (Date 1 10 2026) EQUALS JUST (Date 1 4 2025)
#ASSERT `s 52(1): the list tabling day for a House and a sunsetting day` `the third test calendar` (Date 1 10 2026) EQUALS JUST (Date 15 4 2025)
-- A sitting on the sunsetting day itself is not before it.
#ASSERT `s 52(1): the list tabling day for a House and a sunsetting day` `the fourth test calendar` (Date 1 10 2026) EQUALS NOTHING
#ASSERT `s 52(1): the list tabling day for a House and a sunsetting day` (LIST (Date 30 9 2026)) (Date 1 10 2026) EQUALS JUST (Date 30 9 2026)
#ASSERT `s 53(2)(a): the next sunsetting day of an instrument continued by resolution` (Date 1 4 2026) EQUALS JUST (Date 1 4 2036)
#ASSERT `s 53(2)(a): the next sunsetting day of an instrument continued by resolution` (Date 1 10 2026) EQUALS JUST (Date 1 10 2036)

§§ `Events in time (text lines 813 to 871)`
#ASSERT `the day after the latest of the days on which events occur` (LIST (Date 5 3 2026), (Date 20 3 2026), (Date 10 3 2026)) EQUALS JUST (Date 21 3 2026)
#ASSERT `the day after the latest of the days on which events occur` (LIST (Date 31 12 2026)) EQUALS JUST (Date 1 1 2027)
#ASSERT `the day after the latest of the days on which events occur` (LIST (Date 28 2 2024)) EQUALS JUST (Date 29 2 2024)
#ASSERT `the day after the latest of the days on which events occur` EMPTY EQUALS NOTHING
-- Section 48A(2): a disallowable instrument waits for the end of the last day of disallowance; any other instrument for its commencement or registration, whichever is later.
#ASSERT `s 48A(2): the day on which the repeal by this section happens` TRUE (Date 20 3 2026) (Date 1 3 2026) (Date 25 2 2026) EQUALS JUST (Date 21 3 2026)
#ASSERT `s 48A(2): the day on which the repeal by this section happens` TRUE (Date 20 3 2026) (Date 25 3 2026) (Date 25 2 2026) EQUALS JUST (Date 26 3 2026)
#ASSERT `s 48A(2): the day on which the repeal by this section happens` FALSE (Date 20 3 2026) (Date 1 3 2026) (Date 25 2 2026) EQUALS JUST (Date 2 3 2026)
#ASSERT `s 48A(2): the day on which the repeal by this section happens` FALSE (Date 20 3 2026) (Date 1 3 2026) (Date 5 3 2026) EQUALS JUST (Date 6 3 2026)
#ASSERT `s 48A(2): the day on which the repeal by this section happens` FALSE (Date 1 1 2000) (Date 31 12 2026) (Date 31 12 2026) EQUALS JUST (Date 1 1 2027)
-- Events carry the day and whether they happen at the end of that day.
-- A commencement on 10 March (start of the day) after a disallowance period that ended at the end of 9 March: repeal on 10 March.
#ASSERT `the day on which a repeal immediately after the latest event happens` (LIST (`Event in time` OF (Date 10 3 2026), FALSE), (`Event in time` OF (Date 9 3 2026), TRUE)) EQUALS JUST (Date 10 3 2026)
-- The end of 10 March is the latest: immediately after it is 11 March.
#ASSERT `the day on which a repeal immediately after the latest event happens` (LIST (`Event in time` OF (Date 10 3 2026), FALSE), (`Event in time` OF (Date 10 3 2026), TRUE)) EQUALS JUST (Date 11 3 2026)
#ASSERT `the day on which a repeal immediately after the latest event happens` (LIST (`Event in time` OF (Date 10 3 2026), TRUE), (`Event in time` OF (Date 11 3 2026), FALSE)) EQUALS JUST (Date 11 3 2026)
#ASSERT `the day on which a repeal immediately after the latest event happens` (LIST (`Event in time` OF (Date 31 12 2026), TRUE)) EQUALS JUST (Date 1 1 2027)
#ASSERT `the day on which a repeal immediately after the latest event happens` (LIST (`Event in time` OF (Date 28 2 2024), TRUE)) EQUALS JUST (Date 29 2 2024)
#ASSERT `the day on which a repeal immediately after the latest event happens` EMPTY EQUALS NOTHING

§§ `The numbers of sitting days (text lines 721, 347, 742 to 745) and the sitting day counts`
#ASSERT `s 38(1): the number of sitting days allowed for laying` EQUALS 6
#ASSERT `s 15DA(2): the number of sitting days allowed for laying` EQUALS 6
#ASSERT `s 42(1): the number of sitting days allowed` EQUALS 15
#ASSERT NOT `s 38(1): a sitting day count is within the time for laying` 0
#ASSERT `s 38(1): a sitting day count is within the time for laying` 1
#ASSERT `s 38(1): a sitting day count is within the time for laying` 5
#ASSERT `s 38(1): a sitting day count is within the time for laying` 6
#ASSERT NOT `s 38(1): a sitting day count is within the time for laying` 7
#ASSERT NOT `s 42(1): a sitting day count is within the time allowed` 0
#ASSERT `s 42(1): a sitting day count is within the time allowed` 1
#ASSERT `s 42(1): a sitting day count is within the time allowed` 14
#ASSERT `s 42(1): a sitting day count is within the time allowed` 15
#ASSERT NOT `s 42(1): a sitting day count is within the time allowed` 16
-- The 6th sitting day after Monday 9 March 2026 is the last day the count allows (Thursday 19 March 2026).
#ASSERT `s 38(1): the last day for laying a registered legislative instrument before a House` `the test House sitting days` (Date 9 3 2026) EQUALS JUST (Date 19 3 2026)
