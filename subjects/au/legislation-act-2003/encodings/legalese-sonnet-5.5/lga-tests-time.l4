IMPORT prelude
IMPORT daydate
IMPORT `lga-time`

-- Tests of lga-time.l4. Every expected value is written by hand from the text (the line cited beside each group).
-- A group shows the day before the period, its first day, its last day and the day after, wherever the text states a period.

-- A House that sits on Tuesday, Wednesday and Thursday for 14 weeks from Tuesday 10 March 2026 (42 sitting days, the last on Thursday 11 June 2026).
`the test House sitting days` MEANS LIST (Date 10 3 2026), (Date 11 3 2026), (Date 12 3 2026), (Date 17 3 2026), (Date 18 3 2026), (Date 19 3 2026), (Date 24 3 2026), (Date 25 3 2026), (Date 26 3 2026), (Date 31 3 2026), (Date 1 4 2026), (Date 2 4 2026), (Date 7 4 2026), (Date 8 4 2026), (Date 9 4 2026), (Date 14 4 2026), (Date 15 4 2026), (Date 16 4 2026), (Date 21 4 2026), (Date 22 4 2026), (Date 23 4 2026), (Date 28 4 2026), (Date 29 4 2026), (Date 30 4 2026), (Date 5 5 2026), (Date 6 5 2026), (Date 7 5 2026), (Date 12 5 2026), (Date 13 5 2026), (Date 14 5 2026), (Date 19 5 2026), (Date 20 5 2026), (Date 21 5 2026), (Date 26 5 2026), (Date 27 5 2026), (Date 28 5 2026), (Date 2 6 2026), (Date 3 6 2026), (Date 4 6 2026), (Date 9 6 2026), (Date 10 6 2026), (Date 11 6 2026)

-- A second calendar, used for the section 52 window.
`the second test calendar` MEANS LIST (Date 31 3 2025), (Date 1 4 2025), (Date 2 4 2025), (Date 3 6 2025), (Date 30 9 2026), (Date 1 10 2026)
`the third test calendar` MEANS LIST (Date 31 3 2025), (Date 15 4 2025), (Date 1 10 2026)
`the fourth test calendar` MEANS LIST (Date 1 10 2026), (Date 2 10 2026)


§§ `s 12(1)(a): the day after registration (text line 242)`
-- registered Saturday 28 February 2026: commences at the start of Sunday 1 March 2026.
#ASSERT `s 12(1)(a): the day an instrument commences when it provides nothing else` (Date 28 2 2026) EQUALS (Date 1 3 2026)
-- registered 28 February 2024, a leap year: the day after is 29 February 2024.
#ASSERT `s 12(1)(a): the day an instrument commences when it provides nothing else` (Date 28 2 2024) EQUALS (Date 29 2 2024)
-- registered 29 February 2024: the day after is 1 March 2024.
#ASSERT `s 12(1)(a): the day an instrument commences when it provides nothing else` (Date 29 2 2024) EQUALS (Date 1 3 2024)
-- registered 31 December 2025: the day after is 1 January 2026.
#ASSERT `s 12(1)(a): the day an instrument commences when it provides nothing else` (Date 31 12 2025) EQUALS (Date 1 1 2026)

§§ `N days after an event (text lines 512 and 527 to 529: 28 days after the event occurs)`
-- 28 days after 1 March 2026 end on 29 March 2026.
#ASSERT `the last day of a period of days after an event` 28 (Date 1 3 2026) EQUALS (Date 29 3 2026)
-- 28 days after 31 January 2026 end on 28 February 2026.
#ASSERT `the last day of a period of days after an event` 28 (Date 31 1 2026) EQUALS (Date 28 2 2026)
-- 28 days after 15 February 2024 (a leap year) end on 14 March 2024.
#ASSERT `the last day of a period of days after an event` 28 (Date 15 2 2024) EQUALS (Date 14 3 2024)
-- 28 days after 4 December 2026 cross the new year and end on 1 January 2027.
#ASSERT `the last day of a period of days after an event` 28 (Date 4 12 2026) EQUALS (Date 1 1 2027)
-- The period of 28 days after 1 March 2026: the day before the event, the day of the event, the first day, the last day, the day after.
#ASSERT NOT `a day falls within a period of days after an event` 28 (Date 1 3 2026) (Date 28 2 2026)
#ASSERT NOT `a day falls within a period of days after an event` 28 (Date 1 3 2026) (Date 1 3 2026)
#ASSERT `a day falls within a period of days after an event` 28 (Date 1 3 2026) (Date 2 3 2026)
#ASSERT `a day falls within a period of days after an event` 28 (Date 1 3 2026) (Date 29 3 2026)
#ASSERT NOT `a day falls within a period of days after an event` 28 (Date 1 3 2026) (Date 30 3 2026)
#ASSERT `s 15R(3): the last day for lodging a compilation after a required compilation event` (Date 1 3 2026) EQUALS (Date 29 3 2026)
#ASSERT `s 15R(3): the last day for lodging a compilation after a required compilation event` (Date 3 2 2026) EQUALS (Date 3 3 2026)
#ASSERT `s 15T(2)(a): the last day of the 28 days after a required compilation event` (Date 1 3 2026) EQUALS (Date 29 3 2026)
#ASSERT `s 15T(2)(a): the last day of the 28 days after a required compilation event` (Date 31 12 2025) EQUALS (Date 28 1 2026)

