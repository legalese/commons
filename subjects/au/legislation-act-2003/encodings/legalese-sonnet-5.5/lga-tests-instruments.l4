IMPORT prelude
IMPORT `lga-instruments`

-- Tests of lga-instruments.l4 (sections 12 to 14).
-- Every expected value is written by hand from the text; the provision and the reading are named beside each group.


§§ `s 12: commencement (text lines 241 to 255)`

-- arguments: it is a legislative instrument or notifiable instrument; the instrument provides otherwise for its commencement
#ASSERT `s 12(1)(a): the instrument commences at the start of the day after the day it is registered` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 12(1)(a): the instrument commences at the start of the day after the day it is registered` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 12(1)(a): the instrument commences at the start of the day after the day it is registered` FALSE FALSE EQUALS NOTHING
#ASSERT `s 12(1)(a): the instrument commences at the start of the day after the day it is registered` FALSE TRUE EQUALS NOTHING
#ASSERT `s 12(1)(b): the instrument commences in accordance with its own commencement provision` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 12(1)(b): the instrument commences in accordance with its own commencement provision` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 12(1)(b): the instrument commences in accordance with its own commencement provision` FALSE TRUE EQUALS NOTHING
#ASSERT `s 12(1)(b): the instrument commences in accordance with its own commencement provision` FALSE FALSE EQUALS NOTHING
#ASSERT `s 12(1A): the instrument, or a provision of it, may provide that it commences before the instrument is registered` TRUE EQUALS JUST TRUE
#ASSERT `s 12(1A): the instrument, or a provision of it, may provide that it commences before the instrument is registered` FALSE EQUALS NOTHING
-- arguments: commences before registration; the person is the Commonwealth or an authority; rights disadvantaged; liabilities imposed
#ASSERT `s 12(2): the instrument or provision does not apply in relation to the person to the extent of that result` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 12(2): the instrument or provision does not apply in relation to the person to the extent of that result` TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 12(2): the instrument or provision does not apply in relation to the person to the extent of that result` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 12(2): the instrument or provision does not apply in relation to the person to the extent of that result` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 12(2): the instrument or provision does not apply in relation to the person to the extent of that result` FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 12(2): the instrument or provision does not apply in relation to the person to the extent of that result` FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 12(2): the instrument or provision does not apply in relation to the person to the extent of that result` TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 12(2): the instrument or provision does not apply in relation to the person to the extent of that result` TRUE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 12(2): the instrument or provision does not apply in relation to the person to the extent of that result` TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 12(2): the instrument or provision does not apply in relation to the person to the extent of that result` TRUE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 12(2): the instrument or provision does not apply in relation to the person to the extent of that result` FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 12(2): the instrument or provision does not apply in relation to the person to the extent of that result` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 12(4): the effect of subsection (1A) or (2) is displaced by the contrary provision in the Act` TRUE EQUALS JUST TRUE
#ASSERT `s 12(4): the effect of subsection (1A) or (2) is displaced by the contrary provision in the Act` FALSE EQUALS NOTHING
#ASSERT `s 12(5): the instrument may authorise the making of a commencement instrument in relation to it` TRUE EQUALS JUST TRUE
#ASSERT `s 12(5): the instrument may authorise the making of a commencement instrument in relation to it` FALSE EQUALS NOTHING

§§ `s 13: construction (text lines 257 to 268)`

-- arguments: enabling legislation confers the power; the contrary intention appears
#ASSERT `s 13(1)(a): the Acts Interpretation Act 1901 applies to the instrument as if it were an Act and each provision were a section` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 13(1)(a): the Acts Interpretation Act 1901 applies to the instrument as if it were an Act and each provision were a section` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 13(1)(a): the Acts Interpretation Act 1901 applies to the instrument as if it were an Act and each provision were a section` FALSE FALSE EQUALS NOTHING
#ASSERT `s 13(1)(a): the Acts Interpretation Act 1901 applies to the instrument as if it were an Act and each provision were a section` FALSE TRUE EQUALS NOTHING
-- arguments: enabling legislation confers the power; the contrary intention appears
#ASSERT `s 13(1)(b): expressions in the instrument have the same meaning as in the enabling legislation as in force from time to time` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 13(1)(b): expressions in the instrument have the same meaning as in the enabling legislation as in force from time to time` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 13(1)(b): expressions in the instrument have the same meaning as in the enabling legislation as in force from time to time` FALSE FALSE EQUALS NOTHING
#ASSERT `s 13(1)(b): expressions in the instrument have the same meaning as in the enabling legislation as in force from time to time` FALSE TRUE EQUALS NOTHING
-- arguments: enabling legislation confers the power; the contrary intention appears
#ASSERT `s 13(1)(c): the instrument is to be read and construed subject to the enabling legislation and so as not to exceed the power` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 13(1)(c): the instrument is to be read and construed subject to the enabling legislation and so as not to exceed the power` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 13(1)(c): the instrument is to be read and construed subject to the enabling legislation and so as not to exceed the power` FALSE FALSE EQUALS NOTHING
#ASSERT `s 13(1)(c): the instrument is to be read and construed subject to the enabling legislation and so as not to exceed the power` FALSE TRUE EQUALS NOTHING
#ASSERT `s 13(2): the instrument stands to the extent to which it is not in excess of that power` TRUE EQUALS JUST TRUE
#ASSERT `s 13(2): the instrument stands to the extent to which it is not in excess of that power` FALSE EQUALS JUST FALSE
#ASSERT `s 13(3): in exercising the power the person may identify the matter by referring to a class or classes of matters` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 13(3): in exercising the power the person may identify the matter by referring to a class or classes of matters` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 13(3): in exercising the power the person may identify the matter by referring to a class or classes of matters` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 13(3): in exercising the power the person may identify the matter by referring to a class or classes of matters` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 13(4): the subject is a matter` thing EQUALS JUST TRUE
#ASSERT `s 13(4): the subject is a matter` person EQUALS JUST TRUE
#ASSERT `s 13(4): the subject is a matter` animal EQUALS JUST TRUE
#ASSERT `s 13(4): the subject is a matter` `something else` EQUALS NOTHING
#ASSERT `s 13(5): the amendment by an Act prevents the instrument from being amended or repealed by the person` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 13(5): the amendment by an Act prevents the instrument from being amended or repealed by the person` TRUE FALSE EQUALS NOTHING
#ASSERT `s 13(5): the amendment by an Act prevents the instrument from being amended or repealed by the person` FALSE TRUE EQUALS NOTHING
#ASSERT `s 13(5): the amendment by an Act prevents the instrument from being amended or repealed by the person` FALSE FALSE EQUALS NOTHING

§§ `s 14: prescribing matters by reference to other instruments (text lines 270 to 285)`

#ASSERT `s 14(3): the legislative instrument is covered by this subsection` TRUE FALSE
#ASSERT `s 14(3): the legislative instrument is covered by this subsection` FALSE TRUE
#ASSERT `s 14(3): the legislative instrument is covered by this subsection` TRUE TRUE
#ASSERT NOT `s 14(3): the legislative instrument is covered by this subsection` FALSE FALSE
