IMPORT prelude
IMPORT `lga-scrutiny`
IMPORT `lga-nouns`

-- Tests of lga-scrutiny.l4 (Chapter 3 Part 2, sections 38 to 48).
-- Every expected value is written by hand from the text; the provision and the reading are named beside each group.

-- A House that sits on Tuesday, Wednesday and Thursday for 14 weeks from Tuesday 10 March 2026.
`the test sitting days` MEANS LIST (Date 10 3 2026), (Date 11 3 2026), (Date 12 3 2026), (Date 17 3 2026), (Date 18 3 2026), (Date 19 3 2026), (Date 24 3 2026), (Date 25 3 2026), (Date 26 3 2026), (Date 31 3 2026), (Date 1 4 2026), (Date 2 4 2026), (Date 7 4 2026), (Date 8 4 2026), (Date 9 4 2026)


§§ `ss 38 and 39: tabling (text lines 721 to 734)`

#ASSERT `s 38(1): the Office of Parliamentary Counsel must arrange for a copy to be delivered to each House to be laid within 6 sitting days of that House after registration` TRUE EQUALS JUST TRUE
#ASSERT `s 38(1): the Office of Parliamentary Counsel must arrange for a copy to be delivered to each House to be laid within 6 sitting days of that House after registration` FALSE EQUALS NOTHING
#ASSERT `s 38(3): the legislative instrument is repealed` TRUE EQUALS JUST TRUE
#ASSERT `s 38(3): the legislative instrument is repealed` FALSE EQUALS JUST FALSE
-- The later of the two Houses last days, plus one day.
#ASSERT `s 38(3): the first day on which the legislative instrument is no longer in force for not being laid` (Date 19 3 2026) (Date 24 3 2026) EQUALS (Date 25 3 2026)
#ASSERT `s 38(3): the first day on which the legislative instrument is no longer in force for not being laid` (Date 24 3 2026) (Date 19 3 2026) EQUALS (Date 25 3 2026)
#ASSERT `s 38(3): the first day on which the legislative instrument is no longer in force for not being laid` (Date 19 3 2026) (Date 19 3 2026) EQUALS (Date 20 3 2026)
#ASSERT `s 38(3): the first day on which the legislative instrument is no longer in force for not being laid` (Date 31 12 2026) (Date 30 12 2026) EQUALS (Date 1 1 2027)
#ASSERT `s 39(1): the Office of Parliamentary Counsel must arrange for a copy of the explanatory statement to be delivered to each House to be laid` TRUE EQUALS JUST TRUE
#ASSERT `s 39(1): the Office of Parliamentary Counsel must arrange for a copy of the explanatory statement to be delivered to each House to be laid` FALSE EQUALS NOTHING
#ASSERT `s 39(2)(a)(i): the delivery must be arranged at the same time as the instrument is delivered under section 38` `an initial explanatory statement to be delivered under section 39` TRUE EQUALS JUST TRUE
#ASSERT `s 39(2)(a)(i): the delivery must be arranged at the same time as the instrument is delivered under section 38` `an initial explanatory statement to be delivered under section 39` FALSE EQUALS JUST FALSE
#ASSERT `s 39(2)(a)(i): the delivery must be arranged at the same time as the instrument is delivered under section 38` `a supplementary explanatory statement or replacement explanatory statement` TRUE EQUALS NOTHING
#ASSERT `s 39(2)(a)(i): the delivery must be arranged at the same time as the instrument is delivered under section 38` `a supplementary explanatory statement or replacement explanatory statement` FALSE EQUALS NOTHING
-- Registered Monday 9 March 2026: the 6th sitting day after is Thursday 19 March. Registered Tuesday 10 March: the 6th sitting day after is Tuesday 24 March.
#ASSERT `s 39(2)(a)(ii) and (b): the last day for delivering the explanatory statement to the House` `the test sitting days` (Date 9 3 2026) EQUALS JUST (Date 19 3 2026)
#ASSERT `s 39(2)(a)(ii) and (b): the last day for delivering the explanatory statement to the House` `the test sitting days` (Date 10 3 2026) EQUALS JUST (Date 24 3 2026)
#ASSERT `s 39(2)(a)(ii) and (b): the last day for delivering the explanatory statement to the House` `the test sitting days` (Date 9 4 2026) EQUALS NOTHING
#ASSERT `s 39(3): the rule-maker must, as soon as possible, deliver to the House a written statement explaining the lateness of lodgement` TRUE EQUALS JUST TRUE
#ASSERT `s 39(3): the rule-maker must, as soon as possible, deliver to the House a written statement explaining the lateness of lodgement` FALSE EQUALS NOTHING
#ASSERT `s 39(4): this section stops applying to the initial explanatory statement and applies to the replacement as if it were the initial explanatory statement` TRUE EQUALS JUST TRUE
#ASSERT `s 39(4): this section stops applying to the initial explanatory statement and applies to the replacement as if it were the initial explanatory statement` FALSE EQUALS JUST FALSE

§§ `s 41: incorporated material (text lines 738 to 740)`

#ASSERT `s 41: the House may require the document to be made available for inspection` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 41: the House may require the document to be made available for inspection` TRUE FALSE EQUALS NOTHING
#ASSERT `s 41: the House may require the document to be made available for inspection` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 41: the House may require the document to be made available for inspection` FALSE FALSE EQUALS JUST FALSE

§§ `s 42: disallowance (text lines 742 to 758)`

#ASSERT `s 42(1): the instrument or provision so disallowed is repealed immediately after the passing of that resolution` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 42(1): the instrument or provision so disallowed is repealed immediately after the passing of that resolution` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 42(1): the instrument or provision so disallowed is repealed immediately after the passing of that resolution` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 42(1): the instrument or provision so disallowed is repealed immediately after the passing of that resolution` FALSE FALSE EQUALS JUST FALSE
-- arguments: notice given in time; at the end of 15 sitting days the notice not withdrawn and motion not called on; the motion called on, moved and not disposed of
#ASSERT `s 42(2): the instrument or provision is taken to have been disallowed and is repealed at that time` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 42(2): the instrument or provision is taken to have been disallowed and is repealed at that time` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 42(2): the instrument or provision is taken to have been disallowed and is repealed at that time` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 42(2): the instrument or provision is taken to have been disallowed and is repealed at that time` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 42(2): the instrument or provision is taken to have been disallowed and is repealed at that time` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 42(2): the instrument or provision is taken to have been disallowed and is repealed at that time` FALSE FALSE TRUE EQUALS JUST FALSE
-- arguments: notice given in time; dissolution, expiry or prorogation before the end of the 15 days; (c)(i) notice not withdrawn, motion not called on; (c)(ii) motion called on and not disposed of
#ASSERT `s 42(3): the instrument is taken to have been laid before the House on the first sitting day of that House after the dissolution, expiry or prorogation` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 42(3): the instrument is taken to have been laid before the House on the first sitting day of that House after the dissolution, expiry or prorogation` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 42(3): the instrument is taken to have been laid before the House on the first sitting day of that House after the dissolution, expiry or prorogation` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 42(3): the instrument is taken to have been laid before the House on the first sitting day of that House after the dissolution, expiry or prorogation` FALSE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 42(3): the instrument is taken to have been laid before the House on the first sitting day of that House after the dissolution, expiry or prorogation` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
-- Dissolved on Friday 20 March 2026: the first sitting day after is Tuesday 24 March. On Tuesday 24 March itself, the first sitting day after is Wednesday 25 March.
#ASSERT `s 42(3): the day the instrument is taken to have been laid` `the test sitting days` (Date 20 3 2026) EQUALS JUST (Date 24 3 2026)
#ASSERT `s 42(3): the day the instrument is taken to have been laid` `the test sitting days` (Date 24 3 2026) EQUALS JUST (Date 25 3 2026)
#ASSERT `s 42(3): the day the instrument is taken to have been laid` `the test sitting days` (Date 9 4 2026) EQUALS NOTHING

§§ `s 44 and the definition of disallowable legislative instrument (text lines 760 to 767, 85 to 86)`

-- arguments: (a) intergovernmental scheme; (b) authorises the instrument to be made by the body; the instrument is a regulation; enabling legislation or an Act makes it disallowable
#ASSERT `s 44(1): section 42 does not apply in relation to the instrument` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 44(1): section 42 does not apply in relation to the instrument` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 44(1): section 42 does not apply in relation to the instrument` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 44(1): section 42 does not apply in relation to the instrument` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 44(1): section 42 does not apply in relation to the instrument` FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 44(1): section 42 does not apply in relation to the instrument` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 44(2): section 42 does not apply in relation to the instrument or provision` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 44(2): section 42 does not apply in relation to the instrument or provision` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 44(2): section 42 does not apply in relation to the instrument or provision` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 44(2): section 42 does not apply in relation to the instrument or provision` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 44(3): prescribing the kind implies that every instrument of that kind is a legislative instrument` TRUE EQUALS JUST FALSE
#ASSERT `s 44(3): prescribing the kind implies that every instrument of that kind is a legislative instrument` FALSE EQUALS NOTHING
#ASSERT `s 4: the legislative instrument is a disallowable legislative instrument` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 4: the legislative instrument is a disallowable legislative instrument` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 4: the legislative instrument is a disallowable legislative instrument` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 4: the legislative instrument is a disallowable legislative instrument` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 4: the legislative instrument is a disallowable legislative instrument` TRUE TRUE TRUE EQUALS JUST FALSE

§§ `s 45: reviving (text lines 769 to 773)`

-- arguments: repealed by 38(3) or 42(1) or (2); it wholly or partly repealed another law in force immediately before; Part 4 would have repealed the repealed law first
#ASSERT `s 45: the instrument, law or provision repealed by the repealing instrument or provision revives from the repeal time` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 45: the instrument, law or provision repealed by the repealing instrument or provision revives from the repeal time` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 45: the instrument, law or provision repealed by the repealing instrument or provision revives from the repeal time` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 45: the instrument, law or provision repealed by the repealing instrument or provision revives from the repeal time` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 45: the instrument, law or provision repealed by the repealing instrument or provision revives from the repeal time` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 45: the instrument, law or provision repealed by the repealing instrument or provision revives from the repeal time` FALSE FALSE TRUE EQUALS JUST FALSE

