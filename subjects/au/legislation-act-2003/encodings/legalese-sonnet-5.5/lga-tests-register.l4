IMPORT prelude
IMPORT `lga-register`

-- Tests of lga-register.l4 (Chapter 2 Part 1, sections 15A to 15L).
-- Every expected value is written by hand from the text; the provision and the reading are named beside each group.


§§ `s 15A: the Register (text lines 299 to 318)`

#ASSERT `s 15A(1): the First Parliamentary Counsel must establish and maintain the Federal Register of Legislation`
-- (2): the five kinds listed must be contained; the other six kinds are not covered by (2).
#ASSERT `s 15A(2): the Register must contain the document` `an Act as made, registered under this Part` EQUALS JUST TRUE
#ASSERT `s 15A(2): the Register must contain the document` `a legislative instrument or notifiable instrument as made, registered under this Part` EQUALS JUST TRUE
#ASSERT `s 15A(2): the Register must contain the document` `a compilation of an Act, legislative instrument or notifiable instrument, registered under this Part` EQUALS JUST TRUE
#ASSERT `s 15A(2): the Register must contain the document` `an explanatory statement for a legislative instrument, registered under this Part` EQUALS JUST TRUE
#ASSERT `s 15A(2): the Register must contain the document` `another document registered under this Part` EQUALS JUST TRUE
#ASSERT `s 15A(2): the Register must contain the document` `an Act as made, other than an Act registered under this Part` EQUALS NOTHING
#ASSERT `s 15A(2): the Register must contain the document` `an instrument as made, other than a legislative instrument or notifiable instrument registered under this Part` EQUALS NOTHING
#ASSERT `s 15A(2): the Register must contain the document` `a Gazette notice` EQUALS NOTHING
#ASSERT `s 15A(2): the Register must contain the document` `a compilation of an Act or instrument, other than a compilation registered under this Part` EQUALS NOTHING
#ASSERT `s 15A(2): the Register must contain the document` `a document that may be considered under section 15AB of the Acts Interpretation Act 1901 in working out the meaning of an Act, legislative instrument or notifiable instrument` EQUALS NOTHING
#ASSERT `s 15A(2): the Register must contain the document` `any other document` EQUALS NOTHING
-- (3): the Register may contain an additional document if the First Parliamentary Counsel considers it likely to be useful; the five registered kinds are not additional documents.
#ASSERT `s 15A(3): the Register may contain the additional document` `an Act as made, registered under this Part` TRUE EQUALS NOTHING
#ASSERT `s 15A(3): the Register may contain the additional document` `an Act as made, registered under this Part` FALSE EQUALS NOTHING
#ASSERT `s 15A(3): the Register may contain the additional document` `a legislative instrument or notifiable instrument as made, registered under this Part` TRUE EQUALS NOTHING
#ASSERT `s 15A(3): the Register may contain the additional document` `a legislative instrument or notifiable instrument as made, registered under this Part` FALSE EQUALS NOTHING
#ASSERT `s 15A(3): the Register may contain the additional document` `a compilation of an Act, legislative instrument or notifiable instrument, registered under this Part` TRUE EQUALS NOTHING
#ASSERT `s 15A(3): the Register may contain the additional document` `a compilation of an Act, legislative instrument or notifiable instrument, registered under this Part` FALSE EQUALS NOTHING
#ASSERT `s 15A(3): the Register may contain the additional document` `an explanatory statement for a legislative instrument, registered under this Part` TRUE EQUALS NOTHING
#ASSERT `s 15A(3): the Register may contain the additional document` `an explanatory statement for a legislative instrument, registered under this Part` FALSE EQUALS NOTHING
#ASSERT `s 15A(3): the Register may contain the additional document` `another document registered under this Part` TRUE EQUALS NOTHING
#ASSERT `s 15A(3): the Register may contain the additional document` `another document registered under this Part` FALSE EQUALS NOTHING
#ASSERT `s 15A(3): the Register may contain the additional document` `an Act as made, other than an Act registered under this Part` TRUE EQUALS JUST TRUE
#ASSERT `s 15A(3): the Register may contain the additional document` `an Act as made, other than an Act registered under this Part` FALSE EQUALS JUST FALSE
#ASSERT `s 15A(3): the Register may contain the additional document` `an instrument as made, other than a legislative instrument or notifiable instrument registered under this Part` TRUE EQUALS JUST TRUE
#ASSERT `s 15A(3): the Register may contain the additional document` `an instrument as made, other than a legislative instrument or notifiable instrument registered under this Part` FALSE EQUALS JUST FALSE
#ASSERT `s 15A(3): the Register may contain the additional document` `a Gazette notice` TRUE EQUALS JUST TRUE
#ASSERT `s 15A(3): the Register may contain the additional document` `a Gazette notice` FALSE EQUALS JUST FALSE
#ASSERT `s 15A(3): the Register may contain the additional document` `a compilation of an Act or instrument, other than a compilation registered under this Part` TRUE EQUALS JUST TRUE
#ASSERT `s 15A(3): the Register may contain the additional document` `a compilation of an Act or instrument, other than a compilation registered under this Part` FALSE EQUALS JUST FALSE
#ASSERT `s 15A(3): the Register may contain the additional document` `a document that may be considered under section 15AB of the Acts Interpretation Act 1901 in working out the meaning of an Act, legislative instrument or notifiable instrument` TRUE EQUALS JUST TRUE
#ASSERT `s 15A(3): the Register may contain the additional document` `a document that may be considered under section 15AB of the Acts Interpretation Act 1901 in working out the meaning of an Act, legislative instrument or notifiable instrument` FALSE EQUALS JUST FALSE
#ASSERT `s 15A(3): the Register may contain the additional document` `any other document` TRUE EQUALS JUST TRUE
#ASSERT `s 15A(3): the Register may contain the additional document` `any other document` FALSE EQUALS JUST FALSE
#ASSERT `s 15A(4): the Register may include the information` TRUE EQUALS JUST TRUE
#ASSERT `s 15A(4): the Register may include the information` FALSE EQUALS NOTHING
#ASSERT `s 15A(5): the First Parliamentary Counsel may do the thing` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 15A(5): the First Parliamentary Counsel may do the thing` TRUE TRUE EQUALS NOTHING
#ASSERT `s 15A(5): the First Parliamentary Counsel may do the thing` FALSE FALSE EQUALS NOTHING
#ASSERT `s 15A(5): the First Parliamentary Counsel may do the thing` FALSE TRUE EQUALS NOTHING

§§ `ss 15B and 15C (text lines 320 and 323)`

#ASSERT `s 15B: the Register is taken to be a complete and accurate record of the law` TRUE EQUALS JUST TRUE
#ASSERT `s 15B: the Register is taken to be a complete and accurate record of the law` FALSE EQUALS NOTHING
#ASSERT `s 15C: the First Parliamentary Counsel must ensure the material is available to the public on the approved website` TRUE EQUALS JUST TRUE
#ASSERT `s 15C: the First Parliamentary Counsel must ensure the material is available to the public on the approved website` FALSE EQUALS NOTHING

§§ `s 15D: rectification (text lines 325 to 340)`

#ASSERT `s 15D(1): the First Parliamentary Counsel must arrange for the error to be rectified as soon as possible` TRUE `the text of an Act as it appears in the Register is not the text of the Act as assented to` EQUALS JUST TRUE
#ASSERT `s 15D(1): the First Parliamentary Counsel must arrange for the error to be rectified as soon as possible` FALSE `the text of an Act as it appears in the Register is not the text of the Act as assented to` EQUALS NOTHING
#ASSERT `s 15D(1): the First Parliamentary Counsel must arrange for the error to be rectified as soon as possible` TRUE `the text of a legislative instrument or notifiable instrument as it appears in the Register is not the text as made by the rule-maker` EQUALS JUST TRUE
#ASSERT `s 15D(1): the First Parliamentary Counsel must arrange for the error to be rectified as soon as possible` FALSE `the text of a legislative instrument or notifiable instrument as it appears in the Register is not the text as made by the rule-maker` EQUALS NOTHING
#ASSERT `s 15D(1): the First Parliamentary Counsel must arrange for the error to be rectified as soon as possible` TRUE `a compilation as it appears in the Register does not represent the state of the law that it purports to represent` EQUALS JUST TRUE
#ASSERT `s 15D(1): the First Parliamentary Counsel must arrange for the error to be rectified as soon as possible` FALSE `a compilation as it appears in the Register does not represent the state of the law that it purports to represent` EQUALS NOTHING
#ASSERT `s 15D(1): the First Parliamentary Counsel must arrange for the error to be rectified as soon as possible` TRUE `the text of another document as it appears in the Register is not the text of the original document` EQUALS JUST TRUE
#ASSERT `s 15D(1): the First Parliamentary Counsel must arrange for the error to be rectified as soon as possible` FALSE `the text of another document as it appears in the Register is not the text of the original document` EQUALS NOTHING
#ASSERT `s 15D(1): the First Parliamentary Counsel must arrange for the error to be rectified as soon as possible` TRUE `any other error` EQUALS NOTHING
#ASSERT `s 15D(1): the First Parliamentary Counsel must arrange for the error to be rectified as soon as possible` FALSE `any other error` EQUALS NOTHING
#ASSERT `s 15D(2): the First Parliamentary Counsel must include a statement of the rectification and a brief outline in the Register` TRUE EQUALS JUST TRUE
#ASSERT `s 15D(2): the First Parliamentary Counsel must include a statement of the rectification and a brief outline in the Register` FALSE EQUALS NOTHING
#ASSERT `s 15D(3)(a): the rectification affects the right or privilege` TRUE EQUALS JUST FALSE
#ASSERT `s 15D(3)(a): the rectification affects the right or privilege` FALSE EQUALS NOTHING
#ASSERT `s 15D(3)(b): the rectification imposes or increases the obligation or liability` TRUE EQUALS JUST FALSE
#ASSERT `s 15D(3)(b): the rectification imposes or increases the obligation or liability` FALSE EQUALS NOTHING
#ASSERT `s 15D(4): the rectification affects the time at which the instrument is taken to have been registered` TRUE EQUALS JUST FALSE
#ASSERT `s 15D(4): the rectification affects the time at which the instrument is taken to have been registered` FALSE EQUALS NOTHING

