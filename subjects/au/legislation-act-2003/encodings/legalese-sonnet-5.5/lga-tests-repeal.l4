IMPORT prelude
IMPORT `lga-repeal`

-- Tests of lga-repeal.l4 (Chapter 3 Part 3, sections 48A to 48E).
-- Every expected value is written by hand from the text; the provision and the reading are named beside each group.


§§ `s 48A (text lines 810 to 820)`

-- arguments: legislative instrument or notifiable instrument; its only legal effect is to amend or repeal others; it makes an application, saving or transitional provision
#ASSERT `s 48A(1): this section repeals the instrument` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 48A(1): this section repeals the instrument` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 48A(1): this section repeals the instrument` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 48A(1): this section repeals the instrument` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 48A(1): this section repeals the instrument` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 48A(1A): the instrument is taken to make an application, saving or transitional provision` TRUE EQUALS JUST FALSE
#ASSERT `s 48A(1A): the instrument is taken to make an application, saving or transitional provision` FALSE EQUALS NOTHING
-- arguments: this section repeals the instrument under (1); repealed earlier by 38(3) or 42(1) or (2)
#ASSERT `s 48A(2): the repeal by this section happens` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 48A(2): the repeal by this section happens` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 48A(2): the repeal by this section happens` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 48A(2): the repeal by this section happens` FALSE FALSE EQUALS NOTHING
#ASSERT `s 48A(3): the repeal affects any amendment or repeal made by the instrument` TRUE EQUALS JUST FALSE
#ASSERT `s 48A(3): the repeal affects any amendment or repeal made by the instrument` FALSE EQUALS NOTHING

§§ `s 48B (text lines 823 to 835)`

#ASSERT `s 48B(1): this section repeals the commencement instrument` TRUE EQUALS JUST TRUE
#ASSERT `s 48B(1): this section repeals the commencement instrument` FALSE EQUALS NOTHING
#ASSERT `s 48B(2): the repeal by this section happens` TRUE EQUALS JUST TRUE
#ASSERT `s 48B(2): the repeal by this section happens` FALSE EQUALS NOTHING
#ASSERT `s 48B(3): the repeal affects any commencement the instrument provides for` TRUE EQUALS JUST FALSE
#ASSERT `s 48B(3): the repeal affects any commencement the instrument provides for` FALSE EQUALS NOTHING

§§ `s 48C (text lines 838 to 856)`

-- arguments: a provision of a legislative instrument or notifiable instrument; the instrument is described in 48A(1); only legal effect is to amend or repeal others; only legal effect is to amend the instrument containing it
#ASSERT `s 48C(1): this section repeals the provision` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 48C(1): this section repeals the provision` TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 48C(1): this section repeals the provision` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 48C(1): this section repeals the provision` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 48C(1): this section repeals the provision` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 48C(1): this section repeals the provision` FALSE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 48C(1): this section repeals the provision` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 48C(2): the repeal by this section happens` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 48C(2): the repeal by this section happens` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 48C(2): the repeal by this section happens` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 48C(2): the repeal by this section happens` FALSE FALSE EQUALS NOTHING
#ASSERT `s 48C(3): the repeal affects any amendment or repeal made by the provision` TRUE EQUALS JUST FALSE
#ASSERT `s 48C(3): the repeal affects any amendment or repeal made by the provision` FALSE EQUALS NOTHING
-- arguments: (1) repeals a provision; the other provision only identifies an amended or repealed instrument or provision; it only identifies or groups such provisions
#ASSERT `s 48C(5): this section also repeals the other provision` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 48C(5): this section also repeals the other provision` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 48C(5): this section also repeals the other provision` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 48C(5): this section also repeals the other provision` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 48C(5): this section also repeals the other provision` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 48C(5): this section also repeals the other provision` FALSE FALSE TRUE EQUALS JUST FALSE

