IMPORT prelude
IMPORT `lga-seat`

-- Cases for lga-seat.l4: at least one case for each question of the seat, each with the answer worked out by hand from the text.
-- Every expected value is written by hand from the text; the provision and the reading are named beside each group.

-- Dates: 2026 is not a leap year. 28 February 2026 is a Saturday.

§§ `Commencement`

#ASSERT `When does my instrument commence` (Date 28 2 2026) FALSE (Date 1 1 2000) EQUALS (Date 1 3 2026)
#ASSERT `When does my instrument commence` (Date 31 12 2026) FALSE (Date 1 1 2000) EQUALS (Date 1 1 2027)
#ASSERT `When does my instrument commence` (Date 28 2 2026) TRUE (Date 15 3 2026) EQUALS (Date 15 3 2026)
#ASSERT `May my instrument commence before it is registered` TRUE EQUALS JUST TRUE
#ASSERT `May my instrument commence before it is registered` FALSE EQUALS NOTHING
#ASSERT `Does my instrument stop applying to this person` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Does my instrument stop applying to this person` TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Does my instrument stop applying to this person` TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `Does my instrument stop applying to this person` FALSE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Does my instrument stop applying to this person` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Does section 14 allow my instrument to incorporate the matter` TRUE FALSE `the provisions of an Act` `as in force from time to time` EQUALS JUST TRUE
#ASSERT `Does section 14 allow my instrument to incorporate the matter` TRUE FALSE `any other instrument or writing` `as in force from time to time` EQUALS JUST FALSE
#ASSERT `Does section 14 allow my instrument to incorporate the matter` TRUE FALSE `any other instrument or writing` `as in force at a particular time after the instrument commences` EQUALS NOTHING
#ASSERT `Does section 14 allow my instrument to incorporate the matter` TRUE FALSE `any other instrument or writing` `as in force at the time the instrument commences` EQUALS JUST TRUE
#ASSERT `Does section 14 allow my instrument to incorporate the matter` TRUE TRUE `the provisions of an Act` `as in force from time to time` EQUALS JUST FALSE
#ASSERT `Does section 14 allow my instrument to incorporate the matter` FALSE FALSE `the provisions of an Act` `as in force from time to time` EQUALS JUST FALSE

