IMPORT prelude

-- Provision index of the text file C2004A01224.txt (compilation C2019C00084).
-- Written by a script that reads the text file; nothing here is typed by hand.
-- One entry per Chapter, Part, Division, Subdivision and section, in the order the text prints them,
-- with the identifier and heading as printed (a non-breaking space in the text is read as an ordinary space).
-- The index key is the identifier, except for a Chapter, Part, Division or Subdivision, whose key
-- names the container it sits in ("Chapter 3 Part 2"), because "Part 2" alone is printed in more than one Chapter.
-- The first line and last line are line numbers of the text file.
-- The scope is the scope table of the brief: sections 4 to 6 and 8 to 54 and their Parts are in scope;
-- sections 1 to 3AA, Chapter 4 and the endnotes are out of scope.

DECLARE Provision HAS
    `index key`             IS A STRING
    `identifier as printed` IS A STRING
    `heading as printed`    IS A STRING
    `kind of provision`     IS A STRING
    `first line`            IS A NUMBER
    `last line`             IS A NUMBER
    `scope`                 IS A STRING

-- ruler: index key, identifier as printed, heading as printed, kind, first line, last line, scope
`provision index` MEANS LIST
    (Provision OF "Chapter 1", "Chapter 1", "Introduction", "Chapter", 24, 24, "out of scope"),
    (Provision OF "Chapter 1 Part 1", "Part 1", "Preliminary", "Part", 25, 25, "out of scope"),
