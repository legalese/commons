§ `s 26`

-- Assessed 1 August 2026: the 30th day after is 31 August.
#ASSERT `s 26(1) -- the last day to pay` (`the date` 1 8 2026) EQUALS `the date` 31 8 2026
#ASSERT `s 26 -- days of interest` (`the date` 1 8 2026) (`the date` 1 8 2026) FALSE EQUALS 0
#ASSERT `s 26 -- days of interest` (`the date` 1 8 2026) (`the date` 31 8 2026) FALSE EQUALS 0
#ASSERT `s 26 -- days of interest` (`the date` 1 8 2026) (`the date` 1 9 2026) FALSE EQUALS 1
#ASSERT `s 26 -- days of interest` (`the date` 1 8 2026) (`the date` 10 9 2026) FALSE EQUALS 10
#ASSERT `s 26 -- days of interest` (`the date` 1 8 2026) (`the date` 10 9 2026) TRUE EQUALS 0
-- Across the year: 15 December 2026 to 20 January 2027 is 36 days, 6 beyond the 30.
#ASSERT `s 26 -- days of interest` (`the date` 15 12 2026) (`the date` 20 1 2027) FALSE EQUALS 6
#ASSERT `s 26(1) -- the last day to pay` (`the date` 15 12 2026) EQUALS `the date` 14 1 2027

§ `s 27`

-- ($15,000 x 20%) + ($15,000 x 50%) = 3,000 + 7,500.
