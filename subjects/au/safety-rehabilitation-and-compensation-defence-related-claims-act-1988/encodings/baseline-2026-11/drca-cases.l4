§ `s 4 dependant`

-- A spouse who lived with the member is taken to be wholly dependent, whatever the actual support (s 4(5)).
#ASSERT `s 4 -- am I a dependant` `spouse` `partly` TRUE 40 FALSE TRUE EQUALS `a wholly dependent dependant`
#ASSERT `s 4 -- am I a dependant` `spouse` `partly` FALSE 40 FALSE TRUE EQUALS `a partly dependent dependant`
#ASSERT `s 4 -- am I a dependant` `spouse` `independent` FALSE 40 FALSE TRUE EQUALS `not a dependant`
#ASSERT `s 4 -- am I a dependant` `a child` `independent` TRUE 15 FALSE FALSE EQUALS `a wholly dependent dependant`
#ASSERT `s 4 -- am I a dependant` `a child` `partly` TRUE 16 TRUE FALSE EQUALS `a wholly dependent dependant`
#ASSERT `s 4 -- am I a dependant` `a child` `partly` TRUE 17 TRUE TRUE EQUALS `a partly dependent dependant`
#ASSERT `s 4 -- am I a dependant` `a child` `independent` TRUE 25 TRUE FALSE EQUALS `not a dependant`
#ASSERT `s 4 -- am I a dependant` `a child` `partly` TRUE 24 TRUE FALSE EQUALS `a wholly dependent dependant`
#ASSERT `s 4 -- am I a dependant` `a sibling` `wholly` FALSE 30 FALSE TRUE EQUALS `a wholly dependent dependant`
#ASSERT `s 4 -- am I a dependant` `stranger` `wholly` TRUE 30 FALSE TRUE EQUALS `not a dependant`

