#ASSERT `s 17(5) -- the weekly amount for a child` TRUE 16 TRUE FALSE 110 EQUALS 110
#ASSERT `s 17(5) -- the weekly amount for a child` TRUE 16 FALSE FALSE 110 EQUALS 0
#ASSERT `s 17(5) -- the weekly amount for a child` TRUE 16 TRUE TRUE 110 EQUALS 0
#ASSERT `s 17(5) -- the weekly amount for a child` TRUE 24 TRUE FALSE 180 EQUALS 180
#ASSERT `s 17(5) -- the weekly amount for a child` TRUE 25 TRUE FALSE 110 EQUALS 0
#ASSERT `s 17(5) -- the weekly amount for a child` FALSE 10 FALSE FALSE 110 EQUALS 0

