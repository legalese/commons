#ASSERT `s 41B -- the Act's criteria for an acute support package` `widow` 40 TRUE 25 TRUE FALSE FALSE FALSE 999 FALSE EQUALS `no package`
#ASSERT `s 41B -- the Act's criteria for an acute support package` `widow` 40 TRUE 25 TRUE FALSE TRUE TRUE 999 TRUE EQUALS `not barred`
#ASSERT `s 41B -- the Act's criteria for an acute support package` `widow` 65 TRUE 6 TRUE FALSE TRUE TRUE 999 TRUE EQUALS `no package`
#ASSERT `s 41B -- the Act's criteria for an acute support package` `widow` 64 FALSE 6 TRUE FALSE FALSE FALSE 999 TRUE EQUALS `no package`
#ASSERT `s 41B -- the Act's criteria for an acute support package` `grandparent carer` 70 FALSE 12 TRUE TRUE TRUE FALSE 999 TRUE EQUALS `not barred`
#ASSERT `s 41B -- the Act's criteria for an acute support package` `grandparent carer` 70 FALSE 12 TRUE TRUE FALSE FALSE 999 TRUE EQUALS `no package`
#ASSERT `s 41B -- the Act's criteria for an acute support package` `grandparent carer` 70 FALSE 12 FALSE TRUE TRUE FALSE 999 TRUE EQUALS `no package`
#ASSERT `s 41B -- the Act's criteria for an acute support package` `ex` 30 FALSE 0 FALSE FALSE FALSE FALSE 6 TRUE EQUALS `not barred`
#ASSERT `s 41B -- the Act's criteria for an acute support package` `ex` 30 FALSE 0 FALSE FALSE FALSE FALSE 12 TRUE EQUALS `not barred`
#ASSERT `s 41B -- the Act's criteria for an acute support package` `ex` 30 FALSE 0 FALSE FALSE FALSE FALSE 13 TRUE EQUALS `no package`
#ASSERT `s 41B -- the Act's criteria for an acute support package` `ex` 30 FALSE 0 FALSE FALSE TRUE TRUE 13 TRUE EQUALS `not barred`
#ASSERT `s 41B -- the Act's criteria for an acute support package` `ex` 30 FALSE 0 FALSE FALSE TRUE TRUE 13 FALSE EQUALS `no package`
