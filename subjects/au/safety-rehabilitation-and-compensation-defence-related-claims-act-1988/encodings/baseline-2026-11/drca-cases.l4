#ASSERT `s 49 -- what I must pay` 400000 100000 100000 TRUE EQUALS 100000
#ASSERT `s 49 -- what I must pay` 50000 100000 100000 TRUE EQUALS 50000
-- AC 200,000 x (100,000 / 400,000) = 50,000, less than the 100,000 recovered.
#ASSERT `s 49 -- what I must pay` 200000 100000 400000 FALSE EQUALS 50000
-- AC 400,000 x (300,000 / 400,000) = 300,000, equal to the damages.
#ASSERT `s 49 -- what I must pay` 400000 300000 400000 FALSE EQUALS 300000

