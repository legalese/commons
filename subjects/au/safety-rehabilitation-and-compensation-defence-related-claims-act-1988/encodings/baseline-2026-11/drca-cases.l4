#ASSERT `s 41B -- the Act's criteria for an acute support package` `ex of the dead` 40 FALSE 3 TRUE FALSE TRUE TRUE 30 TRUE EQUALS `not barred`
#ASSERT `s 41B -- the Act's criteria for an acute support package` `ex of the dead` 40 FALSE 3 TRUE FALSE FALSE FALSE 13 TRUE EQUALS `no package`
#ASSERT `s 41B -- the Act's criteria for an acute support package` `ex of the dead` 65 FALSE 3 TRUE FALSE TRUE TRUE 6 TRUE EQUALS `no package`
#ASSERT `s 41B -- the Act's criteria for an acute support package` `ex of the dead` 40 FALSE 3 TRUE FALSE TRUE TRUE 6 FALSE EQUALS `no package`
#ASSERT `s 41B -- the Act's criteria for an acute support package` `someone else` 30 TRUE 1 TRUE TRUE TRUE TRUE 1 TRUE EQUALS `no package`

