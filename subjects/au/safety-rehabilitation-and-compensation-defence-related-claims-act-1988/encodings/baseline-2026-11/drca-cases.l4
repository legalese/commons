#ASSERT `ss 16, 144A, 144B -- medical costs` FALSE FALSE FALSE FALSE EQUALS `med unreasonable`
#ASSERT `ss 16, 144A, 144B -- medical costs` TRUE TRUE FALSE FALSE EQUALS `med 144A`
