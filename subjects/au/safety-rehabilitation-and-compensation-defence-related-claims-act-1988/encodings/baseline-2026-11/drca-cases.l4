IMPORT prelude
IMPORT `drca-dates`
IMPORT `drca-claimant`

-- Cases for drca-claimant.l4. Every expected value was worked by hand from the deposited text (C2026C00265) and the
-- formulas sidecar, before running; none was copied from the encoding's output. Hypothetical facts: no scenario life
-- reaches this Act. Edges: 1 July 2026 itself (s 14AA), 1 July 2004 and 1 December 1988 (s 4AA), the qualifying periods
-- (s 7(8)), ages 16 and 25 (prescribed child), 10% and 5% (s 24), increases of 10 and 5 points (s 25), the 30th and 31st
-- day (s 26), the 7th and 8th day (ss 46, 47), the 28th and 29th day (s 48(2)), half the cost against the $200 cap
-- (s 29), 24 and 25 months and age 65 (s 41B).

-- Shorthands for the answers.
`claim ok`        MEANS `yes: a claim made before 1 July 2026 is not barred by s 14AA (the rest of Part V still applies)`
`claim barred`    MEANS `no: a claim may not be made under this Act on or after 1 July 2026 (s 14AA(a)); claims that could have been made under this Act are now made under the MRCA (Note 1)`

`applies`         MEANS `yes: the Act applies (s 4AA)`
`MRCA instead`    MEANS `no: service on or after 1 July 2004 is covered by the MRCA instead (s 4AA(1)-(3), Notes)`
`spanned`         MEANS `no: service both before and on or after 1 July 2004 is excluded for an injury or ailment (s 4AA(1)(b)(ii), (2)(b)(ii), (5))`
`CTPA s 8`        MEANS `no: the injury from medical treatment is excluded because s 8 of the CTPA applies to it (s 4AA(4)(c))`
`treated pre-88`  MEANS `no: medical treatment before 1 December 1988 is not within s 4AA(4)(b)`
`6A(2A)`          MEANS `no: the injury from medical treatment was first suffered on or after 1 July 2004 from treatment on or after that date (s 6A(2A)); the MRCA covers it`
`5(6)`            MEANS `no: the Act does not apply to service for which the VEA or the PNG Act provides a pension (s 5(6))`
`Part X`          MEANS `not covered: service before 1 December 1988 depends on the 1912, 1930 or 1971 Act under Part X (s 124), not encoded`

`injury`          MEANS `an injury that is not an ailment, or an aggravation of one`
`ailment`         MEANS `an ailment (a disease), or an aggravation of one`
`property`        MEANS `loss of or damage to an aid, appliance or artificial limb I used`
`treatment`       MEANS `an injury suffered as an unintended consequence of medical treatment the Commonwealth paid for`
`pre-88`          MEANS `all before 1 December 1988`
`88 to 04`        MEANS `on or after 1 December 1988 and all before 1 July 2004`
`span`            MEANS `both before and on or after 1 July 2004`
`post-04`         MEANS `all on or after 1 July 2004`
`no pension`      MEANS `none: neither the Veterans' Entitlements Act 1986 nor the PNG Act provides a pension for that service`
`VEA II`          MEANS `VEA Part II, for operational service rendered on or after the Military Compensation Act 1994 commenced`
`VEA IV`          MEANS `VEA Part IV (members of the Forces or of a Peacekeeping Force)`
`VEA other`       MEANS `another provision of the VEA, or the Papua New Guinea (Members of the Forces Benefits) Act 1957`

`is injury`       MEANS `yes: it is an "injury" under s 5A`
`not significant` MEANS `no: a disease must have been contributed to, to a significant degree (substantially more than material), by my service (s 5B)`
`false rep`       MEANS `no: a disease I wilfully and falsely said I did not have is not an injury (s 7(7))`
`not in course`   MEANS `no: it did not arise out of, or in the course of, my service (ss 5A(1)(b), (c), 6)`
`admin action`    MEANS `no: it resulted from reasonable administrative action taken in a reasonable manner (s 5A(1), (2))`
`disease`         MEANS `an ailment or disease, or its aggravation, including a psychological condition that developed over time`
`hurt`            MEANS `a physical or mental injury, other than a disease, or an aggravation of one`
`at work`         MEANS `at my place of work for my service, or on an ordinary break from it`
`violence`        MEANS `by an act of violence that would not have happened but for my service`
`commute`         MEANS `travelling between home and my usual place of work`
`overseas`        MEANS `overseas at the Commonwealth's direction, in a declared place or as one of a declared class (s 6(1)(h), (i))`
`elsewhere`       MEANS `somewhere else`

`liable`          MEANS `yes: the Commonwealth is liable to compensate me for the injury (s 14(1)), and for reasonable medical treatment (s 16)`
`medical only`    MEANS `only medical expenses: the injury has not resulted in death, incapacity for work or impairment (ss 14(1), 16(2))`
`self-inflicted`  MEANS `no: an intentionally self-inflicted injury is not compensated (s 14(2))`
`misconduct`      MEANS `no: an injury caused by my serious and wilful misconduct is not compensated unless it results in death or serious and permanent impairment (s 14(3))`

`med yes`         MEANS `yes: the Commonwealth pays the amount the Commission determines appropriate, to me if I paid, otherwise to the person I owe (s 16(1), (4))`
`med unreasonable` MEANS `no: the treatment was not reasonable for me to obtain in the circumstances (s 16(1))`
`med 144A`        MEANS `no: I am eligible for treatment under another Act listed in s 144A(1), so s 16(1) compensation is not payable`
`med 144B`        MEANS `no: my treatment for this injury is provided under the MRCA or the VEA instead (s 144B(5))`

`spouse`          MEANS `spouse or de facto partner`
`a child`         MEANS `child`
`a sibling`       MEANS `sibling or half-sibling`
`stranger`        MEANS `another relation, or none`
`wholly`          MEANS `wholly dependent on the member for economic support`
`partly`          MEANS `partly dependent on the member for economic support`
`independent`     MEANS `not dependent on the member`

`full lump sum`   MEANS `the full lump sum, for the benefit of all the dependants (s 17(3))`
`up to`           MEANS `an amount the Commission determines for the partly dependent dependants, up to (s 17(4))`
`no lump sum`     MEANS `no lump sum: the member left no dependants (s 17(2)); medical costs under s 16 remain`

`hearing`         MEANS `a hearing loss`
`finger`          MEANS `the loss, or loss of the use, of a finger or toe, or the loss of the sense of taste or smell`
`other PI`        MEANS `another permanent impairment`

`between`         MEANS `a weekly amount the Commission considers reasonable, within (s 29(1))`
`first 28 days`   MEANS `nothing for a week within 28 days of the injury, unless the Commission determines otherwise (s 29(5))`
`no cap`          MEANS `a weekly amount the Commission considers reasonable, with no floor or cap (s 29A(1))`
`not required`    MEANS `nothing: the services are not reasonably required (s 29(1), s 29A(1))`

`widow`           MEANS `the member's spouse immediately before the member died`
`grandparent carer` MEANS `a parent or step-parent of the member who died, or of someone who was the member's spouse at any time before the death`
`ex`              MEANS `the member's spouse or former spouse, the member living`
`ex of the dead`  MEANS `the member's former spouse, the member having died`
`no package`      MEANS `no: I do not meet any of the criteria in s 41B(5), (5A) or (6), so I cannot be eligible (s 41B(2))`
`not barred`      MEANS `the Act does not bar me: I meet the Act's criteria; eligibility then turns on the Commission's instrument (s 41B(2), (7))`

`may elect`       MEANS `yes: I may elect in writing to sue for non-economic loss; the election is irrevocable, ends my s 24, 25 and 27 compensation, and the court cannot award more than (s 45)`
`too late to elect` MEANS `no: an action for damages does not lie against the Commonwealth or another member (s 44(1)); I can no longer elect, because s 24, 25 or 27 compensation has been paid (s 45(1))`
`no election`     MEANS `no: an action for damages does not lie against the Commonwealth or another member (s 44(1)); s 45 lets me elect only where compensation is payable under s 24, 25 or 27 and the Commonwealth or another member would be liable`
`death action`    MEANS `yes: as a dependant I may sue for the death; s 44(1) does not prevent it (s 44(3), (4))`

`late`            MEANS `late: an offence of strict liability, with a maximum penalty of (penalty units)`

`s 16 claim`      MEANS `medical treatment costs (s 16)`
`other claim`     MEANS `permanent impairment, non-economic loss, household or attendant care, or another kind`
`property claim`  MEANS `loss of or damage to my aid or other property (s 15)`
`no accident notice` MEANS `no: the Act does not apply to the loss or damage without written notice of the accident given as soon as practicable, or a late notice excused (s 53(2), (3))`
`claim counts`    MEANS `yes: notice and claim count, and compensation can be determined on the claim (ss 53, 54)`
`no notice`       MEANS `no: the Act does not apply to the injury without written notice given as soon as practicable, or a late notice excused (s 53(1), (3))`
`no certificate`  MEANS `no: the claim is taken not to have been made until a medical practitioner's certificate is given (s 54(2)(b), (3))`
`no form`         MEANS `no: there is no claim in writing substantially in the approved form (s 54(1), (2)(a), (5))`
`after 14AA`      MEANS `no: a claim may not be made under this Act on or after 1 July 2026 (s 14AA(a))`

`workers comp`    MEANS `workers' compensation under a law of a State, Territory or foreign country`
`specified`       MEANS `compensation under a State or Territory law declared a specified law (not workers' compensation)`

§ `s 14AA`

-- 30 June 2026 is the last day; 1 July 2026 is the date of commencement itself.
#ASSERT `s 14AA -- can I make a claim on this day` (`the date` 30 6 2026) EQUALS `claim ok`
#ASSERT `s 14AA -- can I make a claim on this day` (`the date` 1 7 2026) EQUALS `claim barred`
#ASSERT `s 14AA -- can I make a claim on this day` (`the date` 7 11 2026) EQUALS `claim barred`
#ASSERT `s 14AA -- can I make a claim on this day` (`the date` 15 3 1999) EQUALS `claim ok`

§ `ss 4AA, 5`

-- A knee injured on exercise in 1995: service 1988-2004 only.
#ASSERT `ss 4AA, 5 -- does the Act cover it` `injury` `88 to 04` `no pension` FALSE FALSE EQUALS `applies`
#ASSERT `ss 4AA, 5 -- does the Act cover it` `ailment` `88 to 04` `no pension` FALSE FALSE EQUALS `applies`
-- Service from 1999 to 2010 contributed to the ailment: spans 1 July 2004, so excluded by "but not before and on or after".
#ASSERT `ss 4AA, 5 -- does the Act cover it` `ailment` `span` `no pension` FALSE FALSE EQUALS `spanned`
#ASSERT `ss 4AA, 5 -- does the Act cover it` `injury` `span` `no pension` FALSE FALSE EQUALS `spanned`
-- s 4AA(3) for property has no "but not" words: a span still applies.
#ASSERT `ss 4AA, 5 -- does the Act cover it` `property` `span` `no pension` FALSE FALSE EQUALS `applies`
#ASSERT `ss 4AA, 5 -- does the Act cover it` `property` `post-04` `no pension` FALSE FALSE EQUALS `MRCA instead`
#ASSERT `ss 4AA, 5 -- does the Act cover it` `injury` `post-04` `no pension` FALSE FALSE EQUALS `MRCA instead`
#ASSERT `ss 4AA, 5 -- does the Act cover it` `injury` `pre-88` `no pension` FALSE FALSE EQUALS `Part X`
-- s 5(6) and its exceptions (7), (8).
#ASSERT `ss 4AA, 5 -- does the Act cover it` `injury` `88 to 04` `VEA other` FALSE FALSE EQUALS `5(6)`
#ASSERT `ss 4AA, 5 -- does the Act cover it` `injury` `88 to 04` `VEA II` FALSE FALSE EQUALS `applies`
#ASSERT `ss 4AA, 5 -- does the Act cover it` `injury` `88 to 04` `VEA IV` FALSE FALSE EQUALS `applies`
-- Injuries from treatment the Commonwealth paid for (s 4AA(4), s 6A(2A)).
#ASSERT `ss 4AA, 5 -- does the Act cover it` `treatment` `88 to 04` `no pension` FALSE FALSE EQUALS `applies`
#ASSERT `ss 4AA, 5 -- does the Act cover it` `treatment` `88 to 04` `no pension` TRUE FALSE EQUALS `applies`
#ASSERT `ss 4AA, 5 -- does the Act cover it` `treatment` `span` `no pension` TRUE FALSE EQUALS `6A(2A)`
#ASSERT `ss 4AA, 5 -- does the Act cover it` `treatment` `post-04` `no pension` TRUE FALSE EQUALS `6A(2A)`
#ASSERT `ss 4AA, 5 -- does the Act cover it` `treatment` `span` `no pension` FALSE FALSE EQUALS `applies`
#ASSERT `ss 4AA, 5 -- does the Act cover it` `treatment` `pre-88` `no pension` FALSE FALSE EQUALS `treated pre-88`
#ASSERT `ss 4AA, 5 -- does the Act cover it` `treatment` `88 to 04` `no pension` FALSE TRUE EQUALS `CTPA s 8`

§ `ss 5A, 5B, 6, 7(7)`

#ASSERT `ss 5A, 5B, 6 -- is it an injury` `disease` TRUE FALSE `elsewhere` FALSE FALSE FALSE EQUALS `is injury`
#ASSERT `ss 5A, 5B, 6 -- is it an injury` `disease` FALSE FALSE `elsewhere` FALSE FALSE FALSE EQUALS `not significant`
#ASSERT `ss 5A, 5B, 6 -- is it an injury` `disease` TRUE TRUE `elsewhere` FALSE FALSE FALSE EQUALS `false rep`
-- A reasonable posting decision causing anxiety: excluded however contributed.
#ASSERT `ss 5A, 5B, 6 -- is it an injury` `disease` TRUE FALSE `elsewhere` FALSE FALSE TRUE EQUALS `admin action`
#ASSERT `ss 5A, 5B, 6 -- is it an injury` `hurt` FALSE FALSE `at work` FALSE FALSE FALSE EQUALS `is injury`
#ASSERT `ss 5A, 5B, 6 -- is it an injury` `hurt` FALSE FALSE `at work` FALSE TRUE FALSE EQUALS `not in course`
-- s 6(3) reaches only places and recesses, not violence.
#ASSERT `ss 5A, 5B, 6 -- is it an injury` `hurt` FALSE FALSE `violence` FALSE TRUE FALSE EQUALS `is injury`
#ASSERT `ss 5A, 5B, 6 -- is it an injury` `hurt` FALSE FALSE `commute` FALSE FALSE FALSE EQUALS `not in course`
#ASSERT `ss 5A, 5B, 6 -- is it an injury` `hurt` FALSE FALSE `commute` TRUE FALSE FALSE EQUALS `is injury`
#ASSERT `ss 5A, 5B, 6 -- is it an injury` `hurt` FALSE FALSE `overseas` FALSE FALSE FALSE EQUALS `is injury`
#ASSERT `ss 5A, 5B, 6 -- is it an injury` `hurt` FALSE FALSE `elsewhere` FALSE FALSE FALSE EQUALS `not in course`

