IMPORT prelude
IMPORT `dda-rules`
IMPORT `dda-seat`

-- Disability Discrimination Act 1992 (Cth) -- cases for the questions of the person at work (dda-seat.l4).
-- Every expected value is worked by hand from the deposited text (Compilation No. 40), with the section, and never copied
-- from the encoding's output. BASELINE ENCODING. Not for public use as advice. See NOTES.md.

§ `Cases -- the person at work`

§§ `s 4 -- disability`

-- "means" (a)-(g): each head is a disability; none is not.
#ASSERT `Do I have a disability under the Act?` `total or partial loss of bodily or mental functions` EQUALS JUST TRUE
#ASSERT `Do I have a disability under the Act?` `total or partial loss of a part of the body` EQUALS JUST TRUE
#ASSERT `Do I have a disability under the Act?` `organisms in the body causing disease or illness` EQUALS JUST TRUE
#ASSERT `Do I have a disability under the Act?` `organisms in the body capable of causing disease or illness` EQUALS JUST TRUE
#ASSERT `Do I have a disability under the Act?` `malfunction or malformation or disfigurement of a part of the body` EQUALS JUST TRUE
#ASSERT `Do I have a disability under the Act?` `a disorder or malfunction that results in learning differently` EQUALS JUST TRUE
#ASSERT `Do I have a disability under the Act?` `a disorder or illness or disease affecting thought processes or perception of reality or emotions or judgment or resulting in disturbed behaviour` EQUALS JUST TRUE
#ASSERT `Do I have a disability under the Act?` `none of these` EQUALS JUST FALSE

§§ `s 4 -- associate`

-- "includes" (a)-(e): each named head is an associate; the person I care for (not named) and anyone else: not answered.
#ASSERT `Is this person my associate under the Act?` `my spouse` EQUALS JUST TRUE
#ASSERT `Is this person my associate under the Act?` `a person living with me on a genuine domestic basis` EQUALS JUST TRUE
#ASSERT `Is this person my associate under the Act?` `my relative by blood or marriage or affinity or adoption` EQUALS JUST TRUE
#ASSERT `Is this person my associate under the Act?` `my carer` EQUALS JUST TRUE
#ASSERT `Is this person my associate under the Act?` `a person in a business or sporting or recreational relationship with me` EQUALS JUST TRUE
#ASSERT `Is this person my associate under the Act?` `a person I care for who is not my relative` EQUALS NOTHING
#ASSERT `Is this person my associate under the Act?` `someone else` EQUALS NOTHING

§§ `s 9 -- carer, assistant, assistance animal, disability aid`

-- s 9(1): carer, assistant, interpreter, reader who assists because of the disability; a closed list.
#ASSERT `Does the Act count what helps me?` `a carer` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Does the Act count what helps me?` `an interpreter` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Does the Act count what helps me?` `a reader` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Does the Act count what helps me?` `an assistant` FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Does the Act count what helps me?` `another kind of helper` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- s 9(2): (a) State or Territory accreditation, (b) a prescribed organisation, (c) trained for both purposes.
#ASSERT `Does the Act count what helps me?` `an animal` FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Does the Act count what helps me?` `an animal` FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Does the Act count what helps me?` `an animal` FALSE FALSE FALSE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Does the Act count what helps me?` `an animal` FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Does the Act count what helps me?` `an animal` FALSE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
-- A helper's assistance does not make an animal count.
#ASSERT `Does the Act count what helps me?` `an animal` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- s 9(3): equipment used by the person that alleviates the effect of the disability.
#ASSERT `Does the Act count what helps me?` `equipment` FALSE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Does the Act count what helps me?` `equipment` FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Does the Act count what helps me?` `equipment` FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE

§§ `ss 5, 6 -- discrimination`

-- Order: less favourably, a reason, not adjusted, hardship shown, not adjusting led to worse treatment, requirement,
-- cannot comply, could comply only with adjustments, disadvantages, requirement shown reasonable.
-- s 5(1) with s 10.
#ASSERT `Did they discriminate against me?` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Did they discriminate against me?` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Did they discriminate against me?` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- s 5(2): no reasonable adjustment; unjustifiable hardship makes the adjustment not "reasonable" (s 4).
#ASSERT `Did they discriminate against me?` FALSE FALSE TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Did they discriminate against me?` FALSE FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Did they discriminate against me?` FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- s 6(1), (3), (4).
#ASSERT `Did they discriminate against me?` FALSE FALSE FALSE FALSE FALSE TRUE TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Did they discriminate against me?` FALSE FALSE FALSE FALSE FALSE TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Did they discriminate against me?` FALSE FALSE FALSE FALSE FALSE TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Did they discriminate against me?` FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE TRUE FALSE EQUALS JUST FALSE
-- s 6(2): could comply only with adjustments, which were not made.
#ASSERT `Did they discriminate against me?` FALSE FALSE TRUE FALSE FALSE TRUE FALSE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Did they discriminate against me?` FALSE FALSE FALSE FALSE FALSE TRUE FALSE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Did they discriminate against me?` FALSE FALSE TRUE TRUE FALSE TRUE FALSE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Did they discriminate against me?` FALSE FALSE TRUE FALSE FALSE TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Did they discriminate against me?` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE

§§ `ss 15-21 -- which paragraph`

#ASSERT `Which section covers what was done to me at work?` `seeking employment` `the arrangements made for deciding who is offered the work` 0 EQUALS JUST "s 15(1)(a)"
#ASSERT `Which section covers what was done to me at work?` `seeking employment` `deciding who is offered the work` 0 EQUALS JUST "s 15(1)(b)"
#ASSERT `Which section covers what was done to me at work?` `seeking employment` `the terms or conditions on which the work or position is offered` 0 EQUALS JUST "s 15(1)(c)"
#ASSERT `Which section covers what was done to me at work?` `seeking employment` `dismissing me or ending my engagement or position or membership` 0 EQUALS NOTHING
#ASSERT `Which section covers what was done to me at work?` `an employee` `the terms or conditions of my work or position` 0 EQUALS JUST "s 15(2)(a)"
#ASSERT `Which section covers what was done to me at work?` `an employee` `deciding who is offered promotion or transfer` 0 EQUALS JUST "s 15(2)(b)"
#ASSERT `Which section covers what was done to me at work?` `an employee` `denying or limiting my access to promotion or transfer or training or other benefits` 0 EQUALS JUST "s 15(2)(b)"
#ASSERT `Which section covers what was done to me at work?` `an employee` `dismissing me or ending my engagement or position or membership` 0 EQUALS JUST "s 15(2)(c)"
#ASSERT `Which section covers what was done to me at work?` `an employee` `subjecting me to any other detriment` 0 EQUALS JUST "s 15(2)(d)"
#ASSERT `Which section covers what was done to me at work?` `an employee` `the manner in which a service is provided to me` 0 EQUALS NOTHING
#ASSERT `Which section covers what was done to me at work?` `seeking to be engaged as a commission agent` `the arrangements made for deciding who is offered the work` 0 EQUALS JUST "s 16(1)(a)"
#ASSERT `Which section covers what was done to me at work?` `a commission agent` `dismissing me or ending my engagement or position or membership` 0 EQUALS JUST "s 16(2)(c)"
#ASSERT `Which section covers what was done to me at work?` `a contract worker` `the terms or conditions of my work or position` 0 EQUALS JUST "s 17(a)"
#ASSERT `Which section covers what was done to me at work?` `a contract worker` `deciding who is offered the work` 0 EQUALS JUST "s 17(b)"
#ASSERT `Which section covers what was done to me at work?` `a contract worker` `subjecting me to any other detriment` 0 EQUALS JUST "s 17(d)"
#ASSERT `Which section covers what was done to me at work?` `a contract worker` `the arrangements made for deciding who is offered the work` 0 EQUALS NOTHING
-- s 18: 3 or more partners; 2 is outside the section.
#ASSERT `Which section covers what was done to me at work?` `seeking to become a partner` `deciding who is offered the work` 3 EQUALS JUST "s 18(1)(a) or (2)(a)"
#ASSERT `Which section covers what was done to me at work?` `seeking to become a partner` `the terms or conditions on which the work or position is offered` 3 EQUALS JUST "s 18(1)(b) or (2)(b)"
#ASSERT `Which section covers what was done to me at work?` `seeking to become a partner` `deciding who is offered the work` 2 EQUALS NOTHING
#ASSERT `Which section covers what was done to me at work?` `a partner` `dismissing me or ending my engagement or position or membership` 3 EQUALS JUST "s 18(3)(b)"
#ASSERT `Which section covers what was done to me at work?` `a partner` `denying or limiting my access to promotion or transfer or training or other benefits` 3 EQUALS JUST "s 18(3)(a)"
#ASSERT `Which section covers what was done to me at work?` `a partner` `dismissing me or ending my engagement or position or membership` 2 EQUALS NOTHING
#ASSERT `Which section covers what was done to me at work?` `a partner` `the terms or conditions of my work or position` 5 EQUALS NOTHING
#ASSERT `Which section covers what was done to me at work?` `seeking or holding an authorisation or qualification for my profession or trade or occupation` `refusing or failing to grant or renew or extend or accept` 0 EQUALS JUST "s 19(a)"
#ASSERT `Which section covers what was done to me at work?` `seeking or holding an authorisation or qualification for my profession or trade or occupation` `the terms or conditions on which the work or position is offered` 0 EQUALS JUST "s 19(b)"
#ASSERT `Which section covers what was done to me at work?` `seeking or holding an authorisation or qualification for my profession or trade or occupation` `dismissing me or ending my engagement or position or membership` 0 EQUALS JUST "s 19(c)"
#ASSERT `Which section covers what was done to me at work?` `applying to join a registered organisation` `refusing or failing to grant or renew or extend or accept` 0 EQUALS JUST "s 20(1)(a)"
#ASSERT `Which section covers what was done to me at work?` `a member of a registered organisation` `the terms or conditions of my work or position` 0 EQUALS JUST "s 20(2)(b)"
#ASSERT `Which section covers what was done to me at work?` `a member of a registered organisation` `subjecting me to any other detriment` 0 EQUALS JUST "s 20(2)(c)"
#ASSERT `Which section covers what was done to me at work?` `a person using an employment agency` `refusing or failing to grant or renew or extend or accept` 0 EQUALS JUST "s 21(1)(a)"
#ASSERT `Which section covers what was done to me at work?` `a person using an employment agency` `the manner in which a service is provided to me` 0 EQUALS JUST "s 21(1)(c)"
#ASSERT `Which section covers what was done to me at work?` `a person using an employment agency` `dismissing me or ending my engagement or position or membership` 0 EQUALS NOTHING

§§ `s 12 -- reach`

-- Order: position, Territory, Commonwealth employee, Commonwealth qualification, Commonwealth body, treaty head,
-- corporation, banking or insurance, interstate or overseas trade, matters outside Australia.
#ASSERT `Does the Act reach what was done to me?` `an employee` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Does the Act reach what was done to me?` `an employee` FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Does the Act reach what was done to me?` `an employee` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Does the Act reach what was done to me?` `an employee` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Does the Act reach what was done to me?` `a contract worker` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- s 12(5) reaches ss 15, 16 and 17 only: not an agency client, not a partner.
#ASSERT `Does the Act reach what was done to me?` `a person using an employment agency` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Does the Act reach what was done to me?` `a partner` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- s 12(6) reaches s 19 only.
#ASSERT `Does the Act reach what was done to me?` `seeking or holding an authorisation or qualification for my profession or trade or occupation` FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Does the Act reach what was done to me?` `an employee` FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Does the Act reach what was done to me?` `an employee` FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Does the Act reach what was done to me?` `an employee` FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Does the Act reach what was done to me?` `an employee` FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Does the Act reach what was done to me?` `an employee` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Does the Act reach what was done to me?` `an employee` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- s 20 is not a limited application provision (s 12(1)): it reaches everywhere.
#ASSERT `Does the Act reach what was done to me?` `a member of a registered organisation` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Does the Act reach what was done to me?` `applying to join a registered organisation` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE

§§ `s 21A -- inherent requirements`

#ASSERT `Does the inherent requirements exception apply?` `an employee` `dismissing me or ending my engagement or position or membership` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Does the inherent requirements exception apply?` `an employee` `dismissing me or ending my engagement or position or membership` FALSE TRUE EQUALS JUST FALSE
#ASSERT `Does the inherent requirements exception apply?` `an employee` `dismissing me or ending my engagement or position or membership` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Does the inherent requirements exception apply?` `seeking employment` `deciding who is offered the work` TRUE TRUE EQUALS JUST TRUE
-- s 21A(4)(a): 15(2)(b) and (d) are out, except deciding who is offered promotion or transfer.
#ASSERT `Does the inherent requirements exception apply?` `an employee` `denying or limiting my access to promotion or transfer or training or other benefits` TRUE TRUE EQUALS JUST FALSE
#ASSERT `Does the inherent requirements exception apply?` `an employee` `subjecting me to any other detriment` TRUE TRUE EQUALS JUST FALSE
#ASSERT `Does the inherent requirements exception apply?` `an employee` `deciding who is offered promotion or transfer` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Does the inherent requirements exception apply?` `a contract worker` `deciding who is offered promotion or transfer` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Does the inherent requirements exception apply?` `a contract worker` `subjecting me to any other detriment` TRUE TRUE EQUALS JUST FALSE
-- 18(3)(c) is out; 18(3)(a) and (b) are not.
#ASSERT `Does the inherent requirements exception apply?` `a partner` `subjecting me to any other detriment` TRUE TRUE EQUALS JUST FALSE
#ASSERT `Does the inherent requirements exception apply?` `a partner` `denying or limiting my access to promotion or transfer or training or other benefits` TRUE TRUE EQUALS JUST TRUE
-- s 21A(4)(b): never s 20.
#ASSERT `Does the inherent requirements exception apply?` `applying to join a registered organisation` `refusing or failing to grant or renew or extend or accept` TRUE TRUE EQUALS JUST FALSE

§§ `Division 1 -- the whole question`

DECLARE `Test exemption` IS ONE OF
    `no exemption`, `special measure`, `special measure not needing it`, `special measure about pay`,
    `super on data`, `super without data`, `super unreasonable`, `court order`, `capacity wages`, `prescribed law`,
    `infectious`, `migration`, `defence`, `peacekeeping`, `animal infectious`, `animal evidence`, `commission exemption`

-- One case of the whole question: the named facts vary; every other fact is FALSE. The person's condition is a loss of
-- bodily function unless given; the discrimination is plain less favourable treatment for that reason unless `lf` is
-- FALSE; reach is through a trading corporation unless `corp` is FALSE.
GIVEN p IS A `My position at work`, a IS A `What was done`, n IS A NUMBER, dom IS A BOOLEAN,
      g IS A `The ground of a complaint`, c IS A `Kind of condition`, w IS A `Who the other person is to me`,
      h IS A `What assists me`, ok9 IS A BOOLEAN, lf IS A BOOLEAN,
      cthEmp IS A BOOLEAN, cthQual IS A BOOLEAN, corp IS A BOOLEAN,
      pw IS A BOOLEAN, un IS A BOOLEAN, hs IS A BOOLEAN, x IS A `Test exemption`
GIVETH A `What the Act says about what was done to me at work`
`case` p a n dom g c w h ok9 lf cthEmp cthQual corp pw un hs x MEANS
    `Is what was done to me at work unlawful disability discrimination?` p a n dom (`the ground for` g) c w h
        ok9 ok9 ok9 ok9 ok9 ok9 ok9
        lf lf FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE
        FALSE cthEmp cthQual FALSE FALSE corp FALSE FALSE FALSE
        pw un hs
        (x EQUALS `special measure` OR x EQUALS `special measure not needing it` OR x EQUALS `special measure about pay`)
        (x EQUALS `special measure not needing it`) (x EQUALS `special measure about pay`)
        (x EQUALS `super on data` OR x EQUALS `super without data` OR x EQUALS `super unreasonable`)
        (x EQUALS `super on data`) (x EQUALS `super on data`) (x EQUALS `super without data`) (x EQUALS `super without data`)
        (x EQUALS `court order`) (x EQUALS `capacity wages`) (x EQUALS `prescribed law`)
        (x EQUALS `infectious`) (x EQUALS `infectious`)
        (x EQUALS `migration`) (x EQUALS `defence`) (x EQUALS `peacekeeping`)
        (x EQUALS `animal infectious`) (x EQUALS `animal infectious`) (x EQUALS `animal evidence`)
        (x EQUALS `commission exemption`)

DECLARE `The ground of a complaint` IS ONE OF `own`, `aid`, `associate`

GIVEN g IS A `The ground of a complaint`
GIVETH A `The ground`
`the ground for` g MEANS
    CONSIDER g
    WHEN `own` THEN `my own disability`
    WHEN `aid` THEN `my carer or assistant or assistance animal or disability aid`
    WHEN `associate` THEN `the disability of an associate of mine`

`loss` MEANS `total or partial loss of bodily or mental functions`
`dismissal` MEANS `dismissing me or ending my engagement or position or membership`
`detriment` MEANS `subjecting me to any other detriment`
`denial` MEANS `denying or limiting my access to promotion or transfer or training or other benefits`
`promotion decision` MEANS `deciding who is offered promotion or transfer`
`refusal` MEANS `refusing or failing to grant or renew or extend or accept`
`exception` MEANS `not unlawful: an exception or exemption applies`

-- s 15(2)(c): an employee dismissed because of a disability, by a trading corporation.
#ASSERT `case` `an employee` `dismissal` 0 FALSE `own` `loss` `someone else` `a carer` TRUE TRUE FALSE FALSE TRUE FALSE FALSE FALSE `no exemption` EQUALS `unlawful discrimination under` "s 15(2)(c)"
#ASSERT `case` `seeking employment` `deciding who is offered the work` 0 FALSE `own` `loss` `someone else` `a carer` TRUE TRUE FALSE FALSE TRUE FALSE FALSE FALSE `no exemption` EQUALS `unlawful discrimination under` "s 15(1)(b)"
-- s 15(3): domestic duties in the employer's home take (1)(a) and (b) out, not (1)(c).
#ASSERT `case` `seeking employment` `the arrangements made for deciding who is offered the work` 0 TRUE `own` `loss` `someone else` `a carer` TRUE TRUE FALSE FALSE TRUE FALSE FALSE FALSE `no exemption` EQUALS `exception` "s 15(3) (domestic duties in the employer's home)"
#ASSERT `case` `seeking employment` `deciding who is offered the work` 0 TRUE `own` `loss` `someone else` `a carer` TRUE TRUE FALSE FALSE TRUE FALSE FALSE FALSE `no exemption` EQUALS `exception` "s 15(3) (domestic duties in the employer's home)"
#ASSERT `case` `seeking employment` `the terms or conditions on which the work or position is offered` 0 TRUE `own` `loss` `someone else` `a carer` TRUE TRUE FALSE FALSE TRUE FALSE FALSE FALSE `no exemption` EQUALS `unlawful discrimination under` "s 15(1)(c)"
-- An act s 15 does not list for an employee.
#ASSERT `case` `an employee` `refusal` 0 FALSE `own` `loss` `someone else` `a carer` TRUE TRUE FALSE FALSE TRUE FALSE FALSE FALSE `no exemption` EQUALS `not an act that sections 15 to 21 list for my position`
-- The ground: no disability; an associate the list does not name; a relative.
#ASSERT `case` `an employee` `dismissal` 0 FALSE `own` `none of these` `someone else` `a carer` TRUE TRUE FALSE FALSE TRUE FALSE FALSE FALSE `no exemption` EQUALS `not on a ground the Act covers`
#ASSERT `case` `an employee` `dismissal` 0 FALSE `associate` `loss` `someone else` `a carer` TRUE TRUE FALSE FALSE TRUE FALSE FALSE FALSE `no exemption` EQUALS `not shown to be on a ground the Act covers`
#ASSERT `case` `an employee` `dismissal` 0 FALSE `associate` `loss` `a person I care for who is not my relative` `a carer` TRUE TRUE FALSE FALSE TRUE FALSE FALSE FALSE `no exemption` EQUALS `not shown to be on a ground the Act covers`
#ASSERT `case` `an employee` `dismissal` 0 FALSE `associate` `loss` `my relative by blood or marriage or affinity or adoption` `a carer` TRUE TRUE FALSE FALSE TRUE FALSE FALSE FALSE `no exemption` EQUALS `unlawful discrimination under` "s 15(2)(c)"
#ASSERT `case` `an employee` `dismissal` 0 FALSE `associate` `none of these` `my spouse` `a carer` TRUE TRUE FALSE FALSE TRUE FALSE FALSE FALSE `no exemption` EQUALS `not on a ground the Act covers`
-- s 8 with s 9: a carer who helps because of the disability; another kind of helper; an animal that is not an assistance animal.
#ASSERT `case` `an employee` `dismissal` 0 FALSE `aid` `loss` `someone else` `a carer` TRUE TRUE FALSE FALSE TRUE FALSE FALSE FALSE `no exemption` EQUALS `unlawful discrimination under` "s 15(2)(c)"
#ASSERT `case` `an employee` `dismissal` 0 FALSE `aid` `loss` `someone else` `another kind of helper` TRUE TRUE FALSE FALSE TRUE FALSE FALSE FALSE `no exemption` EQUALS `not on a ground the Act covers`
#ASSERT `case` `an employee` `dismissal` 0 FALSE `aid` `loss` `someone else` `an animal` FALSE TRUE FALSE FALSE TRUE FALSE FALSE FALSE `no exemption` EQUALS `not on a ground the Act covers`
-- Not discrimination.
#ASSERT `case` `an employee` `dismissal` 0 FALSE `own` `loss` `someone else` `a carer` TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE `no exemption` EQUALS `not discrimination as sections 5 and 6 define it`
-- s 12: no head; a Commonwealth employee; s 20 everywhere.
#ASSERT `case` `an employee` `dismissal` 0 FALSE `own` `loss` `someone else` `a carer` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE `no exemption` EQUALS `not unlawful: outside the reach of the Act (s 12)`
#ASSERT `case` `an employee` `dismissal` 0 FALSE `own` `loss` `someone else` `a carer` TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE `no exemption` EQUALS `unlawful discrimination under` "s 15(2)(c)"
#ASSERT `case` `a person using an employment agency` `refusal` 0 FALSE `own` `loss` `someone else` `a carer` TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE `no exemption` EQUALS `not unlawful: outside the reach of the Act (s 12)`
#ASSERT `case` `seeking or holding an authorisation or qualification for my profession or trade or occupation` `refusal` 0 FALSE `own` `loss` `someone else` `a carer` TRUE TRUE FALSE TRUE FALSE FALSE FALSE FALSE `no exemption` EQUALS `unlawful discrimination under` "s 19(a)"
#ASSERT `case` `a member of a registered organisation` `detriment` 0 FALSE `own` `loss` `someone else` `a carer` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE `no exemption` EQUALS `unlawful discrimination under` "s 20(2)(c)"
-- s 21A and s 21A(4).
#ASSERT `case` `an employee` `dismissal` 0 FALSE `own` `loss` `someone else` `a carer` TRUE TRUE FALSE FALSE TRUE TRUE TRUE FALSE `no exemption` EQUALS `exception` "s 21A (inherent requirements)"
#ASSERT `case` `an employee` `denial` 0 FALSE `own` `loss` `someone else` `a carer` TRUE TRUE FALSE FALSE TRUE TRUE TRUE FALSE `no exemption` EQUALS `unlawful discrimination under` "s 15(2)(b)"
#ASSERT `case` `an employee` `promotion decision` 0 FALSE `own` `loss` `someone else` `a carer` TRUE TRUE FALSE FALSE TRUE TRUE TRUE FALSE `no exemption` EQUALS `exception` "s 21A (inherent requirements)"
#ASSERT `case` `a contract worker` `promotion decision` 0 FALSE `own` `loss` `someone else` `a carer` TRUE TRUE FALSE FALSE TRUE TRUE TRUE FALSE `no exemption` EQUALS `exception` "s 21A (inherent requirements)"
#ASSERT `case` `a contract worker` `denial` 0 FALSE `own` `loss` `someone else` `a carer` TRUE TRUE FALSE FALSE TRUE TRUE TRUE FALSE `no exemption` EQUALS `unlawful discrimination under` "s 17(c)"
#ASSERT `case` `a partner` `detriment` 3 FALSE `own` `loss` `someone else` `a carer` TRUE TRUE FALSE FALSE TRUE TRUE TRUE FALSE `no exemption` EQUALS `unlawful discrimination under` "s 18(3)(c)"
#ASSERT `case` `a partner` `dismissal` 3 FALSE `own` `loss` `someone else` `a carer` TRUE TRUE FALSE FALSE TRUE TRUE TRUE FALSE `no exemption` EQUALS `exception` "s 21A (inherent requirements)"
#ASSERT `case` `a partner` `dismissal` 2 FALSE `own` `loss` `someone else` `a carer` TRUE TRUE FALSE FALSE TRUE FALSE FALSE FALSE `no exemption` EQUALS `not an act that sections 15 to 21 list for my position`
