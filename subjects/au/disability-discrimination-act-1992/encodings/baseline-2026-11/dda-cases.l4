-- s 21B.
#ASSERT `case` `an employee` `dismissal` 0 FALSE `own` `loss` `someone else` `a carer` TRUE TRUE FALSE FALSE TRUE FALSE FALSE TRUE `no exemption` EQUALS `exception` "s 21B (unjustifiable hardship)"
-- Division 5: s 45 and its limits.
#ASSERT `case` `an employee` `dismissal` 0 FALSE `own` `loss` `someone else` `a carer` TRUE TRUE FALSE FALSE TRUE FALSE FALSE FALSE `special measure` EQUALS `exception` "s 45 (special measures)"
#ASSERT `case` `an employee` `dismissal` 0 FALSE `own` `loss` `someone else` `a carer` TRUE TRUE FALSE FALSE TRUE FALSE FALSE FALSE `special measure not needing it` EQUALS `unlawful discrimination under` "s 15(2)(c)"
#ASSERT `case` `an employee` `the terms or conditions of my work or position` 0 FALSE `own` `loss` `someone else` `a carer` TRUE TRUE FALSE FALSE TRUE FALSE FALSE FALSE `special measure about pay` EQUALS `unlawful discrimination under` "s 15(2)(a)"
-- s 46: with data, without data, neither.
#ASSERT `case` `an employee` `the terms or conditions of my work or position` 0 FALSE `own` `loss` `someone else` `a carer` TRUE TRUE FALSE FALSE TRUE FALSE FALSE FALSE `super on data` EQUALS `exception` "s 46 (superannuation and insurance)"
#ASSERT `case` `an employee` `the terms or conditions of my work or position` 0 FALSE `own` `loss` `someone else` `a carer` TRUE TRUE FALSE FALSE TRUE FALSE FALSE FALSE `super without data` EQUALS `exception` "s 46 (superannuation and insurance)"
#ASSERT `case` `an employee` `the terms or conditions of my work or position` 0 FALSE `own` `loss` `someone else` `a carer` TRUE TRUE FALSE FALSE TRUE FALSE FALSE FALSE `super unreasonable` EQUALS `unlawful discrimination under` "s 15(2)(a)"
-- s 47.
#ASSERT `case` `an employee` `the terms or conditions of my work or position` 0 FALSE `own` `loss` `someone else` `a carer` TRUE TRUE FALSE FALSE TRUE FALSE FALSE FALSE `capacity wages` EQUALS `exception` "s 47 (acts done under statutory authority)"
