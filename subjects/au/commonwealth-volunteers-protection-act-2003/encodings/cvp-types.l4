IMPORT prelude

-- Commonwealth Volunteers Protection Act 2003 (Cth) — THE NOUNS.
-- Source: ../registers/source-bundle/C2004A01087.txt (compilation C2011C00290).
-- Seat: the volunteer.

§ `Nouns`

DECLARE `Whom the work was for` IS ONE OF
    `the Commonwealth`
    `a Commonwealth authority`
    `someone else`

-- s 4(2)-(3)
DECLARE `How I was paid` IS ONE OF
    -- s 4(2)(a)(i)
    `nothing but reasonable expenses`
    -- s 4(2)(a)(ii)
    `less than the prescribed amount`
    -- s 4(3)(a): my usual employer kept paying me, and nothing else beyond
    -- expenses or less than the prescribed amount
    `my usual pay from my employer only`
    `more than that`

-- s 6(2)
DECLARE `Kind of liability` IS ONE OF
    `covered by compulsory third-party motor vehicle insurance`
    `defamation`
    `another civil liability`

DECLARE `Volunteer case` HAS
    `the work was for`                                  IS A `Whom the work was for`
    `organised by them`                                 IS A BOOLEAN
    `how I was paid`                                    IS A `How I was paid`
    -- s 4(3)(b): the work is usually done by unpaid or low-paid people
    `the work is usually done unpaid`                   IS A BOOLEAN
    `under a court order`                               IS A BOOLEAN
    `done in good faith`                                IS A BOOLEAN
    -- s 5
    `done after the Act commenced`                      IS A BOOLEAN
    `the liability`                                     IS A `Kind of liability`
    -- s 6(3)
    `significantly impaired by a recreational drug`     IS A BOOLEAN
    -- s 6(4)(a)-(b): and I knew or ought to have known
    `knowingly outside the authorised activities`       IS A BOOLEAN
    `knowingly contrary to instructions`                IS A BOOLEAN
    -- s 7(2)
    `another Act protects the authority`                IS A BOOLEAN
    -- s 8
    `asked to assist`                                   IS A BOOLEAN

DECLARE `Who bears the liability` IS ONE OF
    `the Commonwealth or the authority`
    `no one under this Act: the authority's own protection applies`
    `I do`
    `this Act does not apply`

DECLARE `Volunteer position` HAS
    `voluntary basis`                                   IS A BOOLEAN
    `I am protected`                                    IS A BOOLEAN
    `who bears it`                                      IS A `Who bears the liability`
    `I must assist`                                     IS A BOOLEAN
    `my indemnity has effect`                           IS A BOOLEAN
