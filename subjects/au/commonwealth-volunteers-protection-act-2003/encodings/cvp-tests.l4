IMPORT prelude
IMPORT `cvp-types`
IMPORT `cvp-rules`

-- Commonwealth Volunteers Protection Act 2003 (Cth) — the encoder's tests.

§ `Tests`

-- Fields: for, organised, paid, usually unpaid, court order, good faith,
-- after commencement, liability, drugs, outside scope, contrary to
-- instructions, authority protected, asked to assist.
base MEANS `Volunteer case` OF `the Commonwealth`, TRUE, `nothing but reasonable expenses`, FALSE, FALSE, TRUE, TRUE, `another civil liability`, FALSE, FALSE, FALSE, FALSE, TRUE

#ASSERT `on a voluntary basis` base
#ASSERT `I am protected under s 6` base
#ASSERT `who bears the liability for` base EQUALS `the Commonwealth or the authority`
#ASSERT `I must assist for` base
#ASSERT NOT (`an indemnity I gave has effect for` base)

-- s 4
#ASSERT `on a voluntary basis` (`Volunteer case` OF `the Commonwealth`, TRUE, `less than the prescribed amount`, FALSE, FALSE, TRUE, TRUE, `another civil liability`, FALSE, FALSE, FALSE, FALSE, FALSE)
#ASSERT `on a voluntary basis` (`Volunteer case` OF `the Commonwealth`, TRUE, `my usual pay from my employer only`, TRUE, FALSE, TRUE, TRUE, `another civil liability`, FALSE, FALSE, FALSE, FALSE, FALSE)
#ASSERT NOT (`on a voluntary basis` (`Volunteer case` OF `the Commonwealth`, TRUE, `my usual pay from my employer only`, FALSE, FALSE, TRUE, TRUE, `another civil liability`, FALSE, FALSE, FALSE, FALSE, FALSE))
#ASSERT NOT (`on a voluntary basis` (`Volunteer case` OF `the Commonwealth`, TRUE, `more than that`, TRUE, FALSE, TRUE, TRUE, `another civil liability`, FALSE, FALSE, FALSE, FALSE, FALSE))
#ASSERT NOT (`on a voluntary basis` (`Volunteer case` OF `the Commonwealth`, TRUE, `nothing but reasonable expenses`, FALSE, TRUE, TRUE, TRUE, `another civil liability`, FALSE, FALSE, FALSE, FALSE, FALSE))

-- s 6 exceptions
#ASSERT `who bears the liability for` (`Volunteer case` OF `the Commonwealth`, TRUE, `nothing but reasonable expenses`, FALSE, FALSE, TRUE, TRUE, `defamation`, FALSE, FALSE, FALSE, FALSE, TRUE) EQUALS `I do`
#ASSERT `who bears the liability for` (`Volunteer case` OF `the Commonwealth`, TRUE, `nothing but reasonable expenses`, FALSE, FALSE, TRUE, TRUE, `covered by compulsory third-party motor vehicle insurance`, FALSE, FALSE, FALSE, FALSE, TRUE) EQUALS `I do`
#ASSERT `who bears the liability for` (`Volunteer case` OF `the Commonwealth`, TRUE, `nothing but reasonable expenses`, FALSE, FALSE, TRUE, TRUE, `another civil liability`, TRUE, FALSE, FALSE, FALSE, TRUE) EQUALS `I do`
#ASSERT `who bears the liability for` (`Volunteer case` OF `the Commonwealth`, TRUE, `nothing but reasonable expenses`, FALSE, FALSE, TRUE, TRUE, `another civil liability`, FALSE, TRUE, FALSE, FALSE, TRUE) EQUALS `I do`
#ASSERT `who bears the liability for` (`Volunteer case` OF `the Commonwealth`, TRUE, `nothing but reasonable expenses`, FALSE, FALSE, TRUE, TRUE, `another civil liability`, FALSE, FALSE, TRUE, FALSE, TRUE) EQUALS `I do`
#ASSERT `who bears the liability for` (`Volunteer case` OF `the Commonwealth`, TRUE, `nothing but reasonable expenses`, FALSE, FALSE, FALSE, TRUE, `another civil liability`, FALSE, FALSE, FALSE, FALSE, TRUE) EQUALS `I do`
#ASSERT `who bears the liability for` (`Volunteer case` OF `the Commonwealth`, FALSE, `nothing but reasonable expenses`, FALSE, FALSE, TRUE, TRUE, `another civil liability`, FALSE, FALSE, FALSE, FALSE, TRUE) EQUALS `I do`
#ASSERT NOT (`I must assist for` (`Volunteer case` OF `the Commonwealth`, TRUE, `nothing but reasonable expenses`, FALSE, FALSE, TRUE, TRUE, `defamation`, FALSE, FALSE, FALSE, FALSE, TRUE))
#ASSERT `an indemnity I gave has effect for` (`Volunteer case` OF `the Commonwealth`, TRUE, `nothing but reasonable expenses`, FALSE, FALSE, TRUE, TRUE, `defamation`, FALSE, FALSE, FALSE, FALSE, TRUE)

-- s 7(2), s 5, other bodies
#ASSERT `who bears the liability for` (`Volunteer case` OF `a Commonwealth authority`, TRUE, `nothing but reasonable expenses`, FALSE, FALSE, TRUE, TRUE, `another civil liability`, FALSE, FALSE, FALSE, TRUE, TRUE) EQUALS `no one under this Act: the authority's own protection applies`
#ASSERT `who bears the liability for` (`Volunteer case` OF `a Commonwealth authority`, TRUE, `nothing but reasonable expenses`, FALSE, FALSE, TRUE, TRUE, `another civil liability`, FALSE, FALSE, FALSE, FALSE, TRUE) EQUALS `the Commonwealth or the authority`
#ASSERT `who bears the liability for` (`Volunteer case` OF `the Commonwealth`, TRUE, `nothing but reasonable expenses`, FALSE, FALSE, TRUE, TRUE, `another civil liability`, FALSE, FALSE, FALSE, TRUE, TRUE) EQUALS `the Commonwealth or the authority`
#ASSERT `who bears the liability for` (`Volunteer case` OF `the Commonwealth`, TRUE, `nothing but reasonable expenses`, FALSE, FALSE, TRUE, FALSE, `another civil liability`, FALSE, FALSE, FALSE, FALSE, TRUE) EQUALS `this Act does not apply`
#ASSERT `who bears the liability for` (`Volunteer case` OF `someone else`, TRUE, `nothing but reasonable expenses`, FALSE, FALSE, TRUE, TRUE, `another civil liability`, FALSE, FALSE, FALSE, FALSE, TRUE) EQUALS `this Act does not apply`
#ASSERT NOT (`I must assist for` (`Volunteer case` OF `the Commonwealth`, TRUE, `nothing but reasonable expenses`, FALSE, FALSE, TRUE, TRUE, `another civil liability`, FALSE, FALSE, FALSE, FALSE, FALSE))

-- The top-level goal.
#ASSERT (`the volunteer position for` base)'s `voluntary basis`
#ASSERT (`the volunteer position for` base)'s `I am protected`
#ASSERT (`the volunteer position for` base)'s `who bears it` EQUALS `the Commonwealth or the authority`
#ASSERT (`the volunteer position for` base)'s `I must assist`
#ASSERT NOT ((`the volunteer position for` base)'s `my indemnity has effect`)
