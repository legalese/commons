IMPORT prelude
IMPORT `th-rules`

-- Trusts (Hague Convention) Act 1991 (Cth) — the encoder's tests.

§ `Tests`

-- A written express trust choosing English law, which provides for trusts.
GIVEN interstate IS A BOOLEAN, chose IS A BOOLEAN, chosenok IS A BOOLEAN, closeok IS A BOOLEAN
GIVETH A `Trust case`
`a trust` interstate `chosen` chose `chosen law has trusts` chosenok `close law has trusts` closeok MEANS
    `Trust case` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, interstate, chose, chosenok, closeok, TRUE, FALSE, FALSE

#ASSERT `the Convention applies` (`a trust` FALSE `chosen` TRUE `chosen law has trusts` TRUE `close law has trusts` FALSE)
#ASSERT `the governing law for` (`a trust` FALSE `chosen` TRUE `chosen law has trusts` TRUE `close law has trusts` FALSE) EQUALS `the law the settlor chose`
#ASSERT `must my trust be recognised` (`a trust` FALSE `chosen` TRUE `chosen law has trusts` TRUE `close law has trusts` FALSE) EQUALS JUST TRUE
-- Article 6, third paragraph: the chosen law has no trusts, so Article 7.
#ASSERT `the governing law for` (`a trust` FALSE `chosen` TRUE `chosen law has trusts` FALSE `close law has trusts` TRUE) EQUALS `the law with which the trust is most closely connected`
#ASSERT `the Convention applies` (`a trust` FALSE `chosen` TRUE `chosen law has trusts` FALSE `close law has trusts` TRUE)
-- Article 5: neither law has trusts.
#ASSERT NOT (`the Convention applies` (`a trust` FALSE `chosen` TRUE `chosen law has trusts` FALSE `close law has trusts` FALSE))
#ASSERT (`the trust position for` (`a trust` FALSE `chosen` TRUE `chosen law has trusts` FALSE `close law has trusts` FALSE))'s `my trust is governed by` EQUALS NOTHING
-- no choice
#ASSERT `the governing law for` (`a trust` FALSE `chosen` FALSE `chosen law has trusts` TRUE `close law has trusts` TRUE) EQUALS `the law with which the trust is most closely connected`
-- s 7(1)
#ASSERT NOT (`the Convention applies` (`a trust` TRUE `chosen` TRUE `chosen law has trusts` TRUE `close law has trusts` TRUE))
-- Article 3: oral or not voluntary
#ASSERT NOT (`the Convention applies` (`Trust case` OF TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, FALSE, TRUE, TRUE, TRUE, TRUE, FALSE, FALSE))
#ASSERT NOT (`the Convention applies` (`Trust case` OF TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, FALSE, FALSE))
-- Article 2: assets not a separate fund
#ASSERT NOT (`the Convention applies` (`Trust case` OF TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, FALSE, FALSE))
-- Articles 11, 13, 18
#ASSERT `must my trust be recognised` (`Trust case` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE) EQUALS JUST FALSE
#ASSERT `must my trust be recognised` (`Trust case` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE) EQUALS NOTHING
#ASSERT `must my trust be recognised` (`Trust case` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE) EQUALS NOTHING
#ASSERT `must my trust be recognised` (`a trust` TRUE `chosen` TRUE `chosen law has trusts` TRUE `close law has trusts` TRUE) EQUALS NOTHING
