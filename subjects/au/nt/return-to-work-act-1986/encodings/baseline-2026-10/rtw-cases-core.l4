#ASSERT EVALTRACE (`s 65C -- the employer must not dismiss an incapacitated worker within 6 months of the injury` TRUE TRUE 184) 0 (LIST (EVENT `the employer` `dismiss the worker` 100)) EQUALS FULFILLED
