-- by 28 February 2029.
#ASSERT `By when must I apply for an increase` (DATE_FROM_DMY 1 1 2026) (DATE_FROM_DMY 29 2 2008) EQUALS DATE_FROM_DMY 28 2 2029
-- Ben applies 1 March 2029, the assessor satisfied, the maximum not reached: yes. On 16 March 2029: out of time. The
-- maximum already awarded: no (s 46(5)(b)). Not satisfied: no.
#ASSERT `Can my award be increased` (DATE_FROM_DMY 15 3 2026) (DATE_FROM_DMY 1 1 1990) (DATE_FROM_DMY 1 3 2029) TRUE FALSE EQUALS TRUE
#ASSERT `Can my award be increased` (DATE_FROM_DMY 15 3 2026) (DATE_FROM_DMY 1 1 1990) (DATE_FROM_DMY 16 3 2029) TRUE FALSE EQUALS FALSE
#ASSERT `Can my award be increased` (DATE_FROM_DMY 15 3 2026) (DATE_FROM_DMY 1 1 1990) (DATE_FROM_DMY 1 3 2029) TRUE TRUE EQUALS FALSE
#ASSERT `Can my award be increased` (DATE_FROM_DMY 15 3 2026) (DATE_FROM_DMY 1 1 1990) (DATE_FROM_DMY 1 3 2029) FALSE FALSE EQUALS FALSE
-- A refund notice giving 14 days: READING, at least 28 (s 47(2)(c)). One giving 42: 42.
#ASSERT `How long do I have to refund` 14 EQUALS 28
#ASSERT `How long do I have to refund` 42 EQUALS 42

