#ASSERT `s 22 -- must the coroner tell me of the autopsy` TRUE `prison` FALSE EQUALS `NOT DIRECTED`
#ASSERT `s 22 -- must the coroner tell me of the autopsy` FALSE `prison` TRUE EQUALS `S22 SNOK ONLY`

