    WHEN FULFILLED THEN TRUE
    OTHERWISE FALSE
#ASSERT `the details come on day 28` EQUALS TRUE
`the details come on day 29` MEANS
    CONSIDER EVALTRACE `s 32J(5) -- the public entity must give me the details within 28 days` 0 (LIST (EVENT `the public entity defendant` `give me the details I asked for about the money held on trust` 29))
    WHEN FULFILLED THEN TRUE
    OTHERWISE FALSE
#ASSERT `the details come on day 29` EQUALS FALSE
