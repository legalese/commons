IMPORT prelude
IMPORT `nt-part7-construction`

-- Tests of nt-part7-construction.l4 (sections 58 to 62E).
-- Every expected value is written from the text of the section named beside it.

§ `Sections 58 to 62`

#ASSERT `s 58: the amending Act is construed with the other Act or law and as part of it` TRUE EQUALS JUST TRUE
#ASSERT `s 58: the amending Act is construed with the other Act or law and as part of it` FALSE EQUALS NOTHING
-- 59: an Act that would exceed the power stands to the extent it does not.
#ASSERT `s 59: the part of the Act stands` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 59: the part of the Act stands` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 59: the part of the Act stands` FALSE TRUE EQUALS NOTHING
-- 59A(1).
#ASSERT `s 59A(1): the reference includes the place` TRUE `a place that is on Aboriginal land and that, but for that fact, the reference would have included` TRUE EQUALS JUST TRUE
#ASSERT `s 59A(1): the reference includes the place` TRUE `a place that is on Aboriginal land and that, but for that fact, the reference would have included` FALSE EQUALS JUST TRUE
#ASSERT `s 59A(1): the reference includes the place` TRUE `a place on Aboriginal land that the reference would not have included` TRUE EQUALS NOTHING
#ASSERT `s 59A(1): the reference includes the place` TRUE `a place that is not on Aboriginal land` FALSE EQUALS NOTHING
#ASSERT `s 59A(1): the reference includes the place` FALSE `a place that is on Aboriginal land and that, but for that fact, the reference would have included` TRUE EQUALS NOTHING
-- 59A(2).
#ASSERT `s 59A(2): the persons are capable of constituting a section of the public in relation to the land` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 59A(2): the persons are capable of constituting a section of the public in relation to the land` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 59A(2): the persons are capable of constituting a section of the public in relation to the land` FALSE FALSE EQUALS NOTHING
-- 61, 62.
#ASSERT `s 61(1): the part of the instrument stands` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 61(1): the part of the instrument stands` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 61(1): the part of the instrument stands` FALSE TRUE EQUALS NOTHING
#ASSERT `s 61(2): the conditions and steps required for the making of the instrument are presumed to have been satisfied and carried out` FALSE EQUALS JUST TRUE
#ASSERT `s 61(2): the conditions and steps required for the making of the instrument are presumed to have been satisfied and carried out` TRUE EQUALS JUST FALSE
#ASSERT `s 62: the part of the resolution stands` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 62: the part of the resolution stands` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 62: the part of the resolution stands` FALSE FALSE EQUALS NOTHING

§ `Sections 62A to 62E`

#ASSERT `s 62A: the first construction is to be preferred to the second` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 62A: the first construction is to be preferred to the second` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 62A: the first construction is to be preferred to the second` TRUE TRUE EQUALS NOTHING
#ASSERT `s 62A: the first construction is to be preferred to the second` FALSE FALSE EQUALS NOTHING
-- 62B(1)(a), (b)(i), (b)(ii).
#ASSERT `s 62B(1): the material may be considered` TRUE `to confirm that the meaning of the provision is the ordinary meaning conveyed by its text, in its context and in the light of the purpose or object underlying the Act` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 62B(1): the material may be considered` TRUE `to determine the meaning of the provision` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 62B(1): the material may be considered` TRUE `to determine the meaning of the provision` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 62B(1): the material may be considered` TRUE `to determine the meaning of the provision` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 62B(1): the material may be considered` TRUE `for some other purpose` TRUE TRUE EQUALS NOTHING
#ASSERT `s 62B(1): the material may be considered` FALSE `to determine the meaning of the provision` TRUE TRUE EQUALS NOTHING
-- 62B(2): the eight kinds.
#ASSERT `s 62B(2): the material is within the material that may be considered` `matters not forming part of the Act that are set out in the document containing the text of the Act as printed by the Government Printer` FALSE EQUALS JUST TRUE
#ASSERT `s 62B(2): the material is within the material that may be considered` `a report of a Royal Commission, Law Reform Commission, committee of inquiry or other similar body laid before the Legislative Assembly` TRUE EQUALS JUST TRUE
#ASSERT `s 62B(2): the material is within the material that may be considered` `a report of a Royal Commission, Law Reform Commission, committee of inquiry or other similar body laid before the Legislative Assembly` FALSE EQUALS NOTHING
#ASSERT `s 62B(2): the material is within the material that may be considered` `a report of a committee of the Legislative Assembly made to the Assembly` TRUE EQUALS JUST TRUE
#ASSERT `s 62B(2): the material is within the material that may be considered` `a report of a committee of the Legislative Assembly made to the Assembly` FALSE EQUALS NOTHING
#ASSERT `s 62B(2): the material is within the material that may be considered` `a treaty or other international agreement referred to in the Act` FALSE EQUALS JUST TRUE
#ASSERT `s 62B(2): the material is within the material that may be considered` `an explanatory memorandum relating to the Bill, or another relevant document, laid before or furnished to the members of the Assembly` TRUE EQUALS JUST TRUE
#ASSERT `s 62B(2): the material is within the material that may be considered` `an explanatory memorandum relating to the Bill, or another relevant document, laid before or furnished to the members of the Assembly` FALSE EQUALS NOTHING
#ASSERT `s 62B(2): the material is within the material that may be considered` `an explanatory speech or statement given to the Assembly on introducing the Bill` FALSE EQUALS JUST TRUE
#ASSERT `s 62B(2): the material is within the material that may be considered` `a document declared by the Act to be a relevant document for the purposes of section 62B` FALSE EQUALS JUST TRUE
#ASSERT `s 62B(2): the material is within the material that may be considered` `relevant material in an official record of debates in the Legislative Assembly` FALSE EQUALS JUST TRUE
#ASSERT `s 62B(2): the material is within the material that may be considered` `some other material` TRUE EQUALS NOTHING
-- 62C.
#ASSERT `s 62C: the ideas are taken to be different` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 62C: the ideas are taken to be different` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 62C: the ideas are taken to be different` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 62C: the ideas are taken to be different` FALSE TRUE TRUE EQUALS NOTHING
-- 62D, 62E.
#ASSERT `s 62D(a): the example is exhaustive` TRUE EQUALS JUST FALSE
#ASSERT `s 62D(a): the example is exhaustive` FALSE EQUALS NOTHING
#ASSERT `s 62D(b): the example limits or extends the meaning of the provision` TRUE EQUALS JUST FALSE
#ASSERT `s 62D(b): the example limits or extends the meaning of the provision` FALSE EQUALS NOTHING
#ASSERT `s 62D(c): the provision prevails over the example to the extent of the inconsistency` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 62D(c): the provision prevails over the example to the extent of the inconsistency` TRUE FALSE EQUALS NOTHING
#ASSERT `s 62D(c): the provision prevails over the example to the extent of the inconsistency` FALSE TRUE EQUALS NOTHING
#ASSERT `s 62E(1): the note is exhaustive or limits or extends the meaning of the provision` TRUE EQUALS JUST FALSE
#ASSERT `s 62E(1): the note is exhaustive or limits or extends the meaning of the provision` FALSE EQUALS NOTHING
#ASSERT `s 62E(2): the provision prevails over the note to the extent of the inconsistency` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 62E(2): the provision prevails over the note to the extent of the inconsistency` TRUE FALSE EQUALS NOTHING
#ASSERT `s 62E(2): the provision prevails over the note to the extent of the inconsistency` FALSE TRUE EQUALS NOTHING
