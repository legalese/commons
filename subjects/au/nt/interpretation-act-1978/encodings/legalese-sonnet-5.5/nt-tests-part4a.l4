IMPORT prelude
IMPORT `nt-part4a-penalties`

-- Tests of nt-part4a-penalties.l4 (sections 38B to 38G).
-- Every expected value is written from the text of the section named beside it.

§ `Section 38B`

#ASSERT `s 38B: the provision is read as referring to the offender` TRUE `an individual offender` EQUALS JUST TRUE
#ASSERT `s 38B: the provision is read as referring to the offender` TRUE `a body corporate offender` EQUALS JUST TRUE
#ASSERT `s 38B: the provision is read as referring to the offender` TRUE `some other offender` EQUALS NOTHING
#ASSERT `s 38B: the provision is read as referring to the offender` FALSE `a body corporate offender` EQUALS NOTHING

§ `Section 38C`

-- (1): a penalty at the foot of a section, or of a subsection, respectively.
#ASSERT `s 38C(1): the contravention is an offence against the Act` `a section of the Act` `a section of the Act` EQUALS JUST TRUE
#ASSERT `s 38C(1): the contravention is an offence against the Act` `a subsection of the Act` `a subsection of the Act` EQUALS JUST TRUE
#ASSERT `s 38C(1): the contravention is an offence against the Act` `a section of the Act` `a subsection of the Act` EQUALS NOTHING
#ASSERT `s 38C(1): the contravention is an offence against the Act` `a subsection of the Act` `a section of the Act` EQUALS NOTHING

-- (1): a penalty not exceeding the penalty set out, in a fine, in imprisonment, or in both.
#ASSERT `s 38C(1): the penalty imposed does not exceed the penalty set out` (Penalty WITH `fine in penalty units` IS JUST 100, `imprisonment in months` IS NOTHING) (Penalty WITH `fine in penalty units` IS JUST 100, `imprisonment in months` IS NOTHING)
#ASSERT `s 38C(1): the penalty imposed does not exceed the penalty set out` (Penalty WITH `fine in penalty units` IS JUST 100, `imprisonment in months` IS NOTHING) (Penalty WITH `fine in penalty units` IS JUST 99, `imprisonment in months` IS NOTHING)
#ASSERT `s 38C(1): the penalty imposed does not exceed the penalty set out` (Penalty WITH `fine in penalty units` IS JUST 100, `imprisonment in months` IS NOTHING) (Penalty WITH `fine in penalty units` IS NOTHING, `imprisonment in months` IS NOTHING)
#ASSERT (NOT (`s 38C(1): the penalty imposed does not exceed the penalty set out` (Penalty WITH `fine in penalty units` IS JUST 100, `imprisonment in months` IS NOTHING) (Penalty WITH `fine in penalty units` IS JUST 101, `imprisonment in months` IS NOTHING)))
#ASSERT `s 38C(1): the penalty imposed does not exceed the penalty set out` (Penalty WITH `fine in penalty units` IS JUST 50, `imprisonment in months` IS JUST 6) (Penalty WITH `fine in penalty units` IS JUST 50, `imprisonment in months` IS JUST 6)
#ASSERT (NOT (`s 38C(1): the penalty imposed does not exceed the penalty set out` (Penalty WITH `fine in penalty units` IS JUST 50, `imprisonment in months` IS JUST 6) (Penalty WITH `fine in penalty units` IS JUST 50, `imprisonment in months` IS JUST 7)))
-- A penalty of a kind the section does not set out is more than the penalty set out.
#ASSERT (NOT (`s 38C(1): the penalty imposed does not exceed the penalty set out` (Penalty WITH `fine in penalty units` IS JUST 100, `imprisonment in months` IS NOTHING) (Penalty WITH `fine in penalty units` IS JUST 10, `imprisonment in months` IS JUST 1)))

-- (1AA).
#ASSERT `s 38C(1AA): subsection (1) applies to the penalty` TRUE EQUALS JUST TRUE
#ASSERT `s 38C(1AA): subsection (1) applies to the penalty` FALSE EQUALS JUST TRUE
-- (1A).
#ASSERT `s 38C(1A): the penalty is taken to be at the foot of the section or subsection` TRUE EQUALS JUST TRUE
#ASSERT `s 38C(1A): the penalty is taken to be at the foot of the section or subsection` FALSE EQUALS NOTHING
-- (2).
#ASSERT `s 38C(2): the penalty applies according to the tenor of the provision` TRUE EQUALS JUST TRUE
#ASSERT `s 38C(2): the penalty applies according to the tenor of the provision` FALSE EQUALS NOTHING
-- (3).
#ASSERT `s 38C(3): the thing is a section for the purposes of section 38C` `a section of an Act` EQUALS JUST TRUE
#ASSERT `s 38C(3): the thing is a section for the purposes of section 38C` `a rule` EQUALS JUST TRUE
#ASSERT `s 38C(3): the thing is a section for the purposes of section 38C` `a regulation` EQUALS JUST TRUE
#ASSERT `s 38C(3): the thing is a section for the purposes of section 38C` `a by-law` EQUALS JUST TRUE
#ASSERT `s 38C(3): the thing is a section for the purposes of section 38C` `something other than a section, rule, regulation or by-law` EQUALS NOTHING

§ `Sections 38DC and 38F`

-- 38DC(1): applies only if the provision does not expressly authorise a different maximum fine for a body corporate.
#ASSERT `s 38DC(1): section 38DC applies to the provision` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 38DC(1): section 38DC applies to the provision` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 38DC(1): section 38DC applies to the provision` FALSE FALSE EQUALS JUST FALSE
-- 38DC(2), (3).
#ASSERT `s 38DC(2): the maximum fine for an individual that may be imposed under the subordinate legislation` TRUE 100 EQUALS JUST 100
#ASSERT `s 38DC(2): the maximum fine for an individual that may be imposed under the subordinate legislation` FALSE 100 EQUALS NOTHING
#ASSERT `s 38DC(3): the maximum fine for a body corporate that may be imposed under the subordinate legislation` TRUE 20 EQUALS JUST 100
-- The note for section 38F(2): 5 times 100 penalty units is 500 penalty units.
#ASSERT `s 38DC(3): the maximum fine for a body corporate that may be imposed under the subordinate legislation` TRUE 100 EQUALS JUST 500
#ASSERT `s 38DC(3): the maximum fine for a body corporate that may be imposed under the subordinate legislation` FALSE 100 EQUALS NOTHING
-- 38F(1).
#ASSERT `s 38F(1): the subordinate legislation may prescribe a fine for the offence` TRUE EQUALS JUST TRUE
#ASSERT `s 38F(1): the subordinate legislation may prescribe a fine for the offence` FALSE EQUALS NOTHING
-- 38F(2), (3): the limit is 100 penalty units, subject to the Act under which the legislation is made.
#ASSERT `s 38F(2): the fine prescribed is within the limit` 100 FALSE EQUALS JUST TRUE
#ASSERT `s 38F(2): the fine prescribed is within the limit` 101 FALSE EQUALS JUST FALSE
#ASSERT `s 38F(2): the fine prescribed is within the limit` 1 FALSE EQUALS JUST TRUE
#ASSERT `s 38F(2): the fine prescribed is within the limit` 500 TRUE EQUALS NOTHING

§ `Section 38G`

#ASSERT `s 38G: the civil penalty is within the penalty specified or prescribed` 200 200 EQUALS JUST TRUE
#ASSERT `s 38G: the civil penalty is within the penalty specified or prescribed` 200 199 EQUALS JUST TRUE
#ASSERT `s 38G: the civil penalty is within the penalty specified or prescribed` 200 201 EQUALS JUST FALSE
