#ASSERT `s 23A: the idea is taken to be different because of the spelling` TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 23A: the idea is taken to be different because of the spelling` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 23A: the idea is taken to be different because of the spelling` TRUE TRUE FALSE TRUE EQUALS NOTHING

§ `Sections 24 to 24AA`

#ASSERT `s 24(1): the language includes the individual, regardless of gender or sex` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 24(1): the language includes the individual, regardless of gender or sex` TRUE FALSE EQUALS NOTHING
#ASSERT `s 24(1): the language includes the individual, regardless of gender or sex` FALSE TRUE EQUALS NOTHING
