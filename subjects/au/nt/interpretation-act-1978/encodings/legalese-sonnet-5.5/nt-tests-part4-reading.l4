#ASSERT `s 24(2): the word as used includes the word in the other number` `plural` "cat" TRUE EQUALS JUST TRUE
#ASSERT `s 24(2): the word as used includes the word in the other number` `singular` "mice" FALSE EQUALS NOTHING
-- 24A: sections 56 to 60 includes 56 and 60.
#ASSERT `s 24A: the number is included in the range of numbers` 56 60 56 EQUALS JUST TRUE
#ASSERT `s 24A: the number is included in the range of numbers` 56 60 60 EQUALS JUST TRUE
#ASSERT `s 24A: the number is included in the range of numbers` 56 60 58 EQUALS JUST TRUE
#ASSERT `s 24A: the number is included in the range of numbers` 56 60 55 EQUALS NOTHING
#ASSERT `s 24A: the number is included in the range of numbers` 56 60 61 EQUALS NOTHING
-- The words from eagle to kite include eagle and kite.
#ASSERT `s 24A: the word is included in the range of words` "eagle" "kite" "eagle" EQUALS JUST TRUE
#ASSERT `s 24A: the word is included in the range of words` "eagle" "kite" "kite" EQUALS JUST TRUE
#ASSERT `s 24A: the word is included in the range of words` "eagle" "kite" "goose" EQUALS JUST TRUE
#ASSERT `s 24A: the word is included in the range of words` "eagle" "kite" "ant" EQUALS NOTHING
#ASSERT `s 24A: the word is included in the range of words` "eagle" "kite" "owl" EQUALS NOTHING
-- 24AA(1): examples anyone, no-one, party, someone.
#ASSERT `s 24AA(1): the reference to a person generally includes the kind of person` TRUE `an individual` EQUALS JUST TRUE
#ASSERT `s 24AA(1): the reference to a person generally includes the kind of person` TRUE `a body politic` EQUALS JUST TRUE
#ASSERT `s 24AA(1): the reference to a person generally includes the kind of person` TRUE `a body corporate` EQUALS JUST TRUE
#ASSERT `s 24AA(1): the reference to a person generally includes the kind of person` TRUE `something that is none of these` EQUALS NOTHING
#ASSERT `s 24AA(1): the reference to a person generally includes the kind of person` FALSE `a body corporate` EQUALS NOTHING
#ASSERT `s 24AA(2): subsection (1) is displaced` TRUE EQUALS JUST FALSE
#ASSERT `s 24AA(2): subsection (1) is displaced` FALSE EQUALS NOTHING

§ `Section 25`

-- (1)(a)(i): to the recipient, an individual.
#ASSERT `s 25(1): a person may serve the document on the recipient in that way` `an individual` (`giving it to a person` `the recipient`) EQUALS JUST TRUE
-- A body is not an individual: the paragraph does not list giving it to "the recipient" when the recipient is a body.
#ASSERT `s 25(1): a person may serve the document on the recipient in that way` `a body` (`giving it to a person` `the recipient`) EQUALS NOTHING
-- (1)(a)(ii): an executive officer of the body.
#ASSERT `s 25(1): a person may serve the document on the recipient in that way` `a body` (`giving it to a person` `an executive officer of the body`) EQUALS JUST TRUE
#ASSERT `s 25(1): a person may serve the document on the recipient in that way` `an individual` (`giving it to a person` `an executive officer of the body`) EQUALS NOTHING
-- (1)(a)(iii): in any case, a person authorised by the recipient.
#ASSERT `s 25(1): a person may serve the document on the recipient in that way` `an individual` (`giving it to a person` `a person authorised by the recipient to receive the document`) EQUALS JUST TRUE
#ASSERT `s 25(1): a person may serve the document on the recipient in that way` `a body` (`giving it to a person` `a person authorised by the recipient to receive the document`) EQUALS JUST TRUE
#ASSERT `s 25(1): a person may serve the document on the recipient in that way` `a body` (`giving it to a person` `someone else`) EQUALS NOTHING
-- (1)(b), (c).
#ASSERT `s 25(1): a person may serve the document on the recipient in that way` `an individual` `sending it by prepaid post addressed to the recipient at the recipient's address` EQUALS JUST TRUE
#ASSERT `s 25(1): a person may serve the document on the recipient in that way` `a body` `sending it to the recipient by fax` EQUALS JUST TRUE
-- (1)(d): with someone who appears to be at least 16 and to live or be employed there.
#ASSERT `s 25(1): a person may serve the document on the recipient in that way` `an individual` (`leaving it, addressed to the recipient, at the recipient's address with someone` TRUE TRUE) EQUALS JUST TRUE
#ASSERT `s 25(1): a person may serve the document on the recipient in that way` `an individual` (`leaving it, addressed to the recipient, at the recipient's address with someone` FALSE TRUE) EQUALS NOTHING
#ASSERT `s 25(1): a person may serve the document on the recipient in that way` `an individual` (`leaving it, addressed to the recipient, at the recipient's address with someone` TRUE FALSE) EQUALS NOTHING
-- (5).
#ASSERT `s 25(5): section 25 has effect for the service of the document` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 25(5): section 25 has effect for the service of the document` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 25(5): section 25 has effect for the service of the document` FALSE TRUE EQUALS NOTHING
-- (6).
#ASSERT `s 25(6) "address": the address is within the address of a recipient` TRUE EQUALS JUST TRUE
#ASSERT `s 25(6) "address": the address is within the address of a recipient` FALSE EQUALS NOTHING
#ASSERT `s 25(6) "body": the body is within a body` TRUE EQUALS JUST TRUE
#ASSERT `s 25(6) "body": the body is within a body` FALSE EQUALS NOTHING
#ASSERT `s 25(6) "document": the thing is within a document` TRUE EQUALS JUST TRUE
#ASSERT `s 25(6) "document": the thing is within a document` FALSE EQUALS NOTHING
#ASSERT `s 25(6) "executive officer": the person is an executive officer of the body` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 25(6) "executive officer": the person is an executive officer of the body` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 25(6) "executive officer": the person is an executive officer of the body` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 25(6) "executive officer": the person is an executive officer of the body` FALSE TRUE FALSE EQUALS JUST FALSE

