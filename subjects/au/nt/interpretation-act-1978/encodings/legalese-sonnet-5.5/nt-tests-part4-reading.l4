IMPORT prelude
IMPORT daydate
IMPORT `nt-part4-reading`

-- Tests of nt-part4-reading.l4 (sections 18 to 38A).
-- Every expected value is written from the text of the section named beside it.

§ `Section 18`

#ASSERT `s 18: a definition in or applicable to an Act applies` FALSE EQUALS JUST TRUE
#ASSERT `s 18: a definition in or applicable to an Act applies` TRUE EQUALS JUST FALSE

§ `Section 18A`

-- (1): a department, authority or body that is nominated in an Administrative Arrangements Order, or declared by an Act.
#ASSERT `s 18A(1): the body is an Agency` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 18A(1): the body is an Agency` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 18A(1): the body is an Agency` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 18A(1): the body is an Agency` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 18A(1): the body is an Agency` FALSE TRUE TRUE EQUALS JUST FALSE
-- (2).
#ASSERT `s 18A(2): the Agency that "the Agency" refers to in a provision` (JUST "Department of Corporate and Digital Development") EQUALS JUST "Department of Corporate and Digital Development"
#ASSERT `s 18A(2): the Agency that "the Agency" refers to in a provision` NOTHING EQUALS NOTHING
-- (3): by order, by Act, both, neither.
#ASSERT `s 18A(3): the Agencies that the reference is a reference to` (JUST "Agency A") NOTHING EQUALS JUST (LIST "Agency A")
#ASSERT `s 18A(3): the Agencies that the reference is a reference to` NOTHING (JUST "Agency B") EQUALS JUST (LIST "Agency B")
#ASSERT `s 18A(3): the Agencies that the reference is a reference to` (JUST "Agency A") (JUST "Agency B") EQUALS JUST (LIST "Agency A", "Agency B")
#ASSERT `s 18A(3): the Agencies that the reference is a reference to` NOTHING NOTHING EQUALS NOTHING
-- (4): includes the specified Agency itself and the one now responsible.
#ASSERT `s 18A(4): what a reference to the specified Agency includes` "Old Agency" (JUST "New Agency") EQUALS LIST "Old Agency", "New Agency"
#ASSERT `s 18A(4): what a reference to the specified Agency includes` "Old Agency" NOTHING EQUALS LIST "Old Agency"

§ `Section 19`

#ASSERT `s 19(1): the person is a minister` TRUE EQUALS JUST TRUE
#ASSERT `s 19(1): the person is a minister` FALSE EQUALS JUST FALSE
#ASSERT `s 19(2): the person is referred to by "the Minister" in the Act` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 19(2): the person is referred to by "the Minister" in the Act` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 19(2): the person is referred to by "the Minister" in the Act` FALSE FALSE EQUALS NOTHING
#ASSERT `s 19(3): the ministers that the reference is a reference to` (JUST "Minister A") (JUST "Minister B") EQUALS JUST (LIST "Minister A", "Minister B")
#ASSERT `s 19(3): the ministers that the reference is a reference to` (JUST "Minister A") NOTHING EQUALS JUST (LIST "Minister A")
#ASSERT `s 19(3): the ministers that the reference is a reference to` NOTHING (JUST "Minister B") EQUALS JUST (LIST "Minister B")
#ASSERT `s 19(3): the ministers that the reference is a reference to` NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 19(4): what a reference to the specified minister includes` "Former Minister" (JUST "Current Minister") EQUALS LIST "Former Minister", "Current Minister"
#ASSERT `s 19(4): what a reference to the specified minister includes` "Former Minister" NOTHING EQUALS LIST "Former Minister"
-- (5): refers to the Minister and nothing has been allocated.
#ASSERT `s 19(5): the reference is a reference to any minister` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 19(5): the reference is a reference to any minister` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 19(5): the reference is a reference to any minister` FALSE FALSE EQUALS JUST FALSE

§ `Section 19A`

-- (1)(a): validly married under the Marriage Act 1961.
#ASSERT `s 19A(1): the other person is a spouse of the person` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- (1)(b): both Aboriginal or Torres Strait Islander and married by the customs of the community.
#ASSERT `s 19A(1): the other person is a spouse of the person` FALSE TRUE TRUE TRUE EQUALS JUST TRUE
-- (1)(b) fails if the other person is not an Aboriginal or Torres Strait Islander, if the customs marriage is missing, or if the person is not one.
#ASSERT `s 19A(1): the other person is a spouse of the person` FALSE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 19A(1): the other person is a spouse of the person` FALSE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 19A(1): the other person is a spouse of the person` FALSE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 19A(1): the other person is a spouse of the person` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- (2).
#ASSERT `s 19A(2): the term has the meaning that corresponds with the meaning of spouse` "marriage" EQUALS JUST TRUE
#ASSERT `s 19A(2): the term has the meaning that corresponds with the meaning of spouse` "husband" EQUALS JUST TRUE
#ASSERT `s 19A(2): the term has the meaning that corresponds with the meaning of spouse` "wife" EQUALS JUST TRUE
#ASSERT `s 19A(2): the term has the meaning that corresponds with the meaning of spouse` "widow" EQUALS JUST TRUE
#ASSERT `s 19A(2): the term has the meaning that corresponds with the meaning of spouse` "widower" EQUALS JUST TRUE
#ASSERT `s 19A(2): the term has the meaning that corresponds with the meaning of spouse` "fiance" EQUALS NOTHING
-- (3).
#ASSERT `s 19A(3): where the meaning of the term is to be found` "de facto partner" EQUALS JUST "section 3(1) of the De Facto Relationships Act"
#ASSERT `s 19A(3): where the meaning of the term is to be found` "de facto relationship" EQUALS JUST "section 3(1) of the De Facto Relationships Act"
#ASSERT `s 19A(3): where the meaning of the term is to be found` "spouse" EQUALS NOTHING
-- (4)(a) married: a child of the spouse but not of the person.
#ASSERT `s 19A(4): the child is a stepchild of the person` TRUE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- (4)(b) de facto: a child of the de facto partner but not of the person.
#ASSERT `s 19A(4): the child is a stepchild of the person` FALSE TRUE FALSE TRUE FALSE EQUALS JUST TRUE
-- A child of the person is not a stepchild; a spouse's child is not a stepchild of an unmarried person.
#ASSERT `s 19A(4): the child is a stepchild of the person` TRUE FALSE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 19A(4): the child is a stepchild of the person` FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 19A(4): the child is a stepchild of the person` TRUE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
-- (5).
#ASSERT `s 19A(5): the term has the meaning that corresponds with the meaning of stepchild` "step-relative" EQUALS JUST TRUE
#ASSERT `s 19A(5): the term has the meaning that corresponds with the meaning of stepchild` "stepchild" EQUALS NOTHING

