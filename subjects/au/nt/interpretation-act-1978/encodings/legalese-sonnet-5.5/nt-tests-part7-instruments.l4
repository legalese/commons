IMPORT prelude
IMPORT daydate
IMPORT `nt-part7-instruments`

-- Tests of nt-part7-instruments.l4 (sections 63 to 66).
-- Every expected value is written from the text of the section named beside it.

§ `A calendar for the Legislative Assembly`

-- Twenty sitting days in 2025, numbered here by their order:
-- 1: 4 Mar, 2: 5 Mar, 3: 6 Mar, 4: 25 Mar, 5: 26 Mar, 6: 27 Mar, 7: 8 Apr, 8: 9 Apr, 9: 10 Apr, 10: 29 Apr,
-- 11: 30 Apr, 12: 1 May, 13: 13 May, 14: 14 May, 15: 15 May, 16: 3 Jun, 17: 4 Jun, 18: 5 Jun, 19: 17 Jun, 20: 18 Jun.
GIVETH A LIST OF DATE
`the sitting days of 2025` MEANS
    LIST Date 4 3 2025, Date 5 3 2025, Date 6 3 2025, Date 25 3 2025, Date 26 3 2025, Date 27 3 2025, Date 8 4 2025, Date 9 4 2025, Date 10 4 2025, Date 29 4 2025,
         Date 30 4 2025, Date 1 5 2025, Date 13 5 2025, Date 14 5 2025, Date 15 5 2025, Date 3 6 2025, Date 4 6 2025, Date 5 6 2025, Date 17 6 2025, Date 18 6 2025

GIVETH A LIST OF DATE
`only three sitting days` MEANS LIST Date 4 3 2025, Date 5 3 2025, Date 6 3 2025

§ `Section 63`

#ASSERT `s 63(a): the regulation has been published and notified as required` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 63(a): the regulation has been published and notified as required` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 63(a): the regulation has been published and notified as required` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 63(a): the regulation has been published and notified as required` TRUE TRUE FALSE EQUALS JUST FALSE
-- (b): made on 3 March 2025, before the first sitting day: the 6th sitting day after is no. 6, 27 March.
#ASSERT `s 63(b): the last day on which the regulation must be tabled` (Date 3 3 2025) `the sitting days of 2025` EQUALS JUST (Date 27 3 2025)
-- Made on a sitting day, 4 March: that day is left out (section 28(1)), so the 6th after is no. 7, 8 April.
#ASSERT `s 63(b): the last day on which the regulation must be tabled` (Date 4 3 2025) `the sitting days of 2025` EQUALS JUST (Date 8 4 2025)
-- With too few sitting days known the text cannot be applied.
#ASSERT `s 63(b): the last day on which the regulation must be tabled` (Date 3 3 2025) `only three sitting days` EQUALS NOTHING
#ASSERT `s 63(b): the regulation is tabled within 6 sitting days after it is made` (Date 3 3 2025) (Date 27 3 2025) `the sitting days of 2025` EQUALS JUST TRUE
#ASSERT `s 63(b): the regulation is tabled within 6 sitting days after it is made` (Date 3 3 2025) (Date 26 3 2025) `the sitting days of 2025` EQUALS JUST TRUE
#ASSERT `s 63(b): the regulation is tabled within 6 sitting days after it is made` (Date 3 3 2025) (Date 28 3 2025) `the sitting days of 2025` EQUALS JUST FALSE
#ASSERT `s 63(b): the regulation is tabled within 6 sitting days after it is made` (Date 3 3 2025) (Date 8 4 2025) `the sitting days of 2025` EQUALS JUST FALSE
#ASSERT `s 63(b): the regulation is tabled within 6 sitting days after it is made` (Date 3 3 2025) (Date 8 4 2025) `only three sitting days` EQUALS NOTHING

§ `Section 63A`

-- (1)(a): the maker signs; a statutory corporation or council has an authorised person sign.
#ASSERT `s 63A(1)(a): the rule or by-law is signed as required` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 63A(1)(a): the rule or by-law is signed as required` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 63A(1)(a): the rule or by-law is signed as required` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 63A(1)(a): the rule or by-law is signed as required` TRUE TRUE FALSE EQUALS JUST FALSE
-- (1)(b), (6).
#ASSERT `s 63A(1)(b): the signed rule or by-law must be given to the minister administering the provision containing the power` FALSE EQUALS JUST TRUE
#ASSERT `s 63A(1)(b): the signed rule or by-law must be given to the minister administering the provision containing the power` TRUE EQUALS JUST FALSE
#ASSERT `s 63A(6): subsection (1)(b) applies to the by-law` TRUE EQUALS JUST FALSE
#ASSERT `s 63A(6): subsection (1)(b) applies to the by-law` FALSE EQUALS JUST TRUE
-- (2)(a).
#ASSERT `s 63A(2)(a): the minister has caused the rule or by-law to be published and notified as required` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 63A(2)(a): the minister has caused the rule or by-law to be published and notified as required` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 63A(2)(a): the minister has caused the rule or by-law to be published and notified as required` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 63A(2)(a): the minister has caused the rule or by-law to be published and notified as required` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 63A(2)(a): the minister has caused the rule or by-law to be published and notified as required` FALSE TRUE TRUE TRUE EQUALS NOTHING
-- (2)(b): notified on 25 March (sitting day no. 4): the 6th sitting day after is no. 10, 29 April.
#ASSERT `s 63A(2)(b): the last day on which the rule or by-law must be tabled` (Date 25 3 2025) `the sitting days of 2025` EQUALS JUST (Date 29 4 2025)
-- (3).
#ASSERT `s 63A(3): the minister may return the rule or by-law with a request for amendment` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 63A(3): the minister may return the rule or by-law with a request for amendment` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 63A(3): the minister may return the rule or by-law with a request for amendment` FALSE TRUE EQUALS JUST FALSE
-- (4), (5).
#ASSERT `s 63A(4): the person making the rule or by-law has done what the subsection requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 63A(4): the person making the rule or by-law has done what the subsection requires` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 63A(4): the person making the rule or by-law has done what the subsection requires` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 63A(4): the person making the rule or by-law has done what the subsection requires` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 63A(5): subsection (2) applies to the rule or by-law` TRUE EQUALS JUST TRUE
#ASSERT `s 63A(5): subsection (2) applies to the rule or by-law` FALSE EQUALS NOTHING

§ `Section 63C`

#ASSERT `s 63C(1): the failure to table affects whether the subordinate legislation has effect` TRUE EQUALS JUST FALSE
#ASSERT `s 63C(1): the failure to table affects whether the subordinate legislation has effect` FALSE EQUALS NOTHING
#ASSERT `s 63C(2): the Legislative Assembly may pass a resolution disallowing the subordinate legislation or specified provisions of it` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 63C(2): the Legislative Assembly may pass a resolution disallowing the subordinate legislation or specified provisions of it` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 63C(2): the Legislative Assembly may pass a resolution disallowing the subordinate legislation or specified provisions of it` FALSE TRUE EQUALS NOTHING
-- (3)(a): tabled on 27 March (sitting day no. 6): the 12th sitting day after is no. 18, 5 June.
#ASSERT `s 63C(3): the last day on which notice of the resolution must be given` TRUE (Date 27 3 2025) (Date 25 3 2025) `the sitting days of 2025` EQUALS JUST (Date 5 6 2025)
-- (3)(b): not tabled in accordance, required by 25 March (no. 4): the 12th after is no. 16, 3 June.
#ASSERT `s 63C(3): the last day on which notice of the resolution must be given` FALSE (Date 27 3 2025) (Date 25 3 2025) `the sitting days of 2025` EQUALS JUST (Date 3 6 2025)
#ASSERT `s 63C(3): the last day on which notice of the resolution must be given` TRUE (Date 27 3 2025) (Date 25 3 2025) `only three sitting days` EQUALS NOTHING
#ASSERT `s 63C(4): the disallowance has the same effect as a repeal` TRUE EQUALS JUST TRUE
#ASSERT `s 63C(4): the disallowance has the same effect as a repeal` FALSE EQUALS NOTHING
#ASSERT `s 63C(5): the date from which the disallowance revives the other provision` TRUE (Date 15 3 2025) EQUALS JUST (Date 15 3 2025)
#ASSERT `s 63C(5): the date from which the disallowance revives the other provision` FALSE (Date 15 3 2025) EQUALS NOTHING

§ `Section 64`

-- Disallowed on 15 March 2025: the 6 months run from 16 March to 15 September 2025.
#ASSERT `s 64(2): the last day of the 6 months after the disallowance` (Date 15 3 2025) EQUALS JUST (Date 15 9 2025)
-- Disallowed on 31 August 2025: the months run from 1 September; the 6th ends on 28 February 2026.
#ASSERT `s 64(2): the last day of the 6 months after the disallowance` (Date 31 8 2025) EQUALS JUST (Date 28 2 2026)
#ASSERT `s 64(2): the subordinate legislation may be made on the day` (Date 15 3 2025) (Date 15 9 2025) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 64(2): the subordinate legislation may be made on the day` (Date 15 3 2025) (Date 16 9 2025) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 64(2): the subordinate legislation may be made on the day` (Date 15 3 2025) (Date 16 3 2025) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 64(2): the subordinate legislation may be made on the day` (Date 15 3 2025) (Date 16 3 2025) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 64(2): the subordinate legislation may be made on the day` (Date 15 3 2025) (Date 16 3 2025) FALSE FALSE EQUALS NOTHING
#ASSERT `s 64(3): the subordinate legislation is of no effect` TRUE EQUALS JUST TRUE
#ASSERT `s 64(3): the subordinate legislation is of no effect` FALSE EQUALS NOTHING

§ `Sections 65 and 66`

#ASSERT `s 65(1): the power enables subordinate legislation to be made with respect to the matter` `a matter required or permitted to be prescribed by the Act` EQUALS JUST TRUE
#ASSERT `s 65(1): the power enables subordinate legislation to be made with respect to the matter` `a matter necessary or convenient to be prescribed for carrying out or giving effect to the Act` EQUALS JUST TRUE
#ASSERT `s 65(1): the power enables subordinate legislation to be made with respect to the matter` `some other matter` EQUALS NOTHING
#ASSERT `s 65(2): subsection (1) applies` TRUE EQUALS JUST TRUE
#ASSERT `s 65(2): subsection (1) applies` FALSE EQUALS JUST TRUE
#ASSERT `s 65(3): the power for a particular purpose limits the effect of the general power` FALSE EQUALS JUST FALSE
#ASSERT `s 65(3): the power for a particular purpose limits the effect of the general power` TRUE EQUALS NOTHING
#ASSERT `s 65A: the power may be exercised by prohibiting the matter or an aspect of it` TRUE EQUALS JUST TRUE
#ASSERT `s 65A: the power may be exercised by prohibiting the matter or an aspect of it` FALSE EQUALS NOTHING
#ASSERT `s 65B(1): the subordinate legislation may provide for review of, or a right of appeal against, the decision` TRUE EQUALS JUST TRUE
#ASSERT `s 65B(1): the subordinate legislation may provide for review of, or a right of appeal against, the decision` FALSE EQUALS NOTHING
#ASSERT `s 65B(2): the subordinate legislation may confer jurisdiction on the holder` `a court` EQUALS JUST TRUE
#ASSERT `s 65B(2): the subordinate legislation may confer jurisdiction on the holder` `a tribunal` EQUALS JUST TRUE
#ASSERT `s 65B(2): the subordinate legislation may confer jurisdiction on the holder` `a person` EQUALS JUST TRUE
#ASSERT `s 65B(2): the subordinate legislation may confer jurisdiction on the holder` `a body that is not a court or tribunal` EQUALS JUST TRUE
#ASSERT `s 65B(2): the subordinate legislation may confer jurisdiction on the holder` `something else that is not a court, tribunal, person or body` EQUALS NOTHING
#ASSERT `s 65C: the power to prescribe a fee includes power to provide for the thing` `the exemption from payment of the fee` EQUALS JUST TRUE
#ASSERT `s 65C: the power to prescribe a fee includes power to provide for the thing` `the waiver of the fee, wholly or partly` EQUALS JUST TRUE
#ASSERT `s 65C: the power to prescribe a fee includes power to provide for the thing` `the refund of the fee, wholly or partly` EQUALS JUST TRUE
#ASSERT `s 65C: the power to prescribe a fee includes power to provide for the thing` `a thing not listed` EQUALS NOTHING
#ASSERT `s 65D: the power enables subordinate legislation providing for the thing` `the payment of a prescribed amount instead of a penalty that may otherwise be imposed for an offence against the Act or the subordinate legislation` EQUALS JUST TRUE
#ASSERT `s 65D: the power enables subordinate legislation providing for the thing` `the service of a notice relating to payment of the amount on a person alleged to have committed the offence` EQUALS JUST TRUE
#ASSERT `s 65D: the power enables subordinate legislation providing for the thing` `the particulars to be included in the notice` EQUALS JUST TRUE
#ASSERT `s 65D: the power enables subordinate legislation providing for the thing` `a thing not listed` EQUALS NOTHING
#ASSERT `s 65E(1): the statutory instrument may require the making of a statutory declaration` TRUE EQUALS JUST TRUE
#ASSERT `s 65E(1): the statutory instrument may require the making of a statutory declaration` FALSE EQUALS NOTHING
#ASSERT `s 65E(2): subsection (1) applies` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 65E(2): subsection (1) applies` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 65E(2): subsection (1) applies` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 65F(1): action A is taken to have occurred after the revocation of action B` TRUE EQUALS JUST TRUE
#ASSERT `s 65F(1): action A is taken to have occurred after the revocation of action B` FALSE EQUALS NOTHING
-- 65F(2), and its example: revoke the appointment of a person and appoint another to the same position.
#ASSERT `s 65F(2): the sequence in which the actions are taken to have effect` NOTHING (LIST "the revocation of the appointment of the first person", "the appointment of the second person") EQUALS LIST "the revocation of the appointment of the first person", "the appointment of the second person"
#ASSERT `s 65F(2): the sequence in which the actions are taken to have effect` (JUST (LIST "second", "first")) (LIST "first", "second") EQUALS LIST "second", "first"
-- 66.
#ASSERT `s 66: the statutory instrument may apply, adopt or incorporate the matter` `a provision of a Territory or Commonwealth Act, or of a statutory instrument under such an Act` `as in force at a particular time` EQUALS JUST TRUE
#ASSERT `s 66: the statutory instrument may apply, adopt or incorporate the matter` `a provision of a Territory or Commonwealth Act, or of a statutory instrument under such an Act` `as in force from time to time` EQUALS JUST TRUE
#ASSERT `s 66: the statutory instrument may apply, adopt or incorporate the matter` `a matter contained in any other instrument or writing` `as in force or existing at the time when the instrument takes effect` EQUALS JUST TRUE
#ASSERT `s 66: the statutory instrument may apply, adopt or incorporate the matter` `a matter contained in any other instrument or writing` `as in force from time to time` EQUALS JUST FALSE
#ASSERT `s 66: the statutory instrument may apply, adopt or incorporate the matter` `a matter contained in any other instrument or writing` `as in force at a particular time` EQUALS NOTHING
