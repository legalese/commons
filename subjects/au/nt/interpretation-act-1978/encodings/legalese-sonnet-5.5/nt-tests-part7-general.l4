IMPORT prelude
IMPORT daydate
IMPORT `nt-part7-general`

-- Tests of nt-part7-general.l4 (sections 66A to 72).
-- Every expected value is written from the text of the section named beside it.

§ `Section 66A`

#ASSERT `s 66A(1): the requirement that the instrument be published in the Gazette is satisfied` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 66A(1): the requirement that the instrument be published in the Gazette is satisfied` TRUE FALSE EQUALS NOTHING
#ASSERT `s 66A(1): the requirement that the instrument be published in the Gazette is satisfied` FALSE TRUE EQUALS NOTHING
#ASSERT `s 66A(2): the place may be the kind of place` `a website` EQUALS JUST TRUE
#ASSERT `s 66A(2): the place may be the kind of place` `another publicly accessible electronic format` EQUALS JUST TRUE
#ASSERT `s 66A(2): the place may be the kind of place` `a physical place` EQUALS NOTHING
#ASSERT `s 66A(2): the place may be the kind of place` `a place of some other kind` EQUALS NOTHING

§ `Section 67`

-- (1)(a): under the Standing Orders; (1)(b): delivered to the Clerk and recorded in the Minutes.
#ASSERT `s 67(1): the document is tabled in the Legislative Assembly under the Act` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 67(1): the document is tabled in the Legislative Assembly under the Act` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 67(1): the document is tabled in the Legislative Assembly under the Act` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 67(1): the document is tabled in the Legislative Assembly under the Act` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 67(1): the document is tabled in the Legislative Assembly under the Act` FALSE FALSE FALSE EQUALS JUST FALSE
-- (2): within the period specified in the Act.
#ASSERT `s 67(2): the document is tabled within the period specified in the Act` TRUE (Date 10 6 2025) (Date 10 6 2025) EQUALS JUST TRUE
#ASSERT `s 67(2): the document is tabled within the period specified in the Act` TRUE (Date 9 6 2025) (Date 10 6 2025) EQUALS JUST TRUE
#ASSERT `s 67(2): the document is tabled within the period specified in the Act` TRUE (Date 11 6 2025) (Date 10 6 2025) EQUALS JUST FALSE
#ASSERT `s 67(2): the document is tabled within the period specified in the Act` FALSE (Date 9 6 2025) (Date 10 6 2025) EQUALS JUST FALSE
-- (3), (4).
#ASSERT `s 67(3): the document may be tabled by the person` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 67(3): the document may be tabled by the person` TRUE FALSE EQUALS NOTHING
#ASSERT `s 67(3): the document may be tabled by the person` FALSE TRUE EQUALS NOTHING
#ASSERT `s 67(4) "Act": the Act is within an Act` TRUE EQUALS JUST TRUE
#ASSERT `s 67(4) "Act": the Act is within an Act` FALSE EQUALS NOTHING
#ASSERT `s 67(4) "document": the thing is within a document` TRUE EQUALS JUST TRUE
#ASSERT `s 67(4) "document": the thing is within a document` FALSE EQUALS NOTHING

§ `Sections 68 to 72`

#ASSERT `s 68: strict compliance with the form is necessary` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 68: strict compliance with the form is necessary` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 68: strict compliance with the form is necessary` FALSE TRUE EQUALS NOTHING
#ASSERT `s 68: the compliance with the form is sufficient` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 68: the compliance with the form is sufficient` TRUE FALSE EQUALS NOTHING
#ASSERT `s 68: the compliance with the form is sufficient` FALSE TRUE EQUALS NOTHING
-- 69: money due of 5000; a court with a limit of 10000 reaches it, one with a limit of 4000 does not say, and one with no limit does.
#ASSERT `s 69: the money is recoverable in the court or tribunal` TRUE 5000 (JUST 10000) EQUALS JUST TRUE
#ASSERT `s 69: the money is recoverable in the court or tribunal` TRUE 5000 (JUST 5000) EQUALS JUST TRUE
#ASSERT `s 69: the money is recoverable in the court or tribunal` TRUE 5000 (JUST 4000) EQUALS NOTHING
#ASSERT `s 69: the money is recoverable in the court or tribunal` TRUE 5000 NOTHING EQUALS JUST TRUE
#ASSERT `s 69: the money is recoverable in the court or tribunal` FALSE 5000 NOTHING EQUALS NOTHING
#ASSERT `s 70: the person or body has authority to receive evidence and examine on oath any witness appearing before it` TRUE EQUALS JUST TRUE
#ASSERT `s 70: the person or body has authority to receive evidence and examine on oath any witness appearing before it` FALSE EQUALS NOTHING
#ASSERT `s 71: the Act may be amended or repealed` TRUE EQUALS JUST TRUE
#ASSERT `s 71: the Act may be amended or repealed` FALSE EQUALS NOTHING
#ASSERT `s 72(1): the law or statute of England has force or effect in the Territory to that extent` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 72(1): the law or statute of England has force or effect in the Territory to that extent` TRUE FALSE EQUALS NOTHING
#ASSERT `s 72(1): the law or statute of England has force or effect in the Territory to that extent` FALSE TRUE EQUALS NOTHING
#ASSERT `s 72(2): it is lawful to do the act on that day` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 72(2): it is lawful to do the act on that day` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 72(2): it is lawful to do the act on that day` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 72(2): it is lawful to do the act on that day` FALSE TRUE FALSE EQUALS NOTHING
