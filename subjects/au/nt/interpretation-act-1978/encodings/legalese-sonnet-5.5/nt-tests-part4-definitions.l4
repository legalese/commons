#ASSERT `s 17 "notified in the Gazette": the instrument is notified in the Gazette` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 17 "notified in the Gazette": the instrument is notified in the Gazette` FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 17 "notified in the Gazette": the instrument is notified in the Gazette` TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
