#ASSERT `s 17 "Gazette notice": the thing is a Gazette notice` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 17 "Gazette notice": the thing is a Gazette notice` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 17 "Gazette notice": the thing is a Gazette notice` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 17 "Gazette": what the expression means` "Gazette" EQUALS JUST "the Government Gazette of the Territory"
#ASSERT `s 17 "Gazette": what the expression means` "Government Gazette" EQUALS JUST "the Government Gazette of the Territory"
#ASSERT `s 17 "Gazette": what the expression means` "Northern Territory Government Gazette" EQUALS JUST "the Government Gazette of the Territory"
#ASSERT `s 17 "Gazette": what the expression means` "Gazette of the Northern Territory" EQUALS JUST "the Government Gazette of the Territory"
#ASSERT `s 17 "Gazette": what the expression means` "Commonwealth Gazette" EQUALS NOTHING
