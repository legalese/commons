#ASSERT `s 17 "person": the entity is within a person` `an entity that is a body corporate` EQUALS JUST TRUE
#ASSERT `s 17 "person": the entity is within a person` `an entity that is a natural person` EQUALS NOTHING
#ASSERT `s 17 "person": the entity is within a person` `an entity of some other kind` EQUALS NOTHING
#ASSERT `s 17 "party": the entity is within a party` `an entity that is a body politic` EQUALS JUST TRUE
#ASSERT `s 17 "party": the entity is within a party` `an entity that is a body corporate` EQUALS JUST TRUE
#ASSERT `s 17 "party": the entity is within a party` `an entity of some other kind` EQUALS NOTHING

