IMPORT prelude
IMPORT daydate
IMPORT `nt-part6-mechanics`

-- Tests of nt-part6-mechanics.l4 (sections 49 to 57B).
-- Every expected value is written from the text of the section named beside it.

§ `Section 49`

#ASSERT `s 49(1): the Act may be cited in that way` `by its short title including the year of enactment` EQUALS JUST TRUE
#ASSERT `s 49(1): the Act may be cited in that way` `by reference to its number and the calendar year in which it received assent` EQUALS JUST TRUE
#ASSERT `s 49(1): the Act may be cited in that way` `in a way not named in section 49(1)` EQUALS NOTHING
#ASSERT `s 49(2): the provision may be cited by reference to the division` `by its part` EQUALS JUST TRUE
#ASSERT `s 49(2): the provision may be cited by reference to the division` `by its section` EQUALS JUST TRUE
#ASSERT `s 49(2): the provision may be cited by reference to the division` `by its subsection` EQUALS JUST TRUE
#ASSERT `s 49(2): the provision may be cited by reference to the division` `by another division of the Act` EQUALS JUST TRUE
#ASSERT `s 49(2): the provision may be cited by reference to the division` `not by a division of the Act` EQUALS NOTHING
#ASSERT `s 49(3): the reference meets the requirement of subsection (3)` TRUE EQUALS JUST TRUE
#ASSERT `s 49(3): the reference meets the requirement of subsection (3)` FALSE EQUALS JUST FALSE

§ `Sections 50 to 52`

-- 50(1): amendments took effect on 1 Jan 2010 and 1 Jul 2015 and 1 Jul 2020; the version on a day is the latest on or before it.
#ASSERT `s 50(1): the version of the other legislation that a reference to it is a reference to on the day` (LIST Date 1 1 2010, Date 1 7 2015, Date 1 7 2020) (Date 31 12 2009) EQUALS `the legislation as made`
#ASSERT `s 50(1): the version of the other legislation that a reference to it is a reference to on the day` (LIST Date 1 1 2010, Date 1 7 2015, Date 1 7 2020) (Date 1 1 2010) EQUALS `the legislation as amended with effect from` (Date 1 1 2010)
#ASSERT `s 50(1): the version of the other legislation that a reference to it is a reference to on the day` (LIST Date 1 1 2010, Date 1 7 2015, Date 1 7 2020) (Date 30 6 2015) EQUALS `the legislation as amended with effect from` (Date 1 1 2010)
#ASSERT `s 50(1): the version of the other legislation that a reference to it is a reference to on the day` (LIST Date 1 1 2010, Date 1 7 2015, Date 1 7 2020) (Date 1 7 2015) EQUALS `the legislation as amended with effect from` (Date 1 7 2015)
#ASSERT `s 50(1): the version of the other legislation that a reference to it is a reference to on the day` (LIST Date 1 7 2020, Date 1 1 2010, Date 1 7 2015) (Date 1 1 2030) EQUALS `the legislation as amended with effect from` (Date 1 7 2020)
#ASSERT `s 50(1): the version of the other legislation that a reference to it is a reference to on the day` EMPTY (Date 1 1 2030) EQUALS `the legislation as made`
-- 50(2): immediately before the commencement of the amending provision (1 July 2015): an amendment taking effect that day is not yet in.
#ASSERT `s 50(2): the version of the other Act that the reference in the amending provision is a reference to` (LIST Date 1 1 2010, Date 1 7 2015) (Date 1 7 2015) EQUALS `the legislation as amended with effect from` (Date 1 1 2010)
#ASSERT `s 50(2): the version of the other Act that the reference in the amending provision is a reference to` (LIST Date 1 1 2010, Date 1 7 2015) (Date 2 7 2015) EQUALS `the legislation as amended with effect from` (Date 1 7 2015)
#ASSERT `s 50(2): the version of the other Act that the reference in the amending provision is a reference to` (LIST Date 1 1 2010, Date 1 7 2015) (Date 1 1 2010) EQUALS `the legislation as made`
-- 51.
#ASSERT `s 51(1): the reference includes the statutory instrument` TRUE EQUALS JUST TRUE
#ASSERT `s 51(1): the reference includes the statutory instrument` FALSE EQUALS NOTHING
#ASSERT `s 51(2): the thing is a law` `an Act of the Commonwealth` EQUALS JUST TRUE
#ASSERT `s 51(2): the thing is a law` `an Act of a State` EQUALS JUST TRUE
#ASSERT `s 51(2): the thing is a law` `an Act of a Territory` EQUALS JUST TRUE
#ASSERT `s 51(2): the thing is a law` `a law of a kind not named in section 51(2)` EQUALS NOTHING
-- 52.
#ASSERT `s 52: the Act may be cited by the place of its Parliament together with that mode of reference` `an Imperial Act` TRUE EQUALS JUST TRUE
#ASSERT `s 52: the Act may be cited by the place of its Parliament together with that mode of reference` `a Commonwealth Act` TRUE EQUALS JUST TRUE
#ASSERT `s 52: the Act may be cited by the place of its Parliament together with that mode of reference` `an Act of a State` TRUE EQUALS JUST TRUE
#ASSERT `s 52: the Act may be cited by the place of its Parliament together with that mode of reference` `an Act of another Territory of Australia` TRUE EQUALS JUST TRUE
#ASSERT `s 52: the Act may be cited by the place of its Parliament together with that mode of reference` `an Act of some other legislature` TRUE EQUALS NOTHING
#ASSERT `s 52: the Act may be cited by the place of its Parliament together with that mode of reference` `a Commonwealth Act` FALSE EQUALS NOTHING
#ASSERT `s 52: the reference is deemed to be to the Act as amended on the day` (Date 1 7 2015) (Date 1 7 2015) EQUALS JUST TRUE
#ASSERT `s 52: the reference is deemed to be to the Act as amended on the day` (Date 1 7 2015) (Date 2 7 2015) EQUALS JUST TRUE
#ASSERT `s 52: the reference is deemed to be to the Act as amended on the day` (Date 1 7 2015) (Date 30 6 2015) EQUALS JUST FALSE

§ `Section 53`

-- (1): a reference to a Part, section or Schedule is to one of that Act.
#ASSERT `s 53(1) to (6): the thing of which the unit that the reference names is a part` `referring to a Part` `anywhere in the Act` EQUALS JUST "that Act"
#ASSERT `s 53(1) to (6): the thing of which the unit that the reference names is a part` `referring to a section` `in a subsection of a section of the Act` EQUALS JUST "that Act"
#ASSERT `s 53(1) to (6): the thing of which the unit that the reference names is a part` `referring to a Schedule` `in a Part of the Act` EQUALS JUST "that Act"
-- (2): a Division named in a Part.
#ASSERT `s 53(1) to (6): the thing of which the unit that the reference names is a part` `referring to a Division` `in a Part of the Act` EQUALS JUST "that Part"
#ASSERT `s 53(1) to (6): the thing of which the unit that the reference names is a part` `referring to a Division` `in a section of the Act` EQUALS NOTHING
-- (3): a subsection or paragraph named in a section.
#ASSERT `s 53(1) to (6): the thing of which the unit that the reference names is a part` `referring to a subsection` `in a section of the Act` EQUALS JUST "that section"
#ASSERT `s 53(1) to (6): the thing of which the unit that the reference names is a part` `referring to a paragraph` `in a section of the Act` EQUALS JUST "that section"
#ASSERT `s 53(1) to (6): the thing of which the unit that the reference names is a part` `referring to a subsection` `in a Part of the Act` EQUALS NOTHING
-- (4): a paragraph named in a subsection.
#ASSERT `s 53(1) to (6): the thing of which the unit that the reference names is a part` `referring to a paragraph` `in a subsection of a section of the Act` EQUALS JUST "that subsection"
-- (5): a subparagraph named in a paragraph.
#ASSERT `s 53(1) to (6): the thing of which the unit that the reference names is a part` `referring to a subparagraph` `in a paragraph of a section, or of a subsection of a section, of the Act` EQUALS JUST "that paragraph"
#ASSERT `s 53(1) to (6): the thing of which the unit that the reference names is a part` `referring to a subparagraph` `in a subsection of a section of the Act` EQUALS NOTHING
-- (6): a form, item or clause named in a Schedule or part.
#ASSERT `s 53(1) to (6): the thing of which the unit that the reference names is a part` `referring to a form, item or clause` `in a Schedule, or part of a Schedule, to the Act` EQUALS JUST "that Schedule or part"
#ASSERT `s 53(1) to (6): the thing of which the unit that the reference names is a part` `referring to a form, item or clause` `in a section of the Act` EQUALS NOTHING
-- Identifiers: paragraph (b) named from inside subsection (1) of section 25 is 25(1)(b).
#ASSERT `s 53(3), (4), (5): the identifier of the unit named` `a paragraph named inside a section` "(b)" "25" (JUST "(1)") NOTHING EQUALS JUST "25(1)(b)"
-- Paragraph (b) named from inside a section with no subsections (section 63): 63(b).
#ASSERT `s 53(3), (4), (5): the identifier of the unit named` `a paragraph named inside a section` "(b)" "63" NOTHING NOTHING EQUALS JUST "63(b)"
-- Subsection (3) named from inside section 53: 53(3).
#ASSERT `s 53(3), (4), (5): the identifier of the unit named` `a subsection named inside a section` "(3)" "53" NOTHING NOTHING EQUALS JUST "53(3)"
-- Subparagraph (ii) named from inside paragraph (a) of subsection (1) of section 25: 25(1)(a)(ii).
#ASSERT `s 53(3), (4), (5): the identifier of the unit named` `a subparagraph named inside a section` "(ii)" "25" (JUST "(1)") (JUST "(a)") EQUALS JUST "25(1)(a)(ii)"
-- Subparagraph (i) named from inside paragraph (a) of section 63A subsection... and from a section without subsections: 63(a)(i).
#ASSERT `s 53(3), (4), (5): the identifier of the unit named` `a subparagraph named inside a section` "(i)" "63" NOTHING (JUST "(a)") EQUALS JUST "63(a)(i)"
-- A subparagraph named from outside any paragraph: not covered.
#ASSERT `s 53(3), (4), (5): the identifier of the unit named` `a subparagraph named inside a section` "(i)" "63" NOTHING NOTHING EQUALS NOTHING
-- (7).
#ASSERT `s 53(7): the reference to a form is read as a reference to a form in that Schedule` TRUE EQUALS JUST TRUE
#ASSERT `s 53(7): the reference to a form is read as a reference to a form in that Schedule` FALSE EQUALS NOTHING

§ `Sections 54 and 55`

#ASSERT `s 54: the section has effect as a substantive enactment` TRUE EQUALS JUST TRUE
#ASSERT `s 54: the section has effect as a substantive enactment` FALSE EQUALS JUST TRUE
#ASSERT `s 55: the material is part of the Act` `a heading to a Chapter, Part, Division or Subdivision` EQUALS JUST TRUE
-- (2)(a): an Act enacted after 1 July 2006 has section headings that are part of it; on 1 July 2006 itself it was not "after".
#ASSERT `s 55: the material is part of the Act` (`a heading to a section` (Date 2 7 2006) NOTHING) EQUALS JUST TRUE
#ASSERT `s 55: the material is part of the Act` (`a heading to a section` (Date 1 7 2006) NOTHING) EQUALS JUST FALSE
#ASSERT `s 55: the material is part of the Act` (`a heading to a section` (Date 30 6 2006) NOTHING) EQUALS JUST FALSE
-- (2)(b): a heading amended or inserted after 1 July 2006 in an older Act.
#ASSERT `s 55: the material is part of the Act` (`a heading to a section` (Date 1 1 1978) (JUST (Date 2 7 2006))) EQUALS JUST TRUE
#ASSERT `s 55: the material is part of the Act` (`a heading to a section` (Date 1 1 1978) (JUST (Date 1 7 2006))) EQUALS JUST FALSE
#ASSERT `s 55: the material is part of the Act` `an example or note in the text of an Act` EQUALS JUST TRUE
#ASSERT `s 55: the material is part of the Act` `a Schedule to an Act` EQUALS JUST TRUE
#ASSERT `s 55: the material is part of the Act` `a marginal note, footnote, endnote or other note that is not part of the text of the Act` EQUALS JUST FALSE
#ASSERT `s 55: the material is part of the Act` `other material` EQUALS NOTHING
#ASSERT `s 55(3): subsection (2) prevents the amendment of the heading by an Act` TRUE EQUALS JUST FALSE
#ASSERT `s 55(3): subsection (2) prevents the amendment of the heading by an Act` FALSE EQUALS NOTHING

§ `Sections 56 and 57`

-- 56(1): Acts assented to on 3 Feb, 10 Mar and 5 Jul 2025 are numbered 1, 2 and 3.
#ASSERT `s 56(1): the number of the Act` (LIST Date 10 3 2025, Date 3 2 2025, Date 5 7 2025) (Date 3 2 2025) EQUALS JUST 1
#ASSERT `s 56(1): the number of the Act` (LIST Date 10 3 2025, Date 3 2 2025, Date 5 7 2025) (Date 10 3 2025) EQUALS JUST 2
#ASSERT `s 56(1): the number of the Act` (LIST Date 10 3 2025, Date 3 2 2025, Date 5 7 2025) (Date 5 7 2025) EQUALS JUST 3
-- Each calendar year begins again at one.
#ASSERT `s 56(1): the number of the Act` (LIST Date 10 3 2024, Date 3 2 2025) (Date 3 2 2025) EQUALS JUST 1
-- Two Acts on the same day: the text does not say which is first.
#ASSERT `s 56(1): the number of the Act` (LIST Date 10 3 2025, Date 10 3 2025) (Date 10 3 2025) EQUALS NOTHING
#ASSERT `s 56(2): the day on which the Act is deemed to receive assent` TRUE (Date 20 3 2025) EQUALS JUST (Date 20 3 2025)
#ASSERT `s 56(2): the day on which the Act is deemed to receive assent` FALSE (Date 20 3 2025) EQUALS NOTHING
-- 57(1).
#ASSERT `s 57(1): section 57 applies to the subordinate legislation` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 57(1): section 57 applies to the subordinate legislation` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 57(1): section 57 applies to the subordinate legislation` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 57(1): section 57 applies to the subordinate legislation` FALSE FALSE TRUE EQUALS JUST FALSE
-- 57(2).
#ASSERT `s 57(2): the number of the subordinate legislation` (LIST Date 1 2 2025, Date 15 2 2025, Date 1 3 2025) (Date 15 2 2025) EQUALS JUST 2
#ASSERT `s 57(2): the number of the subordinate legislation` (LIST Date 1 2 2025, Date 15 2 2025, Date 1 3 2025) (Date 1 2 2025) EQUALS JUST 1
#ASSERT `s 57(2): the number of the subordinate legislation` (LIST Date 1 2 2025, Date 1 2 2025) (Date 1 2 2025) EQUALS NOTHING
#ASSERT `s 57(3): the subordinate legislation may be cited by its number and the calendar year in which it is made` TRUE EQUALS JUST TRUE
#ASSERT `s 57(3): the subordinate legislation may be cited by its number and the calendar year in which it is made` FALSE EQUALS NOTHING

§ `Sections 57A and 57B`

#ASSERT `s 57A(1): the statutory instrument may be amended, varied, repealed, rescinded or revoked by a statutory instrument under the parent Act` TRUE EQUALS JUST TRUE
#ASSERT `s 57A(1): the statutory instrument may be amended, varied, repealed, rescinded or revoked by a statutory instrument under the parent Act` FALSE EQUALS NOTHING
#ASSERT `s 57A(2): subsection (1) applies in relation to the amendment` TRUE EQUALS JUST TRUE
#ASSERT `s 57A(2): subsection (1) applies in relation to the amendment` FALSE EQUALS JUST TRUE
-- 57B: a new term goes into alphabetical order.
#ASSERT `s 57B: the terms in the order they stand after the insertion` (LIST "adult", "bank", "document") "building society" FALSE EQUALS JUST (LIST "adult", "bank", "building society", "document")
#ASSERT `s 57B: the terms in the order they stand after the insertion` (LIST "adult", "bank", "document") "aardvark" FALSE EQUALS JUST (LIST "aardvark", "adult", "bank", "document")
#ASSERT `s 57B: the terms in the order they stand after the insertion` (LIST "adult", "bank", "document") "year" FALSE EQUALS JUST (LIST "adult", "bank", "document", "year")
#ASSERT `s 57B: the terms in the order they stand after the insertion` EMPTY "bank" FALSE EQUALS JUST (LIST "bank")
-- Capitals are not ranked apart from letters: section 17 prints "Act", "Acting Administrator", "ADI" and "Administrative Arrangements Order" in that order.
#ASSERT `s 57B: the terms in the order they stand after the insertion` (LIST "Act", "Administrator") "ADI" FALSE EQUALS JUST (LIST "Act", "ADI", "Administrator")
#ASSERT `s 57B: the terms in the order they stand after the insertion` (LIST "Act", "Acting Administrator", "Administrative Arrangements Order") "ADI" FALSE EQUALS JUST (LIST "Act", "Acting Administrator", "ADI", "Administrative Arrangements Order")
#ASSERT `s 57B: the terms in the order they stand after the insertion` (LIST "adult", "Agency") "affidavit" FALSE EQUALS JUST (LIST "adult", "affidavit", "Agency")
-- Where the amending Act says where to insert it, the section does not speak.
#ASSERT `s 57B: the terms in the order they stand after the insertion` (LIST "adult", "bank") "building society" TRUE EQUALS NOTHING
