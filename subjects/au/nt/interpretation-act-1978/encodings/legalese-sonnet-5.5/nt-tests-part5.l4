IMPORT prelude
IMPORT daydate
IMPORT `nt-part5-powers`

-- Tests of nt-part5-powers.l4 (sections 39 to 48B).
-- Every expected value is written from the text of the section named beside it.

§ `Section 39`

#ASSERT `s 39: the appointment or exercise of the power ceases to have effect or needs to be confirmed` TRUE EQUALS JUST FALSE
#ASSERT `s 39: the appointment or exercise of the power ceases to have effect or needs to be confirmed` FALSE EQUALS NOTHING

§ `Section 40`

-- (1)(b): the office-holder ceased on 10 March 2025; 1 year after is the last day of the year dating from that day, 10 March 2026.
-- No revocation: the person acting may continue to 10 March 2026.
#ASSERT `s 40(1): the last day on which the person acting may continue to act` (Date 10 3 2025) NOTHING EQUALS JUST (Date 10 3 2026)
-- (1)(a): a revocation earlier than that ends it earlier.
#ASSERT `s 40(1): the last day on which the person acting may continue to act` (Date 10 3 2025) (JUST (Date 1 9 2025)) EQUALS JUST (Date 1 9 2025)
-- A revocation after the year has run is later than the earlier of the two, so the year governs.
#ASSERT `s 40(1): the last day on which the person acting may continue to act` (Date 10 3 2025) (JUST (Date 11 3 2026)) EQUALS JUST (Date 10 3 2026)
-- A revocation on the last day of the year: either way, that day.
#ASSERT `s 40(1): the last day on which the person acting may continue to act` (Date 10 3 2025) (JUST (Date 10 3 2026)) EQUALS JUST (Date 10 3 2026)
-- A start on 29 February: the year counted from 1 March 2024 ends on 28 February 2025.
#ASSERT `s 40(1): the last day on which the person acting may continue to act` (Date 29 2 2024) NOTHING EQUALS JUST (Date 28 2 2025)
#ASSERT `s 40(2) "acting in an office": the person is acting in the office` TRUE EQUALS JUST TRUE
#ASSERT `s 40(2) "acting in an office": the person is acting in the office` FALSE EQUALS NOTHING
#ASSERT `s 40(2) "office": the thing is an office` TRUE EQUALS JUST TRUE
#ASSERT `s 40(2) "office": the thing is an office` FALSE EQUALS NOTHING

§ `Section 41`

#ASSERT `s 41(1): the power may be exercised and the duty performed on the occasion` TRUE EQUALS JUST TRUE
#ASSERT `s 41(1): the power may be exercised and the duty performed on the occasion` FALSE EQUALS NOTHING
#ASSERT `s 41(2): the person may exercise the power and must perform the duty` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 41(2): the person may exercise the power and must perform the duty` TRUE FALSE EQUALS NOTHING
#ASSERT `s 41(2): the person may exercise the power and must perform the duty` FALSE TRUE EQUALS NOTHING

§ `Sections 42 to 44A`

#ASSERT `s 42(1): the power to make, grant or issue a statutory instrument may be exercised in that manner` `in whole or in part` EQUALS JUST TRUE
#ASSERT `s 42(1): the power to make, grant or issue a statutory instrument may be exercised in that manner` `so that it is subject to conditions, limitations or qualifications specified in the instrument` EQUALS JUST TRUE
#ASSERT `s 42(1): the power to make, grant or issue a statutory instrument may be exercised in that manner` `to make different provision in relation to different matters or classes of matters` EQUALS JUST TRUE
#ASSERT `s 42(1): the power to make, grant or issue a statutory instrument may be exercised in that manner` `to apply differently by reference to exceptions or factors specified in the instrument` EQUALS JUST TRUE
#ASSERT `s 42(1): the power to make, grant or issue a statutory instrument may be exercised in that manner` `in some other manner` EQUALS NOTHING
#ASSERT `s 42(2): the power is limited to a particular matter or aspect of a matter` TRUE EQUALS JUST FALSE
#ASSERT `s 42(2): the power is limited to a particular matter or aspect of a matter` FALSE EQUALS NOTHING
#ASSERT `s 42(4): section 42 applies in relation to the power` TRUE EQUALS JUST TRUE
#ASSERT `s 42(4): section 42 applies in relation to the power` FALSE EQUALS JUST TRUE
#ASSERT `s 43: the power includes the power to do the thing to the action or instrument, in the same manner and subject to the same conditions` "repeal" EQUALS JUST TRUE
#ASSERT `s 43: the power includes the power to do the thing to the action or instrument, in the same manner and subject to the same conditions` "rescind" EQUALS JUST TRUE
#ASSERT `s 43: the power includes the power to do the thing to the action or instrument, in the same manner and subject to the same conditions` "revoke" EQUALS JUST TRUE
#ASSERT `s 43: the power includes the power to do the thing to the action or instrument, in the same manner and subject to the same conditions` "amend" EQUALS JUST TRUE
#ASSERT `s 43: the power includes the power to do the thing to the action or instrument, in the same manner and subject to the same conditions` "vary" EQUALS JUST TRUE
#ASSERT `s 43: the power includes the power to do the thing to the action or instrument, in the same manner and subject to the same conditions` "backdate" EQUALS NOTHING
#ASSERT `s 44(1): the power to make appointments includes the power to do the thing to the person appointed` "terminate the appointment" EQUALS JUST TRUE
#ASSERT `s 44(1): the power to make appointments includes the power to do the thing to the person appointed` "remove" EQUALS JUST TRUE
#ASSERT `s 44(1): the power to make appointments includes the power to do the thing to the person appointed` "suspend" EQUALS JUST TRUE
#ASSERT `s 44(1): the power to make appointments includes the power to do the thing to the person appointed` "promote" EQUALS NOTHING
#ASSERT `s 44(3): the power of termination or removal may be exercised` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 44(3): the power of termination or removal may be exercised` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 44(3): the power of termination or removal may be exercised` FALSE FALSE EQUALS NOTHING
#ASSERT `s 44A: the appointer may appoint a person, or 2 or more people, to act` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 44A: the appointer may appoint a person, or 2 or more people, to act` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 44A: the appointer may appoint a person, or 2 or more people, to act` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 44A: the appointer may appoint a person, or 2 or more people, to act` FALSE TRUE TRUE EQUALS NOTHING

§ `Sections 46 and 46A`

#ASSERT `s 46(3): authority may be conferred on a person in that way` `a person by name` EQUALS JUST TRUE
#ASSERT `s 46(3): authority may be conferred on a person in that way` `a person by reference to the office, position or designation held or occupied by the person` EQUALS JUST TRUE
#ASSERT `s 46(3): authority may be conferred on a person in that way` `a person from time to time holding, acting in or performing the duties of a named office, designation or position` EQUALS JUST TRUE
#ASSERT `s 46(3): authority may be conferred on a person in that way` `a person in some other way` EQUALS NOTHING
-- (7).
#ASSERT `s 46(7): section 46 applies to the function or power` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 46(7): section 46 applies to the function or power` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 46(7): section 46 applies to the function or power` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 46(7): section 46 applies to the function or power` FALSE FALSE FALSE EQUALS NOTHING
-- (1), (2): a minister's function; another person's function; written evidence; the section not applying.
#ASSERT `s 46(1), (2): the person may perform the function or exercise the power by authority` TRUE TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 46(1), (2): the person may perform the function or exercise the power by authority` TRUE TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 46(1), (2): the person may perform the function or exercise the power by authority` TRUE FALSE FALSE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 46(1), (2): the person may perform the function or exercise the power by authority` TRUE FALSE FALSE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 46(1), (2): the person may perform the function or exercise the power by authority` TRUE FALSE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 46(1), (2): the person may perform the function or exercise the power by authority` TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 46(1), (2): the person may perform the function or exercise the power by authority` TRUE FALSE FALSE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 46(1), (2): the person may perform the function or exercise the power by authority` FALSE TRUE TRUE FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 46(5): the conferring of authority prevents the person from exercising the power` `the person conferring the authority` EQUALS JUST FALSE
#ASSERT `s 46(5): the conferring of authority prevents the person from exercising the power` `another person on whom authority to exercise the power or perform the function is conferred` EQUALS JUST FALSE
#ASSERT `s 46(5): the conferring of authority prevents the person from exercising the power` `anyone else` EQUALS NOTHING
#ASSERT `s 46(6): the performance or exercise is within the authority conferred` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 46(6): the performance or exercise is within the authority conferred` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 46(6): the performance or exercise is within the authority conferred` FALSE TRUE EQUALS NOTHING
#ASSERT `s 46A(1): the power to delegate may be exercised by delegating to a person in that way` `a person by name` EQUALS JUST TRUE
#ASSERT `s 46A(1): the power to delegate may be exercised by delegating to a person in that way` `a person from time to time holding, acting in or performing the duties of a named office, designation or position` EQUALS JUST TRUE
#ASSERT `s 46A(1): the power to delegate may be exercised by delegating to a person in that way` `a person in some other way` EQUALS NOTHING
#ASSERT `s 46A(2): the power to delegate includes the power to delegate that power of delegation` TRUE EQUALS JUST FALSE
#ASSERT `s 46A(2): the power to delegate includes the power to delegate that power of delegation` FALSE EQUALS NOTHING
#ASSERT `s 46A(3): the person by whom the power or function is taken to be exercised or performed` "the Chief Executive Officer" TRUE EQUALS JUST "the Chief Executive Officer"
#ASSERT `s 46A(3): the person by whom the power or function is taken to be exercised or performed` "the Chief Executive Officer" FALSE EQUALS NOTHING
#ASSERT `s 46A(4): the delegation prevents the person who delegated from exercising the power or performing the function` TRUE EQUALS JUST FALSE
#ASSERT `s 46A(4): the delegation prevents the person who delegated from exercising the power or performing the function` FALSE EQUALS NOTHING

§ `Sections 48 to 48B`

#ASSERT `s 48: the power may be exercised upon the opinion, belief or state of mind of the delegate or authorised person` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 48: the power may be exercised upon the opinion, belief or state of mind of the delegate or authorised person` TRUE FALSE EQUALS NOTHING
#ASSERT `s 48: the power may be exercised upon the opinion, belief or state of mind of the delegate or authorised person` FALSE TRUE EQUALS NOTHING
#ASSERT `s 48A(1): section 48A applies to the body` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 48A(1): section 48A applies to the body` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 48A(1): section 48A applies to the body` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 48A(2): the body may permit its members to participate in a meeting by any means of communication` TRUE EQUALS JUST TRUE
#ASSERT `s 48A(2): the body may permit its members to participate in a meeting by any means of communication` FALSE EQUALS NOTHING
#ASSERT `s 48A(3): the member is taken to be present at the meeting` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 48A(3): the member is taken to be present at the meeting` TRUE FALSE EQUALS NOTHING
#ASSERT `s 48A(3): the member is taken to be present at the meeting` FALSE TRUE EQUALS NOTHING
#ASSERT `s 48B(1): the decision maker may correct the decision` TRUE `a clerical mistake` `of the decision maker's own motion` EQUALS JUST TRUE
#ASSERT `s 48B(1): the decision maker may correct the decision` TRUE `an error arising from an accidental slip or omission` `on application by a party to the proceeding` EQUALS JUST TRUE
#ASSERT `s 48B(1): the decision maker may correct the decision` TRUE `a material miscalculation of figures or a material mistake in the description of a person, thing or matter referred to in the decision` `of the decision maker's own motion` EQUALS JUST TRUE
#ASSERT `s 48B(1): the decision maker may correct the decision` TRUE `a defect of form` `on application by a party to the proceeding` EQUALS JUST TRUE
#ASSERT `s 48B(1): the decision maker may correct the decision` TRUE `some other error` `of the decision maker's own motion` EQUALS NOTHING
#ASSERT `s 48B(1): the decision maker may correct the decision` TRUE `a clerical mistake` `in a way not named` EQUALS NOTHING
#ASSERT `s 48B(1): the decision maker may correct the decision` FALSE `a clerical mistake` `of the decision maker's own motion` EQUALS NOTHING
#ASSERT `s 48B(2): the thing is a decision` `a judgment` EQUALS JUST TRUE
#ASSERT `s 48B(2): the thing is a decision` `an order` EQUALS JUST TRUE
#ASSERT `s 48B(2): the thing is a decision` `a determination` EQUALS JUST TRUE
#ASSERT `s 48B(2): the thing is a decision` `the reasons for a decision` EQUALS JUST TRUE
#ASSERT `s 48B(2): the thing is a decision` `something other than a judgment, order, determination or reasons` EQUALS NOTHING
