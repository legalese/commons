IMPORT prelude
IMPORT daydate
IMPORT `nt-part7a-reprints`

-- Tests of nt-part7a-reprints.l4 (sections 72A to 72D).
-- Every expected value is written from the text of the section named beside it.

§ `Section 72A`

#ASSERT `s 72A "legislation": the thing is legislation` `an Act that may be reprinted` EQUALS JUST TRUE
#ASSERT `s 72A "legislation": the thing is legislation` `subordinate legislation that may be reprinted` EQUALS JUST TRUE
#ASSERT `s 72A "legislation": the thing is legislation` `something else that may be reprinted` EQUALS JUST FALSE
#ASSERT `s 72A "reprint": the document is a reprint of the legislation` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 72A "reprint": the document is a reprint of the legislation` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 72A "reprint": the document is a reprint of the legislation` FALSE TRUE EQUALS JUST FALSE

§ `Section 72B`

-- The reprint is dated 21 April 2023.
#ASSERT `s 72B(1): the reprint must show the amendment as in force` (Date 21 4 2023) (Date 21 4 2023) EQUALS JUST TRUE
#ASSERT `s 72B(1): the reprint must show the amendment as in force` (Date 20 4 2023) (Date 21 4 2023) EQUALS JUST TRUE
#ASSERT `s 72B(1): the reprint must show the amendment as in force` (Date 22 4 2023) (Date 21 4 2023) EQUALS JUST FALSE
#ASSERT `s 72B(2), (3): the reprint may include the amendment` (Date 21 4 2023) (Date 21 4 2023) FALSE EQUALS JUST TRUE
#ASSERT `s 72B(2), (3): the reprint may include the amendment` (Date 22 4 2023) (Date 21 4 2023) FALSE EQUALS JUST FALSE
#ASSERT `s 72B(2), (3): the reprint may include the amendment` (Date 22 4 2023) (Date 21 4 2023) TRUE EQUALS JUST TRUE

§ `Sections 72C and 72D`

#ASSERT `s 72C: the reprint may include the item` `the words of making the legislation` EQUALS JUST FALSE
#ASSERT `s 72C: the reprint may include the item` `the date of the making of the legislation` EQUALS JUST FALSE
#ASSERT `s 72C: the reprint may include the item` `the signature of the person making the legislation` EQUALS JUST FALSE
#ASSERT `s 72C: the reprint may include the item` `another item` EQUALS NOTHING
#ASSERT `s 72D(a): the table of amendments lists each amending Act or instrument` (LIST "Amending Act 2001", "Amending Act 2010") (LIST "Amending Act 2010", "Amending Act 2001") EQUALS JUST TRUE
#ASSERT `s 72D(a): the table of amendments lists each amending Act or instrument` (LIST "Amending Act 2001", "Amending Act 2010") (LIST "Amending Act 2001") EQUALS JUST FALSE
#ASSERT `s 72D(a): the table of amendments lists each amending Act or instrument` EMPTY EMPTY EQUALS JUST TRUE
#ASSERT `s 72D(b): the table of amendments lists each provision that has been amended` (LIST "s 3 (Amending Act 2001)", "s 5 (Amending Act 2010)") (LIST "s 5 (Amending Act 2010)", "s 3 (Amending Act 2001)") EQUALS JUST TRUE
#ASSERT `s 72D(b): the table of amendments lists each provision that has been amended` (LIST "s 3 (Amending Act 2001)", "s 5 (Amending Act 2010)") (LIST "s 3 (Amending Act 2001)") EQUALS JUST FALSE
