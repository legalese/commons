#ASSERT `s 108 -- was it prohibited coercion or inducement` TRUE FALSE `use, or not use, a power under the Act (s 108(1)(a))` FALSE EQUALS JUST FALSE
#ASSERT `s 108 -- was it prohibited coercion or inducement` TRUE TRUE `use, or not use, a power under the Act (s 108(1)(a))` TRUE EQUALS JUST FALSE
