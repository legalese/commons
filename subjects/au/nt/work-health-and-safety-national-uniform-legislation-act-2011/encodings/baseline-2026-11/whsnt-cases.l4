#ASSERT `s 231 -- may I ask for a prosecution` `Cat 2` TRUE FALSE (`the calendar date` 15 1 2026) (`the calendar date` 15 1 2027) TRUE EQUALS JUST TRUE
#ASSERT `s 231 -- may I ask for a prosecution` `Cat 2` TRUE FALSE (`the calendar date` 15 1 2026) (`the calendar date` 16 1 2027) TRUE EQUALS JUST FALSE
