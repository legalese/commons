#ASSERT `the conveyance is exempt under Schedule 2 item 6(d)` TRUE
#ASSERT `the conveyance is exempt under Schedule 2 item 6(e)` TRUE TRUE
#ASSERT NOT (`the conveyance is exempt under Schedule 2 item 6(e)` FALSE TRUE)
#ASSERT `the conveyance is exempt under Schedule 2 item 7` (`Transfer between spouses` WITH `there are 2 parties and each is the spouse or de facto partner of the other` IS TRUE, `the property is the parties' principal place of residence` IS TRUE, `no consideration is given` IS TRUE, `both will own the home in equal shares` IS TRUE, `no other person takes an interest` IS TRUE)
#ASSERT NOT (`the conveyance is exempt under Schedule 2 item 7` (`Transfer between spouses` WITH `there are 2 parties and each is the spouse or de facto partner of the other` IS TRUE, `the property is the parties' principal place of residence` IS TRUE, `no consideration is given` IS TRUE, `both will own the home in equal shares` IS TRUE, `no other person takes an interest` IS FALSE))
