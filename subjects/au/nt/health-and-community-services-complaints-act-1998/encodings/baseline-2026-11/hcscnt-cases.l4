§§ `s 30 -- no further action`

#ASSERT `s 30 -- must the Commissioner take no further action` FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `GOES ON`
#ASSERT `s 30 -- must the Commissioner take no further action` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `no further action: I did not, without good reason, take reasonable steps to resolve it with the provider (s 30(1)(d))`
#ASSERT `s 30 -- must the Commissioner take no further action` FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS `no further action: further investigation is unnecessary or unjustified, or the complaint lacks substance or is frivolous, vexatious or not in good faith (s 30(1)(e) to (g))`
#ASSERT `s 30 -- must the Commissioner take no further action` FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS `no further action: the complaint is resolved (s 30(1)(h))`
#ASSERT `s 30 -- must the Commissioner take no further action` FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS `no further action on the issue a court, tribunal or board has determined (s 30(3))`
#ASSERT `s 30 -- must the Commissioner take no further action` FALSE FALSE FALSE TRUE TRUE FALSE FALSE EQUALS `GOES ON`
#ASSERT `s 30 -- must the Commissioner take no further action` FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS `no further action: the court has begun to hear the user's civil proceedings on it (s 30(4))`
#ASSERT `s 30 -- must the Commissioner take no further action` FALSE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS `the Commissioner may still consider an issue the civil proceedings will not determine (s 30(5))`
-- fork F2: the first ground is reported
#ASSERT `s 30 -- must the Commissioner take no further action` TRUE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS `no further action: I did not, without good reason, take reasonable steps to resolve it with the provider (s 30(1)(d))`

