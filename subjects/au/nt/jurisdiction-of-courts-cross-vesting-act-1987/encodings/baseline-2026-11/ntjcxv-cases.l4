#ASSERT `s 10, s 16 -- can my consumer law case go to a lower court` FALSE FALSE `FCA` `ACL listed` FALSE FALSE TRUE EQUALS `s 10 yes`
#ASSERT `s 10, s 16 -- can my consumer law case go to a lower court` FALSE FALSE `FCWA` `ACL listed` FALSE FALSE TRUE EQUALS `s 10 yes`
