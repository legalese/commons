-- Both 17, neither exempt: s 8(1)(b).
#ASSERT (`Am I eligible for the first home owner grant` `a comprehensive home building contract` (DATE_FROM_DMY 1 12 2027) (DATE_FROM_DMY 1 12 2027) 17 FALSE `an Australian citizen` `no grant was paid on an earlier application` FALSE FALSE `never held a relevant interest in residential property in Australia` TRUE FALSE `a de facto partner` FALSE TRUE 17 FALSE `a New Zealand citizen who holds a special category visa` `no grant was paid on an earlier application` FALSE FALSE `never held a relevant interest in residential property in Australia` FALSE FALSE FALSE) EQUALS (`not eligible` `s 8(1)(b), (3): no applicant was 18 or over at the commencement date, and not every applicant has the Commissioner's exemption`)
