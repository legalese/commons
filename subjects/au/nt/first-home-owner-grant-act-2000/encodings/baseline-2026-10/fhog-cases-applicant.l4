-- CASE 11. The threshold (s 3, s 13AA). HYPOTHETICAL.
-- =====================================================================================================================
-- s 3(a): before 4 Dec 2012: $750,000.
#ASSERT `the threshold amount (s 3)` (DATE_FROM_DMY 3 12 2012) EQUALS 750000
-- s 3(b): on or after 4 Dec 2012: $600,000.
#ASSERT `the threshold amount (s 3)` (DATE_FROM_DMY 4 12 2012) EQUALS 600000
-- s 13AA(1)(b), (4)(a): commencement before 13 May 2014, $650,000 > $600,000.
#ASSERT (`Is my transaction an eligible transaction` `a contract for the purchase of a home` (DATE_FROM_DMY 1 3 2013) (DATE_FROM_DMY 15 3 2026) TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE 650000 0 0 FALSE) EQUALS (`not an eligible transaction` `s 13AA(1)(b)-(e): a threshold-relevant transaction over the threshold amount`)
-- s 13AA(1)(c): 2011, price $700,000 is under $750,000, but home $300,000 + land $480,000 = $780,000 > $750,000.
#ASSERT (`Is my transaction an eligible transaction` `a contract for the purchase of a home` (DATE_FROM_DMY 1 3 2011) (DATE_FROM_DMY 15 3 2026) TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE 700000 300000 480000 FALSE) EQUALS (`not an eligible transaction` `s 13AA(1)(b)-(e): a threshold-relevant transaction over the threshold amount`)
-- Home $300,000 + land $400,000 = $700,000, not more than $750,000.
#ASSERT (`Is my transaction an eligible transaction` `a contract for the purchase of a home` (DATE_FROM_DMY 1 3 2011) (DATE_FROM_DMY 15 3 2026) TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE 700000 300000 400000 FALSE) EQUALS `an eligible transaction (s 13(1))`
-- s 13AA(4)(b): from 13 May 2014 only an established home's purchase is threshold-relevant; a new home at $650,000 is eligible.
#ASSERT (`Is my transaction an eligible transaction` `a contract for the purchase of a home` (DATE_FROM_DMY 1 8 2014) (DATE_FROM_DMY 15 3 2026) TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE 650000 0 0 FALSE) EQUALS `an eligible transaction (s 13(1))`
-- The same price for an established home in Aug 2014: over $600,000.
#ASSERT (`Is my transaction an eligible transaction` `a contract for the purchase of a home` (DATE_FROM_DMY 1 8 2014) (DATE_FROM_DMY 15 3 2026) TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE 650000 0 0 FALSE) EQUALS (`not an eligible transaction` `s 13AA(1)(b)-(e): a threshold-relevant transaction over the threshold amount`)
-- s 13AA(1)(d): building contract $450,000 + land $200,000 = $650,000 > $600,000.
#ASSERT (`Is my transaction an eligible transaction` `a comprehensive home building contract` (DATE_FROM_DMY 1 3 2013) (DATE_FROM_DMY 15 3 2026) TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE 450000 0 200000 FALSE) EQUALS (`not an eligible transaction` `s 13AA(1)(b)-(e): a threshold-relevant transaction over the threshold amount`)
-- From 1 Jan 2015 no building contract is threshold-relevant (s 13AA(4)): no cap.
#ASSERT (`Is my transaction an eligible transaction` `a comprehensive home building contract` (DATE_FROM_DMY 1 3 2016) (DATE_FROM_DMY 15 3 2026) TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE 450000 0 900000 FALSE) EQUALS `an eligible transaction (s 13(1))`

