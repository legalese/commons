#ASSERT (`Is my home a new home` `a comprehensive home building contract` TRUE TRUE FALSE FALSE) EQUALS FALSE

-- =====================================================================================================================
-- CASE 13. Relevant interest (s 5, regs r 3). HYPOTHETICAL.
-- =====================================================================================================================
-- s 5(2)(a): an estate in fee simple, with a right to occupy.
#ASSERT (`Do I have a relevant interest in the land` `an estate in fee simple` 0 TRUE FALSE FALSE FALSE FALSE FALSE FALSE `someone who is not a relative of the person` FALSE) EQUALS TRUE
-- s 5(2)(g): a registered Crown lease needs a term of 15 years or more.
#ASSERT (`Do I have a relevant interest in the land` `an interest as lessee or sublessee under a registered lease granted by the Commonwealth or the Territory` 10 TRUE FALSE FALSE FALSE FALSE FALSE FALSE `someone who is not a relative of the person` FALSE) EQUALS FALSE
-- A 99-year Crown lease.
#ASSERT (`Do I have a relevant interest in the land` `an interest as lessee or sublessee under a registered lease granted by the Commonwealth or the Territory` 99 TRUE FALSE FALSE FALSE FALSE FALSE FALSE `someone who is not a relative of the person` FALSE) EQUALS TRUE
-- s 5(2)(h): a 40-year lease under s 19 or 19A of the Land Rights Act (for example a township lease sublease).
#ASSERT (`Do I have a relevant interest in the land` `an interest as lessee or sublessee under a registered lease or sublease granted under s 19 or 19A of the Aboriginal Land Rights (Northern Territory) Act 1976` 40 TRUE FALSE FALSE FALSE FALSE FALSE FALSE `someone who is not a relative of the person` FALSE) EQUALS TRUE
-- A 14-year one is not.
#ASSERT (`Do I have a relevant interest in the land` `an interest as lessee or sublessee under a registered lease or sublease granted under s 19 or 19A of the Aboriginal Land Rights (Northern Territory) Act 1976` 14 TRUE FALSE FALSE FALSE FALSE FALSE FALSE `someone who is not a relative of the person` FALSE) EQUALS FALSE
-- s 5(3)(b): held subject to a trust.
#ASSERT (`Do I have a relevant interest in the land` `an estate in fee simple` 0 TRUE TRUE FALSE FALSE FALSE FALSE FALSE `someone who is not a relative of the person` FALSE) EQUALS FALSE
-- s 5(3)(c): an equitable interest.
#ASSERT (`Do I have a relevant interest in the land` `an estate in fee simple` 0 TRUE FALSE TRUE FALSE FALSE FALSE FALSE `someone who is not a relative of the person` FALSE) EQUALS FALSE
-- ...unless a guardian holds it in trust for a person under a legal disability.
#ASSERT (`Do I have a relevant interest in the land` `an estate in fee simple` 0 TRUE FALSE TRUE TRUE FALSE FALSE FALSE `someone who is not a relative of the person` FALSE) EQUALS TRUE
-- s 5(3)(a): no right to immediate occupation within 12 months (tenanted for three more years).
#ASSERT (`Do I have a relevant interest in the land` `an estate in fee simple` 0 FALSE FALSE FALSE FALSE FALSE FALSE FALSE `someone who is not a relative of the person` FALSE) EQUALS FALSE
-- s 5(3)(d): the lessor under a s 5(2) lease.
#ASSERT (`Do I have a relevant interest in the land` `an estate in fee simple` 0 TRUE FALSE FALSE FALSE TRUE FALSE FALSE `someone who is not a relative of the person` FALSE) EQUALS FALSE
-- regs r 3(2): building on a parent's (non-farming) land with the parent's permission.
#ASSERT (`Do I have a relevant interest in the land` `none of these interests` 0 TRUE FALSE FALSE FALSE FALSE TRUE FALSE `a parent of the person, or of the person's spouse or de facto partner` TRUE) EQUALS TRUE
-- regs r 3(3)(g): a sibling's spouse is a relative.
#ASSERT (`Do I have a relevant interest in the land` `none of these interests` 0 TRUE FALSE FALSE FALSE FALSE TRUE FALSE `a spouse or de facto partner of a sibling, child or grandchild in this list` TRUE) EQUALS TRUE
-- A cousin is not in the r 3(3) list.
#ASSERT (`Do I have a relevant interest in the land` `none of these interests` 0 TRUE FALSE FALSE FALSE FALSE TRUE FALSE `someone who is not a relative of the person` TRUE) EQUALS FALSE
-- regs r 3(1): farming land, any owner, with permission.
#ASSERT (`Do I have a relevant interest in the land` `none of these interests` 0 TRUE FALSE FALSE FALSE FALSE TRUE TRUE `someone who is not a relative of the person` TRUE) EQUALS TRUE
-- No permission to occupy: no non-conforming interest.
#ASSERT (`Do I have a relevant interest in the land` `none of these interests` 0 TRUE FALSE FALSE FALSE FALSE TRUE FALSE `a parent of the person, or of the person's spouse or de facto partner` FALSE) EQUALS FALSE
-- Permission but no building contract or building begun.
#ASSERT (`Do I have a relevant interest in the land` `none of these interests` 0 TRUE FALSE FALSE FALSE FALSE FALSE FALSE `a parent of the person, or of the person's spouse or de facto partner` TRUE) EQUALS FALSE

-- =====================================================================================================================
-- CASE 14. Who must join in the application (s 15, regs r 4).
-- =====================================================================================================================
-- s 15: a sibling who will co-own the home.
#ASSERT (`Must this owner join in my application` TRUE FALSE FALSE) EQUALS TRUE
-- regs r 4(a): the Chief Executive Officer (Housing).
#ASSERT (`Must this owner join in my application` TRUE TRUE FALSE) EQUALS FALSE
-- regs r 4(b): the parent whose land a person builds on under r 3(2).
#ASSERT (`Must this owner join in my application` TRUE FALSE TRUE) EQUALS FALSE
-- Not an owner of the home: not an interested person.
#ASSERT (`Must this owner join in my application` FALSE FALSE FALSE) EQUALS FALSE

-- =====================================================================================================================
-- CASE 15. Residence dates (s 12). HYPOTHETICAL.
-- =====================================================================================================================
-- READING: 12 months after 29 Feb 2028 is 28 Feb 2029.
#ASSERT (`By what date must I move into the home` `a contract for the purchase of a home` (DATE_FROM_DMY 29 2 2028) FALSE (DATE_FROM_DMY 20 5 2026) (DATE_FROM_DMY 20 5 2026) FALSE (DATE_FROM_DMY 1 1 2030)) EQUALS (DATE_FROM_DMY 28 2 2029)
-- s 12(3)(a)(i): a longer period approved to 31 Aug 2027.
#ASSERT (`By what date must I move into the home` `a contract for the purchase of a home` (DATE_FROM_DMY 20 5 2026) TRUE (DATE_FROM_DMY 20 5 2026) (DATE_FROM_DMY 20 5 2026) TRUE (DATE_FROM_DMY 31 8 2027)) EQUALS (DATE_FROM_DMY 31 8 2027)
-- s 12(3)(a)(ii): a shorter period of 3 months approved.
#ASSERT (`For how many months must I live in the home` `a contract for the purchase of a home` (DATE_FROM_DMY 15 3 2026) (DATE_FROM_DMY 15 3 2026) TRUE 3) EQUALS 3
-- Contract 1 Jun 2024: 6 months (s 12(2)(b)(ii)); 6 months from 31 Aug 2024 ends 28 Feb 2025 (READING).
#ASSERT (`Until what date must I keep living in the home` `a contract for the purchase of a home` (DATE_FROM_DMY 1 6 2024) (DATE_FROM_DMY 15 3 2026) (DATE_FROM_DMY 31 8 2024) FALSE 0) EQUALS (DATE_FROM_DMY 28 2 2025)
-- 12 months from 31 Jan 2027.
#ASSERT (`Until what date must I keep living in the home` `a contract for the purchase of a home` (DATE_FROM_DMY 15 3 2026) (DATE_FROM_DMY 15 3 2026) (DATE_FROM_DMY 31 1 2027) FALSE 0) EQUALS (DATE_FROM_DMY 31 1 2028)

-- =====================================================================================================================
-- CASE 16. Repaying (s 41). HYPOTHETICAL: Mia's $50,000 grant was paid on 1 Jun 2026.
-- =====================================================================================================================
-- s 41(2A)(a): 30 days after the grant was paid (1 Jun 2026 + 30 days).
#ASSERT (`By what date must I tell the Commissioner and repay the grant` `not entitled to the grant under s 7 (s 41(1)(a))` (DATE_FROM_DMY 1 6 2026) (DATE_FROM_DMY 20 5 2026) (DATE_FROM_DMY 20 5 2027) (DATE_FROM_DMY 1 3 2027) (DATE_FROM_DMY 10 1 2027)) EQUALS (DATE_FROM_DMY 1 7 2026)
-- s 41(2A)(b): the earlier of completion (1 Aug 2013) and when it became apparent (15 Jul 2013), + 30 = 14 Aug 2013.
#ASSERT (`By what date must I tell the Commissioner and repay the grant` `paid before completion, and on completion the consideration takes it over the threshold (s 41(1)(b))` (DATE_FROM_DMY 1 6 2026) (DATE_FROM_DMY 1 8 2013) (DATE_FROM_DMY 20 5 2027) (DATE_FROM_DMY 15 7 2013) (DATE_FROM_DMY 10 1 2027)) EQUALS (DATE_FROM_DMY 14 8 2013)
-- s 41(2A)(c): she decides on 1 Mar 2027 to move out early; earlier of 20 May 2027 and 1 Mar 2027, + 30.
#ASSERT (`By what date must I tell the Commissioner and repay the grant` `paid in anticipation of the residence requirements, which are not complied with (s 41(1)(c))` (DATE_FROM_DMY 1 6 2026) (DATE_FROM_DMY 20 5 2026) (DATE_FROM_DMY 20 5 2027) (DATE_FROM_DMY 1 3 2027) (DATE_FROM_DMY 10 1 2027)) EQUALS (DATE_FROM_DMY 31 3 2027)
-- s 41(2A)(c)(i), read literally: she moved in on time but it became apparent only on 15 Jun 2027 that she would leave early;
-- the earlier date is the move-in deadline, 20 May 2027, so the 30 days ended 19 Jun 2027 (finding 9).
#ASSERT (`By what date must I tell the Commissioner and repay the grant` `paid in anticipation of the residence requirements, which are not complied with (s 41(1)(c))` (DATE_FROM_DMY 1 6 2026) (DATE_FROM_DMY 20 5 2026) (DATE_FROM_DMY 20 5 2027) (DATE_FROM_DMY 15 6 2027) (DATE_FROM_DMY 10 1 2027)) EQUALS (DATE_FROM_DMY 19 6 2027)
-- s 41(2A)(d): 30 days after the breach on 10 Jan 2027.
#ASSERT (`By what date must I tell the Commissioner and repay the grant` `a condition imposed under s 5(5) or s 20 is breached (s 41(1)(d))` (DATE_FROM_DMY 1 6 2026) (DATE_FROM_DMY 20 5 2026) (DATE_FROM_DMY 20 5 2027) (DATE_FROM_DMY 1 3 2027) (DATE_FROM_DMY 10 1 2027)) EQUALS (DATE_FROM_DMY 9 2 2027)
-- s 41(2A)(d): 30 days after an overpayment on 3 Mar 2027.
#ASSERT (`By what date must I tell the Commissioner and repay the grant` `an overpayment (s 41(1)(e))` (DATE_FROM_DMY 1 6 2026) (DATE_FROM_DMY 20 5 2026) (DATE_FROM_DMY 20 5 2027) (DATE_FROM_DMY 1 3 2027) (DATE_FROM_DMY 3 3 2027)) EQUALS (DATE_FROM_DMY 2 4 2027)
-- s 41(3)(a), (12), TAA s 35: 4.35% + 8% = 12.35%; 1 Jul to 12 Sep 2026 is 73 days; 50,000 x 0.1235 x 73/365 = 1,235.
#ASSERT (`How much interest do I owe on a late repayment` 50000 (DATE_FROM_DMY 1 7 2026) (DATE_FROM_DMY 12 9 2026) 0.0435) EQUALS 1235
-- TAA s 35(1), (3)(b): market rate plus 8%.
#ASSERT `the statutory interest rate (TAA s 35)` 0.0435 EQUALS 0.1235
-- s 41(3)(b): $50,000 + $1,235 interest + a $50,000 penalty.
#ASSERT (`What can the Commissioner's notice require me to pay` 50000 1235 0) EQUALS 101235
-- s 41(7): $25,000 of the penalty remitted.
#ASSERT (`What can the Commissioner's notice require me to pay` 50000 1235 25000) EQUALS 76235
-- s 41(5): an overriding statutory charge on her interest in the home.
#ASSERT (`Is what I owe a charge on my home` TRUE TRUE) EQUALS TRUE
-- She has sold the home: no interest for the charge to attach to.
#ASSERT (`Is what I owe a charge on my home` TRUE FALSE) EQUALS FALSE
-- s 41(11): two applicants are jointly and severally liable.
#ASSERT (`Can I be made to repay all of it` 2) EQUALS TRUE
-- One applicant alone.
#ASSERT (`Can I be made to repay all of it` 1) EQUALS FALSE

-- =====================================================================================================================
-- CASE 17. Death of an applicant (s 21). HYPOTHETICAL.
-- =====================================================================================================================
-- s 21(2)(a): Josh dies before the decision; Ana survives.
#ASSERT (`What happens to our application if an applicant dies` TRUE TRUE TRUE) EQUALS `the application does not lapse, and is dealt with as if the surviving applicants were the sole applicants (s 21(1), (2)(a))`
-- s 21(2)(b), (3): a sole applicant dies before moving in; the Commissioner is satisfied she meant to.
#ASSERT (`What happens to our application if an applicant dies` FALSE TRUE TRUE) EQUALS `the application does not lapse; any grant payable is paid to the estate, and the residence requirements are satisfied (s 21(1), (2)(b), (3))`
-- s 21(3) speaks only of one who had not occupied the home (finding 10).
#ASSERT (`What happens to our application if an applicant dies` FALSE FALSE TRUE) EQUALS `the application does not lapse; any grant payable is paid to the estate (s 21(1), (2)(b))`

-- =====================================================================================================================
-- CASE 18. The regulative rules of the core. Clock: days.
-- A breached or still-pending DEONTIC cannot be asserted on the stable l4, so a rule is asserted where its trace ends
-- FULFILLED, and #TRACEd with an "-- expect:" line where it does not.
-- =====================================================================================================================
-- s 41(2), (2A)(a): notice on day 10 and repayment on day 20 after the grant was paid.
#ASSERT EVALTRACE (`s 41(2), (2A) -- the person paid the grant must notify the Commissioner and repay within 30 days` `not entitled to the grant under s 7 (s 41(1)(a))`) 0 (LIST (EVENT `the applicant` `give the Commissioner written notice of the non-entitlement, ineligibility, failure, breach or overpayment` 10), (EVENT `the applicant` `pay the Commissioner the amount of the grant or overpayment` 20)) EQUALS FULFILLED
-- Both on day 30, the last day.
#ASSERT EVALTRACE (`s 41(2), (2A) -- the person paid the grant must notify the Commissioner and repay within 30 days` `not entitled to the grant under s 7 (s 41(1)(a))`) 0 (LIST (EVENT `the applicant` `give the Commissioner written notice of the non-entitlement, ineligibility, failure, breach or overpayment` 30), (EVENT `the applicant` `pay the Commissioner the amount of the grant or overpayment` 30)) EQUALS FULFILLED
-- expect: BREACH BY the applicant, "s 41(2)(b), (2A)(a), (3), (8): the grant was not repaid within 30 days ..." (repaid on day 31)
#TRACE `s 41(2), (2A) -- the person paid the grant must notify the Commissioner and repay within 30 days` `not entitled to the grant under s 7 (s 41(1)(a))` AT 0 WITH
    PARTY `the applicant` DOES `give the Commissioner written notice of the non-entitlement, ineligibility, failure, breach or overpayment` AT 5
    PARTY `the applicant` DOES `pay the Commissioner the amount of the grant or overpayment` AT 31
-- expect: BREACH BY the applicant, "s 41(2)(a), (2A)(d), (8): written notice of the breach of condition ..." (repaid, but no notice)
#TRACE `s 41(2), (2A) -- the person paid the grant must notify the Commissioner and repay within 30 days` `a condition imposed under s 5(5) or s 20 is breached (s 41(1)(d))` AT 0 WITH
    PARTY `the applicant` DOES `pay the Commissioner the amount of the grant or overpayment` AT 5
    (WAITUNTIL 31)
-- s 41(3)(b)(ii): paid on day 30 after the notice.
#ASSERT EVALTRACE (`s 41(3)(b), (c), (6) -- after the Commissioner's notice, the person must pay the amount in default, the interest and the penalty within 30 days` FALSE) 0 (LIST (EVENT `the applicant` `pay the amount in default, the interest and the penalty` 30)) EQUALS FULFILLED
-- expect: BREACH BY the applicant, "s 41(3)(b)(ii), (c), (8): ... interest now accrues on the penalty too ..."
#TRACE `s 41(3)(b), (c), (6) -- after the Commissioner's notice, the person must pay the amount in default, the interest and the penalty within 30 days` FALSE AT 0 WITH
    (WAITUNTIL 31)
-- s 41(6): under an instalment arrangement the duty is to pay as it requires.
#ASSERT EVALTRACE (`s 41(3)(b), (c), (6) -- after the Commissioner's notice, the person must pay the amount in default, the interest and the penalty within 30 days` TRUE) 0 (LIST (EVENT `the applicant` `pay the instalments the arrangement requires` 100)) EQUALS FULFILLED
-- Mia: completion 20 May 2026 to the move-in deadline 20 May 2027 is 365 days (no 29 February between).
#ASSERT `days from` (DATE_FROM_DMY 20 5 2026) (DATE_FROM_DMY 20 5 2027) EQUALS 365
-- Moving in 1 Jun 2026 (day 12), 12 months is 365 days.
#ASSERT `days from` (DATE_FROM_DMY 1 6 2026) (DATE_FROM_DMY 1 6 2027) EQUALS 365
-- Mia moves in on day 12 and is still there on day 378 (12 + 365 + 1): the residence requirements are met.
#ASSERT EVALTRACE (`s 12(1), (2) -- the applicant must start to occupy the home within 12 months of completion and continue for the required period` 365 365 FALSE TRUE) 0 (LIST (EVENT `the applicant` `begin to occupy the home as the principal place of residence` 12), (WAITUNTIL 378)) EQUALS FULFILLED
-- She moves out on day 200; paid in anticipation (s 17(3)), so s 41(1)(c): notice on day 210 and repayment on day 220, within 30 days.
#ASSERT EVALTRACE (`s 12(1), (2) -- the applicant must start to occupy the home within 12 months of completion and continue for the required period` 365 365 FALSE TRUE) 0 (LIST (EVENT `the applicant` `begin to occupy the home as the principal place of residence` 12), (EVENT `the applicant` `cease to occupy the home as the principal place of residence` 200), (EVENT `the applicant` `give the Commissioner written notice of the non-entitlement, ineligibility, failure, breach or overpayment` 210), (EVENT `the applicant` `pay the Commissioner the amount of the grant or overpayment` 220)) EQUALS FULFILLED
-- expect: BREACH BY the applicant, "s 41(2)(a), (2A)(c), (8): written notice of the failure ..." (moved out on day 200, never notified or repaid)
#TRACE `s 12(1), (2) -- the applicant must start to occupy the home within 12 months of completion and continue for the required period` 365 365 FALSE TRUE AT 0 WITH
    PARTY `the applicant` DOES `begin to occupy the home as the principal place of residence` AT 12
    PARTY `the applicant` DOES `cease to occupy the home as the principal place of residence` AT 200
    (WAITUNTIL 240)
-- She never moves in; the deadline passes on day 365; notice and repayment within 30 days of day 366.
#ASSERT EVALTRACE (`s 12(1), (2) -- the applicant must start to occupy the home within 12 months of completion and continue for the required period` 365 365 FALSE TRUE) 0 (LIST (WAITUNTIL 366), (EVENT `the applicant` `give the Commissioner written notice of the non-entitlement, ineligibility, failure, breach or overpayment` 370), (EVENT `the applicant` `pay the Commissioner the amount of the grant or overpayment` 380)) EQUALS FULFILLED
-- expect: BREACH BY the applicant, "s 12, s 7(1)(a): the residence requirements are not met ..." (not paid in anticipation)
#TRACE `s 12(1), (2) -- the applicant must start to occupy the home within 12 months of completion and continue for the required period` 365 365 FALSE FALSE AT 0 WITH
    (WAITUNTIL 366)
-- s 12(4): Ana is exempt because Josh lives there; she owes nothing.
#ASSERT EVALTRACE (`s 12(1), (2) -- the applicant must start to occupy the home within 12 months of completion and continue for the required period` 365 182 TRUE TRUE) 0 EMPTY EQUALS FULFILLED
-- s 14(3): both the applicant and the spouse give the information required.
#ASSERT EVALTRACE (`s 14(3) -- the applicant and the spouse or de facto partner must give the further information the Commissioner requires` TRUE) 0 (LIST (EVENT `the applicant` `give the Commissioner the further information the Commissioner requires` 3), (EVENT `the applicant's spouse or de facto partner` `give the Commissioner the further information the Commissioner requires` 4)) EQUALS FULFILLED
-- No spouse or de facto partner: the applicant alone.
#ASSERT EVALTRACE (`s 14(3) -- the applicant and the spouse or de facto partner must give the further information the Commissioner requires` FALSE) 0 (LIST (EVENT `the applicant` `give the Commissioner the further information the Commissioner requires` 3)) EQUALS FULFILLED
-- expect: the spouse's obligation still pending (no period is stated, so it never becomes a breach by time alone)
#TRACE `s 14(3) -- the applicant and the spouse or de facto partner must give the further information the Commissioner requires` TRUE AT 0 WITH
    PARTY `the applicant` DOES `give the Commissioner the further information the Commissioner requires` AT 3
    (WAITUNTIL 400)
