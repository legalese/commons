-- Contract 30 Sep 2024: s 13(1)(a)(ii), from 1 Jan 2015 to before 1 Oct 2024, only if new.
#ASSERT (`Is my transaction an eligible transaction` `a contract for the purchase of a home` (DATE_FROM_DMY 30 9 2024) (DATE_FROM_DMY 30 9 2025) TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE 480000 0 0 TRUE) EQUALS (`not an eligible transaction` `s 13(1)(a)(ii), (iv): a contract made from 1 January 2015 to before 1 October 2024, or from 1 October 2025, for a home that is not a new home`)
-- Contract 1 Oct 2024: s 13(1)(a)(iii) again.
#ASSERT (`Is my transaction an eligible transaction` `a contract for the purchase of a home` (DATE_FROM_DMY 1 10 2024) (DATE_FROM_DMY 30 9 2025) TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE 480000 0 0 TRUE) EQUALS `an eligible transaction (s 13(1))`
-- Contract 31 Dec 2014: s 13(1)(a)(i), whether or not new; threshold-relevant (s 13AA(4)(b)), but $480,000, and home $200,000 +
-- land $280,000 = $480,000, are not more than $600,000.
#ASSERT (`Is my transaction an eligible transaction` `a contract for the purchase of a home` (DATE_FROM_DMY 31 12 2014) (DATE_FROM_DMY 30 9 2025) TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE 480000 200000 280000 TRUE) EQUALS `an eligible transaction (s 13(1))`
-- s 18(3D)(a): new home, commencement 1 Oct 2024: $50,000.
#ASSERT (`How much is my first home owner grant` `a contract for the purchase of a home` (DATE_FROM_DMY 1 10 2024) (DATE_FROM_DMY 30 9 2025) FALSE FALSE FALSE FALSE FALSE 480000 TRUE) EQUALS (`the grant amount is` 50000)
-- s 18(3C): new home, commencement 30 Sep 2024 (from 7 May 2019 to before 1 Oct 2024): $10,000.
#ASSERT (`How much is my first home owner grant` `a contract for the purchase of a home` (DATE_FROM_DMY 30 9 2024) (DATE_FROM_DMY 30 9 2025) FALSE FALSE FALSE FALSE FALSE 480000 TRUE) EQUALS (`the grant amount is` 10000)
