-- s 13(1)(c)(ii)(A): an owner build from 2015 that is not a s 13(7) relocation.
#ASSERT (`Is my transaction an eligible transaction` `the building of a home by an owner builder` (DATE_FROM_DMY 10 1 2026) (DATE_FROM_DMY 1 7 2026) TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE 45000 0 0 TRUE) EQUALS `an eligible transaction (s 13(1))`
-- s 18(1): the lesser of the $45,000 actually paid and $50,000 (s 18(3E)).
#ASSERT (`How much is my first home owner grant` `the building of a home by an owner builder` (DATE_FROM_DMY 10 1 2026) (DATE_FROM_DMY 1 7 2026) FALSE FALSE FALSE FALSE FALSE 45000 TRUE) EQUALS (`the grant amount is` 45000)
-- Ready for occupation 30 Jun 2027 (s 13(6)(c)); asked 1 Jul 2027.
#ASSERT (`Is the first home owner grant payable to me` (DATE_FROM_DMY 1 7 2027) `the building of a home by an owner builder` (DATE_FROM_DMY 10 1 2026) (DATE_FROM_DMY 1 7 2026) TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE 45000 0 0 TRUE (DATE_FROM_DMY 20 5 2026) TRUE (DATE_FROM_DMY 20 5 2026) (DATE_FROM_DMY 30 6 2027) 40 FALSE `an Australian citizen` `no grant was paid on an earlier application` FALSE FALSE `never held a relevant interest in residential property in Australia` TRUE FALSE `no spouse or de facto partner` FALSE FALSE 0 FALSE `none of these` `no grant was paid on an earlier application` FALSE FALSE `never held a relevant interest in residential property in Australia` FALSE FALSE TRUE FALSE) EQUALS (`payable` 45000)
-- s 14(5)(b): 12 months after 30 Jun 2027.
#ASSERT (`By what date must I apply for the grant` `the building of a home by an owner builder` (DATE_FROM_DMY 20 5 2026) TRUE (DATE_FROM_DMY 20 5 2026) (DATE_FROM_DMY 30 6 2027)) EQUALS (DATE_FROM_DMY 30 6 2028)

-- =====================================================================================================================
-- CASE 5. Lee buys a transportable home to put on his block (s 13(7)). HYPOTHETICAL: 35, citizen, single.
-- Contract 1 Mar 2026, $160,000; it was used as workers accommodation at a mine site.
-- =====================================================================================================================
-- s 4A(3): a place of residence includes workers accommodation; it has been occupied as one.
#ASSERT (`Is my home a new home` `the purchase of a building to be placed on land in which the purchaser has a relevant interest` TRUE FALSE FALSE FALSE) EQUALS FALSE
-- s 13(1)(c)(ii)(B): a s 13(7) transaction from 1 Jan 2015 must be a new home.
#ASSERT (`Is my transaction an eligible transaction` `the purchase of a building to be placed on land in which the purchaser has a relevant interest` (DATE_FROM_DMY 1 3 2026) (DATE_FROM_DMY 1 3 2026) TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE 160000 0 0 TRUE) EQUALS (`not an eligible transaction` `s 13(1)(c)(ii)(B): a building bought to be moved onto the land, from 1 January 2015, that is not a new home`)
-- A brand-new transportable, never occupied, is eligible.
#ASSERT (`Is my transaction an eligible transaction` `the purchase of a building to be placed on land in which the purchaser has a relevant interest` (DATE_FROM_DMY 1 3 2026) (DATE_FROM_DMY 1 3 2026) TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE 160000 0 0 TRUE) EQUALS `an eligible transaction (s 13(1))`
-- s 18(3E): $50,000, less than $160,000.
#ASSERT (`How much is my first home owner grant` `the purchase of a building to be placed on land in which the purchaser has a relevant interest` (DATE_FROM_DMY 1 3 2026) (DATE_FROM_DMY 1 3 2026) FALSE FALSE FALSE FALSE FALSE 160000 TRUE) EQUALS (`the grant amount is` 50000)
-- s 13(5)(c), (7)(b): the date of the contract to purchase the building.
#ASSERT (`What is the commencement date of my transaction` `the purchase of a building to be placed on land in which the purchaser has a relevant interest` (DATE_FROM_DMY 1 3 2026) (DATE_FROM_DMY 1 3 2026)) EQUALS (DATE_FROM_DMY 1 3 2026)

-- =====================================================================================================================
-- CASE 6. Priya's husband owned a home (s 6, s 11(3)). HYPOTHETICAL: 30, citizen, married to Raj on the commencement
-- date (1 Jul 2026); Raj owned and lived in a Perth unit from 2018 to 2022. Priya buys a new home alone.
-- =====================================================================================================================
-- s 6: married, and the Commissioner is not satisfied they live apart for good.
#ASSERT (`Does my spouse or de facto partner count for the grant` `married` FALSE) EQUALS TRUE
-- s 11(3): the applicant's spouse held a relevant interest in residential property used as his residence.
#ASSERT (`Am I eligible for the first home owner grant` `a contract for the purchase of a home` (DATE_FROM_DMY 1 7 2026) (DATE_FROM_DMY 1 7 2026) 30 FALSE `an Australian citizen` `no grant was paid on an earlier application` FALSE FALSE `never held a relevant interest in residential property in Australia` TRUE FALSE `married` FALSE FALSE 0 FALSE `none of these` `no grant was paid on an earlier application` FALSE FALSE `held one from 1 July 2000, before the commencement date, in property used as a residence of the person or their spouse or de facto partner` FALSE FALSE FALSE) EQUALS (`not eligible` `s 11(3): an applicant or their spouse or de facto partner has held a relevant interest in residential property used as their residence`)
-- So the grant is not payable (s 7(1)(a)).
#ASSERT (`Is the first home owner grant payable to me` (DATE_FROM_DMY 1 10 2026) `a contract for the purchase of a home` (DATE_FROM_DMY 1 7 2026) (DATE_FROM_DMY 1 7 2026) TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE 520000 0 0 TRUE (DATE_FROM_DMY 1 9 2026) TRUE (DATE_FROM_DMY 1 9 2026) (DATE_FROM_DMY 20 5 2026) 30 FALSE `an Australian citizen` `no grant was paid on an earlier application` FALSE FALSE `never held a relevant interest in residential property in Australia` TRUE FALSE `married` FALSE FALSE 0 FALSE `none of these` `no grant was paid on an earlier application` FALSE FALSE `held one from 1 July 2000, before the commencement date, in property used as a residence of the person or their spouse or de facto partner` FALSE FALSE TRUE FALSE) EQUALS (`not payable: an applicant does not meet the eligibility criteria` `s 11(3): an applicant or their spouse or de facto partner has held a relevant interest in residential property used as their residence`)
-- s 6(1): separated with no intention of resuming, and the Commissioner is satisfied: not her spouse.
#ASSERT (`Does my spouse or de facto partner count for the grant` `married` TRUE) EQUALS FALSE
-- Then Raj's home does not count against her.
#ASSERT (`Am I eligible for the first home owner grant` `a contract for the purchase of a home` (DATE_FROM_DMY 1 7 2026) (DATE_FROM_DMY 1 7 2026) 30 FALSE `an Australian citizen` `no grant was paid on an earlier application` FALSE FALSE `never held a relevant interest in residential property in Australia` TRUE FALSE `married` TRUE FALSE 0 FALSE `none of these` `no grant was paid on an earlier application` FALSE FALSE `held one from 1 July 2000, before the commencement date, in property used as a residence of the person or their spouse or de facto partner` FALSE FALSE FALSE) EQUALS `eligible: every applicant meets the eligibility criteria (ss 7(1)(a), 8-12A)`
-- s 6(1) is about a married person only; a de facto partner still counts.
#ASSERT (`Does my spouse or de facto partner count for the grant` `a de facto partner` TRUE) EQUALS TRUE

-- =====================================================================================================================
-- CASE 7. Earlier grants and discounts (ss 10, 12A). HYPOTHETICAL variations on Mia.
-- =====================================================================================================================
-- s 10(2): the earlier grant was paid back with the penalty and interest.
#ASSERT (`Am I eligible for the first home owner grant` `a contract for the purchase of a home` (DATE_FROM_DMY 15 3 2026) (DATE_FROM_DMY 15 3 2026) 29 FALSE `an Australian citizen` `a grant was paid on an earlier application and was paid back with any penalty and interest` FALSE FALSE `never held a relevant interest in residential property in Australia` TRUE FALSE `no spouse or de facto partner` FALSE FALSE 0 FALSE `none of these` `no grant was paid on an earlier application` FALSE FALSE `never held a relevant interest in residential property in Australia` FALSE FALSE FALSE) EQUALS `eligible: every applicant meets the eligibility criteria (ss 7(1)(a), 8-12A)`
-- s 10(1): an earlier grant was paid and not paid back.
#ASSERT (`Am I eligible for the first home owner grant` `a contract for the purchase of a home` (DATE_FROM_DMY 15 3 2026) (DATE_FROM_DMY 15 3 2026) 29 FALSE `an Australian citizen` `a grant was paid on an earlier application and has not been paid back with any penalty and interest` FALSE FALSE `never held a relevant interest in residential property in Australia` TRUE FALSE `no spouse or de facto partner` FALSE FALSE 0 FALSE `none of these` `no grant was paid on an earlier application` FALSE FALSE `never held a relevant interest in residential property in Australia` FALSE FALSE FALSE) EQUALS (`not eligible` `s 10(1), (2): a grant was paid to an applicant or their spouse or de facto partner on an earlier application and not paid back with any penalty and interest`)
-- s 12A(1), (2): an earlier grant on a transaction over the threshold bars her even if repaid.
#ASSERT (`Am I eligible for the first home owner grant` `a contract for the purchase of a home` (DATE_FROM_DMY 15 3 2026) (DATE_FROM_DMY 15 3 2026) 29 FALSE `an Australian citizen` `a grant was paid on an earlier application for a home used as a residence, on a transaction over the threshold amount` FALSE FALSE `never held a relevant interest in residential property in Australia` TRUE FALSE `no spouse or de facto partner` FALSE FALSE 0 FALSE `none of these` `no grant was paid on an earlier application` FALSE FALSE `never held a relevant interest in residential property in Australia` FALSE FALSE FALSE) EQUALS (`not eligible` `s 12A: an earlier grant was paid for a home used as a residence on a transaction over the threshold amount`)
-- s 10(3)(a): she could have applied on an earlier transaction and did not.
#ASSERT (`Am I eligible for the first home owner grant` `a contract for the purchase of a home` (DATE_FROM_DMY 15 3 2026) (DATE_FROM_DMY 15 3 2026) 29 FALSE `an Australian citizen` `no grant was paid on an earlier application` TRUE FALSE `never held a relevant interest in residential property in Australia` TRUE FALSE `no spouse or de facto partner` FALSE FALSE 0 FALSE `none of these` `no grant was paid on an earlier application` FALSE FALSE `never held a relevant interest in residential property in Australia` FALSE FALSE FALSE) EQUALS (`not eligible` `s 10(3): an applicant or their spouse or de facto partner could have successfully applied for a grant on an earlier transaction`)
-- s 10(4): the Stamp Duty Act s 89AA discount, with the duty forgone unpaid.
#ASSERT (`Am I eligible for the first home owner grant` `a contract for the purchase of a home` (DATE_FROM_DMY 15 3 2026) (DATE_FROM_DMY 15 3 2026) 29 FALSE `an Australian citizen` `no grant was paid on an earlier application` FALSE TRUE `never held a relevant interest in residential property in Australia` TRUE FALSE `no spouse or de facto partner` FALSE FALSE 0 FALSE `none of these` `no grant was paid on an earlier application` FALSE FALSE `never held a relevant interest in residential property in Australia` FALSE FALSE FALSE) EQUALS (`not eligible` `s 10(4): an applicant or their spouse or de facto partner received the first home owner discount and the duty forgone has not been paid`)
-- s 10(1): her de facto partner's unrepaid grant counts against her, though he is not applying.
#ASSERT (`Am I eligible for the first home owner grant` `a contract for the purchase of a home` (DATE_FROM_DMY 15 3 2026) (DATE_FROM_DMY 15 3 2026) 29 FALSE `an Australian citizen` `no grant was paid on an earlier application` FALSE FALSE `never held a relevant interest in residential property in Australia` TRUE FALSE `a de facto partner` FALSE FALSE 0 FALSE `none of these` `a grant was paid on an earlier application and has not been paid back with any penalty and interest` FALSE FALSE `never held a relevant interest in residential property in Australia` FALSE FALSE FALSE) EQUALS (`not eligible` `s 10(1), (2): a grant was paid to an applicant or their spouse or de facto partner on an earlier application and not paid back with any penalty and interest`)

