IMPORT prelude
IMPORT `fhog-core`
IMPORT `fhog-seat`

-- Cases for the first home buyer's seat (fhog-seat.l4) and the regulative rules of the core (fhog-core.l4).
-- Every expected value was worked by hand from the deposited text (REPF039, as in force at 1 July 2026; Regulations
-- REPF039R1), never copied from the encoding's output; the working is in the comment above each assertion. No scenario
-- life raised this Act: the buyers are the encoder's, HYPOTHETICAL throughout.
-- Built by the scratchpad generator gen_nt_fhog_cases.py (171 assertions, 6 #TRACEs with an expect line).
-- Dates are DATE_FROM_DMY day month year.

-- =====================================================================================================================
-- CASE 1. Mia buys a new apartment off the plan. HYPOTHETICAL: 29, Australian citizen, single, has only rented.
-- Contract 15 Mar 2026, $520,000 including GST; settlement 20 May 2026; moves in 1 Jun 2026.
-- =====================================================================================================================
-- s 6: no spouse or de facto partner.
#ASSERT (`Does my spouse or de facto partner count for the grant` `no spouse or de facto partner` FALSE) EQUALS FALSE
-- s 8: 29 >= 18. s 9: a citizen. ss 10, 11, 12A: no earlier grant or home. s 12: will live there.
#ASSERT (`Am I eligible for the first home owner grant` `a contract for the purchase of a home` (DATE_FROM_DMY 15 3 2026) (DATE_FROM_DMY 15 3 2026) 29 FALSE `an Australian citizen` `no grant was paid on an earlier application` FALSE FALSE `never held a relevant interest in residential property in Australia` TRUE FALSE `no spouse or de facto partner` FALSE FALSE 0 FALSE `none of these` `no grant was paid on an earlier application` FALSE FALSE `never held a relevant interest in residential property in Australia` FALSE FALSE FALSE) EQUALS `eligible: every applicant meets the eligibility criteria (ss 7(1)(a), 8-12A)`
-- s 4A(1)(a): never occupied or sold as a place of residence.
#ASSERT (`Is my home a new home` `a contract for the purchase of a home` FALSE FALSE FALSE FALSE) EQUALS TRUE
-- s 13(5)(a): the date the contract is made.
#ASSERT (`What is the commencement date of my transaction` `a contract for the purchase of a home` (DATE_FROM_DMY 15 3 2026) (DATE_FROM_DMY 15 3 2026)) EQUALS (DATE_FROM_DMY 15 3 2026)
-- s 13(6)(a): entitled to possession and registration steps taken, both 20 May 2026.
#ASSERT (`When is my transaction completed` `a contract for the purchase of a home` (DATE_FROM_DMY 20 5 2026) TRUE (DATE_FROM_DMY 20 5 2026) (DATE_FROM_DMY 20 5 2026)) EQUALS (DATE_FROM_DMY 20 5 2026)
-- s 13(1)(a)(iv): a contract from 1 Oct 2025, for a new home. Commencement after 2015: not threshold-relevant (s 13AA(4)).
#ASSERT (`Is my transaction an eligible transaction` `a contract for the purchase of a home` (DATE_FROM_DMY 15 3 2026) (DATE_FROM_DMY 15 3 2026) TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE 520000 0 0 TRUE) EQUALS `an eligible transaction (s 13(1))`
-- s 18(3E): commencement 15 Mar 2026 is on or after 1 Oct 2025 and before 1 Oct 2027: $50,000; s 18(1): lesser of $520,000 and $50,000.
#ASSERT (`How much is my first home owner grant` `a contract for the purchase of a home` (DATE_FROM_DMY 15 3 2026) (DATE_FROM_DMY 15 3 2026) FALSE FALSE FALSE FALSE FALSE 520000 TRUE) EQUALS (`the grant amount is` 50000)
-- s 7(1): criteria met, eligible transaction, completed 20 May 2026 before the day asked (1 Jun 2026).
#ASSERT (`Is the first home owner grant payable to me` (DATE_FROM_DMY 1 6 2026) `a contract for the purchase of a home` (DATE_FROM_DMY 15 3 2026) (DATE_FROM_DMY 15 3 2026) TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE 520000 0 0 TRUE (DATE_FROM_DMY 20 5 2026) TRUE (DATE_FROM_DMY 20 5 2026) (DATE_FROM_DMY 20 5 2026) 29 FALSE `an Australian citizen` `no grant was paid on an earlier application` FALSE FALSE `never held a relevant interest in residential property in Australia` TRUE FALSE `no spouse or de facto partner` FALSE FALSE 0 FALSE `none of these` `no grant was paid on an earlier application` FALSE FALSE `never held a relevant interest in residential property in Australia` FALSE FALSE TRUE FALSE) EQUALS (`payable` 50000)
-- Asked on 1 May 2026, before completion: s 7(1)(b)(ii) is not met; s 17(2) lets the Commissioner pay early for special reasons.
#ASSERT (`Is the first home owner grant payable to me` (DATE_FROM_DMY 1 5 2026) `a contract for the purchase of a home` (DATE_FROM_DMY 15 3 2026) (DATE_FROM_DMY 15 3 2026) TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE 520000 0 0 TRUE (DATE_FROM_DMY 20 5 2026) TRUE (DATE_FROM_DMY 20 5 2026) (DATE_FROM_DMY 20 5 2026) 29 FALSE `an Australian citizen` `no grant was paid on an earlier application` FALSE FALSE `never held a relevant interest in residential property in Australia` TRUE FALSE `no spouse or de facto partner` FALSE FALSE 0 FALSE `none of these` `no grant was paid on an earlier application` FALSE FALSE `never held a relevant interest in residential property in Australia` FALSE FALSE TRUE FALSE) EQUALS (`not payable until the transaction is completed, unless the Commissioner pays it earlier (ss 7(1)(b)(ii), 17(2), (2A))` 50000)
-- s 15(1): all interested persons must be applicants; one who will own part of the home has not joined.
#ASSERT (`Is the first home owner grant payable to me` (DATE_FROM_DMY 1 6 2026) `a contract for the purchase of a home` (DATE_FROM_DMY 15 3 2026) (DATE_FROM_DMY 15 3 2026) TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE 520000 0 0 TRUE (DATE_FROM_DMY 20 5 2026) TRUE (DATE_FROM_DMY 20 5 2026) (DATE_FROM_DMY 20 5 2026) 29 FALSE `an Australian citizen` `no grant was paid on an earlier application` FALSE FALSE `never held a relevant interest in residential property in Australia` TRUE FALSE `no spouse or de facto partner` FALSE FALSE 0 FALSE `none of these` `no grant was paid on an earlier application` FALSE FALSE `never held a relevant interest in residential property in Australia` FALSE FALSE FALSE FALSE) EQUALS `not payable: an owner of the home has not joined in the application (s 15)`
-- s 14(5)(b): 12 months after completion on 20 May 2026.
#ASSERT (`By what date must I apply for the grant` `a contract for the purchase of a home` (DATE_FROM_DMY 20 5 2026) TRUE (DATE_FROM_DMY 20 5 2026) (DATE_FROM_DMY 20 5 2026)) EQUALS (DATE_FROM_DMY 20 5 2027)
-- s 14(5)(a): the period starts on the commencement date, 15 Mar 2026.
#ASSERT (`Can I apply for the grant on this day` (DATE_FROM_DMY 15 3 2026) `a contract for the purchase of a home` (DATE_FROM_DMY 15 3 2026) (DATE_FROM_DMY 15 3 2026) (DATE_FROM_DMY 20 5 2026) TRUE (DATE_FROM_DMY 20 5 2026) (DATE_FROM_DMY 20 5 2026)) EQUALS `within the application period: the application may be made (s 14(5))`
-- 10 Mar 2026 is before the contract: only with the Commissioner's discretion (s 14(6)).
#ASSERT (`Can I apply for the grant on this day` (DATE_FROM_DMY 10 3 2026) `a contract for the purchase of a home` (DATE_FROM_DMY 15 3 2026) (DATE_FROM_DMY 15 3 2026) (DATE_FROM_DMY 20 5 2026) TRUE (DATE_FROM_DMY 20 5 2026) (DATE_FROM_DMY 20 5 2026)) EQUALS `outside the application period: it may be made only if the Commissioner allows it (s 14(6))`
-- 20 May 2027 is the last day of the period.
#ASSERT (`Can I apply for the grant on this day` (DATE_FROM_DMY 20 5 2027) `a contract for the purchase of a home` (DATE_FROM_DMY 15 3 2026) (DATE_FROM_DMY 15 3 2026) (DATE_FROM_DMY 20 5 2026) TRUE (DATE_FROM_DMY 20 5 2026) (DATE_FROM_DMY 20 5 2026)) EQUALS `within the application period: the application may be made (s 14(5))`
-- 21 May 2027 is after it.
#ASSERT (`Can I apply for the grant on this day` (DATE_FROM_DMY 21 5 2027) `a contract for the purchase of a home` (DATE_FROM_DMY 15 3 2026) (DATE_FROM_DMY 15 3 2026) (DATE_FROM_DMY 20 5 2026) TRUE (DATE_FROM_DMY 20 5 2026) (DATE_FROM_DMY 20 5 2026)) EQUALS `outside the application period: it may be made only if the Commissioner allows it (s 14(6))`
-- s 12(2)(a): within 12 months after completion (20 May 2026).
#ASSERT (`By what date must I move into the home` `a contract for the purchase of a home` (DATE_FROM_DMY 20 5 2026) TRUE (DATE_FROM_DMY 20 5 2026) (DATE_FROM_DMY 20 5 2026) FALSE (DATE_FROM_DMY 1 1 2030)) EQUALS (DATE_FROM_DMY 20 5 2027)
-- s 12(2)(b)(i): commencement 15 Mar 2026 is on or after 1 Oct 2024 and before 1 Oct 2027: 12 months.
#ASSERT (`For how many months must I live in the home` `a contract for the purchase of a home` (DATE_FROM_DMY 15 3 2026) (DATE_FROM_DMY 15 3 2026) FALSE 0) EQUALS 12
-- 12 continuous months from 1 Jun 2026.
#ASSERT (`Until what date must I keep living in the home` `a contract for the purchase of a home` (DATE_FROM_DMY 15 3 2026) (DATE_FROM_DMY 15 3 2026) (DATE_FROM_DMY 1 6 2026) FALSE 0) EQUALS (DATE_FROM_DMY 1 6 2027)

-- =====================================================================================================================
-- Completion, other shapes (s 13(6)).
-- =====================================================================================================================
-- s 13(6)(a)(i) and (ii) must both have happened: possession 18 May, registration steps 20 May: completed 20 May.
#ASSERT (`When is my transaction completed` `a contract for the purchase of a home` (DATE_FROM_DMY 18 5 2026) TRUE (DATE_FROM_DMY 20 5 2026) (DATE_FROM_DMY 20 5 2026)) EQUALS (DATE_FROM_DMY 20 5 2026)
-- Registration steps 20 May, possession 22 May: completed 22 May.
#ASSERT (`When is my transaction completed` `a contract for the purchase of a home` (DATE_FROM_DMY 22 5 2026) TRUE (DATE_FROM_DMY 20 5 2026) (DATE_FROM_DMY 20 5 2026)) EQUALS (DATE_FROM_DMY 22 5 2026)
-- No registered title to obtain: s 13(6)(a)(i) alone, 18 May.
#ASSERT (`When is my transaction completed` `a contract for the purchase of a home` (DATE_FROM_DMY 18 5 2026) FALSE (DATE_FROM_DMY 20 6 2026) (DATE_FROM_DMY 20 5 2026)) EQUALS (DATE_FROM_DMY 18 5 2026)
-- s 13(6)(b): a building contract is completed when the building is ready for occupation, 1 Aug 2027.
#ASSERT (`When is my transaction completed` `a comprehensive home building contract` (DATE_FROM_DMY 20 5 2026) TRUE (DATE_FROM_DMY 20 5 2026) (DATE_FROM_DMY 1 8 2027)) EQUALS (DATE_FROM_DMY 1 8 2027)

