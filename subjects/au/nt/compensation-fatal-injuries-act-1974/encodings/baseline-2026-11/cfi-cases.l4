-- 181 days in the 6 months after 10 January 2026.
#ASSERT NOT (`s 13 -- a member of the family may commence on this day` 181 0)
#ASSERT NOT (`s 13 -- a member of the family may commence on this day` 181 180)
#ASSERT NOT (`s 13 -- a member of the family may commence on this day` 181 181)
#ASSERT `s 13 -- a member of the family may commence on this day` 181 182
#ASSERT `s 13 -- a member of the family may commence on this day` 181 400

§ `s 13 -- the first day I may bring the action myself`

#ASSERT `s 13 -- the first day I may bring the action myself` `10 Jan 2026` EQUALS `11 Jul 2026`
#ASSERT `s 13 -- the first day I may bring the action myself` `31 Aug 2025` EQUALS `1 Mar 2026`
#ASSERT `s 13 -- the first day I may bring the action myself` `31 Aug 2023` EQUALS `1 Mar 2024`
#ASSERT `s 13 -- the first day I may bring the action myself` `30 Dec 2025` EQUALS `1 Jul 2026`

§ `s 8 and s 13 -- who brings the action, and can I bring it myself`

-- A widow; death 10 January 2026; no action yet. On the last day of the 6 months (edge): not yet.
#ASSERT `s 8 and s 13 -- who brings the action, and can I bring it myself` `10 Jan 2026` FALSE TRUE `spouse` TRUE FALSE `10 Jul 2026` EQUALS `NOT YET`
-- The next day (edge): she may bring it herself.
#ASSERT `s 8 and s 13 -- who brings the action, and can I bring it myself` `10 Jan 2026` FALSE TRUE `spouse` TRUE FALSE `11 Jul 2026` EQUALS `I MAY BRING IT`
-- Months later.
#ASSERT `s 8 and s 13 -- who brings the action, and can I bring it myself` `10 Jan 2026` FALSE TRUE `child, including an adopted child` TRUE FALSE `7 Nov 2026` EQUALS `I MAY BRING IT`
-- The day of the death.
#ASSERT `s 8 and s 13 -- who brings the action, and can I bring it myself` `10 Jan 2026` FALSE TRUE `spouse` TRUE FALSE `10 Jan 2026` EQUALS `NOT YET`
-- A "today" before the death is counted as day 0.
#ASSERT `s 8 and s 13 -- who brings the action, and can I bring it myself` `10 Jan 2026` FALSE TRUE `spouse` TRUE FALSE `1 Jan 2026` EQUALS `NOT YET`
-- 31 August death: the 6 months end on 28 February; 1 March is the first day.
#ASSERT `s 8 and s 13 -- who brings the action, and can I bring it myself` `31 Aug 2025` FALSE TRUE `parent, including an adoptive parent` TRUE FALSE `28 Feb 2026` EQUALS `NOT YET`
#ASSERT `s 8 and s 13 -- who brings the action, and can I bring it myself` `31 Aug 2025` FALSE TRUE `parent, including an adoptive parent` TRUE FALSE `1 Mar 2026` EQUALS `I MAY BRING IT`
-- An action already brought against this wrongdoer (by the personal representative or anyone): no second action.
#ASSERT `s 8 and s 13 -- who brings the action, and can I bring it myself` `10 Jan 2026` FALSE TRUE `spouse` TRUE TRUE `7 Nov 2026` EQUALS `ONE ACTION ONLY`
#ASSERT `s 8 and s 13 -- who brings the action, and can I bring it myself` `10 Jan 2026` FALSE TRUE `spouse` TRUE TRUE `1 Jun 2026` EQUALS `ONE ACTION ONLY`
-- A former spouse who sustained no damage.
#ASSERT `s 8 and s 13 -- who brings the action, and can I bring it myself` `10 Jan 2026` FALSE TRUE `former spouse` FALSE FALSE `7 Nov 2026` EQUALS `NO DAMAGE`
-- A cousin: not named (NOTHING-kind); checked before damage.
#ASSERT `s 8 and s 13 -- who brings the action, and can I bring it myself` `10 Jan 2026` FALSE TRUE `other relationship` TRUE FALSE `7 Nov 2026` EQUALS `NOT NAMED`
#ASSERT `s 8 and s 13 -- who brings the action, and can I bring it myself` `10 Jan 2026` FALSE TRUE `other relationship` FALSE TRUE `7 Nov 2026` EQUALS `NOT NAMED`
-- A motor accident death that the Motor Accidents (Compensation) Act takes out: s 5 first.
#ASSERT `s 8 and s 13 -- who brings the action, and can I bring it myself` `10 Jan 2026` TRUE FALSE `spouse` TRUE FALSE `7 Nov 2026` EQUALS `S8 NOT UNDER THIS ACT`
#ASSERT `s 8 and s 13 -- who brings the action, and can I bring it myself` `22 Sep 1974` FALSE TRUE `spouse` TRUE FALSE `7 Nov 2026` EQUALS `S8 NOT UNDER THIS ACT`

§ `s 10 -- what can the damages include`

-- Nothing but the general head and solatium (both always open).
#ASSERT `s 10 -- what can the damages include` FALSE FALSE FALSE FALSE FALSE EQUALS LIST `H LOSS`, `H SOLATIUM`
-- Every condition met: all eight heads, in the order of s 10.
#ASSERT `s 10 -- what can the damages include` TRUE TRUE TRUE TRUE TRUE EQUALS LIST `H LOSS`, `H BURIAL`, `H MEDICAL`, `H CONSORTIUM`, `H HOUSEHOLD`, `H CARER`, `H GUIDANCE`, `H SOLATIUM`
-- A surviving partner only.
#ASSERT `s 10 -- what can the damages include` FALSE FALSE TRUE FALSE FALSE EQUALS LIST `H LOSS`, `H CONSORTIUM`, `H SOLATIUM`
-- Funeral paid; the deceased kept the house; an infant child.
#ASSERT `s 10 -- what can the damages include` TRUE FALSE FALSE TRUE TRUE EQUALS LIST `H LOSS`, `H BURIAL`, `H HOUSEHOLD`, `H CARER`, `H GUIDANCE`, `H SOLATIUM`

§ `s 10(3)(e) -- until when can carer expenses for my child be claimed`

-- A child aged 11 at the death.
#ASSERT `s 10(3)(e) -- until when can carer expenses for my child be claimed` `1 Jun 2026` `15 Mar 2015` EQUALS `until the day the child attains 18 (s 10(3)(e)(i))` `15 Mar 2033`
-- A child who turns 18 on the day of the death (edge): no longer an infant.
#ASSERT `s 10(3)(e) -- until when can carer expenses for my child be claimed` `1 Jun 2026` `1 Jun 2008` EQUALS `NOT AN INFANT`
-- A child who turns 18 the day after the death (edge): an infant at the death.
#ASSERT `s 10(3)(e) -- until when can carer expenses for my child be claimed` `1 Jun 2026` `2 Jun 2008` EQUALS `until the day the child attains 18 (s 10(3)(e)(i))` `2 Jun 2026`
-- A child born alive after the death (s 4(3)(b)).
#ASSERT `s 10(3)(e) -- until when can carer expenses for my child be claimed` `1 Jun 2026` `1 Oct 2026` EQUALS `until the day the child attains 18 (s 10(3)(e)(i))` `1 Oct 2044`
-- Born on 29 February 2008: 18 on 28 February 2026, before the death.
#ASSERT `s 10(3)(e) -- until when can carer expenses for my child be claimed` `1 Jun 2026` `29 Feb 2008` EQUALS `NOT AN INFANT`
-- Born on 29 February 2012: 18 on 28 February 2030.
#ASSERT `s 10(3)(e) -- until when can carer expenses for my child be claimed` `1 Jun 2026` `29 Feb 2012` EQUALS `until the day the child attains 18 (s 10(3)(e)(i))` `28 Feb 2030`

§ `s 10(4) and (5) -- is my award reduced by it`

-- Every paragraph of s 10(4): no reduction; the dates are not used.
#ASSERT `s 10(4) and (5) -- is my award reduced by it` `(a) a sum paid or payable under a contract of insurance on the death of, or personal injury to, the deceased` `10 Jan 2026` `7 Nov 2026` EQUALS `NO REDUCTION`
#ASSERT `s 10(4) and (5) -- is my award reduced by it` `(b) a sum from a superannuation, provident or like fund, or a benefit from a friendly society, benefit society, lodge or trade union` `10 Jan 2026` `7 Nov 2026` EQUALS `NO REDUCTION`
#ASSERT `s 10(4) and (5) -- is my award reduced by it` `(c)(i) a payment instead of furlough or long service leave, paid by a government or person because of the death or injury` `10 Jan 2026` `7 Nov 2026` EQUALS `NO REDUCTION`
#ASSERT `s 10(4) and (5) -- is my award reduced by it` `(c)(ii) a pension, social service benefit or repatriation benefit, paid by a government or person because of the death or injury` `10 Jan 2026` `7 Nov 2026` EQUALS `NO REDUCTION`
#ASSERT `s 10(4) and (5) -- is my award reduced by it` `(d) a gratuity paid or payable because of the death` `10 Jan 2026` `7 Nov 2026` EQUALS `NO REDUCTION`
#ASSERT `s 10(4) and (5) -- is my award reduced by it` `(e) a sum for acquiring, because of the death, a home I have lived in (or an interest in it) or its household contents` `10 Jan 2026` `7 Nov 2026` EQUALS `NO REDUCTION`
#ASSERT `s 10(4) and (5) -- is my award reduced by it` `(f) life insurance premiums on the deceased that will no longer have to be paid` `10 Jan 2026` `7 Nov 2026` EQUALS `NO REDUCTION`
#ASSERT `s 10(4) and (5) -- is my award reduced by it` `(g) any other gain or benefit to the estate or to a member of the family, because of the death (for example an inheritance)` `10 Jan 2026` `7 Nov 2026` EQUALS `NO REDUCTION`
#ASSERT `s 10(4) and (5) -- is my award reduced by it` `(h) the remarriage or new de facto relationship of the surviving spouse or partner (or former spouse or partner), or the prospects of it` `10 Jan 2026` `7 Nov 2026` EQUALS `NO REDUCTION`
-- The deceased's own settlement: on the last day of the 6 months after the wrongful act (edge), and the day after.
#ASSERT `s 10(4) and (5) -- is my award reduced by it` `the deceased's settlement` `10 Jan 2026` `10 Jul 2026` EQUALS `TAKEN INTO ACCOUNT`
#ASSERT `s 10(4) and (5) -- is my award reduced by it` `the deceased's settlement` `10 Jan 2026` `11 Jul 2026` EQUALS `ACT SILENT ON LATE SETTLEMENT`
-- Soon after the wrongful act.
#ASSERT `s 10(4) and (5) -- is my award reduced by it` `the deceased's settlement` `10 Jan 2026` `1 Jun 2026` EQUALS `TAKEN INTO ACCOUNT`
-- 31 August wrongful act: the 6 months end on 28 February.
#ASSERT `s 10(4) and (5) -- is my award reduced by it` `the deceased's settlement` `31 Aug 2025` `28 Feb 2026` EQUALS `TAKEN INTO ACCOUNT`
#ASSERT `s 10(4) and (5) -- is my award reduced by it` `the deceased's settlement` `31 Aug 2025` `1 Mar 2026` EQUALS `ACT SILENT ON LATE SETTLEMENT`

§ `s 10(2) and s 11 -- how much do I receive`

-- $500,000 assessed; 20% for the deceased's own fault leaves $400,000; less $40,000 unrecovered costs leaves $360,000;
-- a half share is $180,000.
#ASSERT `s 10(2) and s 11 -- how much do I receive` 500000 20 40000 50 EQUALS 180000
-- No fault, no costs, the whole share.
#ASSERT `s 10(2) and s 11 -- how much do I receive` 500000 0 0 100 EQUALS 500000
-- A quarter share, no fault, $20,000 costs: (500,000 - 20,000) / 4 = 120,000.
#ASSERT `s 10(2) and s 11 -- how much do I receive` 500000 0 20000 25 EQUALS 120000
-- Unrecovered costs equal to the damages recovered (edge): nothing to divide.
#ASSERT `s 10(2) and s 11 -- how much do I receive` 500000 20 400000 50 EQUALS 0
-- Costs above the damages (fork F6): nothing, not a negative share.
#ASSERT `s 10(2) and s 11 -- how much do I receive` 500000 20 450000 50 EQUALS 0
-- One dollar left (edge): half of it.
#ASSERT `s 10(2) and s 11 -- how much do I receive` 500000 20 399999 50 EQUALS 0.5
-- The deceased wholly to blame: nothing.
#ASSERT `s 10(2) and s 11 -- how much do I receive` 500000 100 0 50 EQUALS 0

