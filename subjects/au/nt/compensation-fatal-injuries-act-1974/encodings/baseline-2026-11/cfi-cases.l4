#ASSERT `s 12 -- can I be paid the money in court` TRUE FALSE EQUALS `ONLY BY ORDER`
#ASSERT `s 12 -- can I be paid the money in court` FALSE FALSE EQUALS `NOTHING PAID IN`
#ASSERT `s 12 -- can I be paid the money in court` FALSE TRUE EQUALS `NOTHING PAID IN`

