#ASSERT `s 15 -- if my name was left off the action` TRUE FALSE FALSE EQUALS `COURT NOT SATISFIED`
#ASSERT `s 15 -- if my name was left off the action` FALSE FALSE TRUE EQUALS `NO ACTION YET`
