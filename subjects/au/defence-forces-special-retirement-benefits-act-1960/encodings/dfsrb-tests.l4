IMPORT prelude
IMPORT daydate
IMPORT `dfsrb-rules`

-- Defence Forces Special Retirement Benefits Act 1960 (Cth) — the encoder's
-- tests.

§ `Tests`

`notadd` MEANS `not contributing on retirement for additional benefits`
`adding` MEANS `contributing on retirement for additional benefits`

-- A soldier discharged on 1 March 1961, born 1 June 1920.
GIVEN y IS A NUMBER, k IS A `Section 10 contributor`, paidon IS A MAYBE DATE, amt IS A NUMBER
GIVETH A `Soldier case`
`a soldier with` y `years` k `paying on` paidon `the sum` amt MEANS
    `Soldier case` OF TRUE, FALSE, Date 1 1 1963, FALSE, Date 1 6 1920, TRUE, Date 1 3 1961, TRUE, FALSE,
                      y, TRUE, `category 103`, 1, FALSE, 500, 200, 300, k, 350, 100, Date 15 3 1961, paidon, amt

`nopay` MEANS `a soldier with` 3 `years` `notadd` `paying on` NOTHING `the sum` 0

-- s 4
#ASSERT `the Act applies to` `nopay`
-- discharged after 30 April 1961 (not Ordnance Corps)
#ASSERT NOT (`the Act applies to` (`Soldier case` OF TRUE, FALSE, Date 1 1 1963, FALSE, Date 1 6 1920, TRUE, Date 1 5 1961, TRUE, FALSE, 3, TRUE, `category 103`, 1, FALSE, 500, 200, 300, `notadd`, 350, 100, Date 15 3 1961, NOTHING, 0))
-- Ordnance Corps: 9 months
#ASSERT `the Act applies to` (`Soldier case` OF TRUE, TRUE, Date 1 1 1963, FALSE, Date 1 6 1920, TRUE, Date 1 5 1961, TRUE, FALSE, 3, TRUE, `category 103`, 1, FALSE, 500, 200, 300, `notadd`, 350, 100, Date 15 3 1961, NOTHING, 0)
-- 55th birthday during the period
#ASSERT NOT (`the Act applies to` (`Soldier case` OF TRUE, FALSE, Date 1 1 1963, FALSE, Date 30 4 1906, TRUE, Date 1 3 1961, TRUE, FALSE, 3, TRUE, `category 103`, 1, FALSE, 500, 200, 300, `notadd`, 350, 100, Date 15 3 1961, NOTHING, 0))
#ASSERT `the Act applies to` (`Soldier case` OF TRUE, FALSE, Date 1 1 1963, FALSE, Date 1 5 1906, TRUE, Date 1 3 1961, TRUE, FALSE, 3, TRUE, `category 103`, 1, FALSE, 500, 200, 300, `notadd`, 350, 100, Date 15 3 1961, NOTHING, 0)
-- engagement expiring in the period; re-enlisting the next day
#ASSERT NOT (`the Act applies to` (`Soldier case` OF TRUE, FALSE, Date 30 4 1961, FALSE, Date 1 6 1920, TRUE, Date 1 3 1961, TRUE, FALSE, 3, TRUE, `category 103`, 1, FALSE, 500, 200, 300, `notadd`, 350, 100, Date 15 3 1961, NOTHING, 0))
#ASSERT NOT (`the Act applies to` (`Soldier case` OF TRUE, FALSE, Date 1 1 1963, FALSE, Date 1 6 1920, TRUE, Date 1 3 1961, TRUE, TRUE, 3, TRUE, `category 103`, 1, FALSE, 500, 200, 300, `notadd`, 350, 100, Date 15 3 1961, NOTHING, 0))

-- s 6: £20 × 3.
#ASSERT `the special gratuity for` `nopay` EQUALS 60
-- s 7: 10 years × 14 × (£1 + £0.525) = 213.5.
#ASSERT `my benefit for` (`a soldier with` 10 `years` `notadd` `paying on` NOTHING `the sum` 0) EQUALS `a gratuity under section 7`
#ASSERT `the special gratuity for` (`a soldier with` 10 `years` `notadd` `paying on` NOTHING `the sum` 0) EQUALS 213.5

-- s 9: category 103 after 17 years: £379. No contribution: the minimum, £200.
#ASSERT `the First Schedule rate for` `category 103` `after` 17 EQUALS 379
#ASSERT `the First Schedule rate for` `category 109` `after` 19 EQUALS 289
#ASSERT `the First Schedule rate for` `category 101` `after` 15 EQUALS 400
#ASSERT `my pension rate for` (`a soldier with` 17 `years` `notadd` `paying on` NOTHING `the sum` 0) EQUALS 200
#ASSERT `my pension rate for` (`a soldier with` 17 `years` `notadd` `paying on` (JUST (Date 14 4 1961)) `the sum` 300) EQUALS 379
-- half the contribution: 200 + 179 / 2
#ASSERT `my pension rate for` (`a soldier with` 17 `years` `notadd` `paying on` (JUST (Date 14 4 1961)) `the sum` 150) EQUALS 289.5
-- paid on the prescribed day (15 April 1961): too late
#ASSERT `my pension rate for` (`a soldier with` 17 `years` `notadd` `paying on` (JUST (Date 15 4 1961)) `the sum` 300) EQUALS 200
-- would not reach 20 years by 55: s 7
#ASSERT `my benefit for` (`Soldier case` OF TRUE, FALSE, Date 1 1 1963, FALSE, Date 1 6 1920, TRUE, Date 1 3 1961, TRUE, FALSE, 17, FALSE, `category 103`, 1, FALSE, 500, 200, 300, `notadd`, 350, 100, Date 15 3 1961, NOTHING, 0) EQUALS `a gratuity under section 7`

-- s 10: not contributing for additional benefits, paying 150 of 300: 200 + 300/2 = 350.
#ASSERT `my pension rate for` (`a soldier with` 22 `years` `notadd` `paying on` (JUST (Date 1 4 1961)) `the sum` 150) EQUALS 350
#ASSERT `my pension rate for` (`a soldier with` 22 `years` `notadd` `paying on` (JUST (Date 1 4 1961)) `the sum` 300) EQUALS 500
-- contributing for additional benefits: normal 350 for 100; 200 of 300 gives 350 + 150 × 100/200 = 425
#ASSERT `my pension rate for` (`a soldier with` 22 `years` `adding` `paying on` (JUST (Date 1 4 1961)) `the sum` 200) EQUALS 425
#ASSERT `my pension rate for` (`a soldier with` 22 `years` `adding` `paying on` (JUST (Date 1 4 1961)) `the sum` 100) EQUALS 350
#ASSERT `my pension rate for` (`a soldier with` 22 `years` `adding` `paying on` (JUST (Date 1 4 1961)) `the sum` 50) EQUALS 275
#ASSERT `my pension rate for` (`a soldier with` 22 `years` `adding` `paying on` NOTHING `the sum` 0) EQUALS 200
#ASSERT (`the soldier position for` (`a soldier with` 22 `years` `adding` `paying on` NOTHING `the sum` 0))'s `the prescribed day for my contribution` EQUALS JUST (Date 15 4 1961)
