IMPORT prelude
IMPORT daydate
IMPORT `dfsrb-rules`

-- Independent tests: expected values from independent-expectations.md,
-- written from the source text before reading the rules module.

-- Application: varying the s 4 facts; benefits held at a 5-year s 6 case.
GIVEN male IS A BOOLEAN
      ord IS A BOOLEAN
      eng IS A DATE
      offr IS A BOOLEAN
      dob IS A DATE
      decl IS A BOOLEAN
      dis IS A DATE
      forr IS A BOOLEAN
      again IS A BOOLEAN
GIVETH A BOOLEAN
applies male ord eng offr dob decl dis forr again MEANS
    `the Act applies to` (`Soldier case` OF male, ord, eng, offr, dob, decl, dis, forr, again, 5, FALSE, `category 101`, 2, FALSE, 0, 0, 0, `not contributing on retirement for additional benefits`, 0, 0, Date 1 6 1961, NOTHING, 0)

DECIDE far IS Date 1 1 1970
DECIDE b20 IS Date 1 1 1920
DECIDE d1 IS Date 1 3 1961

-- Benefits: base soldier, varying service and the Board's figures.
GIVEN yrs IS A NUMBER
      w20 IS A BOOLEAN
      cat IS A `Category`
      pay IS A NUMBER
      red IS A BOOLEAN
      bmax IS A NUMBER
      mn IS A NUMBER
      mxc IS A NUMBER
      s10 IS A `Section 10 contributor`
      nr IS A NUMBER
      nc IS A NUMBER
      srv IS A DATE
      pdon IS A MAYBE DATE
      amt IS A NUMBER
GIVETH A `Soldier position`
pos yrs w20 cat pay red bmax mn mxc s10 nr nc srv pdon amt MEANS
    `the soldier position for` (`Soldier case` OF TRUE, FALSE, far, FALSE, b20, TRUE, d1, TRUE, FALSE, yrs, w20, cat, pay, red, bmax, mn, mxc, s10, nr, nc, srv, pdon, amt)

DECIDE nc0 IS `not contributing on retirement for additional benefits`
DECIDE cc IS `contributing on retirement for additional benefits`
DECIDE sv IS Date 15 6 1961
DECIDE ok IS JUST (Date 1 7 1961)

-- 1-12: s 4
#ASSERT applies TRUE FALSE far FALSE b20 TRUE d1 TRUE FALSE
#ASSERT applies TRUE FALSE far FALSE b20 TRUE (Date 30 4 1961) TRUE FALSE
#ASSERT NOT (applies TRUE FALSE far FALSE b20 TRUE (Date 1 5 1961) TRUE FALSE)
#ASSERT applies TRUE TRUE far FALSE b20 TRUE (Date 1 5 1961) TRUE FALSE
#ASSERT NOT (applies TRUE FALSE (Date 30 4 1961) FALSE b20 TRUE d1 TRUE FALSE)
#ASSERT applies TRUE FALSE (Date 1 5 1961) FALSE b20 TRUE d1 TRUE FALSE
#ASSERT NOT (applies TRUE FALSE far FALSE (Date 31 1 1906) TRUE d1 TRUE FALSE)
#ASSERT NOT (applies TRUE FALSE far FALSE (Date 1 2 1906) TRUE d1 TRUE FALSE)
#ASSERT NOT (applies TRUE FALSE far FALSE (Date 30 4 1906) TRUE d1 TRUE FALSE)
#ASSERT applies TRUE FALSE far FALSE (Date 1 5 1906) TRUE d1 TRUE FALSE
#ASSERT NOT (applies TRUE TRUE far FALSE (Date 1 5 1906) TRUE d1 TRUE FALSE)
#ASSERT NOT (applies TRUE FALSE far TRUE b20 TRUE d1 TRUE FALSE)
#ASSERT NOT (applies TRUE FALSE far FALSE b20 FALSE d1 TRUE FALSE)
#ASSERT NOT (applies TRUE FALSE far FALSE b20 TRUE d1 TRUE TRUE)
#ASSERT NOT (applies FALSE FALSE far FALSE b20 TRUE d1 TRUE FALSE)
#ASSERT NOT (applies TRUE FALSE far FALSE b20 TRUE d1 FALSE FALSE)

-- 13-16: gratuities
#ASSERT (pos 5 FALSE `category 101` 2 FALSE 0 0 0 nc0 0 0 sv NOTHING 0)'s `the special gratuity in pounds` EQUALS 100
#ASSERT (pos 6 FALSE `category 101` 2 FALSE 0 0 0 nc0 0 0 sv NOTHING 0)'s `the special gratuity in pounds` EQUALS 212.1
#ASSERT (pos 14 TRUE `category 101` 2 FALSE 0 0 0 nc0 0 0 sv NOTHING 0)'s `the special gratuity in pounds` EQUALS 494.9
#ASSERT (pos 16 FALSE `category 101` 2 FALSE 0 0 0 nc0 0 0 sv NOTHING 0)'s `the special gratuity in pounds` EQUALS 565.6
#ASSERT (pos 16 FALSE `category 101` 2 FALSE 0 0 0 nc0 0 0 sv NOTHING 0)'s `my benefit` EQUALS `a gratuity under section 7`

-- 17-22: s 9
#ASSERT (pos 15 TRUE `category 101` 2 FALSE 0 300 200 nc0 0 0 sv ok 200)'s `my pension rate in pounds a year` EQUALS 400
#ASSERT (pos 15 TRUE `category 101` 2 FALSE 0 300 200 nc0 0 0 sv ok 100)'s `my pension rate in pounds a year` EQUALS 350
#ASSERT (pos 15 TRUE `category 101` 2 FALSE 0 300 200 nc0 0 0 sv NOTHING 0)'s `my pension rate in pounds a year` EQUALS 300
#ASSERT (pos 19 TRUE `category 101` 2 FALSE 0 300 200 nc0 0 0 sv ok 200)'s `my pension rate in pounds a year` EQUALS 480
#ASSERT (pos 17 TRUE `category 105` 2 FALSE 0 300 200 nc0 0 0 sv ok 200)'s `my pension rate in pounds a year` EQUALS 340
#ASSERT (pos 15 TRUE `category 101` 2 TRUE 380 300 200 nc0 0 0 sv ok 200)'s `my pension rate in pounds a year` EQUALS 380

-- 23-24: prescribed day and lateness
#ASSERT (pos 15 TRUE `category 101` 2 FALSE 0 300 200 nc0 0 0 sv ok 200)'s `the prescribed day for my contribution` EQUALS JUST (Date 15 7 1961)
#ASSERT (pos 15 TRUE `category 101` 2 FALSE 0 300 200 nc0 0 0 sv (JUST (Date 14 7 1961)) 200)'s `my pension rate in pounds a year` EQUALS 400
#ASSERT (pos 15 TRUE `category 101` 2 FALSE 0 300 200 nc0 0 0 sv (JUST (Date 15 7 1961)) 200)'s `my pension rate in pounds a year` EQUALS 300
#ASSERT (pos 15 TRUE `category 101` 2 FALSE 0 300 200 nc0 0 0 (Date 31 1 1962) ok 200)'s `the prescribed day for my contribution` EQUALS JUST (Date 28 2 1962)
#ASSERT (pos 15 TRUE `category 101` 2 FALSE 0 300 200 nc0 0 0 (Date 31 1 1962) (JUST (Date 27 2 1962)) 200)'s `my pension rate in pounds a year` EQUALS 400
#ASSERT (pos 15 TRUE `category 101` 2 FALSE 0 300 200 nc0 0 0 (Date 31 1 1962) (JUST (Date 28 2 1962)) 200)'s `my pension rate in pounds a year` EQUALS 300

-- 25-31: s 10
#ASSERT (pos 20 TRUE `category 101` 2 FALSE 600 400 300 nc0 0 0 sv ok 150)'s `my pension rate in pounds a year` EQUALS 500
#ASSERT (pos 20 TRUE `category 101` 2 FALSE 600 400 300 nc0 0 0 sv ok 300)'s `my pension rate in pounds a year` EQUALS 600
#ASSERT (pos 20 TRUE `category 101` 2 FALSE 600 400 300 nc0 0 0 sv NOTHING 0)'s `my pension rate in pounds a year` EQUALS 400
#ASSERT (pos 20 TRUE `category 101` 2 FALSE 600 400 300 cc 500 100 sv ok 300)'s `my pension rate in pounds a year` EQUALS 600
#ASSERT (pos 20 TRUE `category 101` 2 FALSE 600 400 300 cc 500 100 sv ok 200)'s `my pension rate in pounds a year` EQUALS 550
#ASSERT (pos 20 TRUE `category 101` 2 FALSE 600 400 300 cc 500 100 sv ok 100)'s `my pension rate in pounds a year` EQUALS 500
#ASSERT (pos 20 TRUE `category 101` 2 FALSE 600 400 300 cc 500 100 sv ok 50)'s `my pension rate in pounds a year` EQUALS 450
#ASSERT (pos 20 TRUE `category 101` 2 FALSE 600 400 300 cc 500 100 sv NOTHING 0)'s `my pension rate in pounds a year` EQUALS 400
-- 32
#ASSERT (`the soldier position for` (`Soldier case` OF TRUE, FALSE, far, FALSE, b20, FALSE, d1, TRUE, FALSE, 20, TRUE, `category 101`, 2, FALSE, 600, 400, 300, nc0, 0, 0, sv, ok, 300))'s `my pension rate in pounds a year` EQUALS 0
