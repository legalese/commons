IMPORT prelude
IMPORT daydate
IMPORT `fbtaa-employee`

-- Fringe Benefits Tax Assessment Act 1986 -- worked cases, from the seat of the employee receiving a benefit. Every
-- assertion is a claim about the ENCODING on stated facts, not about the law. Expected values were written by hand from the
-- deposited text (Compilation No. 97) and the formulas sidecar, never copied from the encoding's output. All facts are
-- HYPOTHETICAL; no scenario raised this Act. Interest rates are hypothetical, not the Reserve Bank's.

-- ---------------------------------------------------------------------------------------------------------------------
-- Is it a fringe benefit? A car for private use from her employer.
#ASSERT `Is this benefit a fringe benefit` TRUE TRUE TRUE `something else (a car, a loan, goods, a payment of my expenses, a gift, housing, and so on)` FALSE EQUALS `yes: it is a fringe benefit, provided in respect of my employment; my employer is liable for fringe benefits tax on its taxable value (ss 66, 136(1))`
-- Her wages, and her employer's super contributions: excluded.
#ASSERT `Is this benefit a fringe benefit` TRUE TRUE TRUE `salary or wages` FALSE EQUALS `no: salary or wages, super contributions, employee share scheme interests and termination payments are excluded from "fringe benefit" (s 136(1)(f)-(lc)); they are taxed, if at all, under the income tax law`
#ASSERT `Is this benefit a fringe benefit` TRUE TRUE TRUE `a contribution to a complying superannuation fund for me` FALSE EQUALS `no: salary or wages, super contributions, employee share scheme interests and termination payments are excluded from "fringe benefit" (s 136(1)(f)-(lc)); they are taxed, if at all, under the income tax law`
-- A work laptop that is exempt under s 58X.
#ASSERT `Is this benefit a fringe benefit` TRUE TRUE TRUE `something else (a car, a loan, goods, a payment of my expenses, a gift, housing, and so on)` TRUE EQUALS `no: it is an exempt benefit, so it is not a fringe benefit (s 136(1)(g))`
-- A gym membership her husband's employer gives him is not from her employer.
#ASSERT `Is this benefit a fringe benefit` TRUE FALSE TRUE `something else (a car, a loan, goods, a payment of my expenses, a gift, housing, and so on)` FALSE EQUALS `no: it is not provided to me or my associate by my employer, its associate, or a third party under an arrangement with or facilitated by them (s 136(1)(c)-(ea))`
-- A wedding present from her employer, who is also her aunt, given as family, not for the job.
#ASSERT `Is this benefit a fringe benefit` TRUE TRUE FALSE `something else (a car, a loan, goods, a payment of my expenses, a gift, housing, and so on)` FALSE EQUALS `no: it is not provided in respect of my employment (s 136(1))`

-- ---------------------------------------------------------------------------------------------------------------------
-- Electric cars (s 8A).
#ASSERT `Is my electric car exempt` TRUE `a battery electric vehicle (electric motor only, no fuel cell or petrol or diesel engine)` FALSE EQUALS `yes: the car benefit is exempt (s 8A), but its taxable value still counts towards my reportable fringe benefits amount (s 135P(3))`
#ASSERT `Is my electric car exempt` TRUE `a hydrogen fuel cell electric vehicle (no petrol or diesel engine)` FALSE EQUALS `yes: the car benefit is exempt (s 8A), but its taxable value still counts towards my reportable fringe benefits amount (s 135P(3))`
#ASSERT `Is my electric car exempt` TRUE `a plug-in hybrid` FALSE EQUALS `no: only a battery electric or hydrogen fuel cell electric vehicle is a zero or low emissions vehicle (s 8A(2)-(4)); a plug-in hybrid or other car is not`
#ASSERT `Is my electric car exempt` TRUE `a battery electric vehicle (electric motor only, no fuel cell or petrol or diesel engine)` TRUE EQUALS `no: luxury car tax became payable on the car before the benefit was provided (s 8A(1)(c))`
-- A future employee given the car before starting.
#ASSERT `Is my electric car exempt` FALSE `a battery electric vehicle (electric motor only, no fuel cell or petrol or diesel engine)` FALSE EQUALS `no: the exemption is only for a current employee (s 8A(1)(a))`

-- Work items (s 58X): a work phone; the same phone salary packaged; a phone mainly for private use; protective clothing;
-- a coffee machine for home.
#ASSERT `Is my work item exempt` `a portable electronic device (a phone, laptop or tablet)` TRUE FALSE
#ASSERT (NOT (`Is my work item exempt` `a portable electronic device (a phone, laptop or tablet)` TRUE TRUE))
#ASSERT (NOT (`Is my work item exempt` `a portable electronic device (a phone, laptop or tablet)` FALSE FALSE))
#ASSERT `Is my work item exempt` `protective clothing` TRUE FALSE
#ASSERT (NOT (`Is my work item exempt` `something else` TRUE FALSE))

-- Minor benefits (s 58P): a $150 hamper at Christmas, unreasonable to treat as a fringe benefit; one worth $299.99; one
-- worth $300; a $150 benefit it is not unreasonable to treat as one; a $150 in-house benefit.
#ASSERT `Is my minor benefit exempt` 150 TRUE FALSE
#ASSERT `Is my minor benefit exempt` 299.99 TRUE FALSE
#ASSERT (NOT (`Is my minor benefit exempt` 300 TRUE FALSE))
#ASSERT (NOT (`Is my minor benefit exempt` 150 FALSE FALSE))
#ASSERT (NOT (`Is my minor benefit exempt` 150 TRUE TRUE))

-- Loans (s 17): a travel advance accounted for within 6 months; a staff loan at a bank's ordinary fixed rate; a discounted
-- home loan; an advance that does not meet the conditions.
#ASSERT `Is my loan exempt` `an advance to pay expenses of my job` TRUE
#ASSERT `Is my loan exempt` `a fixed-rate loan from a lender to the public, on its ordinary terms` TRUE
#ASSERT (NOT (`Is my loan exempt` `another loan` TRUE))
#ASSERT (NOT (`Is my loan exempt` `an advance to pay expenses of my job` FALSE))

-- ---------------------------------------------------------------------------------------------------------------------
-- The car, statutory formula. FBT year 2026 (1 April 2026 to 31 March 2027, 365 days).
-- A $50,000 car first held on 15 June 2026, available all 365 days, nothing paid: 50,000 x 0.2 x 365/365 = $10,000.
#ASSERT `The taxable value of my car` 50000 (Date 15 6 2026) 2026 0 365 0 EQUALS 10000
-- ... she paid $2,000 of fuel with receipts given in time: $8,000.
#ASSERT `The taxable value of my car` 50000 (Date 15 6 2026) 2026 0 365 2000 EQUALS 8000
-- FBT year 2027 has 366 days (29 February 2028): available 183 of them, 50,000 x 0.2 x 183/366 = $5,000.
#ASSERT `The taxable value of my car` 50000 (Date 15 6 2026) 2027 0 183 0 EQUALS 5000
-- A $60,000 car first held on 1 May 2020: the FBT year starting 1 April 2026 begins after the fourth anniversary (1 May
-- 2024), so the base value is 2/3: $40,000, plus a $1,500 tow bar: $41,500; x 0.2 = $8,300.
#ASSERT `The taxable value of my car` 60000 (Date 1 5 2020) 2026 1500 365 0 EQUALS 8300
-- First held on 1 April 2022: the year starting 1 April 2026 begins on the fourth anniversary, not later: full value.
#ASSERT `The taxable value of my car` 30000 (Date 1 4 2022) 2026 0 365 0 EQUALS 6000
-- She paid more than the formula's amount: nil, not negative (finding 4).
#ASSERT `The taxable value of my car` 10000 (Date 1 4 2026) 2026 0 365 3000 EQUALS 0

-- The loan, s 18. $100,000 interest-free all year at a hypothetical 9%: $9,000; with $4,000 interest charged, $5,000;
-- charged more than the benchmark, nil; owed 73 days, $1,800.
#ASSERT `The taxable value of my loan` 100000 365 9 0 EQUALS 9000
#ASSERT `The taxable value of my loan` 100000 365 9 4000 EQUALS 5000
#ASSERT `The taxable value of my loan` 100000 365 9 10000 EQUALS 0
#ASSERT `The taxable value of my loan` 100000 73 9 0 EQUALS 1800

-- ---------------------------------------------------------------------------------------------------------------------
-- The reportable amount, s 135P. FBT year 2026, rate 47%: $5,300 x 1/(1 - 0.47) = $10,000; $2,120 gives $4,000.
#ASSERT `My reportable fringe benefits amount` 5300 2026 FALSE EQUALS `answered` 10000
#ASSERT `My reportable fringe benefits amount` 2120 2026 FALSE EQUALS `answered` 4000
-- $2,000 is not "more than $2,000": none.
#ASSERT `My reportable fringe benefits amount` 2000 2026 FALSE EQUALS `answered` 0
-- FBT year 2015, rate 49%: $5,100 gives $10,000.
#ASSERT `My reportable fringe benefits amount` 5100 2015 FALSE EQUALS `answered` 10000
#ASSERT `My reportable fringe benefits amount` 5100 2014 FALSE EQUALS `not covered` `the deposited Fringe Benefits Tax Act gives the rate only for years of tax from 1 April 2015`
#ASSERT `My reportable fringe benefits amount` 5300 2026 TRUE EQUALS `not covered` `the reportable amount for an employee of a public benevolent institution, health promotion charity, public or non-profit hospital, public ambulance service, or a s 58 employer is worked out under s 135Q, which is not encoded`
-- Two employers, $10,000 and $4,000: a total of $14,000 (s 135N).
#ASSERT `My reportable fringe benefits total` (LIST 10000, 4000) EQUALS 14000
