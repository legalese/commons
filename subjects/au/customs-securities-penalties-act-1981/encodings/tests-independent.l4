IMPORT prelude
IMPORT `csp-rules`

-- Independent tests from BRIEF.md and the Act (independent-expectations.md).
-- `Security case` OF accepted, refused-or-failed-when-required, %, unit value, units, value

-- 1 failed; 10% of 50,000
#ASSERT `my security penalty for` (`Security case` OF TRUE, TRUE, 10, NOTHING, 0, 50000) EQUALS 5000
-- 2 refused (same input)
#ASSERT `my security penalty for` (`Security case` OF TRUE, TRUE, 10, NOTHING, 0, 50000) EQUALS 5000
-- 3 tender not accepted
#ASSERT `my security penalty for` (`Security case` OF FALSE, TRUE, 10, NOTHING, 0, 50000) EQUALS 0
-- 4 / 5 not required, or security given
#ASSERT `my security penalty for` (`Security case` OF TRUE, FALSE, 10, NOTHING, 0, 50000) EQUALS 0
-- 6 unit value 20 x 1000, 15%
#ASSERT `my security penalty for` (`Security case` OF TRUE, TRUE, 15, JUST 20, 1000, 0) EQUALS 3000
-- 6b unit value overrides any stated total value
#ASSERT `my security penalty for` (`Security case` OF TRUE, TRUE, 15, JUST 20, 1000, 99999) EQUALS 3000
-- 7 fractional
#ASSERT `my security penalty for` (`Security case` OF TRUE, TRUE, 10, JUST 2.5, 3, 0) EQUALS 0.75
-- 8 0%
#ASSERT `my security penalty for` (`Security case` OF TRUE, TRUE, 0, NOTHING, 0, 50000) EQUALS 0
-- 9 100%
#ASSERT `my security penalty for` (`Security case` OF TRUE, TRUE, 100, NOTHING, 0, 12345) EQUALS 12345
-- 10 goods value 0
#ASSERT `my security penalty for` (`Security case` OF TRUE, TRUE, 10, NOTHING, 0, 0) EQUALS 0
-- s 3(2) value helper
#ASSERT `the value of the goods for` (`Security case` OF TRUE, TRUE, 15, JUST 20, 1000, 0) EQUALS 20000
