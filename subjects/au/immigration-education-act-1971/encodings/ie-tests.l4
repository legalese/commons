IMPORT prelude
IMPORT daydate
IMPORT `ie-rules`

-- Immigration (Education) Act 1971 (Cth) — the encoder's tests.

§ `Tests`

`pv` MEANS `in Australia on a permanent visa`

-- An adult whose visa commencement day is 31 August 2025.
GIVEN reg IS A MAYBE DATE, st IS A MAYBE DATE, asked IS A DATE
GIVETH A `English case`
`an adult registering` reg `starting` st `asked on` asked MEANS
    `English case` OF `pv`, FALSE, Date 1 1 1990, Date 31 8 2025, TRUE, FALSE, FALSE, reg, st, 0, 0, 0, asked

-- s 4C(2)(a)(ii): 6 months starting 31 August 2025 end on 28 February 2026.
#ASSERT `the last registration day for` (`an adult registering` NOTHING `starting` NOTHING `asked on` (Date 1 9 2025)) EQUALS JUST (Date 28 2 2026)
-- s 4C(2)(b): 12 months end on 30 August 2026.
#ASSERT `the last start day for` (`an adult registering` NOTHING `starting` NOTHING `asked on` (Date 1 9 2025)) EQUALS JUST (Date 30 8 2026)
-- s 4D(2): 5 years end on 30 August 2030.
#ASSERT `the last eligible day for` (`an adult registering` NOTHING `starting` NOTHING `asked on` (Date 1 9 2025)) EQUALS JUST (Date 30 8 2030)
#ASSERT `I am eligible` (`an adult registering` NOTHING `starting` NOTHING `asked on` (Date 28 2 2026))
#ASSERT NOT (`I am eligible` (`an adult registering` NOTHING `starting` NOTHING `asked on` (Date 1 3 2026)))
#ASSERT `I am eligible` (`an adult registering` (JUST (Date 1 2 2026)) `starting` (JUST (Date 1 6 2026)) `asked on` (Date 1 1 2028))
#ASSERT NOT (`I am eligible` (`an adult registering` (JUST (Date 1 2 2026)) `starting` (JUST (Date 31 8 2026)) `asked on` (Date 1 1 2028)))
#ASSERT NOT (`I am eligible` (`an adult registering` (JUST (Date 1 2 2026)) `starting` (JUST (Date 1 6 2026)) `asked on` (Date 31 8 2030)))
-- s 4B
#ASSERT `the Minister must provide tuition` (`an adult registering` NOTHING `starting` NOTHING `asked on` (Date 1 9 2025))
#ASSERT NOT (`the Minister must provide tuition` (`English case` OF `pv`, FALSE, Date 1 1 1990, Date 31 8 2025, TRUE, TRUE, FALSE, NOTHING, NOTHING, 0, 0, 0, Date 1 9 2025))
-- a child: 12 months to register; not within s 4B
#ASSERT `the last registration day for` (`English case` OF `pv`, FALSE, Date 1 1 2010, Date 31 8 2025, TRUE, FALSE, FALSE, NOTHING, NOTHING, 0, 0, 0, Date 1 9 2025) EQUALS JUST (Date 30 8 2026)
#ASSERT NOT (`the Minister must provide tuition` (`English case` OF `pv`, FALSE, Date 1 1 2010, Date 31 8 2025, TRUE, FALSE, FALSE, NOTHING, NOTHING, 0, 0, 0, Date 1 9 2025))
-- ss 4C(1A), 4D(1A): visa commencement day on or before 1 October 2020
#ASSERT `the last eligible day for` (`English case` OF `pv`, FALSE, Date 1 1 1990, Date 1 10 2020, TRUE, FALSE, FALSE, NOTHING, NOTHING, 0, 0, 0, Date 1 1 2030) EQUALS NOTHING
#ASSERT `I am eligible` (`English case` OF `pv`, FALSE, Date 1 1 1990, Date 1 10 2020, TRUE, FALSE, FALSE, NOTHING, NOTHING, 0, 0, 0, Date 1 1 2030)
-- extension of 30 days to register
#ASSERT `the last registration day for` (`English case` OF `pv`, FALSE, Date 1 1 1990, Date 31 8 2025, TRUE, FALSE, FALSE, NOTHING, NOTHING, 30, 0, 0, Date 1 9 2025) EQUALS JUST (Date 30 3 2026)
-- vocational English
#ASSERT NOT (`I am eligible` (`English case` OF `pv`, TRUE, Date 1 1 1990, Date 31 8 2025, TRUE, FALSE, FALSE, NOTHING, NOTHING, 0, 0, 0, Date 1 9 2025))
#ASSERT NOT (`I am eligible` (`English case` OF `none of these`, FALSE, Date 1 1 1990, Date 31 8 2025, TRUE, FALSE, FALSE, NOTHING, NOTHING, 0, 0, 0, Date 1 9 2025))
