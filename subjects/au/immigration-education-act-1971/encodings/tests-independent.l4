IMPORT prelude
IMPORT daydate
IMPORT `ie-rules`

-- Independent tests: expected values from independent-expectations.md.

GIVEN st IS A `My status`
      ve IS A BOOLEAN
      dob IS A DATE
      vcd IS A DATE
      chg IS A BOOLEAN
      prior IS A BOOLEAN
      excl IS A BOOLEAN
      reg IS A MAYBE DATE
      started IS A MAYBE DATE
      xr IS A NUMBER
      xs IS A NUMBER
      xt IS A NUMBER
      asked IS A DATE
GIVETH A `English position`
`pos` st ve dob vcd chg prior excl reg started xr xs xt asked MEANS
  `the English position for` (`English case` OF st, ve, dob, vcd, chg, prior, excl, reg, started, xr, xs, xt, asked)

DECIDE `pv` IS `in Australia on a permanent visa`

GIVEN reg IS A MAYBE DATE
      started IS A MAYBE DATE
      asked IS A DATE
GIVETH A `English position`
`timed` reg started asked MEANS
  `pos` `pv` FALSE (Date 1 1 1990) (Date 1 3 2023) TRUE FALSE FALSE reg started 0 0 0 asked

DECIDE base IS `timed` (JUST (Date 1 4 2023)) (JUST (Date 1 5 2023)) (Date 1 1 2024)

-- 1
#ASSERT base's `I am eligible under s 4A` EQUALS TRUE
#ASSERT base's `the Minister must provide me tuition` EQUALS TRUE
#ASSERT base's `the last day to register` EQUALS JUST (Date 31 8 2023)
#ASSERT base's `the last day to start a course` EQUALS JUST (Date 29 2 2024)
#ASSERT base's `the last day of eligibility` EQUALS JUST (Date 29 2 2028)
-- 2
#ASSERT (`pos` `pv` TRUE (Date 1 1 1990) (Date 1 3 2023) TRUE FALSE FALSE (JUST (Date 1 4 2023)) (JUST (Date 1 5 2023)) 0 0 0 (Date 1 1 2024))'s `I am eligible under s 4A` EQUALS FALSE
#ASSERT (`pos` `pv` TRUE (Date 1 1 1990) (Date 1 3 2023) TRUE FALSE FALSE (JUST (Date 1 4 2023)) (JUST (Date 1 5 2023)) 0 0 0 (Date 1 1 2024))'s `the Minister must provide me tuition` EQUALS FALSE
-- 3
#ASSERT (`pos` `none of these` FALSE (Date 1 1 1990) (Date 1 3 2023) TRUE FALSE FALSE (JUST (Date 1 4 2023)) (JUST (Date 1 5 2023)) 0 0 0 (Date 1 1 2024))'s `I am eligible under s 4A` EQUALS FALSE
-- 4
#ASSERT (`pos` `in Australia on a specified temporary visa` FALSE (Date 1 1 1990) (Date 1 3 2023) TRUE FALSE FALSE (JUST (Date 1 4 2023)) (JUST (Date 1 5 2023)) 0 0 0 (Date 1 1 2024))'s `I am eligible under s 4A` EQUALS TRUE
#ASSERT (`pos` `in Australia on a specified temporary visa` FALSE (Date 1 1 1990) (Date 1 3 2023) TRUE FALSE FALSE (JUST (Date 1 4 2023)) (JUST (Date 1 5 2023)) 0 0 0 (Date 1 1 2024))'s `the Minister must provide me tuition` EQUALS FALSE
-- 5
#ASSERT (`pos` `a former permanent visa or entry permit holder who became a citizen` FALSE (Date 1 1 1990) (Date 1 3 2023) TRUE FALSE FALSE (JUST (Date 1 4 2023)) (JUST (Date 1 5 2023)) 0 0 0 (Date 1 1 2024))'s `I am eligible under s 4A` EQUALS TRUE
#ASSERT (`pos` `a former permanent visa or entry permit holder who became a citizen` FALSE (Date 1 1 1990) (Date 1 3 2023) TRUE FALSE FALSE (JUST (Date 1 4 2023)) (JUST (Date 1 5 2023)) 0 0 0 (Date 1 1 2024))'s `the Minister must provide me tuition` EQUALS FALSE
-- 6
#ASSERT (`pos` `in Australia, under 18, with a parent who holds or held a permanent visa or entry permit` FALSE (Date 1 1 2010) (Date 1 3 2023) TRUE FALSE FALSE (JUST (Date 1 4 2023)) (JUST (Date 1 5 2023)) 0 0 0 (Date 1 1 2024))'s `I am eligible under s 4A` EQUALS TRUE
