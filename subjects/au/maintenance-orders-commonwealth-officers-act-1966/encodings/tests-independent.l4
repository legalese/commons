IMPORT prelude
IMPORT daydate
IMPORT `moco-rules`

-- Independent tests from BRIEF.md and the Act (independent-expectations.md).

orderA MEANS `Attachment order` OF Date 1 1 2020, 300
orderB MEANS `Attachment order` OF Date 1 1 2021, 500
orderBbig MEANS `Attachment order` OF Date 1 1 2021, 900
-- s 7(3): varied in 2022 but deemed in force as varied from 1 Jan 2019
orderAvaried MEANS `Attachment order` OF Date 1 1 2019, 600
orderC MEANS `Attachment order` OF Date 1 1 2018, 100
orderB800 MEANS `Attachment order` OF Date 1 1 2021, 800

-- 1 / 3 State law provides: attachable (s 6(1), (3))
#ASSERT `my Commonwealth pay can be attached for` (`Attachment case` OF TRUE, 1000, (LIST orderA))
-- 2 no State provision: s 5
#ASSERT NOT (`my Commonwealth pay can be attached for` (`Attachment case` OF FALSE, 1000, (LIST orderA)))
-- 4 one order
#ASSERT `the amounts paid under each order for` (`Attachment case` OF TRUE, 1000, (LIST orderA)) EQUALS JUST (LIST 300)
-- 5 two orders, by date
#ASSERT `the amounts paid under each order for` (`Attachment case` OF TRUE, 1000, (LIST orderA, orderB)) EQUALS JUST (LIST 300, 500)
-- 6 second order capped at the residue
#ASSERT `the amounts paid under each order for` (`Attachment case` OF TRUE, 1000, (LIST orderA, orderBbig)) EQUALS JUST (LIST 300, 700)
-- 7 list order irrelevant (output earliest first)
#ASSERT `the amounts paid under each order for` (`Attachment case` OF TRUE, 1000, (LIST orderB, orderA)) EQUALS JUST (LIST 300, 500)
-- 8 earnings less than the first order
#ASSERT `the amounts paid under each order for` (`Attachment case` OF TRUE, 200, (LIST orderA, orderB)) EQUALS JUST (LIST 200, 0)
-- 9 varied order keeps its original date
#ASSERT `the amounts paid under each order for` (`Attachment case` OF TRUE, 1000, (LIST orderB, orderAvaried)) EQUALS JUST (LIST 600, 400)
-- 10 three orders
#ASSERT `the amounts paid under each order for` (`Attachment case` OF TRUE, 1000, (LIST orderA, orderB800, orderC)) EQUALS JUST (LIST 100, 300, 600)
-- 11 no State provision: nothing paid
#ASSERT `the amounts paid under each order for` (`Attachment case` OF FALSE, 1000, (LIST orderA, orderB)) EQUALS NOTHING
-- 12 total never exceeds earnings
#ASSERT sum (`pay from` 650 `to` (LIST orderA, orderB, orderC)) EQUALS 650
