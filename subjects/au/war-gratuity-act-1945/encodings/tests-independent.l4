IMPORT prelude
IMPORT `wg-rules`

-- Independent tests: expected values from independent-expectations.md, written before reading the L4.

-- scenario 1 no service
#ASSERT `the gratuity position for` (`Gratuity case` OF 0, 0, FALSE, `the member did not die of war service`, FALSE, FALSE, 0) EQUALS (`Gratuity position` OF 0, 0, 0, TRUE)

-- scenario 2 30 general days
#ASSERT `the gratuity position for` (`Gratuity case` OF 0, 30, FALSE, `the member did not die of war service`, FALSE, FALSE, 0) EQUALS (`Gratuity position` OF 0, 1, 150/100, TRUE)

-- scenario 3 31 general days
#ASSERT `the gratuity position for` (`Gratuity case` OF 0, 31, FALSE, `the member did not die of war service`, FALSE, FALSE, 0) EQUALS (`Gratuity position` OF 0, 2, 3, TRUE)

-- scenario 4 90 overseas, deemed 12
#ASSERT `the gratuity position for` (`Gratuity case` OF 90, 400, FALSE, `the member did not die of war service`, FALSE, FALSE, 0) EQUALS (`Gratuity position` OF 12, 2, 93, TRUE)

-- scenario 5 returned at own request
#ASSERT `the gratuity position for` (`Gratuity case` OF 90, 400, TRUE, `the member did not die of war service`, FALSE, FALSE, 0) EQUALS (`Gratuity position` OF 3, 11, 39, TRUE)

-- scenario 6/7 disciplinary or excepted injury (same input)
#ASSERT `the gratuity position for` (`Gratuity case` OF 90, 400, TRUE, `the member did not die of war service`, FALSE, FALSE, 0) EQUALS (`Gratuity position` OF 3, 11, 39, TRUE)

-- scenario 8 330 overseas days
#ASSERT `the gratuity position for` (`Gratuity case` OF 330, 500, FALSE, `the member did not die of war service`, FALSE, FALSE, 0) EQUALS (`Gratuity position` OF 12, 5, 975/10, TRUE)

-- scenario 9 360 overseas days
#ASSERT `the gratuity position for` (`Gratuity case` OF 360, 500, FALSE, `the member did not die of war service`, FALSE, FALSE, 0) EQUALS (`Gratuity position` OF 12, 5, 975/10, TRUE)

-- scenario 10 361 overseas days
#ASSERT `the gratuity position for` (`Gratuity case` OF 361, 500, FALSE, `the member did not die of war service`, FALSE, FALSE, 0) EQUALS (`Gratuity position` OF 13, 4, 1035/10, TRUE)

-- scenario 11 died overseas
#ASSERT `the gratuity position for` (`Gratuity case` OF 360, 500, FALSE, `died of war service while in overseas qualifying service`, FALSE, FALSE, 0) EQUALS (`Gratuity position` OF 12, 5, 150, TRUE)

-- scenario 12 died in general service
#ASSERT `the gratuity position for` (`Gratuity case` OF 0, 300, FALSE, `died of war service while in other general qualifying service`, FALSE, FALSE, 0) EQUALS (`Gratuity position` OF 0, 10, 255/10, TRUE)

-- scenario 13 total dependency floor
#ASSERT `the gratuity position for` (`Gratuity case` OF 0, 300, FALSE, `died of war service while in other general qualifying service`, TRUE, FALSE, 0) EQUALS (`Gratuity position` OF 0, 10, 270, TRUE)

-- scenario 14 above floor
#ASSERT `the gratuity position for` (`Gratuity case` OF 1500, 1800, FALSE, `died of war service while in overseas qualifying service`, TRUE, FALSE, 0) EQUALS (`Gratuity position` OF 50, 10, 4425/10, TRUE)

-- scenario 15 no general service, total dependency
#ASSERT `the gratuity position for` (`Gratuity case` OF 0, 0, FALSE, `died of war service while in other general qualifying service`, TRUE, FALSE, 0) EQUALS (`Gratuity position` OF 0, 0, 270, TRUE)

-- scenario 17 debts 20
#ASSERT `the gratuity position for` (`Gratuity case` OF 90, 400, FALSE, `the member did not die of war service`, FALSE, FALSE, 20) EQUALS (`Gratuity position` OF 12, 2, 73, TRUE)

-- scenario 18 debts 200
#ASSERT `the gratuity position for` (`Gratuity case` OF 90, 400, FALSE, `the member did not die of war service`, FALSE, FALSE, 200) EQUALS (`Gratuity position` OF 12, 2, 0, TRUE)

-- scenario 19 general months floored at nil
#ASSERT `the gratuity position for` (`Gratuity case` OF 30, 60, FALSE, `the member did not die of war service`, FALSE, FALSE, 0) EQUALS (`Gratuity position` OF 12, 0, 90, TRUE)

-- scenario 16 disqualified class: nothing credited
#ASSERT (`the gratuity position for` (`Gratuity case` OF 90, 400, FALSE, `the member did not die of war service`, FALSE, TRUE, 0))'s `the war gratuity in dollars` EQUALS 0
