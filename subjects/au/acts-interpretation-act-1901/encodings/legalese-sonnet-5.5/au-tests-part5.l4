IMPORT prelude
IMPORT daydate
IMPORT `au-interpretation-time`
IMPORT `au-part5-interpretation`

-- Tests for Part 5. Expected values are written from the text.

§ `Section 13`

-- (1) and (2): sections and Schedules, the long title, a Preamble, the enacting words, and headings before the first section are part of the Act.
#ASSERT `is part of the Act` `a section of the Act, or a Schedule to it, from the first section to the end of the last section or Schedule` FALSE FALSE FALSE
#ASSERT `is part of the Act` `the long title` FALSE FALSE FALSE
#ASSERT `is part of the Act` `a Preamble` FALSE FALSE FALSE
#ASSERT `is part of the Act` `the enacting words` FALSE FALSE FALSE
#ASSERT `is part of the Act` `a heading to a Chapter, Part, Division or Subdivision appearing before the first section` FALSE FALSE FALSE
#ASSERT NOT (`is part of the Act` `any other material` FALSE FALSE FALSE)
-- (3): alt text (only indicates the effect AND accessible electronically AND not in the printed text) is not part of the Act.
#ASSERT NOT (`is part of the Act` `a section of the Act, or a Schedule to it, from the first section to the end of the last section or Schedule` TRUE TRUE TRUE)
-- ... but each of the three is needed to take it out.
#ASSERT `is part of the Act` `a section of the Act, or a Schedule to it, from the first section to the end of the last section or Schedule` TRUE TRUE FALSE
#ASSERT `is part of the Act` `a section of the Act, or a Schedule to it, from the first section to the end of the last section or Schedule` TRUE FALSE TRUE
#ASSERT `is part of the Act` `a section of the Act, or a Schedule to it, from the first section to the end of the last section or Schedule` FALSE TRUE TRUE

§ `Section 15AB(1)`

#ASSERT `consideration may be given to the material` TRUE TRUE FALSE FALSE
#ASSERT `consideration may be given to the material` TRUE FALSE TRUE FALSE
#ASSERT `consideration may be given to the material` TRUE FALSE FALSE TRUE
#ASSERT NOT (`consideration may be given to the material` TRUE FALSE FALSE FALSE)
#ASSERT NOT (`consideration may be given to the material` FALSE TRUE TRUE TRUE)

§ `Section 15B`

#ASSERT `is in the coastal sea of Australia` TRUE FALSE
#ASSERT `is in the coastal sea of Australia` FALSE TRUE
#ASSERT NOT (`is in the coastal sea of Australia` FALSE FALSE)
#ASSERT `an Act is taken to have effect there as if it were part of Australia` TRUE
#ASSERT NOT (`an Act is taken to have effect there as if it were part of Australia` FALSE)

§ `Section 15C`

#ASSERT `the jurisdiction the provision vests in the court` TRUE FALSE EQUALS `vested, and not limited by any limits to which the court's other jurisdiction is subject`
#ASSERT `the jurisdiction the provision vests in the court` TRUE TRUE EQUALS `vested, so far only as the Constitution permits (a court of a Territory)`
#ASSERT `the jurisdiction the provision vests in the court` FALSE FALSE EQUALS `none vested by section 15C`

§ `Section 18B`

-- Chosen title.
#ASSERT `the person may be referred to by this chair title` TRUE TRUE FALSE FALSE
-- No choice: the title the person addressing them considers appropriate.
#ASSERT `the person may be referred to by this chair title` TRUE FALSE TRUE TRUE
#ASSERT NOT (`the person may be referred to by this chair title` TRUE FALSE TRUE FALSE)
-- Not an office established by an Act with a chair title.
#ASSERT NOT (`the person may be referred to by this chair title` FALSE TRUE FALSE FALSE)

§ `Sections 25A to 25D`

#ASSERT `the requirement is complied with` TRUE TRUE FALSE TRUE
#ASSERT NOT (`the requirement is complied with` TRUE TRUE TRUE TRUE)
#ASSERT NOT (`the requirement is complied with` TRUE TRUE FALSE FALSE)
#ASSERT NOT (`the requirement is complied with` FALSE TRUE FALSE TRUE)
#ASSERT `a reference to the former name is read as a reference to the new name` FALSE
#ASSERT NOT (`a reference to the former name is read as a reference to the new name` TRUE)
#ASSERT NOT (`an alteration of the constitution of a body affects its identity, functions, powers, property, rights, liabilities or obligations, or pending proceedings, investigations or inquiries`)
#ASSERT `the form requirement is met` TRUE TRUE
#ASSERT NOT (`the form requirement is met` TRUE FALSE)
#ASSERT NOT (`the form requirement is met` FALSE TRUE)
#ASSERT `the written reasons are complete` TRUE TRUE TRUE
#ASSERT NOT (`the written reasons are complete` TRUE TRUE FALSE)
#ASSERT NOT (`the written reasons are complete` TRUE FALSE TRUE)
#ASSERT NOT (`the written reasons are complete` FALSE TRUE TRUE)
