IMPORT prelude
IMPORT daydate
IMPORT `au-interpretation-time`
IMPORT `au-part8-distance`

-- Tests for s 35. Expected values are written by hand (a 3-4-5 right triangle).

#ASSERT `the distance for the purposes of an Act` 0 0 3 4 EQUALS 5
-- Direction does not matter.
#ASSERT `the distance for the purposes of an Act` 3 4 0 0 EQUALS 5
-- Two points on the same east line.
#ASSERT `the distance for the purposes of an Act` 10 2 10 9 EQUALS 7
-- The same point: distance zero.
#ASSERT `the distance for the purposes of an Act` 5 5 5 5 EQUALS 0
-- Negative coordinates: (-3, -4) to (0, 0) is 5.
#ASSERT `the distance for the purposes of an Act` (0 MINUS 3) (0 MINUS 4) 0 0 EQUALS 5
