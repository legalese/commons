IMPORT prelude
IMPORT daydate
IMPORT `au-interpretation-time`
IMPORT `au-part2-definitions`

-- Tests for Part 2 (the time words are tested in au-tests-time.l4). Expected values are
-- written from the text.

§ `Section 2B: places`

-- Australia, in a geographical sense, includes Norfolk Island, Christmas Island and the
-- Cocos (Keeling) Islands, but not any other external Territory.
#ASSERT `is within Australia in a geographical sense` `Norfolk Island`
#ASSERT `is within Australia in a geographical sense` `the Territory of Christmas Island`
#ASSERT `is within Australia in a geographical sense` `the Territory of Cocos (Keeling) Islands`
#ASSERT NOT (`is within Australia in a geographical sense` `another external Territory`)
#ASSERT `is within Australia in a geographical sense` `a State`
#ASSERT `is within Australia in a geographical sense` `an internal Territory`
#ASSERT NOT (`is within Australia in a geographical sense` `a place outside Australia and the external Territories`)
-- An external Territory is a Territory, other than an internal Territory, where an Act provides for its government as a Territory.
#ASSERT `is an external Territory` `Norfolk Island` TRUE
#ASSERT NOT (`is an external Territory` `Norfolk Island` FALSE)
#ASSERT NOT (`is an external Territory` `an internal Territory` TRUE)
#ASSERT NOT (`is an external Territory` `a State` TRUE)
-- A foreign country is outside Australia and the external Territories.
#ASSERT `is a foreign country` `a place outside Australia and the external Territories`
#ASSERT NOT (`is a foreign country` `Norfolk Island`)
#ASSERT NOT (`is a foreign country` `a State`)

§ `Section 2B: document, contravene, prescribed, Proclamation, Senior Counsel`

-- document: any record of information, and includes (a) writing, (b) marks, figures, symbols or perforations having a meaning, (c) things from which sounds, images or writings can be reproduced, (d) a map, plan, drawing or photograph.
#ASSERT `is a document` TRUE FALSE FALSE FALSE FALSE
#ASSERT `is a document` FALSE TRUE FALSE FALSE FALSE
#ASSERT `is a document` FALSE FALSE TRUE FALSE FALSE
#ASSERT `is a document` FALSE FALSE FALSE TRUE FALSE
#ASSERT `is a document` FALSE FALSE FALSE FALSE TRUE
#ASSERT NOT (`is a document` FALSE FALSE FALSE FALSE FALSE)
-- contravene includes fail to comply with.
#ASSERT `the person contravenes the provision` TRUE FALSE
#ASSERT `the person contravenes the provision` FALSE TRUE
#ASSERT NOT (`the person contravenes the provision` FALSE FALSE)
-- prescribed: by the Act or by regulations under the Act.
#ASSERT `is prescribed` TRUE FALSE
#ASSERT `is prescribed` FALSE TRUE
#ASSERT NOT (`is prescribed` FALSE FALSE)
-- Proclamation: by the Governor-General, registered as a legislative instrument or a notifiable instrument.
#ASSERT `is a Proclamation` TRUE TRUE FALSE
#ASSERT `is a Proclamation` TRUE FALSE TRUE
#ASSERT NOT (`is a Proclamation` TRUE FALSE FALSE)
#ASSERT NOT (`is a Proclamation` FALSE TRUE TRUE)
-- Senior Counsel includes King's Counsel if the Sovereign is a King, Queen's Counsel if a Queen.
#ASSERT `is Senior Counsel` FALSE TRUE FALSE
#ASSERT `is Senior Counsel` FALSE FALSE TRUE
#ASSERT `is Senior Counsel` TRUE FALSE FALSE
#ASSERT NOT (`is Senior Counsel` FALSE FALSE FALSE)

§ `Sections 2C to 2F`

-- 2C: persons generally include a body politic or corporate as well as an individual.
#ASSERT `is included in an expression denoting persons generally` `an individual`
#ASSERT `is included in an expression denoting persons generally` `a body politic`
#ASSERT `is included in an expression denoting persons generally` `a body corporate`
-- 2CA: legally married.
#ASSERT `is the spouse of the other person` TRUE
#ASSERT NOT (`is the spouse of the other person` FALSE)
-- 2F(6): related by family: child (adopted included), other descendant, or a parent in common.
#ASSERT `are related by family` TRUE FALSE FALSE
#ASSERT `are related by family` FALSE TRUE FALSE
#ASSERT `are related by family` FALSE FALSE TRUE
#ASSERT NOT (`are related by family` FALSE FALSE FALSE)
-- 2F(1) and (4): not married to each other, not related, a couple, living together (or apart only because of absence or illness).
#ASSERT `are in a de facto relationship` FALSE FALSE TRUE TRUE FALSE
#ASSERT `are in a de facto relationship` FALSE FALSE TRUE FALSE TRUE
#ASSERT NOT (`are in a de facto relationship` FALSE FALSE TRUE FALSE FALSE)
#ASSERT NOT (`are in a de facto relationship` TRUE FALSE TRUE TRUE FALSE)
#ASSERT NOT (`are in a de facto relationship` FALSE TRUE TRUE TRUE FALSE)
#ASSERT NOT (`are in a de facto relationship` FALSE FALSE FALSE TRUE FALSE)
-- 2E and 2D.
#ASSERT `are in a registered relationship` TRUE
#ASSERT NOT (`are in a registered relationship` FALSE)
#ASSERT `are de facto partners` TRUE FALSE
#ASSERT `are de facto partners` FALSE TRUE
#ASSERT NOT (`are de facto partners` FALSE FALSE)

§ `Sections 2H, 2J, 2K`

-- 2H: a law in force in a Territory only because of an Act providing for its acceptance, administration or government is not a law of the Commonwealth.
#ASSERT NOT (`is a law of the Commonwealth, apart from the Territory exclusion` TRUE TRUE)
#ASSERT `is a law of the Commonwealth, apart from the Territory exclusion` TRUE FALSE
#ASSERT `is a law of the Commonwealth, apart from the Territory exclusion` FALSE FALSE
-- 2J.
#ASSERT `the reference is taken to include the document` TRUE TRUE
#ASSERT NOT (`the reference is taken to include the document` TRUE FALSE)
#ASSERT NOT (`the reference is taken to include the document` FALSE TRUE)
-- 2K.
#ASSERT `are rules of court` TRUE
#ASSERT NOT (`are rules of court` FALSE)
