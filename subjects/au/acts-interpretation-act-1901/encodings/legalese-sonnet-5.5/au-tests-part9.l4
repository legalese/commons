IMPORT prelude
IMPORT daydate
IMPORT `au-interpretation-time`
IMPORT `au-part9-citation`

-- Tests for Part 9. Expected values are written from the text.

§ `Section 38`

#ASSERT `the term by which an Act of this body may be referred to` `the Parliament of the Commonwealth` EQUALS "Act"
#ASSERT `the term by which an Act of this body may be referred to` `the Parliament of the United Kingdom` EQUALS "Imperial Act"
#ASSERT `the term by which an Act of this body may be referred to` `the Parliament of a State` EQUALS "State Act"
#ASSERT `the term by which an Act of this body may be referred to` `the legislature of a Territory` EQUALS "Territory Act"

§ `Section 39`

-- The first Act of a year is number 1; the fifth is number 5.
#ASSERT `the number given to the Act` 0 EQUALS 1
#ASSERT `the number given to the Act` 4 EQUALS 5

§ `Section 40(1A), (1), (2)`

-- A Commonwealth Act: short title, year and number, unique identifier; not the Gazette.
#ASSERT `it may be cited this way in an Act, instrument or document` `a Commonwealth Act` `its short title` FALSE FALSE FALSE
#ASSERT `it may be cited this way in an Act, instrument or document` `a Commonwealth Act` `the secular year in which it was passed, and its number` FALSE FALSE FALSE
#ASSERT `it may be cited this way in an Act, instrument or document` `a Commonwealth Act` `a unique identifier given in accordance with rules prescribed under the Legislation Act 2003` FALSE FALSE FALSE
#ASSERT NOT (`it may be cited this way in an Act, instrument or document` `a Commonwealth Act` `the date and, if necessary, number and page of the Gazette in which it was notified or published` FALSE FALSE TRUE)
#ASSERT NOT (`it may be cited this way in an Act, instrument or document` `a Commonwealth Act` `any name the instrument gives itself` FALSE FALSE FALSE)
-- A legislative or notifiable instrument.
#ASSERT `it may be cited this way in an Act, instrument or document` `a legislative instrument or notifiable instrument` `any name the instrument gives itself` FALSE FALSE FALSE
#ASSERT `it may be cited this way in an Act, instrument or document` `a legislative instrument or notifiable instrument` `a unique identifier given in accordance with rules prescribed under the Legislation Act 2003` FALSE FALSE FALSE
#ASSERT `it may be cited this way in an Act, instrument or document` `a legislative instrument or notifiable instrument` `the date it was made, with a reference to the Act or instrument, and provision if necessary, under which it was made` FALSE FALSE FALSE
-- Year and number: only if it was numbered under a Commonwealth law.
#ASSERT `it may be cited this way in an Act, instrument or document` `a legislative instrument or notifiable instrument` `the year it was made and its number, with a reference to the kind of instrument if necessary` FALSE TRUE FALSE
#ASSERT NOT (`it may be cited this way in an Act, instrument or document` `a legislative instrument or notifiable instrument` `the year it was made and its number, with a reference to the kind of instrument if necessary` FALSE FALSE FALSE)
-- Gazette: only if it was notified or published in the Gazette.
#ASSERT `it may be cited this way in an Act, instrument or document` `a legislative instrument or notifiable instrument` `the date and, if necessary, number and page of the Gazette in which it was notified or published` FALSE FALSE TRUE
#ASSERT NOT (`it may be cited this way in an Act, instrument or document` `a legislative instrument or notifiable instrument` `the date and, if necessary, number and page of the Gazette in which it was notified or published` FALSE FALSE FALSE)
-- Short title is for Acts, not instruments.
#ASSERT NOT (`it may be cited this way in an Act, instrument or document` `a legislative instrument or notifiable instrument` `its short title` TRUE TRUE TRUE)
-- Imperial Act: short title (if any), or another manner sufficient in an Imperial Act.
#ASSERT `it may be cited this way in an Act, instrument or document` `an Imperial Act` `its short title` TRUE FALSE FALSE
#ASSERT NOT (`it may be cited this way in an Act, instrument or document` `an Imperial Act` `its short title` FALSE FALSE FALSE)
#ASSERT `it may be cited this way in an Act, instrument or document` `an Imperial Act` `another manner sufficient in an Imperial Act` FALSE FALSE FALSE
-- State and Territory Acts.
#ASSERT `it may be cited this way in an Act, instrument or document` `a State Act` `a reference to the State or Territory whose Parliament or legislature passed it, with a mode of reference sufficient in Acts of that Parliament or legislature` FALSE FALSE FALSE
#ASSERT `it may be cited this way in an Act, instrument or document` `a Territory Act` `a reference to the State or Territory whose Parliament or legislature passed it, with a mode of reference sufficient in Acts of that Parliament or legislature` FALSE FALSE FALSE
#ASSERT NOT (`it may be cited this way in an Act, instrument or document` `a State Act` `its short title` TRUE FALSE FALSE)
-- (2): any enactment may be cited by its division.
#ASSERT `it may be cited this way in an Act, instrument or document` `a State Act` `a reference to the part, section, subsection or other division in which the enactment is contained` FALSE FALSE FALSE
#ASSERT `it may be cited this way in an Act, instrument or document` `a Commonwealth Act` `a reference to the part, section, subsection or other division in which the enactment is contained` FALSE FALSE FALSE
#ASSERT `it may be cited this way in an Act, instrument or document` `an Imperial Act` `a reference to the part, section, subsection or other division in which the enactment is contained` FALSE FALSE FALSE
#ASSERT `it may be cited this way in an Act, instrument or document` `a legislative instrument or notifiable instrument` `a reference to the part, section, subsection or other division in which the enactment is contained` FALSE FALSE FALSE

§ `Section 40A`

#ASSERT `the reference is taken to include the corresponding old provision and any relevant earlier law` TRUE FALSE FALSE FALSE FALSE FALSE FALSE
-- Each exclusion in (2)(a) to (d), the contrary provision in (3)(a), and the regulations in (3)(b) and (5).
#ASSERT NOT (`the reference is taken to include the corresponding old provision and any relevant earlier law` TRUE TRUE FALSE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`the reference is taken to include the corresponding old provision and any relevant earlier law` TRUE FALSE TRUE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`the reference is taken to include the corresponding old provision and any relevant earlier law` TRUE FALSE FALSE TRUE FALSE FALSE FALSE)
#ASSERT NOT (`the reference is taken to include the corresponding old provision and any relevant earlier law` TRUE FALSE FALSE FALSE TRUE FALSE FALSE)
#ASSERT NOT (`the reference is taken to include the corresponding old provision and any relevant earlier law` TRUE FALSE FALSE FALSE FALSE TRUE FALSE)
#ASSERT NOT (`the reference is taken to include the corresponding old provision and any relevant earlier law` TRUE FALSE FALSE FALSE FALSE FALSE TRUE)
-- Not a reference to the new legislation at all.
#ASSERT NOT (`the reference is taken to include the corresponding old provision and any relevant earlier law` FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
