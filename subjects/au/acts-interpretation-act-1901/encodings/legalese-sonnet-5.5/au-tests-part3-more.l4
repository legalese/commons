IMPORT prelude
IMPORT `au-part3-more`

-- Tests for s 4(3) and (6). Expected values are written from the text.

§ `Section 4(3)`

-- Section 4 applies (enacted; confers the power at the start time; the Act will commence then): a thing done to enable the exercise may be done early.
#ASSERT `anything may be done before the start time` TRUE TRUE TRUE FALSE TRUE
-- Applies by the other route (amended at the start time).
#ASSERT `anything may be done before the start time` TRUE TRUE FALSE TRUE TRUE
-- Not done for the purpose of enabling the exercise of the power or bringing the appointment or instrument into effect.
#ASSERT NOT (`anything may be done before the start time` TRUE TRUE TRUE FALSE FALSE)
-- Section 4 does not apply: the Act is not enacted, or confers no power then, or neither commences nor is amended then.
#ASSERT NOT (`anything may be done before the start time` FALSE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`anything may be done before the start time` TRUE FALSE TRUE FALSE TRUE)
#ASSERT NOT (`anything may be done before the start time` TRUE TRUE FALSE FALSE TRUE)

§ `Section 4(6)`

-- A single instrument made before the start time, partly under (2) and partly under a power already conferred.
#ASSERT `a single instrument may be made partly under subsection (2) and partly under an existing power` TRUE TRUE TRUE FALSE TRUE TRUE TRUE
#ASSERT `a single instrument may be made partly under subsection (2) and partly under an existing power` TRUE TRUE FALSE TRUE TRUE TRUE TRUE
-- Not made before the start time.
#ASSERT NOT (`a single instrument may be made partly under subsection (2) and partly under an existing power` TRUE TRUE TRUE FALSE FALSE TRUE TRUE)
-- Only one of the two powers is used.
#ASSERT NOT (`a single instrument may be made partly under subsection (2) and partly under an existing power` TRUE TRUE TRUE FALSE TRUE TRUE FALSE)
#ASSERT NOT (`a single instrument may be made partly under subsection (2) and partly under an existing power` TRUE TRUE TRUE FALSE TRUE FALSE TRUE)
-- Section 4 does not apply.
#ASSERT NOT (`a single instrument may be made partly under subsection (2) and partly under an existing power` TRUE FALSE TRUE FALSE TRUE TRUE TRUE)
