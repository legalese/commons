#ASSERT `the last day on which the thing may be done` TRUE (Date 24 1 2026) (`Days of closure` OF (LIST (Date 26 1 2026)), (LIST)) EQUALS Date 27 1 2026
-- Scenario 550 (s 36(2)): last day Good Friday 2026-04-03, Easter Monday 06th also a holiday -> Tuesday 07th
#ASSERT `the last day on which the thing may be done` TRUE (Date 3 4 2026) (`Days of closure` OF (LIST (Date 3 4 2026), (Date 6 4 2026)), (LIST)) EQUALS Date 7 4 2026
-- Scenario 551 (s 36(2)): last day an ordinary Wednesday -> unchanged
#ASSERT `the last day on which the thing may be done` TRUE (Date 1 7 2026) `no closures` EQUALS Date 1 7 2026
-- Scenario 552 (s 36(2) Example): due Saturday 2018-03-31 -> Monday 2018-04-02
#ASSERT `the last day on which the thing may be done` TRUE (Date 31 3 2018) `no closures` EQUALS Date 2 4 2018
-- Scenario 553 (s 36(2)(a)): a thing required by a contract (not an Act) falls due Saturday: no extension
#ASSERT `the last day on which the thing may be done` FALSE (Date 31 1 2026) `no closures` EQUALS Date 31 1 2026
-- Scenario 554 (s 36(2), Example 3): a licence that continues until Saturday 2018-03-31 is not extended
#ASSERT `the last day on which the thing may be done` FALSE (Date 31 3 2018) `no closures` EQUALS Date 31 3 2018
-- Scenario 555 (s 36(3)(a)): a public holiday in the place is a holiday
#ASSERT `is a holiday for the time for doing a thing` (Date 26 1 2026) (`Days of closure` OF (LIST (Date 26 1 2026)), (LIST)) EQUALS TRUE
-- Scenario 556 (s 36(3)(a)): a public holiday only in a different place is not a holiday here
#ASSERT `is a holiday for the time for doing a thing` (Date 26 1 2026) `no closures` EQUALS FALSE
-- Scenario 557 (s 36(3)(b)): office closed for the whole of a weekday is a holiday
#ASSERT `is a holiday for the time for doing a thing` (Date 2 7 2026) (`Days of closure` OF (LIST), (LIST (Date 2 7 2026))) EQUALS TRUE
-- Scenario 558 (s 36(3)(b)): office closed only for the afternoon is not a holiday
#ASSERT `is a holiday for the time for doing a thing` (Date 2 7 2026) `no closures` EQUALS FALSE
-- Scenario 559 (s 36(2) with (3)(b)): Thursday closed all day -> next day Friday
#ASSERT `the first day from` (Date 2 7 2026) `that is not a Saturday, a Sunday or a holiday, given` (`Days of closure` OF (LIST), (LIST (Date 2 7 2026))) EQUALS Date 3 7 2026
