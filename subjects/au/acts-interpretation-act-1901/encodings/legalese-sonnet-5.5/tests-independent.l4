#ASSERT `the moment a person attains the age` (Date 1 1 2000) 18 EQUALS JUST (`Moment in a day` OF (Date 1 1 2018), 0, 0, 0)
-- Scenario 564 (s 37A): born 2000-06-15 (any time of day) attains 18 at the start of 2018-06-15
#ASSERT `the moment a person attains the age` (Date 15 6 2000) 18 EQUALS JUST (`Moment in a day` OF (Date 15 6 2018), 0, 0, 0)
-- Scenario 566 (s 37A): born 2000-02-29 attains 4 at the start of 2004-02-29
#ASSERT `the moment a person attains the age` (Date 29 2 2000) 4 EQUALS JUST (`Moment in a day` OF (Date 29 2 2004), 0, 0, 0)
-- Scenario 567 (s 37A): born 2000-02-29, age 18 (2018 not a leap year) -> NOT COVERED
#ASSERT `the moment a person attains the age` (Date 29 2 2000) 18 EQUALS NOTHING

-- ===== PART 9: citation =====
-- Scenario 569 (s 38(1)): a Commonwealth Act may be referred to as "Act"
#ASSERT `the term by which an Act of this body may be referred to` `the Parliament of the Commonwealth` EQUALS "Act"
-- Scenario 570 (s 38(2)): a UK Act as "Imperial Act"
#ASSERT `the term by which an Act of this body may be referred to` `the Parliament of the United Kingdom` EQUALS "Imperial Act"
-- Scenario 571 (s 38(3)): a State Act
#ASSERT `the term by which an Act of this body may be referred to` `the Parliament of a State` EQUALS "State Act"
-- Scenario 572 (s 38(4)): a Territory Act
#ASSERT `the term by which an Act of this body may be referred to` `the legislature of a Territory` EQUALS "Territory Act"
-- Scenario 573 (s 38(3)): a UK Act may not be referred to as a "State Act"
#ASSERT NOT (`the term by which an Act of this body may be referred to` `the Parliament of the United Kingdom` EQUALS "State Act") EQUALS TRUE
-- Scenario 575 (s 39): the second Act assented to in the year (one earlier) is No 2
#ASSERT `the number given to the Act` 1 EQUALS 2
-- Scenario 576 (s 39): the first Act of a secular year is No 1
#ASSERT `the number given to the Act` 0 EQUALS 1
-- Scenario 577 (s 40(1A)(a)(i)): an Act cited by its short title
#ASSERT `it may be cited this way in an Act, instrument or document` `a Commonwealth Act` `its short title` TRUE FALSE FALSE EQUALS TRUE
-- Scenario 578 (s 40(1A)(a)(ii)): by year and number
#ASSERT `it may be cited this way in an Act, instrument or document` `a Commonwealth Act` `the secular year in which it was passed, and its number` TRUE FALSE FALSE EQUALS TRUE
-- Scenario 579 (s 40(1A)(b)(i)): a legislative instrument by any name it gives itself
#ASSERT `it may be cited this way in an Act, instrument or document` `a legislative instrument or notifiable instrument` `any name the instrument gives itself` FALSE FALSE FALSE EQUALS TRUE
-- Scenario 580 (s 40(1A)(b)(iii)): by year made and number, if numbered under a Commonwealth law
#ASSERT `it may be cited this way in an Act, instrument or document` `a legislative instrument or notifiable instrument` `the year it was made and its number, with a reference to the kind of instrument if necessary` FALSE TRUE FALSE EQUALS TRUE
-- Scenario 581 (s 40(1A)(b)(iii)): ... not if it was not so numbered
#ASSERT `it may be cited this way in an Act, instrument or document` `a legislative instrument or notifiable instrument` `the year it was made and its number, with a reference to the kind of instrument if necessary` FALSE FALSE FALSE EQUALS FALSE
-- Scenario 582 (s 40(1A)(b)(v)): by the date made with the Act under which it was made
#ASSERT `it may be cited this way in an Act, instrument or document` `a legislative instrument or notifiable instrument` `the date it was made, with a reference to the Act or instrument, and provision if necessary, under which it was made` FALSE FALSE FALSE EQUALS TRUE
-- Scenario 583 (s 40(1A)(a)): an Act may not be cited by the date made with the Act under which made
#ASSERT `it may be cited this way in an Act, instrument or document` `a Commonwealth Act` `the date it was made, with a reference to the Act or instrument, and provision if necessary, under which it was made` TRUE FALSE FALSE EQUALS FALSE
-- Scenario 584 (s 40(1)(b)): an Imperial Act by its short title (if any)
#ASSERT `it may be cited this way in an Act, instrument or document` `an Imperial Act` `its short title` TRUE FALSE FALSE EQUALS TRUE
-- Scenario 585 (s 40(1)(c)): a State Act by a reference to the State with a sufficient mode of reference
#ASSERT `it may be cited this way in an Act, instrument or document` `a State Act` `a reference to the State or Territory whose Parliament or legislature passed it, with a mode of reference sufficient in Acts of that Parliament or legislature` TRUE FALSE FALSE EQUALS TRUE
-- Scenario 586 (s 40(1)(c)): a State Act by its short title alone
#ASSERT `it may be cited this way in an Act, instrument or document` `a State Act` `its short title` TRUE FALSE FALSE EQUALS FALSE
-- Scenario 587 (s 40(2)): any enactment by reference to a section
#ASSERT `it may be cited this way in an Act, instrument or document` `a State Act` `a reference to the part, section, subsection or other division in which the enactment is contained` TRUE FALSE FALSE EQUALS TRUE
-- Scenario 588 (s 40A(1)): a reference to a new-corporations-legislation provision includes the old provision
#ASSERT `the reference is taken to include the corresponding old provision and any relevant earlier law` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS TRUE
-- Scenario 589 (s 40A(1)(d)): ... and any relevant earlier law (same rule)
#ASSERT `the reference is taken to include the corresponding old provision and any relevant earlier law` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS TRUE
-- Scenario 590 (s 40A(2)(a)): reference in an Act that is part of the new legislation
#ASSERT `the reference is taken to include the corresponding old provision and any relevant earlier law` TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS FALSE
-- Scenario 591 (s 40A(2)(b)): reference in the Corporations (Repeals, Consequentials and Transitionals) Act 2001
#ASSERT `the reference is taken to include the corresponding old provision and any relevant earlier law` TRUE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS FALSE
-- Scenario 592 (s 40A(2)(c)): identifies the Act as an Act to be amended
#ASSERT `the reference is taken to include the corresponding old provision and any relevant earlier law` TRUE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS FALSE
-- Scenario 593 (s 40A(3)(a)): express provision to the contrary
#ASSERT `the reference is taken to include the corresponding old provision and any relevant earlier law` TRUE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS FALSE
-- Scenario 594 (s 40A(5)): regulations exclude this class of references
#ASSERT `the reference is taken to include the corresponding old provision and any relevant earlier law` TRUE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS FALSE
-- Scenario 595 (s 40A(4)): correspondence decided by Part 10.1 of the Corporations Act 2001 (a pointer; not decided here)
#ASSERT `the Part that decides whether a provision of the old legislation corresponds to one of the new` `the old corporations legislation` EQUALS "Part 10.1 of the Corporations Act 2001"

-- ===== PART 10: instruments; PART 11: regulations =====
-- Scenario 596 (s 46(1)(a)): administrative instrument -> this Act applies as if it were an Act
#ASSERT `this Act applies to the instrument as if it were an Act and each of its provisions a section of an Act` TRUE FALSE FALSE FALSE EQUALS TRUE
-- Scenario 597 (s 46(1)): a legislative instrument -> s 46 does not apply
#ASSERT `this Act applies to the instrument as if it were an Act and each of its provisions a section of an Act` TRUE TRUE FALSE FALSE EQUALS FALSE
-- Scenario 598 (s 46(1)): a rule of court -> s 46 does not apply
#ASSERT `this Act applies to the instrument as if it were an Act and each of its provisions a section of an Act` TRUE FALSE FALSE TRUE EQUALS FALSE
-- Scenario 601 (s 46(2)): the part within the power is valid
#ASSERT `this part of the instrument is valid` TRUE TRUE EQUALS JUST TRUE
-- Scenario 601b (s 46(2)): the part in excess of the power is not valid
#ASSERT `this part of the instrument is valid` TRUE FALSE EQUALS JUST FALSE
-- Scenario 602 (s 46(3)): an Act's amendment of the instrument does not prevent the authority amending or repealing it
#ASSERT `an amendment of the instrument by an Act prevents the authority from later amending or repealing it` FALSE EQUALS JUST FALSE
-- Scenario 603 (s 46AA(1)(a)(i)): an Act as in force from time to time
#ASSERT `the instrument may apply, adopt or incorporate the matter at this time` `the provisions of an Act` `as in force from time to time` TRUE FALSE EQUALS JUST TRUE
-- Scenario 604 (s 46AA(1)(a)(ii), (3)(a)): a disallowable legislative instrument as in force from time to time
#ASSERT `the instrument may apply, adopt or incorporate the matter at this time` `the provisions of a legislative instrument that is disallowable within the meaning of the Legislation Act 2003` `as in force from time to time` TRUE FALSE EQUALS JUST TRUE
-- Scenario 605 (s 46AA(3)(b)): a legislative instrument disallowable before 2005-01-01
#ASSERT `the instrument may apply, adopt or incorporate the matter at this time` `the provisions of a legislative instrument that was disallowable under this or any other Act at some time before 1 January 2005` `as in force from time to time` TRUE FALSE EQUALS JUST TRUE
-- Scenario 606 (s 46AA(1)(b), (2)): a legislative instrument never disallowable, as in force from time to time
#ASSERT `the instrument may apply, adopt or incorporate the matter at this time` `a matter contained in any other instrument or writing` `as in force from time to time` TRUE FALSE EQUALS JUST FALSE
-- Scenario 607 (s 46AA(1)(a)(iii)): rules of court as in force from time to time
#ASSERT `the instrument may apply, adopt or incorporate the matter at this time` `the provisions of rules of court` `as in force from time to time` TRUE FALSE EQUALS JUST TRUE
-- Scenario 608 (s 46AA(1)(b)(i)): another writing as in force when the instrument commences
#ASSERT `the instrument may apply, adopt or incorporate the matter at this time` `a matter contained in any other instrument or writing` `as in force or existing when the instrument commences` TRUE FALSE EQUALS JUST TRUE
-- Scenario 609 (s 46AA(1)(b)(ii)): another writing as at a time before commencement, though it no longer exists
#ASSERT `the instrument may apply, adopt or incorporate the matter at this time` `a matter contained in any other instrument or writing` `as in force or existing at a time before the instrument commences` TRUE FALSE EQUALS JUST TRUE
-- Scenario 610 (s 46AA(2)): another writing as in force from time to time
#ASSERT `the instrument may apply, adopt or incorporate the matter at this time` `a matter contained in any other instrument or writing` `as in force from time to time` TRUE FALSE EQUALS JUST FALSE
-- Scenario 611 (s 46AA(4)): the provision concerns a form -> s 46AA does not restrict it
#ASSERT `the instrument may apply, adopt or incorporate the matter at this time` `a matter contained in any other instrument or writing` `as in force from time to time` TRUE TRUE EQUALS NOTHING
-- Scenario 612 (s 47): a resolution in purported pursuance of an Act, valid to the extent within authority
#ASSERT `this part of the resolution is valid` TRUE TRUE EQUALS JUST TRUE
-- Scenario 613 (s 47): a resolution not passed in purported pursuance of an Act
#ASSERT `this part of the resolution is valid` FALSE TRUE EQUALS NOTHING
-- Scenario 615 (s 51(a)): a matter required or permitted by the Act to be prescribed
#ASSERT `the Governor-General may make regulations prescribing the matter` TRUE FALSE EQUALS TRUE
-- Scenario 616 (s 51(b)): a matter necessary or convenient for carrying out the Act
#ASSERT `the Governor-General may make regulations prescribing the matter` FALSE TRUE EQUALS TRUE
-- Scenario 617 (s 51): neither
#ASSERT `the Governor-General may make regulations prescribing the matter` FALSE FALSE EQUALS FALSE

-- ===== Table-membership scenarios (the terms table of au-part2-terms.l4 is addressable only by exact member string) =====
-- Scenario 35 (s 2B estate): a lien is an estate (the Act's list names "lien"; the table stores the comma-list as ONE string)
#ASSERT `section 2B names` "lien" `as covered by` `the term estate` EQUALS TRUE
-- Scenario 42 (s 2B AAO): an instrument by the Governor-General that amends a primary AAO is included
#ASSERT `section 2B names` "amends a primary AAO" `as covered by` `the term Administrative Arrangements Order` EQUALS TRUE
-- Scenario 43 (s 2B AAO): an instrument that revokes a primary AAO and substitutes a new one is included
#ASSERT `section 2B names` "revokes a primary AAO and substitutes a new primary AAO" `as covered by` `the term Administrative Arrangements Order` EQUALS TRUE
-- Scenario 61 (s 2B modifications): a substitution is a modification (the Act's list is "additions, omissions and substitutions")
#ASSERT `section 2B names` "substitutions" `as covered by` `the term modifications` EQUALS TRUE
-- Scenario 64 (s 2B record): information stored or recorded by means of a computer is a record
#ASSERT `section 2B names` "information stored or recorded by means of a computer" `as covered by` `the term record` EQUALS TRUE
-- Scenario 65 (s 2B justice of the peace): a justice of the peace for a State is included
#ASSERT `section 2B names` "a justice of the peace for a State" `as covered by` `the term justice of the peace` EQUALS TRUE

