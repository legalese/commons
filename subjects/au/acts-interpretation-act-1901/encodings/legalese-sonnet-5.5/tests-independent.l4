#ASSERT `an Act in force in an external Territory is taken to have effect in its coastal sea as if it were part of the Territory` TRUE TRUE EQUALS TRUE
-- Scenario 265 (s 15B(3)): Act not in force in the Territory
#ASSERT `an Act in force in an external Territory is taken to have effect in its coastal sea as if it were part of the Territory` FALSE TRUE EQUALS FALSE
