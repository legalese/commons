-- Scenario 179 (s 4(7)): s 4 applies to the commencement of a provision (same conditions)
#ASSERT `section 4 allows the power to be exercised before the start time` TRUE TRUE TRUE FALSE EQUALS TRUE
-- Scenario 180 (s 6): date on a Government Printer copy purporting to be the date of assent
#ASSERT `the printed date is evidence of the date of assent, and is to be judicially noticed` TRUE TRUE EQUALS TRUE
-- Scenario 181 (s 6): judicially noticed (same rule)
#ASSERT `the printed date is evidence of the date of assent, and is to be judicially noticed` TRUE TRUE EQUALS TRUE
-- Scenario 182 (s 6): a copy not printed by the Government Printer
#ASSERT `the printed date is evidence of the date of assent, and is to be judicially noticed` FALSE TRUE EQUALS FALSE

-- ===== PART 4: amendment, repeal, expiry =====
-- Scenario 183 (s 7(1)): no express revival provision -> not revived
#ASSERT `the repeal of the repealing Act or part revives the old Act or part` FALSE EQUALS FALSE
-- Scenario 184 (s 7(1)): express revival provision -> revived
#ASSERT `the repeal of the repealing Act or part revives the old Act or part` TRUE EQUALS TRUE
-- Scenario 185 (s 7(1)): part only, no express revival provision -> not revived
#ASSERT `the repeal of the repealing Act or part revives the old Act or part` FALSE EQUALS FALSE
-- Scenario 186 (s 7(2)(c)): accrued right is preserved
#ASSERT `what a repeal or amendment does to` `a right, privilege, obligation or liability acquired, accrued or incurred under it` FALSE EQUALS `it is left as it was, as if the affected Act or part had not been repealed or amended`
-- Scenario 187 (s 7(2)(d)): penalty incurred before the repeal is still imposable
#ASSERT `what a repeal or amendment does to` `a penalty, forfeiture or punishment incurred in respect of an offence committed against it` FALSE EQUALS `it is left as it was, as if the affected Act or part had not been repealed or amended`
-- Scenario 188 (s 7(2)(e)): proceeding begun before the repeal may be continued
#ASSERT `what a repeal or amendment does to` `an investigation, legal proceeding or remedy in respect of such a right, privilege, obligation, liability, penalty, forfeiture or punishment` FALSE EQUALS `it is left as it was, as if the affected Act or part had not been repealed or amended`
-- Scenario 190 (s 7(2)(b)): anything duly done is preserved
#ASSERT `what a repeal or amendment does to` `the previous operation of the affected Act or part, or anything duly done or suffered under it` FALSE EQUALS `it is left as it was, as if the affected Act or part had not been repealed or amended`
-- Scenario 191 (s 7(2)(a)): something not in force is not revived
#ASSERT `what a repeal or amendment does to` `something not in force or existing when the repeal or amendment takes effect` FALSE EQUALS `it is not revived`
-- Scenario 193 (s 7(3)(b)): expiry is treated as a repeal
#ASSERT `counts as a repeal or amendment for section 7` `the expiry, lapsing or cessation of effect of the Act or part` EQUALS TRUE
-- Scenario 194 (s 7(3)(a)): repeal by implication
#ASSERT `counts as a repeal or amendment for section 7` `a repeal or amendment effected by implication` EQUALS TRUE
-- Scenario 195 (s 7(3)(c)): limitation of effect
#ASSERT `counts as a repeal or amendment for section 7` `the abrogation or limitation of the effect of the Act or part` EQUALS TRUE
-- Scenario 196 (s 7(3)(d)): exclusion of application to a person
#ASSERT `counts as a repeal or amendment for section 7` `the exclusion of the application of the Act or part to any person, subject-matter or circumstance` EQUALS TRUE
-- Scenario 198 (s 7(2) with s 2(2)): contrary intention -> s 7(2) gives no answer
#ASSERT `what a repeal or amendment does to` `a right, privilege, obligation or liability acquired, accrued or incurred under it` TRUE EQUALS `section 7(2) gives no answer because a contrary intention appears`
-- Scenario 199 (s 10(a)): reference by short title includes the Act as amended
#ASSERT `a reference to the short title of another Act includes that Act as amended from time to time` EQUALS TRUE
-- Scenario 201 (s 10(b)): repealed and re-enacted -> includes the re-enacted Act
#ASSERT `the reference includes the re-enacted Act` TRUE EQUALS TRUE
-- Scenario 202 (s 10(c)): section 5 re-enacted as section 9 -> extends
#ASSERT `the reference to the repealed provision extends to the re-enacted provision` TRUE TRUE EQUALS TRUE
-- Scenario 205 (s 10A): reference by a State citation includes the law as amended
#ASSERT `a reference to a citation of a law of a State or Territory includes that law as originally enacted or made and as amended from time to time` EQUALS TRUE
-- Scenario 206 (s 10A(b)): State law repealed and re-made
#ASSERT `the reference includes the re-enacted or re-made law` TRUE EQUALS TRUE
-- Scenario 207 (s 10A(c)): provision re-made under a different number
#ASSERT `the reference to the repealed provision of the State or Territory law extends to the re-enacted or re-made provision` TRUE TRUE EQUALS TRUE
-- Scenario 208 (s 11): an Act may be amended in the same session
#ASSERT `an Act may be altered, amended or repealed in the same session of Parliament in which it was passed` EQUALS TRUE
-- Scenario 209 (s 11A(1)): "calendars" goes between "calendar month" and "calendar year" (letter-by-letter)
#ASSERT `the position of the inserted definition among the definitions, counting from 0` FALSE (LIST "calendar month", "calendar year") "calendars" EQUALS JUST 1
-- Scenario 210 (s 11A(1)): list not alphabetical -> still an alphabetical position (not NOTHING)
#ASSERT `the position of the inserted definition among the definitions, counting from 0` FALSE (LIST "zebra", "apple", "mango") "banana" EQUALS JUST 1
-- Scenario 211 (s 11A(1)): amending Act specifies the position -> s 11A(1) does not apply
#ASSERT `the position of the inserted definition among the definitions, counting from 0` TRUE (LIST "calendar month", "calendar year") "calendars" EQUALS NOTHING
-- Scenario 212 (s 11A(2)): alphabetical table, no position specified
#ASSERT `the position of the inserted item among the items, counting from 0` FALSE (LIST "Earth", "Venus") "Mars" EQUALS JUST 1
-- Scenario 213 (s 11A(2)(b)): the table was not alphabetical -> s 11A(2) does not decide
#ASSERT `the position of the inserted item among the items, counting from 0` FALSE (LIST "Venus", "Earth") "Mars" EQUALS NOTHING
-- Scenario 215 (s 11B(2)): non-amending provision uses a term defined in the principal Act
#ASSERT `the term has that meaning in the non-amending provision` TRUE TRUE TRUE EQUALS TRUE
-- Scenario 216 (s 11B(2)(b)): provision does not relate to an amendment of the principal Act
#ASSERT `the term has that meaning in the non-amending provision` TRUE FALSE TRUE EQUALS FALSE

-- ===== PART 5: general interpretation rules =====
-- Scenario 217 (s 12): a section has effect as a substantive enactment
#ASSERT `has effect as a substantive enactment without introductory words` TRUE EQUALS JUST TRUE
-- Scenario 218 (s 13(1)): a Schedule is part of the Act
#ASSERT `is part of the Act` `a section of the Act, or a Schedule to it, from the first section to the end of the last section or Schedule` FALSE FALSE FALSE EQUALS TRUE
-- Scenario 219 (s 13(2)(a)): long title
#ASSERT `is part of the Act` `the long title` FALSE FALSE FALSE EQUALS TRUE
-- Scenario 220 (s 13(2)(b)): Preamble
#ASSERT `is part of the Act` `a Preamble` FALSE FALSE FALSE EQUALS TRUE
-- Scenario 221 (s 13(2)(c)): enacting words
#ASSERT `is part of the Act` `the enacting words` FALSE FALSE FALSE EQUALS TRUE
-- Scenario 222 (s 13(2)(d)): Part heading before the first section
#ASSERT `is part of the Act` `a heading to a Chapter, Part, Division or Subdivision appearing before the first section` FALSE FALSE FALSE EQUALS TRUE
-- Scenario 223 (s 13(1)): a Note or Example printed within a section is in the range
#ASSERT `is part of the Act` `a section of the Act, or a Schedule to it, from the first section to the end of the last section or Schedule` FALSE FALSE FALSE EQUALS TRUE
-- Scenario 226 (s 13(3)): alt text meeting (a), (b) and (c) is not part of the Act
#ASSERT `is part of the Act` `a section of the Act, or a Schedule to it, from the first section to the end of the last section or Schedule` TRUE TRUE TRUE EQUALS FALSE
-- Scenario 227 (s 13(3)(c)): alt text that also appears in the printed text is not excluded by s 13(3)
#ASSERT `is part of the Act` `a section of the Act, or a Schedule to it, from the first section to the end of the last section or Schedule` TRUE TRUE FALSE EQUALS TRUE
-- Scenario 228 (s 13(3)(a)): text that does more than indicate effect is not excluded by s 13(3)
#ASSERT `is part of the Act` `a section of the Act, or a Schedule to it, from the first section to the end of the last section or Schedule` FALSE TRUE TRUE EQUALS TRUE
-- Scenario 229 (s 15A): enactment partly in excess of power -> valid to the extent within power
#ASSERT `section 15A treats the enactment` TRUE TRUE EQUALS JUST `valid to the extent to which it is not in excess of the legislative power of the Commonwealth`
-- Scenario 230 (s 15AA): the interpretation that best achieves the purpose is preferred
#ASSERT `the interpretation to be preferred` (LIST (`A candidate interpretation` OF "X", TRUE, TRUE), (`A candidate interpretation` OF "Y", FALSE, TRUE)) EQUALS JUST (`A candidate interpretation` OF "X", TRUE, TRUE)
-- Scenario 231 (s 15AA): purpose not expressly stated -> still applies
#ASSERT `the interpretation to be preferred` (LIST (`A candidate interpretation` OF "X", TRUE, FALSE), (`A candidate interpretation` OF "Y", FALSE, FALSE)) EQUALS JUST (`A candidate interpretation` OF "X", TRUE, FALSE)
-- Scenario 232 (s 15AA): two equally good interpretations -> NOT COVERED
#ASSERT `the interpretation to be preferred` (LIST (`A candidate interpretation` OF "X", TRUE, TRUE), (`A candidate interpretation` OF "Y", TRUE, TRUE)) EQUALS NOTHING
-- Scenario 233 (s 15AB(1)(a)): to confirm the ordinary meaning
#ASSERT `consideration may be given to the material` TRUE TRUE FALSE FALSE EQUALS TRUE
-- Scenario 234 (s 15AB(1)): clear, not absurd; to determine a different meaning
#ASSERT `consideration may be given to the material` TRUE FALSE FALSE FALSE EQUALS FALSE
-- Scenario 235 (s 15AB(1)(b)(i)): ambiguous or obscure
#ASSERT `consideration may be given to the material` TRUE FALSE TRUE FALSE EQUALS TRUE
-- Scenario 236 (s 15AB(1)(b)(ii)): manifestly absurd
#ASSERT `consideration may be given to the material` TRUE FALSE FALSE TRUE EQUALS TRUE
-- Scenario 237 (s 15AB(1)(b)(ii)): merely unreasonable
#ASSERT `consideration may be given to the material` TRUE FALSE FALSE TRUE EQUALS TRUE
-- Scenario 238 (s 15AB(1)): material not capable of assisting
#ASSERT `consideration may be given to the material` FALSE TRUE TRUE TRUE EQUALS FALSE
-- Scenario 239 (s 15AB(2)(b)): Royal Commission report laid before enactment
#ASSERT `section 15AB(2) lists` `a relevant report of a Royal Commission, Law Reform Commission, committee of inquiry or other similar body` TRUE EQUALS TRUE
-- Scenario 240 (s 15AB(2)(b)): ... laid after enactment
#ASSERT `section 15AB(2) lists` `a relevant report of a Royal Commission, Law Reform Commission, committee of inquiry or other similar body` FALSE EQUALS FALSE
-- Scenario 241 (s 15AB(2)(c)): committee of Parliament report made before enactment
#ASSERT `section 15AB(2) lists` `a relevant report of a committee of the Parliament or of either House` TRUE EQUALS TRUE
-- Scenario 242 (s 15AB(2)(d)): treaty referred to in the Act
#ASSERT `section 15AB(2) lists` `a treaty or other international agreement that is referred to in the Act` TRUE EQUALS TRUE
-- Scenario 243 (s 15AB(2)(d)): treaty not referred to in the Act is not listed in (d)
#ASSERT `section 15AB(2) lists` `other material` TRUE EQUALS FALSE
-- Scenario 244 (s 15AB(2)(e)): explanatory memorandum laid before enactment
#ASSERT `section 15AB(2) lists` `an explanatory memorandum relating to the Bill, or any other relevant document, laid before or furnished to the members of either House by a Minister` TRUE EQUALS TRUE
-- Scenario 245 (s 15AB(2)(e)): ... laid after enactment
#ASSERT `section 15AB(2) lists` `an explanatory memorandum relating to the Bill, or any other relevant document, laid before or furnished to the members of either House by a Minister` FALSE EQUALS FALSE
-- Scenario 246 (s 15AB(2)(f)): Minister's second reading speech
#ASSERT `section 15AB(2) lists` `the Minister's second reading speech on the Bill containing the provision` TRUE EQUALS TRUE
-- Scenario 247 (s 15AB(2)(f)): a private member's speech is not within (f)
#ASSERT `section 15AB(2) lists` `other material` TRUE EQUALS FALSE
-- Scenario 248 (s 15AB(2)(h)): official record of debates
#ASSERT `section 15AB(2) lists` `relevant material in the Journals of the Senate, the Votes and Proceedings of the House of Representatives or an official record of debates` TRUE EQUALS TRUE
