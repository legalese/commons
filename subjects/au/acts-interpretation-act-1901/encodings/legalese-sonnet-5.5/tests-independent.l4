#ASSERT `the reference to the external Territories is taken to include the coastal sea` TRUE TRUE EQUALS TRUE
-- Scenario 267 (s 15B(4)(b)(i)): territorial sea adjacent to an external Territory
#ASSERT `is in the coastal sea of an external Territory` TRUE FALSE EQUALS TRUE
