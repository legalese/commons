§ `Section 34C(5) and (6)(b)`

#ASSERT `the Minister may grant the extension` TRUE TRUE
#ASSERT NOT (`the Minister may grant the extension` TRUE FALSE)
#ASSERT NOT (`the Minister may grant the extension` FALSE TRUE)
-- (6)(b): the specified period ran from 1 January 2026; the Minister extended it to Saturday 28 February 2026. The Act requires the report,
-- so s 36(2) lets it be furnished on the next day that is not a Saturday, a Sunday or a holiday: Monday 2 March 2026.
#ASSERT `the person furnishes the report within the period as extended` TRUE (Date 27 2 2026) (Date 1 1 2026) (Date 28 2 2026) `no closures`
#ASSERT `the person furnishes the report within the period as extended` TRUE (Date 2 3 2026) (Date 1 1 2026) (Date 28 2 2026) `no closures`
#ASSERT NOT (`the person furnishes the report within the period as extended` TRUE (Date 3 3 2026) (Date 1 1 2026) (Date 28 2 2026) `no closures`)
-- If 2 March 2026 is a holiday, Tuesday 3 March 2026 is the next day that is not.
#ASSERT `the person furnishes the report within the period as extended` TRUE (Date 3 3 2026) (Date 1 1 2026) (Date 28 2 2026) `a closure on 2 March 2026`
#ASSERT NOT (`the person furnishes the report within the period as extended` TRUE (Date 4 3 2026) (Date 1 1 2026) (Date 28 2 2026) `a closure on 2 March 2026`)
-- No extension was granted: (6)(b) says nothing, so the answer is no.
#ASSERT NOT (`the person furnishes the report within the period as extended` FALSE (Date 27 2 2026) (Date 1 1 2026) (Date 28 2 2026) `no closures`)
-- Before the period began.
#ASSERT NOT (`the person furnishes the report within the period as extended` TRUE (Date 31 12 2025) (Date 1 1 2026) (Date 28 2 2026) `no closures`)
