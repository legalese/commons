IMPORT prelude
IMPORT daydate
IMPORT `au-interpretation-time`
IMPORT `au-part3-commencement`

-- Tests for Part 3 (ss 3 and 3A are tested in au-tests-time.l4). Expected values from the text.

§ `Section 4`

-- 4(1) and (2): enacted, will confer power at a start time because it commences then, or because an enacted Act amends it then.
#ASSERT `section 4 allows the power to be exercised before the start time` TRUE TRUE TRUE FALSE
#ASSERT `section 4 allows the power to be exercised before the start time` TRUE TRUE FALSE TRUE
#ASSERT `section 4 allows the power to be exercised before the start time` TRUE TRUE TRUE TRUE
-- Each of the other conditions is needed.
#ASSERT NOT (`section 4 allows the power to be exercised before the start time` TRUE TRUE FALSE FALSE)
#ASSERT NOT (`section 4 allows the power to be exercised before the start time` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`section 4 allows the power to be exercised before the start time` TRUE FALSE TRUE TRUE)
-- 4(4): rights and obligations before commencement only so far as necessary or convenient for (a), (b) or (c).
#ASSERT `the exercise may confer a power or right or impose an obligation before the relevant commencement` TRUE FALSE FALSE
#ASSERT `the exercise may confer a power or right or impose an obligation before the relevant commencement` FALSE TRUE FALSE
#ASSERT `the exercise may confer a power or right or impose an obligation before the relevant commencement` FALSE FALSE TRUE
#ASSERT NOT (`the exercise may confer a power or right or impose an obligation before the relevant commencement` FALSE FALSE FALSE)
-- 4(5): takes effect at the start time or a later time specified.
#ASSERT `the day an appointment or instrument made before the start time takes effect` (YearMonthDay 2026 7 1) NOTHING EQUALS YearMonthDay 2026 7 1
#ASSERT `the day an appointment or instrument made before the start time takes effect` (YearMonthDay 2026 7 1) (JUST (YearMonthDay 2026 8 1)) EQUALS YearMonthDay 2026 8 1
#ASSERT `the day an appointment or instrument made before the start time takes effect` (YearMonthDay 2026 7 1) (JUST (YearMonthDay 2026 7 1)) EQUALS YearMonthDay 2026 7 1
-- An earlier specified day cannot take effect before the start time.
#ASSERT `the day an appointment or instrument made before the start time takes effect` (YearMonthDay 2026 7 1) (JUST (YearMonthDay 2026 6 1)) EQUALS YearMonthDay 2026 7 1

§ `Section 6`

#ASSERT `the printed date is evidence of the date of assent, and is to be judicially noticed` TRUE TRUE
#ASSERT NOT (`the printed date is evidence of the date of assent, and is to be judicially noticed` TRUE FALSE)
#ASSERT NOT (`the printed date is evidence of the date of assent, and is to be judicially noticed` FALSE TRUE)
