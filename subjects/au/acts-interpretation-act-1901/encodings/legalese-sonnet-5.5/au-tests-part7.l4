IMPORT prelude
IMPORT daydate
IMPORT `au-interpretation-time`
IMPORT `au-part7-powers`

-- Tests for Part 7. Expected values are written from the text and from a calendar:
-- 2026-02-28 is a Saturday, 2026-03-01 a Sunday, 2026-03-02 a Monday; 2025-03-15 a Saturday.

`no closures` MEANS `Days of closure` OF (LIST), (LIST)

`a closure on 2 March 2026` MEANS `Days of closure` OF (LIST), (LIST (YearMonthDay 2026 3 2))

GIVEN k IS A NUMBER
GIVETH A `A sitting of a House`
`a sitting k days after 2 March 2026` k MEANS `A sitting of a House` OF (Date ((Day (YearMonthDay 2026 3 2)) PLUS k)), (Date ((Day (YearMonthDay 2026 3 2)) PLUS k))

`sixteen daily sittings after 2 March 2026` MEANS LIST (`a sitting k days after 2 March 2026` 1), (`a sitting k days after 2 March 2026` 2), (`a sitting k days after 2 March 2026` 3), (`a sitting k days after 2 March 2026` 4), (`a sitting k days after 2 March 2026` 5), (`a sitting k days after 2 March 2026` 6), (`a sitting k days after 2 March 2026` 7), (`a sitting k days after 2 March 2026` 8), (`a sitting k days after 2 March 2026` 9), (`a sitting k days after 2 March 2026` 10), (`a sitting k days after 2 March 2026` 11), (`a sitting k days after 2 March 2026` 12), (`a sitting k days after 2 March 2026` 13), (`a sitting k days after 2 March 2026` 14), (`a sitting k days after 2 March 2026` 15), (`a sitting k days after 2 March 2026` 16)

`fewer than three sittings after 2 March 2026` MEANS LIST (`a sitting k days after 2 March 2026` 1), (`a sitting k days after 2 March 2026` 2)

§ `Section 33(4)`

-- 12 months AFTER 15 March 2026 (item 6): from 16 March 2026, ending immediately before 16 March 2027.
#ASSERT `the last day of the 12 months for an acting appointment under section 33(4)` (YearMonthDay 2026 3 15) EQUALS JUST (YearMonthDay 2027 3 15)
-- A vacancy on 31 January 2026: from 1 February 2026 the 12 months end on 31 January 2027.
#ASSERT `the last day of the 12 months for an acting appointment under section 33(4)` (YearMonthDay 2026 1 31) EQUALS JUST (YearMonthDay 2027 1 31)
-- Boundary both sides: not expired on the last day, expired on the day after.
#ASSERT NOT (`the 12 months under section 33(4) have expired by` (YearMonthDay 2027 3 15) (YearMonthDay 2026 3 15))
#ASSERT `the 12 months under section 33(4) have expired by` (YearMonthDay 2027 3 16) (YearMonthDay 2026 3 15)
#ASSERT NOT (`the 12 months under section 33(4) have expired by` (YearMonthDay 2026 3 15) (YearMonthDay 2026 3 15))

§ `Section 33A`

-- (ba): acting from 1 July 2026 for 12 months, that day counted: the last day is 30 June 2027.
#ASSERT `the last day the appointee may act in a vacant office` (YearMonthDay 2026 7 1) EQUALS JUST (YearMonthDay 2027 6 30)
-- Acting from 15 March 2026: the last day is 14 March 2027.
#ASSERT `the last day the appointee may act in a vacant office` (YearMonthDay 2026 3 15) EQUALS JUST (YearMonthDay 2027 3 14)
-- (c): a vacancy on 15 March 2026, "from the day" excludes the day; 12 months end on 15 March 2027.
#ASSERT `the day the continued acting ends` (YearMonthDay 2026 3 15) NOTHING NOTHING EQUALS JUST (YearMonthDay 2027 3 15)
-- The vacancy is filled earlier, on 1 June 2026.
#ASSERT `the day the continued acting ends` (YearMonthDay 2026 3 15) NOTHING (JUST (YearMonthDay 2026 6 1)) EQUALS JUST (YearMonthDay 2026 6 1)
-- The appointer directs otherwise on 1 May 2026, and the vacancy is filled on 1 June 2026: the first happens first.
#ASSERT `the day the continued acting ends` (YearMonthDay 2026 3 15) (JUST (YearMonthDay 2026 5 1)) (JUST (YearMonthDay 2026 6 1)) EQUALS JUST (YearMonthDay 2026 5 1)
-- A direction given after the 12 months have run does not lengthen them.
#ASSERT `the day the continued acting ends` (YearMonthDay 2026 3 15) (JUST (YearMonthDay 2028 1 1)) NOTHING EQUALS JUST (YearMonthDay 2027 3 15)

§ `Section 33AB`

#ASSERT `the thing done is invalid merely because of this ground` `the occasion for the appointment had not arisen` FALSE EQUALS JUST FALSE
#ASSERT `the thing done is invalid merely because of this ground` `there was a defect or irregularity in connection with the appointment` FALSE EQUALS JUST FALSE
#ASSERT `the thing done is invalid merely because of this ground` `the appointment had ceased to have effect` FALSE EQUALS JUST FALSE
#ASSERT `the thing done is invalid merely because of this ground` `for an acting appointment, the occasion to act had not arisen or had ceased` TRUE EQUALS JUST FALSE
-- The last ground is for an acting appointment only: for another appointment the section does not cover it.
#ASSERT `the thing done is invalid merely because of this ground` `for an acting appointment, the occasion to act had not arisen or had ceased` FALSE EQUALS NOTHING

§ `Section 34A`

#ASSERT `the delegate may act on the delegate's own opinion, belief or state of mind` TRUE TRUE
#ASSERT NOT (`the delegate may act on the delegate's own opinion, belief or state of mind` TRUE FALSE)
#ASSERT NOT (`the delegate may act on the delegate's own opinion, belief or state of mind` FALSE TRUE)

§ `Section 34B(1)`

#ASSERT `it is sufficient compliance in relation to a House` TRUE FALSE FALSE FALSE FALSE FALSE
#ASSERT `it is sufficient compliance in relation to a House` FALSE TRUE FALSE FALSE FALSE FALSE
#ASSERT NOT (`it is sufficient compliance in relation to a House` FALSE FALSE FALSE FALSE FALSE FALSE)
-- A named person must do it (or one who could act for them).
#ASSERT `it is sufficient compliance in relation to a House` TRUE FALSE TRUE TRUE FALSE FALSE
#ASSERT NOT (`it is sufficient compliance in relation to a House` TRUE FALSE TRUE FALSE FALSE FALSE)
-- A specified period must be met.
#ASSERT `it is sufficient compliance in relation to a House` TRUE FALSE FALSE FALSE TRUE TRUE
#ASSERT NOT (`it is sufficient compliance in relation to a House` TRUE FALSE FALSE FALSE TRUE FALSE)
-- The period test of au-interpretation-time.l4 supplies the last input: 10 days after 1 March 2026 ends 11 March 2026.
#ASSERT `the thing is done within the time allowed` (YearMonthDay 2026 3 11) (YearMonthDay 2026 3 2) (YearMonthDay 2026 3 11) `no closures`
#ASSERT NOT (`the thing is done within the time allowed` (YearMonthDay 2026 3 12) (YearMonthDay 2026 3 2) (YearMonthDay 2026 3 11) `no closures`)

§ `Section 34C: who it applies to`

#ASSERT `section 34C applies to` `an ordinary reporting person`
#ASSERT `section 34C applies to` `the Australian Security Intelligence Organisation`
#ASSERT `section 34C applies to` `the Australian Signals Directorate`
#ASSERT `section 34C applies to` `the Office of National Intelligence`
#ASSERT NOT (`section 34C applies to` `the Australian Secret Intelligence Service`)
#ASSERT `subsection 34C(3) applies to` `an ordinary reporting person`
#ASSERT NOT (`subsection 34C(3) applies to` `the Australian Security Intelligence Organisation`)
#ASSERT NOT (`subsection 34C(3) applies to` `the Australian Signals Directorate`)
#ASSERT NOT (`subsection 34C(3) applies to` `the Office of National Intelligence`)
#ASSERT `paragraph 34C(6)(c) applies to` `an ordinary reporting person`
#ASSERT NOT (`paragraph 34C(6)(c) applies to` `the Office of National Intelligence`)

§ `Section 34C(2): the six months`

-- The period ends 30 June 2026; 6 months after: from 1 July 2026, ending immediately before 1 January 2027, which is 31 December 2026 (a Thursday).
#ASSERT `the last day to furnish a periodic report to the Minister` FALSE (YearMonthDay 2026 6 30) `no closures` EQUALS JUST (YearMonthDay 2026 12 31)
-- The period ends 31 August 2025: from 1 September 2025, 6 months end on 28 February 2026, a Saturday, so the next day that is not a Saturday, a Sunday or a holiday: Monday 2 March 2026.
#ASSERT `the last day to furnish a periodic report to the Minister` FALSE (YearMonthDay 2025 8 31) `no closures` EQUALS JUST (YearMonthDay 2026 3 2)
-- Monday 2 March 2026 closed for the whole day: Tuesday 3 March 2026.
#ASSERT `the last day to furnish a periodic report to the Minister` FALSE (YearMonthDay 2025 8 31) `a closure on 2 March 2026` EQUALS JUST (YearMonthDay 2026 3 3)
-- The Act specifies its own period: 34C(2) does not apply.
#ASSERT `the last day to furnish a periodic report to the Minister` TRUE (YearMonthDay 2026 6 30) `no closures` EQUALS NOTHING
-- A period that ended before 30 June 1983 is not a periodic report: boundary both sides.
#ASSERT `the last day to furnish a periodic report to the Minister` FALSE (YearMonthDay 1983 6 29) `no closures` EQUALS NOTHING
-- 30 June 1983 itself counts. From 1 July 1983 the 6 months end on 31 December 1983, a Saturday; 1 January 1984 is a Sunday; so Monday 2 January 1984.
#ASSERT `the last day to furnish a periodic report to the Minister` FALSE (YearMonthDay 1983 6 30) `no closures` EQUALS JUST (YearMonthDay 1984 1 2)

§ `Section 34C(3)`

-- Received 2 March 2026; sittings on each of the 16 days after: the 15th sitting day after is 17 March 2026.
#ASSERT `the last day for the Minister to lay the report before a House` (YearMonthDay 2026 3 2) `sixteen daily sittings after 2 March 2026` EQUALS JUST (YearMonthDay 2026 3 17)
-- Received 3 March 2026: the 15th sitting day after is 18 March 2026.
#ASSERT `the last day for the Minister to lay the report before a House` (YearMonthDay 2026 3 3) `sixteen daily sittings after 2 March 2026` EQUALS JUST (YearMonthDay 2026 3 18)
-- Received 4 March 2026: only 14 sitting days remain in the supplied list, so the text answers nothing with these inputs.
#ASSERT `the last day for the Minister to lay the report before a House` (YearMonthDay 2026 3 4) `sixteen daily sittings after 2 March 2026` EQUALS NOTHING

§ `Section 34C(4)`

-- The specified period is 1 March to 31 March 2026.
#ASSERT `the person may apply for an extension` TRUE (YearMonthDay 2026 3 31) (YearMonthDay 2026 3 1) (YearMonthDay 2026 3 31) `no closures`
#ASSERT NOT (`the person may apply for an extension` TRUE (YearMonthDay 2026 4 1) (YearMonthDay 2026 3 1) (YearMonthDay 2026 3 31) `no closures`)
#ASSERT NOT (`the person may apply for an extension` TRUE (YearMonthDay 2026 2 28) (YearMonthDay 2026 3 1) (YearMonthDay 2026 3 31) `no closures`)
#ASSERT NOT (`the person may apply for an extension` FALSE (YearMonthDay 2026 3 15) (YearMonthDay 2026 3 1) (YearMonthDay 2026 3 31) `no closures`)
-- Specified period ending on Saturday 28 February 2026: an application on Monday 2 March 2026 is in time (s 36(2)).
#ASSERT `the person may apply for an extension` TRUE (YearMonthDay 2026 3 2) (YearMonthDay 2026 2 1) (YearMonthDay 2026 2 28) `no closures`

§ `Section 34C(6)`

-- Extension granted 2 March 2026: the 3rd sitting day after is 5 March 2026.
#ASSERT `the last day for the Minister to lay the extension statement before a House` (YearMonthDay 2026 3 2) `sixteen daily sittings after 2 March 2026` EQUALS JUST (YearMonthDay 2026 3 5)
-- Too few sittings: nothing.
#ASSERT `the last day for the Minister to lay the extension statement before a House` (YearMonthDay 2026 3 2) `fewer than three sittings after 2 March 2026` EQUALS NOTHING
-- Report received 2 March 2026: 15th sitting day after is 17 March 2026 for an ordinary body; disregarded for ASIO, ASD and ONI.
#ASSERT `the last day for the Minister to lay the extended report before a House` `an ordinary reporting person` (YearMonthDay 2026 3 2) `sixteen daily sittings after 2 March 2026` EQUALS JUST (YearMonthDay 2026 3 17)
#ASSERT `the last day for the Minister to lay the extended report before a House` `the Australian Security Intelligence Organisation` (YearMonthDay 2026 3 2) `sixteen daily sittings after 2 March 2026` EQUALS NOTHING

§ `Section 34C(7)`

-- The specified period ended on 31 March 2026 (a Tuesday); 14 days after: 14 April 2026 (a Tuesday).
#ASSERT `the last day to furnish the statement explaining why the report was late` (YearMonthDay 2026 3 31) `no closures` EQUALS JUST (YearMonthDay 2026 4 14)
-- The period ended on Saturday 14 February 2026: 14 days after is Saturday 28 February 2026, so Monday 2 March 2026.
#ASSERT `the last day to furnish the statement explaining why the report was late` (YearMonthDay 2026 2 14) `no closures` EQUALS JUST (YearMonthDay 2026 3 2)
-- Statement received 2 March 2026: 3rd sitting day after is 5 March 2026.
#ASSERT `the last day for the Minister to lay the late-report statement before a House` (YearMonthDay 2026 3 2) `sixteen daily sittings after 2 March 2026` EQUALS JUST (YearMonthDay 2026 3 5)
