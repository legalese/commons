IMPORT prelude
IMPORT daydate
IMPORT `au-interpretation-time`
IMPORT `au-part10-11-instruments`

-- Tests for Parts 10 and 11. Expected values are written from the text.

§ `Section 46(1)`

#ASSERT `this Act applies to the instrument as if it were an Act and each of its provisions a section of an Act` TRUE FALSE FALSE FALSE
-- The three exclusions, and no power at all.
#ASSERT NOT (`this Act applies to the instrument as if it were an Act and each of its provisions a section of an Act` TRUE TRUE FALSE FALSE)
#ASSERT NOT (`this Act applies to the instrument as if it were an Act and each of its provisions a section of an Act` TRUE FALSE TRUE FALSE)
#ASSERT NOT (`this Act applies to the instrument as if it were an Act and each of its provisions a section of an Act` TRUE FALSE FALSE TRUE)
#ASSERT NOT (`this Act applies to the instrument as if it were an Act and each of its provisions a section of an Act` FALSE FALSE FALSE FALSE)

§ `Section 46(2)`

#ASSERT `this part of the instrument is valid` TRUE TRUE EQUALS JUST TRUE
#ASSERT `this part of the instrument is valid` TRUE FALSE EQUALS JUST FALSE
-- Not an instrument of the kind in 46(1): the section is silent.
#ASSERT `this part of the instrument is valid` FALSE TRUE EQUALS NOTHING

§ `Section 46(3)`

#ASSERT `an amendment of the instrument by an Act prevents the authority from later amending or repealing it` FALSE EQUALS JUST FALSE
-- A legislative instrument, notifiable instrument or rule of court: the parallel is in the Legislation Act 2003, not in this text.
#ASSERT `an amendment of the instrument by an Act prevents the authority from later amending or repealing it` TRUE EQUALS NOTHING

§ `Section 46AA`

-- (1)(a): an Act, a disallowable legislative instrument, rules of court: at a particular time, or from time to time.
#ASSERT `the instrument may apply, adopt or incorporate the matter at this time` `the provisions of an Act` `as in force from time to time` TRUE FALSE EQUALS JUST TRUE
#ASSERT `the instrument may apply, adopt or incorporate the matter at this time` `the provisions of an Act` `as in force at a particular time` TRUE FALSE EQUALS JUST TRUE
#ASSERT `the instrument may apply, adopt or incorporate the matter at this time` `the provisions of rules of court` `as in force from time to time` TRUE FALSE EQUALS JUST TRUE
#ASSERT `the instrument may apply, adopt or incorporate the matter at this time` `the provisions of a legislative instrument that is disallowable within the meaning of the Legislation Act 2003` `as in force from time to time` TRUE FALSE EQUALS JUST TRUE
#ASSERT `the instrument may apply, adopt or incorporate the matter at this time` `the provisions of a legislative instrument that was disallowable under this or any other Act at some time before 1 January 2005` `as in force from time to time` TRUE FALSE EQUALS JUST TRUE
-- (1)(b) and (2): any other instrument or writing, as in force or existing at commencement or earlier, never from time to time.
#ASSERT `the instrument may apply, adopt or incorporate the matter at this time` `a matter contained in any other instrument or writing` `as in force or existing when the instrument commences` TRUE FALSE EQUALS JUST TRUE
#ASSERT `the instrument may apply, adopt or incorporate the matter at this time` `a matter contained in any other instrument or writing` `as in force or existing at a time before the instrument commences` TRUE FALSE EQUALS JUST TRUE
#ASSERT `the instrument may apply, adopt or incorporate the matter at this time` `a matter contained in any other instrument or writing` `as in force from time to time` TRUE FALSE EQUALS JUST FALSE
-- (4): a form: the section does not apply.
#ASSERT `the instrument may apply, adopt or incorporate the matter at this time` `the provisions of an Act` `as in force from time to time` TRUE TRUE EQUALS NOTHING
-- The instrument is a legislative instrument, notifiable instrument or rule of court: the section does not apply.
#ASSERT `the instrument may apply, adopt or incorporate the matter at this time` `the provisions of an Act` `as in force from time to time` FALSE FALSE EQUALS NOTHING

§ `Section 47`

#ASSERT `this part of the resolution is valid` TRUE TRUE EQUALS JUST TRUE
#ASSERT `this part of the resolution is valid` TRUE FALSE EQUALS JUST FALSE
#ASSERT `this part of the resolution is valid` FALSE TRUE EQUALS NOTHING

§ `Section 51`

#ASSERT `the Governor-General may make regulations prescribing the matter` TRUE FALSE
#ASSERT `the Governor-General may make regulations prescribing the matter` FALSE TRUE
#ASSERT `the Governor-General may make regulations prescribing the matter` TRUE TRUE
#ASSERT NOT (`the Governor-General may make regulations prescribing the matter` FALSE FALSE)
