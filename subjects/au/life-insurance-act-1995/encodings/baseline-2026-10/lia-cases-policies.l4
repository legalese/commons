`Chloe's cover, held by her fund's trustee` MEANS `My policy` WITH
    `it was issued to me` IS FALSE
    `the rights under it have been assigned or transferred away from me` IS FALSE
    `the rights under it have been assigned or transferred to me` IS FALSE
    `it is held by the trustee of my super fund for the fund` IS TRUE

`a policy issued to me` MEANS `My policy` WITH
    `it was issued to me` IS TRUE
    `the rights under it have been assigned or transferred away from me` IS FALSE
    `the rights under it have been assigned or transferred to me` IS FALSE
    `it is held by the trustee of my super fund for the fund` IS FALSE

`an assignment to my bank, done in full` MEANS `An assignment` WITH
    `it is by memorandum of transfer in the approved form` IS TRUE
    `the memorandum is endorsed on the policy document or an annexure` IS TRUE
    `both of us signed the memorandum` IS TRUE
    `the insurer registered it in its register of assignments` IS TRUE
    `the registration date is in the memorandum` IS TRUE
    `the insurer's principal executive officer, or a person authorised, signed it` IS TRUE

`4 years paid, surrender value 5000, premium 200, other debts 1000` MEANS `An unpaid premium` WITH
    `years of premiums paid` IS 4
    `the surrender value the day before it fell due` IS 5000
    `the overdue premium` IS 200
    `other amounts I owe the insurer under or secured by the policy` IS 1000
    `the insurer gave me the written notice` IS TRUE
    `the day the notice was given` IS (Date 1 3 2027)
    `the day the premium fell due` IS (Date 15 3 2027)

`2 years paid, notice 1 March, due 15 March 2027` MEANS `An unpaid premium` WITH
    `years of premiums paid` IS 2
    `the surrender value the day before it fell due` IS 5000
    `the overdue premium` IS 200
    `other amounts I owe the insurer under or secured by the policy` IS 0
    `the insurer gave me the written notice` IS TRUE
    `the day the notice was given` IS (Date 1 3 2027)
    `the day the premium fell due` IS (Date 15 3 2027)

§ `c04a -- Chloe's income protection and life cover inside her super fund, at 23 (15 September 2026)`

#ASSERT `What kind of policy is my cover` `Chloe's group life cover in her fund, renewed each year` EQUALS `a life policy because it pays on a death (s 9(1)(a))`
#ASSERT `What kind of policy is my cover` `Chloe's income protection in her fund, premiums reset each year` EQUALS `not a life policy under this Act`
#ASSERT `What kind of policy is my cover` `income protection to age 65, premiums changed only for everyone at once` EQUALS `a life policy because it is a continuous disability policy (s 9(1)(e), s 9A)`

#ASSERT `May a life insurer offer me this cover` `Chloe's group life cover in her fund, renewed each year` FALSE FALSE
#ASSERT NOT `May a life insurer offer me this cover` `Chloe's income protection in her fund, premiums reset each year` FALSE FALSE
#ASSERT `May a life insurer offer me this cover` `Chloe's income protection in her fund, premiums reset each year` TRUE FALSE

#ASSERT NOT `Am I the owner of my policy` `Chloe's cover, held by her fund's trustee`
#ASSERT `Am I the owner of my policy` `a policy issued to me`

#ASSERT `Is my cover a superannuation policy` `Chloe's group life cover in her fund, renewed each year` `Chloe's cover, held by her fund's trustee`
#ASSERT NOT `Is my cover a superannuation policy` `Chloe's group life cover in her fund, renewed each year` `a policy issued to me`

§ `ss 9, 9A -- other covers`

#ASSERT `What kind of policy is my cover` `a one-year accidental death policy` EQUALS `not a life policy under this Act`
#ASSERT `What kind of policy is my cover` `a five-year accidental death policy` EQUALS `a life policy because it pays on a death (s 9(1)(a))`
#ASSERT `What kind of policy is my cover` `three-year guaranteed trauma cover, shorter only because of my age at entry` EQUALS `a life policy because it is a continuous disability policy (s 9(1)(e), s 9A)`

§ `s 199 -- young people`

#ASSERT `May I take out a life policy at my age` 12 TRUE EQUALS `I may enter into a policy with a parent's written consent (s 199(1))`
#ASSERT `May I take out a life policy at my age` 12 FALSE EQUALS `I need a parent's written consent and do not have it (s 199(1))`
#ASSERT `May I take out a life policy at my age` 17 FALSE EQUALS `the Act gives me no capacity; the general law decides`

#ASSERT `Can I exercise my rights as owner as an adult can` 16

§ `ss 218-220 -- a child's advancement policy`

#ASSERT `What is the vesting age of my child's policy` 18 EQUALS 18
#ASSERT `What is the vesting age of my child's policy` 30 EQUALS 25

#ASSERT `Is this a child's advancement policy` 2 TRUE TRUE

#ASSERT `Whose is my child's advancement policy` 10 18 FALSE FALSE EQUALS `mine, as the person who took it out (s 219(3))`
#ASSERT `Whose is my child's advancement policy` 18 18 FALSE FALSE EQUALS `my child's (s 219(4))`
#ASSERT `Whose is my child's advancement policy` 10 18 FALSE TRUE EQUALS `held in trust for my child by my executor, administrator or trustee in bankruptcy (s 220(2))`

§ `s 200 -- assignment`

#ASSERT `Is the assignment of my policy effective at law` `an assignment to my bank, done in full`

§ `ss 204, 205 -- creditors`

#ASSERT `Can a court make my policy pay my debts` TRUE FALSE FALSE EQUALS `no`
#ASSERT `Can a court make my policy pay my debts` FALSE FALSE FALSE EQUALS `yes`
#ASSERT `Can a court make my policy pay my debts` TRUE FALSE TRUE EQUALS `the Bankruptcy Act 1966 decides`

#ASSERT `Can my death money pay my debts` FALSE FALSE `it expressly directs that this policy money pay this debt` FALSE EQUALS `yes`
#ASSERT `Can my death money pay my debts` FALSE FALSE `it merely directs that my debts be paid` FALSE EQUALS `no`

§ `ss 207-209 -- surrender and paid-up`

#ASSERT `Must my insurer pay me the surrender value` FALSE 3 TRUE FALSE
#ASSERT NOT `Must my insurer pay me the surrender value` FALSE 2 TRUE FALSE

#ASSERT `How much must my insurer pay me on surrender` 10000 12000 0 2000 EQUALS 10000
#ASSERT `How much must my insurer pay me on surrender` 1000 0 0 3000 EQUALS 0

#ASSERT NOT `Must my insurer make my policy paid-up` 2.5 TRUE

§ `s 210 -- forfeiture for an unpaid premium`

#ASSERT `Is my policy protected from forfeiture` `4 years paid, surrender value 5000, premium 200, other debts 1000`

#ASSERT `What is the first day my policy could be forfeited` `2 years paid, notice 1 March, due 15 March 2027` EQUALS (Date 12 4 2027)

#ASSERT `May my insurer forfeit my policy today` `2 years paid, notice 1 March, due 15 March 2027` (Date 12 4 2027)
#ASSERT NOT `May my insurer forfeit my policy today` `2 years paid, notice 1 March, due 15 March 2027` (Date 11 4 2027)

§ `ss 211-213 -- payment on death without probate`

#ASSERT `May the insurer pay me without probate` 80000 0 0 `spouse` FALSE FALSE
#ASSERT NOT `May the insurer pay me without probate` 120000 0 0 `spouse` FALSE FALSE
#ASSERT NOT `May the insurer pay me without probate` 50000 0 0 `another relative or a friend` FALSE FALSE

#ASSERT NOT `Can I be made owner without probate` TRUE 50000 0 TRUE

§ `ss 221, 228 -- lost policy document; suicide`

#ASSERT NOT `May I apply to a court for a replacement policy document` TRUE (Date 1 2 2027) FALSE (Date 1 8 2027)
#ASSERT `May I apply to a court for a replacement policy document` TRUE (Date 1 2 2027) FALSE (Date 2 8 2027)

#ASSERT NOT `May the insurer avoid the policy for suicide` FALSE

