IMPORT prelude
IMPORT `stf-rules`

-- Independent tests from the source text and BRIEF.md only (see
-- independent-expectations.md). Expected values were not adjusted to the code.

GIVEN fnd IS A `Fund`
      mem IS A `Member`
      arm IS A `Arm`
      self IS A BOOLEAN
      dep IS A BOOLEAN
      trus IS A BOOLEAN
GIVETH A `Fund position`
`pos` fnd mem arm self dep trus MEANS
    `the fund position for` (`Fund case` OF fnd, mem, arm, self, dep, trus)

`navyF` MEANS `the Royal Australian Navy Relief Trust Fund`
`armyF` MEANS `the Australian Military Forces Relief Trust Fund`
`airF` MEANS `the Royal Australian Air Force Welfare Trust Fund`
`mbr` MEANS `a member of the Navy, Army or Air Force`

-- 1
`s1` MEANS `pos` `navyF` `mbr` `the Navy` TRUE FALSE FALSE
#ASSERT `s1`'s `I am within the class the fund serves` EQUALS TRUE
#ASSERT `s1`'s `I am barred from benefiting` EQUALS FALSE
#ASSERT `s1`'s `whether and how much is for the trustees` EQUALS TRUE
-- 2
`s2` MEANS `pos` `navyF` `mbr` `the Army` TRUE FALSE FALSE
#ASSERT `s2`'s `I am within the class the fund serves` EQUALS FALSE
#ASSERT `s2`'s `whether and how much is for the trustees` EQUALS FALSE
-- 3
`s3` MEANS `pos` `armyF` `mbr` `the Army` TRUE FALSE FALSE
#ASSERT `s3`'s `I am within the class the fund serves` EQUALS TRUE
#ASSERT `s3`'s `whether and how much is for the trustees` EQUALS TRUE
-- 4
`s4` MEANS `pos` `airF` `mbr` `the Air Force` TRUE FALSE FALSE
#ASSERT `s4`'s `I am within the class the fund serves` EQUALS TRUE
-- 5
`s5` MEANS `pos` `airF` `a member of a nursing or women's service attached or auxiliary to the Defence Force` `the Air Force` TRUE FALSE FALSE
#ASSERT `s5`'s `I am within the class the fund serves` EQUALS TRUE
#ASSERT `s5`'s `whether and how much is for the trustees` EQUALS TRUE
-- 6
`s6` MEANS `pos` `navyF` `a member of a Navy ship's canteen staff` `the Navy` TRUE FALSE FALSE
#ASSERT `s6`'s `I am within the class the fund serves` EQUALS TRUE
-- 7
`s7` MEANS `pos` `armyF` `a member of a Navy ship's canteen staff` `the Navy` TRUE FALSE FALSE
#ASSERT `s7`'s `I am within the class the fund serves` EQUALS FALSE
-- 8
`s8` MEANS `pos` `armyF` `a person accredited to the Defence Force who served officially on full-time paid duty` `the Army` TRUE FALSE FALSE
#ASSERT `s8`'s `I am within the class the fund serves` EQUALS TRUE
#ASSERT `s8`'s `whether and how much is for the trustees` EQUALS TRUE
-- 9
`s9` MEANS `pos` `navyF` `none of these` `the Navy` TRUE FALSE FALSE
#ASSERT `s9`'s `I am within the class the fund serves` EQUALS FALSE
#ASSERT `s9`'s `whether and how much is for the trustees` EQUALS FALSE
-- 10
`s10` MEANS `pos` `navyF` `mbr` `the Navy` FALSE TRUE FALSE
#ASSERT `s10`'s `I am within the class the fund serves` EQUALS TRUE
#ASSERT `s10`'s `whether and how much is for the trustees` EQUALS TRUE
-- 11
`s11` MEANS `pos` `navyF` `mbr` `the Navy` FALSE FALSE FALSE
#ASSERT `s11`'s `I am within the class the fund serves` EQUALS FALSE
#ASSERT `s11`'s `whether and how much is for the trustees` EQUALS FALSE
-- 12
`s12` MEANS `pos` `navyF` `mbr` `the Navy` TRUE FALSE TRUE
#ASSERT `s12`'s `I am within the class the fund serves` EQUALS TRUE
#ASSERT `s12`'s `I am barred from benefiting` EQUALS TRUE
#ASSERT `s12`'s `whether and how much is for the trustees` EQUALS FALSE
-- 13
`s13` MEANS `pos` `airF` `mbr` `the Air Force` FALSE TRUE TRUE
#ASSERT `s13`'s `I am within the class the fund serves` EQUALS TRUE
#ASSERT `s13`'s `I am barred from benefiting` EQUALS TRUE
#ASSERT `s13`'s `whether and how much is for the trustees` EQUALS FALSE
-- 14
`s14` MEANS `pos` `armyF` `none of these` `the Army` FALSE TRUE FALSE
