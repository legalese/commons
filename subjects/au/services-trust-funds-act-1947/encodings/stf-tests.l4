IMPORT prelude
IMPORT `stf-rules`

-- Services Trust Funds Act 1947 (Cth) — the encoder's tests.

§ `Tests`

`navy fund` MEANS `the Royal Australian Navy Relief Trust Fund`
`member` MEANS `a member of the Navy, Army or Air Force`

#ASSERT `I am within the class` (`Fund case` OF `navy fund`, `member`, `the Navy`, TRUE, FALSE, FALSE)
#ASSERT NOT (`I am within the class` (`Fund case` OF `navy fund`, `member`, `the Army`, TRUE, FALSE, FALSE))
#ASSERT `I am within the class` (`Fund case` OF `the Australian Military Forces Relief Trust Fund`, `member`, `the Army`, TRUE, FALSE, FALSE)
#ASSERT `I am within the class` (`Fund case` OF `the Royal Australian Air Force Welfare Trust Fund`, `a member of a nursing or women's service attached or auxiliary to the Defence Force`, `the Air Force`, TRUE, FALSE, FALSE)
#ASSERT `I am within the class` (`Fund case` OF `navy fund`, `a member of a Navy ship's canteen staff`, `the Navy`, TRUE, FALSE, FALSE)
-- a dependant in the trustees' opinion
#ASSERT `I am within the class` (`Fund case` OF `navy fund`, `member`, `the Navy`, FALSE, TRUE, FALSE)
#ASSERT NOT (`I am within the class` (`Fund case` OF `navy fund`, `member`, `the Navy`, FALSE, FALSE, FALSE))
#ASSERT NOT (`I am within the class` (`Fund case` OF `navy fund`, `none of these`, `the Navy`, TRUE, FALSE, FALSE))
-- s 14
#ASSERT `I am barred` (`Fund case` OF `navy fund`, `member`, `the Navy`, TRUE, FALSE, TRUE)
#ASSERT NOT ((`the fund position for` (`Fund case` OF `navy fund`, `member`, `the Navy`, TRUE, FALSE, TRUE))'s `whether and how much is for the trustees`)
#ASSERT (`the fund position for` (`Fund case` OF `navy fund`, `member`, `the Navy`, TRUE, FALSE, FALSE))'s `whether and how much is for the trustees`
