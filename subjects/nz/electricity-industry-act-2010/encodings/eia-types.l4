-- Field names are unique across records.

§ `Electricity Industry Act 2010 — the nouns`

§§ `Supply obligation (ss 105-107)`

-- s 106(2): why supply has ceased, if it has.
DECLARE `Reason supply ceased` IS ONE OF
    `supply has not ceased`
    `(a) circumstances beyond the distributor's control`
    `(b) safety, maintenance or upgrading`
    `(c) non-payment of money due for the place`
    `another reason`

DECLARE `Supply facts` HAS
    -- s 105(1): the distributor was bound by s 62 of the Electricity Act 1992
    -- for the place, or is its successor.
    `section 105 applies to the distributor and place`  IS A BOOLEAN
    -- s 105(3): a contrary pre-commencement agreement or enactment.
    `a contrary agreement or enactment under s 105(3)`  IS A BOOLEAN
    -- s 106(1)(a)-(b).
    `ending agreed in writing by the landowner, consumer or Minister` IS A BOOLEAN
    `assigned to or assumed by a successor`             IS A BOOLEAN
    `reason supply ceased`                              IS A `Reason supply ceased`
    `the reason for ceasing still continues`            IS A BOOLEAN
    -- s 105(4)(a): for (a), whether supply was resumed as soon as reasonable.
    `resumed as soon as reasonable after learning of it` IS A BOOLEAN
    -- s 105(4)(b): for (b)-(c), whether the cessation was knowing.
    `ceased knowingly`                                  IS A BOOLEAN

§§ `Disputes (ss 95-96)`

DECLARE `Kind of participant` IS ONE OF
    `Transpower, other than as system operator`
    `Transpower as system operator`
    `a distributor`
    `a retailer`
    `another industry participant`

DECLARE `Scheme facts` HAS
    `kind of participant`                               IS A `Kind of participant`
    `in an exempt class under regulations`              IS A BOOLEAN
    `individually exempted by Gazette notice`           IS A BOOLEAN
    `a member of the scheme`                            IS A BOOLEAN
    `knowingly refused or failed to become a member`    IS A BOOLEAN

§§ `Enforcement (ss 52, 54, 80)`

DECLARE `Code breach` HAS
    `breach occurred on`                                IS A DATE
    -- the day the breach was, or ought reasonably to have been, discovered.
    `breach discovered on`                              IS A DATE
    `power exercised on`                                IS A DATE
    -- s 52(2): the Authority has already exercised a power on the breach.
    `a power already exercised on the breach`           IS A BOOLEAN
    `days the breach continued`                         IS A NUMBER

DECLARE `Part 3 contravener` HAS
    `an individual`                                     IS A BOOLEAN
    -- s 80(3)(b): the commercial gain, if readily ascertainable, and the
    -- turnover with interconnected bodies corporate.
    `commercial gain, if readily ascertained`           IS A MAYBE NUMBER
    `turnover with interconnected bodies`               IS A NUMBER
    -- s 80(3)(b)(i): the court is satisfied the contravention occurred in
    -- the course of producing a commercial gain (added after the independent
    -- pass).
    `in the course of producing a commercial gain`      IS A BOOLEAN
