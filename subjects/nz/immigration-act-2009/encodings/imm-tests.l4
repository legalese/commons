IMPORT prelude
IMPORT daydate
IMPORT `imm-types`
IMPORT `imm-status`
IMPORT `imm-deportation`
IMPORT `imm-employers`
IMPORT `imm-goal`

-- Immigration Act 2009 — THE ENCODER'S TESTS.
--
-- Expected values are worked by hand from the Act's text.

§ `Tests`

today MEANS Date 16 10 2026

GIVEN committed IS A DATE, convicted IS A DATE, maximum IS A NUMBER, sentence IS A NUMBER, temporary IS A BOOLEAN, employer IS A BOOLEAN
GIVETH A Conviction
conviction committed convicted maximum sentence temporary employer MEANS Conviction OF committed, convicted, maximum, sentence, temporary, employer

GIVEN visa IS A BOOLEAN, lawful IS A BOOLEAN, expired IS A MAYBE DATE, convictions IS A LIST OF Conviction
      deported IS A BOOLEAN, belief IS A BOOLEAN, special IS A BOOLEAN
GIVETH A Person
person visa lawful expired convictions deported belief special MEANS
    Person OF FALSE, visa, visa, Date 1 3 2026, lawful, expired, convictions, FALSE, deported, FALSE, FALSE, belief, special

lawfulPerson MEANS person TRUE TRUE NOTHING EMPTY FALSE FALSE FALSE

§§ `Eligibility (ss 15-17)`

#ASSERT NOT `is barred from a visa` lawfulPerson `on` today
#ASSERT `is barred from a visa` (person TRUE TRUE NOTHING (LIST conviction (Date 1 1 1990) (Date 1 1 1991) 10 5 FALSE FALSE) FALSE FALSE FALSE) `on` today
#ASSERT `is barred from a visa` (person TRUE TRUE NOTHING (LIST conviction (Date 1 1 2016) (Date 16 10 2016) 2 1 FALSE FALSE) FALSE FALSE FALSE) `on` today
#ASSERT NOT `is barred from a visa` (person TRUE TRUE NOTHING (LIST conviction (Date 1 1 2016) (Date 15 10 2016) 2 1 FALSE FALSE) FALSE FALSE FALSE) `on` today
#ASSERT NOT `is barred from a visa` (person TRUE TRUE NOTHING (LIST conviction (Date 1 1 2025) (Date 1 6 2025) 2 0.9 FALSE FALSE) FALSE FALSE FALSE) `on` today
#ASSERT NOT `is barred from a visa` (person TRUE TRUE NOTHING (LIST conviction (Date 1 1 1990) (Date 1 1 1991) 10 5 FALSE FALSE) FALSE FALSE TRUE) `on` today
#ASSERT `is barred from a visa` (person TRUE TRUE NOTHING EMPTY TRUE FALSE FALSE) `on` today
#ASSERT `is barred from a visa` (person TRUE TRUE NOTHING EMPTY FALSE TRUE FALSE) `on` today

§§ `Unlawful status and work (ss 9, 21, 154, 185)`

#ASSERT NOT `is unlawfully in New Zealand` lawfulPerson
#ASSERT `is unlawfully in New Zealand` (person FALSE FALSE NOTHING EMPTY FALSE FALSE FALSE)
#ASSERT NOT `is unlawfully in New Zealand` (Person OF TRUE, FALSE, FALSE, Date 1 3 2026, FALSE, NOTHING, EMPTY, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)
#ASSERT `the day unlawful status starts for` (person FALSE FALSE NOTHING EMPTY FALSE FALSE FALSE) EQUALS JUST (Date 1 3 2026)
#ASSERT `the day unlawful status starts for` (person FALSE TRUE (JUST (Date 30 6 2026)) EMPTY FALSE FALSE FALSE) EQUALS JUST (Date 1 7 2026)
#ASSERT `the day unlawful status starts for` lawfulPerson EQUALS NOTHING
#ASSERT `is barred from working by s 21` (person FALSE TRUE (JUST (Date 30 6 2026)) EMPTY FALSE FALSE FALSE)
#ASSERT NOT `is barred from working by s 21` lawfulPerson
#ASSERT `the last day for a humanitarian appeal by a person unlawful from` (Date 1 7 2026) `, reconsideration confirmed` NOTHING EQUALS Date 12 8 2026
#ASSERT `the last day for a humanitarian appeal by a person unlawful from` (Date 1 7 2026) `, reconsideration confirmed` (JUST (Date 20 7 2026)) EQUALS Date 31 8 2026
#ASSERT `a reconsideration may be applied for, notified` (Date 1 10 2026) `, applying on` (Date 15 10 2026) `, still lawful` TRUE
#ASSERT NOT `a reconsideration may be applied for, notified` (Date 1 10 2026) `, applying on` (Date 16 10 2026) `, still lawful` TRUE
#ASSERT NOT `a reconsideration may be applied for, notified` (Date 1 10 2026) `, applying on` (Date 10 10 2026) `, still lawful` FALSE

§§ `Deportation liability (ss 157, 161, 167)`

GIVEN imprisoned IS A NUMBER
      convictions IS A LIST OF Conviction
GIVETH A `Resident facts`
resident imprisoned convictions MEANS `Resident facts` OF Date 1 1 2020, imprisoned, convictions

#ASSERT `the resident is liable for deportation under s 161` (resident 0 (LIST conviction (Date 31 12 2021) (Date 1 6 2022) 0.25 0 FALSE FALSE))
#ASSERT `the resident is liable for deportation under s 161` (resident 0 (LIST conviction (Date 1 1 2022) (Date 1 6 2022) 0.25 0 FALSE FALSE))
#ASSERT NOT `the resident is liable for deportation under s 161` (resident 0 (LIST conviction (Date 2 1 2022) (Date 1 6 2022) 0.25 0 FALSE FALSE))
#ASSERT NOT `the resident is liable for deportation under s 161` (resident 0 (LIST conviction (Date 31 12 2021) (Date 1 6 2022) 0.2 0 FALSE FALSE))
#ASSERT `the resident is liable for deportation under s 161` (resident 0 (LIST conviction (Date 1 1 2025) (Date 1 6 2025) 2 0 FALSE FALSE))
#ASSERT NOT `the resident is liable for deportation under s 161` (resident 0 (LIST conviction (Date 2 1 2025) (Date 1 6 2025) 2 0 FALSE FALSE))
#ASSERT `the resident is liable for deportation under s 161` (resident 0 (LIST conviction (Date 31 12 2029) (Date 1 6 2030) 10 5 FALSE FALSE))
#ASSERT NOT `the resident is liable for deportation under s 161` (resident 0 (LIST conviction (Date 2 1 2030) (Date 1 6 2030) 10 5 FALSE FALSE))
#ASSERT NOT `the resident is liable for deportation under s 161` (resident 0 (LIST conviction (Date 31 12 2029) (Date 1 6 2030) 10 4 FALSE FALSE))
-- s 161(3): 10 days in prison extend the 2-year period to 11 January 2022.
#ASSERT `the resident is liable for deportation under s 161` (resident 10 (LIST conviction (Date 5 1 2022) (Date 1 6 2022) 0.25 0 FALSE FALSE))
#ASSERT `the resident is liable for deportation under s 161` (resident 0 (LIST conviction (Date 1 1 2030) (Date 1 6 2030) 0.25 0 TRUE FALSE))
#ASSERT `the resident is liable for deportation under s 161` (resident 0 (LIST conviction (Date 31 12 2029) (Date 1 6 2030) 1 0 FALSE TRUE))
#ASSERT NOT `the resident is liable for deportation under s 161` (resident 0 EMPTY)
#ASSERT `the last day of deportation liability, facts` (`Liability period facts` OF Date 1 1 2026, 0) EQUALS Date 1 1 2036
#ASSERT `the last day of deportation liability, facts` (`Liability period facts` OF Date 1 1 2026, 100) EQUALS Date 10 4 2036
#ASSERT `the last day to give reasons against deportation, notice served` (Date 1 10 2026) EQUALS Date 15 10 2026
#ASSERT `the last day to appeal a deportation liability notice served` (Date 1 10 2026) EQUALS Date 29 10 2026

§§ `Employers (s 350)`

GIVEN entitled IS A BOOLEAN, knew IS A BOOLEAN, told IS A MAYBE DATE, notice IS A BOOLEAN
GIVETH AN `Employment facts`
work entitled knew told notice MEANS `Employment facts` OF today, entitled, knew, told, notice

#ASSERT `the employer commits an offence under s 350` (work FALSE TRUE NOTHING FALSE)
#ASSERT NOT `the employer commits an offence under s 350` (work TRUE TRUE NOTHING FALSE)
#ASSERT `the employer commits an offence under s 350` (work FALSE FALSE (JUST (Date 16 10 2025)) FALSE)
#ASSERT NOT `the employer commits an offence under s 350` (work FALSE FALSE (JUST (Date 15 10 2025)) FALSE)
#ASSERT NOT `the employer commits an offence under s 350` (work FALSE TRUE NOTHING TRUE)
#ASSERT NOT `the employer commits an offence under s 350` (work FALSE FALSE NOTHING FALSE)

§§ `The top-level goal`

#ASSERT `the immigration position for` (person FALSE TRUE (JUST (Date 30 6 2026)) EMPTY FALSE FALSE FALSE) `, as a resident` NOTHING `, on` today EQUALS `Immigration position` OF FALSE, TRUE, TRUE, JUST (Date 1 7 2026), JUST (Date 12 8 2026), FALSE
#ASSERT `the immigration position for` lawfulPerson `, as a resident` (JUST (resident 0 (LIST conviction (Date 1 1 2025) (Date 1 6 2025) 2 0 FALSE FALSE))) `, on` today EQUALS `Immigration position` OF FALSE, FALSE, FALSE, NOTHING, NOTHING, TRUE
