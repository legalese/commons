IMPORT prelude
IMPORT daydate

-- Immigration Act 2009 (New Zealand) — THE NOUNS.
--
-- Every fact the rule modules read, and nothing else: no rules, no #EVAL.
-- Source: ../registers/source-bundle/act_public_2009_51.txt (New Zealand
-- Legislation, version as at 10 July 2026, converted from the PCO XML).
-- Field names are unique across records.

§ `Immigration Act 2009 — the nouns`

§§ `Convictions (ss 15, 161)`

DECLARE Conviction HAS
    `offence committed on`                              IS A DATE
    `convicted on`                                      IS A DATE
    -- the longest imprisonment the court may impose, in years (3 months is
    -- 0.25).
    `maximum imprisonment available, in years`          IS A NUMBER
    -- the sentence of imprisonment imposed, in years (0 if none), counted
    -- under ss 15(2) and 161(4): deferred or suspended sentences included,
    -- cumulative sentences totalled, an indeterminate sentence by the period
    -- it is capable of running.
    `sentence of imprisonment, in years`                IS A NUMBER
    `committed while unlawfully in New Zealand or on a temporary entry class visa` IS A BOOLEAN
    `an offence against s 350(1), 351 or 351A`          IS A BOOLEAN

§§ `The person (ss 9, 15-17)`

DECLARE Person HAS
    `a New Zealand citizen`                             IS A BOOLEAN
    `holds a visa`                                      IS A BOOLEAN
    `has been granted entry permission`                 IS A BOOLEAN
    `arrived in New Zealand on`                         IS A DATE
    -- s 9(2)(a)-(b).
    `has been lawfully in New Zealand since arriving`   IS A BOOLEAN
    `last visa expired or was cancelled on`             IS A MAYBE DATE
    `convictions`                                       IS A LIST OF Conviction
    -- s 15(1)(c)-(f), (3).
    `subject to a period of prohibition on entry`       IS A BOOLEAN
    `removed or deported from New Zealand, outside the s 15(3) exceptions` IS A BOOLEAN
    `excluded from New Zealand under an enactment`      IS A BOOLEAN
    `removed, excluded or deported from another country` IS A BOOLEAN
    -- s 16: the Minister has reason to believe a listed matter.
    `the Minister has a s 16 reason to believe`         IS A BOOLEAN
    -- s 17(1).
    `a special direction or s 83 applies`               IS A BOOLEAN

§§ `Residence class visa holders (ss 161, 167)`

DECLARE `Resident facts` HAS
    -- s 161(5): the day the person first held a residence class visa.
    `first held a residence class visa on`              IS A DATE
    -- s 161(3): days in imprisonment following conviction since then.
    `days imprisoned since first holding the visa`      IS A NUMBER
    `resident convictions`                              IS A LIST OF Conviction

DECLARE `Liability period facts` HAS
    `liability arose on`                                IS A DATE
    -- s 167(2): days imprisoned, and days of suspension under ss 172, 212.
    `days imprisoned or suspended since`                IS A NUMBER

§§ `Employers (s 350)`

DECLARE `Employment facts` HAS
    `allowed the person to work on`                     IS A DATE
    `the person is entitled to do the work`             IS A BOOLEAN
    `the employer knew the person was not entitled`     IS A BOOLEAN
    -- s 350(3): written notice from an immigration officer.
    `informed in writing by an immigration officer on`  IS A MAYBE DATE
    -- s 350(4): within the notice period of the employment agreement.
    `within the employment agreement's minimum notice period` IS A BOOLEAN
