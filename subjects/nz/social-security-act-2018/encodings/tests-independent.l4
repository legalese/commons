IMPORT prelude
IMPORT daydate
IMPORT `ss-types`
IMPORT `ss-general`
IMPORT `ss-rates`
IMPORT `ss-entitlement`
IMPORT `ss-commencement`
IMPORT `ss-goal`

-- Independent tests: Social Security Act 2018 (NZ), main benefits.
-- Each #ASSERT encodes a scenario in independent-expectations.md (id in the comment).
-- Expected values were fixed before the encoding was read.

-- Helpers ------------------------------------------------------------------

DECIDE d0 IS Date 1 3 2027

GIVEN st IS AN `Immigration status`, ord IS A BOOLEAN, yrs IS A NUMBER, rf IS A BOOLEAN, rc IS A BOOLEAN, ryrs IS A NUMBER
GIVETH AN Applicant
DECIDE resA st ord yrs rf rc ryrs IS Applicant OF (Date 1 6 1995), st, ord, yrs, rf, rc, ryrs, FALSE, FALSE, `single`

GIVEN st IS AN `Immigration status`, other IS A BOOLEAN
GIVETH AN Applicant
DECIDE barA st other IS Applicant OF (Date 1 6 1995), st, TRUE, 3, FALSE, FALSE, 0, other, FALSE, `single`

GIVEN dob IS A DATE, kids IS A BOOLEAN, rel IS A `Relationship situation`
GIVETH AN Applicant
DECIDE pA dob kids rel IS Applicant OF dob, `a New Zealand citizen`, TRUE, 3, FALSE, FALSE, 0, FALSE, kids, rel

DECIDE baseA IS pA (Date 1 6 1995) FALSE `single`
DECIDE noResA IS Applicant OF (Date 1 6 1995), `a New Zealand citizen`, TRUE, 1, FALSE, FALSE, 0, FALSE, FALSE, `single`

DECIDE baseJ IS `Jobseeker facts` OF FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE
DECIDE dummyS IS `Sole parent facts` OF FALSE, NOTHING, FALSE
-- [Ported by the encoder: `Supported living facts` gained `the person cared for is the carer's spouse or partner` (FALSE) and `Commencement facts` gained `employment terminated, or notice given, before applying` (TRUE) in every construction; no expected value changed.]
DECIDE dummyL IS `Supported living facts` OF FALSE, 40, FALSE, FALSE, FALSE, FALSE, FALSE

GIVEN income IS A NUMBER
GIVETH A `Rate facts`
DECIDE jsR income IS `Rate facts` OF 342, `Income Test 1`, income, 0

GIVEN b IS A `Main benefit`, a IS AN Applicant, j IS A `Jobseeker facts`, s IS A `Sole parent facts`, l IS A `Supported living facts`, r IS A `Rate facts`, d IS A DATE
GIVETH A BOOLEAN
DECIDE ent b a j s l r d IS `is entitled to` b `, applicant` a `, jobseeker facts` j `, sole parent facts` s `, supported living facts` l `, rate facts` r `, on` d

GIVEN a IS AN Applicant, j IS A `Jobseeker facts`, r IS A `Rate facts`, d IS A DATE
GIVETH A BOOLEAN
DECIDE jsEnt a j r d IS ent `jobseeker support` a j dummyS dummyL r d

GIVEN a IS AN Applicant, s IS A `Sole parent facts`, d IS A DATE
GIVETH A BOOLEAN
DECIDE spEnt a s d IS ent `sole parent support` a baseJ s dummyL (jsR 0) d

GIVEN a IS AN Applicant, l IS A `Supported living facts`, d IS A DATE
GIVETH A BOOLEAN
DECIDE slEnt a l d IS ent `supported living payment for restricted work capacity or total blindness` a baseJ dummyS l (jsR 0) d

GIVEN a IS AN Applicant, l IS A `Supported living facts`, d IS A DATE
GIVETH A BOOLEAN
DECIDE crEnt a l d IS ent `supported living payment for caring for another person` a baseJ dummyS l (jsR 0) d

-- baseline sole parent facts: caring for child born 2020-05-01
DECIDE baseS IS `Sole parent facts` OF TRUE, JUST (Date 1 5 2020), FALSE
DECIDE spA IS pA (Date 1 6 1996) TRUE `single`
GIVEN rel IS A `Relationship situation`
GIVETH AN Applicant
DECIDE spRel rel IS pA (Date 1 6 1996) TRUE rel

-- baseline SLP facts
DECIDE baseL IS `Supported living facts` OF TRUE, 0, TRUE, FALSE, FALSE, FALSE, FALSE
DECIDE slA IS pA (Date 1 6 1986) FALSE `single`
DECIDE carerL IS `Supported living facts` OF FALSE, 40, FALSE, FALSE, FALSE, TRUE, FALSE

GIVEN t IS AN `Income test`, base IS A NUMBER, income IS A NUMBER
GIVETH A NUMBER
DECIDE rateT t base income IS `the weekly rate of` `jobseeker support` `, rate facts` (`Rate facts` OF base, t, income, 0)

GIVEN income IS A NUMBER, cc IS A NUMBER
GIVETH A NUMBER
DECIDE spRate income cc IS `the weekly rate of` `sole parent support` `, rate facts` (`Rate facts` OF 0, `Income Test 1`, income, cc)

GIVEN b IS A `Main benefit`, ent0 IS A DATE, ceased IS A MAYBE DATE, recd IS A DATE, n IS A NUMBER, listedJS IS A BOOLEAN
GIVETH A DATE
DECIDE cm b ent0 ceased recd n listedJS IS `the day the benefit commences, benefit` b `, facts` (`Commencement facts` OF ent0, ceased, recd, n, listedJS, TRUE)

DECIDE spsB IS `sole parent support`
DECIDE jsB IS `jobseeker support`

-- Goal 1: general requirements -------------------------------------------
-- G-01
#ASSERT `meets the residential requirement` (resA `a New Zealand citizen` TRUE 3 FALSE FALSE 0)
-- G-02
#ASSERT `meets the residential requirement` (resA `a New Zealand citizen` TRUE 2 FALSE FALSE 0)
-- G-03
#ASSERT NOT `meets the residential requirement` (resA `a New Zealand citizen` TRUE (729/365) FALSE FALSE 0)
-- G-04
#ASSERT `meets the residential requirement` (resA `a residence class visa holder` TRUE 3 FALSE FALSE 0)
-- G-05
#ASSERT NOT `meets the residential requirement` (resA `a New Zealand citizen` FALSE 3 FALSE FALSE 0)
-- G-06/G-07
#ASSERT `meets the residential requirement` (resA `a residence class visa holder` TRUE 1 TRUE FALSE 0)
-- G-08
#ASSERT NOT `meets the residential requirement` (resA `a residence class visa holder` TRUE 1 FALSE FALSE 0)
-- G-09
#ASSERT `meets the residential requirement` (resA `a temporary entry class visa holder` FALSE 0 FALSE TRUE 2)
-- G-10
#ASSERT NOT `meets the residential requirement` (resA `a temporary entry class visa holder` FALSE 0 FALSE TRUE 1)
-- G-11
#ASSERT NOT `meets the residential requirement` (resA `a temporary entry class visa holder` FALSE 0 FALSE FALSE 2)
-- G-12
#ASSERT NOT `meets the residential requirement` (resA `a temporary entry class visa holder` TRUE 1 TRUE FALSE 0)
-- G-13
#ASSERT `is barred by ss 18 or 19` (barA `unlawfully resident or present` FALSE)
-- G-14
#ASSERT `is barred by ss 18 or 19` (barA `a temporary entry class visa holder` FALSE)
-- G-15/16/17
#ASSERT `is barred by ss 18 or 19` (barA `a New Zealand citizen` TRUE)
-- G-18
#ASSERT NOT `is barred by ss 18 or 19` (barA `a New Zealand citizen` FALSE)
-- G-19
#ASSERT `meets the residential requirement` (resA `a temporary entry class visa holder` FALSE 0 FALSE TRUE (730/365))
