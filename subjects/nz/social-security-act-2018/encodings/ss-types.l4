IMPORT prelude
IMPORT daydate

-- Social Security Act 2018 (New Zealand), main benefits — THE NOUNS.
--
-- Every fact the rule modules read, and nothing else: no rules, no #EVAL.
-- Source: ../registers/source-bundle/act_public_2018_32.txt (New Zealand
-- Legislation, version as at 26 September 2026, converted from the PCO XML).
-- Field names are unique across records.

§ `Social Security Act 2018, main benefits — the nouns`

§§ `The applicant (ss 16, 18, 19)`

DECLARE `Immigration status` IS ONE OF
    `a New Zealand citizen`
    `a residence class visa holder`
    `a temporary entry class visa holder`
    `unlawfully resident or present`

-- s 30(a)-(e) and the alternative of a supporting partner.
DECLARE `Relationship situation` IS ONE OF
    `single`
    `spouse or partner has died`
    `marriage or civil union dissolved`
    `living apart and unsupported or inadequately maintained`
    `lost a partner's support through a sentence that prevents employment`
    `with a supporting spouse or partner`

DECLARE Applicant HAS
    `date of birth`                                     IS A DATE
    `immigration status`                                IS AN `Immigration status`
    -- s 16(2)(a).
    `ordinarily resident in New Zealand when first applying` IS A BOOLEAN
    `longest continuous residence since becoming a citizen or resident, in years` IS A NUMBER
    `a recognised refugee or protected person`          IS A BOOLEAN
    -- s 16(2)(b).
    `ordinarily resident in a reciprocity agreement country` IS A BOOLEAN
    `continuous residence in New Zealand before applying, in years` IS A NUMBER
    -- s 18.
    `receiving another main benefit, New Zealand superannuation or a veteran's pension` IS A BOOLEAN
    `has a dependent child`                             IS A BOOLEAN
    `relationship situation`                            IS A `Relationship situation`

§§ `Jobseeker support (ss 20-26)`

DECLARE `Jobseeker facts` HAS
    `in full-time employment`                           IS A BOOLEAN
    `losing earnings through a health condition or injury` IS A BOOLEAN
    -- s 22: available for and seeking work, exempt, or limited by health.
    `available for work under s 22`                     IS A BOOLEAN
    `a full-time student`                               IS A BOOLEAN
    `unemployed because of a strike`                    IS A BOOLEAN
    `left work for employment-related training`         IS A BOOLEAN
    -- s 24(2): income reduces the rate to zero only for a temporary period.
    `income high only for a temporary period`           IS A BOOLEAN

§§ `Sole parent support (ss 29-33)`

DECLARE `Sole parent facts` HAS
    `the mother or father of, and caring for, a dependent child under 14` IS A BOOLEAN
    `youngest dependent child born on`                  IS A MAYBE DATE
    -- s 32: in split care, and not the parent s 32(2) entitles.
    `in split care and not the entitled parent`         IS A BOOLEAN

§§ `Supported living payment (ss 34-40)`

DECLARE `Supported living facts` HAS
    -- s 35(2): expected to continue for the period in the regulations, or
    -- terminal.
    `restriction permanent`                             IS A BOOLEAN
    -- s 35(3): the hours a week the person can regularly work in open
    -- employment.
    `hours a week able to work regularly in open employment` IS A NUMBER
    `restriction from a health condition, or an accident, or from birth` IS A BOOLEAN
    `totally blind`                                     IS A BOOLEAN
    `restriction or blindness self-inflicted to qualify` IS A BOOLEAN
    -- s 40(1)(a).
    `required to give full-time care at home to someone who would otherwise need institutional care` IS A BOOLEAN
    -- s 40(1)(a): "(and who is not C's spouse or partner)" (added after the
    -- independent pass).
    `the person cared for is the carer's spouse or partner` IS A BOOLEAN

§§ `Rates and commencement (s 17, Schedule 4, s 316)`

DECLARE `Main benefit` IS ONE OF
    `jobseeker support`
    `jobseeker support on the ground of health condition, injury, or disability`
    `sole parent support`
    `supported living payment for restricted work capacity or total blindness`
    `supported living payment for caring for another person`

DECLARE `Income test` IS ONE OF
    `Income Test 1`
    `Income Test 2`
    `Income Test 3`
    `Income Test 4`

DECLARE `Rate facts` HAS
    -- Schedule 4 Parts 1 and 3 (lost in the conversion): the weekly base rate
    -- and its income test, for jobseeker support and the supported living
    -- payment.
    `base weekly rate`                                  IS A NUMBER
    `income test for the rate`                          IS AN `Income test`
    `weekly income of the person and partner`           IS A NUMBER
    -- Schedule 4 Part 2 cl 2: up to $20 of earnings used for childcare.
    `earnings used for childcare`                       IS A NUMBER

DECLARE `Commencement facts` HAS
    `became entitled on`                                IS A DATE
    -- s 316(1)(a)(ii): employment ended before applying.
    `employment ceased on`                              IS A MAYBE DATE
    `application received on`                           IS A DATE
    -- regulations under s 440.
    `stand-down period, in days`                        IS A NUMBER
    -- s 316(2)(d)-(e): jobseeker support to a sole parent, or after losing a
    -- partner's support.
    `jobseeker support of a kind in s 316(2)(d)-(e)`    IS A BOOLEAN
    -- s 316(1)(a)(ii): "if, before the person applied for the benefit, the
    -- person's employment terminated or the person is given notice of
    -- termination" (added after the independent pass).
    `employment terminated, or notice given, before applying` IS A BOOLEAN
