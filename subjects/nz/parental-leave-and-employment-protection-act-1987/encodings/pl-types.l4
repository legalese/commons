IMPORT prelude
IMPORT daydate

-- Parental Leave and Employment Protection Act 1987 (New Zealand) — THE
-- NOUNS.
--
-- Every fact the rule modules read, and nothing else: no rules, no #EVAL.
-- Source: ../registers/source-bundle/act_public_1987_129.txt (New Zealand
-- Legislation, version as at 1 July 2026, converted from the PCO XML).
-- Field names are unique across records.

§ `Parental Leave and Employment Protection Act 1987 — the nouns`

§§ `The child (ss 2, 2BA, 7, 71DA)`

DECLARE Child HAS
    -- "a child to be born to the employee or to the employee's spouse or
    -- partner", as against "any other case".
    `born to the person or their spouse or partner`     IS A BOOLEAN
    -- s 2 "the date certified in writing by a medical practitioner or midwife".
    `expected date of delivery`                         IS A DATE
    `date of birth`                                     IS A MAYBE DATE
    `first date the person or their spouse or partner becomes the primary carer` IS A DATE
    -- s 71DA(1)(b), (2)(b): "the date on which the 36th week of gestation
    -- would have ended had the child not been born prematurely".
    `the day the 36th week of gestation would have ended` IS A DATE
    `born alive`                                        IS A BOOLEAN

§§ `Who is the primary carer (s 7)`

DECLARE `Carer facts` HAS
    `is the biological mother`                          IS A BOOLEAN
    `is the biological mother's spouse or partner`      IS A BOOLEAN
    `has succeeded under s 72B`                         IS A BOOLEAN
    `has received a transfer under s 71E`               IS A BOOLEAN
    -- s 7(1)(b)(iii), (c): "has taken permanent primary responsibility for
    -- the care, development, and upbringing of the child" (for (b)(iii), "to
    -- the exclusion of the biological mother").
    `has taken permanent primary responsibility`        IS A BOOLEAN
    `age of the child in months when that responsibility was taken` IS A NUMBER
    -- s 7(1)(b)(iii)(C) "the biological mother either had not applied for,
    -- or did not qualify to apply for, a parental leave payment".
    `the mother had applied, and qualified, for a payment then` IS A BOOLEAN
    -- s 7(2): where 2 or more persons meet (c), the one jointly nominated.
    `is the person nominated under s 7(2)`              IS A BOOLEAN
    `another person also meets s 7(1)(c)`               IS A BOOLEAN

DECLARE `Primary carer kind` IS ONE OF
    `(a) the biological mother`
    `(b)(i) the mother's spouse or partner who has succeeded under s 72B`
    `(b)(ii) the mother's spouse or partner to whom she transferred under s 71E`
    `(b)(iii) the mother's spouse or partner who took permanent primary responsibility`
    `(c) another person who took permanent primary responsibility`
    `not the primary carer`

§§ `The employment tests (s 2BA)`

DECLARE `Employment test` IS ONE OF
    `neither employment test`
    `the 6-month employment test`
    `the 12-month employment test`

-- s 2BA(1): "employed by the same employer for at least an average of 10
-- hours a week in the 6 [or 12] months immediately preceding the expected
-- date of delivery ... or assumption of responsibility". The averages are
-- taken after s 72A (hours of paid leave, agreed unpaid leave, ACC, and so
-- on count as hours of employment).
DECLARE `Employment with the employer` HAS
    `employed by the same employer since`               IS A DATE
    `average weekly hours over the 6 months`            IS A NUMBER
    `average weekly hours over the 12 months`           IS A NUMBER

§§ `The history (ss 6, 8(2), 17(2), 23(2), 71D(2), 71F, 71G)`

DECLARE `Leave history` HAS
    `previously took parental leave for this child`     IS A BOOLEAN
    `previously took partner's leave for this child`    IS A BOOLEAN
    `previous parental leave for another child ended on` IS A MAYBE DATE
    `the mother transferred her payment entitlement under s 71E` IS A BOOLEAN
    `primary carer leave taken by the person, in weeks` IS A NUMBER
    `primary carer leave taken by the spouse or partner, in weeks` IS A NUMBER
    `extended leave already taken by the person, in weeks` IS A NUMBER
    `extended leave already taken by the spouse or partner, in weeks` IS A NUMBER

§§ `Parental leave payments (Part 7A)`

DECLARE `Payment facts` HAS
    `an employee for the payment`                       IS A BOOLEAN
    `self-employed for the payment`                     IS A BOOLEAN
    `ordinary weekly pay before payments start`         IS A NUMBER
    `net self-employed income over the 12 months`       IS A NUMBER
    `net self-employed income over the 6 months`        IS A NUMBER
    `elects the 6-month period under s 71CBA`           IS A BOOLEAN
    -- s 71CBA(4): "the number of complete weeks during which the eligible
    -- self-employed person was not working in a circumstance described in
    -- section 71CB(2)".
    `complete weeks not working under s 71CB(2)`        IS A NUMBER
    -- s 71M as adjusted under s 71N, or increased under s 71O.
    `the maximum weekly rate in force`                  IS A NUMBER
    -- s 71N(4): "the highest rate of the minimum wage that applies under the
    -- Minimum Wage Act 1983".
    `the highest minimum wage rate per hour`            IS A NUMBER
    `previous payment period for another child ended on` IS A MAYBE DATE
    `the person or spouse has received payments for this child` IS A BOOLEAN
    `parental tax credit has been received for the child` IS A BOOLEAN
    `stops working or takes leave for the payment period` IS A BOOLEAN
    -- s 2BA(4): each of the 52 weeks, hours as an employee and as a
    -- self-employed person (after ss 72A, 71CB(2)); s 71CAA: gross weekly
    -- earnings from all employments.
    `hours as an employee in each of the 52 weeks`      IS A LIST OF NUMBER
    `hours self-employed in each of the 52 weeks`       IS A LIST OF NUMBER
    `gross earnings in each of the 52 weeks`            IS A LIST OF NUMBER

§§ `The case`

DECLARE `Parental leave case` HAS
    `the child concerned`                               IS A Child
    `the carer facts`                                   IS A `Carer facts`
    -- ss 17(1)(a)-(b), 23(1)(a)(ii): "is the spouse or partner of the primary
    -- carer ... and assumes or intends to assume responsibility for the care
    -- of that child".
    `is the primary carer's spouse or partner and assumes care` IS A BOOLEAN
    `employment, if an employee`                        IS A MAYBE `Employment with the employer`
    `the spouse or partner's employment test`           IS AN `Employment test`
    `the leave history`                                 IS A `Leave history`
    `the payment facts`                                 IS A `Payment facts`
    `returned to work on`                               IS A MAYBE DATE
