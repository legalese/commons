#ASSERT (`the parental leave position for` casePartnerS6)'s `extended leave still available, in weeks` EQUALS 0
-- s 19
#ASSERT `the partner's leave, in weeks, for` `the 12-month employment test` EQUALS 2
#ASSERT `the partner's leave, in weeks, for` `the 6-month employment test` EQUALS 1
#ASSERT `the partner's leave, in weeks, for` `neither employment test` EQUALS 0
-- S80
#ASSERT `the first day partner's leave may begin at the employee's option, for` (kid (Date 10 3 2026) (Date 1 3 2026)) `, discharged` NOTHING EQUALS Date 17 2 2026
-- S82, S83
#ASSERT `the last day partner's leave may begin at the employee's option, for` (kid (Date 10 3 2026) (Date 1 3 2026)) `, discharged` NOTHING EQUALS Date 22 3 2026
#ASSERT `the last day partner's leave may begin at the employee's option, for` (kid (Date 10 3 2026) (Date 1 3 2026)) `, discharged` (JUST (Date 15 3 2026)) EQUALS Date 22 3 2026
-- S84
#ASSERT `the last day partner's leave may begin at the employee's option, for` (kid (Date 10 3 2026) (Date 1 3 2026)) `, discharged` (JUST (Date 10 4 2026)) EQUALS Date 10 4 2026
-- S87
#ASSERT `the first day partner's leave may begin at the employee's option, for` (adopted (Date 1 5 2026)) `, discharged` NOTHING EQUALS Date 10 4 2026
#ASSERT `the last day partner's leave may begin at the employee's option, for` (adopted (Date 1 5 2026)) `, discharged` NOTHING EQUALS Date 22 5 2026
-- Unborn child: s 21(a)(ii) end not yet fixed
#ASSERT REFUSED (`the last day partner's leave may begin at the employee's option, for` (Child OF TRUE, (Date 10 3 2026), NOTHING, (Date 10 3 2026), (Date 10 2 2026), TRUE) `, discharged` NOTHING)

§§ `B. Extended leave (ss 23, 26-28)`

-- S88
#ASSERT `the extended leave remaining, in weeks, own test` `the 12-month employment test` `, partner's test` `neither employment test` `, history` (hist 26 0 0 0) EQUALS 26
-- S89
#ASSERT `the extended leave remaining, in weeks, own test` `the 6-month employment test` `, partner's test` `neither employment test` `, history` (hist 26 0 0 0) EQUALS 0
-- S90
#ASSERT `the extended leave remaining, in weeks, own test` `the 12-month employment test` `, partner's test` `neither employment test` `, history` (hist 10 0 0 0) EQUALS 42
-- S91: 30 weeks primary carer leave, 4 of them s 9(2) excess
#ASSERT `the extended leave remaining, in weeks, own test` `the 12-month employment test` `, partner's test` `neither employment test` `, history` (hist 30 0 0 0) EQUALS 26
-- S92 (partner's view, spouse took 26 PCL)
#ASSERT `the extended leave remaining, in weeks, own test` `the 12-month employment test` `, partner's test` `the 12-month employment test` `, history` (hist 0 26 0 0) EQUALS 26
#ASSERT (`the parental leave position for` casePartner12)'s `extended leave still available, in weeks` EQUALS 26
-- S93
#ASSERT `the extended leave remaining, in weeks, own test` `the 6-month employment test` `, partner's test` `the 6-month employment test` `, history` (hist 26 0 0 0) EQUALS 0
#ASSERT `the extended leave remaining, in weeks, own test` `the 6-month employment test` `, partner's test` `the 6-month employment test` `, history` (hist 0 26 0 0) EQUALS 0
-- S94: partner (6-month), primary carer (12-month) took 26
#ASSERT `the extended leave remaining, in weeks, own test` `the 6-month employment test` `, partner's test` `the 12-month employment test` `, history` (hist 0 26 0 0) EQUALS 26
-- S94b: same partner, before any primary carer leave: capped at 26 individually
#ASSERT `the extended leave remaining, in weeks, own test` `the 6-month employment test` `, partner's test` `the 12-month employment test` `, history` noHist EQUALS 26
-- S95
#ASSERT `the extended leave remaining, in weeks, own test` `the 6-month employment test` `, partner's test` `the 12-month employment test` `, history` (hist 26 0 0 0) EQUALS 0
#ASSERT `the extended leave remaining, in weeks, own test` `the 12-month employment test` `, partner's test` `the 6-month employment test` `, history` (hist 0 26 0 0) EQUALS 26
