IMPORT prelude
IMPORT daydate
IMPORT `pl-types`
IMPORT `pl-eligibility`
IMPORT `pl-leave`
IMPORT `pl-protection`
IMPORT `pl-payments`
IMPORT `pl-goal`

-- Independent tests for the Parental Leave and Employment Protection Act 1987
-- (NZ) encoding. Every expected value comes from independent-expectations.md,
-- which was written from the Act alone before the encoding was read. A failing
-- assertion is a finding, not a bug in this file. Scenario numbers (S..) refer
-- to that file.

§ `Independent tests`

§§ `Fixtures`

GIVEN n IS A NUMBER
      h IS A NUMBER
GIVETH A LIST OF NUMBER
wk n h MEANS append (replicate n h) (replicate (52 MINUS n) 0)

GIVEN n1 IS A NUMBER
      h1 IS A NUMBER
      n2 IS A NUMBER
      h2 IS A NUMBER
GIVETH A LIST OF NUMBER
wk2 n1 h1 n2 h2 MEANS append (replicate n1 h1) (append (replicate n2 h2) (replicate (52 MINUS (n1 PLUS n2)) 0))

GIVEN owp IS A NUMBER
      earn IS A LIST OF NUMBER
      hrs IS A LIST OF NUMBER
GIVETH A `Payment facts`
empPay owp earn hrs MEANS `Payment facts` OF TRUE, FALSE, owp, 0, 0, FALSE, 0, 811.05, 23.95, NOTHING, FALSE, FALSE, TRUE, hrs, (wk 0 0), earn

GIVEN hrs IS A LIST OF NUMBER
GIVETH A `Payment facts`
empHours hrs MEANS empPay 0 (wk 0 0) hrs

GIVEN hrs IS A LIST OF NUMBER
GIVETH A `Payment facts`
seHours hrs MEANS `Payment facts` OF FALSE, TRUE, 0, 0, 0, FALSE, 0, 811.05, 23.95, NOTHING, FALSE, FALSE, TRUE, (wk 0 0), hrs, (wk 0 0)

GIVEN e1 IS A LIST OF NUMBER
      s1 IS A LIST OF NUMBER
GIVETH A `Payment facts`
mixedHours e1 s1 MEANS `Payment facts` OF TRUE, TRUE, 0, 0, 0, FALSE, 0, 811.05, 23.95, NOTHING, FALSE, FALSE, TRUE, e1, s1, (wk 0 0)

GIVEN net12 IS A NUMBER
      net6 IS A NUMBER
      six IS A BOOLEAN
      off IS A NUMBER
GIVETH A `Payment facts`
sePay net12 net6 six off MEANS `Payment facts` OF FALSE, TRUE, 0, net12, net6, six, off, 811.05, 23.95, NOTHING, FALSE, FALSE, TRUE, (wk 0 0), (wk 52 30), (wk 0 0)

GIVEN owp IS A NUMBER
      earn IS A LIST OF NUMBER
      net12 IS A NUMBER
GIVETH A `Payment facts`
bothPay owp earn net12 MEANS `Payment facts` OF TRUE, TRUE, owp, net12, 0, FALSE, 0, 811.05, 23.95, NOTHING, FALSE, FALSE, TRUE, (wk 52 30), (wk 52 30), earn

GIVEN cap IS A NUMBER
      earn IS A LIST OF NUMBER
GIVETH A `Payment facts`
capPay cap earn MEANS `Payment facts` OF TRUE, FALSE, 0, 0, 0, FALSE, 0, cap, 23.95, NOTHING, FALSE, FALSE, TRUE, (wk 52 30), (wk 0 0), earn

GIVEN prev IS A MAYBE DATE
      recd IS A BOOLEAN
      ptc IS A BOOLEAN
      stops IS A BOOLEAN
      hrs IS A LIST OF NUMBER
GIVETH A `Payment facts`
payX prev recd ptc stops hrs MEANS `Payment facts` OF TRUE, FALSE, 1000, 0, 0, FALSE, 0, 811.05, 23.95, prev, recd, ptc, stops, hrs, (wk 0 0), (wk 52 1000)

GIVETH A `Payment facts`
stdPay MEANS payX NOTHING FALSE FALSE TRUE (wk 52 30)

GIVETH A `Carer facts`
mum MEANS `Carer facts` OF TRUE, FALSE, FALSE, FALSE, FALSE, 0, FALSE, FALSE, FALSE

GIVETH A `Carer facts`
spouseNoResp MEANS `Carer facts` OF FALSE, TRUE, FALSE, FALSE, FALSE, 0, FALSE, FALSE, FALSE

GIVETH A `Carer facts`
spouseTransfer MEANS `Carer facts` OF FALSE, TRUE, FALSE, TRUE, FALSE, 0, FALSE, FALSE, FALSE

GIVETH A `Carer facts`
spouseB3 MEANS `Carer facts` OF FALSE, TRUE, FALSE, FALSE, TRUE, 3, FALSE, FALSE, FALSE

GIVETH A `Carer facts`
adopter MEANS `Carer facts` OF FALSE, FALSE, FALSE, FALSE, TRUE, 24, FALSE, TRUE, FALSE

GIVEN edd IS A DATE
      dob IS A DATE
GIVETH A Child
kid edd dob MEANS Child OF TRUE, edd, (JUST dob), edd, (`the day` (0 MINUS 28) `days after` edd), TRUE

GIVEN edd IS A DATE
      dob IS A DATE
      w36 IS A DATE
      alive IS A BOOLEAN
GIVETH A Child
kidP edd dob w36 alive MEANS Child OF TRUE, edd, (JUST dob), edd, w36, alive

GIVEN first IS A DATE
GIVETH A Child
adopted first MEANS Child OF FALSE, first, NOTHING, first, first, TRUE

GIVEN since IS A DATE
      a6 IS A NUMBER
      a12 IS A NUMBER
GIVETH A MAYBE `Employment with the employer`
emp since a6 a12 MEANS JUST (`Employment with the employer` OF since, a6, a12)

GIVEN since IS A DATE
      a6 IS A NUMBER
      a12 IS A NUMBER
GIVETH AN `Employment with the employer`
empR since a6 a12 MEANS `Employment with the employer` OF since, a6, a12

GIVEN p1 IS A NUMBER
      p2 IS A NUMBER
      x1 IS A NUMBER
      x2 IS A NUMBER
GIVETH A `Leave history`
hist p1 p2 x1 x2 MEANS `Leave history` OF FALSE, FALSE, NOTHING, FALSE, p1, p2, x1, x2

GIVETH A `Leave history`
noHist MEANS hist 0 0 0 0

GIVEN ch IS A Child
      cf IS A `Carer facts`
      assumes IS A BOOLEAN
      em IS A MAYBE `Employment with the employer`
      sp IS AN `Employment test`
      hh IS A `Leave history`
      pp IS A `Payment facts`
GIVETH A `Parental leave case`
mkCase ch cf assumes em sp hh pp MEANS `Parental leave case` OF ch, cf, assumes, em, sp, hh, pp, NOTHING

GIVETH A Child
baseKid MEANS kid (Date 15 9 2026) (Date 15 9 2026)

GIVETH A MAYBE `Employment with the employer`
emp12 MEANS emp (Date 1 1 2020) 30 30

GIVETH A MAYBE `Employment with the employer`
emp6 MEANS emp (Date 1 1 2026) 30 0

GIVETH A MAYBE `Employment with the employer`
emp5 MEANS emp (Date 1 6 2026) 30 0

GIVETH A `Parental leave case`
caseMum12 MEANS mkCase baseKid mum FALSE emp12 `the 12-month employment test` noHist stdPay

GIVETH A `Parental leave case`
caseMum6 MEANS mkCase baseKid mum FALSE emp6 `the 6-month employment test` noHist stdPay

GIVETH A `Parental leave case`
caseMum5 MEANS mkCase baseKid mum FALSE emp5 `the 12-month employment test` noHist stdPay

GIVETH A `Parental leave case`
casePartner12 MEANS mkCase baseKid spouseNoResp TRUE emp12 `the 12-month employment test` (hist 0 26 0 0) stdPay

GIVETH A `Parental leave case`
casePartner6 MEANS mkCase baseKid spouseNoResp TRUE emp6 `the 12-month employment test` noHist stdPay

GIVETH A `Parental leave case`
casePartner5 MEANS mkCase baseKid spouseNoResp TRUE emp5 `the 12-month employment test` noHist stdPay

GIVETH A `Parental leave case`
casePartnerNoCare MEANS mkCase baseKid spouseNoResp FALSE emp12 `the 12-month employment test` noHist stdPay

GIVETH A `Parental leave case`
casePartnerPrevPL MEANS mkCase baseKid spouseNoResp TRUE emp12 `the 12-month employment test` (`Leave history` OF FALSE, TRUE, NOTHING, FALSE, 0, 0, 0, 0) stdPay

GIVETH A `Parental leave case`
caseMumTransferred MEANS mkCase baseKid mum TRUE emp12 `the 12-month employment test` (`Leave history` OF FALSE, FALSE, NOTHING, TRUE, 0, 0, 0, 0) stdPay

GIVETH A `Parental leave case`
caseMumPrevPCL MEANS mkCase baseKid mum FALSE emp12 `the 12-month employment test` (`Leave history` OF TRUE, FALSE, NOTHING, FALSE, 0, 0, 0, 0) stdPay

GIVETH A `Parental leave case`
caseB3PrevPL MEANS mkCase (kid (Date 15 9 2026) (Date 15 9 2026)) spouseB3 FALSE emp12 `the 12-month employment test` (`Leave history` OF TRUE, TRUE, NOTHING, FALSE, 0, 0, 0, 0) stdPay

-- s 6: partner with previous parental leave for another child ending 31 Jan 2026; this child due 15 Mar 2026.
GIVETH A `Parental leave case`
casePartnerS6 MEANS mkCase (kid (Date 15 3 2026) (Date 15 3 2026)) spouseNoResp TRUE emp12 `the 12-month employment test` (`Leave history` OF FALSE, FALSE, (JUST (Date 31 1 2026)), FALSE, 0, 0, 0, 0) stdPay

GIVETH A `Parental leave case`
caseMumS6 MEANS mkCase (kid (Date 15 3 2026) (Date 15 3 2026)) mum FALSE emp12 `the 12-month employment test` (`Leave history` OF FALSE, FALSE, (JUST (Date 31 1 2026)), FALSE, 0, 0, 0, 0) stdPay

-- s 6 timing: previous leave ended 31 Jan 2026; EDD 25 Jul 2026 but born (and leave begins) 2 Aug 2026.
GIVETH A `Parental leave case`
caseMumLate MEANS mkCase (kid (Date 25 7 2026) (Date 2 8 2026)) mum FALSE emp12 `the 12-month employment test` (`Leave history` OF FALSE, FALSE, (JUST (Date 31 1 2026)), FALSE, 0, 0, 0, 0) stdPay

-- s 71F timing: previous payment period ended 31 Jan 2026; EDD 25 Jul 2026, born and payments begin 2 Aug 2026.
GIVETH A `Parental leave case`
caseMum71F MEANS mkCase (kid (Date 25 7 2026) (Date 2 8 2026)) mum FALSE emp12 `the 12-month employment test` noHist (payX (JUST (Date 31 1 2026)) FALSE FALSE TRUE (wk 52 30))

GIVETH A `Parental leave case`
caseAdopt MEANS mkCase (adopted (Date 1 4 2026)) adopter FALSE (emp (Date 1 10 2025) 30 0) `neither employment test` noHist stdPay

GIVETH A `Parental leave case`
caseOld MEANS mkCase (kid (Date 29 6 2020) (Date 28 6 2020)) mum FALSE emp12 `the 12-month employment test` noHist stdPay

§§ `A. Primary carer (s 7)`

-- S1, S2
#ASSERT `the primary carer kind of` mum EQUALS `(a) the biological mother`
-- S3, S6
#ASSERT `the primary carer kind of` spouseB3 EQUALS `(b)(iii) the mother's spouse or partner who took permanent primary responsibility`
-- S4: child 13 months
#ASSERT `the primary carer kind of` (`Carer facts` OF FALSE, TRUE, FALSE, FALSE, TRUE, 13, FALSE, FALSE, FALSE) EQUALS `not the primary carer`
-- S4b: child exactly 12 months is not "under 1 year"
#ASSERT `the primary carer kind of` (`Carer facts` OF FALSE, TRUE, FALSE, FALSE, TRUE, 12, FALSE, FALSE, FALSE) EQUALS `not the primary carer`
-- S5: mother had applied and qualified
#ASSERT `the primary carer kind of` (`Carer facts` OF FALSE, TRUE, FALSE, FALSE, TRUE, 3, TRUE, FALSE, FALSE) EQUALS `not the primary carer`
-- S7
#ASSERT `the primary carer kind of` spouseTransfer EQUALS `(b)(ii) the mother's spouse or partner to whom she transferred under s 71E`
-- S8
#ASSERT `the primary carer kind of` (`Carer facts` OF FALSE, TRUE, TRUE, FALSE, FALSE, 0, FALSE, FALSE, FALSE) EQUALS `(b)(i) the mother's spouse or partner who has succeeded under s 72B`
-- S9
#ASSERT `the primary carer kind of` spouseNoResp EQUALS `not the primary carer`
-- S10
#ASSERT `the primary carer kind of` adopter EQUALS `(c) another person who took permanent primary responsibility`
-- S10b: a sole carer (aunt) needs no s 7(2) nomination, which applies only "if 2 or more persons meet the criterion"
#ASSERT `the primary carer kind of` (`Carer facts` OF FALSE, FALSE, FALSE, FALSE, TRUE, 48, FALSE, FALSE, FALSE) EQUALS `(c) another person who took permanent primary responsibility`
-- S11: exactly 6 years
#ASSERT `the primary carer kind of` (`Carer facts` OF FALSE, FALSE, FALSE, FALSE, TRUE, 72, FALSE, TRUE, FALSE) EQUALS `not the primary carer`
-- S12: 5 years 11 months
#ASSERT `the primary carer kind of` (`Carer facts` OF FALSE, FALSE, FALSE, FALSE, TRUE, 71, FALSE, TRUE, FALSE) EQUALS `(c) another person who took permanent primary responsibility`
-- S13, S14: no permanent primary responsibility (foster, grandmother)
#ASSERT `the primary carer kind of` (`Carer facts` OF FALSE, FALSE, FALSE, FALSE, FALSE, 24, FALSE, TRUE, FALSE) EQUALS `not the primary carer`
-- S15: the non-nominated adoptive parent; S16 no nomination
-- [Ported by the encoder: Carer facts gained `another person also meets s 7(1)(c)`; TRUE here (two adoptive parents), FALSE in every other call.]
#ASSERT `the primary carer kind of` (`Carer facts` OF FALSE, FALSE, FALSE, FALSE, TRUE, 24, FALSE, FALSE, TRUE) EQUALS `not the primary carer`
#ASSERT `is the primary carer` mum EQUALS TRUE
#ASSERT `is the primary carer` spouseNoResp EQUALS FALSE

§§ `A. Employment tests (s 2BA(1))`

-- S21
#ASSERT `the employment test met by` (empR (Date 15 3 2026) 10 0) `before` (Date 15 9 2026) EQUALS `the 6-month employment test`
-- S22
#ASSERT `the employment test met by` (empR (Date 15 3 2026) 9.9 0) `before` (Date 15 9 2026) EQUALS `neither employment test`
-- S23
#ASSERT `the employment test met by` (empR (Date 16 3 2026) 40 0) `before` (Date 15 9 2026) EQUALS `neither employment test`
-- S24
#ASSERT `the employment test met by` (empR (Date 15 9 2025) 10 10) `before` (Date 15 9 2026) EQUALS `the 12-month employment test`
-- S25 / S24b: 11 months 30 days
#ASSERT `the employment test met by` (empR (Date 16 9 2025) 40 40) `before` (Date 15 9 2026) EQUALS `the 6-month employment test`
-- S24c: 12 months but average 9.9 over 12, 10 over 6
#ASSERT `the employment test met by` (empR (Date 15 9 2025) 10 9.9) `before` (Date 15 9 2026) EQUALS `the 6-month employment test`
-- S26
#ASSERT `the employment test met by` (empR (Date 1 1 2020) 8 10) `before` (Date 15 9 2026) EQUALS `the 12-month employment test`
#ASSERT `meets an employment test` `neither employment test` EQUALS FALSE
-- Adoption: tests look back from the date of assuming care (1 Apr 2026); employed since 1 Oct 2025
#ASSERT `the employment test for` caseAdopt EQUALS `the 6-month employment test`
#ASSERT `the date the tests look back from, for` (adopted (Date 1 4 2026)) EQUALS Date 1 4 2026
#ASSERT `the date the tests look back from, for` baseKid EQUALS Date 15 9 2026

§§ `A. Payment threshold test (s 2BA(4))`

-- S35
#ASSERT `meets the parental leave payment threshold test` (empHours (wk 26 10)) EQUALS TRUE
-- S36 (revised reading, see expectations file): only 25 weeks of employment
#ASSERT `meets the parental leave payment threshold test` (empHours (wk 25 40)) EQUALS FALSE
-- S37
#ASSERT `meets the parental leave payment threshold test` (empHours (wk 26 9.9)) EQUALS FALSE
-- S37b: every week 9 hours
#ASSERT `meets the parental leave payment threshold test` (empHours (wk 52 9)) EQUALS FALSE
-- S37c: 22 weeks at 12 + 30 weeks at 9 (best 26 average 11.5)
#ASSERT `meets the parental leave payment threshold test` (empHours (wk2 22 12 30 9)) EQUALS TRUE
-- S37d: 1 week at 135 + 26 weeks at 5 (27 weeks employed, best-26 average 10)
#ASSERT `meets the parental leave payment threshold test` (empHours (wk2 1 135 26 5)) EQUALS TRUE
-- S39
#ASSERT `meets the parental leave payment threshold test` (seHours (wk 26 10)) EQUALS TRUE
-- S39b
#ASSERT `meets the parental leave payment threshold test` (seHours (wk 26 9.9)) EQUALS FALSE
-- S41: 13 weeks employee at 20 h, 13 other weeks self-employed at 20 h (s 2AD separately)
#ASSERT `meets the parental leave payment threshold test` (mixedHours (wk 13 20) (wk2 13 0 13 20)) EQUALS FALSE
-- Self-employed with no hours at all
#ASSERT `meets the parental leave payment threshold test` (seHours (wk 0 0)) EQUALS FALSE

§§ `A. Sections 4, 6`

-- S42
#ASSERT `Parts 1 to 5 apply, other arrangement as favourable:` TRUE `, s 4(2) matters it addresses` 5 EQUALS FALSE
-- S43
#ASSERT `Parts 1 to 5 apply, other arrangement as favourable:` TRUE `, s 4(2) matters it addresses` 4 EQUALS TRUE
-- S44
#ASSERT `Parts 1 to 5 apply, other arrangement as favourable:` FALSE `, s 4(2) matters it addresses` 5 EQUALS TRUE
-- S45
#ASSERT `s 6 bars leave, previous leave for another child ended` (JUST (Date 31 1 2026)) `, leave starting` (Date 31 7 2026) EQUALS TRUE
-- S46
#ASSERT `s 6 bars leave, previous leave for another child ended` (JUST (Date 31 1 2026)) `, leave starting` (Date 1 8 2026) EQUALS FALSE
-- S47
#ASSERT `s 6 bars leave, previous leave for another child ended` (JUST (Date 31 1 2026)) `, leave starting` (Date 15 3 2026) EQUALS TRUE
#ASSERT `s 6 bars leave, previous leave for another child ended` NOTHING `, leave starting` (Date 15 3 2026) EQUALS FALSE

§§ `B. Primary carer leave (ss 8-11, 15)`

-- S51 (12-month mother)
#ASSERT (`the parental leave position for` caseMum12)'s `the employment test met` EQUALS `the 12-month employment test`
#ASSERT (`the parental leave position for` caseMum12)'s `the primary carer` EQUALS `(a) the biological mother`
#ASSERT (`the parental leave position for` caseMum12)'s `may take primary carer leave` EQUALS TRUE
#ASSERT (`the parental leave position for` caseMum12)'s `primary carer leave, in weeks` EQUALS 26
#ASSERT (`the parental leave position for` caseMum12)'s `may take partner's leave` EQUALS FALSE
#ASSERT (`the parental leave position for` caseMum12)'s `extended leave still available, in weeks` EQUALS 52
#ASSERT (`the parental leave position for` caseMum12)'s `may request negotiated carer leave` EQUALS FALSE
-- S50 (6-month mother, 6-month partner)
#ASSERT (`the parental leave position for` caseMum6)'s `the employment test met` EQUALS `the 6-month employment test`
#ASSERT (`the parental leave position for` caseMum6)'s `may take primary carer leave` EQUALS TRUE
#ASSERT (`the parental leave position for` caseMum6)'s `primary carer leave, in weeks` EQUALS 26
#ASSERT (`the parental leave position for` caseMum6)'s `extended leave still available, in weeks` EQUALS 26
-- S52 / S38 / S109: fails both tests, meets payment threshold -> negotiated carer leave
#ASSERT (`the parental leave position for` caseMum5)'s `the employment test met` EQUALS `neither employment test`
#ASSERT (`the parental leave position for` caseMum5)'s `may take primary carer leave` EQUALS FALSE
#ASSERT (`the parental leave position for` caseMum5)'s `extended leave still available, in weeks` EQUALS 0
#ASSERT (`the parental leave position for` caseMum5)'s `may request negotiated carer leave` EQUALS TRUE
#ASSERT (`the parental leave position for` caseMum5)'s `entitled to parental leave payments` EQUALS TRUE
-- S53: partner is not the primary carer
#ASSERT (`the parental leave position for` casePartner12)'s `may take primary carer leave` EQUALS FALSE
#ASSERT (`the parental leave position for` casePartner12)'s `entitled to parental leave payments` EQUALS FALSE
-- S54
#ASSERT (`the parental leave position for` caseMumPrevPCL)'s `may take primary carer leave` EQUALS FALSE
-- S55: (b)(iii) carer is not barred by s 8(2)
#ASSERT (`the parental leave position for` caseB3PrevPL)'s `may take primary carer leave` EQUALS TRUE
-- S45 via the goal: s 6 bars primary carer leave (EDD 15 Mar 2026)
#ASSERT (`the parental leave position for` caseMumS6)'s `may take primary carer leave` EQUALS FALSE
-- S6-ext: s 6 also bars extended leave ("parental leave" includes extended leave)
#ASSERT (`the parental leave position for` caseMumS6)'s `extended leave still available, in weeks` EQUALS 0
-- S46b: s 6 measured when leave begins (2 Aug 2026), not at the EDD (25 Jul 2026)
#ASSERT (`the parental leave position for` caseMumLate)'s `may take primary carer leave` EQUALS TRUE
-- S56: certificate start 10 weeks before EDD -> 30 weeks
#ASSERT `the most primary carer leave, in weeks, starting` (Date 7 7 2026) `, expected delivery` (Date 15 9 2026) `, begun under s 13 or 14:` TRUE EQUALS 30
-- S57: employer direction 7 weeks before -> 27
#ASSERT `the most primary carer leave, in weeks, starting` (Date 28 7 2026) `, expected delivery` (Date 15 9 2026) `, begun under s 13 or 14:` TRUE EQUALS 27
-- S58: s 11 start -> 26
#ASSERT `the most primary carer leave, in weeks, starting` (Date 4 8 2026) `, expected delivery` (Date 15 9 2026) `, begun under s 13 or 14:` FALSE EQUALS 26
-- S59: certificate 4 weeks before -> 26
#ASSERT `the most primary carer leave, in weeks, starting` (Date 18 8 2026) `, expected delivery` (Date 15 9 2026) `, begun under s 13 or 14:` TRUE EQUALS 26
-- S63 / S64
#ASSERT `the earliest start the employee may choose, from` (Date 15 9 2026) EQUALS Date 4 8 2026
-- S69 / S70
#ASSERT `the special leave without pay, in days` EQUALS 10

