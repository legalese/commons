IMPORT prelude
IMPORT daydate
IMPORT `taa-types`
IMPORT `taa-dates`
IMPORT `taa-reporting`
IMPORT `taa-returns`
IMPORT `taa-penalties`
IMPORT `taa-goal`

-- Independent tests: Tax Administration Act 1994 (NZ). Expected values come
-- from independent-expectations.md, written before the encoding was opened.

GIVETH A LIST OF DATE
mdays MEANS LIST Date 10 7 2026, Date 25 6 2027

-- Employer helpers: (electronic, PAYE+ESCT, new, s 23G exemption, started, twice-monthly)
GIVEN amt IS A NUMBER
GIVETH AN Employer
paper amt MEANS Employer OF FALSE, amt, FALSE, FALSE, NOTHING, FALSE

GIVETH AN Employer
onlineEmp MEANS Employer OF TRUE, 100000, FALSE, FALSE, NOTHING, FALSE

GIVETH AN Employer
paperEmp MEANS Employer OF FALSE, 10000, FALSE, FALSE, NOTHING, FALSE

GIVETH AN Employer
twiceEmp MEANS Employer OF FALSE, 10000, FALSE, FALSE, NOTHING, TRUE

GIVEN pd IS A DATE
GIVETH A DATE
onl pd MEANS `the last day to deliver employment income information, employer` onlineEmp `, payday` pd `, Matariki days` mdays

GIVEN pd IS A DATE
GIVETH A DATE
pap pd MEANS `the last day to deliver employment income information, employer` paperEmp `, payday` pd `, Matariki days` mdays

GIVEN pd IS A DATE
GIVETH A DATE
twm pd MEANS `the last day to deliver employment income information, employer` twiceEmp `, payday` pd `, Matariki days` mdays

GIVEN d IS A DATE
GIVETH A BOOLEAN
wd d MEANS `is a working day` d `, Matariki days` mdays

-- Filer helper: (tax year ending 31 March, exempt only, approved year end, filed, net)
GIVEN ty IS A NUMBER
      ends IS A MAYBE DATE
GIVETH A Filer
filer ty ends MEANS Filer OF ty, FALSE, ends, NOTHING, 50000

-- Late payment helper: $10,000, given default date, never paid, s 139B applies (prior late payment)
GIVEN dd IS A DATE
      excl IS A BOOLEAN
GIVETH A `Late payment facts`
lp dd excl MEANS `Late payment facts` OF 10000, dd, NOTHING, FALSE, TRUE, NOTHING, NOTHING, excl

-- Shortfall helper: no cap date in range (determined 1 Jan 2030, annual return due 7 Jul 2027)
GIVEN c IS A Culpability
      amt IS A NUMBER
      vd IS A `Voluntary disclosure`
      adq IS A BOOLEAN
      temp IS A NUMBER
      clean IS A BOOLEAN
      obs IS A BOOLEAN
GIVETH A NUMBER
-- [Ported by the encoder: `Shortfall facts` gained `the tax is income tax` and `total tax figure for the return period` (s 141B(1D)), given as TRUE and 0 in every construction; no expected value changed.]
sp c amt vd adq temp clean obs MEANS `the shortfall penalty for` (`Shortfall facts` OF amt, c, FALSE, vd, adq, temp, clean, obs, Date 1 1 2030, Date 7 7 2027, 12, TRUE, 0)

-- Shortfall helper for s 141JAA: RC, disqualified, no temporary part, no adequate disclosure
GIVEN c IS A Culpability
      amt IS A NUMBER
      vd IS A `Voluntary disclosure`
      obs IS A BOOLEAN
      det IS A DATE
      due IS A DATE
      period IS A NUMBER
GIVETH A NUMBER
cap c amt vd obs det due period MEANS `the shortfall penalty for` (`Shortfall facts` OF amt, c, FALSE, vd, FALSE, 0, FALSE, obs, det, due, period, TRUE, 0)

