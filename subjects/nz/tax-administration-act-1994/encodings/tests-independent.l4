#ASSERT `the employer group of` (Employer OF FALSE, 10000, TRUE, FALSE, JUST (Date 1 8 2026), FALSE) `on` (Date 15 10 2026) EQUALS `the new group, delivering non-electronically` -- EG6
#ASSERT `the last day to deliver employment income information, employer` (Employer OF FALSE, 10000, TRUE, FALSE, JUST (Date 1 8 2026), FALSE) `, payday` (Date 15 10 2026) `, Matariki days` mdays EQUALS Date 30 10 2026 -- EG6 (10 working days)
#ASSERT `the employer group of` (Employer OF TRUE, 10000, TRUE, FALSE, JUST (Date 1 8 2026), FALSE) `on` (Date 15 10 2026) EQUALS `the online group` -- EG7
#ASSERT `the last day to deliver employment income information, employer` (Employer OF FALSE, 10000, TRUE, FALSE, JUST (Date 1 8 2026), FALSE) `, payday` (Date 31 1 2027) `, Matariki days` mdays EQUALS Date 15 2 2027 -- EG9
#ASSERT `the employer group of` (Employer OF FALSE, 60000, TRUE, FALSE, JUST (Date 1 8 2026), FALSE) `on` (Date 1 2 2027) EQUALS `the online group` -- EG10
#ASSERT `the last day to deliver employment income information, employer` (Employer OF FALSE, 60000, TRUE, FALSE, JUST (Date 1 8 2026), FALSE) `, payday` (Date 1 2 2027) `, Matariki days` mdays EQUALS Date 3 2 2027 -- EG10

