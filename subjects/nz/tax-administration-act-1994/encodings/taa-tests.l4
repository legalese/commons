IMPORT prelude
IMPORT daydate
IMPORT `taa-types`
IMPORT `taa-dates`
IMPORT `taa-reporting`
IMPORT `taa-returns`
IMPORT `taa-penalties`
IMPORT `taa-goal`

-- Tax Administration Act 1994 — THE ENCODER'S TESTS.
--
-- Expected values are worked by hand from the Act's text and the calendar
-- (Easter Sunday 5 April 2026; Anzac Day Saturday 25 April, so Monday 27
-- April; the King's Birthday 1 June; Matariki 10 July; Labour Day 26
-- October 2026).

§ `Tests`

mat MEANS LIST Date 10 7 2026, Date 25 6 2027

§§ `Working days`

#ASSERT NOT `is a working day` (Date 6 2 2026) `, Matariki days` mat
#ASSERT NOT `is a working day` (Date 3 4 2026) `, Matariki days` mat
#ASSERT NOT `is a working day` (Date 6 4 2026) `, Matariki days` mat
#ASSERT `is a working day` (Date 7 4 2026) `, Matariki days` mat
#ASSERT NOT `is a working day` (Date 27 4 2026) `, Matariki days` mat
#ASSERT NOT `is a working day` (Date 1 6 2026) `, Matariki days` mat
#ASSERT NOT `is a working day` (Date 10 7 2026) `, Matariki days` mat
#ASSERT NOT `is a working day` (Date 26 10 2026) `, Matariki days` mat
#ASSERT `is a working day` (Date 24 12 2026) `, Matariki days` mat
#ASSERT NOT `is a working day` (Date 15 1 2027) `, Matariki days` mat
#ASSERT `is a working day` (Date 18 1 2027) `, Matariki days` mat

§§ `Employment income information (ss 23E-23M)`

GIVEN electronic IS A BOOLEAN, paye IS A NUMBER, new IS A BOOLEAN, exempt IS A BOOLEAN, started IS A MAYBE DATE, twice IS A BOOLEAN
GIVETH AN Employer
employer electronic paye new exempt started twice MEANS Employer OF electronic, paye, new, exempt, started, twice

online MEANS employer TRUE 100000 FALSE FALSE NOTHING FALSE
paper MEANS employer FALSE 30000 FALSE FALSE NOTHING FALSE
paperTwice MEANS employer FALSE 30000 FALSE FALSE NOTHING TRUE

#ASSERT `the employer group of` online `on` (Date 16 10 2026) EQUALS `the online group`
#ASSERT `the employer group of` paper `on` (Date 16 10 2026) EQUALS `the non-electronic group`
#ASSERT `the employer group of` (employer FALSE 60000 FALSE FALSE NOTHING FALSE) `on` (Date 16 10 2026) EQUALS `the online group`
#ASSERT `the employer group of` (employer FALSE 60000 FALSE TRUE NOTHING FALSE) `on` (Date 16 10 2026) EQUALS `the non-electronic group`
#ASSERT `the employer group of` (employer FALSE 0 TRUE FALSE (JUST (Date 1 8 2026)) FALSE) `on` (Date 16 10 2026) EQUALS `the new group, delivering non-electronically`
#ASSERT `the employer group of` (employer FALSE 0 TRUE FALSE (JUST (Date 1 8 2026)) FALSE) `on` (Date 1 2 2027) EQUALS `the non-electronic group`
#ASSERT `the employer group of` (employer TRUE 0 TRUE FALSE (JUST (Date 1 8 2026)) FALSE) `on` (Date 16 10 2026) EQUALS `the online group`

#ASSERT `the last day to deliver employment income information, employer` online `, payday` (Date 16 10 2026) `, Matariki days` mat EQUALS Date 20 10 2026
#ASSERT `the last day to deliver employment income information, employer` online `, payday` (Date 22 10 2026) `, Matariki days` mat EQUALS Date 27 10 2026
-- Payday 23 December: 24 December, then nothing until Monday 18 January.
#ASSERT `the last day to deliver employment income information, employer` online `, payday` (Date 23 12 2026) `, Matariki days` mat EQUALS Date 18 1 2027
#ASSERT `the last day to deliver employment income information, employer` paper `, payday` (Date 16 10 2026) `, Matariki days` mat EQUALS Date 2 11 2026
#ASSERT `the last day to deliver employment income information, employer` paperTwice `, payday` (Date 3 10 2026) `, Matariki days` mat EQUALS Date 30 10 2026
#ASSERT `the last day to deliver employment income information, employer` paperTwice `, payday` (Date 20 10 2026) `, Matariki days` mat EQUALS Date 13 11 2026
#ASSERT `the last day to notify that employment has ended, stopped on` (Date 16 10 2026) `, Matariki days` mat EQUALS Date 30 11 2026

§§ `Tax codes (s 24E)`

#ASSERT `has a non-notified tax code` (Employee OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)
#ASSERT `has a non-notified tax code` (Employee OF TRUE, TRUE, FALSE, FALSE, FALSE, FALSE)
#ASSERT NOT `has a non-notified tax code` (Employee OF TRUE, TRUE, TRUE, FALSE, FALSE, FALSE)
#ASSERT NOT `has a non-notified tax code` (Employee OF FALSE, FALSE, FALSE, TRUE, FALSE, FALSE)
#ASSERT NOT `has a non-notified tax code` (Employee OF FALSE, FALSE, FALSE, FALSE, TRUE, FALSE)
#ASSERT NOT `has a non-notified tax code` (Employee OF FALSE, FALSE, FALSE, FALSE, FALSE, TRUE)

§§ `Returns and the time bar (ss 33, 37, 108)`

GIVEN year IS A NUMBER, ends IS A MAYBE DATE
GIVETH A Filer
filer year ends MEANS Filer OF year, FALSE, ends, NOTHING, 50000

#ASSERT `must file a return of income` (filer 2027 NOTHING)
#ASSERT NOT `must file a return of income` (Filer OF 2027, TRUE, NOTHING, NOTHING, 0)
#ASSERT `the due date for the return of` (filer 2027 NOTHING) EQUALS Date 7 7 2027
#ASSERT `the latest extended due date for the return of` (filer 2027 NOTHING) EQUALS Date 31 3 2028
#ASSERT `the due date for the return of` (filer 2027 (JUST (Date 30 6 2026))) EQUALS Date 7 10 2026
#ASSERT `the latest extended due date for the return of` (filer 2027 (JUST (Date 30 6 2026))) EQUALS Date 31 3 2027
#ASSERT `the due date for the return of` (filer 2027 (JUST (Date 30 9 2026))) EQUALS Date 7 1 2027
#ASSERT `the due date for the return of` (filer 2026 (JUST (Date 31 12 2025))) EQUALS Date 7 7 2026
#ASSERT `the latest extended due date for the return of` (filer 2026 (JUST (Date 31 12 2025))) EQUALS Date 31 3 2027
#ASSERT `the latest extended due date for the return of` (filer 2026 (JUST (Date 28 2 2026))) EQUALS Date 31 3 2027
#ASSERT `the last day to increase the assessment, return provided` (Date 15 6 2027) `, fraud or omission` FALSE EQUALS JUST (Date 31 3 2032)
#ASSERT `the last day to increase the assessment, return provided` (Date 15 3 2027) `, fraud or omission` FALSE EQUALS JUST (Date 31 3 2031)
#ASSERT `the last day to increase the assessment, return provided` (Date 15 3 2027) `, fraud or omission` TRUE EQUALS NOTHING

§§ `Late filing penalty (s 139A)`

#ASSERT `the late filing penalty for` `an annual tax return` `, net income` 99999 `, late` TRUE `, notified` TRUE EQUALS 50
#ASSERT `the late filing penalty for` `an annual tax return` `, net income` 100000 `, late` TRUE `, notified` TRUE EQUALS 250
#ASSERT `the late filing penalty for` `an annual tax return` `, net income` 1000000 `, late` TRUE `, notified` TRUE EQUALS 250
#ASSERT `the late filing penalty for` `an annual tax return` `, net income` 1000001 `, late` TRUE `, notified` TRUE EQUALS 500
#ASSERT `the late filing penalty for` `an annual tax return` `, net income` 50000 `, late` TRUE `, notified` FALSE EQUALS 0
#ASSERT `the late filing penalty for` `an annual tax return` `, net income` 50000 `, late` FALSE `, notified` TRUE EQUALS 0
#ASSERT `the late filing penalty for` `a multinational top-up tax return` `, net income` 0 `, late` TRUE `, notified` TRUE EQUALS 500
#ASSERT `the late filing penalty for` `an annual ICA return, reconciliation statement, employment income information or RLWT statement` `, net income` 0 `, late` TRUE `, notified` TRUE EQUALS 250

§§ `Late payment penalty (s 139B)`

GIVEN paid IS A MAYBE DATE, provisional IS A BOOLEAN, before IS A BOOLEAN, excluded IS A BOOLEAN
GIVETH A `Late payment facts`
due paid provisional before excluded MEANS `Late payment facts` OF 1000, Date 7 4 2026, paid, provisional, before, NOTHING, NOTHING, excluded

#ASSERT `the late payment penalty on` (due NOTHING FALSE TRUE FALSE) `, as at` (Date 7 4 2026) EQUALS 0
#ASSERT `the late payment penalty on` (due NOTHING FALSE TRUE FALSE) `, as at` (Date 8 4 2026) EQUALS 10
#ASSERT `the late payment penalty on` (due NOTHING FALSE TRUE FALSE) `, as at` (Date 13 4 2026) EQUALS 10
-- The 4% at the end of the 6th day after 8 April: 4% of $1,010.
#ASSERT `the late payment penalty on` (due NOTHING FALSE TRUE FALSE) `, as at` (Date 14 4 2026) EQUALS 50.4
-- The first incremental 1% one month after 8 April, on $1,050.40.
#ASSERT `the late payment penalty on` (due NOTHING FALSE TRUE FALSE) `, as at` (Date 7 5 2026) EQUALS 50.4
#ASSERT `the late payment penalty on` (due NOTHING FALSE TRUE FALSE) `, as at` (Date 8 5 2026) EQUALS 60.904
#ASSERT `the late payment penalty on` (due NOTHING FALSE TRUE TRUE) `, as at` (Date 8 5 2026) EQUALS 50.4
#ASSERT `the late payment penalty on` (due (JUST (Date 7 4 2026)) FALSE TRUE FALSE) `, as at` (Date 8 5 2026) EQUALS 0
#ASSERT `the late payment penalty on` (due (JUST (Date 8 4 2026)) FALSE TRUE FALSE) `, as at` (Date 8 5 2026) EQUALS 10
#ASSERT `the late payment penalty on` (due (JUST (Date 13 4 2026)) FALSE TRUE FALSE) `, as at` (Date 8 5 2026) EQUALS 10
-- Corrected before commit (fork F4): the 4% is added at the end of 14 April,
-- so payment that day avoids it; payment on 15 April does not.
#ASSERT `the late payment penalty on` (due (JUST (Date 14 4 2026)) FALSE TRUE FALSE) `, as at` (Date 8 5 2026) EQUALS 10
#ASSERT `the late payment penalty on` (due (JUST (Date 15 4 2026)) FALSE TRUE FALSE) `, as at` (Date 8 5 2026) EQUALS 50.4
#ASSERT `the late payment penalty on` (due NOTHING TRUE FALSE FALSE) `, as at` (Date 8 4 2026) EQUALS 10
#ASSERT `the late payment penalty on` (due NOTHING FALSE FALSE FALSE) `, as at` (Date 8 5 2026) EQUALS 0
-- s 139B(1)(c): a notice on 20 April sets a further date of 1 May.
#ASSERT `the late payment penalty on` (`Late payment facts` OF 1000, Date 7 4 2026, JUST (Date 30 4 2026), FALSE, FALSE, JUST (Date 20 4 2026), JUST (Date 1 5 2026), FALSE) `, as at` (Date 1 5 2026) EQUALS 0
#ASSERT `the late payment penalty on` (`Late payment facts` OF 1000, Date 7 4 2026, JUST (Date 1 5 2026), FALSE, FALSE, JUST (Date 20 4 2026), JUST (Date 1 5 2026), FALSE) `, as at` (Date 1 5 2026) EQUALS 50.4

§§ `Shortfall penalties (ss 141A-141K, 141JAA)`

GIVEN c IS A Culpability, three IS A BOOLEAN, v IS A `Voluntary disclosure`, adequate IS A BOOLEAN, temporary IS A NUMBER, good IS A BOOLEAN, obstructed IS A BOOLEAN, shortfall IS A NUMBER, determined IS A DATE
GIVETH A `Shortfall facts`
sf c three v adequate temporary good obstructed shortfall determined MEANS
    `Shortfall facts` OF shortfall, c, three, v, adequate, temporary, good, obstructed, determined, Date 7 7 2027, 12, TRUE, 0

late MEANS Date 1 1 2030
none MEANS `no voluntary disclosure`
pre MEANS `before notification of an audit or investigation`
post MEANS `after notification but before the audit or investigation starts`

#ASSERT `the shortfall penalty for` (sf `s 141A not taking reasonable care` FALSE none FALSE 0 FALSE FALSE 10000 late) EQUALS 2000
#ASSERT `the shortfall penalty for` (sf `s 141A not taking reasonable care` FALSE none FALSE 0 TRUE FALSE 10000 late) EQUALS 1000
#ASSERT `the shortfall penalty for` (sf `s 141C gross carelessness` FALSE none FALSE 0 FALSE FALSE 10000 late) EQUALS 4000
#ASSERT `the shortfall penalty for` (sf `s 141D an abusive tax position` FALSE none FALSE 0 FALSE FALSE 10000 late) EQUALS 10000
#ASSERT `the shortfall penalty for` (sf `s 141D an abusive tax position` TRUE none FALSE 0 FALSE FALSE 10000 late) EQUALS 2000
#ASSERT `the shortfall penalty for` (sf `s 141E evasion or a similar act` FALSE none FALSE 0 FALSE FALSE 10000 late) EQUALS 15000
#ASSERT `the shortfall penalty for` (sf `s 141E evasion or a similar act` FALSE none FALSE 0 TRUE FALSE 10000 late) EQUALS 7500
#ASSERT `the shortfall penalty for` (sf `s 141A not taking reasonable care` FALSE pre FALSE 0 FALSE FALSE 10000 late) EQUALS 0
#ASSERT `the shortfall penalty for` (sf `s 141C gross carelessness` FALSE pre FALSE 0 FALSE FALSE 10000 late) EQUALS 1000
#ASSERT `the shortfall penalty for` (sf `s 141C gross carelessness` FALSE post FALSE 0 FALSE FALSE 10000 late) EQUALS 2400
-- Changed after the independent pass (s 141B(1D)): a $10,000 unacceptable
-- tax position is under the $50,000 threshold, so no penalty; at $100,000 it
-- is 20%, reduced 75% for adequate disclosure.
#ASSERT `the shortfall penalty for` (sf `s 141B an unacceptable tax position` FALSE none TRUE 0 FALSE FALSE 10000 late) EQUALS 0
#ASSERT `the shortfall penalty for` (sf `s 141B an unacceptable tax position` FALSE none TRUE 0 FALSE FALSE 100000 late) EQUALS 5000
#ASSERT `the shortfall penalty for` (`Shortfall facts` OF 100000, `s 141B an unacceptable tax position`, FALSE, none, FALSE, 0, FALSE, FALSE, late, Date 7 7 2027, 12, TRUE, 9999999) EQUALS 20000
#ASSERT `the shortfall penalty for` (`Shortfall facts` OF 100000, `s 141B an unacceptable tax position`, FALSE, none, FALSE, 0, FALSE, FALSE, late, Date 7 7 2027, 12, TRUE, 10000000) EQUALS 0
#ASSERT `the shortfall penalty for` (`Shortfall facts` OF 100000, `s 141B an unacceptable tax position`, FALSE, none, FALSE, 0, FALSE, FALSE, late, Date 7 7 2027, 12, FALSE, 0) EQUALS 0
#ASSERT `the shortfall penalty for` (sf `s 141D an abusive tax position` FALSE none TRUE 0 FALSE FALSE 10000 late) EQUALS 2500
-- Adequate disclosure does not reduce a penalty for gross carelessness.
#ASSERT `the shortfall penalty for` (sf `s 141C gross carelessness` FALSE none TRUE 0 FALSE FALSE 10000 late) EQUALS 4000
#ASSERT `the shortfall penalty for` (sf `s 141A not taking reasonable care` FALSE none FALSE 10000 FALSE FALSE 10000 late) EQUALS 500
#ASSERT `the shortfall penalty for` (sf `s 141C gross carelessness` FALSE none FALSE 5000 FALSE FALSE 10000 late) EQUALS 2500
#ASSERT `the shortfall penalty for` (sf `s 141C gross carelessness` FALSE post FALSE 5000 FALSE FALSE 10000 late) EQUALS 1700
#ASSERT `the shortfall penalty for` (sf `s 141C gross carelessness` FALSE none FALSE 0 FALSE TRUE 10000 late) EQUALS 5000
-- s 141JAA: due 7 July 2027, a 12-month return period, so the later of 7
-- October 2027 and 7 January 2028.
#ASSERT `the shortfall penalty for` (sf `s 141A not taking reasonable care` FALSE none FALSE 0 FALSE FALSE 500000 (Date 7 1 2028)) EQUALS 50000
#ASSERT `the shortfall penalty for` (sf `s 141A not taking reasonable care` FALSE none FALSE 0 FALSE FALSE 500000 (Date 8 1 2028)) EQUALS 100000
#ASSERT `the shortfall penalty for` (sf `s 141A not taking reasonable care` FALSE none FALSE 0 FALSE TRUE 500000 (Date 7 1 2028)) EQUALS 125000
#ASSERT `the shortfall penalty for` (sf `s 141C gross carelessness` FALSE none FALSE 0 FALSE FALSE 500000 (Date 7 1 2028)) EQUALS 200000
#ASSERT `the shortfall penalty for` (`Shortfall facts` OF 500000, `s 141B an unacceptable tax position`, FALSE, none, FALSE, 0, FALSE, FALSE, Date 7 10 2027, Date 7 7 2027, 1, TRUE, 0) EQUALS 50000
#ASSERT `the shortfall penalty for` (`Shortfall facts` OF 500000, `s 141B an unacceptable tax position`, FALSE, none, FALSE, 0, FALSE, FALSE, Date 8 10 2027, Date 7 7 2027, 1, TRUE, 0) EQUALS 100000

§§ `The top-level goal`

#ASSERT `the administration position for` (Filer OF 2027, FALSE, NOTHING, JUST (Date 8 7 2027), 50000) `, penalty notified` TRUE `, unpaid tax` NOTHING `, shortfall` NOTHING `, fraud or omission` FALSE `, as at` (Date 1 8 2027) EQUALS `Administration position` OF TRUE, Date 7 7 2027, Date 31 3 2028, 50, 0, 0, JUST (Date 31 3 2032)
#ASSERT `the administration position for` (Filer OF 2027, FALSE, NOTHING, JUST (Date 7 7 2027), 50000) `, penalty notified` TRUE `, unpaid tax` (JUST (due NOTHING FALSE TRUE FALSE)) `, shortfall` (JUST (sf `s 141C gross carelessness` FALSE none FALSE 0 FALSE FALSE 10000 late)) `, fraud or omission` FALSE `, as at` (Date 14 4 2026) EQUALS `Administration position` OF TRUE, Date 7 7 2027, Date 31 3 2028, 0, 50.4, 4000, JUST (Date 31 3 2032)

§§ `Legislation Act 2019 s 55 (added 2026-10-17)`

-- 7 July 2024 was a Sunday: returns for 2023-24 were due Monday 8 July.
#ASSERT `the due date for the return of` (filer 2024 NOTHING) EQUALS Date 8 7 2024
-- 31 March 2029 is a Saturday, 1 April Easter Sunday and 2 April Easter
-- Monday: the latest extension runs to Tuesday 3 April 2029.
#ASSERT `the latest extended due date for the return of` (filer 2028 NOTHING) EQUALS Date 3 4 2029
-- A return provided on 1 June 2025: the time bar's 31 March 2030 is a
-- Sunday, so Monday 1 April 2030.
#ASSERT `the last day to increase the assessment, return provided` (Date 1 6 2025) `, fraud or omission` FALSE EQUALS JUST (Date 1 4 2030)
