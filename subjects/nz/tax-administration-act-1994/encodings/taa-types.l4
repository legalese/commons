IMPORT prelude
IMPORT daydate

-- Tax Administration Act 1994 (New Zealand) — THE NOUNS.
--
-- Every fact the rule modules read, and nothing else: no rules, no #EVAL.
-- Source: ../registers/source-bundle/act_public_1994_166.txt (New Zealand
-- Legislation, version as at 4 September 2026, converted from the PCO XML).
-- Field names are unique across records.

§ `Tax Administration Act 1994 — the nouns`

§§ `Employment income information (ss 23E-23M, 24E)`

DECLARE `Employer group` IS ONE OF
    `the online group`
    `the non-electronic group`
    `the new group, delivering non-electronically`

DECLARE Employer HAS
    `delivers employment income information electronically` IS A BOOLEAN
    -- s 23F(5)-(6): PAYE and ESCT for the preceding tax year (or, for a new
    -- employer, accumulated so far).
    `PAYE and ESCT for the preceding tax year`          IS A NUMBER
    `a new employer`                                    IS A BOOLEAN
    `has a s 23G exemption`                             IS A BOOLEAN
    -- s 23H(2): the day the employer started employing, if new.
    `started employing on`                              IS A MAYBE DATE
    -- s 23F(3)(b): treat paydays in the 1st-15th and 16th-end periods as the
    -- 15th and the last day.
    `chooses the twice-monthly payday`                  IS A BOOLEAN

-- s 24E(1)(a): what the employee has notified to the employer.
DECLARE Employee HAS
    `notified their full name`                          IS A BOOLEAN
    `notified their tax file number`                    IS A BOOLEAN
    `notified their tax code`                           IS A BOOLEAN
    `the Commissioner has provided a tax code`          IS A BOOLEAN
    `a non-resident seasonal worker`                    IS A BOOLEAN
    `a person referred to in s 24D`                     IS A BOOLEAN

§§ `Returns (ss 33, 37, 108)`

DECLARE Filer HAS
    -- the tax year ending on 31 March of this year.
    `tax year ending 31 March`                          IS A NUMBER
    `derives only exempt income`                        IS A BOOLEAN
    -- s 38: an approved income year ending on another date, if any.
    `approved income year ends on`                      IS A MAYBE DATE
    `return filed on`                                   IS A MAYBE DATE
    -- s 139A: net income for the year, for the late filing penalty.
    `net income for the year`                           IS A NUMBER

§§ `Penalties (ss 139A, 139B, 141A-141K)`

DECLARE `Kind of return` IS ONE OF
    `an annual tax return`
    `a multinational top-up tax return`
    `an annual ICA return, reconciliation statement, employment income information or RLWT statement`

DECLARE `Late payment facts` HAS
    `unpaid tax`                                        IS A NUMBER
    `default date`                                      IS A DATE
    `tax paid on`                                       IS A MAYBE DATE
    -- s 139B(1)(a)-(c).
    `provisional tax or a penalty for not paying it`    IS A BOOLEAN
    `paid late in the 2 years before the default date`  IS A BOOLEAN
    `notice of a further date given on`                 IS A MAYBE DATE
    `further date for payment`                          IS A MAYBE DATE
    -- s 139B(2B): incremental penalties no longer run (income tax and
    -- provisional tax for 2017-18 on, GST after 31 March 2017, and others).
    `incremental penalty excluded by s 139B(2B)`        IS A BOOLEAN

DECLARE Culpability IS ONE OF
    `s 141A not taking reasonable care`
    `s 141B an unacceptable tax position`
    `s 141C gross carelessness`
    `s 141D an abusive tax position`
    `s 141E evasion or a similar act`

DECLARE `Voluntary disclosure` IS ONE OF
    `no voluntary disclosure`
    `before notification of an audit or investigation`
    `after notification but before the audit or investigation starts`

DECLARE `Shortfall facts` HAS
    `tax shortfall`                                     IS A NUMBER
    `culpability`                                       IS A Culpability
    -- s 141D(3B): a promoted arrangement, under $50,000, with independent
    -- advice.
    `the s 141D(3B) reduction to 20% applies`           IS A BOOLEAN
    -- s 141B(1C) and the like: an unacceptable interpretation (counts with
    -- reasonable care and unacceptable tax positions in ss 141G, 141J).
    `voluntary disclosure`                              IS A `Voluntary disclosure`
    `adequate disclosure when the position was taken`   IS A BOOLEAN
    -- s 141I: the part of the shortfall that is temporary.
    `temporary part of the shortfall`                   IS A NUMBER
    -- s 141FB: no disqualifying offence or penalty.
    `no disqualifying offence or penalty`               IS A BOOLEAN
    `obstructed the Commissioner`                       IS A BOOLEAN
    -- s 141JAA: when the shortfall was disclosed or determined, the return's
    -- due date, and the return period in months.
    `shortfall disclosed or determined on`              IS A DATE
    `due date of the return`                            IS A DATE
    `return period in months`                           IS A NUMBER
    -- s 141B(1D) (added after the independent pass): an unacceptable tax
    -- position is penalised only for income tax, and only if the shortfall is
    -- more than both $50,000 and 1% of the total tax figure.
    `the tax is income tax`                             IS A BOOLEAN
    `total tax figure for the return period`            IS A NUMBER
