-- Accident Compensation Act 2001 (New Zealand) — THE NOUNS.
--
-- Every fact the rule modules read, and nothing else: no rules, no #EVAL.
-- Source: ../source/ACC2001.txt (New Zealand Legislation, version 249 as at
-- 10 July 2026, text extracted from the PCO PDF).

§ `Accident Compensation Act 2001 — the nouns`

§§ `The occurrence and the injury (Part 2)`

-- s 25(1)(a)-(f): kinds of occurrence that may be an accident.
DECLARE Occurrence IS ONE OF
    `(a) a specific event with an external force, a sudden avoiding movement, or a twist`
    `(b) inhaling something on a specific occasion` HAS
        `a virus, bacterium, protozoan or fungus`       IS A BOOLEAN
        `from another person's criminal act`            IS A BOOLEAN
    `(ba) orally ingesting something on a specific occasion` HAS
        `a virus, bacterium or protozoan`               IS A BOOLEAN
        `from another person's criminal act`            IS A BOOLEAN
    `(c) a burn or exposure to radiation on a specific occasion` HAS
        `caused by exposure to the elements`            IS A BOOLEAN
    `(d) absorbing a chemical through the skin` HAS
        `within a period of days`                       IS A NUMBER
    `(e) exposure to the elements or extremes of temperature` HAS
        `within a period of days`                       IS A NUMBER
        `results in restriction for days`               IS A NUMBER
        `causes death`                                  IS A BOOLEAN
    `(f) an internal force during labour causing a Schedule 3A birth injury`
    `a gradual process`
    `none of these`

-- s 26(1): the kind of harm.
DECLARE Harm IS ONE OF
    `death`
    `physical injury`
    `mental injury because of physical injury`
    `mental injury from a Schedule 3 act (s 21)`
    `work-related mental injury from a sudden event (s 21B)`
    `damage to dentures or prostheses`
    `hearing loss` HAS `per cent binaural loss` IS A NUMBER
    `none`

-- s 26(2)-(4), s 32(2): what may exclude it.
DECLARE Cause IS ONE OF
    `an accident`
    `treatment by a registered health professional`
    `a work-related gradual process, disease or infection`
    `a gradual process, disease or infection, not work-related or treatment`
    `the ageing process`
    `natural use of teeth or dentures`
    `a cardiovascular or cerebrovascular episode`

DECLARE `Injury facts` HAS
    `occurrence`                                        IS AN Occurrence
    `harm`                                              IS A Harm
    `cause`                                             IS A Cause
    `suffered on`                                       IS A DATE
    `in New Zealand`                                    IS A BOOLEAN
    `ordinarily resident in New Zealand`                IS A BOOLEAN
    `on the ship or aircraft to, around or from New Zealand, or embarking` IS A BOOLEAN -- s 23
    `consequence of treatment for a covered injury`     IS A BOOLEAN  -- s 20(2)(d), (g), (h)
    `a cardiovascular episode from abnormal work effort` IS A BOOLEAN  -- s 28(3)

-- s 32: the treatment-injury tests.
DECLARE `Treatment facts` HAS
    `caused by treatment`                               IS A BOOLEAN
    `a necessary part or ordinary consequence of the treatment` IS A BOOLEAN
    `wholly or substantially caused by an underlying condition` IS A BOOLEAN
    `solely a resource allocation decision`             IS A BOOLEAN
    `unreasonably withheld or delayed consent`          IS A BOOLEAN
    `the treatment was for a work-related injury`       IS A BOOLEAN

-- s 28(1): where the person was when injured.
DECLARE `Work circumstance` IS ONE OF
    `at a place for the purposes of employment`
    `on a meal or rest break at the place of employment`
    `travelling in employer-provided transport to or from work`
    `travelling by the most direct route to treatment for a work injury`
    `not at work`

-- s 35: how a vehicle was involved.
DECLARE `Vehicle involvement` IS ONE OF
    `the movement of a motor vehicle`
    `a stationary motor vehicle struck by another conveyance`
    `loading, unloading, repairing or servicing a vehicle`
    `using a vehicle other than as a means of conveyance`
    `off-road use, not out of control`
    `no vehicle`

DECLARE `Injury class` IS ONE OF
    `a treatment injury`
    `a work-related personal injury`
    `a motor vehicle injury`
    `a non-work injury`

§§ `The claimant and earnings (Part 4, Schedule 1)`

DECLARE `Earner status` IS ONE OF
    `an employee`
    `a self-employed person`
    `a shareholder-employee`
    `a potential earner`
    `a non-earner`

-- Schedule 1 Part 2: a permanent employee's earnings.
DECLARE `Earnings facts` HAS
    `earnings in the 4 weeks before incapacity`         IS A NUMBER
    `weeks worked in those 4 weeks`                     IS A NUMBER
    `earnings in the 52 weeks before incapacity`        IS A NUMBER
    `weeks worked in those 52 weeks`                    IS A NUMBER
    `in full-time employment or on the minimum levy`    IS A BOOLEAN   -- cl 42(1)(a)
    `minimum weekly earnings`                           IS A NUMBER    -- cl 42(3), an input
    `earnings after incapacity, per week`               IS A NUMBER    -- cl 51

-- Schedule 1 Part 4: the deceased claimant's family.
DECLARE `Survivor facts` HAS
    `surviving spouses or partners`                     IS A NUMBER
    `children under 18`                                 IS A NUMBER
    `other dependants`                                  IS A NUMBER
    `both parents of the child have died`               IS A BOOLEAN

-- ss 118-122: grounds that bar entitlements.
DECLARE Disentitlement IS ONE OF
    `wilfully self-inflicted injury or suicide (s 119)`
    `conviction for murdering the deceased (s 120)`
    `charged with murdering the deceased (s 120(2))`
    `in prison (s 121)`
    `injured committing an offence punishable by 2 years or more, and imprisoned (s 122)`
    `none`

DECLARE `Entitlement kind` IS ONE OF
    `treatment or a related service`
    `other rehabilitation (Schedule 1 Part 1)`
    `weekly compensation (Schedule 1 Part 2)`
    `lump sum compensation (Schedule 1 Part 3)`
    `survivors' entitlements (Schedule 1 Part 4)`

§§ `Reviews, levies and offences (Parts 5, 6, 9)`

-- s 166: the Accounts.
DECLARE Account IS ONE OF
    `the Work Account`
    `the Motor Vehicle Account`
    `the Earners' Account`
    `the Non-Earners' Account`
    `the Treatment Injury Account`

DECLARE `ACC offence` IS ONE OF
    `s 98(3) an employer not paying first week compensation`
    `s 160(4) breaching a non-publication order, individual`
    `s 160(4) breaching a non-publication order, body corporate`
    `s 242 intentionally not providing a statement of earnings`
    `s 308 misleading the Corporation`
    `s 309 not providing requested information`
    `s 310 not reporting increased earnings`
    `s 316(1)(b) misapplying levy deductions`
    `s 316(1)(a), (c)-(e) a deduction offence, first conviction`
    `s 316(1)(a), (c)-(e) a deduction offence, later conviction`
    `an offence against regulations (s 335)`

DECLARE `Proceeding kind` IS ONE OF
    `damages for the covered personal injury`
    `damage to property`
    `an express contract term, not accident insurance`
    `unjustifiable dismissal or personal grievance`
    `Health and Disability Commissioner or Human Rights Act proceedings`
    `a carriage of passengers convention claim`
    `exemplary damages`

DECLARE `ACC penalty` HAS
    `fine`                        IS A NUMBER
    `imprisonment in months`      IS A NUMBER
    `fine or imprisonment`        IS A BOOLEAN   -- alternatives, not both

§§ `The injury case`

DECLARE `Injury case` HAS
    `injury`                                            IS `Injury facts`
    `treatment`                                         IS `Treatment facts`
    `work circumstance`                                 IS A `Work circumstance`
    `vehicle`                                           IS A `Vehicle involvement`
    `status`                                            IS AN `Earner status`
    `earnings`                                          IS `Earnings facts`
    `disentitlement`                                    IS A Disentitlement
