#ASSERT (position (`a case of` `s 9 misleading or deceptive conduct in trade` TRUE TRUE `an individual`))'s `a party may apply for a s 43 order` EQUALS TRUE
#ASSERT (position (`a case of` `s 36F a layby cancellation charge` TRUE TRUE `a body corporate`))'s `a party may apply for a s 43 order` EQUALS TRUE

