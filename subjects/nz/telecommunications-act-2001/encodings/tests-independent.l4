IMPORT prelude
IMPORT daydate
IMPORT `tel-types`
IMPORT `tel-dates`
IMPORT `tel-consumer`
IMPORT `tel-levy`
IMPORT `tel-goal`

-- Independent tests. Expected values come from independent-expectations.md,
-- written before the encoding was opened. A failing assertion is a finding.

-- Non-working-day inputs: Matariki 2026 and 2027, Wellington Anniversary 2027.
wel MEANS LIST (Date 10 7 2026), (Date 25 6 2027), (Date 25 1 2027)
-- Same, but Auckland Anniversary 2027 (Mon 1 Feb 2027) instead of Wellington.
akl MEANS LIST (Date 10 7 2026), (Date 25 6 2027), (Date 1 2 2027)

GIVEN n IS A NUMBER, d IS A DATE
GIVETH A DATE
wdAfter n d MEANS `the` n `th working day after` d `, Matariki days` wel

-- Copper service fields, in order: applies, approved, complies, permanent
-- choice, fibre access, installed in time at no cost, notice to all three,
-- functionality over fibre, withdrawal and power-failure information, anchor
-- service, 111 contact code.
GIVEN c IS A `Copper service`
GIVETH A BOOLEAN
mayStop c MEANS `Chorus may stop supplying the copper service` c

-- C01
#ASSERT mayStop (`Copper service` OF TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE)
-- C02
#ASSERT NOT mayStop (`Copper service` OF TRUE, TRUE, FALSE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE)
-- C03
#ASSERT mayStop (`Copper service` OF TRUE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)
-- C04 temporary disconnection only: permanent-choice input FALSE
#ASSERT NOT mayStop (`Copper service` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)
-- C05
#ASSERT NOT mayStop (`Copper service` OF TRUE, FALSE, FALSE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE)
-- C06
#ASSERT NOT mayStop (`Copper service` OF TRUE, FALSE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE)
-- C07
#ASSERT mayStop (`Copper service` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE)
-- C08
#ASSERT mayStop (`Copper service` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE)
-- C09 s 69AD service, same record shape
#ASSERT mayStop (`Copper service` OF TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE)
-- C10
#ASSERT mayStop (`Copper service` OF TRUE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)
-- C11
#ASSERT NOT mayStop (`Copper service` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)
-- C12
#ASSERT NOT mayStop (`Copper service` OF TRUE, FALSE, FALSE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE)
-- P01
#ASSERT `the Schedule 2A protections are met for` (`Copper service` OF TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE) AND mayStop (`Copper service` OF TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE)
-- P02
#ASSERT NOT mayStop (`Copper service` OF TRUE, TRUE, TRUE, FALSE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE)
-- P03 not within a reasonable time
#ASSERT NOT mayStop (`Copper service` OF TRUE, TRUE, TRUE, FALSE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE)
-- P04 standard connection, cost to end-user
#ASSERT NOT mayStop (`Copper service` OF TRUE, TRUE, TRUE, FALSE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE)
-- P05 non-standard connection, cost to end-user
#ASSERT NOT mayStop (`Copper service` OF TRUE, TRUE, TRUE, FALSE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE)
-- P06 non-standard at no cost
#ASSERT mayStop (`Copper service` OF TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE)
-- P07 no notice to fibre provider
#ASSERT NOT mayStop (`Copper service` OF TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE)
-- P08 no notice to end-user
#ASSERT NOT mayStop (`Copper service` OF TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE)
-- P09 only a legacy service lost: functionality input TRUE
#ASSERT mayStop (`Copper service` OF TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE)
-- P10
#ASSERT NOT mayStop (`Copper service` OF TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE)
-- P11 no withdrawal information
#ASSERT NOT mayStop (`Copper service` OF TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE)
-- P12 no battery-backup information
#ASSERT NOT mayStop (`Copper service` OF TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE)
-- P15
#ASSERT NOT mayStop (`Copper service` OF TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE)
-- P16 commercial equivalent available: anchor input TRUE
#ASSERT mayStop (`Copper service` OF TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE)
-- P17 no anchor declared: anchor input TRUE
#ASSERT mayStop (`Copper service` OF TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE)
-- P18
#ASSERT NOT mayStop (`Copper service` OF TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE)
-- P20
#ASSERT mayStop (`Copper service` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE)
-- T01
#ASSERT NOT `the local residential telephone TSO still applies, specified fibre area` TRUE `, for 111 calls` FALSE
-- T02
#ASSERT `the local residential telephone TSO still applies, specified fibre area` TRUE `, for 111 calls` TRUE
-- T05
#ASSERT `the local residential telephone TSO still applies, specified fibre area` FALSE `, for 111 calls` FALSE
