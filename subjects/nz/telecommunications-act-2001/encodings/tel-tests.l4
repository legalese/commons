IMPORT prelude
IMPORT daydate
IMPORT `tel-types`
IMPORT `tel-dates`
IMPORT `tel-consumer`
IMPORT `tel-levy`
IMPORT `tel-goal`

-- Telecommunications Act 2001 — THE ENCODER'S TESTS.
--
-- Expected values are worked by hand from the Act's text and the calendar
-- (Labour Day 26 October 2026; Matariki 10 July 2026; Wellington
-- Anniversary Day 25 January 2027).

§ `Tests`

days MEANS LIST Date 10 7 2026, Date 25 1 2027

§§ `Copper withdrawal`

GIVEN applies IS A BOOLEAN, approved IS A BOOLEAN, complies IS A BOOLEAN, chose IS A BOOLEAN, fibre IS A BOOLEAN, notice IS A BOOLEAN
GIVETH A `Copper service`
copper applies approved complies chose fibre notice MEANS `Copper service` OF applies, approved, complies, chose, fibre, TRUE, notice, TRUE, TRUE, TRUE, TRUE

#ASSERT `Chorus may stop supplying the copper service` (copper TRUE TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT `Chorus may stop supplying the copper service` (copper TRUE TRUE TRUE FALSE FALSE TRUE)
#ASSERT NOT `Chorus may stop supplying the copper service` (copper TRUE TRUE TRUE FALSE TRUE FALSE)
#ASSERT NOT `Chorus may stop supplying the copper service` (copper TRUE FALSE TRUE FALSE TRUE TRUE)
#ASSERT NOT `Chorus may stop supplying the copper service` (copper TRUE TRUE FALSE FALSE TRUE TRUE)
#ASSERT `Chorus may stop supplying the copper service` (copper TRUE FALSE FALSE TRUE FALSE FALSE)
-- Changed after the independent pass: a service outside ss 69AC-69AD is now
-- refused, so the earlier assertion that Chorus may stop it is removed.
#ASSERT NOT `Chorus may stop supplying the copper service` (`Copper service` OF TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE)
#ASSERT NOT `the local residential telephone TSO still applies, specified fibre area` TRUE `, for 111 calls` FALSE
#ASSERT `the local residential telephone TSO still applies, specified fibre area` TRUE `, for 111 calls` TRUE
#ASSERT `the local residential telephone TSO still applies, specified fibre area` FALSE `, for 111 calls` FALSE

§§ `Disputes and periods`

GIVEN member IS A BOOLEAN, lodged IS A DATE, further IS A MAYBE DATE
GIVETH A `Dispute party`
party member lodged further MEANS `Dispute party` OF member, Date 16 10 2026, lodged, further

#ASSERT `the party may appeal the determination` (party FALSE (Date 23 10 2026) NOTHING) days
#ASSERT NOT `the party may appeal the determination` (party FALSE (Date 26 10 2026) NOTHING) days
#ASSERT NOT `the party may appeal the determination` (party FALSE (Date 27 10 2026) NOTHING) days
#ASSERT `the party may appeal the determination` (party FALSE (Date 30 10 2026) (JUST (Date 1 11 2026))) days
#ASSERT NOT `the party may appeal the determination` (party TRUE (Date 20 10 2026) NOTHING) days
-- 30 working days from Friday 16 October 2026, skipping Labour Day: Monday 30
-- November; "before" that day for the copper withdrawal code: 29 November.
#ASSERT `the last day for submissions on a draft code noticed on` (Date 16 10 2026) `, the copper withdrawal code` FALSE `, non-working days` days EQUALS Date 30 11 2026
#ASSERT `the last day for submissions on a draft code noticed on` (Date 16 10 2026) `, the copper withdrawal code` TRUE `, non-working days` days EQUALS Date 29 11 2026
#ASSERT `the latest day for the next scheme review after one on` (Date 1 3 2024) EQUALS Date 1 3 2027
#ASSERT `the last day for submissions on a draft review report given on` (Date 16 10 2026) `, non-working days` days EQUALS Date 16 11 2026
-- The anniversary day counts: 20 working days from Friday 15 January 2027
-- skip 25 January (Wellington) and Monday 8 February (Waitangi Day falls on
-- Saturday 6 February 2027), ending on 16 February. (Recounted by hand before
-- commit: the first count missed the Mondayised Waitangi Day.)
#ASSERT `the last day for submissions on a draft review report given on` (Date 15 1 2027) `, non-working days` days EQUALS Date 16 2 2027

-- Regression: 1 January 2023 was a Sunday, so 4 January was a working day
-- (corrected after the Electricity Industry Act independent pass).
#ASSERT `is a working day` (Date 4 1 2023) `, Matariki days` days
#ASSERT NOT `is a working day` (Date 3 1 2023) `, Matariki days` days

§§ `Levy (s 14)`

GIVEN paid IS A DATE
GIVETH A `Levy payment`
levy paid MEANS `Levy payment` OF Date 31 1 2026, 1000, paid

#ASSERT `the interest on late levy` (levy (Date 31 1 2026)) EQUALS 0
#ASSERT `the interest on late levy` (levy (Date 15 2 2026)) EQUALS 15
#ASSERT `the interest on late levy` (levy (Date 28 2 2026)) EQUALS 15
#ASSERT `the interest on late levy` (levy (Date 1 3 2026)) EQUALS 30
#ASSERT `the interest on late levy` (levy (Date 31 3 2026)) EQUALS 30
#ASSERT `the interest on late levy` (levy (Date 1 4 2026)) EQUALS 45

§§ `The top-level goal`

#ASSERT `the telecommunications position for` (copper TRUE TRUE TRUE FALSE TRUE TRUE) `, dispute party` (party FALSE (Date 23 10 2026) NOTHING) `, levy` (levy (Date 15 2 2026)) `, non-working days` days EQUALS `Telecommunications position` OF TRUE, TRUE, 15
