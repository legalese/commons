IMPORT prelude
IMPORT daydate
IMPORT `it-types`
IMPORT `it-residence`
IMPORT `it-liability`
IMPORT `it-credits`
IMPORT `it-codes`
IMPORT `it-goal`

-- Independent tests, written from independent-expectations.md (scenario ids
-- in comments). Expected values come from that file, not from the encoding.

§ `Independent tests`

-- 2026-27 table 1 built from the Act's thresholds.
table1 MEANS LIST (Band OF (JUST 15600), 0.105), (Band OF (JUST 53500), 0.175), (Band OF (JUST 78100), 0.30), (Band OF (JUST 180000), 0.33), (Band OF NOTHING, 0.39)

GIVEN income IS A NUMBER
GIVETH A NUMBER
taxOn income MEANS `the tax under table 1 on` income `, bands` table1

GIVEN assessable IS A NUMBER
      deductions IS A NUMBER
      loss IS A NUMBER
      schedInc IS A NUMBER
      schedLiab IS A NUMBER
GIVETH A `Tax year facts`
filer assessable deductions loss schedInc schedLiab MEANS `Tax year facts` OF 2027, TRUE, 0, assessable, deductions, loss, schedInc, schedLiab, table1

GIVEN liab IS A NUMBER
      nr IS A NUMBER
      supp IS A NUMBER
      imp IS A NUMBER
      la6 IS A NUMBER
      la7 IS A NUMBER
      ie IS A NUMBER
GIVETH A `Credit outcome`
-- [Ported by the encoder: `Residence facts` gained the YD 1B(2)(f)-(h) fields, given as TRUE (met) in every construction; no expected value changed.]
-- [Ported by the encoder: Credits gained a donation field (LD 1(5)), given as 0 here and below; no expected value changed.]
outcome liab nr supp imp la6 la7 ie MEANS `the use of credits against` liab `, credits` (Credits OF nr, supp, imp, la6, la7, 0) `, independent earner tax credit` ie

-- eligible person, full year 2026-27 (12 whole months)
GIVEN net IS A NUMBER
GIVETH A NUMBER
ietcFull net MEANS `the independent earner tax credit for` (`Independent earner facts` OF FALSE, FALSE, FALSE, 12, 0, 0) `, net income` net `, tax year ending` 2027 `, resident` TRUE

GIVEN net IS A NUMBER
      months IS A NUMBER
GIVETH A NUMBER
ietcMonths net months MEANS `the independent earner tax credit for` (`Independent earner facts` OF FALSE, FALSE, FALSE, months, 0, 0) `, net income` net `, tax year ending` 2027 `, resident` TRUE

GIVEN net IS A NUMBER
      d1 IS A NUMBER
      d2 IS A NUMBER
GIVETH A NUMBER
ietc2025 net d1 d2 MEANS `the independent earner tax credit for` (`Independent earner facts` OF FALSE, FALSE, FALSE, 0, d1, d2) `, net income` net `, tax year ending` 2025 `, resident` TRUE

GIVEN ben IS A BOOLEAN
      wff IS A BOOLEAN
      ovs IS A BOOLEAN
      res IS A BOOLEAN
GIVETH A NUMBER
ietcExcl ben wff ovs res MEANS `the independent earner tax credit for` (`Independent earner facts` OF ben, wff, ovs, 12, 0, 0) `, net income` 40000 `, tax year ending` 2027 `, resident` res

§§ `Goal 1 — residence`

-- R01 PPA, 0 days present
#ASSERT `is a New Zealand resident` (`Residence facts` OF TRUE, 0, NOTHING, 0, NOTHING, FALSE, FALSE, 0, 0, FALSE, FALSE, TRUE, TRUE, TRUE) `on` (Date 1 10 2026)
-- R02 PPA in NZ and elsewhere (same inputs: PPA in NZ is all that is asked)
#ASSERT `is a New Zealand resident` (`Residence facts` OF TRUE, 10, JUST (Date 1 4 2026), 300, JUST (Date 15 4 2026), FALSE, FALSE, 0, 0, TRUE, FALSE, TRUE, TRUE, TRUE) `on` (Date 1 10 2026)
-- R03 184 days present
#ASSERT `is a New Zealand resident` (`Residence facts` OF FALSE, 184, JUST (Date 1 4 2026), 0, NOTHING, FALSE, FALSE, 0, 0, TRUE, TRUE, TRUE, TRUE, TRUE) `on` (Date 1 12 2026)
-- R04 exactly 183 days present
#ASSERT NOT `is a New Zealand resident` (`Residence facts` OF FALSE, 183, JUST (Date 1 4 2026), 0, NOTHING, FALSE, FALSE, 0, 0, TRUE, TRUE, TRUE, TRUE, TRUE) `on` (Date 1 12 2026)
-- R05 0 days present
#ASSERT NOT `is a New Zealand resident` (`Residence facts` OF FALSE, 0, NOTHING, 0, NOTHING, FALSE, FALSE, 0, 0, TRUE, TRUE, TRUE, TRUE, TRUE) `on` (Date 1 12 2026)
-- R06 resident from the first of the 183 days (1 May 2026), not the day before
#ASSERT `is a New Zealand resident` (`Residence facts` OF FALSE, 200, JUST (Date 1 5 2026), 0, NOTHING, FALSE, FALSE, 0, 0, TRUE, TRUE, TRUE, TRUE, TRUE) `on` (Date 1 5 2026)
#ASSERT NOT `is a New Zealand resident` (`Residence facts` OF FALSE, 200, JUST (Date 1 5 2026), 0, NOTHING, FALSE, FALSE, 0, 0, TRUE, TRUE, TRUE, TRUE, TRUE) `on` (Date 30 4 2026)
-- R07 absent 326 days
#ASSERT NOT `is a New Zealand resident` (`Residence facts` OF FALSE, 200, JUST (Date 1 5 2026), 326, JUST (Date 1 6 2027), FALSE, FALSE, 0, 0, TRUE, TRUE, TRUE, TRUE, TRUE) `on` (Date 1 8 2028)
-- R08 absent exactly 325 days
#ASSERT `is a New Zealand resident` (`Residence facts` OF FALSE, 200, JUST (Date 1 5 2026), 325, JUST (Date 1 6 2027), FALSE, FALSE, 0, 0, TRUE, TRUE, TRUE, TRUE, TRUE) `on` (Date 1 8 2028)
-- R09 non-resident from the first of the 325 days (1 June 2027), resident the day before
#ASSERT NOT `is a New Zealand resident` (`Residence facts` OF FALSE, 200, JUST (Date 1 5 2026), 400, JUST (Date 1 6 2027), FALSE, FALSE, 0, 0, TRUE, TRUE, TRUE, TRUE, TRUE) `on` (Date 1 6 2027)
#ASSERT `is a New Zealand resident` (`Residence facts` OF FALSE, 200, JUST (Date 1 5 2026), 400, JUST (Date 1 6 2027), FALSE, FALSE, 0, 0, TRUE, TRUE, TRUE, TRUE, TRUE) `on` (Date 31 5 2027)
-- R10 PPA, absent 400 days
#ASSERT `is a New Zealand resident` (`Residence facts` OF TRUE, 200, JUST (Date 1 5 2026), 400, JUST (Date 1 6 2027), FALSE, FALSE, 0, 0, TRUE, TRUE, TRUE, TRUE, TRUE) `on` (Date 1 8 2028)
-- R11 absent 400 days in Government service
#ASSERT `is a New Zealand resident` (`Residence facts` OF FALSE, 200, JUST (Date 1 5 2026), 400, JUST (Date 1 6 2027), TRUE, FALSE, 0, 0, TRUE, TRUE, TRUE, TRUE, TRUE) `on` (Date 1 8 2028)
-- R12 absent 400 days, not Government service
#ASSERT NOT `is a New Zealand resident` (`Residence facts` OF FALSE, 200, JUST (Date 1 5 2026), 400, JUST (Date 1 6 2027), FALSE, FALSE, 0, 0, TRUE, TRUE, TRUE, TRUE, TRUE) `on` (Date 1 8 2028)
-- R16 RSE seasonal worker, 200 days present
#ASSERT NOT `is a New Zealand resident` (`Residence facts` OF FALSE, 200, JUST (Date 1 5 2026), 0, NOTHING, FALSE, TRUE, 0, 0, TRUE, TRUE, TRUE, TRUE, TRUE) `on` (Date 1 12 2026)
-- R17 RSE seasonal worker with a PPA
#ASSERT `is a New Zealand resident` (`Residence facts` OF TRUE, 200, JUST (Date 1 5 2026), 0, NOTHING, FALSE, TRUE, 0, 0, TRUE, TRUE, TRUE, TRUE, TRUE) `on` (Date 1 12 2026)
-- R18 non-resident visitor, 200 days
#ASSERT NOT `is a New Zealand resident` (`Residence facts` OF FALSE, 200, JUST (Date 1 4 2026), 0, NOTHING, FALSE, FALSE, 200, 200, FALSE, FALSE, TRUE, TRUE, TRUE) `on` (Date 1 12 2026)
-- R19 visit and 18-month presence exactly 275 days
#ASSERT NOT `is a New Zealand resident` (`Residence facts` OF FALSE, 275, JUST (Date 1 4 2026), 0, NOTHING, FALSE, FALSE, 275, 275, FALSE, FALSE, TRUE, TRUE, TRUE) `on` (Date 1 12 2026)
-- R20 visit 276 days
#ASSERT `is a New Zealand resident` (`Residence facts` OF FALSE, 276, JUST (Date 1 4 2026), 0, NOTHING, FALSE, FALSE, 276, 276, FALSE, FALSE, TRUE, TRUE, TRUE) `on` (Date 1 12 2026)
-- R21 visit 200, 276 days present in 18 months
#ASSERT `is a New Zealand resident` (`Residence facts` OF FALSE, 200, JUST (Date 1 4 2026), 0, NOTHING, FALSE, FALSE, 200, 276, FALSE, FALSE, TRUE, TRUE, TRUE) `on` (Date 1 12 2026)
-- R22 resident immediately before the visit
#ASSERT `is a New Zealand resident` (`Residence facts` OF FALSE, 200, JUST (Date 1 4 2026), 0, NOTHING, FALSE, FALSE, 200, 200, TRUE, FALSE, TRUE, TRUE, TRUE) `on` (Date 1 12 2026)
-- R23 / R24 working in a way YD 1B(2)(e) excludes
#ASSERT `is a New Zealand resident` (`Residence facts` OF FALSE, 200, JUST (Date 1 4 2026), 0, NOTHING, FALSE, FALSE, 200, 200, FALSE, TRUE, TRUE, TRUE, TRUE) `on` (Date 1 12 2026)
-- R28 non-resident visitor with a PPA
#ASSERT `is a New Zealand resident` (`Residence facts` OF TRUE, 200, JUST (Date 1 4 2026), 0, NOTHING, FALSE, FALSE, 200, 200, FALSE, FALSE, TRUE, TRUE, TRUE) `on` (Date 1 12 2026)

