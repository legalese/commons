IMPORT prelude
IMPORT daydate

-- Income Tax Act 2007 (New Zealand), personal income tax — THE NOUNS.
--
-- Every fact the rule modules read, and nothing else: no rules, no #EVAL.
-- Source: ../registers/source-bundle/act_public_2007_97.txt (New Zealand
-- Legislation, version as at 4 September 2026, converted from the PCO XML).
-- Field names are unique across records.

§ `Income Tax Act 2007, personal income tax — the nouns`

§§ `Residence (ss YD 1, YD 1B)`

DECLARE `Residence facts` HAS
    `has a permanent place of abode in New Zealand`     IS A BOOLEAN
    -- YD 1(3)-(4), (8): the most days personally present in any 12-month
    -- period (part days count as whole days), and the first of them.
    `most days present in a 12-month period`            IS A NUMBER
    `first of the days present`                         IS A MAYBE DATE
    -- YD 1(5)-(6): the most days personally absent in any 12-month period
    -- after becoming resident, and the first of them.
    `most days absent in a 12-month period`             IS A NUMBER
    `first of the days absent`                          IS A MAYBE DATE
    -- YD 1(7).
    `absent in the service of the New Zealand Government` IS A BOOLEAN
    -- YD 1(9): employed under the recognised seasonal employer instructions.
    `a non-resident seasonal worker`                    IS A BOOLEAN
    -- YD 1B(2)(b)-(e): the visit, counting arrival and departure days whole.
    `days of the visit`                                 IS A NUMBER
    `days present in the 18 months including the visit` IS A NUMBER
    `resident or a transitional resident immediately before the visit` IS A BOOLEAN
    `working in New Zealand in a way YD 1B(2)(e) excludes` IS A BOOLEAN
    -- YD 1B(2)(f)-(h) (added after the independent pass).
    `neither they nor their partner receive a family scheme entitlement` IS A BOOLEAN
    `lawfully present under the Immigration Act 2009`   IS A BOOLEAN
    `resident abroad or taxed abroad on citizenship`    IS A BOOLEAN

§§ `The tax year (ss BC 1-BC 8, Schedule 1)`

-- Schedule 1, part A, table 1 (lost in the conversion): one row per band,
-- the top of the band (NOTHING for the last) and the rate for each dollar in
-- it.
DECLARE Band HAS
    `band ends at`                                      IS A MAYBE NUMBER
    `rate for each dollar in the band`                  IS A NUMBER

DECLARE `Tax year facts` HAS
    -- the tax year ending on 31 March of this year.
    `tax year ending 31 March`                          IS A NUMBER
    -- BC 1: a non-filing taxpayer's liability is the tax withheld.
    `a filing taxpayer`                                 IS A BOOLEAN
    `total tax withheld from income in annual gross income` IS A NUMBER
    `assessable income allocated to the year`           IS A NUMBER
    `deductions allocated to the year`                  IS A NUMBER
    -- BC 5 and Part I.
    `tax loss available to subtract`                    IS A NUMBER
    -- BC 7: schedular income (included in the assessable income) and the
    -- liability it carries on its own.
    `schedular income`                                  IS A NUMBER
    `schedular income tax liability`                    IS A NUMBER
    `table 1`                                           IS A LIST OF Band

§§ `Credits (Parts L and M)`

DECLARE Credits HAS
    -- LA 4(1)(a): non-refundable credits other than the independent earner
    -- tax credit (which the encoding works out).
    `other non-refundable tax credits`                  IS A NUMBER
    `supplementary dividend tax credits`                IS A NUMBER
    `imputation credits`                                IS A NUMBER
    -- LA 6(1): PAYE, provisional tax, RWT, RSCT, RLWT and the other listed
    -- credits; LA 7(1): family, early childhood and R&D tax loss credits.
    `refundable tax credits under LA 6`                 IS A NUMBER
    `refundable tax credits under LA 7`                 IS A NUMBER
    -- LD 1(5): donation credits are refundable under LA 7 but "excluded from
    -- the application of sections LA 2 to LA 6" (added after the independent
    -- pass).
    `donation tax credits under LD 1`                   IS A NUMBER

-- LC 13(1)(a)-(h).
DECLARE `Independent earner facts` HAS
    `receiving a main benefit, veteran's pension or New Zealand superannuation` IS A BOOLEAN
    `entitled to or receiving a WFF tax credit, or the partner of someone receiving one` IS A BOOLEAN
    `receiving an overseas equivalent, or the partner of someone receiving an overseas WFF equivalent` IS A BOOLEAN
    `whole months in the credit period`                 IS A NUMBER
    -- LC 14-LC 15 (the 2024-25 tax year): the whole days in each part.
    `whole days in the credit period to 30 July 2024`   IS A NUMBER
    `whole days in the credit period from 31 July 2024` IS A NUMBER

§§ `Secondary tax codes (Schedule 2, part A)`

DECLARE `Tax code` IS ONE OF
    `a non-notified tax code`
    `S`
    `SH`
    `ST`
    `SA`
    `SB`
    `CAE or EDW`
    `NSW`
    `M or ME`
