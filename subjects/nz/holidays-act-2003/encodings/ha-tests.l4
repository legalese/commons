-- ss 23-26
-- s 23: 8% of 20000 = 1600, less 500 advance = 1100
#ASSERT `the annual holiday pay owed at the end of` (`End of employment` OF Date 30 9 2025, Date 1 1 2025, FALSE, 0, `weekly` 1000 0 0, 0, LIST, 20000, 500, 0, 0, 0, `daily` 200) EQUALS 1100
#ASSERT `the annual holiday pay owed at the end of` (`End of employment` OF Date 30 9 2025, Date 1 1 2025, FALSE, 0, `weekly` 1000 0 0, 0, LIST, 20000, 0, 600, 0, 0, `daily` 200) EQUALS 1000
-- advance pay exceeds the 8% (F8)
#ASSERT `the annual holiday pay owed at the end of` (`End of employment` OF Date 30 9 2025, Date 1 1 2025, FALSE, 0, `weekly` 1000 0 0, 0, LIST, 20000, 2000, 0, 0, 0, `daily` 200) EQUALS 0
-- s 24: 2 weeks at max(1000, 62400/52 = 1200) = 2400
#ASSERT `the holiday pay under s 24 for` (`End of employment` OF Date 30 9 2025, Date 1 1 2020, TRUE, 2, `weekly` 1000 0 0, 62400, LIST, 10000, 0, 0, 0, 0, `daily` 200) EQUALS 2400
-- s 25 with s 26: 8% of (10000 + 2400) = 992
#ASSERT `the holiday pay under s 25 for` (`End of employment` OF Date 30 9 2025, Date 1 1 2020, TRUE, 2, `weekly` 1000 0 0, 62400, LIST, 10000, 0, 0, 0, 0, `daily` 200) EQUALS 992
#ASSERT `the annual holiday pay owed at the end of` (`End of employment` OF Date 30 9 2025, Date 1 1 2020, TRUE, 2, `weekly` 1000 0 0, 62400, LIST, 10000, 0, 0, 0, 0, `daily` 200) EQUALS 3392
-- OWP 1300 at the end is greater: 2600 + 8% of 12600 = 1008 -> 3608
#ASSERT `the annual holiday pay owed at the end of` (`End of employment` OF Date 30 9 2025, Date 1 1 2020, TRUE, 2, `weekly` 1300 0 0, 62400, LIST, 10000, 0, 0, 0, 0, `daily` 200) EQUALS 3608
-- all taken: s 25 alone, 8% of 10000 = 800
#ASSERT `the annual holiday pay owed at the end of` (`End of employment` OF Date 30 9 2025, Date 1 1 2020, TRUE, 0, `weekly` 1000 0 0, 62400, LIST, 10000, 0, 0, 0, 0, `daily` 200) EQUALS 800

-- ss 29-35
-- entitled, 3 weeks' closedown, 2 weeks' entitlement, rate max(1000, 1000):
-- 2 weeks as annual holidays, 2000; notice 1 Dec for 20 Dec.
#ASSERT (`the closedown position for` (Closedown OF Date 20 12 2025, Date 1 12 2025, FALSE, TRUE, 3, 2, FALSE, `weekly` 1000 0 0, 52000, 0, 0, 0, LIST))'s `holiday pay for the closedown` EQUALS 2000
#ASSERT (`the closedown position for` (Closedown OF Date 20 12 2025, Date 1 12 2025, FALSE, TRUE, 3, 2, FALSE, `weekly` 1000 0 0, 52000, 0, 0, 0, LIST))'s `weeks taken as annual holidays` EQUALS 2
#ASSERT (`the closedown position for` (Closedown OF Date 20 12 2025, Date 1 12 2025, FALSE, TRUE, 3, 2, FALSE, `weekly` 1000 0 0, 52000, 0, 0, 0, LIST))'s `the employer may require the closedown to be taken` EQUALS TRUE
#ASSERT (`the closedown position for` (Closedown OF Date 20 12 2025, Date 1 12 2025, FALSE, TRUE, 3, 2, FALSE, `weekly` 1000 0 0, 52000, 0, 0, 0, LIST))'s `the 12 months restart at the closedown (s 35)` EQUALS FALSE
-- with an agreement to take the rest in advance: 3 weeks, 3000
#ASSERT (`the closedown position for` (Closedown OF Date 20 12 2025, Date 1 12 2025, FALSE, TRUE, 3, 2, TRUE, `weekly` 1000 0 0, 52000, 0, 0, 0, LIST))'s `holiday pay for the closedown` EQUALS 3000
#ASSERT (`the closedown position for` (Closedown OF Date 20 12 2025, Date 1 12 2025, FALSE, TRUE, 3, 2, TRUE, `weekly` 1000 0 0, 52000, 0, 0, 0, LIST))'s `weeks taken as annual holidays in advance` EQUALS 1
-- entitlement covers the whole closedown
#ASSERT (`the closedown position for` (Closedown OF Date 20 12 2025, Date 1 12 2025, FALSE, TRUE, 2, 4, FALSE, `weekly` 1000 0 0, 52000, 0, 0, 0, LIST))'s `holiday pay for the closedown` EQUALS 2000
-- not entitled: 8% of 15000 = 1200, less 200 advance = 1000; s 35 restart
#ASSERT (`the closedown position for` (Closedown OF Date 20 12 2025, Date 1 12 2025, FALSE, FALSE, 2, 0, FALSE, `weekly` 1000 0 0, 52000, 15000, 200, 0, LIST))'s `holiday pay for the closedown` EQUALS 1000
#ASSERT (`the closedown position for` (Closedown OF Date 20 12 2025, Date 1 12 2025, FALSE, FALSE, 2, 0, FALSE, `weekly` 1000 0 0, 52000, 15000, 200, 0, LIST))'s `the 12 months restart at the closedown (s 35)` EQUALS TRUE
-- not entitled, agreed under s 34(4) to take it in advance: 2 x 1000
#ASSERT (`the closedown position for` (Closedown OF Date 20 12 2025, Date 1 12 2025, FALSE, FALSE, 2, 0, TRUE, `weekly` 1000 0 0, 52000, 15000, 200, 0, LIST))'s `holiday pay for the closedown` EQUALS 2000
#ASSERT (`the closedown position for` (Closedown OF Date 20 12 2025, Date 1 12 2025, FALSE, FALSE, 2, 0, TRUE, `weekly` 1000 0 0, 52000, 15000, 200, 0, LIST))'s `the 12 months restart at the closedown (s 35)` EQUALS FALSE
-- a second closedown in 12 months; short notice
#ASSERT (`the closedown position for` (Closedown OF Date 20 12 2025, Date 1 12 2025, TRUE, TRUE, 2, 4, FALSE, `weekly` 1000 0 0, 52000, 0, 0, 0, LIST))'s `the employer may require the closedown to be taken` EQUALS FALSE
#ASSERT (`the closedown position for` (Closedown OF Date 20 12 2025, Date 10 12 2025, FALSE, TRUE, 2, 4, FALSE, `weekly` 1000 0 0, 52000, 0, 0, 0, LIST))'s `the employer may require the closedown to be taken` EQUALS FALSE

-- ss 36-40
#ASSERT `how the time may be taken under ss 36 to 39` `s 36 sick or injured, or a spouse, partner or dependant is, during annual holidays` EQUALS `as sick leave, if the employer agrees`
#ASSERT `how the time may be taken under ss 36 to 39` `s 37 a bereavement during annual holidays` EQUALS `as bereavement leave, which the employer must allow`
#ASSERT `how the time may be taken under ss 36 to 39` `s 37A family violence leave becomes available during annual holidays` EQUALS `as family violence leave, which the employer must allow`
#ASSERT `how the time may be taken under ss 36 to 39` `s 38 any of these before scheduled annual holidays` EQUALS `as sick, bereavement or family violence leave, which the employer must allow`
#ASSERT `how the time may be taken under ss 36 to 39` `s 39 sick, bereavement or family violence leave exhausted` EQUALS `not as annual holidays unless the employer agrees to the employee's request`
#ASSERT `the days of annual holidays used, working days in the holiday` 10 `, public holidays on them` 1 EQUALS 9

§§ `Goal 3 — public holidays`

#ASSERT `Easter Sunday in` 2024 EQUALS Date 31 3 2024
#ASSERT `Easter Sunday in` 2025 EQUALS Date 20 4 2025
#ASSERT `Easter Sunday in` 2026 EQUALS Date 5 4 2026
#ASSERT `Easter Sunday in` 2027 EQUALS Date 28 3 2027
#ASSERT `the day` `Good Friday` `falls on, calendar` (`weekday calendar` 2026) EQUALS Date 3 4 2026
#ASSERT `the day` `Easter Monday` `falls on, calendar` (`weekday calendar` 2026) EQUALS Date 6 4 2026
#ASSERT `the day` `the Sovereign's birthday` `falls on, calendar` (`weekday calendar` 2026) EQUALS Date 1 6 2026
#ASSERT `the day` `Labour Day` `falls on, calendar` (`weekday calendar` 2026) EQUALS Date 26 10 2026
#ASSERT `the day` `Labour Day` `falls on, calendar` (`weekday calendar` 2025) EQUALS Date 27 10 2025
#ASSERT `the day` `Matariki Observance Day` `falls on, calendar` (`weekday calendar` 2026) EQUALS Date 20 6 2026

-- s 45: 2027, Christmas Saturday -> Monday 27; Boxing Sunday -> Tuesday 28;
-- 2 January Saturday -> Monday 4 January. s 45A: Waitangi Saturday ->
-- Monday 8 February; ANZAC Sunday -> Monday 26 April.
#ASSERT `the day` `(a) Christmas Day` `is treated as falling on, calendar` (`weekday calendar` 2027) EQUALS Date 27 12 2027
#ASSERT `the day` `(b) Boxing Day` `is treated as falling on, calendar` (`weekday calendar` 2027) EQUALS Date 28 12 2027
#ASSERT `the day` `(d) 2 January` `is treated as falling on, calendar` (`weekday calendar` 2027) EQUALS Date 4 1 2027
#ASSERT `the day` `(c) New Year's Day` `is treated as falling on, calendar` (`weekday calendar` 2027) EQUALS Date 1 1 2027
#ASSERT `the day` `Waitangi Day` `is treated as falling on, calendar` (`weekday calendar` 2027) EQUALS Date 8 2 2027
#ASSERT `the day` `ANZAC Day` `is treated as falling on, calendar` (`weekday calendar` 2027) EQUALS Date 26 4 2027
-- 2022: Christmas Sunday -> Tuesday 27 December (Boxing Day is Monday 26)
#ASSERT `the day` `(a) Christmas Day` `is treated as falling on, calendar` (`weekday calendar` 2022) EQUALS Date 27 12 2022
#ASSERT `the day` `(b) Boxing Day` `is treated as falling on, calendar` (`weekday calendar` 2022) EQUALS Date 26 12 2022
-- a Saturday worker keeps Christmas 2027 on the Saturday
#ASSERT `the day` `(a) Christmas Day` `is treated as falling on, calendar` (`Calendar inputs` OF 2027, Date 25 6 2027, Date 25 1 2027, LIST 1, 2, 3, 4, 5, 6) EQUALS Date 25 12 2027
-- a Sunday worker keeps ANZAC Day 2027 on the Sunday
