#ASSERT `the average daily pay` (`Daily pay facts` OF TRUE, 0, NOTHING, NOTHING, FALSE, FALSE, 52000, 260) EQUALS 200
#ASSERT REFUSED (`the average daily pay` (`Daily pay facts` OF FALSE, 0, NOTHING, NOTHING, FALSE, FALSE, 52000, 0))

-- ss 9, 9A: which measure
#ASSERT `the daily pay` (`Daily pay facts` OF FALSE, 0, NOTHING, NOTHING, FALSE, FALSE, 52000, 260) EQUALS 200
#ASSERT `the daily pay` (`Daily pay facts` OF TRUE, 180, NOTHING, NOTHING, TRUE, TRUE, 52000, 260) EQUALS 200
#ASSERT `the daily pay` (`Daily pay facts` OF TRUE, 180, NOTHING, NOTHING, TRUE, FALSE, 52000, 260) EQUALS 180
#ASSERT `the daily pay` (`Daily pay facts` OF TRUE, 180, NOTHING, NOTHING, FALSE, TRUE, 52000, 260) EQUALS 180
