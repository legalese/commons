#ASSERT `the relevant daily pay` (`Daily pay facts` OF TRUE, 200, JUST (`Board or lodgings` OF 10, FALSE, FALSE), JUST 250, FALSE, FALSE, 0, 0) EQUALS 250
#ASSERT `the relevant daily pay` (`Daily pay facts` OF TRUE, 200, JUST (`Board or lodgings` OF 10, FALSE, FALSE), JUST 150, FALSE, FALSE, 0, 0) EQUALS 210

