-- s 16(2): which absences count toward the 12 months
#ASSERT `the absence counts toward the 12 months` (`absence` `other unpaid leave` 7 FALSE) EQUALS TRUE
#ASSERT `the absence counts toward the 12 months` (`absence` `other unpaid leave` 8 FALSE) EQUALS FALSE
#ASSERT `the absence counts toward the 12 months` (`absence` `other unpaid leave` 30 TRUE) EQUALS TRUE
#ASSERT `the absence counts toward the 12 months` (`absence` `(a)(ii) parental leave` 180 FALSE) EQUALS TRUE
#ASSERT `the absence counts toward the 12 months` (`absence` `(a)(v) unpaid sick, bereavement or family violence leave` 20 FALSE) EQUALS TRUE

-- s 5, s 16(3): 52000/52 = 1000; 10 days agreed: 1 part week over the first,
-- divisor 51; 21 days agreed: 2 weeks over, divisor 50 -> 1040; not agreed:
-- no reduction.
#ASSERT `the average weekly earnings over 12 months, gross` 52000 `, absences` (LIST) EQUALS 1000
#ASSERT `the divisor for 12 months, after s 16(3), given` (LIST (`absence` `other unpaid leave` 10 TRUE)) EQUALS 51
#ASSERT `the average weekly earnings over 12 months, gross` 52000 `, absences` (LIST (`absence` `other unpaid leave` 21 TRUE)) EQUALS 1040
#ASSERT `the average weekly earnings over 12 months, gross` 52000 `, absences` (LIST (`absence` `other unpaid leave` 21 FALSE)) EQUALS 1000
#ASSERT `the divisor for 12 months, after s 16(3), given` (LIST (`absence` `other unpaid leave` 7 TRUE)) EQUALS 52

§§ `Goal 2 — annual holidays`

