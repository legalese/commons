-- s 8(2): (4800 - 400) / 4 = 1100
#ASSERT `the ordinary weekly pay` (`Weekly pay facts` OF FALSE, 0, 0, 0, NOTHING, 4800, 400, NOTHING) EQUALS 1100
-- s 8(2) with a monthly pay period: still divided by 4 (F1)
#ASSERT `the ordinary weekly pay` (`Weekly pay facts` OF FALSE, 0, 0, 0, NOTHING, 5200, 0, NOTHING) EQUALS 1300
-- s 8(3)
#ASSERT `the ordinary weekly pay` (`Weekly pay facts` OF TRUE, 1000, 0, 0, NOTHING, 0, 0, JUST 1200) EQUALS 1200
#ASSERT `the ordinary weekly pay` (`Weekly pay facts` OF TRUE, 1000, 0, 0, NOTHING, 0, 0, JUST 900) EQUALS 1000
#ASSERT `the ordinary weekly pay` (`Weekly pay facts` OF TRUE, 1000, 0, 0, NOTHING, 0, 0, JUST 1000) EQUALS 1000
#ASSERT `the ordinary weekly pay` (`weekly` 1000 0 0) EQUALS 1000

