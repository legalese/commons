#ASSERT (`the holiday pay position for` (`the end of the employment` (`End of employment` OF Date 30 9 2025, Date 1 1 2020, TRUE, 2, `weekly` 1000 0 0, 62400, LIST, 10000, 0, 0, 2, 1, `daily` 200)))'s `when it is due` EQUALS `in the pay for the final period of employment`
-- s 40(2)(b): no s 40(3) pay before the first entitlement: 8% of 20000 = 1600 only
#ASSERT (`the holiday pay position for` (`the end of the employment` (`End of employment` OF Date 30 9 2025, Date 1 1 2025, FALSE, 0, `weekly` 1000 0 0, 0, LIST, 20000, 0, 0, 2, 0, `daily` 200)))'s `amount the employer must pay` EQUALS 1600
-- sick leave
#ASSERT (`the holiday pay position for` (`a spell of leave` (`leave` `sick leave` (Date 1 9 2025) (Date 1 1 2024) 2 5 `(a) the employee is sick or injured` `no bereavements`)))'s `amount the employer must pay` EQUALS 400
#ASSERT (`the holiday pay position for` (`a spell of leave` (`leave` `sick leave` (Date 1 9 2025) (Date 1 1 2024) 2 5 `(a) the employee is sick or injured` `no bereavements`)))'s `entitlement used` EQUALS 2
-- a cash-up and an exchange
#ASSERT (`the holiday pay position for` (`a request to cash up annual holidays` (`Payout request` OF TRUE, 1, 0, FALSE, TRUE, `weekly` 1000 0 0, 57200, 4, LIST)))'s `amount the employer must pay` EQUALS 1100
#ASSERT (`the holiday pay position for` (`a request to cash up annual holidays` (`Payout request` OF TRUE, 1, 0, FALSE, TRUE, `weekly` 1000 0 0, 57200, 4, LIST)))'s `when it is due` EQUALS `as soon as practicable after the employer agrees`
#ASSERT (`the holiday pay position for` (`a request to exchange an alternative holiday` (`Exchange request` OF Date 1 1 2025, Date 1 1 2026, TRUE, 250)))'s `amount the employer must pay` EQUALS 250
-- a closedown, not entitled
#ASSERT (`the holiday pay position for` (`a closedown` (Closedown OF Date 20 12 2025, Date 1 12 2025, FALSE, FALSE, 2, 0, FALSE, `weekly` 1000 0 0, 52000, 15000, 200, 0, LIST)))'s `amount the employer must pay` EQUALS 1000
-- an alternative holiday taken
#ASSERT (`the holiday pay position for` (`an alternative holiday taken` (`Alternative holiday` OF Date 10 3 2025, TRUE, TRUE, TRUE, FALSE, NOTHING, `daily` 200)))'s `amount the employer must pay` EQUALS 200
