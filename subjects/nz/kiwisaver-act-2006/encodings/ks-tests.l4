#ASSERT (`the KiwiSaver position for` (`KiwiSaver case` OF `an adult`, `new job`, `a 1000 pay`, `employer side` 0 FALSE FALSE, NOTHING, `the account`))'s `last day to opt out` EQUALS JUST (Date 28 4 2025)
#ASSERT (`the KiwiSaver position for` (`KiwiSaver case` OF `an adult`, `new job`, `a 1000 pay`, `employer side` 0 FALSE FALSE, NOTHING, `the account`))'s `deduction from the pay` EQUALS 35
#ASSERT (`the KiwiSaver position for` (`KiwiSaver case` OF `an adult`, `new job`, `a 1000 pay`, `employer side` 0 FALSE FALSE, NOTHING, `the account`))'s `compulsory employer contribution` EQUALS 35
#ASSERT (`the KiwiSaver position for` (`KiwiSaver case` OF `an adult`, `new job`, `a 1000 pay`, `employer side` 0 FALSE FALSE, NOTHING, `the account`))'s `most that may be withdrawn` EQUALS NOTHING
#ASSERT (`the KiwiSaver position for` (`KiwiSaver case` OF (Person OF Date 1 1 1990, 65, TRUE, TRUE, TRUE), `new job`, `a 1000 pay`, `employer side` 0 FALSE FALSE, JUST (`withdrawal for` `cl 9 death` `aged` 35 `, satisfied:` FALSE), `the account`))'s `first day to opt out` EQUALS NOTHING
#ASSERT (`the KiwiSaver position for` (`KiwiSaver case` OF (Person OF Date 1 1 1990, 65, TRUE, TRUE, TRUE), `new job`, `a 1000 pay`, `employer side` 0 FALSE FALSE, JUST (`withdrawal for` `cl 9 death` `aged` 35 `, satisfied:` FALSE), `the account`))'s `most that may be withdrawn` EQUALS JUST 50000

§§ `Legislation Act 2019 s 55 (added 2026-10-17)`

-- In 2026 Anzac Day is a Saturday, so Monday 27 April is also not a working
-- day: 55 days after 1 March 2026 is 25 April, so the opt-out runs to
-- Tuesday 28 April.
#ASSERT `the last day to opt out, employment started` (Date 1 3 2026) EQUALS Date 28 4 2026
-- A working day stays: 55 days after 2 March 2026 is Sunday 26 April, so
-- Tuesday 28 April too; 55 days after 4 March is Tuesday 28 April itself.
#ASSERT `the last day to opt out, employment started` (Date 4 3 2026) EQUALS Date 28 4 2026
-- 1 month after salary paid on 30 June 2026 is Thursday 30 July: unchanged.
#ASSERT `the last day to pay a complying fund, salary paid` (Date 30 6 2026) EQUALS Date 30 7 2026
-- 1 month after salary paid on 10 June 2026 is Matariki Day (10 July): Monday 13 July.
#ASSERT `the last day to pay a complying fund, salary paid` (Date 10 6 2026) EQUALS Date 13 7 2026
