-- C47 complying fund deadline: 1 month after the pay
#ASSERT `the last day to pay a complying fund, salary paid` (Date 15 3 2026) EQUALS Date 15 4 2026

§ `Rate reductions (s 101L)`

-- C74 92 days counted inclusively (1 Apr - 1 Jul 2026): granted
#ASSERT `a rate reduction must be granted, starting` (Date 1 4 2026) `, ending` (Date 1 7 2026) EQUALS TRUE
-- C75 91 days inclusive (1 Apr - 30 Jun 2026): not granted
#ASSERT `a rate reduction must be granted, starting` (Date 1 4 2026) `, ending` (Date 30 6 2026) EQUALS FALSE
-- C48 clearly short (60 days)
#ASSERT `a rate reduction must be granted, starting` (Date 1 4 2026) `, ending` (Date 31 5 2026) EQUALS FALSE
-- C76 exactly 1 year (1 Apr 2026 - 31 Mar 2027)
#ASSERT `a rate reduction must be granted, starting` (Date 1 4 2026) `, ending` (Date 31 3 2027) EQUALS TRUE
-- C77 1 year and 1 day (1 Apr 2026 - 1 Apr 2027): not granted
