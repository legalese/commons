IMPORT prelude
IMPORT daydate

-- KiwiSaver Act 2006 (New Zealand) — THE NOUNS.
--
-- Every fact the rule modules read, and nothing else: no rules, no #EVAL.
-- Source: ../registers/source-bundle/act_public_2006_40.txt (New Zealand
-- Legislation, version as at 1 April 2026, converted from the PCO XML).
-- Field names are unique across records.

§ `KiwiSaver Act 2006 — the nouns`

§§ `The person (s 6)`

DECLARE Person HAS
    `date of birth`                                     IS A DATE
    -- s 4 "New Zealand superannuation qualification age means the age
    -- specified in section 7(1) of the New Zealand Superannuation and
    -- Retirement Income Act 2001".
    `New Zealand superannuation qualification age`      IS A NUMBER
    -- s 6(1)(a) living in New Zealand (or serving the State abroad on New
    -- Zealand terms where KiwiSaver offers are lawful); (b) a citizen or
    -- entitled to be in New Zealand indefinitely.
    `living in New Zealand, or a qualifying State servant abroad` IS A BOOLEAN
    `a citizen or entitled to be in New Zealand indefinitely` IS A BOOLEAN
    `already a member of a KiwiSaver scheme`            IS A BOOLEAN

§§ `New employment (ss 10-14)`

DECLARE `Kind of employment` IS ONE OF
    `ordinary employment`
    `casual agricultural work`
    `a contract of service for 28 continuous days or less`
    `intermittent or irregular work under s 28(1)(a)(ii) of the Holidays Act 2003`

DECLARE Employment HAS
    `started on`                                        IS A DATE
    `kind of employment`                                IS A `Kind of employment`
    `the employer is exempt`                            IS A BOOLEAN
    `a secondee`                                        IS A BOOLEAN
    -- s 11(1)(b)-(d): the same payroll, the same business, or back from a
    -- secondment.
    `same payroll, same business, or the end of a secondment` IS A BOOLEAN
    -- s 14(1): an employee only because of the listed payments, an election
    -- day or private domestic worker, no PAYE required, or PAYE only under
    -- s YD 1(7).
    `excluded by s 14(1)`                               IS A BOOLEAN
    -- s 12(2)(b): whether a contract of 28 continuous days or less went on to
    -- the 28th day after it started (added after the independent pass).
    `the short contract continued to the 28th day`      IS A BOOLEAN

§§ `Contributions (Part 3)`

-- s 64(1): which default rate applies.
DECLARE `Rate history` IS ONE OF
    `deductions first applied on or after 1 April 2009`
    `deductions first applied before 1 April 2009`
    `the s 66A transitional rule applied immediately before 1 April 2009`
    `on a 2% rate chosen before the first pay period starting on or after 1 April 2013`

DECLARE `Contribution facts` HAS
    `rate history`                                      IS A `Rate history`
    -- s 64(2): a rate the employee chose (3.5, 4, 6, 8 or 10), if any.
    `rate chosen by notice`                             IS A MAYBE NUMBER
    `has a rate reduction`                              IS A BOOLEAN
    `on a savings suspension or with a non-deduction notice` IS A BOOLEAN
    `payment calculated on`                             IS A DATE
    `gross salary or wages for the pay`                 IS A NUMBER

-- s 101C, s 101D: the employee and the other contributions.
DECLARE `Employer contribution facts` HAS
    `employee aged`                                     IS A NUMBER
    `may withdraw under clause 4 (lock-in ended)`       IS A BOOLEAN
    `made a congenital condition withdrawal under clause 12B` IS A BOOLEAN
    `a defined benefit scheme member`                   IS A BOOLEAN
    `deductions are made or required from the pay`      IS A BOOLEAN
    -- s 101D(4)(a): the employer chooses the 3% rate for an employee with a
    -- rate reduction.
    `the employer applies 3% for a rate reduction`      IS A BOOLEAN
    `other contributions for the period`                IS A NUMBER
    `hybrid schemes amount for the period`              IS A NUMBER
    -- s 101FB: a grace period with no deductions and no opt-in or s 61
    -- notice.
    `in a grace period with no deductions`              IS A BOOLEAN

§§ `Withdrawals (Schedule 1)`

DECLARE `Withdrawal purpose` IS ONE OF
    `cl 4 reaching the New Zealand superannuation qualification age`
    `cl 4B amounts from an Australian scheme at 60 and retired`
    `cl 8 purchase of a first home`
    `cl 9 death`
    `cl 10 significant financial hardship`
    `cl 12 serious illness`
    `cl 12B a life-shortening congenital condition`
    `cl 14 permanent emigration (other than to Australia)`
    `cl 14C tax on a foreign superannuation withdrawal`

DECLARE `Member account` HAS
    `member's accumulation`                             IS A NUMBER
    `Crown contribution in it`                          IS A NUMBER
    `Crown contribution from tax credits in it`         IS A NUMBER
    `amount transferred from an Australian scheme`      IS A NUMBER

DECLARE `Withdrawal facts` HAS
    `purpose`                                           IS A `Withdrawal purpose`
    `member aged`                                       IS A NUMBER
    `qualification age reached`                         IS A BOOLEAN
    `retired under the Australian rules`                IS A BOOLEAN
    -- cl 8(1): no earlier first-home withdrawal, and 3 years since the first
    -- contribution or 3 years' combined membership.
    `made a first home withdrawal before`               IS A BOOLEAN
    `years since the first contribution or of membership` IS A NUMBER
    -- cl 8(3)(b)-(c): principal residence and never held an estate in land
    -- (or a qualifying person, or prescribed circumstances).
    `the home is to be the principal residence`         IS A BOOLEAN
    `has never held an estate in land, or qualifies otherwise` IS A BOOLEAN
    `the manager or supervisor is satisfied of the ground` IS A BOOLEAN
    `alternative funding explored and exhausted`        IS A BOOLEAN
    `amount needed to alleviate the hardship`           IS A MAYBE NUMBER
    `emigrated on`                                      IS A DATE
    `applied on`                                        IS A DATE
    `tax or student loan liability`                     IS A NUMBER
