IMPORT prelude
IMPORT daydate
IMPORT `caa-types`
IMPORT `caa-liability`
IMPORT `caa-goal`

-- Independent tests, written from independent-expectations.md.
-- Carriage OF dep-NZ, dest-NZ, stop-abroad, single-flight-return, excluded-by-regs, delay-in-air
-- Delay claim OF cause, measures, damage, sum, raised-limit, intent/reckless, limiting-term
-- Claim dates OF arrived, ought, stopped, brought

-- Goal 1: application
-- A-01
-- [Ported by the encoder: `Carrier facts` gained `carriage by successive carriers` (s 275), given as FALSE; no expected value changed.]
#ASSERT `the domestic carriage subpart applies to` (Carriage OF TRUE, TRUE, FALSE, FALSE, FALSE, TRUE)
-- A-02 NZ to Australia
#ASSERT NOT `the domestic carriage subpart applies to` (Carriage OF TRUE, FALSE, FALSE, FALSE, FALSE, TRUE)
-- A-03 Australia to NZ
#ASSERT NOT `the domestic carriage subpart applies to` (Carriage OF FALSE, TRUE, FALSE, FALSE, FALSE, TRUE)
-- A-04 NZ to NZ via agreed stop abroad
#ASSERT NOT `the domestic carriage subpart applies to` (Carriage OF TRUE, TRUE, TRUE, FALSE, FALSE, TRUE)
-- A-05 unagreed diversion abroad: contract has no foreign stop
#ASSERT `the domestic carriage subpart applies to` (Carriage OF TRUE, TRUE, FALSE, FALSE, FALSE, TRUE)
-- A-06 aircraft also engaged in international carriage: contract still domestic
#ASSERT `the domestic carriage subpart applies to` (Carriage OF TRUE, TRUE, FALSE, FALSE, FALSE, TRUE)
-- A-07 wholly within Australia
#ASSERT NOT `the domestic carriage subpart applies to` (Carriage OF FALSE, FALSE, FALSE, FALSE, FALSE, TRUE)
-- A-08 single flight returning to departure point
#ASSERT NOT `the domestic carriage subpart applies to` (Carriage OF TRUE, TRUE, FALSE, TRUE, FALSE, TRUE)
-- A-09 return trip on two flights: not a single flight
#ASSERT `the domestic carriage subpart applies to` (Carriage OF TRUE, TRUE, FALSE, FALSE, FALSE, TRUE)
-- A-10 excluded by regulations
#ASSERT NOT `the domestic carriage subpart applies to` (Carriage OF TRUE, TRUE, FALSE, FALSE, TRUE, TRUE)
-- A-11 both exclusions
#ASSERT NOT `the domestic carriage subpart applies to` (Carriage OF TRUE, TRUE, FALSE, TRUE, TRUE, TRUE)
-- A-12 combined carriage, delay on air leg
#ASSERT `the domestic carriage subpart applies to` (Carriage OF TRUE, TRUE, FALSE, FALSE, FALSE, TRUE)
-- A-13 combined carriage, delay on ferry leg
#ASSERT NOT `the domestic carriage subpart applies to` (Carriage OF TRUE, TRUE, FALSE, FALSE, FALSE, FALSE)

-- Goal 1: carriers
-- A-14 single contracting carrier
#ASSERT `the carrier is answerable for the delay` (`Carrier facts` OF `the contracting carrier`, TRUE, FALSE)
-- A-15 actual carrier performed whole carriage: contracting carrier liable
#ASSERT `the carrier is answerable for the delay` (`Carrier facts` OF `the contracting carrier`, FALSE, FALSE)
-- A-15 actual carrier liable
#ASSERT `the carrier is answerable for the delay` (`Carrier facts` OF `the actual carrier`, TRUE, FALSE)
-- A-16 actual carrier performed leg 2, delay on leg 2
#ASSERT `the carrier is answerable for the delay` (`Carrier facts` OF `the actual carrier`, TRUE, FALSE)
-- A-17 contracting carrier still liable for delay on leg 1
#ASSERT `the carrier is answerable for the delay` (`Carrier facts` OF `the contracting carrier`, TRUE, FALSE)
-- A-17 actual carrier not liable for delay on leg it did not perform
#ASSERT NOT `the carrier is answerable for the delay` (`Carrier facts` OF `the actual carrier`, FALSE, FALSE)
-- A-18 successive carrier B performed the delayed stage
#ASSERT `the carrier is answerable for the delay` (`Carrier facts` OF `a successive carrier`, TRUE, FALSE)
-- A-18 successive carrier A did not
#ASSERT NOT `the carrier is answerable for the delay` (`Carrier facts` OF `a successive carrier`, FALSE, FALSE)
-- A-19 delay on leg 1: A liable
#ASSERT `the carrier is answerable for the delay` (`Carrier facts` OF `a successive carrier`, TRUE, FALSE)
-- A-20 C was to perform the stage
#ASSERT `the carrier is answerable for the delay` (`Carrier facts` OF `a successive carrier`, TRUE, FALSE)

-- Goal 2: liability
-- L-01
#ASSERT `the carrier is liable for the delay` (`Delay claim` OF `another cause`, FALSE, 500, 200, NOTHING, FALSE, NOTHING)
-- L-02
#ASSERT NOT `the carrier is liable for the delay` (`Delay claim` OF `meteorological conditions`, FALSE, 500, 200, NOTHING, FALSE, NOTHING)
-- L-03
#ASSERT NOT `the carrier is liable for the delay` (`Delay claim` OF `air traffic control instructions, advice or information`, FALSE, 500, 200, NOTHING, FALSE, NOTHING)
-- L-04
#ASSERT NOT `the carrier is liable for the delay` (`Delay claim` OF `orders or directions of a lawful authority`, FALSE, 500, 200, NOTHING, FALSE, NOTHING)
-- L-05
#ASSERT NOT `the carrier is liable for the delay` (`Delay claim` OF `force majeure`, FALSE, 500, 200, NOTHING, FALSE, NOTHING)
-- L-06
#ASSERT NOT `the carrier is liable for the delay` (`Delay claim` OF `saving or attempting to save life`, FALSE, 500, 200, NOTHING, FALSE, NOTHING)
-- L-07 crew shortage
#ASSERT `the carrier is liable for the delay` (`Delay claim` OF `another cause`, FALSE, 500, 200, NOTHING, FALSE, NOTHING)
-- L-08 all necessary measures
#ASSERT NOT `the carrier is liable for the delay` (`Delay claim` OF `another cause`, TRUE, 500, 200, NOTHING, FALSE, NOTHING)
-- L-09 impossible to take measures
#ASSERT NOT `the carrier is liable for the delay` (`Delay claim` OF `another cause`, TRUE, 500, 200, NOTHING, FALSE, NOTHING)
-- L-10 agent took measures (same input)
#ASSERT NOT `the carrier is liable for the delay` (`Delay claim` OF `another cause`, TRUE, 500, 200, NOTHING, FALSE, NOTHING)
-- L-11 weather and measures
#ASSERT NOT `the carrier is liable for the delay` (`Delay claim` OF `meteorological conditions`, TRUE, 500, 200, NOTHING, FALSE, NOTHING)

-- Goal 2: limit
-- C-01
#ASSERT `the most the carrier must pay for the delay` (`Delay claim` OF `another cause`, FALSE, 500, 200, NOTHING, FALSE, NOTHING) EQUALS 500
-- C-02
#ASSERT `the most the carrier must pay for the delay` (`Delay claim` OF `another cause`, FALSE, 3000, 200, NOTHING, FALSE, NOTHING) EQUALS 2000
-- C-03
#ASSERT `the most the carrier must pay for the delay` (`Delay claim` OF `another cause`, FALSE, 2000, 200, NOTHING, FALSE, NOTHING) EQUALS 2000
-- C-04
#ASSERT `the most the carrier must pay for the delay` (`Delay claim` OF `another cause`, FALSE, 1500, 99.5, NOTHING, FALSE, NOTHING) EQUALS 995
-- C-05
#ASSERT `the most the carrier must pay for the delay` (`Delay claim` OF `another cause`, FALSE, 0, 200, NOTHING, FALSE, NOTHING) EQUALS 0
-- C-06 free carriage
#ASSERT `the most the carrier must pay for the delay` (`Delay claim` OF `another cause`, FALSE, 400, 0, NOTHING, FALSE, NOTHING) EQUALS 0
-- C-07 special contract raises to 4000
#ASSERT `the most the carrier must pay for the delay` (`Delay claim` OF `another cause`, FALSE, 5000, 200, JUST 4000, FALSE, NOTHING) EQUALS 4000
-- C-08 raised but damage lower
#ASSERT `the most the carrier must pay for the delay` (`Delay claim` OF `another cause`, FALSE, 3000, 200, JUST 4000, FALSE, NOTHING) EQUALS 3000
-- C-09 special contract "cap" below 10x is unenforceable
#ASSERT `the most the carrier must pay for the delay` (`Delay claim` OF `another cause`, FALSE, 5000, 200, JUST 1000, FALSE, NOTHING) EQUALS 2000
-- C-10 term excluding all delay liability ignored
#ASSERT `the most the carrier must pay for the delay` (`Delay claim` OF `another cause`, FALSE, 5000, 200, NOTHING, FALSE, JUST 0) EQUALS 2000
-- C-11 intent
#ASSERT `the most the carrier must pay for the delay` (`Delay claim` OF `another cause`, FALSE, 5000, 200, NOTHING, TRUE, NOTHING) EQUALS 5000
-- C-12 recklessness
#ASSERT `the most the carrier must pay for the delay` (`Delay claim` OF `another cause`, FALSE, 5000, 200, NOTHING, TRUE, NOTHING) EQUALS 5000
-- C-13 recklessness, damage below cap
#ASSERT `the most the carrier must pay for the delay` (`Delay claim` OF `another cause`, FALSE, 1000, 200, NOTHING, TRUE, NOTHING) EQUALS 1000
-- C-14 special cap and recklessness
#ASSERT `the most the carrier must pay for the delay` (`Delay claim` OF `another cause`, FALSE, 9000, 200, JUST 4000, TRUE, NOTHING) EQUALS 9000
-- C-15 weather defence
#ASSERT `the most the carrier must pay for the delay` (`Delay claim` OF `meteorological conditions`, FALSE, 500, 200, NOTHING, FALSE, NOTHING) EQUALS 0

-- Goal 3: time limits
-- T-01
#ASSERT `the last day to bring an action, dates` (`Claim dates` OF JUST (Date 10 3 2024), Date 10 3 2024, NOTHING, Date 10 3 2026) EQUALS Date 10 3 2026
-- T-02
#ASSERT `the action is in time` (`Claim dates` OF JUST (Date 10 3 2024), Date 10 3 2024, NOTHING, Date 10 3 2026)
-- T-03
#ASSERT NOT `the action is in time` (`Claim dates` OF JUST (Date 10 3 2024), Date 10 3 2024, NOTHING, Date 11 3 2026)
-- T-04
#ASSERT `the last day to bring an action, dates` (`Claim dates` OF JUST (Date 29 2 2024), Date 29 2 2024, NOTHING, Date 1 1 2025) EQUALS Date 28 2 2026
-- T-05
#ASSERT NOT `the action is in time` (`Claim dates` OF JUST (Date 29 2 2024), Date 29 2 2024, NOTHING, Date 1 3 2026)
-- T-06
#ASSERT `the last day to bring an action, dates` (`Claim dates` OF JUST (Date 28 2 2026), Date 28 2 2026, NOTHING, Date 1 1 2027) EQUALS Date 28 2 2028
-- T-07
#ASSERT `the last day to bring an action, dates` (`Claim dates` OF JUST (Date 29 2 2028), Date 29 2 2028, NOTHING, Date 1 1 2029) EQUALS Date 28 2 2030
-- T-08
#ASSERT `the last day to bring an action, dates` (`Claim dates` OF JUST (Date 31 12 2025), Date 31 12 2025, NOTHING, Date 1 1 2026) EQUALS Date 31 12 2027
-- T-09 not arrived, ought later than stopped
#ASSERT `the last day to bring an action, dates` (`Claim dates` OF NOTHING, Date 5 6 2025, JUST (Date 3 6 2025), Date 1 1 2026) EQUALS Date 5 6 2027
-- T-10 not arrived, stopped later than ought
#ASSERT `the last day to bring an action, dates` (`Claim dates` OF NOTHING, Date 5 6 2025, JUST (Date 20 7 2025), Date 1 1 2026) EQUALS Date 20 7 2027
-- T-11 not arrived, both 29 February 2024
#ASSERT `the last day to bring an action, dates` (`Claim dates` OF NOTHING, Date 29 2 2024, JUST (Date 29 2 2024), Date 1 1 2025) EQUALS Date 28 2 2026
-- T-12 filed after 2 years without leave
#ASSERT NOT `the action is in time` (`Claim dates` OF JUST (Date 10 3 2024), Date 10 3 2024, NOTHING, Date 1 6 2027)
-- T-13 arrived after expected date: arrival governs
#ASSERT `the last day to bring an action, dates` (`Claim dates` OF JUST (Date 1 1 2024), Date 29 12 2023, NOTHING, Date 1 6 2025) EQUALS Date 1 1 2026
-- T-14
#ASSERT `the last day for contribution proceedings after judgment on` (Date 15 8 2025) EQUALS Date 15 8 2027
-- T-15
#ASSERT `the last day for contribution proceedings after judgment on` (Date 29 2 2024) EQUALS Date 28 2 2026
-- T-16 filed 16 August 2027: out of time
#ASSERT (Date 16 8 2027) GREATER THAN `the last day for contribution proceedings after judgment on` (Date 15 8 2025)
-- T-17 filed 15 August 2027: in time
#ASSERT (Date 15 8 2027) AT MOST `the last day for contribution proceedings after judgment on` (Date 15 8 2025)

-- Top-level goal
-- G-01 applies
#ASSERT (`the delay position for` (Carriage OF TRUE, TRUE, FALSE, FALSE, FALSE, TRUE) `, carrier` (`Carrier facts` OF `the contracting carrier`, TRUE, FALSE) `, claim` (`Delay claim` OF `another cause`, FALSE, 500, 200, NOTHING, FALSE, NOTHING) `, dates` (`Claim dates` OF JUST (Date 10 3 2024), Date 10 3 2024, NOTHING, Date 1 6 2025))'s `the domestic subpart applies`
-- G-01 answerable
#ASSERT (`the delay position for` (Carriage OF TRUE, TRUE, FALSE, FALSE, FALSE, TRUE) `, carrier` (`Carrier facts` OF `the contracting carrier`, TRUE, FALSE) `, claim` (`Delay claim` OF `another cause`, FALSE, 500, 200, NOTHING, FALSE, NOTHING) `, dates` (`Claim dates` OF JUST (Date 10 3 2024), Date 10 3 2024, NOTHING, Date 1 6 2025))'s `this carrier is answerable`
-- G-01 max 500
#ASSERT (`the delay position for` (Carriage OF TRUE, TRUE, FALSE, FALSE, FALSE, TRUE) `, carrier` (`Carrier facts` OF `the contracting carrier`, TRUE, FALSE) `, claim` (`Delay claim` OF `another cause`, FALSE, 500, 200, NOTHING, FALSE, NOTHING) `, dates` (`Claim dates` OF JUST (Date 10 3 2024), Date 10 3 2024, NOTHING, Date 1 6 2025))'s `most payable` EQUALS 500
-- G-01 last day
#ASSERT (`the delay position for` (Carriage OF TRUE, TRUE, FALSE, FALSE, FALSE, TRUE) `, carrier` (`Carrier facts` OF `the contracting carrier`, TRUE, FALSE) `, claim` (`Delay claim` OF `another cause`, FALSE, 500, 200, NOTHING, FALSE, NOTHING) `, dates` (`Claim dates` OF JUST (Date 10 3 2024), Date 10 3 2024, NOTHING, Date 1 6 2025))'s `last day to bring an action` EQUALS Date 10 3 2026
-- G-02 damage 5000: max 2000
#ASSERT (`the delay position for` (Carriage OF TRUE, TRUE, FALSE, FALSE, FALSE, TRUE) `, carrier` (`Carrier facts` OF `the contracting carrier`, TRUE, FALSE) `, claim` (`Delay claim` OF `another cause`, FALSE, 5000, 200, NOTHING, FALSE, NOTHING) `, dates` (`Claim dates` OF JUST (Date 10 3 2024), Date 10 3 2024, NOTHING, Date 1 6 2025))'s `most payable` EQUALS 2000
-- G-03 NZ to Fiji: does not apply
#ASSERT NOT (`the delay position for` (Carriage OF TRUE, FALSE, FALSE, FALSE, FALSE, TRUE) `, carrier` (`Carrier facts` OF `the contracting carrier`, TRUE, FALSE) `, claim` (`Delay claim` OF `another cause`, FALSE, 500, 200, NOTHING, FALSE, NOTHING) `, dates` (`Claim dates` OF JUST (Date 10 3 2024), Date 10 3 2024, NOTHING, Date 1 6 2025))'s `the domestic subpart applies`
-- G-03 / A-21 / L-12 nothing payable under this subpart
#ASSERT (`the delay position for` (Carriage OF TRUE, FALSE, FALSE, FALSE, FALSE, TRUE) `, carrier` (`Carrier facts` OF `the actual carrier`, TRUE, FALSE) `, claim` (`Delay claim` OF `another cause`, FALSE, 500, 200, NOTHING, FALSE, NOTHING) `, dates` (`Claim dates` OF JUST (Date 10 3 2024), Date 10 3 2024, NOTHING, Date 1 6 2025))'s `most payable` EQUALS 0
-- G-04 weather: max 0
#ASSERT (`the delay position for` (Carriage OF TRUE, TRUE, FALSE, FALSE, FALSE, TRUE) `, carrier` (`Carrier facts` OF `the contracting carrier`, TRUE, FALSE) `, claim` (`Delay claim` OF `meteorological conditions`, FALSE, 500, 200, NOTHING, FALSE, NOTHING) `, dates` (`Claim dates` OF JUST (Date 10 3 2024), Date 10 3 2024, NOTHING, Date 1 6 2025))'s `most payable` EQUALS 0
-- G-05 successive carrier B, reckless: answerable, max 5000
#ASSERT (`the delay position for` (Carriage OF TRUE, TRUE, FALSE, FALSE, FALSE, TRUE) `, carrier` (`Carrier facts` OF `a successive carrier`, TRUE, FALSE) `, claim` (`Delay claim` OF `another cause`, FALSE, 5000, 200, NOTHING, TRUE, NOTHING) `, dates` (`Claim dates` OF JUST (Date 10 3 2024), Date 10 3 2024, NOTHING, Date 1 6 2025))'s `most payable` EQUALS 5000
-- G-05 successive carrier A (not the delayed stage): not answerable
#ASSERT NOT (`the delay position for` (Carriage OF TRUE, TRUE, FALSE, FALSE, FALSE, TRUE) `, carrier` (`Carrier facts` OF `a successive carrier`, FALSE, FALSE) `, claim` (`Delay claim` OF `another cause`, FALSE, 5000, 200, NOTHING, TRUE, NOTHING) `, dates` (`Claim dates` OF JUST (Date 10 3 2024), Date 10 3 2024, NOTHING, Date 1 6 2025))'s `this carrier is answerable`
