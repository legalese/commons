IMPORT prelude
IMPORT daydate

-- Civil Aviation Act 2023 (New Zealand), domestic carriage — THE NOUNS.
--
-- Every fact the rule modules read, and nothing else: no rules, no #EVAL.
-- Source: ../registers/source-bundle/act_public_2023_10.txt (New Zealand
-- Legislation, version as at 23 September 2026, converted from the PCO XML).
-- Field names are unique across records.

§ `Civil Aviation Act 2023, domestic carriage — the nouns`

DECLARE Carriage HAS
    -- s 270(1), according to the contract.
    `departure in New Zealand`                          IS A BOOLEAN
    `destination in New Zealand`                        IS A BOOLEAN
    `an agreed stopping place outside New Zealand`      IS A BOOLEAN
    -- s 272.
    `a single flight returning to its departure point`  IS A BOOLEAN
    `excluded by regulations`                           IS A BOOLEAN
    -- s 271: the delay was in the part carried by air.
    `the delay was in the carriage by air`              IS A BOOLEAN

-- s 274(2).
DECLARE `Cause of delay` IS ONE OF
    `meteorological conditions`
    `air traffic control instructions, advice or information`
    `orders or directions of a lawful authority`
    `force majeure`
    `saving or attempting to save life`
    `another cause`

DECLARE `Delay claim` HAS
    `cause of delay`                                    IS A `Cause of delay`
    -- s 276.
    `all necessary measures taken or impossible`        IS A BOOLEAN
    `damage proved`                                     IS A NUMBER
    `sum paid for the carriage`                         IS A NUMBER
    -- s 277(2): a special contract raising the limit, if any.
    `limit raised by special contract to`               IS A MAYBE NUMBER
    -- s 279.
    `damage intended or caused recklessly`              IS A BOOLEAN
    -- s 278: a term limiting liability, and any term more advantageous to
    -- the passenger.
    `contract term limiting liability to`               IS A MAYBE NUMBER

DECLARE `Claim dates` HAS
    `arrived at the destination on`                     IS A MAYBE DATE
    `ought to have arrived on`                          IS A DATE
    `carriage stopped on`                               IS A MAYBE DATE
    `action brought on`                                 IS A DATE

-- ss 273, 275: the carriers.
DECLARE Carrier IS ONE OF
    `the contracting carrier`
    `the actual carrier`
    `a successive carrier`

DECLARE `Carrier facts` HAS
    `carrier`                                           IS A Carrier
    -- s 273(a)(ii): the actual carrier performed the stage with the delay.
    `performed the carriage where the delay occurred`   IS A BOOLEAN
    -- s 275: the carriage is performed by successive carriers (added after the
    -- independent pass).
    `carriage by successive carriers`                   IS A BOOLEAN
