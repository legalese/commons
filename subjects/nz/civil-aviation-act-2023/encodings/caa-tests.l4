IMPORT prelude
IMPORT daydate
IMPORT `caa-types`
IMPORT `caa-liability`
IMPORT `caa-goal`

-- Civil Aviation Act 2023, domestic carriage — THE ENCODER'S TESTS.
--
-- Expected values are worked by hand from the Act's text.

§ `Tests`

domestic MEANS Carriage OF TRUE, TRUE, FALSE, FALSE, FALSE, TRUE

#ASSERT `the domestic carriage subpart applies to` domestic
#ASSERT NOT `the domestic carriage subpart applies to` (Carriage OF TRUE, FALSE, FALSE, FALSE, FALSE, TRUE)
#ASSERT NOT `the domestic carriage subpart applies to` (Carriage OF TRUE, TRUE, TRUE, FALSE, FALSE, TRUE)
#ASSERT NOT `the domestic carriage subpart applies to` (Carriage OF TRUE, TRUE, FALSE, TRUE, FALSE, TRUE)
#ASSERT NOT `the domestic carriage subpart applies to` (Carriage OF TRUE, TRUE, FALSE, FALSE, TRUE, TRUE)
#ASSERT NOT `the domestic carriage subpart applies to` (Carriage OF TRUE, TRUE, FALSE, FALSE, FALSE, FALSE)

#ASSERT `the carrier is answerable for the delay` (`Carrier facts` OF `the contracting carrier`, FALSE, FALSE)
#ASSERT `the carrier is answerable for the delay` (`Carrier facts` OF `the actual carrier`, TRUE, FALSE)
#ASSERT NOT `the carrier is answerable for the delay` (`Carrier facts` OF `the actual carrier`, FALSE, FALSE)
#ASSERT NOT `the carrier is answerable for the delay` (`Carrier facts` OF `a successive carrier`, FALSE, FALSE)
-- s 275 (added after the independent pass): in successive carriage, the
-- contracting carrier answers only for the delayed stage.
#ASSERT NOT `the carrier is answerable for the delay` (`Carrier facts` OF `the contracting carrier`, FALSE, TRUE)
#ASSERT `the carrier is answerable for the delay` (`Carrier facts` OF `the contracting carrier`, TRUE, TRUE)

GIVEN cause IS A `Cause of delay`, measures IS A BOOLEAN, damage IS A NUMBER, raised IS A MAYBE NUMBER, reckless IS A BOOLEAN
GIVETH A `Delay claim`
claim cause measures damage raised reckless MEANS `Delay claim` OF cause, measures, damage, 150, raised, reckless, JUST 50

#ASSERT `the most the carrier must pay for the delay` (claim `another cause` FALSE 900 NOTHING FALSE) EQUALS 900
#ASSERT `the most the carrier must pay for the delay` (claim `another cause` FALSE 2000 NOTHING FALSE) EQUALS 1500
#ASSERT `the most the carrier must pay for the delay` (claim `another cause` FALSE 2000 (JUST 1800) FALSE) EQUALS 1800
#ASSERT `the most the carrier must pay for the delay` (claim `another cause` FALSE 2000 (JUST 1000) FALSE) EQUALS 1500
#ASSERT `the most the carrier must pay for the delay` (claim `another cause` FALSE 5000 NOTHING TRUE) EQUALS 5000
#ASSERT `the most the carrier must pay for the delay` (claim `meteorological conditions` FALSE 900 NOTHING FALSE) EQUALS 0
#ASSERT `the most the carrier must pay for the delay` (claim `force majeure` FALSE 900 NOTHING TRUE) EQUALS 0
#ASSERT `the most the carrier must pay for the delay` (claim `another cause` TRUE 900 NOTHING FALSE) EQUALS 0
-- s 278: the contract's $50 limit has no effect.
#ASSERT `the most the carrier must pay for the delay` (claim `another cause` FALSE 300 NOTHING FALSE) EQUALS 300

GIVEN arrived IS A MAYBE DATE, stopped IS A MAYBE DATE, brought IS A DATE
GIVETH A `Claim dates`
dates arrived stopped brought MEANS `Claim dates` OF arrived, Date 1 3 2026, stopped, brought

#ASSERT `the last day to bring an action, dates` (dates (JUST (Date 2 3 2026)) NOTHING (Date 1 1 2027)) EQUALS Date 2 3 2028
#ASSERT `the last day to bring an action, dates` (dates NOTHING NOTHING (Date 1 1 2027)) EQUALS Date 1 3 2028
-- Changed 2026-10-17 (Legislation Act s 55, applied at the user's direction): the deadline falls on a non-working day, so it runs to 6/3/2028: 5 March 2028 is a Sunday.
#ASSERT `the last day to bring an action, dates` (dates NOTHING (JUST (Date 5 3 2026)) (Date 1 1 2027)) EQUALS Date 6 3 2028
#ASSERT `the last day to bring an action, dates` (dates NOTHING (JUST (Date 28 2 2026)) (Date 1 1 2027)) EQUALS Date 1 3 2028
#ASSERT `the action is in time` (dates (JUST (Date 2 3 2026)) NOTHING (Date 2 3 2028))
#ASSERT NOT `the action is in time` (dates (JUST (Date 2 3 2026)) NOTHING (Date 3 3 2028))
#ASSERT `the last day for contribution proceedings after judgment on` (Date 16 10 2026) EQUALS Date 16 10 2028

#ASSERT `the delay position for` domestic `, carrier` (`Carrier facts` OF `the contracting carrier`, FALSE, FALSE) `, claim` (claim `another cause` FALSE 2000 NOTHING FALSE) `, dates` (dates (JUST (Date 2 3 2026)) NOTHING (Date 1 1 2027)) EQUALS `Delay position` OF TRUE, TRUE, 1500, Date 2 3 2028, TRUE
#ASSERT `the delay position for` (Carriage OF TRUE, TRUE, TRUE, FALSE, FALSE, TRUE) `, carrier` (`Carrier facts` OF `the contracting carrier`, FALSE, FALSE) `, claim` (claim `another cause` FALSE 2000 NOTHING FALSE) `, dates` (dates (JUST (Date 2 3 2026)) NOTHING (Date 1 1 2027)) EQUALS `Delay position` OF FALSE, TRUE, 0, Date 2 3 2028, TRUE

§§ `Legislation Act 2019 s 55 (added 2026-10-17)`

-- 2 years after arrival on 31 December 2025 end in the holiday period; 1
-- January 2028 is a Saturday, so Monday 3 and Tuesday 4 January are out too:
-- Wednesday 5 January 2028.
#ASSERT `the last day to bring an action, dates` (dates (JUST (Date 31 12 2025)) NOTHING (Date 1 1 2027)) EQUALS Date 5 1 2028
-- 2 years after a judgment on Saturday 14 August 2027 end on Tuesday 14 August
-- 2029: unchanged.
#ASSERT `the last day for contribution proceedings after judgment on` (Date 14 8 2027) EQUALS Date 14 8 2029
