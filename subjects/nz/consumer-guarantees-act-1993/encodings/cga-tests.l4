-- s 27
#ASSERT `the remedies against the manufacturer for` (`goods failure` `s 6 acceptable quality` TRUE FALSE FALSE TRUE TRUE) EQUALS LIST `damages from the manufacturer for the reduction in value`, `damages from the manufacturer for reasonably foreseeable consequential loss`
-- s 27(2): an express guarantee to repair or replace, not yet asked: no value damages yet
#ASSERT `the remedies against the manufacturer for` (`Goods failure` OF `s 13 a manufacturer's express guarantee`, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, TRUE, FALSE, TRUE, FALSE, FALSE, 1000, 900, 400) EQUALS EMPTY
#ASSERT `the remedies against the manufacturer for` (`Goods failure` OF `s 13 a manufacturer's express guarantee`, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, TRUE, FALSE, TRUE, TRUE, FALSE, 1000, 900, 400) EQUALS LIST `damages from the manufacturer for the reduction in value`
#ASSERT `the remedies against the manufacturer for` (`goods failure` `s 5 title` TRUE FALSE FALSE TRUE TRUE) EQUALS EMPTY
-- s 27(1)(a): lower of 1000 and 900, less 400 = 500
#ASSERT `the manufacturer's damages for the reduction in value of` (`goods failure` `s 6 acceptable quality` TRUE FALSE FALSE TRUE FALSE) EQUALS 500
#ASSERT `the manufacturer's damages for the reduction in value of` (`Goods failure` OF `s 6 acceptable quality`, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, 800, 900, 400) EQUALS 400

§§ `Goal 4 — services`

#ASSERT `the supplier is answerable for the service failure` (`service failure` `s 28 reasonable care and skill` TRUE FALSE FALSE FALSE TRUE FALSE) EQUALS TRUE
#ASSERT `the supplier is answerable for the service failure` (`Service failure` OF `s 29 fitness for a particular purpose`, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, TRUE, FALSE, 2000, 500) EQUALS FALSE
#ASSERT `the supplier is answerable for the service failure` (`Service failure` OF `s 30 time of completion`, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, TRUE, FALSE, 2000, 500) EQUALS FALSE
#ASSERT `the supplier is answerable for the service failure` (`Service failure` OF `s 28 reasonable care and skill`, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, TRUE, FALSE, 2000, 500) EQUALS TRUE

-- s 36
#ASSERT `the service failure is of a substantial character` (`service failure` `s 28 reasonable care and skill` TRUE FALSE TRUE FALSE TRUE FALSE) EQUALS TRUE
-- s 36(c) where s 29 is engaged, whichever guarantee failed (changed after the independent pass)
#ASSERT `the service failure is of a substantial character` (`Service failure` OF `s 28 reasonable care and skill`, TRUE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, TRUE, FALSE, 2000, 500) EQUALS TRUE
#ASSERT `the service failure is of a substantial character` (`Service failure` OF `s 29 fitness for a particular purpose`, TRUE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, TRUE, FALSE, 2000, 500) EQUALS TRUE
#ASSERT `the service failure is of a substantial character` (`Service failure` OF `s 28 reasonable care and skill`, TRUE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, 2000, 500) EQUALS TRUE

-- s 32
#ASSERT `the remedies against the supplier for the service failure` (`service failure` `s 28 reasonable care and skill` TRUE FALSE FALSE FALSE TRUE FALSE) EQUALS LIST `require`
#ASSERT `the remedies against the supplier for the service failure` (`service failure` `s 28 reasonable care and skill` TRUE TRUE FALSE FALSE TRUE FALSE) EQUALS LIST `require`, `elsewhere`, `cancel`
-- s 35: incidental to goods the consumer may reject
#ASSERT `the remedies against the supplier for the service failure` (`service failure` `s 28 reasonable care and skill` TRUE TRUE FALSE TRUE TRUE FALSE) EQUALS LIST `require`, `elsewhere`
#ASSERT `the remedies against the supplier for the service failure` (`service failure` `s 28 reasonable care and skill` FALSE FALSE FALSE FALSE TRUE TRUE) EQUALS LIST `cancel`, `value damages`, `loss damages`
#ASSERT `the remedies against the supplier for the service failure` (`service failure` `s 28 reasonable care and skill` FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS LIST `value damages`
#ASSERT `the remedies against the supplier for the service failure` (`service failure` `s 28 reasonable care and skill` TRUE FALSE TRUE FALSE TRUE FALSE) EQUALS LIST `require`, `cancel`, `value damages`
#ASSERT `the remedies against the supplier for the service failure` (`service failure` `s 31 price` TRUE TRUE TRUE FALSE TRUE TRUE) EQUALS LIST `refuse to pay more than a reasonable price`
#ASSERT `the remedies against the supplier for the service failure` (`Service failure` OF `s 30 time of completion`, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, TRUE, TRUE, 2000, 500) EQUALS EMPTY

#ASSERT `the damages for the reduction in value of the product of` (`service failure` `s 28 reasonable care and skill` FALSE FALSE FALSE FALSE TRUE FALSE) EQUALS 1500
#ASSERT `the refund on cancelling, paid` 2000 `, ordered retained` 500 EQUALS 1500
#ASSERT `the refund on cancelling, paid` 2000 `, ordered retained` 0 EQUALS 2000
-- s 37
#ASSERT `the day the cancellation takes effect, made known` (JUST (Date 5 3 2025)) `, intention indicated` (Date 3 3 2025) `, practicable to tell the supplier:` TRUE EQUALS Date 5 3 2025
#ASSERT `the day the cancellation takes effect, made known` NOTHING `, intention indicated` (Date 3 3 2025) `, practicable to tell the supplier:` FALSE EQUALS Date 3 3 2025
#ASSERT REFUSED (`the day the cancellation takes effect, made known` NOTHING `, intention indicated` (Date 3 3 2025) `, practicable to tell the supplier:` TRUE)

§§ `The top-level goal`

#ASSERT (`the consumer guarantees position for` (`Consumer case` OF `a consumer`, `a supply in trade of` `goods`, `a failure of goods` (`goods failure` `s 6 acceptable quality` FALSE FALSE FALSE TRUE FALSE)))'s `remedies against the supplier` EQUALS LIST `reject`, `value damages`
#ASSERT (`the consumer guarantees position for` (`Consumer case` OF `a consumer`, `a supply in trade of` `goods`, `a failure of goods` (`goods failure` `s 6 acceptable quality` FALSE FALSE FALSE TRUE FALSE)))'s `damages for the reduction in value, from the supplier` EQUALS 600
#ASSERT (`the consumer guarantees position for` (`Consumer case` OF `a consumer`, `a supply in trade of` `goods`, `a failure of goods` (`goods failure` `s 6 acceptable quality` FALSE FALSE FALSE TRUE FALSE)))'s `damages for the reduction in value, from the manufacturer` EQUALS 500
#ASSERT (`the consumer guarantees position for` (`Consumer case` OF `a consumer`, `a supply in trade of` `goods`, `a failure of goods` (`goods failure` `s 6 acceptable quality` TRUE FALSE FALSE TRUE FALSE)))'s `damages for the reduction in value, from the supplier` EQUALS 0
#ASSERT (`the consumer guarantees position for` (`Consumer case` OF (Acquirer OF TRUE, TRUE, FALSE, FALSE), `a supply in trade of` `goods`, `a failure of goods` (`goods failure` `s 6 acceptable quality` FALSE FALSE FALSE TRUE FALSE)))'s `the Act gives redress` EQUALS FALSE
#ASSERT (`the consumer guarantees position for` (`Consumer case` OF (Acquirer OF TRUE, TRUE, FALSE, FALSE), `a supply in trade of` `goods`, `a failure of goods` (`goods failure` `s 6 acceptable quality` FALSE FALSE FALSE TRUE FALSE)))'s `remedies against the supplier` EQUALS EMPTY
#ASSERT (`the consumer guarantees position for` (`Consumer case` OF `a consumer`, `a supply in trade of` `services`, `a failure of a service` (`service failure` `s 28 reasonable care and skill` FALSE FALSE FALSE FALSE TRUE FALSE)))'s `remedies against the supplier` EQUALS LIST `cancel`, `value damages`
#ASSERT (`the consumer guarantees position for` (`Consumer case` OF `a consumer`, `a supply in trade of` `services`, `a failure of a service` (`service failure` `s 28 reasonable care and skill` FALSE FALSE FALSE FALSE TRUE FALSE)))'s `damages for the reduction in value, from the supplier` EQUALS 1500
-- goods supplied with a service (ss 15, 34); a guarantee that does not fit gives no remedies (changed after the independent pass)
#ASSERT (`the consumer guarantees position for` (`Consumer case` OF `a consumer`, `a supply in trade of` `services`, `a failure of goods` (`goods failure` `s 6 acceptable quality` FALSE FALSE FALSE TRUE FALSE)))'s `remedies against the supplier` EQUALS LIST `reject`, `value damages`
#ASSERT (`the consumer guarantees position for` (`Consumer case` OF `a consumer`, `a supply in trade of` `gas or electricity supplied by a gas or electricity retailer`, `a failure of goods` (`goods failure` `s 6 acceptable quality` FALSE FALSE FALSE TRUE FALSE)))'s `remedies against the supplier` EQUALS EMPTY
-- a repairer in trade acquiring a household service is a consumer (s 2 (b)(iii) is for goods)
#ASSERT `is a consumer of` (Acquirer OF TRUE, FALSE, FALSE, TRUE) `services` EQUALS TRUE
#ASSERT `is a consumer of` (Acquirer OF TRUE, FALSE, FALSE, TRUE) `goods` EQUALS FALSE
-- a remedy open under both s 32(a) and (b) is listed once; no cancellation without a contract
#ASSERT `the remedies against the supplier for the service failure` (`service failure` `s 28 reasonable care and skill` TRUE TRUE TRUE FALSE TRUE FALSE) EQUALS LIST `require`, `elsewhere`, `cancel`, `value damages`
#ASSERT `the remedies against the supplier for the service failure` (`service failure` `s 28 reasonable care and skill` TRUE TRUE FALSE FALSE FALSE FALSE) EQUALS LIST `require`, `elsewhere`
#ASSERT `the remedies against the supplier for` (`goods failure` `s 6 acceptable quality` TRUE TRUE TRUE TRUE FALSE) EQUALS LIST `require`, `elsewhere`, `reject`, `value damages`
#ASSERT (`the consumer guarantees position for` (`Consumer case` OF `a consumer`, `a supply in trade of` `gas or electricity supplied by a gas or electricity retailer`, `a failure of goods` (`goods failure` `s 7A acceptable quality of gas or electricity` TRUE FALSE FALSE TRUE FALSE)))'s `remedies against the supplier` EQUALS LIST `require`
#ASSERT (`the consumer guarantees position for` (`Consumer case` OF `a consumer`, `a supply in trade of` `gas or electricity supplied by a gas or electricity retailer`, `a failure of goods` (`goods failure` `s 7A acceptable quality of gas or electricity` TRUE FALSE FALSE TRUE FALSE)))'s `remedies against the manufacturer` EQUALS EMPTY
