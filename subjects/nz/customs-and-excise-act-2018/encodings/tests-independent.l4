-- F3
#ASSERT `refund` (Date 15 5 2026) (JUST (Date 15 5 2030)) (Date 2 6 2031) TRUE FALSE
-- F4
#ASSERT NOT `refund` (Date 15 5 2026) (JUST (Date 16 5 2030)) (Date 2 6 2031) TRUE FALSE
-- F5
#ASSERT NOT `refund` (Date 15 5 2026) NOTHING (Date 1 8 2027) TRUE TRUE
-- F6
#ASSERT NOT `refund` (Date 15 5 2026) NOTHING (Date 1 8 2027) FALSE FALSE
-- F7 / F10
#ASSERT `refund` (Date 15 5 2026) NOTHING (Date 1 8 2027) TRUE FALSE
