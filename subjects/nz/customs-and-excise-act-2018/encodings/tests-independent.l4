-- T4
#ASSERT `the transaction value of` (`adjusted` 10000 (LIST 200) EMPTY) EQUALS 10200
-- T5
#ASSERT `the transaction value of` (`adjusted` 10000 (LIST 1000) EMPTY) EQUALS 11000
-- T6
#ASSERT `the transaction value of` (`adjusted` 10000 (LIST 400) EMPTY) EQUALS 10400
-- T8
#ASSERT `the transaction value of` (`adjusted` 10000 (LIST 250) EMPTY) EQUALS 10250
-- T9
#ASSERT `the transaction value of` (`adjusted` 10000 (LIST 150) EMPTY) EQUALS 10150
-- T10
#ASSERT `the transaction value of` (`adjusted` 10000 (LIST 600) EMPTY) EQUALS 10600
-- T12
#ASSERT `the transaction value of` (`adjusted` 12000 EMPTY (LIST 1500)) EQUALS 10500
-- T13
#ASSERT `the transaction value of` (`adjusted` 12000 EMPTY (LIST 800)) EQUALS 11200
-- T15
#ASSERT `the transaction value of` (`adjusted` 12000 EMPTY (LIST 300)) EQUALS 11700
-- T16
#ASSERT `the transaction value of` (`adjusted` 12000 EMPTY (LIST 900)) EQUALS 11100
-- T17
#ASSERT `the transaction value of` (`Transaction facts` OF 5000, FALSE, FALSE, FALSE, `nobody`, TRUE, EMPTY, FALSE, EMPTY, 4000, TRUE, 0, FALSE, FALSE, EMPTY, EMPTY) EQUALS 1000
-- T18 / T19
#ASSERT `the transaction value of` (`Transaction facts` OF 5000, FALSE, FALSE, FALSE, `nobody`, TRUE, EMPTY, FALSE, EMPTY, 4000, FALSE, 0, FALSE, FALSE, EMPTY, EMPTY) EQUALS 5000
-- T20
#ASSERT `the transaction value of` (`adjusted` 10000 (LIST 500, 200, 400) (LIST 1000)) EQUALS 10100
-- T21
#ASSERT `the transaction value of` (`Transaction facts` OF 10700, FALSE, FALSE, FALSE, `nobody`, TRUE, EMPTY, FALSE, EMPTY, 0, FALSE, 700, TRUE, FALSE, EMPTY, EMPTY) EQUALS 10000
-- T22 / T23 / T24
#ASSERT `the transaction value of` (`Transaction facts` OF 10700, FALSE, FALSE, FALSE, `nobody`, TRUE, EMPTY, FALSE, EMPTY, 0, FALSE, 700, FALSE, FALSE, EMPTY, EMPTY) EQUALS 10700
-- T25 (required addition lacks sufficient information: fall to method 2)
#ASSERT `the Customs value of` (`Transaction facts` OF 10000, FALSE, FALSE, FALSE, `nobody`, TRUE, EMPTY, TRUE, EMPTY, 0, FALSE, 0, FALSE, FALSE, (LIST 9800), EMPTY) EQUALS 9800

-- ===== Goal 1: methods 1-3 =====
-- M1
#ASSERT `the Customs value of` (`plain` 10000) EQUALS 10000
-- M2
#ASSERT `the Customs value of` (`failing` (LIST 9800, 9500, 10200) EMPTY) EQUALS 9500
-- M3
#ASSERT `the Customs value of` (`failing` (LIST 10000) EMPTY) EQUALS 10000
-- M4 (adjusted values 10,300 and 9,900)
#ASSERT `the Customs value of` (`failing` (LIST 10300, 9900) EMPTY) EQUALS 9900
-- M5
#ASSERT `the Customs value of` (`failing` EMPTY (LIST 9000, 8700)) EQUALS 8700
-- M6
#ASSERT `the Customs value of` (`failing` (LIST 11000) (LIST 8000)) EQUALS 11000
-- M12 (doubt about declared value)
#ASSERT `the Customs value of` (`Transaction facts` OF 10000, FALSE, FALSE, FALSE, `nobody`, TRUE, EMPTY, FALSE, EMPTY, 0, FALSE, 0, FALSE, TRUE, (LIST 9700), EMPTY) EQUALS 9700
-- M7 is a REFUSE: checked by #EVAL only, not asserted (see expectations).

