-- ===== Goal 3: penalties =====
-- L1
#ASSERT `pen113` (LIST (Payment OF (Date 30 11 2026), 10000)) EQUALS 0
-- L2
#ASSERT `pen113` EMPTY EQUALS 500
-- L3
#ASSERT `pen113` (LIST (Payment OF (Date 1 12 2026), 10000)) EQUALS 100
-- L4
#ASSERT `pen113` (LIST (Payment OF (Date 7 12 2026), 10000)) EQUALS 100
-- L5
#ASSERT `pen113` (LIST (Payment OF (Date 8 12 2026), 10000)) EQUALS 500
-- L6
#ASSERT `pen113` (LIST (Payment OF (Date 30 11 2026), 6000), (Payment OF (Date 3 12 2026), 4000)) EQUALS 40
-- L7
#ASSERT `pen113` (LIST (Payment OF (Date 30 11 2026), 6000)) EQUALS 200
-- L8
#ASSERT `pen113` (LIST (Payment OF (Date 5 12 2026), 7000)) EQUALS 220
-- L9
#ASSERT `pen113` (LIST (Payment OF (Date 30 11 2026), 2000), (Payment OF (Date 7 12 2026), 5000)) EQUALS 200
-- L10
#ASSERT `pen` `s 122 on entry or other event` (Date 2 11 2026) NOTHING 10000 EMPTY EQUALS 0
