IMPORT prelude
IMPORT daydate

-- Customs and Excise Act 2018 (New Zealand) — THE NOUNS.
--
-- Every fact the rule modules read, and nothing else: no rules, no #EVAL.
-- Source: ../registers/source-bundle/act_public_2018_4.txt (New Zealand
-- Legislation, version as at 4 September 2026, converted from the PCO XML).
-- Field names are unique across records.

§ `Customs and Excise Act 2018 — the nouns`

§§ `Related persons (Schedule 4 cl 2(2))`

DECLARE `Buyer and seller` HAS
    `officers or directors of one another's business`   IS A BOOLEAN
    `legally recognised partners in business`           IS A BOOLEAN
    `employer and employee`                             IS A BOOLEAN
    -- cl 2(2)(a)(iv): the largest share of the voting stock of both that any
    -- one person owns, controls or holds, as a percentage.
    `largest share of both held by one person, in percent` IS A NUMBER
    `one controls the other`                            IS A BOOLEAN
    `both controlled by a third person`                 IS A BOOLEAN
    `together they control a third person`              IS A BOOLEAN
    -- cl 2(2)(b): blood relationship within the 4th degree, marriage, civil
    -- union or de facto relationship, and adoption.
    `members of the same family`                        IS A BOOLEAN

§§ `The transaction value (Schedule 4 cls 3-7)`

DECLARE `Transaction facts` HAS
    `price paid or payable`                             IS A NUMBER
    -- cl 5(a)-(c).
    `restrictions on disposition or use other than permitted ones` IS A BOOLEAN
    `sale or price subject to a condition that cannot be valued` IS A BOOLEAN
    `resale proceeds to the seller neither included nor adjustable` IS A BOOLEAN
    `buyer and seller`                                  IS A `Buyer and seller`
    -- cl 5(d), cl 6: if related, whether the importer has complied with
    -- clause 6 (or was not required to).
    `clause 6 complied with or not required`            IS A BOOLEAN
    -- cl 7(b): each amount not already in the price, with sufficient
    -- information: commissions and brokerage, packing, buyer's assists,
    -- royalties and licence fees, resale proceeds to the seller, repair or
    -- refurbishment, and transport and insurance to export.
    `additions under clause 7(b)`                       IS A LIST OF NUMBER
    -- cl 7(b) amounts that are required but lack sufficient information.
    `a required addition lacks sufficient information`  IS A BOOLEAN
    -- cl 7(c): amounts in the price for transport after export, assembly or
    -- maintenance after import, transport in New Zealand, and New Zealand
    -- duties and taxes.
    `deductions under clause 7(c)`                      IS A LIST OF NUMBER
    -- cl 7(d): data or instructions on carrier media.
    `value of data or instructions on carrier media`    IS A NUMBER
    `data distinguished and not in data processing equipment` IS A BOOLEAN
    -- cl 3: interest under a financing arrangement included in the price.
    `interest included in the price`                    IS A NUMBER
    `interest meets clause 3`                           IS A BOOLEAN
    -- cl 4(2)(c): the chief executive doubts the declared value.
    `the chief executive doubts the declared value`     IS A BOOLEAN
    -- cls 9-12: the transaction values, as adjusted, of identical and of
    -- similar goods that meet those clauses.
    `transaction values of identical goods`             IS A LIST OF NUMBER
    `transaction values of similar goods`               IS A LIST OF NUMBER

§§ `Duty and payment (ss 120-124, 159-160)`

-- s 124: the events that start a 20-working-day period.
DECLARE `Payment occasion` IS ONE OF
    `s 122 on entry or other event`
    `s 124(2) an amended assessment under s 112`
    `s 124(3) an assessment under s 113`
    `s 124(4) an excise assessment under ss 114-116`
    `s 124(5) an amended assessment under s 117`
    `s 124(6) a demand under s 138(3) or s 139(4)`
    -- s 124(7): an earlier time set by notice; the occasion date is that
    -- time (added after the independent pass).
    `s 124(7) an earlier time required by notice`

DECLARE Payment HAS
    `paid on`                                           IS A DATE
    `amount paid`                                       IS A NUMBER

DECLARE `Duty facts` HAS
    `payment occasion`                                  IS A `Payment occasion`
    -- the day the s 122 event happened, or the s 124 assessment, notice or
    -- demand was given.
    `occasion date`                                     IS A DATE
    -- s 123: a deferred payment date under an authorisation, if any.
    `deferred payment date under s 123`                 IS A MAYBE DATE
    `payments made`                                     IS A LIST OF Payment

§§ `Refunds (ss 142, 143)`

DECLARE `Refund facts` HAS
    `refund Matariki days`                              IS A LIST OF DATE
    `duty paid on`                                      IS A DATE
    `refund applied for on`                             IS A MAYBE DATE
    `refund considered on`                              IS A DATE
    `duty paid in error, of law or of fact`             IS A BOOLEAN
    `good reason not to refund`                         IS A BOOLEAN
