IMPORT prelude
IMPORT daydate

-- Wages Protection Act 1983 (New Zealand) — THE NOUNS.
--
-- Every fact the rule modules read, and nothing else: no rules, no #EVAL.
-- Source: ../source/WPA1983.txt (New Zealand Legislation, version 25 as at
-- 27 November 2025, text extracted from the PCO PDF).

§ `Wages Protection Act 1983 — the nouns`

§§ `Overpayments (s 6)`

-- s 6(1) "recoverable period ... by virtue of that worker's having— (a) been
-- absent from work without that employer's authority; or (b) been on strike
-- ...; or (c) been locked out ...; or (d) been suspended".
DECLARE `Reason no wages were payable` IS ONE OF
    `(a) absent from work without the employer's authority`
    `(b) on strike`
    `(c) locked out`
    `(d) suspended`
    `none of these`

-- s 6(3)(c): which notice deadline applies to "any other overpayment".
DECLARE `Workplace of the worker` IS ONE OF
    `(i) no fixed workplace`
    `(ii) one fixed workplace, not attended during normal hours on the next pay day` HAS
        `first day attended during normal hours after the next pay day`  IS A DATE
    `(iii) 2 or more fixed workplaces, none attended during normal hours on the next pay day` HAS
        `first day attended during normal hours after the next pay day`  IS A DATE
    `(iv) any other case`

-- s 6(3)-(4): the notice of intention to recover.
DECLARE `Overpayment notice` HAS
    `given on`                                          IS A DATE
    `specifies the amount`                              IS A BOOLEAN
    `specifies the day of the overpayment and the actions that made it one`  IS A BOOLEAN
    `working days from the overpayment pay day to the notice`               IS A NUMBER
    `specifies the s 95C method used to calculate the deduction`            IS A BOOLEAN

DECLARE Overpayment HAS
    `amount`                                            IS A NUMBER
    `reason no wages were payable for the period`       IS A `Reason no wages were payable`
    `relates to a specified pay deduction (ERA s 82AA)` IS A BOOLEAN
    `not reasonably practicable to avoid, given the employer's usual payroll methods` IS A BOOLEAN
    `paid on`                                           IS A DATE
    `next pay day`                                      IS A DATE
    `workplace`                                         IS A `Workplace of the worker`
    `notice`                                            IS A MAYBE `Overpayment notice`
    `recovered on`                                      IS A DATE

§§ `Deductions (ss 4, 5, 5A, 6, 11, 15, 16)`

-- s 5(2), s 9(2): a written notice varying or withdrawing a consent or
-- request. "within 2 weeks of receiving that notice, if practicable; and ...
-- as soon as is practicable, in every other case".
DECLARE `Notice of withdrawal` HAS
    `received by the employer on`                       IS A DATE
    `practicable to act on within 2 weeks`              IS A BOOLEAN
    `earliest practicable day to act on it`             IS A DATE

-- What the employer relied on for the deduction.
DECLARE `Basis for the deduction` IS ONE OF
    -- s 5(1)(a), including "consent in a general deductions clause in the
    -- worker's employment agreement"
    `the worker's written consent` HAS
        `in a general deductions clause in the employment agreement`  IS A BOOLEAN
        `obtained by threat of dismissal or other duress`             IS A BOOLEAN
    -- s 5(1)(b)
    `the worker's written request` HAS
        `obtained by threat of dismissal or other duress`             IS A BOOLEAN
    -- s 6(2)
    `recovery of an overpayment under s 6` HAS
        `the overpayment`                                             IS AN Overpayment
    -- s 15 "this Act shall be read subject to the provisions of any other
    -- Act" (PAYE, child support, KiwiSaver ...)
    `required or authorised by another Act (s 15)`
    -- s 16 a collective agreement, or an order of the Employment Court or
    -- the Employment Relations Authority
    `a collective agreement or an order of the Court or Authority (s 16)`
    `no written consent or request`

DECLARE Deduction HAS
    `amount`                                            IS A NUMBER
    `made on`                                           IS A DATE
    `basis`                                             IS A `Basis for the deduction`
    `for a lawful purpose`                              IS A BOOLEAN
    `the worker was consulted before the deduction`     IS A BOOLEAN
    `unreasonable`                                      IS A BOOLEAN
    `notice of withdrawal`                              IS A MAYBE `Notice of withdrawal`

§§ `The manner of payment (ss 7-10, 17)`

-- s 7 money; s 8 specified cheque; ss 9-10 postal order, money order,
-- specified cheque, or lodgement at a financial institution.
DECLARE `Manner of payment` IS ONE OF
    `money`
    `a specified cheque (payable to, or to the order of, the worker)`
    `a postal order`
    `a money order`
    `lodgement at a financial institution` HAS
        `to an account in the worker's name, alone or jointly`        IS A BOOLEAN
    `some other manner`

DECLARE `Payment facts` HAS
    `manner`                                            IS A `Manner of payment`
    `amount paid`                                       IS A NUMBER
    `paid on`                                           IS A DATE
    `the employer is the Crown or a local authority`    IS A BOOLEAN
    `the worker's written consent or request to be paid this way` IS A BOOLEAN
    `notice withdrawing the consent or request`         IS A MAYBE `Notice of withdrawal`
    `the worker was absent from the proper or usual place of payment` IS A BOOLEAN
    `under a contract for payment by bearer cheque made before 17 November 1964` IS A BOOLEAN
    `permitted by another Act, a collective agreement or an order (ss 15, 16)` IS A BOOLEAN

§§ `The case (the top-level goal)`

DECLARE `Wage payment case` HAS
    `wages payable`                                     IS A NUMBER
    `payment`                                           IS A `Payment facts`
    `action brought on`                                 IS A DATE
    `deductions`                                        IS A LIST OF Deduction

§§ `Enforcement (ss 11A, 12A, 13)`

DECLARE Claimant IS ONE OF
    `the worker`
    `a Labour Inspector`
    `the person who paid the premium or from whose wages it was deducted`
    `another person`

-- s 11A(1)-(2), (5): arrears from a person who is not the employer.
DECLARE `Arrears claim against a person involved` HAS
    `the worker is entitled to the wages under this Act`         IS A BOOLEAN
    `the wages are unpaid due to non-compliance with this Act`   IS A BOOLEAN
    `the person is involved in the non-compliance`               IS A BOOLEAN
    `the person is the worker's employer`                        IS A BOOLEAN
    `prior leave of the Authority or court`                      IS A BOOLEAN
    `unpaid wages`                                               IS A NUMBER
    `what the employer is able to pay`                           IS A NUMBER
    `date of the conduct`                                        IS A DATE
