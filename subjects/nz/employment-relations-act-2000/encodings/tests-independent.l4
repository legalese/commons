IMPORT prelude
IMPORT daydate
IMPORT `era-types`
IMPORT `era-dates`
IMPORT `era-access`
IMPORT `era-grievance`
IMPORT `era-goal`

-- Independent tests, written from independent-expectations.md (expected
-- values fixed before the encoding was read). Scenario ids refer to that file.

§ `Fixtures`

mat MEANS LIST (Date 10 7 2026), (Date 25 6 2027)

GIVEN start IS A DATE, td IS A MAYBE NUMBER, nd IS A DATE, prev IS A BOOLEAN
GIVETH AN Employment
trialEmp start td nd prev MEANS Employment OF start, prev, td, nd, 50000, 364, 200000, FALSE

GIVEN rem IS A NUMBER, held IS A NUMBER, thr IS A NUMBER, optout IS A BOOLEAN
GIVETH AN Employment
hiEmp rem held thr optout MEANS Employment OF (Date 1 1 2020), FALSE, NOTHING, (Date 1 6 2026), rem, held, thr, optout

GIVEN gnd IS A Ground, rel IS A BOOLEAN
GIVETH A Grievance
gr gnd rel MEANS Grievance OF gnd, rel, (Date 1 6 2026), (Date 1 6 2026), (Date 1 6 2026), FALSE, FALSE, mat

GIVEN gnd IS A Ground, occ IS A DATE, noticed IS A DATE, raisedOn IS A DATE, cons IS A BOOLEAN, lv IS A BOOLEAN
GIVETH A Grievance
grT gnd occ noticed raisedOn cons lv MEANS Grievance OF gnd, FALSE, occ, noticed, raisedOn, cons, lv, mat

GIVEN occ IS A DATE
GIVETH A DATE
lastA occ MEANS `the last day to raise the grievance` (grT `(a) unjustifiable dismissal` occ occ occ FALSE FALSE)

GIVEN occ IS A DATE
GIVETH A DATE
lastSH occ MEANS `the last day to raise the grievance` (grT `(d) sexual harassment` occ occ occ FALSE FALSE)

GIVEN c IS A BOOLEAN, s IS A BOOLEAN, red IS A NUMBER, lost IS A NUMBER, otr IS A NUMBER
GIVETH A `Remedy facts`
rf c s red lost otr MEANS `Remedy facts` OF c, s, red, lost, otr

dismissA MEANS gr `(a) unjustifiable dismissal` TRUE

GIVEN nd IS A DATE, prev IS A BOOLEAN
GIVETH AN Employment
trial27 nd prev MEANS trialEmp (Date 1 2 2027) (JUST 90) nd prev

§ `Goal 1 — trial and high earners`

-- T01
#ASSERT `the last day of the trial period for` (trialEmp (Date 1 2 2027) (JUST 90) (Date 1 3 2027) FALSE) EQUALS JUST (Date 1 5 2027)
-- T02
#ASSERT `the last day of the trial period for` (trialEmp (Date 1 2 2027) (JUST 90) (Date 1 3 2027) TRUE) EQUALS NOTHING
