#ASSERT NOT `a Labour Inspector may revoke the permit` FALSE

-- ===== Exclusions s 9 =====
#ASSERT `rate of` (`s9 worker` `(b) an apprentice bound by an indenture of apprenticeship entered into under an Act`) EQUALS `the Act does not apply to the worker (ss 2, 9)`
#ASSERT `rate of` (`s9 worker` (`(d) an inmate of a charitable institution who does work in or in connection with it` OF FALSE)) EQUALS `the Act does not apply to the worker (ss 2, 9)`
#ASSERT `rate of` (`s9 worker` (`(d) an inmate of a charitable institution who does work in or in connection with it` OF TRUE)) EQUALS `the adult rate (s 4)` OF 25
#ASSERT `the Act applies to` (`s9 worker` `(e) an employee to whom the Home and Community Support (Payment for Travel Between Clients) Settlement Act 2016 applies`)
#ASSERT NOT `the Act applies to` (Worker OF FALSE, 30, FALSE, FALSE, FALSE, (`Benefit history` OF EMPTY, 0), Date 1 8 2022, Date 1 8 2022, Date 1 8 2022, `none of the s 9 classes`, NOTHING)

-- ===== Payment (ss 6, 7) =====
GIVEN b IS A `Board and lodging`, paid IS A NUMBER
GIVETH A `Pay period`
`period` b paid MEANS `Pay period` OF Date 2 8 2024, 40, EMPTY, 0, b, paid

GIVETH A `Board and lodging`
`no board` MEANS `Board and lodging` OF FALSE, NOTHING, 0, FALSE, NOTHING, 0

GIVEN w IS A Worker, p IS A `Pay period`
GIVETH A `Minimum wage position`
`pos` w p MEANS `the minimum wage position for` (`Wage case` OF w, `the order`, p)

-- A1 arrears: 40h x $25 = $1000
#ASSERT (`pos` (`plain` 30 24) (`period` `no board` 900))'s `minimum wages for the period` EQUALS JUST 1000
#ASSERT (`pos` (`plain` 30 24) (`period` `no board` 900))'s `arrears owed` EQUALS JUST 100
#ASSERT (`pos` (`plain` 30 24) (`period` `no board` 1000))'s `arrears owed` EQUALS JUST 0
#ASSERT (`pos` (`plain` 30 24) (`period` `no board` 1100))'s `arrears owed` EQUALS JUST 0
#ASSERT (`pos` (`plain` 30 24) (`period` `no board` 900))'s `the worker or a Labour Inspector may recover the arrears (s 11)`
#ASSERT NOT (`pos` (`plain` 30 24) (`period` `no board` 1000))'s `the worker or a Labour Inspector may recover the arrears (s 11)`
-- under 16: NOTHING owed under the Act
#ASSERT (`pos` (`plain` 15 1) (`period` `no board` 0))'s `arrears owed` EQUALS NOTHING
-- s 9(b) worker: Act does not apply, nothing owed
#ASSERT NOT (`pos` (`s9 worker` `(b) an apprentice bound by an indenture of apprenticeship entered into under an Act`) (`period` `no board` 0))'s `the Act applies`
#ASSERT (`pos` (`s9 worker` `(b) an apprentice bound by an indenture of apprenticeship entered into under an Act`) (`period` `no board` 0))'s `arrears owed` EQUALS NOTHING
-- D1 fixed cash value $120 board: $120 deduction counts in full; paid 880 -> no arrears
#ASSERT (`pos` (`plain` 30 24) (`period` (`Board and lodging` OF TRUE, JUST 120, 120, FALSE, NOTHING, 0) 880))'s `arrears owed` EQUALS JUST 0
-- D1 $121 deducted, fixed $120: only 120 counts; paid 879 -> $1 owed
#ASSERT (`pos` (`plain` 30 24) (`period` (`Board and lodging` OF TRUE, JUST 120, 121, FALSE, NOTHING, 0) 879))'s `arrears owed` EQUALS JUST 1
-- D2 not fixed: 15% board = 150
#ASSERT (`pos` (`plain` 30 24) (`period` (`Board and lodging` OF TRUE, NOTHING, 150, FALSE, NOTHING, 0) 850))'s `arrears owed` EQUALS JUST 0
#ASSERT (`pos` (`plain` 30 24) (`period` (`Board and lodging` OF TRUE, NOTHING, 160, FALSE, NOTHING, 0) 840))'s `arrears owed` EQUALS JUST 10
-- D2 lodging 5% = 50
#ASSERT (`pos` (`plain` 30 24) (`period` (`Board and lodging` OF FALSE, NOTHING, 0, TRUE, NOTHING, 50) 950))'s `arrears owed` EQUALS JUST 0
#ASSERT (`pos` (`plain` 30 24) (`period` (`Board and lodging` OF FALSE, NOTHING, 0, TRUE, NOTHING, 60) 940))'s `arrears owed` EQUALS JUST 10
-- D3 both: 150 + 50 = 200
#ASSERT (`pos` (`plain` 30 24) (`period` (`Board and lodging` OF TRUE, NOTHING, 150, TRUE, NOTHING, 50) 800))'s `board and lodging deductions that count` EQUALS JUST 200
#ASSERT (`pos` (`plain` 30 24) (`period` (`Board and lodging` OF TRUE, NOTHING, 150, TRUE, NOTHING, 50) 800))'s `arrears owed` EQUALS JUST 0
-- board deducted but not provided by the employer: counts for nothing
#ASSERT (`pos` (`plain` 30 24) (`period` (`Board and lodging` OF FALSE, NOTHING, 100, FALSE, NOTHING, 0) 900))'s `arrears owed` EQUALS JUST 100
-- D4 s 7(2) time lost: default / illness / accident deductible, another reason not
#ASSERT (`pos` (`plain` 30 24) (`Pay period` OF Date 2 8 2024, 40, (LIST (`Time lost` OF 4, `the default of the worker`)), 0, `no board`, 900))'s `arrears owed` EQUALS JUST 0
#ASSERT (`pos` (`plain` 30 24) (`Pay period` OF Date 2 8 2024, 40, (LIST (`Time lost` OF 4, `the worker's illness`)), 0, `no board`, 900))'s `arrears owed` EQUALS JUST 0
#ASSERT (`pos` (`plain` 30 24) (`Pay period` OF Date 2 8 2024, 40, (LIST (`Time lost` OF 4, `an accident suffered by the worker`)), 0, `no board`, 900))'s `arrears owed` EQUALS JUST 0
#ASSERT (`pos` (`plain` 30 24) (`Pay period` OF Date 2 8 2024, 40, (LIST (`Time lost` OF 4, `another reason`)), 0, `no board`, 900))'s `arrears owed` EQUALS JUST 100
-- X4/X5 s 9(e): travel between clients excluded, other work at the minimum
#ASSERT (`pos` (`s9 worker` `(e) an employee to whom the Home and Community Support (Payment for Travel Between Clients) Settlement Act 2016 applies`) (`Pay period` OF Date 2 8 2024, 40, EMPTY, 10, `no board`, 750))'s `arrears owed` EQUALS JUST 0
#ASSERT (`pos` (`s9 worker` `(e) an employee to whom the Home and Community Support (Payment for Travel Between Clients) Settlement Act 2016 applies`) (`Pay period` OF Date 2 8 2024, 40, EMPTY, 10, `no board`, 700))'s `arrears owed` EQUALS JUST 50
-- travel hours of a non-(e) worker count in full
#ASSERT (`pos` (`plain` 30 24) (`Pay period` OF Date 2 8 2024, 40, EMPTY, 10, `no board`, 750))'s `arrears owed` EQUALS JUST 250
-- starting-out worker's minimum at $20
#ASSERT (`pos` (`plain` 17 3) (`period` `no board` 700))'s `arrears owed` EQUALS JUST 100

