IMPORT prelude
IMPORT daydate
IMPORT `mwa-types`
IMPORT `mwa-rates`
IMPORT `mwa-payment`
IMPORT `mwa-enforcement`
IMPORT `mwa-goal`

-- Independent tests: expected values decided from the Act alone
-- (see independent-expectations.md), before the encoding was read.
-- A failing assertion is a finding; expected values are not to be changed.

-- The invented Minimum Wage Order:
--   adult $25.00; class A ages 16-17, < 6 months with current employer, $20.00;
--   class B ages 16-19, >= 6 months on a specified benefit, 85%;
--   class C ages 16-19, training contract, $21.00; training rate $20.00.


GIVEN x IS A NUMBER
GIVETH A `Rate form`
`money` x MEANS `a monetary amount per hour` OF x

GIVEN x IS A NUMBER
GIVETH A `Rate form`
`pct` x MEANS `a percentage of the minimum adult rate` OF x

GIVETH A `Starting-out class`
`class A` MEANS `Starting-out class` OF 16, 17, NOTHING, JUST `the current employer`, FALSE, 6, `money` 20

GIVETH A `Starting-out class`
`class B` MEANS `Starting-out class` OF 16, 19, JUST 6, NOTHING, FALSE, 6, `pct` 85

GIVETH A `Starting-out class`
`class C` MEANS `Starting-out class` OF 16, 19, NOTHING, NOTHING, TRUE, 6, `money` 21

GIVETH A `Minimum Wage Order`
`the order` MEANS `Minimum Wage Order` OF 25, (LIST `class A`, `class B`, `class C`), JUST (`money` 20)

GIVEN c IS A `Starting-out class`
GIVETH A `Minimum Wage Order`
`order with only` c MEANS `Minimum Wage Order` OF 25, (LIST c), JUST (`money` 20)

GIVEN t IS A `Rate form`
GIVETH A `Minimum Wage Order`
`order with training rate` t MEANS `Minimum Wage Order` OF 25, (LIST `class A`, `class B`, `class C`), JUST t

-- worker: age, supervises, training contract, in Order's training class,
-- months on jobseeker support, months of employment (all three counts the same)
-- [Ported by the encoder on 2026-10-15, when the encoding changed from month
-- counts to first days of employment: "emp months" is now a first day of work
-- emp months before 1 August 2024, the day `rate of` asks about. No expected
-- value was changed.]
GIVEN emp IS A NUMBER
GIVETH A DATE
`started months before 1 August 2024` emp MEANS `add months` (Date 1 8 2024) (0 MINUS emp)

GIVEN age IS A NUMBER, sup IS A BOOLEAN, tr IS A BOOLEAN, tc IS A BOOLEAN, ben IS A NUMBER, emp IS A NUMBER
GIVETH A Worker
`worker` age sup tr tc ben emp MEANS
    Worker OF TRUE, age, sup, tr, tc, (`Benefit history` OF (LIST `(da) jobseeker support`), ben), `started months before 1 August 2024` emp, `started months before 1 August 2024` emp, `started months before 1 August 2024` emp, `none of the s 9 classes`, NOTHING

GIVEN age IS A NUMBER, started IS A DATE
GIVETH A Worker
`plain, started on` age started MEANS
    Worker OF TRUE, age, FALSE, FALSE, FALSE, (`Benefit history` OF EMPTY, 0), started, started, started, `none of the s 9 classes`, NOTHING

GIVEN age IS A NUMBER, emp IS A NUMBER
GIVETH A Worker
`plain` age emp MEANS `worker` age FALSE FALSE FALSE 0 emp

GIVEN s IS A `Section 9 class`
GIVETH A Worker
`s9 worker` s MEANS
    Worker OF TRUE, 30, FALSE, FALSE, FALSE, (`Benefit history` OF EMPTY, 0), Date 1 8 2022, Date 1 8 2022, Date 1 8 2022, s, NOTHING

GIVEN p IS A Permit
GIVETH A Worker
`permit worker` p MEANS
    Worker OF TRUE, 30, FALSE, FALSE, FALSE, (`Benefit history` OF EMPTY, 0), Date 1 8 2022, Date 1 8 2022, Date 1 8 2022, `none of the s 9 classes`, JUST p

GIVETH A Permit
`permit` MEANS Permit OF 15, Date 1 7 2024, Date 31 12 2024, NOTHING

GIVETH A Permit
`revoked permit` MEANS Permit OF 15, Date 1 7 2024, Date 31 12 2024, JUST (Date 1 10 2024)

GIVEN w IS A Worker
GIVETH A `Rate that governs`
`rate of` w MEANS `the rate that governs` w `under` `the order` `on` (Date 1 8 2024)

GIVEN w IS A Worker, d IS A DATE
GIVETH A `Rate that governs`
`rate of` w `on day` d MEANS `the rate that governs` w `under` `the order` `on` d

-- ===== Which rate governs (ss 4, 4A, 4B) =====
-- R1 s 4(1)
#ASSERT `rate of` (`plain` 25 24) EQUALS `the adult rate (s 4)` OF 25
-- R2 s 4(1)(a): 16 with 6+ months (outside class A by service) -> adult
#ASSERT `rate of` (`plain` 16 6) EQUALS `the adult rate (s 4)` OF 25
-- R3 under 16: no prescribed class
#ASSERT `rate of` (`plain` 15 1) EQUALS `no minimum rate is prescribed for the worker`
#ASSERT `the hourly minimum under` (`rate of` (`plain` 15 1)) EQUALS NOTHING
-- R4 s 4A(1)(c)(ii)(B)
#ASSERT `rate of` (`plain` 17 3) EQUALS `a starting-out rate (s 4A)` OF 20
-- R4 age edges of class A: 16 in, 18 out
#ASSERT `rate of` (`plain` 16 3) EQUALS `a starting-out rate (s 4A)` OF 20
#ASSERT `rate of` (`plain` 18 3) EQUALS `the adult rate (s 4)` OF 25
-- R5 s 4A(1)(b): supervising -> adult
#ASSERT `rate of` (`worker` 17 TRUE FALSE FALSE 0 3) EQUALS `the adult rate (s 4)` OF 25
-- R7 s 4A(4): class A and class B both apply -> highest (85% of 25 = 21.25)
#ASSERT `rate of` (`worker` 17 FALSE FALSE FALSE 6 3) EQUALS `a starting-out rate (s 4A)` OF 21.25
-- class B threshold: 5 months on benefit -> not class B, only class A
#ASSERT `rate of` (`worker` 17 FALSE FALSE FALSE 5 3) EQUALS `a starting-out rate (s 4A)` OF 20
-- R8 s 4A(1)(c)(iii)
#ASSERT `rate of` (`worker` 19 FALSE TRUE FALSE 0 3) EQUALS `a starting-out rate (s 4A)` OF 21
-- R8 + supervising -> adult
#ASSERT `rate of` (`worker` 19 TRUE TRUE FALSE 0 3) EQUALS `the adult rate (s 4)` OF 25
-- R9 s 4B(1)
#ASSERT `rate of` (`worker` 20 FALSE TRUE TRUE 0 3) EQUALS `the training rate (s 4B)` OF 20
-- R10 s 4B(1)(b)
#ASSERT `rate of` (`worker` 20 TRUE TRUE TRUE 0 3) EQUALS `the adult rate (s 4)` OF 25
-- age 20, no training contract -> adult
#ASSERT `rate of` (`plain` 20 3) EQUALS `the adult rate (s 4)` OF 25
-- R11 s 4A(3)(a)(ii): age 19 (the day before the 20th birthday) on class B
#ASSERT `rate of` (`worker` 19 FALSE FALSE FALSE 12 2) EQUALS `a starting-out rate (s 4A)` OF 21.25
-- R12 on the 20th birthday -> adult
#ASSERT `rate of` (`worker` 20 FALSE FALSE FALSE 12 2) EQUALS `the adult rate (s 4)` OF 25
-- R13 s 4A(3)(a)(i): just short of 6 months
-- [ported: first day 3 Feb 2024, 6 months completed on 2 Aug 2024]
#ASSERT `rate of` (`plain, started on` 17 (Date 3 2 2024)) EQUALS `a starting-out rate (s 4A)` OF 20
-- R14 s 4A(3)(b): past 6 months -> adult
-- [ported: first day 28 Jan 2024, 6 months completed on 27 Jul 2024]
#ASSERT `rate of` (`plain, started on` 17 (Date 28 1 2024)) EQUALS `the adult rate (s 4)` OF 25
-- R14a s 4A(3)(a)(i) "only until ... the date on which the worker has completed 6 months" read inclusively (judgment)
-- [ported: first day 2 Feb 2024, 6 months completed on 1 Aug 2024, the day asked]
#ASSERT `rate of` (`plain, started on` 17 (Date 2 2 2024)) EQUALS `a starting-out rate (s 4A)` OF 20
-- class B worker who has completed 6 months' employment since benefit run -> adult (s 4A(3))
#ASSERT `rate of` (`worker` 19 FALSE FALSE FALSE 12 7) EQUALS `the adult rate (s 4)` OF 25
-- R15 factor (iii) only: no 6-month limit
#ASSERT `rate of` (`worker` 19 FALSE TRUE FALSE 0 24) EQUALS `a starting-out rate (s 4A)` OF 21

-- ===== 80% floor and limits on the Order (ss 4A(1)-(2), 4B(2)) =====
-- F1 exactly 80%
#ASSERT `the starting-out rate for` (`plain` 17 3) `under` (`order with only` (`Starting-out class` OF 16, 17, NOTHING, JUST `the current employer`, FALSE, 6, `money` 20)) `on` (Date 1 8 2024) EQUALS JUST 20
-- F2 below 80%
#ASSERT REFUSED (`the starting-out rate for` (`plain` 17 3) `under` (`order with only` (`Starting-out class` OF 16, 17, NOTHING, JUST `the current employer`, FALSE, 6, `money` 19.99)) `on` (Date 1 8 2024))
-- F3 percentage 80 / 79
#ASSERT `the starting-out rate for` (`plain` 17 3) `under` (`order with only` (`Starting-out class` OF 16, 17, NOTHING, JUST `the current employer`, FALSE, 6, `pct` 80)) `on` (Date 1 8 2024) EQUALS JUST 20
#ASSERT REFUSED (`the starting-out rate for` (`plain` 17 3) `under` (`order with only` (`Starting-out class` OF 16, 17, NOTHING, JUST `the current employer`, FALSE, 6, `pct` 79)) `on` (Date 1 8 2024))
-- s 4A(1)(c)(i) "not less than 6 months": 6 ok, 5 outside power
#ASSERT `the starting-out rate for` (`worker` 17 FALSE FALSE FALSE 6 1) `under` (`order with only` (`Starting-out class` OF 16, 19, JUST 6, NOTHING, FALSE, 6, `pct` 85)) `on` (Date 1 8 2024) EQUALS JUST 21.25
#ASSERT REFUSED (`the starting-out rate for` (`worker` 17 FALSE FALSE FALSE 6 1) `under` (`order with only` (`Starting-out class` OF 16, 19, JUST 5, NOTHING, FALSE, 6, `pct` 85)) `on` (Date 1 8 2024))
-- s 4A(1)(c)(ii) "not more than 6 months": 7 outside power
#ASSERT REFUSED (`the starting-out rate for` (`plain` 17 3) `under` (`order with only` (`Starting-out class` OF 16, 17, NOTHING, JUST `the current employer`, FALSE, 7, `money` 20)) `on` (Date 1 8 2024))
-- s 4A(1)(a): a class reaching age 20 is outside power
#ASSERT REFUSED (`the starting-out rate for` (`plain` 17 3) `under` (`order with only` (`Starting-out class` OF 16, 20, NOTHING, JUST `the current employer`, FALSE, 6, `money` 20)) `on` (Date 1 8 2024))
-- F4 s 4B(2) training rate 20 ok / 19.99 refused; 80% ok / 79% refused
#ASSERT `the training rate for` (`worker` 20 FALSE TRUE TRUE 0 3) `under` (`order with training rate` (`money` 20)) EQUALS JUST 20
#ASSERT REFUSED (`the training rate for` (`worker` 20 FALSE TRUE TRUE 0 3) `under` (`order with training rate` (`money` 19.99)))
#ASSERT `the training rate for` (`worker` 20 FALSE TRUE TRUE 0 3) `under` (`order with training rate` (`pct` 80)) EQUALS JUST 20
#ASSERT REFUSED (`the training rate for` (`worker` 20 FALSE TRUE TRUE 0 3) `under` (`order with training rate` (`pct` 79)))

-- ===== Permits s 8(3)-(5) =====
-- P1 in force
#ASSERT `rate of` (`permit worker` `permit`) `on day` (Date 1 8 2024) EQUALS `the rate stated in an exemption permit (s 8(4))` OF 15
-- P2 start date edges
#ASSERT `rate of` (`permit worker` `permit`) `on day` (Date 30 6 2024) EQUALS `the adult rate (s 4)` OF 25
#ASSERT `rate of` (`permit worker` `permit`) `on day` (Date 1 7 2024) EQUALS `the rate stated in an exemption permit (s 8(4))` OF 15
