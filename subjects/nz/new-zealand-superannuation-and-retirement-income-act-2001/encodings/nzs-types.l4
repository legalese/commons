IMPORT prelude
IMPORT daydate

-- New Zealand Superannuation and Retirement Income Act 2001 — THE NOUNS.
--
-- Every fact the rule modules read, and nothing else: no rules, no #EVAL.
-- Source: ../registers/source-bundle/act_public_2001_84.txt (New Zealand
-- Legislation, version as at 10 July 2026, converted from the PCO XML).
-- Field names are unique across records.

§ `New Zealand Superannuation and Retirement Income Act 2001 — the nouns`

§§ `The person (ss 7-11)`

DECLARE Applicant HAS
    `date of birth`                                     IS A DATE
    -- s 7(2): an election to receive ACC or veterans' weekly compensation
    -- instead.
    `elected weekly compensation instead`               IS A BOOLEAN
    `ordinarily resident in New Zealand on application` IS A BOOLEAN
    -- s 8(4) (table lost in conversion): the total time requirement in years.
    `total time requirement from the s 8(4) table, in years` IS A NUMBER
    -- s 8(2)-(3), counting periods treated as residence under ss 9-10A.
    `years resident and present in New Zealand since 20` IS A NUMBER
    `years resident and present in New Zealand, the Cook Islands, Niue or Tokelau since 20` IS A NUMBER
    `years resident and present in those places since 50` IS A NUMBER
    -- s 8A: refugees and protected persons.
    `a refugee or protected person`                     IS A BOOLEAN
    `first resident and present in New Zealand on`      IS A DATE
    `application received on`                           IS A DATE
    -- s 11: the day the residential qualification was first met, if after the
    -- 65th birthday (added after the independent pass; the s 8 example meets
    -- it at 69).
    `residential qualification first met on, if after 65` IS A MAYBE DATE

§§ `The rate (ss 4A, 12, 17-19, Schedule 1)`

DECLARE `Relationship status` IS ONE OF
    `single`
    `married, in a civil union, or in a de facto relationship`

-- Schedule 1, as adjusted under s 15 (the amounts are lost in the
-- conversion, and change every 1 April).
DECLARE `Rates in force` HAS
    `single living alone rate`                          IS A NUMBER
    `single sharing accommodation rate`                 IS A NUMBER
    `rate for each person in a couple`                  IS A NUMBER
    `hospital rate`                                     IS A NUMBER

-- s 4A: living alone.
DECLARE Household HAS
    `occupies accommodation of a s 4A(2) kind as principal residence` IS A BOOLEAN
    `shares it with someone 18 or over who is not a dependent student child or a short-term visitor` IS A BOOLEAN

DECLARE `Rate facts` HAS
    `relationship status`                               IS A `Relationship status`
    `household`                                         IS A Household
    -- s 17: the spouse or partner is in long-term residential care in a
    -- hospital or rest home (and the person is not).
    `spouse or partner in long-term residential care`   IS A BOOLEAN
    -- s 19: weeks as a hospital patient, and whether a funder pays for
    -- contracted care as a resident assessed as requiring care.
    `weeks in hospital`                                 IS A NUMBER
    `a funded resident assessed as requiring care`      IS A BOOLEAN
    `has dependent children`                            IS A BOOLEAN

§§ `Absence (ss 21-35)`

DECLARE `Absence facts` HAS
    `weeks absent so far`                               IS A NUMBER
    `total weeks absent`                                IS A NUMBER
    `absence beyond 30 weeks unforeseeable and beyond control` IS A BOOLEAN
    -- s 26A: residence in New Zealand between 20 and 65, as whole calendar
    -- months and additional days.
    `whole calendar months resident in New Zealand aged 20 to 65` IS A NUMBER
    `additional days resident in New Zealand aged 20 to 65` IS A NUMBER
    -- s 32: whole years resident in New Zealand since turning 20.
    `whole years resident in New Zealand since 20`      IS A NUMBER
