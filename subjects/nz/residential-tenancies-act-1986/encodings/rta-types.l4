IMPORT prelude
IMPORT daydate

-- Residential Tenancies Act 1986 (New Zealand) — THE NOUNS.
--
-- Every fact the rule modules read, and nothing else: no rules, no #EVAL.
-- Source: ../registers/source-bundle/act_public_1986_120.txt (New Zealand
-- Legislation, version as at 1 December 2025, converted from the PCO XML).
-- Field names are unique across records.

§ `Residential Tenancies Act 1986 — the nouns`

§§ `Working days (s 2)`

-- s 2 "working day" leaves out Matariki Observance Day and "the day observed
-- in the appropriate area as the anniversary of the province", which are
-- inputs for each year.
DECLARE `Local calendar` HAS
    `Matariki Observance Days`                          IS A LIST OF DATE
    `anniversary days observed in the area`             IS A LIST OF DATE

-- s 136: how a notice was given, for when it is deemed given.
DECLARE `Means of service` IS ONE OF
    `personally`
    `by post`
    `by delivery to a mailbox or door`
    `by email or other electronic address, by 5 pm`
    `by email or other electronic address, after 5 pm`

§§ `Application (ss 5, 7)`

-- s 5(1): the cases in which the Act does not apply (one constructor per
-- paragraph, in the order of the section).
DECLARE `Exclusion from the Act` IS ONE OF
    `none of the s 5 exclusions`
    `commercial premises`
    `the tenant's income derives substantially from agricultural or similar use`
    `a long pre-2008 fixed term that excludes the Act`
    `a prison or Police jail`
    `a hospital or care home`
    `Police barracks or cells`
    `Armed Forces barracks`
    `an employer's barracks or hostel for employees`
    `a school hostel or exempt student accommodation`
    `a club's temporary accommodation`
    `a licensed hotel`
    `temporary or transient accommodation for less than 28 days at a time`
    `a retirement village occupation right agreement`
    `holiday premises`
    `premises used principally as the residence of the landlord, owner, or their family`
    `a purchaser under an agreement for sale and purchase`
    `a cross-lease or lease-back arrangement`
    `a stratum estate in leasehold`
    `a tenancy arising from company shares`
    `a genuine head lease for subletting`
    `bare land for a mobile home or caravan`
    `a camping-ground cabin or caravan for up to 50 days`
    `temporary accommodation in a relocatable home`
    `a Public Bodies Leases Act lease`
    `a Maori Trustee lease of reserved land`
    `a lease with a perpetual right of renewal`
    `a lease where the lessee may remove or be compensated for the house`
    `funded emergency or transitional accommodation`

DECLARE Tenancy HAS
    `exclusion`                                         IS AN `Exclusion from the Act`
    -- s 8: the parties to an excluded tenancy agreed in writing that the Act
    -- applies.
    `the parties agreed in writing that the Act applies` IS A BOOLEAN
    -- s 7: a fixed term of not more than 90 days, agreed in writing before it
    -- began not to be extended or renewed beyond 90 days in total.
    `fixed term, in days, if any`                       IS A MAYBE NUMBER
    `agreed in writing not to extend beyond 90 days`    IS A BOOLEAN
    `total term after any extension or renewal, in days` IS A NUMBER

§§ `Bonds (ss 18-22A, 66D)`

DECLARE `Kind of bond` IS ONE OF
    `a general bond`
    `a pet bond`

DECLARE `Bond demand` HAS
    `kind of bond`                                      IS A `Kind of bond`
    `bond required`                                     IS A NUMBER
    `weekly rent when the bond is required`             IS A NUMBER
    `the tenant keeps or intends to keep a pet`         IS A BOOLEAN
    `the landlord agreed the pet may be kept`           IS A BOOLEAN
    `a pet bond is already held`                        IS A BOOLEAN
    -- s 18A: any other security (a property interest, a card imprint, a
    -- power over the tenant's accounts); a guarantee is not security.
    `other security required`                           IS A BOOLEAN

DECLARE `Bond payment` HAS
    `bond paid on`                                      IS A DATE
    `bond forwarded to the chief executive on`          IS A MAYBE DATE
    `paid under a boarding house tenancy`               IS A BOOLEAN
    `bond paid, in weeks of rent`                       IS A NUMBER

DECLARE `Who applies` IS ONE OF
    `a landlord`
    `a tenant`
    `the chief executive`

§§ `Rent (ss 23-30)`

DECLARE `Rent demand` HAS
    `weeks of rent required in advance`                 IS A NUMBER
    `required before the period already paid for expires` IS A BOOLEAN
    `required by postdated cheque`                      IS A BOOLEAN
    -- s 23(2): a service or employer tenancy whose regular pay deduction for
    -- rent is lengthened for a holiday pay period, in the same proportion.
    `the s 23(2) longer pay period deduction applies`   IS A BOOLEAN

DECLARE `Rent increase notice` HAS
    `notice given on`                                   IS A DATE
    `increase takes effect on`                          IS A DATE
    `notice in writing stating the amount and the day`  IS A BOOLEAN
    `tenancy commenced on`                              IS A DATE
    `last increase took effect on`                      IS A MAYBE DATE
    `a fixed-term tenancy`                              IS A BOOLEAN
    `the agreement permits increases during the term`   IS A BOOLEAN
    `a boarding house tenancy`                          IS A BOOLEAN
    -- s 24(1)(h): a market rent order under s 25 still in force, if any.
    `market rent order amount in force`                 IS A MAYBE NUMBER
    `new weekly rent`                                   IS A NUMBER

DECLARE `Market rent application` HAS
    `market rent application made on`                   IS A DATE
    `for a fixed-term tenancy`                          IS A BOOLEAN
    `the fixed term commenced on`                       IS A DATE
    `last rent review on`                               IS A MAYBE DATE
    -- s 25(2A): notice of a change in unit title body corporate rules that
    -- affects the tenant.
    `aware of a body corporate rule change on`          IS A MAYBE DATE

-- s 29(4): the ways of paying that need no receipt.
DECLARE `Way rent is paid` IS ONE OF
    `in cash`
    `by another means needing a receipt`
    `by automatic payment or non-negotiable cheque from the tenant's account`
    `into an account the landlord keeps only for its tenancies`
    `by deduction from pay or benefit into the landlord's account`

DECLARE `Rent payment` HAS
    `way rent is paid`                                  IS A `Way rent is paid`
    `receipt given forthwith`                           IS A BOOLEAN
    `hours after payment the receipt was given`         IS A MAYBE NUMBER

§§ `Damage (ss 49A, 49B)`

DECLARE `Damage facts` HAS
    -- s 49B(1): intentional, an imprisonable offence on or about the
    -- premises, or the result of keeping a pet.
    `damage intentional, an imprisonable offence, or caused by a pet` IS A BOOLEAN
    `damage caused by a careless act or omission`       IS A BOOLEAN
    `cost of making good the damage`                    IS A NUMBER
    `premises insured against the damage`               IS A BOOLEAN
    `insurance irrecoverable because of the tenant`     IS A BOOLEAN
    `insurance excess`                                  IS A NUMBER
    `the tenant pays an income-related rent`            IS A BOOLEAN
    `weekly rent under the agreement`                   IS A NUMBER
    `weekly market rent under the Public and Community Housing Management Act` IS A NUMBER

§§ `Termination (ss 50-66)`

DECLARE `Who gives notice` IS ONE OF
    `the landlord`
    `the tenant`

DECLARE `Kind of tenancy` IS ONE OF
    `periodic`
    `fixed-term`

-- The sections under which a party may terminate by notice (s 50(1)(a)-(b)).
DECLARE `Ground for notice` IS ONE OF
    `s 51(1) the landlord, in any case`
    `s 51(2)(a) the owner or family will live there`
    `s 51(2)(b) an unconditional sale needs vacant possession`
    `s 51(2)(c) required for employees or contractors, as stated in the agreement`
    `s 51(2)(d) required for school board employees or contractors (the Crown), as stated in the agreement`
    `s 51(2A) the tenant, in any case`
    `s 53(1) the service contract has ended or notice of its end was given`
    `s 53(4) the service tenant died leaving a dependant`
    `s 53(5) the service tenant died and a replacement is urgently needed`
    `s 53A(2) the tenant is no longer eligible for the student tenancy`
    `s 55AA a physical assault for which a charge has been filed`
    `s 56A(1) unlawful residential premises`
    `s 56B withdrawal following family violence`
    `s 58A a build-to-rent fixed term of at least 10 years`
    `ss 59, 59A, 59B the premises are destroyed, uninhabitable or contaminated`

DECLARE `Termination notice` HAS
    `given by`                                          IS A `Who gives notice`
    `kind of tenancy`                                   IS A `Kind of tenancy`
    `ground`                                            IS A `Ground for notice`
    `notice of termination sent on`                     IS A DATE
    `served`                                            IS A `Means of service`
    `date to vacate`                                    IS A DATE
    -- s 51(3)-(4), or the approved form for ss 55AA and 56B.
    `in the required form`                              IS A BOOLEAN
    -- s 53(3): no earlier than the end of the contract of service or the
    -- transfer.
    `service contract ends on`                          IS A MAYBE DATE

-- s 55(1)(aa) and s 55A(2): one of 3 occasions, with the landlord's written
-- notice of it.
DECLARE Occasion HAS
    `occasion on`                                       IS A DATE
    `rent paid on, if paid`                             IS A MAYBE DATE
    `occasion notice given on`                          IS A DATE

DECLARE `Termination application` HAS
    `application filed on`                              IS A DATE
    `periodic tenancy`                                  IS A BOOLEAN
    `days of rent in arrear at filing`                  IS A NUMBER
    `rent overdue occasions`                            IS A LIST OF Occasion
    `anti-social behaviour occasions`                   IS A LIST OF Occasion
    -- the content each notice must have (s 55(1)(aa)(ii)-(iii), s 55A(2)(b)).
    `each occasion notice had the required content`     IS A BOOLEAN
    `substantial damage caused or threatened`           IS A BOOLEAN
    `assault or threat against a person in s 55(1)(c)`  IS A BOOLEAN
    -- s 55(3): the Tribunal may refuse.
    `breach remedied, landlord compensated, no further breach likely` IS A BOOLEAN
    -- s 55A(3): the order would be unfair, or the application was retaliatory.
    `s 55A(3) unfairness or retaliation shown`          IS A BOOLEAN

-- s 60A: the end of a fixed term.
DECLARE `Fixed term ending` HAS
    `fixed term expires on`                             IS A DATE
    `fixed term length, in days`                        IS A NUMBER
    `renewed or extended before expiry`                 IS A BOOLEAN
    `agreed before expiry not to continue`              IS A BOOLEAN
    -- the day the written notice was given (or deemed given, s 136).
    `notice of intention not to continue given on`      IS A MAYBE DATE
    `ended on or before expiry by a notice under s 50(1)(a)-(ac)` IS A BOOLEAN

§§ `Entry (s 48)`

DECLARE `Purpose of entry` IS ONE OF
    `(2)(a) emergency`
    `(2)(b) inspection`
    `(2)(ba) contaminant testing`
    `(2)(c) checking remedial work`
    `(2)(ca)-(cc), (d) smoke alarms, healthy homes, decontamination or necessary repairs`
    `(2A)-(2B) confirming abandonment`

DECLARE `Entry notice` HAS
    `purpose`                                           IS A `Purpose of entry`
    `entry notice given on`                             IS A DATE
    `entry notice given at hour`                        IS A NUMBER
    `entry on`                                          IS A DATE
    `entry at hour`                                     IS A NUMBER
    `last inspection entry on`                          IS A MAYBE DATE
    `days of rent in arrear`                            IS A NUMBER
    `reasonable cause to believe the premises abandoned` IS A BOOLEAN

§§ `Boarding houses (Part 2A)`

DECLARE `Boarding house ground` IS ONE OF
    `s 66U(1)(a) serious damage, endangering people or property, or serious disruption`
    `s 66U(1)(b)(i) rent arrears unpaid after a notice of at least 10 days`
    `s 66U(1)(b)(ii) use for an illegal purpose`
    `s 66U(1)(b)(iii) abandonment, after s 66X`
    `s 66U(1)(c) also a service tenancy`
    `s 66U(1)(d) no reason given`
    `s 66V the tenant's notice`

DECLARE `Boarding house notice` HAS
    `boarding house ground`                             IS A `Boarding house ground`
    `boarding notice given on`                          IS A DATE
    `boarding notice given at hour`                     IS A NUMBER
    `termination takes effect on`                       IS A DATE
    `termination takes effect at hour`                  IS A NUMBER
    -- s 66U(2) (a landlord's notice); a tenant's notice need not be written
    -- (s 66V(2)).
    `boarding notice in the required form`              IS A BOOLEAN
    -- s 66U(1)(b)(i): the arrears notice.
    `arrears notice period stated, in days`             IS A NUMBER
    `arrears paid within the stated period`             IS A BOOLEAN

DECLARE `Boarding room entry` HAS
    `room entry notice given on`                        IS A DATE
    `room entry notice given at hour`                   IS A NUMBER
    `room entered on`                                   IS A DATE
    `room entered at hour`                              IS A NUMBER
    -- s 66S(1)-(3): for a listed purpose, stated with who will enter and when.
    `notice for a s 66S(1) purpose, with the s 66S(3) content` IS A BOOLEAN

§§ `The Tribunal (ss 54, 77, 108, 109)`

DECLARE `Unlawful act application` HAS
    `applicant`                                         IS A `Who applies`
    -- s 109(2)(a): failing to receipt or lodge a bond (s 19(2)), or to keep
    -- bond records (s 30(2)).
    `an unlawful act under s 19(2) or a bond-records failure under s 30(2)` IS A BOOLEAN
    `unlawful act committed on`                         IS A DATE
    `tenancy terminated on`                             IS A MAYBE DATE
    `chief executive first aware on`                    IS A MAYBE DATE
    `unlawful act application made on`                  IS A DATE
    -- s 109(3)-(3A).
    `committed intentionally`                           IS A BOOLEAN
    `a retaliatory notice under s 54(6)`                IS A BOOLEAN
    `just to award exemplary damages`                   IS A BOOLEAN
    `exemplary damages sought`                          IS A NUMBER
    -- Schedule 1A (the amounts are lost in the conversion).
    `Schedule 1A maximum for the act`                   IS A NUMBER
