#ASSERT `the last day to lodge the bond, payment` (`Bond payment` OF (Date 15 6 2026), NOTHING, FALSE, 4) `, calendar` calNZ EQUALS JUST (Date 17 7 2026)
#ASSERT `the last day to lodge the bond, payment` (`Bond payment` OF (Date 20 1 2027), NOTHING, FALSE, 4) `, calendar` calWg EQUALS JUST (Date 24 2 2027)
#ASSERT `the last day to lodge the bond, payment` (`Bond payment` OF (Date 20 1 2027), NOTHING, FALSE, 4) `, calendar` calNZ EQUALS JUST (Date 23 2 2027)
-- B18-B19 boarding house bond
#ASSERT `the last day to lodge the bond, payment` (`Bond payment` OF (Date 1 12 2026), NOTHING, TRUE, 1) `, calendar` calNZ EQUALS NOTHING
#ASSERT `a boarding house bond need not be lodged, weeks of rent` 1
#ASSERT NOT `a boarding house bond need not be lodged, weeks of rent` (201 DIVIDED BY 200)
#ASSERT `the last day to lodge the bond, payment` (`Bond payment` OF (Date 1 12 2026), NOTHING, TRUE, 201 DIVIDED BY 200) `, calendar` calNZ EQUALS JUST (Date 12 1 2027)

-- B21-B24 rent in advance (rent 500/week: 1000 = 2 weeks, 1001 = 2.002 weeks)
