#ASSERT isWD (Date 4 1 2027)
#ASSERT NOT isWD (Date 1 6 2026)
#ASSERT NOT isWD (Date 10 7 2026)
#ASSERT NOT isWD (Date 26 10 2026)
#ASSERT isWD (Date 27 10 2026)
#ASSERT isWD (Date 23 12 2026)
#ASSERT NOT isWD (Date 26 3 2027)
#ASSERT isWD (Date 31 3 2027)
#ASSERT NOT isWD (Date 26 4 2027)
#ASSERT NOT isWD (Date 7 6 2027)
#ASSERT NOT `is a working day under s 2` (Date 25 1 2027) calWg
#ASSERT isWD (Date 25 1 2027)
#ASSERT isWD (Date 16 11 2026)

-- A18-A23 nth working day
#ASSERT nthWD 4 (Date 2 4 2026) EQUALS Date 13 4 2026
#ASSERT nthWD 2 (Date 18 12 2026) EQUALS Date 22 12 2026
#ASSERT nthWD 2 (Date 22 12 2026) EQUALS Date 4 1 2027
#ASSERT nthWD 4 (Date 21 12 2026) EQUALS Date 5 1 2027
#ASSERT nthWD 2 (Date 25 3 2027) EQUALS Date 1 4 2027
#ASSERT nthWD 4 (Date 22 6 2027) EQUALS Date 29 6 2027
-- A18 via s 136 posting
#ASSERT `the day a notice is deemed given, sent` (Date 2 4 2026) `, served` `by post` `, calendar` calNZ EQUALS Date 13 4 2026

-- A24-A31 application
#ASSERT `the Act applies to` (ten `none of the s 5 exclusions` FALSE)
#ASSERT NOT `the Act applies to` (ten `commercial premises` FALSE)
#ASSERT NOT `the Act applies to` (ten `holiday premises` FALSE)
#ASSERT NOT `the Act applies to` (ten `premises used principally as the residence of the landlord, owner, or their family` FALSE)
#ASSERT NOT `the Act applies to` (ten `funded emergency or transitional accommodation` FALSE)
#ASSERT `the Act applies to` (ten `holiday premises` TRUE)
#ASSERT NOT `the Act applies to` (ten `a licensed hotel` FALSE)

-- A32-A35 s 7
#ASSERT NOT `sections 25 to 28 and 51 apply to` (shortTen 90 TRUE 90)
#ASSERT `sections 25 to 28 and 51 apply to` (shortTen 91 TRUE 91)
#ASSERT `sections 25 to 28 and 51 apply to` (shortTen 60 FALSE 60)
#ASSERT `sections 25 to 28 and 51 apply to` (shortTen 60 TRUE 120)

§§ `Goal 2 — bonds and rent`

-- B01-B03 general bond
#ASSERT bondOK `a general bond` 2400 600 FALSE FALSE FALSE FALSE
#ASSERT NOT bondOK `a general bond` 2401 600 FALSE FALSE FALSE FALSE
#ASSERT bondOK `a general bond` 2200 550 FALSE FALSE FALSE FALSE
#ASSERT NOT bondOK `a general bond` 2201 550 FALSE FALSE FALSE FALSE
-- B04 further general bond
#ASSERT `the most further bond after a rent increase, kind` `a general bond` `, weekly rent from` 600 `to` 650 EQUALS 200
-- B05-B09 pet bonds
#ASSERT bondOK `a pet bond` 1200 600 TRUE TRUE FALSE FALSE
#ASSERT NOT bondOK `a pet bond` 1201 600 TRUE TRUE FALSE FALSE
#ASSERT NOT bondOK `a pet bond` 500 600 FALSE TRUE FALSE FALSE
#ASSERT NOT bondOK `a pet bond` 500 600 TRUE TRUE TRUE FALSE
#ASSERT NOT bondOK `a pet bond` 500 600 TRUE FALSE FALSE FALSE
-- B10 general and pet together (each within its own cap)
#ASSERT bondOK `a general bond` 2400 600 TRUE TRUE FALSE FALSE AND bondOK `a pet bond` 1200 600 TRUE TRUE FALSE FALSE
-- B11 credit-card imprint security; B12 guarantee is not security
#ASSERT NOT bondOK `a general bond` 1000 600 FALSE FALSE FALSE TRUE
#ASSERT bondOK `a general bond` 1000 600 FALSE FALSE FALSE FALSE

