#ASSERT NOT `the landlord may require the rent in advance` (`Rent demand` OF (1001 DIVIDED BY 500), FALSE, FALSE, FALSE)
#ASSERT NOT `the landlord may require the rent in advance` (`Rent demand` OF 3, FALSE, FALSE, FALSE)
#ASSERT NOT `the landlord may require the rent in advance` (`Rent demand` OF 1, TRUE, FALSE, FALSE)
#ASSERT NOT `the landlord may require the rent in advance` (`Rent demand` OF 1, FALSE, TRUE, FALSE)

-- B25-B28 rent increase notice periods
