#ASSERT `is a Proclamation` TRUE TRUE FALSE
-- S69b not legislation but Gazetted
#ASSERT `is a Proclamation` TRUE FALSE TRUE
-- S69c not signed by the Governor-General under the Seal
#ASSERT NOT `is a Proclamation` FALSE TRUE TRUE
-- S70 proceeding before a person acting judicially
#ASSERT `is a proceeding` TRUE FALSE
-- S71 proceeding of a body performing administrative or investigative functions
#ASSERT `is a proceeding` FALSE TRUE
-- S71b neither
#ASSERT NOT `is a proceeding` FALSE FALSE
-- S72 writing: words in a visible and tangible form
#ASSERT `is writing` TRUE `in print` EQUALS JUST TRUE
-- RECONCILED S72: reviewer wrote `#ASSERT `is writing` TRUE TRUE TRUE` against the three-BOOLEAN signature; the encoder's second pass changed `is writing` and its seat question to take the s 13 form and medium as a choice and to return a MAYBE BOOLEAN, so the call is restated for the same case; the case is words in print (visible and tangible) and the answer is unchanged.
-- S72b not words
#ASSERT `is writing` FALSE `in print` EQUALS JUST FALSE
-- RECONCILED S72b: reviewer wrote `#ASSERT NOT `is writing` FALSE TRUE TRUE` against the three-BOOLEAN signature; the encoder's second pass changed `is writing` and its seat question to take the s 13 form and medium as a choice and to return a MAYBE BOOLEAN, so the call is restated for the same case; the case is not words at all and the answer is unchanged.
-- S72c not tangible (e.g. on screen only): not writing by the s 13 words
#ASSERT `is writing` TRUE `shown only on a screen` EQUALS NOTHING
-- RECONCILED S72c: reviewer wrote `#ASSERT NOT `is writing` TRUE TRUE FALSE` against the three-BOOLEAN signature; the encoder's second pass changed `is writing` and its seat question to take the s 13 form and medium as a choice and to return a MAYBE BOOLEAN, so the call is restated for the same case; the reviewer had also recorded scenario 73 as a gap, because the text says writing is a visible and tangible form and medium and does not say whether a screen is tangible; the second-pass answer NOTHING (not covered) is the answer scenario 73 asked for, so the assertion now says that instead of "not writing".
-- S75 secondary legislation: made under an Act that states it is secondary legislation
#ASSERT `is secondary legislation` (Instrument OF TRUE, TRUE, FALSE, FALSE)
-- S76 made under an Act but nothing states it is secondary legislation
#ASSERT NOT `is secondary legislation` (Instrument OF TRUE, FALSE, FALSE, FALSE)
-- S77 prerogative in a Schedule 1A form
#ASSERT `is secondary legislation` (Instrument OF FALSE, FALSE, TRUE, TRUE)
-- S77b prerogative not in a Schedule 1A form
#ASSERT NOT `is secondary legislation` (Instrument OF FALSE, FALSE, TRUE, FALSE)
-- S78 an administrative document is an instrument but not legislation
#ASSERT `is an instrument` `an instrument that is not legislation` EQUALS JUST TRUE
#ASSERT NOT `is legislation` `an instrument that is not legislation`
-- S79 part of an Act, and secondary legislation, are legislation
#ASSERT `is legislation` `an Act`
#ASSERT `is legislation` `secondary legislation`
-- S81 maker: if the Governor-General is empowered, the relevant Minister
#ASSERT `who is the maker of the secondary legislation or instrument` TRUE EQUALS `the relevant Minister`
#ASSERT `who is the maker of the secondary legislation or instrument` FALSE EQUALS `the person empowered to make it`
-- S82 sitting day is defined by the Act
#ASSERT NOT `is silent` (`what the Act says of` `a sitting day`)
-- S83 the four exclusions from disallowance, one by one (s 115)
#ASSERT `the disallowance subpart applies to the secondary legislation` FALSE FALSE FALSE FALSE
#ASSERT NOT `the disallowance subpart applies to the secondary legislation` TRUE FALSE FALSE FALSE
#ASSERT NOT `the disallowance subpart applies to the secondary legislation` FALSE TRUE FALSE FALSE
#ASSERT NOT `the disallowance subpart applies to the secondary legislation` FALSE FALSE TRUE FALSE
#ASSERT NOT `the disallowance subpart applies to the secondary legislation` FALSE FALSE FALSE TRUE

§ `B. Meaning and construction (ss 9-23)`

-- S84 s9(1): the legislation provides otherwise
#ASSERT NOT `a provision of Part 2 applies to the legislation` TRUE TRUE FALSE
-- S85 the context requires a different interpretation
#ASSERT NOT `a provision of Part 2 applies to the legislation` TRUE FALSE TRUE
-- S85b the ordinary case, and legislation that is not part of the laws of New Zealand
#ASSERT `a provision of Part 2 applies to the legislation` TRUE FALSE FALSE
#ASSERT NOT `a provision of Part 2 applies to the legislation` FALSE FALSE FALSE
-- S86 s9(2) Part 2 also applies to the interpretation of this Act
#ASSERT `Part 2 is applied to the interpretation of` TRUE
-- S87 s10(1) meaning is ascertained from text, purpose and context
#ASSERT `the meaning of legislation must be ascertained from` `the text of the legislation`
#ASSERT `the meaning of legislation must be ascertained from` `the purpose of the legislation`
#ASSERT `the meaning of legislation must be ascertained from` `the context of the legislation`
-- S88 s10(2) whether or not the purpose is stated
#ASSERT `the purpose is used to ascertain the meaning` FALSE
-- S89 s10(3)-(4) each indication provided in the legislation is part of the text
#ASSERT `an indication is part of the text of the legislation` `a preamble` TRUE
#ASSERT `an indication is part of the text of the legislation` `a table of contents` TRUE
#ASSERT `an indication is part of the text of the legislation` `a heading` TRUE
#ASSERT `an indication is part of the text of the legislation` `a diagram` TRUE
#ASSERT `an indication is part of the text of the legislation` `a graphic` TRUE
#ASSERT `an indication is part of the text of the legislation` `an example` TRUE
#ASSERT `an indication is part of the text of the legislation` `explanatory material` TRUE
#ASSERT `an indication is part of the text of the legislation` `the organisation and format of the legislation` TRUE
-- S89b s10(3): any other indication provided in the legislation (the list is of examples), and one not provided in it
#ASSERT `an indication is part of the text of the legislation` `another indication` TRUE
#ASSERT NOT `an indication is part of the text of the legislation` `a heading` FALSE
