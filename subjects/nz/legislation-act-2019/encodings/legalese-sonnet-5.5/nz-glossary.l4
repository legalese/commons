       , (`the entry for details in section 77`)
       , (`the entry for international transparency obligations in section 77`)
       , (`the entry for links in section 77`)
       , (`the entry for maker's website in section 77`)
       , (`the entry for relevant central government entity in section 77`)
       , (`the entry for current drafting practice in section 85`)
       , (`the entry for referential words in section 85`)
       , (`the entry for revision Bill in section 94`)
       , (`the entry for revision programme in section 94`)
       , (`the entry for Consumers Price Index in section 96(4)`)
       , (`the entry for deadline in section 121`)
       , (`the entry for unconfirmed legislation in section 121`)
       , (`the entry for client in section 131(3)`)
       , (`the entry for confidential communications in section 131(3)`)
       , (`the entry for counsel in section 131(3)`)
       , (`the entry for union in section 141(2)`)
       , (`the entry for discretionary publication request in section 147(6)`)
       , (`the entry for list deadline in Schedule 1 clause 2`)
       , (`the entry for list exemption in Schedule 1 clause 2`)
       , (`the entry for main commencement date in Schedule 1 clause 2`)
       , (`the entry for publication commencement date in Schedule 1 clause 2`)
       , (`the entry for publication exemption in Schedule 1 clause 2`)
       , (`the entry for publication deadline in Schedule 1 clause 2`)
