-- s 14(1): two adults living together as a couple
#ASSERT `Are my partner and I in a de facto relationship under the Act` 30 31 TRUE FALSE TRUE EQUALS TRUE
-- s 14(2): a person aged 16 without consent
#ASSERT `Are my partner and I in a de facto relationship under the Act` 16 30 TRUE FALSE FALSE EQUALS FALSE
-- s 14(2): the consent is obtained
#ASSERT `Are my partner and I in a de facto relationship under the Act` 16 30 TRUE FALSE TRUE EQUALS TRUE
-- s 14(1)(c): under 16
#ASSERT `Are my partner and I in a de facto relationship under the Act` 15 30 TRUE FALSE TRUE EQUALS FALSE
-- s 14(1)(b): married to each other
#ASSERT `Are my partner and I in a de facto relationship under the Act` 30 31 TRUE TRUE TRUE EQUALS FALSE

§ `Is my posted document taken to have been sent`

-- s 17(2): properly addressed, prepaid and posted
#ASSERT `Is my posted document taken to have been sent` TRUE TRUE TRUE TRUE FALSE FALSE (Date 9 3 2026) EQUALS `Taken to have been sent`
-- s 17(2): not properly addressed
#ASSERT `Is my posted document taken to have been sent` TRUE FALSE TRUE TRUE FALSE FALSE (Date 9 3 2026) EQUALS `Not taken to have been sent by section 17`
-- s 17(4): the contrary is proved
#ASSERT `Is my posted document taken to have been sent` TRUE TRUE TRUE TRUE TRUE FALSE (Date 9 3 2026) EQUALS `Not taken to have been sent by section 17`

§ `On what day is my posted document taken to have been received`

-- s 17(3): at the time it would be delivered in the ordinary course of post
#ASSERT `On what day is my posted document taken to have been received` TRUE TRUE TRUE TRUE FALSE FALSE (Date 9 3 2026) EQUALS JUST (Date 9 3 2026)
-- s 17(4): the contrary to receipt is proved; the section says nothing then
#ASSERT `On what day is my posted document taken to have been received` TRUE TRUE TRUE TRUE FALSE TRUE (Date 9 3 2026) EQUALS NOTHING
-- s 17(1): the legislation does not authorise or require post
#ASSERT `On what day is my posted document taken to have been received` FALSE TRUE TRUE TRUE FALSE FALSE (Date 9 3 2026) EQUALS NOTHING

§ `Is the Crown bound by this Act or part of an Act`

-- s 22(1)
#ASSERT `Is the Crown bound by this Act or part of an Act` TRUE EQUALS TRUE
-- s 22(1)
#ASSERT `Is the Crown bound by this Act or part of an Act` FALSE EQUALS FALSE

§ `Does an example in the legislation limit the provision it illustrates`

-- Schedule 1 cl 4: s 23 does not apply to an example in pre-commencement legislation; the text says nothing then
#ASSERT `Does an example in the legislation limit the provision it illustrates` (Date 31 12 2020) (Date 1 1 2021) FALSE FALSE FALSE EQUALS NOTHING
-- s 23: an example does not limit the provision
#ASSERT `Does an example in the legislation limit the provision it illustrates` (Date 2 1 2021) (Date 1 1 2021) FALSE FALSE FALSE EQUALS JUST FALSE
-- Schedule 1 cl 4(2): the legislation provides otherwise, so s 23 applies
#ASSERT `Does an example in the legislation limit the provision it illustrates` (Date 31 12 2020) (Date 1 1 2021) FALSE TRUE FALSE EQUALS JUST FALSE

§ `On what day does the Act or my part of it come into force`

-- s 25(1): the date stated
#ASSERT `On what day does the Act or my part of it come into force` `an ordinary provision` TRUE (Date 1 9 2026) (Date 3 3 2026) EQUALS (Date 1 9 2026)
-- s 25(2): the day after Royal assent
#ASSERT `On what day does the Act or my part of it come into force` `an ordinary provision` FALSE (Date 1 1 2000) (Date 3 3 2026) EQUALS (Date 4 3 2026)
-- s 25(3): the Title on Royal assent
#ASSERT `On what day does the Act or my part of it come into force` `the Title` FALSE (Date 1 1 2000) (Date 3 3 2026) EQUALS (Date 3 3 2026)

§ `Does a reference in the commencement section reach the provision I am looking at`

-- s 25(3): no reference in the commencement section includes the Title
#ASSERT `Does a reference in the commencement section reach the provision I am looking at` `the Title` EQUALS JUST FALSE
-- s 25(3): nor a commencement section
#ASSERT `Does a reference in the commencement section reach the provision I am looking at` `a commencement section` EQUALS JUST FALSE
-- s 25(3): nor a principal legislation provision
#ASSERT `Does a reference in the commencement section reach the provision I am looking at` `a principal legislation provision` EQUALS JUST FALSE
-- s 25(3): says nothing about an ordinary provision
#ASSERT `Does a reference in the commencement section reach the provision I am looking at` `an ordinary provision` EQUALS NOTHING

§ `On what day does the secondary legislation or my part of it come into force`

-- s 26(1): the date stated
#ASSERT `On what day does the secondary legislation or my part of it come into force` `an ordinary provision` TRUE (Date 1 9 2026) (Date 3 3 2026) FALSE (Date 1 1 2000) EQUALS JUST (Date 1 9 2026)
-- s 26(2): the day after it is published
#ASSERT `On what day does the secondary legislation or my part of it come into force` `an ordinary provision` FALSE (Date 1 1 2000) (Date 3 3 2026) TRUE (Date 10 3 2026) EQUALS JUST (Date 11 3 2026)
-- s 26(2): not yet published, so no day can be worked out
#ASSERT `On what day does the secondary legislation or my part of it come into force` `an ordinary provision` FALSE (Date 1 1 2000) (Date 3 3 2026) FALSE (Date 1 1 2000) EQUALS NOTHING
-- s 26(3): the commencement provisions on its making, even if not yet published
#ASSERT `On what day does the secondary legislation or my part of it come into force` `a commencement section` FALSE (Date 1 1 2000) (Date 3 3 2026) FALSE (Date 1 1 2000) EQUALS JUST (Date 3 3 2026)

§ `At what moment does the legislation come into force`

-- s 27(a): the start of the day
#ASSERT `At what moment does the legislation come into force` (Date 1 7 2026) FALSE FALSE 0 0 EQUALS JUST (`the start of the day` (Date 1 7 2026))
-- s 27(b): from a day, the start of the next day
#ASSERT `At what moment does the legislation come into force` (Date 1 7 2026) TRUE FALSE 0 0 EQUALS JUST (`the start of the day` (Date 2 7 2026))
-- s 27(c): a stated time
#ASSERT `At what moment does the legislation come into force` (Date 1 7 2026) FALSE TRUE 14 30 EQUALS JUST (`a time on the day` (Date 1 7 2026) 14 30)
-- s 27(b) and (c) both: the text does not say which wins
#ASSERT `At what moment does the legislation come into force` (Date 1 7 2026) TRUE TRUE 14 30 EQUALS NOTHING

