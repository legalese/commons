IMPORT prelude
IMPORT daydate
IMPORT `nz-interpretation-time`
IMPORT `nz-part2-principles`
IMPORT `nz-nouns`
IMPORT `nz-part2-definitions`
IMPORT `nz-seat`

-- Legislation Act 2019 (New Zealand) -- WORKED CASES for the seat layer (nz-seat.l4): at least one for every question.
-- Every expected value was decided by reading the section cited beside the case BEFORE the case was run; none was copied from the encoding's output.
-- Calendars are supplied (the Act does not date its seven named days): for 2026 Waitangi Day Fri 6 Feb, Good Friday Fri 3 Apr, Easter Monday 6 Apr, Anzac Day Sat 25 Apr,
-- the Sovereign's birthday Mon 1 Jun, Matariki Fri 10 Jul, Labour Day Mon 26 Oct; for 2024 Tue 6 Feb, Fri 29 Mar, Mon 1 Apr, Thu 25 Apr, Mon 3 Jun, Fri 28 Jun, Mon 28 Oct.
-- 5 January 2026 is a Monday (checked on a printed calendar), so 31 January 2026 is a Saturday and 28 February 2026 is a Saturday; 29 February 2024 is a Thursday.


§ `Is this instrument secondary legislation`

-- s 5(1) limb (a): the ABC Act example, lines 78-79
#ASSERT `Is this instrument secondary legislation` TRUE TRUE FALSE FALSE EQUALS TRUE
-- s 5(1) limb (b): Royal prerogative in a Schedule 1A form
#ASSERT `Is this instrument secondary legislation` FALSE FALSE TRUE TRUE EQUALS TRUE
-- s 5(1)(a): the Act does not say so
#ASSERT `Is this instrument secondary legislation` TRUE FALSE FALSE FALSE EQUALS FALSE

§ `Do the Act's rules of reading apply to the legislation I am reading`

-- s 9(1): a New Zealand law, nothing displacing the rules
#ASSERT `Do the Act's rules of reading apply to the legislation I am reading` TRUE FALSE FALSE EQUALS TRUE
-- s 9(1)(a): the legislation provides otherwise
#ASSERT `Do the Act's rules of reading apply to the legislation I am reading` TRUE TRUE FALSE EQUALS FALSE
-- s 9(1)(b): the context requires a different reading
#ASSERT `Do the Act's rules of reading apply to the legislation I am reading` TRUE FALSE TRUE EQUALS FALSE
-- s 9(1): not part of the laws of New Zealand
#ASSERT `Do the Act's rules of reading apply to the legislation I am reading` FALSE FALSE FALSE EQUALS FALSE

§ `Does the legislation govern what happened on my day`

-- s 11: arises on the day it comes into force (start of the day, s 27)
#ASSERT `Does the legislation govern what happened on my day` (Date 1 3 2026) (Date 1 3 2026) FALSE (Date 1 1 2000) EQUALS TRUE
-- s 11: the day before it comes into force
#ASSERT `Does the legislation govern what happened on my day` (Date 28 2 2026) (Date 1 3 2026) FALSE (Date 1 1 2000) EQUALS FALSE
-- s 11 with s 39: the day before the repeal day
#ASSERT `Does the legislation govern what happened on my day` (Date 31 5 2026) (Date 1 3 2026) TRUE (Date 1 6 2026) EQUALS TRUE
-- s 39: repealed at the start of its day
#ASSERT `Does the legislation govern what happened on my day` (Date 1 6 2026) (Date 1 3 2026) TRUE (Date 1 6 2026) EQUALS FALSE

§ `Does the legislation apply to something that happened before it came into force`

-- s 12
#ASSERT `Does the legislation apply to something that happened before it came into force` (Date 28 2 2026) (Date 1 3 2026) FALSE EQUALS `The legislation does not apply: no retrospective effect`
-- s 12: the first day is not before
#ASSERT `Does the legislation apply to something that happened before it came into force` (Date 1 3 2026) (Date 1 3 2026) FALSE EQUALS `The legislation applies`
-- s 9(1)(a): the legislation provides otherwise
#ASSERT `Does the legislation apply to something that happened before it came into force` (Date 28 2 2026) (Date 1 3 2026) TRUE EQUALS `The legislation applies`

§ `Is this day a working day`

-- a Monday that is no named day
#ASSERT `Is this day a working day` (Date 2 2 2026) (Date 6 2 2026) (Date 3 4 2026) (Date 6 4 2026) (Date 25 4 2026) (Date 1 6 2026) (Date 10 7 2026) (Date 26 10 2026) EQUALS JUST TRUE
-- s 13(a): a Sunday
#ASSERT `Is this day a working day` (Date 1 2 2026) (Date 6 2 2026) (Date 3 4 2026) (Date 6 4 2026) (Date 25 4 2026) (Date 1 6 2026) (Date 10 7 2026) (Date 26 10 2026) EQUALS JUST FALSE
-- s 13(a): Waitangi Day (Friday 6 February 2026, supplied)
#ASSERT `Is this day a working day` (Date 6 2 2026) (Date 6 2 2026) (Date 3 4 2026) (Date 6 4 2026) (Date 25 4 2026) (Date 1 6 2026) (Date 10 7 2026) (Date 26 10 2026) EQUALS JUST FALSE
-- s 13(b): in the period 25 December to 2 January
#ASSERT `Is this day a working day` (Date 28 12 2026) (Date 6 2 2026) (Date 3 4 2026) (Date 6 4 2026) (Date 25 4 2026) (Date 1 6 2026) (Date 10 7 2026) (Date 26 10 2026) EQUALS JUST FALSE
-- the calendar given is for 2026; the answer for 2022 needs 2022's named days
#ASSERT `Is this day a working day` (Date 5 1 2022) (Date 6 2 2026) (Date 3 4 2026) (Date 6 4 2026) (Date 25 4 2026) (Date 1 6 2026) (Date 10 7 2026) (Date 26 10 2026) EQUALS NOTHING

§ `Does my notice count as public notification`

-- s 13(a): Gazette
#ASSERT `Does my notice count as public notification` TRUE FALSE FALSE FALSE FALSE EQUALS TRUE
-- s 13(c): an Internet site, public and free
#ASSERT `Does my notice count as public notification` FALSE FALSE TRUE TRUE TRUE EQUALS TRUE
-- s 13(c): the site is not free of charge
#ASSERT `Does my notice count as public notification` FALSE FALSE TRUE TRUE FALSE EQUALS FALSE

§ `Is what I have prepared writing under the Act`

-- s 13, writing: print is the Act's own example of a visible and tangible form and medium
#ASSERT `Is what I have prepared writing under the Act` TRUE `in print` EQUALS JUST TRUE
-- s 13, writing: words on paper are visible and tangible
#ASSERT `Is what I have prepared writing under the Act` TRUE `written or typed on paper` EQUALS JUST TRUE
-- s 13, writing: visible, but the Act does not say a screen is tangible (finding on writing)
#ASSERT `Is what I have prepared writing under the Act` TRUE `shown only on a screen` EQUALS NOTHING
-- s 13, writing: not visible
#ASSERT `Is what I have prepared writing under the Act` TRUE `spoken only, or otherwise not visible` EQUALS JUST FALSE
-- s 13, writing: nothing represented or reproduced
#ASSERT `Is what I have prepared writing under the Act` FALSE `in print` EQUALS JUST FALSE

§ `Does the Act define the word I am relying on`

-- ss 5 and 13 do not define day
#ASSERT `Does the Act define the word I am relying on` `a day` EQUALS `The Act is silent`
-- the Act does not define a week
#ASSERT `Does the Act define the word I am relying on` `a week` EQUALS `The Act is silent`
-- the Act does not define a year
#ASSERT `Does the Act define the word I am relying on` `a year` EQUALS `The Act is silent`
-- s 13: month means a calendar month (line 127)
#ASSERT `Does the Act define the word I am relying on` `a month` EQUALS `Defined by the Act` "a calendar month" "section 13"
-- s 5(1): sitting day (line 80)
#ASSERT `Does the Act define the word I am relying on` `a sitting day` EQUALS `Defined by the Act` "a sitting day of the House of Representatives" "section 5(1)"

