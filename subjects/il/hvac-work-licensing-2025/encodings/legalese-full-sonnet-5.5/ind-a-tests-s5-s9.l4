IMPORT prelude
IMPORT daydate
IMPORT domain
IMPORT `ind-a-tests-fixtures`
IMPORT `g1-application`
IMPORT `g2-validity`
IMPORT `g2-second-schedule`
IMPORT `g2-conditions`
IMPORT `g2-exemption`
IMPORT `g2-temporary-licence`
IMPORT `g2-renewal`

-- ind-a-tests-s5-s9.l4: independent tests by ind-a for ss.5 to 9 (application, conditions, exemption from
-- training chapters, validity and renewal, the foreign expert's temporary licence).  Expected values decided from
-- the sources before the encoding was opened (work/ind-a/expectations.md).

§ `s.5 application`

-- S05-01, S05-02
#ASSERT `the Registrar may require the information or document` (`Circumstances of a demand under section 5(b)` WITH `the demand is made of an applicant on a licence application` IS TRUE, `in the Registrar's opinion the information or document is needed to decide the application` IS TRUE)
#ASSERT NOT `the Registrar may require the information or document` (`Circumstances of a demand under section 5(b)` WITH `the demand is made of an applicant on a licence application` IS TRUE, `in the Registrar's opinion the information or document is needed to decide the application` IS FALSE)
-- S05-04: one who seeks to obtain, and one who seeks to renew, are both applicants; one who seeks neither is not.
#ASSERT `s 5(a) — the person is an applicant` (`Facts about a person and a licence under section 5` WITH `seeks to obtain a licence under the Law` IS FALSE, `seeks to renew a licence under the Law` IS TRUE)
#ASSERT `s 5(a) — the person is an applicant` (`Facts about a person and a licence under section 5` WITH `seeks to obtain a licence under the Law` IS TRUE, `seeks to renew a licence under the Law` IS FALSE)
#ASSERT NOT `s 5(a) — the person is an applicant` (`Facts about a person and a licence under section 5` WITH `seeks to obtain a licence under the Law` IS FALSE, `seeks to renew a licence under the Law` IS FALSE)

§ `s.6 conditions for a licence`

-- The route used to isolate conditions (1) to (3) is Second Schedule Part A item 1(2) (Ministry of Education
-- climate-control certificate of 3 study units, grade 1 sought), which asks nothing further.  Stated assumptions:
-- the programme had the Registrar's consent (s.19(b)), no foreign qualification, the fee was paid (reg.4).
GIVEN application IS AN Application
      unfit IS A BOOLEAN
GIVETH A BOOLEAN
`ind-a must grant` application unfit MEANS
    `the Registrar must grant the licence` application `ind-a commencement day` unfit FALSE TRUE FALSE TRUE

GIVEN adult IS A BOOLEAN
      citizen IS A BOOLEAN
      resident IS A BOOLEAN
      convicted IS A BOOLEAN
      charged IS A BOOLEAN
GIVETH AN Application
`ind-a grade 1 application by` adult citizen resident convicted charged MEANS
    `ind-a application`
        (`ind-a applicant in full` adult citizen resident (`ind-a record` convicted charged) EMPTY
             (LIST `a Ministry of Education climate-control certificate of 3 study units`)
             FALSE FALSE FALSE FALSE EMPTY FALSE FALSE)
        `grade 1 licence` (YMD 2026 3 1)

-- S06-01
#ASSERT `ind-a must grant` (`ind-a grade 1 application by` TRUE TRUE TRUE FALSE FALSE) FALSE
-- S06-02
#ASSERT NOT `ind-a must grant` (`ind-a grade 1 application by` FALSE TRUE TRUE FALSE FALSE) FALSE
-- S06-04, S06-05, S06-06
#ASSERT `ind-a must grant` (`ind-a grade 1 application by` TRUE FALSE TRUE FALSE FALSE) FALSE
#ASSERT `ind-a must grant` (`ind-a grade 1 application by` TRUE TRUE FALSE FALSE FALSE) FALSE
#ASSERT NOT `ind-a must grant` (`ind-a grade 1 application by` TRUE FALSE FALSE FALSE FALSE) FALSE
-- S06-07, S06-08 (the Registrar's opinion is the input)
#ASSERT NOT `ind-a must grant` (`ind-a grade 1 application by` TRUE TRUE TRUE TRUE FALSE) TRUE
#ASSERT `ind-a must grant` (`ind-a grade 1 application by` TRUE TRUE TRUE TRUE FALSE) FALSE
-- S06-09, S06-10
#ASSERT NOT `ind-a must grant` (`ind-a grade 1 application by` TRUE TRUE TRUE FALSE TRUE) TRUE
#ASSERT `ind-a must grant` (`ind-a grade 1 application by` TRUE TRUE TRUE FALSE TRUE) FALSE
-- S06-11: no route of the Second Schedule met (nothing held, no training done).
#ASSERT NOT `ind-a must grant` (`ind-a application` (`ind-a applicant holding` EMPTY) `grade 1 licence` (YMD 2026 3 1)) FALSE

§ `s.7 exemptions from training chapters`

GIVEN electrician IS A BOOLEAN
      height IS A BOOLEAN
GIVETH AN Applicant
`ind-a trainee with` electrician height MEANS
    `ind-a applicant in full` TRUE TRUE TRUE (`ind-a record` FALSE FALSE) EMPTY EMPTY FALSE FALSE FALSE FALSE EMPTY electrician height

-- S07-01: valid electricity licence of a kind in reg.7 paras (1)-(7): the electricity chapter exemption stands.
#ASSERT `s 7 — the chapters of the training the applicant is exempt from` (`ind-a trainee with` TRUE FALSE) TRUE FALSE EQUALS LIST `the electricity chapter`
-- S07-02, S07-03: no valid licence of a listed kind: no exemption.
#ASSERT `s 7 — the chapters of the training the applicant is exempt from` (`ind-a trainee with` FALSE FALSE) TRUE FALSE EQUALS EMPTY
-- S07-04, S07-05
#ASSERT `s 7 — the chapters of the training the applicant is exempt from` (`ind-a trainee with` FALSE TRUE) FALSE TRUE EQUALS LIST `the working-at-height chapter`
#ASSERT `s 7 — the chapters of the training the applicant is exempt from` (`ind-a trainee with` FALSE FALSE) FALSE TRUE EQUALS EMPTY
-- S07-06: an electrician licence does not ground a height exemption.
#ASSERT `s 7 — the chapters of the training the applicant is exempt from` (`ind-a trainee with` TRUE FALSE) FALSE TRUE EQUALS EMPTY

§ `s.8 validity and renewal`

-- S08-01..07 (reading R5: the fifth year from the year of grant is the year of grant plus five)
#ASSERT `s 8 — the last day of the validity period beginning on` (YMD 2025 1 15) EQUALS YMD 2030 1 15
#ASSERT `s 8 — the last day of the validity period beginning on` (YMD 2025 9 1) EQUALS YMD 2030 3 31
#ASSERT `s 8 — the last day of the validity period beginning on` (YMD 2025 3 31) EQUALS YMD 2030 3 31
#ASSERT `s 8 — the last day of the validity period beginning on` (YMD 2025 4 1) EQUALS YMD 2030 3 31
#ASSERT `s 8 — the last day of the validity period beginning on` (YMD 2024 2 29) EQUALS YMD 2029 2 28
#ASSERT `s 8 — the last day of the validity period beginning on` (YMD 2025 7 16) EQUALS YMD 2030 3 31
#ASSERT `s 8 — the last day of the validity period beginning on` (YMD 2025 1 1) EQUALS YMD 2030 1 1
#ASSERT `the licence is in force on` (`ind-a plain licence` (YMD 2025 7 16) `grade 1 licence`) (YMD 2030 3 31)
#ASSERT NOT `the licence is in force on` (`ind-a plain licence` (YMD 2025 7 16) `grade 1 licence`) (YMD 2030 4 1)
-- S08-08, S08-09: validity is not moved by a rest day (no IL s.10(c) for a period of validity).
#ASSERT `s 8 — the last day of the validity period beginning on` (YMD 2026 2 1) EQUALS YMD 2031 2 1
#ASSERT NOT `the licence is in force on` (`ind-a plain licence` (YMD 2026 2 1) `grade 2 licence`) (YMD 2031 2 2)
#ASSERT `s 8 — the last day of the validity period beginning on` (YMD 2024 6 1) EQUALS YMD 2029 3 31
#ASSERT NOT `the licence is in force on` (`ind-a plain licence` (YMD 2024 6 1) `grade 2 licence`) (YMD 2029 4 1)
-- S08-10: in force on the day of grant.
#ASSERT `the licence is in force on` (`ind-a plain licence` (YMD 2025 7 16) `grade 1 licence`) (YMD 2025 7 16)
-- S08-11..13: renewal needs s.6 except (a)(4).
#ASSERT `s 8 — the licence can be renewed for the applicant` (`ind-a application` (`ind-a applicant holding` EMPTY) `grade 2 licence` (YMD 2030 3 1)) FALSE
#ASSERT NOT `s 8 — the licence can be renewed for the applicant` (`ind-a application` (`ind-a applicant in full` TRUE FALSE FALSE (`ind-a record` FALSE FALSE) EMPTY EMPTY FALSE FALSE FALSE FALSE EMPTY FALSE FALSE) `grade 2 licence` (YMD 2030 3 1)) FALSE
#ASSERT NOT `s 8 — the licence can be renewed for the applicant` (`ind-a application` (`ind-a applicant in full` TRUE TRUE TRUE (`ind-a record` TRUE FALSE) EMPTY EMPTY FALSE FALSE FALSE FALSE EMPTY FALSE FALSE) `grade 2 licence` (YMD 2030 3 1)) TRUE

§ `s.9 temporary licence for a foreign expert`

GIVEN day IS A DATE
      similar IS A BOOLEAN
GIVETH A `Work done abroad by a foreign expert under section 9`
`ind-a work abroad on` day similar MEANS
    `Work done abroad by a foreign expert under section 9` WITH
        `the work` IS (`Work item` WITH
                         `performed by` IS `ind-a other person`
                         `the kind of job` IS `an installation job`
                         `the system` IS (`Cooling system` WITH `cooling capacity in kilowatts` IS 300, `refrigerants` IS EMPTY)
                         `date performed` IS day)
        `on a system similar to the systems the expert was invited to work on` IS similar

-- The foreign expert: not of full age and neither citizen nor resident (s.9 displaces s.6), applying 2026-06-01.
GIVEN foreign IS A BOOLEAN
      kw IS A NUMBER
      authorised IS A BOOLEAN
      `last similar work` IS A DATE
GIVETH A `Foreign expert's application under section 9`
`ind-a expert` foreign kw authorised `last similar work` MEANS
    `Foreign expert's application under section 9` WITH
        `the application` IS `ind-a application` (`ind-a applicant in full` FALSE FALSE FALSE (`ind-a record` FALSE FALSE) EMPTY EMPTY FALSE FALSE FALSE FALSE EMPTY FALSE FALSE) `grade 3 licence` (YMD 2026 6 1)
        `the applicant comes from a foreign state` IS foreign
        `the system the expert was invited to work on` IS (`Cooling system` WITH `cooling capacity in kilowatts` IS kw, `refrigerants` IS EMPTY)
        `authorised to do such work in a foreign state` IS authorised
        `work done abroad` IS LIST `ind-a work abroad on` `last similar work` TRUE

-- S09-01, S09-08 (base; fee paid as a stated assumption)
#ASSERT `the temporary licence may be granted` (`ind-a expert` TRUE 100 TRUE (YMD 2024 6 1)) TRUE TRUE
-- S09-02, S09-03
#ASSERT NOT `the temporary licence may be granted` (`ind-a expert` TRUE 70 TRUE (YMD 2024 6 1)) TRUE TRUE
#ASSERT `the temporary licence may be granted` (`ind-a expert` TRUE 70.01 TRUE (YMD 2024 6 1)) TRUE TRUE
-- S09-04, S09-05
#ASSERT NOT `the temporary licence may be granted` (`ind-a expert` TRUE 100 TRUE (YMD 2019 6 1)) TRUE TRUE
#ASSERT `the temporary licence may be granted` (`ind-a expert` TRUE 100 TRUE (YMD 2020 7 1)) TRUE TRUE
-- S09-06, S09-07
#ASSERT NOT `the temporary licence may be granted` (`ind-a expert` TRUE 100 FALSE (YMD 2024 6 1)) TRUE TRUE
#ASSERT NOT `the temporary licence may be granted` (`ind-a expert` TRUE 100 TRUE (YMD 2024 6 1)) FALSE TRUE
-- not from a foreign state
#ASSERT NOT `the temporary licence may be granted` (`ind-a expert` FALSE 100 TRUE (YMD 2024 6 1)) TRUE TRUE
-- S09-09, S09-10, S09-11
#ASSERT `s 9(a) — the term of a temporary licence granted on` (YMD 2026 6 1) `and ending on` (YMD 2027 6 1) `does not exceed one year`
#ASSERT NOT `s 9(a) — the term of a temporary licence granted on` (YMD 2026 6 1) `and ending on` (YMD 2027 7 1) `does not exceed one year`
#ASSERT `s 9(a) — the latest last day of a temporary licence granted on` (YMD 2028 2 29) EQUALS YMD 2029 2 28
-- S09-12, S09-13: two further periods only.
#ASSERT `s 9(b) — the number of renewals still open to the temporary licence` (`ind-a licence` (YMD 2026 6 1) `grade 3 licence` TRUE (LIST YMD 2027 5 20) (JUST (YMD 2028 5 20))) EQUALS 1
#ASSERT `s 9(b) — the number of renewals still open to the temporary licence` (`ind-a licence` (YMD 2026 6 1) `grade 3 licence` TRUE (LIST YMD 2027 5 20, YMD 2028 5 15) (JUST (YMD 2029 5 15))) EQUALS 0
-- S09-14: an 18-month renewal of a term ending 2027-06-01 ends after the latest day allowed.
#ASSERT YMD 2028 12 1 GREATER THAN `s 9(b) — the latest last day of a term renewing one that ended on` (YMD 2027 6 1)
-- S09-15: a temporary licence ends on the day its own term ends, not on the s.8 day.
#ASSERT `s 8 — the last day of validity of the licence` (`ind-a licence` (YMD 2026 6 1) `grade 3 licence` TRUE EMPTY (JUST (YMD 2027 6 1))) EQUALS YMD 2027 6 1
