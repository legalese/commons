#ASSERT NOT `s 31(3) — the inspector may enter the place` (`ind-b inspector with powers` `ind-b all powers` `, on duty` TRUE `, badge visible` FALSE `, certificate signed by the Minister` TRUE `, certificate demanded` FALSE `, shown` FALSE) (`ind-b place: grounds of unlicensed work` TRUE `, grounds of engaging the unlicensed` FALSE `, a dwelling` FALSE `, court order` FALSE `, occupier consents` FALSE)

§§ `ss.33, 34 (I34-3 .. I34-7, and the definitions)`

-- A tester is an employee of a testing body authorised to test; a self-employed person engaged under s.34(b)
-- cannot be a tester, but can be an expert.
#ASSERT `s 33 def 2 — the person is a tester` (`ind-b person: employee of a testing body` TRUE `, engaged under 34(b)` FALSE `, authorised to test` TRUE `, authorised to give opinions` FALSE)
#ASSERT NOT `s 33 def 2 — the person is a tester` (`ind-b person: employee of a testing body` FALSE `, engaged under 34(b)` TRUE `, authorised to test` TRUE `, authorised to give opinions` FALSE)
#ASSERT `s 33 def 5 — the person is an expert` (`ind-b person: employee of a testing body` FALSE `, engaged under 34(b)` TRUE `, authorised to test` FALSE `, authorised to give opinions` TRUE)
-- I34-7: an expert employed by a testing body is an expert.
#ASSERT `s 33 def 5 — the person is an expert` (`ind-b person: employee of a testing body` TRUE `, engaged under 34(b)` FALSE `, authorised to test` FALSE `, authorised to give opinions` TRUE)
#ASSERT NOT `s 33 def 5 — the person is an expert` (`ind-b person: employee of a testing body` TRUE `, engaged under 34(b)` FALSE `, authorised to test` FALSE `, authorised to give opinions` FALSE)
-- I34-3: the senior inspector may rely on a tester's findings and on an expert's findings and opinion.
#ASSERT `s 34(b) — the senior inspector may rely on the material` (`Material offered to the senior inspector` WITH `kind of material` IS `findings of an auxiliary test done by a tester`, `the test` IS `ind-b an auxiliary test by` (`ind-b person: employee of a testing body` TRUE `, engaged under 34(b)` FALSE `, authorised to test` TRUE `, authorised to give opinions` FALSE), `the expert who gave the opinion` IS NOTHING, `for supervising the implementation of the Law` IS TRUE)
#ASSERT `s 34(b) — the senior inspector may rely on the material` (`Material offered to the senior inspector` WITH `kind of material` IS `an expert opinion on the results of an auxiliary test`, `the test` IS `ind-b an auxiliary test by` (`ind-b person: employee of a testing body` FALSE `, engaged under 34(b)` TRUE `, authorised to test` TRUE `, authorised to give opinions` TRUE), `the expert who gave the opinion` IS JUST (`ind-b person: employee of a testing body` FALSE `, engaged under 34(b)` TRUE `, authorised to test` TRUE `, authorised to give opinions` TRUE), `for supervising the implementation of the Law` IS TRUE)
-- Findings by someone who is neither a tester nor an expert are not material s.34(b) lets him rely on.
#ASSERT NOT `s 34(b) — the senior inspector may rely on the material` (`Material offered to the senior inspector` WITH `kind of material` IS `findings of an auxiliary test done by a tester`, `the test` IS `ind-b an auxiliary test by` (`ind-b person: employee of a testing body` TRUE `, engaged under 34(b)` FALSE `, authorised to test` FALSE `, authorised to give opinions` FALSE), `the expert who gave the opinion` IS NOTHING, `for supervising the implementation of the Law` IS TRUE)
-- I34-6: a testing body's report is signed by its manager; signed by the tester alone it is not compliant.
#ASSERT `s 34(d) — the report covers the auxiliary test and its findings and is signed by the manager` (`Report by a testing body under section 34(d)` WITH `covers an auxiliary test and its findings` IS TRUE, `signed by the manager of the testing body` IS TRUE)
#ASSERT NOT `s 34(d) — the report covers the auxiliary test and its findings and is signed by the manager` (`Report by a testing body under section 34(d)` WITH `covers an auxiliary test and its findings` IS TRUE, `signed by the manager of the testing body` IS FALSE)
-- I34-7: an expert's report and opinion, signed by the expert; the duty reaches an expert employed by a testing body.
#ASSERT `s 34(e) — the report covers the auxiliary test, gives the opinion on its results and is signed by the expert` (`Report by an expert under section 34(e)` WITH `covers an auxiliary test` IS TRUE, `gives the expert's opinion on the results` IS TRUE, `signed by the expert` IS TRUE)
#ASSERT NOT `s 34(e) — the report covers the auxiliary test, gives the opinion on its results and is signed by the expert` (`Report by an expert under section 34(e)` WITH `covers an auxiliary test` IS TRUE, `gives the expert's opinion on the results` IS FALSE, `signed by the expert` IS TRUE)
#ASSERT `s 34(e) — the expert is engaged in accordance with section 34(c) or employed by a testing body` (`Position of an expert under section 34(e)` WITH `engaged in accordance with the Mandatory Tenders Law` IS FALSE, `employed by a testing body` IS TRUE)

§§ `s.35 (I35-1 .. I35-9)`

#ASSERT `s 35 — the corporation may serve as a testing body` (`ind-b corporation: incorporated in Israel` TRUE `, registered in Israel` TRUE `, one officer` `ind-b a clean officer` `, staffing proved` TRUE `, tender conditions` NOTHING)
#ASSERT NOT `s 35 — the corporation may serve as a testing body` (`ind-b corporation: incorporated in Israel` FALSE `, registered in Israel` TRUE `, one officer` `ind-b a clean officer` `, staffing proved` TRUE `, tender conditions` NOTHING)
#ASSERT NOT `s 35 — the corporation may serve as a testing body` (`ind-b corporation: incorporated in Israel` TRUE `, registered in Israel` TRUE `, one officer` (`ind-b connected person: standing` (`ind-b standing: convicted` FALSE `, the conviction unfitting` FALSE `, charged` TRUE `, the charge unfitting` TRUE) `, may be in conflict` FALSE) `, staffing proved` TRUE `, tender conditions` NOTHING)
#ASSERT NOT `s 35 — the corporation may serve as a testing body` (`ind-b corporation: incorporated in Israel` TRUE `, registered in Israel` TRUE `, one officer` (`ind-b connected person: standing` (`ind-b standing: convicted` TRUE `, the conviction unfitting` TRUE `, charged` FALSE `, the charge unfitting` FALSE) `, may be in conflict` FALSE) `, staffing proved` TRUE `, tender conditions` NOTHING)
#ASSERT `s 35 — the corporation may serve as a testing body` (`ind-b corporation: incorporated in Israel` TRUE `, registered in Israel` TRUE `, one officer` (`ind-b connected person: standing` (`ind-b standing: convicted` TRUE `, the conviction unfitting` FALSE `, charged` FALSE `, the charge unfitting` FALSE) `, may be in conflict` FALSE) `, staffing proved` TRUE `, tender conditions` NOTHING)
#ASSERT NOT `s 35 — the corporation may serve as a testing body` (`ind-b corporation: incorporated in Israel` TRUE `, registered in Israel` TRUE `, one officer` `ind-b a clean officer` `, staffing proved` FALSE `, tender conditions` NOTHING)
#ASSERT NOT `s 35 — the corporation may serve as a testing body` (`ind-b corporation: incorporated in Israel` TRUE `, registered in Israel` TRUE `, one officer` (`ind-b connected person: standing` `ind-b clean standing` `, may be in conflict` TRUE) `, staffing proved` TRUE `, tender conditions` NOTHING)
#ASSERT NOT `s 35 — the corporation may serve as a testing body` (`ind-b corporation: incorporated in Israel` TRUE `, registered in Israel` TRUE `, one officer` `ind-b a clean officer` `, staffing proved` TRUE `, tender conditions` (JUST FALSE))
#ASSERT `s 35 — the corporation may serve as a testing body` (`ind-b corporation: incorporated in Israel` TRUE `, registered in Israel` TRUE `, one officer` `ind-b a clean officer` `, staffing proved` TRUE `, tender conditions` (JUST TRUE))

§§ `s.36 (I36-1 .. I36-9)`

#ASSERT `s 36 — the person may be authorised as a tester or an expert` (`ind-b person to authorise: standing` `ind-b clean standing` `, may be in conflict` FALSE `, meets the regulations` (JUST TRUE) `, found unfit` FALSE `, reasons given` FALSE `, hearing given` FALSE `, refused` FALSE)
#ASSERT `s 36 — the Minister must authorise the person as a tester or an expert` (`ind-b person to authorise: standing` `ind-b clean standing` `, may be in conflict` FALSE `, meets the regulations` (JUST TRUE) `, found unfit` FALSE `, reasons given` FALSE `, hearing given` FALSE `, refused` FALSE)
-- I36-2: a criminal proceeding pending, no conviction: barred (contrast s.30(b)(1)).
#ASSERT `s 36(b) — the person is barred from authorisation` (`ind-b person to authorise: standing` (`ind-b standing: convicted` FALSE `, the conviction unfitting` FALSE `, charged` TRUE `, the charge unfitting` TRUE) `, may be in conflict` FALSE `, meets the regulations` (JUST TRUE) `, found unfit` FALSE `, reasons given` FALSE `, hearing given` FALSE `, refused` FALSE)
#ASSERT NOT `s 36 — the person may be authorised as a tester or an expert` (`ind-b person to authorise: standing` (`ind-b standing: convicted` FALSE `, the conviction unfitting` FALSE `, charged` TRUE `, the charge unfitting` TRUE) `, may be in conflict` FALSE `, meets the regulations` (JUST TRUE) `, found unfit` FALSE `, reasons given` FALSE `, hearing given` FALSE `, refused` FALSE)
