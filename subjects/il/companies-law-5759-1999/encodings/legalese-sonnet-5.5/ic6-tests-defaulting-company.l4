IMPORT prelude
IMPORT daydate
IMPORT `ic-core`
IMPORT `ic6-common`
IMPORT `ic6-defaulting-company`
IMPORT `ic6-tests-fixtures`

-- Tests of ic6-defaulting-company.l4 (section 362א). Expected values are written by hand from the section; none is copied from the rules' output.

§ `בדיקות – חלק 9 פרק 4 סימן ג: חברה מפרה`

§§ `סעיף 362א(א)`

-- Any company or foreign company that did not pay a fee: the Registrar may start (a public company too; a foreign company too).
#ASSERT `סעיף 362א(א) - הרשם רשאי לפתוח בהליך לרישום החברה כחברה מפרה` `בדיקה ic6 - תאגיד שהוא חברה פרטית רגילה` TRUE FALSE
#ASSERT `סעיף 362א(א) - הרשם רשאי לפתוח בהליך לרישום החברה כחברה מפרה` `בדיקה ic6 - תאגיד שהוא חברה ציבורית` TRUE FALSE
#ASSERT `סעיף 362א(א) - הרשם רשאי לפתוח בהליך לרישום החברה כחברה מפרה` `בדיקה ic6 - חברת חוץ` TRUE FALSE
-- A partnership formed abroad is neither a company nor a foreign company: not covered.
#ASSERT NOT (`סעיף 362א(א) - הרשם רשאי לפתוח בהליך לרישום החברה כחברה מפרה` `בדיקה ic6 - שותפות שהוקמה מחוץ לישראל` TRUE FALSE)
-- The annual report: a private company that is not reporting, or a foreign company that is not reporting: yes; a public (reporting) company: no; a private company that is a reporting corporation: no.
#ASSERT `סעיף 362א(א) - הרשם רשאי לפתוח בהליך לרישום החברה כחברה מפרה` `בדיקה ic6 - תאגיד שהוא חברה פרטית רגילה` FALSE TRUE
#ASSERT `סעיף 362א(א) - הרשם רשאי לפתוח בהליך לרישום החברה כחברה מפרה` `בדיקה ic6 - חברת חוץ` FALSE TRUE
#ASSERT NOT (`סעיף 362א(א) - הרשם רשאי לפתוח בהליך לרישום החברה כחברה מפרה` `בדיקה ic6 - תאגיד שהוא חברה ציבורית` FALSE TRUE)
#ASSERT NOT (`סעיף 362א(א) - הרשם רשאי לפתוח בהליך לרישום החברה כחברה מפרה` `בדיקה ic6 - תאגיד שהוא חברה פרטית שהיא חברת איגרות חוב` FALSE TRUE)
-- No reasonable basis for either: no.
#ASSERT NOT (`סעיף 362א(א) - הרשם רשאי לפתוח בהליך לרישום החברה כחברה מפרה` `בדיקה ic6 - תאגיד שהוא חברה פרטית רגילה` FALSE FALSE)

§§ `סעיף 362א(ב)`

#ASSERT `סעיף 362א(ב) - ההתראה נרשמה ונשלחה כנדרש` TRUE TRUE
#ASSERT NOT (`סעיף 362א(ב) - ההתראה נרשמה ונשלחה כנדרש` TRUE FALSE)
#ASSERT NOT (`סעיף 362א(ב) - ההתראה נרשמה ונשלחה כנדרש` FALSE TRUE)
-- Warning entered on 1 January 2026: 30 days end on 31 January; the company is entered from 1 February if it has not corrected the violation.
#ASSERT NOT (`סעיף 362א(ב) - החברה תירשם כחברה מפרה` TRUE (YearMonthDay 2026 1 1) FALSE (YearMonthDay 2026 1 31))
#ASSERT `סעיף 362א(ב) - החברה תירשם כחברה מפרה` TRUE (YearMonthDay 2026 1 1) FALSE (YearMonthDay 2026 2 1)
#ASSERT NOT (`סעיף 362א(ב) - החברה תירשם כחברה מפרה` TRUE (YearMonthDay 2026 1 1) TRUE (YearMonthDay 2026 2 1))
#ASSERT NOT (`סעיף 362א(ב) - החברה תירשם כחברה מפרה` FALSE (YearMonthDay 2026 1 1) FALSE (YearMonthDay 2026 2 1))

§§ `סעיף 362א(ג)`

-- The controlling shareholder: registered at 50 percent or more at the time of the warning, or when the application to register a company is filed.
#ASSERT `סעיף 362א(ג)(1)(ג) - בעל שליטה לעניין סעיף 362א` (50%) (10%)
#ASSERT `סעיף 362א(ג)(1)(ג) - בעל שליטה לעניין סעיף 362א` (10%) (50%)
#ASSERT NOT (`סעיף 362א(ג)(1)(ג) - בעל שליטה לעניין סעיף 362א` (49%) (49%))
#ASSERT `סעיף 362א(ג)(1)(ג) - בעל שליטה לעניין סעיף 362א` (70%) (0%)
-- What the Registrar may refuse for a company entered as defaulting.
#ASSERT `סעיף 362א(ג) - הרשם רשאי לסרב לרשום או לבצע` TRUE FALSE `רישום פעולה מהפעולות שבסעיף 40 לגבי החברה המפרה`
#ASSERT `סעיף 362א(ג) - הרשם רשאי לסרב לרשום או לבצע` TRUE FALSE `רישום, שינוי או ביטול של שעבוד על נכסי החברה המפרה או לטובתה`
#ASSERT `סעיף 362א(ג) - הרשם רשאי לסרב לרשום או לבצע` TRUE FALSE `רישום חברה שבעל מניות בה הוא החברה המפרה`
#ASSERT `סעיף 362א(ג) - הרשם רשאי לסרב לרשום או לבצע` TRUE FALSE `רישום חברה שבעל מניות בה הוא בעל שליטה בחברה המפרה`
#ASSERT `סעיף 362א(ג) - הרשם רשאי לסרב לרשום או לבצע` TRUE FALSE `רישום חברה שבעל מניות בה הוא דירקטור בחברה המפרה שלא שילם עיצום כספי שנדרש לשלמו לפי סעיף 360`
#ASSERT `סעיף 362א(ג) - הרשם רשאי לסרב לרשום או לבצע` TRUE FALSE `ביצוע הפעולות שבסעיף 323(3) עד (5) כשאחת מהחברות המתמזגות היא חברה מפרה`
#ASSERT `סעיף 362א(ג) - הרשם רשאי לסרב לרשום או לבצע` TRUE FALSE `רישום או שינוי רישום של משכון לטובת החברה המפרה`
-- The first refusal does not apply to a foreign company; the others do.
#ASSERT NOT (`סעיף 362א(ג) - הרשם רשאי לסרב לרשום או לבצע` TRUE TRUE `רישום פעולה מהפעולות שבסעיף 40 לגבי החברה המפרה`)
#ASSERT `סעיף 362א(ג) - הרשם רשאי לסרב לרשום או לבצע` TRUE TRUE `רישום, שינוי או ביטול של שעבוד על נכסי החברה המפרה או לטובתה`
-- A company that is only warned, not yet entered, is not within subsection (ג).
#ASSERT NOT (`סעיף 362א(ג) - הרשם רשאי לסרב לרשום או לבצע` FALSE FALSE `רישום חברה שבעל מניות בה הוא החברה המפרה`)

§§ `סעיף 362א(ד)`

-- Corrected, with no further violations notified: erased. Corrected, further violations notified and not all corrected: not erased. All corrected: erased. Not corrected: not erased.
#ASSERT `סעיף 362א(ד) - הרשם ימחק את הרישום` TRUE FALSE FALSE
#ASSERT NOT (`סעיף 362א(ד) - הרשם ימחק את הרישום` TRUE TRUE FALSE)
#ASSERT `סעיף 362א(ד) - הרשם ימחק את הרישום` TRUE TRUE TRUE
#ASSERT NOT (`סעיף 362א(ד) - הרשם ימחק את הרישום` FALSE FALSE FALSE)
