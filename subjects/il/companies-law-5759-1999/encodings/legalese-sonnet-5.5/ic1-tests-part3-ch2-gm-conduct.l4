IMPORT prelude
IMPORT `ic-core`
IMPORT `ic-core-company-kinds`
IMPORT `ic1-majorities`
IMPORT `ic1-part3-ch2-gm-conduct`

-- Tests of ic1-part3-ch2-gm-conduct.l4 (sections 76 to 91).

§ `בדיקות: חלק 3 פרק 2 סימנים ד׳ עד ט׳ – ניהול האסיפה הכללית`

§§ `מתקנים`

`בדיקות ניהול - חברה פרטית` MEANS `עובדות על חברה` WITH
    `הדין שלפיו התאגדה` IS `לפי חוק זה`
    `מניותיה רשומות למסחר בבורסה` IS FALSE
    `מניותיה הוצעו לציבור על פי תשקיף` IS FALSE
    `מניותיה הוצעו לציבור מחוץ לישראל על פי מסמך הצעה לציבור` IS FALSE
    `מניותיה מוחזקות בידי הציבור` IS FALSE
    `איגרות החוב שלה רשומות למסחר בבורסה` IS FALSE
    `איגרות החוב שלה הוצעו לציבור על פי תשקיף` IS FALSE
    `איגרות החוב שלה הוצעו לציבור מחוץ לישראל על פי מסמך הצעה לציבור` IS FALSE
    `איגרות החוב שלה מוחזקות בידי הציבור` IS FALSE
    `חברה לתועלת הציבור` IS FALSE
    `חברה ממשלתית` IS FALSE
    `תאגיד מדווח` IS FALSE

`בדיקות ניהול - חברה ציבורית` MEANS `עובדות על חברה` WITH
    `הדין שלפיו התאגדה` IS `לפי חוק זה`
    `מניותיה רשומות למסחר בבורסה` IS TRUE
    `מניותיה הוצעו לציבור על פי תשקיף` IS FALSE
    `מניותיה הוצעו לציבור מחוץ לישראל על פי מסמך הצעה לציבור` IS FALSE
    `מניותיה מוחזקות בידי הציבור` IS TRUE
    `איגרות החוב שלה רשומות למסחר בבורסה` IS FALSE
    `איגרות החוב שלה הוצעו לציבור על פי תשקיף` IS FALSE
    `איגרות החוב שלה הוצעו לציבור מחוץ לישראל על פי מסמך הצעה לציבור` IS FALSE
    `איגרות החוב שלה מוחזקות בידי הציבור` IS FALSE
    `חברה לתועלת הציבור` IS FALSE
    `חברה ממשלתית` IS FALSE
    `תאגיד מדווח` IS FALSE

GIVEN b IS A NUMBER
      a IS A NUMBER
      m IS A NUMBER
GIVETH A `הצבעה`
`בדיקות ניהול - הצבעה` MEANS `הצבעה` WITH `קולות בעד` IS b, `קולות נגד` IS a, `קולות נמנעים` IS m

§§ `סימנים ד׳ ו־ה׳`

-- 76. Arguments: company; unanimous by all shareholders entitled to vote.
#ASSERT `סעיף 76 - בחברה פרטית ניתן לקבל החלטה באסיפה כללית ללא הזמנה וללא התכנסות` `בדיקות ניהול - חברה פרטית` TRUE EQUALS TRUE
#ASSERT `סעיף 76 - בחברה פרטית ניתן לקבל החלטה באסיפה כללית ללא הזמנה וללא התכנסות` `בדיקות ניהול - חברה פרטית` FALSE EQUALS FALSE
#ASSERT `סעיף 76 - בחברה פרטית ניתן לקבל החלטה באסיפה כללית ללא הזמנה וללא התכנסות` `בדיקות ניהול - חברה ציבורית` TRUE EQUALS FALSE
-- 77. Arguments: company; the articles forbid it; all can hear one another at once.
#ASSERT `סעיף 77 - חברה פרטית רשאית לקיים אסיפה כללית באמצעי תקשורת` `בדיקות ניהול - חברה פרטית` FALSE TRUE EQUALS TRUE
#ASSERT `סעיף 77 - חברה פרטית רשאית לקיים אסיפה כללית באמצעי תקשורת` `בדיקות ניהול - חברה פרטית` TRUE TRUE EQUALS FALSE
#ASSERT `סעיף 77 - חברה פרטית רשאית לקיים אסיפה כללית באמצעי תקשורת` `בדיקות ניהול - חברה פרטית` FALSE FALSE EQUALS FALSE
#ASSERT `סעיף 77 - חברה פרטית רשאית לקיים אסיפה כללית באמצעי תקשורת` `בדיקות ניהול - חברה ציבורית` FALSE TRUE EQUALS FALSE
-- 78(a). Arguments: one shareholder; the articles fix another quorum; that quorum was met; shareholders present;
-- their share of the voting rights; minutes from the set time until the quorum was reached.
#ASSERT `סעיף 78(א) - באסיפה כללית נכח מנין חוקי` FALSE FALSE FALSE 2 (25%) 30 EQUALS TRUE
#ASSERT `סעיף 78(א) - באסיפה כללית נכח מנין חוקי` FALSE FALSE FALSE 5 (80%) 0 EQUALS TRUE
-- One shareholder present, however large: not two shareholders.
#ASSERT `סעיף 78(א) - באסיפה כללית נכח מנין חוקי` FALSE FALSE FALSE 1 (90%) 10 EQUALS FALSE
-- Two shareholders with 24.9 percent: not enough.
#ASSERT `סעיף 78(א) - באסיפה כללית נכח מנין חוקי` FALSE FALSE FALSE 2 (24.9%) 10 EQUALS FALSE
-- Reached 31 minutes after the time set: too late.
#ASSERT `סעיף 78(א) - באסיפה כללית נכח מנין חוקי` FALSE FALSE FALSE 3 (60%) 31 EQUALS FALSE
-- A company with one shareholder is outside the sub-chapter.
#ASSERT `סעיף 78(א) - באסיפה כללית נכח מנין חוקי` TRUE FALSE FALSE 1 (100%) 0 EQUALS TRUE
-- The articles fix another quorum: the answer is whether that quorum was met.
#ASSERT `סעיף 78(א) - באסיפה כללית נכח מנין חוקי` FALSE TRUE TRUE 1 (1%) 90 EQUALS TRUE
#ASSERT `סעיף 78(א) - באסיפה כללית נכח מנין חוקי` FALSE TRUE FALSE 9 (99%) 0 EQUALS FALSE
-- 78(b). Arguments: no quorum at the end of half an hour; the later date stated in the invitation, in days.
#ASSERT `סעיף 78(ב) - האסיפה נדחית לשבוע ימים או למועד מאוחר יותר שצויין` TRUE NOTHING EQUALS JUST 7
#ASSERT `סעיף 78(ב) - האסיפה נדחית לשבוע ימים או למועד מאוחר יותר שצויין` TRUE (JUST 14) EQUALS JUST 14
#ASSERT `סעיף 78(ב) - האסיפה נדחית לשבוע ימים או למועד מאוחר יותר שצויין` TRUE (JUST 3) EQUALS JUST 7
#ASSERT `סעיף 78(ב) - האסיפה נדחית לשבוע ימים או למועד מאוחר יותר שצויין` FALSE NOTHING EQUALS NOTHING
#ASSERT `סעיף 78(ב) - האסיפה נדחית לשבוע ימים או למועד מאוחר יותר שצויין` FALSE (JUST 14) EQUALS NOTHING
#ASSERT `סעיף 78(ג) - הוראות סימן ה׳ חלות על החברה` 1 EQUALS FALSE
#ASSERT `סעיף 78(ג) - הוראות סימן ה׳ חלות על החברה` 2 EQUALS TRUE
-- 79(a). Arguments: no quorum in the postponed meeting after half an hour; convened on a shareholders' demand.
#ASSERT `סעיף 79(א) - האסיפה הנדחית מתקיימת בכל מספר משתתפים` TRUE FALSE EQUALS TRUE
#ASSERT `סעיף 79(א) - האסיפה הנדחית מתקיימת בכל מספר משתתפים` TRUE TRUE EQUALS FALSE
#ASSERT `סעיף 79(א) - האסיפה הנדחית מתקיימת בכל מספר משתתפים` FALSE FALSE EQUALS FALSE
-- 79(b). Arguments: company; convened on a shareholders' demand; present: share of the capital; share of the votes.
#ASSERT `סעיף 79(ב) - האסיפה הנדחית שכונסה על פי דרישה מתקיימת רק אם נכחו בעלי מניות במספר הדרוש` `בדיקות ניהול - חברה פרטית` FALSE (0%) (0%) EQUALS TRUE
#ASSERT `סעיף 79(ב) - האסיפה הנדחית שכונסה על פי דרישה מתקיימת רק אם נכחו בעלי מניות במספר הדרוש` `בדיקות ניהול - חברה פרטית` TRUE (10%) (1%) EQUALS TRUE
#ASSERT `סעיף 79(ב) - האסיפה הנדחית שכונסה על פי דרישה מתקיימת רק אם נכחו בעלי מניות במספר הדרוש` `בדיקות ניהול - חברה פרטית` TRUE (9%) (9%) EQUALS FALSE
#ASSERT `סעיף 79(ב) - האסיפה הנדחית שכונסה על פי דרישה מתקיימת רק אם נכחו בעלי מניות במספר הדרוש` `בדיקות ניהול - חברה פרטית` TRUE (0%) (10%) EQUALS TRUE
#ASSERT `סעיף 79(ב) - האסיפה הנדחית שכונסה על פי דרישה מתקיימת רק אם נכחו בעלי מניות במספר הדרוש` `בדיקות ניהול - חברה ציבורית` TRUE (5%) (1%) EQUALS TRUE
#ASSERT `סעיף 79(ב) - האסיפה הנדחית שכונסה על פי דרישה מתקיימת רק אם נכחו בעלי מניות במספר הדרוש` `בדיקות ניהול - חברה ציבורית` TRUE (4.9%) (4.9%) EQUALS FALSE
#ASSERT `סעיף 79(ב) - האסיפה הנדחית שכונסה על פי דרישה מתקיימת רק אם נכחו בעלי מניות במספר הדרוש` `בדיקות ניהול - חברה ציבורית` TRUE (0%) (5%) EQUALS TRUE
#ASSERT `סעיף 80(א) - באסיפה כללית ייבחר יושב ראש לאותה אסיפה` TRUE EQUALS TRUE
#ASSERT `סעיף 80(א) - באסיפה כללית ייבחר יושב ראש לאותה אסיפה` FALSE EQUALS FALSE
#ASSERT `סעיף 80(ב) - הדיון שבו נבחר יושב ראש האסיפה נפתח כדין` TRUE FALSE EQUALS TRUE
#ASSERT `סעיף 80(ב) - הדיון שבו נבחר יושב ראש האסיפה נפתח כדין` FALSE TRUE EQUALS TRUE
#ASSERT `סעיף 80(ב) - הדיון שבו נבחר יושב ראש האסיפה נפתח כדין` FALSE FALSE EQUALS FALSE
#ASSERT `סעיף 81 - ניתן להתנות בתקנון על הוראות סימן ה׳` EQUALS TRUE

§§ `סימן ו׳ – הצבעה באסיפה הכללית`

#ASSERT `סעיף 82(א) - חברה רשאית לקבוע בתקנונה זכויות הצבעה שונות לסוגים שונים של מניות` EQUALS TRUE
#ASSERT `סעיף 82(ב) - זכויות הצבעה שונות בתקנון תקפות כל עוד הן עומדות בהוראת חיקוק אחר` TRUE EQUALS TRUE
#ASSERT `סעיף 82(ב) - זכויות הצבעה שונות בתקנון תקפות כל עוד הן עומדות בהוראת חיקוק אחר` FALSE EQUALS FALSE
-- 82(c). Arguments: different rights fixed; the articles' number of votes for the share.
#ASSERT `סעיף 82(ג) - מספר הקולות של מניה` FALSE 10 EQUALS 1
#ASSERT `סעיף 82(ג) - מספר הקולות של מניה` TRUE 10 EQUALS 10
#ASSERT `סעיף 82(ג) - מספר הקולות של מניה` TRUE 0 EQUALS 0
-- 83(a).
#ASSERT `סעיף 83(א) - בעל מניה בחברה ציבורית רשאי להצביע בדרך` `בדיקות ניהול - חברה ציבורית` `הצבעה בעצמו` EQUALS TRUE
#ASSERT `סעיף 83(א) - בעל מניה בחברה ציבורית רשאי להצביע בדרך` `בדיקות ניהול - חברה ציבורית` `הצבעה באמצעות שלוח` EQUALS TRUE
#ASSERT `סעיף 83(א) - בעל מניה בחברה ציבורית רשאי להצביע בדרך` `בדיקות ניהול - חברה ציבורית` `הצבעה באמצעות כתב הצבעה` EQUALS TRUE
#ASSERT `סעיף 83(א) - בעל מניה בחברה ציבורית רשאי להצביע בדרך` `בדיקות ניהול - חברה פרטית` `הצבעה בעצמו` EQUALS FALSE
-- 83(b). Arguments: company; the way; the articles provide otherwise.
#ASSERT `סעיף 83(ב) - בעל מניה בחברה פרטית רשאי להצביע בעצמו או באמצעות שלוח` `בדיקות ניהול - חברה פרטית` `הצבעה בעצמו` FALSE EQUALS TRUE
#ASSERT `סעיף 83(ב) - בעל מניה בחברה פרטית רשאי להצביע בעצמו או באמצעות שלוח` `בדיקות ניהול - חברה פרטית` `הצבעה באמצעות שלוח` FALSE EQUALS TRUE
#ASSERT `סעיף 83(ב) - בעל מניה בחברה פרטית רשאי להצביע בעצמו או באמצעות שלוח` `בדיקות ניהול - חברה פרטית` `הצבעה באמצעות שלוח` TRUE EQUALS FALSE
#ASSERT `סעיף 83(ב) - בעל מניה בחברה פרטית רשאי להצביע בעצמו או באמצעות שלוח` `בדיקות ניהול - חברה פרטית` `הצבעה באמצעות כתב הצבעה` FALSE EQUALS FALSE
#ASSERT `סעיף 83(ב) - בעל מניה בחברה פרטית רשאי להצביע בעצמו או באמצעות שלוח` `בדיקות ניהול - חברה ציבורית` `הצבעה בעצמו` FALSE EQUALS FALSE
-- 83(c). Arguments: company; the articles provide for voting in writing.
#ASSERT `סעיף 83(ג) - בעל מניה בחברה פרטית רשאי להצביע בכתב` `בדיקות ניהול - חברה פרטית` TRUE EQUALS TRUE
#ASSERT `סעיף 83(ג) - בעל מניה בחברה פרטית רשאי להצביע בכתב` `בדיקות ניהול - חברה פרטית` FALSE EQUALS FALSE
#ASSERT `סעיף 83(ג) - בעל מניה בחברה פרטית רשאי להצביע בכתב` `בדיקות ניהול - חברה ציבורית` TRUE EQUALS FALSE
-- 83(d). Arguments: the first way; the second way; the first was in fact later in time.
-- A vote in person counts as later than a vote by deed, whatever the order in time.
#ASSERT `סעיף 83(ד) - ההצבעה הנמנית של בעל מניה שהצביע ביותר מדרך אחת` `הצבעה באמצעות כתב הצבעה` `הצבעה בעצמו` TRUE EQUALS `הצבעה בעצמו`
#ASSERT `סעיף 83(ד) - ההצבעה הנמנית של בעל מניה שהצביע ביותר מדרך אחת` `הצבעה בעצמו` `הצבעה באמצעות כתב הצבעה` FALSE EQUALS `הצבעה בעצמו`
#ASSERT `סעיף 83(ד) - ההצבעה הנמנית של בעל מניה שהצביע ביותר מדרך אחת` `הצבעה באמצעות כתב הצבעה` `הצבעה באמצעות שלוח` TRUE EQUALS `הצבעה באמצעות שלוח`
-- Two ways of the same group: the later in time counts.
#ASSERT `סעיף 83(ד) - ההצבעה הנמנית של בעל מניה שהצביע ביותר מדרך אחת` `הצבעה בעצמו` `הצבעה באמצעות שלוח` TRUE EQUALS `הצבעה בעצמו`
#ASSERT `סעיף 83(ד) - ההצבעה הנמנית של בעל מניה שהצביע ביותר מדרך אחת` `הצבעה בעצמו` `הצבעה באמצעות שלוח` FALSE EQUALS `הצבעה באמצעות שלוח`
-- Two voting deeds: the later in time counts.
#ASSERT `סעיף 83(ד) - ההצבעה הנמנית של בעל מניה שהצביע ביותר מדרך אחת` `הצבעה באמצעות כתב הצבעה` `הצבעה באמצעות כתב הצבעה` FALSE EQUALS `הצבעה באמצעות כתב הצבעה`
-- 84. Arguments: company; the articles fix a different deciding rule.
#ASSERT `סעיף 84 - החלטה באסיפה הכללית מתקבלת בהצבעה במנין קולות` `בדיקות ניהול - חברה פרטית` FALSE EQUALS TRUE
#ASSERT `סעיף 84 - החלטה באסיפה הכללית מתקבלת בהצבעה במנין קולות` `בדיקות ניהול - חברה פרטית` TRUE EQUALS FALSE
-- A public company has no such freedom.
#ASSERT `סעיף 84 - החלטה באסיפה הכללית מתקבלת בהצבעה במנין קולות` `בדיקות ניהול - חברה ציבורית` TRUE EQUALS TRUE
-- 85. Arguments: the vote; the other majority fixed by law or articles.
#ASSERT `סעיף 85 - החלטת האסיפה הכללית התקבלה ברוב הנדרש` (`בדיקות ניהול - הצבעה` 11 10 3) NOTHING EQUALS TRUE
#ASSERT `סעיף 85 - החלטת האסיפה הכללית התקבלה ברוב הנדרש` (`בדיקות ניהול - הצבעה` 10 10 3) NOTHING EQUALS FALSE
#ASSERT `סעיף 85 - החלטת האסיפה הכללית התקבלה ברוב הנדרש` (`בדיקות ניהול - הצבעה` 11 10 3) (JUST (2 DIVIDED BY 3)) EQUALS FALSE
#ASSERT `סעיף 85 - החלטת האסיפה הכללית התקבלה ברוב הנדרש` (`בדיקות ניהול - הצבעה` 2 1 0) (JUST (2 DIVIDED BY 3)) EQUALS TRUE
-- 86. Arguments: the chair declared that the resolution was adopted; it was shown that the declaration is wrong.
#ASSERT `סעיף 86 - הכרזת היושב ראש ראיה לכאורה לכך שההחלטה נתקבלה` TRUE FALSE EQUALS TRUE
#ASSERT `סעיף 86 - הכרזת היושב ראש ראיה לכאורה לכך שההחלטה נתקבלה` TRUE TRUE EQUALS FALSE
#ASSERT `סעיף 86 - הכרזת היושב ראש ראיה לכאורה לכך שההחלטה נתקבלה` FALSE FALSE EQUALS FALSE

§§ `סימן ז׳ – הצבעה בכתב והודעות עמדה`

#ASSERT `סעיף 87(א) - בעל מניה בחברה ציבורית רשאי להצביע בכתב הצבעה בענין` `בדיקות ניהול - חברה ציבורית` `מינויים ופיטורים של דירקטורים` EQUALS TRUE
#ASSERT `סעיף 87(א) - בעל מניה בחברה ציבורית רשאי להצביע בכתב הצבעה בענין` `בדיקות ניהול - חברה ציבורית` `אישור פעולות או עסקאות הטעונות אישור האסיפה הכללית` EQUALS TRUE
#ASSERT `סעיף 87(א) - בעל מניה בחברה ציבורית רשאי להצביע בכתב הצבעה בענין` `בדיקות ניהול - חברה ציבורית` `אישור מיזוג לענין סעיף 87(א)(3)` EQUALS TRUE
#ASSERT `סעיף 87(א) - בעל מניה בחברה ציבורית רשאי להצביע בכתב הצבעה בענין` `בדיקות ניהול - חברה ציבורית` `הסמכת יושב ראש הדירקטוריון או המנהל הכללי או קרוביהם לפי סעיף 121(ג)` EQUALS TRUE
#ASSERT `סעיף 87(א) - בעל מניה בחברה ציבורית רשאי להצביע בכתב הצבעה בענין` `בדיקות ניהול - חברה ציבורית` `נושא שנקבע בתקנון שהחלטות בו יתקבלו גם בכתב הצבעה` EQUALS TRUE
#ASSERT `סעיף 87(א) - בעל מניה בחברה ציבורית רשאי להצביע בכתב הצבעה בענין` `בדיקות ניהול - חברה ציבורית` `נושא נוסף שהשר קבע לפי סעיף 89` EQUALS TRUE
#ASSERT `סעיף 87(א) - בעל מניה בחברה ציבורית רשאי להצביע בכתב הצבעה בענין` `בדיקות ניהול - חברה ציבורית` `ענין אחר שאינו מנוי בסעיף 87(א)` EQUALS FALSE
#ASSERT `סעיף 87(א) - בעל מניה בחברה ציבורית רשאי להצביע בכתב הצבעה בענין` `בדיקות ניהול - חברה פרטית` `אישור מיזוג לענין סעיף 87(א)(3)` EQUALS FALSE
#ASSERT `סעיף 87(ב) - על החברה לשלוח כתב הצבעה לכל בעלי מניותיה` TRUE EQUALS TRUE
#ASSERT `סעיף 87(ב) - על החברה לשלוח כתב הצבעה לכל בעלי מניותיה` FALSE EQUALS FALSE
