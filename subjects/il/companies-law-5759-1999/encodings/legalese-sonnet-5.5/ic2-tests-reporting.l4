IMPORT prelude
IMPORT `ic-core`
IMPORT `ic2-tests-fixtures`
IMPORT `ic2-p4c2-registers`
IMPORT `ic2-p4c3-reporting`

-- Tests of ic2-p4c3-reporting.l4 (sections 140 to 145). Expected values are written from the text of the section named beside each.

§ `בדיקות: דיווח`

§§ `סעיף 140`

-- 140: a company that is not a reporting corporation reports to the Registrar on each listed matter; "other matter" is not in the list.
#ASSERT `סעיף 140 - חובת הדיווח לרשם על הענין המנוי בסעיף חלה על החברה` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `שינוי בתקנון`
#ASSERT `סעיף 140 - חובת הדיווח לרשם על הענין המנוי בסעיף חלה על החברה` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `החלטה על שינוי שם`
#ASSERT `סעיף 140 - חובת הדיווח לרשם על הענין המנוי בסעיף חלה על החברה` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `הגדלת ההון הרשום או הקטנתו`
#ASSERT `סעיף 140 - חובת הדיווח לרשם על הענין המנוי בסעיף חלה על החברה` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `שינוי במען המשרד הרשום`
#ASSERT `סעיף 140 - חובת הדיווח לרשם על הענין המנוי בסעיף חלה על החברה` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `שינוי במען הדיגיטלי`
#ASSERT `סעיף 140 - חובת הדיווח לרשם על הענין המנוי בסעיף חלה על החברה` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `הודעה שלחברה אין רואה חשבון מבקר`
#ASSERT `סעיף 140 - חובת הדיווח לרשם על הענין המנוי בסעיף חלה על החברה` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `מינוי דירקטור או שינוי בהרכב הדירקטוריון`
#ASSERT `סעיף 140 - חובת הדיווח לרשם על הענין המנוי בסעיף חלה על החברה` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `הקצאת מניות`
#ASSERT `סעיף 140 - חובת הדיווח לרשם על הענין המנוי בסעיף חלה על החברה` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `העברת מניות`
#ASSERT `סעיף 140 - חובת הדיווח לרשם על הענין המנוי בסעיף חלה על החברה` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `מיזוג כענין לדיווח לרשם`
#ASSERT `סעיף 140 - חובת הדיווח לרשם על הענין המנוי בסעיף חלה על החברה` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `שינוי בסוג החברה`
#ASSERT `סעיף 140 - חובת הדיווח לרשם על הענין המנוי בסעיף חלה על החברה` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `צו פירוק או החלטה על פירוק מרצון`
#ASSERT NOT (`סעיף 140 - חובת הדיווח לרשם על הענין המנוי בסעיף חלה על החברה` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `ענין אחר לדיווח לרשם`)
-- 140 does not reach a reporting corporation (it has its own list in 145), nor a body that is not a company.
#ASSERT NOT (`סעיף 140 - חובת הדיווח לרשם על הענין המנוי בסעיף חלה על החברה` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` `שינוי בתקנון`)
#ASSERT NOT (`סעיף 140 - חובת הדיווח לרשם על הענין המנוי בסעיף חלה על החברה` `דוגמה - גוף שהתאגד לפי דין אחר` `שינוי בתקנון`)
-- 140(6): fourteen days from the transfer; the fourteenth day is in time (F1).
#ASSERT `סעיף 140(6) - מספר הימים לדיווח על העברת מניות` EQUALS 14
#ASSERT `סעיף 140(6) - הדיווח על העברת מניות נמסר במועד` 14
#ASSERT NOT (`סעיף 140(6) - הדיווח על העברת מניות נמסר במועד` 15)

§§ `סעיף 141`

-- 141(א): a company that is not a reporting corporation files the annual report; a reporting corporation does not under this section.
#ASSERT `סעיף 141(א) - החברה חייבת להגיש לרשם דין וחשבון שנתי` `דוגמה - חברה פרטית שאינה חברת איגרות חוב`
#ASSERT `סעיף 141(א) - החברה חייבת להגיש לרשם דין וחשבון שנתי` `דוגמה - חברה פרטית שהיא חברת איגרות חוב ואינה תאגיד מדווח`
#ASSERT NOT (`סעיף 141(א) - החברה חייבת להגיש לרשם דין וחשבון שנתי` `דוגמה - חברה ציבורית שהיא תאגיד מדווח`)
#ASSERT `סעיף 141 - מספר הימים להגשת הדין וחשבון השנתי` EQUALS 14
-- 141(א): fourteen days after the annual meeting; 141(ב): fourteen days after sending the financial statements when there is no annual meeting; both once a year.
#ASSERT `סעיף 141 - הדין וחשבון השנתי הוגש במועד` `האסיפה השנתית` 14 TRUE
#ASSERT NOT (`סעיף 141 - הדין וחשבון השנתי הוגש במועד` `האסיפה השנתית` 15 TRUE)
#ASSERT NOT (`סעיף 141 - הדין וחשבון השנתי הוגש במועד` `האסיפה השנתית` 3 FALSE)
#ASSERT `סעיף 141 - הדין וחשבון השנתי הוגש במועד` `משלוח הדוחות הכספיים לבעלי המניות` 14 TRUE
#ASSERT NOT (`סעיף 141 - הדין וחשבון השנתי הוגש במועד` `משלוח הדוחות הכספיים לבעלי המניות` 15 TRUE)
-- 141(ב) last limb: an inactive company that prepares no statements files once a year, with no fourteen-day anchor.
#ASSERT `סעיף 141 - הדין וחשבון השנתי הוגש במועד` `חברה לא פעילה שאינה עורכת דוחות כספיים` 400 TRUE
#ASSERT NOT (`סעיף 141 - הדין וחשבון השנתי הוגש במועד` `חברה לא פעילה שאינה עורכת דוחות כספיים` 0 FALSE)

§§ `סעיפים 142 עד 145`

-- 142(ב): a reporting corporation reports to the Authority, the bourse and the Registrar.
#ASSERT `סעיף 142(ב) - התאגיד המדווח חייב לדווח לרשות ניירות ערך, לבורסה ולרשם` `דוגמה - חברה ציבורית שהיא תאגיד מדווח`
#ASSERT NOT (`סעיף 142(ב) - התאגיד המדווח חייב לדווח לרשות ניירות ערך, לבורסה ולרשם` `דוגמה - חברה ציבורית שאינה תאגיד מדווח`)
#ASSERT NOT (`סעיף 142(ב) - התאגיד המדווח חייב לדווח לרשות ניירות ערך, לבורסה ולרשם` `דוגמה - גוף שהתאגד לפי דין אחר`)
-- 143(א): any person may inspect unless the law restricts it.
#ASSERT `סעיף 143(א) - כל אדם רשאי לעיין בדוחות שהוגשו לרשות ניירות ערך ולקבל העתק מאושר` FALSE
#ASSERT NOT (`סעיף 143(א) - כל אדם רשאי לעיין בדוחות שהוגשו לרשות ניירות ערך ולקבל העתק מאושר` TRUE)
-- 143(ב): a certified copy counts as the original, and conclusively proves the original is held by the Authority.
#ASSERT `סעיף 143(ב) - העתק מאושר מתקבל כמקור בכל הליך משפטי` TRUE
#ASSERT NOT (`סעיף 143(ב) - העתק מאושר מתקבל כמקור בכל הליך משפטי` FALSE)
#ASSERT `סעיף 143(ב) - המשקל הראייתי של העתק מאושר לענין החזקת המסמך המקורי ברשות` EQUALS `ראיה חלוטה`
-- 143(ג): (ב) reaches a printout where electronic filing provisions were set.
#ASSERT `סעיף 143(ג) - הוראת סעיף קטן (ב) חלה על הפלט` TRUE TRUE
#ASSERT NOT (`סעיף 143(ג) - הוראת סעיף קטן (ב) חלה על הפלט` TRUE FALSE)
#ASSERT NOT (`סעיף 143(ג) - הוראת סעיף קטן (ב) חלה על הפלט` FALSE TRUE)
-- 145: a reporting corporation reports to the Registrar under this Law on the six listed matters only.
#ASSERT `סעיף 145 - חובת הדיווח לרשם לפי חוק זה חלה על התאגיד המדווח לגבי הענין` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` `החלטה על שינוי שם`
#ASSERT `סעיף 145 - חובת הדיווח לרשם לפי חוק זה חלה על התאגיד המדווח לגבי הענין` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` `שינוי במען המשרד הרשום`
#ASSERT `סעיף 145 - חובת הדיווח לרשם לפי חוק זה חלה על התאגיד המדווח לגבי הענין` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` `שינוי במען הדיגיטלי`
#ASSERT `סעיף 145 - חובת הדיווח לרשם לפי חוק זה חלה על התאגיד המדווח לגבי הענין` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` `מיזוג כענין לדיווח לרשם`
#ASSERT `סעיף 145 - חובת הדיווח לרשם לפי חוק זה חלה על התאגיד המדווח לגבי הענין` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` `שינוי בסוג החברה`
#ASSERT `סעיף 145 - חובת הדיווח לרשם לפי חוק זה חלה על התאגיד המדווח לגבי הענין` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` `צו פירוק או החלטה על פירוק מרצון`
#ASSERT NOT (`סעיף 145 - חובת הדיווח לרשם לפי חוק זה חלה על התאגיד המדווח לגבי הענין` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` `שינוי בתקנון`)
#ASSERT NOT (`סעיף 145 - חובת הדיווח לרשם לפי חוק זה חלה על התאגיד המדווח לגבי הענין` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` `העברת מניות`)
#ASSERT NOT (`סעיף 145 - חובת הדיווח לרשם לפי חוק זה חלה על התאגיד המדווח לגבי הענין` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` `מינוי דירקטור או שינוי בהרכב הדירקטוריון`)
#ASSERT NOT (`סעיף 145 - חובת הדיווח לרשם לפי חוק זה חלה על התאגיד המדווח לגבי הענין` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` `ענין אחר לדיווח לרשם`)
#ASSERT NOT (`סעיף 145 - חובת הדיווח לרשם לפי חוק זה חלה על התאגיד המדווח לגבי הענין` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `מיזוג כענין לדיווח לרשם`)
