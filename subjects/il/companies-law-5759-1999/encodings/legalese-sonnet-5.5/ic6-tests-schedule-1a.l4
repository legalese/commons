IMPORT prelude
IMPORT `ic-core`
IMPORT `ic6-schedule-1a`

-- Tests of ic6-schedule-1a.l4 (the First Schedule A). Expected values are written by hand from the items.

§ `בדיקות – התוספת הראשונה א׳: מדיניות התגמול`

§§ `חלק א׳`

#ASSERT `תוספת 1א חלק א פרט 1 - המדיניות מתייחסת להשכלה, כישורים, מומחיות, ניסיון והישגים` TRUE
#ASSERT NOT (`תוספת 1א חלק א פרט 1 - המדיניות מתייחסת להשכלה, כישורים, מומחיות, ניסיון והישגים` FALSE)
#ASSERT `תוספת 1א חלק א פרט 2 - המדיניות מתייחסת לתפקיד, לאחריות ולהסכמי שכר קודמים` TRUE
#ASSERT NOT (`תוספת 1א חלק א פרט 2 - המדיניות מתייחסת לתפקיד, לאחריות ולהסכמי שכר קודמים` FALSE)
-- Item (3): all three limbs (the ratio, the average and median, the effect of the gaps).
#ASSERT `תוספת 1א חלק א פרט 3 - המדיניות מתייחסת ליחסי העלות` TRUE TRUE TRUE
#ASSERT NOT (`תוספת 1א חלק א פרט 3 - המדיניות מתייחסת ליחסי העלות` FALSE TRUE TRUE)
#ASSERT NOT (`תוספת 1א חלק א פרט 3 - המדיניות מתייחסת ליחסי העלות` TRUE FALSE TRUE)
#ASSERT NOT (`תוספת 1א חלק א פרט 3 - המדיניות מתייחסת ליחסי העלות` TRUE TRUE FALSE)
#ASSERT `תוספת 1א חלק א פרט 3 - עובד קבלן המועסק אצל החברה` TRUE FALSE
#ASSERT `תוספת 1א חלק א פרט 3 - עובד קבלן המועסק אצל החברה` FALSE TRUE
#ASSERT NOT (`תוספת 1א חלק א פרט 3 - עובד קבלן המועסק אצל החברה` FALSE FALSE)
#ASSERT `תוספת 1א חלק א פרט 3 - התשלום הוא עלות שכר` TRUE
#ASSERT NOT (`תוספת 1א חלק א פרט 3 - התשלום הוא עלות שכר` FALSE)
-- Item (4): with no variable components there is nothing to address; with them, both limbs.
#ASSERT `תוספת 1א חלק א פרט 4 - המדיניות מתייחסת לרכיבים המשתנים` FALSE FALSE FALSE
#ASSERT `תוספת 1א חלק א פרט 4 - המדיניות מתייחסת לרכיבים המשתנים` TRUE TRUE TRUE
#ASSERT NOT (`תוספת 1א חלק א פרט 4 - המדיניות מתייחסת לרכיבים המשתנים` TRUE TRUE FALSE)
#ASSERT NOT (`תוספת 1א חלק א פרט 4 - המדיניות מתייחסת לרכיבים המשתנים` TRUE FALSE TRUE)
-- Item (5): with no severance grants nothing to address; with them, all four limbs.
#ASSERT `תוספת 1א חלק א פרט 5 - המדיניות מתייחסת למענקי הפרישה` FALSE FALSE FALSE FALSE FALSE
#ASSERT `תוספת 1א חלק א פרט 5 - המדיניות מתייחסת למענקי הפרישה` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`תוספת 1א חלק א פרט 5 - המדיניות מתייחסת למענקי הפרישה` TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`תוספת 1א חלק א פרט 5 - המדיניות מתייחסת למענקי הפרישה` TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`תוספת 1א חלק א פרט 5 - המדיניות מתייחסת למענקי הפרישה` TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`תוספת 1א חלק א פרט 5 - המדיניות מתייחסת למענקי הפרישה` TRUE TRUE TRUE TRUE FALSE)
-- Part A as a whole needs all five.
#ASSERT `תוספת 1א חלק א - המדיניות מתייחסת לכל העניינים שחובה להתייחס אליהם` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`תוספת 1א חלק א - המדיניות מתייחסת לכל העניינים שחובה להתייחס אליהם` TRUE TRUE TRUE TRUE FALSE)
#ASSERT NOT (`תוספת 1א חלק א - המדיניות מתייחסת לכל העניינים שחובה להתייחס אליהם` FALSE TRUE TRUE TRUE TRUE)

§§ `חלק ב׳`

-- Item (1)(א): not subordinate to the general manager: based on long-term measurable criteria; no non-measurable part: yes.
#ASSERT `תוספת 1א חלק ב פרט 1(א) - המדיניות עומדת בפרט משנה (א)` FALSE TRUE FALSE FALSE 0 10_000
-- Based on measurable criteria is required for a policy that is not about a subordinate: without it, no.
#ASSERT NOT (`תוספת 1א חלק ב פרט 1(א) - המדיניות עומדת בפרט משנה (א)` FALSE FALSE FALSE FALSE 0 10_000)
-- A non-measurable part that is not material: yes. One that is material and over three monthly salaries: no.
#ASSERT `תוספת 1א חלק ב פרט 1(א) - המדיניות עומדת בפרט משנה (א)` FALSE TRUE TRUE TRUE 50_000 10_000
#ASSERT NOT (`תוספת 1א חלק ב פרט 1(א) - המדיניות עומדת בפרט משנה (א)` FALSE TRUE TRUE FALSE 30_001 10_000)
-- Not material, but the whole sum is at most three monthly salaries (30,000): yes; one shekel more: no.
#ASSERT `תוספת 1א חלק ב פרט 1(א) - המדיניות עומדת בפרט משנה (א)` FALSE TRUE TRUE FALSE 30_000 10_000
-- An office-holder subordinate to the general manager: the sub-item does not apply, whatever the policy says.
#ASSERT `תוספת 1א חלק ב פרט 1(א) - המדיניות עומדת בפרט משנה (א)` TRUE FALSE TRUE FALSE 90_000 10_000
-- Item (1)(ב): the ratio; a ceiling at payment for cash-settled components; a ceiling at grant for equity-based components not settled in cash.
#ASSERT `תוספת 1א חלק ב פרט 1(ב) - המדיניות עומדת בפרט משנה (ב)` TRUE TRUE TRUE FALSE FALSE
#ASSERT `תוספת 1א חלק ב פרט 1(ב) - המדיניות עומדת בפרט משנה (ב)` TRUE FALSE FALSE TRUE TRUE
#ASSERT `תוספת 1א חלק ב פרט 1(ב) - המדיניות עומדת בפרט משנה (ב)` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`תוספת 1א חלק ב פרט 1(ב) - המדיניות עומדת בפרט משנה (ב)` FALSE TRUE TRUE FALSE FALSE)
#ASSERT NOT (`תוספת 1א חלק ב פרט 1(ב) - המדיניות עומדת בפרט משנה (ב)` TRUE TRUE FALSE FALSE FALSE)
#ASSERT NOT (`תוספת 1א חלק ב פרט 1(ב) - המדיניות עומדת בפרט משנה (ב)` TRUE FALSE FALSE TRUE FALSE)
#ASSERT NOT (`תוספת 1א חלק ב פרט 1(ב) - המדיניות עומדת בפרט משנה (ב)` TRUE TRUE TRUE TRUE FALSE)
-- Item (2): the clause and its conditions.
#ASSERT `תוספת 1א חלק ב פרט 2 - המדיניות כוללת תניית השבה` TRUE TRUE
#ASSERT NOT (`תוספת 1א חלק ב פרט 2 - המדיניות כוללת תניית השבה` TRUE FALSE)
#ASSERT NOT (`תוספת 1א חלק ב פרט 2 - המדיניות כוללת תניית השבה` FALSE TRUE)
-- Item (3): with equity-based components the period is needed; without them it is not.
#ASSERT `תוספת 1א חלק ב פרט 3 - המדיניות קבעה תקופת החזקה או הבשלה מזערית` TRUE TRUE
#ASSERT NOT (`תוספת 1א חלק ב פרט 3 - המדיניות קבעה תקופת החזקה או הבשלה מזערית` TRUE FALSE)
#ASSERT `תוספת 1א חלק ב פרט 3 - המדיניות קבעה תקופת החזקה או הבשלה מזערית` FALSE FALSE
-- Item (4).
#ASSERT `תוספת 1א חלק ב פרט 4 - המדיניות קבעה תקרה למענקי הפרישה` TRUE
#ASSERT NOT (`תוספת 1א חלק ב פרט 4 - המדיניות קבעה תקרה למענקי הפרישה` FALSE)
