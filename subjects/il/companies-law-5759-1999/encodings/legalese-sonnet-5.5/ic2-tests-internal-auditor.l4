IMPORT prelude
IMPORT `ic-core`
IMPORT `ic2-tests-fixtures`
IMPORT `ic2-p4c4-internal-auditor`

-- Tests of ic2-p4c4-internal-auditor.l4 (sections 146 to 153). Expected values are written from the text of the section named beside each.

§ `בדיקות: מבקר פנימי`

-- Ties to the company: none at all; a 5% shareholder (a material shareholder, hence an interested party); a director.
`קשר - אין כל קשר` MEANS `קשר לחברה` WITH
    `החזקה בהון המניות המונפק` IS 0
    `החזקה בזכויות ההצבעה` IS 0
    `סמכות למנות דירקטור אחד או יותר` IS FALSE
    `סמכות למנות את המנהל הכללי` IS FALSE
    `מכהן כדירקטור` IS FALSE
    `מכהן כמנהל כללי` IS FALSE
    `שליטה לפי חוק ניירות ערך` IS FALSE
`קשר - בעל חמישה אחוזים` MEANS `קשר לחברה` WITH
    `החזקה בהון המניות המונפק` IS 0.05
    `החזקה בזכויות ההצבעה` IS 0
    `סמכות למנות דירקטור אחד או יותר` IS FALSE
    `סמכות למנות את המנהל הכללי` IS FALSE
    `מכהן כדירקטור` IS FALSE
    `מכהן כמנהל כללי` IS FALSE
    `שליטה לפי חוק ניירות ערך` IS FALSE
`קשר - בעל ארבעה אחוזים` MEANS `קשר לחברה` WITH
    `החזקה בהון המניות המונפק` IS 0.04
    `החזקה בזכויות ההצבעה` IS 0.04
    `סמכות למנות דירקטור אחד או יותר` IS FALSE
    `סמכות למנות את המנהל הכללי` IS FALSE
    `מכהן כדירקטור` IS FALSE
    `מכהן כמנהל כללי` IS FALSE
    `שליטה לפי חוק ניירות ערך` IS FALSE

§§ `סעיף 146`

-- 146(א): a public company or a private bond company must appoint an internal auditor; another private company need not.
#ASSERT `סעיף 146(א) - הדירקטוריון חייב למנות מבקר פנימי` `דוגמה - חברה ציבורית שהיא תאגיד מדווח`
#ASSERT `סעיף 146(א) - הדירקטוריון חייב למנות מבקר פנימי` `דוגמה - חברה פרטית שהיא חברת איגרות חוב ואינה תאגיד מדווח`
#ASSERT NOT (`סעיף 146(א) - הדירקטוריון חייב למנות מבקר פנימי` `דוגמה - חברה פרטית שאינה חברת איגרות חוב`)
#ASSERT NOT (`סעיף 146(א) - הדירקטוריון חייב למנות מבקר פנימי` `דוגמה - גוף שהתאגד לפי דין אחר`)
#ASSERT `סעיף 146(א) - מינוי המבקר הפנימי נעשה כנדרש` TRUE
#ASSERT NOT (`סעיף 146(א) - מינוי המבקר הפנימי נעשה כנדרש` FALSE)
-- 146(ב): barred are an interested party, an office-holder, a relative of either, and the external auditor or anyone on his behalf.
#ASSERT NOT (`סעיף 146(ב) - האדם מנוע מלכהן כמבקר פנימי` `קשר - אין כל קשר` NOTHING NOTHING FALSE)
#ASSERT `סעיף 146(ב) - האדם מנוע מלכהן כמבקר פנימי` `קשר - בעל חמישה אחוזים` NOTHING NOTHING FALSE
#ASSERT NOT (`סעיף 146(ב) - האדם מנוע מלכהן כמבקר פנימי` `קשר - בעל ארבעה אחוזים` NOTHING NOTHING FALSE)
#ASSERT `סעיף 146(ב) - האדם מנוע מלכהן כמבקר פנימי` `קשר - אין כל קשר` (JUST `סגן מנהל כללי`) NOTHING FALSE
#ASSERT `סעיף 146(ב) - האדם מנוע מלכהן כמבקר פנימי` `קשר - אין כל קשר` (JUST `דירקטור`) NOTHING FALSE
#ASSERT NOT (`סעיף 146(ב) - האדם מנוע מלכהן כמבקר פנימי` `קשר - אין כל קשר` (JUST `משרה אחרת`) NOTHING FALSE)
#ASSERT `סעיף 146(ב) - האדם מנוע מלכהן כמבקר פנימי` `קשר - אין כל קשר` NOTHING (JUST `בן זוג`) FALSE
#ASSERT `סעיף 146(ב) - האדם מנוע מלכהן כמבקר פנימי` `קשר - אין כל קשר` NOTHING (JUST `אח או אחות של בן הזוג`) FALSE
#ASSERT NOT (`סעיף 146(ב) - האדם מנוע מלכהן כמבקר פנימי` `קשר - אין כל קשר` NOTHING (JUST `קרבה אחרת`) FALSE)
#ASSERT `סעיף 146(ב) - האדם מנוע מלכהן כמבקר פנימי` `קשר - אין כל קשר` NOTHING NOTHING TRUE

§§ `סעיף 147`

-- 147: the provisions of the Internal Audit Law that reach the internal auditor are 3(א), 4(ב), 8 to 10, 14(ב) and 14(ג).
#ASSERT `סעיף 147 - ההוראה בחוק הביקורת הפנימית חלה על המבקר הפנימי` `סעיף 3(א)`
#ASSERT `סעיף 147 - ההוראה בחוק הביקורת הפנימית חלה על המבקר הפנימי` `סעיף 4(ב)`
#ASSERT `סעיף 147 - ההוראה בחוק הביקורת הפנימית חלה על המבקר הפנימי` `סעיפים 8 עד 10`
#ASSERT `סעיף 147 - ההוראה בחוק הביקורת הפנימית חלה על המבקר הפנימי` `סעיף 14(ב)`
#ASSERT `סעיף 147 - ההוראה בחוק הביקורת הפנימית חלה על המבקר הפנימי` `סעיף 14(ג)`
#ASSERT NOT (`סעיף 147 - ההוראה בחוק הביקורת הפנימית חלה על המבקר הפנימי` `הוראה אחרת בחוק הביקורת הפנימית`)

§§ `סעיפים 148 עד 152`

-- 148: the articles name the supervisor (chairperson or general manager); if silent, the board does; anyone else is not a supervisor under the section.
#ASSERT `סעיף 148 - הממונה הארגוני על המבקר הפנימי` (JUST `המנהל הכללי`) NOTHING EQUALS JUST `המנהל הכללי`
#ASSERT `סעיף 148 - הממונה הארגוני על המבקר הפנימי` (JUST `יושב ראש הדירקטוריון`) (JUST `המנהל הכללי`) EQUALS JUST `יושב ראש הדירקטוריון`
#ASSERT `סעיף 148 - הממונה הארגוני על המבקר הפנימי` NOTHING (JUST `המנהל הכללי`) EQUALS JUST `המנהל הכללי`
#ASSERT `סעיף 148 - הממונה הארגוני על המבקר הפנימי` NOTHING (JUST `ועדת הביקורת`) EQUALS NOTHING
#ASSERT `סעיף 148 - הממונה הארגוני על המבקר הפנימי` (JUST `הדירקטוריון`) (JUST `המנהל הכללי`) EQUALS NOTHING
#ASSERT `סעיף 148 - הממונה הארגוני על המבקר הפנימי` NOTHING NOTHING EQUALS NOTHING
-- 149: the board or the audit committee approves the work plan, as the articles say, else as the board decides.
#ASSERT `סעיף 149 - הגוף שמאשר את תכנית העבודה של המבקר הפנימי` (JUST `ועדת הביקורת`) NOTHING EQUALS JUST `ועדת הביקורת`
#ASSERT `סעיף 149 - הגוף שמאשר את תכנית העבודה של המבקר הפנימי` (JUST `ועדת הביקורת`) (JUST `הדירקטוריון`) EQUALS JUST `ועדת הביקורת`
#ASSERT `סעיף 149 - הגוף שמאשר את תכנית העבודה של המבקר הפנימי` NOTHING (JUST `הדירקטוריון`) EQUALS JUST `הדירקטוריון`
#ASSERT `סעיף 149 - הגוף שמאשר את תכנית העבודה של המבקר הפנימי` NOTHING (JUST `המנהל הכללי`) EQUALS NOTHING
#ASSERT `סעיף 149 - הגוף שמאשר את תכנית העבודה של המבקר הפנימי` NOTHING NOTHING EQUALS NOTHING
-- 150: the chairperson of the board, or of the audit committee, may require an urgent audit.
#ASSERT `סעיף 150 - רשאי להטיל על המבקר הפנימי בדיקה דחופה` TRUE FALSE TRUE
#ASSERT `סעיף 150 - רשאי להטיל על המבקר הפנימי בדיקה דחופה` FALSE TRUE TRUE
#ASSERT NOT (`סעיף 150 - רשאי להטיל על המבקר הפנימי בדיקה דחופה` FALSE FALSE TRUE)
#ASSERT NOT (`סעיף 150 - רשאי להטיל על המבקר הפנימי בדיקה דחופה` TRUE TRUE FALSE)
-- 151: compliance with the law and proper business procedure are among the matters, and the list is open.
#ASSERT `סעיף 151 - הענין נכלל בבדיקת המבקר הפנימי` TRUE FALSE FALSE
#ASSERT `סעיף 151 - הענין נכלל בבדיקת המבקר הפנימי` FALSE TRUE FALSE
#ASSERT `סעיף 151 - הענין נכלל בבדיקת המבקר הפנימי` FALSE FALSE TRUE
#ASSERT NOT (`סעיף 151 - הענין נכלל בבדיקת המבקר הפנימי` FALSE FALSE FALSE)
-- 152: the three office-holders always receive the report; whoever required an urgent audit receives the report on it.
#ASSERT `סעיף 152 - הנמען זכאי לקבל את הדין וחשבון של המבקר הפנימי` TRUE FALSE FALSE FALSE FALSE
#ASSERT `סעיף 152 - הנמען זכאי לקבל את הדין וחשבון של המבקר הפנימי` FALSE TRUE FALSE FALSE FALSE
#ASSERT `סעיף 152 - הנמען זכאי לקבל את הדין וחשבון של המבקר הפנימי` FALSE FALSE TRUE FALSE FALSE
#ASSERT `סעיף 152 - הנמען זכאי לקבל את הדין וחשבון של המבקר הפנימי` FALSE FALSE FALSE TRUE TRUE
#ASSERT NOT (`סעיף 152 - הנמען זכאי לקבל את הדין וחשבון של המבקר הפנימי` FALSE FALSE FALSE FALSE TRUE)
#ASSERT NOT (`סעיף 152 - הנמען זכאי לקבל את הדין וחשבון של המבקר הפנימי` FALSE FALSE FALSE TRUE FALSE)

§§ `סעיף 153`

-- 153(א): the board's route is a decision, the audit committee's position, and a reasonable opportunity for the internal auditor to be heard.
#ASSERT `סעיף 153(א) - הדירקטוריון הלך בדרך שנקבעה להפסקה או להשעיה` TRUE TRUE TRUE
#ASSERT NOT (`סעיף 153(א) - הדירקטוריון הלך בדרך שנקבעה להפסקה או להשעיה` FALSE TRUE TRUE)
#ASSERT NOT (`סעיף 153(א) - הדירקטוריון הלך בדרך שנקבעה להפסקה או להשעיה` TRUE FALSE TRUE)
#ASSERT NOT (`סעיף 153(א) - הדירקטוריון הלך בדרך שנקבעה להפסקה או להשעיה` TRUE TRUE FALSE)
-- The term may end with his consent or by the board's route; he may be suspended only by the board's route (F5).
#ASSERT `סעיף 153(א) - מותר להפסיק את כהונת המבקר הפנימי` TRUE FALSE
#ASSERT `סעיף 153(א) - מותר להפסיק את כהונת המבקר הפנימי` FALSE TRUE
#ASSERT NOT (`סעיף 153(א) - מותר להפסיק את כהונת המבקר הפנימי` FALSE FALSE)
#ASSERT `סעיף 153(א) - מותר להשעות את המבקר הפנימי מתפקידו` TRUE
#ASSERT NOT (`סעיף 153(א) - מותר להשעות את המבקר הפנימי מתפקידו` FALSE)
-- 153(ב): a quorum of more than half the members: of 7, four; of 8, five.
#ASSERT `סעיף 153(ב) - המנין החוקי לישיבה בענין סעיף קטן (א) התקיים` 7 4
#ASSERT NOT (`סעיף 153(ב) - המנין החוקי לישיבה בענין סעיף קטן (א) התקיים` 7 3)
#ASSERT `סעיף 153(ב) - המנין החוקי לישיבה בענין סעיף קטן (א) התקיים` 8 5
#ASSERT NOT (`סעיף 153(ב) - המנין החוקי לישיבה בענין סעיף קטן (א) התקיים` 8 4)
