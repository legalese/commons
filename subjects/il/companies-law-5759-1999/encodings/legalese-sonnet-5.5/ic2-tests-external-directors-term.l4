IMPORT prelude
IMPORT `ic-core`
IMPORT `ic-core-people`
IMPORT `ic2-tests-fixtures`
IMPORT `ic2-p6c1d-external-directors-appointment`
IMPORT `ic2-p6c1e-external-directors-term`

-- Tests of ic2-p6c1e-external-directors-term.l4 (sections 245 to 249ג). Expected values are written from the text of the section named beside each.

§ `בדיקות: כהונת דירקטור חיצוני, פקיעתה, מינוי במקום מי שנתפנה, תקופת צינון ודירקטור בלתי תלוי`

§§ `סעיף 245`

-- 245(א): three years, and two further periods of three years each; section 240 does not stand in the way of a further appointment.
#ASSERT `סעיף 245(א) - תקופת הכהונה של דירקטור חיצוני בשנים` EQUALS 3
#ASSERT `סעיף 245(א) - מספר התקופות הנוספות שאפשר למנות להן דירקטור חיצוני` EQUALS 2
#ASSERT `סעיף 245(א) - סעיף 240 אינו מונע מינוי לתקופה נוספת`
#ASSERT `סעיף 245(א) - אפשר למנות את הדירקטור החיצוני לתקופה נוספת` 0
#ASSERT `סעיף 245(א) - אפשר למנות את הדירקטור החיצוני לתקופה נוספת` 1
#ASSERT NOT (`סעיף 245(א) - אפשר למנות את הדירקטור החיצוני לתקופה נוספת` 2)
-- 245(א3): the articles may set a ceiling of six years on the total term, for a director first appointed after the ceiling was set. The arguments: the ceiling the articles set; first appointed after it was set.
#ASSERT `סעיף 245(א3) - מספר השנים המרבי של הכהונה הכוללת של דירקטור חיצוני` NOTHING TRUE EQUALS 9
#ASSERT `סעיף 245(א3) - מספר השנים המרבי של הכהונה הכוללת של דירקטור חיצוני` (JUST 6) TRUE EQUALS 6
#ASSERT `סעיף 245(א3) - מספר השנים המרבי של הכהונה הכוללת של דירקטור חיצוני` (JUST 6) FALSE EQUALS 9
#ASSERT `סעיף 245(א3) - מספר השנים המרבי של הכהונה הכוללת של דירקטור חיצוני` (JUST 4) TRUE EQUALS 4
#ASSERT `סעיף 245(א3) - מספר השנים המרבי של הכהונה הכוללת של דירקטור חיצוני` (JUST 8) TRUE EQUALS 9
-- 245(א1)(1)(א): a shareholder's vote counts if he does not abstain, is not a controlling shareholder, and has no personal interest resulting from a tie with the controlling shareholder.
-- The record is built from four facts: controlling shareholder; personally interested; the interest results from a tie with the controlling shareholder; abstained.
`בדיקה - בעל מניות רגיל` MEANS `עובדות על בעל מניות המצביע על מינוי לתקופה נוספת` WITH
    `הוא בעל שליטה בחברה` IS FALSE
    `יש לו עניין אישי באישור המינוי` IS FALSE
    `העניין האישי הוא כתוצאה מקשר עם בעל השליטה` IS FALSE
    `הוא נמנע מההצבעה` IS FALSE
`בדיקה - בעל שליטה` MEANS `עובדות על בעל מניות המצביע על מינוי לתקופה נוספת` WITH
    `הוא בעל שליטה בחברה` IS TRUE
    `יש לו עניין אישי באישור המינוי` IS FALSE
    `העניין האישי הוא כתוצאה מקשר עם בעל השליטה` IS FALSE
    `הוא נמנע מההצבעה` IS FALSE
`בדיקה - בעל מניות בעל עניין אישי שנובע מקשר עם בעל השליטה` MEANS `עובדות על בעל מניות המצביע על מינוי לתקופה נוספת` WITH
    `הוא בעל שליטה בחברה` IS FALSE
    `יש לו עניין אישי באישור המינוי` IS TRUE
    `העניין האישי הוא כתוצאה מקשר עם בעל השליטה` IS TRUE
    `הוא נמנע מההצבעה` IS FALSE
`בדיקה - בעל מניות בעל עניין אישי שאינו נובע מקשר עם בעל השליטה` MEANS `עובדות על בעל מניות המצביע על מינוי לתקופה נוספת` WITH
    `הוא בעל שליטה בחברה` IS FALSE
    `יש לו עניין אישי באישור המינוי` IS TRUE
    `העניין האישי הוא כתוצאה מקשר עם בעל השליטה` IS FALSE
    `הוא נמנע מההצבעה` IS FALSE
`בדיקה - בעל מניות שנמנע` MEANS `עובדות על בעל מניות המצביע על מינוי לתקופה נוספת` WITH
    `הוא בעל שליטה בחברה` IS FALSE
    `יש לו עניין אישי באישור המינוי` IS FALSE
    `העניין האישי הוא כתוצאה מקשר עם בעל השליטה` IS FALSE
    `הוא נמנע מההצבעה` IS TRUE
#ASSERT `סעיף 245(א1)(1)(א) - קולו של בעל המניות נספר` `בדיקה - בעל מניות רגיל`
#ASSERT `סעיף 245(א1)(1)(א) - קולו של בעל המניות נספר` `בדיקה - בעל מניות בעל עניין אישי שאינו נובע מקשר עם בעל השליטה`
#ASSERT NOT (`סעיף 245(א1)(1)(א) - קולו של בעל המניות נספר` `בדיקה - בעל שליטה`)
#ASSERT NOT (`סעיף 245(א1)(1)(א) - קולו של בעל המניות נספר` `בדיקה - בעל מניות בעל עניין אישי שנובע מקשר עם בעל השליטה`)
#ASSERT NOT (`סעיף 245(א1)(1)(א) - קולו של בעל המניות נספר` `בדיקה - בעל מניות שנמנע`)
-- 245(א1)(1)(ב): the support among the counted shareholders exceeds two percent of all voting rights, or the percentage the Minister set (245(א2)).
-- The tallies are built from the votes for, against and abstaining of the shareholders who are neither controlling nor interested, and all the voting rights (1000).
`בדיקה - נתוני 245 - 30 תומכים` MEANS `נתוני הצבעה לפי סעיף 239(ב)` WITH
    `הצבעת בעלי המניות שאינם בעלי שליטה ושאינם בעלי עניין אישי בענין המינוי` IS `הצבעה` WITH `קולות בעד` IS 30, `קולות נגד` IS 5, `קולות נמנעים` IS 0
    `כלל זכויות ההצבעה בחברה לענין המינוי` IS 1000
`בדיקה - נתוני 245 - 20 תומכים` MEANS `נתוני הצבעה לפי סעיף 239(ב)` WITH
    `הצבעת בעלי המניות שאינם בעלי שליטה ושאינם בעלי עניין אישי בענין המינוי` IS `הצבעה` WITH `קולות בעד` IS 20, `קולות נגד` IS 5, `קולות נמנעים` IS 0
    `כלל זכויות ההצבעה בחברה לענין המינוי` IS 1000
`בדיקה - נתוני 245 - 25 תומכים` MEANS `נתוני הצבעה לפי סעיף 239(ב)` WITH
    `הצבעת בעלי המניות שאינם בעלי שליטה ושאינם בעלי עניין אישי בענין המינוי` IS `הצבעה` WITH `קולות בעד` IS 25, `קולות נגד` IS 5, `קולות נמנעים` IS 0
    `כלל זכויות ההצבעה בחברה לענין המינוי` IS 1000
#ASSERT `סעיף 245(א1)(1)(ב) - השיעור הרגיל של קולות התומכים` EQUALS 0.02
#ASSERT `סעיף 245(א1)(1)(ב) - קולות התומכים עולים על השיעור הנדרש מכלל זכויות ההצבעה` `בדיקה - נתוני 245 - 30 תומכים` NOTHING
#ASSERT NOT (`סעיף 245(א1)(1)(ב) - קולות התומכים עולים על השיעור הנדרש מכלל זכויות ההצבעה` `בדיקה - נתוני 245 - 20 תומכים` NOTHING)
#ASSERT NOT (`סעיף 245(א1)(1)(ב) - קולות התומכים עולים על השיעור הנדרש מכלל זכויות ההצבעה` `בדיקה - נתוני 245 - 25 תומכים` (JUST 0.03))
#ASSERT `סעיף 245(א1)(1)(ב) - קולות התומכים עולים על השיעור הנדרש מכלל זכויות ההצבעה` `בדיקה - נתוני 245 - 30 תומכים` (JUST 0.025)
#ASSERT `סעיף 245(א1)(1)(ב) - קולות התומכים עולים על השיעור הנדרש מכלל זכויות ההצבעה` `בדיקה - נתוני 245 - 20 תומכים` (JUST 0.015)
-- 245(א1)(1)(ג): a connected or competing shareholder. The record is built from four facts: proposed the appointment or is a material shareholder; business relations at the appointment; competitor at the appointment; the Minister determined the matter is neither.
`בדיקה - בעל מניה שהציע את המינוי ויש לו קשרים עסקיים` MEANS `עובדות על בעל מניה לצורך פסקת משנה (ג)` WITH
    `בעל המניה הציע את המינוי או שהוא בעל מניה מהותי` IS TRUE
    `במועד המינוי יש לו, לבעל שליטה בו או לחברה בשליטת מי מהם קשרים עסקיים עם החברה` IS TRUE
    `במועד המינוי הוא, בעל שליטה בו או חברה בשליטת מי מהם הם מתחרים של החברה` IS FALSE
    `השר קבע שהענין, בתנאים שקבע, אינו קשר עסקי או תחרות` IS FALSE
`בדיקה - בעל מניה מהותי שהוא מתחרה` MEANS `עובדות על בעל מניה לצורך פסקת משנה (ג)` WITH
    `בעל המניה הציע את המינוי או שהוא בעל מניה מהותי` IS TRUE
    `במועד המינוי יש לו, לבעל שליטה בו או לחברה בשליטת מי מהם קשרים עסקיים עם החברה` IS FALSE
    `במועד המינוי הוא, בעל שליטה בו או חברה בשליטת מי מהם הם מתחרים של החברה` IS TRUE
    `השר קבע שהענין, בתנאים שקבע, אינו קשר עסקי או תחרות` IS FALSE
`בדיקה - בעל מניה שהציע את המינוי ואין לו קשרים ואינו מתחרה` MEANS `עובדות על בעל מניה לצורך פסקת משנה (ג)` WITH
    `בעל המניה הציע את המינוי או שהוא בעל מניה מהותי` IS TRUE
    `במועד המינוי יש לו, לבעל שליטה בו או לחברה בשליטת מי מהם קשרים עסקיים עם החברה` IS FALSE
    `במועד המינוי הוא, בעל שליטה בו או חברה בשליטת מי מהם הם מתחרים של החברה` IS FALSE
    `השר קבע שהענין, בתנאים שקבע, אינו קשר עסקי או תחרות` IS FALSE
`בדיקה - בעל מניה רגיל שיש לו קשרים עסקיים` MEANS `עובדות על בעל מניה לצורך פסקת משנה (ג)` WITH
    `בעל המניה הציע את המינוי או שהוא בעל מניה מהותי` IS FALSE
    `במועד המינוי יש לו, לבעל שליטה בו או לחברה בשליטת מי מהם קשרים עסקיים עם החברה` IS TRUE
    `במועד המינוי הוא, בעל שליטה בו או חברה בשליטת מי מהם הם מתחרים של החברה` IS TRUE
    `השר קבע שהענין, בתנאים שקבע, אינו קשר עסקי או תחרות` IS FALSE
`בדיקה - בעל מניה שהשר קבע שקשריו אינם קשר עסקי` MEANS `עובדות על בעל מניה לצורך פסקת משנה (ג)` WITH
    `בעל המניה הציע את המינוי או שהוא בעל מניה מהותי` IS TRUE
    `במועד המינוי יש לו, לבעל שליטה בו או לחברה בשליטת מי מהם קשרים עסקיים עם החברה` IS TRUE
    `במועד המינוי הוא, בעל שליטה בו או חברה בשליטת מי מהם הם מתחרים של החברה` IS FALSE
    `השר קבע שהענין, בתנאים שקבע, אינו קשר עסקי או תחרות` IS TRUE
#ASSERT `סעיף 245(א1)(1)(ג) - בעל המניה הוא בעל מניה קשור או מתחרה` `בדיקה - בעל מניה שהציע את המינוי ויש לו קשרים עסקיים`
#ASSERT `סעיף 245(א1)(1)(ג) - בעל המניה הוא בעל מניה קשור או מתחרה` `בדיקה - בעל מניה מהותי שהוא מתחרה`
