IMPORT prelude
IMPORT daydate
IMPORT `ic-core`
IMPORT `ic6-common`
IMPORT `ic6-arrangement`
IMPORT `ic6-tests-fixtures`

-- Tests of ic6-arrangement.l4 (Part 9 chapter 3). Expected values are written by hand from the sections named; none is copied from the rules' output.

§ `בדיקות – חלק 9 פרק 3: פשרה או הסדר`

§§ `סעיף 350(א): כינוס אסיפות`

-- Arguments: the applicant, is the applicant the trustee, is the company in liquidation, a compromise is proposed, it is a debt arrangement (s 318), it is a rehabilitation plan (s 4).
-- The company applies: yes.
#ASSERT `סעיף 350(א) - בית המשפט רשאי להורות על כינוס אסיפות` `החברה` FALSE FALSE TRUE FALSE FALSE
-- A shareholder applies: yes.
#ASSERT `סעיף 350(א) - בית המשפט רשאי להורות על כינוס אסיפות` `בעל המניות` FALSE FALSE TRUE FALSE FALSE
-- A creditor applies: the text lists the company, a shareholder and the trustee only.
#ASSERT NOT (`סעיף 350(א) - בית המשפט רשאי להורות על כינוס אסיפות` `הנושה` FALSE FALSE TRUE FALSE FALSE)
-- The trustee applies and the company is being wound up: yes; the company is not being wound up: no.
#ASSERT `סעיף 350(א) - בית המשפט רשאי להורות על כינוס אסיפות` `אדם אחר` TRUE TRUE TRUE FALSE FALSE
#ASSERT NOT (`סעיף 350(א) - בית המשפט רשאי להורות על כינוס אסיפות` `אדם אחר` TRUE FALSE TRUE FALSE FALSE)
-- A debt arrangement or a rehabilitation plan is outside the section.
#ASSERT NOT (`סעיף 350(א) - בית המשפט רשאי להורות על כינוס אסיפות` `החברה` FALSE FALSE TRUE TRUE FALSE)
#ASSERT NOT (`סעיף 350(א) - בית המשפט רשאי להורות על כינוס אסיפות` `החברה` FALSE FALSE TRUE FALSE TRUE)
-- Nothing proposed: nothing to convene meetings for.
#ASSERT NOT (`סעיף 350(א) - בית המשפט רשאי להורות על כינוס אסיפות` `החברה` FALSE FALSE FALSE FALSE FALSE)

§§ `סעיפים 350(א1) ו־(א2)`

#ASSERT `סעיף 350(א1) - הקבוצה היא סוג לעניין אסיפות סוג` TRUE TRUE TRUE
#ASSERT NOT (`סעיף 350(א1) - הקבוצה היא סוג לעניין אסיפות סוג` FALSE TRUE TRUE)
#ASSERT NOT (`סעיף 350(א1) - הקבוצה היא סוג לעניין אסיפות סוג` TRUE FALSE TRUE)
#ASSERT NOT (`סעיף 350(א1) - הקבוצה היא סוג לעניין אסיפות סוג` TRUE TRUE FALSE)
#ASSERT `סעיף 350(א2) - הנושה או בעל המניה עמד בחובת ההצבעה באסיפת סוג` TRUE TRUE TRUE
#ASSERT NOT (`סעיף 350(א2) - הנושה או בעל המניה עמד בחובת ההצבעה באסיפת סוג` FALSE TRUE TRUE)
#ASSERT NOT (`סעיף 350(א2) - הנושה או בעל המניה עמד בחובת ההצבעה באסיפת סוג` TRUE FALSE TRUE)
#ASSERT NOT (`סעיף 350(א2) - הנושה או בעל המניה עמד בחובת ההצבעה באסיפת סוג` TRUE TRUE FALSE)

§§ `סעיף 350(ט): הסכמת אסיפות הסוג`

-- Columns of the result: participants for, participants against, value for, value against (abstainers are in neither).
-- 3 for and 2 against; value 75 against 25: a majority in number, and exactly three quarters of the value: agreed (three quarters is "at least").
#ASSERT `סעיף 350(ט) - אסיפת הסוג הסכימה לפשרה או להסדר` (`תוצאת ההצבעה באסיפת סוג` OF 3, 2, 75, 25)
-- One unit of value short of three quarters (74 of 100): not agreed.
#ASSERT NOT (`סעיף 350(ט) - אסיפת הסוג הסכימה לפשרה או להסדר` (`תוצאת ההצבעה באסיפת סוג` OF 3, 2, 74, 26))
-- Half the participants (2 against 2) is not a majority, whatever the value.
#ASSERT NOT (`סעיף 350(ט) - אסיפת הסוג הסכימה לפשרה או להסדר` (`תוצאת ההצבעה באסיפת סוג` OF 2, 2, 90, 10))
-- A majority in number that holds only 60 percent of the value: not agreed.
#ASSERT NOT (`סעיף 350(ט) - אסיפת הסוג הסכימה לפשרה או להסדר` (`תוצאת ההצבעה באסיפת סוג` OF 3, 2, 60, 40))
-- A minority in number that holds 90 percent of the value: not agreed.
#ASSERT NOT (`סעיף 350(ט) - אסיפת הסוג הסכימה לפשרה או להסדר` (`תוצאת ההצבעה באסיפת סוג` OF 1, 2, 90, 10))
-- Nobody voted: not agreed.
#ASSERT NOT (`סעיף 350(ט) - אסיפת הסוג הסכימה לפשרה או להסדר` (`תוצאת ההצבעה באסיפת סוג` OF 0, 0, 0, 0))
-- One participant, voting for, with all the value: agreed.
#ASSERT `סעיף 350(ט) - אסיפת הסוג הסכימה לפשרה או להסדר` (`תוצאת ההצבעה באסיפת סוג` OF 1, 0, 10, 0)

`כיתה שהסכימה` MEANS `תוצאת ההצבעה באסיפת סוג` OF 3, 2, 75, 25
`כיתה שלא הסכימה` MEANS `תוצאת ההצבעה באסיפת סוג` OF 3, 2, 74, 26

-- Binding: every class agreed and the court approved.
#ASSERT `סעיף 350(ט) - הפשרה או ההסדר מחייבים את החברה ואת הנושים או בעלי המניות` (LIST `כיתה שהסכימה`, `כיתה שהסכימה`) TRUE
#ASSERT `סעיף 350(ט) - הפשרה או ההסדר מחייבים את החברה ואת הנושים או בעלי המניות` (LIST `כיתה שהסכימה`) TRUE
-- One class did not agree: not binding.
#ASSERT NOT (`סעיף 350(ט) - הפשרה או ההסדר מחייבים את החברה ואת הנושים או בעלי המניות` (LIST `כיתה שהסכימה`, `כיתה שלא הסכימה`) TRUE)
-- The court did not approve: not binding.
#ASSERT NOT (`סעיף 350(ט) - הפשרה או ההסדר מחייבים את החברה ואת הנושים או בעלי המניות` (LIST `כיתה שהסכימה`) FALSE)
-- No class meeting was convened: the clause has nothing to say.
#ASSERT NOT (`סעיף 350(ט) - הפשרה או ההסדר מחייבים את החברה ואת הנושים או בעלי המניות` EMPTY TRUE)
-- The trustee is bound too if the company is in liquidation.
#ASSERT `סעיף 350(ט) - הפשרה או ההסדר מחייבים גם את הנאמן` (LIST `כיתה שהסכימה`) TRUE TRUE
#ASSERT NOT (`סעיף 350(ט) - הפשרה או ההסדר מחייבים גם את הנאמן` (LIST `כיתה שהסכימה`) TRUE FALSE)
#ASSERT NOT (`סעיף 350(ט) - הפשרה או ההסדר מחייבים גם את הנאמן` (LIST `כיתה שלא הסכימה`) TRUE TRUE)

§§ `סעיפים 350(ט1) עד (יא)`

#ASSERT `סעיף 350(ט1) - בית המשפט מוסמך לדון במחלוקת על הפשרה או ההסדר` TRUE TRUE TRUE
#ASSERT NOT (`סעיף 350(ט1) - בית המשפט מוסמך לדון במחלוקת על הפשרה או ההסדר` FALSE TRUE TRUE)
#ASSERT NOT (`סעיף 350(ט1) - בית המשפט מוסמך לדון במחלוקת על הפשרה או ההסדר` TRUE FALSE TRUE)
#ASSERT NOT (`סעיף 350(ט1) - בית המשפט מוסמך לדון במחלוקת על הפשרה או ההסדר` TRUE TRUE FALSE)
#ASSERT `סעיף 350(י) - לצו שניתן לפי סעיף 350(ט) יש תוקף` TRUE
#ASSERT NOT (`סעיף 350(י) - לצו שניתן לפי סעיף 350(ט) יש תוקף` FALSE)
-- A copy of the articles issued after the order must carry the order; a copy issued before need not.
#ASSERT `סעיף 350(י) - העותק שיצא עומד בדרישת צירוף העתק הצו` TRUE TRUE
#ASSERT NOT (`סעיף 350(י) - העותק שיצא עומד בדרישת צירוף העתק הצו` TRUE FALSE)
#ASSERT `סעיף 350(י) - העותק שיצא עומד בדרישת צירוף העתק הצו` FALSE FALSE
-- 350(יא) "company": a company, or a foreign company that does business or has assets in Israel.
#ASSERT `סעיף 350(יא) - חברה לעניין פרק 3` `בדיקה ic6 - תאגיד שהוא חברה פרטית רגילה` FALSE FALSE
#ASSERT `סעיף 350(יא) - חברה לעניין פרק 3` `בדיקה ic6 - חברת חוץ` TRUE FALSE
#ASSERT `סעיף 350(יא) - חברה לעניין פרק 3` `בדיקה ic6 - חברת חוץ` FALSE TRUE
#ASSERT NOT (`סעיף 350(יא) - חברה לעניין פרק 3` `בדיקה ic6 - חברת חוץ` FALSE FALSE)
-- A partnership formed abroad is not a foreign company, so it is not a "company" here even if it does business in Israel.
#ASSERT NOT (`סעיף 350(יא) - חברה לעניין פרק 3` `בדיקה ic6 - שותפות שהוקמה מחוץ לישראל` TRUE TRUE)
-- 350(יא) "arrangement".
#ASSERT `סעיף 350(יא) - הסדר לעניין פרק 3` TRUE FALSE FALSE
#ASSERT `סעיף 350(יא) - הסדר לעניין פרק 3` FALSE TRUE FALSE
#ASSERT `סעיף 350(יא) - הסדר לעניין פרק 3` FALSE FALSE TRUE
#ASSERT NOT (`סעיף 350(יא) - הסדר לעניין פרק 3` FALSE FALSE FALSE)

§§ `סעיף 351: שינוי מבנה ומיזוג`

-- 351(א): the court may give the six directions only if all three conditions hold; otherwise none.
#ASSERT (count (`סעיף 351(א) - ההוראות שבית המשפט רשאי לתת` TRUE TRUE TRUE)) EQUALS 6
#ASSERT (count (`סעיף 351(א) - ההוראות שבית המשפט רשאי לתת` FALSE TRUE TRUE)) EQUALS 0
#ASSERT (count (`סעיף 351(א) - ההוראות שבית המשפט רשאי לתת` TRUE FALSE TRUE)) EQUALS 0
#ASSERT (count (`סעיף 351(א) - ההוראות שבית המשפט רשאי לתת` TRUE TRUE FALSE)) EQUALS 0
#ASSERT elem `חיסול החברה המעבירה ללא פירוק` (`סעיף 351(א) - ההוראות שבית המשפט רשאי לתת` TRUE TRUE TRUE)
-- 351(ב): effects of the order.
#ASSERT `סעיף 351(ב) - הנכסים מוקנים לחברה הנעברת מכוח הצו` TRUE
#ASSERT NOT (`סעיף 351(ב) - הנכסים מוקנים לחברה הנעברת מכוח הצו` FALSE)
#ASSERT `סעיף 351(ב) - הנכסים משוחררים משעבוד` TRUE TRUE TRUE
#ASSERT NOT (`סעיף 351(ב) - הנכסים משוחררים משעבוד` TRUE FALSE TRUE)
#ASSERT NOT (`סעיף 351(ב) - הנכסים משוחררים משעבוד` TRUE TRUE FALSE)
#ASSERT `סעיף 351(ב) - החיובים עוברים לחברה הנעברת ונעשים לחיוביה` TRUE
#ASSERT NOT (`סעיף 351(ב) - החיובים עוברים לחברה הנעברת ונעשים לחיוביה` FALSE)
-- 351(ג): seven days from 1 March 2026 end on 8 March 2026. Delivered on 8 March: in time. Delivered on 9 March: late, one day.
#ASSERT NOT (`סעיף 351(ג) - החברה הפרה את חובת מסירת העתק הצו לרשם` (YMD 2026 3 1) (JUST (YMD 2026 3 8)) (YMD 2026 6 1))
#ASSERT `סעיף 351(ג) - החברה הפרה את חובת מסירת העתק הצו לרשם` (YMD 2026 3 1) (JUST (YMD 2026 3 9)) (YMD 2026 6 1)
#ASSERT `סעיף 351(ג) - מספר ימי ההפרה` (YMD 2026 3 1) (JUST (YMD 2026 3 9)) (YMD 2026 6 1) EQUALS 1
#ASSERT `סעיף 351(ג) - מספר ימי ההפרה` (YMD 2026 3 1) (JUST (YMD 2026 3 18)) (YMD 2026 6 1) EQUALS 10
#ASSERT `סעיף 351(ג) - מספר ימי ההפרה` (YMD 2026 3 1) (JUST (YMD 2026 3 8)) (YMD 2026 6 1) EQUALS 0
-- Not yet delivered: the breach exists once 8 March has passed, and runs to the day of the check.
#ASSERT NOT (`סעיף 351(ג) - החברה הפרה את חובת מסירת העתק הצו לרשם` (YMD 2026 3 1) NOTHING (YMD 2026 3 8))
#ASSERT `סעיף 351(ג) - החברה הפרה את חובת מסירת העתק הצו לרשם` (YMD 2026 3 1) NOTHING (YMD 2026 3 9)
#ASSERT `סעיף 351(ג) - מספר ימי ההפרה` (YMD 2026 3 1) NOTHING (YMD 2026 3 20) EQUALS 12
-- The office-holder is liable only if he approved or allowed the breach.
#ASSERT `סעיף 351(ג) - נושא משרה שאישר או התיר את ההפרה חב בקנס` TRUE TRUE TRUE
#ASSERT NOT (`סעיף 351(ג) - נושא משרה שאישר או התיר את ההפרה חב בקנס` TRUE TRUE FALSE)
#ASSERT NOT (`סעיף 351(ג) - נושא משרה שאישר או התיר את ההפרה חב בקנס` TRUE FALSE TRUE)
#ASSERT NOT (`סעיף 351(ג) - נושא משרה שאישר או התיר את ההפרה חב בקנס` FALSE TRUE TRUE)

§§ `סעיף 351א: החלת ההוראות`

#ASSERT `סעיף 351א - הוראות פרק 3 חלות על התאגיד` `בדיקה ic6 - חברת חוץ` TRUE FALSE FALSE
#ASSERT `סעיף 351א - הוראות פרק 3 חלות על התאגיד` `בדיקה ic6 - חברת חוץ` FALSE TRUE FALSE
#ASSERT NOT (`סעיף 351א - הוראות פרק 3 חלות על התאגיד` `בדיקה ic6 - חברת חוץ` FALSE FALSE FALSE)
-- A corporation that is not a foreign company is covered only if the Minister's order names it.
#ASSERT NOT (`סעיף 351א - הוראות פרק 3 חלות על התאגיד` `בדיקה ic6 - שותפות שהוקמה מחוץ לישראל` TRUE TRUE FALSE)
#ASSERT `סעיף 351א - הוראות פרק 3 חלות על התאגיד` `בדיקה ic6 - שותפות שהוקמה מחוץ לישראל` FALSE FALSE TRUE
