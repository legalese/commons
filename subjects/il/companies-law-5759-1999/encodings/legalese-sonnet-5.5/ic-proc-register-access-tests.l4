IMPORT prelude
IMPORT `ic-core`
IMPORT `ic2-tests-fixtures`
IMPORT `ic-proc-register-access`

-- Tests of ic-proc-register-access.l4 (sections 124 to 129). Every EXPECT is written from the text of the section named beside it, before the trace was run.
-- The text of these sections states no request procedure and no time limit, so no clock is encoded and no trace here has an "in time", "last day" or "late" case:
-- the cases are instead: done, never done after a long wait (still open, never a breach), and the gate failing.
-- How a trace is classed: FULFILLED is exactly `FULFILLED`; RESIDUAL is any obligation or permission still open, which includes a permission nobody has used and a duty that has no deadline.
-- FULFILLED after a gate fails means only that the Act lays down no step for these facts.

§ `בדיקות: שמירת המסמכים והעיון בהם`

§§ `סעיף 124: שמירת המסמכים`

-- Arguments of `סעיף 124 - חובת השמירה במשרד הרשום`, in order: the company's facts, the document, the age in years of a notice copy.

-- 124(1): a private company keeps its articles at the registered office, on day 3.
-- EXPECT FULFILLED
#TRACE `סעיף 124 - חובת השמירה במשרד הרשום` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `תקנון החברה כמסמך שנשמר במשרד הרשום` 0 AT 0 WITH
    PARTY `החברה בהליך העיון` DOES `החברה שומרת את המסמך במשרדה הרשום` AT 3


-- 124: no time is set: the articles are never kept, and a long wait is not a breach.
-- EXPECT RESIDUAL
#TRACE `סעיף 124 - חובת השמירה במשרד הרשום` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `תקנון החברה כמסמך שנשמר במשרד הרשום` 0 AT 0 WITH
    (WAITUNTIL 1000)


-- 124: a document the section does not list is not one the company must keep there: no step.
-- EXPECT FULFILLED
#TRACE `סעיף 124 - חובת השמירה במשרד הרשום` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `מסמך אחר שהחברה שומרת במשרדה הרשום` 0 AT 0 WITH
    (WAITUNTIL 5)


-- 124(5): a copy of a notice from the last seven years must be kept (seven years old is in).
-- EXPECT RESIDUAL
#TRACE `סעיף 124 - חובת השמירה במשרד הרשום` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `העתק הודעה של החברה לבעלי מניותיה` 7 AT 0 WITH
    (WAITUNTIL 5)


-- 124(5): a copy of a notice eight years old need not be kept: no step.
-- EXPECT FULFILLED
#TRACE `סעיף 124 - חובת השמירה במשרד הרשום` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `העתק הודעה של החברה לבעלי מניותיה` 8 AT 0 WITH
    (WAITUNTIL 5)


-- 124(7): a private company keeps no register of material shareholders: no step.
-- EXPECT FULFILLED
#TRACE `סעיף 124 - חובת השמירה במשרד הרשום` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `מרשם בעלי המניות המהותיים` 0 AT 0 WITH
    (WAITUNTIL 5)


-- 124(7): a public company keeps the register of material shareholders at the registered office.
-- EXPECT RESIDUAL
#TRACE `סעיף 124 - חובת השמירה במשרד הרשום` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` `מרשם בעלי המניות המהותיים` 0 AT 0 WITH
    (WAITUNTIL 5)


§§ `סעיפים 127 עד 129: העיון במרשמים`


-- Assertions on the new helper: the register is one the company must keep, and it is open to any person.

-- Arguments: the company's facts, whether it is the register of shareholders, whether it is the register of material shareholders.

#ASSERT `הליך העיון - המרשם חובה לנהלו והוא פתוח לעיון` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` TRUE FALSE

#ASSERT `הליך העיון - המרשם חובה לנהלו והוא פתוח לעיון` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` TRUE FALSE

#ASSERT `הליך העיון - המרשם חובה לנהלו והוא פתוח לעיון` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` FALSE TRUE

#ASSERT NOT (`הליך העיון - המרשם חובה לנהלו והוא פתוח לעיון` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` FALSE TRUE)

#ASSERT NOT (`הליך העיון - המרשם חובה לנהלו והוא פתוח לעיון` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` FALSE FALSE)

#ASSERT NOT (`הליך העיון - המרשם חובה לנהלו והוא פתוח לעיון` `דוגמה - גוף שהתאגד לפי דין אחר` TRUE FALSE)


-- Arguments of `סעיף 129 - עיון במרשם`, in order: the company's facts, whether it is the register of shareholders, whether it is the register of material shareholders.

-- 129: a private company's register of shareholders: any person asks on day 2, the company lets him inspect on day 2.
-- EXPECT FULFILLED
#TRACE `סעיף 129 - עיון במרשם` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` TRUE FALSE AT 0 WITH
    PARTY `המבקש` DOES `המבקש מבקש לעיין במרשם` AT 2
    PARTY `החברה בהליך העיון` DOES `החברה מאפשרת עיון במרשם` AT 2


-- 129: asked on day 2; no time is set for the company, so a long wait leaves the duty open.
-- EXPECT RESIDUAL
#TRACE `סעיף 129 - עיון במרשם` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` TRUE FALSE AT 0 WITH
    PARTY `המבקש` DOES `המבקש מבקש לעיין במרשם` AT 2
    (WAITUNTIL 400)


-- 129: asked on day 2, not yet allowed: open.
-- EXPECT RESIDUAL
#TRACE `סעיף 129 - עיון במרשם` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` TRUE FALSE AT 0 WITH
    PARTY `המבקש` DOES `המבקש מבקש לעיין במרשם` AT 2


-- 129: nobody asks, and a long wait: the permission has no deadline and stays open.
-- EXPECT RESIDUAL
#TRACE `סעיף 129 - עיון במרשם` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` TRUE FALSE AT 0 WITH
    (WAITUNTIL 400)


-- 128: a private company has no register of material shareholders: no step.
-- EXPECT FULFILLED
#TRACE `סעיף 129 - עיון במרשם` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` FALSE TRUE AT 0 WITH
    (WAITUNTIL 5)


-- 128, 129: a public company's register of material shareholders: asked on day 2, allowed on day 5.
-- EXPECT FULFILLED
#TRACE `סעיף 129 - עיון במרשם` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` FALSE TRUE AT 0 WITH
    PARTY `המבקש` DOES `המבקש מבקש לעיין במרשם` AT 2
    PARTY `החברה בהליך העיון` DOES `החברה מאפשרת עיון במרשם` AT 5


-- 128, 129: a public company's register of material shareholders: asked on day 2, the company's duty is open.
-- EXPECT RESIDUAL
#TRACE `סעיף 129 - עיון במרשם` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` FALSE TRUE AT 0 WITH
    PARTY `המבקש` DOES `המבקש מבקש לעיין במרשם` AT 2


-- 129: neither register is meant: no step.
-- EXPECT FULFILLED
#TRACE `סעיף 129 - עיון במרשם` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` FALSE FALSE AT 0 WITH
    (WAITUNTIL 5)


-- 127, 129: a body incorporated under another law is not a company of this Law: no duty to keep the register, so no step.
-- EXPECT FULFILLED
#TRACE `סעיף 129 - עיון במרשם` `דוגמה - גוף שהתאגד לפי דין אחר` TRUE FALSE AT 0 WITH
    PARTY `המבקש` DOES `המבקש מבקש לעיין במרשם` AT 2


§§ `סעיפים 125 ו־126: העתקים`


-- Arguments of `סעיף 126 - מתן העתק`, in order: the company's facts, the document, the age of a notice copy, whether the person is entitled to inspect the section 124 documents,

-- the company's expenses of giving the copy alone, the Minister's maximum sum if he set one.

-- 126(א): entitled; asks for the articles on day 1; the company gives the copy on day 9 for fifty, which is its cost.
-- EXPECT FULFILLED
#TRACE `סעיף 126 - מתן העתק` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `תקנון החברה כמסמך שנשמר במשרד הרשום` 0 TRUE 50 NOTHING AT 0 WITH
    PARTY `המבקש` DOES `המבקש מבקש העתק של מסמך` AT 1
    PARTY `החברה בהליך העיון` DOES (`החברה נותנת העתק של מסמך` 50) AT 9


-- 126(א): a payment below the cost is within the limit.
-- EXPECT FULFILLED
#TRACE `סעיף 126 - מתן העתק` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `תקנון החברה כמסמך שנשמר במשרד הרשום` 0 TRUE 50 NOTHING AT 0 WITH
    PARTY `המבקש` DOES `המבקש מבקש העתק של מסמך` AT 1
    PARTY `החברה בהליך העיון` DOES (`החברה נותנת העתק של מסמך` 30) AT 9


-- 126(א): a payment of sixty above a cost of fifty does not discharge the duty: it stays open.
-- EXPECT RESIDUAL
#TRACE `סעיף 126 - מתן העתק` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `תקנון החברה כמסמך שנשמר במשרד הרשום` 0 TRUE 50 NOTHING AT 0 WITH
    PARTY `המבקש` DOES `המבקש מבקש העתק של מסמך` AT 1
    PARTY `החברה בהליך העיון` DOES (`החברה נותנת העתק של מסמך` 60) AT 9


-- 126(ב): the Minister set forty as the maximum; a payment of forty is within it.
-- EXPECT FULFILLED
#TRACE `סעיף 126 - מתן העתק` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `תקנון החברה כמסמך שנשמר במשרד הרשום` 0 TRUE 50 (JUST 40) AT 0 WITH
    PARTY `המבקש` DOES `המבקש מבקש העתק של מסמך` AT 1
    PARTY `החברה בהליך העיון` DOES (`החברה נותנת העתק של מסמך` 40) AT 9


-- 126(ב): the Minister set forty; a payment of forty-five, though under the cost, is above the maximum.
-- EXPECT RESIDUAL
#TRACE `סעיף 126 - מתן העתק` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `תקנון החברה כמסמך שנשמר במשרד הרשום` 0 TRUE 50 (JUST 40) AT 0 WITH
    PARTY `המבקש` DOES `המבקש מבקש העתק של מסמך` AT 1
    PARTY `החברה בהליך העיון` DOES (`החברה נותנת העתק של מסמך` 45) AT 9


-- 126(א): asked on day 1, no time is set for the copy: a long wait leaves the duty open.
-- EXPECT RESIDUAL
#TRACE `סעיף 126 - מתן העתק` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `תקנון החברה כמסמך שנשמר במשרד הרשום` 0 TRUE 50 NOTHING AT 0 WITH
    PARTY `המבקש` DOES `המבקש מבקש העתק של מסמך` AT 1
    (WAITUNTIL 500)


-- 126(א): nobody asks for a copy: the permission has no deadline and stays open.
-- EXPECT RESIDUAL
#TRACE `סעיף 126 - מתן העתק` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `תקנון החברה כמסמך שנשמר במשרד הרשום` 0 TRUE 50 NOTHING AT 0 WITH
    (WAITUNTIL 500)


-- 126(א): not entitled to inspect: no right to a copy, so no step.
-- EXPECT FULFILLED
#TRACE `סעיף 126 - מתן העתק` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `תקנון החברה כמסמך שנשמר במשרד הרשום` 0 FALSE 50 NOTHING AT 0 WITH
    (WAITUNTIL 5)


-- 126(א), 124: a document the section 124 list does not include: no right to a copy under 126.
-- EXPECT FULFILLED
#TRACE `סעיף 126 - מתן העתק` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `מסמך אחר שהחברה שומרת במשרדה הרשום` 0 TRUE 50 NOTHING AT 0 WITH
    (WAITUNTIL 5)


-- READS-DIFFERENTLY-ON-MAIN: none. All 25 traces in this file class the same on the stable binary (main) as on the unstable one.
