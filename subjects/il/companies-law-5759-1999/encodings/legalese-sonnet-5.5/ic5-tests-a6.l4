IMPORT prelude
IMPORT daydate
IMPORT `ic-core`
IMPORT `ic5-parties`
IMPORT `ic5-a6-winding-up`

-- ic5-tests-a6: tests of ic5-a6-winding-up (sections 345יט to 345כג).
-- Every expected value below was decided from the section named beside it, before the run.

§ `בדיקות – סעיפים 345יט עד 345כג`

§§ `345יט – פירוק בידי בית משפט`

-- 345יט(א): wound up by the court under the Ordinance's provisions that continue to apply.
#ASSERT `סעיף 345יט(א) - פירוק בידי בית משפט לפי פקודת החברות ובכפוף לפרק` TRUE
#ASSERT NOT (`סעיף 345יט(א) - פירוק בידי בית משפט לפי פקודת החברות ובכפוף לפרק` FALSE)
-- 345יט(ב): either of the two added grounds, or a ground under the Ordinance or the Law.
#ASSERT `סעיף 345יט(ב) - בית המשפט רשאי לפרק חברה לתועלת הציבור` TRUE FALSE FALSE
#ASSERT `סעיף 345יט(ב) - בית המשפט רשאי לפרק חברה לתועלת הציבור` FALSE TRUE FALSE
#ASSERT `סעיף 345יט(ב) - בית המשפט רשאי לפרק חברה לתועלת הציבור` FALSE FALSE TRUE
#ASSERT NOT (`סעיף 345יט(ב) - בית המשפט רשאי לפרק חברה לתועלת הציבור` FALSE FALSE FALSE)
-- 345יט(ג): who may apply: the Attorney General or the Registrar of Endowments on a (b) ground; the Registrar of Endowments also on a section 257 ground.
#ASSERT `סעיף 345יט(ג) - מי שרשאי להגיש בקשת פירוק` `היועץ המשפטי לממשלה (פרק 1א)` TRUE FALSE EQUALS `הסעיף מתיר להגיש את הבקשה`
#ASSERT `סעיף 345יט(ג) - מי שרשאי להגיש בקשת פירוק` `רשם ההקדשות (פרק 1א)` TRUE FALSE EQUALS `הסעיף מתיר להגיש את הבקשה`
#ASSERT `סעיף 345יט(ג) - מי שרשאי להגיש בקשת פירוק` `אדם אחר (פרק 1א)` TRUE FALSE EQUALS `הסעיף שולל את הגשת הבקשה`
#ASSERT `סעיף 345יט(ג) - מי שרשאי להגיש בקשת פירוק` `רשם ההקדשות (פרק 1א)` FALSE TRUE EQUALS `הסעיף מתיר להגיש את הבקשה`
-- On a section 257 ground the section adds only the Registrar of Endowments; for others it says nothing and the Ordinance applies.
#ASSERT `סעיף 345יט(ג) - מי שרשאי להגיש בקשת פירוק` `היועץ המשפטי לממשלה (פרק 1א)` FALSE TRUE EQUALS `הסעיף אינו קובע, ודין פקודת החברות חל`
#ASSERT `סעיף 345יט(ג) - מי שרשאי להגיש בקשת פירוק` `אדם אחר (פרק 1א)` FALSE TRUE EQUALS `הסעיף אינו קובע, ודין פקודת החברות חל`
#ASSERT `סעיף 345יט(ג) - מי שרשאי להגיש בקשת פירוק` `רשם ההקדשות (פרק 1א)` FALSE FALSE EQUALS `הסעיף אינו קובע, ודין פקודת החברות חל`
-- 345יט(ד): no application on the (b)(1) ground, or by the Registrar of Endowments on section 257(5), unless warned in writing, the time ran, and the company did not correct.
#ASSERT `סעיף 345יט(ד) - אסור להגיש כעת את בקשת הפירוק` TRUE FALSE FALSE FALSE FALSE
#ASSERT `סעיף 345יט(ד) - אסור להגיש כעת את בקשת הפירוק` FALSE TRUE FALSE FALSE FALSE
#ASSERT `סעיף 345יט(ד) - אסור להגיש כעת את בקשת הפירוק` TRUE FALSE TRUE FALSE FALSE
#ASSERT `סעיף 345יט(ד) - אסור להגיש כעת את בקשת הפירוק` TRUE FALSE TRUE TRUE TRUE
#ASSERT NOT (`סעיף 345יט(ד) - אסור להגיש כעת את בקשת הפירוק` TRUE FALSE TRUE TRUE FALSE)
#ASSERT NOT (`סעיף 345יט(ד) - אסור להגיש כעת את בקשת הפירוק` FALSE TRUE TRUE TRUE FALSE)
-- Neither of the two grounds: this subsection does not bar the application.
#ASSERT NOT (`סעיף 345יט(ד) - אסור להגיש כעת את בקשת הפירוק` FALSE FALSE FALSE FALSE FALSE)

§§ `345כ – פירוק מרצון`

-- 345כ(א)(1): a majority (more than half) of the directors and of the audit committee members.
#ASSERT `סעיף 345כ(א)(1) - התצהיר נערך בידי מרבית הדירקטורים ומרבית חברי ועדת הביקורת` 5 3 3 2
#ASSERT NOT (`סעיף 345כ(א)(1) - התצהיר נערך בידי מרבית הדירקטורים ומרבית חברי ועדת הביקורת` 4 2 3 2)
#ASSERT NOT (`סעיף 345כ(א)(1) - התצהיר נערך בידי מרבית הדירקטורים ומרבית חברי ועדת הביקורת` 5 3 4 2)
#ASSERT NOT (`סעיף 345כ(א)(1) - התצהיר נערך בידי מרבית הדירקטורים ומרבית חברי ועדת הביקורת` 5 2 3 2)
-- 345כ(א)(1): filed at least 21 days before the invitations: 1 March + 21 days = 22 March.
#ASSERT `סעיף 345כ(א)(1) - התצהיר הוגש 21 ימים לפחות לפני משלוח ההזמנות` (YMD 2026 3 1) (YMD 2026 3 22)
#ASSERT `סעיף 345כ(א)(1) - התצהיר הוגש 21 ימים לפחות לפני משלוח ההזמנות` (YMD 2026 3 1) (YMD 2026 4 1)
#ASSERT NOT (`סעיף 345כ(א)(1) - התצהיר הוגש 21 ימים לפחות לפני משלוח ההזמנות` (YMD 2026 3 1) (YMD 2026 3 21))
-- 345כ(א)(1): the determining date is 31 December of the year before the filing year.
#ASSERT `סעיף 345כ(א)(1) - המועד הקובע` (YMD 2026 3 10) EQUALS YMD 2025 12 31
#ASSERT `סעיף 345כ(א)(1) - המועד הקובע` (YMD 2026 1 15) EQUALS YMD 2025 12 31
#ASSERT `סעיף 345כ(א)(1) - המועד הקובע` (YMD 2024 12 31) EQUALS YMD 2023 12 31
-- ... two months after 31 December is the last day of February (28 in 2026, 29 in 2024); a reviewed statement is needed only after that.
#ASSERT `סעיף 345כ(א)(1) - סוף חודשיים מהמועד הקובע` (YMD 2026 3 10) EQUALS YMD 2026 2 28
#ASSERT `סעיף 345כ(א)(1) - סוף חודשיים מהמועד הקובע` (YMD 2024 5 1) EQUALS YMD 2024 2 29
#ASSERT NOT (`סעיף 345כ(א)(1) - נדרש גם דוח כספי סקור` (YMD 2026 1 31))
#ASSERT NOT (`סעיף 345כ(א)(1) - נדרש גם דוח כספי סקור` (YMD 2026 2 28))
#ASSERT `סעיף 345כ(א)(1) - נדרש גם דוח כספי סקור` (YMD 2026 3 1)
#ASSERT NOT (`סעיף 345כ(א)(1) - נדרש גם דוח כספי סקור` (YMD 2024 2 29))
#ASSERT `סעיף 345כ(א)(1) - נדרש גם דוח כספי סקור` (YMD 2024 3 1)
-- 345כ(א)(1): the statements underlying the affidavit.
#ASSERT `סעיף 345כ(א)(1) - הדוחות שבבסיס התצהיר כנדרש` TRUE FALSE FALSE TRUE
#ASSERT `סעיף 345כ(א)(1) - הדוחות שבבסיס התצהיר כנדרש` TRUE TRUE TRUE TRUE
#ASSERT NOT (`סעיף 345כ(א)(1) - הדוחות שבבסיס התצהיר כנדרש` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`סעיף 345כ(א)(1) - הדוחות שבבסיס התצהיר כנדרש` FALSE FALSE FALSE TRUE)
#ASSERT NOT (`סעיף 345כ(א)(1) - הדוחות שבבסיס התצהיר כנדרש` TRUE FALSE FALSE FALSE)
-- 345כ(א)(2) and the whole of (a): the Ordinance's conditions plus the affidavit and the notice.
#ASSERT `סעיף 345כ(א)(2) - החברה מסרה הודעה על החלטת הפירוק` TRUE
#ASSERT NOT (`סעיף 345כ(א)(2) - החברה מסרה הודעה על החלטת הפירוק` FALSE)
#ASSERT `סעיף 345כ(א) - חברה לתועלת הציבור רשאית להתפרק מרצון` TRUE TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`סעיף 345כ(א) - חברה לתועלת הציבור רשאית להתפרק מרצון` FALSE TRUE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`סעיף 345כ(א) - חברה לתועלת הציבור רשאית להתפרק מרצון` TRUE FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`סעיף 345כ(א) - חברה לתועלת הציבור רשאית להתפרק מרצון` TRUE TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`סעיף 345כ(א) - חברה לתועלת הציבור רשאית להתפרק מרצון` TRUE TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`סעיף 345כ(א) - חברה לתועלת הציבור רשאית להתפרק מרצון` TRUE TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`סעיף 345כ(א) - חברה לתועלת הציבור רשאית להתפרק מרצון` TRUE TRUE TRUE TRUE TRUE FALSE)
-- 345כ(ב): publication within seven days: 10 May 2026 + 7 days = 17 May 2026.
#ASSERT `סעיף 345כ(ב) - המועד האחרון לפרסום ההחלטה` (YMD 2026 5 10) EQUALS YMD 2026 5 17
#ASSERT `סעיף 345כ(ב) - ההחלטה פורסמה כנדרש` (YMD 2026 5 10) (YMD 2026 5 17) TRUE FALSE FALSE
#ASSERT NOT (`סעיף 345כ(ב) - ההחלטה פורסמה כנדרש` (YMD 2026 5 10) (YMD 2026 5 18) TRUE FALSE FALSE)
#ASSERT NOT (`סעיף 345כ(ב) - ההחלטה פורסמה כנדרש` (YMD 2026 5 10) (YMD 2026 5 12) FALSE FALSE FALSE)
#ASSERT NOT (`סעיף 345כ(ב) - ההחלטה פורסמה כנדרש` (YMD 2026 5 10) (YMD 2026 5 12) TRUE TRUE FALSE)
#ASSERT `סעיף 345כ(ב) - ההחלטה פורסמה כנדרש` (YMD 2026 5 10) (YMD 2026 5 12) TRUE TRUE TRUE
#ASSERT `סעיף 345כ(ב) - רשם ההקדשות רשאי להורות על פרסום בדרכים אחרות` TRUE
#ASSERT NOT (`סעיף 345כ(ב) - רשם ההקדשות רשאי להורות על פרסום בדרכים אחרות` FALSE)
-- 345כ(ג): the court may direct that the winding up be by the court: voluntary winding up, the Registrar of Endowments asked, and a public interest found.
#ASSERT `סעיף 345כ(ג) - בית המשפט רשאי להורות שהפירוק יהיה בידי בית המשפט` TRUE TRUE TRUE
#ASSERT NOT (`סעיף 345כ(ג) - בית המשפט רשאי להורות שהפירוק יהיה בידי בית המשפט` FALSE TRUE TRUE)
#ASSERT NOT (`סעיף 345כ(ג) - בית המשפט רשאי להורות שהפירוק יהיה בידי בית המשפט` TRUE FALSE TRUE)
#ASSERT NOT (`סעיף 345כ(ג) - בית המשפט רשאי להורות שהפירוק יהיה בידי בית המשפט` TRUE TRUE FALSE)
-- 345כ(ד): the liquidator's reports in a voluntary winding up are approved by the audit committee.
#ASSERT `סעיף 345כ(ד) - דוח המפרק מאושר כדין` TRUE TRUE
#ASSERT NOT (`סעיף 345כ(ד) - דוח המפרק מאושר כדין` TRUE FALSE)
#ASSERT `סעיף 345כ(ד) - דוח המפרק מאושר כדין` FALSE FALSE

§§ `345כא – הוראות כלליות לענין פירוק`

-- 345כא(א).
#ASSERT `סעיף 345כא(א) - בעל מניות אינו זכאי בפירוק לחלק בנכסי החברה רק בשל היותו בעל מניות` TRUE
#ASSERT NOT (`סעיף 345כא(א) - בעל מניות אינו זכאי בפירוק לחלק בנכסי החברה רק בשל היותו בעל מניות` FALSE)
-- 345כא(ב), (ג): leftover assets. Args: fixed-to-return-to-transferor, articles' provisions exist and workable, wound up by court, court persuaded, Registrar of Endowments persuaded.
#ASSERT `סעיף 345כא(ב) - מה נעשה בנכסים שנותרו לאחר פירעון החובות` FALSE TRUE TRUE TRUE FALSE EQUALS `ינהגו בנכסים לפי הוראות התקנון`
#ASSERT `סעיף 345כא(ב) - מה נעשה בנכסים שנותרו לאחר פירעון החובות` FALSE TRUE FALSE FALSE TRUE EQUALS `ינהגו בנכסים לפי הוראות התקנון`
#ASSERT `סעיף 345כא(ב) - מה נעשה בנכסים שנותרו לאחר פירעון החובות` FALSE TRUE TRUE FALSE TRUE EQUALS `הנכסים יועברו למטרה ציבורית שבית המשפט יקבע כקרובה למטרות החברה`
#ASSERT `סעיף 345כא(ב) - מה נעשה בנכסים שנותרו לאחר פירעון החובות` FALSE TRUE FALSE TRUE FALSE EQUALS `הנכסים יועברו למטרה ציבורית שבית המשפט יקבע כקרובה למטרות החברה`
#ASSERT `סעיף 345כא(ב) - מה נעשה בנכסים שנותרו לאחר פירעון החובות` FALSE FALSE TRUE TRUE TRUE EQUALS `הנכסים יועברו למטרה ציבורית שבית המשפט יקבע כקרובה למטרות החברה`
-- (c): an asset fixed to return to the transferor is outside (b).
#ASSERT `סעיף 345כא(ב) - מה נעשה בנכסים שנותרו לאחר פירעון החובות` TRUE TRUE TRUE TRUE TRUE EQUALS `הנכס יועבר לפי הקבוע בהסכם או בתקנון למעביר או למי שהמעביר קבע`
#ASSERT `סעיף 345כא(ב) - מה נעשה בנכסים שנותרו לאחר פירעון החובות` TRUE FALSE FALSE FALSE FALSE EQUALS `הנכס יועבר לפי הקבוע בהסכם או בתקנון למעביר או למי שהמעביר קבע`

