IMPORT prelude
IMPORT daydate
IMPORT `ic-core`
IMPORT `ic6-foreign-company`

-- Tests of ic6-foreign-company.l4 (Part 9 chapter 2). Every expected value is written by hand from the text of the section named beside it;
-- none is copied from the rule's own output. "Day 0" is the day of the event; the last day of a period is inside it (fork register, entry F-ic6-2).

§ `בדיקות – חלק 9 פרק 2: חברת חוץ`

§§ `סעיף 346(א): רשאית לקיים מקום עסקים רק אם נרשמה ושילמה`

-- 346(א): both conditions are needed.
#ASSERT `סעיף 346(א) - חברת חוץ רשאית לקיים בישראל מקום עסקים` TRUE TRUE
#ASSERT NOT (`סעיף 346(א) - חברת חוץ רשאית לקיים בישראל מקום עסקים` TRUE FALSE)
#ASSERT NOT (`סעיף 346(א) - חברת חוץ רשאית לקיים בישראל מקום עסקים` FALSE TRUE)
#ASSERT NOT (`סעיף 346(א) - חברת חוץ רשאית לקיים בישראל מקום עסקים` FALSE FALSE)

§§ `סעיף 346(ב): מועד הבקשה ומסמכיה`

-- 346(ב): a month after 15 January 2026 ends on 15 February 2026, and that last day is inside the period.
#ASSERT `סעיף 346(ב) - הבקשה לרישום הוגשה בתוך חודש לאחר הקמת מקום העסקים` (YMD 2026 1 15) (YMD 2026 2 15)
#ASSERT NOT (`סעיף 346(ב) - הבקשה לרישום הוגשה בתוך חודש לאחר הקמת מקום העסקים` (YMD 2026 1 15) (YMD 2026 2 16))
-- A place of business set up on 31 January has no 31 February: the period ends on the last day of February (reading F-ic6-2).
#ASSERT `סעיף 346(ב) - הבקשה לרישום הוגשה בתוך חודש לאחר הקמת מקום העסקים` (YMD 2026 1 31) (YMD 2026 2 28)
#ASSERT NOT (`סעיף 346(ב) - הבקשה לרישום הוגשה בתוך חודש לאחר הקמת מקום העסקים` (YMD 2026 1 31) (YMD 2026 3 1))
-- An application filed on the day the place of business was set up is in time.
#ASSERT `סעיף 346(ב) - הבקשה לרישום הוגשה בתוך חודש לאחר הקמת מקום העסקים` (YMD 2026 5 10) (YMD 2026 5 10)

-- The documents of 346(ב)(1) to (4) and (ד), built positionally (there is no record-update operator). The columns, in the order of the DECLARE:
--   copy of the incorporation documents, filed in Hebrew or English, translation, list of directors, authorised person with name and address,
--   digital address complete, power of attorney, the Minister's further documents.

-- Everything attached, the documents needing a translation and having one.
#ASSERT `סעיף 346(ב) - צורפו לבקשה כל המסמכים הנדרשים` (`מסמכים שצורפו לבקשה לרישום חברת חוץ` OF TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE)
-- (1): the translation is not needed if the documents were filed in Hebrew or English; it is needed otherwise.
#ASSERT `סעיף 346(ב) - צורפו לבקשה כל המסמכים הנדרשים` (`מסמכים שצורפו לבקשה לרישום חברת חוץ` OF TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE)
#ASSERT NOT (`סעיף 346(ב) - צורפו לבקשה כל המסמכים הנדרשים` (`מסמכים שצורפו לבקשה לרישום חברת חוץ` OF TRUE, FALSE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE))
#ASSERT NOT (`סעיף 346(ב) - צורפו לבקשה כל המסמכים הנדרשים` (`מסמכים שצורפו לבקשה לרישום חברת חוץ` OF FALSE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE))
-- (2), (3), (4), (ד): each is needed.
#ASSERT NOT (`סעיף 346(ב) - צורפו לבקשה כל המסמכים הנדרשים` (`מסמכים שצורפו לבקשה לרישום חברת חוץ` OF TRUE, FALSE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE))
#ASSERT NOT (`סעיף 346(ב) - צורפו לבקשה כל המסמכים הנדרשים` (`מסמכים שצורפו לבקשה לרישום חברת חוץ` OF TRUE, FALSE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE))
#ASSERT NOT (`סעיף 346(ב) - צורפו לבקשה כל המסמכים הנדרשים` (`מסמכים שצורפו לבקשה לרישום חברת חוץ` OF TRUE, FALSE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE))
#ASSERT NOT (`סעיף 346(ב) - צורפו לבקשה כל המסמכים הנדרשים` (`מסמכים שצורפו לבקשה לרישום חברת חוץ` OF TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE))
#ASSERT NOT (`סעיף 346(ב) - צורפו לבקשה כל המסמכים הנדרשים` (`מסמכים שצורפו לבקשה לרישום חברת חוץ` OF TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE))

§§ `סעיף 346(ג), (ג1), (ד)`

-- 346(ג): a change is reported within 14 days of the change; day 14 is in time and day 15 is not; with no change there is no duty.
#ASSERT `סעיף 346(ג) - החברה עמדה בחובת ההודעה על שינוי` TRUE (YMD 2026 3 1) (YMD 2026 3 15)
#ASSERT NOT (`סעיף 346(ג) - החברה עמדה בחובת ההודעה על שינוי` TRUE (YMD 2026 3 1) (YMD 2026 3 16))
#ASSERT `סעיף 346(ג) - החברה עמדה בחובת ההודעה על שינוי` FALSE (YMD 2026 3 1) (YMD 2027 3 1)
-- 14 days from 20 February 2026 is 6 March 2026 (February 2026 has 28 days).
#ASSERT `סעיף 346(ג) - החברה עמדה בחובת ההודעה על שינוי` TRUE (YMD 2026 2 20) (YMD 2026 3 6)
#ASSERT NOT (`סעיף 346(ג) - החברה עמדה בחובת ההודעה על שינוי` TRUE (YMD 2026 2 20) (YMD 2026 3 7))

-- 346(ג1): the entry is due only when the other Law's conditions are met and the Registrar has made sure the address is in order and active.
#ASSERT `סעיף 346(ג1) - הרשם צריך לרשום את המען הדיגיטלי` TRUE TRUE
#ASSERT NOT (`סעיף 346(ג1) - הרשם צריך לרשום את המען הדיגיטלי` TRUE FALSE)
#ASSERT NOT (`סעיף 346(ג1) - הרשם צריך לרשום את המען הדיגיטלי` FALSE TRUE)

-- 346(ד): a further document required by the Minister must be attached; none required, nothing to attach.
#ASSERT `סעיף 346(ד) - המסמכים הנוספים שקבע השר צורפו` FALSE FALSE
#ASSERT `סעיף 346(ד) - המסמכים הנוספים שקבע השר צורפו` TRUE TRUE
#ASSERT NOT (`סעיף 346(ד) - המסמכים הנוספים שקבע השר צורפו` TRUE FALSE)

§§ `סעיפים 347 ו־348`

-- 347: service on the authorised person at the notified address, by leaving it there or by post.
#ASSERT `סעיף 347 - יראו את כתב בי־דין או ההודעה כאילו הומצאו כדין לחברת חוץ` TRUE TRUE TRUE FALSE
#ASSERT `סעיף 347 - יראו את כתב בי־דין או ההודעה כאילו הומצאו כדין לחברת חוץ` TRUE TRUE FALSE TRUE
#ASSERT NOT (`סעיף 347 - יראו את כתב בי־דין או ההודעה כאילו הומצאו כדין לחברת חוץ` TRUE TRUE FALSE FALSE)
#ASSERT NOT (`סעיף 347 - יראו את כתב בי־דין או ההודעה כאילו הומצאו כדין לחברת חוץ` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`סעיף 347 - יראו את כתב בי־דין או ההודעה כאילו הומצאו כדין לחברת חוץ` FALSE TRUE TRUE TRUE)

-- 348: with no earlier report the text gives no due date (NOTHING); with one, the next is due within twelve months of it, in the Minister's form.
#ASSERT `סעיף 348 - חברת חוץ הגישה דין וחשבון שנתי כנדרש` NOTHING (YMD 2026 6 1) TRUE EQUALS NOTHING
#ASSERT `סעיף 348 - חברת חוץ הגישה דין וחשבון שנתי כנדרש` (JUST (YMD 2025 3 1)) (YMD 2026 3 1) TRUE EQUALS JUST TRUE
#ASSERT `סעיף 348 - חברת חוץ הגישה דין וחשבון שנתי כנדרש` (JUST (YMD 2025 3 1)) (YMD 2026 3 2) TRUE EQUALS JUST FALSE
#ASSERT `סעיף 348 - חברת חוץ הגישה דין וחשבון שנתי כנדרש` (JUST (YMD 2025 3 1)) (YMD 2026 2 1) FALSE EQUALS JUST FALSE

§§ `סעיף 349: עונשין`

-- 349: the violation of 346(א) is keeping a place of business without being registered and having paid.
#ASSERT `סעיף 349 - חברת חוץ הפרה את סעיף 346(א)` TRUE FALSE TRUE
#ASSERT `סעיף 349 - חברת חוץ הפרה את סעיף 346(א)` TRUE TRUE FALSE
#ASSERT NOT (`סעיף 349 - חברת חוץ הפרה את סעיף 346(א)` TRUE TRUE TRUE)
#ASSERT NOT (`סעיף 349 - חברת חוץ הפרה את סעיף 346(א)` FALSE FALSE FALSE)
-- The company is liable; an office-holder or agent is liable only if he took part in the violation.
#ASSERT `סעיף 349 - החברה חבה בקנס לפי סעיף 61(א)(2) לחוק העונשין` TRUE
#ASSERT NOT (`סעיף 349 - החברה חבה בקנס לפי סעיף 61(א)(2) לחוק העונשין` FALSE)
#ASSERT `סעיף 349 - נושא משרה או שלוח של חברת החוץ חב בקנס` TRUE TRUE TRUE
#ASSERT NOT (`סעיף 349 - נושא משרה או שלוח של חברת החוץ חב בקנס` TRUE TRUE FALSE)
#ASSERT NOT (`סעיף 349 - נושא משרה או שלוח של חברת החוץ חב בקנס` TRUE FALSE TRUE)
#ASSERT NOT (`סעיף 349 - נושא משרה או שלוח של חברת החוץ חב בקנס` FALSE TRUE TRUE)
-- The daily fine runs from the day of the Registrar's notice, that day counting: notice on 10 January, violation until 10 January is one day, until 19 January ten days.
#ASSERT `סעיף 349 - מספר הימים שבגינם נוסף קנס יומי` (YMD 2026 1 10) (YMD 2026 1 10) EQUALS 1
#ASSERT `סעיף 349 - מספר הימים שבגינם נוסף קנס יומי` (YMD 2026 1 10) (YMD 2026 1 19) EQUALS 10
-- A violation that ended before the notice has no day of continuing violation.
#ASSERT `סעיף 349 - מספר הימים שבגינם נוסף קנס יומי` (YMD 2026 1 10) (YMD 2026 1 9) EQUALS 0

§§ `סעיף 349א: חברת חוץ שהפסיקה לקיים מקום עסקים בישראל`

-- 349א(א): exempt from the day of the notice if it has stopped; NOTHING if it has not stopped or has not told the Registrar.
#ASSERT `סעיף 349א(א) - המועד שממנו חברת החוץ פטורה מחובותיה לפי הפרק` TRUE (JUST (YMD 2026 4 1)) EQUALS JUST (YMD 2026 4 1)
#ASSERT `סעיף 349א(א) - המועד שממנו חברת החוץ פטורה מחובותיה לפי הפרק` FALSE (JUST (YMD 2026 4 1)) EQUALS NOTHING
#ASSERT `סעיף 349א(א) - המועד שממנו חברת החוץ פטורה מחובותיה לפי הפרק` TRUE NOTHING EQUALS NOTHING
-- For the fee, the Minister may fix an earlier day; a later day does not postpone the exemption.
#ASSERT `סעיף 349א(א) - המועד שממנו חברת החוץ פטורה מחובת תשלום אגרה` (JUST (YMD 2026 4 1)) (JUST (YMD 2026 1 1)) EQUALS JUST (YMD 2026 1 1)
#ASSERT `סעיף 349א(א) - המועד שממנו חברת החוץ פטורה מחובת תשלום אגרה` (JUST (YMD 2026 4 1)) (JUST (YMD 2026 6 1)) EQUALS JUST (YMD 2026 4 1)
#ASSERT `סעיף 349א(א) - המועד שממנו חברת החוץ פטורה מחובת תשלום אגרה` (JUST (YMD 2026 4 1)) NOTHING EQUALS JUST (YMD 2026 4 1)
#ASSERT `סעיף 349א(א) - המועד שממנו חברת החוץ פטורה מחובת תשלום אגרה` NOTHING (JUST (YMD 2026 1 1)) EQUALS NOTHING
-- 349א(ב): still bound by 346(ב)(3) unless another address for service was given; no court permission is needed if that address is abroad and the documents concern its Israeli activity.
#ASSERT `סעיף 349א(ב) - חברת חוץ נשארה חייבת בחובה שבסעיף 346(ב)(3)` TRUE FALSE
#ASSERT NOT (`סעיף 349א(ב) - חברת חוץ נשארה חייבת בחובה שבסעיף 346(ב)(3)` TRUE TRUE)
#ASSERT NOT (`סעיף 349א(ב) - חברת חוץ נשארה חייבת בחובה שבסעיף 346(ב)(3)` FALSE FALSE)
#ASSERT `סעיף 349א(ב) - אין צורך בהיתר בית משפט להמצאת כתבי בי־דין לחברת חוץ` TRUE TRUE TRUE
#ASSERT NOT (`סעיף 349א(ב) - אין צורך בהיתר בית משפט להמצאת כתבי בי־דין לחברת חוץ` TRUE FALSE TRUE)
#ASSERT NOT (`סעיף 349א(ב) - אין צורך בהיתר בית משפט להמצאת כתבי בי־דין לחברת חוץ` TRUE TRUE FALSE)
#ASSERT NOT (`סעיף 349א(ב) - אין צורך בהיתר בית משפט להמצאת כתבי בי־דין לחברת חוץ` FALSE TRUE TRUE)
