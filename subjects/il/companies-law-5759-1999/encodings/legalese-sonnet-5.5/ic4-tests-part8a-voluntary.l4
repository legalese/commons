IMPORT prelude
IMPORT daydate
IMPORT `ic-core`
IMPORT `ic4-nouns`
IMPORT `ic4-part8a-general-court`
IMPORT `ic4-part8a-voluntary`

-- ic4-tests-part8a-voluntary: tests of ic4-part8a-voluntary.l4 (sections 342כד to 342מ).
-- Every expected value is decided from the text of the section (Hebrew, src:2353-2426) before the run, and written beside the assertion.
-- Boundary values are tested on each side of every figure the text states: more than half of the directors, 12 months, 90 days, 21 days, seven days, one month, seven years.

§ `בדיקות: חלק 8א פרק ג, פירוק מרצון`

§§ `סעיפים 342כד ו־342כה`

#ASSERT `סעיף 342כד - החברה רשאית לקבל החלטה מיוחדת על פירוקה מרצון` TRUE
#ASSERT NOT (`סעיף 342כד - החברה רשאית לקבל החלטה מיוחדת על פירוקה מרצון` FALSE)
-- A special resolution with the directors' solvency affidavit is a valid resolution on voluntary dissolution; without the affidavit it is not.
#ASSERT `סעיף 342כד - החלטה על פירוק מרצון שקיבלה החברה בתוקף` TRUE TRUE
#ASSERT NOT (`סעיף 342כד - החלטה על פירוק מרצון שקיבלה החברה בתוקף` TRUE FALSE)
#ASSERT NOT (`סעיף 342כד - החלטה על פירוק מרצון שקיבלה החברה בתוקף` FALSE TRUE)
-- (342כה) Five directors, all five gave the affidavit, declared a twelve-month payment horizon: given as the section requires.
#ASSERT `סעיף 342כה - תצהיר כושר פירעון ניתן כדין` 5 5 TRUE TRUE 12
-- Three of five is most of them (more than half).
#ASSERT `סעיף 342כה - תצהיר כושר פירעון ניתן כדין` 5 3 TRUE TRUE 12
-- Two of five is not most of them.
#ASSERT NOT (`סעיף 342כה - תצהיר כושר פירעון ניתן כדין` 5 2 TRUE TRUE 12)
-- Two of four is exactly half: not most of them. Three of four is.
#ASSERT NOT (`סעיף 342כה - תצהיר כושר פירעון ניתן כדין` 4 2 TRUE TRUE 12)
#ASSERT `סעיף 342כה - תצהיר כושר פירעון ניתן כדין` 4 3 TRUE TRUE 12
-- A sole director who gave it.
#ASSERT `סעיף 342כה - תצהיר כושר פירעון ניתן כדין` 1 1 TRUE TRUE 12
-- Thirteen months is outside the twelve months of the section; twelve is inside.
#ASSERT NOT (`סעיף 342כה - תצהיר כושר פירעון ניתן כדין` 5 5 TRUE TRUE 13)
#ASSERT `סעיף 342כה - תצהיר כושר פירעון ניתן כדין` 5 5 TRUE TRUE 6
-- The directors must declare that they examined the company's affairs thoroughly, and that the company can pay.
#ASSERT NOT (`סעיף 342כה - תצהיר כושר פירעון ניתן כדין` 5 5 FALSE TRUE 12)
#ASSERT NOT (`סעיף 342כה - תצהיר כושר פירעון ניתן כדין` 5 5 TRUE FALSE 12)
-- A company with no directors gives no affidavit.
#ASSERT NOT (`סעיף 342כה - תצהיר כושר פירעון ניתן כדין` 0 0 TRUE TRUE 12)

§§ `סעיפים 342כו ו־342כז`

-- The meeting must be convened after the affidavit and within 90 days of it: day 90 inside, day 91 outside.
#ASSERT `סעיף 342כו(א) - כינוס האסיפה הכללית בתוך 90 ימים ממתן תצהיר כושר הפירעון` TRUE TRUE 90 EQUALS `קויימה בתוך המועד`
#ASSERT `סעיף 342כו(א) - כינוס האסיפה הכללית בתוך 90 ימים ממתן תצהיר כושר הפירעון` TRUE TRUE 91 EQUALS `קויימה באיחור`
#ASSERT `סעיף 342כו(א) - כינוס האסיפה הכללית בתוך 90 ימים ממתן תצהיר כושר הפירעון` TRUE FALSE 90 EQUALS `טרם קויימה והמועד עדיין לא חלף`
#ASSERT `סעיף 342כו(א) - כינוס האסיפה הכללית בתוך 90 ימים ממתן תצהיר כושר הפירעון` TRUE FALSE 91 EQUALS `טרם קויימה והמועד חלף`
-- No affidavit given: the duty has not arisen.
#ASSERT `סעיף 342כו(א) - כינוס האסיפה הכללית בתוך 90 ימים ממתן תצהיר כושר הפירעון` FALSE FALSE 5 EQUALS `החובה אינה חלה`
-- The affidavit is attached to the invitation.
#ASSERT `סעיף 342כו(ב) - חובת צירוף תצהיר כושר הפירעון להזמנה לאסיפה` TRUE TRUE EQUALS `החובה חלה וקויימה`
#ASSERT `סעיף 342כו(ב) - חובת צירוף תצהיר כושר הפירעון להזמנה לאסיפה` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 342כו(ב) - חובת צירוף תצהיר כושר הפירעון להזמנה לאסיפה` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`
-- 342כז: the meeting appoints a trustee; it may fix his pay unless the pay would bring the company to insolvency.
#ASSERT `סעיף 342כז - חובת האסיפה הכללית למנות נאמן` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 342כז - חובת האסיפה הכללית למנות נאמן` TRUE TRUE EQUALS `החובה חלה וקויימה`
#ASSERT `סעיף 342כז - חובת האסיפה הכללית למנות נאמן` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`
#ASSERT `סעיף 342כז - האסיפה הכללית רשאית לקבוע את שכר הנאמן` FALSE
#ASSERT NOT (`סעיף 342כז - האסיפה הכללית רשאית לקבוע את שכר הנאמן` TRUE)

§§ `סעיפים 342כח עד 342ל`

#ASSERT `סעיף 342כח(א) - יום תחילת הפירוק מרצון` (YMD 2026 3 15) EQUALS YMD 2026 3 15
-- Before the dissolution begins the company may carry on its business; after, only what its beneficial dissolution requires.
#ASSERT `סעיף 342כח(ב) - מותר לחברה לנהל את העסק או לעשות את הפעולה` FALSE FALSE
#ASSERT `סעיף 342כח(ב) - מותר לחברה לנהל את העסק או לעשות את הפעולה` TRUE TRUE
#ASSERT NOT (`סעיף 342כח(ב) - מותר לחברה לנהל את העסק או לעשות את הפעולה` TRUE FALSE)
-- 342כט: written notice to the known creditors within 21 days of the resolution.
#ASSERT `סעיף 342כט - הודעת הנאמן בכתב לנושים הידועים בתוך 21 ימים מיום קבלת ההחלטה` TRUE TRUE 21 EQUALS `קויימה בתוך המועד`
#ASSERT `סעיף 342כט - הודעת הנאמן בכתב לנושים הידועים בתוך 21 ימים מיום קבלת ההחלטה` TRUE TRUE 22 EQUALS `קויימה באיחור`
#ASSERT `סעיף 342כט - הודעת הנאמן בכתב לנושים הידועים בתוך 21 ימים מיום קבלת ההחלטה` TRUE FALSE 21 EQUALS `טרם קויימה והמועד עדיין לא חלף`
#ASSERT `סעיף 342כט - הודעת הנאמן בכתב לנושים הידועים בתוך 21 ימים מיום קבלת ההחלטה` TRUE FALSE 22 EQUALS `טרם קויימה והמועד חלף`
#ASSERT `סעיף 342כט - הודעת הנאמן בכתב לנושים הידועים בתוך 21 ימים מיום קבלת ההחלטה` FALSE FALSE 99 EQUALS `החובה אינה חלה`
-- 342ל(א): notice to the Registrar within 21 days, with the affidavit attached.
#ASSERT `סעיף 342ל(א) - הודעת הנאמן לרשם בתוך 21 ימים מיום קבלת ההחלטה` TRUE TRUE 21 EQUALS `קויימה בתוך המועד`
#ASSERT `סעיף 342ל(א) - הודעת הנאמן לרשם בתוך 21 ימים מיום קבלת ההחלטה` TRUE TRUE 22 EQUALS `קויימה באיחור`
-- A notice sent without the affidavit (and the documents) does not count as sent.
#ASSERT `סעיף 342ל(א) - הודעת הנאמן לרשם בתוך 21 ימים מיום קבלת ההחלטה` TRUE FALSE 10 EQUALS `טרם קויימה והמועד עדיין לא חלף`
#ASSERT `סעיף 342ל(א) - הודעת הנאמן לרשם בתוך 21 ימים מיום קבלת ההחלטה` TRUE FALSE 25 EQUALS `טרם קויימה והמועד חלף`
-- 342ל(ב): the Registrar registers a note once the notice was sent and he was satisfied the conditions were met.
#ASSERT `סעיף 342ל(ב) - חובת הרשם לרשום הערה על פירוק מרצון` TRUE TRUE FALSE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 342ל(ב) - חובת הרשם לרשום הערה על פירוק מרצון` TRUE TRUE TRUE EQUALS `החובה חלה וקויימה`
-- Not satisfied: the duty has not arisen.
#ASSERT `סעיף 342ל(ב) - חובת הרשם לרשום הערה על פירוק מרצון` TRUE FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`
#ASSERT `סעיף 342ל(ג) - חובת הרשם לפרסם את ההערה על פירוק מרצון` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 342ל(ג) - חובת הרשם לפרסם את ההערה על פירוק מרצון` TRUE TRUE EQUALS `החובה חלה וקויימה`

§§ `סעיפים 342לא עד 342לה`

#ASSERT `סעיף 342לא(א) - חובת הנאמן לפעול במהירות האפשרית להשלמת הפירוק מרצון` TRUE TRUE TRUE TRUE EQUALS `החובה חלה וקויימה`
#ASSERT `סעיף 342לא(א) - חובת הנאמן לפעול במהירות האפשרית להשלמת הפירוק מרצון` TRUE TRUE FALSE TRUE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 342לא(א) - חובת הנאמן לפעול במהירות האפשרית להשלמת הפירוק מרצון` FALSE TRUE TRUE TRUE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`
-- The powers pass to the trustee unless the general meeting left them with the board or the general manager.
#ASSERT `סעיף 342לא(ב) - הסמכות עוברת מהדירקטוריון ומהמנהל הכללי לנאמן` TRUE FALSE
#ASSERT NOT (`סעיף 342לא(ב) - הסמכות עוברת מהדירקטוריון ומהמנהל הכללי לנאמן` TRUE TRUE)
#ASSERT NOT (`סעיף 342לא(ב) - הסמכות עוברת מהדירקטוריון ומהמנהל הכללי לנאמן` FALSE FALSE)
-- An ordinary power: no special resolution needed. The two named powers: only after approval by a special resolution.
#ASSERT `סעיף 342לא(ב) - הנאמן רשאי להפעיל את הסמכות` FALSE FALSE FALSE
#ASSERT NOT (`סעיף 342לא(ב) - הנאמן רשאי להפעיל את הסמכות` TRUE FALSE FALSE)
#ASSERT `סעיף 342לא(ב) - הנאמן רשאי להפעיל את הסמכות` TRUE FALSE TRUE
#ASSERT NOT (`סעיף 342לא(ב) - הנאמן רשאי להפעיל את הסמכות` FALSE TRUE FALSE)
#ASSERT `סעיף 342לא(ב) - הנאמן רשאי להפעיל את הסמכות` FALSE TRUE TRUE
-- 342לב: ending the trustee's tenure needs a reasonable opportunity for him to be heard.
#ASSERT `סעיף 342לב(א) - האסיפה הכללית רשאית להחליט על הפסקת כהונתו של הנאמן` TRUE
#ASSERT NOT (`סעיף 342לב(א) - האסיפה הכללית רשאית להחליט על הפסקת כהונתו של הנאמן` FALSE)
#ASSERT `סעיף 342לב(ב) - חובת האסיפה הכללית למנות נאמן אחר` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 342לב(ב) - חובת האסיפה הכללית למנות נאמן אחר` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`
#ASSERT `סעיף 342לב(ב) - כל בעל מניה רשאי לכנס אסיפה כללית למינוי נאמן` TRUE
#ASSERT NOT (`סעיף 342לב(ב) - כל בעל מניה רשאי לכנס אסיפה כללית למינוי נאמן` FALSE)
#ASSERT `סעיף 342לב(ג) - הודעת הנאמן החדש לרשם על מינויו בתוך 21 ימים` TRUE TRUE 21 EQUALS `קויימה בתוך המועד`
#ASSERT `סעיף 342לב(ג) - הודעת הנאמן החדש לרשם על מינויו בתוך 21 ימים` TRUE TRUE 22 EQUALS `קויימה באיחור`
-- 342לג: Insolvency Law provisions apply; the claims provisions yield to regulations under 342נד(1).
#ASSERT (`סעיף 342לג - הוראות חוק חדלות פירעון שחלות על הליכי פירוק מרצון` TRUE FALSE)'s `תביעות חוב ואישורן: פרק א׳ לחלק ד׳ לחוק חדלות פירעון והתקנות לפיו`
#ASSERT NOT ((`סעיף 342לג - הוראות חוק חדלות פירעון שחלות על הליכי פירוק מרצון` TRUE TRUE)'s `תביעות חוב ואישורן: פרק א׳ לחלק ד׳ לחוק חדלות פירעון והתקנות לפיו`)
#ASSERT (`סעיף 342לג - הוראות חוק חדלות פירעון שחלות על הליכי פירוק מרצון` TRUE TRUE)'s `הכללת נכסים בקופת הפירוק: סעיפים 216(1) ו־218 לחוק חדלות פירעון`
#ASSERT NOT ((`סעיף 342לג - הוראות חוק חדלות פירעון שחלות על הליכי פירוק מרצון` FALSE FALSE)'s `מימוש נכסי החברה בידי הנאמן: סעיף 227 לחוק חדלות פירעון`)
-- A proof of debt within 90 days of the public notice: day 90 inside, day 91 outside.
#ASSERT `סעיף 342לג(1) - הגשת תביעת חוב בתוך 90 ימים מפרסום ההודעה לציבור` TRUE TRUE 90 EQUALS `קויימה בתוך המועד`
#ASSERT `סעיף 342לג(1) - הגשת תביעת חוב בתוך 90 ימים מפרסום ההודעה לציבור` TRUE TRUE 91 EQUALS `קויימה באיחור`
#ASSERT `סעיף 342לג(1) - הגשת תביעת חוב בתוך 90 ימים מפרסום ההודעה לציבור` FALSE FALSE 5 EQUALS `החובה אינה חלה`
-- 342לד: the earlier payment sections apply; interim payments are approved by the general meeting.
#ASSERT `סעיף 342לד - סעיפים 342טז עד 342יח חלים בפירוק מרצון` TRUE
#ASSERT NOT (`סעיף 342לד - סעיפים 342טז עד 342יח חלים בפירוק מרצון` FALSE)
#ASSERT `סעיף 342לד - הנאמן רשאי לשלם תשלומי ביניים בפירוק מרצון` TRUE TRUE
#ASSERT NOT (`סעיף 342לד - הנאמן רשאי לשלם תשלומי ביניים בפירוק מרצון` FALSE TRUE)
#ASSERT NOT (`סעיף 342לד - הנאמן רשאי לשלם תשלומי ביניים בפירוק מרצון` TRUE FALSE)
-- 342לה: the trustee, a shareholder or a creditor may apply to the court.
#ASSERT `סעיף 342לה - הנאמן, בעל מניה או נושה רשאי לפנות לבית המשפט בשאלה הנוגעת להליכי הפירוק` TRUE FALSE FALSE
#ASSERT `סעיף 342לה - הנאמן, בעל מניה או נושה רשאי לפנות לבית המשפט בשאלה הנוגעת להליכי הפירוק` FALSE TRUE FALSE
#ASSERT `סעיף 342לה - הנאמן, בעל מניה או נושה רשאי לפנות לבית המשפט בשאלה הנוגעת להליכי הפירוק` FALSE FALSE TRUE
#ASSERT NOT (`סעיף 342לה - הנאמן, בעל מניה או נושה רשאי לפנות לבית המשפט בשאלה הנוגעת להליכי הפירוק` FALSE FALSE FALSE)

§§ `סעיפים 342לו עד 342מ`

#ASSERT `סעיף 342לו(א) - הנאמן רשאי לכנס אסיפה כללית ולהביא לאישורה כל עניין` TRUE
#ASSERT NOT (`סעיף 342לו(א) - הנאמן רשאי לכנס אסיפה כללית ולהביא לאישורה כל עניין` FALSE)
-- A dissolution that began on 15 March 2026: the first year ends on 15 March 2027.
#ASSERT `סעיף 342לו(ב) - יום סיום השנה הראשונה של הפירוק` (YMD 2026 3 15) EQUALS YMD 2027 3 15
-- A meeting is due on that day, and at the end of each calendar year from 2027 on; not on other days.
#ASSERT `סעיף 342לו(ב) - הנאמן חייב לכנס אסיפה כללית ולהגיש דוח ביום הנבדק` (YMD 2026 3 15) (YMD 2027 3 15)
#ASSERT `סעיף 342לו(ב) - הנאמן חייב לכנס אסיפה כללית ולהגיש דוח ביום הנבדק` (YMD 2026 3 15) (YMD 2027 12 31)
#ASSERT `סעיף 342לו(ב) - הנאמן חייב לכנס אסיפה כללית ולהגיש דוח ביום הנבדק` (YMD 2026 3 15) (YMD 2028 12 31)
#ASSERT NOT (`סעיף 342לו(ב) - הנאמן חייב לכנס אסיפה כללית ולהגיש דוח ביום הנבדק` (YMD 2026 3 15) (YMD 2026 12 31))
#ASSERT NOT (`סעיף 342לו(ב) - הנאמן חייב לכנס אסיפה כללית ולהגיש דוח ביום הנבדק` (YMD 2026 3 15) (YMD 2027 6 30))
#ASSERT NOT (`סעיף 342לו(ב) - הנאמן חייב לכנס אסיפה כללית ולהגיש דוח ביום הנבדק` (YMD 2026 3 15) (YMD 2027 3 14))
#ASSERT `סעיף 342לו(ב) - חובת הנאמן לכנס אסיפה כללית שנתית ולהגיש דוח` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 342לו(ב) - חובת הנאמן לכנס אסיפה כללית שנתית ולהגיש דוח` TRUE TRUE EQUALS `החובה חלה וקויימה`
#ASSERT `סעיף 342לו(ב) - חובת הנאמן לכנס אסיפה כללית שנתית ולהגיש דוח` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`
-- 342לז(א): cancelling the dissolution: all or most directors declared, or the trustee did.
#ASSERT `סעיף 342לז(א) - האסיפה הכללית רשאית לקבל החלטה מיוחדת על ביטול הפירוק מרצון` 5 5 FALSE
#ASSERT `סעיף 342לז(א) - האסיפה הכללית רשאית לקבל החלטה מיוחדת על ביטול הפירוק מרצון` 5 3 FALSE
#ASSERT NOT (`סעיף 342לז(א) - האסיפה הכללית רשאית לקבל החלטה מיוחדת על ביטול הפירוק מרצון` 5 2 FALSE)
#ASSERT `סעיף 342לז(א) - האסיפה הכללית רשאית לקבל החלטה מיוחדת על ביטול הפירוק מרצון` 5 0 TRUE
#ASSERT NOT (`סעיף 342לז(א) - האסיפה הכללית רשאית לקבל החלטה מיוחדת על ביטול הפירוק מרצון` 0 0 FALSE)
#ASSERT `סעיף 342לז(ב) - ביטול הפירוק אינו פוגע בתוקפה של פעולה משפטית שנעשתה כדין לפני הביטול` TRUE
#ASSERT NOT (`סעיף 342לז(ב) - ביטול הפירוק אינו פוגע בתוקפה של פעולה משפטית שנעשתה כדין לפני הביטול` FALSE)
#ASSERT `סעיף 342לז(ג) - חובת הנאמן לשלוח ולפרסם את ההחלטה על ביטול הפירוק` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 342לז(ג) - חובת הנאמן לשלוח ולפרסם את ההחלטה על ביטול הפירוק` TRUE TRUE EQUALS `החובה חלה וקויימה`
#ASSERT `סעיף 342לז(ד) - חובת הרשם למחוק את ההערה על פירוק מרצון` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 342לז(ד) - חובת הרשם למחוק את ההערה על פירוק מרצון` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`
-- 342לח: ending the dissolution.
#ASSERT `סעיף 342לח(א) - חובת הנאמן לערוך דוח מסכם ולכנס אסיפה כללית` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 342לח(א) - חובת הנאמן לערוך דוח מסכם ולכנס אסיפה כללית` TRUE TRUE EQUALS `החובה חלה וקויימה`
-- The invitation at least a month before the meeting, published as the Minister prescribes, with the report attached.
#ASSERT `סעיף 342לח(ב) - ההזמנה לאסיפה הכללית נמסרה ופורסמה כנדרש` TRUE 1 TRUE
#ASSERT `סעיף 342לח(ב) - ההזמנה לאסיפה הכללית נמסרה ופורסמה כנדרש` TRUE 2 TRUE
#ASSERT NOT (`סעיף 342לח(ב) - ההזמנה לאסיפה הכללית נמסרה ופורסמה כנדרש` TRUE 0.9 TRUE)
#ASSERT NOT (`סעיף 342לח(ב) - ההזמנה לאסיפה הכללית נמסרה ופורסמה כנדרש` FALSE 2 TRUE)
#ASSERT NOT (`סעיף 342לח(ב) - ההזמנה לאסיפה הכללית נמסרה ופורסמה כנדרש` TRUE 2 FALSE)
-- Within seven days of the meeting: day 7 inside, day 8 outside.
#ASSERT `סעיף 342לח(ג) - הודעת הנאמן לרשם בתוך שבעה ימים ממועד כינוס האסיפה` TRUE TRUE 7 EQUALS `קויימה בתוך המועד`
#ASSERT `סעיף 342לח(ג) - הודעת הנאמן לרשם בתוך שבעה ימים ממועד כינוס האסיפה` TRUE TRUE 8 EQUALS `קויימה באיחור`
#ASSERT `סעיף 342לח(ג) - הודעת הנאמן לרשם בתוך שבעה ימים ממועד כינוס האסיפה` TRUE FALSE 8 EQUALS `טרם קויימה והמועד חלף`
#ASSERT `סעיף 342לח(ג) - הודעת הנאמן לרשם בתוך שבעה ימים ממועד כינוס האסיפה` FALSE FALSE 8 EQUALS `החובה אינה חלה`
-- 342לט: the liquidation is registered when the Registrar has the notice and the report and the company owes him nothing.
#ASSERT `סעיף 342לט(א) - הרשם רושם את חיסול החברה והחברה מחוסלת מיום הרישום` TRUE TRUE
#ASSERT NOT (`סעיף 342לט(א) - הרשם רושם את חיסול החברה והחברה מחוסלת מיום הרישום` TRUE FALSE)
#ASSERT NOT (`סעיף 342לט(א) - הרשם רושם את חיסול החברה והחברה מחוסלת מיום הרישום` FALSE TRUE)
-- Documents kept at least seven years; the default when the meeting decides nothing is seven years.
#ASSERT `סעיף 342לט(ב) - החלטת האסיפה הכללית על המסמכים שומרת אותם לתקופה שאינה פחותה משבע שנים` 7
#ASSERT NOT (`סעיף 342לט(ב) - החלטת האסיפה הכללית על המסמכים שומרת אותם לתקופה שאינה פחותה משבע שנים` 6)
#ASSERT `סעיף 342לט(ב) - מספר השנים שהנאמן שומר את המסמכים כשהאסיפה הכללית לא החליטה` EQUALS 7
#ASSERT `סעיף 342לט(ג) - יום סיום כהונת הנאמן` (YMD 2030 1 31) EQUALS YMD 2030 1 31
-- 342מ: a shareholder or the Attorney General may still apply to a court; if the court orders winding up, the voluntary proceedings end.
#ASSERT `סעיף 342מ - רשאי להגיש בקשה לפירוק בידי בית משפט אף לאחר ההחלטה על פירוק מרצון` TRUE TRUE
#ASSERT NOT (`סעיף 342מ - רשאי להגיש בקשה לפירוק בידי בית משפט אף לאחר ההחלטה על פירוק מרצון` TRUE FALSE)
#ASSERT `סעיף 342מ - בית המשפט יורה על סיום הליכי הפירוק מרצון והמשך ההליכים בידי בית משפט` TRUE TRUE
#ASSERT NOT (`סעיף 342מ - בית המשפט יורה על סיום הליכי הפירוק מרצון והמשך ההליכים בידי בית משפט` TRUE FALSE)
