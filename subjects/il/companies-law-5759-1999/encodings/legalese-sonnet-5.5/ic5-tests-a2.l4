IMPORT prelude
IMPORT `ic-core`
IMPORT `ic5-a2-articles-and-distribution`

-- ic5-tests-a2: tests of ic5-a2-articles-and-distribution (sections 345ה to 345ז).
-- Every expected value below was decided from the section named beside it, before the run.

§ `בדיקות – סעיפים 345ה עד 345ז`

§§ `345ה – סייג לשינוי תקנון`

-- 345ה(א): a change of purposes (or of the asset provisions on winding up) has no effect unless approved under the section.
#ASSERT `סעיף 345ה(א) - אין תוקף לשינוי התקנון` TRUE FALSE FALSE FALSE
#ASSERT NOT (`סעיף 345ה(א) - אין תוקף לשינוי התקנון` TRUE FALSE FALSE TRUE)
-- A change of the ban on distributing profits has no effect even if "approved".
#ASSERT `סעיף 345ה(א) - אין תוקף לשינוי התקנון` FALSE TRUE FALSE TRUE
#ASSERT `סעיף 345ה(א) - אין תוקף לשינוי התקנון` FALSE TRUE FALSE FALSE
-- A provision contrary to 345ז has no effect even if "approved".
#ASSERT `סעיף 345ה(א) - אין תוקף לשינוי התקנון` FALSE FALSE TRUE TRUE
-- A change that touches none of these is not caught by the section.
#ASSERT NOT (`סעיף 345ה(א) - אין תוקף לשינוי התקנון` FALSE FALSE FALSE FALSE)
#ASSERT NOT (`סעיף 345ה(א) - אין תוקף לשינוי התקנון` FALSE FALSE FALSE TRUE)

-- 345ה(ב): in accordance with section 20, public purposes only, and the board's presentation of assets and commitments first.
#ASSERT `סעיף 345ה(ב) - החלטה על שינוי המטרות הציבוריות כשרה` TRUE TRUE TRUE
#ASSERT NOT (`סעיף 345ה(ב) - החלטה על שינוי המטרות הציבוריות כשרה` FALSE TRUE TRUE)
#ASSERT NOT (`סעיף 345ה(ב) - החלטה על שינוי המטרות הציבוריות כשרה` TRUE FALSE TRUE)
#ASSERT NOT (`סעיף 345ה(ב) - החלטה על שינוי המטרות הציבוריות כשרה` TRUE TRUE FALSE)

-- 345ה(ג): close purpose, and the Registrar of Endowments does not say it is not close: he registers. Otherwise the court.
#ASSERT `סעיף 345ה(ג) - מי שמאשר את שינוי המטרות` TRUE FALSE EQUALS `רשם ההקדשות רושם את השינוי`
#ASSERT `סעיף 345ה(ג) - מי שמאשר את שינוי המטרות` TRUE TRUE EQUALS `בית המשפט מאשר את השינוי`
#ASSERT `סעיף 345ה(ג) - מי שמאשר את שינוי המטרות` FALSE FALSE EQUALS `בית המשפט מאשר את השינוי`
#ASSERT `סעיף 345ה(ג) - מי שמאשר את שינוי המטרות` FALSE TRUE EQUALS `בית המשפט מאשר את השינוי`

-- 345ה(ד) and 345ה(ה): the Registrar of Endowments registers only if persuaded; the court approves only if the Registrar of Endowments had the chance and it is persuaded.
#ASSERT `סעיף 345ה(ד) - רשם ההקדשות רשאי לרשום שינוי מטרות` TRUE
#ASSERT NOT (`סעיף 345ה(ד) - רשם ההקדשות רשאי לרשום שינוי מטרות` FALSE)
#ASSERT `סעיף 345ה(ה) - בית המשפט רשאי לאשר שינוי מטרות` TRUE TRUE
#ASSERT NOT (`סעיף 345ה(ה) - בית המשפט רשאי לאשר שינוי מטרות` FALSE TRUE)
#ASSERT NOT (`סעיף 345ה(ה) - בית המשפט רשאי לאשר שינוי מטרות` TRUE FALSE)
#ASSERT NOT (`סעיף 345ה(ה) - בית המשפט רשאי לאשר שינוי מטרות` FALSE FALSE)

-- 345ה(ו): the Registrar may register the change of purposes only after one of the two.
#ASSERT `סעיף 345ה(ו) - הרשם רשאי לרשום שינוי מטרות לפי סעיף 40` TRUE FALSE
#ASSERT `סעיף 345ה(ו) - הרשם רשאי לרשום שינוי מטרות לפי סעיף 40` FALSE TRUE
#ASSERT `סעיף 345ה(ו) - הרשם רשאי לרשום שינוי מטרות לפי סעיף 40` TRUE TRUE
#ASSERT NOT (`סעיף 345ה(ו) - הרשם רשאי לרשום שינוי מטרות לפי סעיף 40` FALSE FALSE)

§§ `345ו – פעולה בחריגה ממטרות`

-- 345ו: after-the-fact approval needs the general meeting and the court; the court approves only if persuaded.
#ASSERT `סעיף 345ו - אישור בדיעבד של פעולה בחריגה ממטרות תקף` TRUE TRUE
#ASSERT NOT (`סעיף 345ו - אישור בדיעבד של פעולה בחריגה ממטרות תקף` TRUE FALSE)
#ASSERT NOT (`סעיף 345ו - אישור בדיעבד של פעולה בחריגה ממטרות תקף` FALSE TRUE)
#ASSERT NOT (`סעיף 345ו - אישור בדיעבד של פעולה בחריגה ממטרות תקף` FALSE FALSE)
#ASSERT `סעיף 345ו - בית המשפט רשאי לאשר פעולה בחריגה ממטרות` TRUE
#ASSERT NOT (`סעיף 345ו - בית המשפט רשאי לאשר פעולה בחריגה ממטרות` FALSE)

§§ `345ז – חלוקה אסורה`

-- 345ז(ב): the three facts about the gift must all hold.
#ASSERT `סעיף 345ז(ב) - מתנה קטנת ערך וסבירה שניתנה לפי הנהוג` TRUE TRUE TRUE
#ASSERT NOT (`סעיף 345ז(ב) - מתנה קטנת ערך וסבירה שניתנה לפי הנהוג` FALSE TRUE TRUE)
#ASSERT NOT (`סעיף 345ז(ב) - מתנה קטנת ערך וסבירה שניתנה לפי הנהוג` TRUE FALSE TRUE)
#ASSERT NOT (`סעיף 345ז(ב) - מתנה קטנת ערך וסבירה שניתנה לפי הנהוג` TRUE TRUE FALSE)
-- 345ז(א): a public-benefit company's distribution (not a customary small gift) is a prohibited distribution.
#ASSERT `סעיף 345ז(א) - החלוקה היא חלוקה אסורה` TRUE TRUE FALSE
#ASSERT NOT (`סעיף 345ז(א) - החלוקה היא חלוקה אסורה` TRUE TRUE TRUE)
#ASSERT NOT (`סעיף 345ז(א) - החלוקה היא חלוקה אסורה` FALSE TRUE FALSE)
#ASSERT NOT (`סעיף 345ז(א) - החלוקה היא חלוקה אסורה` TRUE FALSE FALSE)
