IMPORT prelude
IMPORT `ic-core`
IMPORT `ic2-tests-fixtures`
IMPORT `ic2-p4c5b-auditor-term-fee-duties`

-- Tests of ic2-p4c5b-auditor-term-fee-duties.l4 (sections 162 to 170). Expected values are written from the text of the section named beside each.

§ `בדיקות: רואה חשבון מבקר – סיום כהונה, שכר, סמכויות ואחריות`

§§ `סעיפים 162 עד 164`

-- 162(א): the general meeting may end the auditor's term.
#ASSERT `סעיף 162(א) - האסיפה הכללית רשאית לסיים את כהונת רואה החשבון המבקר`
-- 162(ב): in a public company or a private bond company, with the ending or non-renewal on the agenda, the committee's position goes to the meeting.
#ASSERT `סעיף 162(ב) - עמדת ועדת הביקורת חייבת להיות מובאת בפני האסיפה הכללית` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` TRUE
#ASSERT `סעיף 162(ב) - עמדת ועדת הביקורת חייבת להיות מובאת בפני האסיפה הכללית` `דוגמה - חברה פרטית שהיא חברת איגרות חוב ואינה תאגיד מדווח` TRUE
#ASSERT NOT (`סעיף 162(ב) - עמדת ועדת הביקורת חייבת להיות מובאת בפני האסיפה הכללית` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` TRUE)
#ASSERT NOT (`סעיף 162(ב) - עמדת ועדת הביקורת חייבת להיות מובאת בפני האסיפה הכללית` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` FALSE)
#ASSERT `סעיף 162(ב) - עמדת ועדת הביקורת הובאה כנדרש` TRUE TRUE
#ASSERT NOT (`סעיף 162(ב) - עמדת ועדת הביקורת הובאה כנדרש` FALSE TRUE)
#ASSERT NOT (`סעיף 162(ב) - עמדת ועדת הביקורת הובאה כנדרש` TRUE FALSE)
-- 163(א): on learning of dependence the board tells the auditor; if it did not cease it convenes a special meeting.
#ASSERT `סעיף 163(א) - הדירקטוריון חייב להודיע לרואה החשבון המבקר לפעול להפסקת התלות` TRUE
#ASSERT NOT (`סעיף 163(א) - הדירקטוריון חייב להודיע לרואה החשבון המבקר לפעול להפסקת התלות` FALSE)
#ASSERT `סעיף 163(א) - הדירקטוריון חייב לכנס אסיפה מיוחדת לסיום כהונתו של רואה החשבון המבקר` TRUE TRUE
#ASSERT NOT (`סעיף 163(א) - הדירקטוריון חייב לכנס אסיפה מיוחדת לסיום כהונתו של רואה החשבון המבקר` TRUE FALSE)
#ASSERT NOT (`סעיף 163(א) - הדירקטוריון חייב לכנס אסיפה מיוחדת לסיום כהונתו של רואה החשבון המבקר` FALSE TRUE)
-- 163(ב): the meeting decides to end the term, unless it heard the auditor and found he is not dependent.
#ASSERT `סעיף 163(ב) - האסיפה הכללית חייבת להחליט על סיום כהונתו של רואה החשבון המבקר` TRUE TRUE FALSE
#ASSERT `סעיף 163(ב) - האסיפה הכללית חייבת להחליט על סיום כהונתו של רואה החשבון המבקר` TRUE FALSE TRUE
#ASSERT NOT (`סעיף 163(ב) - האסיפה הכללית חייבת להחליט על סיום כהונתו של רואה החשבון המבקר` TRUE TRUE TRUE)
#ASSERT NOT (`סעיף 163(ב) - האסיפה הכללית חייבת להחליט על סיום כהונתו של רואה החשבון המבקר` FALSE TRUE FALSE)
-- 164: the auditor's opportunity to be heard; his notice of resignation; the board's notice of his reasons to the shareholders.
#ASSERT `סעיף 164(א) - הדירקטוריון חייב לאפשר לרואה החשבון המבקר להביא את עמדתו ולהזמינו לאסיפה` TRUE
#ASSERT NOT (`סעיף 164(א) - הדירקטוריון חייב לאפשר לרואה החשבון המבקר להביא את עמדתו ולהזמינו לאסיפה` FALSE)
#ASSERT `סעיף 164(ב) - רואה החשבון המבקר חייב להודיע לדירקטוריון על התפטרותו` TRUE TRUE
#ASSERT NOT (`סעיף 164(ב) - רואה החשבון המבקר חייב להודיע לדירקטוריון על התפטרותו` TRUE FALSE)
#ASSERT NOT (`סעיף 164(ב) - רואה החשבון המבקר חייב להודיע לדירקטוריון על התפטרותו` FALSE TRUE)
#ASSERT `סעיף 164(ג) - הדירקטוריון חייב להודיע לבעלי המניות את נימוקי רואה החשבון המבקר להתפטרותו` TRUE
#ASSERT NOT (`סעיף 164(ג) - הדירקטוריון חייב להודיע לבעלי המניות את נימוקי רואה החשבון המבקר להתפטרותו` FALSE)
#ASSERT `סעיף 164(ג) - הדירקטוריון רשאי להודיע לבעלי המניות גם את עמדתו בענין`

§§ `סעיפים 165 עד 167`

-- 165(א): the general meeting may set the fee; the board may if authorised or if the articles so provide.
#ASSERT `סעיף 165(א) - האסיפה הכללית רשאית לקבוע את שכר רואה החשבון המבקר עבור פעולת הביקורת`
#ASSERT `סעיף 165(א) - הדירקטוריון רשאי לקבוע את שכר רואה החשבון המבקר עבור פעולת הביקורת` TRUE FALSE
#ASSERT `סעיף 165(א) - הדירקטוריון רשאי לקבוע את שכר רואה החשבון המבקר עבור פעולת הביקורת` FALSE TRUE
#ASSERT NOT (`סעיף 165(א) - הדירקטוריון רשאי לקבוע את שכר רואה החשבון המבקר עבור פעולת הביקורת` FALSE FALSE)
#ASSERT `סעיף 165(ב) - הדירקטוריון חייב לדווח לאסיפה השנתית על שכרו של רואה החשבון המבקר` TRUE
#ASSERT NOT (`סעיף 165(ב) - הדירקטוריון חייב לדווח לאסיפה השנתית על שכרו של רואה החשבון המבקר` FALSE)
-- 166(א): a condition that restricts how the audit is done, or ties its result to the fee, is forbidden.
#ASSERT `סעיף 166(א) - התניית שכר הטרחה בתנאי אסורה` TRUE FALSE
#ASSERT `סעיף 166(א) - התניית שכר הטרחה בתנאי אסורה` FALSE TRUE
#ASSERT NOT (`סעיף 166(א) - התניית שכר הטרחה בתנאי אסורה` FALSE FALSE)
-- 166(ב): the company, or anyone on its behalf, may not indemnify the auditor for either kind of liability.
#ASSERT `סעיף 166(ב) - שיפוי רואה החשבון המבקר אסור` TRUE TRUE FALSE
#ASSERT `סעיף 166(ב) - שיפוי רואה החשבון המבקר אסור` TRUE FALSE TRUE
#ASSERT NOT (`סעיף 166(ב) - שיפוי רואה החשבון המבקר אסור` TRUE FALSE FALSE)
#ASSERT NOT (`סעיף 166(ב) - שיפוי רואה החשבון המבקר אסור` FALSE TRUE TRUE)
-- 167: the board sets the fee for further services unless the articles give it to the general meeting; the board reports to the annual meeting.
#ASSERT `סעיף 167(א) - מי שקובע את שכרו של רואה החשבון המבקר בעבור שירותים נוספים` FALSE EQUALS `הדירקטוריון`
#ASSERT `סעיף 167(א) - מי שקובע את שכרו של רואה החשבון המבקר בעבור שירותים נוספים` TRUE EQUALS `האסיפה הכללית`
#ASSERT `סעיף 167(ב) - הדירקטוריון חייב לדווח לאסיפה השנתית על תנאי ההתקשרות לשירותים נוספים`
#ASSERT `סעיף 167(ב) - האדם נחשב רואה חשבון לענין הסעיף` TRUE FALSE NOTHING FALSE
#ASSERT `סעיף 167(ב) - האדם נחשב רואה חשבון לענין הסעיף` FALSE TRUE NOTHING FALSE
#ASSERT `סעיף 167(ב) - האדם נחשב רואה חשבון לענין הסעיף` FALSE FALSE (JUST `הורה`) FALSE
#ASSERT `סעיף 167(ב) - האדם נחשב רואה חשבון לענין הסעיף` FALSE FALSE NOTHING TRUE
#ASSERT NOT (`סעיף 167(ב) - האדם נחשב רואה חשבון לענין הסעיף` FALSE FALSE (JUST `קרבה אחרת`) FALSE)
#ASSERT NOT (`סעיף 167(ב) - האדם נחשב רואה חשבון לענין הסעיף` FALSE FALSE NOTHING FALSE)

§§ `סעיפים 168 עד 170`

-- 168(א): the auditor may inspect what he needs and get explanations.
#ASSERT `סעיף 168(א) - רואה החשבון המבקר רשאי לעיין במסמך ולקבל הסברים` TRUE
#ASSERT NOT (`סעיף 168(א) - רואה החשבון המבקר רשאי לעיין במסמך ולקבל הסברים` FALSE)
-- 168(ב): the three meetings he may attend, and the board's duty to tell him where and when.
#ASSERT `סעיף 168(ב) - רואה החשבון המבקר רשאי להשתתף בישיבה` `אסיפה כללית שהוגשו בה דוחות כספיים שביקר`
#ASSERT `סעיף 168(ב) - רואה החשבון המבקר רשאי להשתתף בישיבה` `ישיבת דירקטוריון הדנה באישור דוחות כספיים`
#ASSERT `סעיף 168(ב) - רואה החשבון המבקר רשאי להשתתף בישיבה` `ישיבת דירקטוריון שהתכנסה לפי סעיף 169`
#ASSERT NOT (`סעיף 168(ב) - רואה החשבון המבקר רשאי להשתתף בישיבה` `ישיבה אחרת`)
#ASSERT `סעיף 168(ב) - הדירקטוריון חייב להודיע לרואה החשבון המבקר על מקום הישיבה ומועדה` `אסיפה כללית שהוגשו בה דוחות כספיים שביקר`
#ASSERT NOT (`סעיף 168(ב) - הדירקטוריון חייב להודיע לרואה החשבון המבקר על מקום הישיבה ומועדה` `ישיבה אחרת`)
-- 169: a report to the chairperson on material deficiencies in the accounting control, and a board meeting without delay.
#ASSERT `סעיף 169(א) - רואה החשבון המבקר חייב לדווח ליושב ראש הדירקטוריון` TRUE TRUE
#ASSERT NOT (`סעיף 169(א) - רואה החשבון המבקר חייב לדווח ליושב ראש הדירקטוריון` TRUE FALSE)
#ASSERT NOT (`סעיף 169(א) - רואה החשבון המבקר חייב לדווח ליושב ראש הדירקטוריון` FALSE TRUE)
#ASSERT `סעיף 169(ב) - יושב ראש הדירקטוריון חייב לזמן ישיבת דירקטוריון` TRUE
#ASSERT NOT (`סעיף 169(ב) - יושב ראש הדירקטוריון חייב לזמן ישיבת דירקטוריון` FALSE)
-- 170(א): the auditor answers to the company and its shareholders for his opinion; for any other party the section decides nothing.
#ASSERT `סעיף 170(א) - רואה החשבון המבקר אחראי כלפי הצד לאמור בחוות דעתו` `החברה` EQUALS JUST TRUE
#ASSERT `סעיף 170(א) - רואה החשבון המבקר אחראי כלפי הצד לאמור בחוות דעתו` `בעל המניות` EQUALS JUST TRUE
#ASSERT `סעיף 170(א) - רואה החשבון המבקר אחראי כלפי הצד לאמור בחוות דעתו` `הנושה` EQUALS NOTHING
-- 170(ב): (א) does not prevent liability under any law.
#ASSERT NOT (`סעיף 170(ב) - סעיף קטן (א) מונע אחריות של רואה החשבון המבקר לפי דין אחר`)
