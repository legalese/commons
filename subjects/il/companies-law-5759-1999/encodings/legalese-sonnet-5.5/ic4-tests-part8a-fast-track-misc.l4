IMPORT prelude
IMPORT `ic-core`
IMPORT `ic4-nouns`
IMPORT `ic4-part8a-fast-track-misc`

-- ic4-tests-part8a-fast-track-misc: tests of ic4-part8a-fast-track-misc.l4 (sections 342מא to 342נג).
-- Every expected value is decided from the text of the section (Hebrew, src:2430-2495) before the run, and written beside the assertion.
-- Boundary values are tested on each side of every figure the text states: 21 days, 30 days, 90 days, 10 working days, seven days, two years, seven years.

§ `בדיקות: חלק 8א פרקים ד ו־ה, פירוק מרצון בהליך מזורז והוראות שונות`

§§ `סעיף 342מא`

-- No assets, no debts, no pending proceedings and no enforcement proceedings: inactive.
#ASSERT `סעיף 342מא - חברה לא פעילה` FALSE FALSE FALSE FALSE
-- Any one of the four facts defeats it.
#ASSERT NOT (`סעיף 342מא - חברה לא פעילה` TRUE FALSE FALSE FALSE)
#ASSERT NOT (`סעיף 342מא - חברה לא פעילה` FALSE TRUE FALSE FALSE)
#ASSERT NOT (`סעיף 342מא - חברה לא פעילה` FALSE FALSE TRUE FALSE)
#ASSERT NOT (`סעיף 342מא - חברה לא פעילה` FALSE FALSE FALSE TRUE)

§§ `סעיף 342מב`

-- Inactive; five of five participants agreed; 21 days' notice; the proposal on the agenda.
#ASSERT `סעיף 342מב - החברה הלא פעילה רשאית לקבל החלטה על פירוק מרצון בהליך מזורז` TRUE 5 5 21 FALSE TRUE
-- Four of five agreed: the consent of all the participants is needed.
#ASSERT NOT (`סעיף 342מב - החברה הלא פעילה רשאית לקבל החלטה על פירוק מרצון בהליך מזורז` TRUE 5 4 21 FALSE TRUE)
-- 20 days' notice is short unless all the shareholders consented to a closer time.
#ASSERT NOT (`סעיף 342מב - החברה הלא פעילה רשאית לקבל החלטה על פירוק מרצון בהליך מזורז` TRUE 5 5 20 FALSE TRUE)
#ASSERT `סעיף 342מב - החברה הלא פעילה רשאית לקבל החלטה על פירוק מרצון בהליך מזורז` TRUE 5 5 20 TRUE TRUE
-- Not an inactive company; no proposal on the agenda; no participants at all.
#ASSERT NOT (`סעיף 342מב - החברה הלא פעילה רשאית לקבל החלטה על פירוק מרצון בהליך מזורז` FALSE 5 5 21 FALSE TRUE)
#ASSERT NOT (`סעיף 342מב - החברה הלא פעילה רשאית לקבל החלטה על פירוק מרצון בהליך מזורז` TRUE 5 5 21 FALSE FALSE)
#ASSERT NOT (`סעיף 342מב - החברה הלא פעילה רשאית לקבל החלטה על פירוק מרצון בהליך מזורז` TRUE 0 0 21 FALSE TRUE)

§§ `סעיף 342מג`

-- The application within 30 days of the resolution: day 30 inside, day 31 outside.
#ASSERT `סעיף 342מג(א) - הגשת הבקשה לרשם בתוך 30 ימים ממועד קבלת ההחלטה` TRUE TRUE 30 EQUALS `קויימה בתוך המועד`
#ASSERT `סעיף 342מג(א) - הגשת הבקשה לרשם בתוך 30 ימים ממועד קבלת ההחלטה` TRUE TRUE 31 EQUALS `קויימה באיחור`
#ASSERT `סעיף 342מג(א) - הגשת הבקשה לרשם בתוך 30 ימים ממועד קבלת ההחלטה` TRUE FALSE 30 EQUALS `טרם קויימה והמועד עדיין לא חלף`
#ASSERT `סעיף 342מג(א) - הגשת הבקשה לרשם בתוך 30 ימים ממועד קבלת ההחלטה` TRUE FALSE 31 EQUALS `טרם קויימה והמועד חלף`
#ASSERT `סעיף 342מג(א) - הגשת הבקשה לרשם בתוך 30 ימים ממועד קבלת ההחלטה` FALSE FALSE 40 EQUALS `החובה אינה חלה`
-- (ב): the affidavit by all or most directors, the decision on documents (at least seven years), the Minister's further papers.
#ASSERT `סעיף 342מג(ב) - הבקשה לרשם כוללת את הצרופות הנדרשות` 5 5 TRUE 7 TRUE
#ASSERT `סעיף 342מג(ב) - הבקשה לרשם כוללת את הצרופות הנדרשות` 5 3 TRUE 7 TRUE
#ASSERT NOT (`סעיף 342מג(ב) - הבקשה לרשם כוללת את הצרופות הנדרשות` 5 2 TRUE 7 TRUE)
#ASSERT NOT (`סעיף 342מג(ב) - הבקשה לרשם כוללת את הצרופות הנדרשות` 5 5 FALSE 7 TRUE)
#ASSERT NOT (`סעיף 342מג(ב) - הבקשה לרשם כוללת את הצרופות הנדרשות` 5 5 TRUE 6 TRUE)
#ASSERT NOT (`סעיף 342מג(ב) - הבקשה לרשם כוללת את הצרופות הנדרשות` 5 5 TRUE 7 FALSE)

§§ `סעיפים 342מד עד 342מז`

-- The Registrar who found the conditions met publishes and registers a note.
#ASSERT `סעיף 342מד(א) - חובת הרשם לפרסם הודעה ולרשום הערה` TRUE TRUE FALSE FALSE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 342מד(א) - חובת הרשם לפרסם הודעה ולרשום הערה` TRUE TRUE TRUE TRUE EQUALS `החובה חלה וקויימה`
-- Publishing without registering the note leaves the duty undone.
#ASSERT `סעיף 342מד(א) - חובת הרשם לפרסם הודעה ולרשום הערה` TRUE TRUE TRUE FALSE EQUALS `החובה חלה וטרם קויימה`
-- Conditions not found met: no duty.
#ASSERT `סעיף 342מד(א) - חובת הרשם לפרסם הודעה ולרשום הערה` TRUE FALSE FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`
-- An objection within 90 days of publication: day 90 inside, day 91 outside.
#ASSERT `סעיף 342מה - האדם רשאי להגיש התנגדות לבקשה בתוך 90 ימים מפרסומה` TRUE TRUE 90
#ASSERT NOT (`סעיף 342מה - האדם רשאי להגיש התנגדות לבקשה בתוך 90 ימים מפרסומה` TRUE TRUE 91)
#ASSERT NOT (`סעיף 342מה - האדם רשאי להגיש התנגדות לבקשה בתוך 90 ימים מפרסומה` TRUE FALSE 10)
#ASSERT NOT (`סעיף 342מה - האדם רשאי להגיש התנגדות לבקשה בתוך 90 ימים מפרסומה` FALSE TRUE 10)
-- 342מו: an objection, or a failed condition, stops the proceedings.
#ASSERT `סעיף 342מו - חובת הרשם להפסיק את הליכי הפירוק ולהסיר את הפרסום` TRUE FALSE FALSE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 342מו - חובת הרשם להפסיק את הליכי הפירוק ולהסיר את הפרסום` FALSE TRUE FALSE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 342מו - חובת הרשם להפסיק את הליכי הפירוק ולהסיר את הפרסום` TRUE FALSE TRUE EQUALS `החובה חלה וקויימה`
#ASSERT `סעיף 342מו - חובת הרשם להפסיק את הליכי הפירוק ולהסיר את הפרסום` FALSE FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`
-- 342מז: no objection, and 10 working days from the last date for objections: the Registrar registers the liquidation.
#ASSERT `סעיף 342מז(א) - חובת הרשם לרשום את חיסול החברה בתום 10 ימי עבודה` TRUE 10 FALSE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 342מז(א) - חובת הרשם לרשום את חיסול החברה בתום 10 ימי עבודה` TRUE 9 FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`
#ASSERT `סעיף 342מז(א) - חובת הרשם לרשום את חיסול החברה בתום 10 ימי עבודה` TRUE 12 TRUE EQUALS `החובה חלה וקויימה`
#ASSERT `סעיף 342מז(א) - חובת הרשם לרשום את חיסול החברה בתום 10 ימי עבודה` FALSE 30 FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`
#ASSERT `סעיף 342מז(ב) - החברה מחוסלת מיום הרישום` TRUE
#ASSERT NOT (`סעיף 342מז(ב) - החברה מחוסלת מיום הרישום` FALSE)

§§ `סעיפים 342מח עד 342נ`

-- 342מח: section 76 stays as it is, in a private company.
#ASSERT `סעיף 342מח - הוראות חלק 8א אינן גורעות מתוקף ההחלטה שהתקבלה לפי סעיף 76` TRUE TRUE
#ASSERT NOT (`סעיף 342מח - הוראות חלק 8א אינן גורעות מתוקף ההחלטה שהתקבלה לפי סעיף 76` FALSE TRUE)
#ASSERT NOT (`סעיף 342מח - הוראות חלק 8א אינן גורעות מתוקף ההחלטה שהתקבלה לפי סעיף 76` TRUE FALSE)
-- 342מט: every document of a company in dissolution says so.
#ASSERT `סעיף 342מט - חובת החברה לציין בכל מסמך מטעמה שהיא בהליכי פירוק` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 342מט - חובת החברה לציין בכל מסמך מטעמה שהיא בהליכי פירוק` TRUE TRUE EQUALS `החובה חלה וקויימה`
#ASSERT `סעיף 342מט - חובת החברה לציין בכל מסמך מטעמה שהיא בהליכי פירוק` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`
-- 342נ: the trustee's yearly report to the Registrar once the proceedings passed a year.
#ASSERT `סעיף 342נ(א) - חובת הנאמן להגיש לרשם אחת לשנה דוח על הליכי הפירוק` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 342נ(א) - חובת הנאמן להגיש לרשם אחת לשנה דוח על הליכי הפירוק` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

§§ `סעיף 342נא`

-- (א): a shareholder of a company in dissolution who concealed an asset before the order: up to three years.
#ASSERT `סעיף 342נא(א) - שנות המאסר המרביות למי שעשה מעשה כאמור` TRUE `משרה אחרת` TRUE `הסתרת נכס לפני מתן הצו או ההחלטה במטרה שלא ייכלל בנכסי קופת הפירוק` EQUALS JUST 3
-- An office-holder (a director) who concealed an asset after the order.
#ASSERT `סעיף 342נא(א) - שנות המאסר המרביות למי שעשה מעשה כאמור` FALSE `דירקטור` TRUE `הסתרת נכס לאחר מתן הצו או ההחלטה` EQUALS JUST 3
-- Giving no information, or partial or false information, to harm the proceedings.
#ASSERT `סעיף 342נא(א) - שנות המאסר המרביות למי שעשה מעשה כאמור` FALSE `מנהל כללי` TRUE `אי מסירת מידע או מסירת מידע חלקי או כוזב לנאמן או לאסיפה הכללית במטרה לפגוע בהליכי הפירוק` EQUALS JUST 3
-- Neither a shareholder nor an office-holder (a person holding "any other position").
#ASSERT `סעיף 342נא(א) - שנות המאסר המרביות למי שעשה מעשה כאמור` FALSE `משרה אחרת` TRUE `הסתרת נכס לאחר מתן הצו או ההחלטה` EQUALS NOTHING
-- No winding-up order and no resolution on voluntary dissolution.
#ASSERT `סעיף 342נא(א) - שנות המאסר המרביות למי שעשה מעשה כאמור` TRUE `דירקטור` FALSE `הסתרת נכס לאחר מתן הצו או ההחלטה` EQUALS NOTHING
-- Some other act: not within the subsection.
#ASSERT `סעיף 342נא(א) - שנות המאסר המרביות למי שעשה מעשה כאמור` TRUE `דירקטור` TRUE `מעשה אחר` EQUALS NOTHING
-- (ב): one year for one required to give information under sections 47 or 49 of the Insolvency Law who did not, intending to harm.
#ASSERT `סעיף 342נא(ב) - שנת המאסר המרבית למי שנדרש למסור מידע לנאמן ולא מסר` TRUE TRUE TRUE EQUALS JUST 1
#ASSERT `סעיף 342נא(ב) - שנת המאסר המרבית למי שנדרש למסור מידע לנאמן ולא מסר` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `סעיף 342נא(ב) - שנת המאסר המרבית למי שנדרש למסור מידע לנאמן ולא מסר` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `סעיף 342נא(ב) - שנת המאסר המרבית למי שנדרש למסור מידע לנאמן ולא מסר` TRUE TRUE FALSE EQUALS NOTHING

§§ `סעיפים 342נב ו־342נג`

-- A liquidated company, an interested person, a justified request, within two years: the court may cancel the liquidation.
#ASSERT `סעיף 342נב - בית המשפט רשאי להורות על ביטול החיסול` TRUE TRUE TRUE 2 FALSE
#ASSERT `סעיף 342נב - בית המשפט רשאי להורות על ביטול החיסול` TRUE TRUE TRUE 0.5 FALSE
-- Later than two years: only with the court's permission in an exceptional case.
#ASSERT NOT (`סעיף 342נב - בית המשפט רשאי להורות על ביטול החיסול` TRUE TRUE TRUE 2.1 FALSE)
#ASSERT `סעיף 342נב - בית המשפט רשאי להורות על ביטול החיסול` TRUE TRUE TRUE 2.1 TRUE
-- Not justified; not an interested person; not a liquidated company.
#ASSERT NOT (`סעיף 342נב - בית המשפט רשאי להורות על ביטול החיסול` TRUE TRUE FALSE 1 FALSE)
#ASSERT NOT (`סעיף 342נב - בית המשפט רשאי להורות על ביטול החיסול` TRUE FALSE TRUE 1 FALSE)
#ASSERT NOT (`סעיף 342נב - בית המשפט רשאי להורות על ביטול החיסול` FALSE TRUE TRUE 1 FALSE)
#ASSERT `סעיף 342נב(א) - לאחר הצו ניתן לנקוט כל הליך שהיה ניתן לנקוט אילולא חוסלה החברה` TRUE
#ASSERT NOT (`סעיף 342נב(א) - לאחר הצו ניתן לנקוט כל הליך שהיה ניתן לנקוט אילולא חוסלה החברה` FALSE)
-- (ג): a copy of the order to the Registrar within seven days: day 7 inside, day 8 outside.
#ASSERT `סעיף 342נב(ג) - המצאת העתק הצו לרשם בתוך שבעה ימים מיום מתן הצו` TRUE TRUE 7 EQUALS `קויימה בתוך המועד`
#ASSERT `סעיף 342נב(ג) - המצאת העתק הצו לרשם בתוך שבעה ימים מיום מתן הצו` TRUE TRUE 8 EQUALS `קויימה באיחור`
#ASSERT `סעיף 342נב(ג) - המצאת העתק הצו לרשם בתוך שבעה ימים מיום מתן הצו` TRUE FALSE 8 EQUALS `טרם קויימה והמועד חלף`
#ASSERT `סעיף 342נב(ג) - המצאת העתק הצו לרשם בתוך שבעה ימים מיום מתן הצו` FALSE FALSE 8 EQUALS `החובה אינה חלה`
#ASSERT `סעיף 342נב(ג) - חובת הרשם לבטל את רישום חיסול החברה` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 342נב(ג) - חובת הרשם לבטל את רישום חיסול החברה` TRUE TRUE EQUALS `החובה חלה וקויימה`
-- 342נג(א): a foreign company (a body corporate, not a partnership, incorporated abroad) with business or assets in Israel.
#ASSERT `סעיף 342נג(א) - הוראות הפירוק בידי בית משפט חלות על חברת חוץ` TRUE FALSE TRUE TRUE FALSE
#ASSERT `סעיף 342נג(א) - הוראות הפירוק בידי בית משפט חלות על חברת חוץ` TRUE FALSE TRUE FALSE TRUE
#ASSERT NOT (`סעיף 342נג(א) - הוראות הפירוק בידי בית משפט חלות על חברת חוץ` TRUE FALSE TRUE FALSE FALSE)
#ASSERT NOT (`סעיף 342נג(א) - הוראות הפירוק בידי בית משפט חלות על חברת חוץ` TRUE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`סעיף 342נג(א) - הוראות הפירוק בידי בית משפט חלות על חברת חוץ` TRUE FALSE FALSE TRUE TRUE)
