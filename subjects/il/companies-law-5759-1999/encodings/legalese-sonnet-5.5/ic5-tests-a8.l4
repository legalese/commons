IMPORT prelude
IMPORT `ic-core`
IMPORT `ic5-parties`
IMPORT `ic5-a8-remedies-application`

-- ic5-tests-a8: tests of ic5-a8-remedies-application (sections 345כה to 345לג).
-- Every expected value below was decided from the section named beside it, before the run.

§ `בדיקות – סעיפים 345כה עד 345לג`

§§ `345כו – פניה לבית המשפט`

-- 345כו: anyone harmed by the company's act or omission may apply; the Attorney General may open any proceeding, and appear and argue if he thinks it involves a public interest.
#ASSERT `סעיף 345כו - אדם רשאי לפנות לבית המשפט בבקשה להורות לחברה לפעול` TRUE TRUE
#ASSERT NOT (`סעיף 345כו - אדם רשאי לפנות לבית המשפט בבקשה להורות לחברה לפעול` TRUE FALSE)
#ASSERT NOT (`סעיף 345כו - אדם רשאי לפנות לבית המשפט בבקשה להורות לחברה לפעול` FALSE TRUE)
#ASSERT `סעיף 345כו - היועץ המשפטי לממשלה רשאי לפתוח בהליך` TRUE
#ASSERT NOT (`סעיף 345כו - היועץ המשפטי לממשלה רשאי לפתוח בהליך` FALSE)
#ASSERT `סעיף 345כו - היועץ המשפטי לממשלה רשאי להתייצב ולטעון בהליך` TRUE TRUE
#ASSERT NOT (`סעיף 345כו - היועץ המשפטי לממשלה רשאי להתייצב ולטעון בהליך` TRUE FALSE)
#ASSERT NOT (`סעיף 345כו - היועץ המשפטי לממשלה רשאי להתייצב ולטעון בהליך` FALSE TRUE)

§§ `345כח – השבה לחברה`

-- 345כח(א): args: assets transferred, how, the office-holder knew or should have known, who asks.
#ASSERT `סעיף 345כח(א) - בית המשפט רשאי להורות לנושא משרה להשיב נכסים לחברה` TRUE `בחריגה ממטרות שלא אושרה בידי בית המשפט לפי סעיף 345ו` TRUE `תורם לחברה כמבקש השבה`
#ASSERT `סעיף 345כח(א) - בית המשפט רשאי להורות לנושא משרה להשיב נכסים לחברה` TRUE `בעסקה בניגוד להוראות סעיף 345יב` TRUE `בעל מניה בחברה כמבקש השבה`
#ASSERT `סעיף 345כח(א) - בית המשפט רשאי להורות לנושא משרה להשיב נכסים לחברה` TRUE `בדרך של חלוקת רווחים לבעלי המניות או ליזם בניגוד להוראות הפרק` TRUE `רשם ההקדשות כמבקש השבה`
#ASSERT `סעיף 345כח(א) - בית המשפט רשאי להורות לנושא משרה להשיב נכסים לחברה` TRUE `במהלך פירוק מרצון בניגוד להוראות הפרק` TRUE `תורם לחברה כמבקש השבה`
#ASSERT `סעיף 345כח(א) - בית המשפט רשאי להורות לנושא משרה להשיב נכסים לחברה` TRUE `בקרן לתועלת הציבור בניגוד להוראות לפי סעיף 345מד` TRUE `תורם לחברה כמבקש השבה`
#ASSERT NOT (`סעיף 345כח(א) - בית המשפט רשאי להורות לנושא משרה להשיב נכסים לחברה` TRUE `בדרך אחרת שסעיף 345כח(א) אינו מונה` TRUE `תורם לחברה כמבקש השבה`)
#ASSERT NOT (`סעיף 345כח(א) - בית המשפט רשאי להורות לנושא משרה להשיב נכסים לחברה` FALSE `בעסקה בניגוד להוראות סעיף 345יב` TRUE `תורם לחברה כמבקש השבה`)
#ASSERT NOT (`סעיף 345כח(א) - בית המשפט רשאי להורות לנושא משרה להשיב נכסים לחברה` TRUE `בעסקה בניגוד להוראות סעיף 345יב` FALSE `תורם לחברה כמבקש השבה`)
#ASSERT NOT (`סעיף 345כח(א) - בית המשפט רשאי להורות לנושא משרה להשיב נכסים לחברה` TRUE `בעסקה בניגוד להוראות סעיף 345יב` TRUE `אדם אחר כמבקש השבה`)
-- 345כח(ב): the office-holder escapes by proving any one of three things.
#ASSERT `סעיף 345כח(ב) - בית המשפט לא יחייב נושא משרה בהשבה` TRUE FALSE FALSE
#ASSERT `סעיף 345כח(ב) - בית המשפט לא יחייב נושא משרה בהשבה` FALSE TRUE FALSE
#ASSERT `סעיף 345כח(ב) - בית המשפט לא יחייב נושא משרה בהשבה` FALSE FALSE TRUE
#ASSERT NOT (`סעיף 345כח(ב) - בית המשפט לא יחייב נושא משרה בהשבה` FALSE FALSE FALSE)
-- 345כח(ג): the court may decline if the assets or their value were returned.
#ASSERT `סעיף 345כח(ג) - בית המשפט רשאי שלא לחייב בהשבה` TRUE
#ASSERT NOT (`סעיף 345כח(ג) - בית המשפט רשאי שלא לחייב בהשבה` FALSE)
-- 345כח(ד): the Registrar of Endowments applies only after notice, a chance to plead, and a notice with the three particulars.
#ASSERT `סעיף 345כח(ד) - רשם ההקדשות רשאי להגיש את הבקשה לבית המשפט` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`סעיף 345כח(ד) - רשם ההקדשות רשאי להגיש את הבקשה לבית המשפט` FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`סעיף 345כח(ד) - רשם ההקדשות רשאי להגיש את הבקשה לבית המשפט` TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`סעיף 345כח(ד) - רשם ההקדשות רשאי להגיש את הבקשה לבית המשפט` TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`סעיף 345כח(ד) - רשם ההקדשות רשאי להגיש את הבקשה לבית המשפט` TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`סעיף 345כח(ד) - רשם ההקדשות רשאי להגיש את הבקשה לבית המשפט` TRUE TRUE TRUE TRUE FALSE)

§§ `345כט – הרמת מסך`

-- 345כט(1): an unregistered company is presumed to have used its separate personality to defraud, unless the defendant proves one of the two defences.
#ASSERT `סעיף 345כט(1) - חזקה שהחברה עשתה שימוש באישיות המשפטית הנפרדת בכוונה להונות` TRUE FALSE FALSE
#ASSERT NOT (`סעיף 345כט(1) - חזקה שהחברה עשתה שימוש באישיות המשפטית הנפרדת בכוונה להונות` TRUE TRUE FALSE)
#ASSERT NOT (`סעיף 345כט(1) - חזקה שהחברה עשתה שימוש באישיות המשפטית הנפרדת בכוונה להונות` TRUE FALSE TRUE)
#ASSERT NOT (`סעיף 345כט(1) - חזקה שהחברה עשתה שימוש באישיות המשפטית הנפרדת בכוונה להונות` FALSE FALSE FALSE)
-- 345כט(2): the court may attribute a public-benefit company's debt to an office-holder if the section 6(a) conditions were met.
#ASSERT `סעיף 345כט(2) - בית המשפט רשאי לייחס את החוב לנושא משרה` TRUE TRUE
#ASSERT NOT (`סעיף 345כט(2) - בית המשפט רשאי לייחס את החוב לנושא משרה` TRUE FALSE)
#ASSERT NOT (`סעיף 345כט(2) - בית המשפט רשאי לייחס את החוב לנושא משרה` FALSE TRUE)

§§ `345ל – שמירת דינים`

-- 345ל(א): no contradiction, both apply; a contradiction, the chapter prevails unless express provisions were set under another law for such a company.
#ASSERT `סעיף 345ל(א) - היחס בין הוראת הפרק להוראה אחרת` FALSE FALSE EQUALS `הפרק והדין האחר חלים זה לצד זה`
#ASSERT `סעיף 345ל(א) - היחס בין הוראת הפרק להוראה אחרת` FALSE TRUE EQUALS `הפרק והדין האחר חלים זה לצד זה`
#ASSERT `סעיף 345ל(א) - היחס בין הוראת הפרק להוראה אחרת` TRUE FALSE EQUALS `הוראות הפרק גוברות`
#ASSERT `סעיף 345ל(א) - היחס בין הוראת הפרק להוראה אחרת` TRUE TRUE EQUALS `הוראות הדין האחר גוברות`
-- 345ל(ב): the Trust Law's additional duties are preserved for a company acting as a trustee.
#ASSERT `סעיף 345ל(ב) - החובות הנוספות לפי חוק הנאמנות נשמרות` TRUE TRUE
#ASSERT NOT (`סעיף 345ל(ב) - החובות הנוספות לפי חוק הנאמנות נשמרות` TRUE FALSE)
#ASSERT NOT (`סעיף 345ל(ב) - החובות הנוספות לפי חוק הנאמנות נשמרות` FALSE TRUE)

§§ `345לא – איסור התניה`

#ASSERT `סעיף 345לא - ההתניה אסורה` TRUE
#ASSERT NOT (`סעיף 345לא - ההתניה אסורה` FALSE)

