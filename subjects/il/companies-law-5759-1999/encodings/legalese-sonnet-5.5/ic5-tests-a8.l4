#ASSERT NOT (`סעיף 345לג(ב) - השר רשאי לקבוע בצו שההוראות אינן חלות או חלות בשינויים` TRUE FALSE TRUE)
#ASSERT NOT (`סעיף 345לג(ב) - השר רשאי לקבוע בצו שההוראות אינן חלות או חלות בשינויים` TRUE TRUE FALSE)
