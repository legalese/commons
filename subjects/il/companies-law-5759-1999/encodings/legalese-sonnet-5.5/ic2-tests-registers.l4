IMPORT prelude
IMPORT `ic-core`
IMPORT `ic2-tests-fixtures`
IMPORT `ic2-p4c2-registers`

-- Tests of ic2-p4c2-registers.l4 (sections 127 to 139). Expected values are written from the text of the section named beside each.

§ `בדיקות: המרשמים`

§§ `סעיפים 127 עד 129`

-- 127: every company keeps a register of shareholders; a body that is not a company does not.
#ASSERT `סעיף 127 - החברה חייבת לנהל מרשם בעלי מניות` `דוגמה - חברה פרטית שאינה חברת איגרות חוב`
#ASSERT `סעיף 127 - החברה חייבת לנהל מרשם בעלי מניות` `דוגמה - חברה ציבורית שהיא תאגיד מדווח`
#ASSERT NOT (`סעיף 127 - החברה חייבת לנהל מרשם בעלי מניות` `דוגמה - גוף שהתאגד לפי דין אחר`)
-- 128: only a public company keeps the register of material shareholders as well.
#ASSERT `סעיף 128 - החברה חייבת לנהל מרשם בעלי מניות מהותיים` `דוגמה - חברה ציבורית שאינה תאגיד מדווח`
#ASSERT NOT (`סעיף 128 - החברה חייבת לנהל מרשם בעלי מניות מהותיים` `דוגמה - חברה פרטית שהיא חברת איגרות חוב ואינה תאגיד מדווח`)
#ASSERT NOT (`סעיף 128 - החברה חייבת לנהל מרשם בעלי מניות מהותיים` `דוגמה - חברה פרטית שאינה חברת איגרות חוב`)
-- 129: both registers are open to anyone.
#ASSERT `סעיף 129 - כל אדם רשאי לעיין במרשם` TRUE FALSE
#ASSERT `סעיף 129 - כל אדם רשאי לעיין במרשם` FALSE TRUE
#ASSERT NOT (`סעיף 129 - כל אדם רשאי לעיין במרשם` FALSE FALSE)

§§ `סעיפים 130 עד 134`

`עובדות על מניות - כל התנאים מתקיימים` MEANS `עובדות על מניות לענין המרשם` WITH
    `למניות יש ערך נקוב` IS TRUE
    `טרם שולם חלק מהתמורה שנקבעה למניה` IS TRUE
    `המניות מסומנות במספרים סידוריים` IS TRUE
    `יש מניות רדומות כמשמעותן בסעיף 308` IS TRUE
    `יש מניות שאינן מקנות זכויות הצבעה לפי סעיף 309(ב) או סעיף 333(ב)` IS TRUE
`עובדות על מניות - אף תנאי אינו מתקיים` MEANS `עובדות על מניות לענין המרשם` WITH
    `למניות יש ערך נקוב` IS FALSE
    `טרם שולם חלק מהתמורה שנקבעה למניה` IS FALSE
    `המניות מסומנות במספרים סידוריים` IS FALSE
    `יש מניות רדומות כמשמעותן בסעיף 308` IS FALSE
    `יש מניות שאינן מקנות זכויות הצבעה לפי סעיף 309(ב) או סעיף 333(ב)` IS FALSE

-- 130(א)(1): name, identity number, address, quantity, class and dates are entered for every shareholder, whatever the facts.
#ASSERT `סעיף 130(א) - הפרט חייב להירשם במרשם בעלי המניות` `שם בעל המניה` `עובדות על מניות - אף תנאי אינו מתקיים`
#ASSERT `סעיף 130(א) - הפרט חייב להירשם במרשם בעלי המניות` `מספר הזהות של בעל המניה` `עובדות על מניות - אף תנאי אינו מתקיים`
#ASSERT `סעיף 130(א) - הפרט חייב להירשם במרשם בעלי המניות` `מען בעל המניה` `עובדות על מניות - אף תנאי אינו מתקיים`
#ASSERT `סעיף 130(א) - הפרט חייב להירשם במרשם בעלי המניות` `כמות המניות שבבעלותו` `עובדות על מניות - אף תנאי אינו מתקיים`
#ASSERT `סעיף 130(א) - הפרט חייב להירשם במרשם בעלי המניות` `סוג המניות שבבעלותו` `עובדות על מניות - אף תנאי אינו מתקיים`
#ASSERT `סעיף 130(א) - הפרט חייב להירשם במרשם בעלי המניות` `תאריך ההקצאה או מועדי ההעברה` `עובדות על מניות - אף תנאי אינו מתקיים`
-- 130(א)(1)(ב), (ד), (3), (4): the conditional details are due only when their condition holds.
#ASSERT `סעיף 130(א) - הפרט חייב להירשם במרשם בעלי המניות` `הערך הנקוב של המניות` `עובדות על מניות - כל התנאים מתקיימים`
#ASSERT NOT (`סעיף 130(א) - הפרט חייב להירשם במרשם בעלי המניות` `הערך הנקוב של המניות` `עובדות על מניות - אף תנאי אינו מתקיים`)
#ASSERT `סעיף 130(א) - הפרט חייב להירשם במרשם בעלי המניות` `הסכום שטרם שולם על חשבון התמורה` `עובדות על מניות - כל התנאים מתקיימים`
#ASSERT NOT (`סעיף 130(א) - הפרט חייב להירשם במרשם בעלי המניות` `הסכום שטרם שולם על חשבון התמורה` `עובדות על מניות - אף תנאי אינו מתקיים`)
#ASSERT `סעיף 130(א) - הפרט חייב להירשם במרשם בעלי המניות` `מספרי המניות הסידוריים` `עובדות על מניות - כל התנאים מתקיימים`
#ASSERT NOT (`סעיף 130(א) - הפרט חייב להירשם במרשם בעלי המניות` `מספרי המניות הסידוריים` `עובדות על מניות - אף תנאי אינו מתקיים`)
#ASSERT `סעיף 130(א) - הפרט חייב להירשם במרשם בעלי המניות` `מספר המניות הרדומות` `עובדות על מניות - כל התנאים מתקיימים`
#ASSERT `סעיף 130(א) - הפרט חייב להירשם במרשם בעלי המניות` `התאריך שבו הפכו המניות לרדומות` `עובדות על מניות - כל התנאים מתקיימים`
#ASSERT NOT (`סעיף 130(א) - הפרט חייב להירשם במרשם בעלי המניות` `מספר המניות הרדומות` `עובדות על מניות - אף תנאי אינו מתקיים`)
#ASSERT NOT (`סעיף 130(א) - הפרט חייב להירשם במרשם בעלי המניות` `התאריך שבו הפכו המניות לרדומות` `עובדות על מניות - אף תנאי אינו מתקיים`)
#ASSERT `סעיף 130(א) - הפרט חייב להירשם במרשם בעלי המניות` `מספר המניות שאינן מקנות זכויות הצבעה` `עובדות על מניות - כל התנאים מתקיימים`
#ASSERT `סעיף 130(א) - הפרט חייב להירשם במרשם בעלי המניות` `התאריך שבו הפכו המניות לשאינן מקנות זכויות הצבעה` `עובדות על מניות - כל התנאים מתקיימים`
#ASSERT NOT (`סעיף 130(א) - הפרט חייב להירשם במרשם בעלי המניות` `מספר המניות שאינן מקנות זכויות הצבעה` `עובדות על מניות - אף תנאי אינו מתקיים`)
#ASSERT NOT (`סעיף 130(א) - הפרט חייב להירשם במרשם בעלי המניות` `התאריך שבו הפכו המניות לשאינן מקנות זכויות הצבעה` `עובדות על מניות - אף תנאי אינו מתקיים`)
-- A detail the section does not list is not due.
#ASSERT NOT (`סעיף 130(א) - הפרט חייב להירשם במרשם בעלי המניות` `פרט אחר` `עובדות על מניות - כל התנאים מתקיימים`)
-- 130(ב): keep every entry and update changes as early as possible.
#ASSERT `סעיף 130(ב) - החברה קיימה את חובת השמירה והעדכון` TRUE TRUE
#ASSERT NOT (`סעיף 130(ב) - החברה קיימה את חובת השמירה והעדכון` FALSE TRUE)
#ASSERT NOT (`סעיף 130(ב) - החברה קיימה את חובת השמירה והעדכון` TRUE FALSE)

-- 131: a trustee must report; the company enters him with the note of trusteeship; he counts as a shareholder.
#ASSERT `סעיף 131(א)-(ב) - הוראת הנאמנות חלה על בעל המניה` TRUE FALSE FALSE
#ASSERT `סעיף 131(א) - בעל מניה נאמן חייב לדווח לחברה על נאמנותו` TRUE FALSE FALSE
#ASSERT `סעיף 131(א) - החברה חייבת לרשום את הנאמן במרשם תוך ציון נאמנותו` TRUE FALSE FALSE
#ASSERT `סעיף 131(א) - הנאמן נחשב לבעל מניה לענין החוק` TRUE FALSE FALSE
-- 131(ב): not for a section 177(1) shareholder, unless another provision of law imposes a reporting duty.
#ASSERT NOT (`סעיף 131(א)-(ב) - הוראת הנאמנות חלה על בעל המניה` TRUE TRUE FALSE)
#ASSERT NOT (`סעיף 131(א) - בעל מניה נאמן חייב לדווח לחברה על נאמנותו` TRUE TRUE FALSE)
#ASSERT `סעיף 131(א)-(ב) - הוראת הנאמנות חלה על בעל המניה` TRUE TRUE TRUE
#ASSERT `סעיף 131(א) - הנאמן נחשב לבעל מניה לענין החוק` TRUE TRUE TRUE
#ASSERT NOT (`סעיף 131(א)-(ב) - הוראת הנאמנות חלה על בעל המניה` FALSE FALSE TRUE)
#ASSERT NOT (`סעיף 131(א) - החברה חייבת לרשום את הנאמן במרשם תוך ציון נאמנותו` FALSE FALSE FALSE)

§§ `סעיפים 132 ו־133`

-- 132(א): a registration company may be entered only where the shares are registered for trading on a bourse in Israel; it is not regarded as owning the shares.
#ASSERT `סעיף 132(א) - אפשר לרשום חברה לרישומים במרשם בעלי המניות` TRUE
#ASSERT NOT (`סעיף 132(א) - אפשר לרשום חברה לרישומים במרשם בעלי המניות` FALSE)
#ASSERT NOT (`סעיף 132(א) - חברה לרישומים נחשבת לבעלת המניות הרשומות על שמה`)
-- 132(ב): the entitled person may be registered instead, and the registration company's number falls by the shares moved (1000 less 300 is 700).
#ASSERT `סעיף 132(ב) - בעל המניה זכאי להירשם במקום החברה לרישומים` TRUE
#ASSERT NOT (`סעיף 132(ב) - בעל המניה זכאי להירשם במקום החברה לרישומים` FALSE)
#ASSERT `סעיף 132(ב) - מספר המניות הרשומות על שם החברה לרישומים לאחר רישום בעל המניה` 1000 300 EQUALS 700
-- 133: prima facie evidence; the register prevails over the certificate; with no contradiction the text prefers neither.
#ASSERT `סעיף 133(א) - המשקל הראייתי של הרשום במרשם בעלי המניות` EQUALS `ראיה לכאורה`
#ASSERT NOT (`סעיף 133(א) - המשקל הראייתי של הרשום במרשם בעלי המניות` EQUALS `ראיה חלוטה`)
#ASSERT `סעיף 133(ב) - המסמך שערכו הראייתי עדיף` TRUE EQUALS JUST `מרשם בעלי המניות כמסמך ראייתי`
#ASSERT `סעיף 133(ב) - המסמך שערכו הראייתי עדיף` FALSE EQUALS NOTHING
-- 134: a defect in the register, the company's refusal to correct it, and an applicant who is the injured party or a shareholder.
#ASSERT `סעיף 134 - בית המשפט רשאי לתת סעד לרבות תיקון המרשם` TRUE FALSE FALSE TRUE TRUE FALSE
#ASSERT `סעיף 134 - בית המשפט רשאי לתת סעד לרבות תיקון המרשם` FALSE TRUE FALSE TRUE FALSE TRUE
#ASSERT `סעיף 134 - בית המשפט רשאי לתת סעד לרבות תיקון המרשם` FALSE FALSE TRUE TRUE TRUE TRUE
#ASSERT NOT (`סעיף 134 - בית המשפט רשאי לתת סעד לרבות תיקון המרשם` TRUE TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`סעיף 134 - בית המשפט רשאי לתת סעד לרבות תיקון המרשם` FALSE FALSE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`סעיף 134 - בית המשפט רשאי לתת סעד לרבות תיקון המרשם` TRUE FALSE FALSE TRUE FALSE FALSE)

§§ `סעיפים 137 עד 139`

-- 137: the register keeps the Securities Law reports on material holdings.
#ASSERT `סעיף 137 - הדיווח נשמר במרשם בעלי המניות המהותיים` TRUE TRUE
#ASSERT NOT (`סעיף 137 - הדיווח נשמר במרשם בעלי המניות המהותיים` FALSE TRUE)
#ASSERT NOT (`סעיף 137 - הדיווח נשמר במרשם בעלי המניות המהותיים` TRUE FALSE)
-- 138(א): a company may keep an additional register outside Israel.
#ASSERT `סעיף 138(א) - החברה רשאית לנהל מרשם בעלי מניות נוסף מחוץ לישראל` `דוגמה - חברה ציבורית שהיא תאגיד מדווח`
#ASSERT NOT (`סעיף 138(א) - החברה רשאית לנהל מרשם בעלי מניות נוסף מחוץ לישראל` `דוגמה - גוף שהתאגד לפי דין אחר`)
-- 138(ב): the main register notes the number of shares in the additional register, and their serial numbers if numbered.
#ASSERT `סעיף 138(ב) - הפרט חייב להיות מצוין במרשם העיקרי` TRUE FALSE `מספר המניות הרשומות במרשם הנוסף`
#ASSERT `סעיף 138(ב) - הפרט חייב להיות מצוין במרשם העיקרי` TRUE TRUE `מספרי המניות הרשומות במרשם הנוסף`
#ASSERT NOT (`סעיף 138(ב) - הפרט חייב להיות מצוין במרשם העיקרי` TRUE FALSE `מספרי המניות הרשומות במרשם הנוסף`)
#ASSERT NOT (`סעיף 138(ב) - הפרט חייב להיות מצוין במרשם העיקרי` FALSE TRUE `מספר המניות הרשומות במרשם הנוסף`)
