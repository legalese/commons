IMPORT prelude
IMPORT `ic-core`
IMPORT `ic2-tests-fixtures`
IMPORT `ic2-p5c1-shares`

-- Tests of ic2-p5c1-shares.l4 (sections 176 to 182). Expected values are written from the text of the section named beside each.

§ `בדיקות: בעל מניה ותעודת מניה`

§§ `סעיפים 176 ו־177`

-- 176: a shareholder in a private company is one registered as such in the register.
#ASSERT `סעיף 176 - האדם הוא בעל מניה בחברה פרטית` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` TRUE
#ASSERT NOT (`סעיף 176 - האדם הוא בעל מניה בחברה פרטית` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` FALSE)
#ASSERT NOT (`סעיף 176 - האדם הוא בעל מניה בחברה פרטית` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` TRUE)
-- 177(1): a share registered to his credit with a bourse member, among the shares registered in a registration company's name.
#ASSERT `סעיף 177(1) - האדם הוא בעל מניה כמשמעותו בפסקה (1)` TRUE TRUE
#ASSERT NOT (`סעיף 177(1) - האדם הוא בעל מניה כמשמעותו בפסקה (1)` TRUE FALSE)
#ASSERT NOT (`סעיף 177(1) - האדם הוא בעל מניה כמשמעותו בפסקה (1)` FALSE TRUE)
-- 177: a shareholder in a public company is a person of paragraph (1) or one registered in the register.
#ASSERT `סעיף 177 - האדם הוא בעל מניה בחברה ציבורית` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` TRUE TRUE FALSE
#ASSERT `סעיף 177 - האדם הוא בעל מניה בחברה ציבורית` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` FALSE FALSE TRUE
#ASSERT NOT (`סעיף 177 - האדם הוא בעל מניה בחברה ציבורית` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` TRUE FALSE FALSE)
#ASSERT NOT (`סעיף 177 - האדם הוא בעל מניה בחברה ציבורית` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` FALSE FALSE TRUE)

§§ `סעיפים 178 עד 180`

-- 178: a registered shareholder may have a certificate of ownership; a registration company may have one of the number and class registered in its name.
#ASSERT `סעיף 178(א) - בעל המניה זכאי לקבל מהחברה תעודה המעידה על בעלותו במניה` TRUE
#ASSERT NOT (`סעיף 178(א) - בעל המניה זכאי לקבל מהחברה תעודה המעידה על בעלותו במניה` FALSE)
#ASSERT `סעיף 178(ב) - החברה לרישומים זכאית לקבל מהחברה תעודה על המניות הרשומות על שמה` TRUE
#ASSERT NOT (`סעיף 178(ב) - החברה לרישומים זכאית לקבל מהחברה תעודה על המניות הרשומות על שמה` FALSE)

§§ `סעיף 181`

-- 181(א): the board may forfeit and sell only if the articles or the allotment agreement provide for it and the undertaken consideration was not given on time and on the set terms.
#ASSERT `סעיף 181(א) - הדירקטוריון רשאי לחלט את המניה ולמכור אותה` TRUE TRUE
#ASSERT NOT (`סעיף 181(א) - הדירקטוריון רשאי לחלט את המניה ולמכור אותה` FALSE TRUE)
#ASSERT NOT (`סעיף 181(א) - הדירקטוריון רשאי לחלט את המניה ולמכור אותה` TRUE FALSE)
-- 181(ב): forfeited shares not yet sold are dormant.
#ASSERT `סעיף 181(ב) - המניות הן מניות רדומות` TRUE FALSE
#ASSERT NOT (`סעיף 181(ב) - המניות הן מניות רדומות` TRUE TRUE)
#ASSERT NOT (`סעיף 181(ב) - המניות הן מניות רדומות` FALSE FALSE)
-- 181(ג): with an undertaking of 100 and sale expenses of 10, the debt is gone at 110 received, not at 109, and not unless the shares were sold.
#ASSERT NOT (`סעיף 181(ג) - החייב ממשיך לחוב לחברה` TRUE 110 100 10)
#ASSERT `סעיף 181(ג) - החייב ממשיך לחוב לחברה` TRUE 109 100 10
#ASSERT `סעיף 181(ג) - החייב ממשיך לחוב לחברה` FALSE 200 100 10
-- 181(ד): the refund of the partial consideration (30) when the sale brought more than the undertaking (100): in full when the surplus is ample; limited by what must stay with the company.
#ASSERT `סעיף 181(ד) - הסכום שהחייב זכאי לקבל בחזרה` 150 100 30 10 NOTHING EQUALS 30
#ASSERT `סעיף 181(ד) - הסכום שהחייב זכאי לקבל בחזרה` 105 100 30 10 NOTHING EQUALS 25
#ASSERT `סעיף 181(ד) - הסכום שהחייב זכאי לקבל בחזרה` 101 100 30 40 NOTHING EQUALS 0
-- No refund when the sale did not bring more than the undertaking.
#ASSERT `סעיף 181(ד) - הסכום שהחייב זכאי לקבל בחזרה` 100 100 30 10 NOTHING EQUALS 0
#ASSERT `סעיף 181(ד) - הסכום שהחייב זכאי לקבל בחזרה` 90 100 30 10 NOTHING EQUALS 0
-- A lower cap in the articles or the allotment agreement lowers the refund; a higher one does not raise it.
#ASSERT `סעיף 181(ד) - הסכום שהחייב זכאי לקבל בחזרה` 150 100 30 10 (JUST 20) EQUALS 20
#ASSERT `סעיף 181(ד) - הסכום שהחייב זכאי לקבל בחזרה` 150 100 30 10 (JUST 50) EQUALS 30
-- 181(ה): the section does not detract from other remedies.
#ASSERT NOT (`סעיף 181(ה) - הסעיף גורע מסעד אחר של החברה כלפי החייב`)

§§ `סעיף 182`

-- 182(א): the dividend record date is the decision day, or a later date the decision set; an earlier date is not provided for (NOTHING).
#ASSERT `סעיף 182(א) - המועד הקובע לזכאות לדיבידנד` (YMD 2026 3 1) NOTHING EQUALS JUST (YMD 2026 3 1)
#ASSERT `סעיף 182(א) - המועד הקובע לזכאות לדיבידנד` (YMD 2026 3 1) (JUST (YMD 2026 3 15)) EQUALS JUST (YMD 2026 3 15)
#ASSERT `סעיף 182(א) - המועד הקובע לזכאות לדיבידנד` (YMD 2026 3 1) (JUST (YMD 2026 3 1)) EQUALS JUST (YMD 2026 3 1)
#ASSERT `סעיף 182(א) - המועד הקובע לזכאות לדיבידנד` (YMD 2026 3 1) (JUST (YMD 2026 2 28)) EQUALS NOTHING
-- 182(ב): in a public company the date is 4 to 21 days before the meeting, both ends inside (F1); the Minister's other provisions are not among the inputs (NOTHING).
#ASSERT `סעיף 182(ב) - המועד הקובע לאסיפה כללית בחברה ציבורית נקבע כדין` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` 4 FALSE EQUALS JUST TRUE
#ASSERT `סעיף 182(ב) - המועד הקובע לאסיפה כללית בחברה ציבורית נקבע כדין` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` 21 FALSE EQUALS JUST TRUE
#ASSERT `סעיף 182(ב) - המועד הקובע לאסיפה כללית בחברה ציבורית נקבע כדין` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` 3 FALSE EQUALS JUST FALSE
#ASSERT `סעיף 182(ב) - המועד הקובע לאסיפה כללית בחברה ציבורית נקבע כדין` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` 22 FALSE EQUALS JUST FALSE
#ASSERT `סעיף 182(ב) - המועד הקובע לאסיפה כללית בחברה ציבורית נקבע כדין` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` 10 FALSE EQUALS JUST FALSE
#ASSERT `סעיף 182(ב) - המועד הקובע לאסיפה כללית בחברה ציבורית נקבע כדין` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` 10 TRUE EQUALS NOTHING
