IMPORT prelude
IMPORT `ic-core`
IMPORT `ic2-tests-fixtures`
IMPORT `ic2-p4c5a-auditor-appointment`

-- Tests of ic2-p4c5a-auditor-appointment.l4 (sections 154 to 161). Expected values are written from the text of the section named beside each.

§ `בדיקות: רואה חשבון מבקר – מינוי ואי תלות`

§§ `סעיף 154`

-- 154(א): every company appoints an external auditor (subject to section 158); a body that is not a company does not.
#ASSERT `סעיף 154(א) - החברה חייבת למנות רואה חשבון מבקר` `דוגמה - חברה פרטית שאינה חברת איגרות חוב`
#ASSERT `סעיף 154(א) - החברה חייבת למנות רואה חשבון מבקר` `דוגמה - חברה ציבורית שהיא תאגיד מדווח`
#ASSERT NOT (`סעיף 154(א) - החברה חייבת למנות רואה חשבון מבקר` `דוגמה - גוף שהתאגד לפי דין אחר`)
-- 154(ב): to the end of the next annual meeting; with the articles' permission up to the third annual meeting after the appointing one; never the fourth.
#ASSERT `סעיף 154(ב) - תקופת הכהונה של רואה החשבון המבקר מותרת` 1 FALSE
#ASSERT `סעיף 154(ב) - תקופת הכהונה של רואה החשבון המבקר מותרת` 1 TRUE
#ASSERT NOT (`סעיף 154(ב) - תקופת הכהונה של רואה החשבון המבקר מותרת` 2 FALSE)
#ASSERT `סעיף 154(ב) - תקופת הכהונה של רואה החשבון המבקר מותרת` 2 TRUE
#ASSERT `סעיף 154(ב) - תקופת הכהונה של רואה החשבון המבקר מותרת` 3 TRUE
#ASSERT NOT (`סעיף 154(ב) - תקופת הכהונה של רואה החשבון המבקר מותרת` 4 TRUE)
#ASSERT NOT (`סעיף 154(ב) - תקופת הכהונה של רואה החשבון המבקר מותרת` 0 TRUE)
-- 154(ג): in a private company where section 61 applies, until one audit act is completed, or three if the articles so provide.
#ASSERT `סעיף 154(ג) - כהונה עד סיום פעולות ביקורת מותרת` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` TRUE 1 FALSE
#ASSERT `סעיף 154(ג) - כהונה עד סיום פעולות ביקורת מותרת` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` TRUE 3 TRUE
#ASSERT NOT (`סעיף 154(ג) - כהונה עד סיום פעולות ביקורת מותרת` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` TRUE 3 FALSE)
#ASSERT NOT (`סעיף 154(ג) - כהונה עד סיום פעולות ביקורת מותרת` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` TRUE 2 TRUE)
#ASSERT NOT (`סעיף 154(ג) - כהונה עד סיום פעולות ביקורת מותרת` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` FALSE 1 FALSE)
#ASSERT NOT (`סעיף 154(ג) - כהונה עד סיום פעולות ביקורת מותרת` `דוגמה - חברה ציבורית שאינה תאגיד מדווח` TRUE 1 FALSE)

§§ `סעיפים 155 עד 157`

-- 155(א): the board may appoint the first auditor only before the first annual meeting; his term ends with that meeting.
#ASSERT `סעיף 155(א) - הדירקטוריון רשאי למנות את רואה החשבון המבקר הראשון ולקבוע את שכרו` FALSE
#ASSERT NOT (`סעיף 155(א) - הדירקטוריון רשאי למנות את רואה החשבון המבקר הראשון ולקבוע את שכרו` TRUE)
#ASSERT `סעיף 155(א) - כהונת רואה החשבון המבקר הראשון הסתיימה` TRUE
#ASSERT NOT (`סעיף 155(א) - כהונת רואה החשבון המבקר הראשון הסתיימה` FALSE)
-- 155(ב): the end of the term of an auditor the board appointed follows 154(ג).
#ASSERT `סעיף 155(ב) - כהונה של רואה חשבון שמונה בידי הדירקטוריון עד סיום פעולות ביקורת מותרת` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` TRUE 1 FALSE
#ASSERT NOT (`סעיף 155(ב) - כהונה של רואה חשבון שמונה בידי הדירקטוריון עד סיום פעולות ביקורת מותרת` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` TRUE 3 FALSE)
-- 156: several auditors may act jointly.
#ASSERT `סעיף 156 - החברה רשאית למנות כמה רואי חשבון מבקרים שיבצעו במשותף` `דוגמה - חברה ציבורית שהיא תאגיד מדווח`
#ASSERT NOT (`סעיף 156 - החברה רשאית למנות כמה רואי חשבון מבקרים שיבצעו במשותף` `דוגמה - גוף שהתאגד לפי דין אחר`)
-- 157: a vacancy with no other auditor obliges the board to convene a special meeting.
#ASSERT `סעיף 157 - הדירקטוריון חייב לזמן אסיפה מיוחדת למינוי רואה חשבון מבקר` TRUE FALSE
#ASSERT NOT (`סעיף 157 - הדירקטוריון חייב לזמן אסיפה מיוחדת למינוי רואה חשבון מבקר` TRUE TRUE)
#ASSERT NOT (`סעיף 157 - הדירקטוריון חייב לזמן אסיפה מיוחדת למינוי רואה חשבון מבקר` FALSE FALSE)

§§ `סעיף 158`

-- 158(א): the sum is the Act's 500,000 unless the Minister published an updated sum.
#ASSERT `סעיף 158(א) - הסכום הבסיסי של מחזור העסקים השנתי, בשקלים חדשים` EQUALS 500_000
#ASSERT `סעיף 158(א) - הסכום שמחזור העסקים אינו עולה עליו` `מחזור - ללא סכום מעודכן` EQUALS 500_000
#ASSERT `סעיף 158(א) - הסכום שמחזור העסקים אינו עולה עליו` `מחזור - מעל הבסיס אך בתוך הסכום שפורסם` EQUALS 731_660
-- A private company is inactive at a turnover of exactly the sum, and not above it.
#ASSERT `סעיף 158(א) - החברה היא חברה לא פעילה` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `מחזור - ללא סכום מעודכן`
#ASSERT NOT (`סעיף 158(א) - החברה היא חברה לא פעילה` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `מחזור - מעל הסכום הבסיסי ללא סכום מעודכן`)
#ASSERT `סעיף 158(א) - החברה היא חברה לא פעילה` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `מחזור - מעל הבסיס אך בתוך הסכום שפורסם`
#ASSERT NOT (`סעיף 158(א) - החברה היא חברה לא פעילה` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `מחזור - מעל הסכום שפורסם`)
-- A private public-benefit company is inactive up to the Associations Law's sum; an ordinary private company is not.
#ASSERT `סעיף 158(א) - החברה היא חברה לא פעילה` `דוגמה - חברה פרטית לתועלת הציבור` `מחזור - מעל הבסיס אך בתוך סכום העמותות`
#ASSERT NOT (`סעיף 158(א) - החברה היא חברה לא פעילה` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `מחזור - מעל הבסיס אך בתוך סכום העמותות`)
-- A public company is never inactive.
#ASSERT NOT (`סעיף 158(א) - החברה היא חברה לא פעילה` `דוגמה - חברה ציבורית שאינה תאגיד מדווח` `מחזור - ללא סכום מעודכן`)
-- 158(ג): the section does not apply to a bond company.
#ASSERT `סעיף 158(ג) - הוראות סעיף 158 חלות על החברה` `דוגמה - חברה פרטית שאינה חברת איגרות חוב`
#ASSERT NOT (`סעיף 158(ג) - הוראות סעיף 158 חלות על החברה` `דוגמה - חברה פרטית שהיא חברת איגרות חוב ואינה תאגיד מדווח`)
-- 158(א): the general meeting may decide on no auditor unless holders of 10% or more of the issued capital objected: 9.9% is not an effective objection, 10% is.
#ASSERT `סעיף 158(א) - האסיפה הכללית רשאית לקבוע שלא יתמנה רואה חשבון מבקר` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `מחזור - ללא סכום מעודכן` 0
#ASSERT `סעיף 158(א) - האסיפה הכללית רשאית לקבוע שלא יתמנה רואה חשבון מבקר` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `מחזור - ללא סכום מעודכן` 0.099
#ASSERT NOT (`סעיף 158(א) - האסיפה הכללית רשאית לקבוע שלא יתמנה רואה חשבון מבקר` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `מחזור - ללא סכום מעודכן` 0.1)
#ASSERT NOT (`סעיף 158(א) - האסיפה הכללית רשאית לקבוע שלא יתמנה רואה חשבון מבקר` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `מחזור - מעל הסכום הבסיסי ללא סכום מעודכן` 0)
#ASSERT NOT (`סעיף 158(א) - האסיפה הכללית רשאית לקבוע שלא יתמנה רואה חשבון מבקר` `דוגמה - חברה פרטית שהיא חברת איגרות חוב ואינה תאגיד מדווח` `מחזור - ללא סכום מעודכן` 0)
-- 158(א1): fourteen days to send the decision to the Registrar; a signed declaration with the annual report.
#ASSERT `סעיף 158(א1)(1) - מספר הימים למסירת ההחלטה לרשם` EQUALS 14
#ASSERT `סעיף 158(א1)(1) - ההחלטה נמסרה לרשם במועד` 14
#ASSERT NOT (`סעיף 158(א1)(1) - ההחלטה נמסרה לרשם במועד` 15)
#ASSERT `סעיף 158(א1)(2) - ההצהרה צורפה כנדרש` TRUE TRUE TRUE
#ASSERT NOT (`סעיף 158(א1)(2) - ההצהרה צורפה כנדרש` FALSE TRUE TRUE)
#ASSERT NOT (`סעיף 158(א1)(2) - ההצהרה צורפה כנדרש` TRUE FALSE TRUE)
#ASSERT NOT (`סעיף 158(א1)(2) - ההצהרה צורפה כנדרש` TRUE TRUE FALSE)

§§ `סעיף 159`

-- 159(א): ninety days to tell the Registrar that the auditor ceased; fourteen days to tell him of a new appointment.
#ASSERT `סעיף 159(א) - מספר הימים להודעה לרשם על הפסקת כהונתו של רואה החשבון המבקר` EQUALS 90
#ASSERT `סעיף 159(א) - מספר הימים להודעה לרשם על מינוי רואה חשבון מבקר לאחר ההודעה הראשונה` EQUALS 14
#ASSERT `סעיף 159(א) - ההודעה על הפסקת הכהונה נמסרה במועד` 90
#ASSERT NOT (`סעיף 159(א) - ההודעה על הפסקת הכהונה נמסרה במועד` 91)
#ASSERT `סעיף 159(א) - ההודעה על המינוי נמסרה במועד` 14
#ASSERT NOT (`סעיף 159(א) - ההודעה על המינוי נמסרה במועד` 15)
-- The notice to the Registrar does not end the duty to appoint; only an appointment does.
#ASSERT `סעיף 159(א) - חובת המינוי נמשכת` TRUE FALSE
#ASSERT NOT (`סעיף 159(א) - חובת המינוי נמשכת` TRUE TRUE)
-- 159(ב): the Registrar may appoint after notice of cessation and while he has no notice of a new appointment.
#ASSERT `סעיף 159(ב) - הרשם רשאי למנות רואה חשבון מבקר ולקבוע את שכרו` TRUE FALSE
#ASSERT NOT (`סעיף 159(ב) - הרשם רשאי למנות רואה חשבון מבקר ולקבוע את שכרו` TRUE TRUE)
#ASSERT NOT (`סעיף 159(ב) - הרשם רשאי למנות רואה חשבון מבקר ולקבוע את שכרו` FALSE FALSE)

§§ `סעיפים 160 ו־161`

-- 160(א): the auditor is independent directly and indirectly.
#ASSERT `סעיף 160(א) - רואה החשבון המבקר בלתי תלוי בחברה` FALSE FALSE
#ASSERT NOT (`סעיף 160(א) - רואה החשבון המבקר בלתי תלוי בחברה` TRUE FALSE)
#ASSERT NOT (`סעיף 160(א) - רואה החשבון המבקר בלתי תלוי בחברה` FALSE TRUE)
-- 161: a further audit by another auditor, unless five years had passed when the board learned of it: four years does not suffice, five does.
#ASSERT `סעיף 161 - חובה לבצע פעולת ביקורת נוספת בידי רואה חשבון מבקר אחר` TRUE 4
#ASSERT NOT (`סעיף 161 - חובה לבצע פעולת ביקורת נוספת בידי רואה חשבון מבקר אחר` TRUE 5)
#ASSERT NOT (`סעיף 161 - חובה לבצע פעולת ביקורת נוספת בידי רואה חשבון מבקר אחר` FALSE 1)
