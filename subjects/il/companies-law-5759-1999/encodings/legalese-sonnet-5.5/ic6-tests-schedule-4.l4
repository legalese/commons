IMPORT prelude
IMPORT `ic-core`
IMPORT `ic6-schedule-4`

-- Tests of ic6-schedule-4.l4 (the Fourth Schedule). Expected values are written by hand from the items.

§ `בדיקות – התוספת הרביעית: מען דיגיטלי`

-- An e-mail address and a mobile number: complete.
#ASSERT `תוספת 4 - מען דיגיטלי מלא` "a@example.com" "0501234567" ""
-- An e-mail address and a different second e-mail address: complete.
#ASSERT `תוספת 4 - מען דיגיטלי מלא` "a@example.com" "" "b@example.com"
-- A second e-mail address identical to the first does not satisfy item 2.
#ASSERT NOT (`תוספת 4 - מען דיגיטלי מלא` "a@example.com" "" "a@example.com")
-- An e-mail address alone: item 2 missing.
#ASSERT NOT (`תוספת 4 - מען דיגיטלי מלא` "a@example.com" "" "")
-- A mobile number without the e-mail address of item 1: item 1 missing.
#ASSERT NOT (`תוספת 4 - מען דיגיטלי מלא` "" "0501234567" "")
-- Both a mobile number and a second address: complete.
#ASSERT `תוספת 4 - מען דיגיטלי מלא` "a@example.com" "0501234567" "b@example.com"
-- Item by item.
#ASSERT `תוספת 4 פרט 1 - נמסרה כתובת דואר אלקטרוני` "a@example.com"
#ASSERT NOT (`תוספת 4 פרט 1 - נמסרה כתובת דואר אלקטרוני` "")
#ASSERT `תוספת 4 פרט 2 - נמסר מספר טלפון נייד או כתובת דואר אלקטרוני אחרת` "a@example.com" "0501234567" ""
#ASSERT NOT (`תוספת 4 פרט 2 - נמסר מספר טלפון נייד או כתובת דואר אלקטרוני אחרת` "a@example.com" "" "a@example.com")
