IMPORT prelude
IMPORT `ic-core`
IMPORT `ic-core-company-kinds`
IMPORT `ic6-schedule-1`
IMPORT `ic6-tests-fixtures`

-- Tests of ic6-schedule-1.l4 (the First Schedule). Expected values are written by hand from the items.

§ `בדיקות – התוספת הראשונה: הוראות ממשל תאגידי מומלצות`

§§ `החלת ההוראה על החברה`

-- Items 1 to 6 apply to a public company and to a private bond company that adopted them; not to an ordinary private company; and not if not adopted.
#ASSERT `תוספת 1 - ההוראה המומלצת חלה על החברה` `בדיקה ic6 - חברה ציבורית` `פרט 1: שיעור הדירקטורים הבלתי תלויים` TRUE
#ASSERT `תוספת 1 - ההוראה המומלצת חלה על החברה` `בדיקה ic6 - חברה פרטית שהיא חברת איגרות חוב` `פרט 3: הגבלת כהונת נושא משרה כדירקטור` TRUE
#ASSERT `תוספת 1 - ההוראה המומלצת חלה על החברה` `בדיקה ic6 - חברה ציבורית` `פרט 6: ישיבות ועדת ביקורת בנוכחות המבקר הפנימי ורואה החשבון המבקר` TRUE
#ASSERT NOT (`תוספת 1 - ההוראה המומלצת חלה על החברה` `בדיקה ic6 - חברה פרטית רגילה` `פרט 1: שיעור הדירקטורים הבלתי תלויים` TRUE)
#ASSERT NOT (`תוספת 1 - ההוראה המומלצת חלה על החברה` `בדיקה ic6 - חברה ציבורית` `פרט 1: שיעור הדירקטורים הבלתי תלויים` FALSE)
-- Item 7 applies to a public company only: not to a private bond company.
#ASSERT `תוספת 1 - ההוראה המומלצת חלה על החברה` `בדיקה ic6 - חברה ציבורית` `פרט 7: מינוי דירקטור חיצוני` TRUE
#ASSERT NOT (`תוספת 1 - ההוראה המומלצת חלה על החברה` `בדיקה ic6 - חברה פרטית שהיא חברת איגרות חוב` `פרט 7: מינוי דירקטור חיצוני` TRUE)
#ASSERT NOT (`תוספת 1 - ההוראה המומלצת חלה על החברה` `בדיקה ic6 - חברה ציבורית` `פרט 7: מינוי דירקטור חיצוני` FALSE)

§§ `פרט 1`

-- No controlling shareholder and the largest holder below 25 percent: a majority (more than half) must be independent. Of 9 directors, 5 yes, 4 no; of 10, 5 no, 6 yes.
#ASSERT `תוספת 1 פרט 1 - שיעור הדירקטורים הבלתי תלויים מתקיים` FALSE (24%) 9 5
#ASSERT NOT (`תוספת 1 פרט 1 - שיעור הדירקטורים הבלתי תלויים מתקיים` FALSE (24%) 9 4)
#ASSERT NOT (`תוספת 1 פרט 1 - שיעור הדירקטורים הבלתי תלויים מתקיים` FALSE (24%) 10 5)
#ASSERT `תוספת 1 פרט 1 - שיעור הדירקטורים הבלתי תלויים מתקיים` FALSE (24%) 10 6
-- With a controlling shareholder, or a holder of 25 percent or more (a control block): at least a third. Of 9, 3 yes, 2 no; of 10, 4 yes, 3 no.
#ASSERT `תוספת 1 פרט 1 - שיעור הדירקטורים הבלתי תלויים מתקיים` TRUE (10%) 9 3
#ASSERT NOT (`תוספת 1 פרט 1 - שיעור הדירקטורים הבלתי תלויים מתקיים` TRUE (10%) 9 2)
#ASSERT `תוספת 1 פרט 1 - שיעור הדירקטורים הבלתי תלויים מתקיים` FALSE (25%) 10 4
#ASSERT NOT (`תוספת 1 פרט 1 - שיעור הדירקטורים הבלתי תלויים מתקיים` FALSE (25%) 10 3)
#ASSERT `תוספת 1 פרט 1 - שיעור הדירקטורים הבלתי תלויים מתקיים` FALSE (60%) 6 2

§§ `פרטים 2 עד 6`

#ASSERT `תוספת 1 פרט 2 - המינוי גיוון את הרכב הדירקטוריון` TRUE TRUE TRUE
#ASSERT NOT (`תוספת 1 פרט 2 - המינוי גיוון את הרכב הדירקטוריון` FALSE TRUE TRUE)
#ASSERT NOT (`תוספת 1 פרט 2 - המינוי גיוון את הרכב הדירקטוריון` TRUE FALSE TRUE)
#ASSERT NOT (`תוספת 1 פרט 2 - המינוי גיוון את הרכב הדירקטוריון` TRUE TRUE FALSE)
-- Item 3: someone not subordinate may serve; an employee representative may if the company has employee representation; a director of a controlled corporation may.
#ASSERT `תוספת 1 פרט 3 - האדם רשאי לכהן כדירקטור` FALSE FALSE FALSE FALSE
#ASSERT NOT (`תוספת 1 פרט 3 - האדם רשאי לכהן כדירקטור` TRUE FALSE FALSE FALSE)
#ASSERT `תוספת 1 פרט 3 - האדם רשאי לכהן כדירקטור` TRUE TRUE TRUE FALSE
#ASSERT NOT (`תוספת 1 פרט 3 - האדם רשאי לכהן כדירקטור` TRUE TRUE FALSE FALSE)
#ASSERT `תוספת 1 פרט 3 - האדם רשאי לכהן כדירקטור` TRUE FALSE FALSE TRUE
-- Item 4.
#ASSERT `תוספת 1 פרט 4(א) - החברה דאגה להכשרת הדירקטורים` TRUE TRUE TRUE
#ASSERT NOT (`תוספת 1 פרט 4(א) - החברה דאגה להכשרת הדירקטורים` FALSE TRUE TRUE)
#ASSERT NOT (`תוספת 1 פרט 4(א) - החברה דאגה להכשרת הדירקטורים` TRUE FALSE TRUE)
#ASSERT NOT (`תוספת 1 פרט 4(א) - החברה דאגה להכשרת הדירקטורים` TRUE TRUE FALSE)
#ASSERT `תוספת 1 פרט 4(ב) - האחראי להטמעת הוראות הממשל התאגידי פועל כנדרש` TRUE TRUE
#ASSERT NOT (`תוספת 1 פרט 4(ב) - האחראי להטמעת הוראות הממשל התאגידי פועל כנדרש` TRUE FALSE)
#ASSERT NOT (`תוספת 1 פרט 4(ב) - האחראי להטמעת הוראות הממשל התאגידי פועל כנדרש` FALSE TRUE)
-- Items 5 and 6: at least one discussion or meeting a year, with the conditions.
#ASSERT `תוספת 1 פרט 5 - הדירקטוריון קיים את הדיון השנתי בלא נוכחות המנהל הכללי` 1 TRUE
#ASSERT NOT (`תוספת 1 פרט 5 - הדירקטוריון קיים את הדיון השנתי בלא נוכחות המנהל הכללי` 0 TRUE)
#ASSERT NOT (`תוספת 1 פרט 5 - הדירקטוריון קיים את הדיון השנתי בלא נוכחות המנהל הכללי` 2 FALSE)
#ASSERT `תוספת 1 פרט 6 - ועדת הביקורת קיימה את הישיבה השנתית` 1 TRUE TRUE TRUE
#ASSERT NOT (`תוספת 1 פרט 6 - ועדת הביקורת קיימה את הישיבה השנתית` 0 TRUE TRUE TRUE)
#ASSERT NOT (`תוספת 1 פרט 6 - ועדת הביקורת קיימה את הישיבה השנתית` 1 FALSE TRUE TRUE)
#ASSERT NOT (`תוספת 1 פרט 6 - ועדת הביקורת קיימה את הישיבה השנתית` 1 TRUE FALSE TRUE)
#ASSERT NOT (`תוספת 1 פרט 6 - ועדת הביקורת קיימה את הישיבה השנתית` 1 TRUE TRUE FALSE)

§§ `פרט 7`

-- (1): a vote is counted if the voter is not a controlling shareholder, has no personal interest (or one not resulting from a link with the controller), and did not abstain.
#ASSERT `תוספת 1 פרט 7(1) - קולו של בעל המניות נספר` FALSE FALSE FALSE FALSE
#ASSERT `תוספת 1 פרט 7(1) - קולו של בעל המניות נספר` FALSE TRUE TRUE FALSE
#ASSERT NOT (`תוספת 1 פרט 7(1) - קולו של בעל המניות נספר` TRUE FALSE FALSE FALSE)
#ASSERT NOT (`תוספת 1 פרט 7(1) - קולו של בעל המניות נספר` FALSE TRUE FALSE FALSE)
#ASSERT NOT (`תוספת 1 פרט 7(1) - קולו של בעל המניות נספר` FALSE FALSE FALSE TRUE)
-- (2): of 100,000 voting rights, 2 percent is 2,000. 3,000 for and 1,000 against: enough. 2,000 for: not more than 2 percent. 3,000 for and 3,000 against: no majority.
#ASSERT `תוספת 1 פרט 7(2) - ההצבעה באסיפה הכללית מספיקה למינוי` (`הצבעה` OF 3_000, 1_000, 500) 100_000
#ASSERT NOT (`תוספת 1 פרט 7(2) - ההצבעה באסיפה הכללית מספיקה למינוי` (`הצבעה` OF 2_000, 100, 0) 100_000)
#ASSERT `תוספת 1 פרט 7(2) - ההצבעה באסיפה הכללית מספיקה למינוי` (`הצבעה` OF 2_001, 100, 0) 100_000
#ASSERT NOT (`תוספת 1 פרט 7(2) - ההצבעה באסיפה הכללית מספיקה למינוי` (`הצבעה` OF 3_000, 3_000, 0) 100_000)
-- The abstentions do not count either way: 3,000 for, 2,999 against, 90,000 abstaining is still a majority above 2 percent.
#ASSERT `תוספת 1 פרט 7(2) - ההצבעה באסיפה הכללית מספיקה למינוי` (`הצבעה` OF 3_000, 2_999, 90_000) 100_000
-- (3): the director to be appointed.
#ASSERT `תוספת 1 פרט 7(3) - הדירקטור שימונה עומד בתנאי העצמאות` FALSE FALSE FALSE
#ASSERT NOT (`תוספת 1 פרט 7(3) - הדירקטור שימונה עומד בתנאי העצמאות` TRUE FALSE FALSE)
#ASSERT NOT (`תוספת 1 פרט 7(3) - הדירקטור שימונה עומד בתנאי העצמאות` FALSE TRUE FALSE)
#ASSERT NOT (`תוספת 1 פרט 7(3) - הדירקטור שימונה עומד בתנאי העצמאות` FALSE FALSE TRUE)
-- "Related or competing shareholder": the proposer or a material shareholder with business ties or competing; the Minister's determination takes it out.
#ASSERT `תוספת 1 פרט 7(3) - בעל מניה קשור או מתחרה` TRUE TRUE FALSE FALSE
#ASSERT `תוספת 1 פרט 7(3) - בעל מניה קשור או מתחרה` TRUE FALSE TRUE FALSE
#ASSERT NOT (`תוספת 1 פרט 7(3) - בעל מניה קשור או מתחרה` TRUE FALSE FALSE FALSE)
#ASSERT NOT (`תוספת 1 פרט 7(3) - בעל מניה קשור או מתחרה` FALSE TRUE TRUE FALSE)
#ASSERT NOT (`תוספת 1 פרט 7(3) - בעל מניה קשור או מתחרה` TRUE TRUE FALSE TRUE)
-- "Link": section 240(ב) link, unless the Minister determined otherwise.
#ASSERT `תוספת 1 פרט 7(3) - זיקה` TRUE FALSE
#ASSERT NOT (`תוספת 1 פרט 7(3) - זיקה` TRUE TRUE)
#ASSERT NOT (`תוספת 1 פרט 7(3) - זיקה` FALSE FALSE)
