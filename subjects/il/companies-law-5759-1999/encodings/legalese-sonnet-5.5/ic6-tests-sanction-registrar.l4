IMPORT prelude
IMPORT daydate
IMPORT `ic-core`
IMPORT `ic-core-company-kinds`
IMPORT `ic6-common`
IMPORT `ic6-sanction-registrar`
IMPORT `ic6-tests-fixtures`

-- Tests of ic6-sanction-registrar.l4 (Part 9 chapter 4 sub-chapter ב). Expected values are written by hand from the sections named; none is copied from the rules' output.
-- Short names for the violations of section 354, so the assertions stay readable. The group of each: A = subsection (א) or (ב); P1 = (ב1)(1); Q2 = (ב1)(2); N3 = (ב1)(3); F4 = (ב1)(4).

§ `בדיקות – חלק 9 פרק 4 סימן ב: עיצום כספי בידי הרשם`

§§ `שמות קצרים להפרות`

`בדיקה ic6 - הפרה A37` MEANS `הפרת הוראת הרשם לפי סעיף 37(ב) או (ג)`
`בדיקה ic6 - הפרה A44` MEANS `אי תשלום אגרות או תשלומים אחרים לפי סעיף 44(6)`
`בדיקה ic6 - הפרה A140` MEANS `הפרת חובת הדיווחים לפי סעיף 140`
`בדיקה ic6 - הפרה A141` MEANS `הפרת חובת הדין וחשבון השנתי לפי סעיפים 141 או 348`
`בדיקה ic6 - הפרה A173` MEANS `הפרת חובה לפי סעיפים 173(א) או 175`
`בדיקה ic6 - הפרה A343` MEANS `הפרת חובה לפי סעיף 343`
`בדיקה ic6 - הפרה P1a` MEANS `אי הודעה לרשם על החלטה לשנות את התקנון כך שהחברה תהיה חברה לתועלת הציבור`
`בדיקה ic6 - הפרה P1b` MEANS `אי ציון הסיומת ”חברה לתועלת הציבור“ או ”(חל״צ)“ בצד שמה`
`בדיקה ic6 - הפרה P1c` MEANS `אי הגשת דוחות ומסמכים לפי סעיפים 345ב, 345ג או 345כד`
`בדיקה ic6 - הפרה P1d` MEANS `אי תשלום אגרות או תשלומים אחרים לפי סעיף 345כז`
`בדיקה ic6 - הפרה P1e` MEANS `הפרת חובת גילוי לפי סעיפים 2 או 5א(א) עד (ג) לחוק חובת גילוי לגבי מי שנתמך על ידי ישות מדינית זרה`
`בדיקה ic6 - הפרה Q2a` MEANS `אי הצהרה בפני הרשם בעת בקשת הרישום כי היא חברה לתועלת הציבור`
`בדיקה ic6 - הפרה Q2b` MEANS `אי הגשת בקשה לרשם ההקדשות לרישום בפנקס`
`בדיקה ic6 - הפרה Q2c` MEANS `ציון הסיומת או הצגה כחברה לתועלת הציבור אף שאינה רשומה בפנקס`
`בדיקה ic6 - הפרה Q2d` MEANS `אי מינוי ועדת ביקורת או מבקר פנימי בניגוד להוראות לפי סעיפים 345ח או 345ט`
`בדיקה ic6 - הפרה Q2e` MEANS `אי הודעה לרשם ההקדשות על אישור עסקה שאינה חריגה`
`בדיקה ic6 - הפרה N3` MEANS `ציון הסיומת או הצגה כחברה לתועלת הציבור בידי חברה שאינה חברה לתועלת הציבור`
`בדיקה ic6 - הפרה F4` MEANS `אי רישום חברת חוץ לתועלת הציבור כחברת חוץ`

§§ `סעיף 354: היקף העיצום`

-- The base figure the Law states.
#ASSERT `סעיף 354(א) - סכום העיצום הכספי בחוק` EQUALS 6_000

-- (א): a private company that is not a reporting corporation, the five violations: the base sanction.
#ASSERT `סעיף 354 - היקף העיצום שהרשם רשאי להטיל` `בדיקה ic6 - תאגיד שהוא חברה פרטית רגילה` FALSE `בדיקה ic6 - הפרה A37` TRUE EQUALS `העיצום הכספי`
#ASSERT `סעיף 354 - היקף העיצום שהרשם רשאי להטיל` `בדיקה ic6 - תאגיד שהוא חברה פרטית רגילה` FALSE `בדיקה ic6 - הפרה A44` TRUE EQUALS `העיצום הכספי`
#ASSERT `סעיף 354 - היקף העיצום שהרשם רשאי להטיל` `בדיקה ic6 - תאגיד שהוא חברה פרטית רגילה` FALSE `בדיקה ic6 - הפרה A140` TRUE EQUALS `העיצום הכספי`
#ASSERT `סעיף 354 - היקף העיצום שהרשם רשאי להטיל` `בדיקה ic6 - תאגיד שהוא חברה פרטית רגילה` FALSE `בדיקה ic6 - הפרה A141` TRUE EQUALS `העיצום הכספי`
#ASSERT `סעיף 354 - היקף העיצום שהרשם רשאי להטיל` `בדיקה ic6 - תאגיד שהוא חברה פרטית רגילה` FALSE `בדיקה ic6 - הפרה A173` TRUE EQUALS `העיצום הכספי`
#ASSERT `סעיף 354 - היקף העיצום שהרשם רשאי להטיל` `בדיקה ic6 - תאגיד שהוא חברה פרטית רגילה` FALSE `בדיקה ic6 - הפרה A343` TRUE EQUALS `העיצום הכספי`
-- A foreign company that is not a reporting corporation, the annual report violation: the base sanction.
#ASSERT `סעיף 354 - היקף העיצום שהרשם רשאי להטיל` `בדיקה ic6 - חברת חוץ` FALSE `בדיקה ic6 - הפרה A141` TRUE EQUALS `העיצום הכספי`
-- Without the Registrar's reasonable basis: no power.
#ASSERT `סעיף 354 - היקף העיצום שהרשם רשאי להטיל` `בדיקה ic6 - תאגיד שהוא חברה פרטית רגילה` FALSE `בדיקה ic6 - הפרה A37` FALSE EQUALS `אין סמכות להטיל עיצום כספי לפי סעיף 354`
-- (ב): a reporting corporation (a public company): only the non-payment of fees and the breach of section 343.
#ASSERT `סעיף 354 - היקף העיצום שהרשם רשאי להטיל` `בדיקה ic6 - תאגיד שהוא חברה ציבורית` FALSE `בדיקה ic6 - הפרה A44` TRUE EQUALS `העיצום הכספי`
#ASSERT `סעיף 354 - היקף העיצום שהרשם רשאי להטיל` `בדיקה ic6 - תאגיד שהוא חברה ציבורית` FALSE `בדיקה ic6 - הפרה A343` TRUE EQUALS `העיצום הכספי`
#ASSERT `סעיף 354 - היקף העיצום שהרשם רשאי להטיל` `בדיקה ic6 - תאגיד שהוא חברה ציבורית` FALSE `בדיקה ic6 - הפרה A37` TRUE EQUALS `אין סמכות להטיל עיצום כספי לפי סעיף 354`
#ASSERT `סעיף 354 - היקף העיצום שהרשם רשאי להטיל` `בדיקה ic6 - תאגיד שהוא חברה ציבורית` FALSE `בדיקה ic6 - הפרה A140` TRUE EQUALS `אין סמכות להטיל עיצום כספי לפי סעיף 354`
-- A private company that is a reporting corporation (a bond company) is outside (א) but inside (ב) for fees and section 343 (fork F-ic6-1).
#ASSERT `סעיף 354 - היקף העיצום שהרשם רשאי להטיל` `בדיקה ic6 - תאגיד שהוא חברה פרטית שהיא חברת איגרות חוב` FALSE `בדיקה ic6 - הפרה A44` TRUE EQUALS `העיצום הכספי`
#ASSERT `סעיף 354 - היקף העיצום שהרשם רשאי להטיל` `בדיקה ic6 - תאגיד שהוא חברה פרטית שהיא חברת איגרות חוב` FALSE `בדיקה ic6 - הפרה A140` TRUE EQUALS `אין סמכות להטיל עיצום כספי לפי סעיף 354`
-- (ב1)(1): a public-benefit company, paragraphs (א) to (ה): the base sanction.
#ASSERT `סעיף 354 - היקף העיצום שהרשם רשאי להטיל` `בדיקה ic6 - תאגיד שהוא חברה לתועלת הציבור` FALSE `בדיקה ic6 - הפרה P1a` TRUE EQUALS `העיצום הכספי`
#ASSERT `סעיף 354 - היקף העיצום שהרשם רשאי להטיל` `בדיקה ic6 - תאגיד שהוא חברה לתועלת הציבור` FALSE `בדיקה ic6 - הפרה P1b` TRUE EQUALS `העיצום הכספי`
#ASSERT `סעיף 354 - היקף העיצום שהרשם רשאי להטיל` `בדיקה ic6 - תאגיד שהוא חברה לתועלת הציבור` FALSE `בדיקה ic6 - הפרה P1c` TRUE EQUALS `העיצום הכספי`
#ASSERT `סעיף 354 - היקף העיצום שהרשם רשאי להטיל` `בדיקה ic6 - תאגיד שהוא חברה לתועלת הציבור` FALSE `בדיקה ic6 - הפרה P1d` TRUE EQUALS `העיצום הכספי`
#ASSERT `סעיף 354 - היקף העיצום שהרשם רשאי להטיל` `בדיקה ic6 - תאגיד שהוא חברה לתועלת הציבור` FALSE `בדיקה ic6 - הפרה P1e` TRUE EQUALS `העיצום הכספי`
-- (ב1)(2): the same company, paragraphs (א) to (ה): double.
#ASSERT `סעיף 354 - היקף העיצום שהרשם רשאי להטיל` `בדיקה ic6 - תאגיד שהוא חברה לתועלת הציבור` FALSE `בדיקה ic6 - הפרה Q2a` TRUE EQUALS `כפל העיצום הכספי`
#ASSERT `סעיף 354 - היקף העיצום שהרשם רשאי להטיל` `בדיקה ic6 - תאגיד שהוא חברה לתועלת הציבור` FALSE `בדיקה ic6 - הפרה Q2b` TRUE EQUALS `כפל העיצום הכספי`
#ASSERT `סעיף 354 - היקף העיצום שהרשם רשאי להטיל` `בדיקה ic6 - תאגיד שהוא חברה לתועלת הציבור` FALSE `בדיקה ic6 - הפרה Q2c` TRUE EQUALS `כפל העיצום הכספי`
#ASSERT `סעיף 354 - היקף העיצום שהרשם רשאי להטיל` `בדיקה ic6 - תאגיד שהוא חברה לתועלת הציבור` FALSE `בדיקה ic6 - הפרה Q2d` TRUE EQUALS `כפל העיצום הכספי`
#ASSERT `סעיף 354 - היקף העיצום שהרשם רשאי להטיל` `בדיקה ic6 - תאגיד שהוא חברה לתועלת הציבור` FALSE `בדיקה ic6 - הפרה Q2e` TRUE EQUALS `כפל העיצום הכספי`
-- A public-benefit company is also a private company that is not reporting: subsection (א) reaches it too.
#ASSERT `סעיף 354 - היקף העיצום שהרשם רשאי להטיל` `בדיקה ic6 - תאגיד שהוא חברה לתועלת הציבור` FALSE `בדיקה ic6 - הפרה A140` TRUE EQUALS `העיצום הכספי`
-- The (ב1)(1) and (2) violations are for public-benefit companies only.
#ASSERT `סעיף 354 - היקף העיצום שהרשם רשאי להטיל` `בדיקה ic6 - תאגיד שהוא חברה פרטית רגילה` FALSE `בדיקה ic6 - הפרה P1a` TRUE EQUALS `אין סמכות להטיל עיצום כספי לפי סעיף 354`
#ASSERT `סעיף 354 - היקף העיצום שהרשם רשאי להטיל` `בדיקה ic6 - תאגיד שהוא חברה פרטית רגילה` FALSE `בדיקה ic6 - הפרה Q2a` TRUE EQUALS `אין סמכות להטיל עיצום כספי לפי סעיף 354`
-- (ב1)(3): a company that is not public-benefit used the suffix: double. A public-benefit company is outside this paragraph.
#ASSERT `סעיף 354 - היקף העיצום שהרשם רשאי להטיל` `בדיקה ic6 - תאגיד שהוא חברה פרטית רגילה` FALSE `בדיקה ic6 - הפרה N3` TRUE EQUALS `כפל העיצום הכספי`
#ASSERT `סעיף 354 - היקף העיצום שהרשם רשאי להטיל` `בדיקה ic6 - תאגיד שהוא חברה לתועלת הציבור` FALSE `בדיקה ic6 - הפרה N3` TRUE EQUALS `אין סמכות להטיל עיצום כספי לפי סעיף 354`
-- (ב1)(4): a foreign public-benefit company did not register as a foreign company: double; any other foreign company is outside.
#ASSERT `סעיף 354 - היקף העיצום שהרשם רשאי להטיל` `בדיקה ic6 - חברת חוץ` TRUE `בדיקה ic6 - הפרה F4` TRUE EQUALS `כפל העיצום הכספי`
#ASSERT `סעיף 354 - היקף העיצום שהרשם רשאי להטיל` `בדיקה ic6 - חברת חוץ` FALSE `בדיקה ic6 - הפרה F4` TRUE EQUALS `אין סמכות להטיל עיצום כספי לפי סעיף 354`

-- The amount that follows: base 6,000 once or twice; with the base updated to 9,380 (the figure in the Wikisource note for 2026): once or twice; no power: NOTHING.
#ASSERT `סעיף 354 - סכום העיצום שהרשם רשאי להטיל` `העיצום הכספי` 6_000 EQUALS JUST 6_000
#ASSERT `סעיף 354 - סכום העיצום שהרשם רשאי להטיל` `כפל העיצום הכספי` 6_000 EQUALS JUST 12_000
#ASSERT `סעיף 354 - סכום העיצום שהרשם רשאי להטיל` `העיצום הכספי` 9_380 EQUALS JUST 9_380
#ASSERT `סעיף 354 - סכום העיצום שהרשם רשאי להטיל` `כפל העיצום הכספי` 9_380 EQUALS JUST 18_760
#ASSERT `סעיף 354 - סכום העיצום שהרשם רשאי להטיל` `אין סמכות להטיל עיצום כספי לפי סעיף 354` 6_000 EQUALS NOTHING

-- (ב1)(2)(ב): no sanction for failing to apply for entry in the register if one was imposed for failing to declare, unless six months have passed since it and the company is still not entered.
-- Imposed on 1 January 2026: six months end on 1 July 2026; the Registrar may impose from 2 July.
#ASSERT `סעיף 354(ב1)(2)(ב) - הרשם רשאי להטיל עיצום בשל אי הגשת בקשה לרישום בפנקס` NOTHING TRUE (YMD 2026 1 5)
#ASSERT NOT (`סעיף 354(ב1)(2)(ב) - הרשם רשאי להטיל עיצום בשל אי הגשת בקשה לרישום בפנקס` (JUST (YMD 2026 1 1)) TRUE (YMD 2026 7 1))
#ASSERT `סעיף 354(ב1)(2)(ב) - הרשם רשאי להטיל עיצום בשל אי הגשת בקשה לרישום בפנקס` (JUST (YMD 2026 1 1)) TRUE (YMD 2026 7 2)
#ASSERT NOT (`סעיף 354(ב1)(2)(ב) - הרשם רשאי להטיל עיצום בשל אי הגשת בקשה לרישום בפנקס` (JUST (YMD 2026 1 1)) FALSE (YMD 2026 9 1))
-- (ב1)(4): the same between not registering as a foreign company and not registering under section 345ב.
#ASSERT `סעיף 354(ב1)(4) - הרשם רשאי להטיל עיצום בשל אי רישום לפי סעיף 345ב(א) או (ז)` NOTHING TRUE (YMD 2026 1 5)
#ASSERT NOT (`סעיף 354(ב1)(4) - הרשם רשאי להטיל עיצום בשל אי רישום לפי סעיף 345ב(א) או (ז)` (JUST (YMD 2026 1 1)) TRUE (YMD 2026 7 1))
#ASSERT `סעיף 354(ב1)(4) - הרשם רשאי להטיל עיצום בשל אי רישום לפי סעיף 345ב(א) או (ז)` (JUST (YMD 2026 1 1)) TRUE (YMD 2026 7 2)
#ASSERT NOT (`סעיף 354(ב1)(4) - הרשם רשאי להטיל עיצום בשל אי רישום לפי סעיף 345ב(א) או (ז)` (JUST (YMD 2026 1 1)) FALSE (YMD 2026 9 1))

-- (ב1)(5): arguments: applicant, written warning, violation, knew or should have known, opposed and took all measures, relied in good faith, special circumstances, company acted under the other provisions.
#ASSERT `סעיף 354(ב1)(5) - בית משפט השלום רשאי להורות לנושא משרה להשיב לחברה את העיצום` `בעל מניה בחברה` TRUE `בדיקה ic6 - הפרה P1a` TRUE FALSE FALSE FALSE FALSE
#ASSERT `סעיף 354(ב1)(5) - בית משפט השלום רשאי להורות לנושא משרה להשיב לחברה את העיצום` `תורם לחברה` TRUE `בדיקה ic6 - הפרה P1e` TRUE FALSE FALSE FALSE FALSE
#ASSERT `סעיף 354(ב1)(5) - בית משפט השלום רשאי להורות לנושא משרה להשיב לחברה את העיצום` `רשם ההקדשות` TRUE `בדיקה ic6 - הפרה N3` TRUE FALSE FALSE FALSE FALSE
#ASSERT NOT (`סעיף 354(ב1)(5) - בית משפט השלום רשאי להורות לנושא משרה להשיב לחברה את העיצום` `מבקש אחר` TRUE `בדיקה ic6 - הפרה P1a` TRUE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`סעיף 354(ב1)(5) - בית משפט השלום רשאי להורות לנושא משרה להשיב לחברה את העיצום` `בעל מניה בחברה` FALSE `בדיקה ic6 - הפרה P1a` TRUE FALSE FALSE FALSE FALSE)
-- A violation that is not among those the paragraph lists: (1)(ב) (suffix) and (2)(ג) are not listed.
#ASSERT NOT (`סעיף 354(ב1)(5) - בית משפט השלום רשאי להורות לנושא משרה להשיב לחברה את העיצום` `בעל מניה בחברה` TRUE `בדיקה ic6 - הפרה P1b` TRUE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`סעיף 354(ב1)(5) - בית משפט השלום רשאי להורות לנושא משרה להשיב לחברה את העיצום` `בעל מניה בחברה` TRUE `בדיקה ic6 - הפרה Q2c` TRUE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`סעיף 354(ב1)(5) - בית משפט השלום רשאי להורות לנושא משרה להשיב לחברה את העיצום` `בעל מניה בחברה` TRUE `בדיקה ic6 - הפרה A140` TRUE FALSE FALSE FALSE FALSE)
-- He did not know and had no reason to know: no.
#ASSERT NOT (`סעיף 354(ב1)(5) - בית משפט השלום רשאי להורות לנושא משרה להשיב לחברה את העיצום` `בעל מניה בחברה` TRUE `בדיקה ic6 - הפרה P1a` FALSE FALSE FALSE FALSE FALSE)
-- Each of the first three defences defeats it.
#ASSERT NOT (`סעיף 354(ב1)(5) - בית משפט השלום רשאי להורות לנושא משרה להשיב לחברה את העיצום` `בעל מניה בחברה` TRUE `בדיקה ic6 - הפרה P1a` TRUE TRUE FALSE FALSE FALSE)
#ASSERT NOT (`סעיף 354(ב1)(5) - בית משפט השלום רשאי להורות לנושא משרה להשיב לחברה את העיצום` `בעל מניה בחברה` TRUE `בדיקה ic6 - הפרה P1a` TRUE FALSE TRUE FALSE FALSE)
#ASSERT NOT (`סעיף 354(ב1)(5) - בית משפט השלום רשאי להורות לנושא משרה להשיב לחברה את העיצום` `בעל מניה בחברה` TRUE `בדיקה ic6 - הפרה P1a` TRUE FALSE FALSE TRUE FALSE)
-- Defence (ד) (the company acted under the other provisions) defeats it for (1)(א), (2)(א) and (2)(ב) only.
#ASSERT NOT (`סעיף 354(ב1)(5) - בית משפט השלום רשאי להורות לנושא משרה להשיב לחברה את העיצום` `בעל מניה בחברה` TRUE `בדיקה ic6 - הפרה P1a` TRUE FALSE FALSE FALSE TRUE)
#ASSERT NOT (`סעיף 354(ב1)(5) - בית משפט השלום רשאי להורות לנושא משרה להשיב לחברה את העיצום` `בעל מניה בחברה` TRUE `בדיקה ic6 - הפרה Q2a` TRUE FALSE FALSE FALSE TRUE)
#ASSERT NOT (`סעיף 354(ב1)(5) - בית משפט השלום רשאי להורות לנושא משרה להשיב לחברה את העיצום` `בעל מניה בחברה` TRUE `בדיקה ic6 - הפרה Q2b` TRUE FALSE FALSE FALSE TRUE)
#ASSERT `סעיף 354(ב1)(5) - בית משפט השלום רשאי להורות לנושא משרה להשיב לחברה את העיצום` `בעל מניה בחברה` TRUE `בדיקה ic6 - הפרה P1e` TRUE FALSE FALSE FALSE TRUE
#ASSERT `סעיף 354(ב1)(5) - בית משפט השלום רשאי להורות לנושא משרה להשיב לחברה את העיצום` `בעל מניה בחברה` TRUE `בדיקה ic6 - הפרה N3` TRUE FALSE FALSE FALSE TRUE

-- (ג): a repeat. The first sanction was imposed on 1 January 2026; the same provision again by 1 January 2028 (two years, the last day inside): yes; a day later: no.
#ASSERT `סעיף 354(ג) - הרשם רשאי להטיל על החברה כפל העיצום הקודם` `העיצום הכספי` (YMD 2026 1 1) (YMD 2028 1 1) TRUE 1 TRUE
#ASSERT NOT (`סעיף 354(ג) - הרשם רשאי להטיל על החברה כפל העיצום הקודם` `העיצום הכספי` (YMD 2026 1 1) (YMD 2028 1 2) TRUE 1 TRUE)
-- Three or more violations in the period, even of different provisions: yes.
#ASSERT `סעיף 354(ג) - הרשם רשאי להטיל על החברה כפל העיצום הקודם` `העיצום הכספי` (YMD 2026 1 1) (YMD 2027 6 1) FALSE 3 TRUE
#ASSERT NOT (`סעיף 354(ג) - הרשם רשאי להטיל על החברה כפל העיצום הקודם` `העיצום הכספי` (YMD 2026 1 1) (YMD 2027 6 1) FALSE 2 TRUE)
-- Without the Registrar's reasonable basis, or with no earlier sanction under section 354: no.
#ASSERT NOT (`סעיף 354(ג) - הרשם רשאי להטיל על החברה כפל העיצום הקודם` `העיצום הכספי` (YMD 2026 1 1) (YMD 2027 1 1) TRUE 1 FALSE)
#ASSERT NOT (`סעיף 354(ג) - הרשם רשאי להטיל על החברה כפל העיצום הקודם` `אין סמכות להטיל עיצום כספי לפי סעיף 354` (YMD 2026 1 1) (YMD 2027 1 1) TRUE 1 TRUE)
-- The amount of the repeat: twice the base for an earlier base sanction, four times the base for an earlier double sanction (fork F-ic6-11).
#ASSERT `סעיף 354(ג) - סכום העיצום החוזר` `העיצום הכספי` 6_000 EQUALS JUST 12_000
#ASSERT `סעיף 354(ג) - סכום העיצום החוזר` `כפל העיצום הכספי` 6_000 EQUALS JUST 24_000
#ASSERT `סעיף 354(ג) - סכום העיצום החוזר` `אין סמכות להטיל עיצום כספי לפי סעיף 354` 6_000 EQUALS NOTHING

§§ `סעיף 355: עדכון עיצום כספי`

-- (א): the day for the updated amount: the day of the demand, or the day of the decision on the appeal if an appeal was filed and the court did not order payment.
#ASSERT `סעיף 355(א) - היום שלפיו נקבע הסכום המעודכן של העיצום` (YMD 2026 6 1) FALSE FALSE NOTHING EQUALS YMD 2026 6 1
#ASSERT `סעיף 355(א) - היום שלפיו נקבע הסכום המעודכן של העיצום` (YMD 2026 6 1) TRUE FALSE (JUST (YMD 2026 12 1)) EQUALS YMD 2026 12 1
#ASSERT `סעיף 355(א) - היום שלפיו נקבע הסכום המעודכן של העיצום` (YMD 2026 6 1) TRUE TRUE (JUST (YMD 2026 12 1)) EQUALS YMD 2026 6 1
#ASSERT `סעיף 355(א) - היום שלפיו נקבע הסכום המעודכן של העיצום` (YMD 2026 6 1) TRUE FALSE NOTHING EQUALS YMD 2026 6 1
-- (ב): 6,000 times 110 over 100 is 6,600.
#ASSERT `סעיף 355(ב) - סכום העיצום המעודכן` 6_000 110 100 FALSE EQUALS JUST 6_600
-- 6,000 times 105.3 over 100 is 6,318; rounded to the nearest ten, 6,320. 6,000 times 105.2 over 100 is 6,312; rounded, 6,310.
#ASSERT `סעיף 355(ב) - סכום העיצום המעודכן` 6_000 105.3 100 FALSE EQUALS JUST 6_318
#ASSERT `סעיף 355(ב) - סכום העיצום המעודכן` 6_000 105.3 100 TRUE EQUALS JUST 6_320
#ASSERT `סעיף 355(ב) - סכום העיצום המעודכן` 6_000 105.2 100 TRUE EQUALS JUST 6_310
-- A half goes up: 1,000 times 100.5 over 100 is 1,005; rounded, 1,010.
#ASSERT `סעיף 355(ב) - סכום העיצום המעודכן` 1_000 100.5 100 TRUE EQUALS JUST 1_010
-- An index of zero before the Law began leaves nothing to compute: NOTHING.
#ASSERT `סעיף 355(ב) - סכום העיצום המעודכן` 6_000 110 0 FALSE EQUALS NOTHING
#ASSERT `סעיף 355(ג) - הסכום המעודכן פורסם ברשומות` TRUE
#ASSERT NOT (`סעיף 355(ג) - הסכום המעודכן פורסם ברשומות` FALSE)

