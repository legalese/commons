IMPORT prelude
IMPORT `ic-core`
IMPORT `ic4-nouns`
IMPORT `ic4-part9-changing-types`

-- ic4-tests-part9-changing-types: tests of ic4-part9-changing-types.l4 (sections 343 to 345).
-- Every expected value is decided from the text of the section (Hebrew, src:2500-2514) before the run, and written beside the assertion.
-- Boundary values are tested on each side of every figure the text states: fourteen days, 21 days, three quarters of the voters.

§ `בדיקות: חלק 9 פרק 1, שינוי סוגי תאגידים`

§§ `סעיף 343`

-- A private company: shares not listed, not offered to the public by prospectus, bonds none, not a reporting corporation.
`חברה פרטית לפני השינוי` MEANS `עובדות על חברה לפי מצב מניותיה ואיגרות החוב שלה` FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE
-- The same company after its shares were listed and are held by the public: a public company, not yet a reporting corporation.
`חברה ציבורית אחרי השינוי` MEANS `עובדות על חברה לפי מצב מניותיה ואיגרות החוב שלה` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE
-- A public company that is a reporting corporation.
`חברה ציבורית ומדווחת` MEANS `עובדות על חברה לפי מצב מניותיה ואיגרות החוב שלה` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE TRUE
-- A private company with bonds listed and held by the public: a bond company.
`חברה פרטית שהיא חברת איגרות חוב` MEANS `עובדות על חברה לפי מצב מניותיה ואיגרות החוב שלה` FALSE FALSE FALSE TRUE TRUE FALSE FALSE TRUE FALSE

-- Private to public: the one change.
#ASSERT elem `חברה פרטית שהפכה לחברה ציבורית` (`סעיף 343(א) - השינויים שחלו בסוג החברה` `חברה פרטית לפני השינוי` `חברה ציבורית אחרי השינוי`)
#ASSERT count (`סעיף 343(א) - השינויים שחלו בסוג החברה` `חברה פרטית לפני השינוי` `חברה ציבורית אחרי השינוי`) EQUALS 1
-- Private to public and reporting: two changes at once.
#ASSERT elem `חברה פרטית שהפכה לחברה ציבורית` (`סעיף 343(א) - השינויים שחלו בסוג החברה` `חברה פרטית לפני השינוי` `חברה ציבורית ומדווחת`)
#ASSERT elem `חברה שהפכה לתאגיד מדווח` (`סעיף 343(א) - השינויים שחלו בסוג החברה` `חברה פרטית לפני השינוי` `חברה ציבורית ומדווחת`)
#ASSERT count (`סעיף 343(א) - השינויים שחלו בסוג החברה` `חברה פרטית לפני השינוי` `חברה ציבורית ומדווחת`) EQUALS 2
-- Public and reporting to private: two changes the other way.
#ASSERT elem `חברה ציבורית שהפכה לחברה פרטית` (`סעיף 343(א) - השינויים שחלו בסוג החברה` `חברה ציבורית ומדווחת` `חברה פרטית לפני השינוי`)
#ASSERT elem `חברה שחדלה להיות תאגיד מדווח` (`סעיף 343(א) - השינויים שחלו בסוג החברה` `חברה ציבורית ומדווחת` `חברה פרטית לפני השינוי`)
#ASSERT count (`סעיף 343(א) - השינויים שחלו בסוג החברה` `חברה ציבורית ומדווחת` `חברה פרטית לפני השינוי`) EQUALS 2
-- Becoming a bond company and ceasing to be one.
#ASSERT elem `חברה שהפכה לחברת איגרות חוב` (`סעיף 343(א) - השינויים שחלו בסוג החברה` `חברה פרטית לפני השינוי` `חברה פרטית שהיא חברת איגרות חוב`)
#ASSERT count (`סעיף 343(א) - השינויים שחלו בסוג החברה` `חברה פרטית לפני השינוי` `חברה פרטית שהיא חברת איגרות חוב`) EQUALS 1
#ASSERT elem `חברה שחדלה להיות חברת איגרות חוב` (`סעיף 343(א) - השינויים שחלו בסוג החברה` `חברה פרטית שהיא חברת איגרות חוב` `חברה פרטית לפני השינוי`)
-- No change.
#ASSERT null (`סעיף 343(א) - השינויים שחלו בסוג החברה` `חברה פרטית לפני השינוי` `חברה פרטית לפני השינוי`)
#ASSERT null (`סעיף 343(א) - השינויים שחלו בסוג החברה` `חברה ציבורית ומדווחת` `חברה ציבורית ומדווחת`)
-- A company whose shares are listed but not held by the public stays private (keel fork F1): going from private to that is no change.
#ASSERT null (`סעיף 343(א) - השינויים שחלו בסוג החברה` `חברה פרטית לפני השינוי` (`עובדות על חברה לפי מצב מניותיה ואיגרות החוב שלה` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE))
-- The duty to tell the Registrar within fourteen days of the change: day 14 inside, day 15 outside.
#ASSERT `סעיף 343(א) - הודעה לרשם על שינוי בסוג החברה בתוך ארבעה עשר ימים` `חברה פרטית שהפכה לחברה ציבורית` TRUE 14 EQUALS `קויימה בתוך המועד`
#ASSERT `סעיף 343(א) - הודעה לרשם על שינוי בסוג החברה בתוך ארבעה עשר ימים` `חברה פרטית שהפכה לחברה ציבורית` TRUE 15 EQUALS `קויימה באיחור`
#ASSERT `סעיף 343(א) - הודעה לרשם על שינוי בסוג החברה בתוך ארבעה עשר ימים` `חברה ציבורית שהפכה לחברה פרטית` FALSE 14 EQUALS `טרם קויימה והמועד עדיין לא חלף`
#ASSERT `סעיף 343(א) - הודעה לרשם על שינוי בסוג החברה בתוך ארבעה עשר ימים` `חברה שחדלה להיות תאגיד מדווח` FALSE 15 EQUALS `טרם קויימה והמועד חלף`
#ASSERT `סעיף 343(א) - הודעה לרשם על שינוי בסוג החברה בתוך ארבעה עשר ימים` `חברה שהפכה לחברת איגרות חוב` TRUE 3 EQUALS `קויימה בתוך המועד`
-- No change: nothing to tell.
#ASSERT `סעיף 343(א) - הודעה לרשם על שינוי בסוג החברה בתוך ארבעה עשר ימים` `אין שינוי בסוג החברה` FALSE 40 EQUALS `החובה אינה חלה`

§§ `סעיף 344`

-- (א): unlimited liability, the court approved the amendment of the articles: the company may determine that the liability is limited.
#ASSERT `סעיף 344(א) - החברה רשאית לשנות את תקנונה ולקבוע שאחריות בעלי המניות מוגבלת` TRUE TRUE
#ASSERT NOT (`סעיף 344(א) - החברה רשאית לשנות את תקנונה ולקבוע שאחריות בעלי המניות מוגבלת` TRUE FALSE)
#ASSERT NOT (`סעיף 344(א) - החברה רשאית לשנות את תקנונה ולקבוע שאחריות בעלי המניות מוגבלת` FALSE TRUE)
-- (ב): limited liability made unlimited only with the consent of all the shareholders.
#ASSERT `סעיף 344(ב) - החברה רשאית לשנות את תקנונה ולקבוע שאחריות בעלי המניות אינה מוגבלת` TRUE TRUE
#ASSERT NOT (`סעיף 344(ב) - החברה רשאית לשנות את תקנונה ולקבוע שאחריות בעלי המניות אינה מוגבלת` TRUE FALSE)
#ASSERT NOT (`סעיף 344(ב) - החברה רשאית לשנות את תקנונה ולקבוע שאחריות בעלי המניות אינה מוגבלת` FALSE TRUE)

§§ `סעיף 345`

#ASSERT `סעיף 345(א) - חובת האגודה להכין תכנית ולהגישה לרשם האגודות השיתופיות` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 345(א) - חובת האגודה להכין תכנית ולהגישה לרשם האגודות השיתופיות` TRUE TRUE EQUALS `החובה חלה וקויימה`
#ASSERT `סעיף 345(א) - חובת האגודה להכין תכנית ולהגישה לרשם האגודות השיתופיות` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`
-- (ג): the Registrar of Cooperative Societies approved; 21 days' notice setting out the plan; three quarters of those who voted.
#ASSERT `סעיף 345(ג) - תכנית ההפיכה לחברה אושרה באסיפה הכללית של האגודה` TRUE 21 TRUE 100 75
-- 74 of 100: short of three quarters.
#ASSERT NOT (`סעיף 345(ג) - תכנית ההפיכה לחברה אושרה באסיפה הכללית של האגודה` TRUE 21 TRUE 100 74)
-- 20 days' notice: short of 21.
#ASSERT NOT (`סעיף 345(ג) - תכנית ההפיכה לחברה אושרה באסיפה הכללית של האגודה` TRUE 20 TRUE 100 90)
-- The notice did not set the plan out; the Registrar did not approve; nobody voted.
#ASSERT NOT (`סעיף 345(ג) - תכנית ההפיכה לחברה אושרה באסיפה הכללית של האגודה` TRUE 21 FALSE 100 90)
#ASSERT NOT (`סעיף 345(ג) - תכנית ההפיכה לחברה אושרה באסיפה הכללית של האגודה` FALSE 21 TRUE 100 90)
#ASSERT NOT (`סעיף 345(ג) - תכנית ההפיכה לחברה אושרה באסיפה הכללית של האגודה` TRUE 21 TRUE 0 0)
-- Three of four voters is three quarters.
#ASSERT `סעיף 345(ג) - תכנית ההפיכה לחברה אושרה באסיפה הכללית של האגודה` TRUE 30 TRUE 4 3
#ASSERT `סעיף 345(ג) - חובת האגודה לערוך תקנון, למסור עותק ממנו לרשם החברות ולשלם אגרות` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 345(ג) - חובת האגודה לערוך תקנון, למסור עותק ממנו לרשם החברות ולשלם אגרות` TRUE TRUE EQUALS `החובה חלה וקויימה`
#ASSERT `סעיף 345(ג) - חובת האגודה לערוך תקנון, למסור עותק ממנו לרשם החברות ולשלם אגרות` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`
-- (ד): the Registrars' three duties in order.
#ASSERT `סעיף 345(ד) - חובת רשם החברות להודיע לרשם האגודות השיתופיות על אישור הרישום` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 345(ד) - חובת רשם האגודות השיתופיות לבטל את רישום האגודה ולפרסם ברשומות` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 345(ד) - חובת רשם האגודות השיתופיות לבטל את רישום האגודה ולפרסם ברשומות` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`
#ASSERT `סעיף 345(ד) - חובת רשם החברות לרשום את האגודה כחברה לאחר הביטול` TRUE TRUE EQUALS `החובה חלה וקויימה`
-- (ה): the pledges register extract, then registration without fee.
#ASSERT `סעיף 345(ה) - חובת רשם האגודות השיתופיות להעביר לרשם החברות נסח של השעבודים` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 345(ה) - חובת רשם החברות לרשום את השעבודים בלא אגרה` TRUE TRUE EQUALS `החובה חלה וקויימה`
-- (ו): on registration the assets and liabilities pass and the proceedings continue with the company as party.
#ASSERT (`סעיף 345(ו) - תוצאות רישום האגודה כחברה` TRUE)'s `כלל הנכסים והחיובים של האגודה, לרבות חיובים ידועים ובלתי ידועים, קיימים ומותנים, עוברים לחברה`
#ASSERT (`סעיף 345(ו) - תוצאות רישום האגודה כחברה` TRUE)'s `ניתן להמשיך בהליכים המשפטיים שהאגודה צד להם כך שהחברה תהיה הצד להם`
#ASSERT NOT ((`סעיף 345(ו) - תוצאות רישום האגודה כחברה` FALSE)'s `כלל הנכסים והחיובים של האגודה, לרבות חיובים ידועים ובלתי ידועים, קיימים ומותנים, עוברים לחברה`)
