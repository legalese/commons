IMPORT prelude
IMPORT `ic-core`
IMPORT `ic3-part6-ch4-director-rights`

-- ic3-tests-part6-ch4: tests of ic3-part6-ch4-director-rights.l4 (sections 265 to 267), src:1779-1792.
-- Every expected value is written from the text before the code was run, never copied from the code's output.

§ `בדיקות: חלק 6 פרק 4`

§§ `סעיף 265`

-- (א): a director may inspect as far as his duties need it; a person who is not a director has no such right under this section.
#ASSERT `סעיף 265(א) - לדירקטור הזכות לבדוק מסמכים, רישומים ונכסים של החברה ולקבל העתקים` TRUE TRUE
#ASSERT NOT (`סעיף 265(א) - לדירקטור הזכות לבדוק מסמכים, רישומים ונכסים של החברה ולקבל העתקים` TRUE FALSE)
#ASSERT NOT (`סעיף 265(א) - לדירקטור הזכות לבדוק מסמכים, רישומים ונכסים של החברה ולקבל העתקים` FALSE TRUE)
-- (ב): the company may prevent him if the board held he acts in bad faith or that inspection may harm the company.
#ASSERT `סעיף 265(ב) - החברה רשאית למנוע מדירקטור לבדוק מסמך או נכס` TRUE FALSE
#ASSERT `סעיף 265(ב) - החברה רשאית למנוע מדירקטור לבדוק מסמך או נכס` FALSE TRUE
#ASSERT NOT (`סעיף 265(ב) - החברה רשאית למנוע מדירקטור לבדוק מסמך או נכס` FALSE FALSE)
-- Together: the right stands unless the company may prevent it.
#ASSERT `סעיף 265 - הדירקטור רשאי לדרוש לבדוק, והחברה אינה רשאית למנוע זאת` TRUE TRUE FALSE FALSE
#ASSERT NOT (`סעיף 265 - הדירקטור רשאי לדרוש לבדוק, והחברה אינה רשאית למנוע זאת` TRUE TRUE TRUE FALSE)
#ASSERT NOT (`סעיף 265 - הדירקטור רשאי לדרוש לבדוק, והחברה אינה רשאית למנוע זאת` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`סעיף 265 - הדירקטור רשאי לדרוש לבדוק, והחברה אינה רשאית למנוע זאת` TRUE FALSE FALSE FALSE)
-- (ג): the court may extend the right to an affiliated company at an external director's request.
#ASSERT `סעיף 265(ג) - בית המשפט רשאי לקבוע כי הזכות חלה גם לגבי חברה קשורה` TRUE TRUE TRUE
#ASSERT NOT (`סעיף 265(ג) - בית המשפט רשאי לקבוע כי הזכות חלה גם לגבי חברה קשורה` FALSE TRUE TRUE)
#ASSERT NOT (`סעיף 265(ג) - בית המשפט רשאי לקבוע כי הזכות חלה גם לגבי חברה קשורה` TRUE FALSE TRUE)
#ASSERT NOT (`סעיף 265(ג) - בית המשפט רשאי לקבוע כי הזכות חלה גם לגבי חברה קשורה` TRUE TRUE FALSE)

§§ `סעיף 266`

-- (א): entitled in special cases, to advice for his function, if the board or the court approved the expense.
#ASSERT `סעיף 266(א) - הדירקטור זכאי לקבל ייעוץ מקצועי על חשבון החברה` TRUE TRUE TRUE FALSE
#ASSERT `סעיף 266(א) - הדירקטור זכאי לקבל ייעוץ מקצועי על חשבון החברה` TRUE TRUE FALSE TRUE
#ASSERT NOT (`סעיף 266(א) - הדירקטור זכאי לקבל ייעוץ מקצועי על חשבון החברה` TRUE TRUE FALSE FALSE)
#ASSERT NOT (`סעיף 266(א) - הדירקטור זכאי לקבל ייעוץ מקצועי על חשבון החברה` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`סעיף 266(א) - הדירקטור זכאי לקבל ייעוץ מקצועי על חשבון החברה` FALSE TRUE TRUE TRUE)
-- (ב): the two considerations the court weighs.
#ASSERT `סעיף 266(ב) - שני השיקולים שבית המשפט שוקל מצביעים על אישור הבקשה` TRUE TRUE
#ASSERT NOT (`סעיף 266(ב) - שני השיקולים שבית המשפט שוקל מצביעים על אישור הבקשה` TRUE FALSE)
#ASSERT NOT (`סעיף 266(ב) - שני השיקולים שבית המשפט שוקל מצביעים על אישור הבקשה` FALSE TRUE)

§§ `סעיף 267`

-- (א): a director with a reasonable basis may apply to the court, after acting under section 257 if the circumstances allow.
#ASSERT `סעיף 267(א) - הדירקטור רשאי לפנות לבית המשפט בבקשה לאכוף את החובה או למנוע את הפעולה` TRUE TRUE TRUE TRUE
-- He did not act under 257 although the circumstances allowed: not yet.
#ASSERT NOT (`סעיף 267(א) - הדירקטור רשאי לפנות לבית המשפט בבקשה לאכוף את החובה או למנוע את הפעולה` TRUE TRUE TRUE FALSE)
-- The circumstances did not allow acting under 257 first: he may apply at once.
#ASSERT `סעיף 267(א) - הדירקטור רשאי לפנות לבית המשפט בבקשה לאכוף את החובה או למנוע את הפעולה` TRUE TRUE FALSE FALSE
-- No reasonable basis: no.
#ASSERT NOT (`סעיף 267(א) - הדירקטור רשאי לפנות לבית המשפט בבקשה לאכוף את החובה או למנוע את הפעולה` TRUE FALSE FALSE FALSE)
-- Not a director: no.
#ASSERT NOT (`סעיף 267(א) - הדירקטור רשאי לפנות לבית המשפט בבקשה לאכוף את החובה או למנוע את הפעולה` FALSE TRUE FALSE FALSE)
-- (ב): the company bears the expenses unless the court determined otherwise.
#ASSERT `סעיף 267(ב) - החברה נושאת בהוצאות הדירקטור` TRUE FALSE
#ASSERT NOT (`סעיף 267(ב) - החברה נושאת בהוצאות הדירקטור` TRUE TRUE)
#ASSERT NOT (`סעיף 267(ב) - החברה נושאת בהוצאות הדירקטור` FALSE FALSE)
