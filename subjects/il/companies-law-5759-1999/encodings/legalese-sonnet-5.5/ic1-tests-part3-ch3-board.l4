IMPORT prelude
IMPORT `ic-core`
IMPORT `ic-core-company-kinds`
IMPORT `ic1-majorities`
IMPORT `ic1-part3-ch3-board`

-- Tests of ic1-part3-ch3-board.l4 (sections 92 to 109).

§ `בדיקות: חלק 3 פרק 3 סימנים א׳ עד ז׳ – הדירקטוריון`

§§ `מתקנים`

-- A private company that is not a bond company.
`בדיקות דירקטוריון - חברה פרטית` MEANS `עובדות על חברה` WITH
    `הדין שלפיו התאגדה` IS `לפי חוק זה`
    `מניותיה רשומות למסחר בבורסה` IS FALSE
    `מניותיה הוצעו לציבור על פי תשקיף` IS FALSE
    `מניותיה הוצעו לציבור מחוץ לישראל על פי מסמך הצעה לציבור` IS FALSE
    `מניותיה מוחזקות בידי הציבור` IS FALSE
    `איגרות החוב שלה רשומות למסחר בבורסה` IS FALSE
    `איגרות החוב שלה הוצעו לציבור על פי תשקיף` IS FALSE
    `איגרות החוב שלה הוצעו לציבור מחוץ לישראל על פי מסמך הצעה לציבור` IS FALSE
    `איגרות החוב שלה מוחזקות בידי הציבור` IS FALSE
    `חברה לתועלת הציבור` IS FALSE
    `חברה ממשלתית` IS FALSE
    `תאגיד מדווח` IS FALSE

-- A public company.
`בדיקות דירקטוריון - חברה ציבורית` MEANS `עובדות על חברה` WITH
    `הדין שלפיו התאגדה` IS `לפי חוק זה`
    `מניותיה רשומות למסחר בבורסה` IS TRUE
    `מניותיה הוצעו לציבור על פי תשקיף` IS FALSE
    `מניותיה הוצעו לציבור מחוץ לישראל על פי מסמך הצעה לציבור` IS FALSE
    `מניותיה מוחזקות בידי הציבור` IS TRUE
    `איגרות החוב שלה רשומות למסחר בבורסה` IS FALSE
    `איגרות החוב שלה הוצעו לציבור על פי תשקיף` IS FALSE
    `איגרות החוב שלה הוצעו לציבור מחוץ לישראל על פי מסמך הצעה לציבור` IS FALSE
    `איגרות החוב שלה מוחזקות בידי הציבור` IS FALSE
    `חברה לתועלת הציבור` IS FALSE
    `חברה ממשלתית` IS FALSE
    `תאגיד מדווח` IS FALSE

-- A private company whose bonds are registered for trading on a bourse and held by the public: a bond company, not a public company.
`בדיקות דירקטוריון - חברת איגרות חוב פרטית` MEANS `עובדות על חברה` WITH
    `הדין שלפיו התאגדה` IS `לפי חוק זה`
    `מניותיה רשומות למסחר בבורסה` IS FALSE
    `מניותיה הוצעו לציבור על פי תשקיף` IS FALSE
    `מניותיה הוצעו לציבור מחוץ לישראל על פי מסמך הצעה לציבור` IS FALSE
    `מניותיה מוחזקות בידי הציבור` IS FALSE
    `איגרות החוב שלה רשומות למסחר בבורסה` IS TRUE
    `איגרות החוב שלה הוצעו לציבור על פי תשקיף` IS FALSE
    `איגרות החוב שלה הוצעו לציבור מחוץ לישראל על פי מסמך הצעה לציבור` IS FALSE
    `איגרות החוב שלה מוחזקות בידי הציבור` IS TRUE
    `חברה לתועלת הציבור` IS FALSE
    `חברה ממשלתית` IS FALSE
    `תאגיד מדווח` IS FALSE

GIVEN b IS A NUMBER
      a IS A NUMBER
      m IS A NUMBER
GIVETH A `הצבעה`
`בדיקות דירקטוריון - הצבעה` MEANS `הצבעה` WITH `קולות בעד` IS b, `קולות נגד` IS a, `קולות נמנעים` IS m

§§ `ההגדרה המשותפת`

#ASSERT `חברה ציבורית או חברה פרטית שהיא חברת איגרות חוב` `בדיקות דירקטוריון - חברה ציבורית` EQUALS TRUE
#ASSERT `חברה ציבורית או חברה פרטית שהיא חברת איגרות חוב` `בדיקות דירקטוריון - חברת איגרות חוב פרטית` EQUALS TRUE
#ASSERT `חברה ציבורית או חברה פרטית שהיא חברת איגרות חוב` `בדיקות דירקטוריון - חברה פרטית` EQUALS FALSE

§§ `סימן א׳ – סמכויות הדירקטוריון`

#ASSERT `סעיף 92(א) - התפקיד או הסמכות הם של הדירקטוריון לפי סעיף 92(א)` `קביעת תכניות הפעולה, עקרונות המימון וסדרי העדיפויות` EQUALS TRUE
#ASSERT `סעיף 92(א) - התפקיד או הסמכות הם של הדירקטוריון לפי סעיף 92(א)` `בדיקת המצב הכספי וקביעת מסגרת האשראי` EQUALS TRUE
#ASSERT `סעיף 92(א) - התפקיד או הסמכות הם של הדירקטוריון לפי סעיף 92(א)` `קביעת המבנה הארגוני ומדיניות השכר והתגמול` EQUALS TRUE
#ASSERT `סעיף 92(א) - התפקיד או הסמכות הם של הדירקטוריון לפי סעיף 92(א)` `החלטה על הנפקה של סדרת איגרות חוב` EQUALS TRUE
#ASSERT `סעיף 92(א) - התפקיד או הסמכות הם של הדירקטוריון לפי סעיף 92(א)` `עריכת הדוחות הכספיים ואישורם` EQUALS TRUE
#ASSERT `סעיף 92(א) - התפקיד או הסמכות הם של הדירקטוריון לפי סעיף 92(א)` `דיווח לאסיפה השנתית על מצב ענייני החברה ותוצאותיה העסקיות` EQUALS TRUE
#ASSERT `סעיף 92(א) - התפקיד או הסמכות הם של הדירקטוריון לפי סעיף 92(א)` `מינוי המנהל הכללי ופיטוריו` EQUALS TRUE
#ASSERT `סעיף 92(א) - התפקיד או הסמכות הם של הדירקטוריון לפי סעיף 92(א)` `החלטה בפעולות ובעסקאות הטעונות אישור הדירקטוריון` EQUALS TRUE
#ASSERT `סעיף 92(א) - התפקיד או הסמכות הם של הדירקטוריון לפי סעיף 92(א)` `הקצאת מניות וניירות ערך המירים עד גבול ההון הרשום` EQUALS TRUE
#ASSERT `סעיף 92(א) - התפקיד או הסמכות הם של הדירקטוריון לפי סעיף 92(א)` `החלטה על חלוקה` EQUALS TRUE
#ASSERT `סעיף 92(א) - התפקיד או הסמכות הם של הדירקטוריון לפי סעיף 92(א)` `חוות דעת על הצעת רכש מיוחדת` EQUALS TRUE
#ASSERT `סעיף 92(א) - התפקיד או הסמכות הם של הדירקטוריון לפי סעיף 92(א)` `קביעת המספר המזערי של דירקטורים בעלי מומחיות חשבונאית ופיננסית` EQUALS TRUE
#ASSERT `סעיף 92(א) - התפקיד או הסמכות הם של הדירקטוריון לפי סעיף 92(א)` `תפקיד אחר שאינו מנוי בסעיף 92(א)` EQUALS FALSE
#ASSERT `סעיף 92(א)(12) - על הדירקטוריון לקבוע מספר מזערי של דירקטורים בעלי מומחיות חשבונאית ופיננסית` `בדיקות דירקטוריון - חברה ציבורית` EQUALS TRUE
#ASSERT `סעיף 92(א)(12) - על הדירקטוריון לקבוע מספר מזערי של דירקטורים בעלי מומחיות חשבונאית ופיננסית` `בדיקות דירקטוריון - חברת איגרות חוב פרטית` EQUALS TRUE
#ASSERT `סעיף 92(א)(12) - על הדירקטוריון לקבוע מספר מזערי של דירקטורים בעלי מומחיות חשבונאית ופיננסית` `בדיקות דירקטוריון - חברה פרטית` EQUALS FALSE
-- The minimum may not exceed the number of directors fixed in the articles.
#ASSERT `סעיף 92(א)(12) - המספר המזערי שקבע הדירקטוריון עומד במספר הדירקטורים שבתקנון` 2 7 EQUALS TRUE
#ASSERT `סעיף 92(א)(12) - המספר המזערי שקבע הדירקטוריון עומד במספר הדירקטורים שבתקנון` 7 7 EQUALS TRUE
#ASSERT `סעיף 92(א)(12) - המספר המזערי שקבע הדירקטוריון עומד במספר הדירקטורים שבתקנון` 8 7 EQUALS FALSE
-- 92(b). Arguments: the power is one of the board's under section 92; the delegation is as section 288(b)(2) states.
#ASSERT `סעיף 92(ב) - סמכות של הדירקטוריון לפי סעיף 92 ניתנת לאצילה למנהל הכללי` TRUE FALSE EQUALS FALSE
#ASSERT `סעיף 92(ב) - סמכות של הדירקטוריון לפי סעיף 92 ניתנת לאצילה למנהל הכללי` TRUE TRUE EQUALS TRUE
#ASSERT `סעיף 92(ב) - סמכות של הדירקטוריון לפי סעיף 92 ניתנת לאצילה למנהל הכללי` FALSE FALSE EQUALS TRUE
#ASSERT `סעיף 93(א) - בחברה פרטית שאינה חברת איגרות חוב יכול שיהיה דירקטוריון המונה אדם אחד` `בדיקות דירקטוריון - חברה פרטית` EQUALS TRUE
#ASSERT `סעיף 93(א) - בחברה פרטית שאינה חברת איגרות חוב יכול שיהיה דירקטוריון המונה אדם אחד` `בדיקות דירקטוריון - חברת איגרות חוב פרטית` EQUALS FALSE
#ASSERT `סעיף 93(א) - בחברה פרטית שאינה חברת איגרות חוב יכול שיהיה דירקטוריון המונה אדם אחד` `בדיקות דירקטוריון - חברה ציבורית` EQUALS FALSE
#ASSERT `סעיף 93(ב) - ההוראות חלות על דירקטוריון המונה אדם אחד` `סימן א׳ – סמכויות הדירקטוריון` EQUALS TRUE
#ASSERT `סעיף 93(ב) - ההוראות חלות על דירקטוריון המונה אדם אחד` `סימן ו׳ – פרוטוקולים בישיבות הדירקטוריון` EQUALS TRUE
#ASSERT `סעיף 93(ב) - ההוראות חלות על דירקטוריון המונה אדם אחד` `יתר הוראות הפרק` EQUALS FALSE

§§ `סימן ב׳ – יושב ראש הדירקטוריון`

-- 94(a). Arguments: company; the articles fix another manner of appointment.
#ASSERT `סעיף 94(א) - הדירקטוריון יבחר אחד מחבריו לכהן כיושב ראש` `בדיקות דירקטוריון - חברה ציבורית` FALSE EQUALS TRUE
#ASSERT `סעיף 94(א) - הדירקטוריון יבחר אחד מחבריו לכהן כיושב ראש` `בדיקות דירקטוריון - חברת איגרות חוב פרטית` FALSE EQUALS TRUE
#ASSERT `סעיף 94(א) - הדירקטוריון יבחר אחד מחבריו לכהן כיושב ראש` `בדיקות דירקטוריון - חברה ציבורית` TRUE EQUALS FALSE
#ASSERT `סעיף 94(א) - הדירקטוריון יבחר אחד מחבריו לכהן כיושב ראש` `בדיקות דירקטוריון - חברה פרטית` FALSE EQUALS FALSE
#ASSERT `סעיף 94(ב) - אין חובה למנות יושב ראש דירקטוריון` `בדיקות דירקטוריון - חברה פרטית` EQUALS TRUE
#ASSERT `סעיף 94(ב) - אין חובה למנות יושב ראש דירקטוריון` `בדיקות דירקטוריון - חברה ציבורית` EQUALS FALSE
-- 94(b), second limb. Arguments: company; a chair was appointed; the articles provide otherwise.
#ASSERT `סעיף 94(ב) - כל דירקטור זכאי לכנס את הדירקטוריון ולקבוע את סדר יומו` `בדיקות דירקטוריון - חברה פרטית` FALSE FALSE EQUALS TRUE
#ASSERT `סעיף 94(ב) - כל דירקטור זכאי לכנס את הדירקטוריון ולקבוע את סדר יומו` `בדיקות דירקטוריון - חברה פרטית` TRUE FALSE EQUALS FALSE
#ASSERT `סעיף 94(ב) - כל דירקטור זכאי לכנס את הדירקטוריון ולקבוע את סדר יומו` `בדיקות דירקטוריון - חברה פרטית` FALSE TRUE EQUALS FALSE
#ASSERT `סעיף 94(ב) - כל דירקטור זכאי לכנס את הדירקטוריון ולקבוע את סדר יומו` `בדיקות דירקטוריון - חברת איגרות חוב פרטית` FALSE FALSE EQUALS FALSE
-- 95(a). Arguments: company; the candidate is the general manager or his relative; the service is allowed by section 121;
-- subordinate to the general manager; subordinate only as a director of a controlled corporation; months since the company became public (or a bond company).
#ASSERT `סעיף 95(א) - המועמד רשאי לכהן כיושב ראש הדירקטוריון` `בדיקות דירקטוריון - חברה ציבורית` TRUE FALSE FALSE FALSE 12 EQUALS FALSE
#ASSERT `סעיף 95(א) - המועמד רשאי לכהן כיושב ראש הדירקטוריון` `בדיקות דירקטוריון - חברה ציבורית` TRUE TRUE FALSE FALSE 12 EQUALS TRUE
#ASSERT `סעיף 95(א) - המועמד רשאי לכהן כיושב ראש הדירקטוריון` `בדיקות דירקטוריון - חברה ציבורית` FALSE FALSE FALSE FALSE 12 EQUALS TRUE
#ASSERT `סעיף 95(א) - המועמד רשאי לכהן כיושב ראש הדירקטוריון` `בדיקות דירקטוריון - חברה ציבורית` FALSE FALSE TRUE FALSE 12 EQUALS FALSE
#ASSERT `סעיף 95(א) - המועמד רשאי לכהן כיושב ראש הדירקטוריון` `בדיקות דירקטוריון - חברה ציבורית` FALSE FALSE TRUE TRUE 12 EQUALS TRUE
-- The first three months after the company became public are exempt; the fourth is not.
#ASSERT `סעיף 95(א) - המועמד רשאי לכהן כיושב ראש הדירקטוריון` `בדיקות דירקטוריון - חברה ציבורית` TRUE FALSE FALSE FALSE 3 EQUALS TRUE
#ASSERT `סעיף 95(א) - המועמד רשאי לכהן כיושב ראש הדירקטוריון` `בדיקות דירקטוריון - חברה ציבורית` TRUE FALSE FALSE FALSE 4 EQUALS FALSE
-- A private bond company is bound too (subsection (d)); a private company that is not a bond company is not.
#ASSERT `סעיף 95(א) - המועמד רשאי לכהן כיושב ראש הדירקטוריון` `בדיקות דירקטוריון - חברת איגרות חוב פרטית` TRUE FALSE FALSE FALSE 12 EQUALS FALSE
#ASSERT `סעיף 95(א) - המועמד רשאי לכהן כיושב ראש הדירקטוריון` `בדיקות דירקטוריון - חברה פרטית` TRUE FALSE TRUE FALSE 12 EQUALS TRUE
-- 95(b). Arguments: company; the vesting is of the general manager's powers in the chair or his relative; allowed by section 121.
#ASSERT `סעיף 95(ב) - ניתן להקנות ליושב ראש או לקרובו סמכויות של המנהל הכללי` `בדיקות דירקטוריון - חברה ציבורית` TRUE FALSE EQUALS FALSE
#ASSERT `סעיף 95(ב) - ניתן להקנות ליושב ראש או לקרובו סמכויות של המנהל הכללי` `בדיקות דירקטוריון - חברה ציבורית` TRUE TRUE EQUALS TRUE
#ASSERT `סעיף 95(ב) - ניתן להקנות ליושב ראש או לקרובו סמכויות של המנהל הכללי` `בדיקות דירקטוריון - חברה ציבורית` FALSE FALSE EQUALS TRUE
#ASSERT `סעיף 95(ב) - ניתן להקנות ליושב ראש או לקרובו סמכויות של המנהל הכללי` `בדיקות דירקטוריון - חברה פרטית` TRUE FALSE EQUALS TRUE
#ASSERT `סעיף 95(ב) - ניתן להקנות ליושב ראש סמכויות הנתונות למי שכפוף למנהל הכללי` `בדיקות דירקטוריון - חברה ציבורית` TRUE EQUALS FALSE
#ASSERT `סעיף 95(ב) - ניתן להקנות ליושב ראש סמכויות הנתונות למי שכפוף למנהל הכללי` `בדיקות דירקטוריון - חברה ציבורית` FALSE EQUALS TRUE
#ASSERT `סעיף 95(ב) - ניתן להקנות ליושב ראש סמכויות הנתונות למי שכפוף למנהל הכללי` `בדיקות דירקטוריון - חברה פרטית` TRUE EQUALS TRUE
-- Arguments: company; the other position is in the company or a controlled corporation; it is chair or director of a controlled corporation.
#ASSERT `סעיף 95(ב) - יושב ראש הדירקטוריון רשאי לכהן בתפקיד אחר` `בדיקות דירקטוריון - חברה ציבורית` TRUE FALSE EQUALS FALSE
#ASSERT `סעיף 95(ב) - יושב ראש הדירקטוריון רשאי לכהן בתפקיד אחר` `בדיקות דירקטוריון - חברה ציבורית` TRUE TRUE EQUALS TRUE
#ASSERT `סעיף 95(ב) - יושב ראש הדירקטוריון רשאי לכהן בתפקיד אחר` `בדיקות דירקטוריון - חברה ציבורית` FALSE FALSE EQUALS TRUE
#ASSERT `סעיף 95(ב) - יושב ראש הדירקטוריון רשאי לכהן בתפקיד אחר` `בדיקות דירקטוריון - חברה פרטית` TRUE FALSE EQUALS TRUE
#ASSERT `סעיף 96(א) - יושב ראש הדירקטוריון מנהל את הישיבה` TRUE EQUALS TRUE
#ASSERT `סעיף 96(א) - יושב ראש הדירקטוריון מנהל את הישיבה` FALSE EQUALS FALSE
