#ASSERT NOT (`האם ההקצאה בתמורה הנמוכה מהערך הנקוב מותרת באישור בית משפט` TRUE FALSE)
#ASSERT NOT (`האם ההקצאה בתמורה הנמוכה מהערך הנקוב מותרת באישור בית משפט` FALSE TRUE)
-- 306: a shareholder has the right to a dividend the company decided on; shares of different par values share in proportion to par value unless the articles say otherwise.
#ASSERT `האם יש לי זכות לקבל דיבידנד או מניות הטבה` TRUE TRUE
#ASSERT NOT (`האם יש לי זכות לקבל דיבידנד או מניות הטבה` TRUE FALSE)
#ASSERT NOT (`האם יש לי זכות לקבל דיבידנד או מניות הטבה` FALSE TRUE)
#ASSERT `חלקי בדיבידנד או במניות הטבה` TRUE FALSE 1000 200 1000 EQUALS JUST 200
#ASSERT `חלקי בדיבידנד או במניות הטבה` FALSE FALSE 1000 200 1000 EQUALS NOTHING
#ASSERT `חלקי בדיבידנד או במניות הטבה` TRUE TRUE 1000 200 1000 EQUALS NOTHING
-- 307: the board decides on a dividend unless the articles say otherwise; the meeting may accept or reduce the board's recommendation, not increase it; another way set in the articles needs the board to have had the opportunity to determine that it is not a forbidden distribution.
#ASSERT `מי מחליט על חלוקת דיבידנד` `התקנון לא קובע דרך אחרת` EQUALS JUST `הדירקטוריון`
#ASSERT `מי מחליט על חלוקת דיבידנד` `החלטה באסיפה הכללית לאחר המלצת הדירקטוריון` EQUALS JUST `האסיפה הכללית`
#ASSERT `מי מחליט על חלוקת דיבידנד` `החלטה בדירקטוריון לאחר שהאסיפה קבעה את סכום החלוקה המרבי` EQUALS JUST `הדירקטוריון`
#ASSERT `מי מחליט על חלוקת דיבידנד` `דרך אחרת שנקבעה בתקנון` EQUALS NOTHING
#ASSERT `האם האסיפה הכללית רשאית לאשר את הסכום` 100 100
#ASSERT `האם האסיפה הכללית רשאית לאשר את הסכום` 100 80
#ASSERT NOT (`האם האסיפה הכללית רשאית לאשר את הסכום` 100 120)
#ASSERT `האם הדרך האחרת שנקבעה בתקנון מותרת` TRUE
#ASSERT NOT (`האם הדרך האחרת שנקבעה בתקנון מותרת` FALSE)
-- 308: a share the company bought may be cancelled; if not cancelled it is dormant while the company owns it. Securities convertible into its shares it bought may be sold again, if not cancelled.
#ASSERT `האם החברה רשאית לבטל את המניה שרכשה` TRUE
#ASSERT NOT (`האם החברה רשאית לבטל את המניה שרכשה` FALSE)
#ASSERT `האם המניה היא מניה רדומה` TRUE FALSE TRUE
#ASSERT NOT (`האם המניה היא מניה רדומה` TRUE TRUE TRUE)
#ASSERT NOT (`האם המניה היא מניה רדומה` TRUE FALSE FALSE)
#ASSERT NOT (`האם המניה היא מניה רדומה` FALSE FALSE TRUE)
#ASSERT `האם החברה רשאית לחזור ולמכור את ניירות הערך` TRUE TRUE
#ASSERT NOT (`האם החברה רשאית לחזור ולמכור את ניירות הערך` TRUE FALSE)
#ASSERT NOT (`האם החברה רשאית לחזור ולמכור את ניירות הערך` FALSE TRUE)
#ASSERT `האם המניות שהומרו או מומשו הן מניות רדומות` TRUE TRUE
#ASSERT NOT (`האם המניות שהומרו או מומשו הן מניות רדומות` TRUE FALSE)
-- 309: a subsidiary may buy its parent's shares to the extent the parent may distribute, on the determination of its board; such shares carry no votes; who bears the 311 liability; the amount of the distribution when the subsidiary is not wholly owned; convertible securities up to the liability shown.
#ASSERT `האם החברה הבת רשאית לרכוש מניות של החברה האם` 100 150 TRUE
#ASSERT NOT (`האם החברה הבת רשאית לרכוש מניות של החברה האם` 100 150 FALSE)
#ASSERT NOT (`האם החברה הבת רשאית לרכוש מניות של החברה האם` 200 150 TRUE)
#ASSERT NOT (`האם המניה קונה זכויות הצבעה` TRUE TRUE)
#ASSERT `האם המניה קונה זכויות הצבעה` TRUE FALSE
#ASSERT `האם המניה קונה זכויות הצבעה` FALSE TRUE
#ASSERT `מי נושא באחריות לפי סעיף 311` TRUE EQUALS `הדירקטורים בחברה האם`
#ASSERT `מי נושא באחריות לפי סעיף 311` FALSE EQUALS `הדירקטורים בחברה הבת והמנהלים בתאגיד הרוכש`
#ASSERT `סכום החלוקה ברכישה בידי חברה בת שאינה בבעלות מלאה` TRUE 1000 0.5 EQUALS NOTHING
#ASSERT `סכום החלוקה ברכישה בידי חברה בת שאינה בבעלות מלאה` FALSE 1000 0.4 EQUALS JUST 400
#ASSERT `החלק ברכישה שנחשב חלוקה` 100 30 EQUALS 70
#ASSERT `החלק ברכישה שנחשב חלוקה` 100 150 EQUALS 0
-- 310(ב): a shareholder in a public company who was not a director, general manager or controlling shareholder is presumed not to have known or had reason to know. 310(א): a shareholder must return what he received from a forbidden distribution unless he did not know and had no reason to know.
-- Arguments: company (four); I was a director, general manager or controlling shareholder; it was proved that I knew or should have known.
#ASSERT `האם חלה לטובתי החזקה` TRUE FALSE FALSE TRUE FALSE FALSE
#ASSERT NOT (`האם חלה לטובתי החזקה` TRUE FALSE FALSE TRUE TRUE FALSE)
#ASSERT NOT (`האם חלה לטובתי החזקה` TRUE FALSE FALSE TRUE FALSE TRUE)
#ASSERT NOT (`האם חלה לטובתי החזקה` FALSE FALSE FALSE FALSE FALSE FALSE)
-- Arguments for 310(א): company (four); a forbidden distribution was made; I received from it; I knew it was forbidden; on the facts I should have known; I was a director, general manager or controlling shareholder; it was proved that I knew or should have known.
#ASSERT `האם עליי להשיב לחברה את שקיבלתי` FALSE FALSE FALSE FALSE TRUE TRUE TRUE FALSE FALSE FALSE
#ASSERT `האם עליי להשיב לחברה את שקיבלתי` FALSE FALSE FALSE FALSE TRUE TRUE FALSE TRUE FALSE FALSE
#ASSERT NOT (`האם עליי להשיב לחברה את שקיבלתי` TRUE FALSE FALSE TRUE TRUE TRUE FALSE TRUE FALSE FALSE)
#ASSERT `האם עליי להשיב לחברה את שקיבלתי` TRUE FALSE FALSE TRUE TRUE TRUE FALSE TRUE FALSE TRUE
#ASSERT `האם עליי להשיב לחברה את שקיבלתי` TRUE FALSE FALSE TRUE TRUE TRUE FALSE TRUE TRUE FALSE
#ASSERT NOT (`האם עליי להשיב לחברה את שקיבלתי` FALSE FALSE FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`האם עליי להשיב לחברה את שקיבלתי` FALSE FALSE FALSE FALSE TRUE FALSE TRUE TRUE FALSE FALSE)
#ASSERT NOT (`האם עליי להשיב לחברה את שקיבלתי` FALSE FALSE FALSE FALSE FALSE TRUE TRUE TRUE FALSE FALSE)
-- 311: a director on the day of a forbidden distribution is regarded as having breached his duties unless he proves one of three things. Arguments: a forbidden distribution; I was a director; I proved I opposed it and took all reasonable measures; I proved I relied reasonably on information; I proved I did not know and had no reason to know.
#ASSERT `האם אני נחשב כמי שהפר את חובותיי כלפי החברה` TRUE TRUE FALSE FALSE FALSE
#ASSERT NOT (`האם אני נחשב כמי שהפר את חובותיי כלפי החברה` TRUE TRUE TRUE FALSE FALSE)
#ASSERT NOT (`האם אני נחשב כמי שהפר את חובותיי כלפי החברה` TRUE TRUE FALSE TRUE FALSE)
#ASSERT NOT (`האם אני נחשב כמי שהפר את חובותיי כלפי החברה` TRUE TRUE FALSE FALSE TRUE)
#ASSERT NOT (`האם אני נחשב כמי שהפר את חובותיי כלפי החברה` TRUE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`האם אני נחשב כמי שהפר את חובותיי כלפי החברה` FALSE TRUE FALSE FALSE FALSE)
-- 312, 313: redeemable securities.
#ASSERT `האם החברה רשאית להנפיק ניירות ערך בני פדיון` TRUE
#ASSERT NOT (`האם החברה רשאית להנפיק ניירות ערך בני פדיון` FALSE)
