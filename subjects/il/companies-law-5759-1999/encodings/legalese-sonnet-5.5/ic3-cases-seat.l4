#ASSERT NOT (`האם אני זכאי לייעוץ מקצועי על חשבון החברה` FALSE TRUE TRUE FALSE)
#ASSERT `האם שני השיקולים מצביעים על אישור הבקשה` TRUE TRUE
#ASSERT NOT (`האם שני השיקולים מצביעים על אישור הבקשה` TRUE FALSE)
#ASSERT NOT (`האם שני השיקולים מצביעים על אישור הבקשה` FALSE TRUE)
-- 267(א): a director who has a reasonable basis to believe that an act is about to be done that may breach a duty may apply to the court; first under 257 if the circumstances allow.
#ASSERT `האם אני רשאי לפנות לבית המשפט כדי למנוע פעולה או לאכוף חובה` TRUE TRUE FALSE FALSE
#ASSERT NOT (`האם אני רשאי לפנות לבית המשפט כדי למנוע פעולה או לאכוף חובה` TRUE TRUE TRUE FALSE)
