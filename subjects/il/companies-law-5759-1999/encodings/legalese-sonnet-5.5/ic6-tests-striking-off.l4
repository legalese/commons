IMPORT prelude
IMPORT daydate
IMPORT `ic-core`
IMPORT `ic-core-company-kinds`
IMPORT `ic6-striking-off`
IMPORT `ic6-tests-fixtures`

-- Tests of ic6-striking-off.l4 (Part 9 chapter 3A). Expected values are written by hand from the sections named; none is copied from the rules' output.
-- The record of the five conditions is built positionally. The columns, in the order of the DECLARE:
--   (1) not carrying on business, (2) has assets, (2) has debts, (3) registered a year as defaulting, (4) three years of unpaid annual fee, (4) breached the annual report duty,
--   (5) data not in the Tax Authority database, (5) Tax Authority file closed.

§ `בדיקות – חלק 9 פרק 3א: מחיקת חברה`

§§ `סעיף 351ב: הגדרות`

-- "Company" for the chapter: a private company that is not a bond company.
#ASSERT `סעיף 351ב - חברה לעניין פרק 3א` `בדיקה ic6 - חברה פרטית רגילה`
#ASSERT `סעיף 351ב - חברה לעניין פרק 3א` `בדיקה ic6 - חברה לתועלת הציבור`
#ASSERT NOT (`סעיף 351ב - חברה לעניין פרק 3א` `בדיקה ic6 - חברה ציבורית`)
#ASSERT NOT (`סעיף 351ב - חברה לעניין פרק 3א` `בדיקה ic6 - חברה פרטית שהיא חברת איגרות חוב`)
-- A body that is not a company at all is not a private company either (the core's reading, entry F17 of the keel).
#ASSERT NOT (`סעיף 351ב - חברה לעניין פרק 3א` `בדיקה ic6 - עובדות על גוף שאינו חברה`)
-- "Debt" and "asset": the exclusions.
#ASSERT `סעיף 351ב - החוב נחשב חוב לעניין פרק 3א` FALSE FALSE
#ASSERT NOT (`סעיף 351ב - החוב נחשב חוב לעניין פרק 3א` TRUE FALSE)
#ASSERT NOT (`סעיף 351ב - החוב נחשב חוב לעניין פרק 3א` FALSE TRUE)
#ASSERT `סעיף 351ב - הנכס נחשב נכס לעניין פרק 3א` FALSE
#ASSERT NOT (`סעיף 351ב - הנכס נחשב נכס לעניין פרק 3א` TRUE)
-- "Objection".
#ASSERT `סעיף 351ב - התנגדות לעניין פרק 3א` TRUE
#ASSERT NOT (`סעיף 351ב - התנגדות לעניין פרק 3א` FALSE)

§§ `סעיף 351ג: התנאים למחיקה`

-- All five conditions hold.
#ASSERT `סעיף 351ג(א) - התקיימו כל התנאים למחיקת חברה` (`עובדות על חברה לעניין מחיקתה` OF TRUE, FALSE, FALSE, TRUE, TRUE, TRUE, TRUE, FALSE)
-- Each condition is needed: (1) she carries on business; (2) she has assets; (2) she has debts; (3) not registered for a year; (4) fee paid; (4) annual report filed; (5) she is in the database and her file is open.
#ASSERT NOT (`סעיף 351ג(א) - התקיימו כל התנאים למחיקת חברה` (`עובדות על חברה לעניין מחיקתה` OF FALSE, FALSE, FALSE, TRUE, TRUE, TRUE, TRUE, FALSE))
#ASSERT NOT (`סעיף 351ג(א) - התקיימו כל התנאים למחיקת חברה` (`עובדות על חברה לעניין מחיקתה` OF TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, FALSE))
#ASSERT NOT (`סעיף 351ג(א) - התקיימו כל התנאים למחיקת חברה` (`עובדות על חברה לעניין מחיקתה` OF TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE))
#ASSERT NOT (`סעיף 351ג(א) - התקיימו כל התנאים למחיקת חברה` (`עובדות על חברה לעניין מחיקתה` OF TRUE, FALSE, FALSE, FALSE, TRUE, TRUE, TRUE, FALSE))
#ASSERT NOT (`סעיף 351ג(א) - התקיימו כל התנאים למחיקת חברה` (`עובדות על חברה לעניין מחיקתה` OF TRUE, FALSE, FALSE, TRUE, FALSE, TRUE, TRUE, FALSE))
#ASSERT NOT (`סעיף 351ג(א) - התקיימו כל התנאים למחיקת חברה` (`עובדות על חברה לעניין מחיקתה` OF TRUE, FALSE, FALSE, TRUE, TRUE, FALSE, TRUE, FALSE))
#ASSERT NOT (`סעיף 351ג(א) - התקיימו כל התנאים למחיקת חברה` (`עובדות על חברה לעניין מחיקתה` OF TRUE, FALSE, FALSE, TRUE, TRUE, TRUE, FALSE, FALSE))
-- Paragraph (5) is satisfied by either limb: not in the database, or the file closed.
#ASSERT `סעיף 351ג(א) - התקיימו כל התנאים למחיקת חברה` (`עובדות על חברה לעניין מחיקתה` OF TRUE, FALSE, FALSE, TRUE, TRUE, TRUE, FALSE, TRUE)
-- (3) by dates: registered as defaulting on 1 March 2025; a year is complete on 1 March 2026.
#ASSERT NOT (`סעיף 351ג(א)(3) - עברה שנה מרישום החברה כחברה מפרה` (YearMonthDay 2025 3 1) (YearMonthDay 2026 2 28))
#ASSERT `סעיף 351ג(א)(3) - עברה שנה מרישום החברה כחברה מפרה` (YearMonthDay 2025 3 1) (YearMonthDay 2026 3 1)
-- (2) with the chapter's definitions: assets and debts are what the definitions leave.
-- Public-benefit variant: paragraph (3) is dropped and the Registrar of Endowments must consent.
#ASSERT `סעיף 351ג(ב) - התקיימו התנאים למחיקת חברה לתועלת הציבור` (`עובדות על חברה לעניין מחיקתה` OF TRUE, FALSE, FALSE, FALSE, TRUE, TRUE, TRUE, FALSE) TRUE
#ASSERT NOT (`סעיף 351ג(ב) - התקיימו התנאים למחיקת חברה לתועלת הציבור` (`עובדות על חברה לעניין מחיקתה` OF TRUE, FALSE, FALSE, FALSE, TRUE, TRUE, TRUE, FALSE) FALSE)
#ASSERT NOT (`סעיף 351ג(ב) - התקיימו התנאים למחיקת חברה לתועלת הציבור` (`עובדות על חברה לעניין מחיקתה` OF TRUE, FALSE, FALSE, FALSE, FALSE, TRUE, TRUE, FALSE) TRUE)
-- Which set governs: an ordinary private company needs paragraph (3); a public-benefit company does not but needs the consent; a public company is not a "company" of the chapter.
#ASSERT NOT (`סעיף 351ג - התקיימו התנאים למחיקת החברה` `בדיקה ic6 - חברה פרטית רגילה` (`עובדות על חברה לעניין מחיקתה` OF TRUE, FALSE, FALSE, FALSE, TRUE, TRUE, TRUE, FALSE) TRUE)
#ASSERT `סעיף 351ג - התקיימו התנאים למחיקת החברה` `בדיקה ic6 - חברה פרטית רגילה` (`עובדות על חברה לעניין מחיקתה` OF TRUE, FALSE, FALSE, TRUE, TRUE, TRUE, TRUE, FALSE) FALSE
#ASSERT `סעיף 351ג - התקיימו התנאים למחיקת החברה` `בדיקה ic6 - חברה לתועלת הציבור` (`עובדות על חברה לעניין מחיקתה` OF TRUE, FALSE, FALSE, FALSE, TRUE, TRUE, TRUE, FALSE) TRUE
#ASSERT NOT (`סעיף 351ג - התקיימו התנאים למחיקת החברה` `בדיקה ic6 - חברה לתועלת הציבור` (`עובדות על חברה לעניין מחיקתה` OF TRUE, FALSE, FALSE, FALSE, TRUE, TRUE, TRUE, FALSE) FALSE)
#ASSERT NOT (`סעיף 351ג - התקיימו התנאים למחיקת החברה` `בדיקה ic6 - חברה ציבורית` (`עובדות על חברה לעניין מחיקתה` OF TRUE, FALSE, FALSE, TRUE, TRUE, TRUE, TRUE, FALSE) TRUE)
-- (ג): published criteria and a finding by them.
#ASSERT `סעיף 351ג(ג) - הממצא על חובות ונכסים נמוכי ערך מבוסס על אמות מידה שפורסמו` TRUE TRUE
#ASSERT NOT (`סעיף 351ג(ג) - הממצא על חובות ונכסים נמוכי ערך מבוסס על אמות מידה שפורסמו` FALSE TRUE)
#ASSERT NOT (`סעיף 351ג(ג) - הממצא על חובות ונכסים נמוכי ערך מבוסס על אמות מידה שפורסמו` TRUE FALSE)

§§ `סעיף 351ד: בדיקות מקדימות`

-- Conditions (3) and (4) hold: the Registrar may demand information from a banking corporation or a public body; from any other body the text does not say (NOTHING).
#ASSERT `סעיף 351ד(א) - הרשם רשאי לדרוש מידע` (`עובדות על חברה לעניין מחיקתה` OF TRUE, FALSE, FALSE, TRUE, TRUE, TRUE, FALSE, FALSE) `תאגיד בנקאי כהגדרתו בחוק הבנקאות (רישוי)` EQUALS JUST TRUE
#ASSERT `סעיף 351ד(א) - הרשם רשאי לדרוש מידע` (`עובדות על חברה לעניין מחיקתה` OF TRUE, FALSE, FALSE, TRUE, TRUE, TRUE, FALSE, FALSE) `גוף ציבורי כהגדרתו בסעיף 23 לחוק הגנת הפרטיות, ובכלל זה רשות המסים, רשם המקרקעין, רשות מקרקעי ישראל, רשות האכיפה והגבייה והמוסד לביטוח לאומי` EQUALS JUST TRUE
#ASSERT `סעיף 351ד(א) - הרשם רשאי לדרוש מידע` (`עובדות על חברה לעניין מחיקתה` OF TRUE, FALSE, FALSE, TRUE, TRUE, TRUE, FALSE, FALSE) `גוף אחר` EQUALS NOTHING
-- Condition (3) or (4) fails: no power.
#ASSERT `סעיף 351ד(א) - הרשם רשאי לדרוש מידע` (`עובדות על חברה לעניין מחיקתה` OF TRUE, FALSE, FALSE, FALSE, TRUE, TRUE, FALSE, FALSE) `תאגיד בנקאי כהגדרתו בחוק הבנקאות (רישוי)` EQUALS JUST FALSE
#ASSERT `סעיף 351ד(א) - הרשם רשאי לדרוש מידע` (`עובדות על חברה לעניין מחיקתה` OF TRUE, FALSE, FALSE, TRUE, FALSE, TRUE, FALSE, FALSE) `תאגיד בנקאי כהגדרתו בחוק הבנקאות (רישוי)` EQUALS JUST FALSE

§§ `סעיף 351ה: הודעה והתנגדות`

-- (א): notice of intention: conditions (3) to (5) hold and the Registrar has a reasonable basis to think (1) and (2) hold.
#ASSERT `סעיף 351ה(א) - הרשם רשאי לפרסם הודעה על כוונה למחוק` (`עובדות על חברה לעניין מחיקתה` OF FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE) TRUE
#ASSERT NOT (`סעיף 351ה(א) - הרשם רשאי לפרסם הודעה על כוונה למחוק` (`עובדות על חברה לעניין מחיקתה` OF FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE) FALSE)
#ASSERT NOT (`סעיף 351ה(א) - הרשם רשאי לפרסם הודעה על כוונה למחוק` (`עובדות על חברה לעניין מחיקתה` OF TRUE, FALSE, FALSE, TRUE, TRUE, TRUE, FALSE, FALSE) TRUE)
#ASSERT `סעיף 351ה(א) - ההודעה על הכוונה למחוק עומדת בדרישות` TRUE TRUE TRUE
#ASSERT NOT (`סעיף 351ה(א) - ההודעה על הכוונה למחוק עומדת בדרישות` TRUE TRUE FALSE)
#ASSERT NOT (`סעיף 351ה(א) - ההודעה על הכוונה למחוק עומדת בדרישות` TRUE FALSE TRUE)
#ASSERT NOT (`סעיף 351ה(א) - ההודעה על הכוונה למחוק עומדת בדרישות` FALSE TRUE TRUE)
-- (ב): published on 1 January 2026, the 90th day is 1 April 2026 and is inside the period.
#ASSERT `סעיף 351ה(ב) - ההתנגדות הוגשה במועד על ידי מי שרשאי להגישה` TRUE (YearMonthDay 2026 1 1) (YearMonthDay 2026 4 1)
#ASSERT NOT (`סעיף 351ה(ב) - ההתנגדות הוגשה במועד על ידי מי שרשאי להגישה` TRUE (YearMonthDay 2026 1 1) (YearMonthDay 2026 4 2))
#ASSERT `סעיף 351ה(ב) - ההתנגדות הוגשה במועד על ידי מי שרשאי להגישה` TRUE (YearMonthDay 2026 1 1) (YearMonthDay 2026 1 1)
-- Only someone who may be harmed may object.
#ASSERT NOT (`סעיף 351ה(ב) - ההתנגדות הוגשה במועד על ידי מי שרשאי להגישה` FALSE (YearMonthDay 2026 1 1) (YearMonthDay 2026 2 1))
-- (ג): form and content; a link to the company only if there is one.
#ASSERT `סעיף 351ה(ג) - ההתנגדות עומדת בדרישות הצורה והתוכן` TRUE TRUE TRUE TRUE TRUE TRUE
#ASSERT `סעיף 351ה(ג) - ההתנגדות עומדת בדרישות הצורה והתוכן` TRUE TRUE TRUE FALSE FALSE TRUE
#ASSERT NOT (`סעיף 351ה(ג) - ההתנגדות עומדת בדרישות הצורה והתוכן` TRUE TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`סעיף 351ה(ג) - ההתנגדות עומדת בדרישות הצורה והתוכן` FALSE TRUE TRUE FALSE FALSE TRUE)
#ASSERT NOT (`סעיף 351ה(ג) - ההתנגדות עומדת בדרישות הצורה והתוכן` TRUE FALSE TRUE FALSE FALSE TRUE)
#ASSERT NOT (`סעיף 351ה(ג) - ההתנגדות עומדת בדרישות הצורה והתוכן` TRUE TRUE FALSE FALSE FALSE TRUE)
#ASSERT NOT (`סעיף 351ה(ג) - ההתנגדות עומדת בדרישות הצורה והתוכן` TRUE TRUE TRUE FALSE FALSE FALSE)
-- (ד): rejecting an objection, any one of three grounds.
#ASSERT `סעיף 351ה(ד) - הרשם רשאי לדחות את ההתנגדות` TRUE FALSE FALSE
#ASSERT `סעיף 351ה(ד) - הרשם רשאי לדחות את ההתנגדות` FALSE TRUE FALSE
#ASSERT `סעיף 351ה(ד) - הרשם רשאי לדחות את ההתנגדות` FALSE FALSE TRUE
#ASSERT NOT (`סעיף 351ה(ד) - הרשם רשאי לדחות את ההתנגדות` FALSE FALSE FALSE)
-- (ה): notice published 1 January 2026; no live objection; the deletion may be made only after day 90 (1 April), so on 2 April and not on 1 April.
#ASSERT `סעיף 351ה(ה) - הרשם רשאי למחוק את החברה ממרשמיו` TRUE FALSE (YearMonthDay 2026 1 1) (YearMonthDay 2026 4 2)
#ASSERT NOT (`סעיף 351ה(ה) - הרשם רשאי למחוק את החברה ממרשמיו` TRUE FALSE (YearMonthDay 2026 1 1) (YearMonthDay 2026 4 1))
#ASSERT NOT (`סעיף 351ה(ה) - הרשם רשאי למחוק את החברה ממרשמיו` TRUE TRUE (YearMonthDay 2026 1 1) (YearMonthDay 2026 6 1))
#ASSERT NOT (`סעיף 351ה(ה) - הרשם רשאי למחוק את החברה ממרשמיו` FALSE FALSE (YearMonthDay 2026 1 1) (YearMonthDay 2026 6 1))

§§ `סעיף 351ו: נפקות המחיקה`

#ASSERT `סעיף 351ו(א) - מחברה שנמחקה רואים את החברה כמחוסלת` TRUE
#ASSERT NOT (`סעיף 351ו(א) - מחברה שנמחקה רואים את החברה כמחוסלת` FALSE)
#ASSERT `סעיף 351ו(א) - אפשרות הפירוק מרצון וסמכות בית המשפט לפרק נשמרות` TRUE
-- (ב): a liability that arose before the deletion survives until dissolution after winding up; so does a duty that would have applied to someone through whom the company went on operating.
#ASSERT `סעיף 351ו(ב) - החבות או החובה של בעל מניות או נושא משרה נשמרת` TRUE FALSE FALSE TRUE
#ASSERT `סעיף 351ו(ב) - החבות או החובה של בעל מניות או נושא משרה נשמרת` FALSE TRUE TRUE TRUE
#ASSERT NOT (`סעיף 351ו(ב) - החבות או החובה של בעל מניות או נושא משרה נשמרת` FALSE TRUE FALSE TRUE)
#ASSERT NOT (`סעיף 351ו(ב) - החבות או החובה של בעל מניות או נושא משרה נשמרת` FALSE FALSE TRUE TRUE)
#ASSERT NOT (`סעיף 351ו(ב) - החבות או החובה של בעל מניות או נושא משרה נשמרת` TRUE FALSE FALSE FALSE)
-- (ג): the former controlling shareholder stays caught until dissolution after winding up.
#ASSERT `סעיף 351ו(ג) - הוראת סעיף 362א(ג)(1)(ג)(2) ממשיכה לחול על בעל השליטה לשעבר` TRUE TRUE TRUE
#ASSERT NOT (`סעיף 351ו(ג) - הוראת סעיף 362א(ג)(1)(ג)(2) ממשיכה לחול על בעל השליטה לשעבר` TRUE FALSE TRUE)
#ASSERT NOT (`סעיף 351ו(ג) - הוראת סעיף 362א(ג)(1)(ג)(2) ממשיכה לחול על בעל השליטה לשעבר` TRUE TRUE FALSE)
#ASSERT NOT (`סעיף 351ו(ג) - הוראת סעיף 362א(ג)(1)(ג)(2) ממשיכה לחול על בעל השליטה לשעבר` FALSE TRUE TRUE)

§§ `סעיף 351ז: ביטול מחיקה בידי הרשם`

-- (א)(1): deletion on 1 March 2025; a year ends on 1 March 2026.
#ASSERT `סעיף 351ז(א)(1) - הרשם רשאי לבטל מחיקה מיוזמתו` (YearMonthDay 2025 3 1) (YearMonthDay 2026 3 1) TRUE TRUE
#ASSERT NOT (`סעיף 351ז(א)(1) - הרשם רשאי לבטל מחיקה מיוזמתו` (YearMonthDay 2025 3 1) (YearMonthDay 2026 3 2) TRUE TRUE)
#ASSERT NOT (`סעיף 351ז(א)(1) - הרשם רשאי לבטל מחיקה מיוזמתו` (YearMonthDay 2025 3 1) (YearMonthDay 2025 9 1) FALSE TRUE)
#ASSERT NOT (`סעיף 351ז(א)(1) - הרשם רשאי לבטל מחיקה מיוזמתו` (YearMonthDay 2025 3 1) (YearMonthDay 2025 9 1) TRUE FALSE)
-- (א)(2): at the request of an interested person who was harmed, filed within the year.
#ASSERT `סעיף 351ז(א)(2) - הרשם רשאי לבטל מחיקה לבקשת אדם מעוניין` TRUE (YearMonthDay 2025 3 1) (YearMonthDay 2026 3 1) TRUE TRUE
#ASSERT NOT (`סעיף 351ז(א)(2) - הרשם רשאי לבטל מחיקה לבקשת אדם מעוניין` TRUE (YearMonthDay 2025 3 1) (YearMonthDay 2026 3 2) TRUE TRUE)
#ASSERT NOT (`סעיף 351ז(א)(2) - הרשם רשאי לבטל מחיקה לבקשת אדם מעוניין` FALSE (YearMonthDay 2025 3 1) (YearMonthDay 2025 9 1) TRUE TRUE)
#ASSERT NOT (`סעיף 351ז(א)(2) - הרשם רשאי לבטל מחיקה לבקשת אדם מעוניין` TRUE (YearMonthDay 2025 3 1) (YearMonthDay 2025 9 1) FALSE TRUE)
#ASSERT NOT (`סעיף 351ז(א)(2) - הרשם רשאי לבטל מחיקה לבקשת אדם מעוניין` TRUE (YearMonthDay 2025 3 1) (YearMonthDay 2025 9 1) TRUE FALSE)
-- The annual fee may be demanded if the applicant is an office-holder, a shareholder or an heir of a shareholder; not of someone else.
#ASSERT `סעיף 351ז(א)(2) - הרשם רשאי לדרוש תשלום אגרה שנתית כתנאי לביטול` TRUE FALSE FALSE
#ASSERT `סעיף 351ז(א)(2) - הרשם רשאי לדרוש תשלום אגרה שנתית כתנאי לביטול` FALSE TRUE FALSE
#ASSERT `סעיף 351ז(א)(2) - הרשם רשאי לדרוש תשלום אגרה שנתית כתנאי לביטול` FALSE FALSE TRUE
#ASSERT NOT (`סעיף 351ז(א)(2) - הרשם רשאי לדרוש תשלום אגרה שנתית כתנאי לביטול` FALSE FALSE FALSE)
#ASSERT `סעיף 351ז(ב) - החברה חוזרת למרשמים ונחשבת כאילו לא נמחקה` TRUE
#ASSERT `סעיף 351ז(ג) - המבקש רשאי לפנות לבית המשפט אף אם טרם חלפה שנה, משהודיע הרשם` TRUE TRUE
#ASSERT NOT (`סעיף 351ז(ג) - המבקש רשאי לפנות לבית המשפט אף אם טרם חלפה שנה, משהודיע הרשם` TRUE FALSE)
#ASSERT NOT (`סעיף 351ז(ג) - המבקש רשאי לפנות לבית המשפט אף אם טרם חלפה שנה, משהודיע הרשם` FALSE TRUE)
-- (ד): application filed 1 January 2026; 60 days end on 2 March 2026. Told on that day: in time. Told on 3 March, or not told by 3 March: the applicant may go to court.
#ASSERT NOT (`סעיף 351ז(ד) - המבקש רשאי לפנות לבית המשפט אף אם טרם חלפה שנה, משלא הודיע הרשם בתוך 60 ימים` (YearMonthDay 2026 1 1) (JUST (YearMonthDay 2026 3 2)) (YearMonthDay 2026 6 1))
#ASSERT `סעיף 351ז(ד) - המבקש רשאי לפנות לבית המשפט אף אם טרם חלפה שנה, משלא הודיע הרשם בתוך 60 ימים` (YearMonthDay 2026 1 1) (JUST (YearMonthDay 2026 3 3)) (YearMonthDay 2026 6 1)
#ASSERT NOT (`סעיף 351ז(ד) - המבקש רשאי לפנות לבית המשפט אף אם טרם חלפה שנה, משלא הודיע הרשם בתוך 60 ימים` (YearMonthDay 2026 1 1) NOTHING (YearMonthDay 2026 3 2))
#ASSERT `סעיף 351ז(ד) - המבקש רשאי לפנות לבית המשפט אף אם טרם חלפה שנה, משלא הודיע הרשם בתוך 60 ימים` (YearMonthDay 2026 1 1) NOTHING (YearMonthDay 2026 3 3)

§§ `סעיף 351ח: ביטול מחיקה בידי בית משפט`

-- (א)(1): deletion on 1 March 2020. After a year has passed: from 2 March 2021; up to the end of 20 years: 1 March 2040.
#ASSERT NOT (`סעיף 351ח(א)(1) - הבקשה לבית המשפט הוגשה במועד` (YearMonthDay 2020 3 1) (YearMonthDay 2021 3 1) FALSE FALSE)
#ASSERT `סעיף 351ח(א)(1) - הבקשה לבית המשפט הוגשה במועד` (YearMonthDay 2020 3 1) (YearMonthDay 2021 3 2) FALSE FALSE
#ASSERT `סעיף 351ח(א)(1) - הבקשה לבית המשפט הוגשה במועד` (YearMonthDay 2020 3 1) (YearMonthDay 2040 3 1) FALSE FALSE
#ASSERT NOT (`סעיף 351ח(א)(1) - הבקשה לבית המשפט הוגשה במועד` (YearMonthDay 2020 3 1) (YearMonthDay 2040 3 2) FALSE FALSE)
-- Later than 20 years only with the court's leave for special reasons.
#ASSERT `סעיף 351ח(א)(1) - הבקשה לבית המשפט הוגשה במועד` (YearMonthDay 2020 3 1) (YearMonthDay 2045 1 1) TRUE FALSE
-- Before a year has passed, only in the circumstances of 351ז(ג) or (ד).
#ASSERT `סעיף 351ח(א)(1) - הבקשה לבית המשפט הוגשה במועד` (YearMonthDay 2020 3 1) (YearMonthDay 2020 9 1) FALSE TRUE
#ASSERT NOT (`סעיף 351ח(א)(1) - הבקשה לבית המשפט הוגשה במועד` (YearMonthDay 2020 3 1) (YearMonthDay 2020 9 1) FALSE FALSE)
-- Leave for a late application does not help an application filed within the first year.
#ASSERT NOT (`סעיף 351ח(א)(1) - הבקשה לבית המשפט הוגשה במועד` (YearMonthDay 2020 3 1) (YearMonthDay 2020 9 1) TRUE FALSE)
-- (א): all conditions together.
#ASSERT `סעיף 351ח(א) - בית המשפט רשאי לבטל את המחיקה` TRUE TRUE TRUE TRUE TRUE FALSE
#ASSERT `סעיף 351ח(א) - בית המשפט רשאי לבטל את המחיקה` TRUE TRUE TRUE TRUE FALSE TRUE
#ASSERT NOT (`סעיף 351ח(א) - בית המשפט רשאי לבטל את המחיקה` TRUE TRUE TRUE TRUE FALSE FALSE)
#ASSERT NOT (`סעיף 351ח(א) - בית המשפט רשאי לבטל את המחיקה` FALSE TRUE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`סעיף 351ח(א) - בית המשפט רשאי לבטל את המחיקה` TRUE FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`סעיף 351ח(א) - בית המשפט רשאי לבטל את המחיקה` TRUE TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`סעיף 351ח(א) - בית המשפט רשאי לבטל את המחיקה` TRUE TRUE TRUE FALSE TRUE TRUE)
#ASSERT `סעיף 351ח(ב) - בית המשפט רשאי לתת הוראה בעניין אגרה שנתית` TRUE TRUE
#ASSERT NOT (`סעיף 351ח(ב) - בית המשפט רשאי לתת הוראה בעניין אגרה שנתית` TRUE FALSE)
#ASSERT NOT (`סעיף 351ח(ב) - בית המשפט רשאי לתת הוראה בעניין אגרה שנתית` FALSE TRUE)
