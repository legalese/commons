#ASSERT `סעיף 13(א) - לצד שלישי שידע על היזמות הברירה לראות ביזם בעל דברו או לחזור בו` TRUE TRUE 2 TRUE TRUE 30 FALSE FALSE 0 EQUALS TRUE
#ASSERT `סעיף 13(א) - לצד שלישי שידע על היזמות הברירה לראות ביזם בעל דברו או לחזור בו` TRUE TRUE 2 TRUE TRUE 29 FALSE FALSE 0 EQUALS FALSE
#ASSERT `סעיף 13(א) - לצד שלישי שידע על היזמות הברירה לראות ביזם בעל דברו או לחזור בו` TRUE TRUE 2 TRUE FALSE 90 FALSE FALSE 0 EQUALS FALSE
#ASSERT `סעיף 13(א) - לצד שלישי שידע על היזמות הברירה לראות ביזם בעל דברו או לחזור בו` TRUE TRUE 2 FALSE TRUE 90 FALSE FALSE 0 EQUALS FALSE
-- (3) demanded approval, none within thirty days.
#ASSERT `סעיף 13(א) - לצד שלישי שידע על היזמות הברירה לראות ביזם בעל דברו או לחזור בו` TRUE TRUE 2 FALSE FALSE 0 TRUE FALSE 31 EQUALS TRUE
#ASSERT `סעיף 13(א) - לצד שלישי שידע על היזמות הברירה לראות ביזם בעל דברו או לחזור בו` TRUE TRUE 2 FALSE FALSE 0 TRUE FALSE 30 EQUALS FALSE
#ASSERT `סעיף 13(א) - לצד שלישי שידע על היזמות הברירה לראות ביזם בעל דברו או לחזור בו` TRUE TRUE 2 FALSE FALSE 0 TRUE TRUE 45 EQUALS FALSE
#ASSERT `סעיף 13(א) - לצד שלישי שידע על היזמות הברירה לראות ביזם בעל דברו או לחזור בו` TRUE TRUE 2 FALSE FALSE 0 FALSE FALSE 45 EQUALS FALSE
