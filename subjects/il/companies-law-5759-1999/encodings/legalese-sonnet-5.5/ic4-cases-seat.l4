-- ic4-cases-seat: cases for the seat questions of ic4-seat.l4 (Part 8, Part 8A and the opening of Part 9 of the Israeli Companies Law, 5759-1999).
-- Written by the part agent ic4 (Claude Sonnet 5.5). Every case is a situation a founder, director or shareholder could state in plain facts, asked as that person asks it.
-- Every expected value is decided from the Hebrew text of the section before the run, and written in the comment above the assertion. At least one case for each question,
-- both sides of every figure the text states, and the explicit not-covered answers (an Act-silent case answers NOTHING, an absent circumstance answers its own constructor).
-- The file is generated by _work/cases_gen.py from _work/cases_data.py; the generator formats the cases and checks each one has the right number and kind of inputs. It computes no expected value.
-- Only the seat layer is tested here; the layer-1 rules are tested in ic4-tests-*.l4.

§ `בדיקות: שאלות הנוף של מי שמקים, מנהל או מחזיק מניות בחברה`

§§ `מיזוג: האישורים הדרושים (סעיפים 314, 315, 316 ו־320)`

-- My company is the target and the absorber controls and wholly owns it: section 320(a1)(1) lifts the general meeting's approval, so none is needed.
#ASSERT NOT (`האם המיזוג של חברתי טעון אישור של האסיפה הכללית` TRUE TRUE FALSE (0%) FALSE FALSE FALSE (0%) (0%) FALSE 0 FALSE)

-- My company is the target and is not wholly owned by the absorber: the approval is needed.
#ASSERT `האם המיזוג של חברתי טעון אישור של האסיפה הכללית` TRUE FALSE FALSE (0%) FALSE FALSE FALSE (0%) (0%) FALSE 0 FALSE

-- My company is the absorber: no change of memorandum, 20 percent allotted exactly (not more than 20), no new controller, no special-vote circumstance: section 320(a1)(2) lifts the approval.
#ASSERT NOT (`האם המיזוג של חברתי טעון אישור של האסיפה הכללית` FALSE FALSE FALSE (20%) FALSE FALSE FALSE (0%) (0%) FALSE 0 FALSE)

-- As above but 21 percent allotted (more than 20): the approval is needed.
#ASSERT `האם המיזוג של חברתי טעון אישור של האסיפה הכללית` FALSE FALSE FALSE (21%) FALSE FALSE FALSE (0%) (0%) FALSE 0 FALSE

-- As above with a change of the memorandum: the approval is needed.
#ASSERT `האם המיזוג של חברתי טעון אישור של האסיפה הכללית` FALSE FALSE TRUE (10%) FALSE FALSE FALSE (0%) (0%) FALSE 0 FALSE

-- As above where the allotment makes a person a controlling shareholder: the approval is needed.
#ASSERT `האם המיזוג של חברתי טעון אישור של האסיפה הכללית` FALSE FALSE FALSE (10%) TRUE FALSE FALSE (0%) (0%) FALSE 0 FALSE

-- As above where my company's shares are held by the other merging company (section 320(c)): the approval is needed.
#ASSERT `האם המיזוג של חברתי טעון אישור של האסיפה הכללית` FALSE FALSE FALSE (10%) FALSE TRUE FALSE (0%) (0%) FALSE 0 FALSE

-- My company's shares are held by a person with 25 percent of the votes in the other merging company: section 320(c) applies, the approval is needed.
#ASSERT `האם המיזוג של חברתי טעון אישור של האסיפה הכללית` FALSE FALSE FALSE (10%) FALSE FALSE TRUE (25%) (0%) FALSE 0 FALSE

-- The same person with 24 percent of the votes and none of the right to appoint directors: below 25, no special-vote circumstance, the approval is not needed.
#ASSERT NOT (`האם המיזוג של חברתי טעון אישור של האסיפה הכללית` FALSE FALSE FALSE (10%) FALSE FALSE TRUE (24%) (0%) FALSE 0 FALSE)

-- The same person with 25 percent of the right to appoint directors in the other company: the approval is needed.
#ASSERT `האם המיזוג של חברתי טעון אישור של האסיפה הכללית` FALSE FALSE FALSE (10%) FALSE FALSE TRUE (24%) (25%) FALSE 0 FALSE

-- A 25 percent holding in the other company that comes only from holding shares in mine does not count: the approval is not needed.
#ASSERT NOT (`האם המיזוג של חברתי טעון אישור של האסיפה הכללית` FALSE FALSE FALSE (10%) FALSE FALSE TRUE (25%) (0%) TRUE 0 FALSE)

-- Section 320(d): a person holds 25 percent in two merging companies, mine included: the approval is needed.
#ASSERT `האם המיזוג של חברתי טעון אישור של האסיפה הכללית` FALSE FALSE FALSE (10%) FALSE FALSE FALSE (0%) (0%) FALSE 2 TRUE

-- Section 320(d): a person holds 25 percent in only one merging company: not enough, the approval is not needed.
#ASSERT NOT (`האם המיזוג של חברתי טעון אישור של האסיפה הכללית` FALSE FALSE FALSE (10%) FALSE FALSE FALSE (0%) (0%) FALSE 1 TRUE)

-- My board approved; the approval of the general meeting is not needed (absorber under 20 percent): all approvals are in place.
#ASSERT `האם חברתי קיבלה את האישורים שהמיזוג טעון` FALSE FALSE FALSE (10%) FALSE FALSE FALSE (0%) (0%) FALSE 0 FALSE TRUE FALSE

-- My board approved; the general meeting's approval is needed (allotment over 20 percent) and was given.
#ASSERT `האם חברתי קיבלה את האישורים שהמיזוג טעון` FALSE FALSE FALSE (30%) FALSE FALSE FALSE (0%) (0%) FALSE 0 FALSE TRUE TRUE

-- The general meeting's approval is needed and was not given: the approvals are missing.
#ASSERT NOT (`האם חברתי קיבלה את האישורים שהמיזוג טעון` FALSE FALSE FALSE (30%) FALSE FALSE FALSE (0%) (0%) FALSE 0 FALSE TRUE FALSE)

-- My board did not approve: the merger lacks the board's approval whatever the meeting did.
#ASSERT NOT (`האם חברתי קיבלה את האישורים שהמיזוג טעון` FALSE FALSE FALSE (10%) FALSE FALSE FALSE (0%) (0%) FALSE 0 FALSE FALSE TRUE)

-- My company is the target and its shares are in classes: the class meetings must approve as well.
#ASSERT `האם המיזוג של חברתי טעון גם אישור של אסיפות סוג` TRUE TRUE

-- My company is the target and has one class of shares: no class meeting is needed.
#ASSERT NOT (`האם המיזוג של חברתי טעון גם אישור של אסיפות סוג` TRUE FALSE)

-- My company is the absorber: section 320(b) speaks of the target's class meetings only.
#ASSERT NOT (`האם המיזוג של חברתי טעון גם אישור של אסיפות סוג` FALSE TRUE)

-- My board discussed the fear of the absorber's being unable to pay creditors and found none: we may approve.
#ASSERT `האם אני וחבריי לדירקטוריון רשאים לאשר את המיזוג` TRUE FALSE

-- My board did not discuss and determine the question: we may not approve.
#ASSERT NOT (`האם אני וחבריי לדירקטוריון רשאים לאשר את המיזוג` FALSE FALSE)

-- My board found a reasonable fear: we must not approve.
#ASSERT NOT (`האם אני וחבריי לדירקטוריון רשאים לאשר את המיזוג` TRUE TRUE)

-- Both boards approved: the boards must draw up the merger proposal jointly and sign it.
#ASSERT `האם על הדירקטוריונים לערוך במשותף הצעת מיזוג ולחתום עליה` TRUE TRUE

-- The other company's board did not approve: no joint duty yet.
#ASSERT NOT (`האם על הדירקטוריונים לערוך במשותף הצעת מיזוג ולחתום עליה` TRUE FALSE)

-- Only the other board approved: no joint duty yet.
#ASSERT NOT (`האם על הדירקטוריונים לערוך במשותף הצעת מיזוג ולחתום עליה` FALSE TRUE)

§§ `מיזוג: ההצבעה באסיפה הכללית ובקשה לבית המשפט (סעיפים 320, 321 ו־327)`

-- Nobody holds in a way that raises the special vote: section 320(c) does not apply, whatever the votes.
#ASSERT `האם הצעת המיזוג תידחה בהצבעה המיוחדת באסיפה הכללית של חברתי` FALSE FALSE (0%) (0%) FALSE 0 FALSE FALSE 10 90 0 EQUALS `סעיף 320(ג) אינו חל`

-- The other merging company holds my shares and 40 voted for, 60 against among those counted: the proposal is rejected.
#ASSERT `האם הצעת המיזוג תידחה בהצבעה המיוחדת באסיפה הכללית של חברתי` TRUE FALSE (0%) (0%) FALSE 0 FALSE FALSE 40 60 0 EQUALS `ההצעה נדחית לפי סעיף 320(ג)`

-- The same with 50 for and 50 against: a tie is not a majority against, the proposal is not rejected.
#ASSERT `האם הצעת המיזוג תידחה בהצבעה המיוחדת באסיפה הכללית של חברתי` TRUE FALSE (0%) (0%) FALSE 0 FALSE FALSE 50 50 0 EQUALS `ההצעה אינה נדחית לפי סעיף 320(ג)`

-- The same with 49 for and 51 against: a majority objected, the proposal is rejected.
#ASSERT `האם הצעת המיזוג תידחה בהצבעה המיוחדת באסיפה הכללית של חברתי` TRUE FALSE (0%) (0%) FALSE 0 FALSE FALSE 49 51 0 EQUALS `ההצעה נדחית לפי סעיף 320(ג)`

-- The same with 10 for, 40 against and 50 abstaining: abstentions are not counted, 40 of 50 objected, the proposal is rejected.
#ASSERT `האם הצעת המיזוג תידחה בהצבעה המיוחדת באסיפה הכללית של חברתי` TRUE FALSE (0%) (0%) FALSE 0 FALSE FALSE 10 40 50 EQUALS `ההצעה נדחית לפי סעיף 320(ג)`

-- A person with 25 percent in the other company holds my shares: the special vote applies and a majority for means the proposal is not rejected.
#ASSERT `האם הצעת המיזוג תידחה בהצבעה המיוחדת באסיפה הכללית של חברתי` FALSE TRUE (25%) (0%) FALSE 0 FALSE FALSE 70 30 0 EQUALS `ההצעה אינה נדחית לפי סעיף 320(ג)`

-- Section 320(f): the proposal is a transaction needing approval under section 275, so section 275 governs and the special vote does not decide.
#ASSERT `האם הצעת המיזוג תידחה בהצבעה המיוחדת באסיפה הכללית של חברתי` TRUE FALSE (0%) (0%) FALSE 0 FALSE TRUE 10 90 0 EQUALS `ההכרעה נתונה לסעיף 275`

-- I told the company before the vote whether my shares are held in the way section 320(c) describes: I may vote and my vote is counted.
#ASSERT `האם אני רשאי להצביע באסיפה הכללית על המיזוג וקולי יימנה` TRUE

-- I did not tell the company: I may not vote and my vote is not counted.
#ASSERT NOT (`האם אני רשאי להצביע באסיפה הכללית על המיזוג וקולי יימנה` FALSE)

-- We are shareholders holding 25 percent of the voting rights and the meeting approved: we may ask the court to determine that the company approved.
#ASSERT `האם אני ובעלי מניות נוספים רשאים לבקש מבית המשפט לקבוע שהחברה אישרה את המיזוג` TRUE (25%)

-- We hold 24 percent: below the 25 percent the section requires.
#ASSERT NOT (`האם אני ובעלי מניות נוספים רשאים לבקש מבית המשפט לקבוע שהחברה אישרה את המיזוג` TRUE (24%))

-- The general meeting did not approve under section 320(a): the section does not give us this request.
#ASSERT NOT (`האם אני ובעלי מניות נוספים רשאים לבקש מבית המשפט לקבוע שהחברה אישרה את המיזוג` FALSE (30%))

-- The meeting approved, we hold 25 percent and the court is persuaded the proposal is fair and reasonable: the court may determine that the company approved.
#ASSERT `האם בית המשפט רשאי לקבוע שהחברה אישרה את המיזוג` TRUE (25%) TRUE

-- As above but the court is not persuaded: it may not.
#ASSERT NOT (`האם בית המשפט רשאי לקבוע שהחברה אישרה את המיזוג` TRUE (25%) FALSE)

-- The court is persuaded but we hold only 24 percent: the request is not a proper one.
#ASSERT NOT (`האם בית המשפט רשאי לקבוע שהחברה אישרה את המיזוג` TRUE (24%) TRUE)

-- My company was incorporated before the Law came into force: the majority needed is three quarters.
#ASSERT `מהו הרוב הנדרש לאישור מיזוג בחברה שהתאגדה לפני תחילת החוק` TRUE EQUALS JUST (75%)

-- My company was incorporated after commencement: the section sets no majority, an explicit not-covered answer.
#ASSERT `מהו הרוב הנדרש לאישור מיזוג בחברה שהתאגדה לפני תחילת החוק` FALSE EQUALS NOTHING

-- Old company: 75 for and 25 against meets three quarters exactly.
#ASSERT `האם הצבעה על אישור מיזוג עומדת ברוב הנדרש בחברה שהתאגדה לפני תחילת החוק` TRUE 75 25 10 EQUALS JUST TRUE

-- Old company: 74 for and 26 against falls short of three quarters.
#ASSERT `האם הצבעה על אישור מיזוג עומדת ברוב הנדרש בחברה שהתאגדה לפני תחילת החוק` TRUE 74 26 0 EQUALS JUST FALSE

-- Old company: abstentions are not counted, so 3 for and 1 against meets three quarters.
#ASSERT `האם הצבעה על אישור מיזוג עומדת ברוב הנדרש בחברה שהתאגדה לפני תחילת החוק` TRUE 3 1 100 EQUALS JUST TRUE

-- Old company: nobody voted for or against, so there is no majority.
#ASSERT `האם הצבעה על אישור מיזוג עומדת ברוב הנדרש בחברה שהתאגדה לפני תחילת החוק` TRUE 0 0 5 EQUALS JUST FALSE

-- A company incorporated after commencement: the section sets no majority, not covered.
#ASSERT `האם הצבעה על אישור מיזוג עומדת ברוב הנדרש בחברה שהתאגדה לפני תחילת החוק` FALSE 90 10 0 EQUALS NOTHING

§§ `מיזוג: חובות החברה כלפי הרשם והנושים (סעיפים 317, 318 ו־322)`

-- Delivering the merger proposal to the Registrar within three days of convening the general meeting: the event has not happened, so the duty has not arisen.
#ASSERT `האם חברתי עמדה במועד להמציא לרשם את הצעת המיזוג` FALSE FALSE 0 EQUALS `החובה אינה חלה`

-- Delivering the merger proposal to the Registrar within three days of convening the general meeting: done on day 3, the last day inside the limit.
#ASSERT `האם חברתי עמדה במועד להמציא לרשם את הצעת המיזוג` TRUE TRUE 3 EQUALS `קויימה בתוך המועד`

-- Delivering the merger proposal to the Registrar within three days of convening the general meeting: done on day 4, one day late.
#ASSERT `האם חברתי עמדה במועד להמציא לרשם את הצעת המיזוג` TRUE TRUE 4 EQUALS `קויימה באיחור`

-- Delivering the merger proposal to the Registrar within three days of convening the general meeting: not yet done, day 3, the limit has not yet run.
#ASSERT `האם חברתי עמדה במועד להמציא לרשם את הצעת המיזוג` TRUE FALSE 3 EQUALS `טרם קויימה והמועד עדיין לא חלף`

-- Delivering the merger proposal to the Registrar within three days of convening the general meeting: not yet done, day 4, the limit has run out.
#ASSERT `האם חברתי עמדה במועד להמציא לרשם את הצעת המיזוג` TRUE FALSE 4 EQUALS `טרם קויימה והמועד חלף`

-- Telling the Registrar of the general meeting's decision within three days: the event has not happened, so the duty has not arisen.
#ASSERT `האם חברתי עמדה במועד להודיע לרשם על החלטת האסיפה הכללית` FALSE FALSE 0 EQUALS `החובה אינה חלה`

-- Telling the Registrar of the general meeting's decision within three days: done on day 3, the last day inside the limit.
#ASSERT `האם חברתי עמדה במועד להודיע לרשם על החלטת האסיפה הכללית` TRUE TRUE 3 EQUALS `קויימה בתוך המועד`

-- Telling the Registrar of the general meeting's decision within three days: done on day 4, one day late.
#ASSERT `האם חברתי עמדה במועד להודיע לרשם על החלטת האסיפה הכללית` TRUE TRUE 4 EQUALS `קויימה באיחור`

-- Telling the Registrar of the general meeting's decision within three days: not yet done, day 3, the limit has not yet run.
#ASSERT `האם חברתי עמדה במועד להודיע לרשם על החלטת האסיפה הכללית` TRUE FALSE 3 EQUALS `טרם קויימה והמועד עדיין לא חלף`

-- Telling the Registrar of the general meeting's decision within three days: not yet done, day 4, the limit has run out.
#ASSERT `האם חברתי עמדה במועד להודיע לרשם על החלטת האסיפה הכללית` TRUE FALSE 4 EQUALS `טרם קויימה והמועד חלף`

-- Telling the Registrar that the creditor notices were given (no time limit stated): the trigger has not happened, so the duty has not arisen.
#ASSERT `האם עלינו להודיע לרשם על מתן ההודעות לנושים` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- Telling the Registrar that the creditor notices were given (no time limit stated): the duty has arisen and is not done.
#ASSERT `האם עלינו להודיע לרשם על מתן ההודעות לנושים` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- Telling the Registrar that the creditor notices were given (no time limit stated): the duty has arisen and is done.
#ASSERT `האם עלינו להודיע לרשם על מתן ההודעות לנושים` TRUE TRUE EQUALS `החובה חלה וקויימה`

-- Delivering a copy of the court's decision to the Registrar within three days: the event has not happened, so the duty has not arisen.
#ASSERT `האם חברתי עמדה במועד להמציא לרשם עותק מהחלטת בית המשפט` FALSE FALSE 0 EQUALS `החובה אינה חלה`

-- Delivering a copy of the court's decision to the Registrar within three days: done on day 3, the last day inside the limit.
#ASSERT `האם חברתי עמדה במועד להמציא לרשם עותק מהחלטת בית המשפט` TRUE TRUE 3 EQUALS `קויימה בתוך המועד`

-- Delivering a copy of the court's decision to the Registrar within three days: done on day 4, one day late.
#ASSERT `האם חברתי עמדה במועד להמציא לרשם עותק מהחלטת בית המשפט` TRUE TRUE 4 EQUALS `קויימה באיחור`

-- Delivering a copy of the court's decision to the Registrar within three days: not yet done, day 3, the limit has not yet run.
#ASSERT `האם חברתי עמדה במועד להמציא לרשם עותק מהחלטת בית המשפט` TRUE FALSE 3 EQUALS `טרם קויימה והמועד עדיין לא חלף`

-- Delivering a copy of the court's decision to the Registrar within three days: not yet done, day 4, the limit has run out.
#ASSERT `האם חברתי עמדה במועד להמציא לרשם עותק מהחלטת בית המשפט` TRUE FALSE 4 EQUALS `טרם קויימה והמועד חלף`

-- Sending the merger proposal to the secured creditors within three days of delivering it to the Registrar: the event has not happened, so the duty has not arisen.
#ASSERT `האם חברתי עמדה במועד לשלוח את הצעת המיזוג לנושים המובטחים` FALSE FALSE 0 EQUALS `החובה אינה חלה`

-- Sending the merger proposal to the secured creditors within three days of delivering it to the Registrar: done on day 3, the last day inside the limit.
#ASSERT `האם חברתי עמדה במועד לשלוח את הצעת המיזוג לנושים המובטחים` TRUE TRUE 3 EQUALS `קויימה בתוך המועד`

-- Sending the merger proposal to the secured creditors within three days of delivering it to the Registrar: done on day 4, one day late.
#ASSERT `האם חברתי עמדה במועד לשלוח את הצעת המיזוג לנושים המובטחים` TRUE TRUE 4 EQUALS `קויימה באיחור`

-- Sending the merger proposal to the secured creditors within three days of delivering it to the Registrar: not yet done, day 3, the limit has not yet run.
#ASSERT `האם חברתי עמדה במועד לשלוח את הצעת המיזוג לנושים המובטחים` TRUE FALSE 3 EQUALS `טרם קויימה והמועד עדיין לא חלף`

-- Sending the merger proposal to the secured creditors within three days of delivering it to the Registrar: not yet done, day 4, the limit has run out.
#ASSERT `האם חברתי עמדה במועד לשלוח את הצעת המיזוג לנושים המובטחים` TRUE FALSE 4 EQUALS `טרם קויימה והמועד חלף`

-- Telling the unsecured creditors of the merger proposal (no time limit stated): the trigger has not happened, so the duty has not arisen.
#ASSERT `האם עלינו להודיע לנושים הלא מובטחים על הצעת המיזוג` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- Telling the unsecured creditors of the merger proposal (no time limit stated): the duty has arisen and is not done.
#ASSERT `האם עלינו להודיע לנושים הלא מובטחים על הצעת המיזוג` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- Telling the unsecured creditors of the merger proposal (no time limit stated): the duty has arisen and is done.
#ASSERT `האם עלינו להודיע לנושים הלא מובטחים על הצעת המיזוג` TRUE TRUE EQUALS `החובה חלה וקויימה`

-- Telling the Registrar of the Competition Commissioner's notice within three days: the event has not happened, so the duty has not arisen.
#ASSERT `האם חברתי עמדה במועד להודיע לרשם על הודעת הממונה על התחרות` FALSE FALSE 0 EQUALS `החובה אינה חלה`

-- Telling the Registrar of the Competition Commissioner's notice within three days: done on day 3, the last day inside the limit.
#ASSERT `האם חברתי עמדה במועד להודיע לרשם על הודעת הממונה על התחרות` TRUE TRUE 3 EQUALS `קויימה בתוך המועד`

-- Telling the Registrar of the Competition Commissioner's notice within three days: done on day 4, one day late.
#ASSERT `האם חברתי עמדה במועד להודיע לרשם על הודעת הממונה על התחרות` TRUE TRUE 4 EQUALS `קויימה באיחור`

-- Telling the Registrar of the Competition Commissioner's notice within three days: not yet done, day 3, the limit has not yet run.
#ASSERT `האם חברתי עמדה במועד להודיע לרשם על הודעת הממונה על התחרות` TRUE FALSE 3 EQUALS `טרם קויימה והמועד עדיין לא חלף`

-- Telling the Registrar of the Competition Commissioner's notice within three days: not yet done, day 4, the limit has run out.
#ASSERT `האם חברתי עמדה במועד להודיע לרשם על הודעת הממונה על התחרות` TRUE FALSE 4 EQUALS `טרם קויימה והמועד חלף`

-- A notice of delay or prevention reached the Registrar and has not been lifted: the merger may not be carried out.
#ASSERT `האם אסור לבצע את המיזוג של חברתי` TRUE FALSE

-- The notice was lifted: the bar is gone.
#ASSERT NOT (`האם אסור לבצע את המיזוג של חברתי` TRUE TRUE)

-- No such notice reached the Registrar: no bar.
#ASSERT NOT (`האם אסור לבצע את המיזוג של חברתי` FALSE FALSE)

§§ `מיזוג: נושים, בית המשפט וביצוע המיזוג (סעיפים 319, 323, 324, 325 ו־327)`

-- A creditor asked and the court found a reasonable fear that the absorber cannot meet our obligations: the court may delay or prevent the merger.
#ASSERT `האם בית המשפט רשאי לעכב או למנוע את המיזוג של חברתי לבקשת נושה` TRUE TRUE

-- A creditor asked but the court found no such fear: it may not.
#ASSERT NOT (`האם בית המשפט רשאי לעכב או למנוע את המיזוג של חברתי לבקשת נושה` TRUE FALSE)

-- The court found the fear but no creditor asked: it may not on this section.
#ASSERT NOT (`האם בית המשפט רשאי לעכב או למנוע את המיזוג של חברתי לבקשת נושה` FALSE TRUE)

-- A creditor asked: the court may give directions to secure creditors' rights, without a finding of fear (fork F3).
#ASSERT `האם בית המשפט רשאי לתת הוראות להבטחת זכויותיהם של נושי חברתי` TRUE

-- No creditor asked: no such power.
#ASSERT NOT (`האם בית המשפט רשאי לתת הוראות להבטחת זכויותיהם של נושי חברתי` FALSE)

-- All approvals are in at the Registrar, 30 days since each general meeting's decision and 50 days since each proposal was delivered: the merger is carried out.
#ASSERT `האם המיזוג בוצע` TRUE 30 30 50 50

-- One company's meeting decided only 29 days ago: not yet carried out.
#ASSERT NOT (`האם המיזוג בוצע` TRUE 29 40 60 60)

-- The proposal of the other company was delivered only 49 days ago: not yet carried out.
#ASSERT NOT (`האם המיזוג בוצע` TRUE 40 40 60 49)

-- A required approval is missing at the Registrar: not carried out whatever the days.
#ASSERT NOT (`האם המיזוג בוצע` FALSE 40 40 60 60)

-- The merger is carried out: the target's assets and liabilities pass to the absorber and the target is liquidated.
#ASSERT `האם נכסי חברת היעד וחיוביה עברו לחברה הקולטת וחברת היעד חוסלה` TRUE

-- The merger is not carried out: nothing passes.
#ASSERT NOT (`האם נכסי חברת היעד וחיוביה עברו לחברה הקולטת וחברת היעד חוסלה` FALSE)

-- We undertook in a contract not to merge: the chapter does not prevent it.
#ASSERT `האם חברתי רשאית להתחייב בחוזה או בתקנון להימנע ממיזוג או להתנות אותו בתנאים` TRUE FALSE TRUE FALSE

-- We undertook in the articles to make a merger subject to conditions: the chapter does not prevent it.
#ASSERT `האם חברתי רשאית להתחייב בחוזה או בתקנון להימנע ממיזוג או להתנות אותו בתנאים` FALSE TRUE FALSE TRUE

-- The undertaking is in neither a contract nor the articles: the section does not cover it.
#ASSERT NOT (`האם חברתי רשאית להתחייב בחוזה או בתקנון להימנע ממיזוג או להתנות אותו בתנאים` FALSE FALSE TRUE FALSE)

-- The undertaking is in a contract but is neither to refrain nor to condition: not covered.
#ASSERT NOT (`האם חברתי רשאית להתחייב בחוזה או בתקנון להימנע ממיזוג או להתנות אותו בתנאים` TRUE FALSE FALSE FALSE)

-- My floating charge restricts the company's right to create charges and a charge in the other company was created before the merger: mine does not rank ahead.
#ASSERT `האם שעבוד צף בחברתי עדיף על שעבוד שנוצר קודם למיזוג בחברה האחרת` TRUE TRUE TRUE EQUALS `השעבוד הצף אינו עדיף על השעבוד שנוצר קודם בחברה האחרת`

-- My floating charge does not restrict the right to create charges: the section sets no ranking.
#ASSERT `האם שעבוד צף בחברתי עדיף על שעבוד שנוצר קודם למיזוג בחברה האחרת` TRUE FALSE TRUE EQUALS `סעיף 325 אינו קובע עדיפות`

-- The other charge was created after the merger: the section sets no ranking.
#ASSERT `האם שעבוד צף בחברתי עדיף על שעבוד שנוצר קודם למיזוג בחברה האחרת` TRUE TRUE FALSE EQUALS `סעיף 325 אינו קובע עדיפות`

-- Floating charges on several merging companies, one made on the eve of the Law, not separable after the merger, creditors did not agree: they crystallise before the merger.
#ASSERT `האם השעבודים הצפים בחברות המתמזגות מתגבשים עובר למיזוג` TRUE TRUE TRUE FALSE

-- The creditors agreed to change the charges: they do not crystallise.
#ASSERT NOT (`האם השעבודים הצפים בחברות המתמזגות מתגבשים עובר למיזוג` TRUE TRUE TRUE TRUE)

-- No charge was created on the eve of the Law: the section does not apply.
#ASSERT NOT (`האם השעבודים הצפים בחברות המתמזגות מתגבשים עובר למיזוג` TRUE FALSE TRUE FALSE)

-- The assets can be separated after the merger: the section does not apply.
#ASSERT NOT (`האם השעבודים הצפים בחברות המתמזגות מתגבשים עובר למיזוג` TRUE TRUE FALSE FALSE)

§§ `הצעת רכש מיוחדת: רכישה, חוות דעת, נושאי משרה והסכמה (סעיפים 328 עד 334)`

-- A listed company held by the public, no control-block holder, I hold 10 and would hold 30 percent: I would become a control-block holder, so only a special tender offer.
#ASSERT `האם אסור לי לרכוש את המניות אלא בדרך של הצעת רכש מיוחדת` TRUE FALSE FALSE TRUE (10%) (30%) FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE

-- As above with 24 percent after: no control block, no duty.
#ASSERT NOT (`האם אסור לי לרכוש את המניות אלא בדרך של הצעת רכש מיוחדת` TRUE FALSE FALSE TRUE (10%) (24%) FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)

-- As above with exactly 25 percent after: a control block is 25 percent or more, so the duty applies.
#ASSERT `האם אסור לי לרכוש את המניות אלא בדרך של הצעת רכש מיוחדת` TRUE FALSE FALSE TRUE (10%) (25%) FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE

-- Someone else holds a control block; I hold 20 and would hold 46 percent and nobody holds over 45: my holding rises above 45, so only a special tender offer.
#ASSERT `האם אסור לי לרכוש את המניות אלא בדרך של הצעת רכש מיוחדת` TRUE FALSE FALSE TRUE (20%) (46%) TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE

-- As above with 45 percent after: not more than 45, no duty.
#ASSERT NOT (`האם אסור לי לרכוש את המניות אלא בדרך של הצעת רכש מיוחדת` TRUE FALSE FALSE TRUE (20%) (45%) TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)

-- As above but another person already holds over 45 percent: the 45 percent limb does not apply.
#ASSERT NOT (`האם אסור לי לרכוש את המניות אלא בדרך של הצעת רכש מיוחדת` TRUE FALSE FALSE TRUE (20%) (46%) TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)

-- I already hold a control block (30 percent) and buy up to 40: I am not becoming a holder, no duty.
#ASSERT NOT (`האם אסור לי לרכוש את המניות אלא בדרך של הצעת רכש מיוחדת` TRUE FALSE FALSE TRUE (30%) (40%) FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)

-- A private offer approved at a general meeting to give the offeree a control block: exempt under section 328(b)(1).
#ASSERT NOT (`האם אסור לי לרכוש את המניות אלא בדרך של הצעת רכש מיוחדת` TRUE FALSE FALSE TRUE (10%) (30%) FALSE FALSE FALSE FALSE TRUE FALSE FALSE TRUE FALSE)

-- The offer was a public offer: not a private offer, so the exemption does not help and the duty stands.
#ASSERT `האם אסור לי לרכוש את המניות אלא בדרך של הצעת רכש מיוחדת` TRUE FALSE FALSE TRUE (10%) (30%) FALSE FALSE FALSE FALSE TRUE FALSE TRUE TRUE FALSE

-- A private company (shares neither listed nor offered to the public): the chapter does not apply.
#ASSERT NOT (`האם אסור לי לרכוש את המניות אלא בדרך של הצעת רכש מיוחדת` FALSE FALSE FALSE FALSE (10%) (30%) FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)

-- A control-block holder already exists (he is the seller) and I buy his block, going from 10 to 30 percent: subsection (a) applies only where no control-block holder exists, so no special tender offer (the exemption of (b)(2) adds nothing here).
#ASSERT NOT (`האם אסור לי לרכוש את המניות אלא בדרך של הצעת רכש מיוחדת` TRUE FALSE FALSE TRUE (10%) (30%) TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE)

-- No provision of another law on tender offers conflicts with the chapter: the other law applies as well.
#ASSERT `האם הוראה של דין אחר בענין הצעות רכש חלה על הצעת הרכש המיוחדת` FALSE

-- A provision conflicts with the chapter: it does not apply to the special tender offer.
#ASSERT NOT (`האם הוראה של דין אחר בענין הצעות רכש חלה על הצעת הרכש המיוחדת` TRUE)

-- A special tender offer was made, the board gave its opinion and disclosed every director's interest: the duty is done.
#ASSERT `האם הדירקטוריון של חברת המטרה מילא את חובתו למסור לניצעים חוות דעת ולגלות עניין אישי` TRUE TRUE FALSE FALSE TRUE EQUALS `החובה חלה וקויימה`

-- The board could not give an opinion, reported why and disclosed the interests: the duty is done.
#ASSERT `האם הדירקטוריון של חברת המטרה מילא את חובתו למסור לניצעים חוות דעת ולגלות עניין אישי` TRUE FALSE TRUE TRUE TRUE EQUALS `החובה חלה וקויימה`

-- The board could not give an opinion and did not report why: not done.
#ASSERT `האם הדירקטוריון של חברת המטרה מילא את חובתו למסור לניצעים חוות דעת ולגלות עניין אישי` TRUE FALSE TRUE FALSE TRUE EQUALS `החובה חלה וטרם קויימה`

-- The board gave its opinion but disclosed no personal interest: not done.
#ASSERT `האם הדירקטוריון של חברת המטרה מילא את חובתו למסור לניצעים חוות דעת ולגלות עניין אישי` TRUE TRUE FALSE FALSE FALSE EQUALS `החובה חלה וטרם קויימה`

-- No special tender offer was made: the duty has not arisen.
#ASSERT `האם הדירקטוריון של חברת המטרה מילא את חובתו למסור לניצעים חוות דעת ולגלות עניין אישי` FALSE FALSE FALSE FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- I am a director and I took steps to frustrate the offer, not in good faith: I am liable for the damage.
#ASSERT `האם אני, כנושא משרה בחברת המטרה, אחראי לנזקי המציע והניצעים בשל פעולה שנועדה להכשיל את הצעת הרכש` `דירקטור` TRUE FALSE FALSE FALSE

-- I am a director, acted in good faith and had a reasonable basis to believe the step served the company: not liable.
#ASSERT NOT (`האם אני, כנושא משרה בחברת המטרה, אחראי לנזקי המציע והניצעים בשל פעולה שנועדה להכשיל את הצעת הרכש` `דירקטור` TRUE FALSE TRUE TRUE)

-- I acted in good faith but had no reasonable basis: both are needed to be free, so I am liable.
#ASSERT `האם אני, כנושא משרה בחברת המטרה, אחראי לנזקי המציע והניצעים בשל פעולה שנועדה להכשיל את הצעת הרכש` `דירקטור` TRUE FALSE TRUE FALSE

-- The act was only negotiation with the offeror on improving the offer: section 330(b) allows it, no liability.
#ASSERT NOT (`האם אני, כנושא משרה בחברת המטרה, אחראי לנזקי המציע והניצעים בשל פעולה שנועדה להכשיל את הצעת הרכש` `דירקטור` TRUE TRUE FALSE FALSE)

-- I did nothing to frustrate the offer: no liability.
#ASSERT NOT (`האם אני, כנושא משרה בחברת המטרה, אחראי לנזקי המציע והניצעים בשל פעולה שנועדה להכשיל את הצעת הרכש` `דירקטור` FALSE FALSE FALSE FALSE)

-- My position is not an office of an office-holder: section 330(a) speaks of office-holders.
#ASSERT NOT (`האם אני, כנושא משרה בחברת המטרה, אחראי לנזקי המציע והניצעים בשל פעולה שנועדה להכשיל את הצעת הרכש` `משרה אחרת` TRUE FALSE FALSE FALSE)

-- I am a director negotiating with the offeror to improve the terms: allowed.
#ASSERT `האם אני, כנושא משרה בחברת המטרה, רשאי לשאת ולתת עם המציע או עם אחרים` `דירקטור` TRUE FALSE

-- I am a general manager negotiating with others to form a competing offer: allowed.
#ASSERT `האם אני, כנושא משרה בחברת המטרה, רשאי לשאת ולתת עם המציע או עם אחרים` `מנהל כללי` FALSE TRUE

-- I am a director and I negotiate with nobody: nothing to allow.
#ASSERT NOT (`האם אני, כנושא משרה בחברת המטרה, רשאי לשאת ולתת עם המציע או עם אחרים` `דירקטור` FALSE FALSE)

-- I hold a position that is not an office-holder's: the subsection speaks of office-holders.
#ASSERT NOT (`האם אני, כנושא משרה בחברת המטרה, רשאי לשאת ולתת עם המציע או עם אחרים` `משרה אחרת` TRUE FALSE)

-- The offer was addressed to all the offerees: as required.
#ASSERT `האם הצעת הרכש המיוחדת הופנתה כנדרש לכלל הניצעים` TRUE

-- The offer was addressed to only some of the offerees: not as required.
#ASSERT NOT (`האם הצעת הרכש המיוחדת הופנתה כנדרש לכלל הניצעים` FALSE)

-- An ordinary small shareholder with no tie to the offeror and no interest in acceptance: my vote is counted.
#ASSERT `האם קולי נמנה במנין קולות הניצעים בהצעת הרכש המיוחדת` FALSE (1%) FALSE `קרבה אחרת` FALSE FALSE FALSE FALSE FALSE FALSE FALSE

-- I am a controlling shareholder in the offeror: my vote is not counted.
#ASSERT NOT (`האם קולי נמנה במנין קולות הניצעים בהצעת הרכש המיוחדת` TRUE (1%) FALSE `קרבה אחרת` FALSE FALSE FALSE FALSE FALSE FALSE FALSE)

-- I hold 25 percent of the voting rights in the target, a control block: not counted.
#ASSERT NOT (`האם קולי נמנה במנין קולות הניצעים בהצעת הרכש המיוחדת` FALSE (25%) FALSE `קרבה אחרת` FALSE FALSE FALSE FALSE FALSE FALSE FALSE)

-- I hold 24 percent: no control block, counted.
#ASSERT `האם קולי נמנה במנין קולות הניצעים בהצעת הרכש המיוחדת` FALSE (24%) FALSE `קרבה אחרת` FALSE FALSE FALSE FALSE FALSE FALSE FALSE

-- I vote on behalf of the offeror or a controlling shareholder in it: not counted.
#ASSERT NOT (`האם קולי נמנה במנין קולות הניצעים בהצעת הרכש המיוחדת` FALSE (1%) TRUE `קרבה אחרת` FALSE FALSE FALSE FALSE FALSE FALSE FALSE)

-- I am the spouse of a controlling shareholder in the offeror: not counted.
#ASSERT NOT (`האם קולי נמנה במנין קולות הניצעים בהצעת הרכש המיוחדת` FALSE (1%) FALSE `בן זוג` FALSE FALSE FALSE FALSE FALSE FALSE FALSE)

-- I am a corporation controlled by such a person: not counted.
#ASSERT NOT (`האם קולי נמנה במנין קולות הניצעים בהצעת הרכש המיוחדת` FALSE (1%) FALSE `קרבה אחרת` TRUE FALSE FALSE FALSE FALSE FALSE FALSE)

-- I have a personal interest in acceptance beyond holding shares: not counted.
#ASSERT NOT (`האם קולי נמנה במנין קולות הניצעים בהצעת הרכש המיוחדת` FALSE (1%) FALSE `קרבה אחרת` FALSE TRUE FALSE FALSE FALSE FALSE FALSE)

-- My interest in acceptance comes only from holding shares: that is no personal interest, counted.
#ASSERT `האם קולי נמנה במנין קולות הניצעים בהצעת הרכש המיוחדת` FALSE (1%) FALSE `קרבה אחרת` FALSE TRUE TRUE FALSE FALSE FALSE FALSE

-- A relative of mine has an interest beyond shares: a personal interest includes a relative's, not counted.
#ASSERT NOT (`האם קולי נמנה במנין קולות הניצעים בהצעת הרכש המיוחדת` FALSE (1%) FALSE `קרבה אחרת` FALSE FALSE FALSE TRUE FALSE FALSE FALSE)

-- A corporation in which I or my relative are interested has an interest beyond shares: not counted.
#ASSERT NOT (`האם קולי נמנה במנין קולות הניצעים בהצעת הרכש המיוחדת` FALSE (1%) FALSE `קרבה אחרת` FALSE FALSE FALSE FALSE FALSE TRUE FALSE)

-- 60 for and 40 against among those who stated a position, 5 percent of the voting rights bought: the offer is accepted.
#ASSERT `האם הצעת הרכש המיוחדת התקבלה` 60 40 20 (5%)

-- 50 for and 50 against: a tie is not a majority, the offer is not accepted.
#ASSERT NOT (`האם הצעת הרכש המיוחדת התקבלה` 50 50 0 (10%))

-- 51 for and 49 against but only 4 percent bought: below the 5 percent minimum, not accepted.
#ASSERT NOT (`האם הצעת הרכש המיוחדת התקבלה` 51 49 0 (4%))

-- Silent offerees do not count: 1 for and 0 against among those who stated a position is a majority, with 5 percent bought.
#ASSERT `האם הצעת הרכש המיוחדת התקבלה` 1 0 99 (5%)

-- The offer was accepted; I did not state a position; I consent 4 days after the last day to respond: in time.
#ASSERT `האם אני רשאי להסכים להצעת הרכש המיוחדת לאחר שהתקבלה` TRUE TRUE 4 FALSE 0

-- I consent on day 5: too late.
#ASSERT NOT (`האם אני רשאי להסכים להצעת הרכש המיוחדת לאחר שהתקבלה` TRUE TRUE 5 FALSE 0)

-- The Minister set 7 days and I consent on day 7: in time.
#ASSERT `האם אני רשאי להסכים להצעת הרכש המיוחדת לאחר שהתקבלה` TRUE TRUE 7 TRUE 7

-- The Minister set 7 days and I consent on day 8: too late.
#ASSERT NOT (`האם אני רשאי להסכים להצעת הרכש המיוחדת לאחר שהתקבלה` TRUE TRUE 8 TRUE 7)

-- The offer was not accepted: there is nothing to consent to late.
#ASSERT NOT (`האם אני רשאי להסכים להצעת הרכש המיוחדת לאחר שהתקבלה` FALSE TRUE 1 FALSE 0)

-- I had already consented: this subsection is for those who did not state a position or objected.
#ASSERT NOT (`האם אני רשאי להסכים להצעת הרכש המיוחדת לאחר שהתקבלה` TRUE FALSE 1 FALSE 0)

-- I bought shares contrary to the chapter and still hold them: they confer no rights and are dormant.
#ASSERT `האם מניות שרכשתי בניגוד לפרק הצעת הרכש המיוחדת אינן מקנות זכויות` TRUE TRUE

-- I bought them contrary to the chapter but no longer hold them: the dormancy lasts only while I hold them.
#ASSERT NOT (`האם מניות שרכשתי בניגוד לפרק הצעת הרכש המיוחדת אינן מקנות זכויות` TRUE FALSE)

-- I bought them lawfully: nothing is dormant.
#ASSERT NOT (`האם מניות שרכשתי בניגוד לפרק הצעת הרכש המיוחדת אינן מקנות זכויות` FALSE TRUE)

-- The rise came from a purchase under section 328: no cap, my shares carry all 30 percent.
#ASSERT `מהו שיעור זכויות ההצבעה המרבי שמניותיי מקנות לאחר העלייה בהחזקתי` TRUE TRUE TRUE (30%) EQUALS (30%)

-- A rise to 30 percent not by a purchase under section 328, no control-block holder before: the shares above 25 percent carry no votes, so 25 percent at most.
#ASSERT `מהו שיעור זכויות ההצבעה המרבי שמניותיי מקנות לאחר העלייה בהחזקתי` FALSE TRUE TRUE (30%) EQUALS (25%)

-- A rise to 50 percent where both limbs apply: the lower cap of 25 percent is taken (fork F9).
#ASSERT `מהו שיעור זכויות ההצבעה המרבי שמניותיי מקנות לאחר העלייה בהחזקתי` FALSE TRUE TRUE (50%) EQUALS (25%)

-- A control-block holder existed before and nobody else is over 45: a rise to 50 percent is capped at 45 percent.
#ASSERT `מהו שיעור זכויות ההצבעה המרבי שמניותיי מקנות לאחר העלייה בהחזקתי` FALSE FALSE TRUE (50%) EQUALS (45%)

-- A rise to exactly 45 percent where a control block already existed: not above 45, no cap.
#ASSERT `מהו שיעור זכויות ההצבעה המרבי שמניותיי מקנות לאחר העלייה בהחזקתי` FALSE FALSE TRUE (45%) EQUALS (45%)

-- A rise to 24 percent: below a control block, no cap.
#ASSERT `מהו שיעור זכויות ההצבעה המרבי שמניותיי מקנות לאחר העלייה בהחזקתי` FALSE TRUE TRUE (24%) EQUALS (24%)

-- Both a control-block holder and a holder over 45 existed before: neither limb applies, no cap.
#ASSERT `מהו שיעור זכויות ההצבעה המרבי שמניותיי מקנות לאחר העלייה בהחזקתי` FALSE FALSE FALSE (60%) EQUALS (60%)

-- Reporting to the company the shares that confer no voting rights (no number of days stated): the trigger has not happened, so the duty has not arisen.
#ASSERT `האם עלי לדווח לחברה על מניות שאינן מקנות זכויות הצבעה` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- Reporting to the company the shares that confer no voting rights (no number of days stated): the duty has arisen and is not done.
#ASSERT `האם עלי לדווח לחברה על מניות שאינן מקנות זכויות הצבעה` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- Reporting to the company the shares that confer no voting rights (no number of days stated): the duty has arisen and is done.
#ASSERT `האם עלי לדווח לחברה על מניות שאינן מקנות זכויות הצבעה` TRUE TRUE EQUALS `החובה חלה וקויימה`

-- The chapter's provisions were breached: that is a breach of a statutory duty toward the company's shareholders.
#ASSERT `האם הפרת הוראות פרק הצעת הרכש המיוחדת היא הפרת חובה חקוקה כלפי` TRUE

-- No provision was breached.
#ASSERT NOT (`האם הפרת הוראות פרק הצעת הרכש המיוחדת היא הפרת חובה חקוקה כלפי` FALSE)

-- A special tender offer was accepted 11 months ago; I made it and now propose a merger with the company: barred for a year.
#ASSERT `האם אסור לי להציע הצעת רכש נוספת או לבצע מיזוג עם החברה בתוך שנה מהצעת הרכש המיוחדת` TRUE TRUE TRUE FALSE 11

-- Twelve months have passed: the year is over, the bar is gone.
#ASSERT NOT (`האם אסור לי להציע הצעת רכש נוספת או לבצע מיזוג עם החברה בתוך שנה מהצעת הרכש המיוחדת` TRUE TRUE TRUE FALSE 12)

-- We undertook in the special tender offer to make the further offer: the bar does not apply.
#ASSERT NOT (`האם אסור לי להציע הצעת רכש נוספת או לבצע מיזוג עם החברה בתוך שנה מהצעת הרכש המיוחדת` TRUE TRUE TRUE TRUE 3)

-- The offer was not accepted: the bar does not arise.
#ASSERT NOT (`האם אסור לי להציע הצעת רכש נוספת או לבצע מיזוג עם החברה בתוך שנה מהצעת הרכש המיוחדת` FALSE TRUE TRUE FALSE 3)

-- I am a person unconnected to the offeror: the bar is on the offeror and his controller.
#ASSERT NOT (`האם אסור לי להציע הצעת רכש נוספת או לבצע מיזוג עם החברה בתוך שנה מהצעת הרכש המיוחדת` TRUE FALSE TRUE FALSE 3)

-- The act is neither a further tender offer nor a merger: the bar does not apply.
#ASSERT NOT (`האם אסור לי להציע הצעת רכש נוספת או לבצע מיזוג עם החברה בתוך שנה מהצעת הרכש המיוחדת` TRUE TRUE FALSE FALSE 3)

§§ `מכירה כפויה של מניות (סעיפים 336 עד 342)`

-- A listed public company: I would hold 91 percent after the purchase and there is no accepted full tender offer, so I may not buy.
#ASSERT `האם אסור לי לרכוש מניות כך שאחזיק למעלה מתשעים אחוזים אלא בהצעת רכש מלאה שהתקבלה` TRUE FALSE FALSE TRUE (91%) FALSE

-- I would hold exactly 90 percent: not more than 90, so no bar.
#ASSERT NOT (`האם אסור לי לרכוש מניות כך שאחזיק למעלה מתשעים אחוזים אלא בהצעת רכש מלאה שהתקבלה` TRUE FALSE FALSE TRUE (90%) FALSE)

-- I would hold 91 percent but by a full tender offer that was accepted: allowed.
#ASSERT NOT (`האם אסור לי לרכוש מניות כך שאחזיק למעלה מתשעים אחוזים אלא בהצעת רכש מלאה שהתקבלה` TRUE FALSE FALSE TRUE (91%) TRUE)

-- A private company: the chapter does not apply to it.
#ASSERT NOT (`האם אסור לי לרכוש מניות כך שאחזיק למעלה מתשעים אחוזים אלא בהצעת רכש מלאה שהתקבלה` FALSE FALSE FALSE FALSE (95%) FALSE)

-- A public company; I hold 95 percent now and held 0 on 1 February 2000: I may not buy more.
#ASSERT `האם אני רשאי לרכוש מניות נוספות כשאני מחזיק למעלה מתשעים אחוזים` TRUE FALSE FALSE TRUE (95%) (0%) TRUE (10%) EQUALS `אסור לרכוש מניות נוספות`

-- I held 91 percent on 1 February 2000 and offer for all the shares; non-responders hold 49 percent of the issued capital: allowed under subsection (c).
#ASSERT `האם אני רשאי לרכוש מניות נוספות כשאני מחזיק למעלה מתשעים אחוזים` TRUE FALSE FALSE TRUE (95%) (91%) TRUE (49%) EQUALS `מותר לרכוש בהצעת רכש מלאה שהתקבלה כאמור בסעיף 336(ג)`

-- As above with non-responders holding exactly 50 percent: not less than half, so not allowed.
#ASSERT `האם אני רשאי לרכוש מניות נוספות כשאני מחזיק למעלה מתשעים אחוזים` TRUE FALSE FALSE TRUE (95%) (91%) TRUE (50%) EQUALS `אסור לרכוש מניות נוספות`

-- I held exactly 90 percent on that day: not above 90, I am not an old holder.
#ASSERT `האם אני רשאי לרכוש מניות נוספות כשאני מחזיק למעלה מתשעים אחוזים` TRUE FALSE FALSE TRUE (95%) (90%) TRUE (10%) EQUALS `אסור לרכוש מניות נוספות`

-- I hold exactly 90 percent now: subsection (b) does not apply.
#ASSERT `האם אני רשאי לרכוש מניות נוספות כשאני מחזיק למעלה מתשעים אחוזים` TRUE FALSE FALSE TRUE (90%) (0%) FALSE (0%) EQUALS `סעיף 336(ב) אינו חל`

-- A private company: subsection (b) does not apply.
#ASSERT `האם אני רשאי לרכוש מניות נוספות כשאני מחזיק למעלה מתשעים אחוזים` FALSE FALSE FALSE FALSE (95%) (0%) FALSE (0%) EQUALS `סעיף 336(ב) אינו חל`

-- Non-responders hold 3 percent, 6 of 10 disinterested offerees responded: more than half, the offer is accepted.
#ASSERT `האם הצעת הרכש המלאה התקבלה וכלל המניות שביקש המציע לרכוש יעברו לבעלותו` (3%) 10 6

-- Non-responders hold 3 percent, 5 of 10 responded: exactly half is not more than half, and 3 percent is not under 2: not accepted.
#ASSERT NOT (`האם הצעת הרכש המלאה התקבלה וכלל המניות שביקש המציע לרכוש יעברו לבעלותו` (3%) 10 5)

-- Non-responders hold exactly 5 percent: not under 5, so the first route is closed: not accepted.
#ASSERT NOT (`האם הצעת הרכש המלאה התקבלה וכלל המניות שביקש המציע לרכוש יעברו לבעלותו` (5%) 10 9)

-- Non-responders hold 1 percent: under 2 percent the offer is accepted whatever the count.
#ASSERT `האם הצעת הרכש המלאה התקבלה וכלל המניות שביקש המציע לרכוש יעברו לבעלותו` (1%) 10 0

-- Non-responders hold exactly 2 percent and nobody responded: not under 2, not accepted.
#ASSERT NOT (`האם הצעת הרכש המלאה התקבלה וכלל המניות שביקש המציע לרכוש יעברו לבעלותו` (2%) 10 0)

-- The offer was not accepted and I would hold 91 percent after buying from those who responded: I may not.
#ASSERT `האם אסור לי כמציע לרכוש מניצעים שנענו מניות שיקנו לי למעלה מתשעים אחוזים` FALSE (91%)

-- As above with exactly 90 percent: allowed.
#ASSERT NOT (`האם אסור לי כמציע לרכוש מניצעים שנענו מניות שיקנו לי למעלה מתשעים אחוזים` FALSE (90%))

-- The offer was accepted: the bar is not for me.
#ASSERT NOT (`האם אסור לי כמציע לרכוש מניצעים שנענו מניות שיקנו לי למעלה מתשעים אחוזים` TRUE (95%))

-- I was an offeree; the offer was accepted under section 337 five months ago: I may ask the court for the fair value.
#ASSERT `האם אני רשאי לבקש מבית המשפט לקבוע את השווי ההוגן של מניותיי` FALSE TRUE 5 FALSE FALSE FALSE

-- Exactly six months: still inside.
#ASSERT `האם אני רשאי לבקש מבית המשפט לקבוע את השווי ההוגן של מניותיי` FALSE TRUE 6 FALSE FALSE FALSE

-- Seven months: out of time.
#ASSERT NOT (`האם אני רשאי לבקש מבית המשפט לקבוע את השווי ההוגן של מניותיי` FALSE TRUE 7 FALSE FALSE FALSE)

-- The offer was not accepted under either route: no request.
#ASSERT NOT (`האם אני רשאי לבקש מבית המשפט לקבוע את השווי ההוגן של מניותיי` FALSE FALSE 3 FALSE FALSE FALSE)

-- Accepted under subsection 336(c) only; I responded and the terms bar relief: the bar is only for offers accepted under section 337, so I may ask.
#ASSERT `האם אני רשאי לבקש מבית המשפט לקבוע את השווי ההוגן של מניותיי` TRUE FALSE 2 TRUE TRUE TRUE

-- Accepted under section 337, I responded, the terms bar relief and the information was published: no relief.
#ASSERT NOT (`האם אני רשאי לבקש מבית המשפט לקבוע את השווי ההוגן של מניותיי` FALSE TRUE 3 TRUE TRUE TRUE)

-- As above but the information was not published before the date to respond: the bar has no validity, I may ask.
#ASSERT `האם אני רשאי לבקש מבית המשפט לקבוע את השווי ההוגן של מניותיי` FALSE TRUE 3 TRUE TRUE FALSE

-- A full tender offer was accepted and the offeror also offered to buy all the company's securities: sections 337 and 338 apply to the other securities too.
#ASSERT `האם סעיפים 337 ו־338 חלים גם על הצעת הרכש לניירות הערך האחרים של החברה` TRUE TRUE

-- The offeror did not offer for the other securities: they are not covered.
#ASSERT NOT (`האם סעיפים 337 ו־338 חלים גם על הצעת הרכש לניירות הערך האחרים של החברה` TRUE FALSE)

-- A full tender offer was accepted and it was for the company's only class of shares: the company becomes private.
#ASSERT `האם החברה שלי הופכת לחברה פרטית` TRUE TRUE FALSE

-- It was for each of the classes held by the public: the company becomes private.
#ASSERT `האם החברה שלי הופכת לחברה פרטית` TRUE FALSE TRUE

-- It was for neither: the company stays public.
#ASSERT NOT (`האם החברה שלי הופכת לחברה פרטית` TRUE FALSE FALSE)

-- No full tender offer was accepted: no change.
#ASSERT NOT (`האם החברה שלי הופכת לחברה פרטית` FALSE TRUE TRUE)

-- I bought shares contrary to the forced-sale chapter and still hold them: they confer no rights.
#ASSERT `האם מניות שרכשתי בניגוד לפרק המכירה הכפויה אינן מקנות זכויות` TRUE TRUE

-- I no longer hold them: dormant only while held.
#ASSERT NOT (`האם מניות שרכשתי בניגוד לפרק המכירה הכפויה אינן מקנות זכויות` TRUE FALSE)

-- The forced-sale chapter's provisions were breached: a breach of a statutory duty toward the shareholders.
#ASSERT `האם הפרת הוראות פרק המכירה הכפויה היא הפרת חובה חקוקה כלפי` TRUE

-- No provision was breached.
#ASSERT NOT (`האם הפרת הוראות פרק המכירה הכפויה היא הפרת חובה חקוקה כלפי` FALSE)

§§ `סמכות לרכוש מניותיהם של בעלי מניות מתנגדים בחברה פרטית (סעיפים 341 ו־342)`

-- A company incorporated after the Law with no rate in its articles: eighty percent.
#ASSERT `מהו שיעור ההסכמה הנדרש כדי שהמציע יוכל לחייב את בעלי המניות המתנגדים למכור` FALSE FALSE (0%) FALSE EQUALS (80%)

-- A company incorporated before the Law with no rate in its articles: ninety percent (section 342).
#ASSERT `מהו שיעור ההסכמה הנדרש כדי שהמציע יוכל לחייב את בעלי המניות המתנגדים למכור` TRUE FALSE (0%) FALSE EQUALS (90%)

-- The articles fix 85 percent by a change validly made: 85 percent.
#ASSERT `מהו שיעור ההסכמה הנדרש כדי שהמציע יוכל לחייב את בעלי המניות המתנגדים למכור` FALSE TRUE (85%) TRUE EQUALS (85%)

-- The articles fix 85 percent but the change was not validly made: back to the eighty percent of the Law.
#ASSERT `מהו שיעור ההסכמה הנדרש כדי שהמציע יוכל לחייב את בעלי המניות המתנגדים למכור` FALSE TRUE (85%) FALSE EQUALS (80%)

-- An old company reduces the deemed ninety to 70 percent by a valid change: 70 percent.
#ASSERT `מהו שיעור ההסכמה הנדרש כדי שהמציע יוכל לחייב את בעלי המניות המתנגדים למכור` TRUE TRUE (70%) TRUE EQUALS (70%)

-- An old company's reduction to 70 percent was not validly made: the deemed ninety stays.
#ASSERT `מהו שיעור ההסכמה הנדרש כדי שהמציע יוכל לחייב את בעלי המניות המתנגדים למכור` TRUE TRUE (70%) FALSE EQUALS (90%)

-- Holders of 80 percent agreed within two months and the offeror notified within the next month: he may notify me.
#ASSERT `האם המציע רשאי להודיע לי, כבעל מניה שלא הסכים, שברצונו לרכוש את מניותיי` (80%) (80%) 2 1

-- Only 79 percent agreed: below the eighty percent.
#ASSERT NOT (`האם המציע רשאי להודיע לי, כבעל מניה שלא הסכים, שברצונו לרכוש את מניותיי` (79%) (80%) 2 1)

-- They agreed in the third month: out of time.
#ASSERT NOT (`האם המציע רשאי להודיע לי, כבעל מניה שלא הסכים, שברצונו לרכוש את מניותיי` (80%) (80%) 3 1)

-- The offeror notified two months after the first two: out of time.
#ASSERT NOT (`האם המציע רשאי להודיע לי, כבעל מניה שלא הסכים, שברצונו לרכוש את מניותיי` (80%) (80%) 2 2)

-- The articles require 90 percent and 90 percent agreed: he may notify me.
#ASSERT `האם המציע רשאי להודיע לי, כבעל מניה שלא הסכים, שברצונו לרכוש את מניותיי` (90%) (90%) 1 0

-- The offeror notified me and the court decided nothing else: I must sell and he must buy.
#ASSERT `האם עלי למכור את מניותיי למציע והאם הוא חייב לרכוש אותן` TRUE FALSE

-- The court decided otherwise at my request: I need not sell.
#ASSERT NOT (`האם עלי למכור את מניותיי למציע והאם הוא חייב לרכוש אותן` TRUE TRUE)

-- The offeror has not notified me: no duty.
#ASSERT NOT (`האם עלי למכור את מניותיי למציע והאם הוא חייב לרכוש אותן` FALSE FALSE)

-- The offeror notified me; I ask the court within a month: I may.
#ASSERT `האם אני רשאי לבקש מבית המשפט להחליט אחרת` TRUE 1

-- I ask in the second month: too late.
#ASSERT NOT (`האם אני רשאי לבקש מבית המשפט להחליט אחרת` TRUE 2)

-- The offeror has not notified me: nothing to ask about.
#ASSERT NOT (`האם אני רשאי לבקש מבית המשפט להחליט אחרת` FALSE 0)

-- A month passed since the notice, no decision otherwise, no request pending, and the offeror has not yet sent the notice and paid: the duty is open.
#ASSERT `האם המציע חייב לשלוח לחברה את ההודעה ולהעביר לה את התמורה בעד מניותיי` TRUE TRUE FALSE FALSE EQUALS `החובה חלה וטרם קויימה`

-- The offeror sent the notice and transferred the price: done.
#ASSERT `האם המציע חייב לשלוח לחברה את ההודעה ולהעביר לה את התמורה בעד מניותיי` TRUE TRUE FALSE TRUE EQUALS `החובה חלה וקויימה`

-- Less than a month has passed: the duty has not arisen.
#ASSERT `האם המציע חייב לשלוח לחברה את ההודעה ולהעביר לה את התמורה בעד מניותיי` TRUE FALSE FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- A dissenting shareholder's request is pending: the duty waits for the court.
#ASSERT `האם המציע חייב לשלוח לחברה את ההודעה ולהעביר לה את התמורה בעד מניותיי` TRUE TRUE TRUE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- The offeror never notified: no duty.
#ASSERT `האם המציע חייב לשלוח לחברה את ההודעה ולהעביר לה את התמורה בעד מניותיי` FALSE TRUE FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- The company registering the offeror as the holder (no time limit stated): the trigger has not happened, so the duty has not arisen.
#ASSERT `האם על החברה לרשום את המציע כבעל המניות` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- The company registering the offeror as the holder (no time limit stated): the duty has arisen and is not done.
#ASSERT `האם על החברה לרשום את המציע כבעל המניות` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- The company registering the offeror as the holder (no time limit stated): the duty has arisen and is done.
#ASSERT `האם על החברה לרשום את המציע כבעל המניות` TRUE TRUE EQUALS `החובה חלה וקויימה`

§§ `פירוק: הוראות כלליות והחלטה מיוחדת (סעיפים 342ב עד 342ד)`

-- 75 for and 25 against, invitation 21 days before, the agenda held the proposal: a special resolution.
#ASSERT `האם ההחלטה שהתקבלה באסיפה הכללית היא החלטה מיוחדת` 75 25 0 21 FALSE TRUE

-- 74 for and 26 against: below three quarters.
#ASSERT NOT (`האם ההחלטה שהתקבלה באסיפה הכללית היא החלטה מיוחדת` 74 26 0 21 FALSE TRUE)

-- Invitation delivered 20 days before: too close without the consent of all.
#ASSERT NOT (`האם ההחלטה שהתקבלה באסיפה הכללית היא החלטה מיוחדת` 75 25 0 20 FALSE TRUE)

-- Invitation 20 days before but all the shareholders agreed to the closer time: a special resolution.
#ASSERT `האם ההחלטה שהתקבלה באסיפה הכללית היא החלטה מיוחדת` 75 25 0 20 TRUE TRUE

-- The agenda did not hold a proposal to dissolve under Part 8A: not a special resolution.
#ASSERT NOT (`האם ההחלטה שהתקבלה באסיפה הכללית היא החלטה מיוחדת` 75 25 0 21 FALSE FALSE)

-- Abstentions are not counted: 75 for, 25 against and 100 abstaining is still three quarters.
#ASSERT `האם ההחלטה שהתקבלה באסיפה הכללית היא החלטה מיוחדת` 75 25 100 21 FALSE TRUE

-- Nobody voted for or against: no majority.
#ASSERT NOT (`האם ההחלטה שהתקבלה באסיפה הכללית היא החלטה מיוחדת` 0 0 5 21 FALSE TRUE)

-- Insolvency proceedings are under way for my company: dissolution proceedings may not begin for it.
#ASSERT `האם אסור להתחיל בהליכי פירוק של חברתי כשמתנהלים לגביה הליכי חדלות פירעון` TRUE

-- No insolvency proceedings are under way: no bar.
#ASSERT NOT (`האם אסור להתחיל בהליכי פירוק של חברתי כשמתנהלים לגביה הליכי חדלות פירעון` FALSE)

-- Dissolution by a court began and the court found the company insolvent: it may stop the dissolution and continue under the Insolvency Law.
#ASSERT `האם בית המשפט רשאי להורות על הפסקת הליכי הפירוק של חברתי והמשכם לפי חוק חדלות פירעון` TRUE TRUE

-- The court did not find the company insolvent: it may not on this ground.
#ASSERT NOT (`האם בית המשפט רשאי להורות על הפסקת הליכי הפירוק של חברתי והמשכם לפי חוק חדלות פירעון` TRUE FALSE)

-- Dissolution by a court has not begun: nothing to stop.
#ASSERT NOT (`האם בית המשפט רשאי להורות על הפסקת הליכי הפירוק של חברתי והמשכם לפי חוק חדלות פירעון` FALSE TRUE)

-- A voluntary dissolution has begun, the trustee found the company insolvent and has not told the shareholders and creditors: the duty is open.
#ASSERT `האם הנאמן חייב להודיע לי, כבעל מניות, שהחברה נמצאת בחדלות פירעון` TRUE TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- The trustee told them: done.
#ASSERT `האם הנאמן חייב להודיע לי, כבעל מניות, שהחברה נמצאת בחדלות פירעון` TRUE TRUE TRUE EQUALS `החובה חלה וקויימה`

-- The trustee found the company solvent: no duty to tell.
#ASSERT `האם הנאמן חייב להודיע לי, כבעל מניות, שהחברה נמצאת בחדלות פירעון` TRUE FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- No voluntary dissolution has begun: no duty.
#ASSERT `האם הנאמן חייב להודיע לי, כבעל מניות, שהחברה נמצאת בחדלות פירעון` FALSE TRUE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- A voluntary dissolution began, the trustee found the company insolvent, the conditions for an application are met and he has not filed: his duty is open.
#ASSERT `האם הנאמן חייב להגיש בשם חברתי בקשה לצו לפתיחת הליכי חדלות פירעון` TRUE TRUE TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- He filed in the company's name: done.
#ASSERT `האם הנאמן חייב להגיש בשם חברתי בקשה לצו לפתיחת הליכי חדלות פירעון` TRUE TRUE TRUE TRUE EQUALS `החובה חלה וקויימה`

-- The conditions for an application are not met: no duty to file.
#ASSERT `האם הנאמן חייב להגיש בשם חברתי בקשה לצו לפתיחת הליכי חדלות פירעון` TRUE TRUE FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- The trustee found the company solvent: no duty.
#ASSERT `האם הנאמן חייב להגיש בשם חברתי בקשה לצו לפתיחת הליכי חדלות פירעון` TRUE FALSE TRUE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- Insolvency proceedings were opened after dissolution proceedings began: the court orders the dissolution ended and the insolvency proceedings continued.
#ASSERT `האם בית המשפט יורה על סיום הליכי הפירוק של חברתי כשנפתחו הליכי חדלות פירעון` TRUE

-- No insolvency proceedings were opened: no such order.
#ASSERT NOT (`האם בית המשפט יורה על סיום הליכי הפירוק של חברתי כשנפתחו הליכי חדלות פירעון` FALSE)

§§ `פירוק בידי בית המשפט: הבקשה, ההתנגדות והצו (סעיפים 342ה עד 342יג)`

-- My company is registered in the area of this district court: it is competent.
#ASSERT `האם בית המשפט המחוזי הזה מוסמך לפרק את חברתי` TRUE FALSE FALSE

-- Its main place of business is in the area: competent.
#ASSERT `האם בית המשפט המחוזי הזה מוסמך לפרק את חברתי` FALSE TRUE FALSE

-- Its assets are in the area: competent.
#ASSERT `האם בית המשפט המחוזי הזה מוסמך לפרק את חברתי` FALSE FALSE TRUE

-- None of the three is in the area: not competent.
#ASSERT NOT (`האם בית המשפט המחוזי הזה מוסמך לפרק את חברתי` FALSE FALSE FALSE)

-- Twelve months since registration and the company never began business: a ground.
#ASSERT `האם קיימת עילה לפירוק חברתי בידי בית המשפט` FALSE 12 FALSE 0 FALSE

-- Eleven months: not yet a year.
#ASSERT NOT (`האם קיימת עילה לפירוק חברתי בידי בית המשפט` FALSE 11 FALSE 0 FALSE)

-- Twelve months since registration but the company began business within the year: no ground.
#ASSERT NOT (`האם קיימת עילה לפירוק חברתי בידי בית המשפט` FALSE 12 TRUE 0 FALSE)

-- The company stopped its business 12 months ago: a ground.
#ASSERT `האם קיימת עילה לפירוק חברתי בידי בית המשפט` FALSE 24 TRUE 12 FALSE

-- It stopped 11 months ago: not yet a year.
#ASSERT NOT (`האם קיימת עילה לפירוק חברתי בידי בית המשפט` FALSE 24 TRUE 11 FALSE)

-- The company passed a special resolution to dissolve by a court: a ground.
#ASSERT `האם קיימת עילה לפירוק חברתי בידי בית המשפט` TRUE 1 TRUE 0 FALSE

-- The court found it just and equitable: a ground.
#ASSERT `האם קיימת עילה לפירוק חברתי בידי בית המשפט` FALSE 1 TRUE 0 TRUE

-- None of the three: no ground.
#ASSERT NOT (`האם קיימת עילה לפירוק חברתי בידי בית המשפט` FALSE 1 TRUE 0 FALSE)

-- I am the company asking for its own dissolution: I may apply.
#ASSERT `האם אני רשאי להגיש לבית המשפט בקשה לצו פירוק` `החברה המבקשת את פירוקה` FALSE

-- I am a shareholder asking for the company's dissolution: I may apply.
#ASSERT `האם אני רשאי להגיש לבית המשפט בקשה לצו פירוק` `בעל מניה המבקש את פירוק החברה` FALSE

-- I am the Attorney General and I thought it just and equitable: I may apply.
#ASSERT `האם אני רשאי להגיש לבית המשפט בקשה לצו פירוק` `היועץ המשפטי לממשלה` TRUE

-- I am the Attorney General and I did not think so: I may not.
#ASSERT NOT (`האם אני רשאי להגיש לבית המשפט בקשה לצו פירוק` `היועץ המשפטי לממשלה` FALSE)

-- I am another person: the section lists no right for me.
#ASSERT NOT (`האם אני רשאי להגיש לבית המשפט בקשה לצו פירוק` `אדם אחר המבקש את פירוק החברה` TRUE)

-- The application was filed as the Minister prescribed with the particulars, an affidavit and the further documents: filed as required.
#ASSERT `האם בקשתי לצו פירוק הוגשה כנדרש` TRUE TRUE TRUE

-- No affidavit verifying the facts: not as required.
#ASSERT NOT (`האם בקשתי לצו פירוק הוגשה כנדרש` TRUE FALSE TRUE)

-- The Minister's further documents were not attached: not as required.
#ASSERT NOT (`האם בקשתי לצו פירוק הוגשה כנדרש` TRUE TRUE FALSE)

-- Not filed in the way or with the particulars the Minister prescribed: not as required.
#ASSERT NOT (`האם בקשתי לצו פירוק הוגשה כנדרש` FALSE TRUE TRUE)

-- Publishing a public notice of the application (the Minister sets the time): the trigger has not happened, so the duty has not arisen.
#ASSERT `האם עלי, כמבקש צו פירוק, לפרסם הודעה לציבור על הגשת הבקשה` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- Publishing a public notice of the application (the Minister sets the time): the duty has arisen and is not done.
#ASSERT `האם עלי, כמבקש צו פירוק, לפרסם הודעה לציבור על הגשת הבקשה` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- Publishing a public notice of the application (the Minister sets the time): the duty has arisen and is done.
#ASSERT `האם עלי, כמבקש צו פירוק, לפרסם הודעה לציבור על הגשת הבקשה` TRUE TRUE EQUALS `החובה חלה וקויימה`

-- Sending the company a copy of the application immediately after filing: the trigger has not happened, so the duty has not arisen.
#ASSERT `האם עלי לשלוח עותק מהבקשה לחברה` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- Sending the company a copy of the application immediately after filing: the duty has arisen and is not done.
#ASSERT `האם עלי לשלוח עותק מהבקשה לחברה` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- Sending the company a copy of the application immediately after filing: the duty has arisen and is done.
#ASSERT `האם עלי לשלוח עותק מהבקשה לחברה` TRUE TRUE EQUALS `החובה חלה וקויימה`

-- I may be harmed by the winding-up order: I may receive a copy of the application.
#ASSERT `האם אני רשאי לקבל מהמבקש עותק מהבקשה לצו פירוק` TRUE

-- I cannot be harmed by the order: no such right.
#ASSERT NOT (`האם אני רשאי לקבל מהמבקש עותק מהבקשה לצו פירוק` FALSE)

-- I may be harmed by the winding-up order: I may file an objection.
#ASSERT `האם אני רשאי להגיש לבית המשפט התנגדות לבקשה לצו פירוק` TRUE

-- I cannot be harmed by the order: no such right.
#ASSERT NOT (`האם אני רשאי להגיש לבית המשפט התנגדות לבקשה לצו פירוק` FALSE)

-- The court found a ground for dissolution under section 342ו: it may issue a winding-up order.
#ASSERT `האם בית המשפט רשאי לתת צו פירוק לגבי חברתי` TRUE

-- No ground was found: it may not.
#ASSERT NOT (`האם בית המשפט רשאי לתת צו פירוק לגבי חברתי` FALSE)

-- A winding-up order was issued and the court has not yet appointed a trustee: its duty is open.
#ASSERT `האם בית המשפט חייב למנות נאמן לאחר מתן צו הפירוק` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- The court appointed a trustee: done.
#ASSERT `האם בית המשפט חייב למנות נאמן לאחר מתן צו הפירוק` TRUE TRUE EQUALS `החובה חלה וקויימה`

-- No winding-up order has been issued: no duty to appoint.
#ASSERT `האם בית המשפט חייב למנות נאמן לאחר מתן צו הפירוק` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- A winding-up order was issued and a creditor sues the company in a frozen kind of proceeding: it is frozen.
#ASSERT `האם ההליך נגד חברתי מוקפא לאחר צו הפירוק` TRUE `הליך מהסוגים המוקפאים לפי סעיף 29(1) ו־(3) עד (5) לחוק חדלות פירעון` FALSE

-- The court ordered otherwise as to this proceeding: not frozen.
#ASSERT NOT (`האם ההליך נגד חברתי מוקפא לאחר צו הפירוק` TRUE `הליך מהסוגים המוקפאים לפי סעיף 29(1) ו־(3) עד (5) לחוק חדלות פירעון` TRUE)

-- A secured creditor realises a fixed-charge asset made before the order: not delayed.
#ASSERT NOT (`האם ההליך נגד חברתי מוקפא לאחר צו הפירוק` TRUE `מימוש נכס המשועבד בשעבוד קבוע שנעשה להבטחת פירעון חובות החברה לפני מתן הצו` FALSE)

-- A floating charge made before the order crystallises: not delayed.
#ASSERT NOT (`האם ההליך נגד חברתי מוקפא לאחר צו הפירוק` TRUE `גיבוש שעבוד צף שנעשה להבטחת פירעון חובות החברה לפני מתן הצו` FALSE)

-- An asset under retention of title goes back to its owner: not delayed.
#ASSERT NOT (`האם ההליך נגד חברתי מוקפא לאחר צו הפירוק` TRUE `העברת חזקה בנכס הכפוף לשיור בעלות מהחברה לבעל הנכס` FALSE)

-- Another kind of proceeding: the subsection freezes only the listed kinds.
#ASSERT NOT (`האם ההליך נגד חברתי מוקפא לאחר צו הפירוק` TRUE `הליך אחר` FALSE)

-- No winding-up order has been issued: nothing is frozen on this ground.
#ASSERT NOT (`האם ההליך נגד חברתי מוקפא לאחר צו הפירוק` FALSE `הליך מהסוגים המוקפאים לפי סעיף 29(1) ו־(3) עד (5) לחוק חדלות פירעון` FALSE)

§§ `פירוק בידי בית המשפט: הנאמן, היתרה והזכות לפנות לבית המשפט (סעיפים 342יד עד 342כג)`

-- The trustee sending the Registrar a copy of the winding-up order (no time limit stated): the trigger has not happened, so the duty has not arisen.
#ASSERT `האם הנאמן חייב לשלוח לרשם עותק מצו הפירוק של חברתי` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- The trustee sending the Registrar a copy of the winding-up order (no time limit stated): the duty has arisen and is not done.
#ASSERT `האם הנאמן חייב לשלוח לרשם עותק מצו הפירוק של חברתי` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- The trustee sending the Registrar a copy of the winding-up order (no time limit stated): the duty has arisen and is done.
#ASSERT `האם הנאמן חייב לשלוח לרשם עותק מצו הפירוק של חברתי` TRUE TRUE EQUALS `החובה חלה וקויימה`

-- The Registrar registering a note of the winding-up order: the trigger has not happened, so the duty has not arisen.
#ASSERT `האם הרשם חייב לרשום הערה על מתן צו הפירוק של חברתי` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- The Registrar registering a note of the winding-up order: the duty has arisen and is not done.
#ASSERT `האם הרשם חייב לרשום הערה על מתן צו הפירוק של חברתי` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- The Registrar registering a note of the winding-up order: the duty has arisen and is done.
#ASSERT `האם הרשם חייב לרשום הערה על מתן צו הפירוק של חברתי` TRUE TRUE EQUALS `החובה חלה וקויימה`

-- I am the company: I may propose candidates for trustee.
#ASSERT `האם אני רשאי להציע מועמדים לתפקיד הנאמן` TRUE FALSE FALSE

-- I am a shareholder: I may propose.
#ASSERT `האם אני רשאי להציע מועמדים לתפקיד הנאמן` FALSE TRUE FALSE

-- I am the Attorney General and I filed the application: I may propose.
#ASSERT `האם אני רשאי להציע מועמדים לתפקיד הנאמן` FALSE FALSE TRUE

-- I am none of those: I may not.
#ASSERT NOT (`האם אני רשאי להציע מועמדים לתפקיד הנאמן` FALSE FALSE FALSE)

-- No trustee has been appointed: the duty has not arisen.
#ASSERT `האם הנאמן מילא את חובתו לפעול במהירות האפשרית להשלמת הליכי הפירוק בידי בית המשפט` FALSE FALSE FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- A trustee was appointed and has done none of the three: the duty is open.
#ASSERT `האם הנאמן מילא את חובתו לפעול במהירות האפשרית להשלמת הליכי הפירוק בידי בית המשפט` TRUE FALSE FALSE FALSE EQUALS `החובה חלה וטרם קויימה`

-- He decided the proofs of debt and collected the assets but has not paid or distributed: still open.
#ASSERT `האם הנאמן מילא את חובתו לפעול במהירות האפשרית להשלמת הליכי הפירוק בידי בית המשפט` TRUE TRUE TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- He has done all three: done.
#ASSERT `האם הנאמן מילא את חובתו לפעול במהירות האפשרית להשלמת הליכי הפירוק בידי בית המשפט` TRUE TRUE TRUE TRUE EQUALS `החובה חלה וקויימה`

-- The trustee has not finished collecting and realising the assets: the duty to pay has not arisen.
#ASSERT `האם הנאמן מילא את חובתו לשלם את הוצאות הפירוק ואת חובות החברה לנושים` FALSE FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- The collection is complete and nothing is paid yet: the duty is open.
#ASSERT `האם הנאמן מילא את חובתו לשלם את הוצאות הפירוק ואת חובות החברה לנושים` TRUE FALSE FALSE EQUALS `החובה חלה וטרם קויימה`

-- He paid the expenses but not the approved debts: still open.
#ASSERT `האם הנאמן מילא את חובתו לשלם את הוצאות הפירוק ואת חובות החברה לנושים` TRUE TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- He paid both the expenses and the approved debts: done.
#ASSERT `האם הנאמן מילא את חובתו לשלם את הוצאות הפירוק ואת חובות החברה לנושים` TRUE TRUE TRUE EQUALS `החובה חלה וקויימה`

-- The trustee is not yet about to pay the debts: the duty to give notice has not arisen.
#ASSERT `האם הנאמן מילא את חובתו להודיע לפני תשלום החובות ולתת לי זמן לבסס את תביעת החוב שלי` FALSE FALSE FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- He is about to pay and has done none of the three things: open.
#ASSERT `האם הנאמן מילא את חובתו להודיע לפני תשלום החובות ולתת לי זמן לבסס את תביעת החוב שלי` TRUE FALSE FALSE FALSE EQUALS `החובה חלה וטרם קויימה`

-- He published the notice and told me but allotted no time to substantiate my claim: open.
#ASSERT `האם הנאמן מילא את חובתו להודיע לפני תשלום החובות ולתת לי זמן לבסס את תביעת החוב שלי` TRUE TRUE TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- He published the notice, told everyone with an undecided claim and allotted time: done.
#ASSERT `האם הנאמן מילא את חובתו להודיע לפני תשלום החובות ולתת לי זמן לבסס את תביעת החוב שלי` TRUE TRUE TRUE TRUE EQUALS `החובה חלה וקויימה`

-- The estate is worth 1,000, the expenses are 100 and the approved debts 400: the balance for the shareholders is 500.
#ASSERT `מהי היתרה שתחולק בין בעלי המניות בפירוק` 1000 100 400 EQUALS 500

-- The estate is worth 100 and the expenses and debts take it all and more: the balance is 0, not negative.
#ASSERT `מהי היתרה שתחולק בין בעלי המניות בפירוק` 100 100 400 EQUALS 0

-- The expenses and debts take exactly the whole estate: the balance is 0.
#ASSERT `מהי היתרה שתחולק בין בעלי המניות בפירוק` 1000 0 1000 EQUALS 0

-- A balance of 500 and I hold a quarter of the shareholders' rights: I receive 125.
#ASSERT `כמה אקבל מהיתרה בפירוק כבעל מניות` 1000 100 400 (25%) EQUALS 125

-- No balance: I receive nothing whatever my share.
#ASSERT `כמה אקבל מהיתרה בפירוק כבעל מניות` 100 100 400 (50%) EQUALS 0

-- I hold all the rights: I receive the whole balance of 500.
#ASSERT `כמה אקבל מהיתרה בפירוק כבעל מניות` 1000 100 400 (100%) EQUALS 500

-- With the court's approval, and the trustee thinks it would not harm the proper conduct of the dissolution: he may pay interim payments.
#ASSERT `האם הנאמן רשאי לשלם תשלומי ביניים בפירוק בידי בית המשפט` TRUE TRUE

-- Without the court's approval: he may not.
#ASSERT NOT (`האם הנאמן רשאי לשלם תשלומי ביניים בפירוק בידי בית המשפט` FALSE TRUE)

-- The trustee thinks it would harm the proper conduct: he may not.
#ASSERT NOT (`האם הנאמן רשאי לשלם תשלומי ביניים בפירוק בידי בית המשפט` TRUE FALSE)

-- I am a shareholder: I may apply to the court on a question about my rights.
#ASSERT `האם אני רשאי לפנות לבית המשפט בשאלה הנוגעת לזכויותיי בהליכי הפירוק` TRUE FALSE

-- I am a creditor: I may apply.
#ASSERT `האם אני רשאי לפנות לבית המשפט בשאלה הנוגעת לזכויותיי בהליכי הפירוק` FALSE TRUE

-- I am neither: the section gives me no right.
#ASSERT NOT (`האם אני רשאי לפנות לבית המשפט בשאלה הנוגעת לזכויותיי בהליכי הפירוק` FALSE FALSE)

-- A winding-up order was issued; I am the company or a shareholder; the court found no justification to go on: I may ask it to cancel the order.
#ASSERT `האם אני רשאי לבקש מבית המשפט לבטל את צו הפירוק` TRUE TRUE TRUE

-- The court did not find that the dissolution should stop: it may not.
#ASSERT NOT (`האם אני רשאי לבקש מבית המשפט לבטל את צו הפירוק` TRUE TRUE FALSE)

-- No winding-up order has been issued: nothing to cancel.
#ASSERT NOT (`האם אני רשאי לבקש מבית המשפט לבטל את צו הפירוק` FALSE TRUE TRUE)

-- I am neither the company nor a shareholder: I may not ask.
#ASSERT NOT (`האם אני רשאי לבקש מבית המשפט לבטל את צו הפירוק` TRUE FALSE TRUE)

-- An act was lawfully made before the winding-up order was cancelled: the cancellation leaves it valid.
#ASSERT `האם ביטול צו הפירוק אינו פוגע בתוקפה של פעולה שנעשתה לפניו` TRUE

-- The act was not lawfully made: the subsection protects only lawful acts.
#ASSERT NOT (`האם ביטול צו הפירוק אינו פוגע בתוקפה של פעולה שנעשתה לפניו` FALSE)

-- The trustee sending the Registrar a copy of the decision cancelling the winding-up order: the trigger has not happened, so the duty has not arisen.
#ASSERT `האם הנאמן חייב לשלוח לרשם עותק מההחלטה על ביטול צו הפירוק` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- The trustee sending the Registrar a copy of the decision cancelling the winding-up order: the duty has arisen and is not done.
#ASSERT `האם הנאמן חייב לשלוח לרשם עותק מההחלטה על ביטול צו הפירוק` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- The trustee sending the Registrar a copy of the decision cancelling the winding-up order: the duty has arisen and is done.
#ASSERT `האם הנאמן חייב לשלוח לרשם עותק מההחלטה על ביטול צו הפירוק` TRUE TRUE EQUALS `החובה חלה וקויימה`

-- The Registrar deleting the registration of the winding-up order: the trigger has not happened, so the duty has not arisen.
#ASSERT `האם הרשם חייב למחוק את הרישום על צו הפירוק לאחר ביטולו` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- The Registrar deleting the registration of the winding-up order: the duty has arisen and is not done.
#ASSERT `האם הרשם חייב למחוק את הרישום על צו הפירוק לאחר ביטולו` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- The Registrar deleting the registration of the winding-up order: the duty has arisen and is done.
#ASSERT `האם הרשם חייב למחוק את הרישום על צו הפירוק לאחר ביטולו` TRUE TRUE EQUALS `החובה חלה וקויימה`

-- The trustee giving the court and the shareholders a summary report (no time limit stated): the trigger has not happened, so the duty has not arisen.
#ASSERT `האם הנאמן חייב למסור לי, כבעל מניות, דוח מסכם של פעילותו` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- The trustee giving the court and the shareholders a summary report (no time limit stated): the duty has arisen and is not done.
#ASSERT `האם הנאמן חייב למסור לי, כבעל מניות, דוח מסכם של פעילותו` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- The trustee giving the court and the shareholders a summary report (no time limit stated): the duty has arisen and is done.
#ASSERT `האם הנאמן חייב למסור לי, כבעל מניות, דוח מסכם של פעילותו` TRUE TRUE EQUALS `החובה חלה וקויימה`

-- The court is satisfied that the dissolution is complete and gave a liquidation order: my company is liquidated from that day.
#ASSERT `האם חברתי מחוסלת מיום מתן צו החיסול` TRUE TRUE

-- The court is not yet satisfied that the dissolution is complete: not liquidated.
#ASSERT NOT (`האם חברתי מחוסלת מיום מתן צו החיסול` FALSE TRUE)

-- No liquidation order has been given: not liquidated.
#ASSERT NOT (`האם חברתי מחוסלת מיום מתן צו החיסול` TRUE FALSE)

-- The court directed that the documents be kept 7 years: the lowest period allowed.
#ASSERT `האם הוראת בית המשפט על מסמכי החברה לאחר החיסול שומרת אותם לתקופה הנדרשת` 7

-- The court directed 6 years: too short.
#ASSERT NOT (`האם הוראת בית המשפט על מסמכי החברה לאחר החיסול שומרת אותם לתקופה הנדרשת` 6)

-- The court directed 10 years: longer than the minimum is allowed.
#ASSERT `האם הוראת בית המשפט על מסמכי החברה לאחר החיסול שומרת אותם לתקופה הנדרשת` 10

-- The trustee sending the Registrar a copy of the liquidation order: the trigger has not happened, so the duty has not arisen.
#ASSERT `האם הנאמן חייב לשלוח לרשם עותק מצו החיסול` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- The trustee sending the Registrar a copy of the liquidation order: the duty has arisen and is not done.
#ASSERT `האם הנאמן חייב לשלוח לרשם עותק מצו החיסול` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- The trustee sending the Registrar a copy of the liquidation order: the duty has arisen and is done.
#ASSERT `האם הנאמן חייב לשלוח לרשם עותק מצו החיסול` TRUE TRUE EQUALS `החובה חלה וקויימה`

-- The Registrar registering the liquidation: the trigger has not happened, so the duty has not arisen.
#ASSERT `האם הרשם חייב לרשום את דבר חיסול חברתי` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- The Registrar registering the liquidation: the duty has arisen and is not done.
#ASSERT `האם הרשם חייב לרשום את דבר חיסול חברתי` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- The Registrar registering the liquidation: the duty has arisen and is done.
#ASSERT `האם הרשם חייב לרשום את דבר חיסול חברתי` TRUE TRUE EQUALS `החובה חלה וקויימה`

§§ `פירוק מרצון: ההחלטה, התצהיר והאסיפה (סעיפים 342כד עד 342כז)`

-- The directors gave a solvency affidavit: the general meeting may pass a special resolution on voluntary dissolution.
#ASSERT `האם אסיפת בעלי המניות של חברתי רשאית לקבל החלטה מיוחדת על פירוק מרצון` TRUE

-- No affidavit was given: the meeting may not.
#ASSERT NOT (`האם אסיפת בעלי המניות של חברתי רשאית לקבל החלטה מיוחדת על פירוק מרצון` FALSE)

-- The meeting passed a special resolution and the directors had given a solvency affidavit: valid.
#ASSERT `האם החלטת הפירוק מרצון שקיבלה חברתי בתוקף` TRUE TRUE

-- The meeting passed a special resolution but no affidavit was given: not valid.
#ASSERT NOT (`האם החלטת הפירוק מרצון שקיבלה חברתי בתוקף` TRUE FALSE)

-- The affidavit was given but no special resolution was passed: nothing valid yet.
#ASSERT NOT (`האם החלטת הפירוק מרצון שקיבלה חברתי בתוקף` FALSE TRUE)

-- All 5 directors gave it, declared a thorough examination, that the company can pay its debts in full within 12 months: given as the Law requires.
#ASSERT `האם תצהיר כושר הפירעון שנתנו הדירקטורים ניתן כדין` 5 5 TRUE TRUE 12

-- 3 of 5 directors gave it: most (more than half), as required.
#ASSERT `האם תצהיר כושר הפירעון שנתנו הדירקטורים ניתן כדין` 5 3 TRUE TRUE 12

-- 2 of 4 directors: exactly half is not most.
#ASSERT NOT (`האם תצהיר כושר הפירעון שנתנו הדירקטורים ניתן כדין` 4 2 TRUE TRUE 12)

-- The directors declared payment within 13 months: over the twelve allowed.
#ASSERT NOT (`האם תצהיר כושר הפירעון שנתנו הדירקטורים ניתן כדין` 5 5 TRUE TRUE 13)

-- They did not declare a thorough examination: not as required.
#ASSERT NOT (`האם תצהיר כושר הפירעון שנתנו הדירקטורים ניתן כדין` 5 5 FALSE TRUE 12)

-- They did not declare that the company can pay in full: not as required.
#ASSERT NOT (`האם תצהיר כושר הפירעון שנתנו הדירקטורים ניתן כדין` 5 5 TRUE FALSE 12)

-- The company has no directors: nobody can give the affidavit.
#ASSERT NOT (`האם תצהיר כושר הפירעון שנתנו הדירקטורים ניתן כדין` 0 0 TRUE TRUE 12)

-- Convening the general meeting within 90 days of giving the solvency affidavit: the event has not happened, so the duty has not arisen.
#ASSERT `האם חברתי עמדה במועד לכנס את האסיפה הכללית בתוך 90 ימים ממתן תצהיר כושר הפירעון` FALSE FALSE 0 EQUALS `החובה אינה חלה`

-- Convening the general meeting within 90 days of giving the solvency affidavit: done on day 90, the last day inside the limit.
#ASSERT `האם חברתי עמדה במועד לכנס את האסיפה הכללית בתוך 90 ימים ממתן תצהיר כושר הפירעון` TRUE TRUE 90 EQUALS `קויימה בתוך המועד`

-- Convening the general meeting within 90 days of giving the solvency affidavit: done on day 91, one day late.
#ASSERT `האם חברתי עמדה במועד לכנס את האסיפה הכללית בתוך 90 ימים ממתן תצהיר כושר הפירעון` TRUE TRUE 91 EQUALS `קויימה באיחור`

-- Convening the general meeting within 90 days of giving the solvency affidavit: not yet done, day 90, the limit has not yet run.
#ASSERT `האם חברתי עמדה במועד לכנס את האסיפה הכללית בתוך 90 ימים ממתן תצהיר כושר הפירעון` TRUE FALSE 90 EQUALS `טרם קויימה והמועד עדיין לא חלף`

-- Convening the general meeting within 90 days of giving the solvency affidavit: not yet done, day 91, the limit has run out.
#ASSERT `האם חברתי עמדה במועד לכנס את האסיפה הכללית בתוך 90 ימים ממתן תצהיר כושר הפירעון` TRUE FALSE 91 EQUALS `טרם קויימה והמועד חלף`

-- Attaching the solvency affidavit to the invitation to the general meeting: the trigger has not happened, so the duty has not arisen.
#ASSERT `האם עלינו לצרף את תצהיר כושר הפירעון להזמנה לאסיפה הכללית` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- Attaching the solvency affidavit to the invitation to the general meeting: the duty has arisen and is not done.
#ASSERT `האם עלינו לצרף את תצהיר כושר הפירעון להזמנה לאסיפה הכללית` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- Attaching the solvency affidavit to the invitation to the general meeting: the duty has arisen and is done.
#ASSERT `האם עלינו לצרף את תצהיר כושר הפירעון להזמנה לאסיפה הכללית` TRUE TRUE EQUALS `החובה חלה וקויימה`

-- The general meeting appointing a trustee: the trigger has not happened, so the duty has not arisen.
#ASSERT `האם האסיפה הכללית חייבת למנות נאמן לפירוק מרצון` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- The general meeting appointing a trustee: the duty has arisen and is not done.
#ASSERT `האם האסיפה הכללית חייבת למנות נאמן לפירוק מרצון` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- The general meeting appointing a trustee: the duty has arisen and is done.
#ASSERT `האם האסיפה הכללית חייבת למנות נאמן לפירוק מרצון` TRUE TRUE EQUALS `החובה חלה וקויימה`

-- The pay the meeting wants to fix does not bring the company to insolvency: it may fix it.
#ASSERT `האם האסיפה הכללית רשאית לקבוע את שכר הנאמן בסכום הזה` FALSE

-- The pay would bring the company to insolvency: it may not fix it.
#ASSERT NOT (`האם האסיפה הכללית רשאית לקבוע את שכר הנאמן בסכום הזה` TRUE)

§§ `פירוק מרצון: תחילת הפירוק, הודעות ורישום (סעיפים 342כח עד 342ל)`

-- The resolution was passed on 15 March 2026: the voluntary dissolution begins that day.
#ASSERT `באיזה יום מתחיל הפירוק מרצון של חברתי` 2026 3 15 EQUALS YMD 2026 3 15

-- The dissolution has begun and the act is not needed for the beneficial dissolution: the company may not go on with it.
#ASSERT NOT (`האם חברתי רשאית להמשיך בפעולה הזו לאחר תחילת הפירוק מרצון` TRUE FALSE)

-- The dissolution has begun and the act is needed for it: allowed.
#ASSERT `האם חברתי רשאית להמשיך בפעולה הזו לאחר תחילת הפירוק מרצון` TRUE TRUE

-- The dissolution has not begun: the company may carry on.
#ASSERT `האם חברתי רשאית להמשיך בפעולה הזו לאחר תחילת הפירוק מרצון` FALSE FALSE

-- The trustee telling the known creditors in writing within 21 days of the resolution: the event has not happened, so the duty has not arisen.
#ASSERT `האם הנאמן עמד במועד להודיע בכתב לנושי חברתי על הפירוק` FALSE FALSE 0 EQUALS `החובה אינה חלה`

-- The trustee telling the known creditors in writing within 21 days of the resolution: done on day 21, the last day inside the limit.
#ASSERT `האם הנאמן עמד במועד להודיע בכתב לנושי חברתי על הפירוק` TRUE TRUE 21 EQUALS `קויימה בתוך המועד`

-- The trustee telling the known creditors in writing within 21 days of the resolution: done on day 22, one day late.
#ASSERT `האם הנאמן עמד במועד להודיע בכתב לנושי חברתי על הפירוק` TRUE TRUE 22 EQUALS `קויימה באיחור`

-- The trustee telling the known creditors in writing within 21 days of the resolution: not yet done, day 21, the limit has not yet run.
#ASSERT `האם הנאמן עמד במועד להודיע בכתב לנושי חברתי על הפירוק` TRUE FALSE 21 EQUALS `טרם קויימה והמועד עדיין לא חלף`

-- The trustee telling the known creditors in writing within 21 days of the resolution: not yet done, day 22, the limit has run out.
#ASSERT `האם הנאמן עמד במועד להודיע בכתב לנושי חברתי על הפירוק` TRUE FALSE 22 EQUALS `טרם קויימה והמועד חלף`

-- The trustee telling the Registrar within 21 days of the resolution: the event has not happened, so the duty has not arisen.
#ASSERT `האם הנאמן עמד במועד להודיע לרשם על ההחלטה ועל מינויו` FALSE FALSE 0 EQUALS `החובה אינה חלה`

-- The trustee telling the Registrar within 21 days of the resolution: done on day 21, the last day inside the limit.
#ASSERT `האם הנאמן עמד במועד להודיע לרשם על ההחלטה ועל מינויו` TRUE TRUE 21 EQUALS `קויימה בתוך המועד`

-- The trustee telling the Registrar within 21 days of the resolution: done on day 22, one day late.
#ASSERT `האם הנאמן עמד במועד להודיע לרשם על ההחלטה ועל מינויו` TRUE TRUE 22 EQUALS `קויימה באיחור`

-- The trustee telling the Registrar within 21 days of the resolution: not yet done, day 21, the limit has not yet run.
#ASSERT `האם הנאמן עמד במועד להודיע לרשם על ההחלטה ועל מינויו` TRUE FALSE 21 EQUALS `טרם קויימה והמועד עדיין לא חלף`

-- The trustee telling the Registrar within 21 days of the resolution: not yet done, day 22, the limit has run out.
#ASSERT `האם הנאמן עמד במועד להודיע לרשם על ההחלטה ועל מינויו` TRUE FALSE 22 EQUALS `טרם קויימה והמועד חלף`

-- The trustee has sent the notice, the Registrar is satisfied and has not yet registered a note: the duty is open.
#ASSERT `האם הרשם חייב לרשום הערה על הפירוק מרצון של חברתי` TRUE TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- The Registrar registered the note: done.
#ASSERT `האם הרשם חייב לרשום הערה על הפירוק מרצון של חברתי` TRUE TRUE TRUE EQUALS `החובה חלה וקויימה`

-- The Registrar is not satisfied that the conditions were met: no duty yet.
#ASSERT `האם הרשם חייב לרשום הערה על הפירוק מרצון של חברתי` TRUE FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- The trustee has not sent the notice: no duty yet.
#ASSERT `האם הרשם חייב לרשום הערה על הפירוק מרצון של חברתי` FALSE TRUE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- The Registrar publishing the note on the Ministry of Justice's website: the trigger has not happened, so the duty has not arisen.
#ASSERT `האם הרשם חייב לפרסם את ההערה על הפירוק מרצון של חברתי` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- The Registrar publishing the note on the Ministry of Justice's website: the duty has arisen and is not done.
#ASSERT `האם הרשם חייב לפרסם את ההערה על הפירוק מרצון של חברתי` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- The Registrar publishing the note on the Ministry of Justice's website: the duty has arisen and is done.
#ASSERT `האם הרשם חייב לפרסם את ההערה על הפירוק מרצון של חברתי` TRUE TRUE EQUALS `החובה חלה וקויימה`

§§ `פירוק מרצון: הנאמן, בעלי המניות והנושים (סעיפים 342לא עד 342לה)`

-- No trustee has been appointed: the duty has not arisen.
#ASSERT `האם הנאמן מילא את חובתו לפעול במהירות האפשרית להשלמת הפירוק מרצון` FALSE FALSE FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- A trustee was appointed and has done none of the three: open.
#ASSERT `האם הנאמן מילא את חובתו לפעול במהירות האפשרית להשלמת הפירוק מרצון` TRUE FALSE FALSE FALSE EQUALS `החובה חלה וטרם קויימה`

-- He has done two of the three: open.
#ASSERT `האם הנאמן מילא את חובתו לפעול במהירות האפשרית להשלמת הפירוק מרצון` TRUE TRUE TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- He has done all three: done.
#ASSERT `האם הנאמן מילא את חובתו לפעול במהירות האפשרית להשלמת הפירוק מרצון` TRUE TRUE TRUE TRUE EQUALS `החובה חלה וקויימה`

-- A trustee was appointed and the meeting did not keep the power with the board: the board's and general manager's powers pass to him.
#ASSERT `האם סמכויות הדירקטוריון והמנכ״ל של חברתי עברו לנאמן` TRUE FALSE

-- The meeting decided the power stays with the board: it does not pass.
#ASSERT NOT (`האם סמכויות הדירקטוריון והמנכ״ל של חברתי עברו לנאמן` TRUE TRUE)

-- No trustee has been appointed: nothing passes.
#ASSERT NOT (`האם סמכויות הדירקטוריון והמנכ״ל של חברתי עברו לנאמן` FALSE FALSE)

-- The power is paying a debt to creditors of a particular type and the meeting has not approved by special resolution: the trustee may not.
#ASSERT NOT (`האם הנאמן רשאי להפעיל את הסמכות הזו בלי אישור האסיפה הכללית` TRUE FALSE FALSE)

-- The same with the meeting's special resolution: he may.
#ASSERT `האם הנאמן רשאי להפעיל את הסמכות הזו בלי אישור האסיפה הכללית` TRUE FALSE TRUE

-- The power is a compromise that materially affects the estate and the meeting has not approved: he may not.
#ASSERT NOT (`האם הנאמן רשאי להפעיל את הסמכות הזו בלי אישור האסיפה הכללית` FALSE TRUE FALSE)

-- The same with approval: he may.
#ASSERT `האם הנאמן רשאי להפעיל את הסמכות הזו בלי אישור האסיפה הכללית` FALSE TRUE TRUE

-- The power is neither of the two: no approval is needed.
#ASSERT `האם הנאמן רשאי להפעיל את הסמכות הזו בלי אישור האסיפה הכללית` FALSE FALSE FALSE

-- The trustee was given a reasonable opportunity to put his position before the meeting: it may decide to end his tenure.
#ASSERT `האם האסיפה הכללית רשאית להחליט על הפסקת כהונת הנאמן` TRUE

-- He was not given the opportunity: it may not.
#ASSERT NOT (`האם האסיפה הכללית רשאית להחליט על הפסקת כהונת הנאמן` FALSE)

-- The general meeting appointing another trustee after the post became vacant: the trigger has not happened, so the duty has not arisen.
#ASSERT `האם האסיפה הכללית חייבת למנות נאמן אחר` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- The general meeting appointing another trustee after the post became vacant: the duty has arisen and is not done.
#ASSERT `האם האסיפה הכללית חייבת למנות נאמן אחר` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- The general meeting appointing another trustee after the post became vacant: the duty has arisen and is done.
#ASSERT `האם האסיפה הכללית חייבת למנות נאמן אחר` TRUE TRUE EQUALS `החובה חלה וקויימה`

-- The trustee's post became vacant: any shareholder, I included, may convene a general meeting to appoint a trustee.
#ASSERT `האם אני, כבעל מניה, רשאי לכנס אסיפה כללית למינוי נאמן` TRUE

-- The post is not vacant: no such right.
#ASSERT NOT (`האם אני, כבעל מניה, רשאי לכנס אסיפה כללית למינוי נאמן` FALSE)

-- The new trustee telling the Registrar of his appointment within 21 days: the event has not happened, so the duty has not arisen.
#ASSERT `האם הנאמן החדש עמד במועד להודיע לרשם על מינויו` FALSE FALSE 0 EQUALS `החובה אינה חלה`

-- The new trustee telling the Registrar of his appointment within 21 days: done on day 21, the last day inside the limit.
#ASSERT `האם הנאמן החדש עמד במועד להודיע לרשם על מינויו` TRUE TRUE 21 EQUALS `קויימה בתוך המועד`

-- The new trustee telling the Registrar of his appointment within 21 days: done on day 22, one day late.
#ASSERT `האם הנאמן החדש עמד במועד להודיע לרשם על מינויו` TRUE TRUE 22 EQUALS `קויימה באיחור`

-- The new trustee telling the Registrar of his appointment within 21 days: not yet done, day 21, the limit has not yet run.
#ASSERT `האם הנאמן החדש עמד במועד להודיע לרשם על מינויו` TRUE FALSE 21 EQUALS `טרם קויימה והמועד עדיין לא חלף`

-- The new trustee telling the Registrar of his appointment within 21 days: not yet done, day 22, the limit has run out.
#ASSERT `האם הנאמן החדש עמד במועד להודיע לרשם על מינויו` TRUE FALSE 22 EQUALS `טרם קויימה והמועד חלף`

-- Filing a proof of debt within 90 days of the public notice: the event has not happened, so the duty has not arisen.
#ASSERT `האם הגשתי במועד תביעת חוב נגד חברתי שבפירוק מרצון` FALSE FALSE 0 EQUALS `החובה אינה חלה`

-- Filing a proof of debt within 90 days of the public notice: done on day 90, the last day inside the limit.
#ASSERT `האם הגשתי במועד תביעת חוב נגד חברתי שבפירוק מרצון` TRUE TRUE 90 EQUALS `קויימה בתוך המועד`

-- Filing a proof of debt within 90 days of the public notice: done on day 91, one day late.
#ASSERT `האם הגשתי במועד תביעת חוב נגד חברתי שבפירוק מרצון` TRUE TRUE 91 EQUALS `קויימה באיחור`

-- Filing a proof of debt within 90 days of the public notice: not yet done, day 90, the limit has not yet run.
#ASSERT `האם הגשתי במועד תביעת חוב נגד חברתי שבפירוק מרצון` TRUE FALSE 90 EQUALS `טרם קויימה והמועד עדיין לא חלף`

-- Filing a proof of debt within 90 days of the public notice: not yet done, day 91, the limit has run out.
#ASSERT `האם הגשתי במועד תביעת חוב נגד חברתי שבפירוק מרצון` TRUE FALSE 91 EQUALS `טרם קויימה והמועד חלף`

-- The meeting approved and the trustee thinks it would not harm the proper conduct: he may pay interim payments.
#ASSERT `האם הנאמן רשאי לשלם תשלומי ביניים בפירוק מרצון של חברתי` TRUE TRUE

-- The meeting did not approve: he may not.
#ASSERT NOT (`האם הנאמן רשאי לשלם תשלומי ביניים בפירוק מרצון של חברתי` FALSE TRUE)

-- The trustee thinks it would harm the proper conduct: he may not.
#ASSERT NOT (`האם הנאמן רשאי לשלם תשלומי ביניים בפירוק מרצון של חברתי` TRUE FALSE)

-- I am the trustee: I may apply to the court.
#ASSERT `האם אני רשאי לפנות לבית המשפט בשאלה הנוגעת להליכי הפירוק מרצון` TRUE FALSE FALSE

-- I am a shareholder: I may.
#ASSERT `האם אני רשאי לפנות לבית המשפט בשאלה הנוגעת להליכי הפירוק מרצון` FALSE TRUE FALSE

-- I am a creditor: I may.
#ASSERT `האם אני רשאי לפנות לבית המשפט בשאלה הנוגעת להליכי הפירוק מרצון` FALSE FALSE TRUE

-- I am none of those: I may not.
#ASSERT NOT (`האם אני רשאי לפנות לבית המשפט בשאלה הנוגעת להליכי הפירוק מרצון` FALSE FALSE FALSE)

§§ `פירוק מרצון: אסיפות, ביטול, סיום וחיסול (סעיפים 342לו עד 342מ)`

-- I am a trustee in the voluntary dissolution: I may convene a general meeting at any time.
#ASSERT `האם אני, כנאמן בפירוק מרצון, רשאי לכנס אסיפה כללית בכל עת` TRUE

-- I am not a trustee: the subsection gives me no such power.
#ASSERT NOT (`האם אני, כנאמן בפירוק מרצון, רשאי לכנס אסיפה כללית בכל עת` FALSE)

-- The dissolution began on 15 March 2026: its first year ends on 15 March 2027.
#ASSERT `באיזה יום מסתיימת השנה הראשונה של הפירוק מרצון של חברתי` 2026 3 15 EQUALS YMD 2027 3 15

-- Started 15 March 2026: the trustee must convene and report on the first anniversary, 15 March 2027.
#ASSERT `האם על הנאמן לכנס אסיפה כללית ולהגיש דוח ביום הזה` 2026 3 15 2027 3 15

-- Also on 31 December 2027, the end of the next calendar year.
#ASSERT `האם על הנאמן לכנס אסיפה כללית ולהגיש דוח ביום הזה` 2026 3 15 2027 12 31

-- Also on 31 December 2028.
#ASSERT `האם על הנאמן לכנס אסיפה כללית ולהגיש דוח ביום הזה` 2026 3 15 2028 12 31

-- Not on 31 December 2026: before the first anniversary, the first meeting is on the anniversary (fork F15 counts 2027).
#ASSERT NOT (`האם על הנאמן לכנס אסיפה כללית ולהגיש דוח ביום הזה` 2026 3 15 2026 12 31)

-- Not on 30 June 2027: neither the anniversary nor a 31 December.
#ASSERT NOT (`האם על הנאמן לכנס אסיפה כללית ולהגיש דוח ביום הזה` 2026 3 15 2027 6 30)

-- Not on 14 March 2027, the day before the anniversary.
#ASSERT NOT (`האם על הנאמן לכנס אסיפה כללית ולהגיש דוח ביום הזה` 2026 3 15 2027 3 14)

-- The trustee convening the annual general meeting and submitting a report: the trigger has not happened, so the duty has not arisen.
#ASSERT `האם הנאמן מילא את חובתו לכנס אסיפה כללית שנתית ולהגיש דוח` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- The trustee convening the annual general meeting and submitting a report: the duty has arisen and is not done.
#ASSERT `האם הנאמן מילא את חובתו לכנס אסיפה כללית שנתית ולהגיש דוח` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- The trustee convening the annual general meeting and submitting a report: the duty has arisen and is done.
#ASSERT `האם הנאמן מילא את חובתו לכנס אסיפה כללית שנתית ולהגיש דוח` TRUE TRUE EQUALS `החובה חלה וקויימה`

-- All 5 directors declared that on cancellation the company can pay its debts when due: the meeting may pass a special resolution cancelling.
#ASSERT `האם האסיפה הכללית רשאית לקבל החלטה מיוחדת על ביטול הפירוק מרצון` 5 5 FALSE

-- 3 of 5 declared: most, enough.
#ASSERT `האם האסיפה הכללית רשאית לקבל החלטה מיוחדת על ביטול הפירוק מרצון` 5 3 FALSE

-- 2 of 4 declared and the trustee did not: exactly half is not most.
#ASSERT NOT (`האם האסיפה הכללית רשאית לקבל החלטה מיוחדת על ביטול הפירוק מרצון` 4 2 FALSE)

-- 2 of 4 declared but the trustee declared too: the trustee's declaration is enough.
#ASSERT `האם האסיפה הכללית רשאית לקבל החלטה מיוחדת על ביטול הפירוק מרצון` 4 2 TRUE

-- No director declared and the trustee did not: not allowed.
#ASSERT NOT (`האם האסיפה הכללית רשאית לקבל החלטה מיוחדת על ביטול הפירוק מרצון` 5 0 FALSE)

-- The company has no directors and the trustee did not declare: not allowed.
#ASSERT NOT (`האם האסיפה הכללית רשאית לקבל החלטה מיוחדת על ביטול הפירוק מרצון` 0 0 FALSE)

-- No director declared but the trustee did: allowed.
#ASSERT `האם האסיפה הכללית רשאית לקבל החלטה מיוחדת על ביטול הפירוק מרצון` 5 0 TRUE

-- A sale, transfer or payment was lawfully made before the cancellation: the cancellation leaves it valid.
#ASSERT `האם ביטול הפירוק מרצון אינו פוגע בתוקפה של פעולה שנעשתה לפניו` TRUE

-- The act was not lawfully made: the subsection protects only lawful acts.
#ASSERT NOT (`האם ביטול הפירוק מרצון אינו פוגע בתוקפה של פעולה שנעשתה לפניו` FALSE)

-- The trustee sending and publishing the resolution cancelling the dissolution: the trigger has not happened, so the duty has not arisen.
#ASSERT `האם הנאמן חייב לשלוח ולפרסם את ההחלטה על ביטול הפירוק` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- The trustee sending and publishing the resolution cancelling the dissolution: the duty has arisen and is not done.
#ASSERT `האם הנאמן חייב לשלוח ולפרסם את ההחלטה על ביטול הפירוק` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- The trustee sending and publishing the resolution cancelling the dissolution: the duty has arisen and is done.
#ASSERT `האם הנאמן חייב לשלוח ולפרסם את ההחלטה על ביטול הפירוק` TRUE TRUE EQUALS `החובה חלה וקויימה`

-- The Registrar deleting the note of voluntary dissolution: the trigger has not happened, so the duty has not arisen.
#ASSERT `האם הרשם חייב למחוק את ההערה על הפירוק מרצון לאחר ביטולו` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- The Registrar deleting the note of voluntary dissolution: the duty has arisen and is not done.
#ASSERT `האם הרשם חייב למחוק את ההערה על הפירוק מרצון לאחר ביטולו` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- The Registrar deleting the note of voluntary dissolution: the duty has arisen and is done.
#ASSERT `האם הרשם חייב למחוק את ההערה על הפירוק מרצון לאחר ביטולו` TRUE TRUE EQUALS `החובה חלה וקויימה`

-- The trustee preparing a summary report and convening a general meeting: the trigger has not happened, so the duty has not arisen.
#ASSERT `האם הנאמן מילא את חובתו לערוך דוח מסכם ולכנס אסיפה כללית` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- The trustee preparing a summary report and convening a general meeting: the duty has arisen and is not done.
#ASSERT `האם הנאמן מילא את חובתו לערוך דוח מסכם ולכנס אסיפה כללית` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- The trustee preparing a summary report and convening a general meeting: the duty has arisen and is done.
#ASSERT `האם הנאמן מילא את חובתו לערוך דוח מסכם ולכנס אסיפה כללית` TRUE TRUE EQUALS `החובה חלה וקויימה`

-- Delivered and published as the Minister prescribed, a month before the meeting, with the summary report attached: as required.
#ASSERT `האם ההזמנה לאסיפה הכללית שדנה בדוח המסכם נמסרה ופורסמה כנדרש` TRUE 1 TRUE

-- Less than a month before the meeting: not as required.
#ASSERT NOT (`האם ההזמנה לאסיפה הכללית שדנה בדוח המסכם נמסרה ופורסמה כנדרש` TRUE 0 TRUE)

-- No copy of the summary report attached: not as required.
#ASSERT NOT (`האם ההזמנה לאסיפה הכללית שדנה בדוח המסכם נמסרה ופורסמה כנדרש` TRUE 2 FALSE)

-- Not delivered and published as the Minister prescribed: not as required.
#ASSERT NOT (`האם ההזמנה לאסיפה הכללית שדנה בדוח המסכם נמסרה ופורסמה כנדרש` FALSE 1 TRUE)

-- The trustee telling the Registrar within seven days of the meeting: the event has not happened, so the duty has not arisen.
#ASSERT `האם הנאמן עמד במועד להודיע לרשם על כינוס האסיפה הכללית` FALSE FALSE 0 EQUALS `החובה אינה חלה`

-- The trustee telling the Registrar within seven days of the meeting: done on day 7, the last day inside the limit.
#ASSERT `האם הנאמן עמד במועד להודיע לרשם על כינוס האסיפה הכללית` TRUE TRUE 7 EQUALS `קויימה בתוך המועד`

-- The trustee telling the Registrar within seven days of the meeting: done on day 8, one day late.
#ASSERT `האם הנאמן עמד במועד להודיע לרשם על כינוס האסיפה הכללית` TRUE TRUE 8 EQUALS `קויימה באיחור`

-- The trustee telling the Registrar within seven days of the meeting: not yet done, day 7, the limit has not yet run.
#ASSERT `האם הנאמן עמד במועד להודיע לרשם על כינוס האסיפה הכללית` TRUE FALSE 7 EQUALS `טרם קויימה והמועד עדיין לא חלף`

-- The trustee telling the Registrar within seven days of the meeting: not yet done, day 8, the limit has run out.
#ASSERT `האם הנאמן עמד במועד להודיע לרשם על כינוס האסיפה הכללית` TRUE FALSE 8 EQUALS `טרם קויימה והמועד חלף`

-- The Registrar received the trustee's notice and the report and the company owes him no fees: the company is liquidated.
#ASSERT `האם חברתי מחוסלת` TRUE TRUE

-- The company still owes the Registrar fees under section 44(6): not yet.
#ASSERT NOT (`האם חברתי מחוסלת` TRUE FALSE)

-- The Registrar has not received the notice and report: not yet.
#ASSERT NOT (`האם חברתי מחוסלת` FALSE TRUE)

-- The final meeting decided on 7 years: the lowest period allowed.
#ASSERT `האם החלטת האסיפה הכללית על מסמכי החברה שומרת אותם לתקופה הנדרשת` 7

-- 6 years: too short.
#ASSERT NOT (`האם החלטת האסיפה הכללית על מסמכי החברה שומרת אותם לתקופה הנדרשת` 6)

-- The final general meeting made no decision on the documents: the trustee keeps them seven years.
#ASSERT `לכמה שנים שומר הנאמן את מסמכי החברה כשהאסיפה הכללית לא החליטה בענין` EQUALS 7

-- The company was liquidated on 30 June 2027: the trustee's tenure ends that day.
#ASSERT `באיזה יום מסתיימת כהונת הנאמן` 2027 6 30 EQUALS YMD 2027 6 30

-- The company decided on voluntary dissolution and I am a shareholder: I may still apply for dissolution by a court.
#ASSERT `האם אני רשאי לבקש פירוק בידי בית משפט אף לאחר ההחלטה על פירוק מרצון` TRUE TRUE

-- I am neither a shareholder nor the Attorney General: the section gives me no such right.
#ASSERT NOT (`האם אני רשאי לבקש פירוק בידי בית משפט אף לאחר ההחלטה על פירוק מרצון` TRUE FALSE)

-- The company has not decided on voluntary dissolution: this section is not the source of the right.
#ASSERT NOT (`האם אני רשאי לבקש פירוק בידי בית משפט אף לאחר ההחלטה על פירוק מרצון` FALSE TRUE)

-- A court issued a winding-up order on a shareholder's application while the company is in voluntary dissolution: it orders the voluntary proceedings ended.
#ASSERT `האם בית המשפט יורה על סיום הפירוק מרצון של חברתי והמשך ההליכים בידי בית משפט` TRUE TRUE

-- The company is not in voluntary dissolution: no such order.
#ASSERT NOT (`האם בית המשפט יורה על סיום הפירוק מרצון של חברתי והמשך ההליכים בידי בית משפט` TRUE FALSE)

§§ `פירוק מרצון בהליך מזורז של חברה לא פעילה (סעיפים 342מא עד 342מז)`

-- No assets, no debts, no proceedings and no enforcement: my company is inactive.
#ASSERT `האם חברתי היא חברה לא פעילה` FALSE FALSE FALSE FALSE

-- It has assets: not inactive.
#ASSERT NOT (`האם חברתי היא חברה לא פעילה` TRUE FALSE FALSE FALSE)

-- It has a debt: not inactive.
#ASSERT NOT (`האם חברתי היא חברה לא פעילה` FALSE TRUE FALSE FALSE)

-- A legal proceeding to which it is a party is pending: not inactive.
#ASSERT NOT (`האם חברתי היא חברה לא פעילה` FALSE FALSE TRUE FALSE)

-- Administrative enforcement proceedings are being conducted against it: not inactive.
#ASSERT NOT (`האם חברתי היא חברה לא פעילה` FALSE FALSE FALSE TRUE)

-- An inactive company; all 5 shareholders at the meeting agreed, invitation 21 days before, the agenda held the proposal: it may.
#ASSERT `האם חברתי הלא פעילה רשאית לקבל החלטה על פירוק מרצון בהליך מזורז` FALSE FALSE FALSE FALSE 5 5 21 FALSE TRUE

-- Only 4 of the 5 shareholders taking part agreed: not all.
#ASSERT NOT (`האם חברתי הלא פעילה רשאית לקבל החלטה על פירוק מרצון בהליך מזורז` FALSE FALSE FALSE FALSE 5 4 21 FALSE TRUE)

-- Invitation 20 days before: too close without all the shareholders' consent.
#ASSERT NOT (`האם חברתי הלא פעילה רשאית לקבל החלטה על פירוק מרצון בהליך מזורז` FALSE FALSE FALSE FALSE 5 5 20 FALSE TRUE)

-- Invitation 20 days before but all the shareholders agreed to the closer time: it may.
#ASSERT `האם חברתי הלא פעילה רשאית לקבל החלטה על פירוק מרצון בהליך מזורז` FALSE FALSE FALSE FALSE 5 5 20 TRUE TRUE

-- The agenda did not include the proposal: it may not.
#ASSERT NOT (`האם חברתי הלא פעילה רשאית לקבל החלטה על פירוק מרצון בהליך מזורז` FALSE FALSE FALSE FALSE 5 5 21 FALSE FALSE)

-- The company has assets, so it is not inactive: it may not use the fast track.
#ASSERT NOT (`האם חברתי הלא פעילה רשאית לקבל החלטה על פירוק מרצון בהליך מזורז` TRUE FALSE FALSE FALSE 5 5 21 FALSE TRUE)

-- Filing the fast-track application with the Registrar within 30 days of the resolution: the event has not happened, so the duty has not arisen.
#ASSERT `האם חברתי עמדה במועד להגיש לרשם בקשה לפירוק מרצון בהליך מזורז` FALSE FALSE 0 EQUALS `החובה אינה חלה`

-- Filing the fast-track application with the Registrar within 30 days of the resolution: done on day 30, the last day inside the limit.
#ASSERT `האם חברתי עמדה במועד להגיש לרשם בקשה לפירוק מרצון בהליך מזורז` TRUE TRUE 30 EQUALS `קויימה בתוך המועד`

-- Filing the fast-track application with the Registrar within 30 days of the resolution: done on day 31, one day late.
#ASSERT `האם חברתי עמדה במועד להגיש לרשם בקשה לפירוק מרצון בהליך מזורז` TRUE TRUE 31 EQUALS `קויימה באיחור`

-- Filing the fast-track application with the Registrar within 30 days of the resolution: not yet done, day 30, the limit has not yet run.
#ASSERT `האם חברתי עמדה במועד להגיש לרשם בקשה לפירוק מרצון בהליך מזורז` TRUE FALSE 30 EQUALS `טרם קויימה והמועד עדיין לא חלף`

-- Filing the fast-track application with the Registrar within 30 days of the resolution: not yet done, day 31, the limit has run out.
#ASSERT `האם חברתי עמדה במועד להגיש לרשם בקשה לפירוק מרצון בהליך מזורז` TRUE FALSE 31 EQUALS `טרם קויימה והמועד חלף`

-- All 5 directors signed the affidavit, it verifies both things, documents kept 7 years, further documents attached: complete.
#ASSERT `האם בקשת חברתי לרשם כוללת את הצרופות הנדרשות` 5 5 TRUE 7 TRUE

-- 3 of 5 directors signed: most, enough.
#ASSERT `האם בקשת חברתי לרשם כוללת את הצרופות הנדרשות` 5 3 TRUE 7 TRUE

-- 2 of 4 directors signed: exactly half is not most.
#ASSERT NOT (`האם בקשת חברתי לרשם כוללת את הצרופות הנדרשות` 4 2 TRUE 7 TRUE)

-- The affidavit does not verify the conditions and the resolution: incomplete.
#ASSERT NOT (`האם בקשת חברתי לרשם כוללת את הצרופות הנדרשות` 5 5 FALSE 7 TRUE)

-- The company decided to keep the documents 6 years: below seven.
#ASSERT NOT (`האם בקשת חברתי לרשם כוללת את הצרופות הנדרשות` 5 5 TRUE 6 TRUE)

-- The Minister's further documents are missing: incomplete.
#ASSERT NOT (`האם בקשת חברתי לרשם כוללת את הצרופות הנדרשות` 5 5 TRUE 7 FALSE)

-- No application has been filed: no duty.
#ASSERT `האם הרשם חייב לפרסם הודעה על בקשת חברתי ולרשום הערה` FALSE FALSE FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- The Registrar found that the conditions for filing were not met: no duty.
#ASSERT `האם הרשם חייב לפרסם הודעה על בקשת חברתי ולרשום הערה` TRUE FALSE FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- The conditions were met and he has done neither: open.
#ASSERT `האם הרשם חייב לפרסם הודעה על בקשת חברתי ולרשום הערה` TRUE TRUE FALSE FALSE EQUALS `החובה חלה וטרם קויימה`

-- He published the notice but registered no note: open.
#ASSERT `האם הרשם חייב לפרסם הודעה על בקשת חברתי ולרשום הערה` TRUE TRUE TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- He did both: done.
#ASSERT `האם הרשם חייב לפרסם הודעה על בקשת חברתי ולרשום הערה` TRUE TRUE TRUE TRUE EQUALS `החובה חלה וקויימה`

-- I may be harmed by the liquidation and I object on day 90 of the publication: in time.
#ASSERT `האם אני רשאי להגיש התנגדות לבקשה לפירוק מרצון בהליך מזורז של החברה` TRUE TRUE 90

-- On day 91: too late.
#ASSERT NOT (`האם אני רשאי להגיש התנגדות לבקשה לפירוק מרצון בהליך מזורז של החברה` TRUE TRUE 91)

-- I cannot be harmed by the liquidation: I have no right to object.
#ASSERT NOT (`האם אני רשאי להגיש התנגדות לבקשה לפירוק מרצון בהליך מזורז של החברה` TRUE FALSE 10)

-- The application has not been published: nothing to object to.
#ASSERT NOT (`האם אני רשאי להגיש התנגדות לבקשה לפירוק מרצון בהליך מזורז של החברה` FALSE TRUE 10)

-- An objection was filed and the Registrar has not yet stopped the proceedings: his duty is open.
#ASSERT `האם הרשם חייב להפסיק את הליכי הפירוק של חברתי ולהסיר את הפרסום` TRUE FALSE FALSE EQUALS `החובה חלה וטרם קויימה`

-- The Registrar found during the objection period that a condition is not met: his duty is open.
#ASSERT `האם הרשם חייב להפסיק את הליכי הפירוק של חברתי ולהסיר את הפרסום` FALSE TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- He told the company and removed the publication: done.
#ASSERT `האם הרשם חייב להפסיק את הליכי הפירוק של חברתי ולהסיר את הפרסום` TRUE FALSE TRUE EQUALS `החובה חלה וקויימה`

-- No objection and no failed condition: no duty.
#ASSERT `האם הרשם חייב להפסיק את הליכי הפירוק של חברתי ולהסיר את הפרסום` FALSE FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- No objection; 10 working days passed since the last day; the Registrar has not registered: his duty is open.
#ASSERT `האם הרשם חייב לרשום את חיסול חברתי בתום 10 ימי עבודה` TRUE 10 FALSE EQUALS `החובה חלה וטרם קויימה`

-- He registered: done.
#ASSERT `האם הרשם חייב לרשום את חיסול חברתי בתום 10 ימי עבודה` TRUE 10 TRUE EQUALS `החובה חלה וקויימה`

-- Only 9 working days have passed: the duty has not arisen.
#ASSERT `האם הרשם חייב לרשום את חיסול חברתי בתום 10 ימי עבודה` TRUE 9 FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- 11 working days have passed and he has not registered: still open (no later limit is stated, fork F16).
#ASSERT `האם הרשם חייב לרשום את חיסול חברתי בתום 10 ימי עבודה` TRUE 11 FALSE EQUALS `החובה חלה וטרם קויימה`

-- An objection was filed: no duty to register.
#ASSERT `האם הרשם חייב לרשום את חיסול חברתי בתום 10 ימי עבודה` FALSE 10 FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- The Registrar registered the liquidation: the company is liquidated from the date of registration.
#ASSERT `האם חברתי מחוסלת לאחר הליך מזורז` TRUE

-- He has not registered: the company is not liquidated.
#ASSERT NOT (`האם חברתי מחוסלת לאחר הליך מזורז` FALSE)

§§ `פירוק: הוראות שונות (סעיפים 342מח עד 342נג)`

-- A private company whose resolution was passed as section 76 allows: Part 8A does not take away from its validity.
#ASSERT `האם חלק 8א אינו גורע מתוקף החלטה שהתקבלה לפי סעיף 76` TRUE TRUE

-- My company is not a private company: the section speaks of a private company.
#ASSERT NOT (`האם חלק 8א אינו גורע מתוקף החלטה שהתקבלה לפי סעיף 76` FALSE TRUE)

-- The resolution was not passed as section 76 allows: the section does not protect it.
#ASSERT NOT (`האם חלק 8א אינו גורע מתוקף החלטה שהתקבלה לפי סעיף 76` TRUE FALSE)

-- A document on the company's behalf stating that it is in dissolution proceedings: the trigger has not happened, so the duty has not arisen.
#ASSERT `האם חברתי חייבת לציין בכל מסמך מטעמה שהיא בהליכי פירוק` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- A document on the company's behalf stating that it is in dissolution proceedings: the duty has arisen and is not done.
#ASSERT `האם חברתי חייבת לציין בכל מסמך מטעמה שהיא בהליכי פירוק` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- A document on the company's behalf stating that it is in dissolution proceedings: the duty has arisen and is done.
#ASSERT `האם חברתי חייבת לציין בכל מסמך מטעמה שהיא בהליכי פירוק` TRUE TRUE EQUALS `החובה חלה וקויימה`

-- The trustee filing an annual report with the Registrar: the trigger has not happened, so the duty has not arisen.
#ASSERT `האם הנאמן מילא את חובתו להגיש לרשם דוח שנתי על הליכי הפירוק` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- The trustee filing an annual report with the Registrar: the duty has arisen and is not done.
#ASSERT `האם הנאמן מילא את חובתו להגיש לרשם דוח שנתי על הליכי הפירוק` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- The trustee filing an annual report with the Registrar: the duty has arisen and is done.
#ASSERT `האם הנאמן מילא את חובתו להגיש לרשם דוח שנתי על הליכי הפירוק` TRUE TRUE EQUALS `החובה חלה וקויימה`

-- I am a shareholder; I concealed an asset before the order so that it would not be in the estate: up to three years.
#ASSERT `מהו המאסר המרבי שעלול להיות מוטל עלי בשל המעשה הזה בהליכי הפירוק` TRUE `משרה אחרת` TRUE `הסתרת נכס לפני מתן הצו או ההחלטה במטרה שלא ייכלל בנכסי קופת הפירוק` EQUALS JUST 3

-- I am a director (an office-holder); I concealed an asset after the order: up to three years.
#ASSERT `מהו המאסר המרבי שעלול להיות מוטל עלי בשל המעשה הזה בהליכי הפירוק` FALSE `דירקטור` TRUE `הסתרת נכס לאחר מתן הצו או ההחלטה` EQUALS JUST 3

-- I am a general manager; I gave false information to the trustee to harm the proceedings: up to three years.
#ASSERT `מהו המאסר המרבי שעלול להיות מוטל עלי בשל המעשה הזה בהליכי הפירוק` FALSE `מנהל כללי` TRUE `אי מסירת מידע או מסירת מידע חלקי או כוזב לנאמן או לאסיפה הכללית במטרה לפגוע בהליכי הפירוק` EQUALS JUST 3

-- I am neither a shareholder nor an office-holder: the subsection does not cover me, a not-covered answer.
#ASSERT `מהו המאסר המרבי שעלול להיות מוטל עלי בשל המעשה הזה בהליכי הפירוק` FALSE `משרה אחרת` TRUE `הסתרת נכס לאחר מתן הצו או ההחלטה` EQUALS NOTHING

-- I am a shareholder but no order was issued and no resolution passed: not covered.
#ASSERT `מהו המאסר המרבי שעלול להיות מוטל עלי בשל המעשה הזה בהליכי הפירוק` TRUE `משרה אחרת` FALSE `הסתרת נכס לפני מתן הצו או ההחלטה במטרה שלא ייכלל בנכסי קופת הפירוק` EQUALS NOTHING

-- I am a shareholder and did some other act: the subsection names three acts only, not covered.
#ASSERT `מהו המאסר המרבי שעלול להיות מוטל עלי בשל המעשה הזה בהליכי הפירוק` TRUE `משרה אחרת` TRUE `מעשה אחר` EQUALS NOTHING

-- I was required to give the trustee information, did not, to harm the proceedings: up to one year.
#ASSERT `מהו המאסר המרבי שעלול להיות מוטל עלי אם לא מסרתי לנאמן מידע שנדרשתי למסור` TRUE TRUE TRUE EQUALS JUST 1

-- I did not act with the aim of harming the proceedings: not covered.
#ASSERT `מהו המאסר המרבי שעלול להיות מוטל עלי אם לא מסרתי לנאמן מידע שנדרשתי למסור` TRUE TRUE FALSE EQUALS NOTHING

-- I gave the information in full and truthfully: not covered.
#ASSERT `מהו המאסר המרבי שעלול להיות מוטל עלי אם לא מסרתי לנאמן מידע שנדרשתי למסור` TRUE FALSE TRUE EQUALS NOTHING

-- I was not required to give it: not covered.
#ASSERT `מהו המאסר המרבי שעלול להיות מוטל עלי אם לא מסרתי לנאמן מידע שנדרשתי למסור` FALSE TRUE TRUE EQUALS NOTHING

-- The company was liquidated; I am interested; filed two years after: the court may cancel the liquidation if it finds it justified.
#ASSERT `האם בית המשפט רשאי לבטל את חיסול חברתי לבקשתי` TRUE TRUE TRUE 2 FALSE

-- Filed after three years without the court's permission: out of time.
#ASSERT NOT (`האם בית המשפט רשאי לבטל את חיסול חברתי לבקשתי` TRUE TRUE TRUE 3 FALSE)

-- Filed after three years with the court's permission in an exceptional case: in time.
#ASSERT `האם בית המשפט רשאי לבטל את חיסול חברתי לבקשתי` TRUE TRUE TRUE 3 TRUE

-- The court does not find cancellation justified: it may not.
#ASSERT NOT (`האם בית המשפט רשאי לבטל את חיסול חברתי לבקשתי` TRUE TRUE FALSE 1 FALSE)

-- The company has not been liquidated: nothing to cancel.
#ASSERT NOT (`האם בית המשפט רשאי לבטל את חיסול חברתי לבקשתי` FALSE TRUE TRUE 1 FALSE)

-- I am not a person interested: I may not ask.
#ASSERT NOT (`האם בית המשפט רשאי לבטל את חיסול חברתי לבקשתי` TRUE FALSE TRUE 1 FALSE)

-- An order cancelling the liquidation was given: any proceeding that could have been taken had the company not been liquidated may be taken.
#ASSERT `האם לאחר ביטול החיסול ניתן לנקוט כל הליך שהיה ניתן לנקוט אילולא חוסלה החברה` TRUE

-- No such order was given.
#ASSERT NOT (`האם לאחר ביטול החיסול ניתן לנקוט כל הליך שהיה ניתן לנקוט אילולא חוסלה החברה` FALSE)

-- Delivering a copy of the order cancelling the liquidation to the Registrar within seven days: the event has not happened, so the duty has not arisen.
#ASSERT `האם עמדתי במועד להמציא לרשם עותק מהצו לביטול החיסול` FALSE FALSE 0 EQUALS `החובה אינה חלה`

-- Delivering a copy of the order cancelling the liquidation to the Registrar within seven days: done on day 7, the last day inside the limit.
#ASSERT `האם עמדתי במועד להמציא לרשם עותק מהצו לביטול החיסול` TRUE TRUE 7 EQUALS `קויימה בתוך המועד`

-- Delivering a copy of the order cancelling the liquidation to the Registrar within seven days: done on day 8, one day late.
#ASSERT `האם עמדתי במועד להמציא לרשם עותק מהצו לביטול החיסול` TRUE TRUE 8 EQUALS `קויימה באיחור`

-- Delivering a copy of the order cancelling the liquidation to the Registrar within seven days: not yet done, day 7, the limit has not yet run.
#ASSERT `האם עמדתי במועד להמציא לרשם עותק מהצו לביטול החיסול` TRUE FALSE 7 EQUALS `טרם קויימה והמועד עדיין לא חלף`

-- Delivering a copy of the order cancelling the liquidation to the Registrar within seven days: not yet done, day 8, the limit has run out.
#ASSERT `האם עמדתי במועד להמציא לרשם עותק מהצו לביטול החיסול` TRUE FALSE 8 EQUALS `טרם קויימה והמועד חלף`

-- I delivered a copy of the order and the Registrar has not yet cancelled the registration: his duty is open.
#ASSERT `האם הרשם חייב לבטל את רישום חיסול חברתי` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- He cancelled it: done.
#ASSERT `האם הרשם חייב לבטל את רישום חיסול חברתי` TRUE TRUE EQUALS `החובה חלה וקויימה`

-- I have not delivered a copy: no duty yet.
#ASSERT `האם הרשם חייב לבטל את רישום חיסול חברתי` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- A foreign company that conducts business in Israel: the provisions on dissolution by a court apply, even if not registered under section 346.
#ASSERT `האם הוראות הפירוק בידי בית משפט חלות על חברת חוץ שיש לי חלק בה` TRUE FALSE TRUE TRUE FALSE

-- A foreign company with assets in Israel and no business: they apply.
#ASSERT `האם הוראות הפירוק בידי בית משפט חלות על חברת חוץ שיש לי חלק בה` TRUE FALSE TRUE FALSE TRUE

-- A foreign company with neither business nor assets in Israel: they do not apply.
#ASSERT NOT (`האם הוראות הפירוק בידי בית משפט חלות על חברת חוץ שיש לי חלק בה` TRUE FALSE TRUE FALSE FALSE)

-- A foreign partnership: a foreign company is a body corporate other than a partnership, so no.
#ASSERT NOT (`האם הוראות הפירוק בידי בית משפט חלות על חברת חוץ שיש לי חלק בה` TRUE TRUE TRUE TRUE TRUE)

-- An Israeli company with assets in Israel: not a foreign company.
#ASSERT NOT (`האם הוראות הפירוק בידי בית משפט חלות על חברת חוץ שיש לי חלק בה` TRUE FALSE FALSE TRUE TRUE)

§§ `שינוי סוג החברה ואחריות בעלי המניות (סעיפים 343 ו־344)`

-- My private company floated its shares on the bourse and they are held by the public: it became a public company.
#ASSERT `אילו שינויים בסוג החברה חלו בחברתי` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS LIST `חברה פרטית שהפכה לחברה ציבורית`

-- A private company became public and a reporting corporation at once: two changes.
#ASSERT `אילו שינויים בסוג החברה חלו בחברתי` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE TRUE EQUALS LIST `חברה פרטית שהפכה לחברה ציבורית`, `חברה שהפכה לתאגיד מדווח`

-- A public company went private by delisting: it became private.
#ASSERT `אילו שינויים בסוג החברה חלו בחברתי` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS LIST `חברה ציבורית שהפכה לחברה פרטית`

-- A public company ceased to be a reporting corporation: one change.
#ASSERT `אילו שינויים בסוג החברה חלו בחברתי` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE TRUE TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS LIST `חברה שחדלה להיות תאגיד מדווח`

-- A private company whose bonds were listed and held by the public: it became a bond company.
#ASSERT `אילו שינויים בסוג החברה חלו בחברתי` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE TRUE FALSE EQUALS LIST `חברה שהפכה לחברת איגרות חוב`

-- A bond company whose bonds were delisted: it ceased to be a bond company.
#ASSERT `אילו שינויים בסוג החברה חלו בחברתי` FALSE FALSE FALSE FALSE TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS LIST `חברה שחדלה להיות חברת איגרות חוב`

-- Nothing about the company's kind changed: no change, an empty list.
#ASSERT count (`אילו שינויים בסוג החברה חלו בחברתי` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE) EQUALS 0

-- Shares listed but not held by the public, before and after: not a public company either way, no change.
#ASSERT count (`אילו שינויים בסוג החברה חלו בחברתי` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS 0

-- My private company became public and told the Registrar on day 14: in time.
#ASSERT `האם חברתי עמדה במועד להודיע לרשם על השינוי בסוג החברה` `חברה פרטית שהפכה לחברה ציבורית` TRUE 14 EQUALS `קויימה בתוך המועד`

-- On day 15: late.
#ASSERT `האם חברתי עמדה במועד להודיע לרשם על השינוי בסוג החברה` `חברה פרטית שהפכה לחברה ציבורית` TRUE 15 EQUALS `קויימה באיחור`

-- Not yet told, day 14: still open.
#ASSERT `האם חברתי עמדה במועד להודיע לרשם על השינוי בסוג החברה` `חברה פרטית שהפכה לחברה ציבורית` FALSE 14 EQUALS `טרם קויימה והמועד עדיין לא חלף`

-- Not yet told, day 15: the limit ran out.
#ASSERT `האם חברתי עמדה במועד להודיע לרשם על השינוי בסוג החברה` `חברה פרטית שהפכה לחברה ציבורית` FALSE 15 EQUALS `טרם קויימה והמועד חלף`

-- No change in the company's kind: the duty has not arisen.
#ASSERT `האם חברתי עמדה במועד להודיע לרשם על השינוי בסוג החברה` `אין שינוי בסוג החברה` FALSE 20 EQUALS `החובה אינה חלה`

-- Our shareholders' liability is unlimited and the court approved the amendment on an application under section 350(a): we may limit it.
#ASSERT `האם חברתי רשאית לשנות את תקנונה ולהגביל את אחריות בעלי המניות` TRUE TRUE

-- No court approval: we may not.
#ASSERT NOT (`האם חברתי רשאית לשנות את תקנונה ולהגביל את אחריות בעלי המניות` TRUE FALSE)

-- Liability is already limited: nothing to limit.
#ASSERT NOT (`האם חברתי רשאית לשנות את תקנונה ולהגביל את אחריות בעלי המניות` FALSE TRUE)

-- Our shareholders' liability is limited and all the shareholders consented: we may make it unlimited.
#ASSERT `האם חברתי רשאית לשנות את תקנונה ולהפוך את אחריות בעלי המניות ללא מוגבלת` TRUE TRUE

-- One shareholder did not consent: we may not.
#ASSERT NOT (`האם חברתי רשאית לשנות את תקנונה ולהפוך את אחריות בעלי המניות ללא מוגבלת` TRUE FALSE)

-- Liability is already unlimited: nothing to change.
#ASSERT NOT (`האם חברתי רשאית לשנות את תקנונה ולהפוך את אחריות בעלי המניות ללא מוגבלת` FALSE TRUE)

§§ `הפיכת אגודה שיתופית לחברה (סעיף 345)`

-- The society preparing a plan and submitting it to the Registrar of Cooperative Societies: the trigger has not happened, so the duty has not arisen.
#ASSERT `האם האגודה השיתופית שלי חייבת להכין תכנית ולהגישה לרשם האגודות השיתופיות` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- The society preparing a plan and submitting it to the Registrar of Cooperative Societies: the duty has arisen and is not done.
#ASSERT `האם האגודה השיתופית שלי חייבת להכין תכנית ולהגישה לרשם האגודות השיתופיות` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- The society preparing a plan and submitting it to the Registrar of Cooperative Societies: the duty has arisen and is done.
#ASSERT `האם האגודה השיתופית שלי חייבת להכין תכנית ולהגישה לרשם האגודות השיתופיות` TRUE TRUE EQUALS `החובה חלה וקויימה`

-- The Registrar approved, notice 21 days before with the plan set out, 75 of the 100 members who voted voted for: three quarters, approved.
#ASSERT `האם האסיפה הכללית של האגודה אישרה את תכנית ההפיכה לחברה` TRUE 21 TRUE 100 75

-- 74 of 100: below three quarters.
#ASSERT NOT (`האם האסיפה הכללית של האגודה אישרה את תכנית ההפיכה לחברה` TRUE 21 TRUE 100 74)

-- Notice 20 days before: too short.
#ASSERT NOT (`האם האסיפה הכללית של האגודה אישרה את תכנית ההפיכה לחברה` TRUE 20 TRUE 100 80)

-- The plan was not set out in the notice: not approved.
#ASSERT NOT (`האם האסיפה הכללית של האגודה אישרה את תכנית ההפיכה לחברה` TRUE 21 FALSE 100 80)

-- The Registrar did not approve the plan: not approved.
#ASSERT NOT (`האם האסיפה הכללית של האגודה אישרה את תכנית ההפיכה לחברה` FALSE 21 TRUE 100 80)

-- Nobody voted: no majority.
#ASSERT NOT (`האם האסיפה הכללית של האגודה אישרה את תכנית ההפיכה לחברה` TRUE 21 TRUE 0 0)

-- The society drawing up articles, delivering a copy to the Registrar of Companies and paying the fees: the trigger has not happened, so the duty has not arisen.
#ASSERT `האם על האגודה לערוך תקנון, למסור עותק לרשם החברות ולשלם אגרות` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- The society drawing up articles, delivering a copy to the Registrar of Companies and paying the fees: the duty has arisen and is not done.
#ASSERT `האם על האגודה לערוך תקנון, למסור עותק לרשם החברות ולשלם אגרות` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- The society drawing up articles, delivering a copy to the Registrar of Companies and paying the fees: the duty has arisen and is done.
#ASSERT `האם על האגודה לערוך תקנון, למסור עותק לרשם החברות ולשלם אגרות` TRUE TRUE EQUALS `החובה חלה וקויימה`

-- The Registrar of Companies telling the Registrar of Cooperative Societies of the approval: the trigger has not happened, so the duty has not arisen.
#ASSERT `האם רשם החברות חייב להודיע לרשם האגודות השיתופיות על אישור הרישום` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- The Registrar of Companies telling the Registrar of Cooperative Societies of the approval: the duty has arisen and is not done.
#ASSERT `האם רשם החברות חייב להודיע לרשם האגודות השיתופיות על אישור הרישום` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- The Registrar of Companies telling the Registrar of Cooperative Societies of the approval: the duty has arisen and is done.
#ASSERT `האם רשם החברות חייב להודיע לרשם האגודות השיתופיות על אישור הרישום` TRUE TRUE EQUALS `החובה חלה וקויימה`

-- The Registrar of Cooperative Societies cancelling the registration and publishing in Reshumot: the trigger has not happened, so the duty has not arisen.
#ASSERT `האם רשם האגודות השיתופיות חייב לבטל את רישום האגודה ולפרסם ברשומות` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- The Registrar of Cooperative Societies cancelling the registration and publishing in Reshumot: the duty has arisen and is not done.
#ASSERT `האם רשם האגודות השיתופיות חייב לבטל את רישום האגודה ולפרסם ברשומות` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- The Registrar of Cooperative Societies cancelling the registration and publishing in Reshumot: the duty has arisen and is done.
#ASSERT `האם רשם האגודות השיתופיות חייב לבטל את רישום האגודה ולפרסם ברשומות` TRUE TRUE EQUALS `החובה חלה וקויימה`

-- The Registrar of Companies registering the society as a company: the trigger has not happened, so the duty has not arisen.
#ASSERT `האם רשם החברות חייב לרשום את האגודה כחברה לאחר ביטול רישומה כאגודה שיתופית` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- The Registrar of Companies registering the society as a company: the duty has arisen and is not done.
#ASSERT `האם רשם החברות חייב לרשום את האגודה כחברה לאחר ביטול רישומה כאגודה שיתופית` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- The Registrar of Companies registering the society as a company: the duty has arisen and is done.
#ASSERT `האם רשם החברות חייב לרשום את האגודה כחברה לאחר ביטול רישומה כאגודה שיתופית` TRUE TRUE EQUALS `החובה חלה וקויימה`

-- The Registrar of Cooperative Societies transferring an extract of the pledges: the trigger has not happened, so the duty has not arisen.
#ASSERT `האם רשם האגודות השיתופיות חייב להעביר לרשם החברות נסח של השעבודים שיצרה האגודה` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- The Registrar of Cooperative Societies transferring an extract of the pledges: the duty has arisen and is not done.
#ASSERT `האם רשם האגודות השיתופיות חייב להעביר לרשם החברות נסח של השעבודים שיצרה האגודה` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- The Registrar of Cooperative Societies transferring an extract of the pledges: the duty has arisen and is done.
#ASSERT `האם רשם האגודות השיתופיות חייב להעביר לרשם החברות נסח של השעבודים שיצרה האגודה` TRUE TRUE EQUALS `החובה חלה וקויימה`

-- The Registrar of Companies registering the pledges without fee: the trigger has not happened, so the duty has not arisen.
#ASSERT `האם רשם החברות חייב לרשום את שעבודי האגודה בלא אגרה` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`

-- The Registrar of Companies registering the pledges without fee: the duty has arisen and is not done.
#ASSERT `האם רשם החברות חייב לרשום את שעבודי האגודה בלא אגרה` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`

-- The Registrar of Companies registering the pledges without fee: the duty has arisen and is done.
#ASSERT `האם רשם החברות חייב לרשום את שעבודי האגודה בלא אגרה` TRUE TRUE EQUALS `החובה חלה וקויימה`

-- The society was registered as a company: its assets and liabilities pass to the company.
#ASSERT (`מה קורה לנכסי האגודה, לחיוביה ולהליכיה המשפטיים כשהיא נרשמת כחברה` TRUE)'s `כלל הנכסים והחיובים של האגודה, לרבות חיובים ידועים ובלתי ידועים, קיימים ומותנים, עוברים לחברה`

-- The society was registered as a company: its legal proceedings can be continued with the company as the party.
#ASSERT (`מה קורה לנכסי האגודה, לחיוביה ולהליכיה המשפטיים כשהיא נרשמת כחברה` TRUE)'s `ניתן להמשיך בהליכים המשפטיים שהאגודה צד להם כך שהחברה תהיה הצד להם`

-- The society has not been registered as a company: nothing passes.
#ASSERT NOT ((`מה קורה לנכסי האגודה, לחיוביה ולהליכיה המשפטיים כשהיא נרשמת כחברה` FALSE)'s `כלל הנכסים והחיובים של האגודה, לרבות חיובים ידועים ובלתי ידועים, קיימים ומותנים, עוברים לחברה`)

-- The society has not been registered: no proceedings pass either.
#ASSERT NOT ((`מה קורה לנכסי האגודה, לחיוביה ולהליכיה המשפטיים כשהיא נרשמת כחברה` FALSE)'s `ניתן להמשיך בהליכים המשפטיים שהאגודה צד להם כך שהחברה תהיה הצד להם`)
