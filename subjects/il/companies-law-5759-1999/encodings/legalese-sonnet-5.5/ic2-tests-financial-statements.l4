IMPORT prelude
IMPORT `ic-core`
IMPORT `ic2-tests-fixtures`
IMPORT `ic2-p4c3-reporting`
IMPORT `ic2-p4c5a-auditor-appointment`
IMPORT `ic2-p4c6-financial-statements`

-- Tests of ic2-p4c6-financial-statements.l4 (sections 171 to 175). Expected values are written from the text of the section named beside each.

§ `בדיקות: דוחות כספיים`

§§ `סעיף 171`

-- 171(א) and (ב): a reporting corporation keeps accounts and prepares statements under the Securities Law; any other company, under this Law.
#ASSERT `סעיף 171(א) - התאגיד המדווח חייב לנהל חשבונות ולערוך דוחות כספיים לפי חוק ניירות ערך` `דוגמה - חברה ציבורית שהיא תאגיד מדווח`
#ASSERT NOT (`סעיף 171(א) - התאגיד המדווח חייב לנהל חשבונות ולערוך דוחות כספיים לפי חוק ניירות ערך` `דוגמה - חברה פרטית שאינה חברת איגרות חוב`)
#ASSERT `סעיף 171(ב) - החברה שאינה תאגיד מדווח חייבת לנהל חשבונות ולערוך דוחות כספיים לפי חוק זה` `דוגמה - חברה פרטית שאינה חברת איגרות חוב`
#ASSERT NOT (`סעיף 171(ב) - החברה שאינה תאגיד מדווח חייבת לנהל חשבונות ולערוך דוחות כספיים לפי חוק זה` `דוגמה - חברה ציבורית שהיא תאגיד מדווח`)
#ASSERT NOT (`סעיף 171(ב) - החברה שאינה תאגיד מדווח חייבת לנהל חשבונות ולערוך דוחות כספיים לפי חוק זה` `דוגמה - גוף שהתאגד לפי דין אחר`)
-- 171(ג): approval by the board, signature in its name, and presentation to the annual meeting: all three.
#ASSERT `סעיף 171(ג) - הדוחות הכספיים אושרו ונחתמו והובאו כנדרש` TRUE TRUE TRUE
#ASSERT NOT (`סעיף 171(ג) - הדוחות הכספיים אושרו ונחתמו והובאו כנדרש` FALSE TRUE TRUE)
#ASSERT NOT (`סעיף 171(ג) - הדוחות הכספיים אושרו ונחתמו והובאו כנדרש` TRUE FALSE TRUE)
#ASSERT NOT (`סעיף 171(ג) - הדוחות הכספיים אושרו ונחתמו והובאו כנדרש` TRUE TRUE FALSE)

§§ `סעיף 172`

-- 172(א): the statements are for each year, with a balance sheet at 31 December; the auditor audits them.
#ASSERT `סעיף 172(א) - החברה שאינה תאגיד מדווח חייבת לערוך לכל שנה דוחות כספיים` `דוגמה - חברה פרטית שאינה חברת איגרות חוב`
#ASSERT NOT (`סעיף 172(א) - החברה שאינה תאגיד מדווח חייבת לערוך לכל שנה דוחות כספיים` `דוגמה - חברה ציבורית שהיא תאגיד מדווח`)
#ASSERT `סעיף 172(א) - המועד הקובע של שנת הדוחות` 2025 EQUALS YMD 2025 12 31
#ASSERT NOT (`סעיף 172(א) - המועד הקובע של שנת הדוחות` 2025 EQUALS YMD 2025 12 30)
#ASSERT `סעיף 172(א) - רואה החשבון המבקר חייב לבקר את הדוחות`
-- 172(ב): the articles may fix a special date; the year ends on it instead of 31 December.
#ASSERT `סעיף 172(ב) - החברה רשאית לקבוע בתקנונה מועד מיוחד` `דוגמה - חברה פרטית שאינה חברת איגרות חוב`
#ASSERT NOT (`סעיף 172(ב) - החברה רשאית לקבוע בתקנונה מועד מיוחד` `דוגמה - חברה ציבורית שהיא תאגיד מדווח`)
#ASSERT `סעיף 172(א)-(ב) - היום שבו מסתיימת שנת הדוחות` 2025 NOTHING EQUALS YMD 2025 12 31
#ASSERT `סעיף 172(א)-(ב) - היום שבו מסתיימת שנת הדוחות` 2025 (JUST (`תאריך חוזר בשנה` WITH `חודש` IS 6, `יום` IS 30)) EQUALS YMD 2025 6 30
-- 172(ג): six months, or another period in the articles up to nine months; over nine is not a period the Law allows (NOTHING).
#ASSERT `סעיף 172(ג) - התקופה לעריכת הדוחות, בחודשים` NOTHING EQUALS JUST 6
#ASSERT `סעיף 172(ג) - התקופה לעריכת הדוחות, בחודשים` (JUST 9) EQUALS JUST 9
#ASSERT `סעיף 172(ג) - התקופה לעריכת הדוחות, בחודשים` (JUST 3) EQUALS JUST 3
#ASSERT `סעיף 172(ג) - התקופה לעריכת הדוחות, בחודשים` (JUST 10) EQUALS NOTHING
#ASSERT `סעיף 172(ג) - הדוחות נערכו במועד` 6 NOTHING EQUALS JUST TRUE
#ASSERT `סעיף 172(ג) - הדוחות נערכו במועד` 7 NOTHING EQUALS JUST FALSE
#ASSERT `סעיף 172(ג) - הדוחות נערכו במועד` 9 (JUST 9) EQUALS JUST TRUE
#ASSERT `סעיף 172(ג) - הדוחות נערכו במועד` 10 (JUST 9) EQUALS JUST FALSE
#ASSERT `סעיף 172(ג) - הדוחות נערכו במועד` 5 (JUST 12) EQUALS NOTHING
-- 172(ד): generally accepted accounting principles, and a fair reflection.
#ASSERT `סעיף 172(ד) - הדוחות ערוכים כנדרש` TRUE TRUE
#ASSERT NOT (`סעיף 172(ד) - הדוחות ערוכים כנדרש` TRUE FALSE)
#ASSERT NOT (`סעיף 172(ד) - הדוחות ערוכים כנדרש` FALSE TRUE)
-- 172(ה): until the Minister sets otherwise, at least one director signs.
#ASSERT `סעיף 172(ה) - מספר הדירקטורים המזערי החותמים על הדוחות` NOTHING EQUALS 1
#ASSERT `סעיף 172(ה) - מספר הדירקטורים המזערי החותמים על הדוחות` (JUST 2) EQUALS 2
#ASSERT `סעיף 172(ה) - הדוחות נחתמו כנדרש` 1 NOTHING
#ASSERT NOT (`סעיף 172(ה) - הדוחות נחתמו כנדרש` 0 NOTHING)
#ASSERT `סעיף 172(ה) - הדוחות נחתמו כנדרש` 2 (JUST 2)
#ASSERT NOT (`סעיף 172(ה) - הדוחות נחתמו כנדרש` 1 (JUST 2))
-- 172(ו): the details the Minister set override generally accepted accounting principles.
#ASSERT `סעיף 172(ו) - מה קובע את תוכן הדוחות לגבי הפרט` TRUE EQUALS `הפרטים שקבע השר`
#ASSERT `סעיף 172(ו) - מה קובע את תוכן הדוחות לגבי הפרט` FALSE EQUALS `כללי חשבונאות מקובלים`
-- 172(ז): an inactive company may resolve that it need not prepare statements, unless holders of 10% or more of the issued capital opposed.
#ASSERT `סעיף 172(ז) - החברה הלא פעילה פטורה מחובת עריכת הדוחות` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `מחזור - ללא סכום מעודכן` TRUE 0.09
#ASSERT NOT (`סעיף 172(ז) - החברה הלא פעילה פטורה מחובת עריכת הדוחות` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `מחזור - ללא סכום מעודכן` TRUE 0.1)
#ASSERT NOT (`סעיף 172(ז) - החברה הלא פעילה פטורה מחובת עריכת הדוחות` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `מחזור - ללא סכום מעודכן` FALSE 0)
#ASSERT NOT (`סעיף 172(ז) - החברה הלא פעילה פטורה מחובת עריכת הדוחות` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `מחזור - מעל הסכום הבסיסי ללא סכום מעודכן` TRUE 0)
#ASSERT NOT (`סעיף 172(ז) - החברה הלא פעילה פטורה מחובת עריכת הדוחות` `דוגמה - חברה פרטית שהיא חברת איגרות חוב ואינה תאגיד מדווח` `מחזור - ללא סכום מעודכן` TRUE 0)
#ASSERT NOT (`סעיף 172(ז) - ההחלטה גורעת מחובה לפי דין אחר לערוך או להגיש דוחות`)

§§ `סעיפים 173 עד 175`

-- 173(א) and (ב): the board brings the statements and the explanatory report before the annual meeting; in a section 61 company it sends the statements to the shareholders.
#ASSERT `סעיף 173(א) - הדירקטוריון חייב להביא את הדוחות בפני האסיפה השנתית` `דוגמה - חברה פרטית שאינה חברת איגרות חוב`
#ASSERT NOT (`סעיף 173(א) - הדירקטוריון חייב להביא את הדוחות בפני האסיפה השנתית` `דוגמה - חברה ציבורית שהיא תאגיד מדווח`)
#ASSERT `סעיף 173(א) - הדירקטוריון חייב לשלוח את הדוחות לבעלי המניות` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` TRUE
#ASSERT NOT (`סעיף 173(א) - הדירקטוריון חייב לשלוח את הדוחות לבעלי המניות` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` FALSE)
#ASSERT `סעיף 173(ב) - הדירקטוריון חייב להביא בפני האסיפה השנתית דין וחשבון הסברים` `דוגמה - חברה פרטית שאינה חברת איגרות חוב`
#ASSERT NOT (`סעיף 173(ב) - הדירקטוריון חייב להביא בפני האסיפה השנתית דין וחשבון הסברים` `דוגמה - חברה ציבורית שהיא תאגיד מדווח`)
-- 173(ג): seven years at the registered office; open to directors and shareholders.
#ASSERT `סעיף 173(ג) - מספר השנים המזערי לשמירת הדוחות` EQUALS 7
#ASSERT `סעיף 173(ג) - הדוחות חייבים עדיין להישמר` 7
#ASSERT NOT (`סעיף 173(ג) - הדוחות חייבים עדיין להישמר` 8)
#ASSERT `סעיף 173(ג) - האדם זכאי לעיין בדוחות השמורים במשרד הרשום` TRUE FALSE
#ASSERT `סעיף 173(ג) - האדם זכאי לעיין בדוחות השמורים במשרד הרשום` FALSE TRUE
#ASSERT NOT (`סעיף 173(ג) - האדם זכאי לעיין בדוחות השמורים במשרד הרשום` FALSE FALSE)
-- 173(ד): a shareholder in a company that is not a reporting corporation may have a copy.
#ASSERT `סעיף 173(ד) - בעל המניה זכאי לקבל העתק מהדוחות ומחוות דעתו של רואה החשבון המבקר` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` TRUE
#ASSERT NOT (`סעיף 173(ד) - בעל המניה זכאי לקבל העתק מהדוחות ומחוות דעתו של רואה החשבון המבקר` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` TRUE)
#ASSERT NOT (`סעיף 173(ד) - בעל המניה זכאי לקבל העתק מהדוחות ומחוות דעתו של רואה החשבון המבקר` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` FALSE)
-- 173(ה): a private company that is not a reporting corporation sends copies at least fourteen days before the annual meeting, unless the articles say otherwise.
#ASSERT `סעיף 173(ה) - מספר הימים המזערי לפני האסיפה השנתית לשליחת העתקי הדוחות` EQUALS 14
#ASSERT `סעיף 173(ה) - חלה חובת שליחת העתקי הדוחות לכל הזכאים לקבל הודעה על אסיפות כלליות` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` FALSE
#ASSERT NOT (`סעיף 173(ה) - חלה חובת שליחת העתקי הדוחות לכל הזכאים לקבל הודעה על אסיפות כלליות` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` TRUE)
#ASSERT NOT (`סעיף 173(ה) - חלה חובת שליחת העתקי הדוחות לכל הזכאים לקבל הודעה על אסיפות כלליות` `דוגמה - חברה ציבורית שאינה תאגיד מדווח` FALSE)
#ASSERT `סעיף 173(ה) - העתקי הדוחות נשלחו במועד` 14
#ASSERT `סעיף 173(ה) - העתקי הדוחות נשלחו במועד` 30
#ASSERT NOT (`סעיף 173(ה) - העתקי הדוחות נשלחו במועד` 13)
-- 174: the board declares in the annual report that it complied with 173(א); the annual report belongs to a company that is not a reporting corporation.
#ASSERT `סעיף 174 - הדירקטוריון חייב להצהיר בדין וחשבון השנתי כי מילא אחר סעיף 173(א)` `דוגמה - חברה פרטית שאינה חברת איגרות חוב`
#ASSERT NOT (`סעיף 174 - הדירקטוריון חייב להצהיר בדין וחשבון השנתי כי מילא אחר סעיף 173(א)` `דוגמה - חברה ציבורית שהיא תאגיד מדווח`)
-- 175(א): the balance sheet is attached if at least one of the three conditions holds; if the articles restrict transfer, prohibit a public offer and limit the holders to fifty, it is not.
#ASSERT `סעיף 175(א) - החברה חייבת לצרף את המאזן לדין וחשבון השנתי` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` FALSE TRUE TRUE
#ASSERT `סעיף 175(א) - החברה חייבת לצרף את המאזן לדין וחשבון השנתי` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` TRUE FALSE TRUE
#ASSERT `סעיף 175(א) - החברה חייבת לצרף את המאזן לדין וחשבון השנתי` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` TRUE TRUE FALSE
#ASSERT NOT (`סעיף 175(א) - החברה חייבת לצרף את המאזן לדין וחשבון השנתי` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` TRUE TRUE TRUE)
#ASSERT NOT (`סעיף 175(א) - החברה חייבת לצרף את המאזן לדין וחשבון השנתי` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` FALSE FALSE FALSE)
-- 175(א)(3): joint holders count once: 40 individual holders and 3 joint holdings count 43.
#ASSERT `סעיף 175(א)(3) - מספר בעלי המניות לענין הפסקה` 40 3 EQUALS 43
