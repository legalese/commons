IMPORT prelude
IMPORT `ic-core`
IMPORT `ic6-schedule-3`

-- Tests of ic6-schedule-3.l4 (the Third Schedule). Expected values are written by hand from the items.

§ `בדיקות – התוספת השלישית: דרכי השקעה של קרן לתועלת הציבור`

§§ `פרט 1: הגדרות`

#ASSERT `תוספת 3 פרט 1 - איגרת חוב סחירה` TRUE TRUE
#ASSERT NOT (`תוספת 3 פרט 1 - איגרת חוב סחירה` TRUE FALSE)
#ASSERT NOT (`תוספת 3 פרט 1 - איגרת חוב סחירה` FALSE TRUE)
#ASSERT `תוספת 3 פרט 1 - דירוג` TRUE TRUE
#ASSERT NOT (`תוספת 3 פרט 1 - דירוג` TRUE FALSE)
#ASSERT NOT (`תוספת 3 פרט 1 - דירוג` FALSE TRUE)
#ASSERT `תוספת 3 פרט 1 - תקופת ההשקעה היא חלק מדרך ההשקעה` TRUE
#ASSERT `תוספת 3 פרט 1 - מנפיק` TRUE FALSE
#ASSERT NOT (`תוספת 3 פרט 1 - מנפיק` TRUE TRUE)
#ASSERT NOT (`תוספת 3 פרט 1 - מנפיק` FALSE FALSE)

§§ `פרט 2(א): הדרכים המותרות`

-- Ways (1) to (5): permitted. Way (6): a tradable, non-convertible bond rated A- or A-2 at least. Way (7): a mutual fund all of whose assets are in ways (1), (2), (4) or (6). Any other way: not permitted.
#ASSERT `תוספת 3 פרט 2(א) - דרך ההשקעה מותרת` `איגרות חוב שהנפיקה המדינה או שהיא ערבה לפרעונן` FALSE FALSE FALSE
#ASSERT `תוספת 3 פרט 2(א) - דרך ההשקעה מותרת` `פיקדונות בנקאיים בשקלים חדשים צמודי מדד ונושאי ריבית או נושאי ריבית בלבד` FALSE FALSE FALSE
#ASSERT `תוספת 3 פרט 2(א) - דרך ההשקעה מותרת` `תכניות חיסכון בנקאיות בשקלים חדשים צמודות מדד ונושאות ריבית` FALSE FALSE FALSE
#ASSERT `תוספת 3 פרט 2(א) - דרך ההשקעה מותרת` `פיקדונות בנקאיים הנקובים במטבע חוץ או הצמודים למטבע חוץ` FALSE FALSE FALSE
#ASSERT `תוספת 3 פרט 2(א) - דרך ההשקעה מותרת` `תכניות חיסכון בנקאיות צמודות מטבע חוץ` FALSE FALSE FALSE
#ASSERT `תוספת 3 פרט 2(א) - דרך ההשקעה מותרת` `איגרות חוב סחירות שאינן להמרה, אם ההשקעה מדורגת בדירוג A- או A-2 לפחות` TRUE TRUE FALSE
#ASSERT NOT (`תוספת 3 פרט 2(א) - דרך ההשקעה מותרת` `איגרות חוב סחירות שאינן להמרה, אם ההשקעה מדורגת בדירוג A- או A-2 לפחות` TRUE FALSE FALSE)
#ASSERT NOT (`תוספת 3 פרט 2(א) - דרך ההשקעה מותרת` `איגרות חוב סחירות שאינן להמרה, אם ההשקעה מדורגת בדירוג A- או A-2 לפחות` FALSE TRUE FALSE)
#ASSERT `תוספת 3 פרט 2(א) - דרך ההשקעה מותרת` `קרנות נאמנות שכל נכסיהן מושקעים באחת או יותר מן הדרכים המפורטות בפסקאות (1), (2), (4) או (6)` FALSE FALSE TRUE
#ASSERT NOT (`תוספת 3 פרט 2(א) - דרך ההשקעה מותרת` `קרנות נאמנות שכל נכסיהן מושקעים באחת או יותר מן הדרכים המפורטות בפסקאות (1), (2), (4) או (6)` FALSE FALSE FALSE)
#ASSERT NOT (`תוספת 3 פרט 2(א) - דרך ההשקעה מותרת` `דרך השקעה אחרת` TRUE TRUE TRUE)

§§ `פרט 2(ב): מגבלות הריכוז`

-- 20 percent of 1,000,000 is 200,000: exactly that is allowed, one more is not.
#ASSERT `תוספת 3 פרט 2(ב) - ההשקעה בניירות ערך של מנפיק אחד אינה עולה על 20%` 200_000 1_000_000
#ASSERT NOT (`תוספת 3 פרט 2(ב) - ההשקעה בניירות ערך של מנפיק אחד אינה עולה על 20%` 200_001 1_000_000)
-- The ceiling for one corporation: none up to 1,000,000; 50 percent above that; 25 percent above 10,000,000.
#ASSERT `תוספת 3 פרט 2(ב) - השיעור המרבי להשקעה בתאגיד אחד` 1_000_000 EQUALS NOTHING
#ASSERT `תוספת 3 פרט 2(ב) - השיעור המרבי להשקעה בתאגיד אחד` 1_000_001 EQUALS JUST (50%)
#ASSERT `תוספת 3 פרט 2(ב) - השיעור המרבי להשקעה בתאגיד אחד` 10_000_000 EQUALS JUST (50%)
#ASSERT `תוספת 3 פרט 2(ב) - השיעור המרבי להשקעה בתאגיד אחד` 10_000_001 EQUALS JUST (25%)
-- 2,000,000: 50 percent is 1,000,000; 20,000,000: 25 percent is 5,000,000; 500,000: no ceiling of this kind.
#ASSERT `תוספת 3 פרט 2(ב) - ההשקעה בתאגיד אחד מותרת` 1_000_000 2_000_000
#ASSERT NOT (`תוספת 3 פרט 2(ב) - ההשקעה בתאגיד אחד מותרת` 1_000_001 2_000_000)
#ASSERT `תוספת 3 פרט 2(ב) - ההשקעה בתאגיד אחד מותרת` 5_000_000 20_000_000
#ASSERT NOT (`תוספת 3 פרט 2(ב) - ההשקעה בתאגיד אחד מותרת` 5_000_001 20_000_000)
#ASSERT `תוספת 3 פרט 2(ב) - ההשקעה בתאגיד אחד מותרת` 500_000 500_000

§§ `פרט 2(ג) עד (ה)`

-- (ג): a committee was appointed, the funds go through it, the way is permitted, and no connected person or aggregated control stops it.
#ASSERT `תוספת 3 פרט 2(ג) - ועדת ההשקעות רשאית להשקיע בתאגיד` TRUE TRUE TRUE FALSE FALSE
#ASSERT NOT (`תוספת 3 פרט 2(ג) - ועדת ההשקעות רשאית להשקיע בתאגיד` FALSE TRUE TRUE FALSE FALSE)
#ASSERT NOT (`תוספת 3 פרט 2(ג) - ועדת ההשקעות רשאית להשקיע בתאגיד` TRUE FALSE TRUE FALSE FALSE)
#ASSERT NOT (`תוספת 3 פרט 2(ג) - ועדת ההשקעות רשאית להשקיע בתאגיד` TRUE TRUE FALSE FALSE FALSE)
#ASSERT NOT (`תוספת 3 פרט 2(ג) - ועדת ההשקעות רשאית להשקיע בתאגיד` TRUE TRUE TRUE TRUE FALSE)
#ASSERT NOT (`תוספת 3 פרט 2(ג) - ועדת ההשקעות רשאית להשקיע בתאגיד` TRUE TRUE TRUE FALSE TRUE)
-- (ד): the request is in writing and gives all six details (and the further information needed); the Registrar of Endowments may approve only on such a request.
#ASSERT `תוספת 3 פרט 2(ד) - הבקשה לאישור דרך השקעה אחרת עומדת בדרישות` TRUE TRUE TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`תוספת 3 פרט 2(ד) - הבקשה לאישור דרך השקעה אחרת עומדת בדרישות` FALSE TRUE TRUE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`תוספת 3 פרט 2(ד) - הבקשה לאישור דרך השקעה אחרת עומדת בדרישות` TRUE FALSE TRUE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`תוספת 3 פרט 2(ד) - הבקשה לאישור דרך השקעה אחרת עומדת בדרישות` TRUE TRUE FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`תוספת 3 פרט 2(ד) - הבקשה לאישור דרך השקעה אחרת עומדת בדרישות` TRUE TRUE TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`תוספת 3 פרט 2(ד) - הבקשה לאישור דרך השקעה אחרת עומדת בדרישות` TRUE TRUE TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`תוספת 3 פרט 2(ד) - הבקשה לאישור דרך השקעה אחרת עומדת בדרישות` TRUE TRUE TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`תוספת 3 פרט 2(ד) - הבקשה לאישור דרך השקעה אחרת עומדת בדרישות` TRUE TRUE TRUE TRUE TRUE TRUE FALSE)
#ASSERT `תוספת 3 פרט 2(ד) - רשם ההקדשות רשאי לאשר מראש דרך השקעה אחרת` TRUE TRUE
#ASSERT NOT (`תוספת 3 פרט 2(ד) - רשם ההקדשות רשאי לאשר מראש דרך השקעה אחרת` FALSE TRUE)
#ASSERT NOT (`תוספת 3 פרט 2(ד) - רשם ההקדשות רשאי לאשר מראש דרך השקעה אחרת` TRUE FALSE)
-- (ה).
#ASSERT `תוספת 3 פרט 2(ה) - דרך ההשקעה נבחרה כנדרש` TRUE TRUE
#ASSERT NOT (`תוספת 3 פרט 2(ה) - דרך ההשקעה נבחרה כנדרש` FALSE TRUE)
#ASSERT NOT (`תוספת 3 פרט 2(ה) - דרך ההשקעה נבחרה כנדרש` TRUE FALSE)

§§ `פרטים 3 עד 7`

-- 3: above 30,000,000, or the articles so provide.
#ASSERT NOT (`תוספת 3 פרט 3 - על דירקטוריון הקרן למנות ועדת השקעות` 30_000_000 FALSE)
#ASSERT `תוספת 3 פרט 3 - על דירקטוריון הקרן למנות ועדת השקעות` 30_000_001 FALSE
#ASSERT `תוספת 3 פרט 3 - על דירקטוריון הקרן למנות ועדת השקעות` 1_000 TRUE
-- 4(א)(1): ineligible with an affinity at the time; not with none.
#ASSERT `תוספת 3 פרט 4(א)(1) - האדם אינו כשיר לכהן בוועדת ההשקעות` TRUE TRUE
#ASSERT NOT (`תוספת 3 פרט 4(א)(1) - האדם אינו כשיר לכהן בוועדת ההשקעות` FALSE TRUE)
#ASSERT NOT (`תוספת 3 פרט 4(א)(1) - האדם אינו כשיר לכהן בוועדת ההשקעות` TRUE FALSE)
-- 4(א)(2): with 5 members, 3 without such an affinity is a majority; 2 is not; with 4 members, 2 is not.
#ASSERT `תוספת 3 פרט 4(א)(2) - דירקטור בלתי תלוי יכול להיות חבר בוועדת ההשקעות` 5 3
#ASSERT NOT (`תוספת 3 פרט 4(א)(2) - דירקטור בלתי תלוי יכול להיות חבר בוועדת ההשקעות` 5 2)
#ASSERT NOT (`תוספת 3 פרט 4(א)(2) - דירקטור בלתי תלוי יכול להיות חבר בוועדת ההשקעות` 4 2)
#ASSERT `תוספת 3 פרט 4(א)(2) - דירקטור בלתי תלוי יכול להיות חבר בוועדת ההשקעות` 4 3
-- 5.
#ASSERT `תוספת 3 פרט 5 - חבר הוועדה חב חובת זהירות וחובת אמונים וזכאי למידע וליועצים` TRUE
#ASSERT NOT (`תוספת 3 פרט 5 - חבר הוועדה חב חובת זהירות וחובת אמונים וזכאי למידע וליועצים` FALSE)
-- 6: all four quarters, or, with the board's approval of another frequency, at least two meetings.
#ASSERT `תוספת 3 פרט 6 - הוועדה התכנסה בתכיפות הנדרשת` 4 4 FALSE
#ASSERT NOT (`תוספת 3 פרט 6 - הוועדה התכנסה בתכיפות הנדרשת` 3 6 FALSE)
#ASSERT `תוספת 3 פרט 6 - הוועדה התכנסה בתכיפות הנדרשת` 2 2 TRUE
#ASSERT NOT (`תוספת 3 פרט 6 - הוועדה התכנסה בתכיפות הנדרשת` 1 1 TRUE)
#ASSERT `תוספת 3 פרט 6 - הוועדה עמדה בחובות הנהלים והדיווח` TRUE TRUE TRUE
#ASSERT NOT (`תוספת 3 פרט 6 - הוועדה עמדה בחובות הנהלים והדיווח` FALSE TRUE TRUE)
#ASSERT NOT (`תוספת 3 פרט 6 - הוועדה עמדה בחובות הנהלים והדיווח` TRUE FALSE TRUE)
#ASSERT NOT (`תוספת 3 פרט 6 - הוועדה עמדה בחובות הנהלים והדיווח` TRUE TRUE FALSE)
-- A decision needs more than half of the members present: 3 of 5 yes; 2 of 5 no; 2 of 4 no.
#ASSERT `תוספת 3 פרט 6 - ההחלטה התקבלה ברוב קולות החברים הנוכחים` 5 3
#ASSERT NOT (`תוספת 3 פרט 6 - ההחלטה התקבלה ברוב קולות החברים הנוכחים` 5 2)
#ASSERT NOT (`תוספת 3 פרט 6 - ההחלטה התקבלה ברוב קולות החברים הנוכחים` 4 2)
-- 7: 0.5 percent of 1,000,000 is 5,000.
#ASSERT `תוספת 3 פרט 7 - דמי הניהול, ההוצאות והשכר אינם עולים על 0.5 אחוז` 5_000 1_000_000
#ASSERT NOT (`תוספת 3 פרט 7 - דמי הניהול, ההוצאות והשכר אינם עולים על 0.5 אחוז` 5_001 1_000_000)
