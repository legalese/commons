IMPORT prelude
IMPORT daydate
IMPORT `ic-core`
IMPORT `ic-core-people`
IMPORT `ic-core-deals`
IMPORT `ic3-tests-fixtures`
IMPORT `ic3-part6-ch2-appointment`
IMPORT `ic3-part6-ch4a-compensation-policy`
IMPORT `ic3-part6-ch5-interested-transactions`

-- ic3-tests-part6-ch5-a: tests of ic3-part6-ch5-interested-transactions.l4, sections 268 to 270 (src:1820-1844).
-- Every expected value is written from the text before the code was run, never copied from the code's output.

§ `בדיקות: חלק 6 פרק 5, סעיפים 268 עד 270`

§§ `מקרי בדיקה משותפים`

-- A person's tie to the company, with the same fraction held in the share capital and in the voting rights: holding, control as the
-- Securities Law means it.
GIVEN h IS A NUMBER, c IS A BOOLEAN
GIVETH A `קשר לחברה`
`ic3 - קשר לחברה` MEANS `קשר לחברה` WITH
    `החזקה בהון המניות המונפק` IS h
    `החזקה בזכויות ההצבעה` IS h
    `סמכות למנות דירקטור אחד או יותר` IS FALSE
    `סמכות למנות את המנהל הכללי` IS FALSE
    `מכהן כדירקטור` IS FALSE
    `מכהן כמנהל כללי` IS FALSE
    `שליטה לפי חוק ניירות ערך` IS c

-- Interests: an interest in the transaction; none; one that arises only from holding shares in the company.
`ic3 - יש עניין` MEANS `עניין` WITH `עניין בפעולה או בעסקה של החברה` IS TRUE, `העניין נובע מעצם החזקת מניות בחברה` IS FALSE
`ic3 - אין עניין` MEANS `עניין` WITH `עניין בפעולה או בעסקה של החברה` IS FALSE, `העניין נובע מעצם החזקת מניות בחברה` IS FALSE
`ic3 - עניין מהחזקת מניות בלבד` MEANS `עניין` WITH `עניין בפעולה או בעסקה של החברה` IS TRUE, `העניין נובע מעצם החזקת מניות בחברה` IS TRUE

-- The three interests the definition of "personal interest" counts: the person's own, a relative's, another corporation's.
GIVEN a IS AN `עניין`, b IS AN `עניין`, c IS AN `עניין`
GIVETH A `עובדות לענין אישי`
`ic3 - שלושה ענינים` MEANS `עובדות לענין אישי` WITH
    `עניינו של האדם` IS a
    `עניינו של קרובו` IS b
    `עניינו של תאגיד אחר שהאדם או קרובו הם בעלי ענין בו` IS c

`ic3 - ענינו של האדם עצמו` MEANS `ic3 - שלושה ענינים` `ic3 - יש עניין` `ic3 - אין עניין` `ic3 - אין עניין`
`ic3 - ענינו של קרוב בלבד` MEANS `ic3 - שלושה ענינים` `ic3 - אין עניין` `ic3 - יש עניין` `ic3 - אין עניין`
`ic3 - אין ענין כלל` MEANS `ic3 - שלושה ענינים` `ic3 - אין עניין` `ic3 - אין עניין` `ic3 - אין עניין`
`ic3 - ענין מהחזקת מניות בלבד` MEANS `ic3 - שלושה ענינים` `ic3 - עניין מהחזקת מניות בלבד` `ic3 - אין עניין` `ic3 - אין עניין`

-- Transactions as section 1 sees them: one in the ordinary course on market terms with no material effect; one outside the ordinary course.
`ic3 - עסקה רגילה` MEANS `עובדות על עסקה` WITH
    `חוזה או התקשרות` IS TRUE
    `החלטה חד צדדית של חברה בדבר הענקת זכות או טובת הנאה אחרת` IS FALSE
    `במהלך העסקים הרגיל של החברה` IS TRUE
    `בתנאי שוק` IS TRUE
    `עשויה להשפיע באופן מהותי על רווחיות החברה, רכושה או התחייבויותיה` IS FALSE
`ic3 - עסקה חריגה` MEANS `עובדות על עסקה` WITH
    `חוזה או התקשרות` IS TRUE
    `החלטה חד צדדית של חברה בדבר הענקת זכות או טובת הנאה אחרת` IS FALSE
    `במהלך העסקים הרגיל של החברה` IS FALSE
    `בתנאי שוק` IS TRUE
    `עשויה להשפיע באופן מהותי על רווחיות החברה, רכושה או התחייבויותיה` IS FALSE

§§ `סעיף 268: בעל שליטה`

-- Control as the Securities Law means it makes a controlling shareholder with no holding test at all (src:1821).
#ASSERT `סעיף 268 - בעל שליטה לענין פרק זה` (`ic3 - קשר לחברה` 0.05 TRUE) FALSE EMPTY 0
-- Holding 25% of the voting rights, when no other person holds more than 50%, also makes one: exactly 25% suffices.
#ASSERT `סעיף 268 - בעל שליטה לענין פרק זה` (`ic3 - קשר לחברה` 0.25 FALSE) FALSE EMPTY 0.5
#ASSERT NOT (`סעיף 268 - בעל שליטה לענין פרק זה` (`ic3 - קשר לחברה` 0.2499 FALSE) FALSE EMPTY 0.3)
-- Another person holds more than 50%: the 25% limb does not apply; exactly 50% is not "more than 50%".
#ASSERT NOT (`סעיף 268 - בעל שליטה לענין פרק זה` (`ic3 - קשר לחברה` 0.3 FALSE) FALSE EMPTY 0.51)
#ASSERT `סעיף 268 - בעל שליטה לענין פרק זה` (`ic3 - קשר לחברה` 0.3 FALSE) FALSE EMPTY 0.5
-- Two or more holders who each have a personal interest in approving the transaction count as holding together:
-- 15% and 10% make 25%.
#ASSERT `סעיף 268 - בעל שליטה לענין פרק זה` (`ic3 - קשר לחברה` 0.15 FALSE) TRUE (LIST 0.1) 0.15
-- The same holdings when the person has no personal interest himself: he holds alone, 15%.
#ASSERT NOT (`סעיף 268 - בעל שליטה לענין פרק זה` (`ic3 - קשר לחברה` 0.15 FALSE) FALSE (LIST 0.1) 0.15)
-- Together but still under 25%.
#ASSERT NOT (`סעיף 268 - בעל שליטה לענין פרק זה` (`ic3 - קשר לחברה` 0.1 FALSE) TRUE (LIST 0.05, 0.05) 0.1)
-- Control by the Securities Law beats a large holding by another person.
#ASSERT `סעיף 268 - בעל שליטה לענין פרק זה` (`ic3 - קשר לחברה` 0.01 TRUE) FALSE EMPTY 0.9

§§ `סעיף 269: חובת גילוי`

-- (א): an office-holder who knows he has a personal interest must disclose, in any company.
#ASSERT `סעיף 269(א) - האדם חייב לגלות לחברה את ענינו האישי` `ic3 - חברה פרטית רגילה לדוגמה` TRUE FALSE `ic3 - ענינו של האדם עצמו` TRUE
-- A controlling shareholder must disclose in a public company and in a private bond company, not in another private company.
#ASSERT `סעיף 269(א) - האדם חייב לגלות לחברה את ענינו האישי` `ic3 - חברה ציבורית לדוגמה` FALSE TRUE `ic3 - ענינו של האדם עצמו` TRUE
#ASSERT `סעיף 269(א) - האדם חייב לגלות לחברה את ענינו האישי` `ic3 - חברת איגרות חוב פרטית לדוגמה` FALSE TRUE `ic3 - ענינו של האדם עצמו` TRUE
#ASSERT NOT (`סעיף 269(א) - האדם חייב לגלות לחברה את ענינו האישי` `ic3 - חברה פרטית רגילה לדוגמה` FALSE TRUE `ic3 - ענינו של האדם עצמו` TRUE)
-- Neither an office-holder nor a controlling shareholder: no duty under this section.
#ASSERT NOT (`סעיף 269(א) - האדם חייב לגלות לחברה את ענינו האישי` `ic3 - חברה ציבורית לדוגמה` FALSE FALSE `ic3 - ענינו של האדם עצמו` TRUE)
-- He must know he has the interest.
#ASSERT NOT (`סעיף 269(א) - האדם חייב לגלות לחברה את ענינו האישי` `ic3 - חברה ציבורית לדוגמה` TRUE FALSE `ic3 - ענינו של האדם עצמו` FALSE)
-- An interest that comes only from holding shares in the company is not a personal interest (section 1).
#ASSERT NOT (`סעיף 269(א) - האדם חייב לגלות לחברה את ענינו האישי` `ic3 - חברה ציבורית לדוגמה` TRUE FALSE `ic3 - ענין מהחזקת מניות בלבד` TRUE)
-- A relative's interest counts.
#ASSERT `סעיף 269(א) - האדם חייב לגלות לחברה את ענינו האישי` `ic3 - חברה ציבורית לדוגמה` TRUE FALSE `ic3 - ענינו של קרוב בלבד` TRUE

-- (א), the time: without delay, and on or before the day of the board meeting at which the transaction is first discussed.
#ASSERT `סעיף 269(א) - הגילוי נעשה במועד` TRUE (YMD 2026 3 10) (YMD 2026 3 10)
#ASSERT `סעיף 269(א) - הגילוי נעשה במועד` TRUE (YMD 2026 3 9) (YMD 2026 3 10)
#ASSERT NOT (`סעיף 269(א) - הגילוי נעשה במועד` TRUE (YMD 2026 3 11) (YMD 2026 3 10))
#ASSERT NOT (`סעיף 269(א) - הגילוי נעשה במועד` FALSE (YMD 2026 3 9) (YMD 2026 3 10))

-- (ב): a personal interest that arises only from a relative's interest in a transaction that is not extraordinary: (א) does not apply.
#ASSERT `סעיף 269(ב) - הוראת סעיף קטן (א) אינה חלה` `ic3 - ענינו של קרוב בלבד` `ic3 - עסקה רגילה`
-- The same interest in an extraordinary transaction: (א) still applies.
#ASSERT NOT (`סעיף 269(ב) - הוראת סעיף קטן (א) אינה חלה` `ic3 - ענינו של קרוב בלבד` `ic3 - עסקה חריגה`)
-- The person's own interest: (א) applies.
#ASSERT NOT (`סעיף 269(ב) - הוראת סעיף קטן (א) אינה חלה` `ic3 - ענינו של האדם עצמו` `ic3 - עסקה רגילה`)
-- Both his own and a relative's interest: it does not arise "only" from the relative's.
#ASSERT NOT (`סעיף 269(ב) - הוראת סעיף קטן (א) אינה חלה` (`ic3 - שלושה ענינים` `ic3 - יש עניין` `ic3 - יש עניין` `ic3 - אין עניין`) `ic3 - עסקה רגילה`)
-- No interest at all: there is no personal interest for the exception to be about.
#ASSERT NOT (`סעיף 269(ב) - הוראת סעיף קטן (א) אינה חלה` `ic3 - אין ענין כלל` `ic3 - עסקה רגילה`)

-- (ג): an interested party of section 270(5), or one who becomes a controlling shareholder through a private offer, who knows of his
-- personal interest in the material private offer, must disclose it to the public company.
#ASSERT `סעיף 269(ג) - צד מעוניין חייב לגלות לחברה הציבורית את ענינו האישי` TRUE FALSE `ic3 - ענינו של האדם עצמו` TRUE
#ASSERT `סעיף 269(ג) - צד מעוניין חייב לגלות לחברה הציבורית את ענינו האישי` FALSE TRUE `ic3 - ענינו של האדם עצמו` TRUE
#ASSERT NOT (`סעיף 269(ג) - צד מעוניין חייב לגלות לחברה הציבורית את ענינו האישי` FALSE FALSE `ic3 - ענינו של האדם עצמו` TRUE)
#ASSERT NOT (`סעיף 269(ג) - צד מעוניין חייב לגלות לחברה הציבורית את ענינו האישי` TRUE FALSE `ic3 - ענינו של האדם עצמו` FALSE)
#ASSERT NOT (`סעיף 269(ג) - צד מעוניין חייב לגלות לחברה הציבורית את ענינו האישי` TRUE FALSE `ic3 - אין ענין כלל` TRUE)

§§ `סעיף 270: עסקאות הטעונות אישורים מיוחדים`

-- The lead-in: the transaction must be for the company's benefit to be approved.
#ASSERT `סעיף 270 - אפשר לאשר את העסקה` TRUE
#ASSERT NOT (`סעיף 270 - אפשר לאשר את העסקה` FALSE)

-- Terms of service and employment (section 1): an office-holder's office, an item, and whether it is given by reason of the service.
GIVEN o IS A `משרה`, i IS A `פריט בתנאי כהונה והעסקה`, g IS A BOOLEAN
GIVETH A `סעיף 270 - עובדות על התקשרות באשר לתנאי כהונה והעסקה`
`ic3 - התקשרות על תנאים` MEANS `סעיף 270 - עובדות על התקשרות באשר לתנאי כהונה והעסקה` WITH
    `משרתו של האדם שההתקשרות עמו` IS o
    `הפריט שההתקשרות עוסקת בו` IS i
    `הפריט ניתן בשל כהונה או העסקה` IS g

#ASSERT `סעיף 270 - ההתקשרות היא באשר לתנאי כהונה והעסקה` (`ic3 - התקשרות על תנאים` `מנהל כללי` `ביטוח` TRUE)
#ASSERT NOT (`סעיף 270 - ההתקשרות היא באשר לתנאי כהונה והעסקה` (`ic3 - התקשרות על תנאים` `מנהל כללי` `פריט אחר` TRUE))
#ASSERT NOT (`סעיף 270 - ההתקשרות היא באשר לתנאי כהונה והעסקה` (`ic3 - התקשרות על תנאים` `מנהל כללי` `ביטוח` FALSE))
#ASSERT NOT (`סעיף 270 - ההתקשרות היא באשר לתנאי כהונה והעסקה` (`ic3 - התקשרות על תנאים` `משרה אחרת` `ביטוח` TRUE))

-- (1): a transaction with an office-holder; or with another person in which an office-holder has a personal interest.
-- Arguments: with an office-holder; with another person; the office-holder's interest; parent and wholly-owned subsidiary;
-- the interest arises only from being an office-holder in both or holding shares in the parent; between subsidiaries of one person;
-- the interest arises only from being an office-holder in the contracting companies.
#ASSERT `סעיף 270(1) - מתקיים בעסקה האמור בפסקה` TRUE FALSE `ic3 - אין ענין כלל` FALSE FALSE FALSE FALSE
#ASSERT `סעיף 270(1) - מתקיים בעסקה האמור בפסקה` FALSE TRUE `ic3 - ענינו של האדם עצמו` FALSE FALSE FALSE FALSE
#ASSERT NOT (`סעיף 270(1) - מתקיים בעסקה האמור בפסקה` FALSE TRUE `ic3 - אין ענין כלל` FALSE FALSE FALSE FALSE)
-- An interest that comes only from holding shares is not a personal interest.
#ASSERT NOT (`סעיף 270(1) - מתקיים בעסקה האמור בפסקה` FALSE TRUE `ic3 - ענין מהחזקת מניות בלבד` FALSE FALSE FALSE FALSE)
-- First exception: parent and wholly owned subsidiary, interest only from the double office or the parent's shares.
#ASSERT NOT (`סעיף 270(1) - מתקיים בעסקה האמור בפסקה` FALSE TRUE `ic3 - ענינו של האדם עצמו` TRUE TRUE FALSE FALSE)
-- ... but not when the interest comes from something else.
#ASSERT `סעיף 270(1) - מתקיים בעסקה האמור בפסקה` FALSE TRUE `ic3 - ענינו של האדם עצמו` TRUE FALSE FALSE FALSE
-- Second exception: subsidiaries of the same person, interest only from the offices in the contracting companies.
#ASSERT NOT (`סעיף 270(1) - מתקיים בעסקה האמור בפסקה` FALSE TRUE `ic3 - ענינו של האדם עצמו` FALSE FALSE TRUE TRUE)
#ASSERT `סעיף 270(1) - מתקיים בעסקה האמור בפסקה` FALSE TRUE `ic3 - ענינו של האדם עצמו` FALSE FALSE TRUE FALSE
-- The exceptions concern the interest in a transaction with another person, not a transaction with the office-holder himself.
#ASSERT `סעיף 270(1) - מתקיים בעסקה האמור בפסקה` TRUE FALSE `ic3 - אין ענין כלל` TRUE TRUE TRUE TRUE

-- (2): an engagement with an office-holder who is not a director, about the terms of his service and employment.
#ASSERT `סעיף 270(2) - מתקיים בעסקה האמור בפסקה` TRUE (`ic3 - התקשרות על תנאים` `מנהל כללי` `תנאי כהונה או העסקה כשלעצמם` TRUE)
#ASSERT NOT (`סעיף 270(2) - מתקיים בעסקה האמור בפסקה` TRUE (`ic3 - התקשרות על תנאים` `דירקטור` `תנאי כהונה או העסקה כשלעצמם` TRUE))
#ASSERT NOT (`סעיף 270(2) - מתקיים בעסקה האמור בפסקה` TRUE (`ic3 - התקשרות על תנאים` `משרה אחרת` `תנאי כהונה או העסקה כשלעצמם` TRUE))
#ASSERT NOT (`סעיף 270(2) - מתקיים בעסקה האמור בפסקה` TRUE (`ic3 - התקשרות על תנאים` `מנהל כללי` `פריט אחר` TRUE))
#ASSERT NOT (`סעיף 270(2) - מתקיים בעסקה האמור בפסקה` FALSE (`ic3 - התקשרות על תנאים` `מנהל כללי` `תנאי כהונה או העסקה כשלעצמם` TRUE))

-- (3): an engagement with a director about the terms of his service and employment, as a director and, if he is employed, in other roles.
-- Arguments: engagement with a director; the terms; about his service as a director; employed in other roles; terms about that employment.
#ASSERT `סעיף 270(3) - מתקיים בעסקה האמור בפסקה` TRUE (`ic3 - התקשרות על תנאים` `דירקטור` `ביטוח` TRUE) TRUE FALSE FALSE
#ASSERT `סעיף 270(3) - מתקיים בעסקה האמור בפסקה` TRUE (`ic3 - התקשרות על תנאים` `דירקטור` `ביטוח` TRUE) FALSE TRUE TRUE
#ASSERT NOT (`סעיף 270(3) - מתקיים בעסקה האמור בפסקה` TRUE (`ic3 - התקשרות על תנאים` `דירקטור` `ביטוח` TRUE) FALSE FALSE TRUE)
#ASSERT NOT (`סעיף 270(3) - מתקיים בעסקה האמור בפסקה` TRUE (`ic3 - התקשרות על תנאים` `מנהל כללי` `ביטוח` TRUE) TRUE FALSE FALSE)
#ASSERT NOT (`סעיף 270(3) - מתקיים בעסקה האמור בפסקה` FALSE (`ic3 - התקשרות על תנאים` `דירקטור` `ביטוח` TRUE) TRUE FALSE FALSE)

-- (4) and (4א): the transaction with a controlling shareholder, before the kind of company.
-- Arguments: the transaction; with the controlling shareholder; with another person; a private offer; his interest;
-- an engagement for services; he is also an office-holder; engagement on his terms of service; he is an employee and not an office-holder;
-- engagement on his employment.
#ASSERT `סעיף 270(4) - מתקיים בעסקה של בעל שליטה האמור בפסקה, בלי סוג החברה` `ic3 - עסקה חריגה` TRUE FALSE FALSE `ic3 - אין ענין כלל` FALSE FALSE FALSE FALSE FALSE
-- Not extraordinary and nothing else: no.
#ASSERT NOT (`סעיף 270(4) - מתקיים בעסקה של בעל שליטה האמור בפסקה, בלי סוג החברה` `ic3 - עסקה רגילה` TRUE FALSE FALSE `ic3 - אין ענין כלל` FALSE FALSE FALSE FALSE FALSE)
-- An extraordinary transaction with another person in which the controlling shareholder has a personal interest.
#ASSERT `סעיף 270(4) - מתקיים בעסקה של בעל שליטה האמור בפסקה, בלי סוג החברה` `ic3 - עסקה חריגה` FALSE TRUE FALSE `ic3 - ענינו של האדם עצמו` FALSE FALSE FALSE FALSE FALSE
#ASSERT NOT (`סעיף 270(4) - מתקיים בעסקה של בעל שליטה האמור בפסקה, בלי סוג החברה` `ic3 - עסקה חריגה` FALSE TRUE FALSE `ic3 - אין ענין כלל` FALSE FALSE FALSE FALSE FALSE)
-- A private offer in which he has a personal interest (read as covered even if not itself extraordinary, fork F3).
#ASSERT `סעיף 270(4) - מתקיים בעסקה של בעל שליטה האמור בפסקה, בלי סוג החברה` `ic3 - עסקה רגילה` FALSE FALSE TRUE `ic3 - ענינו של האדם עצמו` FALSE FALSE FALSE FALSE FALSE
#ASSERT NOT (`סעיף 270(4) - מתקיים בעסקה של בעל שליטה האמור בפסקה, בלי סוג החברה` `ic3 - עסקה רגילה` FALSE FALSE TRUE `ic3 - אין ענין כלל` FALSE FALSE FALSE FALSE FALSE)
-- An engagement with him or a relative for services the company receives.
#ASSERT `סעיף 270(4) - מתקיים בעסקה של בעל שליטה האמור בפסקה, בלי סוג החברה` `ic3 - עסקה רגילה` FALSE FALSE FALSE `ic3 - אין ענין כלל` TRUE FALSE FALSE FALSE FALSE
-- If he is also an office-holder, an engagement about his terms of service; if he is an employee and not an office-holder, about his employment.
#ASSERT `סעיף 270(4) - מתקיים בעסקה של בעל שליטה האמור בפסקה, בלי סוג החברה` `ic3 - עסקה רגילה` FALSE FALSE FALSE `ic3 - אין ענין כלל` FALSE TRUE TRUE FALSE FALSE
#ASSERT NOT (`סעיף 270(4) - מתקיים בעסקה של בעל שליטה האמור בפסקה, בלי סוג החברה` `ic3 - עסקה רגילה` FALSE FALSE FALSE `ic3 - אין ענין כלל` FALSE FALSE TRUE FALSE FALSE)
#ASSERT `סעיף 270(4) - מתקיים בעסקה של בעל שליטה האמור בפסקה, בלי סוג החברה` `ic3 - עסקה רגילה` FALSE FALSE FALSE `ic3 - אין ענין כלל` FALSE FALSE FALSE TRUE TRUE
#ASSERT NOT (`סעיף 270(4) - מתקיים בעסקה של בעל שליטה האמור בפסקה, בלי סוג החברה` `ic3 - עסקה רגילה` FALSE FALSE FALSE `ic3 - אין ענין כלל` FALSE FALSE FALSE TRUE FALSE)
#ASSERT NOT (`סעיף 270(4) - מתקיים בעסקה של בעל שליטה האמור בפסקה, בלי סוג החברה` `ic3 - עסקה רגילה` FALSE FALSE FALSE `ic3 - אין ענין כלל` FALSE TRUE FALSE FALSE TRUE)
-- The kind of company: (4) is a public company, (4א) a private bond company.
#ASSERT `סעיף 270(4) - מתקיים בעסקה של חברה ציבורית האמור בפסקה` `ic3 - חברה ציבורית לדוגמה` TRUE
#ASSERT NOT (`סעיף 270(4) - מתקיים בעסקה של חברה ציבורית האמור בפסקה` `ic3 - חברת איגרות חוב פרטית לדוגמה` TRUE)
#ASSERT NOT (`סעיף 270(4) - מתקיים בעסקה של חברה ציבורית האמור בפסקה` `ic3 - חברה ציבורית לדוגמה` FALSE)
#ASSERT `סעיף 270(4א) - מתקיים בעסקה של חברה פרטית שהיא חברת איגרות חוב האמור בפסקה` `ic3 - חברת איגרות חוב פרטית לדוגמה` TRUE
#ASSERT NOT (`סעיף 270(4א) - מתקיים בעסקה של חברה פרטית שהיא חברת איגרות חוב האמור בפסקה` `ic3 - חברה ציבורית לדוגמה` TRUE)
#ASSERT NOT (`סעיף 270(4א) - מתקיים בעסקה של חברה פרטית שהיא חברת איגרות חוב האמור בפסקה` `ic3 - חברה פרטית רגילה לדוגמה` TRUE)

-- (5)(ג): market terms. The board's detailed determination stands unless the contrary is proved; otherwise the fact decides.
#ASSERT `סעיף 270(5)(ג) - ההצעה נחשבת הצעה בתנאי שוק` TRUE FALSE FALSE
#ASSERT NOT (`סעיף 270(5)(ג) - ההצעה נחשבת הצעה בתנאי שוק` TRUE TRUE FALSE)
#ASSERT `סעיף 270(5)(ג) - ההצעה נחשבת הצעה בתנאי שוק` TRUE TRUE TRUE
#ASSERT `סעיף 270(5)(ג) - ההצעה נחשבת הצעה בתנאי שוק` FALSE FALSE TRUE
#ASSERT NOT (`סעיף 270(5)(ג) - ההצעה נחשבת הצעה בתנאי שוק` FALSE FALSE FALSE)

-- (5)(ב): offers that count as one. Arguments: months; same offeree; same asset; part of one transaction or conditional on each other.
#ASSERT `סעיף 270(5)(ב) - ההצעות נחשבות הצעה פרטית אחת` 12 TRUE FALSE FALSE
#ASSERT NOT (`סעיף 270(5)(ב) - ההצעות נחשבות הצעה פרטית אחת` 13 TRUE FALSE FALSE)
#ASSERT `סעיף 270(5)(ב) - ההצעות נחשבות הצעה פרטית אחת` 12 FALSE TRUE FALSE
#ASSERT NOT (`סעיף 270(5)(ב) - ההצעות נחשבות הצעה פרטית אחת` 12 FALSE FALSE FALSE)
#ASSERT `סעיף 270(5)(ב) - ההצעות נחשבות הצעה פרטית אחת` 30 FALSE FALSE TRUE
#ASSERT `סעיף 270(5)(ב) - סך זכויות ההצבעה שההצעות הנחשבות הצעה אחת מקנות` 0.12 (LIST 0.05, 0.04) EQUALS 0.21
#ASSERT `סעיף 270(5)(ב) - סך זכויות ההצבעה שההצעות הנחשבות הצעה אחת מקנות` 0.12 EMPTY EQUALS 0.12

-- (5)(א)(1): the offer gives 20% or more of the voting rights existing before the issue; its consideration is not entirely cash or
-- listed securities or it is not on market terms; and a material shareholder's holdings grow or a person becomes a material shareholder.
-- Arguments: share of the voting rights; all cash or listed securities; on market terms; the offeree's tie before; his tie after.
-- A person at 4% (not material) goes to 6% (material) by an offer of 20% paid in property: yes.
#ASSERT `סעיף 270(5)(א)(1) - מתקיים בהצעה האמור בפסקת משנה, והמקבל הוא צד מעוניין` 0.2 FALSE TRUE (`ic3 - קשר לחברה` 0.04 FALSE) (`ic3 - קשר לחברה` 0.06 FALSE)
-- 19.9% is under the 20% threshold.
#ASSERT NOT (`סעיף 270(5)(א)(1) - מתקיים בהצעה האמור בפסקת משנה, והמקבל הוא צד מעוניין` 0.199 FALSE TRUE (`ic3 - קשר לחברה` 0.04 FALSE) (`ic3 - קשר לחברה` 0.06 FALSE))
-- All cash on market terms: neither alternative of the consideration test is met.
#ASSERT NOT (`סעיף 270(5)(א)(1) - מתקיים בהצעה האמור בפסקת משנה, והמקבל הוא צד מעוניין` 0.3 TRUE TRUE (`ic3 - קשר לחברה` 0.04 FALSE) (`ic3 - קשר לחברה` 0.06 FALSE))
-- All cash but not on market terms: met.
#ASSERT `סעיף 270(5)(א)(1) - מתקיים בהצעה האמור בפסקת משנה, והמקבל הוא צד מעוניין` 0.3 TRUE FALSE (`ic3 - קשר לחברה` 0.04 FALSE) (`ic3 - קשר לחברה` 0.06 FALSE)
-- A material shareholder (6%) whose holding grows to 8%: yes. One whose holding does not grow: no.
#ASSERT `סעיף 270(5)(א)(1) - מתקיים בהצעה האמור בפסקת משנה, והמקבל הוא צד מעוניין` 0.2 FALSE TRUE (`ic3 - קשר לחברה` 0.06 FALSE) (`ic3 - קשר לחברה` 0.08 FALSE)
#ASSERT NOT (`סעיף 270(5)(א)(1) - מתקיים בהצעה האמור בפסקת משנה, והמקבל הוא צד מעוניין` 0.2 FALSE TRUE (`ic3 - קשר לחברה` 0.06 FALSE) (`ic3 - קשר לחברה` 0.06 FALSE))
-- A person who stays under 5% after the issue is not a material shareholder, and his holding was not one.
#ASSERT NOT (`סעיף 270(5)(א)(1) - מתקיים בהצעה האמור בפסקת משנה, והמקבל הוא צד מעוניין` 0.2 FALSE TRUE (`ic3 - קשר לחברה` 0.01 FALSE) (`ic3 - קשר לחברה` 0.049 FALSE))
-- Exactly 5% after the issue is material.
#ASSERT `סעיף 270(5)(א)(1) - מתקיים בהצעה האמור בפסקת משנה, והמקבל הוא צד מעוניין` 0.2 FALSE TRUE (`ic3 - קשר לחברה` 0.01 FALSE) (`ic3 - קשר לחברה` 0.05 FALSE)

-- (5)(א)(2): as a result a person becomes a controlling shareholder. Arguments: was one before; is one after (section 268).
#ASSERT `סעיף 270(5)(א)(2) - מתקיים בהצעה האמור בפסקת משנה, ואדם הופך לבעל שליטה` FALSE TRUE
#ASSERT NOT (`סעיף 270(5)(א)(2) - מתקיים בהצעה האמור בפסקת משנה, ואדם הופך לבעל שליטה` TRUE TRUE)
#ASSERT NOT (`סעיף 270(5)(א)(2) - מתקיים בהצעה האמור בפסקת משנה, ואדם הופך לבעל שליטה` FALSE FALSE)
-- (5): one of the two limbs; the outcome the core's `הצעה פרטית מהותית` takes.
#ASSERT `סעיף 270(5) - מתקיים בהצעה פרטית האמור בפסקה` TRUE FALSE
#ASSERT `סעיף 270(5) - מתקיים בהצעה פרטית האמור בפסקה` FALSE TRUE
#ASSERT NOT (`סעיף 270(5) - מתקיים בהצעה פרטית האמור בפסקה` FALSE FALSE)
