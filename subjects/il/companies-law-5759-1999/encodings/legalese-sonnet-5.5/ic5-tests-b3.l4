#ASSERT `סעיף 345מח - מינוי המבקר הפנימי כדין` `קרן בניהול פרטי לתועלת הציבור` TRUE TRUE
#ASSERT NOT (`סעיף 345מח - מינוי המבקר הפנימי כדין` `קרן בניהול פרטי לתועלת הציבור` TRUE FALSE)
#ASSERT NOT (`סעיף 345מח - מינוי המבקר הפנימי כדין` `קרן בניהול ציבורי לתועלת הציבור` FALSE TRUE)
#ASSERT `סעיף 345מח - מינוי המבקר הפנימי כדין` `קרן משפחתית לתועלת הציבור` FALSE FALSE
