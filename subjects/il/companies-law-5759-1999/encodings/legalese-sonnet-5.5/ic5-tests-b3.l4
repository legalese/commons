IMPORT prelude
IMPORT daydate
IMPORT `ic-core`
IMPORT `ic5-b1-fund-status`
IMPORT `ic5-b3-fund-governance`

-- ic5-tests-b3: tests of ic5-b3-fund-governance (sections 345מב to 345מט).
-- Every expected value below was decided from the section named beside it, before the run.

§ `בדיקות – סעיפים 345מב עד 345מט`

§§ `345מב – דירקטור בלתי תלוי`

-- 345מב(א), "donor": cumulative donations exceeding NIS 150,000 (or the Minister's other amount), or the controller of a corporation that gave so. Exactly the amount is not "exceeds".
#ASSERT `סעיף 345מב(א) - תורם` 150_001 NOTHING FALSE
#ASSERT NOT (`סעיף 345מב(א) - תורם` 150_000 NOTHING FALSE)
#ASSERT NOT (`סעיף 345מב(א) - תורם` 0 NOTHING FALSE)
#ASSERT `סעיף 345מב(א) - תורם` 200_001 (JUST 200_000) FALSE
#ASSERT NOT (`סעיף 345מב(א) - תורם` 200_000 (JUST 200_000) FALSE)
#ASSERT NOT (`סעיף 345מב(א) - תורם` 160_000 (JUST 200_000) FALSE)
#ASSERT `סעיף 345מב(א) - תורם` 0 NOTHING TRUE
-- 345מב(א), "independent director" (args: kind, individual, committee confirmed, relative of a shareholder or director or office-holder, relative of a donor, affiliation, affiliation with a donor,
-- conflict of interest, qualification as the Minister set, consecutive years).
#ASSERT `סעיף 345מב(א) - דירקטור בלתי תלוי בקרן` `קרן משפחתית לתועלת הציבור` TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE 9
#ASSERT `סעיף 345מב(א) - דירקטור בלתי תלוי בקרן` `קרן בניהול פרטי לתועלת הציבור` TRUE TRUE FALSE TRUE FALSE TRUE FALSE TRUE 5
#ASSERT `סעיף 345מב(א) - דירקטור בלתי תלוי בקרן` `קרן בניהול ציבורי לתועלת הציבור` TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE 5
-- ... the donor conditions bite only in a publicly managed fund.
#ASSERT NOT (`סעיף 345מב(א) - דירקטור בלתי תלוי בקרן` `קרן בניהול ציבורי לתועלת הציבור` TRUE TRUE FALSE TRUE FALSE FALSE FALSE TRUE 5)
#ASSERT NOT (`סעיף 345מב(א) - דירקטור בלתי תלוי בקרן` `קרן בניהול ציבורי לתועלת הציבור` TRUE TRUE FALSE FALSE FALSE TRUE FALSE TRUE 5)
-- ... nine consecutive years are allowed, more are not.
#ASSERT NOT (`סעיף 345מב(א) - דירקטור בלתי תלוי בקרן` `קרן משפחתית לתועלת הציבור` TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE 10)
#ASSERT NOT (`סעיף 345מב(א) - דירקטור בלתי תלוי בקרן` `קרן משפחתית לתועלת הציבור` TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE 9.5)
-- ... each other condition alone defeats it.
#ASSERT NOT (`סעיף 345מב(א) - דירקטור בלתי תלוי בקרן` `קרן משפחתית לתועלת הציבור` FALSE TRUE FALSE FALSE FALSE FALSE FALSE TRUE 1)
#ASSERT NOT (`סעיף 345מב(א) - דירקטור בלתי תלוי בקרן` `קרן משפחתית לתועלת הציבור` TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE 1)
#ASSERT NOT (`סעיף 345מב(א) - דירקטור בלתי תלוי בקרן` `קרן משפחתית לתועלת הציבור` TRUE TRUE TRUE FALSE FALSE FALSE FALSE TRUE 1)
#ASSERT NOT (`סעיף 345מב(א) - דירקטור בלתי תלוי בקרן` `קרן משפחתית לתועלת הציבור` TRUE TRUE FALSE FALSE TRUE FALSE FALSE TRUE 1)
#ASSERT NOT (`סעיף 345מב(א) - דירקטור בלתי תלוי בקרן` `קרן משפחתית לתועלת הציבור` TRUE TRUE FALSE FALSE FALSE FALSE TRUE TRUE 1)
#ASSERT NOT (`סעיף 345מב(א) - דירקטור בלתי תלוי בקרן` `קרן משפחתית לתועלת הציבור` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE 1)
-- 345מב(א), "affiliation" and "another corporation".
#ASSERT `סעיף 345מב(א) - זיקה` TRUE FALSE FALSE FALSE FALSE
#ASSERT `סעיף 345מב(א) - זיקה` FALSE TRUE FALSE FALSE FALSE
#ASSERT `סעיף 345מב(א) - זיקה` FALSE FALSE TRUE FALSE FALSE
#ASSERT `סעיף 345מב(א) - זיקה` FALSE FALSE FALSE TRUE FALSE
#ASSERT NOT (`סעיף 345מב(א) - זיקה` FALSE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`סעיף 345מב(א) - זיקה` TRUE FALSE FALSE FALSE TRUE)
#ASSERT `סעיף 345מב(א) - תאגיד אחר` TRUE
#ASSERT NOT (`סעיף 345מב(א) - תאגיד אחר` FALSE)
-- 345מב(ב), (ג): two independent directors in a privately managed fund; at least two directors, all independent, in a publicly managed one.
#ASSERT `סעיף 345מב(ב) - הרכב הדירקטוריון של קרן בניהול פרטי` 2
#ASSERT NOT (`סעיף 345מב(ב) - הרכב הדירקטוריון של קרן בניהול פרטי` 1)
#ASSERT `סעיף 345מב(ג) - הרכב הדירקטוריון של קרן בניהול ציבורי` 2 2
#ASSERT `סעיף 345מב(ג) - הרכב הדירקטוריון של קרן בניהול ציבורי` 5 5
#ASSERT NOT (`סעיף 345מב(ג) - הרכב הדירקטוריון של קרן בניהול ציבורי` 3 2)
#ASSERT NOT (`סעיף 345מב(ג) - הרכב הדירקטוריון של קרן בניהול ציבורי` 1 1)
-- 345מב(ד), (ה).
#ASSERT `סעיף 345מב(ד) - המינוי ההדדי אסור` TRUE TRUE
#ASSERT NOT (`סעיף 345מב(ד) - המינוי ההדדי אסור` TRUE FALSE)
#ASSERT NOT (`סעיף 345מב(ד) - המינוי ההדדי אסור` FALSE TRUE)
#ASSERT `סעיף 345מב(ה) - מינוי הדירקטור הבלתי תלוי כשר מבחינת המין` TRUE TRUE
#ASSERT NOT (`סעיף 345מב(ה) - מינוי הדירקטור הבלתי תלוי כשר מבחינת המין` TRUE FALSE)
#ASSERT `סעיף 345מב(ה) - מינוי הדירקטור הבלתי תלוי כשר מבחינת המין` FALSE FALSE
#ASSERT `סעיף 345מב(ה) - מינוי הדירקטור הבלתי תלוי כשר מבחינת המין` FALSE TRUE

§§ `345מג – אמות מידה וועדת חלוקה`

#ASSERT `סעיף 345מג(א) - הדירקטוריון מילא את חובתו לקבוע אמות מידה` TRUE
#ASSERT NOT (`סעיף 345מג(א) - הדירקטוריון מילא את חובתו לקבוע אמות מידה` FALSE)
#ASSERT `סעיף 345מג(ב) - הדירקטוריון מילא את חובתו למנות ועדת חלוקה` TRUE
#ASSERT NOT (`סעיף 345מג(ב) - הדירקטוריון מילא את חובתו למנות ועדת חלוקה` FALSE)
#ASSERT `סעיף 345מג(ב)(2) - ועדת החלוקה רשאית להחליט על חלוקה` TRUE TRUE
#ASSERT NOT (`סעיף 345מג(ב)(2) - ועדת החלוקה רשאית להחליט על חלוקה` TRUE FALSE)
#ASSERT NOT (`סעיף 345מג(ב)(2) - ועדת החלוקה רשאית להחליט על חלוקה` FALSE TRUE)
-- 345מג(ג): two independent directors on the distribution committee of a privately or publicly managed fund; a family fund has no such requirement.
#ASSERT `סעיף 345מג(ג) - מה נדרש בוועדת החלוקה` `קרן בניהול פרטי לתועלת הציבור` EQUALS `נדרשים לפחות שניים מהדירקטורים הבלתי תלויים`
#ASSERT `סעיף 345מג(ג) - מה נדרש בוועדת החלוקה` `קרן בניהול ציבורי לתועלת הציבור` EQUALS `נדרשים לפחות שניים מהדירקטורים הבלתי תלויים`
#ASSERT `סעיף 345מג(ג) - מה נדרש בוועדת החלוקה` `קרן משפחתית לתועלת הציבור` EQUALS `סעיף 345מג(ג) אינו דורש הרכב מסוים`
#ASSERT `סעיף 345מג(ג) - הרכב ועדת החלוקה כשר` `קרן בניהול פרטי לתועלת הציבור` 2
#ASSERT NOT (`סעיף 345מג(ג) - הרכב ועדת החלוקה כשר` `קרן בניהול פרטי לתועלת הציבור` 1)
#ASSERT NOT (`סעיף 345מג(ג) - הרכב ועדת החלוקה כשר` `קרן בניהול ציבורי לתועלת הציבור` 0)
#ASSERT `סעיף 345מג(ג) - הרכב ועדת החלוקה כשר` `קרן משפחתית לתועלת הציבור` 0

§§ `345מה – דיווח`

