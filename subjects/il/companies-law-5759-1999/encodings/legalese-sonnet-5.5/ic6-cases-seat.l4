IMPORT prelude
IMPORT daydate
IMPORT `ic-core`
IMPORT `ic-core-company-kinds`
IMPORT `ic6-common`
IMPORT `ic6-foreign-company`
IMPORT `ic6-arrangement`
IMPORT `ic6-striking-off`
IMPORT `ic6-remedies`
IMPORT `ic6-sanction-registrar`
IMPORT `ic6-defaulting-company`
IMPORT `ic6-sanction-securities`
IMPORT `ic6-scope-abroad`
IMPORT `ic6-transitional`
IMPORT `ic6-schedule-1`
IMPORT `ic6-schedule-1a`
IMPORT `ic6-schedule-2`
IMPORT `ic6-schedule-3`
IMPORT `ic6-schedule-4`
IMPORT `ic6-seat`


-- ic6-cases-seat: worked cases for ic6-seat.l4, one group per question at least, with the facts a person in the seat would state.
-- Every expected value is written by hand from the section named beside the question, never copied from the rule's own output.
-- Dates are written with YMD (year, month, day). "Day 0" is the day of the event; the last day of a period is inside it (fork F-ic6-2).
-- A question whose answer is MAYBE has a case with NOTHING: the text does not answer it (the case is outside the encoding).

§ `מקרים: השאלות של מי שמקים חברה, מכהן בה או מחזיק בה מניות`


§§ `חברת חוץ: רישום, הודעות, המצאה ודין וחשבון (סעיפים 346 עד 349א)`

-- האם חברת החוץ שלי רשאית לקיים בישראל מקום עסקים?
-- registered and paid
#ASSERT `האם חברת החוץ שלי רשאית לקיים בישראל מקום עסקים (סעיף 346(א))` TRUE TRUE
-- registered but fees unpaid
#ASSERT NOT (`האם חברת החוץ שלי רשאית לקיים בישראל מקום עסקים (סעיף 346(א))` TRUE FALSE)
-- not registered
#ASSERT NOT (`האם חברת החוץ שלי רשאית לקיים בישראל מקום עסקים (סעיף 346(א))` FALSE TRUE)
#ASSERT NOT (`האם חברת החוץ שלי רשאית לקיים בישראל מקום עסקים (סעיף 346(א))` FALSE FALSE)

-- האם הגשתי במועד את הבקשה לרשום את חברת החוץ שלי?
-- filed on the last day of the month
#ASSERT `האם הגשתי במועד את הבקשה לרשום את חברת החוץ שלי (סעיף 346(ב))` (YearMonthDay 2026 1 15) (YearMonthDay 2026 2 15)
-- one day late
#ASSERT NOT (`האם הגשתי במועד את הבקשה לרשום את חברת החוץ שלי (סעיף 346(ב))` (YearMonthDay 2026 1 15) (YearMonthDay 2026 2 16))
-- a month from 31 January ends on 28 February
#ASSERT `האם הגשתי במועד את הבקשה לרשום את חברת החוץ שלי (סעיף 346(ב))` (YearMonthDay 2026 1 31) (YearMonthDay 2026 2 28)

-- האם צירפתי לבקשה לרשום את חברת החוץ שלי את כל המסמכים הנדרשים?
-- everything attached, documents already in English
#ASSERT `האם צירפתי לבקשה לרשום את חברת החוץ שלי את כל המסמכים הנדרשים (סעיף 346(ב))` TRUE TRUE FALSE TRUE TRUE TRUE TRUE TRUE
-- documents in another language but translated
#ASSERT `האם צירפתי לבקשה לרשום את חברת החוץ שלי את כל המסמכים הנדרשים (סעיף 346(ב))` TRUE FALSE TRUE TRUE TRUE TRUE TRUE TRUE
-- another language and no translation
#ASSERT NOT (`האם צירפתי לבקשה לרשום את חברת החוץ שלי את כל המסמכים הנדרשים (סעיף 346(ב))` TRUE FALSE FALSE TRUE TRUE TRUE TRUE TRUE)
-- no list of directors
#ASSERT NOT (`האם צירפתי לבקשה לרשום את חברת החוץ שלי את כל המסמכים הנדרשים (סעיף 346(ב))` TRUE TRUE FALSE FALSE TRUE TRUE TRUE TRUE)
-- the Minister's further documents missing
#ASSERT NOT (`האם צירפתי לבקשה לרשום את חברת החוץ שלי את כל המסמכים הנדרשים (סעיף 346(ב))` TRUE TRUE FALSE TRUE TRUE TRUE TRUE FALSE)

-- האם עמדתי בחובה להודיע לרשם על שינוי בפרטי חברת החוץ שלי?
-- notified on day 14
#ASSERT `האם עמדתי בחובה להודיע לרשם על שינוי בפרטי חברת החוץ שלי (סעיף 346(ג))` TRUE (YearMonthDay 2026 3 1) (YearMonthDay 2026 3 15)
-- notified on day 15
#ASSERT NOT (`האם עמדתי בחובה להודיע לרשם על שינוי בפרטי חברת החוץ שלי (סעיף 346(ג))` TRUE (YearMonthDay 2026 3 1) (YearMonthDay 2026 3 16))
-- no change, no duty
#ASSERT `האם עמדתי בחובה להודיע לרשם על שינוי בפרטי חברת החוץ שלי (סעיף 346(ג))` FALSE (YearMonthDay 2026 3 1) (YearMonthDay 2026 9 1)

-- האם הרשם צריך לרשום את המען הדיגיטלי שמסרתי?
#ASSERT `האם הרשם צריך לרשום את המען הדיגיטלי שמסרתי (סעיף 346(ג1))` TRUE TRUE
-- not yet checked
#ASSERT NOT (`האם הרשם צריך לרשום את המען הדיגיטלי שמסרתי (סעיף 346(ג1))` TRUE FALSE)
-- conditions not met
#ASSERT NOT (`האם הרשם צריך לרשום את המען הדיגיטלי שמסרתי (סעיף 346(ג1))` FALSE TRUE)

-- האם צירפתי את המסמכים הנוספים שהשר קבע לבקשת הרישום?
#ASSERT `האם צירפתי את המסמכים הנוספים שהשר קבע לבקשת הרישום (סעיף 346(ד))` TRUE TRUE
-- prescribed but not attached
#ASSERT NOT (`האם צירפתי את המסמכים הנוספים שהשר קבע לבקשת הרישום (סעיף 346(ד))` TRUE FALSE)
-- nothing prescribed
#ASSERT `האם צירפתי את המסמכים הנוספים שהשר קבע לבקשת הרישום (סעיף 346(ד))` FALSE FALSE

-- האם כתב בי־דין או הודעה שנמסרו לחברת החוץ שלי נחשבים כאילו הומצאו כדין?
-- left at the address
#ASSERT `האם כתב בי־דין או הודעה שנמסרו לחברת החוץ שלי נחשבים כאילו הומצאו כדין (סעיף 347)` TRUE TRUE TRUE FALSE
-- posted
#ASSERT `האם כתב בי־דין או הודעה שנמסרו לחברת החוץ שלי נחשבים כאילו הומצאו כדין (סעיף 347)` TRUE TRUE FALSE TRUE
-- neither left nor posted
#ASSERT NOT (`האם כתב בי־דין או הודעה שנמסרו לחברת החוץ שלי נחשבים כאילו הומצאו כדין (סעיף 347)` TRUE TRUE FALSE FALSE)
-- company not registered
#ASSERT NOT (`האם כתב בי־דין או הודעה שנמסרו לחברת החוץ שלי נחשבים כאילו הומצאו כדין (סעיף 347)` FALSE TRUE TRUE TRUE)
-- not addressed to the notified person
#ASSERT NOT (`האם כתב בי־דין או הודעה שנמסרו לחברת החוץ שלי נחשבים כאילו הומצאו כדין (סעיף 347)` TRUE FALSE TRUE TRUE)

-- האם הגשתי דין וחשבון שנתי של חברת החוץ שלי כנדרש?
-- exactly a year later, in the prescribed form
#ASSERT `האם הגשתי דין וחשבון שנתי של חברת החוץ שלי כנדרש (סעיף 348)` TRUE (YearMonthDay 2025 3 1) (YearMonthDay 2026 3 1) TRUE EQUALS (JUST TRUE)
-- a day too late
#ASSERT `האם הגשתי דין וחשבון שנתי של חברת החוץ שלי כנדרש (סעיף 348)` TRUE (YearMonthDay 2025 3 1) (YearMonthDay 2026 3 2) TRUE EQUALS (JUST FALSE)
-- in time but not in the prescribed form
#ASSERT `האם הגשתי דין וחשבון שנתי של חברת החוץ שלי כנדרש (סעיף 348)` TRUE (YearMonthDay 2025 3 1) (YearMonthDay 2026 2 1) FALSE EQUALS (JUST FALSE)
-- no earlier report: the text does not say when the first is due
#ASSERT `האם הגשתי דין וחשבון שנתי של חברת החוץ שלי כנדרש (סעיף 348)` FALSE (YearMonthDay 2025 3 1) (YearMonthDay 2026 3 1) TRUE EQUALS (NOTHING)

-- האם חברת החוץ שלי הפרה את סעיף 346
-- a place of business, never registered
#ASSERT `האם חברת החוץ שלי הפרה את הדרישה להירשם (סעיף 349)` TRUE FALSE TRUE
-- registered but fees unpaid
#ASSERT `האם חברת החוץ שלי הפרה את הדרישה להירשם (סעיף 349)` TRUE TRUE FALSE
#ASSERT NOT (`האם חברת החוץ שלי הפרה את הדרישה להירשם (סעיף 349)` TRUE TRUE TRUE)
-- no place of business in Israel
#ASSERT NOT (`האם חברת החוץ שלי הפרה את הדרישה להירשם (סעיף 349)` FALSE FALSE FALSE)

-- האם חברת החוץ שלי חבה בקנס על הפרת חובת הרישום?
#ASSERT `האם חברת החוץ שלי חבה בקנס על הפרת חובת הרישום (סעיף 349)` TRUE
#ASSERT NOT (`האם חברת החוץ שלי חבה בקנס על הפרת חובת הרישום (סעיף 349)` FALSE)

-- האם אני, כנושא משרה או כשלוח של חברת חוץ שהפרה את חובת הרישום, חב בקנס?
#ASSERT `האם אני חב בקנס כנושא משרה או שלוח של חברת חוץ שהפרה את חובת הרישום (סעיף 349)` TRUE TRUE TRUE
-- not a party to the breach
#ASSERT NOT (`האם אני חב בקנס כנושא משרה או שלוח של חברת חוץ שהפרה את חובת הרישום (סעיף 349)` TRUE TRUE FALSE)
-- neither officer nor agent
#ASSERT NOT (`האם אני חב בקנס כנושא משרה או שלוח של חברת חוץ שהפרה את חובת הרישום (סעיף 349)` TRUE FALSE TRUE)
-- the company did not breach
#ASSERT NOT (`האם אני חב בקנס כנושא משרה או שלוח של חברת חוץ שהפרה את חובת הרישום (סעיף 349)` FALSE TRUE TRUE)

-- כמה ימים של קנס יומי נוסף נצברו על הפרת חובת הרישום?
-- the day of the notice only
#ASSERT `כמה ימים של קנס יומי נוסף נצברו על הפרת חובת הרישום (סעיף 349)` (YearMonthDay 2026 1 10) (YearMonthDay 2026 1 10) EQUALS 1
#ASSERT `כמה ימים של קנס יומי נוסף נצברו על הפרת חובת הרישום (סעיף 349)` (YearMonthDay 2026 1 10) (YearMonthDay 2026 1 19) EQUALS 10
-- before the notice
#ASSERT `כמה ימים של קנס יומי נוסף נצברו על הפרת חובת הרישום (סעיף 349)` (YearMonthDay 2026 1 10) (YearMonthDay 2026 1 9) EQUALS 0

-- מאיזה יום חברת החוץ שלי פטורה מחובותיה לפי הפרק, אחרי שהפסיקה לקיים בישראל מקום עסקים?
#ASSERT `מאיזה יום חברת החוץ שלי פטורה מחובותיה לפי הפרק (סעיף 349א(א))` TRUE TRUE (YearMonthDay 2026 4 1) EQUALS (JUST (YearMonthDay 2026 4 1))
-- still keeps a place of business
#ASSERT `מאיזה יום חברת החוץ שלי פטורה מחובותיה לפי הפרק (סעיף 349א(א))` FALSE TRUE (YearMonthDay 2026 4 1) EQUALS (NOTHING)
-- no notice given
#ASSERT `מאיזה יום חברת החוץ שלי פטורה מחובותיה לפי הפרק (סעיף 349א(א))` TRUE FALSE (YearMonthDay 2026 4 1) EQUALS (NOTHING)

-- מאיזה יום חברת החוץ שלי פטורה מחובת תשלום אגרה?
-- the Minister's day is earlier
#ASSERT `מאיזה יום חברת החוץ שלי פטורה מחובת תשלום אגרה (סעיף 349א(א))` TRUE TRUE (YearMonthDay 2026 4 1) TRUE (YearMonthDay 2026 1 1) EQUALS (JUST (YearMonthDay 2026 1 1))
-- the Minister's day is later: the general day governs
#ASSERT `מאיזה יום חברת החוץ שלי פטורה מחובת תשלום אגרה (סעיף 349א(א))` TRUE TRUE (YearMonthDay 2026 4 1) TRUE (YearMonthDay 2026 6 1) EQUALS (JUST (YearMonthDay 2026 4 1))
-- no day set by the Minister
#ASSERT `מאיזה יום חברת החוץ שלי פטורה מחובת תשלום אגרה (סעיף 349א(א))` TRUE TRUE (YearMonthDay 2026 4 1) FALSE (YearMonthDay 2026 1 1) EQUALS (JUST (YearMonthDay 2026 4 1))
-- no notice, so no general day
#ASSERT `מאיזה יום חברת החוץ שלי פטורה מחובת תשלום אגרה (סעיף 349א(א))` TRUE FALSE (YearMonthDay 2026 4 1) TRUE (YearMonthDay 2026 1 1) EQUALS (NOTHING)

-- האם נשארתי חייב, בשם חברת החוץ שלי, למסור לרשם מען להמצאת כתבי בי־דין אחרי שהפסיקה לפעול בישראל?
-- stopped, told the Registrar, no other address given: the duty remains
#ASSERT `האם נשארה חובת מסירת מען להמצאת כתבי בי־דין (סעיף 349א(ב))` TRUE FALSE
-- another address given
#ASSERT NOT (`האם נשארה חובת מסירת מען להמצאת כתבי בי־דין (סעיף 349א(ב))` TRUE TRUE)
-- did not stop and notify: the proviso is not triggered
#ASSERT NOT (`האם נשארה חובת מסירת מען להמצאת כתבי בי־דין (סעיף 349א(ב))` FALSE FALSE)

-- האם אפשר להמציא כתבי בי־דין לחברת החוץ שלי במען אחר מחוץ לישראל בלי היתר בית משפט?
#ASSERT `האם אין צורך בהיתר בית משפט להמצאת כתבי בי־דין לחברת חוץ (סעיף 349א(ב))` TRUE TRUE TRUE
-- the other address is in Israel
#ASSERT NOT (`האם אין צורך בהיתר בית משפט להמצאת כתבי בי־דין לחברת חוץ (סעיף 349א(ב))` TRUE FALSE TRUE)
-- the documents concern later activity
#ASSERT NOT (`האם אין צורך בהיתר בית משפט להמצאת כתבי בי־דין לחברת חוץ (סעיף 349א(ב))` TRUE TRUE FALSE)

§§ `פשרה או הסדר בין החברה לנושיה או לבעלי מניותיה (סעיפים 350 עד 351א)`

-- האם אני רשאי לבקש מבית המשפט לכנס אסיפות כדי לאשר פשרה או הסדר?
-- a shareholder, proposal made, not an insolvency arrangement
#ASSERT `האם אני רשאי לבקש מבית המשפט לכנס אסיפות כדי לאשר פשרה או הסדר (סעיף 350(א))` `אני בעל מניות בחברה לעניין סעיף 350(א)` TRUE TRUE FALSE FALSE
-- the company itself
#ASSERT `האם אני רשאי לבקש מבית המשפט לכנס אסיפות כדי לאשר פשרה או הסדר (סעיף 350(א))` `אני פועל בשם החברה לעניין סעיף 350(א)` FALSE TRUE FALSE FALSE
-- the trustee of a company in liquidation
#ASSERT `האם אני רשאי לבקש מבית המשפט לכנס אסיפות כדי לאשר פשרה או הסדר (סעיף 350(א))` `אני נאמן של חברה בפירוק לעניין סעיף 350(א)` TRUE TRUE FALSE FALSE
-- a trustee, but the company is not in liquidation
#ASSERT NOT (`האם אני רשאי לבקש מבית המשפט לכנס אסיפות כדי לאשר פשרה או הסדר (סעיף 350(א))` `אני נאמן של חברה בפירוק לעניין סעיף 350(א)` FALSE TRUE FALSE FALSE)
-- a creditor is not a listed applicant
#ASSERT NOT (`האם אני רשאי לבקש מבית המשפט לכנס אסיפות כדי לאשר פשרה או הסדר (סעיף 350(א))` `אני נושה של החברה לעניין סעיף 350(א)` TRUE TRUE FALSE FALSE)
-- an insolvency debt arrangement is outside the section
#ASSERT NOT (`האם אני רשאי לבקש מבית המשפט לכנס אסיפות כדי לאשר פשרה או הסדר (סעיף 350(א))` `אני בעל מניות בחברה לעניין סעיף 350(א)` FALSE TRUE TRUE FALSE)
-- an economic rehabilitation plan is outside the section
#ASSERT NOT (`האם אני רשאי לבקש מבית המשפט לכנס אסיפות כדי לאשר פשרה או הסדר (סעיף 350(א))` `אני בעל מניות בחברה לעניין סעיף 350(א)` FALSE TRUE FALSE TRUE)
-- nothing was proposed
#ASSERT NOT (`האם אני רשאי לבקש מבית המשפט לכנס אסיפות כדי לאשר פשרה או הסדר (סעיף 350(א))` `אני בעל מניות בחברה לעניין סעיף 350(א)` FALSE FALSE FALSE FALSE)

-- האם הקבוצה שלי היא ”סוג“ שמצדיק אסיפת סוג נפרדת?
#ASSERT `האם הקבוצה שלי היא סוג שמצדיק אסיפת סוג נפרדת (סעיף 350(א1))` TRUE TRUE TRUE
#ASSERT NOT (`האם הקבוצה שלי היא סוג שמצדיק אסיפת סוג נפרדת (סעיף 350(א1))` TRUE TRUE FALSE)
#ASSERT NOT (`האם הקבוצה שלי היא סוג שמצדיק אסיפת סוג נפרדת (סעיף 350(א1))` TRUE FALSE TRUE)
#ASSERT NOT (`האם הקבוצה שלי היא סוג שמצדיק אסיפת סוג נפרדת (סעיף 350(א1))` FALSE TRUE TRUE)

-- האם עמדתי בחובת ההצבעה באסיפת הסוג שלי?
#ASSERT `האם עמדתי בחובת ההצבעה באסיפת הסוג שלי (סעיף 350(א2))` TRUE TRUE TRUE
-- not in good faith
#ASSERT NOT (`האם עמדתי בחובת ההצבעה באסיפת הסוג שלי (סעיף 350(א2))` FALSE TRUE TRUE)
#ASSERT NOT (`האם עמדתי בחובת ההצבעה באסיפת הסוג שלי (סעיף 350(א2))` TRUE FALSE TRUE)
-- abused his power
#ASSERT NOT (`האם עמדתי בחובת ההצבעה באסיפת הסוג שלי (סעיף 350(א2))` TRUE TRUE FALSE)

-- האם אסיפת הסוג שלי הסכימה לפשרה או להסדר?
-- a head majority and exactly three quarters of the value
#ASSERT `האם אסיפת הסוג שלי הסכימה לפשרה או להסדר (סעיף 350(ט))` 10 5 75 25
-- just under three quarters of the value
#ASSERT NOT (`האם אסיפת הסוג שלי הסכימה לפשרה או להסדר (סעיף 350(ט))` 10 5 74 26)
-- a tie on heads is not a majority
#ASSERT NOT (`האם אסיפת הסוג שלי הסכימה לפשרה או להסדר (סעיף 350(ט))` 5 5 90 10)
-- a minority of heads
#ASSERT NOT (`האם אסיפת הסוג שלי הסכימה לפשרה או להסדר (סעיף 350(ט))` 3 8 90 10)
#ASSERT `האם אסיפת הסוג שלי הסכימה לפשרה או להסדר (סעיף 350(ט))` 1 0 1 0

-- האם הפשרה או ההסדר מחייבים אותי, כשבית המשפט כינס אסיפת סוג אחת בלבד?
-- the class agreed and the court approved
#ASSERT `האם הפשרה או ההסדר מחייבים אותי, כשבית המשפט כינס אסיפת סוג אחת בלבד (סעיף 350(ט))` 10 5 75 25 TRUE
-- the court did not approve
#ASSERT NOT (`האם הפשרה או ההסדר מחייבים אותי, כשבית המשפט כינס אסיפת סוג אחת בלבד (סעיף 350(ט))` 10 5 75 25 FALSE)
-- the class did not agree
#ASSERT NOT (`האם הפשרה או ההסדר מחייבים אותי, כשבית המשפט כינס אסיפת סוג אחת בלבד (סעיף 350(ט))` 10 5 50 50 TRUE)

-- האם הפשרה או ההסדר מחייבים גם אותי כנאמן של חברה בפירוק?
#ASSERT `האם הפשרה או ההסדר מחייבים גם אותי כנאמן של חברה בפירוק (סעיף 350(ט))` 10 5 75 25 TRUE TRUE
-- no liquidation, no trustee
#ASSERT NOT (`האם הפשרה או ההסדר מחייבים גם אותי כנאמן של חברה בפירוק (סעיף 350(ט))` 10 5 75 25 TRUE FALSE)
-- not approved
#ASSERT NOT (`האם הפשרה או ההסדר מחייבים גם אותי כנאמן של חברה בפירוק (סעיף 350(ט))` 10 5 75 25 FALSE TRUE)

-- האם בית המשפט שאישר את הפשרה או ההסדר מוסמך לדון במחלוקת על פירושם או על יישומם?
#ASSERT `האם בית המשפט שאישר את הפשרה מוסמך לדון במחלוקת על פירושה או יישומה (סעיף 350(ט1))` TRUE TRUE TRUE
-- a different court
#ASSERT NOT (`האם בית המשפט שאישר את הפשרה מוסמך לדון במחלוקת על פירושה או יישומה (סעיף 350(ט1))` FALSE TRUE TRUE)
-- the dispute pre-dates the approval
#ASSERT NOT (`האם בית המשפט שאישר את הפשרה מוסמך לדון במחלוקת על פירושה או יישומה (סעיף 350(ט1))` TRUE FALSE TRUE)
#ASSERT NOT (`האם בית המשפט שאישר את הפשרה מוסמך לדון במחלוקת על פירושה או יישומה (סעיף 350(ט1))` TRUE TRUE FALSE)

-- האם לצו שניתן לאישור הפשרה או ההסדר יש תוקף?
#ASSERT `האם לצו שניתן לאישור הפשרה או ההסדר יש תוקף (סעיף 350(י))` TRUE
#ASSERT NOT (`האם לצו שניתן לאישור הפשרה או ההסדר יש תוקף (סעיף 350(י))` FALSE)

-- האם העותק של מסמך היסוד שהוצא לי אחרי הצו כולל את העתק הצו?
#ASSERT `האם העותק שהוצא אחרי הצו כולל את העתק הצו (סעיף 350(י))` TRUE TRUE
-- issued after the order without it
#ASSERT NOT (`האם העותק שהוצא אחרי הצו כולל את העתק הצו (סעיף 350(י))` TRUE FALSE)
-- issued before the order: the requirement does not bite
#ASSERT `האם העותק שהוצא אחרי הצו כולל את העתק הצו (סעיף 350(י))` FALSE FALSE

-- האם התאגיד שלי נחשב ”חברה“ לעניין פרק הפשרה וההסדר?
-- an Israeli company
#ASSERT `האם התאגיד שלי נחשב חברה לעניין פרק הפשרה וההסדר (סעיף 350(יא))` FALSE FALSE FALSE
-- a foreign company with neither business nor assets in Israel
#ASSERT NOT (`האם התאגיד שלי נחשב חברה לעניין פרק הפשרה וההסדר (סעיף 350(יא))` TRUE FALSE FALSE)
-- a foreign company doing business in Israel
#ASSERT `האם התאגיד שלי נחשב חברה לעניין פרק הפשרה וההסדר (סעיף 350(יא))` TRUE TRUE FALSE
-- a foreign company with assets in Israel
#ASSERT `האם התאגיד שלי נחשב חברה לעניין פרק הפשרה וההסדר (סעיף 350(יא))` TRUE FALSE TRUE

-- האם ההצעה שלי היא ”הסדר“ לעניין פרק הפשרה וההסדר?
#ASSERT `האם ההצעה שלי היא הסדר לעניין פרק הפשרה וההסדר (סעיף 350(יא))` TRUE FALSE FALSE
-- consolidation of share classes
#ASSERT `האם ההצעה שלי היא הסדר לעניין פרק הפשרה וההסדר (סעיף 350(יא))` FALSE TRUE FALSE
-- division into classes
#ASSERT `האם ההצעה שלי היא הסדר לעניין פרק הפשרה וההסדר (סעיף 350(יא))` FALSE FALSE TRUE
#ASSERT NOT (`האם ההצעה שלי היא הסדר לעניין פרק הפשרה וההסדר (סעיף 350(יא))` FALSE FALSE FALSE)

-- אילו הוראות רשאי בית המשפט לתת כשהפשרה או ההסדר נועדו לשינוי מבנה או למיזוג?
-- all conditions met
#ASSERT `אילו הוראות רשאי בית המשפט לתת בשינוי מבנה או במיזוג (סעיף 351(א))` TRUE TRUE TRUE EQUALS (LIST `העברת המפעל, הנכסים או החיובים של החברה המעבירה לחברה הנעברת`, `הקצאת מניות, איגרות חוב, פוליסות או טובות הנאה דומות בחברה הנעברת`, `המשך הליך משפטי תלוי ועומד מטעם החברה המעבירה או נגדה`, `חיסול החברה המעבירה ללא פירוק`, `סעד לאנשים המתנגדים לפשרה או להסדר`, `כל ענין שבשגרה הדרוש להשלמת שינוי המבנה או המיזוג ביעילות`)
-- no transfer of assets under the plan
#ASSERT `אילו הוראות רשאי בית המשפט לתת בשינוי מבנה או במיזוג (סעיף 351(א))` TRUE TRUE FALSE EQUALS (EMPTY)
-- no application filed
#ASSERT `אילו הוראות רשאי בית המשפט לתת בשינוי מבנה או במיזוג (סעיף 351(א))` FALSE TRUE TRUE EQUALS (EMPTY)

-- האם הנכסים שהצו מעביר עוברים לחברה הנעברת?
#ASSERT `האם הנכסים שהצו מעביר מוקנים לחברה הנעברת (סעיף 351(ב))` TRUE
#ASSERT NOT (`האם הנכסים שהצו מעביר מוקנים לחברה הנעברת (סעיף 351(ב))` FALSE)

