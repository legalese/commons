-- האם הרשם רשאי להטיל על החברה שלי עיצום בלי לתת לה קודם הזדמנות לתקן את ההפרה?
#ASSERT `האם אין צורך לתת לחברה הזדמנות לתקן את ההפרה (סעיף 356(ב2))` `אי הצהרה בפני הרשם בעת בקשת הרישום כי היא חברה לתועלת הציבור`
#ASSERT `האם אין צורך לתת לחברה הזדמנות לתקן את ההפרה (סעיף 356(ב2))` `ציון הסיומת או הצגה כחברה לתועלת הציבור בידי חברה שאינה חברה לתועלת הציבור`
#ASSERT `האם אין צורך לתת לחברה הזדמנות לתקן את ההפרה (סעיף 356(ב2))` `אי רישום חברת חוץ לתועלת הציבור כחברת חוץ`
-- an ordinary violation: a chance to correct is due
#ASSERT NOT (`האם אין צורך לתת לחברה הזדמנות לתקן את ההפרה (סעיף 356(ב2))` `הפרת הוראת הרשם לפי סעיף 37(ב) או (ג)`)
#ASSERT `האם אין צורך לתת לחברה הזדמנות לתקן את ההפרה (סעיף 356(ב2))` `אי הודעה לרשם על החלטה לשנות את התקנון כך שהחברה תהיה חברה לתועלת הציבור`
#ASSERT NOT (`האם אין צורך לתת לחברה הזדמנות לתקן את ההפרה (סעיף 356(ב2))` `הפרת חובת גילוי לפי סעיפים 2 או 5א(א) עד (ג) לחוק חובת גילוי לגבי מי שנתמך על ידי ישות מדינית זרה`)

-- האם הדרישה לעיצום בלי הזדמנות לתקן עומדת בדרישות?
-- payment day 30
#ASSERT `האם הדרישה לעיצום בלי הזדמנות לתקן עומדת בדרישות (סעיף 356(ב2))` (YearMonthDay 2026 1 1) (YearMonthDay 2026 1 31) TRUE
-- payment day 29
#ASSERT NOT (`האם הדרישה לעיצום בלי הזדמנות לתקן עומדת בדרישות (סעיף 356(ב2))` (YearMonthDay 2026 1 1) (YearMonthDay 2026 1 30) TRUE)
-- no notice of the right to argue
#ASSERT NOT (`האם הדרישה לעיצום בלי הזדמנות לתקן עומדת בדרישות (סעיף 356(ב2))` (YearMonthDay 2026 1 1) (YearMonthDay 2026 3 1) FALSE)

-- האם הגשתי את טענותיי לרשם במועד?
-- day 14
#ASSERT `האם טענות החברה הוגשו במועד (סעיף 356(ב2))` (YearMonthDay 2026 1 1) (YearMonthDay 2026 1 15)
-- day 15
#ASSERT NOT (`האם טענות החברה הוגשו במועד (סעיף 356(ב2))` (YearMonthDay 2026 1 1) (YearMonthDay 2026 1 16))

-- האם עלי לשלם את העיצום הכספי אף שהגשתי ערעור?
-- no appeal
#ASSERT `האם העיצום הכספי משולם אף שהוגש ערעור (סעיף 356(ג))` FALSE FALSE
-- an appeal with no contrary order: payment is suspended
#ASSERT NOT (`האם העיצום הכספי משולם אף שהוגש ערעור (סעיף 356(ג))` TRUE FALSE)
-- the court ordered payment to go ahead
#ASSERT `האם העיצום הכספי משולם אף שהוגש ערעור (סעיף 356(ג))` TRUE TRUE

-- כמה ימי פיגור יש בתשלום העיצום הכספי?
-- paid ten days late
#ASSERT `כמה ימי פיגור יש בתשלום העיצום הכספי (סעיף 357)` (YearMonthDay 2026 3 1) TRUE (YearMonthDay 2026 3 11) (YearMonthDay 2026 6 1) EQUALS 10
-- paid early
#ASSERT `כמה ימי פיגור יש בתשלום העיצום הכספי (סעיף 357)` (YearMonthDay 2026 3 1) TRUE (YearMonthDay 2026 2 20) (YearMonthDay 2026 6 1) EQUALS 0
-- not yet paid, five days past the date
#ASSERT `כמה ימי פיגור יש בתשלום העיצום הכספי (סעיף 357)` (YearMonthDay 2026 3 1) FALSE (YearMonthDay 2026 3 1) (YearMonthDay 2026 3 6) EQUALS 5

-- האם יתווספו לעיצום שלי ריבית שקלית ודמי פיגורים?
-- a day late
#ASSERT `האם מתווספים על העיצום ריבית שקלית ודמי פיגורים (סעיף 357)` (YearMonthDay 2026 3 1) TRUE (YearMonthDay 2026 3 2) (YearMonthDay 2026 6 1)
-- paid on the date
#ASSERT NOT (`האם מתווספים על העיצום ריבית שקלית ודמי פיגורים (סעיף 357)` (YearMonthDay 2026 3 1) TRUE (YearMonthDay 2026 3 1) (YearMonthDay 2026 6 1))

-- האם הרשם רשאי לגבות ממני את העיצום לפי פקודת המסים
#ASSERT `האם על גביית העיצום חלה פקודת המסים (גביה) (סעיף 358)` TRUE
#ASSERT NOT (`האם על גביית העיצום חלה פקודת המסים (גביה) (סעיף 358)` FALSE)

-- האם ערעורי על הדרישה לבית משפט השלום הוגש במועד?
-- day 30
#ASSERT `האם הערעור לבית משפט השלום הוגש במועד (סעיף 359(א))` TRUE (YearMonthDay 2026 1 1) (YearMonthDay 2026 1 31) EQUALS (JUST TRUE)
-- day 31
#ASSERT `האם הערעור לבית משפט השלום הוגש במועד (סעיף 359(א))` TRUE (YearMonthDay 2026 1 1) (YearMonthDay 2026 2 1) EQUALS (JUST FALSE)
-- not a public-benefit company: the section gives no answer
#ASSERT `האם הערעור לבית משפט השלום הוגש במועד (סעיף 359(א))` FALSE (YearMonthDay 2026 1 1) (YearMonthDay 2026 1 5) EQUALS (NOTHING)

-- האם אקבל בחזרה את הסכום ששילמתי, עם ריבית, אם ערעורי התקבל?
#ASSERT `האם הסכום ששולם יוחזר בתוספת ריבית שקלית (סעיף 359(ב))` TRUE TRUE
#ASSERT NOT (`האם הסכום ששולם יוחזר בתוספת ריבית שקלית (סעיף 359(ב))` TRUE FALSE)
#ASSERT NOT (`האם הסכום ששולם יוחזר בתוספת ריבית שקלית (סעיף 359(ב))` FALSE TRUE)

-- האם אני זקוק לרשות כדי לערער על החלטת בית המשפט בערעור?
#ASSERT `האם נדרשת רשות לערער על החלטת בית המשפט (סעיף 359(ג))` TRUE
#ASSERT NOT (`האם נדרשת רשות לערער על החלטת בית המשפט (סעיף 359(ג))` FALSE)

-- האם הרשם מנוע מלדרוש ממני כדירקטור את העיצום, כי החברה ציינה אחראי אחר?
-- another person was named and has not yet been asked to pay
#ASSERT `האם הרשם מנוע מלדרוש מהדירקטור את העיצום (סעיף 360(ה))` TRUE FALSE FALSE
-- I am the one named
#ASSERT NOT (`האם הרשם מנוע מלדרוש מהדירקטור את העיצום (סעיף 360(ה))` TRUE TRUE FALSE)
-- the named person was asked first and did not pay
#ASSERT NOT (`האם הרשם מנוע מלדרוש מהדירקטור את העיצום (סעיף 360(ה))` TRUE FALSE TRUE)
-- the company named nobody
#ASSERT NOT (`האם הרשם מנוע מלדרוש מהדירקטור את העיצום (סעיף 360(ה))` FALSE FALSE FALSE)

-- האם הרשם רשאי לדרוש ממני כדירקטור את העיצום הכספי שהחברה לא שילמה?
-- a director now, nobody else named
#ASSERT `האם הרשם רשאי לדרוש מהדירקטור את העיצום הכספי שהחברה לא שילמה (סעיף 360(א))` TRUE TRUE FALSE FALSE FALSE FALSE
-- a director at the time of the violation
#ASSERT `האם הרשם רשאי לדרוש מהדירקטור את העיצום הכספי שהחברה לא שילמה (סעיף 360(א))` TRUE FALSE TRUE FALSE FALSE FALSE
-- barred: another person was named and not yet asked
#ASSERT NOT (`האם הרשם רשאי לדרוש מהדירקטור את העיצום הכספי שהחברה לא שילמה (סעיף 360(א))` TRUE TRUE FALSE TRUE FALSE FALSE)
-- I am the person named
#ASSERT `האם הרשם רשאי לדרוש מהדירקטור את העיצום הכספי שהחברה לא שילמה (סעיף 360(א))` TRUE TRUE FALSE TRUE TRUE FALSE
-- the sanction was paid
#ASSERT NOT (`האם הרשם רשאי לדרוש מהדירקטור את העיצום הכספי שהחברה לא שילמה (סעיף 360(א))` FALSE TRUE FALSE FALSE FALSE FALSE)
-- never a director
#ASSERT NOT (`האם הרשם רשאי לדרוש מהדירקטור את העיצום הכספי שהחברה לא שילמה (סעיף 360(א))` TRUE FALSE FALSE FALSE FALSE FALSE)

-- האם על הדרישה שהוגשה לי כדירקטור חלים סעיפים 355 עד 359?
#ASSERT `האם על הדרישה מהדירקטור חלים סעיפים 355 עד 359 (סעיף 360(ב))` TRUE
#ASSERT NOT (`האם על הדרישה מהדירקטור חלים סעיפים 355 עד 359 (סעיף 360(ב))` FALSE)

-- האם החברה פטורה מלשלם את העיצום אם אחד מהדירקטורים שילם אותו?
#ASSERT `האם החברה אינה נדרשת לשלם את העיצום (סעיף 360(ג))` TRUE
#ASSERT NOT (`האם החברה אינה נדרשת לשלם את העיצום (סעיף 360(ג))` FALSE)

-- אם שילמתי את העיצום כדירקטור, האם אני זכאי להשבה מן החברה?
#ASSERT `האם המשלם זכאי להשבה מן החברה (סעיף 360(ג))` TRUE
#ASSERT NOT (`האם המשלם זכאי להשבה מן החברה (סעיף 360(ג))` FALSE)

-- האם בית המשפט לא יחייב אותי, כדירקטור, בתשלום העיצום?
#ASSERT `האם בית המשפט לא יחייב את הדירקטור בתשלום העיצום (סעיף 360(ד))` TRUE FALSE
#ASSERT `האם בית המשפט לא יחייב את הדירקטור בתשלום העיצום (סעיף 360(ד))` FALSE TRUE
#ASSERT NOT (`האם בית המשפט לא יחייב את הדירקטור בתשלום העיצום (סעיף 360(ד))` FALSE FALSE)

-- האם התובע רשאי להגיש נגדי כתב אישום אף שניתן היה להטיל עיצום כספי?
#ASSERT `האם התובע רשאי להגיש כתב אישום אף שניתן להטיל עיצום כספי (סעיף 361(א))` TRUE TRUE
-- reasons not recorded
#ASSERT NOT (`האם התובע רשאי להגיש כתב אישום אף שניתן להטיל עיצום כספי (סעיף 361(א))` TRUE FALSE)
#ASSERT NOT (`האם התובע רשאי להגיש כתב אישום אף שניתן להטיל עיצום כספי (סעיף 361(א))` FALSE TRUE)

-- האם אני פטור מתשלום העיצום הכספי אם הוגש נגדי כתב אישום על אותה עבירה?
#ASSERT `האם המפר אינו חייב בתשלום העיצום הכספי (סעיף 361(ב))` TRUE
#ASSERT NOT (`האם המפר אינו חייב בתשלום העיצום הכספי (סעיף 361(ב))` FALSE)

-- האם יוחזר לי העיצום ששילמתי, עם ריבית, אם הוגש נגדי כתב אישום?
#ASSERT `האם הרשם יורה על החזרת הסכום ששולם בתוספת ריבית שקלית (סעיף 361(ב))` TRUE TRUE
#ASSERT NOT (`האם הרשם יורה על החזרת הסכום ששולם בתוספת ריבית שקלית (סעיף 361(ב))` TRUE FALSE)
#ASSERT NOT (`האם הרשם יורה על החזרת הסכום ששולם בתוספת ריבית שקלית (סעיף 361(ב))` FALSE TRUE)

-- האם הרשם רשאי לבקש את פירוקה של החברה שלי בשל עיצומים שלא שולמו?
-- exactly three years apart
#ASSERT `האם הרשם רשאי לבקש את פירוקה של החברה בשל עיצומים שלא שולמו (סעיף 362)` (YearMonthDay 2024 1 1) (YearMonthDay 2027 1 1) TRUE TRUE TRUE
-- a day beyond the three years
#ASSERT NOT (`האם הרשם רשאי לבקש את פירוקה של החברה בשל עיצומים שלא שולמו (סעיף 362)` (YearMonthDay 2024 1 1) (YearMonthDay 2027 1 2) TRUE TRUE TRUE)
-- the first sanction was paid
#ASSERT NOT (`האם הרשם רשאי לבקש את פירוקה של החברה בשל עיצומים שלא שולמו (סעיף 362)` (YearMonthDay 2024 1 1) (YearMonthDay 2025 1 1) FALSE TRUE TRUE)
-- the further sanction was paid on time
#ASSERT NOT (`האם הרשם רשאי לבקש את פירוקה של החברה בשל עיצומים שלא שולמו (סעיף 362)` (YearMonthDay 2024 1 1) (YearMonthDay 2025 1 1) TRUE FALSE TRUE)
-- one of them was paid before the application
#ASSERT NOT (`האם הרשם רשאי לבקש את פירוקה של החברה בשל עיצומים שלא שולמו (סעיף 362)` (YearMonthDay 2024 1 1) (YearMonthDay 2025 1 1) TRUE TRUE FALSE)

§§ `רישום חברה כחברה מפרה (סעיף 362א)`

-- האם הרשם רשאי לפתוח בהליך לרישום החברה שלי כחברה מפרה?
-- a private company, fees unpaid
#ASSERT `האם הרשם רשאי לפתוח בהליך לרישום החברה שלי כחברה מפרה (סעיף 362א(א))` FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE
-- a private company, no annual report
#ASSERT `האם הרשם רשאי לפתוח בהליך לרישום החברה שלי כחברה מפרה (סעיף 362א(א))` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE
-- a public reporting company, no annual report: outside the report limb
#ASSERT NOT (`האם הרשם רשאי לפתוח בהליך לרישום החברה שלי כחברה מפרה (סעיף 362א(א))` FALSE TRUE FALSE FALSE TRUE TRUE FALSE TRUE)
-- a public reporting company, fees unpaid: the fee limb reaches every company
#ASSERT `האם הרשם רשאי לפתוח בהליך לרישום החברה שלי כחברה מפרה (סעיף 362א(א))` FALSE TRUE FALSE FALSE TRUE TRUE TRUE FALSE
-- a foreign company that is not reporting, no annual report
#ASSERT `האם הרשם רשאי לפתוח בהליך לרישום החברה שלי כחברה מפרה (סעיף 362א(א))` TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE
-- no ground
#ASSERT NOT (`האם הרשם רשאי לפתוח בהליך לרישום החברה שלי כחברה מפרה (סעיף 362א(א))` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)

-- האם ההתראה שנרשמה לגבי החברה שלי נרשמה ונשלחה כנדרש?
#ASSERT `האם ההתראה נרשמה ונשלחה כנדרש (סעיף 362א(ב))` TRUE TRUE
#ASSERT NOT (`האם ההתראה נרשמה ונשלחה כנדרש (סעיף 362א(ב))` TRUE FALSE)
#ASSERT NOT (`האם ההתראה נרשמה ונשלחה כנדרש (סעיף 362א(ב))` FALSE TRUE)

-- האם החברה שלי תירשם כחברה מפרה?
-- day 31
#ASSERT `האם החברה תירשם כחברה מפרה (סעיף 362א(ב))` TRUE (YearMonthDay 2026 1 1) FALSE (YearMonthDay 2026 2 1)
-- day 30
#ASSERT NOT (`האם החברה תירשם כחברה מפרה (סעיף 362א(ב))` TRUE (YearMonthDay 2026 1 1) FALSE (YearMonthDay 2026 1 31))
-- corrected
#ASSERT NOT (`האם החברה תירשם כחברה מפרה (סעיף 362א(ב))` TRUE (YearMonthDay 2026 1 1) TRUE (YearMonthDay 2026 6 1))
-- the warning was not properly recorded and sent
#ASSERT NOT (`האם החברה תירשם כחברה מפרה (סעיף 362א(ב))` FALSE (YearMonthDay 2026 1 1) FALSE (YearMonthDay 2026 6 1))

-- האם אני בעל שליטה בחברה מפרה לעניין סעיף 362א?
-- exactly half at the time of the warning
#ASSERT `האם אני בעל שליטה לעניין סעיף 362א (סעיף 362א(ג)(1)(ג))` 0.5 0
-- under half at both times
#ASSERT NOT (`האם אני בעל שליטה לעניין סעיף 362א (סעיף 362א(ג)(1)(ג))` 0.49 0.3)
-- over half at the time of the application
#ASSERT `האם אני בעל שליטה לעניין סעיף 362א (סעיף 362א(ג)(1)(ג))` 0.2 0.6

-- האם הרשם רשאי לסרב לרשום או לבצע פעולה מסוימת בקשר לחברה מפרה?
-- a section 40 act on a local defaulting company
#ASSERT `האם הרשם רשאי לסרב לרשום או לבצע פעולה בקשר לחברה מפרה (סעיף 362א(ג))` TRUE FALSE `רישום פעולה מהפעולות שבסעיף 40 לגבי החברה המפרה`
-- the section 40 limb does not reach a foreign company
#ASSERT NOT (`האם הרשם רשאי לסרב לרשום או לבצע פעולה בקשר לחברה מפרה (סעיף 362א(ג))` TRUE TRUE `רישום פעולה מהפעולות שבסעיף 40 לגבי החברה המפרה`)
-- a charge: foreign or not
#ASSERT `האם הרשם רשאי לסרב לרשום או לבצע פעולה בקשר לחברה מפרה (סעיף 362א(ג))` TRUE TRUE `רישום, שינוי או ביטול של שעבוד על נכסי החברה המפרה או לטובתה`
-- a new company with the defaulting company as shareholder
#ASSERT `האם הרשם רשאי לסרב לרשום או לבצע פעולה בקשר לחברה מפרה (סעיף 362א(ג))` TRUE FALSE `רישום חברה שבעל מניות בה הוא החברה המפרה`
-- a new company with the controller as shareholder
#ASSERT `האם הרשם רשאי לסרב לרשום או לבצע פעולה בקשר לחברה מפרה (סעיף 362א(ג))` TRUE FALSE `רישום חברה שבעל מניות בה הוא בעל שליטה בחברה המפרה`
-- a new company with a director who did not pay
#ASSERT `האם הרשם רשאי לסרב לרשום או לבצע פעולה בקשר לחברה מפרה (סעיף 362א(ג))` TRUE FALSE `רישום חברה שבעל מניות בה הוא דירקטור בחברה המפרה שלא שילם עיצום כספי שנדרש לשלמו לפי סעיף 360`
-- a merger step
#ASSERT `האם הרשם רשאי לסרב לרשום או לבצע פעולה בקשר לחברה מפרה (סעיף 362א(ג))` TRUE FALSE `ביצוע הפעולות שבסעיף 323(3) עד (5) כשאחת מהחברות המתמזגות היא חברה מפרה`
-- a pledge in favour of the defaulting company
#ASSERT `האם הרשם רשאי לסרב לרשום או לבצע פעולה בקשר לחברה מפרה (סעיף 362א(ג))` TRUE FALSE `רישום או שינוי רישום של משכון לטובת החברה המפרה`
-- not registered as defaulting
#ASSERT NOT (`האם הרשם רשאי לסרב לרשום או לבצע פעולה בקשר לחברה מפרה (סעיף 362א(ג))` FALSE FALSE `רישום חברה שבעל מניות בה הוא החברה המפרה`)

-- האם הרשם ימחק את רישום החברה שלי כחברה מפרה?
-- corrected, no further breaches
#ASSERT `האם הרשם ימחק את הרישום כחברה מפרה (סעיף 362א(ד))` TRUE FALSE FALSE
-- further breaches not all corrected
#ASSERT NOT (`האם הרשם ימחק את הרישום כחברה מפרה (סעיף 362א(ד))` TRUE TRUE FALSE)
-- all corrected
#ASSERT `האם הרשם ימחק את הרישום כחברה מפרה (סעיף 362א(ד))` TRUE TRUE TRUE
-- the breach is not corrected
#ASSERT NOT (`האם הרשם ימחק את הרישום כחברה מפרה (סעיף 362א(ד))` FALSE FALSE FALSE)

§§ `עיצום כספי בידי רשות ניירות ערך (סעיפים 363א ו־363ב)`

-- מהו הסכום הבסיסי של העיצום שרשות ניירות ערך רשאית להטיל, בשקלים?
-- a company
#ASSERT `מהו הסכום הבסיסי של העיצום שרשות ניירות ערך רשאית להטיל (סעיף 363א(א))` `המפר הוא חברה לעניין סעיף 363א(א)` 1000000 250000 EQUALS 1000000
-- an individual
#ASSERT `מהו הסכום הבסיסי של העיצום שרשות ניירות ערך רשאית להטיל (סעיף 363א(א))` `המפר הוא יחיד לעניין סעיף 363א(א)` 1000000 250000 EQUALS 250000

-- כמה ימים צריכה להימשך ההפרה כדי שרשות ניירות ערך תטיל עיצום?
#ASSERT `כמה ימים צריכה להימשך ההפרה כדי שיוטל עיצום (סעיף 363א(ב))` `העדר יושב ראש דירקטוריון` EQUALS (JUST 60)
#ASSERT `כמה ימים צריכה להימשך ההפרה כדי שיוטל עיצום (סעיף 363א(ב))` `העדר ועדת ביקורת` EQUALS (JUST 90)
#ASSERT `כמה ימים צריכה להימשך ההפרה כדי שיוטל עיצום (סעיף 363א(ב))` `העדר מנהל כללי` EQUALS (JUST 90)
#ASSERT `כמה ימים צריכה להימשך ההפרה כדי שיוטל עיצום (סעיף 363א(ב))` `העדר מבקר פנימי` EQUALS (JUST 90)
#ASSERT `כמה ימים צריכה להימשך ההפרה כדי שיוטל עיצום (סעיף 363א(ב))` `העדר שני דירקטורים חיצוניים לפחות` EQUALS (JUST 90)
#ASSERT `כמה ימים צריכה להימשך ההפרה כדי שיוטל עיצום (סעיף 363א(ב))` `העדר דירקטור חיצוני בעל מומחיות חשבונאית ופיננסית` EQUALS (JUST 90)
-- no minimum period
#ASSERT `כמה ימים צריכה להימשך ההפרה כדי שיוטל עיצום (סעיף 363א(ב))` `אי קביעת המספר המזערי הנדרש של דירקטורים בעלי מומחיות חשבונאית ופיננסית` EQUALS (NOTHING)
-- no minimum period
#ASSERT `כמה ימים צריכה להימשך ההפרה כדי שיוטל עיצום (סעיף 363א(ב))` `כהונת דירקטור או נושא משרה שהורשע בעבירה` EQUALS (NOTHING)

-- כמה ימי הפרה נספרים לעניין העיצום של רשות ניירות ערך?
-- the days needed for approval are deducted
#ASSERT `כמה ימי הפרה נספרים לעניין העיצום של רשות ניירות ערך (סעיף 363א(ד))` `העדר ועדת ביקורת` 100 10 FALSE FALSE FALSE 0 EQUALS 90
-- first external directors: counted from the last day for convening the meeting
#ASSERT `כמה ימי הפרה נספרים לעניין העיצום של רשות ניירות ערך (סעיף 363א(ד))` `העדר שני דירקטורים חיצוניים לפחות` 100 10 FALSE FALSE TRUE 40 EQUALS 30
-- not the first external directors: counted from the start
#ASSERT `כמה ימי הפרה נספרים לעניין העיצום של רשות ניירות ערך (סעיף 363א(ד))` `העדר שני דירקטורים חיצוניים לפחות` 100 10 FALSE FALSE FALSE 40 EQUALS 90
-- fewer days than the approval allowance: zero, not negative
#ASSERT `כמה ימי הפרה נספרים לעניין העיצום של רשות ניירות ערך (סעיף 363א(ד))` `העדר יושב ראש דירקטוריון` 5 10 FALSE FALSE FALSE 0 EQUALS 0

-- האם רשות ניירות ערך רשאית להטיל על החברה שלי עיצום כספי בשל הפרה?
-- a reporting company with no chair for 61 days
#ASSERT `האם רשות ניירות ערך רשאית להטיל על החברה שלי עיצום כספי (סעיף 363א(ב))` TRUE `העדר יושב ראש דירקטוריון` 61 0 FALSE FALSE FALSE 0
-- exactly 60 days is not more than 60
#ASSERT NOT (`האם רשות ניירות ערך רשאית להטיל על החברה שלי עיצום כספי (סעיף 363א(ב))` TRUE `העדר יושב ראש דירקטוריון` 60 0 FALSE FALSE FALSE 0)
-- not a reporting corporation
#ASSERT NOT (`האם רשות ניירות ערך רשאית להטיל על החברה שלי עיצום כספי (סעיף 363א(ב))` FALSE `העדר יושב ראש דירקטוריון` 100 0 FALSE FALSE FALSE 0)
-- no minimum period is set for this violation
#ASSERT `האם רשות ניירות ערך רשאית להטיל על החברה שלי עיצום כספי (סעיף 363א(ב))` TRUE `אי קביעת המספר המזערי הנדרש של דירקטורים בעלי מומחיות חשבונאית ופיננסית` 1 0 FALSE FALSE FALSE 0
-- the shortfall is due to a missing majority in the general meeting
#ASSERT NOT (`האם רשות ניירות ערך רשאית להטיל על החברה שלי עיצום כספי (סעיף 363א(ב))` TRUE `העדר ועדת ביקורת` 100 0 FALSE TRUE FALSE 0)
-- the officer did not inform of the conviction
#ASSERT NOT (`האם רשות ניירות ערך רשאית להטיל על החברה שלי עיצום כספי (סעיף 363א(ב))` TRUE `כהונת דירקטור או נושא משרה שהורשע בעבירה` 1 0 TRUE FALSE FALSE 0)
-- the officer did inform, yet served
#ASSERT `האם רשות ניירות ערך רשאית להטיל על החברה שלי עיצום כספי (סעיף 363א(ב))` TRUE `כהונת דירקטור או נושא משרה שהורשע בעבירה` 1 0 FALSE FALSE FALSE 0
-- 95 days less 10 for approvals is 85, not over 90
#ASSERT NOT (`האם רשות ניירות ערך רשאית להטיל על החברה שלי עיצום כספי (סעיף 363א(ב))` TRUE `העדר ועדת ביקורת` 95 10 FALSE FALSE FALSE 0)

-- מהי תוספת העיצום בשל הפרה נמשכת, בשקלים?
#ASSERT `מהי תוספת העיצום בשל הפרה נמשכת (סעיף 363ב(א))` 50000 3 EQUALS 3000
#ASSERT `מהי תוספת העיצום בשל הפרה נמשכת (סעיף 363ב(א))` 50000 0 EQUALS 0
#ASSERT `מהי תוספת העיצום בשל הפרה נמשכת (סעיף 363ב(א))` 100000 10 EQUALS 20000

-- האם ההפרה שלי היא הפרה חוזרת?
-- exactly two years
#ASSERT `האם ההפרה היא הפרה חוזרת (סעיף 363ב(ב))` (YearMonthDay 2024 1 1) (YearMonthDay 2026 1 1) TRUE TRUE
-- a day beyond two years
#ASSERT NOT (`האם ההפרה היא הפרה חוזרת (סעיף 363ב(ב))` (YearMonthDay 2024 1 1) (YearMonthDay 2026 1 2) TRUE TRUE)
-- a different provision
#ASSERT NOT (`האם ההפרה היא הפרה חוזרת (סעיף 363ב(ב))` (YearMonthDay 2024 1 1) (YearMonthDay 2025 1 1) FALSE TRUE)
-- no sanction was imposed for the earlier violation
#ASSERT NOT (`האם ההפרה היא הפרה חוזרת (סעיף 363ב(ב))` (YearMonthDay 2024 1 1) (YearMonthDay 2025 1 1) TRUE FALSE)

-- מהי התוספת לעיצום בשל הפרה חוזרת, בשקלים?
#ASSERT `מהי התוספת לעיצום בשל הפרה חוזרת (סעיף 363ב(ב))` 50000 TRUE EQUALS 25000
#ASSERT `מהי התוספת לעיצום בשל הפרה חוזרת (סעיף 363ב(ב))` 50000 FALSE EQUALS 0

-- מהו סכום העיצום הכספי הכולל, בשקלים, כולל התוספות?
-- 50,000 + 3,000 + 25,000
#ASSERT `מהו סכום העיצום הכספי הכולל (סעיף 363ב)` 50000 3 TRUE EQUALS 78000
#ASSERT `מהו סכום העיצום הכספי הכולל (סעיף 363ב)` 50000 3 FALSE EQUALS 53000
-- the basic amount alone
#ASSERT `מהו סכום העיצום הכספי הכולל (סעיף 363ב)` 50000 0 FALSE EQUALS 50000

§§ `חברות שניירות הערך שלהן נסחרים מחוץ לישראל (סעיפים 364 עד 365א)`

-- האם הוראה בחוק שמוגבלת לחברה ציבורית או לחברת איגרות חוב חלה על החברה שלי?
-- a public company
#ASSERT `האם החברה שלי היא חברה ציבורית או חברה פרטית שהיא חברת איגרות חוב (סעיף 364)` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE
-- a private company with no bonds
#ASSERT NOT (`האם החברה שלי היא חברה ציבורית או חברה פרטית שהיא חברת איגרות חוב (סעיף 364)` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
-- a private bond company
#ASSERT `האם החברה שלי היא חברה ציבורית או חברה פרטית שהיא חברת איגרות חוב (סעיף 364)` FALSE FALSE FALSE FALSE TRUE FALSE FALSE TRUE
-- bonds listed but not held by the public
#ASSERT NOT (`האם החברה שלי היא חברה ציבורית או חברה פרטית שהיא חברת איגרות חוב (סעיף 364)` FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE)

-- האם הוראה בחוק אינה חלה על החברה שלי, שניירות הערך שלה נסחרים רק מחוץ לישראל?
-- a public company traded only abroad, and the Minister so determined
#ASSERT `האם ההוראה אינה חלה על החברה שניירות הערך שלה נסחרים רק מחוץ לישראל (סעיף 364(א))` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE TRUE TRUE
-- no determination by the Minister
#ASSERT NOT (`האם ההוראה אינה חלה על החברה שניירות הערך שלה נסחרים רק מחוץ לישראל (סעיף 364(א))` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE TRUE FALSE)
-- also traded in Israel
#ASSERT NOT (`האם ההוראה אינה חלה על החברה שניירות הערך שלה נסחרים רק מחוץ לישראל (סעיף 364(א))` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE TRUE)
-- a private company with no bonds is outside the provision altogether
#ASSERT NOT (`האם ההוראה אינה חלה על החברה שניירות הערך שלה נסחרים רק מחוץ לישראל (סעיף 364(א))` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE)

-- האם הוראה בחוק אינה חלה על החברה שלי, הרשומה בבורסה בישראל ומחוץ לישראל?
#ASSERT `האם ההוראה אינה חלה על חברה הרשומה בבורסה בישראל ומחוץ לישראל (סעיף 364(ב))` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE TRUE TRUE
-- the Minister did not so determine
#ASSERT NOT (`האם ההוראה אינה חלה על חברה הרשומה בבורסה בישראל ומחוץ לישראל (סעיף 364(ב))` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE TRUE FALSE)
-- not dual-listed
#ASSERT NOT (`האם ההוראה אינה חלה על חברה הרשומה בבורסה בישראל ומחוץ לישראל (סעיף 364(ב))` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE TRUE)

-- איזה דיווח חל על החברה שלי, שניירות הערך שלה נסחרים רק מחוץ לישראל?
#ASSERT `איזה דיווח חל על החברה שניירות הערך שלה נסחרים רק מחוץ לישראל (סעיף 365)` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS (`דיווחים לרשם החברות כמו חברה שאינה תאגיד מדווח`)
#ASSERT `איזה דיווח חל על החברה שניירות הערך שלה נסחרים רק מחוץ לישראל (סעיף 365)` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS (`הוראות סעיפים 142 עד 145`)
-- also traded in Israel
#ASSERT `איזה דיווח חל על החברה שניירות הערך שלה נסחרים רק מחוץ לישראל (סעיף 365)` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS (`סעיף 365 אינו חל על החברה`)
-- a private company with no bonds
#ASSERT `איזה דיווח חל על החברה שניירות הערך שלה נסחרים רק מחוץ לישראל (סעיף 365)` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS (`סעיף 365 אינו חל על החברה`)

-- האם הוראה בחוק אינה חלה על חברת איגרות החוב שלי?
-- a bond company in the class, and the provision is covered
#ASSERT `האם ההוראה אינה חלה על חברת איגרות החוב (סעיף 365א)` FALSE FALSE FALSE FALSE TRUE FALSE FALSE TRUE TRUE TRUE
-- the determination does not cover the provision
#ASSERT NOT (`האם ההוראה אינה חלה על חברת איגרות החוב (סעיף 365א)` FALSE FALSE FALSE FALSE TRUE FALSE FALSE TRUE TRUE FALSE)
-- not a bond company
#ASSERT NOT (`האם ההוראה אינה חלה על חברת איגרות החוב (סעיף 365א)` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE)

§§ `ביטול, הוראות מעבר, תחולה ותחילה (סעיפים 367 עד 378)`

-- האם הוראה בפקודת החברות נשארה בתוקף אחרי תחילת החוק?
-- inside 164-201
#ASSERT `האם ההוראה בפקודת החברות נשארה בתוקף (סעיף 367(א))` 170 FALSE FALSE FALSE FALSE FALSE FALSE FALSE
-- just after 201
#ASSERT NOT (`האם ההוראה בפקודת החברות נשארה בתוקף (סעיף 367(א))` 202 FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
-- first of the first range
#ASSERT `האם ההוראה בפקודת החברות נשארה בתוקף (סעיף 367(א))` 164 FALSE FALSE FALSE FALSE FALSE FALSE FALSE
-- first of the second range
#ASSERT `האם ההוראה בפקודת החברות נשארה בתוקף (סעיף 367(א))` 244 FALSE FALSE FALSE FALSE FALSE FALSE FALSE
-- last of the second range
#ASSERT `האם ההוראה בפקודת החברות נשארה בתוקף (סעיף 367(א))` 367 FALSE FALSE FALSE FALSE FALSE FALSE FALSE
-- between the ranges
#ASSERT NOT (`האם ההוראה בפקודת החברות נשארה בתוקף (סעיף 367(א))` 368 FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
-- first of the third range
#ASSERT `האם ההוראה בפקודת החברות נשארה בתוקף (סעיף 367(א))` 370 FALSE FALSE FALSE FALSE FALSE FALSE FALSE
-- last of the third range
#ASSERT `האם ההוראה בפקודת החברות נשארה בתוקף (סעיף 367(א))` 382 FALSE FALSE FALSE FALSE FALSE FALSE FALSE
-- after 382
#ASSERT NOT (`האם ההוראה בפקודת החברות נשארה בתוקף (סעיף 367(א))` 383 FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
-- s 1 for secured bonds, charges and winding up
#ASSERT `האם ההוראה בפקודת החברות נשארה בתוקף (סעיף 367(א))` 1 TRUE FALSE FALSE FALSE FALSE FALSE FALSE
-- s 1 otherwise
#ASSERT NOT (`האם ההוראה בפקודת החברות נשארה בתוקף (סעיף 367(א))` 1 FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
-- s 394 for the same subjects
#ASSERT `האם ההוראה בפקודת החברות נשארה בתוקף (סעיף 367(א))` 394 TRUE FALSE FALSE FALSE FALSE FALSE FALSE
-- s 33 for a company exempted under s 32
#ASSERT `האם ההוראה בפקודת החברות נשארה בתוקף (סעיף 367(א))` 33 FALSE FALSE FALSE FALSE TRUE FALSE FALSE
-- s 33 for any other company
#ASSERT NOT (`האם ההוראה בפקודת החברות נשארה בתוקף (סעיף 367(א))` 33 FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
-- s 369 for a company struck off before
#ASSERT `האם ההוראה בפקודת החברות נשארה בתוקף (סעיף 367(א))` 369 FALSE FALSE FALSE FALSE FALSE TRUE FALSE
-- s 369 otherwise
#ASSERT NOT (`האם ההוראה בפקודת החברות נשארה בתוקף (סעיף 367(א))` 369 FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
-- a memorandum-alteration condition where s 24 applies
#ASSERT `האם ההוראה בפקודת החברות נשארה בתוקף (סעיף 367(א))` 20 FALSE TRUE FALSE FALSE FALSE FALSE TRUE
-- where s 24 does not apply
#ASSERT NOT (`האם ההוראה בפקודת החברות נשארה בתוקף (סעיף 367(א))` 20 FALSE TRUE FALSE FALSE FALSE FALSE FALSE)
-- s 115A and a required general-meeting resolution
#ASSERT `האם ההוראה בפקודת החברות נשארה בתוקף (סעיף 367(א))` 115 FALSE FALSE TRUE TRUE FALSE FALSE FALSE
-- s 115A but no required resolution
#ASSERT NOT (`האם ההוראה בפקודת החברות נשארה בתוקף (סעיף 367(א))` 115 FALSE FALSE TRUE FALSE FALSE FALSE FALSE)

-- האם הוראה שנשארה בתוקף בפקודת החברות תפורש לאור הוראות חוק החברות?
#ASSERT `האם ההוראה שנשארה בתוקף תפורש לאור הוראות החוק (סעיף 367(ב))` TRUE
#ASSERT NOT (`האם ההוראה שנשארה בתוקף תפורש לאור הוראות החוק (סעיף 367(ב))` FALSE)

-- האם הוראה מהתוספת השנייה לפקודה נחשבת כאילו נכללה בתקנון החברה שלי?
#ASSERT `האם הוראה מהתוספת השנייה לפקודה נחשבת כאילו נכללה בתקנון (סעיף 368(א))` 23 TRUE TRUE TRUE
-- last of 23-29
#ASSERT `האם הוראה מהתוספת השנייה לפקודה נחשבת כאילו נכללה בתקנון (סעיף 368(א))` 29 TRUE TRUE TRUE
-- just before 23
#ASSERT NOT (`האם הוראה מהתוספת השנייה לפקודה נחשבת כאילו נכללה בתקנון (סעיף 368(א))` 22 TRUE TRUE TRUE)
-- just after 29
#ASSERT NOT (`האם הוראה מהתוספת השנייה לפקודה נחשבת כאילו נכללה בתקנון (סעיף 368(א))` 30 TRUE TRUE TRUE)
#ASSERT `האם הוראה מהתוספת השנייה לפקודה נחשבת כאילו נכללה בתקנון (סעיף 368(א))` 51 TRUE TRUE TRUE
#ASSERT `האם הוראה מהתוספת השנייה לפקודה נחשבת כאילו נכללה בתקנון (סעיף 368(א))` 58 TRUE TRUE TRUE
#ASSERT `האם הוראה מהתוספת השנייה לפקודה נחשבת כאילו נכללה בתקנון (סעיף 368(א))` 91 TRUE TRUE TRUE
#ASSERT NOT (`האם הוראה מהתוספת השנייה לפקודה נחשבת כאילו נכללה בתקנון (סעיף 368(א))` 52 TRUE TRUE TRUE)
-- incorporated after commencement
#ASSERT NOT (`האם הוראה מהתוספת השנייה לפקודה נחשבת כאילו נכללה בתקנון (סעיף 368(א))` 25 FALSE TRUE TRUE)
-- articles altered
#ASSERT NOT (`האם הוראה מהתוספת השנייה לפקודה נחשבת כאילו נכללה בתקנון (סעיף 368(א))` 25 TRUE TRUE FALSE)

-- האם ייחשב כאילו נקבע בתקנון שלי שליושב ראש הדירקטוריון אין קול נוסף?
#ASSERT `האם התקנון נחשב כאילו נקבע בו שליושב ראש הדירקטוריון אין קול נוסף (סעיף 368(ב))` TRUE FALSE TRUE
-- the articles provide otherwise
#ASSERT NOT (`האם התקנון נחשב כאילו נקבע בו שליושב ראש הדירקטוריון אין קול נוסף (סעיף 368(ב))` TRUE TRUE TRUE)
-- incorporated later
#ASSERT NOT (`האם התקנון נחשב כאילו נקבע בו שליושב ראש הדירקטוריון אין קול נוסף (סעיף 368(ב))` FALSE FALSE TRUE)
-- articles altered
#ASSERT NOT (`האם התקנון נחשב כאילו נקבע בו שליושב ראש הדירקטוריון אין קול נוסף (סעיף 368(ב))` TRUE FALSE FALSE)

-- האם זכויות ההצבעה מהמניות שחברה בת רכשה לפני תחילת החוק נשמרות?
#ASSERT `האם זכויות ההצבעה מהמניות שנרכשו לפני התחילה נשמרות (סעיף 369(א))` TRUE TRUE
#ASSERT NOT (`האם זכויות ההצבעה מהמניות שנרכשו לפני התחילה נשמרות (סעיף 369(א))` TRUE FALSE)
#ASSERT NOT (`האם זכויות ההצבעה מהמניות שנרכשו לפני התחילה נשמרות (סעיף 369(א))` FALSE TRUE)

-- כמה מהמניות שנרכשו לפני תחילת החוק עדיין נחשבות כמניות שנרכשו לפני התחילה?
-- sales within the later purchases
#ASSERT `כמה מהמניות שנרכשו לפני התחילה נותרו (סעיף 369(ב))` 100 50 30 EQUALS 100
#ASSERT `כמה מהמניות שנרכשו לפני התחילה נותרו (סעיף 369(ב))` 100 50 50 EQUALS 100
-- 20 of the sales reach the earlier shares
#ASSERT `כמה מהמניות שנרכשו לפני התחילה נותרו (סעיף 369(ב))` 100 50 70 EQUALS 80
-- cannot go below zero
#ASSERT `כמה מהמניות שנרכשו לפני התחילה נותרו (סעיף 369(ב))` 100 50 200 EQUALS 0
#ASSERT `כמה מהמניות שנרכשו לפני התחילה נותרו (סעיף 369(ב))` 100 0 30 EQUALS 70

-- האם חברי החברה שלי, שהייתה חברה מוגבלת בערבות, נחשבים בעלי מניות?
#ASSERT `האם חברי החברה נחשבים בעלי מניות בחברה שיש לה הון מניות ללא ערך נקוב (סעיף 370)` TRUE TRUE
#ASSERT NOT (`האם חברי החברה נחשבים בעלי מניות בחברה שיש לה הון מניות ללא ערך נקוב (סעיף 370)` TRUE FALSE)
#ASSERT NOT (`האם חברי החברה נחשבים בעלי מניות בחברה שיש לה הון מניות ללא ערך נקוב (סעיף 370)` FALSE TRUE)

-- האם אני רשאי להמשיך לכהן כמבקר פנימי שאושר לפי החוק הקודם?
#ASSERT `האם מי שכיהן כמבקר פנימי רשאי להמשיך ולכהן (סעיף 371)` TRUE TRUE
#ASSERT NOT (`האם מי שכיהן כמבקר פנימי רשאי להמשיך ולכהן (סעיף 371)` TRUE FALSE)
#ASSERT NOT (`האם מי שכיהן כמבקר פנימי רשאי להמשיך ולכהן (סעיף 371)` FALSE TRUE)

-- האם אני, שמוניתי דירקטור מקרב הציבור לפי הפקודה, נחשב דירקטור חיצוני?
#ASSERT `האם דירקטור מקרב הציבור נחשב דירקטור חיצוני (סעיף 372)` TRUE
#ASSERT NOT (`האם דירקטור מקרב הציבור נחשב דירקטור חיצוני (סעיף 372)` FALSE)

-- האם משך כהונתי וחידושה כדירקטור מקרב הציבור נקבעים לפי הפקודה?
#ASSERT `האם משך הכהונה וחידושה של דירקטור מקרב הציבור נקבעים לפי הפקודה (סעיף 372)` TRUE
#ASSERT NOT (`האם משך הכהונה וחידושה של דירקטור מקרב הציבור נקבעים לפי הפקודה (סעיף 372)` FALSE)

-- מאיזה יום סעיף מסוים בחוק נכנס לתוקף?
-- an ordinary section: the commencement day
#ASSERT `מאיזה יום נכנס לתוקף סעיף מסוים בחוק (סעיף 377)` 50 FALSE (YearMonthDay 2001 1 1) FALSE (YearMonthDay 1999 5 27) FALSE (YearMonthDay 2001 1 1) EQUALS (JUST (YearMonthDay 2000 2 1))
-- ss 87-89: the day set by regulations
#ASSERT `מאיזה יום נכנס לתוקף סעיף מסוים בחוק (סעיף 377)` 88 TRUE (YearMonthDay 2001 3 1) FALSE (YearMonthDay 1999 5 27) FALSE (YearMonthDay 2001 1 1) EQUALS (JUST (YearMonthDay 2001 3 1))
-- ss 87-89 with no regulations yet
#ASSERT `מאיזה יום נכנס לתוקף סעיף מסוים בחוק (סעיף 377)` 88 FALSE (YearMonthDay 2001 3 1) FALSE (YearMonthDay 1999 5 27) FALSE (YearMonthDay 2001 1 1) EQUALS (NOTHING)
-- ss 143, 145: three years from publication when no earlier day is set
#ASSERT `מאיזה יום נכנס לתוקף סעיף מסוים בחוק (סעיף 377)` 143 FALSE (YearMonthDay 2001 3 1) TRUE (YearMonthDay 1999 5 27) FALSE (YearMonthDay 2001 1 1) EQUALS (JUST (YearMonthDay 2002 5 27))
-- an earlier day was set
#ASSERT `מאיזה יום נכנס לתוקף סעיף מסוים בחוק (סעיף 377)` 145 FALSE (YearMonthDay 2001 3 1) TRUE (YearMonthDay 1999 5 27) TRUE (YearMonthDay 2001 1 1) EQUALS (JUST (YearMonthDay 2001 1 1))
-- no electronic-reporting provisions yet
#ASSERT `מאיזה יום נכנס לתוקף סעיף מסוים בחוק (סעיף 377)` 143 FALSE (YearMonthDay 2001 3 1) FALSE (YearMonthDay 1999 5 27) TRUE (YearMonthDay 2001 1 1) EQUALS (NOTHING)

§§ `התוספת הראשונה: הוראות ממשל תאגידי מומלצות`

-- האם ההוראה המומלצת בתוספת הראשונה חלה על החברה שלי?
-- a public company that adopted item 1
#ASSERT `האם ההוראה המומלצת בתוספת הראשונה חלה על החברה שלי (התוספת הראשונה)` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE `פרט 1: שיעור הדירקטורים הבלתי תלויים` TRUE
-- not adopted
#ASSERT NOT (`האם ההוראה המומלצת בתוספת הראשונה חלה על החברה שלי (התוספת הראשונה)` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE `פרט 1: שיעור הדירקטורים הבלתי תלויים` FALSE)
-- a private bond company that adopted item 3
#ASSERT `האם ההוראה המומלצת בתוספת הראשונה חלה על החברה שלי (התוספת הראשונה)` FALSE FALSE FALSE FALSE TRUE FALSE FALSE TRUE `פרט 3: הגבלת כהונת נושא משרה כדירקטור` TRUE
-- item 7 is for a public company only
#ASSERT NOT (`האם ההוראה המומלצת בתוספת הראשונה חלה על החברה שלי (התוספת הראשונה)` FALSE FALSE FALSE FALSE TRUE FALSE FALSE TRUE `פרט 7: מינוי דירקטור חיצוני` TRUE)
-- a private company with no bonds
#ASSERT NOT (`האם ההוראה המומלצת בתוספת הראשונה חלה על החברה שלי (התוספת הראשונה)` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `פרט 1: שיעור הדירקטורים הבלתי תלויים` TRUE)
-- a public company that adopted item 7
#ASSERT `האם ההוראה המומלצת בתוספת הראשונה חלה על החברה שלי (התוספת הראשונה)` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE `פרט 7: מינוי דירקטור חיצוני` TRUE

-- האם שיעור הדירקטורים הבלתי תלויים בדירקטוריון שלי עומד בהוראה המומלצת?
-- a controller: exactly a third
#ASSERT `האם שיעור הדירקטורים הבלתי תלויים מתקיים (תוספת 1 פרט 1)` TRUE 0.4 9 3
-- a controller: under a third
#ASSERT NOT (`האם שיעור הדירקטורים הבלתי תלויים מתקיים (תוספת 1 פרט 1)` TRUE 0.4 9 2)
-- no controller: more than half
#ASSERT `האם שיעור הדירקטורים הבלתי תלויים מתקיים (תוספת 1 פרט 1)` FALSE 0.1 9 5
-- no controller: not more than half
#ASSERT NOT (`האם שיעור הדירקטורים הבלתי תלויים מתקיים (תוספת 1 פרט 1)` FALSE 0.1 9 4)
-- no controller by the Securities Law, but a quarter of the votes is a control group: a third suffices
#ASSERT `האם שיעור הדירקטורים הבלתי תלויים מתקיים (תוספת 1 פרט 1)` FALSE 0.25 9 3

-- האם מינוי הדירקטור שאני מציע מגוון את הרכב הדירקטוריון?
#ASSERT `האם המינוי גיוון את הרכב הדירקטוריון (תוספת 1 פרט 2)` TRUE TRUE TRUE
#ASSERT NOT (`האם המינוי גיוון את הרכב הדירקטוריון (תוספת 1 פרט 2)` FALSE TRUE TRUE)
#ASSERT NOT (`האם המינוי גיוון את הרכב הדירקטוריון (תוספת 1 פרט 2)` TRUE FALSE TRUE)
#ASSERT NOT (`האם המינוי גיוון את הרכב הדירקטוריון (תוספת 1 פרט 2)` TRUE TRUE FALSE)

-- האם אני רשאי לכהן כדירקטור, אף שאני כפוף למנהל הכללי?
-- not subordinate to the general manager
#ASSERT `האם אני רשאי לכהן כדירקטור (תוספת 1 פרט 3)` FALSE FALSE FALSE FALSE
-- subordinate, no exception
#ASSERT NOT (`האם אני רשאי לכהן כדירקטור (תוספת 1 פרט 3)` TRUE FALSE FALSE FALSE)
-- an employee representative where the company has such representation
#ASSERT `האם אני רשאי לכהן כדירקטור (תוספת 1 פרט 3)` TRUE TRUE TRUE FALSE
-- claims to be an employee representative but the company has none
#ASSERT NOT (`האם אני רשאי לכהן כדירקטור (תוספת 1 פרט 3)` TRUE TRUE FALSE FALSE)
-- a director of a controlled corporation
#ASSERT `האם אני רשאי לכהן כדירקטור (תוספת 1 פרט 3)` TRUE FALSE FALSE TRUE

-- האם החברה שלי דאגה להכשרת הדירקטורים כפי שמומלץ?
#ASSERT `האם החברה דאגה להכשרת הדירקטורים (תוספת 1 פרט 4(א))` TRUE TRUE TRUE
#ASSERT NOT (`האם החברה דאגה להכשרת הדירקטורים (תוספת 1 פרט 4(א))` TRUE FALSE TRUE)
#ASSERT NOT (`האם החברה דאגה להכשרת הדירקטורים (תוספת 1 פרט 4(א))` FALSE TRUE TRUE)
#ASSERT NOT (`האם החברה דאגה להכשרת הדירקטורים (תוספת 1 פרט 4(א))` TRUE TRUE FALSE)

-- האם האחראי להטמעת הוראות הממשל התאגידי בחברה שלי פועל כמומלץ?
#ASSERT `האם האחראי להטמעת הוראות הממשל התאגידי פועל כנדרש (תוספת 1 פרט 4(ב))` TRUE TRUE
#ASSERT NOT (`האם האחראי להטמעת הוראות הממשל התאגידי פועל כנדרש (תוספת 1 פרט 4(ב))` TRUE FALSE)
#ASSERT NOT (`האם האחראי להטמעת הוראות הממשל התאגידי פועל כנדרש (תוספת 1 פרט 4(ב))` FALSE TRUE)

-- האם הדירקטוריון שלי קיים את הדיון השנתי בלא נוכחות המנהל הכללי, כמומלץ?
#ASSERT `האם הדירקטוריון קיים את הדיון השנתי בלא נוכחות המנהל הכללי (תוספת 1 פרט 5)` 1 TRUE
#ASSERT NOT (`האם הדירקטוריון קיים את הדיון השנתי בלא נוכחות המנהל הכללי (תוספת 1 פרט 5)` 0 TRUE)
-- no opportunity to state their position
#ASSERT NOT (`האם הדירקטוריון קיים את הדיון השנתי בלא נוכחות המנהל הכללי (תוספת 1 פרט 5)` 2 FALSE)

-- האם ועדת הביקורת שלי קיימה את הישיבה השנתית שמומלצת?
#ASSERT `האם ועדת הביקורת קיימה את הישיבה השנתית (תוספת 1 פרט 6)` 1 TRUE TRUE TRUE
#ASSERT NOT (`האם ועדת הביקורת קיימה את הישיבה השנתית (תוספת 1 פרט 6)` 0 TRUE TRUE TRUE)
#ASSERT NOT (`האם ועדת הביקורת קיימה את הישיבה השנתית (תוספת 1 פרט 6)` 1 FALSE TRUE TRUE)
#ASSERT NOT (`האם ועדת הביקורת קיימה את הישיבה השנתית (תוספת 1 פרט 6)` 1 TRUE FALSE TRUE)
#ASSERT NOT (`האם ועדת הביקורת קיימה את הישיבה השנתית (תוספת 1 פרט 6)` 1 TRUE TRUE FALSE)

-- האם קולי כבעל מניות נספר בהצבעה על מינוי דירקטור חיצוני?
-- an ordinary shareholder
#ASSERT `האם קולו של בעל המניות נספר (תוספת 1 פרט 7(1))` FALSE FALSE FALSE FALSE
-- a controller
#ASSERT NOT (`האם קולו של בעל המניות נספר (תוספת 1 פרט 7(1))` TRUE FALSE FALSE FALSE)
-- a personal interest not from a tie to the controller
#ASSERT `האם קולו של בעל המניות נספר (תוספת 1 פרט 7(1))` FALSE TRUE TRUE FALSE
-- a personal interest from a tie to the controller
#ASSERT NOT (`האם קולו של בעל המניות נספר (תוספת 1 פרט 7(1))` FALSE TRUE FALSE FALSE)
-- abstained
#ASSERT NOT (`האם קולו של בעל המניות נספר (תוספת 1 פרט 7(1))` FALSE FALSE FALSE TRUE)

-- האם ההצבעה באסיפה הכללית מספיקה למינוי הדירקטור החיצוני?
-- more for than against, and above 2%
#ASSERT `האם ההצבעה באסיפה הכללית מספיקה למינוי (תוספת 1 פרט 7(2))` 300 100 0 10000
-- exactly 2% is not above 2%
#ASSERT NOT (`האם ההצבעה באסיפה הכללית מספיקה למינוי (תוספת 1 פרט 7(2))` 200 100 0 10000)
#ASSERT `האם ההצבעה באסיפה הכללית מספיקה למינוי (תוספת 1 פרט 7(2))` 201 100 0 10000
-- a tie
#ASSERT NOT (`האם ההצבעה באסיפה הכללית מספיקה למינוי (תוספת 1 פרט 7(2))` 300 300 0 10000)
-- more against
#ASSERT NOT (`האם ההצבעה באסיפה הכללית מספיקה למינוי (תוספת 1 פרט 7(2))` 300 400 50 10000)

-- האם הדירקטור שימונה עומד בתנאי העצמאות?
#ASSERT `האם הדירקטור שימונה עומד בתנאי העצמאות (תוספת 1 פרט 7(3))` FALSE FALSE FALSE
#ASSERT NOT (`האם הדירקטור שימונה עומד בתנאי העצמאות (תוספת 1 פרט 7(3))` TRUE FALSE FALSE)
#ASSERT NOT (`האם הדירקטור שימונה עומד בתנאי העצמאות (תוספת 1 פרט 7(3))` FALSE TRUE FALSE)
#ASSERT NOT (`האם הדירקטור שימונה עומד בתנאי העצמאות (תוספת 1 פרט 7(3))` FALSE FALSE TRUE)

-- האם בעל מניה הוא "קשור או מתחרה" לעניין מינוי דירקטור חיצוני?
-- proposed the appointment and has business ties
#ASSERT `האם בעל המניה הוא בעל מניה קשור או מתחרה (תוספת 1 פרט 7(3))` TRUE TRUE FALSE FALSE
-- a competitor
#ASSERT `האם בעל המניה הוא בעל מניה קשור או מתחרה (תוספת 1 פרט 7(3))` TRUE FALSE TRUE FALSE
-- the Minister excluded these matters
#ASSERT NOT (`האם בעל המניה הוא בעל מניה קשור או מתחרה (תוספת 1 פרט 7(3))` TRUE TRUE FALSE TRUE)
-- did not propose and is not material
#ASSERT NOT (`האם בעל המניה הוא בעל מניה קשור או מתחרה (תוספת 1 פרט 7(3))` FALSE TRUE TRUE FALSE)
-- no tie and no competition
#ASSERT NOT (`האם בעל המניה הוא בעל מניה קשור או מתחרה (תוספת 1 פרט 7(3))` TRUE FALSE FALSE FALSE)

-- האם יש לדירקטור שימונה זיקה כהגדרתה בפרט 7
#ASSERT `האם יש לדירקטור שימונה זיקה (תוספת 1 פרט 7(3))` TRUE FALSE
#ASSERT NOT (`האם יש לדירקטור שימונה זיקה (תוספת 1 פרט 7(3))` TRUE TRUE)
#ASSERT NOT (`האם יש לדירקטור שימונה זיקה (תוספת 1 פרט 7(3))` FALSE FALSE)

§§ `התוספת הראשונה א׳: מדיניות התגמול`

-- האם מדיניות התגמול מתייחסת להשכלה, כישורים, מומחיות, ניסיון והישגים של נושא המשרה?
#ASSERT `האם המדיניות מתייחסת להשכלה, כישורים, מומחיות, ניסיון והישגים (תוספת 1א חלק א פרט 1)` TRUE
#ASSERT NOT (`האם המדיניות מתייחסת להשכלה, כישורים, מומחיות, ניסיון והישגים (תוספת 1א חלק א פרט 1)` FALSE)

-- האם מדיניות התגמול מתייחסת לתפקיד נושא המשרה, לאחריותו ולהסכמי שכר קודמים?
#ASSERT `האם המדיניות מתייחסת לתפקיד, לאחריות ולהסכמי שכר קודמים (תוספת 1א חלק א פרט 2)` TRUE
#ASSERT NOT (`האם המדיניות מתייחסת לתפקיד, לאחריות ולהסכמי שכר קודמים (תוספת 1א חלק א פרט 2)` FALSE)

-- האם מדיניות התגמול מתייחסת ליחס בין עלות שכרו של נושא המשרה לשכר שאר העובדים?
#ASSERT `האם המדיניות מתייחסת ליחסי העלות (תוספת 1א חלק א פרט 3)` TRUE TRUE TRUE
#ASSERT NOT (`האם המדיניות מתייחסת ליחסי העלות (תוספת 1א חלק א פרט 3)` TRUE TRUE FALSE)
#ASSERT NOT (`האם המדיניות מתייחסת ליחסי העלות (תוספת 1א חלק א פרט 3)` FALSE TRUE TRUE)
#ASSERT NOT (`האם המדיניות מתייחסת ליחסי העלות (תוספת 1א חלק א פרט 3)` TRUE FALSE TRUE)

-- האם אדם הוא עובד קבלן שהחברה מעסיקה לעניין חישוב היחס?
#ASSERT `האם האדם הוא עובד קבלן המועסק אצל החברה (תוספת 1א חלק א פרט 3)` TRUE FALSE
#ASSERT `האם האדם הוא עובד קבלן המועסק אצל החברה (תוספת 1א חלק א פרט 3)` FALSE TRUE
#ASSERT NOT (`האם האדם הוא עובד קבלן המועסק אצל החברה (תוספת 1א חלק א פרט 3)` FALSE FALSE)

-- האם תשלום הוא "עלות שכר" לעניין חישוב היחס?
#ASSERT `האם התשלום הוא עלות שכר (תוספת 1א חלק א פרט 3)` TRUE
#ASSERT NOT (`האם התשלום הוא עלות שכר (תוספת 1א חלק א פרט 3)` FALSE)

-- האם מדיניות התגמול מתייחסת לרכיבים המשתנים כנדרש?
-- no variable components, nothing to address
#ASSERT `האם המדיניות מתייחסת לרכיבים המשתנים (תוספת 1א חלק א פרט 4)` FALSE FALSE FALSE
#ASSERT `האם המדיניות מתייחסת לרכיבים המשתנים (תוספת 1א חלק א פרט 4)` TRUE TRUE TRUE
#ASSERT NOT (`האם המדיניות מתייחסת לרכיבים המשתנים (תוספת 1א חלק א פרט 4)` TRUE TRUE FALSE)
#ASSERT NOT (`האם המדיניות מתייחסת לרכיבים המשתנים (תוספת 1א חלק א פרט 4)` TRUE FALSE TRUE)

-- האם מדיניות התגמול מתייחסת למענקי הפרישה כנדרש?
-- no retirement grants
#ASSERT `האם המדיניות מתייחסת למענקי הפרישה (תוספת 1א חלק א פרט 5)` FALSE FALSE FALSE FALSE FALSE
#ASSERT `האם המדיניות מתייחסת למענקי הפרישה (תוספת 1א חלק א פרט 5)` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`האם המדיניות מתייחסת למענקי הפרישה (תוספת 1א חלק א פרט 5)` TRUE TRUE TRUE TRUE FALSE)
#ASSERT NOT (`האם המדיניות מתייחסת למענקי הפרישה (תוספת 1א חלק א פרט 5)` TRUE FALSE TRUE TRUE TRUE)

-- האם מדיניות התגמול מתייחסת לכל העניינים שחובה להתייחס אליהם בחלק א׳?
#ASSERT `האם המדיניות מתייחסת לכל העניינים שחובה להתייחס אליהם (תוספת 1א חלק א)` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`האם המדיניות מתייחסת לכל העניינים שחובה להתייחס אליהם (תוספת 1א חלק א)` TRUE TRUE TRUE TRUE FALSE)
#ASSERT NOT (`האם המדיניות מתייחסת לכל העניינים שחובה להתייחס אליהם (תוספת 1א חלק א)` FALSE TRUE TRUE TRUE TRUE)

-- האם מדיניות התגמול עומדת בדרישת הרכיבים המשתנים שבפרט 1
-- subordinate to the general manager: exempt
#ASSERT `האם המדיניות עומדת בפרט משנה (א) (תוספת 1א חלק ב פרט 1(א))` TRUE FALSE FALSE FALSE 0 0
-- long-term and measurable throughout
#ASSERT `האם המדיניות עומדת בפרט משנה (א) (תוספת 1א חלק ב פרט 1(א))` FALSE TRUE FALSE FALSE 0 0
-- a non-measurable part that is immaterial
#ASSERT `האם המדיניות עומדת בפרט משנה (א) (תוספת 1א חלק ב פרט 1(א))` FALSE TRUE TRUE TRUE 90000 10000
-- a non-measurable part within three monthly salaries
#ASSERT `האם המדיניות עומדת בפרט משנה (א) (תוספת 1א חלק ב פרט 1(א))` FALSE TRUE TRUE FALSE 30000 10000
-- a non-measurable material part above three monthly salaries
#ASSERT NOT (`האם המדיניות עומדת בפרט משנה (א) (תוספת 1א חלק ב פרט 1(א))` FALSE TRUE TRUE FALSE 30001 10000)
-- not long-term and measurable
#ASSERT NOT (`האם המדיניות עומדת בפרט משנה (א) (תוספת 1א חלק ב פרט 1(א))` FALSE FALSE FALSE FALSE 0 0)

-- האם מדיניות התגמול עומדת בדרישת היחס והתקרות שבפרט 1
#ASSERT `האם המדיניות עומדת בפרט משנה (ב) (תוספת 1א חלק ב פרט 1(ב))` TRUE TRUE TRUE TRUE TRUE
-- cash components without a cap
#ASSERT NOT (`האם המדיניות עומדת בפרט משנה (ב) (תוספת 1א חלק ב פרט 1(ב))` TRUE TRUE FALSE FALSE FALSE)
-- equity components without a cap
#ASSERT NOT (`האם המדיניות עומדת בפרט משנה (ב) (תוספת 1א חלק ב פרט 1(ב))` TRUE FALSE FALSE TRUE FALSE)
-- no variable components of either kind
#ASSERT `האם המדיניות עומדת בפרט משנה (ב) (תוספת 1א חלק ב פרט 1(ב))` TRUE FALSE FALSE FALSE FALSE
-- the ratio is not set
#ASSERT NOT (`האם המדיניות עומדת בפרט משנה (ב) (תוספת 1א חלק ב פרט 1(ב))` FALSE TRUE TRUE TRUE TRUE)

-- האם מדיניות התגמול כוללת תניית השבה?
#ASSERT `האם המדיניות כוללת תניית השבה (תוספת 1א חלק ב פרט 2)` TRUE TRUE
#ASSERT NOT (`האם המדיניות כוללת תניית השבה (תוספת 1א חלק ב פרט 2)` TRUE FALSE)
#ASSERT NOT (`האם המדיניות כוללת תניית השבה (תוספת 1א חלק ב פרט 2)` FALSE TRUE)

-- האם מדיניות התגמול קבעה תקופת החזקה או הבשלה מזערית לרכיבים ההוניים?
#ASSERT `האם המדיניות קבעה תקופת החזקה או הבשלה מזערית (תוספת 1א חלק ב פרט 3)` TRUE TRUE
#ASSERT NOT (`האם המדיניות קבעה תקופת החזקה או הבשלה מזערית (תוספת 1א חלק ב פרט 3)` TRUE FALSE)
-- no equity components, nothing to set
#ASSERT `האם המדיניות קבעה תקופת החזקה או הבשלה מזערית (תוספת 1א חלק ב פרט 3)` FALSE FALSE

-- האם מדיניות התגמול קבעה תקרה למענקי הפרישה?
#ASSERT `האם המדיניות קבעה תקרה למענקי הפרישה (תוספת 1א חלק ב פרט 4)` TRUE
#ASSERT NOT (`האם המדיניות קבעה תקרה למענקי הפרישה (תוספת 1א חלק ב פרט 4)` FALSE)

§§ `התוספת השנייה: מטרות ציבוריות`

-- האם המטרה שבה עוסקת החברה שלי היא מטרה ציבורית לפי התוספת השנייה?
-- environment
#ASSERT `האם המטרה היא מטרה ציבורית (התוספת השנייה)` `איכות הסביבה, הגנת הסביבה או הכרת הטבע והסביבה` FALSE
-- health
#ASSERT `האם המטרה היא מטרה ציבורית (התוספת השנייה)` `בריאות או הצלת חיים` FALSE
#ASSERT `האם המטרה היא מטרה ציבורית (התוספת השנייה)` `דת, מורשת או הנצחה` FALSE
#ASSERT `האם המטרה היא מטרה ציבורית (התוספת השנייה)` `הגנה על בעלי חיים ודאגה לרווחתם` FALSE
#ASSERT `האם המטרה היא מטרה ציבורית (התוספת השנייה)` `זכויות אדם` FALSE
#ASSERT `האם המטרה היא מטרה ציבורית (התוספת השנייה)` `חינוך, הכשרה מקצועית, תרבות או אמנות` FALSE
#ASSERT `האם המטרה היא מטרה ציבורית (התוספת השנייה)` `מדע, מחקר או השכלה גבוהה` FALSE
#ASSERT `האם המטרה היא מטרה ציבורית (התוספת השנייה)` `ספורט` FALSE
#ASSERT `האם המטרה היא מטרה ציבורית (התוספת השנייה)` `עליה, קליטה או התיישבות` FALSE
#ASSERT `האם המטרה היא מטרה ציבורית (התוספת השנייה)` `צדקה או סעד` FALSE
#ASSERT `האם המטרה היא מטרה ציבורית (התוספת השנייה)` `רווחת הקהילה או פעילות קהילתית, חברתית או לאומית` FALSE
#ASSERT `האם המטרה היא מטרה ציבורית (התוספת השנייה)` `שלטון החוק, משטר, או מינהל ציבורי` FALSE
-- a fund that supports a body acting for a listed purpose
#ASSERT `האם המטרה היא מטרה ציבורית (התוספת השנייה)` `הקמת קרנות או ארגונים לעידוד או לתמיכה בגוף הפועל לאחת או יותר מהמטרות המנויות בתוספת` TRUE
-- a fund supporting a body that acts for no listed purpose
#ASSERT NOT (`האם המטרה היא מטרה ציבורית (התוספת השנייה)` `הקמת קרנות או ארגונים לעידוד או לתמיכה בגוף הפועל לאחת או יותר מהמטרות המנויות בתוספת` FALSE)
-- a subject not listed
#ASSERT NOT (`האם המטרה היא מטרה ציבורית (התוספת השנייה)` `נושא אחר שאינו מנוי בתוספת` TRUE)

§§ `התוספת השלישית: דרכי השקעה של קרן לתועלת הציבור`

-- האם איגרת חוב שהקרן שלי מחזיקה היא "איגרת חוב סחירה"?
#ASSERT `האם איגרת החוב היא איגרת חוב סחירה (תוספת 3 פרט 1)` TRUE TRUE
#ASSERT NOT (`האם איגרת החוב היא איגרת חוב סחירה (תוספת 3 פרט 1)` TRUE FALSE)
#ASSERT NOT (`האם איגרת החוב היא איגרת חוב סחירה (תוספת 3 פרט 1)` FALSE TRUE)

-- האם דירוג החוב שיש לי נחשב "דירוג" לפי התוספת השלישית?
#ASSERT `האם דירוג החוב נחשב דירוג (תוספת 3 פרט 1)` TRUE TRUE
#ASSERT NOT (`האם דירוג החוב נחשב דירוג (תוספת 3 פרט 1)` TRUE FALSE)
#ASSERT NOT (`האם דירוג החוב נחשב דירוג (תוספת 3 פרט 1)` FALSE TRUE)

-- האם תקופת ההשקעה היא חלק מדרך ההשקעה?
#ASSERT `האם תקופת ההשקעה היא חלק מדרך ההשקעה (תוספת 3 פרט 1)` TRUE
#ASSERT NOT (`האם תקופת ההשקעה היא חלק מדרך ההשקעה (תוספת 3 פרט 1)` FALSE)

-- האם גוף נחשב "מנפיק" לעניין ההשקעות של הקרן שלי?
#ASSERT `האם הגוף נחשב מנפיק (תוספת 3 פרט 1)` TRUE FALSE
-- the State is not an issuer
#ASSERT NOT (`האם הגוף נחשב מנפיק (תוספת 3 פרט 1)` TRUE TRUE)
#ASSERT NOT (`האם הגוף נחשב מנפיק (תוספת 3 פרט 1)` FALSE FALSE)

-- האם דרך ההשקעה שהקרן שלי בוחרת היא דרך מותרת?
-- State bonds
#ASSERT `האם דרך ההשקעה מותרת (תוספת 3 פרט 2(א))` `איגרות חוב שהנפיקה המדינה או שהיא ערבה לפרעונן` FALSE FALSE FALSE
#ASSERT `האם דרך ההשקעה מותרת (תוספת 3 פרט 2(א))` `פיקדונות בנקאיים בשקלים חדשים צמודי מדד ונושאי ריבית או נושאי ריבית בלבד` FALSE FALSE FALSE
#ASSERT `האם דרך ההשקעה מותרת (תוספת 3 פרט 2(א))` `תכניות חיסכון בנקאיות בשקלים חדשים צמודות מדד ונושאות ריבית` FALSE FALSE FALSE
#ASSERT `האם דרך ההשקעה מותרת (תוספת 3 פרט 2(א))` `פיקדונות בנקאיים הנקובים במטבע חוץ או הצמודים למטבע חוץ` FALSE FALSE FALSE
#ASSERT `האם דרך ההשקעה מותרת (תוספת 3 פרט 2(א))` `תכניות חיסכון בנקאיות צמודות מטבע חוץ` FALSE FALSE FALSE
-- marketable, non-convertible, rated
#ASSERT `האם דרך ההשקעה מותרת (תוספת 3 פרט 2(א))` `איגרות חוב סחירות שאינן להמרה, אם ההשקעה מדורגת בדירוג A- או A-2 לפחות` TRUE TRUE FALSE
-- not rated high enough
#ASSERT NOT (`האם דרך ההשקעה מותרת (תוספת 3 פרט 2(א))` `איגרות חוב סחירות שאינן להמרה, אם ההשקעה מדורגת בדירוג A- או A-2 לפחות` TRUE FALSE FALSE)
-- convertible or not marketable
#ASSERT NOT (`האם דרך ההשקעה מותרת (תוספת 3 פרט 2(א))` `איגרות חוב סחירות שאינן להמרה, אם ההשקעה מדורגת בדירוג A- או A-2 לפחות` FALSE TRUE FALSE)
-- a trust fund invested only in permitted ways
#ASSERT `האם דרך ההשקעה מותרת (תוספת 3 פרט 2(א))` `קרנות נאמנות שכל נכסיהן מושקעים באחת או יותר מן הדרכים המפורטות בפסקאות (1), (2), (4) או (6)` FALSE FALSE TRUE
#ASSERT NOT (`האם דרך ההשקעה מותרת (תוספת 3 פרט 2(א))` `קרנות נאמנות שכל נכסיהן מושקעים באחת או יותר מן הדרכים המפורטות בפסקאות (1), (2), (4) או (6)` FALSE FALSE FALSE)
-- any other way: not permitted without approval
#ASSERT NOT (`האם דרך ההשקעה מותרת (תוספת 3 פרט 2(א))` `דרך השקעה אחרת` TRUE TRUE TRUE)

-- האם ההשקעה בניירות ערך של מנפיק אחד אינה עולה על 20% מהכספים העודפים?
-- exactly 20%
#ASSERT `האם ההשקעה בניירות ערך של מנפיק אחד אינה עולה על 20 אחוזים (תוספת 3 פרט 2(ב))` 200000 1000000
-- just above 20%
#ASSERT NOT (`האם ההשקעה בניירות ערך של מנפיק אחד אינה עולה על 20 אחוזים (תוספת 3 פרט 2(ב))` 200001 1000000)
#ASSERT `האם ההשקעה בניירות ערך של מנפיק אחד אינה עולה על 20 אחוזים (תוספת 3 פרט 2(ב))` 0 1000000

-- מהו השיעור המרבי שמותר להשקיע בתאגיד אחד, לפי גודל הכספים העודפים?
#ASSERT `מהו השיעור המרבי להשקעה בתאגיד אחד (תוספת 3 פרט 2(ב))` 20000000 EQUALS (JUST 0.25)
-- just above 10 million
#ASSERT `מהו השיעור המרבי להשקעה בתאגיד אחד (תוספת 3 פרט 2(ב))` 10000001 EQUALS (JUST 0.25)
-- exactly 10 million is not above
#ASSERT `מהו השיעור המרבי להשקעה בתאגיד אחד (תוספת 3 פרט 2(ב))` 10000000 EQUALS (JUST 0.5)
#ASSERT `מהו השיעור המרבי להשקעה בתאגיד אחד (תוספת 3 פרט 2(ב))` 5000000 EQUALS (JUST 0.5)
-- just above 1 million
#ASSERT `מהו השיעור המרבי להשקעה בתאגיד אחד (תוספת 3 פרט 2(ב))` 1000001 EQUALS (JUST 0.5)
-- exactly 1 million: no cap stated
#ASSERT `מהו השיעור המרבי להשקעה בתאגיד אחד (תוספת 3 פרט 2(ב))` 1000000 EQUALS (NOTHING)
#ASSERT `מהו השיעור המרבי להשקעה בתאגיד אחד (תוספת 3 פרט 2(ב))` 500000 EQUALS (NOTHING)

-- האם ההשקעה בתאגיד אחד מותרת, לפי גודל הכספים העודפים?
-- a quarter of 20 million
#ASSERT `האם ההשקעה בתאגיד אחד מותרת (תוספת 3 פרט 2(ב))` 5000000 20000000
-- just above a quarter
#ASSERT NOT (`האם ההשקעה בתאגיד אחד מותרת (תוספת 3 פרט 2(ב))` 5000001 20000000)
-- half of 6 million
#ASSERT `האם ההשקעה בתאגיד אחד מותרת (תוספת 3 פרט 2(ב))` 3000000 6000000
#ASSERT NOT (`האם ההשקעה בתאגיד אחד מותרת (תוספת 3 פרט 2(ב))` 3000001 6000000)
-- no cap stated for 1 million or less
#ASSERT `האם ההשקעה בתאגיד אחד מותרת (תוספת 3 פרט 2(ב))` 900000 1000000

-- האם ועדת ההשקעות של הקרן שלי רשאית להשקיע בתאגיד מסוים?
#ASSERT `האם ועדת ההשקעות רשאית להשקיע בתאגיד (תוספת 3 פרט 2(ג))` TRUE TRUE TRUE FALSE FALSE
-- no investment committee
#ASSERT NOT (`האם ועדת ההשקעות רשאית להשקיע בתאגיד (תוספת 3 פרט 2(ג))` FALSE TRUE TRUE FALSE FALSE)
-- not chosen by the committee
#ASSERT NOT (`האם ועדת ההשקעות רשאית להשקיע בתאגיד (תוספת 3 פרט 2(ג))` TRUE FALSE TRUE FALSE FALSE)
-- a way the committee may not use
#ASSERT NOT (`האם ועדת ההשקעות רשאית להשקיע בתאגיד (תוספת 3 פרט 2(ג))` TRUE TRUE FALSE FALSE FALSE)
-- a fund insider is a controller or interested party in the corporation
#ASSERT NOT (`האם ועדת ההשקעות רשאית להשקיע בתאגיד (תוספת 3 פרט 2(ג))` TRUE TRUE TRUE TRUE FALSE)
-- the fund and the person together are controllers or interested parties
#ASSERT NOT (`האם ועדת ההשקעות רשאית להשקיע בתאגיד (תוספת 3 פרט 2(ג))` TRUE TRUE TRUE FALSE TRUE)

-- האם הבקשה לאשר מראש דרך השקעה אחרת עומדת בדרישות?
#ASSERT `האם הבקשה לאישור דרך השקעה אחרת עומדת בדרישות (תוספת 3 פרט 2(ד))` TRUE TRUE TRUE TRUE TRUE TRUE TRUE
-- not in writing
#ASSERT NOT (`האם הבקשה לאישור דרך השקעה אחרת עומדת בדרישות (תוספת 3 פרט 2(ד))` FALSE TRUE TRUE TRUE TRUE TRUE TRUE)
-- no reasons given
#ASSERT NOT (`האם הבקשה לאישור דרך השקעה אחרת עומדת בדרישות (תוספת 3 פרט 2(ד))` TRUE TRUE TRUE TRUE TRUE FALSE TRUE)
-- further information missing
#ASSERT NOT (`האם הבקשה לאישור דרך השקעה אחרת עומדת בדרישות (תוספת 3 פרט 2(ד))` TRUE TRUE TRUE TRUE TRUE TRUE FALSE)

-- האם רשם ההקדשות רשאי לאשר מראש לקרן שלי דרך השקעה אחרת?
#ASSERT `האם רשם ההקדשות רשאי לאשר מראש דרך השקעה אחרת (תוספת 3 פרט 2(ד))` TRUE TRUE
#ASSERT NOT (`האם רשם ההקדשות רשאי לאשר מראש דרך השקעה אחרת (תוספת 3 פרט 2(ד))` TRUE FALSE)
#ASSERT NOT (`האם רשם ההקדשות רשאי לאשר מראש דרך השקעה אחרת (תוספת 3 פרט 2(ד))` FALSE TRUE)

-- האם דרך ההשקעה של הקרן שלי נבחרה כנדרש?
#ASSERT `האם דרך ההשקעה נבחרה כנדרש (תוספת 3 פרט 2(ה))` TRUE TRUE
#ASSERT NOT (`האם דרך ההשקעה נבחרה כנדרש (תוספת 3 פרט 2(ה))` TRUE FALSE)
#ASSERT NOT (`האם דרך ההשקעה נבחרה כנדרש (תוספת 3 פרט 2(ה))` FALSE TRUE)

-- האם על דירקטוריון הקרן שלי למנות ועדת השקעות?
-- above 30 million
#ASSERT `האם על דירקטוריון הקרן למנות ועדת השקעות (תוספת 3 פרט 3)` 30000001 FALSE
-- exactly 30 million is not above
#ASSERT NOT (`האם על דירקטוריון הקרן למנות ועדת השקעות (תוספת 3 פרט 3)` 30000000 FALSE)
-- the articles require it
#ASSERT `האם על דירקטוריון הקרן למנות ועדת השקעות (תוספת 3 פרט 3)` 1000000 TRUE
#ASSERT NOT (`האם על דירקטוריון הקרן למנות ועדת השקעות (תוספת 3 פרט 3)` 1000000 FALSE)

-- האם אני נפסל מלכהן בוועדת ההשקעות של הקרן?
-- not qualified
#ASSERT `האם האדם נפסל מלכהן בוועדת ההשקעות (תוספת 3 פרט 4(א)(1))` TRUE TRUE
-- the tie is too old
#ASSERT NOT (`האם האדם נפסל מלכהן בוועדת ההשקעות (תוספת 3 פרט 4(א)(1))` TRUE FALSE)
-- no tie
#ASSERT NOT (`האם האדם נפסל מלכהן בוועדת ההשקעות (תוספת 3 פרט 4(א)(1))` FALSE TRUE)

-- האם דירקטור בלתי תלוי יכול להיות חבר בוועדת ההשקעות?
-- paragraph (1) holds for 3 of 5 members: a majority
#ASSERT `האם דירקטור בלתי תלוי יכול להיות חבר בוועדת ההשקעות (תוספת 3 פרט 4(א)(2))` 5 3
-- exactly half is not a majority
#ASSERT NOT (`האם דירקטור בלתי תלוי יכול להיות חבר בוועדת ההשקעות (תוספת 3 פרט 4(א)(2))` 4 2)
-- only 2 of 5
#ASSERT NOT (`האם דירקטור בלתי תלוי יכול להיות חבר בוועדת ההשקעות (תוספת 3 פרט 4(א)(2))` 5 2)

-- האם חבר ועדת ההשקעות חב חובת זהירות וחובת אמונים וזכאי למידע וליועצים?
#ASSERT `האם חבר הוועדה חב חובת זהירות וחובת אמונים וזכאי למידע וליועצים (תוספת 3 פרט 5)` TRUE
#ASSERT NOT (`האם חבר הוועדה חב חובת זהירות וחובת אמונים וזכאי למידע וליועצים (תוספת 3 פרט 5)` FALSE)

-- האם ועדת ההשקעות התכנסה בתכיפות הנדרשת?
#ASSERT `האם הוועדה התכנסה בתכיפות הנדרשת (תוספת 3 פרט 6)` 4 4 FALSE
-- a quarter missed
#ASSERT NOT (`האם הוועדה התכנסה בתכיפות הנדרשת (תוספת 3 פרט 6)` 3 5 FALSE)
-- twice a year, approved by the board
#ASSERT `האם הוועדה התכנסה בתכיפות הנדרשת (תוספת 3 פרט 6)` 2 2 TRUE
-- once a year is not enough even if approved
#ASSERT NOT (`האם הוועדה התכנסה בתכיפות הנדרשת (תוספת 3 פרט 6)` 2 1 TRUE)

-- האם ועדת ההשקעות עמדה בחובות הנהלים והדיווח?
#ASSERT `האם הוועדה עמדה בחובות הנהלים והדיווח (תוספת 3 פרט 6)` TRUE TRUE TRUE
#ASSERT NOT (`האם הוועדה עמדה בחובות הנהלים והדיווח (תוספת 3 פרט 6)` FALSE TRUE TRUE)
#ASSERT NOT (`האם הוועדה עמדה בחובות הנהלים והדיווח (תוספת 3 פרט 6)` TRUE FALSE TRUE)
#ASSERT NOT (`האם הוועדה עמדה בחובות הנהלים והדיווח (תוספת 3 פרט 6)` TRUE TRUE FALSE)

-- האם ההחלטה בוועדת ההשקעות התקבלה ברוב קולות החברים הנוכחים?
#ASSERT `האם ההחלטה התקבלה ברוב קולות החברים הנוכחים (תוספת 3 פרט 6)` 5 3
-- exactly half is not a majority
#ASSERT NOT (`האם ההחלטה התקבלה ברוב קולות החברים הנוכחים (תוספת 3 פרט 6)` 4 2)
#ASSERT `האם ההחלטה התקבלה ברוב קולות החברים הנוכחים (תוספת 3 פרט 6)` 4 3

-- האם דמי הניהול, ההוצאות והשכר שהקרן שילמה אינם עולים על חצי אחוז מהכספים העודפים?
-- exactly 0.5%
#ASSERT `האם דמי הניהול, ההוצאות והשכר אינם עולים על חצי אחוז (תוספת 3 פרט 7)` 50000 10000000
-- just above 0.5%
#ASSERT NOT (`האם דמי הניהול, ההוצאות והשכר אינם עולים על חצי אחוז (תוספת 3 פרט 7)` 50001 10000000)
#ASSERT `האם דמי הניהול, ההוצאות והשכר אינם עולים על חצי אחוז (תוספת 3 פרט 7)` 0 10000000

§§ `התוספת הרביעית: מען דיגיטלי`

-- האם המען הדיגיטלי שמסרתי מלא לפי התוספת הרביעית?
-- an e-mail address and a mobile number
#ASSERT `האם המען הדיגיטלי מלא (התוספת הרביעית)` "a@x.com" "0501234567" ""
-- two different e-mail addresses
#ASSERT `האם המען הדיגיטלי מלא (התוספת הרביעית)` "a@x.com" "" "b@x.com"
-- the second e-mail address is the same as the first
#ASSERT NOT (`האם המען הדיגיטלי מלא (התוספת הרביעית)` "a@x.com" "" "a@x.com")
-- only one e-mail address
#ASSERT NOT (`האם המען הדיגיטלי מלא (התוספת הרביעית)` "a@x.com" "" "")
-- no e-mail address
#ASSERT NOT (`האם המען הדיגיטלי מלא (התוספת הרביעית)` "" "0501234567" "")

