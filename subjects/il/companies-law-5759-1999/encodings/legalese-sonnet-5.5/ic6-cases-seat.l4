#ASSERT `האם הנכסים שהועברו משוחררים משעבוד (סעיף 351(ב))` TRUE TRUE TRUE
-- the order did not direct the release
#ASSERT NOT (`האם הנכסים שהועברו משוחררים משעבוד (סעיף 351(ב))` TRUE FALSE TRUE)
-- the charge has not lapsed
#ASSERT NOT (`האם הנכסים שהועברו משוחררים משעבוד (סעיף 351(ב))` TRUE TRUE FALSE)

-- האם החיובים שהצו מעביר עוברים לחברה הנעברת ונעשים לחיוביה?
#ASSERT `האם החיובים שהצו מעביר עוברים לחברה הנעברת (סעיף 351(ב))` TRUE
#ASSERT NOT (`האם החיובים שהצו מעביר עוברים לחברה הנעברת (סעיף 351(ב))` FALSE)

-- האם החברה שלי הפרה את החובה למסור לרשם העתק מאושר של הצו תוך 7 ימים?
-- given on day 7
#ASSERT NOT (`האם החברה שלי הפרה את חובת מסירת העתק הצו לרשם (סעיף 351(ג))` (YearMonthDay 2026 5 1) TRUE (YearMonthDay 2026 5 8) (YearMonthDay 2026 6 1))
-- given on day 8
#ASSERT `האם החברה שלי הפרה את חובת מסירת העתק הצו לרשם (סעיף 351(ג))` (YearMonthDay 2026 5 1) TRUE (YearMonthDay 2026 5 9) (YearMonthDay 2026 6 1)
-- not yet given but day 7 is not over
#ASSERT NOT (`האם החברה שלי הפרה את חובת מסירת העתק הצו לרשם (סעיף 351(ג))` (YearMonthDay 2026 5 1) FALSE (YearMonthDay 2026 5 1) (YearMonthDay 2026 5 8))
-- still not given on day 8
#ASSERT `האם החברה שלי הפרה את חובת מסירת העתק הצו לרשם (סעיף 351(ג))` (YearMonthDay 2026 5 1) FALSE (YearMonthDay 2026 5 1) (YearMonthDay 2026 5 9)

-- כמה ימים נמשכה ההפרה של חובת מסירת העתק הצו לרשם?
-- given in time
#ASSERT `כמה ימים נמשכה הפרת חובת מסירת העתק הצו לרשם (סעיף 351(ג))` (YearMonthDay 2026 5 1) TRUE (YearMonthDay 2026 5 8) (YearMonthDay 2026 6 1) EQUALS 0
-- given four days after day 7
#ASSERT `כמה ימים נמשכה הפרת חובת מסירת העתק הצו לרשם (סעיף 351(ג))` (YearMonthDay 2026 5 1) TRUE (YearMonthDay 2026 5 12) (YearMonthDay 2026 6 1) EQUALS 4
-- not yet given, ten days after day 7
#ASSERT `כמה ימים נמשכה הפרת חובת מסירת העתק הצו לרשם (סעיף 351(ג))` (YearMonthDay 2026 5 1) FALSE (YearMonthDay 2026 5 1) (YearMonthDay 2026 5 18) EQUALS 10

-- האם אני, כנושא משרה שאישר או התיר את ההפרה, חב בקנס על אי מסירת העתק הצו לרשם?
#ASSERT `האם אני חב בקנס כנושא משרה שאישר או התיר את ההפרה (סעיף 351(ג))` TRUE TRUE TRUE
-- did not approve or allow it
#ASSERT NOT (`האם אני חב בקנס כנושא משרה שאישר או התיר את ההפרה (סעיף 351(ג))` TRUE TRUE FALSE)
-- not an officer
#ASSERT NOT (`האם אני חב בקנס כנושא משרה שאישר או התיר את ההפרה (סעיף 351(ג))` TRUE FALSE TRUE)
-- the company did not breach
#ASSERT NOT (`האם אני חב בקנס כנושא משרה שאישר או התיר את ההפרה (סעיף 351(ג))` FALSE TRUE TRUE)

-- האם הוראות פרק הפשרה וההסדר חלות על התאגיד שלי?
-- a foreign company doing business in Israel
#ASSERT `האם הוראות פרק הפשרה וההסדר חלות על התאגיד שלי (סעיף 351א)` TRUE TRUE FALSE FALSE
-- a foreign company with no business or assets here and no order
#ASSERT NOT (`האם הוראות פרק הפשרה וההסדר חלות על התאגיד שלי (סעיף 351א)` TRUE FALSE FALSE FALSE)
-- the Minister applied the chapter by order
#ASSERT `האם הוראות פרק הפשרה וההסדר חלות על התאגיד שלי (סעיף 351א)` TRUE FALSE FALSE TRUE
-- an Israeli company, no order
#ASSERT NOT (`האם הוראות פרק הפשרה וההסדר חלות על התאגיד שלי (סעיף 351א)` FALSE FALSE FALSE FALSE)

§§ `מחיקת חברה (סעיפים 351ב עד 351ח)`

-- האם פרק מחיקת חברות חל על החברה שלי?
-- a private company with no bonds
#ASSERT `האם פרק מחיקת חברות חל על החברה שלי (סעיף 351ב)` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE
-- a public company: listed and held by the public
#ASSERT NOT (`האם פרק מחיקת חברות חל על החברה שלי (סעיף 351ב)` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE)
-- a bond company: bonds listed and held by the public
#ASSERT NOT (`האם פרק מחיקת חברות חל על החברה שלי (סעיף 351ב)` FALSE FALSE FALSE FALSE TRUE FALSE FALSE TRUE)
-- listed, but not held by the public, so still private
#ASSERT `האם פרק מחיקת חברות חל על החברה שלי (סעיף 351ב)` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE

-- האם חוב של החברה שלי נחשב חוב לעניין מחיקתה?
-- an ordinary debt
#ASSERT `האם חוב של החברה שלי נחשב חוב לעניין מחיקתה (סעיף 351ב)` FALSE FALSE
-- a section 44(6) fee debt does not count
#ASSERT NOT (`האם חוב של החברה שלי נחשב חוב לעניין מחיקתה (סעיף 351ב)` TRUE FALSE)
-- the Registrar found the debts negligible
#ASSERT NOT (`האם חוב של החברה שלי נחשב חוב לעניין מחיקתה (סעיף 351ב)` FALSE TRUE)

-- האם נכס של החברה שלי נחשב נכס לעניין מחיקתה?
#ASSERT `האם נכס של החברה שלי נחשב נכס לעניין מחיקתה (סעיף 351ב)` FALSE
#ASSERT NOT (`האם נכס של החברה שלי נחשב נכס לעניין מחיקתה (סעיף 351ב)` TRUE)

-- האם מה שהגשתי לרשם נחשב "התנגדות" לעניין מחיקת החברה?
#ASSERT `האם מה שהגשתי נחשב התנגדות לעניין מחיקת החברה (סעיף 351ב)` TRUE
#ASSERT NOT (`האם מה שהגשתי נחשב התנגדות לעניין מחיקת החברה (סעיף 351ב)` FALSE)

-- האם התקיימו התנאים למחיקת החברה שלי?
-- a private company that meets all five grounds
#ASSERT `האם התקיימו התנאים למחיקת החברה שלי (סעיף 351ג)` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE TRUE TRUE TRUE TRUE FALSE FALSE
-- the company still has debts
#ASSERT NOT (`האם התקיימו התנאים למחיקת החברה שלי (סעיף 351ג)` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE TRUE TRUE TRUE TRUE TRUE FALSE FALSE)
-- the tax file is closed, which is enough for ground (5)
#ASSERT `האם התקיימו התנאים למחיקת החברה שלי (סעיף 351ג)` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE TRUE TRUE TRUE FALSE TRUE FALSE
-- the company still carries on business
#ASSERT NOT (`האם התקיימו התנאים למחיקת החברה שלי (סעיף 351ג)` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE TRUE TRUE FALSE FALSE)
-- a public company: this chapter does not apply
#ASSERT NOT (`האם התקיימו התנאים למחיקת החברה שלי (סעיף 351ג)` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE TRUE TRUE TRUE TRUE FALSE FALSE)
-- a public-benefit company: no year as a defaulting company needed, but the Registrar of Endowments agreed
#ASSERT `האם התקיימו התנאים למחיקת החברה שלי (סעיף 351ג)` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE FALSE FALSE FALSE TRUE TRUE TRUE FALSE TRUE
-- a public-benefit company without the Registrar of Endowments' consent
#ASSERT NOT (`האם התקיימו התנאים למחיקת החברה שלי (סעיף 351ג)` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE FALSE FALSE FALSE TRUE TRUE TRUE FALSE FALSE)

-- האם חלפה שנה מהיום שבו נרשמה החברה שלי כחברה מפרה?
-- the anniversary
#ASSERT `האם חלפה שנה מהיום שבו נרשמה החברה שלי כחברה מפרה (סעיף 351ג(א)(3))` (YearMonthDay 2025 3 1) (YearMonthDay 2026 3 1)
-- a day short
#ASSERT NOT (`האם חלפה שנה מהיום שבו נרשמה החברה שלי כחברה מפרה (סעיף 351ג(א)(3))` (YearMonthDay 2025 3 1) (YearMonthDay 2026 2 28))

-- האם החלטת הרשם שחובות או נכסים נמוכי ערך מבוססת על אמות מידה שפורסמו?
#ASSERT `האם ההחלטה שחובות או נכסים נמוכי ערך מבוססת על אמות מידה שפורסמו (סעיף 351ג(ג))` TRUE TRUE
-- no published criteria
#ASSERT NOT (`האם ההחלטה שחובות או נכסים נמוכי ערך מבוססת על אמות מידה שפורסמו (סעיף 351ג(ג))` FALSE TRUE)
-- no such finding
#ASSERT NOT (`האם ההחלטה שחובות או נכסים נמוכי ערך מבוססת על אמות מידה שפורסמו (סעיף 351ג(ג))` TRUE FALSE)

-- האם הרשם רשאי לדרוש ממוסד מסוים מידע על החברה שלי לפני שהוא מוחק אותה?
-- a bank
#ASSERT `האם הרשם רשאי לדרוש מידע על החברה שלי מגוף מסוים (סעיף 351ד(א))` TRUE FALSE FALSE TRUE TRUE TRUE TRUE FALSE `תאגיד בנקאי כהגדרתו בחוק הבנקאות (רישוי)` EQUALS (JUST TRUE)
-- a public body
#ASSERT `האם הרשם רשאי לדרוש מידע על החברה שלי מגוף מסוים (סעיף 351ד(א))` TRUE FALSE FALSE TRUE TRUE TRUE TRUE FALSE `גוף ציבורי כהגדרתו בסעיף 23 לחוק הגנת הפרטיות, ובכלל זה רשות המסים, רשם המקרקעין, רשות מקרקעי ישראל, רשות האכיפה והגבייה והמוסד לביטוח לאומי` EQUALS (JUST TRUE)
-- any other body: outside the section
#ASSERT `האם הרשם רשאי לדרוש מידע על החברה שלי מגוף מסוים (סעיף 351ד(א))` TRUE FALSE FALSE TRUE TRUE TRUE TRUE FALSE `גוף אחר` EQUALS (NOTHING)
-- no year as a defaulting company yet
#ASSERT `האם הרשם רשאי לדרוש מידע על החברה שלי מגוף מסוים (סעיף 351ד(א))` TRUE FALSE FALSE FALSE TRUE TRUE TRUE FALSE `תאגיד בנקאי כהגדרתו בחוק הבנקאות (רישוי)` EQUALS (JUST FALSE)

-- האם הרשם רשאי לפרסם הודעה על כוונה למחוק את החברה שלי?
#ASSERT `האם הרשם רשאי לפרסם הודעה על כוונה למחוק את החברה שלי (סעיף 351ה(א))` TRUE FALSE FALSE TRUE TRUE TRUE TRUE FALSE TRUE
-- no reasonable basis for grounds (1) and (2)
#ASSERT NOT (`האם הרשם רשאי לפרסם הודעה על כוונה למחוק את החברה שלי (סעיף 351ה(א))` TRUE FALSE FALSE TRUE TRUE TRUE TRUE FALSE FALSE)
-- not yet a year as a defaulting company
#ASSERT NOT (`האם הרשם רשאי לפרסם הודעה על כוונה למחוק את החברה שלי (סעיף 351ה(א))` TRUE FALSE FALSE FALSE TRUE TRUE TRUE FALSE TRUE)

-- האם ההודעה שפורסמה על הכוונה למחוק את החברה שלי עומדת בדרישות?
#ASSERT `האם ההודעה על הכוונה למחוק את החברה שלי עומדת בדרישות (סעיף 351ה(א))` TRUE TRUE TRUE
-- the company was not sent a notice
#ASSERT NOT (`האם ההודעה על הכוונה למחוק את החברה שלי עומדת בדרישות (סעיף 351ה(א))` TRUE TRUE FALSE)
-- not published on the website
#ASSERT NOT (`האם ההודעה על הכוונה למחוק את החברה שלי עומדת בדרישות (סעיף 351ה(א))` FALSE TRUE TRUE)

-- האם אני רשאי להתנגד למחיקת החברה, והאם התנגדותי הוגשה במועד?
-- day 90
#ASSERT `האם התנגדותי למחיקת החברה הוגשה במועד על ידי מי שרשאי להגישה (סעיף 351ה(ב))` TRUE (YearMonthDay 2026 1 1) (YearMonthDay 2026 4 1)
-- day 91
#ASSERT NOT (`האם התנגדותי למחיקת החברה הוגשה במועד על ידי מי שרשאי להגישה (סעיף 351ה(ב))` TRUE (YearMonthDay 2026 1 1) (YearMonthDay 2026 4 2))
-- not a person who may be harmed
#ASSERT NOT (`האם התנגדותי למחיקת החברה הוגשה במועד על ידי מי שרשאי להגישה (סעיף 351ה(ב))` FALSE (YearMonthDay 2026 1 1) (YearMonthDay 2026 1 5))

-- האם ההתנגדות שלי עומדת בדרישות הצורה והתוכן?
#ASSERT `האם ההתנגדות שלי עומדת בדרישות הצורה והתוכן (סעיף 351ה(ג))` TRUE TRUE TRUE TRUE TRUE TRUE
-- no connection, so none to state
#ASSERT `האם ההתנגדות שלי עומדת בדרישות הצורה והתוכן (סעיף 351ה(ג))` TRUE TRUE TRUE FALSE FALSE TRUE
-- a connection that is not stated
#ASSERT NOT (`האם ההתנגדות שלי עומדת בדרישות הצורה והתוכן (סעיף 351ה(ג))` TRUE TRUE TRUE TRUE FALSE TRUE)
-- no reasons given
#ASSERT NOT (`האם ההתנגדות שלי עומדת בדרישות הצורה והתוכן (סעיף 351ה(ג))` TRUE TRUE TRUE TRUE TRUE FALSE)
-- filed in a way the Registrar did not allow
#ASSERT NOT (`האם ההתנגדות שלי עומדת בדרישות הצורה והתוכן (סעיף 351ה(ג))` FALSE TRUE TRUE TRUE TRUE TRUE)

