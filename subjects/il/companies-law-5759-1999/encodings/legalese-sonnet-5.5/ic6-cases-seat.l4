§§ `סעדים: הפרת זכות לפי החוק, הפרת חובות מרשמים ודיווח, וערובה להוצאות (סעיפים 352 עד 353א)`

-- האם יש לי, כבעל מניות, סעד כמו בהפרת חוזה על הפרת זכות שהחוק נתן לי?
-- the company breached it
#ASSERT `האם יש לי כבעל מניות סעד כמו בהפרת חוזה על הפרת זכות שנתן לי החוק (סעיף 352(א))` TRUE TRUE TRUE
-- another shareholder breached it
#ASSERT `האם יש לי כבעל מניות סעד כמו בהפרת חוזה על הפרת זכות שנתן לי החוק (סעיף 352(א))` TRUE TRUE FALSE
-- the right does not come from this Law
#ASSERT NOT (`האם יש לי כבעל מניות סעד כמו בהפרת חוזה על הפרת זכות שנתן לי החוק (סעיף 352(א))` FALSE TRUE TRUE)
-- no breach
#ASSERT NOT (`האם יש לי כבעל מניות סעד כמו בהפרת חוזה על הפרת זכות שנתן לי החוק (סעיף 352(א))` TRUE FALSE TRUE)

-- האם החברה יכולה לתבוע ממני, כבעל מניות, כמו בהפרת חוזה, על הפרת זכות שהחוק נתן לה כלפי?
#ASSERT `האם החברה יכולה לתבוע ממני כבעל מניות כמו בהפרת חוזה על הפרת זכות שהחוק נתן לה (סעיף 352(א))` TRUE TRUE
#ASSERT NOT (`האם החברה יכולה לתבוע ממני כבעל מניות כמו בהפרת חוזה על הפרת זכות שהחוק נתן לה (סעיף 352(א))` TRUE FALSE)
#ASSERT NOT (`האם החברה יכולה לתבוע ממני כבעל מניות כמו בהפרת חוזה על הפרת זכות שהחוק נתן לה (סעיף 352(א))` FALSE TRUE)

-- האם זכותי כבעל מניה לפי כל דין אחר נשמרת?
#ASSERT `האם זכותי כבעל מניה לפי כל דין אחר נשמרת (סעיף 352(ב))` TRUE
#ASSERT NOT (`האם זכותי כבעל מניה לפי כל דין אחר נשמרת (סעיף 352(ב))` FALSE)

-- האם הפרת חובה לקיים מרשמים או לדווח לרשם היא הפרת חובה חקוקה כלפי?
#ASSERT `האם הפרת חובת המרשמים והדיווחים היא הפרת חובה חקוקה כלפי (סעיף 353)` TRUE TRUE TRUE
-- I did not rely on the registers
#ASSERT NOT (`האם הפרת חובת המרשמים והדיווחים היא הפרת חובה חקוקה כלפי (סעיף 353)` TRUE TRUE FALSE)
-- a duty from another source
#ASSERT NOT (`האם הפרת חובת המרשמים והדיווחים היא הפרת חובה חקוקה כלפי (סעיף 353)` TRUE FALSE TRUE)
-- no breach
#ASSERT NOT (`האם הפרת חובת המרשמים והדיווחים היא הפרת חובה חקוקה כלפי (סעיף 353)` FALSE TRUE TRUE)

-- האם אני, כנתבע בידי חברה, רשאי לדרוש ערובה להוצאות המשפט שלי?
#ASSERT `האם בית המשפט רשאי לחייב את החברה התובעת בערובה להוצאותיי (סעיף 353א)` TRUE TRUE FALSE FALSE
-- the court sees no justification
#ASSERT NOT (`האם בית המשפט רשאי לחייב את החברה התובעת בערובה להוצאותיי (סעיף 353א)` TRUE TRUE TRUE FALSE)
-- the plaintiff proved it can pay
#ASSERT NOT (`האם בית המשפט רשאי לחייב את החברה התובעת בערובה להוצאותיי (סעיף 353א)` TRUE TRUE FALSE TRUE)
-- I did not ask
#ASSERT NOT (`האם בית המשפט רשאי לחייב את החברה התובעת בערובה להוצאותיי (סעיף 353א)` TRUE FALSE FALSE FALSE)
-- the plaintiff's shareholders have unlimited liability
#ASSERT NOT (`האם בית המשפט רשאי לחייב את החברה התובעת בערובה להוצאותיי (סעיף 353א)` FALSE TRUE FALSE FALSE)

§§ `עיצום כספי בידי הרשם (סעיפים 354 עד 362)`

-- מה היקף העיצום הכספי שהרשם רשאי להטיל על התאגיד שלי בשל הפרה?
-- a private company; breach of a Registrar's direction
#ASSERT `מה היקף העיצום הכספי שהרשם רשאי להטיל על התאגיד שלי (סעיף 354)` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `הפרת הוראת הרשם לפי סעיף 37(ב) או (ג)` TRUE EQUALS (`העיצום הכספי`)
-- no reasonable grounds
#ASSERT `מה היקף העיצום הכספי שהרשם רשאי להטיל על התאגיד שלי (סעיף 354)` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `הפרת הוראת הרשם לפי סעיף 37(ב) או (ג)` FALSE EQUALS (`אין סמכות להטיל עיצום כספי לפי סעיף 354`)
-- a public reporting company is outside group (a)
#ASSERT `מה היקף העיצום הכספי שהרשם רשאי להטיל על התאגיד שלי (סעיף 354)` FALSE TRUE FALSE FALSE TRUE FALSE TRUE FALSE `הפרת הוראת הרשם לפי סעיף 37(ב) או (ג)` TRUE EQUALS (`אין סמכות להטיל עיצום כספי לפי סעיף 354`)
-- a reporting company can be sanctioned for unpaid fees
#ASSERT `מה היקף העיצום הכספי שהרשם רשאי להטיל על התאגיד שלי (סעיף 354)` FALSE TRUE FALSE FALSE TRUE FALSE TRUE FALSE `אי תשלום אגרות או תשלומים אחרים לפי סעיף 44(6)` TRUE EQUALS (`העיצום הכספי`)
-- a foreign company that is not a reporting corporation
#ASSERT `מה היקף העיצום הכספי שהרשם רשאי להטיל על התאגיד שלי (סעיף 354)` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `הפרת חובת הדיווחים לפי סעיף 140` TRUE EQUALS (`העיצום הכספי`)
-- a public-benefit company: group (b1)(1)
#ASSERT `מה היקף העיצום הכספי שהרשם רשאי להטיל על התאגיד שלי (סעיף 354)` FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE `אי הודעה לרשם על החלטה לשנות את התקנון כך שהחברה תהיה חברה לתועלת הציבור` TRUE EQUALS (`העיצום הכספי`)
-- not a public-benefit company: group (b1)(1) is closed
#ASSERT `מה היקף העיצום הכספי שהרשם רשאי להטיל על התאגיד שלי (סעיף 354)` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `אי הודעה לרשם על החלטה לשנות את התקנון כך שהחברה תהיה חברה לתועלת הציבור` TRUE EQUALS (`אין סמכות להטיל עיצום כספי לפי סעיף 354`)
-- a public-benefit company: group (b1)(2) carries double
#ASSERT `מה היקף העיצום הכספי שהרשם רשאי להטיל על התאגיד שלי (סעיף 354)` FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE `אי הצהרה בפני הרשם בעת בקשת הרישום כי היא חברה לתועלת הציבור` TRUE EQUALS (`כפל העיצום הכספי`)
-- an ordinary company holding itself out as public-benefit
#ASSERT `מה היקף העיצום הכספי שהרשם רשאי להטיל על התאגיד שלי (סעיף 354)` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `ציון הסיומת או הצגה כחברה לתועלת הציבור בידי חברה שאינה חברה לתועלת הציבור` TRUE EQUALS (`כפל העיצום הכספי`)
-- a genuine public-benefit company: paragraph (3) does not reach it
#ASSERT `מה היקף העיצום הכספי שהרשם רשאי להטיל על התאגיד שלי (סעיף 354)` FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE `ציון הסיומת או הצגה כחברה לתועלת הציבור בידי חברה שאינה חברה לתועלת הציבור` TRUE EQUALS (`אין סמכות להטיל עיצום כספי לפי סעיף 354`)
-- a foreign public-benefit company that did not register
#ASSERT `מה היקף העיצום הכספי שהרשם רשאי להטיל על התאגיד שלי (סעיף 354)` TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE `אי רישום חברת חוץ לתועלת הציבור כחברת חוץ` TRUE EQUALS (`כפל העיצום הכספי`)
-- not a foreign public-benefit company
#ASSERT `מה היקף העיצום הכספי שהרשם רשאי להטיל על התאגיד שלי (סעיף 354)` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE `אי רישום חברת חוץ לתועלת הציבור כחברת חוץ` TRUE EQUALS (`אין סמכות להטיל עיצום כספי לפי סעיף 354`)

