#ASSERT `סעיף 22(א) - חברה רשאית להגביל את סמכותה לשנות את התקנון` (`בדיקות תקנון - הצבעה` 4 1 0) (JUST (80%)) EQUALS TRUE
#ASSERT `סעיף 22(ב) - החלטה להגביל את סמכות השינוי דינה כדין החלטה לשינוי התקנון` TRUE EQUALS TRUE
#ASSERT `סעיף 22(ב) - החלטה להגביל את סמכות השינוי דינה כדין החלטה לשינוי התקנון` FALSE EQUALS FALSE

