#ASSERT `סעיף 27(ב) - השם אסור לרישום בשל תרמית או הטעיה` FALSE EQUALS FALSE
#ASSERT `סעיף 28 - השם אסור לרישום מפני שעלול לפגוע בתקנת הציבור או ברגשותיו` TRUE FALSE EQUALS TRUE
#ASSERT `סעיף 28 - השם אסור לרישום מפני שעלול לפגוע בתקנת הציבור או ברגשותיו` FALSE TRUE EQUALS TRUE
#ASSERT `סעיף 28 - השם אסור לרישום מפני שעלול לפגוע בתקנת הציבור או ברגשותיו` FALSE FALSE EQUALS FALSE
