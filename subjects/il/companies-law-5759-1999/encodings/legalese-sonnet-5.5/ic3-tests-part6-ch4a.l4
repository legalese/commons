IMPORT prelude
IMPORT `ic-core`
IMPORT `ic3-tests-fixtures`
IMPORT `ic3-part6-ch2-appointment`
IMPORT `ic3-part6-ch4a-compensation-policy`

-- ic3-tests-part6-ch4a: tests of ic3-part6-ch4a-compensation-policy.l4 (sections 267א, 267ב, 267ג), src:1794-1816.
-- Every expected value is written from the text before the code was run, never copied from the code's output.

§ `בדיקות: חלק 6 פרק 4א`

§§ `סעיף 267א(א): החובה לקבוע מדיניות תגמול ותקפותה`

-- A public company and a private bond company must (src:1797).
#ASSERT `סעיף 267א(א) - החברה חייבת בקביעת מדיניות תגמול` `ic3 - חברה ציבורית לדוגמה` FALSE
#ASSERT `סעיף 267א(א) - החברה חייבת בקביעת מדיניות תגמול` `ic3 - חברת איגרות חוב פרטית לדוגמה` FALSE
-- A private company that is not a bond company need not.
#ASSERT NOT (`סעיף 267א(א) - החברה חייבת בקביעת מדיניות תגמול` `ic3 - חברה פרטית רגילה לדוגמה` FALSE)
-- A body that is not a company in the Law's sense is outside the chapter.
#ASSERT NOT (`סעיף 267א(א) - החברה חייבת בקביעת מדיניות תגמול` `ic3 - גוף שאינו חברה לדוגמה` FALSE)
-- A class of companies the Minister exempted under section 267ג: the duty falls away.
#ASSERT NOT (`סעיף 267א(א) - החברה חייבת בקביעת מדיניות תגמול` `ic3 - חברה ציבורית לדוגמה` TRUE)

-- The policy is valid when the board set it after considering the committee's recommendations and the general meeting approved it.
#ASSERT `סעיף 267א(א) - מדיניות התגמול נקבעה כדין` TRUE TRUE
#ASSERT NOT (`סעיף 267א(א) - מדיניות התגמול נקבעה כדין` TRUE FALSE)
#ASSERT NOT (`סעיף 267א(א) - מדיניות התגמול נקבעה כדין` FALSE TRUE)

§§ `סעיף 267א(ב): אישור האסיפה הכללית בחברה ציבורית`

-- The votes of the meeting as a whole, and of the group of shareholders who are not controlling shareholders and have no personal interest.
-- Written in voting rights: for, against, abstaining.
`ic3 - האסיפה כולה, רוב ברור` MEANS `הצבעה` WITH `קולות בעד` IS 60, `קולות נגד` IS 40, `קולות נמנעים` IS 10
`ic3 - האסיפה כולה, שוויון` MEANS `הצבעה` WITH `קולות בעד` IS 50, `קולות נגד` IS 50, `קולות נמנעים` IS 0
`ic3 - הקבוצה, רוב בדוחק` MEANS `הצבעה` WITH `קולות בעד` IS 30, `קולות נגד` IS 29, `קולות נמנעים` IS 0
`ic3 - הקבוצה, שוויון` MEANS `הצבעה` WITH `קולות בעד` IS 29, `קולות נגד` IS 29, `קולות נמנעים` IS 0
`ic3 - הקבוצה, רוב כשהנמנעים רבים` MEANS `הצבעה` WITH `קולות בעד` IS 10, `קולות נגד` IS 9, `קולות נמנעים` IS 100
`ic3 - הקבוצה, מתנגדים בדיוק 2 אחוזים` MEANS `הצבעה` WITH `קולות בעד` IS 100, `קולות נגד` IS 200, `קולות נמנעים` IS 0
`ic3 - הקבוצה, מתנגדים מעל 2 אחוזים` MEANS `הצבעה` WITH `קולות בעד` IS 100, `קולות נגד` IS 201, `קולות נמנעים` IS 0

-- (1): the majority in the meeting includes a majority of the group's votes.
#ASSERT `סעיף 267א(ב)(1) - מבחן רוב הקולות` `ic3 - האסיפה כולה, רוב ברור` `ic3 - הקבוצה, רוב בדוחק`
-- 29 against 29 is not a majority of the group.
#ASSERT NOT (`סעיף 267א(ב)(1) - מבחן רוב הקולות` `ic3 - האסיפה כולה, רוב ברור` `ic3 - הקבוצה, שוויון`)
-- A tie in the meeting as a whole is not a majority.
#ASSERT NOT (`סעיף 267א(ב)(1) - מבחן רוב הקולות` `ic3 - האסיפה כולה, שוויון` `ic3 - הקבוצה, רוב בדוחק`)
-- Abstentions are not counted among the group's votes: 10 for, 9 against, 100 abstaining is a majority of 19 voting.
#ASSERT `סעיף 267א(ב)(1) - מבחן רוב הקולות` `ic3 - האסיפה כולה, רוב ברור` `ic3 - הקבוצה, רוב כשהנמנעים רבים`
-- (2): the votes against among the group are at most 2% of all the voting rights; with 10,000 voting rights, 200 is exactly 2%.
#ASSERT `סעיף 267א(ב)(2) - מבחן המתנגדים` `ic3 - הקבוצה, מתנגדים בדיוק 2 אחוזים` 10_000
#ASSERT NOT (`סעיף 267א(ב)(2) - מבחן המתנגדים` `ic3 - הקבוצה, מתנגדים מעל 2 אחוזים` 10_000)
-- The denominator is all the voting rights in the company, not the votes cast: 201 against passes when the company has 10,050 or more.
#ASSERT `סעיף 267א(ב)(2) - מבחן המתנגדים` `ic3 - הקבוצה, מתנגדים מעל 2 אחוזים` 10_050
#ASSERT NOT (`סעיף 267א(ב)(2) - מבחן המתנגדים` `ic3 - הקבוצה, מתנגדים מעל 2 אחוזים` 10_049)
-- (ב) as a whole: one of the two tests.
#ASSERT `סעיף 267א(ב) - התקיים אחד משני המבחנים` `ic3 - האסיפה כולה, רוב ברור` `ic3 - הקבוצה, רוב בדוחק` 100
-- Test (1) fails (a tie in the group) but test (2) holds: 29 against is under 2% of 10,000? No, 2% of 10,000 is 200, and 29 is under it.
#ASSERT `סעיף 267א(ב) - התקיים אחד משני המבחנים` `ic3 - האסיפה כולה, רוב ברור` `ic3 - הקבוצה, שוויון` 10_000
-- Both fail: a tie in the group, and 29 against exceeds 2% of 1,000 (which is 20).
#ASSERT NOT (`סעיף 267א(ב) - התקיים אחד משני המבחנים` `ic3 - האסיפה כולה, רוב ברור` `ic3 - הקבוצה, שוויון` 1_000)

§§ `סעיף 267א(ג): חברה נכדה ציבורית והתגברות על התנגדות האסיפה הכללית`

-- A public company controlled by a public company, itself controlled by a bond company that a controlling shareholder controls.
#ASSERT `סעיף 267א(ג) - חברה נכדה ציבורית` `ic3 - חברה ציבורית לדוגמה` `ic3 - חברה ציבורית לדוגמה` `ic3 - חברת איגרות חוב פרטית לדוגמה` TRUE TRUE TRUE
-- The grandparent is not controlled by a controlling shareholder: not a grandchild company.
#ASSERT NOT (`סעיף 267א(ג) - חברה נכדה ציבורית` `ic3 - חברה ציבורית לדוגמה` `ic3 - חברה ציבורית לדוגמה` `ic3 - חברת איגרות חוב פרטית לדוגמה` TRUE TRUE FALSE)
-- The company is private: not a public grandchild company.
#ASSERT NOT (`סעיף 267א(ג) - חברה נכדה ציבורית` `ic3 - חברת איגרות חוב פרטית לדוגמה` `ic3 - חברה ציבורית לדוגמה` `ic3 - חברה ציבורית לדוגמה` TRUE TRUE TRUE)
-- The parent is a private company that is not a bond company: not within the definition.
#ASSERT NOT (`סעיף 267א(ג) - חברה נכדה ציבורית` `ic3 - חברה ציבורית לדוגמה` `ic3 - חברה פרטית רגילה לדוגמה` `ic3 - חברה ציבורית לדוגמה` TRUE TRUE TRUE)
-- The company is not controlled by its parent.
#ASSERT NOT (`סעיף 267א(ג) - חברה נכדה ציבורית` `ic3 - חברה ציבורית לדוגמה` `ic3 - חברה ציבורית לדוגמה` `ic3 - חברה ציבורית לדוגמה` FALSE TRUE TRUE)

-- The board may set the policy over the meeting's objection if the committee and board decided on detailed grounds that it is for the company's benefit.
#ASSERT `סעיף 267א(ג) - הדירקטוריון רשאי לקבוע את המדיניות על אף התנגדות האסיפה הכללית` FALSE TRUE TRUE
-- Not in a public grandchild company.
#ASSERT NOT (`סעיף 267א(ג) - הדירקטוריון רשאי לקבוע את המדיניות על אף התנגדות האסיפה הכללית` TRUE TRUE TRUE)
-- Not without detailed grounds after a new discussion.
#ASSERT NOT (`סעיף 267א(ג) - הדירקטוריון רשאי לקבוע את המדיניות על אף התנגדות האסיפה הכללית` FALSE FALSE TRUE)
-- Not unless they decided approval is for the company's benefit.
#ASSERT NOT (`סעיף 267א(ג) - הדירקטוריון רשאי לקבוע את המדיניות על אף התנגדות האסיפה הכללית` FALSE TRUE FALSE)

§§ `סעיף 267א(ד) ו־(ה): תקופה ובחינה מחדש`

-- A policy for exactly three years needs no renewal; more than three does (src:1802).
#ASSERT NOT (`סעיף 267א(ד) - נדרש אישור חוזר אחת לשלוש שנים` 3)
#ASSERT NOT (`סעיף 267א(ד) - נדרש אישור חוזר אחת לשלוש שנים` 2)
#ASSERT `סעיף 267א(ד) - נדרש אישור חוזר אחת לשלוש שנים` 3.5
#ASSERT `סעיף 267א(ד) - נדרש אישור חוזר אחת לשלוש שנים` 5
-- The board must examine the need to adjust the policy when circumstances changed materially, or for other reasons.
#ASSERT `סעיף 267א(ה) - על הדירקטוריון לבחון את הצורך בהתאמת המדיניות לסעיף 267ב` TRUE FALSE
#ASSERT `סעיף 267א(ה) - על הדירקטוריון לבחון את הצורך בהתאמת המדיניות לסעיף 267ב` FALSE TRUE
#ASSERT NOT (`סעיף 267א(ה) - על הדירקטוריון לבחון את הצורך בהתאמת המדיניות לסעיף 267ב` FALSE FALSE)

§§ `סעיף 267ב: שיקולים בקביעת מדיניות התגמול`

-- All four considerations, with variable components and their contribution weighed (src:1807-1810).
#ASSERT `סעיף 267ב(א) - מדיניות התגמול נקבעה לפי השיקולים` TRUE TRUE TRUE TRUE TRUE
-- No variable components: consideration (4) does not bite, so the contribution need not be weighed.
#ASSERT `סעיף 267ב(א) - מדיניות התגמול נקבעה לפי השיקולים` TRUE TRUE TRUE FALSE FALSE
-- Variable components without weighing the contribution: consideration (4) is missed.
#ASSERT NOT (`סעיף 267ב(א) - מדיניות התגמול נקבעה לפי השיקולים` TRUE TRUE TRUE TRUE FALSE)
-- Each of (1) to (3) is required on its own.
#ASSERT NOT (`סעיף 267ב(א) - מדיניות התגמול נקבעה לפי השיקולים` FALSE TRUE TRUE FALSE FALSE)
#ASSERT NOT (`סעיף 267ב(א) - מדיניות התגמול נקבעה לפי השיקולים` TRUE FALSE TRUE FALSE FALSE)
#ASSERT NOT (`סעיף 267ב(א) - מדיניות התגמול נקבעה לפי השיקולים` TRUE TRUE FALSE FALSE FALSE)
-- (ב): the policy refers to Part A of Schedule 1A and sets the provisions of Part B.
#ASSERT `סעיף 267ב(ב) - מדיניות התגמול כוללת את הנדרש בתוספת ראשונה א׳` TRUE TRUE
#ASSERT NOT (`סעיף 267ב(ב) - מדיניות התגמול כוללת את הנדרש בתוספת ראשונה א׳` TRUE FALSE)
#ASSERT NOT (`סעיף 267ב(ב) - מדיניות התגמול כוללת את הנדרש בתוספת ראשונה א׳` FALSE TRUE)
