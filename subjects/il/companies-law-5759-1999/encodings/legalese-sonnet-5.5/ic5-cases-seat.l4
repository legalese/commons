IMPORT prelude
IMPORT daydate
IMPORT `ic-core`
IMPORT `ic-core-company-kinds`
IMPORT `ic5-parties`
IMPORT `ic5-a1-registration`
IMPORT `ic5-a2-articles-and-distribution`
IMPORT `ic5-a3-audit`
IMPORT `ic5-a4-pay-transactions-liability`
IMPORT `ic5-a5-claims-shares-merger`
IMPORT `ic5-a6-winding-up`
IMPORT `ic5-a7-reporting-supervision`
IMPORT `ic5-a8-remedies-application`
