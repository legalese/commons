IMPORT prelude
IMPORT `ic-core`
IMPORT `ic5-parties`
IMPORT `ic5-a5-claims-shares-merger`

-- ic5-tests-a5: tests of ic5-a5-claims-shares-merger (sections 345יד to 345יח).
-- Every expected value below was decided from the section named beside it, before the run.

§ `בדיקות – סעיפים 345יד עד 345יח`

§§ `345יד – תביעה נגזרת והגנה נגזרת`

-- 345יד(א): the Registrar of Endowments, with the Attorney General's approval, may file a derivative claim; nobody else is added by this subsection.
#ASSERT `סעיף 345יד(א) - רשם ההקדשות רשאי להגיש תביעה נגזרת` TRUE `רשם ההקדשות (פרק 1א)` TRUE
#ASSERT NOT (`סעיף 345יד(א) - רשם ההקדשות רשאי להגיש תביעה נגזרת` TRUE `רשם ההקדשות (פרק 1א)` FALSE)
#ASSERT NOT (`סעיף 345יד(א) - רשם ההקדשות רשאי להגיש תביעה נגזרת` TRUE `היועץ המשפטי לממשלה (פרק 1א)` TRUE)
#ASSERT NOT (`סעיף 345יד(א) - רשם ההקדשות רשאי להגיש תביעה נגזרת` TRUE `אדם אחר (פרק 1א)` TRUE)
#ASSERT NOT (`סעיף 345יד(א) - רשם ההקדשות רשאי להגיש תביעה נגזרת` FALSE `רשם ההקדשות (פרק 1א)` TRUE)
-- 345יד(ב): the Registrar of Endowments or the Attorney General may defend on the company's behalf.
#ASSERT `סעיף 345יד(ב) - רשם ההקדשות או היועץ המשפטי לממשלה רשאי להתגונן בשם החברה` TRUE `רשם ההקדשות (פרק 1א)`
#ASSERT `סעיף 345יד(ב) - רשם ההקדשות או היועץ המשפטי לממשלה רשאי להתגונן בשם החברה` TRUE `היועץ המשפטי לממשלה (פרק 1א)`
#ASSERT NOT (`סעיף 345יד(ב) - רשם ההקדשות או היועץ המשפטי לממשלה רשאי להתגונן בשם החברה` TRUE `אדם אחר (פרק 1א)`)
#ASSERT NOT (`סעיף 345יד(ב) - רשם ההקדשות או היועץ המשפטי לממשלה רשאי להתגונן בשם החברה` FALSE `רשם ההקדשות (פרק 1א)`)
-- 345יד(ג).
#ASSERT `סעיף 345יד(ג) - הוראות הסימן בדבר תביעה נגזרת חלות על התביעה או ההגנה` TRUE
#ASSERT NOT (`סעיף 345יד(ג) - הוראות הסימן בדבר תביעה נגזרת חלות על התביעה או ההגנה` FALSE)

§§ `345טו – העברת מניות`

-- 345טו(א): a transfer for consideration needs the court's advance approval; a minimal-sum transfer needs only an advance report; a gift is not caught.
#ASSERT `סעיף 345טו(א) - סעיף 345טו(א) אינו אוסר את העברת המניה` TRUE TRUE FALSE FALSE
#ASSERT `סעיף 345טו(א) - סעיף 345טו(א) אינו אוסר את העברת המניה` TRUE FALSE TRUE TRUE
#ASSERT NOT (`סעיף 345טו(א) - סעיף 345טו(א) אינו אוסר את העברת המניה` TRUE FALSE TRUE FALSE)
#ASSERT NOT (`סעיף 345טו(א) - סעיף 345טו(א) אינו אוסר את העברת המניה` TRUE FALSE FALSE TRUE)
#ASSERT NOT (`סעיף 345טו(א) - סעיף 345טו(א) אינו אוסר את העברת המניה` TRUE FALSE FALSE FALSE)
#ASSERT `סעיף 345טו(א) - סעיף 345טו(א) אינו אוסר את העברת המניה` FALSE FALSE FALSE FALSE
-- 345טו(ב): a share cannot be inherited, attached, charged, distributed in the holder's winding up or insolvency, or passed to a liquidator or trustee.
#ASSERT `סעיף 345טו(ב) - הפעולה במניה אסורה` `הורשת המניה`
#ASSERT `סעיף 345טו(ב) - הפעולה במניה אסורה` `עיקול המניה`
#ASSERT `סעיף 345טו(ב) - הפעולה במניה אסורה` `שעבוד המניה`
#ASSERT `סעיף 345טו(ב) - הפעולה במניה אסורה` `חלוקת המניה בין נכסי בעל המניה בפירוקו או בהליכי חדלות פירעון שלו`
#ASSERT `סעיף 345טו(ב) - הפעולה במניה אסורה` `העברת המניה למפרק או לנאמן`
#ASSERT NOT (`סעיף 345טו(ב) - הפעולה במניה אסורה` `פעולה אחרת במניה`)
-- 345טו(ב): on the holder's death or winding up the share is treated as a dormant share (section 308).
#ASSERT `סעיף 345טו(ב) - המניה נחשבת מניה רדומה` TRUE FALSE
#ASSERT `סעיף 345טו(ב) - המניה נחשבת מניה רדומה` FALSE TRUE
#ASSERT NOT (`סעיף 345טו(ב) - המניה נחשבת מניה רדומה` FALSE FALSE)

§§ `345טז – מיזוג`

-- 345טז(א): only with another public-benefit company or an association with public purposes; with the ordinary approvals and the court's.
#ASSERT `סעיף 345טז(א) - חברה לתועלת הציבור רשאית להתמזג` TRUE FALSE TRUE TRUE
#ASSERT `סעיף 345טז(א) - חברה לתועלת הציבור רשאית להתמזג` FALSE TRUE TRUE TRUE
#ASSERT NOT (`סעיף 345טז(א) - חברה לתועלת הציבור רשאית להתמזג` FALSE FALSE TRUE TRUE)
#ASSERT NOT (`סעיף 345טז(א) - חברה לתועלת הציבור רשאית להתמזג` TRUE FALSE FALSE TRUE)
#ASSERT NOT (`סעיף 345טז(א) - חברה לתועלת הציבור רשאית להתמזג` TRUE FALSE TRUE FALSE)
-- 345טז(ב) and (ג): the court's persuasion, and the Registrar of Endowments's chance to be heard.
#ASSERT `סעיף 345טז(ב) - שכנוע בית המשפט הנדרש לאישור המיזוג` TRUE
#ASSERT NOT (`סעיף 345טז(ב) - שכנוע בית המשפט הנדרש לאישור המיזוג` FALSE)
#ASSERT `סעיף 345טז(ג) - בית המשפט רשאי להחליט בבקשה לאישור המיזוג` TRUE
#ASSERT NOT (`סעיף 345טז(ג) - בית המשפט רשאי להחליט בבקשה לאישור המיזוג` FALSE)
#ASSERT `סעיף 345טז(ב)-(ג) - בית המשפט רשאי לאשר את המיזוג` TRUE TRUE
#ASSERT NOT (`סעיף 345טז(ב)-(ג) - בית המשפט רשאי לאשר את המיזוג` TRUE FALSE)
#ASSERT NOT (`סעיף 345טז(ב)-(ג) - בית המשפט רשאי לאשר את המיזוג` FALSE TRUE)

§§ `345יז – פשרה או הסדר`

-- 345יז(א): notice to the Registrar of Endowments in every proceeding under chapter 3 of Part 9 concerning a public-benefit company.
#ASSERT `סעיף 345יז(א) - יש למסור הודעה לרשם ההקדשות ולאפשר לו להביע את עמדתו` TRUE TRUE
#ASSERT NOT (`סעיף 345יז(א) - יש למסור הודעה לרשם ההקדשות ולאפשר לו להביע את עמדתו` TRUE FALSE)
#ASSERT NOT (`סעיף 345יז(א) - יש למסור הודעה לרשם ההקדשות ולאפשר לו להביע את עמדתו` FALSE TRUE)
-- 345יז(ב): a claim to a share in the assets resting on shareholding alone is barred; a claim on another basis is not.
#ASSERT `סעיף 345יז(ב) - בעל מניות אינו זכאי לחלק בנכסי החברה רק בשל היותו בעל מניות` TRUE
#ASSERT NOT (`סעיף 345יז(ב) - בעל מניות אינו זכאי לחלק בנכסי החברה רק בשל היותו בעל מניות` FALSE)
-- 345יז(ג): the court approves a compromise only if persuaded and the compromise fits the chapter's provisions.
#ASSERT `סעיף 345יז(ג) - בית המשפט רשאי לאשר פשרה או הסדר` TRUE TRUE
#ASSERT NOT (`סעיף 345יז(ג) - בית המשפט רשאי לאשר פשרה או הסדר` TRUE FALSE)
#ASSERT NOT (`סעיף 345יז(ג) - בית המשפט רשאי לאשר פשרה או הסדר` FALSE TRUE)

§§ `345יח – חקירה`

-- 345יח(א): a reasonable basis for concern is what gives the Registrar of Endowments the power (he may also act on his own initiative).
#ASSERT `סעיף 345יח(א) - רשם ההקדשות רשאי לחקור בעניני החברה` TRUE
#ASSERT NOT (`סעיף 345יח(א) - רשם ההקדשות רשאי לחקור בעניני החברה` FALSE)
-- 345יח(א): who may ask: a shareholder with at least 25% of the capital or at least 25% of the votes (exactly 25% counts), the audit committee, the Attorney General.
#ASSERT `סעיף 345יח(א) - הבקשה לחקירה היא בקשה שהסעיף מונה` `בעל מניה כמבקש חקירה` 0.25 0
#ASSERT `סעיף 345יח(א) - הבקשה לחקירה היא בקשה שהסעיף מונה` `בעל מניה כמבקש חקירה` 0.1 0.25
#ASSERT NOT (`סעיף 345יח(א) - הבקשה לחקירה היא בקשה שהסעיף מונה` `בעל מניה כמבקש חקירה` 0.24 0.24)
#ASSERT `סעיף 345יח(א) - הבקשה לחקירה היא בקשה שהסעיף מונה` `ועדת הביקורת כמבקשת חקירה` 0 0
#ASSERT `סעיף 345יח(א) - הבקשה לחקירה היא בקשה שהסעיף מונה` `היועץ המשפטי לממשלה כמבקש חקירה` 0 0
#ASSERT `סעיף 345יח(א) - הבקשה לחקירה היא בקשה שהסעיף מונה` `רשם ההקדשות מיוזמתו` 0 0
#ASSERT NOT (`סעיף 345יח(א) - הבקשה לחקירה היא בקשה שהסעיף מונה` `אדם אחר כמבקש חקירה` 0.9 0.9)
-- 345יח(ב): an inquirer may be appointed where an investigation may be made; once appointed he reports.
#ASSERT `סעיף 345יח(ב) - רשם ההקדשות רשאי למנות חוקר` TRUE
#ASSERT NOT (`סעיף 345יח(ב) - רשם ההקדשות רשאי למנות חוקר` FALSE)
#ASSERT `סעיף 345יח(ב) - החוקר חייב למסור לרשם ההקדשות דין וחשבון` TRUE
#ASSERT NOT (`סעיף 345יח(ב) - החוקר חייב למסור לרשם ההקדשות דין וחשבון` FALSE)
-- 345יח(ג): costs on the company, its office-holders or the applicant once an inquirer is appointed; security from the applicant.
#ASSERT `סעיף 345יח(ג) - רשם ההקדשות רשאי להטיל את הוצאות החקירה על הנושא` TRUE TRUE
#ASSERT NOT (`סעיף 345יח(ג) - רשם ההקדשות רשאי להטיל את הוצאות החקירה על הנושא` FALSE TRUE)
#ASSERT NOT (`סעיף 345יח(ג) - רשם ההקדשות רשאי להטיל את הוצאות החקירה על הנושא` TRUE FALSE)
#ASSERT `סעיף 345יח(ג) - רשם ההקדשות רשאי לדרוש ממבקש החקירה ערובה להוצאותיה` TRUE TRUE
#ASSERT NOT (`סעיף 345יח(ג) - רשם ההקדשות רשאי לדרוש ממבקש החקירה ערובה להוצאותיה` TRUE FALSE)
#ASSERT NOT (`סעיף 345יח(ג) - רשם ההקדשות רשאי לדרוש ממבקש החקירה ערובה להוצאותיה` FALSE TRUE)
