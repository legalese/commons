IMPORT prelude
IMPORT daydate
IMPORT `ic-core`
IMPORT `ic5-a1-registration`

-- ic5-tests-a1: tests of ic5-a1-registration (sections 345א to 345ד).
-- Every expected value below was decided from the section named beside it, before the run.

§ `בדיקות – סעיפים 345א עד 345ד`

§§ `345א – חברה לתועלת הציבור`

-- 345א(א): a company whose articles set public purposes only and prohibit distributing profits to shareholders.
#ASSERT `סעיף 345א(א) - חברה לתועלת הציבור` `לפי חוק זה` TRUE TRUE
-- Incorporated under the Companies Ordinance is still a "company" (section 1), so the company limb holds.
#ASSERT `סעיף 345א(א) - חברה לתועלת הציבור` `לפי פקודת החברות` TRUE TRUE
#ASSERT NOT (`סעיף 345א(א) - חברה לתועלת הציבור` `לפי חוק זה` FALSE TRUE)
#ASSERT NOT (`סעיף 345א(א) - חברה לתועלת הציבור` `לפי חוק זה` TRUE FALSE)
#ASSERT NOT (`סעיף 345א(א) - חברה לתועלת הציבור` `לפי חוק זה` FALSE FALSE)
-- Incorporated under another law: not a "company" in the sense of section 1, so not a public-benefit company either.
#ASSERT NOT (`סעיף 345א(א) - חברה לתועלת הציבור` `לפי דין אחר` TRUE TRUE)

-- 345א(ב): a public purpose is a purpose the Second Schedule lists.
#ASSERT `סעיף 345א(ב) - מטרה ציבורית` TRUE
#ASSERT NOT (`סעיף 345א(ב) - מטרה ציבורית` FALSE)

§§ `345ב – רישום`

-- 345ב(א): the declaration plus the five attachments, in two copies; all must be there.
#ASSERT `סעיף 345ב(א) - הבקשה לרישום חברה לתועלת הציבור שלמה` TRUE TRUE TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`סעיף 345ב(א) - הבקשה לרישום חברה לתועלת הציבור שלמה` FALSE TRUE TRUE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`סעיף 345ב(א) - הבקשה לרישום חברה לתועלת הציבור שלמה` TRUE FALSE TRUE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`סעיף 345ב(א) - הבקשה לרישום חברה לתועלת הציבור שלמה` TRUE TRUE FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`סעיף 345ב(א) - הבקשה לרישום חברה לתועלת הציבור שלמה` TRUE TRUE TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`סעיף 345ב(א) - הבקשה לרישום חברה לתועלת הציבור שלמה` TRUE TRUE TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`סעיף 345ב(א) - הבקשה לרישום חברה לתועלת הציבור שלמה` TRUE TRUE TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`סעיף 345ב(א) - הבקשה לרישום חברה לתועלת הציבור שלמה` TRUE TRUE TRUE TRUE TRUE TRUE FALSE)

-- 345ב(ב): the Registrar may register only if the Registrar of Endowments confirmed and all the information asked for was given.
#ASSERT `סעיף 345ב(ב) - הרשם רשאי לרשום חברה לתועלת הציבור או שינוי תקנון` TRUE TRUE
#ASSERT NOT (`סעיף 345ב(ב) - הרשם רשאי לרשום חברה לתועלת הציבור או שינוי תקנון` TRUE FALSE)
#ASSERT NOT (`סעיף 345ב(ב) - הרשם רשאי לרשום חברה לתועלת הציבור או שינוי תקנון` FALSE TRUE)
#ASSERT NOT (`סעיף 345ב(ב) - הרשם רשאי לרשום חברה לתועלת הציבור או שינוי תקנון` FALSE FALSE)

-- 345ב(ב): 45 days from the day everything was received. 20 December 2026 + 45 days = 3 February 2027
-- (11 days left in December, 31 in January, 3 in February). 1 January 2026 + 45 = 15 February 2026.
#ASSERT `סעיף 345ב(ב) - המועד האחרון לתשובת רשם ההקדשות` (YMD 2026 12 20) EQUALS YMD 2027 2 3
#ASSERT `סעיף 345ב(ב) - המועד האחרון לתשובת רשם ההקדשות` (YMD 2026 1 1) EQUALS YMD 2026 2 15
-- On the last day: in time. The day after: late. Earlier: in time.
#ASSERT `סעיף 345ב(ב) - רשם ההקדשות השיב במועד` (YMD 2026 1 1) (YMD 2026 2 15)
#ASSERT NOT (`סעיף 345ב(ב) - רשם ההקדשות השיב במועד` (YMD 2026 1 1) (YMD 2026 2 16))
#ASSERT `סעיף 345ב(ב) - רשם ההקדשות השיב במועד` (YMD 2026 1 1) (YMD 2026 1 20)

-- 345ב(ג): a majority of the directors (more than half) and the general manager.
#ASSERT `סעיף 345ב(ג) - התצהיר חתום כנדרש` 5 3 TRUE
#ASSERT NOT (`סעיף 345ב(ג) - התצהיר חתום כנדרש` 5 2 TRUE)
#ASSERT NOT (`סעיף 345ב(ג) - התצהיר חתום כנדרש` 5 3 FALSE)
-- Exactly half of four is not a majority; three of four is.
#ASSERT NOT (`סעיף 345ב(ג) - התצהיר חתום כנדרש` 4 2 TRUE)
#ASSERT `סעיף 345ב(ג) - התצהיר חתום כנדרש` 4 3 TRUE
#ASSERT `סעיף 345ב(ג) - התצהיר חתום כנדרש` 1 1 TRUE
#ASSERT NOT (`סעיף 345ב(ג) - התצהיר חתום כנדרש` 1 0 TRUE)
-- 345ב(ג): the resolution has no effect until the Registrar registers the change.
#ASSERT NOT (`סעיף 345ב(ג) - להחלטה על שינוי התקנון יש תוקף` TRUE FALSE)
#ASSERT `סעיף 345ב(ג) - להחלטה על שינוי התקנון יש תוקף` TRUE TRUE
-- A resolution that does not bring about the 345א(א) conditions is not caught by this limb.
#ASSERT `סעיף 345ב(ג) - להחלטה על שינוי התקנון יש תוקף` FALSE FALSE
#ASSERT `סעיף 345ב(ג) - להחלטה על שינוי התקנון יש תוקף` FALSE TRUE
-- 345ב(ג): the application for registering the change needs the affidavit and the (a) documents.
#ASSERT `סעיף 345ב(ג) - הבקשה לרישום שינוי התקנון שלמה` 5 3 TRUE TRUE
#ASSERT NOT (`סעיף 345ב(ג) - הבקשה לרישום שינוי התקנון שלמה` 5 3 TRUE FALSE)
#ASSERT NOT (`סעיף 345ב(ג) - הבקשה לרישום שינוי התקנון שלמה` 5 2 TRUE TRUE)

-- 345ב(ד) and 345ב(ו): the certificate must state both things; then the company counts as registered in the register.
#ASSERT `סעיף 345ב(ד) - תעודת ההתאגדות שנמסרה לחברה היא כנדרש` TRUE TRUE
#ASSERT NOT (`סעיף 345ב(ד) - תעודת ההתאגדות שנמסרה לחברה היא כנדרש` TRUE FALSE)
#ASSERT NOT (`סעיף 345ב(ד) - תעודת ההתאגדות שנמסרה לחברה היא כנדרש` FALSE TRUE)
#ASSERT `סעיף 345ב(ו) - החברה נחשבת רשומה בפנקס` TRUE TRUE
#ASSERT NOT (`סעיף 345ב(ו) - החברה נחשבת רשומה בפנקס` TRUE FALSE)
#ASSERT NOT (`סעיף 345ב(ו) - החברה נחשבת רשומה בפנקס` FALSE TRUE)
#ASSERT NOT (`סעיף 345ב(ו) - החברה נחשבת רשומה בפנקס` FALSE FALSE)

-- 345ב(ה): registering such a company, or a change of its articles, obliges the Registrar to pass the copies on.
#ASSERT `סעיף 345ב(ה) - הרשם חייב להעביר לרשם ההקדשות עותקים` TRUE
#ASSERT NOT (`סעיף 345ב(ה) - הרשם חייב להעביר לרשם ההקדשות עותקים` FALSE)

-- 345ב(ז): a public-benefit company that did not declare must apply to the Registrar of Endowments (unless already registered).
#ASSERT `סעיף 345ב(ז) - החברה חייבת להגיש בקשה לרשם ההקדשות לרישום בפנקס` TRUE TRUE FALSE
#ASSERT NOT (`סעיף 345ב(ז) - החברה חייבת להגיש בקשה לרשם ההקדשות לרישום בפנקס` TRUE FALSE FALSE)
#ASSERT NOT (`סעיף 345ב(ז) - החברה חייבת להגיש בקשה לרשם ההקדשות לרישום בפנקס` FALSE TRUE FALSE)
#ASSERT NOT (`סעיף 345ב(ז) - החברה חייבת להגיש בקשה לרשם ההקדשות לרישום בפנקס` TRUE TRUE TRUE)
-- 345ב(ז): the Registrar corrects the certificate on receiving the Registrar of Endowments's notice.
#ASSERT `סעיף 345ב(ז) - הרשם חייב לתקן את תעודת ההתאגדות` TRUE TRUE
#ASSERT NOT (`סעיף 345ב(ז) - הרשם חייב לתקן את תעודת ההתאגדות` TRUE FALSE)
#ASSERT NOT (`סעיף 345ב(ז) - הרשם חייב לתקן את תעודת ההתאגדות` FALSE TRUE)

§§ `345ג – הפנקס`

-- 345ג(ב): any person who asks may inspect.
#ASSERT `סעיף 345ג(ב) - אדם רשאי לעיין בפנקס` TRUE
#ASSERT NOT (`סעיף 345ג(ב) - אדם רשאי לעיין בפנקס` FALSE)

-- 345ג(ג): register on receipt from the Registrar; or on the company's application if confirmed and all information given.
#ASSERT `סעיף 345ג(ג) - רשם ההקדשות חייב לרשום חברה בפנקס` TRUE FALSE FALSE FALSE
#ASSERT `סעיף 345ג(ג) - רשם ההקדשות חייב לרשום חברה בפנקס` FALSE TRUE TRUE TRUE
#ASSERT NOT (`סעיף 345ג(ג) - רשם ההקדשות חייב לרשום חברה בפנקס` FALSE TRUE FALSE TRUE)
#ASSERT NOT (`סעיף 345ג(ג) - רשם ההקדשות חייב לרשום חברה בפנקס` FALSE TRUE TRUE FALSE)
#ASSERT NOT (`סעיף 345ג(ג) - רשם ההקדשות חייב לרשום חברה בפנקס` FALSE FALSE TRUE TRUE)
#ASSERT `סעיף 345ג(ג) - רשם ההקדשות חייב למסור לחברה ולרשם הודעה על הרישום` TRUE
#ASSERT NOT (`סעיף 345ג(ג) - רשם ההקדשות חייב למסור לחברה ולרשם הודעה על הרישום` FALSE)

-- 345ג(ד)(1) and (2): learned by another route, notice by registered post, 45 days from sending.
-- Day 45 is still the company's day to respond; the duty to register begins on day 46.
#ASSERT `סעיף 345ג(ד) - רישום בפנקס ביוזמת רשם ההקדשות` TRUE TRUE 46 FALSE EQUALS `רשם ההקדשות חייב לרשום את החברה בפנקס`
#ASSERT `סעיף 345ג(ד) - רישום בפנקס ביוזמת רשם ההקדשות` TRUE TRUE 45 FALSE EQUALS `רשם ההקדשות אינו חייב עדיין לרשום את החברה בפנקס`
#ASSERT `סעיף 345ג(ד) - רישום בפנקס ביוזמת רשם ההקדשות` TRUE TRUE 0 FALSE EQUALS `רשם ההקדשות אינו חייב עדיין לרשום את החברה בפנקס`
#ASSERT `סעיף 345ג(ד) - רישום בפנקס ביוזמת רשם ההקדשות` TRUE TRUE 400 FALSE EQUALS `רשם ההקדשות חייב לרשום את החברה בפנקס`
-- No notice sent: no registration by this route, however many days pass.
#ASSERT `סעיף 345ג(ד) - רישום בפנקס ביוזמת רשם ההקדשות` TRUE FALSE 100 FALSE EQUALS `רשם ההקדשות אינו חייב עדיין לרשום את החברה בפנקס`
-- Not learned of by the Registrar of Endowments: nothing starts.
#ASSERT `סעיף 345ג(ד) - רישום בפנקס ביוזמת רשם ההקדשות` FALSE TRUE 100 FALSE EQUALS `רשם ההקדשות אינו חייב עדיין לרשום את החברה בפנקס`
-- The company responded in time: the text says nothing about what follows (explicit not-covered value).
#ASSERT `סעיף 345ג(ד) - רישום בפנקס ביוזמת רשם ההקדשות` TRUE TRUE 100 TRUE EQUALS `הדין אינו קובע מה דינה של חברה שהגיבה להודעה במועד`
#ASSERT `סעיף 345ג(ד) - רישום בפנקס ביוזמת רשם ההקדשות` TRUE TRUE 10 TRUE EQUALS `הדין אינו קובע מה דינה של חברה שהגיבה להודעה במועד`
-- 345ג(ד)(3): the notice and the corrected certificate delivered together make the company a public-benefit company.
#ASSERT `סעיף 345ג(ד)(3) - החברה נחשבת חברה לתועלת הציבור` TRUE TRUE
#ASSERT NOT (`סעיף 345ג(ד)(3) - החברה נחשבת חברה לתועלת הציבור` TRUE FALSE)
#ASSERT NOT (`סעיף 345ג(ד)(3) - החברה נחשבת חברה לתועלת הציבור` FALSE TRUE)
-- 345ג1.
#ASSERT `סעיף 345ג1 - רשם ההקדשות מילא את חובת הפרסום` TRUE
#ASSERT NOT (`סעיף 345ג1 - רשם ההקדשות מילא את חובת הפרסום` FALSE)

§§ `345ד – הסיומת בצד השם`

-- 345ד(א): only a registered public-benefit company must show the suffix; either of the two forms satisfies it.
#ASSERT `סעיף 345ד(א) - החברה חייבת לציין סיומת בצד שמה` TRUE TRUE
#ASSERT NOT (`סעיף 345ד(א) - החברה חייבת לציין סיומת בצד שמה` TRUE FALSE)
#ASSERT NOT (`סעיף 345ד(א) - החברה חייבת לציין סיומת בצד שמה` FALSE TRUE)
#ASSERT `סעיף 345ד(א) - הסיומת שצוינה עונה על הדרישה` `הסיומת חברה לתועלת הציבור`
#ASSERT `סעיף 345ד(א) - הסיומת שצוינה עונה על הדרישה` `הסיומת (חל״צ)`
#ASSERT NOT (`סעיף 345ד(א) - הסיומת שצוינה עונה על הדרישה` `סיומת אחרת בצד שם החברה`)
#ASSERT NOT (`סעיף 345ד(א) - הסיומת שצוינה עונה על הדרישה` `אין סיומת בצד שם החברה`)
-- 345ד(ב): everyone but a registered public-benefit company is barred from showing the suffix or presenting itself as one.
#ASSERT `סעיף 345ד(ב) - החברה אסורה בציון הסיומת ובהצגה עצמית כחברה לתועלת הציבור` FALSE FALSE
#ASSERT `סעיף 345ד(ב) - החברה אסורה בציון הסיומת ובהצגה עצמית כחברה לתועלת הציבור` TRUE FALSE
#ASSERT `סעיף 345ד(ב) - החברה אסורה בציון הסיומת ובהצגה עצמית כחברה לתועלת הציבור` FALSE TRUE
#ASSERT NOT (`סעיף 345ד(ב) - החברה אסורה בציון הסיומת ובהצגה עצמית כחברה לתועלת הציבור` TRUE TRUE)
-- Breach: barred and (shows the suffix or presents itself some other way).
#ASSERT `סעיף 345ד(ב) - החברה הפרה את איסור ההצגה כחברה לתועלת הציבור` TRUE FALSE TRUE FALSE
#ASSERT `סעיף 345ד(ב) - החברה הפרה את איסור ההצגה כחברה לתועלת הציבור` FALSE FALSE FALSE TRUE
#ASSERT NOT (`סעיף 345ד(ב) - החברה הפרה את איסור ההצגה כחברה לתועלת הציבור` TRUE FALSE FALSE FALSE)
#ASSERT NOT (`סעיף 345ד(ב) - החברה הפרה את איסור ההצגה כחברה לתועלת הציבור` TRUE TRUE TRUE TRUE)
