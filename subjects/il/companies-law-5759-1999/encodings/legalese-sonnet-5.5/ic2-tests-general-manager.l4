IMPORT prelude
IMPORT `ic-core`
IMPORT `ic2-tests-fixtures`
IMPORT `ic2-p3c4-general-manager`

-- Tests of ic2-p3c4-general-manager.l4 (sections 119 to 122). Every expected value is written from the text of the section named beside it,
-- before the rule was run; none is copied from the rule's output.

§ `בדיקות: המנהל הכללי`

§§ `סעיף 119`

-- 119(א): a public company or a private bond company must appoint a general manager; any other private company need not.
#ASSERT `סעיף 119(א) - החברה חייבת למנות מנהל כללי` `דוגמה - חברה ציבורית שהיא תאגיד מדווח`
#ASSERT `סעיף 119(א) - החברה חייבת למנות מנהל כללי` `דוגמה - חברה פרטית שהיא חברת איגרות חוב ואינה תאגיד מדווח`
#ASSERT NOT (`סעיף 119(א) - החברה חייבת למנות מנהל כללי` `דוגמה - חברה פרטית שאינה חברת איגרות חוב`)
#ASSERT NOT (`סעיף 119(א) - החברה חייבת למנות מנהל כללי` `דוגמה - גוף שהתאגד לפי דין אחר`)

-- 119(א) and (ב): the permission to appoint more than one general manager holds for every company, and for no body that is not a company.
#ASSERT `סעיף 119 - החברה רשאית למנות יותר ממנהל כללי אחד` `דוגמה - חברה ציבורית שאינה תאגיד מדווח`
#ASSERT `סעיף 119 - החברה רשאית למנות יותר ממנהל כללי אחד` `דוגמה - חברה פרטית שהיא חברת איגרות חוב ותאגיד מדווח`
#ASSERT `סעיף 119 - החברה רשאית למנות יותר ממנהל כללי אחד` `דוגמה - חברה פרטית שאינה חברת איגרות חוב`
#ASSERT NOT (`סעיף 119 - החברה רשאית למנות יותר ממנהל כללי אחד` `דוגמה - גוף שהתאגד לפי דין אחר`)

-- 119(ב): only a private company that is not a bond company may appoint no general manager.
#ASSERT `סעיף 119(ב) - החברה רשאית שלא למנות מנהל כללי` `דוגמה - חברה פרטית שאינה חברת איגרות חוב`
#ASSERT `סעיף 119(ב) - החברה רשאית שלא למנות מנהל כללי` `דוגמה - חברה פרטית לתועלת הציבור`
#ASSERT NOT (`סעיף 119(ב) - החברה רשאית שלא למנות מנהל כללי` `דוגמה - חברה פרטית שהיא חברת איגרות חוב ואינה תאגיד מדווח`)
#ASSERT NOT (`סעיף 119(ב) - החברה רשאית שלא למנות מנהל כללי` `דוגמה - חברה ציבורית שאינה תאגיד מדווח`)

-- 119(ב): with no general manager appointed the board manages; with one appointed, or in a company that had to appoint one, the text names nobody here.
#ASSERT `סעיף 119(ב) - מי מנהל את החברה כשלא מונה מנהל כללי` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` FALSE EQUALS JUST `הדירקטוריון`
#ASSERT `סעיף 119(ב) - מי מנהל את החברה כשלא מונה מנהל כללי` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` TRUE EQUALS NOTHING
#ASSERT `סעיף 119(ב) - מי מנהל את החברה כשלא מונה מנהל כללי` `דוגמה - חברה ציבורית שאינה תאגיד מדווח` FALSE EQUALS NOTHING

§§ `סעיף 120`

-- 120: the responsibility is for current management only; and current management is done within the board's policy and in accordance with its guidelines.
#ASSERT `סעיף 120 - האחריות לענין מוטלת על המנהל הכללי` TRUE
#ASSERT NOT (`סעיף 120 - האחריות לענין מוטלת על המנהל הכללי` FALSE)
#ASSERT `סעיף 120 - ניהול השוטף נעשה כנדרש` TRUE TRUE
#ASSERT NOT (`סעיף 120 - ניהול השוטף נעשה כנדרש` FALSE TRUE)
#ASSERT NOT (`סעיף 120 - ניהול השוטף נעשה כנדרש` TRUE FALSE)

§§ `סעיף 121`

-- 121(א): a management power that neither this Law nor the articles gave to another organ is the general manager's.
#ASSERT `סעיף 121(א) - הסמכות נתונה למנהל הכללי` TRUE FALSE FALSE
#ASSERT NOT (`סעיף 121(א) - הסמכות נתונה למנהל הכללי` TRUE TRUE FALSE)
#ASSERT NOT (`סעיף 121(א) - הסמכות נתונה למנהל הכללי` TRUE FALSE TRUE)
#ASSERT NOT (`סעיף 121(א) - הסמכות נתונה למנהל הכללי` FALSE FALSE FALSE)
#ASSERT `סעיף 121(א) - מי שהמנהל הכללי נתון לפיקוחו` EQUALS `הדירקטוריון`

-- 121(ב): delegation needs the board's approval, and the delegate must be subordinate to the general manager.
#ASSERT `סעיף 121(ב) - המנהל הכללי רשאי לאצול סמכות` TRUE TRUE
#ASSERT NOT (`סעיף 121(ב) - המנהל הכללי רשאי לאצול סמכות` FALSE TRUE)
#ASSERT NOT (`סעיף 121(ב) - המנהל הכללי רשאי לאצול סמכות` TRUE FALSE)

-- 121(ג): votes of the disinterested non-controlling shareholders, in voting rights: for, against, abstaining; and all the voting rights in the company.
`נתוני הצבעה - רוב ברור` MEANS `נתוני הצבעה לפי סעיף 121(ג)` WITH
    `הצבעת בעלי המניות שאינם בעלי שליטה ושאינם בעלי עניין אישי` IS `הצבעה` WITH `קולות בעד` IS 60, `קולות נגד` IS 20, `קולות נמנעים` IS 10
    `כלל זכויות ההצבעה בחברה` IS 1000
`נתוני הצבעה - אין רוב ויש התנגדות רבה` MEANS `נתוני הצבעה לפי סעיף 121(ג)` WITH
    `הצבעת בעלי המניות שאינם בעלי שליטה ושאינם בעלי עניין אישי` IS `הצבעה` WITH `קולות בעד` IS 30, `קולות נגד` IS 50, `קולות נמנעים` IS 0
    `כלל זכויות ההצבעה בחברה` IS 1000
`נתוני הצבעה - אין רוב אך ההתנגדות נמוכה` MEANS `נתוני הצבעה לפי סעיף 121(ג)` WITH
    `הצבעת בעלי המניות שאינם בעלי שליטה ושאינם בעלי עניין אישי` IS `הצבעה` WITH `קולות בעד` IS 10, `קולות נגד` IS 10, `קולות נמנעים` IS 100
    `כלל זכויות ההצבעה בחברה` IS 1000
`נתוני הצבעה - התנגדות בדיוק שני אחוזים` MEANS `נתוני הצבעה לפי סעיף 121(ג)` WITH
    `הצבעת בעלי המניות שאינם בעלי שליטה ושאינם בעלי עניין אישי` IS `הצבעה` WITH `קולות בעד` IS 0, `קולות נגד` IS 20, `קולות נמנעים` IS 0
    `כלל זכויות ההצבעה בחברה` IS 1000
`נתוני הצבעה - התנגדות מעט מעל שני אחוזים` MEANS `נתוני הצבעה לפי סעיף 121(ג)` WITH
    `הצבעת בעלי המניות שאינם בעלי שליטה ושאינם בעלי עניין אישי` IS `הצבעה` WITH `קולות בעד` IS 0, `קולות נגד` IS 21, `קולות נמנעים` IS 0
    `כלל זכויות ההצבעה בחברה` IS 1000
`נתוני הצבעה - ארבעים בעד וארבעים נגד` MEANS `נתוני הצבעה לפי סעיף 121(ג)` WITH
    `הצבעת בעלי המניות שאינם בעלי שליטה ושאינם בעלי עניין אישי` IS `הצבעה` WITH `קולות בעד` IS 40, `קולות נגד` IS 40, `קולות נמנעים` IS 0
    `כלל זכויות ההצבעה בחברה` IS 1000
`נתוני הצבעה - ארבעים ואחד בעד ושלושים ותשעה נגד` MEANS `נתוני הצבעה לפי סעיף 121(ג)` WITH
    `הצבעת בעלי המניות שאינם בעלי שליטה ושאינם בעלי עניין אישי` IS `הצבעה` WITH `קולות בעד` IS 41, `קולות נגד` IS 39, `קולות נמנעים` IS 0
    `כלל זכויות ההצבעה בחברה` IS 1000

-- 121(ג)(1) first alternative: a clear majority of the disinterested votes (60 of 80 counted, abstentions set aside), section 276 observed.
#ASSERT `סעיף 121(ג) - האסיפה הכללית רשאית להחליט על הסמכה כפולה` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` TRUE `נתוני הצבעה - רוב ברור` TRUE
-- Neither alternative: 30 of 80 is no majority and the 50 opposing votes are more than 2% of 1000 (that is 20).
#ASSERT NOT (`סעיף 121(ג) - האסיפה הכללית רשאית להחליט על הסמכה כפולה` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` TRUE `נתוני הצבעה - אין רוב ויש התנגדות רבה` TRUE)
-- The second alternative alone is enough ("אחד מאלה"): no majority (10 of 20) but only 10 opposing votes, at most 2%.
#ASSERT `סעיף 121(ג) - האסיפה הכללית רשאית להחליט על הסמכה כפולה` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` TRUE `נתוני הצבעה - אין רוב אך ההתנגדות נמוכה` TRUE
-- The second alternative at exactly 2% (20 of 1000) is within the limit; at 21 it is not.
#ASSERT `סעיף 121(ג)(2) - המתנגדים מקרב בעלי המניות האלה אינם עולים על שני אחוזים` `נתוני הצבעה - התנגדות בדיוק שני אחוזים`
#ASSERT NOT (`סעיף 121(ג)(2) - המתנגדים מקרב בעלי המניות האלה אינם עולים על שני אחוזים` `נתוני הצבעה - התנגדות מעט מעל שני אחוזים`)
-- The first alternative at the edge of a majority: 40 for and 40 against is not "more than half" of 80; 41 for and 39 against is.
#ASSERT NOT (`סעיף 121(ג)(1) - הרוב כולל רוב מקרב בעלי המניות שאינם בעלי שליטה ושאינם בעלי עניין אישי` TRUE `נתוני הצבעה - ארבעים בעד וארבעים נגד` TRUE)
#ASSERT `סעיף 121(ג)(1) - הרוב כולל רוב מקרב בעלי המניות שאינם בעלי שליטה ושאינם בעלי עניין אישי` TRUE `נתוני הצבעה - ארבעים ואחד בעד ושלושים ותשעה נגד` TRUE
-- The first alternative also needs a majority in the general meeting itself, and section 276 observed for a person with a personal interest.
#ASSERT NOT (`סעיף 121(ג)(1) - הרוב כולל רוב מקרב בעלי המניות שאינם בעלי שליטה ושאינם בעלי עניין אישי` FALSE `נתוני הצבעה - רוב ברור` TRUE)
#ASSERT NOT (`סעיף 121(ג)(1) - הרוב כולל רוב מקרב בעלי המניות שאינם בעלי שליטה ושאינם בעלי עניין אישי` TRUE `נתוני הצבעה - רוב ברור` FALSE)
-- 121(ג) is for the general meeting of a public company only.
#ASSERT NOT (`סעיף 121(ג) - האסיפה הכללית רשאית להחליט על הסמכה כפולה` `דוגמה - חברה פרטית שהיא חברת איגרות חוב ואינה תאגיד מדווח` TRUE `נתוני הצבעה - רוב ברור` TRUE)
#ASSERT NOT (`סעיף 121(ג) - האסיפה הכללית רשאית להחליט על הסמכה כפולה` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` TRUE `נתוני הצבעה - רוב ברור` TRUE)

-- 121(ד): the board of a private bond company may decide, with the audit committee's approval; no other company's board may.
#ASSERT `סעיף 121(ד) - הדירקטוריון רשאי להחליט על הסמכה כפולה` `דוגמה - חברה פרטית שהיא חברת איגרות חוב ואינה תאגיד מדווח` TRUE
#ASSERT NOT (`סעיף 121(ד) - הדירקטוריון רשאי להחליט על הסמכה כפולה` `דוגמה - חברה פרטית שהיא חברת איגרות חוב ואינה תאגיד מדווח` FALSE)
#ASSERT NOT (`סעיף 121(ד) - הדירקטוריון רשאי להחליט על הסמכה כפולה` `דוגמה - חברה ציבורית שאינה תאגיד מדווח` TRUE)
#ASSERT NOT (`סעיף 121(ד) - הדירקטוריון רשאי להחליט על הסמכה כפולה` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` TRUE)

-- 121(ג) and (ד) with (ה): three years unless regulations set a longer period for the kind of company.
#ASSERT `סעיף 121(ג)-(ד) - התקופה המרבית של כל הסמכה, בשנים` NOTHING EQUALS 3
#ASSERT `סעיף 121(ג)-(ד) - התקופה המרבית של כל הסמכה, בשנים` (JUST 5) EQUALS 5
#ASSERT `סעיף 121(ג)-(ד) - משך ההסמכה אינו עולה על המותר` 3 NOTHING
#ASSERT NOT (`סעיף 121(ג)-(ד) - משך ההסמכה אינו עולה על המותר` 4 NOTHING)
#ASSERT `סעיף 121(ג)-(ד) - משך ההסמכה אינו עולה על המותר` 5 (JUST 5)
#ASSERT NOT (`סעיף 121(ג)-(ד) - משך ההסמכה אינו עולה על המותר` 6 (JUST 5))

§§ `סעיף 122`

-- 122(א): the duty arises for a matter that is both unusual and material to the company.
#ASSERT `סעיף 122(א) - חובת ההודעה על ענין חריג חלה` TRUE TRUE
#ASSERT NOT (`סעיף 122(א) - חובת ההודעה על ענין חריג חלה` TRUE FALSE)
#ASSERT NOT (`סעיף 122(א) - חובת ההודעה על ענין חריג חלה` FALSE TRUE)
-- 122(א): notice goes to the chairperson, or to all the members of the board if there is no chairperson or he cannot fill the role.
#ASSERT `סעיף 122(א) - מי שיש להודיע לו על הענין החריג` TRUE TRUE EQUALS `יושב ראש הדירקטוריון`
#ASSERT `סעיף 122(א) - מי שיש להודיע לו על הענין החריג` FALSE TRUE EQUALS `הדירקטוריון`
#ASSERT `סעיף 122(א) - מי שיש להודיע לו על הענין החריג` TRUE FALSE EQUALS `הדירקטוריון`
-- 122(ב): the report must be on a subject the board fixed, at its time and to its extent.
#ASSERT `סעיף 122(ב) - הדיווח לדירקטוריון עומד בדרישת הדירקטוריון` TRUE TRUE TRUE
#ASSERT NOT (`סעיף 122(ב) - הדיווח לדירקטוריון עומד בדרישת הדירקטוריון` FALSE TRUE TRUE)
#ASSERT NOT (`סעיף 122(ב) - הדיווח לדירקטוריון עומד בדרישת הדירקטוריון` TRUE FALSE TRUE)
#ASSERT NOT (`סעיף 122(ב) - הדיווח לדירקטוריון עומד בדרישת הדירקטוריון` TRUE TRUE FALSE)
-- 122(ג): the chairperson may demand reports on matters concerning the company's business.
#ASSERT `סעיף 122(ג) - יושב ראש הדירקטוריון רשאי לדרוש דיווח מהמנהל הכללי` TRUE
#ASSERT NOT (`סעיף 122(ג) - יושב ראש הדירקטוריון רשאי לדרוש דיווח מהמנהל הכללי` FALSE)
-- 122(ד): a notice or report that required board action obliges the chairperson to convene the board.
#ASSERT `סעיף 122(ד) - היושב ראש חייב לזמן ישיבת דירקטוריון` TRUE
#ASSERT NOT (`סעיף 122(ד) - היושב ראש חייב לזמן ישיבת דירקטוריון` FALSE)
