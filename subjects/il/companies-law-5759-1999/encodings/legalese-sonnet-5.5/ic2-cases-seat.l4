#ASSERT `האם חלה חובת שליחת העתקי הדוחות לכל הזכאים לקבל הודעה על אסיפות` FALSE FALSE FALSE FALSE FALSE FALSE
#ASSERT NOT (`האם חלה חובת שליחת העתקי הדוחות לכל הזכאים לקבל הודעה על אסיפות` FALSE FALSE FALSE FALSE FALSE TRUE)
#ASSERT NOT (`האם חלה חובת שליחת העתקי הדוחות לכל הזכאים לקבל הודעה על אסיפות` TRUE FALSE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`האם חלה חובת שליחת העתקי הדוחות לכל הזכאים לקבל הודעה על אסיפות` FALSE FALSE TRUE FALSE FALSE FALSE)
#ASSERT `האם העתקי הדוחות נשלחו במועד לפני האסיפה השנתית` 14
#ASSERT `האם העתקי הדוחות נשלחו במועד לפני האסיפה השנתית` 20
#ASSERT NOT (`האם העתקי הדוחות נשלחו במועד לפני האסיפה השנתית` 13)
-- 174: the board declares in the annual report that it complied with 173(א).
#ASSERT `האם הדירקטוריון חייב להצהיר בדין וחשבון השנתי כי מילא אחר סעיף 173(א)` FALSE FALSE FALSE FALSE FALSE
#ASSERT NOT (`האם הדירקטוריון חייב להצהיר בדין וחשבון השנתי כי מילא אחר סעיף 173(א)` TRUE FALSE TRUE FALSE FALSE)
-- 175(א): the balance sheet is attached to the annual report if at least one of three holds: the articles do not restrict transfer; do not prohibit a public offer; do not limit the shareholders to fifty.
-- The arguments: the five company facts; the articles restrict transfer; the articles prohibit a public offer; the articles limit the shareholders to fifty.
#ASSERT `האם החברה שלי חייבת לצרף את המאזן לדין וחשבון השנתי` FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE
#ASSERT `האם החברה שלי חייבת לצרף את המאזן לדין וחשבון השנתי` FALSE FALSE FALSE FALSE FALSE TRUE FALSE TRUE
#ASSERT `האם החברה שלי חייבת לצרף את המאזן לדין וחשבון השנתי` FALSE FALSE FALSE FALSE FALSE TRUE TRUE FALSE
#ASSERT NOT (`האם החברה שלי חייבת לצרף את המאזן לדין וחשבון השנתי` FALSE FALSE FALSE FALSE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`האם החברה שלי חייבת לצרף את המאזן לדין וחשבון השנתי` TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE)
-- 175(א)(3): joint holders count as one shareholder and employees are not counted: 40 single holders and 3 joint holdings count 43.
#ASSERT `כמה בעלי מניות נספרים לענין מגבלת החמישים` 40 3 EQUALS 43
#ASSERT `כמה בעלי מניות נספרים לענין מגבלת החמישים` 0 0 EQUALS 0

-- Worked cases for the seat questions of sections 176 to 224 (fragment C). Expected values are written from the text of the section named beside each.
-- The company is given first, by its two facts: the shares (listed or offered to the public, and held by the public) and the bonds (likewise).
-- TRUE FALSE is a public company; FALSE FALSE a private company that is not a bond company; FALSE TRUE a private bond company. Where a question asks five company facts, the other three follow (reporting corporation, public-benefit company, government company).

§§ `מקרים: סעיפים 176 עד 178`

-- 176: a shareholder in a private company is one registered as such in the register of shareholders.
#ASSERT `האם אני בעל מניה בחברה פרטית לפי סעיף 176` FALSE FALSE TRUE
#ASSERT NOT (`האם אני בעל מניה בחברה פרטית לפי סעיף 176` FALSE FALSE FALSE)
#ASSERT NOT (`האם אני בעל מניה בחברה פרטית לפי סעיף 176` TRUE FALSE TRUE)
-- 177: in a public company, a shareholder is one whose share is registered with a bourse member and is among the shares in a registration company's name (1), or one registered in the register (2).
#ASSERT `האם אני בעל מניה בחברה ציבורית לפי סעיף 177` TRUE FALSE TRUE TRUE FALSE
#ASSERT `האם אני בעל מניה בחברה ציבורית לפי סעיף 177` TRUE FALSE FALSE FALSE TRUE
#ASSERT NOT (`האם אני בעל מניה בחברה ציבורית לפי סעיף 177` TRUE FALSE TRUE FALSE FALSE)
#ASSERT NOT (`האם אני בעל מניה בחברה ציבורית לפי סעיף 177` TRUE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`האם אני בעל מניה בחברה ציבורית לפי סעיף 177` FALSE FALSE FALSE FALSE TRUE)
-- 177(1): a person to whose credit a share is registered with a bourse member, where that share is among the shares registered in the name of a registration company.
#ASSERT `האם אני בעל מניה לפי פסקה (1) של סעיף 177` TRUE TRUE
#ASSERT NOT (`האם אני בעל מניה לפי פסקה (1) של סעיף 177` TRUE FALSE)
#ASSERT NOT (`האם אני בעל מניה לפי פסקה (1) של סעיף 177` FALSE TRUE)
-- 178(א): a shareholder registered in the register is entitled to a certificate of his ownership.
#ASSERT `האם אני זכאי לקבל תעודה המעידה על בעלותי במניה לפי סעיף 178(א)` TRUE
#ASSERT NOT (`האם אני זכאי לקבל תעודה המעידה על בעלותי במניה לפי סעיף 178(א)` FALSE)
-- 178(ב): a registration company is entitled to a certificate of the number and class of the shares registered in its name.
#ASSERT `האם אני חברה לרישומים זכאית לקבל תעודה על המניות הרשומות על שמי לפי סעיף 178(ב)` TRUE
#ASSERT NOT (`האם אני חברה לרישומים זכאית לקבל תעודה על המניות הרשומות על שמי לפי סעיף 178(ב)` FALSE)

§§ `מקרים: סעיף 181`

-- 181(א): forfeiture needs a provision in the articles or the allotment agreement and consideration not given on time.
#ASSERT `האם הדירקטוריון רשאי לחלט את המניות שלי לפי סעיף 181(א)` TRUE TRUE
#ASSERT NOT (`האם הדירקטוריון רשאי לחלט את המניות שלי לפי סעיף 181(א)` TRUE FALSE)
#ASSERT NOT (`האם הדירקטוריון רשאי לחלט את המניות שלי לפי סעיף 181(א)` FALSE TRUE)
-- 181(ב): forfeited shares not yet sold are dormant shares.
#ASSERT `האם המניות שחולטו הן מניות רדומות לפי סעיף 181(ב)` TRUE FALSE
#ASSERT NOT (`האם המניות שחולטו הן מניות רדומות לפי סעיף 181(ב)` TRUE TRUE)
#ASSERT NOT (`האם המניות שחולטו הן מניות רדומות לפי סעיף 181(ב)` FALSE FALSE)
-- 181(ג): the debtor continues to owe unless the shares were sold and the company received the full consideration he undertook plus the sale expenses (100 + 10 = 110 here).
#ASSERT NOT (`האם אני ממשיך לחוב לחברה לאחר החילוט לפי סעיף 181(ג)` TRUE 110 100 10)
#ASSERT `האם אני ממשיך לחוב לחברה לאחר החילוט לפי סעיף 181(ג)` TRUE 109 100 10
#ASSERT `האם אני ממשיך לחוב לחברה לאחר החילוט לפי סעיף 181(ג)` FALSE 0 100 0
-- 181(ד): if the proceeds exceeded the consideration undertaken (100), the debtor gets back the partial consideration he gave (30), provided the company keeps at least 100 plus the expenses (10).
-- Proceeds 140: the company holds 30 + 140 = 170, keeps 110, so up to 60 can go back, and the debtor gave only 30: he gets 30.
-- Proceeds 105: the company holds 135, keeps 110, so only 25 can go back.
-- Proceeds 100 do not exceed the undertaking: nothing goes back. Expenses 50 with proceeds 101: the company holds 131 and must keep 150: nothing goes back.
-- A ceiling of 10 in the articles lowers the refund to 10. A debtor who gave no partial consideration gets nothing back.
#ASSERT `כמה אני זכאי לקבל בחזרה לאחר מכירת המניות שחולטו לפי סעיף 181(ד)` 140 100 30 10 FALSE 0 EQUALS 30
#ASSERT `כמה אני זכאי לקבל בחזרה לאחר מכירת המניות שחולטו לפי סעיף 181(ד)` 105 100 30 10 FALSE 0 EQUALS 25
#ASSERT `כמה אני זכאי לקבל בחזרה לאחר מכירת המניות שחולטו לפי סעיף 181(ד)` 100 100 30 10 FALSE 0 EQUALS 0
#ASSERT `כמה אני זכאי לקבל בחזרה לאחר מכירת המניות שחולטו לפי סעיף 181(ד)` 101 100 30 50 FALSE 0 EQUALS 0
#ASSERT `כמה אני זכאי לקבל בחזרה לאחר מכירת המניות שחולטו לפי סעיף 181(ד)` 140 100 30 10 TRUE 10 EQUALS 10
#ASSERT `כמה אני זכאי לקבל בחזרה לאחר מכירת המניות שחולטו לפי סעיף 181(ד)` 140 100 0 10 FALSE 0 EQUALS 0
-- 181(ה): the section does not take away any other remedy of the company against the debtor.
#ASSERT NOT (`האם סעיף החילוט שולל מהחברה סעד אחר כלפי החייב לפי סעיף 181(ה)`)

§§ `מקרים: סעיף 182`

-- 182(א): the shareholders entitled to a dividend are those on the day of the decision, or on a later date if the decision set another date.
#ASSERT `מהו המועד הקובע לזכאות לדיבידנד לפי סעיף 182(א)` (YearMonthDay 2026 3 1) FALSE (YearMonthDay 2026 3 1) EQUALS (JUST (YearMonthDay 2026 3 1))
#ASSERT `מהו המועד הקובע לזכאות לדיבידנד לפי סעיף 182(א)` (YearMonthDay 2026 3 1) TRUE (YearMonthDay 2026 3 15) EQUALS (JUST (YearMonthDay 2026 3 15))
#ASSERT `מהו המועד הקובע לזכאות לדיבידנד לפי סעיף 182(א)` (YearMonthDay 2026 3 1) TRUE (YearMonthDay 2026 3 1) EQUALS (JUST (YearMonthDay 2026 3 1))
-- An earlier date than the decision's is not a date the text provides for: the Law does not say.
#ASSERT `מהו המועד הקובע לזכאות לדיבידנד לפי סעיף 182(א)` (YearMonthDay 2026 3 1) TRUE (YearMonthDay 2026 2 1) EQUALS NOTHING
-- 182(ב): in a public company the record date is not more than 21 days and not less than 4 days before the meeting; both ends are inside; the Minister's other provisions are not among the inputs.
#ASSERT `האם המועד הקובע לאסיפה כללית בחברה ציבורית נקבע כדין לפי סעיף 182(ב)` TRUE FALSE 21 FALSE EQUALS (JUST TRUE)
#ASSERT `האם המועד הקובע לאסיפה כללית בחברה ציבורית נקבע כדין לפי סעיף 182(ב)` TRUE FALSE 4 FALSE EQUALS (JUST TRUE)
#ASSERT `האם המועד הקובע לאסיפה כללית בחברה ציבורית נקבע כדין לפי סעיף 182(ב)` TRUE FALSE 22 FALSE EQUALS (JUST FALSE)
#ASSERT `האם המועד הקובע לאסיפה כללית בחברה ציבורית נקבע כדין לפי סעיף 182(ב)` TRUE FALSE 3 FALSE EQUALS (JUST FALSE)
#ASSERT `האם המועד הקובע לאסיפה כללית בחברה ציבורית נקבע כדין לפי סעיף 182(ב)` FALSE FALSE 10 FALSE EQUALS (JUST FALSE)
#ASSERT `האם המועד הקובע לאסיפה כללית בחברה ציבורית נקבע כדין לפי סעיף 182(ב)` TRUE FALSE 10 TRUE EQUALS NOTHING

§§ `מקרים: סעיף 183`

-- 183: the rights and duties of a shareholder are as this Law, the articles and any law provide; no other source.
#ASSERT `האם המקור קובע זכויות וחובות של בעל מניה לפי סעיף 183` `חוק זה`
#ASSERT `האם המקור קובע זכויות וחובות של בעל מניה לפי סעיף 183` `תקנון החברה כמסמך שבעלי מניות זכאים לעיין בו`
#ASSERT `האם המקור קובע זכויות וחובות של בעל מניה לפי סעיף 183` `כל דין`
#ASSERT NOT (`האם המקור קובע זכויות וחובות של בעל מניה לפי סעיף 183` `מקור אחר`)

§§ `מקרים: סעיפים 184 עד 187`

-- 184: shareholders may inspect minutes of general meetings (1), the registers (2), a document in the company's possession as 185 provides (3), the articles and statements (4), a filed document open to the public (5); nothing else.
