#ASSERT `האם אני פטור מהגשת דרישה לחברה לפי סעיף 194(ד)` 5 2 TRUE
#ASSERT NOT (`האם אני פטור מהגשת דרישה לחברה לפי סעיף 194(ד)` 5 2 FALSE)
#ASSERT NOT (`האם אני פטור מהגשת דרישה לחברה לפי סעיף 194(ד)` 5 0 FALSE)

§§ `מקרים: סעיפים 195 ו־196`

-- 195: the company may act in one of three ways: an act or decision that makes the cause of action fall away; a rejection with reasons in its decision; a decision to file. No other way is provided.
#ASSERT `האם החברה רשאית לנקוט בדרך הזו בתגובה לדרישה לפי סעיף 195` `פעולה או החלטה שהעילה נשמטת בעקבותיה` FALSE
#ASSERT `האם החברה רשאית לנקוט בדרך הזו בתגובה לדרישה לפי סעיף 195` `דחיית הדרישה בנימוקים` TRUE
#ASSERT `האם החברה רשאית לנקוט בדרך הזו בתגובה לדרישה לפי סעיף 195` `החלטה להגיש תביעה` FALSE
#ASSERT NOT (`האם החברה רשאית לנקוט בדרך הזו בתגובה לדרישה לפי סעיף 195` `דחיית הדרישה בנימוקים` FALSE)
#ASSERT NOT (`האם החברה רשאית לנקוט בדרך הזו בתגובה לדרישה לפי סעיף 195` `דרך תגובה אחרת של החברה לדרישה` TRUE)
-- 196: the company answers within forty-five days of receiving the demand (the forty-fifth day is in time: fork F1).
#ASSERT `תוך כמה ימים החברה חייבת למסור לתובע מענה לפי סעיף 196` EQUALS 45
#ASSERT `האם המענה לתובע נמסר במועד לפי סעיף 196` 45
#ASSERT `האם המענה לתובע נמסר במועד לפי סעיף 196` 0
#ASSERT NOT (`האם המענה לתובע נמסר במועד לפי סעיף 196` 46)
-- 196: the answer gives details of the action and the organ, with the names of the participants; a personal interest of a participant or an office-holder is stated in the decision and in the notice.
#ASSERT `האם תוכן המענה לתובע עומד בדרישות לפי סעיף 196` TRUE TRUE FALSE FALSE
#ASSERT `האם תוכן המענה לתובע עומד בדרישות לפי סעיף 196` TRUE TRUE TRUE TRUE
#ASSERT NOT (`האם תוכן המענה לתובע עומד בדרישות לפי סעיף 196` TRUE TRUE TRUE FALSE)
#ASSERT NOT (`האם תוכן המענה לתובע עומד בדרישות לפי סעיף 196` FALSE TRUE FALSE FALSE)
#ASSERT NOT (`האם תוכן המענה לתובע עומד בדרישות לפי סעיף 196` TRUE FALSE FALSE FALSE)

§§ `מקרים: סעיפים 197 ו־198`

-- 197: the plaintiff may file, with the court's approval, if one of five holds: (1) in his opinion the action under 195(1) did not remove the cause; (2) the company rejected the demand; (3) the company said it decided to file but did not within seventy-five days (the seventy-fifth day is in time); (4) the company did not answer as 196 requires; (5) he is exempt from a demand.
-- The arguments: shareholder or director; (1); (2); (3) notified; days since the notice; (4); (5).
#ASSERT `האם אני רשאי להגיש תביעה נגזרת באישור בית המשפט לפי סעיף 197` TRUE TRUE FALSE FALSE 0 FALSE FALSE
#ASSERT `האם אני רשאי להגיש תביעה נגזרת באישור בית המשפט לפי סעיף 197` TRUE FALSE TRUE FALSE 0 FALSE FALSE
#ASSERT `האם אני רשאי להגיש תביעה נגזרת באישור בית המשפט לפי סעיף 197` TRUE FALSE FALSE TRUE 76 FALSE FALSE
#ASSERT `האם אני רשאי להגיש תביעה נגזרת באישור בית המשפט לפי סעיף 197` TRUE FALSE FALSE FALSE 0 TRUE FALSE
#ASSERT `האם אני רשאי להגיש תביעה נגזרת באישור בית המשפט לפי סעיף 197` TRUE FALSE FALSE FALSE 0 FALSE TRUE
#ASSERT NOT (`האם אני רשאי להגיש תביעה נגזרת באישור בית המשפט לפי סעיף 197` TRUE FALSE FALSE TRUE 75 FALSE FALSE)
#ASSERT NOT (`האם אני רשאי להגיש תביעה נגזרת באישור בית המשפט לפי סעיף 197` TRUE FALSE FALSE FALSE 0 FALSE FALSE)
#ASSERT NOT (`האם אני רשאי להגיש תביעה נגזרת באישור בית המשפט לפי סעיף 197` FALSE TRUE TRUE TRUE 100 TRUE TRUE)
#ASSERT `תוך כמה ימים מההודעה על ההחלטה החברה צריכה להגיש תביעה לפי סעיף 197(3)` EQUALS 75
-- 198(א): the court approves the claim if convinced that, prima facie, the claim and its conduct are for the company's benefit and the plaintiff is not acting in bad faith.
#ASSERT `האם בית המשפט יאשר את התביעה הנגזרת לפי סעיף 198(א)` TRUE TRUE
#ASSERT NOT (`האם בית המשפט יאשר את התביעה הנגזרת לפי סעיף 198(א)` TRUE FALSE)
#ASSERT NOT (`האם בית המשפט יאשר את התביעה הנגזרת לפי סעיף 198(א)` FALSE TRUE)
-- 198(ב): the court may approve a claim filed before the dates passed, if it found that not filing then would cause its prescription.
#ASSERT `האם בית המשפט רשאי לאשר תביעה שהוגשה לפני המועדים לפי סעיף 198(ב)` TRUE TRUE
#ASSERT NOT (`האם בית המשפט רשאי לאשר תביעה שהוגשה לפני המועדים לפי סעיף 198(ב)` TRUE FALSE)
#ASSERT NOT (`האם בית המשפט רשאי לאשר תביעה שהוגשה לפני המועדים לפי סעיף 198(ב)` FALSE TRUE)
-- 198א: one entitled to file under 197 may ask the court to order disclosure of documents; the court may approve if the applicant set up a preliminary evidentiary basis.
#ASSERT `האם אני רשאי לבקש מבית המשפט להורות לחברה לגלות מסמכים לפי סעיף 198א(א)` TRUE
#ASSERT NOT (`האם אני רשאי לבקש מבית המשפט להורות לחברה לגלות מסמכים לפי סעיף 198א(א)` FALSE)
#ASSERT `האם בית המשפט רשאי לאשר את בקשת הגילוי לפי סעיף 198א(ב)` TRUE
#ASSERT NOT (`האם בית המשפט רשאי לאשר את בקשת הגילוי לפי סעיף 198א(ב)` FALSE)

§§ `מקרים: סעיפים 199 עד 202`

-- 199(א): the plaintiff pays part of the fee at the rate the Minister set; where it is not supplied the Law does not say. A full fee of 1000 and a quarter: 250.
#ASSERT `כמה אגרה התובע משלם בעת הגשת התביעה הנגזרת לפי סעיף 199(א)` 1000 TRUE 0.25 EQUALS (JUST 250)
#ASSERT `כמה אגרה התובע משלם בעת הגשת התביעה הנגזרת לפי סעיף 199(א)` 1000 FALSE 0.25 EQUALS NOTHING
-- 199(ב): once the court approved the claim, the company refunds the plaintiff's fee and pays the balance; non-payment of the balance does not delay the hearing; the court may order the company to pay the plaintiff's expenses or deposit security (2) and to deposit security for the defendant's expenses (3).
#ASSERT `האם החברה חייבת להשיב לתובע את האגרה ולשלם את יתרתה לפי סעיף 199(ב)` TRUE
#ASSERT NOT (`האם החברה חייבת להשיב לתובע את האגרה ולשלם את יתרתה לפי סעיף 199(ב)` FALSE)
#ASSERT NOT (`האם אי תשלום יתרת האגרה מעכב את הדיון בתביעה לפי סעיף 199(ב)`)
#ASSERT `האם בית המשפט רשאי להורות לחברה לשלם לתובע הוצאות או להפקיד ערובה לפי סעיף 199(ב)(2)` TRUE
#ASSERT NOT (`האם בית המשפט רשאי להורות לחברה לשלם לתובע הוצאות או להפקיד ערובה לפי סעיף 199(ב)(2)` FALSE)
#ASSERT `האם בית המשפט רשאי להטיל על החברה להפקיד ערובה להוצאות הנתבע לפי סעיף 199(ב)(3)` TRUE
#ASSERT NOT (`האם בית המשפט רשאי להטיל על החברה להפקיד ערובה להוצאות הנתבע לפי סעיף 199(ב)(3)` FALSE)
-- 200: the company pays the costs awarded to the defendant, unless the court determined, for special reasons it recorded, that the plaintiff pays; the court may also impose the plaintiff's costs on the company and costs caused to the company on the plaintiff.
#ASSERT `האם החברה משלמת את ההוצאות שנפסקו לטובת הנתבע לפי סעיף 200` FALSE
#ASSERT NOT (`האם החברה משלמת את ההוצאות שנפסקו לטובת הנתבע לפי סעיף 200` TRUE)
#ASSERT `האם בית המשפט רשאי להטיל על החברה את הוצאות התובע לפי סעיף 200`
#ASSERT `האם בית המשפט רשאי להטיל על התובע הוצאות שנגרמו לחברה לפי סעיף 200`
-- 200א(א): the lawyer may not receive more than the court set (10000).
#ASSERT `האם שכר הטרחה שעורך הדין מקבל אינו עולה על שנקבע לפי סעיף 200א(א)` 10000 10000
#ASSERT `האם שכר הטרחה שעורך הדין מקבל אינו עולה על שנקבע לפי סעיף 200א(א)` 10000 9000
#ASSERT NOT (`האם שכר הטרחה שעורך הדין מקבל אינו עולה על שנקבע לפי סעיף 200א(א)` 10000 10001)
-- 200א(ב): the company pays the fee unless the court determined, for special reasons it recorded, that the plaintiff pays.
#ASSERT `האם החברה משלמת את שכר הטרחה של עורך הדין לפי סעיף 200א(ב)` FALSE
#ASSERT NOT (`האם החברה משלמת את שכר הטרחה של עורך הדין לפי סעיף 200א(ב)` TRUE)
-- 201: if the court ruled in the company's favour, it may order a reward to a plaintiff who took trouble to file and prove the claim.
#ASSERT `האם בית המשפט רשאי להורות על תשלום גמול לתובע לפי סעיף 201` TRUE TRUE
#ASSERT NOT (`האם בית המשפט רשאי להורות על תשלום גמול לתובע לפי סעיף 201` TRUE FALSE)
#ASSERT NOT (`האם בית המשפט רשאי להורות על תשלום גמול לתובע לפי סעיף 201` FALSE TRUE)
-- 202(א): no withdrawal or settlement without the court's approval; the request details every term, including any consideration offered the plaintiff.
#ASSERT `האם מותר להסתלק מהתביעה הנגזרת או להגיע להסדר עם הנתבע לפי סעיף 202(א)` TRUE
#ASSERT NOT (`האם מותר להסתלק מהתביעה הנגזרת או להגיע להסדר עם הנתבע לפי סעיף 202(א)` FALSE)
#ASSERT `האם בקשת האישור כוללת את הפרטים הנדרשים לפי סעיף 202(א)` TRUE TRUE
#ASSERT NOT (`האם בקשת האישור כוללת את הפרטים הנדרשים לפי סעיף 202(א)` TRUE FALSE)
#ASSERT NOT (`האם בקשת האישור כוללת את הפרטים הנדרשים לפי סעיף 202(א)` FALSE TRUE)
-- 202(ב): when asked to approve, the court orders a notice published; a shareholder, a director and a creditor under 204 may file an objection.
#ASSERT `האם בית המשפט חייב להורות על פרסום הודעה על פרטי ההסדר לפי סעיף 202(ב)` TRUE
#ASSERT NOT (`האם בית המשפט חייב להורות על פרסום הודעה על פרטי ההסדר לפי סעיף 202(ב)` FALSE)
#ASSERT `האם אני רשאי להגיש התנגדות לאישור ההסדר או הפשרה לפי סעיף 202(ב)` TRUE FALSE FALSE
#ASSERT `האם אני רשאי להגיש התנגדות לאישור ההסדר או הפשרה לפי סעיף 202(ב)` FALSE TRUE FALSE
#ASSERT `האם אני רשאי להגיש התנגדות לאישור ההסדר או הפשרה לפי סעיף 202(ב)` FALSE FALSE TRUE
#ASSERT NOT (`האם אני רשאי להגיש התנגדות לאישור ההסדר או הפשרה לפי סעיף 202(ב)` FALSE FALSE FALSE)

§§ `מקרים: סעיפים 203 עד 206`

-- 203(א): the court may allow a shareholder or director to defend in the company's name if a claim was filed against the company, it is convinced that the defence is for the company's benefit, and the defender is not acting in bad faith.
#ASSERT `האם בית המשפט רשאי להתיר הגנה נגזרת לפי סעיף 203(א)` TRUE TRUE TRUE TRUE
#ASSERT NOT (`האם בית המשפט רשאי להתיר הגנה נגזרת לפי סעיף 203(א)` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`האם בית המשפט רשאי להתיר הגנה נגזרת לפי סעיף 203(א)` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`האם בית המשפט רשאי להתיר הגנה נגזרת לפי סעיף 203(א)` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`האם בית המשפט רשאי להתיר הגנה נגזרת לפי סעיף 203(א)` TRUE TRUE TRUE FALSE)
-- 203(ב): the provisions on the derivative claim apply to a derivative defence, to the extent the Minister did not set provisions.
#ASSERT `האם הוראות התביעה הנגזרת חלות על הגנה נגזרת לפי סעיף 203(ב)` FALSE
#ASSERT NOT (`האם הוראות התביעה הנגזרת חלות על הגנה נגזרת לפי סעיף 203(ב)` TRUE)
-- 204: a creditor may file a derivative claim for a forbidden distribution made in the company; a bondholder in a bond company may file also for failure to comply with 275(ג) and (ד).
-- The arguments after the company: creditor; a forbidden distribution; bondholder; 275(ג) and (ד) not complied with.
#ASSERT `האם נושה רשאי להגיש תביעה נגזרת בשם החברה לפי סעיף 204` FALSE FALSE TRUE TRUE FALSE FALSE
#ASSERT `האם נושה רשאי להגיש תביעה נגזרת בשם החברה לפי סעיף 204` FALSE TRUE TRUE FALSE TRUE TRUE
#ASSERT NOT (`האם נושה רשאי להגיש תביעה נגזרת בשם החברה לפי סעיף 204` FALSE FALSE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`האם נושה רשאי להגיש תביעה נגזרת בשם החברה לפי סעיף 204` FALSE TRUE TRUE FALSE FALSE TRUE)
#ASSERT NOT (`האם נושה רשאי להגיש תביעה נגזרת בשם החברה לפי סעיף 204` FALSE FALSE FALSE TRUE FALSE FALSE)
-- 205: no derivative claim or defence in the name of a company for which a trustee was appointed.
#ASSERT `האם אסור להגיש תביעה נגזרת או הגנה נגזרת בשם החברה לפי סעיף 205` TRUE FALSE
#ASSERT `האם אסור להגיש תביעה נגזרת או הגנה נגזרת בשם החברה לפי סעיף 205` FALSE TRUE
#ASSERT NOT (`האם אסור להגיש תביעה נגזרת או הגנה נגזרת בשם החברה לפי סעיף 205` FALSE FALSE)
-- 205א(א): one who wants to file a claim in the name of a reporting corporation may ask the Securities Authority to participate in his expenses.
#ASSERT `האם אני רשאי לבקש מרשות ניירות ערך להשתתף בהוצאותיי לפי סעיף 205א(א)` TRUE FALSE TRUE FALSE FALSE
#ASSERT NOT (`האם אני רשאי לבקש מרשות ניירות ערך להשתתף בהוצאותיי לפי סעיף 205א(א)` FALSE FALSE FALSE FALSE FALSE)
-- 205א(ב): the Authority may participate if convinced that the claim is of public interest and the court will reasonably approve it; its decision cannot be put before the court as evidence.
#ASSERT `האם הרשות רשאית להשתתף בהוצאות התובע לפי סעיף 205א(ב)` TRUE TRUE
#ASSERT NOT (`האם הרשות רשאית להשתתף בהוצאות התובע לפי סעיף 205א(ב)` TRUE FALSE)
#ASSERT NOT (`האם הרשות רשאית להשתתף בהוצאות התובע לפי סעיף 205א(ב)` FALSE TRUE)
#ASSERT NOT (`האם החלטת הרשות ניתנת להגשה לבית המשפט כראיה לפי סעיף 205א(ב)`)
-- 205א(ג): if the court ruled in the company's favour, it may order the Authority indemnified for its expenses.
#ASSERT `האם בית המשפט רשאי להורות על שיפוי הרשות בשל הוצאותיה לפי סעיף 205א(ג)` TRUE
#ASSERT NOT (`האם בית המשפט רשאי להורות על שיפוי הרשות בשל הוצאותיה לפי סעיף 205א(ג)` FALSE)

§§ `מקרים: סעיפים 219 עד 222`

-- 219(א): a company may fix in its articles the number of directors and their maximum and minimum; the number fits when within the minimum and the maximum, each if fixed.
#ASSERT `האם החברה רשאית לקבוע בתקנונה את מספר הדירקטורים לפי סעיף 219(א)` FALSE FALSE
#ASSERT `האם החברה רשאית לקבוע בתקנונה את מספר הדירקטורים לפי סעיף 219(א)` TRUE FALSE
#ASSERT `האם מספר הדירקטורים תואם את הקבוע בתקנון לפי סעיף 219(א)` 5 TRUE 3 TRUE 7
#ASSERT `האם מספר הדירקטורים תואם את הקבוע בתקנון לפי סעיף 219(א)` 3 TRUE 3 TRUE 7
#ASSERT `האם מספר הדירקטורים תואם את הקבוע בתקנון לפי סעיף 219(א)` 7 TRUE 3 TRUE 7
#ASSERT `האם מספר הדירקטורים תואם את הקבוע בתקנון לפי סעיף 219(א)` 100 FALSE 0 FALSE 0
#ASSERT `האם מספר הדירקטורים תואם את הקבוע בתקנון לפי סעיף 219(א)` 1 FALSE 0 TRUE 4
#ASSERT NOT (`האם מספר הדירקטורים תואם את הקבוע בתקנון לפי סעיף 219(א)` 2 TRUE 3 TRUE 7)
#ASSERT NOT (`האם מספר הדירקטורים תואם את הקבוע בתקנון לפי סעיף 219(א)` 8 TRUE 3 TRUE 7)
#ASSERT NOT (`האם מספר הדירקטורים תואם את הקבוע בתקנון לפי סעיף 219(א)` 5 FALSE 0 TRUE 4)
-- 219(ב): at least one director in a private company that is not a bond company.
#ASSERT `האם בחברה פרטית שאינה חברת איגרות חוב מכהן לפחות דירקטור אחד לפי סעיף 219(ב)` FALSE FALSE 1
#ASSERT NOT (`האם בחברה פרטית שאינה חברת איגרות חוב מכהן לפחות דירקטור אחד לפי סעיף 219(ב)` FALSE FALSE 0)
#ASSERT NOT (`האם בחברה פרטית שאינה חברת איגרות חוב מכהן לפחות דירקטור אחד לפי סעיף 219(ב)` TRUE FALSE 5)
#ASSERT NOT (`האם בחברה פרטית שאינה חברת איגרות חוב מכהן לפחות דירקטור אחד לפי סעיף 219(ב)` FALSE TRUE 5)
-- 219(ג): at least two external directors in a public or bond company, one with accounting and financial expertise and the rest professionally qualified.
-- The arguments after the company: the external directors serving; those with the expertise; the others with professional qualification.
#ASSERT `האם בחברה מכהנים לפחות שני דירקטורים חיצוניים בהרכב הנדרש לפי סעיף 219(ג)` TRUE FALSE 2 1 1
#ASSERT `האם בחברה מכהנים לפחות שני דירקטורים חיצוניים בהרכב הנדרש לפי סעיף 219(ג)` TRUE FALSE 2 2 0
#ASSERT `האם בחברה מכהנים לפחות שני דירקטורים חיצוניים בהרכב הנדרש לפי סעיף 219(ג)` TRUE FALSE 3 1 2
#ASSERT `האם בחברה מכהנים לפחות שני דירקטורים חיצוניים בהרכב הנדרש לפי סעיף 219(ג)` FALSE TRUE 2 2 0
#ASSERT NOT (`האם בחברה מכהנים לפחות שני דירקטורים חיצוניים בהרכב הנדרש לפי סעיף 219(ג)` TRUE FALSE 1 1 0)
#ASSERT NOT (`האם בחברה מכהנים לפחות שני דירקטורים חיצוניים בהרכב הנדרש לפי סעיף 219(ג)` TRUE FALSE 2 0 2)
#ASSERT NOT (`האם בחברה מכהנים לפחות שני דירקטורים חיצוניים בהרכב הנדרש לפי סעיף 219(ג)` TRUE FALSE 3 1 1)
#ASSERT NOT (`האם בחברה מכהנים לפחות שני דירקטורים חיצוניים בהרכב הנדרש לפי סעיף 219(ג)` FALSE FALSE 2 1 1)
-- 219(ד): further directors with the expertise, in the number the board set. The arguments after the company: the additional directors serving; the number the board set.
#ASSERT `האם מכהנים דירקטורים נוספים בעלי מומחיות חשבונאית ופיננסית כפי שקבע הדירקטוריון לפי סעיף 219(ד)` TRUE FALSE 2 2
#ASSERT NOT (`האם מכהנים דירקטורים נוספים בעלי מומחיות חשבונאית ופיננסית כפי שקבע הדירקטוריון לפי סעיף 219(ד)` TRUE FALSE 1 2)
#ASSERT NOT (`האם מכהנים דירקטורים נוספים בעלי מומחיות חשבונאית ופיננסית כפי שקבע הדירקטוריון לפי סעיף 219(ד)` FALSE FALSE 5 2)
-- 220: the first directors are those the founders appointed who gave the declaration of section 8; their term ends with the first annual meeting unless the articles provide otherwise.
#ASSERT `האם אני דירקטור ראשון לפי סעיף 220` TRUE TRUE
#ASSERT NOT (`האם אני דירקטור ראשון לפי סעיף 220` FALSE TRUE)
#ASSERT NOT (`האם אני דירקטור ראשון לפי סעיף 220` TRUE FALSE)
#ASSERT `האם כהונת הדירקטור הראשון הסתיימה לפי סעיף 220` TRUE FALSE EQUALS (JUST TRUE)
#ASSERT `האם כהונת הדירקטור הראשון הסתיימה לפי סעיף 220` FALSE FALSE EQUALS (JUST FALSE)
#ASSERT `האם כהונת הדירקטור הראשון הסתיימה לפי סעיף 220` TRUE TRUE EQUALS NOTHING
-- 221: a director's term begins on the day of his appointment, or on a later day if the articles permit an appointment that begins in the future; otherwise the Law does not provide for a later day.
#ASSERT `מתי מתחילה כהונת הדירקטור לפי סעיף 221` (YearMonthDay 2026 5 1) FALSE (YearMonthDay 2026 5 1) FALSE EQUALS (JUST (YearMonthDay 2026 5 1))
#ASSERT `מתי מתחילה כהונת הדירקטור לפי סעיף 221` (YearMonthDay 2026 5 1) TRUE (YearMonthDay 2026 6 1) TRUE EQUALS (JUST (YearMonthDay 2026 6 1))
#ASSERT `מתי מתחילה כהונת הדירקטור לפי סעיף 221` (YearMonthDay 2026 5 1) TRUE (YearMonthDay 2026 6 1) FALSE EQUALS NOTHING
-- 222: the term of directors appointed by the general meeting ends at the end of the first annual meeting after the appointment, unless the articles provide otherwise.
#ASSERT `האם כהונת דירקטור שמונה בידי האסיפה הכללית הסתיימה לפי סעיף 222` TRUE FALSE EQUALS (JUST TRUE)
#ASSERT `האם כהונת דירקטור שמונה בידי האסיפה הכללית הסתיימה לפי סעיף 222` FALSE FALSE EQUALS (JUST FALSE)
#ASSERT `האם כהונת דירקטור שמונה בידי האסיפה הכללית הסתיימה לפי סעיף 222` TRUE TRUE EQUALS NOTHING

§§ `מקרים: סעיפים 223 ו־224`

-- 223: a company that is not a reporting corporation reports a director's appointment and the end of his term within fourteen days (the fourteenth day is in time: fork F1).
#ASSERT `האם החברה חייבת לדווח לרשם על מינוי דירקטור ועל סיום כהונתו לפי סעיף 223` FALSE FALSE FALSE FALSE FALSE
#ASSERT NOT (`האם החברה חייבת לדווח לרשם על מינוי דירקטור ועל סיום כהונתו לפי סעיף 223` TRUE FALSE TRUE FALSE FALSE)
#ASSERT `תוך כמה ימים החברה חייבת לדווח לרשם על מינוי דירקטור או סיום כהונתו לפי סעיף 223` EQUALS 14
#ASSERT `האם הדיווח לרשם על דירקטור נמסר במועד לפי סעיף 223` 14
#ASSERT `האם הדיווח לרשם על דירקטור נמסר במועד לפי סעיף 223` 0
#ASSERT NOT (`האם הדיווח לרשם על דירקטור נמסר במועד לפי סעיף 223` 15)
-- 224: a company keeps at its registered office a register of the members of the board, and of their alternates if alternates were appointed under 237, open to inspection by any person.
#ASSERT `האם החברה חייבת לנהל מרשם של חברי הדירקטוריון לפי סעיף 224` FALSE FALSE
#ASSERT `האם המרשם כולל גם את חליפי הדירקטורים לפי סעיף 224` TRUE
#ASSERT NOT (`האם המרשם כולל גם את חליפי הדירקטורים לפי סעיף 224` FALSE)
#ASSERT `האם כל אדם רשאי לעיין במרשם הדירקטורים לפי סעיף 224`

§§ `מקרים: סעיפים 224א עד 238`

-- The four kinds of conviction of section 226, under short names for the cases below.
`מקרה 226 - עבירה מהרשימה` MEANS `עבירה מהמפורטות בסעיף 226(א)(1)`
`מקרה 226 - הרשעה בחו״ל` MEANS `הרשעה בבית משפט מחוץ לישראל בעבירות שוחד, מרמה, עבירות מנהלים בתאגיד או ניצול מידע פנים`
`מקרה 226 - עבירה שבית המשפט קבע לגביה שאיני ראוי` MEANS `עבירה שאינה מנויה בסעיף 226(א) שבית המשפט קבע לגביה לפי סעיף 226(א1)`
`מקרה 226 - עבירה אחרת` MEANS `עבירה אחרת`

-- Section 224א. Arguments: shares listed and held by the public; bonds listed and held by the public; I have the qualifications; I can devote the time.
-- A public company or private bond company bars the person who lacks the qualifications or the time.
#ASSERT `האם אני מנוע מלהתמנות ומלכהן כדירקטור מחמת חוסר כישורים או חוסר יכולת להקדיש זמן` TRUE FALSE FALSE TRUE
#ASSERT `האם אני מנוע מלהתמנות ומלכהן כדירקטור מחמת חוסר כישורים או חוסר יכולת להקדיש זמן` TRUE FALSE TRUE FALSE
#ASSERT `האם אני מנוע מלהתמנות ומלכהן כדירקטור מחמת חוסר כישורים או חוסר יכולת להקדיש זמן` FALSE TRUE FALSE FALSE
#ASSERT NOT (`האם אני מנוע מלהתמנות ומלכהן כדירקטור מחמת חוסר כישורים או חוסר יכולת להקדיש זמן` TRUE FALSE TRUE TRUE)
-- Section 224א does not speak of a private company that is not a bond company.
#ASSERT NOT (`האם אני מנוע מלהתמנות ומלכהן כדירקטור מחמת חוסר כישורים או חוסר יכולת להקדיש זמן` FALSE FALSE FALSE FALSE)

-- Section 224ב(א). Arguments: declared qualifications and time; detailed the qualifications; declared that 226 and 227 do not apply; to serve as an independent director; declared the independent director's conditions.
#ASSERT `האם ההצהרה שלי כמועמד לדירקטור כוללת את כל הנדרש` TRUE TRUE TRUE FALSE FALSE
#ASSERT NOT (`האם ההצהרה שלי כמועמד לדירקטור כוללת את כל הנדרש` TRUE FALSE TRUE FALSE FALSE)
#ASSERT NOT (`האם ההצהרה שלי כמועמד לדירקטור כוללת את כל הנדרש` FALSE TRUE TRUE FALSE FALSE)
#ASSERT NOT (`האם ההצהרה שלי כמועמד לדירקטור כוללת את כל הנדרש` TRUE TRUE FALSE FALSE FALSE)
-- For an independent director the declaration must also cover paragraphs (1) and (2) of the definition.
#ASSERT NOT (`האם ההצהרה שלי כמועמד לדירקטור כוללת את כל הנדרש` TRUE TRUE TRUE TRUE FALSE)
#ASSERT `האם ההצהרה שלי כמועמד לדירקטור כוללת את כל הנדרש` TRUE TRUE TRUE TRUE TRUE
-- Section 224ב(א). Arguments: shares; bonds; then the five facts of the declaration, as above.
#ASSERT `האם החברה שלי רשאית לזמן אסיפה כללית למינוי דירקטור ולמנות דירקטור לאחר ההצהרה` TRUE FALSE TRUE TRUE TRUE FALSE FALSE
#ASSERT NOT (`האם החברה שלי רשאית לזמן אסיפה כללית למינוי דירקטור ולמנות דירקטור לאחר ההצהרה` TRUE FALSE TRUE FALSE TRUE FALSE FALSE)
#ASSERT NOT (`האם החברה שלי רשאית לזמן אסיפה כללית למינוי דירקטור ולמנות דירקטור לאחר ההצהרה` FALSE TRUE TRUE FALSE TRUE FALSE FALSE)
-- A private company that is not a bond company is not bound by the declaration requirement.
#ASSERT `האם החברה שלי רשאית לזמן אסיפה כללית למינוי דירקטור ולמנות דירקטור לאחר ההצהרה` FALSE FALSE FALSE FALSE FALSE FALSE FALSE
-- Section 224ב(ב): the declaration goes to the appointer and is open to inspection by any person at the registered office.
#ASSERT `האם ההצהרה של המועמד תובא בפני הממנה`
#ASSERT `האם כל אדם רשאי לעיין בהצהרת מועמד לדירקטור במשרד הרשום`

-- Section 225(א)(1) and (2). Arguments: first-instance judgment; kind; years since the judgment; the court determined under 226(ב); its years; the court found unfitness under 226(א1); its years; a stay is in force.
-- A conviction of a listed offence two years ago: the five years have not passed.
#ASSERT `האם עלי לגלות לממנה הרשעה שתקופת המגבלה בגינה טרם חלפה` TRUE `מקרה 226 - עבירה מהרשימה` 2 FALSE 0 FALSE 0 FALSE
-- Five years have passed: no duty (boundary, fork F1).
#ASSERT NOT (`האם עלי לגלות לממנה הרשעה שתקופת המגבלה בגינה טרם חלפה` TRUE `מקרה 226 - עבירה מהרשימה` 5 FALSE 0 FALSE 0 FALSE)
#ASSERT `האם עלי לגלות לממנה הרשעה שתקופת המגבלה בגינה טרם חלפה` TRUE `מקרה 226 - עבירה מהרשימה` 4.9 FALSE 0 FALSE 0 FALSE
-- The court shortened the bar to one year: two years have passed.
#ASSERT NOT (`האם עלי לגלות לממנה הרשעה שתקופת המגבלה בגינה טרם חלפה` TRUE `מקרה 226 - עבירה מהרשימה` 2 TRUE 1 FALSE 0 FALSE)
-- The court found me unfit for three years: two years have passed, three have not.
#ASSERT `האם עלי לגלות לממנה הרשעה שתקופת המגבלה בגינה טרם חלפה` TRUE `מקרה 226 - עבירה שבית המשפט קבע לגביה שאיני ראוי` 2 FALSE 0 TRUE 3 FALSE
#ASSERT NOT (`האם עלי לגלות לממנה הרשעה שתקופת המגבלה בגינה טרם חלפה` TRUE `מקרה 226 - עבירה שבית המשפט קבע לגביה שאיני ראוי` 3 FALSE 0 TRUE 3 FALSE)
-- An offence of neither kind, and a conviction that stands only on appeal, give no duty.
#ASSERT NOT (`האם עלי לגלות לממנה הרשעה שתקופת המגבלה בגינה טרם חלפה` TRUE `מקרה 226 - עבירה אחרת` 1 FALSE 0 FALSE 0 FALSE)
#ASSERT NOT (`האם עלי לגלות לממנה הרשעה שתקופת המגבלה בגינה טרם חלפה` FALSE `מקרה 226 - עבירה מהרשימה` 1 FALSE 0 FALSE 0 FALSE)
-- Section 225(א)(3). Arguments: imposed by the committee; bars every public company; bars every private bond company; the period has not passed.
#ASSERT `האם עלי לגלות לממנה אמצעי אכיפה שהוטל עלי ותקופתו טרם חלפה` TRUE TRUE FALSE TRUE
#ASSERT `האם עלי לגלות לממנה אמצעי אכיפה שהוטל עלי ותקופתו טרם חלפה` TRUE FALSE TRUE TRUE
#ASSERT NOT (`האם עלי לגלות לממנה אמצעי אכיפה שהוטל עלי ותקופתו טרם חלפה` TRUE FALSE FALSE TRUE)
#ASSERT NOT (`האם עלי לגלות לממנה אמצעי אכיפה שהוטל עלי ותקופתו טרם חלפה` TRUE TRUE FALSE FALSE)
#ASSERT NOT (`האם עלי לגלות לממנה אמצעי אכיפה שהוטל עלי ותקופתו טרם חלפה` FALSE TRUE TRUE TRUE)
-- Section 225(א), together. Arguments: the eight conviction facts, then the four enforcement facts.
#ASSERT `האם עלי לגלות לממנה הרשעה או אמצעי אכיפה` TRUE `מקרה 226 - עבירה מהרשימה` 2 FALSE 0 FALSE 0 FALSE FALSE FALSE FALSE FALSE
#ASSERT `האם עלי לגלות לממנה הרשעה או אמצעי אכיפה` TRUE `מקרה 226 - עבירה אחרת` 2 FALSE 0 FALSE 0 FALSE TRUE TRUE FALSE TRUE
#ASSERT NOT (`האם עלי לגלות לממנה הרשעה או אמצעי אכיפה` TRUE `מקרה 226 - עבירה אחרת` 2 FALSE 0 FALSE 0 FALSE FALSE FALSE FALSE FALSE)

-- Section 226(א): the listed offences and the conviction abroad; not the unlisted offence found unfit, nor another offence, nor a conviction on appeal only.
#ASSERT `האם ההרשעה שלי היא בעבירה מהסוג המנוי בסעיף 226(א)` TRUE `מקרה 226 - עבירה מהרשימה` 2 FALSE 0 FALSE 0 FALSE
#ASSERT `האם ההרשעה שלי היא בעבירה מהסוג המנוי בסעיף 226(א)` TRUE `מקרה 226 - הרשעה בחו״ל` 2 FALSE 0 FALSE 0 FALSE
#ASSERT NOT (`האם ההרשעה שלי היא בעבירה מהסוג המנוי בסעיף 226(א)` TRUE `מקרה 226 - עבירה שבית המשפט קבע לגביה שאיני ראוי` 2 FALSE 0 TRUE 3 FALSE)
#ASSERT NOT (`האם ההרשעה שלי היא בעבירה מהסוג המנוי בסעיף 226(א)` TRUE `מקרה 226 - עבירה אחרת` 2 FALSE 0 FALSE 0 FALSE)
#ASSERT NOT (`האם ההרשעה שלי היא בעבירה מהסוג המנוי בסעיף 226(א)` FALSE `מקרה 226 - עבירה מהרשימה` 2 FALSE 0 FALSE 0 FALSE)
-- Section 226(א1): an unlisted offence for which the court found me unfit and set a period.
#ASSERT `האם ההרשעה שלי היא בעבירה שבית המשפט קבע לגביה שאיני ראוי לשמש דירקטור` TRUE `מקרה 226 - עבירה שבית המשפט קבע לגביה שאיני ראוי` 2 FALSE 0 TRUE 3 FALSE
#ASSERT NOT (`האם ההרשעה שלי היא בעבירה שבית המשפט קבע לגביה שאיני ראוי לשמש דירקטור` TRUE `מקרה 226 - עבירה שבית המשפט קבע לגביה שאיני ראוי` 2 FALSE 0 FALSE 0 FALSE)
#ASSERT NOT (`האם ההרשעה שלי היא בעבירה שבית המשפט קבע לגביה שאיני ראוי לשמש דירקטור` TRUE `מקרה 226 - עבירה מהרשימה` 2 FALSE 0 FALSE 0 FALSE)
-- Section 226(א): five years at most; 226(א1) and (ב): a period the court names counts up to five years.
#ASSERT `כמה שנים לכל היותר מונעת הרשעה בעבירה מהרשימה את מינוי הדירקטור` EQUALS 5
#ASSERT `לכמה שנים נחשבת תקופה שקבע בית המשפט לפי סעיף 226(א1) או (ב)` 3 EQUALS 3
#ASSERT `לכמה שנים נחשבת תקופה שקבע בית המשפט לפי סעיף 226(א1) או (ב)` 5 EQUALS 5
#ASSERT `לכמה שנים נחשבת תקופה שקבע בית המשפט לפי סעיף 226(א1) או (ב)` 7 EQUALS 5
-- The number of years my conviction bars my appointment.
#ASSERT `כמה שנים מונעת ההרשעה שלי את מינויי לדירקטור` TRUE `מקרה 226 - עבירה מהרשימה` 2 FALSE 0 FALSE 0 FALSE EQUALS (JUST 5)
#ASSERT `כמה שנים מונעת ההרשעה שלי את מינויי לדירקטור` TRUE `מקרה 226 - עבירה מהרשימה` 2 TRUE 1 FALSE 0 FALSE EQUALS (JUST 1)
#ASSERT `כמה שנים מונעת ההרשעה שלי את מינויי לדירקטור` TRUE `מקרה 226 - עבירה מהרשימה` 2 TRUE 0 FALSE 0 FALSE EQUALS (JUST 0)
#ASSERT `כמה שנים מונעת ההרשעה שלי את מינויי לדירקטור` TRUE `מקרה 226 - עבירה מהרשימה` 2 TRUE 7 FALSE 0 FALSE EQUALS (JUST 5)
#ASSERT `כמה שנים מונעת ההרשעה שלי את מינויי לדירקטור` TRUE `מקרה 226 - עבירה שבית המשפט קבע לגביה שאיני ראוי` 2 FALSE 0 TRUE 3 FALSE EQUALS (JUST 3)
#ASSERT `כמה שנים מונעת ההרשעה שלי את מינויי לדירקטור` TRUE `מקרה 226 - עבירה שבית המשפט קבע לגביה שאיני ראוי` 2 FALSE 0 TRUE 9 FALSE EQUALS (JUST 5)
-- Section 226(ב) speaks of offences under (א) only: for an offence the court found under (א1) the period it set governs, even if a 226(ב) determination is also recorded.
#ASSERT `כמה שנים מונעת ההרשעה שלי את מינויי לדירקטור` TRUE `מקרה 226 - עבירה שבית המשפט קבע לגביה שאיני ראוי` 2 TRUE 1 TRUE 3 FALSE EQUALS (JUST 3)
-- Not covered: an unlisted offence without a finding, and another offence, have no bar under 226.
#ASSERT `כמה שנים מונעת ההרשעה שלי את מינויי לדירקטור` TRUE `מקרה 226 - עבירה שבית המשפט קבע לגביה שאיני ראוי` 2 FALSE 0 FALSE 0 FALSE EQUALS NOTHING
#ASSERT `כמה שנים מונעת ההרשעה שלי את מינויי לדירקטור` TRUE `מקרה 226 - עבירה אחרת` 2 FALSE 0 FALSE 0 FALSE EQUALS NOTHING
-- Whether the bar has not yet passed.
#ASSERT `האם תקופת המגבלה בגין ההרשעה שלי טרם חלפה` TRUE `מקרה 226 - עבירה מהרשימה` 4.9 FALSE 0 FALSE 0 FALSE
#ASSERT NOT (`האם תקופת המגבלה בגין ההרשעה שלי טרם חלפה` TRUE `מקרה 226 - עבירה מהרשימה` 5 FALSE 0 FALSE 0 FALSE)
#ASSERT NOT (`האם תקופת המגבלה בגין ההרשעה שלי טרם חלפה` TRUE `מקרה 226 - עבירה מהרשימה` 2 TRUE 1 FALSE 0 FALSE)
-- Section 226(ד): a stay in force lifts the bar for the time being.
#ASSERT `האם ההרשעה שלי עדיין מונעת את מינויי לדירקטור` TRUE `מקרה 226 - עבירה מהרשימה` 2 FALSE 0 FALSE 0 FALSE
#ASSERT NOT (`האם ההרשעה שלי עדיין מונעת את מינויי לדירקטור` TRUE `מקרה 226 - עבירה מהרשימה` 2 FALSE 0 FALSE 0 TRUE)
-- Section 226: the bar by company. Arguments: shares; bonds; then the eight conviction facts.
#ASSERT `האם אני מנוע מלהתמנות כדירקטור בחברה ציבורית או בחברת איגרות חוב מחמת הרשעה` TRUE FALSE TRUE `מקרה 226 - עבירה מהרשימה` 2 FALSE 0 FALSE 0 FALSE
#ASSERT `האם אני מנוע מלהתמנות כדירקטור בחברה ציבורית או בחברת איגרות חוב מחמת הרשעה` FALSE TRUE TRUE `מקרה 226 - הרשעה בחו״ל` 1 FALSE 0 FALSE 0 FALSE
#ASSERT NOT (`האם אני מנוע מלהתמנות כדירקטור בחברה ציבורית או בחברת איגרות חוב מחמת הרשעה` FALSE FALSE TRUE `מקרה 226 - עבירה מהרשימה` 2 FALSE 0 FALSE 0 FALSE)
#ASSERT NOT (`האם אני מנוע מלהתמנות כדירקטור בחברה ציבורית או בחברת איגרות חוב מחמת הרשעה` TRUE FALSE TRUE `מקרה 226 - עבירה מהרשימה` 6 FALSE 0 FALSE 0 FALSE)
-- Section 226א. Arguments: imposed by the committee; bars the company asked about; the period has not passed.
#ASSERT `האם אני מנוע מלהתמנות כדירקטור בחברה מחמת אמצעי אכיפה` TRUE TRUE TRUE
#ASSERT NOT (`האם אני מנוע מלהתמנות כדירקטור בחברה מחמת אמצעי אכיפה` TRUE FALSE TRUE)
