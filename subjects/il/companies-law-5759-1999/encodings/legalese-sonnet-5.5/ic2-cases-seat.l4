#ASSERT NOT (`האם מכהנים בחברה שלי די דירקטורים חיצוניים` FALSE TRUE 0)
#ASSERT `האם מכהנים בחברה שלי די דירקטורים חיצוניים` FALSE FALSE 0
-- 239(ב): the external directors of a public company are appointed by the general meeting if the majority includes a majority of the disinterested non-controlling shareholders (with section 276 observed), or those shareholders' opposition is at most 2% of all voting rights.
-- Arguments after the company: majority in the meeting; votes for; votes against (both of the disinterested non-controlling shareholders); all voting rights; section 276 observed.
#ASSERT `האם הדירקטורים החיצוניים בחברה הציבורית שלי מונו כדין בידי האסיפה הכללית` TRUE FALSE TRUE 60 20 1000 TRUE
#ASSERT `האם הדירקטורים החיצוניים בחברה הציבורית שלי מונו כדין בידי האסיפה הכללית` TRUE FALSE TRUE 41 40 1000 TRUE
#ASSERT NOT (`האם הדירקטורים החיצוניים בחברה הציבורית שלי מונו כדין בידי האסיפה הכללית` TRUE FALSE TRUE 40 40 1000 FALSE)
-- Route (2) alone: the meeting passed the resolution, but the disinterested shareholders did not carry it (10 for, 20 against); 20 against of 1000 voting rights is exactly 2%, which does not exceed 2%.
#ASSERT `האם הדירקטורים החיצוניים בחברה הציבורית שלי מונו כדין בידי האסיפה הכללית` TRUE FALSE TRUE 10 20 1000 TRUE
#ASSERT NOT (`האם הדירקטורים החיצוניים בחברה הציבורית שלי מונו כדין בידי האסיפה הכללית` TRUE FALSE TRUE 10 21 1000 TRUE)
-- Either route needs the meeting to have passed the resolution: the meeting is what appoints.
#ASSERT NOT (`האם הדירקטורים החיצוניים בחברה הציבורית שלי מונו כדין בידי האסיפה הכללית` TRUE FALSE FALSE 10 20 1000 TRUE)
#ASSERT NOT (`האם הדירקטורים החיצוניים בחברה הציבורית שלי מונו כדין בידי האסיפה הכללית` TRUE FALSE FALSE 60 20 1000 TRUE)
#ASSERT NOT (`האם הדירקטורים החיצוניים בחברה הציבורית שלי מונו כדין בידי האסיפה הכללית` TRUE FALSE TRUE 30 50 1000 TRUE)
-- Route (1) needs section 276 observed; route (2) does not.
#ASSERT NOT (`האם הדירקטורים החיצוניים בחברה הציבורית שלי מונו כדין בידי האסיפה הכללית` TRUE FALSE TRUE 60 50 1000 FALSE)
#ASSERT `האם הדירקטורים החיצוניים בחברה הציבורית שלי מונו כדין בידי האסיפה הכללית` TRUE FALSE TRUE 60 20 1000 FALSE
-- The paragraph is for a public company only.
#ASSERT NOT (`האם הדירקטורים החיצוניים בחברה הציבורית שלי מונו כדין בידי האסיפה הכללית` FALSE FALSE TRUE 60 20 1000 TRUE)
-- 239(ב)(1) alone. Arguments: majority in the meeting; votes for; votes against; all voting rights; section 276 observed.
#ASSERT `האם הרוב במינוי דירקטורים חיצוניים כולל רוב מקרב בעלי המניות שאינם בעלי שליטה ושאינם בעלי עניין אישי` TRUE 60 20 1000 TRUE
#ASSERT NOT (`האם הרוב במינוי דירקטורים חיצוניים כולל רוב מקרב בעלי המניות שאינם בעלי שליטה ושאינם בעלי עניין אישי` TRUE 40 40 1000 TRUE)
