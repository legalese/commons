#ASSERT `האם אפשר למנות דירקטור חיצוני בחברת איגרות החוב הפרטית שלי` FALSE TRUE TRUE TRUE
#ASSERT NOT (`האם אפשר למנות דירקטור חיצוני בחברת איגרות החוב הפרטית שלי` FALSE TRUE FALSE TRUE)
