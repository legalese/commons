#ASSERT NOT (`האם אני זכאי לעיין בדוחות הכספיים השמורים במשרד הרשום` FALSE FALSE)
-- 173(ד): a shareholder in a company that is not a reporting corporation is entitled to a copy of the statements and the auditor's opinion. The arguments: the five company facts; I am a shareholder.
#ASSERT `האם בעל מניה זכאי לקבל העתק מהדוחות ומחוות דעת רואה החשבון` FALSE FALSE FALSE FALSE FALSE TRUE
#ASSERT NOT (`האם בעל מניה זכאי לקבל העתק מהדוחות ומחוות דעת רואה החשבון` FALSE FALSE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`האם בעל מניה זכאי לקבל העתק מהדוחות ומחוות דעת רואה החשבון` TRUE FALSE TRUE FALSE FALSE TRUE)
