#ASSERT NOT (`האם הדרישה שלי לחברה כשרה לפי סעיף 194(ב) ו־(ג)` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`האם הדרישה שלי לחברה כשרה לפי סעיף 194(ב) ו־(ג)` TRUE FALSE TRUE TRUE)
