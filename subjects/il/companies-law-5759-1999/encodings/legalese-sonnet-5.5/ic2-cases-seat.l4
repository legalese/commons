§§ `מקרים: סעיפים 191 ו־192`

-- 191(א): where a matter has been conducted oppressively, or there is a substantial concern it will be, the court may on a shareholder's request give directions.
#ASSERT `האם בית המשפט רשאי לתת הוראות להסרת קיפוח או למניעתו לפי סעיף 191(א)` TRUE FALSE TRUE
#ASSERT `האם בית המשפט רשאי לתת הוראות להסרת קיפוח או למניעתו לפי סעיף 191(א)` FALSE TRUE TRUE
#ASSERT NOT (`האם בית המשפט רשאי לתת הוראות להסרת קיפוח או למניעתו לפי סעיף 191(א)` FALSE FALSE TRUE)
#ASSERT NOT (`האם בית המשפט רשאי לתת הוראות להסרת קיפוח או למניעתו לפי סעיף 191(א)` TRUE FALSE FALSE)
-- 191(ב): once the court so directed, the changes are treated as duly adopted; a copy goes to the Registrar and, in a public company, to the Securities Authority.
#ASSERT `האם השינויים שבית המשפט הורה עליהם יראו כאילו נתקבלו כדין לפי סעיף 191(ב)` TRUE
#ASSERT NOT (`האם השינויים שבית המשפט הורה עליהם יראו כאילו נתקבלו כדין לפי סעיף 191(ב)` FALSE)
#ASSERT `האם יש לשלוח עותק מהחלטת בית המשפט לרשם לפי סעיף 191(ב)` TRUE
#ASSERT NOT (`האם יש לשלוח עותק מהחלטת בית המשפט לרשם לפי סעיף 191(ב)` FALSE)
#ASSERT `האם יש לשלוח עותק מהחלטת בית המשפט לרשות ניירות ערך לפי סעיף 191(ב)` TRUE FALSE TRUE
#ASSERT NOT (`האם יש לשלוח עותק מהחלטת בית המשפט לרשות ניירות ערך לפי סעיף 191(ב)` FALSE FALSE TRUE)
#ASSERT NOT (`האם יש לשלוח עותק מהחלטת בית המשפט לרשות ניירות ערך לפי סעיף 191(ב)` TRUE FALSE FALSE)
-- 192(א): a shareholder acts in good faith and in the customary manner and refrains from abusing his power; the matters (1) to (4) are named, others are not named but the duty is general.
#ASSERT `האם אני בעל מניה חייב לנהוג בתום לב ובדרך מקובלת לפי סעיף 192(א)` TRUE
#ASSERT NOT (`האם אני בעל מניה חייב לנהוג בתום לב ובדרך מקובלת לפי סעיף 192(א)` FALSE)
#ASSERT `האם הענין שבו אני מצביע מנוי במפורש לפי סעיף 192(א)` `שינוי התקנון`
#ASSERT `האם הענין שבו אני מצביע מנוי במפורש לפי סעיף 192(א)` `הגדלת ההון הרשום`
#ASSERT `האם הענין שבו אני מצביע מנוי במפורש לפי סעיף 192(א)` `מיזוג כענין שבו מצביע בעל המניה`
#ASSERT `האם הענין שבו אני מצביע מנוי במפורש לפי סעיף 192(א)` `אישור פעולות ועסקאות הטעונות אישור האסיפה הכללית`
#ASSERT NOT (`האם הענין שבו אני מצביע מנוי במפורש לפי סעיף 192(א)` `ענין אחר שבו מצביע בעל המניה`)
-- 192(ב): a shareholder refrains from oppressing other shareholders.
#ASSERT `האם אני בעל מניה חייב להימנע מלקפח בעלי מניות אחרים לפי סעיף 192(ב)` TRUE
#ASSERT NOT (`האם אני בעל מניה חייב להימנע מלקפח בעלי מניות אחרים לפי סעיף 192(ב)` FALSE)
-- 192(ג): on a breach of (א) or (ב) the law on breach of contract applies; on a breach of (ב), section 191 applies too.
#ASSERT `האם דיני הפרת חוזה חלים על הפרת חובת בעל מניה לפי סעיף 192(ג)` TRUE FALSE
#ASSERT `האם דיני הפרת חוזה חלים על הפרת חובת בעל מניה לפי סעיף 192(ג)` FALSE TRUE
#ASSERT NOT (`האם דיני הפרת חוזה חלים על הפרת חובת בעל מניה לפי סעיף 192(ג)` FALSE FALSE)
#ASSERT `האם סעיף 191 חל גם על הפרת סעיף 192(ב) לפי סעיף 192(ג)` TRUE
#ASSERT NOT (`האם סעיף 191 חל גם על הפרת סעיף 192(ב) לפי סעיף 192(ג)` FALSE)

§§ `מקרים: סעיף 193`

-- 193(א): the duty of fairness lies on the controlling shareholder (1), a shareholder who knows his vote will decide a resolution (2), and one with a power under the articles to appoint or prevent the appointment of an office-holder, or another power (3).
#ASSERT `האם אני חייב לפעול בהגינות כלפי החברה לפי סעיף 193(א)` TRUE FALSE FALSE
#ASSERT `האם אני חייב לפעול בהגינות כלפי החברה לפי סעיף 193(א)` FALSE TRUE FALSE
