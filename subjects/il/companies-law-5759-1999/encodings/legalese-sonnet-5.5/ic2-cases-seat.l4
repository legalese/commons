-- ic2-cases-seat: worked cases for ic2-seat.l4, at least one per question, in the order of the questions.
-- Every expected value is written by hand from the text of the section named beside it, never copied from the code's output.
-- Each case states the facts a person in the seat would state, in the order of the question's inputs (the comment above the group
-- names them); a TRUE and a FALSE case are given where the rule has both, and a threshold is tried on each side of its boundary.
-- Where the Law does not answer, the question returns NOTHING and the case asserts it.

§ `מקרים: חוק החברות – השאלות של מי שמקים, מנהל או מחזיק מניות בחברה`

§§ `מקרים: סעיף 119 – מינוי המנהל הכללי`

-- The company inputs of a question that takes %%C2%% are, in order: the shares are listed or offered and held by the public; the bonds are.
-- A public company is `TRUE FALSE`; a private bond company `FALSE TRUE`; an ordinary private company `FALSE FALSE`.
-- 119(a): a public company or a private bond company appoints a general manager.
#ASSERT `האם החברה שלי חייבת למנות מנהל כללי` TRUE FALSE
#ASSERT `האם החברה שלי חייבת למנות מנהל כללי` FALSE TRUE
#ASSERT `האם החברה שלי חייבת למנות מנהל כללי` TRUE TRUE
#ASSERT NOT (`האם החברה שלי חייבת למנות מנהל כללי` FALSE FALSE)
-- 119(a), (b): more than one general manager may be appointed: by a public company, a private bond company ((a)) and any other private company ("one or more", (b)).
#ASSERT `האם החברה שלי רשאית למנות יותר ממנהל כללי אחד` TRUE FALSE
#ASSERT `האם החברה שלי רשאית למנות יותר ממנהל כללי אחד` FALSE TRUE
#ASSERT `האם החברה שלי רשאית למנות יותר ממנהל כללי אחד` FALSE FALSE
-- 119(b): only a private company that is not a bond company may appoint no general manager.
#ASSERT `האם החברה שלי רשאית שלא למנות מנהל כללי כלל` FALSE FALSE
#ASSERT NOT (`האם החברה שלי רשאית שלא למנות מנהל כללי כלל` TRUE FALSE)
#ASSERT NOT (`האם החברה שלי רשאית שלא למנות מנהל כללי כלל` FALSE TRUE)
-- 119(b): with no general manager, the board manages the company (an ordinary private company); nothing is said for a company that must appoint one, or when one was appointed.
#ASSERT `מי מנהל את החברה שלי כשלא מונה בה מנהל כללי` FALSE FALSE FALSE EQUALS (JUST `הדירקטוריון`)
#ASSERT `מי מנהל את החברה שלי כשלא מונה בה מנהל כללי` FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `מי מנהל את החברה שלי כשלא מונה בה מנהל כללי` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `מי מנהל את החברה שלי כשלא מונה בה מנהל כללי` FALSE TRUE FALSE EQUALS NOTHING

§§ `מקרים: סעיף 120 – אחריות המנהל הכללי`

-- 120: the general manager is responsible for the current management of the company's affairs.
#ASSERT `האם המנהל הכללי אחראי לענין הזה` TRUE
#ASSERT NOT (`האם המנהל הכללי אחראי לענין הזה` FALSE)
-- 120: within the policy the board set, and subject to its guidelines. The inputs are: within the policy; in accordance with the guidelines.
#ASSERT `האם הניהול השוטף שאני עושה כמנהל כללי נעשה כנדרש` TRUE TRUE
#ASSERT NOT (`האם הניהול השוטף שאני עושה כמנהל כללי נעשה כנדרש` TRUE FALSE)
#ASSERT NOT (`האם הניהול השוטף שאני עושה כמנהל כללי נעשה כנדרש` FALSE TRUE)

§§ `מקרים: סעיף 121 – סמכויות המנהל הכללי`

-- 121(a): every power of management and execution that neither the Law nor the articles gave to another organ. The inputs are: a power of management or execution; the Law gave it elsewhere; the articles gave it elsewhere.
#ASSERT `האם הסמכות הזו נתונה למנהל הכללי של החברה שלי` TRUE FALSE FALSE
#ASSERT NOT (`האם הסמכות הזו נתונה למנהל הכללי של החברה שלי` TRUE TRUE FALSE)
#ASSERT NOT (`האם הסמכות הזו נתונה למנהל הכללי של החברה שלי` TRUE FALSE TRUE)
#ASSERT NOT (`האם הסמכות הזו נתונה למנהל הכללי של החברה שלי` FALSE FALSE FALSE)
-- 121(a): the general manager is subject to the supervision of the board.
#ASSERT `מי מפקח על המנהל הכללי של החברה שלי` EQUALS `הדירקטוריון`
-- 121(b): with the board's approval, to someone subordinate to him. The inputs are: the board approved; the delegate is subordinate.
#ASSERT `האם אני כמנהל כללי רשאי לאצול מסמכויותיי לאדם אחר` TRUE TRUE
#ASSERT NOT (`האם אני כמנהל כללי רשאי לאצול מסמכויותיי לאדם אחר` TRUE FALSE)
#ASSERT NOT (`האם אני כמנהל כללי רשאי לאצול מסמכויותיי לאדם אחר` FALSE TRUE)
-- 121(c): the general meeting of a public company. The inputs after the company are: the resolution passed by a majority at the meeting; votes for, against and abstaining of the non-controlling, non-interested shareholders; all voting rights; section 276 observed.
-- Alternative (1) holds: 600 for, 100 against of 700 counted (abstentions of 50 are set aside); all rights 10000.
#ASSERT `האם האסיפה הכללית של החברה שלי רשאית להחליט על הסמכה כפולה` TRUE FALSE TRUE 600 100 50 10000 TRUE
-- Alternative (2) alone holds: 100 for, 150 against is no majority of the counted, but 150 is 1.5% of 10000, not above 2%.
#ASSERT `האם האסיפה הכללית של החברה שלי רשאית להחליט על הסמכה כפולה` TRUE FALSE TRUE 100 150 0 10000 TRUE
-- Boundary of (2): 200 against is exactly 2% of 10000, which does not exceed 2%.
#ASSERT `האם האסיפה הכללית של החברה שלי רשאית להחליט על הסמכה כפולה` TRUE FALSE TRUE 100 200 0 10000 TRUE
-- 201 against is above 2% and 100 of 301 is no majority: neither alternative holds.
#ASSERT NOT (`האם האסיפה הכללית של החברה שלי רשאית להחליט על הסמכה כפולה` TRUE FALSE TRUE 100 201 0 10000 TRUE)
-- Neither: 100 for, 300 against.
#ASSERT NOT (`האם האסיפה הכללית של החברה שלי רשאית להחליט על הסמכה כפולה` TRUE FALSE TRUE 100 300 0 10000 TRUE)
-- (1) needs section 276 observed: 600 for, 300 against (3% opposed, so (2) fails) and 276 not observed.
#ASSERT NOT (`האם האסיפה הכללית של החברה שלי רשאית להחליט על הסמכה כפולה` TRUE FALSE TRUE 600 300 0 10000 FALSE)
-- The power is the general meeting of a PUBLIC company: a private company, even with perfect votes, does not have it.
#ASSERT NOT (`האם האסיפה הכללית של החברה שלי רשאית להחליט על הסמכה כפולה` FALSE FALSE TRUE 600 100 50 10000 TRUE)
#ASSERT NOT (`האם האסיפה הכללית של החברה שלי רשאית להחליט על הסמכה כפולה` FALSE TRUE TRUE 600 100 50 10000 TRUE)
-- 121(c)(1) alone. The inputs are: majority at the meeting; votes for, against, abstaining; all voting rights; section 276 observed.
#ASSERT `האם הרוב באסיפה הכללית כולל רוב מקרב בעלי המניות שאינם בעלי שליטה ושאינם בעלי עניין אישי` TRUE 600 100 50 10000 TRUE
-- 351 for and 350 against: 351 is more than half of 701.
#ASSERT `האם הרוב באסיפה הכללית כולל רוב מקרב בעלי המניות שאינם בעלי שליטה ושאינם בעלי עניין אישי` TRUE 351 350 0 10000 TRUE
-- 350 for and 350 against: exactly half is no majority.
#ASSERT NOT (`האם הרוב באסיפה הכללית כולל רוב מקרב בעלי המניות שאינם בעלי שליטה ושאינם בעלי עניין אישי` TRUE 350 350 0 10000 TRUE)
-- Abstentions are not counted: 300 for, 200 against, 1000 abstaining is still a majority of the 500 counted.
#ASSERT `האם הרוב באסיפה הכללית כולל רוב מקרב בעלי המניות שאינם בעלי שליטה ושאינם בעלי עניין אישי` TRUE 300 200 1000 10000 TRUE
#ASSERT NOT (`האם הרוב באסיפה הכללית כולל רוב מקרב בעלי המניות שאינם בעלי שליטה ושאינם בעלי עניין אישי` FALSE 600 100 50 10000 TRUE)
#ASSERT NOT (`האם הרוב באסיפה הכללית כולל רוב מקרב בעלי המניות שאינם בעלי שליטה ושאינם בעלי עניין אישי` TRUE 600 100 50 10000 FALSE)
-- 121(c)(2) alone. The inputs are: votes against among those shareholders; all voting rights.
#ASSERT `האם המתנגדים מקרב בעלי המניות שאינם בעלי שליטה ושאינם בעלי עניין אישי אינם עולים על שני אחוזים` 0 10000
#ASSERT `האם המתנגדים מקרב בעלי המניות שאינם בעלי שליטה ושאינם בעלי עניין אישי אינם עולים על שני אחוזים` 200 10000
#ASSERT NOT (`האם המתנגדים מקרב בעלי המניות שאינם בעלי שליטה ושאינם בעלי עניין אישי אינם עולים על שני אחוזים` 201 10000)
-- 121(d): the board of a private bond company, with the audit committee's approval. The inputs after the company: the audit committee approved.
#ASSERT `האם הדירקטוריון של החברה שלי רשאי להחליט על הסמכה כפולה` FALSE TRUE TRUE
#ASSERT NOT (`האם הדירקטוריון של החברה שלי רשאי להחליט על הסמכה כפולה` FALSE TRUE FALSE)
#ASSERT NOT (`האם הדירקטוריון של החברה שלי רשאי להחליט על הסמכה כפולה` TRUE FALSE TRUE)
#ASSERT NOT (`האם הדירקטוריון של החברה שלי רשאי להחליט על הסמכה כפולה` FALSE FALSE TRUE)
-- 121(c), (d): each authorisation is for periods not above three years from the decision.
#ASSERT `כמה שנים לכל היותר תקפה כל הסמכה כפולה` EQUALS 3
#ASSERT `האם משך ההסמכה הכפולה שאני מציע אינו עולה על המותר` 3
#ASSERT `האם משך ההסמכה הכפולה שאני מציע אינו עולה על המותר` 2
#ASSERT NOT (`האם משך ההסמכה הכפולה שאני מציע אינו עולה על המותר` 3.5)
#ASSERT NOT (`האם משך ההסמכה הכפולה שאני מציע אינו עולה על המותר` 4)

§§ `מקרים: סעיף 122 – חובת דיווח לדירקטוריון`

-- 122(a): an unusual matter that is material to the company. The inputs are: unusual; material.
#ASSERT `האם אני כמנהל כללי חייב להודיע על ענין חריג ומהותי` TRUE TRUE
#ASSERT NOT (`האם אני כמנהל כללי חייב להודיע על ענין חריג ומהותי` TRUE FALSE)
#ASSERT NOT (`האם אני כמנהל כללי חייב להודיע על ענין חריג ומהותי` FALSE TRUE)
-- 122(a): to the chairperson; if the company has none or he cannot fill his role, to all the members of the board. The inputs are: the company has a chairperson; he is able to fill his role.
#ASSERT `למי על המנהל הכללי להודיע על ענין חריג ומהותי` TRUE TRUE EQUALS `יושב ראש הדירקטוריון`
#ASSERT `למי על המנהל הכללי להודיע על ענין חריג ומהותי` TRUE FALSE EQUALS `הדירקטוריון`
#ASSERT `למי על המנהל הכללי להודיע על ענין חריג ומהותי` FALSE FALSE EQUALS `הדירקטוריון`
-- 122(b): the subjects, times and extent the board fixes. The inputs are: the subject is one the board fixed; at the time it fixed; to the extent it fixed.
#ASSERT `האם הדיווח שלי לדירקטוריון עומד בדרישת הדירקטוריון` TRUE TRUE TRUE
#ASSERT NOT (`האם הדיווח שלי לדירקטוריון עומד בדרישת הדירקטוריון` FALSE TRUE TRUE)
#ASSERT NOT (`האם הדיווח שלי לדירקטוריון עומד בדרישת הדירקטוריון` TRUE FALSE TRUE)
#ASSERT NOT (`האם הדיווח שלי לדירקטוריון עומד בדרישת הדירקטוריון` TRUE TRUE FALSE)
-- 122(c): the chairperson may demand reports on matters concerning the company's business.
#ASSERT `האם יושב ראש הדירקטוריון רשאי לדרוש מהמנהל הכללי דיווח בענין` TRUE
#ASSERT NOT (`האם יושב ראש הדירקטוריון רשאי לדרוש מהמנהל הכללי דיווח בענין` FALSE)
-- 122(d): if the notice or report required action by the board, the chairperson convenes a meeting without delay.
#ASSERT `האם יושב ראש הדירקטוריון חייב לזמן ישיבת דירקטוריון ללא דיחוי` TRUE
#ASSERT NOT (`האם יושב ראש הדירקטוריון חייב לזמן ישיבת דירקטוריון ללא דיחוי` FALSE)

§§ `מקרים: סעיף 123 – המשרד הרשום`

-- 123(a): from the day the company is registered it keeps a registered office in Israel.
#ASSERT `האם החברה שלי חייבת לקיים משרד רשום בישראל` TRUE
#ASSERT NOT (`האם החברה שלי חייבת לקיים משרד רשום בישראל` FALSE)
#ASSERT `האם המשרד הרשום של החברה שלי עומד בדרישת המיקום` TRUE
#ASSERT NOT (`האם המשרד הרשום של החברה שלי עומד בדרישת המיקום` FALSE)
-- 123(b): notice of the address with the application to register; notice of a change within fourteen days after the change (the fourteenth day is in time, the fifteenth is late).
#ASSERT `תוך כמה ימים יש להודיע לרשם על שינוי במען המשרד הרשום` EQUALS 14
#ASSERT `האם ההודעה הראשונה על מען המשרד הרשום נמסרה לרשם כנדרש` TRUE
#ASSERT NOT (`האם ההודעה הראשונה על מען המשרד הרשום נמסרה לרשם כנדרש` FALSE)
#ASSERT `האם ההודעה לרשם על שינוי במען המשרד הרשום נמסרה במועד` 0
#ASSERT `האם ההודעה לרשם על שינוי במען המשרד הרשום נמסרה במועד` 14
#ASSERT NOT (`האם ההודעה לרשם על שינוי במען המשרד הרשום נמסרה במועד` 15)
-- 123(b): the Registrar records the address of the registered office.
#ASSERT `האם החברה שלי רשאית לדרוש מהרשם לרשום את מען המשרד הרשום` TRUE
#ASSERT NOT (`האם החברה שלי רשאית לדרוש מהרשם לרשום את מען המשרד הרשום` FALSE)
-- 123(c): delivery at the registered office, or posting to it. The inputs are: delivered at the office; sent by post to it.
#ASSERT `האם המסמך הומצא לחברה שלי כדין במשרדה הרשום` TRUE FALSE
#ASSERT `האם המסמך הומצא לחברה שלי כדין במשרדה הרשום` FALSE TRUE
#ASSERT NOT (`האם המסמך הומצא לחברה שלי כדין במשרדה הרשום` FALSE FALSE)
-- 123(d): a document from the Registrar, or from the Securities Authority to a reporting corporation, may be served where the sender is satisfied the company in fact runs its business, or in another manner the Securities Law sets.
-- The inputs after the company (five: shares, bonds, reporting corporation, public-benefit, government) are: sent by the Registrar; sent by the Securities Authority; sender satisfied; other manner.
#ASSERT `האם המסמך יכול להימסר לחברה שלי במקום אחר שאינו משרדה הרשום` FALSE FALSE FALSE FALSE FALSE TRUE FALSE TRUE FALSE
#ASSERT `האם המסמך יכול להימסר לחברה שלי במקום אחר שאינו משרדה הרשום` TRUE FALSE TRUE FALSE FALSE FALSE TRUE TRUE FALSE
#ASSERT `האם המסמך יכול להימסר לחברה שלי במקום אחר שאינו משרדה הרשום` FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE TRUE
-- The Securities Authority is a sender only to a reporting corporation.
#ASSERT NOT (`האם המסמך יכול להימסר לחברה שלי במקום אחר שאינו משרדה הרשום` TRUE FALSE FALSE FALSE FALSE FALSE TRUE TRUE FALSE)
-- The Registrar, but neither the sender's satisfaction nor another manner.
#ASSERT NOT (`האם המסמך יכול להימסר לחברה שלי במקום אחר שאינו משרדה הרשום` FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE)
-- Any other sender is not covered by (d), satisfied or not.
#ASSERT NOT (`האם המסמך יכול להימסר לחברה שלי במקום אחר שאינו משרדה הרשום` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE)

§§ `מקרים: סעיף 123א – המען הדיגיטלי`

-- 123A(a): a digital address, one of each item of the Fourth Schedule: an e-mail address, and a mobile telephone number or a second e-mail address.
#ASSERT `האם יש לחברה שלי מען דיגיטלי כנדרש` TRUE TRUE
#ASSERT NOT (`האם יש לחברה שלי מען דיגיטלי כנדרש` TRUE FALSE)
#ASSERT NOT (`האם יש לחברה שלי מען דיגיטלי כנדרש` FALSE TRUE)
-- 123A(b): with the application, and a change within 14 days.
#ASSERT `תוך כמה ימים יש להודיע לרשם על שינוי במען הדיגיטלי` EQUALS 14
#ASSERT `האם ההודעה הראשונה על המען הדיגיטלי נמסרה לרשם כנדרש` TRUE
#ASSERT NOT (`האם ההודעה הראשונה על המען הדיגיטלי נמסרה לרשם כנדרש` FALSE)
#ASSERT `האם ההודעה לרשם על שינוי במען הדיגיטלי נמסרה במועד` 14
#ASSERT NOT (`האם ההודעה לרשם על שינוי במען הדיגיטלי נמסרה במועד` 15)
-- 123A(c): the Registrar records it after the conditions of section 3B(a)(1) and (3) were met and after he made sure it is valid and active. The inputs are: notice given; the conditions met; verified.
#ASSERT `האם החברה שלי רשאית לדרוש מהרשם לרשום את המען הדיגיטלי שלה` TRUE TRUE TRUE
#ASSERT NOT (`האם החברה שלי רשאית לדרוש מהרשם לרשום את המען הדיגיטלי שלה` FALSE TRUE TRUE)
#ASSERT NOT (`האם החברה שלי רשאית לדרוש מהרשם לרשום את המען הדיגיטלי שלה` TRUE FALSE TRUE)
#ASSERT NOT (`האם החברה שלי רשאית לדרוש מהרשם לרשום את המען הדיגיטלי שלה` TRUE TRUE FALSE)

§§ `מקרים: סעיפים 124 עד 126 – מסמכים, שמירה והעתקים`

-- 124: the articles, minutes, the register of directors are kept; the inputs after the company are: the document; the age in years of a notice copy. An ordinary private company is `FALSE FALSE`, a public company `TRUE FALSE`.
#ASSERT `האם החברה שלי חייבת לשמור את המסמך במשרדה הרשום` FALSE FALSE `תקנון החברה כמסמך שנשמר במשרד הרשום` 0
#ASSERT `האם החברה שלי חייבת לשמור את המסמך במשרדה הרשום` FALSE FALSE `פרוטוקול של אסיפה כללית כמסמך שנשמר במשרד הרשום` 0
#ASSERT `האם החברה שלי חייבת לשמור את המסמך במשרדה הרשום` FALSE FALSE `מרשם הדירקטורים` 0
#ASSERT `האם החברה שלי חייבת לשמור את המסמך במשרדה הרשום` FALSE FALSE `מרשם בעלי המניות כמסמך שנשמר במשרד הרשום` 0
-- 124(5): copies of notices to the shareholders in the last seven years (seven is in; eight is out).
#ASSERT `האם החברה שלי חייבת לשמור את המסמך במשרדה הרשום` FALSE FALSE `העתק הודעה של החברה לבעלי מניותיה` 7
#ASSERT NOT (`האם החברה שלי חייבת לשמור את המסמך במשרדה הרשום` FALSE FALSE `העתק הודעה של החברה לבעלי מניותיה` 8)
-- 124(7): the register of material shareholders only in a public company.
#ASSERT `האם החברה שלי חייבת לשמור את המסמך במשרדה הרשום` TRUE FALSE `מרשם בעלי המניות המהותיים` 0
#ASSERT NOT (`האם החברה שלי חייבת לשמור את המסמך במשרדה הרשום` FALSE FALSE `מרשם בעלי המניות המהותיים` 0)
-- 124: a document the section does not list is not covered.
#ASSERT NOT (`האם החברה שלי חייבת לשמור את המסמך במשרדה הרשום` FALSE FALSE `מסמך אחר שהחברה שומרת במשרדה הרשום` 0)
-- 125: electronic keeping provided that those entitled can obtain copies.
#ASSERT `האם החברה שלי רשאית לשמור את המסמכים באמצעים אלקטרוניים` TRUE
#ASSERT NOT (`האם החברה שלי רשאית לשמור את המסמכים באמצעים אלקטרוניים` FALSE)
-- 126(a): one entitled to inspect is entitled to a copy.
#ASSERT `האם אני זכאי לקבל העתק מהמסמכים שבמשרד הרשום` TRUE
#ASSERT NOT (`האם אני זכאי לקבל העתק מהמסמכים שבמשרד הרשום` FALSE)
-- 126(a): a payment not above the company's expenses of giving the copy alone. The inputs are: the payment demanded; the company's expenses.
#ASSERT `האם התשלום שהחברה דורשת בעבור ההעתק עומד במותר` 50 50
#ASSERT `האם התשלום שהחברה דורשת בעבור ההעתק עומד במותר` 0 50
#ASSERT NOT (`האם התשלום שהחברה דורשת בעבור ההעתק עומד במותר` 51 50)
#ASSERT NOT (`האם התשלום שהחברה דורשת בעבור ההעתק עומד במותר` 200 100)

§§ `מקרים: סעיפים 127 עד 129 – המרשמים`

-- 127: every company keeps a register of shareholders.
#ASSERT `האם החברה שלי חייבת לנהל מרשם בעלי מניות` FALSE FALSE
#ASSERT `האם החברה שלי חייבת לנהל מרשם בעלי מניות` TRUE FALSE
-- 128: a public company also keeps a register of material shareholders; a private company, bond company included, does not.
#ASSERT `האם החברה שלי חייבת לנהל מרשם בעלי מניות מהותיים` TRUE FALSE
#ASSERT NOT (`האם החברה שלי חייבת לנהל מרשם בעלי מניות מהותיים` FALSE FALSE)
#ASSERT NOT (`האם החברה שלי חייבת לנהל מרשם בעלי מניות מהותיים` FALSE TRUE)
-- 129: both registers are open to inspection by any person. The inputs are: it is the register of shareholders; it is the register of material shareholders.
#ASSERT `האם אני רשאי לעיין במרשם בעלי המניות או במרשם בעלי המניות המהותיים` TRUE FALSE
#ASSERT `האם אני רשאי לעיין במרשם בעלי המניות או במרשם בעלי המניות המהותיים` FALSE TRUE
#ASSERT NOT (`האם אני רשאי לעיין במרשם בעלי המניות או במרשם בעלי המניות המהותיים` FALSE FALSE)

§§ `מקרים: סעיפים 130 עד 134 – מרשם בעלי המניות`

-- 130(a): the inputs are: the detail; the shares have a par value; part of the consideration is unpaid; the shares are numbered; there are dormant shares; there are non-voting shares.
-- A detail due for every shareholder: name, identity number, address, number and class of shares, date of allotment or transfer.
#ASSERT `האם החברה חייבת לרשום את הפרט הזה במרשם בעלי המניות` `שם בעל המניה` FALSE FALSE FALSE FALSE FALSE
#ASSERT `האם החברה חייבת לרשום את הפרט הזה במרשם בעלי המניות` `כמות המניות שבבעלותו` FALSE FALSE FALSE FALSE FALSE
#ASSERT `האם החברה חייבת לרשום את הפרט הזה במרשם בעלי המניות` `תאריך ההקצאה או מועדי ההעברה` FALSE FALSE FALSE FALSE FALSE
-- The par value only if there is one.
#ASSERT `האם החברה חייבת לרשום את הפרט הזה במרשם בעלי המניות` `הערך הנקוב של המניות` TRUE FALSE FALSE FALSE FALSE
#ASSERT NOT (`האם החברה חייבת לרשום את הפרט הזה במרשם בעלי המניות` `הערך הנקוב של המניות` FALSE TRUE TRUE TRUE TRUE)
-- The unpaid amount only if some of the consideration is unpaid.
#ASSERT `האם החברה חייבת לרשום את הפרט הזה במרשם בעלי המניות` `הסכום שטרם שולם על חשבון התמורה` FALSE TRUE FALSE FALSE FALSE
#ASSERT NOT (`האם החברה חייבת לרשום את הפרט הזה במרשם בעלי המניות` `הסכום שטרם שולם על חשבון התמורה` TRUE FALSE TRUE TRUE TRUE)
-- Serial numbers only if the shares are numbered.
#ASSERT `האם החברה חייבת לרשום את הפרט הזה במרשם בעלי המניות` `מספרי המניות הסידוריים` FALSE FALSE TRUE FALSE FALSE
#ASSERT NOT (`האם החברה חייבת לרשום את הפרט הזה במרשם בעלי המניות` `מספרי המניות הסידוריים` TRUE TRUE FALSE TRUE TRUE)
-- Dormant shares: their number and the date they became dormant, only if there are such shares.
#ASSERT `האם החברה חייבת לרשום את הפרט הזה במרשם בעלי המניות` `מספר המניות הרדומות` FALSE FALSE FALSE TRUE FALSE
#ASSERT `האם החברה חייבת לרשום את הפרט הזה במרשם בעלי המניות` `התאריך שבו הפכו המניות לרדומות` FALSE FALSE FALSE TRUE FALSE
#ASSERT NOT (`האם החברה חייבת לרשום את הפרט הזה במרשם בעלי המניות` `מספר המניות הרדומות` TRUE TRUE TRUE FALSE TRUE)
-- Shares without voting rights: their number and the date, only if there are such shares.
#ASSERT `האם החברה חייבת לרשום את הפרט הזה במרשם בעלי המניות` `מספר המניות שאינן מקנות זכויות הצבעה` FALSE FALSE FALSE FALSE TRUE
#ASSERT `האם החברה חייבת לרשום את הפרט הזה במרשם בעלי המניות` `התאריך שבו הפכו המניות לשאינן מקנות זכויות הצבעה` FALSE FALSE FALSE FALSE TRUE
#ASSERT NOT (`האם החברה חייבת לרשום את הפרט הזה במרשם בעלי המניות` `התאריך שבו הפכו המניות לשאינן מקנות זכויות הצבעה` TRUE TRUE TRUE TRUE FALSE)
-- A detail the section does not list is not due.
#ASSERT NOT (`האם החברה חייבת לרשום את הפרט הזה במרשם בעלי המניות` `פרט אחר` TRUE TRUE TRUE TRUE TRUE)
-- 130(b): keeping all the entries and updating changes as early as possible. The inputs are: kept; updated.
#ASSERT `האם החברה שלי קיימה את חובת השמירה והעדכון של מרשם בעלי המניות` TRUE TRUE
#ASSERT NOT (`האם החברה שלי קיימה את חובת השמירה והעדכון של מרשם בעלי המניות` TRUE FALSE)
#ASSERT NOT (`האם החברה שלי קיימה את חובת השמירה והעדכון של מרשם בעלי המניות` FALSE TRUE)
-- 131(a), (b): the inputs are: I am a trustee; I am a holder as section 177(1) means; another reporting duty applies to me.
-- A trustee who is not a section 177(1) holder: the provision applies.
#ASSERT `האם הוראת הנאמנות חלה עליי כבעל מניה` TRUE FALSE FALSE
-- A trustee who is a section 177(1) holder: it does not apply, unless another reporting duty applies to him.
#ASSERT NOT (`האם הוראת הנאמנות חלה עליי כבעל מניה` TRUE TRUE FALSE)
#ASSERT `האם הוראת הנאמנות חלה עליי כבעל מניה` TRUE TRUE TRUE
-- Not a trustee: it does not apply.
#ASSERT NOT (`האם הוראת הנאמנות חלה עליי כבעל מניה` FALSE FALSE TRUE)
-- 131(a): the trustee reports to the company; the company enters him noting his trusteeship; he is treated as a shareholder.
#ASSERT `האם אני כבעל מניה נאמן חייב לדווח לחברה על נאמנותי` TRUE FALSE FALSE
#ASSERT `האם אני כבעל מניה נאמן חייב לדווח לחברה על נאמנותי` TRUE TRUE TRUE
#ASSERT NOT (`האם אני כבעל מניה נאמן חייב לדווח לחברה על נאמנותי` TRUE TRUE FALSE)
#ASSERT NOT (`האם אני כבעל מניה נאמן חייב לדווח לחברה על נאמנותי` FALSE FALSE FALSE)
#ASSERT `האם החברה חייבת לרשום אותי במרשם בעלי המניות תוך ציון נאמנותי` TRUE FALSE FALSE
#ASSERT `האם החברה חייבת לרשום אותי במרשם בעלי המניות תוך ציון נאמנותי` TRUE TRUE TRUE
#ASSERT NOT (`האם החברה חייבת לרשום אותי במרשם בעלי המניות תוך ציון נאמנותי` TRUE TRUE FALSE)
#ASSERT NOT (`האם החברה חייבת לרשום אותי במרשם בעלי המניות תוך ציון נאמנותי` FALSE TRUE TRUE)
#ASSERT `האם אני כנאמן נחשב לבעל מניה לענין חוק החברות` TRUE FALSE FALSE
#ASSERT `האם אני כנאמן נחשב לבעל מניה לענין חוק החברות` TRUE TRUE TRUE
#ASSERT NOT (`האם אני כנאמן נחשב לבעל מניה לענין חוק החברות` TRUE TRUE FALSE)
#ASSERT NOT (`האם אני כנאמן נחשב לבעל מניה לענין חוק החברות` FALSE FALSE FALSE)
-- 132(a): a registration company may be entered in a company whose shares are registered for trading on a bourse in Israel; it is not regarded as the holder.
#ASSERT `האם אפשר לרשום חברה לרישומים במרשם בעלי המניות של החברה שלי` TRUE
#ASSERT NOT (`האם אפשר לרשום חברה לרישומים במרשם בעלי המניות של החברה שלי` FALSE)
#ASSERT NOT (`האם חברה לרישומים נחשבת לבעלת המניות הרשומות על שמה`)
-- 132(b): one entitled under section 177(1) may be registered instead; the number registered in the registration company's name falls accordingly (1000 less 100 is 900).
#ASSERT `האם אני זכאי להירשם במרשם בעלי המניות במקום החברה לרישומים` TRUE
#ASSERT NOT (`האם אני זכאי להירשם במרשם בעלי המניות במקום החברה לרישומים` FALSE)
#ASSERT `כמה מניות יישארו רשומות על שם החברה לרישומים לאחר שאירשם` 1000 100 EQUALS 900
#ASSERT `כמה מניות יישארו רשומות על שם החברה לרישומים לאחר שאירשם` 100 100 EQUALS 0
-- 133(a): prima facie evidence. 133(b): the register is better evidence than the share certificate where they contradict; with no contradiction the text prefers neither.
#ASSERT `מהו המשקל הראייתי של הרשום במרשם בעלי המניות` EQUALS `ראיה לכאורה`
#ASSERT `איזה מסמך עדיף כראיה כשיש סתירה בין המרשם לתעודת המניה` TRUE EQUALS (JUST `מרשם בעלי המניות כמסמך ראייתי`)
#ASSERT `איזה מסמך עדיף כראיה כשיש סתירה בין המרשם לתעודת המניה` FALSE EQUALS NOTHING
-- 134: the court may grant relief where a person is wrongly entered, or an entitled person is not entered, or the entry is incomplete or inaccurate, and the company refused to correct it, at the request of the injured party or of any shareholder.
-- The inputs are: wrongly entered; entitled but not entered; incomplete or inaccurate; the company refused; I am the injured party; I am a shareholder.
#ASSERT `האם בית המשפט רשאי לתקן את המרשם לבקשתי` TRUE FALSE FALSE TRUE TRUE FALSE
#ASSERT `האם בית המשפט רשאי לתקן את המרשם לבקשתי` FALSE TRUE FALSE TRUE FALSE TRUE
#ASSERT `האם בית המשפט רשאי לתקן את המרשם לבקשתי` FALSE FALSE TRUE TRUE TRUE TRUE
#ASSERT NOT (`האם בית המשפט רשאי לתקן את המרשם לבקשתי` TRUE FALSE FALSE FALSE TRUE TRUE)
#ASSERT NOT (`האם בית המשפט רשאי לתקן את המרשם לבקשתי` FALSE FALSE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`האם בית המשפט רשאי לתקן את המרשם לבקשתי` TRUE TRUE TRUE TRUE FALSE FALSE)

§§ `מקרים: סעיפים 137 עד 139 – מרשם בעלי מניות מהותיים ומרשם נוסף`

-- 137: the register of material shareholders keeps the reports the company received under the Securities Law on the holdings of material shareholders.
#ASSERT `האם הדיווח נשמר במרשם בעלי המניות המהותיים` TRUE TRUE
#ASSERT NOT (`האם הדיווח נשמר במרשם בעלי המניות המהותיים` TRUE FALSE)
#ASSERT NOT (`האם הדיווח נשמר במרשם בעלי המניות המהותיים` FALSE TRUE)
-- 138(a): a company may keep an additional register of shareholders outside Israel.
#ASSERT `האם החברה שלי רשאית לנהל מרשם בעלי מניות נוסף מחוץ לישראל` FALSE FALSE
-- 138(b): a company with an additional register notes in the main register the number of shares in it and, if they are numbered, their numbers. The inputs are: it keeps an additional register; the shares in it are numbered; the detail.
#ASSERT `האם החברה שלי חייבת לציין את הפרט הזה במרשם העיקרי` TRUE FALSE `מספר המניות הרשומות במרשם הנוסף`
#ASSERT `האם החברה שלי חייבת לציין את הפרט הזה במרשם העיקרי` TRUE TRUE `מספרי המניות הרשומות במרשם הנוסף`
#ASSERT NOT (`האם החברה שלי חייבת לציין את הפרט הזה במרשם העיקרי` TRUE FALSE `מספרי המניות הרשומות במרשם הנוסף`)
#ASSERT NOT (`האם החברה שלי חייבת לציין את הפרט הזה במרשם העיקרי` FALSE TRUE `מספר המניות הרשומות במרשם הנוסף`)
#ASSERT NOT (`האם החברה שלי חייבת לציין את הפרט הזה במרשם העיקרי` FALSE TRUE `מספרי המניות הרשומות במרשם הנוסף`)

§§ `מקרים: סעיפים 140 ו־141 – דיווח של חברה שאינה תאגיד מדווח`

-- 140: the five company inputs are: shares, bonds, reporting corporation, public-benefit company, government company. A company that is not a reporting corporation is `FALSE FALSE FALSE FALSE FALSE`; a reporting corporation `TRUE FALSE TRUE FALSE FALSE`.
#ASSERT `האם החברה שלי חייבת לדווח לרשם על הענין לפי סעיף 140` FALSE FALSE FALSE FALSE FALSE `שינוי בתקנון`
#ASSERT `האם החברה שלי חייבת לדווח לרשם על הענין לפי סעיף 140` FALSE FALSE FALSE FALSE FALSE `העברת מניות`
#ASSERT `האם החברה שלי חייבת לדווח לרשם על הענין לפי סעיף 140` FALSE FALSE FALSE FALSE FALSE `מיזוג כענין לדיווח לרשם`
#ASSERT `האם החברה שלי חייבת לדווח לרשם על הענין לפי סעיף 140` FALSE FALSE FALSE FALSE FALSE `צו פירוק או החלטה על פירוק מרצון`
-- A matter the section does not list.
#ASSERT NOT (`האם החברה שלי חייבת לדווח לרשם על הענין לפי סעיף 140` FALSE FALSE FALSE FALSE FALSE `ענין אחר לדיווח לרשם`)
-- A reporting corporation is outside section 140.
#ASSERT NOT (`האם החברה שלי חייבת לדווח לרשם על הענין לפי סעיף 140` TRUE FALSE TRUE FALSE FALSE `שינוי בתקנון`)
-- 140(6): a transfer of shares is reported fourteen days from the transfer.
#ASSERT `תוך כמה ימים מיום העברת מניות יש לדווח על כך לרשם` EQUALS 14
#ASSERT `האם הדיווח לרשם על העברת מניות נמסר במועד` 14
#ASSERT `האם הדיווח לרשם על העברת מניות נמסר במועד` 0
#ASSERT NOT (`האם הדיווח לרשם על העברת מניות נמסר במועד` 15)
-- 141(a): a company that is not a reporting corporation submits an annual report once a year.
#ASSERT `האם החברה שלי חייבת להגיש לרשם דין וחשבון שנתי` FALSE FALSE FALSE FALSE FALSE
#ASSERT NOT (`האם החברה שלי חייבת להגיש לרשם דין וחשבון שנתי` TRUE FALSE TRUE FALSE FALSE)
-- 141(a), (b): within fourteen days after the annual meeting, or after sending the financial statements for a company holding no annual meeting; an inactive company with no statements: once a year only.
-- The inputs are: the event; days since the event; submitted once a year.
#ASSERT `תוך כמה ימים יש להגיש לרשם את הדין וחשבון השנתי` EQUALS 14
#ASSERT `האם הדין וחשבון השנתי של החברה שלי הוגש במועד` `האסיפה השנתית` 14 TRUE
#ASSERT NOT (`האם הדין וחשבון השנתי של החברה שלי הוגש במועד` `האסיפה השנתית` 15 TRUE)
#ASSERT NOT (`האם הדין וחשבון השנתי של החברה שלי הוגש במועד` `האסיפה השנתית` 14 FALSE)
#ASSERT `האם הדין וחשבון השנתי של החברה שלי הוגש במועד` `משלוח הדוחות הכספיים לבעלי המניות` 14 TRUE
#ASSERT NOT (`האם הדין וחשבון השנתי של החברה שלי הוגש במועד` `משלוח הדוחות הכספיים לבעלי המניות` 15 TRUE)
#ASSERT `האם הדין וחשבון השנתי של החברה שלי הוגש במועד` `חברה לא פעילה שאינה עורכת דוחות כספיים` 400 TRUE
#ASSERT NOT (`האם הדין וחשבון השנתי של החברה שלי הוגש במועד` `חברה לא פעילה שאינה עורכת דוחות כספיים` 0 FALSE)

§§ `מקרים: סעיפים 142 עד 145 – דיווח של תאגיד מדווח ועיון ברשות ניירות ערך`

-- 142(b): a reporting corporation reports to the Securities Authority, the bourse and the Registrar.
#ASSERT `האם החברה שלי חייבת לדווח לרשות ניירות ערך לבורסה ולרשם` TRUE FALSE TRUE FALSE FALSE
#ASSERT NOT (`האם החברה שלי חייבת לדווח לרשות ניירות ערך לבורסה ולרשם` FALSE FALSE FALSE FALSE FALSE)
-- 143(a): reports filed with the Securities Authority are open to any person, unless restricted by any law.
#ASSERT `האם אני רשאי לעיין בדוחות שהוגשו לרשות ניירות ערך ולקבל העתק מאושר` FALSE
#ASSERT NOT (`האם אני רשאי לעיין בדוחות שהוגשו לרשות ניירות ערך ולקבל העתק מאושר` TRUE)
-- 143(b): a certified copy is accepted as the original and is conclusive evidence that the original is held by the Authority.
#ASSERT `האם העתק מאושר של דוח מרשות ניירות ערך מתקבל כמקור בהליך משפטי` TRUE
#ASSERT NOT (`האם העתק מאושר של דוח מרשות ניירות ערך מתקבל כמקור בהליך משפטי` FALSE)
#ASSERT `מהו המשקל הראייתי של העתק מאושר לענין החזקת המסמך המקורי ברשות` EQUALS `ראיה חלוטה`
-- 143(c): the provision applies to a printout where electronic filing or reporting provisions were set. The inputs are: such provisions were set; the document is a printout.
#ASSERT `האם הוראת העתק מאושר חלה על פלט של הדיווחים` TRUE TRUE
#ASSERT NOT (`האם הוראת העתק מאושר חלה על פלט של הדיווחים` TRUE FALSE)
#ASSERT NOT (`האם הוראת העתק מאושר חלה על פלט של הדיווחים` FALSE TRUE)
-- 145: a reporting corporation reports to the Registrar under the Law on the listed matters only: name change, registered office, digital address, merger, change of type, winding up.
#ASSERT `האם החברה שלי שהיא תאגיד מדווח חייבת לדווח לרשם על הענין לפי סעיף 145` TRUE FALSE TRUE FALSE FALSE `החלטה על שינוי שם`
#ASSERT `האם החברה שלי שהיא תאגיד מדווח חייבת לדווח לרשם על הענין לפי סעיף 145` TRUE FALSE TRUE FALSE FALSE `שינוי במען המשרד הרשום`
#ASSERT `האם החברה שלי שהיא תאגיד מדווח חייבת לדווח לרשם על הענין לפי סעיף 145` TRUE FALSE TRUE FALSE FALSE `שינוי במען הדיגיטלי`
#ASSERT `האם החברה שלי שהיא תאגיד מדווח חייבת לדווח לרשם על הענין לפי סעיף 145` TRUE FALSE TRUE FALSE FALSE `מיזוג כענין לדיווח לרשם`
#ASSERT `האם החברה שלי שהיא תאגיד מדווח חייבת לדווח לרשם על הענין לפי סעיף 145` TRUE FALSE TRUE FALSE FALSE `שינוי בסוג החברה`
#ASSERT `האם החברה שלי שהיא תאגיד מדווח חייבת לדווח לרשם על הענין לפי סעיף 145` TRUE FALSE TRUE FALSE FALSE `צו פירוק או החלטה על פירוק מרצון`
-- "Only": a change of the articles or a transfer of shares is not on 145's list for a reporting corporation.
#ASSERT NOT (`האם החברה שלי שהיא תאגיד מדווח חייבת לדווח לרשם על הענין לפי סעיף 145` TRUE FALSE TRUE FALSE FALSE `שינוי בתקנון`)
#ASSERT NOT (`האם החברה שלי שהיא תאגיד מדווח חייבת לדווח לרשם על הענין לפי סעיף 145` TRUE FALSE TRUE FALSE FALSE `העברת מניות`)
-- Section 145 binds a reporting corporation only: a company that is not one is outside it.
#ASSERT NOT (`האם החברה שלי שהיא תאגיד מדווח חייבת לדווח לרשם על הענין לפי סעיף 145` FALSE FALSE FALSE FALSE FALSE `מיזוג כענין לדיווח לרשם`)

§§ `מקרים: סעיף 146`

-- 146(א): the board of a public company or of a private bond company appoints an internal auditor. The arguments: shares listed or offered and held by the public; bonds listed or offered and held by the public.
#ASSERT `האם החברה שלי חייבת למנות מבקר פנימי` TRUE FALSE
#ASSERT `האם החברה שלי חייבת למנות מבקר פנימי` FALSE TRUE
#ASSERT `האם החברה שלי חייבת למנות מבקר פנימי` TRUE TRUE
#ASSERT NOT (`האם החברה שלי חייבת למנות מבקר פנימי` FALSE FALSE)
-- 146(א): the internal auditor is appointed on the proposal of the audit committee.
#ASSERT `האם מינוי המבקר הפנימי נעשה לפי הצעת ועדת הביקורת` TRUE
#ASSERT NOT (`האם מינוי המבקר הפנימי נעשה לפי הצעת ועדת הביקורת` FALSE)
-- 146(ב): nobody serves who is an interested party, an office-holder, a relative of either, or the external auditor.
-- The arguments: my fraction of the capital; my fraction of the voting rights; I may appoint directors; I may appoint the general manager; I am a director; I am the general manager; my office; my relationship; I am the external auditor.
-- No tie at all: not barred.
#ASSERT NOT (`האם אני מנוע מלכהן כמבקר פנימי של החברה` 0 0 FALSE FALSE FALSE FALSE NOTHING NOTHING FALSE)
-- A holder of 5% of the capital is a material shareholder (5% or more), hence an interested party; 4.9% is not.
#ASSERT `האם אני מנוע מלכהן כמבקר פנימי של החברה` 0.05 0 FALSE FALSE FALSE FALSE NOTHING NOTHING FALSE
#ASSERT NOT (`האם אני מנוע מלכהן כמבקר פנימי של החברה` 0.049 0.049 FALSE FALSE FALSE FALSE NOTHING NOTHING FALSE)
#ASSERT `האם אני מנוע מלכהן כמבקר פנימי של החברה` 0 0.05 FALSE FALSE FALSE FALSE NOTHING NOTHING FALSE
-- A person who may appoint a director or the general manager, or who serves as one, is an interested party.
#ASSERT `האם אני מנוע מלכהן כמבקר פנימי של החברה` 0 0 TRUE FALSE FALSE FALSE NOTHING NOTHING FALSE
#ASSERT `האם אני מנוע מלכהן כמבקר פנימי של החברה` 0 0 FALSE TRUE FALSE FALSE NOTHING NOTHING FALSE
#ASSERT `האם אני מנוע מלכהן כמבקר פנימי של החברה` 0 0 FALSE FALSE TRUE FALSE NOTHING NOTHING FALSE
#ASSERT `האם אני מנוע מלכהן כמבקר פנימי של החברה` 0 0 FALSE FALSE FALSE TRUE NOTHING NOTHING FALSE
-- An office-holder (general manager, and the other offices of section 1) is barred; "another office" is not an office-holder's.
#ASSERT `האם אני מנוע מלכהן כמבקר פנימי של החברה` 0 0 FALSE FALSE FALSE FALSE (JUST `מנהל כללי`) NOTHING FALSE
#ASSERT NOT (`האם אני מנוע מלכהן כמבקר פנימי של החברה` 0 0 FALSE FALSE FALSE FALSE (JUST `משרה אחרת`) NOTHING FALSE)
-- A relative (a spouse is one) is barred; "another relationship" is no relative.
#ASSERT `האם אני מנוע מלכהן כמבקר פנימי של החברה` 0 0 FALSE FALSE FALSE FALSE NOTHING (JUST `בן זוג`) FALSE
#ASSERT NOT (`האם אני מנוע מלכהן כמבקר פנימי של החברה` 0 0 FALSE FALSE FALSE FALSE NOTHING (JUST `קרבה אחרת`) FALSE)
-- The external auditor, or anyone on his behalf, is barred.
#ASSERT `האם אני מנוע מלכהן כמבקר פנימי של החברה` 0 0 FALSE FALSE FALSE FALSE NOTHING NOTHING TRUE

§§ `מקרים: סעיף 147`

-- 147: only sections 3(א), 4(ב), 8 to 10, 14(ב) and 14(ג) of the Internal Audit Law apply to the internal auditor.
#ASSERT `האם הוראה בחוק הביקורת הפנימית חלה על המבקר הפנימי של החברה` `סעיף 3(א)`
#ASSERT `האם הוראה בחוק הביקורת הפנימית חלה על המבקר הפנימי של החברה` `סעיף 4(ב)`
#ASSERT `האם הוראה בחוק הביקורת הפנימית חלה על המבקר הפנימי של החברה` `סעיפים 8 עד 10`
#ASSERT `האם הוראה בחוק הביקורת הפנימית חלה על המבקר הפנימי של החברה` `סעיף 14(ב)`
#ASSERT `האם הוראה בחוק הביקורת הפנימית חלה על המבקר הפנימי של החברה` `סעיף 14(ג)`
#ASSERT NOT (`האם הוראה בחוק הביקורת הפנימית חלה על המבקר הפנימי של החברה` `הוראה אחרת בחוק הביקורת הפנימית`)

§§ `מקרים: סעיפים 148 עד 152`

-- 148: the supervisor is the chairperson of the board or the general manager, as the articles say, or if they are silent as the board decides. The arguments: named by the articles; named by the board.
#ASSERT `מי הממונה הארגוני על המבקר הפנימי` (JUST `יושב ראש הדירקטוריון`) NOTHING EQUALS (JUST `יושב ראש הדירקטוריון`)
#ASSERT `מי הממונה הארגוני על המבקר הפנימי` (JUST `המנהל הכללי`) NOTHING EQUALS (JUST `המנהל הכללי`)
#ASSERT `מי הממונה הארגוני על המבקר הפנימי` NOTHING (JUST `המנהל הכללי`) EQUALS (JUST `המנהל הכללי`)
#ASSERT `מי הממונה הארגוני על המבקר הפנימי` NOTHING (JUST `יושב ראש הדירקטוריון`) EQUALS (JUST `יושב ראש הדירקטוריון`)
-- Where the articles have a provision the board's decision does not apply.
#ASSERT `מי הממונה הארגוני על המבקר הפנימי` (JUST `יושב ראש הדירקטוריון`) (JUST `המנהל הכללי`) EQUALS (JUST `יושב ראש הדירקטוריון`)
-- Not covered: nobody named, or a body the section does not allow as supervisor: the Law does not answer (NOTHING).
#ASSERT `מי הממונה הארגוני על המבקר הפנימי` NOTHING NOTHING EQUALS NOTHING
#ASSERT `מי הממונה הארגוני על המבקר הפנימי` NOTHING (JUST `ועדת הביקורת`) EQUALS NOTHING
#ASSERT `מי הממונה הארגוני על המבקר הפנימי` (JUST `ועדת הביקורת`) (JUST `המנהל הכללי`) EQUALS NOTHING
-- 149: the work plan is approved by the board or by the audit committee, as the articles say, or else as the board decides.
#ASSERT `איזה גוף מאשר את תכנית העבודה של המבקר הפנימי` (JUST `הדירקטוריון`) NOTHING EQUALS (JUST `הדירקטוריון`)
#ASSERT `איזה גוף מאשר את תכנית העבודה של המבקר הפנימי` (JUST `ועדת הביקורת`) NOTHING EQUALS (JUST `ועדת הביקורת`)
#ASSERT `איזה גוף מאשר את תכנית העבודה של המבקר הפנימי` NOTHING (JUST `ועדת הביקורת`) EQUALS (JUST `ועדת הביקורת`)
#ASSERT `איזה גוף מאשר את תכנית העבודה של המבקר הפנימי` NOTHING NOTHING EQUALS NOTHING
#ASSERT `איזה גוף מאשר את תכנית העבודה של המבקר הפנימי` (JUST `המנהל הכללי`) NOTHING EQUALS NOTHING
-- 150: the chairperson of the board or of the audit committee may require an urgent check. The arguments: I chair the board; I chair the audit committee; an urgent need arose.
#ASSERT `האם אני רשאי לדרוש מהמבקר הפנימי בדיקה דחופה` TRUE FALSE TRUE
#ASSERT `האם אני רשאי לדרוש מהמבקר הפנימי בדיקה דחופה` FALSE TRUE TRUE
#ASSERT NOT (`האם אני רשאי לדרוש מהמבקר הפנימי בדיקה דחופה` FALSE FALSE TRUE)
#ASSERT NOT (`האם אני רשאי לדרוש מהמבקר הפנימי בדיקה דחופה` TRUE FALSE FALSE)
-- 151: the internal auditor checks, among other things, compliance with the law and proper business procedure.
#ASSERT `האם הענין נכלל בבדיקת המבקר הפנימי` TRUE FALSE FALSE
#ASSERT `האם הענין נכלל בבדיקת המבקר הפנימי` FALSE TRUE FALSE
#ASSERT `האם הענין נכלל בבדיקת המבקר הפנימי` FALSE FALSE TRUE
#ASSERT NOT (`האם הענין נכלל בבדיקת המבקר הפנימי` FALSE FALSE FALSE)
-- 152: the report goes to the chairperson of the board, the general manager and the chairperson of the audit committee; a report on an urgent matter also to whoever required the audit.
-- The arguments: I chair the board; I am the general manager; I chair the audit committee; the report concerns s 150 matters; I required the audit.
#ASSERT `האם אני זכאי לקבל את הדין וחשבון של המבקר הפנימי` TRUE FALSE FALSE FALSE FALSE
#ASSERT `האם אני זכאי לקבל את הדין וחשבון של המבקר הפנימי` FALSE TRUE FALSE FALSE FALSE
#ASSERT `האם אני זכאי לקבל את הדין וחשבון של המבקר הפנימי` FALSE FALSE TRUE FALSE FALSE
#ASSERT `האם אני זכאי לקבל את הדין וחשבון של המבקר הפנימי` FALSE FALSE FALSE TRUE TRUE
#ASSERT NOT (`האם אני זכאי לקבל את הדין וחשבון של המבקר הפנימי` FALSE FALSE FALSE FALSE TRUE)
#ASSERT NOT (`האם אני זכאי לקבל את הדין וחשבון של המבקר הפנימי` FALSE FALSE FALSE TRUE FALSE)
#ASSERT NOT (`האם אני זכאי לקבל את הדין וחשבון של המבקר הפנימי` FALSE FALSE FALSE FALSE FALSE)

§§ `מקרים: סעיף 153`

-- 153(א): the term is not ended without the internal auditor's consent unless the board decided so after getting the audit committee's position and after he had a reasonable opportunity to be heard.
-- The arguments: he consented; the board decided; the board got the audit committee's position; he had a reasonable opportunity.
#ASSERT `האם מותר להפסיק את כהונת המבקר הפנימי` TRUE FALSE FALSE FALSE
#ASSERT `האם מותר להפסיק את כהונת המבקר הפנימי` FALSE TRUE TRUE TRUE
#ASSERT NOT (`האם מותר להפסיק את כהונת המבקר הפנימי` FALSE TRUE TRUE FALSE)
#ASSERT NOT (`האם מותר להפסיק את כהונת המבקר הפנימי` FALSE TRUE FALSE TRUE)
#ASSERT NOT (`האם מותר להפסיק את כהונת המבקר הפנימי` FALSE FALSE TRUE TRUE)
#ASSERT NOT (`האם מותר להפסיק את כהונת המבקר הפנימי` FALSE FALSE FALSE FALSE)
-- 153(א): suspension needs the board's route in every case; the question has no consent input (fork F5).
-- The arguments: the board decided; it got the audit committee's position; he had a reasonable opportunity.
#ASSERT `האם מותר להשעות את המבקר הפנימי` TRUE TRUE TRUE
#ASSERT NOT (`האם מותר להשעות את המבקר הפנימי` TRUE TRUE FALSE)
#ASSERT NOT (`האם מותר להשעות את המבקר הפנימי` TRUE FALSE TRUE)
#ASSERT NOT (`האם מותר להשעות את המבקר הפנימי` FALSE TRUE TRUE)
-- 153(ב): the quorum to open the meeting is not less than a majority (more than half) of the board's members. The arguments: members of the board; members present at the opening.
#ASSERT `האם המנין החוקי בענין הפסקת כהונת המבקר הפנימי התקיים` 5 3
#ASSERT `האם המנין החוקי בענין הפסקת כהונת המבקר הפנימי התקיים` 4 3
#ASSERT `האם המנין החוקי בענין הפסקת כהונת המבקר הפנימי התקיים` 1 1
#ASSERT NOT (`האם המנין החוקי בענין הפסקת כהונת המבקר הפנימי התקיים` 5 2)
#ASSERT NOT (`האם המנין החוקי בענין הפסקת כהונת המבקר הפנימי התקיים` 4 2)

