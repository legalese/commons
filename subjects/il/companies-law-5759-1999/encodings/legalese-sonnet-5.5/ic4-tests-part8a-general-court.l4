IMPORT prelude
IMPORT `ic-core`
IMPORT `ic4-nouns`
IMPORT `ic4-part8a-general-court`

-- ic4-tests-part8a-general-court: tests of ic4-part8a-general-court.l4 (sections 342ב to 342כג).
-- Every expected value is decided from the text of the section (Hebrew, src:2234-2349) before the run, and written beside the assertion.
-- Boundary values are tested on each side of every figure the text states: three quarters, 21 days, twelve months, seven years.

§ `בדיקות: חלק 8א פרקים א ו־ב, פירוק בידי בית המשפט`

§§ `סעיף 342ב`

`הצבעה של 75 בעד ו־25 נגד` MEANS `הצבעה` WITH
    `קולות בעד` IS 75
    `קולות נגד` IS 25
    `קולות נמנעים` IS 0
`הצבעה של 74 בעד ו־26 נגד` MEANS `הצבעה` WITH
    `קולות בעד` IS 74
    `קולות נגד` IS 26
    `קולות נמנעים` IS 0
-- Three for, one against, a hundred abstaining: the abstentions are not counted (fork F13), and three of four is three quarters.
`הצבעה של 3 בעד, 1 נגד ו־100 נמנעים` MEANS `הצבעה` WITH
    `קולות בעד` IS 3
    `קולות נגד` IS 1
    `קולות נמנעים` IS 100
`הצבעה ללא קולות` MEANS `הצבעה` WITH
    `קולות בעד` IS 0
    `קולות נגד` IS 0
    `קולות נמנעים` IS 0

-- Three quarters, 21 days' notice, the proposal on the agenda: a special resolution.
#ASSERT `סעיף 342ב - החלטה מיוחדת` `הצבעה של 75 בעד ו־25 נגד` 21 FALSE TRUE
-- 74 of 100 is short of three quarters.
#ASSERT NOT (`סעיף 342ב - החלטה מיוחדת` `הצבעה של 74 בעד ו־26 נגד` 21 FALSE TRUE)
-- Abstentions are set aside.
#ASSERT `סעיף 342ב - החלטה מיוחדת` `הצבעה של 3 בעד, 1 נגד ו־100 נמנעים` 30 FALSE TRUE
-- No votes at all.
#ASSERT NOT (`סעיף 342ב - החלטה מיוחדת` `הצבעה ללא קולות` 30 FALSE TRUE)
-- 20 days' notice: too short unless all the shareholders consented to a closer time.
#ASSERT NOT (`סעיף 342ב - החלטה מיוחדת` `הצבעה של 75 בעד ו־25 נגד` 20 FALSE TRUE)
#ASSERT `סעיף 342ב - החלטה מיוחדת` `הצבעה של 75 בעד ו־25 נגד` 20 TRUE TRUE
#ASSERT `סעיף 342ב - החלטה מיוחדת` `הצבעה של 75 בעד ו־25 נגד` 0 TRUE TRUE
-- The proposal to dissolve under this Part was not on the agenda.
#ASSERT NOT (`סעיף 342ב - החלטה מיוחדת` `הצבעה של 75 בעד ו־25 נגד` 21 FALSE FALSE)
-- A "debt" is a monetary obligation of the company, certain or conditional, fixed or not, due or not yet due.
#ASSERT `סעיף 342ב - חוב` TRUE
#ASSERT NOT (`סעיף 342ב - חוב` FALSE)

§§ `סעיפים 342ג ו־342ד`

#ASSERT `פירוק בידי בית משפט` EQUALS `פירוק בידי בית משפט`
#ASSERT NOT (`פירוק בידי בית משפט` EQUALS `פירוק מרצון`)
-- (א): insolvency proceedings under way: dissolution proceedings may not begin.
#ASSERT `סעיף 342ד(א) - אסור להתחיל בהליכי פירוק לפי חלק 8א` TRUE
#ASSERT NOT (`סעיף 342ד(א) - אסור להתחיל בהליכי פירוק לפי חלק 8א` FALSE)
-- (ב): dissolution by a court has begun and the court found insolvency: it may stop the dissolution.
#ASSERT `סעיף 342ד(ב) - בית המשפט רשאי להורות על הפסקת הליכי הפירוק ועל המשך ההליכים לפי חוק חדלות פירעון` TRUE TRUE
#ASSERT NOT (`סעיף 342ד(ב) - בית המשפט רשאי להורות על הפסקת הליכי הפירוק ועל המשך ההליכים לפי חוק חדלות פירעון` TRUE FALSE)
#ASSERT NOT (`סעיף 342ד(ב) - בית המשפט רשאי להורות על הפסקת הליכי הפירוק ועל המשך ההליכים לפי חוק חדלות פירעון` FALSE TRUE)
-- (ג): in a voluntary dissolution, the trustee who found insolvency must tell the shareholders and creditors.
#ASSERT `סעיף 342ד(ג) - חובת הנאמן להודיע לבעלי המניות ולנושים על חדלות הפירעון` TRUE TRUE FALSE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 342ד(ג) - חובת הנאמן להודיע לבעלי המניות ולנושים על חדלות הפירעון` TRUE TRUE TRUE EQUALS `החובה חלה וקויימה`
#ASSERT `סעיף 342ד(ג) - חובת הנאמן להודיע לבעלי המניות ולנושים על חדלות הפירעון` TRUE FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`
-- (ג): and, when the conditions for an application exist, he must file it in the company's name.
#ASSERT `סעיף 342ד(ג) - חובת הנאמן להגיש בשם החברה בקשה לצו לפתיחת הליכים` TRUE TRUE TRUE FALSE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 342ד(ג) - חובת הנאמן להגיש בשם החברה בקשה לצו לפתיחת הליכים` TRUE TRUE TRUE TRUE EQUALS `החובה חלה וקויימה`
-- Conditions for the application not met: no duty to file.
#ASSERT `סעיף 342ד(ג) - חובת הנאמן להגיש בשם החברה בקשה לצו לפתיחת הליכים` TRUE TRUE FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`
-- (ד): insolvency proceedings opened after dissolution proceedings began: the court orders the dissolution ended.
#ASSERT `סעיף 342ד(ד) - בית המשפט יורה על סיום הליכי הפירוק והמשך הליכי חדלות הפירעון` TRUE
#ASSERT NOT (`סעיף 342ד(ד) - בית המשפט יורה על סיום הליכי הפירוק והמשך הליכי חדלות הפירעון` FALSE)

§§ `סעיפים 342ה ו־342ו`

#ASSERT `סעיף 342ה - בית המשפט המחוזי מוסמך לפרק את החברה` TRUE FALSE FALSE
#ASSERT `סעיף 342ה - בית המשפט המחוזי מוסמך לפרק את החברה` FALSE TRUE FALSE
#ASSERT `סעיף 342ה - בית המשפט המחוזי מוסמך לפרק את החברה` FALSE FALSE TRUE
#ASSERT NOT (`סעיף 342ה - בית המשפט המחוזי מוסמך לפרק את החברה` FALSE FALSE FALSE)
#ASSERT `סעיף 342ו(1) - קיימת עילה: החלטה מיוחדת על פירוק בידי בית המשפט` TRUE
#ASSERT NOT (`סעיף 342ו(1) - קיימת עילה: החלטה מיוחדת על פירוק בידי בית המשפט` FALSE)
-- (2): a year (twelve months) from registration without having begun business; eleven months is short of it.
#ASSERT `סעיף 342ו(2) - קיימת עילה: החברה לא התחילה בעסקיה בתוך שנה לאחר רישומה` 12 FALSE
#ASSERT NOT (`סעיף 342ו(2) - קיימת עילה: החברה לא התחילה בעסקיה בתוך שנה לאחר רישומה` 11 FALSE)
-- It began business within the year.
#ASSERT NOT (`סעיף 342ו(2) - קיימת עילה: החברה לא התחילה בעסקיה בתוך שנה לאחר רישומה` 30 TRUE)
-- (2): stopped business for a year.
#ASSERT `סעיף 342ו(2) - קיימת עילה: החברה הפסיקה את עסקיה למשך שנה` 12
#ASSERT NOT (`סעיף 342ו(2) - קיימת עילה: החברה הפסיקה את עסקיה למשך שנה` 11)
#ASSERT `סעיף 342ו(3) - קיימת עילה: מן הצדק והיושר לפרק את החברה` TRUE
#ASSERT NOT (`סעיף 342ו(3) - קיימת עילה: מן הצדק והיושר לפרק את החברה` FALSE)

-- Any one ground suffices: a special resolution; a year (twelve months) from registration without business; a year without business; or the court's finding that it is just and equitable.
#ASSERT `סעיף 342ו - קיימת עילה לפירוק החברה בידי בית משפט` TRUE 3 TRUE 0 FALSE
#ASSERT `סעיף 342ו - קיימת עילה לפירוק החברה בידי בית משפט` FALSE 12 FALSE 0 FALSE
#ASSERT `סעיף 342ו - קיימת עילה לפירוק החברה בידי בית משפט` FALSE 3 TRUE 12 FALSE
#ASSERT `סעיף 342ו - קיימת עילה לפירוק החברה בידי בית משפט` FALSE 3 TRUE 0 TRUE
#ASSERT NOT (`סעיף 342ו - קיימת עילה לפירוק החברה בידי בית משפט` FALSE 11 FALSE 11 FALSE)
#ASSERT NOT (`סעיף 342ו - קיימת עילה לפירוק החברה בידי בית משפט` FALSE 40 TRUE 0 FALSE)

§§ `סעיפים 342ז עד 342יא`

-- Who may apply: the company, a shareholder, and the Attorney General if he thought it just and equitable.
#ASSERT `סעיף 342ז - רשאי להגיש לבית המשפט בקשה לצו פירוק` `החברה המבקשת את פירוקה` FALSE
#ASSERT `סעיף 342ז - רשאי להגיש לבית המשפט בקשה לצו פירוק` `בעל מניה המבקש את פירוק החברה` FALSE
#ASSERT `סעיף 342ז - רשאי להגיש לבית המשפט בקשה לצו פירוק` `היועץ המשפטי לממשלה` TRUE
#ASSERT NOT (`סעיף 342ז - רשאי להגיש לבית המשפט בקשה לצו פירוק` `היועץ המשפטי לממשלה` FALSE)
-- A creditor or any other person is not named by the section.
#ASSERT NOT (`סעיף 342ז - רשאי להגיש לבית המשפט בקשה לצו פירוק` `אדם אחר המבקש את פירוק החברה` TRUE)
-- The application is complete only with the particulars, the affidavit and the documents the Minister prescribed.
#ASSERT `סעיף 342ח - הבקשה לצו פירוק הוגשה כנדרש` TRUE TRUE TRUE
#ASSERT NOT (`סעיף 342ח - הבקשה לצו פירוק הוגשה כנדרש` TRUE FALSE TRUE)
#ASSERT NOT (`סעיף 342ח - הבקשה לצו פירוק הוגשה כנדרש` FALSE TRUE TRUE)
#ASSERT NOT (`סעיף 342ח - הבקשה לצו פירוק הוגשה כנדרש` TRUE TRUE FALSE)
-- 342ט: publication, copy to the company, copy to a person who may be harmed.
#ASSERT `סעיף 342ט(א) - חובת המבקש לפרסם הודעה לציבור על הגשת הבקשה` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 342ט(א) - חובת המבקש לפרסם הודעה לציבור על הגשת הבקשה` TRUE TRUE EQUALS `החובה חלה וקויימה`
#ASSERT `סעיף 342ט(א) - חובת המבקש לפרסם הודעה לציבור על הגשת הבקשה` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`
#ASSERT `סעיף 342ט(ב) - חובת המבקש לשלוח עותק מהבקשה לחברה` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 342ט(ב) - חובת המבקש לשלוח עותק מהבקשה לחברה` TRUE TRUE EQUALS `החובה חלה וקויימה`
-- An application filed by the company itself: no copy to send to it.
#ASSERT `סעיף 342ט(ב) - חובת המבקש לשלוח עותק מהבקשה לחברה` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`
#ASSERT `סעיף 342ט(ג) - האדם רשאי לקבל מהמבקש עותק מהבקשה לצו פירוק` TRUE
#ASSERT NOT (`סעיף 342ט(ג) - האדם רשאי לקבל מהמבקש עותק מהבקשה לצו פירוק` FALSE)
#ASSERT `סעיף 342י(א) - האדם רשאי להגיש לבית המשפט התנגדות לבקשה לצו פירוק` TRUE
#ASSERT NOT (`סעיף 342י(א) - האדם רשאי להגיש לבית המשפט התנגדות לבקשה לצו פירוק` FALSE)
#ASSERT `סעיף 342יא - בית המשפט רשאי לתת צו פירוק` TRUE
#ASSERT NOT (`סעיף 342יא - בית המשפט רשאי לתת צו פירוק` FALSE)

§§ `סעיפים 342יב ו־342יג`

#ASSERT `סעיף 342יב(1) - חובת בית המשפט למנות נאמן לאחר מתן צו הפירוק` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 342יב(1) - חובת בית המשפט למנות נאמן לאחר מתן צו הפירוק` TRUE TRUE EQUALS `החובה חלה וקויימה`
#ASSERT `סעיף 342יב(1) - חובת בית המשפט למנות נאמן לאחר מתן צו הפירוק` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`
-- The freeze: after the order, a proceeding of the kinds section 29 freezes is frozen unless the court directed otherwise.
#ASSERT `סעיף 342יב(2) - ההליך נגד החברה מוקפא` TRUE `הליך מהסוגים המוקפאים לפי סעיף 29(1) ו־(3) עד (5) לחוק חדלות פירעון` FALSE
#ASSERT NOT (`סעיף 342יב(2) - ההליך נגד החברה מוקפא` TRUE `הליך מהסוגים המוקפאים לפי סעיף 29(1) ו־(3) עד (5) לחוק חדלות פירעון` TRUE)
#ASSERT NOT (`סעיף 342יב(2) - ההליך נגד החברה מוקפא` FALSE `הליך מהסוגים המוקפאים לפי סעיף 29(1) ו־(3) עד (5) לחוק חדלות פירעון` FALSE)
-- Not frozen: realising a fixed-charge asset, crystallising a floating charge, handing back an asset under retention of title.
#ASSERT NOT (`סעיף 342יב(2) - ההליך נגד החברה מוקפא` TRUE `מימוש נכס המשועבד בשעבוד קבוע שנעשה להבטחת פירעון חובות החברה לפני מתן הצו` FALSE)
#ASSERT NOT (`סעיף 342יב(2) - ההליך נגד החברה מוקפא` TRUE `גיבוש שעבוד צף שנעשה להבטחת פירעון חובות החברה לפני מתן הצו` FALSE)
#ASSERT NOT (`סעיף 342יב(2) - ההליך נגד החברה מוקפא` TRUE `העברת חזקה בנכס הכפוף לשיור בעלות מהחברה לבעל הנכס` FALSE)
#ASSERT NOT (`סעיף 342יב(2) - ההליך נגד החברה מוקפא` TRUE `הליך אחר` FALSE)
-- 342יג: the trustee's copy to the Registrar, then the Registrar's note.
#ASSERT `סעיף 342יג(א) - חובת הנאמן לשלוח לרשם עותק מצו הפירוק` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 342יג(א) - חובת הנאמן לשלוח לרשם עותק מצו הפירוק` TRUE TRUE EQUALS `החובה חלה וקויימה`
#ASSERT `סעיף 342יג(א) - חובת הרשם לרשום הערה על מתן צו הפירוק` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 342יג(א) - חובת הרשם לרשום הערה על מתן צו הפירוק` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`
#ASSERT `סעיף 342יג(ב) - חובת פרסום הודעה לציבור על מתן צו הפירוק` TRUE TRUE EQUALS `החובה חלה וקויימה`
#ASSERT `סעיף 342יג(ב) - בית המשפט רשאי להורות על המצאת הודעה על מתן הצו לגורמים שיורה` TRUE
#ASSERT NOT (`סעיף 342יג(ב) - בית המשפט רשאי להורות על המצאת הודעה על מתן הצו לגורמים שיורה` FALSE)

§§ `סעיף 342יד`

-- The sub-chapter of the Insolvency Law on appointing a trustee applies when the court appoints a trustee in a dissolution under this chapter.
#ASSERT `סעיף 342יד(א) - חלות הוראות סימן א׳ לפרק ו׳ בחלק ב׳ לחוק חדלות פירעון על מינוי הנאמן` TRUE
#ASSERT NOT (`סעיף 342יד(א) - חלות הוראות סימן א׳ לפרק ו׳ בחלק ב׳ לחוק חדלות פירעון על מינוי הנאמן` FALSE)
#ASSERT `סעיף 342יד(א)(1) - בית המשפט רשאי למנות נאמן שלא מתוך רשימת הנאמנים` TRUE
#ASSERT NOT (`סעיף 342יד(א)(1) - בית המשפט רשאי למנות נאמן שלא מתוך רשימת הנאמנים` FALSE)
-- Who may propose candidates: the company, a shareholder, the Attorney General only if he filed the application.
#ASSERT `סעיף 342יד(א)(2) - רשאי להציע מועמדים לתפקיד הנאמן` TRUE FALSE FALSE
#ASSERT `סעיף 342יד(א)(2) - רשאי להציע מועמדים לתפקיד הנאמן` FALSE TRUE FALSE
#ASSERT `סעיף 342יד(א)(2) - רשאי להציע מועמדים לתפקיד הנאמן` FALSE FALSE TRUE
#ASSERT NOT (`סעיף 342יד(א)(2) - רשאי להציע מועמדים לתפקיד הנאמן` FALSE FALSE FALSE)
#ASSERT `סעיף 342יד(א)(3) - הוראות שכר הנאמן` FALSE EQUALS `השכר נקבע לפי סעיף 39 לחוק חדלות פירעון בשינויים המחויבים`
#ASSERT `סעיף 342יד(א)(3) - הוראות שכר הנאמן` TRUE EQUALS `השכר נקבע לפי הוראות מיוחדות שקבע השר`
#ASSERT `סעיף 342יד(א)(4) - חובת הממונה לפרסם את שמות הנאמנים` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 342יד(א)(4) - חובת הממונה לפרסם את שמות הנאמנים` TRUE TRUE EQUALS `החובה חלה וקויימה`
-- (ב): the three limbs together; a trustee who has done only some has not done the duty.
#ASSERT `סעיף 342יד(ב) - חובת הנאמן לפעול במהירות האפשרית להשלמת הליכי הפירוק` TRUE TRUE TRUE TRUE EQUALS `החובה חלה וקויימה`
#ASSERT `סעיף 342יד(ב) - חובת הנאמן לפעול במהירות האפשרית להשלמת הליכי הפירוק` TRUE TRUE TRUE FALSE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 342יד(ב) - חובת הנאמן לפעול במהירות האפשרית להשלמת הליכי הפירוק` TRUE FALSE TRUE TRUE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 342יד(ב) - חובת הנאמן לפעול במהירות האפשרית להשלמת הליכי הפירוק` FALSE FALSE FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`
#ASSERT `סעיף 342יד(ג) - חלות הוראות סימן ב׳ לפרק ו׳ בחלק ב׳ לחוק חדלות פירעון` TRUE
#ASSERT NOT (`סעיף 342יד(ג) - חלות הוראות סימן ב׳ לפרק ו׳ בחלק ב׳ לחוק חדלות פירעון` FALSE)
#ASSERT `סעיף 342יד(ד) - חובת הנאמן להודיע לבית המשפט על חדלות הפירעון` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 342יד(ד) - חובת הנאמן להודיע לבית המשפט על חדלות הפירעון` TRUE TRUE EQUALS `החובה חלה וקויימה`

§§ `סעיפים 342טו עד 342יט`

#ASSERT (`סעיף 342טו - הוראות חוק חדלות פירעון שחלות על הליכי הפירוק בידי בית המשפט` TRUE FALSE)'s `תביעות חוב ואישורן: פרק א׳ לחלק ד׳ לחוק חדלות פירעון והתקנות לפיו`
-- Regulations under 342נד(1) can provide otherwise for proofs of debt only.
#ASSERT NOT ((`סעיף 342טו - הוראות חוק חדלות פירעון שחלות על הליכי הפירוק בידי בית המשפט` TRUE TRUE)'s `תביעות חוב ואישורן: פרק א׳ לחלק ד׳ לחוק חדלות פירעון והתקנות לפיו`)
#ASSERT (`סעיף 342טו - הוראות חוק חדלות פירעון שחלות על הליכי הפירוק בידי בית המשפט` TRUE TRUE)'s `מימוש נכסי החברה בידי הנאמן: סעיף 227 לחוק חדלות פירעון`
#ASSERT (`סעיף 342טו - הוראות חוק חדלות פירעון שחלות על הליכי הפירוק בידי בית המשפט` TRUE FALSE)'s `כינוס נכסי החברה וניהולם: פרק ג׳ לחלק ד׳ לחוק חדלות פירעון`
#ASSERT NOT ((`סעיף 342טו - הוראות חוק חדלות פירעון שחלות על הליכי הפירוק בידי בית המשפט` FALSE FALSE)'s `הכללת נכסים בקופת הפירוק: סעיפים 216(1) ו־218 לחוק חדלות פירעון`)
-- 342טז: after collection and realisation, pay the expenses and the approved debts, both.
#ASSERT `סעיף 342טז(א) - חובת הנאמן לשלם את הוצאות הפירוק ואת חובות החברה לנושים` TRUE TRUE TRUE EQUALS `החובה חלה וקויימה`
#ASSERT `סעיף 342טז(א) - חובת הנאמן לשלם את הוצאות הפירוק ואת חובות החברה לנושים` TRUE TRUE FALSE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 342טז(א) - חובת הנאמן לשלם את הוצאות הפירוק ואת חובות החברה לנושים` FALSE FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`
#ASSERT `סעיף 342טז(ב) - חובת הנאמן להודיע לפני תשלום החובות ולקצוב זמן לביסוס תביעות` TRUE TRUE TRUE TRUE EQUALS `החובה חלה וקויימה`
#ASSERT `סעיף 342טז(ב) - חובת הנאמן להודיע לפני תשלום החובות ולקצוב זמן לביסוס תביעות` TRUE TRUE TRUE FALSE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 342טז(ב) - חובת הנאמן להודיע לפני תשלום החובות ולקצוב זמן לביסוס תביעות` FALSE TRUE TRUE TRUE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`
-- 342יז: an estate of 1000, expenses of 100, approved debts of 400: 500 remain; a shareholder entitled to a tenth gets 50.
#ASSERT `סעיף 342יז - היתרה שנותרה לחלוקה בין בעלי המניות` 1000 100 400 EQUALS 500
-- A shortfall leaves nothing, not a negative number.
#ASSERT `סעיף 342יז - היתרה שנותרה לחלוקה בין בעלי המניות` 300 100 400 EQUALS 0
#ASSERT `סעיף 342יז - היתרה שנותרה לחלוקה בין בעלי המניות` 500 100 400 EQUALS 0
#ASSERT `סעיף 342יז - חלקו של בעל המניות ביתרה` 1000 100 400 0.1 EQUALS 50
#ASSERT `סעיף 342יז - חלקו של בעל המניות ביתרה` 1000 100 400 (25%) EQUALS 125
#ASSERT `סעיף 342יז - חלקו של בעל המניות ביתרה` 300 100 400 (25%) EQUALS 0
-- 342יח: interim payments need the court's approval and the trustee's view that they do not harm the dissolution.
#ASSERT `סעיף 342יח - הנאמן רשאי לשלם תשלומי ביניים` TRUE TRUE
#ASSERT NOT (`סעיף 342יח - הנאמן רשאי לשלם תשלומי ביניים` FALSE TRUE)
#ASSERT NOT (`סעיף 342יח - הנאמן רשאי לשלם תשלומי ביניים` TRUE FALSE)
-- 342יח(ב): sections 239 and 241 of the Insolvency Law apply to an interim payment.
#ASSERT `סעיף 342יח(ב) - חלים סעיפים 239 ו־241 לחוק חדלות פירעון על תשלומי הביניים` TRUE
#ASSERT NOT (`סעיף 342יח(ב) - חלים סעיפים 239 ו־241 לחוק חדלות פירעון על תשלומי הביניים` FALSE)
#ASSERT `סעיף 342יט - בעל מניה או נושה רשאי לפנות לבית המשפט בשאלה הנוגעת לזכויותיו בהליכי הפירוק` TRUE FALSE
#ASSERT `סעיף 342יט - בעל מניה או נושה רשאי לפנות לבית המשפט בשאלה הנוגעת לזכויותיו בהליכי הפירוק` FALSE TRUE
#ASSERT NOT (`סעיף 342יט - בעל מניה או נושה רשאי לפנות לבית המשפט בשאלה הנוגעת לזכויותיו בהליכי הפירוק` FALSE FALSE)

§§ `סעיפים 342כ עד 342כג`

#ASSERT `סעיף 342כ - לבית המשפט הסמכויות שלפי סעיפים 279, 281 עד 285 ו־289 עד 292 לחוק חדלות פירעון` TRUE
#ASSERT NOT (`סעיף 342כ - לבית המשפט הסמכויות שלפי סעיפים 279, 281 עד 285 ו־289 עד 292 לחוק חדלות פירעון` FALSE)
#ASSERT `סעיף 342כא - בית המשפט רשאי להורות על צירוף הממונה להליכי הפירוק` TRUE
#ASSERT NOT (`סעיף 342כא - בית המשפט רשאי להורות על צירוף הממונה להליכי הפירוק` FALSE)
-- 342כב(א): after the order, at the request of the company or a shareholder, if the court found no justification to go on.
#ASSERT `סעיף 342כב(א) - בית המשפט רשאי להורות על ביטול צו הפירוק` TRUE TRUE TRUE
#ASSERT NOT (`סעיף 342כב(א) - בית המשפט רשאי להורות על ביטול צו הפירוק` FALSE TRUE TRUE)
#ASSERT NOT (`סעיף 342כב(א) - בית המשפט רשאי להורות על ביטול צו הפירוק` TRUE FALSE TRUE)
#ASSERT NOT (`סעיף 342כב(א) - בית המשפט רשאי להורות על ביטול צו הפירוק` TRUE TRUE FALSE)
#ASSERT `סעיף 342כב(ב) - בית המשפט רשאי להשהות את ביטול צו הפירוק כדי לאפשר הטלה מחדש של עיקולים` TRUE
#ASSERT `סעיף 342כב(ג) - ביטול צו הפירוק אינו פוגע בתוקפה של פעולה משפטית שנעשתה כדין לפני הביטול` TRUE
#ASSERT NOT (`סעיף 342כב(ג) - ביטול צו הפירוק אינו פוגע בתוקפה של פעולה משפטית שנעשתה כדין לפני הביטול` FALSE)
#ASSERT `סעיף 342כב(ד) - חובת הנאמן לשלוח לרשם העתק מההחלטה על ביטול צו הפירוק` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 342כב(ד) - חובת הרשם למחוק את הרישום על צו הפירוק` TRUE TRUE EQUALS `החובה חלה וקויימה`
#ASSERT `סעיף 342כב(ד) - חובת הרשם למחוק את הרישום על צו הפירוק` FALSE FALSE EQUALS `החובה אינה חלה בלא שהתקיים התנאי`
#ASSERT `סעיף 342כג(א) - חובת הנאמן להגיש דוח מסכם לבית המשפט ולבעלי המניות` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 342כג(א) - חובת הנאמן להגיש דוח מסכם לבית המשפט ולבעלי המניות` TRUE TRUE EQUALS `החובה חלה וקויימה`
-- (ב): the court is satisfied the dissolution is complete and ordered the liquidation: the company is liquidated from the order.
#ASSERT `סעיף 342כג(ב) - החברה מחוסלת מיום מתן צו החיסול` TRUE TRUE
#ASSERT NOT (`סעיף 342כג(ב) - החברה מחוסלת מיום מתן צו החיסול` TRUE FALSE)
#ASSERT NOT (`סעיף 342כג(ב) - החברה מחוסלת מיום מתן צו החיסול` FALSE TRUE)
-- (ג): documents kept at least seven years; six years is short.
#ASSERT `סעיף 342כג(ג) - הוראת בית המשפט על המסמכים שומרת אותם לתקופה שאינה פחותה משבע שנים` 7
#ASSERT `סעיף 342כג(ג) - הוראת בית המשפט על המסמכים שומרת אותם לתקופה שאינה פחותה משבע שנים` 10
#ASSERT NOT (`סעיף 342כג(ג) - הוראת בית המשפט על המסמכים שומרת אותם לתקופה שאינה פחותה משבע שנים` 6)
#ASSERT `סעיף 342כג(ד) - חובת הנאמן לשלוח לרשם העתק מצו החיסול` TRUE TRUE EQUALS `החובה חלה וקויימה`
#ASSERT `סעיף 342כג(ד) - חובת הרשם לרשום את דבר החיסול` TRUE FALSE EQUALS `החובה חלה וטרם קויימה`
#ASSERT `סעיף 342כג(ה) - בית המשפט יורה על סיום כהונתו של הנאמן` TRUE
#ASSERT NOT (`סעיף 342כג(ה) - בית המשפט יורה על סיום כהונתו של הנאמן` FALSE)
