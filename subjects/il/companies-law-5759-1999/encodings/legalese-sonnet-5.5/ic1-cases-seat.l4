IMPORT prelude
IMPORT daydate
IMPORT `ic-core`
IMPORT `ic-core-company-kinds`
IMPORT `ic-core-meetings`
IMPORT `ic-core-people`
IMPORT `ic1-majorities`
IMPORT `ic1-part2-ch1-incorporation`
IMPORT `ic1-part2-ch2-articles`
IMPORT `ic1-part2-ch2-name-capital`
IMPORT `ic1-part2-ch3-registrar`
IMPORT `ic1-part3-ch1-organs`
IMPORT `ic1-part3-ch2-gm-powers-and-calling`
IMPORT `ic1-part3-ch2-gm-convening`
IMPORT `ic1-part3-ch2-gm-conduct`
IMPORT `ic1-part3-ch3-board`
IMPORT `ic1-part3-ch3-committees`
IMPORT `ic1-seat`

-- Worked cases for ic1-seat.l4 (Companies Law, 5759-1999, sections 2 to 118B): at least one case per question.
-- Source: the Hebrew text on Hebrew Wikisource (raw MediaWiki), an unofficial consolidation, not the official text.
-- Every expected value was decided by hand from the text of the Law (the comment above each case says why), not copied from a run.
-- An input left out of a case below is the neutral answer: FALSE for a yes/no question, 0 for a number, 1 January 2020 for a date.
-- Some cases are written so that a wrong order of inputs inside a question would change the answer.
-- A case whose answer is NOTHING is a case the encoding does not decide: the text is silent or the rule does not apply.

§ `חוק החברות – מקרים לשאלות של מי שמייסד חברה, מכהן בה או מחזיק מניות בה`

§§ `חלק 2 פרק 1: התאגדות`

-- s 2: no purpose of the company is unlawful, immoral or against public policy, so anyone may found it.
#ASSERT `האם אני רשאי לייסד חברה` FALSE FALSE FALSE EQUALS TRUE
-- s 2: one purpose is immoral.
#ASSERT `האם אני רשאי לייסד חברה` FALSE TRUE FALSE EQUALS FALSE
-- s 2: one purpose is against the law.
#ASSERT `האם אני רשאי לייסד חברה` TRUE FALSE FALSE EQUALS FALSE
-- s 2: one purpose is against public policy.
#ASSERT `האם אני רשאי לייסד חברה` FALSE FALSE TRUE EQUALS FALSE
-- s 3: a company may have a single shareholder.
#ASSERT `האם לחברה שלי יכול להיות בעל מניות אחד` 1 EQUALS (JUST TRUE)
-- s 3: the Law says nothing about a company with no shareholder, so the case is not decided.
#ASSERT `האם לחברה שלי יכול להיות בעל מניות אחד` 0 EQUALS NOTHING
-- s 4: capable of every right, duty and act consistent with its nature as a body corporate.
#ASSERT `האם החברה שלי כשרה לזכות, לחובה או לפעולה` TRUE EQUALS TRUE
-- s 4: an act inconsistent with its nature as a body corporate is outside the capacity.
#ASSERT `האם החברה שלי כשרה לזכות, לחובה או לפעולה` FALSE EQUALS FALSE
-- s 5: exists from the day of incorporation in the certificate; 1 March 2020 is after 5 January 2020.
#ASSERT `האם החברה שלי קיימת ביום מסוים` TRUE TRUE (YMD 2020 1 5) FALSE (YMD 2020 1 1) (YMD 2020 3 1) EQUALS TRUE
-- s 5: the day before the day of incorporation.
#ASSERT `האם החברה שלי קיימת ביום מסוים` TRUE TRUE (YMD 2020 1 5) FALSE (YMD 2020 1 1) (YMD 2020 1 4) EQUALS FALSE
-- s 5: the incorporation lapsed on 30 June 2021 on liquidation, and 15 July 2021 is after that.
#ASSERT `האם החברה שלי קיימת ביום מסוים` TRUE TRUE (YMD 2020 1 5) TRUE (YMD 2021 6 30) (YMD 2021 7 15) EQUALS FALSE
-- s 5: a day between incorporation and the lapse.
#ASSERT `האם החברה שלי קיימת ביום מסוים` TRUE TRUE (YMD 2020 1 5) TRUE (YMD 2021 6 30) (YMD 2021 5 15) EQUALS TRUE
-- s 5: a certificate the Registrar has not signed is not a certificate of incorporation.
#ASSERT `האם החברה שלי קיימת ביום מסוים` FALSE TRUE (YMD 2020 1 5) FALSE (YMD 2020 1 1) (YMD 2020 3 1) EQUALS FALSE
-- s 6(a): the court finds it just, an exceptional case, the separate personality was used to deceive, and the shareholder was aware.
#ASSERT `האם בית משפט רשאי לייחס לי חוב של החברה שאני בעל מניות בה` TRUE TRUE TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS TRUE
-- s 6(a): without the court's finding that it is just and right there is no attribution.
#ASSERT `האם בית משפט רשאי לייחס לי חוב של החברה שאני בעל מניות בה` FALSE TRUE TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS FALSE
-- s 6(a): only in the exceptional cases.
#ASSERT `האם בית משפט רשאי לייחס לי חוב של החברה שאני בעל מניות בה` TRUE FALSE TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS FALSE
-- s 6(a)(1)(a): prejudicing a creditor is enough, as deceiving a person is.
#ASSERT `האם בית משפט רשאי לייחס לי חוב של החברה שאני בעל מניות בה` TRUE TRUE FALSE TRUE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS TRUE
-- s 6(a)(1)(b): harming the company's purpose counts only together with taking an unreasonable risk about paying its debts.
#ASSERT `האם בית משפט רשאי לייחס לי חוב של החברה שאני בעל מניות בה` TRUE TRUE FALSE FALSE TRUE FALSE TRUE FALSE FALSE FALSE EQUALS FALSE
-- s 6(a)(1)(b): harm to purpose together with an unreasonable risk.
#ASSERT `האם בית משפט רשאי לייחס לי חוב של החברה שאני בעל מניות בה` TRUE TRUE FALSE FALSE TRUE TRUE TRUE FALSE FALSE FALSE EQUALS TRUE
-- s 6(a): the shareholder must have been aware of the use.
#ASSERT `האם בית משפט רשאי לייחס לי חוב של החברה שאני בעל מניות בה` TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS FALSE
-- s 6(a)(2): suspicion and a refusal to check are treated as awareness.
#ASSERT `האם בית משפט רשאי לייחס לי חוב של החברה שאני בעל מניות בה` TRUE TRUE TRUE FALSE FALSE FALSE FALSE TRUE TRUE FALSE EQUALS TRUE
-- s 6(a)(2): except where he was merely negligent.
#ASSERT `האם יראו אותי כמודע לשימוש בישות המשפטית הנפרדת` FALSE TRUE TRUE TRUE EQUALS FALSE
-- s 6(a)(2): suspected and refrained from checking, not merely negligent.
#ASSERT `האם יראו אותי כמודע לשימוש בישות המשפטית הנפרדת` FALSE TRUE TRUE FALSE EQUALS TRUE
-- s 6(a)(2): suspicion without refraining from checking is not enough.
#ASSERT `האם יראו אותי כמודע לשימוש בישות המשפטית הנפרדת` FALSE TRUE FALSE FALSE EQUALS FALSE
-- s 6(a)(2): actual awareness.
#ASSERT `האם יראו אותי כמודע לשימוש בישות המשפטית הנפרדת` TRUE FALSE FALSE FALSE EQUALS TRUE
-- s 6(b): the court finds it just and right having regard to the purpose of the law or agreement.
#ASSERT `האם בית משפט רשאי לייחס תכונה, זכות או חובה שלי לחברה או להפך` TRUE EQUALS TRUE
-- s 6(b): without that finding.
#ASSERT `האם בית משפט רשאי לייחס תכונה, זכות או חובה שלי לחברה או להפך` FALSE EQUALS FALSE
-- s 6(c): the conditions for attributing the debt under subsection (a) are met.
#ASSERT `האם בית משפט רשאי להשעות את זכותי לפירעון חוב שהחברה חבה לי` TRUE TRUE TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS TRUE
-- s 6(c): the conditions of subsection (a) are not met (not an exceptional case).
#ASSERT `האם בית משפט רשאי להשעות את זכותי לפירעון חוב שהחברה חבה לי` TRUE FALSE TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS FALSE
-- s 7(a): after an order under s 6(a), a period of up to five years.
#ASSERT `האם בית משפט רשאי להגביל אותי מלכהן כדירקטור, כמנהל כללי או מלהיות מעורב בחברה` TRUE 5 EQUALS TRUE
-- s 7(a): a period over five years is beyond the court's power.
#ASSERT `האם בית משפט רשאי להגביל אותי מלכהן כדירקטור, כמנהל כללי או מלהיות מעורב בחברה` TRUE 6 EQUALS FALSE
-- s 7(a): no order under s 6(a), so no restriction order.
#ASSERT `האם בית משפט רשאי להגביל אותי מלכהן כדירקטור, כמנהל כללי או מלהיות מעורב בחברה` FALSE 3 EQUALS FALSE
-- s 7(b): the court that gave a restriction order sends the Registrar notice of it.
#ASSERT `האם בית המשפט ישלח לרשם הודעה על צו ההגבלה שניתן נגדי` TRUE EQUALS TRUE
-- s 7(b): no restriction order, no notice.
#ASSERT `האם בית המשפט ישלח לרשם הודעה על צו ההגבלה שניתן נגדי` FALSE EQUALS FALSE
-- s 7(c): one who breached a restriction order is liable for the company's debts created in the restriction period.
#ASSERT `האם אני חב בחובות החברה שנוצרו בתקופת ההגבלה` TRUE TRUE TRUE EQUALS TRUE
-- s 7(c): a debt created outside the restriction period.
#ASSERT `האם אני חב בחובות החברה שנוצרו בתקופת ההגבלה` TRUE TRUE FALSE EQUALS FALSE
-- s 7(c): no breach of the order.
#ASSERT `האם אני חב בחובות החברה שנוצרו בתקופת ההגבלה` FALSE TRUE TRUE EQUALS FALSE
-- s 8(a): filed electronically on the Minister's form, with a copy of the articles and the first directors' declaration.
#ASSERT `האם בקשת רישום החברה שהגשתי הוגשה כדין` TRUE FALSE TRUE TRUE TRUE EQUALS TRUE
-- s 8(a): no copy of the articles.
#ASSERT `האם בקשת רישום החברה שהגשתי הוגשה כדין` TRUE FALSE TRUE FALSE TRUE EQUALS FALSE
-- s 8(a)(2): no declaration of the first directors.
#ASSERT `האם בקשת רישום החברה שהגשתי הוגשה כדין` TRUE FALSE TRUE TRUE FALSE EQUALS FALSE
-- s 8(b): not electronic, but the Registrar allowed it.
#ASSERT `האם בקשת רישום החברה שהגשתי הוגשה כדין` FALSE TRUE TRUE TRUE TRUE EQUALS TRUE
-- s 8(a): not electronic and not allowed otherwise.
#ASSERT `האם בקשת רישום החברה שהגשתי הוגשה כדין` FALSE FALSE TRUE TRUE TRUE EQUALS FALSE
-- s 8(b): the Registrar may allow it where circumstances justify.
#ASSERT `האם הרשם רשאי לאפשר לי להגיש בקשת רישום שלא בדרך אלקטרונית` TRUE EQUALS TRUE
-- s 8(b): no circumstances justify it.
#ASSERT `האם הרשם רשאי לאפשר לי להגיש בקשת רישום שלא בדרך אלקטרונית` FALSE EQUALS FALSE
-- s 9(a): one who applies to register a company pays the registration fee on filing.
#ASSERT `האם עליי לשלם אגרת רישום בעת הגשת הבקשה לרשום חברה` TRUE EQUALS TRUE
-- s 9(a): one who is not applying to register a company.
#ASSERT `האם עליי לשלם אגרת רישום בעת הגשת הבקשה לרשום חברה` FALSE EQUALS FALSE
-- s 9(b): a company incorporated under this Law or the Ordinance pays an annual fee every year.
#ASSERT `האם החברה שלי חייבת בתשלום אגרה שנתית` TRUE FALSE FALSE FALSE EQUALS TRUE
-- s 9(c): the word company includes a foreign company, a body corporate incorporated abroad that is not a partnership.
#ASSERT `האם החברה שלי חייבת בתשלום אגרה שנתית` FALSE TRUE FALSE TRUE EQUALS TRUE
-- s 9(c): a partnership is not a foreign company.
#ASSERT `האם החברה שלי חייבת בתשלום אגרה שנתית` FALSE TRUE TRUE TRUE EQUALS FALSE
-- s 10(a): the Registrar registers a company if he finds every requirement met.
#ASSERT `האם הרשם חייב לרשום את החברה שלי` TRUE EQUALS TRUE
-- s 10(a): he has not found that the requirements were met.
#ASSERT `האם הרשם חייב לרשום את החברה שלי` FALSE EQUALS FALSE
-- s 10(b): the Registrar gives each company a registration number and states it in the certificate.
#ASSERT `האם החברה שלי זכאית למספר רישום ולתעודת התאגדות` TRUE EQUALS TRUE
-- s 10(b): an unregistered company.
#ASSERT `האם החברה שלי זכאית למספר רישום ולתעודת התאגדות` FALSE EQUALS FALSE
-- s 10(d): a certificate delivered to the company is conclusive evidence that the requirements were met.
#ASSERT `האם תעודת ההתאגדות של החברה שלי היא ראיה חלוטה לכך שנתמלאו דרישות הרישום` TRUE TRUE (YMD 2020 1 5) TRUE EQUALS TRUE
-- s 10(d): a certificate not yet delivered to the company.
#ASSERT `האם תעודת ההתאגדות של החברה שלי היא ראיה חלוטה לכך שנתמלאו דרישות הרישום` TRUE TRUE (YMD 2020 1 5) FALSE EQUALS FALSE
-- s 10(d): a document the Registrar has not signed is no certificate of incorporation.
#ASSERT `האם תעודת ההתאגדות של החברה שלי היא ראיה חלוטה לכך שנתמלאו דרישות הרישום` FALSE TRUE (YMD 2020 1 1) TRUE EQUALS FALSE
-- s 10(e): the certificate does not cure a defect in the articles or remove the need to correct it.
#ASSERT `האם עליי עדיין לתקן פגם בתקנון אף שניתנה תעודת התאגדות` TRUE EQUALS TRUE
-- s 10(e): no defect, nothing to correct.
#ASSERT `האם עליי עדיין לתקן פגם בתקנון אף שניתנה תעודת התאגדות` FALSE EQUALS FALSE
-- s 11(a): the interests of employees may be taken into account.
#ASSERT `האם החברה שלי רשאית להביא בחשבון בשיקוליה העסקיים ענין מסוים` `ענינם של עובדי החברה` FALSE EQUALS TRUE
-- s 11(a): another interest that is not a business consideration to maximise profit.
#ASSERT `האם החברה שלי רשאית להביא בחשבון בשיקוליה העסקיים ענין מסוים` `ענין אחר שאינו מנוי בסעיף 11(א)` FALSE EQUALS FALSE
-- s 11(a): another interest that is a business consideration to maximise profit.
#ASSERT `האם החברה שלי רשאית להביא בחשבון בשיקוליה העסקיים ענין מסוים` `ענין אחר שאינו מנוי בסעיף 11(א)` TRUE EQUALS TRUE
-- s 11(a): a donation made on business considerations to maximise profit.
#ASSERT `האם החברה שלי רשאית לתרום סכום למטרה ראויה` FALSE TRUE FALSE FALSE FALSE EQUALS (JUST TRUE)
-- s 11(a): a reasonable sum to a worthy cause, with a provision in the articles, even without business considerations.
#ASSERT `האם החברה שלי רשאית לתרום סכום למטרה ראויה` FALSE FALSE TRUE TRUE TRUE EQUALS (JUST TRUE)
-- s 11(a): no provision in the articles and not a business consideration.
#ASSERT `האם החברה שלי רשאית לתרום סכום למטרה ראויה` FALSE FALSE TRUE TRUE FALSE EQUALS (JUST FALSE)
-- s 11(b): subsection (a) does not apply to a public-benefit company, whose purpose is governed elsewhere in the Law (outside this range).
#ASSERT `האם החברה שלי רשאית לתרום סכום למטרה ראויה` TRUE TRUE FALSE FALSE FALSE EQUALS NOTHING

§§ `פרק 1 סימן ה׳: פעולות שנעשו על ידי יזם`

-- s 12(a): an act done in the name or place of a company before its incorporation.
#ASSERT `האם החברה רשאית לאשר פעולה שעשיתי כיזם לפני התאגדותה` TRUE TRUE EQUALS TRUE
-- s 12(a): the company had already been incorporated.
#ASSERT `האם החברה רשאית לאשר פעולה שעשיתי כיזם לפני התאגדותה` TRUE FALSE EQUALS FALSE
-- s 12(a): not done in the company's name or place.
#ASSERT `האם החברה רשאית לאשר פעולה שעשיתי כיזם לפני התאגדותה` FALSE TRUE EQUALS FALSE
-- s 12(b): a right acquired in good faith, for value, before the approval may not be harmed.
#ASSERT `האם אישור החברה בדיעבד רשאי לפגוע בזכות שרכשתי` TRUE TRUE TRUE EQUALS FALSE
-- s 12(b): a right not acquired for value is not protected.
#ASSERT `האם אישור החברה בדיעבד רשאי לפגוע בזכות שרכשתי` TRUE FALSE TRUE EQUALS TRUE
-- s 13(a)(1): the third party knew, the company did not approve within a year of the act, and 13 months have passed.
#ASSERT `האם הברירה בידי לראות ביזם בעל דברי או לחזור בי מהפעולה` TRUE FALSE 13 FALSE FALSE 0 FALSE FALSE 0 FALSE EQUALS (JUST TRUE)
-- s 13(a)(1): twelve months is still within the year.
#ASSERT `האם הברירה בידי לראות ביזם בעל דברי או לחזור בי מהפעולה` TRUE FALSE 12 FALSE FALSE 0 FALSE FALSE 0 FALSE EQUALS (JUST FALSE)
-- s 13(a)(2): the circumstances show the company will not incorporate and the third party gave the promoter thirty days' notice.
#ASSERT `האם הברירה בידי לראות ביזם בעל דברי או לחזור בי מהפעולה` TRUE FALSE 0 TRUE TRUE 30 FALSE FALSE 0 FALSE EQUALS (JUST TRUE)
-- s 13(a)(2): only twenty-nine days have passed since the notice.
#ASSERT `האם הברירה בידי לראות ביזם בעל דברי או לחזור בי מהפעולה` TRUE FALSE 0 TRUE TRUE 29 FALSE FALSE 0 FALSE EQUALS (JUST FALSE)
-- s 13(a)(3): the company did not approve within thirty days of the demand, and 31 days have passed.
#ASSERT `האם הברירה בידי לראות ביזם בעל דברי או לחזור בי מהפעולה` TRUE FALSE 0 FALSE FALSE 0 TRUE FALSE 31 FALSE EQUALS (JUST TRUE)
-- s 13(a): the third party did not know of the promotion, so section 13 does not give the option (section 14 applies).
#ASSERT `האם הברירה בידי לראות ביזם בעל דברי או לחזור בי מהפעולה` FALSE FALSE 20 FALSE FALSE 0 FALSE FALSE 0 FALSE EQUALS (JUST FALSE)
-- s 13(c): the promoter and the third party stipulated otherwise, so their own terms govern and the Law does not decide.
#ASSERT `האם הברירה בידי לראות ביזם בעל דברי או לחזור בי מהפעולה` TRUE FALSE 20 FALSE FALSE 0 FALSE FALSE 0 TRUE EQUALS NOTHING
-- s 13(b): once the company approved the act the promoter is no longer liable or entitled under it.
#ASSERT `האם אני כיזם עדיין חייב או זכאי בשל הפעולה` TRUE EQUALS FALSE
-- s 13(b): the company has not approved the act.
#ASSERT `האם אני כיזם עדיין חייב או זכאי בשל הפעולה` FALSE EQUALS TRUE
-- s 14(1): the third party did not know of the promotion, so the act binds or entitles the promoter.
#ASSERT `האם פעולת היזם מחייבת או מזכה אותי כיזם כשהצד השלישי לא ידע על היזמות` FALSE EQUALS TRUE
-- s 14: it applies only where the third party did not know.
#ASSERT `האם פעולת היזם מחייבת או מזכה אותי כיזם כשהצד השלישי לא ידע על היזמות` TRUE EQUALS FALSE
-- s 14(2): the incorporated company may approve if approval does not contradict the act by its nature, terms or circumstances.
#ASSERT `האם החברה שהתאגדה רשאית לאשר את פעולת היזם שהצד השלישי לא ידע עליה` FALSE TRUE FALSE FALSE FALSE EQUALS TRUE
-- s 14(2): approval would contradict the act by its terms.
#ASSERT `האם החברה שהתאגדה רשאית לאשר את פעולת היזם שהצד השלישי לא ידע עליה` FALSE TRUE FALSE TRUE FALSE EQUALS FALSE
-- s 14(2): the company has not yet been incorporated.
#ASSERT `האם החברה שהתאגדה רשאית לאשר את פעולת היזם שהצד השלישי לא ידע עליה` FALSE FALSE FALSE FALSE FALSE EQUALS FALSE
-- s 14: the third party knew of the promotion, so section 14 does not apply.
#ASSERT `האם החברה שהתאגדה רשאית לאשר את פעולת היזם שהצד השלישי לא ידע עליה` TRUE TRUE FALSE FALSE FALSE EQUALS FALSE
-- s 14(2): once the company approved, the act binds both the company and the promoter, jointly and severally.
#ASSERT `האם אני כיזם חב ביחד ולחוד עם החברה לאחר שאישרה את הפעולה` TRUE EQUALS TRUE
-- s 14(2): not yet approved.
#ASSERT `האם אני כיזם חב ביחד ולחוד עם החברה לאחר שאישרה את הפעולה` FALSE EQUALS FALSE
-- s 14(2): once approved the act entitles only the company, not the promoter.
#ASSERT `האם הפעולה מזכה אותי כיזם לאחר שהחברה אישרה אותה` TRUE EQUALS FALSE
-- s 14(1): before approval the act entitles the promoter.
#ASSERT `האם הפעולה מזכה אותי כיזם לאחר שהחברה אישרה אותה` FALSE EQUALS TRUE

§§ `פרק 2 סימן א׳: תקנון החברה`

-- s 15: every company has articles.
#ASSERT `האם לחברה שלי יש תקנון כנדרש` TRUE EQUALS TRUE
-- s 15: a company without articles does not meet the requirement.
#ASSERT `האם לחברה שלי יש תקנון כנדרש` FALSE EQUALS FALSE
-- s 16: the articles registered with the incorporation are valid from the incorporation, which includes 5 January 2020 itself.
#ASSERT `האם התקנון שנרשם עם התאגדות החברה שלי תקף ביום מסוים` TRUE TRUE (YMD 2020 1 5) TRUE (YMD 2020 1 5) EQUALS TRUE
-- s 16: the day before the incorporation.
#ASSERT `האם התקנון שנרשם עם התאגדות החברה שלי תקף ביום מסוים` TRUE TRUE (YMD 2020 1 5) TRUE (YMD 2020 1 4) EQUALS FALSE
-- s 16: these articles were not registered with the incorporation.
#ASSERT `האם התקנון שנרשם עם התאגדות החברה שלי תקף ביום מסוים` TRUE TRUE (YMD 2020 1 5) FALSE (YMD 2020 6 1) EQUALS FALSE
-- s 17(a): the articles bind like a contract between the company and its shareholders.
#ASSERT `האם דין התקנון כדין חוזה ביני לבין הצד האחר` TRUE FALSE EQUALS TRUE
-- s 17(a): and among the shareholders themselves.
#ASSERT `האם דין התקנון כדין חוזה ביני לבין הצד האחר` FALSE TRUE EQUALS TRUE
-- s 17(a): the other party is neither the company nor another shareholder.
#ASSERT `האם דין התקנון כדין חוזה ביני לבין הצד האחר` FALSE FALSE EQUALS FALSE
-- s 17(b): the articles are amended only in the ways this Law provides.
#ASSERT `האם שינוי התקנון נעשה בדרך הקבועה בחוק` TRUE EQUALS TRUE
-- s 17(b): not made in such a way.
#ASSERT `האם שינוי התקנון נעשה בדרך הקבועה בחוק` FALSE EQUALS FALSE
-- s 18: the name, the purposes, the registered share capital and the limit on liability.
#ASSERT `האם התקנון של החברה שלי כולל את הפרטים שחובה לכלול בו` TRUE TRUE TRUE TRUE EQUALS TRUE
-- s 18(4): no details of the limit on liability.
#ASSERT `האם התקנון של החברה שלי כולל את הפרטים שחובה לכלול בו` TRUE TRUE TRUE FALSE EQUALS FALSE
-- s 19(2): provisions on how the company is managed and the number of directors.
#ASSERT `האם החברה שלי רשאית לכלול בתקנון נושא מסוים` `דרכי ניהול החברה ומספר הדירקטורים` FALSE EQUALS TRUE
-- s 19: any other matter that concerns the company or its shareholders.
#ASSERT `האם החברה שלי רשאית לכלול בתקנון נושא מסוים` `נושא אחר הנוגע לחברה או לבעלי מניותיה` TRUE EQUALS TRUE
-- s 19: a matter that concerns neither the company nor its shareholders.
#ASSERT `האם החברה שלי רשאית לכלול בתקנון נושא מסוים` `נושא אחר הנוגע לחברה או לבעלי מניותיה` FALSE EQUALS FALSE

§§ `פרק 2 סימן א׳: שינוי התקנון`

-- s 20(a): an ordinary majority, more votes for than against, abstentions not counted.
#ASSERT `האם החברה שלי רשאית לשנות את תקנונה בהחלטה שהתקבלה באסיפה הכללית` 10 5 3 FALSE 0 FALSE EQUALS TRUE
-- s 20(a): a tie is not a majority.
#ASSERT `האם החברה שלי רשאית לשנות את תקנונה בהחלטה שהתקבלה באסיפה הכללית` 5 5 0 FALSE 0 FALSE EQUALS FALSE
-- s 20(a): 6 for against 5, and the 100 abstentions do not count.
#ASSERT `האם החברה שלי רשאית לשנות את תקנונה בהחלטה שהתקבלה באסיפה הכללית` 6 5 100 FALSE 0 FALSE EQUALS TRUE
-- s 20(a): fewer for than against; the abstentions do not help.
#ASSERT `האם החברה שלי רשאית לשנות את תקנונה בהחלטה שהתקבלה באסיפה הכללית` 3 5 100 FALSE 0 FALSE EQUALS FALSE
-- s 20(a): the articles require another majority, 75%, and 7 of 10 is 70%.
#ASSERT `האם החברה שלי רשאית לשנות את תקנונה בהחלטה שהתקבלה באסיפה הכללית` 7 3 0 TRUE 0.75 FALSE EQUALS FALSE
-- s 20(a): 8 of 10 is 80%, above the 75% the articles require.
#ASSERT `האם החברה שלי רשאית לשנות את תקנונה בהחלטה שהתקבלה באסיפה הכללית` 8 2 0 TRUE 0.75 FALSE EQUALS TRUE
-- s 20(a): a section 22 resolution restricts changing the provision, so an ordinary majority does not suffice.
#ASSERT `האם החברה שלי רשאית לשנות את תקנונה בהחלטה שהתקבלה באסיפה הכללית` 10 5 0 FALSE 0 TRUE EQUALS FALSE
-- s 20(b): 80% meets the specific majority of 75%.
#ASSERT `האם שינוי הוראה מוגנת בתקנון התקבל ברוב הנדרש` 80 20 0 0.75 0 EQUALS TRUE
-- s 20(b): 70% is below the specific majority of 75%.
#ASSERT `האם שינוי הוראה מוגנת בתקנון התקבל ברוב הנדרש` 70 30 0 0.75 0 EQUALS FALSE
-- s 20(b): the higher of the two applies, the proposed 80%, and 70% falls short.
#ASSERT `האם שינוי הוראה מוגנת בתקנון התקבל ברוב הנדרש` 70 30 0 0.6 0.8 EQUALS FALSE
-- s 20(b): 85% meets the proposed 80%, which is the higher.
#ASSERT `האם שינוי הוראה מוגנת בתקנון התקבל ברוב הנדרש` 85 15 0 0.6 0.8 EQUALS TRUE
-- s 20(b): abstentions are not counted, so it stays 80%.
#ASSERT `האם שינוי הוראה מוגנת בתקנון התקבל ברוב הנדרש` 80 20 50 0.75 0 EQUALS TRUE
-- s 20(c): the change harms a class and its class meeting has not approved it.
#ASSERT `האם שינוי התקנון הפוגע בזכויות הסוג שלי מותר` TRUE TRUE FALSE FALSE EQUALS FALSE
-- s 20(c): the class meeting approved it.
#ASSERT `האם שינוי התקנון הפוגע בזכויות הסוג שלי מותר` TRUE TRUE FALSE TRUE EQUALS TRUE
-- s 20(c): unless the articles provide otherwise.
#ASSERT `האם שינוי התקנון הפוגע בזכויות הסוג שלי מותר` TRUE TRUE TRUE FALSE EQUALS TRUE
-- s 20(c): the shares are not divided into classes.
#ASSERT `האם שינוי התקנון הפוגע בזכויות הסוג שלי מותר` FALSE TRUE FALSE FALSE EQUALS TRUE
-- s 20(c): the change does not harm a class.
#ASSERT `האם שינוי התקנון הפוגע בזכויות הסוג שלי מותר` TRUE FALSE FALSE FALSE EQUALS TRUE
-- s 20(d): an amendment obliging me to buy more shares does not bind me without my consent.
#ASSERT `האם שינוי בתקנון מחייב אותי כבעל מניות` TRUE FALSE FALSE EQUALS FALSE
-- s 20(d): nor one enlarging my liability.
#ASSERT `האם שינוי בתקנון מחייב אותי כבעל מניות` FALSE TRUE FALSE EQUALS FALSE
-- s 20(d): with my consent it binds me.
#ASSERT `האם שינוי בתקנון מחייב אותי כבעל מניות` FALSE TRUE TRUE EQUALS TRUE
-- s 20(d): an amendment that adds no obligation binds as usual.
#ASSERT `האם שינוי בתקנון מחייב אותי כבעל מניות` FALSE FALSE FALSE EQUALS TRUE
-- s 21(a): a change of the kind section 40 deals with is excluded; its validity depends on registration, so the rule does not decide the day.
#ASSERT `מאיזה יום תקף שינוי התקנון של החברה שלי` TRUE (YMD 2021 3 10) FALSE (YMD 2020 1 1) EQUALS NOTHING
-- s 21(a): valid from the day the resolution was adopted.
#ASSERT `מאיזה יום תקף שינוי התקנון של החברה שלי` FALSE (YMD 2021 3 10) FALSE (YMD 2020 1 1) EQUALS (JUST (YMD 2021 3 10))
-- s 21(a): or from the later date the company fixed in the resolution.
#ASSERT `מאיזה יום תקף שינוי התקנון של החברה שלי` FALSE (YMD 2021 3 10) TRUE (YMD 2021 4 1) EQUALS (JUST (YMD 2021 4 1))
-- s 21(a): a date before the resolution is not a later date, so the resolution day governs.
#ASSERT `מאיזה יום תקף שינוי התקנון של החברה שלי` FALSE (YMD 2021 3 10) TRUE (YMD 2021 2 1) EQUALS (JUST (YMD 2021 3 10))
-- s 21(b): fourteen days is within the period.
#ASSERT `האם מסרתי לרשם את נוסח ההחלטה לשינוי התקנון בתוך ארבעה עשר ימים` 14 EQUALS TRUE
-- s 21(b): fifteen days is beyond it.
#ASSERT `האם מסרתי לרשם את נוסח ההחלטה לשינוי התקנון בתוך ארבעה עשר ימים` 15 EQUALS FALSE
-- s 21(b): three days.
#ASSERT `האם מסרתי לרשם את נוסח ההחלטה לשינוי התקנון בתוך ארבעה עשר ימים` 3 EQUALS TRUE
-- s 22(a): a general-meeting resolution by the majority needed to amend the articles, here the ordinary one.
#ASSERT `האם החברה שלי רשאית להגביל את סמכותה לשנות את התקנון` 6 4 0 FALSE 0 EQUALS TRUE
-- s 22(a): fewer votes for than against.
#ASSERT `האם החברה שלי רשאית להגביל את סמכותה לשנות את התקנון` 4 6 0 FALSE 0 EQUALS FALSE
-- s 22(a): the articles require 75% to amend provisions, and 70% voted for.
#ASSERT `האם החברה שלי רשאית להגביל את סמכותה לשנות את התקנון` 7 3 0 TRUE 0.75 EQUALS FALSE
-- s 22(a): 80% meets the 75% required.
#ASSERT `האם החברה שלי רשאית להגביל את סמכותה לשנות את התקנון` 8 2 0 TRUE 0.75 EQUALS TRUE
-- s 22(b): a resolution restricting the power to amend is treated as a resolution amending the articles.
#ASSERT `האם דין ההחלטה להגביל את סמכות השינוי כדין החלטה לשינוי התקנון` TRUE EQUALS TRUE
-- s 22(b): any other resolution.
#ASSERT `האם דין ההחלטה להגביל את סמכות השינוי כדין החלטה לשינוי התקנון` FALSE EQUALS FALSE
-- s 23(a): signed by the first shareholders, with their shares, names, addresses and identity numbers.
#ASSERT `האם התקנון נחתם ופורטו בו בעלי המניות הראשונים כדין` TRUE TRUE TRUE EQUALS TRUE
-- s 23(a): not signed by all.
#ASSERT `האם התקנון נחתם ופורטו בו בעלי המניות הראשונים כדין` FALSE TRUE TRUE EQUALS FALSE
-- s 23(a): the allotted shares are not stated.
#ASSERT `האם התקנון נחתם ופורטו בו בעלי המניות הראשונים כדין` TRUE FALSE TRUE EQUALS FALSE
-- s 23(a): name, address and identity number not stated.
#ASSERT `האם התקנון נחתם ופורטו בו בעלי המניות הראשונים כדין` TRUE TRUE FALSE EQUALS FALSE
-- s 23(b): a lawyer verifies the signatories' identity.
#ASSERT `האם זהות החותמים על התקנון אומתה` TRUE FALSE EQUALS TRUE
-- s 23(b): or it is verified online as the regulations provide.
#ASSERT `האם זהות החותמים על התקנון אומתה` FALSE TRUE EQUALS TRUE
-- s 23(b): neither.
#ASSERT `האם זהות החותמים על התקנון אומתה` FALSE FALSE EQUALS FALSE

§§ `פרק 2 סימן א׳: הוראות מעבר (סעיף 24)`

-- s 24(1): a provision on the capital may be changed by 75% of those voting, abstentions excluded.
#ASSERT `האם החברה הוותיקה שלי רשאית לשנות את הוראה בתזכירה` TRUE `הוראה בענין ההון` FALSE 80 20 0 EQUALS TRUE
-- s 24(1): 70% is below 75%, and the Ordinance route was not used.
#ASSERT `האם החברה הוותיקה שלי רשאית לשנות את הוראה בתזכירה` TRUE `הוראה בענין ההון` FALSE 70 30 0 EQUALS FALSE
-- s 24(1): the 75% route is only for the capital and the name; another provision needs the Ordinance route.
#ASSERT `האם החברה הוותיקה שלי רשאית לשנות את הוראה בתזכירה` TRUE `הוראה אחרת בתזכיר` FALSE 80 20 0 EQUALS FALSE
-- s 24(1): another provision changed in the way and on the conditions of the Companies Ordinance.
#ASSERT `האם החברה הוותיקה שלי רשאית לשנות את הוראה בתזכירה` TRUE `הוראה אחרת בתזכיר` TRUE 0 0 0 EQUALS TRUE
-- s 24: only a company incorporated before the Law came into force.
#ASSERT `האם החברה הוותיקה שלי רשאית לשנות את הוראה בתזכירה` FALSE `הוראה בענין שם החברה` FALSE 90 10 0 EQUALS FALSE
-- s 24(1): a change of the registered capital is valid from the day the resolution was adopted.
#ASSERT `מאיזה יום תקף שינוי ההון הרשום שהחלטנו עליו` (YMD 2021 5 5) EQUALS (YMD 2021 5 5)
-- s 24(1): a change of the company's name does not need the Minister's consent.
#ASSERT `האם שינוי שם החברה הוותיקה שלי לפי סעיף 24(1) טעון הסכמת השר` EQUALS FALSE
-- s 24(2): an older company may change or cancel its memorandum in the way section 350 provides.
#ASSERT `האם החברה הוותיקה שלי רשאית לשנות את תזכירה או לבטלו בדרך שבסעיף 350` TRUE TRUE EQUALS TRUE
-- s 24(2): not made in that way.
#ASSERT `האם החברה הוותיקה שלי רשאית לשנות את תזכירה או לבטלו בדרך שבסעיף 350` TRUE FALSE EQUALS FALSE
-- s 24(2): the company was not incorporated before the Law.
#ASSERT `האם החברה הוותיקה שלי רשאית לשנות את תזכירה או לבטלו בדרך שבסעיף 350` FALSE TRUE EQUALS FALSE
-- s 24(3): 75% of those voting, abstentions excluded; here 80%.
#ASSERT `האם החברה הוותיקה שלי רשאית לשנות את הוראות תקנונה בהחלטה שהתקבלה` TRUE 80 20 0 FALSE 0 EQUALS TRUE
-- s 24(3): 70% of those voting; the abstentions are excluded and do not help.
#ASSERT `האם החברה הוותיקה שלי רשאית לשנות את הוראות תקנונה בהחלטה שהתקבלה` TRUE 70 30 500 FALSE 0 EQUALS FALSE
-- s 24(3): or another majority fixed in the memorandum or articles, here 60%.
#ASSERT `האם החברה הוותיקה שלי רשאית לשנות את הוראות תקנונה בהחלטה שהתקבלה` TRUE 70 30 0 TRUE 0.6 EQUALS TRUE
-- s 24(3): not an older company.
#ASSERT `האם החברה הוותיקה שלי רשאית לשנות את הוראות תקנונה בהחלטה שהתקבלה` FALSE 80 20 0 FALSE 0 EQUALS FALSE
-- s 24(4): 75% of those voting suffices where no greater majority is fixed.
#ASSERT `האם החברה הוותיקה שלי רשאית לקבוע בתקנון הוראה בדבר הרוב הדרוש לשינוי התקנון` TRUE 80 20 0 FALSE 0 EQUALS TRUE
-- s 24(4): 70% is below 75%.
#ASSERT `האם החברה הוותיקה שלי רשאית לקבוע בתקנון הוראה בדבר הרוב הדרוש לשינוי התקנון` TRUE 70 30 0 FALSE 0 EQUALS FALSE
-- s 24(4): a greater majority of 90% is fixed and 80% falls short.
#ASSERT `האם החברה הוותיקה שלי רשאית לקבוע בתקנון הוראה בדבר הרוב הדרוש לשינוי התקנון` TRUE 80 20 0 TRUE 0.9 EQUALS FALSE
-- s 24(4): 95% meets the greater majority of 90%.
#ASSERT `האם החברה הוותיקה שלי רשאית לקבוע בתקנון הוראה בדבר הרוב הדרוש לשינוי התקנון` TRUE 95 5 0 TRUE 0.9 EQUALS TRUE
-- s 24(4): a figure lower than 75% is not a greater majority, so 75% still applies.
#ASSERT `האם החברה הוותיקה שלי רשאית לקבוע בתקנון הוראה בדבר הרוב הדרוש לשינוי התקנון` TRUE 70 30 0 TRUE 0.6 EQUALS FALSE
-- s 24(5): by 75% of those voting, abstentions excluded.
#ASSERT `האם החברה הוותיקה שלי רשאית לקבוע בתזכיר הוראה בדבר שינוי הרוב הדרוש לשינוי התזכיר` TRUE 80 20 0 EQUALS TRUE
-- s 24(5): 70% is below 75%.
#ASSERT `האם החברה הוותיקה שלי רשאית לקבוע בתזכיר הוראה בדבר שינוי הרוב הדרוש לשינוי התזכיר` TRUE 70 30 0 EQUALS FALSE
-- s 24(5): not an older company.
#ASSERT `האם החברה הוותיקה שלי רשאית לקבוע בתזכיר הוראה בדבר שינוי הרוב הדרוש לשינוי התזכיר` FALSE 80 20 0 EQUALS FALSE

§§ `פרק 2 סימן ב׳: שם החברה`

-- s 25: a limited company whose name ends with "בע״מ", with no bar on the name, may be registered.
#ASSERT `האם החברה שלי רשאית להירשם בשם זה` TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS TRUE
-- s 26: a limited company's name must end with "בערבון מוגבל" or "בע״מ".
#ASSERT `האם החברה שלי רשאית להירשם בשם זה` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS FALSE
-- s 26: a company with unlimited liability needs no such ending.
#ASSERT `האם החברה שלי רשאית להירשם בשם זה` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS TRUE
-- s 26: the ending "בערבון מוגבל" will do.
#ASSERT `האם החברה שלי רשאית להירשם בשם זה` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS TRUE
-- s 27(a)(1): the name of a corporation lawfully registered in Israel.
#ASSERT `האם החברה שלי רשאית להירשם בשם זה` TRUE FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS FALSE
-- s 27(a)(1): misleadingly similar to such a name.
#ASSERT `האם החברה שלי רשאית להירשם בשם זה` TRUE FALSE TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS FALSE
-- s 27(a)(2): a registered trade mark for similar purposes, with no written consent proved.
#ASSERT `האם החברה שלי רשאית להירשם בשם זה` TRUE FALSE TRUE FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE TRUE EQUALS FALSE
-- s 27(a)(2): unless it is proved to the Registrar that the owner of the mark agreed in writing.
#ASSERT `האם החברה שלי רשאית להירשם בשם זה` TRUE FALSE TRUE FALSE FALSE TRUE TRUE TRUE FALSE FALSE FALSE TRUE EQUALS TRUE
-- s 27(a)(2): the mark is not registered for similar goods or services, so the bar does not apply.
#ASSERT `האם החברה שלי רשאית להירשם בשם זה` TRUE FALSE TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS TRUE
-- s 27(b): the Registrar considers the name deceptive.
#ASSERT `האם החברה שלי רשאית להירשם בשם זה` TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE TRUE EQUALS FALSE
-- s 28: the Registrar considers the name liable to harm the public's feelings.
#ASSERT `האם החברה שלי רשאית להירשם בשם זה` TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS FALSE
-- s 25: the name does not meet another law.
#ASSERT `האם החברה שלי רשאית להירשם בשם זה` TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS FALSE
-- s 26: limited liability but no required ending.
#ASSERT `האם שם החברה שלי כולל בסופו את הציון הנדרש לחברה בערבון מוגבל` TRUE FALSE FALSE EQUALS FALSE
-- s 26: limited liability and the ending "בע״מ".
#ASSERT `האם שם החברה שלי כולל בסופו את הציון הנדרש לחברה בערבון מוגבל` TRUE FALSE TRUE EQUALS TRUE
-- s 26: unlimited liability, nothing is required.
#ASSERT `האם שם החברה שלי כולל בסופו את הציון הנדרש לחברה בערבון מוגבל` FALSE FALSE FALSE EQUALS TRUE
-- s 27(a)(1): the name of an existing corporation.
#ASSERT `האם השם אסור לרישום בשל שם של תאגיד קיים` TRUE FALSE EQUALS TRUE
-- s 27(a)(1): misleadingly similar.
#ASSERT `האם השם אסור לרישום בשל שם של תאגיד קיים` FALSE TRUE EQUALS TRUE
-- s 27(a)(1): neither.
#ASSERT `האם השם אסור לרישום בשל שם של תאגיד קיים` FALSE FALSE EQUALS FALSE
-- s 27(a)(2): a registered mark for similar purposes, no consent proved.
#ASSERT `האם השם אסור לרישום בשל סימן מסחר רשום` TRUE TRUE FALSE EQUALS TRUE
-- s 27(a)(2): written consent was proved.
#ASSERT `האם השם אסור לרישום בשל סימן מסחר רשום` TRUE TRUE TRUE EQUALS FALSE
-- s 27(b): the Registrar considers it deceptive.
#ASSERT `האם השם אסור לרישום בשל תרמית או הטעיה` TRUE EQUALS TRUE
-- s 27(b): he does not.
#ASSERT `האם השם אסור לרישום בשל תרמית או הטעיה` FALSE EQUALS FALSE
-- s 28: liable to harm public policy.
#ASSERT `האם השם אסור לרישום מפני שעלול לפגוע בתקנת הציבור או ברגשות הציבור` TRUE FALSE EQUALS TRUE
-- s 28: liable to harm the public's feelings.
#ASSERT `האם השם אסור לרישום מפני שעלול לפגוע בתקנת הציבור או ברגשות הציבור` FALSE TRUE EQUALS TRUE
-- s 28: neither.
#ASSERT `האם השם אסור לרישום מפני שעלול לפגוע בתקנת הציבור או ברגשות הציבור` FALSE FALSE EQUALS FALSE
-- s 29(a): registered under a name this sub-chapter does not allow.
#ASSERT `האם הרשם רשאי לדרוש מהחברה שלי לשנות את שמה` TRUE EQUALS TRUE
-- s 29(a): the name is allowed.
#ASSERT `האם הרשם רשאי לדרוש מהחברה שלי לשנות את שמה` FALSE EQUALS FALSE
-- s 29(b): no notice of a name-change resolution within four months of the demand; five months have passed.
#ASSERT `האם הרשם רשאי לשנות בעצמו את שם החברה שלי` TRUE FALSE 5 EQUALS TRUE
-- s 29(b): four months are still within the period.
#ASSERT `האם הרשם רשאי לשנות בעצמו את שם החברה שלי` TRUE FALSE 4 EQUALS FALSE
-- s 29(b): the company gave notice of a resolution changing its name.
#ASSERT `האם הרשם רשאי לשנות בעצמו את שם החברה שלי` TRUE TRUE 6 EQUALS FALSE
-- s 29(b): the Registrar never made the demand.
#ASSERT `האם הרשם רשאי לשנות בעצמו את שם החברה שלי` FALSE FALSE 6 EQUALS FALSE
-- s 29(c): once the Registrar decided to change the name he sends a certificate of change of name.
#ASSERT `האם הרשם ישלח לחברה שלי תעודת שינוי שם` TRUE EQUALS TRUE
-- s 29(c): he has not so decided.
#ASSERT `האם הרשם ישלח לחברה שלי תעודת שינוי שם` FALSE EQUALS FALSE
-- s 30: on the application of a company whose name, or a misleadingly similar one, was taken.
#ASSERT `האם בית המשפט רשאי להורות להימנע משימוש בשם` TRUE FALSE FALSE EQUALS TRUE
-- s 30: on the application of one harmed by a registration contrary to section 27.
#ASSERT `האם בית המשפט רשאי להורות להימנע משימוש בשם` FALSE TRUE FALSE EQUALS TRUE
-- s 30: unless the court is satisfied that the defendant's right to use the name precedes the applicant's.
#ASSERT `האם בית המשפט רשאי להורות להימנע משימוש בשם` TRUE FALSE TRUE EQUALS FALSE
-- s 30: the applicant is neither.
#ASSERT `האם בית המשפט רשאי להורות להימנע משימוש בשם` FALSE FALSE FALSE EQUALS FALSE
-- s 31(a): with the Registrar's approval, the resolution and name meeting sections 25 to 30.
#ASSERT `האם החברה שלי רשאית לשנות את שמה באישור הרשם` TRUE TRUE EQUALS TRUE
-- s 31(a): without the Registrar's approval.
#ASSERT `האם החברה שלי רשאית לשנות את שמה באישור הרשם` FALSE TRUE EQUALS FALSE
-- s 31(a): the name asked for does not meet sections 25 to 30.
#ASSERT `האם החברה שלי רשאית לשנות את שמה באישור הרשם` TRUE FALSE EQUALS FALSE
-- s 31(b): having approved, the Registrar registers the new name and gives a certificate.
#ASSERT `האם הרשם חייב לרשום את השם החדש ולתת לחברה שלי תעודת שינוי שם` TRUE EQUALS TRUE
-- s 31(b): no approval.
#ASSERT `האם הרשם חייב לרשום את השם החדש ולתת לחברה שלי תעודת שינוי שם` FALSE EQUALS FALSE

§§ `פרק 2 סימנים ג׳ עד ה׳: מטרות, הון והגבלת אחריות`

-- s 32(1): any lawful occupation.
#ASSERT `האם ציינו בתקנון את מטרות החברה שלי באחד האופנים שבחוק` `לעסוק בכל עיסוק חוקי` FALSE EQUALS TRUE
-- s 32(2): any lawful occupation except listed kinds, which are listed.
#ASSERT `האם ציינו בתקנון את מטרות החברה שלי באחד האופנים שבחוק` `לעסוק בכל עיסוק חוקי למעט סוגי עיסוקים שפורטו בתקנון` TRUE EQUALS TRUE
-- s 32(3): the kinds are not listed in the articles.
#ASSERT `האם ציינו בתקנון את מטרות החברה שלי באחד האופנים שבחוק` `לעסוק בסוגי עיסוקים שפורטו בתקנון` FALSE EQUALS FALSE
-- s 32: another way of stating the purposes is not one of the three.
#ASSERT `האם ציינו בתקנון את מטרות החברה שלי באחד האופנים שבחוק` `ציון מטרות אחר שאינו מנוי בסעיף 32` TRUE EQUALS FALSE
-- s 33: the registered capital including the number of shares by class.
#ASSERT `האם קבענו בתקנון את הון המניות הרשום של החברה שלי` TRUE TRUE EQUALS TRUE
-- s 33: the number of shares by class is missing.
#ASSERT `האם קבענו בתקנון את הון המניות הרשום של החברה שלי` TRUE FALSE EQUALS FALSE
-- s 34(a): all with par value.
#ASSERT `האם מניות החברה שלי כולן בעלות ערך נקוב או כולן ללא ערך נקוב` 100 0 EQUALS TRUE
-- s 34(a): all without par value.
#ASSERT `האם מניות החברה שלי כולן בעלות ערך נקוב או כולן ללא ערך נקוב` 0 100 EQUALS TRUE
-- s 34(a): a mix of the two.
#ASSERT `האם מניות החברה שלי כולן בעלות ערך נקוב או כולן ללא ערך נקוב` 50 50 EQUALS FALSE
-- s 34(b): shares without par value: only their number is stated.
#ASSERT `האם התקנון של החברה שלי מציין את מספר המניות ואת ערכן הנקוב כנדרש` TRUE TRUE FALSE EQUALS TRUE
-- s 34(b): for shares without par value the number only is to be stated.
#ASSERT `האם התקנון של החברה שלי מציין את מספר המניות ואת ערכן הנקוב כנדרש` TRUE TRUE TRUE EQUALS FALSE
-- s 34(b): shares with par value: the number and the par value of each share.
#ASSERT `האם התקנון של החברה שלי מציין את מספר המניות ואת ערכן הנקוב כנדרש` FALSE TRUE TRUE EQUALS TRUE
-- s 34(b): the par value is missing.
#ASSERT `האם התקנון של החברה שלי מציין את מספר המניות ואת ערכן הנקוב כנדרש` FALSE TRUE FALSE EQUALS FALSE
-- s 34(c): the registered capital is the number of shares fixed in the articles.
#ASSERT `מהו הון המניות הרשום בחברה שמניותיה ללא ערך נקוב` 1000 EQUALS 1000
-- s 34(c): the issued capital is the number of shares the company allotted.
#ASSERT `מהו ההון המונפק בחברה שמניותיה ללא ערך נקוב` 400 EQUALS 400
-- s 35(a): limited liability, with the manner of the limit detailed.
#ASSERT `האם התקנון של החברה שלי מציין את מצב אחריות בעלי המניות כנדרש` TRUE FALSE TRUE EQUALS TRUE
-- s 35(a): limited, but the manner of the limit is not detailed.
#ASSERT `האם התקנון של החברה שלי מציין את מצב אחריות בעלי המניות כנדרש` TRUE FALSE FALSE EQUALS FALSE
-- s 35(a): unlimited liability, stated in the articles.
#ASSERT `האם התקנון של החברה שלי מציין את מצב אחריות בעלי המניות כנדרש` FALSE TRUE FALSE EQUALS TRUE
-- s 35(a): unlimited liability not stated in the articles.
#ASSERT `האם התקנון של החברה שלי מציין את מצב אחריות בעלי המניות כנדרש` FALSE FALSE FALSE EQUALS FALSE
-- s 35(b): shares with par value: liable at least to pay the par value.
#ASSERT `האם אני כבעל מניות אחראי לפירעון הערך הנקוב של מניותי לפחות` TRUE FALSE EQUALS TRUE
-- s 35(b): unless what section 304 provides is met.
#ASSERT `האם אני כבעל מניות אחראי לפירעון הערך הנקוב של מניותי לפחות` TRUE TRUE EQUALS FALSE
-- s 35(b): the shares have no par value.
#ASSERT `האם אני כבעל מניות אחראי לפירעון הערך הנקוב של מניותי לפחות` FALSE FALSE EQUALS FALSE

§§ `חלק 2 פרק 3: רשם החברות`

-- s 36(a): a State employee qualified as a magistrates' court judge, appointed Registrar by the Minister.
#ASSERT `האם לאדם זה יש סמכויות רשם החברות כלפי החברה שלי` TRUE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS TRUE
-- s 36(b): a State employee appointed deputy Registrar and authorised with the Registrar's powers.
#ASSERT `האם לאדם זה יש סמכויות רשם החברות כלפי החברה שלי` TRUE FALSE FALSE TRUE TRUE FALSE FALSE EQUALS TRUE
-- s 36(c): when the Registrar cannot fulfil his role, a Ministry of Justice employee the Minister authorised.
#ASSERT `האם לאדם זה יש סמכויות רשם החברות כלפי החברה שלי` FALSE FALSE FALSE FALSE TRUE TRUE TRUE EQUALS TRUE
-- s 36(a): qualified but not appointed Registrar.
#ASSERT `האם לאדם זה יש סמכויות רשם החברות כלפי החברה שלי` TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS FALSE
-- s 36(a): not a State employee.
#ASSERT `האם לאדם זה יש סמכויות רשם החברות כלפי החברה שלי` FALSE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS FALSE
-- s 36(c): the Registrar is not unable to fulfil his role.
#ASSERT `האם לאדם זה יש סמכויות רשם החברות כלפי החברה שלי` FALSE FALSE FALSE FALSE TRUE FALSE TRUE EQUALS FALSE
-- s 37(a)(1): incorporation of a company.
#ASSERT `האם הרשם הוא שקובע אם נתמלאו התנאים והדרישות בענין זה` `התאגדות של חברה לענין סעיף 37(א)` EQUALS TRUE
-- s 37(a)(4): a merger.
#ASSERT `האם הרשם הוא שקובע אם נתמלאו התנאים והדרישות בענין זה` `מיזוג לענין סעיף 37(א)` EQUALS TRUE
-- s 37(a): a matter not listed.
#ASSERT `האם הרשם הוא שקובע אם נתמלאו התנאים והדרישות בענין זה` `ענין אחר שאינו מנוי בסעיף 37(א)` EQUALS FALSE
-- s 37(b): a period of not less than fourteen days.
#ASSERT `האם הרשם רשאי לדרוש מהחברה שלי להמציא את המרשמים והפנקסים בתוך תקופה זו` 14 EQUALS TRUE
-- s 37(b): thirteen days is less than fourteen.
#ASSERT `האם הרשם רשאי לדרוש מהחברה שלי להמציא את המרשמים והפנקסים בתוך תקופה זו` 13 EQUALS FALSE
-- s 37(b): thirty days.
#ASSERT `האם הרשם רשאי לדרוש מהחברה שלי להמציא את המרשמים והפנקסים בתוך תקופה זו` 30 EQUALS TRUE
-- s 37(c): the Registrar is satisfied they are not up to date.
#ASSERT `האם הרשם רשאי להורות לחברה שלי לעדכן את המרשמים והפנקסים` TRUE EQUALS TRUE
-- s 37(c): he is not so satisfied.
#ASSERT `האם הרשם רשאי להורות לחברה שלי לעדכן את המרשמים והפנקסים` FALSE EQUALS FALSE
-- s 38(a),(c): a record for every company and an identity number for each.
#ASSERT `האם הרשם חייב לנהל רישום לגבי החברה שלי ולתת לה מספר זהות` TRUE EQUALS TRUE
-- s 38: the body is not a company.
#ASSERT `האם הרשם חייב לנהל רישום לגבי החברה שלי ולתת לה מספר זהות` FALSE EQUALS FALSE
-- s 38(b): delivered by electronic communication.
#ASSERT `האם המסמך או הדיווח שמסרתי לרשם נמסר כדין` TRUE FALSE EQUALS TRUE
-- s 38(b): not electronic, but the Registrar allowed it.
#ASSERT `האם המסמך או הדיווח שמסרתי לרשם נמסר כדין` FALSE TRUE EQUALS TRUE
-- s 38(b): neither.
#ASSERT `האם המסמך או הדיווח שמסרתי לרשם נמסר כדין` FALSE FALSE EQUALS FALSE
-- s 39(a): bears the identity number and is signed by a director, who states his name and role.
#ASSERT `האם המסמך שהחברה שלי מוסרת לרשם נושא את מספר הזהות וחתום כנדרש` TRUE `דירקטור` FALSE TRUE EQUALS TRUE
-- s 39(a): the signatory holds another position and is not the secretary or one authorised.
#ASSERT `האם המסמך שהחברה שלי מוסרת לרשם נושא את מספר הזהות וחתום כנדרש` TRUE `משרה אחרת` FALSE TRUE EQUALS FALSE
-- s 39(a): the company secretary, or one the company authorised, counts as an office-holder here.
#ASSERT `האם המסמך שהחברה שלי מוסרת לרשם נושא את מספר הזהות וחתום כנדרש` TRUE `משרה אחרת` TRUE TRUE EQUALS TRUE
-- s 39(a): the document does not bear the identity number.
#ASSERT `האם המסמך שהחברה שלי מוסרת לרשם נושא את מספר הזהות וחתום כנדרש` FALSE `דירקטור` FALSE TRUE EQUALS FALSE
-- s 39(a): the signatory does not state his name and role.
#ASSERT `האם המסמך שהחברה שלי מוסרת לרשם נושא את מספר הזהות וחתום כנדרש` TRUE `דירקטור` FALSE FALSE EQUALS FALSE
-- s 39(b): the company is in receivership.
#ASSERT `האם כונס הנכסים או הנאמן רשאי לחתום על מסמכי החברה שבכינוס, בפירוק או בהליכי חדלות פירעון` TRUE FALSE FALSE EQUALS TRUE
-- s 39(b): an order opening proceedings was given.
#ASSERT `האם כונס הנכסים או הנאמן רשאי לחתום על מסמכי החברה שבכינוס, בפירוק או בהליכי חדלות פירעון` FALSE FALSE TRUE EQUALS TRUE
-- s 39(b): none of the three.
#ASSERT `האם כונס הנכסים או הנאמן רשאי לחתום על מסמכי החברה שבכינוס, בפירוק או בהליכי חדלות פירעון` FALSE FALSE FALSE EQUALS FALSE
-- s 39(c): applies if no different provision in any law.
#ASSERT `האם הוראות סעיף 39 על חתימת מסמכים חלות` FALSE EQUALS TRUE
-- s 39(c): a different provision exists.
#ASSERT `האם הוראות סעיף 39 על חתימת מסמכים חלות` TRUE EQUALS FALSE
-- s 40(1): a change of name is valid only if registered.
#ASSERT `האם הפעולה של החברה שלי תקפה, בהיותה טעונה רישום` `שינוי שם חברה לפי סעיף 31` TRUE EQUALS (JUST TRUE)
-- s 40(2): a change of purposes not registered has no validity.
#ASSERT `האם הפעולה של החברה שלי תקפה, בהיותה טעונה רישום` `שינוי מטרות חברה לענין סעיף 40` FALSE EQUALS (JUST FALSE)
-- s 40: an act the section does not list is not decided by it.
#ASSERT `האם הפעולה של החברה שלי תקפה, בהיותה טעונה רישום` `פעולה אחרת שאינה מנויה בסעיף 40` FALSE EQUALS NOTHING
-- s 41(a): a copy the Registrar certified is accepted as the original and conclusive evidence.
#ASSERT `האם העתק מאושר בידי הרשם מתקבל כמקור וכראיה חלוטה` TRUE TRUE EQUALS TRUE
-- s 41(a): the document is not held or registered with the Registrar.
#ASSERT `האם העתק מאושר בידי הרשם מתקבל כמקור וכראיה חלוטה` TRUE FALSE EQUALS FALSE
-- s 41(b): where the Minister set provisions on electronic filing, they apply to a printout.
#ASSERT `האם הוראות סעיף 41(א) חלות על פלט של דיווח אלקטרוני שלי` TRUE TRUE EQUALS TRUE
-- s 41(b): the Minister has set no such provisions.
#ASSERT `האם הוראות סעיף 41(א) חלות על פלט של דיווח אלקטרוני שלי` FALSE TRUE EQUALS FALSE
-- s 42: registration or existence of a document is not in itself evidence that I knew its contents.
#ASSERT `האם עצם רישומו של מסמך ברשם הוא ראיה לכך שידעתי את תוכנו` EQUALS FALSE
-- s 43(a): any person may inspect an item in the Registrar's registers and obtain a certified copy.
#ASSERT `האם אני רשאי לעיין בפרט במרשמי הרשם ולקבל ממנו העתק מאושר` TRUE FALSE FALSE EQUALS TRUE
-- s 43(b): item (2) of the Fourth Schedule is open only to a public body sending digital messages.
#ASSERT `האם אני רשאי לעיין בפרט במרשמי הרשם ולקבל ממנו העתק מאושר` TRUE TRUE FALSE EQUALS FALSE
-- s 43(b): and I am such a public body.
#ASSERT `האם אני רשאי לעיין בפרט במרשמי הרשם ולקבל ממנו העתק מאושר` TRUE TRUE TRUE EQUALS TRUE
-- s 43(a): the item is not recorded in a register the Registrar keeps.
#ASSERT `האם אני רשאי לעיין בפרט במרשמי הרשם ולקבל ממנו העתק מאושר` FALSE FALSE FALSE EQUALS FALSE

§§ `חלק 3 פרק 1: האורגנים`

-- s 46: the general meeting is an organ.
#ASSERT `האם הגוף הזה הוא אורגן של החברה שלי` `האסיפה הכללית` FALSE EQUALS TRUE
-- s 46: the board is an organ.
#ASSERT `האם הגוף הזה הוא אורגן של החברה שלי` `הדירקטוריון` FALSE EQUALS TRUE
-- s 46: the general manager is an organ.
#ASSERT `האם הגוף הזה הוא אורגן של החברה שלי` `המנהל הכללי` FALSE EQUALS TRUE
-- s 46: a body whose act law or the articles treat as the company's act in a matter is an organ.
#ASSERT `האם הגוף הזה הוא אורגן של החברה שלי` `ועדת הביקורת` TRUE EQUALS TRUE
-- s 46: a committee that law and the articles do not treat so is not an organ.
#ASSERT `האם הגוף הזה הוא אורגן של החברה שלי` `ועדת הביקורת` FALSE EQUALS FALSE
-- s 47: the acts and intentions of an organ are the company's.
#ASSERT `האם פעולתו וכוונתו של אדם הם פעולת החברה שלי וכוונתה` TRUE EQUALS TRUE
-- s 47: a person who is not an organ.
#ASSERT `האם פעולתו וכוונתו של אדם הם פעולת החברה שלי וכוונתה` FALSE EQUALS FALSE

§§ `פרק 1 סימן ב׳: חלוקת הסמכויות`

-- s 48(b): the board has the powers listed in its sub-chapter.
#ASSERT `האם הסמכות הזאת נתונה לאורגן שבו מדובר` `הדירקטוריון` TRUE EQUALS TRUE
-- s 48(a)-(c): the division is between the three principal organs only.
#ASSERT `האם הסמכות הזאת נתונה לאורגן שבו מדובר` `ועדת הביקורת` TRUE EQUALS FALSE
-- s 48(c): the power is not listed in the chapter for the general manager.
#ASSERT `האם הסמכות הזאת נתונה לאורגן שבו מדובר` `המנהל הכללי` FALSE EQUALS FALSE
-- s 48(d): every organ holds the ancillary powers it needs.
#ASSERT `האם סמכות העזר הזאת נתונה לאורגן שבו מדובר` `האסיפה הכללית` FALSE TRUE EQUALS TRUE
-- s 48(d): "all the organs" includes a body treated as an organ under s 46.
#ASSERT `האם סמכות העזר הזאת נתונה לאורגן שבו מדובר` `ועדת הביקורת` TRUE TRUE EQUALS TRUE
-- s 48(d): a body that is not an organ.
#ASSERT `האם סמכות העזר הזאת נתונה לאורגן שבו מדובר` `ועדת הביקורת` FALSE TRUE EQUALS FALSE
-- s 49: a power not given by law or the articles to another organ may be exercised by the board.
#ASSERT `האם הדירקטוריון רשאי להפעיל סמכות של החברה שלי` FALSE EQUALS TRUE
-- s 49: the power was given to another organ.
#ASSERT `האם הדירקטוריון רשאי להפעיל סמכות של החברה שלי` TRUE EQUALS FALSE
-- s 50(a): a provision limited to a particular matter.
#ASSERT `האם הוראת התקנון של החברה שלי על העברת סמכויות בין האורגנים תקפה` TRUE TRUE FALSE 0 0 EQUALS TRUE
-- s 50(a): limited to a period that does not exceed what the circumstances require.
#ASSERT `האם הוראת התקנון של החברה שלי על העברת סמכויות בין האורגנים תקפה` TRUE FALSE TRUE 100 150 EQUALS TRUE
-- s 50(a): the period fixed exceeds what the circumstances require.
#ASSERT `האם הוראת התקנון של החברה שלי על העברת סמכויות בין האורגנים תקפה` TRUE FALSE TRUE 200 150 EQUALS FALSE
-- s 50(a): limited neither to a matter nor to a period.
#ASSERT `האם הוראת התקנון של החברה שלי על העברת סמכויות בין האורגנים תקפה` TRUE FALSE FALSE 0 0 EQUALS FALSE
-- s 50(a): no such provision in the articles.
#ASSERT `האם הוראת התקנון של החברה שלי על העברת סמכויות בין האורגנים תקפה` FALSE TRUE FALSE 0 0 EQUALS FALSE
-- s 50(b): where the general meeting took powers the Law gives the board, shareholders bear a director's rights, duties and liability.
#ASSERT `האם עליי כבעל מניות חלים זכויות, חובות ואחריות של דירקטור` TRUE EQUALS TRUE
-- s 50(b): the meeting took no such powers.
#ASSERT `האם עליי כבעל מניות חלים זכויות, חובות ואחריות של דירקטור` FALSE EQUALS FALSE
-- s 51: a board may instruct the general manager how to act in a particular matter.
#ASSERT `האם הדירקטוריון רשאי להורות למנהל הכללי כיצד לפעול לענין מסוים` EQUALS TRUE
-- s 51: the general manager did not carry out the board's instruction.
#ASSERT `האם הדירקטוריון רשאי להפעיל את הסמכות במקום המנהל הכללי של החברה שלי` TRUE TRUE EQUALS TRUE
-- s 51: he carried it out.
#ASSERT `האם הדירקטוריון רשאי להפעיל את הסמכות במקום המנהל הכללי של החברה שלי` TRUE FALSE EQUALS FALSE
-- s 51: the board gave no instruction.
#ASSERT `האם הדירקטוריון רשאי להפעיל את הסמכות במקום המנהל הכללי של החברה שלי` FALSE TRUE EQUALS FALSE
-- s 52(a): the board cannot act, the power is vital, and the general meeting determined both.
#ASSERT `האם האסיפה הכללית של החברה שלי רשאית להפעיל סמכות של הדירקטוריון` TRUE TRUE TRUE TRUE EQUALS TRUE
-- s 52(a): the general meeting has not determined that exercising the power is vital.
#ASSERT `האם האסיפה הכללית של החברה שלי רשאית להפעיל סמכות של הדירקטוריון` TRUE TRUE TRUE FALSE EQUALS FALSE
-- s 52(a): the board is able to act.
#ASSERT `האם האסיפה הכללית של החברה שלי רשאית להפעיל סמכות של הדירקטוריון` FALSE TRUE TRUE TRUE EQUALS FALSE
-- s 52(b): the general manager cannot exercise his powers.
#ASSERT `האם הדירקטוריון רשאי להפעיל סמכויות של המנהל הכללי של החברה שלי` TRUE EQUALS TRUE
-- s 52(b): he can.
#ASSERT `האם הדירקטוריון רשאי להפעיל סמכויות של המנהל הכללי של החברה שלי` FALSE EQUALS FALSE

§§ `פרק 1 סימנים ג׳ ו־ד׳: אחריות החברה ואחריות יחידי האורגן`

-- s 53(a): a company is directly liable for a tort an organ committed.
#ASSERT `האם החברה שלי חבה במישרין בנזיקין על עוולה שבוצעה בידי אורגן שלה` TRUE EQUALS TRUE
-- s 53(a): not committed by an organ.
#ASSERT `האם החברה שלי חבה במישרין בנזיקין על עוולה שבוצעה בידי אורגן שלה` FALSE EQUALS FALSE
-- s 53(b): vicarious liability under any law is not reduced.
#ASSERT `האם אחריותה השילוחית של החברה שלי בנזיקין נשמרת` TRUE EQUALS TRUE
-- s 53(b): the company has none under any law, so none is preserved.
#ASSERT `האם אחריותה השילוחית של החברה שלי בנזיקין נשמרת` FALSE EQUALS FALSE
-- s 54(a): attributing the act to the company does not remove the individual's personal liability.
#ASSERT `האם אני כיחיד באורגן נושא באחריות אישית על פעולת האורגן` TRUE EQUALS TRUE
-- s 54(a): he would have borne none anyway.
#ASSERT `האם אני כיחיד באורגן נושא באחריות אישית על פעולת האורגן` FALSE EQUALS FALSE

§§ `פרק 1 סימן ה׳: מניעת פעולה בחריגה מסמכות`

-- s 55(a): an act in excess of the purposes in the articles.
#ASSERT `האם הפעולה אסורה עליי כמי שפועל מטעם החברה` TRUE FALSE FALSE EQUALS TRUE
-- s 55(a): an act without authorisation.
#ASSERT `האם הפעולה אסורה עליי כמי שפועל מטעם החברה` FALSE TRUE FALSE EQUALS TRUE
-- s 55(a): an act in excess of the authorisation.
#ASSERT `האם הפעולה אסורה עליי כמי שפועל מטעם החברה` FALSE FALSE TRUE EQUALS TRUE
-- s 55(a): none of the three.
#ASSERT `האם הפעולה אסורה עליי כמי שפועל מטעם החברה` FALSE FALSE FALSE EQUALS FALSE
-- s 55(b): at a shareholder's request, where an excessive act is being done.
#ASSERT `האם בית המשפט רשאי לתת צו להפסקת פעולה חורגת או למניעתה לבקשתי` TRUE FALSE FALSE TRUE FALSE FALSE EQUALS TRUE
-- s 55(b): at the company's request, where there is ground to assume such an act is about to be done.
#ASSERT `האם בית המשפט רשאי לתת צו להפסקת פעולה חורגת או למניעתה לבקשתי` FALSE TRUE TRUE FALSE FALSE FALSE EQUALS TRUE
-- s 55(b): a creditor needs a fear of harm to his rights.
#ASSERT `האם בית המשפט רשאי לתת צו להפסקת פעולה חורגת או למניעתה לבקשתי` TRUE FALSE FALSE FALSE TRUE FALSE EQUALS FALSE
-- s 55(b): a creditor who fears harm to his rights.
#ASSERT `האם בית המשפט רשאי לתת צו להפסקת פעולה חורגת או למניעתה לבקשתי` TRUE FALSE FALSE FALSE TRUE TRUE EQUALS TRUE
-- s 55(b): no such act is being done or about to be done.
#ASSERT `האם בית המשפט רשאי לתת צו להפסקת פעולה חורגת או למניעתה לבקשתי` FALSE FALSE FALSE TRUE FALSE FALSE EQUALS FALSE
-- s 56(a): the other party neither knew nor had to know of the excess.
#ASSERT `האם לפעולה שנעשתה כלפיי יש תוקף כלפי החברה` TRUE FALSE FALSE FALSE FALSE EQUALS TRUE
-- s 56(a): he should have known of the excess.
#ASSERT `האם לפעולה שנעשתה כלפיי יש תוקף כלפי החברה` TRUE FALSE FALSE FALSE TRUE EQUALS FALSE
-- s 56(a): he knew of the lack of authorisation.
#ASSERT `האם לפעולה שנעשתה כלפיי יש תוקף כלפי החברה` FALSE TRUE FALSE TRUE FALSE EQUALS FALSE
-- s 56(a): unless the company approved it in the ways of subsection (b).
#ASSERT `האם לפעולה שנעשתה כלפיי יש תוקף כלפי החברה` FALSE TRUE TRUE TRUE FALSE EQUALS TRUE
-- s 56(a): an act with no excess and no want of authorisation is valid.
#ASSERT `האם לפעולה שנעשתה כלפיי יש תוקף כלפי החברה` FALSE FALSE FALSE TRUE FALSE EQUALS TRUE
-- s 56(b): an excess of purposes is approved by the general meeting by the majority needed to change the purposes, here 75%.
#ASSERT `האם החברה שלי אישרה כדין בדיעבד את הפעולה החורגת` `חריגה ממטרות החברה` 80 20 0 TRUE 0.75 FALSE EQUALS TRUE
-- s 56(b): 70% is short of 75%.
#ASSERT `האם החברה שלי אישרה כדין בדיעבד את הפעולה החורגת` `חריגה ממטרות החברה` 70 30 0 TRUE 0.75 FALSE EQUALS FALSE
-- s 56(b): no special majority fixed, so the ordinary majority of those voting.
#ASSERT `האם החברה שלי אישרה כדין בדיעבד את הפעולה החורגת` `חריגה ממטרות החברה` 6 4 0 FALSE 0 FALSE EQUALS TRUE
-- s 56(b): an excess of purposes needs the general meeting; the organ's approval is not enough.
#ASSERT `האם החברה שלי אישרה כדין בדיעבד את הפעולה החורגת` `חריגה ממטרות החברה` 4 6 0 FALSE 0 TRUE EQUALS FALSE
-- s 56(b): an act without authorisation is approved by the organ competent to give the authorisation.
#ASSERT `האם החברה שלי אישרה כדין בדיעבד את הפעולה החורגת` `פעולה בלא הרשאה או בחריגה מן ההרשאה` 4 6 0 FALSE 0 TRUE EQUALS TRUE
-- s 56(b): the competent organ has not approved, and the general meeting's vote does not substitute for it.
#ASSERT `האם החברה שלי אישרה כדין בדיעבד את הפעולה החורגת` `פעולה בלא הרשאה או בחריגה מן ההרשאה` 8 2 0 FALSE 0 FALSE EQUALS FALSE
-- s 56(c): the approval may not harm a right acquired in good faith, for value, before it.
#ASSERT `האם האישור בדיעבד רשאי לפגוע בזכות שרכשתי` TRUE TRUE TRUE EQUALS FALSE
-- s 56(c): a right not acquired for value is not protected.
#ASSERT `האם האישור בדיעבד רשאי לפגוע בזכות שרכשתי` TRUE FALSE TRUE EQUALS TRUE

§§ `חלק 3 פרק 2: האסיפה הכללית`

-- s 57(7): a merger is decided in the general meeting.
#ASSERT `האם הענין הזה מחייב החלטה של האסיפה הכללית של החברה שלי` `מיזוג לענין סעיף 57(7)` EQUALS TRUE
-- s 57: a matter not listed.
#ASSERT `האם הענין הזה מחייב החלטה של האסיפה הכללית של החברה שלי` `ענין אחר שאינו מנוי בסעיף 57` EQUALS FALSE
-- s 58(a): a company may not vary section 57.
#ASSERT `האם החברה שלי רשאית להתנות בתקנון על הוראות סעיף 57` EQUALS FALSE
-- s 58(b): a company may add to its articles matters decided by the general meeting.
#ASSERT `האם החברה שלי רשאית להוסיף בתקנון נושאים שהחלטות בהם יתקבלו באסיפה הכללית` EQUALS TRUE
-- s 58(b): a transfer of a non-variable power must be made under section 50.
#ASSERT `האם העברת סמכות לאסיפה הכללית בתקנון של החברה שלי נעשתה כדין` TRUE FALSE EQUALS FALSE
-- s 58(b): made under section 50.
#ASSERT `האם העברת סמכות לאסיפה הכללית בתקנון של החברה שלי נעשתה כדין` TRUE TRUE EQUALS TRUE
-- s 58(b): another power can be transferred freely.
#ASSERT `האם העברת סמכות לאסיפה הכללית בתקנון של החברה שלי נעשתה כדין` FALSE FALSE EQUALS TRUE
-- s 59: the annual general meeting appoints the directors.
#ASSERT `האם האסיפה השנתית של החברה שלי היא שממנה את הדירקטורים` FALSE EQUALS TRUE
-- s 59: unless the articles provide otherwise.
#ASSERT `האם האסיפה השנתית של החברה שלי היא שממנה את הדירקטורים` TRUE EQUALS FALSE

§§ `פרק 2 סימן ב׳: האסיפה השנתית והאסיפה המיוחדת`

-- s 60(a): not later than the end of fifteen months.
#ASSERT `האם החברה שלי קיימה אסיפה שנתית בתוך חמישה עשר חודשים מהאסיפה הקודמת` 15 EQUALS TRUE
-- s 60(a): sixteen months.
#ASSERT `האם החברה שלי קיימה אסיפה שנתית בתוך חמישה עשר חודשים מהאסיפה הקודמת` 16 EQUALS FALSE
-- s 60(a): twelve months.
#ASSERT `האם החברה שלי קיימה אסיפה שנתית בתוך חמישה עשר חודשים מהאסיפה הקודמת` 12 EQUALS TRUE
-- s 60(b): both the financial statements and the board's report.
#ASSERT `האם סדר היום באסיפה השנתית של החברה שלי כולל דיון בדוחות הכספיים ובדיווח הדירקטוריון` TRUE TRUE EQUALS TRUE
-- s 60(b): the board's report is missing.
#ASSERT `האם סדר היום באסיפה השנתית של החברה שלי כולל דיון בדוחות הכספיים ובדיווח הדירקטוריון` TRUE FALSE EQUALS FALSE
-- s 60(b): appointing directors may be on the annual meeting's agenda.
#ASSERT `האם הנושא הזה יכול להיכלל בסדר היום של האסיפה השנתית של החברה שלי` `מינוי דירקטורים` FALSE EQUALS TRUE
-- s 60(b): any other matter set on the agenda under section 66.
#ASSERT `האם הנושא הזה יכול להיכלל בסדר היום של האסיפה השנתית של החברה שלי` `נושא אחר שאינו מנוי בסעיף 60(ב)` TRUE EQUALS TRUE
-- s 60(b): another matter not so set.
#ASSERT `האם הנושא הזה יכול להיכלל בסדר היום של האסיפה השנתית של החברה שלי` `נושא אחר שאינו מנוי בסעיף 60(ב)` FALSE EQUALS FALSE
-- s 61(a): a private company whose articles dispense with the annual meeting, no auditor need and no demand.
#ASSERT `האם החברה שלי חייבת לקיים אסיפה שנתית` FALSE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS FALSE
-- s 61(a): a shareholder or director demanded one.
#ASSERT `האם החברה שלי חייבת לקיים אסיפה שנתית` FALSE FALSE FALSE FALSE TRUE FALSE TRUE EQUALS TRUE
-- s 61(a): needed to appoint an external auditor.
#ASSERT `האם החברה שלי חייבת לקיים אסיפה שנתית` FALSE FALSE FALSE FALSE TRUE TRUE FALSE EQUALS TRUE
-- s 61(a): the articles contain no dispensing provision.
#ASSERT `האם החברה שלי חייבת לקיים אסיפה שנתית` FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS TRUE
-- s 61(a): only a private company may dispense; this one is public.
#ASSERT `האם החברה שלי חייבת לקיים אסיפה שנתית` TRUE FALSE FALSE TRUE TRUE FALSE FALSE EQUALS TRUE
-- s 61(b): sent no later than the last date for the annual meeting.
#ASSERT `האם החברה שלי שלחה לי כבעל מניות רשום את הדוחות הכספיים במועד` TRUE 0 EQUALS TRUE
-- s 61(b): sent five days late.
#ASSERT `האם החברה שלי שלחה לי כבעל מניות רשום את הדוחות הכספיים במועד` TRUE 5 EQUALS FALSE
-- s 61(b): an annual meeting was held, so this duty does not arise.
#ASSERT `האם החברה שלי שלחה לי כבעל מניות רשום את הדוחות הכספיים במועד` FALSE 90 EQUALS TRUE
-- s 62(a): no annual meeting was held, on a shareholder's application.
#ASSERT `האם בית המשפט רשאי להורות על כינוס אסיפה שנתית בחברה שלי לבקשתי` TRUE FALSE TRUE FALSE EQUALS TRUE
-- s 62(a): a meeting required under section 61 was not held, on a director's application.
#ASSERT `האם בית המשפט רשאי להורות על כינוס אסיפה שנתית בחברה שלי לבקשתי` FALSE TRUE FALSE TRUE EQUALS TRUE
-- s 62(a): the applicant is neither a shareholder nor a director.
#ASSERT `האם בית המשפט רשאי להורות על כינוס אסיפה שנתית בחברה שלי לבקשתי` TRUE FALSE FALSE FALSE EQUALS FALSE
-- s 62(a): no meeting is missing.
#ASSERT `האם בית המשפט רשאי להורות על כינוס אסיפה שנתית בחברה שלי לבקשתי` FALSE FALSE TRUE FALSE EQUALS FALSE
-- s 62(b): the court ordered the annual meeting convened, so the company bears the applicant's reasonable costs.
#ASSERT `האם החברה שלי נושאת בהוצאותיי הסבירות בהליך כינוס האסיפה השנתית` TRUE EQUALS TRUE
-- s 62(b): no order.
#ASSERT `האם החברה שלי נושאת בהוצאותיי הסבירות בהליך כינוס האסיפה השנתית` FALSE EQUALS FALSE
-- s 62(b): the directors responsible for the failure to convene must repay the company.
#ASSERT `האם אני כדירקטור אחראי חייב להשיב לחברה את ההוצאות של כינוס האסיפה השנתית` TRUE TRUE EQUALS TRUE
-- s 62(b): I am not responsible for the failure.
#ASSERT `האם אני כדירקטור אחראי חייב להשיב לחברה את ההוצאות של כינוס האסיפה השנתית` TRUE FALSE EQUALS FALSE
-- s 63(a): the board of a private company convenes on its own decision.
#ASSERT `האם הדירקטוריון של החברה הפרטית שלי חייב לכנס אסיפה מיוחדת` FALSE FALSE FALSE FALSE TRUE 0 0 0 EQUALS TRUE
-- s 63(a)(1): one director demanding is enough in a private company.
#ASSERT `האם הדירקטוריון של החברה הפרטית שלי חייב לכנס אסיפה מיוחדת` FALSE FALSE FALSE FALSE FALSE 1 0 0 EQUALS TRUE
-- s 63(a)(2): shareholders with 10% of the issued capital and 1% of the voting rights.
#ASSERT `האם הדירקטוריון של החברה הפרטית שלי חייב לכנס אסיפה מיוחדת` FALSE FALSE FALSE FALSE FALSE 0 0.1 0.01 EQUALS TRUE
-- s 63(a)(2): less than 1% of the voting rights, and under 10% of them.
#ASSERT `האם הדירקטוריון של החברה הפרטית שלי חייב לכנס אסיפה מיוחדת` FALSE FALSE FALSE FALSE FALSE 0 0.1 0.005 EQUALS FALSE
-- s 63(a)(2): shareholders with 10% or more of the voting rights.
#ASSERT `האם הדירקטוריון של החברה הפרטית שלי חייב לכנס אסיפה מיוחדת` FALSE FALSE FALSE FALSE FALSE 0 0 0.12 EQUALS TRUE
-- s 63(a)(2): 9% of the capital and 9% of the votes fall short.
#ASSERT `האם הדירקטוריון של החברה הפרטית שלי חייב לכנס אסיפה מיוחדת` FALSE FALSE FALSE FALSE FALSE 0 0.09 0.09 EQUALS FALSE
-- s 63(a): this is a public company, so subsection (a) does not apply to it.
#ASSERT `האם הדירקטוריון של החברה הפרטית שלי חייב לכנס אסיפה מיוחדת` TRUE FALSE FALSE TRUE TRUE 0 0 0 EQUALS FALSE
-- s 63(b): the board of a public company convenes on its own decision.
#ASSERT `האם הדירקטוריון של החברה הציבורית שלי חייב לכנס אסיפה מיוחדת` TRUE FALSE FALSE TRUE TRUE 0 0 0 0 EQUALS TRUE
-- s 63(b)(1): two directors.
#ASSERT `האם הדירקטוריון של החברה הציבורית שלי חייב לכנס אסיפה מיוחדת` TRUE FALSE FALSE TRUE FALSE 2 10 0 0 EQUALS TRUE
-- s 63(b)(1): one of ten is neither two directors nor a quarter.
#ASSERT `האם הדירקטוריון של החברה הציבורית שלי חייב לכנס אסיפה מיוחדת` TRUE FALSE FALSE TRUE FALSE 1 10 0 0 EQUALS FALSE
-- s 63(b)(1): one of four is a quarter of the serving directors.
#ASSERT `האם הדירקטוריון של החברה הציבורית שלי חייב לכנס אסיפה מיוחדת` TRUE FALSE FALSE TRUE FALSE 1 4 0 0 EQUALS TRUE
-- s 63(b)(1): one of five is under a quarter.
#ASSERT `האם הדירקטוריון של החברה הציבורית שלי חייב לכנס אסיפה מיוחדת` TRUE FALSE FALSE TRUE FALSE 1 5 0 0 EQUALS FALSE
-- s 63(b)(2): 5% of the issued capital and 1% of the voting rights.
#ASSERT `האם הדירקטוריון של החברה הציבורית שלי חייב לכנס אסיפה מיוחדת` TRUE FALSE FALSE TRUE FALSE 0 0 0.05 0.01 EQUALS TRUE
-- s 63(b)(2): 5% of the voting rights.
#ASSERT `האם הדירקטוריון של החברה הציבורית שלי חייב לכנס אסיפה מיוחדת` TRUE FALSE FALSE TRUE FALSE 0 0 0 0.05 EQUALS TRUE
-- s 63(b)(2): 4% and 4% fall short.
#ASSERT `האם הדירקטוריון של החברה הציבורית שלי חייב לכנס אסיפה מיוחדת` TRUE FALSE FALSE TRUE FALSE 0 0 0.04 0.04 EQUALS FALSE
-- s 63(b): this is a private company, so subsection (b) does not apply to it.
#ASSERT `האם הדירקטוריון של החברה הציבורית שלי חייב לכנס אסיפה מיוחדת` FALSE FALSE FALSE FALSE FALSE 2 0 0 0 EQUALS FALSE
-- s 63(c): within twenty-one days of the demand.
#ASSERT `האם הדירקטוריון זימן את האסיפה המיוחדת שדרשתי בתוך עשרים ואחד ימים` 21 EQUALS TRUE
-- s 63(c): twenty-two days.
#ASSERT `האם הדירקטוריון זימן את האסיפה המיוחדת שדרשתי בתוך עשרים ואחד ימים` 22 EQUALS FALSE
-- s 63(c): the meeting date is not later than thirty-five days from publishing the notice.
#ASSERT `האם מועד הכינוס של האסיפה המיוחדת בחברה הציבורית שלי תקין` TRUE FALSE FALSE TRUE 35 FALSE EQUALS (JUST TRUE)
-- s 63(c): thirty-six days is later than thirty-five.
#ASSERT `האם מועד הכינוס של האסיפה המיוחדת בחברה הציבורית שלי תקין` TRUE FALSE FALSE TRUE 36 FALSE EQUALS (JUST FALSE)
-- s 63(c): unless otherwise provided for a meeting to which the sub-chapter on voting in writing applies.
#ASSERT `האם מועד הכינוס של האסיפה המיוחדת בחברה הציבורית שלי תקין` TRUE FALSE FALSE TRUE 60 TRUE EQUALS (JUST TRUE)
-- s 63(c): the thirty-five-day limit is stated for a public company, so for a private company the rule does not decide.
#ASSERT `האם מועד הכינוס של האסיפה המיוחדת בחברה הציבורית שלי תקין` FALSE FALSE FALSE FALSE 60 FALSE EQUALS NOTHING
-- s 64(a): the board did not convene, the requester convenes, and the meeting is within three months.
#ASSERT `האם אני כדורש רשאי לכנס את האסיפה בעצמי` TRUE TRUE FALSE 0 3 EQUALS TRUE
-- s 64(a): the meeting would be held after three months.
#ASSERT `האם אני כדורש רשאי לכנס את האסיפה בעצמי` TRUE TRUE FALSE 0 4 EQUALS FALSE
-- s 64(a): requesting shareholders who hold more than half of the requesters' voting rights may convene.
#ASSERT `האם אני כדורש רשאי לכנס את האסיפה בעצמי` TRUE FALSE TRUE 0.6 2 EQUALS TRUE
-- s 64(a): exactly half is not more than half.
#ASSERT `האם אני כדורש רשאי לכנס את האסיפה בעצמי` TRUE FALSE TRUE 0.5 2 EQUALS FALSE
-- s 64(a): the board did convene the meeting.
#ASSERT `האם אני כדורש רשאי לכנס את האסיפה בעצמי` FALSE TRUE FALSE 0 1 EQUALS FALSE
-- s 64(b): the company covers the requester's reasonable costs.
#ASSERT `האם החברה מכסה את הוצאותיי הסבירות כשכינסתי אסיפה בעצמי` TRUE EQUALS TRUE
-- s 64(b): no meeting was convened under subsection (a).
#ASSERT `האם החברה מכסה את הוצאותיי הסבירות כשכינסתי אסיפה בעצמי` FALSE EQUALS FALSE
-- s 64(b): the directors responsible for the failure to convene must repay the company.
#ASSERT `האם אני כדירקטור אחראי חייב להשיב לחברה את הוצאות הדורש שכינס אסיפה` TRUE TRUE EQUALS TRUE
-- s 64(b): I am not responsible.
#ASSERT `האם אני כדירקטור אחראי חייב להשיב לחברה את הוצאות הדורש שכינס אסיפה` TRUE FALSE EQUALS FALSE
-- s 65(a): the board did not convene the meeting required, on the requester's application.
#ASSERT `האם בית המשפט רשאי להורות על כינוס האסיפה המיוחדת שדרשתי` TRUE TRUE EQUALS TRUE
-- s 65(a): the applicant is not the requester.
#ASSERT `האם בית המשפט רשאי להורות על כינוס האסיפה המיוחדת שדרשתי` TRUE FALSE EQUALS FALSE
-- s 65(a): the board did convene.
#ASSERT `האם בית המשפט רשאי להורות על כינוס האסיפה המיוחדת שדרשתי` FALSE TRUE EQUALS FALSE
-- s 65(b): the court ordered the special meeting convened, so the company bears the applicant's reasonable costs.
#ASSERT `האם החברה נושאת בהוצאותיי הסבירות בהליך כינוס האסיפה המיוחדת` TRUE EQUALS TRUE
-- s 65(b): no order.
#ASSERT `האם החברה נושאת בהוצאותיי הסבירות בהליך כינוס האסיפה המיוחדת` FALSE EQUALS FALSE
-- s 65(b): the responsible directors must repay the company.
#ASSERT `האם אני כדירקטור אחראי חייב להשיב לחברה את הוצאות הליך כינוס האסיפה המיוחדת` TRUE TRUE EQUALS TRUE
-- s 65(b): the court ordered nothing.
#ASSERT `האם אני כדירקטור אחראי חייב להשיב לחברה את הוצאות הליך כינוס האסיפה המיוחדת` FALSE TRUE EQUALS FALSE

§§ `פרק 2 סימן ג׳: זימון האסיפה הכללית וניהולה`

-- s 66(a): a special meeting is needed under section 63 because of the matter.
#ASSERT `האם הנושא חייב להיכלל בסדר היום של האסיפה בחברה שלי` TRUE FALSE EQUALS TRUE
-- s 66(a): the matter was requested as subsection (b) provides.
#ASSERT `האם הנושא חייב להיכלל בסדר היום של האסיפה בחברה שלי` FALSE TRUE EQUALS TRUE
-- s 66(a): neither.
#ASSERT `האם הנושא חייב להיכלל בסדר היום של האסיפה בחברה שלי` FALSE FALSE EQUALS FALSE
-- s 66(b): shareholders holding at least 1% of the voting rights, for a matter suitable for the general meeting.
#ASSERT `האם אני כבעל מניות רשאי לבקש מהדירקטוריון לכלול נושא בסדר היום` 0.01 TRUE EQUALS TRUE
-- s 66(b): under 1% of the voting rights.
#ASSERT `האם אני כבעל מניות רשאי לבקש מהדירקטוריון לכלול נושא בסדר היום` 0.009 TRUE EQUALS FALSE
-- s 66(b): the matter is not suitable for a general meeting.
#ASSERT `האם אני כבעל מניות רשאי לבקש מהדירקטוריון לכלול נושא בסדר היום` 0.05 FALSE EQUALS FALSE
-- s 66(c): a resolution may be adopted on matters set out in the agenda.
#ASSERT `האם באסיפה הכללית אפשר לקבל החלטה בנושא זה` TRUE EQUALS TRUE
-- s 66(c): a matter not set out in the agenda.
#ASSERT `האם באסיפה הכללית אפשר לקבל החלטה בנושא זה` FALSE EQUALS FALSE
-- s 67: delivered to everyone entitled, seven days before the meeting (the minimum when the articles fix none).
#ASSERT `האם ההזמנה לאסיפה הכללית בחברה הפרטית שלי נמסרה במועד` TRUE 7 FALSE 0 FALSE 0 EQUALS TRUE
-- s 67: six days is under the seven-day minimum.
#ASSERT `האם ההזמנה לאסיפה הכללית בחברה הפרטית שלי נמסרה במועד` TRUE 6 FALSE 0 FALSE 0 EQUALS FALSE
-- s 67: forty-five days is the longest allowed when the articles fix none.
#ASSERT `האם ההזמנה לאסיפה הכללית בחברה הפרטית שלי נמסרה במועד` TRUE 45 FALSE 0 FALSE 0 EQUALS TRUE
-- s 67: forty-six days is over the maximum.
#ASSERT `האם ההזמנה לאסיפה הכללית בחברה הפרטית שלי נמסרה במועד` TRUE 46 FALSE 0 FALSE 0 EQUALS FALSE
-- s 67: the articles fix a minimum of ten days and only nine were given.
#ASSERT `האם ההזמנה לאסיפה הכללית בחברה הפרטית שלי נמסרה במועד` TRUE 9 TRUE 10 FALSE 0 EQUALS FALSE
-- s 67: ten days meets the articles' minimum.
#ASSERT `האם ההזמנה לאסיפה הכללית בחברה הפרטית שלי נמסרה במועד` TRUE 10 TRUE 10 FALSE 0 EQUALS TRUE
-- s 67: the articles fix a maximum of thirty days.
#ASSERT `האם ההזמנה לאסיפה הכללית בחברה הפרטית שלי נמסרה במועד` TRUE 31 FALSE 0 TRUE 30 EQUALS FALSE
-- s 67: not delivered to everyone entitled to take part.
#ASSERT `האם ההזמנה לאסיפה הכללית בחברה הפרטית שלי נמסרה במועד` FALSE 10 FALSE 0 FALSE 0 EQUALS FALSE
-- s 68(a): date, place, agenda and a reasonable detail of the matters.
#ASSERT `האם ההזמנה לאסיפה הכללית בחברה הפרטית שלי כוללת את הפרטים הנדרשים` TRUE TRUE TRUE TRUE EQUALS TRUE
-- s 68(a): the place is not stated.
#ASSERT `האם ההזמנה לאסיפה הכללית בחברה הפרטית שלי כוללת את הפרטים הנדרשים` TRUE FALSE TRUE TRUE EQUALS FALSE
-- s 68(b): the wording of the proposed amendment is set out.
#ASSERT `האם בהזמנה פורט נוסח השינוי המוצע בתקנון של החברה שלי` TRUE TRUE EQUALS TRUE
-- s 68(b): a proposal to amend the articles without its wording.
#ASSERT `האם בהזמנה פורט נוסח השינוי המוצע בתקנון של החברה שלי` TRUE FALSE EQUALS FALSE
-- s 68(b): no proposal to amend the articles on the agenda.
#ASSERT `האם בהזמנה פורט נוסח השינוי המוצע בתקנון של החברה שלי` FALSE FALSE EQUALS TRUE
-- s 69(a): published or delivered as the Minister fixed.
#ASSERT `האם ההודעה על האסיפה הכללית בחברה הציבורית שלי פורסמה או נמסרה כדין` TRUE EQUALS TRUE
-- s 69(a): not so published or delivered.
#ASSERT `האם ההודעה על האסיפה הכללית בחברה הציבורית שלי פורסמה או נמסרה כדין` FALSE EQUALS FALSE
-- s 69(c): the agenda, the proposed resolutions and the written-voting arrangements.
#ASSERT `האם ההודעה על האסיפה בחברה הציבורית שלי כוללת את סדר היום, ההחלטות המוצעות והסדרי ההצבעה בכתב` TRUE TRUE TRUE EQUALS TRUE
-- s 69(c): no arrangements for voting in writing.
#ASSERT `האם ההודעה על האסיפה בחברה הציבורית שלי כוללת את סדר היום, ההחלטות המוצעות והסדרי ההצבעה בכתב` TRUE TRUE FALSE EQUALS FALSE
-- s 71: a shareholder in a public company who wants to vote and holds through a bourse member.
#ASSERT `האם אני כבעל מניה בחברה ציבורית זכאי לאישור בעלות מחבר הבורסה` TRUE FALSE FALSE TRUE TRUE TRUE EQUALS TRUE
-- s 71: this is a private company.
#ASSERT `האם אני כבעל מניה בחברה ציבורית זכאי לאישור בעלות מחבר הבורסה` FALSE FALSE FALSE FALSE TRUE TRUE EQUALS FALSE
-- s 71: the share is not held through a bourse member.
#ASSERT `האם אני כבעל מניה בחברה ציבורית זכאי לאישור בעלות מחבר הבורסה` TRUE FALSE FALSE TRUE TRUE FALSE EQUALS FALSE
-- s 72: no practical way to convene or run the meeting as provided, on a voting shareholder's application.
#ASSERT `האם בית המשפט רשאי להורות על כינוס וניהול אסיפה בחברה שלי בדרך שיקבע` TRUE FALSE TRUE FALSE EQUALS TRUE
-- s 72: the applicant is neither the company, a voting shareholder nor a director.
#ASSERT `האם בית המשפט רשאי להורות על כינוס וניהול אסיפה בחברה שלי בדרך שיקבע` TRUE FALSE FALSE FALSE EQUALS FALSE
-- s 72: it is practicable to convene as provided.
#ASSERT `האם בית המשפט רשאי להורות על כינוס וניהול אסיפה בחברה שלי בדרך שיקבע` FALSE FALSE FALSE TRUE EQUALS FALSE
-- s 73: a public company whose shares were offered to the public in Israel only.
#ASSERT `האם החברה הציבורית שלי חייבת לקיים אסיפה כללית בישראל` TRUE FALSE FALSE TRUE TRUE FALSE EQUALS TRUE
-- s 73: or traded on a bourse in Israel only.
#ASSERT `האם החברה הציבורית שלי חייבת לקיים אסיפה כללית בישראל` TRUE FALSE FALSE TRUE FALSE TRUE EQUALS TRUE
-- s 73: the shares were offered or traded abroad too.
#ASSERT `האם החברה הציבורית שלי חייבת לקיים אסיפה כללית בישראל` TRUE FALSE FALSE TRUE FALSE FALSE EQUALS FALSE
-- s 73: this is a private company.
#ASSERT `האם החברה הציבורית שלי חייבת לקיים אסיפה כללית בישראל` FALSE FALSE FALSE FALSE FALSE TRUE EQUALS FALSE
-- s 74(a): a meeting with a quorum may decide to adjourn.
#ASSERT `האם אסיפה כללית של החברה שלי רשאית להחליט על דחייתה` TRUE EQUALS TRUE
-- s 74(a): no quorum.
#ASSERT `האם אסיפה כללית של החברה שלי רשאית להחליט על דחייתה` FALSE EQUALS FALSE
-- s 74(a): a matter that was on the agenda and on which no resolution was adopted.
#ASSERT `האם באסיפה הנדחית אפשר לדון בנושא זה` TRUE FALSE EQUALS TRUE
-- s 74(a): a resolution was adopted on it.
#ASSERT `האם באסיפה הנדחית אפשר לדון בנושא זה` TRUE TRUE EQUALS FALSE
-- s 74(b): adjourned to more than twenty-one days.
#ASSERT `האם על ההזמנה לאסיפה שנדחתה חלים סעיפים 67 עד 69` 22 EQUALS TRUE
-- s 74(b): exactly twenty-one days is not more.
#ASSERT `האם על ההזמנה לאסיפה שנדחתה חלים סעיפים 67 עד 69` 21 EQUALS FALSE
-- s 74(c): notice at least seventy-two hours before an adjourned meeting within twenty-one days, with the agenda unchanged.
#ASSERT `האם ההודעה על המועד החדש של האסיפה הנדחית ניתנה במועד` TRUE 21 72 EQUALS (JUST TRUE)
-- s 74(c): seventy-one hours is too few.
#ASSERT `האם ההודעה על המועד החדש של האסיפה הנדחית ניתנה במועד` TRUE 21 71 EQUALS (JUST FALSE)
-- s 74(c): adjourned beyond twenty-one days, where section 74(b) governs, so this rule does not decide.
#ASSERT `האם ההודעה על המועד החדש של האסיפה הנדחית ניתנה במועד` TRUE 22 100 EQUALS NOTHING
-- s 74(c): the agenda was changed, so this rule does not decide.
#ASSERT `האם ההודעה על המועד החדש של האסיפה הנדחית ניתנה במועד` FALSE 10 100 EQUALS NOTHING
-- s 75: they apply to a class meeting the company must hold.
#ASSERT `האם הוראות הסימנים על אסיפה כללית חלות על אסיפת הסוג שלי` TRUE EQUALS TRUE
-- s 75: not such a class meeting.
#ASSERT `האם הוראות הסימנים על אסיפה כללית חלות על אסיפת הסוג שלי` FALSE EQUALS FALSE

§§ `פרק 2 סימן ד׳: אסיפה כללית בחברה פרטית`

-- s 76: a private company's resolution adopted unanimously by all the shareholders entitled to vote.
#ASSERT `האם בחברה הפרטית שלי אפשר לקבל החלטה של האסיפה הכללית ללא הזמנה וללא התכנסות` FALSE FALSE FALSE FALSE TRUE EQUALS TRUE
-- s 76: not unanimous.
#ASSERT `האם בחברה הפרטית שלי אפשר לקבל החלטה של האסיפה הכללית ללא הזמנה וללא התכנסות` FALSE FALSE FALSE FALSE FALSE EQUALS FALSE
-- s 76: this is a public company.
#ASSERT `האם בחברה הפרטית שלי אפשר לקבל החלטה של האסיפה הכללית ללא הזמנה וללא התכנסות` TRUE FALSE FALSE TRUE TRUE EQUALS FALSE
-- s 77: all the participants can hear one another at the same time and the articles do not forbid it.
#ASSERT `האם החברה הפרטית שלי רשאית לקיים אסיפה כללית באמצעי תקשורת` FALSE FALSE FALSE FALSE FALSE TRUE EQUALS TRUE
-- s 77: the articles forbid it.
#ASSERT `האם החברה הפרטית שלי רשאית לקיים אסיפה כללית באמצעי תקשורת` FALSE FALSE FALSE FALSE TRUE TRUE EQUALS FALSE
-- s 77: the participants cannot hear one another at the same time.
#ASSERT `האם החברה הפרטית שלי רשאית לקיים אסיפה כללית באמצעי תקשורת` FALSE FALSE FALSE FALSE FALSE FALSE EQUALS FALSE
-- s 77: a public company.
#ASSERT `האם החברה הפרטית שלי רשאית לקיים אסיפה כללית באמצעי תקשורת` TRUE FALSE FALSE TRUE FALSE TRUE EQUALS FALSE

§§ `פרק 2 סימן ה׳: המנין החוקי ויושב ראש האסיפה`

-- s 78(c): for a company with one shareholder the quorum rules do not apply.
#ASSERT `האם באסיפה הכללית של החברה שלי נכח מנין חוקי` TRUE FALSE FALSE 0 0 0 EQUALS TRUE
-- s 78(a): two shareholders with 25% of the voting rights within half an hour.
#ASSERT `האם באסיפה הכללית של החברה שלי נכח מנין חוקי` FALSE FALSE FALSE 2 0.25 30 EQUALS TRUE
-- s 78(a): only one shareholder present.
#ASSERT `האם באסיפה הכללית של החברה שלי נכח מנין חוקי` FALSE FALSE FALSE 1 0.9 10 EQUALS FALSE
-- s 78(a): under 25% of the voting rights.
#ASSERT `האם באסיפה הכללית של החברה שלי נכח מנין חוקי` FALSE FALSE FALSE 2 0.24 10 EQUALS FALSE
-- s 78(a): the quorum came after half an hour.
#ASSERT `האם באסיפה הכללית של החברה שלי נכח מנין חוקי` FALSE FALSE FALSE 2 0.5 31 EQUALS FALSE
-- s 78: another quorum fixed in the articles and met.
#ASSERT `האם באסיפה הכללית של החברה שלי נכח מנין חוקי` FALSE TRUE TRUE 0 0 0 EQUALS TRUE
-- s 78: the articles fix another quorum and it was not met.
#ASSERT `האם באסיפה הכללית של החברה שלי נכח מנין חוקי` FALSE TRUE FALSE 5 0.9 5 EQUALS FALSE
-- s 78(b): adjourned to the same day the following week.
#ASSERT `לאיזה מועד נדחית האסיפה שלא היה בה מנין חוקי` TRUE FALSE 0 EQUALS (JUST 7)
-- s 78(b): or to a later date the invitation or notice states, here fourteen days on.
#ASSERT `לאיזה מועד נדחית האסיפה שלא היה בה מנין חוקי` TRUE TRUE 14 EQUALS (JUST 14)
-- s 78(b): five days is not a later date than a week, so the week applies.
#ASSERT `לאיזה מועד נדחית האסיפה שלא היה בה מנין חוקי` TRUE TRUE 5 EQUALS (JUST 7)
-- s 78(b): a quorum was present at half an hour, so there is no adjournment under this rule.
#ASSERT `לאיזה מועד נדחית האסיפה שלא היה בה מנין חוקי` FALSE TRUE 14 EQUALS NOTHING
-- s 78(c): a company with more than one shareholder.
#ASSERT `האם הוראות הסימן על המנין החוקי חלות על החברה שלי` 2 EQUALS TRUE
-- s 78(c): a company with one shareholder.
#ASSERT `האם הוראות הסימן על המנין החוקי חלות על החברה שלי` 1 EQUALS FALSE
-- s 79(a): no quorum at the adjourned meeting after half an hour, so it is held with any number.
#ASSERT `האם האסיפה הנדחית של החברה שלי מתקיימת בכל מספר משתתפים` TRUE FALSE EQUALS TRUE
-- s 79(a): not so where convened at shareholders' demand.
#ASSERT `האם האסיפה הנדחית של החברה שלי מתקיימת בכל מספר משתתפים` TRUE TRUE EQUALS FALSE
-- s 79(a): a quorum was present at the adjourned meeting.
#ASSERT `האם האסיפה הנדחית של החברה שלי מתקיימת בכל מספר משתתפים` FALSE FALSE EQUALS FALSE
-- s 79(b): a private company's meeting convened on demand, with shareholders holding 10% of the capital and 1% of the votes present.
#ASSERT `האם האסיפה הנדחית שכונסה על פי דרישתי מתקיימת עם בעלי המניות שנכחו` FALSE FALSE FALSE FALSE TRUE 0.1 0.01 EQUALS TRUE
-- s 79(b): a private company: under the 10% and 1% needed.
#ASSERT `האם האסיפה הנדחית שכונסה על פי דרישתי מתקיימת עם בעלי המניות שנכחו` FALSE FALSE FALSE FALSE TRUE 0.09 0.009 EQUALS FALSE
-- s 79(b): a public company needs only 5% of the capital and 1% of the votes.
#ASSERT `האם האסיפה הנדחית שכונסה על פי דרישתי מתקיימת עם בעלי המניות שנכחו` TRUE FALSE FALSE TRUE TRUE 0.05 0.01 EQUALS TRUE
-- s 79(b): a public company: 4% and 4% fall short.
#ASSERT `האם האסיפה הנדחית שכונסה על פי דרישתי מתקיימת עם בעלי המניות שנכחו` TRUE FALSE FALSE TRUE TRUE 0.04 0.04 EQUALS FALSE
-- s 79(b): not convened at the shareholders' demand, so no such number is needed.
#ASSERT `האם האסיפה הנדחית שכונסה על פי דרישתי מתקיימת עם בעלי המניות שנכחו` FALSE FALSE FALSE FALSE FALSE 0 0 EQUALS TRUE
-- s 80(a): a chair is elected for a general meeting.
#ASSERT `האם באסיפה הכללית של החברה שלי ייבחר יושב ראש לאסיפה` TRUE EQUALS TRUE
-- s 80(a): not a general meeting.
#ASSERT `האם באסיפה הכללית של החברה שלי ייבחר יושב ראש לאסיפה` FALSE EQUALS FALSE
-- s 80(b): opened by the chair of the board.
#ASSERT `האם הדיון שבו ייבחר יושב ראש האסיפה נפתח כדין` TRUE FALSE EQUALS TRUE
-- s 80(b): or by a director the board authorised.
#ASSERT `האם הדיון שבו ייבחר יושב ראש האסיפה נפתח כדין` FALSE TRUE EQUALS TRUE
-- s 80(b): opened by neither.
#ASSERT `האם הדיון שבו ייבחר יושב ראש האסיפה נפתח כדין` FALSE FALSE EQUALS FALSE
-- s 81: the articles may vary the sub-chapter.
#ASSERT `האם החברה שלי רשאית להתנות בתקנון על הוראות הסימן על המנין החוקי והיושב ראש` EQUALS TRUE

§§ `פרק 2 סימן ו׳: הצבעה באסיפה הכללית`

-- s 82(a): the articles may fix different voting rights for different classes of shares.
#ASSERT `האם החברה שלי רשאית לקבוע בתקנונה זכויות הצבעה שונות לסוגים שונים של מניות` EQUALS TRUE
-- s 82(b): valid while they meet another enactment.
#ASSERT `האם זכויות ההצבעה השונות שנקבעו בתקנון של החברה שלי תקפות` TRUE EQUALS TRUE
-- s 82(b): they do not meet another enactment.
#ASSERT `האם זכויות ההצבעה השונות שנקבעו בתקנון של החברה שלי תקפות` FALSE EQUALS FALSE
-- s 82(c): the articles fix ten votes for the share.
#ASSERT `כמה קולות יש למניה שלי` TRUE 10 EQUALS 10
-- s 82(c): the articles fixed no different voting rights, so one vote.
#ASSERT `כמה קולות יש למניה שלי` FALSE 10 EQUALS 1

§§ `פרק 2 סימן ו׳: הצבעה בדרכים שונות`

-- s 83(a): a shareholder in a public company may vote by voting deed.
#ASSERT `האם אני כבעל מניה בחברה ציבורית רשאי להצביע בדרך זו` TRUE FALSE FALSE TRUE `הצבעה באמצעות כתב הצבעה` EQUALS TRUE
-- s 83(a): or in person.
#ASSERT `האם אני כבעל מניה בחברה ציבורית רשאי להצביע בדרך זו` TRUE FALSE FALSE TRUE `הצבעה בעצמו` EQUALS TRUE
-- s 83(a): this is a private company.
#ASSERT `האם אני כבעל מניה בחברה ציבורית רשאי להצביע בדרך זו` FALSE FALSE FALSE FALSE `הצבעה בעצמו` EQUALS FALSE
-- s 83(b): a shareholder in a private company may vote in person.
#ASSERT `האם אני כבעל מניה בחברה פרטית רשאי להצביע בדרך זו` FALSE FALSE FALSE FALSE `הצבעה בעצמו` FALSE EQUALS TRUE
-- s 83(b): or by proxy.
#ASSERT `האם אני כבעל מניה בחברה פרטית רשאי להצביע בדרך זו` FALSE FALSE FALSE FALSE `הצבעה באמצעות שלוח` FALSE EQUALS TRUE
-- s 83(b): a voting deed is not among the two ways.
#ASSERT `האם אני כבעל מניה בחברה פרטית רשאי להצביע בדרך זו` FALSE FALSE FALSE FALSE `הצבעה באמצעות כתב הצבעה` FALSE EQUALS FALSE
-- s 83(b): the articles provide otherwise.
#ASSERT `האם אני כבעל מניה בחברה פרטית רשאי להצביע בדרך זו` FALSE FALSE FALSE FALSE `הצבעה באמצעות שלוח` TRUE EQUALS FALSE
-- s 83(b): this is a public company.
#ASSERT `האם אני כבעל מניה בחברה פרטית רשאי להצביע בדרך זו` TRUE FALSE FALSE TRUE `הצבעה בעצמו` FALSE EQUALS FALSE
-- s 83(c): the articles contain provisions for voting in writing.
#ASSERT `האם אני כבעל מניה בחברה פרטית רשאי להצביע בכתב` FALSE FALSE FALSE FALSE TRUE EQUALS TRUE
-- s 83(c): they do not.
#ASSERT `האם אני כבעל מניה בחברה פרטית רשאי להצביע בכתב` FALSE FALSE FALSE FALSE FALSE EQUALS FALSE
-- s 83(c): this is a public company.
#ASSERT `האם אני כבעל מניה בחברה פרטית רשאי להצביע בכתב` TRUE FALSE FALSE TRUE TRUE EQUALS FALSE
-- s 83(d): a vote in person is deemed later than a voting deed, so it counts.
#ASSERT `איזו מהצבעותיי נמנית כשהצבעתי ביותר מדרך אחת` `הצבעה באמצעות כתב הצבעה` `הצבעה בעצמו` FALSE EQUALS `הצבעה בעצמו`
-- s 83(d): the vote in person counts, as the later.
#ASSERT `איזו מהצבעותיי נמנית כשהצבעתי ביותר מדרך אחת` `הצבעה בעצמו` `הצבעה באמצעות כתב הצבעה` TRUE EQUALS `הצבעה בעצמו`
-- s 83(d): a vote in person is deemed later than a deed even if the deed was cast later in fact.
#ASSERT `איזו מהצבעותיי נמנית כשהצבעתי ביותר מדרך אחת` `הצבעה בעצמו` `הצבעה באמצעות כתב הצבעה` FALSE EQUALS `הצבעה בעצמו`
-- s 83(d): the later vote counts, the proxy being the later in fact.
#ASSERT `איזו מהצבעותיי נמנית כשהצבעתי ביותר מדרך אחת` `הצבעה בעצמו` `הצבעה באמצעות שלוח` FALSE EQUALS `הצבעה באמצעות שלוח`
-- s 83(d): the vote in person was the later in fact.
#ASSERT `איזו מהצבעותיי נמנית כשהצבעתי ביותר מדרך אחת` `הצבעה בעצמו` `הצבעה באמצעות שלוח` TRUE EQUALS `הצבעה בעצמו`
-- s 84: resolutions are adopted by a vote counted by votes.
#ASSERT `האם החלטה באסיפה הכללית של החברה שלי מתקבלת בהצבעה במנין קולות` FALSE FALSE FALSE FALSE FALSE EQUALS TRUE
-- s 84: a private company whose articles fix a different deciding rule.
#ASSERT `האם החלטה באסיפה הכללית של החברה שלי מתקבלת בהצבעה במנין קולות` FALSE FALSE FALSE FALSE TRUE EQUALS FALSE
-- s 84: a public company cannot depart from the counting rule.
#ASSERT `האם החלטה באסיפה הכללית של החברה שלי מתקבלת בהצבעה במנין קולות` TRUE FALSE FALSE TRUE TRUE EQUALS TRUE
-- s 85: an ordinary majority.
#ASSERT `האם החלטת האסיפה הכללית בחברה שלי התקבלה ברוב הנדרש` 6 4 0 FALSE 0 EQUALS TRUE
-- s 85: a tie.
#ASSERT `האם החלטת האסיפה הכללית בחברה שלי התקבלה ברוב הנדרש` 5 5 0 FALSE 0 EQUALS FALSE
-- s 85: another majority of 75% fixed and 70% voted for.
#ASSERT `האם החלטת האסיפה הכללית בחברה שלי התקבלה ברוב הנדרש` 7 3 0 TRUE 0.75 EQUALS FALSE
-- s 85: 80% of those voting, abstainers excluded.
#ASSERT `האם החלטת האסיפה הכללית בחברה שלי התקבלה ברוב הנדרש` 80 20 50 TRUE 0.75 EQUALS TRUE
-- s 86: the chair's declaration that it was adopted is prima facie evidence.
#ASSERT `האם הכרזת היושב ראש היא ראיה לכאורה לכך שההחלטה נתקבלה` TRUE FALSE EQUALS TRUE
-- s 86: unless proved incorrect.
#ASSERT `האם הכרזת היושב ראש היא ראיה לכאורה לכך שההחלטה נתקבלה` TRUE TRUE EQUALS FALSE
-- s 86: no declaration.
#ASSERT `האם הכרזת היושב ראש היא ראיה לכאורה לכך שההחלטה נתקבלה` FALSE FALSE EQUALS FALSE

§§ `פרק 2 סימן ז׳: הצבעה בכתב והודעות עמדה`

-- s 87(a)(1): appointing and dismissing directors.
#ASSERT `האם אני כבעל מניה בחברה ציבורית רשאי להצביע בכתב הצבעה בענין זה` TRUE FALSE FALSE TRUE `מינויים ופיטורים של דירקטורים` EQUALS TRUE
-- s 87(a)(3): approving a merger.
#ASSERT `האם אני כבעל מניה בחברה ציבורית רשאי להצביע בכתב הצבעה בענין זה` TRUE FALSE FALSE TRUE `אישור מיזוג לענין סעיף 87(א)(3)` EQUALS TRUE
-- s 87(a): another matter.
#ASSERT `האם אני כבעל מניה בחברה ציבורית רשאי להצביע בכתב הצבעה בענין זה` TRUE FALSE FALSE TRUE `ענין אחר שאינו מנוי בסעיף 87(א)` EQUALS FALSE
-- s 87(a): this is a private company.
#ASSERT `האם אני כבעל מניה בחברה ציבורית רשאי להצביע בכתב הצבעה בענין זה` FALSE FALSE FALSE FALSE `מינויים ופיטורים של דירקטורים` EQUALS FALSE
-- s 87(b): a matter of section 87(a) is on the agenda.
#ASSERT `האם החברה חייבת לשלוח לי כתב הצבעה` TRUE EQUALS TRUE
-- s 87(b): none is.
#ASSERT `האם החברה חייבת לשלוח לי כתב הצבעה` FALSE EQUALS FALSE
-- s 87(c): the deed states how I vote and reached the company by the last date.
#ASSERT `האם כתב ההצבעה שלי נחשב כנוכחות באסיפה לענין המנין החוקי` TRUE TRUE EQUALS TRUE
-- s 87(c): it did not reach the company in time.
#ASSERT `האם כתב ההצבעה שלי נחשב כנוכחות באסיפה לענין המנין החוקי` TRUE FALSE EQUALS FALSE
-- s 87(d): a deed on a matter on which no vote was held counts as abstaining.
#ASSERT `האם כתב ההצבעה שלי בענין שלא התקיימה בו הצבעה נחשב כנמנע` TRUE TRUE EQUALS TRUE
-- s 87(d): a vote was held on the matter.
#ASSERT `האם כתב ההצבעה שלי בענין שלא התקיימה בו הצבעה נחשב כנמנע` TRUE FALSE EQUALS FALSE
-- s 87(d): counted in the adjourned meeting under section 74 or 79.
#ASSERT `האם כתב ההצבעה שלי נמנה באסיפה הנדחית` TRUE TRUE TRUE EQUALS TRUE
-- s 87(d): no adjourned meeting is being held.
#ASSERT `האם כתב ההצבעה שלי נמנה באסיפה הנדחית` TRUE TRUE FALSE EQUALS FALSE
-- s 87(e): a public company; a section 177(1) shareholder whose deed was passed in the electronic voting system.
#ASSERT `האם אני רשאי להצביע במערכת ההצבעה האלקטרונית גם בכל נושא אחר שעל סדר היום` TRUE FALSE FALSE TRUE TRUE TRUE EQUALS TRUE
-- s 87(e): the deed was not passed through the system.
#ASSERT `האם אני רשאי להצביע במערכת ההצבעה האלקטרונית גם בכל נושא אחר שעל סדר היום` TRUE FALSE FALSE TRUE TRUE FALSE EQUALS FALSE
-- s 88(a): the board, or one at whose demand a special meeting was convened, on a section 87 matter.
#ASSERT `האם אני רשאי לפנות לבעלי המניות בהודעת עמדה` TRUE TRUE EQUALS TRUE
-- s 88(a): not a section 87 matter.
#ASSERT `האם אני רשאי לפנות לבעלי המניות בהודעת עמדה` TRUE FALSE EQUALS FALSE
-- s 88(a): the company sends position notices at its own cost with the voting deed.
#ASSERT `האם החברה שולחת את הודעת העמדה שלי על חשבונה ביחד עם כתב ההצבעה` TRUE EQUALS TRUE
-- s 88(a): not such a notice.
#ASSERT `האם החברה שולחת את הודעת העמדה שלי על חשבונה ביחד עם כתב ההצבעה` FALSE EQUALS FALSE
-- s 88(b): a meeting convened with a section 87 matter on its agenda.
#ASSERT `האם אני כבעל מניה רשאי לבקש מהחברה לשלוח הודעת עמדה מטעמי` TRUE EQUALS TRUE
-- s 88(b): no such meeting.
#ASSERT `האם אני כבעל מניה רשאי לבקש מהחברה לשלוח הודעת עמדה מטעמי` FALSE EQUALS FALSE
-- s 88(b): the company determined that all such notices are at its cost.
#ASSERT `האם הודעת העמדה שלי נשלחת על חשבון החברה` TRUE FALSE EQUALS TRUE
-- s 88(b): or the Minister so fixed under section 89.
#ASSERT `האם הודעת העמדה שלי נשלחת על חשבון החברה` FALSE TRUE EQUALS TRUE
-- s 88(b): neither.
#ASSERT `האם הודעת העמדה שלי נשלחת על חשבון החברה` FALSE FALSE EQUALS FALSE
-- s 88(c): in response to a position notice.
#ASSERT `האם הדירקטוריון רשאי לשלוח הודעת עמדה בתגובה` TRUE FALSE EQUALS TRUE
-- s 88(c): or another approach to the shareholders.
#ASSERT `האם הדירקטוריון רשאי לשלוח הודעת עמדה בתגובה` FALSE TRUE EQUALS TRUE
-- s 88(c): neither occurred.
#ASSERT `האם הדירקטוריון רשאי לשלוח הודעת עמדה בתגובה` FALSE FALSE EQUALS FALSE
-- s 88(d): a section 177(1) shareholder holding through a bourse member.
#ASSERT `האם אני זכאי לקבל מחבר הבורסה כתב הצבעה והודעות עמדה` TRUE TRUE EQUALS TRUE
-- s 88(d): the shares are not held through a bourse member.
#ASSERT `האם אני זכאי לקבל מחבר הבורסה כתב הצבעה והודעות עמדה` TRUE FALSE EQUALS FALSE

§§ `פרק 2 סימנים ח׳ ו־ט׳: פרוטוקולים ופגמים בכינוס`

-- s 90(a): the company draws up minutes of the proceedings at general meetings.
#ASSERT `האם החברה חייבת לערוך פרוטוקולים של ההליכים באסיפה הכללית` EQUALS TRUE
-- s 90(a): the minutes are kept for seven years.
#ASSERT `האם החברה עדיין חייבת לשמור במשרדה הרשום את פרוטוקול האסיפה` 7 EQUALS TRUE
-- s 90(a): eight years have passed.
#ASSERT `האם החברה עדיין חייבת לשמור במשרדה הרשום את פרוטוקול האסיפה` 8 EQUALS FALSE
-- s 90(b): minutes signed by the chair are prima facie evidence of what they say.
#ASSERT `האם פרוטוקול חתום בידי יושב ראש האסיפה הוא ראיה לכאורה לאמור בו` TRUE FALSE EQUALS TRUE
-- s 90(b): unless proved untrue.
#ASSERT `האם פרוטוקול חתום בידי יושב ראש האסיפה הוא ראיה לכאורה לאמור בו` TRUE TRUE EQUALS FALSE
-- s 90(b): not signed by the chair.
#ASSERT `האם פרוטוקול חתום בידי יושב ראש האסיפה הוא ראיה לכאורה לאמור בו` FALSE FALSE EQUALS FALSE
-- s 90(c): a shareholder may inspect the register of minutes.
#ASSERT `האם אני כבעל מניות רשאי לעיין במרשם הפרוטוקולים של האסיפות הכלליות` TRUE EQUALS TRUE
-- s 90(c): not a shareholder.
#ASSERT `האם אני כבעל מניות רשאי לעיין במרשם הפרוטוקולים של האסיפות הכלליות` FALSE EQUALS FALSE
-- s 90(c): a shareholder who asked for a copy.
#ASSERT `האם על החברה לשלוח לי העתק מהמרשם כבעל מניה שביקש` TRUE TRUE EQUALS TRUE
-- s 90(c): he did not ask.
#ASSERT `האם על החברה לשלוח לי העתק מהמרשם כבעל מניה שביקש` TRUE FALSE EQUALS FALSE
-- s 91(a): a shareholder applies against a meeting held without the conditions the Law or articles set.
#ASSERT `האם בית המשפט רשאי להורות על ביטול החלטה שהתקבלה באסיפה פגומה לבקשתי` TRUE TRUE EQUALS TRUE
-- s 91(a): the meeting was properly convened and conducted.
#ASSERT `האם בית המשפט רשאי להורות על ביטול החלטה שהתקבלה באסיפה פגומה לבקשתי` TRUE FALSE EQUALS FALSE
-- s 91(a): the applicant is not a shareholder.
#ASSERT `האם בית המשפט רשאי להורות על ביטול החלטה שהתקבלה באסיפה פגומה לבקשתי` FALSE TRUE EQUALS FALSE
-- s 91(b): a defect in the notice of place or date does not entitle one who came to the meeting anyway.
#ASSERT `האם אני כבעל מניה רשאי לדרוש את ביטול ההחלטה מחמת הפגם בכינוס` TRUE TRUE EQUALS FALSE
-- s 91(b): I did not come to the meeting.
#ASSERT `האם אני כבעל מניה רשאי לדרוש את ביטול ההחלטה מחמת הפגם בכינוס` TRUE FALSE EQUALS TRUE
-- s 91(b): the defect is not one of the notice of place or date.
#ASSERT `האם אני כבעל מניה רשאי לדרוש את ביטול ההחלטה מחמת הפגם בכינוס` FALSE TRUE EQUALS TRUE

§§ `חלק 3 פרק 3: הדירקטוריון`

-- s 92(a)(7): appointing and dismissing the general manager is a board function.
#ASSERT `האם התפקיד או הסמכות הזאת היא של הדירקטוריון של החברה שלי` `מינוי המנהל הכללי ופיטוריו` EQUALS TRUE
-- s 92(a): a function not listed.
#ASSERT `האם התפקיד או הסמכות הזאת היא של הדירקטוריון של החברה שלי` `תפקיד אחר שאינו מנוי בסעיף 92(א)` EQUALS FALSE
-- s 92(a)(12): in a public company.
#ASSERT `האם על הדירקטוריון של החברה שלי לקבוע מספר מזערי של דירקטורים בעלי מומחיות חשבונאית ופיננסית` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS TRUE
-- s 92(a)(12): in a private company that is a bond company.
#ASSERT `האם על הדירקטוריון של החברה שלי לקבוע מספר מזערי של דירקטורים בעלי מומחיות חשבונאית ופיננסית` FALSE FALSE FALSE FALSE TRUE FALSE FALSE TRUE EQUALS TRUE
-- s 92(a)(12): a private company that is not a bond company.
#ASSERT `האם על הדירקטוריון של החברה שלי לקבוע מספר מזערי של דירקטורים בעלי מומחיות חשבונאית ופיננסית` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS FALSE
-- s 92(a)(12): a minimum of two experts among the seven directors in the articles.
#ASSERT `האם המספר המזערי של הדירקטורים המומחים שקבע הדירקטוריון שלי עומד במספר הדירקטורים שבתקנון` 2 7 EQUALS TRUE
-- s 92(a)(12): eight experts cannot be among seven directors.
#ASSERT `האם המספר המזערי של הדירקטורים המומחים שקבע הדירקטוריון שלי עומד במספר הדירקטורים שבתקנון` 8 7 EQUALS FALSE
-- s 92(b): a section 92 power is delegated only as section 288(b)(2) describes.
#ASSERT `האם הדירקטוריון רשאי לאצול את הסמכות הזאת למנהל הכללי` TRUE FALSE EQUALS FALSE
-- s 92(b): delegation as section 288(b)(2) describes.
#ASSERT `האם הדירקטוריון רשאי לאצול את הסמכות הזאת למנהל הכללי` TRUE TRUE EQUALS TRUE
-- s 93(a): a private company that is not a bond company.
#ASSERT `האם בחברה שלי יכול שיהיה דירקטוריון המונה אדם אחד` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS TRUE
-- s 93(a): a bond company.
#ASSERT `האם בחברה שלי יכול שיהיה דירקטוריון המונה אדם אחד` FALSE FALSE FALSE FALSE TRUE FALSE FALSE TRUE EQUALS FALSE
-- s 93(a): a public company.
#ASSERT `האם בחברה שלי יכול שיהיה דירקטוריון המונה אדם אחד` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS FALSE
-- s 93(b): the sub-chapter on the board's powers applies to a board of one person.
#ASSERT `האם ההוראות האלה חלות על דירקטוריון המונה אדם אחד` `סימן א׳ – סמכויות הדירקטוריון` EQUALS TRUE
-- s 93(b): and the sub-chapter on minutes.
#ASSERT `האם ההוראות האלה חלות על דירקטוריון המונה אדם אחד` `סימן ו׳ – פרוטוקולים בישיבות הדירקטוריון` EQUALS TRUE
-- s 93(b): the rest of the chapter does not.
#ASSERT `האם ההוראות האלה חלות על דירקטוריון המונה אדם אחד` `יתר הוראות הפרק` EQUALS FALSE

§§ `פרק 3 סימן ב׳: יושב ראש הדירקטוריון`

-- s 94(a): a public company's board chooses a chair.
#ASSERT `האם הדירקטוריון חייב לבחור אחד מחבריו לכהן כיושב ראש` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS TRUE
-- s 94(a): so does a private bond company's.
#ASSERT `האם הדירקטוריון חייב לבחור אחד מחבריו לכהן כיושב ראש` FALSE FALSE FALSE FALSE TRUE FALSE FALSE TRUE FALSE EQUALS TRUE
-- s 94(a): a private company that is not a bond company has no such duty.
#ASSERT `האם הדירקטוריון חייב לבחור אחד מחבריו לכהן כיושב ראש` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS FALSE
-- s 94(a): the articles fix another manner of appointment.
#ASSERT `האם הדירקטוריון חייב לבחור אחד מחבריו לכהן כיושב ראש` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE TRUE EQUALS FALSE
-- s 94(b): a private company that is not a bond company has no duty to appoint a chair.
#ASSERT `האם אין חובה למנות יושב ראש דירקטוריון בחברה שלי` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS TRUE
-- s 94(b): a public company has.
#ASSERT `האם אין חובה למנות יושב ראש דירקטוריון בחברה שלי` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS FALSE
-- s 94(b): with no chair appointed in a private non-bond company, each director may convene and set the agenda.
#ASSERT `האם אני כדירקטור זכאי לכנס את הדירקטוריון ולקבוע את סדר יומו` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS TRUE
-- s 94(b): a chair has been appointed.
#ASSERT `האם אני כדירקטור זכאי לכנס את הדירקטוריון ולקבוע את סדר יומו` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS FALSE
-- s 94(b): the articles provide otherwise.
#ASSERT `האם אני כדירקטור זכאי לכנס את הדירקטוריון ולקבוע את סדר יומו` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS FALSE
-- s 94(b): this is a public company.
#ASSERT `האם אני כדירקטור זכאי לכנס את הדירקטוריון ולקבוע את סדר יומו` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS FALSE
-- s 95(a): in a private company that is not a bond company the bars do not apply.
#ASSERT `האם אני רשאי לכהן כיושב ראש הדירקטוריון של החברה` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE 0 EQUALS TRUE
-- s 95(a): the general manager or his relative may not serve as chair of a public company, absent section 121.
#ASSERT `האם אני רשאי לכהן כיושב ראש הדירקטוריון של החברה` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE 4 EQUALS FALSE
-- s 95(a): unless the service is permitted under section 121.
#ASSERT `האם אני רשאי לכהן כיושב ראש הדירקטוריון של החברה` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE TRUE TRUE FALSE FALSE 4 EQUALS TRUE
-- s 95(a): one subordinate to the general manager may not serve.
#ASSERT `האם אני רשאי לכהן כיושב ראש הדירקטוריון של החברה` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE 4 EQUALS FALSE
-- s 95(a): unless the subordination arises only from serving as a director in a corporation the company controls.
#ASSERT `האם אני רשאי לכהן כיושב ראש הדירקטוריון של החברה` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE 4 EQUALS TRUE
-- s 95(a): within three months of becoming a public company.
#ASSERT `האם אני רשאי לכהן כיושב ראש הדירקטוריון של החברה` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE 3 EQUALS TRUE
-- s 95(a): four months is past the three-month period.
#ASSERT `האם אני רשאי לכהן כיושב ראש הדירקטוריון של החברה` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE 4 EQUALS FALSE
-- s 95(b): in a public company the general manager's powers may not be conferred on the chair or his relative, absent section 121.
#ASSERT `האם אפשר להקנות לי כיושב ראש או לקרובי סמכויות של המנהל הכללי` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS FALSE
-- s 95(b): unless section 121 permits.
#ASSERT `האם אפשר להקנות לי כיושב ראש או לקרובי סמכויות של המנהל הכללי` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS TRUE
-- s 95(b): a private company that is not a bond company is not so restricted.
#ASSERT `האם אפשר להקנות לי כיושב ראש או לקרובי סמכויות של המנהל הכללי` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS TRUE
-- s 95(b): in a public company the powers of one subordinate to the general manager may not be conferred on the chair.
#ASSERT `האם אפשר להקנות לי כיושב ראש סמכויות הנתונות למי שכפוף למנהל הכללי` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE TRUE EQUALS FALSE
-- s 95(b): a private non-bond company.
#ASSERT `האם אפשר להקנות לי כיושב ראש סמכויות הנתונות למי שכפוף למנהל הכללי` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS TRUE
-- s 95(b): a chair of a public company may not hold another role in the company or a corporation it controls.
#ASSERT `האם אני כיושב ראש הדירקטוריון רשאי לכהן בתפקיד אחר` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS FALSE
-- s 95(b): except as chair or director in a corporation it controls.
#ASSERT `האם אני כיושב ראש הדירקטוריון רשאי לכהן בתפקיד אחר` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS TRUE
-- s 95(b): a role outside the company and its controlled corporations.
#ASSERT `האם אני כיושב ראש הדירקטוריון רשאי לכהן בתפקיד אחר` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS TRUE
-- s 95(b): a private company that is not a bond company.
#ASSERT `האם אני כיושב ראש הדירקטוריון רשאי לכהן בתפקיד אחר` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS TRUE
-- s 96(a): the chair runs the meeting when present.
#ASSERT `האם יושב ראש הדירקטוריון הוא שמנהל את הישיבה` TRUE EQUALS TRUE
-- s 96(a): he is absent.
#ASSERT `האם יושב ראש הדירקטוריון הוא שמנהל את הישיבה` FALSE EQUALS FALSE
-- s 96(b): the chair is absent.
#ASSERT `האם הדירקטוריון חייב לבחור באחד מחבריו לנהל את הישיבה ולחתום על הפרוטוקול` TRUE EQUALS TRUE
-- s 96(b): he is present.
#ASSERT `האם הדירקטוריון חייב לבחור באחד מחבריו לנהל את הישיבה ולחתום על הפרוטוקול` FALSE EQUALS FALSE
-- s 96(b): chosen to run the meeting in the chair's absence, and the articles give him an additional vote.
#ASSERT `האם לי כדירקטור שנבחר לנהל את הישיבה יש קול נוסף בהצבעות הדירקטוריון` TRUE TRUE EQUALS TRUE
-- s 96(b): the articles do not.
#ASSERT `האם לי כדירקטור שנבחר לנהל את הישיבה יש קול נוסף בהצבעות הדירקטוריון` TRUE FALSE EQUALS FALSE
-- s 96(b): not chosen to run the meeting.
#ASSERT `האם לי כדירקטור שנבחר לנהל את הישיבה יש קול נוסף בהצבעות הדירקטוריון` FALSE TRUE EQUALS FALSE

§§ `פרק 3 סימן ג׳: כינוס ישיבות הדירקטוריון`

-- s 97: a public company's board meets at least once every three months.
#ASSERT `האם הדירקטוריון של החברה שלי התכנס בתדירות הנדרשת` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE 3 EQUALS TRUE
-- s 97: four months is too long.
#ASSERT `האם הדירקטוריון של החברה שלי התכנס בתדירות הנדרשת` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE 4 EQUALS FALSE
-- s 97: a private company's board meets at least once a year.
#ASSERT `האם הדירקטוריון של החברה שלי התכנס בתדירות הנדרשת` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 12 EQUALS TRUE
-- s 97: thirteen months.
#ASSERT `האם הדירקטוריון של החברה שלי התכנס בתדירות הנדרשת` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 13 EQUALS FALSE
-- s 97: a private non-bond company need not meet every three months.
#ASSERT `האם הדירקטוריון של החברה שלי התכנס בתדירות הנדרשת` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 4 EQUALS TRUE
-- s 97: a bond company's board meets every three months.
#ASSERT `האם הדירקטוריון של החברה שלי התכנס בתדירות הנדרשת` FALSE FALSE FALSE FALSE TRUE FALSE FALSE TRUE 4 EQUALS FALSE
-- s 98(a): the chair may convene the board at any time.
#ASSERT `האם יושב ראש הדירקטוריון רשאי לכנס את הדירקטוריון בכל עת` EQUALS TRUE
-- s 98(b): two directors demand a meeting.
#ASSERT `האם הדירקטוריון חייב לקיים ישיבה לדרישת הדירקטורים שדרשו` 2 9 FALSE FALSE EQUALS TRUE
-- s 98(b): one director of nine, with no articles provision or section 257.
#ASSERT `האם הדירקטוריון חייב לקיים ישיבה לדרישת הדירקטורים שדרשו` 1 9 FALSE FALSE EQUALS FALSE
-- s 98(b): one director may demand in a board of five or fewer.
#ASSERT `האם הדירקטוריון חייב לקיים ישיבה לדרישת הדירקטורים שדרשו` 1 5 FALSE FALSE EQUALS TRUE
-- s 98(b): a board of six.
#ASSERT `האם הדירקטוריון חייב לקיים ישיבה לדרישת הדירקטורים שדרשו` 1 6 FALSE FALSE EQUALS FALSE
-- s 98(b): the articles allow one director to demand.
#ASSERT `האם הדירקטוריון חייב לקיים ישיבה לדרישת הדירקטורים שדרשו` 1 9 TRUE FALSE EQUALS TRUE
-- s 98(b): what section 257 provides is met.
#ASSERT `האם הדירקטוריון חייב לקיים ישיבה לדרישת הדירקטורים שדרשו` 1 9 FALSE TRUE EQUALS TRUE
-- s 98(c): a convening is required under subsection (b).
#ASSERT `האם יושב ראש הדירקטוריון חייב לכנס את הדירקטוריון` TRUE FALSE FALSE EQUALS TRUE
-- s 98(c): a notice or report of the general manager under section 122(d).
#ASSERT `האם יושב ראש הדירקטוריון חייב לכנס את הדירקטוריון` FALSE TRUE FALSE EQUALS TRUE
-- s 98(c): the external auditor's notice under section 169.
#ASSERT `האם יושב ראש הדירקטוריון חייב לכנס את הדירקטוריון` FALSE FALSE TRUE EQUALS TRUE
-- s 98(c): none of these.
#ASSERT `האם יושב ראש הדירקטוריון חייב לכנס את הדירקטוריון` FALSE FALSE FALSE EQUALS FALSE
-- s 98(d): a person named in (b) or (c) may convene himself once more than the default fourteen days have passed with no meeting.
#ASSERT `האם אני רשאי לכנס בעצמי ישיבת דירקטוריון שלא כונסה בזמן` TRUE FALSE 0 15 EQUALS TRUE
-- s 98(d): fourteen days have not yet been exceeded.
#ASSERT `האם אני רשאי לכנס בעצמי ישיבת דירקטוריון שלא כונסה בזמן` TRUE FALSE 0 14 EQUALS FALSE
-- s 98(d): the articles fix thirty days and only twenty have passed.
#ASSERT `האם אני רשאי לכנס בעצמי ישיבת דירקטוריון שלא כונסה בזמן` TRUE TRUE 30 20 EQUALS FALSE
-- s 98(d): thirty-one days exceed the thirty the articles fix.
#ASSERT `האם אני רשאי לכנס בעצמי ישיבת דירקטוריון שלא כונסה בזמן` TRUE TRUE 30 31 EQUALS TRUE
-- s 98(d): not one of the persons named.
#ASSERT `האם אני רשאי לכנס בעצמי ישיבת דירקטוריון שלא כונסה בזמן` FALSE FALSE 0 40 EQUALS FALSE

§§ `פרק 3 סימן ד׳: ישיבות הדירקטוריון ודרך ניהולן`

-- s 99: set by the chair.
#ASSERT `האם הנושא יכלל בסדר היום של ישיבת הדירקטוריון` TRUE FALSE FALSE FALSE EQUALS TRUE
-- s 99: set as section 98 provides.
#ASSERT `האם הנושא יכלל בסדר היום של ישיבת הדירקטוריון` FALSE TRUE FALSE FALSE EQUALS TRUE
-- s 99: a director or the general manager asked a reasonable time before.
#ASSERT `האם הנושא יכלל בסדר היום של ישיבת הדירקטוריון` FALSE FALSE TRUE FALSE EQUALS TRUE
-- s 99: the articles provide otherwise.
#ASSERT `האם הנושא יכלל בסדר היום של ישיבת הדירקטוריון` FALSE FALSE TRUE TRUE EQUALS FALSE
-- s 99: none of these.
#ASSERT `האם הנושא יכלל בסדר היום של ישיבת הדירקטוריון` FALSE FALSE FALSE FALSE EQUALS FALSE
-- s 100(a): delivered to all the members a reasonable time before the meeting.
#ASSERT `האם ההודעה על ישיבת הדירקטוריון נמסרה לי במועד` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE FALSE FALSE EQUALS TRUE
-- s 100(a): in a private non-bond company the articles may fix the time, and it was met.
#ASSERT `האם ההודעה על ישיבת הדירקטוריון נמסרה לי במועד` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE TRUE TRUE EQUALS TRUE
-- s 100(a): in a public company the articles cannot replace the reasonable-time rule.
#ASSERT `האם ההודעה על ישיבת הדירקטוריון נמסרה לי במועד` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE TRUE FALSE TRUE TRUE EQUALS FALSE
-- s 100(a): not delivered to all the members.
#ASSERT `האם ההודעה על ישיבת הדירקטוריון נמסרה לי במועד` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS FALSE
-- s 100(b): delivered to the director's address, with date, place and the agenda matters detailed.
#ASSERT `האם תוכן ההודעה על ישיבת הדירקטוריון ומענה תקינים` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE TRUE FALSE FALSE EQUALS TRUE
-- s 100(b): the agenda matters are not detailed.
#ASSERT `האם תוכן ההודעה על ישיבת הדירקטוריון ומענה תקינים` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE FALSE FALSE FALSE EQUALS FALSE
-- s 100(b),(c): a private non-bond company's articles may replace the detail rules, and the other provision was followed.
#ASSERT `האם תוכן ההודעה על ישיבת הדירקטוריון ומענה תקינים` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS TRUE
-- s 100(b): a public company cannot rely on the articles, and the content was not given.
#ASSERT `האם תוכן ההודעה על ישיבת הדירקטוריון ומענה תקינים` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS FALSE
-- s 100(c): a private company that is not a bond company may.
#ASSERT `האם החברה שלי רשאית להתנות בתקנון על חובת הפירוט וחובת מסירת ההודעה במועד` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS TRUE
-- s 100(c): a public company may not.
#ASSERT `האם החברה שלי רשאית להתנות בתקנון על חובת הפירוט וחובת מסירת ההודעה במועד` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS FALSE
-- s 100(c): a bond company may not.
#ASSERT `האם החברה שלי רשאית להתנות בתקנון על חובת הפירוט וחובת מסירת ההודעה במועד` FALSE FALSE FALSE FALSE TRUE FALSE FALSE TRUE EQUALS FALSE
-- s 101: all the participating directors can hear one another at the same time.
#ASSERT `האם הדירקטוריון רשאי לקיים ישיבה באמצעי תקשורת` FALSE TRUE EQUALS TRUE
-- s 101: the articles exclude this.
#ASSERT `האם הדירקטוריון רשאי לקיים ישיבה באמצעי תקשורת` TRUE TRUE EQUALS FALSE
-- s 101: they cannot hear one another at the same time.
#ASSERT `האם הדירקטוריון רשאי לקיים ישיבה באמצעי תקשורת` FALSE FALSE EQUALS FALSE
-- s 102: a private non-bond company's directors all agreed to meet without notice.
#ASSERT `האם הדירקטוריון רשאי להתכנס בלא הודעה בהסכמת כל הדירקטורים` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS TRUE
-- s 102: not available to a public company.
#ASSERT `האם הדירקטוריון רשאי להתכנס בלא הודעה בהסכמת כל הדירקטורים` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS FALSE
-- s 102: the articles exclude it.
#ASSERT `האם הדירקטוריון רשאי להתכנס בלא הודעה בהסכמת כל הדירקטורים` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS FALSE
-- s 102: not available to a bond company.
#ASSERT `האם הדירקטוריון רשאי להתכנס בלא הודעה בהסכמת כל הדירקטורים` FALSE FALSE FALSE FALSE TRUE FALSE FALSE TRUE TRUE FALSE EQUALS FALSE
-- s 102: an urgent case and a majority of the directors agreed.
#ASSERT `האם הדירקטוריון רשאי להתכנס בלא הודעה במקרה דחוף בהסכמת רוב הדירקטורים` TRUE TRUE EQUALS TRUE
-- s 102: the case is not urgent.
#ASSERT `האם הדירקטוריון רשאי להתכנס בלא הודעה במקרה דחוף בהסכמת רוב הדירקטורים` FALSE TRUE EQUALS FALSE
-- s 102: no majority agreed.
#ASSERT `האם הדירקטוריון רשאי להתכנס בלא הודעה במקרה דחוף בהסכמת רוב הדירקטורים` TRUE FALSE EQUALS FALSE
-- s 103(a): all the directors entitled to take part agreed not to meet.
#ASSERT `האם הדירקטוריון רשאי לקבל החלטות ללא התכנסות בפועל` TRUE FALSE EQUALS TRUE
-- s 103(a): the articles exclude it.
#ASSERT `האם הדירקטוריון רשאי לקבל החלטות ללא התכנסות בפועל` TRUE TRUE EQUALS FALSE
-- s 103(a): not all agreed.
#ASSERT `האם הדירקטוריון רשאי לקבל החלטות ללא התכנסות בפועל` FALSE FALSE EQUALS FALSE
-- s 103(b): minutes of the resolutions will be drawn up and signed by the chair.
#ASSERT `האם ייערך פרוטוקול של ההחלטות שהתקבלו ללא התכנסות וייחתם בידי יושב הראש` TRUE EQUALS TRUE
-- s 103(b): no such resolutions were adopted.
#ASSERT `האם ייערך פרוטוקול של ההחלטות שהתקבלו ללא התכנסות וייחתם בידי יושב הראש` FALSE EQUALS FALSE
-- s 103(c): section 108 applies to a resolution adopted without meeting.
#ASSERT `האם על החלטה ללא התכנסות חלות הוראות סעיף 108` TRUE EQUALS TRUE
-- s 103(c): it was not so adopted.
#ASSERT `האם על החלטה ללא התכנסות חלות הוראות סעיף 108` FALSE EQUALS FALSE
-- s 103(d): the chair is responsible for carrying out section 103.
#ASSERT `האם יושב ראש הדירקטוריון אחראי לביצוע הוראות סעיף 103` TRUE EQUALS TRUE
-- s 103(d): no such resolutions.
#ASSERT `האם יושב ראש הדירקטוריון אחראי לביצוע הוראות סעיף 103` FALSE EQUALS FALSE
-- s 104: three of five is a majority of the members in office.
#ASSERT `האם נכח מנין חוקי לפתיחת ישיבת הדירקטוריון` 3 5 FALSE 0 EQUALS TRUE
-- s 104: two of four is not a majority.
#ASSERT `האם נכח מנין חוקי לפתיחת ישיבת הדירקטוריון` 2 4 FALSE 0 EQUALS FALSE
-- s 104: three of four.
#ASSERT `האם נכח מנין חוקי לפתיחת ישיבת הדירקטוריון` 3 4 FALSE 0 EQUALS TRUE
-- s 104: the articles fix a quorum of four.
#ASSERT `האם נכח מנין חוקי לפתיחת ישיבת הדירקטוריון` 3 5 TRUE 4 EQUALS FALSE
-- s 104: four meet the articles' quorum.
#ASSERT `האם נכח מנין חוקי לפתיחת ישיבת הדירקטוריון` 4 5 TRUE 4 EQUALS TRUE

§§ `פרק 3 סימן ה׳: הצבעה בדירקטוריון`

-- s 105: the articles fix three votes for a director.
#ASSERT `כמה קולות יש לי כדירקטור בהצבעה בדירקטוריון` TRUE 3 EQUALS 3
-- s 105: the articles do not provide otherwise, so one vote.
#ASSERT `כמה קולות יש לי כדירקטור בהצבעה בדירקטוריון` FALSE 3 EQUALS 1
-- s 106(a): a director who did not use independent judgment in the vote.
#ASSERT `האם אני כדירקטור הפרתי חובת אמונים בהצבעה בדירקטוריון` TRUE FALSE EQUALS TRUE
-- s 106(a): a director who was a party to a voting agreement.
#ASSERT `האם אני כדירקטור הפרתי חובת אמונים בהצבעה בדירקטוריון` FALSE TRUE EQUALS TRUE
-- s 106(a): neither.
#ASSERT `האם אני כדירקטור הפרתי חובת אמונים בהצבעה בדירקטוריון` FALSE FALSE EQUALS FALSE
-- s 106(b): filled a director's role without lawful appointment.
#ASSERT `האם הפרתי את איסור מילוי תפקיד דירקטור שלא כדין או פגיעה בשיקול דעת עצמאי` TRUE FALSE FALSE EQUALS TRUE
-- s 106(b): lawfully appointed.
#ASSERT `האם הפרתי את איסור מילוי תפקיד דירקטור שלא כדין או פגיעה בשיקול דעת עצמאי` TRUE TRUE FALSE EQUALS FALSE
-- s 106(b): impaired a director's independent judgment.
#ASSERT `האם הפרתי את איסור מילוי תפקיד דירקטור שלא כדין או פגיעה בשיקול דעת עצמאי` FALSE FALSE TRUE EQUALS TRUE
-- s 106(c): a breacher bears the duties and liability of directors.
#ASSERT `האם עליי כמפר חלים החובות והאחריות החלות על דירקטורים` TRUE EQUALS TRUE
-- s 106(c): no breach.
#ASSERT `האם עליי כמפר חלים החובות והאחריות החלות על דירקטורים` FALSE EQUALS FALSE
-- s 107: an ordinary majority.
#ASSERT `האם החלטת הדירקטוריון של החברה שלי התקבלה` 6 4 0 FALSE FALSE FALSE EQUALS TRUE
-- s 107: a tie with no additional vote.
#ASSERT `האם החלטת הדירקטוריון של החברה שלי התקבלה` 5 5 0 FALSE FALSE FALSE EQUALS FALSE
-- s 107: a tie, with the chair present and his additional vote cast for.
#ASSERT `האם החלטת הדירקטוריון של החברה שלי התקבלה` 5 5 0 TRUE FALSE FALSE EQUALS TRUE
-- s 107: 6 for and 5 against is an ordinary majority; the 100 abstentions are not counted.
#ASSERT `האם החלטת הדירקטוריון של החברה שלי התקבלה` 6 5 100 FALSE FALSE FALSE EQUALS TRUE
-- s 107: fewer for than against; the 100 abstentions do not help.
#ASSERT `האם החלטת הדירקטוריון של החברה שלי התקבלה` 4 5 100 FALSE FALSE FALSE EQUALS FALSE
-- s 107: the articles fix another deciding rule and the resolution passed under it.
#ASSERT `האם החלטת הדירקטוריון של החברה שלי התקבלה` 1 9 0 FALSE TRUE TRUE EQUALS TRUE
-- s 107: the articles fix another deciding rule and the resolution did not pass under it.
#ASSERT `האם החלטת הדירקטוריון של החברה שלי התקבלה` 9 1 0 FALSE TRUE FALSE EQUALS FALSE

§§ `פרק 3 סימן ו׳: פרוטוקולים של ישיבות הדירקטוריון`

-- s 108(a): kept at the registered office.
#ASSERT `האם הפרוטוקולים של הדירקטוריון נשמרים במקום הנדרש` TRUE FALSE FALSE EQUALS TRUE
-- s 108(a): kept at another address in Israel the Registrar was told of.
#ASSERT `האם הפרוטוקולים של הדירקטוריון נשמרים במקום הנדרש` FALSE TRUE TRUE EQUALS TRUE
-- s 108(a): the Registrar was not told.
#ASSERT `האם הפרוטוקולים של הדירקטוריון נשמרים במקום הנדרש` FALSE TRUE FALSE EQUALS FALSE
-- s 108(a): kept nowhere that qualifies.
#ASSERT `האם הפרוטוקולים של הדירקטוריון נשמרים במקום הנדרש` FALSE FALSE FALSE EQUALS FALSE
-- s 108(a): the company draws up minutes of the proceedings at board meetings.
#ASSERT `האם החברה חייבת לערוך פרוטוקולים של הליכי ישיבות הדירקטוריון` EQUALS TRUE
-- s 108(a): kept for seven years.
#ASSERT `האם החברה עדיין חייבת לשמור את פרוטוקולי הדירקטוריון` 7 EQUALS TRUE
-- s 108(a): eight years have passed.
#ASSERT `האם החברה עדיין חייבת לשמור את פרוטוקולי הדירקטוריון` 8 EQUALS FALSE
-- s 108(b): approved and signed by the director who ran the meeting.
#ASSERT `האם פרוטוקול שאושר ונחתם הוא ראיה לכאורה לאמור בו` TRUE TRUE FALSE EQUALS TRUE
-- s 108(b): unless proved untrue.
#ASSERT `האם פרוטוקול שאושר ונחתם הוא ראיה לכאורה לאמור בו` TRUE TRUE TRUE EQUALS FALSE
-- s 108(b): not approved.
#ASSERT `האם פרוטוקול שאושר ונחתם הוא ראיה לכאורה לאמור בו` FALSE TRUE FALSE EQUALS FALSE

§§ `פרק 3 סימן ז׳: פגמים בכינוס ישיבת הדירקטוריון`

-- s 109(a)(1): a defect, I was present and demanded that the resolution not be adopted.
#ASSERT `האם אני כדירקטור שנכח בישיבה רשאי לדרוש ביטול ההחלטה` TRUE TRUE TRUE EQUALS TRUE
-- s 109(a)(1): I did not make that demand before the resolution.
#ASSERT `האם אני כדירקטור שנכח בישיבה רשאי לדרוש ביטול ההחלטה` TRUE TRUE FALSE EQUALS FALSE
-- s 109(a)(1): no defect in convening.
#ASSERT `האם אני כדירקטור שנכח בישיבה רשאי לדרוש ביטול ההחלטה` FALSE TRUE TRUE EQUALS FALSE
-- s 109(a)(2): a defect; I was entitled to be invited, did not attend, and demanded within a reasonable time.
#ASSERT `האם אני כדירקטור שהיה זכאי להיות מוזמן ולא נכחתי רשאי לדרוש ביטול ההחלטה` TRUE TRUE TRUE TRUE FALSE EQUALS TRUE
-- s 109(a)(2): the first board meeting after I learned of the resolution has already been held.
#ASSERT `האם אני כדירקטור שהיה זכאי להיות מוזמן ולא נכחתי רשאי לדרוש ביטול ההחלטה` TRUE TRUE TRUE TRUE TRUE EQUALS FALSE
-- s 109(a)(2): I was present at the meeting.
#ASSERT `האם אני כדירקטור שהיה זכאי להיות מוזמן ולא נכחתי רשאי לדרוש ביטול ההחלטה` TRUE TRUE FALSE TRUE FALSE EQUALS FALSE
-- s 109(a)(3): a defect in the notice of place or date does not entitle one who came anyway.
#ASSERT `האם אני כדירקטור רשאי לדרוש את ביטול ההחלטות מחמת הפגם בהודעה` TRUE TRUE EQUALS FALSE
-- s 109(a)(3): I did not come.
#ASSERT `האם אני כדירקטור רשאי לדרוש את ביטול ההחלטות מחמת הפגם בהודעה` TRUE FALSE EQUALS TRUE
-- s 109(a)(3): the defect is not one of the notice of place or date.
#ASSERT `האם אני כדירקטור רשאי לדרוש את ביטול ההחלטות מחמת הפגם בהודעה` FALSE TRUE EQUALS TRUE
-- s 109(b): an act done for the company, with what the end of section 56(a) provides, stays valid.
#ASSERT `האם תוקפה של פעולה שנעשתה עבורי מול החברה לא נפגע בשל הביטול` TRUE TRUE EQUALS TRUE
-- s 109(b): the end of section 56(a) does not hold for the act.
#ASSERT `האם תוקפה של פעולה שנעשתה עבורי מול החברה לא נפגע בשל הביטול` TRUE FALSE EQUALS FALSE

§§ `פרק 3 סימן ח׳: ועדות הדירקטוריון`

-- s 110(a): the board may set up committees unless the articles provide otherwise.
#ASSERT `האם הדירקטוריון של החברה שלי רשאי להקים ועדות דירקטוריון` FALSE EQUALS TRUE
-- s 110(a): the articles provide otherwise.
#ASSERT `האם הדירקטוריון של החברה שלי רשאי להקים ועדות דירקטוריון` TRUE EQUALS FALSE
-- s 110(b): a board member may serve on a committee with delegated powers.
#ASSERT `האם אני רשאי לכהן בוועדה שהואצלו לה סמכויות הדירקטוריון` TRUE EQUALS TRUE
-- s 110(b): one who is not a board member may not.
#ASSERT `האם אני רשאי לכהן בוועדה שהואצלו לה סמכויות הדירקטוריון` FALSE EQUALS FALSE
-- s 110(c): a board member may.
#ASSERT `האם אני רשאי לכהן בוועדה שתפקידה לייעץ או להמליץ בלבד` TRUE TRUE EQUALS TRUE
-- s 110(c): one who is not a board member may serve on an advisory committee unless the articles provide otherwise.
#ASSERT `האם אני רשאי לכהן בוועדה שתפקידה לייעץ או להמליץ בלבד` FALSE FALSE EQUALS TRUE
-- s 110(c): not a board member and the articles provide otherwise.
#ASSERT `האם אני רשאי לכהן בוועדה שתפקידה לייעץ או להמליץ בלבד` FALSE TRUE EQUALS FALSE
-- s 111(a): a decision under a power delegated from the board.
#ASSERT `האם החלטה או פעולה של ועדה כמוה כהחלטה או פעולה של הדירקטוריון` TRUE FALSE EQUALS TRUE
-- s 111(a): the articles provide otherwise.
#ASSERT `האם החלטה או פעולה של ועדה כמוה כהחלטה או פעולה של הדירקטוריון` TRUE TRUE EQUALS FALSE
-- s 111(a): not under a delegated power.
#ASSERT `האם החלטה או פעולה של ועדה כמוה כהחלטה או פעולה של הדירקטוריון` FALSE FALSE EQUALS FALSE
-- s 111(b): a board committee reports to the board on a continuing basis.
#ASSERT `האם ועדת הדירקטוריון חייבת לדווח לדירקטוריון באורח שוטף` EQUALS TRUE
-- s 111(b): needs the board's approval and was not brought to the directors in time.
#ASSERT `האם החלטות והמלצות הוועדה הובאו לידיעתי כדירקטור זמן סביר לפני הדיון` TRUE FALSE EQUALS FALSE
-- s 111(b): brought to the directors a reasonable time before the discussion.
#ASSERT `האם החלטות והמלצות הוועדה הובאו לידיעתי כדירקטור זמן סביר לפני הדיון` TRUE TRUE EQUALS TRUE
-- s 111(b): needs no approval, so no such duty is unmet.
#ASSERT `האם החלטות והמלצות הוועדה הובאו לידיעתי כדירקטור זמן סביר לפני הדיון` FALSE FALSE EQUALS TRUE
-- s 111(c): sub-chapters B to G apply to a committee meeting.
#ASSERT `האם על כינוס ישיבות ועדת הדירקטוריון ואופן ניהולן חלים סימנים ב׳ עד ז׳` TRUE EQUALS TRUE
-- s 111(c): not a committee meeting.
#ASSERT `האם על כינוס ישיבות ועדת הדירקטוריון ואופן ניהולן חלים סימנים ב׳ עד ז׳` FALSE EQUALS FALSE
-- s 111(d): a committee's minutes are drawn up and kept as section 108 provides.
#ASSERT `האם פרוטוקולים של ועדת הדירקטוריון ייערכו וייישמרו כאמור בסעיף 108` TRUE EQUALS TRUE
-- s 111(d): not a committee's minutes.
#ASSERT `האם פרוטוקולים של ועדת הדירקטוריון ייערכו וייישמרו כאמור בסעיף 108` FALSE EQUALS FALSE
-- s 112(a)(1): setting the company's general policy may not be delegated.
#ASSERT `האם הדירקטוריון רשאי להאציל לועדה את הסמכות בנושא זה` `קביעת מדיניות כללית לחברה` FALSE FALSE EQUALS FALSE
-- s 112(a)(2): a purchase of the company's shares within a framework the board set in advance may be delegated.
#ASSERT `האם הדירקטוריון רשאי להאציל לועדה את הסמכות בנושא זה` `חלוקה לענין סעיף 112(א)(2)` TRUE FALSE EQUALS TRUE
-- s 112(a)(2): any other distribution may not.
#ASSERT `האם הדירקטוריון רשאי להאציל לועדה את הסמכות בנושא זה` `חלוקה לענין סעיף 112(א)(2)` FALSE FALSE EQUALS FALSE
-- s 112(a)(5): an issue or allotment as section 288(b) describes.
#ASSERT `האם הדירקטוריון רשאי להאציל לועדה את הסמכות בנושא זה` `הנפקה או הקצאה של מניות, ניירות ערך המירים או סדרת איגרות חוב` FALSE TRUE EQUALS TRUE
-- s 112(a)(6): approving financial statements may not be delegated.
#ASSERT `האם הדירקטוריון רשאי להאציל לועדה את הסמכות בנושא זה` `אישור דוחות כספיים` FALSE FALSE EQUALS FALSE
-- s 112(a): a matter not listed may be delegated.
#ASSERT `האם הדירקטוריון רשאי להאציל לועדה את הסמכות בנושא זה` `נושא אחר שאינו מנוי בסעיף 112(א)` FALSE FALSE EQUALS TRUE
-- s 112(b): the articles may not vary subsection (a).
#ASSERT `האם החברה שלי רשאית להתנות בתקנון על הוראות סעיף 112(א)` EQUALS FALSE
-- s 112(b): the articles may add matters on which only the board decides.
#ASSERT `האם החברה שלי רשאית לקבוע בתקנון נושאים נוספים שבהם יתקבלו החלטות בידי הדירקטוריון בלבד` EQUALS TRUE
-- s 112(c): committees for recommendation only may be set up on those matters.
#ASSERT `האם הדירקטוריון רשאי להקים ועדות בנושאים המנויים בסעיף 112(א) לשם המלצה בלבד` EQUALS TRUE
-- s 113: the board may cancel a decision of a committee it appointed.
#ASSERT `האם הדירקטוריון רשאי לבטל החלטה של ועדה שמינה` EQUALS TRUE
-- s 113: the company acted on the committee's decision toward me and I did not know of the cancellation.
#ASSERT `האם ביטול החלטת הוועדה אינו פוגע בתוקפה כלפיי אם לא ידעתי על הביטול` TRUE TRUE EQUALS TRUE
-- s 113: I knew of the cancellation.
#ASSERT `האם ביטול החלטת הוועדה אינו פוגע בתוקפה כלפיי אם לא ידעתי על הביטול` TRUE FALSE EQUALS FALSE

§§ `פרק 3 סימן ט׳: ועדת הביקורת`

-- s 114: a public company's board appoints an audit committee.
#ASSERT `האם הדירקטוריון של החברה שלי חייב למנות מבין חבריו ועדת ביקורת` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS TRUE
-- s 114: so does a private bond company's.
#ASSERT `האם הדירקטוריון של החברה שלי חייב למנות מבין חבריו ועדת ביקורת` FALSE FALSE FALSE FALSE TRUE FALSE FALSE TRUE EQUALS TRUE
-- s 114: a private company that is not a bond company has no such duty.
#ASSERT `האם הדירקטוריון של החברה שלי חייב למנות מבין חבריו ועדת ביקורת` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS FALSE
-- s 115(a): at least three members, all the external directors, and a majority independent (two of three).
#ASSERT `האם הרכב ועדת הביקורת של החברה שלי תקין` 3 TRUE 2 EQUALS TRUE
-- s 115(a): only two members.
#ASSERT `האם הרכב ועדת הביקורת של החברה שלי תקין` 2 TRUE 2 EQUALS FALSE
-- s 115(a): only one of three independent.
#ASSERT `האם הרכב ועדת הביקורת של החברה שלי תקין` 3 TRUE 1 EQUALS FALSE
-- s 115(a): not all the external directors are members.
#ASSERT `האם הרכב ועדת הביקורת של החברה שלי תקין` 3 FALSE 2 EQUALS FALSE
-- s 115(b)(1): the chair of the board may not be a member.
#ASSERT `האם אני מנוע מלהיות חבר בוועדת הביקורת` TRUE FALSE FALSE FALSE EQUALS TRUE
-- s 115(b)(1): a director employed by the company or the controlling shareholder.
#ASSERT `האם אני מנוע מלהיות חבר בוועדת הביקורת` FALSE TRUE FALSE FALSE EQUALS TRUE
-- s 115(b)(1): none of the bars applies.
#ASSERT `האם אני מנוע מלהיות חבר בוועדת הביקורת` FALSE FALSE FALSE FALSE EQUALS FALSE
-- s 115(b)(2): a State employee in a government company, not employed by the responsible Minister's ministry.
#ASSERT `האם הוראות פסקה (1) אינן חלות עליי כעובד המדינה בחברה ממשלתית` FALSE FALSE FALSE FALSE TRUE TRUE FALSE EQUALS TRUE
-- s 115(b)(2): employed in the responsible Minister's own ministry.
#ASSERT `האם הוראות פסקה (1) אינן חלות עליי כעובד המדינה בחברה ממשלתית` FALSE FALSE FALSE FALSE TRUE TRUE TRUE EQUALS FALSE
-- s 115(b)(2): not a government company.
#ASSERT `האם הוראות פסקה (1) אינן חלות עליי כעובד המדינה בחברה ממשלתית` FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS FALSE
-- s 115(c): the controlling shareholder or his relative may not be a member.
#ASSERT `האם אני רשאי להיות חבר בוועדת ביקורת` TRUE EQUALS FALSE
-- s 115(c): anyone else may.
#ASSERT `האם אני רשאי להיות חבר בוועדת ביקורת` FALSE EQUALS TRUE
-- s 115(d): an external director may chair the committee.
#ASSERT `האם אני רשאי לכהן כיושב ראש ועדת הביקורת` TRUE FALSE 0 EQUALS TRUE
-- s 115(d): a State employee as in (b)(2) who has chaired for up to nine years.
#ASSERT `האם אני רשאי לכהן כיושב ראש ועדת הביקורת` FALSE TRUE 9 EQUALS TRUE
-- s 115(d): ten years of chairing is past the limit.
#ASSERT `האם אני רשאי לכהן כיושב ראש ועדת הביקורת` FALSE TRUE 10 EQUALS FALSE
-- s 115(d): neither an external director nor such a State employee.
#ASSERT `האם אני רשאי לכהן כיושב ראש ועדת הביקורת` FALSE FALSE 0 EQUALS FALSE
-- s 115(e): the committee chair determined I am needed to present a particular matter.
#ASSERT `האם אני, שאיני רשאי להיות חבר בוועדה, רשאי להיות נוכח בישיבתה` `הדיון בישיבת ועדת הביקורת` TRUE FALSE FALSE FALSE EQUALS TRUE
-- s 115(e): an employee who is not the controller or relative, asked by the committee, at the discussion.
#ASSERT `האם אני, שאיני רשאי להיות חבר בוועדה, רשאי להיות נוכח בישיבתה` `הדיון בישיבת ועדת הביקורת` FALSE TRUE FALSE TRUE EQUALS TRUE
-- s 115(e): an employee may not be present when the decision is taken.
#ASSERT `האם אני, שאיני רשאי להיות חבר בוועדה, רשאי להיות נוכח בישיבתה` `קבלת ההחלטה בישיבת ועדת הביקורת` FALSE TRUE FALSE TRUE EQUALS FALSE
-- s 115(e): the legal adviser or secretary, asked by the committee, even at the decision.
#ASSERT `האם אני, שאיני רשאי להיות חבר בוועדה, רשאי להיות נוכח בישיבתה` `קבלת ההחלטה בישיבת ועדת הביקורת` FALSE FALSE TRUE TRUE EQUALS TRUE
-- s 115(e): none of the grounds.
#ASSERT `האם אני, שאיני רשאי להיות חבר בוועדה, רשאי להיות נוכח בישיבתה` `הדיון בישיבת ועדת הביקורת` FALSE FALSE FALSE FALSE EQUALS FALSE
-- s 115(f): the committee serves as the financial-statements committee and the discussion is on the statements.
#ASSERT `האם בדיון בדוחות הכספיים בוועדה חלות הוראות סעיף 171(ה)` TRUE TRUE EQUALS TRUE
-- s 115(f): the committee does not so serve.
#ASSERT `האם בדיון בדוחות הכספיים בוועדה חלות הוראות סעיף 171(ה)` FALSE TRUE EQUALS FALSE
-- s 116(a): the internal auditor receives notice and may take part.
#ASSERT `האם אני כמבקר פנימי מקבל הודעות על ישיבות ועדת הביקורת ורשאי להשתתף בהן` TRUE EQUALS TRUE
-- s 116(a): not the internal auditor.
#ASSERT `האם אני כמבקר פנימי מקבל הודעות על ישיבות ועדת הביקורת ורשאי להשתתף בהן` FALSE EQUALS FALSE
-- s 116(b): the internal auditor may ask the chair to convene it.
#ASSERT `האם אני כמבקר פנימי רשאי לבקש מיושב ראש ועדת הביקורת לכנס את הוועדה` TRUE EQUALS TRUE
-- s 116(b): not the internal auditor.
#ASSERT `האם אני כמבקר פנימי רשאי לבקש מיושב ראש ועדת הביקורת לכנס את הוועדה` FALSE EQUALS FALSE
-- s 116(b): the chair saw reason to convene, so he does so within a reasonable time.
#ASSERT `האם יושב ראש ועדת הביקורת חייב לכנס את הוועדה בתוך זמן סביר לבקשתי` TRUE TRUE EQUALS TRUE
-- s 116(b): the chair saw no reason.
#ASSERT `האם יושב ראש ועדת הביקורת חייב לכנס את הוועדה בתוך זמן סביר לבקשתי` TRUE FALSE EQUALS FALSE
-- s 116(c): a matter concerning the audit of the financial statements arises.
#ASSERT `האם ההודעה על הישיבה תומצא לי כרואה חשבון מבקר ואני רשאי להשתתף בה` TRUE EQUALS TRUE
-- s 116(c): no such matter.
#ASSERT `האם ההודעה על הישיבה תומצא לי כרואה חשבון מבקר ואני רשאי להשתתף בה` FALSE EQUALS FALSE
-- s 116A: three of five members present, a majority of those present independent, and one external director.
#ASSERT `האם נכח מנין חוקי בישיבת ועדת הביקורת` 5 3 2 1 EQUALS TRUE
-- s 116A: two of five is not a majority of the members.
#ASSERT `האם נכח מנין חוקי בישיבת ועדת הביקורת` 5 2 2 1 EQUALS FALSE
-- s 116A: only one of three present is independent.
#ASSERT `האם נכח מנין חוקי בישיבת ועדת הביקורת` 5 3 1 1 EQUALS FALSE
-- s 116A: no external director present.
#ASSERT `האם נכח מנין חוקי בישיבת ועדת הביקורת` 5 3 2 0 EQUALS FALSE
-- s 117(3): examining the internal auditor's work plan.
#ASSERT `האם התפקיד הזה הוא מתפקידי ועדת הביקורת` `לבחון את תכנית העבודה של המבקר הפנימי` EQUALS TRUE
-- s 117: a function not listed.
#ASSERT `האם התפקיד הזה הוא מתפקידי ועדת הביקורת` `תפקיד אחר שאינו מנוי בסעיף 117` EQUALS FALSE
-- s 117(1): the committee found no material defect, so nothing is required.
#ASSERT `האם הוועדה קיימה כנדרש ישיבה בענין ליקוי מהותי` FALSE FALSE FALSE FALSE EQUALS TRUE
-- s 117(1): a meeting was held on the defect with the auditor present and no outside office-holders.
#ASSERT `האם הוועדה קיימה כנדרש ישיבה בענין ליקוי מהותי` TRUE TRUE TRUE FALSE EQUALS TRUE
-- s 117(1): no meeting was held on the defect.
#ASSERT `האם הוועדה קיימה כנדרש ישיבה בענין ליקוי מהותי` TRUE FALSE FALSE FALSE EQUALS FALSE
-- s 117(1): office-holders who are not members were present other than to present a position at the committee's request.
#ASSERT `האם הוועדה קיימה כנדרש ישיבה בענין ליקוי מהותי` TRUE TRUE TRUE TRUE EQUALS FALSE
-- s 117(2A): a transaction of that kind that the committee decided is not extraordinary and classified as not negligible.
#ASSERT `האם העסקה היא עסקה שאינה זניחה` TRUE TRUE TRUE EQUALS TRUE
-- s 117(2A): the committee has not classified it as not negligible.
#ASSERT `האם העסקה היא עסקה שאינה זניחה` TRUE TRUE FALSE EQUALS FALSE
-- s 118(a): a private company that is not a bond company.
#ASSERT `האם הדירקטוריון רשאי למנות ועדת ביקורת בחברה הפרטית שלי שאינה חברת איגרות חוב` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS TRUE
-- s 118(a): a public company.
#ASSERT `האם הדירקטוריון רשאי למנות ועדת ביקורת בחברה הפרטית שלי שאינה חברת איגרות חוב` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS FALSE
-- s 118(a): a director not employed by the company and not regularly serving it.
#ASSERT `האם אני כדירקטור רשאי לכהן בוועדת ביקורת בחברה פרטית שאינה חברת איגרות חוב` FALSE FALSE EQUALS TRUE
-- s 118(a): employed by the company.
#ASSERT `האם אני כדירקטור רשאי לכהן בוועדת ביקורת בחברה פרטית שאינה חברת איגרות חוב` TRUE FALSE EQUALS FALSE
-- s 118(a): regularly provides services to the company.
#ASSERT `האם אני כדירקטור רשאי לכהן בוועדת ביקורת בחברה פרטית שאינה חברת איגרות חוב` FALSE TRUE EQUALS FALSE
-- s 118(a): the controlling shareholder or his relative may not chair it.
#ASSERT `האם אני רשאי לכהן כיושב ראש ועדת ביקורת בחברה פרטית שאינה חברת איגרות חוב` TRUE EQUALS FALSE
-- s 118(a): anyone else may.
#ASSERT `האם אני רשאי לכהן כיושב ראש ועדת ביקורת בחברה פרטית שאינה חברת איגרות חוב` FALSE EQUALS TRUE
-- s 118(b): the role is as section 117(2) describes and a majority of the members are or are relatives of material shareholders.
#ASSERT `האם אפשר למנות את הוועדה בחברה הפרטית שלי שאינה חברת איגרות חוב` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE 4 3 EQUALS FALSE
-- s 118(b): exactly half is not a majority.
#ASSERT `האם אפשר למנות את הוועדה בחברה הפרטית שלי שאינה חברת איגרות חוב` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE 4 2 EQUALS TRUE
-- s 118(b): the role is not the one section 117(2) describes.
#ASSERT `האם אפשר למנות את הוועדה בחברה הפרטית שלי שאינה חברת איגרות חוב` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 4 3 EQUALS TRUE

§§ `פרק 3 סימן י׳: ועדת התגמול`

-- s 118A(a): a public company's board appoints a compensation committee.
#ASSERT `האם הדירקטוריון של החברה שלי חייב למנות מבין חבריו ועדת תגמול` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS TRUE
-- s 118A(a): so does a private bond company's.
#ASSERT `האם הדירקטוריון של החברה שלי חייב למנות מבין חבריו ועדת תגמול` FALSE FALSE FALSE FALSE TRUE FALSE FALSE TRUE FALSE EQUALS TRUE
-- s 118A(a): a private company that is not a bond company.
#ASSERT `האם הדירקטוריון של החברה שלי חייב למנות מבין חבריו ועדת תגמול` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS FALSE
-- s 118A(b): three members, all the external directors, a majority of them external, terms as the Law fixes, and an external chair.
#ASSERT `האם הרכב ועדת התגמול של החברה שלי תקין` 3 TRUE 2 TRUE TRUE EQUALS TRUE
-- s 118A(b): the chair is not an external director.
#ASSERT `האם הרכב ועדת התגמול של החברה שלי תקין` 3 TRUE 2 TRUE FALSE EQUALS FALSE
-- s 118A(b): the other members' terms are not as the Law fixes.
#ASSERT `האם הרכב ועדת התגמול של החברה שלי תקין` 3 TRUE 2 FALSE TRUE EQUALS FALSE
-- s 118A(b): only one of three is an external director.
#ASSERT `האם הרכב ועדת התגמול של החברה שלי תקין` 3 TRUE 1 TRUE TRUE EQUALS FALSE
-- s 118A(c): sub-chapter H and s 115(b) to (e) apply to a compensation committee.
#ASSERT `האם על ועדת התגמול חלים הסימן על ועדות הדירקטוריון וסעיף 115(ב) עד (ה)` TRUE EQUALS TRUE
-- s 118A(c): not a compensation committee.
#ASSERT `האם על ועדת התגמול חלים הסימן על ועדות הדירקטוריון וסעיף 115(ב) עד (ה)` FALSE EQUALS FALSE
-- s 118A(d): the audit committee meets the conditions of s 118A(b).
#ASSERT `האם ועדת הביקורת של החברה שלי יכולה לשמש גם ועדת תגמול` TRUE EQUALS TRUE
-- s 118A(d): it does not.
#ASSERT `האם ועדת הביקורת של החברה שלי יכולה לשמש גם ועדת תגמול` FALSE EQUALS FALSE
-- s 118B(4): exempting a transaction from general-meeting approval.
#ASSERT `האם התפקיד הזה הוא מתפקידי ועדת התגמול` `לפטור עסקה מאישור האסיפה הכללית` EQUALS TRUE
-- s 118B: a function not listed.
#ASSERT `האם התפקיד הזה הוא מתפקידי ועדת התגמול` `תפקיד אחר שאינו מנוי בסעיף 118ב` EQUALS FALSE
