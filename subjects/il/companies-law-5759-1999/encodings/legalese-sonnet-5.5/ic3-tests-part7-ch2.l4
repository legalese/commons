IMPORT prelude
IMPORT `ic-core`
IMPORT `ic-core-securities`
IMPORT `ic3-tests-fixtures`
IMPORT `ic3-part7-ch2-distributions`

-- ic3-tests-part7-ch2: tests of ic3-part7-ch2-distributions.l4 (sections 301 to 313), src:1999-2079.
-- Every expected value is written from the text before the code was run, never copied from the code's output.

§ `בדיקות: חלק 7 פרק 2`

§§ `סימן א׳: חלוקה מותרת`

-- 302(ב), adjusted financial statements: adjusted to the index, or what replaces them, by generally accepted accounting rules.
#ASSERT `סעיף 302(ב) - דוחות כספיים מותאמים` TRUE FALSE TRUE
#ASSERT `סעיף 302(ב) - דוחות כספיים מותאמים` FALSE TRUE TRUE
#ASSERT NOT (`סעיף 302(ב) - דוחות כספיים מותאמים` TRUE FALSE FALSE)
#ASSERT NOT (`סעיף 302(ב) - דוחות כספיים מותאמים` FALSE FALSE TRUE)
-- 302(ב), surpluses: in equity; from net profit, or not share capital or premium and the Minister so determined.
#ASSERT `סעיף 302(ב) - עודפים` TRUE TRUE FALSE FALSE
#ASSERT `סעיף 302(ב) - עודפים` TRUE FALSE FALSE TRUE
#ASSERT NOT (`סעיף 302(ב) - עודפים` TRUE FALSE FALSE FALSE)
#ASSERT NOT (`סעיף 302(ב) - עודפים` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`סעיף 302(ב) - עודפים` FALSE TRUE FALSE FALSE)
-- 302(ב), profits: the higher of the balance of surpluses (500) and the two-year accumulation (300), less previous distributions not yet deducted (100).
#ASSERT `סעיף 302(ב) - רווחים לענין מבחן הרווח` 500 300 100 TRUE 6 EQUALS JUST 400
-- The two-year accumulation is the higher.
#ASSERT `סעיף 302(ב) - רווחים לענין מבחן הרווח` 200 300 0 TRUE 3 EQUALS JUST 300
-- Statements made up more than six months before the distribution (7): no profits can be computed.
#ASSERT `סעיף 302(ב) - רווחים לענין מבחן הרווח` 500 300 100 TRUE 7 EQUALS NOTHING
-- Statements that are not the last audited or reviewed adjusted ones: no profits.
#ASSERT `סעיף 302(ב) - רווחים לענין מבחן הרווח` 500 300 100 FALSE 2 EQUALS NOTHING
-- 302(א), the profit test: the amount is within the profits; no profits, no test met.
#ASSERT `סעיף 302(א) - החלוקה מקיימת את מבחן הרווח` 400 (JUST 400)
#ASSERT NOT (`סעיף 302(א) - החלוקה מקיימת את מבחן הרווח` 401 (JUST 400))
#ASSERT NOT (`סעיף 302(א) - החלוקה מקיימת את מבחן הרווח` 1 NOTHING)
-- The solvency test: no reasonable concern.
#ASSERT `סעיף 302(א) - החלוקה מקיימת את מבחן יכולת הפרעון` FALSE
#ASSERT NOT (`סעיף 302(א) - החלוקה מקיימת את מבחן יכולת הפרעון` TRUE)
-- Both: a distribution out of profits.
#ASSERT `סעיף 302(א) - החברה רשאית לבצע חלוקה מתוך רווחיה` TRUE TRUE
#ASSERT NOT (`סעיף 302(א) - החברה רשאית לבצע חלוקה מתוך רווחיה` TRUE FALSE)
#ASSERT NOT (`סעיף 302(א) - החברה רשאית לבצע חלוקה מתוך רווחיה` FALSE TRUE)
-- 303: the court may approve a distribution that fails the profit test if satisfied that the solvency test is met.
#ASSERT `סעיף 303(א) - בית המשפט רשאי לאשר לחברה לבצע חלוקה שאינה מקיימת את מבחן הרווח` TRUE TRUE
#ASSERT NOT (`סעיף 303(א) - בית המשפט רשאי לאשר לחברה לבצע חלוקה שאינה מקיימת את מבחן הרווח` TRUE FALSE)
#ASSERT NOT (`סעיף 303(א) - בית המשפט רשאי לאשר לחברה לבצע חלוקה שאינה מקיימת את מבחן הרווח` FALSE TRUE)
#ASSERT `סעיף 303(ב) - החברה חייבת להודיע לנושיה על הגשת הבקשה` TRUE
#ASSERT NOT (`סעיף 303(ב) - החברה חייבת להודיע לנושיה על הגשת הבקשה` FALSE)
#ASSERT `סעיף 303(ג) - נושה רשאי לפנות לבית המשפט ולהתנגד לבקשת החברה` TRUE TRUE
#ASSERT NOT (`סעיף 303(ג) - נושה רשאי לפנות לבית המשפט ולהתנגד לבקשת החברה` FALSE TRUE)
#ASSERT NOT (`סעיף 303(ג) - נושה רשאי לפנות לבית המשפט ולהתנגד לבקשת החברה` TRUE FALSE)
#ASSERT `סעיף 303(ד) - בית המשפט רשאי להכריע בבקשה, לאשרה, לדחותה או להתנות את אישורה` TRUE
#ASSERT NOT (`סעיף 303(ד) - בית המשפט רשאי להכריע בבקשה, לאשרה, לדחותה או להתנות את אישורה` FALSE)
-- 301(א): the chapter allows (both tests, or a court's approval) and, where the company undertook additional limits, they are met.
-- Arguments: profit test; solvency test; court approval; undertook additional limits; they are met.
#ASSERT `סעיף 301(א) - החברה רשאית לבצע את החלוקה` TRUE TRUE FALSE FALSE FALSE
#ASSERT `סעיף 301(א) - החברה רשאית לבצע את החלוקה` FALSE FALSE TRUE FALSE FALSE
#ASSERT NOT (`סעיף 301(א) - החברה רשאית לבצע את החלוקה` TRUE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`סעיף 301(א) - החברה רשאית לבצע את החלוקה` FALSE TRUE FALSE FALSE FALSE)
#ASSERT NOT (`סעיף 301(א) - החברה רשאית לבצע את החלוקה` TRUE TRUE FALSE TRUE FALSE)
#ASSERT `סעיף 301(א) - החברה רשאית לבצע את החלוקה` TRUE TRUE FALSE TRUE TRUE
-- 301(ב): a distribution that neither meets both tests nor has a court's approval is a forbidden distribution.
#ASSERT `סעיף 301(ב) - החלוקה היא חלוקה אסורה` FALSE TRUE FALSE
#ASSERT `סעיף 301(ב) - החלוקה היא חלוקה אסורה` TRUE FALSE FALSE
#ASSERT NOT (`סעיף 301(ב) - החלוקה היא חלוקה אסורה` TRUE TRUE FALSE)
#ASSERT NOT (`סעיף 301(ב) - החלוקה היא חלוקה אסורה` FALSE FALSE TRUE)
-- 304(א): the difference between the par value (100) and the consideration (80) is turned into share capital.
#ASSERT `סעיף 304(א) - הסכום שיש להפוך להון מניות` 100 80 EQUALS JUST 20
#ASSERT `סעיף 304(א) - הסכום שיש להפוך להון מניות` 100 100 EQUALS NOTHING
#ASSERT `סעיף 304(א) - הסכום שיש להפוך להון מניות` 100 120 EQUALS NOTHING
#ASSERT `סעיף 304(א) - הסכום שיש להפוך להון מניות` 100 0 EQUALS JUST 100
-- ... from profits, premium or another source: together at least the difference.
#ASSERT `סעיף 304(א) - החברה הפכה להון מניות את הסכום הנדרש` 10 5 5 100 80
#ASSERT NOT (`סעיף 304(א) - החברה הפכה להון מניות את הסכום הנדרש` 10 5 4 100 80)
#ASSERT `סעיף 304(א) - החברה הפכה להון מניות את הסכום הנדרש` 0 0 0 100 100
-- 304(ב): a court may approve a lower consideration other than as in (א).
#ASSERT `סעיף 304(ב) - ההקצאה בתמורה הנמוכה מהערך הנקוב מותרת באישור בית משפט` TRUE TRUE
#ASSERT NOT (`סעיף 304(ב) - ההקצאה בתמורה הנמוכה מהערך הנקוב מותרת באישור בית משפט` TRUE FALSE)
#ASSERT NOT (`סעיף 304(ב) - ההקצאה בתמורה הנמוכה מהערך הנקוב מותרת באישור בית משפט` FALSE TRUE)

§§ `סימן ב׳: דיבידנד`

-- 306(א): the right to the dividend or bonus shares the company decided on.
#ASSERT `סעיף 306(א) - לבעל מניה הזכות לקבל דיבידנד או מניות הטבה` TRUE TRUE
#ASSERT NOT (`סעיף 306(א) - לבעל מניה הזכות לקבל דיבידנד או מניות הטבה` TRUE FALSE)
#ASSERT NOT (`סעיף 306(א) - לבעל מניה הזכות לקבל דיבידנד או מניות הטבה` FALSE TRUE)
-- 306(ב): different par values: in proportion to par value. 1,000 distributed; the holder's shares have a par value of 200 of a total of 1,000.
#ASSERT `סעיף 306(ב) - חלקו של בעל המניה בדיבידנד או במניות הטבה` TRUE FALSE 1_000 200 1_000 EQUALS JUST 200
-- The articles provide otherwise: they decide.
#ASSERT `סעיף 306(ב) - חלקו של בעל המניה בדיבידנד או במניות הטבה` TRUE TRUE 1_000 200 1_000 EQUALS NOTHING
-- All shares with the same par value: the subsection does not speak of it.
#ASSERT `סעיף 306(ב) - חלקו של בעל המניה בדיבידנד או במניות הטבה` FALSE FALSE 1_000 200 1_000 EQUALS NOTHING
-- 307: who decides.
#ASSERT `סעיף 307 - מי מחליט על חלוקת דיבידנד` `התקנון לא קובע דרך אחרת` EQUALS JUST `הדירקטוריון`
#ASSERT `סעיף 307 - מי מחליט על חלוקת דיבידנד` `החלטה באסיפה הכללית לאחר המלצת הדירקטוריון` EQUALS JUST `האסיפה הכללית`
#ASSERT `סעיף 307 - מי מחליט על חלוקת דיבידנד` `החלטה בדירקטוריון לאחר שהאסיפה קבעה את סכום החלוקה המרבי` EQUALS JUST `הדירקטוריון`
#ASSERT `סעיף 307 - מי מחליט על חלוקת דיבידנד` `דרך אחרת שנקבעה בתקנון` EQUALS NOTHING
-- 307(1): the meeting may accept the recommendation or reduce the amount, but not increase it.
#ASSERT `סעיף 307(1) - האסיפה הכללית רשאית לאשר את הסכום` 100 100
#ASSERT `סעיף 307(1) - האסיפה הכללית רשאית לאשר את הסכום` 100 90
#ASSERT NOT (`סעיף 307(1) - האסיפה הכללית רשאית לאשר את הסכום` 100 101)
-- 307(3).
#ASSERT `סעיף 307(3) - הדרך האחרת שנקבעה בתקנון מותרת` TRUE
#ASSERT NOT (`סעיף 307(3) - הדרך האחרת שנקבעה בתקנון מותרת` FALSE)

§§ `סימן ג׳: רכישה`

-- 308(א): a company that bought a share of its own may cancel it; if it did not and still owns it, it is a dormant share.
#ASSERT `סעיף 308(א) - החברה רשאית לבטל את המניה שרכשה` TRUE
#ASSERT `סעיף 308(א) - המניה היא מניה רדומה` TRUE FALSE TRUE
#ASSERT NOT (`סעיף 308(א) - המניה היא מניה רדומה` TRUE TRUE TRUE)
#ASSERT NOT (`סעיף 308(א) - המניה היא מניה רדומה` TRUE FALSE FALSE)
#ASSERT NOT (`סעיף 308(א) - המניה היא מניה רדומה` FALSE FALSE TRUE)
-- 308(ב): convertible securities it bought and did not cancel may be sold again; shares from their conversion held by it are dormant.
-- Arguments: the company bought convertible securities; it did not cancel them.
#ASSERT `סעיף 308(ב) - החברה רשאית לחזור ולמכור את ניירות הערך שרכשה` TRUE TRUE
#ASSERT NOT (`סעיף 308(ב) - החברה רשאית לחזור ולמכור את ניירות הערך שרכשה` TRUE FALSE)
#ASSERT NOT (`סעיף 308(ב) - החברה רשאית לחזור ולמכור את ניירות הערך שרכשה` FALSE TRUE)
#ASSERT `סעיף 308(ב) - המניות שהומרו או מומשו הן מניות רדומות` TRUE TRUE
#ASSERT NOT (`סעיף 308(ב) - המניות שהומרו או מומשו הן מניות רדומות` TRUE FALSE)
-- The securities the company may sell again are the "securities acquired under section 308" of the core's definition of a private offer (src:184):
-- a public company's offer to sell them, that is not a public offer, is a private offer.
#ASSERT `הצעה פרטית` (`עובדות על הצעה לניירות ערך` WITH `הצעה להנפקת ניירות ערך של חברה ציבורית` IS FALSE, `הצעה של חברה ציבורית למכירה של ניירות ערך שלה שנרכשו על ידה לפי סעיף 308` IS `סעיף 308(ב) - החברה רשאית לחזור ולמכור את ניירות הערך שרכשה` TRUE TRUE, `הצעה לציבור` IS FALSE)
-- 309(א): within the extent the parent could distribute (100), on the board's determination.
#ASSERT `סעיף 309(א) - החברה הבת או התאגיד הרוכש רשאים לרכוש מניות של החברה האם` 100 100 TRUE
#ASSERT NOT (`סעיף 309(א) - החברה הבת או התאגיד הרוכש רשאים לרכוש מניות של החברה האם` 101 100 TRUE)
#ASSERT NOT (`סעיף 309(א) - החברה הבת או התאגיד הרוכש רשאים לרכוש מניות של החברה האם` 100 100 FALSE)
-- 309(ב): a parent share held by the subsidiary acquires no voting rights.
#ASSERT NOT (`סעיף 309(ב) - המניה קונה זכויות הצבעה` TRUE TRUE)
#ASSERT `סעיף 309(ב) - המניה קונה זכויות הצבעה` TRUE FALSE
#ASSERT `סעיף 309(ב) - המניה קונה זכויות הצבעה` FALSE TRUE
-- 309(ג): who bears the liability of section 311.
#ASSERT `סעיף 309(ג) - מי נושא באחריות בחלוקה אסורה ברכישה בידי חברה בת` FALSE EQUALS `הדירקטורים בחברה הבת והמנהלים בתאגיד הרוכש`
#ASSERT `סעיף 309(ג) - מי נושא באחריות בחלוקה אסורה ברכישה בידי חברה בת` TRUE EQUALS `הדירקטורים בחברה האם`
-- 309(ד): a purchase by a subsidiary the parent owns 60% of, 1,000: a distribution of 600; a wholly owned one is not covered by (ד).
#ASSERT `סעיף 309(ד) - סכום החלוקה ברכישה בידי חברה בת שאינה בבעלות מלאה` FALSE 1_000 0.6 EQUALS JUST 600
#ASSERT `סעיף 309(ד) - סכום החלוקה ברכישה בידי חברה בת שאינה בבעלות מלאה` TRUE 1_000 1 EQUALS NOTHING
-- 309א: a purchase of convertible securities up to the liability shown is not a distribution.
#ASSERT `סעיף 309א - החלק ברכישה שנחשב חלוקה` 1_000 800 EQUALS 200
#ASSERT `סעיף 309א - החלק ברכישה שנחשב חלוקה` 1_000 1_200 EQUALS 0
#ASSERT `סעיף 309א - החלק ברכישה שנחשב חלוקה` 1_000 1_000 EQUALS 0

§§ `סימן ד׳: חלוקה אסורה`

-- 310(ב): the presumption for a shareholder in a public company who was not a director, general manager or controlling shareholder.
#ASSERT `סעיף 310(ב) - חזקה שבעל המניה לא ידע ולא היה עליו לדעת שהחלוקה אסורה` `ic3 - חברה ציבורית לדוגמה` FALSE FALSE
#ASSERT NOT (`סעיף 310(ב) - חזקה שבעל המניה לא ידע ולא היה עליו לדעת שהחלוקה אסורה` `ic3 - חברה ציבורית לדוגמה` TRUE FALSE)
#ASSERT NOT (`סעיף 310(ב) - חזקה שבעל המניה לא ידע ולא היה עליו לדעת שהחלוקה אסורה` `ic3 - חברה ציבורית לדוגמה` FALSE TRUE)
#ASSERT NOT (`סעיף 310(ב) - חזקה שבעל המניה לא ידע ולא היה עליו לדעת שהחלוקה אסורה` `ic3 - חברה פרטית רגילה לדוגמה` FALSE FALSE)
-- 310(א): return what he received unless he did not know and had no reason to know. Arguments: forbidden distribution; he received;
-- he knew; he should have known on the facts; the presumption of 310(ב) holds.
#ASSERT `סעיף 310(א) - בעל המניה חייב להשיב לחברה את שקיבל` TRUE TRUE TRUE FALSE FALSE
#ASSERT `סעיף 310(א) - בעל המניה חייב להשיב לחברה את שקיבל` TRUE TRUE FALSE TRUE FALSE
#ASSERT NOT (`סעיף 310(א) - בעל המניה חייב להשיב לחברה את שקיבל` TRUE TRUE FALSE FALSE FALSE)
-- The presumption protects a shareholder who is said to have had reason to know, as long as nobody proved it.
#ASSERT NOT (`סעיף 310(א) - בעל המניה חייב להשיב לחברה את שקיבל` TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`סעיף 310(א) - בעל המניה חייב להשיב לחברה את שקיבל` FALSE TRUE TRUE TRUE FALSE)
#ASSERT NOT (`סעיף 310(א) - בעל המניה חייב להשיב לחברה את שקיבל` TRUE FALSE TRUE TRUE FALSE)
