#ASSERT `סעיף 311 - הדירקטור נחשב כמי שהפר את חובותיו כלפי החברה` TRUE TRUE FALSE FALSE FALSE
#ASSERT NOT (`סעיף 311 - הדירקטור נחשב כמי שהפר את חובותיו כלפי החברה` TRUE TRUE TRUE FALSE FALSE)
#ASSERT NOT (`סעיף 311 - הדירקטור נחשב כמי שהפר את חובותיו כלפי החברה` TRUE TRUE FALSE TRUE FALSE)
#ASSERT NOT (`סעיף 311 - הדירקטור נחשב כמי שהפר את חובותיו כלפי החברה` TRUE TRUE FALSE FALSE TRUE)
#ASSERT NOT (`סעיף 311 - הדירקטור נחשב כמי שהפר את חובותיו כלפי החברה` TRUE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`סעיף 311 - הדירקטור נחשב כמי שהפר את חובותיו כלפי החברה` FALSE TRUE FALSE FALSE FALSE)

§§ `סימן ה׳: ניירות ערך בני פדיון`

#ASSERT `סעיף 312(א) - החברה רשאית להנפיק ניירות ערך בני פדיון` TRUE
#ASSERT NOT (`סעיף 312(א) - החברה רשאית להנפיק ניירות ערך בני פדיון` FALSE)
-- 312(ד): part of equity only if the right to redeem is limited to winding up after the creditors are paid.
#ASSERT `סעיף 312(ד) - ניירות ערך בני פדיון הם חלק מהונה העצמי של החברה` TRUE
#ASSERT NOT (`סעיף 312(ד) - ניירות ערך בני פדיון הם חלק מהונה העצמי של החברה` FALSE)
-- 312(ב): redemption is free of this chapter's limits unless the right is limited as in (ד).
#ASSERT `סעיף 312(ב) - הפדיון פטור מהמגבלות שבפרק` TRUE FALSE
#ASSERT NOT (`סעיף 312(ב) - הפדיון פטור מהמגבלות שבפרק` TRUE TRUE)
#ASSERT NOT (`סעיף 312(ב) - הפדיון פטור מהמגבלות שבפרק` FALSE FALSE)
#ASSERT `סעיף 312(ג) - החברה רשאית להצמיד לניירות הערך בני הפדיון מתכונותיהן של מניות` TRUE
#ASSERT NOT (`סעיף 312(ג) - החברה רשאית להצמיד לניירות הערך בני הפדיון מתכונותיהן של מניות` FALSE)
-- The outcome of 312(ד) feeds the core's definition of a distribution: a redemption of redeemable securities that are part of the equity is an
-- acquisition, so a distribution (src:209); a redemption of ones that are not is not.
#ASSERT `חלוקה` (`עובדות על חלוקה` WITH `מתן דיבידנד` IS FALSE, `התחייבות לתת דיבידנד` IS FALSE, `רכישה או מתן מימון לרכישה של מניות החברה או של ניירות ערך הניתנים להמרה או למימוש במניותיה, בידי החברה, חברה בת שלה או תאגיד אחר בשליטתה` IS FALSE, `פדיון של ניירות ערך בני פדיון שהם חלק מהונה העצמי של החברה בהתאם לסעיף 312(ד)` IS `סעיף 312(ד) - ניירות ערך בני פדיון הם חלק מהונה העצמי של החברה` TRUE, `התחייבות לעשיית אחד מאלה` IS FALSE, `המוכר הוא החברה עצמה או תאגיד אחר בבעלותה המלאה` IS FALSE)
#ASSERT NOT (`חלוקה` (`עובדות על חלוקה` WITH `מתן דיבידנד` IS FALSE, `התחייבות לתת דיבידנד` IS FALSE, `רכישה או מתן מימון לרכישה של מניות החברה או של ניירות ערך הניתנים להמרה או למימוש במניותיה, בידי החברה, חברה בת שלה או תאגיד אחר בשליטתה` IS FALSE, `פדיון של ניירות ערך בני פדיון שהם חלק מהונה העצמי של החברה בהתאם לסעיף 312(ד)` IS `סעיף 312(ד) - ניירות ערך בני פדיון הם חלק מהונה העצמי של החברה` FALSE, `התחייבות לעשיית אחד מאלה` IS FALSE, `המוכר הוא החברה עצמה או תאגיד אחר בבעלותה המלאה` IS FALSE))

§§ `סעיף 313: הוראות מעבר`

#ASSERT `סעיף 313 - מניות הפדיון שהוקצו לפי הפקודה נחשבות חלק מהונה של החברה` TRUE
#ASSERT NOT (`סעיף 313 - מניות הפדיון שהוקצו לפי הפקודה נחשבות חלק מהונה של החברה` FALSE)
#ASSERT `סעיף 313 - ניתן לפדות את מניות הפדיון בכפוף להוראות הפרק, בתנאים ובדרך שנקבעו בתקנון` TRUE
#ASSERT NOT (`סעיף 313 - ניתן לפדות את מניות הפדיון בכפוף להוראות הפרק, בתנאים ובדרך שנקבעו בתקנון` FALSE)
