IMPORT prelude
IMPORT `ic-core`
IMPORT `ic2-tests-fixtures`
IMPORT `ic2-p5c2-shareholder-rights`

-- Tests of ic2-p5c2-shareholder-rights.l4 (sections 183 to 193). Expected values are written from the text of the section named beside each.

§ `בדיקות: זכויותיו וחובותיו של בעל מניה`

-- Ties to the company: control (as the Securities Law means it), and none.
`קשר - בעל שליטה` MEANS `קשר לחברה` WITH
    `החזקה בהון המניות המונפק` IS 0.6
    `החזקה בזכויות ההצבעה` IS 0.6
    `סמכות למנות דירקטור אחד או יותר` IS TRUE
    `סמכות למנות את המנהל הכללי` IS FALSE
    `מכהן כדירקטור` IS FALSE
    `מכהן כמנהל כללי` IS FALSE
    `שליטה לפי חוק ניירות ערך` IS TRUE
`קשר - בעל מניות קטנות` MEANS `קשר לחברה` WITH
    `החזקה בהון המניות המונפק` IS 0.01
    `החזקה בזכויות ההצבעה` IS 0.01
    `סמכות למנות דירקטור אחד או יותר` IS FALSE
    `סמכות למנות את המנהל הכללי` IS FALSE
    `מכהן כדירקטור` IS FALSE
    `מכהן כמנהל כללי` IS FALSE
    `שליטה לפי חוק ניירות ערך` IS FALSE

§§ `סעיפים 183 עד 187`

-- 183: rights and duties come from this Law, the articles and any law.
#ASSERT `סעיף 183 - המקור קובע זכויות וחובות של בעל מניה` `חוק זה`
#ASSERT `סעיף 183 - המקור קובע זכויות וחובות של בעל מניה` `תקנון החברה כמסמך שבעלי מניות זכאים לעיין בו`
#ASSERT `סעיף 183 - המקור קובע זכויות וחובות של בעל מניה` `כל דין`
#ASSERT NOT (`סעיף 183 - המקור קובע זכויות וחובות של בעל מניה` `מקור אחר`)
-- 184: the five kinds of document; (3) and (5) on their conditions.
#ASSERT `סעיף 184 - בעלי מניות זכאים לעיין במסמך` `פרוטוקול של אסיפה כללית כמסמך שבעלי מניות זכאים לעיין בו` FALSE FALSE
#ASSERT `סעיף 184 - בעלי מניות זכאים לעיין במסמך` `מרשם בעלי המניות או מרשם בעלי המניות המהותיים` FALSE FALSE
#ASSERT `סעיף 184 - בעלי מניות זכאים לעיין במסמך` `תקנון או דוחות כספיים כאמור בסעיף 187` FALSE FALSE
#ASSERT `סעיף 184 - בעלי מניות זכאים לעיין במסמך` `מסמך שברשות החברה כאמור בסעיף 185` TRUE FALSE
#ASSERT NOT (`סעיף 184 - בעלי מניות זכאים לעיין במסמך` `מסמך שברשות החברה כאמור בסעיף 185` FALSE TRUE)
#ASSERT `סעיף 184 - בעלי מניות זכאים לעיין במסמך` `מסמך שחובה להגישו לרשם או לרשות ניירות ערך` FALSE TRUE
#ASSERT NOT (`סעיף 184 - בעלי מניות זכאים לעיין במסמך` `מסמך שחובה להגישו לרשם או לרשות ניירות ערך` TRUE FALSE)
#ASSERT NOT (`סעיף 184 - בעלי מניות זכאים לעיין במסמך` `מסמך אחר שבעלי מניות זכאים לעיין בו` TRUE TRUE)
-- 185(א): a demand with a stated purpose, for a document about an act needing general meeting approval, or (private company) one needed for an agenda decision.
#ASSERT `סעיף 185(א) - בעל המניה זכאי לדרוש לעיין במסמך הנמצא ברשות החברה` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` TRUE TRUE FALSE
#ASSERT NOT (`סעיף 185(א) - בעל המניה זכאי לדרוש לעיין במסמך הנמצא ברשות החברה` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` TRUE FALSE TRUE)
#ASSERT `סעיף 185(א) - בעל המניה זכאי לדרוש לעיין במסמך הנמצא ברשות החברה` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` TRUE FALSE TRUE
#ASSERT NOT (`סעיף 185(א) - בעל המניה זכאי לדרוש לעיין במסמך הנמצא ברשות החברה` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` FALSE TRUE TRUE)
#ASSERT NOT (`סעיף 185(א) - בעל המניה זכאי לדרוש לעיין במסמך הנמצא ברשות החברה` `דוגמה - גוף שהתאגד לפי דין אחר` TRUE TRUE TRUE)
-- 185(ב): the company may refuse on any of the three grounds.
#ASSERT `סעיף 185(ב) - החברה רשאית לסרב לבקשת בעל המניה` TRUE FALSE FALSE
#ASSERT `סעיף 185(ב) - החברה רשאית לסרב לבקשת בעל המניה` FALSE TRUE FALSE
#ASSERT `סעיף 185(ב) - החברה רשאית לסרב לבקשת בעל המניה` FALSE FALSE TRUE
#ASSERT NOT (`סעיף 185(ב) - החברה רשאית לסרב לבקשת בעל המניה` FALSE FALSE FALSE)
-- 186(א): three years; shareholders holding at least ten percent of the voting power: 9.9% is not enough, 10% is.
#ASSERT `סעיף 186(א) - מספר השנים שהודעת התשלומים לדירקטורים כוללת` EQUALS 3
#ASSERT `סעיף 186(א) - הדירקטוריון חייב להמציא הודעה מאושרת על תשלומים לדירקטורים` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` TRUE 0.1
#ASSERT NOT (`סעיף 186(א) - הדירקטוריון חייב להמציא הודעה מאושרת על תשלומים לדירקטורים` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` TRUE 0.099)
#ASSERT NOT (`סעיף 186(א) - הדירקטוריון חייב להמציא הודעה מאושרת על תשלומים לדירקטורים` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` FALSE 0.5)
#ASSERT NOT (`סעיף 186(א) - הדירקטוריון חייב להמציא הודעה מאושרת על תשלומים לדירקטורים` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` TRUE 0.5)
-- 186(ב): the board may refuse a demand it found to be in bad faith.
#ASSERT `סעיף 186(ב) - הדירקטוריון רשאי לסרב לדרישה` TRUE
#ASSERT NOT (`סעיף 186(ב) - הדירקטוריון רשאי לסרב לדרישה` FALSE)
-- 187: the articles to every shareholder; the statements by 173(ד) in a company that is not a reporting corporation; in a reporting corporation, if they were not published.
#ASSERT `סעיף 187(א) - בעל המניה זכאי לקבל מהחברה העתק מהתקנון` TRUE
#ASSERT NOT (`סעיף 187(א) - בעל המניה זכאי לקבל מהחברה העתק מהתקנון` FALSE)
#ASSERT `סעיף 187(א) - בעל המניה זכאי לקבל מהחברה העתק מהדוחות הכספיים` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` TRUE
#ASSERT NOT (`סעיף 187(א) - בעל המניה זכאי לקבל מהחברה העתק מהדוחות הכספיים` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` TRUE)
#ASSERT `סעיף 187(ב) - בעל המניה בתאגיד מדווח זכאי לקבל מהחברה העתק מהדוחות הכספיים` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` TRUE TRUE
#ASSERT NOT (`סעיף 187(ב) - בעל המניה בתאגיד מדווח זכאי לקבל מהחברה העתק מהדוחות הכספיים` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` TRUE FALSE)
#ASSERT NOT (`סעיף 187(ב) - בעל המניה בתאגיד מדווח זכאי לקבל מהחברה העתק מהדוחות הכספיים` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` TRUE TRUE)

§§ `סעיפים 188 עד 190`

-- 188: every shareholder may attend and vote; the votes are the shares times the votes each carries under the articles.
#ASSERT `סעיף 188 - בעל המניה זכאי להשתתף באסיפה הכללית ולהצביע בה` TRUE
#ASSERT NOT (`סעיף 188 - בעל המניה זכאי להשתתף באסיפה הכללית ולהצביע בה` FALSE)
#ASSERT `סעיף 188 - מספר הקולות של בעל המניה באסיפה הכללית` 100 5 EQUALS 500
-- 189: voting agreements are allowed, subject to the duties this Law puts on shareholders.
#ASSERT `סעיף 189 - הסכם ההצבעה מותר` TRUE TRUE
#ASSERT NOT (`סעיף 189 - הסכם ההצבעה מותר` TRUE FALSE)
#ASSERT NOT (`סעיף 189 - הסכם ההצבעה מותר` FALSE TRUE)
-- 190: a shareholder is entitled to a dividend once a distribution was decided.
#ASSERT `סעיף 190 - בעל המניה זכאי לקבל דיבידנד` TRUE TRUE
#ASSERT NOT (`סעיף 190 - בעל המניה זכאי לקבל דיבידנד` TRUE FALSE)
#ASSERT NOT (`סעיף 190 - בעל המניה זכאי לקבל דיבידנד` FALSE TRUE)

§§ `סעיפים 191 ו־192`

-- 191(א): oppression, or a substantial concern of it, and a shareholder's request.
#ASSERT `סעיף 191(א) - בית המשפט רשאי לתת הוראות להסרת הקיפוח או למניעתו` TRUE FALSE TRUE
#ASSERT `סעיף 191(א) - בית המשפט רשאי לתת הוראות להסרת הקיפוח או למניעתו` FALSE TRUE TRUE
#ASSERT NOT (`סעיף 191(א) - בית המשפט רשאי לתת הוראות להסרת הקיפוח או למניעתו` FALSE FALSE TRUE)
#ASSERT NOT (`סעיף 191(א) - בית המשפט רשאי לתת הוראות להסרת הקיפוח או למניעתו` TRUE TRUE FALSE)
-- 191(ב): after a direction the changes count as duly adopted; a copy goes to the Registrar and, for a public company, to the Securities Authority.
#ASSERT `סעיף 191(ב) - השינויים בתקנון ובהחלטות יראו כאילו נתקבלו כדין בידי החברה` TRUE
#ASSERT NOT (`סעיף 191(ב) - השינויים בתקנון ובהחלטות יראו כאילו נתקבלו כדין בידי החברה` FALSE)
#ASSERT `סעיף 191(ב) - יש לשלוח עותק מההחלטה לרשם` TRUE
#ASSERT NOT (`סעיף 191(ב) - יש לשלוח עותק מההחלטה לרשם` FALSE)
#ASSERT `סעיף 191(ב) - יש לשלוח עותק מההחלטה לרשות ניירות ערך` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` TRUE
#ASSERT NOT (`סעיף 191(ב) - יש לשלוח עותק מההחלטה לרשות ניירות ערך` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` TRUE)
#ASSERT NOT (`סעיף 191(ב) - יש לשלוח עותק מההחלטה לרשות ניירות ערך` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` FALSE)
-- 192(א): the duty of good faith binds every shareholder; four matters are named.
#ASSERT `סעיף 192(א) - בעל המניה חייב לנהוג בתום לב ובדרך מקובלת וליימנע מניצול לרעה של כוחו` TRUE
#ASSERT NOT (`סעיף 192(א) - בעל המניה חייב לנהוג בתום לב ובדרך מקובלת וליימנע מניצול לרעה של כוחו` FALSE)
#ASSERT `סעיף 192(א) - הענין מנוי במפורש בין הענינים שבהם חלה החובה בהצבעה` `שינוי התקנון`
#ASSERT `סעיף 192(א) - הענין מנוי במפורש בין הענינים שבהם חלה החובה בהצבעה` `הגדלת ההון הרשום`
#ASSERT `סעיף 192(א) - הענין מנוי במפורש בין הענינים שבהם חלה החובה בהצבעה` `מיזוג כענין שבו מצביע בעל המניה`
#ASSERT `סעיף 192(א) - הענין מנוי במפורש בין הענינים שבהם חלה החובה בהצבעה` `אישור פעולות ועסקאות הטעונות אישור האסיפה הכללית`
#ASSERT NOT (`סעיף 192(א) - הענין מנוי במפורש בין הענינים שבהם חלה החובה בהצבעה` `ענין אחר שבו מצביע בעל המניה`)
-- 192(ב), (ג): do not oppress; breach of either is breach of contract; breach of (ב) also brings section 191.
#ASSERT `סעיף 192(ב) - בעל המניה חייב להימנע מלקפח בעלי מניות אחרים` TRUE
#ASSERT `סעיף 192(ג) - דיני הפרת חוזה חלים על ההפרה` TRUE FALSE
#ASSERT `סעיף 192(ג) - דיני הפרת חוזה חלים על ההפרה` FALSE TRUE
#ASSERT NOT (`סעיף 192(ג) - דיני הפרת חוזה חלים על ההפרה` FALSE FALSE)
#ASSERT `סעיף 192(ג) - סעיף 191 חל גם על ההפרה` TRUE
#ASSERT NOT (`סעיף 192(ג) - סעיף 191 חל גם על ההפרה` FALSE)

§§ `סעיף 193`

-- 193(א): the controlling shareholder, a shareholder whose vote decides, and one whose articles give him a power over an office-holder, owe the company fairness.
#ASSERT `סעיף 193(א) - על האדם מוטלת חובה לפעול בהגינות כלפי החברה` `קשר - בעל שליטה` FALSE FALSE
#ASSERT `סעיף 193(א) - על האדם מוטלת חובה לפעול בהגינות כלפי החברה` `קשר - בעל מניות קטנות` TRUE FALSE
#ASSERT `סעיף 193(א) - על האדם מוטלת חובה לפעול בהגינות כלפי החברה` `קשר - בעל מניות קטנות` FALSE TRUE
#ASSERT NOT (`סעיף 193(א) - על האדם מוטלת חובה לפעול בהגינות כלפי החברה` `קשר - בעל מניות קטנות` FALSE FALSE)
-- 193(ב): breach of the fairness duty is a breach of contract.
#ASSERT `סעיף 193(ב) - דיני הפרת חוזה חלים על הפרת חובת ההגינות` TRUE
#ASSERT NOT (`סעיף 193(ב) - דיני הפרת חוזה חלים על הפרת חובת ההגינות` FALSE)
