-- (ג)(1): 270(2), public company, not the general manager: the compensation committee, then the board.
#ASSERT `סעיף 272(ג) - האישורים שעסקה עם נושא משרה בחברה ציבורית או חברת איגרות חוב טעונה` `ic3 - חברה ציבורית לדוגמה` `ic3 - חלופה 2` `ic3 - עובדות פשוטות עסקה רגילה` EQUALS `ic3 - הנדרש` FALSE TRUE TRUE FALSE FALSE FALSE FALSE
