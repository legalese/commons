#ASSERT NOT (`סעיף 280(ב) - לעסקה אין תוקף גם כלפי אדם אחר` TRUE TRUE (`ic3 - ידיעה` FALSE TRUE FALSE TRUE))
#ASSERT NOT (`סעיף 280(ב) - לעסקה אין תוקף גם כלפי אדם אחר` FALSE TRUE (`ic3 - ידיעה` TRUE FALSE FALSE FALSE))
-- 281: the company may cancel or claim damages: a transaction with another person needing approval, not of section 271,
-- he knew of the interest and knew or should have known of the lack of approval.
#ASSERT `סעיף 281 - החברה רשאית לבטל את העסקה או לתבוע פיצויים` TRUE FALSE TRUE (`ic3 - ידיעה` TRUE FALSE FALSE FALSE)
#ASSERT NOT (`סעיף 281 - החברה רשאית לבטל את העסקה או לתבוע פיצויים` TRUE TRUE TRUE (`ic3 - ידיעה` TRUE FALSE FALSE FALSE))
#ASSERT NOT (`סעיף 281 - החברה רשאית לבטל את העסקה או לתבוע פיצויים` FALSE FALSE TRUE (`ic3 - ידיעה` TRUE FALSE FALSE FALSE))
#ASSERT NOT (`סעיף 281 - החברה רשאית לבטל את העסקה או לתבוע פיצויים` TRUE FALSE FALSE (`ic3 - ידיעה` TRUE FALSE FALSE FALSE))
#ASSERT NOT (`סעיף 281 - החברה רשאית לבטל את העסקה או לתבוע פיצויים` TRUE FALSE TRUE (`ic3 - ידיעה` FALSE TRUE FALSE TRUE))

§§ `סעיף 283: סעדים`

-- (א): an office-holder who did not disclose is treated as having breached the fiduciary duty.
#ASSERT `סעיף 283(א) - נושא המשרה נחשב כמי שהפר את חובת האמונים` TRUE TRUE
#ASSERT NOT (`סעיף 283(א) - נושא המשרה נחשב כמי שהפר את חובת האמונים` TRUE FALSE)
#ASSERT NOT (`סעיף 283(א) - נושא המשרה נחשב כמי שהפר את חובת האמונים` FALSE TRUE)
-- A controlling shareholder in a public or private bond company: the duty of fairness.
#ASSERT `סעיף 283(א) - בעל השליטה נחשב כמי שהפר את חובת ההגינות` `ic3 - חברה ציבורית לדוגמה` TRUE TRUE
#ASSERT `סעיף 283(א) - בעל השליטה נחשב כמי שהפר את חובת ההגינות` `ic3 - חברת איגרות חוב פרטית לדוגמה` TRUE TRUE
#ASSERT NOT (`סעיף 283(א) - בעל השליטה נחשב כמי שהפר את חובת ההגינות` `ic3 - חברה פרטית רגילה לדוגמה` TRUE TRUE)
#ASSERT NOT (`סעיף 283(א) - בעל השליטה נחשב כמי שהפר את חובת ההגינות` `ic3 - חברה ציבורית לדוגמה` TRUE FALSE)
-- (ב): damages from an interested party who breached 269 or a shareholder who did not disclose under 276, for the loss caused.
#ASSERT `סעיף 283(ב) - החברה רשאית לתבוע פיצויים בשל העדר גילוי` TRUE FALSE TRUE
#ASSERT `סעיף 283(ב) - החברה רשאית לתבוע פיצויים בשל העדר גילוי` FALSE TRUE TRUE
#ASSERT NOT (`סעיף 283(ב) - החברה רשאית לתבוע פיצויים בשל העדר גילוי` TRUE FALSE FALSE)
#ASSERT NOT (`סעיף 283(ב) - החברה רשאית לתבוע פיצויים בשל העדר גילוי` FALSE FALSE TRUE)

