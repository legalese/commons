IMPORT prelude
IMPORT `ic-core`
IMPORT `ic-core-people`
IMPORT `ic1-part2-ch3-registrar`

-- Tests of ic1-part2-ch3-registrar.l4 (sections 36 to 45).

§ `בדיקות: חלק 2 פרק 3 – רשם החברות`

§§ `סימן א׳ – לשכת רישום החברות`

-- 36(a). Arguments: a State employee; qualified to serve as a magistrates' court judge; the Minister appointed him Registrar.
#ASSERT `סעיף 36(א) - האדם הוא רשם החברות` TRUE TRUE TRUE EQUALS TRUE
#ASSERT `סעיף 36(א) - האדם הוא רשם החברות` FALSE TRUE TRUE EQUALS FALSE
#ASSERT `סעיף 36(א) - האדם הוא רשם החברות` TRUE FALSE TRUE EQUALS FALSE
#ASSERT `סעיף 36(א) - האדם הוא רשם החברות` TRUE TRUE FALSE EQUALS FALSE
-- 36(b). Arguments: a State employee; appointed deputy; authorised with the Registrar's powers.
#ASSERT `סעיף 36(ב) - האדם הוא סגן הרשם ויש לו סמכויות הרשם` TRUE TRUE TRUE EQUALS TRUE
#ASSERT `סעיף 36(ב) - האדם הוא סגן הרשם ויש לו סמכויות הרשם` TRUE TRUE FALSE EQUALS FALSE
#ASSERT `סעיף 36(ב) - האדם הוא סגן הרשם ויש לו סמכויות הרשם` TRUE FALSE TRUE EQUALS FALSE
#ASSERT `סעיף 36(ב) - האדם הוא סגן הרשם ויש לו סמכויות הרשם` FALSE TRUE TRUE EQUALS FALSE
-- 36(c). Arguments: the Registrar is unable; a Ministry of Justice employee; authorised.
#ASSERT `סעיף 36(ג) - עובד משרד המשפטים מוסמך בסמכויות הרשם כשנבצר מהרשם למלא את תפקידו` TRUE TRUE TRUE EQUALS TRUE
#ASSERT `סעיף 36(ג) - עובד משרד המשפטים מוסמך בסמכויות הרשם כשנבצר מהרשם למלא את תפקידו` FALSE TRUE TRUE EQUALS FALSE
#ASSERT `סעיף 36(ג) - עובד משרד המשפטים מוסמך בסמכויות הרשם כשנבצר מהרשם למלא את תפקידו` TRUE FALSE TRUE EQUALS FALSE
#ASSERT `סעיף 36(ג) - עובד משרד המשפטים מוסמך בסמכויות הרשם כשנבצר מהרשם למלא את תפקידו` TRUE TRUE FALSE EQUALS FALSE
-- 37(a): four matters, no others.
#ASSERT `סעיף 37(א) - הרשם קובע אם נתמלאו התנאים והדרישות בענין` `התאגדות של חברה לענין סעיף 37(א)` EQUALS TRUE
#ASSERT `סעיף 37(א) - הרשם קובע אם נתמלאו התנאים והדרישות בענין` `שינוי שם חברה לענין סעיף 37(א)` EQUALS TRUE
#ASSERT `סעיף 37(א) - הרשם קובע אם נתמלאו התנאים והדרישות בענין` `רישום מסמך לענין סעיף 37(א)` EQUALS TRUE
#ASSERT `סעיף 37(א) - הרשם קובע אם נתמלאו התנאים והדרישות בענין` `מיזוג לענין סעיף 37(א)` EQUALS TRUE
#ASSERT `סעיף 37(א) - הרשם קובע אם נתמלאו התנאים והדרישות בענין` `ענין אחר שאינו מנוי בסעיף 37(א)` EQUALS FALSE
-- 37(b): not less than fourteen days.
#ASSERT `סעיף 37(ב) - הרשם רשאי לדרוש המצאת מרשמים ופנקסים בתוך תקופה של ארבעה עשר ימים לפחות` 14 EQUALS TRUE
#ASSERT `סעיף 37(ב) - הרשם רשאי לדרוש המצאת מרשמים ופנקסים בתוך תקופה של ארבעה עשר ימים לפחות` 30 EQUALS TRUE
#ASSERT `סעיף 37(ב) - הרשם רשאי לדרוש המצאת מרשמים ופנקסים בתוך תקופה של ארבעה עשר ימים לפחות` 13 EQUALS FALSE
#ASSERT `סעיף 37(ג) - הרשם רשאי להורות לחברה לעדכן את המרשמים והפנקסים` TRUE EQUALS TRUE
#ASSERT `סעיף 37(ג) - הרשם רשאי להורות לחברה לעדכן את המרשמים והפנקסים` FALSE EQUALS FALSE

§§ `סימן ב׳ – ניהול מרשמים`

#ASSERT `סעיף 38(א) - הרשם ינהל רישום לגבי כל חברה ויקבל מסמכים ודיווחים` TRUE EQUALS TRUE
#ASSERT `סעיף 38(א) - הרשם ינהל רישום לגבי כל חברה ויקבל מסמכים ודיווחים` FALSE EQUALS FALSE
#ASSERT `סעיף 38(ב) - המסמך או הדיווח נמסר כדין` TRUE FALSE EQUALS TRUE
#ASSERT `סעיף 38(ב) - המסמך או הדיווח נמסר כדין` FALSE TRUE EQUALS TRUE
#ASSERT `סעיף 38(ב) - המסמך או הדיווח נמסר כדין` FALSE FALSE EQUALS FALSE
#ASSERT `סעיף 38(ג) - הרשם ירשום כל חברה במרשם החברות ויתן לה מספר זהות` TRUE EQUALS TRUE
#ASSERT `סעיף 38(ג) - הרשם ירשום כל חברה במרשם החברות ויתן לה מספר זהות` FALSE EQUALS FALSE
-- 39(a). Arguments: bears the identity number; the signatory's office; the signatory is the secretary or authorised; name and role stated.
#ASSERT `סעיף 39(א) - המסמך או הדיווח נושא את מספר הזהות וחתום בידי נושא משרה` TRUE `דירקטור` FALSE TRUE EQUALS TRUE
#ASSERT `סעיף 39(א) - המסמך או הדיווח נושא את מספר הזהות וחתום בידי נושא משרה` TRUE `מנהל כללי` FALSE TRUE EQUALS TRUE
#ASSERT `סעיף 39(א) - המסמך או הדיווח נושא את מספר הזהות וחתום בידי נושא משרה` TRUE `משרה אחרת` TRUE TRUE EQUALS TRUE
#ASSERT `סעיף 39(א) - המסמך או הדיווח נושא את מספר הזהות וחתום בידי נושא משרה` TRUE `משרה אחרת` FALSE TRUE EQUALS FALSE
#ASSERT `סעיף 39(א) - המסמך או הדיווח נושא את מספר הזהות וחתום בידי נושא משרה` FALSE `דירקטור` FALSE TRUE EQUALS FALSE
#ASSERT `סעיף 39(א) - המסמך או הדיווח נושא את מספר הזהות וחתום בידי נושא משרה` TRUE `דירקטור` FALSE FALSE EQUALS FALSE
#ASSERT `סעיף 39(ב) - מסמך או דיווח של חברה בכינוס, בפירוק או בהליכי חדלות פירעון יכול שייחתם בידי כונס הנכסים או הנאמן` TRUE FALSE FALSE EQUALS TRUE
#ASSERT `סעיף 39(ב) - מסמך או דיווח של חברה בכינוס, בפירוק או בהליכי חדלות פירעון יכול שייחתם בידי כונס הנכסים או הנאמן` FALSE TRUE FALSE EQUALS TRUE
#ASSERT `סעיף 39(ב) - מסמך או דיווח של חברה בכינוס, בפירוק או בהליכי חדלות פירעון יכול שייחתם בידי כונס הנכסים או הנאמן` FALSE FALSE TRUE EQUALS TRUE
#ASSERT `סעיף 39(ב) - מסמך או דיווח של חברה בכינוס, בפירוק או בהליכי חדלות פירעון יכול שייחתם בידי כונס הנכסים או הנאמן` FALSE FALSE FALSE EQUALS FALSE
#ASSERT `סעיף 39(ג) - הוראות סעיף 39 חלות` FALSE EQUALS TRUE
#ASSERT `סעיף 39(ג) - הוראות סעיף 39 חלות` TRUE EQUALS FALSE
-- 40: three acts need registration; any other act is not covered (NOTHING).
#ASSERT `סעיף 40 - לפעולה יש תוקף רק אם נרשמה` `שינוי שם חברה לפי סעיף 31` TRUE EQUALS JUST TRUE
#ASSERT `סעיף 40 - לפעולה יש תוקף רק אם נרשמה` `שינוי שם חברה לפי סעיף 31` FALSE EQUALS JUST FALSE
#ASSERT `סעיף 40 - לפעולה יש תוקף רק אם נרשמה` `שינוי מטרות חברה לענין סעיף 40` FALSE EQUALS JUST FALSE
#ASSERT `סעיף 40 - לפעולה יש תוקף רק אם נרשמה` `שינוי מטרות חברה לענין סעיף 40` TRUE EQUALS JUST TRUE
#ASSERT `סעיף 40 - לפעולה יש תוקף רק אם נרשמה` `שינוי תקנון שהופך את החברה לחברה לתועלת הציבור` FALSE EQUALS JUST FALSE
#ASSERT `סעיף 40 - לפעולה יש תוקף רק אם נרשמה` `שינוי תקנון שהופך את החברה לחברה לתועלת הציבור` TRUE EQUALS JUST TRUE
#ASSERT `סעיף 40 - לפעולה יש תוקף רק אם נרשמה` `פעולה אחרת שאינה מנויה בסעיף 40` TRUE EQUALS NOTHING
#ASSERT `סעיף 40 - לפעולה יש תוקף רק אם נרשמה` `פעולה אחרת שאינה מנויה בסעיף 40` FALSE EQUALS NOTHING
-- 41(a): both limbs need a certified copy of a document the Registrar holds.
#ASSERT `סעיף 41(א) - העתק מאושר בידי הרשם מתקבל בכל הליך משפטי כמקור` TRUE TRUE EQUALS TRUE
#ASSERT `סעיף 41(א) - העתק מאושר בידי הרשם מתקבל בכל הליך משפטי כמקור` FALSE TRUE EQUALS FALSE
#ASSERT `סעיף 41(א) - העתק מאושר בידי הרשם מתקבל בכל הליך משפטי כמקור` TRUE FALSE EQUALS FALSE
#ASSERT `סעיף 41(א) - העתק מאושר בידי הרשם ראיה חלוטה לכך שהמסמך המקורי נמצא בלשכת רישום החברות` TRUE TRUE EQUALS TRUE
#ASSERT `סעיף 41(א) - העתק מאושר בידי הרשם ראיה חלוטה לכך שהמסמך המקורי נמצא בלשכת רישום החברות` FALSE TRUE EQUALS FALSE
#ASSERT `סעיף 41(א) - העתק מאושר בידי הרשם ראיה חלוטה לכך שהמסמך המקורי נמצא בלשכת רישום החברות` TRUE FALSE EQUALS FALSE
#ASSERT `סעיף 41(ב) - הוראות סעיף 41(א) חלות על פלט של דיווח אלקטרוני` TRUE TRUE EQUALS TRUE
#ASSERT `סעיף 41(ב) - הוראות סעיף 41(א) חלות על פלט של דיווח אלקטרוני` FALSE TRUE EQUALS FALSE
#ASSERT `סעיף 41(ב) - הוראות סעיף 41(א) חלות על פלט של דיווח אלקטרוני` TRUE FALSE EQUALS FALSE
-- 42: registration of a document is never, alone, evidence of knowledge of its contents.
#ASSERT `סעיף 42 - רישום או קיום של מסמך כשלעצמו ראיה לידיעת תוכנו` EQUALS FALSE
-- 43.
#ASSERT `סעיף 43(א) - כל אדם רשאי לעיין במרשמים ולקבל העתקים מאושרים` TRUE EQUALS TRUE
#ASSERT `סעיף 43(א) - כל אדם רשאי לעיין במרשמים ולקבל העתקים מאושרים` FALSE EQUALS FALSE
