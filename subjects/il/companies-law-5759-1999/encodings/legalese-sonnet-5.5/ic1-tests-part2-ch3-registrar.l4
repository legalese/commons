#ASSERT `סעיף 43(ב) - פרט (2) לתוספת הרביעית פתוח לעיון גוף ציבורי השולח מסרים דיגיטליים בלבד` TRUE TRUE EQUALS TRUE
#ASSERT `סעיף 43(ב) - פרט (2) לתוספת הרביעית פתוח לעיון גוף ציבורי השולח מסרים דיגיטליים בלבד` TRUE FALSE EQUALS FALSE
#ASSERT `סעיף 43(ב) - פרט (2) לתוספת הרביעית פתוח לעיון גוף ציבורי השולח מסרים דיגיטליים בלבד` FALSE FALSE EQUALS TRUE
#ASSERT `סעיף 43(ב) - פרט (2) לתוספת הרביעית פתוח לעיון גוף ציבורי השולח מסרים דיגיטליים בלבד` FALSE TRUE EQUALS TRUE
