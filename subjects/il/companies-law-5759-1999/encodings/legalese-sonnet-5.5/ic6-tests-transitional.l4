#ASSERT `סעיף 367(א) - ההוראה בפקודת החברות נשארה בתוקף` (`הוראה בפקודת החברות` OF 115, FALSE, FALSE, TRUE, TRUE) (`מצב החברה לעניין סעיף 367` OF FALSE, FALSE, FALSE)
#ASSERT NOT (`סעיף 367(א) - ההוראה בפקודת החברות נשארה בתוקף` (`הוראה בפקודת החברות` OF 115, FALSE, FALSE, TRUE, FALSE) (`מצב החברה לעניין סעיף 367` OF FALSE, FALSE, FALSE))
-- (ב): interpreted in the light of this Law.
#ASSERT `סעיף 367(ב) - ההוראה שנשארה בתוקף תפורש לאור הוראות חוק זה` TRUE
#ASSERT NOT (`סעיף 367(ב) - ההוראה שנשארה בתוקף תפורש לאור הוראות חוק זה` FALSE)

§§ `סעיפים 368 ו־369`

-- 368(א): sections 23 to 29, 51, 58 and 91 of the Second Schedule, for a pre-commencement company to which they applied, articles not changed.
#ASSERT `סעיף 368(א) - ההוראה מהתוספת השנייה לפקודה נחשבת כאילו נכללה בתקנון` 23 TRUE TRUE TRUE
#ASSERT `סעיף 368(א) - ההוראה מהתוספת השנייה לפקודה נחשבת כאילו נכללה בתקנון` 29 TRUE TRUE TRUE
#ASSERT `סעיף 368(א) - ההוראה מהתוספת השנייה לפקודה נחשבת כאילו נכללה בתקנון` 51 TRUE TRUE TRUE
#ASSERT `סעיף 368(א) - ההוראה מהתוספת השנייה לפקודה נחשבת כאילו נכללה בתקנון` 58 TRUE TRUE TRUE
#ASSERT `סעיף 368(א) - ההוראה מהתוספת השנייה לפקודה נחשבת כאילו נכללה בתקנון` 91 TRUE TRUE TRUE
#ASSERT NOT (`סעיף 368(א) - ההוראה מהתוספת השנייה לפקודה נחשבת כאילו נכללה בתקנון` 22 TRUE TRUE TRUE)
#ASSERT NOT (`סעיף 368(א) - ההוראה מהתוספת השנייה לפקודה נחשבת כאילו נכללה בתקנון` 30 TRUE TRUE TRUE)
#ASSERT NOT (`סעיף 368(א) - ההוראה מהתוספת השנייה לפקודה נחשבת כאילו נכללה בתקנון` 52 TRUE TRUE TRUE)
#ASSERT NOT (`סעיף 368(א) - ההוראה מהתוספת השנייה לפקודה נחשבת כאילו נכללה בתקנון` 23 FALSE TRUE TRUE)
#ASSERT NOT (`סעיף 368(א) - ההוראה מהתוספת השנייה לפקודה נחשבת כאילו נכללה בתקנון` 23 TRUE FALSE TRUE)
#ASSERT NOT (`סעיף 368(א) - ההוראה מהתוספת השנייה לפקודה נחשבת כאילו נכללה בתקנון` 23 TRUE TRUE FALSE)
-- 368(ב): the chair has no casting vote unless the articles say otherwise, while the articles are not changed.
#ASSERT `סעיף 368(ב) - התקנון נחשב כאילו נקבע בו שליושב ראש הדירקטוריון אין קול נוסף` TRUE FALSE TRUE
#ASSERT NOT (`סעיף 368(ב) - התקנון נחשב כאילו נקבע בו שליושב ראש הדירקטוריון אין קול נוסף` TRUE TRUE TRUE)
#ASSERT NOT (`סעיף 368(ב) - התקנון נחשב כאילו נקבע בו שליושב ראש הדירקטוריון אין קול נוסף` FALSE FALSE TRUE)
#ASSERT NOT (`סעיף 368(ב) - התקנון נחשב כאילו נקבע בו שליושב ראש הדירקטוריון אין קול נוסף` TRUE FALSE FALSE)
-- 369(א).
#ASSERT `סעיף 369(א) - זכויות ההצבעה מהמניות שנרכשו לפני התחילה נשמרות` TRUE TRUE
#ASSERT NOT (`סעיף 369(א) - זכויות ההצבעה מהמניות שנרכשו לפני התחילה נשמרות` TRUE FALSE)
#ASSERT NOT (`סעיף 369(א) - זכויות ההצבעה מהמניות שנרכשו לפני התחילה נשמרות` FALSE TRUE)
-- 369(ב): 100 shares acquired before the Law, 50 after. If 30 are sold, the 30 are taken from the 50: all 100 remain. If 70 are sold, 50 from the later and 20 from the earlier: 80 remain.
-- If 200 are sold: none remain; if none are sold: all 100.
#ASSERT `סעיף 369(ב) - מספר המניות שנרכשו לפני התחילה ונותרו` 100 50 30 EQUALS 100
#ASSERT `סעיף 369(ב) - מספר המניות שנרכשו לפני התחילה ונותרו` 100 50 50 EQUALS 100
#ASSERT `סעיף 369(ב) - מספר המניות שנרכשו לפני התחילה ונותרו` 100 50 70 EQUALS 80
#ASSERT `סעיף 369(ב) - מספר המניות שנרכשו לפני התחילה ונותרו` 100 50 200 EQUALS 0
#ASSERT `סעיף 369(ב) - מספר המניות שנרכשו לפני התחילה ונותרו` 100 50 0 EQUALS 100
-- With none acquired afterwards, every sale comes out of the earlier shares.
#ASSERT `סעיף 369(ב) - מספר המניות שנרכשו לפני התחילה ונותרו` 100 0 30 EQUALS 70

