#ASSERT `סעיף 371 - מי שכיהן כמבקר פנימי רשאי להמשיך ולכהן` TRUE TRUE
#ASSERT NOT (`סעיף 371 - מי שכיהן כמבקר פנימי רשאי להמשיך ולכהן` TRUE FALSE)
#ASSERT NOT (`סעיף 371 - מי שכיהן כמבקר פנימי רשאי להמשיך ולכהן` FALSE TRUE)
#ASSERT `סעיף 372 - דירקטור מקרב הציבור נחשב דירקטור חיצוני` TRUE
#ASSERT NOT (`סעיף 372 - דירקטור מקרב הציבור נחשב דירקטור חיצוני` FALSE)
#ASSERT `סעיף 372 - משך הכהונה וחידושה של דירקטור מקרב הציבור נקבעים לפי הפקודה` TRUE
#ASSERT NOT (`סעיף 372 - משך הכהונה וחידושה של דירקטור מקרב הציבור נקבעים לפי הפקודה` FALSE)

§§ `סעיפים 377 ו־378: תחילה ופרסום`

-- The day of passing: 19 April 1999 (src:3549). The day of commencement: 1 February 2000 (src:3359).
#ASSERT `סעיף 378 - יום קבלת החוק בכנסת` EQUALS YearMonthDay 1999 4 19
#ASSERT `סעיף 377 - יום תחילתו של החוק` EQUALS YearMonthDay 2000 2 1
-- 378: 45 days from 19 April 1999 end on 3 June 1999. Published on 3 June: in time; on 4 June: late. (The Knesset record in SOURCES.md gives 27 May 1999 as the publication day: 38 days, in time.)
#ASSERT `סעיף 378 - החוק פורסם ברשומות בתוך 45 ימים מיום קבלתו בכנסת` (YearMonthDay 1999 6 3)
#ASSERT NOT (`סעיף 378 - החוק פורסם ברשומות בתוך 45 ימים מיום קבלתו בכנסת` (YearMonthDay 1999 6 4))
#ASSERT `סעיף 378 - החוק פורסם ברשומות בתוך 45 ימים מיום קבלתו בכנסת` (YearMonthDay 1999 5 27)
-- 377(1): sections 87 to 89 come in on the day the regulations set; until they are published, NOTHING.
#ASSERT `סעיף 377(1) - יום כניסתם לתוקף של סעיפים 87 עד 89` (JUST (YearMonthDay 2001 3 1)) EQUALS JUST (YearMonthDay 2001 3 1)
#ASSERT `סעיף 377(1) - יום כניסתם לתוקף של סעיפים 87 עד 89` NOTHING EQUALS NOTHING
-- 377(2): three years from the publication day (here 27 May 1999) end on 27 May 2002; an earlier day set by the Ministers is used if earlier; a later one is ignored; with no electronic-reporting provisions, NOTHING.
#ASSERT `סעיף 377(2) - יום כניסתם לתוקף של סעיפים 143 ו־145` (YearMonthDay 1999 5 27) NOTHING TRUE EQUALS JUST (YearMonthDay 2002 5 27)
#ASSERT `סעיף 377(2) - יום כניסתם לתוקף של סעיפים 143 ו־145` (YearMonthDay 1999 5 27) (JUST (YearMonthDay 2001 1 1)) TRUE EQUALS JUST (YearMonthDay 2001 1 1)
#ASSERT `סעיף 377(2) - יום כניסתם לתוקף של סעיפים 143 ו־145` (YearMonthDay 1999 5 27) (JUST (YearMonthDay 2003 1 1)) TRUE EQUALS JUST (YearMonthDay 2002 5 27)
#ASSERT `סעיף 377(2) - יום כניסתם לתוקף של סעיפים 143 ו־145` (YearMonthDay 1999 5 27) (JUST (YearMonthDay 2002 5 27)) TRUE EQUALS JUST (YearMonthDay 2002 5 27)
#ASSERT `סעיף 377(2) - יום כניסתם לתוקף של סעיפים 143 ו־145` (YearMonthDay 1999 5 27) NOTHING FALSE EQUALS NOTHING
#ASSERT `סעיף 377(2) - יום כניסתם לתוקף של סעיפים 143 ו־145` (YearMonthDay 1999 5 27) (JUST (YearMonthDay 2001 1 1)) FALSE EQUALS NOTHING
-- 377(3): follows 377(2).
#ASSERT `סעיף 377(3) - יום כניסתו לתוקף של סעיף 36(א1) לחוק ניירות ערך כנוסחו בסעיף 373` (JUST (YearMonthDay 2002 5 27)) EQUALS JUST (YearMonthDay 2002 5 27)
#ASSERT `סעיף 377(3) - יום כניסתו לתוקף של סעיף 36(א1) לחוק ניירות ערך כנוסחו בסעיף 373` NOTHING EQUALS NOTHING
-- The day a given section comes in: section 50 on 1 February 2000; sections 87 to 89 on the regulations' day; sections 143 and 145 on theirs.
#ASSERT `סעיף 377 - יום כניסתו לתוקף של הסעיף` 50 (JUST (YearMonthDay 2001 3 1)) (JUST (YearMonthDay 2002 5 27)) EQUALS JUST (YearMonthDay 2000 2 1)
#ASSERT `סעיף 377 - יום כניסתו לתוקף של הסעיף` 200 NOTHING NOTHING EQUALS JUST (YearMonthDay 2000 2 1)
#ASSERT `סעיף 377 - יום כניסתו לתוקף של הסעיף` 88 (JUST (YearMonthDay 2001 3 1)) (JUST (YearMonthDay 2002 5 27)) EQUALS JUST (YearMonthDay 2001 3 1)
#ASSERT `סעיף 377 - יום כניסתו לתוקף של הסעיף` 87 NOTHING (JUST (YearMonthDay 2002 5 27)) EQUALS NOTHING
#ASSERT `סעיף 377 - יום כניסתו לתוקף של הסעיף` 89 (JUST (YearMonthDay 2001 3 1)) NOTHING EQUALS JUST (YearMonthDay 2001 3 1)
#ASSERT `סעיף 377 - יום כניסתו לתוקף של הסעיף` 143 (JUST (YearMonthDay 2001 3 1)) (JUST (YearMonthDay 2002 5 27)) EQUALS JUST (YearMonthDay 2002 5 27)
#ASSERT `סעיף 377 - יום כניסתו לתוקף של הסעיף` 145 (JUST (YearMonthDay 2001 3 1)) NOTHING EQUALS NOTHING
#ASSERT `סעיף 377 - יום כניסתו לתוקף של הסעיף` 144 (JUST (YearMonthDay 2001 3 1)) NOTHING EQUALS JUST (YearMonthDay 2000 2 1)
#ASSERT `סעיף 377 - יום כניסתו לתוקף של הסעיף` 86 (JUST (YearMonthDay 2001 3 1)) NOTHING EQUALS JUST (YearMonthDay 2000 2 1)
#ASSERT `סעיף 377 - יום כניסתו לתוקף של הסעיף` 90 (JUST (YearMonthDay 2001 3 1)) NOTHING EQUALS JUST (YearMonthDay 2000 2 1)
