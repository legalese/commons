#ASSERT `סעיף 367(א) - ההוראה בפקודת החברות נשארה בתוקף` (`הוראה בפקודת החברות` OF 367, FALSE, FALSE, FALSE, FALSE) (`מצב החברה לעניין סעיף 367` OF FALSE, FALSE, FALSE)
#ASSERT NOT (`סעיף 367(א) - ההוראה בפקודת החברות נשארה בתוקף` (`הוראה בפקודת החברות` OF 243, FALSE, FALSE, FALSE, FALSE) (`מצב החברה לעניין סעיף 367` OF FALSE, FALSE, FALSE))
#ASSERT `סעיף 367(א) - ההוראה בפקודת החברות נשארה בתוקף` (`הוראה בפקודת החברות` OF 370, FALSE, FALSE, FALSE, FALSE) (`מצב החברה לעניין סעיף 367` OF FALSE, FALSE, FALSE)
#ASSERT `סעיף 367(א) - ההוראה בפקודת החברות נשארה בתוקף` (`הוראה בפקודת החברות` OF 382, FALSE, FALSE, FALSE, FALSE) (`מצב החברה לעניין סעיף 367` OF FALSE, FALSE, FALSE)
#ASSERT NOT (`סעיף 367(א) - ההוראה בפקודת החברות נשארה בתוקף` (`הוראה בפקודת החברות` OF 383, FALSE, FALSE, FALSE, FALSE) (`מצב החברה לעניין סעיף 367` OF FALSE, FALSE, FALSE))
-- Sections 368 and 369 are not in item (1): 368 goes; 369 stays only for a company deleted under 368 (item (3)).
#ASSERT NOT (`סעיף 367(א) - ההוראה בפקודת החברות נשארה בתוקף` (`הוראה בפקודת החברות` OF 368, FALSE, FALSE, FALSE, FALSE) (`מצב החברה לעניין סעיף 367` OF FALSE, TRUE, FALSE))
