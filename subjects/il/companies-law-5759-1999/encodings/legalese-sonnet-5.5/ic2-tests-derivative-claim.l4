IMPORT prelude
IMPORT `ic-core`
IMPORT `ic2-tests-fixtures`
IMPORT `ic2-p5c3-derivative-claim`

-- Tests of ic2-p5c3-derivative-claim.l4 (sections 194 to 218). Expected values are written from the text of the section named beside each.

§ `בדיקות: התביעה הנגזרת`

§§ `סעיף 194`

-- 194(א): a shareholder or a director may file.
#ASSERT `סעיף 194(א) - האדם הוא תובע שרשאי להגיש תביעה נגזרת` TRUE FALSE
#ASSERT `סעיף 194(א) - האדם הוא תובע שרשאי להגיש תביעה נגזרת` FALSE TRUE
#ASSERT NOT (`סעיף 194(א) - האדם הוא תובע שרשאי להגיש תביעה נגזרת` FALSE FALSE)
-- 194(ב), (ג): a written demand to the chairperson, with the facts and the reasons.
#ASSERT `סעיף 194(ב)-(ג) - הדרישה לחברה כשרה` TRUE TRUE TRUE TRUE
#ASSERT NOT (`סעיף 194(ב)-(ג) - הדרישה לחברה כשרה` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`סעיף 194(ב)-(ג) - הדרישה לחברה כשרה` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`סעיף 194(ב)-(ג) - הדרישה לחברה כשרה` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`סעיף 194(ב)-(ג) - הדרישה לחברה כשרה` TRUE TRUE TRUE FALSE)
-- 194(ד)(1): an organ of one individual with a personal interest; of four, two (half) is enough, one is not; none is not.
#ASSERT `סעיף 194(ד) - התובע פטור מהגשת דרישה לחברה` 1 1 FALSE
#ASSERT `סעיף 194(ד) - התובע פטור מהגשת דרישה לחברה` 4 2 FALSE
#ASSERT `סעיף 194(ד) - התובע פטור מהגשת דרישה לחברה` 4 3 FALSE
#ASSERT NOT (`סעיף 194(ד) - התובע פטור מהגשת דרישה לחברה` 4 1 FALSE)
#ASSERT NOT (`סעיף 194(ד) - התובע פטור מהגשת דרישה לחברה` 3 1 FALSE)
#ASSERT `סעיף 194(ד) - התובע פטור מהגשת דרישה לחברה` 3 2 FALSE
#ASSERT NOT (`סעיף 194(ד) - התובע פטור מהגשת דרישה לחברה` 1 0 FALSE)
-- 194(ד)(2): a reasonable concern that a demand would harm the remedy exempts him whatever the organ.
#ASSERT `סעיף 194(ד) - התובע פטור מהגשת דרישה לחברה` 4 0 TRUE

§§ `סעיפים 195 ו־196`

-- 195: the three ways to react; a rejection needs its reasons in the decision; another course is not one of them.
#ASSERT `סעיף 195 - החברה רשאית לנקוט בדרך` `פעולה או החלטה שהעילה נשמטת בעקבותיה` FALSE
#ASSERT `סעיף 195 - החברה רשאית לנקוט בדרך` `החלטה להגיש תביעה` FALSE
#ASSERT `סעיף 195 - החברה רשאית לנקוט בדרך` `דחיית הדרישה בנימוקים` TRUE
#ASSERT NOT (`סעיף 195 - החברה רשאית לנקוט בדרך` `דחיית הדרישה בנימוקים` FALSE)
#ASSERT NOT (`סעיף 195 - החברה רשאית לנקוט בדרך` `דרך תגובה אחרת של החברה לדרישה` TRUE)
-- 196: forty-five days, the forty-fifth day in time; the notice details the action and the organ, the names, and any personal interest.
#ASSERT `סעיף 196 - מספר הימים למענה לתובע` EQUALS 45
#ASSERT `סעיף 196 - המענה לתובע נמסר במועד` 45
#ASSERT NOT (`סעיף 196 - המענה לתובע נמסר במועד` 46)
#ASSERT `סעיף 196 - תוכן המענה לתובע עומד בדרישות` TRUE TRUE FALSE FALSE
#ASSERT `סעיף 196 - תוכן המענה לתובע עומד בדרישות` TRUE TRUE TRUE TRUE
#ASSERT NOT (`סעיף 196 - תוכן המענה לתובע עומד בדרישות` TRUE TRUE TRUE FALSE)
#ASSERT NOT (`סעיף 196 - תוכן המענה לתובע עומד בדרישות` FALSE TRUE FALSE FALSE)
#ASSERT NOT (`סעיף 196 - תוכן המענה לתובע עומד בדרישות` TRUE FALSE FALSE FALSE)

§§ `סעיפים 197 ו־198`

-- 197: the five routes: each alone suffices for a shareholder or director; the seventy-fifth day is still in time, the seventy-sixth is not.
#ASSERT `סעיף 197(3) - מספר הימים להגשת התביעה לאחר ההודעה על ההחלטה להגיש` EQUALS 75
#ASSERT `סעיף 197 - התובע רשאי להגיש תביעה נגזרת באישור בית המשפט` TRUE TRUE FALSE FALSE 0 FALSE FALSE
#ASSERT `סעיף 197 - התובע רשאי להגיש תביעה נגזרת באישור בית המשפט` TRUE FALSE TRUE FALSE 0 FALSE FALSE
#ASSERT `סעיף 197 - התובע רשאי להגיש תביעה נגזרת באישור בית המשפט` TRUE FALSE FALSE TRUE 76 FALSE FALSE
#ASSERT NOT (`סעיף 197 - התובע רשאי להגיש תביעה נגזרת באישור בית המשפט` TRUE FALSE FALSE TRUE 75 FALSE FALSE)
#ASSERT `סעיף 197 - התובע רשאי להגיש תביעה נגזרת באישור בית המשפט` TRUE FALSE FALSE FALSE 0 TRUE FALSE
#ASSERT `סעיף 197 - התובע רשאי להגיש תביעה נגזרת באישור בית המשפט` TRUE FALSE FALSE FALSE 0 FALSE TRUE
#ASSERT NOT (`סעיף 197 - התובע רשאי להגיש תביעה נגזרת באישור בית המשפט` TRUE FALSE FALSE FALSE 0 FALSE FALSE)
#ASSERT NOT (`סעיף 197 - התובע רשאי להגיש תביעה נגזרת באישור בית המשפט` FALSE TRUE TRUE TRUE 100 TRUE TRUE)
-- 198(א): the court approves if convinced the claim is, prima facie, for the company's benefit and the plaintiff acts in good faith.
#ASSERT `סעיף 198(א) - בית המשפט יאשר את התביעה הנגזרת` TRUE TRUE
#ASSERT NOT (`סעיף 198(א) - בית המשפט יאשר את התביעה הנגזרת` FALSE TRUE)
#ASSERT NOT (`סעיף 198(א) - בית המשפט יאשר את התביעה הנגזרת` TRUE FALSE)
-- 198(ב): an early claim may be approved if waiting would cause prescription.
#ASSERT `סעיף 198(ב) - בית המשפט רשאי לאשר תביעה שהוגשה לפני המועדים` TRUE TRUE
#ASSERT NOT (`סעיף 198(ב) - בית המשפט רשאי לאשר תביעה שהוגשה לפני המועדים` TRUE FALSE)
#ASSERT NOT (`סעיף 198(ב) - בית המשפט רשאי לאשר תביעה שהוגשה לפני המועדים` FALSE TRUE)
-- 198א: a request for disclosure of documents, and its approval on a preliminary evidentiary basis.
#ASSERT `סעיף 198א(א) - המבקש רשאי לבקש מבית המשפט להורות לחברה לגלות מסמכים` TRUE
#ASSERT NOT (`סעיף 198א(א) - המבקש רשאי לבקש מבית המשפט להורות לחברה לגלות מסמכים` FALSE)
#ASSERT `סעיף 198א(ב) - בית המשפט רשאי לאשר את בקשת הגילוי` TRUE
#ASSERT NOT (`סעיף 198א(ב) - בית המשפט רשאי לאשר את בקשת הגילוי` FALSE)

§§ `סעיפים 199 עד 202`

-- 199(א): the plaintiff pays only the part the Minister set (a tenth of 10,000 is 1,000); with no rate supplied the answer is NOTHING.
#ASSERT `סעיף 199(א) - האגרה שהתובע משלם בעת הגשת התביעה` 10_000 (JUST 0.1) EQUALS JUST 1_000
#ASSERT `סעיף 199(א) - האגרה שהתובע משלם בעת הגשת התביעה` 10_000 NOTHING EQUALS NOTHING
-- 199(ב): after approval the company refunds the fee and pays the balance; non-payment of the balance does not delay the hearing; the court may order expenses and security.
#ASSERT `סעיף 199(ב) - החברה חייבת להשיב לתובע את האגרה ששילם ולשלם את יתרת האגרה` TRUE
#ASSERT NOT (`סעיף 199(ב) - החברה חייבת להשיב לתובע את האגרה ששילם ולשלם את יתרת האגרה` FALSE)
#ASSERT NOT (`סעיף 199(ב) - אי תשלום יתרת האגרה מעכב את הדיון בתביעה`)
#ASSERT `סעיף 199(ב)(2) - בית המשפט רשאי להורות לחברה לשלם לתובע סכומים לכיסוי הוצאותיו או להפקיד ערובה` TRUE
#ASSERT NOT (`סעיף 199(ב)(2) - בית המשפט רשאי להורות לחברה לשלם לתובע סכומים לכיסוי הוצאותיו או להפקיד ערובה` FALSE)
#ASSERT `סעיף 199(ב)(3) - בית המשפט רשאי להטיל על החברה להפקיד ערובה לכיסוי הוצאות הנתבע` TRUE
#ASSERT NOT (`סעיף 199(ב)(3) - בית המשפט רשאי להטיל על החברה להפקיד ערובה לכיסוי הוצאות הנתבע` FALSE)
-- 200: the company pays the defendant's costs unless the court, for recorded special reasons, put them on the plaintiff; both further powers.
#ASSERT `סעיף 200 - החברה משלמת את ההוצאות שנפסקו לטובת הנתבע` FALSE
#ASSERT NOT (`סעיף 200 - החברה משלמת את ההוצאות שנפסקו לטובת הנתבע` TRUE)
#ASSERT `סעיף 200 - בית המשפט רשאי להטיל על החברה את תשלום הוצאותיו של התובע`
#ASSERT `סעיף 200 - בית המשפט רשאי להטיל על התובע תשלום הוצאות שנגרמו לחברה`
-- 200א: the lawyer's fee is capped by what the court set; the company pays it unless the court, for recorded special reasons, put it on the plaintiff.
#ASSERT `סעיף 200א(א) - שכר הטרחה שעורך הדין מקבל אינו עולה על שנקבע` 5_000 5_000
-- the arguments are: the fee the court set, then the fee the lawyer receives.
#ASSERT NOT (`סעיף 200א(א) - שכר הטרחה שעורך הדין מקבל אינו עולה על שנקבע` 5_000 5_001)
#ASSERT `סעיף 200א(א) - שכר הטרחה שעורך הדין מקבל אינו עולה על שנקבע` 5_000 4_000
#ASSERT `סעיף 200א(ב) - החברה משלמת את שכר הטרחה` FALSE
#ASSERT NOT (`סעיף 200א(ב) - החברה משלמת את שכר הטרחה` TRUE)
-- 201: a reward to a plaintiff who took trouble, if the court ruled for the company.
#ASSERT `סעיף 201 - בית המשפט רשאי להורות על תשלום גמול לתובע` TRUE TRUE
#ASSERT NOT (`סעיף 201 - בית המשפט רשאי להורות על תשלום גמול לתובע` FALSE TRUE)
#ASSERT NOT (`סעיף 201 - בית המשפט רשאי להורות על תשלום גמול לתובע` TRUE FALSE)
-- 202: no withdrawal or settlement without the court's approval; publication; who may object.
#ASSERT `סעיף 202(א) - ההסתלקות מהתביעה הנגזרת או ההסדר עם הנתבע מותרים` TRUE
#ASSERT NOT (`סעיף 202(א) - ההסתלקות מהתביעה הנגזרת או ההסדר עם הנתבע מותרים` FALSE)
#ASSERT `סעיף 202(א) - בקשת האישור כוללת את הפרטים הנדרשים` TRUE TRUE
#ASSERT NOT (`סעיף 202(א) - בקשת האישור כוללת את הפרטים הנדרשים` TRUE FALSE)
#ASSERT NOT (`סעיף 202(א) - בקשת האישור כוללת את הפרטים הנדרשים` FALSE TRUE)
#ASSERT `סעיף 202(ב) - בית המשפט חייב להורות על פרסום הודעה על פרטי ההסדר` TRUE
#ASSERT NOT (`סעיף 202(ב) - בית המשפט חייב להורות על פרסום הודעה על פרטי ההסדר` FALSE)
#ASSERT `סעיף 202(ב) - האדם רשאי להגיש התנגדות לאישור ההסדר או הפשרה` TRUE FALSE FALSE
#ASSERT `סעיף 202(ב) - האדם רשאי להגיש התנגדות לאישור ההסדר או הפשרה` FALSE TRUE FALSE
#ASSERT `סעיף 202(ב) - האדם רשאי להגיש התנגדות לאישור ההסדר או הפשרה` FALSE FALSE TRUE
#ASSERT NOT (`סעיף 202(ב) - האדם רשאי להגיש התנגדות לאישור ההסדר או הפשרה` FALSE FALSE FALSE)

§§ `סעיפים 203 עד 206`

-- 203(א): a derivative defence needs a claim against the company, a shareholder or director, the court's conviction of benefit and of good faith.
#ASSERT `סעיף 203(א) - בית המשפט רשאי להתיר הגנה נגזרת` TRUE TRUE TRUE TRUE
#ASSERT NOT (`סעיף 203(א) - בית המשפט רשאי להתיר הגנה נגזרת` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`סעיף 203(א) - בית המשפט רשאי להתיר הגנה נגזרת` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`סעיף 203(א) - בית המשפט רשאי להתיר הגנה נגזרת` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`סעיף 203(א) - בית המשפט רשאי להתיר הגנה נגזרת` TRUE TRUE TRUE FALSE)
-- 203(ב): the claim provisions apply to the defence unless the Minister set others.
#ASSERT `סעיף 203(ב) - הוראות התביעה הנגזרת חלות על הגנה נגזרת` FALSE
#ASSERT NOT (`סעיף 203(ב) - הוראות התביעה הנגזרת חלות על הגנה נגזרת` TRUE)
-- 204: a creditor may sue for a forbidden distribution; a bondholder in a bond company also for non-compliance with 275(ג),(ד).
#ASSERT `סעיף 204 - הנושה רשאי להגיש תביעה נגזרת בשם החברה` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` TRUE TRUE FALSE FALSE
#ASSERT NOT (`סעיף 204 - הנושה רשאי להגיש תביעה נגזרת בשם החברה` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` TRUE FALSE FALSE FALSE)
#ASSERT `סעיף 204 - הנושה רשאי להגיש תביעה נגזרת בשם החברה` `דוגמה - חברה פרטית שהיא חברת איגרות חוב ואינה תאגיד מדווח` TRUE FALSE TRUE TRUE
#ASSERT NOT (`סעיף 204 - הנושה רשאי להגיש תביעה נגזרת בשם החברה` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`סעיף 204 - הנושה רשאי להגיש תביעה נגזרת בשם החברה` `דוגמה - חברה פרטית שהיא חברת איגרות חוב ואינה תאגיד מדווח` TRUE FALSE FALSE TRUE)
#ASSERT NOT (`סעיף 204 - הנושה רשאי להגיש תביעה נגזרת בשם החברה` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` FALSE TRUE FALSE FALSE)
-- 205: no derivative claim or defence for a company with a trustee appointed.
#ASSERT `סעיף 205 - אסור להגיש תביעה נגזרת או הגנה נגזרת בשם החברה` TRUE FALSE
#ASSERT `סעיף 205 - אסור להגיש תביעה נגזרת או הגנה נגזרת בשם החברה` FALSE TRUE
#ASSERT NOT (`סעיף 205 - אסור להגיש תביעה נגזרת או הגנה נגזרת בשם החברה` FALSE FALSE)
-- 205א: a reporting corporation's claim may seek the Authority's participation in expenses, if convinced of public interest and a reasonable chance of approval.
#ASSERT `סעיף 205א(א) - המבקש רשאי לבקש מרשות ניירות ערך להשתתף בהוצאותיו` `דוגמה - חברה ציבורית שהיא תאגיד מדווח`
#ASSERT NOT (`סעיף 205א(א) - המבקש רשאי לבקש מרשות ניירות ערך להשתתף בהוצאותיו` `דוגמה - חברה פרטית שאינה חברת איגרות חוב`)
#ASSERT `סעיף 205א(ב) - רשות ניירות ערך רשאית להשתתף בהוצאות התובע` TRUE TRUE
#ASSERT NOT (`סעיף 205א(ב) - רשות ניירות ערך רשאית להשתתף בהוצאות התובע` TRUE FALSE)
#ASSERT NOT (`סעיף 205א(ב) - רשות ניירות ערך רשאית להשתתף בהוצאות התובע` FALSE TRUE)
#ASSERT NOT (`סעיף 205א(ב) - החלטת הרשות ניתנת להגשה לבית המשפט כראיה`)
#ASSERT `סעיף 205א(ג) - בית המשפט רשאי להורות על שיפוי הרשות בשל הוצאותיה` TRUE
#ASSERT NOT (`סעיף 205א(ג) - בית המשפט רשאי להורות על שיפוי הרשות בשל הוצאותיה` FALSE)
