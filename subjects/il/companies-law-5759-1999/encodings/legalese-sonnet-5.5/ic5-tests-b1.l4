IMPORT prelude
IMPORT daydate
IMPORT `ic-core`
IMPORT `ic5-b1-fund-status`

-- ic5-tests-b1: tests of ic5-b1-fund-status (sections 345לד to 345לח).
-- Every expected value below was decided from the section named beside it, before the run.

§ `בדיקות – סעיפים 345לד עד 345לח`

§§ `345לד – קרן לתועלת הציבור`

-- 345לד(א): a fund is a recognised public-benefit company whose articles set only permitted financing purposes.
#ASSERT `סעיף 345לד(א) - קרן לתועלת הציבור` TRUE TRUE TRUE
#ASSERT NOT (`סעיף 345לד(א) - קרן לתועלת הציבור` FALSE TRUE TRUE)
#ASSERT NOT (`סעיף 345לד(א) - קרן לתועלת הציבור` TRUE FALSE TRUE)
#ASSERT NOT (`סעיף 345לד(א) - קרן לתועלת הציבור` TRUE TRUE FALSE)
-- 345לד(א)(1) to (5): each of the five kinds of body, when it fits its description, is a permitted purpose; another kind is not.
#ASSERT `סעיף 345לד(א) - המימון הוא מטרה מותרת לקרן` `חברה לתועלת הציבור או הקדש ציבורי שנרשמו אצל רשם ההקדשות` TRUE
#ASSERT `סעיף 345לד(א) - המימון הוא מטרה מותרת לקרן` `עמותה שמטרותיה מטרות ציבוריות בלבד` TRUE
#ASSERT `סעיף 345לד(א) - המימון הוא מטרה מותרת לקרן` `מוסד להשכלה גבוהה` TRUE
#ASSERT `סעיף 345לד(א) - המימון הוא מטרה מותרת לקרן` `קופת חולים או בית חולים` TRUE
#ASSERT `סעיף 345לד(א) - המימון הוא מטרה מותרת לקרן` `גוף אחר שפעילותו מכוונת לקידום או למימון מטרות ציבוריות` TRUE
#ASSERT NOT (`סעיף 345לד(א) - המימון הוא מטרה מותרת לקרן` `גוף אחר שסעיף 345לד אינו מונה` TRUE)
#ASSERT NOT (`סעיף 345לד(א) - המימון הוא מטרה מותרת לקרן` `מוסד להשכלה גבוהה` FALSE)
-- 345לד(ב): "financing" includes oversight and accompaniment.
#ASSERT `סעיף 345לד(ב) - הפעולה היא מימון` TRUE FALSE FALSE
#ASSERT `סעיף 345לד(ב) - הפעולה היא מימון` FALSE TRUE FALSE
#ASSERT `סעיף 345לד(ב) - הפעולה היא מימון` FALSE FALSE TRUE
#ASSERT NOT (`סעיף 345לד(ב) - הפעולה היא מימון` FALSE FALSE FALSE)

§§ `345לה – הכרה בקרן`

-- 345לה(ב): liquid equity is money plus securities registered for trading.
#ASSERT `סעיף 345לה(ב) - הון עצמי נזיל` 3_000_000 2_000_000 EQUALS 5_000_000
#ASSERT `סעיף 345לה(ב) - הון עצמי נזיל` 0 0 EQUALS 0
-- 345לה(א): args: kind, public-benefit company, requested, shown to his satisfaction, liquid equity, donors since registration, someone holds control.
#ASSERT `סעיף 345לה(א) - רשם ההקדשות רשאי להכיר בחברה כקרן מהסוג` `קרן משפחתית לתועלת הציבור` TRUE TRUE TRUE 5_000_000 20 FALSE
#ASSERT NOT (`סעיף 345לה(א) - רשם ההקדשות רשאי להכיר בחברה כקרן מהסוג` `קרן משפחתית לתועלת הציבור` TRUE TRUE TRUE 4_999_999 20 FALSE)
#ASSERT NOT (`סעיף 345לה(א) - רשם ההקדשות רשאי להכיר בחברה כקרן מהסוג` `קרן משפחתית לתועלת הציבור` TRUE TRUE TRUE 5_000_000 21 FALSE)
#ASSERT `סעיף 345לה(א) - רשם ההקדשות רשאי להכיר בחברה כקרן מהסוג` `קרן משפחתית לתועלת הציבור` TRUE TRUE TRUE 9_000_000 20 TRUE
#ASSERT `סעיף 345לה(א) - רשם ההקדשות רשאי להכיר בחברה כקרן מהסוג` `קרן בניהול פרטי לתועלת הציבור` TRUE TRUE TRUE 5_000_000 20 TRUE
#ASSERT NOT (`סעיף 345לה(א) - רשם ההקדשות רשאי להכיר בחברה כקרן מהסוג` `קרן בניהול פרטי לתועלת הציבור` TRUE TRUE TRUE 5_000_000 21 FALSE)
#ASSERT `סעיף 345לה(א) - רשם ההקדשות רשאי להכיר בחברה כקרן מהסוג` `קרן בניהול ציבורי לתועלת הציבור` TRUE TRUE TRUE 5_000_000 500 FALSE
#ASSERT NOT (`סעיף 345לה(א) - רשם ההקדשות רשאי להכיר בחברה כקרן מהסוג` `קרן בניהול ציבורי לתועלת הציבור` TRUE TRUE TRUE 5_000_000 5 TRUE)
#ASSERT NOT (`סעיף 345לה(א) - רשם ההקדשות רשאי להכיר בחברה כקרן מהסוג` `קרן בניהול ציבורי לתועלת הציבור` FALSE TRUE TRUE 5_000_000 5 FALSE)
#ASSERT NOT (`סעיף 345לה(א) - רשם ההקדשות רשאי להכיר בחברה כקרן מהסוג` `קרן בניהול ציבורי לתועלת הציבור` TRUE FALSE TRUE 5_000_000 5 FALSE)
#ASSERT NOT (`סעיף 345לה(א) - רשם ההקדשות רשאי להכיר בחברה כקרן מהסוג` `קרן בניהול ציבורי לתועלת הציבור` TRUE TRUE FALSE 5_000_000 5 FALSE)

§§ `345לו – עדכון סכומים`

-- 345לו(א): the Minister may update the amounts only if the Index rose by more than 10 percent (exactly 10 percent is not more).
#ASSERT `סעיף 345לו(א) - השר רשאי לעדכן את הסכומים` 0.11
#ASSERT `סעיף 345לו(א) - השר רשאי לעדכן את הסכומים` 0.1001
#ASSERT NOT (`סעיף 345לו(א) - השר רשאי לעדכן את הסכומים` 0.1)
#ASSERT NOT (`סעיף 345לו(א) - השר רשאי לעדכן את הסכומים` 0.05)
-- 345לו(ב): rounded to the nearest multiple of NIS 1,000 (a half is rounded up: fork F19).
#ASSERT `סעיף 345לו(ב) - הסכום המעודכן לאחר עיגול` 123_456 EQUALS 123_000
#ASSERT `סעיף 345לו(ב) - הסכום המעודכן לאחר עיגול` 123_499 EQUALS 123_000
#ASSERT `סעיף 345לו(ב) - הסכום המעודכן לאחר עיגול` 123_500 EQUALS 124_000
#ASSERT `סעיף 345לו(ב) - הסכום המעודכן לאחר עיגול` 5_000_000 EQUALS 5_000_000
#ASSERT `סעיף 345לו(ב) - הסכום המעודכן לאחר עיגול` 0 EQUALS 0

§§ `345לז – תרומות`

-- 345לז(א): a family fund has at most twenty donors, not counting a deceased donor or one dependent on a donor.
#ASSERT `סעיף 345לז(א) - מניין התורמים המרבי לקרן משפחתית` EQUALS 20
#ASSERT `סעיף 345לז(א) - מניין התורמים לקרן משפחתית כשר` 25 3 2
#ASSERT `סעיף 345לז(א) - מניין התורמים לקרן משפחתית כשר` 20 0 0
#ASSERT NOT (`סעיף 345לז(א) - מניין התורמים לקרן משפחתית כשר` 26 3 2)
#ASSERT NOT (`סעיף 345לז(א) - מניין התורמים לקרן משפחתית כשר` 21 0 0)
-- 345לז(ב): a privately managed fund has at most twenty donors in a financial year, and takes from one donor donations worth at least NIS 20,000 (exactly 20,000 allowed).
#ASSERT `סעיף 345לז(ב) - מניין התורמים המרבי לקרן בניהול פרטי` EQUALS 20
#ASSERT `סעיף 345לז(ב) - מניין התורמים בשנת כספים לקרן בניהול פרטי כשר` 20
#ASSERT NOT (`סעיף 345לז(ב) - מניין התורמים בשנת כספים לקרן בניהול פרטי כשר` 21)
#ASSERT `סעיף 345לז(ב) - הקרן רשאית לקבל מתורם אחד תרומות בשווי זה` 20_000
#ASSERT `סעיף 345לז(ב) - הקרן רשאית לקבל מתורם אחד תרומות בשווי זה` 1_000_000
#ASSERT NOT (`סעיף 345לז(ב) - הקרן רשאית לקבל מתורם אחד תרומות בשווי זה` 19_999)

§§ `345לח – קבלת נכס כתרומה`

-- 345לח(א)(1): sold within two years of the end of the financial year in which it was received: year end 31 December 2025 gives 31 December 2027.
#ASSERT `סעיף 345לח(א)(1) - המועד האחרון למכירת הנכס בתקופה הראשונה` (YearMonthDay 2025 12 31) EQUALS YearMonthDay 2027 12 31
-- 345לח(א)(2)(א): the board may extend by up to two years, if persuaded, with reasons in the minutes.
#ASSERT `סעיף 345לח(א)(2)(א) - הדירקטוריון רשאי להאריך את התקופה` TRUE TRUE 2
#ASSERT `סעיף 345לח(א)(2)(א) - הדירקטוריון רשאי להאריך את התקופה` TRUE TRUE 1
#ASSERT NOT (`סעיף 345לח(א)(2)(א) - הדירקטוריון רשאי להאריך את התקופה` TRUE TRUE 3)
#ASSERT NOT (`סעיף 345לח(א)(2)(א) - הדירקטוריון רשאי להאריך את התקופה` TRUE TRUE 0)
#ASSERT NOT (`סעיף 345לח(א)(2)(א) - הדירקטוריון רשאי להאריך את התקופה` FALSE TRUE 2)
#ASSERT NOT (`סעיף 345לח(א)(2)(א) - הדירקטוריון רשאי להאריך את התקופה` TRUE FALSE 2)
#ASSERT `סעיף 345לח(א)(2)(א) - המועד האחרון למכירת הנכס לאחר הארכה` (YearMonthDay 2025 12 31) 2 EQUALS (JUST (YearMonthDay 2029 12 31))
#ASSERT `סעיף 345לח(א)(2)(א) - המועד האחרון למכירת הנכס לאחר הארכה` (YearMonthDay 2025 12 31) 1 EQUALS (JUST (YearMonthDay 2028 12 31))
#ASSERT `סעיף 345לח(א)(2)(א) - המועד האחרון למכירת הנכס לאחר הארכה` (YearMonthDay 2025 12 31) 3 EQUALS NOTHING
#ASSERT `סעיף 345לח(א)(2)(א) - המועד האחרון למכירת הנכס לאחר הארכה` (YearMonthDay 2025 12 31) 0 EQUALS NOTHING
-- 345לח(א)(2)(ב): in the additional period the asset counts at double its appraisal.
#ASSERT `סעיף 345לח(א)(2)(ב) - ערך הנכס בתקופה הנוספת` 1_000_000 EQUALS 2_000_000
-- 345לח(א)(3): a gift of the asset to a body the fund may finance counts toward the minimum distribution, with an appraisal, or without if not needed or the Registrar of Endowments approved.
#ASSERT `סעיף 345לח(א)(3) - ההעברה נחשבת חלק מהחלוקה המזערית` TRUE TRUE FALSE FALSE
#ASSERT `סעיף 345לח(א)(3) - ההעברה נחשבת חלק מהחלוקה המזערית` TRUE FALSE TRUE FALSE
#ASSERT `סעיף 345לח(א)(3) - ההעברה נחשבת חלק מהחלוקה המזערית` TRUE FALSE FALSE TRUE
#ASSERT NOT (`סעיף 345לח(א)(3) - ההעברה נחשבת חלק מהחלוקה המזערית` TRUE FALSE FALSE FALSE)
#ASSERT NOT (`סעיף 345לח(א)(3) - ההעברה נחשבת חלק מהחלוקה המזערית` FALSE TRUE TRUE TRUE)
-- 345לח(ב), (ג).
#ASSERT `סעיף 345לח(ב) - הנכס נחשב נכס שנתרם לקרן במועד ההכרה` TRUE
#ASSERT NOT (`סעיף 345לח(ב) - הנכס נחשב נכס שנתרם לקרן במועד ההכרה` FALSE)
#ASSERT `סעיף 345לח(ג) - סעיף 345לח אינו חל על הנכס` TRUE
#ASSERT NOT (`סעיף 345לח(ג) - סעיף 345לח אינו חל על הנכס` FALSE)
-- The value that counts for the fund's asset value (args: used and needed, sold, in the additional period, in the first period, value, appraisal).
#ASSERT `סעיף 345לח - הערך שנחשב לנכס שהתקבל כתרומה לענין שווי נכסי הקרן` TRUE FALSE FALSE FALSE 500 300 EQUALS (JUST 500)
#ASSERT `סעיף 345לח - הערך שנחשב לנכס שהתקבל כתרומה לענין שווי נכסי הקרן` FALSE TRUE FALSE FALSE 500 300 EQUALS (JUST 500)
#ASSERT `סעיף 345לח - הערך שנחשב לנכס שהתקבל כתרומה לענין שווי נכסי הקרן` FALSE FALSE TRUE FALSE 500 300 EQUALS (JUST 600)
#ASSERT `סעיף 345לח - הערך שנחשב לנכס שהתקבל כתרומה לענין שווי נכסי הקרן` FALSE FALSE FALSE TRUE 500 300 EQUALS (JUST 0)
#ASSERT `סעיף 345לח - הערך שנחשב לנכס שהתקבל כתרומה לענין שווי נכסי הקרן` FALSE FALSE FALSE FALSE 500 300 EQUALS NOTHING
-- 345לח(ד): a qualified person: the board found him expert, and for real estate a registered appraiser; otherwise the Minister's conditions, if he set any.
#ASSERT `סעיף 345לח(ד) - גורם מוסמך` TRUE TRUE FALSE FALSE TRUE
#ASSERT NOT (`סעיף 345לח(ד) - גורם מוסמך` TRUE TRUE FALSE FALSE FALSE)
#ASSERT `סעיף 345לח(ד) - גורם מוסמך` TRUE FALSE TRUE TRUE FALSE
#ASSERT NOT (`סעיף 345לח(ד) - גורם מוסמך` TRUE FALSE TRUE FALSE FALSE)
#ASSERT `סעיף 345לח(ד) - גורם מוסמך` TRUE FALSE FALSE FALSE FALSE
#ASSERT NOT (`סעיף 345לח(ד) - גורם מוסמך` FALSE TRUE FALSE FALSE TRUE)
#ASSERT `סעיף 345לח(ד) - נכס` FALSE
#ASSERT NOT (`סעיף 345לח(ד) - נכס` TRUE)
