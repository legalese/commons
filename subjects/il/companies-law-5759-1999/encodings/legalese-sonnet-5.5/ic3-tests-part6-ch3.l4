#ASSERT NOT (`סעיף 260(א)(1) - חבות כספית שהוטלה לטובת אדם אחר על פי פסק דין` FALSE FALSE FALSE)
-- Paragraph (1א): expenses of an investigation or proceeding that ended without an indictment.
-- Arguments: reasonable expenses; ended without an indictment; a financial liability as an alternative; for an offence that needs no criminal intent or a financial sanction.
#ASSERT `סעיף 260(א)(1א) - הוצאות התדיינות בשל חקירה או הליך שהסתיימו בלא כתב אישום` TRUE TRUE FALSE FALSE
#ASSERT `סעיף 260(א)(1א) - הוצאות התדיינות בשל חקירה או הליך שהסתיימו בלא כתב אישום` TRUE TRUE TRUE TRUE
#ASSERT NOT (`סעיף 260(א)(1א) - הוצאות התדיינות בשל חקירה או הליך שהסתיימו בלא כתב אישום` TRUE TRUE TRUE FALSE)
#ASSERT NOT (`סעיף 260(א)(1א) - הוצאות התדיינות בשל חקירה או הליך שהסתיימו בלא כתב אישום` TRUE FALSE FALSE FALSE)
#ASSERT NOT (`סעיף 260(א)(1א) - הוצאות התדיינות בשל חקירה או הליך שהסתיימו בלא כתב אישום` FALSE TRUE FALSE FALSE)
