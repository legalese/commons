#ASSERT NOT (`סעיף 260(א)(2) - הוצאות התדיינות בהליך או באישום פלילי` FALSE TRUE TRUE TRUE)
-- (ב)(1)(א): the limits an advance undertaking must have for a liability of paragraph (1).
#ASSERT `סעיף 260(ב)(1)(א) - התחייבות מראש לשיפוי בשל חבות כספית מותרת` TRUE TRUE TRUE
#ASSERT NOT (`סעיף 260(ב)(1)(א) - התחייבות מראש לשיפוי בשל חבות כספית מותרת` FALSE TRUE TRUE)
#ASSERT NOT (`סעיף 260(ב)(1)(א) - התחייבות מראש לשיפוי בשל חבות כספית מותרת` TRUE FALSE TRUE)
#ASSERT NOT (`סעיף 260(ב)(1)(א) - התחייבות מראש לשיפוי בשל חבות כספית מותרת` TRUE TRUE FALSE)
-- Section 260(א) as a whole. Arguments: the articles permit an advance undertaking; the undertaking meets (ב)(1)(א); the articles permit
-- indemnification in retrospect; the liability or expense is from an act done as an office-holder; paragraphs (1), (1א), (2).
-- A paragraph (1) liability under an advance undertaking that meets the limits.
#ASSERT `סעיף 260 - החברה רשאית לשפות נושא משרה` TRUE TRUE FALSE TRUE TRUE FALSE FALSE
-- ... but an advance undertaking for paragraph (1) that lacks the limits is not allowed.
#ASSERT NOT (`סעיף 260 - החברה רשאית לשפות נושא משרה` TRUE FALSE FALSE TRUE TRUE FALSE FALSE)
-- Paragraphs (1א) and (2) by an advance undertaking need no such limits.
#ASSERT `סעיף 260 - החברה רשאית לשפות נושא משרה` TRUE FALSE FALSE TRUE FALSE TRUE FALSE
#ASSERT `סעיף 260 - החברה רשאית לשפות נושא משרה` TRUE FALSE FALSE TRUE FALSE FALSE TRUE
-- A retrospective permit: any paragraph, no limits.
#ASSERT `סעיף 260 - החברה רשאית לשפות נושא משרה` FALSE FALSE TRUE TRUE TRUE FALSE FALSE
-- The articles have no such provision: not allowed.
#ASSERT NOT (`סעיף 260 - החברה רשאית לשפות נושא משרה` FALSE FALSE FALSE TRUE TRUE FALSE FALSE)
-- Not from an act done as an office-holder.
#ASSERT NOT (`סעיף 260 - החברה רשאית לשפות נושא משרה` TRUE TRUE TRUE FALSE TRUE FALSE FALSE)
-- None of the three paragraphs.
#ASSERT NOT (`סעיף 260 - החברה רשאית לשפות נושא משרה` TRUE TRUE TRUE TRUE FALSE FALSE FALSE)

§§ `סעיף 261: ביטוח אחריות`

#ASSERT `סעיף 261(2) - הפרת אמונים שניתן לבטח` TRUE TRUE
#ASSERT NOT (`סעיף 261(2) - הפרת אמונים שניתן לבטח` TRUE FALSE)
#ASSERT NOT (`סעיף 261(2) - הפרת אמונים שניתן לבטח` FALSE TRUE)
-- Insurance: the articles provide, the liability is from an act as an office-holder, and one of the limbs.
#ASSERT `סעיף 261 - החברה רשאית להתקשר בחוזה לביטוח אחריותו של נושא משרה` TRUE TRUE (`ic3 - חבות: רשלנות בחובת הזהירות כלפי החברה`)
#ASSERT `סעיף 261 - החברה רשאית להתקשר בחוזה לביטוח אחריותו של נושא משרה` TRUE TRUE (`ic3 - חבות: זהירות כלפי אדם אחר`)
#ASSERT `סעיף 261 - החברה רשאית להתקשר בחוזה לביטוח אחריותו של נושא משרה` TRUE TRUE (`ic3 - חבות: חובת אמונים בתום לב`)
#ASSERT `סעיף 261 - החברה רשאית להתקשר בחוזה לביטוח אחריותו של נושא משרה` TRUE TRUE (`ic3 - חבות: חבות כספית לטובת אדם אחר`)
-- A breach of loyalty not in good faith, with no other limb: not insurable.
#ASSERT NOT (`סעיף 261 - החברה רשאית להתקשר בחוזה לביטוח אחריותו של נושא משרה` TRUE TRUE (`ic3 - חבות: חובת אמונים שלא בתום לב`))
#ASSERT NOT (`סעיף 261 - החברה רשאית להתקשר בחוזה לביטוח אחריותו של נושא משרה` FALSE TRUE (`ic3 - חבות: רשלנות בחובת הזהירות כלפי החברה`))
#ASSERT NOT (`סעיף 261 - החברה רשאית להתקשר בחוזה לביטוח אחריותו של נושא משרה` TRUE FALSE (`ic3 - חבות: רשלנות בחובת הזהירות כלפי החברה`))

§§ `סעיף 262: שינוי התקנון`

-- (א): a private company whose shares are divided into classes.
#ASSERT `סעיף 262(א) - ההחלטה לכלול בתקנון הוראה על פטור או שיפוי טעונה גם אישור אסיפות סוג` `ic3 - חברה פרטית רגילה לדוגמה` TRUE
#ASSERT NOT (`סעיף 262(א) - ההחלטה לכלול בתקנון הוראה על פטור או שיפוי טעונה גם אישור אסיפות סוג` `ic3 - חברה פרטית רגילה לדוגמה` FALSE)
#ASSERT NOT (`סעיף 262(א) - ההחלטה לכלול בתקנון הוראה על פטור או שיפוי טעונה גם אישור אסיפות סוג` `ic3 - חברה ציבורית לדוגמה` TRUE)
-- (ב): a public company in which an office-holder is a controlling shareholder.
#ASSERT `סעיף 262(ב) - ההחלטה לכלול בתקנון הוראה על פטור, שיפוי או ביטוח טעונה גם אישור בעלי מניות שאינם בעלי ענין אישי` `ic3 - חברה ציבורית לדוגמה` TRUE
#ASSERT NOT (`סעיף 262(ב) - ההחלטה לכלול בתקנון הוראה על פטור, שיפוי או ביטוח טעונה גם אישור בעלי מניות שאינם בעלי ענין אישי` `ic3 - חברה ציבורית לדוגמה` FALSE)
#ASSERT NOT (`סעיף 262(ב) - ההחלטה לכלול בתקנון הוראה על פטור, שיפוי או ביטוח טעונה גם אישור בעלי מניות שאינם בעלי ענין אישי` `ic3 - חברה פרטית רגילה לדוגמה` TRUE)
-- The vote is the one of section 275(א)(3): 60 of 100 in the meeting, and a majority among the disinterested, 30 against 20.
`ic3 - הצבעה באסיפה` MEANS `הצבעה` WITH `קולות בעד` IS 60, `קולות נגד` IS 40, `קולות נמנעים` IS 0
`ic3 - הצבעה של בלי ענין אישי, רוב` MEANS `הצבעה` WITH `קולות בעד` IS 30, `קולות נגד` IS 20, `קולות נמנעים` IS 0
`ic3 - הצבעה של בלי ענין אישי, מיעוט` MEANS `הצבעה` WITH `קולות בעד` IS 20, `קולות נגד` IS 30, `קולות נמנעים` IS 0
#ASSERT `סעיף 262(ב) - אישור בעלי המניות שאינם בעלי ענין אישי ניתן ברוב הנדרש` `ic3 - הצבעה באסיפה` `ic3 - הצבעה של בלי ענין אישי, רוב` 10_000
-- Against, 20 for and 30 against among the disinterested, in a company with 1,000 voting rights: 30 is more than 2% of 1,000 (20), so neither test holds.
#ASSERT NOT (`סעיף 262(ב) - אישור בעלי המניות שאינם בעלי ענין אישי ניתן ברוב הנדרש` `ic3 - הצבעה באסיפה` `ic3 - הצבעה של בלי ענין אישי, מיעוט` 1_000)
-- The same votes in a company with 10,000 voting rights: 30 against is within 2% (200), so the second test holds.
#ASSERT `סעיף 262(ב) - אישור בעלי המניות שאינם בעלי ענין אישי ניתן ברוב הנדרש` `ic3 - הצבעה באסיפה` `ic3 - הצבעה של בלי ענין אישי, מיעוט` 10_000

§§ `סעיף 263: הוראות חסרות תוקף`

-- Exemption for a breach of loyalty, even in good faith: void (the carve-out is for indemnification and insurance only).
#ASSERT `סעיף 263 - להוראה אין תוקף` `הסדר של פטור מאחריות` (`ic3 - חבות: חובת אמונים בתום לב`)
-- Insurance and indemnification for a breach of loyalty in good faith (section 261(2)): not void by 263(1).
#ASSERT NOT (`סעיף 263 - להוראה אין תוקף` `הסדר של ביטוח אחריות` (`ic3 - חבות: חובת אמונים בתום לב`))
#ASSERT NOT (`סעיף 263 - להוראה אין תוקף` `הסדר של שיפוי` (`ic3 - חבות: חובת אמונים בתום לב`))
-- ... but void when he did not act in good faith with a reasonable basis.
#ASSERT `סעיף 263 - להוראה אין תוקף` `הסדר של ביטוח אחריות` (`ic3 - חבות: חובת אמונים שלא בתום לב`)
#ASSERT `סעיף 263 - להוראה אין תוקף` `הסדר של שיפוי` (`ic3 - חבות: חובת אמונים שלא בתום לב`)
-- (2): a breach of the duty of care done intentionally is void for all three; one done only negligently is not.
#ASSERT `סעיף 263 - להוראה אין תוקף` `הסדר של פטור מאחריות` (`ic3 - חבות: חובת הזהירות הופרה בכוונה`)
#ASSERT `סעיף 263 - להוראה אין תוקף` `הסדר של ביטוח אחריות` (`ic3 - חבות: חובת הזהירות הופרה בכוונה`)
#ASSERT `סעיף 263 - להוראה אין תוקף` `הסדר של שיפוי` (`ic3 - חבות: חובת הזהירות הופרה בכוונה`)
#ASSERT NOT (`סעיף 263 - להוראה אין תוקף` `הסדר של פטור מאחריות` (`ic3 - חבות: רשלנות בחובת הזהירות כלפי החברה`))
-- "Except if done only negligently": a breach described as reckless that is shown to be only negligent is not void (fork F11).
#ASSERT NOT (`סעיף 263 - להוראה אין תוקף` `הסדר של פטור מאחריות` (`ic3 - חבות: חובת הזהירות הופרה בפזיזות והתברר שרק ברשלנות`))
-- (3): an act with intent to make an unlawful personal profit; (4): a fine, civil fine, financial sanction or ransom.
#ASSERT `סעיף 263 - להוראה אין תוקף` `הסדר של שיפוי` (`ic3 - חבות: רווח אישי שלא כדין`)
#ASSERT `סעיף 263 - להוראה אין תוקף` `הסדר של ביטוח אחריות` (`ic3 - חבות: קנס`)
#ASSERT `סעיף 263 - להוראה אין תוקף` `הסדר של פטור מאחריות` (`ic3 - חבות: קנס`)
-- A financial liability in favour of another person, nothing else: not void.
#ASSERT NOT (`סעיף 263 - להוראה אין תוקף` `הסדר של ביטוח אחריות` (`ic3 - חבות: חבות כספית לטובת אדם אחר`))

§§ `סעיף 264: אי התניה`

#ASSERT `סעיף 264(א) - להוראה המתנה על הסימן אין תוקף` TRUE
#ASSERT NOT (`סעיף 264(א) - להוראה המתנה על הסימן אין תוקף` FALSE)
-- (ב): an undertaking or insurance for a breach of loyalty other than that of section 261(2): void.
#ASSERT `סעיף 264(ב) - להתחייבות לשיפוי או לביטוח בשל הפרת חובת אמונים אין תוקף` `הסדר של ביטוח אחריות` (`ic3 - חבות: חובת אמונים שלא בתום לב`)
#ASSERT `סעיף 264(ב) - להתחייבות לשיפוי או לביטוח בשל הפרת חובת אמונים אין תוקף` `הסדר של שיפוי` (`ic3 - חבות: חובת אמונים שלא בתום לב`)
#ASSERT NOT (`סעיף 264(ב) - להתחייבות לשיפוי או לביטוח בשל הפרת חובת אמונים אין תוקף` `הסדר של ביטוח אחריות` (`ic3 - חבות: חובת אמונים בתום לב`))
-- An exemption is not an undertaking or insurance: 264(ב) does not reach it (258(א) and 263 do).
#ASSERT NOT (`סעיף 264(ב) - להתחייבות לשיפוי או לביטוח בשל הפרת חובת אמונים אין תוקף` `הסדר של פטור מאחריות` (`ic3 - חבות: חובת אמונים שלא בתום לב`))
-- Not a breach of loyalty at all.
#ASSERT NOT (`סעיף 264(ב) - להתחייבות לשיפוי או לביטוח בשל הפרת חובת אמונים אין תוקף` `הסדר של ביטוח אחריות` (`ic3 - חבות: רשלנות בחובת הזהירות כלפי החברה`))
-- Receiving such an undertaking is itself a breach of the duty of loyalty.
#ASSERT `סעיף 264(ב) - קבלת התחייבות כאמור היא הפרה של חובת אמונים` TRUE
#ASSERT NOT (`סעיף 264(ב) - קבלת התחייבות כאמור היא הפרה של חובת אמונים` FALSE)

§§ `סעיף 258: הרכבת ההסדרים`

-- Exemption (258(ב)). Arguments: the articles provide for an advance exemption; the person is a director; the liability; a provision contracts out.
#ASSERT `סעיף 258(ב) - החברה רשאית לפטור נושא משרה מאחריותו בשל הפרת חובת הזהירות` TRUE FALSE (`ic3 - חבות: רשלנות בחובת הזהירות כלפי החברה`) FALSE
-- A director, a breach of the duty of care in a distribution: not allowed in advance.
#ASSERT NOT (`סעיף 258(ב) - החברה רשאית לפטור נושא משרה מאחריותו בשל הפרת חובת הזהירות` TRUE TRUE (`ic3 - חבות: חובת הזהירות בחלוקה`) FALSE)
-- An office-holder who is not a director, the same breach in a distribution: the prohibition is for directors.
#ASSERT `סעיף 258(ב) - החברה רשאית לפטור נושא משרה מאחריותו בשל הפרת חובת הזהירות` TRUE FALSE (`ic3 - חבות: חובת הזהירות בחלוקה`) FALSE
-- An intentional breach of the duty of care: void by 263(2).
#ASSERT NOT (`סעיף 258(ב) - החברה רשאית לפטור נושא משרה מאחריותו בשל הפרת חובת הזהירות` TRUE FALSE (`ic3 - חבות: חובת הזהירות הופרה בכוונה`) FALSE)
-- A breach of loyalty is not a breach of the duty of care: 259(א) does not reach it.
#ASSERT NOT (`סעיף 258(ב) - החברה רשאית לפטור נושא משרה מאחריותו בשל הפרת חובת הזהירות` TRUE FALSE (`ic3 - חבות: חובת אמונים בתום לב`) FALSE)
-- The articles do not provide.
#ASSERT NOT (`סעיף 258(ב) - החברה רשאית לפטור נושא משרה מאחריותו בשל הפרת חובת הזהירות` FALSE FALSE (`ic3 - חבות: רשלנות בחובת הזהירות כלפי החברה`) FALSE)
-- A provision that contracts out of the sub-chapter.
#ASSERT NOT (`סעיף 258(ב) - החברה רשאית לפטור נושא משרה מאחריותו בשל הפרת חובת הזהירות` TRUE FALSE (`ic3 - חבות: רשלנות בחובת הזהירות כלפי החברה`) TRUE)
-- Insurance (258(ג)). Arguments: the articles permit insurance; the liability is from an act as an office-holder; the liability; a provision contracts out.
#ASSERT `סעיף 258(ג) - החברה רשאית לבטח את אחריותו של נושא משרה` TRUE TRUE (`ic3 - חבות: רשלנות בחובת הזהירות כלפי החברה`) FALSE
#ASSERT `סעיף 258(ג) - החברה רשאית לבטח את אחריותו של נושא משרה` TRUE TRUE (`ic3 - חבות: חובת אמונים בתום לב`) FALSE
#ASSERT NOT (`סעיף 258(ג) - החברה רשאית לבטח את אחריותו של נושא משרה` TRUE TRUE (`ic3 - חבות: חובת אמונים שלא בתום לב`) FALSE)
#ASSERT NOT (`סעיף 258(ג) - החברה רשאית לבטח את אחריותו של נושא משרה` TRUE TRUE (`ic3 - חבות: חובת הזהירות הופרה בכוונה`) FALSE)
#ASSERT NOT (`סעיף 258(ג) - החברה רשאית לבטח את אחריותו של נושא משרה` TRUE TRUE (`ic3 - חבות: קנס`) FALSE)
#ASSERT NOT (`סעיף 258(ג) - החברה רשאית לבטח את אחריותו של נושא משרה` FALSE TRUE (`ic3 - חבות: רשלנות בחובת הזהירות כלפי החברה`) FALSE)
#ASSERT NOT (`סעיף 258(ג) - החברה רשאית לבטח את אחריותו של נושא משרה` TRUE TRUE (`ic3 - חבות: רשלנות בחובת הזהירות כלפי החברה`) TRUE)
-- Indemnification (258(ג)). Arguments: section 260 allows it; the liability; a provision contracts out.
#ASSERT `סעיף 258(ג) - החברה רשאית לשפות נושא משרה` TRUE (`ic3 - חבות: רשלנות בחובת הזהירות כלפי החברה`) FALSE
#ASSERT `סעיף 258(ג) - החברה רשאית לשפות נושא משרה` TRUE (`ic3 - חבות: חבות כספית לטובת אדם אחר`) FALSE
#ASSERT NOT (`סעיף 258(ג) - החברה רשאית לשפות נושא משרה` TRUE (`ic3 - חבות: חובת אמונים שלא בתום לב`) FALSE)
#ASSERT NOT (`סעיף 258(ג) - החברה רשאית לשפות נושא משרה` TRUE (`ic3 - חבות: רווח אישי שלא כדין`) FALSE)
#ASSERT NOT (`סעיף 258(ג) - החברה רשאית לשפות נושא משרה` FALSE (`ic3 - חבות: רשלנות בחובת הזהירות כלפי החברה`) FALSE)
