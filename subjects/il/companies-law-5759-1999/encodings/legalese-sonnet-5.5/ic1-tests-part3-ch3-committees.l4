#ASSERT `סעיף 117(2א) - עסקה שאינה זניחה` TRUE FALSE TRUE EQUALS FALSE
#ASSERT `סעיף 117(2א) - עסקה שאינה זניחה` TRUE TRUE FALSE EQUALS FALSE
-- 118(a).
#ASSERT `סעיף 118(א) - הדירקטוריון רשאי למנות ועדת ביקורת בחברה פרטית שאינה חברת איגרות חוב` `בדיקות ועדות - חברה פרטית` EQUALS TRUE
#ASSERT `סעיף 118(א) - הדירקטוריון רשאי למנות ועדת ביקורת בחברה פרטית שאינה חברת איגרות חוב` `בדיקות ועדות - חברה ציבורית` EQUALS FALSE
#ASSERT `סעיף 118(א) - הדירקטוריון רשאי למנות ועדת ביקורת בחברה פרטית שאינה חברת איגרות חוב` `בדיקות ועדות - חברת איגרות חוב פרטית` EQUALS FALSE
#ASSERT `סעיף 118(א) - דירקטור רשאי לכהן בוועדת ביקורת בחברה פרטית שאינה חברת איגרות חוב` FALSE FALSE EQUALS TRUE
#ASSERT `סעיף 118(א) - דירקטור רשאי לכהן בוועדת ביקורת בחברה פרטית שאינה חברת איגרות חוב` TRUE FALSE EQUALS FALSE
#ASSERT `סעיף 118(א) - דירקטור רשאי לכהן בוועדת ביקורת בחברה פרטית שאינה חברת איגרות חוב` FALSE TRUE EQUALS FALSE
#ASSERT `סעיף 118(א) - האדם רשאי לכהן כיושב ראש ועדת ביקורת בחברה פרטית שאינה חברת איגרות חוב` TRUE EQUALS FALSE
#ASSERT `סעיף 118(א) - האדם רשאי לכהן כיושב ראש ועדת ביקורת בחברה פרטית שאינה חברת איגרות חוב` FALSE EQUALS TRUE
-- 118(b). Arguments: company; the committee's function is as in section 117(2); members; members who or whose relatives are material shareholders.
#ASSERT `סעיף 118(ב) - ניתן למנות את הוועדה בחברה פרטית שאינה חברת איגרות חוב` `בדיקות ועדות - חברה פרטית` TRUE 5 3 EQUALS FALSE
#ASSERT `סעיף 118(ב) - ניתן למנות את הוועדה בחברה פרטית שאינה חברת איגרות חוב` `בדיקות ועדות - חברה פרטית` TRUE 4 2 EQUALS TRUE
#ASSERT `סעיף 118(ב) - ניתן למנות את הוועדה בחברה פרטית שאינה חברת איגרות חוב` `בדיקות ועדות - חברה פרטית` FALSE 5 5 EQUALS TRUE
#ASSERT `סעיף 118(ב) - ניתן למנות את הוועדה בחברה פרטית שאינה חברת איגרות חוב` `בדיקות ועדות - חברה ציבורית` TRUE 5 5 EQUALS TRUE

§§ `סימן י׳ – ועדת תגמול`

#ASSERT `סעיף 118א(א) - הדירקטוריון חייב למנות מבין חבריו ועדת תגמול` `בדיקות ועדות - חברה ציבורית` EQUALS TRUE
#ASSERT `סעיף 118א(א) - הדירקטוריון חייב למנות מבין חבריו ועדת תגמול` `בדיקות ועדות - חברת איגרות חוב פרטית` EQUALS TRUE
#ASSERT `סעיף 118א(א) - הדירקטוריון חייב למנות מבין חבריו ועדת תגמול` `בדיקות ועדות - חברה פרטית` EQUALS FALSE
-- 118A(b). Arguments: members; all external directors are members; members who are external directors; the others' terms are as fixed; the chair is an external director.
#ASSERT `סעיף 118א(ב) - הרכב ועדת התגמול` 3 TRUE 2 TRUE TRUE EQUALS TRUE
#ASSERT `סעיף 118א(ב) - הרכב ועדת התגמול` 2 TRUE 2 TRUE TRUE EQUALS FALSE
#ASSERT `סעיף 118א(ב) - הרכב ועדת התגמול` 3 FALSE 2 TRUE TRUE EQUALS FALSE
#ASSERT `סעיף 118א(ב) - הרכב ועדת התגמול` 4 TRUE 2 TRUE TRUE EQUALS FALSE
#ASSERT `סעיף 118א(ב) - הרכב ועדת התגמול` 4 TRUE 3 TRUE TRUE EQUALS TRUE
#ASSERT `סעיף 118א(ב) - הרכב ועדת התגמול` 3 TRUE 2 FALSE TRUE EQUALS FALSE
#ASSERT `סעיף 118א(ב) - הרכב ועדת התגמול` 3 TRUE 2 TRUE FALSE EQUALS FALSE
#ASSERT `סעיף 118א(ג) - על ועדת תגמול חלים סימן ח׳ וסעיף 115(ב) עד (ה)` TRUE EQUALS TRUE
#ASSERT `סעיף 118א(ג) - על ועדת תגמול חלים סימן ח׳ וסעיף 115(ב) עד (ה)` FALSE EQUALS FALSE
#ASSERT `סעיף 118א(ד) - ועדת ביקורת יכולה לשמש גם ועדת תגמול` TRUE EQUALS TRUE
#ASSERT `סעיף 118א(ד) - ועדת ביקורת יכולה לשמש גם ועדת תגמול` FALSE EQUALS FALSE
#ASSERT `סעיף 118ב - התפקיד הוא מתפקידי ועדת התגמול` `להמליץ על מדיניות התגמול לנושאי משרה ועל המשך תוקפה אחת לשלוש שנים` EQUALS TRUE
#ASSERT `סעיף 118ב - התפקיד הוא מתפקידי ועדת התגמול` `להמליץ על עדכון מדיניות התגמול ולבחון את יישומה` EQUALS TRUE
#ASSERT `סעיף 118ב - התפקיד הוא מתפקידי ועדת התגמול` `להחליט אם לאשר עסקאות באשר לתנאי כהונה והעסקה של נושאי משרה` EQUALS TRUE
#ASSERT `סעיף 118ב - התפקיד הוא מתפקידי ועדת התגמול` `לפטור עסקה מאישור האסיפה הכללית` EQUALS TRUE
#ASSERT `סעיף 118ב - התפקיד הוא מתפקידי ועדת התגמול` `תפקיד אחר שאינו מנוי בסעיף 118ב` EQUALS FALSE
