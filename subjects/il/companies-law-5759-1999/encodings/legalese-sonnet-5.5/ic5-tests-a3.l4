IMPORT prelude
IMPORT `ic-core`
IMPORT `ic5-a3-audit`

-- ic5-tests-a3: tests of ic5-a3-audit (sections 345ח and 345ט).
-- Every expected value below was decided from the section named beside it, before the run.

§ `בדיקות – סעיפים 345ח ו־345ט`

§§ `345ח – ועדת ביקורת`

-- 345ח(א): the general meeting appoints an audit committee; office-holders cannot be members.
#ASSERT `סעיף 345ח(א) - האסיפה הכללית חייבת למנות ועדת ביקורת` TRUE
#ASSERT NOT (`סעיף 345ח(א) - האסיפה הכללית חייבת למנות ועדת ביקורת` FALSE)
#ASSERT `סעיף 345ח(א) - אדם רשאי לכהן כחבר בוועדת הביקורת` FALSE
#ASSERT NOT (`סעיף 345ח(א) - אדם רשאי לכהן כחבר בוועדת הביקורת` TRUE)
-- 345ח(ב): for the committee's meetings the company counts as a public company.
#ASSERT `סעיף 345ח(ב) - לענין ישיבות ועדת הביקורת החברה נחשבת חברה ציבורית` TRUE
#ASSERT NOT (`סעיף 345ח(ב) - לענין ישיבות ועדת הביקורת החברה נחשבת חברה ציבורית` FALSE)
-- 345ח(ג): sections 114, 115(a), (b), (d), (f), 116א, 117 and 118 do not apply; no other provision is named.
#ASSERT `סעיף 345ח(ג) - ההוראה אינה חלה על ועדת ביקורת בחברה לתועלת הציבור` `הוראת סעיף 114`
#ASSERT `סעיף 345ח(ג) - ההוראה אינה חלה על ועדת ביקורת בחברה לתועלת הציבור` `הוראת סעיף 115(א)`
#ASSERT `סעיף 345ח(ג) - ההוראה אינה חלה על ועדת ביקורת בחברה לתועלת הציבור` `הוראת סעיף 115(ב)`
#ASSERT `סעיף 345ח(ג) - ההוראה אינה חלה על ועדת ביקורת בחברה לתועלת הציבור` `הוראת סעיף 115(ד)`
#ASSERT `סעיף 345ח(ג) - ההוראה אינה חלה על ועדת ביקורת בחברה לתועלת הציבור` `הוראת סעיף 115(ו)`
#ASSERT `סעיף 345ח(ג) - ההוראה אינה חלה על ועדת ביקורת בחברה לתועלת הציבור` `הוראת סעיף 116א`
#ASSERT `סעיף 345ח(ג) - ההוראה אינה חלה על ועדת ביקורת בחברה לתועלת הציבור` `הוראת סעיף 117`
#ASSERT `סעיף 345ח(ג) - ההוראה אינה חלה על ועדת ביקורת בחברה לתועלת הציבור` `הוראת סעיף 118`
#ASSERT NOT (`סעיף 345ח(ג) - ההוראה אינה חלה על ועדת ביקורת בחברה לתועלת הציבור` `הוראה אחרת שסעיף 345ח(ג) אינו מונה`)
-- 345ח(ד): a member has a director's responsibility, rights and duties, unless a provision under 345י says otherwise.
#ASSERT `סעיף 345ח(ד) - אחריותו, זכויותיו וחובותיו של חבר הוועדה כשל דירקטור` TRUE FALSE
#ASSERT NOT (`סעיף 345ח(ד) - אחריותו, זכויותיו וחובותיו של חבר הוועדה כשל דירקטור` TRUE TRUE)
#ASSERT NOT (`סעיף 345ח(ד) - אחריותו, זכויותיו וחובותיו של חבר הוועדה כשל דירקטור` FALSE FALSE)
-- 345ח(ה): twelve functions; the first and the last of the text are among them.
#ASSERT count (`סעיף 345ח(ה) - תפקידי ועדת הביקורת`) EQUALS 12
#ASSERT elem `לבחון את היקף עבודתו ושכרו של רואה החשבון המבקר` (`סעיף 345ח(ה) - תפקידי ועדת הביקורת`)
#ASSERT elem `להביא לפני הדירקטוריון והאסיפה השנתית את מסקנותיה` (`סעיף 345ח(ה) - תפקידי ועדת הביקורת`)
-- 345ח(ה)(4): a material defect found: a meeting without office-holders, and the audited party gets to put its position.
#ASSERT `סעיף 345ח(ה)(4) - הוועדה חייבת לקיים ישיבה בלא נוכחות נושאי משרה` TRUE TRUE
#ASSERT NOT (`סעיף 345ח(ה)(4) - הוועדה חייבת לקיים ישיבה בלא נוכחות נושאי משרה` TRUE FALSE)
#ASSERT NOT (`סעיף 345ח(ה)(4) - הוועדה חייבת לקיים ישיבה בלא נוכחות נושאי משרה` FALSE TRUE)
#ASSERT `סעיף 345ח(ה)(4) - הוועדה חייבת לתת לגורם מבוקר הזדמנות להביא את עמדתו` TRUE TRUE
#ASSERT NOT (`סעיף 345ח(ה)(4) - הוועדה חייבת לתת לגורם מבוקר הזדמנות להביא את עמדתו` TRUE FALSE)
-- An office-holder may attend only if the committee asked, the meeting is on a material defect, and the matter is in his responsibility.
#ASSERT `סעיף 345ח(ה)(4) - נושא משרה רשאי להיות נוכח בישיבה` TRUE TRUE TRUE
#ASSERT NOT (`סעיף 345ח(ה)(4) - נושא משרה רשאי להיות נוכח בישיבה` FALSE TRUE TRUE)
#ASSERT NOT (`סעיף 345ח(ה)(4) - נושא משרה רשאי להיות נוכח בישיבה` TRUE FALSE TRUE)
#ASSERT NOT (`סעיף 345ח(ה)(4) - נושא משרה רשאי להיות נוכח בישיבה` TRUE TRUE FALSE)
-- 345ח(ה)(6) and (6א).
#ASSERT `סעיף 345ח(ה)(6) - הפעולה או העסקה טעונה החלטה של ועדת הביקורת` TRUE
#ASSERT NOT (`סעיף 345ח(ה)(6) - הפעולה או העסקה טעונה החלטה של ועדת הביקורת` FALSE)
#ASSERT `סעיף 345ח(ה)(6א) - החלטת הוועדה בדבר מהותיות או חריגות כשרה` TRUE
#ASSERT NOT (`סעיף 345ח(ה)(6א) - החלטת הוועדה בדבר מהותיות או חריגות כשרה` FALSE)
-- At least once a year: overdue once more than 12 months have passed; exactly 12 is not overdue; no criteria, no duty.
#ASSERT `סעיף 345ח(ה)(6א) - הוועדה חייבת לבחון עתה את אופן יישום אמות המידה` TRUE 13
#ASSERT NOT (`סעיף 345ח(ה)(6א) - הוועדה חייבת לבחון עתה את אופן יישום אמות המידה` TRUE 12)
#ASSERT NOT (`סעיף 345ח(ה)(6א) - הוועדה חייבת לבחון עתה את אופן יישום אמות המידה` TRUE 0)
#ASSERT NOT (`סעיף 345ח(ה)(6א) - הוועדה חייבת לבחון עתה את אופן יישום אמות המידה` FALSE 24)
-- 345ח(ו): notice to the external and the internal auditor, who may attend.
#ASSERT `סעיף 345ח(ו) - הוועדה חייבת לשלוח הודעה על ישיבותיה לבעל התפקיד` TRUE
#ASSERT NOT (`סעיף 345ח(ו) - הוועדה חייבת לשלוח הודעה על ישיבותיה לבעל התפקיד` FALSE)
#ASSERT `סעיף 345ח(ו) - אדם רשאי להשתתף בישיבות ועדת הביקורת` TRUE
#ASSERT NOT (`סעיף 345ח(ו) - אדם רשאי להשתתף בישיבות ועדת הביקורת` FALSE)
-- 345ח(ז): may demand a meeting to bring its conclusions; may convene it itself only if demanded and nobody convened.
#ASSERT `סעיף 345ח(ז) - ועדת הביקורת רשאית לדרוש כינוס` TRUE
#ASSERT NOT (`סעיף 345ח(ז) - ועדת הביקורת רשאית לדרוש כינוס` FALSE)
#ASSERT `סעיף 345ח(ז) - ועדת הביקורת רשאית לכנס בעצמה` TRUE TRUE
#ASSERT NOT (`סעיף 345ח(ז) - ועדת הביקורת רשאית לכנס בעצמה` TRUE FALSE)
#ASSERT NOT (`סעיף 345ח(ז) - ועדת הביקורת רשאית לכנס בעצמה` FALSE TRUE)
-- 345ח(ט): turnover is the average annual receipts over the last three financial years; over fewer years, over those years; no year, NOTHING.
#ASSERT `סעיף 345ח(ט) - מחזור` 3 900_000 EQUALS (JUST 300_000)
#ASSERT `סעיף 345ח(ט) - מחזור` 7 900_000 EQUALS (JUST 300_000)
#ASSERT `סעיף 345ח(ט) - מחזור` 2 600_000 EQUALS (JUST 300_000)
#ASSERT `סעיף 345ח(ט) - מחזור` 1 500_000 EQUALS (JUST 500_000)
#ASSERT `סעיף 345ח(ט) - מחזור` 0 0 EQUALS NOTHING

§§ `345ט – מבקר פנימי`

-- 345ט(א): turnover must exceed NIS 10,000,000 (strictly); a higher sum fixed by the Minister replaces it.
#ASSERT `סעיף 345ט(א) - הדירקטוריון חייב למנות מבקר פנימי` 10_000_001 NOTHING
#ASSERT NOT (`סעיף 345ט(א) - הדירקטוריון חייב למנות מבקר פנימי` 10_000_000 NOTHING)
#ASSERT NOT (`סעיף 345ט(א) - הדירקטוריון חייב למנות מבקר פנימי` 9_999_999 NOTHING)
#ASSERT NOT (`סעיף 345ט(א) - הדירקטוריון חייב למנות מבקר פנימי` 12_000_000 (JUST 15_000_000))
#ASSERT NOT (`סעיף 345ט(א) - הדירקטוריון חייב למנות מבקר פנימי` 15_000_000 (JUST 15_000_000))
#ASSERT `סעיף 345ט(א) - הדירקטוריון חייב למנות מבקר פנימי` 15_000_001 (JUST 15_000_000)
-- 345ט(א): the board appoints with the committee's consent; failing agreement the general meeting decides.
#ASSERT `סעיף 345ט(א) - מי שמכריע במינוי המבקר הפנימי` TRUE EQUALS `הדירקטוריון ממנה בהסכמת ועדת הביקורת`
#ASSERT `סעיף 345ט(א) - מי שמכריע במינוי המבקר הפנימי` FALSE EQUALS `האסיפה הכללית מכריעה במינוי`
-- 345ט(ב): the committee reviews the proposed plan and the board approves it.
#ASSERT `סעיף 345ט(ב) - תכנית העבודה של המבקר הפנימי מאושרת כדין` TRUE TRUE
#ASSERT NOT (`סעיף 345ט(ב) - תכנית העבודה של המבקר הפנימי מאושרת כדין` TRUE FALSE)
#ASSERT NOT (`סעיף 345ט(ב) - תכנית העבודה של המבקר הפנימי מאושרת כדין` FALSE TRUE)
