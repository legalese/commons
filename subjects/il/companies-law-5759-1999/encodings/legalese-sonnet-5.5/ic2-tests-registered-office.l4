IMPORT prelude
IMPORT `ic-core`
IMPORT `ic2-tests-fixtures`
IMPORT `ic2-p4c1-registered-office`

-- Tests of ic2-p4c1-registered-office.l4 (sections 123 to 126). Expected values are written from the text of the section named beside each.

§ `בדיקות: משרד רשום ומען דיגיטלי`

§§ `סעיף 123`

-- 123(א): the duty to keep a registered office in Israel arises from the day of registration, and the office must be in Israel.
#ASSERT `סעיף 123(א) - חובת קיום משרד רשום בישראל חלה על החברה` TRUE
#ASSERT NOT (`סעיף 123(א) - חובת קיום משרד רשום בישראל חלה על החברה` FALSE)
#ASSERT `סעיף 123(א) - המשרד הרשום עומד בדרישת המיקום` TRUE
#ASSERT NOT (`סעיף 123(א) - המשרד הרשום עומד בדרישת המיקום` FALSE)

-- 123(ב): fourteen days after the change; the fourteenth day is in time (fork F1), the fifteenth is late.
#ASSERT `סעיף 123(ב) - מספר הימים למסירת הודעה לרשם על שינוי במען המשרד הרשום` EQUALS 14
#ASSERT `סעיף 123(ב) - ההודעה על שינוי במען נמסרה במועד` 0
#ASSERT `סעיף 123(ב) - ההודעה על שינוי במען נמסרה במועד` 14
#ASSERT NOT (`סעיף 123(ב) - ההודעה על שינוי במען נמסרה במועד` 15)
#ASSERT `סעיף 123(ב) - ההודעה הראשונה על המען נמסרה כנדרש` TRUE
#ASSERT NOT (`סעיף 123(ב) - ההודעה הראשונה על המען נמסרה כנדרש` FALSE)
#ASSERT `סעיף 123(ב) - הרשם חייב לרשום את מען המשרד הרשום` TRUE
#ASSERT NOT (`סעיף 123(ב) - הרשם חייב לרשום את מען המשרד הרשום` FALSE)

-- 123(ג): service is by delivery at the registered office as recorded at the time of delivery, or by post to it.
#ASSERT `סעיף 123(ג) - ההמצאה לחברה נעשתה במשרד הרשום` TRUE FALSE
#ASSERT `סעיף 123(ג) - ההמצאה לחברה נעשתה במשרד הרשום` FALSE TRUE
#ASSERT NOT (`סעיף 123(ג) - ההמצאה לחברה נעשתה במשרד הרשום` FALSE FALSE)

-- 123(ד): the Registrar may serve where he is satisfied the company runs its business; the Securities Authority only on a reporting corporation.
#ASSERT `סעיף 123(ד) - ההמצאה לחברה במקום אחר נעשתה כדין` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `הרשם` TRUE FALSE
#ASSERT `סעיף 123(ד) - ההמצאה לחברה במקום אחר נעשתה כדין` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `הרשם` FALSE TRUE
#ASSERT NOT (`סעיף 123(ד) - ההמצאה לחברה במקום אחר נעשתה כדין` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `הרשם` FALSE FALSE)
#ASSERT `סעיף 123(ד) - ההמצאה לחברה במקום אחר נעשתה כדין` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` `רשות ניירות ערך` TRUE FALSE
#ASSERT NOT (`סעיף 123(ד) - ההמצאה לחברה במקום אחר נעשתה כדין` `דוגמה - חברה ציבורית שאינה תאגיד מדווח` `רשות ניירות ערך` TRUE FALSE)
#ASSERT NOT (`סעיף 123(ד) - ההמצאה לחברה במקום אחר נעשתה כדין` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` `אדם אחר` TRUE TRUE)

§§ `סעיף 123א`

-- 123א(א): the company needs both items of the Fourth Schedule.
#ASSERT `סעיף 123א(א) - לחברה יש מען דיגיטלי כנדרש` TRUE TRUE
#ASSERT NOT (`סעיף 123א(א) - לחברה יש מען דיגיטלי כנדרש` TRUE FALSE)
#ASSERT NOT (`סעיף 123א(א) - לחברה יש מען דיגיטלי כנדרש` FALSE TRUE)
-- 123א(ב): fourteen days, inclusive.
#ASSERT `סעיף 123א(ב) - מספר הימים למסירת הודעה לרשם על שינוי במען הדיגיטלי` EQUALS 14
#ASSERT `סעיף 123א(ב) - ההודעה על שינוי במען הדיגיטלי נמסרה במועד` 14
#ASSERT NOT (`סעיף 123א(ב) - ההודעה על שינוי במען הדיגיטלי נמסרה במועד` 15)
#ASSERT `סעיף 123א(ב) - ההודעה הראשונה על המען הדיגיטלי נמסרה כנדרש` TRUE
#ASSERT NOT (`סעיף 123א(ב) - ההודעה הראשונה על המען הדיגיטלי נמסרה כנדרש` FALSE)
-- 123א(ג): the Registrar must record once notice was given, section 3B was met and he made sure the address works.
#ASSERT `סעיף 123א(ג) - הרשם חייב לרשום את המען הדיגיטלי` TRUE TRUE TRUE
#ASSERT NOT (`סעיף 123א(ג) - הרשם חייב לרשום את המען הדיגיטלי` FALSE TRUE TRUE)
#ASSERT NOT (`סעיף 123א(ג) - הרשם חייב לרשום את המען הדיגיטלי` TRUE FALSE TRUE)
#ASSERT NOT (`סעיף 123א(ג) - הרשם חייב לרשום את המען הדיגיטלי` TRUE TRUE FALSE)

§§ `סעיף 124`

-- 124: each listed document is kept by a company; a copy of a notice only if it is from the last seven years; the register of material shareholders only in a public company.
#ASSERT `סעיף 124 - החברה חייבת לשמור את המסמך במשרדה הרשום` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `תקנון החברה כמסמך שנשמר במשרד הרשום` 0
#ASSERT `סעיף 124 - החברה חייבת לשמור את המסמך במשרדה הרשום` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `פרוטוקול של אסיפה כללית כמסמך שנשמר במשרד הרשום` 0
#ASSERT `סעיף 124 - החברה חייבת לשמור את המסמך במשרדה הרשום` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `פרוטוקול או החלטה של הדירקטוריון` 0
#ASSERT `סעיף 124 - החברה חייבת לשמור את המסמך במשרדה הרשום` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `פרוטוקול של ועדת דירקטוריון` 0
#ASSERT `סעיף 124 - החברה חייבת לשמור את המסמך במשרדה הרשום` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `דוחות כספיים לפי סעיף 171` 0
#ASSERT `סעיף 124 - החברה חייבת לשמור את המסמך במשרדה הרשום` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `מרשם בעלי המניות כמסמך שנשמר במשרד הרשום` 0
#ASSERT `סעיף 124 - החברה חייבת לשמור את המסמך במשרדה הרשום` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `מרשם הדירקטורים` 0
#ASSERT `סעיף 124 - החברה חייבת לשמור את המסמך במשרדה הרשום` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `העתק הודעה של החברה לבעלי מניותיה` 7
#ASSERT NOT (`סעיף 124 - החברה חייבת לשמור את המסמך במשרדה הרשום` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `העתק הודעה של החברה לבעלי מניותיה` 8)
#ASSERT `סעיף 124 - החברה חייבת לשמור את המסמך במשרדה הרשום` `דוגמה - חברה ציבורית שהיא תאגיד מדווח` `מרשם בעלי המניות המהותיים` 0
#ASSERT NOT (`סעיף 124 - החברה חייבת לשמור את המסמך במשרדה הרשום` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `מרשם בעלי המניות המהותיים` 0)
#ASSERT NOT (`סעיף 124 - החברה חייבת לשמור את המסמך במשרדה הרשום` `דוגמה - חברה פרטית שאינה חברת איגרות חוב` `מסמך אחר שהחברה שומרת במשרדה הרשום` 0)
#ASSERT NOT (`סעיף 124 - החברה חייבת לשמור את המסמך במשרדה הרשום` `דוגמה - גוף שהתאגד לפי דין אחר` `תקנון החברה כמסמך שנשמר במשרד הרשום` 0)

§§ `סעיפים 125 ו־126`

-- 125: electronic keeping is allowed if copies can be had.
#ASSERT `סעיף 125 - שמירה באמצעים אלקטרוניים מותרת` TRUE
#ASSERT NOT (`סעיף 125 - שמירה באמצעים אלקטרוניים מותרת` FALSE)
-- 126(א): a right to a copy for those entitled to inspect.
#ASSERT `סעיף 126(א) - האדם זכאי לקבל העתק מהמסמכים` TRUE
#ASSERT NOT (`סעיף 126(א) - האדם זכאי לקבל העתק מהמסמכים` FALSE)
-- 126(א) and (ב): the charge is at most the company's expenses of giving the copy, and at most the Minister's maximum if he set one.
#ASSERT `סעיף 126 - התשלום בעבור ההעתק אינו עולה על המותר` 50 50 NOTHING
#ASSERT NOT (`סעיף 126 - התשלום בעבור ההעתק אינו עולה על המותר` 51 50 NOTHING)
#ASSERT `סעיף 126 - התשלום בעבור ההעתק אינו עולה על המותר` 20 50 (JUST 30)
#ASSERT `סעיף 126 - התשלום בעבור ההעתק אינו עולה על המותר` 30 50 (JUST 30)
#ASSERT NOT (`סעיף 126 - התשלום בעבור ההעתק אינו עולה על המותר` 31 50 (JUST 30))
#ASSERT NOT (`סעיף 126 - התשלום בעבור ההעתק אינו עולה על המותר` 40 35 (JUST 100))
