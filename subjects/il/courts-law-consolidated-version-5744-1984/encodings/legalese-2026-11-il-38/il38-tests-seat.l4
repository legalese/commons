IMPORT prelude
IMPORT `il38-nouns`
IMPORT `il38-seat`

-- Tests for the seat layer of the Courts Law row: each question gives the answer of the rule it calls. Row IL-38.

#ASSERT `am I eligible` 5 0 0 FALSE EQUALS TRUE
#ASSERT `am I eligible` 4 12 6 FALSE EQUALS TRUE
#ASSERT `am I eligible` 4 12 4 FALSE EQUALS FALSE
#ASSERT `am I past the cooling-off` TRUE 17 EQUALS FALSE
#ASSERT `am I past the cooling-off` TRUE 18 EQUALS TRUE
#ASSERT `does my age need every serving member` 54 FALSE 9 8 EQUALS FALSE
#ASSERT `does my age need every serving member` 54 FALSE 9 9 EQUALS TRUE
#ASSERT `does my age need every serving member` 55 FALSE 9 6 EQUALS TRUE
#ASSERT `did the committee follow the procedure` TRUE TRUE EQUALS TRUE
#ASSERT `did the committee follow the procedure` TRUE FALSE EQUALS FALSE
