IMPORT prelude
IMPORT daydate
IMPORT `il38-nouns`
IMPORT `il38-rules`

-- Tests for the Courts Law provisions in scope. Row IL-38. Expected values are worked by hand from the text (Amendment No. 105, SH 3389 pp. 438-440, and the consolidation for the unamended sections),
-- never from the code's output. Days are hypothetical fixtures.

`before` MEANS `the text before the 26th Knesset`
`from` MEANS `the text from the 26th Knesset`

§ `s 2: eligibility for the Supreme Court`

#ASSERT `the person is eligible to be a Supreme Court judge` (`A candidate for the Supreme Court` OF 5, 0, 0, FALSE) EQUALS TRUE
#ASSERT `the person is eligible to be a Supreme Court judge` (`A candidate for the Supreme Court` OF 4, 9, 9, FALSE) EQUALS FALSE
#ASSERT `the person is eligible to be a Supreme Court judge` (`A candidate for the Supreme Court` OF 0, 10, 5, FALSE) EQUALS TRUE
#ASSERT `the person is eligible to be a Supreme Court judge` (`A candidate for the Supreme Court` OF 0, 10, 4, FALSE) EQUALS FALSE
#ASSERT `the person is eligible to be a Supreme Court judge` (`A candidate for the Supreme Court` OF 0, 9, 9, FALSE) EQUALS FALSE
#ASSERT `the person is eligible to be a Supreme Court judge` (`A candidate for the Supreme Court` OF 0, 0, 0, TRUE) EQUALS TRUE

§ `s 2A: the cooling-off, and unanimity for a candidate under 55`

#ASSERT `the cooling-off of 18 months is over` TRUE 17 EQUALS FALSE
#ASSERT `the cooling-off of 18 months is over` TRUE 18 EQUALS TRUE
#ASSERT `the cooling-off of 18 months is over` FALSE 0 EQUALS TRUE
-- s 2A(b) does not exist before the 26th Knesset.
#ASSERT `the choice of a Supreme Court judge meets section 2A(b)` `before` 40 FALSE 9 8 EQUALS TRUE
#ASSERT `the choice of a Supreme Court judge meets section 2A(b)` `from` 54 FALSE 9 9 EQUALS TRUE
#ASSERT `the choice of a Supreme Court judge meets section 2A(b)` `from` 54 FALSE 9 8 EQUALS FALSE
-- At 55 the rule no longer applies: "שטרם מלאו לו 55 שנים" is a person who has not yet completed 55 years.
#ASSERT `the choice of a Supreme Court judge meets section 2A(b)` `from` 55 FALSE 9 8 EQUALS TRUE
-- Amendment No. 105 s 8(b): not applied to a judge appointed to the Supreme Court before commencement.
#ASSERT `the choice of a Supreme Court judge meets section 2A(b)` `from` 54 TRUE 9 8 EQUALS TRUE
-- All the members serving: seven serving, seven in favour.
#ASSERT `the choice of a Supreme Court judge meets section 2A(b)` `from` 40 FALSE 7 7 EQUALS TRUE
#ASSERT `the choice of a Supreme Court judge meets section 2A(b)` `from` 40 FALSE 7 6 EQUALS FALSE

§ `s 6: who is a coalition faction, and the women among the members`

#ASSERT `the faction is one of the coalition factions` TRUE EQUALS TRUE
#ASSERT `the faction is one of the coalition factions` FALSE EQUALS FALSE
#ASSERT `the faction is one of the opposition factions` TRUE EQUALS FALSE
#ASSERT `the faction is one of the opposition factions` FALSE EQUALS TRUE
-- The order of `Women on the committee`: justices, Government, Knesset (before), Bar (before), coalition-chosen, opposition-chosen, Knesset-chosen public representatives.
#ASSERT `the gender requirement of section 6 is met` `before` FALSE (`Women on the committee` OF 1, 1, 1, 1, 0, 0, 0) EQUALS TRUE
#ASSERT `the gender requirement of section 6 is met` `before` FALSE (`Women on the committee` OF 1, 1, 1, 0, 0, 0, 0) EQUALS FALSE
#ASSERT `the gender requirement of section 6 is met` `from` FALSE (`Women on the committee` OF 1, 1, 0, 0, 1, 1, 0) EQUALS TRUE
#ASSERT `the gender requirement of section 6 is met` `from` FALSE (`Women on the committee` OF 1, 1, 0, 0, 1, 0, 0) EQUALS FALSE
-- With more than 80: (3B) does not apply, but a woman among the public representatives the Knesset chose.
#ASSERT `the gender requirement of section 6 is met` `from` TRUE (`Women on the committee` OF 1, 1, 0, 0, 0, 0, 1) EQUALS TRUE
#ASSERT `the gender requirement of section 6 is met` `from` TRUE (`Women on the committee` OF 1, 1, 0, 0, 1, 1, 0) EQUALS FALSE

§ `s 6B: changes during the Knesset's term`

#ASSERT `members must be chosen in place of the ministers, Knesset members and public representatives` TRUE 70 75 EQUALS TRUE
#ASSERT `members must be chosen in place of the ministers, Knesset members and public representatives` FALSE 81 80 EQUALS TRUE
#ASSERT `members must be chosen in place of the ministers, Knesset members and public representatives` FALSE 80 81 EQUALS TRUE
#ASSERT `members must be chosen in place of the ministers, Knesset members and public representatives` FALSE 85 82 EQUALS FALSE
#ASSERT `members must be chosen in place of the ministers, Knesset members and public representatives` FALSE 70 75 EQUALS FALSE
#ASSERT `members must be chosen in place of the ministers, Knesset members and public representatives` FALSE 80 80 EQUALS FALSE
-- Two thirds of a side of 60: 40 announce.
#ASSERT `two thirds of that side announce` 40 60 EQUALS TRUE
#ASSERT `two thirds of that side announce` 39 60 EQUALS FALSE
-- 30 days from the ground on 1 January 2027 is 31 January 2027.
#ASSERT `the election was held within 30 days of the ground` (Date 1 1 2027) (Date 31 1 2027) EQUALS TRUE
#ASSERT `the election was held within 30 days of the ground` (Date 1 1 2027) (Date 1 2 2027) EQUALS FALSE

§ `s 6C: public representatives`

#ASSERT `the person is eligible to be chosen a public representative` (`A candidate for the Supreme Court` OF 5, 0, 0, FALSE) EQUALS TRUE
#ASSERT `the person is eligible to be chosen a public representative` (`A candidate for the Supreme Court` OF 4, 9, 9, FALSE) EQUALS FALSE

§ `s 7(b), (c)`

#ASSERT `the proposal of a candidate is by someone the text allows` `before` `the Minister of Justice` 1 EQUALS TRUE
#ASSERT `the proposal of a candidate is by someone the text allows` `before` `the President of the Supreme Court` 1 EQUALS TRUE
#ASSERT `the proposal of a candidate is by someone the text allows` `before` `members of the committee acting together` 3 EQUALS TRUE
#ASSERT `the proposal of a candidate is by someone the text allows` `before` `members of the committee acting together` 2 EQUALS FALSE
#ASSERT `the proposal of a candidate is by someone the text allows` `from` `members of the committee acting together` 2 EQUALS TRUE
#ASSERT `the proposal of a candidate is by someone the text allows` `from` `members of the committee acting together` 1 EQUALS FALSE
-- s 7(c) before the 26th Knesset: district or magistrates' court, a majority of those who took part.
#ASSERT `the old majority of section 7(c) is met` `before` FALSE 9 5 EQUALS JUST TRUE
#ASSERT `the old majority of section 7(c) is met` `before` FALSE 9 4 EQUALS JUST FALSE
#ASSERT `the old majority of section 7(c) is met` `before` FALSE 8 4 EQUALS JUST FALSE
-- Supreme Court: seven of nine; if fewer than nine took part, a majority not below participants minus two.
#ASSERT `the old majority of section 7(c) is met` `before` TRUE 9 7 EQUALS JUST TRUE
#ASSERT `the old majority of section 7(c) is met` `before` TRUE 9 6 EQUALS JUST FALSE
#ASSERT `the old majority of section 7(c) is met` `before` TRUE 8 6 EQUALS JUST TRUE
#ASSERT `the old majority of section 7(c) is met` `before` TRUE 8 5 EQUALS JUST FALSE
#ASSERT `the old majority of section 7(c) is met` `before` TRUE 7 5 EQUALS JUST TRUE
#ASSERT `the old majority of section 7(c) is met` `before` TRUE 7 4 EQUALS JUST FALSE
-- Repealed from the 26th Knesset: the Law has no answer of its own.
#ASSERT `the old majority of section 7(c) is met` `from` TRUE 9 7 EQUALS NOTHING

§ `s 8: the President and Deputy President`

#ASSERT `the provisions of the Basic Law that appoint the President and the Deputy` `before` EQUALS "s 4(a)"
#ASSERT `the provisions of the Basic Law that appoint the President and the Deputy` `from` EQUALS "s 4(a) and (d)"
#ASSERT `the term of the President or Deputy has run` 7 EQUALS TRUE
#ASSERT `the term of the President or Deputy has run` 6 EQUALS FALSE
#ASSERT `the person may be appointed to that post again` TRUE EQUALS FALSE
#ASSERT `the person may be appointed to that post again` FALSE EQUALS TRUE

§ `s 14: ending a judge's term`

#ASSERT `the committee followed section 14(b)` TRUE TRUE EQUALS TRUE
#ASSERT `the committee followed section 14(b)` TRUE FALSE EQUALS FALSE
#ASSERT `the committee followed section 14(b)` FALSE TRUE EQUALS FALSE
#ASSERT `the pension fixed is within section 14(c)` 100 100 EQUALS TRUE
#ASSERT `the pension fixed is within section 14(c)` 101 100 EQUALS FALSE

§ `s 25: two thirds of the Supreme Court`

#ASSERT `two thirds of the Supreme Court are former district court judges` 15 10 EQUALS TRUE
#ASSERT `two thirds of the Supreme Court are former district court judges` 15 9 EQUALS FALSE
