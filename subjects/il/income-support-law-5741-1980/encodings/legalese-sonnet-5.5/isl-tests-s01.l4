IMPORT prelude
IMPORT daydate
IMPORT `isl-nouns`
IMPORT `isl-s01-definitions`

-- Tests for section 1 (definitions) and the three-valued helpers.  Expected values are written from the text, beside each assertion.

§ `Helpers`
-- Kleene AND: a FALSE operand gives FALSE, two TRUEs give TRUE, otherwise NOTHING.
#ASSERT `helper both` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `helper both` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `helper both` (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `helper both` NOTHING (JUST FALSE) EQUALS JUST FALSE
#ASSERT `helper both` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `helper both` NOTHING NOTHING EQUALS NOTHING
-- Kleene OR
#ASSERT `helper either` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `helper either` NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `helper either` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `helper either` (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `helper either` NOTHING NOTHING EQUALS NOTHING
#ASSERT `helper true or not covered` TRUE EQUALS JUST TRUE
#ASSERT `helper true or not covered` FALSE EQUALS NOTHING

§ `s 1 "widow"`
-- אלמנה: includes one paid a survivors' or dependants' allowance
#ASSERT `s 1 "widow" the person is a widow` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1 "widow" the person is a widow` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1 "widow" the person is a widow` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1 "widow" the person is a widow` FALSE FALSE EQUALS NOTHING

§ `s 1 "spouses"`
-- בני זוג: includes a man and a woman known in public as spouses and living together
#ASSERT `s 1 "spouses" the two are spouses` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1 "spouses" the two are spouses` FALSE TRUE TRUE EQUALS JUST TRUE
-- known in public as spouses but not living together: the limb needs both ("הידועים בציבור כבני זוג ומתגוררים יחדיו"); not covered
#ASSERT `s 1 "spouses" the two are spouses` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 1 "spouses" the two are spouses` FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 1 "spouses" the two are spouses` FALSE FALSE FALSE EQUALS NOTHING

§ `s 1 "retirement age"`
#ASSERT `s 1 "retirement age" the person has reached it` 67 67
#ASSERT `s 1 "retirement age" the person has reached it` 70 67
#ASSERT NOT (`s 1 "retirement age" the person has reached it` 66 67)

§ `s 1 "benefit"`
-- גימלה: means a monthly income-support benefit paid under this Law
#ASSERT `s 1 "benefit" the payment is a benefit` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1 "benefit" the payment is a benefit` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1 "benefit" the payment is a benefit` FALSE TRUE EQUALS JUST FALSE

§ `s 1 "independent parent"`
#ASSERT `s 1 "independent parent" the person is an independent parent` TRUE EQUALS JUST TRUE
#ASSERT `s 1 "independent parent" the person is an independent parent` FALSE EQUALS JUST FALSE

§ `s 1 "basic amount"`
-- הסכום הבסיסי
-- The text states 6,964 new shekels.
#ASSERT `s 1 "basic amount" the figure the text states` EQUALS 6964
-- (1)(a): 6964 x (1 + 2% + 25%), where 102/100 - 1 = 2% and 100/80 - 1 = 25%: 6964 x 1.27 = 8844.28
#ASSERT `s 1 "basic amount" (1) the amount updated on 1 January 2006` (`a recipient of an Insurance Law pension named in s 1 "basic amount" (1)(a), who is also entitled under this Law`) 102 100 80 0.03 EQUALS 8844.28
-- (1)(b): 6964 x (1 + 2% + 3%) = 6964 x 1.05 = 7312.2 (the 3% is the average-wage rate, an input)
#ASSERT `s 1 "basic amount" (1) the amount updated on 1 January 2006` (`anyone else paid a benefit under this Law`) 102 100 80 0.03 EQUALS 7312.2
-- (2): 10,000 x 104/100 = 10,400
#ASSERT `s 1 "basic amount" (2) the amount updated on a 1 January from 2007` 10000 104 100 EQUALS 10400

§ `s 1 short names`
-- a table: one assertion for each entry
#ASSERT `s 1 what a defined short name stands for` `the Ordinance` EQUALS "the Income Tax Ordinance -- פקודת מס הכנסה"
#ASSERT `s 1 what a defined short name stands for` `the average wage` EQUALS "the average wage as meant in ss 1 and 2 of the Insurance Law -- בסעיפים 1 ו־2 לחוק הביטוח"
#ASSERT `s 1 what a defined short name stands for` `the Minister` EQUALS "the Minister of Labour and Welfare -- שר העבודה והרווחה"
#ASSERT `s 1 what a defined short name stands for` `the Insurance Law` EQUALS "the National Insurance Law [consolidated version] 5755-1995 -- חוק הביטוח הלאומי [נוסח משולב], התשנ״ה–1995"
#ASSERT `s 1 what a defined short name stands for` `the Disengagement Implementation Law` EQUALS "the Disengagement Plan Implementation Law 5765-2005 -- חוק יישום תכנית ההתנתקות, התשס״ה–2005"
#ASSERT `s 1 what a defined short name stands for` `the Arrests Law` EQUALS "the Criminal Procedure (Enforcement Powers -- Arrests) Law 5756-1996 -- חוק סדר הדין הפלילי (סמכויות אכיפה – מעצרים), התשנ״ו–1996"
#ASSERT `s 1 what a defined short name stands for` `the Supervision Law` EQUALS "the Supervision of Institutions for the Treatment of Drug Users Law 5753-1993 -- חוק הפיקוח על מוסדות לטיפול במשתמשים בסמים, התשנ״ג–1993"
#ASSERT `s 1 what a defined short name stands for` `the Penal Law` EQUALS "the Penal Law 5737-1977 -- חוק העונשין, התשל״ז–1977"
#ASSERT `s 1 what a defined short name stands for` `the Minimum Wage Law` EQUALS "the Minimum Wage Law 5747-1987 -- חוק שכר מינימום, התשמ״ז–1987"
#ASSERT `s 1 what a defined short name stands for` `a pension point` EQUALS "a pension point as meant in s 68(a) of the Insurance Law -- בסעיף 68(א) לחוק הביטוח"
#ASSERT `s 1 what a defined short name stands for` `the Law of Return` EQUALS "the Law of Return 5710-1950 -- חוק השבות, התש״י–1950"

§ `s 1 "single person"`
-- יחיד: means one who has no spouse
#ASSERT `s 1 "single person" the claimant is a single person` FALSE EQUALS JUST TRUE
#ASSERT `s 1 "single person" the claimant is a single person` TRUE EQUALS JUST FALSE

§ `s 1 "child"`
-- ילד: any of limb (a) or limb (b)
-- limb (a): a child as the Insurance Law defines the word
#ASSERT `s 1 "child" the person is a child` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- limb (b): not the claimant's own, listed, lives permanently with the claimant, and the claimant was appointed guardian
#ASSERT `s 1 "child" the person is a child` FALSE FALSE TRUE TRUE TRUE FALSE EQUALS JUST TRUE
-- limb (b) with a claimant who stopped being guardian only because the child reached 18
#ASSERT `s 1 "child" the person is a child` FALSE FALSE TRUE TRUE FALSE TRUE EQUALS JUST TRUE
-- limb (b) fails on each condition in turn: no guardianship at all
#ASSERT `s 1 "child" the person is a child` FALSE FALSE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
-- not living permanently with the claimant
#ASSERT `s 1 "child" the person is a child` FALSE FALSE TRUE FALSE TRUE FALSE EQUALS JUST FALSE
-- not one of those listed in paras (1) to (5)
#ASSERT `s 1 "child" the person is a child` FALSE FALSE FALSE TRUE TRUE FALSE EQUALS JUST FALSE
-- the claimant's own child who is not a child under limb (a): limb (b) is for someone who is NOT the claimant's child
#ASSERT `s 1 "child" the person is a child` FALSE TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- the claimant's own child, not a child under limb (a), not listed: limb (b) needs a person who is NOT the claimant's child and who is listed
#ASSERT `s 1 "child" the person is a child` FALSE TRUE FALSE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1 "child" the person is a child` FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE

§ `s 1 "new immigrant"`
-- עולה חדש: 5 years not yet completed since the day one of paras (1) to (4) was met
-- day before the fifth anniversary: still a new immigrant
#ASSERT `s 1 "new immigrant" the person is a new immigrant` (Date 14 3 2026) (LIST Date 15 3 2021) EQUALS JUST TRUE
-- on the fifth anniversary the 5 years are completed: no longer one
#ASSERT `s 1 "new immigrant" the person is a new immigrant` (Date 15 3 2026) (LIST Date 15 3 2021) EQUALS JUST FALSE
-- no qualifying day at all
#ASSERT `s 1 "new immigrant" the person is a new immigrant` (Date 1 1 2026) EMPTY EQUALS JUST FALSE
-- two qualifying days: 5 years have not run from the later one, so any-one reading says yes
#ASSERT `s 1 "new immigrant" the person is a new immigrant` (Date 1 1 2026) (LIST Date 1 1 2018, Date 20 3 2022) EQUALS JUST TRUE

§ `s 1 "resident of Israel"`
-- תושב ישראל: includes a resident of Israel in the Area
#ASSERT `s 1 "resident of Israel" the person is a resident of Israel` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1 "resident of Israel" the person is a resident of Israel` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1 "resident of Israel" the person is a resident of Israel` FALSE FALSE EQUALS NOTHING
