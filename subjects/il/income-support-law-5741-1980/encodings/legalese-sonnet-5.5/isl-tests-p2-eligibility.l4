#ASSERT `s 2(a) and (b) the resident aged 25 or over is entitled` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2(a) and (b) the resident aged 25 or over is entitled` NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 2(a) and (b) the resident aged 25 or over is entitled` (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `s 2(c) the person is entitled under the Minister's rules` TRUE EQUALS JUST TRUE
#ASSERT `s 2(c) the person is entitled under the Minister's rules` FALSE EQUALS NOTHING

