#ASSERT `s 2(a) the resident aged 25 or over is entitled under subsection (a)` TRUE 24 (LIST JUST TRUE) EQUALS NOTHING
#ASSERT `s 2(a) the resident aged 25 or over is entitled under subsection (a)` TRUE 25 (LIST JUST TRUE) EQUALS JUST TRUE
