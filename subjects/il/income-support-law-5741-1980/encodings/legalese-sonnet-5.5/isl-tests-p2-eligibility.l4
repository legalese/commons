§ `s 3 -- who is not entitled`
#ASSERT `s 3(1) the person kept in an institution at public expense is not entitled` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 3(1) the person kept in an institution at public expense is not entitled` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 3(1) the person kept in an institution at public expense is not entitled` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 3(1) the person kept in an institution at public expense is not entitled` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 3(2) the soldier in regular service and his wife are not entitled` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 3(2) the soldier in regular service and his wife are not entitled` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 3(2) the soldier in regular service and his wife are not entitled` FALSE FALSE EQUALS NOTHING
#ASSERT `s 3(3) the member of a body corporate responsible for its members' livelihood is not entitled` TRUE EQUALS JUST TRUE
#ASSERT `s 3(3) the member of a body corporate responsible for its members' livelihood is not entitled` FALSE EQUALS NOTHING
-- s 3(4): arguments are student, paid under s 2(a)(4), independent parent, months paid in the 20 before, second/third degree, months already paid, Minister's longer period
#ASSERT `s 3(4) the student is not entitled` FALSE FALSE FALSE 0 FALSE 0 FALSE EQUALS NOTHING
#ASSERT `s 3(4) the student is not entitled` TRUE FALSE FALSE 0 FALSE 0 FALSE EQUALS JUST TRUE
-- except one paid under s 2(a)(4)
#ASSERT `s 3(4) the student is not entitled` TRUE TRUE FALSE 0 FALSE 0 FALSE EQUALS JUST FALSE
-- except an independent parent with 16 of the 20 months; 15 is not enough
#ASSERT `s 3(4) the student is not entitled` TRUE FALSE TRUE 16 FALSE 0 FALSE EQUALS JUST FALSE
#ASSERT `s 3(4) the student is not entitled` TRUE FALSE TRUE 15 FALSE 0 FALSE EQUALS JUST TRUE
-- not if the programme leads to a second or third degree
#ASSERT `s 3(4) the student is not entitled` TRUE FALSE TRUE 16 TRUE 0 FALSE EQUALS JUST TRUE
-- 36 months at most: month 35 paid so far allows one more; at 36 the period has run out, unless the Minister set a longer one
#ASSERT `s 3(4) the student is not entitled` TRUE FALSE TRUE 16 FALSE 35 FALSE EQUALS JUST FALSE
#ASSERT `s 3(4) the student is not entitled` TRUE FALSE TRUE 16 FALSE 36 FALSE EQUALS NOTHING
#ASSERT `s 3(4) the student is not entitled` TRUE FALSE TRUE 16 FALSE 36 TRUE EQUALS JUST FALSE
-- not an independent parent
#ASSERT `s 3(4) the student is not entitled` TRUE FALSE FALSE 20 FALSE 0 FALSE EQUALS JUST TRUE
#ASSERT `s 3(4)(b)(2) subparagraph (1) does not take away an entitlement under s 2(a)(2) or (3)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 3(4)(b)(2) subparagraph (1) does not take away an entitlement under s 2(a)(2) or (3)` TRUE FALSE EQUALS NOTHING
#ASSERT `s 3(4)(b)(2) subparagraph (1) does not take away an entitlement under s 2(a)(2) or (3)` FALSE TRUE EQUALS NOTHING
-- s 3 together: one class suffices; a "no" from s 3(4)'s exceptions does not make the person entitled
#ASSERT `s 3 the person is not entitled` (LIST NOTHING, JUST TRUE, NOTHING, NOTHING) EQUALS JUST TRUE
#ASSERT `s 3 the person is not entitled` (LIST NOTHING, NOTHING, NOTHING, NOTHING) EQUALS NOTHING
#ASSERT `s 3 the person is not entitled` (LIST NOTHING, NOTHING, NOTHING, JUST FALSE) EQUALS NOTHING

