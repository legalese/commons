IMPORT prelude
IMPORT daydate
IMPORT `isl-nouns`
IMPORT `isl-p2-eligibility`

-- Tests for Chapter 2 (ss 2, 3, 3A, 3C, 4).  Expected values are written from the text, beside each assertion.

§ `s 2(a)(1) -- who may find a person not placeable`
#ASSERT `s 2(a)(1) the finding of non-placement was made by the body the text names for the situation` `treated in an institution or in drug withdrawal under a court probation order` `a drug-addiction diagnosis centre approved by the Minister, or the institution in which the person is treated` EQUALS JUST TRUE
#ASSERT `s 2(a)(1) the finding of non-placement was made by the body the text names for the situation` `treated in an institution or in drug withdrawal under a court probation order` `a probation officer` EQUALS JUST FALSE
#ASSERT `s 2(a)(1) the finding of non-placement was made by the body the text names for the situation` `treated in an institution or in drug withdrawal under a court probation order` `an alcoholics treatment centre under the supervision of the Ministry` EQUALS JUST FALSE
#ASSERT `s 2(a)(1) the finding of non-placement was made by the body the text names for the situation` `treated in an institution or in drug withdrawal under a court probation order` `someone else` EQUALS JUST FALSE
#ASSERT `s 2(a)(1) the finding of non-placement was made by the body the text names for the situation` `under the supervision of a probation officer under the Arrests Law` `a probation officer` EQUALS JUST TRUE
#ASSERT `s 2(a)(1) the finding of non-placement was made by the body the text names for the situation` `under the supervision of a probation officer under the Arrests Law` `a drug-addiction diagnosis centre approved by the Minister, or the institution in which the person is treated` EQUALS JUST FALSE
#ASSERT `s 2(a)(1) the finding of non-placement was made by the body the text names for the situation` `staying at an alcoholics treatment centre under the supervision of the Ministry` `an alcoholics treatment centre under the supervision of the Ministry` EQUALS JUST TRUE
#ASSERT `s 2(a)(1) the finding of non-placement was made by the body the text names for the situation` `staying at an alcoholics treatment centre under the supervision of the Ministry` `someone else` EQUALS JUST FALSE
#ASSERT `s 2(a)(1) the finding of non-placement was made by the body the text names for the situation` `none of these` `a probation officer` EQUALS JUST FALSE

§ `s 2(a)(1) -- no capacity to work, or not placeable`
-- no capacity to work: no proviso attaches
#ASSERT `s 2(a)(1) the person has no capacity to work or cannot be placed in any work` TRUE FALSE (JUST FALSE) FALSE EQUALS JUST TRUE
-- not placeable, found by the right body, for a period within the Minister's limit
#ASSERT `s 2(a)(1) the person has no capacity to work or cannot be placed in any work` FALSE TRUE (JUST TRUE) TRUE EQUALS JUST TRUE
-- the period is beyond the Minister's limit
#ASSERT `s 2(a)(1) the person has no capacity to work or cannot be placed in any work` FALSE TRUE (JUST TRUE) FALSE EQUALS JUST FALSE
-- the wrong body
#ASSERT `s 2(a)(1) the person has no capacity to work or cannot be placed in any work` FALSE TRUE (JUST FALSE) TRUE EQUALS JUST FALSE
-- neither
#ASSERT `s 2(a)(1) the person has no capacity to work or cannot be placed in any work` FALSE FALSE NOTHING TRUE EQUALS JUST FALSE

