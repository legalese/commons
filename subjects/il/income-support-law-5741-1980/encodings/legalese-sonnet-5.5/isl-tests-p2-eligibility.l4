#ASSERT `s 2(b) the additional condition of 24 months of residence is met` 24 FALSE EQUALS JUST TRUE
#ASSERT `s 2(b) the additional condition of 24 months of residence is met` 23 FALSE EQUALS JUST FALSE
#ASSERT `s 2(b) the additional condition of 24 months of residence is met` 0 TRUE EQUALS JUST TRUE
