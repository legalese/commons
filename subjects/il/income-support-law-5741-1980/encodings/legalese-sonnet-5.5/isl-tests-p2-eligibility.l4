#ASSERT `s 2(a) the resident aged 25 or over is entitled under subsection (a)` TRUE 40 (LIST JUST FALSE, JUST FALSE, JUST FALSE) EQUALS JUST FALSE
-- one limb not settled and none holds: not covered
#ASSERT `s 2(a) the resident aged 25 or over is entitled under subsection (a)` TRUE 40 (LIST JUST FALSE, NOTHING, JUST FALSE) EQUALS NOTHING
#ASSERT `s 2(a) the resident aged 25 or over is entitled under subsection (a)` TRUE 40 (LIST NOTHING, JUST TRUE) EQUALS JUST TRUE
