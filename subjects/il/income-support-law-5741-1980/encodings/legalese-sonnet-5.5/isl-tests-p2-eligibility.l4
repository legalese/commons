§ `s 2(a)(3) and (4)`
#ASSERT `s 2(a)(3) the person works or is in training with a low income` TRUE 1000 4214 TRUE EQUALS JUST TRUE
-- one shekel below the income at which no benefit is payable
#ASSERT `s 2(a)(3) the person works or is in training with a low income` TRUE 4213 4214 TRUE EQUALS JUST TRUE
-- income equal to it is not "lower"
#ASSERT `s 2(a)(3) the person works or is in training with a low income` TRUE 4214 4214 TRUE EQUALS JUST FALSE
#ASSERT `s 2(a)(3) the person works or is in training with a low income` FALSE 1000 4214 TRUE EQUALS JUST FALSE
-- the regulations' conditions are not among the sources
#ASSERT `s 2(a)(3) the person works or is in training with a low income` TRUE 1000 4214 FALSE EQUALS NOTHING
#ASSERT `s 2(a)(4) the person has reached retirement age` TRUE EQUALS JUST TRUE
#ASSERT `s 2(a)(4) the person has reached retirement age` FALSE EQUALS JUST FALSE

§ `s 2(a)(5) -- a parent of a child under two`
#ASSERT `s 2(a)(5)(a) the parent of a child under two is entitled` TRUE 23 FALSE FALSE FALSE EQUALS JUST TRUE
-- the child has completed two years (24 months)
#ASSERT `s 2(a)(5)(a) the parent of a child under two is entitled` TRUE 24 FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 2(a)(5)(a) the parent of a child under two is entitled` FALSE 10 FALSE FALSE FALSE EQUALS NOTHING
-- spouses: the mother, unless they chose the other spouse
#ASSERT `s 2(a)(5)(a) the parent of a child under two is entitled` TRUE 10 TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2(a)(5)(a) the parent of a child under two is entitled` TRUE 10 TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2(a)(5)(a) the parent of a child under two is entitled` TRUE 10 TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2(a)(5)(a) the parent of a child under two is entitled` TRUE 10 TRUE FALSE TRUE EQUALS JUST TRUE
-- (b): free to change unless the other spouse is entitled under (2), then every six months
#ASSERT `s 2(a)(5)(b) the spouses may change their choice` FALSE 0 EQUALS JUST TRUE
#ASSERT `s 2(a)(5)(b) the spouses may change their choice` TRUE 5 EQUALS NOTHING
#ASSERT `s 2(a)(5)(b) the spouses may change their choice` TRUE 6 EQUALS JUST TRUE
#ASSERT `s 2(a)(5)(b) the spouses may change their choice` TRUE 0 EQUALS NOTHING
-- (c): the first of the following month (the year rolls over after December)
#ASSERT `s 2(a)(5)(c) the day the choice takes effect` (Date 15 1 2026) EQUALS Date 1 2 2026
#ASSERT `s 2(a)(5)(c) the day the choice takes effect` (Date 31 1 2026) EQUALS Date 1 2 2026
#ASSERT `s 2(a)(5)(c) the day the choice takes effect` (Date 1 12 2026) EQUALS Date 1 1 2027

§ `s 2(a)(7) to (9)`
#ASSERT `s 2(a)(7) the person's main time goes to caring for a sick spouse or child` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2(a)(7) the person's main time goes to caring for a sick spouse or child` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2(a)(7) the person's main time goes to caring for a sick spouse or child` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2(a)(7) the person's main time goes to caring for a sick spouse or child` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2(a)(8) the person performs community service` TRUE EQUALS JUST TRUE
#ASSERT `s 2(a)(8) the person performs community service` FALSE EQUALS JUST FALSE
-- "more than 30 days": 31 yes; 30 or fewer is a stated period she has not yet passed, so the text does not say no (NOTHING)
#ASSERT `s 2(a)(9) the woman stays in a shelter for battered women` TRUE TRUE 31 EQUALS JUST TRUE
#ASSERT `s 2(a)(9) the woman stays in a shelter for battered women` TRUE TRUE 30 EQUALS NOTHING
#ASSERT `s 2(a)(9) the woman stays in a shelter for battered women` TRUE TRUE 1 EQUALS NOTHING
-- no approved stay in a shelter at all: the text's no (reading (a)), whatever the number of days
#ASSERT `s 2(a)(9) the woman stays in a shelter for battered women` TRUE FALSE 40 EQUALS JUST FALSE
#ASSERT `s 2(a)(9) the woman stays in a shelter for battered women` TRUE FALSE 0 EQUALS JUST FALSE
-- the paragraph says "she"
#ASSERT `s 2(a)(9) the woman stays in a shelter for battered women` FALSE TRUE 40 EQUALS NOTHING

