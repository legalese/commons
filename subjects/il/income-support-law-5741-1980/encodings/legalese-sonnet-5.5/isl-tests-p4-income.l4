§ `s 12 -- 55 or over, below retirement age`
-- arguments: paid under s 5(a)(2)(b), employed with reduced capacity, paid a survivors' or dependants' pension
#ASSERT `s 12(a) the section applies to the claimant` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 12(a) the section applies to the claimant` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 12(a) the section applies to the claimant` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 12(a) the section applies to the claimant` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 12(a) the section applies to the claimant` FALSE FALSE FALSE EQUALS NOTHING
-- (a)(1): 13% of 10,000 is 1,300 for an individual, 17% is 1,700 with a spouse or a child; each earner separately, never more than their own income
#ASSERT `s 12(a)(1) the deduction from earnings` figures (LIST 1000) FALSE EQUALS 1000
#ASSERT `s 12(a)(1) the deduction from earnings` figures (LIST 1300) FALSE EQUALS 1300
#ASSERT `s 12(a)(1) the deduction from earnings` figures (LIST 1301) FALSE EQUALS 1300
#ASSERT `s 12(a)(1) the deduction from earnings` figures (LIST 2000) FALSE EQUALS 1300
#ASSERT `s 12(a)(1) the deduction from earnings` figures (LIST 1700) TRUE EQUALS 1700
#ASSERT `s 12(a)(1) the deduction from earnings` figures (LIST 5000) TRUE EQUALS 1700
#ASSERT `s 12(a)(1) the deduction from earnings` figures (LIST 1000, 1000) TRUE EQUALS 2000
#ASSERT `s 12(a)(1) the deduction from earnings` figures (LIST 5000, 5000) TRUE EQUALS 3400
#ASSERT `s 12(a)(1) the deduction from earnings` figures (LIST) FALSE EQUALS 0
-- (a)(2): 40% of the earnings after the paragraph (1) amount
#ASSERT `s 12(a)(2) the deduction from earnings after paragraph (1)` (LIST 5000) 1300 EQUALS 1480
#ASSERT `s 12(a)(2) the deduction from earnings after paragraph (1)` (LIST 1000) 1000 EQUALS 0
#ASSERT `s 12(a)(2) the deduction from earnings after paragraph (1)` (LIST 5000, 5000) 3400 EQUALS 2640
-- (a)(2)(a)-(b): independent parent; 33.81% of 10,000 is 3,381
#ASSERT `s 12(a)(2)(a)-(b) the deduction for an independent parent` figures (LIST 1000) 1000 EQUALS 0
#ASSERT `s 12(a)(2)(a)-(b) the deduction for an independent parent` figures (LIST 3381) 1700 EQUALS 1260.75
#ASSERT `s 12(a)(2)(a)-(b) the deduction for an independent parent` figures (LIST 3382) 1700 EQUALS 1261.15
#ASSERT `s 12(a)(2)(a)-(b) the deduction for an independent parent` figures (LIST 5000) 1700 EQUALS 1908.35
-- (a)(3): pension income
#ASSERT `s 12(a)(3) the deduction from pension income` figures 5000 FALSE EQUALS 1300
#ASSERT `s 12(a)(3) the deduction from pension income` figures 1000 FALSE EQUALS 1000
#ASSERT `s 12(a)(3) the deduction from pension income` figures 5000 TRUE EQUALS 1700
-- (b): the limit on (a)(1) and (3) together
#ASSERT `s 12(b) the deductions under (a)(1) and (3) together` figures 1300 1300 FALSE EQUALS 1300
#ASSERT `s 12(b) the deductions under (a)(1) and (3) together` figures 1000 200 FALSE EQUALS 1200
#ASSERT `s 12(b) the deductions under (a)(1) and (3) together` figures 1000 300 FALSE EQUALS 1300
#ASSERT `s 12(b) the deductions under (a)(1) and (3) together` figures 1000 301 FALSE EQUALS 1300
#ASSERT `s 12(b) the deductions under (a)(1) and (3) together` figures 1700 1700 TRUE EQUALS 1700
#ASSERT `s 12(b) the deductions under (a)(1) and (3) together` figures 1000 600 TRUE EQUALS 1600
#ASSERT `s 12(b) the deductions under (a)(1) and (3) together` figures 1000 700 TRUE EQUALS 1700
#ASSERT `s 12(b) the deductions under (a)(1) and (3) together` figures 1000 701 TRUE EQUALS 1700
-- the income that remains: an individual earning 5,000: 5000 - 1300 - 0.4 * 3700 = 2220
#ASSERT `s 12 the income after the deductions` figures (LIST 5000) 0 0 FALSE FALSE (JUST TRUE) EQUALS JUST 2220
-- with a pension of 3,000 and 200 other income: (a)(1)+(3) limited to 1,300; total 8,200 - 1,300 - 1,480 = 5,420
#ASSERT `s 12 the income after the deductions` figures (LIST 5000) 3000 200 FALSE FALSE (JUST TRUE) EQUALS JUST 5420
-- an independent parent (with a child): 5000 - 1700 - 1908.35 = 1391.65
#ASSERT `s 12 the income after the deductions` figures (LIST 5000) 0 0 TRUE TRUE (JUST TRUE) EQUALS JUST 1391.65
-- earnings entirely deducted
#ASSERT `s 12 the income after the deductions` figures (LIST 1000) 0 0 FALSE FALSE (JUST TRUE) EQUALS JUST 0
-- two earners, a couple: (1) 1700 + 1700 = 3400 limited to 1,700; (2) 40% of (10,000 - 3,400) = 2,640; 10,000 - 1,700 - 2,640 = 5,660
#ASSERT `s 12 the income after the deductions` figures (LIST 5000, 5000) 0 0 TRUE FALSE (JUST TRUE) EQUALS JUST 5660
#ASSERT `s 12 the income after the deductions` figures (LIST 5000) 0 0 FALSE FALSE NOTHING EQUALS NOTHING
#ASSERT `s 12 the income after the deductions` figures (LIST 5000) 0 0 FALSE FALSE (JUST FALSE) EQUALS NOTHING

