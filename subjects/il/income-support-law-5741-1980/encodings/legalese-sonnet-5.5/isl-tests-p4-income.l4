#ASSERT `s 12A(b) the deductions under (a)(1) and (3) together` figures 200 200 FALSE EQUALS 400
#ASSERT `s 12A(b) the deductions under (a)(1) and (3) together` figures 700 700 TRUE EQUALS 700
#ASSERT `s 12A(b) the deductions under (a)(1) and (3) together` figures 300 400 TRUE EQUALS 700
#ASSERT `s 12A(b) the deductions under (a)(1) and (3) together` figures 300 401 TRUE EQUALS 700
