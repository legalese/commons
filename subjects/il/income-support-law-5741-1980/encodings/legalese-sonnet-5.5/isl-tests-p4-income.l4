#ASSERT `s 12B(b) the deductions under (a)(1) and (3) together` figures 1000 1000 FALSE EQUALS 2000
#ASSERT `s 12B(b) the deductions under (a)(1) and (3) together` figures 2750 2050 TRUE EQUALS 2750
-- the income that remains: earnings 5,000 and a pension of 3,000, an individual: 8,000 - 2,350 - 1,060 = 4,590
#ASSERT `s 12B the income after the deductions` figures (LIST 5000) 3000 0 FALSE FALSE (JUST TRUE) EQUALS JUST 4590
#ASSERT `s 12B the income after the deductions` figures (LIST 5000) 3000 0 FALSE FALSE NOTHING EQUALS NOTHING

§ `Third Schedule`
-- arguments: the household, an individual entitled under s 30A, both spouses entitled under s 30A
#ASSERT `sch 3 which row of the table applies to the household` `an independent parent with a child` FALSE FALSE EQUALS JUST 1
#ASSERT `sch 3 which row of the table applies to the household` `a widow with a child` FALSE FALSE EQUALS JUST 1
#ASSERT `sch 3 which row of the table applies to the household` `a widow with no child` FALSE FALSE EQUALS JUST 4
#ASSERT `sch 3 which row of the table applies to the household` `a couple with two children` FALSE FALSE EQUALS JUST 2
#ASSERT `sch 3 which row of the table applies to the household` `a couple with three children` FALSE FALSE EQUALS JUST 2
#ASSERT `sch 3 which row of the table applies to the household` `a couple with a child` FALSE FALSE EQUALS JUST 3
#ASSERT `sch 3 which row of the table applies to the household` `a couple` FALSE FALSE EQUALS JUST 4
#ASSERT `sch 3 which row of the table applies to the household` `a couple` FALSE TRUE EQUALS JUST 3
#ASSERT `sch 3 which row of the table applies to the household` `a single person` TRUE FALSE EQUALS JUST 3
#ASSERT `sch 3 which row of the table applies to the household` `a single person` FALSE FALSE EQUALS JUST 4
#ASSERT `sch 3 which row of the table applies to the household` `a single person with a child` FALSE FALSE EQUALS JUST 4
-- the rows overlap and the table gives no priority: a household that fits two rows gets NOTHING, not the first row printed
#ASSERT `sch 3 which row of the table applies to the household` `an independent parent with a child` TRUE FALSE EQUALS NOTHING
#ASSERT `sch 3 which row of the table applies to the household` `a widow with a child` TRUE FALSE EQUALS NOTHING
#ASSERT `sch 3 which row of the table applies to the household` `a couple with two children` FALSE TRUE EQUALS NOTHING
#ASSERT `sch 3 which row of the table applies to the household` `a couple with three children` FALSE TRUE EQUALS NOTHING
-- rows 1 and 3 together need a widow or an independent parent (row 1 names both) who is an individual under s 30A; rows 2 and 3 together need two or more children and both spouses under s 30A
#ASSERT `sch 3 which row of the table applies to the household` `an independent parent with a child` FALSE TRUE EQUALS JUST 1
#ASSERT `sch 3 which row of the table applies to the household` `a widow with a child` FALSE TRUE EQUALS JUST 1
#ASSERT `sch 3 which row of the table applies to the household` `a couple with a child` FALSE TRUE EQUALS JUST 3
#ASSERT `sch 3 which row of the table applies to the household` `a widow with no child` TRUE FALSE EQUALS JUST 3
#ASSERT `sch 3 which row of the table applies to the household` `a couple with two children` TRUE FALSE EQUALS JUST 2
-- the flag for one individual entitled under s 30A means nothing for a couple
#ASSERT `sch 3 which row of the table applies to the household` `a couple` TRUE FALSE EQUALS JUST 4
-- the rate for the household: the rate in its row, NOTHING where it fits two rows
#ASSERT `sch 3 the rate of deduction for the household` `an independent parent with a child` FALSE FALSE EQUALS JUST (40%)
#ASSERT `sch 3 the rate of deduction for the household` `a widow with a child` FALSE FALSE EQUALS JUST (40%)
#ASSERT `sch 3 the rate of deduction for the household` `a couple with two children` FALSE FALSE EQUALS JUST (37.5%)
#ASSERT `sch 3 the rate of deduction for the household` `a couple with a child` FALSE FALSE EQUALS JUST (32.5%)
#ASSERT `sch 3 the rate of deduction for the household` `a single person` TRUE FALSE EQUALS JUST (32.5%)
#ASSERT `sch 3 the rate of deduction for the household` `a single person` FALSE FALSE EQUALS JUST (30%)
#ASSERT `sch 3 the rate of deduction for the household` `a couple with two children` FALSE TRUE EQUALS NOTHING
#ASSERT `sch 3 the rate of deduction for the household` `an independent parent with a child` TRUE FALSE EQUALS NOTHING
#ASSERT `sch 3 the rate of deduction for the household` `a widow with a child` TRUE FALSE EQUALS NOTHING
#ASSERT `sch 3 the rate in the table row` 1 EQUALS JUST (40%)
#ASSERT `sch 3 the rate in the table row` 2 EQUALS JUST (37.5%)
#ASSERT `sch 3 the rate in the table row` 3 EQUALS JUST (32.5%)
#ASSERT `sch 3 the rate in the table row` 4 EQUALS JUST (30%)
#ASSERT `sch 3 the rate in the table row` 0 EQUALS NOTHING
#ASSERT `sch 3 the rate in the table row` 5 EQUALS NOTHING
