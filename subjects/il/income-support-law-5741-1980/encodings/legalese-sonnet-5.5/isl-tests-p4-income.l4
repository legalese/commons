IMPORT prelude
IMPORT daydate
IMPORT `isl-nouns`
IMPORT `isl-p4-income`

-- Tests for Chapter 4 (ss 9, 9A, 10, 11, 12, 12A, 12B and the Third Schedule).  Expected values are worked out by hand from the text, beside each assertion.
-- Figures: basic amount 1,000; average wage 10,000 (so 5% is 500, 7% is 700, 13% is 1,300, 17% is 1,700, 23.5% is 2,350, 27.5% is 2,750, 33.81% is 3,381).

§ `Fixtures`
`figures` MEANS Figures OF 1000, 10000, 200, 300
--                       basic, average wage, child basic, pension point
`a single person` MEANS Household OF FALSE, 0, FALSE, FALSE
`a couple` MEANS Household OF TRUE, 0, FALSE, FALSE
`a couple with a child` MEANS Household OF TRUE, 1, FALSE, FALSE
`a couple with two children` MEANS Household OF TRUE, 2, FALSE, FALSE
`a couple with three children` MEANS Household OF TRUE, 3, FALSE, FALSE
`a single person with a child` MEANS Household OF FALSE, 1, FALSE, FALSE
`a widow with no child` MEANS Household OF FALSE, 0, TRUE, FALSE
`an independent parent with a child` MEANS Household OF FALSE, 1, FALSE, TRUE
`a widow with a child` MEANS Household OF FALSE, 1, TRUE, FALSE

§ `s 9(a) "income"`
#ASSERT `s 9(a) "income" the receipt is income` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 9(a) "income" the receipt is income` FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 9(a) "income" the receipt is income` FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 9(a) "income" the receipt is income` FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 9(a) "income" the receipt is income` FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- "ולרבות": a receipt that is none of the five is not thereby said not to be income
#ASSERT `s 9(a) "income" the receipt is income` FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING

§ `s 9(b1) -- the disengagement payment`
#ASSERT `s 9(b1)(1) the one-off payment is treated as property` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 9(b1)(1) the one-off payment is treated as property` TRUE FALSE EQUALS NOTHING
#ASSERT `s 9(b1)(1) the one-off payment is treated as property` FALSE TRUE EQUALS NOTHING
#ASSERT `s 9(b1)(2)(a) the instalment payment is counted as income` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 9(b1)(2)(a) the instalment payment is counted as income` TRUE FALSE EQUALS NOTHING
#ASSERT `s 9(b1)(2)(a) the instalment payment is counted as income` FALSE TRUE EQUALS NOTHING
#ASSERT `s 9(b1)(2)(b) the property the claimant is treated as having` TRUE TRUE 50000 TRUE EQUALS JUST 50000
#ASSERT `s 9(b1)(2)(b) the property the claimant is treated as having` TRUE TRUE 50000 FALSE EQUALS NOTHING
#ASSERT `s 9(b1)(2)(b) the property the claimant is treated as having` TRUE FALSE 50000 TRUE EQUALS NOTHING
#ASSERT `s 9(b1)(2)(b) the property the claimant is treated as having` FALSE TRUE 50000 TRUE EQUALS NOTHING
-- the income from the deemed property is at most the instalment
#ASSERT `s 9(b1)(2)(b) the income counted from the deemed property` 800 500 EQUALS 500
#ASSERT `s 9(b1)(2)(b) the income counted from the deemed property` 300 500 EQUALS 300
#ASSERT `s 9(b1)(2)(b) the income counted from the deemed property` 500 500 EQUALS 500

§ `s 9(c) -- property`
#ASSERT `s 9(c) "property" the thing is property` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 9(c) "property" the thing is property` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 9(c) "property" the thing is property` TRUE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 9(c) "property" the thing is property` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 9(c) "property" the thing is property` FALSE FALSE FALSE FALSE EQUALS NOTHING
-- an exception applies even where the base kind is not asserted
#ASSERT `s 9(c) "property" the thing is property` FALSE TRUE FALSE FALSE EQUALS JUST FALSE

§ `s 9(c) -- "amount not counted", limb (1)`
-- without a child or a spouse: four times the basic amount, 4,000
#ASSERT `s 9(c) "amount not counted" (1) the sum of money is not counted` figures 0 FALSE EQUALS JUST TRUE
#ASSERT `s 9(c) "amount not counted" (1) the sum of money is not counted` figures 4000 FALSE EQUALS JUST TRUE
#ASSERT `s 9(c) "amount not counted" (1) the sum of money is not counted` figures 4001 FALSE EQUALS NOTHING
-- with a child or a spouse: six times, 6,000
#ASSERT `s 9(c) "amount not counted" (1) the sum of money is not counted` figures 4001 TRUE EQUALS JUST TRUE
#ASSERT `s 9(c) "amount not counted" (1) the sum of money is not counted` figures 6000 TRUE EQUALS JUST TRUE
#ASSERT `s 9(c) "amount not counted" (1) the sum of money is not counted` figures 6001 TRUE EQUALS NOTHING

§ `s 9(c) -- "amount not counted", limb (2): the sale of the home`
-- the sum was received on 15 March 2026
#ASSERT `s 9(c) "amount not counted" (2) the sale proceeds are not counted on the day` FALSE (Date 15 3 2026) (Date 16 3 2026) NOTHING EQUALS NOTHING
#ASSERT `s 9(c) "amount not counted" (2) the sale proceeds are not counted on the day` TRUE (Date 15 3 2026) (Date 14 3 2026) NOTHING EQUALS NOTHING
#ASSERT `s 9(c) "amount not counted" (2) the sale proceeds are not counted on the day` TRUE (Date 15 3 2026) (Date 15 3 2026) NOTHING EQUALS JUST TRUE
#ASSERT `s 9(c) "amount not counted" (2) the sale proceeds are not counted on the day` TRUE (Date 15 3 2026) (Date 15 3 2027) NOTHING EQUALS JUST TRUE
#ASSERT `s 9(c) "amount not counted" (2) the sale proceeds are not counted on the day` TRUE (Date 15 3 2026) (Date 16 3 2027) NOTHING EQUALS NOTHING
-- another dwelling bought on 1 June 2026 ends the period that day
#ASSERT `s 9(c) "amount not counted" (2) the sale proceeds are not counted on the day` TRUE (Date 15 3 2026) (Date 1 6 2026) (JUST (Date 1 6 2026)) EQUALS JUST TRUE
#ASSERT `s 9(c) "amount not counted" (2) the sale proceeds are not counted on the day` TRUE (Date 15 3 2026) (Date 2 6 2026) (JUST (Date 1 6 2026)) EQUALS NOTHING
-- a purchase after the 12 months does not stretch the period
#ASSERT `s 9(c) "amount not counted" (2) the sale proceeds are not counted on the day` TRUE (Date 15 3 2026) (Date 15 3 2027) (JUST (Date 1 6 2027)) EQUALS JUST TRUE
#ASSERT `s 9(c) "amount not counted" (2) the sale proceeds are not counted on the day` TRUE (Date 15 3 2026) (Date 16 3 2027) (JUST (Date 1 6 2027)) EQUALS NOTHING
-- received on a leap day: twelve months later is 28 February 2029
#ASSERT `s 9(c) "amount not counted" (2) the sale proceeds are not counted on the day` TRUE (Date 29 2 2028) (Date 28 2 2029) NOTHING EQUALS JUST TRUE
#ASSERT `s 9(c) "amount not counted" (2) the sale proceeds are not counted on the day` TRUE (Date 29 2 2028) (Date 1 3 2029) NOTHING EQUALS NOTHING

§ `s 9A(a) -- the three definitions`
#ASSERT `s 9A(a) "owner of a vehicle" the person is one` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 9A(a) "owner of a vehicle" the person is one` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 9A(a) "owner of a vehicle" the person is one` FALSE FALSE EQUALS NOTHING
#ASSERT `s 9A(a) "vehicle" the thing is a vehicle` TRUE EQUALS JUST TRUE
#ASSERT `s 9A(a) "vehicle" the thing is a vehicle` FALSE EQUALS JUST FALSE
#ASSERT `s 9A(a) "claimant" the person is one for this section` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 9A(a) "claimant" the person is one for this section` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 9A(a) "claimant" the person is one for this section` FALSE FALSE EQUALS NOTHING

§ `s 9A(b) -- the vehicle limits`
#ASSERT `s 9A(b) the figure the text states for a claimant to whom s 5(a)(1) applies` EQUALS 60000
#ASSERT `s 9A(b1) the figure the text states for a non-working claimant to whom s 5(a)(1) applies` EQUALS 10309
-- arguments: number of vehicles, value of the most valuable, the Minister's amount, s 5(a)(1) applies, updated 60,000, an exception holds
#ASSERT `s 9A(b) the claimant is not entitled because of their vehicles` 2 100000 NOTHING TRUE 60000 TRUE EQUALS JUST FALSE
#ASSERT `s 9A(b) the claimant is not entitled because of their vehicles` 3 1 NOTHING FALSE 60000 FALSE EQUALS JUST TRUE
#ASSERT `s 9A(b) the claimant is not entitled because of their vehicles` 2 1 NOTHING FALSE 60000 FALSE EQUALS JUST TRUE
#ASSERT `s 9A(b) the claimant is not entitled because of their vehicles` 1 1 NOTHING FALSE 60000 FALSE EQUALS NOTHING
#ASSERT `s 9A(b) the claimant is not entitled because of their vehicles` 0 0 NOTHING TRUE 60000 FALSE EQUALS NOTHING
-- s 5(a)(1): more than 60,000 takes entitlement away, 60,000 itself does not
#ASSERT `s 9A(b) the claimant is not entitled because of their vehicles` 1 60000 NOTHING TRUE 60000 FALSE EQUALS NOTHING
#ASSERT `s 9A(b) the claimant is not entitled because of their vehicles` 1 60001 NOTHING TRUE 60000 FALSE EQUALS JUST TRUE
-- the updated figure governs for such a claimant, not the Minister's amount
#ASSERT `s 9A(b) the claimant is not entitled because of their vehicles` 1 70000 (JUST 100000) TRUE 65000 FALSE EQUALS JUST TRUE
-- anyone else: the Minister's amount
#ASSERT `s 9A(b) the claimant is not entitled because of their vehicles` 1 80000 (JUST 80000) FALSE 60000 FALSE EQUALS NOTHING
#ASSERT `s 9A(b) the claimant is not entitled because of their vehicles` 1 80001 (JUST 80000) FALSE 60000 FALSE EQUALS JUST TRUE
#ASSERT `s 9A(b) the claimant is not entitled because of their vehicles` 1 999999 NOTHING FALSE 60000 FALSE EQUALS NOTHING

§ `s 9A(b1) -- a deduction for one vehicle`
-- arguments: one vehicle within the (b) amounts, s 5(a)(1) applies, the claimant works, value, updated 10,309, the Minister's deduction
#ASSERT `s 9A(b1) the deduction from the benefit for the vehicle` FALSE TRUE FALSE 20000 10309 (JUST 50) EQUALS NOTHING
#ASSERT `s 9A(b1) the deduction from the benefit for the vehicle` TRUE TRUE FALSE 10309 10309 (JUST 50) EQUALS JUST 0
#ASSERT `s 9A(b1) the deduction from the benefit for the vehicle` TRUE TRUE FALSE 10310 10309 (JUST 50) EQUALS JUST 50
#ASSERT `s 9A(b1) the deduction from the benefit for the vehicle` TRUE TRUE FALSE 10310 10309 NOTHING EQUALS NOTHING
#ASSERT `s 9A(b1) the deduction from the benefit for the vehicle` TRUE FALSE FALSE 5000 10309 (JUST 30) EQUALS JUST 30
-- a claimant who works is not within the proviso
#ASSERT `s 9A(b1) the deduction from the benefit for the vehicle` TRUE TRUE TRUE 5000 10309 (JUST 30) EQUALS JUST 30

§ `s 9A(c) -- the exceptions`
-- (2) "family member": driven to treatment, spouse/son/daughter/parent, sibling living with, has another vehicle
#ASSERT `s 9A(c)(2) "family member" the person is one` FALSE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 9A(c)(2) "family member" the person is one` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 9A(c)(2) "family member" the person is one` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 9A(c)(2) "family member" the person is one` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 9A(c)(2) "family member" the person is one` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- (2) needed: needs, plan, treatments a month, consecutive days, the Minister's rules met
#ASSERT `s 9A(c)(2) the vehicle is needed for medical treatment` FALSE TRUE 10 200 TRUE EQUALS NOTHING
#ASSERT `s 9A(c)(2) the vehicle is needed for medical treatment` TRUE TRUE 0 0 TRUE EQUALS JUST TRUE
#ASSERT `s 9A(c)(2) the vehicle is needed for medical treatment` TRUE TRUE 0 0 FALSE EQUALS NOTHING
#ASSERT `s 9A(c)(2) the vehicle is needed for medical treatment` TRUE FALSE 6 91 TRUE EQUALS JUST TRUE
#ASSERT `s 9A(c)(2) the vehicle is needed for medical treatment` TRUE FALSE 6 90 TRUE EQUALS NOTHING
#ASSERT `s 9A(c)(2) the vehicle is needed for medical treatment` TRUE FALSE 5 91 TRUE EQUALS NOTHING
-- (3) disabled in the legs: disabled, paid from the treasury, doctor found a need, the Minister's rules met
#ASSERT `s 9A(c)(3) the person disabled in the legs` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 9A(c)(3) the person disabled in the legs` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 9A(c)(3) the person disabled in the legs` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 9A(c)(3) the person disabled in the legs` TRUE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 9A(c)(3) the person disabled in the legs` TRUE FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 9A(c)(3A) the driving licensee of a disabled person` TRUE EQUALS JUST TRUE
#ASSERT `s 9A(c)(3A) the driving licensee of a disabled person` FALSE EQUALS NOTHING
#ASSERT `s 9A(c)(4) a pension is paid for the claimant's child` TRUE EQUALS JUST TRUE
#ASSERT `s 9A(c)(4) a pension is paid for the claimant's child` FALSE EQUALS NOTHING
-- (5)(a): licence deposited, cannot work because of illness, the day the claim was submitted, the day asked about
#ASSERT `s 9A(c)(5)(a) the claimant is ill and the licence is deposited` FALSE TRUE (Date 10 1 2026) (Date 10 2 2026) EQUALS NOTHING
#ASSERT `s 9A(c)(5)(a) the claimant is ill and the licence is deposited` TRUE FALSE (Date 10 1 2026) (Date 10 2 2026) EQUALS NOTHING
#ASSERT `s 9A(c)(5)(a) the claimant is ill and the licence is deposited` TRUE TRUE (Date 10 1 2026) (Date 10 7 2026) EQUALS JUST TRUE
#ASSERT `s 9A(c)(5)(a) the claimant is ill and the licence is deposited` TRUE TRUE (Date 10 1 2026) (Date 11 7 2026) EQUALS NOTHING
-- six months from 31 August 2026 ends on 28 February 2027 (a short month clamps)
#ASSERT `s 9A(c)(5)(a) the claimant is ill and the licence is deposited` TRUE TRUE (Date 31 8 2026) (Date 28 2 2027) EQUALS JUST TRUE
#ASSERT `s 9A(c)(5)(a) the claimant is ill and the licence is deposited` TRUE TRUE (Date 31 8 2026) (Date 1 3 2027) EQUALS NOTHING
-- (5)(b): licence deposited, a tractor, not in use, an inactive farm
#ASSERT `s 9A(c)(5)(b) the tractor of an inactive farm` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 9A(c)(5)(b) the tractor of an inactive farm` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 9A(c)(5)(b) the tractor of an inactive farm` TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 9A(c)(5)(b) the tractor of an inactive farm` TRUE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 9A(c)(5)(b) the tractor of an inactive farm` TRUE TRUE TRUE FALSE EQUALS NOTHING
-- (c) as a whole: a closed list; none holding means (b) applies, which is a plain no here
#ASSERT `s 9A(c) one of the exceptions holds` (LIST NOTHING, JUST TRUE, NOTHING) EQUALS TRUE
#ASSERT `s 9A(c) one of the exceptions holds` (LIST NOTHING, NOTHING, NOTHING) EQUALS FALSE
#ASSERT `s 9A(c) one of the exceptions holds` (LIST JUST FALSE, JUST FALSE) EQUALS FALSE
#ASSERT `s 9A(c) one of the exceptions holds` (LIST) EQUALS FALSE

