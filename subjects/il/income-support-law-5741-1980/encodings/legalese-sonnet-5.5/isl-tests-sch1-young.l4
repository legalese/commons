#ASSERT `sch 1 item 23 a new immigrant studying at an ulpan` (JUST FALSE) 18 TRUE EQUALS JUST FALSE
#ASSERT `sch 1 item 23 a new immigrant studying at an ulpan` (JUST TRUE) 17 TRUE EQUALS NOTHING
#ASSERT `sch 1 item 23 a new immigrant studying at an ulpan` (JUST TRUE) 18 FALSE EQUALS NOTHING
#ASSERT `sch 1 item 24 disability allowance as a housewife` TRUE EQUALS JUST TRUE
#ASSERT `sch 1 item 24 disability allowance as a housewife` FALSE EQUALS NOTHING
-- item 25(a): more than 30 days
#ASSERT `sch 1 item 25(a) the child of a detained or imprisoned parent` TRUE TRUE 31 TRUE EQUALS JUST TRUE
#ASSERT `sch 1 item 25(a) the child of a detained or imprisoned parent` TRUE TRUE 30 TRUE EQUALS NOTHING
#ASSERT `sch 1 item 25(a) the child of a detained or imprisoned parent` TRUE TRUE 31 FALSE EQUALS NOTHING
#ASSERT `sch 1 item 25(a) the child of a detained or imprisoned parent` FALSE TRUE 31 TRUE EQUALS NOTHING
-- item 25(b): one benefit only, whatever the number of children
#ASSERT `sch 1 item 25(b) the benefit for the children of a detained or imprisoned parent` 1 5974 EQUALS JUST 5974
#ASSERT `sch 1 item 25(b) the benefit for the children of a detained or imprisoned parent` 3 5974 EQUALS JUST 5974
#ASSERT `sch 1 item 25(b) the benefit for the children of a detained or imprisoned parent` 0 5974 EQUALS NOTHING
#ASSERT `sch 1 item 25(c) the parent's income may be counted` TRUE EQUALS JUST TRUE
#ASSERT `sch 1 item 25(c) the parent's income may be counted` FALSE EQUALS NOTHING
