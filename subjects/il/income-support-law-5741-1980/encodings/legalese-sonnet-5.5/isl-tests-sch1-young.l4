IMPORT prelude
IMPORT daydate
IMPORT `isl-nouns`
IMPORT `isl-sch1-young`

-- Tests for the First Schedule (items 1 to 26).  Figures: basic amount 10,000; pension point 300 (round numbers for hand checking).

`figures for the schedule` MEANS Figures OF 10000, 11000, 200, 300

§ `Item 1 -- definitions`
-- "absent": any one of the three
#ASSERT `sch 1 item 1(c) the parent is absent` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `sch 1 item 1(c) the parent is absent` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 1 item 1(c) the parent is absent` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 1 item 1(c) the parent is absent` FALSE FALSE FALSE EQUALS JUST FALSE
-- "orphan child": both parents, or one parent with the other absent
#ASSERT `sch 1 item 1(c) the child is an orphan child` TRUE FALSE NOTHING EQUALS JUST TRUE
#ASSERT `sch 1 item 1(c) the child is an orphan child` FALSE TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `sch 1 item 1(c) the child is an orphan child` FALSE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `sch 1 item 1(c) the child is an orphan child` FALSE FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `sch 1 item 1(c) the child is an orphan child` FALSE FALSE (JUST FALSE) EQUALS JUST FALSE
-- "child entitled to a special benefit": abandoned by the parents with one a resident
#ASSERT `sch 1 item 1(c) the child is a child entitled to a special benefit` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `sch 1 item 1(c) the child is a child entitled to a special benefit` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- or abandoned by the resident parent, the other parent being dead, absent or not living with him, and permanently unable
#ASSERT `sch 1 item 1(c) the child is a child entitled to a special benefit` FALSE FALSE TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 1 item 1(c) the child is a child entitled to a special benefit` FALSE FALSE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 1 item 1(c) the child is a child entitled to a special benefit` FALSE FALSE TRUE FALSE TRUE FALSE EQUALS JUST FALSE
-- excluding a child in a foster family
#ASSERT `sch 1 item 1(c) the child is a child entitled to a special benefit` TRUE TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE

§ `Item 1(a) -- the conditions`
#ASSERT `sch 1 item 1(a) the child meets the conditions` TRUE 10 FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `sch 1 item 1(a) the child meets the conditions` FALSE 10 FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `sch 1 item 1(a) the child meets the conditions` TRUE 10 FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 1 item 1(a) the child meets the conditions` TRUE 10 FALSE FALSE TRUE EQUALS JUST FALSE
-- under 18: no studies condition
#ASSERT `sch 1 item 1(a) the child meets the conditions` TRUE 17 FALSE FALSE FALSE EQUALS JUST TRUE
-- 18 and 19: main time must go to finishing school studies
#ASSERT `sch 1 item 1(a) the child meets the conditions` TRUE 18 FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 1 item 1(a) the child meets the conditions` TRUE 18 TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `sch 1 item 1(a) the child meets the conditions` TRUE 19 FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 1 item 1(a) the child meets the conditions` TRUE 19 TRUE FALSE FALSE EQUALS JUST TRUE
-- 20 and over: the text is silent
#ASSERT `sch 1 item 1(a) the child meets the conditions` TRUE 20 TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `sch 1 item 1(a) the child meets the conditions` TRUE 20 FALSE FALSE FALSE EQUALS NOTHING

§ `Item 1(b) -- the amounts`
-- one child: 25% of 10,000 less one point of 300
#ASSERT `sch 1 item 1(b) the benefit for the children` `figures for the schedule` 1 EQUALS JUST 2200
-- two children: 37.5% less two points
#ASSERT `sch 1 item 1(b) the benefit for the children` `figures for the schedule` 2 EQUALS JUST 3150
-- each further child adds 10% of the basic amount: 3150 + 1000, then + 1000
#ASSERT `sch 1 item 1(b) the benefit for the children` `figures for the schedule` 3 EQUALS JUST 4150
#ASSERT `sch 1 item 1(b) the benefit for the children` `figures for the schedule` 4 EQUALS JUST 5150
#ASSERT `sch 1 item 1(b) the benefit for the children` `figures for the schedule` 0 EQUALS NOTHING

§ `Item 1(b1) -- a child in a relative's custody`
#ASSERT `sch 1 item 1(b1) the person is a relative` `a brother` EQUALS JUST TRUE
#ASSERT `sch 1 item 1(b1) the person is a relative` `a sister` EQUALS JUST TRUE
#ASSERT `sch 1 item 1(b1) the person is a relative` `a grandfather` EQUALS JUST TRUE
#ASSERT `sch 1 item 1(b1) the person is a relative` `a grandmother` EQUALS JUST TRUE
#ASSERT `sch 1 item 1(b1) the person is a relative` `an uncle` EQUALS JUST TRUE
#ASSERT `sch 1 item 1(b1) the person is a relative` `an aunt` EQUALS JUST TRUE
#ASSERT `sch 1 item 1(b1) the person is a relative` `someone else` EQUALS JUST FALSE
-- up to six months from the claim, with the social services confirmation
#ASSERT `sch 1 item 1(b1) the benefit for a child in a relative's custody is paid for the month` TRUE TRUE 0 FALSE EQUALS JUST TRUE
#ASSERT `sch 1 item 1(b1) the benefit for a child in a relative's custody is paid for the month` TRUE TRUE 5 FALSE EQUALS JUST TRUE
-- six months completed: unless the Ministry's authorised person approves going on
#ASSERT `sch 1 item 1(b1) the benefit for a child in a relative's custody is paid for the month` TRUE TRUE 6 FALSE EQUALS JUST FALSE
#ASSERT `sch 1 item 1(b1) the benefit for a child in a relative's custody is paid for the month` TRUE TRUE 6 TRUE EQUALS JUST TRUE
-- no confirmation
#ASSERT `sch 1 item 1(b1) the benefit for a child in a relative's custody is paid for the month` TRUE FALSE 0 FALSE EQUALS JUST FALSE
-- not in a relative's custody: the paragraph does not speak
#ASSERT `sch 1 item 1(b1) the benefit for a child in a relative's custody is paid for the month` FALSE TRUE 0 FALSE EQUALS NOTHING

§ `Items 2 to 4`
#ASSERT `sch 1 item 2 the person aged 18 or over was paid under item 1 before reaching 18` 18 TRUE EQUALS JUST TRUE
#ASSERT `sch 1 item 2 the person aged 18 or over was paid under item 1 before reaching 18` 17 TRUE EQUALS NOTHING
#ASSERT `sch 1 item 2 the person aged 18 or over was paid under item 1 before reaching 18` 18 FALSE EQUALS NOTHING
#ASSERT `sch 1 item 3 the person is a parent of a child in their custody` TRUE EQUALS JUST TRUE
#ASSERT `sch 1 item 3 the person is a parent of a child in their custody` FALSE EQUALS NOTHING
#ASSERT `sch 1 item 4 the person's spouse is entitled` TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 1 item 4 the person's spouse is entitled` TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 1 item 4 the person's spouse is entitled` FALSE FALSE EQUALS NOTHING
#ASSERT `sch 1 item 4 the person's spouse is entitled` FALSE TRUE EQUALS NOTHING

§ `Items 5 to 7 -- pregnant women`
#ASSERT `sch 1 item 5 the woman lives with her parents who receive the benefit` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 1 item 5 the woman lives with her parents who receive the benefit` TRUE FALSE EQUALS NOTHING
#ASSERT `sch 1 item 5 the woman lives with her parents who receive the benefit` FALSE TRUE EQUALS NOTHING
-- row (1) of the Second Schedule, column B: 20%, less 5% of the basic amount: 15% of 10,000
#ASSERT `sch 1 item 5 the benefit before income` `figures for the schedule` EQUALS JUST 1500
#ASSERT `sch 1 item 6 the woman does not live with her parents` TRUE FALSE EQUALS JUST TRUE
-- living with parents who do not receive the benefit is in neither item 5 nor item 6 (a gap in the text)
#ASSERT `sch 1 item 6 the woman does not live with her parents` TRUE TRUE EQUALS NOTHING
#ASSERT `sch 1 item 6 the woman does not live with her parents` FALSE FALSE EQUALS NOTHING
-- item 7: 18 or over, from the 13th week
#ASSERT `sch 1 item 7 a pregnant woman aged 18 or over in or after week 13` 18 TRUE 13 EQUALS JUST TRUE
#ASSERT `sch 1 item 7 a pregnant woman aged 18 or over in or after week 13` 18 TRUE 12 EQUALS NOTHING
#ASSERT `sch 1 item 7 a pregnant woman aged 18 or over in or after week 13` 17 TRUE 13 EQUALS NOTHING
#ASSERT `sch 1 item 7 a pregnant woman aged 18 or over in or after week 13` 18 FALSE 20 EQUALS NOTHING

§ `Items 8 to 10`
#ASSERT `sch 1 item 8 severe distress` 18 TRUE 0 EQUALS JUST TRUE
#ASSERT `sch 1 item 8 severe distress` 18 TRUE 1 EQUALS JUST TRUE
-- two consecutive months already paid: the cap is reached
#ASSERT `sch 1 item 8 severe distress` 18 TRUE 2 EQUALS NOTHING
#ASSERT `sch 1 item 8 severe distress` 17 TRUE 0 EQUALS NOTHING
#ASSERT `sch 1 item 8 severe distress` 18 FALSE 0 EQUALS NOTHING
#ASSERT `sch 1 item 9 release from arrest or imprisonment` 18 6 0 0 EQUALS JUST TRUE
#ASSERT `sch 1 item 9 release from arrest or imprisonment` 18 6 1 1 EQUALS JUST TRUE
-- two months since release have passed
#ASSERT `sch 1 item 9 release from arrest or imprisonment` 18 6 2 0 EQUALS JUST FALSE
-- served only five months; under 18; two months already paid
#ASSERT `sch 1 item 9 release from arrest or imprisonment` 18 5 0 0 EQUALS NOTHING
#ASSERT `sch 1 item 9 release from arrest or imprisonment` 17 6 0 0 EQUALS NOTHING
#ASSERT `sch 1 item 9 release from arrest or imprisonment` 18 6 1 2 EQUALS NOTHING
#ASSERT `sch 1 item 10 illness lasting more than 30 days` 18 TRUE 31 0 0 4000 EQUALS JUST TRUE
-- exactly 30 days is not "more than 30"
#ASSERT `sch 1 item 10 illness lasting more than 30 days` 18 TRUE 30 0 0 4000 EQUALS NOTHING
-- five months paid: a sixth is allowed; six paid: the cap is reached
#ASSERT `sch 1 item 10 illness lasting more than 30 days` 18 TRUE 31 5 0 4000 EQUALS JUST TRUE
#ASSERT `sch 1 item 10 illness lasting more than 30 days` 18 TRUE 31 6 0 4000 EQUALS NOTHING
-- payment from another source: below the benefit, entitled; equal or above, not
#ASSERT `sch 1 item 10 illness lasting more than 30 days` 18 TRUE 31 0 3999 4000 EQUALS JUST TRUE
#ASSERT `sch 1 item 10 illness lasting more than 30 days` 18 TRUE 31 0 4000 4000 EQUALS JUST FALSE
#ASSERT `sch 1 item 10 illness lasting more than 30 days` 18 TRUE 31 0 5000 4000 EQUALS JUST FALSE
#ASSERT `sch 1 item 10 illness lasting more than 30 days` 17 TRUE 31 0 0 4000 EQUALS NOTHING
#ASSERT `sch 1 item 10 illness lasting more than 30 days` 18 FALSE 31 0 0 4000 EQUALS NOTHING
-- the earliest day is the first of the month in which the 30 days were completed
#ASSERT `sch 1 item 10 the earliest day of entitlement` (Date 20 3 2026) EQUALS Date 1 3 2026
#ASSERT `sch 1 item 10 the earliest day of entitlement` (Date 31 12 2026) EQUALS Date 1 12 2026
#ASSERT `sch 1 item 10 the earliest day of entitlement` (Date 1 6 2026) EQUALS Date 1 6 2026

§ `Items 11 to 17`
#ASSERT `sch 1 item 11 treatment under a probation order or supervision` 18 TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 1 item 11 treatment under a probation order or supervision` 18 FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 1 item 11 treatment under a probation order or supervision` 18 FALSE FALSE EQUALS NOTHING
#ASSERT `sch 1 item 11 treatment under a probation order or supervision` 17 TRUE TRUE EQUALS NOTHING
#ASSERT `sch 1 item 12 found not placeable by a diagnosis centre` 18 TRUE EQUALS JUST TRUE
#ASSERT `sch 1 item 12 found not placeable by a diagnosis centre` 18 FALSE EQUALS NOTHING
#ASSERT `sch 1 item 12 found not placeable by a diagnosis centre` 17 TRUE EQUALS NOTHING
#ASSERT `sch 1 item 13 an alcoholics treatment centre` 18 TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 1 item 13 an alcoholics treatment centre` 18 FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 1 item 13 an alcoholics treatment centre` 18 FALSE FALSE EQUALS NOTHING
#ASSERT `sch 1 item 14 incapacity to earn of 75% or more` 18 (JUST 75) EQUALS JUST TRUE
#ASSERT `sch 1 item 14 incapacity to earn of 75% or more` 18 (JUST 74) EQUALS NOTHING
#ASSERT `sch 1 item 14 incapacity to earn of 75% or more` 18 NOTHING EQUALS NOTHING
#ASSERT `sch 1 item 14 incapacity to earn of 75% or more` 17 (JUST 80) EQUALS NOTHING
#ASSERT `sch 1 item 15 injury allowance` 18 TRUE EQUALS JUST TRUE
#ASSERT `sch 1 item 15 injury allowance` 18 FALSE EQUALS NOTHING
#ASSERT `sch 1 item 16 imprisonment by community service` 18 TRUE EQUALS JUST TRUE
#ASSERT `sch 1 item 16 imprisonment by community service` 17 TRUE EQUALS NOTHING
#ASSERT `sch 1 item 17 sheltered workshop` 18 TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 1 item 17 sheltered workshop` 18 TRUE FALSE EQUALS NOTHING
#ASSERT `sch 1 item 17 sheltered workshop` 18 FALSE TRUE EQUALS NOTHING
#ASSERT `sch 1 item 17 sheltered workshop` 17 TRUE TRUE EQUALS NOTHING

§ `Items 18 to 21`
#ASSERT `sch 1 item 18 bail and electronic monitoring` 18 TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- bail with a ban, but the Institute's worker is not of the opinion that it prevents work
#ASSERT `sch 1 item 18 bail and electronic monitoring` 18 TRUE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `sch 1 item 18 bail and electronic monitoring` 18 FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `sch 1 item 18 bail and electronic monitoring` 18 FALSE FALSE FALSE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 1 item 18 bail and electronic monitoring` 18 FALSE FALSE FALSE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `sch 1 item 18 bail and electronic monitoring` 17 TRUE TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `sch 1 item 19 sleeping rough` 18 TRUE EQUALS JUST TRUE
#ASSERT `sch 1 item 19 sleeping rough` 18 FALSE EQUALS NOTHING
#ASSERT `sch 1 item 20 rehabilitation framework` 18 TRUE EQUALS JUST TRUE
#ASSERT `sch 1 item 20 rehabilitation framework` 17 TRUE EQUALS NOTHING
#ASSERT `sch 1 item 21 the conditions of s 2(a)(7) are met` 18 (JUST TRUE) EQUALS JUST TRUE
#ASSERT `sch 1 item 21 the conditions of s 2(a)(7) are met` 18 (JUST FALSE) EQUALS JUST FALSE
#ASSERT `sch 1 item 21 the conditions of s 2(a)(7) are met` 18 NOTHING EQUALS NOTHING
#ASSERT `sch 1 item 21 the conditions of s 2(a)(7) are met` 17 (JUST TRUE) EQUALS NOTHING

§ `Items 22 to 26`
#ASSERT `sch 1 item 22 dependants' or survivors' allowance` TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 1 item 22 dependants' or survivors' allowance` FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 1 item 22 dependants' or survivors' allowance` FALSE FALSE EQUALS NOTHING
