IMPORT prelude
IMPORT daydate
IMPORT `isl-nouns`
IMPORT `isl-p5-claims-payment`

-- Tests for Chapter 5, Sub-chapters A and B (ss 13, 14, 14A, 14B, 15, 17, 18).  Expected values are worked out by hand from the text, beside each assertion.

§ `Fixtures`
`figures` MEANS Figures OF 1000, 10000, 200, 300
--                       basic, average wage, child basic, pension point

§ `s 13(a) and s 14(a)`
#ASSERT `s 13(a) where a claim for a benefit is submitted` EQUALS "the National Insurance Institute -- המוסד לביטוח לאומי"
-- the benefit is paid from the 1st of the month in which the claim was submitted
#ASSERT `s 14(a) the first day for which the benefit is paid` (Date 31 1 2026) EQUALS Date 1 1 2026
#ASSERT `s 14(a) the first day for which the benefit is paid` (Date 1 1 2026) EQUALS Date 1 1 2026
#ASSERT `s 14(a) the first day for which the benefit is paid` (Date 15 12 2026) EQUALS Date 1 12 2026
-- the claim was submitted on 15 March 2026: arguments are the day of the claim, the day asked about, a regulation lets payment run from an earlier day
#ASSERT `s 14(a) the day is within the period for which the benefit is paid` (Date 15 3 2026) (Date 1 3 2026) FALSE EQUALS JUST TRUE
#ASSERT `s 14(a) the day is within the period for which the benefit is paid` (Date 15 3 2026) (Date 28 2 2026) FALSE EQUALS JUST FALSE
#ASSERT `s 14(a) the day is within the period for which the benefit is paid` (Date 15 3 2026) (Date 28 2 2026) TRUE EQUALS NOTHING
#ASSERT `s 14(a) the day is within the period for which the benefit is paid` (Date 15 3 2026) (Date 20 3 2026) FALSE EQUALS JUST TRUE
#ASSERT `s 14(a) the day is within the period for which the benefit is paid` (Date 15 3 2026) (Date 2 4 2026) TRUE EQUALS JUST TRUE

§ `s 14(c)`
-- arguments: reached retirement age and found entitled under s 2(a)(4) for an earlier period, months before the month of the claim, had reached retirement age in that month
#ASSERT `s 14(c)(1) the benefit is paid for a month before the month of the claim` FALSE 3 TRUE EQUALS NOTHING
#ASSERT `s 14(c)(1) the benefit is paid for a month before the month of the claim` TRUE 0 TRUE EQUALS NOTHING
#ASSERT `s 14(c)(1) the benefit is paid for a month before the month of the claim` TRUE 1 TRUE EQUALS JUST TRUE
#ASSERT `s 14(c)(1) the benefit is paid for a month before the month of the claim` TRUE 12 TRUE EQUALS JUST TRUE
#ASSERT `s 14(c)(1) the benefit is paid for a month before the month of the claim` TRUE 13 TRUE EQUALS JUST FALSE
#ASSERT `s 14(c)(1) the benefit is paid for a month before the month of the claim` TRUE 5 FALSE EQUALS JUST FALSE
#ASSERT `s 14(c)(1) the benefit is paid for a month before the month of the claim` TRUE 13 FALSE EQUALS JUST FALSE
#ASSERT `s 14(c)(2) "public body" the body is one` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 14(c)(2) "public body" the body is one` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 14(c)(2) "public body" the body is one` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 14(c)(2) "public body" the body is one` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 14(c)(2) the person paid under paragraph (1) is entitled to the privilege` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 14(c)(2) the person paid under paragraph (1) is entitled to the privilege` TRUE FALSE EQUALS NOTHING
#ASSERT `s 14(c)(2) the person paid under paragraph (1) is entitled to the privilege` FALSE TRUE EQUALS NOTHING
#ASSERT `s 14(c)(2) the person paid under paragraph (1) is entitled to the privilege` FALSE FALSE EQUALS NOTHING

§ `s 14A(a) and (b)`
-- (a): arguments are the retirement-age flag, left Israel, stayed outside on every day of the month
#ASSERT `s 14A(a) the benefit is not paid for the month` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 14A(a) the benefit is not paid for the month` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 14A(a) the benefit is not paid for the month` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 14A(a) the benefit is not paid for the month` FALSE FALSE TRUE EQUALS NOTHING
-- (b): arguments are the retirement-age flag, the month is exit or return, left before in the year, entitled the month before exit
#ASSERT `s 14A(b) the benefit is not paid for the month of exit and the month of return` TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 14A(b) the benefit is not paid for the month of exit and the month of return` FALSE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 14A(b) the benefit is not paid for the month of exit and the month of return` FALSE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 14A(b) the benefit is not paid for the month of exit and the month of return` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 14A(b) the benefit is not paid for the month of exit and the month of return` FALSE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 14A(b) the benefit is not paid for the month of exit and the month of return` FALSE TRUE FALSE TRUE EQUALS NOTHING
-- (c): arguments are the retirement-age flag, s 2(a)(2) or (3)-and-training applies, exit or return month, the condition holds throughout the month, (b) bars payment
#ASSERT `s 14A(c) the benefit is not paid for the month of exit and the month of return` TRUE TRUE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 14A(c) the benefit is not paid for the month of exit and the month of return` FALSE FALSE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 14A(c) the benefit is not paid for the month of exit and the month of return` FALSE TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 14A(c) the benefit is not paid for the month of exit and the month of return` FALSE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 14A(c) the benefit is not paid for the month of exit and the month of return` FALSE TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 14A(c) the benefit is not paid for the month of exit and the month of return` FALSE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 14A(c) the benefit is not paid for the month of exit and the month of return` FALSE TRUE TRUE FALSE TRUE EQUALS JUST TRUE

§ `s 14A(c1)`
-- arguments: retirement-age flag, times left in the year (both together), total days outside in the year, days outside before this month, days outside in this month, the fourth-time month
#ASSERT `s 14A(c1) the benefit is not paid for the month` FALSE 4 10 0 10 TRUE EQUALS NOTHING
-- (1): the fourth time
#ASSERT `s 14A(c1) the benefit is not paid for the month` TRUE 4 50 20 5 TRUE EQUALS JUST TRUE
#ASSERT `s 14A(c1) the benefit is not paid for the month` TRUE 4 50 20 5 FALSE EQUALS NOTHING
-- exactly four times: the day-count paragraphs are for "fewer than four times"
#ASSERT `s 14A(c1) the benefit is not paid for the month` TRUE 4 200 0 30 FALSE EQUALS NOTHING
-- (1A): more than four times, every month with any day outside
#ASSERT `s 14A(c1) the benefit is not paid for the month` TRUE 5 20 0 1 FALSE EQUALS JUST TRUE
#ASSERT `s 14A(c1) the benefit is not paid for the month` TRUE 7 20 0 3 FALSE EQUALS JUST TRUE
#ASSERT `s 14A(c1) the benefit is not paid for the month` TRUE 5 20 0 0 FALSE EQUALS NOTHING
-- (2): fewer than four times and more than 72 days; (a) the months holding days 73 to 100
#ASSERT `s 14A(c1) the benefit is not paid for the month` TRUE 3 72 0 72 FALSE EQUALS NOTHING
#ASSERT `s 14A(c1) the benefit is not paid for the month` TRUE 3 73 60 13 FALSE EQUALS JUST TRUE
#ASSERT `s 14A(c1) the benefit is not paid for the month` TRUE 3 80 60 12 FALSE EQUALS NOTHING
#ASSERT `s 14A(c1) the benefit is not paid for the month` TRUE 3 90 99 1 FALSE EQUALS JUST TRUE
#ASSERT `s 14A(c1) the benefit is not paid for the month` TRUE 3 90 100 5 FALSE EQUALS NOTHING
#ASSERT `s 14A(c1) the benefit is not paid for the month` TRUE 3 90 70 0 FALSE EQUALS NOTHING
#ASSERT `s 14A(c1) the benefit is not paid for the month` TRUE 3 100 80 5 FALSE EQUALS JUST TRUE
-- (2)(b): more than 100 days, every month with any day outside
#ASSERT `s 14A(c1) the benefit is not paid for the month` TRUE 3 101 100 1 FALSE EQUALS JUST TRUE
#ASSERT `s 14A(c1) the benefit is not paid for the month` TRUE 3 105 100 5 FALSE EQUALS JUST TRUE
#ASSERT `s 14A(c1) the benefit is not paid for the month` TRUE 3 105 100 0 FALSE EQUALS NOTHING
#ASSERT `s 14A(c1) the benefit is not paid for the month` TRUE 0 0 0 0 FALSE EQUALS NOTHING

§ `s 14A(d) to (f)`
-- (d): entitled the month before exit, needs treatment abroad, accompanies a sick family member, the Minister's rules are met
#ASSERT `s 14A(d) subsections (a), (b) and (c1) do not apply to the person` FALSE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 14A(d) subsections (a), (b) and (c1) do not apply to the person` TRUE FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 14A(d) subsections (a), (b) and (c1) do not apply to the person` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 14A(d) subsections (a), (b) and (c1) do not apply to the person` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 14A(d) subsections (a), (b) and (c1) do not apply to the person` TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 14A(d)(3) "medical treatment outside Israel" the service is one` TRUE EQUALS JUST TRUE
#ASSERT `s 14A(d)(3) "medical treatment outside Israel" the service is one` FALSE EQUALS JUST FALSE
-- (e): arguments are the person abroad is not entitled because of s 14A, the spouse is entitled and in Israel, the benefit for an individual
#ASSERT `s 14A(e) the benefit paid to the spouse in Israel` TRUE TRUE (JUST 4000) EQUALS JUST 4000
#ASSERT `s 14A(e) the benefit paid to the spouse in Israel` TRUE TRUE NOTHING EQUALS NOTHING
#ASSERT `s 14A(e) the benefit paid to the spouse in Israel` FALSE TRUE (JUST 4000) EQUALS NOTHING
#ASSERT `s 14A(e) the benefit paid to the spouse in Israel` TRUE FALSE (JUST 4000) EQUALS NOTHING
#ASSERT `s 14A(f)(2) paragraph (1) does not apply to the person` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 14A(f)(2) paragraph (1) does not apply to the person` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 14A(f)(2) paragraph (1) does not apply to the person` FALSE FALSE EQUALS NOTHING
-- (f)(1): 183 days or more
#ASSERT `s 14A(f)(1) the entitled person is treated as outside Israel` 183 FALSE NOTHING EQUALS JUST TRUE
#ASSERT `s 14A(f)(1) the entitled person is treated as outside Israel` 182 FALSE NOTHING EQUALS NOTHING
#ASSERT `s 14A(f)(1) the entitled person is treated as outside Israel` 183 TRUE NOTHING EQUALS NOTHING
#ASSERT `s 14A(f)(1) the entitled person is treated as outside Israel` 200 FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 14A(f)(1) the entitled person is treated as outside Israel` 200 FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 14A(f)(1) the spouse is treated as an individual` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 14A(f)(1) the spouse is treated as an individual` TRUE FALSE EQUALS NOTHING
#ASSERT `s 14A(f)(1) the spouse is treated as an individual` FALSE TRUE EQUALS NOTHING

§ `s 14B -- the heating grant`
-- 6.4% of a basic amount of 1,000 is 64.  Arguments: entitled for October, November, December; the first month of the year by which they had reached retirement age
#ASSERT `s 14B the heating grant` figures TRUE FALSE FALSE 10 EQUALS JUST 64
#ASSERT `s 14B the heating grant` figures TRUE FALSE FALSE 11 EQUALS NOTHING
#ASSERT `s 14B the heating grant` figures FALSE TRUE FALSE 11 EQUALS JUST 64
#ASSERT `s 14B the heating grant` figures FALSE TRUE FALSE 12 EQUALS NOTHING
#ASSERT `s 14B the heating grant` figures FALSE FALSE TRUE 12 EQUALS JUST 64
#ASSERT `s 14B the heating grant` figures FALSE FALSE TRUE 13 EQUALS NOTHING
#ASSERT `s 14B the heating grant` figures TRUE TRUE TRUE 0 EQUALS JUST 64
#ASSERT `s 14B the heating grant` figures TRUE FALSE TRUE 12 EQUALS JUST 64
#ASSERT `s 14B the heating grant` figures FALSE FALSE FALSE 0 EQUALS NOTHING

§ `s 15 -- the grant on death`
#ASSERT `s 15(a) who is paid the death grant` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 15(a) who is paid the death grant` TRUE TRUE TRUE EQUALS JUST `the person's spouse at the time of death`
#ASSERT `s 15(a) who is paid the death grant` TRUE TRUE FALSE EQUALS JUST `the person's spouse at the time of death`
#ASSERT `s 15(a) who is paid the death grant` TRUE FALSE TRUE EQUALS JUST `one of the person's children`
#ASSERT `s 15(a) who is paid the death grant` TRUE FALSE FALSE EQUALS NOTHING
-- the latest 1 April strictly before the day of death
#ASSERT `s 15(a) the 1 April before the day of death` (Date 2 4 2026) EQUALS Date 1 4 2026
#ASSERT `s 15(a) the 1 April before the day of death` (Date 1 4 2026) EQUALS Date 1 4 2025
#ASSERT `s 15(a) the 1 April before the day of death` (Date 31 3 2026) EQUALS Date 1 4 2025
#ASSERT `s 15(a) the 1 April before the day of death` (Date 1 1 2026) EQUALS Date 1 4 2025
#ASSERT `s 15(a) the 1 April before the day of death` (Date 31 12 2026) EQUALS Date 1 4 2026
#ASSERT `s 15(a) the amount of the death grant` 1000 0 EQUALS 1000
#ASSERT `s 15(a) the amount of the death grant` 1000 0.05 EQUALS 1050
#ASSERT `s 15(b) how many of the two grants the person may receive` TRUE TRUE EQUALS JUST 1
#ASSERT `s 15(b) how many of the two grants the person may receive` TRUE FALSE EQUALS NOTHING
#ASSERT `s 15(b) how many of the two grants the person may receive` FALSE TRUE EQUALS NOTHING

§ `ss 17 and 18`
#ASSERT `s 17(a) the Institute may claim compensation from the person` TRUE EQUALS JUST TRUE
#ASSERT `s 17(a) the Institute may claim compensation from the person` FALSE EQUALS NOTHING
#ASSERT `s 17(c) the District Court may hear the claim` TRUE EQUALS JUST TRUE
#ASSERT `s 17(c) the District Court may hear the claim` FALSE EQUALS NOTHING
#ASSERT `s 17(c) the religious court may also hear the claim` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 17(c) the religious court may also hear the claim` TRUE FALSE EQUALS NOTHING
#ASSERT `s 17(c) the religious court may also hear the claim` FALSE TRUE EQUALS NOTHING
#ASSERT `s 18 the Institute may reduce, suspend or revoke the benefit` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 18 the Institute may reduce, suspend or revoke the benefit` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 18 the Institute may reduce, suspend or revoke the benefit` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 18 the Institute may reduce, suspend or revoke the benefit` FALSE FALSE EQUALS NOTHING
