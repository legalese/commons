#ASSERT `Am I entitled as a parent of a child under two` TRUE 10 TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Am I entitled as a parent of a child under two` TRUE 10 TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Am I entitled as a parent of a child under two` TRUE 10 TRUE FALSE FALSE EQUALS JUST FALSE
