#ASSERT `Am I entitled because I work or am in training on a low income` TRUE 1000 4214 FALSE EQUALS NOTHING
#ASSERT `Am I entitled because I have reached retirement age` TRUE EQUALS JUST TRUE
#ASSERT `Am I entitled because I have reached retirement age` FALSE EQUALS JUST FALSE
-- s 2(a)(5)(a): a child of 23 months, the mother; 24 months is two years complete
