IMPORT prelude
IMPORT `isl-nouns`
IMPORT `isl-p3-rates`

-- Tests for Chapter 3 (ss 5 to 8), the Second and Fourth Schedules and s 30A.
-- The figures are round numbers chosen so that every expected value can be worked out by hand from the text's percentages:
-- basic amount 10,000; basic amount for a child 200; (the pension point is used in isl-tests-sch1-young).

§ `Fixtures`
`figures` MEANS Figures OF 10000, 11000, 200, 300
--                       basic, average wage, child basic, pension point
`a single person` MEANS Household OF FALSE, 0, FALSE, FALSE
--                        has a spouse, children with the claimant, widow, independent parent
`a couple` MEANS Household OF TRUE, 0, FALSE, FALSE
`a couple with a child` MEANS Household OF TRUE, 1, FALSE, FALSE
`a couple with two children` MEANS Household OF TRUE, 2, FALSE, FALSE
`a couple with three children` MEANS Household OF TRUE, 3, FALSE, FALSE
`a single person with a child` MEANS Household OF FALSE, 1, FALSE, FALSE
`a single person with two children` MEANS Household OF FALSE, 2, FALSE, FALSE
`a widow with no child` MEANS Household OF FALSE, 0, TRUE, FALSE
`an independent parent with a child` MEANS Household OF FALSE, 1, FALSE, TRUE
`an independent parent with two children` MEANS Household OF FALSE, 2, FALSE, TRUE
`a widow with a child` MEANS Household OF FALSE, 1, TRUE, FALSE
`a widow with two children` MEANS Household OF FALSE, 2, TRUE, FALSE
`a widow who is also an independent parent, with a child` MEANS Household OF FALSE, 1, TRUE, TRUE
`a widow who is also an independent parent, with two children` MEANS Household OF FALSE, 2, TRUE, TRUE

