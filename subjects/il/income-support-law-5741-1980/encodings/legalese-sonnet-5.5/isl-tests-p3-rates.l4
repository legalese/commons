§ `Second Schedule -- which row`
#ASSERT `sch 2 which row of the table applies to the household` `a single person` EQUALS JUST 1
#ASSERT `sch 2 which row of the table applies to the household` `a couple` EQUALS JUST 2
#ASSERT `sch 2 which row of the table applies to the household` `a couple with a child` EQUALS JUST 3
#ASSERT `sch 2 which row of the table applies to the household` `a couple with two children` EQUALS JUST 4
-- "שני בני זוג שעמם שני ילדים לפחות": two or more
#ASSERT `sch 2 which row of the table applies to the household` `a couple with three children` EQUALS JUST 4
#ASSERT `sch 2 which row of the table applies to the household` `a single person with a child` EQUALS JUST 5
#ASSERT `sch 2 which row of the table applies to the household` `a single person with two children` EQUALS JUST 6
#ASSERT `sch 2 which row of the table applies to the household` `an independent parent with a child` EQUALS JUST 7
#ASSERT `sch 2 which row of the table applies to the household` `an independent parent with two children` EQUALS JUST 8
-- a widow with no child is a single person (rows 7 and 8 need a child)
#ASSERT `sch 2 which row of the table applies to the household` `a widow with no child` EQUALS JUST 1
-- an independent parent is sent to rows 7 and 8 by s 5(a)(3) (src:137); a widow who is not one fits rows 5 and 7 (6 and 8) and the table does not choose
#ASSERT `sch 2 which row of the table applies to the household` `a widow with a child` EQUALS NOTHING
#ASSERT `sch 2 which row of the table applies to the household` `a widow with two children` EQUALS NOTHING
-- a widow who is also an independent parent is an independent parent for the purpose, so rows 7 and 8
#ASSERT `sch 2 which row of the table applies to the household` `a widow who is also an independent parent, with a child` EQUALS JUST 7
#ASSERT `sch 2 which row of the table applies to the household` `a widow who is also an independent parent, with two children` EQUALS JUST 8
-- a household with a spouse takes rows 2 to 4 whatever else it is
#ASSERT `sch 2 which row of the table applies to the household` (Household OF TRUE, 1, TRUE, FALSE) EQUALS JUST 3
#ASSERT `sch 2 note what the basic amount for a child is` EQUALS "the basic amount for the child allowance, para (2) of the definition of basic amount in s 1 of the Insurance Law -- בפסקה (2) להגדרה ”הסכום הבסיסי“ שבסעיף 1 לחוק הביטוח"

§ `s 5(a)(1) and (2) -- which column`
-- not a pensioner, under 55: column B, up to and including 54
#ASSERT `s 5(a)(1) to (2) the column of the Second Schedule that applies` 30 FALSE FALSE FALSE EQUALS `column B under 55`
#ASSERT `s 5(a)(1) to (2) the column of the Second Schedule that applies` 54 FALSE FALSE FALSE EQUALS `column B under 55`
-- from 55: column C
#ASSERT `s 5(a)(1) to (2) the column of the Second Schedule that applies` 55 FALSE FALSE FALSE EQUALS `column C from 55`
#ASSERT `s 5(a)(1) to (2) the column of the Second Schedule that applies` 66 FALSE FALSE FALSE EQUALS `column C from 55`
-- retirement age reached: column A, by the three age bands (under 70, 70 to under 80, 80 and over)
#ASSERT `s 5(a)(1) to (2) the column of the Second Schedule that applies` 67 TRUE FALSE FALSE EQUALS `column A under 70`
#ASSERT `s 5(a)(1) to (2) the column of the Second Schedule that applies` 69 TRUE FALSE FALSE EQUALS `column A under 70`
#ASSERT `s 5(a)(1) to (2) the column of the Second Schedule that applies` 70 TRUE FALSE FALSE EQUALS `column A from 70 to under 80`
#ASSERT `s 5(a)(1) to (2) the column of the Second Schedule that applies` 79 TRUE FALSE FALSE EQUALS `column A from 70 to under 80`
#ASSERT `s 5(a)(1) to (2) the column of the Second Schedule that applies` 80 TRUE FALSE FALSE EQUALS `column A from 80`
-- an old-age or survivors' allowance at 40, or a dependants' allowance at 60, also puts the person in column A
#ASSERT `s 5(a)(1) to (2) the column of the Second Schedule that applies` 40 FALSE TRUE FALSE EQUALS `column A under 70`
#ASSERT `s 5(a)(1) to (2) the column of the Second Schedule that applies` 60 FALSE FALSE TRUE EQUALS `column A under 70`

§ `s 5(a) -- the benefit with no income (10,000 basic amount, 200 child amount)`
-- 42.14% of 10,000
#ASSERT `s 5(a) the benefit for an entitled person with no income` `figures` `a single person` `column A under 70` EQUALS JUST 4214
-- 20% and 25%
#ASSERT `s 5(a) the benefit for an entitled person with no income` `figures` `a single person` `column B under 55` EQUALS JUST 2000
#ASSERT `s 5(a) the benefit for an entitled person with no income` `figures` `a single person` `column C from 55` EQUALS JUST 2500
-- two spouses, 70 to under 80: 67.24%
#ASSERT `s 5(a) the benefit for an entitled person with no income` `figures` `a couple` `column A from 70 to under 80` EQUALS JUST 6724
-- two spouses and a child, column C: 43.5%
#ASSERT `s 5(a) the benefit for an entitled person with no income` `figures` `a couple with a child` `column C from 55` EQUALS JUST 4350
-- two spouses and two children, 80 and over: 89.50%
#ASSERT `s 5(a) the benefit for an entitled person with no income` `figures` `a couple with two children` `column A from 80` EQUALS JUST 8950
-- a single person with a child, column A: 71.92% less the child amount (7192 - 200)
#ASSERT `s 5(a) the benefit for an entitled person with no income` `figures` `a single person with a child` `column A under 70` EQUALS JUST 6992
-- column B for the same household has no deduction: 30%
#ASSERT `s 5(a) the benefit for an entitled person with no income` `figures` `a single person with a child` `column B under 55` EQUALS JUST 3000
-- column C: 37.5% less the child amount (3750 - 200)
#ASSERT `s 5(a) the benefit for an entitled person with no income` `figures` `a single person with a child` `column C from 55` EQUALS JUST 3550
-- a single person with two children, 80 and over: 84.04% less 200 (8404 - 200)
#ASSERT `s 5(a) the benefit for an entitled person with no income` `figures` `a single person with two children` `column A from 80` EQUALS JUST 8204
-- widow or independent parent with a child: column B 33.5% (no deduction), column C 42.5% less 200
#ASSERT `s 5(a) the benefit for an entitled person with no income` `figures` `an independent parent with a child` `column B under 55` EQUALS JUST 3350
#ASSERT `s 5(a) the benefit for an entitled person with no income` `figures` `an independent parent with a child` `column C from 55` EQUALS JUST 4050
-- widow or independent parent with two children: column B 39%, column C 52.5% less 200
#ASSERT `s 5(a) the benefit for an entitled person with no income` `figures` `an independent parent with two children` `column B under 55` EQUALS JUST 3900
#ASSERT `s 5(a) the benefit for an entitled person with no income` `figures` `an independent parent with two children` `column C from 55` EQUALS JUST 5050
-- a widow with no child is a single person: column B 20%
#ASSERT `s 5(a) the benefit for an entitled person with no income` `figures` `a widow with no child` `column B under 55` EQUALS JUST 2000
-- a widow who is not an independent parent fits two rows, so the benefit is not covered; one who is also an independent parent gets rows 7 and 8
#ASSERT `s 5(a) the benefit for an entitled person with no income` `figures` `a widow with a child` `column B under 55` EQUALS NOTHING
#ASSERT `s 5(a) the benefit for an entitled person with no income` `figures` `a widow with two children` `column C from 55` EQUALS NOTHING
#ASSERT `s 5(a) the benefit for an entitled person with no income` `figures` `a widow who is also an independent parent, with a child` `column B under 55` EQUALS JUST 3350

§ `s 5(b) -- income`
#ASSERT `s 5(b) the benefit for an entitled person who has income` 4214 1000 EQUALS JUST 3214
#ASSERT `s 5(b) the benefit for an entitled person who has income` 4214 0 EQUALS JUST 4214
-- income equal to the benefit: the difference is nil
#ASSERT `s 5(b) the benefit for an entitled person who has income` 4214 4214 EQUALS JUST 0
-- income above the benefit: the text is silent
#ASSERT `s 5(b) the benefit for an entitled person who has income` 4214 5000 EQUALS NOTHING

§ `s 5(d) -- treated as an independent parent`
#ASSERT `s 5(d) the parent is treated as an independent parent` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 5(d) the parent is treated as an independent parent` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 5(d) the parent is treated as an independent parent` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 5(d) the parent is treated as an independent parent` TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 5(d) the parent is treated as an independent parent` FALSE TRUE FALSE FALSE EQUALS NOTHING

§ `s 5(e) -- other rates`
#ASSERT `s 5(e)(1) the rate for one entitled under item 1, 5 or 25 of the First Schedule` (JUST 3000) EQUALS JUST 3000
#ASSERT `s 5(e)(1) the rate for one entitled under item 1, 5 or 25 of the First Schedule` NOTHING EQUALS NOTHING
#ASSERT `s 5(e)(2) the rate for one entitled under s 2(c) or s 4(b)` (JUST 2500) EQUALS JUST 2500
#ASSERT `s 5(e)(2) the rate for one entitled under s 2(c) or s 4(b)` NOTHING EQUALS NOTHING
-- the Ministers' share must be from 50% to 80%: 50% of 4000 = 2000; 65% = 2600; 80% = 3200; 49% and 81% are outside
#ASSERT `s 5(e)(3) the benefit for one entitled under s 2(e)` 0.5 4000 EQUALS JUST 2000
#ASSERT `s 5(e)(3) the benefit for one entitled under s 2(e)` 0.65 4000 EQUALS JUST 2600
#ASSERT `s 5(e)(3) the benefit for one entitled under s 2(e)` 0.8 4000 EQUALS JUST 3200
#ASSERT `s 5(e)(3) the benefit for one entitled under s 2(e)` 0.49 4000 EQUALS NOTHING
#ASSERT `s 5(e)(3) the benefit for one entitled under s 2(e)` 0.81 4000 EQUALS NOTHING

§ `s 5(f) -- maintenance awarded`
#ASSERT `s 5(f) the rate is reduced merely because maintenance was awarded` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 5(f) the rate is reduced merely because maintenance was awarded` TRUE FALSE EQUALS NOTHING
#ASSERT `s 5(f) the rate is reduced merely because maintenance was awarded` FALSE TRUE EQUALS NOTHING

§ `s 5(g) -- the supplement for a woman of 62 or over`
#ASSERT `s 5(g) the number of months of the supplement` 1959 EQUALS NOTHING
#ASSERT `s 5(g) the number of months of the supplement` 1960 EQUALS JUST 4
#ASSERT `s 5(g) the number of months of the supplement` 1961 EQUALS JUST 8
#ASSERT `s 5(g) the number of months of the supplement` 1962 EQUALS JUST 12
#ASSERT `s 5(g) the number of months of the supplement` 1963 EQUALS JUST 15
#ASSERT `s 5(g) the number of months of the supplement` 1964 EQUALS JUST 18
#ASSERT `s 5(g) the number of months of the supplement` 1965 EQUALS NOTHING
-- born 1960: 4 months from reaching 62, i.e. months 0, 1, 2, 3 since; the fifth month is outside
#ASSERT `s 5(g) the woman is entitled to the supplement for the month` TRUE 62 FALSE 1960 0 EQUALS JUST TRUE
#ASSERT `s 5(g) the woman is entitled to the supplement for the month` TRUE 62 FALSE 1960 3 EQUALS JUST TRUE
#ASSERT `s 5(g) the woman is entitled to the supplement for the month` TRUE 62 FALSE 1960 4 EQUALS NOTHING
-- born 1964: 18 months, so month 17 is the last
#ASSERT `s 5(g) the woman is entitled to the supplement for the month` TRUE 62 FALSE 1964 17 EQUALS JUST TRUE
#ASSERT `s 5(g) the woman is entitled to the supplement for the month` TRUE 62 FALSE 1964 18 EQUALS NOTHING
-- never after retirement age
#ASSERT `s 5(g) the woman is entitled to the supplement for the month` TRUE 63 TRUE 1960 1 EQUALS JUST FALSE
-- not yet 62; not entitled under (a)(2)(b); a year of birth outside the list
#ASSERT `s 5(g) the woman is entitled to the supplement for the month` TRUE 61 FALSE 1960 0 EQUALS NOTHING
#ASSERT `s 5(g) the woman is entitled to the supplement for the month` FALSE 62 FALSE 1960 0 EQUALS NOTHING
#ASSERT `s 5(g) the woman is entitled to the supplement for the month` TRUE 62 FALSE 1959 0 EQUALS NOTHING
-- 7.95% of 10,000
#ASSERT `s 5(g) the amount of the supplement` `figures` EQUALS 795

