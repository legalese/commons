-- tests-independent.l4 -- written by the independent test author (rev-isl).
-- Expected values are from ANSWERS.md (the Hebrew text), written before any .l4 file was opened.
-- Every assertion's trailing comment starts with the scenario number in ANSWERS.md ("[36]") and gives the provision.
-- A = 10,000; W = 10,000; cb = 500 (child basic amount); P = 300 (pension point).  Nothing here is copied from the encoding's output.

`fx` MEANS Figures WITH
    `the basic amount` IS 10000
    `the average wage` IS 10000
    `the basic amount for a child` IS 500
    `the value of one pension point` IS 300

`hh single` MEANS Household WITH
    `the claimant has a spouse` IS FALSE
    `the number of children with the claimant` IS 0
    `the claimant is a widow` IS FALSE
    `the claimant is an independent parent` IS FALSE

`hh couple` MEANS Household WITH
    `the claimant has a spouse` IS TRUE
    `the number of children with the claimant` IS 0
    `the claimant is a widow` IS FALSE
    `the claimant is an independent parent` IS FALSE

`hh couple 1` MEANS Household WITH
    `the claimant has a spouse` IS TRUE
    `the number of children with the claimant` IS 1
    `the claimant is a widow` IS FALSE
    `the claimant is an independent parent` IS FALSE

`hh couple 2` MEANS Household WITH
    `the claimant has a spouse` IS TRUE
    `the number of children with the claimant` IS 2
    `the claimant is a widow` IS FALSE
    `the claimant is an independent parent` IS FALSE

`hh single 1` MEANS Household WITH
    `the claimant has a spouse` IS FALSE
    `the number of children with the claimant` IS 1
    `the claimant is a widow` IS FALSE
    `the claimant is an independent parent` IS FALSE

`hh single 2` MEANS Household WITH
    `the claimant has a spouse` IS FALSE
    `the number of children with the claimant` IS 2
    `the claimant is a widow` IS FALSE
    `the claimant is an independent parent` IS FALSE

`hh widow 1` MEANS Household WITH
    `the claimant has a spouse` IS FALSE
    `the number of children with the claimant` IS 1
    `the claimant is a widow` IS FALSE
    `the claimant is an independent parent` IS TRUE

`hh widow 2` MEANS Household WITH
    `the claimant has a spouse` IS FALSE
    `the number of children with the claimant` IS 2
    `the claimant is a widow` IS FALSE
    `the claimant is an independent parent` IS TRUE

`hh couple 3` MEANS Household WITH
    `the claimant has a spouse` IS TRUE
    `the number of children with the claimant` IS 3
    `the claimant is a widow` IS FALSE
    `the claimant is an independent parent` IS FALSE

