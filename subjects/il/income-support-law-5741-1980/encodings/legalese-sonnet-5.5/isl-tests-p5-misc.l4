IMPORT prelude
IMPORT `isl-nouns`
IMPORT `isl-p5-misc`

-- Tests for Chapter 5, Sub-chapter D (ss 22 to 26 and 30(b)).  Expected values are worked out by hand from the text, beside each assertion.

§ `s 22 -- managers`
-- arguments: the body committed the offence, the person is an administrator, manager or officer, proved no knowledge, proved every suitable measure
#ASSERT `s 22 the manager is treated as responsible for the body's offence` FALSE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 22 the manager is treated as responsible for the body's offence` TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 22 the manager is treated as responsible for the body's offence` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 22 the manager is treated as responsible for the body's offence` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 22 the manager is treated as responsible for the body's offence` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 22 the manager is treated as responsible for the body's offence` TRUE TRUE TRUE TRUE EQUALS JUST FALSE

§ `s 23 -- the Insurance Law applies`
#ASSERT `s 23(a) the section of the Insurance Law applies to this Law` "2A" EQUALS JUST TRUE
#ASSERT `s 23(a) the section of the Insurance Law applies to this Law` "297A" EQUALS JUST TRUE
#ASSERT `s 23(a) the section of the Insurance Law applies to this Law` "297B" EQUALS JUST TRUE
#ASSERT `s 23(a) the section of the Insurance Law applies to this Law` "301" EQUALS JUST TRUE
#ASSERT `s 23(a) the section of the Insurance Law applies to this Law` "302(a)(1)" EQUALS JUST TRUE
#ASSERT `s 23(a) the section of the Insurance Law applies to this Law` "302(b)" EQUALS JUST TRUE
#ASSERT `s 23(a) the section of the Insurance Law applies to this Law` "303" EQUALS JUST TRUE
#ASSERT `s 23(a) the section of the Insurance Law applies to this Law` "304" EQUALS JUST TRUE
#ASSERT `s 23(a) the section of the Insurance Law applies to this Law` "307" EQUALS JUST TRUE
#ASSERT `s 23(a) the section of the Insurance Law applies to this Law` "308" EQUALS JUST TRUE
#ASSERT `s 23(a) the section of the Insurance Law applies to this Law` "311" EQUALS JUST TRUE
#ASSERT `s 23(a) the section of the Insurance Law applies to this Law` "315" EQUALS JUST TRUE
#ASSERT `s 23(a) the section of the Insurance Law applies to this Law` "318" EQUALS JUST TRUE
#ASSERT `s 23(a) the section of the Insurance Law applies to this Law` "325" EQUALS JUST TRUE
#ASSERT `s 23(a) the section of the Insurance Law applies to this Law` "378" EQUALS JUST TRUE
#ASSERT `s 23(a) the section of the Insurance Law applies to this Law` "384" EQUALS JUST TRUE
#ASSERT `s 23(a) the section of the Insurance Law applies to this Law` "385" EQUALS JUST TRUE
#ASSERT `s 23(a) the section of the Insurance Law applies to this Law` "386" EQUALS JUST TRUE
#ASSERT `s 23(a) the section of the Insurance Law applies to this Law` "396" EQUALS JUST TRUE
-- the list has nineteen entries; a neighbour of a listed section is not on it
#ASSERT count `s 23(a) the sections of the Insurance Law that apply` EQUALS 19
#ASSERT `s 23(a) the section of the Insurance Law applies to this Law` "302" EQUALS NOTHING
#ASSERT `s 23(a) the section of the Insurance Law applies to this Law` "302(a)(2)" EQUALS NOTHING
#ASSERT `s 23(a) the section of the Insurance Law applies to this Law` "305" EQUALS NOTHING
#ASSERT `s 23(a) the section of the Insurance Law applies to this Law` "2" EQUALS NOTHING
#ASSERT `s 23(b) the benefit may be transferred, pledged or attached` TRUE EQUALS JUST FALSE
#ASSERT `s 23(b) the benefit may be transferred, pledged or attached` FALSE EQUALS NOTHING

§ `ss 24 to 26`
#ASSERT `s 24(c) the provisions of sub-chapter C apply to the matter` TRUE EQUALS JUST TRUE
#ASSERT `s 24(c) the provisions of sub-chapter C apply to the matter` FALSE EQUALS NOTHING
#ASSERT `s 25(a) who pays the benefit` EQUALS "the State Treasury, through the National Insurance Institute -- מאוצר המדינה באמצעות המוסד לביטוח לאומי"
#ASSERT `s 25(b) the State Treasury transfers the money for the month` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 25(b) the State Treasury transfers the money for the month` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 25(b) the State Treasury transfers the money for the month` FALSE FALSE EQUALS NOTHING
-- arguments: the action is under this Law or arises from it, the action is a claim under s 17
#ASSERT `s 26 the Regional Labour Court has exclusive jurisdiction` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 26 the Regional Labour Court has exclusive jurisdiction` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 26 the Regional Labour Court has exclusive jurisdiction` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 26 the Regional Labour Court has exclusive jurisdiction` FALSE FALSE EQUALS NOTHING

§ `s 30(b) -- the floor`
-- arguments: got support just before, the last support, the benefit the Law gives, lower only because of the income-calculation rules
#ASSERT `s 30(b) the benefit paid, not less than the last support` TRUE 1000 900 TRUE EQUALS JUST 1000
#ASSERT `s 30(b) the benefit paid, not less than the last support` TRUE 1000 999 TRUE EQUALS JUST 1000
#ASSERT `s 30(b) the benefit paid, not less than the last support` TRUE 1000 1000 TRUE EQUALS NOTHING
#ASSERT `s 30(b) the benefit paid, not less than the last support` TRUE 1000 1100 TRUE EQUALS NOTHING
#ASSERT `s 30(b) the benefit paid, not less than the last support` FALSE 1000 900 TRUE EQUALS NOTHING
#ASSERT `s 30(b) the benefit paid, not less than the last support` TRUE 1000 900 FALSE EQUALS NOTHING
