IMPORT prelude
IMPORT daydate
IMPORT `pc70-nouns`
IMPORT `pc70-cross-references`

-- Row il-70. TESTS THAT PIN THE READINGS of the two items: the status of each provision as the instruments read give it, the issue dates, the instructions and their literal replay, both limbs, and how each limb was read.
-- These pass: they say what was read from what. The assertions that the sections cited are NOT repealed are in pc70-tests-red.l4 and fail.
-- The expected values are hand-written from the quotation lines in pc70-cross-references.l4 and from NOTES.md section 6 (the answer tables), not copied from the values there.

§ `Tests of the readings`

-- The status of each provision the row checked.
#ASSERT `Customs Ordinance section 128`'s `its status in the instruments read` EQUALS Repealed
#ASSERT `Customs Ordinance section 170`'s `its status in the instruments read` EQUALS Repealed
#ASSERT `Customs Ordinance section 171`'s `its status in the instruments read` EQUALS Repealed
#ASSERT `Customs Ordinance section 239A`'s `its status in the instruments read` EQUALS Added
#ASSERT `Customs Ordinance section 239B`'s `its status in the instruments read` EQUALS Added
#ASSERT `Value Added Tax Law section 144A`'s `its status in the instruments read` EQUALS Repealed
#ASSERT `Purchase Tax Law section 29C`'s `its status in the instruments read` EQUALS Added
#ASSERT `Purchase Tax Law section 29D`'s `its status in the instruments read` EQUALS Added

-- The issue dates are the dates the footers print. They are not days of effect: the day each repeal began is NOTHING, because no page read prints one.
#ASSERT `Customs Ordinance section 128`'s `the issue date printed on the instrument that gives the status` EQUALS JUST (Date 19 7 1995)
#ASSERT `Customs Ordinance section 170`'s `the issue date printed on the instrument that gives the status` EQUALS JUST (Date 19 7 1995)
#ASSERT `Customs Ordinance section 171`'s `the issue date printed on the instrument that gives the status` EQUALS JUST (Date 19 7 1995)
#ASSERT `Value Added Tax Law section 144A`'s `the issue date printed on the instrument that gives the status` EQUALS JUST (Date 28 12 1994)
#ASSERT `the day the repeal of the provision began, as the pages read print it` `Customs Ordinance section 128` EQUALS NOTHING
#ASSERT `the day the repeal of the provision began, as the pages read print it` `Customs Ordinance section 170` EQUALS NOTHING
#ASSERT `the day the repeal of the provision began, as the pages read print it` `Customs Ordinance section 171` EQUALS NOTHING
#ASSERT `the day the repeal of the provision began, as the pages read print it` `Value Added Tax Law section 144A` EQUALS NOTHING

-- I1. The list of section 29C as SH 1195 prints it (the words between the section's opening words and its closing words).
-- tr:[sh1195-p275] | 39 (b), 63, 64, 81 to 89, 92, 93, 104, 122, 128, 140 to 145, 149, 150, 152, 156, 162 to 162B, 170, 171, 198, 204 and-231C
#ASSERT `the 1986 list of section 29C as SH 1195 prints it` EQUALS "39 (b), 63, 64, 81 to 89, 92, 93, 104, 122, 128, 140 to 145, 149, 150, 152, 156, 162 to 162B, 170, 171, 198, 204 and-231C"

-- I1. The 1995 instruction: the words replaced, the words that come in, its date, and the literal result.
#ASSERT `the 1995 instruction on section 29C`'s `its kind` EQUALS Replace
#ASSERT `the 1995 instruction on section 29C`'s `the words it quotes first` EQUALS "and-231C"
#ASSERT `the 1995 instruction on section 29C`'s `the words it quotes second` EQUALS "231C, 239A and-239B"
#ASSERT `the 1995 instruction on section 29C`'s `the issue date its footer prints` EQUALS Date 19 7 1995
#ASSERT `the text before the step is its three parts joined` `item I1: the replay step of the 1995 instruction`
#ASSERT `item I1: the replay step of the 1995 instruction`'s `the quoted words are in the text before the step` EQUALS TRUE
#ASSERT `the text a replacement gives` `item I1: the replay step of the 1995 instruction` EQUALS `item I1: the replay step of the 1995 instruction`'s `the text after the step, applied literally`
#ASSERT `item I1: the replay step of the 1995 instruction`'s `the text after the step, applied literally` EQUALS "39 (b), 63, 64, 81 to 89, 92, 93, 104, 122, 128, 140 to 145, 149, 150, 152, 156, 162 to 162B, 170, 171, 198, 204 231C, 239A and-239B"

-- I1. The literal result has a space and no comma between 204 and 231C; the consolidation's tail has a comma (CONSOLIDATION-ONLY).
-- tr:[src:437] | 204, 231C, 239A and-239B
#ASSERT (CONCAT "204 ", (`the 1995 instruction on section 29C`'s `the words it quotes second`)) EQUALS "204 231C, 239A and-239B"
#ASSERT NOT ((CONCAT "204 ", (`the 1995 instruction on section 29C`'s `the words it quotes second`)) EQUALS "204, 231C, 239A and-239B")

-- I1. The tokens (the numbers, as the page prints them) before and after the 1995 instruction: twenty, then twenty-two; 128, 170 and 171 are in both.
#ASSERT count (`item I1: section 29C cites sections 128, 170 and 171 of the Customs Ordinance`'s `the tokens of the list as first printed`) EQUALS 20
#ASSERT count (`item I1: section 29C cites sections 128, 170 and 171 of the Customs Ordinance`'s `the tokens of the list after the instructions read`) EQUALS 22
#ASSERT elem "128" (`item I1: section 29C cites sections 128, 170 and 171 of the Customs Ordinance`'s `the tokens of the list as first printed`)
#ASSERT elem "170" (`item I1: section 29C cites sections 128, 170 and 171 of the Customs Ordinance`'s `the tokens of the list as first printed`)
#ASSERT elem "171" (`item I1: section 29C cites sections 128, 170 and 171 of the Customs Ordinance`'s `the tokens of the list as first printed`)
#ASSERT elem "128" (`item I1: section 29C cites sections 128, 170 and 171 of the Customs Ordinance`'s `the tokens of the list after the instructions read`)
#ASSERT elem "170" (`item I1: section 29C cites sections 128, 170 and 171 of the Customs Ordinance`'s `the tokens of the list after the instructions read`)
#ASSERT elem "171" (`item I1: section 29C cites sections 128, 170 and 171 of the Customs Ordinance`'s `the tokens of the list after the instructions read`)
#ASSERT `item I1: section 29C cites sections 128, 170 and 171 of the Customs Ordinance`'s `the tokens of the list after the instructions read` EQUALS `item I1: the replay step of the 1995 instruction`'s `the tokens after the step, with punctuation ignored`

-- I1. Three of the five provisions the row checked are repealed; both limbs hold; how each limb was read.
#ASSERT `how many provisions the row checked in the list are repealed` `item I1: section 29C cites sections 128, 170 and 171 of the Customs Ordinance` EQUALS 3
#ASSERT NOT (`no provision the row checked in the list is repealed` `item I1: section 29C cites sections 128, 170 and 171 of the Customs Ordinance`)
#ASSERT `both limbs hold` `item I1: section 29C cites sections 128, 170 and 171 of the Customs Ordinance`
#ASSERT `item I1: section 29C cites sections 128, 170 and 171 of the Customs Ordinance`'s `limb (a) was read` EQUALS `official page image`
#ASSERT `item I1: section 29C cites sections 128, 170 and 171 of the Customs Ordinance`'s `limb (b) was read` EQUALS `official page images, with the absence of a later instrument resting on the consolidation's tag list (CONSOLIDATION-ONLY)`

-- I2. The list of section 29D as SH 1195 prints it, and the four instructions in order.
#ASSERT `the 1986 list of section 29D as SH 1195 prints it` EQUALS "1A, 105 (c) and-144A"
#ASSERT `the 1987 instruction on section 29D`'s `its kind` EQUALS Replace
#ASSERT `the 1987 instruction on section 29D`'s `the words it quotes first` EQUALS "1A, 105 (c) and-144A"
#ASSERT `the 1987 instruction on section 29D`'s `the words it quotes second` EQUALS "1A and-144A"
#ASSERT `the 1987 instruction on section 29D`'s `the issue date its footer prints` EQUALS Date 13 8 1987
#ASSERT `the 2002 instruction on section 29D`'s `its kind` EQUALS `Insert after`
#ASSERT `the 2002 instruction on section 29D`'s `the words it quotes first` EQUALS "1A"
#ASSERT `the 2002 instruction on section 29D`'s `the words it quotes second` EQUALS "106 and-112A"
#ASSERT `the 2002 instruction on section 29D`'s `the issue date its footer prints` EQUALS Date 27 6 2002
#ASSERT `the 2014 instruction on section 29D`'s `its kind` EQUALS `Insert after`
#ASSERT `the 2014 instruction on section 29D`'s `the words it quotes first` EQUALS "1A,"
#ASSERT `the 2014 instruction on section 29D`'s `the words it quotes second` EQUALS "102A,"
#ASSERT `the 2014 instruction on section 29D`'s `the issue date its footer prints` EQUALS Date 15 7 2014

-- I2. The literal replay. Step 1 and step 2 apply; step 3's quoted words (with the comma) are not in the text step 2 leaves, so step 3 changes nothing literally.
#ASSERT `item I2: replay step 1, the 1987 instruction`'s `the quoted words are in the text before the step` EQUALS TRUE
#ASSERT `the text before the step is its three parts joined` `item I2: replay step 1, the 1987 instruction`
#ASSERT `the text a replacement gives` `item I2: replay step 1, the 1987 instruction` EQUALS "1A and-144A"
#ASSERT `item I2: replay step 1, the 1987 instruction`'s `the text after the step, applied literally` EQUALS "1A and-144A"
#ASSERT `item I2: replay step 2, the 2002 instruction`'s `the text before the step` EQUALS `item I2: replay step 1, the 1987 instruction`'s `the text after the step, applied literally`
#ASSERT `item I2: replay step 2, the 2002 instruction`'s `the quoted words are in the text before the step` EQUALS TRUE
#ASSERT `the text before the step is its three parts joined` `item I2: replay step 2, the 2002 instruction`
#ASSERT `the text an insertion gives` `item I2: replay step 2, the 2002 instruction` EQUALS "1A106 and-112A and-144A"
#ASSERT `item I2: replay step 2, the 2002 instruction`'s `the text after the step, applied literally` EQUALS "1A106 and-112A and-144A"
#ASSERT `item I2: replay step 3, the 2014 instruction`'s `the text before the step` EQUALS `item I2: replay step 2, the 2002 instruction`'s `the text after the step, applied literally`
#ASSERT `item I2: replay step 3, the 2014 instruction`'s `the quoted words are in the text before the step` EQUALS FALSE
#ASSERT `item I2: replay step 3, the 2014 instruction`'s `the text after the step, applied literally` EQUALS `item I2: replay step 3, the 2014 instruction`'s `the text before the step`
#ASSERT `item I2: replay step 3, the 2014 instruction`'s `the text after the step, applied literally` EQUALS "1A106 and-112A and-144A"

-- I2. The consolidation's text of the list carries commas the literal replay does not (CONSOLIDATION-ONLY).
-- tr:[src:440] | 1A, 102A, 106, 112A and-144A
#ASSERT NOT (`item I2: replay step 3, the 2014 instruction`'s `the text after the step, applied literally` EQUALS "1A, 102A, 106, 112A and-144A")

-- I2. The tokens, with punctuation ignored, after each step: 144A is in every one of them, and the 2014 instruction brings 102A.
#ASSERT `the tokens of the list of section 29D as first printed` EQUALS LIST "1A", "105 (c)", "144A"
#ASSERT `item I2: replay step 1, the 1987 instruction`'s `the tokens after the step, with punctuation ignored` EQUALS LIST "1A", "144A"
#ASSERT `item I2: replay step 2, the 2002 instruction`'s `the tokens after the step, with punctuation ignored` EQUALS LIST "1A", "106", "112A", "144A"
#ASSERT `item I2: replay step 3, the 2014 instruction`'s `the tokens after the step, with punctuation ignored` EQUALS LIST "1A", "102A", "106", "112A", "144A"
#ASSERT elem "144A" (`the tokens of the list of section 29D as first printed`)
#ASSERT elem "144A" (`item I2: replay step 1, the 1987 instruction`'s `the tokens after the step, with punctuation ignored`)
#ASSERT elem "144A" (`item I2: replay step 2, the 2002 instruction`'s `the tokens after the step, with punctuation ignored`)
#ASSERT elem "144A" (`item I2: replay step 3, the 2014 instruction`'s `the tokens after the step, with punctuation ignored`)
#ASSERT `item I2: section 29D cites section 144A of the Value Added Tax Law`'s `the tokens of the list after the instructions read` EQUALS `item I2: replay step 3, the 2014 instruction`'s `the tokens after the step, with punctuation ignored`

-- I2. One provision checked, repealed; both limbs hold; how each limb was read.
#ASSERT `how many provisions the row checked in the list are repealed` `item I2: section 29D cites section 144A of the Value Added Tax Law` EQUALS 1
#ASSERT NOT (`no provision the row checked in the list is repealed` `item I2: section 29D cites section 144A of the Value Added Tax Law`)
#ASSERT `both limbs hold` `item I2: section 29D cites section 144A of the Value Added Tax Law`
#ASSERT `item I2: section 29D cites section 144A of the Value Added Tax Law`'s `limb (a) was read` EQUALS `official page image`
#ASSERT `item I2: section 29D cites section 144A of the Value Added Tax Law`'s `limb (b) was read` EQUALS `official page images, with the absence of a later instrument resting on the consolidation's tag list (CONSOLIDATION-ONLY)`
