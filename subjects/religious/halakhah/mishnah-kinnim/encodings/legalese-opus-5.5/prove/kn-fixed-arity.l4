    IF ((2 TIMES 0) AT MOST (`all the pairs of five nests` p1 p2 p3 p4 p5)) AND (0 AT LEAST (`the largest minority of five nests` p1 p2 p3 p4 p5)) THEN 2 TIMES p5 ELSE IF ((2 TIMES p1) AT MOST (`all the pairs of five nests` p1 p2 p3 p4 p5)) AND (p1 AT LEAST (`the largest minority of five nests` p1 p2 p3 p4 p5)) THEN 2 TIMES p5 ELSE IF ((2 TIMES p2) AT MOST (`all the pairs of five nests` p1 p2 p3 p4 p5)) AND (p2 AT LEAST (`the largest minority of five nests` p1 p2 p3 p4 p5)) THEN 2 TIMES p5 ELSE IF ((2 TIMES p3) AT MOST (`all the pairs of five nests` p1 p2 p3 p4 p5)) AND (p3 AT LEAST (`the largest minority of five nests` p1 p2 p3 p4 p5)) THEN 2 TIMES p5 ELSE IF ((2 TIMES p4) AT MOST (`all the pairs of five nests` p1 p2 p3 p4 p5)) AND (p4 AT LEAST (`the largest minority of five nests` p1 p2 p3 p4 p5)) THEN 2 TIMES p5 ELSE IF ((2 TIMES p5) AT MOST (`all the pairs of five nests` p1 p2 p3 p4 p5)) AND (p5 AT LEAST (`the largest minority of five nests` p1 p2 p3 p4 p5)) THEN 0 ELSE IF ((2 TIMES (p1 PLUS p2)) AT MOST (`all the pairs of five nests` p1 p2 p3 p4 p5)) AND ((p1 PLUS p2) AT LEAST (`the largest minority of five nests` p1 p2 p3 p4 p5)) THEN 2 TIMES p5 ELSE IF ((2 TIMES (p1 PLUS p3)) AT MOST (`all the pairs of five nests` p1 p2 p3 p4 p5)) AND ((p1 PLUS p3) AT LEAST (`the largest minority of five nests` p1 p2 p3 p4 p5)) THEN 2 TIMES p5 ELSE IF ((2 TIMES (p1 PLUS p4)) AT MOST (`all the pairs of five nests` p1 p2 p3 p4 p5)) AND ((p1 PLUS p4) AT LEAST (`the largest minority of five nests` p1 p2 p3 p4 p5)) THEN 2 TIMES p5 ELSE IF ((2 TIMES (p1 PLUS p5)) AT MOST (`all the pairs of five nests` p1 p2 p3 p4 p5)) AND ((p1 PLUS p5) AT LEAST (`the largest minority of five nests` p1 p2 p3 p4 p5)) THEN 0 ELSE IF ((2 TIMES (p2 PLUS p3)) AT MOST (`all the pairs of five nests` p1 p2 p3 p4 p5)) AND ((p2 PLUS p3) AT LEAST (`the largest minority of five nests` p1 p2 p3 p4 p5)) THEN 2 TIMES p5 ELSE IF ((2 TIMES (p2 PLUS p4)) AT MOST (`all the pairs of five nests` p1 p2 p3 p4 p5)) AND ((p