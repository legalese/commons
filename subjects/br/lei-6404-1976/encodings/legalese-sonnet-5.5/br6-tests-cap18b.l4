GIVETH A `Justificação da operação (art. 225)`
`[teste] justificação completa` MEANS `Justificação da operação (art. 225)` WITH
    `expõe os motivos ou fins da operação e o interesse da companhia` IS TRUE
    `expõe as ações dos preferencialistas e as razões da modificação dos seus direitos` IS TRUE
    `expõe a composição do capital após a operação, por espécies e classes de ações` IS TRUE
    `expõe o valor de reembolso das ações dos acionistas dissidentes` IS TRUE

GIVETH A `Justificação da operação (art. 225)`
`[teste] justificação sem o item II (preferencialistas)` MEANS `Justificação da operação (art. 225)` WITH
    `expõe os motivos ou fins da operação e o interesse da companhia` IS TRUE
    `expõe as ações dos preferencialistas e as razões da modificação dos seus direitos` IS FALSE
    `expõe a composição do capital após a operação, por espécies e classes de ações` IS TRUE
    `expõe o valor de reembolso das ações dos acionistas dissidentes` IS TRUE

GIVETH A `Justificação da operação (art. 225)`
`[teste] justificação sem o item IV (reembolso)` MEANS `Justificação da operação (art. 225)` WITH
    `expõe os motivos ou fins da operação e o interesse da companhia` IS TRUE
    `expõe as ações dos preferencialistas e as razões da modificação dos seus direitos` IS TRUE
    `expõe a composição do capital após a operação, por espécies e classes de ações` IS TRUE
    `expõe o valor de reembolso das ações dos acionistas dissidentes` IS FALSE



-- Art. 223, caput: entre sociedades de tipos iguais ou diferentes (incorporação, fusão, cisão); deliberação na forma da alteração dos estatutos ou contratos.
#ASSERT (`a operação pode ser feita entre sociedades de tipos iguais ou diferentes (art. 223)` `incorporação (art. 227)`) EQUALS (JUST TRUE)
#ASSERT (`a operação pode ser feita entre sociedades de tipos iguais ou diferentes (art. 223)` `fusão (art. 228)`) EQUALS (JUST TRUE)
#ASSERT (`a operação pode ser feita entre sociedades de tipos iguais ou diferentes (art. 223)` `cisão (art. 229)`) EQUALS (JUST TRUE)
#ASSERT (`a operação pode ser feita entre sociedades de tipos iguais ou diferentes (art. 223)` `transformação (art. 220)`) EQUALS NOTHING
#ASSERT (`a operação pode ser feita entre sociedades de tipos iguais ou diferentes (art. 223)` `incorporação de ações (art. 252)`) EQUALS NOTHING
#ASSERT `a operação foi deliberada na forma prevista para a alteração dos estatutos ou contratos sociais (art. 223)` TRUE
#ASSERT (NOT `a operação foi deliberada na forma prevista para a alteração dos estatutos ou contratos sociais (art. 223)` FALSE)

-- Art. 223, § 1º, § 2º, § 3º.
#ASSERT `as normas de constituição do tipo da sociedade criada foram observadas (art. 223, § 1º)` TRUE TRUE
#ASSERT (NOT `as normas de constituição do tipo da sociedade criada foram observadas (art. 223, § 1º)` TRUE FALSE)
#ASSERT `as normas de constituição do tipo da sociedade criada foram observadas (art. 223, § 1º)` FALSE FALSE
#ASSERT `a entrega das ações aos sócios ou acionistas foi feita na forma do art. 223, § 2º` TRUE
#ASSERT (NOT `a entrega das ações aos sócios ou acionistas foi feita na forma do art. 223, § 2º` FALSE)
#ASSERT `as sociedades sucessoras devem ser abertas e obter registro e admissão à negociação (art. 223, § 3º)` TRUE
#ASSERT (NOT `as sociedades sucessoras devem ser abertas e obter registro e admissão à negociação (art. 223, § 3º)` FALSE)

-- Art. 223, § 3º: o prazo de cento e vinte dias, contado da assembleia que aprovou a operação (10 de janeiro de 2026: o prazo termina em 10 de maio de 2026).
#ASSERT (NOT `o prazo de cento e vinte dias do art. 223, § 3º foi descumprido` (YearMonthDay 2026 1 10) (JUST (YearMonthDay 2026 5 10)) (YearMonthDay 2026 5 20))
#ASSERT `o prazo de cento e vinte dias do art. 223, § 3º foi descumprido` (YearMonthDay 2026 1 10) (JUST (YearMonthDay 2026 5 11)) (YearMonthDay 2026 5 20)
#ASSERT `o prazo de cento e vinte dias do art. 223, § 3º foi descumprido` (YearMonthDay 2026 1 10) NOTHING (YearMonthDay 2026 5 11)
#ASSERT (NOT `o prazo de cento e vinte dias do art. 223, § 3º foi descumprido` (YearMonthDay 2026 1 10) NOTHING (YearMonthDay 2026 5 10))

