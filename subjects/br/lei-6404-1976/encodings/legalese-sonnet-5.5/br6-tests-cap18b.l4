#ASSERT (NOT `o acionista pode retirar-se da companhia por descumprimento do art. 223, § 3º (art. 223, § 4º)` (YearMonthDay 2026 1 10) NOTHING (YearMonthDay 2026 5 10) TRUE)
#ASSERT (NOT `o acionista pode retirar-se da companhia por descumprimento do art. 223, § 3º (art. 223, § 4º)` (YearMonthDay 2026 1 10) NOTHING (YearMonthDay 2026 5 11) FALSE)
#ASSERT `o acionista pode retirar-se da companhia por descumprimento do art. 223, § 3º (art. 223, § 4º)` (YearMonthDay 2026 1 10) (JUST (YearMonthDay 2026 5 20)) (YearMonthDay 2026 6 1) TRUE
#ASSERT (NOT `o acionista pode retirar-se da companhia por descumprimento do art. 223, § 3º (art. 223, § 4º)` (YearMonthDay 2026 1 10) (JUST (YearMonthDay 2026 5 1)) (YearMonthDay 2026 5 15) TRUE)

