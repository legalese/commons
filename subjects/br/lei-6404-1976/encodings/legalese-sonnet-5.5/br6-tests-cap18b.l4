#ASSERT `o acionista pode retirar-se da companhia por descumprimento do art. 223, § 3º (art. 223, § 4º)` (YearMonthDay 2026 1 10) NOTHING (YearMonthDay 2026 5 11) TRUE
#ASSERT `o acionista pode retirar-se da companhia por descumprimento do art. 223, § 3º (art. 223, § 4º)` (YearMonthDay 2026 1 10) NOTHING (YearMonthDay 2026 6 9) TRUE
