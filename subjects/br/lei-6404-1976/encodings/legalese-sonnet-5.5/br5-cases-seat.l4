IMPORT prelude
IMPORT `br-core`
IMPORT `br5-vocabulario`
IMPORT `br5-seat`

-- br5-cases-seat.l4 -- cases for the questions of br5-seat.l4: at least one case per question, with the expected
-- answer worked out by hand from the text (the sum or the date written beside it), and the cases of "not covered".
-- The layer-1 modules are tested in the br5-tests-*.l4 files; these cases test the seat: that each question reaches
-- the rule it means, that the records built in its WHERE carry each answer to the right field, and that a question
-- the Law does not answer says so (NOTHING).

§ `Arts. 175 a 177: o exercício social e as demonstrações financeiras`

-- art. 175: twelve months with the end date fixed; seven months in the first exercício; seven months otherwise.
#ASSERT `A duração do exercício social da minha companhia está de acordo com a lei` 12 FALSE FALSE TRUE
#ASSERT `A duração do exercício social da minha companhia está de acordo com a lei` 7 TRUE FALSE TRUE
#ASSERT NOT (`A duração do exercício social da minha companhia está de acordo com a lei` 7 FALSE FALSE TRUE)
-- art. 176: the cash-flow statement of a closed company is not owed below 2,000,000 of equity, and is owed at 2,000,000.
#ASSERT NOT (`A minha companhia deve elaborar esta demonstração financeira` `demonstração dos fluxos de caixa (art. 176, inciso IV)` `companhia fechada` 1_500_000)
#ASSERT `A minha companhia deve elaborar esta demonstração financeira` `demonstração dos fluxos de caixa (art. 176, inciso IV)` `companhia fechada` 2_000_000
#ASSERT `A minha companhia deve elaborar esta demonstração financeira` `demonstração do valor adicionado (art. 176, inciso V)` `companhia aberta` 0
-- A closed company with equity 1,000,000 that prepared the three statements it owes: in order. With equity 3,000,000 it owes the cash flow too.
#ASSERT `A diretoria fez elaborar as demonstrações financeiras que a lei exige` `companhia fechada` 1_000_000 TRUE TRUE TRUE FALSE FALSE TRUE TRUE
#ASSERT NOT (`A diretoria fez elaborar as demonstrações financeiras que a lei exige` `companhia fechada` 3_000_000 TRUE TRUE TRUE FALSE FALSE TRUE TRUE)
#ASSERT NOT (`A diretoria fez elaborar as demonstrações financeiras que a lei exige` `companhia aberta` 3_000_000 TRUE TRUE TRUE TRUE TRUE FALSE TRUE)
-- art. 176, § 1º.
#ASSERT `As demonstrações foram publicadas com os valores do exercício anterior` TRUE
#ASSERT NOT (`As demonstrações foram publicadas com os valores do exercício anterior` FALSE)
-- art. 176, § 2º: small balances may be aggregated if the nature is stated, they do not pass a tenth of the group (100 of 1,000 is allowed, 101 is not) and the name is not generic.
#ASSERT `A minha companhia pode agregar pequenos saldos numa só conta das demonstrações` TRUE 100 1000 FALSE
#ASSERT NOT (`A minha companhia pode agregar pequenos saldos numa só conta das demonstrações` TRUE 101 1000 FALSE)
#ASSERT NOT (`A minha companhia pode agregar pequenos saldos numa só conta das demonstrações` FALSE 50 1000 FALSE)
#ASSERT NOT (`A minha companhia pode agregar pequenos saldos numa só conta das demonstrações` TRUE 50 1000 TRUE)
-- art. 176, § 5º: the six always-present items, then the answer for the six conditional ones taken together.
#ASSERT `As notas explicativas das demonstrações trazem tudo o que a lei exige` TRUE TRUE TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`As notas explicativas das demonstrações trazem tudo o que a lei exige` TRUE TRUE TRUE TRUE TRUE TRUE FALSE)
#ASSERT NOT (`As notas explicativas das demonstrações trazem tudo o que a lei exige` FALSE TRUE TRUE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`As notas explicativas das demonstrações trazem tudo o que a lei exige` TRUE TRUE TRUE TRUE TRUE FALSE TRUE)
-- art. 177.
#ASSERT `A escrituração da minha companhia está de acordo com a lei` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`A escrituração da minha companhia está de acordo com a lei` TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`A mudança de método contábil foi indicada em nota como a lei exige` TRUE FALSE)
#ASSERT `A mudança de método contábil foi indicada em nota como a lei exige` FALSE FALSE
-- art. 177, § 3º: open company audited and under the CVM's norms; not audited; and a closed company, which the paragraph does not cover.
#ASSERT `As demonstrações da minha companhia aberta foram auditadas e observam as normas da CVM` `companhia aberta` TRUE TRUE EQUALS JUST TRUE
#ASSERT `As demonstrações da minha companhia aberta foram auditadas e observam as normas da CVM` `companhia aberta` TRUE FALSE EQUALS JUST FALSE
#ASSERT `As demonstrações da minha companhia aberta foram auditadas e observam as normas da CVM` `companhia fechada` TRUE TRUE EQUALS NOTHING
#ASSERT `As demonstrações financeiras foram assinadas como a lei exige` TRUE TRUE
#ASSERT NOT (`As demonstrações financeiras foram assinadas como a lei exige` TRUE FALSE)
-- art. 177, § 6º: only a closed company has the option.
#ASSERT `A minha companhia fechada pode optar por observar as normas da CVM para companhias abertas` `companhia fechada` EQUALS JUST TRUE
#ASSERT `A minha companhia fechada pode optar por observar as normas da CVM para companhias abertas` `companhia aberta` EQUALS NOTHING

§ `Arts. 178 a 188: o balanço, a avaliação e as demais demonstrações`

-- art. 179 with the exercício of 12 months. Facts in order: cash, prepaid expenses, a right due at a term, that term, related-party loan,
-- permanent holding, right not for the activity, tangible good, transfer of benefits, intangible; then the exercício and the cycle.
-- Cash: circulante. A right due in 15 months: circulante if the cycle is 18 months (the dividing term is then 18), long-term if the cycle is 6 (the term stays 12).
#ASSERT `Em que grupo do ativo a lei classifica esta conta do balanço da minha companhia` TRUE FALSE FALSE 0 FALSE FALSE FALSE FALSE FALSE FALSE 12 6 EQUALS JUST `ativo circulante (art. 179, inciso I)`
#ASSERT `Em que grupo do ativo a lei classifica esta conta do balanço da minha companhia` FALSE FALSE TRUE 15 FALSE FALSE FALSE FALSE FALSE FALSE 12 18 EQUALS JUST `ativo circulante (art. 179, inciso I)`
#ASSERT `Em que grupo do ativo a lei classifica esta conta do balanço da minha companhia` FALSE FALSE TRUE 15 FALSE FALSE FALSE FALSE FALSE FALSE 12 6 EQUALS JUST `ativo realizável a longo prazo (art. 179, inciso II)`
-- A tangible good for the activity: imobilizado. No fact at all: the Article does not sort it.
#ASSERT `Em que grupo do ativo a lei classifica esta conta do balanço da minha companhia` FALSE FALSE FALSE 0 FALSE FALSE FALSE TRUE FALSE FALSE 12 6 EQUALS JUST `ativo imobilizado (art. 179, inciso IV)`
#ASSERT `Em que grupo do ativo a lei classifica esta conta do balanço da minha companhia` FALSE FALSE FALSE 0 FALSE FALSE FALSE FALSE FALSE FALSE 12 6 EQUALS NOTHING
-- art. 180: due in 13 months with a cycle of 6: não circulante; due in 15 with a cycle of 18: circulante.
#ASSERT `Em que grupo do passivo a lei classifica esta obrigação da minha companhia` 13 12 6 EQUALS `passivo não circulante (art. 178, § 2º, inciso II)`
#ASSERT `Em que grupo do passivo a lei classifica esta obrigação da minha companhia` 15 12 18 EQUALS `passivo circulante (art. 178, § 2º, inciso I)`
-- art. 183: a financial application held for trading stands at fair value (90, not the cost of 100); an investment with the loss proved permanent: 100 - 30 = 70.
#ASSERT `Por quanto a lei manda avaliar este elemento do ativo no balanço da minha companhia` `aplicação destinada à negociação ou disponível para venda (art. 183, inciso I, alínea a)` 90 100 0 0 0 FALSE 0 EQUALS 90
#ASSERT `Por quanto a lei manda avaliar este elemento do ativo no balanço da minha companhia` `participação no capital social de outra sociedade (art. 183, inciso III)` 0 100 0 0 30 TRUE 0 EQUALS 70
-- art. 183, inciso III: a holding in an affiliate valued by the equity method (arts. 248 to 250) is not valued at cost; any other holding is.
#ASSERT NOT (`A minha participação em outra sociedade é avaliada pelo custo de aquisição` TRUE)
#ASSERT `A minha participação em outra sociedade é avaliada pelo custo de aquisição` FALSE
-- art. 183, § 3º: the analysis is owed; a decision to stop the undertaking or proof it cannot recover the value makes recording the loss owed; a need to revise the criteria makes revising them owed.
#ASSERT `A minha companhia cumpriu o dever de analisar a recuperação dos valores do imobilizado e do intangível` TRUE FALSE FALSE FALSE FALSE FALSE
#ASSERT NOT (`A minha companhia cumpriu o dever de analisar a recuperação dos valores do imobilizado e do intangível` FALSE FALSE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`A minha companhia cumpriu o dever de analisar a recuperação dos valores do imobilizado e do intangível` TRUE TRUE FALSE FALSE FALSE FALSE)
#ASSERT `A minha companhia cumpriu o dever de analisar a recuperação dos valores do imobilizado e do intangível` TRUE TRUE FALSE TRUE FALSE FALSE
#ASSERT NOT (`A minha companhia cumpriu o dever de analisar a recuperação dos valores do imobilizado e do intangível` TRUE FALSE FALSE FALSE TRUE FALSE)
#ASSERT `A minha companhia cumpriu o dever de analisar a recuperação dos valores do imobilizado e do intangível` TRUE FALSE FALSE FALSE TRUE TRUE
-- art. 183, § 3º, inciso I: either a decision to stop or proof of no recovery makes the loss owed to be recorded.
#ASSERT `A minha companhia deve registrar a perda de valor do capital aplicado neste empreendimento` TRUE FALSE
#ASSERT `A minha companhia deve registrar a perda de valor do capital aplicado neste empreendimento` FALSE TRUE
#ASSERT NOT (`A minha companhia deve registrar a perda de valor do capital aplicado neste empreendimento` FALSE FALSE)
-- art. 183, § 4º: fungible goods for sale may be valued at market value when that is the accepted custom; if it is not, no; other stock, the paragraph does not speak.
#ASSERT `A minha companhia pode avaliar este estoque pelo valor de mercado` TRUE TRUE EQUALS JUST TRUE
#ASSERT `A minha companhia pode avaliar este estoque pelo valor de mercado` TRUE FALSE EQUALS JUST FALSE
#ASSERT `A minha companhia pode avaliar este estoque pelo valor de mercado` FALSE TRUE EQUALS NOTHING
-- art. 184, inciso I: an obligation of 1,000 with 120 accrued stands at 1,120.
#ASSERT `Por quanto a lei manda avaliar esta obrigação no balanço da minha companhia` 1000 120 EQUALS 1120
-- art. 184, inciso II: with a parity clause, 100 units at a rate of 5 is 500; without one the inciso says nothing.
#ASSERT `Por quanto vai ao balanço esta obrigação em moeda estrangeira` TRUE 100 5 EQUALS JUST 500
#ASSERT `Por quanto vai ao balanço esta obrigação em moeda estrangeira` FALSE 100 5 EQUALS NOTHING
-- art. 184, inciso III: non-current liabilities always at present value; the others only when the effect is relevant.
#ASSERT `Esta obrigação deve ser ajustada a valor presente no balanço da minha companhia` TRUE FALSE
#ASSERT `Esta obrigação deve ser ajustada a valor presente no balanço da minha companhia` FALSE TRUE
#ASSERT NOT (`Esta obrigação deve ser ajustada a valor presente no balanço da minha companhia` FALSE FALSE)
-- art. 186: the three fixed items and the answer for the conditional ones taken together.
#ASSERT `A demonstração de lucros ou prejuízos acumulados da minha companhia discrimina o que a lei exige` TRUE TRUE TRUE TRUE
#ASSERT NOT (`A demonstração de lucros ou prejuízos acumulados da minha companhia discrimina o que a lei exige` TRUE TRUE TRUE FALSE)
#ASSERT NOT (`A demonstração de lucros ou prejuízos acumulados da minha companhia discrimina o que a lei exige` FALSE TRUE TRUE TRUE)
-- art. 187, inciso by inciso.
#ASSERT `A demonstração do resultado do exercício da minha companhia discrimina o que a lei exige` TRUE TRUE TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`A demonstração do resultado do exercício da minha companhia discrimina o que a lei exige` TRUE TRUE FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`A demonstração do resultado do exercício da minha companhia discrimina o que a lei exige` TRUE TRUE TRUE TRUE TRUE FALSE TRUE)
-- art. 188.
#ASSERT `A demonstração dos fluxos de caixa da minha companhia indica o mínimo que a lei exige` TRUE TRUE TRUE TRUE
#ASSERT NOT (`A demonstração dos fluxos de caixa da minha companhia indica o mínimo que a lei exige` TRUE TRUE FALSE TRUE)
#ASSERT `A demonstração do valor adicionado da minha companhia indica o mínimo que a lei exige` TRUE TRUE TRUE
#ASSERT NOT (`A demonstração do valor adicionado da minha companhia indica o mínimo que a lei exige` TRUE TRUE FALSE)

§ `Arts. 189 a 192: o lucro`

-- Revenues 2,500 less costs 1,000 is a result of 1,500; less 300 of accumulated losses and 200 of income-tax provision is 1,000;
-- then 10% to employees (100, left 900), 10% to administrators (90, left 810) and 10% to beneficial parts (81): net profit 729.
#ASSERT `Qual é o lucro líquido do exercício da minha companhia` 2500 1000 300 200 (10%) (10%) (10%) EQUALS 729
-- The same chain, but the participations asked on their own: result after the deductions 1,000.
`participações no exemplo (art. 190)` MEANS `Quanto a companhia deve pagar de participação a empregados, administradores e partes beneficiárias antes do meu dividendo` 1000 (10%) (10%) (10%)
#ASSERT `participações no exemplo (art. 190)`'s `a participação dos empregados em reais` EQUALS 100
#ASSERT `participações no exemplo (art. 190)`'s `a participação dos administradores em reais` EQUALS 90
#ASSERT `participações no exemplo (art. 190)`'s `a participação das partes beneficiárias em reais` EQUALS 81
-- art. 190, parágrafo único: administrators' participation yes; employees' not covered.
#ASSERT `Os parágrafos do art. 201 se aplicam a este pagamento que a companhia faz` `participação dos administradores (art. 190)` EQUALS JUST TRUE
#ASSERT `Os parágrafos do art. 201 se aplicam a este pagamento que a companhia faz` `participação dos empregados (art. 190)` EQUALS NOTHING
-- art. 189, parágrafo único: a loss of 100 against accumulated profits 30, other reserves 50 and legal reserve 40: 30, 50, 20, nothing left.
`absorção no exemplo (art. 189, parágrafo único)` MEANS `Como o prejuízo do exercício é absorvido` 100 30 50 40
#ASSERT `absorção no exemplo (art. 189, parágrafo único)`'s `o valor absorvido pelos lucros acumulados` EQUALS 30
#ASSERT `absorção no exemplo (art. 189, parágrafo único)`'s `o valor absorvido pelas reservas de lucros` EQUALS 50
#ASSERT `absorção no exemplo (art. 189, parágrafo único)`'s `o valor absorvido pela reserva legal` EQUALS 20
#ASSERT `absorção no exemplo (art. 189, parágrafo único)`'s `o prejuízo que resta sem absorção` EQUALS 0
-- art. 192.
#ASSERT `A proposta da administração sobre o lucro foi apresentada como a lei exige` TRUE `assembleia-geral ordinária` TRUE
#ASSERT NOT (`A proposta da administração sobre o lucro foi apresentada como a lei exige` TRUE `assembleia-geral extraordinária` TRUE)

§ `Arts. 193 a 200: reservas e retenção de lucros`

-- art. 193: 5% of 1,000 is 50, with 2,000 free under the ceiling (20% of 10,000); and nothing if the balance 2,000 plus capital reserves 1,001 passes 30% of 10,000.
#ASSERT `Quanto a companhia deve, no mínimo, destinar à reserva legal neste exercício` 1000 10000 0 0 EQUALS 50
#ASSERT `Quanto a companhia deve, no mínimo, destinar à reserva legal neste exercício` 1000 10000 2000 1001 EQUALS 0
#ASSERT `Para que a companhia pode usar a reserva legal` `compensar prejuízos (art. 193, § 2º)`
#ASSERT NOT (`Para que a companhia pode usar a reserva legal` `distribuir dividendos (art. 199)`)
#ASSERT `O estatuto pode criar esta reserva` TRUE TRUE TRUE
#ASSERT NOT (`O estatuto pode criar esta reserva` TRUE FALSE TRUE)
#ASSERT `A assembleia pode destinar parte do lucro à reserva para contingências` TRUE TRUE TRUE TRUE
#ASSERT NOT (`A assembleia pode destinar parte do lucro à reserva para contingências` TRUE FALSE TRUE TRUE)
#ASSERT `A reserva para contingências deve ser revertida neste exercício` TRUE FALSE
#ASSERT NOT (`A reserva para contingências deve ser revertida neste exercício` FALSE FALSE)
-- art. 195, § 1º: the proposal must state the cause of the foreseen loss and justify the reserve; both.
#ASSERT `A proposta da reserva para contingências indica a causa da perda e a justifica como a lei exige` TRUE TRUE
#ASSERT NOT (`A proposta da reserva para contingências indica a causa da perda e a justifica como a lei exige` TRUE FALSE)
#ASSERT NOT (`A proposta da reserva para contingências indica a causa da perda e a justifica como a lei exige` FALSE TRUE)
-- art. 195-A: 100 allocated out of 100 of subsidy profit may be left out of the base; 101 may not.
#ASSERT `Quanto da reserva de incentivos fiscais a assembleia pode excluir da base do dividendo obrigatório` TRUE 100 100 EQUALS 100
#ASSERT `Quanto da reserva de incentivos fiscais a assembleia pode excluir da base do dividendo obrigatório` TRUE 101 100 EQUALS 0
#ASSERT `A assembleia pode reter parte do lucro líquido` TRUE TRUE TRUE
#ASSERT NOT (`A assembleia pode reter parte do lucro líquido` TRUE TRUE FALSE)
-- art. 196, § 1º: submitted with the justification, covering all sources and applications, lasting up to 5 exercises (5 is allowed, 6 is not) unless an investment project runs longer.
#ASSERT `O orçamento de capital que justifica a retenção do meu lucro está de acordo com a lei` TRUE TRUE 5 FALSE
#ASSERT NOT (`O orçamento de capital que justifica a retenção do meu lucro está de acordo com a lei` TRUE TRUE 6 FALSE)
#ASSERT `O orçamento de capital que justifica a retenção do meu lucro está de acordo com a lei` TRUE TRUE 6 TRUE
#ASSERT NOT (`O orçamento de capital que justifica a retenção do meu lucro está de acordo com a lei` FALSE TRUE 3 FALSE)
#ASSERT NOT (`O orçamento de capital que justifica a retenção do meu lucro está de acordo com a lei` TRUE FALSE 3 FALSE)
-- art. 196, § 2º: approved by the ordinary meeting that decides on the balance sheet; revised every year only if it lasts more than one exercise.
#ASSERT `O orçamento de capital pode ser aprovado nesta assembleia` `assembleia-geral ordinária` TRUE
#ASSERT NOT (`O orçamento de capital pode ser aprovado nesta assembleia` `assembleia-geral extraordinária` TRUE)
#ASSERT NOT (`O orçamento de capital pode ser aprovado nesta assembleia` `assembleia-geral ordinária` FALSE)
#ASSERT `O orçamento de capital pode ser revisado todo ano` 2 EQUALS JUST TRUE
#ASSERT `O orçamento de capital pode ser revisado todo ano` 1 EQUALS NOTHING
-- art. 197: dividend 100, realized 60, so the excess is 40: allocating 40 is allowed, 41 is not.
#ASSERT `A assembleia pode destinar parte do lucro à reserva de lucros a realizar` TRUE 40 100 60
#ASSERT NOT (`A assembleia pode destinar parte do lucro à reserva de lucros a realizar` TRUE 41 100 60)
-- art. 197, § 1º: 1,000 less (100 + 200) is 700.
#ASSERT `Qual é a parcela realizada do lucro líquido` 1000 100 200 EQUALS 700
-- art. 197, § 2º: the reserve of profits to be realized serves only to pay the mandatory dividend; of the cash realized, the part up to the reserve balance counts (300 and 200 is 200; 300 and 500 is 300; none in the reserve is 0).
#ASSERT `Para que a companhia pode usar a reserva de lucros a realizar` `pagar o dividendo obrigatório (art. 197, § 2º)`
#ASSERT NOT (`Para que a companhia pode usar a reserva de lucros a realizar` `distribuir dividendos (art. 199)`)
#ASSERT NOT (`Para que a companhia pode usar a reserva de lucros a realizar` `compensar prejuízos (art. 193, § 2º)`)
#ASSERT `Quanto do lucro realizado em dinheiro conta como integrante da reserva de lucros a realizar` 300 200 EQUALS 200
#ASSERT `Quanto do lucro realizado em dinheiro conta como integrante da reserva de lucros a realizar` 300 500 EQUALS 300
#ASSERT `Quanto do lucro realizado em dinheiro conta como integrante da reserva de lucros a realizar` 0 100 EQUALS 0
-- art. 198: profit left 1,000 less 300 and 200 leaves 500, exactly the dividend of 500; against 501 it does not.
#ASSERT `As reservas estatutárias e a retenção de lucros respeitam o meu direito ao dividendo obrigatório` 1000 300 200 500
#ASSERT NOT (`As reservas estatutárias e a retenção de lucros respeitam o meu direito ao dividendo obrigatório` 1000 300 200 501)
-- art. 199: the capped reserves total 100 + 200 + 300 + 50 = 650; adding 351 makes 1,001 against a capital of 1,000; adding 350 makes exactly 1,000.
#ASSERT `A assembleia deve deliberar sobre a aplicação do excesso das reservas de lucros` 100 200 999 999 300 999 50 1000 351
#ASSERT NOT (`A assembleia deve deliberar sobre a aplicação do excesso das reservas de lucros` 100 200 999 999 300 999 50 1000 350)
-- art. 199: the excess goes to paying up or raising the capital, or to dividends; not to absorbing losses.
#ASSERT `A assembleia pode aplicar o excesso das reservas de lucros desta forma` `integralizar o capital social (art. 199)`
#ASSERT `A assembleia pode aplicar o excesso das reservas de lucros desta forma` `aumentar ou incorporar ao capital social (art. 193, § 2º)`
#ASSERT `A assembleia pode aplicar o excesso das reservas de lucros desta forma` `distribuir dividendos (art. 199)`
#ASSERT NOT (`A assembleia pode aplicar o excesso das reservas de lucros desta forma` `compensar prejuízos (art. 193, § 2º)`)
-- art. 200.
#ASSERT `A companhia pode usar a reserva de capital para este fim` `compensar prejuízos (art. 193, § 2º)` TRUE FALSE
#ASSERT NOT (`A companhia pode usar a reserva de capital para este fim` `pagar o dividendo obrigatório (art. 197, § 2º)` TRUE TRUE)

§ `Arts. 201 a 205: dividendos`

-- art. 201: from the net profit yes; from a capital reserve only for the preferred shares of art. 17, § 5º.
#ASSERT `De que fonte a companhia pode pagar o meu dividendo` `lucro líquido do exercício (art. 201)` FALSE
#ASSERT `De que fonte a companhia pode pagar o meu dividendo` `reserva de capital (art. 201)` TRUE
#ASSERT NOT (`De que fonte a companhia pode pagar o meu dividendo` `reserva de capital (art. 201)` FALSE)
#ASSERT `Os administradores e fiscais respondem por um dividendo distribuído contra a lei` FALSE
#ASSERT NOT (`Os administradores e fiscais respondem por um dividendo distribuído contra a lei` TRUE)
#ASSERT `Quanto os administradores e fiscais devem repor à caixa da companhia` FALSE 1000 EQUALS 1000
#ASSERT `Quanto os administradores e fiscais devem repor à caixa da companhia` TRUE 1000 EQUALS 0
-- art. 201, § 2º: received in good faith, but no balance sheet was drawn up: bad faith is presumed, so I must return it; unless the presumption is rebutted.
#ASSERT `Sou obrigado a restituir o dividendo que recebi` TRUE TRUE FALSE FALSE
#ASSERT NOT (`Sou obrigado a restituir o dividendo que recebi` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`Sou obrigado a restituir o dividendo que recebi` TRUE FALSE FALSE FALSE)
-- art. 202, inciso I: 1,000 - 50 - 100 + 30 = 880, half is 440 when the estatuto is silent; the estatuto's own 300 when it fixes one.
#ASSERT `Quanto é o dividendo obrigatório do exercício da minha companhia` 1000 50 100 30 0 FALSE 0 EQUALS 440
#ASSERT `Quanto é o dividendo obrigatório do exercício da minha companhia` 1000 50 100 30 0 TRUE 300 EQUALS 300
-- art. 186, § 2º: 1,000 over 100 shares is 10 a share; with no shares there is no figure.
#ASSERT `Quanto é o dividendo por ação do capital social` 1000 100 EQUALS JUST 10
#ASSERT `Quanto é o dividendo por ação do capital social` 1000 0 EQUALS NOTHING
-- art. 202, inciso II: dividend 440, realized 300, limited and recorded: pay 300, record 140.
`dividendo limitado no exemplo (art. 202, inciso II)` MEANS `A companhia pode limitar o pagamento do meu dividendo ao lucro realizado, e quanto ela paga` 440 300 TRUE TRUE
#ASSERT `dividendo limitado no exemplo (art. 202, inciso II)`'s `o dividendo a pagar em reais` EQUALS 300
#ASSERT `dividendo limitado no exemplo (art. 202, inciso II)`'s `a diferença a registrar como reserva de lucros a realizar em reais` EQUALS 140
#ASSERT `Quanto se acrescenta ao primeiro dividendo declarado depois que o lucro a realizar se realiza` 100 30 EQUALS 70
#ASSERT `O critério que o estatuto fixa para o dividendo é válido` TRUE FALSE
#ASSERT NOT (`O critério que o estatuto fixa para o dividendo é válido` TRUE TRUE)
-- art. 202, § 2º: 25% of 1,000 is 250; exactly 250 respects it, 249 does not; where the estatuto was not silent the paragraph says nothing.
#ASSERT `O dividendo fixado ao alterar um estatuto omisso respeita o mínimo de 25% do lucro ajustado` TRUE 250 1000 EQUALS JUST TRUE
#ASSERT `O dividendo fixado ao alterar um estatuto omisso respeita o mínimo de 25% do lucro ajustado` TRUE 249 1000 EQUALS JUST FALSE
#ASSERT `O dividendo fixado ao alterar um estatuto omisso respeita o mínimo de 25% do lucro ajustado` FALSE 0 1000 EQUALS NOTHING
-- art. 202, § 3º: in a closed company the meeting may reduce the dividend if no one present opposes; my opposition blocks it, and so does another's.
#ASSERT `A assembleia pode reduzir o dividendo ou reter todo o lucro se eu me opuser` `companhia fechada` FALSE FALSE FALSE FALSE FALSE
#ASSERT NOT (`A assembleia pode reduzir o dividendo ou reter todo o lucro se eu me opuser` `companhia fechada` FALSE FALSE FALSE TRUE FALSE)
#ASSERT NOT (`A assembleia pode reduzir o dividendo ou reter todo o lucro se eu me opuser` `companhia fechada` FALSE FALSE FALSE FALSE TRUE)
-- art. 202: a resolution to pay less that the Law does not allow (I opposed) leaves the dividend due in full; one it allows does not.
#ASSERT `A companhia deve me pagar o dividendo obrigatório por inteiro neste exercício` `companhia fechada` FALSE FALSE FALSE TRUE TRUE FALSE
#ASSERT NOT (`A companhia deve me pagar o dividendo obrigatório por inteiro neste exercício` `companhia fechada` FALSE FALSE FALSE FALSE TRUE FALSE)
-- art. 202, § 4º.
#ASSERT `O dividendo obrigatório deixa de ser devido se a administração informar a assembleia de que é incompatível com a situação financeira` TRUE
#ASSERT NOT (`O dividendo obrigatório deixa de ser devido se a administração informar a assembleia de que é incompatível com a situação financeira` FALSE)
#ASSERT `O conselho fiscal cumpriu o dever de dar parecer sobre a informação da administração` TRUE TRUE
#ASSERT NOT (`O conselho fiscal cumpriu o dever de dar parecer sobre a informação da administração` TRUE FALSE)
-- The meeting on 28 April: 5 days later is 3 May (April has 30 days). Sent on 3 May is in time; sent on 4 May is late; a closed company is never late.
#ASSERT `Até que dia os administradores da companhia aberta devem enviar à CVM a exposição sobre a informação dada à assembleia` (YMD 2026 4 28) EQUALS (YMD 2026 5 3)
#ASSERT `Os administradores enviaram a exposição à CVM no prazo de 5 dias da assembleia` `companhia aberta` (YMD 2026 4 28) (YMD 2026 5 3)
#ASSERT NOT (`Os administradores enviaram a exposição à CVM no prazo de 5 dias da assembleia` `companhia aberta` (YMD 2026 4 28) (YMD 2026 5 4))
#ASSERT `Os administradores enviaram a exposição à CVM no prazo de 5 dias da assembleia` `companhia fechada` (YMD 2026 4 28) (YMD 2026 9 1)
-- art. 202, § 5º: 1,000 not distributed, 400 absorbed, the situation allows: 600; if it does not allow it yet, nothing now.
#ASSERT `Quanto da reserva especial deve ser pago como dividendo agora` 1000 400 TRUE EQUALS 600
#ASSERT `Quanto da reserva especial deve ser pago como dividendo agora` 1000 400 FALSE EQUALS 0
-- art. 202, § 6º: 1,000 less 50 + 100 + 30 + 20 + 200 + 10 = 410 is 590.
#ASSERT `Quanto dos lucros não destinados deve ser distribuído como dividendo` 1000 50 100 30 20 200 10 EQUALS 590
-- art. 203: preferred shares with priority, 100 fixed and 40 in arrears, cumulative: 140; the same shares without priority, and ordinary shares: not covered.
#ASSERT `Tenho direito ao dividendo fixo ou mínimo das minhas ações preferenciais e aos atrasados` `ações preferenciais` `ações nominativas` 100 TRUE FALSE TRUE 100 40 TRUE EQUALS JUST 140
#ASSERT `Tenho direito ao dividendo fixo ou mínimo das minhas ações preferenciais e aos atrasados` `ações preferenciais` `ações nominativas` 100 TRUE FALSE FALSE 100 40 TRUE EQUALS NOTHING
#ASSERT `Tenho direito ao dividendo fixo ou mínimo das minhas ações preferenciais e aos atrasados` `ações ordinárias` `ações nominativas` 100 TRUE FALSE TRUE 100 40 TRUE EQUALS NOTHING
-- art. 204.
#ASSERT `A administração pode declarar dividendo à conta do balanço semestral` TRUE TRUE TRUE
#ASSERT NOT (`A administração pode declarar dividendo à conta do balanço semestral` TRUE FALSE TRUE)
#ASSERT `A companhia pode distribuir dividendos em períodos menores que o semestre` TRUE 100 100 100
#ASSERT NOT (`A companhia pode distribuir dividendos em períodos menores que o semestre` TRUE 101 50 100)
#ASSERT `O estatuto pode autorizar a administração a declarar dividendo intermediário à conta desta fonte` `lucros acumulados (art. 201)` TRUE
#ASSERT NOT (`O estatuto pode autorizar a administração a declarar dividendo intermediário à conta desta fonte` `reserva de capital (art. 201)` TRUE)
-- art. 205: registered shares; bearer shares are not covered by the caput.
#ASSERT `Sou eu quem recebe o dividendo declarado das minhas ações` `ações nominativas` TRUE EQUALS JUST TRUE
#ASSERT `Sou eu quem recebe o dividendo declarado das minhas ações` `ações ao portador` TRUE EQUALS NOTHING
#ASSERT `A companhia pode me pagar o dividendo por este meio` `cheque nominativo remetido por via postal (art. 205, § 1º)` TRUE FALSE EQUALS JUST TRUE
#ASSERT `A companhia pode me pagar o dividendo por este meio` `qualquer outro meio de pagamento (art. 205, § 1º)` TRUE TRUE EQUALS NOTHING
#ASSERT `A quem a companhia paga o dividendo das ações em custódia bancária ou em depósito` TRUE FALSE EQUALS `a instituição financeira`
#ASSERT `A quem a companhia paga o dividendo das ações em custódia bancária ou em depósito` FALSE FALSE EQUALS `o acionista`
-- art. 205, § 3º: declared 1 March, no other date: 60 days is 30 April. The date asked "if the meeting fixed one" is not read when it fixed none:
-- repeating the declaration date and a date from 2020 give the same answer.
#ASSERT `Até que dia a companhia deve me pagar o dividendo declarado` (YMD 2026 3 1) FALSE (YMD 2026 3 1) (YMD 2026 12 31) EQUALS (YMD 2026 4 30)
#ASSERT `Até que dia a companhia deve me pagar o dividendo declarado` (YMD 2026 3 1) FALSE (YMD 2020 1 1) (YMD 2026 12 31) EQUALS (YMD 2026 4 30)
-- The meeting fixed 15 June: that date. Declared 15 November: 60 days would pass the exercício, which ends 31 December.
#ASSERT `Até que dia a companhia deve me pagar o dividendo declarado` (YMD 2026 3 1) TRUE (YMD 2026 6 15) (YMD 2026 12 31) EQUALS (YMD 2026 6 15)
#ASSERT `Até que dia a companhia deve me pagar o dividendo declarado` (YMD 2026 11 15) FALSE (YMD 2026 11 15) (YMD 2026 12 31) EQUALS (YMD 2026 12 31)
#ASSERT `A companhia me pagou o dividendo no prazo` (YMD 2026 3 1) (YMD 2026 4 30) FALSE (YMD 2026 3 1) (YMD 2026 12 31)
#ASSERT NOT (`A companhia me pagou o dividendo no prazo` (YMD 2026 3 1) (YMD 2026 5 1) FALSE (YMD 2026 3 1) (YMD 2026 12 31))
