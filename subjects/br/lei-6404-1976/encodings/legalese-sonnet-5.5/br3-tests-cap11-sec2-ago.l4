IMPORT prelude
IMPORT `br-core`
IMPORT `br3-nomes`
IMPORT `br3-cap11-sec1-competencia-convocacao`
IMPORT `br3-cap11-sec2-ago`

-- br3-tests-cap11-sec2-ago.l4 -- tests of Arts. 132 to 134. Each expected value is written from the text of the provision
-- named beside it, before running. Dates are written year first.

§ `Testes dos arts. 132 a 134`

§§ `Art. 132`

-- Four months after the end of the fiscal year: 31 Dec 2025 gives 30 Apr 2026; 30 Nov 2025 gives 30 Mar 2026; and
-- 31 Oct 2025 gives 28 Feb 2026 (the keel's way of counting a month that is shorter).
#ASSERT `o último dia para realizar a assembleia-geral ordinária (art. 132)` (YMD 2025 12 31) EQUALS YMD 2026 4 30
#ASSERT `o último dia para realizar a assembleia-geral ordinária (art. 132)` (YMD 2025 11 30) EQUALS YMD 2026 3 30
#ASSERT `o último dia para realizar a assembleia-geral ordinária (art. 132)` (YMD 2025 10 31) EQUALS YMD 2026 2 28
#ASSERT `a assembleia-geral ordinária foi realizada no prazo (art. 132)` (YMD 2025 12 31) (YMD 2026 4 30)
#ASSERT NOT (`a assembleia-geral ordinária foi realizada no prazo (art. 132)` (YMD 2025 12 31) (YMD 2026 5 1))
#ASSERT `a assembleia-geral ordinária foi realizada no prazo (art. 132)` (YMD 2025 12 31) (YMD 2026 1 15)
#ASSERT NOT (`a assembleia-geral ordinária foi realizada no prazo (art. 132)` (YMD 2025 12 31) (YMD 2025 12 30))
#ASSERT `a assembleia-geral ordinária deve deliberar sobre a matéria (art. 132)` `contas dos administradores e demonstrações financeiras (art. 132, inciso I)` FALSE
#ASSERT `a assembleia-geral ordinária deve deliberar sobre a matéria (art. 132)` `destinação do lucro líquido e distribuição de dividendos (art. 132, inciso II)` FALSE
#ASSERT `a assembleia-geral ordinária deve deliberar sobre a matéria (art. 132)` `correção da expressão monetária do capital social (art. 132, inciso IV)` FALSE
#ASSERT `a assembleia-geral ordinária deve deliberar sobre a matéria (art. 132)` `eleição de administradores e membros do conselho fiscal (art. 132, inciso III)` TRUE
#ASSERT NOT (`a assembleia-geral ordinária deve deliberar sobre a matéria (art. 132)` `eleição de administradores e membros do conselho fiscal (art. 132, inciso III)` FALSE)

§§ `Art. 133`

-- The announcement a month before the meeting set for 30 Apr 2026: 30 Mar is the last day.
#ASSERT `a comunicação dos documentos foi feita com um mês de antecedência (art. 133)` (YMD 2026 3 30) (YMD 2026 4 30)
#ASSERT NOT (`a comunicação dos documentos foi feita com um mês de antecedência (art. 133)` (YMD 2026 3 31) (YMD 2026 4 30))
-- The documents owed: the opinions of the auditors and of the fiscal council only if there are any.
#ASSERT `o documento deve ser posto à disposição dos acionistas (art. 133)` `relatório da administração (art. 133, inciso I)` FALSE FALSE
#ASSERT `o documento deve ser posto à disposição dos acionistas (art. 133)` `cópia das demonstrações financeiras (art. 133, inciso II)` FALSE FALSE
#ASSERT `o documento deve ser posto à disposição dos acionistas (art. 133)` `demais documentos pertinentes a assuntos da ordem do dia (art. 133, inciso V)` FALSE FALSE
#ASSERT `o documento deve ser posto à disposição dos acionistas (art. 133)` `parecer dos auditores independentes (art. 133, inciso III)` TRUE FALSE
#ASSERT NOT (`o documento deve ser posto à disposição dos acionistas (art. 133)` `parecer dos auditores independentes (art. 133, inciso III)` FALSE TRUE)
#ASSERT `o documento deve ser posto à disposição dos acionistas (art. 133)` `parecer do conselho fiscal (art. 133, inciso IV)` FALSE TRUE
#ASSERT NOT (`o documento deve ser posto à disposição dos acionistas (art. 133)` `parecer do conselho fiscal (art. 133, inciso IV)` TRUE FALSE)
-- § 1º
#ASSERT `o anúncio cumpre o dever de indicar onde obter cópias (art. 133, § 1º)` TRUE
#ASSERT NOT (`o anúncio cumpre o dever de indicar onde obter cópias (art. 133, § 1º)` FALSE)
-- § 2º: the copy goes to the shareholder who asked in writing, in the conditions of Art. 124, § 3º.
#ASSERT `a companhia deve remeter cópia dos documentos ao acionista que pediu por escrito (art. 133, § 2º)` `companhia fechada` 50 1000 TRUE 2 TRUE EQUALS JUST TRUE
#ASSERT `a companhia deve remeter cópia dos documentos ao acionista que pediu por escrito (art. 133, § 2º)` `companhia aberta` 50 1000 TRUE 2 TRUE EQUALS JUST FALSE
#ASSERT `a companhia deve remeter cópia dos documentos ao acionista que pediu por escrito (art. 133, § 2º)` `companhia fechada` 50 1000 TRUE 3 TRUE EQUALS NOTHING
-- § 3º: the documents of incisos I to III are published at least 5 days before 30 Apr 2026 (25 Apr is the last day); IV and V are excepted.
#ASSERT `o documento foi publicado com cinco dias de antecedência (art. 133, § 3º)` `relatório da administração (art. 133, inciso I)` (YMD 2026 4 25) (YMD 2026 4 30) EQUALS JUST TRUE
#ASSERT `o documento foi publicado com cinco dias de antecedência (art. 133, § 3º)` `relatório da administração (art. 133, inciso I)` (YMD 2026 4 26) (YMD 2026 4 30) EQUALS JUST FALSE
#ASSERT `o documento foi publicado com cinco dias de antecedência (art. 133, § 3º)` `cópia das demonstrações financeiras (art. 133, inciso II)` (YMD 2026 4 25) (YMD 2026 4 30) EQUALS JUST TRUE
#ASSERT `o documento foi publicado com cinco dias de antecedência (art. 133, § 3º)` `parecer dos auditores independentes (art. 133, inciso III)` (YMD 2026 4 26) (YMD 2026 4 30) EQUALS JUST FALSE
#ASSERT `o documento foi publicado com cinco dias de antecedência (art. 133, § 3º)` `parecer do conselho fiscal (art. 133, inciso IV)` (YMD 2026 4 28) (YMD 2026 4 30) EQUALS NOTHING
#ASSERT `o documento foi publicado com cinco dias de antecedência (art. 133, § 3º)` `demais documentos pertinentes a assuntos da ordem do dia (art. 133, inciso V)` (YMD 2026 4 28) (YMD 2026 4 30) EQUALS NOTHING
-- § 4º: the meeting of all the shareholders may cure the notices and the time limits, not the publication of the documents.
#ASSERT `a assembleia pode considerar sanada a falta de anúncios ou de prazos (art. 133, § 4º)` TRUE EQUALS JUST TRUE
#ASSERT `a assembleia pode considerar sanada a falta de anúncios ou de prazos (art. 133, § 4º)` FALSE EQUALS NOTHING
#ASSERT `a publicação dos documentos antes da assembleia continua obrigatória (art. 133, § 4º)` TRUE EQUALS JUST TRUE
#ASSERT `a publicação dos documentos antes da assembleia continua obrigatória (art. 133, § 4º)` FALSE EQUALS NOTHING
-- § 5º: the notices are waived if the documents are published a month before the meeting.
#ASSERT `a publicação dos anúncios é dispensada (art. 133, § 5º)` (YMD 2026 3 30) (YMD 2026 4 30)
#ASSERT NOT (`a publicação dos anúncios é dispensada (art. 133, § 5º)` (YMD 2026 3 31) (YMD 2026 4 30))
-- § 6º
#ASSERT `o relatório da administração tem o conteúdo exigido sobre equidade (art. 133, § 6º)` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`o relatório da administração tem o conteúdo exigido sobre equidade (art. 133, § 6º)` FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`o relatório da administração tem o conteúdo exigido sobre equidade (art. 133, § 6º)` TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`o relatório da administração tem o conteúdo exigido sobre equidade (art. 133, § 6º)` TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`o relatório da administração tem o conteúdo exigido sobre equidade (art. 133, § 6º)` TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`o relatório da administração tem o conteúdo exigido sobre equidade (art. 133, § 6º)` TRUE TRUE TRUE TRUE FALSE)

§§ `Art. 134`

#ASSERT `os documentos devem ser lidos e submetidos à discussão e votação (art. 134)` TRUE TRUE
#ASSERT NOT (`os documentos devem ser lidos e submetidos à discussão e votação (art. 134)` FALSE TRUE)
#ASSERT NOT (`os documentos devem ser lidos e submetidos à discussão e votação (art. 134)` TRUE FALSE)
-- § 1º: at least one manager, and the independent auditor if there is one.
#ASSERT `os administradores e o auditor independente cumpriram o dever de comparecer (art. 134, § 1º)` TRUE FALSE FALSE
#ASSERT `os administradores e o auditor independente cumpriram o dever de comparecer (art. 134, § 1º)` TRUE TRUE TRUE
#ASSERT NOT (`os administradores e o auditor independente cumpriram o dever de comparecer (art. 134, § 1º)` TRUE TRUE FALSE)
#ASSERT NOT (`os administradores e o auditor independente cumpriram o dever de comparecer (art. 134, § 1º)` FALSE FALSE FALSE)
-- §§ 1º and 6º: the managers cannot vote the documents, unless the directors are the only shareholders of a closed company.
#ASSERT `o administrador pode votar os documentos como acionista ou procurador (art. 134, §§ 1º e 6º)` `companhia fechada` TRUE
#ASSERT NOT (`o administrador pode votar os documentos como acionista ou procurador (art. 134, §§ 1º e 6º)` `companhia fechada` FALSE)
#ASSERT NOT (`o administrador pode votar os documentos como acionista ou procurador (art. 134, §§ 1º e 6º)` `companhia aberta` TRUE)
-- § 2º
#ASSERT `a assembleia pode adiar a deliberação e ordenar diligências (art. 134, § 2º)` TRUE EQUALS JUST TRUE
#ASSERT `a assembleia pode adiar a deliberação e ordenar diligências (art. 134, § 2º)` FALSE EQUALS NOTHING
#ASSERT `a deliberação deve ser adiada (art. 134, § 2º)` TRUE FALSE
#ASSERT NOT (`a deliberação deve ser adiada (art. 134, § 2º)` TRUE TRUE)
#ASSERT NOT (`a deliberação deve ser adiada (art. 134, § 2º)` FALSE FALSE)
-- § 3º: approval without reservation exonerates the managers and fiscais, barring error, fraud, deceit or simulation.
#ASSERT `a aprovação exonera de responsabilidade os administradores e fiscais (art. 134, § 3º)` TRUE FALSE
#ASSERT NOT (`a aprovação exonera de responsabilidade os administradores e fiscais (art. 134, § 3º)` TRUE TRUE)
#ASSERT NOT (`a aprovação exonera de responsabilidade os administradores e fiscais (art. 134, § 3º)` FALSE FALSE)
-- § 4º: republication within 30 days of the meeting (30 Apr 2026: until 30 May 2026); the changes to the allocation go in the minutes.
#ASSERT `os administradores devem republicar as demonstrações financeiras (art. 134, § 4º)` TRUE
#ASSERT NOT (`os administradores devem republicar as demonstrações financeiras (art. 134, § 4º)` FALSE)
#ASSERT `o último dia para republicar as demonstrações financeiras (art. 134, § 4º)` (YMD 2026 4 30) EQUALS YMD 2026 5 30
#ASSERT `as modificações da destinação dos lucros devem constar da ata (art. 134, § 4º)` TRUE
#ASSERT NOT (`as modificações da destinação dos lucros devem constar da ata (art. 134, § 4º)` FALSE)
-- § 5º
#ASSERT `a ata deve ser arquivada no registro do comércio e publicada (art. 134, § 5º)` TRUE EQUALS JUST TRUE
#ASSERT `a ata deve ser arquivada no registro do comércio e publicada (art. 134, § 5º)` FALSE EQUALS NOTHING
