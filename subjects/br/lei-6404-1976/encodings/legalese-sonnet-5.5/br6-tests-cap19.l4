IMPORT prelude
IMPORT `br-core`
IMPORT `br6-cap19-economia-mista`

-- br6-tests-cap19.l4 -- tests of br6-cap19-economia-mista.l4 (Arts. 235 to 240; Arts. 241 and 242 are repealed).
-- Expected values come from the text of lei-6404-1976.pt.txt (a converter's plain-text rendering, not the official text), never from the output of the code.



-- Art. 235: a legislação aplicável.
#ASSERT `a sociedade de economia mista está sujeita a esta Lei (art. 235)` TRUE
#ASSERT (NOT `a sociedade de economia mista está sujeita a esta Lei (art. 235)` FALSE)
#ASSERT `a disposição especial de lei federal prevalece sobre esta Lei (art. 235)` TRUE TRUE
#ASSERT (NOT `a disposição especial de lei federal prevalece sobre esta Lei (art. 235)` TRUE FALSE)
#ASSERT (NOT `a disposição especial de lei federal prevalece sobre esta Lei (art. 235)` FALSE TRUE)
#ASSERT `a companhia aberta de economia mista está sujeita às normas da Comissão de Valores Mobiliários (art. 235, § 1º)` `companhia aberta` TRUE
#ASSERT (NOT `a companhia aberta de economia mista está sujeita às normas da Comissão de Valores Mobiliários (art. 235, § 1º)` `companhia fechada` TRUE)
#ASSERT (NOT `a companhia aberta de economia mista está sujeita às normas da Comissão de Valores Mobiliários (art. 235, § 1º)` `companhia aberta` FALSE)
#ASSERT `a companhia de que participa sociedade de economia mista está sujeita a esta Lei sem as exceções do Capítulo XIX (art. 235, § 2º)` TRUE
#ASSERT (NOT `a companhia de que participa sociedade de economia mista está sujeita a esta Lei sem as exceções do Capítulo XIX (art. 235, § 2º)` FALSE)

-- Art. 236: autorização legislativa prévia; reembolso quando pessoa jurídica de direito público adquire o controle por desapropriação (60 dias da publicação em 1º de março de 2026: até 30 de abril de 2026).
#ASSERT `a constituição da companhia de economia mista foi precedida de autorização legislativa (art. 236)` TRUE TRUE
#ASSERT (NOT `a constituição da companhia de economia mista foi precedida de autorização legislativa (art. 236)` TRUE FALSE)
#ASSERT `a constituição da companhia de economia mista foi precedida de autorização legislativa (art. 236)` FALSE FALSE
#ASSERT `o acionista pode pedir o reembolso das suas ações (art. 236, parágrafo único)` TRUE FALSE FALSE (YMD 2026 3 1) (YMD 2026 4 30)
#ASSERT (NOT `o acionista pode pedir o reembolso das suas ações (art. 236, parágrafo único)` TRUE FALSE FALSE (YMD 2026 3 1) (YMD 2026 5 1))
#ASSERT (NOT `o acionista pode pedir o reembolso das suas ações (art. 236, parágrafo único)` TRUE TRUE FALSE (YMD 2026 3 1) (YMD 2026 4 1))
#ASSERT (NOT `o acionista pode pedir o reembolso das suas ações (art. 236, parágrafo único)` TRUE FALSE TRUE (YMD 2026 3 1) (YMD 2026 4 1))
#ASSERT (NOT `o acionista pode pedir o reembolso das suas ações (art. 236, parágrafo único)` FALSE FALSE FALSE (YMD 2026 3 1) (YMD 2026 4 1))

-- Art. 237: o objeto; a participação em outras sociedades (§ 1º) e a exceção das instituições financeiras (§ 2º).
#ASSERT (`a companhia de economia mista pode exercer a atividade (art. 237)` TRUE TRUE) EQUALS (JUST TRUE)
#ASSERT (`a companhia de economia mista pode exercer a atividade (art. 237)` TRUE FALSE) EQUALS (JUST FALSE)
#ASSERT (`a companhia de economia mista pode exercer a atividade (art. 237)` FALSE TRUE) EQUALS NOTHING
#ASSERT (`a companhia de economia mista pode participar de outras sociedades (art. 237, §§ 1º e 2º)` FALSE FALSE TRUE TRUE) EQUALS NOTHING
#ASSERT (`a companhia de economia mista pode participar de outras sociedades (art. 237, §§ 1º e 2º)` TRUE FALSE TRUE FALSE) EQUALS (JUST TRUE)
#ASSERT (`a companhia de economia mista pode participar de outras sociedades (art. 237, §§ 1º e 2º)` TRUE FALSE FALSE TRUE) EQUALS (JUST FALSE)
#ASSERT (`a companhia de economia mista pode participar de outras sociedades (art. 237, §§ 1º e 2º)` TRUE TRUE FALSE TRUE) EQUALS (JUST TRUE)
#ASSERT (`a companhia de economia mista pode participar de outras sociedades (art. 237, §§ 1º e 2º)` TRUE TRUE TRUE FALSE) EQUALS (JUST FALSE)

-- Art. 238: o acionista controlador.
#ASSERT `a pessoa jurídica controladora tem os deveres e responsabilidades do acionista controlador (art. 238)` TRUE
#ASSERT (NOT `a pessoa jurídica controladora tem os deveres e responsabilidades do acionista controlador (art. 238)` FALSE)
#ASSERT `a pessoa jurídica controladora pode orientar as atividades da companhia para atender ao interesse público que justificou a sua criação (art. 238)` TRUE TRUE
#ASSERT (NOT `a pessoa jurídica controladora pode orientar as atividades da companhia para atender ao interesse público que justificou a sua criação (art. 238)` TRUE FALSE)
#ASSERT (NOT `a pessoa jurídica controladora pode orientar as atividades da companhia para atender ao interesse público que justificou a sua criação (art. 238)` FALSE TRUE)

-- Art. 239: conselho de administração obrigatório; direito da minoria de eleger um conselheiro, ou mais se o voto múltiplo lhe der mais.
#ASSERT `a companhia de economia mista tem o conselho de administração que a Lei exige (art. 239)` TRUE TRUE
#ASSERT (NOT `a companhia de economia mista tem o conselho de administração que a Lei exige (art. 239)` TRUE FALSE)
#ASSERT `a companhia de economia mista tem o conselho de administração que a Lei exige (art. 239)` FALSE FALSE
#ASSERT (`a quantidade de conselheiros que a minoria tem direito de eleger (art. 239)` TRUE 0) EQUALS (JUST 1)
#ASSERT (`a quantidade de conselheiros que a minoria tem direito de eleger (art. 239)` TRUE 1) EQUALS (JUST 1)
#ASSERT (`a quantidade de conselheiros que a minoria tem direito de eleger (art. 239)` TRUE 2) EQUALS (JUST 2)
#ASSERT (`a quantidade de conselheiros que a minoria tem direito de eleger (art. 239)` FALSE 2) EQUALS NOTHING
#ASSERT (`os administradores têm os deveres e responsabilidades dos administradores de companhia aberta (art. 239, parágrafo único)` TRUE) EQUALS (JUST TRUE)
#ASSERT (`os administradores têm os deveres e responsabilidades dos administradores de companhia aberta (art. 239, parágrafo único)` FALSE) EQUALS NOTHING

-- Art. 240: conselho fiscal permanente; um membro eleito pelas ordinárias minoritárias e outro pelas preferenciais.
#ASSERT `a companhia de economia mista tem o conselho fiscal permanente que a Lei exige (art. 240)` TRUE TRUE
#ASSERT (NOT `a companhia de economia mista tem o conselho fiscal permanente que a Lei exige (art. 240)` TRUE FALSE)
#ASSERT `a companhia de economia mista tem o conselho fiscal permanente que a Lei exige (art. 240)` FALSE FALSE
#ASSERT (`as ações da espécie elegem um membro do conselho fiscal e o suplente (art. 240)` TRUE `ações ordinárias` TRUE) EQUALS (JUST TRUE)
#ASSERT (`as ações da espécie elegem um membro do conselho fiscal e o suplente (art. 240)` TRUE `ações ordinárias` FALSE) EQUALS (JUST FALSE)
#ASSERT (`as ações da espécie elegem um membro do conselho fiscal e o suplente (art. 240)` TRUE `ações preferenciais` FALSE) EQUALS (JUST TRUE)
#ASSERT (`as ações da espécie elegem um membro do conselho fiscal e o suplente (art. 240)` TRUE `ações de fruição` FALSE) EQUALS NOTHING
#ASSERT (`as ações da espécie elegem um membro do conselho fiscal e o suplente (art. 240)` FALSE `ações preferenciais` FALSE) EQUALS NOTHING
