IMPORT prelude
IMPORT `br-core`
IMPORT `br3-cap10-sec6-7-exterior-suspensao`

-- br3-tests-cap10-sec6-7-exterior-suspensao.l4 -- tests of Arts. 119 and 120. Each expected value is written from the
-- text of the article named beside it, before running.

§ `Testes dos arts. 119 e 120`

-- Art. 119: a shareholder living or domiciled abroad must keep a representative in the country.
#ASSERT `o acionista deve manter no País representante com poderes para receber citação (art. 119)` TRUE
#ASSERT NOT (`o acionista deve manter no País representante com poderes para receber citação (art. 119)` FALSE)
#ASSERT `o mandatário ou representante pode receber citação judicial (art. 119, parágrafo único)` TRUE
#ASSERT NOT (`o mandatário ou representante pode receber citação judicial (art. 119, parágrafo único)` FALSE)

-- Art. 120: the power exists only against a shareholder in default; for an essential right of Art. 109 the text does not
-- reconcile it with the ban on deprivation.
#ASSERT `a assembleia-geral pode suspender o exercício do direito do acionista (art. 120)` TRUE FALSE EQUALS JUST TRUE
#ASSERT `a assembleia-geral pode suspender o exercício do direito do acionista (art. 120)` TRUE TRUE EQUALS NOTHING
#ASSERT `a assembleia-geral pode suspender o exercício do direito do acionista (art. 120)` FALSE FALSE EQUALS JUST FALSE
#ASSERT `a assembleia-geral pode suspender o exercício do direito do acionista (art. 120)` FALSE TRUE EQUALS JUST FALSE
-- The suspension ends as soon as the obligation is met.
#ASSERT `a suspensão do exercício dos direitos cessa (art. 120)` TRUE
#ASSERT NOT (`a suspensão do exercício dos direitos cessa (art. 120)` FALSE)
