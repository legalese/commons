IMPORT prelude
IMPORT `br-core`
IMPORT `br5-vocabulario`
IMPORT `br5-reservas`

-- br5-tests-reservas.l4 -- tests of br5-reservas.l4 (Arts. 193 to 200).
-- Every expected value was worked out by hand from the text, with the sum written beside it.
-- Amounts are in reais.

§ `Testes do Art. 193: reserva legal`

-- The ceiling is 20% of the capital: 20% of 10000 is 2000.
#ASSERT `o limite da reserva legal em reais (art. 193)` 10000 EQUALS 2000
-- 5% of a profit of 1000 is 50, and 2000 is free under the ceiling: 50.
#ASSERT `a importância a aplicar na reserva legal em reais (art. 193)` 1000 10000 0 EQUALS 50
-- The balance is 1990, so 2000 - 1990 = 10 is free under the ceiling, less than 50: 10.
#ASSERT `a importância a aplicar na reserva legal em reais (art. 193)` 1000 10000 1990 EQUALS 10
-- Boundary: the balance is exactly at the ceiling (2000), so nothing is free: 0.
#ASSERT `a importância a aplicar na reserva legal em reais (art. 193)` 1000 10000 2000 EQUALS 0
-- The balance is above the ceiling (2500): the free part would be negative, so nothing: 0.
#ASSERT `a importância a aplicar na reserva legal em reais (art. 193)` 1000 10000 2500 EQUALS 0
-- A large profit: 5% of 200000 is 10000, but only 2000 is free under the ceiling: 2000.
#ASSERT `a importância a aplicar na reserva legal em reais (art. 193)` 200000 10000 0 EQUALS 2000
-- No profit (zero) and a loss (minus 100): nothing is put in the reserve.
#ASSERT `a importância a aplicar na reserva legal em reais (art. 193)` 0 10000 0 EQUALS 0
#ASSERT `a importância a aplicar na reserva legal em reais (art. 193)` (0 MINUS 100) 10000 0 EQUALS 0

§§ `Testes do Art. 193, § 1º: dispensa da reserva legal`

-- Capital 10000: 30% is 3000. Balance 2000 + capital reserves 1001 = 3001 exceeds 3000: may leave it out.
#ASSERT `a companhia pode deixar de constituir a reserva legal no exercício (art. 193, § 1º)` 2000 1001 10000
-- Boundary: 2000 + 1000 = 3000 is exactly 30%, it does not exceed it: may not.
#ASSERT NOT (`a companhia pode deixar de constituir a reserva legal no exercício (art. 193, § 1º)` 2000 1000 10000)
-- Well below: may not.
#ASSERT NOT (`a companhia pode deixar de constituir a reserva legal no exercício (art. 193, § 1º)` 1000 500 10000)
-- The least the company must put in: nothing when § 1º lets it leave the reserve out (1000 + 2001 = 3001 > 3000).
#ASSERT `o menor valor que a companhia deve aplicar na reserva legal no exercício em reais (art. 193)` 1000 10000 1000 2001 EQUALS 0
-- Otherwise the caput sum: 5% of 1000 = 50, with 1000 free under the ceiling: 50 (1000 + 500 = 1500 does not exceed 3000).
#ASSERT `o menor valor que a companhia deve aplicar na reserva legal no exercício em reais (art. 193)` 1000 10000 1000 500 EQUALS 50

§§ `Testes do Art. 193, § 2º: usos da reserva legal`

#ASSERT `o uso da reserva legal é permitido (art. 193, § 2º)` `compensar prejuízos (art. 193, § 2º)`
#ASSERT `o uso da reserva legal é permitido (art. 193, § 2º)` `aumentar ou incorporar ao capital social (art. 193, § 2º)`
#ASSERT NOT (`o uso da reserva legal é permitido (art. 193, § 2º)` `pagar o dividendo obrigatório (art. 197, § 2º)`)
#ASSERT NOT (`o uso da reserva legal é permitido (art. 193, § 2º)` `distribuir dividendos (art. 199)`)
#ASSERT NOT (`o uso da reserva legal é permitido (art. 193, § 2º)` `qualquer outro uso (art. 200)`)

§ `Testes do Art. 194: reservas estatutárias`

#ASSERT `o estatuto pode criar a reserva (art. 194)` TRUE TRUE TRUE
#ASSERT NOT (`o estatuto pode criar a reserva (art. 194)` FALSE TRUE TRUE)
#ASSERT NOT (`o estatuto pode criar a reserva (art. 194)` TRUE FALSE TRUE)
#ASSERT NOT (`o estatuto pode criar a reserva (art. 194)` TRUE TRUE FALSE)

§ `Testes do Art. 195: reservas para contingências`

#ASSERT `a assembleia-geral pode destinar parte do lucro líquido à reserva para contingências (art. 195)` TRUE TRUE TRUE TRUE
#ASSERT NOT (`a assembleia-geral pode destinar parte do lucro líquido à reserva para contingências (art. 195)` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`a assembleia-geral pode destinar parte do lucro líquido à reserva para contingências (art. 195)` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`a assembleia-geral pode destinar parte do lucro líquido à reserva para contingências (art. 195)` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`a assembleia-geral pode destinar parte do lucro líquido à reserva para contingências (art. 195)` TRUE TRUE TRUE FALSE)
-- § 1º: both the cause and the prudence reasons.
#ASSERT `a proposta da reserva para contingências indica a causa e justifica a constituição (art. 195, § 1º)` TRUE TRUE
#ASSERT NOT (`a proposta da reserva para contingências indica a causa e justifica a constituição (art. 195, § 1º)` FALSE TRUE)
#ASSERT NOT (`a proposta da reserva para contingências indica a causa e justifica a constituição (art. 195, § 1º)` TRUE FALSE)
-- § 2º: reversed when either the reasons cease or the loss happens.
#ASSERT `a reserva para contingências deve ser revertida no exercício (art. 195, § 2º)` TRUE FALSE
#ASSERT `a reserva para contingências deve ser revertida no exercício (art. 195, § 2º)` FALSE TRUE
#ASSERT `a reserva para contingências deve ser revertida no exercício (art. 195, § 2º)` TRUE TRUE
#ASSERT NOT (`a reserva para contingências deve ser revertida no exercício (art. 195, § 2º)` FALSE FALSE)

§ `Testes do Art. 195-A: reserva de incentivos fiscais`

-- Boundary: 100 allocated out of 100 of government-subsidy profit: may.
#ASSERT `a assembleia-geral pode destinar o valor à reserva de incentivos fiscais (art. 195-A)` TRUE 100 100
-- 101 out of 100: may not.
#ASSERT NOT (`a assembleia-geral pode destinar o valor à reserva de incentivos fiscais (art. 195-A)` TRUE 101 100)
-- Without the administration's proposal: may not.
#ASSERT NOT (`a assembleia-geral pode destinar o valor à reserva de incentivos fiscais (art. 195-A)` FALSE 100 100)
-- The amount that may be left out of the dividend base: the sum allocated when allowed, otherwise 0.
#ASSERT `o valor que pode ser excluído da base do dividendo obrigatório em reais (art. 195-A)` TRUE 100 100 EQUALS 100
#ASSERT `o valor que pode ser excluído da base do dividendo obrigatório em reais (art. 195-A)` TRUE 60 100 EQUALS 60
#ASSERT `o valor que pode ser excluído da base do dividendo obrigatório em reais (art. 195-A)` TRUE 101 100 EQUALS 0
#ASSERT `o valor que pode ser excluído da base do dividendo obrigatório em reais (art. 195-A)` FALSE 100 100 EQUALS 0

§ `Testes do Art. 196: retenção de lucros`

#ASSERT `a assembleia-geral pode reter parcela do lucro líquido (art. 196)` TRUE TRUE TRUE
#ASSERT NOT (`a assembleia-geral pode reter parcela do lucro líquido (art. 196)` FALSE TRUE TRUE)
#ASSERT NOT (`a assembleia-geral pode reter parcela do lucro líquido (art. 196)` TRUE FALSE TRUE)
#ASSERT NOT (`a assembleia-geral pode reter parcela do lucro líquido (art. 196)` TRUE TRUE FALSE)

§§ `Testes do Art. 196, § 1º: orçamento de capital`

-- Boundary: a budget of 5 exercises is within the limit.
#ASSERT `o orçamento de capital está de acordo com a lei (art. 196, § 1º)` TRUE TRUE 5 FALSE
-- 6 exercises without a longer investment project: over the limit.
#ASSERT NOT (`o orçamento de capital está de acordo com a lei (art. 196, § 1º)` TRUE TRUE 6 FALSE)
-- 6 exercises, but it carries out an investment project that runs longer: allowed.
#ASSERT `o orçamento de capital está de acordo com a lei (art. 196, § 1º)` TRUE TRUE 6 TRUE
-- Without the justification, or without covering every source and application: not in order.
#ASSERT NOT (`o orçamento de capital está de acordo com a lei (art. 196, § 1º)` FALSE TRUE 3 FALSE)
#ASSERT NOT (`o orçamento de capital está de acordo com a lei (art. 196, § 1º)` TRUE FALSE 3 FALSE)

§§ `Testes do Art. 196, § 2º: aprovação e revisão do orçamento`

#ASSERT `o orçamento de capital pode ser aprovado nessa assembleia (art. 196, § 2º)` `assembleia-geral ordinária` TRUE
#ASSERT NOT (`o orçamento de capital pode ser aprovado nessa assembleia (art. 196, § 2º)` `assembleia-geral extraordinária` TRUE)
#ASSERT NOT (`o orçamento de capital pode ser aprovado nessa assembleia (art. 196, § 2º)` `assembleia-geral ordinária` FALSE)
-- May be revised every year when it lasts longer than one exercise ("poderá"): for 1 exercise the paragraph says nothing, for 2 it is permitted.
#ASSERT `o orçamento de capital pode ser revisado anualmente (art. 196, § 2º)` 1 EQUALS NOTHING
#ASSERT `o orçamento de capital pode ser revisado anualmente (art. 196, § 2º)` 2 EQUALS JUST TRUE

§ `Testes do Art. 197: reserva de lucros a realizar`

-- Dividend 100, realized profit 60: the excess is 100 - 60 = 40.
#ASSERT `o excesso do dividendo obrigatório sobre o lucro realizado em reais (art. 197)` 100 60 EQUALS 40
-- Realized profit equal to the dividend (100): no excess.
#ASSERT `o excesso do dividendo obrigatório sobre o lucro realizado em reais (art. 197)` 100 100 EQUALS 0
-- Realized profit above the dividend (150): no excess, and never negative.
#ASSERT `o excesso do dividendo obrigatório sobre o lucro realizado em reais (art. 197)` 100 150 EQUALS 0
-- May allocate the excess (40), not more (41), and not without the proposal.
#ASSERT `a assembleia-geral pode destinar o valor à reserva de lucros a realizar (art. 197)` TRUE 40 100 60
#ASSERT NOT (`a assembleia-geral pode destinar o valor à reserva de lucros a realizar (art. 197)` TRUE 41 100 60)
#ASSERT NOT (`a assembleia-geral pode destinar o valor à reserva de lucros a realizar (art. 197)` FALSE 40 100 60)
-- No excess at all (realized 100 of dividend 100): nothing may be allocated under this article.
#ASSERT NOT (`a assembleia-geral pode destinar o valor à reserva de lucros a realizar (art. 197)` TRUE 10 100 100)

§§ `Testes do Art. 197, § 1º: parte realizada do lucro líquido`

-- Profit 1000; equity-method result 100 and long-term market-value gains 200: realized part is 1000 - (100 + 200) = 700.
#ASSERT `a parcela realizada do lucro líquido em reais (art. 197, § 1º)` 1000 100 200 EQUALS 700
-- Nothing to take out: the whole profit is realized.
#ASSERT `a parcela realizada do lucro líquido em reais (art. 197, § 1º)` 1000 0 0 EQUALS 1000
-- The two items pass the profit (200 against 100 + 200): nothing exceeds, so 0.
#ASSERT `a parcela realizada do lucro líquido em reais (art. 197, § 1º)` 200 100 200 EQUALS 0

§§ `Testes do Art. 197, § 2º: uso da reserva e lucros realizados primeiro`

#ASSERT `o uso da reserva de lucros a realizar é permitido (art. 197, § 2º)` `pagar o dividendo obrigatório (art. 197, § 2º)`
#ASSERT NOT (`o uso da reserva de lucros a realizar é permitido (art. 197, § 2º)` `distribuir dividendos (art. 199)`)
#ASSERT NOT (`o uso da reserva de lucros a realizar é permitido (art. 197, § 2º)` `compensar prejuízos (art. 193, § 2º)`)
-- The exercise has 80 in the reserve and 50 was realized in cash: 50 counts as the reserve's.
#ASSERT `o valor realizado em dinheiro que se considera integrante da reserva de lucros a realizar em reais (art. 197, § 2º)` 80 50 EQUALS 50
-- 120 realized in cash, but only 80 is in the reserve: 80.
#ASSERT `o valor realizado em dinheiro que se considera integrante da reserva de lucros a realizar em reais (art. 197, § 2º)` 80 120 EQUALS 80
#ASSERT `o valor realizado em dinheiro que se considera integrante da reserva de lucros a realizar em reais (art. 197, § 2º)` 80 0 EQUALS 0

§ `Testes do Art. 198: limite da constituição de reservas e retenção`

-- Profit left 1000, statutory reserves 300, retention 200: 1000 - 300 - 200 = 500 left, and the dividend is 500: covered (boundary).
#ASSERT `a destinação às reservas estatutárias e a retenção respeitam o dividendo obrigatório (art. 198)` 1000 300 200 500
-- Dividend 501: the allocations are to the prejudice of the dividend.
#ASSERT NOT (`a destinação às reservas estatutárias e a retenção respeitam o dividendo obrigatório (art. 198)` 1000 300 200 501)
-- No reserves and no retention: the dividend of 500 is covered.
#ASSERT `a destinação às reservas estatutárias e a retenção respeitam o dividendo obrigatório (art. 198)` 1000 0 0 500

§ `Testes do Art. 199: limite do saldo das reservas de lucros`

-- Balances: legal 100, statutory 200, contingency 999, tax incentive 999, retained profits 300, profits to be realized 999, special 50.
-- Subject to the limit: 100 + 200 + 300 + 50 = 650 (the three excluded reserves are left out, so their 999 does not count).
`saldos de teste (art. 199)` MEANS `Saldos das reservas de lucros (art. 199)` WITH
    `o saldo da reserva legal` IS 100
    `o saldo das reservas estatutárias` IS 200
    `o saldo da reserva para contingências` IS 999
    `o saldo da reserva de incentivos fiscais` IS 999
    `o saldo da reserva de retenção de lucros` IS 300
    `o saldo da reserva de lucros a realizar` IS 999
    `o saldo da reserva especial` IS 50

#ASSERT `o saldo das reservas de lucros sujeito ao limite em reais (art. 199)` `saldos de teste (art. 199)` EQUALS 650
-- Capital 1000: adding 350 makes 650 + 350 = 1000, exactly the capital, so no excess.
#ASSERT `o excesso das reservas de lucros sobre o capital social em reais (art. 199)` `saldos de teste (art. 199)` 1000 350 EQUALS 0
#ASSERT NOT (`a assembleia-geral deve deliberar sobre a aplicação do excesso (art. 199)` `saldos de teste (art. 199)` 1000 350)
-- Adding 351 makes 1001: the excess is 1.
#ASSERT `o excesso das reservas de lucros sobre o capital social em reais (art. 199)` `saldos de teste (art. 199)` 1000 351 EQUALS 1
#ASSERT `a assembleia-geral deve deliberar sobre a aplicação do excesso (art. 199)` `saldos de teste (art. 199)` 1000 351
-- Adding nothing: 650 against 1000, no excess.
#ASSERT NOT (`a assembleia-geral deve deliberar sobre a aplicação do excesso (art. 199)` `saldos de teste (art. 199)` 1000 0)
-- Applications of the excess: paying up capital, increasing capital, distributing dividends.
#ASSERT `a aplicação do excesso das reservas de lucros é permitida (art. 199)` `integralizar o capital social (art. 199)`
#ASSERT `a aplicação do excesso das reservas de lucros é permitida (art. 199)` `aumentar ou incorporar ao capital social (art. 193, § 2º)`
#ASSERT `a aplicação do excesso das reservas de lucros é permitida (art. 199)` `distribuir dividendos (art. 199)`
#ASSERT NOT (`a aplicação do excesso das reservas de lucros é permitida (art. 199)` `resgatar, reembolsar ou comprar ações (art. 200, inciso II)`)

§ `Testes do Art. 200: reserva de capital`

-- I: absorbing losses only when they pass the accumulated profits and the profit reserves.
#ASSERT `o uso da reserva de capital é permitido (art. 200)` `compensar prejuízos (art. 193, § 2º)` TRUE FALSE
#ASSERT NOT (`o uso da reserva de capital é permitido (art. 200)` `compensar prejuízos (art. 193, § 2º)` FALSE FALSE)
-- II, III, IV: without condition.
#ASSERT `o uso da reserva de capital é permitido (art. 200)` `resgatar, reembolsar ou comprar ações (art. 200, inciso II)` FALSE FALSE
#ASSERT `o uso da reserva de capital é permitido (art. 200)` `resgatar partes beneficiárias (art. 200, inciso III)` FALSE FALSE
#ASSERT `o uso da reserva de capital é permitido (art. 200)` `aumentar ou incorporar ao capital social (art. 193, § 2º)` FALSE FALSE
-- V: the dividend of preferred shares, only when that advantage is assured to them.
#ASSERT `o uso da reserva de capital é permitido (art. 200)` `pagar dividendo a ações preferenciais (art. 200, inciso V)` FALSE TRUE
#ASSERT NOT (`o uso da reserva de capital é permitido (art. 200)` `pagar dividendo a ações preferenciais (art. 200, inciso V)` FALSE FALSE)
-- "somente": any other use is not allowed.
#ASSERT NOT (`o uso da reserva de capital é permitido (art. 200)` `pagar o dividendo obrigatório (art. 197, § 2º)` TRUE TRUE)
#ASSERT NOT (`o uso da reserva de capital é permitido (art. 200)` `distribuir dividendos (art. 199)` TRUE TRUE)
#ASSERT NOT (`o uso da reserva de capital é permitido (art. 200)` `qualquer outro uso (art. 200)` TRUE TRUE)

§§ `Testes do Art. 200, parágrafo único: reserva da venda de partes beneficiárias`

#ASSERT `a reserva da venda de partes beneficiárias pode ser destinada ao resgate delas (art. 200, parágrafo único)` TRUE `resgatar partes beneficiárias (art. 200, inciso III)`
#ASSERT NOT (`a reserva da venda de partes beneficiárias pode ser destinada ao resgate delas (art. 200, parágrafo único)` TRUE `aumentar ou incorporar ao capital social (art. 193, § 2º)`)
#ASSERT NOT (`a reserva da venda de partes beneficiárias pode ser destinada ao resgate delas (art. 200, parágrafo único)` FALSE `resgatar partes beneficiárias (art. 200, inciso III)`)
