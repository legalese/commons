IMPORT prelude
IMPORT `br-core`
IMPORT `br5-vocabulario`
IMPORT `br5-exercicio-social`

-- br5-tests-exercicio-social.l4 -- tests of br5-exercicio-social.l4 (Art. 175).

§ `Testes do Art. 175: exercício social`

-- Twelve months is the statutory duration; eleven and thirteen are not.
#ASSERT `o exercício social tem a duração que a lei estabelece (art. 175)` 12
#ASSERT NOT (`o exercício social tem a duração que a lei estabelece (art. 175)` 11)
#ASSERT NOT (`o exercício social tem a duração que a lei estabelece (art. 175)` 13)
-- Any other duration is permitted only for the first exercício or one in which the estatuto was altered.
#ASSERT `a duração do exercício social é permitida (art. 175, parágrafo único)` 12 FALSE FALSE
#ASSERT `a duração do exercício social é permitida (art. 175, parágrafo único)` 7 TRUE FALSE
#ASSERT `a duração do exercício social é permitida (art. 175, parágrafo único)` 15 FALSE TRUE
#ASSERT `a duração do exercício social é permitida (art. 175, parágrafo único)` 7 TRUE TRUE
#ASSERT NOT (`a duração do exercício social é permitida (art. 175, parágrafo único)` 7 FALSE FALSE)
-- The whole Article: a permitted duration and the last day fixed in the estatuto.
#ASSERT `o exercício social está de acordo com o art. 175` 12 FALSE FALSE TRUE
#ASSERT `o exercício social está de acordo com o art. 175` 6 TRUE FALSE TRUE
#ASSERT NOT (`o exercício social está de acordo com o art. 175` 12 FALSE FALSE FALSE)
#ASSERT NOT (`o exercício social está de acordo com o art. 175` 6 FALSE FALSE TRUE)
