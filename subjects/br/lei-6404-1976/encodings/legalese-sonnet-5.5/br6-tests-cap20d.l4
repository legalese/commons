IMPORT prelude
IMPORT `br-core`
IMPORT `br6-cap20b-demonstracoes-financeiras`
IMPORT `br6-cap20d-alienacao-compra-de-controle`

-- br6-tests-cap20d.l4 -- tests of br6-cap20d-alienacao-compra-de-controle.l4 (Arts. 254-A, 255 and 256; Art. 254 is repealed).
-- Expected values come from the text of lei-6404-1976.pt.txt (a converter's plain-text rendering, not the official text), never from the output of the code.



-- Art. 254-A, caput: condição da oferta pública, preço mínimo de 80% do valor pago por ação do bloco de controle, quem está dentro da oferta.
#ASSERT (`o contrato de alienação do controle pode ser contratado (art. 254-A)` `companhia aberta` TRUE) EQUALS (JUST TRUE)
#ASSERT (`o contrato de alienação do controle pode ser contratado (art. 254-A)` `companhia aberta` FALSE) EQUALS (JUST FALSE)
#ASSERT (`o contrato de alienação do controle pode ser contratado (art. 254-A)` `companhia fechada` TRUE) EQUALS NOTHING
#ASSERT (`o preço mínimo por ação com direito a voto que a oferta pública deve assegurar (art. 254-A)` 100) EQUALS 80
#ASSERT `o preço da oferta pública cumpre o mínimo (art. 254-A)` 80 100
#ASSERT `o preço da oferta pública cumpre o mínimo (art. 254-A)` 100 100
#ASSERT (NOT `o preço da oferta pública cumpre o mínimo (art. 254-A)` 79 100)
#ASSERT `o acionista tem direito a ser incluído na oferta pública de aquisição (art. 254-A)` TRUE FALSE
#ASSERT (NOT `o acionista tem direito a ser incluído na oferta pública de aquisição (art. 254-A)` FALSE FALSE)
#ASSERT (NOT `o acionista tem direito a ser incluído na oferta pública de aquisição (art. 254-A)` TRUE TRUE)

-- Art. 254-A, § 1º: o que é alienação de controle.
#ASSERT (`a transferência é alienação de controle (art. 254-A, § 1º)` `ações integrantes do bloco de controle (art. 254-A, § 1º)` TRUE) EQUALS (JUST TRUE)
#ASSERT (`a transferência é alienação de controle (art. 254-A, § 1º)` `ações integrantes do bloco de controle (art. 254-A, § 1º)` FALSE) EQUALS (JUST FALSE)
#ASSERT (`a transferência é alienação de controle (art. 254-A, § 1º)` `ações vinculadas a acordos de acionistas (art. 254-A, § 1º)` TRUE) EQUALS (JUST TRUE)
#ASSERT (`a transferência é alienação de controle (art. 254-A, § 1º)` `ações vinculadas a acordos de acionistas (art. 254-A, § 1º)` FALSE) EQUALS (JUST FALSE)
#ASSERT (`a transferência é alienação de controle (art. 254-A, § 1º)` `valores mobiliários conversíveis em ações com direito a voto (art. 254-A, § 1º)` TRUE) EQUALS (JUST TRUE)
#ASSERT (`a transferência é alienação de controle (art. 254-A, § 1º)` `valores mobiliários conversíveis em ações com direito a voto (art. 254-A, § 1º)` FALSE) EQUALS (JUST FALSE)
#ASSERT (`a transferência é alienação de controle (art. 254-A, § 1º)` `cessão de direitos de subscrição de ações (art. 254-A, § 1º)` TRUE) EQUALS (JUST TRUE)
#ASSERT (`a transferência é alienação de controle (art. 254-A, § 1º)` `cessão de direitos de subscrição de ações (art. 254-A, § 1º)` FALSE) EQUALS (JUST FALSE)
#ASSERT (`a transferência é alienação de controle (art. 254-A, § 1º)` `outros títulos ou direitos relativos a valores mobiliários conversíveis em ações (art. 254-A, § 1º)` TRUE) EQUALS (JUST TRUE)
#ASSERT (`a transferência é alienação de controle (art. 254-A, § 1º)` `outros títulos ou direitos relativos a valores mobiliários conversíveis em ações (art. 254-A, § 1º)` FALSE) EQUALS (JUST FALSE)
#ASSERT (`a transferência é alienação de controle (art. 254-A, § 1º)` `outro objeto não relacionado no § 1º (art. 254-A, § 1º)` TRUE) EQUALS NOTHING

-- Art. 254-A, § 2º e § 4º.
#ASSERT `a alienação de controle pode ser autorizada pela Comissão de Valores Mobiliários (art. 254-A, § 2º)` TRUE
#ASSERT (NOT `a alienação de controle pode ser autorizada pela Comissão de Valores Mobiliários (art. 254-A, § 2º)` FALSE)
#ASSERT `o adquirente pode oferecer aos acionistas minoritários a opção de permanecer na companhia (art. 254-A, § 4º)` `companhia aberta` TRUE
#ASSERT (NOT `o adquirente pode oferecer aos acionistas minoritários a opção de permanecer na companhia (art. 254-A, § 4º)` `companhia fechada` TRUE)
#ASSERT (NOT `o adquirente pode oferecer aos acionistas minoritários a opção de permanecer na companhia (art. 254-A, § 4º)` `companhia aberta` FALSE)
#ASSERT (`o prêmio por ação que o adquirente paga ao minoritário que opta por permanecer (art. 254-A, § 4º)` 90 100) EQUALS 10
#ASSERT (`o prêmio por ação que o adquirente paga ao minoritário que opta por permanecer (art. 254-A, § 4º)` 110 100) EQUALS 10
#ASSERT (`o prêmio por ação que o adquirente paga ao minoritário que opta por permanecer (art. 254-A, § 4º)` 100 100) EQUALS 0

-- Art. 255: autorização do órgão competente quando a companhia aberta depende de autorização do governo para funcionar.
#ASSERT `a alienação do controle depende de prévia autorização do órgão competente para aprovar a alteração do estatuto (art. 255)` `companhia aberta` TRUE
#ASSERT (NOT `a alienação do controle depende de prévia autorização do órgão competente para aprovar a alteração do estatuto (art. 255)` `companhia fechada` TRUE)
#ASSERT (NOT `a alienação do controle depende de prévia autorização do órgão competente para aprovar a alteração do estatuto (art. 255)` `companhia aberta` FALSE)

-- Art. 256, II: uma vez e meia o maior de três valores (cotação, patrimônio líquido a preços de mercado, lucro limitado a quinze vezes o lucro anual).
#ASSERT (`o valor do lucro líquido da ação ou quota, limitado a quinze vezes o lucro anual por ação (art. 256, inciso II, alínea c)` 100 10) EQUALS 100
#ASSERT (`o valor do lucro líquido da ação ou quota, limitado a quinze vezes o lucro anual por ação (art. 256, inciso II, alínea c)` 200 10) EQUALS 150
#ASSERT (`o valor do lucro líquido da ação ou quota, limitado a quinze vezes o lucro anual por ação (art. 256, inciso II, alínea c)` 150 10) EQUALS 150
#ASSERT `o preço médio ultrapassa uma vez e meia o maior dos três valores (art. 256, inciso II)` 151 100 80 60 10
#ASSERT (NOT `o preço médio ultrapassa uma vez e meia o maior dos três valores (art. 256, inciso II)` 150 100 80 60 10)
#ASSERT `o preço médio ultrapassa uma vez e meia o maior dos três valores (art. 256, inciso II)` 226 0 0 1000 10
#ASSERT (NOT `o preço médio ultrapassa uma vez e meia o maior dos três valores (art. 256, inciso II)` 225 0 0 1000 10)
#ASSERT `o preço médio ultrapassa uma vez e meia o maior dos três valores (art. 256, inciso II)` 121 0 80 60 10
#ASSERT (NOT `o preço médio ultrapassa uma vez e meia o maior dos três valores (art. 256, inciso II)` 120 0 80 60 10)

-- Art. 256, caput e I: a deliberação da assembleia-geral da compradora.
#ASSERT (`a compra do controle depende de deliberação da assembleia-geral da compradora (art. 256)` `companhia aberta` 10 14 100 100 100 80 60 10) EQUALS (JUST TRUE)
#ASSERT (`a compra do controle depende de deliberação da assembleia-geral da compradora (art. 256)` `companhia aberta` 9 14 100 100 100 80 60 10) EQUALS (JUST FALSE)
#ASSERT (`a compra do controle depende de deliberação da assembleia-geral da compradora (art. 256)` `companhia aberta` 9 15 100 100 100 80 60 10) EQUALS (JUST TRUE)
#ASSERT (`a compra do controle depende de deliberação da assembleia-geral da compradora (art. 256)` `companhia aberta` 9 14 100 151 100 80 60 10) EQUALS (JUST TRUE)
#ASSERT (`a compra do controle depende de deliberação da assembleia-geral da compradora (art. 256)` `companhia fechada` 50 50 100 500 100 80 60 10) EQUALS NOTHING

-- Art. 256, § 1º: laudo de avaliação e submissão prévia à assembleia-geral, sob pena de responsabilidade dos administradores.
#ASSERT (NOT `os administradores da compradora respondem por não submeter a compra à assembleia-geral (art. 256, § 1º)` TRUE TRUE TRUE)
#ASSERT `os administradores da compradora respondem por não submeter a compra à assembleia-geral (art. 256, § 1º)` TRUE FALSE TRUE
#ASSERT `os administradores da compradora respondem por não submeter a compra à assembleia-geral (art. 256, § 1º)` TRUE TRUE FALSE
#ASSERT (NOT `os administradores da compradora respondem por não submeter a compra à assembleia-geral (art. 256, § 1º)` FALSE FALSE FALSE)

-- Art. 256, § 2º: o dissidente pode retirar-se se o preço passa de uma vez e meia o maior dos três valores, observado o art. 137, II.
#ASSERT `o acionista dissidente pode retirar-se da compradora (art. 256, § 2º)` 151 100 80 60 10 TRUE FALSE
#ASSERT (NOT `o acionista dissidente pode retirar-se da compradora (art. 256, § 2º)` 151 100 80 60 10 TRUE TRUE)
#ASSERT (NOT `o acionista dissidente pode retirar-se da compradora (art. 256, § 2º)` 151 100 80 60 10 FALSE FALSE)
#ASSERT (NOT `o acionista dissidente pode retirar-se da compradora (art. 256, § 2º)` 150 100 80 60 10 TRUE FALSE)
