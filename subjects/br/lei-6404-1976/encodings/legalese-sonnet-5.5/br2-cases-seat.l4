IMPORT prelude
IMPORT `br-core`
IMPORT `br2-cap5-debentures-caracteristicas`
IMPORT `br2-cap7-constituicao-requisitos`
IMPORT `br2-cap9-livros`
IMPORT `br2-seat`

-- br2-cases-seat.l4 -- the seat layer's cases: the same questions a shareholder asks in br2-seat.l4,
-- asked with concrete facts. Every expected value was decided by reading the article before running,
-- and is written beside the assertion. A failing assertion would be a finding, not an expected value to
-- edit. A case that expects NOTHING asserts that the chapter does not decide the question.

§ `Casos do assento do acionista (Capítulos V a IX)`

§§ `Debêntures: o que a emissão significa para mim`
-- Art. 57, § 1º: convertible and the right not removed
#ASSERT `Tenho preferência para subscrever debêntures conversíveis em ações da minha companhia` TRUE FALSE
-- removed under arts. 171 and 172
#ASSERT NOT (`Tenho preferência para subscrever debêntures conversíveis em ações da minha companhia` TRUE TRUE)
-- not a convertible issue: the paragraph does not give it
#ASSERT NOT (`Tenho preferência para subscrever debêntures conversíveis em ações da minha companhia` FALSE FALSE)
-- changing the company object while conversion is open
#ASSERT `A alteração do estatuto que vou votar depende de aprovação prévia dos debenturistas` TRUE TRUE FALSE FALSE FALSE
-- conversion no longer open
#ASSERT NOT (`A alteração do estatuto que vou votar depende de aprovação prévia dos debenturistas` FALSE TRUE FALSE FALSE FALSE)
-- creating preferred shares to the prejudice of the convertible ones
#ASSERT `A alteração do estatuto que vou votar depende de aprovação prévia dos debenturistas` TRUE FALSE TRUE FALSE TRUE
-- creating preferred shares without prejudice
#ASSERT NOT (`A alteração do estatuto que vou votar depende de aprovação prévia dos debenturistas` TRUE FALSE TRUE FALSE FALSE)
-- modifying existing advantages to their prejudice
#ASSERT `A alteração do estatuto que vou votar depende de aprovação prévia dos debenturistas` TRUE FALSE FALSE TRUE TRUE
-- prejudice alone, with no creation or modification
#ASSERT NOT (`A alteração do estatuto que vou votar depende de aprovação prévia dos debenturistas` TRUE FALSE FALSE FALSE TRUE)
-- an unsecured creditor is paid before the shareholder
#ASSERT `Na liquidação da companhia, o outro credor é pago antes de mim, acionista` `credor quirografário (art. 58, § 4º)`
-- subordinated debenture holders are paid before the shareholders
#ASSERT `Na liquidação da companhia, o outro credor é pago antes de mim, acionista` `debenturista de debênture subordinada (art. 58, § 4º)`
-- another shareholder is in the same position, not ahead
#ASSERT NOT (`Na liquidação da companhia, o outro credor é pago antes de mim, acionista` `acionista no ativo remanescente (art. 58, § 4º)`)

§§ `Debêntures: quem decide e como`
-- art. 59, § 2º: open company, authorised capital, estatuto authorises, everything specified
#ASSERT `O conselho de administração da minha companhia pode decidir a emissão de debêntures` `companhia aberta` TRUE TRUE TRUE FALSE TRUE TRUE TRUE TRUE
-- convertible issue the estatuto does not authorise the board to decide
#ASSERT NOT (`O conselho de administração da minha companhia pode decidir a emissão de debêntures` `companhia aberta` TRUE TRUE TRUE FALSE FALSE TRUE TRUE TRUE)
-- art. 59, § 1º: non-convertible issue, estatuto silent
#ASSERT `O conselho de administração da minha companhia pode decidir a emissão de debêntures` `companhia aberta` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE
-- non-convertible issue, but the estatuto provides otherwise
#ASSERT NOT (`O conselho de administração da minha companhia pode decidir a emissão de debêntures` `companhia aberta` TRUE TRUE FALSE TRUE FALSE FALSE FALSE FALSE)
-- a company with no board of directors
#ASSERT NOT (`O conselho de administração da minha companhia pode decidir a emissão de debêntures` `companhia fechada` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
-- non-convertible issue, estatuto silent
#ASSERT `A diretoria da minha companhia pode decidir a emissão de debêntures` FALSE FALSE
-- a convertible issue is not for the diretoria alone
#ASSERT NOT (`A diretoria da minha companhia pode decidir a emissão de debêntures` TRUE FALSE)
-- estatuto provides otherwise
#ASSERT NOT (`A diretoria da minha companhia pode decidir a emissão de debêntures` FALSE TRUE)
-- issue without the requirements, with loss
#ASSERT `Os administradores respondem pelas perdas que a emissão irregular de debêntures me causou` TRUE TRUE
-- no loss
#ASSERT NOT (`Os administradores respondem pelas perdas que a emissão irregular de debêntures me causou` TRUE FALSE)
-- the requirements were met
#ASSERT NOT (`Os administradores respondem pelas perdas que a emissão irregular de debêntures me causou` FALSE TRUE)
-- exactly 10% of the debentures outstanding
#ASSERT (`Sendo também debenturista, posso convocar a assembleia dos debenturistas` 1000 100) EQUALS JUST TRUE
-- just under 10%
#ASSERT (`Sendo também debenturista, posso convocar a assembleia dos debenturistas` 1000 99) EQUALS JUST FALSE
-- one vote per debenture
#ASSERT (`Sendo também debenturista, quantos votos tenho na assembleia dos debenturistas` FALSE 50) EQUALS JUST 50
-- the unbundling resolution counts by economic right, not by debenture: this chapter gives no number
#ASSERT (`Sendo também debenturista, quantos votos tenho na assembleia dos debenturistas` TRUE 50) EQUALS NOTHING
-- half of the debentures outstanding is the legal floor and is reached
#ASSERT (`Sendo também debenturista, a modificação das condições das debêntures foi aprovada` 500 1000 500) EQUALS JUST TRUE
-- one short of the majority the escritura requires
#ASSERT (`Sendo também debenturista, a modificação das condições das debêntures foi aprovada` 500 1000 499) EQUALS JUST FALSE
-- an escritura majority below the floor of half is not a majority the Law recognises
#ASSERT (`Sendo também debenturista, a modificação das condições das debêntures foi aprovada` 400 1000 1000) EQUALS NOTHING

§§ `Bônus de subscrição`
-- authorised capital and within the limit
#ASSERT `Minha companhia pode emitir bônus de subscrição` TRUE TRUE
-- beyond the authorised limit
#ASSERT NOT (`Minha companhia pode emitir bônus de subscrição` TRUE FALSE)
-- no authorised capital
#ASSERT NOT (`Minha companhia pode emitir bônus de subscrição` FALSE TRUE)
-- conditions observed, title presented, price paid
#ASSERT `Sendo titular de bônus de subscrição, posso subscrever as ações` TRUE TRUE TRUE
-- price not paid
#ASSERT NOT (`Sendo titular de bônus de subscrição, posso subscrever as ações` TRUE TRUE FALSE)
-- title not presented
#ASSERT NOT (`Sendo titular de bônus de subscrição, posso subscrever as ações` TRUE FALSE TRUE)
-- the estatuto gives the board the power
#ASSERT `O conselho de administração da minha companhia pode decidir a emissão de bônus de subscrição` TRUE
-- the general meeting decides
#ASSERT NOT (`O conselho de administração da minha companhia pode decidir a emissão de bônus de subscrição` FALSE)
-- right not removed
#ASSERT `Tenho preferência para subscrever os bônus de subscrição da minha companhia` FALSE
-- removed under arts. 171 and 172
#ASSERT NOT (`Tenho preferência para subscrever os bônus de subscrição da minha companhia` TRUE)

§§ `Constituição da companhia`
-- exactly 10% of the issue price
#ASSERT `A entrada que paguei na subscrição em dinheiro é suficiente` FALSE 100 1000
-- just under 10%
#ASSERT NOT (`A entrada que paguei na subscrição em dinheiro é suficiente` FALSE 99 1000)
-- another law sets a larger share, so inciso II does not apply
#ASSERT `A entrada que paguei na subscrição em dinheiro é suficiente` TRUE 0 1000
-- deposited on day 5 by the founder, in the subscriber's name
#ASSERT `O depósito do que paguei foi feito como a lei exige` (YearMonthDay 2026 3 10) (YearMonthDay 2026 3 15) TRUE TRUE
-- day 6 is late
#ASSERT NOT (`O depósito do que paguei foi feito como a lei exige` (YearMonthDay 2026 3 10) (YearMonthDay 2026 3 16) TRUE TRUE)
-- not deposited by the founder
#ASSERT NOT (`O depósito do que paguei foi feito como a lei exige` (YearMonthDay 2026 3 10) (YearMonthDay 2026 3 15) FALSE TRUE)
-- not formed, and day after the end of the 6 months (10 September)
#ASSERT `Posso exigir do banco a devolução direta do que depositei se a companhia não se constituiu` (YearMonthDay 2026 3 10) FALSE (YearMonthDay 2026 1 1) (YearMonthDay 2026 9 11)
-- the last day of the 6 months is still in time
#ASSERT NOT (`Posso exigir do banco a devolução direta do que depositei se a companhia não se constituiu` (YearMonthDay 2026 3 10) FALSE (YearMonthDay 2026 1 1) (YearMonthDay 2026 9 10))
-- formed within the 6 months
#ASSERT NOT (`Posso exigir do banco a devolução direta do que depositei se a companhia não se constituiu` (YearMonthDay 2026 3 10) TRUE (YearMonthDay 2026 6 1) (YearMonthDay 2026 9 20))
-- formed, but only after the 6 months
#ASSERT `Posso exigir do banco a devolução direta do que depositei se a companhia não se constituiu` (YearMonthDay 2026 3 10) TRUE (YearMonthDay 2026 10 1) (YearMonthDay 2026 10 2)
-- public subscription: CVM registration and a financial institution
#ASSERT `Sendo fundador, a subscrição pública que vou fazer cumpre o que a lei exige` TRUE TRUE
-- no financial institution intermediates it
#ASSERT NOT (`Sendo fundador, a subscrição pública que vou fazer cumpre o que a lei exige` TRUE FALSE)
-- the issue was not registered beforehand
#ASSERT NOT (`Sendo fundador, a subscrição pública que vou fazer cumpre o que a lei exige` FALSE TRUE)
-- the draft meets the three requirements
#ASSERT `Sendo fundador, o projeto de estatuto que vou apresentar cumpre o que a lei exige` TRUE TRUE TRUE
-- the draft lacks the rules that will govern the company
#ASSERT NOT (`Sendo fundador, o projeto de estatuto que vou apresentar cumpre o que a lei exige` TRUE TRUE FALSE)
-- all the unconditional items; no goods, no special advantages, no government authorisation, no preliminary meeting
#ASSERT `Sendo fundador, o prospecto que vou publicar contém o que a lei exige` TRUE TRUE FALSE FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE TRUE TRUE TRUE FALSE FALSE TRUE TRUE
-- part of the capital is formed with goods but the prospectus does not describe them
#ASSERT NOT (`Sendo fundador, o prospecto que vou publicar contém o que a lei exige` TRUE TRUE TRUE FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE TRUE TRUE TRUE FALSE FALSE TRUE TRUE)
-- goods in the capital, and described
#ASSERT `Sendo fundador, o prospecto que vou publicar contém o que a lei exige` TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE TRUE TRUE TRUE FALSE FALSE TRUE TRUE
-- a government authorisation is needed but not mentioned
#ASSERT NOT (`Sendo fundador, o prospecto que vou publicar contém o que a lei exige` TRUE TRUE FALSE FALSE TRUE TRUE TRUE FALSE FALSE TRUE FALSE TRUE TRUE TRUE FALSE FALSE TRUE TRUE)
-- a government authorisation is needed and mentioned
#ASSERT `Sendo fundador, o prospecto que vou publicar contém o que a lei exige` TRUE TRUE FALSE FALSE TRUE TRUE TRUE FALSE FALSE TRUE TRUE TRUE TRUE TRUE FALSE FALSE TRUE TRUE
-- the solution for oversubscription is not stated
#ASSERT NOT (`Sendo fundador, o prospecto que vou publicar contém o que a lei exige` TRUE TRUE FALSE FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE TRUE FALSE TRUE FALSE FALSE TRUE TRUE)
-- natural person, paid, data stated, list signed and authenticated
#ASSERT `Minha subscrição em dinheiro cumpre o que a lei exige` `lista ou boletim individual assinado e autenticado (art. 85)` TRUE FALSE TRUE FALSE TRUE FALSE FALSE TRUE TRUE FALSE
-- the entrada was not paid
#ASSERT NOT (`Minha subscrição em dinheiro cumpre o que a lei exige` `lista ou boletim individual assinado e autenticado (art. 85)` FALSE FALSE TRUE FALSE TRUE FALSE FALSE TRUE TRUE FALSE)
-- legal entity with firm, nationality and seat stated
#ASSERT `Minha subscrição em dinheiro cumpre o que a lei exige` `lista ou boletim individual assinado e autenticado (art. 85)` TRUE TRUE FALSE TRUE TRUE FALSE FALSE TRUE TRUE FALSE
-- legal entity, but only the natural person data are stated
#ASSERT NOT (`Minha subscrição em dinheiro cumpre o que a lei exige` `lista ou boletim individual assinado e autenticado (art. 85)` TRUE TRUE TRUE FALSE TRUE FALSE FALSE TRUE TRUE FALSE)
-- more than one species or class, and none is stated
#ASSERT NOT (`Minha subscrição em dinheiro cumpre o que a lei exige` `lista ou boletim individual assinado e autenticado (art. 85)` TRUE FALSE TRUE FALSE TRUE TRUE FALSE TRUE TRUE FALSE)
-- by letter that followed the conditions of the prospectus
#ASSERT `Minha subscrição em dinheiro cumpre o que a lei exige` `carta à instituição (art. 85, § 1º)` TRUE FALSE TRUE FALSE TRUE FALSE FALSE TRUE FALSE TRUE
-- by letter that did not follow the conditions
#ASSERT NOT (`Minha subscrição em dinheiro cumpre o que a lei exige` `carta à instituição (art. 85, § 1º)` TRUE FALSE TRUE FALSE TRUE FALSE FALSE TRUE FALSE FALSE)
-- public offer settled in a market system: no signature on a list needed
#ASSERT `Minha subscrição em dinheiro cumpre o que a lei exige` `oferta pública liquidada em sistema de entidade administradora de mercados organizados (art. 85, § 2º)` TRUE FALSE TRUE FALSE TRUE FALSE FALSE TRUE FALSE FALSE
-- even there the entrada must be paid
#ASSERT NOT (`Minha subscrição em dinheiro cumpre o que a lei exige` `oferta pública liquidada em sistema de entidade administradora de mercados organizados (art. 85, § 2º)` FALSE FALSE TRUE FALSE TRUE FALSE FALSE TRUE FALSE FALSE)
-- subscription closed and all the capital subscribed
#ASSERT `Sendo fundador, devo convocar a assembleia-geral de constituição` TRUE TRUE
-- part of the capital is not subscribed
#ASSERT NOT (`Sendo fundador, devo convocar a assembleia-geral de constituição` TRUE FALSE)
-- half of the capital is enough on first call
#ASSERT `A assembleia de constituição pode instalar-se com os subscritores presentes` `primeira convocação (art. 87)` 1000 500
-- less than half on first call
#ASSERT NOT (`A assembleia de constituição pode instalar-se com os subscritores presentes` `primeira convocação (art. 87)` 1000 499)
-- any number on second call
#ASSERT `A assembleia de constituição pode instalar-se com os subscritores presentes` `segunda convocação (art. 87)` 1000 0
-- each share carries one vote
#ASSERT (`Quantos votos tenho na assembleia de constituição` 120) EQUALS 120
-- the majority may not change the draft estatuto
#ASSERT NOT (`A maioria dos subscritores pode alterar o projeto de estatuto contra o meu voto`)
-- opposition of exactly half is not more than half
#ASSERT `A companhia pode ser declarada constituída mesmo que eu me oponha` TRUE 1000 500
-- more than half oppose
#ASSERT NOT (`A companhia pode ser declarada constituída mesmo que eu me oponha` TRUE 1000 501)
-- formalities not observed
#ASSERT NOT (`A companhia pode ser declarada constituída mesmo que eu me oponha` FALSE 1000 0)
-- private subscription
#ASSERT (`Sou considerado fundador por ter subscrito o capital` TRUE) EQUALS JUST TRUE
-- the article says nothing of a public subscription
#ASSERT (`Sou considerado fundador por ter subscrito o capital` FALSE) EQUALS NOTHING
-- arts. 86 and 87 observed, draft and lists delivered
#ASSERT `Na constituição por subscrição particular por assembleia, cumpri o que a lei exige dos subscritores` TRUE TRUE TRUE
-- arts. 86 and 87 not observed
#ASSERT NOT (`Na constituição por subscrição particular por assembleia, cumpri o que a lei exige dos subscritores` FALSE TRUE TRUE)
-- the draft estatuto was not signed in duplicate by all the subscribers
#ASSERT NOT (`Na constituição por subscrição particular por assembleia, cumpri o que a lei exige dos subscritores` TRUE FALSE TRUE)
-- the lists of subscription were not delivered
#ASSERT NOT (`Na constituição por subscrição particular por assembleia, cumpri o que a lei exige dos subscritores` TRUE TRUE FALSE)
-- attorney with special powers
#ASSERT `Posso fazer-me representar por procurador na assembleia ou na escritura de constituição` TRUE
-- attorney without special powers
#ASSERT NOT (`Posso fazer-me representar por procurador na assembleia ou na escritura de constituição` FALSE)
-- public subscription, omission, loss caused by it, within the founders' duties
#ASSERT (`Os fundadores respondem pelo prejuízo que a inobservância da lei na constituição por subscrição pública me causou` TRUE TRUE TRUE TRUE) EQUALS JUST TRUE
-- not a public subscription
#ASSERT (`Os fundadores respondem pelo prejuízo que a inobservância da lei na constituição por subscrição pública me causou` FALSE TRUE TRUE TRUE) EQUALS JUST FALSE
-- same four conditions, institution
#ASSERT (`A instituição financeira que interveio na subscrição pública responde pelo prejuízo que a inobservância da lei me causou` TRUE TRUE TRUE TRUE) EQUALS JUST TRUE
-- the loss did not come from the omission
#ASSERT (`A instituição financeira que interveio na subscrição pública responde pelo prejuízo que a inobservância da lei me causou` TRUE TRUE FALSE TRUE) EQUALS JUST FALSE
-- act before the formation, with fault, causing loss
#ASSERT `Os fundadores respondem solidariamente pelo prejuízo de atos anteriores à constituição` TRUE TRUE TRUE
-- without fault or intent
#ASSERT NOT (`Os fundadores respondem solidariamente pelo prejuízo de atos anteriores à constituição` TRUE FALSE TRUE)
-- all the documents, books and papers were handed over
#ASSERT `Sendo fundador, cumpri o dever de entregar os documentos da constituição aos primeiros administradores` TRUE
-- not handed over
#ASSERT NOT (`Sendo fundador, cumpri o dever de entregar os documentos da constituição aos primeiros administradores` FALSE)

§§ `Formalidades complementares`
-- filed and published
#ASSERT `A minha companhia já pode funcionar` TRUE TRUE
-- not yet published
#ASSERT NOT (`A minha companhia já pode funcionar` TRUE FALSE)
-- filing refused
#ASSERT `Os primeiros administradores devem convocar imediatamente a assembleia para sanar a falta que impediu o arquivamento` TRUE
-- filing not refused
#ASSERT NOT (`Os primeiros administradores devem convocar imediatamente a assembleia para sanar a falta que impediu o arquivamento` FALSE)
-- half of the capital
#ASSERT `A assembleia que sana a falta decidiu como a lei exige` TRUE 1000 500
-- less than half of the capital
#ASSERT NOT (`A assembleia que sana a falta decidiu como a lei exige` TRUE 1000 499)
-- the meeting did not follow art. 87
#ASSERT NOT (`A assembleia que sana a falta decidiu como a lei exige` FALSE 1000 1000)
-- defect is in the estatuto
#ASSERT `A mesma assembleia deve deliberar sobre a responsabilidade civil dos fundadores` TRUE
-- defect is not in the estatuto
#ASSERT NOT (`A mesma assembleia deve deliberar sobre a responsabilidade civil dos fundadores` FALSE)
-- delay that caused loss
#ASSERT `Os primeiros administradores respondem solidariamente perante a companhia pelo prejuízo da demora nas formalidades` TRUE TRUE
-- no loss
#ASSERT NOT (`Os primeiros administradores respondem solidariamente perante a companhia pelo prejuízo da demora nas formalidades` TRUE FALSE)
-- general meeting resolved that the company answers
#ASSERT (`A companhia responde pelos atos que os primeiros administradores praticaram antes das formalidades` TRUE TRUE) EQUALS JUST TRUE
-- no such resolution
#ASSERT (`A companhia responde pelos atos que os primeiros administradores praticaram antes das formalidades` TRUE FALSE) EQUALS JUST FALSE
-- act after the formalities: the paragraph does not speak of it
#ASSERT (`A companhia responde pelos atos que os primeiros administradores praticaram antes das formalidades` FALSE FALSE) EQUALS NOTHING

§§ `Livros sociais`
-- book of shares, for the defence of rights
#ASSERT (`Posso obter da companhia certidão dos assentamentos de um livro social` `Registro de Ações Nominativas (art. 100, I)` TRUE FALSE FALSE FALSE) EQUALS JUST TRUE
-- book of transfers, for the market
#ASSERT (`Posso obter da companhia certidão dos assentamentos de um livro social` `Transferência de Ações Nominativas (art. 100, II)` FALSE FALSE FALSE TRUE) EQUALS JUST TRUE
-- no purpose of the kind the paragraph names
#ASSERT (`Posso obter da companhia certidão dos assentamentos de um livro social` `Registro de Ações Nominativas (art. 100, I)` FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
-- the paragraph speaks only of the books of shares and beneficiary parts
#ASSERT (`Posso obter da companhia certidão dos assentamentos de um livro social` `Atas das Assembleias Gerais (art. 100, IV)` TRUE TRUE TRUE TRUE) EQUALS NOTHING
-- the company may charge the cost of the service
#ASSERT `A companhia pode me cobrar o custo do serviço de certidão`
-- refusal of the certificate
#ASSERT `Posso recorrer à Comissão de Valores Mobiliários se a companhia recusar a certidão` TRUE
-- no refusal
#ASSERT NOT (`Posso recorrer à Comissão de Valores Mobiliários se a companhia recusar a certidão` FALSE)
-- open company, books I to V, CVM rules observed
#ASSERT (`A companhia pode substituir um livro social por registros eletrônicos` `Registro de Ações Nominativas (art. 100, I)` `companhia aberta` TRUE FALSE) EQUALS JUST TRUE
-- closed company, regulation observed
#ASSERT (`A companhia pode substituir um livro social por registros eletrônicos` `Atas das Assembleias Gerais (art. 100, IV)` `companhia fechada` FALSE TRUE) EQUALS JUST TRUE
-- open company, CVM rules not observed
#ASSERT (`A companhia pode substituir um livro social por registros eletrônicos` `Registro de Ações Nominativas (art. 100, I)` `companhia aberta` FALSE FALSE) EQUALS JUST FALSE
-- the paragraphs speak only of books I to V
#ASSERT (`A companhia pode substituir um livro social por registros eletrônicos` `Atas das Reuniões de Diretoria (art. 100, VI)` `companhia aberta` TRUE TRUE) EQUALS NOTHING
-- no issuing agent and the shares are not book-entry
#ASSERT (`Cabe à companhia verificar a regularidade da transferência das minhas ações` FALSE FALSE) EQUALS JUST TRUE
-- an issuing agent does it
#ASSERT (`Cabe à companhia verificar a regularidade da transferência das minhas ações` TRUE FALSE) EQUALS JUST FALSE
-- the depositary institution does it
#ASSERT (`Cabe à companhia verificar a regularidade da transferência das minhas ações` FALSE TRUE) EQUALS JUST FALSE
-- doubt about an entry, not about the substance of the right
#ASSERT (`O juiz dos registros públicos resolve a minha dúvida sobre um lançamento nos livros` TRUE TRUE FALSE) EQUALS JUST TRUE
-- substance of the right
#ASSERT (`O juiz dos registros públicos resolve a minha dúvida sobre um lançamento nos livros` TRUE TRUE TRUE) EQUALS JUST FALSE
-- doubt not between the shareholder and the company, its agent or the depositary
#ASSERT (`O juiz dos registros públicos resolve a minha dúvida sobre um lançamento nos livros` FALSE TRUE FALSE) EQUALS NOTHING
-- defect in the book of shares, with loss
#ASSERT (`A companhia responde pelo prejuízo que um vício no livro social me causou` `Registro de Ações Nominativas (art. 100, I)` TRUE TRUE) EQUALS JUST TRUE
-- no loss
#ASSERT (`A companhia responde pelo prejuízo que um vício no livro social me causou` `Registro de Ações Nominativas (art. 100, I)` TRUE FALSE) EQUALS JUST FALSE
-- art. 104 names only the books of incisos I to III
#ASSERT (`A companhia responde pelo prejuízo que um vício no livro social me causou` `Presença dos Acionistas (art. 100, V)` TRUE TRUE) EQUALS NOTHING
-- a day over the time the CVM fixed, culpable, with loss
#ASSERT `A companhia responde pelo prejuízo que o atraso culposo nos meus atos de transferência me causou` 10 11 TRUE TRUE
-- taking exactly the time the CVM fixed is not exceeding it
#ASSERT NOT (`A companhia responde pelo prejuízo que o atraso culposo nos meus atos de transferência me causou` 10 10 TRUE TRUE)
-- exactly 5% of the capital and acts violating the law pointed out
#ASSERT `Posso pedir ao juiz que ordene a exibição dos livros da companhia` 1000 50 TRUE FALSE
-- just under 5%
#ASSERT NOT (`Posso pedir ao juiz que ordene a exibição dos livros da companhia` 1000 49 TRUE FALSE)
-- 5% and a well-founded suspicion of serious irregularities
#ASSERT `Posso pedir ao juiz que ordene a exibição dos livros da companhia` 1000 50 FALSE TRUE
-- 5% but neither ground
#ASSERT NOT (`Posso pedir ao juiz que ordene a exibição dos livros da companhia` 1000 50 FALSE FALSE)
