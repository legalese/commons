IMPORT prelude
IMPORT `br-core`
IMPORT `br6-cap20e-oferta-publica-de-controle`

-- br6-tests-cap20e.l4 -- tests of br6-cap20e-oferta-publica-de-controle.l4 (Arts. 257 to 263).
-- Expected values come from the text of lei-6404-1976.pt.txt (a converter's plain-text rendering, not the official text), never from the output of the code.

GIVETH A `Indicações do instrumento da oferta de compra (art. 258)`
`[teste] instrumento com todas as indicações` MEANS `Indicações do instrumento da oferta de compra (art. 258)` WITH
    `indica o número mínimo de ações que o ofertante se propõe a adquirir e, se for o caso, o número máximo` IS TRUE
    `indica o preço e as condições de pagamento` IS TRUE
    `indica a subordinação da oferta ao número mínimo de aceitantes e a forma de rateio entre os aceitantes` IS TRUE
    `indica o procedimento para os acionistas aceitantes manifestarem a aceitação e efetivarem a transferência` IS TRUE
    `indica o prazo de validade da oferta` IS TRUE
    `traz informações sobre o ofertante` IS TRUE

GIVETH A `Indicações do instrumento da oferta de compra (art. 258)`
`[teste] instrumento sem as informações sobre o ofertante` MEANS `Indicações do instrumento da oferta de compra (art. 258)` WITH
    `indica o número mínimo de ações que o ofertante se propõe a adquirir e, se for o caso, o número máximo` IS TRUE
    `indica o preço e as condições de pagamento` IS TRUE
    `indica a subordinação da oferta ao número mínimo de aceitantes e a forma de rateio entre os aceitantes` IS TRUE
    `indica o procedimento para os acionistas aceitantes manifestarem a aceitação e efetivarem a transferência` IS TRUE
    `indica o prazo de validade da oferta` IS TRUE
    `traz informações sobre o ofertante` IS FALSE

GIVETH A `Indicações do instrumento da oferta de compra (art. 258)`
`[teste] instrumento sem a subordinação e o rateio` MEANS `Indicações do instrumento da oferta de compra (art. 258)` WITH
    `indica o número mínimo de ações que o ofertante se propõe a adquirir e, se for o caso, o número máximo` IS TRUE
    `indica o preço e as condições de pagamento` IS TRUE
    `indica a subordinação da oferta ao número mínimo de aceitantes e a forma de rateio entre os aceitantes` IS FALSE
    `indica o procedimento para os acionistas aceitantes manifestarem a aceitação e efetivarem a transferência` IS TRUE
    `indica o prazo de validade da oferta` IS TRUE
    `traz informações sobre o ofertante` IS TRUE



-- Art. 257: instituição financeira garantidora; registro prévio se há permuta; objeto suficiente para o controle e oferta irrevogável.
#ASSERT (`a oferta pública para aquisição de controle pode ser feita (art. 257)` `companhia aberta` TRUE) EQUALS (JUST TRUE)
#ASSERT (`a oferta pública para aquisição de controle pode ser feita (art. 257)` `companhia aberta` FALSE) EQUALS (JUST FALSE)
#ASSERT (`a oferta pública para aquisição de controle pode ser feita (art. 257)` `companhia fechada` TRUE) EQUALS NOTHING
#ASSERT `a oferta com permuta foi precedida de registro na Comissão de Valores Mobiliários (art. 257, § 1º)` TRUE TRUE
#ASSERT (NOT `a oferta com permuta foi precedida de registro na Comissão de Valores Mobiliários (art. 257, § 1º)` TRUE FALSE)
#ASSERT `a oferta com permuta foi precedida de registro na Comissão de Valores Mobiliários (art. 257, § 1º)` FALSE FALSE
#ASSERT (`o número mínimo de ações com direito a voto que a oferta deve ter por objeto (art. 257, §§ 2º e 3º)` 100 30 TRUE) EQUALS 70
#ASSERT (`o número mínimo de ações com direito a voto que a oferta deve ter por objeto (art. 257, §§ 2º e 3º)` 100 30 FALSE) EQUALS 100
#ASSERT (`o número mínimo de ações com direito a voto que a oferta deve ter por objeto (art. 257, §§ 2º e 3º)` 100 0 TRUE) EQUALS 100
#ASSERT (`o número mínimo de ações com direito a voto que a oferta deve ter por objeto (art. 257, §§ 2º e 3º)` 100 120 TRUE) EQUALS 0
#ASSERT `a oferta tem o objeto e a irrevogabilidade que o art. 257, § 2º exige` 70 100 30 TRUE TRUE
#ASSERT (NOT `a oferta tem o objeto e a irrevogabilidade que o art. 257, § 2º exige` 69 100 30 TRUE TRUE)
#ASSERT `a oferta tem o objeto e a irrevogabilidade que o art. 257, § 2º exige` 100 100 30 FALSE TRUE
#ASSERT (NOT `a oferta tem o objeto e a irrevogabilidade que o art. 257, § 2º exige` 99 100 30 FALSE TRUE)
#ASSERT (NOT `a oferta tem o objeto e a irrevogabilidade que o art. 257, § 2º exige` 100 100 0 FALSE FALSE)

-- Art. 258: o instrumento da oferta de compra (validade não inferior a 20 dias) e a comunicação à CVM em 24 horas.
#ASSERT `o instrumento da oferta de compra contém as indicações do art. 258` `[teste] instrumento com todas as indicações` 20
#ASSERT `o instrumento da oferta de compra contém as indicações do art. 258` `[teste] instrumento com todas as indicações` 30
#ASSERT (NOT `o instrumento da oferta de compra contém as indicações do art. 258` `[teste] instrumento com todas as indicações` 19)
#ASSERT (NOT `o instrumento da oferta de compra contém as indicações do art. 258` `[teste] instrumento sem as informações sobre o ofertante` 20)
#ASSERT (NOT `o instrumento da oferta de compra contém as indicações do art. 258` `[teste] instrumento sem a subordinação e o rateio` 20)
#ASSERT `o instrumento da oferta de compra foi firmado e publicado na forma do art. 258` TRUE TRUE
#ASSERT (NOT `o instrumento da oferta de compra foi firmado e publicado na forma do art. 258` TRUE FALSE)
#ASSERT (NOT `o instrumento da oferta de compra foi firmado e publicado na forma do art. 258` FALSE TRUE)
#ASSERT `a oferta foi comunicada à Comissão de Valores Mobiliários dentro de vinte e quatro horas da primeira publicação (art. 258, parágrafo único)` 0
#ASSERT `a oferta foi comunicada à Comissão de Valores Mobiliários dentro de vinte e quatro horas da primeira publicação (art. 258, parágrafo único)` 24
#ASSERT (NOT `a oferta foi comunicada à Comissão de Valores Mobiliários dentro de vinte e quatro horas da primeira publicação (art. 258, parágrafo único)` 25)

-- Art. 259: o projeto de instrumento da oferta de permuta.
#ASSERT `o projeto de instrumento de oferta de permuta cumpre o art. 259` `[teste] instrumento com todas as indicações` 20 TRUE TRUE TRUE
#ASSERT (NOT `o projeto de instrumento de oferta de permuta cumpre o art. 259` `[teste] instrumento com todas as indicações` 20 FALSE TRUE TRUE)
#ASSERT (NOT `o projeto de instrumento de oferta de permuta cumpre o art. 259` `[teste] instrumento com todas as indicações` 20 TRUE FALSE TRUE)
#ASSERT (NOT `o projeto de instrumento de oferta de permuta cumpre o art. 259` `[teste] instrumento com todas as indicações` 20 TRUE TRUE FALSE)
#ASSERT (NOT `o projeto de instrumento de oferta de permuta cumpre o art. 259` `[teste] instrumento sem as informações sobre o ofertante` 20 TRUE TRUE TRUE)
#ASSERT (NOT `o projeto de instrumento de oferta de permuta cumpre o art. 259` `[teste] instrumento com todas as indicações` 19 TRUE TRUE TRUE)

-- Art. 260: sigilo até a publicação da oferta.
#ASSERT (`a pessoa deve manter sigilo sobre a oferta projetada (art. 260)` `o ofertante (art. 260)` FALSE) EQUALS (JUST TRUE)
#ASSERT (`a pessoa deve manter sigilo sobre a oferta projetada (art. 260)` `o ofertante (art. 260)` TRUE) EQUALS (JUST FALSE)
#ASSERT (`a pessoa deve manter sigilo sobre a oferta projetada (art. 260)` `a instituição financeira intermediária (art. 260)` FALSE) EQUALS (JUST TRUE)
#ASSERT (`a pessoa deve manter sigilo sobre a oferta projetada (art. 260)` `a instituição financeira intermediária (art. 260)` TRUE) EQUALS (JUST FALSE)
#ASSERT (`a pessoa deve manter sigilo sobre a oferta projetada (art. 260)` `a Comissão de Valores Mobiliários na oferta pública (art. 260)` FALSE) EQUALS (JUST TRUE)
#ASSERT (`a pessoa deve manter sigilo sobre a oferta projetada (art. 260)` `a Comissão de Valores Mobiliários na oferta pública (art. 260)` TRUE) EQUALS (JUST FALSE)
#ASSERT (`a pessoa deve manter sigilo sobre a oferta projetada (art. 260)` `outra pessoa (art. 260)` FALSE) EQUALS NOTHING
#ASSERT (`a quantia pela qual o infrator responde (art. 260)` TRUE 500) EQUALS (JUST 500)
#ASSERT (`a quantia pela qual o infrator responde (art. 260)` FALSE 500) EQUALS NOTHING

-- Art. 261: aceitação; melhoria da oferta (uma vez, 5% ou mais, até 10 dias antes do término: término em 20 de março de 2026, último dia para melhorar 10 de março); resultado; rateio.
#ASSERT `a aceitação da oferta foi feita na forma do art. 261` TRUE TRUE
#ASSERT (NOT `a aceitação da oferta foi feita na forma do art. 261` TRUE FALSE)
#ASSERT (NOT `a aceitação da oferta foi feita na forma do art. 261` FALSE TRUE)
#ASSERT `a melhoria das condições da oferta é admitida (art. 261, § 1º)` FALSE 100 105 FALSE (YearMonthDay 2026 3 10) (YearMonthDay 2026 3 20)
#ASSERT (NOT `a melhoria das condições da oferta é admitida (art. 261, § 1º)` FALSE 100 105 FALSE (YearMonthDay 2026 3 11) (YearMonthDay 2026 3 20))
#ASSERT (NOT `a melhoria das condições da oferta é admitida (art. 261, § 1º)` FALSE 100 104 FALSE (YearMonthDay 2026 3 10) (YearMonthDay 2026 3 20))
#ASSERT `a melhoria das condições da oferta é admitida (art. 261, § 1º)` FALSE 100 104 TRUE (YearMonthDay 2026 3 10) (YearMonthDay 2026 3 20)
#ASSERT (NOT `a melhoria das condições da oferta é admitida (art. 261, § 1º)` TRUE 100 110 FALSE (YearMonthDay 2026 3 10) (YearMonthDay 2026 3 20))
#ASSERT `as novas condições se estendem ao acionista que já aceitou a oferta (art. 261, § 1º)` TRUE TRUE
#ASSERT (NOT `as novas condições se estendem ao acionista que já aceitou a oferta (art. 261, § 1º)` TRUE FALSE)
#ASSERT (NOT `as novas condições se estendem ao acionista que já aceitou a oferta (art. 261, § 1º)` FALSE TRUE)
#ASSERT `a instituição financeira intermediária comunicou o resultado como o art. 261, § 2º exige` TRUE TRUE TRUE
#ASSERT (NOT `a instituição financeira intermediária comunicou o resultado como o art. 261, § 2º exige` TRUE TRUE FALSE)
#ASSERT (NOT `a instituição financeira intermediária comunicou o resultado como o art. 261, § 2º exige` TRUE FALSE TRUE)
#ASSERT `a instituição financeira intermediária comunicou o resultado como o art. 261, § 2º exige` FALSE FALSE FALSE
#ASSERT `o rateio é obrigatório (art. 261, § 3º)` 101 100
#ASSERT (NOT `o rateio é obrigatório (art. 261, § 3º)` 100 100)

-- Art. 262: oferta concorrente (primeira oferta até 20 de março de 2026, concorrente até 25 de março de 2026).
#ASSERT `a oferta concorrente é admitida (art. 262)` TRUE
#ASSERT (NOT `a oferta concorrente é admitida (art. 262)` FALSE)
#ASSERT `a ordem de venda firmada em aceitação da oferta anterior permanece válida (art. 262, § 1º)` FALSE
#ASSERT (NOT `a ordem de venda firmada em aceitação da oferta anterior permanece válida (art. 262, § 1º)` TRUE)
#ASSERT `o primeiro ofertante pode prorrogar o prazo da sua oferta (art. 262, § 2º)` TRUE (YearMonthDay 2026 3 20) (YearMonthDay 2026 3 25) (YearMonthDay 2026 3 25)
#ASSERT (NOT `o primeiro ofertante pode prorrogar o prazo da sua oferta (art. 262, § 2º)` TRUE (YearMonthDay 2026 3 20) (YearMonthDay 2026 3 26) (YearMonthDay 2026 3 25))
#ASSERT (NOT `o primeiro ofertante pode prorrogar o prazo da sua oferta (art. 262, § 2º)` TRUE (YearMonthDay 2026 3 20) (YearMonthDay 2026 3 19) (YearMonthDay 2026 3 25))
#ASSERT (NOT `o primeiro ofertante pode prorrogar o prazo da sua oferta (art. 262, § 2º)` FALSE (YearMonthDay 2026 3 20) (YearMonthDay 2026 3 25) (YearMonthDay 2026 3 25))
