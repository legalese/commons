IMPORT prelude
IMPORT `br-core`
IMPORT `br6-cap20a-coligadas-participacao-reciproca`

-- br6-tests-cap20a.l4 -- tests of br6-cap20a-coligadas-participacao-reciproca.l4 (Arts. 243 to 246).
-- Expected values come from the text of lei-6404-1976.pt.txt (a converter's plain-text rendering, not the official text), never from the output of the code.



-- Art. 243: relatório da administração; influência significativa (§§ 4º e 5º), coligadas (§ 1º), controladas (§ 2º), informações exigidas pela CVM (§ 3º).
#ASSERT `o relatório anual da administração cumpre o art. 243 (art. 243)` TRUE TRUE
#ASSERT (NOT `o relatório anual da administração cumpre o art. 243 (art. 243)` TRUE FALSE)
#ASSERT (NOT `o relatório anual da administração cumpre o art. 243 (art. 243)` FALSE TRUE)
#ASSERT `a investidora tem influência significativa (art. 243, §§ 4º e 5º)` TRUE FALSE 0 100 FALSE
#ASSERT `a investidora tem influência significativa (art. 243, §§ 4º e 5º)` FALSE FALSE 20 100 FALSE
#ASSERT (NOT `a investidora tem influência significativa (art. 243, §§ 4º e 5º)` FALSE FALSE 19 100 FALSE)
#ASSERT (NOT `a investidora tem influência significativa (art. 243, §§ 4º e 5º)` FALSE FALSE 20 100 TRUE)
#ASSERT (NOT `a investidora tem influência significativa (art. 243, §§ 4º e 5º)` TRUE TRUE 0 100 FALSE)
#ASSERT (NOT `a investidora tem influência significativa (art. 243, §§ 4º e 5º)` FALSE TRUE 50 100 FALSE)
#ASSERT (NOT `a investidora tem influência significativa (art. 243, §§ 4º e 5º)` FALSE FALSE 0 0 FALSE)
#ASSERT `a investidora tem influência significativa (art. 243, §§ 4º e 5º)` TRUE FALSE 5 100 TRUE
#ASSERT `a sociedade é coligada (art. 243, § 1º)` TRUE FALSE 0 100 FALSE
#ASSERT `a sociedade é coligada (art. 243, § 1º)` FALSE FALSE 20 100 FALSE
#ASSERT (NOT `a sociedade é coligada (art. 243, § 1º)` FALSE FALSE 19 100 FALSE)
#ASSERT (NOT `a sociedade é coligada (art. 243, § 1º)` FALSE FALSE 20 100 TRUE)
#ASSERT (NOT `a sociedade é coligada (art. 243, § 1º)` TRUE TRUE 0 100 FALSE)
#ASSERT (NOT `a sociedade é coligada (art. 243, § 1º)` FALSE TRUE 50 100 FALSE)
#ASSERT (NOT `a sociedade é coligada (art. 243, § 1º)` FALSE FALSE 0 0 FALSE)
#ASSERT `a sociedade é coligada (art. 243, § 1º)` TRUE FALSE 5 100 TRUE
#ASSERT `a sociedade é controlada (art. 243, § 2º)` TRUE TRUE TRUE TRUE
#ASSERT (NOT `a sociedade é controlada (art. 243, § 2º)` FALSE TRUE TRUE TRUE)
#ASSERT (NOT `a sociedade é controlada (art. 243, § 2º)` TRUE FALSE TRUE TRUE)
#ASSERT (NOT `a sociedade é controlada (art. 243, § 2º)` TRUE TRUE FALSE TRUE)
#ASSERT (NOT `a sociedade é controlada (art. 243, § 2º)` TRUE TRUE TRUE FALSE)
#ASSERT `a companhia aberta divulgou as informações adicionais exigidas sobre coligadas e controladas (art. 243, § 3º)` `companhia aberta` TRUE TRUE
#ASSERT (NOT `a companhia aberta divulgou as informações adicionais exigidas sobre coligadas e controladas (art. 243, § 3º)` `companhia aberta` TRUE FALSE)
#ASSERT `a companhia aberta divulgou as informações adicionais exigidas sobre coligadas e controladas (art. 243, § 3º)` `companhia aberta` FALSE FALSE
#ASSERT `a companhia aberta divulgou as informações adicionais exigidas sobre coligadas e controladas (art. 243, § 3º)` `companhia fechada` TRUE FALSE

-- Art. 244: participação recíproca.
#ASSERT `a exceção do art. 244, § 1º se aplica` TRUE
#ASSERT (NOT `a exceção do art. 244, § 1º se aplica` FALSE)
#ASSERT `a participação recíproca é vedada (art. 244)` TRUE FALSE
#ASSERT (NOT `a participação recíproca é vedada (art. 244)` TRUE TRUE)
#ASSERT (NOT `a participação recíproca é vedada (art. 244)` FALSE FALSE)
#ASSERT `o direito de voto das ações da controladora de propriedade da controlada está suspenso (art. 244, § 2º)` TRUE
#ASSERT (NOT `o direito de voto das ações da controladora de propriedade da controlada está suspenso (art. 244, § 2º)` FALSE)
#ASSERT `o § 2º do art. 30 se aplica à aquisição de ações da companhia aberta pela sociedade (art. 244, § 3º)` `companhia aberta` TRUE
#ASSERT (NOT `o § 2º do art. 30 se aplica à aquisição de ações da companhia aberta pela sociedade (art. 244, § 3º)` `companhia fechada` TRUE)
#ASSERT (NOT `o § 2º do art. 30 se aplica à aquisição de ações da companhia aberta pela sociedade (art. 244, § 3º)` `companhia aberta` FALSE)
#ASSERT (`o valor das ações ou quotas que a sociedade deve alienar (art. 244, § 4º)` 100 60 TRUE) EQUALS (JUST 40)
#ASSERT (`o valor das ações ou quotas que a sociedade deve alienar (art. 244, § 4º)` 50 60 TRUE) EQUALS (JUST 0)
#ASSERT (`o valor das ações ou quotas que a sociedade deve alienar (art. 244, § 4º)` 100 60 FALSE) EQUALS NOTHING
#ASSERT `a alienação foi feita dentro de seis meses (art. 244, § 4º)` (YearMonthDay 2026 1 15) (YearMonthDay 2026 7 15)
#ASSERT (NOT `a alienação foi feita dentro de seis meses (art. 244, § 4º)` (YearMonthDay 2026 1 15) (YearMonthDay 2026 7 16))
#ASSERT `a participação recíproca foi mencionada nos relatórios e demonstrações de ambas as sociedades (art. 244, § 5º)` TRUE TRUE
#ASSERT (NOT `a participação recíproca foi mencionada nos relatórios e demonstrações de ambas as sociedades (art. 244, § 5º)` TRUE FALSE)
#ASSERT `a participação recíproca foi mencionada nos relatórios e demonstrações de ambas as sociedades (art. 244, § 5º)` FALSE FALSE
#ASSERT `a participação recíproca foi eliminada no prazo de um ano (art. 244, § 5º)` (YearMonthDay 2026 3 10) (YearMonthDay 2027 3 10)
#ASSERT (NOT `a participação recíproca foi eliminada no prazo de um ano (art. 244, § 5º)` (YearMonthDay 2026 3 10) (YearMonthDay 2027 3 11))
#ASSERT (`qual participação deve ser alienada entre coligadas (art. 244, § 5º)` TRUE FALSE FALSE) EQUALS (JUST `as ações ou quotas de aquisição mais recente (art. 244, § 5º)`)
#ASSERT (`qual participação deve ser alienada entre coligadas (art. 244, § 5º)` TRUE FALSE TRUE) EQUALS (JUST `as ações ou quotas que representam menor porcentagem do capital social (art. 244, § 5º)`)
#ASSERT (`qual participação deve ser alienada entre coligadas (art. 244, § 5º)` TRUE TRUE FALSE) EQUALS NOTHING
#ASSERT (`qual participação deve ser alienada entre coligadas (art. 244, § 5º)` FALSE FALSE FALSE) EQUALS NOTHING
#ASSERT `os administradores da sociedade respondem solidariamente pela aquisição (art. 244, § 6º)` TRUE
#ASSERT (NOT `os administradores da sociedade respondem solidariamente pela aquisição (art. 244, § 6º)` FALSE)
#ASSERT `a aquisição é equiparada, para efeitos penais, à compra ilegal das próprias ações (art. 244, § 6º)` TRUE
#ASSERT (NOT `a aquisição é equiparada, para efeitos penais, à compra ilegal das próprias ações (art. 244, § 6º)` FALSE)

-- Art. 245: administradores e sociedades coligadas, controladoras ou controladas.
#ASSERT `o ato do administrador é vedado (art. 245)` TRUE TRUE
#ASSERT (NOT `o ato do administrador é vedado (art. 245)` TRUE FALSE)
#ASSERT (NOT `o ato do administrador é vedado (art. 245)` FALSE TRUE)
#ASSERT `a operação entre as sociedades cumpriu o dever de zelo do art. 245` TRUE FALSE
#ASSERT `a operação entre as sociedades cumpriu o dever de zelo do art. 245` FALSE TRUE
#ASSERT (NOT `a operação entre as sociedades cumpriu o dever de zelo do art. 245` FALSE FALSE)
#ASSERT (`a quantia pela qual o administrador responde perante a companhia (art. 245)` TRUE 1000) EQUALS (JUST 1000)
#ASSERT (`a quantia pela qual o administrador responde perante a companhia (art. 245)` FALSE 1000) EQUALS NOTHING

-- Art. 246: sociedade controladora; a ação cabe a quem representa 5% ou mais do capital (em ações) ou a qualquer acionista que preste caução; honorários de 20% e prêmio de 5%.
#ASSERT (`a quantia que a sociedade controladora é obrigada a reparar à companhia (art. 246)` TRUE 500) EQUALS (JUST 500)
#ASSERT (`a quantia que a sociedade controladora é obrigada a reparar à companhia (art. 246)` FALSE 500) EQUALS NOTHING
#ASSERT `o acionista pode propor a ação de reparação contra a sociedade controladora (art. 246, § 1º)` 5 100 FALSE
#ASSERT (NOT `o acionista pode propor a ação de reparação contra a sociedade controladora (art. 246, § 1º)` 4 100 FALSE)
#ASSERT `o acionista pode propor a ação de reparação contra a sociedade controladora (art. 246, § 1º)` 1 100 TRUE
#ASSERT (NOT `o acionista pode propor a ação de reparação contra a sociedade controladora (art. 246, § 1º)` 0 0 FALSE)
#ASSERT (`os honorários de advogado que a sociedade controladora paga ao autor da ação (art. 246, § 2º)` TRUE 1000) EQUALS (JUST 200)
#ASSERT (`os honorários de advogado que a sociedade controladora paga ao autor da ação (art. 246, § 2º)` FALSE 1000) EQUALS NOTHING
#ASSERT (`o prêmio que a sociedade controladora paga ao autor da ação (art. 246, § 2º)` TRUE 1000) EQUALS (JUST 50)
#ASSERT (`o prêmio que a sociedade controladora paga ao autor da ação (art. 246, § 2º)` FALSE 1000) EQUALS NOTHING
