IMPORT prelude
IMPORT `br-core`
IMPORT `br6-cap20b-demonstracoes-financeiras`

-- br6-tests-cap20b.l4 -- tests of br6-cap20b-demonstracoes-financeiras.l4 (Arts. 247 to 250).
-- Expected values come from the text of lei-6404-1976.pt.txt (a converter's plain-text rendering, not the official text), never from the output of the code.

GIVETH A `Nota explicativa sobre a sociedade investida (art. 247)`
`[teste] nota completa` MEANS `Nota explicativa sobre a sociedade investida (art. 247)` WITH
    `indica a denominação da sociedade, o capital social e o patrimônio líquido` IS TRUE
    `indica o número, as espécies e as classes das ações ou quotas da companhia e o preço de mercado das ações, se houver` IS TRUE
    `indica o lucro líquido do exercício` IS TRUE
    `indica os créditos e obrigações entre a companhia e as sociedades coligadas e controladas` IS TRUE
    `indica o montante das receitas e despesas em operações entre a companhia e as sociedades coligadas e controladas` IS TRUE

GIVETH A `Nota explicativa sobre a sociedade investida (art. 247)`
`[teste] nota sem o item II` MEANS `Nota explicativa sobre a sociedade investida (art. 247)` WITH
    `indica a denominação da sociedade, o capital social e o patrimônio líquido` IS TRUE
    `indica o número, as espécies e as classes das ações ou quotas da companhia e o preço de mercado das ações, se houver` IS FALSE
    `indica o lucro líquido do exercício` IS TRUE
    `indica os créditos e obrigações entre a companhia e as sociedades coligadas e controladas` IS TRUE
    `indica o montante das receitas e despesas em operações entre a companhia e as sociedades coligadas e controladas` IS TRUE

GIVETH A `Nota explicativa sobre a sociedade investida (art. 247)`
`[teste] nota sem o item III` MEANS `Nota explicativa sobre a sociedade investida (art. 247)` WITH
    `indica a denominação da sociedade, o capital social e o patrimônio líquido` IS TRUE
    `indica o número, as espécies e as classes das ações ou quotas da companhia e o preço de mercado das ações, se houver` IS TRUE
    `indica o lucro líquido do exercício` IS FALSE
    `indica os créditos e obrigações entre a companhia e as sociedades coligadas e controladas` IS TRUE
    `indica o montante das receitas e despesas em operações entre a companhia e as sociedades coligadas e controladas` IS TRUE



-- Art. 247: as notas explicativas (itens I a V; o preço de mercado, se houver) e o investimento relevante (10% do patrimônio líquido em cada sociedade, 15% no conjunto).
#ASSERT `a nota explicativa contém as informações exigidas (art. 247)` `[teste] nota completa` TRUE
#ASSERT `a nota explicativa contém as informações exigidas (art. 247)` `[teste] nota completa` FALSE
#ASSERT `a nota explicativa contém as informações exigidas (art. 247)` `[teste] nota sem o item II` FALSE
#ASSERT (NOT `a nota explicativa contém as informações exigidas (art. 247)` `[teste] nota sem o item II` TRUE)
#ASSERT (NOT `a nota explicativa contém as informações exigidas (art. 247)` `[teste] nota sem o item III` FALSE)
#ASSERT `o investimento é relevante (art. 247, parágrafo único)` 10 0 100
#ASSERT (NOT `o investimento é relevante (art. 247, parágrafo único)` 9 14 100)
#ASSERT `o investimento é relevante (art. 247, parágrafo único)` 9 15 100
#ASSERT (NOT `o investimento é relevante (art. 247, parágrafo único)` 0 14 100)
#ASSERT `o investimento é relevante (art. 247, parágrafo único)` 0 15 100

-- Art. 248: a equivalência patrimonial (balancete até 60 dias antes de 31 de dezembro de 2026, isto é, de 1º de novembro a 31 de dezembro).
#ASSERT (`o investimento deve ser avaliado pelo método da equivalência patrimonial (art. 248)` TRUE) EQUALS (JUST TRUE)
#ASSERT (`o investimento deve ser avaliado pelo método da equivalência patrimonial (art. 248)` FALSE) EQUALS NOTHING
#ASSERT `o balanço ou balancete da investida serve para determinar o valor do patrimônio líquido (art. 248, inciso I)` (YearMonthDay 2026 12 31) (YearMonthDay 2026 12 31) TRUE
#ASSERT `o balanço ou balancete da investida serve para determinar o valor do patrimônio líquido (art. 248, inciso I)` (YearMonthDay 2026 11 1) (YearMonthDay 2026 12 31) TRUE
#ASSERT (NOT `o balanço ou balancete da investida serve para determinar o valor do patrimônio líquido (art. 248, inciso I)` (YearMonthDay 2026 10 31) (YearMonthDay 2026 12 31) TRUE)
#ASSERT (NOT `o balanço ou balancete da investida serve para determinar o valor do patrimônio líquido (art. 248, inciso I)` (YearMonthDay 2027 1 1) (YearMonthDay 2026 12 31) TRUE)
#ASSERT (NOT `o balanço ou balancete da investida serve para determinar o valor do patrimônio líquido (art. 248, inciso I)` (YearMonthDay 2026 12 31) (YearMonthDay 2026 12 31) FALSE)
#ASSERT (`o valor do patrimônio líquido da investida para a equivalência patrimonial (art. 248, inciso I)` 1000 100) EQUALS 900
#ASSERT (`o valor do patrimônio líquido da investida para a equivalência patrimonial (art. 248, inciso I)` 1000 0) EQUALS 1000
#ASSERT (`o valor do investimento pela equivalência patrimonial (art. 248, inciso II)` 900 25%) EQUALS 225
#ASSERT `a diferença pode ser registrada como resultado do exercício (art. 248, inciso III)` TRUE FALSE `companhia fechada` FALSE
#ASSERT `a diferença pode ser registrada como resultado do exercício (art. 248, inciso III)` FALSE TRUE `companhia aberta` TRUE
#ASSERT (NOT `a diferença pode ser registrada como resultado do exercício (art. 248, inciso III)` TRUE FALSE `companhia aberta` FALSE)
#ASSERT (NOT `a diferença pode ser registrada como resultado do exercício (art. 248, inciso III)` FALSE FALSE `companhia fechada` TRUE)
#ASSERT (`o custo de aquisição para efeito de determinar a relevância do investimento (art. 248, § 1º)` 1000 200) EQUALS 1200
#ASSERT `a sociedade coligada deve elaborar e fornecer o balanço ou balancete (art. 248, § 2º)` TRUE
#ASSERT (NOT `a sociedade coligada deve elaborar e fornecer o balanço ou balancete (art. 248, § 2º)` FALSE)

-- Art. 249: consolidação quando os investimentos em controladas passam de 30% do patrimônio líquido da companhia aberta.
#ASSERT `a companhia deve elaborar e divulgar demonstrações consolidadas (art. 249)` `companhia aberta` 31 100
#ASSERT (NOT `a companhia deve elaborar e divulgar demonstrações consolidadas (art. 249)` `companhia aberta` 30 100)
#ASSERT (NOT `a companhia deve elaborar e divulgar demonstrações consolidadas (art. 249)` `companhia fechada` 50 100)

-- Art. 250: normas sobre consolidação.
#ASSERT `a conta ou parcela é excluída das demonstrações consolidadas (art. 250)` TRUE FALSE FALSE
#ASSERT `a conta ou parcela é excluída das demonstrações consolidadas (art. 250)` FALSE TRUE FALSE
#ASSERT `a conta ou parcela é excluída das demonstrações consolidadas (art. 250)` FALSE FALSE TRUE
#ASSERT (NOT `a conta ou parcela é excluída das demonstrações consolidadas (art. 250)` FALSE FALSE FALSE)
#ASSERT `a participação dos acionistas não controladores foi destacada (art. 250, § 1º)` TRUE TRUE
#ASSERT (NOT `a participação dos acionistas não controladores foi destacada (art. 250, § 1º)` TRUE FALSE)
#ASSERT (NOT `a participação dos acionistas não controladores foi destacada (art. 250, § 1º)` FALSE TRUE)
#ASSERT `a parcela do custo de aquisição não absorvida na consolidação foi tratada como o art. 250, § 2º exige` TRUE TRUE
#ASSERT (NOT `a parcela do custo de aquisição não absorvida na consolidação foi tratada como o art. 250, § 2º exige` TRUE FALSE)
#ASSERT (NOT `a parcela do custo de aquisição não absorvida na consolidação foi tratada como o art. 250, § 2º exige` FALSE TRUE)
#ASSERT (`a parcela destacada dos resultados de exercícios futuros (art. 250, § 3º)` 150 100 FALSE) EQUALS (JUST 50)
#ASSERT (`a parcela destacada dos resultados de exercícios futuros (art. 250, § 3º)` 150 100 TRUE) EQUALS NOTHING
#ASSERT (`a parcela destacada dos resultados de exercícios futuros (art. 250, § 3º)` 100 100 FALSE) EQUALS NOTHING
#ASSERT (`a parcela destacada dos resultados de exercícios futuros (art. 250, § 3º)` 90 100 FALSE) EQUALS NOTHING
#ASSERT `a controlada deve elaborar demonstrações financeiras extraordinárias (art. 250, § 4º)` (YearMonthDay 2026 10 31) (YearMonthDay 2026 12 31)
#ASSERT (NOT `a controlada deve elaborar demonstrações financeiras extraordinárias (art. 250, § 4º)` (YearMonthDay 2026 11 1) (YearMonthDay 2026 12 31))
#ASSERT (NOT `a controlada deve elaborar demonstrações financeiras extraordinárias (art. 250, § 4º)` (YearMonthDay 2026 12 31) (YearMonthDay 2026 12 31))
#ASSERT `a data das demonstrações extraordinárias está compreendida no prazo de sessenta dias (art. 250, § 4º)` (YearMonthDay 2026 11 1) (YearMonthDay 2026 12 31)
#ASSERT `a data das demonstrações extraordinárias está compreendida no prazo de sessenta dias (art. 250, § 4º)` (YearMonthDay 2026 12 31) (YearMonthDay 2026 12 31)
#ASSERT (NOT `a data das demonstrações extraordinárias está compreendida no prazo de sessenta dias (art. 250, § 4º)` (YearMonthDay 2026 10 31) (YearMonthDay 2026 12 31))
