-- Art. 206, I: dissolução de pleno direito (alineas a a e).
#ASSERT `a companhia se dissolve pelo término do prazo de duração (art. 206, inciso I, alínea a)` `[teste] I: o prazo de duração terminou`
#ASSERT (NOT `a companhia se dissolve pelo término do prazo de duração (art. 206, inciso I, alínea a)` `[teste] I: nenhum fato`)
#ASSERT `a companhia se dissolve nos casos previstos no estatuto (art. 206, inciso I, alínea b)` `[teste] I: caso previsto no estatuto`
#ASSERT (NOT `a companhia se dissolve nos casos previstos no estatuto (art. 206, inciso I, alínea b)` `[teste] I: nenhum fato`)
#ASSERT `a companhia se dissolve por deliberação da assembleia-geral (art. 206, inciso I, alínea c)` `[teste] I: deliberação da assembleia`
#ASSERT (NOT `a companhia se dissolve por deliberação da assembleia-geral (art. 206, inciso I, alínea c)` `[teste] I: nenhum fato`)
#ASSERT `a companhia se dissolve pela existência de um único acionista não reconstituída (art. 206, inciso I, alínea d)` `[teste] I: único acionista não reconstituído`
#ASSERT (NOT `a companhia se dissolve pela existência de um único acionista não reconstituída (art. 206, inciso I, alínea d)` `[teste] I: único acionista reconstituído`)
#ASSERT (NOT `a companhia se dissolve pela existência de um único acionista não reconstituída (art. 206, inciso I, alínea d)` `[teste] I: único acionista em subsidiária integral`)
#ASSERT (NOT `a companhia se dissolve pela existência de um único acionista não reconstituída (art. 206, inciso I, alínea d)` `[teste] I: nenhum fato`)
#ASSERT `a companhia se dissolve pela extinção da autorização para funcionar (art. 206, inciso I, alínea e)` `[teste] I: autorização para funcionar extinta`
#ASSERT (NOT `a companhia se dissolve pela extinção da autorização para funcionar (art. 206, inciso I, alínea e)` `[teste] I: nenhum fato`)
#ASSERT `a companhia se dissolve de pleno direito (art. 206, inciso I)` `[teste] I: o prazo de duração terminou`
#ASSERT `a companhia se dissolve de pleno direito (art. 206, inciso I)` `[teste] I: caso previsto no estatuto`
#ASSERT `a companhia se dissolve de pleno direito (art. 206, inciso I)` `[teste] I: deliberação da assembleia`
#ASSERT `a companhia se dissolve de pleno direito (art. 206, inciso I)` `[teste] I: único acionista não reconstituído`
#ASSERT `a companhia se dissolve de pleno direito (art. 206, inciso I)` `[teste] I: autorização para funcionar extinta`
#ASSERT (NOT `a companhia se dissolve de pleno direito (art. 206, inciso I)` `[teste] I: nenhum fato`)
#ASSERT (NOT `a companhia se dissolve de pleno direito (art. 206, inciso I)` `[teste] I: único acionista reconstituído`)
#ASSERT (NOT `a companhia se dissolve de pleno direito (art. 206, inciso I)` `[teste] I: único acionista em subsidiária integral`)

-- Art. 206, II: dissolução por decisão judicial (alineas a a c); alinea b: 5% ou mais do capital (capital em ações, fork F-cap).
#ASSERT `a companhia se dissolve por decisão judicial (art. 206, inciso II)` `[teste] II: anulada em ação de acionista`
#ASSERT (NOT `a companhia se dissolve por decisão judicial (art. 206, inciso II)` `[teste] II: anulada em ação de quem não é acionista`)
