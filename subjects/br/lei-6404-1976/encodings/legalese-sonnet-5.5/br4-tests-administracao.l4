IMPORT prelude
IMPORT `br-core`
IMPORT `br4-administracao`

-- br4-tests-administracao.l4 -- tests of br4-administracao.l4 (arts. 138 and 139).
-- Every expected value was decided from the text of the article, written beside the assertion, and then run.

§ `Testes dos arts. 138 e 139`

`[teste br4] perfil: companhia fechada sem capital autorizado` MEANS `Perfil da companhia` WITH
    `o tipo da companhia` IS `companhia fechada`
    `a companhia tem conselho de administração` IS FALSE
    `a companhia tem conselho fiscal permanente` IS FALSE
    `a companhia tem capital autorizado` IS FALSE
    `a companhia é de economia mista` IS FALSE

`[teste br4] perfil: companhia fechada com capital autorizado` MEANS `Perfil da companhia` WITH
    `o tipo da companhia` IS `companhia fechada`
    `a companhia tem conselho de administração` IS FALSE
    `a companhia tem conselho fiscal permanente` IS FALSE
    `a companhia tem capital autorizado` IS TRUE
    `a companhia é de economia mista` IS FALSE

`[teste br4] perfil: companhia aberta com conselho` MEANS `Perfil da companhia` WITH
    `o tipo da companhia` IS `companhia aberta`
    `a companhia tem conselho de administração` IS TRUE
    `a companhia tem conselho fiscal permanente` IS FALSE
    `a companhia tem capital autorizado` IS FALSE
    `a companhia é de economia mista` IS FALSE

`[teste br4] perfil: companhia aberta sem conselho` MEANS `Perfil da companhia` WITH
    `o tipo da companhia` IS `companhia aberta`
    `a companhia tem conselho de administração` IS FALSE
    `a companhia tem conselho fiscal permanente` IS FALSE
    `a companhia tem capital autorizado` IS FALSE
    `a companhia é de economia mista` IS FALSE

-- Art. 138, caput: board and diretoria, or the diretoria alone, as the estatuto provides.
#ASSERT `os órgãos a que compete a administração da companhia (art. 138)` TRUE EQUALS (LIST `o conselho de administração`, `a diretoria`)
#ASSERT `os órgãos a que compete a administração da companhia (art. 138)` FALSE EQUALS (LIST `a diretoria`)

-- Art. 138, § 1º: the board deliberates collegially; the paragraph says nothing of the others (NOTHING).
#ASSERT `o órgão delibera de modo colegiado (art. 138, § 1º)` `o conselho de administração` EQUALS JUST TRUE
#ASSERT `o órgão delibera de modo colegiado (art. 138, § 1º)` `a diretoria` EQUALS NOTHING
#ASSERT `o órgão delibera de modo colegiado (art. 138, § 1º)` `o acionista` EQUALS NOTHING

-- Art. 138, § 1º: representation is private to the diretores.
#ASSERT `o órgão ou pessoa pode representar a companhia (art. 138, § 1º)` `o diretor` EQUALS JUST TRUE
#ASSERT `o órgão ou pessoa pode representar a companhia (art. 138, § 1º)` `a diretoria` EQUALS JUST TRUE
#ASSERT `o órgão ou pessoa pode representar a companhia (art. 138, § 1º)` `o conselho de administração` EQUALS JUST FALSE
#ASSERT `o órgão ou pessoa pode representar a companhia (art. 138, § 1º)` `o conselheiro de administração` EQUALS JUST FALSE
#ASSERT `o órgão ou pessoa pode representar a companhia (art. 138, § 1º)` `o acionista` EQUALS JUST FALSE
-- A generic administrador may be a conselheiro or a diretor: the paragraph does not settle it.
#ASSERT `o órgão ou pessoa pode representar a companhia (art. 138, § 1º)` `o administrador` EQUALS NOTHING

-- Art. 138, § 2º: open companies and companies with authorised capital must have a board.
#ASSERT `a companhia é obrigada a ter conselho de administração (art. 138, § 2º)` `[teste br4] perfil: companhia aberta sem conselho`
#ASSERT `a companhia é obrigada a ter conselho de administração (art. 138, § 2º)` `[teste br4] perfil: companhia fechada com capital autorizado`
#ASSERT NOT (`a companhia é obrigada a ter conselho de administração (art. 138, § 2º)` `[teste br4] perfil: companhia fechada sem capital autorizado`)
-- Complying with it:
#ASSERT NOT (`a companhia cumpre a exigência de ter conselho de administração (art. 138, § 2º)` `[teste br4] perfil: companhia aberta sem conselho`)
#ASSERT `a companhia cumpre a exigência de ter conselho de administração (art. 138, § 2º)` `[teste br4] perfil: companhia aberta com conselho`
#ASSERT `a companhia cumpre a exigência de ter conselho de administração (art. 138, § 2º)` `[teste br4] perfil: companhia fechada sem capital autorizado`

-- Art. 138, § 3º: no accumulation of the two top posts in an open company.
#ASSERT `a acumulação dos cargos de presidente do conselho e de diretor-presidente ou principal executivo é vedada (art. 138, § 3º)` `companhia aberta` TRUE
#ASSERT NOT (`a acumulação dos cargos de presidente do conselho e de diretor-presidente ou principal executivo é vedada (art. 138, § 3º)` `companhia aberta` FALSE)
-- A closed company is outside § 3º.
#ASSERT NOT (`a acumulação dos cargos de presidente do conselho e de diretor-presidente ou principal executivo é vedada (art. 138, § 3º)` `companhia fechada` TRUE)

-- Art. 138, § 4º: the CVM's exception needs both the act and a company of art. 294-B.
#ASSERT `a companhia está excepcionada da vedação de acumular os cargos (art. 138, § 4º)` TRUE TRUE
#ASSERT NOT (`a companhia está excepcionada da vedação de acumular os cargos (art. 138, § 4º)` TRUE FALSE)
#ASSERT NOT (`a companhia está excepcionada da vedação de acumular os cargos (art. 138, § 4º)` FALSE TRUE)

-- Arts. 138, §§ 3º and 4º together.
#ASSERT `a vedação de acumular os cargos alcança a pessoa (art. 138, §§ 3º e 4º)` `companhia aberta` TRUE FALSE FALSE
#ASSERT `a vedação de acumular os cargos alcança a pessoa (art. 138, §§ 3º e 4º)` `companhia aberta` TRUE TRUE FALSE
#ASSERT NOT (`a vedação de acumular os cargos alcança a pessoa (art. 138, §§ 3º e 4º)` `companhia aberta` TRUE TRUE TRUE)
#ASSERT NOT (`a vedação de acumular os cargos alcança a pessoa (art. 138, §§ 3º e 4º)` `companhia aberta` FALSE FALSE FALSE)
#ASSERT NOT (`a vedação de acumular os cargos alcança a pessoa (art. 138, §§ 3º e 4º)` `companhia fechada` TRUE FALSE FALSE)

-- Art. 139: the legal powers of the organs of administration cannot be granted to another organ.
#ASSERT `a outorga da atribuição ou poder a outro órgão é vedada (art. 139)` TRUE TRUE
#ASSERT NOT (`a outorga da atribuição ou poder a outro órgão é vedada (art. 139)` TRUE FALSE)
#ASSERT NOT (`a outorga da atribuição ou poder a outro órgão é vedada (art. 139)` FALSE TRUE)

