IMPORT prelude
IMPORT `br-core`
IMPORT `br3-nomes`
IMPORT `br3-cap10-sec2-direitos-essenciais`

-- br3-tests-cap10-sec2-direitos-essenciais.l4 -- tests of Art. 109, each expected value written from the text.

§ `Testes do art. 109`

-- Art. 109, caput: for each of the five rights the estatuto and the general meeting cannot deprive the shareholder.
#ASSERT NOT (`o estatuto ou a assembleia-geral pode privar o acionista do direito (art. 109)` `direito de participar dos lucros sociais (art. 109, inciso I)`)
#ASSERT NOT (`o estatuto ou a assembleia-geral pode privar o acionista do direito (art. 109)` `direito de participar do acervo da companhia em caso de liquidação (art. 109, inciso II)`)
#ASSERT NOT (`o estatuto ou a assembleia-geral pode privar o acionista do direito (art. 109)` `direito de fiscalizar a gestão dos negócios sociais (art. 109, inciso III)`)
#ASSERT NOT (`o estatuto ou a assembleia-geral pode privar o acionista do direito (art. 109)` `direito de preferência para a subscrição (art. 109, inciso IV)`)
#ASSERT NOT (`o estatuto ou a assembleia-geral pode privar o acionista do direito (art. 109)` `direito de retirar-se da sociedade nos casos previstos nesta Lei (art. 109, inciso V)`)

-- § 1º: unequal rights inside one class contravene the Law; different classes may differ.
#ASSERT `o tratamento desigual entre ações da mesma classe contraria a Lei (art. 109, § 1º)` TRUE TRUE
#ASSERT NOT (`o tratamento desigual entre ações da mesma classe contraria a Lei (art. 109, § 1º)` TRUE FALSE)
#ASSERT NOT (`o tratamento desigual entre ações da mesma classe contraria a Lei (art. 109, § 1º)` FALSE TRUE)

-- § 2º: a means conferred by law cannot be eliminated; for any other means the text is silent.
#ASSERT `o estatuto ou a assembleia-geral pode elidir o meio legal de defesa dos direitos (art. 109, § 2º)` TRUE EQUALS JUST FALSE
#ASSERT `o estatuto ou a assembleia-geral pode elidir o meio legal de defesa dos direitos (art. 109, § 2º)` FALSE EQUALS NOTHING

-- § 3º: arbitration needs the estatuto to provide it, a divergence of one of the two kinds named, and the estatuto's terms.
#ASSERT `a divergência pode ser solucionada mediante arbitragem (art. 109, § 3º)` TRUE TRUE FALSE TRUE
#ASSERT `a divergência pode ser solucionada mediante arbitragem (art. 109, § 3º)` TRUE FALSE TRUE TRUE
#ASSERT NOT (`a divergência pode ser solucionada mediante arbitragem (art. 109, § 3º)` FALSE TRUE FALSE TRUE)
#ASSERT NOT (`a divergência pode ser solucionada mediante arbitragem (art. 109, § 3º)` TRUE FALSE FALSE TRUE)
#ASSERT NOT (`a divergência pode ser solucionada mediante arbitragem (art. 109, § 3º)` TRUE TRUE FALSE FALSE)
