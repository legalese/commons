IMPORT prelude
IMPORT `br-core`
IMPORT `br2-cap9-livros`

-- br2-tests-cap9-livros.l4 -- tests of br2-cap9-livros.l4 (Arts. 100 a 105).
-- Every expected value was decided by reading the article, before running, and is written beside the
-- assertion. A failing assertion is a finding, not an expected value to edit.

§ `Testes dos Arts. 100 a 105`

§§ `Fixtures`
`teste: companhia com conselho de administração` MEANS
    `Perfil da companhia` WITH
        `o tipo da companhia` IS `companhia aberta`
        `a companhia tem conselho de administração` IS TRUE
        `a companhia tem conselho fiscal permanente` IS FALSE
        `a companhia tem capital autorizado` IS FALSE
        `a companhia é de economia mista` IS FALSE

`teste: companhia sem conselho de administração` MEANS
    `Perfil da companhia` WITH
        `o tipo da companhia` IS `companhia fechada`
        `a companhia tem conselho de administração` IS FALSE
        `a companhia tem conselho fiscal permanente` IS FALSE
        `a companhia tem capital autorizado` IS FALSE
        `a companhia é de economia mista` IS FALSE

§§ `Art. 100, caput`
#ASSERT `a companhia deve ter esse livro (art. 100)` `Registro de Ações Nominativas (art. 100, I)` `teste: companhia sem conselho de administração` FALSE
#ASSERT `a companhia deve ter esse livro (art. 100)` `Transferência de Ações Nominativas (art. 100, II)` `teste: companhia sem conselho de administração` FALSE
-- Beneficiary parts: only "se tiverem sido emitidas".
#ASSERT `a companhia deve ter esse livro (art. 100)` `Registro de Partes Beneficiárias Nominativas (art. 100, III)` `teste: companhia com conselho de administração` TRUE
#ASSERT NOT (`a companhia deve ter esse livro (art. 100)` `Registro de Partes Beneficiárias Nominativas (art. 100, III)` `teste: companhia com conselho de administração` FALSE)
#ASSERT `a companhia deve ter esse livro (art. 100)` `Transferência de Partes Beneficiárias Nominativas (art. 100, III)` `teste: companhia com conselho de administração` TRUE
#ASSERT NOT (`a companhia deve ter esse livro (art. 100)` `Transferência de Partes Beneficiárias Nominativas (art. 100, III)` `teste: companhia com conselho de administração` FALSE)
#ASSERT `a companhia deve ter esse livro (art. 100)` `Atas das Assembleias Gerais (art. 100, IV)` `teste: companhia sem conselho de administração` FALSE
#ASSERT `a companhia deve ter esse livro (art. 100)` `Presença dos Acionistas (art. 100, V)` `teste: companhia sem conselho de administração` FALSE
-- The board's minutes: only "se houver" a board.
#ASSERT `a companhia deve ter esse livro (art. 100)` `Atas das Reuniões do Conselho de Administração (art. 100, VI)` `teste: companhia com conselho de administração` FALSE
#ASSERT NOT (`a companhia deve ter esse livro (art. 100)` `Atas das Reuniões do Conselho de Administração (art. 100, VI)` `teste: companhia sem conselho de administração` FALSE)
#ASSERT `a companhia deve ter esse livro (art. 100)` `Atas das Reuniões de Diretoria (art. 100, VI)` `teste: companhia sem conselho de administração` FALSE
-- The conselho fiscal's book has no "se houver": required as written, even for a company whose conselho
-- fiscal does not work permanently.
#ASSERT `a companhia deve ter esse livro (art. 100)` `Atas e Pareceres do Conselho Fiscal (art. 100, VII)` `teste: companhia sem conselho de administração` FALSE
-- Inciso I: the six kinds of entry.
#ASSERT `o livro de Registro de Ações Nominativas deve conter esse assentamento (art. 100, I)` `o nome do acionista e o número das suas ações (art. 100, I, a)`
#ASSERT `o livro de Registro de Ações Nominativas deve conter esse assentamento (art. 100, I)` `as entradas ou prestações de capital realizado (art. 100, I, b)`
#ASSERT `o livro de Registro de Ações Nominativas deve conter esse assentamento (art. 100, I)` `as conversões de ações, de uma em outra espécie ou classe (art. 100, I, c)`
#ASSERT `o livro de Registro de Ações Nominativas deve conter esse assentamento (art. 100, I)` `o resgate, o reembolso e a amortização das ações, ou sua aquisição pela companhia (art. 100, I, d)`
#ASSERT `o livro de Registro de Ações Nominativas deve conter esse assentamento (art. 100, I)` `as mutações operadas pela alienação ou transferência de ações (art. 100, I, e)`
#ASSERT `o livro de Registro de Ações Nominativas deve conter esse assentamento (art. 100, I)` `o penhor, o usufruto, o fideicomisso, a alienação fiduciária em garantia ou qualquer ônus que grave as ações ou obste sua negociação (art. 100, I, f)`
-- Inciso II: both signatures.
#ASSERT `o termo de transferência de ações nominativas cumpre o que a lei exige (art. 100, II)` TRUE TRUE
#ASSERT NOT (`o termo de transferência de ações nominativas cumpre o que a lei exige (art. 100, II)` TRUE FALSE)
#ASSERT NOT (`o termo de transferência de ações nominativas cumpre o que a lei exige (art. 100, II)` FALSE TRUE)
-- Inciso III: "no que couber".
#ASSERT `a disposição dos incisos I e II se aplica aos livros de partes beneficiárias (art. 100, III)` TRUE TRUE
#ASSERT NOT (`a disposição dos incisos I e II se aplica aos livros de partes beneficiárias (art. 100, III)` TRUE FALSE)

§§ `Art. 100, §§ 1º a 3º`
-- § 1º: a certificate of incisos I to III books, for any of the purposes.
#ASSERT (`a qualquer pessoa serão dadas certidões dos assentamentos do livro (art. 100, § 1º)` `Registro de Ações Nominativas (art. 100, I)` TRUE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`a qualquer pessoa serão dadas certidões dos assentamentos do livro (art. 100, § 1º)` `Registro de Ações Nominativas (art. 100, I)` FALSE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`a qualquer pessoa serão dadas certidões dos assentamentos do livro (art. 100, § 1º)` `Transferência de Ações Nominativas (art. 100, II)` FALSE FALSE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`a qualquer pessoa serão dadas certidões dos assentamentos do livro (art. 100, § 1º)` `Registro de Partes Beneficiárias Nominativas (art. 100, III)` FALSE FALSE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`a qualquer pessoa serão dadas certidões dos assentamentos do livro (art. 100, § 1º)` `Transferência de Partes Beneficiárias Nominativas (art. 100, III)` TRUE FALSE FALSE FALSE) EQUALS JUST TRUE
-- No purpose of the kind the paragraph names: no certificate.
#ASSERT (`a qualquer pessoa serão dadas certidões dos assentamentos do livro (art. 100, § 1º)` `Registro de Ações Nominativas (art. 100, I)` FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
-- The other books: the paragraph does not speak of them.
#ASSERT (`a qualquer pessoa serão dadas certidões dos assentamentos do livro (art. 100, § 1º)` `Atas das Assembleias Gerais (art. 100, IV)` TRUE TRUE TRUE TRUE) EQUALS NOTHING
#ASSERT (`a qualquer pessoa serão dadas certidões dos assentamentos do livro (art. 100, § 1º)` `Presença dos Acionistas (art. 100, V)` TRUE TRUE TRUE TRUE) EQUALS NOTHING
#ASSERT `a companhia pode cobrar o custo do serviço de certidão (art. 100, § 1º)`
#ASSERT `cabe recurso à Comissão de Valores Mobiliários do indeferimento do pedido de certidão (art. 100, § 1º)` TRUE
#ASSERT NOT (`cabe recurso à Comissão de Valores Mobiliários do indeferimento do pedido de certidão (art. 100, § 1º)` FALSE)
-- §§ 2º and 3º: incisos I to V can be replaced; VI and VII are not mentioned.
#ASSERT `o livro é de um dos incisos I a V do art. 100 (art. 100, §§ 2º e 3º)` `Registro de Ações Nominativas (art. 100, I)`
#ASSERT `o livro é de um dos incisos I a V do art. 100 (art. 100, §§ 2º e 3º)` `Presença dos Acionistas (art. 100, V)`
#ASSERT NOT (`o livro é de um dos incisos I a V do art. 100 (art. 100, §§ 2º e 3º)` `Atas das Reuniões de Diretoria (art. 100, VI)`)
#ASSERT NOT (`o livro é de um dos incisos I a V do art. 100 (art. 100, §§ 2º e 3º)` `Atas e Pareceres do Conselho Fiscal (art. 100, VII)`)
-- Open company: with the CVM's rules observed.
#ASSERT (`o livro pode ser substituído por registros mecanizados ou eletrônicos (art. 100, §§ 2º e 3º)` `Registro de Ações Nominativas (art. 100, I)` `companhia aberta` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`o livro pode ser substituído por registros mecanizados ou eletrônicos (art. 100, §§ 2º e 3º)` `Registro de Ações Nominativas (art. 100, I)` `companhia aberta` FALSE TRUE) EQUALS JUST FALSE
-- Closed company: under the regulation.
#ASSERT (`o livro pode ser substituído por registros mecanizados ou eletrônicos (art. 100, §§ 2º e 3º)` `Atas das Assembleias Gerais (art. 100, IV)` `companhia fechada` FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`o livro pode ser substituído por registros mecanizados ou eletrônicos (art. 100, §§ 2º e 3º)` `Atas das Assembleias Gerais (art. 100, IV)` `companhia fechada` TRUE FALSE) EQUALS JUST FALSE
-- Books VI and VII: neither paragraph says.
#ASSERT (`o livro pode ser substituído por registros mecanizados ou eletrônicos (art. 100, §§ 2º e 3º)` `Atas e Pareceres do Conselho Fiscal (art. 100, VII)` `companhia aberta` TRUE TRUE) EQUALS NOTHING
#ASSERT (`o livro pode ser substituído por registros mecanizados ou eletrônicos (art. 100, §§ 2º e 3º)` `Atas das Reuniões de Diretoria (art. 100, VI)` `companhia fechada` TRUE TRUE) EQUALS NOTHING

§§ `Art. 101`
#ASSERT (`a parte pode substituir os livros dos incisos I a III do art. 100 pela sua escrituração (art. 101)` `a instituição financeira` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`a parte pode substituir os livros dos incisos I a III do art. 100 pela sua escrituração (art. 101)` `a instituição financeira` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`a parte pode substituir os livros dos incisos I a III do art. 100 pela sua escrituração (art. 101)` `a instituição financeira` FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`a parte pode substituir os livros dos incisos I a III do art. 100 pela sua escrituração (art. 101)` `o acionista` TRUE TRUE) EQUALS NOTHING
#ASSERT `o agente emissor cumpriu o dever da lista anual dos titulares (art. 101)` TRUE TRUE TRUE TRUE
#ASSERT NOT (`o agente emissor cumpriu o dever da lista anual dos titulares (art. 101)` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`o agente emissor cumpriu o dever da lista anual dos titulares (art. 101)` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`o agente emissor cumpriu o dever da lista anual dos titulares (art. 101)` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`o agente emissor cumpriu o dever da lista anual dos titulares (art. 101)` TRUE TRUE TRUE FALSE)
#ASSERT `os termos de transferência podem ser lavrados em folhas soltas (art. 101, § 1º)` TRUE TRUE
#ASSERT NOT (`os termos de transferência podem ser lavrados em folhas soltas (art. 101, § 1º)` TRUE FALSE)
#ASSERT NOT (`os termos de transferência podem ser lavrados em folhas soltas (art. 101, § 1º)` FALSE TRUE)
#ASSERT `os termos em folhas soltas cumprem o § 2º (art. 101, § 2º)` TRUE TRUE TRUE
#ASSERT NOT (`os termos em folhas soltas cumprem o § 2º (art. 101, § 2º)` FALSE TRUE TRUE)
#ASSERT NOT (`os termos em folhas soltas cumprem o § 2º (art. 101, § 2º)` TRUE FALSE TRUE)
#ASSERT NOT (`os termos em folhas soltas cumprem o § 2º (art. 101, § 2º)` TRUE TRUE FALSE)

§§ `Arts. 102 e 103`
-- "Ao menos uma vez por ano": once is enough, none is not.
#ASSERT `a instituição financeira depositária cumpriu o dever de fornecer os extratos e a lista dos acionistas (art. 102)` 1 TRUE TRUE TRUE TRUE
#ASSERT `a instituição financeira depositária cumpriu o dever de fornecer os extratos e a lista dos acionistas (art. 102)` 2 TRUE TRUE TRUE TRUE
#ASSERT NOT (`a instituição financeira depositária cumpriu o dever de fornecer os extratos e a lista dos acionistas (art. 102)` 0 TRUE TRUE TRUE TRUE)
#ASSERT NOT (`a instituição financeira depositária cumpriu o dever de fornecer os extratos e a lista dos acionistas (art. 102)` 1 FALSE TRUE TRUE TRUE)
#ASSERT NOT (`a instituição financeira depositária cumpriu o dever de fornecer os extratos e a lista dos acionistas (art. 102)` 1 TRUE FALSE TRUE TRUE)
#ASSERT NOT (`a instituição financeira depositária cumpriu o dever de fornecer os extratos e a lista dos acionistas (art. 102)` 1 TRUE TRUE FALSE TRUE)
#ASSERT NOT (`a instituição financeira depositária cumpriu o dever de fornecer os extratos e a lista dos acionistas (art. 102)` 1 TRUE TRUE TRUE FALSE)
-- Art. 103: the company unless there is an issuing agent or a depositary institution.
#ASSERT (`a verificação da regularidade das transferências e dos direitos ou ônus sobre os valores mobiliários cabe à parte (art. 103)` `a companhia` FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`a verificação da regularidade das transferências e dos direitos ou ônus sobre os valores mobiliários cabe à parte (art. 103)` `a companhia` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`a verificação da regularidade das transferências e dos direitos ou ônus sobre os valores mobiliários cabe à parte (art. 103)` `a companhia` FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`a verificação da regularidade das transferências e dos direitos ou ônus sobre os valores mobiliários cabe à parte (art. 103)` `a instituição financeira` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`a verificação da regularidade das transferências e dos direitos ou ônus sobre os valores mobiliários cabe à parte (art. 103)` `a instituição financeira` FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`a verificação da regularidade das transferências e dos direitos ou ônus sobre os valores mobiliários cabe à parte (art. 103)` `a instituição financeira` FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`a verificação da regularidade das transferências e dos direitos ou ônus sobre os valores mobiliários cabe à parte (art. 103)` `o acionista` FALSE FALSE) EQUALS NOTHING
-- Parágrafo único: the judge for registry doubts, but not for the substance of the right.
#ASSERT (`o juiz competente para as dúvidas dos oficiais dos registros públicos dirime a dúvida (art. 103, parágrafo único)` TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`o juiz competente para as dúvidas dos oficiais dos registros públicos dirime a dúvida (art. 103, parágrafo único)` TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`o juiz competente para as dúvidas dos oficiais dos registros públicos dirime a dúvida (art. 103, parágrafo único)` FALSE TRUE FALSE) EQUALS NOTHING
#ASSERT (`o juiz competente para as dúvidas dos oficiais dos registros públicos dirime a dúvida (art. 103, parágrafo único)` TRUE FALSE FALSE) EQUALS NOTHING

§§ `Arts. 104 e 105`
#ASSERT (`a companhia é responsável pelos prejuízos por vícios ou irregularidades nos livros (art. 104)` `Registro de Ações Nominativas (art. 100, I)` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`a companhia é responsável pelos prejuízos por vícios ou irregularidades nos livros (art. 104)` `Transferência de Partes Beneficiárias Nominativas (art. 100, III)` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`a companhia é responsável pelos prejuízos por vícios ou irregularidades nos livros (art. 104)` `Registro de Ações Nominativas (art. 100, I)` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`a companhia é responsável pelos prejuízos por vícios ou irregularidades nos livros (art. 104)` `Registro de Ações Nominativas (art. 100, I)` FALSE TRUE) EQUALS JUST FALSE
-- Books IV to VII: the article does not speak of them.
#ASSERT (`a companhia é responsável pelos prejuízos por vícios ou irregularidades nos livros (art. 104)` `Atas das Assembleias Gerais (art. 100, IV)` TRUE TRUE) EQUALS NOTHING
-- Parágrafo único: the CVM's time is 10 days; taking 10 does not exceed it.
#ASSERT NOT (`a companhia responde perante acionistas e terceiros pelos prejuízos do atraso culposo (art. 104, parágrafo único)` 10 10 TRUE TRUE)
#ASSERT `a companhia responde perante acionistas e terceiros pelos prejuízos do atraso culposo (art. 104, parágrafo único)` 10 11 TRUE TRUE
#ASSERT NOT (`a companhia responde perante acionistas e terceiros pelos prejuízos do atraso culposo (art. 104, parágrafo único)` 10 11 FALSE TRUE)
#ASSERT NOT (`a companhia responde perante acionistas e terceiros pelos prejuízos do atraso culposo (art. 104, parágrafo único)` 10 11 TRUE FALSE)
-- Art. 105: 5% of the capital (50 of 1000 is exactly 5%).
#ASSERT `a exibição por inteiro dos livros da companhia pode ser ordenada judicialmente (art. 105)` 1000 50 TRUE FALSE
#ASSERT NOT (`a exibição por inteiro dos livros da companhia pode ser ordenada judicialmente (art. 105)` 1000 49 TRUE FALSE)
#ASSERT `a exibição por inteiro dos livros da companhia pode ser ordenada judicialmente (art. 105)` 1000 50 FALSE TRUE
#ASSERT NOT (`a exibição por inteiro dos livros da companhia pode ser ordenada judicialmente (art. 105)` 1000 50 FALSE FALSE)
#ASSERT NOT (`a exibição por inteiro dos livros da companhia pode ser ordenada judicialmente (art. 105)` 1000 1000 FALSE FALSE)
