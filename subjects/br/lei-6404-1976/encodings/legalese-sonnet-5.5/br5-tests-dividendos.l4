IMPORT prelude
IMPORT `br-core`
IMPORT `br5-vocabulario`
IMPORT `br5-dividendos`

-- br5-tests-dividendos.l4 -- tests of br5-dividendos.l4 (Arts. 201 to 205).
-- Every expected value, and every date, was worked out by hand from the text, with the sum written beside it.
-- Amounts are in reais.

§ `Testes do Art. 201: origem dos dividendos`

#ASSERT `a fonte do dividendo é permitida (art. 201)` `lucro líquido do exercício (art. 201)` FALSE
#ASSERT `a fonte do dividendo é permitida (art. 201)` `lucros acumulados (art. 201)` FALSE
#ASSERT `a fonte do dividendo é permitida (art. 201)` `reserva de lucros (art. 201)` FALSE
-- Capital reserve: only for the preferred shares of Art. 17, § 5º.
#ASSERT `a fonte do dividendo é permitida (art. 201)` `reserva de capital (art. 201)` TRUE
#ASSERT NOT (`a fonte do dividendo é permitida (art. 201)` `reserva de capital (art. 201)` FALSE)
-- "somente": any other source is not allowed, whatever the shares.
#ASSERT NOT (`a fonte do dividendo é permitida (art. 201)` `qualquer outra fonte (art. 201)` TRUE)
#ASSERT NOT (`a fonte do dividendo é permitida (art. 201)` `qualquer outra fonte (art. 201)` FALSE)

§§ `Testes do Art. 201, § 1º: responsabilidade pela reposição`

#ASSERT `os administradores e fiscais respondem solidariamente pela reposição do dividendo (art. 201, § 1º)` FALSE
#ASSERT NOT (`os administradores e fiscais respondem solidariamente pela reposição do dividendo (art. 201, § 1º)` TRUE)
-- Distributed 1000 against the Law: 1000 must be restored. Distributed in order: 0.
#ASSERT `a importância a repor à caixa social em reais (art. 201, § 1º)` FALSE 1000 EQUALS 1000
#ASSERT `a importância a repor à caixa social em reais (art. 201, § 1º)` TRUE 1000 EQUALS 0

§§ `Testes do Art. 201, § 2º: restituição pelo acionista`

-- Arguments: good faith, no balance sheet, against the balance sheet, presumption rebutted.
-- Good faith and nothing to presume: not obliged.
#ASSERT NOT (`o acionista é obrigado a restituir o dividendo recebido (art. 201, § 2º)` TRUE FALSE FALSE FALSE)
-- No balance sheet was drawn up: bad faith is presumed, so obliged.
#ASSERT `o acionista é obrigado a restituir o dividendo recebido (art. 201, § 2º)` TRUE TRUE FALSE FALSE
-- Distributed against the results of the balance sheet: presumed too.
#ASSERT `o acionista é obrigado a restituir o dividendo recebido (art. 201, § 2º)` TRUE FALSE TRUE FALSE
-- Presumption rebutted by evidence to the contrary: not obliged (fork F-201).
#ASSERT NOT (`o acionista é obrigado a restituir o dividendo recebido (art. 201, § 2º)` TRUE TRUE TRUE TRUE)
-- Not received in good faith: obliged, whatever else.
#ASSERT `o acionista é obrigado a restituir o dividendo recebido (art. 201, § 2º)` FALSE FALSE FALSE FALSE
#ASSERT `o acionista é obrigado a restituir o dividendo recebido (art. 201, § 2º)` FALSE TRUE TRUE TRUE

§ `Testes do Art. 202: dividendo obrigatório`

-- Inciso I: net profit 1000, legal reserve 50, contingency reserve 100, reversal of an earlier contingency reserve 30, nothing excluded.
-- 1000 - 50 - 100 + 30 = 880.
#ASSERT `o lucro líquido ajustado para o dividendo obrigatório em reais (art. 202, inciso I)` 1000 50 100 30 0 EQUALS 880
-- With the tax-incentive reserve excluded (200, Art. 195-A) and nothing else: 1000 - 200 = 800.
#ASSERT `o lucro líquido ajustado para o dividendo obrigatório em reais (art. 202, inciso I)` 1000 0 0 0 200 EQUALS 800
-- A reversal only: 1000 + 70 = 1070.
#ASSERT `o lucro líquido ajustado para o dividendo obrigatório em reais (art. 202, inciso I)` 1000 0 0 70 0 EQUALS 1070
-- Half of the adjusted profit when the estatuto is silent: half of 880 is 440; half of 1000 is 500.
#ASSERT `o dividendo obrigatório se o estatuto for omisso em reais (art. 202, inciso I)` 880 EQUALS 440
#ASSERT `o dividendo obrigatório se o estatuto for omisso em reais (art. 202, inciso I)` 1000 EQUALS 500
-- A profit of zero or less gives no dividend.
#ASSERT `o dividendo obrigatório se o estatuto for omisso em reais (art. 202, inciso I)` 0 EQUALS 0
#ASSERT `o dividendo obrigatório se o estatuto for omisso em reais (art. 202, inciso I)` (0 MINUS 100) EQUALS 0
-- The estatuto fixes the share (300): that is the dividend. If silent: half of 880 = 440.
#ASSERT `o dividendo obrigatório em reais (art. 202)` TRUE 300 880 EQUALS 300
#ASSERT `o dividendo obrigatório em reais (art. 202)` FALSE 300 880 EQUALS 440

§§ `Testes do Art. 202, inciso II: limite ao lucro realizado`

-- Dividend 440, realized part 300, the administration limits it and records the difference as a reserve: pay 300, record 440 - 300 = 140.
`dividendo limitado ao realizado (art. 202, inciso II)` MEANS `o dividendo a pagar quando se limita ao lucro realizado (art. 202, inciso II)` 440 300 TRUE TRUE
#ASSERT `dividendo limitado ao realizado (art. 202, inciso II)`'s `o dividendo a pagar em reais` EQUALS 300
#ASSERT `dividendo limitado ao realizado (art. 202, inciso II)`'s `a diferença a registrar como reserva de lucros a realizar em reais` EQUALS 140
-- Difference not recorded as a reserve: the limit is not allowed, so the whole 440 is paid.
`dividendo limitado sem registro (art. 202, inciso II)` MEANS `o dividendo a pagar quando se limita ao lucro realizado (art. 202, inciso II)` 440 300 TRUE FALSE
#ASSERT `dividendo limitado sem registro (art. 202, inciso II)`'s `o dividendo a pagar em reais` EQUALS 440
#ASSERT `dividendo limitado sem registro (art. 202, inciso II)`'s `a diferença a registrar como reserva de lucros a realizar em reais` EQUALS 0
-- The administration does not use the faculty: 440.
`dividendo sem limitação (art. 202, inciso II)` MEANS `o dividendo a pagar quando se limita ao lucro realizado (art. 202, inciso II)` 440 300 FALSE TRUE
#ASSERT `dividendo sem limitação (art. 202, inciso II)`'s `o dividendo a pagar em reais` EQUALS 440
-- Realized part above the dividend (500 against 440): nothing to limit, pay 440, record 0.
`dividendo com lucro realizado maior (art. 202, inciso II)` MEANS `o dividendo a pagar quando se limita ao lucro realizado (art. 202, inciso II)` 440 500 TRUE TRUE
#ASSERT `dividendo com lucro realizado maior (art. 202, inciso II)`'s `o dividendo a pagar em reais` EQUALS 440
#ASSERT `dividendo com lucro realizado maior (art. 202, inciso II)`'s `a diferença a registrar como reserva de lucros a realizar em reais` EQUALS 0
-- Boundary: realized part equal to the dividend (440): pay 440, record 0.
`dividendo com lucro realizado igual (art. 202, inciso II)` MEANS `o dividendo a pagar quando se limita ao lucro realizado (art. 202, inciso II)` 440 440 TRUE TRUE
#ASSERT `dividendo com lucro realizado igual (art. 202, inciso II)`'s `o dividendo a pagar em reais` EQUALS 440
#ASSERT `dividendo com lucro realizado igual (art. 202, inciso II)`'s `a diferença a registrar como reserva de lucros a realizar em reais` EQUALS 0
-- Nothing realized (zero) and a negative figure: pay 0, record the whole 440.
`dividendo sem lucro realizado (art. 202, inciso II)` MEANS `o dividendo a pagar quando se limita ao lucro realizado (art. 202, inciso II)` 440 (0 MINUS 10) TRUE TRUE
#ASSERT `dividendo sem lucro realizado (art. 202, inciso II)`'s `o dividendo a pagar em reais` EQUALS 0
#ASSERT `dividendo sem lucro realizado (art. 202, inciso II)`'s `a diferença a registrar como reserva de lucros a realizar em reais` EQUALS 440

§§ `Testes do Art. 202, inciso III: lucros realizados que estavam na reserva`

-- 100 realized, 30 absorbed by later losses: 70 is added to the first dividend after the realization.
#ASSERT `o valor a acrescer ao primeiro dividendo declarado depois da realização em reais (art. 202, inciso III)` 100 30 EQUALS 70
-- Boundary: all absorbed (100 of 100): 0.
#ASSERT `o valor a acrescer ao primeiro dividendo declarado depois da realização em reais (art. 202, inciso III)` 100 100 EQUALS 0
-- More absorbed than realized: never negative.
#ASSERT `o valor a acrescer ao primeiro dividendo declarado depois da realização em reais (art. 202, inciso III)` 100 150 EQUALS 0
-- Nothing absorbed: all of it.
#ASSERT `o valor a acrescer ao primeiro dividendo declarado depois da realização em reais (art. 202, inciso III)` 100 0 EQUALS 100

§§ `Testes do Art. 202, §§ 1º e 2º: critério do estatuto e mínimo de 25%`

#ASSERT `o critério do estatuto para o dividendo é válido (art. 202, § 1º)` TRUE FALSE
#ASSERT NOT (`o critério do estatuto para o dividendo é válido (art. 202, § 1º)` FALSE FALSE)
#ASSERT NOT (`o critério do estatuto para o dividendo é válido (art. 202, § 1º)` TRUE TRUE)
#ASSERT NOT (`o critério do estatuto para o dividendo é válido (art. 202, § 1º)` FALSE TRUE)
-- § 2º: adjusted profit 1000, so the floor is 25% of 1000 = 250. Exactly 250 is allowed; 249 is not; 300 is.
#ASSERT `o dividendo fixado ao alterar o estatuto omisso respeita o mínimo (art. 202, § 2º)` TRUE 250 1000 EQUALS JUST TRUE
#ASSERT `o dividendo fixado ao alterar o estatuto omisso respeita o mínimo (art. 202, § 2º)` TRUE 249 1000 EQUALS JUST FALSE
#ASSERT `o dividendo fixado ao alterar o estatuto omisso respeita o mínimo (art. 202, § 2º)` TRUE 300 1000 EQUALS JUST TRUE
-- Not the case the paragraph speaks of (the estatuto was not silent, or the meeting is not altering it): not covered.
#ASSERT `o dividendo fixado ao alterar o estatuto omisso respeita o mínimo (art. 202, § 2º)` FALSE 0 1000 EQUALS NOTHING

§§ `Testes do Art. 202, § 3º: dividendo inferior ao obrigatório`

-- Arguments: type, open company only for debentures, closed company controlled by an open one, that controller only for debentures, a shareholder present opposes.
#ASSERT `a assembleia-geral pode deliberar dividendo inferior ao obrigatório ou reter todo o lucro (art. 202, § 3º)` `companhia aberta` TRUE FALSE FALSE FALSE
#ASSERT NOT (`a assembleia-geral pode deliberar dividendo inferior ao obrigatório ou reter todo o lucro (art. 202, § 3º)` `companhia aberta` FALSE FALSE FALSE FALSE)
-- One shareholder present opposes: blocked, even for the company that qualifies.
#ASSERT NOT (`a assembleia-geral pode deliberar dividendo inferior ao obrigatório ou reter todo o lucro (art. 202, § 3º)` `companhia aberta` TRUE FALSE FALSE TRUE)
#ASSERT `a assembleia-geral pode deliberar dividendo inferior ao obrigatório ou reter todo o lucro (art. 202, § 3º)` `companhia fechada` FALSE FALSE FALSE FALSE
#ASSERT NOT (`a assembleia-geral pode deliberar dividendo inferior ao obrigatório ou reter todo o lucro (art. 202, § 3º)` `companhia fechada` FALSE FALSE FALSE TRUE)
-- Closed company controlled by an open company that is not of the inciso I kind: excluded.
#ASSERT NOT (`a assembleia-geral pode deliberar dividendo inferior ao obrigatório ou reter todo o lucro (art. 202, § 3º)` `companhia fechada` FALSE TRUE FALSE FALSE)
-- Closed company controlled by an open company of the inciso I kind: not excluded.
#ASSERT `a assembleia-geral pode deliberar dividendo inferior ao obrigatório ou reter todo o lucro (art. 202, § 3º)` `companhia fechada` FALSE TRUE TRUE FALSE

§§ `Testes do Art. 202, §§ 4º, 5º e 6º`

-- § 4º: not mandatory in the exercise when the administration informs the ordinary general meeting.
#ASSERT NOT (`o dividendo obrigatório é devido no exercício (art. 202, § 4º)` TRUE)
#ASSERT `o dividendo obrigatório é devido no exercício (art. 202, § 4º)` FALSE
-- The conselho fiscal, if in operation, gives an opinion.
#ASSERT `o conselho fiscal cumpriu o dever de dar parecer (art. 202, § 4º)` TRUE TRUE
#ASSERT NOT (`o conselho fiscal cumpriu o dever de dar parecer (art. 202, § 4º)` TRUE FALSE)
#ASSERT `o conselho fiscal cumpriu o dever de dar parecer (art. 202, § 4º)` FALSE FALSE
-- The CVM statement: 5 days from the meeting. 10 April + 5 = 15 April; 28 April + 5 = 3 May (April has 30 days).
#ASSERT `o último dia para os administradores enviarem a exposição à Comissão de Valores Mobiliários (art. 202, § 4º)` (YMD 2026 4 10) EQUALS (YMD 2026 4 15)
#ASSERT `o último dia para os administradores enviarem a exposição à Comissão de Valores Mobiliários (art. 202, § 4º)` (YMD 2026 4 28) EQUALS (YMD 2026 5 3)
-- Open company: sent on the last day (15 April) is in time, the day after (16 April) is late.
#ASSERT `os administradores cumpriram o dever de enviar a exposição à Comissão de Valores Mobiliários no prazo (art. 202, § 4º)` `companhia aberta` (YMD 2026 4 10) (YMD 2026 4 15)
#ASSERT NOT (`os administradores cumpriram o dever de enviar a exposição à Comissão de Valores Mobiliários no prazo (art. 202, § 4º)` `companhia aberta` (YMD 2026 4 10) (YMD 2026 4 16))
-- Sent on the day of the meeting itself: in time.
#ASSERT `os administradores cumpriram o dever de enviar a exposição à Comissão de Valores Mobiliários no prazo (art. 202, § 4º)` `companhia aberta` (YMD 2026 4 10) (YMD 2026 4 10)
-- A closed company owes the CVM nothing under this paragraph, so it is never late.
#ASSERT `os administradores cumpriram o dever de enviar a exposição à Comissão de Valores Mobiliários no prazo (art. 202, § 4º)` `companhia fechada` (YMD 2026 4 10) (YMD 2026 9 1)
-- § 5º: 1000 not distributed, 400 absorbed by later losses, the situation allows: 600 is payable.
#ASSERT `o valor da reserva especial a pagar como dividendo em reais (art. 202, § 5º)` 1000 400 TRUE EQUALS 600
-- The situation does not allow it yet: nothing is payable now.
#ASSERT `o valor da reserva especial a pagar como dividendo em reais (art. 202, § 5º)` 1000 400 FALSE EQUALS 0
-- Losses at or above the reserve (1000 and 1200): nothing is left to pay.
#ASSERT `o valor da reserva especial a pagar como dividendo em reais (art. 202, § 5º)` 1000 1000 TRUE EQUALS 0
#ASSERT `o valor da reserva especial a pagar como dividendo em reais (art. 202, § 5º)` 1000 1200 TRUE EQUALS 0
-- § 6º: net profit 1000; destined 50 (legal) + 100 (statutory) + 30 (contingency) + 20 (tax incentive) + 200 (retention) + 10 (to be realized) = 410; 1000 - 410 = 590 must be distributed.
`destinações de teste (art. 202, § 6º)` MEANS `Destinações do lucro líquido (arts. 193 a 197)` WITH
    `o valor destinado à reserva legal` IS 50
    `o valor destinado às reservas estatutárias` IS 100
    `o valor destinado à reserva para contingências` IS 30
    `o valor destinado à reserva de incentivos fiscais` IS 20
    `o valor retido nos termos do art. 196` IS 200
    `o valor destinado à reserva de lucros a realizar` IS 10
#ASSERT `os lucros não destinados que devem ser distribuídos como dividendos em reais (art. 202, § 6º)` 1000 `destinações de teste (art. 202, § 6º)` EQUALS 590
-- Boundary: profit equal to the destinations (410): nothing left. Below it (300): never negative.
#ASSERT `os lucros não destinados que devem ser distribuídos como dividendos em reais (art. 202, § 6º)` 410 `destinações de teste (art. 202, § 6º)` EQUALS 0
#ASSERT `os lucros não destinados que devem ser distribuídos como dividendos em reais (art. 202, § 6º)` 300 `destinações de teste (art. 202, § 6º)` EQUALS 0

§§ `Testes do Art. 202: o dividendo obrigatório é devido por inteiro?`

-- Arguments: type, open company only for debentures, closed company controlled by an open one, that controller only for debentures,
-- a shareholder present opposes, the meeting resolved on less, the administration informed the meeting of the incompatibility.
-- Nothing happened: due in full.
#ASSERT `o dividendo obrigatório é devido por inteiro no exercício (art. 202)` `companhia aberta` FALSE FALSE FALSE FALSE FALSE FALSE
-- A closed company, the meeting resolved on less, no one opposes: allowed, so not due in full.
#ASSERT NOT (`o dividendo obrigatório é devido por inteiro no exercício (art. 202)` `companhia fechada` FALSE FALSE FALSE FALSE TRUE FALSE)
-- The same, but a shareholder present opposes: the resolution is not allowed, so still due in full.
#ASSERT `o dividendo obrigatório é devido por inteiro no exercício (art. 202)` `companhia fechada` FALSE FALSE FALSE TRUE TRUE FALSE
-- An ordinary open company resolves on less: not allowed, still due in full.
#ASSERT `o dividendo obrigatório é devido por inteiro no exercício (art. 202)` `companhia aberta` FALSE FALSE FALSE FALSE TRUE FALSE
-- An open company formed only for debentures: allowed.
#ASSERT NOT (`o dividendo obrigatório é devido por inteiro no exercício (art. 202)` `companhia aberta` TRUE FALSE FALSE FALSE TRUE FALSE)
-- The administration informed the ordinary general meeting of incompatibility: not mandatory, whatever the company.
#ASSERT NOT (`o dividendo obrigatório é devido por inteiro no exercício (art. 202)` `companhia aberta` FALSE FALSE FALSE FALSE FALSE TRUE)

§ `Testes do Art. 203: dividendos de ações preferenciais`

`ações preferenciais de teste (art. 203)` MEANS `Participação do acionista` WITH
    `a espécie das ações` IS `ações preferenciais`
    `a forma das ações` IS `ações nominativas`
    `a quantidade de ações do acionista` IS 100
    `as ações do acionista estão integralizadas` IS TRUE
    `as ações do acionista têm valor nominal` IS FALSE

`ações ordinárias de teste (art. 203)` MEANS `Participação do acionista` WITH
    `a espécie das ações` IS `ações ordinárias`
    `a forma das ações` IS `ações nominativas`
    `a quantidade de ações do acionista` IS 100
    `as ações do acionista estão integralizadas` IS TRUE
    `as ações do acionista têm valor nominal` IS FALSE

-- Preferred shares with priority, fixed dividend 100, arrears 40, cumulative: 100 + 40 = 140.
#ASSERT `o dividendo fixo ou mínimo devido ao acionista preferencial em reais (art. 203)` `ações preferenciais de teste (art. 203)` TRUE 100 40 TRUE EQUALS JUST 140
-- Not cumulative: the arrears are not owed, only 100.
#ASSERT `o dividendo fixo ou mínimo devido ao acionista preferencial em reais (art. 203)` `ações preferenciais de teste (art. 203)` TRUE 100 40 FALSE EQUALS JUST 100
-- Cumulative but no arrears: 100.
#ASSERT `o dividendo fixo ou mínimo devido ao acionista preferencial em reais (art. 203)` `ações preferenciais de teste (art. 203)` TRUE 100 0 TRUE EQUALS JUST 100
-- Preferred shares with no priority to a fixed or minimum dividend: the Article says nothing.
#ASSERT `o dividendo fixo ou mínimo devido ao acionista preferencial em reais (art. 203)` `ações preferenciais de teste (art. 203)` FALSE 100 40 TRUE EQUALS NOTHING
-- Ordinary shares: the Article says nothing.
#ASSERT `o dividendo fixo ou mínimo devido ao acionista preferencial em reais (art. 203)` `ações ordinárias de teste (art. 203)` TRUE 100 40 TRUE EQUALS NOTHING

§ `Testes do Art. 204: dividendos intermediários`

#ASSERT `os órgãos de administração podem declarar dividendo à conta do balanço semestral (art. 204)` TRUE TRUE TRUE
#ASSERT NOT (`os órgãos de administração podem declarar dividendo à conta do balanço semestral (art. 204)` FALSE TRUE TRUE)
#ASSERT NOT (`os órgãos de administração podem declarar dividendo à conta do balanço semestral (art. 204)` TRUE FALSE TRUE)
#ASSERT NOT (`os órgãos de administração podem declarar dividendo à conta do balanço semestral (art. 204)` TRUE TRUE FALSE)

§§ `Testes do Art. 204, § 1º: períodos menores`

-- Capital reserves of Art. 182, § 1º: 100. Each half-year may pay up to 100.
#ASSERT `a companhia pode distribuir dividendos em períodos menores (art. 204, § 1º)` TRUE 100 100 100
#ASSERT `a companhia pode distribuir dividendos em períodos menores (art. 204, § 1º)` TRUE 0 0 0
#ASSERT NOT (`a companhia pode distribuir dividendos em períodos menores (art. 204, § 1º)` TRUE 101 50 100)
#ASSERT NOT (`a companhia pode distribuir dividendos em períodos menores (art. 204, § 1º)` TRUE 50 101 100)
-- Without a provision in the estatuto: not allowed.
#ASSERT NOT (`a companhia pode distribuir dividendos em períodos menores (art. 204, § 1º)` FALSE 50 50 100)

§§ `Testes do Art. 204, § 2º: dividendos intermediários à conta de lucros ou reservas`

#ASSERT `o estatuto pode autorizar o dividendo intermediário à conta da fonte (art. 204, § 2º)` `lucros acumulados (art. 201)` TRUE
#ASSERT `o estatuto pode autorizar o dividendo intermediário à conta da fonte (art. 204, § 2º)` `reserva de lucros (art. 201)` TRUE
-- Not existing in the last balance sheet: no.
#ASSERT NOT (`o estatuto pode autorizar o dividendo intermediário à conta da fonte (art. 204, § 2º)` `lucros acumulados (art. 201)` FALSE)
-- The paragraph names only accumulated profits and profit reserves.
#ASSERT NOT (`o estatuto pode autorizar o dividendo intermediário à conta da fonte (art. 204, § 2º)` `lucro líquido do exercício (art. 201)` TRUE)
#ASSERT NOT (`o estatuto pode autorizar o dividendo intermediário à conta da fonte (art. 204, § 2º)` `reserva de capital (art. 201)` TRUE)

§ `Testes do Art. 205: pagamento de dividendos`

-- Registered shares (nominativas) and shares in deposit accounts (escriturais): the person registered on the declaration date.
#ASSERT `a pessoa é quem recebe o dividendo declarado (art. 205)` `ações nominativas` TRUE EQUALS JUST TRUE
#ASSERT `a pessoa é quem recebe o dividendo declarado (art. 205)` `ações nominativas` FALSE EQUALS JUST FALSE
#ASSERT `a pessoa é quem recebe o dividendo declarado (art. 205)` `ações escriturais` TRUE EQUALS JUST TRUE
-- Endorsable and bearer shares: the Article speaks of "ações nominativas" only, so it does not answer.
#ASSERT `a pessoa é quem recebe o dividendo declarado (art. 205)` `ações endossáveis` TRUE EQUALS NOTHING
#ASSERT `a pessoa é quem recebe o dividendo declarado (art. 205)` `ações ao portador` TRUE EQUALS NOTHING

§§ `Testes do Art. 205, § 1º: meios de pagamento`

#ASSERT `o dividendo pode ser pago por esse meio (art. 205, § 1º)` `cheque nominativo remetido por via postal (art. 205, § 1º)` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o dividendo pode ser pago por esse meio (art. 205, § 1º)` `cheque nominativo remetido por via postal (art. 205, § 1º)` FALSE TRUE EQUALS JUST FALSE
#ASSERT `o dividendo pode ser pago por esse meio (art. 205, § 1º)` `crédito em conta-corrente bancária (art. 205, § 1º)` FALSE TRUE EQUALS JUST TRUE
#ASSERT `o dividendo pode ser pago por esse meio (art. 205, § 1º)` `crédito em conta-corrente bancária (art. 205, § 1º)` TRUE FALSE EQUALS JUST FALSE
-- Any other means: not covered.
#ASSERT `o dividendo pode ser pago por esse meio (art. 205, § 1º)` `qualquer outro meio de pagamento (art. 205, § 1º)` TRUE TRUE EQUALS NOTHING

§§ `Testes do Art. 205, § 2º: ações em custódia ou depósito`

#ASSERT `a quem a companhia paga o dividendo (art. 205, § 2º)` TRUE FALSE EQUALS `a instituição financeira`
#ASSERT `a quem a companhia paga o dividendo (art. 205, § 2º)` FALSE TRUE EQUALS `a instituição financeira`
#ASSERT `a quem a companhia paga o dividendo (art. 205, § 2º)` FALSE FALSE EQUALS `o acionista`

§§ `Testes do Art. 205, § 3º: prazo de pagamento`

-- Declared 1 March; no other term; the exercise ends 31 December. 1 March + 60 days = 30 April (30 days to 31 March, 30 more to 30 April).
#ASSERT `o último dia para pagar o dividendo (art. 205, § 3º)` (YMD 2026 3 1) FALSE (YMD 2026 1 1) (YMD 2026 12 31) EQUALS (YMD 2026 4 30)
-- Declared 15 November: 15 Nov + 60 days would be 14 January 2027, past the end of the exercise, so the exercise end (31 December) caps it.
#ASSERT `o último dia para pagar o dividendo (art. 205, § 3º)` (YMD 2026 11 15) FALSE (YMD 2026 1 1) (YMD 2026 12 31) EQUALS (YMD 2026 12 31)
-- Boundary: declared 1 November: 1 Nov + 60 days = 31 December exactly (29 days to 30 Nov, 31 more to 31 Dec), the same as the exercise end.
#ASSERT `o último dia para pagar o dividendo (art. 205, § 3º)` (YMD 2026 11 1) FALSE (YMD 2026 1 1) (YMD 2026 12 31) EQUALS (YMD 2026 12 31)
-- The meeting resolves otherwise and fixes 15 June: that is the date.
#ASSERT `o último dia para pagar o dividendo (art. 205, § 3º)` (YMD 2026 3 1) TRUE (YMD 2026 6 15) (YMD 2026 12 31) EQUALS (YMD 2026 6 15)
-- The meeting fixes a date past the exercise end (1 February 2027): "em qualquer caso" the exercise end caps it.
#ASSERT `o último dia para pagar o dividendo (art. 205, § 3º)` (YMD 2026 3 1) TRUE (YMD 2027 2 1) (YMD 2026 12 31) EQUALS (YMD 2026 12 31)
-- Paid in time or late: declared 1 March, last day 30 April.
#ASSERT `o dividendo foi pago no prazo (art. 205, § 3º)` (YMD 2026 3 1) (YMD 2026 4 30) FALSE (YMD 2026 1 1) (YMD 2026 12 31)
#ASSERT NOT (`o dividendo foi pago no prazo (art. 205, § 3º)` (YMD 2026 3 1) (YMD 2026 5 1) FALSE (YMD 2026 1 1) (YMD 2026 12 31))
-- Declared 15 November: the exercise end caps it, so paying on 31 December is in time and 1 January 2027 is late.
