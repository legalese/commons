IMPORT prelude
IMPORT `br-core`
IMPORT `br4-conselho-de-administracao`

-- br4-tests-conselho-de-administracao.l4 -- tests of br4-conselho-de-administracao.l4 (arts. 140 to 142).
-- Every expected value was decided from the text of the article, written beside the assertion, and then run.

§ `Testes do art. 140`

`[teste br4] estatuto do conselho: tudo em ordem` MEANS `Estatuto quanto ao conselho de administração (art. 140)` WITH
    `o estatuto fixa o número de conselheiros, ou o máximo e o mínimo permitidos` IS TRUE
    `o estatuto estabelece o processo de escolha e substituição do presidente do conselho, pela assembleia ou pelo próprio conselho` IS TRUE
    `o estatuto estabelece o modo de substituição dos conselheiros` IS TRUE
    `a quantidade de anos do prazo de gestão fixado no estatuto` IS 3
    `o estatuto veda a reeleição dos conselheiros` IS FALSE
    `o estatuto estabelece as normas sobre convocação, instalação e funcionamento do conselho` IS TRUE
    `o conselho delibera por maioria de votos` IS TRUE
    `o estatuto estabelece quórum qualificado para certas deliberações` IS FALSE
    `o estatuto especifica as matérias sujeitas a quórum qualificado` IS FALSE

`[teste br4] estatuto do conselho: sem número nem processo do presidente` MEANS `Estatuto quanto ao conselho de administração (art. 140)` WITH
    `o estatuto fixa o número de conselheiros, ou o máximo e o mínimo permitidos` IS FALSE
    `o estatuto estabelece o processo de escolha e substituição do presidente do conselho, pela assembleia ou pelo próprio conselho` IS TRUE
    `o estatuto estabelece o modo de substituição dos conselheiros` IS FALSE
    `a quantidade de anos do prazo de gestão fixado no estatuto` IS 4
    `o estatuto veda a reeleição dos conselheiros` IS TRUE
    `o estatuto estabelece as normas sobre convocação, instalação e funcionamento do conselho` IS TRUE
    `o conselho delibera por maioria de votos` IS FALSE
    `o estatuto estabelece quórum qualificado para certas deliberações` IS TRUE
    `o estatuto especifica as matérias sujeitas a quórum qualificado` IS FALSE

`[teste br4] estatuto do conselho: quórum qualificado com as matérias especificadas` MEANS `Estatuto quanto ao conselho de administração (art. 140)` WITH
    `o estatuto fixa o número de conselheiros, ou o máximo e o mínimo permitidos` IS TRUE
    `o estatuto estabelece o processo de escolha e substituição do presidente do conselho, pela assembleia ou pelo próprio conselho` IS TRUE
    `o estatuto estabelece o modo de substituição dos conselheiros` IS TRUE
    `a quantidade de anos do prazo de gestão fixado no estatuto` IS 1
    `o estatuto veda a reeleição dos conselheiros` IS FALSE
    `o estatuto estabelece as normas sobre convocação, instalação e funcionamento do conselho` IS TRUE
    `o conselho delibera por maioria de votos` IS TRUE
    `o estatuto estabelece quórum qualificado para certas deliberações` IS TRUE
    `o estatuto especifica as matérias sujeitas a quórum qualificado` IS TRUE

-- caput: at least 3 members.
#ASSERT `o conselho de administração tem o número mínimo de membros (art. 140)` 3
#ASSERT `o conselho de administração tem o número mínimo de membros (art. 140)` 7
#ASSERT NOT (`o conselho de administração tem o número mínimo de membros (art. 140)` 2)
-- caput: elected and dismissed by the assembleia-geral; for one not elected by it the text says nothing.
#ASSERT `quem elege e destitui os conselheiros (art. 140)` EQUALS `a assembleia-geral`
#ASSERT `a assembleia-geral pode destituir o conselheiro a qualquer tempo (art. 140)` TRUE EQUALS JUST TRUE
#ASSERT `a assembleia-geral pode destituir o conselheiro a qualquer tempo (art. 140)` FALSE EQUALS NOTHING
-- incisos I to IV.
#ASSERT `o estatuto cumpre o inciso I (art. 140, inciso I)` `[teste br4] estatuto do conselho: tudo em ordem`
#ASSERT NOT (`o estatuto cumpre o inciso I (art. 140, inciso I)` `[teste br4] estatuto do conselho: sem número nem processo do presidente`)
#ASSERT `o estatuto cumpre o inciso II (art. 140, inciso II)` `[teste br4] estatuto do conselho: tudo em ordem`
#ASSERT NOT (`o estatuto cumpre o inciso II (art. 140, inciso II)` `[teste br4] estatuto do conselho: sem número nem processo do presidente`)
-- inciso III: 3 years is the last year allowed, 4 is over; a ban on re-election is not allowed.
#ASSERT `o estatuto cumpre o inciso III (art. 140, inciso III)` `[teste br4] estatuto do conselho: tudo em ordem`
#ASSERT NOT (`o estatuto cumpre o inciso III (art. 140, inciso III)` `[teste br4] estatuto do conselho: sem número nem processo do presidente`)
#ASSERT `o estatuto cumpre o inciso III (art. 140, inciso III)` `[teste br4] estatuto do conselho: quórum qualificado com as matérias especificadas`
-- inciso IV: majority of votes; a qualified quorum only if the matters are specified.
#ASSERT `o estatuto cumpre o inciso IV (art. 140, inciso IV)` `[teste br4] estatuto do conselho: tudo em ordem`
#ASSERT `o estatuto cumpre o inciso IV (art. 140, inciso IV)` `[teste br4] estatuto do conselho: quórum qualificado com as matérias especificadas`
#ASSERT NOT (`o estatuto cumpre o inciso IV (art. 140, inciso IV)` `[teste br4] estatuto do conselho: sem número nem processo do presidente`)
-- all four together.
#ASSERT `o estatuto dispõe sobre o conselho como a lei exige (art. 140)` `[teste br4] estatuto do conselho: tudo em ordem`
#ASSERT `o estatuto dispõe sobre o conselho como a lei exige (art. 140)` `[teste br4] estatuto do conselho: quórum qualificado com as matérias especificadas`
#ASSERT NOT (`o estatuto dispõe sobre o conselho como a lei exige (art. 140)` `[teste br4] estatuto do conselho: sem número nem processo do presidente`)
-- § 1º: employees' representatives: all three conditions.
#ASSERT `o estatuto pode prever representantes dos empregados no conselho (art. 140, § 1º)` TRUE TRUE TRUE
#ASSERT NOT (`o estatuto pode prever representantes dos empregados no conselho (art. 140, § 1º)` FALSE TRUE TRUE)
#ASSERT NOT (`o estatuto pode prever representantes dos empregados no conselho (art. 140, § 1º)` TRUE FALSE TRUE)
#ASSERT NOT (`o estatuto pode prever representantes dos empregados no conselho (art. 140, § 1º)` TRUE TRUE FALSE)
-- § 2º: independent conselheiros are mandatory in an open company only; the Law leaves the terms to the CVM.
#ASSERT `é obrigatória a participação de conselheiros independentes (art. 140, § 2º)` `companhia aberta`
#ASSERT NOT (`é obrigatória a participação de conselheiros independentes (art. 140, § 2º)` `companhia fechada`)
#ASSERT `a composição do conselho atende à exigência de conselheiros independentes (art. 140, § 2º)` `companhia aberta` FALSE FALSE EQUALS NOTHING
#ASSERT `a composição do conselho atende à exigência de conselheiros independentes (art. 140, § 2º)` `companhia aberta` TRUE TRUE EQUALS JUST TRUE
#ASSERT `a composição do conselho atende à exigência de conselheiros independentes (art. 140, § 2º)` `companhia aberta` TRUE FALSE EQUALS JUST FALSE
#ASSERT `a composição do conselho atende à exigência de conselheiros independentes (art. 140, § 2º)` `companhia fechada` FALSE FALSE EQUALS JUST TRUE

#ASSERT `o conselheiro conta como independente (art. 140, § 2º)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o conselheiro conta como independente (art. 140, § 2º)` FALSE TRUE EQUALS JUST FALSE
#ASSERT `o conselheiro conta como independente (art. 140, § 2º)` TRUE FALSE EQUALS NOTHING

§ `Testes do art. 141`

-- caput: 10% of the shares with the right to vote (10 of 100 is enough, 9 of 100 is not).
#ASSERT `os acionistas podem requerer o voto múltiplo (art. 141)` 10 100
#ASSERT NOT (`os acionistas podem requerer o voto múltiplo (art. 141)` 9 100)
#ASSERT `os acionistas podem requerer o voto múltiplo (art. 141)` 1 10
#ASSERT `a quantidade de votos de cada ação no voto múltiplo (art. 141)` 1 5 EQUALS 5
#ASSERT `a quantidade de votos de cada ação no voto múltiplo (art. 141)` 2 5 EQUALS 10
-- accumulate on one candidate or spread (an allocation over the total is not valid; a negative one is not).
#ASSERT `a distribuição dos votos entre os candidatos é válida (art. 141)` (LIST 6, 4) 10
#ASSERT `a distribuição dos votos entre os candidatos é válida (art. 141)` (LIST 10) 10
#ASSERT `a distribuição dos votos entre os candidatos é válida (art. 141)` (LIST 5, 4) 10
#ASSERT NOT (`a distribuição dos votos entre os candidatos é válida (art. 141)` (LIST 6, 5) 10)
#ASSERT NOT (`a distribuição dos votos entre os candidatos é válida (art. 141)` (LIST 12, 0 MINUS 2) 10)
-- § 1º: 48 hours before the assembly.
#ASSERT `o requerimento do voto múltiplo foi feito no prazo (art. 141, § 1º)` 48
#ASSERT `o requerimento do voto múltiplo foi feito no prazo (art. 141, § 1º)` 100
#ASSERT NOT (`o requerimento do voto múltiplo foi feito no prazo (art. 141, § 1º)` 47)
#ASSERT `a mesa cumpriu o dever de informar os votos necessários (art. 141, § 1º)` TRUE TRUE TRUE
#ASSERT NOT (`a mesa cumpriu o dever de informar os votos necessários (art. 141, § 1º)` TRUE FALSE TRUE)
#ASSERT NOT (`a mesa cumpriu o dever de informar os votos necessários (art. 141, § 1º)` TRUE TRUE FALSE)
#ASSERT NOT (`a mesa cumpriu o dever de informar os votos necessários (art. 141, § 1º)` FALSE TRUE TRUE)
-- § 2º: a post left empty by a tie goes to a new vote.
#ASSERT `o cargo deve ser objeto de nova votação pelo mesmo processo (art. 141, § 2º)` TRUE TRUE
#ASSERT NOT (`o cargo deve ser objeto de nova votação pelo mesmo processo (art. 141, § 2º)` TRUE FALSE)
#ASSERT NOT (`o cargo deve ser objeto de nova votação pelo mesmo processo (art. 141, § 2º)` FALSE TRUE)
-- § 3º: multiple vote and dismissal by the assembly takes the whole board down; any other vacancy with no
-- alternate sends the whole board to the first assembly; otherwise the paragraph is silent.
#ASSERT `a consequência da vaga no conselho (art. 141, § 3º)` TRUE TRUE FALSE EQUALS JUST `destituição dos demais membros e nova eleição (art. 141, § 3º)`
#ASSERT `a consequência da vaga no conselho (art. 141, § 3º)` FALSE TRUE FALSE EQUALS JUST `nova eleição de todo o conselho na primeira assembleia-geral (art. 141, § 3º)`
#ASSERT `a consequência da vaga no conselho (art. 141, § 3º)` TRUE FALSE FALSE EQUALS JUST `nova eleição de todo o conselho na primeira assembleia-geral (art. 141, § 3º)`
#ASSERT `a consequência da vaga no conselho (art. 141, § 3º)` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `a consequência da vaga no conselho (art. 141, § 3º)` FALSE TRUE TRUE EQUALS NOTHING
-- § 4º, inciso I: open company, 15% of the voting shares, no controlling shareholder in the group.
#ASSERT `o grupo de acionistas com direito a voto atinge o quórum para eleger um membro em separado (art. 141, § 4º, inciso I)` `companhia aberta` 15 100 FALSE
#ASSERT NOT (`o grupo de acionistas com direito a voto atinge o quórum para eleger um membro em separado (art. 141, § 4º, inciso I)` `companhia aberta` 14 100 FALSE)
#ASSERT NOT (`o grupo de acionistas com direito a voto atinge o quórum para eleger um membro em separado (art. 141, § 4º, inciso I)` `companhia fechada` 15 100 FALSE)
#ASSERT NOT (`o grupo de acionistas com direito a voto atinge o quórum para eleger um membro em separado (art. 141, § 4º, inciso I)` `companhia aberta` 60 100 TRUE)
-- § 4º, inciso II: 10% of the capital by value, and the right of the estatuto (art. 18) not yet used.
#ASSERT `o grupo de preferencialistas sem voto ou com voto restrito atinge o quórum para eleger um membro em separado (art. 141, § 4º, inciso II)` `companhia aberta` 10 100 FALSE FALSE
#ASSERT NOT (`o grupo de preferencialistas sem voto ou com voto restrito atinge o quórum para eleger um membro em separado (art. 141, § 4º, inciso II)` `companhia aberta` 9 100 FALSE FALSE)
#ASSERT NOT (`o grupo de preferencialistas sem voto ou com voto restrito atinge o quórum para eleger um membro em separado (art. 141, § 4º, inciso II)` `companhia aberta` 10 100 TRUE FALSE)
#ASSERT NOT (`o grupo de preferencialistas sem voto ou com voto restrito atinge o quórum para eleger um membro em separado (art. 141, § 4º, inciso II)` `companhia fechada` 10 100 FALSE FALSE)
-- § 4º: "a maioria dos titulares" read as more than half of the group's shares (fork F6): 51 of 100, not 50 of 100.
#ASSERT `a maioria do grupo elege o candidato em votação em separado (art. 141, § 4º)` 51 100
#ASSERT NOT (`a maioria do grupo elege o candidato em votação em separado (art. 141, § 4º)` 50 100)
-- § 5º: neither quorum reached, together at least 10% of the capital.
#ASSERT `os dois grupos podem somar suas ações para eleger em conjunto um membro (art. 141, § 5º)` FALSE FALSE 10 100
#ASSERT NOT (`os dois grupos podem somar suas ações para eleger em conjunto um membro (art. 141, § 5º)` FALSE FALSE 9 100)
#ASSERT NOT (`os dois grupos podem somar suas ações para eleger em conjunto um membro (art. 141, § 5º)` TRUE FALSE 20 100)
#ASSERT NOT (`os dois grupos podem somar suas ações para eleger em conjunto um membro (art. 141, § 5º)` FALSE TRUE 20 100)
-- § 6º: 3 months of uninterrupted ownership before the assembly of 10 April 2026 (convention F1/F2 of the core).
#ASSERT `o acionista pode exercer o direito do § 4º quanto ao tempo de titularidade (art. 141, § 6º)` (YearMonthDay 2026 1 10) (YearMonthDay 2026 4 10)
#ASSERT NOT (`o acionista pode exercer o direito do § 4º quanto ao tempo de titularidade (art. 141, § 6º)` (YearMonthDay 2026 1 11) (YearMonthDay 2026 4 10))
#ASSERT `o acionista pode exercer o direito do § 4º quanto ao tempo de titularidade (art. 141, § 6º)` (YearMonthDay 2025 12 1) (YearMonthDay 2026 4 10)
-- § 7º: the majority holder elects as many as all the others plus one (2 others: 3), only on the cumulative conditions.
#ASSERT `a quantidade de conselheiros que o acionista majoritário pode eleger (art. 141, § 7º)` TRUE TRUE 51 100 2 EQUALS JUST 3
#ASSERT `a quantidade de conselheiros que o acionista majoritário pode eleger (art. 141, § 7º)` TRUE TRUE 50 100 2 EQUALS NOTHING
#ASSERT `a quantidade de conselheiros que o acionista majoritário pode eleger (art. 141, § 7º)` FALSE TRUE 51 100 2 EQUALS NOTHING
#ASSERT `a quantidade de conselheiros que o acionista majoritário pode eleger (art. 141, § 7º)` TRUE FALSE 51 100 2 EQUALS NOTHING
-- § 8º: register of the shareholders who use § 4º.
#ASSERT `a companhia cumpre o dever de manter o registro dos acionistas (art. 141, § 8º)` FALSE FALSE
#ASSERT `a companhia cumpre o dever de manter o registro dos acionistas (art. 141, § 8º)` TRUE TRUE
#ASSERT NOT (`a companhia cumpre o dever de manter o registro dos acionistas (art. 141, § 8º)` TRUE FALSE)

§ `Testes do art. 142`

`[teste br4] atribuições: estatuto comum` MEANS `Estatuto quanto às atribuições do conselho de administração (art. 142)` WITH
    `o estatuto exige a manifestação prévia do conselho sobre atos ou contratos` IS FALSE
    `o estatuto autoriza o conselho a deliberar sobre a emissão de ações ou de bônus de subscrição` IS FALSE
    `o estatuto dispõe em contrário sobre a autorização de alienação de bens, ônus reais e garantias` IS FALSE
    `a companhia tem auditores independentes` IS FALSE

`[teste br4] atribuições: estatuto que exige, autoriza e dispõe em contrário, com auditores` MEANS `Estatuto quanto às atribuições do conselho de administração (art. 142)` WITH
    `o estatuto exige a manifestação prévia do conselho sobre atos ou contratos` IS TRUE
    `o estatuto autoriza o conselho a deliberar sobre a emissão de ações ou de bônus de subscrição` IS TRUE
    `o estatuto dispõe em contrário sobre a autorização de alienação de bens, ônus reais e garantias` IS TRUE
    `a companhia tem auditores independentes` IS TRUE

-- incisos I to V belong to the board without condition.
#ASSERT `a atribuição compete ao conselho de administração (art. 142)` `fixar a orientação geral dos negócios da companhia (art. 142, inciso I)` TRUE `[teste br4] atribuições: estatuto comum`
#ASSERT `a atribuição compete ao conselho de administração (art. 142)` `eleger e destituir os diretores e fixar-lhes as atribuições (art. 142, inciso II)` TRUE `[teste br4] atribuições: estatuto comum`
#ASSERT `a atribuição compete ao conselho de administração (art. 142)` `fiscalizar a gestão dos diretores, examinar livros e papéis e solicitar informações (art. 142, inciso III)` TRUE `[teste br4] atribuições: estatuto comum`
#ASSERT `a atribuição compete ao conselho de administração (art. 142)` `convocar a assembleia-geral (art. 142, inciso IV)` TRUE `[teste br4] atribuições: estatuto comum`
#ASSERT `a atribuição compete ao conselho de administração (art. 142)` `manifestar-se sobre o relatório da administração e as contas da diretoria (art. 142, inciso V)` TRUE `[teste br4] atribuições: estatuto comum`
-- inciso VI only if the estatuto requires it; VII only if it authorises; VIII unless it says otherwise; IX if there are auditors.
#ASSERT NOT (`a atribuição compete ao conselho de administração (art. 142)` `manifestar-se previamente sobre atos ou contratos quando o estatuto exigir (art. 142, inciso VI)` TRUE `[teste br4] atribuições: estatuto comum`)
#ASSERT `a atribuição compete ao conselho de administração (art. 142)` `manifestar-se previamente sobre atos ou contratos quando o estatuto exigir (art. 142, inciso VI)` TRUE `[teste br4] atribuições: estatuto que exige, autoriza e dispõe em contrário, com auditores`
#ASSERT NOT (`a atribuição compete ao conselho de administração (art. 142)` `deliberar sobre a emissão de ações ou de bônus de subscrição quando autorizado pelo estatuto (art. 142, inciso VII)` TRUE `[teste br4] atribuições: estatuto comum`)
#ASSERT `a atribuição compete ao conselho de administração (art. 142)` `deliberar sobre a emissão de ações ou de bônus de subscrição quando autorizado pelo estatuto (art. 142, inciso VII)` TRUE `[teste br4] atribuições: estatuto que exige, autoriza e dispõe em contrário, com auditores`
#ASSERT `a atribuição compete ao conselho de administração (art. 142)` `autorizar a alienação de bens do ativo não circulante, ônus reais e garantias a obrigações de terceiros (art. 142, inciso VIII)` TRUE `[teste br4] atribuições: estatuto comum`
#ASSERT NOT (`a atribuição compete ao conselho de administração (art. 142)` `autorizar a alienação de bens do ativo não circulante, ônus reais e garantias a obrigações de terceiros (art. 142, inciso VIII)` TRUE `[teste br4] atribuições: estatuto que exige, autoriza e dispõe em contrário, com auditores`)
#ASSERT NOT (`a atribuição compete ao conselho de administração (art. 142)` `escolher e destituir os auditores independentes (art. 142, inciso IX)` TRUE `[teste br4] atribuições: estatuto comum`)
#ASSERT `a atribuição compete ao conselho de administração (art. 142)` `escolher e destituir os auditores independentes (art. 142, inciso IX)` TRUE `[teste br4] atribuições: estatuto que exige, autoriza e dispõe em contrário, com auditores`
-- a company with no board has no such attribution.
#ASSERT NOT (`a atribuição compete ao conselho de administração (art. 142)` `fixar a orientação geral dos negócios da companhia (art. 142, inciso I)` FALSE `[teste br4] atribuições: estatuto comum`)
-- §§ 1º and 2º.
#ASSERT `a ata da reunião do conselho deve ser arquivada no registro do comércio e publicada (art. 142, § 1º)` TRUE
#ASSERT NOT (`a ata da reunião do conselho deve ser arquivada no registro do comércio e publicada (art. 142, § 1º)` FALSE)
#ASSERT `o veto dos conselheiros eleitos em separado é admissível (art. 142, § 2º)` TRUE TRUE TRUE
#ASSERT NOT (`o veto dos conselheiros eleitos em separado é admissível (art. 142, § 2º)` FALSE TRUE TRUE)
#ASSERT NOT (`o veto dos conselheiros eleitos em separado é admissível (art. 142, § 2º)` TRUE FALSE TRUE)
#ASSERT NOT (`o veto dos conselheiros eleitos em separado é admissível (art. 142, § 2º)` TRUE TRUE FALSE)

