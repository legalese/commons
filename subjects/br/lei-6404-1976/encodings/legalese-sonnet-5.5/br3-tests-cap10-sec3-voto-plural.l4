-- § 14: the article does not apply to public companies, mixed-economy companies, their subsidiaries or companies the
-- State controls.
`perfil de companhia comum (teste art. 110-A, § 14)` MEANS `Perfil da companhia` WITH
    `o tipo da companhia` IS `companhia fechada`
    `a companhia tem conselho de administração` IS FALSE
    `a companhia tem conselho fiscal permanente` IS FALSE
    `a companhia tem capital autorizado` IS FALSE
    `a companhia é de economia mista` IS FALSE

`perfil de companhia de economia mista (teste art. 110-A, § 14)` MEANS `Perfil da companhia` WITH
    `o tipo da companhia` IS `companhia aberta`
    `a companhia tem conselho de administração` IS TRUE
    `a companhia tem conselho fiscal permanente` IS FALSE
    `a companhia tem capital autorizado` IS FALSE
    `a companhia é de economia mista` IS TRUE

#ASSERT `as disposições sobre o voto plural se aplicam à companhia (art. 110-A, § 14)` `perfil de companhia comum (teste art. 110-A, § 14)` FALSE FALSE FALSE
#ASSERT NOT (`as disposições sobre o voto plural se aplicam à companhia (art. 110-A, § 14)` `perfil de companhia comum (teste art. 110-A, § 14)` TRUE FALSE FALSE)
#ASSERT NOT (`as disposições sobre o voto plural se aplicam à companhia (art. 110-A, § 14)` `perfil de companhia comum (teste art. 110-A, § 14)` FALSE TRUE FALSE)
#ASSERT NOT (`as disposições sobre o voto plural se aplicam à companhia (art. 110-A, § 14)` `perfil de companhia comum (teste art. 110-A, § 14)` FALSE FALSE TRUE)
#ASSERT NOT (`as disposições sobre o voto plural se aplicam à companhia (art. 110-A, § 14)` `perfil de companhia de economia mista (teste art. 110-A, § 14)` FALSE FALSE FALSE)

