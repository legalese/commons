#ASSERT `a assembleia-geral pode delegar ao conselho de administração a fixação do preço de emissão (art. 170, § 2º)` TRUE TRUE
#ASSERT NOT (`a assembleia-geral pode delegar ao conselho de administração a fixação do preço de emissão (art. 170, § 2º)` TRUE FALSE)
#ASSERT NOT (`a assembleia-geral pode delegar ao conselho de administração a fixação do preço de emissão (art. 170, § 2º)` FALSE TRUE)
#ASSERT `a subscrição em bens cumpre a lei (art. 170, § 3º)` FALSE FALSE FALSE
#ASSERT `a subscrição em bens cumpre a lei (art. 170, § 3º)` TRUE TRUE TRUE
#ASSERT NOT (`a subscrição em bens cumpre a lei (art. 170, § 3º)` TRUE TRUE FALSE)
#ASSERT NOT (`a subscrição em bens cumpre a lei (art. 170, § 3º)` TRUE FALSE TRUE)
#ASSERT `a companhia pode receber as entradas independentemente de depósito bancário (art. 170, § 4º)`
#ASSERT `a subscrição cumpre o rito da lei (art. 170, § 5º)` TRUE TRUE FALSE
#ASSERT NOT (`a subscrição cumpre o rito da lei (art. 170, § 5º)` TRUE FALSE TRUE)
#ASSERT `a subscrição cumpre o rito da lei (art. 170, § 5º)` FALSE FALSE TRUE
#ASSERT NOT (`a subscrição cumpre o rito da lei (art. 170, § 5º)` FALSE TRUE FALSE)
