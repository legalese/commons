IMPORT prelude
IMPORT `br-core`
IMPORT `br4-aumento-de-capital`

-- br4-tests-aumento-de-capital.l4 -- tests of br4-aumento-de-capital.l4 (arts. 166 to 172).
-- Every expected value was decided from the text of the article, written beside the assertion, and then run.

§ `Perfis para os testes`

`[teste br4] perfil: aberta, com capital autorizado` MEANS `Perfil da companhia` WITH
    `o tipo da companhia` IS `companhia aberta`
    `a companhia tem conselho de administração` IS TRUE
    `a companhia tem conselho fiscal permanente` IS FALSE
    `a companhia tem capital autorizado` IS TRUE
    `a companhia é de economia mista` IS FALSE

`[teste br4] perfil: aberta, sem capital autorizado` MEANS `Perfil da companhia` WITH
    `o tipo da companhia` IS `companhia aberta`
    `a companhia tem conselho de administração` IS TRUE
    `a companhia tem conselho fiscal permanente` IS FALSE
    `a companhia tem capital autorizado` IS FALSE
    `a companhia é de economia mista` IS FALSE

`[teste br4] perfil: fechada, com capital autorizado` MEANS `Perfil da companhia` WITH
    `o tipo da companhia` IS `companhia fechada`
    `a companhia tem conselho de administração` IS FALSE
    `a companhia tem conselho fiscal permanente` IS FALSE
    `a companhia tem capital autorizado` IS TRUE
    `a companhia é de economia mista` IS FALSE

§ `Testes do art. 166`

-- I: the ordinary general meeting, for monetary correction.
#ASSERT `o aumento por correção monetária pode ser deliberado pela assembleia (art. 166, inciso I)` `assembleia-geral ordinária` TRUE
#ASSERT NOT (`o aumento por correção monetária pode ser deliberado pela assembleia (art. 166, inciso I)` `assembleia-geral extraordinária` TRUE)
#ASSERT NOT (`o aumento por correção monetária pode ser deliberado pela assembleia (art. 166, inciso I)` `assembleia-geral ordinária` FALSE)
-- II: authorised capital, within the limit, an organ the estatuto names, the meeting or the board.
#ASSERT `o aumento por emissão dentro do limite autorizado pode ser deliberado pelo órgão (art. 166, inciso II)` `[teste br4] perfil: aberta, com capital autorizado` `o conselho de administração` TRUE TRUE
#ASSERT `o aumento por emissão dentro do limite autorizado pode ser deliberado pelo órgão (art. 166, inciso II)` `[teste br4] perfil: aberta, com capital autorizado` `a assembleia-geral` TRUE TRUE
#ASSERT NOT (`o aumento por emissão dentro do limite autorizado pode ser deliberado pelo órgão (art. 166, inciso II)` `[teste br4] perfil: aberta, com capital autorizado` `a diretoria` TRUE TRUE)
#ASSERT NOT (`o aumento por emissão dentro do limite autorizado pode ser deliberado pelo órgão (art. 166, inciso II)` `[teste br4] perfil: aberta, com capital autorizado` `o conselho de administração` FALSE TRUE)
#ASSERT NOT (`o aumento por emissão dentro do limite autorizado pode ser deliberado pelo órgão (art. 166, inciso II)` `[teste br4] perfil: aberta, com capital autorizado` `o conselho de administração` TRUE FALSE)
#ASSERT NOT (`o aumento por emissão dentro do limite autorizado pode ser deliberado pelo órgão (art. 166, inciso II)` `[teste br4] perfil: aberta, sem capital autorizado` `o conselho de administração` TRUE TRUE)
-- III.
#ASSERT `o aumento por conversão ou exercício de direitos é admitido (art. 166, inciso III)` TRUE
#ASSERT NOT (`o aumento por conversão ou exercício de direitos é admitido (art. 166, inciso III)` FALSE)
-- IV: the extraordinary meeting convened to reform the estatuto, if there is no authorisation or it is exhausted.
#ASSERT `o aumento por reforma do estatuto pode ser deliberado pela assembleia (art. 166, inciso IV)` `assembleia-geral extraordinária` TRUE `[teste br4] perfil: aberta, sem capital autorizado` FALSE
#ASSERT `o aumento por reforma do estatuto pode ser deliberado pela assembleia (art. 166, inciso IV)` `assembleia-geral extraordinária` TRUE `[teste br4] perfil: aberta, com capital autorizado` TRUE
#ASSERT NOT (`o aumento por reforma do estatuto pode ser deliberado pela assembleia (art. 166, inciso IV)` `assembleia-geral extraordinária` TRUE `[teste br4] perfil: aberta, com capital autorizado` FALSE)
#ASSERT NOT (`o aumento por reforma do estatuto pode ser deliberado pela assembleia (art. 166, inciso IV)` `assembleia-geral ordinária` TRUE `[teste br4] perfil: aberta, sem capital autorizado` FALSE)
#ASSERT NOT (`o aumento por reforma do estatuto pode ser deliberado pela assembleia (art. 166, inciso IV)` `assembleia-geral extraordinária` FALSE `[teste br4] perfil: aberta, sem capital autorizado` FALSE)
-- § 1º: annotation for I to III, filing of the minutes for IV; 30 days from 1 March 2026.
#ASSERT `a providência que a companhia requer ao registro do comércio (art. 166, § 1º)` `aumento por correção da expressão monetária do capital (art. 166, inciso I)` EQUALS `averbação do aumento (art. 166, § 1º)`
#ASSERT `a providência que a companhia requer ao registro do comércio (art. 166, § 1º)` `aumento por emissão de ações dentro do limite autorizado no estatuto (art. 166, inciso II)` EQUALS `averbação do aumento (art. 166, § 1º)`
#ASSERT `a providência que a companhia requer ao registro do comércio (art. 166, § 1º)` `aumento por conversão em ações ou exercício de direitos de subscrição ou de compra (art. 166, inciso III)` EQUALS `averbação do aumento (art. 166, § 1º)`
#ASSERT `a providência que a companhia requer ao registro do comércio (art. 166, § 1º)` `aumento por reforma do estatuto social (art. 166, inciso IV)` EQUALS `arquivamento da ata da assembleia de reforma do estatuto (art. 166, § 1º)`
#ASSERT `o requerimento ao registro do comércio foi feito no prazo (art. 166, § 1º)` (YearMonthDay 2026 3 1) (YearMonthDay 2026 3 31)
#ASSERT NOT (`o requerimento ao registro do comércio foi feito no prazo (art. 166, § 1º)` (YearMonthDay 2026 3 1) (YearMonthDay 2026 4 1))
#ASSERT NOT (`o requerimento ao registro do comércio foi feito no prazo (art. 166, § 1º)` (YearMonthDay 2026 3 1) (YearMonthDay 2026 2 28))
-- § 2º: the council, if in operation, except in III.
#ASSERT `o conselho fiscal deve ser ouvido antes da deliberação (art. 166, § 2º)` `aumento por reforma do estatuto social (art. 166, inciso IV)` TRUE
#ASSERT `o conselho fiscal deve ser ouvido antes da deliberação (art. 166, § 2º)` `aumento por correção da expressão monetária do capital (art. 166, inciso I)` TRUE
#ASSERT NOT (`o conselho fiscal deve ser ouvido antes da deliberação (art. 166, § 2º)` `aumento por conversão em ações ou exercício de direitos de subscrição ou de compra (art. 166, inciso III)` TRUE)
#ASSERT NOT (`o conselho fiscal deve ser ouvido antes da deliberação (art. 166, § 2º)` `aumento por reforma do estatuto social (art. 166, inciso IV)` FALSE)

§ `Testes do art. 167`

#ASSERT `a reserva será capitalizada (art. 167)` TRUE TRUE
#ASSERT NOT (`a reserva será capitalizada (art. 167)` TRUE FALSE)
#ASSERT NOT (`a reserva será capitalizada (art. 167)` FALSE TRUE)
#ASSERT `a assembleia que delibera a capitalização da reserva (art. 167)` EQUALS `assembleia-geral ordinária`
-- § 1º: open company only; closed: silent.
#ASSERT `a capitalização é feita sem modificação do número de ações (art. 167, § 1º)` `companhia aberta` EQUALS JUST TRUE
#ASSERT `a capitalização é feita sem modificação do número de ações (art. 167, § 1º)` `companhia fechada` EQUALS NOTHING
#ASSERT `a capitalização é feita com aumento do valor nominal das ações (art. 167, § 1º)` `companhia aberta` TRUE EQUALS JUST TRUE
#ASSERT `a capitalização é feita com aumento do valor nominal das ações (art. 167, § 1º)` `companhia aberta` FALSE EQUALS JUST FALSE
#ASSERT `a capitalização é feita com aumento do valor nominal das ações (art. 167, § 1º)` `companhia fechada` TRUE EQUALS NOTHING
-- § 2º: fractions of a centavo for nominal shares; below 1% of the capital for shares with no nominal value (999 of 100,000 yes; 1,000 no).
#ASSERT `a companhia pode deixar de capitalizar o saldo da reserva (art. 167, § 2º)` TRUE TRUE 5000 100000
#ASSERT NOT (`a companhia pode deixar de capitalizar o saldo da reserva (art. 167, § 2º)` TRUE FALSE 1 100000)
#ASSERT `a companhia pode deixar de capitalizar o saldo da reserva (art. 167, § 2º)` FALSE FALSE 999 100000
#ASSERT NOT (`a companhia pode deixar de capitalizar o saldo da reserva (art. 167, § 2º)` FALSE FALSE 1000 100000)
-- § 3º.
#ASSERT `a correção do capital das ações com valor nominal é feita separadamente (art. 167, § 3º)` TRUE
#ASSERT NOT (`a correção do capital das ações com valor nominal é feita separadamente (art. 167, § 3º)` FALSE)

§ `Testes do art. 168`

#ASSERT `o aumento pode ser feito sem reforma do estatuto (art. 168)` `[teste br4] perfil: aberta, com capital autorizado` TRUE
#ASSERT NOT (`o aumento pode ser feito sem reforma do estatuto (art. 168)` `[teste br4] perfil: aberta, sem capital autorizado` TRUE)
#ASSERT NOT (`o aumento pode ser feito sem reforma do estatuto (art. 168)` `[teste br4] perfil: aberta, com capital autorizado` FALSE)

`[teste br4] autorização: completa` MEANS `Autorização de aumento de capital no estatuto (art. 168)` WITH
    `a autorização especifica o limite do aumento, em valor do capital ou em número de ações` IS TRUE
    `a autorização especifica as espécies e classes das ações que poderão ser emitidas` IS TRUE
    `a autorização especifica o órgão competente para deliberar sobre as emissões` IS TRUE
    `o órgão competente especificado é a assembleia-geral ou o conselho de administração` IS TRUE
    `a autorização especifica as condições a que estiverem sujeitas as emissões` IS TRUE
    `a autorização especifica os casos ou condições do direito de preferência, ou de sua inexistência` IS TRUE

`[teste br4] autorização: sem as classes e com a diretoria como órgão` MEANS `Autorização de aumento de capital no estatuto (art. 168)` WITH
    `a autorização especifica o limite do aumento, em valor do capital ou em número de ações` IS TRUE
    `a autorização especifica as espécies e classes das ações que poderão ser emitidas` IS FALSE
    `a autorização especifica o órgão competente para deliberar sobre as emissões` IS TRUE
    `o órgão competente especificado é a assembleia-geral ou o conselho de administração` IS FALSE
    `a autorização especifica as condições a que estiverem sujeitas as emissões` IS FALSE
    `a autorização especifica os casos ou condições do direito de preferência, ou de sua inexistência` IS TRUE

#ASSERT `a autorização cumpre a alínea a (art. 168, § 1º, alínea a)` `[teste br4] autorização: completa`
#ASSERT NOT (`a autorização cumpre a alínea a (art. 168, § 1º, alínea a)` `[teste br4] autorização: sem as classes e com a diretoria como órgão`)
#ASSERT `a autorização cumpre a alínea b (art. 168, § 1º, alínea b)` `[teste br4] autorização: completa`
#ASSERT NOT (`a autorização cumpre a alínea b (art. 168, § 1º, alínea b)` `[teste br4] autorização: sem as classes e com a diretoria como órgão`)
#ASSERT `a autorização cumpre a alínea c (art. 168, § 1º, alínea c)` `[teste br4] autorização: completa`
#ASSERT NOT (`a autorização cumpre a alínea c (art. 168, § 1º, alínea c)` `[teste br4] autorização: sem as classes e com a diretoria como órgão`)
#ASSERT `a autorização cumpre a alínea d (art. 168, § 1º, alínea d)` `[teste br4] autorização: completa`
#ASSERT `a autorização cumpre a alínea d (art. 168, § 1º, alínea d)` `[teste br4] autorização: sem as classes e com a diretoria como órgão`
#ASSERT `a autorização especifica o que a lei exige (art. 168, § 1º)` `[teste br4] autorização: completa`
#ASSERT NOT (`a autorização especifica o que a lei exige (art. 168, § 1º)` `[teste br4] autorização: sem as classes e com a diretoria como órgão`)
-- § 2º: a limit in value is corrected by the ordinary meeting; a limit in shares is not.
#ASSERT `a assembleia que corrige anualmente o limite da autorização (art. 168, § 2º)` TRUE EQUALS JUST `assembleia-geral ordinária`
#ASSERT `a assembleia que corrige anualmente o limite da autorização (art. 168, § 2º)` FALSE EQUALS NOTHING
-- § 3º: stock options within the limit, with a plan, to the persons named.
#ASSERT `a companhia pode outorgar opção de compra de ações (art. 168, § 3º)` TRUE TRUE TRUE TRUE
#ASSERT NOT (`a companhia pode outorgar opção de compra de ações (art. 168, § 3º)` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`a companhia pode outorgar opção de compra de ações (art. 168, § 3º)` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`a companhia pode outorgar opção de compra de ações (art. 168, § 3º)` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`a companhia pode outorgar opção de compra de ações (art. 168, § 3º)` TRUE TRUE TRUE FALSE)

§ `Testes do art. 169`

-- caput: 150 of 1,000 shares, 100 new: 15; 33 of 1,000: 3.3; no shares: nothing.
#ASSERT `a quantidade de ações novas que cabe ao acionista na capitalização (art. 169)` 150 1000 100 EQUALS JUST 15
#ASSERT `a quantidade de ações novas que cabe ao acionista na capitalização (art. 169)` 33 1000 100 EQUALS JUST 3.3
#ASSERT `a quantidade de ações novas que cabe ao acionista na capitalização (art. 169)` 0 1000 100 EQUALS JUST 0
#ASSERT `a quantidade de ações novas que cabe ao acionista na capitalização (art. 169)` 10 0 100 EQUALS NOTHING
#ASSERT `a capitalização pode ser feita sem modificação do número de ações (art. 169, § 1º)` TRUE
#ASSERT NOT (`a capitalização pode ser feita sem modificação do número de ações (art. 169, § 1º)` FALSE)
#ASSERT `o gravame se estende às ações distribuídas (art. 169, § 2º)` TRUE FALSE
#ASSERT NOT (`o gravame se estende às ações distribuídas (art. 169, § 2º)` TRUE TRUE)
#ASSERT NOT (`o gravame se estende às ações distribuídas (art. 169, § 2º)` FALSE FALSE)
-- § 3º: whole shares and the fraction; the proceeds in proportion; a period of at least 30 days.
#ASSERT `a quantidade inteira de ações novas atribuída ao acionista (art. 169, § 3º)` 3.3 EQUALS 3
#ASSERT `a fração de ação que cabe ao acionista (art. 169, § 3º)` 3.5 EQUALS 0.5
#ASSERT `a fração de ação que cabe ao acionista (art. 169, § 3º)` 15 EQUALS 0
#ASSERT `a parte do produto da venda que cabe ao titular da fração, em reais (art. 169, § 3º)` 1000 0.25 1 EQUALS JUST 250
#ASSERT `a parte do produto da venda que cabe ao titular da fração, em reais (art. 169, § 3º)` 1000 0.25 0 EQUALS NOTHING
#ASSERT `o prazo fixado para a transferência das frações é admissível (art. 169, § 3º)` 30
#ASSERT `o prazo fixado para a transferência das frações é admissível (art. 169, § 3º)` 45
#ASSERT NOT (`o prazo fixado para a transferência das frações é admissível (art. 169, § 3º)` 29)

§ `Testes do art. 170`

-- caput: 3/4 of the capital paid up (75,000 of 100,000 yes; 74,999 no).
