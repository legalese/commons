#ASSERT NOT (`a proposta de aumento cumpre o que se exige (art. 170, § 7º)` TRUE FALSE)
#ASSERT NOT (`a proposta de aumento cumpre o que se exige (art. 170, § 7º)` FALSE TRUE)

§ `Testes do art. 171`

-- caput: 150 of 1,000, an increase of 200: 30.
#ASSERT `a quantidade de ações do aumento que o acionista tem preferência para subscrever (art. 171)` 150 1000 200 EQUALS JUST 30
#ASSERT `a quantidade de ações do aumento que o acionista tem preferência para subscrever (art. 171)` 150 0 200 EQUALS NOTHING
-- § 1º: a, b (enough or not), c.
#ASSERT `sobre quais ações a preferência é exercida (art. 171, § 1º)` `aumento na mesma proporção de todas as espécies e classes existentes (art. 171, § 1º, alínea a)` FALSE EQUALS `somente ações idênticas às de que o acionista é possuidor (art. 171, § 1º)`
#ASSERT `sobre quais ações a preferência é exercida (art. 171, § 1º)` `emissão de espécies e classes existentes com alteração das proporções (art. 171, § 1º, alínea b)` TRUE EQUALS `somente ações idênticas às de que o acionista é possuidor (art. 171, § 1º)`
#ASSERT `sobre quais ações a preferência é exercida (art. 171, § 1º)` `emissão de espécies e classes existentes com alteração das proporções (art. 171, § 1º, alínea b)` FALSE EQUALS `ações idênticas e, no que forem insuficientes, as demais espécies e classes (art. 171, § 1º)`
#ASSERT `sobre quais ações a preferência é exercida (art. 171, § 1º)` `emissão de espécie ou classe diversa das existentes (art. 171, § 1º, alínea c)` TRUE EQUALS `ações de todas as espécies e classes do aumento (art. 171, § 1º)`
-- § 2º.
#ASSERT `o direito de preferência é sempre assegurado (art. 171, § 2º)` TRUE EQUALS JUST TRUE
#ASSERT `o direito de preferência é sempre assegurado (art. 171, § 2º)` FALSE EQUALS NOTHING
-- § 3º: debentures and beneficiary parts must be convertible; warrants need not; none when the act is a conversion or an option; shares: the caput.
#ASSERT `os acionistas têm direito de preferência para a subscrição do título (art. 171, § 3º)` `debêntures` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `os acionistas têm direito de preferência para a subscrição do título (art. 171, § 3º)` `debêntures` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `os acionistas têm direito de preferência para a subscrição do título (art. 171, § 3º)` `debêntures` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `os acionistas têm direito de preferência para a subscrição do título (art. 171, § 3º)` `debêntures` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `os acionistas têm direito de preferência para a subscrição do título (art. 171, § 3º)` `partes beneficiárias` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `os acionistas têm direito de preferência para a subscrição do título (art. 171, § 3º)` `partes beneficiárias` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `os acionistas têm direito de preferência para a subscrição do título (art. 171, § 3º)` `bônus de subscrição` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `os acionistas têm direito de preferência para a subscrição do título (art. 171, § 3º)` `bônus de subscrição` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `os acionistas têm direito de preferência para a subscrição do título (art. 171, § 3º)` `bônus de subscrição` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `os acionistas têm direito de preferência para a subscrição do título (art. 171, § 3º)` `ações` TRUE TRUE FALSE EQUALS NOTHING
-- § 4º: a period of decay fixed by the estatuto or the meeting, at least 30 days.
#ASSERT `o prazo de decadência do direito de preferência é admissível (art. 171, § 4º)` TRUE 30
#ASSERT NOT (`o prazo de decadência do direito de preferência é admissível (art. 171, § 4º)` TRUE 29)
#ASSERT NOT (`o prazo de decadência do direito de preferência é admissível (art. 171, § 4º)` FALSE 45)
-- § 5º: period ends 30 June 2026; ten days before is 20 June. The shareholder exercised on 20 June (in time) or 21 June (late) or not at all.
#ASSERT NOT (`o usufrutuário ou fideicomissário pode exercer o direito de preferência (art. 171, § 5º)` TRUE (YearMonthDay 2026 6 30) (JUST (YearMonthDay 2026 6 20)) (YearMonthDay 2026 6 25))
#ASSERT `o usufrutuário ou fideicomissário pode exercer o direito de preferência (art. 171, § 5º)` TRUE (YearMonthDay 2026 6 30) (JUST (YearMonthDay 2026 6 21)) (YearMonthDay 2026 6 25)
#ASSERT `o usufrutuário ou fideicomissário pode exercer o direito de preferência (art. 171, § 5º)` TRUE (YearMonthDay 2026 6 30) NOTHING (YearMonthDay 2026 6 21)
#ASSERT `o usufrutuário ou fideicomissário pode exercer o direito de preferência (art. 171, § 5º)` TRUE (YearMonthDay 2026 6 30) NOTHING (YearMonthDay 2026 6 30)
#ASSERT NOT (`o usufrutuário ou fideicomissário pode exercer o direito de preferência (art. 171, § 5º)` TRUE (YearMonthDay 2026 6 30) NOTHING (YearMonthDay 2026 6 20))
#ASSERT NOT (`o usufrutuário ou fideicomissário pode exercer o direito de preferência (art. 171, § 5º)` TRUE (YearMonthDay 2026 6 30) NOTHING (YearMonthDay 2026 7 1))
#ASSERT NOT (`o usufrutuário ou fideicomissário pode exercer o direito de preferência (art. 171, § 5º)` FALSE (YearMonthDay 2026 6 30) NOTHING (YearMonthDay 2026 6 25))
-- § 6º.
#ASSERT `o acionista pode ceder seu direito de preferência (art. 171, § 6º)`
-- § 7º: open company, private subscription: sale always; apportionment only if the bulletin foresaw the reservation; otherwise silent.
#ASSERT `o órgão pode dar esse destino às sobras (art. 171, § 7º)` `companhia aberta` TRUE `venda em bolsa, em benefício da companhia (art. 171, § 7º, alínea a)` FALSE EQUALS JUST TRUE
#ASSERT `o órgão pode dar esse destino às sobras (art. 171, § 7º)` `companhia aberta` TRUE `rateio entre os acionistas que pediram reserva de sobras (art. 171, § 7º, alínea b)` TRUE EQUALS JUST TRUE
#ASSERT `o órgão pode dar esse destino às sobras (art. 171, § 7º)` `companhia aberta` TRUE `rateio entre os acionistas que pediram reserva de sobras (art. 171, § 7º, alínea b)` FALSE EQUALS JUST FALSE
#ASSERT `o órgão pode dar esse destino às sobras (art. 171, § 7º)` `companhia fechada` TRUE `venda em bolsa, em benefício da companhia (art. 171, § 7º, alínea a)` FALSE EQUALS NOTHING
#ASSERT `o órgão pode dar esse destino às sobras (art. 171, § 7º)` `companhia aberta` FALSE `venda em bolsa, em benefício da companhia (art. 171, § 7º, alínea a)` FALSE EQUALS NOTHING
-- § 7º, b: leftovers 90 shares, the shareholder subscribed 2,000 of 10,000: 18.
#ASSERT `a quantidade de sobras que cabe ao acionista no rateio (art. 171, § 7º, alínea b)` 2000 10000 90 EQUALS JUST 18
#ASSERT `a quantidade de sobras que cabe ao acionista no rateio (art. 171, § 7º, alínea b)` 2000 0 90 EQUALS NOTHING
-- § 8º.
#ASSERT `o rateio das sobras é obrigatório (art. 171, § 8º)` `companhia fechada`
#ASSERT NOT (`o rateio das sobras é obrigatório (art. 171, § 8º)` `companhia aberta`)
#ASSERT `o saldo pode ser subscrito por terceiros (art. 171, § 8º)` `companhia fechada` TRUE
#ASSERT NOT (`o saldo pode ser subscrito por terceiros (art. 171, § 8º)` `companhia fechada` FALSE)
#ASSERT NOT (`o saldo pode ser subscrito por terceiros (art. 171, § 8º)` `companhia aberta` TRUE)

§ `Testes do art. 172`

-- caput: open, authorised capital, shares or convertible debentures or warrants; beneficiary parts are out of the live text.
#ASSERT `o estatuto pode excluir o direito de preferência ou reduzir o prazo (art. 172)` `[teste br4] perfil: aberta, com capital autorizado` `ações` FALSE `venda em bolsa de valores ou subscrição pública (art. 172, inciso I)`
#ASSERT `o estatuto pode excluir o direito de preferência ou reduzir o prazo (art. 172)` `[teste br4] perfil: aberta, com capital autorizado` `ações` FALSE `permuta por ações em oferta pública de aquisição de controle (art. 172, inciso II)`
#ASSERT `o estatuto pode excluir o direito de preferência ou reduzir o prazo (art. 172)` `[teste br4] perfil: aberta, com capital autorizado` `debêntures` TRUE `venda em bolsa de valores ou subscrição pública (art. 172, inciso I)`
#ASSERT NOT (`o estatuto pode excluir o direito de preferência ou reduzir o prazo (art. 172)` `[teste br4] perfil: aberta, com capital autorizado` `debêntures` FALSE `venda em bolsa de valores ou subscrição pública (art. 172, inciso I)`)
#ASSERT `o estatuto pode excluir o direito de preferência ou reduzir o prazo (art. 172)` `[teste br4] perfil: aberta, com capital autorizado` `bônus de subscrição` FALSE `venda em bolsa de valores ou subscrição pública (art. 172, inciso I)`
#ASSERT NOT (`o estatuto pode excluir o direito de preferência ou reduzir o prazo (art. 172)` `[teste br4] perfil: aberta, com capital autorizado` `partes beneficiárias` TRUE `venda em bolsa de valores ou subscrição pública (art. 172, inciso I)`)
#ASSERT NOT (`o estatuto pode excluir o direito de preferência ou reduzir o prazo (art. 172)` `[teste br4] perfil: aberta, sem capital autorizado` `ações` FALSE `venda em bolsa de valores ou subscrição pública (art. 172, inciso I)`)
#ASSERT NOT (`o estatuto pode excluir o direito de preferência ou reduzir o prazo (art. 172)` `[teste br4] perfil: fechada, com capital autorizado` `ações` FALSE `venda em bolsa de valores ou subscrição pública (art. 172, inciso I)`)
-- parágrafo único: even a closed company, under the special law on tax incentives.
#ASSERT `o estatuto pode excluir o direito de preferência nos termos da lei especial (art. 172, parágrafo único)` TRUE
#ASSERT NOT (`o estatuto pode excluir o direito de preferência nos termos da lei especial (art. 172, parágrafo único)` FALSE)

