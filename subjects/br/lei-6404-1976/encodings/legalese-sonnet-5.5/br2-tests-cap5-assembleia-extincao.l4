IMPORT prelude
IMPORT `br-core`
IMPORT `br2-cap5-debentures-assembleia-extincao`

-- br2-tests-cap5-assembleia-extincao.l4 -- tests of br2-cap5-debentures-assembleia-extincao.l4 (Arts. 71 a 74).
-- Every expected value was decided by reading the article, before running, and is written beside the
-- assertion. A failing assertion is a finding, not an expected value to edit.

§ `Testes dos Arts. 71 a 74`

§§ `Art. 71, caput e § 1º`
#ASSERT `os titulares podem reunir-se em assembleia a qualquer tempo (art. 71)` TRUE TRUE
#ASSERT NOT (`os titulares podem reunir-se em assembleia a qualquer tempo (art. 71)` TRUE FALSE)
#ASSERT NOT (`os titulares podem reunir-se em assembleia a qualquer tempo (art. 71)` FALSE TRUE)
-- § 1º: the four who may convene; debenturistas need 10% of the debentures in circulation.
#ASSERT (`a parte pode convocar a assembleia de debenturistas (art. 71, § 1º)` `o agente fiduciário` 1000 0) EQUALS JUST TRUE
#ASSERT (`a parte pode convocar a assembleia de debenturistas (art. 71, § 1º)` `a companhia` 1000 0) EQUALS JUST TRUE
#ASSERT (`a parte pode convocar a assembleia de debenturistas (art. 71, § 1º)` `a Comissão de Valores Mobiliários` 1000 0) EQUALS JUST TRUE
-- Exactly 10% (100 of 1000): enough. One debenture less: not enough.
#ASSERT (`a parte pode convocar a assembleia de debenturistas (art. 71, § 1º)` `o debenturista` 1000 100) EQUALS JUST TRUE
#ASSERT (`a parte pode convocar a assembleia de debenturistas (art. 71, § 1º)` `o debenturista` 1000 99) EQUALS JUST FALSE
-- Anyone else: the text is silent.
#ASSERT (`a parte pode convocar a assembleia de debenturistas (art. 71, § 1º)` `o acionista` 1000 500) EQUALS NOTHING
#ASSERT (`a parte pode convocar a assembleia de debenturistas (art. 71, § 1º)` `o administrador` 1000 500) EQUALS NOTHING

§§ `Art. 71, § 2º ao § 5º`
#ASSERT `a disposição sobre a assembleia-geral de acionistas se aplica à assembleia de debenturistas (art. 71, § 2º)` TRUE TRUE
#ASSERT NOT (`a disposição sobre a assembleia-geral de acionistas se aplica à assembleia de debenturistas (art. 71, § 2º)` TRUE FALSE)
#ASSERT NOT (`a disposição sobre a assembleia-geral de acionistas se aplica à assembleia de debenturistas (art. 71, § 2º)` FALSE TRUE)
-- § 3º: first call needs half of the debentures in circulation (500 of 1000 exactly is enough).
#ASSERT (`a assembleia de debenturistas se instala (art. 71, § 3º)` `primeira convocação (art. 71, § 3º)` 1000 500) EQUALS JUST TRUE
#ASSERT (`a assembleia de debenturistas se instala (art. 71, § 3º)` `primeira convocação (art. 71, § 3º)` 1000 499) EQUALS JUST FALSE
-- Second call: any number.
#ASSERT (`a assembleia de debenturistas se instala (art. 71, § 3º)` `segunda convocação (art. 71, § 3º)` 1000 1) EQUALS JUST TRUE
#ASSERT (`a assembleia de debenturistas se instala (art. 71, § 3º)` `segunda convocação (art. 71, § 3º)` 1000 0) EQUALS JUST TRUE
-- Third call: § 3º says nothing about installation.
#ASSERT (`a assembleia de debenturistas se instala (art. 71, § 3º)` `terceira convocação (art. 71, § 9º)` 1000 1) EQUALS NOTHING
-- § 4º
#ASSERT `o agente fiduciário cumpriu o dever de comparecer e prestar informações (art. 71, § 4º)` TRUE TRUE
#ASSERT NOT (`o agente fiduciário cumpriu o dever de comparecer e prestar informações (art. 71, § 4º)` TRUE FALSE)
#ASSERT NOT (`o agente fiduciário cumpriu o dever de comparecer e prestar informações (art. 71, § 4º)` FALSE TRUE)
-- § 5º: the majority the escritura sets may not be below half of the debentures in circulation.
#ASSERT `a maioria da escritura respeita o mínimo da lei (art. 71, § 5º)` TRUE 500 1000
#ASSERT NOT (`a maioria da escritura respeita o mínimo da lei (art. 71, § 5º)` TRUE 499 1000)
#ASSERT NOT (`a maioria da escritura respeita o mínimo da lei (art. 71, § 5º)` FALSE 800 1000)
-- § 5º: approval needs the votes in favour to reach the escritura's majority.
#ASSERT (`a modificação nas condições das debêntures foi aprovada (art. 71, § 5º)` 500 1000 500) EQUALS JUST TRUE
#ASSERT (`a modificação nas condições das debêntures foi aprovada (art. 71, § 5º)` 500 1000 499) EQUALS JUST FALSE
#ASSERT (`a modificação nas condições das debêntures foi aprovada (art. 71, § 5º)` 501 1000 500) EQUALS JUST FALSE
-- A majority below the floor: the text does not say what then governs.
#ASSERT (`a modificação nas condições das debêntures foi aprovada (art. 71, § 5º)` 400 1000 1000) EQUALS NOTHING

§§ `Art. 71, §§ 6º a 10`
#ASSERT (`qual é a base do cômputo dos votos (art. 71, §§ 6º e 7º)` FALSE) EQUALS `um voto por debênture (art. 71, § 6º)`
#ASSERT (`qual é a base do cômputo dos votos (art. 71, §§ 6º e 7º)` TRUE) EQUALS `direito econômico proporcional possuído por titular (art. 71, § 7º)`
#ASSERT (`o número de votos do titular (art. 71, §§ 6º e 7º)` FALSE 7) EQUALS JUST 7
#ASSERT (`o número de votos do titular (art. 71, §§ 6º e 7º)` TRUE 7) EQUALS NOTHING
-- § 10: dispersed means that nobody holds MORE than half; exactly half is still dispersed.
#ASSERT `a propriedade das debêntures está dispersa (art. 71, § 10)` 1000 500
#ASSERT NOT (`a propriedade das debêntures está dispersa (art. 71, § 10)` 1000 501)
#ASSERT `a propriedade das debêntures está dispersa (art. 71, § 10)` 1000 0
-- § 8º: only open companies, and only when ownership is dispersed.
#ASSERT `a Comissão de Valores Mobiliários pode autorizar a redução do quórum do § 5º (art. 71, § 8º)` `companhia aberta` 1000 300
#ASSERT NOT (`a Comissão de Valores Mobiliários pode autorizar a redução do quórum do § 5º (art. 71, § 8º)` `companhia fechada` 1000 300)
#ASSERT NOT (`a Comissão de Valores Mobiliários pode autorizar a redução do quórum do § 5º (art. 71, § 8º)` `companhia aberta` 1000 501)
-- § 9º: authorised, mentioned in the notices, and on third call only.
#ASSERT `a deliberação com quórum reduzido pode ser adotada (art. 71, § 9º)` TRUE TRUE `terceira convocação (art. 71, § 9º)`
#ASSERT NOT (`a deliberação com quórum reduzido pode ser adotada (art. 71, § 9º)` TRUE TRUE `segunda convocação (art. 71, § 3º)`)
#ASSERT NOT (`a deliberação com quórum reduzido pode ser adotada (art. 71, § 9º)` TRUE FALSE `terceira convocação (art. 71, § 9º)`)
#ASSERT NOT (`a deliberação com quórum reduzido pode ser adotada (art. 71, § 9º)` FALSE TRUE `terceira convocação (art. 71, § 9º)`)

§§ `Art. 72: cédula de debêntures`
#ASSERT (`a parte pode emitir cédula de debêntures (art. 72)` `a instituição financeira` TRUE) EQUALS JUST TRUE
#ASSERT (`a parte pode emitir cédula de debêntures (art. 72)` `a instituição financeira` FALSE) EQUALS JUST FALSE
#ASSERT (`a parte pode emitir cédula de debêntures (art. 72)` `a companhia` TRUE) EQUALS NOTHING
#ASSERT `a cédula tem a forma que a lei exige (art. 72, § 1º)` TRUE
#ASSERT NOT (`a cédula tem a forma que a lei exige (art. 72, § 1º)` FALSE)

-- A builder for the certificate. Parameters in order: os incisos que não variam constam; há cláusula de
-- correção monetária; consta a cláusula.
GIVEN `os demais constam` IS A BOOLEAN
      `há correção` IS A BOOLEAN
      `consta a cláusula` IS A BOOLEAN
GIVETH A `Declarações do certificado da cédula (art. 72, § 2º)`
`teste: certificado da cédula com` MEANS
    `Declarações do certificado da cédula (art. 72, § 2º)` WITH
        `consta o nome da instituição financeira emitente e constam as assinaturas dos seus representantes` IS `os demais constam`
        `consta o número de ordem, o local e a data da emissão` IS `os demais constam`
        `consta a denominação Cédula de Debêntures` IS `os demais constam`
        `constam o valor nominal e a data do vencimento` IS `os demais constam`
        `constam os juros, fixos ou variáveis, e as épocas do seu pagamento` IS `os demais constam`
        `consta o lugar do pagamento do principal e dos juros` IS `os demais constam`
        `consta a identificação das debêntures-lastro, do seu valor e da garantia constituída` IS `os demais constam`
        `consta o nome do agente fiduciário dos debenturistas` IS `os demais constam`
        `a cédula tem cláusula de correção monetária` IS `há correção`
        `consta a cláusula de correção monetária` IS `consta a cláusula`
        `consta o nome do titular` IS `os demais constam`

#ASSERT `o certificado da cédula contém as declarações que a lei exige (art. 72, § 2º)` (`teste: certificado da cédula com` TRUE FALSE FALSE)
#ASSERT NOT (`o certificado da cédula contém as declarações que a lei exige (art. 72, § 2º)` (`teste: certificado da cédula com` FALSE FALSE FALSE))
#ASSERT `o certificado da cédula contém as declarações que a lei exige (art. 72, § 2º)` (`teste: certificado da cédula com` TRUE TRUE TRUE)
#ASSERT NOT (`o certificado da cédula contém as declarações que a lei exige (art. 72, § 2º)` (`teste: certificado da cédula com` TRUE TRUE FALSE))

§§ `Art. 73: emissão no estrangeiro`
-- caput: only a Brazilian company, abroad, with a guarantee over assets in Brazil, needs the approval.
#ASSERT `a emissão no exterior com garantia de bens no País tem a aprovação que a lei exige (art. 73)` TRUE TRUE TRUE TRUE
#ASSERT NOT (`a emissão no exterior com garantia de bens no País tem a aprovação que a lei exige (art. 73)` TRUE TRUE TRUE FALSE)
#ASSERT `a emissão no exterior com garantia de bens no País tem a aprovação que a lei exige (art. 73)` FALSE TRUE TRUE FALSE
#ASSERT `a emissão no exterior com garantia de bens no País tem a aprovação que a lei exige (art. 73)` TRUE FALSE TRUE FALSE
#ASSERT `a emissão no exterior com garantia de bens no País tem a aprovação que a lei exige (art. 73)` TRUE TRUE FALSE FALSE
-- § 1º
#ASSERT `o credor por obrigação contraída no Brasil tem preferência sobre o crédito por debêntures emitidas no exterior (art. 73, § 1º)` TRUE TRUE FALSE FALSE
#ASSERT NOT (`o credor por obrigação contraída no Brasil tem preferência sobre o crédito por debêntures emitidas no exterior (art. 73, § 1º)` TRUE TRUE TRUE TRUE)
-- One of the two conditions of the exception is not enough to lose the preference.
#ASSERT `o credor por obrigação contraída no Brasil tem preferência sobre o crédito por debêntures emitidas no exterior (art. 73, § 1º)` TRUE TRUE TRUE FALSE
#ASSERT `o credor por obrigação contraída no Brasil tem preferência sobre o crédito por debêntures emitidas no exterior (art. 73, § 1º)` TRUE TRUE FALSE TRUE
#ASSERT NOT (`o credor por obrigação contraída no Brasil tem preferência sobre o crédito por debêntures emitidas no exterior (art. 73, § 1º)` FALSE TRUE FALSE FALSE)
#ASSERT NOT (`o credor por obrigação contraída no Brasil tem preferência sobre o crédito por debêntures emitidas no exterior (art. 73, § 1º)` TRUE FALSE FALSE FALSE)
-- § 2º
#ASSERT `a remessa para o exterior é permitida (art. 73, § 2º)` TRUE TRUE
#ASSERT NOT (`a remessa para o exterior é permitida (art. 73, § 2º)` TRUE FALSE)
#ASSERT NOT (`a remessa para o exterior é permitida (art. 73, § 2º)` FALSE TRUE)
-- § 3º: art. 62, the foreign documents on the website, in Portuguese or with a simple translation.
#ASSERT `a emissão de debêntures no estrangeiro cumpre o que o § 3º exige (art. 73, § 3º)` TRUE TRUE TRUE FALSE
#ASSERT `a emissão de debêntures no estrangeiro cumpre o que o § 3º exige (art. 73, § 3º)` TRUE TRUE FALSE TRUE
#ASSERT NOT (`a emissão de debêntures no estrangeiro cumpre o que o § 3º exige (art. 73, § 3º)` TRUE TRUE FALSE FALSE)
#ASSERT NOT (`a emissão de debêntures no estrangeiro cumpre o que o § 3º exige (art. 73, § 3º)` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`a emissão de debêntures no estrangeiro cumpre o que o § 3º exige (art. 73, § 3º)` TRUE FALSE TRUE TRUE)
-- § 4º
#ASSERT NOT (`a negociação das debêntures emitidas no estrangeiro tem a autorização que a lei exige (art. 73, § 4º)` TRUE TRUE FALSE)
#ASSERT `a negociação das debêntures emitidas no estrangeiro tem a autorização que a lei exige (art. 73, § 4º)` TRUE TRUE TRUE
#ASSERT `a negociação das debêntures emitidas no estrangeiro tem a autorização que a lei exige (art. 73, § 4º)` FALSE TRUE FALSE
#ASSERT `a negociação das debêntures emitidas no estrangeiro tem a autorização que a lei exige (art. 73, § 4º)` TRUE FALSE FALSE

§§ `Art. 74: extinção`
-- Extinction on 15 June 2026: five years end on 15 June 2031. Kept until that day: enough. A day short: not.
#ASSERT `a companhia cumpriu o dever de anotar a extinção e manter arquivados os documentos (art. 74)` TRUE (YMD 2026 6 15) (YMD 2031 6 15) TRUE
#ASSERT NOT (`a companhia cumpriu o dever de anotar a extinção e manter arquivados os documentos (art. 74)` TRUE (YMD 2026 6 15) (YMD 2031 6 14) TRUE)
#ASSERT `a companhia cumpriu o dever de anotar a extinção e manter arquivados os documentos (art. 74)` TRUE (YMD 2026 6 15) (YMD 2031 6 16) TRUE
#ASSERT NOT (`a companhia cumpriu o dever de anotar a extinção e manter arquivados os documentos (art. 74)` FALSE (YMD 2026 6 15) (YMD 2031 6 15) TRUE)
#ASSERT NOT (`a companhia cumpriu o dever de anotar a extinção e manter arquivados os documentos (art. 74)` TRUE (YMD 2026 6 15) (YMD 2031 6 15) FALSE)
#ASSERT `cabe ao agente fiduciário fiscalizar o cancelamento dos certificados (art. 74, § 1º)` TRUE
#ASSERT NOT (`cabe ao agente fiduciário fiscalizar o cancelamento dos certificados (art. 74, § 1º)` FALSE)
#ASSERT `os administradores respondem solidariamente pelas perdas e danos (art. 74, § 2º)` TRUE TRUE
#ASSERT NOT (`os administradores respondem solidariamente pelas perdas e danos (art. 74, § 2º)` TRUE FALSE)
#ASSERT NOT (`os administradores respondem solidariamente pelas perdas e danos (art. 74, § 2º)` FALSE TRUE)
