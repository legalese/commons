#ASSERT `a ata da assembleia de constituição cumpre o que a lei exige (art. 87, § 4º)` TRUE TRUE FALSE TRUE TRUE TRUE
#ASSERT NOT (`a ata da assembleia de constituição cumpre o que a lei exige (art. 87, § 4º)` TRUE TRUE FALSE FALSE TRUE TRUE)
#ASSERT NOT (`a ata da assembleia de constituição cumpre o que a lei exige (art. 87, § 4º)` FALSE TRUE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`a ata da assembleia de constituição cumpre o que a lei exige (art. 87, § 4º)` TRUE FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`a ata da assembleia de constituição cumpre o que a lei exige (art. 87, § 4º)` TRUE TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`a ata da assembleia de constituição cumpre o que a lei exige (art. 87, § 4º)` TRUE TRUE TRUE TRUE TRUE FALSE)
