#ASSERT NOT (`a assembleia de constituição observou o que o § 1º exige (art. 87, § 1º)` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`a assembleia de constituição observou o que o § 1º exige (art. 87, § 1º)` TRUE TRUE TRUE FALSE)
