IMPORT prelude
IMPORT `br-core`
IMPORT `br2-cap8-formalidades`

-- br2-tests-cap8-formalidades.l4 -- tests of br2-cap8-formalidades.l4 (Arts. 94 a 99).
-- Every expected value was decided by reading the article, before running, and is written beside the
-- assertion. A failing assertion is a finding, not an expected value to edit.

§ `Testes dos Arts. 94 a 99`

§§ `Art. 94`
#ASSERT `a companhia satisfaz a condição para funcionar (art. 94)` TRUE TRUE
#ASSERT NOT (`a companhia satisfaz a condição para funcionar (art. 94)` TRUE FALSE)
#ASSERT NOT (`a companhia satisfaz a condição para funcionar (art. 94)` FALSE TRUE)
#ASSERT NOT (`a companhia satisfaz a condição para funcionar (art. 94)` FALSE FALSE)

§§ `Arts. 95 e 96`
-- A builder. Parameters in order: subscrição pública; estatuto assinado por todos os subscritores; originais
-- do estatuto e do prospecto; jornal; relação dos subscritores; recibo do depósito; houve assembleias de
-- avaliação; duplicata das atas de avaliação; duplicata da ata da assembleia de constituição.
GIVEN `pública` IS A BOOLEAN
      `estatuto assinado` IS A BOOLEAN
      `originais` IS A BOOLEAN
      `jornal` IS A BOOLEAN
      `relação` IS A BOOLEAN
      `recibo` IS A BOOLEAN
      `houve avaliação` IS A BOOLEAN
      `atas de avaliação` IS A BOOLEAN
      `ata de constituição` IS A BOOLEAN
GIVETH A `Documentos arquivados no registro do comércio (art. 95)`
`teste: documentos com` MEANS
    `Documentos arquivados no registro do comércio (art. 95)` WITH
        `a subscrição foi pública` IS `pública`
        `foi arquivado um exemplar do estatuto social assinado por todos os subscritores` IS `estatuto assinado`
        `foram arquivados os originais do estatuto e do prospecto assinados pelos fundadores` IS `originais`
        `foi arquivado o jornal em que o estatuto e o prospecto foram publicados` IS `jornal`
        `foi arquivada a relação completa dos subscritores, autenticada pelos fundadores ou pelo presidente da assembleia, com a qualificação, o número das ações e o total da entrada de cada um` IS `relação`
        `foi arquivado o recibo do depósito a que se refere o inciso III do art. 80` IS `recibo`
        `houve assembleias para a avaliação de bens` IS `houve avaliação`
        `foi arquivada a duplicata das atas das assembleias para a avaliação de bens` IS `atas de avaliação`
        `foi arquivada a duplicata da ata da assembleia-geral dos subscritores que deliberou a constituição` IS `ata de constituição`

-- Private subscription: the estatuto signed by all the subscribers.
#ASSERT `os documentos arquivados cumprem o art. 95 (art. 95)` (`teste: documentos com` FALSE TRUE FALSE FALSE TRUE TRUE FALSE FALSE TRUE)
#ASSERT NOT (`os documentos arquivados cumprem o art. 95 (art. 95)` (`teste: documentos com` FALSE FALSE FALSE FALSE TRUE TRUE FALSE FALSE TRUE))
-- Public subscription: the originals of estatuto and prospectus and the newspaper; the private-subscription
-- copy alone does not do.
#ASSERT `os documentos arquivados cumprem o art. 95 (art. 95)` (`teste: documentos com` TRUE FALSE TRUE TRUE TRUE TRUE FALSE FALSE TRUE)
#ASSERT NOT (`os documentos arquivados cumprem o art. 95 (art. 95)` (`teste: documentos com` TRUE TRUE FALSE FALSE TRUE TRUE FALSE FALSE TRUE))
#ASSERT NOT (`os documentos arquivados cumprem o art. 95 (art. 95)` (`teste: documentos com` TRUE FALSE TRUE FALSE TRUE TRUE FALSE FALSE TRUE))
-- The list, the receipt and the minutes are always required.
#ASSERT NOT (`os documentos arquivados cumprem o art. 95 (art. 95)` (`teste: documentos com` FALSE TRUE FALSE FALSE FALSE TRUE FALSE FALSE TRUE))
#ASSERT NOT (`os documentos arquivados cumprem o art. 95 (art. 95)` (`teste: documentos com` FALSE TRUE FALSE FALSE TRUE FALSE FALSE FALSE TRUE))
#ASSERT NOT (`os documentos arquivados cumprem o art. 95 (art. 95)` (`teste: documentos com` FALSE TRUE FALSE FALSE TRUE TRUE FALSE FALSE FALSE))
-- Valuation meetings: their minutes only when there were meetings.
#ASSERT `os documentos arquivados cumprem o art. 95 (art. 95)` (`teste: documentos com` FALSE TRUE FALSE FALSE TRUE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`os documentos arquivados cumprem o art. 95 (art. 95)` (`teste: documentos com` FALSE TRUE FALSE FALSE TRUE TRUE TRUE FALSE TRUE))
-- Art. 96: by public deed a certificate is enough; otherwise the article says nothing.
#ASSERT (`basta o arquivamento de certidão do instrumento (art. 96)` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`basta o arquivamento de certidão do instrumento (art. 96)` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`basta o arquivamento de certidão do instrumento (art. 96)` FALSE TRUE) EQUALS NOTHING

§§ `Art. 97`
#ASSERT `o registro do comércio deve examinar a constituição e o estatuto (art. 97)`
#ASSERT `os primeiros administradores devem convocar imediatamente a assembleia-geral para sanar a falta (art. 97, § 1º)` TRUE
#ASSERT NOT (`os primeiros administradores devem convocar imediatamente a assembleia-geral para sanar a falta (art. 97, § 1º)` FALSE)
-- The deliberation needs shareholders representing at least half the capital (500 of 1000 is exactly half).
#ASSERT `a deliberação que sana a falta foi tomada como a lei exige (art. 97, § 1º)` TRUE 1000 500
#ASSERT NOT (`a deliberação que sana a falta foi tomada como a lei exige (art. 97, § 1º)` TRUE 1000 499)
#ASSERT NOT (`a deliberação que sana a falta foi tomada como a lei exige (art. 97, § 1º)` FALSE 1000 1000)
#ASSERT `a falta do estatuto pode ser sanada na mesma assembleia (art. 97, § 1º)` TRUE
#ASSERT NOT (`a falta do estatuto pode ser sanada na mesma assembleia (art. 97, § 1º)` FALSE)
#ASSERT `a assembleia deve deliberar sobre a responsabilidade civil dos fundadores (art. 97, § 1º)` TRUE
#ASSERT NOT (`a assembleia deve deliberar sobre a responsabilidade civil dos fundadores (art. 97, § 1º)` FALSE)
#ASSERT `o registro do comércio procede ao arquivamento dos atos constitutivos (art. 97, § 2º)` TRUE TRUE
#ASSERT NOT (`o registro do comércio procede ao arquivamento dos atos constitutivos (art. 97, § 2º)` TRUE FALSE)
#ASSERT NOT (`o registro do comércio procede ao arquivamento dos atos constitutivos (art. 97, § 2º)` FALSE TRUE)
#ASSERT (`a criação de sucursal, filial ou agência cumpre o dever de arquivamento (art. 97, § 3º)` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`a criação de sucursal, filial ou agência cumpre o dever de arquivamento (art. 97, § 3º)` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`a criação de sucursal, filial ou agência cumpre o dever de arquivamento (art. 97, § 3º)` FALSE TRUE) EQUALS NOTHING

§§ `Art. 98`
-- Filed on 10 March 2026: 30 days later is 9 April 2026.
#ASSERT `os administradores cumpriram o dever de publicar os atos de constituição (art. 98)` (YearMonthDay 2026 3 10) (YearMonthDay 2026 4 9) TRUE
#ASSERT NOT (`os administradores cumpriram o dever de publicar os atos de constituição (art. 98)` (YearMonthDay 2026 3 10) (YearMonthDay 2026 4 10) TRUE)
#ASSERT `os administradores cumpriram o dever de publicar os atos de constituição (art. 98)` (YearMonthDay 2026 3 10) (YearMonthDay 2026 3 10) TRUE
#ASSERT NOT (`os administradores cumpriram o dever de publicar os atos de constituição (art. 98)` (YearMonthDay 2026 3 10) (YearMonthDay 2026 3 20) FALSE)
#ASSERT `o exemplar do órgão oficial foi arquivado como a lei exige (art. 98, § 1º)` TRUE
#ASSERT NOT (`o exemplar do órgão oficial foi arquivado como a lei exige (art. 98, § 1º)` FALSE)
#ASSERT `a certidão dos atos constitutivos é documento hábil para a transferência dos bens (art. 98, § 2º)` TRUE
#ASSERT NOT (`a certidão dos atos constitutivos é documento hábil para a transferência dos bens (art. 98, § 2º)` FALSE)
-- § 3º: precise identification; a summary description needs the subscriber's supplementing declaration.
#ASSERT `a ata da assembleia que aprova a incorporação do bem cumpre o § 3º (art. 98, § 3º)` TRUE FALSE FALSE
#ASSERT `a ata da assembleia que aprova a incorporação do bem cumpre o § 3º (art. 98, § 3º)` TRUE TRUE TRUE
#ASSERT NOT (`a ata da assembleia que aprova a incorporação do bem cumpre o § 3º (art. 98, § 3º)` TRUE TRUE FALSE)
#ASSERT NOT (`a ata da assembleia que aprova a incorporação do bem cumpre o § 3º (art. 98, § 3º)` FALSE FALSE FALSE)

§§ `Art. 99`
#ASSERT `os primeiros administradores respondem solidariamente perante a companhia pelos prejuízos da demora (art. 99)` TRUE TRUE
#ASSERT NOT (`os primeiros administradores respondem solidariamente perante a companhia pelos prejuízos da demora (art. 99)` TRUE FALSE)
#ASSERT NOT (`os primeiros administradores respondem solidariamente perante a companhia pelos prejuízos da demora (art. 99)` FALSE TRUE)
-- The company is not liable for earlier acts unless the meeting resolves otherwise; for later acts the
-- paragraph is silent.
#ASSERT (`a companhia responde pelos atos ou operações dos primeiros administradores (art. 99, parágrafo único)` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`a companhia responde pelos atos ou operações dos primeiros administradores (art. 99, parágrafo único)` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`a companhia responde pelos atos ou operações dos primeiros administradores (art. 99, parágrafo único)` FALSE FALSE) EQUALS NOTHING
