IMPORT prelude
IMPORT `br-core`
IMPORT `br3-cap10-sec3-voto`

-- br3-tests-cap10-sec3-voto.l4 -- tests of Arts. 110 to 115 (Art. 110-A has its own tests). Each expected value is
-- written from the text of the article named beside it, before running.

§ `Testes dos arts. 110 a 115`

§§ `Art. 110`

`cem ordinárias nominativas (teste art. 110)` MEANS `Participação do acionista` WITH
    `a espécie das ações` IS `ações ordinárias`
    `a forma das ações` IS `ações nominativas`
    `a quantidade de ações do acionista` IS 100
    `as ações do acionista estão integralizadas` IS TRUE
    `as ações do acionista têm valor nominal` IS FALSE

`cem preferenciais nominativas (teste art. 110)` MEANS `Participação do acionista` WITH
    `a espécie das ações` IS `ações preferenciais`
    `a forma das ações` IS `ações nominativas`
    `a quantidade de ações do acionista` IS 100
    `as ações do acionista estão integralizadas` IS TRUE
    `as ações do acionista têm valor nominal` IS FALSE

`cem de fruição nominativas (teste art. 110)` MEANS `Participação do acionista` WITH
    `a espécie das ações` IS `ações de fruição`
    `a forma das ações` IS `ações nominativas`
    `a quantidade de ações do acionista` IS 100
    `as ações do acionista estão integralizadas` IS TRUE
    `as ações do acionista têm valor nominal` IS FALSE

`nenhuma ordinária (teste art. 110)` MEANS `Participação do acionista` WITH
    `a espécie das ações` IS `ações ordinárias`
    `a forma das ações` IS `ações nominativas`
    `a quantidade de ações do acionista` IS 0
    `as ações do acionista estão integralizadas` IS TRUE
    `as ações do acionista têm valor nominal` IS FALSE

-- Art. 110: "A cada ação ordinária corresponde 1 (um) voto": 100 ordinary shares carry 100 votes.
#ASSERT `o número de votos das ações ordinárias do acionista (art. 110)` `cem ordinárias nominativas (teste art. 110)` FALSE EQUALS JUST 100
#ASSERT `o número de votos das ações ordinárias do acionista (art. 110)` `nenhuma ordinária (teste art. 110)` FALSE EQUALS JUST 0
-- The caput speaks only of ordinary shares; for the others the text says nothing here.
#ASSERT `o número de votos das ações ordinárias do acionista (art. 110)` `cem preferenciais nominativas (teste art. 110)` FALSE EQUALS NOTHING
#ASSERT `o número de votos das ações ordinárias do acionista (art. 110)` `cem de fruição nominativas (teste art. 110)` FALSE EQUALS NOTHING
-- A class with plural vote is governed by Art. 110-A, not by the caput.
#ASSERT `o número de votos das ações ordinárias do acionista (art. 110)` `cem ordinárias nominativas (teste art. 110)` TRUE EQUALS NOTHING

-- Art. 110, § 1º: the estatuto may limit the votes of each shareholder.
#ASSERT `o número de votos do acionista depois da limitação do estatuto (art. 110, § 1º)` 1000 FALSE 500 EQUALS 1000
#ASSERT `o número de votos do acionista depois da limitação do estatuto (art. 110, § 1º)` 1000 TRUE 500 EQUALS 500
#ASSERT `o número de votos do acionista depois da limitação do estatuto (art. 110, § 1º)` 1000 TRUE 1000 EQUALS 1000
#ASSERT `o número de votos do acionista depois da limitação do estatuto (art. 110, § 1º)` 1000 TRUE 1001 EQUALS 1000
#ASSERT `o número de votos do acionista depois da limitação do estatuto (art. 110, § 1º)` 1000 TRUE 999 EQUALS 999
#ASSERT `o número de votos do acionista depois da limitação do estatuto (art. 110, § 1º)` 0 TRUE 500 EQUALS 0

§§ `Art. 111`

-- Caput: a right that Art. 109 makes essential cannot be withheld; any other can (the vote is not among the five).
#ASSERT NOT (`o estatuto pode deixar de conferir à ação preferencial o direito das ordinárias (art. 111)` TRUE)
#ASSERT `o estatuto pode deixar de conferir à ação preferencial o direito das ordinárias (art. 111)` FALSE

`situação três exercícios sem pagamento, prazo 3, não cumulativos (teste art. 111)` MEANS `Dividendos fixos ou mínimos das ações preferenciais (art. 111, § 1º)` WITH
    `o prazo do estatuto em exercícios consecutivos` IS 3
    `os exercícios consecutivos em que a companhia deixou de pagar` IS 3
    `os dividendos são cumulativos` IS FALSE
    `o dividendo do exercício em falta foi pago` IS FALSE
    `os dividendos cumulativos em atraso foram pagos` IS FALSE
    `o estatuto fixa o início da vigência no fim da implantação do empreendimento inicial` IS FALSE
    `o empreendimento inicial da companhia já foi implantado` IS FALSE

`situação dois exercícios sem pagamento, prazo 3 (teste art. 111)` MEANS `Dividendos fixos ou mínimos das ações preferenciais (art. 111, § 1º)` WITH
    `o prazo do estatuto em exercícios consecutivos` IS 3
    `os exercícios consecutivos em que a companhia deixou de pagar` IS 2
    `os dividendos são cumulativos` IS FALSE
    `o dividendo do exercício em falta foi pago` IS FALSE
    `os dividendos cumulativos em atraso foram pagos` IS FALSE
    `o estatuto fixa o início da vigência no fim da implantação do empreendimento inicial` IS FALSE
    `o empreendimento inicial da companhia já foi implantado` IS FALSE

`situação prazo de 4 exercícios no estatuto (teste art. 111)` MEANS `Dividendos fixos ou mínimos das ações preferenciais (art. 111, § 1º)` WITH
    `o prazo do estatuto em exercícios consecutivos` IS 4
    `os exercícios consecutivos em que a companhia deixou de pagar` IS 4
    `os dividendos são cumulativos` IS FALSE
    `o dividendo do exercício em falta foi pago` IS FALSE
    `os dividendos cumulativos em atraso foram pagos` IS FALSE
    `o estatuto fixa o início da vigência no fim da implantação do empreendimento inicial` IS FALSE
    `o empreendimento inicial da companhia já foi implantado` IS FALSE

`situação prazo de zero exercício no estatuto (teste art. 111)` MEANS `Dividendos fixos ou mínimos das ações preferenciais (art. 111, § 1º)` WITH
    `o prazo do estatuto em exercícios consecutivos` IS 0
    `os exercícios consecutivos em que a companhia deixou de pagar` IS 5
    `os dividendos são cumulativos` IS FALSE
    `o dividendo do exercício em falta foi pago` IS FALSE
    `os dividendos cumulativos em atraso foram pagos` IS FALSE
    `o estatuto fixa o início da vigência no fim da implantação do empreendimento inicial` IS FALSE
    `o empreendimento inicial da companhia já foi implantado` IS FALSE

`situação prazo 1 e um exercício sem pagamento (teste art. 111)` MEANS `Dividendos fixos ou mínimos das ações preferenciais (art. 111, § 1º)` WITH
    `o prazo do estatuto em exercícios consecutivos` IS 1
    `os exercícios consecutivos em que a companhia deixou de pagar` IS 1
    `os dividendos são cumulativos` IS FALSE
    `o dividendo do exercício em falta foi pago` IS FALSE
    `os dividendos cumulativos em atraso foram pagos` IS FALSE
    `o estatuto fixa o início da vigência no fim da implantação do empreendimento inicial` IS FALSE
    `o empreendimento inicial da companhia já foi implantado` IS FALSE

`situação quatro exercícios sem pagamento, prazo 3 (teste art. 111)` MEANS `Dividendos fixos ou mínimos das ações preferenciais (art. 111, § 1º)` WITH
    `o prazo do estatuto em exercícios consecutivos` IS 3
    `os exercícios consecutivos em que a companhia deixou de pagar` IS 4
    `os dividendos são cumulativos` IS FALSE
    `o dividendo do exercício em falta foi pago` IS FALSE
    `os dividendos cumulativos em atraso foram pagos` IS FALSE
    `o estatuto fixa o início da vigência no fim da implantação do empreendimento inicial` IS FALSE
    `o empreendimento inicial da companhia já foi implantado` IS FALSE

`situação cumulativos em atraso, não pagos (teste art. 111)` MEANS `Dividendos fixos ou mínimos das ações preferenciais (art. 111, § 1º)` WITH
    `o prazo do estatuto em exercícios consecutivos` IS 3
    `os exercícios consecutivos em que a companhia deixou de pagar` IS 3
    `os dividendos são cumulativos` IS TRUE
    `o dividendo do exercício em falta foi pago` IS FALSE
    `os dividendos cumulativos em atraso foram pagos` IS FALSE
    `o estatuto fixa o início da vigência no fim da implantação do empreendimento inicial` IS FALSE
    `o empreendimento inicial da companhia já foi implantado` IS FALSE

`situação cumulativos, atraso pago (teste art. 111)` MEANS `Dividendos fixos ou mínimos das ações preferenciais (art. 111, § 1º)` WITH
    `o prazo do estatuto em exercícios consecutivos` IS 3
    `os exercícios consecutivos em que a companhia deixou de pagar` IS 3
    `os dividendos são cumulativos` IS TRUE
    `o dividendo do exercício em falta foi pago` IS FALSE
    `os dividendos cumulativos em atraso foram pagos` IS TRUE
    `o estatuto fixa o início da vigência no fim da implantação do empreendimento inicial` IS FALSE
    `o empreendimento inicial da companhia já foi implantado` IS FALSE

`situação não cumulativos, dividendo pago (teste art. 111)` MEANS `Dividendos fixos ou mínimos das ações preferenciais (art. 111, § 1º)` WITH
    `o prazo do estatuto em exercícios consecutivos` IS 3
    `os exercícios consecutivos em que a companhia deixou de pagar` IS 3
    `os dividendos são cumulativos` IS FALSE
    `o dividendo do exercício em falta foi pago` IS TRUE
    `os dividendos cumulativos em atraso foram pagos` IS FALSE
    `o estatuto fixa o início da vigência no fim da implantação do empreendimento inicial` IS FALSE
    `o empreendimento inicial da companhia já foi implantado` IS FALSE

`situação cumulativos, só o do exercício pago, atraso não pago (teste art. 111)` MEANS `Dividendos fixos ou mínimos das ações preferenciais (art. 111, § 1º)` WITH
    `o prazo do estatuto em exercícios consecutivos` IS 3
    `os exercícios consecutivos em que a companhia deixou de pagar` IS 3
    `os dividendos são cumulativos` IS TRUE
    `o dividendo do exercício em falta foi pago` IS TRUE
    `os dividendos cumulativos em atraso foram pagos` IS FALSE
    `o estatuto fixa o início da vigência no fim da implantação do empreendimento inicial` IS FALSE
    `o empreendimento inicial da companhia já foi implantado` IS FALSE

`situação não cumulativos, atraso marcado pago, dividendo não pago (teste art. 111)` MEANS `Dividendos fixos ou mínimos das ações preferenciais (art. 111, § 1º)` WITH
    `o prazo do estatuto em exercícios consecutivos` IS 3
    `os exercícios consecutivos em que a companhia deixou de pagar` IS 3
    `os dividendos são cumulativos` IS FALSE
    `o dividendo do exercício em falta foi pago` IS FALSE
    `os dividendos cumulativos em atraso foram pagos` IS TRUE
    `o estatuto fixa o início da vigência no fim da implantação do empreendimento inicial` IS FALSE
    `o empreendimento inicial da companhia já foi implantado` IS FALSE

`situação vigência adiada, empreendimento não implantado (teste art. 111)` MEANS `Dividendos fixos ou mínimos das ações preferenciais (art. 111, § 1º)` WITH
    `o prazo do estatuto em exercícios consecutivos` IS 3
    `os exercícios consecutivos em que a companhia deixou de pagar` IS 3
    `os dividendos são cumulativos` IS FALSE
    `o dividendo do exercício em falta foi pago` IS FALSE
    `os dividendos cumulativos em atraso foram pagos` IS FALSE
    `o estatuto fixa o início da vigência no fim da implantação do empreendimento inicial` IS TRUE
    `o empreendimento inicial da companhia já foi implantado` IS FALSE

`situação vigência adiada, empreendimento implantado (teste art. 111)` MEANS `Dividendos fixos ou mínimos das ações preferenciais (art. 111, § 1º)` WITH
    `o prazo do estatuto em exercícios consecutivos` IS 3
    `os exercícios consecutivos em que a companhia deixou de pagar` IS 3
    `os dividendos são cumulativos` IS FALSE
    `o dividendo do exercício em falta foi pago` IS FALSE
    `os dividendos cumulativos em atraso foram pagos` IS FALSE
    `o estatuto fixa o início da vigência no fim da implantação do empreendimento inicial` IS TRUE
    `o empreendimento inicial da companhia já foi implantado` IS TRUE

-- § 3º: the estatuto may postpone §§ 1º and 2º until the initial undertaking is implanted.
#ASSERT `os §§ 1º e 2º do art. 111 já vigoram para a companhia (art. 111, § 3º)` `situação três exercícios sem pagamento, prazo 3, não cumulativos (teste art. 111)`
#ASSERT NOT (`os §§ 1º e 2º do art. 111 já vigoram para a companhia (art. 111, § 3º)` `situação vigência adiada, empreendimento não implantado (teste art. 111)`)
#ASSERT `os §§ 1º e 2º do art. 111 já vigoram para a companhia (art. 111, § 3º)` `situação vigência adiada, empreendimento implantado (teste art. 111)`

-- § 1º: preferred shares without the vote acquire it after the company fails to pay for the period in the estatuto
-- (at most 3 consecutive fiscal years), and keep it until payment (non-cumulative) or until the arrears are paid.
#ASSERT `a falta de pagamento dos dividendos faz valer o voto das preferenciais (art. 111, § 1º)` `situação três exercícios sem pagamento, prazo 3, não cumulativos (teste art. 111)` EQUALS JUST TRUE
#ASSERT `a falta de pagamento dos dividendos faz valer o voto das preferenciais (art. 111, § 1º)` `situação dois exercícios sem pagamento, prazo 3 (teste art. 111)` EQUALS JUST FALSE
#ASSERT `a falta de pagamento dos dividendos faz valer o voto das preferenciais (art. 111, § 1º)` `situação prazo de 4 exercícios no estatuto (teste art. 111)` EQUALS NOTHING
#ASSERT `a falta de pagamento dos dividendos faz valer o voto das preferenciais (art. 111, § 1º)` `situação prazo de zero exercício no estatuto (teste art. 111)` EQUALS NOTHING
#ASSERT `a falta de pagamento dos dividendos faz valer o voto das preferenciais (art. 111, § 1º)` `situação prazo 1 e um exercício sem pagamento (teste art. 111)` EQUALS JUST TRUE
#ASSERT `a falta de pagamento dos dividendos faz valer o voto das preferenciais (art. 111, § 1º)` `situação quatro exercícios sem pagamento, prazo 3 (teste art. 111)` EQUALS JUST TRUE
#ASSERT `a falta de pagamento dos dividendos faz valer o voto das preferenciais (art. 111, § 1º)` `situação cumulativos em atraso, não pagos (teste art. 111)` EQUALS JUST TRUE
#ASSERT `a falta de pagamento dos dividendos faz valer o voto das preferenciais (art. 111, § 1º)` `situação cumulativos, atraso pago (teste art. 111)` EQUALS JUST FALSE
#ASSERT `a falta de pagamento dos dividendos faz valer o voto das preferenciais (art. 111, § 1º)` `situação não cumulativos, dividendo pago (teste art. 111)` EQUALS JUST FALSE
#ASSERT `a falta de pagamento dos dividendos faz valer o voto das preferenciais (art. 111, § 1º)` `situação cumulativos, só o do exercício pago, atraso não pago (teste art. 111)` EQUALS JUST TRUE
#ASSERT `a falta de pagamento dos dividendos faz valer o voto das preferenciais (art. 111, § 1º)` `situação não cumulativos, atraso marcado pago, dividendo não pago (teste art. 111)` EQUALS JUST TRUE
#ASSERT `a falta de pagamento dos dividendos faz valer o voto das preferenciais (art. 111, § 1º)` `situação vigência adiada, empreendimento não implantado (teste art. 111)` EQUALS JUST FALSE
#ASSERT `a falta de pagamento dos dividendos faz valer o voto das preferenciais (art. 111, § 1º)` `situação vigência adiada, empreendimento implantado (teste art. 111)` EQUALS JUST TRUE

-- § 2º: same hypothesis and same condition, the limitations on a restricted vote are suspended.
#ASSERT `as limitações ao voto restrito das preferenciais estão suspensas (art. 111, § 2º)` `situação três exercícios sem pagamento, prazo 3, não cumulativos (teste art. 111)` EQUALS JUST TRUE
#ASSERT `as limitações ao voto restrito das preferenciais estão suspensas (art. 111, § 2º)` `situação dois exercícios sem pagamento, prazo 3 (teste art. 111)` EQUALS JUST FALSE
#ASSERT `as limitações ao voto restrito das preferenciais estão suspensas (art. 111, § 2º)` `situação prazo de 4 exercícios no estatuto (teste art. 111)` EQUALS NOTHING
#ASSERT `as limitações ao voto restrito das preferenciais estão suspensas (art. 111, § 2º)` `situação prazo de zero exercício no estatuto (teste art. 111)` EQUALS NOTHING
#ASSERT `as limitações ao voto restrito das preferenciais estão suspensas (art. 111, § 2º)` `situação prazo 1 e um exercício sem pagamento (teste art. 111)` EQUALS JUST TRUE
#ASSERT `as limitações ao voto restrito das preferenciais estão suspensas (art. 111, § 2º)` `situação quatro exercícios sem pagamento, prazo 3 (teste art. 111)` EQUALS JUST TRUE
#ASSERT `as limitações ao voto restrito das preferenciais estão suspensas (art. 111, § 2º)` `situação cumulativos em atraso, não pagos (teste art. 111)` EQUALS JUST TRUE
#ASSERT `as limitações ao voto restrito das preferenciais estão suspensas (art. 111, § 2º)` `situação cumulativos, atraso pago (teste art. 111)` EQUALS JUST FALSE
#ASSERT `as limitações ao voto restrito das preferenciais estão suspensas (art. 111, § 2º)` `situação não cumulativos, dividendo pago (teste art. 111)` EQUALS JUST FALSE
#ASSERT `as limitações ao voto restrito das preferenciais estão suspensas (art. 111, § 2º)` `situação cumulativos, só o do exercício pago, atraso não pago (teste art. 111)` EQUALS JUST TRUE
#ASSERT `as limitações ao voto restrito das preferenciais estão suspensas (art. 111, § 2º)` `situação não cumulativos, atraso marcado pago, dividendo não pago (teste art. 111)` EQUALS JUST TRUE
#ASSERT `as limitações ao voto restrito das preferenciais estão suspensas (art. 111, § 2º)` `situação vigência adiada, empreendimento não implantado (teste art. 111)` EQUALS JUST FALSE
#ASSERT `as limitações ao voto restrito das preferenciais estão suspensas (art. 111, § 2º)` `situação vigência adiada, empreendimento implantado (teste art. 111)` EQUALS JUST TRUE

§§ `Art. 112`

-- Caput: nominative, endorsable and book-entry shares may vote; bearer shares may not.
#ASSERT `o titular das ações pode exercer o direito de voto quanto à forma da ação (art. 112)` `ações nominativas`
#ASSERT `o titular das ações pode exercer o direito de voto quanto à forma da ação (art. 112)` `ações endossáveis`
#ASSERT `o titular das ações pode exercer o direito de voto quanto à forma da ação (art. 112)` `ações escriturais`
#ASSERT NOT (`o titular das ações pode exercer o direito de voto quanto à forma da ação (art. 112)` `ações ao portador`)

`cem preferenciais ao portador (teste art. 112)` MEANS `Participação do acionista` WITH
    `a espécie das ações` IS `ações preferenciais`
    `a forma das ações` IS `ações ao portador`
    `a quantidade de ações do acionista` IS 100
    `as ações do acionista estão integralizadas` IS TRUE
    `as ações do acionista têm valor nominal` IS FALSE

`cem ordinárias ao portador (teste art. 112)` MEANS `Participação do acionista` WITH
    `a espécie das ações` IS `ações ordinárias`
    `a forma das ações` IS `ações ao portador`
    `a quantidade de ações do acionista` IS 100
    `as ações do acionista estão integralizadas` IS TRUE
    `as ações do acionista têm valor nominal` IS FALSE

-- Parágrafo único: bearer preferred shares that acquired the vote under Art. 111, §§ 1º or 2º, may be converted.
#ASSERT `o titular pode converter as ações em nominativas ou endossáveis sem autorização do estatuto (art. 112, parágrafo único)` `cem preferenciais ao portador (teste art. 112)` TRUE EQUALS JUST TRUE
#ASSERT `o titular pode converter as ações em nominativas ou endossáveis sem autorização do estatuto (art. 112, parágrafo único)` `cem preferenciais ao portador (teste art. 112)` FALSE EQUALS NOTHING
#ASSERT `o titular pode converter as ações em nominativas ou endossáveis sem autorização do estatuto (art. 112, parágrafo único)` `cem ordinárias ao portador (teste art. 112)` TRUE EQUALS NOTHING
#ASSERT `o titular pode converter as ações em nominativas ou endossáveis sem autorização do estatuto (art. 112, parágrafo único)` `cem preferenciais nominativas (teste art. 110)` TRUE EQUALS NOTHING

§§ `Art. 113`

-- Caput: the pledge does not stop the vote; the contract may require the pledgee's consent for certain matters.
#ASSERT `o acionista pode votar com as ações empenhadas (art. 113)` FALSE FALSE
#ASSERT `o acionista pode votar com as ações empenhadas (art. 113)` FALSE TRUE
#ASSERT `o acionista pode votar com as ações empenhadas (art. 113)` TRUE TRUE
#ASSERT NOT (`o acionista pode votar com as ações empenhadas (art. 113)` TRUE FALSE)
-- Parágrafo único: the fiduciary creditor cannot vote; the debtor only as the contract provides.
#ASSERT `o credor fiduciário pode exercer o direito de voto (art. 113, parágrafo único)` TRUE EQUALS JUST FALSE
#ASSERT `o credor fiduciário pode exercer o direito de voto (art. 113, parágrafo único)` FALSE EQUALS NOTHING
#ASSERT `o devedor fiduciante pode exercer o direito de voto (art. 113, parágrafo único)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o devedor fiduciante pode exercer o direito de voto (art. 113, parágrafo único)` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o devedor fiduciante pode exercer o direito de voto (art. 113, parágrafo único)` FALSE TRUE EQUALS NOTHING

§§ `Art. 114`

-- If the act that created the usufruct does not regulate the vote, it can be exercised only after agreement between the
-- owner and the usufructuary; if it does regulate it, the text says nothing more.
#ASSERT `o voto da ação com usufruto pode ser exercido (art. 114)` FALSE TRUE EQUALS JUST TRUE
#ASSERT `o voto da ação com usufruto pode ser exercido (art. 114)` FALSE FALSE EQUALS JUST FALSE
#ASSERT `o voto da ação com usufruto pode ser exercido (art. 114)` TRUE TRUE EQUALS NOTHING
#ASSERT `o voto da ação com usufruto pode ser exercido (art. 114)` TRUE FALSE EQUALS NOTHING

§§ `Art. 115`

`voto para causar dano (teste art. 115)` MEANS `Fatos do voto (art. 115)` WITH
    `o voto foi dado com o fim de causar dano à companhia ou a outros acionistas` IS TRUE
    `o voto foi dado com o fim de obter vantagem a que o acionista não faz jus, para si ou para outrem` IS FALSE
    `da vantagem resulta, ou pode resultar, prejuízo para a companhia ou para outros acionistas` IS FALSE

`voto por vantagem indevida com prejuízo (teste art. 115)` MEANS `Fatos do voto (art. 115)` WITH
    `o voto foi dado com o fim de causar dano à companhia ou a outros acionistas` IS FALSE
    `o voto foi dado com o fim de obter vantagem a que o acionista não faz jus, para si ou para outrem` IS TRUE
    `da vantagem resulta, ou pode resultar, prejuízo para a companhia ou para outros acionistas` IS TRUE

`voto por vantagem indevida sem prejuízo (teste art. 115)` MEANS `Fatos do voto (art. 115)` WITH
    `o voto foi dado com o fim de causar dano à companhia ou a outros acionistas` IS FALSE
    `o voto foi dado com o fim de obter vantagem a que o acionista não faz jus, para si ou para outrem` IS TRUE
    `da vantagem resulta, ou pode resultar, prejuízo para a companhia ou para outros acionistas` IS FALSE

`voto sem fim abusivo mas com prejuízo (teste art. 115)` MEANS `Fatos do voto (art. 115)` WITH
    `o voto foi dado com o fim de causar dano à companhia ou a outros acionistas` IS FALSE
    `o voto foi dado com o fim de obter vantagem a que o acionista não faz jus, para si ou para outrem` IS FALSE
    `da vantagem resulta, ou pode resultar, prejuízo para a companhia ou para outros acionistas` IS TRUE

`voto sem fim abusivo e sem prejuízo (teste art. 115)` MEANS `Fatos do voto (art. 115)` WITH
    `o voto foi dado com o fim de causar dano à companhia ou a outros acionistas` IS FALSE
    `o voto foi dado com o fim de obter vantagem a que o acionista não faz jus, para si ou para outrem` IS FALSE
    `da vantagem resulta, ou pode resultar, prejuízo para a companhia ou para outros acionistas` IS FALSE

-- Caput: abusive is the vote cast to cause damage, or to obtain an undue advantage that results or may result in prejudice.
#ASSERT `o voto é abusivo (art. 115)` `voto para causar dano (teste art. 115)`
#ASSERT `o voto é abusivo (art. 115)` `voto por vantagem indevida com prejuízo (teste art. 115)`
#ASSERT NOT (`o voto é abusivo (art. 115)` `voto por vantagem indevida sem prejuízo (teste art. 115)`)
#ASSERT NOT (`o voto é abusivo (art. 115)` `voto sem fim abusivo mas com prejuízo (teste art. 115)`)
#ASSERT NOT (`o voto é abusivo (art. 115)` `voto sem fim abusivo e sem prejuízo (teste art. 115)`)
-- The duty to vote in the company's interest: the text names only the abusive vote as a breach.
#ASSERT `o voto contraria o dever de votar no interesse da companhia (art. 115)` `voto para causar dano (teste art. 115)` EQUALS JUST TRUE
#ASSERT `o voto contraria o dever de votar no interesse da companhia (art. 115)` `voto sem fim abusivo e sem prejuízo (teste art. 115)` EQUALS NOTHING

-- § 1º: each of the four grounds of impediment, and none.
#ASSERT `o acionista está impedido de votar a deliberação (art. 115, § 1º)` TRUE FALSE FALSE FALSE
#ASSERT `o acionista está impedido de votar a deliberação (art. 115, § 1º)` FALSE TRUE FALSE FALSE
#ASSERT `o acionista está impedido de votar a deliberação (art. 115, § 1º)` FALSE FALSE TRUE FALSE
#ASSERT `o acionista está impedido de votar a deliberação (art. 115, § 1º)` FALSE FALSE FALSE TRUE
#ASSERT NOT (`o acionista está impedido de votar a deliberação (art. 115, § 1º)` FALSE FALSE FALSE FALSE)
-- § 2º: the subscribers may approve the valuation report if they are all co-owners of what they contributed.
#ASSERT `os subscritores condôminos podem aprovar o laudo de avaliação (art. 115, § 2º)` TRUE TRUE
#ASSERT NOT (`os subscritores condôminos podem aprovar o laudo de avaliação (art. 115, § 2º)` TRUE FALSE)
#ASSERT NOT (`os subscritores condôminos podem aprovar o laudo de avaliação (art. 115, § 2º)` FALSE TRUE)
-- §§ 1º and 2º together.
#ASSERT `o acionista pode votar a deliberação (art. 115, §§ 1º e 2º)` TRUE TRUE FALSE FALSE FALSE
#ASSERT NOT (`o acionista pode votar a deliberação (art. 115, §§ 1º e 2º)` TRUE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`o acionista pode votar a deliberação (art. 115, §§ 1º e 2º)` TRUE TRUE TRUE FALSE FALSE)
#ASSERT NOT (`o acionista pode votar a deliberação (art. 115, §§ 1º e 2º)` TRUE TRUE FALSE TRUE FALSE)
#ASSERT NOT (`o acionista pode votar a deliberação (art. 115, §§ 1º e 2º)` TRUE TRUE FALSE FALSE TRUE)
#ASSERT NOT (`o acionista pode votar a deliberação (art. 115, §§ 1º e 2º)` FALSE FALSE TRUE FALSE FALSE)
#ASSERT `o acionista pode votar a deliberação (art. 115, §§ 1º e 2º)` FALSE FALSE FALSE FALSE FALSE
-- § 3º: liability for the damage of an abusive vote, whether or not it prevailed (so the rule does not ask).
#ASSERT `o acionista responde pelos danos do voto abusivo (art. 115, § 3º)` TRUE TRUE
#ASSERT NOT (`o acionista responde pelos danos do voto abusivo (art. 115, § 3º)` TRUE FALSE)
#ASSERT NOT (`o acionista responde pelos danos do voto abusivo (art. 115, § 3º)` FALSE TRUE)
-- § 4º: the deliberation taken from the vote of a conflicted shareholder is voidable; he answers for damages and
-- transfers the advantages.
#ASSERT `a deliberação é anulável pelo voto em conflito de interesses (art. 115, § 4º)` TRUE EQUALS JUST TRUE
#ASSERT `a deliberação é anulável pelo voto em conflito de interesses (art. 115, § 4º)` FALSE EQUALS NOTHING
#ASSERT `o acionista com interesse conflitante responde pelos danos da deliberação (art. 115, § 4º)` TRUE TRUE
#ASSERT NOT (`o acionista com interesse conflitante responde pelos danos da deliberação (art. 115, § 4º)` TRUE FALSE)
#ASSERT NOT (`o acionista com interesse conflitante responde pelos danos da deliberação (art. 115, § 4º)` FALSE TRUE)
#ASSERT `o acionista com interesse conflitante deve transferir à companhia as vantagens auferidas em reais (art. 115, § 4º)` TRUE 5000 EQUALS JUST 5000
#ASSERT `o acionista com interesse conflitante deve transferir à companhia as vantagens auferidas em reais (art. 115, § 4º)` FALSE 5000 EQUALS NOTHING
