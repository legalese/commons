-- I: using the opportunity is the breach, with or without harm.
#ASSERT NOT (`a conduta infringe o inciso I (art. 155, inciso I)` `[teste br4] lealdade: conduta correta`)
#ASSERT `a conduta infringe o inciso I (art. 155, inciso I)` `[teste br4] lealdade: usou oportunidade sem causar prejuízo`
#ASSERT `a conduta infringe o inciso I (art. 155, inciso I)` `[teste br4] lealdade: usou oportunidade e causou prejuízo`
-- II: omission alone, or a missed opportunity only if he aimed at an advantage.
#ASSERT `a conduta infringe o inciso II (art. 155, inciso II)` `[teste br4] lealdade: omitiu-se na proteção de direitos`
#ASSERT NOT (`a conduta infringe o inciso II (art. 155, inciso II)` `[teste br4] lealdade: deixou de aproveitar oportunidade sem visar vantagem`)
#ASSERT `a conduta infringe o inciso II (art. 155, inciso II)` `[teste br4] lealdade: deixou de aproveitar oportunidade visando vantagem`
-- III: to resell at a profit what he knows the company needs or intends to acquire.
#ASSERT `a conduta infringe o inciso III (art. 155, inciso III)` `[teste br4] lealdade: adquiriu para revender bem que a companhia tenciona adquirir`
#ASSERT NOT (`a conduta infringe o inciso III (art. 155, inciso III)` `[teste br4] lealdade: adquiriu para revender sem saber da necessidade da companhia`)
-- caput: loyalty needs reserve and none of I to III.
#ASSERT `o administrador cumpriu o dever de lealdade (art. 155)` `[teste br4] lealdade: conduta correta`
#ASSERT NOT (`o administrador cumpriu o dever de lealdade (art. 155)` `[teste br4] lealdade: sem reserva sobre os negócios`)
#ASSERT NOT (`o administrador cumpriu o dever de lealdade (art. 155)` `[teste br4] lealdade: usou oportunidade sem causar prejuízo`)
#ASSERT NOT (`o administrador cumpriu o dever de lealdade (art. 155)` `[teste br4] lealdade: omitiu-se na proteção de direitos`)
#ASSERT NOT (`o administrador cumpriu o dever de lealdade (art. 155)` `[teste br4] lealdade: adquiriu para revender bem que a companhia tenciona adquirir`)

`[teste br4] informação: relevante, não divulgada, obtida pelo cargo` MEANS `Informação do administrador (art. 155, § 1º)` WITH
    `a informação ainda não foi divulgada para conhecimento do mercado` IS TRUE
    `a informação foi obtida em razão do cargo` IS TRUE
    `a informação é capaz de influir de modo ponderável na cotação de valores mobiliários` IS TRUE

`[teste br4] informação: já divulgada` MEANS `Informação do administrador (art. 155, § 1º)` WITH
    `a informação ainda não foi divulgada para conhecimento do mercado` IS FALSE
    `a informação foi obtida em razão do cargo` IS TRUE
    `a informação é capaz de influir de modo ponderável na cotação de valores mobiliários` IS TRUE

`[teste br4] informação: sem influência ponderável` MEANS `Informação do administrador (art. 155, § 1º)` WITH
    `a informação ainda não foi divulgada para conhecimento do mercado` IS TRUE
    `a informação foi obtida em razão do cargo` IS TRUE
    `a informação é capaz de influir de modo ponderável na cotação de valores mobiliários` IS FALSE

-- § 1º: the duty of secrecy is the open company's, for information that meets all three conditions.
#ASSERT `o administrador deve guardar sigilo sobre a informação (art. 155, § 1º)` `companhia aberta` `[teste br4] informação: relevante, não divulgada, obtida pelo cargo`
#ASSERT NOT (`o administrador deve guardar sigilo sobre a informação (art. 155, § 1º)` `companhia fechada` `[teste br4] informação: relevante, não divulgada, obtida pelo cargo`)
#ASSERT NOT (`o administrador deve guardar sigilo sobre a informação (art. 155, § 1º)` `companhia aberta` `[teste br4] informação: já divulgada`)
#ASSERT NOT (`o administrador deve guardar sigilo sobre a informação (art. 155, § 1º)` `companhia aberta` `[teste br4] informação: sem influência ponderável`)
#ASSERT `é vedado ao administrador valer-se da informação (art. 155, § 1º)` `companhia aberta` `[teste br4] informação: relevante, não divulgada, obtida pelo cargo` TRUE
#ASSERT NOT (`é vedado ao administrador valer-se da informação (art. 155, § 1º)` `companhia aberta` `[teste br4] informação: relevante, não divulgada, obtida pelo cargo` FALSE)
#ASSERT NOT (`é vedado ao administrador valer-se da informação (art. 155, § 1º)` `companhia aberta` `[teste br4] informação: já divulgada` TRUE)
-- §§ 2º to 4º.
#ASSERT `o administrador cumpriu o dever de zelar (art. 155, § 2º)` TRUE
#ASSERT NOT (`o administrador cumpriu o dever de zelar (art. 155, § 2º)` FALSE)
#ASSERT `a pessoa prejudicada tem direito a indenização por perdas e danos (art. 155, § 3º)` TRUE TRUE FALSE
#ASSERT NOT (`a pessoa prejudicada tem direito a indenização por perdas e danos (art. 155, § 3º)` TRUE TRUE TRUE)
#ASSERT NOT (`a pessoa prejudicada tem direito a indenização por perdas e danos (art. 155, § 3º)` FALSE TRUE FALSE)
#ASSERT NOT (`a pessoa prejudicada tem direito a indenização por perdas e danos (art. 155, § 3º)` TRUE FALSE FALSE)
#ASSERT `a utilização da informação relevante é vedada (art. 155, § 4º)` TRUE TRUE
#ASSERT NOT (`a utilização da informação relevante é vedada (art. 155, § 4º)` TRUE FALSE)
#ASSERT NOT (`a utilização da informação relevante é vedada (art. 155, § 4º)` FALSE TRUE)

§ `Testes do art. 156`

#ASSERT `o administrador está impedido de intervir na operação e na deliberação (art. 156)` TRUE
#ASSERT NOT (`o administrador está impedido de intervir na operação e na deliberação (art. 156)` FALSE)
#ASSERT `o administrador cumpriu o dever de cientificar e fazer consignar em ata (art. 156)` TRUE TRUE TRUE
#ASSERT `o administrador cumpriu o dever de cientificar e fazer consignar em ata (art. 156)` FALSE FALSE FALSE
#ASSERT NOT (`o administrador cumpriu o dever de cientificar e fazer consignar em ata (art. 156)` TRUE TRUE FALSE)
#ASSERT NOT (`o administrador cumpriu o dever de cientificar e fazer consignar em ata (art. 156)` TRUE FALSE TRUE)
#ASSERT `o administrador pode contratar com a companhia nessas condições (art. 156, § 1º)` TRUE
#ASSERT NOT (`o administrador pode contratar com a companhia nessas condições (art. 156, § 1º)` FALSE)
#ASSERT `o negócio é anulável (art. 156, § 2º)` FALSE
#ASSERT NOT (`o negócio é anulável (art. 156, § 2º)` TRUE)
#ASSERT `o valor que o administrador deve transferir para a companhia, em reais (art. 156, § 2º)` FALSE 800 EQUALS 800
#ASSERT `o valor que o administrador deve transferir para a companhia, em reais (art. 156, § 2º)` TRUE 800 EQUALS 0

§ `Testes do art. 157`

#ASSERT `o administrador deve declarar os valores mobiliários que titulariza (art. 157)` `companhia aberta`
#ASSERT NOT (`o administrador deve declarar os valores mobiliários que titulariza (art. 157)` `companhia fechada`)
#ASSERT `o administrador cumpriu o dever de declarar os valores mobiliários (art. 157)` `companhia aberta` TRUE
#ASSERT NOT (`o administrador cumpriu o dever de declarar os valores mobiliários (art. 157)` `companhia aberta` FALSE)
#ASSERT `o administrador cumpriu o dever de declarar os valores mobiliários (art. 157)` `companhia fechada` FALSE
-- § 1º: five matters; 5% of the capital (50,000 of 1,000,000 is enough, 49,999 is not).
#ASSERT `as matérias que o administrador deve revelar (art. 157, § 1º)` EQUALS LIST `valores mobiliários adquiridos ou alienados no exercício anterior (art. 157, § 1º, alínea a)`, `opções de compra de ações contratadas ou exercidas no exercício anterior (art. 157, § 1º, alínea b)`, `benefícios ou vantagens, indiretas ou complementares, recebidos ou em recebimento (art. 157, § 1º, alínea c)`, `condições dos contratos de trabalho com diretores e empregados de alto nível (art. 157, § 1º, alínea d)`, `atos ou fatos relevantes nas atividades da companhia (art. 157, § 1º, alínea e)`
#ASSERT `o administrador é obrigado a revelar à assembleia-geral ordinária (art. 157, § 1º)` `companhia aberta` 50000 1000000 TRUE
#ASSERT NOT (`o administrador é obrigado a revelar à assembleia-geral ordinária (art. 157, § 1º)` `companhia aberta` 49999 1000000 TRUE)
#ASSERT NOT (`o administrador é obrigado a revelar à assembleia-geral ordinária (art. 157, § 1º)` `companhia fechada` 50000 1000000 TRUE)
#ASSERT NOT (`o administrador é obrigado a revelar à assembleia-geral ordinária (art. 157, § 1º)` `companhia aberta` 50000 1000000 FALSE)
-- §§ 2º, 3º.
#ASSERT `os esclarecimentos devem ser reduzidos a escrito, autenticados pela mesa e fornecidos por cópia (art. 157, § 2º)` TRUE
#ASSERT NOT (`os esclarecimentos devem ser reduzidos a escrito, autenticados pela mesa e fornecidos por cópia (art. 157, § 2º)` FALSE)
#ASSERT `os solicitantes respondem pelos abusos (art. 157, § 3º)` FALSE
#ASSERT NOT (`os solicitantes respondem pelos abusos (art. 157, § 3º)` TRUE)
-- § 4º.
#ASSERT `os administradores devem comunicar à bolsa e divulgar pela imprensa (art. 157, § 4º)` `companhia aberta` TRUE
#ASSERT NOT (`os administradores devem comunicar à bolsa e divulgar pela imprensa (art. 157, § 4º)` `companhia aberta` FALSE)
#ASSERT NOT (`os administradores devem comunicar à bolsa e divulgar pela imprensa (art. 157, § 4º)` `companhia fechada` TRUE)
#ASSERT `os administradores cumpriram o dever de comunicar e divulgar (art. 157, § 4º)` TRUE TRUE
#ASSERT NOT (`os administradores cumpriram o dever de comunicar e divulgar (art. 157, § 4º)` TRUE FALSE)
#ASSERT NOT (`os administradores cumpriram o dever de comunicar e divulgar (art. 157, § 4º)` FALSE TRUE)
-- § 5º: refusal only for the information of § 1, alínea e, or § 4, and only if the risk is judged to exist.
#ASSERT `os administradores podem recusar-se a prestar ou a divulgar a informação (art. 157, § 5º)` `atos ou fatos relevantes nas atividades da companhia (art. 157, § 1º, alínea e)` FALSE TRUE
#ASSERT `os administradores podem recusar-se a prestar ou a divulgar a informação (art. 157, § 5º)` `condições dos contratos de trabalho com diretores e empregados de alto nível (art. 157, § 1º, alínea d)` TRUE TRUE
#ASSERT NOT (`os administradores podem recusar-se a prestar ou a divulgar a informação (art. 157, § 5º)` `condições dos contratos de trabalho com diretores e empregados de alto nível (art. 157, § 1º, alínea d)` FALSE TRUE)
#ASSERT NOT (`os administradores podem recusar-se a prestar ou a divulgar a informação (art. 157, § 5º)` `atos ou fatos relevantes nas atividades da companhia (art. 157, § 1º, alínea e)` FALSE FALSE)
#ASSERT `quem decide sobre a prestação de informação e responsabiliza os administradores (art. 157, § 5º)` EQUALS `a Comissão de Valores Mobiliários`
-- § 6º.
#ASSERT `os administradores devem informar a CVM e as bolsas (art. 157, § 6º)` `companhia aberta` TRUE
#ASSERT NOT (`os administradores devem informar a CVM e as bolsas (art. 157, § 6º)` `companhia aberta` FALSE)
#ASSERT NOT (`os administradores devem informar a CVM e as bolsas (art. 157, § 6º)` `companhia fechada` TRUE)

§ `Testes do art. 158`

#ASSERT `o administrador é pessoalmente responsável pelas obrigações contraídas em nome da sociedade (art. 158)` FALSE
#ASSERT NOT (`o administrador é pessoalmente responsável pelas obrigações contraídas em nome da sociedade (art. 158)` TRUE)
-- I: inside his powers, with fault or intent; II: in breach of the law or the estatuto, whether inside his powers or not.
#ASSERT `o administrador responde civilmente pelos prejuízos que causar (art. 158, incisos I e II)` TRUE TRUE FALSE FALSE
#ASSERT `o administrador responde civilmente pelos prejuízos que causar (art. 158, incisos I e II)` TRUE FALSE TRUE FALSE
#ASSERT NOT (`o administrador responde civilmente pelos prejuízos que causar (art. 158, incisos I e II)` TRUE FALSE FALSE FALSE)
