IMPORT prelude
IMPORT `br-core`
IMPORT `br4-deveres`

-- br4-tests-deveres.l4 -- tests of br4-deveres.l4 (arts. 153 to 160).
-- Every expected value was decided from the text of the article, written beside the assertion, and then run.

§ `Testes dos arts. 153 e 154`

#ASSERT `o administrador cumpriu o dever de diligência (art. 153)` TRUE
#ASSERT NOT (`o administrador cumpriu o dever de diligência (art. 153)` FALSE)
#ASSERT `o administrador exerceu as atribuições com a finalidade que a lei exige (art. 154)` TRUE TRUE
#ASSERT NOT (`o administrador exerceu as atribuições com a finalidade que a lei exige (art. 154)` TRUE FALSE)
#ASSERT NOT (`o administrador exerceu as atribuições com a finalidade que a lei exige (art. 154)` FALSE TRUE)
-- § 1º: the elector's interest excuses nothing; what counts is whether he kept the duties.
#ASSERT `o administrador eleito por grupo ou classe cumpriu o dever para com a companhia (art. 154, § 1º)` TRUE TRUE TRUE
#ASSERT `o administrador eleito por grupo ou classe cumpriu o dever para com a companhia (art. 154, § 1º)` TRUE TRUE FALSE
#ASSERT NOT (`o administrador eleito por grupo ou classe cumpriu o dever para com a companhia (art. 154, § 1º)` TRUE FALSE TRUE)
#ASSERT NOT (`o administrador eleito por grupo ou classe cumpriu o dever para com a companhia (art. 154, § 1º)` TRUE FALSE FALSE)
-- § 4º: all four conditions.
#ASSERT `o ato gratuito é autorizável pelo conselho ou pela diretoria (art. 154, § 4º)` TRUE TRUE TRUE TRUE
#ASSERT NOT (`o ato gratuito é autorizável pelo conselho ou pela diretoria (art. 154, § 4º)` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`o ato gratuito é autorizável pelo conselho ou pela diretoria (art. 154, § 4º)` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`o ato gratuito é autorizável pelo conselho ou pela diretoria (art. 154, § 4º)` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`o ato gratuito é autorizável pelo conselho ou pela diretoria (art. 154, § 4º)` TRUE TRUE TRUE FALSE)
-- § 2º, a: liberality is forbidden unless § 4 authorises it.
#ASSERT `o ato é vedado ao administrador (art. 154, § 2º, alínea a)` TRUE FALSE FALSE FALSE FALSE
#ASSERT `o ato é vedado ao administrador (art. 154, § 2º, alínea a)` TRUE TRUE TRUE TRUE FALSE
#ASSERT NOT (`o ato é vedado ao administrador (art. 154, § 2º, alínea a)` TRUE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`o ato é vedado ao administrador (art. 154, § 2º, alínea a)` FALSE FALSE FALSE FALSE FALSE)
-- § 2º, b: borrowing or using for his benefit, unless the assembly or the board authorised it first.
#ASSERT `o ato é vedado ao administrador (art. 154, § 2º, alínea b)` TRUE FALSE FALSE FALSE
#ASSERT `o ato é vedado ao administrador (art. 154, § 2º, alínea b)` FALSE TRUE FALSE FALSE
#ASSERT NOT (`o ato é vedado ao administrador (art. 154, § 2º, alínea b)` TRUE FALSE TRUE FALSE)
#ASSERT NOT (`o ato é vedado ao administrador (art. 154, § 2º, alínea b)` FALSE TRUE FALSE TRUE)
#ASSERT NOT (`o ato é vedado ao administrador (art. 154, § 2º, alínea b)` FALSE FALSE FALSE FALSE)
-- § 2º, c: a personal advantage from third parties, unless the estatuto or the assembly authorised.
#ASSERT `o ato é vedado ao administrador (art. 154, § 2º, alínea c)` TRUE FALSE FALSE
#ASSERT NOT (`o ato é vedado ao administrador (art. 154, § 2º, alínea c)` TRUE TRUE FALSE)
#ASSERT NOT (`o ato é vedado ao administrador (art. 154, § 2º, alínea c)` TRUE FALSE TRUE)
#ASSERT NOT (`o ato é vedado ao administrador (art. 154, § 2º, alínea c)` FALSE FALSE FALSE)
-- § 3º: what was received in breach belongs to the company.
#ASSERT `a importância que pertence à companhia, em reais (art. 154, § 3º)` TRUE 1500 EQUALS 1500
#ASSERT `a importância que pertence à companhia, em reais (art. 154, § 3º)` FALSE 1500 EQUALS 0

§ `Testes do art. 155`

`[teste br4] lealdade: conduta correta` MEANS `Conduta do administrador quanto à lealdade (art. 155)` WITH
    `o administrador manteve reserva sobre os negócios da companhia` IS TRUE
    `o administrador usou, em benefício próprio ou de outrem, oportunidade comercial de que teve conhecimento em razão do cargo` IS FALSE
    `o uso da oportunidade causou prejuízo à companhia` IS FALSE
    `o administrador se omitiu no exercício ou proteção de direitos da companhia` IS FALSE
    `o administrador deixou de aproveitar oportunidade de negócio de interesse da companhia` IS FALSE
    `o administrador visava obter vantagem para si ou para outrem` IS FALSE
    `o administrador adquiriu bem ou direito para revender com lucro` IS FALSE
    `o administrador sabia que o bem ou direito é necessário à companhia` IS FALSE
    `o administrador sabia que a companhia tenciona adquirir o bem ou direito` IS FALSE

`[teste br4] lealdade: usou oportunidade sem causar prejuízo` MEANS `Conduta do administrador quanto à lealdade (art. 155)` WITH
    `o administrador manteve reserva sobre os negócios da companhia` IS TRUE
    `o administrador usou, em benefício próprio ou de outrem, oportunidade comercial de que teve conhecimento em razão do cargo` IS TRUE
    `o uso da oportunidade causou prejuízo à companhia` IS FALSE
    `o administrador se omitiu no exercício ou proteção de direitos da companhia` IS FALSE
    `o administrador deixou de aproveitar oportunidade de negócio de interesse da companhia` IS FALSE
    `o administrador visava obter vantagem para si ou para outrem` IS FALSE
    `o administrador adquiriu bem ou direito para revender com lucro` IS FALSE
    `o administrador sabia que o bem ou direito é necessário à companhia` IS FALSE
    `o administrador sabia que a companhia tenciona adquirir o bem ou direito` IS FALSE

`[teste br4] lealdade: usou oportunidade e causou prejuízo` MEANS `Conduta do administrador quanto à lealdade (art. 155)` WITH
    `o administrador manteve reserva sobre os negócios da companhia` IS TRUE
    `o administrador usou, em benefício próprio ou de outrem, oportunidade comercial de que teve conhecimento em razão do cargo` IS TRUE
    `o uso da oportunidade causou prejuízo à companhia` IS TRUE
    `o administrador se omitiu no exercício ou proteção de direitos da companhia` IS FALSE
    `o administrador deixou de aproveitar oportunidade de negócio de interesse da companhia` IS FALSE
    `o administrador visava obter vantagem para si ou para outrem` IS FALSE
    `o administrador adquiriu bem ou direito para revender com lucro` IS FALSE
    `o administrador sabia que o bem ou direito é necessário à companhia` IS FALSE
    `o administrador sabia que a companhia tenciona adquirir o bem ou direito` IS FALSE

`[teste br4] lealdade: omitiu-se na proteção de direitos` MEANS `Conduta do administrador quanto à lealdade (art. 155)` WITH
