#ASSERT NOT (`os acionistas podem propor a ação contra a deliberação da assembleia (art. 159, § 4º)` TRUE 4999 100000)
#ASSERT NOT (`os acionistas podem propor a ação contra a deliberação da assembleia (art. 159, § 4º)` FALSE 5000 100000)
-- § 5º: the results go to the company, which indemnifies the shareholder up to the results.
