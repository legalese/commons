#ASSERT `a companhia pode propor a ação de responsabilidade civil (art. 159)` TRUE TRUE
#ASSERT NOT (`a companhia pode propor a ação de responsabilidade civil (art. 159)` FALSE TRUE)
#ASSERT NOT (`a companhia pode propor a ação de responsabilidade civil (art. 159)` TRUE FALSE)
-- § 1º: ordinary meeting; extraordinary only if on the agenda or a direct consequence; special meeting not mentioned.
#ASSERT `a deliberação pode ser tomada na assembleia (art. 159, § 1º)` `assembleia-geral ordinária` FALSE FALSE EQUALS JUST TRUE
#ASSERT `a deliberação pode ser tomada na assembleia (art. 159, § 1º)` `assembleia-geral extraordinária` TRUE FALSE EQUALS JUST TRUE
#ASSERT `a deliberação pode ser tomada na assembleia (art. 159, § 1º)` `assembleia-geral extraordinária` FALSE TRUE EQUALS JUST TRUE
#ASSERT `a deliberação pode ser tomada na assembleia (art. 159, § 1º)` `assembleia-geral extraordinária` FALSE FALSE EQUALS JUST FALSE
#ASSERT `a deliberação pode ser tomada na assembleia (art. 159, § 1º)` `assembleia especial` TRUE TRUE EQUALS NOTHING
