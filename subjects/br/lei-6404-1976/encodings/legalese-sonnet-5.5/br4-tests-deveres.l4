#ASSERT NOT (`o administrador fica impedido e deve ser substituído na mesma assembleia (art. 159, § 2º)` FALSE)
-- § 3º: deliberation on 15 January 2026: the company has until 15 April 2026; a shareholder may act from 16 April.
#ASSERT NOT (`qualquer acionista pode promover a ação (art. 159, § 3º)` TRUE FALSE (YMD 2026 1 15) (YMD 2026 4 15))
#ASSERT `qualquer acionista pode promover a ação (art. 159, § 3º)` TRUE FALSE (YMD 2026 1 15) (YMD 2026 4 16)
#ASSERT NOT (`qualquer acionista pode promover a ação (art. 159, § 3º)` TRUE TRUE (YMD 2026 1 15) (YMD 2026 5 1))
#ASSERT NOT (`qualquer acionista pode promover a ação (art. 159, § 3º)` FALSE FALSE (YMD 2026 1 15) (YMD 2026 5 1))
#ASSERT NOT (`qualquer acionista pode promover a ação (art. 159, § 3º)` TRUE FALSE (YMD 2026 1 15) (YMD 2026 1 10))
