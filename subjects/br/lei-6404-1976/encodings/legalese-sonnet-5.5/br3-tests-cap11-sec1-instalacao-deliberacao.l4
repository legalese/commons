IMPORT prelude
IMPORT `br-core`
IMPORT `br3-nomes`
IMPORT `br3-cap11-sec1-instalacao-deliberacao`

-- br3-tests-cap11-sec1-instalacao-deliberacao.l4 -- tests of Arts. 125 to 131. Each expected value is written from the
-- text of the provision named beside it, before running.

§ `Testes dos arts. 125 a 131`

§§ `Art. 125`

`presença de 250 de 1000 votos (teste art. 125)` MEANS `Votação em assembleia` WITH
    `o total de votos que podem ser dados` IS 1000
    `os votos dos titulares presentes` IS 250
    `os votos a favor` IS 0
    `os votos contra` IS 0
    `os votos em branco` IS 0

`presença de 249 de 1000 votos (teste art. 125)` MEANS `Votação em assembleia` WITH
    `o total de votos que podem ser dados` IS 1000
    `os votos dos titulares presentes` IS 249
    `os votos a favor` IS 0
    `os votos contra` IS 0
    `os votos em branco` IS 0

`presença de 1 de 1000 votos (teste art. 125)` MEANS `Votação em assembleia` WITH
    `o total de votos que podem ser dados` IS 1000
    `os votos dos titulares presentes` IS 1
    `os votos a favor` IS 0
    `os votos contra` IS 0
    `os votos em branco` IS 0

-- First convening: a quarter of the votes, at least; second convening: any number.
#ASSERT `a assembleia pode instalar-se (art. 125)` `primeira convocação (art. 124, § 1º)` `presença de 250 de 1000 votos (teste art. 125)` FALSE EQUALS JUST TRUE
#ASSERT `a assembleia pode instalar-se (art. 125)` `primeira convocação (art. 124, § 1º)` `presença de 249 de 1000 votos (teste art. 125)` FALSE EQUALS JUST FALSE
#ASSERT `a assembleia pode instalar-se (art. 125)` `segunda convocação (art. 124, § 1º)` `presença de 1 de 1000 votos (teste art. 125)` FALSE EQUALS JUST TRUE
#ASSERT `a assembleia pode instalar-se (art. 125)` `terceira convocação (art. 136, § 2º-A)` `presença de 250 de 1000 votos (teste art. 125)` FALSE EQUALS NOTHING
-- Where the Law fixes another quorum, this rule does not decide.
#ASSERT `a assembleia pode instalar-se (art. 125)` `primeira convocação (art. 124, § 1º)` `presença de 250 de 1000 votos (teste art. 125)` TRUE EQUALS NOTHING
#ASSERT `o acionista sem direito de voto pode comparecer e discutir a matéria (art. 125, parágrafo único)` TRUE EQUALS JUST TRUE
#ASSERT `o acionista sem direito de voto pode comparecer e discutir a matéria (art. 125, parágrafo único)` FALSE EQUALS NOTHING

§§ `Art. 126`

`identidade exigida e exibida (teste art. 126)` MEANS `Prova da qualidade de acionista (art. 126)` WITH
    `o documento de identidade é exigido` IS TRUE
    `o acionista exibiu documento hábil de identidade` IS TRUE
    `o estatuto exige o comprovante da instituição financeira depositária` IS FALSE
    `o acionista exibiu ou depositou o comprovante da instituição financeira depositária` IS FALSE
    `o acionista exibiu os certificados das ações ou o documento de depósito` IS FALSE

`identidade exigida e não exibida (teste art. 126)` MEANS `Prova da qualidade de acionista (art. 126)` WITH
    `o documento de identidade é exigido` IS TRUE
    `o acionista exibiu documento hábil de identidade` IS FALSE
    `o estatuto exige o comprovante da instituição financeira depositária` IS FALSE
    `o acionista exibiu ou depositou o comprovante da instituição financeira depositária` IS FALSE
    `o acionista exibiu os certificados das ações ou o documento de depósito` IS FALSE

`identidade não exigida e não exibida (teste art. 126)` MEANS `Prova da qualidade de acionista (art. 126)` WITH
    `o documento de identidade é exigido` IS FALSE
    `o acionista exibiu documento hábil de identidade` IS FALSE
    `o estatuto exige o comprovante da instituição financeira depositária` IS FALSE
    `o acionista exibiu ou depositou o comprovante da instituição financeira depositária` IS FALSE
    `o acionista exibiu os certificados das ações ou o documento de depósito` IS FALSE

`identidade e comprovante exigidos e exibidos (teste art. 126)` MEANS `Prova da qualidade de acionista (art. 126)` WITH
    `o documento de identidade é exigido` IS TRUE
    `o acionista exibiu documento hábil de identidade` IS TRUE
    `o estatuto exige o comprovante da instituição financeira depositária` IS TRUE
    `o acionista exibiu ou depositou o comprovante da instituição financeira depositária` IS TRUE
    `o acionista exibiu os certificados das ações ou o documento de depósito` IS FALSE

`identidade exibida e comprovante exigido e não exibido (teste art. 126)` MEANS `Prova da qualidade de acionista (art. 126)` WITH
    `o documento de identidade é exigido` IS TRUE
    `o acionista exibiu documento hábil de identidade` IS TRUE
    `o estatuto exige o comprovante da instituição financeira depositária` IS TRUE
    `o acionista exibiu ou depositou o comprovante da instituição financeira depositária` IS FALSE
    `o acionista exibiu os certificados das ações ou o documento de depósito` IS FALSE

`identidade não exibida e comprovante exibido (teste art. 126)` MEANS `Prova da qualidade de acionista (art. 126)` WITH
    `o documento de identidade é exigido` IS TRUE
    `o acionista exibiu documento hábil de identidade` IS FALSE
    `o estatuto exige o comprovante da instituição financeira depositária` IS TRUE
    `o acionista exibiu ou depositou o comprovante da instituição financeira depositária` IS TRUE
    `o acionista exibiu os certificados das ações ou o documento de depósito` IS FALSE

`identidade exibida e comprovante não exigido (teste art. 126)` MEANS `Prova da qualidade de acionista (art. 126)` WITH
    `o documento de identidade é exigido` IS TRUE
    `o acionista exibiu documento hábil de identidade` IS TRUE
    `o estatuto exige o comprovante da instituição financeira depositária` IS FALSE
    `o acionista exibiu ou depositou o comprovante da instituição financeira depositária` IS FALSE
    `o acionista exibiu os certificados das ações ou o documento de depósito` IS FALSE

`certificados exibidos (teste art. 126)` MEANS `Prova da qualidade de acionista (art. 126)` WITH
    `o documento de identidade é exigido` IS FALSE
    `o acionista exibiu documento hábil de identidade` IS FALSE
    `o estatuto exige o comprovante da instituição financeira depositária` IS FALSE
    `o acionista exibiu ou depositou o comprovante da instituição financeira depositária` IS FALSE
    `o acionista exibiu os certificados das ações ou o documento de depósito` IS TRUE

`certificados não exibidos (teste art. 126)` MEANS `Prova da qualidade de acionista (art. 126)` WITH
    `o documento de identidade é exigido` IS FALSE
    `o acionista exibiu documento hábil de identidade` IS FALSE
    `o estatuto exige o comprovante da instituição financeira depositária` IS FALSE
    `o acionista exibiu ou depositou o comprovante da instituição financeira depositária` IS FALSE
    `o acionista exibiu os certificados das ações ou o documento de depósito` IS FALSE

-- I: nominative shares: identity document, if required.
#ASSERT `o acionista provou a qualidade de acionista (art. 126)` `ações nominativas` `identidade exigida e exibida (teste art. 126)` EQUALS JUST TRUE
#ASSERT `o acionista provou a qualidade de acionista (art. 126)` `ações nominativas` `identidade exigida e não exibida (teste art. 126)` EQUALS JUST FALSE
#ASSERT `o acionista provou a qualidade de acionista (art. 126)` `ações nominativas` `identidade não exigida e não exibida (teste art. 126)` EQUALS JUST TRUE
-- II and IV: book-entry shares: identity document, and the depositary's receipt if the estatuto requires it.
#ASSERT `o acionista provou a qualidade de acionista (art. 126)` `ações escriturais` `identidade e comprovante exigidos e exibidos (teste art. 126)` EQUALS JUST TRUE
#ASSERT `o acionista provou a qualidade de acionista (art. 126)` `ações escriturais` `identidade exibida e comprovante exigido e não exibido (teste art. 126)` EQUALS JUST FALSE
#ASSERT `o acionista provou a qualidade de acionista (art. 126)` `ações escriturais` `identidade não exibida e comprovante exibido (teste art. 126)` EQUALS JUST FALSE
#ASSERT `o acionista provou a qualidade de acionista (art. 126)` `ações escriturais` `identidade exibida e comprovante não exigido (teste art. 126)` EQUALS JUST TRUE
-- III: bearer shares: the certificates or the deposit document.
#ASSERT `o acionista provou a qualidade de acionista (art. 126)` `ações ao portador` `certificados exibidos (teste art. 126)` EQUALS JUST TRUE
#ASSERT `o acionista provou a qualidade de acionista (art. 126)` `ações ao portador` `certificados não exibidos (teste art. 126)` EQUALS JUST FALSE
-- Endorsable shares: the live text has no norm for them.
#ASSERT `o acionista provou a qualidade de acionista (art. 126)` `ações endossáveis` `identidade exigida e exibida (teste art. 126)` EQUALS NOTHING
-- § 1º: a proxy constituted less than one year ago (on 10 Mar 2025: until 9 Mar 2026), who is a shareholder, a manager or a
-- lawyer; in the open company also a financial institution, and the fund administrator for the co-owners.
#ASSERT `o procurador pode representar o acionista na assembleia (art. 126, § 1º)` `companhia fechada` `procurador que é acionista (art. 126, § 1º)` (YearMonthDay 2025 3 10) (YearMonthDay 2026 3 9) FALSE
#ASSERT `o procurador pode representar o acionista na assembleia (art. 126, § 1º)` `companhia aberta` `procurador que é acionista (art. 126, § 1º)` (YearMonthDay 2025 3 10) (YearMonthDay 2026 3 9) FALSE
#ASSERT `o procurador pode representar o acionista na assembleia (art. 126, § 1º)` `companhia fechada` `procurador que é administrador da companhia (art. 126, § 1º)` (YearMonthDay 2025 3 10) (YearMonthDay 2026 3 9) FALSE
#ASSERT `o procurador pode representar o acionista na assembleia (art. 126, § 1º)` `companhia aberta` `procurador que é administrador da companhia (art. 126, § 1º)` (YearMonthDay 2025 3 10) (YearMonthDay 2026 3 9) FALSE
#ASSERT `o procurador pode representar o acionista na assembleia (art. 126, § 1º)` `companhia fechada` `procurador que é advogado (art. 126, § 1º)` (YearMonthDay 2025 3 10) (YearMonthDay 2026 3 9) FALSE
#ASSERT `o procurador pode representar o acionista na assembleia (art. 126, § 1º)` `companhia aberta` `procurador que é advogado (art. 126, § 1º)` (YearMonthDay 2025 3 10) (YearMonthDay 2026 3 9) FALSE
#ASSERT NOT (`o procurador pode representar o acionista na assembleia (art. 126, § 1º)` `companhia fechada` `procurador que é advogado (art. 126, § 1º)` (YearMonthDay 2025 3 10) (YearMonthDay 2026 3 10) FALSE)
#ASSERT NOT (`o procurador pode representar o acionista na assembleia (art. 126, § 1º)` `companhia aberta` `procurador que é acionista (art. 126, § 1º)` (YearMonthDay 2025 3 10) (YearMonthDay 2026 3 10) FALSE)
#ASSERT `o procurador pode representar o acionista na assembleia (art. 126, § 1º)` `companhia aberta` `procurador que é instituição financeira (art. 126, § 1º)` (YearMonthDay 2025 3 10) (YearMonthDay 2026 3 9) FALSE
#ASSERT NOT (`o procurador pode representar o acionista na assembleia (art. 126, § 1º)` `companhia fechada` `procurador que é instituição financeira (art. 126, § 1º)` (YearMonthDay 2025 3 10) (YearMonthDay 2026 3 9) FALSE)
#ASSERT `o procurador pode representar o acionista na assembleia (art. 126, § 1º)` `companhia aberta` `administrador de fundos de investimento que representa os condôminos (art. 126, § 1º)` (YearMonthDay 2025 3 10) (YearMonthDay 2026 3 9) FALSE
#ASSERT NOT (`o procurador pode representar o acionista na assembleia (art. 126, § 1º)` `companhia fechada` `administrador de fundos de investimento que representa os condôminos (art. 126, § 1º)` (YearMonthDay 2025 3 10) (YearMonthDay 2026 3 9) FALSE)
-- A proxy under a shareholders' agreement may run longer (Art. 118, § 7º).
#ASSERT `o procurador pode representar o acionista na assembleia (art. 126, § 1º)` `companhia fechada` `procurador que é acionista (art. 126, § 1º)` (YearMonthDay 2025 3 10) (YearMonthDay 2027 1 1) TRUE
-- § 2º: the request for proxies.
#ASSERT `o pedido de procuração satisfaz os requisitos da Lei (art. 126, § 2º)` TRUE TRUE TRUE
#ASSERT NOT (`o pedido de procuração satisfaz os requisitos da Lei (art. 126, § 2º)` FALSE TRUE TRUE)
#ASSERT NOT (`o pedido de procuração satisfaz os requisitos da Lei (art. 126, § 2º)` TRUE FALSE TRUE)
#ASSERT NOT (`o pedido de procuração satisfaz os requisitos da Lei (art. 126, § 2º)` TRUE TRUE FALSE)
-- § 3º: half of one per cent of the capital (5 of 1000 shares), and the requirements of § 2º.
#ASSERT `o acionista pode solicitar a relação de endereços dos acionistas (art. 126, § 3º)` 5 1000 TRUE
#ASSERT NOT (`o acionista pode solicitar a relação de endereços dos acionistas (art. 126, § 3º)` 4 1000 TRUE)
#ASSERT NOT (`o acionista pode solicitar a relação de endereços dos acionistas (art. 126, § 3º)` 5 1000 FALSE)
-- § 4º
#ASSERT `o representante legal do acionista tem qualidade para comparecer à assembleia (art. 126, § 4º)` TRUE
#ASSERT NOT (`o representante legal do acionista tem qualidade para comparecer à assembleia (art. 126, § 4º)` FALSE)

§§ `Arts. 127 e 128`

#ASSERT `o acionista cumpriu o dever de assinar o Livro de Presença (art. 127)` TRUE TRUE TRUE
#ASSERT NOT (`o acionista cumpriu o dever de assinar o Livro de Presença (art. 127)` FALSE TRUE TRUE)
#ASSERT NOT (`o acionista cumpriu o dever de assinar o Livro de Presença (art. 127)` TRUE FALSE TRUE)
#ASSERT NOT (`o acionista cumpriu o dever de assinar o Livro de Presença (art. 127)` TRUE TRUE FALSE)
#ASSERT `o acionista é considerado presente na assembleia (art. 127, parágrafo único)` TRUE EQUALS JUST TRUE
#ASSERT `o acionista é considerado presente na assembleia (art. 127, parágrafo único)` FALSE EQUALS NOTHING
#ASSERT `a mesa é composta de presidente e secretário escolhidos pelos acionistas presentes (art. 128)` FALSE EQUALS JUST TRUE
#ASSERT `a mesa é composta de presidente e secretário escolhidos pelos acionistas presentes (art. 128)` TRUE EQUALS NOTHING

§§ `Art. 129`

`60 a favor, 30 contra, 10 em branco (teste art. 129)` MEANS `Votação em assembleia` WITH
    `o total de votos que podem ser dados` IS 100
    `os votos dos titulares presentes` IS 100
    `os votos a favor` IS 60
    `os votos contra` IS 30
    `os votos em branco` IS 10

#ASSERT `a deliberação foi aprovada por maioria absoluta (art. 129)` `60 a favor, 30 contra, 10 em branco (teste art. 129)` FALSE EQUALS JUST TRUE
`46 a favor, 44 contra, 10 em branco (teste art. 129)` MEANS `Votação em assembleia` WITH
    `o total de votos que podem ser dados` IS 100
    `os votos dos titulares presentes` IS 100
    `os votos a favor` IS 46
    `os votos contra` IS 44
    `os votos em branco` IS 10

#ASSERT `a deliberação foi aprovada por maioria absoluta (art. 129)` `46 a favor, 44 contra, 10 em branco (teste art. 129)` FALSE EQUALS JUST TRUE
`45 a favor, 45 contra, 10 em branco (teste art. 129)` MEANS `Votação em assembleia` WITH
    `o total de votos que podem ser dados` IS 100
    `os votos dos titulares presentes` IS 100
    `os votos a favor` IS 45
    `os votos contra` IS 45
    `os votos em branco` IS 10

#ASSERT `a deliberação foi aprovada por maioria absoluta (art. 129)` `45 a favor, 45 contra, 10 em branco (teste art. 129)` FALSE EQUALS JUST FALSE
`45 a favor, 30 contra, 25 abstenções sem voto em branco (teste art. 129)` MEANS `Votação em assembleia` WITH
    `o total de votos que podem ser dados` IS 100
    `os votos dos titulares presentes` IS 100
    `os votos a favor` IS 45
    `os votos contra` IS 30
    `os votos em branco` IS 0

#ASSERT `a deliberação foi aprovada por maioria absoluta (art. 129)` `45 a favor, 30 contra, 25 abstenções sem voto em branco (teste art. 129)` FALSE EQUALS NOTHING
`51 a favor, 30 contra, 19 abstenções (teste art. 129)` MEANS `Votação em assembleia` WITH
    `o total de votos que podem ser dados` IS 100
    `os votos dos titulares presentes` IS 100
    `os votos a favor` IS 51
    `os votos contra` IS 30
    `os votos em branco` IS 0

#ASSERT `a deliberação foi aprovada por maioria absoluta (art. 129)` `51 a favor, 30 contra, 19 abstenções (teste art. 129)` FALSE EQUALS JUST TRUE
`50 a favor, 50 contra (teste art. 129)` MEANS `Votação em assembleia` WITH
    `o total de votos que podem ser dados` IS 100
    `os votos dos titulares presentes` IS 100
    `os votos a favor` IS 50
    `os votos contra` IS 50
    `os votos em branco` IS 0

#ASSERT `a deliberação foi aprovada por maioria absoluta (art. 129)` `50 a favor, 50 contra (teste art. 129)` FALSE EQUALS JUST FALSE
`40 a favor, 60 contra (teste art. 129)` MEANS `Votação em assembleia` WITH
    `o total de votos que podem ser dados` IS 100
    `os votos dos titulares presentes` IS 100
    `os votos a favor` IS 40
    `os votos contra` IS 60
    `os votos em branco` IS 0

#ASSERT `a deliberação foi aprovada por maioria absoluta (art. 129)` `40 a favor, 60 contra (teste art. 129)` FALSE EQUALS JUST FALSE
`10 a favor, 5 contra, 85 em branco (teste art. 129)` MEANS `Votação em assembleia` WITH
    `o total de votos que podem ser dados` IS 100
    `os votos dos titulares presentes` IS 100
    `os votos a favor` IS 10
    `os votos contra` IS 5
    `os votos em branco` IS 85

#ASSERT `a deliberação foi aprovada por maioria absoluta (art. 129)` `10 a favor, 5 contra, 85 em branco (teste art. 129)` FALSE EQUALS JUST TRUE
`40 presentes de 100: 21 a favor, 19 contra (teste art. 129)` MEANS `Votação em assembleia` WITH
    `o total de votos que podem ser dados` IS 100
    `os votos dos titulares presentes` IS 40
    `os votos a favor` IS 21
    `os votos contra` IS 19
    `os votos em branco` IS 0

#ASSERT `a deliberação foi aprovada por maioria absoluta (art. 129)` `40 presentes de 100: 21 a favor, 19 contra (teste art. 129)` FALSE EQUALS JUST TRUE
-- Where the Law fixes another quorum, this rule does not decide.
#ASSERT `a deliberação foi aprovada por maioria absoluta (art. 129)` `60 a favor, 30 contra, 10 em branco (teste art. 129)` TRUE EQUALS NOTHING
-- § 1º: the closed company's estatuto may raise the quorum for matters it specifies.
#ASSERT `o estatuto pode aumentar o quórum exigido para a deliberação (art. 129, § 1º)` `companhia fechada` TRUE
#ASSERT NOT (`o estatuto pode aumentar o quórum exigido para a deliberação (art. 129, § 1º)` `companhia fechada` FALSE)
#ASSERT NOT (`o estatuto pode aumentar o quórum exigido para a deliberação (art. 129, § 1º)` `companhia aberta` TRUE)
-- § 2º: a tie, no arbitration and no other rule in the estatuto: a new meeting, at least two months later.
#ASSERT `a assembleia deve ser convocada de novo para votar a deliberação (art. 129, § 2º)` TRUE FALSE FALSE
#ASSERT NOT (`a assembleia deve ser convocada de novo para votar a deliberação (art. 129, § 2º)` FALSE FALSE FALSE)
#ASSERT NOT (`a assembleia deve ser convocada de novo para votar a deliberação (art. 129, § 2º)` TRUE TRUE FALSE)
#ASSERT NOT (`a assembleia deve ser convocada de novo para votar a deliberação (art. 129, § 2º)` TRUE FALSE TRUE)
#ASSERT `a nova assembleia respeita o intervalo mínimo de dois meses (art. 129, § 2º)` (YearMonthDay 2026 3 31) (YearMonthDay 2026 5 31)
#ASSERT NOT (`a nova assembleia respeita o intervalo mínimo de dois meses (art. 129, § 2º)` (YearMonthDay 2026 3 31) (YearMonthDay 2026 5 30))
#ASSERT `a nova assembleia respeita o intervalo mínimo de dois meses (art. 129, § 2º)` (YearMonthDay 2026 3 31) (YearMonthDay 2026 6 15)
-- If the tie remains and the shareholders do not agree to entrust the decision to a third party, the courts decide.
#ASSERT `o Poder Judiciário decide no interesse da companhia (art. 129, § 2º)` TRUE TRUE FALSE
#ASSERT NOT (`o Poder Judiciário decide no interesse da companhia (art. 129, § 2º)` TRUE TRUE TRUE)
#ASSERT NOT (`o Poder Judiciário decide no interesse da companhia (art. 129, § 2º)` TRUE FALSE FALSE)
#ASSERT NOT (`o Poder Judiciário decide no interesse da companhia (art. 129, § 2º)` FALSE TRUE FALSE)

§§ `Arts. 130 e 131`

#ASSERT `a ata é válida quanto à forma e às assinaturas (art. 130)` TRUE TRUE TRUE
#ASSERT NOT (`a ata é válida quanto à forma e às assinaturas (art. 130)` FALSE TRUE TRUE)
#ASSERT NOT (`a ata é válida quanto à forma e às assinaturas (art. 130)` TRUE FALSE TRUE)
#ASSERT NOT (`a ata é válida quanto à forma e às assinaturas (art. 130)` TRUE TRUE FALSE)
#ASSERT `a ata pode ser lavrada em forma de sumário (art. 130, § 1º)` TRUE FALSE FALSE
#ASSERT `a ata pode ser lavrada em forma de sumário (art. 130, § 1º)` TRUE TRUE TRUE
#ASSERT NOT (`a ata pode ser lavrada em forma de sumário (art. 130, § 1º)` TRUE TRUE FALSE)
#ASSERT NOT (`a ata pode ser lavrada em forma de sumário (art. 130, § 1º)` FALSE FALSE FALSE)
#ASSERT `a assembleia pode autorizar a publicação da ata sem as assinaturas dos acionistas (art. 130, § 2º)` `companhia aberta` EQUALS JUST TRUE
#ASSERT `a assembleia pode autorizar a publicação da ata sem as assinaturas dos acionistas (art. 130, § 2º)` `companhia fechada` EQUALS NOTHING
#ASSERT `pode ser publicado apenas o extrato da ata (art. 130, § 3º)` TRUE EQUALS JUST TRUE
#ASSERT `pode ser publicado apenas o extrato da ata (art. 130, § 3º)` FALSE EQUALS NOTHING
#ASSERT `a assembleia-geral é ordinária (art. 131)` TRUE
#ASSERT NOT (`a assembleia-geral é ordinária (art. 131)` FALSE)
#ASSERT `a assembleia-geral é extraordinária (art. 131)` TRUE
#ASSERT NOT (`a assembleia-geral é extraordinária (art. 131)` FALSE)
#ASSERT `as assembleias ordinária e extraordinária podem ser cumuladas (art. 131, parágrafo único)` TRUE TRUE
#ASSERT NOT (`as assembleias ordinária e extraordinária podem ser cumuladas (art. 131, parágrafo único)` TRUE FALSE)
#ASSERT NOT (`as assembleias ordinária e extraordinária podem ser cumuladas (art. 131, parágrafo único)` FALSE TRUE)
