IMPORT prelude
IMPORT `br-core`
IMPORT `br2-cap7-constituicao-particular`

-- br2-tests-cap7-constituicao-particular.l4 -- tests of br2-cap7-constituicao-particular.l4 (Arts. 88 a 93).
-- Every expected value was decided by reading the article, before running, and is written beside the
-- assertion. A failing assertion is a finding, not an expected value to edit.

§ `Testes dos Arts. 88 a 93`

§§ `Art. 88`
#ASSERT `a constituição por subscrição particular pode fazer-se dessa forma (art. 88)` `deliberação dos subscritores em assembleia-geral (art. 88)`
#ASSERT `a constituição por subscrição particular pode fazer-se dessa forma (art. 88)` `escritura pública (art. 88)`
-- All the subscribers of a private subscription are founders; for any other subscription this article
-- does not say.
#ASSERT (`o subscritor é considerado fundador (art. 88)` TRUE) EQUALS JUST TRUE
#ASSERT (`o subscritor é considerado fundador (art. 88)` FALSE) EQUALS NOTHING
#ASSERT `a constituição por assembleia cumpre o que o § 1º exige (art. 88, § 1º)` TRUE TRUE TRUE
#ASSERT NOT (`a constituição por assembleia cumpre o que o § 1º exige (art. 88, § 1º)` FALSE TRUE TRUE)
#ASSERT NOT (`a constituição por assembleia cumpre o que o § 1º exige (art. 88, § 1º)` TRUE FALSE TRUE)
#ASSERT NOT (`a constituição por assembleia cumpre o que o § 1º exige (art. 88, § 1º)` TRUE TRUE FALSE)

-- A builder for the deed. Parameters in order: assinada por todos; qualificação; estatuto; relação das ações
-- e entradas; recibo do depósito; capital em bens; laudo; primeiros administradores; há fiscais; fiscais.
GIVEN `assinada` IS A BOOLEAN
      `qualificação` IS A BOOLEAN
      `estatuto` IS A BOOLEAN
      `relação` IS A BOOLEAN
      `recibo` IS A BOOLEAN
      `em bens` IS A BOOLEAN
      `laudo` IS A BOOLEAN
      `administradores` IS A BOOLEAN
      `há fiscais` IS A BOOLEAN
      `fiscais` IS A BOOLEAN
GIVETH A `Conteúdo da escritura pública de constituição (art. 88, § 2º)`
`teste: escritura com` MEANS
    `Conteúdo da escritura pública de constituição (art. 88, § 2º)` WITH
        `a escritura foi assinada por todos os subscritores` IS `assinada`
        `consta a qualificação dos subscritores nos termos do art. 85` IS `qualificação`
        `consta o estatuto da companhia` IS `estatuto`
        `consta a relação das ações tomadas pelos subscritores e a importância das entradas pagas` IS `relação`
        `consta a transcrição do recibo do depósito referido no inciso III do art. 80` IS `recibo`
        `o capital social foi subscrito em bens` IS `em bens`
        `consta a transcrição do laudo de avaliação dos peritos` IS `laudo`
        `consta a nomeação dos primeiros administradores` IS `administradores`
        `há fiscais a nomear` IS `há fiscais`
        `consta a nomeação dos fiscais` IS `fiscais`

#ASSERT `a escritura pública de constituição contém o que a lei exige (art. 88, § 2º)` (`teste: escritura com` TRUE TRUE TRUE TRUE TRUE FALSE FALSE TRUE FALSE FALSE)
#ASSERT NOT (`a escritura pública de constituição contém o que a lei exige (art. 88, § 2º)` (`teste: escritura com` FALSE TRUE TRUE TRUE TRUE FALSE FALSE TRUE FALSE FALSE))
#ASSERT NOT (`a escritura pública de constituição contém o que a lei exige (art. 88, § 2º)` (`teste: escritura com` TRUE FALSE TRUE TRUE TRUE FALSE FALSE TRUE FALSE FALSE))
#ASSERT NOT (`a escritura pública de constituição contém o que a lei exige (art. 88, § 2º)` (`teste: escritura com` TRUE TRUE FALSE TRUE TRUE FALSE FALSE TRUE FALSE FALSE))
#ASSERT NOT (`a escritura pública de constituição contém o que a lei exige (art. 88, § 2º)` (`teste: escritura com` TRUE TRUE TRUE FALSE TRUE FALSE FALSE TRUE FALSE FALSE))
#ASSERT NOT (`a escritura pública de constituição contém o que a lei exige (art. 88, § 2º)` (`teste: escritura com` TRUE TRUE TRUE TRUE FALSE FALSE FALSE TRUE FALSE FALSE))
#ASSERT NOT (`a escritura pública de constituição contém o que a lei exige (art. 88, § 2º)` (`teste: escritura com` TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE))
-- Valuation report: only if the capital was subscribed in assets.
#ASSERT `a escritura pública de constituição contém o que a lei exige (art. 88, § 2º)` (`teste: escritura com` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE)
#ASSERT NOT (`a escritura pública de constituição contém o que a lei exige (art. 88, § 2º)` (`teste: escritura com` TRUE TRUE TRUE TRUE TRUE TRUE FALSE TRUE FALSE FALSE))
-- Fiscais: only when there are some.
#ASSERT `a escritura pública de constituição contém o que a lei exige (art. 88, § 2º)` (`teste: escritura com` TRUE TRUE TRUE TRUE TRUE FALSE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`a escritura pública de constituição contém o que a lei exige (art. 88, § 2º)` (`teste: escritura com` TRUE TRUE TRUE TRUE TRUE FALSE FALSE TRUE TRUE FALSE))

§§ `Arts. 89 a 91`
#ASSERT NOT `a incorporação de imóveis para formação do capital social exige escritura pública (art. 89)`
#ASSERT `o subscritor pode fazer-se representar na assembleia-geral ou na escritura pública por procurador (art. 90)` TRUE
#ASSERT NOT (`o subscritor pode fazer-se representar na assembleia-geral ou na escritura pública por procurador (art. 90)` FALSE)
#ASSERT `o ato ou a publicação cumpre o dever de aditar a cláusula em organização (art. 91)` TRUE TRUE
#ASSERT NOT (`o ato ou a publicação cumpre o dever de aditar a cláusula em organização (art. 91)` TRUE FALSE)
#ASSERT `o ato ou a publicação cumpre o dever de aditar a cláusula em organização (art. 91)` FALSE FALSE

§§ `Arts. 92 e 93`
-- A founder in a public subscription, with a breach inside his attributions and a loss from it.
#ASSERT (`a parte responde pelos prejuízos resultantes da inobservância de preceitos legais (art. 92)` `o fundador` TRUE TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`a parte responde pelos prejuízos resultantes da inobservância de preceitos legais (art. 92)` `a instituição financeira` TRUE TRUE TRUE TRUE) EQUALS JUST TRUE
-- Outside his attributions: not liable under this article.
#ASSERT (`a parte responde pelos prejuízos resultantes da inobservância de preceitos legais (art. 92)` `o fundador` TRUE TRUE TRUE FALSE) EQUALS JUST FALSE
-- No loss from the breach.
#ASSERT (`a parte responde pelos prejuízos resultantes da inobservância de preceitos legais (art. 92)` `o fundador` TRUE TRUE FALSE TRUE) EQUALS JUST FALSE
-- Not a public subscription: the article speaks of public subscription only.
#ASSERT (`a parte responde pelos prejuízos resultantes da inobservância de preceitos legais (art. 92)` `o fundador` FALSE TRUE TRUE TRUE) EQUALS JUST FALSE
-- Anyone else: the text is silent.
#ASSERT (`a parte responde pelos prejuízos resultantes da inobservância de preceitos legais (art. 92)` `o subscritor` TRUE TRUE TRUE TRUE) EQUALS NOTHING
#ASSERT (`a parte responde pelos prejuízos resultantes da inobservância de preceitos legais (art. 92)` `o administrador` TRUE TRUE TRUE TRUE) EQUALS NOTHING
-- Parágrafo único
#ASSERT `os fundadores respondem solidariamente pelo prejuízo (art. 92, parágrafo único)` TRUE TRUE TRUE
#ASSERT NOT (`os fundadores respondem solidariamente pelo prejuízo (art. 92, parágrafo único)` FALSE TRUE TRUE)
#ASSERT NOT (`os fundadores respondem solidariamente pelo prejuízo (art. 92, parágrafo único)` TRUE FALSE TRUE)
#ASSERT NOT (`os fundadores respondem solidariamente pelo prejuízo (art. 92, parágrafo único)` TRUE TRUE FALSE)
-- Art. 93
#ASSERT `os fundadores cumpriram o dever de entregar os documentos aos primeiros administradores (art. 93)` TRUE
#ASSERT NOT (`os fundadores cumpriram o dever de entregar os documentos aos primeiros administradores (art. 93)` FALSE)
