-- Art. 279, caput: approved by the competent organ of each company and all eight items; each one alone is needed.
#ASSERT `o contrato de consórcio atende o art. 279 (art. 279)` `contrato completo (teste art. 279)`
#ASSERT NOT (`o contrato de consórcio atende o art. 279 (art. 279)` `contrato sem o item aprovado (teste art. 279)`)
#ASSERT NOT (`o contrato de consórcio atende o art. 279 (art. 279)` `contrato sem o item I (teste art. 279)`)
#ASSERT NOT (`o contrato de consórcio atende o art. 279 (art. 279)` `contrato sem o item II (teste art. 279)`)
#ASSERT NOT (`o contrato de consórcio atende o art. 279 (art. 279)` `contrato sem o item III (teste art. 279)`)
#ASSERT NOT (`o contrato de consórcio atende o art. 279 (art. 279)` `contrato sem o item IV (teste art. 279)`)
#ASSERT NOT (`o contrato de consórcio atende o art. 279 (art. 279)` `contrato sem o item V (teste art. 279)`)
#ASSERT NOT (`o contrato de consórcio atende o art. 279 (art. 279)` `contrato sem o item VI (teste art. 279)`)
#ASSERT NOT (`o contrato de consórcio atende o art. 279 (art. 279)` `contrato sem o item VII (teste art. 279)`)
#ASSERT NOT (`o contrato de consórcio atende o art. 279 (art. 279)` `contrato sem o item VIII (teste art. 279)`)

-- Art. 279, parágrafo único; ruler: the contract and its changes were filed at the registry of the seat, the certificate was published.
#ASSERT `o contrato de consórcio foi arquivado e a certidão publicada (art. 279, parágrafo único)` TRUE TRUE
#ASSERT NOT (`o contrato de consórcio foi arquivado e a certidão publicada (art. 279, parágrafo único)` TRUE FALSE)
#ASSERT NOT (`o contrato de consórcio foi arquivado e a certidão publicada (art. 279, parágrafo único)` FALSE TRUE)
#ASSERT NOT (`o contrato de consórcio foi arquivado e a certidão publicada (art. 279, parágrafo único)` FALSE FALSE)
