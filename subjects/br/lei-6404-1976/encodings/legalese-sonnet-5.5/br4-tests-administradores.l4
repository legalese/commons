IMPORT prelude
IMPORT `br-core`
IMPORT `br4-administradores`

-- br4-tests-administradores.l4 -- tests of br4-administradores.l4 (arts. 145 to 152).
-- Every expected value was decided from the text of the article, written beside the assertion, and then run.

§ `Testes dos arts. 145 e 146`

-- art. 145: the common norms reach conselheiros and diretores; for any other person the article is silent.
#ASSERT `as normas sobre os administradores se aplicam à pessoa ou órgão (art. 145)` `o conselheiro de administração` EQUALS JUST TRUE
#ASSERT `as normas sobre os administradores se aplicam à pessoa ou órgão (art. 145)` `o diretor` EQUALS JUST TRUE
#ASSERT `as normas sobre os administradores se aplicam à pessoa ou órgão (art. 145)` `o administrador` EQUALS JUST TRUE
#ASSERT `as normas sobre os administradores se aplicam à pessoa ou órgão (art. 145)` `o membro do conselho fiscal` EQUALS NOTHING
#ASSERT `as normas sobre os administradores se aplicam à pessoa ou órgão (art. 145)` `o acionista` EQUALS NOTHING
-- art. 146, caput: only natural persons (the live text has no residence or shareholding requirement).
#ASSERT `a pessoa pode ser eleita para órgão de administração (art. 146)` TRUE
#ASSERT NOT (`a pessoa pode ser eleita para órgão de administração (art. 146)` FALSE)
-- § 1º: qualification, term, filing and publication, all four.
#ASSERT `a ata da eleição cumpre o que se exige (art. 146, § 1º)` TRUE TRUE TRUE TRUE
#ASSERT NOT (`a ata da eleição cumpre o que se exige (art. 146, § 1º)` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`a ata da eleição cumpre o que se exige (art. 146, § 1º)` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`a ata da eleição cumpre o que se exige (art. 146, § 1º)` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`a ata da eleição cumpre o que se exige (art. 146, § 1º)` TRUE TRUE TRUE FALSE)
-- § 2º: resident abroad: needs a representative with the powers of I (and of II in an open company) for at least 3 years.
#ASSERT `a posse do administrador residente no exterior é permitida (art. 146, § 2º)` FALSE FALSE FALSE `companhia aberta` FALSE 0
#ASSERT `a posse do administrador residente no exterior é permitida (art. 146, § 2º)` TRUE TRUE TRUE `companhia aberta` TRUE 3
#ASSERT `a posse do administrador residente no exterior é permitida (art. 146, § 2º)` TRUE TRUE TRUE `companhia aberta` TRUE 5
#ASSERT NOT (`a posse do administrador residente no exterior é permitida (art. 146, § 2º)` TRUE TRUE TRUE `companhia aberta` TRUE 2)
#ASSERT NOT (`a posse do administrador residente no exterior é permitida (art. 146, § 2º)` TRUE FALSE FALSE `companhia aberta` FALSE 3)
#ASSERT NOT (`a posse do administrador residente no exterior é permitida (art. 146, § 2º)` TRUE TRUE FALSE `companhia aberta` TRUE 3)
#ASSERT NOT (`a posse do administrador residente no exterior é permitida (art. 146, § 2º)` TRUE TRUE TRUE `companhia aberta` FALSE 3)
#ASSERT `a posse do administrador residente no exterior é permitida (art. 146, § 2º)` TRUE TRUE TRUE `companhia fechada` FALSE 3
#ASSERT NOT (`a posse do administrador residente no exterior é permitida (art. 146, § 2º)` TRUE TRUE FALSE `companhia fechada` FALSE 3)

§ `Testes do art. 147`

-- caput: where the law requires requisites, only a candidate who showed the proofs may be elected, and a copy is filed.
#ASSERT `a assembleia-geral pode eleger o candidato quanto aos comprovantes (art. 147)` FALSE FALSE
#ASSERT `a assembleia-geral pode eleger o candidato quanto aos comprovantes (art. 147)` TRUE TRUE
#ASSERT NOT (`a assembleia-geral pode eleger o candidato quanto aos comprovantes (art. 147)` TRUE FALSE)
#ASSERT `a companhia deve arquivar cópia autêntica dos comprovantes na sede social (art. 147)` TRUE TRUE
#ASSERT NOT (`a companhia deve arquivar cópia autêntica dos comprovantes na sede social (art. 147)` FALSE TRUE)
#ASSERT NOT (`a companhia deve arquivar cópia autêntica dos comprovantes na sede social (art. 147)` TRUE FALSE)
-- § 1º: each listed conviction bars; "outro crime" does not; a bar by special law does.
#ASSERT `a condenação torna o candidato inelegível (art. 147, § 1º)` `condenação por crime falimentar (art. 147, § 1º)`
#ASSERT `a condenação torna o candidato inelegível (art. 147, § 1º)` `condenação por crime de prevaricação (art. 147, § 1º)`
#ASSERT `a condenação torna o candidato inelegível (art. 147, § 1º)` `condenação por crime de peita ou suborno (art. 147, § 1º)`
#ASSERT `a condenação torna o candidato inelegível (art. 147, § 1º)` `condenação por crime de concussão (art. 147, § 1º)`
#ASSERT `a condenação torna o candidato inelegível (art. 147, § 1º)` `condenação por crime de peculato (art. 147, § 1º)`
#ASSERT `a condenação torna o candidato inelegível (art. 147, § 1º)` `condenação por crime contra a economia popular (art. 147, § 1º)`
#ASSERT `a condenação torna o candidato inelegível (art. 147, § 1º)` `condenação por crime contra a fé pública (art. 147, § 1º)`
#ASSERT `a condenação torna o candidato inelegível (art. 147, § 1º)` `condenação por crime contra a propriedade (art. 147, § 1º)`
#ASSERT `a condenação torna o candidato inelegível (art. 147, § 1º)` `condenação a pena criminal que veda, ainda que temporariamente, o acesso a cargos públicos (art. 147, § 1º)`
#ASSERT NOT (`a condenação torna o candidato inelegível (art. 147, § 1º)` `condenação por outro crime (art. 147, § 1º)`)
#ASSERT NOT (`o candidato é inelegível para os cargos de administração (art. 147, § 1º)` FALSE EMPTY)
#ASSERT `o candidato é inelegível para os cargos de administração (art. 147, § 1º)` TRUE EMPTY
#ASSERT NOT (`o candidato é inelegível para os cargos de administração (art. 147, § 1º)` FALSE (LIST `condenação por outro crime (art. 147, § 1º)`))
#ASSERT `o candidato é inelegível para os cargos de administração (art. 147, § 1º)` FALSE (LIST `condenação por outro crime (art. 147, § 1º)`, `condenação por crime de peculato (art. 147, § 1º)`)
-- § 2º: also, in an open company, those declared disqualified by the CVM.
#ASSERT `o candidato é inelegível para os cargos de administração de companhia aberta (art. 147, § 2º)` `companhia aberta` TRUE
#ASSERT NOT (`o candidato é inelegível para os cargos de administração de companhia aberta (art. 147, § 2º)` `companhia fechada` TRUE)
#ASSERT NOT (`o candidato é inelegível para os cargos de administração de companhia aberta (art. 147, § 2º)` `companhia aberta` FALSE)
-- § 3º: unblemished reputation; a competitor or a conflict of interest bars unless the assembly dispenses.
#ASSERT `o conselheiro pode ser eleito quanto à reputação e aos impedimentos (art. 147, § 3º)` TRUE FALSE FALSE FALSE
#ASSERT NOT (`o conselheiro pode ser eleito quanto à reputação e aos impedimentos (art. 147, § 3º)` FALSE FALSE FALSE FALSE)
#ASSERT NOT (`o conselheiro pode ser eleito quanto à reputação e aos impedimentos (art. 147, § 3º)` TRUE TRUE FALSE FALSE)
#ASSERT NOT (`o conselheiro pode ser eleito quanto à reputação e aos impedimentos (art. 147, § 3º)` TRUE FALSE TRUE FALSE)
#ASSERT `o conselheiro pode ser eleito quanto à reputação e aos impedimentos (art. 147, § 3º)` TRUE TRUE FALSE TRUE
#ASSERT `o conselheiro pode ser eleito quanto à reputação e aos impedimentos (art. 147, § 3º)` TRUE FALSE TRUE TRUE
#ASSERT NOT (`o conselheiro pode ser eleito quanto à reputação e aos impedimentos (art. 147, § 3º)` FALSE TRUE TRUE TRUE)
-- § 4º: a signed declaration in the CVM's terms.
#ASSERT `a declaração do conselheiro comprova o cumprimento das condições do § 3º (art. 147, § 4º)` TRUE TRUE
#ASSERT NOT (`a declaração do conselheiro comprova o cumprimento das condições do § 3º (art. 147, § 4º)` TRUE FALSE)
#ASSERT NOT (`a declaração do conselheiro comprova o cumprimento das condições do § 3º (art. 147, § 4º)` FALSE TRUE)

§ `Testes dos arts. 148 e 149`

#ASSERT `a exigência de garantia da gestão pelo estatuto é admissível (art. 148)` TRUE
#ASSERT NOT (`a exigência de garantia da gestão pelo estatuto é admissível (art. 148)` FALSE)
#ASSERT `a garantia da gestão pode ser levantada (art. 148, parágrafo único)` TRUE
#ASSERT NOT (`a garantia da gestão pode ser levantada (art. 148, parágrafo único)` FALSE)
-- art. 149, caput: the conselheiro signs in the book of the board, the diretor in the book of the diretoria; others: no answer.
#ASSERT `o livro de atas em que se assina o termo de posse (art. 149)` `o conselheiro de administração` EQUALS JUST `o conselho de administração`
#ASSERT `o livro de atas em que se assina o termo de posse (art. 149)` `o diretor` EQUALS JUST `a diretoria`
#ASSERT `o livro de atas em que se assina o termo de posse (art. 149)` `o acionista` EQUALS NOTHING
#ASSERT `o conselheiro ou diretor está investido no cargo (art. 149)` TRUE
#ASSERT NOT (`o conselheiro ou diretor está investido no cargo (art. 149)` FALSE)
-- § 1º: 30 days from the appointment of 1 March 2026 (convention F1: the last day in time is 31 March).
#ASSERT NOT (`a nomeação tornou-se sem efeito por falta de assinatura do termo (art. 149, § 1º)` (YMD 2026 3 1) (JUST (YMD 2026 3 31)) (YMD 2026 6 1) FALSE)
#ASSERT `a nomeação tornou-se sem efeito por falta de assinatura do termo (art. 149, § 1º)` (YMD 2026 3 1) (JUST (YMD 2026 4 1)) (YMD 2026 6 1) FALSE
#ASSERT NOT (`a nomeação tornou-se sem efeito por falta de assinatura do termo (art. 149, § 1º)` (YMD 2026 3 1) (JUST (YMD 2026 4 1)) (YMD 2026 6 1) TRUE)
#ASSERT NOT (`a nomeação tornou-se sem efeito por falta de assinatura do termo (art. 149, § 1º)` (YMD 2026 3 1) NOTHING (YMD 2026 3 31) FALSE)
#ASSERT `a nomeação tornou-se sem efeito por falta de assinatura do termo (art. 149, § 1º)` (YMD 2026 3 1) NOTHING (YMD 2026 4 1) FALSE
#ASSERT NOT (`a nomeação tornou-se sem efeito por falta de assinatura do termo (art. 149, § 1º)` (YMD 2026 3 1) NOTHING (YMD 2026 4 1) TRUE)
-- § 2º.
#ASSERT `o termo de posse é nulo (art. 149, § 2º)` FALSE
#ASSERT NOT (`o termo de posse é nulo (art. 149, § 2º)` TRUE)
#ASSERT `a citação ou intimação reputa-se cumprida (art. 149, § 2º)` TRUE
#ASSERT NOT (`a citação ou intimação reputa-se cumprida (art. 149, § 2º)` FALSE)
#ASSERT `a alteração do domicílio indicado é eficaz (art. 149, § 2º)` TRUE
#ASSERT NOT (`a alteração do domicílio indicado é eficaz (art. 149, § 2º)` FALSE)

§ `Testes do art. 150`

-- caput: the remaining conselheiros appoint, unless the estatuto says otherwise; if it does the Law is silent.
#ASSERT `o substituto do conselheiro é nomeado pelos conselheiros remanescentes (art. 150)` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o substituto do conselheiro é nomeado pelos conselheiros remanescentes (art. 150)` TRUE TRUE EQUALS NOTHING
#ASSERT `o substituto do conselheiro é nomeado pelos conselheiros remanescentes (art. 150)` FALSE FALSE EQUALS NOTHING
-- caput: more than half of the posts vacant (3 of 5 yes; 2 of 4 no, that is half, not a majority).
#ASSERT `a assembleia-geral deve ser convocada para nova eleição (art. 150)` 3 5
#ASSERT NOT (`a assembleia-geral deve ser convocada para nova eleição (art. 150)` 2 4)
#ASSERT NOT (`a assembleia-geral deve ser convocada para nova eleição (art. 150)` 2 5)
#ASSERT `a assembleia-geral deve ser convocada para nova eleição (art. 150)` 5 5
-- §§ 1º and 2º: who convenes.
#ASSERT `quem convoca a assembleia-geral por vacância de todo um órgão (art. 150, §§ 1º e 2º)` TRUE TRUE FALSE FALSE EQUALS JUST (LIST `a diretoria`)
#ASSERT `quem convoca a assembleia-geral por vacância de todo um órgão (art. 150, §§ 1º e 2º)` FALSE FALSE TRUE TRUE EQUALS JUST (LIST `o conselho fiscal`, `o acionista`)
#ASSERT `quem convoca a assembleia-geral por vacância de todo um órgão (art. 150, §§ 1º e 2º)` FALSE FALSE TRUE FALSE EQUALS JUST (LIST `o acionista`)
#ASSERT `quem convoca a assembleia-geral por vacância de todo um órgão (art. 150, §§ 1º e 2º)` TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `quem convoca a assembleia-geral por vacância de todo um órgão (art. 150, §§ 1º e 2º)` TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `quem convoca a assembleia-geral por vacância de todo um órgão (art. 150, §§ 1º e 2º)` FALSE FALSE FALSE FALSE EQUALS NOTHING
-- § 2º, end: without a board and with the diretoria vacant, the representative of most shares does the urgent acts.
#ASSERT `o representante de maior número de ações deve praticar os atos urgentes de administração (art. 150, § 2º)` FALSE TRUE TRUE TRUE
#ASSERT NOT (`o representante de maior número de ações deve praticar os atos urgentes de administração (art. 150, § 2º)` TRUE TRUE TRUE TRUE)
#ASSERT NOT (`o representante de maior número de ações deve praticar os atos urgentes de administração (art. 150, § 2º)` FALSE FALSE TRUE TRUE)
#ASSERT NOT (`o representante de maior número de ações deve praticar os atos urgentes de administração (art. 150, § 2º)` FALSE TRUE FALSE TRUE)
#ASSERT NOT (`o representante de maior número de ações deve praticar os atos urgentes de administração (art. 150, § 2º)` FALSE TRUE TRUE FALSE)
-- caput and § 3º: when the substitute's management ends.
#ASSERT `a data em que termina a gestão do substituto (art. 150, caput e § 3º)` `substituto nomeado pelos conselheiros remanescentes (art. 150)` (YMD 2026 4 30) (YMD 2027 3 31) EQUALS YMD 2026 4 30
#ASSERT `a data em que termina a gestão do substituto (art. 150, caput e § 3º)` `substituto eleito para preencher cargo vago (art. 150, § 3º)` (YMD 2026 4 30) (YMD 2027 3 31) EQUALS YMD 2027 3 31
-- § 4º: the term runs on until the new administradores are invested (the investiture day itself is no longer the old term, fork F9).
#ASSERT `o administrador ainda está no prazo de gestão (art. 150, § 4º)` (YMD 2026 3 31) (YMD 2026 3 31) NOTHING
#ASSERT `o administrador ainda está no prazo de gestão (art. 150, § 4º)` (YMD 2026 4 15) (YMD 2026 3 31) NOTHING
#ASSERT `o administrador ainda está no prazo de gestão (art. 150, § 4º)` (YMD 2026 4 15) (YMD 2026 3 31) (JUST (YMD 2026 4 16))
#ASSERT NOT (`o administrador ainda está no prazo de gestão (art. 150, § 4º)` (YMD 2026 4 16) (YMD 2026 3 31) (JUST (YMD 2026 4 16)))
#ASSERT `o administrador ainda está no prazo de gestão (art. 150, § 4º)` (YMD 2026 3 20) (YMD 2026 3 31) (JUST (YMD 2026 3 10))

§ `Testes dos arts. 151 e 152`

-- art. 151: effective against the company on delivery; against third parties in good faith after filing and publication.
#ASSERT `a renúncia é eficaz perante a companhia (art. 151)` TRUE
#ASSERT NOT (`a renúncia é eficaz perante a companhia (art. 151)` FALSE)
#ASSERT `a renúncia é eficaz perante terceiros de boa-fé (art. 151)` TRUE TRUE
#ASSERT NOT (`a renúncia é eficaz perante terceiros de boa-fé (art. 151)` TRUE FALSE)
#ASSERT NOT (`a renúncia é eficaz perante terceiros de boa-fé (art. 151)` FALSE TRUE)
#ASSERT `o renunciante pode promover o arquivamento e a publicação da renúncia (art. 151)` TRUE
-- art. 152, caput.
#ASSERT `quem fixa a remuneração dos administradores (art. 152)` EQUALS `a assembleia-geral`
#ASSERT `a assembleia fixou a remuneração segundo os critérios da lei (art. 152)` TRUE TRUE TRUE TRUE
#ASSERT NOT (`a assembleia fixou a remuneração segundo os critérios da lei (art. 152)` TRUE TRUE TRUE FALSE)
#ASSERT NOT (`a assembleia fixou a remuneração segundo os critérios da lei (art. 152)` FALSE TRUE TRUE TRUE)
-- § 1º: dividend of 25% or more. With profits of 2,000 the tenth is 200: annual remuneration 150 gives the limit 150, 300 gives 200.
#ASSERT `o estatuto pode atribuir aos administradores participação no lucro (art. 152, § 1º)` (25%)
#ASSERT `o estatuto pode atribuir aos administradores participação no lucro (art. 152, § 1º)` (40%)
#ASSERT NOT (`o estatuto pode atribuir aos administradores participação no lucro (art. 152, § 1º)` (24%))
#ASSERT `o limite da participação dos administradores no lucro, em reais (art. 152, § 1º)` (25%) 150 2000 EQUALS JUST 150
#ASSERT `o limite da participação dos administradores no lucro, em reais (art. 152, § 1º)` (25%) 300 2000 EQUALS JUST 200
#ASSERT `o limite da participação dos administradores no lucro, em reais (art. 152, § 1º)` (25%) 200 2000 EQUALS JUST 200
#ASSERT `o limite da participação dos administradores no lucro, em reais (art. 152, § 1º)` (24%) 150 2000 EQUALS NOTHING
#ASSERT `a participação atribuída aos administradores respeita o limite (art. 152, § 1º)` (25%) 300 2000 200 EQUALS JUST TRUE
#ASSERT `a participação atribuída aos administradores respeita o limite (art. 152, § 1º)` (25%) 300 2000 201 EQUALS JUST FALSE
#ASSERT `a participação atribuída aos administradores respeita o limite (art. 152, § 1º)` (24%) 300 2000 100 EQUALS NOTHING
-- § 2º: the mandatory dividend must have been given to the shareholders for that exercício.
#ASSERT `a condição para os administradores participarem dos lucros do exercício está satisfeita (art. 152, § 2º)` TRUE
#ASSERT NOT (`a condição para os administradores participarem dos lucros do exercício está satisfeita (art. 152, § 2º)` FALSE)

