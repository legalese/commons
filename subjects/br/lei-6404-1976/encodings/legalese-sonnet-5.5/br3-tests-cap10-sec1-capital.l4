IMPORT prelude
IMPORT `br-core`
IMPORT `br3-nomes`
IMPORT `br3-cap10-sec1-capital`

-- br3-tests-cap10-sec1-capital.l4 -- tests of Arts. 106 to 108. Each expected value is written from the text
-- of the article named beside it, before running; none is copied from the encoding's own output.
-- Dates are written year first with the core's YMD.

§ `Testes dos arts. 106 a 108`

§§ `Art. 106`

-- Art. 106: the duty to pay lasts while shares subscribed or acquired are not fully paid.
#ASSERT `a prestação das ações é devida pelo acionista à companhia (art. 106)` TRUE FALSE
#ASSERT NOT (`a prestação das ações é devida pelo acionista à companhia (art. 106)` TRUE TRUE)
#ASSERT NOT (`a prestação das ações é devida pelo acionista à companhia (art. 106)` FALSE FALSE)

-- Art. 106, § 1º: both estatuto and boletim silent on amount and on date -> the managers must call.
#ASSERT `os órgãos da administração devem efetuar chamada (art. 106, § 1º)` FALSE FALSE EQUALS JUST TRUE
-- Both fix them -> no call is needed.
#ASSERT `os órgãos da administração devem efetuar chamada (art. 106, § 1º)` TRUE TRUE EQUALS JUST FALSE
-- Only one of the two is silent: the text does not say (NOTHING).
#ASSERT `os órgãos da administração devem efetuar chamada (art. 106, § 1º)` TRUE FALSE EQUALS NOTHING
#ASSERT `os órgãos da administração devem efetuar chamada (art. 106, § 1º)` FALSE TRUE EQUALS NOTHING

-- Art. 106, § 1º: the form of the call. First publication 10 Jan 2026, last 20 Jan 2026.
-- 30 days from the first is 9 Feb 2026; 30 days from the last is 19 Feb 2026.
`chamada com 2 publicações (teste art. 106, § 1º)` MEANS `Fatos da chamada para o pagamento (art. 106, § 1º)` WITH
    `a quantidade de publicações da chamada na imprensa` IS 2
    `a data da primeira publicação da chamada` IS YMD 2026 1 10
    `a data da última publicação da chamada` IS YMD 2026 1 20
    `a data limite fixada na chamada para o pagamento` IS YMD 2026 3 1

`chamada com 3 publicações e prazo até 8 de fevereiro (teste art. 106, § 1º)` MEANS `Fatos da chamada para o pagamento (art. 106, § 1º)` WITH
    `a quantidade de publicações da chamada na imprensa` IS 3
    `a data da primeira publicação da chamada` IS YMD 2026 1 10
    `a data da última publicação da chamada` IS YMD 2026 1 20
    `a data limite fixada na chamada para o pagamento` IS YMD 2026 2 8

`chamada com 3 publicações e prazo até 9 de fevereiro (teste art. 106, § 1º)` MEANS `Fatos da chamada para o pagamento (art. 106, § 1º)` WITH
    `a quantidade de publicações da chamada na imprensa` IS 3
    `a data da primeira publicação da chamada` IS YMD 2026 1 10
    `a data da última publicação da chamada` IS YMD 2026 1 20
    `a data limite fixada na chamada para o pagamento` IS YMD 2026 2 9

`chamada com 3 publicações e prazo até 18 de fevereiro (teste art. 106, § 1º)` MEANS `Fatos da chamada para o pagamento (art. 106, § 1º)` WITH
    `a quantidade de publicações da chamada na imprensa` IS 3
    `a data da primeira publicação da chamada` IS YMD 2026 1 10
    `a data da última publicação da chamada` IS YMD 2026 1 20
    `a data limite fixada na chamada para o pagamento` IS YMD 2026 2 18

`chamada com 3 publicações e prazo até 19 de fevereiro (teste art. 106, § 1º)` MEANS `Fatos da chamada para o pagamento (art. 106, § 1º)` WITH
    `a quantidade de publicações da chamada na imprensa` IS 3
    `a data da primeira publicação da chamada` IS YMD 2026 1 10
    `a data da última publicação da chamada` IS YMD 2026 1 20
    `a data limite fixada na chamada para o pagamento` IS YMD 2026 2 19

`chamada com 5 publicações e prazo longo (teste art. 106, § 1º)` MEANS `Fatos da chamada para o pagamento (art. 106, § 1º)` WITH
    `a quantidade de publicações da chamada na imprensa` IS 5
    `a data da primeira publicação da chamada` IS YMD 2026 1 10
    `a data da última publicação da chamada` IS YMD 2026 1 20
    `a data limite fixada na chamada para o pagamento` IS YMD 2026 3 1

-- Fewer than 3 publications: the call does not meet the article, whatever the period.
#ASSERT `a chamada observa o número de publicações e o prazo mínimo (art. 106, § 1º)` `chamada com 2 publicações (teste art. 106, § 1º)` EQUALS JUST FALSE
-- Too short even counted from the first publication (8 Feb is before 9 Feb).
#ASSERT `a chamada observa o número de publicações e o prazo mínimo (art. 106, § 1º)` `chamada com 3 publicações e prazo até 8 de fevereiro (teste art. 106, § 1º)` EQUALS JUST FALSE
-- Long enough from the first publication but not from the last: the text does not say from which it runs.
#ASSERT `a chamada observa o número de publicações e o prazo mínimo (art. 106, § 1º)` `chamada com 3 publicações e prazo até 9 de fevereiro (teste art. 106, § 1º)` EQUALS NOTHING
#ASSERT `a chamada observa o número de publicações e o prazo mínimo (art. 106, § 1º)` `chamada com 3 publicações e prazo até 18 de fevereiro (teste art. 106, § 1º)` EQUALS NOTHING
-- "não inferior a 30 dias": exactly 30 days from the last publication is enough.
#ASSERT `a chamada observa o número de publicações e o prazo mínimo (art. 106, § 1º)` `chamada com 3 publicações e prazo até 19 de fevereiro (teste art. 106, § 1º)` EQUALS JUST TRUE
#ASSERT `a chamada observa o número de publicações e o prazo mínimo (art. 106, § 1º)` `chamada com 5 publicações e prazo longo (teste art. 106, § 1º)` EQUALS JUST TRUE

-- Art. 106, § 2º: default "de pleno direito" when the date has passed and payment was not made as required.
#ASSERT `o acionista está constituído em mora de pleno direito (art. 106, § 2º)` TRUE TRUE FALSE
#ASSERT NOT (`o acionista está constituído em mora de pleno direito (art. 106, § 2º)` TRUE FALSE FALSE)
#ASSERT NOT (`o acionista está constituído em mora de pleno direito (art. 106, § 2º)` TRUE TRUE TRUE)
#ASSERT NOT (`o acionista está constituído em mora de pleno direito (art. 106, § 2º)` FALSE TRUE FALSE)

-- Art. 106, § 2º: the fine is "não superior a 10% do valor da prestação": on an instalment of 1,000 reais, up to 100.
#ASSERT `o limite da multa por mora em reais (art. 106, § 2º)` 1000 EQUALS 100
#ASSERT `a multa fixada pelo estatuto respeita o limite (art. 106, § 2º)` 99 1000
#ASSERT `a multa fixada pelo estatuto respeita o limite (art. 106, § 2º)` 100 1000
#ASSERT NOT (`a multa fixada pelo estatuto respeita o limite (art. 106, § 2º)` 101 1000)

`encargos de 20, 30 e 100 reais (teste art. 106, § 2º)` MEANS `Encargos da mora fixados pelo estatuto (art. 106, § 2º)` WITH
    `os juros fixados pelo estatuto em reais` IS 20
    `a correção monetária fixada pelo estatuto em reais` IS 30
    `a multa fixada pelo estatuto em reais` IS 100

`encargos com multa de 101 reais (teste art. 106, § 2º)` MEANS `Encargos da mora fixados pelo estatuto (art. 106, § 2º)` WITH
    `os juros fixados pelo estatuto em reais` IS 20
    `a correção monetária fixada pelo estatuto em reais` IS 30
    `a multa fixada pelo estatuto em reais` IS 101

-- In default, instalment 1,000: interest 20 + correction 30 + fine 100 = 150.
#ASSERT `os encargos devidos pelo acionista em mora em reais (art. 106, § 2º)` TRUE `encargos de 20, 30 e 100 reais (teste art. 106, § 2º)` 1000 EQUALS JUST 150
-- Not in default: no charges.
#ASSERT `os encargos devidos pelo acionista em mora em reais (art. 106, § 2º)` FALSE `encargos de 20, 30 e 100 reais (teste art. 106, § 2º)` 1000 EQUALS JUST 0
-- A fine of 101 on 1,000 is above the ceiling; the text does not say what then happens (NOTHING).
#ASSERT `os encargos devidos pelo acionista em mora em reais (art. 106, § 2º)` TRUE `encargos com multa de 101 reais (teste art. 106, § 2º)` 1000 EQUALS NOTHING

§§ `Art. 107`

-- Art. 107, incisos I and II: with the shareholder in default the company may execute or sell the shares.
#ASSERT `a companhia pode adotar a medida contra o acionista em mora (art. 107)` `execução para cobrar as importâncias devidas (art. 107, inciso I)` TRUE FALSE
#ASSERT `a companhia pode adotar a medida contra o acionista em mora (art. 107)` `venda das ações em bolsa de valores (art. 107, inciso II)` TRUE FALSE
#ASSERT NOT (`a companhia pode adotar a medida contra o acionista em mora (art. 107)` `execução para cobrar as importâncias devidas (art. 107, inciso I)` FALSE FALSE)
#ASSERT NOT (`a companhia pode adotar a medida contra o acionista em mora (art. 107)` `venda das ações em bolsa de valores (art. 107, inciso II)` FALSE FALSE)
-- Art. 107, § 4º: forfeiture needs the default AND that no means of the article got the shares paid.
#ASSERT `a companhia pode adotar a medida contra o acionista em mora (art. 107)` `declaração de caducidade das ações (art. 107, § 4º)` TRUE TRUE
#ASSERT NOT (`a companhia pode adotar a medida contra o acionista em mora (art. 107)` `declaração de caducidade das ações (art. 107, § 4º)` TRUE FALSE)
#ASSERT NOT (`a companhia pode adotar a medida contra o acionista em mora (art. 107)` `declaração de caducidade das ações (art. 107, § 4º)` FALSE TRUE)

-- Art. 107, § 1º: a clause that excludes or limits the options is deemed unwritten as against the company.
#ASSERT `a estipulação vale perante a companhia (art. 107, § 1º)` TRUE EQUALS JUST FALSE
-- A clause that does neither: the text does not say (NOTHING).
#ASSERT `a estipulação vale perante a companhia (art. 107, § 1º)` FALSE EQUALS NOTHING
#ASSERT `o subscritor de boa-fé tem ação contra os responsáveis pela estipulação (art. 107, § 1º)` TRUE TRUE TRUE
#ASSERT NOT (`o subscritor de boa-fé tem ação contra os responsáveis pela estipulação (art. 107, § 1º)` TRUE FALSE TRUE)
#ASSERT NOT (`o subscritor de boa-fé tem ação contra os responsáveis pela estipulação (art. 107, § 1º)` TRUE TRUE FALSE)
#ASSERT NOT (`o subscritor de boa-fé tem ação contra os responsáveis pela estipulação (art. 107, § 1º)` FALSE TRUE TRUE)

-- Art. 107, § 2º: special auction, on the exchange of the seat (or the nearest), notice published 3 times,
-- "com antecedência mínima de 3 dias": last notice 1 Mar 2026, auction 4 Mar 2026 = 3 days.
`venda regular (teste art. 107, § 2º)` MEANS `Fatos da venda das ações do acionista em mora (art. 107, § 2º)` WITH
    `a venda foi feita em leilão especial` IS TRUE
    `a venda foi feita na bolsa do lugar da sede ou, se não houver, na mais próxima` IS TRUE
    `a quantidade de publicações do aviso` IS 3
    `a data da última publicação do aviso` IS YMD 2026 3 1
    `a data do leilão` IS YMD 2026 3 4

`venda com aviso tardio (teste art. 107, § 2º)` MEANS `Fatos da venda das ações do acionista em mora (art. 107, § 2º)` WITH
    `a venda foi feita em leilão especial` IS TRUE
    `a venda foi feita na bolsa do lugar da sede ou, se não houver, na mais próxima` IS TRUE
    `a quantidade de publicações do aviso` IS 3
    `a data da última publicação do aviso` IS YMD 2026 3 2
    `a data do leilão` IS YMD 2026 3 4

`venda com duas publicações (teste art. 107, § 2º)` MEANS `Fatos da venda das ações do acionista em mora (art. 107, § 2º)` WITH
    `a venda foi feita em leilão especial` IS TRUE
    `a venda foi feita na bolsa do lugar da sede ou, se não houver, na mais próxima` IS TRUE
    `a quantidade de publicações do aviso` IS 2
    `a data da última publicação do aviso` IS YMD 2026 3 1
    `a data do leilão` IS YMD 2026 3 10

`venda fora da bolsa do lugar (teste art. 107, § 2º)` MEANS `Fatos da venda das ações do acionista em mora (art. 107, § 2º)` WITH
    `a venda foi feita em leilão especial` IS TRUE
    `a venda foi feita na bolsa do lugar da sede ou, se não houver, na mais próxima` IS FALSE
    `a quantidade de publicações do aviso` IS 3
    `a data da última publicação do aviso` IS YMD 2026 3 1
    `a data do leilão` IS YMD 2026 3 10

`venda sem leilão especial (teste art. 107, § 2º)` MEANS `Fatos da venda das ações do acionista em mora (art. 107, § 2º)` WITH
    `a venda foi feita em leilão especial` IS FALSE
    `a venda foi feita na bolsa do lugar da sede ou, se não houver, na mais próxima` IS TRUE
    `a quantidade de publicações do aviso` IS 3
    `a data da última publicação do aviso` IS YMD 2026 3 1
    `a data do leilão` IS YMD 2026 3 10

#ASSERT `a venda observa o leilão especial e o aviso (art. 107, § 2º)` `venda regular (teste art. 107, § 2º)`
#ASSERT NOT (`a venda observa o leilão especial e o aviso (art. 107, § 2º)` `venda com aviso tardio (teste art. 107, § 2º)`)
#ASSERT NOT (`a venda observa o leilão especial e o aviso (art. 107, § 2º)` `venda com duas publicações (teste art. 107, § 2º)`)
#ASSERT NOT (`a venda observa o leilão especial e o aviso (art. 107, § 2º)` `venda fora da bolsa do lugar (teste art. 107, § 2º)`)
#ASSERT NOT (`a venda observa o leilão especial e o aviso (art. 107, § 2º)` `venda sem leilão especial (teste art. 107, § 2º)`)

-- Art. 107, § 2º: proceeds 100,000; expenses 2,000; the estatuto provides interest 1,000, correction 500, fine 300:
-- 100,000 - 2,000 - (1,000 + 500 + 300) = 96,200.
`produto com encargos previstos (teste art. 107, § 2º)` MEANS `Produto da venda das ações em leilão (art. 107, § 2º)` WITH
    `o produto da venda em reais` IS 100000
    `as despesas com a operação em reais` IS 2000
    `o estatuto prevê juros, correção monetária e multa` IS TRUE
    `os juros previstos no estatuto em reais` IS 1000
    `a correção monetária prevista no estatuto em reais` IS 500
    `a multa prevista no estatuto em reais` IS 300

-- The estatuto does not provide for them: only the expenses are deducted, whatever amounts are typed in.
`produto sem encargos previstos (teste art. 107, § 2º)` MEANS `Produto da venda das ações em leilão (art. 107, § 2º)` WITH
    `o produto da venda em reais` IS 100000
    `as despesas com a operação em reais` IS 2000
    `o estatuto prevê juros, correção monetária e multa` IS FALSE
    `os juros previstos no estatuto em reais` IS 1000
    `a correção monetária prevista no estatuto em reais` IS 500
    `a multa prevista no estatuto em reais` IS 300

#ASSERT `o saldo à disposição do ex-acionista em reais (art. 107, § 2º)` `produto com encargos previstos (teste art. 107, § 2º)` EQUALS 96200
#ASSERT `o saldo à disposição do ex-acionista em reais (art. 107, § 2º)` `produto sem encargos previstos (teste art. 107, § 2º)` EQUALS 98000

-- Art. 107, § 3º: sale on the exchange even after judicial collection has begun; collection after a failed offer.
#ASSERT `a companhia pode mandar vender as ações em bolsa mesmo após iniciada a cobrança judicial (art. 107, § 3º)` TRUE TRUE
#ASSERT NOT (`a companhia pode mandar vender as ações em bolsa mesmo após iniciada a cobrança judicial (art. 107, § 3º)` FALSE TRUE)
#ASSERT NOT (`a companhia pode mandar vender as ações em bolsa mesmo após iniciada a cobrança judicial (art. 107, § 3º)` TRUE FALSE)
#ASSERT `a companhia pode promover a cobrança judicial depois da oferta em bolsa (art. 107, § 3º)` TRUE FALSE
#ASSERT `a companhia pode promover a cobrança judicial depois da oferta em bolsa (art. 107, § 3º)` FALSE TRUE
#ASSERT NOT (`a companhia pode promover a cobrança judicial depois da oferta em bolsa (art. 107, § 3º)` FALSE FALSE)

-- Art. 107, § 4º: forfeiture keeps the instalments already paid; payment up with profits or reserves (not the legal one).
#ASSERT `a companhia fica com as entradas já realizadas pelo acionista (art. 107, § 4º)` TRUE
#ASSERT NOT (`a companhia fica com as entradas já realizadas pelo acionista (art. 107, § 4º)` FALSE)
#ASSERT `a companhia pode integralizar as ações caídas em comisso com lucros ou reservas (art. 107, § 4º)` 500000 400000
#ASSERT `a companhia pode integralizar as ações caídas em comisso com lucros ou reservas (art. 107, § 4º)` 400000 400000
#ASSERT NOT (`a companhia pode integralizar as ações caídas em comisso com lucros ou reservas (art. 107, § 4º)` 399999 400000)
-- "1 (um) ano" from the declaration of forfeiture on 15 Mar 2026: until 15 Mar 2027 (the keel's convention).
#ASSERT `o termo final do prazo para colocar as ações caídas em comisso (art. 107, § 4º)` (YMD 2026 3 15) EQUALS YMD 2027 3 15
-- After the year, with no buyer and not enough profits or reserves, the general meeting deliberates on a capital reduction.
`situação um dia depois do ano (teste art. 107, § 4º)` MEANS `Situação das ações caídas em comisso (art. 107, § 4º)` WITH
    `a data de referência` IS YMD 2027 3 16
    `a data da declaração de caducidade` IS YMD 2026 3 15
    `a companhia tem lucros e reservas suficientes para integralizar as ações` IS FALSE
    `foi encontrado comprador para as ações caídas em comisso` IS FALSE

-- On the last day of the year the period has not ended ("findo o qual").
`situação no último dia do ano (teste art. 107, § 4º)` MEANS `Situação das ações caídas em comisso (art. 107, § 4º)` WITH
    `a data de referência` IS YMD 2027 3 15
    `a data da declaração de caducidade` IS YMD 2026 3 15
    `a companhia tem lucros e reservas suficientes para integralizar as ações` IS FALSE
    `foi encontrado comprador para as ações caídas em comisso` IS FALSE

`situação com lucros e reservas suficientes (teste art. 107, § 4º)` MEANS `Situação das ações caídas em comisso (art. 107, § 4º)` WITH
    `a data de referência` IS YMD 2027 3 16
    `a data da declaração de caducidade` IS YMD 2026 3 15
    `a companhia tem lucros e reservas suficientes para integralizar as ações` IS TRUE
    `foi encontrado comprador para as ações caídas em comisso` IS FALSE

`situação com comprador encontrado (teste art. 107, § 4º)` MEANS `Situação das ações caídas em comisso (art. 107, § 4º)` WITH
    `a data de referência` IS YMD 2027 3 16
    `a data da declaração de caducidade` IS YMD 2026 3 15
    `a companhia tem lucros e reservas suficientes para integralizar as ações` IS FALSE
    `foi encontrado comprador para as ações caídas em comisso` IS TRUE

#ASSERT `a assembleia-geral deve deliberar sobre a redução do capital (art. 107, § 4º)` `situação um dia depois do ano (teste art. 107, § 4º)`
#ASSERT NOT (`a assembleia-geral deve deliberar sobre a redução do capital (art. 107, § 4º)` `situação no último dia do ano (teste art. 107, § 4º)`)
#ASSERT NOT (`a assembleia-geral deve deliberar sobre a redução do capital (art. 107, § 4º)` `situação com lucros e reservas suficientes (teste art. 107, § 4º)`)
#ASSERT NOT (`a assembleia-geral deve deliberar sobre a redução do capital (art. 107, § 4º)` `situação com comprador encontrado (teste art. 107, § 4º)`)

§§ `Art. 108`

-- Art. 108: the transferor stays jointly liable for the instalments still missing on the shares transferred.
#ASSERT `o alienante responde solidariamente com o adquirente pelas prestações que faltarem (art. 108)` TRUE TRUE
#ASSERT NOT (`o alienante responde solidariamente com o adquirente pelas prestações que faltarem (art. 108)` TRUE FALSE)
#ASSERT NOT (`o alienante responde solidariamente com o adquirente pelas prestações que faltarem (art. 108)` FALSE TRUE)
-- Parágrafo único: it ceases "no fim de 2 (dois) anos a contar da data da transferência".
-- Transfer on 10 Jun 2024: still liable on 10 Jun 2026 (the last day), no longer from 11 Jun 2026.
#ASSERT `a responsabilidade do alienante já cessou (art. 108, parágrafo único)` (YMD 2024 6 10) (YMD 2025 1 1) EQUALS JUST FALSE
#ASSERT `a responsabilidade do alienante já cessou (art. 108, parágrafo único)` (YMD 2024 6 10) (YMD 2026 6 10) EQUALS JUST FALSE
#ASSERT `a responsabilidade do alienante já cessou (art. 108, parágrafo único)` (YMD 2024 6 10) (YMD 2026 6 11) EQUALS JUST TRUE
-- Reference date before the transfer: no liability yet to have ceased; the text is silent (NOTHING).
#ASSERT `a responsabilidade do alienante já cessou (art. 108, parágrafo único)` (YMD 2024 6 10) (YMD 2024 6 9) EQUALS NOTHING
