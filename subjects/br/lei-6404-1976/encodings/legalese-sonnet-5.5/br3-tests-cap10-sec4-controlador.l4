IMPORT prelude
IMPORT `br-core`
IMPORT `br3-cap10-sec4-controlador`

-- br3-tests-cap10-sec4-controlador.l4 -- tests of Arts. 116, 116-A and 117. Each expected value is written from the
-- text of the provision named beside it, before running.

§ `Testes dos arts. 116 a 117`

§§ `Art. 116`

`controle completo (teste art. 116)` MEANS `Fatos do controle (art. 116)` WITH
    `é pessoa natural ou jurídica, ou grupo de pessoas vinculadas por acordo de voto ou sob controle comum` IS TRUE
    `os direitos de sócio asseguram, de modo permanente, a maioria dos votos nas deliberações da assembleia-geral` IS TRUE
    `os direitos de sócio asseguram, de modo permanente, o poder de eleger a maioria dos administradores` IS TRUE
    `usa efetivamente seu poder para dirigir as atividades sociais e orientar o funcionamento dos órgãos da companhia` IS TRUE

#ASSERT `a pessoa ou o grupo é acionista controlador (art. 116)` `controle completo (teste art. 116)`
`sem a qualidade de pessoa ou grupo (teste art. 116)` MEANS `Fatos do controle (art. 116)` WITH
    `é pessoa natural ou jurídica, ou grupo de pessoas vinculadas por acordo de voto ou sob controle comum` IS FALSE
    `os direitos de sócio asseguram, de modo permanente, a maioria dos votos nas deliberações da assembleia-geral` IS TRUE
    `os direitos de sócio asseguram, de modo permanente, o poder de eleger a maioria dos administradores` IS TRUE
    `usa efetivamente seu poder para dirigir as atividades sociais e orientar o funcionamento dos órgãos da companhia` IS TRUE

#ASSERT NOT (`a pessoa ou o grupo é acionista controlador (art. 116)` `sem a qualidade de pessoa ou grupo (teste art. 116)`)
`sem a maioria dos votos (teste art. 116)` MEANS `Fatos do controle (art. 116)` WITH
    `é pessoa natural ou jurídica, ou grupo de pessoas vinculadas por acordo de voto ou sob controle comum` IS TRUE
    `os direitos de sócio asseguram, de modo permanente, a maioria dos votos nas deliberações da assembleia-geral` IS FALSE
    `os direitos de sócio asseguram, de modo permanente, o poder de eleger a maioria dos administradores` IS TRUE
    `usa efetivamente seu poder para dirigir as atividades sociais e orientar o funcionamento dos órgãos da companhia` IS TRUE

#ASSERT NOT (`a pessoa ou o grupo é acionista controlador (art. 116)` `sem a maioria dos votos (teste art. 116)`)
`sem o poder de eleger a maioria dos administradores (teste art. 116)` MEANS `Fatos do controle (art. 116)` WITH
    `é pessoa natural ou jurídica, ou grupo de pessoas vinculadas por acordo de voto ou sob controle comum` IS TRUE
    `os direitos de sócio asseguram, de modo permanente, a maioria dos votos nas deliberações da assembleia-geral` IS TRUE
    `os direitos de sócio asseguram, de modo permanente, o poder de eleger a maioria dos administradores` IS FALSE
    `usa efetivamente seu poder para dirigir as atividades sociais e orientar o funcionamento dos órgãos da companhia` IS TRUE

#ASSERT NOT (`a pessoa ou o grupo é acionista controlador (art. 116)` `sem o poder de eleger a maioria dos administradores (teste art. 116)`)
`sem uso efetivo do poder (teste art. 116)` MEANS `Fatos do controle (art. 116)` WITH
    `é pessoa natural ou jurídica, ou grupo de pessoas vinculadas por acordo de voto ou sob controle comum` IS TRUE
    `os direitos de sócio asseguram, de modo permanente, a maioria dos votos nas deliberações da assembleia-geral` IS TRUE
    `os direitos de sócio asseguram, de modo permanente, o poder de eleger a maioria dos administradores` IS TRUE
    `usa efetivamente seu poder para dirigir as atividades sociais e orientar o funcionamento dos órgãos da companhia` IS FALSE

#ASSERT NOT (`a pessoa ou o grupo é acionista controlador (art. 116)` `sem uso efetivo do poder (teste art. 116)`)

-- Parágrafo único: the controller's duty to use the power for the company's purpose and social function, and to respect
-- the interests of the other shareholders, the workers and the community.
#ASSERT `o acionista controlador cumpriu o dever de usar o poder (art. 116, parágrafo único)` TRUE TRUE TRUE
#ASSERT NOT (`o acionista controlador cumpriu o dever de usar o poder (art. 116, parágrafo único)` FALSE TRUE TRUE)
#ASSERT NOT (`o acionista controlador cumpriu o dever de usar o poder (art. 116, parágrafo único)` TRUE FALSE TRUE)
#ASSERT NOT (`o acionista controlador cumpriu o dever de usar o poder (art. 116, parágrafo único)` TRUE TRUE FALSE)

§§ `Art. 116-A`

-- The duty is the controller's and that of the shareholders who elect a board or fiscal-council member, in the open
-- company, when the position changes.
#ASSERT `o acionista deve informar a modificação de sua posição acionária à CVM e às bolsas (art. 116-A)` `companhia aberta` TRUE TRUE
#ASSERT NOT (`o acionista deve informar a modificação de sua posição acionária à CVM e às bolsas (art. 116-A)` `companhia fechada` TRUE TRUE)
#ASSERT NOT (`o acionista deve informar a modificação de sua posição acionária à CVM e às bolsas (art. 116-A)` `companhia aberta` FALSE TRUE)
#ASSERT NOT (`o acionista deve informar a modificação de sua posição acionária à CVM e às bolsas (art. 116-A)` `companhia aberta` TRUE FALSE)

§§ `Art. 117`

-- Caput: the controller answers for the damage caused by acts of abuse of power.
#ASSERT `o acionista controlador responde pelos danos do abuso de poder (art. 117)` TRUE TRUE
#ASSERT NOT (`o acionista controlador responde pelos danos do abuso de poder (art. 117)` TRUE FALSE)
#ASSERT NOT (`o acionista controlador responde pelos danos do abuso de poder (art. 117)` FALSE TRUE)

-- § 1º, alínea a: a purpose foreign to the company's object, or harmful to the national interest, or causing the company
-- to favour another company to the prejudice of the minority.
#ASSERT `a conduta é abuso de poder pela alínea a (art. 117, § 1º, alínea a)` TRUE FALSE FALSE FALSE
#ASSERT `a conduta é abuso de poder pela alínea a (art. 117, § 1º, alínea a)` FALSE TRUE FALSE FALSE
#ASSERT `a conduta é abuso de poder pela alínea a (art. 117, § 1º, alínea a)` FALSE FALSE TRUE TRUE
#ASSERT NOT (`a conduta é abuso de poder pela alínea a (art. 117, § 1º, alínea a)` FALSE FALSE TRUE FALSE)
#ASSERT NOT (`a conduta é abuso de poder pela alínea a (art. 117, § 1º, alínea a)` FALSE FALSE FALSE TRUE)
#ASSERT NOT (`a conduta é abuso de poder pela alínea a (art. 117, § 1º, alínea a)` FALSE FALSE FALSE FALSE)
-- alínea b: liquidation of a prosperous company, or transformation, merger or split, with undue advantage, to the
-- prejudice of the others.
#ASSERT `a conduta é abuso de poder pela alínea b (art. 117, § 1º, alínea b)` TRUE FALSE TRUE TRUE
#ASSERT `a conduta é abuso de poder pela alínea b (art. 117, § 1º, alínea b)` FALSE TRUE TRUE TRUE
#ASSERT NOT (`a conduta é abuso de poder pela alínea b (art. 117, § 1º, alínea b)` FALSE FALSE TRUE TRUE)
#ASSERT NOT (`a conduta é abuso de poder pela alínea b (art. 117, § 1º, alínea b)` TRUE FALSE FALSE TRUE)
#ASSERT NOT (`a conduta é abuso de poder pela alínea b (art. 117, § 1º, alínea b)` TRUE FALSE TRUE FALSE)
-- alínea c
#ASSERT `a conduta é abuso de poder pela alínea c (art. 117, § 1º, alínea c)` TRUE TRUE TRUE
#ASSERT NOT (`a conduta é abuso de poder pela alínea c (art. 117, § 1º, alínea c)` FALSE TRUE TRUE)
#ASSERT NOT (`a conduta é abuso de poder pela alínea c (art. 117, § 1º, alínea c)` TRUE FALSE TRUE)
#ASSERT NOT (`a conduta é abuso de poder pela alínea c (art. 117, § 1º, alínea c)` TRUE TRUE FALSE)
-- alínea d
#ASSERT `a conduta é abuso de poder pela alínea d (art. 117, § 1º, alínea d)` TRUE TRUE
#ASSERT NOT (`a conduta é abuso de poder pela alínea d (art. 117, § 1º, alínea d)` TRUE FALSE)
#ASSERT NOT (`a conduta é abuso de poder pela alínea d (art. 117, § 1º, alínea d)` FALSE TRUE)
-- alínea e: inducing or attempting to induce an illegal act, or promoting its ratification against the company's interest.
#ASSERT `a conduta é abuso de poder pela alínea e (art. 117, § 1º, alínea e)` TRUE FALSE
#ASSERT `a conduta é abuso de poder pela alínea e (art. 117, § 1º, alínea e)` FALSE TRUE
#ASSERT NOT (`a conduta é abuso de poder pela alínea e (art. 117, § 1º, alínea e)` FALSE FALSE)
-- alínea f
#ASSERT `a conduta é abuso de poder pela alínea f (art. 117, § 1º, alínea f)` TRUE TRUE
#ASSERT NOT (`a conduta é abuso de poder pela alínea f (art. 117, § 1º, alínea f)` TRUE FALSE)
#ASSERT NOT (`a conduta é abuso de poder pela alínea f (art. 117, § 1º, alínea f)` FALSE TRUE)
-- alínea g: approving irregular accounts out of personal favour, or failing to investigate a well-founded complaint.
#ASSERT `a conduta é abuso de poder pela alínea g (art. 117, § 1º, alínea g)` TRUE TRUE FALSE FALSE
#ASSERT `a conduta é abuso de poder pela alínea g (art. 117, § 1º, alínea g)` FALSE FALSE TRUE TRUE
#ASSERT NOT (`a conduta é abuso de poder pela alínea g (art. 117, § 1º, alínea g)` TRUE FALSE FALSE FALSE)
#ASSERT NOT (`a conduta é abuso de poder pela alínea g (art. 117, § 1º, alínea g)` FALSE FALSE TRUE FALSE)
#ASSERT NOT (`a conduta é abuso de poder pela alínea g (art. 117, § 1º, alínea g)` FALSE TRUE FALSE TRUE)
-- alínea h
#ASSERT `a conduta é abuso de poder pela alínea h (art. 117, § 1º, alínea h)` TRUE TRUE
#ASSERT NOT (`a conduta é abuso de poder pela alínea h (art. 117, § 1º, alínea h)` TRUE FALSE)
#ASSERT NOT (`a conduta é abuso de poder pela alínea h (art. 117, § 1º, alínea h)` FALSE TRUE)
-- § 2º: for the case of alínea e, the manager or fiscal who practised the illegal act answers jointly with the controller.
#ASSERT `o administrador ou fiscal responde solidariamente com o acionista controlador (art. 117, § 2º)` TRUE TRUE
#ASSERT NOT (`o administrador ou fiscal responde solidariamente com o acionista controlador (art. 117, § 2º)` FALSE TRUE)
#ASSERT NOT (`o administrador ou fiscal responde solidariamente com o acionista controlador (art. 117, § 2º)` TRUE FALSE)
-- § 3º
#ASSERT `o acionista controlador tem também os deveres e responsabilidades do cargo (art. 117, § 3º)` TRUE
#ASSERT NOT (`o acionista controlador tem também os deveres e responsabilidades do cargo (art. 117, § 3º)` FALSE)
