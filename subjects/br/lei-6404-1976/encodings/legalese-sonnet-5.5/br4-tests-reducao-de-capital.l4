IMPORT prelude
IMPORT `br-core`
IMPORT `br4-reducao-de-capital`

-- br4-tests-reducao-de-capital.l4 -- tests of br4-reducao-de-capital.l4 (arts. 173 and 174).
-- Every expected value was decided from the text of the article, written beside the assertion, and then run.

§ `Testes do art. 173`

-- caput: a loss, up to the accumulated losses (100 of 100 is the cap), or a capital judged excessive (no cap).
#ASSERT `a assembleia-geral pode deliberar a redução do capital social (art. 173)` TRUE 100 100 FALSE
#ASSERT `a assembleia-geral pode deliberar a redução do capital social (art. 173)` TRUE 50 100 FALSE
#ASSERT NOT (`a assembleia-geral pode deliberar a redução do capital social (art. 173)` TRUE 101 100 FALSE)
#ASSERT NOT (`a assembleia-geral pode deliberar a redução do capital social (art. 173)` FALSE 50 100 FALSE)
#ASSERT `a assembleia-geral pode deliberar a redução do capital social (art. 173)` FALSE 500 0 TRUE
#ASSERT `a assembleia-geral pode deliberar a redução do capital social (art. 173)` TRUE 500 100 TRUE
-- § 1º: the council's opinion, only for a proposal of the administradores and a council in operation.
#ASSERT `a proposta pode ser submetida à deliberação da assembleia-geral (art. 173, § 1º)` TRUE TRUE TRUE
#ASSERT NOT (`a proposta pode ser submetida à deliberação da assembleia-geral (art. 173, § 1º)` TRUE TRUE FALSE)
#ASSERT `a proposta pode ser submetida à deliberação da assembleia-geral (art. 173, § 1º)` TRUE FALSE FALSE
#ASSERT `a proposta pode ser submetida à deliberação da assembleia-geral (art. 173, § 1º)` FALSE TRUE FALSE
#ASSERT `a proposta pode ser submetida à deliberação da assembleia-geral (art. 173, § 1º)` FALSE FALSE FALSE
-- § 2º: rights suspended for shares with an issued certificate not yet presented.
#ASSERT `os direitos correspondentes à ação ficam suspensos (art. 173, § 2º)` TRUE TRUE FALSE
#ASSERT NOT (`os direitos correspondentes à ação ficam suspensos (art. 173, § 2º)` TRUE TRUE TRUE)
#ASSERT NOT (`os direitos correspondentes à ação ficam suspensos (art. 173, § 2º)` TRUE FALSE FALSE)
#ASSERT NOT (`os direitos correspondentes à ação ficam suspensos (art. 173, § 2º)` FALSE TRUE FALSE)

§ `Testes do art. 174`

-- caput: publication on 1 March 2026; the 60th day is 30 April; the reduction takes effect after it (1 May). Arts. 45 and 107: silent.
#ASSERT `a redução do capital já se tornou efetiva (art. 174)` TRUE FALSE (YearMonthDay 2026 3 1) (YearMonthDay 2026 5 1) EQUALS JUST TRUE
#ASSERT `a redução do capital já se tornou efetiva (art. 174)` TRUE FALSE (YearMonthDay 2026 3 1) (YearMonthDay 2026 4 30) EQUALS JUST FALSE
#ASSERT `a redução do capital já se tornou efetiva (art. 174)` TRUE FALSE (YearMonthDay 2026 3 1) (YearMonthDay 2026 3 1) EQUALS JUST FALSE
#ASSERT `a redução do capital já se tornou efetiva (art. 174)` TRUE TRUE (YearMonthDay 2026 3 1) (YearMonthDay 2026 5 1) EQUALS NOTHING
#ASSERT `a redução do capital já se tornou efetiva (art. 174)` FALSE FALSE (YearMonthDay 2026 3 1) (YearMonthDay 2026 5 1) EQUALS NOTHING
-- § 1º: the unsecured creditor with a title before the publication, notifying within the 60 days.
#ASSERT `o credor pode opor-se à redução (art. 174, § 1º)` TRUE (YearMonthDay 2026 2 28) (YearMonthDay 2026 3 1) (YearMonthDay 2026 4 30)
#ASSERT NOT (`o credor pode opor-se à redução (art. 174, § 1º)` TRUE (YearMonthDay 2026 2 28) (YearMonthDay 2026 3 1) (YearMonthDay 2026 5 1))
#ASSERT NOT (`o credor pode opor-se à redução (art. 174, § 1º)` TRUE (YearMonthDay 2026 3 1) (YearMonthDay 2026 3 1) (YearMonthDay 2026 3 10))
#ASSERT NOT (`o credor pode opor-se à redução (art. 174, § 1º)` TRUE (YearMonthDay 2026 3 2) (YearMonthDay 2026 3 1) (YearMonthDay 2026 3 10))
#ASSERT NOT (`o credor pode opor-se à redução (art. 174, § 1º)` FALSE (YearMonthDay 2026 2 28) (YearMonthDay 2026 3 1) (YearMonthDay 2026 3 10))
#ASSERT `o credor decaiu do direito de oposição (art. 174, § 1º)` FALSE (YearMonthDay 2026 3 1) (YearMonthDay 2026 5 1)
#ASSERT NOT (`o credor decaiu do direito de oposição (art. 174, § 1º)` FALSE (YearMonthDay 2026 3 1) (YearMonthDay 2026 4 30))
#ASSERT NOT (`o credor decaiu do direito de oposição (art. 174, § 1º)` TRUE (YearMonthDay 2026 3 1) (YearMonthDay 2026 5 1))
#ASSERT `a notificação do credor cumpriu a ciência ao registro do comércio (art. 174, § 1º)` TRUE
#ASSERT NOT (`a notificação do credor cumpriu a ciência ao registro do comércio (art. 174, § 1º)` FALSE)
-- § 2º: after the period; filing if no opposition, or if opposed once paid or deposited.
#ASSERT `a ata da assembleia-geral que deliberou a redução pode ser arquivada (art. 174, § 2º)` (YearMonthDay 2026 3 1) (YearMonthDay 2026 5 1) FALSE FALSE
#ASSERT `a ata da assembleia-geral que deliberou a redução pode ser arquivada (art. 174, § 2º)` (YearMonthDay 2026 3 1) (YearMonthDay 2026 5 1) TRUE TRUE
#ASSERT NOT (`a ata da assembleia-geral que deliberou a redução pode ser arquivada (art. 174, § 2º)` (YearMonthDay 2026 3 1) (YearMonthDay 2026 5 1) TRUE FALSE)
#ASSERT NOT (`a ata da assembleia-geral que deliberou a redução pode ser arquivada (art. 174, § 2º)` (YearMonthDay 2026 3 1) (YearMonthDay 2026 4 30) FALSE FALSE)
-- § 3º: debentures in circulation need the prior approval of the majority of their holders.
#ASSERT `a redução pode ser efetivada quanto às debêntures (art. 174, § 3º)` FALSE FALSE
#ASSERT `a redução pode ser efetivada quanto às debêntures (art. 174, § 3º)` TRUE TRUE
#ASSERT NOT (`a redução pode ser efetivada quanto às debêntures (art. 174, § 3º)` TRUE FALSE)

