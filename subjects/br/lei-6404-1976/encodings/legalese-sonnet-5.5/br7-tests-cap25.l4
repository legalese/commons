IMPORT prelude
IMPORT daydate
IMPORT `br-core`
IMPORT `br7-cap25-disposicoes-gerais`

-- br7-tests-cap25.l4 -- tests of br7-cap25-disposicoes-gerais.l4 (arts. 289 to 294-B).
-- Every expected value was decided from the text before the run and is written beside its assertion. A failing assertion is a
-- finding, never a reason to edit the expected value.

§ `Testes: arts. 289 e 290`

-- Ruler of the ten columns of a publication, in the order of the DECLARE:
--   em jornal editado na sede, não há jornal editado na sede, em órgão local de grande circulação, de forma resumida,
--   íntegra simultânea na internet, certificação digital ICP-Brasil, de demonstrações financeiras,
--   compara com o exercício social anterior, valores globais e classificação de contas, extratos das notas e dos pareceres
`publicação regular de demonstrações financeiras (teste art. 289)` MEANS
    `Publicação ordenada pela Lei (art. 289)` OF TRUE, FALSE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE

-- Art. 289, I and II: a summarised publication in the newspaper edited at the seat, with the full text and the certification
-- on the newspaper's internet page, and (II) the summary with all three contents: meets the article.
#ASSERT `a publicação atende as condições do art. 289 (art. 289)` `publicação regular de demonstrações financeiras (teste art. 289)`

-- § 2º: no newspaper is edited at the seat, and the publication is in the local organ of wide circulation: meets the article.
`publicação no órgão local, sem jornal na sede (teste art. 289)` MEANS
    `Publicação ordenada pela Lei (art. 289)` OF FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE
#ASSERT `a publicação atende as condições do art. 289 (art. 289)` `publicação no órgão local, sem jornal na sede (teste art. 289)`

-- § 2º applies only "se no lugar ... não for editado jornal": where a newspaper IS edited at the seat, publishing in the local
-- organ instead does not meet the article.
`publicação no órgão local havendo jornal na sede (teste art. 289)` MEANS
    `Publicação ordenada pela Lei (art. 289)` OF FALSE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE
#ASSERT NOT (`a publicação atende as condições do art. 289 (art. 289)` `publicação no órgão local havendo jornal na sede (teste art. 289)`)

-- No newspaper at the seat, but not in the local organ either: does not meet the article.
`publicação em lugar nenhum exigido (teste art. 289)` MEANS
    `Publicação ordenada pela Lei (art. 289)` OF FALSE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE
#ASSERT NOT (`a publicação atende as condições do art. 289 (art. 289)` `publicação em lugar nenhum exigido (teste art. 289)`)

-- Item I is cumulative: dropping the summary form, the simultaneous full text or the certification each fails the article.
`publicação não resumida (teste art. 289)` MEANS
    `Publicação ordenada pela Lei (art. 289)` OF TRUE, FALSE, FALSE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE
`publicação sem a íntegra na internet (teste art. 289)` MEANS
    `Publicação ordenada pela Lei (art. 289)` OF TRUE, FALSE, FALSE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE
`publicação sem certificação digital (teste art. 289)` MEANS
    `Publicação ordenada pela Lei (art. 289)` OF TRUE, FALSE, FALSE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE
#ASSERT NOT (`a publicação atende as condições do art. 289 (art. 289)` `publicação não resumida (teste art. 289)`)
#ASSERT NOT (`a publicação atende as condições do art. 289 (art. 289)` `publicação sem a íntegra na internet (teste art. 289)`)
#ASSERT NOT (`a publicação atende as condições do art. 289 (art. 289)` `publicação sem certificação digital (teste art. 289)`)

-- Item II applies to financial statements: each of the three contents is needed.
`demonstrações sem comparação com o exercício anterior (teste art. 289)` MEANS
    `Publicação ordenada pela Lei (art. 289)` OF TRUE, FALSE, FALSE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE
`demonstrações sem valores globais (teste art. 289)` MEANS
    `Publicação ordenada pela Lei (art. 289)` OF TRUE, FALSE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE
`demonstrações sem extratos (teste art. 289)` MEANS
    `Publicação ordenada pela Lei (art. 289)` OF TRUE, FALSE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE
#ASSERT NOT (`a publicação atende as condições do art. 289 (art. 289)` `demonstrações sem comparação com o exercício anterior (teste art. 289)`)
#ASSERT NOT (`a publicação atende as condições do art. 289 (art. 289)` `demonstrações sem valores globais (teste art. 289)`)
#ASSERT NOT (`a publicação atende as condições do art. 289 (art. 289)` `demonstrações sem extratos (teste art. 289)`)

-- A publication that is not of financial statements (a convocation notice, say) needs only item I.
`publicação que não é de demonstrações financeiras (teste art. 289)` MEANS
    `Publicação ordenada pela Lei (art. 289)` OF TRUE, FALSE, FALSE, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE
#ASSERT `a publicação atende as condições do art. 289 (art. 289)` `publicação que não é de demonstrações financeiras (teste art. 289)`

-- § 1º: the CVM's order is the CVM's; no order, nothing is owed; an order is owed once made.
#ASSERT `a companhia cumpriu a publicação adicional determinada pela CVM (art. 289, § 1º)` FALSE FALSE
#ASSERT `a companhia cumpriu a publicação adicional determinada pela CVM (art. 289, § 1º)` TRUE TRUE
#ASSERT NOT (`a companhia cumpriu a publicação adicional determinada pela CVM (art. 289, § 1º)` TRUE FALSE)

-- §§ 3º and 4º: same newspaper; a change needs prior notice unless it is the occasional publication of minutes or balance sheets.
#ASSERT `a companhia observou a regra do mesmo jornal (art. 289, § 3º)` FALSE FALSE FALSE
#ASSERT `a companhia observou a regra do mesmo jornal (art. 289, § 3º)` TRUE TRUE FALSE
#ASSERT NOT (`a companhia observou a regra do mesmo jornal (art. 289, § 3º)` TRUE FALSE FALSE)
#ASSERT `a companhia observou a regra do mesmo jornal (art. 289, § 3º)` TRUE FALSE TRUE
#ASSERT `o fim do § 3º do art. 289 não se aplica à publicação em outro jornal (art. 289, § 4º)` TRUE
#ASSERT NOT (`o fim do § 3º do art. 289 não se aplica à publicação em outro jornal (art. 289, § 4º)` FALSE)

-- § 5º: every publication is filed at the registry of commerce.
#ASSERT `a publicação ordenada pela Lei foi arquivada no registro do comércio (art. 289, § 5º)` TRUE
#ASSERT NOT (`a publicação ordenada pela Lei foi arquivada no registro do comércio (art. 289, § 5º)` FALSE)

-- § 6º: thousands of reais are allowed for the balance sheet and the income statement; the text is silent about the rest.
#ASSERT `a publicação pode expressar valores em milhares de reais (art. 289, § 6º)` TRUE EQUALS JUST TRUE
#ASSERT `a publicação pode expressar valores em milhares de reais (art. 289, § 6º)` FALSE EQUALS NOTHING

-- § 7º: open companies may also publish on the internet; the paragraph is silent about closed ones.
#ASSERT `a companhia pode disponibilizar as publicações pela rede mundial de computadores (art. 289, § 7º)` `companhia aberta` EQUALS JUST TRUE
#ASSERT `a companhia pode disponibilizar as publicações pela rede mundial de computadores (art. 289, § 7º)` `companhia fechada` EQUALS NOTHING

-- Art. 290: the civil quarter of the effective payment. Quarter 1 is January to March, 2 is April to June, 3 is July to
-- September, 4 is October to December; the first and the last day of each quarter fall inside it.
#ASSERT `o trimestre civil até o qual corre a correção monetária (art. 290)` TRUE (YMD 2020 1 1) EQUALS JUST (`Trimestre civil (art. 290)` OF 2020, 1)
#ASSERT `o trimestre civil até o qual corre a correção monetária (art. 290)` TRUE (YMD 2020 3 31) EQUALS JUST (`Trimestre civil (art. 290)` OF 2020, 1)
#ASSERT `o trimestre civil até o qual corre a correção monetária (art. 290)` TRUE (YMD 2020 4 1) EQUALS JUST (`Trimestre civil (art. 290)` OF 2020, 2)
#ASSERT `o trimestre civil até o qual corre a correção monetária (art. 290)` TRUE (YMD 2020 6 30) EQUALS JUST (`Trimestre civil (art. 290)` OF 2020, 2)
#ASSERT `o trimestre civil até o qual corre a correção monetária (art. 290)` TRUE (YMD 2020 7 1) EQUALS JUST (`Trimestre civil (art. 290)` OF 2020, 3)
#ASSERT `o trimestre civil até o qual corre a correção monetária (art. 290)` TRUE (YMD 2020 9 30) EQUALS JUST (`Trimestre civil (art. 290)` OF 2020, 3)
#ASSERT `o trimestre civil até o qual corre a correção monetária (art. 290)` TRUE (YMD 2020 10 1) EQUALS JUST (`Trimestre civil (art. 290)` OF 2020, 4)
#ASSERT `o trimestre civil até o qual corre a correção monetária (art. 290)` TRUE (YMD 2020 12 31) EQUALS JUST (`Trimestre civil (art. 290)` OF 2020, 4)
-- Not covered: the article speaks only of actions founded on this Law.
#ASSERT `o trimestre civil até o qual corre a correção monetária (art. 290)` FALSE (YMD 2020 5 15) EQUALS NOTHING

§ `Testes: arts. 291 a 293`

-- Art. 291: the CVM may reduce the percentage only for open companies and only for the listed provisions.
#ASSERT `a CVM pode reduzir a porcentagem mínima da disposição para a companhia (art. 291)` `porcentagem do art. 277 (art. 291)` `companhia aberta`
#ASSERT `a CVM pode reduzir a porcentagem mínima da disposição para a companhia (art. 291)` `porcentagem do art. 105 (art. 291)` `companhia aberta`
#ASSERT `a CVM pode reduzir a porcentagem mínima da disposição para a companhia (art. 291)` `porcentagem do art. 249 (art. 291, parágrafo único)` `companhia aberta`
#ASSERT NOT (`a CVM pode reduzir a porcentagem mínima da disposição para a companhia (art. 291)` `porcentagem do art. 277 (art. 291)` `companhia fechada`)
#ASSERT NOT (`a CVM pode reduzir a porcentagem mínima da disposição para a companhia (art. 291)` `outra porcentagem mínima da Lei (art. 291)` `companhia aberta`)

-- The percentage that applies: no CVM figure, the Law's 5%.
#ASSERT `a porcentagem mínima aplicável à companhia (art. 291)` `porcentagem do art. 277 (art. 291)` `companhia aberta` (5%) NOTHING EQUALS (5%)
-- An open company with a CVM scale figure of 2% for art. 277: 2%.
#ASSERT `a porcentagem mínima aplicável à companhia (art. 291)` `porcentagem do art. 277 (art. 291)` `companhia aberta` (5%) (JUST (2%)) EQUALS (2%)
-- A CVM figure equal to the Law's is a reduction of nothing: 5%.
#ASSERT `a porcentagem mínima aplicável à companhia (art. 291)` `porcentagem do art. 277 (art. 291)` `companhia aberta` (5%) (JUST (5%)) EQUALS (5%)
-- A CVM figure above the Law's is not a reduction, which is all art. 291 allows: the Law's 5% stands.
#ASSERT `a porcentagem mínima aplicável à companhia (art. 291)` `porcentagem do art. 277 (art. 291)` `companhia aberta` (5%) (JUST (6%)) EQUALS (5%)
-- A closed company gets no reduction.
#ASSERT `a porcentagem mínima aplicável à companhia (art. 291)` `porcentagem do art. 277 (art. 291)` `companhia fechada` (5%) (JUST (2%)) EQUALS (5%)
-- A provision the article does not list gets no reduction.
#ASSERT `a porcentagem mínima aplicável à companhia (art. 291)` `outra porcentagem mínima da Lei (art. 291)` `companhia aberta` (10%) (JUST (2%)) EQUALS (10%)

-- Art. 292: the societies of art. 62 of Lei nº 4.728/1965 may have bearer shares; for any other society the article is silent.
#ASSERT `a sociedade pode ter ações ao portador (art. 292)` TRUE EQUALS JUST TRUE
#ASSERT `a sociedade pode ter ações ao portador (art. 292)` FALSE EQUALS NOTHING

-- Art. 293: the six listed groups of services, authorised or not; a service not listed is not covered.
#ASSERT `a entidade pode prestar o serviço (art. 293)` `serviços do art. 27 (art. 293, inciso I)` TRUE EQUALS JUST TRUE
#ASSERT `a entidade pode prestar o serviço (art. 293)` `serviços do art. 27 (art. 293, inciso I)` FALSE EQUALS JUST FALSE
#ASSERT `a entidade pode prestar o serviço (art. 293)` `serviços do art. 34, § 2º (art. 293, inciso II)` TRUE EQUALS JUST TRUE
#ASSERT `a entidade pode prestar o serviço (art. 293)` `serviços do art. 39, § 1º (art. 293, inciso III)` TRUE EQUALS JUST TRUE
#ASSERT `a entidade pode prestar o serviço (art. 293)` `serviços dos arts. 40 a 44 (art. 293, inciso IV)` TRUE EQUALS JUST TRUE
#ASSERT `a entidade pode prestar o serviço (art. 293)` `serviços do art. 72 (art. 293, inciso V)` FALSE EQUALS JUST FALSE
#ASSERT `a entidade pode prestar o serviço (art. 293)` `serviços dos arts. 102 e 103 (art. 293, inciso VI)` TRUE EQUALS JUST TRUE
#ASSERT `a entidade pode prestar o serviço (art. 293)` `outro serviço previsto na Lei (art. 293)` TRUE EQUALS NOTHING

§ `Testes: art. 294`

-- Art. 294, caput: a closed company with gross annual revenue of up to R$ 78,000,000.00; "de até": the limit is inside.
#ASSERT `a companhia é fechada e tem receita bruta anual de até o limite (art. 294)` `companhia fechada` 78_000_000
#ASSERT NOT (`a companhia é fechada e tem receita bruta anual de até o limite (art. 294)` `companhia fechada` 78_000_001)
#ASSERT `a companhia é fechada e tem receita bruta anual de até o limite (art. 294)` `companhia fechada` 77_999_999
#ASSERT `a companhia é fechada e tem receita bruta anual de até o limite (art. 294)` `companhia fechada` 0
#ASSERT NOT (`a companhia é fechada e tem receita bruta anual de até o limite (art. 294)` `companhia aberta` 1_000_000)

-- § 3º: the command company of a group, or a company affiliated to it, is taken out.
#ASSERT `o art. 294 não se aplica à companhia do grupo (art. 294, § 3º)` TRUE FALSE
#ASSERT `o art. 294 não se aplica à companhia do grupo (art. 294, § 3º)` FALSE TRUE
#ASSERT NOT (`o art. 294 não se aplica à companhia do grupo (art. 294, § 3º)` FALSE FALSE)

-- The faculties of art. 294 belong to the company that meets the caput and is not taken out by § 3º.
#ASSERT `a companhia pode valer-se das faculdades do art. 294 (art. 294)` `companhia fechada` 78_000_000 FALSE FALSE
#ASSERT NOT (`a companhia pode valer-se das faculdades do art. 294 (art. 294)` `companhia fechada` 78_000_001 FALSE FALSE)
#ASSERT NOT (`a companhia pode valer-se das faculdades do art. 294 (art. 294)` `companhia aberta` 1_000_000 FALSE FALSE)
#ASSERT NOT (`a companhia pode valer-se das faculdades do art. 294 (art. 294)` `companhia fechada` 1_000_000 TRUE FALSE)
#ASSERT NOT (`a companhia pode valer-se das faculdades do art. 294 (art. 294)` `companhia fechada` 1_000_000 FALSE TRUE)

-- Items III and IV follow the faculties.
#ASSERT `a companhia pode fazer as publicações de forma eletrônica, em exceção ao art. 289 (art. 294, inciso III)` `companhia fechada` 10_000_000 FALSE FALSE
#ASSERT NOT (`a companhia pode fazer as publicações de forma eletrônica, em exceção ao art. 289 (art. 294, inciso III)` `companhia aberta` 10_000_000 FALSE FALSE)
#ASSERT `a companhia pode substituir os livros do art. 100 por registros mecanizados ou eletrônicos (art. 294, inciso IV)` `companhia fechada` 10_000_000 FALSE FALSE
#ASSERT NOT (`a companhia pode substituir os livros do art. 100 por registros mecanizados ou eletrônicos (art. 294, inciso IV)` `companhia fechada` 90_000_000 FALSE FALSE)

-- § 1º: the receipts are kept and authenticated copies filed with the minutes; both are needed.
#ASSERT `a companhia cumpriu o dever de guardar e arquivar os recibos dos anúncios de convocação (art. 294, § 1º)` TRUE TRUE
#ASSERT NOT (`a companhia cumpriu o dever de guardar e arquivar os recibos dos anúncios de convocação (art. 294, § 1º)` TRUE FALSE)
#ASSERT NOT (`a companhia cumpriu o dever de guardar e arquivar os recibos dos anúncios de convocação (art. 294, § 1º)` FALSE TRUE)

-- § 2º: the profit share may be paid without art. 152, § 2º only with the unanimity of the shareholders.
#ASSERT `o pagamento da participação dos administradores pode dispensar o art. 152, § 2º (art. 294, § 2º)` `companhia fechada` 10_000_000 FALSE FALSE TRUE
#ASSERT NOT (`o pagamento da participação dos administradores pode dispensar o art. 152, § 2º (art. 294, § 2º)` `companhia fechada` 10_000_000 FALSE FALSE FALSE)
#ASSERT NOT (`o pagamento da participação dos administradores pode dispensar o art. 152, § 2º (art. 294, § 2º)` `companhia aberta` 10_000_000 FALSE FALSE TRUE)

-- § 4º: silent estatuto, no prejudice to the preferred shareholders' fixed or minimum dividends: the meeting is free, art. 202 aside.
#ASSERT `a assembleia-geral estabelece livremente os dividendos, sem o art. 202 (art. 294, § 4º)` `companhia fechada` 10_000_000 FALSE FALSE TRUE FALSE
-- The estatuto is not silent: the meeting is not free.
#ASSERT NOT (`a assembleia-geral estabelece livremente os dividendos, sem o art. 202 (art. 294, § 4º)` `companhia fechada` 10_000_000 FALSE FALSE FALSE FALSE)
-- The preferred shareholders' right is prejudiced: the meeting is not free.
#ASSERT NOT (`a assembleia-geral estabelece livremente os dividendos, sem o art. 202 (art. 294, § 4º)` `companhia fechada` 10_000_000 FALSE FALSE TRUE TRUE)
-- The company is outside art. 294 (revenue over the limit): the meeting is not free.
#ASSERT NOT (`a assembleia-geral estabelece livremente os dividendos, sem o art. 202 (art. 294, § 4º)` `companhia fechada` 78_000_001 FALSE FALSE TRUE FALSE)

§ `Testes: arts. 294-A e 294-B`

-- Art. 294-B: "inferior a R$ 500.000.000,00": the limit itself is out.
#ASSERT `o valor-limite da receita bruta anual da companhia de menor porte em reais (art. 294-B)` NOTHING EQUALS 500_000_000
#ASSERT `a companhia é de menor porte (art. 294-B)` 499_999_999 NOTHING
#ASSERT NOT (`a companhia é de menor porte (art. 294-B)` 500_000_000 NOTHING)
#ASSERT NOT (`a companhia é de menor porte (art. 294-B)` 500_000_001 NOTHING)
-- The CVM fixed an updated figure of R$ 600,000,000 (an input): it replaces the Law's figure, and it too is "inferior a".
#ASSERT `o valor-limite da receita bruta anual da companhia de menor porte em reais (art. 294-B)` (JUST 600_000_000) EQUALS 600_000_000
#ASSERT `a companhia é de menor porte (art. 294-B)` 550_000_000 (JUST 600_000_000)
#ASSERT NOT (`a companhia é de menor porte (art. 294-B)` 600_000_000 (JUST 600_000_000))

-- Art. 294-A: the CVM may dispense with or modulate four obligations for a smaller company.
#ASSERT `a CVM pode dispensar ou modular a obrigação na companhia (art. 294-A)` `instalação do conselho fiscal a pedido de acionistas, art. 161 (art. 294-A, inciso I)` TRUE EQUALS JUST TRUE
#ASSERT `a CVM pode dispensar ou modular a obrigação na companhia (art. 294-A)` `instalação do conselho fiscal a pedido de acionistas, art. 161 (art. 294-A, inciso I)` FALSE EQUALS JUST FALSE
#ASSERT `a CVM pode dispensar ou modular a obrigação na companhia (art. 294-A)` `intermediação de instituição financeira em distribuições públicas, art. 170, § 5º (art. 294-A, inciso II)` TRUE EQUALS JUST TRUE
#ASSERT `a CVM pode dispensar ou modular a obrigação na companhia (art. 294-A)` `recebimento de dividendo obrigatório, arts. 109, I, 111, §§ 1º e 2º, e 202 (art. 294-A, inciso III)` TRUE EQUALS JUST TRUE
#ASSERT `a CVM pode dispensar ou modular a obrigação na companhia (art. 294-A)` `forma de realização das publicações, art. 289 (art. 294-A, inciso IV)` TRUE EQUALS JUST TRUE
-- Not covered: any other obligation.
#ASSERT `a CVM pode dispensar ou modular a obrigação na companhia (art. 294-A)` `outra obrigação da Lei (art. 294-A)` TRUE EQUALS NOTHING
-- Dispensed in fact: allowed AND done by the CVM's regulation.
#ASSERT `a obrigação está dispensada ou modulada na companhia (art. 294-A)` `instalação do conselho fiscal a pedido de acionistas, art. 161 (art. 294-A, inciso I)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `a obrigação está dispensada ou modulada na companhia (art. 294-A)` `instalação do conselho fiscal a pedido de acionistas, art. 161 (art. 294-A, inciso I)` TRUE FALSE EQUALS JUST FALSE
#ASSERT `a obrigação está dispensada ou modulada na companhia (art. 294-A)` `instalação do conselho fiscal a pedido de acionistas, art. 161 (art. 294-A, inciso I)` FALSE TRUE EQUALS JUST FALSE
#ASSERT `a obrigação está dispensada ou modulada na companhia (art. 294-A)` `outra obrigação da Lei (art. 294-A)` TRUE TRUE EQUALS NOTHING

-- Art. 294-B, § 2º, I: criteria for keeping the condition after access to the market.
#ASSERT `a companhia mantém a condição de companhia de menor porte (art. 294-B, § 2º, inciso I)` TRUE FALSE FALSE FALSE
#ASSERT `a companhia mantém a condição de companhia de menor porte (art. 294-B, § 2º, inciso I)` TRUE TRUE FALSE FALSE
#ASSERT `a companhia mantém a condição de companhia de menor porte (art. 294-B, § 2º, inciso I)` TRUE TRUE TRUE TRUE
#ASSERT NOT (`a companhia mantém a condição de companhia de menor porte (art. 294-B, § 2º, inciso I)` TRUE TRUE TRUE FALSE)
#ASSERT NOT (`a companhia mantém a condição de companhia de menor porte (art. 294-B, § 2º, inciso I)` FALSE FALSE FALSE FALSE)
