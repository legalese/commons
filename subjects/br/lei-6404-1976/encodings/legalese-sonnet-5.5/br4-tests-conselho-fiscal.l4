IMPORT prelude
IMPORT `br-core`
IMPORT `br4-conselho-fiscal`

-- br4-tests-conselho-fiscal.l4 -- tests of br4-conselho-fiscal.l4 (arts. 161 to 165-A).
-- Every expected value was decided from the text of the article, written beside the assertion, and then run.

§ `Perfis para os testes`

`[teste br4] perfil: companhia fechada, conselho fiscal permanente` MEANS `Perfil da companhia` WITH
    `o tipo da companhia` IS `companhia fechada`
    `a companhia tem conselho de administração` IS FALSE
    `a companhia tem conselho fiscal permanente` IS TRUE
    `a companhia tem capital autorizado` IS FALSE
    `a companhia é de economia mista` IS FALSE

`[teste br4] perfil: companhia aberta, conselho fiscal a pedido, com conselho de administração` MEANS `Perfil da companhia` WITH
    `o tipo da companhia` IS `companhia aberta`
    `a companhia tem conselho de administração` IS TRUE
    `a companhia tem conselho fiscal permanente` IS FALSE
    `a companhia tem capital autorizado` IS FALSE
    `a companhia é de economia mista` IS FALSE

`[teste br4] perfil: companhia fechada, conselho fiscal a pedido, só diretoria` MEANS `Perfil da companhia` WITH
    `o tipo da companhia` IS `companhia fechada`
    `a companhia tem conselho de administração` IS FALSE
    `a companhia tem conselho fiscal permanente` IS FALSE
    `a companhia tem capital autorizado` IS FALSE
    `a companhia é de economia mista` IS FALSE

§ `Testes do art. 161`

#ASSERT `o estatuto dispõe sobre o funcionamento como a lei exige (art. 161)` TRUE
#ASSERT NOT (`o estatuto dispõe sobre o funcionamento como a lei exige (art. 161)` FALSE)
#ASSERT `o conselho fiscal está em funcionamento no exercício social (art. 161)` `[teste br4] perfil: companhia fechada, conselho fiscal permanente` FALSE
#ASSERT `o conselho fiscal está em funcionamento no exercício social (art. 161)` `[teste br4] perfil: companhia aberta, conselho fiscal a pedido, com conselho de administração` TRUE
#ASSERT NOT (`o conselho fiscal está em funcionamento no exercício social (art. 161)` `[teste br4] perfil: companhia aberta, conselho fiscal a pedido, com conselho de administração` FALSE)
-- § 1º: 3 to 5 members, alternates in equal number, elected by the assembly.
#ASSERT `a composição do conselho fiscal atende ao número exigido (art. 161, § 1º)` 3 3 TRUE
#ASSERT `a composição do conselho fiscal atende ao número exigido (art. 161, § 1º)` 5 5 TRUE
#ASSERT `a composição do conselho fiscal atende ao número exigido (art. 161, § 1º)` 4 4 TRUE
#ASSERT NOT (`a composição do conselho fiscal atende ao número exigido (art. 161, § 1º)` 2 2 TRUE)
#ASSERT NOT (`a composição do conselho fiscal atende ao número exigido (art. 161, § 1º)` 6 6 TRUE)
#ASSERT NOT (`a composição do conselho fiscal atende ao número exigido (art. 161, § 1º)` 3 2 TRUE)
#ASSERT NOT (`a composição do conselho fiscal atende ao número exigido (art. 161, § 1º)` 3 4 TRUE)
#ASSERT NOT (`a composição do conselho fiscal atende ao número exigido (art. 161, § 1º)` 3 3 FALSE)
-- § 2º: not permanent; 10% of the voting shares (100 of 1,000) or 5% of the non-voting (50 of 1,000); nobody holding none.
#ASSERT `os acionistas podem requerer a instalação do conselho fiscal (art. 161, § 2º)` `[teste br4] perfil: companhia fechada, conselho fiscal a pedido, só diretoria` 100 1000 0 0
#ASSERT NOT (`os acionistas podem requerer a instalação do conselho fiscal (art. 161, § 2º)` `[teste br4] perfil: companhia fechada, conselho fiscal a pedido, só diretoria` 99 1000 0 1000)
#ASSERT `os acionistas podem requerer a instalação do conselho fiscal (art. 161, § 2º)` `[teste br4] perfil: companhia fechada, conselho fiscal a pedido, só diretoria` 0 1000 50 1000
#ASSERT NOT (`os acionistas podem requerer a instalação do conselho fiscal (art. 161, § 2º)` `[teste br4] perfil: companhia fechada, conselho fiscal a pedido, só diretoria` 0 1000 49 1000)
#ASSERT NOT (`os acionistas podem requerer a instalação do conselho fiscal (art. 161, § 2º)` `[teste br4] perfil: companhia fechada, conselho fiscal a pedido, só diretoria` 0 1000 0 0)
#ASSERT NOT (`os acionistas podem requerer a instalação do conselho fiscal (art. 161, § 2º)` `[teste br4] perfil: companhia fechada, conselho fiscal permanente` 500 1000 0 0)
#ASSERT `a data em que termina o período de funcionamento do conselho fiscal (art. 161, § 2º)` (YMD 2027 4 30) EQUALS YMD 2027 4 30
-- § 3º: any general meeting; a special meeting is not a general meeting.
#ASSERT `o pedido de funcionamento do conselho fiscal pode ser formulado na assembleia (art. 161, § 3º)` `assembleia-geral ordinária` FALSE EQUALS JUST TRUE
#ASSERT `o pedido de funcionamento do conselho fiscal pode ser formulado na assembleia (art. 161, § 3º)` `assembleia-geral extraordinária` FALSE EQUALS JUST TRUE
#ASSERT `o pedido de funcionamento do conselho fiscal pode ser formulado na assembleia (art. 161, § 3º)` `assembleia especial` TRUE EQUALS NOTHING
-- § 4º, a: preferred without vote; minority with 10% of the voting shares.
#ASSERT `o grupo tem direito de eleger em votação em separado um membro e respectivo suplente (art. 161, § 4º, alínea a)` TRUE FALSE 0 1000
#ASSERT `o grupo tem direito de eleger em votação em separado um membro e respectivo suplente (art. 161, § 4º, alínea a)` FALSE TRUE 100 1000
#ASSERT NOT (`o grupo tem direito de eleger em votação em separado um membro e respectivo suplente (art. 161, § 4º, alínea a)` FALSE TRUE 99 1000)
#ASSERT NOT (`o grupo tem direito de eleger em votação em separado um membro e respectivo suplente (art. 161, § 4º, alínea a)` FALSE TRUE 0 0)
#ASSERT NOT (`o grupo tem direito de eleger em votação em separado um membro e respectivo suplente (art. 161, § 4º, alínea a)` FALSE FALSE 500 1000)
-- § 4º, b: as many as elected under a, plus one (two groups: 2 + 1 = 3, for 5 in all; none: 1, below the 3 of § 1º).
#ASSERT `a quantidade de membros que os demais acionistas com direito a voto elegem (art. 161, § 4º, alínea b)` 2 EQUALS 3
#ASSERT `a quantidade de membros que os demais acionistas com direito a voto elegem (art. 161, § 4º, alínea b)` 1 EQUALS 2
#ASSERT `a quantidade de membros que os demais acionistas com direito a voto elegem (art. 161, § 4º, alínea b)` 0 EQUALS 1
#ASSERT NOT (`a composição do conselho fiscal atende ao número exigido (art. 161, § 1º)` (`a quantidade de membros que os demais acionistas com direito a voto elegem (art. 161, § 4º, alínea b)` 0) (`a quantidade de membros que os demais acionistas com direito a voto elegem (art. 161, § 4º, alínea b)` 0) TRUE)
-- §§ 5º, 6º, 7º.
#ASSERT `a data em que terminam os cargos dos membros do conselho fiscal (art. 161, §§ 5º e 6º)` (YMD 2027 4 28) EQUALS YMD 2027 4 28
#ASSERT `a reeleição dos membros do conselho fiscal é permitida (art. 161, §§ 5º e 6º)`
#ASSERT NOT (`a função de membro do conselho fiscal é delegável (art. 161, § 7º)`)

§ `Testes do art. 162`

-- caput: natural person, resident, and a degree or 3 years as administrador or conselheiro fiscal.
#ASSERT `a pessoa preenche os requisitos para ser eleita para o conselho fiscal (art. 162)` TRUE TRUE TRUE 0
#ASSERT `a pessoa preenche os requisitos para ser eleita para o conselho fiscal (art. 162)` TRUE TRUE FALSE 3
#ASSERT NOT (`a pessoa preenche os requisitos para ser eleita para o conselho fiscal (art. 162)` TRUE TRUE FALSE 2)
#ASSERT NOT (`a pessoa preenche os requisitos para ser eleita para o conselho fiscal (art. 162)` FALSE TRUE TRUE 5)
#ASSERT NOT (`a pessoa preenche os requisitos para ser eleita para o conselho fiscal (art. 162)` TRUE FALSE TRUE 5)
-- § 1º.
#ASSERT `o juiz pode dispensar a companhia da satisfação dos requisitos (art. 162, § 1º)` TRUE
#ASSERT NOT (`o juiz pode dispensar a companhia da satisfação dos requisitos (art. 162, § 1º)` FALSE)
-- § 2º: each bar; relatives up to the third degree bar, the fourth degree does not.
#ASSERT NOT (`a pessoa não pode ser eleita para o conselho fiscal (art. 162, § 2º)` FALSE FALSE FALSE FALSE NOTHING)
#ASSERT `a pessoa não pode ser eleita para o conselho fiscal (art. 162, § 2º)` TRUE FALSE FALSE FALSE NOTHING
#ASSERT `a pessoa não pode ser eleita para o conselho fiscal (art. 162, § 2º)` FALSE TRUE FALSE FALSE NOTHING
#ASSERT `a pessoa não pode ser eleita para o conselho fiscal (art. 162, § 2º)` FALSE FALSE TRUE FALSE NOTHING
#ASSERT `a pessoa não pode ser eleita para o conselho fiscal (art. 162, § 2º)` FALSE FALSE FALSE TRUE NOTHING
#ASSERT `a pessoa não pode ser eleita para o conselho fiscal (art. 162, § 2º)` FALSE FALSE FALSE FALSE (JUST 3)
#ASSERT NOT (`a pessoa não pode ser eleita para o conselho fiscal (art. 162, § 2º)` FALSE FALSE FALSE FALSE (JUST 4))
-- caput and § 2º together; the judge's release covers the requirements only, never the bars.
#ASSERT `a pessoa pode ser eleita para o conselho fiscal (art. 162)` TRUE FALSE FALSE
#ASSERT `a pessoa pode ser eleita para o conselho fiscal (art. 162)` FALSE TRUE FALSE
#ASSERT NOT (`a pessoa pode ser eleita para o conselho fiscal (art. 162)` FALSE FALSE FALSE)
#ASSERT NOT (`a pessoa pode ser eleita para o conselho fiscal (art. 162)` TRUE FALSE TRUE)
#ASSERT NOT (`a pessoa pode ser eleita para o conselho fiscal (art. 162)` FALSE TRUE TRUE)
-- § 3º: ten per cent of the average of a diretor (average 20,000: minimum 2,000).
#ASSERT `quem fixa a remuneração dos membros do conselho fiscal (art. 162, § 3º)` EQUALS `a assembleia-geral`
#ASSERT `a remuneração mínima de cada membro em exercício, em reais (art. 162, § 3º)` 20000 EQUALS 2000
#ASSERT `a remuneração fixada respeita o mínimo (art. 162, § 3º)` 2000 20000
#ASSERT `a remuneração fixada respeita o mínimo (art. 162, § 3º)` 5000 20000
#ASSERT NOT (`a remuneração fixada respeita o mínimo (art. 162, § 3º)` 1999 20000)
#ASSERT `a despesa deve ser reembolsada ao membro (art. 162, § 3º)` TRUE
#ASSERT NOT (`a despesa deve ser reembolsada ao membro (art. 162, § 3º)` FALSE)

§ `Testes do art. 163`

-- caput: attributions, when the council works; the liquidation one only in liquidation.
#ASSERT `a atribuição compete ao conselho fiscal (art. 163)` `fiscalizar os atos dos administradores e verificar o cumprimento dos seus deveres legais e estatutários (art. 163, inciso I)` TRUE FALSE
#ASSERT `a atribuição compete ao conselho fiscal (art. 163)` `examinar as demonstrações financeiras do exercício social e sobre elas opinar (art. 163, inciso VII)` TRUE FALSE
#ASSERT NOT (`a atribuição compete ao conselho fiscal (art. 163)` `fiscalizar os atos dos administradores e verificar o cumprimento dos seus deveres legais e estatutários (art. 163, inciso I)` FALSE FALSE)
#ASSERT NOT (`a atribuição compete ao conselho fiscal (art. 163)` `exercer essas atribuições durante a liquidação (art. 163, inciso VIII)` TRUE FALSE)
#ASSERT `a atribuição compete ao conselho fiscal (art. 163)` `exercer essas atribuições durante a liquidação (art. 163, inciso VIII)` TRUE TRUE
-- I and IV by any member; the others: the text is silent.
#ASSERT `a atribuição pode ser exercida por qualquer membro isoladamente (art. 163)` `fiscalizar os atos dos administradores e verificar o cumprimento dos seus deveres legais e estatutários (art. 163, inciso I)` EQUALS JUST TRUE
#ASSERT `a atribuição pode ser exercida por qualquer membro isoladamente (art. 163)` `denunciar os erros, fraudes ou crimes que descobrir e sugerir providências (art. 163, inciso IV)` EQUALS JUST TRUE
#ASSERT `a atribuição pode ser exercida por qualquer membro isoladamente (art. 163)` `opinar sobre o relatório anual da administração (art. 163, inciso II)` EQUALS NOTHING
-- III: the eight kinds of proposal.
#ASSERT `as propostas sobre as quais o conselho fiscal opina (art. 163, inciso III)` EQUALS LIST `modificação do capital social (art. 163, inciso III)`, `emissão de debêntures ou bônus de subscrição (art. 163, inciso III)`, `planos de investimento ou orçamentos de capital (art. 163, inciso III)`, `distribuição de dividendos (art. 163, inciso III)`, `transformação (art. 163, inciso III)`, `incorporação (art. 163, inciso III)`, `fusão (art. 163, inciso III)`, `cisão (art. 163, inciso III)`
-- V: ordinary meeting, call due on 30 April 2026: one month later is 30 May, so 31 May is a delay of more than a month.
#ASSERT `o conselho fiscal pode convocar a assembleia-geral (art. 163, inciso V)` `assembleia-geral ordinária` (YMD 2026 4 30) (YMD 2026 5 31) FALSE FALSE EQUALS JUST TRUE
#ASSERT `o conselho fiscal pode convocar a assembleia-geral (art. 163, inciso V)` `assembleia-geral ordinária` (YMD 2026 4 30) (YMD 2026 5 30) FALSE FALSE EQUALS JUST FALSE
#ASSERT `o conselho fiscal pode convocar a assembleia-geral (art. 163, inciso V)` `assembleia-geral ordinária` (YMD 2026 4 30) (YMD 2026 6 15) TRUE FALSE EQUALS JUST FALSE
#ASSERT `o conselho fiscal pode convocar a assembleia-geral (art. 163, inciso V)` `assembleia-geral ordinária` (YMD 2026 4 30) (YMD 2026 4 15) FALSE FALSE EQUALS JUST FALSE
#ASSERT `o conselho fiscal pode convocar a assembleia-geral (art. 163, inciso V)` `assembleia-geral extraordinária` (YMD 2026 4 30) (YMD 2026 5 1) FALSE TRUE EQUALS JUST TRUE
#ASSERT `o conselho fiscal pode convocar a assembleia-geral (art. 163, inciso V)` `assembleia-geral extraordinária` (YMD 2026 4 30) (YMD 2026 5 1) FALSE FALSE EQUALS JUST FALSE
#ASSERT `o conselho fiscal pode convocar a assembleia-geral (art. 163, inciso V)` `assembleia especial` (YMD 2026 4 30) (YMD 2026 9 1) FALSE TRUE EQUALS NOTHING
-- VI: at least every quarter.
#ASSERT `o conselho fiscal analisou o balancete no intervalo exigido (art. 163, inciso VI)` 3
#ASSERT `o conselho fiscal analisou o balancete no intervalo exigido (art. 163, inciso VI)` 1
#ASSERT NOT (`o conselho fiscal analisou o balancete no intervalo exigido (art. 163, inciso VI)` 4)
-- § 1º: minutes within 10 days of the meeting, balancetes within 15 days of receipt, by writing.
#ASSERT `as cópias das atas foram postas à disposição no prazo (art. 163, § 1º)` (YMD 2026 3 1) (YMD 2026 3 11) TRUE
#ASSERT NOT (`as cópias das atas foram postas à disposição no prazo (art. 163, § 1º)` (YMD 2026 3 1) (YMD 2026 3 12) TRUE)
#ASSERT NOT (`as cópias das atas foram postas à disposição no prazo (art. 163, § 1º)` (YMD 2026 3 1) (YMD 2026 3 5) FALSE)
#ASSERT `as cópias dos balancetes foram postas à disposição no prazo (art. 163, § 1º)` (YMD 2026 3 1) (YMD 2026 3 16) TRUE
#ASSERT NOT (`as cópias dos balancetes foram postas à disposição no prazo (art. 163, § 1º)` (YMD 2026 3 1) (YMD 2026 3 17) TRUE)
#ASSERT NOT (`as cópias dos balancetes foram postas à disposição no prazo (art. 163, § 1º)` (YMD 2026 3 1) (YMD 2026 3 10) FALSE)
-- § 2º, § 4º, § 5º.
#ASSERT `o conselho fiscal solicita aos órgãos de administração esclarecimentos ou demonstrações especiais (art. 163, § 2º)` TRUE TRUE
#ASSERT NOT (`o conselho fiscal solicita aos órgãos de administração esclarecimentos ou demonstrações especiais (art. 163, § 2º)` TRUE FALSE)
#ASSERT NOT (`o conselho fiscal solicita aos órgãos de administração esclarecimentos ou demonstrações especiais (art. 163, § 2º)` FALSE TRUE)
#ASSERT `o conselho fiscal pode solicitar esclarecimentos aos auditores independentes (art. 163, § 4º)` TRUE TRUE
#ASSERT NOT (`o conselho fiscal pode solicitar esclarecimentos aos auditores independentes (art. 163, § 4º)` FALSE TRUE)
#ASSERT NOT (`o conselho fiscal pode solicitar esclarecimentos aos auditores independentes (art. 163, § 4º)` TRUE FALSE)
#ASSERT `o conselho fiscal pode escolher contador ou firma de auditoria (art. 163, § 5º)` FALSE
#ASSERT NOT (`o conselho fiscal pode escolher contador ou firma de auditoria (art. 163, § 5º)` TRUE)
#ASSERT `os honorários fixados pelo conselho fiscal são admissíveis (art. 163, § 5º)` TRUE
#ASSERT NOT (`os honorários fixados pelo conselho fiscal são admissíveis (art. 163, § 5º)` FALSE)
-- § 3º: the board's meeting if there is a board, else the diretoria's.
#ASSERT `os membros do conselho fiscal assistirão à reunião (art. 163, § 3º)` `[teste br4] perfil: companhia aberta, conselho fiscal a pedido, com conselho de administração` TRUE FALSE TRUE
#ASSERT NOT (`os membros do conselho fiscal assistirão à reunião (art. 163, § 3º)` `[teste br4] perfil: companhia aberta, conselho fiscal a pedido, com conselho de administração` FALSE TRUE TRUE)
#ASSERT `os membros do conselho fiscal assistirão à reunião (art. 163, § 3º)` `[teste br4] perfil: companhia fechada, conselho fiscal a pedido, só diretoria` FALSE TRUE TRUE
#ASSERT NOT (`os membros do conselho fiscal assistirão à reunião (art. 163, § 3º)` `[teste br4] perfil: companhia fechada, conselho fiscal a pedido, só diretoria` TRUE FALSE TRUE)
#ASSERT NOT (`os membros do conselho fiscal assistirão à reunião (art. 163, § 3º)` `[teste br4] perfil: companhia aberta, conselho fiscal a pedido, com conselho de administração` TRUE FALSE FALSE)
-- § 6º: 5% of the capital.
#ASSERT `o conselho fiscal deve fornecer as informações pedidas (art. 163, § 6º)` 5000 100000
#ASSERT NOT (`o conselho fiscal deve fornecer as informações pedidas (art. 163, § 6º)` 4999 100000)
-- § 7º: not to another organ.
#ASSERT NOT (`as atribuições e poderes do conselho fiscal podem ser outorgados a outro órgão (art. 163, § 7º)`)
-- § 8º: three experts within 30 days of the request.
#ASSERT `a diretoria atendeu ao pedido de indicação de peritos (art. 163, § 8º)` (YMD 2026 3 1) (YMD 2026 3 31) 3
#ASSERT NOT (`a diretoria atendeu ao pedido de indicação de peritos (art. 163, § 8º)` (YMD 2026 3 1) (YMD 2026 4 1) 3)
#ASSERT NOT (`a diretoria atendeu ao pedido de indicação de peritos (art. 163, § 8º)` (YMD 2026 3 1) (YMD 2026 3 10) 2)
#ASSERT NOT (`a diretoria atendeu ao pedido de indicação de peritos (art. 163, § 8º)` (YMD 2026 3 1) (YMD 2026 3 10) 4)
#ASSERT `quem paga os honorários do perito escolhido (art. 163, § 8º)` EQUALS `a companhia`

§ `Testes dos arts. 164, 165 e 165-A`

#ASSERT `o conselho fiscal cumpriu o dever de comparecer à assembleia-geral (art. 164)` 1
#ASSERT `o conselho fiscal cumpriu o dever de comparecer à assembleia-geral (art. 164)` 3
#ASSERT NOT (`o conselho fiscal cumpriu o dever de comparecer à assembleia-geral (art. 164)` 0)
