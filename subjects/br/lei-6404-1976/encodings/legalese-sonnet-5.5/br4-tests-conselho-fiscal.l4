#ASSERT NOT (`o parecer ou a representação pode ser apresentado e lido na assembleia-geral (art. 164, parágrafo único)` FALSE)
-- art. 165: same duties as the administradores of arts. 153 to 156; for anyone else, nothing.
#ASSERT `os deveres dos arts. 153 a 156 se aplicam à pessoa (art. 165)` `o membro do conselho fiscal` EQUALS JUST TRUE
#ASSERT `os deveres dos arts. 153 a 156 se aplicam à pessoa (art. 165)` `o administrador` EQUALS JUST TRUE
#ASSERT `os deveres dos arts. 153 a 156 se aplicam à pessoa (art. 165)` `o acionista` EQUALS NOTHING
#ASSERT `o membro do conselho fiscal responde pelos danos resultantes (art. 165)` TRUE FALSE FALSE FALSE
#ASSERT `o membro do conselho fiscal responde pelos danos resultantes (art. 165)` FALSE TRUE FALSE FALSE
#ASSERT `o membro do conselho fiscal responde pelos danos resultantes (art. 165)` FALSE FALSE TRUE FALSE
#ASSERT `o membro do conselho fiscal responde pelos danos resultantes (art. 165)` FALSE FALSE FALSE TRUE
#ASSERT NOT (`o membro do conselho fiscal responde pelos danos resultantes (art. 165)` FALSE FALSE FALSE FALSE)
-- § 1º: abuse is the aim to harm, or an advantage not due from which harm results or may result.
#ASSERT `o exercício da função é abusivo (art. 165, § 1º)` TRUE FALSE FALSE
#ASSERT `o exercício da função é abusivo (art. 165, § 1º)` FALSE TRUE TRUE
#ASSERT NOT (`o exercício da função é abusivo (art. 165, § 1º)` FALSE TRUE FALSE)
#ASSERT NOT (`o exercício da função é abusivo (art. 165, § 1º)` FALSE FALSE TRUE)
-- § 2º, § 3º.
#ASSERT `o membro responde pelo ato ilícito de outro membro (art. 165, § 2º)` TRUE FALSE
#ASSERT `o membro responde pelo ato ilícito de outro membro (art. 165, § 2º)` FALSE TRUE
#ASSERT NOT (`o membro responde pelo ato ilícito de outro membro (art. 165, § 2º)` FALSE FALSE)
#ASSERT `o membro dissidente está exonerado da responsabilidade por omissão (art. 165, § 3º)` TRUE TRUE TRUE
#ASSERT NOT (`o membro dissidente está exonerado da responsabilidade por omissão (art. 165, § 3º)` TRUE TRUE FALSE)
#ASSERT NOT (`o membro dissidente está exonerado da responsabilidade por omissão (art. 165, § 3º)` TRUE FALSE TRUE)
#ASSERT NOT (`o membro dissidente está exonerado da responsabilidade por omissão (art. 165, § 3º)` FALSE TRUE TRUE)
#ASSERT `o membro responde solidariamente pela omissão (art. 165, § 3º)` TRUE FALSE
#ASSERT NOT (`o membro responde solidariamente pela omissão (art. 165, § 3º)` TRUE TRUE)
#ASSERT NOT (`o membro responde solidariamente pela omissão (art. 165, § 3º)` FALSE FALSE)
-- art. 165-A.
#ASSERT `o membro do conselho fiscal deve informar a CVM e as bolsas (art. 165-A)` `companhia aberta` TRUE
#ASSERT NOT (`o membro do conselho fiscal deve informar a CVM e as bolsas (art. 165-A)` `companhia aberta` FALSE)
#ASSERT NOT (`o membro do conselho fiscal deve informar a CVM e as bolsas (art. 165-A)` `companhia fechada` TRUE)

