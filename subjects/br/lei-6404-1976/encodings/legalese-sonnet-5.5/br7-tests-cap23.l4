IMPORT prelude
IMPORT daydate
IMPORT `br-core`
IMPORT `br7-cap23-comandita-por-acoes`

-- br7-tests-cap23.l4 -- tests of br7-cap23-comandita-por-acoes.l4 (arts. 280 to 284).
-- Every expected value was decided from the text before the run and is written beside its assertion. A failing assertion is a
-- finding, never a reason to edit the expected value.

§ `Testes: arts. 280 e 284`

-- Art. 284: the four matters do not apply to the comandita por ações, whether or not the Chapter changes them (it does not matter).
#ASSERT `a norma da Lei sobre a matéria se aplica à sociedade em comandita por ações (arts. 280 e 284)` `voto plural (art. 284)` FALSE EQUALS JUST FALSE
#ASSERT `a norma da Lei sobre a matéria se aplica à sociedade em comandita por ações (arts. 280 e 284)` `voto plural (art. 284)` TRUE EQUALS JUST FALSE
#ASSERT `a norma da Lei sobre a matéria se aplica à sociedade em comandita por ações (arts. 280 e 284)` `conselho de administração (art. 284)` FALSE EQUALS JUST FALSE
#ASSERT `a norma da Lei sobre a matéria se aplica à sociedade em comandita por ações (arts. 280 e 284)` `autorização estatutária de aumento de capital (art. 284)` FALSE EQUALS JUST FALSE
#ASSERT `a norma da Lei sobre a matéria se aplica à sociedade em comandita por ações (arts. 280 e 284)` `emissão de bônus de subscrição (art. 284)` FALSE EQUALS JUST FALSE
-- Art. 280: any other matter follows the Law on companhias, unless this Chapter changes it; where it does, the answer is in
-- that article and here there is none.
#ASSERT `a norma da Lei sobre a matéria se aplica à sociedade em comandita por ações (arts. 280 e 284)` `outra matéria da Lei (art. 280)` FALSE EQUALS JUST TRUE
#ASSERT `a norma da Lei sobre a matéria se aplica à sociedade em comandita por ações (arts. 280 e 284)` `outra matéria da Lei (art. 280)` TRUE EQUALS NOTHING

§ `Testes: arts. 281 a 283`

-- Art. 281, caput and parágrafo único.
#ASSERT `a firma ou razão social atende o art. 281 (art. 281)` TRUE
#ASSERT NOT (`a firma ou razão social atende o art. 281 (art. 281)` FALSE)
#ASSERT `a denominação ou firma atende o parágrafo único do art. 281 (art. 281, parágrafo único)` TRUE
#ASSERT NOT (`a denominação ou firma atende o parágrafo único do art. 281 (art. 281, parágrafo único)` FALSE)

-- Art. 282, caput: only a partner or shareholder.
#ASSERT `a pessoa pode administrar ou gerir a sociedade (art. 282)` TRUE
#ASSERT NOT (`a pessoa pode administrar ou gerir a sociedade (art. 282)` FALSE)

-- Arts. 281 and 282: the liability. The three fields are: unlimited, joint, subsidiary to the company's.
`responsabilidade do diretor ou gerente (teste art. 282)` MEANS
    `Responsabilidade pelas obrigações sociais (arts. 281 e 282)` WITH
        `é ilimitada` IS TRUE
        `é solidária` IS TRUE
        `é subsidiária à da sociedade` IS JUST TRUE

`responsabilidade de quem só figura na firma (teste art. 281)` MEANS
    `Responsabilidade pelas obrigações sociais (arts. 281 e 282)` WITH
        `é ilimitada` IS TRUE
        `é solidária` IS TRUE
        `é subsidiária à da sociedade` IS NOTHING

-- Ruler: the person is a director or manager, the person's name is in the firm.
#ASSERT `a responsabilidade da pessoa pelas obrigações sociais (arts. 281 e 282)` TRUE FALSE EQUALS JUST `responsabilidade do diretor ou gerente (teste art. 282)`
-- A director whose name is also in the firm: both articles together, unlimited, joint and subsidiary.
#ASSERT `a responsabilidade da pessoa pelas obrigações sociais (arts. 281 e 282)` TRUE TRUE EQUALS JUST `responsabilidade do diretor ou gerente (teste art. 282)`
-- Named in the firm without being a director: unlimited and joint; whether subsidiary the text does not say.
#ASSERT `a responsabilidade da pessoa pelas obrigações sociais (arts. 281 e 282)` FALSE TRUE EQUALS JUST `responsabilidade de quem só figura na firma (teste art. 281)`
-- Neither: the Chapter makes no liability.
#ASSERT `a responsabilidade da pessoa pelas obrigações sociais (arts. 281 e 282)` FALSE FALSE EQUALS NOTHING

-- Art. 282, § 1º, appointment; ruler: made in the estatuto, limited in time.
#ASSERT `a nomeação do diretor ou gerente atende o art. 282, § 1º (art. 282, § 1º)` TRUE FALSE
#ASSERT NOT (`a nomeação do diretor ou gerente atende o art. 282, § 1º (art. 282, § 1º)` TRUE TRUE)
#ASSERT NOT (`a nomeação do diretor ou gerente atende o art. 282, § 1º (art. 282, § 1º)` FALSE FALSE)
-- Removal: only by shareholders who represent at least 2/3 of the capital. Capital 3.000.000: 2.000.000 is exactly 2/3.
#ASSERT `o diretor ou gerente pode ser destituído (art. 282, § 1º)` 3_000_000 2_000_000
#ASSERT NOT (`o diretor ou gerente pode ser destituído (art. 282, § 1º)` 3_000_000 1_999_999)
#ASSERT `o diretor ou gerente pode ser destituído (art. 282, § 1º)` 3_000_000 3_000_000
-- Capital 300: 2/3 is 200; 199 is not enough.
#ASSERT `o diretor ou gerente pode ser destituído (art. 282, § 1º)` 300 200
#ASSERT NOT (`o diretor ou gerente pode ser destituído (art. 282, § 1º)` 300 199)
-- No capital at all: nobody represents 2/3 of it.
#ASSERT NOT (`o diretor ou gerente pode ser destituído (art. 282, § 1º)` 0 0)

-- Art. 282, § 2º; ruler: removed, resigned, the obligation was contracted under his administration.
#ASSERT `o diretor ou gerente que saiu continua responsável pela obrigação social (art. 282, § 2º)` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `o diretor ou gerente que saiu continua responsável pela obrigação social (art. 282, § 2º)` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o diretor ou gerente que saiu continua responsável pela obrigação social (art. 282, § 2º)` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `o diretor ou gerente que saiu continua responsável pela obrigação social (art. 282, § 2º)` FALSE TRUE FALSE EQUALS JUST FALSE
-- Still in office: the paragraph says nothing.
#ASSERT `o diretor ou gerente que saiu continua responsável pela obrigação social (art. 282, § 2º)` FALSE FALSE TRUE EQUALS NOTHING

-- Art. 283: the seven deliberations need the consent of the directors or managers.
#ASSERT `a assembleia-geral pode tomar a deliberação (art. 283)` `mudar o objeto essencial da sociedade (art. 283)` TRUE EQUALS JUST TRUE
#ASSERT `a assembleia-geral pode tomar a deliberação (art. 283)` `mudar o objeto essencial da sociedade (art. 283)` FALSE EQUALS JUST FALSE
#ASSERT `a assembleia-geral pode tomar a deliberação (art. 283)` `prorrogar o prazo de duração da sociedade (art. 283)` TRUE EQUALS JUST TRUE
#ASSERT `a assembleia-geral pode tomar a deliberação (art. 283)` `prorrogar o prazo de duração da sociedade (art. 283)` FALSE EQUALS JUST FALSE
#ASSERT `a assembleia-geral pode tomar a deliberação (art. 283)` `aumentar o capital social (art. 283)` TRUE EQUALS JUST TRUE
#ASSERT `a assembleia-geral pode tomar a deliberação (art. 283)` `aumentar o capital social (art. 283)` FALSE EQUALS JUST FALSE
#ASSERT `a assembleia-geral pode tomar a deliberação (art. 283)` `diminuir o capital social (art. 283)` TRUE EQUALS JUST TRUE
#ASSERT `a assembleia-geral pode tomar a deliberação (art. 283)` `diminuir o capital social (art. 283)` FALSE EQUALS JUST FALSE
#ASSERT `a assembleia-geral pode tomar a deliberação (art. 283)` `emitir debêntures (art. 283)` TRUE EQUALS JUST TRUE
#ASSERT `a assembleia-geral pode tomar a deliberação (art. 283)` `emitir debêntures (art. 283)` FALSE EQUALS JUST FALSE
#ASSERT `a assembleia-geral pode tomar a deliberação (art. 283)` `criar partes beneficiárias (art. 283)` TRUE EQUALS JUST TRUE
#ASSERT `a assembleia-geral pode tomar a deliberação (art. 283)` `criar partes beneficiárias (art. 283)` FALSE EQUALS JUST FALSE
#ASSERT `a assembleia-geral pode tomar a deliberação (art. 283)` `aprovar a participação em grupo de sociedade (art. 283)` TRUE EQUALS JUST TRUE
#ASSERT `a assembleia-geral pode tomar a deliberação (art. 283)` `aprovar a participação em grupo de sociedade (art. 283)` FALSE EQUALS JUST FALSE
-- Any other deliberation: the article says nothing.
#ASSERT `a assembleia-geral pode tomar a deliberação (art. 283)` `outra deliberação (art. 283)` TRUE EQUALS NOTHING
#ASSERT `a assembleia-geral pode tomar a deliberação (art. 283)` `outra deliberação (art. 283)` FALSE EQUALS NOTHING
