#ASSERT NOT (`os certificados podem ser substituídos, desdobrados ou grupados (art. 65, § 2º)` TRUE FALSE)
#ASSERT NOT (`os certificados podem ser substituídos, desdobrados ou grupados (art. 65, § 2º)` FALSE TRUE)
