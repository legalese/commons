IMPORT prelude
IMPORT `br-core`
IMPORT `br4-diretoria`

-- br4-tests-diretoria.l4 -- tests of br4-diretoria.l4 (arts. 143 and 144).
-- Every expected value was decided from the text of the article, written beside the assertion, and then run.

§ `Testes dos arts. 143 e 144`

`[teste br4] estatuto da diretoria: tudo em ordem` MEANS `Estatuto quanto à diretoria (art. 143)` WITH
    `o estatuto fixa o número de diretores, ou o máximo e o mínimo permitidos` IS TRUE
    `o estatuto estabelece o modo de substituição dos diretores` IS TRUE
    `a quantidade de anos do prazo de gestão dos diretores fixado no estatuto` IS 3
    `o estatuto veda a reeleição dos diretores` IS FALSE
    `o estatuto estabelece as atribuições e poderes de cada diretor` IS TRUE

`[teste br4] estatuto da diretoria: prazo de 4 anos, sem modo de substituição` MEANS `Estatuto quanto à diretoria (art. 143)` WITH
    `o estatuto fixa o número de diretores, ou o máximo e o mínimo permitidos` IS FALSE
    `o estatuto estabelece o modo de substituição dos diretores` IS FALSE
    `a quantidade de anos do prazo de gestão dos diretores fixado no estatuto` IS 4
    `o estatuto veda a reeleição dos diretores` IS TRUE
    `o estatuto estabelece as atribuições e poderes de cada diretor` IS FALSE

-- caput: the board elects and dismisses the directors; without a board, the assembly does.
#ASSERT `quem elege e destitui os diretores (art. 143)` TRUE EQUALS `o conselho de administração`
#ASSERT `quem elege e destitui os diretores (art. 143)` FALSE EQUALS `a assembleia-geral`
-- caput: one or more members (the live text; the struck text said two or more).
#ASSERT `a diretoria tem o número mínimo de membros (art. 143)` 1
#ASSERT `a diretoria tem o número mínimo de membros (art. 143)` 5
#ASSERT NOT (`a diretoria tem o número mínimo de membros (art. 143)` 0)
-- incisos I to IV and all together.
#ASSERT `o estatuto cumpre o inciso I (art. 143, inciso I)` `[teste br4] estatuto da diretoria: tudo em ordem`
#ASSERT NOT (`o estatuto cumpre o inciso I (art. 143, inciso I)` `[teste br4] estatuto da diretoria: prazo de 4 anos, sem modo de substituição`)
#ASSERT `o estatuto cumpre o inciso II (art. 143, inciso II)` `[teste br4] estatuto da diretoria: tudo em ordem`
#ASSERT NOT (`o estatuto cumpre o inciso II (art. 143, inciso II)` `[teste br4] estatuto da diretoria: prazo de 4 anos, sem modo de substituição`)
#ASSERT `o estatuto cumpre o inciso III (art. 143, inciso III)` `[teste br4] estatuto da diretoria: tudo em ordem`
#ASSERT NOT (`o estatuto cumpre o inciso III (art. 143, inciso III)` `[teste br4] estatuto da diretoria: prazo de 4 anos, sem modo de substituição`)
#ASSERT `o estatuto cumpre o inciso IV (art. 143, inciso IV)` `[teste br4] estatuto da diretoria: tudo em ordem`
#ASSERT NOT (`o estatuto cumpre o inciso IV (art. 143, inciso IV)` `[teste br4] estatuto da diretoria: prazo de 4 anos, sem modo de substituição`)
#ASSERT `o estatuto dispõe sobre a diretoria como a lei exige (art. 143)` `[teste br4] estatuto da diretoria: tudo em ordem`
#ASSERT NOT (`o estatuto dispõe sobre a diretoria como a lei exige (art. 143)` `[teste br4] estatuto da diretoria: prazo de 4 anos, sem modo de substituição`)
-- § 1º: up to one third of the board (2 of 6 is a third and is allowed; 3 of 6 is not; 1 of 3 is allowed; 2 of 3 is not).
#ASSERT `os conselheiros podem ser eleitos para cargos de diretores (art. 143, § 1º)` 2 6
#ASSERT `os conselheiros podem ser eleitos para cargos de diretores (art. 143, § 1º)` 1 3
#ASSERT `os conselheiros podem ser eleitos para cargos de diretores (art. 143, § 1º)` 0 5
#ASSERT NOT (`os conselheiros podem ser eleitos para cargos de diretores (art. 143, § 1º)` 3 6)
#ASSERT NOT (`os conselheiros podem ser eleitos para cargos de diretores (art. 143, § 1º)` 2 3)
-- § 2º: decisions of the directors may be taken in a meeting if the estatuto says so.
#ASSERT `a decisão deve ser tomada em reunião da diretoria (art. 143, § 2º)` TRUE TRUE
#ASSERT NOT (`a decisão deve ser tomada em reunião da diretoria (art. 143, § 2º)` TRUE FALSE)
#ASSERT NOT (`a decisão deve ser tomada em reunião da diretoria (art. 143, § 2º)` FALSE TRUE)
-- art. 144, caput: silent estatuto and no deliberation of the board.
#ASSERT `qualquer diretor pode representar a companhia e praticar os atos de funcionamento regular (art. 144)` TRUE FALSE
#ASSERT NOT (`qualquer diretor pode representar a companhia e praticar os atos de funcionamento regular (art. 144)` TRUE TRUE)
#ASSERT NOT (`qualquer diretor pode representar a companhia e praticar os atos de funcionamento regular (art. 144)` FALSE FALSE)
-- art. 144, parágrafo único: acts and duration specified, within limits; a judicial mandate may have no duration.
#ASSERT `o mandato constituído pelos diretores é válido (art. 144, parágrafo único)` TRUE TRUE TRUE FALSE
#ASSERT `o mandato constituído pelos diretores é válido (art. 144, parágrafo único)` TRUE TRUE FALSE TRUE
#ASSERT NOT (`o mandato constituído pelos diretores é válido (art. 144, parágrafo único)` TRUE TRUE FALSE FALSE)
#ASSERT NOT (`o mandato constituído pelos diretores é válido (art. 144, parágrafo único)` TRUE FALSE TRUE FALSE)
#ASSERT NOT (`o mandato constituído pelos diretores é válido (art. 144, parágrafo único)` FALSE TRUE TRUE FALSE)

