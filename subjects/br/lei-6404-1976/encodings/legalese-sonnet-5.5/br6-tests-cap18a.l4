IMPORT prelude
IMPORT `br-core`
IMPORT `br6-cap18a-transformacao`

-- br6-tests-cap18a.l4 -- tests of br6-cap18a-transformacao.l4 (Arts. 220 to 222).
-- Expected values come from the text of lei-6404-1976.pt.txt (a converter's plain-text rendering, not the official text), never from the output of the code.



-- Art. 220: o conceito e o parágrafo único.
#ASSERT `a operação é transformação (art. 220)` TRUE TRUE
#ASSERT (NOT `a operação é transformação (art. 220)` TRUE FALSE)
#ASSERT (NOT `a operação é transformação (art. 220)` FALSE TRUE)
#ASSERT `a transformação obedeceu aos preceitos do tipo adotado (art. 220, parágrafo único)` TRUE
#ASSERT (NOT `a transformação obedeceu aos preceitos do tipo adotado (art. 220, parágrafo único)` FALSE)

-- Art. 221: consentimento unânime, salvo se prevista no estatuto ou no contrato social; o dissidente pode retirar-se; renúncia no contrato social (transformação em companhia).
#ASSERT `a transformação exige o consentimento unânime dos sócios ou acionistas (art. 221)` FALSE
#ASSERT (NOT `a transformação exige o consentimento unânime dos sócios ou acionistas (art. 221)` TRUE)
#ASSERT `o direito de retirada foi renunciado no contrato social (art. 221, parágrafo único)` TRUE TRUE
#ASSERT (NOT `o direito de retirada foi renunciado no contrato social (art. 221, parágrafo único)` TRUE FALSE)
#ASSERT (NOT `o direito de retirada foi renunciado no contrato social (art. 221, parágrafo único)` FALSE TRUE)
#ASSERT `o sócio dissidente tem o direito de retirar-se da sociedade (art. 221)` TRUE TRUE FALSE FALSE
#ASSERT `o sócio dissidente tem o direito de retirar-se da sociedade (art. 221)` TRUE TRUE TRUE FALSE
#ASSERT (NOT `o sócio dissidente tem o direito de retirar-se da sociedade (art. 221)` TRUE TRUE TRUE TRUE)
#ASSERT `o sócio dissidente tem o direito de retirar-se da sociedade (art. 221)` TRUE TRUE FALSE TRUE
#ASSERT (NOT `o sócio dissidente tem o direito de retirar-se da sociedade (art. 221)` FALSE TRUE FALSE FALSE)
#ASSERT (NOT `o sócio dissidente tem o direito de retirar-se da sociedade (art. 221)` TRUE FALSE FALSE FALSE)

-- Art. 222: direitos dos credores; falência da sociedade transformada.
#ASSERT `o credor mantém as mesmas garantias que o tipo anterior de sociedade lhe oferecia (art. 222)` FALSE
#ASSERT (NOT `o credor mantém as mesmas garantias que o tipo anterior de sociedade lhe oferecia (art. 222)` TRUE)
#ASSERT `a falência da sociedade transformada produz efeitos em relação ao sócio (art. 222, parágrafo único)` TRUE TRUE
#ASSERT (NOT `a falência da sociedade transformada produz efeitos em relação ao sócio (art. 222, parágrafo único)` TRUE FALSE)
#ASSERT (NOT `a falência da sociedade transformada produz efeitos em relação ao sócio (art. 222, parágrafo único)` FALSE TRUE)
#ASSERT `o credor se beneficia dos efeitos da falência sobre o sócio (art. 222, parágrafo único)` TRUE
#ASSERT (NOT `o credor se beneficia dos efeitos da falência sobre o sócio (art. 222, parágrafo único)` FALSE)
