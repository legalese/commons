IMPORT prelude
IMPORT `br-core`
IMPORT `br5-vocabulario`
IMPORT `br5-demonstracoes`

-- br5-tests-demonstracoes.l4 -- tests of br5-demonstracoes.l4 (Arts. 176 and 177).
-- Every expected value was worked out by hand from the text. Amounts are in reais.

§ `Testes do Art. 176: demonstrações exigidas`

-- The balance sheet and the statements of accumulated profits and of the result are required of every company.
#ASSERT `a demonstração financeira é exigida da companhia (art. 176)` `balanço patrimonial (art. 176, inciso I)` `companhia fechada` 100
#ASSERT `a demonstração financeira é exigida da companhia (art. 176)` `demonstração dos lucros ou prejuízos acumulados (art. 176, inciso II)` `companhia aberta` 0
#ASSERT `a demonstração financeira é exigida da companhia (art. 176)` `demonstração do resultado do exercício (art. 176, inciso III)` `companhia fechada` 0
-- Cash flow: a closed company with equity below 2,000,000 is free of it; at 2,000,000 exactly it is not; above, not.
#ASSERT NOT (`a demonstração financeira é exigida da companhia (art. 176)` `demonstração dos fluxos de caixa (art. 176, inciso IV)` `companhia fechada` 1_999_999)
#ASSERT `a demonstração financeira é exigida da companhia (art. 176)` `demonstração dos fluxos de caixa (art. 176, inciso IV)` `companhia fechada` 2_000_000
#ASSERT `a demonstração financeira é exigida da companhia (art. 176)` `demonstração dos fluxos de caixa (art. 176, inciso IV)` `companhia fechada` 5_000_000
-- An open company always owes the cash-flow statement, however small its equity.
#ASSERT `a demonstração financeira é exigida da companhia (art. 176)` `demonstração dos fluxos de caixa (art. 176, inciso IV)` `companhia aberta` 100
-- Value added: only the open company.
#ASSERT `a demonstração financeira é exigida da companhia (art. 176)` `demonstração do valor adicionado (art. 176, inciso V)` `companhia aberta` 100
#ASSERT NOT (`a demonstração financeira é exigida da companhia (art. 176)` `demonstração do valor adicionado (art. 176, inciso V)` `companhia fechada` 9_000_000)

-- The statements actually prepared. Each name says which are missing.
`todas as demonstrações elaboradas (art. 176)` MEANS `Demonstrações elaboradas (art. 176)` WITH
    `o balanço patrimonial foi elaborado` IS TRUE
    `a demonstração dos lucros ou prejuízos acumulados foi elaborada` IS TRUE
    `a demonstração do resultado do exercício foi elaborada` IS TRUE
    `a demonstração dos fluxos de caixa foi elaborada` IS TRUE
    `a demonstração do valor adicionado foi elaborada` IS TRUE

`demonstrações elaboradas sem fluxos de caixa nem valor adicionado (art. 176)` MEANS `Demonstrações elaboradas (art. 176)` WITH
    `o balanço patrimonial foi elaborado` IS TRUE
    `a demonstração dos lucros ou prejuízos acumulados foi elaborada` IS TRUE
    `a demonstração do resultado do exercício foi elaborada` IS TRUE
    `a demonstração dos fluxos de caixa foi elaborada` IS FALSE
    `a demonstração do valor adicionado foi elaborada` IS FALSE

`demonstrações elaboradas sem valor adicionado (art. 176)` MEANS `Demonstrações elaboradas (art. 176)` WITH
    `o balanço patrimonial foi elaborado` IS TRUE
    `a demonstração dos lucros ou prejuízos acumulados foi elaborada` IS TRUE
    `a demonstração do resultado do exercício foi elaborada` IS TRUE
    `a demonstração dos fluxos de caixa foi elaborada` IS TRUE
    `a demonstração do valor adicionado foi elaborada` IS FALSE

`demonstrações elaboradas sem o balanço (art. 176)` MEANS `Demonstrações elaboradas (art. 176)` WITH
    `o balanço patrimonial foi elaborado` IS FALSE
    `a demonstração dos lucros ou prejuízos acumulados foi elaborada` IS TRUE
    `a demonstração do resultado do exercício foi elaborada` IS TRUE
    `a demonstração dos fluxos de caixa foi elaborada` IS TRUE
    `a demonstração do valor adicionado foi elaborada` IS TRUE

`demonstrações elaboradas sem os lucros ou prejuízos acumulados (art. 176)` MEANS `Demonstrações elaboradas (art. 176)` WITH
    `o balanço patrimonial foi elaborado` IS TRUE
    `a demonstração dos lucros ou prejuízos acumulados foi elaborada` IS FALSE
    `a demonstração do resultado do exercício foi elaborada` IS TRUE
    `a demonstração dos fluxos de caixa foi elaborada` IS TRUE
    `a demonstração do valor adicionado foi elaborada` IS TRUE

`demonstrações elaboradas sem o resultado do exercício (art. 176)` MEANS `Demonstrações elaboradas (art. 176)` WITH
    `o balanço patrimonial foi elaborado` IS TRUE
    `a demonstração dos lucros ou prejuízos acumulados foi elaborada` IS TRUE
    `a demonstração do resultado do exercício foi elaborada` IS FALSE
    `a demonstração dos fluxos de caixa foi elaborada` IS TRUE
    `a demonstração do valor adicionado foi elaborada` IS TRUE

-- A closed company with equity 1,000,000: no cash flow, no value added needed.
#ASSERT `a diretoria fez elaborar as demonstrações financeiras que a lei exige (art. 176)` `demonstrações elaboradas sem fluxos de caixa nem valor adicionado (art. 176)` `companhia fechada` 1_000_000 TRUE TRUE
-- The same company with a statement it does require missing: balance sheet, accumulated profits, result.
#ASSERT NOT (`a diretoria fez elaborar as demonstrações financeiras que a lei exige (art. 176)` `demonstrações elaboradas sem o balanço (art. 176)` `companhia fechada` 1_000_000 TRUE TRUE)
#ASSERT NOT (`a diretoria fez elaborar as demonstrações financeiras que a lei exige (art. 176)` `demonstrações elaboradas sem os lucros ou prejuízos acumulados (art. 176)` `companhia fechada` 1_000_000 TRUE TRUE)
#ASSERT NOT (`a diretoria fez elaborar as demonstrações financeiras que a lei exige (art. 176)` `demonstrações elaboradas sem o resultado do exercício (art. 176)` `companhia fechada` 1_000_000 TRUE TRUE)
-- Equity 3,000,000: the cash-flow statement is now required, so its absence is a breach; its presence is not.
#ASSERT NOT (`a diretoria fez elaborar as demonstrações financeiras que a lei exige (art. 176)` `demonstrações elaboradas sem fluxos de caixa nem valor adicionado (art. 176)` `companhia fechada` 3_000_000 TRUE TRUE)
#ASSERT `a diretoria fez elaborar as demonstrações financeiras que a lei exige (art. 176)` `demonstrações elaboradas sem valor adicionado (art. 176)` `companhia fechada` 3_000_000 TRUE TRUE
-- An open company needs the value-added statement too.
#ASSERT NOT (`a diretoria fez elaborar as demonstrações financeiras que a lei exige (art. 176)` `demonstrações elaboradas sem valor adicionado (art. 176)` `companhia aberta` 3_000_000 TRUE TRUE)
#ASSERT `a diretoria fez elaborar as demonstrações financeiras que a lei exige (art. 176)` `todas as demonstrações elaboradas (art. 176)` `companhia aberta` 3_000_000 TRUE TRUE
-- From the books and with clarity: both are required.
#ASSERT NOT (`a diretoria fez elaborar as demonstrações financeiras que a lei exige (art. 176)` `todas as demonstrações elaboradas (art. 176)` `companhia aberta` 3_000_000 FALSE TRUE)
#ASSERT NOT (`a diretoria fez elaborar as demonstrações financeiras que a lei exige (art. 176)` `todas as demonstrações elaboradas (art. 176)` `companhia aberta` 3_000_000 TRUE FALSE)

§§ `Testes do Art. 176, §§ 1º a 4º e 7º`

#ASSERT `as demonstrações foram publicadas com os valores do exercício anterior (art. 176, § 1º)` TRUE
#ASSERT NOT (`as demonstrações foram publicadas com os valores do exercício anterior (art. 176, § 1º)` FALSE)
-- § 2º: a group worth 100; a tenth is 10. Exactly 10 is allowed; 11 is not.
#ASSERT `a agregação de pequenos saldos é permitida (art. 176, § 2º)` TRUE 10 100 FALSE
#ASSERT NOT (`a agregação de pequenos saldos é permitida (art. 176, § 2º)` TRUE 11 100 FALSE)
#ASSERT `a agregação de pequenos saldos é permitida (art. 176, § 2º)` TRUE 0 100 FALSE
-- The nature not indicated, or a generic name ("diversas contas"): not allowed.
#ASSERT NOT (`a agregação de pequenos saldos é permitida (art. 176, § 2º)` FALSE 5 100 FALSE)
#ASSERT NOT (`a agregação de pequenos saldos é permitida (art. 176, § 2º)` TRUE 5 100 TRUE)
-- § 3º and § 7º: the CVM regulated differently, so the record follows the CVM; otherwise the proposal.
#ASSERT `o registro da destinação dos lucros nas demonstrações está de acordo com a lei (art. 176, § 3º)` TRUE FALSE TRUE
#ASSERT NOT (`o registro da destinação dos lucros nas demonstrações está de acordo com a lei (art. 176, § 3º)` TRUE TRUE FALSE)
#ASSERT `o registro da destinação dos lucros nas demonstrações está de acordo com a lei (art. 176, § 3º)` FALSE TRUE FALSE
#ASSERT NOT (`o registro da destinação dos lucros nas demonstrações está de acordo com a lei (art. 176, § 3º)` FALSE FALSE TRUE)
-- § 4º: notes and the other necessary tables.
#ASSERT `as demonstrações foram complementadas como a lei exige (art. 176, § 4º)` TRUE TRUE
#ASSERT NOT (`as demonstrações foram complementadas como a lei exige (art. 176, § 4º)` FALSE TRUE)
#ASSERT NOT (`as demonstrações foram complementadas como a lei exige (art. 176, § 4º)` TRUE FALSE)

§ `Testes do Art. 177: escrituração`

#ASSERT `a escrituração da companhia está de acordo com a lei (art. 177)` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`a escrituração da companhia está de acordo com a lei (art. 177)` FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`a escrituração da companhia está de acordo com a lei (art. 177)` TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`a escrituração da companhia está de acordo com a lei (art. 177)` TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`a escrituração da companhia está de acordo com a lei (art. 177)` TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`a escrituração da companhia está de acordo com a lei (art. 177)` TRUE TRUE TRUE TRUE FALSE)
-- § 1º: no duty when there was no relevant change; if there was, the note must exist.
#ASSERT `a modificação de método contábil foi indicada em nota como a lei exige (art. 177, § 1º)` FALSE FALSE
#ASSERT `a modificação de método contábil foi indicada em nota como a lei exige (art. 177, § 1º)` TRUE TRUE
#ASSERT NOT (`a modificação de método contábil foi indicada em nota como a lei exige (art. 177, § 1º)` TRUE FALSE)
-- § 2º: only in auxiliary books, with the mercantile books and the statements untouched.
#ASSERT `a disposição da lei tributária ou de legislação especial foi observada como a lei exige (art. 177, § 2º)` TRUE TRUE
#ASSERT NOT (`a disposição da lei tributária ou de legislação especial foi observada como a lei exige (art. 177, § 2º)` FALSE TRUE)
#ASSERT NOT (`a disposição da lei tributária ou de legislação especial foi observada como a lei exige (art. 177, § 2º)` TRUE FALSE)
-- § 3º: open companies only; the closed company is not covered.
#ASSERT `as demonstrações da companhia aberta estão de acordo com o art. 177, § 3º` `companhia aberta` TRUE TRUE EQUALS JUST TRUE
#ASSERT `as demonstrações da companhia aberta estão de acordo com o art. 177, § 3º` `companhia aberta` TRUE FALSE EQUALS JUST FALSE
#ASSERT `as demonstrações da companhia aberta estão de acordo com o art. 177, § 3º` `companhia aberta` FALSE TRUE EQUALS JUST FALSE
#ASSERT `as demonstrações da companhia aberta estão de acordo com o art. 177, § 3º` `companhia fechada` TRUE TRUE EQUALS NOTHING
-- § 4º: signed by the administrators and by qualified accountants.
#ASSERT `as demonstrações financeiras foram assinadas como a lei exige (art. 177, § 4º)` TRUE TRUE
#ASSERT NOT (`as demonstrações financeiras foram assinadas como a lei exige (art. 177, § 4º)` TRUE FALSE)
#ASSERT NOT (`as demonstrações financeiras foram assinadas como a lei exige (art. 177, § 4º)` FALSE TRUE)
-- § 5º: the CVM's norm.
#ASSERT `a norma da CVM sobre demonstrações financeiras está de acordo com o art. 177, § 5º` TRUE
#ASSERT NOT (`a norma da CVM sobre demonstrações financeiras está de acordo com o art. 177, § 5º` FALSE)
-- § 6º: the closed company may opt; for an open company the paragraph says nothing.
#ASSERT `a companhia pode optar por observar as normas da CVM para companhias abertas (art. 177, § 6º)` `companhia fechada` EQUALS JUST TRUE
#ASSERT `a companhia pode optar por observar as normas da CVM para companhias abertas (art. 177, § 6º)` `companhia aberta` EQUALS NOTHING

§§ `Testes do Art. 176, § 5º: notas explicativas`

-- A record built from eighteen answers in the order of the declaration: the three general items, the criteria,
-- then the pairs "exists / indicated" for investments, new valuations, long-term obligations and so on.
GIVEN n01 IS A BOOLEAN
      n02 IS A BOOLEAN
      n03 IS A BOOLEAN
      n04 IS A BOOLEAN
      n05 IS A BOOLEAN
      n06 IS A BOOLEAN
      n07 IS A BOOLEAN
      n08 IS A BOOLEAN
      n09 IS A BOOLEAN
      n10 IS A BOOLEAN
      n11 IS A BOOLEAN
      n12 IS A BOOLEAN
      n13 IS A BOOLEAN
      n14 IS A BOOLEAN
      n15 IS A BOOLEAN
      n16 IS A BOOLEAN
      n17 IS A BOOLEAN
      n18 IS A BOOLEAN
GIVETH A `Notas explicativas (art. 176, § 5º)`
`uma nota explicativa de teste (art. 176, § 5º)` n01 n02 n03 n04 n05 n06 n07 n08 n09 n10 n11 n12 n13 n14 n15 n16 n17 n18 MEANS
    `Notas explicativas (art. 176, § 5º)` WITH
        `as notas apresentam a base de preparação e as práticas contábeis específicas selecionadas e aplicadas` IS n01
        `as notas divulgam as informações exigidas pelas práticas contábeis do Brasil que não estão em outra parte` IS n02
        `as notas fornecem as informações adicionais necessárias para uma apresentação adequada` IS n03
        `as notas indicam os principais critérios de avaliação, depreciação, amortização, exaustão e provisões` IS n04
        `há investimentos relevantes em outras sociedades` IS n05
        `as notas indicam os investimentos relevantes em outras sociedades` IS n06
        `houve aumento de valor de elementos do ativo resultante de novas avaliações` IS n07
        `as notas indicam o aumento de valor resultante de novas avaliações` IS n08
        `as notas indicam os ônus reais, as garantias prestadas a terceiros e as responsabilidades eventuais ou contingentes` IS n09
        `há obrigações a longo prazo` IS n10
        `as notas indicam a taxa de juros, as datas de vencimento e as garantias das obrigações a longo prazo` IS n11
        `as notas indicam o número, espécies e classes das ações do capital social` IS n12
        `houve opções de compra de ações outorgadas ou exercidas no exercício` IS n13
        `as notas indicam as opções de compra de ações outorgadas e exercidas no exercício` IS n14
        `há ajustes de exercícios anteriores` IS n15
        `as notas indicam os ajustes de exercícios anteriores` IS n16
        `há eventos subsequentes com efeito relevante sobre a situação financeira e os resultados futuros` IS n17
        `as notas indicam os eventos subsequentes com efeito relevante` IS n18

-- Everything present and everything indicated: the notes bring all the Law asks.
#ASSERT `as notas explicativas trazem tudo o que a lei exige (art. 176, § 5º)` (`uma nota explicativa de teste (art. 176, § 5º)` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE)
-- Each required item missing, one at a time, with everything else in order: the notes fall short.
-- Missing: a base de preparação e as práticas contábeis (inciso I).
#ASSERT NOT (`as notas explicativas trazem tudo o que a lei exige (art. 176, § 5º)` (`uma nota explicativa de teste (art. 176, § 5º)` FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE))
-- Missing: as informações exigidas pelas práticas contábeis do Brasil (inciso II).
#ASSERT NOT (`as notas explicativas trazem tudo o que a lei exige (art. 176, § 5º)` (`uma nota explicativa de teste (art. 176, § 5º)` TRUE FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE))
-- Missing: as informações adicionais necessárias (inciso III).
#ASSERT NOT (`as notas explicativas trazem tudo o que a lei exige (art. 176, § 5º)` (`uma nota explicativa de teste (art. 176, § 5º)` TRUE TRUE FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE))
-- Missing: os critérios de avaliação, depreciação, amortização, exaustão e provisões (inciso IV, alínea a).
#ASSERT NOT (`as notas explicativas trazem tudo o que a lei exige (art. 176, § 5º)` (`uma nota explicativa de teste (art. 176, § 5º)` TRUE TRUE TRUE FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE))
-- Missing: os investimentos relevantes em outras sociedades (inciso IV, alínea b).
#ASSERT NOT (`as notas explicativas trazem tudo o que a lei exige (art. 176, § 5º)` (`uma nota explicativa de teste (art. 176, § 5º)` TRUE TRUE TRUE TRUE TRUE FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE))
-- Missing: o aumento de valor por novas avaliações (inciso IV, alínea c).
#ASSERT NOT (`as notas explicativas trazem tudo o que a lei exige (art. 176, § 5º)` (`uma nota explicativa de teste (art. 176, § 5º)` TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE))
-- Missing: os ônus reais, garantias e responsabilidades eventuais (inciso IV, alínea d).
#ASSERT NOT (`as notas explicativas trazem tudo o que a lei exige (art. 176, § 5º)` (`uma nota explicativa de teste (art. 176, § 5º)` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE))
-- Missing: a taxa de juros, vencimentos e garantias das obrigações a longo prazo (inciso IV, alínea e).
#ASSERT NOT (`as notas explicativas trazem tudo o que a lei exige (art. 176, § 5º)` (`uma nota explicativa de teste (art. 176, § 5º)` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE))
-- Missing: o número, espécies e classes das ações (inciso IV, alínea f).
#ASSERT NOT (`as notas explicativas trazem tudo o que a lei exige (art. 176, § 5º)` (`uma nota explicativa de teste (art. 176, § 5º)` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE TRUE TRUE TRUE TRUE TRUE TRUE))
-- Missing: as opções de compra de ações (inciso IV, alínea g).
#ASSERT NOT (`as notas explicativas trazem tudo o que a lei exige (art. 176, § 5º)` (`uma nota explicativa de teste (art. 176, § 5º)` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE TRUE TRUE TRUE TRUE))
-- Missing: os ajustes de exercícios anteriores (inciso IV, alínea h).
#ASSERT NOT (`as notas explicativas trazem tudo o que a lei exige (art. 176, § 5º)` (`uma nota explicativa de teste (art. 176, § 5º)` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE TRUE TRUE))
-- Missing: os eventos subsequentes (inciso IV, alínea i).
#ASSERT NOT (`as notas explicativas trazem tudo o que a lei exige (art. 176, § 5º)` (`uma nota explicativa de teste (art. 176, § 5º)` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE))
-- A conditional item that does not exist needs no note: existence FALSE and the note FALSE is in order.
-- No investimentos relevantes in the company and none in the notes.
#ASSERT `as notas explicativas trazem tudo o que a lei exige (art. 176, § 5º)` (`uma nota explicativa de teste (art. 176, § 5º)` TRUE TRUE TRUE TRUE FALSE FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE)
-- No aumento de valor por novas avaliações in the company and none in the notes.
#ASSERT `as notas explicativas trazem tudo o que a lei exige (art. 176, § 5º)` (`uma nota explicativa de teste (art. 176, § 5º)` TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE)
-- No obrigações a longo prazo in the company and none in the notes.
#ASSERT `as notas explicativas trazem tudo o que a lei exige (art. 176, § 5º)` (`uma nota explicativa de teste (art. 176, § 5º)` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE)
-- No opções de compra de ações in the company and none in the notes.
#ASSERT `as notas explicativas trazem tudo o que a lei exige (art. 176, § 5º)` (`uma nota explicativa de teste (art. 176, § 5º)` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE TRUE TRUE TRUE TRUE)
-- No ajustes de exercícios anteriores in the company and none in the notes.
#ASSERT `as notas explicativas trazem tudo o que a lei exige (art. 176, § 5º)` (`uma nota explicativa de teste (art. 176, § 5º)` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE TRUE TRUE)
-- No eventos subsequentes in the company and none in the notes.
#ASSERT `as notas explicativas trazem tudo o que a lei exige (art. 176, § 5º)` (`uma nota explicativa de teste (art. 176, § 5º)` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE)
