IMPORT prelude
IMPORT `br-core`
IMPORT `br3-cap10-sec5-acordo`

-- br3-tests-cap10-sec5-acordo.l4 -- tests of Art. 118. Each expected value is written from the text of the paragraph
-- named beside it, before running.

§ `Testes do art. 118`

-- Caput: the company must observe an agreement on one of the four subjects once it is filed at the seat.
#ASSERT `a companhia deve observar o acordo de acionistas (art. 118)` TRUE TRUE
#ASSERT NOT (`a companhia deve observar o acordo de acionistas (art. 118)` TRUE FALSE)
#ASSERT NOT (`a companhia deve observar o acordo de acionistas (art. 118)` FALSE TRUE)
-- § 1º: opposable to third parties after annotation in the books and, if certificates were issued, in them.
#ASSERT `as obrigações do acordo são oponíveis a terceiros (art. 118, § 1º)` TRUE FALSE FALSE
#ASSERT `as obrigações do acordo são oponíveis a terceiros (art. 118, § 1º)` TRUE TRUE TRUE
#ASSERT NOT (`as obrigações do acordo são oponíveis a terceiros (art. 118, § 1º)` TRUE TRUE FALSE)
#ASSERT NOT (`as obrigações do acordo são oponíveis a terceiros (art. 118, § 1º)` FALSE FALSE FALSE)
#ASSERT NOT (`as obrigações do acordo são oponíveis a terceiros (art. 118, § 1º)` FALSE TRUE TRUE)
-- § 2º
#ASSERT `o acordo pode ser invocado para eximir o acionista de responsabilidade (art. 118, § 2º)` TRUE EQUALS JUST FALSE
#ASSERT `o acordo pode ser invocado para eximir o acionista de responsabilidade (art. 118, § 2º)` FALSE EQUALS NOTHING
-- § 3º
#ASSERT `os acionistas podem promover a execução específica das obrigações do acordo (art. 118, § 3º)` TRUE TRUE
#ASSERT NOT (`os acionistas podem promover a execução específica das obrigações do acordo (art. 118, § 3º)` TRUE FALSE)
#ASSERT NOT (`os acionistas podem promover a execução específica das obrigações do acordo (art. 118, § 3º)` FALSE TRUE)
-- § 4º
#ASSERT `as ações averbadas podem ser negociadas em bolsa ou no mercado de balcão (art. 118, § 4º)` TRUE EQUALS JUST FALSE
#ASSERT `as ações averbadas podem ser negociadas em bolsa ou no mercado de balcão (art. 118, § 4º)` FALSE EQUALS NOTHING
-- § 5º: the open company's managers report the agreement's dividend and reinvestment provisions.
#ASSERT `os órgãos da administração devem informar à assembleia-geral as disposições do acordo no relatório anual (art. 118, § 5º)` `companhia aberta` TRUE
#ASSERT NOT (`os órgãos da administração devem informar à assembleia-geral as disposições do acordo no relatório anual (art. 118, § 5º)` `companhia fechada` TRUE)
#ASSERT NOT (`os órgãos da administração devem informar à assembleia-geral as disposições do acordo no relatório anual (art. 118, § 5º)` `companhia aberta` FALSE)
-- § 6º
#ASSERT `a denúncia do acordo só pode seguir as suas estipulações (art. 118, § 6º)` TRUE EQUALS JUST TRUE
#ASSERT `a denúncia do acordo só pode seguir as suas estipulações (art. 118, § 6º)` FALSE EQUALS NOTHING
-- § 7º
#ASSERT `a procuração pode ter prazo superior ao do art. 126, § 1º (art. 118, § 7º)` TRUE EQUALS JUST TRUE
#ASSERT `a procuração pode ter prazo superior ao do art. 126, § 1º (art. 118, § 7º)` FALSE EQUALS NOTHING
-- § 8º: the chair does not count a vote cast against a duly filed agreement.
#ASSERT `o presidente deve deixar de computar o voto (art. 118, § 8º)` TRUE TRUE
#ASSERT NOT (`o presidente deve deixar de computar o voto (art. 118, § 8º)` TRUE FALSE)
#ASSERT NOT (`o presidente deve deixar de computar o voto (art. 118, § 8º)` FALSE TRUE)
-- § 9º
#ASSERT `a parte prejudicada pode votar com as ações do acionista ausente ou omisso (art. 118, § 9º)` TRUE TRUE
#ASSERT NOT (`a parte prejudicada pode votar com as ações do acionista ausente ou omisso (art. 118, § 9º)` TRUE FALSE)
#ASSERT NOT (`a parte prejudicada pode votar com as ações do acionista ausente ou omisso (art. 118, § 9º)` FALSE TRUE)
#ASSERT `a parte prejudicada pode votar pelo conselheiro ausente ou omisso que elegeu (art. 118, § 9º)` TRUE TRUE TRUE
#ASSERT NOT (`a parte prejudicada pode votar pelo conselheiro ausente ou omisso que elegeu (art. 118, § 9º)` FALSE TRUE TRUE)
#ASSERT NOT (`a parte prejudicada pode votar pelo conselheiro ausente ou omisso que elegeu (art. 118, § 9º)` TRUE FALSE TRUE)
#ASSERT NOT (`a parte prejudicada pode votar pelo conselheiro ausente ou omisso que elegeu (art. 118, § 9º)` TRUE TRUE FALSE)
-- § 10
#ASSERT `os acionistas vinculados cumpriram o dever de indicar representante (art. 118, § 10)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `os acionistas vinculados cumpriram o dever de indicar representante (art. 118, § 10)` TRUE FALSE EQUALS JUST FALSE
#ASSERT `os acionistas vinculados cumpriram o dever de indicar representante (art. 118, § 10)` FALSE TRUE EQUALS NOTHING
-- § 11
#ASSERT `a companhia pode solicitar aos membros do acordo esclarecimento sobre suas cláusulas (art. 118, § 11)` TRUE EQUALS JUST TRUE
#ASSERT `a companhia pode solicitar aos membros do acordo esclarecimento sobre suas cláusulas (art. 118, § 11)` FALSE EQUALS NOTHING
