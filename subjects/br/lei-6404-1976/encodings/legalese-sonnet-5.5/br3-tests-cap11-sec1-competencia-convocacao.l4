#ASSERT `a companhia pode realizar assembleia digital (art. 124, § 2º-A)` FALSE EQUALS NOTHING
-- § 3º: closed company, 5% or more, a written request with address and term, not above 2 fiscal years, still in force.
#ASSERT `o acionista deve ser convocado por telegrama ou carta registrada (art. 124, § 3º)` `companhia fechada` 50 1000 TRUE 2 TRUE EQUALS JUST TRUE
#ASSERT `o acionista deve ser convocado por telegrama ou carta registrada (art. 124, § 3º)` `companhia fechada` 50 1000 TRUE 1 TRUE EQUALS JUST TRUE
#ASSERT `o acionista deve ser convocado por telegrama ou carta registrada (art. 124, § 3º)` `companhia fechada` 50 1000 TRUE 3 TRUE EQUALS NOTHING
#ASSERT `o acionista deve ser convocado por telegrama ou carta registrada (art. 124, § 3º)` `companhia aberta` 50 1000 TRUE 2 TRUE EQUALS JUST FALSE
#ASSERT `o acionista deve ser convocado por telegrama ou carta registrada (art. 124, § 3º)` `companhia fechada` 49 1000 TRUE 2 TRUE EQUALS JUST FALSE
#ASSERT `o acionista deve ser convocado por telegrama ou carta registrada (art. 124, § 3º)` `companhia fechada` 50 1000 FALSE 2 TRUE EQUALS JUST FALSE
#ASSERT `o acionista deve ser convocado por telegrama ou carta registrada (art. 124, § 3º)` `companhia fechada` 50 1000 TRUE 2 FALSE EQUALS JUST FALSE
#ASSERT `a convocação pessoal dispensa a publicação do aviso (art. 124, § 3º)` TRUE EQUALS JUST FALSE
#ASSERT `a convocação pessoal dispensa a publicação do aviso (art. 124, § 3º)` FALSE EQUALS NOTHING
#ASSERT `o acionista tem direito a indenização dos administradores (art. 124, § 3º)` TRUE TRUE TRUE
#ASSERT NOT (`o acionista tem direito a indenização dos administradores (art. 124, § 3º)` FALSE TRUE TRUE)
#ASSERT NOT (`o acionista tem direito a indenização dos administradores (art. 124, § 3º)` TRUE FALSE TRUE)
#ASSERT NOT (`o acionista tem direito a indenização dos administradores (art. 124, § 3º)` TRUE TRUE FALSE)
-- § 4º: the meeting all the shareholders attend is regular whatever the formalities.
#ASSERT `a assembleia é regular quanto às formalidades de convocação (art. 124, § 4º)` TRUE EQUALS JUST TRUE
#ASSERT `a assembleia é regular quanto às formalidades de convocação (art. 124, § 4º)` FALSE EQUALS NOTHING
-- § 5º, inciso I: the CVM may postpone by up to 30 days, from the date the complete information is made available.
#ASSERT `a CVM pode determinar o adiamento da assembleia (art. 124, § 5º, inciso I)` TRUE TRUE TRUE TRUE
#ASSERT NOT (`a CVM pode determinar o adiamento da assembleia (art. 124, § 5º, inciso I)` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`a CVM pode determinar o adiamento da assembleia (art. 124, § 5º, inciso I)` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`a CVM pode determinar o adiamento da assembleia (art. 124, § 5º, inciso I)` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`a CVM pode determinar o adiamento da assembleia (art. 124, § 5º, inciso I)` TRUE TRUE TRUE FALSE)
#ASSERT `o limite do adiamento da assembleia pela CVM (art. 124, § 5º, inciso I)` (YearMonthDay 2026 3 1) EQUALS YearMonthDay 2026 3 31
-- inciso II: interruption of up to 15 days of the notice period of an extraordinary meeting of an open company.
#ASSERT `a CVM pode interromper o prazo de antecedência da convocação (art. 124, § 5º, inciso II)` `companhia aberta` TRUE TRUE TRUE TRUE
#ASSERT NOT (`a CVM pode interromper o prazo de antecedência da convocação (art. 124, § 5º, inciso II)` `companhia fechada` TRUE TRUE TRUE TRUE)
#ASSERT NOT (`a CVM pode interromper o prazo de antecedência da convocação (art. 124, § 5º, inciso II)` `companhia aberta` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`a CVM pode interromper o prazo de antecedência da convocação (art. 124, § 5º, inciso II)` `companhia aberta` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`a CVM pode interromper o prazo de antecedência da convocação (art. 124, § 5º, inciso II)` `companhia aberta` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`a CVM pode interromper o prazo de antecedência da convocação (art. 124, § 5º, inciso II)` `companhia aberta` TRUE TRUE TRUE FALSE)
#ASSERT `o limite da interrupção do prazo de antecedência pela CVM (art. 124, § 5º, inciso II)` (YearMonthDay 2026 3 1) EQUALS YearMonthDay 2026 3 16
-- § 6º: the open company with shares admitted to an exchange sends the documents to the exchange.
#ASSERT `a companhia deve remeter à bolsa os documentos postos à disposição dos acionistas (art. 124, § 6º)` `companhia aberta` TRUE
#ASSERT NOT (`a companhia deve remeter à bolsa os documentos postos à disposição dos acionistas (art. 124, § 6º)` `companhia aberta` FALSE)
#ASSERT NOT (`a companhia deve remeter à bolsa os documentos postos à disposição dos acionistas (art. 124, § 6º)` `companhia fechada` TRUE)
