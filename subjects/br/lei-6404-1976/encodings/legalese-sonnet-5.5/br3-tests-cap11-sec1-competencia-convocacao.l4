IMPORT prelude
IMPORT `br-core`
IMPORT `br3-nomes`
IMPORT `br3-cap11-sec1-competencia-convocacao`

-- br3-tests-cap11-sec1-competencia-convocacao.l4 -- tests of Arts. 121 to 124. Each expected value is written from the
-- text of the provision named beside it, before running. Dates are written year first.

§ `Testes dos arts. 121 a 124`

§§ `Art. 121`

#ASSERT `a assembleia-geral tem poderes para tomar a resolução (art. 121)` TRUE TRUE FALSE
#ASSERT `a assembleia-geral tem poderes para tomar a resolução (art. 121)` TRUE FALSE TRUE
#ASSERT NOT (`a assembleia-geral tem poderes para tomar a resolução (art. 121)` TRUE FALSE FALSE)
#ASSERT NOT (`a assembleia-geral tem poderes para tomar a resolução (art. 121)` FALSE TRUE TRUE)
#ASSERT `o acionista pode participar e votar a distância (art. 121, parágrafo único)` TRUE EQUALS JUST TRUE
#ASSERT `o acionista pode participar e votar a distância (art. 121, parágrafo único)` FALSE EQUALS NOTHING

§§ `Art. 122`

#ASSERT `a matéria é de competência privativa da assembleia-geral (art. 122)` `reforma do estatuto social (art. 122, inciso I)` `companhia fechada` FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `a matéria é de competência privativa da assembleia-geral (art. 122)` `tomada anual das contas dos administradores e deliberação sobre as demonstrações financeiras (art. 122, inciso III)` `companhia fechada` FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `a matéria é de competência privativa da assembleia-geral (art. 122)` `suspensão do exercício dos direitos do acionista (art. 122, inciso V)` `companhia fechada` FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `a matéria é de competência privativa da assembleia-geral (art. 122)` `avaliação de bens com que o acionista concorrer para o capital social (art. 122, inciso VI)` `companhia fechada` FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `a matéria é de competência privativa da assembleia-geral (art. 122)` `autorização de emissão de partes beneficiárias (art. 122, inciso VII)` `companhia fechada` FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `a matéria é de competência privativa da assembleia-geral (art. 122)` `transformação, fusão, incorporação, cisão, dissolução e liquidação, e liquidantes (art. 122, inciso VIII)` `companhia fechada` FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `a matéria é de competência privativa da assembleia-geral (art. 122)` `autorização aos administradores para confessar falência e pedir recuperação judicial (art. 122, inciso IX)` `companhia fechada` FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `a matéria é de competência privativa da assembleia-geral (art. 122)` `eleição ou destituição de administradores e fiscais (art. 122, inciso II)` `companhia aberta` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `a matéria é de competência privativa da assembleia-geral (art. 122)` `eleição ou destituição de administradores e fiscais (art. 122, inciso II)` `companhia aberta` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `a matéria é de competência privativa da assembleia-geral (art. 122)` `eleição ou destituição de administradores e fiscais (art. 122, inciso II)` `companhia aberta` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `a matéria é de competência privativa da assembleia-geral (art. 122)` `autorização de emissão de debêntures (art. 122, inciso IV)` `companhia aberta` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `a matéria é de competência privativa da assembleia-geral (art. 122)` `autorização de emissão de debêntures (art. 122, inciso IV)` `companhia aberta` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `a matéria é de competência privativa da assembleia-geral (art. 122)` `transações com partes relacionadas de companhia aberta (art. 122, inciso X)` `companhia fechada` FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `a matéria é de competência privativa da assembleia-geral (art. 122)` `transações com partes relacionadas de companhia aberta (art. 122, inciso X)` `companhia aberta` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `a matéria é de competência privativa da assembleia-geral (art. 122)` `transações com partes relacionadas de companhia aberta (art. 122, inciso X)` `companhia aberta` FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `a matéria é de competência privativa da assembleia-geral (art. 122)` `alienação ou contribuição para outra empresa de ativos de companhia aberta (art. 122, inciso X)` `companhia fechada` FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `a matéria é de competência privativa da assembleia-geral (art. 122)` `alienação ou contribuição para outra empresa de ativos de companhia aberta (art. 122, inciso X)` `companhia aberta` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `a matéria é de competência privativa da assembleia-geral (art. 122)` `alienação ou contribuição para outra empresa de ativos de companhia aberta (art. 122, inciso X)` `companhia aberta` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- Inciso X: "mais de 50%" of the total assets: exactly half is not enough.
#ASSERT NOT (`o valor da operação passa de metade dos ativos totais (art. 122, inciso X)` 500 1000)
#ASSERT `o valor da operação passa de metade dos ativos totais (art. 122, inciso X)` 501 1000
#ASSERT NOT (`o valor da operação passa de metade dos ativos totais (art. 122, inciso X)` 499 1000)
-- Parágrafo único: urgency, and the controller's agreement if there is one; then the meeting is convened at once.
#ASSERT `os administradores podem confessar falência ou pedir recuperação judicial por urgência (art. 122, parágrafo único)` TRUE FALSE FALSE
#ASSERT `os administradores podem confessar falência ou pedir recuperação judicial por urgência (art. 122, parágrafo único)` TRUE TRUE TRUE
#ASSERT NOT (`os administradores podem confessar falência ou pedir recuperação judicial por urgência (art. 122, parágrafo único)` TRUE TRUE FALSE)
#ASSERT NOT (`os administradores podem confessar falência ou pedir recuperação judicial por urgência (art. 122, parágrafo único)` FALSE FALSE FALSE)
#ASSERT `a assembleia-geral deve ser convocada imediatamente para deliberar sobre a matéria (art. 122, parágrafo único)` TRUE
#ASSERT NOT (`a assembleia-geral deve ser convocada imediatamente para deliberar sobre a matéria (art. 122, parágrafo único)` FALSE)

§§ `Art. 123`

#ASSERT `quem tem competência para convocar a assembleia-geral (art. 123)` TRUE EQUALS `o conselho de administração`
#ASSERT `quem tem competência para convocar a assembleia-geral (art. 123)` FALSE EQUALS `a diretoria`
#ASSERT `o conselho fiscal pode convocar a assembleia-geral (art. 123, parágrafo único, alínea a)` TRUE
#ASSERT NOT (`o conselho fiscal pode convocar a assembleia-geral (art. 123, parágrafo único, alínea a)` FALSE)
-- Alínea b: the managers delay the convening for more than 60 days (due on 1 Jan 2026: the 60th day is 2 Mar 2026).
#ASSERT `qualquer acionista pode convocar a assembleia-geral (art. 123, parágrafo único, alínea b)` TRUE (YearMonthDay 2026 1 1) (YearMonthDay 2026 3 3)
#ASSERT NOT (`qualquer acionista pode convocar a assembleia-geral (art. 123, parágrafo único, alínea b)` TRUE (YearMonthDay 2026 1 1) (YearMonthDay 2026 3 2))
#ASSERT NOT (`qualquer acionista pode convocar a assembleia-geral (art. 123, parágrafo único, alínea b)` FALSE (YearMonthDay 2026 1 1) (YearMonthDay 2026 3 3))
-- Alínea c: 5% of the capital, a grounded request, no answer within 8 days (request on 10 Jan 2026: the 8th day is 18 Jan).
#ASSERT `acionistas com cinco por cento do capital podem convocar a assembleia-geral (art. 123, parágrafo único, alínea c)` 50 1000 TRUE (YearMonthDay 2026 1 10) (YearMonthDay 2026 1 19)
#ASSERT NOT (`acionistas com cinco por cento do capital podem convocar a assembleia-geral (art. 123, parágrafo único, alínea c)` 49 1000 TRUE (YearMonthDay 2026 1 10) (YearMonthDay 2026 1 19))
#ASSERT NOT (`acionistas com cinco por cento do capital podem convocar a assembleia-geral (art. 123, parágrafo único, alínea c)` 50 1000 FALSE (YearMonthDay 2026 1 10) (YearMonthDay 2026 1 19))
#ASSERT NOT (`acionistas com cinco por cento do capital podem convocar a assembleia-geral (art. 123, parágrafo único, alínea c)` 50 1000 TRUE (YearMonthDay 2026 1 10) (YearMonthDay 2026 1 18))
`pedido com 5% do capital votante (teste art. 123)` MEANS `Pedido de convocação para instalar o conselho fiscal (art. 123, parágrafo único, alínea d)` WITH
    `a quantidade de ações com direito a voto dos requerentes` IS 50
    `o total de ações com direito a voto` IS 1000
    `a quantidade de acionistas sem direito a voto entre os requerentes` IS 0
    `o total de acionistas sem direito a voto` IS 100
    `a quantidade de ações sem direito a voto dos requerentes` IS 0
    `o total de ações sem direito a voto` IS 1000
    `a data do pedido de convocação` IS YearMonthDay 2026 1 10

