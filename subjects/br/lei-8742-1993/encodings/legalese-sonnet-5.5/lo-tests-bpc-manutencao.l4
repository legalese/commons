IMPORT prelude
IMPORT daydate
IMPORT `lo-nouns`
IMPORT `lo-bpc-manutencao`

-- Tests of lo-bpc-manutencao.l4 (arts. 21, 21-A, 21-B, 40-C).
-- Expected values are written by hand from the text, beside each assertion.

§ `Testes — manutenção do benefício de prestação continuada (arts. 21 a 21-B e 40-C)`

§§ `Art. 21, caput — revisão a cada 2 anos`

-- granted or last reviewed on 15 March 2024: due again on 15 March 2026
#ASSERT `art. 21, caput — dia em que o benefício deve ser revisto` (Date 15 3 2024) EQUALS Date 15 3 2026
#ASSERT NOT `art. 21, caput — a revisão está atrasada` (Date 15 3 2024) (Date 15 3 2026)
#ASSERT `art. 21, caput — a revisão está atrasada` (Date 15 3 2024) (Date 16 3 2026)
#ASSERT NOT `art. 21, caput — a revisão está atrasada` (Date 15 3 2024) (Date 1 1 2025)

§§ `Art. 21, §§ 1º a 6º`

-- § 1º: ceases when the conditions are overcome, or on death
#ASSERT NOT `art. 21, § 1º — o pagamento do benefício cessa` FALSE FALSE
#ASSERT `art. 21, § 1º — o pagamento do benefício cessa` TRUE FALSE
#ASSERT `art. 21, § 1º — o pagamento do benefício cessa` FALSE TRUE
-- § 2º: cancelled on irregularity in the grant or in the use
#ASSERT NOT `art. 21, § 2º — o benefício é cancelado` FALSE FALSE
#ASSERT `art. 21, § 2º — o benefício é cancelado` TRUE FALSE
#ASSERT `art. 21, § 2º — o benefício é cancelado` FALSE TRUE
-- § 3º: the two listed facts are not grounds; "outro fato" is outside the text
#ASSERT `art. 21, § 3º — o fato constitui motivo de suspensão ou cessação` `desenvolvimento das capacidades cognitivas, motoras ou educacionais` EQUALS `não, segundo o texto`
#ASSERT `art. 21, § 3º — o fato constitui motivo de suspensão ou cessação` `atividade não remunerada de habilitação e reabilitação` EQUALS `não, segundo o texto`
#ASSERT `art. 21, § 3º — o fato constitui motivo de suspensão ou cessação` `outro fato` EQUALS `o texto não responde`
-- § 4º: a new grant is possible if the ceased benefit was a person with disability's and the regulation's requirements are met
#ASSERT `art. 21, § 4º — a cessação não impede nova concessão` TRUE TRUE
#ASSERT NOT `art. 21, § 4º — a cessação não impede nova concessão` TRUE FALSE
#ASSERT NOT `art. 21, § 4º — a cessação não impede nova concessão` FALSE TRUE
-- § 5º: exempt from periodic medical-expert evaluation if permanent, except on well-founded suspicion of fraud or error
#ASSERT `art. 21, § 5º — o beneficiário é dispensado de avaliação médico-pericial periódica` TRUE FALSE
#ASSERT NOT `art. 21, § 5º — o beneficiário é dispensado de avaliação médico-pericial periódica` TRUE TRUE
#ASSERT NOT `art. 21, § 5º — o beneficiário é dispensado de avaliação médico-pericial periódica` FALSE FALSE
-- § 6º: Zika
#ASSERT `art. 21, § 6º — a revisão para constatar a permanência da deficiência é dispensada` TRUE TRUE
#ASSERT NOT `art. 21, § 6º — a revisão para constatar a permanência da deficiência é dispensada` TRUE FALSE
#ASSERT NOT `art. 21, § 6º — a revisão para constatar a permanência da deficiência é dispensada` FALSE TRUE

§§ `Art. 21-A — atividade remunerada`

-- args: pessoa com deficiência; exerce atividade remunerada; contratado como aprendiz; meses de recebimento concomitante
#ASSERT `art. 21-A — o benefício é suspenso pelo órgão concedente` TRUE TRUE FALSE 0 EQUALS `sim, segundo o texto`
#ASSERT `art. 21-A — o benefício é suspenso pelo órgão concedente` TRUE FALSE FALSE 0 EQUALS `não, segundo o texto`
-- microempreendedor individual is included in "atividade remunerada": same answer as any paid activity
#ASSERT `art. 21-A — o benefício é suspenso pelo órgão concedente` TRUE TRUE FALSE 12 EQUALS `sim, segundo o texto`
-- the text speaks only of "pessoa com deficiência": an elderly beneficiary is outside it
#ASSERT `art. 21-A — o benefício é suspenso pelo órgão concedente` FALSE TRUE FALSE 0 EQUALS `o texto não responde`
-- § 2º: apprentice, up to 2 years (24 months) of concurrent receipt: not suspended; 25 months: suspended
#ASSERT `art. 21-A — o benefício é suspenso pelo órgão concedente` TRUE TRUE TRUE 1 EQUALS `não, segundo o texto`
#ASSERT `art. 21-A — o benefício é suspenso pelo órgão concedente` TRUE TRUE TRUE 24 EQUALS `não, segundo o texto`
#ASSERT `art. 21-A — o benefício é suspenso pelo órgão concedente` TRUE TRUE TRUE 25 EQUALS `sim, segundo o texto`
-- § 1º: continuity may be requested when the activity ended, the unemployment insurance has ended, and no social security benefit was acquired
#ASSERT `art. 21-A, § 1º — pode ser requerida a continuidade do pagamento do benefício suspenso, sem nova perícia` TRUE FALSE FALSE
#ASSERT NOT `art. 21-A, § 1º — pode ser requerida a continuidade do pagamento do benefício suspenso, sem nova perícia` FALSE FALSE FALSE
#ASSERT NOT `art. 21-A, § 1º — pode ser requerida a continuidade do pagamento do benefício suspenso, sem nova perícia` TRUE TRUE FALSE
#ASSERT NOT `art. 21-A, § 1º — pode ser requerida a continuidade do pagamento do benefício suspenso, sem nova perícia` TRUE FALSE TRUE

§§ `Art. 21-B — Cadastro Único`

-- caput: not registered, or outdated "há mais de 24 meses" (24 is not more than 24)
#ASSERT `art. 21-B, caput — o beneficiário deve regularizar a situação no Cadastro Único` FALSE 0
#ASSERT `art. 21-B, caput — o beneficiário deve regularizar a situação no Cadastro Único` TRUE 25
#ASSERT NOT `art. 21-B, caput — o beneficiário deve regularizar a situação no Cadastro Único` TRUE 24
#ASSERT NOT `art. 21-B, caput — o beneficiário deve regularizar a situação no Cadastro Único` TRUE 3
-- I and II: 45 days for a small municipality, 90 days "com população acima de 50.000"
#ASSERT `art. 21-B, caput, incisos I e II — prazo em dias para regularizar a situação` FALSE 0 20000 EQUALS JUST 45
#ASSERT `art. 21-B, caput, incisos I e II — prazo em dias para regularizar a situação` FALSE 0 50000 EQUALS JUST 45
#ASSERT `art. 21-B, caput, incisos I e II — prazo em dias para regularizar a situação` FALSE 0 50001 EQUALS JUST 90
#ASSERT `art. 21-B, caput, incisos I e II — prazo em dias para regularizar a situação` TRUE 30 1000000 EQUALS JUST 90
-- no duty: no deadline (explicit absence)
#ASSERT `art. 21-B, caput, incisos I e II — prazo em dias para regularizar a situação` TRUE 24 50001 EQUALS NOTHING
-- the deadline counts from the effective notification: 1 March 2026 + 45 days = 15 April 2026; + 90 days = 30 May 2026
#ASSERT `art. 21-B, caput — último dia para regularizar a situação no Cadastro Único` (Date 1 3 2026) FALSE 0 20000 EQUALS JUST (Date 15 4 2026)
#ASSERT `art. 21-B, caput — último dia para regularizar a situação no Cadastro Único` (Date 1 3 2026) FALSE 0 80000 EQUALS JUST (Date 30 5 2026)
#ASSERT `art. 21-B, caput — último dia para regularizar a situação no Cadastro Único` (Date 1 3 2026) TRUE 12 80000 EQUALS NOTHING
-- § 1º: blocked 30 days after the notification is sent, if there was no knowledge of it
#ASSERT `art. 21-B, § 1º — o crédito do benefício é bloqueado` FALSE 30
#ASSERT `art. 21-B, § 1º — o crédito do benefício é bloqueado` FALSE 31
#ASSERT NOT `art. 21-B, § 1º — o crédito do benefício é bloqueado` FALSE 29
#ASSERT NOT `art. 21-B, § 1º — o crédito do benefício é bloqueado` TRUE 60
-- § 2º: suspension if not regularised AND knowledge of the notification is proven
#ASSERT `art. 21-B, § 2º — o benefício é suspenso` FALSE TRUE
#ASSERT NOT `art. 21-B, § 2º — o benefício é suspenso` FALSE FALSE
#ASSERT NOT `art. 21-B, § 2º — o benefício é suspenso` TRUE TRUE
-- § 3º: regularisation until the end of the suspension period does not prejudice the payment
#ASSERT NOT `art. 21-B, § 3º — a regularização feita nesse dia prejudica o pagamento do benefício` (Date 10 5 2026) (Date 10 5 2026)
#ASSERT NOT `art. 21-B, § 3º — a regularização feita nesse dia prejudica o pagamento do benefício` (Date 1 5 2026) (Date 10 5 2026)
#ASSERT `art. 21-B, § 3º — a regularização feita nesse dia prejudica o pagamento do benefício` (Date 11 5 2026) (Date 10 5 2026)

§§ `Art. 40-C — débitos`

#ASSERT `art. 40-C — o débito pode ser consignado no valor mensal do benefício` TRUE TRUE
#ASSERT NOT `art. 40-C — o débito pode ser consignado no valor mensal do benefício` TRUE FALSE
#ASSERT NOT `art. 40-C — o débito pode ser consignado no valor mensal do benefício` FALSE TRUE
