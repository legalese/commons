    `vive sob o mesmo teto que o requerente` IS TRUE
    `solteiro ou solteira` IS TRUE
    `menor de idade` IS TRUE
    `falta o pai ou a mãe do requerente` IS FALSE

`tutelado maior de idade morando na casa` MEANS `Pessoa ligada ao requerente` WITH
