#ASSERT `art. 142, caput — a tabela se aplica ao segurado e à aposentadoria` NOTHING TRUE `aposentadoria por tempo de contribuição`
#ASSERT NOT `art. 142, caput — a tabela se aplica ao segurado e à aposentadoria` NOTHING FALSE `aposentadoria por idade`
#ASSERT NOT `art. 142, caput — a tabela se aplica ao segurado e à aposentadoria` (JUST (YearMonthDay 1991 7 25)) FALSE `aposentadoria por idade`
#ASSERT NOT `art. 142, caput — a tabela se aplica ao segurado e à aposentadoria` (JUST (YearMonthDay 1991 7 24)) FALSE `aposentadoria por invalidez`
#ASSERT NOT `art. 142, caput — a tabela se aplica ao segurado e à aposentadoria` NOTHING TRUE `auxílio-doença`
