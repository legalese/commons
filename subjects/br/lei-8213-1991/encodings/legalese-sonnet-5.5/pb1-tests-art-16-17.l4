IMPORT `pb-core`
IMPORT `pb1-art-16-17-dependentes-inscricao`

-- pb1-tests-art-16-17.l4: tests of arts. 16 and 17 (dependants and inscriptions). Every expected value
-- is worked out by hand from the text (art. 16: src:260-285; art. 17: src:289-304) and written beside
-- the assertion; none is copied from the output of the rules.

§ `Testes dos arts. 16 e 17`

§§ `Fixtures`

-- A dependant built from the facts art. 16 reads: kinship, age on the relevant date, emancipated,
-- invalid, intellectual or mental disability or grave disability, proved economic dependence.
GIVEN `o parentesco` IS A `Parentesco com o segurado`
      `a idade` IS A NUMBER
      `emancipado` IS A BOOLEAN
      `inválido` IS A BOOLEAN
      `deficiente` IS A BOOLEAN
      `dependência provada` IS A BOOLEAN
GIVETH A Dependente
`um dependente de teste` `o parentesco` `a idade` `emancipado` `inválido` `deficiente` `dependência provada` MEANS
    Dependente WITH
        `parentesco` IS `o parentesco`
        `idade em anos completos` IS `a idade`
        `emancipado` IS `emancipado`
        `inválido` IS `inválido`
        `deficiência intelectual ou mental ou deficiência grave` IS `deficiente`
        `dependência econômica comprovada` IS `dependência provada`

-- No special circumstance: nothing declared, no union, no marriage, no conviction, no earlier class.
`nenhuma circunstância especial` MEANS
    `Circunstâncias do dependente (art. 16)` WITH
        `declaração do segurado` IS FALSE
        `sem condições suficientes para o próprio sustento e educação` IS FALSE
        `casada ou casado com outra pessoa` IS FALSE
        `união estável com o segurado` IS FALSE
        `condenação criminal transitada em julgado por homicídio doloso ou tentativa contra o segurado` IS FALSE
        `absolutamente incapaz` IS FALSE
        `inimputável` IS FALSE
        `existe dependente da classe do inciso I do art. 16` IS FALSE
        `existe dependente da classe do inciso II do art. 16` IS FALSE

-- The same, with a stable union with the insured and no marriage to another person (§ 3).
`união estável sem casamento` MEANS
    `Circunstâncias do dependente (art. 16)` WITH
        `declaração do segurado` IS FALSE
        `sem condições suficientes para o próprio sustento e educação` IS FALSE
        `casada ou casado com outra pessoa` IS FALSE
        `união estável com o segurado` IS TRUE
        `condenação criminal transitada em julgado por homicídio doloso ou tentativa contra o segurado` IS FALSE
        `absolutamente incapaz` IS FALSE
        `inimputável` IS FALSE
        `existe dependente da classe do inciso I do art. 16` IS FALSE
        `existe dependente da classe do inciso II do art. 16` IS FALSE

-- The same, with a stable union but the person is married to someone else (§ 3: "sem ser casada").
`união estável com pessoa casada` MEANS
    `Circunstâncias do dependente (art. 16)` WITH
        `declaração do segurado` IS FALSE
        `sem condições suficientes para o próprio sustento e educação` IS FALSE
        `casada ou casado com outra pessoa` IS TRUE
        `união estável com o segurado` IS TRUE
        `condenação criminal transitada em julgado por homicídio doloso ou tentativa contra o segurado` IS FALSE
        `absolutamente incapaz` IS FALSE
        `inimputável` IS FALSE
        `existe dependente da classe do inciso I do art. 16` IS FALSE
        `existe dependente da classe do inciso II do art. 16` IS FALSE

-- The insured declared the minor (§ 2) and the minor lacks sufficient means.
`declaração e falta de meios` MEANS
    `Circunstâncias do dependente (art. 16)` WITH
        `declaração do segurado` IS TRUE
        `sem condições suficientes para o próprio sustento e educação` IS TRUE
        `casada ou casado com outra pessoa` IS FALSE
        `união estável com o segurado` IS FALSE
        `condenação criminal transitada em julgado por homicídio doloso ou tentativa contra o segurado` IS FALSE
        `absolutamente incapaz` IS FALSE
        `inimputável` IS FALSE
        `existe dependente da classe do inciso I do art. 16` IS FALSE
        `existe dependente da classe do inciso II do art. 16` IS FALSE

-- The insured declared the minor but the minor has sufficient means (§ 2 not met).
`declaração mas com meios suficientes` MEANS
    `Circunstâncias do dependente (art. 16)` WITH
        `declaração do segurado` IS TRUE
        `sem condições suficientes para o próprio sustento e educação` IS FALSE
        `casada ou casado com outra pessoa` IS FALSE
        `união estável com o segurado` IS FALSE
        `condenação criminal transitada em julgado por homicídio doloso ou tentativa contra o segurado` IS FALSE
        `absolutamente incapaz` IS FALSE
        `inimputável` IS FALSE
        `existe dependente da classe do inciso I do art. 16` IS FALSE
        `existe dependente da classe do inciso II do art. 16` IS FALSE

-- Lacks means but the insured made no declaration (§ 2 not met).
`falta de meios sem declaração` MEANS
    `Circunstâncias do dependente (art. 16)` WITH
        `declaração do segurado` IS FALSE
        `sem condições suficientes para o próprio sustento e educação` IS TRUE
        `casada ou casado com outra pessoa` IS FALSE
        `união estável com o segurado` IS FALSE
        `condenação criminal transitada em julgado por homicídio doloso ou tentativa contra o segurado` IS FALSE
        `absolutamente incapaz` IS FALSE
        `inimputável` IS FALSE
        `existe dependente da classe do inciso I do art. 16` IS FALSE
        `existe dependente da classe do inciso II do art. 16` IS FALSE

-- A dependant convicted of an intentional homicide against the insured, not incapable, imputable (§ 7).
`condenado por homicídio` MEANS
    `Circunstâncias do dependente (art. 16)` WITH
        `declaração do segurado` IS FALSE
        `sem condições suficientes para o próprio sustento e educação` IS FALSE
        `casada ou casado com outra pessoa` IS FALSE
        `união estável com o segurado` IS FALSE
        `condenação criminal transitada em julgado por homicídio doloso ou tentativa contra o segurado` IS TRUE
        `absolutamente incapaz` IS FALSE
        `inimputável` IS FALSE
        `existe dependente da classe do inciso I do art. 16` IS FALSE
        `existe dependente da classe do inciso II do art. 16` IS FALSE

-- Convicted but absolutely incapable (§ 7 excepts them).
`condenado mas absolutamente incapaz` MEANS
    `Circunstâncias do dependente (art. 16)` WITH
        `declaração do segurado` IS FALSE
        `sem condições suficientes para o próprio sustento e educação` IS FALSE
        `casada ou casado com outra pessoa` IS FALSE
        `união estável com o segurado` IS FALSE
        `condenação criminal transitada em julgado por homicídio doloso ou tentativa contra o segurado` IS TRUE
        `absolutamente incapaz` IS TRUE
        `inimputável` IS FALSE
        `existe dependente da classe do inciso I do art. 16` IS FALSE
        `existe dependente da classe do inciso II do art. 16` IS FALSE

-- Convicted but inimputável (§ 7 excepts them).
`condenado mas inimputável` MEANS
    `Circunstâncias do dependente (art. 16)` WITH
        `declaração do segurado` IS FALSE
        `sem condições suficientes para o próprio sustento e educação` IS FALSE
        `casada ou casado com outra pessoa` IS FALSE
        `união estável com o segurado` IS FALSE
        `condenação criminal transitada em julgado por homicídio doloso ou tentativa contra o segurado` IS TRUE
        `absolutamente incapaz` IS FALSE
        `inimputável` IS TRUE
        `existe dependente da classe do inciso I do art. 16` IS FALSE
        `existe dependente da classe do inciso II do art. 16` IS FALSE

-- There is a dependant of the class of inciso I (§ 1).
`existe dependente da classe I` MEANS
    `Circunstâncias do dependente (art. 16)` WITH
        `declaração do segurado` IS FALSE
        `sem condições suficientes para o próprio sustento e educação` IS FALSE
        `casada ou casado com outra pessoa` IS FALSE
        `união estável com o segurado` IS FALSE
        `condenação criminal transitada em julgado por homicídio doloso ou tentativa contra o segurado` IS FALSE
        `absolutamente incapaz` IS FALSE
        `inimputável` IS FALSE
        `existe dependente da classe do inciso I do art. 16` IS TRUE
        `existe dependente da classe do inciso II do art. 16` IS FALSE

-- There is a dependant of the class of inciso II but none of inciso I (§ 1).
`existe dependente da classe II` MEANS
    `Circunstâncias do dependente (art. 16)` WITH
        `declaração do segurado` IS FALSE
        `sem condições suficientes para o próprio sustento e educação` IS FALSE
        `casada ou casado com outra pessoa` IS FALSE
        `união estável com o segurado` IS FALSE
        `condenação criminal transitada em julgado por homicídio doloso ou tentativa contra o segurado` IS FALSE
        `absolutamente incapaz` IS FALSE
        `inimputável` IS FALSE
        `existe dependente da classe do inciso I do art. 16` IS FALSE
        `existe dependente da classe do inciso II do art. 16` IS TRUE

§§ `As classes: inciso I (cônjuge, companheiro, filho), inciso II (pais), inciso III (irmão)`

-- Inciso I: a spouse is of the class whatever the age (45 here): the qualifiers belong to the filho (FORK pb1-F-3).
#ASSERT `art. 16, § 1º — classe a que pertence o dependente` (`um dependente de teste` `cônjuge` 45 FALSE FALSE FALSE FALSE) `nenhuma circunstância especial` EQUALS JUST `classe do inciso I do art. 16`
-- A filho of 20, not emancipated: under 21, class I.
#ASSERT `art. 16, § 1º — classe a que pertence o dependente` (`um dependente de teste` `filho` 20 FALSE FALSE FALSE FALSE) `nenhuma circunstância especial` EQUALS JUST `classe do inciso I do art. 16`
-- A filho of 21, not invalid, no disability: "menor de 21" is not met, so no class (NOTHING).
#ASSERT `art. 16, § 1º — classe a que pertence o dependente` (`um dependente de teste` `filho` 21 FALSE FALSE FALSE FALSE) `nenhuma circunstância especial` EQUALS NOTHING
-- A filho of 21 who is invalid: class I.
#ASSERT `art. 16, § 1º — classe a que pertence o dependente` (`um dependente de teste` `filho` 21 FALSE TRUE FALSE FALSE) `nenhuma circunstância especial` EQUALS JUST `classe do inciso I do art. 16`
-- A filho of 40 with an intellectual or mental disability or a grave disability: class I.
#ASSERT `art. 16, § 1º — classe a que pertence o dependente` (`um dependente de teste` `filho` 40 FALSE FALSE TRUE FALSE) `nenhuma circunstância especial` EQUALS JUST `classe do inciso I do art. 16`
-- An emancipated filho of 20: "não emancipado" is not met, so NOTHING.
#ASSERT `art. 16, § 1º — classe a que pertence o dependente` (`um dependente de teste` `filho` 20 TRUE FALSE FALSE FALSE) `nenhuma circunstância especial` EQUALS NOTHING
-- An emancipated, invalid filho of 30: still emancipated, so NOTHING.
#ASSERT `art. 16, § 1º — classe a que pertence o dependente` (`um dependente de teste` `filho` 30 TRUE TRUE FALSE FALSE) `nenhuma circunstância especial` EQUALS NOTHING
-- § 3: a partner in a stable union, not married to another person: class I.
#ASSERT `art. 16, § 1º — classe a que pertence o dependente` (`um dependente de teste` `companheiro ou companheira` 50 FALSE FALSE FALSE FALSE) `união estável sem casamento` EQUALS JUST `classe do inciso I do art. 16`
-- § 3: a partner who is married to another person: not a companheiro, NOTHING.
#ASSERT `art. 16, § 1º — classe a que pertence o dependente` (`um dependente de teste` `companheiro ou companheira` 50 FALSE FALSE FALSE FALSE) `união estável com pessoa casada` EQUALS NOTHING
-- § 3: a "partner" with no stable union: NOTHING.
#ASSERT `art. 16, § 1º — classe a que pertence o dependente` (`um dependente de teste` `companheiro ou companheira` 50 FALSE FALSE FALSE FALSE) `nenhuma circunstância especial` EQUALS NOTHING
-- § 2: an enteado of 10, declared by the insured and lacking means: equated to a filho, class I.
#ASSERT `art. 16, § 1º — classe a que pertence o dependente` (`um dependente de teste` `enteado` 10 FALSE FALSE FALSE FALSE) `declaração e falta de meios` EQUALS JUST `classe do inciso I do art. 16`
-- § 2: a minor under guardianship, same facts: class I.
#ASSERT `art. 16, § 1º — classe a que pertence o dependente` (`um dependente de teste` `menor sob tutela` 10 FALSE FALSE FALSE FALSE) `declaração e falta de meios` EQUALS JUST `classe do inciso I do art. 16`
-- § 2: a minor in judicial custody, same facts: class I.
#ASSERT `art. 16, § 1º — classe a que pertence o dependente` (`um dependente de teste` `menor sob guarda judicial` 10 FALSE FALSE FALSE FALSE) `declaração e falta de meios` EQUALS JUST `classe do inciso I do art. 16`
-- § 2: an enteado with sufficient means: not equated, NOTHING.
#ASSERT `art. 16, § 1º — classe a que pertence o dependente` (`um dependente de teste` `enteado` 10 FALSE FALSE FALSE FALSE) `declaração mas com meios suficientes` EQUALS NOTHING
-- § 2: an enteado lacking means but with no declaration of the insured: NOTHING.
#ASSERT `art. 16, § 1º — classe a que pertence o dependente` (`um dependente de teste` `enteado` 10 FALSE FALSE FALSE FALSE) `falta de meios sem declaração` EQUALS NOTHING
-- § 2: an equated enteado of 21 is held to the conditions of the filho (not under 21): NOTHING.
#ASSERT `art. 16, § 1º — classe a que pertence o dependente` (`um dependente de teste` `enteado` 21 FALSE FALSE FALSE FALSE) `declaração e falta de meios` EQUALS NOTHING
-- Inciso II: the parents.
#ASSERT `art. 16, § 1º — classe a que pertence o dependente` (`um dependente de teste` `pai ou mãe` 60 FALSE FALSE FALSE FALSE) `nenhuma circunstância especial` EQUALS JUST `classe do inciso II do art. 16`
-- Inciso III: a brother of 20, not emancipated.
#ASSERT `art. 16, § 1º — classe a que pertence o dependente` (`um dependente de teste` `irmão` 20 FALSE FALSE FALSE FALSE) `nenhuma circunstância especial` EQUALS JUST `classe do inciso III do art. 16`
-- Inciso III: a brother of 21, not invalid: NOTHING.
#ASSERT `art. 16, § 1º — classe a que pertence o dependente` (`um dependente de teste` `irmão` 21 FALSE FALSE FALSE FALSE) `nenhuma circunstância especial` EQUALS NOTHING
-- Inciso III: a brother of 35 who is invalid: class III.
#ASSERT `art. 16, § 1º — classe a que pertence o dependente` (`um dependente de teste` `irmão` 35 FALSE TRUE FALSE FALSE) `nenhuma circunstância especial` EQUALS JUST `classe do inciso III do art. 16`
-- Inciso III: an emancipated brother of 15: NOTHING.
#ASSERT `art. 16, § 1º — classe a que pertence o dependente` (`um dependente de teste` `irmão` 15 TRUE FALSE FALSE FALSE) `nenhuma circunstância especial` EQUALS NOTHING

§§ `§ 4º: a dependência econômica; § 7º: a exclusão; quem é dependente`

-- § 4: presumed for a spouse of class I, without any proof.
#ASSERT `art. 16, § 4º — a dependência econômica está satisfeita` (`um dependente de teste` `cônjuge` 45 FALSE FALSE FALSE FALSE) `nenhuma circunstância especial`
-- § 4: a parent must prove it: not proved, not satisfied.
#ASSERT NOT (`art. 16, § 4º — a dependência econômica está satisfeita` (`um dependente de teste` `pai ou mãe` 60 FALSE FALSE FALSE FALSE) `nenhuma circunstância especial`)
-- § 4: a parent who proved it: satisfied.
#ASSERT `art. 16, § 4º — a dependência econômica está satisfeita` (`um dependente de teste` `pai ou mãe` 60 FALSE FALSE FALSE TRUE) `nenhuma circunstância especial`
-- § 7: convicted of the homicide, not incapable: excluded for good.
#ASSERT `art. 16, § 7º — foi excluído definitivamente da condição de dependente` `condenado por homicídio`
-- § 7: convicted but absolutely incapable: not excluded.
#ASSERT NOT (`art. 16, § 7º — foi excluído definitivamente da condição de dependente` `condenado mas absolutamente incapaz`)
-- § 7: convicted but inimputável: not excluded.
#ASSERT NOT (`art. 16, § 7º — foi excluído definitivamente da condição de dependente` `condenado mas inimputável`)
-- § 7: not convicted: not excluded.
#ASSERT NOT (`art. 16, § 7º — foi excluído definitivamente da condição de dependente` `nenhuma circunstância especial`)
-- A spouse is a dependant.
#ASSERT `art. 16 — a pessoa é dependente do segurado` (`um dependente de teste` `cônjuge` 45 FALSE FALSE FALSE FALSE) `nenhuma circunstância especial`
-- A spouse convicted of the homicide of the insured is no longer a dependant (§ 7).
#ASSERT NOT (`art. 16 — a pessoa é dependente do segurado` (`um dependente de teste` `cônjuge` 45 FALSE FALSE FALSE FALSE) `condenado por homicídio`)
-- A spouse convicted but inimputável stays a dependant.
#ASSERT `art. 16 — a pessoa é dependente do segurado` (`um dependente de teste` `cônjuge` 45 FALSE FALSE FALSE FALSE) `condenado mas inimputável`
-- A parent without proved dependence is not a dependant (§ 4).
#ASSERT NOT (`art. 16 — a pessoa é dependente do segurado` (`um dependente de teste` `pai ou mãe` 60 FALSE FALSE FALSE FALSE) `nenhuma circunstância especial`)
-- A parent with proved dependence is a dependant.
#ASSERT `art. 16 — a pessoa é dependente do segurado` (`um dependente de teste` `pai ou mãe` 60 FALSE FALSE FALSE TRUE) `nenhuma circunstância especial`
-- A filho of 21 without a disability is no dependant (outside the encoding of the classes).
#ASSERT NOT (`art. 16 — a pessoa é dependente do segurado` (`um dependente de teste` `filho` 21 FALSE FALSE FALSE FALSE) `nenhuma circunstância especial`)

§§ `§ 1º: a classe anterior exclui os direitos das classes seguintes`

-- A spouse (class I) has the right whatever else exists.
#ASSERT `art. 16, § 1º — o dependente tem direito às prestações` (`um dependente de teste` `cônjuge` 45 FALSE FALSE FALSE FALSE) `existe dependente da classe I`
-- A parent with proved dependence, with no dependant of class I: has the right.
#ASSERT `art. 16, § 1º — o dependente tem direito às prestações` (`um dependente de teste` `pai ou mãe` 60 FALSE FALSE FALSE TRUE) `nenhuma circunstância especial`
-- The same parent when a dependant of class I exists: no right.
#ASSERT NOT (`art. 16, § 1º — o dependente tem direito às prestações` (`um dependente de teste` `pai ou mãe` 60 FALSE FALSE FALSE TRUE) `existe dependente da classe I`)
-- A brother of 20, with proved dependence and no dependant of class I or II: has the right.
#ASSERT `art. 16, § 1º — o dependente tem direito às prestações` (`um dependente de teste` `irmão` 20 FALSE FALSE FALSE TRUE) `nenhuma circunstância especial`
-- The same brother when a dependant of class I exists: no right.
#ASSERT NOT (`art. 16, § 1º — o dependente tem direito às prestações` (`um dependente de teste` `irmão` 20 FALSE FALSE FALSE TRUE) `existe dependente da classe I`)
-- The same brother when a dependant of class II exists (and none of I): no right.
#ASSERT NOT (`art. 16, § 1º — o dependente tem direito às prestações` (`um dependente de teste` `irmão` 20 FALSE FALSE FALSE TRUE) `existe dependente da classe II`)
-- A person who is no dependant has no right (a filho of 21 without disability).
#ASSERT NOT (`art. 16, § 1º — o dependente tem direito às prestações` (`um dependente de teste` `filho` 21 FALSE FALSE FALSE FALSE) `nenhuma circunstância especial`)

§§ `§ 5º: a prova da união estável e da dependência econômica`

-- Material proof produced on 1 June 2024, death on 31 May 2026: 24 months after the proof is 1 June 2026, not before the death: admitted.
#ASSERT `art. 16, § 5º — a prova da união estável e da dependência econômica é admitida` TRUE (YearMonthDay 2024 6 1) (YearMonthDay 2026 5 31) FALSE FALSE
-- Boundary: proof produced on 31 May 2024, death on 31 May 2026: exactly 24 months, admitted.
#ASSERT `art. 16, § 5º — a prova da união estável e da dependência econômica é admitida` TRUE (YearMonthDay 2024 5 31) (YearMonthDay 2026 5 31) FALSE FALSE
-- One day outside: proof of 30 May 2024, death on 31 May 2026, more than 24 months before: not admitted.
#ASSERT NOT (`art. 16, § 5º — a prova da união estável e da dependência econômica é admitida` TRUE (YearMonthDay 2024 5 30) (YearMonthDay 2026 5 31) FALSE FALSE)
-- Proof produced after the death is not "anterior à data do óbito": not admitted.
#ASSERT NOT (`art. 16, § 5º — a prova da união estável e da dependência econômica é admitida` TRUE (YearMonthDay 2026 6 1) (YearMonthDay 2026 5 31) FALSE FALSE)
-- Exclusively testimonial proof, no force majeure: not admitted.
#ASSERT NOT (`art. 16, § 5º — a prova da união estável e da dependência econômica é admitida` FALSE (YearMonthDay 2026 1 1) (YearMonthDay 2026 5 31) TRUE FALSE)
-- Exclusively testimonial proof in a case of force majeure or fortuitous event: admitted.
#ASSERT `art. 16, § 5º — a prova da união estável e da dependência econômica é admitida` FALSE (YearMonthDay 2026 1 1) (YearMonthDay 2026 5 31) TRUE TRUE
-- No proof at all, no force majeure: not admitted.
#ASSERT NOT (`art. 16, § 5º — a prova da união estável e da dependência econômica é admitida` FALSE (YearMonthDay 2026 1 1) (YearMonthDay 2026 5 31) FALSE FALSE)

§§ `§ 6º: união estável por pelo menos 2 anos antes do óbito`

-- Not the case of art. 77 § 2, V, c: the extra requirement does not apply.
#ASSERT `art. 16, § 6º — a prova da união estável por pelo menos 2 anos antes do óbito é suficiente` FALSE (YearMonthDay 2026 1 1) (YearMonthDay 2026 1 15)
-- The case of art. 77 § 2 V c, union since 15 January 2024, death on 15 January 2026: exactly 2 years, sufficient.
#ASSERT `art. 16, § 6º — a prova da união estável por pelo menos 2 anos antes do óbito é suficiente` TRUE (YearMonthDay 2024 1 15) (YearMonthDay 2026 1 15)
-- One day short: union since 16 January 2024, death on 15 January 2026: not sufficient.
#ASSERT NOT (`art. 16, § 6º — a prova da união estável por pelo menos 2 anos antes do óbito é suficiente` TRUE (YearMonthDay 2024 1 16) (YearMonthDay 2026 1 15))

§§ `Art. 17: as inscrições`

-- § 1: no inscription at all: the duty is not met.
#ASSERT NOT (`art. 17, § 1º — o dependente cumpriu o dever de promover a sua inscrição quando do requerimento do benefício` NOTHING (YearMonthDay 2026 3 10))
-- § 1: inscription on the day of the request: met.
#ASSERT `art. 17, § 1º — o dependente cumpriu o dever de promover a sua inscrição quando do requerimento do benefício` (JUST (YearMonthDay 2026 3 10)) (YearMonthDay 2026 3 10)
-- § 1: inscription the day before the request: met (fork pb1-F-5).
#ASSERT `art. 17, § 1º — o dependente cumpriu o dever de promover a sua inscrição quando do requerimento do benefício` (JUST (YearMonthDay 2026 3 9)) (YearMonthDay 2026 3 10)
-- § 1: inscription the day after the request: not met.
#ASSERT NOT (`art. 17, § 1º — o dependente cumpriu o dever de promover a sua inscrição quando do requerimento do benefício` (JUST (YearMonthDay 2026 3 11)) (YearMonthDay 2026 3 10))
-- § 4: all the contents present, with a person responsible for the group who is identified: met.
#ASSERT `art. 17, § 4º — a inscrição do segurado especial contém o que a Lei exige` TRUE TRUE TRUE TRUE TRUE TRUE
-- § 4: no person responsible for the group, so no identification needed: met.
#ASSERT `art. 17, § 4º — a inscrição do segurado especial contém o que a Lei exige` TRUE TRUE TRUE TRUE FALSE FALSE
-- § 4: there is a person responsible for the group but not identified: not met.
#ASSERT NOT (`art. 17, § 4º — a inscrição do segurado especial contém o que a Lei exige` TRUE TRUE TRUE TRUE TRUE FALSE)
-- § 4: the link to the family group is missing: not met.
#ASSERT NOT (`art. 17, § 4º — a inscrição do segurado especial contém o que a Lei exige` FALSE TRUE TRUE TRUE FALSE FALSE)
-- § 4: the property is not identified: not met.
#ASSERT NOT (`art. 17, § 4º — a inscrição do segurado especial contém o que a Lei exige` TRUE TRUE FALSE TRUE FALSE FALSE)
-- § 5: a member of a group that is not the owner and informed the grantor's name: met.
#ASSERT `art. 17, § 5º — o segurado especial cumpriu o dever de informar no ato da inscrição o nome do outorgante` TRUE FALSE TRUE
-- § 5: a member of a group that is not the owner and did not inform: not met.
#ASSERT NOT (`art. 17, § 5º — o segurado especial cumpriu o dever de informar no ato da inscrição o nome do outorgante` TRUE FALSE FALSE)
-- § 5: the group owns the property: the duty does not arise, so met.
#ASSERT `art. 17, § 5º — o segurado especial cumpriu o dever de informar no ato da inscrição o nome do outorgante` TRUE TRUE FALSE
-- § 5: no group: the duty does not arise, so met.
#ASSERT `art. 17, § 5º — o segurado especial cumpriu o dever de informar no ato da inscrição o nome do outorgante` FALSE FALSE FALSE
-- § 7: a contribuinte individual inscribed after the death: barred.
#ASSERT `art. 17, § 7º — a inscrição post mortem é vedada` `segurado contribuinte individual` TRUE
-- § 7: a facultativo inscribed after the death: barred.
#ASSERT `art. 17, § 7º — a inscrição post mortem é vedada` `segurado facultativo` TRUE
-- § 7: an empregado inscribed after the death: the bar does not apply.
#ASSERT NOT (`art. 17, § 7º — a inscrição post mortem é vedada` `segurado empregado` TRUE)
-- § 7: a contribuinte individual inscribed while alive: the bar does not apply.
#ASSERT NOT (`art. 17, § 7º — a inscrição post mortem é vedada` `segurado contribuinte individual` FALSE)
