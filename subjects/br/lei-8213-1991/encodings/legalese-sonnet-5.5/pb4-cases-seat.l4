IMPORT `pb-core`
IMPORT `pb4-tipos`
IMPORT `pb4-seat`

-- pb4-cases-seat.l4: worked cases for the seat layer (pb4-seat.l4), at least one per question, with the facts a real
-- person in the seat would state. Every expected value is written by hand from the text of the Law, beside the case.

§ `Casos — as perguntas de quem é segurado ou dependente`


§§ `Auxílio-acidente (art. 86)`

-- Carlos broke a leg in a car accident, the lesions have consolidated, and he can no longer do his habitual job: entitled.
#ASSERT `Tenho direito ao auxílio-acidente (art. 86)` TRUE TRUE TRUE FALSE FALSE FALSE
-- Marta lost hearing at work, the link to work is recognised and the reduction is proven: entitled (art. 86 s4 met).
#ASSERT `Tenho direito ao auxílio-acidente (art. 86)` TRUE TRUE TRUE TRUE TRUE TRUE
-- Paulo lost hearing but the link between the work and the disease was not recognised: not entitled.
#ASSERT NOT (`Tenho direito ao auxílio-acidente (art. 86)` TRUE TRUE TRUE TRUE FALSE TRUE)
-- Rita has a disease and no accident: not entitled.
#ASSERT NOT (`Tenho direito ao auxílio-acidente (art. 86)` FALSE TRUE TRUE FALSE FALSE FALSE)

-- Carlos has a salário-de-benefício of R$ 2,000.00: the auxílio-acidente is fifty per cent, R$ 1,000.00.
#ASSERT `Quanto recebo por mês de auxílio-acidente (art. 86, § 1º)` 2_000 EQUALS 1_000
-- Marta has R$ 3,333.33: fifty per cent is R$ 1,666.665 (the text states no rounding).
#ASSERT `Quanto recebo por mês de auxílio-acidente (art. 86, § 1º)` 3_333.33 EQUALS 1_666.665

-- Carlos has no retirement and is alive: the text fixes no end date (NOTHING).
#ASSERT `Até quando recebo o auxílio-acidente (art. 86, § 1º)` FALSE (YearMonthDay 2000 1 1) FALSE (YearMonthDay 2000 1 1) EQUALS NOTHING
-- Marta retires on 15 March 2030: the benefit is due until the eve, 14 March 2030.
#ASSERT `Até quando recebo o auxílio-acidente (art. 86, § 1º)` TRUE (YearMonthDay 2030 3 15) FALSE (YearMonthDay 2000 1 1) EQUALS JUST (YearMonthDay 2030 3 14)
-- Paulo died on 10 January 2029 with no retirement: due until the date of death.
#ASSERT `Até quando recebo o auxílio-acidente (art. 86, § 1º)` FALSE (YearMonthDay 2000 1 1) TRUE (YearMonthDay 2029 1 10) EQUALS JUST (YearMonthDay 2029 1 10)

-- Carlos stopped receiving auxílio-doença on 28 February 2025: the auxílio-acidente is due from 1 March 2025.
#ASSERT `Desde quando recebo o auxílio-acidente (art. 86, § 2º)` (YearMonthDay 2025 2 28) EQUALS (YearMonthDay 2025 3 1)

-- Carlos retires by age: the accumulation with any aposentadoria is forbidden.
#ASSERT NOT (`Posso receber o auxílio-acidente junto com outra prestação (art. 86, § 2º)` `aposentadoria por idade`)
-- Marta receives a pensão por morte: not barred by art. 86 s2.
#ASSERT `Posso receber o auxílio-acidente junto com outra prestação (art. 86, § 2º)` `pensão por morte`

-- Carlos works and receives salary only: the auxílio-acidente goes on.
#ASSERT `O auxílio-acidente continua se eu receber salário ou outro benefício (art. 86, § 3º)` TRUE FALSE `auxílio-doença`
-- Marta begins an aposentadoria especial: the continuity is prejudiced.
#ASSERT NOT (`O auxílio-acidente continua se eu receber salário ou outro benefício (art. 86, § 3º)` FALSE TRUE `aposentadoria especial`)

§§ `Serviço Social (art. 88)`

-- Ana is insured: she may be clarified about her social rights.
#ASSERT `Tenho direito ao esclarecimento do Serviço Social (art. 88, caput)` TRUE
-- A person who is neither insured nor a dependant is not covered by the caput.
#ASSERT NOT (`Tenho direito ao esclarecimento do Serviço Social (art. 88, caput)` FALSE)

-- Carlos receives auxílio-doença (benefício por incapacidade temporária): priority.
#ASSERT `Tenho prioridade no atendimento do Serviço Social (art. 88, § 1º)` `auxílio-doença`
-- Marta receives an aposentadoria por idade: no priority by this paragraph.
#ASSERT NOT (`Tenho prioridade no atendimento do Serviço Social (art. 88, § 1º)` `aposentadoria por idade`)

-- Marta is a retiree: special attention.
#ASSERT `Tenho atenção especial do Serviço Social (art. 88, § 1º)` `aposentadoria especial`
-- Paulo is a pensioner: special attention.
#ASSERT `Tenho atenção especial do Serviço Social (art. 88, § 1º)` `pensão por morte`
-- Carlos receives auxílio-doença: priority, but no special attention by this paragraph.
#ASSERT NOT (`Tenho atenção especial do Serviço Social (art. 88, § 1º)` `auxílio-doença`)

-- Ana asks for legal assistance: it is one of the six means of § 2.
#ASSERT `O Serviço Social pode me ajudar com o meio (art. 88, § 2º)` `assistência de natureza jurídica`
-- Ana asks for material help: it is one of the six means of § 2.
#ASSERT `O Serviço Social pode me ajudar com o meio (art. 88, § 2º)` `ajuda material`

-- Carlos is in a public hospital where the Serviço Social acts, and the act's terms are met: he is owed the guidance.
#ASSERT `Tenho direito à orientação do Serviço Social no hospital (art. 88, § 5º)` TRUE TRUE TRUE
-- The hospital has no Serviço Social: nothing is owed under § 5.
#ASSERT NOT (`Tenho direito à orientação do Serviço Social no hospital (art. 88, § 5º)` TRUE FALSE TRUE)

§§ `Habilitação, reabilitação profissional e reserva de cargos (arts. 89 a 93)`

-- Carlos is partly unable to work: entitled.
#ASSERT `Tenho direito aos meios de habilitação e reabilitação (art. 89, caput)` TRUE FALSE
-- Ana has a disability: entitled.
#ASSERT `Tenho direito aos meios de habilitação e reabilitação (art. 89, caput)` FALSE TRUE
-- A healthy worker with no disability is not covered.
#ASSERT NOT (`Tenho direito aos meios de habilitação e reabilitação (art. 89, caput)` FALSE FALSE)

-- Carlos is insured: the rehabilitation is due, obligatorily.
#ASSERT `A reabilitação profissional me é devida (art. 90)` TRUE FALSE FALSE
-- Ana is a dependant and the body can provide it: due.
#ASSERT `A reabilitação profissional me é devida (art. 90)` FALSE TRUE TRUE
-- Ana is a dependant but the body cannot: not due.
#ASSERT NOT (`A reabilitação profissional me é devida (art. 90)` FALSE TRUE FALSE)

-- Ana's prosthesis can attenuate her loss of function: comprised.
#ASSERT `A reabilitação profissional compreende o item (art. 89, parágrafo único)` `aparelho de prótese, órtese ou instrumento de auxílio para locomoção` TRUE FALSE FALSE FALSE FALSE
-- Carlos, a work-accident victim, needs transport: comprised.
#ASSERT `A reabilitação profissional compreende o item (art. 89, parágrafo único)` `transporte do acidentado do trabalho` FALSE FALSE FALSE TRUE TRUE
-- Paulo needs transport but the accident was not a work accident: not comprised.
#ASSERT NOT (`A reabilitação profissional compreende o item (art. 89, parágrafo único)` `transporte do acidentado do trabalho` FALSE FALSE FALSE TRUE FALSE)

-- Carlos is in rehabilitation and must travel to another city for an exam; the Regulamento admits the aid: entitled.
#ASSERT `Tenho direito ao auxílio para tratamento ou exame fora do domicílio (art. 91)` TRUE TRUE TRUE
-- The exam is in his own city: no aid.
#ASSERT NOT (`Tenho direito ao auxílio para tratamento ou exame fora do domicílio (art. 91)` TRUE FALSE TRUE)

-- Carlos has finished his rehabilitation: he is owed the certificate.
#ASSERT `Tenho direito ao certificado individual (art. 92)` TRUE
-- Ana is still in the process: not yet.
#ASSERT NOT (`Tenho direito ao certificado individual (art. 92)` FALSE)

-- Carlos trained as a driver after rehabilitation: nothing prevents him from working as one.
#ASSERT `Posso exercer outra atividade para a qual me capacitei (art. 92)` TRUE

-- Ana, with a disability, is dismissed without cause and the firm has hired no replacement: it may not (JUST FALSE).
#ASSERT `Minha empresa pode me dispensar agora (art. 93, § 1º)` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
-- Same, but the firm already hired a replacement: it may (JUST TRUE).
#ASSERT `Minha empresa pode me dispensar agora (art. 93, § 1º)` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
-- Paulo is dismissed for cause: the paragraph says nothing (NOTHING).
#ASSERT `Minha empresa pode me dispensar agora (art. 93, § 1º)` TRUE FALSE FALSE FALSE EQUALS NOTHING

-- A firm with 150 employees and 1,000 posts: 2% of the posts, 20.
#ASSERT `Quantos cargos minha empresa deve reservar (art. 93)` 150 1_000 EQUALS JUST 20
-- A firm with 1,500 employees and 3,000 posts: 5%, 150.
#ASSERT `Quantos cargos minha empresa deve reservar (art. 93)` 1_500 3_000 EQUALS JUST 150
-- A firm with 50 employees: the article does not oblige it (NOTHING).
#ASSERT `Quantos cargos minha empresa deve reservar (art. 93)` 50 400 EQUALS NOTHING

-- An interested citizen asks for the data: entitled.
#ASSERT `Tenho direito aos dados do Ministério sobre as vagas (art. 93, § 2º)` TRUE

-- Ana was hired directly as a person with disability: counts.
#ASSERT `Minha contratação conta para a reserva de cargos (art. 93, § 3º)` TRUE FALSE
-- Paulo is an apprentice with disability: does not count.
#ASSERT NOT (`Minha contratação conta para a reserva de cargos (art. 93, § 3º)` TRUE TRUE)

§§ `Contagem recíproca de tempo de serviço (arts. 94 a 99)`

-- Carlos worked in a private firm and in the public administration and asks for an RGPS benefit: assured.
#ASSERT `Tenho direito à contagem recíproca do meu tempo (art. 94, caput)` TRUE TRUE TRUE
-- Ana has neither kind of time: not assured.
#ASSERT NOT (`Tenho direito à contagem recíproca do meu tempo (art. 94, caput)` FALSE FALSE TRUE)

-- Carlos is linked to a regime próprio when he applies: that system grants, pays and calculates.
#ASSERT `Qual sistema concede e paga meu benefício com contagem recíproca (art. 99)` `regime próprio de previdência social` EQUALS `regime próprio de previdência social`
-- Ana is linked to the RGPS when she applies: the RGPS does.
#ASSERT `Qual sistema concede e paga meu benefício com contagem recíproca (art. 99)` `Regime Geral de Previdência Social` EQUALS `Regime Geral de Previdência Social`

-- Ana, a contribuinte individual, contributed at the reduced rate and did not complement it: her period is not computed.
#ASSERT NOT (`Meu período conta como tempo de contribuição no regime próprio (art. 94, § 2º)` `segurado contribuinte individual` TRUE TRUE FALSE)
-- The same, but she complemented the contributions under § 3: it is computed.
#ASSERT `Meu período conta como tempo de contribuição no regime próprio (art. 94, § 2º)` `segurado contribuinte individual` TRUE TRUE TRUE

-- Carlos has an ordinary period that the legislation admits: it can be counted.
#ASSERT `Posso contar este período na contagem recíproca (art. 96, caput e I a IV)` TRUE FALSE FALSE FALSE FALSE FALSE FALSE
-- Ana's period was counted double: it cannot be counted.
#ASSERT NOT (`Posso contar este período na contagem recíproca (art. 96, caput e I a IV)` TRUE TRUE FALSE FALSE FALSE FALSE FALSE)
-- Paulo's period is before compulsory affiliation and not indemnified: it cannot be counted yet.
#ASSERT NOT (`Posso contar este período na contagem recíproca (art. 96, caput e I a IV)` TRUE FALSE FALSE FALSE TRUE FALSE FALSE)
-- The same period, once indemnified: it can be counted.
#ASSERT `Posso contar este período na contagem recíproca (art. 96, caput e I a IV)` TRUE FALSE FALSE FALSE TRUE FALSE TRUE

-- Carlos owes R$ 1,000.00 for a period after compulsory affiliation, 12 months in default: 1,060 interest-bearing plus 100 fine = 1,160.
#ASSERT `Quanto devo pagar para indenizar o período (art. 96, IV e § 2º)` FALSE 1_000 12 EQUALS 1_160
-- Ana owes R$ 1,000.00 for a period before compulsory affiliation, 12 months: 1,060, no fine (art. 96 s2).
#ASSERT `Quanto devo pagar para indenizar o período (art. 96, IV e § 2º)` TRUE 1_000 12 EQUALS 1_060

-- Carlos, an employee, asks for a CTC with service time only: allowed (employee is excepted).
#ASSERT `Posso obter a CTC com registro exclusivo de tempo de serviço (art. 96, V e § 1º)` `segurado empregado` TRUE FALSE (YearMonthDay 2010 1 1) (YearMonthDay 2010 12 31) FALSE FALSE
-- Ana, a contribuinte individual, served from 31 March 2003 at a firm obliged to collect: not yet allowed.
#ASSERT NOT (`Posso obter a CTC com registro exclusivo de tempo de serviço (art. 96, V e § 1º)` `segurado contribuinte individual` TRUE FALSE (YearMonthDay 2003 3 31) (YearMonthDay 2003 12 31) TRUE FALSE)
-- The same from 1 April 2003: allowed.
#ASSERT `Posso obter a CTC com registro exclusivo de tempo de serviço (art. 96, V e § 1º)` `segurado contribuinte individual` TRUE FALSE (YearMonthDay 2003 4 1) (YearMonthDay 2003 12 31) TRUE FALSE
-- Paulo, a facultativo, served until 14 December 1998 and the time was equated by law to contribution time: allowed (art. 96 s1).
#ASSERT `Posso obter a CTC com registro exclusivo de tempo de serviço (art. 96, V e § 1º)` `segurado facultativo` TRUE FALSE (YearMonthDay 1990 1 1) (YearMonthDay 1998 12 14) FALSE TRUE

-- Carlos is an ex-servant and the regime próprio issues: allowed (JUST TRUE).
#ASSERT `O regime próprio pode emitir a minha CTC (art. 96, VI)` `regime próprio de previdência social` TRUE EQUALS JUST TRUE
-- Ana is not an ex-servant: the regime próprio may not issue (JUST FALSE).
#ASSERT `O regime próprio pode emitir a minha CTC (art. 96, VI)` `regime próprio de previdência social` FALSE EQUALS JUST FALSE
-- The RGPS issues: inciso VI says nothing (NOTHING).
#ASSERT `O regime próprio pode emitir a minha CTC (art. 96, VI)` `Regime Geral de Previdência Social` TRUE EQUALS NOTHING

-- Carlos asks the regime próprio to count his RGPS time but no CTC was issued: forbidden.
#ASSERT NOT (`Posso ter meu tempo contado pelo regime próprio sem a CTC (art. 96, VII)` TRUE FALSE)
-- Once the CTC is issued: allowed.
#ASSERT `Posso ter meu tempo contado pelo regime próprio sem a CTC (art. 96, VII)` TRUE TRUE

-- Carlos is a servant whose averbado time generated pay advantages: the desaverbação is forbidden.
#ASSERT NOT (`Posso pedir a desaverbação do meu tempo (art. 96, VIII)` TRUE TRUE)
-- If it generated none: allowed.
#ASSERT `Posso pedir a desaverbação do meu tempo (art. 96, VIII)` TRUE FALSE

-- Carlos's special time is included and itemised: met.
#ASSERT `Minha CTC atende ao requisito do tempo especial (art. 96, IX)` TRUE TRUE FALSE TRUE TRUE
-- Ana's special time is included but not itemised: not met.
#ASSERT NOT (`Minha CTC atende ao requisito do tempo especial (art. 96, IX)` TRUE TRUE FALSE TRUE FALSE)

-- Ana (feminino) has 300 months, 25 complete years: entitled.
#ASSERT `Tenho direito à aposentadoria por tempo de serviço com contagem recíproca (art. 97)` feminino 300 0
-- Ana has 299 months: not yet.
#ASSERT NOT (`Tenho direito à aposentadoria por tempo de serviço com contagem recíproca (art. 97)` feminino 299 0)
-- Carlos (masculino) has 360 months: entitled.
#ASSERT `Tenho direito à aposentadoria por tempo de serviço com contagem recíproca (art. 97)` masculino 360 0
-- Carlos has 300 months but a law reduces the requirement by 60 months: entitled.
#ASSERT `Tenho direito à aposentadoria por tempo de serviço com contagem recíproca (art. 97)` masculino 300 60

-- Ana (feminino) sums 400 months: only 360 (30 years) are considered; the excess does not count.
#ASSERT `Quantos meses de serviço são considerados (art. 98)` feminino 400 EQUALS 360
-- Carlos (masculino) sums 400 months: all 400 are considered (limit 420).
#ASSERT `Quantos meses de serviço são considerados (art. 98)` masculino 400 EQUALS 400

§§ `Exame médico, reabilitação e tratamento (art. 101)`

-- Carlos receives auxílio-doença: bound.
#ASSERT `Estou sujeito às avaliações do INSS (art. 101, caput)` `auxílio-doença` FALSE TRUE
-- Marta is an invalid pensioner: bound.
#ASSERT `Estou sujeito às avaliações do INSS (art. 101, caput)` `pensão por morte` TRUE TRUE
-- Paulo is a retiree by age: not bound by art. 101.
#ASSERT NOT (`Estou sujeito às avaliações do INSS (art. 101, caput)` `aposentadoria por idade` FALSE TRUE)

-- Carlos, retired by invalidity, did not return to work, is 60 and the exam is only a routine one: exempt.
#ASSERT `Estou isento do exame médico (art. 101, §§ 1º e 2º)` `aposentadoria por invalidez` FALSE FALSE 60 (YearMonthDay 2026 6 1) (YearMonthDay 2020 1 1) FALSE (YearMonthDay 2000 1 1) FALSE `outra finalidade do exame`
-- Ana, 62 and retired, is called to verify recovery at her own request: the exemption does not apply.
#ASSERT NOT (`Estou isento do exame médico (art. 101, §§ 1º e 2º)` `aposentadoria por invalidez` FALSE FALSE 62 (YearMonthDay 2026 6 1) (YearMonthDay 2018 1 1) FALSE (YearMonthDay 2000 1 1) FALSE `verificar a recuperação da capacidade de trabalho a pedido do aposentado ou pensionista`)
-- Paulo is 56, retired on 1 June 2011 and the exam is on 1 June 2026: fifteen years elapsed and age above 55, exempt.
#ASSERT `Estou isento do exame médico (art. 101, §§ 1º e 2º)` `aposentadoria por invalidez` FALSE FALSE 56 (YearMonthDay 2026 6 1) (YearMonthDay 2011 6 1) FALSE (YearMonthDay 2000 1 1) FALSE `outra finalidade do exame`
-- Marta is 54: not exempt by age.
#ASSERT NOT (`Estou isento do exame médico (art. 101, §§ 1º e 2º)` `aposentadoria por invalidez` FALSE FALSE 54 (YearMonthDay 2026 6 1) (YearMonthDay 2000 1 1) FALSE (YearMonthDay 2000 1 1) FALSE `outra finalidade do exame`)

-- Carlos (auxílio-doença) did not attend the exam: the benefit may be suspended.
#ASSERT `Meu benefício pode ser suspenso (art. 101, caput)` `auxílio-doença` FALSE TRUE `exame médico` FALSE FALSE
-- Carlos attended: no suspension.
#ASSERT NOT (`Meu benefício pode ser suspenso (art. 101, caput)` `auxílio-doença` FALSE TRUE `exame médico` FALSE TRUE)
-- Ana refused a surgery, which is optional: no suspension.
#ASSERT NOT (`Meu benefício pode ser suspenso (art. 101, caput)` `auxílio-doença` FALSE TRUE `tratamento cirúrgico ou transfusão de sangue` FALSE FALSE)

-- Carlos consented and secrecy is guaranteed: access allowed.
#ASSERT `A perícia pode acessar meus prontuários do SUS (art. 101, § 4º)` TRUE TRUE
-- Ana did not consent: no access.
#ASSERT NOT (`A perícia pode acessar meus prontuários do SUS (art. 101, § 4º)` FALSE TRUE)

-- Carlos has mobility problems and the expert finds the burden disproportionate: entitled.
#ASSERT `Tenho direito a perícia em casa ou no hospital (art. 101, § 5º)` TRUE TRUE TRUE
-- Ana has no mobility difficulty: not entitled.
#ASSERT NOT (`Tenho direito a perícia em casa ou no hospital (art. 101, § 5º)` FALSE FALSE TRUE)

-- All three conditions are met: telemedicine or document analysis is allowed.
#ASSERT `Minha avaliação pode ser feita por telemedicina (art. 101, § 6º)` TRUE TRUE TRUE
-- The regulamento's requirements are not met: not allowed.
#ASSERT NOT (`Minha avaliação pode ser feita por telemedicina (art. 101, § 6º)` FALSE TRUE TRUE)

-- A slot was freed, Carlos is next in the queue and available: his exam can be brought forward.
#ASSERT `Posso ter minha perícia antecipada por telemedicina (art. 101, §§ 8º e 9º)` TRUE TRUE TRUE
-- He is not available then: not brought forward.
#ASSERT NOT (`Posso ter minha perícia antecipada por telemedicina (art. 101, §§ 8º e 9º)` TRUE TRUE FALSE)

§§ `Perda da qualidade de segurado (art. 102)`

-- Carlos lost the quality of insured: the rights inherent to it lapse.
#ASSERT `Meus direitos de segurado caducaram (art. 102, caput)` FALSE
-- Ana keeps it: they do not.
#ASSERT NOT (`Meus direitos de segurado caducaram (art. 102, caput)` TRUE)

-- Carlos met every requirement before losing the quality: the right survives.
#ASSERT `Mantenho o direito à aposentadoria apesar da perda da qualidade (art. 102, § 1º)` TRUE
-- Ana had not: it does not.
#ASSERT NOT (`Mantenho o direito à aposentadoria apesar da perda da qualidade (art. 102, § 1º)` FALSE)

-- The insured had lost the quality and had not met the retirement requirements: the pension is barred.
#ASSERT `Posso ficar sem a pensão por morte porque o segurado perdeu a qualidade (art. 102, § 2º)` FALSE FALSE
-- He had met the retirement requirements: not barred by § 2.
#ASSERT NOT (`Posso ficar sem a pensão por morte porque o segurado perdeu a qualidade (art. 102, § 2º)` FALSE TRUE)
-- He still had the quality: not barred by § 2.
#ASSERT NOT (`Posso ficar sem a pensão por morte porque o segurado perdeu a qualidade (art. 102, § 2º)` TRUE FALSE)

§§ `Prazos para revisão, anulação e ação (arts. 103, 103-A e 104)`

-- Carlos received the first payment on 15 March 2024: the term starts on 1 April 2024 and ends on 1 April 2034.
#ASSERT `Até quando posso pedir a revisão do ato do INSS (art. 103, caput, I e II)` TRUE (YearMonthDay 2024 3 15) EQUALS (YearMonthDay 2034 4 1)
-- Ana learned of the refusal on 15 March 2024: the term starts that day and ends on 15 March 2034.
#ASSERT `Até quando posso pedir a revisão do ato do INSS (art. 103, caput, I e II)` FALSE (YearMonthDay 2024 3 15) EQUALS (YearMonthDay 2034 3 15)

-- Carlos (start 1 April 2024, last day 1 April 2034) asks on 1 April 2034: still in time.
#ASSERT NOT (`Meu direito de revisão já decaiu (art. 103, caput)` TRUE (YearMonthDay 2024 3 15) (YearMonthDay 2034 4 1))
-- He asks on 2 April 2034: the right has lapsed.
#ASSERT `Meu direito de revisão já decaiu (art. 103, caput)` TRUE (YearMonthDay 2024 3 15) (YearMonthDay 2034 4 2)

-- Carlos should have been paid on 10 March 2020: he can sue until 10 March 2025.
#ASSERT `Até quando posso cobrar prestações vencidas (art. 103, parágrafo único)` (YearMonthDay 2020 3 10) FALSE EQUALS JUST (YearMonthDay 2025 3 10)
-- Ana is a minor: the Código Civil governs and the text fixes no date (NOTHING).
#ASSERT `Até quando posso cobrar prestações vencidas (art. 103, parágrafo único)` (YearMonthDay 2020 3 10) TRUE EQUALS NOTHING

-- Carlos: act of 10 January 2020, no continuing effects: the INSS can annul it until 10 January 2030.
#ASSERT `Até quando a Previdência pode anular o ato que me favorece (art. 103-A)` (YearMonthDay 2020 1 10) FALSE (YearMonthDay 2020 3 5) FALSE EQUALS JUST (YearMonthDay 2030 1 10)
-- Ana receives a monthly benefit from 5 March 2020 (continuing effects): counted from the first payment, until 5 March 2030.
#ASSERT `Até quando a Previdência pode anular o ato que me favorece (art. 103-A)` (YearMonthDay 2020 1 10) TRUE (YearMonthDay 2020 3 5) FALSE EQUALS JUST (YearMonthDay 2030 3 5)
-- Bad faith proven: the article fixes no limit (NOTHING).
#ASSERT `Até quando a Previdência pode anular o ato que me favorece (art. 103-A)` (YearMonthDay 2020 1 10) FALSE (YearMonthDay 2020 3 5) TRUE EQUALS NOTHING

-- Carlos: act of 10 January 2020; today is 10 January 2030: the right is still there.
#ASSERT `A Previdência ainda pode anular o ato que me favorece (art. 103-A)` (YearMonthDay 2020 1 10) FALSE (YearMonthDay 2020 3 5) FALSE FALSE (YearMonthDay 2000 1 1) (YearMonthDay 2030 1 10)
-- Today is 11 January 2030 and no measure was taken: it has lapsed.
#ASSERT NOT (`A Previdência ainda pode anular o ato que me favorece (art. 103-A)` (YearMonthDay 2020 1 10) FALSE (YearMonthDay 2020 3 5) FALSE FALSE (YearMonthDay 2000 1 1) (YearMonthDay 2030 1 11))
-- A measure impugning the act was taken on 1 June 2029: the right was exercised in time.
#ASSERT `A Previdência ainda pode anular o ato que me favorece (art. 103-A)` (YearMonthDay 2020 1 10) FALSE (YearMonthDay 2020 3 5) FALSE TRUE (YearMonthDay 2029 6 1) (YearMonthDay 2031 1 1)

-- Carlos had a work accident on 15 June 2020 that caused temporary incapacity verified by the INSS: he can sue until 15 June 2025.
#ASSERT `Até quando posso propor ação sobre o acidente do trabalho (art. 104, I)` TRUE (YearMonthDay 2020 6 15) TRUE FALSE EQUALS JUST (YearMonthDay 2025 6 15)
-- The event was not a work accident: the article does not decide (NOTHING).
#ASSERT `Até quando posso propor ação sobre o acidente do trabalho (art. 104, I)` FALSE (YearMonthDay 2020 6 15) TRUE FALSE EQUALS NOTHING

-- Ana's permanent incapacity was recognised on 1 March 2021: she can sue until 1 March 2026.
#ASSERT `Até quando posso propor ação sobre o acidente do trabalho, contados do reconhecimento (art. 104, II)` TRUE TRUE (YearMonthDay 2021 3 1) FALSE EQUALS JUST (YearMonthDay 2026 3 1)
-- Nothing recognised yet: no date (NOTHING).
#ASSERT `Até quando posso propor ação sobre o acidente do trabalho, contados do reconhecimento (art. 104, II)` TRUE FALSE (YearMonthDay 2000 1 1) FALSE EQUALS NOTHING

§§ `Requerimento, prova e justificação (arts. 105 a 108)`

-- Carlos's documents are incomplete: that is not a ground for refusal.
#ASSERT NOT (`O INSS pode recusar meu requerimento por documentação incompleta (art. 105)` TRUE)
-- Ana's documents are complete: nothing to refuse on this ground.
#ASSERT NOT (`O INSS pode recusar meu requerimento por documentação incompleta (art. 105)` FALSE)

-- Carlos has the cadastro and a producer's notepad: proven.
#ASSERT `Consegui comprovar a minha atividade rural (art. 106)` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE
-- Ana has a lease contract but no self-declaration or cadastro: the means only complement them, so not proven.
#ASSERT NOT (`Consegui comprovar a minha atividade rural (art. 106)` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
-- Paulo has the cadastro but no means of proof: not proven.
#ASSERT NOT (`Consegui comprovar a minha atividade rural (art. 106)` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)

-- Carlos's military service (art. 55) counts for the monthly income of his pension.
#ASSERT `Meu tempo de serviço conta no cálculo da renda mensal (art. 107)` TRUE `pensão por morte`
-- A period that is not service time under art. 55 is not covered.
#ASSERT NOT (`Meu tempo de serviço conta no cálculo da renda mensal (art. 107)` FALSE `aposentadoria por idade`)

-- Carlos lost his work card; the justification was processed with material proof: it can supply it.
#ASSERT `Posso suprir a falta de documento por justificação (art. 108)` TRUE TRUE TRUE TRUE FALSE
-- The missing document is a public registry: it cannot.
#ASSERT NOT (`Posso suprir a falta de documento por justificação (art. 108)` TRUE TRUE TRUE TRUE TRUE)

§§ `Como o benefício é pago (arts. 109 a 114)`

-- Carlos cannot move: the benefit may be paid to a procurator.
#ASSERT `Meu benefício pode ser pago a procurador (art. 109, caput)` FALSE FALSE TRUE
-- Ana is able: it is paid to her directly.
#ASSERT NOT (`Meu benefício pode ser pago a procurador (art. 109, caput)` FALSE FALSE FALSE)

-- A twelve-month mandate is within the limit.
#ASSERT `O mandato do meu procurador respeita o prazo (art. 109, caput)` 12
-- A thirteen-month mandate is not.
#ASSERT NOT (`O mandato do meu procurador respeita o prazo (art. 109, caput)` 13)

-- Carlos cannot sign and put his fingerprint before a servant: it counts as his signature.
#ASSERT `Minha impressão digital vale como assinatura (art. 109, parágrafo único)` TRUE TRUE
-- Without the servant present: it does not.
#ASSERT NOT (`Minha impressão digital vale como assinatura (art. 109, parágrafo único)` TRUE FALSE)

-- Ana is the mother of an incapable pensioner: she may receive.
#ASSERT `Posso receber o benefício de quem é incapaz (art. 110, caput)` TRUE TRUE FALSE FALSE 0 FALSE
-- Paulo is an heir, the relatives are missing, six months, with the term signed: he may.
#ASSERT `Posso receber o benefício de quem é incapaz (art. 110, caput)` TRUE FALSE TRUE TRUE 6 TRUE
-- The same at seven months: he may not.
#ASSERT NOT (`Posso receber o benefício de quem é incapaz (art. 110, caput)` TRUE FALSE TRUE TRUE 7 TRUE)

-- Carlos is a dependant in good standing: he may represent another.
#ASSERT `Posso representar outro dependente (art. 110, §§ 2º e 3º)` TRUE FALSE FALSE FALSE
-- Ana was excluded under art. 16 s7: she may not.
#ASSERT NOT (`Posso representar outro dependente (art. 110, §§ 2º e 3º)` TRUE TRUE FALSE FALSE)
-- Paulo's share is provisionally suspended: he may not.
#ASSERT NOT (`Posso representar outro dependente (art. 110, §§ 2º e 3º)` TRUE FALSE TRUE FALSE)

-- Ana has a disability and applies for an INSS benefit: no curatela term is required (JUST FALSE).
#ASSERT `Preciso apresentar termo de curatela (art. 110-A)` TRUE TRUE EQUALS JUST FALSE
-- No disability: the article does not decide (NOTHING).
#ASSERT `Preciso apresentar termo de curatela (art. 110-A)` TRUE FALSE EQUALS NOTHING

-- Carlos is a minor insured and the Regulamento admits it: he may.
#ASSERT `Posso firmar o recibo do benefício sem meus pais ou tutor (art. 111)` TRUE TRUE
-- The Regulamento does not: he may not.
#ASSERT NOT (`Posso firmar o recibo do benefício sem meus pais ou tutor (art. 111)` TRUE FALSE)

-- There are dependants entitled to the pension: they receive it.
#ASSERT `A quem é pago o valor que o segurado não recebeu em vida (art. 112)` TRUE EQUALS `dependentes habilitados à pensão por morte`
-- There are none: the successors under the civil law receive it, with no inventory.
#ASSERT `A quem é pago o valor que o segurado não recebeu em vida (art. 112)` FALSE EQUALS `sucessores na forma da lei civil`

-- Deposit in a current account, admitted by the regulation: allowed.
#ASSERT `Meu benefício pode ser pago por esta forma (art. 113)` `depósito em conta corrente` TRUE
-- Some other way: not provided by the article.
#ASSERT NOT (`Meu benefício pode ser pago por esta forma (art. 113)` `outra forma de pagamento` TRUE)

-- A creditor seeks to seize Carlos's benefit for an ordinary debt: it cannot be seized.
#ASSERT `Meu benefício pode ser penhorado ou cedido (art. 114)` `penhora, arresto ou sequestro` FALSE FALSE FALSE EQUALS `o benefício não pode ser objeto do ato`
-- A sale of the benefit: null and void.
#ASSERT `Meu benefício pode ser penhorado ou cedido (art. 114)` `venda ou cessão` FALSE FALSE FALSE EQUALS `o ato é nulo de pleno direito`
-- Seizure for alimony recognised by a sentence: not reached by the article.
#ASSERT `Meu benefício pode ser penhorado ou cedido (art. 114)` `penhora, arresto ou sequestro` FALSE FALSE TRUE EQUALS `o ato não é alcançado pelo art. 114`

§§ `Descontos no benefício (art. 115)`

-- Carlos has Imposto de Renda withheld: allowed (the credit-operation answers do not matter).
#ASSERT `Podem descontar do meu benefício (art. 115)` `Imposto de Renda retido na fonte` TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE
-- Ana's loan is regular (authorised, unblocked by biometrics and signature, informed): allowed.
#ASSERT `Podem descontar do meu benefício (art. 115)` `empréstimo, financiamento ou arrendamento mercantil` TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE
-- Paulo's loan was unblocked without biometrics: not allowed.
#ASSERT NOT (`Podem descontar do meu benefício (art. 115)` `empréstimo, financiamento ou arrendamento mercantil` TRUE TRUE TRUE FALSE TRUE TRUE FALSE FALSE)
-- Marta's union fee: never allowed, even if she authorised it.
#ASSERT NOT (`Podem descontar do meu benefício (art. 115)` `mensalidade ou contribuição a associação, sindicato, entidade de classe ou organização de aposentados e pensionistas` TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE)

-- Carlos receives R$ 2,000.00: at most 30%, R$ 600.00.
#ASSERT `Quanto no máximo podem descontar por pagamento indevido (art. 115, II)` 2_000 EQUALS 600

-- Carlos receives R$ 3,000.00 and loses 1,050 (35%) to loans, 150 and 150 (5% each) to the cards: at the limits.
#ASSERT `Os descontos de crédito consignado respeitam os limites (art. 115, VI)` 3_000 1_050 150 150
-- Ana loses R$ 1,050.01 to loans: over the 35% limit.
#ASSERT NOT (`Os descontos de crédito consignado respeitam os limites (art. 115, VI)` 3_000 1_050.01 0 0)

-- Carlos received in good faith: the deduction is in installments.
#ASSERT `O desconto por pagamento indevido será feito em parcelas (art. 115, § 1º)` FALSE
-- Ana acted in bad faith: the installment rule does not apply.
#ASSERT NOT (`O desconto por pagamento indevido será feito em parcelas (art. 115, § 1º)` TRUE)

-- Both deductions: the undue-payment deduction prevails.
#ASSERT `Qual desconto prevalece (art. 115, § 2º)` TRUE TRUE EQUALS JUST `pagamento indevido ou além do devido de benefício`
-- Only the loan: the paragraph does not apply (NOTHING).
#ASSERT `Qual desconto prevalece (art. 115, § 2º)` FALSE TRUE EQUALS NOTHING

-- Carlos received undue amounts and the INSS constituted the credit: it is registered.
#ASSERT `Meu débito com o INSS será inscrito em dívida ativa (art. 115, § 3º)` TRUE

-- Paulo knew of the fraud and was identified in the procedure: he may be registered.
#ASSERT `Posso ser inscrito em dívida ativa por benefício pago indevidamente a outra pessoa (art. 115, § 4º)` TRUE TRUE TRUE
-- He was never identified in a procedure: not.
#ASSERT NOT (`Posso ser inscrito em dívida ativa por benefício pago indevidamente a outra pessoa (art. 115, § 4º)` TRUE TRUE FALSE)

-- Marta authorised the union fee in writing: still forbidden.
#ASSERT NOT (`Podem descontar mensalidade de associação do meu benefício (art. 115, § 8º)` TRUE)
-- Without authorisation: forbidden too.
#ASSERT NOT (`Podem descontar mensalidade de associação do meu benefício (art. 115, § 8º)` FALSE)

-- Carlos authorised personally and specifically, with biometrics and a qualified signature: unblocked.
#ASSERT `Meu benefício está desbloqueado para a operação (art. 115, § 9º)` TRUE TRUE TRUE
-- Ana did not use biometrics: still blocked.
#ASSERT NOT (`Meu benefício está desbloqueado para a operação (art. 115, § 9º)` TRUE FALSE TRUE)

-- Carlos was informed and the benefit was properly unblocked: the deductions may start.
#ASSERT `Os descontos do crédito consignado podem começar (art. 115, § 10)` TRUE TRUE TRUE TRUE
-- Ana was not informed of the contract: they may not start.
#ASSERT NOT (`Os descontos do crédito consignado podem começar (art. 115, § 10)` TRUE TRUE TRUE FALSE)

-- Carlos was informed of the contract: he can contest it through the INSS channels.
#ASSERT `Posso contestar a contratação pelos canais do INSS (art. 115, § 10)` TRUE

-- Carlos took a loan and did not unblock again: blocked for a new one.
#ASSERT `Meu benefício está bloqueado para uma nova operação (art. 115, § 12)` TRUE
-- He unblocked again: not blocked.
#ASSERT NOT (`Meu benefício está bloqueado para uma nova operação (art. 115, § 12)` FALSE)

-- Carlos's loan was arranged by a call centre: forbidden.
#ASSERT NOT (`Posso contratar crédito consignado por procuração ou por telefone (art. 115, § 13)` TRUE)
-- Done in person: not barred by § 13.
#ASSERT `Posso contratar crédito consignado por procuração ou por telefone (art. 115, § 13)` FALSE

§§ `Demonstrativo e acordos com o INSS (arts. 116, 117 e 117-A)`

-- Carlos's statement lists the monthly amount, the differences with their periods and the deductions: detailed.
#ASSERT `O demonstrativo que recebi é minucioso (art. 116)` TRUE TRUE TRUE
-- Ana's statement omits the deductions: not detailed.
#ASSERT NOT (`O demonstrativo que recebi é minucioso (art. 116)` TRUE TRUE FALSE)

-- Carlos's union has an agreement with the INSS and he is a member: it may file for him.
#ASSERT `Minha empresa, meu sindicato ou minha entidade pode requerer meu benefício (art. 117)` TRUE TRUE TRUE
-- There is no agreement: it may not.
#ASSERT NOT (`Minha empresa, meu sindicato ou minha entidade pode requerer meu benefício (art. 117)` TRUE FALSE TRUE)

-- Ana's employer has a contract with the INSS and pays her benefit: allowed.
#ASSERT `Minha empresa, meu sindicato ou minha entidade pode pagar meu benefício (art. 117-A)` TRUE TRUE TRUE
-- Without a contract: not allowed.
#ASSERT NOT (`Minha empresa, meu sindicato ou minha entidade pode pagar meu benefício (art. 117-A)` TRUE FALSE TRUE)

-- Carlos's employer's contract matches the banks' on all three: met.
#ASSERT `O contrato de pagamento me dá as mesmas garantias dos bancos (art. 117-A, § 1º)` TRUE TRUE TRUE
-- It differs in the values: not met.
#ASSERT NOT (`O contrato de pagamento me dá as mesmas garantias dos bancos (art. 117-A, § 1º)` TRUE TRUE FALSE)

§§ `Acidente do trabalho, ação regressiva e benefícios acumulados (arts. 118 a 124)`

-- Carlos had a work accident and his auxílio-doença acidentário has ceased: the guarantee runs.
#ASSERT `Tenho garantido o meu emprego após o acidente (art. 118)` TRUE TRUE
-- The accident was not a work accident: no guarantee under art. 118.
#ASSERT NOT (`Tenho garantido o meu emprego após o acidente (art. 118)` FALSE TRUE)

-- Carlos's benefit ceased on 15 March 2025: the contract is kept at least until 15 March 2026.
#ASSERT `Até que dia tenho garantido o meu emprego (art. 118)` (YearMonthDay 2025 3 15) EQUALS (YearMonthDay 2026 3 15)
-- Ana's ceased on 29 February 2024: until 28 February 2025.
#ASSERT `Até que dia tenho garantido o meu emprego (art. 118)` (YearMonthDay 2024 2 29) EQUALS (YearMonthDay 2025 2 28)

-- Carlos was dismissed on 16 March 2025, a day after his benefit ceased on 15 March 2025: inside the guarantee.
#ASSERT `Minha dispensa viola a garantia do emprego (art. 118)` (YearMonthDay 2025 3 15) (YearMonthDay 2025 3 16)
-- Ana was dismissed on 16 March 2026: after the twelve months.
#ASSERT NOT (`Minha dispensa viola a garantia do emprego (art. 118)` (YearMonthDay 2025 3 15) (YearMonthDay 2026 3 16))

-- Carlos was injured at work and his employer ignored the safety norms: the Previdência Social can sue the employer.
#ASSERT `A Previdência pode ajuizar ação regressiva contra o responsável pelo meu caso (art. 120)` TRUE FALSE
-- Ana was the victim of domestic violence and receives a benefit for it: the Previdência Social can sue the author.
#ASSERT `A Previdência pode ajuizar ação regressiva contra o responsável pelo meu caso (art. 120)` FALSE TRUE
-- Neither case: the action does not lie under art. 120.
#ASSERT NOT (`A Previdência pode ajuizar ação regressiva contra o responsável pelo meu caso (art. 120)` FALSE FALSE)

-- There was negligence: the payment does not exclude the firm's civil liability (JUST TRUE).
#ASSERT `A empresa continua civilmente responsável apesar do pagamento do benefício (art. 121)` TRUE EQUALS JUST TRUE
-- No negligence: the article says nothing (NOTHING).
#ASSERT `A empresa continua civilmente responsável apesar do pagamento do benefício (art. 121)` FALSE EQUALS NOTHING

-- There was domestic violence: the payment does not exclude the author's civil liability (JUST TRUE).
#ASSERT `O autor da violência doméstica continua civilmente responsável (art. 121)` TRUE EQUALS JUST TRUE
-- There was none: the article says nothing (NOTHING).
#ASSERT `O autor da violência doméstica continua civilmente responsável (art. 121)` FALSE EQUALS NOTHING

-- Carlos (masculino) has 420 months (35 years), chose to stay and the old conditions are better: assured.
#ASSERT `Tenho assegurada a aposentadoria nas condições da data do cumprimento dos requisitos (art. 122)` masculino 420 TRUE TRUE
-- Ana (feminino) has 360 months (30 years), chose to stay and the old conditions are better: assured.
#ASSERT `Tenho assegurada a aposentadoria nas condições da data do cumprimento dos requisitos (art. 122)` feminino 360 TRUE TRUE
-- Paulo has 419 months: not yet.
#ASSERT NOT (`Tenho assegurada a aposentadoria nas condições da data do cumprimento dos requisitos (art. 122)` masculino 419 TRUE TRUE)

-- Carlos receives one aposentadoria and auxílio-doença: forbidden together (art. 124, I).
#ASSERT NOT (`Posso receber estes benefícios em conjunto (art. 124, caput)` 1 TRUE FALSE FALSE 0 0 FALSE)
-- Ana receives two retirements: forbidden (art. 124, II).
#ASSERT NOT (`Posso receber estes benefícios em conjunto (art. 124, caput)` 2 FALSE FALSE FALSE 0 0 FALSE)
-- Paulo receives two retirements but has an acquired right: allowed.
#ASSERT `Posso receber estes benefícios em conjunto (art. 124, caput)` 2 FALSE FALSE FALSE 0 0 TRUE
-- Marta receives salário-maternidade and auxílio-doença: forbidden (art. 124, IV).
#ASSERT NOT (`Posso receber estes benefícios em conjunto (art. 124, caput)` 0 TRUE FALSE TRUE 0 0 FALSE)
-- Rui receives one aposentadoria and one auxílio-acidente: not forbidden by art. 124 (the bar is art. 86 s2).
#ASSERT `Posso receber estes benefícios em conjunto (art. 124, caput)` 1 FALSE FALSE FALSE 1 0 FALSE
-- Sara receives two pensions left by a spouse or partner: forbidden (art. 124, VI), with a right to opt.
#ASSERT NOT (`Posso receber estes benefícios em conjunto (art. 124, caput)` 0 FALSE FALSE FALSE 0 2 FALSE)

-- Sara receives two such pensions: she may opt for the more advantageous.
#ASSERT `Posso optar pela pensão mais vantajosa (art. 124, VI)` 2
-- Ana receives one: nothing to opt between.
#ASSERT NOT (`Posso optar pela pensão mais vantajosa (art. 124, VI)` 1)

-- Carlos receives unemployment insurance and an auxílio-doença: forbidden.
#ASSERT NOT (`Posso receber seguro-desemprego junto com meu benefício (art. 124, parágrafo único)` TRUE `auxílio-doença`)
-- Ana receives unemployment insurance and a pensão por morte: allowed (exception).
#ASSERT `Posso receber seguro-desemprego junto com meu benefício (art. 124, parágrafo único)` TRUE `pensão por morte`
-- Paulo receives unemployment insurance and an auxílio-acidente: allowed (exception).
#ASSERT `Posso receber seguro-desemprego junto com meu benefício (art. 124, parágrafo único)` TRUE `auxílio-acidente`

§§ `Atendimento eletrônico, dados pessoais e decisão motivada (arts. 124-A a 124-G)`

-- Carlos applies for a benefit: he may do so electronically.
#ASSERT `Posso requerer meu benefício por meio eletrônico (art. 124-A, caput)` TRUE

-- Carlos calls from a mobile phone to apply for a benefit: the call is free.
#ASSERT `A ligação telefônica para pedir os serviços do INSS é gratuita (art. 124-A, § 4º)` TRUE TRUE
-- A call for another purpose: not covered.
#ASSERT NOT (`A ligação telefônica para pedir os serviços do INSS é gratuita (art. 124-A, § 4º)` TRUE FALSE)

-- The INSS asks for Carlos's SUS records, necessary for his benefit, with the Constitution and the LGPD observed: access (JUST TRUE).
#ASSERT `O INSS pode ter acesso ao dado (art. 124-B, caput)` `registros e prontuários eletrônicos do Sistema Único de Saúde` TRUE TRUE EQUALS JUST TRUE
-- Medical documents held by a private entity: inciso III and § 5 conflict, so the text does not settle it (NOTHING).
#ASSERT `O INSS pode ter acesso ao dado (art. 124-B, caput)` `documentos médicos mantidos por entidade privada` TRUE TRUE EQUALS NOTHING

-- A designated federal medical expert reads Carlos's SUS records: allowed.
#ASSERT `Quem pode acessar os dados médicos que o INSS obtém (art. 124-B, § 1º)` `registros e prontuários eletrônicos do Sistema Único de Saúde` TRUE
-- An ordinary servant reads them: not allowed.
#ASSERT NOT (`Quem pode acessar os dados médicos que o INSS obtém (art. 124-B, § 1º)` `registros e prontuários eletrônicos do Sistema Único de Saúde` FALSE)

-- All three conditions are met: sharing allowed.
#ASSERT `Meus dados do INSS podem ser compartilhados com o regime próprio (art. 124-B, § 3º)` TRUE TRUE TRUE
-- The use goes beyond the regime's benefits: not allowed.
#ASSERT NOT (`Meus dados do INSS podem ser compartilhados com o regime próprio (art. 124-B, § 3º)` FALSE TRUE TRUE)

-- A private bank asks for Carlos's data: forbidden.
#ASSERT NOT (`Meus dados podem ser compartilhados com a entidade de direito privado (art. 124-B, §§ 5º e 6º)` TRUE FALSE FALSE)
-- A complementary pension entity receives the death information of its plan's beneficiaries: allowed (§ 6).
#ASSERT `Meus dados podem ser compartilhados com a entidade de direito privado (art. 124-B, §§ 5º e 6º)` TRUE TRUE TRUE

-- Carlos got a reasoned decision: the duty was met.
#ASSERT `A decisão sobre o meu pedido foi motivada (art. 124-C)` TRUE
-- Ana got an unreasoned refusal: it was not.
#ASSERT NOT (`A decisão sobre o meu pedido foi motivada (art. 124-C)` FALSE)

-- The servant made a gross error: personally liable.
#ASSERT `O servidor responde pessoalmente por erro na análise do meu pedido (art. 124-C)` FALSE TRUE
-- An ordinary mistake: not personally liable.
#ASSERT NOT (`O servidor responde pessoalmente por erro na análise do meu pedido (art. 124-C)` FALSE FALSE)

-- Both limbs met: regular.
#ASSERT `O tratamento dos meus dados pelo INSS é regular (art. 124-G)` TRUE TRUE
-- Unauthorised sharing: not regular.
#ASSERT NOT (`O tratamento dos meus dados pelo INSS é regular (art. 124-G)` TRUE FALSE)
