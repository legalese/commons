IMPORT `pb1-titulo-i-principios`
IMPORT `pb1-titulo-ii-regimes`
IMPORT `pb1-art-10-14-beneficiarios`
IMPORT `pb1-art-11-i-ii-vi-empregado-domestico-avulso`
IMPORT `pb1-art-11-v-contribuinte-individual`
IMPORT `pb1-art-11-vii-segurado-especial`
IMPORT `pb1-art-11-segurado-obrigatorio`
IMPORT `pb1-art-15-qualidade-de-segurado`
IMPORT `pb1-art-16-17-dependentes-inscricao`
IMPORT `pb1-art-18-prestacoes`
