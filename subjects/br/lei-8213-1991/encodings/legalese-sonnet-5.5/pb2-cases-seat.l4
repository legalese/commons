#ASSERT `Tenho direito à aposentadoria especial` TRUE 299 25 TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Tenho direito à aposentadoria especial` TRUE 300 25 TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Tenho direito à aposentadoria especial` TRUE 300 18 TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `Quanto recebo por mês de aposentadoria especial` 9000 1500 8000 EQUALS 8000
