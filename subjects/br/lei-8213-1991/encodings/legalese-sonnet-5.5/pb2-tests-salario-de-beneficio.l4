#ASSERT NOT (`art. 29-A, § 2º — o segurado pode solicitar a inclusão, exclusão ou retificação de informações do CNIS` FALSE TRUE)

-- § 4: after the regulation's limit (2 March against 1 March): extemporaneous; on the limit and before it: not.
