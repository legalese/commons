#ASSERT NOT `É vedado pedir precatório complementar` FALSE
#ASSERT `Meu pagamento será por precatório` 5180.26 5180.25
#ASSERT NOT `Meu pagamento será por precatório` 5180.25 5180.25
#ASSERT `Posso renunciar ao que excede o limite` 8000 5180.25
#ASSERT NOT `Posso renunciar ao que excede o limite` 5000 5180.25
