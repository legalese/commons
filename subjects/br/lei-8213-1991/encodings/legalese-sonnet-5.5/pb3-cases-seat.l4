#ASSERT `Quanto recebo sem precatório se renunciar ao excedente` 8000 5180.25 FALSE EQUALS 8000
#ASSERT `Quanto recebo sem precatório se renunciar ao excedente` 3000 5180.25 TRUE EQUALS 3000
#ASSERT `Optar pelo pagamento sem precatório me faz renunciar a outros créditos` TRUE
#ASSERT NOT `Optar pelo pagamento sem precatório me faz renunciar a outros créditos` FALSE
