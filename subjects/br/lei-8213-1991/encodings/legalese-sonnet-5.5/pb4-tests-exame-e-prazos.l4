#ASSERT NOT (`art. 101, §§ 8º e 9º — o horário vago pode ser preenchido pela perícia do periciando por telemedicina` FALSE TRUE TRUE)
#ASSERT NOT (`art. 101, §§ 8º e 9º — o horário vago pode ser preenchido pela perícia do periciando por telemedicina` TRUE FALSE TRUE)
