§§ `Art. 102`

#ASSERT `art. 102, caput — caducam os direitos inerentes à qualidade de segurado` FALSE
#ASSERT NOT (`art. 102, caput — caducam os direitos inerentes à qualidade de segurado` TRUE)
#ASSERT `art. 102, § 1º — o direito à aposentadoria subsiste apesar da perda da qualidade de segurado` TRUE
#ASSERT NOT (`art. 102, § 1º — o direito à aposentadoria subsiste apesar da perda da qualidade de segurado` FALSE)
#ASSERT `art. 102, § 1º — data da legislação aplicável à aposentadoria` (JUST (YMD 2015 5 20)) EQUALS JUST (YMD 2015 5 20)
#ASSERT `art. 102, § 1º — data da legislação aplicável à aposentadoria` NOTHING EQUALS NOTHING
-- § 2: died after losing the quality and the retirement requirements were not met: the pension is barred
#ASSERT `art. 102, § 2º — é vedada a pensão por morte aos dependentes` FALSE FALSE
-- the retirement requirements had been met: not barred
#ASSERT NOT (`art. 102, § 2º — é vedada a pensão por morte aos dependentes` FALSE TRUE)
-- the quality was kept: this paragraph does not bar it
#ASSERT NOT (`art. 102, § 2º — é vedada a pensão por morte aos dependentes` TRUE FALSE)
#ASSERT NOT (`art. 102, § 2º — é vedada a pensão por morte aos dependentes` TRUE TRUE)

§§ `Art. 103`

-- I: first day of the month after the first payment
#ASSERT `art. 103, I — dia em que começa o prazo de decadência` (YMD 2024 3 15) EQUALS YMD 2024 4 1
#ASSERT `art. 103, I — dia em que começa o prazo de decadência` (YMD 2024 3 31) EQUALS YMD 2024 4 1
#ASSERT `art. 103, I — dia em que começa o prazo de decadência` (YMD 2024 12 20) EQUALS YMD 2025 1 1
-- II: the day the insured learns of the decision
#ASSERT `art. 103, II — dia em que começa o prazo de decadência` (YMD 2024 3 15) EQUALS YMD 2024 3 15
-- ten years
#ASSERT `art. 103, caput — último dia do prazo de decadência` (YMD 2024 4 1) EQUALS YMD 2034 4 1
#ASSERT `art. 103, caput — último dia do prazo de decadência` (YMD 2024 3 15) EQUALS YMD 2034 3 15
-- on the last day the right is still in time; the day after it has lapsed
#ASSERT NOT (`art. 103, caput — o direito de revisão decaiu` (YMD 2024 4 1) (YMD 2034 4 1))
#ASSERT `art. 103, caput — o direito de revisão decaiu` (YMD 2024 4 1) (YMD 2034 4 2)
#ASSERT NOT (`art. 103, caput — o direito de revisão decaiu` (YMD 2024 4 1) (YMD 2030 1 1))
-- sole paragraph: five years from the due date; a minor, an incapable or an absent person: no date here
#ASSERT `art. 103, parágrafo único — último dia para a ação de cobrança de prestações vencidas` (YMD 2020 3 10) FALSE EQUALS JUST (YMD 2025 3 10)
#ASSERT `art. 103, parágrafo único — último dia para a ação de cobrança de prestações vencidas` (YMD 2020 2 29) FALSE EQUALS JUST (YMD 2025 2 28)
#ASSERT `art. 103, parágrafo único — último dia para a ação de cobrança de prestações vencidas` (YMD 2020 3 10) TRUE EQUALS NOTHING

§§ `Art. 103-A`

-- args: data do ato, efeitos patrimoniais contínuos, data do primeiro pagamento, má-fé comprovada
#ASSERT `art. 103-A — último dia para a Previdência Social anular o ato` (YMD 2020 1 10) FALSE (YMD 2020 3 5) FALSE EQUALS JUST (YMD 2030 1 10)
-- continuing effects (§ 1): counted from the first payment
#ASSERT `art. 103-A — último dia para a Previdência Social anular o ato` (YMD 2020 1 10) TRUE (YMD 2020 3 5) FALSE EQUALS JUST (YMD 2030 3 5)
-- proven bad faith: the article fixes no date
#ASSERT `art. 103-A — último dia para a Previdência Social anular o ato` (YMD 2020 1 10) FALSE (YMD 2020 3 5) TRUE EQUALS NOTHING
-- § 2: a measure that impugns the validity of the act, taken in time, is the exercise of the right
#ASSERT `art. 103-A, § 2º — o direito de anular foi exercido no prazo` (JUST (YMD 2029 12 31)) (YMD 2030 1 10)
#ASSERT `art. 103-A, § 2º — o direito de anular foi exercido no prazo` (JUST (YMD 2030 1 10)) (YMD 2030 1 10)
#ASSERT NOT (`art. 103-A, § 2º — o direito de anular foi exercido no prazo` (JUST (YMD 2030 1 11)) (YMD 2030 1 10))
#ASSERT NOT (`art. 103-A, § 2º — o direito de anular foi exercido no prazo` NOTHING (YMD 2030 1 10))
-- lapsed? args: ato, contínuos, primeiro pagamento, má-fé, medida, data
#ASSERT `art. 103-A — o direito de anular decaiu` (YMD 2020 1 10) FALSE (YMD 2020 3 5) FALSE NOTHING (YMD 2030 1 11)
#ASSERT NOT (`art. 103-A — o direito de anular decaiu` (YMD 2020 1 10) FALSE (YMD 2020 3 5) FALSE NOTHING (YMD 2030 1 10))
#ASSERT NOT (`art. 103-A — o direito de anular decaiu` (YMD 2020 1 10) FALSE (YMD 2020 3 5) FALSE (JUST (YMD 2029 6 1)) (YMD 2031 1 1))
#ASSERT NOT (`art. 103-A — o direito de anular decaiu` (YMD 2020 1 10) FALSE (YMD 2020 3 5) TRUE NOTHING (YMD 2040 1 1))
#ASSERT `art. 103-A — o direito de anular decaiu` (YMD 2020 1 10) FALSE (YMD 2020 3 5) FALSE (JUST (YMD 2030 6 1)) (YMD 2031 1 1)

