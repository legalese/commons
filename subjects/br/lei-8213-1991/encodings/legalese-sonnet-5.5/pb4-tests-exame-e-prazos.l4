#ASSERT NOT (`art. 101, § 6º — a avaliação pode ser feita por telemedicina ou por análise documental` TRUE FALSE TRUE)
#ASSERT NOT (`art. 101, § 6º — a avaliação pode ser feita por telemedicina ou por análise documental` TRUE TRUE FALSE)
