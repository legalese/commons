        IF `o ano em que o segurado implementou todas as condições necessárias à obtenção do benefício` EQUALS 2000 THEN JUST 114
        IF `o ano em que o segurado implementou todas as condições necessárias à obtenção do benefício` EQUALS 2001 THEN JUST 120
        IF `o ano em que o segurado implementou todas as condições necessárias à obtenção do benefício` EQUALS 2002 THEN JUST 126
