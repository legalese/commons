IMPORT prelude
GIVEN a IS A BOOLEAN
      b IS A BOOLEAN
GIVETH A BOOLEAN
`n2` a b MEANS
        (NOT a)
    AND b

GIVEN a IS A BOOLEAN
      b IS A BOOLEAN
GIVETH A BOOLEAN
`n3` a b MEANS
        "x" ... NOT a
    AND b

#ASSERT NOT `n2` FALSE FALSE
#ASSERT `n2` FALSE TRUE
#ASSERT NOT `n3` FALSE FALSE
#ASSERT `n3` FALSE TRUE
