
IMPORT prelude

DECLARE P HAS
    n IS A NUMBER
    @nlg:en the number

DECLARE `Preceito secundário` IS ONE OF
    `com pena privativa de liberdade` HAS `a pena` IS A P
    @nlg:en a provision prescribing a custodial penalty
    `somente pena de multa`
    @nlg:en a provision prescribing only a fine

GIVETH A `Preceito secundário`
@nlg:en the example provision
exemplo MEANS `com pena privativa de liberdade` (P WITH n IS 3)

#ASSERT exemplo EQUALS `com pena privativa de liberdade` (P WITH n IS 3)
#ASSERT NOT (exemplo EQUALS `somente pena de multa`)
#ASSERT (`com pena privativa de liberdade` (P WITH n IS 3)) EQUALS exemplo
