
IMPORT prelude

DECLARE Coisa HAS
    `valor em reais` IS A NUMBER
    @nlg:en D-FIELD-OWN-LINE-BELOW
    `móvel` IS A BOOLEAN   @nlg:en E-FIELD-TRAILING
    `alheia` IS A BOOLEAN  -- a comment on the line
    @nlg:en M-FIELD-BELOW-A-COMMENTED-LINE

DECLARE Fato HAS
    `a coisa` IS A Coisa
    @nlg:en N-NESTED-RECORD-FIELD
    `noturno` IS A BOOLEAN
    @nlg:en the act was at night

-- K2: constant with a GIVETH line
GIVETH A NUMBER
@nlg:en K2-CONSTANT-WITH-GIVETH
`constante k2` MEANS 10

-- K3: constant of a record type with GIVETH
GIVETH A Coisa
@nlg:en K3-RECORD-CONSTANT-HERALD
`coisa k3` MEANS Coisa WITH `valor em reais` IS 5, `móvel` IS TRUE, `alheia` IS FALSE

-- L2: mixfix with backticked parameter names
GIVEN `a coisa furtada` IS A Coisa
      `o limite` IS A NUMBER
GIVETH A BOOLEAN
@nlg:en L2 %a coisa furtada% above %o limite%
`a coisa furtada` `vale mais que` `o limite` MEANS `a coisa furtada`'s `valor em reais` GREATER THAN `o limite`

-- A2: prefix rule of two parameters, slots
GIVEN x IS A Coisa
      n IS A NUMBER
GIVETH A BOOLEAN
@nlg:en A2 %x% exceeds %n%
`regra a2` x n MEANS x's `valor em reais` GREATER THAN n

GIVEN f IS A Fato
GIVETH A BOOLEAN
@nlg:en the theft is at night (%f%)
`regra noturna` f MEANS f's `noturno`

#EVAL Coisa WITH `valor em reais` IS 100, `móvel` IS TRUE, `alheia` IS TRUE
#EVAL `regra a2` (Coisa WITH `valor em reais` IS 100, `móvel` IS TRUE, `alheia` IS TRUE) 50
#EVAL `constante k2`
#EVAL `coisa k3`
#EVAL `coisa k3` `vale mais que` 3
#EVAL `regra noturna` (Fato WITH `a coisa` IS `coisa k3`, `noturno` IS TRUE)
#EVAL (Fato WITH `a coisa` IS `coisa k3`, `noturno` IS TRUE)'s `noturno`
