@lang pt
IMPORT prelude

§ `Sondagem de posição dos heraldos`

DECLARE Espécie IS ONE OF
    reclusão
    @nlg:en J1-CONSTRUCTOR-OWN-LINE-BELOW
    detenção   @nlg:en J2-CONSTRUCTOR-TRAILING

DECLARE Coisa HAS
    `valor em reais` IS A NUMBER
    @nlg:en D-FIELD-OWN-LINE-BELOW
    `móvel` IS A BOOLEAN   @nlg:en E-FIELD-TRAILING
    `alheia` IS A BOOLEAN  -- a comment on the line
    @nlg:en M-FIELD-BELOW-A-COMMENTED-LINE

-- A: rule herald on its own line after GIVETH, immediately above the definition
@ref CP art. 1 (sondagem A)
GIVEN c IS A Coisa
GIVETH A BOOLEAN
@nlg:en A-RULE-ABOVE-DEFINITION %c%
`regra a` c MEANS c's `móvel`

-- B: rule herald above GIVEN (the documented silent failure)
@nlg:en B-RULE-ABOVE-GIVEN
GIVEN c IS A Coisa
GIVETH A BOOLEAN
`regra b` c MEANS c's `alheia`

-- C: rule herald trailing the definition line
GIVEN c IS A Coisa
GIVETH A BOOLEAN
`regra c` c MEANS c's `móvel` @nlg:en C-RULE-TRAILING

-- G: @export and @desc above GIVEN, @ref above GIVEN, herald after GIVETH
@export Sondagem G: a regra exportada
@ref CP art. 2 (sondagem G)
GIVEN c IS A Coisa @desc a coisa
GIVETH A BOOLEAN
@nlg:en G-EXPORTED-RULE-HERALD
`regra g` c MEANS c's `móvel` AND c's `alheia`

-- H: DECIDE … IF with herald above DECIDE
GIVEN c IS A Coisa
GIVETH A BOOLEAN
@nlg:en H-DECIDE-IF-HERALD
DECIDE `regra h` c IF c's `alheia`

-- K: a constant with no signature
@nlg:en K-CONSTANT-HERALD
`constante k` MEANS 10

-- F: parameter herald trailing its GIVEN line
GIVEN c IS A Coisa @nlg:en F-PARAM-TRAILING
GIVETH A BOOLEAN
`regra f` c MEANS c's `móvel`

-- I: untagged (Portuguese under @lang pt) and :en on one rule
GIVEN c IS A Coisa
GIVETH A BOOLEAN
@nlg I-PT-UNTAGGED %c%
@nlg:en I-EN-TAGGED %c%
`regra i` c MEANS c's `móvel`

-- L: a mixfix rule, herald with slots
GIVEN c IS A Coisa
      n IS A NUMBER
GIVETH A BOOLEAN
@nlg:en L-MIXFIX %c% above %n%
c `vale mais de` n MEANS c's `valor em reais` GREATER THAN n

`a coisa` MEANS Coisa WITH `valor em reais` IS 100, `móvel` IS TRUE, `alheia` IS TRUE

#EVAL `regra a` `a coisa`
#EVAL `regra b` `a coisa`
#EVAL `regra c` `a coisa`
#EVAL `regra g` `a coisa`
#EVAL `regra h` `a coisa`
#EVAL `constante k`
#EVAL `regra f` `a coisa`
#EVAL `regra i` `a coisa`
#EVAL `a coisa` `vale mais de` 50
#EVAL reclusão
#EVAL detenção
#EVAL `a coisa`
