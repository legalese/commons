IMPORT prelude
DECLARE P HAS
    `mínimo` IS A NUMBER
    `máximo` IS A NUMBER
GIVEN a IS A NUMBER
      b IS A NUMBER
GIVETH A BOOLEAN
a `excede` b MEANS a GREATER THAN b

GIVEN q IS A NUMBER
      pc IS A P
GIVETH A BOOLEAN
`dentro` q pc MEANS
        NOT ((pc's `mínimo`) `excede` q)
    AND NOT (q `excede` (pc's `máximo`))

#ASSERT `dentro` 3 (P WITH `mínimo` IS 1, `máximo` IS 6)
