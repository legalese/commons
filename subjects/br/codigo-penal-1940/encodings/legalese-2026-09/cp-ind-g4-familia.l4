        `o agente entregou o menor a outra pessoa` IS FALSE
        `o agente sabia ou devia saber que o menor fica moral ou materialmente em perigo` IS FALSE
        `para obter lucro` IS FALSE
        `o menor é enviado para o exterior` IS FALSE
        `o agente auxiliou a efetivação de ato destinado ao envio de menor para o exterior` IS TRUE
        `execução iniciada` IS FALSE
