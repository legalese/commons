@lang en
IMPORT prelude
IMPORT daydate
IMPORT `br-lindb-public-law`

-- Tests for br-lindb-public-law.l4 (arts. 20 to 30). Every expected value was worked out from the text before the file was run.
-- A predicate named "is breached" is TRUE when the article's duty or prohibition is broken; "allows" is TRUE when the article gives the permission.

§ `Art. 20`

-- caput: a decision on abstract values must have considered the practical consequences
#ASSERT `art. 20 caput is breached by a decision where` TRUE FALSE
#ASSERT NOT `art. 20 caput is breached by a decision where` TRUE TRUE
#ASSERT NOT `art. 20 caput is breached by a decision where` FALSE FALSE
#ASSERT NOT `art. 20 caput is breached by a decision where` FALSE TRUE

-- sole paragraph: necessity, adequacy and alternatives
#ASSERT `art. 20 sole paragraph is met by a motivation where` TRUE TRUE TRUE
#ASSERT NOT `art. 20 sole paragraph is met by a motivation where` FALSE TRUE TRUE
#ASSERT NOT `art. 20 sole paragraph is met by a motivation where` TRUE FALSE TRUE
#ASSERT NOT `art. 20 sole paragraph is met by a motivation where` TRUE TRUE FALSE

§ `Art. 21`

-- caput: an invalidating decision must expressly indicate its legal and administrative consequences
#ASSERT `art. 21 caput is breached by a decision where` TRUE FALSE FALSE
#ASSERT `art. 21 caput is breached by a decision where` TRUE TRUE FALSE
#ASSERT `art. 21 caput is breached by a decision where` TRUE FALSE TRUE
#ASSERT NOT `art. 21 caput is breached by a decision where` TRUE TRUE TRUE
#ASSERT NOT `art. 21 caput is breached by a decision where` FALSE FALSE FALSE

-- sole paragraph: invalidation, case calls for conditions, conditions indicated, burden abnormal, burden excessive
#ASSERT `art. 21 sole paragraph is breached by a decision where` TRUE TRUE FALSE FALSE FALSE
#ASSERT NOT `art. 21 sole paragraph is breached by a decision where` TRUE FALSE FALSE FALSE FALSE
#ASSERT NOT `art. 21 sole paragraph is breached by a decision where` TRUE TRUE TRUE FALSE FALSE
#ASSERT `art. 21 sole paragraph is breached by a decision where` TRUE FALSE FALSE TRUE FALSE
#ASSERT `art. 21 sole paragraph is breached by a decision where` TRUE FALSE FALSE FALSE TRUE
#ASSERT `art. 21 sole paragraph is breached by a decision where` TRUE TRUE TRUE TRUE FALSE
#ASSERT NOT `art. 21 sole paragraph is breached by a decision where` FALSE TRUE FALSE TRUE TRUE

§ `Art. 22`

-- caput: public management; obstacles considered, demands considered, rights of the administered prejudiced
#ASSERT NOT `art. 22 caput is breached by an interpretation where` TRUE TRUE TRUE FALSE
#ASSERT `art. 22 caput is breached by an interpretation where` TRUE FALSE TRUE FALSE
#ASSERT `art. 22 caput is breached by an interpretation where` TRUE TRUE FALSE FALSE
#ASSERT `art. 22 caput is breached by an interpretation where` TRUE TRUE TRUE TRUE
#ASSERT NOT `art. 22 caput is breached by an interpretation where` FALSE FALSE FALSE TRUE

-- par. 1
#ASSERT `art. 22 par. 1 is breached by a decision where` TRUE FALSE
#ASSERT NOT `art. 22 par. 1 is breached by a decision where` TRUE TRUE
#ASSERT NOT `art. 22 par. 1 is breached by a decision where` FALSE FALSE

-- par. 2: sanction applied; nature, gravity, damage, circumstances, antecedents
#ASSERT NOT `art. 22 par. 2 is breached by the application of a sanction where` TRUE TRUE TRUE TRUE TRUE TRUE
#ASSERT `art. 22 par. 2 is breached by the application of a sanction where` TRUE FALSE TRUE TRUE TRUE TRUE
#ASSERT `art. 22 par. 2 is breached by the application of a sanction where` TRUE TRUE FALSE TRUE TRUE TRUE
#ASSERT `art. 22 par. 2 is breached by the application of a sanction where` TRUE TRUE TRUE FALSE TRUE TRUE
#ASSERT `art. 22 par. 2 is breached by the application of a sanction where` TRUE TRUE TRUE TRUE FALSE TRUE
#ASSERT `art. 22 par. 2 is breached by the application of a sanction where` TRUE TRUE TRUE TRUE TRUE FALSE
#ASSERT NOT `art. 22 par. 2 is breached by the application of a sanction where` FALSE FALSE FALSE FALSE FALSE FALSE

-- par. 3: same nature, same fact, taken into account
#ASSERT `art. 22 par. 3 is breached by the dosimetry of a sanction where` TRUE TRUE FALSE
#ASSERT NOT `art. 22 par. 3 is breached by the dosimetry of a sanction where` TRUE TRUE TRUE
#ASSERT NOT `art. 22 par. 3 is breached by the dosimetry of a sanction where` FALSE TRUE FALSE
#ASSERT NOT `art. 22 par. 3 is breached by the dosimetry of a sanction where` TRUE FALSE FALSE

§ `Art. 23`

-- new interpretation of an indeterminate norm, a new duty, transition indispensable, transition provided
#ASSERT `art. 23 caput is breached by a decision where` TRUE TRUE TRUE FALSE
#ASSERT NOT `art. 23 caput is breached by a decision where` TRUE TRUE TRUE TRUE
#ASSERT NOT `art. 23 caput is breached by a decision where` TRUE TRUE FALSE FALSE
#ASSERT NOT `art. 23 caput is breached by a decision where` TRUE FALSE TRUE FALSE
#ASSERT NOT `art. 23 caput is breached by a decision where` FALSE TRUE TRUE FALSE

§ `Art. 24`

-- the prohibition: an act whose production was completed on 10 January 2026
#ASSERT `art. 24 caput forbids declaring the situation invalid where` (JUST (YMD 2026 1 10)) `and` (YMD 2026 3 1) TRUE TRUE
#ASSERT `art. 24 caput forbids declaring the situation invalid where` (JUST (YMD 2026 1 10)) `and` (YMD 2026 1 11) TRUE TRUE
-- a change before the completion is not a "later" change
#ASSERT NOT `art. 24 caput forbids declaring the situation invalid where` (JUST (YMD 2026 1 10)) `and` (YMD 2025 12 31) TRUE TRUE
#ASSERT NOT `art. 24 caput forbids declaring the situation invalid where` (JUST (YMD 2026 1 10)) `and` (YMD 2026 1 9) TRUE TRUE
-- on the very day: the text gives no moment of the day
#ASSERT REFUSED `art. 24 caput forbids declaring the situation invalid where` (JUST (YMD 2026 1 10)) `and` (YMD 2026 1 10) TRUE TRUE BECAUSE "art. 24 caput forbids declaring invalid on the strength of a later change of general orientation, and the text gives no moment of the day to say whether a change on the very day the production was completed is later"
-- the declaration does not rest on the change, or the situation was not fully constituted
#ASSERT NOT `art. 24 caput forbids declaring the situation invalid where` (JUST (YMD 2026 1 10)) `and` (YMD 2026 3 1) FALSE TRUE
#ASSERT NOT `art. 24 caput forbids declaring the situation invalid where` (JUST (YMD 2026 1 10)) `and` (YMD 2026 3 1) TRUE FALSE
-- the refused day is not reached when an earlier limb already settles the answer
#ASSERT NOT `art. 24 caput forbids declaring the situation invalid where` (JUST (YMD 2026 1 10)) `and` (YMD 2026 1 10) FALSE TRUE
#ASSERT NOT `art. 24 caput forbids declaring the situation invalid where` (JUST (YMD 2026 1 10)) `and` (YMD 2026 1 10) TRUE FALSE
-- production not completed
#ASSERT NOT `art. 24 caput forbids declaring the situation invalid where` NOTHING `and` (YMD 2026 3 1) TRUE TRUE

-- the review takes into account the general orientations of the time
#ASSERT `art. 24 caput is breached by a review where` TRUE FALSE
#ASSERT NOT `art. 24 caput is breached by a review where` TRUE TRUE
#ASSERT NOT `art. 24 caput is breached by a review where` FALSE FALSE

-- the sole paragraph: act of general character; majority jurisprudence; repeated practice that is also widely known
#ASSERT `it is a general orientation under art. 24 sole paragraph` TRUE FALSE FALSE FALSE
#ASSERT `it is a general orientation under art. 24 sole paragraph` FALSE TRUE FALSE FALSE
#ASSERT `it is a general orientation under art. 24 sole paragraph` FALSE FALSE TRUE TRUE
#ASSERT NOT `it is a general orientation under art. 24 sole paragraph` FALSE FALSE TRUE FALSE
#ASSERT NOT `it is a general orientation under art. 24 sole paragraph` FALSE FALSE FALSE TRUE
#ASSERT NOT `it is a general orientation under art. 24 sole paragraph` FALSE FALSE FALSE FALSE
#ASSERT `it is a general orientation under art. 24 sole paragraph` TRUE TRUE TRUE TRUE

§ `Art. 26`

-- the caput: purpose (irregularity, uncertainty, contentious situation), legal organ heard, consultation called for, held, reasons, legislation observed
#ASSERT `art. 26 caput allows the administrative authority to conclude a compromise where` TRUE FALSE FALSE TRUE FALSE FALSE TRUE TRUE
#ASSERT `art. 26 caput allows the administrative authority to conclude a compromise where` FALSE TRUE FALSE TRUE TRUE TRUE TRUE TRUE
#ASSERT `art. 26 caput allows the administrative authority to conclude a compromise where` FALSE FALSE TRUE TRUE FALSE FALSE TRUE TRUE
-- no purpose
#ASSERT NOT `art. 26 caput allows the administrative authority to conclude a compromise where` FALSE FALSE FALSE TRUE FALSE FALSE TRUE TRUE
-- the legal organ was not heard
#ASSERT NOT `art. 26 caput allows the administrative authority to conclude a compromise where` TRUE FALSE FALSE FALSE FALSE FALSE TRUE TRUE
-- a consultation was called for and not held
#ASSERT NOT `art. 26 caput allows the administrative authority to conclude a compromise where` TRUE FALSE FALSE TRUE TRUE FALSE TRUE TRUE
-- no reasons of relevant general interest; legislation not observed
#ASSERT NOT `art. 26 caput allows the administrative authority to conclude a compromise where` TRUE FALSE FALSE TRUE FALSE FALSE FALSE TRUE
#ASSERT NOT `art. 26 caput allows the administrative authority to conclude a compromise where` TRUE FALSE FALSE TRUE FALSE FALSE TRUE FALSE

-- par. 1, III and IV: permanent exoneration, recognised by a general orientation, clear obligations, deadline, sanctions
#ASSERT NOT `art. 26 par. 1 is breached by a compromise where` FALSE FALSE TRUE TRUE TRUE
#ASSERT `art. 26 par. 1 is breached by a compromise where` TRUE TRUE TRUE TRUE TRUE
-- an exoneration of a duty no general orientation recognised is not caught by III
#ASSERT NOT `art. 26 par. 1 is breached by a compromise where` TRUE FALSE TRUE TRUE TRUE
#ASSERT NOT `art. 26 par. 1 is breached by a compromise where` FALSE TRUE TRUE TRUE TRUE
#ASSERT `art. 26 par. 1 is breached by a compromise where` FALSE FALSE FALSE TRUE TRUE
#ASSERT `art. 26 par. 1 is breached by a compromise where` FALSE FALSE TRUE FALSE TRUE
#ASSERT `art. 26 par. 1 is breached by a compromise where` FALSE FALSE TRUE TRUE FALSE

-- effect from the official publication, 4 May 2026
#ASSERT NOT `the compromise produces effects at some moment of` (YMD 2026 5 3) `from its official publication on` (YMD 2026 5 4)
#ASSERT `the compromise produces effects at some moment of` (YMD 2026 5 4) `from its official publication on` (YMD 2026 5 4)
#ASSERT `the compromise produces effects at some moment of` (YMD 2026 5 5) `from its official publication on` (YMD 2026 5 4)
#ASSERT NOT `the compromise produces effects throughout` (YMD 2026 5 3) `from its official publication on` (YMD 2026 5 4)
#ASSERT REFUSED `the compromise produces effects throughout` (YMD 2026 5 4) `from its official publication on` (YMD 2026 5 4) BECAUSE "art. 26 caput says the compromise produces effects from its official publication and the text gives no moment of the day of publication"
#ASSERT `the compromise produces effects throughout` (YMD 2026 5 5) `from its official publication on` (YMD 2026 5 4)

§ `Art. 27`

-- caput: undue benefits, abnormal losses, unjust losses; resulting from the process or the conduct of those involved
#ASSERT `art. 27 caput allows the decision to impose compensation where` TRUE FALSE FALSE TRUE
#ASSERT `art. 27 caput allows the decision to impose compensation where` FALSE TRUE FALSE TRUE
#ASSERT `art. 27 caput allows the decision to impose compensation where` FALSE FALSE TRUE TRUE
#ASSERT NOT `art. 27 caput allows the decision to impose compensation where` FALSE FALSE FALSE TRUE
#ASSERT NOT `art. 27 caput allows the decision to impose compensation where` TRUE FALSE FALSE FALSE
-- par. 1: reasoned; parties heard on whether due and on form; and on value where it is in question
#ASSERT `art. 27 par. 1 is met by a decision on compensation where` TRUE TRUE TRUE FALSE FALSE
#ASSERT `art. 27 par. 1 is met by a decision on compensation where` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT `art. 27 par. 1 is met by a decision on compensation where` TRUE TRUE TRUE TRUE FALSE
#ASSERT NOT `art. 27 par. 1 is met by a decision on compensation where` FALSE TRUE TRUE FALSE FALSE
#ASSERT NOT `art. 27 par. 1 is met by a decision on compensation where` TRUE FALSE TRUE FALSE FALSE
#ASSERT NOT `art. 27 par. 1 is met by a decision on compensation where` TRUE TRUE FALSE FALSE FALSE
-- par. 2: a procedural compromise
#ASSERT `art. 27 par. 2 allows a procedural compromise where` TRUE TRUE
#ASSERT NOT `art. 27 par. 2 allows a procedural compromise where` FALSE TRUE
#ASSERT NOT `art. 27 par. 2 allows a procedural compromise where` TRUE FALSE

§ `Art. 28`

-- a decision or technical opinion of a public agent; intent; gross error
#ASSERT `the public agent answers personally on a ground listed in art. 28 caput where` TRUE TRUE FALSE
#ASSERT `the public agent answers personally on a ground listed in art. 28 caput where` TRUE FALSE TRUE
#ASSERT NOT `the public agent answers personally on a ground listed in art. 28 caput where` TRUE FALSE FALSE
#ASSERT NOT `the public agent answers personally on a ground listed in art. 28 caput where` FALSE TRUE TRUE

§ `Art. 29`

#ASSERT `art. 29 caput allows a public consultation before the act where` TRUE FALSE
#ASSERT NOT `art. 29 caput allows a public consultation before the act where` TRUE TRUE
#ASSERT NOT `art. 29 caput allows a public consultation before the act where` FALSE FALSE
#ASSERT `art. 29 caput is breached by a decision where` TRUE FALSE
#ASSERT NOT `art. 29 caput is breached by a decision where` TRUE TRUE
#ASSERT NOT `art. 29 caput is breached by a decision where` FALSE FALSE
#ASSERT `art. 29 par. 1 is met by a convocation where` TRUE TRUE TRUE
#ASSERT NOT `art. 29 par. 1 is met by a convocation where` FALSE TRUE TRUE
#ASSERT NOT `art. 29 par. 1 is met by a convocation where` TRUE FALSE TRUE
#ASSERT NOT `art. 29 par. 1 is met by a convocation where` TRUE TRUE FALSE

§ `Art. 30`

-- an instrument the caput names, directed to this organ, never revised
#ASSERT `an instrument of art. 30 caput binds, on` (YMD 2030 1 1) `, where` TRUE TRUE NOTHING
-- revised on 1 September 2026
#ASSERT `an instrument of art. 30 caput binds, on` (YMD 2026 8 31) `, where` TRUE TRUE (JUST (YMD 2026 9 1))
#ASSERT REFUSED `an instrument of art. 30 caput binds, on` (YMD 2026 9 1) `, where` TRUE TRUE (JUST (YMD 2026 9 1)) BECAUSE "art. 30 sole paragraph binds until further revision and the text gives no moment of the day of the revision"
#ASSERT NOT `an instrument of art. 30 caput binds, on` (YMD 2026 9 2) `, where` TRUE TRUE (JUST (YMD 2026 9 1))
-- an organ the instrument is not directed to: the text says nothing
#ASSERT REFUSED `an instrument of art. 30 caput binds, on` (YMD 2026 8 31) `, where` TRUE FALSE NOTHING BECAUSE "art. 30 sole paragraph says the instruments bind the organ or entity they are directed to and says nothing of any other"
-- an instrument the caput does not name: the text does not say whether "inclusive" extends the list
#ASSERT REFUSED `an instrument of art. 30 caput binds, on` (YMD 2026 8 31) `, where` FALSE TRUE NOTHING BECAUSE "art. 30 caput names regulations, administrative precedents and answers to consultations 'inclusive', and the text does not say whether other instruments are 'provided for in the caput'"
