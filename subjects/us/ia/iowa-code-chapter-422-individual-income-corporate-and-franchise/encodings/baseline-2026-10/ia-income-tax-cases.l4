IMPORT prelude
IMPORT daydate
IMPORT `ia-income-tax`
IMPORT `ia-income-tax-seat`

-- Iowa Code chapter 422, subchapter II -- worked cases from the taxpayer's seat.
-- Every expected value was worked by hand from the deposited text (Iowa Code 2026) before the encoding was run. The
-- federal figures are stated facts, not computed. Each assertion is a claim about the encoding on those facts, not about
-- the law; none has been checked against a Department of Revenue form or ruling.

§ `Cases`

§§ `422.4(14) -- residence`

#ASSERT `Am I an Iowa resident` TRUE FALSE EQUALS TRUE
#ASSERT `Am I an Iowa resident` FALSE TRUE EQUALS TRUE
#ASSERT `Am I an Iowa resident` FALSE FALSE EQUALS FALSE

§§ `422.7 -- net income`

-- Federal taxable income 50,000; federal securities interest 1,000 (out); other states' bond interest 500 (in); taxable
-- social security 10,000 (out); my pension 20,000 at 60 (out, 55 or older); my spouse's pension 5,000 at 50, not
-- disabled (stays in). 50,000 + 500 - 1,000 - 10,000 - 20,000 = 19,500.
#ASSERT `What is my Iowa net income` 50000 1000 500 10000 20000 FALSE 60 FALSE 5000 FALSE 50 0 0 0 0 EQUALS 19500
-- The same, but I am 50 and a qualifying survivor: my pension still comes out (422.7(19)(a)(3)). Still 19,500.
#ASSERT `What is my Iowa net income` 50000 1000 500 10000 20000 FALSE 50 TRUE 5000 FALSE 50 0 0 0 0 EQUALS 19500
-- I am 50, not disabled, not a survivor: my 20,000 pension stays in. 50,000 + 500 - 1,000 - 10,000 = 39,500.
#ASSERT `What is my Iowa net income` 50000 1000 500 10000 20000 FALSE 50 FALSE 5000 FALSE 50 0 0 0 0 EQUALS 39500
-- Military retirement 8,000 and active duty pay 30,000 both come out (422.7(20), (29)): 60,000 - 38,000 = 22,000.
#ASSERT `What is my Iowa net income` 60000 0 0 0 0 FALSE 30 FALSE 0 FALSE 0 8000 30000 0 0 EQUALS 22000

§§ `422.13 -- must I file`

-- Resident, single, 30, net income 8,000, no federal deductions: 8,000 is not more than 9,000. No return required.
#ASSERT `Must I make an Iowa return` TRUE `single` 30 0 FALSE 8000 0 8000 EQUALS `answered` FALSE
-- The same with a 2,000 federal deduction added back: 10,000 > 9,000. A return is required.
#ASSERT `Must I make an Iowa return` TRUE `single` 30 0 FALSE 8000 2000 8000 EQUALS `answered` TRUE
-- Resident, single, 70: the 422.5(3) amount, 24,000, applies; 20,000 is not more. No return.
#ASSERT `Must I make an Iowa return` TRUE `single` 70 0 FALSE 15000 5000 15000 EQUALS `answered` FALSE
-- Married filing jointly, 40 and 38, combined 13,000 plus 0: not more than 13,500. No return.
#ASSERT `Must I make an Iowa return` TRUE `married filing jointly` 40 38 FALSE 13000 0 13000 EQUALS `answered` FALSE
-- Claimed as a dependent, net income 5,000: 422.13(1)(a) requires a return even below 9,000.
#ASSERT `Must I make an Iowa return` TRUE `single` 17 0 TRUE 5000 0 5000 EQUALS `answered` TRUE
-- Nonresident with 800 allocated to Iowa: under 1,000. No return.
#ASSERT `Must I make an Iowa return` FALSE `single` 30 0 FALSE 60000 15000 800 EQUALS `answered` FALSE
-- Nonresident with 1,500 allocated to Iowa and total 75,000: a return is required.
#ASSERT `Must I make an Iowa return` FALSE `single` 30 0 FALSE 60000 15000 1500 EQUALS `answered` TRUE
-- Nonresident with 1,500 allocated but total net income (with add-back) 8,500: within 9,000. No return.
#ASSERT `Must I make an Iowa return` FALSE `single` 30 0 FALSE 2000 6500 1500 EQUALS `answered` FALSE
-- Married filing separately: not covered.
#ASSERT `Must I make an Iowa return` TRUE `married filing separately` 40 40 FALSE 30000 15000 30000 EQUALS `not covered` `a married person filing a separate return is not encoded: 422.5(2), (3) and 422.13(2) turn on the combined net income of both spouses and the alternate tax for separate filers is not worked out here`

§§ `422.21(1), 422.24(1) -- when it is due`

-- Calendar year 2025: the last day of the fourth month after December 2025 is 30 April 2026.
#ASSERT `When is my Iowa return due` 12 2025 FALSE EQUALS `answered` (DATE_FROM_DMY 30 4 2026)
-- Fiscal year ending June 2026: 31 October 2026.
#ASSERT `When is my Iowa return due` 6 2026 FALSE EQUALS `answered` (DATE_FROM_DMY 31 10 2026)
-- Fiscal year ending September 2026: 31 January 2027.
#ASSERT `When is my Iowa return due` 9 2026 FALSE EQUALS `answered` (DATE_FROM_DMY 31 1 2027)
-- Fiscal year ending October 2027: the last day of February 2028, a leap year: 29 February 2028.
#ASSERT `When is my Iowa return due` 10 2027 FALSE EQUALS `answered` (DATE_FROM_DMY 29 2 2028)
-- In a combat zone: not covered.
#ASSERT `When is my Iowa return due` 12 2025 TRUE EQUALS `not covered` `the extra time for a person in a combat zone, a qualified hazardous duty area or a contingency operation follows section 7508(a) of the Internal Revenue Code (422.21(2)), which is not encoded here`
-- Filing and paying on 30 April 2026 for 2025: in time.
#ASSERT `Am I in time to file and pay` 12 2025 (DATE_FROM_DMY 30 4 2026) 0 EQUALS TRUE
-- On 1 May 2026, with the director's 10 extra days: in time.
#ASSERT `Am I in time to file and pay` 12 2025 (DATE_FROM_DMY 1 5 2026) 10 EQUALS TRUE
-- On 1 May 2026 with no extension: late.
#ASSERT `Am I in time to file and pay` 12 2025 (DATE_FROM_DMY 1 5 2026) 0 EQUALS FALSE

-- The duty itself, on days from the end of the tax year (31 December 2025 = day 0; 30 April 2026 = day 120).
`days to 30 April 2026` MEANS 120
#ASSERT EVALTRACE (`the 422.13 and 422.21 duty to make a return and pay` 120) 0 (LIST (EVENT `the individual` `make the return and pay the total tax due in full` 100)) EQUALS FULFILLED
-- expect: BREACH BY the individual, "the return was not filed, with the total tax due paid in full, on or before the last day of the fourth month after the tax year (422.21(1), 422.24(1))" (filed on 1 May 2026, day 121)
#TRACE `the 422.13 and 422.21 duty to make a return and pay` `days to 30 April 2026` AT 0 WITH
    PARTY `the individual` DOES `make the return and pay the total tax due in full` AT 121
-- expect: BREACH BY the individual, "the early childhood development credit was claimed, so the child and dependent care credit may not also be claimed (422.12C(2)(a))"
`claimed` MEANS TRUE
#TRACE `the 422.12C(2) bar on claiming both credits` `claimed` AT 0 WITH
    PARTY `the individual` DOES `claim the child and dependent care credit` AT 5
-- Without the early childhood credit, nothing bars the child and dependent care credit.
#ASSERT EVALTRACE (`the 422.12C(2) bar on claiming both credits` FALSE) 0 (LIST (EVENT `the individual` `claim the child and dependent care credit` 5)) EQUALS FULFILLED

§§ `422.5, 422.12, 422.12B, 422.12C -- what I owe or get back`

-- Inputs, in order: resident all year, status, net income, NOL, federal deductions, my age, spouse's age, denied as a
-- dependent, dependents, I am blind, spouse blind, K-12 tuition list, federal EIC, federal CDCC, early childhood instead,
-- early childhood list, tax paid to another state, Iowa tax withheld.

-- A. Single, 30, net income 40,000, federal standard deduction 15,000. Tax 3.8% x 40,000 = 1,520; 55,000 is far above
-- 9,000 so 422.5(2) does not reduce it. Personal credit 40: 1,480. Withheld 1,600: refund 120.
#ASSERT `What do I owe or get back` TRUE `single` 40000 0 15000 30 0 FALSE 0 FALSE FALSE (LIST) 0 0 FALSE (LIST) FALSE 1600 EQUALS `answered` (-120)

-- B. Single, 25, wages 12,000, federal taxable income 0, deduction 12,000: no tax. Federal EIC 600: Iowa 15% = 90,
-- refunded. Nothing withheld: refund 90.
#ASSERT `What do I owe or get back` TRUE `single` 0 0 12000 25 0 FALSE 0 FALSE FALSE (LIST) 600 0 FALSE (LIST) FALSE 0 EQUALS `answered` (-90)

-- C. Married filing jointly, 40 and 38, two children; net income 20,000; deductions 30,000. Tax 760; 50,000 is above
-- 13,500 and the 4.3% alternate (1,569.50) and the retention (36,500) are both higher, so 760. Credits: 80 + 2 x 40 = 160,
-- tuition 25% of 2,000 + 25% of 500 = 625; 785 exceeds 760, so tax 0 (not refundable). EIC 15% of 2,000 = 300. Child
-- care: net income 20,000 is in band c, 55% of 1,200 = 660. Withheld 200. 0 - 300 - 660 - 200 = -1,160.
#ASSERT `What do I owe or get back` TRUE `married filing jointly` 20000 0 30000 40 38 FALSE 2 FALSE FALSE (LIST 3000, 500) 2000 1200 FALSE (LIST) FALSE 200 EQUALS `answered` (-1160)

-- D. Head of household, 35, one child; net income 16,000, deductions 4,000: 20,000 for 422.5(2). Tax 608. Excess over
-- 13,500 is 6,500; 4.3% of it is 279.50, the least. Credits 80 + 40 = 120: 159.50 owed.
#ASSERT `What do I owe or get back` TRUE `head of household` 16000 0 4000 35 0 FALSE 1 FALSE FALSE (LIST) 0 0 FALSE (LIST) FALSE 0 EQUALS `answered` 159.5

-- E. Single, 66, net income 24,500, no deductions added back. Tax 931. 422.5(3): 24,500 exceeds 24,000 by 500, and the
-- taxpayer keeps 24,000, so the tax is 500. Credits 40 + 20 (65 or older) = 60: 440 owed.
#ASSERT `What do I owe or get back` TRUE `single` 24500 0 0 66 0 FALSE 0 FALSE FALSE (LIST) 0 0 FALSE (LIST) FALSE 0 EQUALS `answered` 440

-- F. Single, 70, net income 10,000, deductions 13,000: 23,000 is within 24,000, so no tax.
#ASSERT `What do I owe or get back` TRUE `single` 10000 0 13000 70 0 FALSE 0 FALSE FALSE (LIST) 0 0 FALSE (LIST) FALSE 0 EQUALS `answered` 0

-- G. Married filing jointly, 67 and 60 (422.5(3)(c): one spouse 65 is enough); net income 30,000, deductions 4,000:
-- 34,000. Tax 1,140. Under (3): 4.3% of 2,000 = 86. Credits 80 + 20 = 100 exceed 86: 0 owed.
#ASSERT `What do I owe or get back` TRUE `married filing jointly` 30000 0 4000 67 60 FALSE 0 FALSE FALSE (LIST) 0 0 FALSE (LIST) FALSE 0 EQUALS `answered` 0

-- H. A 19-year-old claimed by parents with net income above 13,500: 422.5(2) is denied. Net income 5,000, deduction
-- 1,350 (6,350 would be under 9,000). Tax 190; credit 40: 150 owed.
#ASSERT `What do I owe or get back` TRUE `single` 5000 0 1350 19 0 TRUE 0 FALSE FALSE (LIST) 0 0 FALSE (LIST) FALSE 0 EQUALS `answered` 150

-- I. Single, 45, blind, net income 30,000, deductions 15,000, early childhood credit instead of child care for one child of
-- 4 with 1,500 paid. Tax 1,140; credits 40 + 40 (the child) + 20 (blind) = 100: 1,040. Early childhood 25% of 1,000 = 250:
-- 790 owed. The federal child care credit of 900 is not used (422.12C(2)(a)).
#ASSERT `What do I owe or get back` TRUE `single` 30000 0 15000 45 0 FALSE 1 TRUE FALSE (LIST) 0 900 TRUE (LIST 1500) FALSE 0 EQUALS `answered` 790

-- Not covered: a part-year resident; tax paid to another state; married filing separately.
#ASSERT `What do I owe or get back` FALSE `single` 40000 0 15000 30 0 FALSE 0 FALSE FALSE (LIST) 0 0 FALSE (LIST) FALSE 0 EQUALS `not covered` `the tax of a nonresident or part-year resident is not encoded: it is prorated by net income allocated to Iowa under 422.8, subsection 2, under rules prescribed by the director (422.5(1)(b))`
#ASSERT `What do I owe or get back` TRUE `single` 40000 0 15000 30 0 FALSE 0 FALSE FALSE (LIST) 0 0 FALSE (LIST) TRUE 0 EQUALS `not covered` `the credit for income tax paid to another state or foreign country (422.8(1)) is not encoded`
#ASSERT `What do I owe or get back` TRUE `married filing separately` 40000 0 15000 30 30 FALSE 0 FALSE FALSE (LIST) 0 0 FALSE (LIST) FALSE 0 EQUALS `not covered` `a married person filing a separate return is not encoded: 422.5(2), (3) and 422.13(2) turn on the combined net income of both spouses and the alternate tax for separate filers is not worked out here`

§§ `422.12B, 422.12C -- the credits alone`

#ASSERT `What is my Iowa earned income credit` 1000 EQUALS 150
#ASSERT `What is my Iowa child and dependent care credit` 9999 1000 EQUALS 750
#ASSERT `What is my Iowa child and dependent care credit` 10000 1000 EQUALS 650
#ASSERT `What is my Iowa child and dependent care credit` 39999 1000 EQUALS 400
#ASSERT `What is my Iowa child and dependent care credit` 89999 1000 EQUALS 300
#ASSERT `What is my Iowa child and dependent care credit` 90000 1000 EQUALS 0
#ASSERT `What is my Iowa early childhood development credit` 50000 (LIST 1500, 400) EQUALS 350
#ASSERT `What is my Iowa early childhood development credit` 90000 (LIST 1500, 400) EQUALS 0
