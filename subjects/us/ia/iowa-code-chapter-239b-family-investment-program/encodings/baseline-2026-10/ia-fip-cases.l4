IMPORT prelude
IMPORT daydate
IMPORT `ia-fip`
IMPORT `ia-fip-seat`

-- Iowa family investment program -- worked cases from the applicant's seat.
-- Every expected value was worked by hand from the deposited text (Iowa Code 2026 ch. 239B; IAC 441-41.27, 41.28 as
-- published 10/14/2026) before the encoding was run. Each assertion is a claim about the encoding on the stated facts,
-- not about the law; none has been checked against a department notice of decision.

§ `Cases`

§§ `239B.1 -- child; specified relative`

#ASSERT `Is this young person a child for FIP` 17 FALSE FALSE EQUALS TRUE
#ASSERT `Is this young person a child for FIP` 18 FALSE TRUE EQUALS TRUE
#ASSERT `Is this young person a child for FIP` 18 FALSE FALSE EQUALS FALSE
#ASSERT `Is this young person a child for FIP` 16 TRUE FALSE EQUALS FALSE
#ASSERT `Can I apply for this child` `grandparent` TRUE EQUALS TRUE
#ASSERT `Can I apply for this child` `second cousin` TRUE EQUALS TRUE
#ASSERT `Can I apply for this child` `another relationship, or none` TRUE EQUALS FALSE
#ASSERT `Can I apply for this child` `uncle or aunt` FALSE EQUALS FALSE

§§ `239B.7 -- resources`

-- Applying, $1,500 in the bank: within $2,000.
#ASSERT `Are our resources within the FIP limit` FALSE 1500 0 0 EQUALS TRUE
-- Applying, $1,500 and a second car with $800 equity: $2,300, over $2,000.
#ASSERT `Are our resources within the FIP limit` FALSE 1500 800 0 EQUALS FALSE
-- Already receiving: $4,000 and the second car: $4,800, within $5,000.
#ASSERT `Are our resources within the FIP limit` TRUE 4000 800 0 EQUALS TRUE
-- Applying, $900 and $11,000 of self-employment tools: $10,000 disregarded, $1,900 counted.
#ASSERT `Are our resources within the FIP limit` FALSE 900 0 11000 EQUALS TRUE

§§ `IAC 441-41.28(2) -- the schedule`

#ASSERT `What is our FIP payment standard` 1 0 EQUALS 183
#ASSERT `What is our FIP payment standard` 3 0 EQUALS 426
-- 12 persons: 865 for ten and 87 for each of two more.
#ASSERT `What is our FIP payment standard` 12 0 EQUALS 1039
#ASSERT `185 percent of living costs` 3 EQUALS 1570.65
#ASSERT `standard of need` 11 0 EQUALS 1897

§§ `IAC 441-41.27 -- the income tests`

-- Mother and two children applying; she earns $1,000 a month. Gross 1,000 is within 1,570.65; after the 20% deduction
-- 800 is less than the 849 standard of need; after the 58% disregard 336 is less than the 426 payment standard.
#ASSERT `Does our income pass the FIP tests` 3 FALSE 1000 0 0 0 EQUALS `meets the income tests`
-- She earns $1,600: more than 1,570.65.
#ASSERT `Does our income pass the FIP tests` 3 FALSE 1600 0 0 0 EQUALS `gross income is more than 185 percent of the standard of need (IAC 41.27(1), 41.27(9)a(2))`
-- She earns $1,100 and applies: 880 is not less than 849.
#ASSERT `Does our income pass the FIP tests` 3 FALSE 1100 0 0 0 EQUALS `net income before the work incentive disregard is not less than the standard of need (IAC 41.27(2), 41.27(9)a(2))`
-- The same earnings while already receiving FIP: the standard of need test does not apply; 369.60 is less than 426.
#ASSERT `Does our income pass the FIP tests` 3 TRUE 1100 0 0 0 EQUALS `meets the income tests`
-- Parent and one child applying, $400 a month of unemployment benefit: 400 is not less than the 361 payment standard.
#ASSERT `Does our income pass the FIP tests` 2 FALSE 0 400 0 0 EQUALS `net income after the disregards is not less than the payment standard (IAC 41.27(3), 41.27(9)a(3))`

§§ `239B.2, 239B.3 -- the monthly grant`

-- Inputs: children, relationship, child lives with me, group size, already receiving, cash, other vehicles, tools,
-- earned, unearned, diversions, special needs, written statement, information, child support.

-- A. Mother, two children, group of 3, applying, $500 in the bank, earning $1,000: 426 - 336 = 90.
#ASSERT `How much FIP would we get` 2 `parent` TRUE 3 FALSE 500 0 0 1000 0 0 0 TRUE TRUE TRUE EQUALS `a monthly cash grant` 90
-- B. The same family with no income: the full payment standard, 426.
#ASSERT `How much FIP would we get` 2 `parent` TRUE 3 FALSE 500 0 0 0 0 0 0 TRUE TRUE TRUE EQUALS `a monthly cash grant` 426
-- C. Mother and child on $300 a month of unemployment benefit, group of 2: 361 - 300 = 61.
#ASSERT `How much FIP would we get` 1 `parent` TRUE 2 FALSE 0 0 0 0 300 0 0 TRUE TRUE TRUE EQUALS `a monthly cash grant` 61
-- D. Two parents, two children, group of 4, receiving; earnings $1,200, support paid for another child $200.
-- 1,200 within 1,824.10; 960 - 200 = 760; 42% is 319.20; 495 - 319.20 = 175.80.
#ASSERT `How much FIP would we get` 2 `parent` TRUE 4 TRUE 1000 0 0 1200 0 200 0 TRUE TRUE TRUE EQUALS `a monthly cash grant` 175.8
-- E. A grandmother caring for a grandchild, whose needs are included: group of 2, no income: 361.
#ASSERT `How much FIP would we get` 1 `grandparent` TRUE 2 FALSE 0 0 0 0 0 0 0 TRUE TRUE TRUE EQUALS `a monthly cash grant` 361
-- F. A neighbour who is not a relative: no family under 239B.1(6).
#ASSERT `How much FIP would we get` 1 `another relationship, or none` TRUE 1 FALSE 0 0 0 0 0 0 0 TRUE TRUE TRUE EQUALS `no grant: there is no child, or no parent or specified relative, in the family (239B.1(6))`
-- G. An aunt applying for a child who does not live with her.
#ASSERT `How much FIP would we get` 1 `uncle or aunt` FALSE 2 FALSE 0 0 0 0 0 0 0 TRUE TRUE TRUE EQUALS `no grant: the application is not made by a specified relative the child lives with (239B.2(1))`
-- H. Applying with $3,000 in the bank.
#ASSERT `How much FIP would we get` 2 `parent` TRUE 3 FALSE 3000 0 0 0 0 0 0 TRUE TRUE TRUE EQUALS `no grant: the family's resources are over the limit (239B.7(7))`
-- I. Earnings of $1,600 for a group of 3.
#ASSERT `How much FIP would we get` 2 `parent` TRUE 3 FALSE 500 0 0 1600 0 0 0 TRUE TRUE TRUE EQUALS `no grant: the family's income fails a test` `gross income is more than 185 percent of the standard of need (IAC 41.27(1), 41.27(9)a(2))`
-- J. Not providing the information requested.
#ASSERT `How much FIP would we get` 2 `parent` TRUE 3 FALSE 500 0 0 1000 0 0 0 TRUE FALSE TRUE EQUALS `no grant: another condition of 239B.2 is not met (the written statement, information, or child support cooperation)`

§§ `239B.3(1)(b), 239B.9 -- deadlines`

#ASSERT `By when must the department decide` (DATE_FROM_DMY 1 10 2026) EQUALS (DATE_FROM_DMY 31 10 2026)
#ASSERT `By when must I answer the reminder letter` (DATE_FROM_DMY 20 10 2026) EQUALS (DATE_FROM_DMY 30 10 2026)
-- A first limited benefit plan may be reconsidered from its effective date.
#ASSERT `May I reconsider my limited benefit plan` TRUE (DATE_FROM_DMY 1 9 2026) 0 (DATE_FROM_DMY 1 9 2026) EQUALS TRUE
-- A subsequent plan with 90 days of ineligibility: not after 60 days; yes after 90.
#ASSERT `May I reconsider my limited benefit plan` FALSE (DATE_FROM_DMY 1 9 2026) 90 (DATE_FROM_DMY 31 10 2026) EQUALS FALSE
#ASSERT `May I reconsider my limited benefit plan` FALSE (DATE_FROM_DMY 1 9 2026) 90 (DATE_FROM_DMY 30 11 2026) EQUALS TRUE

-- The regulative rules, on days from the application (or the mailing of the letter).
#ASSERT EVALTRACE `the 239B.3(1)(b) duty to decide within thirty days` 0 (LIST (EVENT `the department` `authorize issuance of notice of the decision` 25)) EQUALS FULFILLED
-- expect: BREACH BY the department, "notice of the decision was not authorized within thirty days of the date of the application (239B.3(1)(b))"
#TRACE `the 239B.3(1)(b) duty to decide within thirty days` AT 0 WITH
    PARTY `the department` DOES `authorize issuance of notice of the decision` AT 31
#ASSERT EVALTRACE `the 239B.9(3)(a) reminder letter` 0 (LIST (EVENT `the participant` `respond to the reminder letter` 7)) EQUALS FULFILLED
-- expect: BREACH BY the participant, "no response to the reminder letter within ten calendar days of its mailing: the participant is considered to have chosen a limited benefit plan (239B.9(3)(a))"
#TRACE `the 239B.9(3)(a) reminder letter` AT 0 WITH
    (WAITUNTIL 11)

§§ `239B.2(6), 239B.3(4) -- child support; funeral`

#ASSERT `Must I cooperate with child support` TRUE FALSE EQUALS TRUE
#ASSERT `Must I cooperate with child support` TRUE TRUE EQUALS FALSE
#ASSERT `Must I cooperate with child support` FALSE FALSE EQUALS FALSE
#ASSERT EVALTRACE (`the 239B.2(6) duty to cooperate with child support` FALSE) 0 (LIST (EVENT `the specified relative` `cooperate with child support services and the department` 5)) EQUALS FULFILLED
#ASSERT EVALTRACE (`the 239B.2(6) duty to cooperate with child support` TRUE) 0 (LIST) EQUALS FULFILLED
#ASSERT `The most toward the funeral` FALSE 150 EQUALS 250
#ASSERT `The most toward the funeral` FALSE 500 EQUALS 0
#ASSERT `The most toward the funeral` TRUE 0 EQUALS 0
