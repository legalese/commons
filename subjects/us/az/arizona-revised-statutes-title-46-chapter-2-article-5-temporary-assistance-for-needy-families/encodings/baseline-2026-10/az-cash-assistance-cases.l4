IMPORT prelude
IMPORT `az-cash-assistance`

-- A.R.S. Title 46, Article 5 -- worked cases, from the seat of the applicant.
-- Every expected value was worked out by hand from the deposited text, never copied from the encoding's output.
-- The families are HYPOTHETICAL. Poverty levels and grant amounts used are made-up inputs, not published figures.

-- Arguments of `Does my family meet the conditions for cash assistance`, in order: dependent child, Arizona residence,
-- status, refused work, transferred property, school verified, unmarried parent under 18, minor parent exception, months
-- of Arizona cash assistance, child only case, hardship, full work compliance, 90% attendance, months of TANF anywhere.

-- A family meeting every condition, five months in.
#ASSERT `Does my family meet the conditions for cash assistance` TRUE TRUE `a citizen by birth or naturalization` FALSE FALSE TRUE FALSE FALSE 5 FALSE FALSE FALSE FALSE 5

-- s 46-294(A): twelve months reached: not eligible.
#ASSERT (NOT (`Does my family meet the conditions for cash assistance` TRUE TRUE `a citizen by birth or naturalization` FALSE FALSE TRUE FALSE FALSE 12 FALSE FALSE FALSE FALSE 12))
-- (G): full work compliance and 90% attendance: twelve more months; at 12, eligible; at 24, not.
#ASSERT `Does my family meet the conditions for cash assistance` TRUE TRUE `a citizen by birth or naturalization` FALSE FALSE TRUE FALSE FALSE 12 FALSE FALSE TRUE TRUE 12
#ASSERT (NOT (`Does my family meet the conditions for cash assistance` TRUE TRUE `a citizen by birth or naturalization` FALSE FALSE TRUE FALSE FALSE 24 FALSE FALSE TRUE TRUE 24))
-- (G) needs both: compliance without the attendance record is not enough.
#ASSERT (NOT (`Does my family meet the conditions for cash assistance` TRUE TRUE `a citizen by birth or naturalization` FALSE FALSE TRUE FALSE FALSE 12 FALSE FALSE TRUE FALSE 12))
-- Hardship: eligible at 12 months.
#ASSERT `Does my family meet the conditions for cash assistance` TRUE TRUE `a citizen by birth or naturalization` FALSE FALSE TRUE FALSE FALSE 12 FALSE TRUE FALSE FALSE 12
-- (C): a child only case has no 12-month limit.
#ASSERT `Does my family meet the conditions for cash assistance` TRUE TRUE `a citizen by birth or naturalization` FALSE FALSE TRUE FALSE FALSE 30 TRUE FALSE FALSE FALSE 0
-- (E): 60 months of TANF elsewhere: not eligible, though only 5 in Arizona; hardship: eligible.
#ASSERT (NOT (`Does my family meet the conditions for cash assistance` TRUE TRUE `a citizen by birth or naturalization` FALSE FALSE TRUE FALSE FALSE 5 FALSE FALSE FALSE FALSE 60))
#ASSERT `Does my family meet the conditions for cash assistance` TRUE TRUE `a citizen by birth or naturalization` FALSE FALSE TRUE FALSE FALSE 5 FALSE TRUE FALSE FALSE 60

-- s 46-292(B)(1), (C): a qualified alien who entered after 21 August 1996 and in no exception group: not eligible; one who
-- entered before: eligible.
#ASSERT (NOT (`Does my family meet the conditions for cash assistance` TRUE TRUE `a qualified alien who entered after 21 August 1996, in no exception group` FALSE FALSE TRUE FALSE FALSE 5 FALSE FALSE FALSE FALSE 5))
#ASSERT `Does my family meet the conditions for cash assistance` TRUE TRUE `a qualified alien who entered the United States on or before 21 August 1996` FALSE FALSE TRUE FALSE FALSE 5 FALSE FALSE FALSE FALSE 5
#ASSERT `Does my family meet the conditions for cash assistance` TRUE TRUE `a qualified alien in a PRWORA section 412 exception group` FALSE FALSE TRUE FALSE FALSE 5 FALSE FALSE FALSE FALSE 5

-- s 46-296: an unmarried parent under 18 heading the unit: not eligible, unless an exception applies.
#ASSERT (NOT (`Does my family meet the conditions for cash assistance` TRUE TRUE `a citizen by birth or naturalization` FALSE FALSE TRUE TRUE FALSE 0 FALSE FALSE FALSE FALSE 0))
#ASSERT `Does my family meet the conditions for cash assistance` TRUE TRUE `a citizen by birth or naturalization` FALSE FALSE TRUE TRUE TRUE 0 FALSE FALSE FALSE FALSE 0

-- s 46-292(A): no dependent child: not eligible. (B)(2): refused available work: not eligible. (S): school not verified.
#ASSERT (NOT (`Does my family meet the conditions for cash assistance` FALSE TRUE `a citizen by birth or naturalization` FALSE FALSE TRUE FALSE FALSE 0 FALSE FALSE FALSE FALSE 0))
#ASSERT (NOT (`Does my family meet the conditions for cash assistance` TRUE TRUE `a citizen by birth or naturalization` TRUE FALSE TRUE FALSE FALSE 0 FALSE FALSE FALSE FALSE 0))
#ASSERT (NOT (`Does my family meet the conditions for cash assistance` TRUE TRUE `a citizen by birth or naturalization` FALSE FALSE FALSE FALSE FALSE 0 FALSE FALSE FALSE FALSE 0))

-- -------------------------------------------------------------------------------------------------------------------
-- s 46-292(P)(1): earnings of $1,000: $90 off, then 30% of $910 ($273) off; $637 counted.
#ASSERT `How much of my earnings is counted` 1000 EQUALS 637
#ASSERT `How much of my earnings is counted` 90 EQUALS 0
#ASSERT `How much of my earnings is counted` 80 EQUALS 0
-- dependent care: $250 billed for a baby (capped at $200), $100 and $200 for two others ($100 and $175): $475.
#ASSERT `How much of my dependent care is disregarded` 250 (LIST 100, 200) EQUALS 475
#ASSERT `How much of my dependent care is disregarded` 0 (LIST 100) EQUALS 100

-- s 46-292(P)(2): 130% of a $1,600 guideline is $2,080.
#ASSERT `Is our income low enough for a child only request` 2000 1600
#ASSERT `Is our income low enough for a child only request` 2080 1600
#ASSERT (NOT (`Is our income low enough for a child only request` 2100 1600))

-- -------------------------------------------------------------------------------------------------------------------
-- s 46-207.01: a (made-up) 1992 poverty level of $1,000; paying rent: 36% = $360, less $100 income: $260.
#ASSERT `What is the least cash assistance we must get` 1000 TRUE 100 EQUALS 260
-- no shelter costs: $1,000 less 37% = $630; 36% of that is $226.80; less $100: $126.80.
#ASSERT `What is the least cash assistance we must get` 1000 FALSE 100 EQUALS 126.8
-- income $400 already above the $360 floor: nothing is guaranteed beyond it.
#ASSERT `What is the least cash assistance we must get` 1000 TRUE 400 EQUALS 0

-- s 46-298(D): three months of a $300 grant.
#ASSERT `How much would a diversion payment be` 300 EQUALS 900

-- s 46-300(D): first instance half of $300; second and later, nothing; no noncompliance, the full grant.
#ASSERT `How much do we get in a month of noncompliance` 300 1 EQUALS 150
#ASSERT `How much do we get in a month of noncompliance` 300 2 EQUALS 0
#ASSERT `How much do we get in a month of noncompliance` 300 3 EQUALS 0
#ASSERT `How much do we get in a month of noncompliance` 300 0 EQUALS 300

-- -------------------------------------------------------------------------------------------------------------------
-- The duties, traced (days; working days for the diversion).
-- Cooperation within the 30 days the department allowed (an assumed period: the statute sets none).
#ASSERT EVALTRACE (`the duty to cooperate on child support` `the applicant or recipient` `the department` 30) 0 (LIST EVENT `the applicant or recipient` `cooperate with child support enforcement` 10) EQUALS FULFILLED
-- No cooperation: the department must halve the grant for one month (s 46-292(E), s 46-300(D)(1)); it does on day 40.
-- expect: FULFILLED
#TRACE `the duty to cooperate on child support` `the applicant or recipient` `the department` 30 AT 0 WITH
    (WAITUNTIL 31)
    PARTY `the department` DOES `reduce the grant by half for one month` AT 40

-- s 46-292(G): evidence for a good cause claim on day 15 of 20.
#ASSERT EVALTRACE (`the time to support a good cause claim` `the applicant or recipient`) 0 (LIST EVENT `the applicant or recipient` `supply evidence supporting the good cause claim` 15) EQUALS FULFILLED
-- no evidence by day 20: breached.
-- expect: BREACH BY `the applicant or recipient` BECAUSE "s 46-292(G): no evidence for the good cause claim within 20 days"
#TRACE `the time to support a good cause claim` `the applicant or recipient` AT 0 WITH
    (WAITUNTIL 21)

-- s 46-292(S), (T).
#ASSERT EVALTRACE (`the duty on school attendance` `the applicant or recipient`) 0 (LIST EVENT `the applicant or recipient` `ensure the child is enrolled in and attending school` 5) EQUALS FULFILLED
#ASSERT EVALTRACE (`the duty on immunization` `the applicant or recipient`) 0 (LIST EVENT `the applicant or recipient` `ensure the child is immunized` 5) EQUALS FULFILLED

-- s 46-298(C): diversion benefits issued on working day 2; not by working day 3: the department is in breach.
#ASSERT EVALTRACE (`the duty to issue diversion benefits` `the department`) 0 (LIST EVENT `the department` `issue the diversion benefits` 2) EQUALS FULFILLED
-- expect: BREACH BY `the department` BECAUSE "s 46-298(C): diversion benefits not issued within three working days"
#TRACE `the duty to issue diversion benefits` `the department` AT 0 WITH
    (WAITUNTIL 4)
