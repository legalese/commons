IMPORT prelude
IMPORT `wa-tanf`

-- Washington TANF and WorkFirst (chapters 74.12 and 74.08A RCW) -- worked cases from the applicant's seat. Expected values were
-- worked by hand from the deposited text, never copied from the encoding's output. The payment standard ($600) and maximum
-- earned income level ($2,000) are HYPOTHETICAL (both are set by department rule, not deposited).

-- RCW 74.12.010, .035: dependent child. Arguments: age, lives with relative, placement, 18-year-old student, disabled student.
#ASSERT `Is my child a dependent child for Washington TANF` 10 TRUE FALSE FALSE FALSE
#ASSERT `Is my child a dependent child for Washington TANF` 18 TRUE FALSE TRUE FALSE
#ASSERT NOT (`Is my child a dependent child for Washington TANF` 19 TRUE FALSE TRUE FALSE)
#ASSERT NOT (`Is my child a dependent child for Washington TANF` 18 TRUE FALSE FALSE FALSE)
#ASSERT `Is my child a dependent child for Washington TANF` 20 TRUE FALSE FALSE TRUE
#ASSERT NOT (`Is my child a dependent child for Washington TANF` 21 TRUE FALSE FALSE TRUE)
#ASSERT NOT (`Is my child a dependent child for Washington TANF` 10 FALSE FALSE FALSE FALSE)
#ASSERT `Is my child a dependent child for Washington TANF` 10 FALSE TRUE FALSE FALSE

-- RCW 74.08A.230(1): the family keeps $500 and half the rest. $1,300 earned: (1,300 - 500) / 2 = 400 counts. $400: nothing.
#ASSERT `How much of our earnings counts` 1300 EQUALS 400
#ASSERT `How much of our earnings counts` 400 EQUALS 0

-- The grant. Arguments: standard, maximum earned income, gross earnings, passed-through support, from July 2029?, other.
-- Earnings $900 (counts 200) and $100 support before July 2029: countable 300; grant 600 - 300 = 300.
#ASSERT `What is our Washington TANF grant` 600 2000 900 100 FALSE 0 EQUALS `a monthly grant of` 300
-- The same from July 2029, when passed-through support is not counted: 400.
#ASSERT `What is our Washington TANF grant` 600 2000 900 100 TRUE 0 EQUALS `a monthly grant of` 400
-- Gross earnings $2,100 over the $2,000 level: not eligible.
#ASSERT `What is our Washington TANF grant` 600 2000 2100 0 FALSE 0 EQUALS `not eligible: gross earned income exceeds the department's maximum earned income level (RCW 74.08A.230(2))`
-- Gross earnings $1,800: counts 650, not below 600: not eligible.
#ASSERT `What is our Washington TANF grant` 600 2000 1800 0 FALSE 0 EQUALS `not eligible: countable income is not below the payment standard`
-- No income: the whole standard.
#ASSERT `What is our Washington TANF grant` 600 2000 0 0 FALSE 0 EQUALS `a monthly grant of` 600

-- RCW 74.08A.010: the 60 months. Arguments: months, homeless child, pandemic months, unemployment 7%+, family violence,
-- child under two with exemption, other hardship.
#ASSERT `Can we still receive Washington TANF` 40 FALSE 0 FALSE FALSE FALSE FALSE EQUALS `within the 60 months (RCW 74.08A.010(1))`
#ASSERT `Can we still receive Washington TANF` 60 FALSE 0 FALSE FALSE FALSE FALSE EQUALS `past 60 months and not exempt: no further TANF (RCW 74.08A.010(1))`
#ASSERT `Can we still receive Washington TANF` 60 TRUE 0 FALSE FALSE FALSE FALSE EQUALS `past 60 months, exempt under RCW 74.08A.010(4)`
-- Three months received since March 2020 at 7% unemployment extend the limit by three: month 61 is covered, month 64 is not.
#ASSERT `Can we still receive Washington TANF` 61 FALSE 3 FALSE FALSE FALSE FALSE EQUALS `past 60 months, exempt under RCW 74.08A.010(4)`
#ASSERT `Can we still receive Washington TANF` 64 FALSE 3 FALSE FALSE FALSE FALSE EQUALS `past 60 months and not exempt: no further TANF (RCW 74.08A.010(1))`
#ASSERT `Can we still receive Washington TANF` 70 FALSE 0 FALSE TRUE FALSE FALSE EQUALS `past 60 months, exempt under RCW 74.08A.010(4)`
#ASSERT `Can we still receive Washington TANF` 70 FALSE 0 TRUE FALSE FALSE FALSE EQUALS `past 60 months, exempt under RCW 74.08A.010(4)`

-- RCW 74.08A.010(6): transitional food assistance.
#ASSERT `How many months of transitional food assistance` TRUE FALSE EQUALS 5
#ASSERT `How many months of transitional food assistance` TRUE TRUE EQUALS 0
#ASSERT `How many months of transitional food assistance` FALSE FALSE EQUALS 0

-- RCW 74.08A.270: good cause. Arguments: child under six, care unavailable, child under two, months used, hardship.
#ASSERT `Do I have good cause for not taking part` TRUE TRUE FALSE 0 FALSE
#ASSERT NOT (`Do I have good cause for not taking part` TRUE FALSE FALSE 0 FALSE)
#ASSERT `Do I have good cause for not taking part` FALSE FALSE TRUE 23 FALSE
#ASSERT NOT (`Do I have good cause for not taking part` FALSE FALSE TRUE 24 FALSE)
#ASSERT `Do I have good cause for not taking part` FALSE FALSE FALSE 0 TRUE

-- RCW 74.08A.260(4): the sanction. Arguments: grant, my share, months, good cause, carer of a child under two.
#ASSERT `What happens if I do not engage in work activities` 500 200 1 FALSE FALSE EQUALS `no reduction yet: fewer than two months of continuous noncompliance`
-- Two months: the greater of my share (200) and 40% (200): 300.
#ASSERT `What happens if I do not engage in work activities` 500 200 2 FALSE FALSE EQUALS `the grant is reduced to` 300
-- My share $150: 40% ($200) is greater: 300. My share $250: 250.
#ASSERT `What happens if I do not engage in work activities` 500 150 5 FALSE FALSE EQUALS `the grant is reduced to` 300
#ASSERT `What happens if I do not engage in work activities` 500 250 5 FALSE FALSE EQUALS `the grant is reduced to` 250
#ASSERT `What happens if I do not engage in work activities` 500 200 12 FALSE FALSE EQUALS `the grant is terminated: twelve months of continuous noncompliance`
#ASSERT `What happens if I do not engage in work activities` 500 200 12 TRUE FALSE EQUALS `no sanction: good cause, or the requirement is suspended for a carer of a child under two`
#ASSERT `What happens if I do not engage in work activities` 500 200 12 FALSE TRUE EQUALS `no sanction: good cause, or the requirement is suspended for a carer of a child under two`

-- RCW 74.08A.210: diversion. Arguments: otherwise eligible, had it in 12 months, bona fide need, cost.
#ASSERT `How much diversion assistance can we get` TRUE FALSE TRUE 1500 EQUALS 1500
#ASSERT `How much diversion assistance can we get` TRUE FALSE TRUE 3000 EQUALS 2000
#ASSERT `How much diversion assistance can we get` TRUE TRUE TRUE 1500 EQUALS 0
#ASSERT `How much diversion assistance can we get` FALSE FALSE TRUE 1500 EQUALS 0
#ASSERT `How much diversion assistance can we get` TRUE FALSE FALSE 1500 EQUALS 0

-- RCW 74.08A.260(4) as a rule, in months.
-- expect: FULFILLED (engaged in month 1)
#TRACE `my WorkFirst participation duty` AT 0 WITH
    PARTY `the recipient` DOES `engage in the work and work activities the department requires` AT 1
-- expect: FULFILLED (engaged in month 5, after the grant was reduced, before termination)
#TRACE `my WorkFirst participation duty` AT 0 WITH
    (WAITUNTIL 3)
    PARTY `the recipient` DOES `engage in the work and work activities the department requires` AT 5
-- expect: BREACH by the recipient (twelve months: terminated). The stable l4 sees a deadline pass only at a later event, so the
-- trace waits to month 3 (the reduction begins) and then past month 12.
#TRACE `my WorkFirst participation duty` AT 0 WITH
    (WAITUNTIL 3)
    (WAITUNTIL 14)
