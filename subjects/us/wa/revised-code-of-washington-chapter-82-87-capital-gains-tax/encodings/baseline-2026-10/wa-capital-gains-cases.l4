IMPORT prelude
IMPORT `wa-capital-gains`

-- Washington capital gains tax (chapter 82.87 RCW) -- worked cases from the seller's seat. Expected values were worked by hand
-- from the deposited text, never copied from the encoding's output. Unless said otherwise the printed amounts are used:
-- standard deduction $250,000, charitable floor $250,000 and cap $100,000 (the Department's adjusted figures would change them).
--
-- Argument order of the tax question: year, federal net LTCG, losses from exempt/non-WA sales, gains from exempt/non-WA sales,
-- s 1256 gain, standard deduction, share, family business deduction, WA donations, charitable floor, cap, WA tax on assets
-- taxed elsewhere, tax paid elsewhere, B&O tax on the same sales.

-- No wage income tax.
#ASSERT NOT (`Does Washington tax my wages`)

-- RCW 82.87.020(11): resident.
-- Domiciled, but no permanent abode in Washington, a permanent abode elsewhere, and 20 days in the state: not a resident.
#ASSERT NOT (`Am I a Washington resident for capital gains tax` TRUE TRUE TRUE 20 FALSE)
-- The same with 40 days: a resident.
#ASSERT `Am I a Washington resident for capital gains tax` TRUE TRUE TRUE 40 FALSE
-- Not domiciled, an abode in the state and 184 days: a resident; 183 days: not.
#ASSERT `Am I a Washington resident for capital gains tax` FALSE FALSE FALSE 184 TRUE
#ASSERT NOT (`Am I a Washington resident for capital gains tax` FALSE FALSE FALSE 183 TRUE)

-- RCW 82.87.050: exemptions.
#ASSERT `Is my sale exempt from Washington capital gains tax` `real estate transferred by a recorded instrument` FALSE
#ASSERT `Is my sale exempt from Washington capital gains tax` `assets in a retirement account` FALSE
#ASSERT NOT (`Is my sale exempt from Washington capital gains tax` `stocks, bonds or other long-term capital assets` FALSE)
#ASSERT `Is my sale exempt from Washington capital gains tax` `cattle, horses or breeding livestock` TRUE
#ASSERT NOT (`Is my sale exempt from Washington capital gains tax` `cattle, horses or breeding livestock` FALSE)

-- RCW 82.87.100(1): allocation.
-- Shares sold while domiciled in Washington: allocated. After moving away: not.
#ASSERT `Is my gain allocated to Washington` TRUE TRUE FALSE FALSE TRUE FALSE
#ASSERT NOT (`Is my gain allocated to Washington` TRUE FALSE FALSE FALSE FALSE FALSE)
-- A painting sold while in Washington: allocated.
#ASSERT `Is my gain allocated to Washington` FALSE FALSE TRUE TRUE FALSE FALSE
-- A painting moved out before the sale, in the state earlier in the year, seller resident, no other tax: allocated; with another
-- state's tax on it: not.
#ASSERT `Is my gain allocated to Washington` FALSE TRUE FALSE TRUE TRUE FALSE
#ASSERT NOT (`Is my gain allocated to Washington` FALSE TRUE FALSE TRUE TRUE TRUE)

-- RCW 82.87.040, .060: the tax.
-- A: 2026, $400,000 of gains: 400,000 - 250,000 = 150,000 x 7% = 10,500.
#ASSERT `How much Washington capital gains tax do I owe` 2026 400000 0 0 0 250000 1 0 0 250000 100000 0 0 0 EQUALS 10500
-- B: $1,500,000: Washington capital gains 1,250,000; 87,500 + 2.9% x 250,000 = 7,250; 94,750. In 2024, before the 2.9%: 87,500.
#ASSERT `How much Washington capital gains tax do I owe` 2026 1500000 0 0 0 250000 1 0 0 250000 100000 0 0 0 EQUALS 94750
#ASSERT `How much Washington capital gains tax do I owe` 2024 1500000 0 0 0 250000 1 0 0 250000 100000 0 0 0 EQUALS 87500
-- C: $700,000 federal, of which $300,000 is from real estate (exempt): adjusted 400,000; tax 10,500.
#ASSERT `How much Washington capital gains tax do I owe` 2026 700000 0 300000 0 250000 1 0 0 250000 100000 0 0 0 EQUALS 10500
-- D: charity. $400,000 of gains, $400,000 given: 150,000 over the floor, capped at 100,000: 50,000 x 7% = 3,500.
#ASSERT `How much Washington capital gains tax do I owe` 2026 400000 0 0 0 250000 1 0 400000 250000 100000 0 0 0 EQUALS 3500
-- $300,000 given: 50,000 deductible: 100,000 x 7% = 7,000.
#ASSERT `How much Washington capital gains tax do I owe` 2026 400000 0 0 0 250000 1 0 300000 250000 100000 0 0 0 EQUALS 7000
-- E: $200,000 of gains, under the standard deduction: nil.
#ASSERT `How much Washington capital gains tax do I owe` 2026 200000 0 0 0 250000 1 0 0 250000 100000 0 0 0 EQUALS 0
-- F: spouses filing separately with half the deduction each: $300,000 - 125,000 = 175,000 x 7% = 12,250.
#ASSERT `How much Washington capital gains tax do I owe` 2026 300000 0 0 0 250000 0.5 0 0 250000 100000 0 0 0 EQUALS 12250
-- G: credits. Facts of A; $2,000 of the Washington tax comes from assets another state taxed, which got $1,500: credit 1,500;
-- tax 9,000. With $500 of B&O tax on the same sales in 2026: 8,500. The B&O credit begins with 2025.
#ASSERT `How much Washington capital gains tax do I owe` 2026 400000 0 0 0 250000 1 0 0 250000 100000 2000 1500 0 EQUALS 9000
#ASSERT `How much Washington capital gains tax do I owe` 2026 400000 0 0 0 250000 1 0 0 250000 100000 2000 1500 500 EQUALS 8500
#ASSERT `How much Washington capital gains tax do I owe` 2024 400000 0 0 0 250000 1 0 0 250000 100000 2000 1500 500 EQUALS 9000
-- H: a $100,000 loss on exempt real estate inside a $300,000 federal figure is added back: 400,000; tax 10,500.
#ASSERT `How much Washington capital gains tax do I owe` 2026 300000 100000 0 0 250000 1 0 0 250000 100000 0 0 0 EQUALS 10500
-- I: a HYPOTHETICAL adjusted standard deduction of $270,000: 130,000 x 7% = 9,100.
#ASSERT `How much Washington capital gains tax do I owe` 2026 400000 0 0 0 270000 1 0 0 250000 100000 0 0 0 EQUALS 9100
-- A family business sale: $2,000,000 of gain wholly deductible under 82.87.070: nil.
#ASSERT `How much Washington capital gains tax do I owe` 2026 2000000 0 0 0 250000 1 2000000 0 250000 100000 0 0 0 EQUALS 0

-- RCW 82.87.110, .120: returns.
#ASSERT `Must I file a Washington capital gains return` 10500
#ASSERT NOT (`Must I file a Washington capital gains return` 0)
#ASSERT `Must we file a joint capital gains return` TRUE FALSE
#ASSERT `Must we file a joint capital gains return` FALSE TRUE
#ASSERT NOT (`Must we file a joint capital gains return` FALSE FALSE)
-- RCW 82.87.110(6): late filing penalty on $10,000 of tax: 3 months 1,500; 7 months capped at 25%, 2,500; waived: nil.
#ASSERT `How much is my late filing penalty` 10000 3 FALSE EQUALS 1500
#ASSERT `How much is my late filing penalty` 10000 7 FALSE EQUALS 2500
#ASSERT `How much is my late filing penalty` 10000 3 TRUE EQUALS 0

-- Filing: federal due date day 105; with a federal extension shown in time, day 288.
-- expect: FULFILLED (filed on day 200 within the extension)
#TRACE `my duty to file the capital gains return` 105 288 AT 0 WITH
    PARTY `the taxpayer` DOES `file the capital gains return with a copy of the federal return` AT 200
-- expect: BREACH by the taxpayer (no extension; day 200 is late)
#TRACE `my duty to file the capital gains return` 105 0 AT 0 WITH
    PARTY `the taxpayer` DOES `file the capital gains return with a copy of the federal return` AT 200
-- Payment: the extension does not move it.
-- expect: FULFILLED
#TRACE `my duty to pay the capital gains tax` 105 AT 0 WITH
    PARTY `the taxpayer` DOES `pay the capital gains tax` AT 100
-- expect: BREACH by the taxpayer (paid on day 110)
#TRACE `my duty to pay the capital gains tax` 105 AT 0 WITH
    PARTY `the taxpayer` DOES `pay the capital gains tax` AT 110
-- Amendment within 90 days of a final federal change.
-- expect: FULFILLED
#TRACE `my duty to amend after a federal change` AT 0 WITH
    PARTY `the taxpayer` DOES `file an amended capital gains return` AT 80
-- expect: BREACH by the taxpayer (penalty from day 91)
#TRACE `my duty to amend after a federal change` AT 0 WITH
    (WAITUNTIL 91)
