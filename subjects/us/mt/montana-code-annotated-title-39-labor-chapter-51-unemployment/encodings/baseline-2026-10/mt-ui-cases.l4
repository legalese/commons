IMPORT prelude
IMPORT `mt-ui`
IMPORT `mt-ui-seat`

-- Montana unemployment insurance -- worked cases, from the claimant's seat.
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Expected values were worked by hand
-- from the deposited text (MCA 2025, Title 39 ch. 51 parts 2, 21, 22, 23), never copied from the encoding's output.
-- HYPOTHETICAL figures throughout: an average annual wage of $60,000 (average weekly wage $1,153.85; under Schedule II
-- or higher, maximum 66.5% = $767.31025 and minimum 19% = $219.2315; under Schedule I, 67.5% = $778.84875) -- not the
-- department's published figure.

-- Ana: quarters (oldest first) 10,000 / 12,000 / 11,000 / 9,000 / 8,000. Regular base period 42,000, high quarter
-- 12,000, two highest 23,000. 42,000 >= 1.5 x 12,000 and >= 7% of 60,000: qualifies on the regular base period.
#ASSERT `Do my wages qualify me for benefits` 10000 12000 11000 9000 8000 60000 EQUALS `the regular base period (the first 4 of the last 5 completed quarters)`
-- 1% of 42,000 = 420; 1.9% of 23,000 = 437: the greater, 437.
#ASSERT `What is my weekly benefit amount` 10000 12000 11000 9000 8000 60000 FALSE EQUALS JUST 437
-- Ratio 42,000 / 12,000 = 3.5: 24 weeks; 437 x 24 = 10,488.
#ASSERT `How many weeks of benefits can I get` 10000 12000 11000 9000 8000 60000 EQUALS JUST 24
#ASSERT `What is my maximum benefit amount` 10000 12000 11000 9000 8000 60000 FALSE EQUALS JUST 10488

-- Ben: 30,000 a quarter. 1% of 120,000 = 1,200, over the maximum: 767.31025 (Schedule II+), 778.84875 (Schedule I).
#ASSERT `What is my weekly benefit amount` 30000 30000 30000 30000 30000 60000 FALSE EQUALS JUST 767.31025
#ASSERT `What is my weekly benefit amount` 30000 30000 30000 30000 30000 60000 TRUE EQUALS JUST 778.84875

-- Cal: 0 / 0 / 0 / 5,000 / 3,000. Regular base period 5,000 < 1.5 x 5,000 and < 30,000: fails. Alternative (most recent
-- 4) 8,000 >= 7,500 and >= 4,200: qualifies. 1.9% of 8,000 = 152, below the minimum: 219.2315. Ratio 1.6: 12 weeks.
#ASSERT `Do my wages qualify me for benefits` 0 0 0 5000 3000 60000 EQUALS `the alternative base period (the 4 most recently completed quarters)`
#ASSERT `What is my weekly benefit amount` 0 0 0 5000 3000 60000 FALSE EQUALS JUST 219.2315
#ASSERT `How many weeks of benefits can I get` 0 0 0 5000 3000 60000 EQUALS JUST 12

-- Dee: only 2,000 in the latest quarter: 2,000 < 1.5 x 2,000 and < 30,000 on either base period: no benefits.
#ASSERT `Do my wages qualify me for benefits` 0 0 0 0 2000 60000 EQUALS `neither: the wages do not qualify`
#ASSERT `What is my weekly benefit amount` 0 0 0 0 2000 60000 FALSE EQUALS NOTHING

-- Eve: one quarter of 31,000. Fails 1.5 x high quarter, but 31,000 >= 50% of 60,000 qualifies (39-51-2105(2)).
-- 1.9% of 31,000 = 589; ratio 1.0: 8 weeks.
#ASSERT `Do my wages qualify me for benefits` 0 0 0 31000 0 60000 EQUALS `the regular base period (the first 4 of the last 5 completed quarters)`
#ASSERT `What is my weekly benefit amount` 0 0 0 31000 0 60000 FALSE EQUALS JUST 589
#ASSERT `How many weeks of benefits can I get` 0 0 0 31000 0 60000 EQUALS JUST 8

-- One week, weekly benefit amount 437.
-- No work, every condition met: 437.
#ASSERT `How much will I be paid for this week` 437 0 0 FALSE 0 0 TRUE TRUE TRUE TRUE EQUALS 437
-- 10 hours for lack of work, $300.70 earned: 300 - 109 (one-fourth of 437, rounded down) = 191; 437 - 95.50 = 341.50.
#ASSERT `How much will I be paid for this week` 437 10 300.7 TRUE 0 0 TRUE TRUE TRUE TRUE EQUALS 341.5
-- $900 earned, at least twice 437: not unemployed, nothing.
#ASSERT `How much will I be paid for this week` 437 20 900 TRUE 0 0 TRUE TRUE TRUE TRUE EQUALS 0
-- 40 hours: never unemployed (39-51-2101(2)).
#ASSERT `How much will I be paid for this week` 437 40 400 TRUE 0 0 TRUE TRUE TRUE TRUE EQUALS 0
-- Unavailable 2 days: 437 less two-fifths = 262.20; 3 days: nothing (39-51-2104(2)).
#ASSERT `How much will I be paid for this week` 437 0 0 FALSE 2 0 TRUE TRUE TRUE TRUE EQUALS 262.2
#ASSERT `How much will I be paid for this week` 437 0 0 FALSE 3 0 TRUE TRUE TRUE TRUE EQUALS 0
-- The waiting week not yet served: nothing (39-51-2104(1)(c)).
#ASSERT `How much will I be paid for this week` 437 0 0 FALSE 0 0 TRUE TRUE FALSE TRUE EQUALS 0
-- A $100 weekly pension from a base-period employer's plan: 337 (39-51-2203).
#ASSERT `How much will I be paid for this week` 437 0 0 FALSE 0 100 TRUE TRUE TRUE TRUE EQUALS 337

-- How the job ended, weekly benefit amount 437.
#ASSERT `Am I disqualified by how my job ended` `I quit without good cause attributable to my employment` FALSE FALSE FALSE 437 EQUALS `disqualified until I earn, after the week of the act, wages of at least` 2622
#ASSERT `Am I disqualified by how my job ended` `I quit without good cause attributable to my employment` TRUE FALSE FALSE 437 EQUALS `not disqualified`
#ASSERT `Am I disqualified by how my job ended` `I quit without good cause attributable to my employment` FALSE TRUE FALSE 437 EQUALS `not disqualified`
#ASSERT `Am I disqualified by how my job ended` `discharged for misconduct` FALSE FALSE FALSE 437 EQUALS `disqualified until I earn, after the week of the act, wages of at least` 3496
#ASSERT `Am I disqualified by how my job ended` `discharged for gross misconduct, as the department determines` FALSE FALSE FALSE 437 EQUALS `disqualified for 52 weeks`
#ASSERT `Am I disqualified by how my job ended` `discharged for failing or refusing an employer drug test under a written policy` FALSE FALSE FALSE 437 EQUALS `disqualified, with no end stated in the text`
#ASSERT `Am I disqualified by how my job ended` `discharged for failing or refusing an employer drug test under a written policy` FALSE FALSE TRUE 437 EQUALS `not disqualified`
#ASSERT `Am I disqualified by how my job ended` `laid off for lack of work` FALSE FALSE FALSE 437 EQUALS `not disqualified`

-- Refusing a job offer, weekly benefit amount 437.
-- Suitable as the department finds, no good cause: disqualified until 2,622 earned, maximum benefit amount cut 2,622.
#ASSERT `Will I lose benefits if I refuse this job` FALSE FALSE FALSE TRUE 5 1 FALSE FALSE 437 EQUALS `disqualified for the week and until I earn wages of at least this, and my maximum benefit amount is cut by the same` 2622
-- Vacant because of a strike: never suitable.
#ASSERT `Will I lose benefits if I refuse this job` TRUE FALSE FALSE TRUE 5 1 FALSE FALSE 437 EQUALS `not disqualified: the work offered is not suitable work`
-- After 14 weeks, an offer at 80% of old pay is suitable even without the department's finding; at 13 weeks it is not.
#ASSERT `Will I lose benefits if I refuse this job` FALSE FALSE FALSE FALSE 14 0.8 FALSE FALSE 437 EQUALS `disqualified for the week and until I earn wages of at least this, and my maximum benefit amount is cut by the same` 2622
#ASSERT `Will I lose benefits if I refuse this job` FALSE FALSE FALSE FALSE 13 0.8 FALSE FALSE 437 EQUALS `not disqualified: the work offered is not suitable work`
-- Below the federal minimum wage: not suitable.
#ASSERT `Will I lose benefits if I refuse this job` FALSE FALSE FALSE TRUE 20 0.8 TRUE FALSE 437 EQUALS `not disqualified: the work offered is not suitable work`
-- Suitable but good cause: not disqualified.
#ASSERT `Will I lose benefits if I refuse this job` FALSE FALSE FALSE TRUE 5 1 FALSE TRUE 437 EQUALS `not disqualified: I had good cause`

-- Paying back (39-51-2306(2)).
#ASSERT `Must I repay the benefits for that week` TRUE
#ASSERT (NOT (`Must I repay the benefits for that week` FALSE))

-- The duties at a new claim (day 0 = the day of filing).
#ASSERT EVALTRACE `the duties when I file a new claim` 0 (LIST (EVENT `the claimant` `disclose whether I owe an uncollected food stamp overissuance` 0), (EVENT `the department of labor and industry` `advise that benefits are federally taxable, that estimated tax rules exist, and that federal withholding may be elected or changed` 0), (EVENT `the claimant` `elect federal income tax withholding from benefits` 0)) EQUALS FULFILLED
#ASSERT EVALTRACE `the duty to repay a doubly paid week` 0 (LIST (EVENT `the claimant` `repay the unemployment benefits for the week` 30)) EQUALS FULFILLED
-- expect: BREACH by the department of labor and industry (no advice at filing)
#TRACE `the duties when I file a new claim` AT 0 WITH
    PARTY `the claimant` DOES `disclose whether I owe an uncollected food stamp overissuance` AT 0
    (WAITUNTIL 1)
