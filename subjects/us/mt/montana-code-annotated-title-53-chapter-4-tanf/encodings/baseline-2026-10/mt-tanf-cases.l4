IMPORT prelude
IMPORT `mt-tanf`
IMPORT `mt-tanf-seat`

-- Montana TANF cash assistance -- worked cases, from the applicant's seat. HYPOTHETICAL people. Expected values written
-- by hand from the deposited text (MCA 2025, Title 53 ch. 4 parts 2 and 6), never copied from output.

-- Dependent child (53-4-201(5)).
#ASSERT `Is this child a dependent child` 17 FALSE TRUE
#ASSERT `Is this child a dependent child` 18 TRUE TRUE
#ASSERT (NOT (`Is this child a dependent child` 18 FALSE TRUE))
#ASSERT (NOT (`Is this child a dependent child` 19 TRUE TRUE))
#ASSERT (NOT (`Is this child a dependent child` 10 FALSE FALSE))

-- Maria: two children, cooperating, 20 months of past TANF: may be granted.
#ASSERT `Can my family be granted TANF cash assistance` TRUE 0 TRUE TRUE TRUE 20 FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `assistance may be granted (there is no entitlement: 53-4-231(6))`
-- 60 months reached, in any state: the family is barred (53-4-231(5)).
#ASSERT `Can my family be granted TANF cash assistance` TRUE 0 TRUE TRUE TRUE 60 FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `the family is not eligible: an adult has received 60 months of TANF-funded cash assistance (53-4-231(5))`
-- Child support not assigned: the family is barred (53-4-231(4)(d)).
#ASSERT `Can my family be granted TANF cash assistance` TRUE 0 TRUE TRUE FALSE 0 FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `the family is not eligible: support rights not assigned, or no cooperation on paternity or child support (53-4-231(4)(d))`
-- No individual responsibility plan when required: barred (53-4-231(4)(e)).
#ASSERT `Can my family be granted TANF cash assistance` TRUE 0 FALSE TRUE TRUE 0 FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `the family is not eligible: no cooperation in screening or assessment, or no individual responsibility plan (53-4-231(1)(b), (4)(e))`
-- Receives SSI: this person is not eligible (53-4-231(4)(a)).
#ASSERT `Can my family be granted TANF cash assistance` TRUE 0 TRUE TRUE TRUE 0 TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `this person is not eligible (53-4-231(2), (3) or (4))`
-- A fugitive felon: not eligible (53-4-231(4)(h)).
#ASSERT `Can my family be granted TANF cash assistance` TRUE 0 TRUE TRUE TRUE 0 FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS `this person is not eligible (53-4-231(2), (3) or (4))`
-- Pregnant, no other children, due in 3 months: may be granted; due in 5 months: not yet (53-4-231(1)(e)).
#ASSERT `Can my family be granted TANF cash assistance` TRUE 3 TRUE TRUE TRUE 0 FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `assistance may be granted (there is no entitlement: 53-4-231(6))`
#ASSERT `Can my family be granted TANF cash assistance` TRUE 5 TRUE TRUE TRUE 0 FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `the family is not eligible: no dependent child in the home, and not a needy pregnant woman within 3 months of the birth`
-- No dependent child, not pregnant.
#ASSERT `Can my family be granted TANF cash assistance` FALSE 0 TRUE TRUE TRUE 0 FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS `the family is not eligible: no dependent child in the home, and not a needy pregnant woman within 3 months of the birth`

-- Child support pass-through (53-4-260): $60 collected -> 60; $250 -> 100; arrears are not entered.
#ASSERT `How much child support is passed through to us` 60 EQUALS 60
#ASSERT `How much child support is passed through to us` 250 EQUALS 100

-- Child care (53-4-611).
#ASSERT `May we get child-care assistance` TRUE TRUE
#ASSERT (NOT (`May we get child-care assistance` FALSE TRUE))

-- The application and what follows (53-4-232, 53-4-233). Found eligible: the department must furnish aid.
#ASSERT EVALTRACE (`what follows my application` TRUE) 0 (LIST (EVENT `the applicant` `apply to the department, as the relative the child lives or will live with` 0), (EVENT `the department of public health and human services` `inform the applicant of the right to a fair hearing and of confidentiality` 1), (EVENT `the applicant` `participate in the required screening` 5), (EVENT `the department of public health and human services` `make an eligibility determination and notify the applicant in writing` 20), (EVENT `the department of public health and human services` `furnish aid promptly` 25)) EQUALS FULFILLED
-- Found not eligible: written notice ends it.
#ASSERT EVALTRACE (`what follows my application` FALSE) 0 (LIST (EVENT `the applicant` `apply to the department, as the relative the child lives or will live with` 0), (EVENT `the department of public health and human services` `inform the applicant of the right to a fair hearing and of confidentiality` 1), (EVENT `the applicant` `participate in the required screening` 5), (EVENT `the department of public health and human services` `make an eligibility determination and notify the applicant in writing` 20)) EQUALS FULFILLED
-- Employment and training (53-4-613): not required -> nothing owed; required and done in time -> fulfilled.
#ASSERT EVALTRACE (`the employment and training condition` FALSE 30) 0 (LIST (EVENT `the applicant` `participate in employment and training` 1)) EQUALS FULFILLED
#ASSERT EVALTRACE (`the employment and training condition` TRUE 30) 0 (LIST (EVENT `the applicant` `participate in employment and training` 10)) EQUALS FULFILLED
-- expect: BREACH by the applicant (required, did not take part within the 30 days allowed)
#TRACE (`the employment and training condition` TRUE 30) AT 0 WITH
    (WAITUNTIL 31)
