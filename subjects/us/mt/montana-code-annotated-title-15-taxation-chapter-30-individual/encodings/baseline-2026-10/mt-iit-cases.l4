IMPORT prelude
IMPORT daydate
IMPORT `mt-iit`
IMPORT `mt-iit-seat`

-- Montana individual income tax -- worked cases, from the taxpayer's seat.
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Expected values were worked by hand
-- from the deposited text (MCA 2025, parts 21 and 23 of Title 15 ch. 30), never copied from the encoding's output.
-- All people and figures are HYPOTHETICAL. Figures the department indexes each year (the age 65 subtraction, brackets
-- after 2027) are given as hypothetical inputs, not as the department's published figures.

-- Residence (15-30-2101(31)).
#ASSERT `Am I a Montana resident` TRUE FALSE FALSE
#ASSERT `Am I a Montana resident` FALSE TRUE FALSE
#ASSERT (NOT (`Am I a Montana resident` FALSE TRUE TRUE))
#ASSERT (NOT (`Am I a Montana resident` FALSE FALSE FALSE))

-- 15-30-2112: a change of residence status during the year means a return must be filed.
#ASSERT `Must I file because I moved into or out of Montana` TRUE

-- Montana taxable income. Single, federal taxable income $50,000; itemized $20,000 against a $16,100 standard deduction,
-- with $5,000 of state income tax itemized: the add-back is the lesser of $5,000 and $3,900 = $3,900. QBI deduction
-- $1,000 added back; other-state bond interest $500. Subtract US bond interest $200, one taxpayer 65+ at a hypothetical
-- $5,500, and ABLE contributions of $4,000 capped at $3,000. 50,000 + 500 + 1,000 + 3,900 - (200 + 5,500 + 3,000) = 46,700.
#ASSERT `What is my Montana taxable income` `single` 50000 5000 20000 16100 1000 500 0 200 0 1 5500 4000 0 EQUALS 46700
-- Joint, $80,000, standard deduction taken, both 65+ (2 x 5,500), ABLE $7,000 capped at $6,000: 80,000 - 17,000 = 63,000.
#ASSERT `What is my Montana taxable income` `married filing jointly or surviving spouse` 80000 0 0 32200 0 0 0 0 0 2 5500 7000 0 EQUALS 63000

-- Rates, tax year 2026 (temporary 15-30-2103). Single, $60,000: 4.7% x 47,500 + 5.65% x 12,500 = 2,232.50 + 706.25.
#ASSERT `How much Montana tax do I owe before credits` 2026 `single` 60000 0 TRUE 0 0 0 EQUALS `answered` 2938.75
-- Joint, $200,000 with $30,000 of long-term gains: nonqualified $170,000 is over $95,000, so all gains at 4.1%.
-- 4.7% x 95,000 + 5.65% x 75,000 + 4.1% x 30,000 = 4,465 + 4,237.50 + 1,230 = 9,932.50.
#ASSERT `How much Montana tax do I owe before credits` 2026 `married filing jointly or surviving spouse` 200000 30000 TRUE 0 0 0 EQUALS `answered` 9932.5
-- Single, $50,000 with $10,000 of gains: nonqualified $40,000 at 4.7% = 1,880; gains: 7,500 at 3.0% = 225 and 2,500 at
-- 4.1% = 102.50. Total 2,207.50.
#ASSERT `How much Montana tax do I owe before credits` 2026 `single` 50000 10000 TRUE 0 0 0 EQUALS `answered` 2207.5
-- Head of household 2026, $71,250 exactly: all at 4.7% = 3,348.75.
#ASSERT `How much Montana tax do I owe before credits` 2026 `head of household` 71250 0 TRUE 0 0 0 EQUALS `answered` 3348.75
-- Married filing separately 2026, $47,501: 2,232.50 + 0.0565 = 2,232.5565.
#ASSERT `How much Montana tax do I owe before credits` 2026 `married filing separately` 47501 0 TRUE 0 0 0 EQUALS `answered` 2232.5565

-- Tax year 2027 (15-30-2103 effective 1 January 2027; factor 1 for 2027). Head of household, $100,000:
-- 4.7% x 97,500 + 5.4% x 2,500 = 4,582.50 + 135 = 4,717.50.
#ASSERT `How much Montana tax do I owe before credits` 2027 `head of household` 100000 0 TRUE 0 0 0 EQUALS `answered` 4717.5
-- Tax year 2028, single, a hypothetical published ceiling of $67,000, income $70,000: 3,149 + 162 = 3,311.
#ASSERT `How much Montana tax do I owe before credits` 2028 `single` 70000 0 TRUE 0 0 67000 EQUALS `answered` 3311
-- Not covered: 2028 with no published bracket, and any year before 2026.
#ASSERT `How much Montana tax do I owe before credits` 2028 `single` 70000 0 TRUE 0 0 0 EQUALS `not covered` `tax years after 2027: the brackets are the department's inflation-adjusted brackets under 15-30-2103(3), and none was given`
#ASSERT `How much Montana tax do I owe before credits` 2025 `single` 70000 0 TRUE 0 0 0 EQUALS `not covered` `tax years before 2026: only the 2026 (temporary) and 2027 versions of 15-30-2103 are deposited`

-- Nonresident (15-30-2104(1)(a)): single 2026, $60,000 in all, $30,000 of it Montana source: 2,938.75 x 1/2.
#ASSERT `How much Montana tax do I owe before credits` 2026 `single` 60000 0 FALSE 30000 60000 0 EQUALS `answered` 1469.375

-- Earned income tax credit (15-30-2318): 20% of a $600 federal credit = 120; with a quarter of the earned income from a
-- 501(d) organization, 120 x 0.75 = 90; a nonresident gets none.
#ASSERT `How much is my Montana earned income tax credit` TRUE 600 10000 0 EQUALS 120
#ASSERT `How much is my Montana earned income tax credit` TRUE 600 10000 2500 EQUALS 90
#ASSERT `How much is my Montana earned income tax credit` FALSE 600 10000 0 EQUALS 0

-- Elderly credit eligibility (15-30-2338).
#ASSERT `Am I eligible for the elderly credit` TRUE 12 12 20000 FALSE FALSE
#ASSERT (NOT (`Am I eligible for the elderly credit` TRUE 8 12 20000 FALSE FALSE))
#ASSERT (NOT (`Am I eligible for the elderly credit` TRUE 12 5 20000 FALSE FALSE))
#ASSERT (NOT (`Am I eligible for the elderly credit` FALSE 12 12 20000 FALSE FALSE))
#ASSERT (NOT (`Am I eligible for the elderly credit` TRUE 12 12 45000 FALSE FALSE))
#ASSERT (NOT (`Am I eligible for the elderly credit` TRUE 12 12 20000 TRUE FALSE))

-- Elderly credit amount (15-30-2340).
-- Owner, gross household income $20,000: household income 7,400, reduction 0.035 x 7,400 = 259; tax billed $1,500 less
-- 259 = 1,241, capped at $1,150.
#ASSERT `How much is my elderly credit` TRUE 12 12 20000 1500 0 TRUE FALSE FALSE EQUALS 1150
-- Renter, gross $15,000, rent $6,000: rent-equivalent tax 900; household income 2,400, reduction 0.006 x 2,400 = 14.40.
#ASSERT `How much is my elderly credit` TRUE 12 12 15000 0 6000 TRUE FALSE FALSE EQUALS 885.6
-- Owner, gross $38,000, tax billed $2,000: household income 25,400, reduction 0.05 x 25,400 = 1,270; 730 x 30% = 219.
#ASSERT `How much is my elderly credit` TRUE 12 12 38000 2000 0 TRUE FALSE FALSE EQUALS 219
-- Gross $12,000: household income is negative, no reduction; rent $4,000 gives 600.
#ASSERT `How much is my elderly credit` TRUE 12 12 12000 0 4000 TRUE FALSE FALSE EQUALS 600
-- Owns part and rents part, gross $20,000 (reduction 259 from each portion): owned 800 - 259 = 541; rented
-- 15% x 2,000 = 300 - 259 = 41; total 582.
#ASSERT `How much is my elderly credit` TRUE 12 12 20000 800 2000 TRUE FALSE FALSE EQUALS 582
-- Renting a dwelling not subject to Montana property tax: nothing on the rent (15-30-2341(3)).
#ASSERT `How much is my elderly credit` TRUE 12 12 15000 0 6000 FALSE FALSE FALSE EQUALS 0
-- Gross $45,000: not eligible, 0.
#ASSERT `How much is my elderly credit` TRUE 12 12 45000 2000 0 TRUE FALSE FALSE EQUALS 0

-- The claim deadline (15-30-2339(1)) and the 3-year revision (15-30-2339(5)).
#ASSERT `By when must I claim the elderly credit` TRUE (Date 15 4 2027) 2026 NOTHING EQUALS Date 15 4 2027
#ASSERT `By when must I claim the elderly credit` FALSE (Date 1 1 2027) 2026 NOTHING EQUALS Date 15 4 2027
#ASSERT `By when must I claim the elderly credit` FALSE (Date 1 1 2027) 2026 (JUST (Date 16 4 2027)) EQUALS Date 16 4 2027
#ASSERT `Until when may I revise and claim the elderly credit` (Date 15 4 2027) EQUALS Date 15 4 2030

-- The duties, traced in days from the end of the tax year (105 days to a hypothetical 15 April due date).
#ASSERT EVALTRACE (`the duty to file on a change of residence` 105) 0 (LIST (EVENT `the taxpayer` `file a Montana income tax return` 100)) EQUALS FULFILLED
#ASSERT EVALTRACE (`the elderly credit claim deadline` 105) 0 (LIST (EVENT `the claimant` `submit the elderly credit claim with the property tax or rent receipt` 30)) EQUALS FULFILLED
-- expect: BREACH by the taxpayer (no return by day 105)
#TRACE (`the duty to file on a change of residence` 105) AT 0 WITH
    (WAITUNTIL 106)
-- expect: BREACH by the claimant (the claim was not submitted in time)
#TRACE (`the elderly credit claim deadline` 105) AT 0 WITH
    (WAITUNTIL 200)

-- The bottom line. Single 2026, $60,000, resident: 2,938.75 less a $120 earned income credit = 2,818.75.
#ASSERT `What do I owe Montana after refundable credits` 2026 `single` 60000 0 TRUE 0 0 0 120 0 EQUALS `answered` 2818.75
-- Single 2026, $10,000: 470 less a $600 earned income credit = a $130 refund.
#ASSERT `What do I owe Montana after refundable credits` 2026 `single` 10000 0 TRUE 0 0 0 600 0 EQUALS `answered` (0 MINUS 130)
