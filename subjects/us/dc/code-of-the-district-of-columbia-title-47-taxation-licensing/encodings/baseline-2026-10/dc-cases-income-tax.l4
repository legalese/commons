IMPORT prelude
IMPORT daydate
IMPORT `dc-income-tax`

-- District of Columbia income tax -- worked cases from the seat of the resident taxpayer. Every assertion is a claim about the
-- ENCODING on stated facts, not about the law. Nothing here has been checked against an Office of Tax and Revenue form or
-- table. Expected results were worked by hand from the deposited text. Federal figures (the standard deduction, the s 151
-- exemption amount, the s 32 childless figures) are HYPOTHETICAL inputs, not the real ones for any year.

§ `Cases`

§§ `s 47-1801.04(42) -- resident`

#ASSERT `Am I a DC resident for income tax` TRUE 0 FALSE
#ASSERT `Am I a DC resident for income tax` FALSE 183 FALSE
#ASSERT NOT (`Am I a DC resident for income tax` FALSE 182 FALSE)
-- A Senate-confirmed appointee with a DC apartment all year, not domiciled here: excluded.
#ASSERT NOT (`Am I a DC resident for income tax` FALSE 365 TRUE)
-- The same appointee, domiciled here at some time in the year: "unless ... domiciled within the District".
#ASSERT `Am I a DC resident for income tax` TRUE 365 TRUE

§§ `s 47-1805.02(1) -- who must file`

#ASSERT `Must I file a DC return` TRUE TRUE
#ASSERT NOT (`Must I file a DC return` TRUE FALSE)

§§ `s 47-1806.03(a)(11) -- the table`

-- 4% of 5,000.
#ASSERT `What is the DC tax on my taxable income` 5000 EQUALS 200
-- $400 + 6% of 20,000 = 1,600.
#ASSERT `What is the DC tax on my taxable income` 30000 EQUALS 1600
-- $2,200 + 6.5% of 10,000 = 2,850.
#ASSERT `What is the DC tax on my taxable income` 50000 EQUALS 2850
-- $3,500 + 8.5% of 40,000 = 6,900.
#ASSERT `What is the DC tax on my taxable income` 100000 EQUALS 6900
-- $19,650 + 9.25% of 50,000 = 24,275.
#ASSERT `What is the DC tax on my taxable income` 300000 EQUALS 24275
-- $91,525 + 10.75% of 1,000,000 = 199,025.
#ASSERT `What is the DC tax on my taxable income` 2000000 EQUALS 199025
-- Exactly $40,000: the "Over $10,000 but not over $40,000" row: 400 + 1,800 = 2,200.
#ASSERT `What is the DC tax on my taxable income` 40000 EQUALS 2200

§§ `s 47-1806.02 -- personal exemptions (HYPOTHETICAL federal amount $4,000)`

-- Two exemptions, AGI $100,000: no phase-out: 8,000.
#ASSERT `the DC personal exemptions for` 2 `of` 4000 `at adjusted gross income` 100000 `when another's dependent` FALSE EQUALS 8000
-- AGI $160,000: 10,000 over is 4 steps of $2,500: 8% off: 7,360.
#ASSERT `the DC personal exemptions for` 2 `of` 4000 `at adjusted gross income` 160000 `when another's dependent` FALSE EQUALS 7360
-- AGI $200,000: 20 steps: 40% off: 4,800.
#ASSERT `the DC personal exemptions for` 2 `of` 4000 `at adjusted gross income` 200000 `when another's dependent` FALSE EQUALS 4800
-- AGI $275,000: 50 steps: 100% off. Over $275,000: none either.
#ASSERT `the DC personal exemptions for` 2 `of` 4000 `at adjusted gross income` 275000 `when another's dependent` FALSE EQUALS 0
#ASSERT `the DC personal exemptions for` 2 `of` 4000 `at adjusted gross income` 275001 `when another's dependent` FALSE EQUALS 0
-- Claimable as another's dependent: zero (s 47-1806.02(h)).
#ASSERT `the DC personal exemptions for` 1 `of` 4000 `at adjusted gross income` 10000 `when another's dependent` TRUE EQUALS 0
-- A federal exemption amount of nil gives nil, however many exemptions (finding 2).
#ASSERT `the DC personal exemptions for` 3 `of` 0 `at adjusted gross income` 50000 `when another's dependent` FALSE EQUALS 0

§§ `s 47-1806.04(f) -- the DC EITC`

-- With a qualifying child, federal credit $5,000: 2024 70% = 3,500; 2025 85% = 4,250; 2029 100% = 5,000.
#ASSERT `How much DC EITC with a qualifying child` 2024 5000 EQUALS 3500
#ASSERT `How much DC EITC with a qualifying child` 2025 5000 EQUALS 4250
#ASSERT `How much DC EITC with a qualifying child` 2029 5000 EQUALS 5000
-- No qualifying child (HYPOTHETICAL federal figures 7.65% and $8,490, DC phaseout amount $20,000): earned $10,000: 7.65% of
-- 8,490 = 649.485; no phaseout.
#ASSERT `How much DC EITC with no qualifying child` 10000 10000 (7.65%) 8490 20000 EQUALS 649.485
-- Earned $25,000: less 8.48% of 5,000 (424): 225.485.
#ASSERT `How much DC EITC with no qualifying child` 25000 25000 (7.65%) 8490 20000 EQUALS 225.485
-- Earned $30,000: 848 off, more than the credit: nil.
#ASSERT `How much DC EITC with no qualifying child` 30000 30000 (7.65%) 8490 20000 EQUALS 0
-- Earned $5,000 with AGI $26,000: the phaseout uses the greater, AGI: 7.65% of 5,000 = 382.50, less 8.48% of 6,000 (508.80): nil.
#ASSERT `How much DC EITC with no qualifying child` 5000 26000 (7.65%) 8490 20000 EQUALS 0
#ASSERT `How will my DC EITC be paid` 1200 EQUALS `I may elect 12 equal monthly payments or one lump sum`
#ASSERT `How will my DC EITC be paid` 1199.99 EQUALS `one lump sum`

§§ `s 47-1806.17 -- the child tax credit (2025)`

-- Single, AGI $100,000, two children under 6: 2 x 420 = 840.
#ASSERT `How much DC child tax credit do I get` 2025 `single, head of household, or qualifying widow(er)` 100000 2 TRUE EQUALS `answered` 840
-- Four children: "up to a maximum of 3": 1,260.
#ASSERT `How much DC child tax credit do I get` 2025 `single, head of household, or qualifying widow(er)` 100000 4 TRUE EQUALS `answered` 1260
-- Single, AGI $165,500: $5,500 over $160,000 is 6 steps of $1,000 (5 and a fraction): 840 - 120 = 720.
#ASSERT `How much DC child tax credit do I get` 2025 `single, head of household, or qualifying widow(er)` 165500 2 TRUE EQUALS `answered` 720
-- Joint, AGI $250,000: $10,000 over $240,000: 10 steps: 840 - 200 = 640.
#ASSERT `How much DC child tax credit do I get` 2025 `married or registered domestic partners, filing jointly or separately on a combined return` 250000 2 TRUE EQUALS `answered` 640
-- Married filing separately, AGI $170,000, one child: $50,000 over $120,000: 1,000 off, "cannot reduce the credit below zero".
#ASSERT `How much DC child tax credit do I get` 2025 `married filing separately` 170000 1 TRUE EQUALS `answered` 0
-- Not a resident for all of the preceding year: no credit (s 47-1806.17(d)(2)).
#ASSERT `How much DC child tax credit do I get` 2025 `single, head of household, or qualifying widow(er)` 100000 2 FALSE EQUALS `answered` 0
-- 2024: before the credit exists. 2026: the adjusted amounts are not deposited.
#ASSERT `How much DC child tax credit do I get` 2024 `single, head of household, or qualifying widow(er)` 100000 2 TRUE EQUALS `answered` 0
#ASSERT `How much DC child tax credit do I get` 2026 `single, head of household, or qualifying widow(er)` 100000 2 TRUE EQUALS `not covered` `the child tax credit after 2025 is increased by a cost-of-living adjustment that is not deposited (s 47-1806.17(b)(1)(B))`

§§ `The balance`

-- 2025, single parent, AGI $40,000, HYPOTHETICAL deduction $15,000, one exemption worth nil, federal EIC $2,000 with a
-- qualifying child, one child under 6, a resident last year: taxable 25,000; tax 400 + 6% of 15,000 = 1,300; less 85% of
-- 2,000 (1,700) and 420: -820, refunded.
#ASSERT `How much DC income tax do I owe` 2025 TRUE 40000 15000 1 0 FALSE 2000 TRUE `single, head of household, or qualifying widow(er)` 1 TRUE EQUALS `answered` (0 MINUS 820)
-- 2023, single, AGI $80,000, HYPOTHETICAL deduction $13,850: taxable 66,150; 3,500 + 8.5% of 6,150 (522.75) = 4,022.75.
#ASSERT `How much DC income tax do I owe` 2023 TRUE 80000 13850 1 0 FALSE 0 FALSE `single, head of household, or qualifying widow(er)` 0 TRUE EQUALS `answered` 4022.75
#ASSERT `How much DC income tax do I owe` 2025 FALSE 80000 13850 1 0 FALSE 0 FALSE `single, head of household, or qualifying widow(er)` 0 TRUE EQUALS `not covered` `the tax on a nonresident or part-year resident is not encoded`
#ASSERT `How much DC income tax do I owe` 2021 TRUE 80000 13850 1 0 FALSE 0 FALSE `single, head of household, or qualifying widow(er)` 0 TRUE EQUALS `not covered` `only taxable years beginning after December 31, 2021 are encoded (s 47-1806.03(a)(11))`
-- 2026 with no child under 6: the child tax credit is nil whatever its adjusted amount; tax as in 2023: 4,022.75.
#ASSERT `How much DC income tax do I owe` 2026 TRUE 80000 13850 1 0 FALSE 0 FALSE `single, head of household, or qualifying widow(er)` 0 TRUE EQUALS `answered` 4022.75
-- 2026 with a child under 6: not covered.
#ASSERT `How much DC income tax do I owe` 2026 TRUE 80000 13850 1 0 FALSE 0 FALSE `single, head of household, or qualifying widow(er)` 1 TRUE EQUALS `not covered` `the child tax credit after 2025 is increased by a cost-of-living adjustment that is not deposited (s 47-1806.17(b)(1)(B))`

§§ `Filing, paying, deficiencies, appeals`

#ASSERT `By when must I file and pay in DC` 2025 EQUALS Date 15 4 2026
#ASSERT `How long an extension may I get` FALSE EQUALS 6
#ASSERT `How long an extension may I get` TRUE EQUALS 12
#ASSERT `By when must I pay the deficiency` (Date 1 7 2026) EQUALS Date 11 7 2026
-- From 1 January 2026 (day 0) to 15 April 2026 (day 104): filed on day 104, fulfilled.
#ASSERT EVALTRACE (`the duty to file the DC return and pay` 2025) 0 (LIST (EVENT `the taxpayer` `file the return and pay the tax due` 104)) EQUALS FULFILLED
-- expect: BREACH BY the taxpayer, "return not filed or tax not paid by 15 April ..." (day 105)
#TRACE (`the duty to file the DC return and pay` 2025) AT 0 WITH
    PARTY `the taxpayer` DOES `file the return and pay the tax due` AT 105
#ASSERT EVALTRACE `the duty to pay an assessed deficiency` 0 (LIST (EVENT `the taxpayer` `pay the deficiency` 10)) EQUALS FULFILLED
-- expect: BREACH BY the taxpayer, "deficiency not paid within 10 days from the date of the assessment ..." (day 11)
#TRACE `the duty to pay an assessed deficiency` AT 0 WITH
    PARTY `the taxpayer` DOES `pay the deficiency` AT 11
-- Assessed 1 July 2026; six months to 1 January 2027 is 184 days. Appealed on day 100: fulfilled. Not appealed: no breach.
#ASSERT EVALTRACE (`the right to appeal a deficiency` 184) 0 (LIST (EVENT `the person aggrieved by the assessment` `appeal to the Superior Court` 100)) EQUALS FULFILLED
#ASSERT EVALTRACE (`the right to appeal a deficiency` 184) 0 (LIST (WAITUNTIL 300)) EQUALS FULFILLED
