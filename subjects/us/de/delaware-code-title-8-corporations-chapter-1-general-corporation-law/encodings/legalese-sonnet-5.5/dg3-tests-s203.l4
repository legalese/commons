-- (c)(7): stock is capital stock of a corporation, or an equity interest in any other entity
#ASSERT `s 203(c)(7) the interest is stock` (`a corporation` OF `a stock corporation`) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 203(c)(7) the interest is stock` (`a corporation` OF `a stock corporation`) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 203(c)(7) the interest is stock` `a limited liability company` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 203(c)(7) the interest is stock` `a limited liability company` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 203(c)(7) the interest is stock` `a natural person` TRUE TRUE EQUALS NOTHING
-- (c)(8): voting stock is stock entitled to vote generally in the election of directors, or an equity interest entitled to vote generally in the election of the governing body
#ASSERT `s 203(c)(8) the interest is voting stock` (`a corporation` OF `a stock corporation`) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 203(c)(8) the interest is voting stock` (`a corporation` OF `a stock corporation`) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 203(c)(8) the interest is voting stock` `a limited partnership` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 203(c)(8) the interest is voting stock` `a limited partnership` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 203(c)(8) the interest is voting stock` `a natural person` TRUE TRUE EQUALS NOTHING

GIVEN votes IS A NUMBER
      outstanding IS A BOOLEAN
      beneficial IS A BOOLEAN
      right IS A BOOLEAN
      tendered IS A BOOLEAN
      accepted IS A BOOLEAN
      voteRight IS A BOOLEAN
      proxy IS A BOOLEAN
      solicited IS A NUMBER
      agreement IS A BOOLEAN
      revocableVoting IS A BOOLEAN
GIVETH A `s 203(c)(9) A block of voting stock`
`dg3 test block` votes outstanding beneficial right tendered accepted voteRight proxy solicited agreement revocableVoting MEANS
    `s 203(c)(9) A block of voting stock` WITH
        `the votes of the block` IS votes
        `the block is outstanding` IS outstanding
        `the person, individually or with or through its affiliates or associates, beneficially owns the block, directly or indirectly` IS beneficial
        `the person has the right to acquire the block` IS right
        `the block is tendered pursuant to a tender or exchange offer made by the person or any of its affiliates or associates` IS tendered
        `the tendered block has been accepted for purchase or exchange` IS accepted
        `the person has the right to vote the block pursuant to an agreement, arrangement or understanding` IS voteRight
        `that agreement, arrangement or understanding arises solely from a revocable proxy or consent given in response to a solicitation` IS proxy
        `the number of persons to whom that solicitation was made` IS solicited
        `the person has an agreement, arrangement or understanding for the purpose of acquiring, holding, voting or disposing of the block with another person that beneficially owns it` IS agreement
        `the voting under that agreement is pursuant to a revocable proxy or consent as described in item (B) of subparagraph (ii)` IS revocableVoting

-- (c)(9): the owner. (i) beneficially owns
#ASSERT `s 203(c)(9) the person is the owner of the block` (`dg3 test block` 100 TRUE TRUE FALSE FALSE FALSE FALSE FALSE 0 FALSE FALSE)
-- (ii)(A) the right to acquire; but not stock tendered in an offer by the person or its affiliates or associates until accepted
#ASSERT `s 203(c)(9) the person is the owner of the block` (`dg3 test block` 100 FALSE FALSE TRUE FALSE FALSE FALSE FALSE 0 FALSE FALSE)
#ASSERT NOT (`s 203(c)(9) the person is the owner of the block` (`dg3 test block` 100 TRUE FALSE TRUE TRUE FALSE FALSE FALSE 0 FALSE FALSE))
#ASSERT `s 203(c)(9) the person is the owner of the block` (`dg3 test block` 100 TRUE FALSE TRUE TRUE TRUE FALSE FALSE 0 FALSE FALSE)
-- (ii)(B) the right to vote under an agreement; but not if it arises solely from a revocable proxy or consent solicited from 10 or more persons
#ASSERT `s 203(c)(9) the person is the owner of the block` (`dg3 test block` 100 TRUE FALSE FALSE FALSE FALSE TRUE FALSE 0 FALSE FALSE)
#ASSERT NOT (`s 203(c)(9) the person is the owner of the block` (`dg3 test block` 100 TRUE FALSE FALSE FALSE FALSE TRUE TRUE 10 FALSE FALSE))
#ASSERT `s 203(c)(9) the person is the owner of the block` (`dg3 test block` 100 TRUE FALSE FALSE FALSE FALSE TRUE TRUE 9 FALSE FALSE)
-- (iii) an agreement for acquiring, holding, voting or disposing of the stock with another person that beneficially owns it; but not voting pursuant to such a revocable proxy
#ASSERT `s 203(c)(9) the person is the owner of the block` (`dg3 test block` 100 TRUE FALSE FALSE FALSE FALSE FALSE FALSE 0 TRUE FALSE)
#ASSERT NOT (`s 203(c)(9) the person is the owner of the block` (`dg3 test block` 100 TRUE FALSE FALSE FALSE FALSE FALSE FALSE 0 TRUE TRUE))
-- none of them
#ASSERT NOT (`s 203(c)(9) the person is the owner of the block` (`dg3 test block` 100 TRUE FALSE FALSE FALSE FALSE FALSE FALSE 0 FALSE FALSE))

`dg3 test blocks` MEANS
    LIST (`dg3 test block` 100 TRUE TRUE FALSE FALSE FALSE FALSE FALSE 0 FALSE FALSE)
       , (`dg3 test block` 50 FALSE FALSE TRUE FALSE FALSE FALSE FALSE 0 FALSE FALSE)
       , (`dg3 test block` 30 TRUE FALSE FALSE FALSE FALSE FALSE FALSE 0 FALSE FALSE)

-- the votes owned: 100 beneficially owned and 50 not yet outstanding but acquirable; the 30 are not the person's
#ASSERT `s 203(c)(9) the votes of the voting stock that the person owns` `dg3 test blocks` EQUALS 150
#ASSERT `s 203(c)(5) the votes of owned stock that is not yet outstanding` `dg3 test blocks` EQUALS 50
#ASSERT `s 203(c)(9) the votes of the voting stock that the person owns` EMPTY EQUALS 0

§ `Section 203(c)(5): interested stockholder`

`dg3 test no exclusions` MEANS
    `s 203(c)(5) The facts that take a person out of the term` WITH
        `the person owned shares in excess of the 15% limitation as of December 23, 1987` IS FALSE
        `the day the tender offer was commenced, if the person acquired the shares pursuant to one` IS NOTHING
        `the day the exchange offer was announced, if the person acquired the shares pursuant to one` IS NOTHING
        `the day the exchange offer was commenced, if the person acquired the shares pursuant to one` IS NOTHING
        `the person continued to own shares in excess of the 15% limitation, or would have but for action by the corporation` IS FALSE
        `the person is an affiliate or associate of the corporation and so continued to be the owner of 15% or more of the outstanding voting stock at any time within the 3-year period` IS FALSE
        `the person acquired the shares from a person described in item (A) by gift, inheritance or in a transaction in which no consideration was exchanged` IS FALSE
        `the person's ownership of shares in excess of the 15% limitation is the result of action taken solely by the corporation` IS FALSE
        `thereafter the person acquired additional shares of voting stock of the corporation, other than as a result of further corporate action not caused, directly or indirectly, by the person` IS FALSE

GIVEN asOf1987 IS A BOOLEAN
      tender IS A MAYBE DATE
      announced IS A MAYBE DATE
      commenced IS A MAYBE DATE
      continued IS A BOOLEAN
      affiliateContinued IS A BOOLEAN
      gift IS A BOOLEAN
      solely IS A BOOLEAN
      more IS A BOOLEAN
GIVETH A `s 203(c)(5) The facts that take a person out of the term`
`dg3 test exclusions` asOf1987 tender announced commenced continued affiliateContinued gift solely more MEANS
    `s 203(c)(5) The facts that take a person out of the term` WITH
        `the person owned shares in excess of the 15% limitation as of December 23, 1987` IS asOf1987
        `the day the tender offer was commenced, if the person acquired the shares pursuant to one` IS tender
        `the day the exchange offer was announced, if the person acquired the shares pursuant to one` IS announced
        `the day the exchange offer was commenced, if the person acquired the shares pursuant to one` IS commenced
        `the person continued to own shares in excess of the 15% limitation, or would have but for action by the corporation` IS continued
        `the person is an affiliate or associate of the corporation and so continued to be the owner of 15% or more of the outstanding voting stock at any time within the 3-year period` IS affiliateContinued
        `the person acquired the shares from a person described in item (A) by gift, inheritance or in a transaction in which no consideration was exchanged` IS gift
        `the person's ownership of shares in excess of the 15% limitation is the result of action taken solely by the corporation` IS solely
        `thereafter the person acquired additional shares of voting stock of the corporation, other than as a result of further corporate action not caused, directly or indirectly, by the person` IS more

GIVEN isCorp IS A BOOLEAN
      outstanding IS A NUMBER
      blocks IS A LIST OF `s 203(c)(9) A block of voting stock`
      affiliateOfCorp IS A BOOLEAN
      within3 IS A BOOLEAN
      affiliateOfIS IS A BOOLEAN
      exclusions IS A `s 203(c)(5) The facts that take a person out of the term`
GIVETH A `s 203(c)(5) Facts about a person and the corporation`
`dg3 test person` isCorp outstanding blocks affiliateOfCorp within3 affiliateOfIS exclusions MEANS
    `s 203(c)(5) Facts about a person and the corporation` WITH
        `the person is the corporation or a direct or indirect majority-owned subsidiary of the corporation` IS isCorp
        `the votes of the voting stock of the corporation outstanding` IS outstanding
        `the blocks of voting stock the person may be the owner of` IS blocks
        `the person is an affiliate or associate of the corporation` IS affiliateOfCorp
        `the person was the owner of 15% or more of the outstanding voting stock of the corporation at any time within the 3-year period immediately prior to the date it is sought to be determined whether the person is an interested stockholder` IS within3
        `the person is an affiliate or associate of a person who is an interested stockholder under item (i) or (ii)` IS affiliateOfIS
        `the exclusions` IS exclusions

GIVEN n IS A NUMBER
GIVETH A LIST OF `s 203(c)(9) A block of voting stock`
`dg3 test one block` n MEANS LIST (`dg3 test block` n TRUE TRUE FALSE FALSE FALSE FALSE FALSE 0 FALSE FALSE)

-- 15% or more of the outstanding voting stock: 150 of 1,000 is exactly 15%
#ASSERT `s 203(c)(5) the person is an interested stockholder` (`dg3 test person` FALSE 1000 (`dg3 test one block` 150) FALSE FALSE FALSE `dg3 test no exclusions`) EQUALS JUST TRUE
#ASSERT `s 203(c)(5) the person is an interested stockholder` (`dg3 test person` FALSE 1000 (`dg3 test one block` 149) FALSE FALSE FALSE `dg3 test no exclusions`) EQUALS JUST FALSE
-- the voting stock deemed outstanding includes stock the person is deemed to own by paragraph (9) but is not yet outstanding:
-- 100 owned outright and a right to acquire 59 more: 159 of 1,059 is 15.01%
#ASSERT `s 203(c)(5) the person is an interested stockholder` (`dg3 test person` FALSE 1000 (LIST (`dg3 test block` 100 TRUE TRUE FALSE FALSE FALSE FALSE FALSE 0 FALSE FALSE), (`dg3 test block` 59 FALSE FALSE TRUE FALSE FALSE FALSE FALSE 0 FALSE FALSE)) FALSE FALSE FALSE `dg3 test no exclusions`) EQUALS JUST TRUE
-- with a right to acquire 58 more: 158 of 1,058 is 14.93%
#ASSERT `s 203(c)(5) the person is an interested stockholder` (`dg3 test person` FALSE 1000 (LIST (`dg3 test block` 100 TRUE TRUE FALSE FALSE FALSE FALSE FALSE 0 FALSE FALSE), (`dg3 test block` 58 FALSE FALSE TRUE FALSE FALSE FALSE FALSE 0 FALSE FALSE)) FALSE FALSE FALSE `dg3 test no exclusions`) EQUALS JUST FALSE
-- the corporation and its majority-owned subsidiaries are not interested stockholders
#ASSERT `s 203(c)(5) the person is an interested stockholder` (`dg3 test person` TRUE 1000 (`dg3 test one block` 500) FALSE FALSE FALSE `dg3 test no exclusions`) EQUALS JUST FALSE
-- (ii): an affiliate or associate of the corporation that owned 15% or more within the previous 3 years
#ASSERT `s 203(c)(5) the person is an interested stockholder` (`dg3 test person` FALSE 1000 (`dg3 test one block` 10) TRUE TRUE FALSE `dg3 test no exclusions`) EQUALS JUST TRUE
#ASSERT `s 203(c)(5) the person is an interested stockholder` (`dg3 test person` FALSE 1000 (`dg3 test one block` 10) TRUE FALSE FALSE `dg3 test no exclusions`) EQUALS JUST FALSE
#ASSERT `s 203(c)(5) the person is an interested stockholder` (`dg3 test person` FALSE 1000 (`dg3 test one block` 10) FALSE TRUE FALSE `dg3 test no exclusions`) EQUALS JUST FALSE
-- and the affiliates and associates of such a person
#ASSERT `s 203(c)(5) the person is an interested stockholder` (`dg3 test person` FALSE 1000 (`dg3 test one block` 10) FALSE FALSE TRUE `dg3 test no exclusions`) EQUALS JUST TRUE
-- the proviso (x)(A): a tender offer commenced prior to 23 December 1987, and the person continued to own
#ASSERT `s 203(c)(5) the person is an interested stockholder` (`dg3 test person` FALSE 1000 (`dg3 test one block` 200) FALSE FALSE FALSE (`dg3 test exclusions` FALSE (JUST (YMD 1987 12 22)) NOTHING NOTHING TRUE FALSE FALSE FALSE FALSE)) EQUALS JUST FALSE
-- a tender offer commenced on 23 December 1987 itself is not "prior to" it
#ASSERT `s 203(c)(5) the person is an interested stockholder` (`dg3 test person` FALSE 1000 (`dg3 test one block` 200) FALSE FALSE FALSE (`dg3 test exclusions` FALSE (JUST (YMD 1987 12 23)) NOTHING NOTHING TRUE FALSE FALSE FALSE FALSE)) EQUALS JUST TRUE
-- an exchange offer announced before that day and commenced within 90 days after it (by 22 March 1988)
#ASSERT `s 203(c)(5) the person is an interested stockholder` (`dg3 test person` FALSE 1000 (`dg3 test one block` 200) FALSE FALSE FALSE (`dg3 test exclusions` FALSE NOTHING (JUST (YMD 1987 12 1)) (JUST (YMD 1988 3 22)) TRUE FALSE FALSE FALSE FALSE)) EQUALS JUST FALSE
#ASSERT `s 203(c)(5) the person is an interested stockholder` (`dg3 test person` FALSE 1000 (`dg3 test one block` 200) FALSE FALSE FALSE (`dg3 test exclusions` FALSE NOTHING (JUST (YMD 1987 12 1)) (JUST (YMD 1988 3 23)) TRUE FALSE FALSE FALSE FALSE)) EQUALS JUST TRUE
-- owned in excess of 15% as of 23 December 1987, and the person is an affiliate or associate of the corporation that so continued
#ASSERT `s 203(c)(5) the person is an interested stockholder` (`dg3 test person` FALSE 1000 (`dg3 test one block` 200) FALSE FALSE FALSE (`dg3 test exclusions` TRUE NOTHING NOTHING NOTHING FALSE TRUE FALSE FALSE FALSE)) EQUALS JUST FALSE
-- item (A) needs (I) or (II)
#ASSERT `s 203(c)(5) the person is an interested stockholder` (`dg3 test person` FALSE 1000 (`dg3 test one block` 200) FALSE FALSE FALSE (`dg3 test exclusions` TRUE NOTHING NOTHING NOTHING FALSE FALSE FALSE FALSE FALSE)) EQUALS JUST TRUE
-- (x)(B): acquired from a person described in (A) by gift, inheritance or for no consideration
#ASSERT `s 203(c)(5) the person is an interested stockholder` (`dg3 test person` FALSE 1000 (`dg3 test one block` 200) FALSE FALSE FALSE (`dg3 test exclusions` FALSE NOTHING NOTHING NOTHING FALSE FALSE TRUE FALSE FALSE)) EQUALS JUST FALSE
-- (y): ownership in excess of 15% the result of action taken solely by the corporation; but not if the person thereafter acquires more shares other than through further corporate action not caused by it
#ASSERT `s 203(c)(5) the person is an interested stockholder` (`dg3 test person` FALSE 1000 (`dg3 test one block` 200) FALSE FALSE FALSE (`dg3 test exclusions` FALSE NOTHING NOTHING NOTHING FALSE FALSE FALSE TRUE FALSE)) EQUALS JUST FALSE
#ASSERT `s 203(c)(5) the person is an interested stockholder` (`dg3 test person` FALSE 1000 (`dg3 test one block` 200) FALSE FALSE FALSE (`dg3 test exclusions` FALSE NOTHING NOTHING NOTHING FALSE FALSE FALSE TRUE TRUE)) EQUALS JUST TRUE
-- nothing outstanding and nothing owned: no percentage
#ASSERT `s 203(c)(5) the person is an interested stockholder` (`dg3 test person` FALSE 0 EMPTY FALSE FALSE FALSE `dg3 test no exclusions`) EQUALS NOTHING

§ `Section 203(d) and (e)`

-- (d): a provision may not require a greater vote than the section specifies (here the section's 66 2/3% of the outstanding voting stock not owned by the interested stockholder)
#ASSERT `s 203(d) the provision requires a greater vote than this section specifies` (`at least` ((300 DIVIDED BY 4)%) `of` `the outstanding stock entitled to vote`) (`at least` ((200 DIVIDED BY 3)%) `of` `the outstanding stock entitled to vote`) EQUALS JUST TRUE
#ASSERT `s 203(d) the provision requires a greater vote than this section specifies` (`at least` ((200 DIVIDED BY 3)%) `of` `the outstanding stock entitled to vote`) (`at least` ((200 DIVIDED BY 3)%) `of` `the outstanding stock entitled to vote`) EQUALS JUST FALSE
#ASSERT `s 203(d) the provision requires a greater vote than this section specifies` (`at least` (50%) `of` `the outstanding stock entitled to vote`) (`at least` ((200 DIVIDED BY 3)%) `of` `the outstanding stock entitled to vote`) EQUALS JUST FALSE
-- the same proportion, but "more than" against "at least"
#ASSERT `s 203(d) the provision requires a greater vote than this section specifies` (`a majority of` `the outstanding stock entitled to vote`) (`at least` (50%) `of` `the outstanding stock entitled to vote`) EQUALS JUST TRUE
#ASSERT `s 203(d) the provision requires a greater vote than this section specifies` (`at least` (50%) `of` `the outstanding stock entitled to vote`) (`a majority of` `the outstanding stock entitled to vote`) EQUALS JUST FALSE
-- requirements counted against different bases are not compared
#ASSERT `s 203(d) the provision requires a greater vote than this section specifies` (`a majority of` `the votes cast`) (`a majority of` `the outstanding stock entitled to vote`) EQUALS NOTHING
-- (e): the Court of Chancery has exclusive jurisdiction of matters with respect to section 203
#ASSERT `s 203(e) the court has jurisdiction to hear and determine the matter` `the Court of Chancery` TRUE EQUALS JUST TRUE
#ASSERT `s 203(e) the court has jurisdiction to hear and determine the matter` (`another party named in the provision` OF "a court other than the Court of Chancery") TRUE EQUALS JUST FALSE
#ASSERT `s 203(e) the court has jurisdiction to hear and determine the matter` `the Court of Chancery` FALSE EQUALS NOTHING

§ `Section 203 as a whole`

#ASSERT `s 203 the corporation may not engage in the business combination` (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 203 the corporation may not engage in the business combination` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 203 the corporation may not engage in the business combination` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 203 the corporation may not engage in the business combination` NOTHING (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 203 the corporation may not engage in the business combination` NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 203 the corporation may not engage in the business combination` NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 203 the corporation may not engage in the business combination` (JUST FALSE) NOTHING EQUALS NOTHING
