#ASSERT NOT (`s 203(b) the corporation's election to be governed applies to the interested stockholder` FALSE FALSE NOTHING (YMD 2026 5 1))
-- subsection (b) as a whole: arguments are (b)(1) (b)(2) (b)(3) (b)(4), the election applies, (b)(5), (b)(6), (b)(7)
#ASSERT `s 203(b) the restrictions contained in this section do not apply` TRUE FALSE FALSE FALSE FALSE FALSE (JUST FALSE) FALSE EQUALS JUST TRUE
-- an exemption under (b)(1) to (4) gives way to the corporation's election to be governed
#ASSERT `s 203(b) the restrictions contained in this section do not apply` TRUE FALSE FALSE FALSE TRUE FALSE (JUST FALSE) FALSE EQUALS JUST FALSE
-- (b)(5) and (b)(7) do not give way to it
#ASSERT `s 203(b) the restrictions contained in this section do not apply` FALSE FALSE FALSE FALSE TRUE TRUE (JUST FALSE) FALSE EQUALS JUST TRUE
#ASSERT `s 203(b) the restrictions contained in this section do not apply` FALSE FALSE FALSE FALSE TRUE FALSE (JUST FALSE) TRUE EQUALS JUST TRUE
-- (b)(6) decides when nothing else applies, and cannot be worked out
#ASSERT `s 203(b) the restrictions contained in this section do not apply` FALSE FALSE FALSE FALSE FALSE FALSE (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 203(b) the restrictions contained in this section do not apply` FALSE FALSE FALSE FALSE FALSE FALSE NOTHING FALSE EQUALS NOTHING
#ASSERT `s 203(b) the restrictions contained in this section do not apply` TRUE FALSE FALSE FALSE TRUE FALSE NOTHING FALSE EQUALS NOTHING

§ `Section 203(c): the definitions`

-- (c)(1): affiliate
#ASSERT `s 203(c)(1) the person is an affiliate of the other person` TRUE FALSE FALSE
#ASSERT `s 203(c)(1) the person is an affiliate of the other person` FALSE TRUE FALSE
#ASSERT `s 203(c)(1) the person is an affiliate of the other person` FALSE FALSE TRUE
#ASSERT NOT (`s 203(c)(1) the person is an affiliate of the other person` FALSE FALSE FALSE)
-- (c)(2): associate. (i) an entity of which the person is a director, officer or partner, or owns 20% or more of a class of voting stock
#ASSERT `s 203(c)(2) the other party is an associate of the person` (`a corporation, partnership, unincorporated association or other entity under s 203(c)(2)(i)` OF TRUE, 0, 100) EQUALS JUST TRUE
#ASSERT `s 203(c)(2) the other party is an associate of the person` (`a corporation, partnership, unincorporated association or other entity under s 203(c)(2)(i)` OF FALSE, 20, 100) EQUALS JUST TRUE
#ASSERT `s 203(c)(2) the other party is an associate of the person` (`a corporation, partnership, unincorporated association or other entity under s 203(c)(2)(i)` OF FALSE, 19, 100) EQUALS JUST FALSE
#ASSERT `s 203(c)(2) the other party is an associate of the person` (`a corporation, partnership, unincorporated association or other entity under s 203(c)(2)(i)` OF FALSE, 20, 0) EQUALS NOTHING
-- (ii) a trust or other estate in which the person has at least a 20% beneficial interest or serves as trustee or in a similar capacity
#ASSERT `s 203(c)(2) the other party is an associate of the person` (`a trust or other estate under s 203(c)(2)(ii)` OF (20%), FALSE) EQUALS JUST TRUE
#ASSERT `s 203(c)(2) the other party is an associate of the person` (`a trust or other estate under s 203(c)(2)(ii)` OF (19%), FALSE) EQUALS JUST FALSE
#ASSERT `s 203(c)(2) the other party is an associate of the person` (`a trust or other estate under s 203(c)(2)(ii)` OF (0%), TRUE) EQUALS JUST TRUE
-- (iii) a relative or spouse, or a relative of the spouse, who has the same residence
#ASSERT `s 203(c)(2) the other party is an associate of the person` (`a relative or spouse of the person, or a relative of that spouse, under s 203(c)(2)(iii)` OF TRUE) EQUALS JUST TRUE
#ASSERT `s 203(c)(2) the other party is an associate of the person` (`a relative or spouse of the person, or a relative of that spouse, under s 203(c)(2)(iii)` OF FALSE) EQUALS JUST FALSE
#ASSERT `s 203(c)(2) the other party is an associate of the person` `anything else under s 203(c)(2)` EQUALS JUST FALSE

-- (c)(3)(i): a merger or consolidation
#ASSERT `s 203(c)(3)(i) the merger or consolidation is a business combination` (`s 203(c)(3)(i) A merger or consolidation` OF TRUE, TRUE, FALSE, FALSE, FALSE)
#ASSERT `s 203(c)(3)(i) the merger or consolidation is a business combination` (`s 203(c)(3)(i) A merger or consolidation` OF TRUE, FALSE, TRUE, TRUE, TRUE)
#ASSERT NOT (`s 203(c)(3)(i) the merger or consolidation is a business combination` (`s 203(c)(3)(i) A merger or consolidation` OF TRUE, FALSE, TRUE, TRUE, FALSE))
#ASSERT NOT (`s 203(c)(3)(i) the merger or consolidation is a business combination` (`s 203(c)(3)(i) A merger or consolidation` OF TRUE, FALSE, TRUE, FALSE, TRUE))
#ASSERT NOT (`s 203(c)(3)(i) the merger or consolidation is a business combination` (`s 203(c)(3)(i) A merger or consolidation` OF FALSE, TRUE, TRUE, TRUE, TRUE))
-- (c)(3)(ii): a disposition of assets worth 10% or more of the consolidated assets or of the outstanding stock, to the interested stockholder, other than proportionately as a stockholder
#ASSERT `s 203(c)(3)(ii) the disposition of assets is a business combination` (`s 203(c)(3)(ii) A disposition of assets` OF TRUE, TRUE, FALSE, 10, 100, 1000)
#ASSERT NOT (`s 203(c)(3)(ii) the disposition of assets is a business combination` (`s 203(c)(3)(ii) A disposition of assets` OF TRUE, TRUE, FALSE, 9, 100, 1000))
#ASSERT `s 203(c)(3)(ii) the disposition of assets is a business combination` (`s 203(c)(3)(ii) A disposition of assets` OF TRUE, TRUE, FALSE, 9, 100, 90)
#ASSERT NOT (`s 203(c)(3)(ii) the disposition of assets is a business combination` (`s 203(c)(3)(ii) A disposition of assets` OF TRUE, TRUE, TRUE, 50, 100, 1000))
#ASSERT NOT (`s 203(c)(3)(ii) the disposition of assets is a business combination` (`s 203(c)(3)(ii) A disposition of assets` OF TRUE, FALSE, FALSE, 50, 100, 1000))
#ASSERT NOT (`s 203(c)(3)(ii) the disposition of assets is a business combination` (`s 203(c)(3)(ii) A disposition of assets` OF FALSE, TRUE, FALSE, 50, 100, 1000))
-- (c)(3)(iii): an issuance or transfer of stock to the interested stockholder, except A (existing securities), B (section 251(g) merger), and C to E when the interested stockholder's share does not increase
#ASSERT `s 203(c)(3)(iii) the issuance or transfer of stock is a business combination` (`s 203(c)(3)(iii) An issuance or transfer of stock` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)
#ASSERT NOT (`s 203(c)(3)(iii) the issuance or transfer of stock is a business combination` (`s 203(c)(3)(iii) An issuance or transfer of stock` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE))
#ASSERT NOT (`s 203(c)(3)(iii) the issuance or transfer of stock is a business combination` (`s 203(c)(3)(iii) An issuance or transfer of stock` OF TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE))
#ASSERT NOT (`s 203(c)(3)(iii) the issuance or transfer of stock is a business combination` (`s 203(c)(3)(iii) An issuance or transfer of stock` OF TRUE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE))
-- A and B hold even when the interested stockholder's share increases
#ASSERT NOT (`s 203(c)(3)(iii) the issuance or transfer of stock is a business combination` (`s 203(c)(3)(iii) An issuance or transfer of stock` OF TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, TRUE))
#ASSERT NOT (`s 203(c)(3)(iii) the issuance or transfer of stock is a business combination` (`s 203(c)(3)(iii) An issuance or transfer of stock` OF TRUE, FALSE, TRUE, FALSE, FALSE, FALSE, TRUE))
-- C, D, E hold only if the share does not increase
#ASSERT NOT (`s 203(c)(3)(iii) the issuance or transfer of stock is a business combination` (`s 203(c)(3)(iii) An issuance or transfer of stock` OF TRUE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE))
#ASSERT `s 203(c)(3)(iii) the issuance or transfer of stock is a business combination` (`s 203(c)(3)(iii) An issuance or transfer of stock` OF TRUE, FALSE, FALSE, TRUE, FALSE, FALSE, TRUE)
#ASSERT NOT (`s 203(c)(3)(iii) the issuance or transfer of stock is a business combination` (`s 203(c)(3)(iii) An issuance or transfer of stock` OF TRUE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE))
#ASSERT `s 203(c)(3)(iii) the issuance or transfer of stock is a business combination` (`s 203(c)(3)(iii) An issuance or transfer of stock` OF TRUE, FALSE, FALSE, FALSE, TRUE, FALSE, TRUE)
#ASSERT NOT (`s 203(c)(3)(iii) the issuance or transfer of stock is a business combination` (`s 203(c)(3)(iii) An issuance or transfer of stock` OF TRUE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE))
#ASSERT `s 203(c)(3)(iii) the issuance or transfer of stock is a business combination` (`s 203(c)(3)(iii) An issuance or transfer of stock` OF TRUE, FALSE, FALSE, FALSE, FALSE, TRUE, TRUE)
-- (c)(3)(iv): a transaction that increases the interested stockholder's share, except immaterial fractional adjustments and purchases or redemptions not caused by the interested stockholder
#ASSERT `s 203(c)(3)(iv) the transaction increasing the interested stockholder's share is a business combination` (`s 203(c)(3)(iv) A transaction increasing the interested stockholder's share` OF TRUE, FALSE, FALSE)
#ASSERT NOT (`s 203(c)(3)(iv) the transaction increasing the interested stockholder's share is a business combination` (`s 203(c)(3)(iv) A transaction increasing the interested stockholder's share` OF TRUE, TRUE, FALSE))
#ASSERT NOT (`s 203(c)(3)(iv) the transaction increasing the interested stockholder's share is a business combination` (`s 203(c)(3)(iv) A transaction increasing the interested stockholder's share` OF TRUE, FALSE, TRUE))
#ASSERT NOT (`s 203(c)(3)(iv) the transaction increasing the interested stockholder's share is a business combination` (`s 203(c)(3)(iv) A transaction increasing the interested stockholder's share` OF FALSE, FALSE, FALSE))
-- (c)(3)(v): a financial benefit, other than proportionately as a stockholder and other than as expressly permitted
#ASSERT `s 203(c)(3)(v) the receipt of a financial benefit is a business combination` (`s 203(c)(3)(v) A receipt of a financial benefit` OF TRUE, FALSE, FALSE)
#ASSERT NOT (`s 203(c)(3)(v) the receipt of a financial benefit is a business combination` (`s 203(c)(3)(v) A receipt of a financial benefit` OF TRUE, TRUE, FALSE))
#ASSERT NOT (`s 203(c)(3)(v) the receipt of a financial benefit is a business combination` (`s 203(c)(3)(v) A receipt of a financial benefit` OF TRUE, FALSE, TRUE))
#ASSERT NOT (`s 203(c)(3)(v) the receipt of a financial benefit is a business combination` (`s 203(c)(3)(v) A receipt of a financial benefit` OF FALSE, FALSE, FALSE))
-- (c)(3): the right limb is asked for each kind of transaction
#ASSERT `s 203(c)(3) the transaction is a business combination` (`a merger or consolidation under s 203(c)(3)(i)` OF (`s 203(c)(3)(i) A merger or consolidation` OF TRUE, TRUE, FALSE, FALSE, FALSE))
#ASSERT `s 203(c)(3) the transaction is a business combination` (`a disposition of assets under s 203(c)(3)(ii)` OF (`s 203(c)(3)(ii) A disposition of assets` OF TRUE, TRUE, FALSE, 10, 100, 1000))
#ASSERT `s 203(c)(3) the transaction is a business combination` (`an issuance or transfer of stock under s 203(c)(3)(iii)` OF (`s 203(c)(3)(iii) An issuance or transfer of stock` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE))
#ASSERT `s 203(c)(3) the transaction is a business combination` (`a transaction increasing the interested stockholder's share under s 203(c)(3)(iv)` OF (`s 203(c)(3)(iv) A transaction increasing the interested stockholder's share` OF TRUE, FALSE, FALSE))
#ASSERT `s 203(c)(3) the transaction is a business combination` (`a receipt of a financial benefit under s 203(c)(3)(v)` OF (`s 203(c)(3)(v) A receipt of a financial benefit` OF TRUE, FALSE, FALSE))
#ASSERT NOT (`s 203(c)(3) the transaction is a business combination` `a transaction of another kind under s 203(c)(3)`)
#ASSERT NOT (`s 203(c)(3) the transaction is a business combination` (`a merger or consolidation under s 203(c)(3)(i)` OF (`s 203(c)(3)(i) A merger or consolidation` OF FALSE, TRUE, FALSE, FALSE, FALSE)))

-- (c)(4): control. The power itself; or the presumption from owning 20% of the outstanding voting stock, unless rebutted or held as an agent, nominee or the like in good faith
#ASSERT `s 203(c)(4) the person has control of the entity` (`s 203(c)(4) Facts about control of an entity` OF TRUE, 0, 100, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `s 203(c)(4) the person has control of the entity` (`s 203(c)(4) Facts about control of an entity` OF FALSE, 20, 100, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `s 203(c)(4) the person has control of the entity` (`s 203(c)(4) Facts about control of an entity` OF FALSE, 19, 100, FALSE, FALSE) EQUALS JUST FALSE
#ASSERT `s 203(c)(4) the person has control of the entity` (`s 203(c)(4) Facts about control of an entity` OF FALSE, 20, 100, TRUE, FALSE) EQUALS JUST FALSE
#ASSERT `s 203(c)(4) the person has control of the entity` (`s 203(c)(4) Facts about control of an entity` OF FALSE, 20, 100, FALSE, TRUE) EQUALS JUST FALSE
-- the power is control whatever the percentage and whatever the exceptions to the presumption
#ASSERT `s 203(c)(4) the person has control of the entity` (`s 203(c)(4) Facts about control of an entity` OF TRUE, 5, 100, TRUE, TRUE) EQUALS JUST TRUE
-- no power and no votes to measure against: not covered
#ASSERT `s 203(c)(4) the person has control of the entity` (`s 203(c)(4) Facts about control of an entity` OF FALSE, 20, 0, FALSE, FALSE) EQUALS NOTHING

-- (c)(6): every kind of entity is a person, an individual included
#ASSERT `s 203(c)(6) the kind of entity is a person` `a natural person`
