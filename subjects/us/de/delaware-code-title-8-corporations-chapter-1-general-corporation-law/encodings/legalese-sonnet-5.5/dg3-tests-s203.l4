IMPORT prelude
IMPORT daydate
IMPORT `dg-core`
IMPORT `dg3-s203`

-- Tests of dg3-s203.l4 (section 203).
-- Every expected value was decided by reading the section, then written beside the assertion; none is copied from the encoding's output.

§ `Section 203(a): the bar, and the three exceptions`

GIVEN became IS A DATE
      bcDay IS A DATE
      approvedBC IS A BOOLEAN
      approvedTx IS A BOOLEAN
      owned IS A NUMBER
      outstanding IS A NUMBER
      dirOff IS A NUMBER
      dirOffIS IS A NUMBER
      plan IS A NUMBER
      planIS IS A NUMBER
      boardLater IS A BOOLEAN
      meeting IS A BOOLEAN
      written IS A BOOLEAN
      favor IS A NUMBER
      notOwned IS A NUMBER
GIVETH A `s 203(a) Facts about a business combination with an interested stockholder`
`dg3 test a facts` became bcDay approvedBC approvedTx owned outstanding dirOff dirOffIS plan planIS boardLater meeting written favor notOwned MEANS
    `s 203(a) Facts about a business combination with an interested stockholder` WITH
        `the day the stockholder became an interested stockholder` IS became
        `the day of the business combination` IS bcDay
        `prior to such time the board of directors approved the business combination` IS approvedBC
        `prior to such time the board of directors approved the transaction which resulted in the stockholder becoming an interested stockholder` IS approvedTx
        `the votes of the voting stock that the interested stockholder owned upon consummation of the transaction` IS owned
        `the votes of the voting stock of the corporation outstanding at the time the transaction commenced` IS outstanding
        `the votes of the outstanding stock owned by persons who are directors and also officers` IS dirOff
        `of those votes, the votes owned by the interested stockholder (directors and officers)` IS dirOffIS
        `the votes of the outstanding stock owned by employee stock plans in which employee participants do not have the right to determine confidentially whether shares held subject to the plan will be tendered in a tender or exchange offer` IS plan
        `of those votes, the votes owned by the interested stockholder (employee stock plans)` IS planIS
        `at or subsequent to such time the business combination is approved by the board of directors` IS boardLater
        `the business combination is authorized at an annual or special meeting of stockholders` IS meeting
        `the business combination is authorized by written consent` IS written
        `the votes in favor of the business combination (the affirmative vote) of the outstanding voting stock which is not owned by the interested stockholder` IS favor
        `the votes of the outstanding voting stock which is not owned by the interested stockholder` IS notOwned

-- The percentage of the voting stock that votes represent (a percentage of voting stock is a percentage of the votes)
#ASSERT `s 203(c)(8) the percentage of the voting stock that the votes represent` 15 100 EQUALS JUST (15%)
#ASSERT `s 203(c)(8) the percentage of the voting stock that the votes represent` 0 100 EQUALS JUST 0
#ASSERT `s 203(c)(8) the percentage of the voting stock that the votes represent` 15 0 EQUALS NOTHING
#ASSERT `s 203(c)(8) the percentage of the voting stock that the votes represent` (0 MINUS 1) 100 EQUALS NOTHING

-- (a)(1): the board approved the business combination, or the transaction that made the stockholder an interested stockholder, before that time
#ASSERT `s 203(a)(1) the board of directors approved before that time` (`dg3 test a facts` (YMD 2026 1 1) (YMD 2027 1 1) TRUE FALSE 0 100 0 0 0 0 FALSE FALSE FALSE 0 100)
#ASSERT `s 203(a)(1) the board of directors approved before that time` (`dg3 test a facts` (YMD 2026 1 1) (YMD 2027 1 1) FALSE TRUE 0 100 0 0 0 0 FALSE FALSE FALSE 0 100)
#ASSERT NOT (`s 203(a)(1) the board of directors approved before that time` (`dg3 test a facts` (YMD 2026 1 1) (YMD 2027 1 1) FALSE FALSE 0 100 0 0 0 0 FALSE FALSE FALSE 0 100))

-- (a)(2): at least 85% of the voting stock outstanding when the transaction commenced
#ASSERT `s 203(a)(2) the interested stockholder owned at least 85% of the voting stock outstanding` (`dg3 test a facts` (YMD 2026 1 1) (YMD 2027 1 1) FALSE FALSE 85 100 0 0 0 0 FALSE FALSE FALSE 0 100) EQUALS JUST TRUE
#ASSERT `s 203(a)(2) the interested stockholder owned at least 85% of the voting stock outstanding` (`dg3 test a facts` (YMD 2026 1 1) (YMD 2027 1 1) FALSE FALSE 84 100 0 0 0 0 FALSE FALSE FALSE 0 100) EQUALS JUST FALSE
-- shares owned by directors who are also officers (20) and by qualifying employee plans (10) do not count as outstanding: 120 less 30 is 90; 85% of 90 is 76.5
#ASSERT `s 203(a)(2) the interested stockholder owned at least 85% of the voting stock outstanding` (`dg3 test a facts` (YMD 2026 1 1) (YMD 2027 1 1) FALSE FALSE 77 120 20 0 10 0 FALSE FALSE FALSE 0 100) EQUALS JUST TRUE
#ASSERT `s 203(a)(2) the interested stockholder owned at least 85% of the voting stock outstanding` (`dg3 test a facts` (YMD 2026 1 1) (YMD 2027 1 1) FALSE FALSE 76 120 20 0 10 0 FALSE FALSE FALSE 0 100) EQUALS JUST FALSE
-- but not the stock the interested stockholder itself owns: of the 20, 5 are the interested stockholder's, so 15 and 10 are excluded: 120 less 25 is 95; 85% of 95 is 80.75
#ASSERT `s 203(a)(2) the interested stockholder owned at least 85% of the voting stock outstanding` (`dg3 test a facts` (YMD 2026 1 1) (YMD 2027 1 1) FALSE FALSE 81 120 20 5 10 0 FALSE FALSE FALSE 0 100) EQUALS JUST TRUE
#ASSERT `s 203(a)(2) the interested stockholder owned at least 85% of the voting stock outstanding` (`dg3 test a facts` (YMD 2026 1 1) (YMD 2027 1 1) FALSE FALSE 80 120 20 5 10 0 FALSE FALSE FALSE 0 100) EQUALS JUST FALSE
-- nothing left outstanding: not a percentage
#ASSERT `s 203(a)(2) the interested stockholder owned at least 85% of the voting stock outstanding` (`dg3 test a facts` (YMD 2026 1 1) (YMD 2027 1 1) FALSE FALSE 0 20 20 0 0 0 FALSE FALSE FALSE 0 100) EQUALS NOTHING

-- (a)(3): approved by the board and authorized at an annual or special meeting, not by written consent, by at least 66 2/3% of the outstanding voting stock not owned by the interested stockholder (300 votes)
#ASSERT `s 203(a)(3) the business combination was approved and authorized by the required vote` (`dg3 test a facts` (YMD 2026 1 1) (YMD 2027 1 1) FALSE FALSE 0 100 0 0 0 0 TRUE TRUE FALSE 200 300) EQUALS JUST TRUE
#ASSERT `s 203(a)(3) the business combination was approved and authorized by the required vote` (`dg3 test a facts` (YMD 2026 1 1) (YMD 2027 1 1) FALSE FALSE 0 100 0 0 0 0 TRUE TRUE FALSE 199 300) EQUALS JUST FALSE
#ASSERT `s 203(a)(3) the business combination was approved and authorized by the required vote` (`dg3 test a facts` (YMD 2026 1 1) (YMD 2027 1 1) FALSE FALSE 0 100 0 0 0 0 TRUE TRUE TRUE 300 300) EQUALS JUST FALSE
#ASSERT `s 203(a)(3) the business combination was approved and authorized by the required vote` (`dg3 test a facts` (YMD 2026 1 1) (YMD 2027 1 1) FALSE FALSE 0 100 0 0 0 0 TRUE FALSE FALSE 300 300) EQUALS JUST FALSE
#ASSERT `s 203(a)(3) the business combination was approved and authorized by the required vote` (`dg3 test a facts` (YMD 2026 1 1) (YMD 2027 1 1) FALSE FALSE 0 100 0 0 0 0 FALSE TRUE FALSE 300 300) EQUALS JUST FALSE
#ASSERT `s 203(a)(3) the business combination was approved and authorized by the required vote` (`dg3 test a facts` (YMD 2026 1 1) (YMD 2027 1 1) FALSE FALSE 0 100 0 0 0 0 TRUE TRUE FALSE 0 0) EQUALS NOTHING
#ASSERT `s 203(a)(3) the business combination was approved and authorized by the required vote` (`dg3 test a facts` (YMD 2026 1 1) (YMD 2027 1 1) FALSE FALSE 0 100 0 0 0 0 TRUE TRUE FALSE 301 300) EQUALS NOTHING

-- the bar as a whole: no exception applies
#ASSERT `s 203(a) the corporation is barred from engaging in the business combination` (`dg3 test a facts` (YMD 2026 1 1) (YMD 2027 1 1) FALSE FALSE 50 100 0 0 0 0 FALSE FALSE FALSE 0 100) EQUALS JUST TRUE
-- (a)(1) lifts it
#ASSERT `s 203(a) the corporation is barred from engaging in the business combination` (`dg3 test a facts` (YMD 2026 1 1) (YMD 2027 1 1) TRUE FALSE 50 100 0 0 0 0 FALSE FALSE FALSE 0 100) EQUALS JUST FALSE
#ASSERT `s 203(a) the corporation is barred from engaging in the business combination` (`dg3 test a facts` (YMD 2026 1 1) (YMD 2027 1 1) FALSE TRUE 50 100 0 0 0 0 FALSE FALSE FALSE 0 100) EQUALS JUST FALSE
-- (a)(2) lifts it
#ASSERT `s 203(a) the corporation is barred from engaging in the business combination` (`dg3 test a facts` (YMD 2026 1 1) (YMD 2027 1 1) FALSE FALSE 85 100 0 0 0 0 FALSE FALSE FALSE 0 100) EQUALS JUST FALSE
#ASSERT `s 203(a) the corporation is barred from engaging in the business combination` (`dg3 test a facts` (YMD 2026 1 1) (YMD 2027 1 1) FALSE FALSE 84 100 0 0 0 0 FALSE FALSE FALSE 0 100) EQUALS JUST TRUE
-- (a)(3) lifts it
#ASSERT `s 203(a) the corporation is barred from engaging in the business combination` (`dg3 test a facts` (YMD 2026 1 1) (YMD 2027 1 1) FALSE FALSE 50 100 0 0 0 0 TRUE TRUE FALSE 200 300) EQUALS JUST FALSE
#ASSERT `s 203(a) the corporation is barred from engaging in the business combination` (`dg3 test a facts` (YMD 2026 1 1) (YMD 2027 1 1) FALSE FALSE 50 100 0 0 0 0 TRUE TRUE FALSE 199 300) EQUALS JUST TRUE
-- the 3 years: the last day (1 January 2029) is inside, the next day is not, and a day before the stockholder became one is not
#ASSERT `s 203(a) the corporation is barred from engaging in the business combination` (`dg3 test a facts` (YMD 2026 1 1) (YMD 2029 1 1) FALSE FALSE 50 100 0 0 0 0 FALSE FALSE FALSE 0 100) EQUALS JUST TRUE
#ASSERT `s 203(a) the corporation is barred from engaging in the business combination` (`dg3 test a facts` (YMD 2026 1 1) (YMD 2029 1 2) FALSE FALSE 50 100 0 0 0 0 FALSE FALSE FALSE 0 100) EQUALS JUST FALSE
#ASSERT `s 203(a) the corporation is barred from engaging in the business combination` (`dg3 test a facts` (YMD 2026 1 1) (YMD 2025 12 31) FALSE FALSE 50 100 0 0 0 0 FALSE FALSE FALSE 0 100) EQUALS JUST FALSE
-- exceptions that cannot be worked out: (a)(2) has nothing outstanding, (a)(3) has no votes to count; neither settles it
#ASSERT `s 203(a) the corporation is barred from engaging in the business combination` (`dg3 test a facts` (YMD 2026 1 1) (YMD 2027 1 1) FALSE FALSE 0 20 20 0 0 0 TRUE TRUE FALSE 0 0) EQUALS NOTHING
-- (a)(2) cannot be worked out but (a)(3) is met: not barred
#ASSERT `s 203(a) the corporation is barred from engaging in the business combination` (`dg3 test a facts` (YMD 2026 1 1) (YMD 2027 1 1) FALSE FALSE 0 20 20 0 0 0 TRUE TRUE FALSE 200 300) EQUALS JUST FALSE
-- (a)(2) fails and (a)(3) cannot be worked out
#ASSERT `s 203(a) the corporation is barred from engaging in the business combination` (`dg3 test a facts` (YMD 2026 1 1) (YMD 2027 1 1) FALSE FALSE 50 100 0 0 0 0 TRUE TRUE FALSE 0 0) EQUALS NOTHING
-- (a)(2) cannot be worked out and (a)(3) fails
#ASSERT `s 203(a) the corporation is barred from engaging in the business combination` (`dg3 test a facts` (YMD 2026 1 1) (YMD 2027 1 1) FALSE FALSE 0 20 20 0 0 0 TRUE TRUE FALSE 100 300) EQUALS NOTHING

§ `Section 203(b): when the restrictions do not apply`

#ASSERT `s 203(b)(1) the restrictions do not apply because the original certificate elects out` TRUE
#ASSERT NOT (`s 203(b)(1) the restrictions do not apply because the original certificate elects out` FALSE)
-- (b)(2): a board bylaw election within 90 days of 2 February 1988 (from 4 November 1987 to 2 May 1988)
#ASSERT `s 203(b)(2) the restrictions do not apply because the board adopted a bylaw election in 1988` (JUST (YMD 1988 2 2))
#ASSERT `s 203(b)(2) the restrictions do not apply because the board adopted a bylaw election in 1988` (JUST (YMD 1988 5 2))
#ASSERT NOT (`s 203(b)(2) the restrictions do not apply because the board adopted a bylaw election in 1988` (JUST (YMD 1988 5 3)))
#ASSERT `s 203(b)(2) the restrictions do not apply because the board adopted a bylaw election in 1988` (JUST (YMD 1987 11 4))
#ASSERT NOT (`s 203(b)(2) the restrictions do not apply because the board adopted a bylaw election in 1988` (JUST (YMD 1987 11 3)))
#ASSERT NOT (`s 203(b)(2) the restrictions do not apply because the board adopted a bylaw election in 1988` NOTHING)
#ASSERT `s 203(b)(2) the board of directors is barred from further amending the bylaw amendment` TRUE
#ASSERT NOT (`s 203(b)(2) the board of directors is barred from further amending the bylaw amendment` FALSE)

GIVEN instrument IS A `s 203(b)(3) Which instrument the stockholders amended`
      favor IS A NUMBER
      outstanding IS A NUMBER
      greater IS A MAYBE `Vote requirement`
      never IS A BOOLEAN
      notElected IS A BOOLEAN
      day IS A DATE
GIVETH A `s 203(b)(3) Facts about an election by the stockholders`
`dg3 test election` instrument favor outstanding greater never notElected day MEANS
    `s 203(b)(3) Facts about an election by the stockholders` WITH
        `the instrument amended` IS instrument
        `the votes in favor of the amendment` IS favor
        `the outstanding stock entitled to vote thereon, in votes` IS outstanding
        `the greater vote required by any other law, if any` IS greater
        `the corporation has never had a class of voting stock that falls within either of the 2 categories set out in paragraph (b)(4)` IS never
        `the corporation has not elected by a provision in its original certificate of incorporation or any amendment to be governed by section 203` IS notElected
        `the day the amendment takes effect under section 103 (certificate) or the day it was adopted (bylaws)` IS day

-- (b)(3): a majority of the outstanding stock entitled to vote
#ASSERT `s 203(b)(3) the stockholders adopted the amendment by the required vote` (`dg3 test election` `the bylaws under s 203(b)(3)` 51 100 NOTHING TRUE TRUE (YMD 2026 3 15)) EQUALS JUST TRUE
#ASSERT `s 203(b)(3) the stockholders adopted the amendment by the required vote` (`dg3 test election` `the bylaws under s 203(b)(3)` 50 100 NOTHING TRUE TRUE (YMD 2026 3 15)) EQUALS JUST FALSE
-- in addition to any other vote required by law (a greater vote of 2/3)
#ASSERT `s 203(b)(3) the stockholders adopted the amendment by the required vote` (`dg3 test election` `the certificate of incorporation under s 203(b)(3)` 67 100 (JUST (`at least` ((200 DIVIDED BY 3)%) `of` `the outstanding stock entitled to vote`)) TRUE TRUE (YMD 2026 3 15)) EQUALS JUST TRUE
#ASSERT `s 203(b)(3) the stockholders adopted the amendment by the required vote` (`dg3 test election` `the certificate of incorporation under s 203(b)(3)` 66 100 (JUST (`at least` ((200 DIVIDED BY 3)%) `of` `the outstanding stock entitled to vote`)) TRUE TRUE (YMD 2026 3 15)) EQUALS JUST FALSE
#ASSERT `s 203(b)(3) the stockholders adopted the amendment by the required vote` (`dg3 test election` `the bylaws under s 203(b)(3)` 10 0 NOTHING TRUE TRUE (YMD 2026 3 15)) EQUALS NOTHING
-- the day the election takes effect: at once, in the case of a corporation that has never had such a class and has not elected to be governed; otherwise 12 months after
#ASSERT `s 203(b)(3) the day from which the election not to be governed takes effect` (`dg3 test election` `the bylaws under s 203(b)(3)` 51 100 NOTHING TRUE TRUE (YMD 2026 3 15)) EQUALS YMD 2026 3 15
#ASSERT `s 203(b)(3) the day from which the election not to be governed takes effect` (`dg3 test election` `the bylaws under s 203(b)(3)` 51 100 NOTHING FALSE TRUE (YMD 2026 3 15)) EQUALS YMD 2027 3 15
#ASSERT `s 203(b)(3) the day from which the election not to be governed takes effect` (`dg3 test election` `the certificate of incorporation under s 203(b)(3)` 51 100 NOTHING TRUE FALSE (YMD 2026 3 15)) EQUALS YMD 2027 3 15
-- 12 months after 29 February 2024 is 28 February 2025 (dg-core's date arithmetic clamps; Fork F10)
#ASSERT `s 203(b)(3) the day from which the election not to be governed takes effect` (`dg3 test election` `the bylaws under s 203(b)(3)` 51 100 NOTHING FALSE TRUE (YMD 2024 2 29)) EQUALS YMD 2025 2 28
-- the immediate case: applies from the day, to any interested stockholder
#ASSERT `s 203(b)(3) the restrictions do not apply because of the stockholders' election` (`dg3 test election` `the bylaws under s 203(b)(3)` 51 100 NOTHING TRUE TRUE (YMD 2026 3 15)) (YMD 2026 3 15) (YMD 2020 1 1)
#ASSERT NOT (`s 203(b)(3) the restrictions do not apply because of the stockholders' election` (`dg3 test election` `the bylaws under s 203(b)(3)` 51 100 NOTHING TRUE TRUE (YMD 2026 3 15)) (YMD 2026 3 14) (YMD 2020 1 1))
-- the delayed case: from 12 months after, and not to a person who became an interested stockholder on or before the day of the amendment
#ASSERT `s 203(b)(3) the restrictions do not apply because of the stockholders' election` (`dg3 test election` `the bylaws under s 203(b)(3)` 51 100 NOTHING FALSE TRUE (YMD 2026 3 15)) (YMD 2027 3 15) (YMD 2026 3 16)
#ASSERT NOT (`s 203(b)(3) the restrictions do not apply because of the stockholders' election` (`dg3 test election` `the bylaws under s 203(b)(3)` 51 100 NOTHING FALSE TRUE (YMD 2026 3 15)) (YMD 2027 3 15) (YMD 2026 3 15))
#ASSERT NOT (`s 203(b)(3) the restrictions do not apply because of the stockholders' election` (`dg3 test election` `the bylaws under s 203(b)(3)` 51 100 NOTHING FALSE TRUE (YMD 2026 3 15)) (YMD 2027 3 14) (YMD 2026 3 16))
-- an amendment not adopted by the required vote
#ASSERT NOT (`s 203(b)(3) the restrictions do not apply because of the stockholders' election` (`dg3 test election` `the bylaws under s 203(b)(3)` 50 100 NOTHING TRUE TRUE (YMD 2026 3 15)) (YMD 2026 6 1) (YMD 2020 1 1))
#ASSERT `s 203(b)(3) the board of directors is barred from further amending the bylaw amendment` TRUE
#ASSERT NOT (`s 203(b)(3) the board of directors is barred from further amending the bylaw amendment` FALSE)

-- (b)(4): no class of voting stock listed on a national securities exchange or held of record by more than 2,000 stockholders, unless that results from the interested stockholder's action
#ASSERT `s 203(b)(4) the restrictions do not apply because the corporation has no listed or widely held class of voting stock` (`s 203(b)(4) Facts about the classes of voting stock` WITH `a class of voting stock is listed on a national securities exchange` IS FALSE, `that listing results from action taken, directly or indirectly, by an interested stockholder or from a transaction in which a person becomes an interested stockholder` IS FALSE, `the number of stockholders of record of the class of voting stock with the most holders` IS 2000, `that number results from action taken, directly or indirectly, by an interested stockholder or from a transaction in which a person becomes an interested stockholder` IS FALSE)
#ASSERT NOT (`s 203(b)(4) the restrictions do not apply because the corporation has no listed or widely held class of voting stock` (`s 203(b)(4) Facts about the classes of voting stock` WITH `a class of voting stock is listed on a national securities exchange` IS FALSE, `that listing results from action taken, directly or indirectly, by an interested stockholder or from a transaction in which a person becomes an interested stockholder` IS FALSE, `the number of stockholders of record of the class of voting stock with the most holders` IS 2001, `that number results from action taken, directly or indirectly, by an interested stockholder or from a transaction in which a person becomes an interested stockholder` IS FALSE))
#ASSERT `s 203(b)(4) the restrictions do not apply because the corporation has no listed or widely held class of voting stock` (`s 203(b)(4) Facts about the classes of voting stock` WITH `a class of voting stock is listed on a national securities exchange` IS FALSE, `that listing results from action taken, directly or indirectly, by an interested stockholder or from a transaction in which a person becomes an interested stockholder` IS FALSE, `the number of stockholders of record of the class of voting stock with the most holders` IS 2001, `that number results from action taken, directly or indirectly, by an interested stockholder or from a transaction in which a person becomes an interested stockholder` IS TRUE)
#ASSERT NOT (`s 203(b)(4) the restrictions do not apply because the corporation has no listed or widely held class of voting stock` (`s 203(b)(4) Facts about the classes of voting stock` WITH `a class of voting stock is listed on a national securities exchange` IS TRUE, `that listing results from action taken, directly or indirectly, by an interested stockholder or from a transaction in which a person becomes an interested stockholder` IS FALSE, `the number of stockholders of record of the class of voting stock with the most holders` IS 10, `that number results from action taken, directly or indirectly, by an interested stockholder or from a transaction in which a person becomes an interested stockholder` IS FALSE))
#ASSERT `s 203(b)(4) the restrictions do not apply because the corporation has no listed or widely held class of voting stock` (`s 203(b)(4) Facts about the classes of voting stock` WITH `a class of voting stock is listed on a national securities exchange` IS TRUE, `that listing results from action taken, directly or indirectly, by an interested stockholder or from a transaction in which a person becomes an interested stockholder` IS TRUE, `the number of stockholders of record of the class of voting stock with the most holders` IS 10, `that number results from action taken, directly or indirectly, by an interested stockholder or from a transaction in which a person becomes an interested stockholder` IS FALSE)

-- (b)(5): inadvertent, divested as soon as practicable, and not an interested stockholder in the previous 3 years but for the inadvertent acquisition
#ASSERT `s 203(b)(5) the restrictions do not apply because the stockholder became an interested stockholder inadvertently` TRUE TRUE TRUE
#ASSERT NOT (`s 203(b)(5) the restrictions do not apply because the stockholder became an interested stockholder inadvertently` FALSE TRUE TRUE)
#ASSERT NOT (`s 203(b)(5) the restrictions do not apply because the stockholder became an interested stockholder inadvertently` TRUE FALSE TRUE)
#ASSERT NOT (`s 203(b)(5) the restrictions do not apply because the stockholder became an interested stockholder inadvertently` TRUE TRUE FALSE)

-- (b)(6)(i): the listed transactions
#ASSERT `s 203(b)(6)(i) the proposed transaction is 1 of those the paragraph lists` (`a merger or consolidation of the corporation under s 203(b)(6)(x)` OF FALSE) EQUALS JUST TRUE
#ASSERT `s 203(b)(6)(i) the proposed transaction is 1 of those the paragraph lists` (`a merger or consolidation of the corporation under s 203(b)(6)(x)` OF TRUE) EQUALS JUST FALSE
-- (y): assets of 50 against 100 consolidated and 1000 of stock: 50% of the consolidated assets
#ASSERT `s 203(b)(6)(i) the proposed transaction is 1 of those the paragraph lists` (`a disposition of assets under s 203(b)(6)(y)` OF TRUE, FALSE, 50, 100, 1000) EQUALS JUST TRUE
-- 49 is under 50% of both
#ASSERT `s 203(b)(6)(i) the proposed transaction is 1 of those the paragraph lists` (`a disposition of assets under s 203(b)(6)(y)` OF TRUE, FALSE, 49, 100, 1000) EQUALS JUST FALSE
-- 500 against 2000 consolidated (25%) and 1000 of stock (50%): the other measure is met
#ASSERT `s 203(b)(6)(i) the proposed transaction is 1 of those the paragraph lists` (`a disposition of assets under s 203(b)(6)(y)` OF TRUE, FALSE, 500, 2000, 1000) EQUALS JUST TRUE
-- to a wholly-owned subsidiary or to the corporation: excluded
#ASSERT `s 203(b)(6)(i) the proposed transaction is 1 of those the paragraph lists` (`a disposition of assets under s 203(b)(6)(y)` OF TRUE, TRUE, 50, 100, 1000) EQUALS JUST FALSE
-- (z): a tender or exchange offer for 50% or more of the outstanding voting stock
#ASSERT `s 203(b)(6)(i) the proposed transaction is 1 of those the paragraph lists` (`a tender or exchange offer under s 203(b)(6)(z)` OF 50, 100) EQUALS JUST TRUE
#ASSERT `s 203(b)(6)(i) the proposed transaction is 1 of those the paragraph lists` (`a tender or exchange offer under s 203(b)(6)(z)` OF 49, 100) EQUALS JUST FALSE
#ASSERT `s 203(b)(6)(i) the proposed transaction is 1 of those the paragraph lists` (`a tender or exchange offer under s 203(b)(6)(z)` OF 50, 0) EQUALS NOTHING
#ASSERT `s 203(b)(6)(i) the proposed transaction is 1 of those the paragraph lists` `another transaction under s 203(b)(6)` EQUALS JUST FALSE

GIVEN proposed IS A DATE
      announced IS A MAYBE DATE
      notice IS A MAYBE DATE
      ended IS A MAYBE DATE
      notInterested IS A BOOLEAN
      approvedByBoard IS A BOOLEAN
      during7 IS A BOOLEAN
      continuing IS A NUMBER
      approving IS A NUMBER
GIVETH A `s 203(b)(6) Facts about the proposal and the person`
`dg3 test proposal` proposed announced notice ended notInterested approvedByBoard during7 continuing approving MEANS
    `s 203(b)(6) Facts about the proposal and the person` WITH
        `the day the business combination is proposed` IS proposed
        `the day of the public announcement of the proposed transaction, if any` IS announced
        `the day of the notice required hereunder of the proposed transaction, if any` IS notice
        `the day the proposed transaction is consummated or abandoned, if it has been` IS ended
        `the person was not an interested stockholder during the previous 3 years` IS notInterested
        `the person became an interested stockholder with the approval of the corporation's board of directors` IS approvedByBoard
        `the person became an interested stockholder during the period described in paragraph (b)(7)` IS during7
        `the number of members of the board then in office who were directors prior to any person becoming an interested stockholder during the previous 3 years or were recommended for election or elected to succeed such directors by a majority of such directors` IS continuing
        `the number of those members who approved or did not oppose the proposed transaction` IS approving

-- (b)(6): after the earlier of the public announcement and the notice, before consummation or abandonment
#ASSERT `s 203(b)(6) the business combination is proposed within the time the paragraph allows` (`dg3 test proposal` (YMD 2026 6 10) (JUST (YMD 2026 6 1)) NOTHING NOTHING TRUE FALSE FALSE 5 3)
#ASSERT NOT (`s 203(b)(6) the business combination is proposed within the time the paragraph allows` (`dg3 test proposal` (YMD 2026 6 1) (JUST (YMD 2026 6 1)) NOTHING NOTHING TRUE FALSE FALSE 5 3))
-- the earlier of the two: the announcement on 1 June, the notice on 5 June, so after 1 June
#ASSERT `s 203(b)(6) the business combination is proposed within the time the paragraph allows` (`dg3 test proposal` (YMD 2026 6 2) (JUST (YMD 2026 6 1)) (JUST (YMD 2026 6 5)) NOTHING TRUE FALSE FALSE 5 3)
#ASSERT `s 203(b)(6) the business combination is proposed within the time the paragraph allows` (`dg3 test proposal` (YMD 2026 6 2) (JUST (YMD 2026 6 5)) (JUST (YMD 2026 6 1)) NOTHING TRUE FALSE FALSE 5 3)
-- only the notice
#ASSERT `s 203(b)(6) the business combination is proposed within the time the paragraph allows` (`dg3 test proposal` (YMD 2026 6 6) NOTHING (JUST (YMD 2026 6 5)) NOTHING TRUE FALSE FALSE 5 3)
-- neither: nothing for the proposal to be subsequent to
#ASSERT NOT (`s 203(b)(6) the business combination is proposed within the time the paragraph allows` (`dg3 test proposal` (YMD 2026 6 6) NOTHING NOTHING NOTHING TRUE FALSE FALSE 5 3))
-- prior to the consummation or abandonment
#ASSERT `s 203(b)(6) the business combination is proposed within the time the paragraph allows` (`dg3 test proposal` (YMD 2026 6 9) (JUST (YMD 2026 6 1)) NOTHING (JUST (YMD 2026 6 10)) TRUE FALSE FALSE 5 3)
#ASSERT NOT (`s 203(b)(6) the business combination is proposed within the time the paragraph allows` (`dg3 test proposal` (YMD 2026 6 10) (JUST (YMD 2026 6 1)) NOTHING (JUST (YMD 2026 6 10)) TRUE FALSE FALSE 5 3))
-- (ii): a person who was not an interested stockholder in the previous 3 years, or became one with the board's approval, or during the (b)(7) period
#ASSERT `s 203(b)(6)(ii) the transaction is with or by a person of the kind the paragraph describes` (`dg3 test proposal` (YMD 2026 6 10) NOTHING NOTHING NOTHING TRUE FALSE FALSE 5 3)
#ASSERT `s 203(b)(6)(ii) the transaction is with or by a person of the kind the paragraph describes` (`dg3 test proposal` (YMD 2026 6 10) NOTHING NOTHING NOTHING FALSE TRUE FALSE 5 3)
#ASSERT `s 203(b)(6)(ii) the transaction is with or by a person of the kind the paragraph describes` (`dg3 test proposal` (YMD 2026 6 10) NOTHING NOTHING NOTHING FALSE FALSE TRUE 5 3)
#ASSERT NOT (`s 203(b)(6)(ii) the transaction is with or by a person of the kind the paragraph describes` (`dg3 test proposal` (YMD 2026 6 10) NOTHING NOTHING NOTHING FALSE FALSE FALSE 5 3))
-- (iii): a majority of the continuing directors in office (5), but not less than 1: 3 is a majority, 2 is not
#ASSERT `s 203(b)(6)(iii) the transaction is approved or not opposed by the required majority of the continuing directors` (`dg3 test proposal` (YMD 2026 6 10) NOTHING NOTHING NOTHING TRUE FALSE FALSE 5 3) EQUALS JUST TRUE
#ASSERT `s 203(b)(6)(iii) the transaction is approved or not opposed by the required majority of the continuing directors` (`dg3 test proposal` (YMD 2026 6 10) NOTHING NOTHING NOTHING TRUE FALSE FALSE 5 2) EQUALS JUST FALSE
-- of 4, 2 is not more than half
#ASSERT `s 203(b)(6)(iii) the transaction is approved or not opposed by the required majority of the continuing directors` (`dg3 test proposal` (YMD 2026 6 10) NOTHING NOTHING NOTHING TRUE FALSE FALSE 4 2) EQUALS JUST FALSE
-- of 1, the 1 is a majority; none of 1 is not
#ASSERT `s 203(b)(6)(iii) the transaction is approved or not opposed by the required majority of the continuing directors` (`dg3 test proposal` (YMD 2026 6 10) NOTHING NOTHING NOTHING TRUE FALSE FALSE 1 1) EQUALS JUST TRUE
#ASSERT `s 203(b)(6)(iii) the transaction is approved or not opposed by the required majority of the continuing directors` (`dg3 test proposal` (YMD 2026 6 10) NOTHING NOTHING NOTHING TRUE FALSE FALSE 1 0) EQUALS JUST FALSE
-- no continuing directors in office: not covered
#ASSERT `s 203(b)(6)(iii) the transaction is approved or not opposed by the required majority of the continuing directors` (`dg3 test proposal` (YMD 2026 6 10) NOTHING NOTHING NOTHING TRUE FALSE FALSE 0 0) EQUALS NOTHING
-- all of (b)(6)
#ASSERT `s 203(b)(6) the restrictions do not apply because of the proposal of the business combination` (`a tender or exchange offer under s 203(b)(6)(z)` OF 60, 100) (`dg3 test proposal` (YMD 2026 6 10) (JUST (YMD 2026 6 1)) NOTHING NOTHING TRUE FALSE FALSE 5 3) EQUALS JUST TRUE
#ASSERT `s 203(b)(6) the restrictions do not apply because of the proposal of the business combination` (`a tender or exchange offer under s 203(b)(6)(z)` OF 40, 100) (`dg3 test proposal` (YMD 2026 6 10) (JUST (YMD 2026 6 1)) NOTHING NOTHING TRUE FALSE FALSE 5 3) EQUALS JUST FALSE
#ASSERT `s 203(b)(6) the restrictions do not apply because of the proposal of the business combination` (`a tender or exchange offer under s 203(b)(6)(z)` OF 60, 100) (`dg3 test proposal` (YMD 2026 6 10) (JUST (YMD 2026 6 1)) NOTHING NOTHING FALSE FALSE FALSE 5 3) EQUALS JUST FALSE
#ASSERT `s 203(b)(6) the restrictions do not apply because of the proposal of the business combination` (`a tender or exchange offer under s 203(b)(6)(z)` OF 60, 100) (`dg3 test proposal` (YMD 2026 6 10) (JUST (YMD 2026 6 1)) NOTHING NOTHING TRUE FALSE FALSE 5 2) EQUALS JUST FALSE
#ASSERT `s 203(b)(6) the restrictions do not apply because of the proposal of the business combination` (`a tender or exchange offer under s 203(b)(6)(z)` OF 60, 100) (`dg3 test proposal` (YMD 2026 6 10) NOTHING NOTHING NOTHING TRUE FALSE FALSE 5 3) EQUALS JUST FALSE
#ASSERT `s 203(b)(6) the restrictions do not apply because of the proposal of the business combination` (`a tender or exchange offer under s 203(b)(6)(z)` OF 60, 0) (`dg3 test proposal` (YMD 2026 6 10) (JUST (YMD 2026 6 1)) NOTHING NOTHING TRUE FALSE FALSE 5 3) EQUALS NOTHING
-- the notice owed to interested stockholders: for clauses (x) and (y), not for a tender or exchange offer (z)
#ASSERT `s 203(b)(6) the corporation must give notice to all interested stockholders` (`a merger or consolidation of the corporation under s 203(b)(6)(x)` OF FALSE)
#ASSERT `s 203(b)(6) the corporation must give notice to all interested stockholders` (`a disposition of assets under s 203(b)(6)(y)` OF TRUE, FALSE, 50, 100, 1000)
