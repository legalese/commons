IMPORT prelude
IMPORT daydate
IMPORT `dg-core`
IMPORT `dg1-s103-filing`
IMPORT `dg1-s101-formation`

-- Tests of sections 101 and 104 to 107 (dg1-s101-formation.l4). Every expected value is written by hand from the
-- text (src:35-37, 115, 119-122, 126, 130), beside the assertion, and was decided before the module was run.

§ `Tests of sections 101 and 104 to 107`

§§ `s 101 cases`

-- "Any person, partnership, association or corporation ... may incorporate", whatever its residence: a natural person ...
#ASSERT `s 101(a) the entity may incorporate or organize a corporation under this chapter` `a natural person` EQUALS JUST TRUE
-- ... a corporation of any kind, including one formed under the laws of another jurisdiction ...
#ASSERT `s 101(a) the entity may incorporate or organize a corporation under this chapter` (`a corporation` `a stock corporation`) EQUALS JUST TRUE
#ASSERT `s 101(a) the entity may incorporate or organize a corporation under this chapter` (`a corporation` `a charitable nonstock corporation`) EQUALS JUST TRUE
-- ... a partnership of each of the four kinds, and an association ...
#ASSERT `s 101(a) the entity may incorporate or organize a corporation under this chapter` `a general partnership` EQUALS JUST TRUE
#ASSERT `s 101(a) the entity may incorporate or organize a corporation under this chapter` `a limited partnership` EQUALS JUST TRUE
#ASSERT `s 101(a) the entity may incorporate or organize a corporation under this chapter` `a limited liability partnership` EQUALS JUST TRUE
#ASSERT `s 101(a) the entity may incorporate or organize a corporation under this chapter` `a limited liability limited partnership` EQUALS JUST TRUE
#ASSERT `s 101(a) the entity may incorporate or organize a corporation under this chapter` `a joint-stock association` EQUALS JUST TRUE
#ASSERT `s 101(a) the entity may incorporate or organize a corporation under this chapter` `a business trust or association` EQUALS JUST TRUE
#ASSERT `s 101(a) the entity may incorporate or organize a corporation under this chapter` `any other unincorporated business or association` EQUALS JUST TRUE
-- the kinds that none of the four words names are not covered
#ASSERT `s 101(a) the entity may incorporate or organize a corporation under this chapter` `a limited liability company` EQUALS NOTHING
#ASSERT `s 101(a) the entity may incorporate or organize a corporation under this chapter` `a statutory trust` EQUALS NOTHING
#ASSERT `s 101(a) the entity may incorporate or organize a corporation under this chapter` `a real estate investment trust` EQUALS NOTHING
#ASSERT `s 101(a) the entity may incorporate or organize a corporation under this chapter` `a common-law trust` EQUALS NOTHING

-- Incorporation is by filing a certificate executed, acknowledged and filed in accordance with section 103.
-- order: the instrument is the certificate; to be filed before the election of the initial board; initial directors named
GIVEN cert IS A BOOLEAN
GIVETH A `s 103(a) Instrument`
`t101 instrument` cert MEANS `s 103(a) Instrument` OF cert, TRUE, FALSE

-- every incorporator signed; the other six fields are false
GIVETH A `s 103(a)(1) Signing by the incorporators`
`t101 all incorporators signed` MEANS `s 103(a)(1) Signing by the incorporators` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE

GIVETH A `s 103(a)(1) Signing by the incorporators`
`t101 no incorporator signed` MEANS `s 103(a)(1) Signing by the incorporators` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE

-- an authorized officer signed; the other seven fields are false
GIVETH A `s 103(a)(2) Signing for the corporation`
`t101 an officer signed` MEANS `s 103(a)(2) Signing for the corporation` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE

-- order: signed; acknowledged act and deed and facts true; before an authorized person; seal; affixed
GIVETH A `s 103(b) Acknowledgment`
`t101 signature alone` MEANS `s 103(b) Acknowledgment` OF TRUE, FALSE, FALSE, FALSE, FALSE

GIVETH A `s 103(b) Acknowledgment`
`t101 unsigned` MEANS `s 103(b) Acknowledgment` OF FALSE, FALSE, FALSE, FALSE, FALSE

-- order: delivered; tendered; refused; endorsed
GIVETH A `s 103(c) Steps of filing`
`t101 filed` MEANS `s 103(c) Steps of filing` OF TRUE, TRUE, FALSE, TRUE

GIVETH A `s 103(c) Steps of filing`
`t101 not yet endorsed` MEANS `s 103(c) Steps of filing` OF TRUE, TRUE, FALSE, FALSE

#ASSERT `s 101(a) the corporation has been incorporated by filing the certificate of incorporation` (`t101 instrument` TRUE) `t101 all incorporators signed` `t101 an officer signed` `t101 signature alone` `t101 filed`
-- not endorsed: not filed
#ASSERT NOT (`s 101(a) the corporation has been incorporated by filing the certificate of incorporation` (`t101 instrument` TRUE) `t101 all incorporators signed` `t101 an officer signed` `t101 signature alone` `t101 not yet endorsed`)
-- not signed by the incorporators
#ASSERT NOT (`s 101(a) the corporation has been incorporated by filing the certificate of incorporation` (`t101 instrument` TRUE) `t101 no incorporator signed` `t101 an officer signed` `t101 signature alone` `t101 filed`)
-- not acknowledged (not signed at all)
#ASSERT NOT (`s 101(a) the corporation has been incorporated by filing the certificate of incorporation` (`t101 instrument` TRUE) `t101 all incorporators signed` `t101 an officer signed` `t101 unsigned` `t101 filed`)
-- an instrument other than the certificate does not incorporate a corporation
#ASSERT NOT (`s 101(a) the corporation has been incorporated by filing the certificate of incorporation` (`t101 instrument` FALSE) `t101 all incorporators signed` `t101 an officer signed` `t101 signature alone` `t101 filed`)

-- Purposes: any lawful business or purposes, except as the Constitution or other law of this State may otherwise provide.
#ASSERT `s 101(b) a corporation may be incorporated to conduct or promote the business or purposes` TRUE FALSE
#ASSERT NOT (`s 101(b) a corporation may be incorporated to conduct or promote the business or purposes` TRUE TRUE)
#ASSERT NOT (`s 101(b) a corporation may be incorporated to conduct or promote the business or purposes` FALSE FALSE)

-- Public utilities.
#ASSERT `s 101(c) a corporation for operating public utilities, in or outside this State, may be organized under this chapter` TRUE
#ASSERT NOT (`s 101(c) a corporation for operating public utilities, in or outside this State, may be organized under this chapter` FALSE)
#ASSERT `s 101(c) the corporation is subject also to the special provisions and requirements of Title 26` TRUE TRUE
#ASSERT NOT (`s 101(c) the corporation is subject also to the special provisions and requirements of Title 26` TRUE FALSE)
#ASSERT NOT (`s 101(c) the corporation is subject also to the special provisions and requirements of Title 26` FALSE TRUE)

§§ `s 104 cases`

-- the original certificate is part of the certificate of incorporation; so is an instrument filed under a section of this title that amends or supplements it
#ASSERT `s 104 the instrument is part of the certificate of incorporation` TRUE FALSE FALSE FALSE
#ASSERT `s 104 the instrument is part of the certificate of incorporation` FALSE TRUE TRUE FALSE
-- filed under a section but not amending or supplementing: not part
#ASSERT NOT (`s 104 the instrument is part of the certificate of incorporation` FALSE TRUE FALSE FALSE)
-- not filed under a section: not part
#ASSERT NOT (`s 104 the instrument is part of the certificate of incorporation` FALSE FALSE TRUE FALSE)
-- unless the context requires otherwise
#ASSERT NOT (`s 104 the instrument is part of the certificate of incorporation` TRUE FALSE FALSE TRUE)
#ASSERT NOT (`s 104 the instrument is part of the certificate of incorporation` FALSE TRUE TRUE TRUE)

§§ `s 105 cases`

#ASSERT `s 105 the certified copy is received as prima facie evidence of the matter` TRUE TRUE `due execution, acknowledgment and filing of the instrument` EQUALS JUST TRUE
#ASSERT `s 105 the certified copy is received as prima facie evidence of the matter` TRUE TRUE `observance and performance of all acts and conditions necessary to have been observed and performed precedent to the instrument becoming effective` EQUALS JUST TRUE
#ASSERT `s 105 the certified copy is received as prima facie evidence of the matter` TRUE TRUE `any other fact required or permitted by law to be stated in the instrument` EQUALS JUST TRUE
-- a matter of another kind, an uncertified copy, or an instrument not filed as the title requires: the section does not speak
#ASSERT `s 105 the certified copy is received as prima facie evidence of the matter` TRUE TRUE `a matter that is not a fact of those kinds` EQUALS NOTHING
#ASSERT `s 105 the certified copy is received as prima facie evidence of the matter` FALSE TRUE `due execution, acknowledgment and filing of the instrument` EQUALS NOTHING
#ASSERT `s 105 the certified copy is received as prima facie evidence of the matter` TRUE FALSE `due execution, acknowledgment and filing of the instrument` EQUALS NOTHING

§§ `s 106 cases`

-- a certificate filed on 10 March 2026: the body corporate exists from that date
#ASSERT `s 106 the date from which the incorporators are a body corporate` TRUE (YearMonthDay 2026 3 10) NOTHING EQUALS JUST (YearMonthDay 2026 3 10)
-- subject to section 103(d): a later effective date postpones it
#ASSERT `s 106 the date from which the incorporators are a body corporate` TRUE (YearMonthDay 2026 3 10) (JUST (YearMonthDay 2026 4 1)) EQUALS JUST (YearMonthDay 2026 4 1)
-- a later date beyond the ninetieth day is not permitted by section 103(d): not covered
#ASSERT `s 106 the date from which the incorporators are a body corporate` TRUE (YearMonthDay 2026 3 10) (JUST (YearMonthDay 2026 7 1)) EQUALS NOTHING
-- the certificate not executed and acknowledged in accordance with section 103: the section does not apply
#ASSERT `s 106 the date from which the incorporators are a body corporate` FALSE (YearMonthDay 2026 3 10) NOTHING EQUALS NOTHING
#ASSERT `s 106 the name by which the body corporate exists` "Acme Widgets, Inc." EQUALS "Acme Widgets, Inc."
#ASSERT `s 106 the body corporate exists on the day` (YearMonthDay 2026 3 10) (JUST (YearMonthDay 2026 3 10)) FALSE
#ASSERT `s 106 the body corporate exists on the day` (YearMonthDay 2026 9 1) (JUST (YearMonthDay 2026 3 10)) FALSE
#ASSERT NOT (`s 106 the body corporate exists on the day` (YearMonthDay 2026 3 9) (JUST (YearMonthDay 2026 3 10)) FALSE)
-- subject to dissolution or other termination as provided in the chapter
#ASSERT NOT (`s 106 the body corporate exists on the day` (YearMonthDay 2026 9 1) (JUST (YearMonthDay 2026 3 10)) TRUE)
#ASSERT NOT (`s 106 the body corporate exists on the day` (YearMonthDay 2026 9 1) NOTHING FALSE)

§§ `s 107 cases`

-- the directors were not named and have not been elected: the incorporators manage
#ASSERT `s 107 the incorporators manage the affairs of the corporation` FALSE FALSE
#ASSERT NOT (`s 107 the incorporators manage the affairs of the corporation` TRUE FALSE)
#ASSERT NOT (`s 107 the incorporators manage the affairs of the corporation` FALSE TRUE)
#ASSERT `s 107 the incorporators may do the act` TRUE `adopting the original bylaws of the corporation` EQUALS JUST TRUE
#ASSERT `s 107 the incorporators may do the act` TRUE `electing directors while the incorporators manage the corporation` EQUALS JUST TRUE
#ASSERT `s 107 the incorporators may do the act` TRUE `another act necessary and proper to perfect the organization of the corporation` EQUALS JUST TRUE
#ASSERT `s 107 the incorporators may do the act` TRUE `an act that is not necessary and proper to perfect the organization of the corporation` EQUALS NOTHING
-- when the incorporators do not manage (directors named or elected), the section gives them nothing
#ASSERT `s 107 the incorporators may do the act` FALSE `electing directors while the incorporators manage the corporation` EQUALS NOTHING
