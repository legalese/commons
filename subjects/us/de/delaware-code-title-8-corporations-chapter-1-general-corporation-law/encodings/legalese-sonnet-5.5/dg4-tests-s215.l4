IMPORT prelude
IMPORT daydate
IMPORT `dg-core`
IMPORT `dg4-s212-voting-proxies`
IMPORT `dg4-s216-quorum-vote`
IMPORT `dg4-s215-nonstock-members`

-- Tests of dg4-s215-nonstock-members.l4. Expected values are written by hand from the text of s 215
-- (de-code-t8-ch1-2026-10-01.txt, lines 798-809) and, for the last group, s 114(b)(2) and (c)(2) (lines 202 and 206),
-- beside each assertion, never copied from the module's own output.

§ `Tests of s 215`

§§ `(a): what applies to a nonstock corporation`

-- src:799: ss 211 to 214 and 216 do not apply to nonstock corporations, except s 211(a) and (d) and s 212(c), (d) and (e)
#ASSERT `s 215(a) the provision applies to the corporation` `section 211(a) of this title` `a stock corporation`
#ASSERT `s 215(a) the provision applies to the corporation` `section 211(b) of this title` `a stock corporation`
#ASSERT `s 215(a) the provision applies to the corporation` `section 216 of this title` `a stock corporation`
#ASSERT `s 215(a) the provision applies to the corporation` `section 211(a) of this title` `a nonstock corporation with membership interests`
#ASSERT `s 215(a) the provision applies to the corporation` `section 211(d) of this title` `a nonprofit nonstock corporation that is not charitable`
#ASSERT `s 215(a) the provision applies to the corporation` `section 212(c) of this title` `a charitable nonstock corporation`
#ASSERT `s 215(a) the provision applies to the corporation` `section 212(d) of this title` `a nonstock corporation with membership interests`
#ASSERT `s 215(a) the provision applies to the corporation` `section 212(e) of this title` `a nonprofit nonstock corporation that is not charitable`
#ASSERT NOT (`s 215(a) the provision applies to the corporation` `section 211(b) of this title` `a nonstock corporation with membership interests`)
#ASSERT NOT (`s 215(a) the provision applies to the corporation` `section 211(c) of this title` `a nonprofit nonstock corporation that is not charitable`)
#ASSERT NOT (`s 215(a) the provision applies to the corporation` `section 211(e) of this title` `a charitable nonstock corporation`)
#ASSERT NOT (`s 215(a) the provision applies to the corporation` `section 212(a) of this title` `a nonstock corporation with membership interests`)
#ASSERT NOT (`s 215(a) the provision applies to the corporation` `section 212(b) of this title` `a nonstock corporation with membership interests`)
#ASSERT NOT (`s 215(a) the provision applies to the corporation` `section 213 of this title` `a nonprofit nonstock corporation that is not charitable`)
#ASSERT NOT (`s 215(a) the provision applies to the corporation` `section 214 of this title` `a charitable nonstock corporation`)
#ASSERT NOT (`s 215(a) the provision applies to the corporation` `section 216 of this title` `a nonstock corporation with membership interests`)
-- how the references are read
#ASSERT `s 215(a) a reference to stock, capital stock or shares is read as` `a stock corporation` EQUALS `stock, capital stock or shares of a corporation authorized to issue capital stock`
#ASSERT `s 215(a) a reference to stock, capital stock or shares is read as` `a nonprofit nonstock corporation that is not charitable` EQUALS `memberships of a nonprofit nonstock corporation`
#ASSERT `s 215(a) a reference to stock, capital stock or shares is read as` `a charitable nonstock corporation` EQUALS `memberships of a nonprofit nonstock corporation`
#ASSERT `s 215(a) a reference to stock, capital stock or shares is read as` `a nonstock corporation with membership interests` EQUALS `membership interests of a nonstock corporation that is not a nonprofit nonstock corporation`
#ASSERT `s 215(a) a reference to stockholders is read as` `a stock corporation` EQUALS `a stockholder`
#ASSERT `s 215(a) a reference to stockholders is read as` `a nonstock corporation with membership interests` EQUALS `a member of a nonstock corporation`
#ASSERT `s 215(a) a reference to the board of directors is read as` `a stock corporation` EQUALS `the board of directors of a corporation authorized to issue capital stock`
#ASSERT `s 215(a) a reference to the board of directors is read as` `a charitable nonstock corporation` EQUALS `the governing body of a nonstock corporation`

§§ `(b): votes and proxies of members`

#ASSERT `s 215(b) the number of votes the member is entitled to on each matter` FALSE 0 EQUALS 1
#ASSERT `s 215(b) the number of votes the member is entitled to on each matter` TRUE 3 EQUALS 3
-- the same three-year limit: a proxy dated 1 June 2023 may be voted on until 1 June 2026
#ASSERT `s 215(b) the three-year limit does not stop the member's proxy being voted on` (YMD 2023 6 1) FALSE NOTHING (YMD 2026 6 1)
#ASSERT NOT (`s 215(b) the three-year limit does not stop the member's proxy being voted on` (YMD 2023 6 1) FALSE NOTHING (YMD 2026 6 2))
#ASSERT `s 215(b) the three-year limit does not stop the member's proxy being voted on` (YMD 2023 6 1) TRUE (JUST (YMD 2028 6 1)) (YMD 2028 6 1)

§§ `(c): quorum and vote of members`

-- (1) one-third of the members is a quorum absent a specification: 30 of 90 reaches it, 29 does not
#ASSERT `s 215(c)(1) a quorum of members is present` NOTHING 90 30 EQUALS JUST TRUE
#ASSERT `s 215(c)(1) a quorum of members is present` NOTHING 90 29 EQUALS JUST FALSE
-- a specified quorum of 10 of 90 stands (no floor is stated for nonstock corporations)
#ASSERT `s 215(c)(1) a quorum of members is present` (JUST 10) 90 10 EQUALS JUST TRUE
#ASSERT `s 215(c)(1) a quorum of members is present` (JUST 10) 90 9 EQUALS JUST FALSE
#ASSERT `s 215(c)(1) a quorum of members is present` (JUST 60) 90 59 EQUALS JUST FALSE
#ASSERT `s 215(c)(1) a quorum of members is present` (JUST 60) 90 60 EQUALS JUST TRUE
#ASSERT `s 215(c)(1) a quorum of members is present` NOTHING 0 0 EQUALS NOTHING
#ASSERT `s 215(c)(1) a quorum of members is present` (JUST 10) 0 0 EQUALS NOTHING
-- (2) a majority of the members present and entitled to vote on the subject matter, unless a greater vote is required by the chapter
#ASSERT `s 215(c)(2) the matter other than the election of the governing body is the act of the members` NOTHING NOTHING 31 90 60 60 EQUALS JUST TRUE
#ASSERT `s 215(c)(2) the matter other than the election of the governing body is the act of the members` NOTHING NOTHING 30 90 60 60 EQUALS JUST FALSE
#ASSERT `s 215(c)(2) the matter other than the election of the governing body is the act of the members` (JUST (`at least` ((200 DIVIDED BY 3)%) `of` `the outstanding stock entitled to vote`)) NOTHING 60 90 60 60 EQUALS JUST TRUE
#ASSERT `s 215(c)(2) the matter other than the election of the governing body is the act of the members` (JUST (`at least` ((200 DIVIDED BY 3)%) `of` `the outstanding stock entitled to vote`)) NOTHING 59 90 60 60 EQUALS JUST FALSE
-- (3) plurality
#ASSERT `s 215(c)(3) the candidate is elected to the governing body by a plurality of the votes` 10 (LIST 8, 7) 1 EQUALS JUST TRUE
#ASSERT `s 215(c)(3) the candidate is elected to the governing body by a plurality of the votes` 7 (LIST 10, 8) 1 EQUALS JUST FALSE
#ASSERT `s 215(c)(3) the candidate is elected to the governing body by a plurality of the votes` 8 (LIST 8, 7) 1 EQUALS NOTHING
-- (4) a class or group: a majority of its members present is a quorum, and a majority of those present is its act
#ASSERT `s 215(c)(4) the class or group has a quorum entitled to take action on the matter` 20 11 EQUALS JUST TRUE
#ASSERT `s 215(c)(4) the class or group has a quorum entitled to take action on the matter` 20 10 EQUALS JUST FALSE
#ASSERT `s 215(c)(4) the matter is the act of the class or group` 11 6 EQUALS JUST TRUE
#ASSERT `s 215(c)(4) the matter is the act of the class or group` 11 5 EQUALS JUST FALSE

§§ `(d): an election not held on the designated day`

#ASSERT `s 215(d) the governing body must cause the election to be held as soon thereafter as convenient` TRUE
#ASSERT NOT (`s 215(d) the governing body must cause the election to be held as soon thereafter as convenient` FALSE)
#ASSERT `s 215(d) the failure to hold the election at the designated time works a forfeiture or dissolution of the corporation` TRUE EQUALS JUST FALSE
#ASSERT `s 215(d) the failure to hold the election at the designated time works a forfeiture or dissolution of the corporation` FALSE EQUALS NOTHING
-- any member may apply, with no waiting period named
#ASSERT `s 215(d) the Court of Chancery may summarily order the election to be held` TRUE TRUE
#ASSERT NOT (`s 215(d) the Court of Chancery may summarily order the election to be held` TRUE FALSE)
#ASSERT NOT (`s 215(d) the Court of Chancery may summarily order the election to be held` FALSE TRUE)
#ASSERT `s 215(d) the persons entitled to vote who are present constitute a quorum at the election the Court ordered` 3 EQUALS JUST TRUE
#ASSERT `s 215(d) the persons entitled to vote who are present constitute a quorum at the election the Court ordered` 0 EQUALS NOTHING

§§ `(e) and (f)`

#ASSERT `s 215(e) a ballot submitted by electronic transmission satisfies any requirement of a written ballot` TRUE TRUE
#ASSERT NOT (`s 215(e) a ballot submitted by electronic transmission satisfies any requirement of a written ballot` TRUE FALSE)
#ASSERT NOT (`s 215(e) a ballot submitted by electronic transmission satisfies any requirement of a written ballot` FALSE TRUE)
#ASSERT `s 215(f) the record date for the meeting or corporate action` NOTHING (YMD 2026 5 5) EQUALS YMD 2026 5 5
#ASSERT `s 215(f) the record date for the meeting or corporate action` (JUST (YMD 2026 4 1)) (YMD 2026 5 5) EQUALS YMD 2026 4 1
#ASSERT `s 215(f) the record date does not precede the action of the governing body fixing it` (YMD 2026 4 1) (YMD 2026 4 1)
#ASSERT `s 215(f) the record date does not precede the action of the governing body fixing it` (YMD 2026 4 2) (YMD 2026 4 1)
#ASSERT NOT (`s 215(f) the record date does not precede the action of the governing body fixing it` (YMD 2026 3 31) (YMD 2026 4 1))

§§ `s 114(b)(2) and (c)(2): whether ss 217, 218 and 219 apply to the kind of corporation`

#ASSERT `s 217 the section applies to the kind of corporation` `a stock corporation`
#ASSERT `s 217 the section applies to the kind of corporation` `a nonstock corporation with membership interests`
#ASSERT NOT (`s 217 the section applies to the kind of corporation` `a nonprofit nonstock corporation that is not charitable`)
#ASSERT NOT (`s 217 the section applies to the kind of corporation` `a charitable nonstock corporation`)
#ASSERT `s 218(a) and (b) apply to the kind of corporation` `a stock corporation`
#ASSERT `s 218(a) and (b) apply to the kind of corporation` `a nonstock corporation with membership interests`
#ASSERT NOT (`s 218(a) and (b) apply to the kind of corporation` `a charitable nonstock corporation`)
#ASSERT NOT (`s 218(a) and (b) apply to the kind of corporation` `a nonprofit nonstock corporation that is not charitable`)
#ASSERT `s 218(c) and (d) apply to the kind of corporation` `a charitable nonstock corporation`
#ASSERT `s 218(c) and (d) apply to the kind of corporation` `a stock corporation`
#ASSERT `s 219 the section applies to the kind of corporation` `a stock corporation`
#ASSERT NOT (`s 219 the section applies to the kind of corporation` `a nonstock corporation with membership interests`)
#ASSERT NOT (`s 219 the section applies to the kind of corporation` `a charitable nonstock corporation`)
