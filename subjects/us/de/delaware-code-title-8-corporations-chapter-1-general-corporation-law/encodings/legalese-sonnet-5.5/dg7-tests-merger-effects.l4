IMPORT prelude
IMPORT daydate
IMPORT `dg-core`
IMPORT `dg7-governing-provisions`
IMPORT `dg7-merger-effects`

-- Tests of dg7-merger-effects.l4 (8 Del. C. ss 259 to 261).
-- Every expected value is decided here from the text of ss 259 to 261 (src:1230-1249), then compared with the rule's answer.

§ `Fixtures`

GIVEN effective IS A BOOLEAN
      survivor IS A BOOLEAN
GIVETH A `s 259 Status of a merger or consolidation`
`test a status with` effective survivor MEANS
    `s 259 Status of a merger or consolidation` WITH
        `the merger or consolidation has become effective under this chapter` IS effective
        `the constituent corporation concerned is the one into which the others have been merged` IS survivor

§ `s 259(a) -- the effects`

-- Effective: a constituent corporation that is not the survivor ceases to exist as a separate corporation; the survivor goes on.
#ASSERT `s 259(a) the effect follows` `the separate existence of the constituent corporation ceases` (`test a status with` TRUE FALSE)
#ASSERT NOT (`s 259(a) the effect follows` `the separate existence of the constituent corporation ceases` (`test a status with` TRUE TRUE))
-- Not yet effective: nothing has ceased.
#ASSERT NOT (`s 259(a) the effect follows` `the separate existence of the constituent corporation ceases` (`test a status with` FALSE FALSE))
-- Each of the other effects follows from effectiveness, for the survivor or any constituent.
#ASSERT `s 259(a) the effect follows` `the constituent corporations become a new corporation, or are merged into one of them` (`test a status with` TRUE TRUE)
#ASSERT `s 259(a) the effect follows` `the surviving or resulting corporation has all the rights, privileges, powers and franchises, and is subject to all the restrictions, disabilities and duties, of each constituent corporation` (`test a status with` TRUE TRUE)
#ASSERT `s 259(a) the effect follows` `all property, debts due and things in action of each constituent corporation are vested in the surviving or resulting corporation` (`test a status with` TRUE FALSE)
#ASSERT `s 259(a) the effect follows` `title to real estate vested in a constituent corporation does not revert and is not impaired by reason of this chapter` (`test a status with` TRUE FALSE)
#ASSERT `s 259(a) the effect follows` `the rights of creditors and the liens upon the property of a constituent corporation are preserved unimpaired` (`test a status with` TRUE FALSE)
#ASSERT `s 259(a) the effect follows` `the debts, liabilities and duties of a constituent corporation attach to the surviving or resulting corporation and may be enforced against it as if it had incurred them` (`test a status with` TRUE FALSE)
-- None of them before the transaction is effective.
#ASSERT NOT (`s 259(a) the effect follows` `the constituent corporations become a new corporation, or are merged into one of them` (`test a status with` FALSE TRUE))
#ASSERT NOT (`s 259(a) the effect follows` `all property, debts due and things in action of each constituent corporation are vested in the surviving or resulting corporation` (`test a status with` FALSE TRUE))
#ASSERT NOT (`s 259(a) the effect follows` `the debts, liabilities and duties of a constituent corporation attach to the surviving or resulting corporation and may be enforced against it as if it had incurred them` (`test a status with` FALSE TRUE))
#ASSERT NOT (`s 259(a) the effect follows` `the rights of creditors and the liens upon the property of a constituent corporation are preserved unimpaired` (`test a status with` FALSE TRUE))

§ `s 259(b) -- banks and trust companies`

#ASSERT `s 259(b) the fiduciary appointments and interests vest automatically in the corporation resulting from or surviving the merger` TRUE TRUE
#ASSERT NOT (`s 259(b) the fiduciary appointments and interests vest automatically in the corporation resulting from or surviving the merger` TRUE FALSE)
#ASSERT NOT (`s 259(b) the fiduciary appointments and interests vest automatically in the corporation resulting from or surviving the merger` FALSE TRUE)
-- Any party in interest may apply to a court or tribunal for a determination, in a merger of banks or trust companies.
#ASSERT `s 259(b) the person has the right to apply to a court or tribunal for a determination of the fiduciary` TRUE TRUE
#ASSERT NOT (`s 259(b) the person has the right to apply to a court or tribunal for a determination of the fiduciary` TRUE FALSE)
#ASSERT NOT (`s 259(b) the person has the right to apply to a court or tribunal for a determination of the fiduciary` FALSE TRUE)

§ `s 260(a) -- bonds and other obligations`

-- Payments and obligations to be met: 1,000,000; capital stock 400,000: the bonds may go up to 600,000.
#ASSERT `s 260(a) the most the corporation may issue in bonds or other obligations` 1000000 400000 EQUALS 600000
-- Capital stock covers it all: nothing may be issued under this subsection.
#ASSERT `s 260(a) the most the corporation may issue in bonds or other obligations` 1000000 1000000 EQUALS 0
#ASSERT `s 260(a) the most the corporation may issue in bonds or other obligations` 1000000 1500000 EQUALS 0
#ASSERT `s 260(a) the most the corporation may issue in bonds or other obligations` 1000000 0 EQUALS 1000000
#ASSERT `s 260(a) the corporation may issue bonds or other obligations in this amount` TRUE 600000 1000000 400000
#ASSERT NOT (`s 260(a) the corporation may issue bonds or other obligations in this amount` TRUE 600001 1000000 400000)
#ASSERT `s 260(a) the corporation may issue bonds or other obligations in this amount` TRUE 0 1000000 400000
#ASSERT NOT (`s 260(a) the corporation may issue bonds or other obligations in this amount` TRUE (0 MINUS 1) 1000000 400000)
-- Not a merger, consolidation, conversion or domestication into a corporation of this State.
#ASSERT NOT (`s 260(a) the corporation may issue bonds or other obligations in this amount` FALSE 100 1000000 400000)

§ `s 260(b) -- mortgage`

#ASSERT `s 260(b) the corporation may mortgage its corporate franchise, rights, privileges and property` TRUE
#ASSERT NOT (`s 260(b) the corporation may mortgage its corporate franchise, rights, privileges and property` FALSE)

§ `s 260(c) -- issuing and cancelling`

-- Issue shares in exchange for constituent shares, to effect the merger on the terms of the agreement.
#ASSERT `s 260(c) the corporation may take the action` `issue shares of its capital stock and other securities upon conversion of or in exchange for the shares, rights or securities of, or interests in, a constituent corporation, converting other entity or domesticating non-United States entity` TRUE FALSE TRUE
-- Or to effect a conversion on the terms of a plan the other entity approved.
#ASSERT `s 260(c) the corporation may take the action` `issue shares of its capital stock and other securities upon conversion of or in exchange for the shares, rights or securities of, or interests in, a constituent corporation, converting other entity or domesticating non-United States entity` FALSE TRUE TRUE
-- Not in exchange for the constituent's interests.
#ASSERT NOT (`s 260(c) the corporation may take the action` `issue shares of its capital stock and other securities upon conversion of or in exchange for the shares, rights or securities of, or interests in, a constituent corporation, converting other entity or domesticating non-United States entity` TRUE FALSE FALSE)
-- Not to effect the transaction in either way.
#ASSERT NOT (`s 260(c) the corporation may take the action` `issue shares of its capital stock and other securities upon conversion of or in exchange for the shares, rights or securities of, or interests in, a constituent corporation, converting other entity or domesticating non-United States entity` FALSE FALSE TRUE)
-- Cancel shares, rights, securities or interests, to effect the transaction.
#ASSERT `s 260(c) the corporation may take the action` `cancel any shares, rights, securities or interests` TRUE FALSE FALSE
#ASSERT `s 260(c) the corporation may take the action` `cancel any shares, rights, securities or interests` FALSE TRUE FALSE
#ASSERT NOT (`s 260(c) the corporation may take the action` `cancel any shares, rights, securities or interests` FALSE FALSE FALSE)

§ `s 261(a) -- what a s 251 merger agreement may provide`

-- Fork F-261-1: the agreements of ss 251 (other than 251(g)), 252, 254, 255, 256, 257, 258, 263 and 264 may contain the provisions; a merger under s 251(g), s 253 or s 267, a conversion (s 266) and a transfer (s 390) may not.
#ASSERT `s 261(a) the agreement may contain the provisions of this subsection` `a merger or consolidation under s 251 other than a merger under s 251(g)`
#ASSERT NOT (`s 261(a) the agreement may contain the provisions of this subsection` `a merger under s 251(g)`)
#ASSERT `s 261(a) the agreement may contain the provisions of this subsection` `a merger or consolidation under s 252`
#ASSERT `s 261(a) the agreement may contain the provisions of this subsection` `a merger or consolidation under s 254`
#ASSERT `s 261(a) the agreement may contain the provisions of this subsection` `a merger or consolidation under s 255`
#ASSERT `s 261(a) the agreement may contain the provisions of this subsection` `a merger or consolidation under s 256`
#ASSERT `s 261(a) the agreement may contain the provisions of this subsection` `a merger or consolidation under s 257`
#ASSERT `s 261(a) the agreement may contain the provisions of this subsection` `a merger or consolidation under s 258`
#ASSERT `s 261(a) the agreement may contain the provisions of this subsection` `a merger or consolidation under s 263`
#ASSERT `s 261(a) the agreement may contain the provisions of this subsection` `a merger or consolidation under s 264`
#ASSERT NOT (`s 261(a) the agreement may contain the provisions of this subsection` `a merger of a parent corporation and its subsidiary under s 253`)
#ASSERT NOT (`s 261(a) the agreement may contain the provisions of this subsection` `a conversion under s 266`)
#ASSERT NOT (`s 261(a) the agreement may contain the provisions of this subsection` `a merger of a parent entity and its subsidiary under s 267`)
#ASSERT NOT (`s 261(a) the agreement may contain the provisions of this subsection` `a transfer, domestication or continuance under s 390`)
#ASSERT NOT (`s 261(a) the agreement may contain the provisions of this subsection` `a transaction effected under none of the provisions that s 261 and s 262 name`)

-- (a)(1): a party that fails to perform before the merger is effective, or fails to comply, or fails to consummate.
#ASSERT `s 261(a)(1) the party is subject to the penalties or consequences set forth in the agreement` TRUE TRUE TRUE FALSE FALSE
#ASSERT `s 261(a)(1) the party is subject to the penalties or consequences set forth in the agreement` TRUE TRUE FALSE TRUE FALSE
#ASSERT `s 261(a)(1) the party is subject to the penalties or consequences set forth in the agreement` TRUE TRUE FALSE FALSE TRUE
-- No failure.
#ASSERT NOT (`s 261(a)(1) the party is subject to the penalties or consequences set forth in the agreement` TRUE TRUE FALSE FALSE FALSE)
-- The agreement sets forth none, or is not one that may contain the provision.
#ASSERT NOT (`s 261(a)(1) the party is subject to the penalties or consequences set forth in the agreement` TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`s 261(a)(1) the party is subject to the penalties or consequences set forth in the agreement` FALSE TRUE TRUE TRUE TRUE)

#ASSERT `s 261(a)(1) the penalties or consequences may include an amount based on the loss of the premium or other economic entitlement of the stockholders` TRUE
#ASSERT NOT (`s 261(a)(1) the penalties or consequences may include an amount based on the loss of the premium or other economic entitlement of the stockholders` FALSE)

#ASSERT `s 261(a)(1) the corporation may enforce the other party's payment obligation and retain the payment received` TRUE TRUE
#ASSERT NOT (`s 261(a)(1) the corporation may enforce the other party's payment obligation and retain the payment received` TRUE FALSE)
#ASSERT NOT (`s 261(a)(1) the corporation may enforce the other party's payment obligation and retain the payment received` FALSE TRUE)

-- (a)(2): the representative binds the stockholders of a constituent corporation of this State once the requisite vote has adopted the agreement.
#ASSERT `s 261(a)(2) the appointment of the stockholder representative binds the stockholder` TRUE TRUE TRUE TRUE TRUE
-- Before the requisite vote.
#ASSERT NOT (`s 261(a)(2) the appointment of the stockholder representative binds the stockholder` TRUE TRUE TRUE FALSE TRUE)
-- The agreement does not make the appointment irrevocable and binding.
#ASSERT NOT (`s 261(a)(2) the appointment of the stockholder representative binds the stockholder` TRUE TRUE FALSE TRUE TRUE)
-- The agreement does not provide for the appointment.
#ASSERT NOT (`s 261(a)(2) the appointment of the stockholder representative binds the stockholder` TRUE FALSE TRUE TRUE TRUE)
-- Not a stockholder of a constituent corporation of this State.
#ASSERT NOT (`s 261(a)(2) the appointment of the stockholder representative binds the stockholder` TRUE TRUE TRUE TRUE FALSE)
-- Not an agreement that may contain the provision.
#ASSERT NOT (`s 261(a)(2) the appointment of the stockholder representative binds the stockholder` FALSE TRUE TRUE TRUE TRUE)

-- Amendment after the transaction is effective: not at all, or only with the consent of the persons specified.
#ASSERT `s 261(a)(2) the provision may be amended` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 261(a)(2) the provision may be amended` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 261(a)(2) the provision may be amended` TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 261(a)(2) the provision may be amended` TRUE FALSE FALSE TRUE EQUALS JUST FALSE
-- Not covered: before the transaction is effective the paragraph says nothing about amendment.
#ASSERT `s 261(a)(2) the provision may be amended` FALSE FALSE TRUE TRUE EQUALS NOTHING

#ASSERT `s 261(a) a provision may be made dependent upon facts ascertainable outside the agreement` TRUE
#ASSERT NOT (`s 261(a) a provision may be made dependent upon facts ascertainable outside the agreement` FALSE)

§ `s 261(b) -- pending actions`

#ASSERT `s 261(b) the pending action or proceeding is prosecuted as if the merger or consolidation had not taken place` TRUE TRUE
#ASSERT NOT (`s 261(b) the pending action or proceeding is prosecuted as if the merger or consolidation had not taken place` FALSE TRUE)
#ASSERT NOT (`s 261(b) the pending action or proceeding is prosecuted as if the merger or consolidation had not taken place` TRUE FALSE)
#ASSERT `s 261(b) the surviving or resulting corporation may be substituted in the pending action or proceeding` TRUE TRUE
#ASSERT NOT (`s 261(b) the surviving or resulting corporation may be substituted in the pending action or proceeding` TRUE FALSE)
#ASSERT NOT (`s 261(b) the surviving or resulting corporation may be substituted in the pending action or proceeding` FALSE TRUE)
