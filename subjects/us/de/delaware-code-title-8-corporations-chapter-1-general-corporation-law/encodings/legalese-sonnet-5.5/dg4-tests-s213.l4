IMPORT prelude
IMPORT daydate
IMPORT `dg-core`
IMPORT `dg4-s213-record-dates`

-- Tests of dg4-s213-record-dates.l4. Expected values are written by hand from the text of s 213
-- (de-code-t8-ch1-2026-10-01.txt, lines 788-792), beside each assertion, never copied from the module's own output.

§ `Tests of s 213`

§§ `(a): the record date for a meeting`

-- meeting on 31 March 2026; the board adopts its resolution on 1 January 2026.
-- 60 days before 31 March is 30 January; 10 days before is 21 March.
#ASSERT `s 213(a) the board of directors may fix the day as the record date for the meeting` (YMD 2026 1 30) (YMD 2026 1 1) (YMD 2026 3 31)
#ASSERT `s 213(a) the board of directors may fix the day as the record date for the meeting` (YMD 2026 3 21) (YMD 2026 1 1) (YMD 2026 3 31)
#ASSERT NOT (`s 213(a) the board of directors may fix the day as the record date for the meeting` (YMD 2026 1 29) (YMD 2026 1 1) (YMD 2026 3 31))
#ASSERT NOT (`s 213(a) the board of directors may fix the day as the record date for the meeting` (YMD 2026 3 22) (YMD 2026 1 1) (YMD 2026 3 31))
-- not before the resolution is adopted: the resolution is adopted on 15 February, so 30 January is too early
#ASSERT NOT (`s 213(a) the board of directors may fix the day as the record date for the meeting` (YMD 2026 1 30) (YMD 2026 2 15) (YMD 2026 3 31))
#ASSERT `s 213(a) the board of directors may fix the day as the record date for the meeting` (YMD 2026 2 15) (YMD 2026 2 15) (YMD 2026 3 31)
-- 10 days before 1 March 2028 (a leap year) is 20 February 2028
#ASSERT `s 213(a) the board of directors may fix the day as the record date for the meeting` (YMD 2028 2 20) (YMD 2028 1 1) (YMD 2028 3 1)
#ASSERT NOT (`s 213(a) the board of directors may fix the day as the record date for the meeting` (YMD 2028 2 21) (YMD 2028 1 1) (YMD 2028 3 1))

-- no record date fixed: the day next preceding the day notice is given; with notice waived, the day next preceding the meeting
#ASSERT `s 213(a) the record date for the stockholders entitled to notice of the meeting` NOTHING (YMD 2026 3 11) FALSE (YMD 2026 3 31) EQUALS YMD 2026 3 10
#ASSERT `s 213(a) the record date for the stockholders entitled to notice of the meeting` NOTHING (YMD 2026 3 11) TRUE (YMD 2026 3 31) EQUALS YMD 2026 3 30
#ASSERT `s 213(a) the record date for the stockholders entitled to notice of the meeting` NOTHING (YMD 2026 3 1) FALSE (YMD 2026 3 31) EQUALS YMD 2026 2 28
-- a date fixed by the board is the record date for notice
#ASSERT `s 213(a) the record date for the stockholders entitled to notice of the meeting` (JUST (YMD 2026 3 1)) (YMD 2026 3 11) FALSE (YMD 2026 3 31) EQUALS YMD 2026 3 1

-- the record date for voting: the same date unless the board fixed a later date, on or before the meeting
#ASSERT `s 213(a) the record date for the stockholders entitled to vote at the meeting` (JUST (YMD 2026 3 1)) NOTHING (YMD 2026 3 11) FALSE (YMD 2026 3 31) EQUALS JUST (YMD 2026 3 1)
#ASSERT `s 213(a) the record date for the stockholders entitled to vote at the meeting` (JUST (YMD 2026 3 1)) (JUST (YMD 2026 3 20)) (YMD 2026 3 11) FALSE (YMD 2026 3 31) EQUALS JUST (YMD 2026 3 20)
#ASSERT `s 213(a) the record date for the stockholders entitled to vote at the meeting` (JUST (YMD 2026 3 1)) (JUST (YMD 2026 3 31)) (YMD 2026 3 11) FALSE (YMD 2026 3 31) EQUALS JUST (YMD 2026 3 31)
-- a "later date" after the meeting, or not later than the one fixed, is not what the text allows: not covered
#ASSERT `s 213(a) the record date for the stockholders entitled to vote at the meeting` (JUST (YMD 2026 3 1)) (JUST (YMD 2026 4 1)) (YMD 2026 3 11) FALSE (YMD 2026 3 31) EQUALS NOTHING
#ASSERT `s 213(a) the record date for the stockholders entitled to vote at the meeting` (JUST (YMD 2026 3 1)) (JUST (YMD 2026 3 1)) (YMD 2026 3 11) FALSE (YMD 2026 3 31) EQUALS NOTHING
-- no record date fixed: the same day as for notice
#ASSERT `s 213(a) the record date for the stockholders entitled to vote at the meeting` NOTHING NOTHING (YMD 2026 3 11) FALSE (YMD 2026 3 31) EQUALS JUST (YMD 2026 3 10)
#ASSERT `s 213(a) the record date for the stockholders entitled to vote at the meeting` NOTHING NOTHING (YMD 2026 3 11) TRUE (YMD 2026 3 31) EQUALS JUST (YMD 2026 3 30)

-- adjournment
#ASSERT `s 213(a) the earlier determination of stockholders of record applies to the adjourned meeting` FALSE
#ASSERT NOT (`s 213(a) the earlier determination of stockholders of record applies to the adjourned meeting` TRUE)
#ASSERT `s 213(a) the record date for notice of the adjourned meeting is the same as or earlier than the record date for voting` (YMD 2026 4 1) (YMD 2026 4 1)
#ASSERT `s 213(a) the record date for notice of the adjourned meeting is the same as or earlier than the record date for voting` (YMD 2026 3 30) (YMD 2026 4 1)
#ASSERT NOT (`s 213(a) the record date for notice of the adjourned meeting is the same as or earlier than the record date for voting` (YMD 2026 4 2) (YMD 2026 4 1))

-- who is a stockholder of record at the close of business on 10 March 2026
#ASSERT `s 213 the person was a stockholder of record at the close of business on the record date` (YMD 2020 1 1) NOTHING (YMD 2026 3 10)
#ASSERT `s 213 the person was a stockholder of record at the close of business on the record date` (YMD 2026 3 10) NOTHING (YMD 2026 3 10)
#ASSERT NOT (`s 213 the person was a stockholder of record at the close of business on the record date` (YMD 2026 3 11) NOTHING (YMD 2026 3 10))
#ASSERT `s 213 the person was a stockholder of record at the close of business on the record date` (YMD 2020 1 1) (JUST (YMD 2026 3 11)) (YMD 2026 3 10)
#ASSERT NOT (`s 213 the person was a stockholder of record at the close of business on the record date` (YMD 2020 1 1) (JUST (YMD 2026 3 10)) (YMD 2026 3 10))
#ASSERT NOT (`s 213 the person was a stockholder of record at the close of business on the record date` (YMD 2020 1 1) (JUST (YMD 2026 3 9)) (YMD 2026 3 10))

§§ `(b): the record date for written consent`

-- the resolution is adopted on 1 March: the record date may be 1 March to 11 March
#ASSERT `s 213(b) the board of directors may fix the day as the record date for consent without a meeting` (YMD 2026 3 1) (YMD 2026 3 1)
#ASSERT `s 213(b) the board of directors may fix the day as the record date for consent without a meeting` (YMD 2026 3 11) (YMD 2026 3 1)
#ASSERT NOT (`s 213(b) the board of directors may fix the day as the record date for consent without a meeting` (YMD 2026 3 12) (YMD 2026 3 1))
#ASSERT NOT (`s 213(b) the board of directors may fix the day as the record date for consent without a meeting` (YMD 2026 2 28) (YMD 2026 3 1))
-- 10 days after 25 February 2028 (a leap year) is 6 March 2028
#ASSERT `s 213(b) the board of directors may fix the day as the record date for consent without a meeting` (YMD 2028 3 6) (YMD 2028 2 25)
#ASSERT NOT (`s 213(b) the board of directors may fix the day as the record date for consent without a meeting` (YMD 2028 3 7) (YMD 2028 2 25))
-- defaults
#ASSERT `s 213(b) the record date for consent without a meeting` (JUST (YMD 2026 3 5)) FALSE (JUST (YMD 2026 3 20)) NOTHING EQUALS JUST (YMD 2026 3 5)
#ASSERT `s 213(b) the record date for consent without a meeting` NOTHING FALSE (JUST (YMD 2026 3 20)) NOTHING EQUALS JUST (YMD 2026 3 20)
#ASSERT `s 213(b) the record date for consent without a meeting` NOTHING TRUE (JUST (YMD 2026 3 20)) (JUST (YMD 2026 3 3)) EQUALS JUST (YMD 2026 3 3)
-- prior board action required and not yet taken: no record date yet
#ASSERT `s 213(b) the record date for consent without a meeting` NOTHING TRUE (JUST (YMD 2026 3 20)) NOTHING EQUALS NOTHING
-- no consent delivered yet and no prior action required: no record date yet
#ASSERT `s 213(b) the record date for consent without a meeting` NOTHING FALSE NOTHING NOTHING EQUALS NOTHING

§§ `(c): the record date for any other purpose`

-- the action is on 1 June 2026; resolution adopted on 1 March; 60 days before 1 June is 2 April
#ASSERT `s 213(c) the board of directors may fix the day as the record date for the other purpose` (YMD 2026 4 2) (YMD 2026 3 1) (YMD 2026 6 1)
#ASSERT NOT (`s 213(c) the board of directors may fix the day as the record date for the other purpose` (YMD 2026 4 1) (YMD 2026 3 1) (YMD 2026 6 1))
#ASSERT `s 213(c) the board of directors may fix the day as the record date for the other purpose` (YMD 2026 6 1) (YMD 2026 3 1) (YMD 2026 6 1)
#ASSERT NOT (`s 213(c) the board of directors may fix the day as the record date for the other purpose` (YMD 2026 2 28) (YMD 2026 3 1) (YMD 2026 6 1))
-- the text names no latest day: a record date after the action is not barred by this subsection (fork F-U)
#ASSERT `s 213(c) the board of directors may fix the day as the record date for the other purpose` (YMD 2026 6 15) (YMD 2026 3 1) (YMD 2026 6 1)
#ASSERT `s 213(c) the record date for the other purpose` NOTHING (YMD 2026 3 1) EQUALS YMD 2026 3 1
#ASSERT `s 213(c) the record date for the other purpose` (JUST (YMD 2026 4 2)) (YMD 2026 3 1) EQUALS YMD 2026 4 2
