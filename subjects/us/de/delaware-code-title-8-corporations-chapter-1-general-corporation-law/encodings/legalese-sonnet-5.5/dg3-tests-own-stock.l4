IMPORT prelude
IMPORT daydate
IMPORT `dg-core`
IMPORT `dg3-stock-issue`
IMPORT `dg3-own-stock`

-- Tests of dg3-own-stock.l4 (sections 159, 160 and 169).
-- Every expected value was decided by reading the section, then written beside the assertion; none is copied from the encoding's output.

§ `Section 159: personal property, transfer and taxation`

#ASSERT `s 159 the shares are deemed personal property` TRUE
#ASSERT NOT (`s 159 the shares are deemed personal property` FALSE)
#ASSERT `s 159 the shares are transferable by that transfer` TRUE
#ASSERT NOT (`s 159 the shares are transferable by that transfer` FALSE)
-- stock or bonds of a corporation organized under the chapter owned by a nonresident, or by a foreign corporation, are not taxed by this State
#ASSERT `s 159 the stock or bonds are exempt from taxation by this State` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 159 the stock or bonds are exempt from taxation by this State` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 159 the stock or bonds are exempt from taxation by this State` TRUE TRUE TRUE EQUALS JUST TRUE
-- owned by a resident who is not a foreign corporation: the section says nothing
#ASSERT `s 159 the stock or bonds are exempt from taxation by this State` TRUE FALSE FALSE EQUALS NOTHING
-- not issued by a corporation organized under this chapter: the section does not reach it
#ASSERT `s 159 the stock or bonds are exempt from taxation by this State` FALSE TRUE TRUE EQUALS NOTHING
-- a transfer for collateral security is so expressed in the entry of transfer if both transferor and transferee so request
#ASSERT `s 159 the entry of transfer must express that the transfer is for collateral security` TRUE TRUE
#ASSERT NOT (`s 159 the entry of transfer must express that the transfer is for collateral security` TRUE FALSE)
#ASSERT NOT (`s 159 the entry of transfer must express that the transfer is for collateral security` FALSE TRUE)

§ `Section 160(a): the corporation's purchase or redemption of its own shares`

GIVEN k IS A `Kind of corporation`
      impaired IS A BOOLEAN
      wouldImpair IS A BOOLEAN
      preference IS A BOOLEAN
      noPreferredOutstanding IS A BOOLEAN
      retired IS A BOOLEAN
      reduced IS A BOOLEAN
GIVETH A `s 160(a)(1) Facts about a purchase or redemption of the corporation's own shares`
`dg3 test own shares` k impaired wouldImpair preference noPreferredOutstanding retired reduced MEANS
    `s 160(a)(1) Facts about a purchase or redemption of the corporation's own shares` WITH
        `the kind of corporation` IS k
        `the capital of the corporation is impaired` IS impaired
        `the purchase or redemption would cause an impairment of the capital` IS wouldImpair
        `the shares are entitled upon any distribution of assets, by dividend or in liquidation, to a preference over another class or series` IS preference
        `no shares entitled to such a preference are outstanding` IS noPreferredOutstanding
        `the shares will be retired upon their acquisition` IS retired
        `the capital of the corporation is reduced in accordance with sections 243 and 244` IS reduced

-- capital impaired, no exception: barred
#ASSERT `s 160(a)(1) the purchase or redemption is barred` (`dg3 test own shares` `a stock corporation` TRUE FALSE FALSE FALSE FALSE FALSE)
-- the purchase would cause an impairment: barred
#ASSERT `s 160(a)(1) the purchase or redemption is barred` (`dg3 test own shares` `a stock corporation` FALSE TRUE FALSE FALSE FALSE FALSE)
-- neither impaired nor impairing: not barred
#ASSERT NOT (`s 160(a)(1) the purchase or redemption is barred` (`dg3 test own shares` `a stock corporation` FALSE FALSE FALSE FALSE FALSE FALSE))
-- shares entitled to a preference on distribution of assets may be bought out of capital by a corporation other than a nonstock corporation
#ASSERT NOT (`s 160(a)(1) the purchase or redemption is barred` (`dg3 test own shares` `a stock corporation` TRUE FALSE TRUE FALSE FALSE FALSE))
-- no preference shares outstanding: any shares may be bought out of capital if they are retired and the capital reduced under sections 243 and 244
#ASSERT NOT (`s 160(a)(1) the purchase or redemption is barred` (`dg3 test own shares` `a stock corporation` TRUE FALSE FALSE TRUE TRUE TRUE))
#ASSERT `s 160(a)(1) the purchase or redemption is barred` (`dg3 test own shares` `a stock corporation` TRUE FALSE FALSE TRUE TRUE FALSE)
#ASSERT `s 160(a)(1) the purchase or redemption is barred` (`dg3 test own shares` `a stock corporation` TRUE FALSE FALSE TRUE FALSE TRUE)
#ASSERT `s 160(a)(1) the purchase or redemption is barred` (`dg3 test own shares` `a stock corporation` TRUE FALSE FALSE FALSE TRUE TRUE)
-- a nonstock corporation cannot use the exception, whatever the facts
#ASSERT `s 160(a)(1) the purchase or redemption is barred` (`dg3 test own shares` `a nonstock corporation with membership interests` TRUE FALSE TRUE TRUE TRUE TRUE)
#ASSERT `s 160(a)(1) the purchase or redemption is barred` (`dg3 test own shares` `a charitable nonstock corporation` TRUE FALSE TRUE FALSE FALSE FALSE)
-- a note given as consideration is not invalidated if the capital was not then impaired or did not thereby become impaired
#ASSERT `s 160(a)(1) the note, debenture or obligation given for the acquisition is not invalidated` TRUE TRUE
#ASSERT `s 160(a)(1) the note, debenture or obligation given for the acquisition is not invalidated` TRUE FALSE
#ASSERT `s 160(a)(1) the note, debenture or obligation given for the acquisition is not invalidated` FALSE TRUE
#ASSERT NOT (`s 160(a)(1) the note, debenture or obligation given for the acquisition is not invalidated` FALSE FALSE)
-- (2): not more than the redemption price for shares redeemable at the corporation's option
#ASSERT NOT (`s 160(a)(2) the purchase is barred` TRUE 100 100)
#ASSERT `s 160(a)(2) the purchase is barred` TRUE 101 100
#ASSERT NOT (`s 160(a)(2) the purchase is barred` FALSE 200 100)

`dg3 test redeemable` MEANS
    `s 151(b) Redemption terms` WITH
        `how the redemption is triggered` IS `at the option of the corporation under s 151(b)`
        `immediately following the redemption 1 or more shares of 1 or more classes or series with full voting powers will be outstanding` IS TRUE
        `the stock is stock of a regulated investment company registered under the Investment Company Act of 1940` IS FALSE
        `the corporation holds a licence or franchise from a governmental agency to conduct its business, or is a member of a national securities exchange, conditioned on holders of its stock possessing prescribed qualifications` IS FALSE
        `the redemption is to the extent necessary to prevent the loss of the licence, franchise or membership or to reinstate it` IS FALSE

`dg3 test not redeemable` MEANS
    `s 151(b) Redemption terms` WITH
        `how the redemption is triggered` IS `at the option of the corporation under s 151(b)`
        `immediately following the redemption 1 or more shares of 1 or more classes or series with full voting powers will be outstanding` IS FALSE
        `the stock is stock of a regulated investment company registered under the Investment Company Act of 1940` IS FALSE
        `the corporation holds a licence or franchise from a governmental agency to conduct its business, or is a member of a national securities exchange, conditioned on holders of its stock possessing prescribed qualifications` IS FALSE
        `the redemption is to the extent necessary to prevent the loss of the licence, franchise or membership or to reinstate it` IS FALSE

-- (3)a.: a stock corporation redeems only as section 151(b) authorises, and then only in accordance with it and the certificate
#ASSERT NOT (`s 160(a)(3) the redemption is barred` `a stock corporation` `dg3 test redeemable` TRUE FALSE FALSE)
#ASSERT `s 160(a)(3) the redemption is barred` `a stock corporation` `dg3 test redeemable` FALSE FALSE FALSE
#ASSERT `s 160(a)(3) the redemption is barred` `a stock corporation` `dg3 test not redeemable` TRUE FALSE FALSE
-- (3)b.: a nonstock corporation redeems membership interests only as its certificate authorises, and then only in accordance with it
#ASSERT NOT (`s 160(a)(3) the redemption is barred` `a nonstock corporation with membership interests` `dg3 test not redeemable` FALSE TRUE TRUE)
#ASSERT `s 160(a)(3) the redemption is barred` `a nonstock corporation with membership interests` `dg3 test redeemable` TRUE FALSE FALSE
#ASSERT `s 160(a)(3) the redemption is barred` `a nonprofit nonstock corporation that is not charitable` `dg3 test redeemable` TRUE TRUE FALSE
-- (a), the grant: the corporation may deal in its own shares if none of the three bars applies, and only then
#ASSERT `s 160(a) the corporation may deal in its own shares` FALSE FALSE FALSE
#ASSERT NOT (`s 160(a) the corporation may deal in its own shares` TRUE FALSE FALSE)
#ASSERT NOT (`s 160(a) the corporation may deal in its own shares` FALSE TRUE FALSE)
#ASSERT NOT (`s 160(a) the corporation may deal in its own shares` FALSE FALSE TRUE)
-- (b): the right to resell treasury shares under section 153(c) is unaffected if they were bought out of surplus and are not, and need not be, retired
#ASSERT `s 160(b) the corporation's right to resell the shares under section 153(c) is unaffected` TRUE FALSE FALSE
#ASSERT NOT (`s 160(b) the corporation's right to resell the shares under section 153(c) is unaffected` FALSE FALSE FALSE)
#ASSERT NOT (`s 160(b) the corporation's right to resell the shares under section 153(c) is unaffected` TRUE TRUE FALSE)
#ASSERT NOT (`s 160(b) the corporation's right to resell the shares under section 153(c) is unaffected` TRUE FALSE TRUE)

§ `Section 160(c): shares that neither vote nor count for quorum purposes`

GIVEN holder IS A `s 160(c) Who holds the shares`
      majorityOfShares IS A BOOLEAN
      majorityOfPower IS A BOOLEAN
      controlled IS A BOOLEAN
      fiduciary IS A BOOLEAN
GIVETH A `s 160(c) Facts about shares of the corporation's capital stock`
`dg3 test holder` holder majorityOfShares majorityOfPower controlled fiduciary MEANS
    `s 160(c) Facts about shares of the corporation's capital stock` WITH
        `who holds the shares` IS holder
        `a majority of the shares entitled to vote in the election of directors of the other corporation is held, directly or indirectly, by the corporation` IS majorityOfShares
        `a majority of the voting power of the other entity is held, directly or indirectly, by the corporation` IS majorityOfPower
        `the other entity is otherwise controlled, directly or indirectly, by the corporation` IS controlled
        `the holder holds the shares in a fiduciary capacity` IS fiduciary

-- (1) the corporation's own shares; (2) another corporation, majority of its shares entitled to vote for directors held by the corporation; (3) any other entity, majority of voting power or otherwise controlled
#ASSERT `s 160(c) the shares neither vote nor count for quorum purposes` (`dg3 test holder` `the corporation itself under s 160(c)` FALSE FALSE FALSE FALSE)
#ASSERT `s 160(c) the shares neither vote nor count for quorum purposes` (`dg3 test holder` `another corporation under s 160(c)` TRUE FALSE FALSE FALSE)
#ASSERT NOT (`s 160(c) the shares neither vote nor count for quorum purposes` (`dg3 test holder` `another corporation under s 160(c)` FALSE TRUE TRUE FALSE))
#ASSERT `s 160(c) the shares neither vote nor count for quorum purposes` (`dg3 test holder` `any other entity under s 160(c)` FALSE TRUE FALSE FALSE)
#ASSERT `s 160(c) the shares neither vote nor count for quorum purposes` (`dg3 test holder` `any other entity under s 160(c)` FALSE FALSE TRUE FALSE)
#ASSERT NOT (`s 160(c) the shares neither vote nor count for quorum purposes` (`dg3 test holder` `any other entity under s 160(c)` TRUE FALSE FALSE FALSE))
#ASSERT NOT (`s 160(c) the shares neither vote nor count for quorum purposes` (`dg3 test holder` `a holder that is neither the corporation, a corporation it controls nor an entity it controls under s 160(c)` TRUE TRUE TRUE FALSE))
-- the right to vote stock held in a fiduciary capacity is not limited
#ASSERT `s 160(c) the section does not limit the holder's right to vote the stock` (`dg3 test holder` `the corporation itself under s 160(c)` FALSE FALSE FALSE TRUE)
#ASSERT NOT (`s 160(c) the section does not limit the holder's right to vote the stock` (`dg3 test holder` `the corporation itself under s 160(c)` FALSE FALSE FALSE FALSE))
-- what the section settles: cannot vote unless held as a fiduciary; otherwise it does not say
#ASSERT `s 160(c) the shares may be voted, as far as this section decides` (`dg3 test holder` `the corporation itself under s 160(c)` FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 160(c) the shares may be voted, as far as this section decides` (`dg3 test holder` `the corporation itself under s 160(c)` FALSE FALSE FALSE TRUE) EQUALS JUST TRUE
#ASSERT `s 160(c) the shares may be voted, as far as this section decides` (`dg3 test holder` `a holder that is neither the corporation, a corporation it controls nor an entity it controls under s 160(c)` FALSE FALSE FALSE FALSE) EQUALS NOTHING
-- quorum: not counted unless the section's fiduciary clause may restore them, which it does not say
#ASSERT `s 160(c) the shares are counted for quorum purposes, as far as this section decides` (`dg3 test holder` `another corporation under s 160(c)` TRUE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 160(c) the shares are counted for quorum purposes, as far as this section decides` (`dg3 test holder` `another corporation under s 160(c)` TRUE FALSE FALSE TRUE) EQUALS NOTHING
#ASSERT `s 160(c) the shares are counted for quorum purposes, as far as this section decides` (`dg3 test holder` `a holder that is neither the corporation, a corporation it controls nor an entity it controls under s 160(c)` FALSE FALSE FALSE FALSE) EQUALS NOTHING

§ `Section 160(d): shares called for redemption`

-- notice sent 1 May 2026 and the sum deposited 10 May 2026: from 10 May the shares are not outstanding for voting
#ASSERT NOT (`s 160(d) the shares called for redemption are not outstanding for voting on the day` (YearMonthDay 2026 5 9) (JUST (YearMonthDay 2026 5 1)) (JUST (YearMonthDay 2026 5 10)))
#ASSERT `s 160(d) the shares called for redemption are not outstanding for voting on the day` (YearMonthDay 2026 5 10) (JUST (YearMonthDay 2026 5 1)) (JUST (YearMonthDay 2026 5 10))
#ASSERT `s 160(d) the shares called for redemption are not outstanding for voting on the day` (YearMonthDay 2026 5 11) (JUST (YearMonthDay 2026 5 1)) (JUST (YearMonthDay 2026 5 10))
-- the sum deposited before the notice is sent: from the day of the notice
#ASSERT NOT (`s 160(d) the shares called for redemption are not outstanding for voting on the day` (YearMonthDay 2026 5 9) (JUST (YearMonthDay 2026 5 10)) (JUST (YearMonthDay 2026 5 1)))
#ASSERT `s 160(d) the shares called for redemption are not outstanding for voting on the day` (YearMonthDay 2026 5 10) (JUST (YearMonthDay 2026 5 10)) (JUST (YearMonthDay 2026 5 1))
-- notice without a deposit, or a deposit without notice: the shares are still outstanding
#ASSERT NOT (`s 160(d) the shares called for redemption are not outstanding for voting on the day` (YearMonthDay 2026 6 1) (JUST (YearMonthDay 2026 5 1)) NOTHING)
#ASSERT NOT (`s 160(d) the shares called for redemption are not outstanding for voting on the day` (YearMonthDay 2026 6 1) NOTHING (JUST (YearMonthDay 2026 5 1)))

§ `Section 169: situs of ownership of stock`

#ASSERT `s 169 the situs of the ownership of the capital stock is regarded as in this State` TRUE `title under s 169` EQUALS JUST TRUE
#ASSERT `s 169 the situs of the ownership of the capital stock is regarded as in this State` TRUE `action under s 169` EQUALS JUST TRUE
#ASSERT `s 169 the situs of the ownership of the capital stock is regarded as in this State` TRUE `attachment under s 169` EQUALS JUST TRUE
#ASSERT `s 169 the situs of the ownership of the capital stock is regarded as in this State` TRUE `garnishment under s 169` EQUALS JUST TRUE
#ASSERT `s 169 the situs of the ownership of the capital stock is regarded as in this State` TRUE `jurisdiction of the courts held in this State under s 169` EQUALS JUST TRUE
-- not for the purpose of taxation
#ASSERT `s 169 the situs of the ownership of the capital stock is regarded as in this State` TRUE `taxation under s 169` EQUALS JUST FALSE
-- any other purpose, or a corporation not existing under the laws of this State: the section says nothing
#ASSERT `s 169 the situs of the ownership of the capital stock is regarded as in this State` TRUE `another purpose under s 169` EQUALS NOTHING
#ASSERT `s 169 the situs of the ownership of the capital stock is regarded as in this State` FALSE `attachment under s 169` EQUALS NOTHING
