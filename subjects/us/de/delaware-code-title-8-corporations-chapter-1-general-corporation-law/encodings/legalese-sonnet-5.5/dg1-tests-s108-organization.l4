IMPORT prelude
IMPORT daydate
IMPORT `dg-core`
IMPORT `dg1-s108-organization`

-- Tests of section 108 (dg1-s108-organization.l4). Every expected value is written by hand from the text
-- (src:134-137), beside the assertion, and was decided before the module was run.

§ `Tests of section 108`

§§ `s 108(a)`

-- initial directors named in the certificate: the meeting is of the board; otherwise of the incorporators
#ASSERT `s 108(a) the organization meeting is a meeting of the board of directors and not of the incorporators` TRUE
#ASSERT NOT (`s 108(a) the organization meeting is a meeting of the board of directors and not of the incorporators` FALSE)
-- the call: a majority (more than half) of the incorporators, or of the directors
#ASSERT `s 108(a) the call of the organization meeting is made by a majority of the incorporators or directors` FALSE 2 3 EQUALS JUST TRUE
#ASSERT `s 108(a) the call of the organization meeting is made by a majority of the incorporators or directors` FALSE 1 2 EQUALS JUST FALSE
#ASSERT `s 108(a) the call of the organization meeting is made by a majority of the incorporators or directors` FALSE 1 1 EQUALS JUST TRUE
#ASSERT `s 108(a) the call of the organization meeting is made by a majority of the incorporators or directors` TRUE 3 5 EQUALS JUST TRUE
#ASSERT `s 108(a) the call of the organization meeting is made by a majority of the incorporators or directors` TRUE 2 4 EQUALS JUST FALSE
-- counts that cannot be a vote
#ASSERT `s 108(a) the call of the organization meeting is made by a majority of the incorporators or directors` TRUE 0 0 EQUALS NOTHING
#ASSERT `s 108(a) the call of the organization meeting is made by a majority of the incorporators or directors` FALSE 4 3 EQUALS NOTHING
-- within or without this State
#ASSERT `s 108(a) the organization meeting may be held at the place` `within this State`
#ASSERT `s 108(a) the organization meeting may be held at the place` `without this State`
-- the purposes: electing directors only if the meeting is of the incorporators, electing officers only if of the directors
#ASSERT `s 108(a) the purpose may be pursued at the organization meeting` `adopting bylaws` FALSE
#ASSERT `s 108(a) the purpose may be pursued at the organization meeting` `adopting bylaws` TRUE
#ASSERT `s 108(a) the purpose may be pursued at the organization meeting` `electing directors` FALSE
#ASSERT NOT (`s 108(a) the purpose may be pursued at the organization meeting` `electing directors` TRUE)
#ASSERT `s 108(a) the purpose may be pursued at the organization meeting` `electing officers` TRUE
#ASSERT NOT (`s 108(a) the purpose may be pursued at the organization meeting` `electing officers` FALSE)
#ASSERT `s 108(a) the purpose may be pursued at the organization meeting` `doing any other or further acts to perfect the organization of the corporation` FALSE
#ASSERT `s 108(a) the purpose may be pursued at the organization meeting` `transacting such other business as may come before the meeting` TRUE

§§ `s 108(b)`

-- at least 2 days' notice: given on 10 March 2026, the meeting may be on 12 March (2 days) but not on 11 March (1 day)
#ASSERT `s 108(b) the notice of the organization meeting is sufficient` (YearMonthDay 2026 3 10) (YearMonthDay 2026 3 12) TRUE TRUE
#ASSERT `s 108(b) the notice of the organization meeting is sufficient` (YearMonthDay 2026 3 10) (YearMonthDay 2026 3 20) TRUE TRUE
#ASSERT NOT (`s 108(b) the notice of the organization meeting is sufficient` (YearMonthDay 2026 3 10) (YearMonthDay 2026 3 11) TRUE TRUE)
#ASSERT NOT (`s 108(b) the notice of the organization meeting is sufficient` (YearMonthDay 2026 3 10) (YearMonthDay 2026 3 10) TRUE TRUE)
-- across a month end: given 30 March, 2 days later is 1 April
#ASSERT `s 108(b) the notice of the organization meeting is sufficient` (YearMonthDay 2026 3 30) (YearMonthDay 2026 4 1) TRUE TRUE
#ASSERT NOT (`s 108(b) the notice of the organization meeting is sufficient` (YearMonthDay 2026 3 30) (YearMonthDay 2026 3 31) TRUE TRUE)
-- in writing or by electronic transmission, stating time, place and purposes
#ASSERT NOT (`s 108(b) the notice of the organization meeting is sufficient` (YearMonthDay 2026 3 10) (YearMonthDay 2026 3 20) FALSE TRUE)
#ASSERT NOT (`s 108(b) the notice of the organization meeting is sufficient` (YearMonthDay 2026 3 10) (YearMonthDay 2026 3 20) TRUE FALSE)
-- no notice need be given to one who attends or waives, before or after
#ASSERT `s 108(b) notice of the meeting need not be given to the person` TRUE FALSE FALSE
#ASSERT `s 108(b) notice of the meeting need not be given to the person` FALSE TRUE FALSE
#ASSERT `s 108(b) notice of the meeting need not be given to the person` FALSE FALSE TRUE
#ASSERT NOT (`s 108(b) notice of the meeting need not be given to the person` FALSE FALSE FALSE)

§§ `s 108(c)`

-- each incorporator or director, or the sole one, consents; unless the certificate restricts
#ASSERT `s 108(c) the action may be taken without a meeting` FALSE 3 3 EQUALS JUST TRUE
#ASSERT `s 108(c) the action may be taken without a meeting` FALSE 1 1 EQUALS JUST TRUE
#ASSERT `s 108(c) the action may be taken without a meeting` FALSE 3 2 EQUALS JUST FALSE
#ASSERT `s 108(c) the action may be taken without a meeting` FALSE 3 0 EQUALS JUST FALSE
#ASSERT `s 108(c) the action may be taken without a meeting` TRUE 3 3 EQUALS JUST FALSE
-- counts that cannot be
#ASSERT `s 108(c) the action may be taken without a meeting` FALSE 0 0 EQUALS NOTHING
#ASSERT `s 108(c) the action may be taken without a meeting` FALSE 2 3 EQUALS NOTHING
#ASSERT `s 108(c) the action may be taken without a meeting` FALSE 2 (0 MINUS 1) EQUALS NOTHING
#ASSERT `s 108(c) the action may be taken without a meeting` FALSE 1.5 1 EQUALS NOTHING
-- a consent effective at a future time no later than 60 days after the instruction: instruction 1 January 2026
-- (60 days after is 2 March 2026: 31 + 28 = 59 days to 1 March, one more is 2 March)
#ASSERT `s 108(c) the consent given for a future time is deemed given at that time` (YearMonthDay 2026 1 1) (YearMonthDay 2026 3 2) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 108(c) the consent given for a future time is deemed given at that time` (YearMonthDay 2026 1 1) (YearMonthDay 2026 3 3) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 108(c) the consent given for a future time is deemed given at that time` (YearMonthDay 2026 1 1) (YearMonthDay 2026 1 1) TRUE FALSE EQUALS JUST TRUE
-- the person must then be an incorporator or director, and must not have revoked
#ASSERT `s 108(c) the consent given for a future time is deemed given at that time` (YearMonthDay 2026 1 1) (YearMonthDay 2026 2 1) FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 108(c) the consent given for a future time is deemed given at that time` (YearMonthDay 2026 1 1) (YearMonthDay 2026 2 1) TRUE TRUE EQUALS JUST FALSE
-- a time before the instruction is not a future time
#ASSERT `s 108(c) the consent given for a future time is deemed given at that time` (YearMonthDay 2026 1 1) (YearMonthDay 2025 12 31) TRUE FALSE EQUALS NOTHING
-- revocable prior to becoming effective
#ASSERT `s 108(c) the consent may still be revoked` (YearMonthDay 2026 1 15) (YearMonthDay 2026 2 1) EQUALS JUST TRUE
#ASSERT `s 108(c) the consent may still be revoked` (YearMonthDay 2026 2 2) (YearMonthDay 2026 2 1) EQUALS JUST FALSE
#ASSERT `s 108(c) the consent may still be revoked` (YearMonthDay 2026 2 1) (YearMonthDay 2026 2 1) EQUALS NOTHING

§§ `s 108(d)`

#ASSERT `s 108(d) the person may take the action that the incorporator would have been authorized to take under this section or § 107` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 108(d) the person may take the action that the incorporator would have been authorized to take under this section or § 107` FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`s 108(d) the person may take the action that the incorporator would have been authorized to take under this section or § 107` TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`s 108(d) the person may take the action that the incorporator would have been authorized to take under this section or § 107` TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 108(d) the person may take the action that the incorporator would have been authorized to take under this section or § 107` TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 108(d) the person may take the action that the incorporator would have been authorized to take under this section or § 107` TRUE TRUE TRUE TRUE FALSE)
