IMPORT prelude
IMPORT daydate
IMPORT `dg-core`
IMPORT `dg4-s218-voting-trusts`

-- Tests of dg4-s218-voting-trusts.l4. Expected values are written by hand from the text of s 218
-- (de-code-t8-ch1-2026-10-01.txt, lines 828-833), beside each assertion, never copied from the module's own output.

§ `Tests of s 218`

§§ `(a): the voting trust`

#ASSERT `s 218(a) the agreement creates a voting trust` TRUE TRUE TRUE
#ASSERT NOT (`s 218(a) the agreement creates a voting trust` FALSE TRUE TRUE)
#ASSERT NOT (`s 218(a) the agreement creates a voting trust` TRUE FALSE TRUE)
#ASSERT NOT (`s 218(a) the agreement creates a voting trust` TRUE TRUE FALSE)
-- stock is issued to the trustee after the copy is delivered
#ASSERT `s 218(a) the corporation must issue stock to the voting trustee in place of the stock deposited or transferred` TRUE
#ASSERT NOT (`s 218(a) the corporation must issue stock to the voting trustee in place of the stock deposited or transferred` FALSE)
-- the copy is open to any stockholder or beneficiary daily during business hours
#ASSERT `s 218(a) the person may inspect the copy of the voting trust agreement` TRUE TRUE TRUE
#ASSERT NOT (`s 218(a) the person may inspect the copy of the voting trust agreement` FALSE TRUE TRUE)
#ASSERT NOT (`s 218(a) the person may inspect the copy of the voting trust agreement` TRUE FALSE TRUE)
#ASSERT NOT (`s 218(a) the person may inspect the copy of the voting trust agreement` TRUE TRUE FALSE)
-- the certificate, if any, and the stock ledger state that the stock is issued pursuant to the agreement
#ASSERT `s 218(a) the certificate and the stock ledger state that the stock is issued pursuant to the agreement` TRUE TRUE TRUE
#ASSERT `s 218(a) the certificate and the stock ledger state that the stock is issued pursuant to the agreement` FALSE FALSE TRUE
#ASSERT NOT (`s 218(a) the certificate and the stock ledger state that the stock is issued pursuant to the agreement` TRUE FALSE TRUE)
#ASSERT NOT (`s 218(a) the certificate and the stock ledger state that the stock is issued pursuant to the agreement` TRUE TRUE FALSE)
#ASSERT NOT (`s 218(a) the certificate and the stock ledger state that the stock is issued pursuant to the agreement` FALSE FALSE FALSE)
-- voting and responsibility
#ASSERT `s 218(a) the voting trustee may vote the stock in person or by proxy` TRUE
#ASSERT NOT (`s 218(a) the voting trustee may vote the stock in person or by proxy` FALSE)
#ASSERT `s 218(a) the voting trustee incurs responsibility as stockholder, trustee or otherwise in voting the stock` TRUE
#ASSERT NOT (`s 218(a) the voting trustee incurs responsibility as stockholder, trustee or otherwise in voting the stock` FALSE)
-- two or more trustees
#ASSERT `s 218(a) how the stock is voted when two or more persons or entities are voting trustees` TRUE FALSE EQUALS `as the agreement appointing the trustees fixes`
#ASSERT `s 218(a) how the stock is voted when two or more persons or entities are voting trustees` FALSE FALSE EQUALS `as determined by a majority of the trustees`
#ASSERT `s 218(a) how the stock is voted when two or more persons or entities are voting trustees` FALSE TRUE EQUALS `the vote of the stock is divided equally among the trustees`

§§ `(b), (c), (d)`

#ASSERT `s 218(b) the amendment to the voting trust agreement is made as the subsection requires` TRUE TRUE
#ASSERT NOT (`s 218(b) the amendment to the voting trust agreement is made as the subsection requires` FALSE TRUE)
#ASSERT NOT (`s 218(b) the amendment to the voting trust agreement is made as the subsection requires` TRUE FALSE)
#ASSERT `s 218(c) the agreement may provide how the shares held by the parties are voted` TRUE TRUE TRUE
#ASSERT NOT (`s 218(c) the agreement may provide how the shares held by the parties are voted` FALSE TRUE TRUE)
#ASSERT NOT (`s 218(c) the agreement may provide how the shares held by the parties are voted` TRUE FALSE TRUE)
#ASSERT NOT (`s 218(c) the agreement may provide how the shares held by the parties are voted` TRUE TRUE FALSE)
#ASSERT `s 218(d) this section invalidates the voting or other agreement among stockholders or the irrevocable proxy` FALSE EQUALS JUST FALSE
#ASSERT `s 218(d) this section invalidates the voting or other agreement among stockholders or the irrevocable proxy` TRUE EQUALS NOTHING
