-- s 382(a), transacting business without qualifying: a corporation from another State, not qualified, transacts business, sued in a Delaware court on that business.
#ASSERT `Is the Secretary of State my foreign corporation's agent for the acceptance of legal process in this action` `another jurisdiction of the United States` FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE
-- A qualified corporation is not within this limb.
#ASSERT NOT (`Is the Secretary of State my foreign corporation's agent for the acceptance of legal process in this action` `another jurisdiction of the United States` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE)
-- A corporation of this State is not foreign.
#ASSERT NOT (`Is the Secretary of State my foreign corporation's agent for the acceptance of legal process in this action` `this State` FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE)
-- The action does not grow out of the business transacted in Delaware.
#ASSERT NOT (`Is the Secretary of State my foreign corporation's agent for the acceptance of legal process in this action` `another jurisdiction of the United States` FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE)
-- Not a civil action in a Delaware state or federal court.
#ASSERT NOT (`Is the Secretary of State my foreign corporation's agent for the acceptance of legal process in this action` `another jurisdiction of the United States` FALSE TRUE FALSE TRUE FALSE FALSE FALSE FALSE)
-- It does not transact business here.
#ASSERT NOT (`Is the Secretary of State my foreign corporation's agent for the acceptance of legal process in this action` `another jurisdiction of the United States` FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE)
-- An insurance company is outside the section.
#ASSERT NOT (`Is the Secretary of State my foreign corporation's agent for the acceptance of legal process in this action` `another jurisdiction of the United States` FALSE TRUE TRUE TRUE FALSE FALSE FALSE TRUE)
-- s 382(a), consent in writing, the agreement providing no manner of service.
#ASSERT `Is the Secretary of State my foreign corporation's agent for the acceptance of legal process in this action` `a foreign jurisdiction outside the United States` FALSE FALSE FALSE FALSE TRUE TRUE TRUE FALSE
-- Qualification does not matter on the consent limb.
#ASSERT `Is the Secretary of State my foreign corporation's agent for the acceptance of legal process in this action` `another jurisdiction of the United States` TRUE FALSE FALSE FALSE TRUE TRUE TRUE FALSE
-- The agreement provides a manner of service.
#ASSERT NOT (`Is the Secretary of State my foreign corporation's agent for the acceptance of legal process in this action` `a foreign jurisdiction outside the United States` FALSE FALSE FALSE FALSE TRUE TRUE FALSE FALSE)
-- The action is on some other matter.
#ASSERT NOT (`Is the Secretary of State my foreign corporation's agent for the acceptance of legal process in this action` `a foreign jurisdiction outside the United States` FALSE FALSE FALSE FALSE TRUE FALSE TRUE FALSE)
-- No consent in writing.
#ASSERT NOT (`Is the Secretary of State my foreign corporation's agent for the acceptance of legal process in this action` `a foreign jurisdiction outside the United States` FALSE FALSE FALSE FALSE FALSE TRUE TRUE FALSE)
-- An insurance company is outside the section even on the consent limb.
#ASSERT NOT (`Is the Secretary of State my foreign corporation's agent for the acceptance of legal process in this action` `a foreign jurisdiction outside the United States` FALSE FALSE FALSE FALSE TRUE TRUE TRUE TRUE)
#ASSERT `Does process served on the Secretary of State have the same force as personal service on an officer or agent in Delaware` TRUE
#ASSERT NOT (`Does process served on the Secretary of State have the same force as personal service on an officer or agent in Delaware` FALSE)
#ASSERT `Was process served on the Secretary of State by electronic transmission in the way s 382(a) allows` FALSE FALSE
#ASSERT `Was process served on the Secretary of State by electronic transmission in the way s 382(a) allows` TRUE TRUE
#ASSERT NOT (`Was process served on the Secretary of State by electronic transmission in the way s 382(a) allows` TRUE FALSE)
