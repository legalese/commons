#ASSERT `Does my foreign corporation "transact business" in Delaware within the meaning of s 382, including by soliciting orders` TRUE
#ASSERT NOT (`Does my foreign corporation "transact business" in Delaware within the meaning of s 382, including by soliciting orders` FALSE)
#ASSERT NOT (`Does an exception in s 373 stop my foreign corporation from transacting business within the meaning of s 382` TRUE)
#ASSERT NOT (`Does an exception in s 373 stop my foreign corporation from transacting business within the meaning of s 382` FALSE)

-- s 383(a). Required to qualify, did business without authority, not since authorized and paid up.
#ASSERT `Is my foreign corporation barred from maintaining an action or special proceeding in Delaware` TRUE TRUE FALSE FALSE FALSE
-- Authorized since but has not paid the fees, penalties and franchise taxes.
#ASSERT `Is my foreign corporation barred from maintaining an action or special proceeding in Delaware` TRUE TRUE TRUE FALSE FALSE
-- Has paid but is not authorized.
#ASSERT `Is my foreign corporation barred from maintaining an action or special proceeding in Delaware` TRUE TRUE FALSE TRUE FALSE
-- Authorized and paid.
#ASSERT NOT (`Is my foreign corporation barred from maintaining an action or special proceeding in Delaware` TRUE TRUE TRUE TRUE FALSE)
-- A successor in interest is not barred.
#ASSERT NOT (`Is my foreign corporation barred from maintaining an action or special proceeding in Delaware` TRUE TRUE FALSE FALSE TRUE)
-- Not required to comply with ss 371 and 372.
#ASSERT NOT (`Is my foreign corporation barred from maintaining an action or special proceeding in Delaware` FALSE TRUE FALSE FALSE FALSE)
-- Did no business without authority.
#ASSERT NOT (`Is my foreign corporation barred from maintaining an action or special proceeding in Delaware` TRUE FALSE FALSE FALSE FALSE)
-- s 383(b). The failure to obtain authority does not impair validity, the other party's right to sue, or the right to defend.
#ASSERT `Does my foreign corporation's failure to obtain authority to do business impair this` TRUE `the validity of its contracts and acts, under s 383(b)` EQUALS JUST FALSE
#ASSERT `Does my foreign corporation's failure to obtain authority to do business impair this` TRUE `the other party's right to sue on its contract, under s 383(b)` EQUALS JUST FALSE
#ASSERT `Does my foreign corporation's failure to obtain authority to do business impair this` TRUE `its right to defend an action or special proceeding in Delaware, under s 383(b)` EQUALS JUST FALSE
-- There was no failure to obtain authority: the subsection says nothing.
#ASSERT `Does my foreign corporation's failure to obtain authority to do business impair this` FALSE `the validity of its contracts and acts, under s 383(b)` EQUALS NOTHING
#ASSERT `Does my foreign corporation's failure to obtain authority to do business impair this` FALSE `its right to defend an action or special proceeding in Delaware, under s 383(b)` EQUALS NOTHING

