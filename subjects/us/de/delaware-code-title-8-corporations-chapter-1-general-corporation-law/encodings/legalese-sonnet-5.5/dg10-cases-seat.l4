#ASSERT `Does our stock certificate have to note management by the stockholders, and does it` TRUE TRUE
#ASSERT NOT (`Does our stock certificate have to note management by the stockholders, and does it` TRUE FALSE)
-- No provision for management by the stockholders, so nothing needs noting.
