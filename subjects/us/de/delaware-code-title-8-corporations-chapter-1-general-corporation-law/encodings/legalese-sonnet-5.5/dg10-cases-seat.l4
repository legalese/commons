#ASSERT NOT (`Can the Court of Chancery enjoin or set aside a transfer of the close corporation's stock` FALSE TRUE)
#ASSERT NOT (`Can the Court of Chancery enjoin or set aside a transfer of the close corporation's stock` TRUE FALSE)
