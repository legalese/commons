#ASSERT `Is the registered agent we chose one that the Law allows for a foreign corporation` FALSE `a general partnership` FALSE
#ASSERT `Is the registered agent we chose one that the Law allows for a foreign corporation` FALSE `a limited partnership` FALSE
#ASSERT `Is the registered agent we chose one that the Law allows for a foreign corporation` FALSE `a limited liability partnership` FALSE
#ASSERT `Is the registered agent we chose one that the Law allows for a foreign corporation` FALSE `a limited liability limited partnership` FALSE
#ASSERT `Is the registered agent we chose one that the Law allows for a foreign corporation` FALSE `a limited liability company` FALSE
#ASSERT `Is the registered agent we chose one that the Law allows for a foreign corporation` FALSE `a statutory trust` FALSE
-- Kinds the list does not name.
