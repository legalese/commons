-- s 378. Doing business for a foreign corporation that has not complied.
#ASSERT `Is doing business in Delaware for a foreign corporation that has not complied an offense` TRUE TRUE
#ASSERT NOT (`Is doing business in Delaware for a foreign corporation that has not complied an offense` TRUE FALSE)
#ASSERT NOT (`Is doing business in Delaware for a foreign corporation that has not complied an offense` FALSE TRUE)
-- The fine for the corporation is $200 to $500 for each offense.
#ASSERT (`What is the least and the most I can be fined for each offense under s 378` `a foreign corporation doing business in this State without having complied, under s 378`)'s `the lowest fine for each offense under s 378` EQUALS 200
#ASSERT (`What is the least and the most I can be fined for each offense under s 378` `a foreign corporation doing business in this State without having complied, under s 378`)'s `the highest fine for each offense under s 378` EQUALS 500
-- An agent: $100 to $500.
#ASSERT (`What is the least and the most I can be fined for each offense under s 378` `an agent of a foreign corporation doing business for it before it has complied, under s 378`)'s `the lowest fine for each offense under s 378` EQUALS 100
#ASSERT (`What is the least and the most I can be fined for each offense under s 378` `an agent of a foreign corporation doing business for it before it has complied, under s 378`)'s `the highest fine for each offense under s 378` EQUALS 500
#ASSERT `Is this fine within the range s 378 allows for each offense` `a foreign corporation doing business in this State without having complied, under s 378` 200
#ASSERT `Is this fine within the range s 378 allows for each offense` `a foreign corporation doing business in this State without having complied, under s 378` 500
#ASSERT NOT (`Is this fine within the range s 378 allows for each offense` `a foreign corporation doing business in this State without having complied, under s 378` 199)
#ASSERT NOT (`Is this fine within the range s 378 allows for each offense` `a foreign corporation doing business in this State without having complied, under s 378` 501)
#ASSERT `Is this fine within the range s 378 allows for each offense` `an agent of a foreign corporation doing business for it before it has complied, under s 378` 100
#ASSERT `Is this fine within the range s 378 allows for each offense` `an agent of a foreign corporation doing business for it before it has complied, under s 378` 500
#ASSERT NOT (`Is this fine within the range s 378 allows for each offense` `an agent of a foreign corporation doing business for it before it has complied, under s 378` 99)
#ASSERT NOT (`Is this fine within the range s 378 allows for each offense` `an agent of a foreign corporation doing business for it before it has complied, under s 378` 501)

-- s 379(a). Discounting, deposits, bills of exchange and bills issued as money: no such power by implication.
#ASSERT `Is my foreign corporation deemed to have this banking power within Delaware, by implication or construction` `discounting bills, notes or other evidence of debt, under s 379(a)` FALSE EQUALS JUST FALSE
#ASSERT `Is my foreign corporation deemed to have this banking power within Delaware, by implication or construction` `receiving deposits, under s 379(a)` FALSE EQUALS JUST FALSE
#ASSERT `Is my foreign corporation deemed to have this banking power within Delaware, by implication or construction` `buying and selling bills of exchange, under s 379(a)` FALSE EQUALS JUST FALSE
#ASSERT `Is my foreign corporation deemed to have this banking power within Delaware, by implication or construction` `issuing bills, notes or other evidences of debt upon loan for circulation as money, under s 379(a)` FALSE EQUALS JUST FALSE
-- Where Title 5 provides otherwise, the subsection does not answer.
#ASSERT `Is my foreign corporation deemed to have this banking power within Delaware, by implication or construction` `receiving deposits, under s 379(a)` TRUE EQUALS NOTHING
-- A power the subsection does not list.
#ASSERT `Is my foreign corporation deemed to have this banking power within Delaware, by implication or construction` `a power that s 379(a) does not list` FALSE EQUALS NOTHING
#ASSERT `Does the Secretary of State's certificate of filing for my foreign corporation set out the banking limitations as s 379(b) requires` TRUE
#ASSERT NOT (`Does the Secretary of State's certificate of filing for my foreign corporation set out the banking limitations as s 379(b) requires` FALSE)
