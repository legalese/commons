§§ `My public benefit corporation (s 361 to s 368)`

-- s 361
#ASSERT `Does the public benefit corporation subchapter apply to my corporation` TRUE
#ASSERT NOT (`Does the public benefit corporation subchapter apply to my corporation` FALSE)
-- A public benefit corporation: the subchapter's additional or different requirement applies in place of the chapter's.
#ASSERT `On this point, does the public benefit corporation subchapter's requirement apply in place of the General Corporation Law's` TRUE TRUE EQUALS JUST TRUE
#ASSERT `On this point, does the public benefit corporation subchapter's requirement apply in place of the General Corporation Law's` TRUE FALSE EQUALS JUST FALSE
#ASSERT `On this point, does the public benefit corporation subchapter's requirement apply in place of the General Corporation Law's` FALSE TRUE EQUALS NOTHING

-- s 362(a). For-profit, organized under the Law, intended to produce a public benefit and to operate responsibly and sustainably.
#ASSERT `Is my corporation a public benefit corporation` TRUE TRUE TRUE
#ASSERT NOT (`Is my corporation a public benefit corporation` FALSE TRUE TRUE)
#ASSERT NOT (`Is my corporation a public benefit corporation` TRUE FALSE TRUE)
#ASSERT NOT (`Is my corporation a public benefit corporation` TRUE TRUE FALSE)
-- s 362(a)(1) and (2). One specific public benefit in the statement of purpose, and the heading.
#ASSERT `Does our certificate of incorporation say what a public benefit corporation's certificate must say` 1 TRUE
#ASSERT `Does our certificate of incorporation say what a public benefit corporation's certificate must say` 3 TRUE
#ASSERT NOT (`Does our certificate of incorporation say what a public benefit corporation's certificate must say` 0 TRUE)
#ASSERT NOT (`Does our certificate of incorporation say what a public benefit corporation's certificate must say` 1 FALSE)
-- s 365(a) and s 362(a). The board balances all three interests.
#ASSERT `Does the board manage in the way a public benefit corporation must be managed, balancing the three interests` TRUE TRUE TRUE
#ASSERT NOT (`Does the board manage in the way a public benefit corporation must be managed, balancing the three interests` FALSE TRUE TRUE)
#ASSERT NOT (`Does the board manage in the way a public benefit corporation must be managed, balancing the three interests` TRUE FALSE TRUE)
#ASSERT NOT (`Does the board manage in the way a public benefit corporation must be managed, balancing the three interests` TRUE TRUE FALSE)
-- s 362(b). A positive effect on persons other than stockholders as stockholders.
#ASSERT `Is this effect a "public benefit" for the purposes of the Law` TRUE TRUE
#ASSERT NOT (`Is this effect a "public benefit" for the purposes of the Law` TRUE FALSE)
#ASSERT NOT (`Is this effect a "public benefit" for the purposes of the Law` FALSE TRUE)
-- s 362(c). Any one of the three designations in the name.
#ASSERT `Does our corporation's name satisfy the name requirement of section 102(a)(1)(i) by carrying a public benefit corporation designation` TRUE FALSE FALSE
#ASSERT `Does our corporation's name satisfy the name requirement of section 102(a)(1)(i) by carrying a public benefit corporation designation` FALSE TRUE FALSE
#ASSERT `Does our corporation's name satisfy the name requirement of section 102(a)(1)(i) by carrying a public benefit corporation designation` FALSE FALSE TRUE
#ASSERT NOT (`Does our corporation's name satisfy the name requirement of section 102(a)(1)(i) by carrying a public benefit corporation designation` FALSE FALSE FALSE)
-- Issuing unissued shares, the name carries no designation, no registered offering, no 1934 Act class: notice is owed.
#ASSERT `Must our public benefit corporation give notice that it is one before issuing or disposing of stock` TRUE FALSE FALSE FALSE
#ASSERT NOT (`Must our public benefit corporation give notice that it is one before issuing or disposing of stock` TRUE TRUE FALSE FALSE)
#ASSERT NOT (`Must our public benefit corporation give notice that it is one before issuing or disposing of stock` TRUE FALSE TRUE FALSE)
#ASSERT NOT (`Must our public benefit corporation give notice that it is one before issuing or disposing of stock` TRUE FALSE FALSE TRUE)
#ASSERT NOT (`Must our public benefit corporation give notice that it is one before issuing or disposing of stock` FALSE FALSE FALSE FALSE)
-- The same from the acquirer's seat.
#ASSERT `Am I entitled to be told that the corporation is a public benefit corporation when I acquire its stock` TRUE FALSE FALSE FALSE
#ASSERT NOT (`Am I entitled to be told that the corporation is a public benefit corporation when I acquire its stock` TRUE TRUE FALSE FALSE)
#ASSERT NOT (`Am I entitled to be told that the corporation is a public benefit corporation when I acquire its stock` TRUE FALSE TRUE FALSE)
#ASSERT NOT (`Am I entitled to be told that the corporation is a public benefit corporation when I acquire its stock` TRUE FALSE FALSE TRUE)
#ASSERT NOT (`Am I entitled to be told that the corporation is a public benefit corporation when I acquire its stock` FALSE FALSE FALSE FALSE)

-- s 363. A nonprofit nonstock corporation that would merge with a public benefit corporation may not.
#ASSERT `Can my nonprofit nonstock corporation be a constituent corporation to a merger or consolidation with a public benefit corporation` `a nonprofit nonstock corporation that is not charitable` TRUE FALSE EQUALS JUST FALSE
-- ... or into a survivor whose certificate adds a s 362(a)(1) provision.
#ASSERT `Can my nonprofit nonstock corporation be a constituent corporation to a merger or consolidation with a public benefit corporation` `a nonprofit nonstock corporation that is not charitable` FALSE TRUE EQUALS JUST FALSE
-- A charitable nonstock corporation is a nonprofit nonstock corporation.
#ASSERT `Can my nonprofit nonstock corporation be a constituent corporation to a merger or consolidation with a public benefit corporation` `a charitable nonstock corporation` TRUE FALSE EQUALS JUST FALSE
-- No such merger: the section does not answer.
#ASSERT `Can my nonprofit nonstock corporation be a constituent corporation to a merger or consolidation with a public benefit corporation` `a nonprofit nonstock corporation that is not charitable` FALSE FALSE EQUALS NOTHING
