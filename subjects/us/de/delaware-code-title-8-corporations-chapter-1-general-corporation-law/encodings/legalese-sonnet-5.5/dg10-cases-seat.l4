#ASSERT NOT (`Can the Court of Chancery enjoin a public offering, or threatened public offering, of the close corporation's stock` FALSE TRUE)
#ASSERT NOT (`Can the Court of Chancery enjoin a public offering, or threatened public offering, of the close corporation's stock` TRUE FALSE)

-- s 349. Judgment final on 1 June 2027: 30 days after is 1 July 2027.
#ASSERT `By what date may my close corporation exercise its option to acquire a security whose transfer restriction was struck down` (YMD 2027 6 1) EQUALS (YMD 2027 7 1)
#ASSERT `Can my close corporation still exercise its option to acquire the security on this date` TRUE (YMD 2027 6 1) (YMD 2027 7 1)
#ASSERT NOT (`Can my close corporation still exercise its option to acquire the security on this date` TRUE (YMD 2027 6 1) (YMD 2027 7 2))
-- Before the judgment became final the option has not arisen.
#ASSERT NOT (`Can my close corporation still exercise its option to acquire the security on this date` TRUE (YMD 2027 6 1) (YMD 2027 5 31))
-- The restriction was not held unauthorized.
#ASSERT NOT (`Can my close corporation still exercise its option to acquire the security on this date` FALSE (YMD 2027 6 1) (YMD 2027 6 15))
-- Price: agreed 1000, no fair value set.
#ASSERT `At what price may my close corporation acquire the security whose restriction was struck down` TRUE 1000 FALSE 0 EQUALS JUST 1000
-- No agreement, the Court fixed 1200.
#ASSERT `At what price may my close corporation acquire the security whose restriction was struck down` FALSE 0 TRUE 1200 EQUALS JUST 1200
-- An agreed price is used even if the Court has also determined a fair value.
#ASSERT `At what price may my close corporation acquire the security whose restriction was struck down` TRUE 1000 TRUE 1200 EQUALS JUST 1000
-- Neither: the text gives no price yet.
#ASSERT `At what price may my close corporation acquire the security whose restriction was struck down` FALSE 0 FALSE 0 EQUALS NOTHING

-- s 350. We hold 51 of 100 votes and the agreement is a written stockholders' agreement of a close corporation.
#ASSERT `Is our written agreement as stockholders, which restricts the discretion of the board, invalid as between us on that ground` TRUE 51 100 EQUALS JUST FALSE
-- Exactly half is not a majority.
#ASSERT `Is our written agreement as stockholders, which restricts the discretion of the board, invalid as between us on that ground` TRUE 50 100 EQUALS NOTHING
#ASSERT `Is our written agreement as stockholders, which restricts the discretion of the board, invalid as between us on that ground` FALSE 51 100 EQUALS NOTHING
-- The effect: directors relieved and parties liable, to the extent the agreement controls the board.
#ASSERT `If our stockholders' agreement controls the board, are the directors relieved and are we, as parties, liable for managerial acts or omissions instead` TRUE 51 100 TRUE EQUALS JUST TRUE
-- Where the board's discretion is not controlled by the agreement the sentence prescribes no effect: the text is silent.
#ASSERT `If our stockholders' agreement controls the board, are the directors relieved and are we, as parties, liable for managerial acts or omissions instead` TRUE 51 100 FALSE EQUALS NOTHING
#ASSERT `If our stockholders' agreement controls the board, are the directors relieved and are we, as parties, liable for managerial acts or omissions instead` TRUE 50 100 TRUE EQUALS NOTHING

-- s 351. The certificate provides that stockholders manage: no meeting need be called to elect directors.
#ASSERT `Must a meeting of stockholders be called to elect directors when our stockholders manage the corporation` TRUE EQUALS JUST FALSE
#ASSERT `Must a meeting of stockholders be called to elect directors when our stockholders manage the corporation` FALSE EQUALS NOTHING
-- Stockholders are deemed directors unless the context clearly requires otherwise.
#ASSERT `Am I, as a stockholder, treated as a director for the purposes of the Law` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Am I, as a stockholder, treated as a director for the purposes of the Law` TRUE TRUE EQUALS JUST FALSE
#ASSERT `Am I, as a stockholder, treated as a director for the purposes of the Law` FALSE FALSE EQUALS NOTHING

