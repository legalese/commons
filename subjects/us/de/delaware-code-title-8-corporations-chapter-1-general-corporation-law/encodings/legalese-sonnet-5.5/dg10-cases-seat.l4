#ASSERT NOT (`Can I (or the corporation) ask the Court of Chancery for orders to prevent the loss of close corporation status` FALSE TRUE FALSE)
#ASSERT NOT (`Can I (or the corporation) ask the Court of Chancery for orders to prevent the loss of close corporation status` TRUE FALSE FALSE)
