#ASSERT `Does the public benefit corporation subchapter affect a law that applies to my corporation, which is not a public benefit corporation` FALSE FALSE EQUALS JUST FALSE
#ASSERT `Does the public benefit corporation subchapter affect a law that applies to my corporation, which is not a public benefit corporation` TRUE TRUE EQUALS NOTHING

