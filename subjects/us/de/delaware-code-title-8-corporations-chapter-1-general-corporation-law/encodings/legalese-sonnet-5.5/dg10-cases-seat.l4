#ASSERT NOT (`Has my foreign corporation paid and filed what it needs to do business in Delaware` 80 (YMD 2027 8 31) (YMD 2027 2 27) TRUE TRUE FALSE FALSE TRUE TRUE TRUE (YMD 2027 2 28) TRUE TRUE TRUE)
