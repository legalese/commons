#ASSERT NOT (`Is my close corporation in a position for the Court of Chancery to appoint a provisional director` TRUE FALSE TRUE)
#ASSERT NOT (`Is my close corporation in a position for the Court of Chancery to appoint a provisional director` TRUE TRUE FALSE)

-- s 353(b)(1). 3 of 6 directors join: exactly one half.
#ASSERT `May our group apply to the Court of Chancery for a provisional director` 3 6 0 100 FALSE 0 0 FALSE 0 FALSE 0 FALSE 0 EQUALS JUST TRUE
