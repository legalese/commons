#ASSERT `As a provisional director, do I have the rights and powers of a duly elected director, including notice of and a vote at board meetings` TRUE TRUE EQUALS JUST FALSE
#ASSERT `As a provisional director, do I have the rights and powers of a duly elected director, including notice of and a vote at board meetings` FALSE FALSE EQUALS NOTHING
