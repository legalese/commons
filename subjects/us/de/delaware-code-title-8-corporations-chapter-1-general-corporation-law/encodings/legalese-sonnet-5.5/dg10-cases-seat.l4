#ASSERT `As a director of a public benefit corporation, do I owe a duty to the people the public benefit reaches, by virtue of the public benefit provisions` FALSE TRUE EQUALS JUST FALSE
#ASSERT `As a director of a public benefit corporation, do I owe a duty to the people the public benefit reaches, by virtue of the public benefit provisions` TRUE TRUE EQUALS JUST FALSE
-- Some other ground of duty: the subsection says nothing.
#ASSERT `As a director of a public benefit corporation, do I owe a duty to the people the public benefit reaches, by virtue of the public benefit provisions` FALSE FALSE EQUALS NOTHING
-- Informed and disinterested, and a person of ordinary, sound judgment might approve: deemed satisfied.
#ASSERT `As a director of a public benefit corporation, am I deemed to have satisfied my fiduciary duties on this decision` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
-- No person of ordinary, sound judgment would approve: the safe harbour does not apply and the text says no more.
#ASSERT `As a director of a public benefit corporation, am I deemed to have satisfied my fiduciary duties on this decision` TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `As a director of a public benefit corporation, am I deemed to have satisfied my fiduciary duties on this decision` TRUE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `As a director of a public benefit corporation, am I deemed to have satisfied my fiduciary duties on this decision` TRUE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `As a director of a public benefit corporation, am I deemed to have satisfied my fiduciary duties on this decision` FALSE TRUE TRUE FALSE EQUALS NOTHING
-- s 365(c). Stock ownership alone creates no conflict, except where it would have if the corporation were not a public benefit corporation.
#ASSERT `Does my stock ownership create a conflict of interest on the balancing decision of a public benefit corporation` TRUE
#ASSERT NOT (`Does my stock ownership create a conflict of interest on the balancing decision of a public benefit corporation` FALSE)
-- No conflict and the certificate does not so provide: not bad faith or disloyalty for ss 102(b)(7) and 145.
#ASSERT `Is a failure to satisfy the balancing requirement a lack of good faith or a breach of loyalty for sections 102(b)(7) and 145` FALSE FALSE EQUALS JUST FALSE
#ASSERT `Is a failure to satisfy the balancing requirement a lack of good faith or a breach of loyalty for sections 102(b)(7) and 145` TRUE FALSE EQUALS NOTHING
#ASSERT `Is a failure to satisfy the balancing requirement a lack of good faith or a breach of loyalty for sections 102(b)(7) and 145` FALSE TRUE EQUALS NOTHING
#ASSERT `Is a failure to satisfy the balancing requirement a lack of good faith or a breach of loyalty for sections 102(b)(7) and 145` TRUE TRUE EQUALS NOTHING

-- s 366(a)
#ASSERT `Does the notice of the stockholders' meeting include the statement that we are a public benefit corporation` TRUE
#ASSERT NOT (`Does the notice of the stockholders' meeting include the statement that we are a public benefit corporation` FALSE)
-- s 366(b). At least every 24 months; a provision of the certificate or bylaws may require more often.
#ASSERT `How many months may pass between our statements to the stockholders on the public benefit` `in the certificate of incorporation` 12 EQUALS 12
#ASSERT `How many months may pass between our statements to the stockholders on the public benefit` `in the bylaws` 6 EQUALS 6
-- A provision cannot stretch the interval beyond biennially.
#ASSERT `How many months may pass between our statements to the stockholders on the public benefit` `in the certificate of incorporation` 30 EQUALS 24
-- A board resolution or no provision at all leaves the 24 months.
#ASSERT `How many months may pass between our statements to the stockholders on the public benefit` `in a resolution of the board of directors` 6 EQUALS 24
#ASSERT `How many months may pass between our statements to the stockholders on the public benefit` `in none of these` 6 EQUALS 24
-- Last statement on 1 March 2027, every 24 months: by 1 March 2029.
#ASSERT `By what date must we give the stockholders the next statement on the public benefit` TRUE (YMD 2027 3 1) 24 EQUALS JUST (YMD 2029 3 1)
#ASSERT `By what date must we give the stockholders the next statement on the public benefit` TRUE (YMD 2027 3 1) 12 EQUALS JUST (YMD 2028 3 1)
-- Last statement on 29 February 2028, 24 months on: 2030 has no 29 February, so 28 February (the core's month clamp).
#ASSERT `By what date must we give the stockholders the next statement on the public benefit` TRUE (YMD 2028 2 29) 24 EQUALS JUST (YMD 2030 2 28)
-- No statement has been given yet: the text gives no first date.
#ASSERT `By what date must we give the stockholders the next statement on the public benefit` FALSE (YMD 2027 3 1) 24 EQUALS NOTHING
#ASSERT `Did we give the stockholders the next statement on the public benefit in time` TRUE (YMD 2027 3 1) 24 (YMD 2029 3 1) EQUALS JUST TRUE
#ASSERT `Did we give the stockholders the next statement on the public benefit in time` TRUE (YMD 2027 3 1) 24 (YMD 2029 3 2) EQUALS JUST FALSE
#ASSERT `Did we give the stockholders the next statement on the public benefit in time` FALSE (YMD 2027 3 1) 24 (YMD 2029 3 1) EQUALS NOTHING
-- s 366(b)(1) to (4)
#ASSERT `Does our statement to the stockholders include everything the Law requires` TRUE TRUE TRUE TRUE
#ASSERT NOT (`Does our statement to the stockholders include everything the Law requires` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`Does our statement to the stockholders include everything the Law requires` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`Does our statement to the stockholders include everything the Law requires` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`Does our statement to the stockholders include everything the Law requires` TRUE TRUE TRUE FALSE)
-- s 366(c)(2) and (3). Only the certificate or the bylaws can impose these.
#ASSERT `Must our public benefit corporation make its statement available to the public` `in the certificate of incorporation`
#ASSERT `Must our public benefit corporation make its statement available to the public` `in the bylaws`
#ASSERT NOT (`Must our public benefit corporation make its statement available to the public` `in a resolution of the board of directors`)
#ASSERT NOT (`Must our public benefit corporation make its statement available to the public` `in none of these`)
#ASSERT `Must our public benefit corporation use a third-party standard or attain a periodic third-party certification` `in the certificate of incorporation`
#ASSERT `Must our public benefit corporation use a third-party standard or attain a periodic third-party certification` `in the bylaws`
#ASSERT NOT (`Must our public benefit corporation use a third-party standard or attain a periodic third-party certification` `in a resolution of the board of directors`)
#ASSERT NOT (`Must our public benefit corporation use a third-party standard or attain a periodic third-party certification` `in none of these`)

-- s 367. 2 of 100 shares is exactly 2 percent.
#ASSERT `Do my fellow plaintiffs and I own enough shares to sue to enforce the balancing requirement` 2 100 FALSE 0 EQUALS JUST TRUE
#ASSERT `Do my fellow plaintiffs and I own enough shares to sue to enforce the balancing requirement` 1 100 FALSE 0 EQUALS JUST FALSE
#ASSERT `Do my fellow plaintiffs and I own enough shares to sue to enforce the balancing requirement` 20 1000 FALSE 0 EQUALS JUST TRUE
#ASSERT `Do my fellow plaintiffs and I own enough shares to sue to enforce the balancing requirement` 19 1000 FALSE 0 EQUALS JUST FALSE
-- Listed shares: market value of $2,000,000 is enough though under 2 percent.
#ASSERT `Do my fellow plaintiffs and I own enough shares to sue to enforce the balancing requirement` 1 100 TRUE 2000000 EQUALS JUST TRUE
#ASSERT `Do my fellow plaintiffs and I own enough shares to sue to enforce the balancing requirement` 1 100 TRUE 1999999 EQUALS JUST FALSE
-- An unlisted corporation's shares do not qualify by value.
#ASSERT `Do my fellow plaintiffs and I own enough shares to sue to enforce the balancing requirement` 1 100 FALSE 5000000 EQUALS JUST FALSE
-- No outstanding shares: no percentage to test.
#ASSERT `Do my fellow plaintiffs and I own enough shares to sue to enforce the balancing requirement` 0 0 FALSE 0 EQUALS NOTHING
-- Enough shares, a derivative action, the s 327 averment made, rules complied with.
#ASSERT `May my fellow plaintiffs and I bring the action to enforce the balancing requirement` 2 100 FALSE 0 TRUE TRUE TRUE EQUALS JUST TRUE
-- A derivative action without the s 327 averment.
#ASSERT `May my fellow plaintiffs and I bring the action to enforce the balancing requirement` 2 100 FALSE 0 TRUE FALSE TRUE EQUALS JUST FALSE
-- Not a derivative action: s 327 does not apply.
#ASSERT `May my fellow plaintiffs and I bring the action to enforce the balancing requirement` 2 100 FALSE 0 FALSE FALSE TRUE EQUALS JUST TRUE
-- The court's rules are not complied with.
#ASSERT `May my fellow plaintiffs and I bring the action to enforce the balancing requirement` 2 100 FALSE 0 FALSE FALSE FALSE EQUALS JUST FALSE
-- Not enough shares.
#ASSERT `May my fellow plaintiffs and I bring the action to enforce the balancing requirement` 1 100 FALSE 0 TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `May my fellow plaintiffs and I bring the action to enforce the balancing requirement` 0 0 FALSE 0 TRUE TRUE TRUE EQUALS NOTHING

