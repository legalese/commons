#ASSERT NOT (`May my out-of-state corporation act in Delaware as executor, guardian, trustee or other fiduciary` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`May my out-of-state corporation act in Delaware as executor, guardian, trustee or other fiduciary` TRUE TRUE TRUE FALSE)

