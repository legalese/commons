#ASSERT `May our group apply to the Court of Chancery for a provisional director` 2 6 34 100 FALSE 0 0 FALSE 0 FALSE 0 FALSE 0 EQUALS JUST TRUE
-- 2 of 6 directors, 33 of 100 shares, one class only: neither limb.
#ASSERT `May our group apply to the Court of Chancery for a provisional director` 2 6 33 100 FALSE 0 0 FALSE 0 FALSE 0 FALSE 0 EQUALS JUST FALSE
-- More than one class entitled to elect directors; we hold 67 of 100 of one class: two thirds (s 353(b)(3)).
#ASSERT `May our group apply to the Court of Chancery for a provisional director` 1 6 10 100 TRUE 67 100 FALSE 0 FALSE 0 FALSE 0 EQUALS JUST TRUE
#ASSERT `May our group apply to the Court of Chancery for a provisional director` 1 6 10 100 TRUE 66 100 FALSE 0 FALSE 0 FALSE 0 EQUALS JUST FALSE
-- The certificate allows a lesser proportion of the directors, 25 percent: 2 of 6 will do.
#ASSERT `May our group apply to the Court of Chancery for a provisional director` 2 6 0 100 FALSE 0 0 TRUE 25 FALSE 0 FALSE 0 EQUALS JUST TRUE
-- 1 of 6 is under 25 percent.
#ASSERT `May our group apply to the Court of Chancery for a provisional director` 1 6 0 100 FALSE 0 0 TRUE 25 FALSE 0 FALSE 0 EQUALS JUST FALSE
-- A certificate may only lessen the proportion: 75 percent does not raise one half.
#ASSERT `May our group apply to the Court of Chancery for a provisional director` 3 6 0 100 FALSE 0 0 TRUE 75 FALSE 0 FALSE 0 EQUALS JUST TRUE
-- A lesser proportion of the stockholders, 20 percent: 20 of 100 shares will do.
#ASSERT `May our group apply to the Court of Chancery for a provisional director` 1 6 20 100 FALSE 0 0 FALSE 0 TRUE 20 FALSE 0 EQUALS JUST TRUE
-- A lesser proportion of a class, 50 percent: 50 of 100 of one class, with 2 classes.
#ASSERT `May our group apply to the Court of Chancery for a provisional director` 1 6 10 100 TRUE 50 100 FALSE 0 FALSE 0 TRUE 50 EQUALS JUST TRUE
-- No directors in office and no shares entitled to elect directors: no proportion can be tested.
#ASSERT `May our group apply to the Court of Chancery for a provisional director` 0 0 0 0 FALSE 0 0 FALSE 0 FALSE 0 FALSE 0 EQUALS NOTHING
-- One limb met although the other has nothing to test.
#ASSERT `May our group apply to the Court of Chancery for a provisional director` 3 6 0 0 FALSE 0 0 FALSE 0 FALSE 0 FALSE 0 EQUALS JUST TRUE

