IMPORT prelude
IMPORT daydate
IMPORT `dg-core`
IMPORT `dg3-capital-dividends`

-- Tests of dg3-capital-dividends.l4 (sections 154 and 170 to 174).
-- Every expected value was decided by reading the section, then written beside the assertion; none is copied from the encoding's output.

§ `Section 154: capital, surplus and net assets`

GIVEN received IS A NUMBER
      parValue IS A NUMBER
      noParConsideration IS A NUMBER
      allPar IS A BOOLEAN
      forCash IS A BOOLEAN
      issued IS A DATE
      decision IS A MAYBE `s 154 A determination by the board of the part that is capital`
GIVETH A `s 154 Facts about the capital for shares issued`
`dg3 test capital facts` received parValue noParConsideration allPar forCash issued decision MEANS
    `s 154 Facts about the capital for shares issued` WITH
        `the consideration received for the shares` IS received
        `the aggregate par value of the shares having a par value` IS parValue
        `the consideration for the shares without par value` IS noParConsideration
        `all the shares issued for the consideration are shares having a par value` IS allPar
        `the shares were issued for cash` IS forCash
        `the day the shares were issued` IS issued
        `the determination of the board, if it made one` IS decision

GIVEN amount IS A NUMBER
      day IS A DATE
GIVETH A MAYBE `s 154 A determination by the board of the part that is capital`
`dg3 test decision` amount day MEANS
    JUST (`s 154 A determination by the board of the part that is capital` WITH
              `the amount in dollars the board determined to be capital` IS amount
              `the day the board determined it` IS day)

-- All the shares have a par value (aggregate 100) and were issued for cash on 1 March 2026 for 1,000. The board determined 500 on the day of issue.
#ASSERT `s 154 the capital in respect of the shares` (`dg3 test capital facts` 1000 100 0 TRUE TRUE (YMD 2026 3 1) (`dg3 test decision` 500 (YMD 2026 3 1))) EQUALS JUST 500
-- all par shares: the part need only equal the aggregate par value (100), not exceed it; 99 is not permitted
#ASSERT `s 154 the capital in respect of the shares` (`dg3 test capital facts` 1000 100 0 TRUE TRUE (YMD 2026 3 1) (`dg3 test decision` 100 (YMD 2026 3 1))) EQUALS JUST 100
#ASSERT `s 154 the capital in respect of the shares` (`dg3 test capital facts` 1000 100 0 TRUE TRUE (YMD 2026 3 1) (`dg3 test decision` 99 (YMD 2026 3 1))) EQUALS NOTHING
-- not all par shares (some have none): the part must be in excess of the aggregate par value of those that have one (100)
#ASSERT `s 154 the capital in respect of the shares` (`dg3 test capital facts` 1000 100 400 FALSE TRUE (YMD 2026 3 1) (`dg3 test decision` 100 (YMD 2026 3 1))) EQUALS NOTHING
#ASSERT `s 154 the capital in respect of the shares` (`dg3 test capital facts` 1000 100 400 FALSE TRUE (YMD 2026 3 1) (`dg3 test decision` 101 (YMD 2026 3 1))) EQUALS JUST 101
-- a part of the consideration: not more than the consideration received (1,000)
#ASSERT `s 154 the capital in respect of the shares` (`dg3 test capital facts` 1000 100 0 TRUE TRUE (YMD 2026 3 1) (`dg3 test decision` 1000 (YMD 2026 3 1))) EQUALS JUST 1000
#ASSERT `s 154 the capital in respect of the shares` (`dg3 test capital facts` 1000 100 0 TRUE TRUE (YMD 2026 3 1) (`dg3 test decision` 1001 (YMD 2026 3 1))) EQUALS NOTHING
-- for cash the determination must be made at the time of issue: a day late, the default applies (aggregate par 100 plus no-par consideration 0)
#ASSERT `s 154 the capital in respect of the shares` (`dg3 test capital facts` 1000 100 0 TRUE TRUE (YMD 2026 3 1) (`dg3 test decision` 500 (YMD 2026 3 2))) EQUALS JUST 100
-- for other consideration the board has 60 days after issue: 1 March plus 60 days is 30 April
#ASSERT `s 154 the capital in respect of the shares` (`dg3 test capital facts` 1000 100 0 TRUE FALSE (YMD 2026 3 1) (`dg3 test decision` 500 (YMD 2026 4 30))) EQUALS JUST 500
#ASSERT `s 154 the capital in respect of the shares` (`dg3 test capital facts` 1000 100 0 TRUE FALSE (YMD 2026 3 1) (`dg3 test decision` 500 (YMD 2026 5 1))) EQUALS JUST 100
-- no determination at all: the aggregate par value of the par shares (100) plus the consideration for shares without par value (400)
#ASSERT `s 154 the capital in respect of the shares` (`dg3 test capital facts` 1000 100 400 FALSE TRUE (YMD 2026 3 1) NOTHING) EQUALS JUST 500
-- the stated capital of shares without par value is the amount determined to be capital in respect of them
#ASSERT `s 154 the stated capital of the shares without par value` 400 EQUALS 400
-- increasing the capital by a transfer from the net assets: net assets 800, capital 500, so at most 300 may be transferred
#ASSERT `s 154 the capital after a transfer from the net assets` 500 800 300 EQUALS JUST 800
#ASSERT `s 154 the capital after a transfer from the net assets` 500 800 301 EQUALS NOTHING
#ASSERT `s 154 the capital after a transfer from the net assets` 500 800 0 EQUALS JUST 500
#ASSERT `s 154 the capital after a transfer from the net assets` 500 800 (0 MINUS 1) EQUALS NOTHING
#ASSERT `s 154 the capital after a transfer from the net assets` 500 500 1 EQUALS NOTHING
-- net assets are total assets less total liabilities
#ASSERT `s 154 the net assets of the corporation` 1000 400 EQUALS 600
-- surplus is the excess, if any, of net assets over capital
#ASSERT `s 154 the surplus of the corporation, if any` 600 500 EQUALS JUST 100
#ASSERT `s 154 the surplus of the corporation, if any` 500 500 EQUALS NOTHING
#ASSERT `s 154 the surplus of the corporation, if any` 400 500 EQUALS NOTHING
-- the capital of a nonstock corporation is deemed zero; a stock corporation keeps its capital
#ASSERT `s 154 the capital to use in sections 154, 160 and 170` `a stock corporation` 500 EQUALS 500
#ASSERT `s 154 the capital to use in sections 154, 160 and 170` `a nonstock corporation with membership interests` 500 EQUALS 0
#ASSERT `s 154 the capital to use in sections 154, 160 and 170` `a nonprofit nonstock corporation that is not charitable` 500 EQUALS 0
#ASSERT `s 154 the capital to use in sections 154, 160 and 170` `a charitable nonstock corporation` 500 EQUALS 0

§ `Section 170: dividends`

GIVEN allowed IS A BOOLEAN
      amount IS A NUMBER
      surplus IS A MAYBE NUMBER
      thisYear IS A NUMBER
      lastYear IS A NUMBER
      capital IS A NUMBER
      preferred IS A NUMBER
GIVETH A `s 170(a) Facts about a proposed dividend`
`dg3 test dividend` allowed amount surplus thisYear lastYear capital preferred MEANS
    `s 170(a) Facts about a proposed dividend` WITH
        `the restrictions in the certificate of incorporation allow the dividend` IS allowed
        `the amount of the dividend` IS amount
        `the surplus, if any, as defined in and computed in accordance with sections 154 and 244` IS surplus
        `the net profits for the fiscal year in which the dividend is declared` IS thisYear
        `the net profits for the preceding fiscal year` IS lastYear
        `the capital computed in accordance with sections 154 and 244` IS capital
        `the aggregate amount of the capital represented by the issued and outstanding stock of all classes having a preference upon the distribution of assets` IS preferred

-- out of surplus (100): a dividend of 100 is covered, 101 is not
#ASSERT `s 170(a)(1) the dividend can be paid out of surplus` (`dg3 test dividend` TRUE 100 (JUST 100) 0 0 500 500)
#ASSERT NOT (`s 170(a)(1) the dividend can be paid out of surplus` (`dg3 test dividend` TRUE 101 (JUST 100) 0 0 500 500))
#ASSERT NOT (`s 170(a)(1) the dividend can be paid out of surplus` (`dg3 test dividend` TRUE 1 NOTHING 100 100 500 500))
-- where there is surplus, net profits are not an alternative: (a)(2) is for the case where there is no such surplus
#ASSERT NOT (`s 170(a)(2) the dividend can be paid out of net profits` (`dg3 test dividend` TRUE 101 (JUST 100) 500 500 500 500))
-- no surplus: out of the net profits of this year and/or last year (30 and 20: up to 50)
#ASSERT `s 170(a)(2) the dividend can be paid out of net profits` (`dg3 test dividend` TRUE 50 NOTHING 30 20 500 500)
#ASSERT NOT (`s 170(a)(2) the dividend can be paid out of net profits` (`dg3 test dividend` TRUE 51 NOTHING 30 20 500 500))
#ASSERT `s 170(a)(2) the dividend can be paid out of net profits` (`dg3 test dividend` TRUE 30 NOTHING 30 0 500 500)
#ASSERT `s 170(a)(2) the dividend can be paid out of net profits` (`dg3 test dividend` TRUE 20 NOTHING 0 20 500 500)
-- capital diminished below the capital represented by the preferred stock (400 against 500): no dividend out of net profits until repaired; equal is not "less than"
#ASSERT NOT (`s 170(a)(2) the dividend can be paid out of net profits` (`dg3 test dividend` TRUE 50 NOTHING 30 20 400 500))
#ASSERT `s 170(a)(2) the dividend can be paid out of net profits` (`dg3 test dividend` TRUE 50 NOTHING 30 20 500 500)
-- the directors may declare and pay, subject to the certificate's restrictions
#ASSERT `s 170(a) the directors may declare and pay the dividend` (`dg3 test dividend` TRUE 100 (JUST 100) 0 0 500 500)
#ASSERT `s 170(a) the directors may declare and pay the dividend` (`dg3 test dividend` TRUE 50 NOTHING 30 20 500 500)
#ASSERT NOT (`s 170(a) the directors may declare and pay the dividend` (`dg3 test dividend` FALSE 100 (JUST 100) 0 0 500 500))
#ASSERT NOT (`s 170(a) the directors may declare and pay the dividend` (`dg3 test dividend` TRUE 101 (JUST 100) 500 500 500 500))
-- a note paid as a dividend remains valid if the corporation then had surplus or net profits from which the dividend could lawfully have been paid
#ASSERT `s 170(a) the note, debenture or obligation paid as a dividend remains valid` TRUE
#ASSERT NOT (`s 170(a) the note, debenture or obligation paid as a dividend remains valid` FALSE)
-- (b) wasting assets
#ASSERT `s 170(b) the directors may determine the net profits without taking depletion into consideration` TRUE FALSE
#ASSERT NOT (`s 170(b) the directors may determine the net profits without taking depletion into consideration` TRUE TRUE)
#ASSERT NOT (`s 170(b) the directors may determine the net profits without taking depletion into consideration` FALSE FALSE)

§ `Section 171: special purpose reserves`

#ASSERT `s 171 the directors may set apart a reserve` TRUE TRUE
#ASSERT NOT (`s 171 the directors may set apart a reserve` FALSE TRUE)
#ASSERT NOT (`s 171 the directors may set apart a reserve` TRUE FALSE)
#ASSERT `s 171 the directors may abolish the reserve` TRUE
#ASSERT NOT (`s 171 the directors may abolish the reserve` FALSE)

§ `Section 172: reliance by directors and committee members`

GIVEN member IS A BOOLEAN
      goodFaith IS A BOOLEAN
      source IS A `s 172 What the director relied on`
      believes IS A BOOLEAN
      selected IS A BOOLEAN
      aboutAssets IS A BOOLEAN
GIVETH A `s 172 Reliance by a director or committee member`
`dg3 test reliance` member goodFaith source believes selected aboutAssets MEANS
    `s 172 Reliance by a director or committee member` WITH
        `the person is a member of the board of directors or of a committee designated by the board` IS member
        `the person relied in good faith` IS goodFaith
        `what the person relied on` IS source
        `the person reasonably believes the matters are within the other person's professional or expert competence` IS believes
        `the other person was selected with reasonable care by or on behalf of the corporation` IS selected
        `the matter is the value and amount of the assets, liabilities or net profits of the corporation, or another fact pertinent to the existence and amount of surplus or other funds from which dividends might properly be declared and paid, or with which the corporation's stock might properly be purchased or redeemed` IS aboutAssets

#ASSERT `s 172 the director or committee member is fully protected` (`dg3 test reliance` TRUE TRUE `the records of the corporation under s 172` FALSE FALSE TRUE)
#ASSERT `s 172 the director or committee member is fully protected` (`dg3 test reliance` TRUE TRUE `information, opinions, reports or statements presented by an officer or employee under s 172` FALSE FALSE TRUE)
#ASSERT `s 172 the director or committee member is fully protected` (`dg3 test reliance` TRUE TRUE `information, opinions, reports or statements presented by a committee of the board under s 172` FALSE FALSE TRUE)
#ASSERT `s 172 the director or committee member is fully protected` (`dg3 test reliance` TRUE TRUE `information, opinions, reports or statements presented by any other person under s 172` TRUE TRUE TRUE)
#ASSERT NOT (`s 172 the director or committee member is fully protected` (`dg3 test reliance` TRUE TRUE `information, opinions, reports or statements presented by any other person under s 172` FALSE TRUE TRUE))
#ASSERT NOT (`s 172 the director or committee member is fully protected` (`dg3 test reliance` TRUE TRUE `information, opinions, reports or statements presented by any other person under s 172` TRUE FALSE TRUE))
#ASSERT NOT (`s 172 the director or committee member is fully protected` (`dg3 test reliance` TRUE FALSE `the records of the corporation under s 172` FALSE FALSE TRUE))
#ASSERT NOT (`s 172 the director or committee member is fully protected` (`dg3 test reliance` FALSE TRUE `the records of the corporation under s 172` FALSE FALSE TRUE))
#ASSERT NOT (`s 172 the director or committee member is fully protected` (`dg3 test reliance` TRUE TRUE `the records of the corporation under s 172` FALSE FALSE FALSE))

§ `Section 173: declaration and payment of dividends`

#ASSERT `s 173 the corporation may pay the dividend` TRUE `a dividend in cash under s 173` EQUALS JUST TRUE
#ASSERT `s 173 the corporation may pay the dividend` TRUE `a dividend in property under s 173` EQUALS JUST TRUE
#ASSERT `s 173 the corporation may pay the dividend` TRUE `a dividend in shares of the capital stock of the corporation under s 173` EQUALS JUST TRUE
#ASSERT `s 173 the corporation may pay the dividend` FALSE `a dividend in cash under s 173` EQUALS JUST FALSE
-- a dividend in some other form: the text does not answer
#ASSERT `s 173 the corporation may pay the dividend` TRUE `a dividend in another form under s 173` EQUALS NOTHING
-- a dividend in unissued shares: capital designated at least the aggregate par value (200); a split-up needs no designation
#ASSERT `s 173 the designation as capital for a dividend in shares is as the section requires` FALSE TRUE 200 200 FALSE FALSE
#ASSERT NOT (`s 173 the designation as capital for a dividend in shares is as the section requires` FALSE TRUE 199 200 FALSE FALSE)
#ASSERT NOT (`s 173 the designation as capital for a dividend in shares is as the section requires` FALSE FALSE 500 200 FALSE FALSE)
#ASSERT `s 173 the designation as capital for a dividend in shares is as the section requires` TRUE FALSE 0 200 FALSE FALSE
-- shares without par value: such amount as the board determines
#ASSERT `s 173 the designation as capital for a dividend in shares is as the section requires` FALSE TRUE 200 0 TRUE TRUE
#ASSERT NOT (`s 173 the designation as capital for a dividend in shares is as the section requires` FALSE TRUE 200 0 FALSE TRUE)

§ `Section 174: liability of directors`

GIVEN violation IS A BOOLEAN
      wilful IS A BOOLEAN
      administration IS A BOOLEAN
      paid IS A DATE
      claim IS A DATE
      dissented IS A BOOLEAN
      entered IS A BOOLEAN
      insolvent IS A BOOLEAN
GIVETH A `s 174(a) Facts about a director and an unlawful payment`
`dg3 test director` violation wilful administration paid claim dissented entered insolvent MEANS
    `s 174(a) Facts about a director and an unlawful payment` WITH
        `the dividend, purchase or redemption violated section 160 or section 173` IS violation
        `the violation was wilful or negligent` IS wilful
        `the director was a director under whose administration it happened` IS administration
        `the day the unlawful dividend was paid or the unlawful purchase or redemption was made` IS paid
        `the day the claim is made` IS claim
        `the director was absent when it was done or dissented from the act or resolution` IS dissented
        `the director caused the dissent to be entered on the books containing the minutes of the proceedings of the directors at the time it was done or immediately after the director had notice of it` IS entered
        `the corporation is dissolved or insolvent` IS insolvent

-- liable to the corporation within 6 years after the payment (15 January 2026 plus 6 years is 15 January 2032)
#ASSERT `s 174(a) the director is liable to the corporation` (`dg3 test director` TRUE TRUE TRUE (YMD 2026 1 15) (YMD 2032 1 15) FALSE FALSE FALSE)
#ASSERT NOT (`s 174(a) the director is liable to the corporation` (`dg3 test director` TRUE TRUE TRUE (YMD 2026 1 15) (YMD 2032 1 16) FALSE FALSE FALSE))
-- a payment on 29 February 2024: 6 years later the period ends on 28 February 2030 (clamped as dg-core's date arithmetic does; Fork F10)
#ASSERT `s 174(a) the director is liable to the corporation` (`dg3 test director` TRUE TRUE TRUE (YMD 2024 2 29) (YMD 2030 2 28) FALSE FALSE FALSE)
#ASSERT NOT (`s 174(a) the director is liable to the corporation` (`dg3 test director` TRUE TRUE TRUE (YMD 2024 2 29) (YMD 2030 3 1) FALSE FALSE FALSE))
-- no violation, no wilful or negligent violation, or not a director under whose administration it happened: no liability
#ASSERT NOT (`s 174(a) the director is liable to the corporation` (`dg3 test director` FALSE TRUE TRUE (YMD 2026 1 15) (YMD 2027 1 15) FALSE FALSE FALSE))
#ASSERT NOT (`s 174(a) the director is liable to the corporation` (`dg3 test director` TRUE FALSE TRUE (YMD 2026 1 15) (YMD 2027 1 15) FALSE FALSE FALSE))
#ASSERT NOT (`s 174(a) the director is liable to the corporation` (`dg3 test director` TRUE TRUE FALSE (YMD 2026 1 15) (YMD 2027 1 15) FALSE FALSE FALSE))
-- a director who dissented and had the dissent entered in the minutes is exonerated; one who dissented but did not enter it is not
#ASSERT `s 174(a) the director is exonerated from the liability` (`dg3 test director` TRUE TRUE TRUE (YMD 2026 1 15) (YMD 2027 1 15) TRUE TRUE FALSE)
#ASSERT NOT (`s 174(a) the director is liable to the corporation` (`dg3 test director` TRUE TRUE TRUE (YMD 2026 1 15) (YMD 2027 1 15) TRUE TRUE FALSE))
#ASSERT NOT (`s 174(a) the director is exonerated from the liability` (`dg3 test director` TRUE TRUE TRUE (YMD 2026 1 15) (YMD 2027 1 15) TRUE FALSE FALSE))
#ASSERT `s 174(a) the director is liable to the corporation` (`dg3 test director` TRUE TRUE TRUE (YMD 2026 1 15) (YMD 2027 1 15) TRUE FALSE FALSE)
#ASSERT NOT (`s 174(a) the director is exonerated from the liability` (`dg3 test director` TRUE TRUE TRUE (YMD 2026 1 15) (YMD 2027 1 15) FALSE TRUE FALSE))
-- liable to the creditors only in the event of dissolution or insolvency
#ASSERT `s 174(a) the director is liable to the creditors of the corporation` (`dg3 test director` TRUE TRUE TRUE (YMD 2026 1 15) (YMD 2027 1 15) FALSE FALSE TRUE)
#ASSERT NOT (`s 174(a) the director is liable to the creditors of the corporation` (`dg3 test director` TRUE TRUE TRUE (YMD 2026 1 15) (YMD 2027 1 15) FALSE FALSE FALSE))
-- the full amount unlawfully paid with interest from the time the liability accrued
#ASSERT `s 174(a) the amount for which the directors are liable` 1000 50 EQUALS 1050
-- contribution from the other directors who voted for or concurred
#ASSERT `s 174(b) the other director owes contribution to the director` TRUE TRUE
#ASSERT NOT (`s 174(b) the other director owes contribution to the director` TRUE FALSE)
#ASSERT NOT (`s 174(b) the other director owes contribution to the director` FALSE TRUE)
-- subrogation: the director paid 300; this stockholder received 100 of the 600 received by all the stockholders who knew: 300 times 100/600 is 50
#ASSERT `s 174(c) the amount of the corporation's rights against the stockholder to which the director is subrogated` TRUE 300 TRUE 100 600 EQUALS JUST 50
#ASSERT `s 174(c) the amount of the corporation's rights against the stockholder to which the director is subrogated` TRUE 300 FALSE 100 600 EQUALS NOTHING
#ASSERT `s 174(c) the amount of the corporation's rights against the stockholder to which the director is subrogated` FALSE 300 TRUE 100 600 EQUALS NOTHING
#ASSERT `s 174(c) the amount of the corporation's rights against the stockholder to which the director is subrogated` TRUE 300 TRUE 0 0 EQUALS NOTHING
