IMPORT prelude
IMPORT daydate
IMPORT `dg-core`
IMPORT `dg4-s211-meetings`

-- Tests of dg4-s211-meetings.l4. Expected values are written by hand from the text of s 211
-- (de-code-t8-ch1-2026-10-01.txt, lines 766-775), beside each assertion, never copied from the module's own output.

§ `Tests of s 211`

§§ `(a)(1): the place of a meeting`

-- src:767: designated by or in the manner provided in the certificate or bylaws, or if not so designated, determined by the board
#ASSERT `s 211(a)(1) who determines the place of the meeting` TRUE EQUALS `the certificate of incorporation or the bylaws, by designation or in the manner they provide`
#ASSERT `s 211(a)(1) who determines the place of the meeting` FALSE EQUALS `the board of directors`
-- the board may go remote-only if it is authorized to determine the place
#ASSERT `s 211(a)(1) the board of directors may decide that the meeting is held solely by remote communication` FALSE FALSE
#ASSERT `s 211(a)(1) the board of directors may decide that the meeting is held solely by remote communication` TRUE TRUE
#ASSERT NOT (`s 211(a)(1) the board of directors may decide that the meeting is held solely by remote communication` TRUE FALSE)
#ASSERT `s 211(a)(1) the board of directors may decide that the meeting is held solely by remote communication` FALSE TRUE

§§ `(a)(2): remote communication`

-- src:768-770: a. participate if the board authorizes it; b. deemed present and vote if (i), (ii) and (iii)
#ASSERT `s 211(a)(2)a. the stockholder or proxyholder not physically present may participate in the meeting by remote communication` TRUE TRUE
#ASSERT NOT (`s 211(a)(2)a. the stockholder or proxyholder not physically present may participate in the meeting by remote communication` FALSE TRUE)
#ASSERT NOT (`s 211(a)(2)a. the stockholder or proxyholder not physically present may participate in the meeting by remote communication` TRUE FALSE)
#ASSERT `s 211(a)(2)b. the person is deemed present in person and may vote by remote communication` TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 211(a)(2)b. the person is deemed present in person and may vote by remote communication` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`s 211(a)(2)b. the person is deemed present in person and may vote by remote communication` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 211(a)(2)b. the person is deemed present in person and may vote by remote communication` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 211(a)(2)b. the person is deemed present in person and may vote by remote communication` TRUE TRUE TRUE FALSE)

§§ `(b): the annual meeting`

#ASSERT `s 211(b) the corporation must hold an annual meeting of stockholders for the election of directors` FALSE
#ASSERT NOT (`s 211(b) the corporation must hold an annual meeting of stockholders for the election of directors` TRUE)
#ASSERT `s 211(b) the date and time of the annual meeting are designated as the subsection requires` TRUE
#ASSERT NOT (`s 211(b) the date and time of the annual meeting are designated as the subsection requires` FALSE)
-- unless the certificate of incorporation otherwise provides, stockholders may act by written consent to elect directors
#ASSERT `s 211(b) the stockholders may act by written consent to elect directors` FALSE
#ASSERT NOT (`s 211(b) the stockholders may act by written consent to elect directors` TRUE)
-- a consent less than unanimous takes the place of the annual meeting only if all the directorships are vacant and are filled by it
#ASSERT `s 211(b) the written consent takes the place of the annual meeting` TRUE FALSE FALSE
#ASSERT `s 211(b) the written consent takes the place of the annual meeting` FALSE TRUE TRUE
#ASSERT NOT (`s 211(b) the written consent takes the place of the annual meeting` FALSE TRUE FALSE)
#ASSERT NOT (`s 211(b) the written consent takes the place of the annual meeting` FALSE FALSE TRUE)
#ASSERT `s 211(b) the business may be transacted at the annual meeting` TRUE
#ASSERT NOT (`s 211(b) the business may be transacted at the annual meeting` FALSE)

§§ `(c): failure to hold the annual meeting`

-- the failure affects valid acts or works a forfeiture only where the chapter specifically provides
#ASSERT NOT (`s 211(c) the failure to hold the annual meeting or to elect enough directors affects otherwise valid corporate acts or works a forfeiture or dissolution` FALSE)
#ASSERT `s 211(c) the failure to hold the annual meeting or to elect enough directors affects otherwise valid corporate acts or works a forfeiture or dissolution` TRUE
-- the directors must cause the meeting to be held as soon as is convenient
#ASSERT `s 211(c) the directors must cause the annual meeting to be held as soon as is convenient` TRUE TRUE
#ASSERT NOT (`s 211(c) the directors must cause the annual meeting to be held as soon as is convenient` TRUE FALSE)
#ASSERT NOT (`s 211(c) the directors must cause the annual meeting to be held as soon as is convenient` FALSE TRUE)

-- Court-ordered meeting. arguments: applicant is stockholder or director, no meeting or consent, designated day, organized, last meeting, last consent, day of application
-- designated 1 January 2026: 30 days after is 31 January 2026
#ASSERT `s 211(c) the Court of Chancery may summarily order a meeting to be held` TRUE TRUE (JUST (YMD 2026 1 1)) (YMD 2020 1 1) NOTHING NOTHING (YMD 2026 1 31)
#ASSERT NOT (`s 211(c) the Court of Chancery may summarily order a meeting to be held` TRUE TRUE (JUST (YMD 2026 1 1)) (YMD 2020 1 1) NOTHING NOTHING (YMD 2026 1 30))
-- not designated: 13 months after the latest of organization (31 Aug 2024), the last meeting (15 Jan 2025) and the last consent (1 Mar 2025) is 1 April 2026
#ASSERT `s 211(c) the Court of Chancery may summarily order a meeting to be held` TRUE TRUE NOTHING (YMD 2024 8 31) (JUST (YMD 2025 1 15)) (JUST (YMD 2025 3 1)) (YMD 2026 4 1)
#ASSERT NOT (`s 211(c) the Court of Chancery may summarily order a meeting to be held` TRUE TRUE NOTHING (YMD 2024 8 31) (JUST (YMD 2025 1 15)) (JUST (YMD 2025 3 1)) (YMD 2026 3 31))
-- not designated, no meeting and no consent yet: 13 months from organization; the latest is the organization (31 January 2025), plus 13 months clamps to 28 February 2026
#ASSERT `s 211(c) the Court of Chancery may summarily order a meeting to be held` TRUE TRUE NOTHING (YMD 2025 1 31) NOTHING NOTHING (YMD 2026 2 28)
#ASSERT NOT (`s 211(c) the Court of Chancery may summarily order a meeting to be held` TRUE TRUE NOTHING (YMD 2025 1 31) NOTHING NOTHING (YMD 2026 2 27))
-- only a stockholder or director may apply, and only while there has been no meeting and no consent
#ASSERT NOT (`s 211(c) the Court of Chancery may summarily order a meeting to be held` FALSE TRUE (JUST (YMD 2026 1 1)) (YMD 2020 1 1) NOTHING NOTHING (YMD 2026 6 1))
#ASSERT NOT (`s 211(c) the Court of Chancery may summarily order a meeting to be held` TRUE FALSE (JUST (YMD 2026 1 1)) (YMD 2020 1 1) NOTHING NOTHING (YMD 2026 6 1))
-- the latest of the events
#ASSERT `s 211(c) the latest of the events` (YMD 2024 8 31) (JUST (YMD 2025 1 15)) (JUST (YMD 2025 3 1)) EQUALS YMD 2025 3 1
#ASSERT `s 211(c) the latest of the events` (YMD 2024 8 31) NOTHING NOTHING EQUALS YMD 2024 8 31
#ASSERT `s 211(c) the latest of the events` (YMD 2024 8 31) (JUST (YMD 2025 1 15)) NOTHING EQUALS YMD 2025 1 15
-- quorum at the meeting the Court orders
#ASSERT `s 211(c) the shares represented at the meeting the Court ordered constitute a quorum` 1 EQUALS JUST TRUE
#ASSERT `s 211(c) the shares represented at the meeting the Court ordered constitute a quorum` 0 EQUALS NOTHING
-- the Court's orders
#ASSERT `s 211(c) the Court of Chancery may issue the order` `an order designating the time and place of the meeting` TRUE
#ASSERT `s 211(c) the Court of Chancery may issue the order` `an order designating the record date or dates for determining the stockholders entitled to notice of the meeting and to vote at it` TRUE
#ASSERT `s 211(c) the Court of Chancery may issue the order` `an order fixing the form of notice of the meeting` TRUE
#ASSERT `s 211(c) the Court of Chancery may issue the order` `any other order that is appropriate` TRUE
#ASSERT NOT (`s 211(c) the Court of Chancery may issue the order` `any other order that is appropriate` FALSE)

§§ `(d): special meetings`

#ASSERT `s 211(d) the person may call a special meeting of the stockholders` TRUE FALSE
#ASSERT `s 211(d) the person may call a special meeting of the stockholders` FALSE TRUE
#ASSERT NOT (`s 211(d) the person may call a special meeting of the stockholders` FALSE FALSE)

§§ `(e): written ballot`

#ASSERT `s 211(e) the election of directors must be by written ballot` FALSE
#ASSERT NOT (`s 211(e) the election of directors must be by written ballot` TRUE)
#ASSERT `s 211(e) a ballot submitted by electronic transmission satisfies the requirement of a written ballot` TRUE TRUE
#ASSERT NOT (`s 211(e) a ballot submitted by electronic transmission satisfies the requirement of a written ballot` FALSE TRUE)
#ASSERT NOT (`s 211(e) a ballot submitted by electronic transmission satisfies the requirement of a written ballot` TRUE FALSE)
