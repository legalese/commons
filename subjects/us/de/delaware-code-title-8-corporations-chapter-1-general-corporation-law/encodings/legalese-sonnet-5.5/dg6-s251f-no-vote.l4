        `no vote is necessary under the first sentence of s 251(f)`
    OR `no vote is necessary under the second sentence of s 251(f)`

@ref 8 Del. C. § 251(f) (src:1080)
DECLARE `s 251(f) Sentence relied on` IS ONE OF
    `the first sentence of s 251(f)`
    `the second sentence of s 251(f)`

@ref 8 Del. C. § 251(f) (src:1080)
DECLARE `s 251(f) What the secretary or assistant secretary certifies` IS ONE OF
