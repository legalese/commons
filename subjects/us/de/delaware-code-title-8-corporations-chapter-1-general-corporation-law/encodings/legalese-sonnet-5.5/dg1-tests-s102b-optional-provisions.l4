IMPORT prelude
IMPORT daydate
IMPORT `dg-core`
IMPORT `dg1-s111-s115-jurisdiction-and-forum`
IMPORT `dg1-s102b-optional-provisions`

-- Tests of section 102(b), (c), (d) and (f) (dg1-s102b-optional-provisions.l4). Every expected value is written by
-- hand from the text (src:48-76), beside the assertion, and was decided before the module was run.

§ `Tests of section 102(b), (c), (d) and (f)`

§§ `s 102(b) the chapeau`

-- the certificate "may also contain any or all of the following matters": none of them is required
#ASSERT NOT (`s 102(b) the certificate of incorporation is required to contain the matter listed in subsection (b)`)

§§ `s 102(b)(1)`

#ASSERT `s 102(b)(1) the certificate of incorporation may contain the provision` TRUE FALSE
#ASSERT NOT (`s 102(b)(1) the certificate of incorporation may contain the provision` TRUE TRUE)
#ASSERT NOT (`s 102(b)(1) the certificate of incorporation may contain the provision` FALSE FALSE)
#ASSERT `s 102(b)(1) a provision that this chapter requires or permits to be stated in the bylaws may instead be stated in the certificate of incorporation` TRUE
#ASSERT NOT (`s 102(b)(1) a provision that this chapter requires or permits to be stated in the bylaws may instead be stated in the certificate of incorporation` FALSE)

§§ `s 102(b)(2)`

-- (i) is for a corporation other than a nonstock corporation, (ii) for a nonstock corporation
#ASSERT `s 102(b)(2) the certificate of incorporation contains the compromise or arrangement provision in haec verba` `a stock corporation` TRUE FALSE
#ASSERT NOT (`s 102(b)(2) the certificate of incorporation contains the compromise or arrangement provision in haec verba` `a stock corporation` FALSE TRUE)
#ASSERT `s 102(b)(2) the certificate of incorporation contains the compromise or arrangement provision in haec verba` `a charitable nonstock corporation` FALSE TRUE
#ASSERT NOT (`s 102(b)(2) the certificate of incorporation contains the compromise or arrangement provision in haec verba` `a nonstock corporation with membership interests` TRUE FALSE)
-- who may apply
#ASSERT `s 102(b)(2) the applicant may apply for a meeting to be summoned` `a stock corporation` `the corporation` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 102(b)(2) the applicant may apply for a meeting to be summoned` `a stock corporation` `a creditor` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 102(b)(2) the applicant may apply for a meeting to be summoned` `a stock corporation` `a stockholder` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 102(b)(2) the applicant may apply for a meeting to be summoned` `a stock corporation` `a member of a nonstock corporation` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 102(b)(2) the applicant may apply for a meeting to be summoned` `a charitable nonstock corporation` `a member of a nonstock corporation` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 102(b)(2) the applicant may apply for a meeting to be summoned` `a charitable nonstock corporation` `a stockholder` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 102(b)(2) the applicant may apply for a meeting to be summoned` `a stock corporation` `a receiver` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 102(b)(2) the applicant may apply for a meeting to be summoned` `a stock corporation` `a receiver` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 102(b)(2) the applicant may apply for a meeting to be summoned` `a stock corporation` `a trustee` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 102(b)(2) the applicant may apply for a meeting to be summoned` `a stock corporation` `a director` TRUE FALSE EQUALS NOTHING
-- without the provision in the certificate the paragraph does not apply
#ASSERT `s 102(b)(2) the applicant may apply for a meeting to be summoned` `a stock corporation` `a creditor` FALSE FALSE EQUALS NOTHING
-- the compromise binds all if a majority in number representing three fourths in value agree and the court sanctions
#ASSERT `s 102(b)(2) the compromise or arrangement and the reorganization are binding on all` 3 5 75 100 TRUE EQUALS JUST TRUE
-- three fourths in value is reached at exactly 75 and not at 74
#ASSERT `s 102(b)(2) the compromise or arrangement and the reorganization are binding on all` 3 5 74 100 TRUE EQUALS JUST FALSE
-- a majority in number is more than half: 2 of 4 is not a majority
#ASSERT `s 102(b)(2) the compromise or arrangement and the reorganization are binding on all` 2 4 90 100 TRUE EQUALS JUST FALSE
#ASSERT `s 102(b)(2) the compromise or arrangement and the reorganization are binding on all` 3 5 75 100 FALSE EQUALS JUST FALSE
-- counts that cannot be a vote: not covered
#ASSERT `s 102(b)(2) the compromise or arrangement and the reorganization are binding on all` 0 0 0 0 TRUE EQUALS NOTHING
#ASSERT `s 102(b)(2) the compromise or arrangement and the reorganization are binding on all` 6 5 75 100 TRUE EQUALS NOTHING
#ASSERT `s 102(b)(2) the compromise or arrangement and the reorganization are binding on all` 3 5 101 100 TRUE EQUALS NOTHING

§§ `s 102(b)(3)`

#ASSERT `s 102(b)(3) the date on which existing preemptive rights are preserved` EQUALS YMD 1967 7 3
#ASSERT `s 102(b)(3) the certificate of incorporation may contain the provision granting a preemptive right` TRUE
#ASSERT NOT (`s 102(b)(3) the certificate of incorporation may contain the provision granting a preemptive right` FALSE)
-- no preemptive right unless expressly granted in the certificate ...
#ASSERT `s 102(b)(3) the stockholder has a preemptive right to subscribe to an additional issue of stock or to a convertible security` TRUE NOTHING FALSE
#ASSERT NOT (`s 102(b)(3) the stockholder has a preemptive right to subscribe to an additional issue of stock or to a convertible security` FALSE NOTHING FALSE)
-- ... but a right in existence on July 3, 1967 remains unless changed or terminated by action expressly providing for it
#ASSERT `s 102(b)(3) the stockholder has a preemptive right to subscribe to an additional issue of stock or to a convertible security` FALSE (JUST (YMD 1967 7 3)) FALSE
#ASSERT `s 102(b)(3) the stockholder has a preemptive right to subscribe to an additional issue of stock or to a convertible security` FALSE (JUST (YMD 1967 7 2)) FALSE
#ASSERT NOT (`s 102(b)(3) the stockholder has a preemptive right to subscribe to an additional issue of stock or to a convertible security` FALSE (JUST (YMD 1967 7 4)) FALSE)
#ASSERT NOT (`s 102(b)(3) the stockholder has a preemptive right to subscribe to an additional issue of stock or to a convertible security` FALSE (JUST (YMD 1967 7 2)) TRUE)
-- an express grant in the certificate is enough even if an older right was terminated
#ASSERT `s 102(b)(3) the stockholder has a preemptive right to subscribe to an additional issue of stock or to a convertible security` TRUE (JUST (YMD 1960 1 1)) TRUE

§§ `s 102(b)(4)`

-- chapter: a majority of the outstanding stock entitled to vote (more than 1/2)
-- certificate: at least two thirds of the same
#ASSERT `s 102(b)(4) the certificate of incorporation requires a larger portion of the stock or other securities having voting power than this chapter requires` (`a majority of` `the outstanding stock entitled to vote`) (`at least` (2 DIVIDED BY 3) `of` `the outstanding stock entitled to vote`) EQUALS JUST TRUE
-- the same proportion: no larger
#ASSERT `s 102(b)(4) the certificate of incorporation requires a larger portion of the stock or other securities having voting power than this chapter requires` (`a majority of` `the outstanding stock entitled to vote`) (`a majority of` `the outstanding stock entitled to vote`) EQUALS JUST FALSE
-- "at least one half" is smaller than "more than one half"
#ASSERT `s 102(b)(4) the certificate of incorporation requires a larger portion of the stock or other securities having voting power than this chapter requires` (`a majority of` `the outstanding stock entitled to vote`) (`at least` (1 DIVIDED BY 2) `of` `the outstanding stock entitled to vote`) EQUALS JUST FALSE
-- "more than one half" is larger than "at least one half"
#ASSERT `s 102(b)(4) the certificate of incorporation requires a larger portion of the stock or other securities having voting power than this chapter requires` (`at least` (1 DIVIDED BY 2) `of` `the outstanding stock entitled to vote`) (`a majority of` `the outstanding stock entitled to vote`) EQUALS JUST TRUE
-- a smaller portion
#ASSERT `s 102(b)(4) the certificate of incorporation requires a larger portion of the stock or other securities having voting power than this chapter requires` (`at least` (2 DIVIDED BY 3) `of` `the outstanding stock entitled to vote`) (`a majority of` `the outstanding stock entitled to vote`) EQUALS JUST FALSE
-- counted against different bases: not compared
#ASSERT `s 102(b)(4) the certificate of incorporation requires a larger portion of the stock or other securities having voting power than this chapter requires` (`a majority of` `the outstanding stock entitled to vote`) (`at least` (2 DIVIDED BY 3) `of` `the votes cast`) EQUALS NOTHING
#ASSERT `s 102(b)(4) the certificate of incorporation requires a larger number of the directors than this chapter requires` 4 5
#ASSERT NOT (`s 102(b)(4) the certificate of incorporation requires a larger number of the directors than this chapter requires` 4 4)
#ASSERT NOT (`s 102(b)(4) the certificate of incorporation requires a larger number of the directors than this chapter requires` 4 3)

§§ `s 102(b)(5) and (6)`

#ASSERT NOT (`s 102(b)(5) the duration of the corporation's existence has expired` (YMD 2030 12 31) (JUST (YMD 2030 12 31)))
#ASSERT `s 102(b)(5) the duration of the corporation's existence has expired` (YMD 2031 1 1) (JUST (YMD 2030 12 31))
#ASSERT NOT (`s 102(b)(5) the duration of the corporation's existence has expired` (YMD 2099 1 1) NOTHING)
#ASSERT `s 102(b)(5) the corporation has perpetual existence` NOTHING
#ASSERT NOT (`s 102(b)(5) the corporation has perpetual existence` (JUST (YMD 2030 12 31)))
-- the stockholder is liable for the debts only by a provision (and its conditions) or by the stockholder's own conduct or acts
#ASSERT `s 102(b)(6) the stockholder is personally liable for the payment of the corporation's debts` TRUE TRUE FALSE
#ASSERT NOT (`s 102(b)(6) the stockholder is personally liable for the payment of the corporation's debts` TRUE FALSE FALSE)
#ASSERT NOT (`s 102(b)(6) the stockholder is personally liable for the payment of the corporation's debts` FALSE TRUE FALSE)
#ASSERT `s 102(b)(6) the stockholder is personally liable for the payment of the corporation's debts` FALSE FALSE TRUE

§§ `s 102(b)(7)`

-- order: capacity; officer deemed to have consented to service under 10 Del. C. 3114(b); liability to the corporation or stockholders for monetary damages for breach of fiduciary duty; loyalty; not in good faith, intentional misconduct or knowing violation; under section 174; improper personal benefit; action by or in the right of the corporation; date of the act; date the provision becomes effective
GIVEN capacity IS A `s 102(b)(7) Capacity`
      consent IS A BOOLEAN
      base IS A BOOLEAN
      loyalty IS A BOOLEAN
      goodfaith IS A BOOLEAN
      s174 IS A BOOLEAN
      benefit IS A BOOLEAN
      bycorp IS A BOOLEAN
      actdate IS A DATE
      effdate IS A DATE
GIVETH A `s 102(b)(7) Liability asserted`
`t102b liability` capacity consent base loyalty goodfaith s174 benefit bycorp actdate effdate MEANS `s 102(b)(7) Liability asserted` OF capacity, consent, base, loyalty, goodfaith, s174, benefit, bycorp, actdate, effdate

-- a director, an ordinary breach of the duty of care, after the provision took effect: eliminable
#ASSERT `s 102(b)(7) the provision may eliminate or limit the person's personal liability` (`t102b liability` `as a director` FALSE TRUE FALSE FALSE FALSE FALSE FALSE (YMD 2026 6 1) (YMD 2026 1 1)) EQUALS JUST TRUE
-- (i) loyalty, (ii) bad faith or intentional misconduct, (iv) improper personal benefit: never eliminable
#ASSERT `s 102(b)(7) the provision may eliminate or limit the person's personal liability` (`t102b liability` `as a director` FALSE TRUE TRUE FALSE FALSE FALSE FALSE (YMD 2026 6 1) (YMD 2026 1 1)) EQUALS JUST FALSE
#ASSERT `s 102(b)(7) the provision may eliminate or limit the person's personal liability` (`t102b liability` `as a director` FALSE TRUE FALSE TRUE FALSE FALSE FALSE (YMD 2026 6 1) (YMD 2026 1 1)) EQUALS JUST FALSE
#ASSERT `s 102(b)(7) the provision may eliminate or limit the person's personal liability` (`t102b liability` `as a director` FALSE TRUE FALSE FALSE FALSE TRUE FALSE (YMD 2026 6 1) (YMD 2026 1 1)) EQUALS JUST FALSE
-- (iii) is a director's liability under section 174
#ASSERT `s 102(b)(7) the provision may eliminate or limit the person's personal liability` (`t102b liability` `as a director` FALSE TRUE FALSE FALSE TRUE FALSE FALSE (YMD 2026 6 1) (YMD 2026 1 1)) EQUALS JUST FALSE
#ASSERT `s 102(b)(7) the provision may eliminate or limit the person's personal liability` (`t102b liability` `as a person who, pursuant to a provision of the certificate of incorporation in accordance with § 141(a), exercises or performs powers or duties otherwise conferred or imposed upon the board of directors` FALSE TRUE FALSE FALSE TRUE FALSE FALSE (YMD 2026 6 1) (YMD 2026 1 1)) EQUALS JUST FALSE
-- an officer: only one deemed to have consented to service counts; otherwise the paragraph does not speak
#ASSERT `s 102(b)(7) the provision may eliminate or limit the person's personal liability` (`t102b liability` `as an officer` TRUE TRUE FALSE FALSE FALSE FALSE FALSE (YMD 2026 6 1) (YMD 2026 1 1)) EQUALS JUST TRUE
#ASSERT `s 102(b)(7) the provision may eliminate or limit the person's personal liability` (`t102b liability` `as an officer` FALSE TRUE FALSE FALSE FALSE FALSE FALSE (YMD 2026 6 1) (YMD 2026 1 1)) EQUALS NOTHING
-- (iii) is a director's, not an officer's; (v) is an officer's, not a director's
#ASSERT `s 102(b)(7) the provision may eliminate or limit the person's personal liability` (`t102b liability` `as an officer` TRUE TRUE FALSE FALSE TRUE FALSE FALSE (YMD 2026 6 1) (YMD 2026 1 1)) EQUALS JUST TRUE
#ASSERT `s 102(b)(7) the provision may eliminate or limit the person's personal liability` (`t102b liability` `as an officer` TRUE TRUE FALSE FALSE FALSE FALSE TRUE (YMD 2026 6 1) (YMD 2026 1 1)) EQUALS JUST FALSE
#ASSERT `s 102(b)(7) the provision may eliminate or limit the person's personal liability` (`t102b liability` `as a director` FALSE TRUE FALSE FALSE FALSE FALSE TRUE (YMD 2026 6 1) (YMD 2026 1 1)) EQUALS JUST TRUE
-- (iv) improper personal benefit binds an officer too
#ASSERT `s 102(b)(7) the provision may eliminate or limit the person's personal liability` (`t102b liability` `as an officer` TRUE TRUE FALSE FALSE FALSE TRUE FALSE (YMD 2026 6 1) (YMD 2026 1 1)) EQUALS JUST FALSE
-- a liability that is not to the corporation or its stockholders for monetary damages for breach of fiduciary duty is outside the paragraph
#ASSERT `s 102(b)(7) the provision may eliminate or limit the person's personal liability` (`t102b liability` `as a director` FALSE FALSE FALSE FALSE FALSE FALSE FALSE (YMD 2026 6 1) (YMD 2026 1 1)) EQUALS NOTHING
-- no provision eliminates liability for an act or omission before the date it becomes effective
#ASSERT `s 102(b)(7) the provision may eliminate or limit the person's personal liability` (`t102b liability` `as a director` FALSE TRUE FALSE FALSE FALSE FALSE FALSE (YMD 2025 12 31) (YMD 2026 1 1)) EQUALS JUST FALSE
#ASSERT `s 102(b)(7) the provision may eliminate or limit the person's personal liability` (`t102b liability` `as a director` FALSE TRUE FALSE FALSE FALSE FALSE FALSE (YMD 2026 1 1) (YMD 2026 1 1)) EQUALS JUST TRUE
-- an amendment, repeal or elimination does not affect an act or omission before it, unless the provision provides otherwise at the time of the act
#ASSERT `s 102(b)(7) the provision as it stood continues to apply to the act or omission despite the later amendment, repeal or elimination` (YMD 2026 3 1) (YMD 2026 6 1) FALSE
#ASSERT NOT (`s 102(b)(7) the provision as it stood continues to apply to the act or omission despite the later amendment, repeal or elimination` (YMD 2026 3 1) (YMD 2026 6 1) TRUE)
#ASSERT NOT (`s 102(b)(7) the provision as it stood continues to apply to the act or omission despite the later amendment, repeal or elimination` (YMD 2026 6 1) (YMD 2026 6 1) FALSE)
#ASSERT NOT (`s 102(b)(7) the provision as it stood continues to apply to the act or omission despite the later amendment, repeal or elimination` (YMD 2026 7 1) (YMD 2026 6 1) FALSE)

§§ `s 102(c), (d) and (f)`

#ASSERT `s 102(c) the certificate of incorporation must set forth the power` TRUE EQUALS JUST FALSE
#ASSERT `s 102(c) the certificate of incorporation must set forth the power` FALSE EQUALS NOTHING
-- facts: the excluded provisions
#ASSERT NOT (`s 102(d) the provision may be made dependent on facts ascertainable outside the certificate` `the name of the corporation under paragraph (a)(1)` `a stock corporation` TRUE)
#ASSERT NOT (`s 102(d) the provision may be made dependent on facts ascertainable outside the certificate` `the registered office and registered agent under paragraph (a)(2)` `a stock corporation` TRUE)
#ASSERT NOT (`s 102(d) the provision may be made dependent on facts ascertainable outside the certificate` `the incorporators under paragraph (a)(5)` `a stock corporation` TRUE)
#ASSERT NOT (`s 102(d) the provision may be made dependent on facts ascertainable outside the certificate` `the first directors under paragraph (a)(6)` `a stock corporation` TRUE)
#ASSERT NOT (`s 102(d) the provision may be made dependent on facts ascertainable outside the certificate` `the compromise or arrangement provision under paragraph (b)(2)` `a stock corporation` TRUE)
#ASSERT NOT (`s 102(d) the provision may be made dependent on facts ascertainable outside the certificate` `the limit on the duration of the corporation's existence under paragraph (b)(5)` `a stock corporation` TRUE)
#ASSERT NOT (`s 102(d) the provision may be made dependent on facts ascertainable outside the certificate` `the elimination or limitation of the liability of a director or officer under paragraph (b)(7)` `a stock corporation` TRUE)
-- classes, shares and par value: excluded for a corporation other than a nonstock corporation
#ASSERT NOT (`s 102(d) the provision may be made dependent on facts ascertainable outside the certificate` `the classes, number of shares and par value of shares a corporation other than a nonstock corporation is authorized to issue under paragraph (a)(4)` `a stock corporation` TRUE)
#ASSERT `s 102(d) the provision may be made dependent on facts ascertainable outside the certificate` `the classes, number of shares and par value of shares a corporation other than a nonstock corporation is authorized to issue under paragraph (a)(4)` `a charitable nonstock corporation` TRUE
-- any other provision, if the manner in which the facts operate is clearly and explicitly set forth
#ASSERT `s 102(d) the provision may be made dependent on facts ascertainable outside the certificate` `any other provision of the certificate of incorporation` `a stock corporation` TRUE
#ASSERT NOT (`s 102(d) the provision may be made dependent on facts ascertainable outside the certificate` `any other provision of the certificate of incorporation` `a stock corporation` FALSE)
-- the facts
#ASSERT `s 102(d) the matter is a fact on which a provision may depend` `the occurrence of an event` EQUALS JUST TRUE
#ASSERT `s 102(d) the matter is a fact on which a provision may depend` `a determination by a person or body, including the corporation` EQUALS JUST TRUE
#ASSERT `s 102(d) the matter is a fact on which a provision may depend` `an action by a person or body, including the corporation` EQUALS JUST TRUE
#ASSERT `s 102(d) the matter is a fact on which a provision may depend` `a matter of another kind` EQUALS NOTHING
-- (f): fees and expenses of an internal corporate claim, or of any claim a stockholder has brought
#ASSERT NOT (`s 102(f) the certificate of incorporation may contain the provision` TRUE TRUE FALSE FALSE)
#ASSERT NOT (`s 102(f) the certificate of incorporation may contain the provision` TRUE FALSE TRUE FALSE)
#ASSERT NOT (`s 102(f) the certificate of incorporation may contain the provision` TRUE FALSE FALSE TRUE)
#ASSERT `s 102(f) the certificate of incorporation may contain the provision` TRUE FALSE FALSE FALSE
#ASSERT `s 102(f) the certificate of incorporation may contain the provision` FALSE TRUE TRUE TRUE
