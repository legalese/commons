IMPORT prelude
IMPORT daydate
IMPORT `dg-core`
IMPORT `dg2-support`
IMPORT `dg2-registered-agent`
IMPORT `dg2-registered-agent-changes`

-- Tests of dg2-registered-agent-changes.l4 (8 Del. C. sections 133 to 136). Expected values are written by hand from src:342 to src:359 of
-- de-code-t8-ch1-2026-10-01.txt, beside each assertion, before the run.

§ `Section 133`

#ASSERT `s 133 the corporation may change the location of its registered office` TRUE TRUE
#ASSERT NOT `s 133 the corporation may change the location of its registered office` FALSE TRUE
#ASSERT NOT `s 133 the corporation may change the location of its registered office` TRUE FALSE
#ASSERT `s 133 the corporation may change its registered agent` TRUE TRUE TRUE
#ASSERT NOT `s 133 the corporation may change its registered agent` FALSE TRUE TRUE
#ASSERT NOT `s 133 the corporation may change its registered agent` TRUE FALSE TRUE
#ASSERT NOT `s 133 the corporation may change its registered agent` TRUE TRUE FALSE
#ASSERT `s 133 the corporation must execute, acknowledge and file a certificate certifying the change` TRUE EQUALS JUST TRUE
#ASSERT `s 133 the corporation must execute, acknowledge and file a certificate certifying the change` FALSE EQUALS NOTHING
#ASSERT `s 133 the corporation has done what the Law requires after the resolution` TRUE TRUE
#ASSERT NOT `s 133 the corporation has done what the Law requires after the resolution` TRUE FALSE
#ASSERT NOT `s 133 the corporation has done what the Law requires after the resolution` FALSE TRUE

§ `Section 134`

-- (the person is the registered agent, the new address is in this State, filed a certificate, executed and acknowledged, sets forth the old address,
-- certifies the new address and the given day, the given day, the date as of which the question is asked)
GIVEN a IS A BOOLEAN
      b IS A BOOLEAN
      c IS A BOOLEAN
      d IS A BOOLEAN
      e IS A BOOLEAN
      f IS A BOOLEAN
      g IS A DATE
      h IS A DATE
GIVETH A `s 134(a) Facts about the registered agent's certificate`
`a change of address` a b c d e f g h MEANS `s 134(a) Facts about the registered agent's certificate` WITH
    `the person is the registered agent of the corporation` IS a
    `the new address is in this State` IS b
    `the registered agent filed a certificate with the Secretary of State` IS c
    `the certificate is executed and acknowledged by the registered agent` IS d
    `the certificate sets forth the address at which the agent has maintained the registered office for each of the corporations for which it is a registered agent` IS e
    `the certificate certifies the new address to which each registered office will be changed on a given day, and at which the agent will thereafter maintain the registered office for each corporation` IS f
    `the given day` IS g
    `the date as of which the question is asked` IS h

-- From the given day, 1 May 2026, the registered office is at the new address; before it, or on a defective certificate, the text does not say.
#ASSERT `s 134(a) the registered office of the corporation is located at the new address` (`a change of address` TRUE TRUE TRUE TRUE TRUE TRUE (YearMonthDay 2026 5 1) (YearMonthDay 2026 5 1)) EQUALS JUST TRUE
#ASSERT `s 134(a) the registered office of the corporation is located at the new address` (`a change of address` TRUE TRUE TRUE TRUE TRUE TRUE (YearMonthDay 2026 5 1) (YearMonthDay 2026 6 1)) EQUALS JUST TRUE
#ASSERT `s 134(a) the registered office of the corporation is located at the new address` (`a change of address` TRUE TRUE TRUE TRUE TRUE TRUE (YearMonthDay 2026 5 1) (YearMonthDay 2026 4 30)) EQUALS NOTHING
#ASSERT `s 134(a) the registered office of the corporation is located at the new address` (`a change of address` FALSE TRUE TRUE TRUE TRUE TRUE (YearMonthDay 2026 5 1) (YearMonthDay 2026 6 1)) EQUALS NOTHING
#ASSERT `s 134(a) the registered office of the corporation is located at the new address` (`a change of address` TRUE FALSE TRUE TRUE TRUE TRUE (YearMonthDay 2026 5 1) (YearMonthDay 2026 6 1)) EQUALS NOTHING
#ASSERT `s 134(a) the registered office of the corporation is located at the new address` (`a change of address` TRUE TRUE FALSE TRUE TRUE TRUE (YearMonthDay 2026 5 1) (YearMonthDay 2026 6 1)) EQUALS NOTHING
#ASSERT `s 134(a) the registered office of the corporation is located at the new address` (`a change of address` TRUE TRUE TRUE FALSE TRUE TRUE (YearMonthDay 2026 5 1) (YearMonthDay 2026 6 1)) EQUALS NOTHING
#ASSERT `s 134(a) the registered office of the corporation is located at the new address` (`a change of address` TRUE TRUE TRUE TRUE FALSE TRUE (YearMonthDay 2026 5 1) (YearMonthDay 2026 6 1)) EQUALS NOTHING
#ASSERT `s 134(a) the registered office of the corporation is located at the new address` (`a change of address` TRUE TRUE TRUE TRUE TRUE FALSE (YearMonthDay 2026 5 1) (YearMonthDay 2026 6 1)) EQUALS NOTHING
-- (b)
#ASSERT `s 134(b) the registered agent must file a certificate of the change of name` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 134(b) the registered agent must file a certificate of the change of name` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 134(b) the registered agent must file a certificate of the change of name` FALSE FALSE EQUALS NOTHING
#ASSERT `s 134(b) the certificate of the change of name says what the Law requires` TRUE TRUE TRUE TRUE
#ASSERT NOT `s 134(b) the certificate of the change of name says what the Law requires` FALSE TRUE TRUE TRUE
#ASSERT NOT `s 134(b) the certificate of the change of name says what the Law requires` TRUE FALSE TRUE TRUE
#ASSERT NOT `s 134(b) the certificate of the change of name says what the Law requires` TRUE TRUE FALSE TRUE
#ASSERT NOT `s 134(b) the certificate of the change of name says what the Law requires` TRUE TRUE TRUE FALSE

§ `Section 135`

#ASSERT `s 135 the successor becomes the registered agent of the corporation and its address becomes the address of the corporation's registered office` TRUE TRUE TRUE
#ASSERT NOT `s 135 the successor becomes the registered agent of the corporation and its address becomes the address of the corporation's registered office` FALSE TRUE TRUE
-- A corporation that did not ratify and approve: the successor does not become its agent.
#ASSERT NOT `s 135 the successor becomes the registered agent of the corporation and its address becomes the address of the corporation's registered office` TRUE FALSE TRUE
#ASSERT NOT `s 135 the successor becomes the registered agent of the corporation and its address becomes the address of the corporation's registered office` TRUE TRUE FALSE

§ `Section 136`

#ASSERT `s 136(a) the registered agent may resign without appointing a successor by filing a certificate of resignation` FALSE
#ASSERT `s 136(a) the registered agent may resign without appointing a successor by filing a certificate of resignation` TRUE
-- Filed 15 January 2026: effective 14 February 2026.
#ASSERT `s 136(a) the date the resignation becomes effective` (YearMonthDay 2026 1 15) EQUALS YearMonthDay 2026 2 14

-- (executed and acknowledged, states that written notice was given by mailing or delivering to the last known address, sets forth the date of the notice,
-- the date of the notice, the date the certificate is filed, includes the information last provided under section 132(d), on the Secretary's form)
GIVEN a IS A BOOLEAN
      b IS A BOOLEAN
      c IS A BOOLEAN
      d IS A DATE
      e IS A DATE
      f IS A BOOLEAN
      g IS A BOOLEAN
GIVETH A BOOLEAN
`a resignation certificate in order` a b c d e f g MEANS
    `s 136(a) the certificate of resignation is as the Law requires` a b c d e f g

-- Filed 10 February 2026: notice at least 30 days before is notice given on or before 11 January 2026.
#ASSERT `s 136(a) the certificate of resignation is as the Law requires` TRUE TRUE TRUE (YearMonthDay 2026 1 10) (YearMonthDay 2026 2 10) TRUE TRUE
#ASSERT `s 136(a) the certificate of resignation is as the Law requires` TRUE TRUE TRUE (YearMonthDay 2026 1 11) (YearMonthDay 2026 2 10) TRUE TRUE
#ASSERT NOT `s 136(a) the certificate of resignation is as the Law requires` TRUE TRUE TRUE (YearMonthDay 2026 1 12) (YearMonthDay 2026 2 10) TRUE TRUE
#ASSERT NOT `s 136(a) the certificate of resignation is as the Law requires` FALSE TRUE TRUE (YearMonthDay 2026 1 10) (YearMonthDay 2026 2 10) TRUE TRUE
#ASSERT NOT `s 136(a) the certificate of resignation is as the Law requires` TRUE FALSE TRUE (YearMonthDay 2026 1 10) (YearMonthDay 2026 2 10) TRUE TRUE
#ASSERT NOT `s 136(a) the certificate of resignation is as the Law requires` TRUE TRUE FALSE (YearMonthDay 2026 1 10) (YearMonthDay 2026 2 10) TRUE TRUE
#ASSERT NOT `s 136(a) the certificate of resignation is as the Law requires` TRUE TRUE TRUE (YearMonthDay 2026 1 10) (YearMonthDay 2026 2 10) FALSE TRUE
#ASSERT NOT `s 136(a) the certificate of resignation is as the Law requires` TRUE TRUE TRUE (YearMonthDay 2026 1 10) (YearMonthDay 2026 2 10) TRUE FALSE
#ASSERT NOT `s 136(a) the information regarding the communications contact is deemed public` TRUE
#ASSERT `s 136(b) the corporation must obtain and designate a new registered agent` TRUE EQUALS JUST TRUE
#ASSERT `s 136(b) the corporation must obtain and designate a new registered agent` FALSE EQUALS NOTHING

-- (where the corporation is formed, the date the certificate of resignation was filed, the date a new agent was obtained and designated, the date as of which the question is asked)
GIVEN a IS A `Where an entity is formed`
      b IS A DATE
      c IS A MAYBE DATE
      d IS A DATE
GIVETH A `s 136(b) Facts about the corporation`
`a corporation whose agent resigned` a b c d MEANS `s 136(b) Facts about the corporation` WITH
    `where the corporation is formed` IS a
    `the date the certificate of resignation was filed` IS b
    `the date the corporation obtained and designated a new registered agent` IS c
    `the date as of which the question is asked` IS d

-- Filed 10 February 2026: the last day is 12 March 2026.
#ASSERT `s 136(b) the last day for the corporation to obtain and designate a new registered agent` (`a corporation whose agent resigned` `this State` (YearMonthDay 2026 2 10) NOTHING (YearMonthDay 2026 4 1)) EQUALS YearMonthDay 2026 3 12
#ASSERT `s 136(b) what follows for the corporation` (`a corporation whose agent resigned` `this State` (YearMonthDay 2026 2 10) (JUST (YearMonthDay 2026 3 12)) (YearMonthDay 2026 4 1)) EQUALS JUST `the corporation is not forfeited, because it obtained and designated a new registered agent in time`
#ASSERT `s 136(b) what follows for the corporation` (`a corporation whose agent resigned` `this State` (YearMonthDay 2026 2 10) (JUST (YearMonthDay 2026 3 13)) (YearMonthDay 2026 4 1)) EQUALS JUST `the Secretary of State declares the charter of the domestic corporation forfeited`
#ASSERT `s 136(b) what follows for the corporation` (`a corporation whose agent resigned` `this State` (YearMonthDay 2026 2 10) NOTHING (YearMonthDay 2026 3 12)) EQUALS NOTHING
#ASSERT `s 136(b) what follows for the corporation` (`a corporation whose agent resigned` `this State` (YearMonthDay 2026 2 10) NOTHING (YearMonthDay 2026 3 13)) EQUALS JUST `the Secretary of State declares the charter of the domestic corporation forfeited`
#ASSERT `s 136(b) what follows for the corporation` (`a corporation whose agent resigned` `another jurisdiction of the United States` (YearMonthDay 2026 2 10) NOTHING (YearMonthDay 2026 3 13)) EQUALS JUST `the Secretary of State forfeits the foreign corporation's qualification or authority to do business in this State`
#ASSERT `s 136(b) what follows for the corporation` (`a corporation whose agent resigned` `a foreign jurisdiction outside the United States` (YearMonthDay 2026 2 10) (JUST (YearMonthDay 2026 4 30)) (YearMonthDay 2026 5 1)) EQUALS JUST `the Secretary of State forfeits the foreign corporation's qualification or authority to do business in this State`
#ASSERT `s 136(c) service of legal process against the corporation is upon the Secretary of State` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 136(c) service of legal process against the corporation is upon the Secretary of State` TRUE TRUE EQUALS NOTHING
#ASSERT `s 136(c) service of legal process against the corporation is upon the Secretary of State` FALSE FALSE EQUALS NOTHING
