#ASSERT `s 351 the provision may be inserted in the certificate of incorporation by amendment` FALSE TRUE
#ASSERT NOT (`s 351 the provision may be inserted in the certificate of incorporation by amendment` FALSE FALSE)
-- Deletion: a majority of all outstanding stock, whether or not otherwise entitled to vote.
#ASSERT `s 351 the amendment deleting the provision is adopted` 51 100 EQUALS JUST TRUE
#ASSERT `s 351 the amendment deleting the provision is adopted` 50 100 EQUALS JUST FALSE
#ASSERT `s 351 the stock certificate meets the requirement to note the provision` TRUE TRUE
#ASSERT NOT (`s 351 the stock certificate meets the requirement to note the provision` TRUE FALSE)
#ASSERT `s 351 the stock certificate meets the requirement to note the provision` FALSE FALSE

§ `s 352: custodian`

#ASSERT `s 352(a)(1) the business is deadlocked and the remedies provided have failed` TRUE TRUE TRUE
#ASSERT NOT (`s 352(a)(1) the business is deadlocked and the remedies provided have failed` FALSE TRUE TRUE)
#ASSERT NOT (`s 352(a)(1) the business is deadlocked and the remedies provided have failed` TRUE FALSE TRUE)
#ASSERT NOT (`s 352(a)(1) the business is deadlocked and the remedies provided have failed` TRUE TRUE FALSE)
#ASSERT `s 352(a)(2) the petitioning stockholder has a right to dissolution under a provision permitted by s 355` TRUE
#ASSERT `s 352(a) the appointment the Court of Chancery may make on the application` TRUE TRUE FALSE FALSE EQUALS `1 or more custodians under s 352(a)`
#ASSERT `s 352(a) the appointment the Court of Chancery may make on the application` TRUE FALSE TRUE FALSE EQUALS `1 or more custodians under s 352(a)`
#ASSERT `s 352(a) the appointment the Court of Chancery may make on the application` TRUE TRUE FALSE TRUE EQUALS `1 or more custodians, and, the corporation being insolvent, receivers, under s 352(a)`
#ASSERT `s 352(a) the appointment the Court of Chancery may make on the application` TRUE FALSE FALSE TRUE EQUALS `no appointment under s 352(a)`
#ASSERT `s 352(a) the appointment the Court of Chancery may make on the application` FALSE TRUE TRUE FALSE EQUALS `no appointment under s 352(a)`
#ASSERT `s 352(b) the Court of Chancery may appoint a provisional director in lieu of a custodian` TRUE TRUE
#ASSERT NOT (`s 352(b) the Court of Chancery may appoint a provisional director in lieu of a custodian` TRUE FALSE)
#ASSERT NOT (`s 352(b) the Court of Chancery may appoint a provisional director in lieu of a custodian` FALSE TRUE)
#ASSERT `s 352(b) the appointment of the provisional director precludes a subsequent order appointing a custodian` TRUE EQUALS JUST FALSE
#ASSERT `s 352(b) the appointment of the provisional director precludes a subsequent order appointing a custodian` FALSE EQUALS NOTHING

§ `s 353: provisional director`

#ASSERT `s 353(a) the Court of Chancery may appoint a provisional director` TRUE TRUE TRUE
#ASSERT NOT (`s 353(a) the Court of Chancery may appoint a provisional director` FALSE TRUE TRUE)
#ASSERT NOT (`s 353(a) the Court of Chancery may appoint a provisional director` TRUE FALSE TRUE)
#ASSERT NOT (`s 353(a) the Court of Chancery may appoint a provisional director` TRUE TRUE FALSE)

GIVEN directorsjoin IS A NUMBER
      directors IS A NUMBER
      sharesjoin IS A NUMBER
      shares IS A NUMBER
      multiple IS A BOOLEAN
      classheld IS A NUMBER
      classshares IS A NUMBER
      lesserdirectors IS A MAYBE NUMBER
      lesserholders IS A MAYBE NUMBER
      lesserclass IS A MAYBE NUMBER
GIVETH A `s 353(b) Application for a provisional director`
`dg10 test application` directorsjoin directors sharesjoin shares multiple classheld classshares lesserdirectors lesserholders lesserclass MEANS
    `s 353(b) Application for a provisional director` WITH
        `the number of directors who join in the application` IS directorsjoin
        `the number of directors then in office` IS directors
        `the number of shares held by the stockholders who join in the application` IS sharesjoin
        `the number of shares then entitled to elect directors` IS shares
        `more than 1 class of stock is then entitled to elect directors` IS multiple
        `the number of shares of the class in which the applicants hold the largest proportion that they hold` IS classheld
        `the number of shares of that class` IS classshares
        `the lesser proportion of the directors that the certificate of incorporation allows, if it allows one` IS lesserdirectors
        `the lesser proportion of the stockholders that the certificate of incorporation allows, if it allows one` IS lesserholders
        `the lesser proportion of a class that the certificate of incorporation allows, if it allows one` IS lesserclass

-- (1) at least one half of the directors in office: 2 of 4 is exactly half; 1 of 4 is not.
#ASSERT `s 353(b) the application may be filed` (`dg10 test application` 2 4 0 100 FALSE 0 0 NOTHING NOTHING NOTHING) EQUALS JUST TRUE
#ASSERT `s 353(b) the application may be filed` (`dg10 test application` 1 4 0 100 FALSE 0 0 NOTHING NOTHING NOTHING) EQUALS JUST FALSE
-- (2) at least one third of all stock entitled to elect directors: 33 of 99 is exactly one third; 32 of 99 is not.
#ASSERT `s 353(b) the application may be filed` (`dg10 test application` 0 4 33 99 FALSE 0 0 NOTHING NOTHING NOTHING) EQUALS JUST TRUE
#ASSERT `s 353(b) the application may be filed` (`dg10 test application` 0 4 32 99 FALSE 0 0 NOTHING NOTHING NOTHING) EQUALS JUST FALSE
-- (3) with more than 1 class so entitled, two thirds of the stock of any such class: 20 of 30.
#ASSERT `s 353(b) the application may be filed` (`dg10 test application` 0 4 0 100 TRUE 20 30 NOTHING NOTHING NOTHING) EQUALS JUST TRUE
#ASSERT `s 353(b) the application may be filed` (`dg10 test application` 0 4 0 100 TRUE 19 30 NOTHING NOTHING NOTHING) EQUALS JUST FALSE
-- Limb (3) is open only where more than 1 class is so entitled.
#ASSERT `s 353(b) the application may be filed` (`dg10 test application` 0 4 0 100 FALSE 30 30 NOTHING NOTHING NOTHING) EQUALS JUST FALSE
-- A certificate may provide a lesser proportion: one quarter of the directors lets 1 of 4 apply.
#ASSERT `s 353(b) the application may be filed` (`dg10 test application` 1 4 0 100 FALSE 0 0 (JUST (1 DIVIDED BY 4)) NOTHING NOTHING) EQUALS JUST TRUE
-- A greater proportion in the certificate is not a lesser one and changes nothing.
#ASSERT `s 353(b) the application may be filed` (`dg10 test application` 1 4 0 100 FALSE 0 0 (JUST (3 DIVIDED BY 4)) NOTHING NOTHING) EQUALS JUST FALSE
#ASSERT `s 353(b) the application may be filed` (`dg10 test application` 2 4 0 100 FALSE 0 0 (JUST (3 DIVIDED BY 4)) NOTHING NOTHING) EQUALS JUST TRUE
-- A lesser proportion of the stockholders: one quarter of the stock.
#ASSERT `s 353(b) the application may be filed` (`dg10 test application` 0 4 25 100 FALSE 0 0 NOTHING (JUST (1 DIVIDED BY 4)) NOTHING) EQUALS JUST TRUE
-- A lesser proportion of a class: half.
#ASSERT `s 353(b) the application may be filed` (`dg10 test application` 0 4 0 100 TRUE 15 30 NOTHING NOTHING (JUST (1 DIVIDED BY 2))) EQUALS JUST TRUE
-- No directors in office: limb (1) is not a vote and is not covered, unless another limb is made out.
#ASSERT `s 353(b) the application may be filed` (`dg10 test application` 0 0 0 100 FALSE 0 0 NOTHING NOTHING NOTHING) EQUALS NOTHING
#ASSERT `s 353(b) the application may be filed` (`dg10 test application` 0 0 40 100 FALSE 0 0 NOTHING NOTHING NOTHING) EQUALS JUST TRUE
-- The proportion helper.
#ASSERT `s 353(b) the proportion required to apply` (1 DIVIDED BY 2) NOTHING EQUALS (1 DIVIDED BY 2)
#ASSERT `s 353(b) the proportion required to apply` (1 DIVIDED BY 2) (JUST (1 DIVIDED BY 4)) EQUALS (1 DIVIDED BY 4)
#ASSERT `s 353(b) the proportion required to apply` (1 DIVIDED BY 2) (JUST (3 DIVIDED BY 4)) EQUALS (1 DIVIDED BY 2)
-- Either limb.
#ASSERT `s 353(b) either limb holds` (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 353(b) either limb holds` NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 353(b) either limb holds` NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 353(b) either limb holds` (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 353(b) either limb holds` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
-- (c): who may be appointed.
#ASSERT `s 353(c) the person may be appointed a provisional director` TRUE FALSE FALSE TRUE
#ASSERT NOT (`s 353(c) the person may be appointed a provisional director` FALSE FALSE FALSE TRUE)
#ASSERT NOT (`s 353(c) the person may be appointed a provisional director` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 353(c) the person may be appointed a provisional director` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 353(c) the person may be appointed a provisional director` TRUE FALSE FALSE FALSE)
#ASSERT `s 353(c) the provisional director has the title and powers of a custodian or receiver` TRUE EQUALS JUST FALSE
#ASSERT `s 353(c) the provisional director has the title and powers of a custodian or receiver` FALSE EQUALS NOTHING
#ASSERT `s 353(c) the provisional director has all the rights and powers of a duly elected director, including notice of and a vote at meetings of directors` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 353(c) the provisional director has all the rights and powers of a duly elected director, including notice of and a vote at meetings of directors` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 353(c) the provisional director has all the rights and powers of a duly elected director, including notice of and a vote at meetings of directors` FALSE FALSE EQUALS NOTHING
-- Removal: by order of the Court; by a majority of the votes of all shares entitled to elect directors (51 of 100);
-- or by two thirds of the class that filed the application (20 of 30).
#ASSERT `s 353(c) the provisional director is removed` TRUE 0 100 FALSE 0 30 EQUALS JUST TRUE
#ASSERT `s 353(c) the provisional director is removed` FALSE 51 100 FALSE 0 30 EQUALS JUST TRUE
#ASSERT `s 353(c) the provisional director is removed` FALSE 50 100 FALSE 0 30 EQUALS JUST FALSE
#ASSERT `s 353(c) the provisional director is removed` FALSE 0 100 TRUE 20 30 EQUALS JUST TRUE
#ASSERT `s 353(c) the provisional director is removed` FALSE 0 100 TRUE 19 30 EQUALS JUST FALSE
-- The class limb is open only if a class filed the application.
#ASSERT `s 353(c) the provisional director is removed` FALSE 0 100 FALSE 30 30 EQUALS JUST FALSE
-- Counts that are not a vote are not covered.
#ASSERT `s 353(c) the provisional director is removed` FALSE 0 0 FALSE 0 0 EQUALS NOTHING
-- Compensation.
#ASSERT `s 353(c) the provisional director's compensation is determined` TRUE TRUE EQUALS `by the agreement between the provisional director and the corporation, approved by the Court of Chancery under s 353(c)`
#ASSERT `s 353(c) the provisional director's compensation is determined` TRUE FALSE EQUALS `by the agreement between the provisional director and the corporation, which the Court of Chancery has not yet approved under s 353(c)`
#ASSERT `s 353(c) the provisional director's compensation is determined` FALSE FALSE EQUALS `as the Court of Chancery may fix it under s 353(c), there being no agreement or the parties disagreeing`
-- (d) and the whole.
#ASSERT `s 353(d) the Court of Chancery may appoint a provisional director although the requirements of subsection (b) are not satisfied` TRUE
#ASSERT NOT (`s 353(d) the Court of Chancery may appoint a provisional director although the requirements of subsection (b) are not satisfied` FALSE)
#ASSERT `s 353 the Court of Chancery may appoint a provisional director on the application` TRUE (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 353 the Court of Chancery may appoint a provisional director on the application` TRUE (JUST FALSE) TRUE EQUALS JUST TRUE
#ASSERT `s 353 the Court of Chancery may appoint a provisional director on the application` TRUE (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 353 the Court of Chancery may appoint a provisional director on the application` TRUE NOTHING TRUE EQUALS JUST TRUE
#ASSERT `s 353 the Court of Chancery may appoint a provisional director on the application` TRUE NOTHING FALSE EQUALS NOTHING
#ASSERT `s 353 the Court of Chancery may appoint a provisional director on the application` FALSE (JUST TRUE) TRUE EQUALS JUST FALSE

§ `s 354: operating corporation as partnership`

#ASSERT `s 354 the instrument is invalid on the ground that it treats the corporation as a partnership` `a written agreement among stockholders of a close corporation under s 354` TRUE EQUALS JUST FALSE
#ASSERT `s 354 the instrument is invalid on the ground that it treats the corporation as a partnership` `a provision of the certificate of incorporation of a close corporation under s 354` TRUE EQUALS JUST FALSE
#ASSERT `s 354 the instrument is invalid on the ground that it treats the corporation as a partnership` `a provision of the bylaws of a close corporation under s 354` TRUE EQUALS JUST FALSE
#ASSERT `s 354 the instrument is invalid on the ground that it treats the corporation as a partnership` `a provision of the bylaws of a close corporation under s 354` FALSE EQUALS NOTHING
#ASSERT `s 354 the instrument is invalid on the ground that it treats the corporation as a partnership` `an instrument that s 354 does not name` TRUE EQUALS NOTHING

§ `s 355: the stockholders' option to dissolve`

#ASSERT `s 355(c) the stock certificate meets the requirement to note the provision` TRUE TRUE
#ASSERT NOT (`s 355(c) the stock certificate meets the requirement to note the provision` TRUE FALSE)
#ASSERT `s 355(c) the stock certificate meets the requirement to note the provision` FALSE FALSE
#ASSERT `s 355(c) the provision is effective as to the holder of the stock certificate` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 355(c) the provision is effective as to the holder of the stock certificate` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 355(c) the provision is effective as to the holder of the stock certificate` FALSE TRUE EQUALS NOTHING
#ASSERT `s 355(a) the option to have the corporation dissolved may be exercised` TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 355(a) the option to have the corporation dissolved may be exercised` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`s 355(a) the option to have the corporation dissolved may be exercised` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 355(a) the option to have the corporation dissolved may be exercised` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 355(a) the option to have the corporation dissolved may be exercised` TRUE TRUE TRUE FALSE)
#ASSERT `s 355(a) the notice of the exercise of the option meets the subsection` TRUE TRUE
#ASSERT NOT (`s 355(a) the notice of the exercise of the option meets the subsection` TRUE FALSE)
#ASSERT NOT (`s 355(a) the notice of the exercise of the option meets the subsection` FALSE TRUE)
-- Notice sent 1 March 2027: the 30 days following end on 31 March; the dissolution proceeds from 1 April.
#ASSERT `s 355(a) the first day on which the dissolution proceeds` (YMD 2027 3 1) EQUALS (YMD 2027 4 1)
#ASSERT `s 355(a) the first day on which the dissolution proceeds` (YMD 2027 12 5) EQUALS (YMD 2028 1 5)
#ASSERT `s 355(a) the dissolution proceeds as if the required stockholders had consented in writing under s 228` TRUE TRUE (YMD 2027 3 1) (YMD 2027 4 1)
#ASSERT NOT (`s 355(a) the dissolution proceeds as if the required stockholders had consented in writing under s 228` TRUE TRUE (YMD 2027 3 1) (YMD 2027 3 31))
#ASSERT NOT (`s 355(a) the dissolution proceeds as if the required stockholders had consented in writing under s 228` FALSE TRUE (YMD 2027 3 1) (YMD 2027 4 1))
#ASSERT NOT (`s 355(a) the dissolution proceeds as if the required stockholders had consented in writing under s 228` TRUE FALSE (YMD 2027 3 1) (YMD 2027 4 1))
-- (b): all the outstanding stock, unless the certificate authorizes not less than 2/3.
#ASSERT `s 355(b) the proportion of all the outstanding stock required to adopt the amendment` NOTHING EQUALS 1
#ASSERT `s 355(b) the proportion of all the outstanding stock required to adopt the amendment` (JUST (2 DIVIDED BY 3)) EQUALS (2 DIVIDED BY 3)
#ASSERT `s 355(b) the proportion of all the outstanding stock required to adopt the amendment` (JUST (3 DIVIDED BY 4)) EQUALS (3 DIVIDED BY 4)
-- A figure under 2/3 is not an authorization the section allows: all the stock must vote for it.
#ASSERT `s 355(b) the proportion of all the outstanding stock required to adopt the amendment` (JUST (1 DIVIDED BY 2)) EQUALS 1
#ASSERT `s 355(b) the amendment adding the option to dissolve is adopted` TRUE NOTHING 100 100 EQUALS JUST TRUE
#ASSERT `s 355(b) the amendment adding the option to dissolve is adopted` TRUE NOTHING 99 100 EQUALS JUST FALSE
#ASSERT `s 355(b) the amendment adding the option to dissolve is adopted` TRUE (JUST (2 DIVIDED BY 3)) 67 100 EQUALS JUST TRUE
#ASSERT `s 355(b) the amendment adding the option to dissolve is adopted` TRUE (JUST (2 DIVIDED BY 3)) 66 100 EQUALS JUST FALSE
#ASSERT `s 355(b) the amendment adding the option to dissolve is adopted` TRUE (JUST (2 DIVIDED BY 3)) 200 300 EQUALS JUST TRUE
-- The original certificate already contained the provision: subsection (b) is not in point.
#ASSERT `s 355(b) the amendment adding the option to dissolve is adopted` FALSE NOTHING 100 100 EQUALS NOTHING

