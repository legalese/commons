IMPORT prelude
IMPORT daydate
IMPORT `dg-core`
IMPORT `dg10-close-status`
IMPORT `dg10-close-governance`

-- Tests of dg10-close-status.l4 and dg10-close-governance.l4 (ss 341-356).
-- Every expected value is written by hand from the text (src:1682-1780) beside the assertion, before the run.

§ `Fixtures`

GIVEN organized IS A BOOLEAN
      s102 IS A BOOLEAN
      certificated IS A BOOLEAN
      holders IS A BOOLEAN
      specified IS A NUMBER
      restricted IS A BOOLEAN
      nooffer IS A BOOLEAN
GIVETH A `s 342(a) Certificate of incorporation of a corporation`
`dg10 test certificate` organized s102 certificated holders specified restricted nooffer MEANS
    `s 342(a) Certificate of incorporation of a corporation` WITH
        `the corporation is organized under this chapter` IS organized
        `the certificate contains the provisions required by s 102` IS s102
        `the certificate provides that all the issued stock of all classes, exclusive of treasury shares, is represented by certificates` IS certificated
        `the certificate provides that the issued stock is held of record by not more than a specified number of persons` IS holders
        `the number of persons the certificate specifies` IS specified
        `the certificate provides that all the issued stock of all classes is subject to 1 or more of the restrictions on transfer permitted by s 202` IS restricted
        `the certificate provides that the corporation will make no offering of its stock that would constitute a public offering within the meaning of the Securities Act of 1933` IS nooffer

§ `s 341: law applicable`

#ASSERT `s 341(a) the law that governs the corporation` TRUE EQUALS `this chapter, including this subchapter, under s 341(a)`
#ASSERT `s 341(a) the law that governs the corporation` FALSE EQUALS `this chapter, except this subchapter, under s 341(a)`
#ASSERT `s 341(b) this chapter is applicable to the close corporation on the point` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 341(b) this chapter is applicable to the close corporation on the point` TRUE TRUE EQUALS JUST FALSE
-- Not a close corporation: outside subsection (b), not covered.
#ASSERT `s 341(b) this chapter is applicable to the close corporation on the point` FALSE FALSE EQUALS NOTHING

§ `s 342: close corporation defined`

-- A certificate with every provision and a specified number of 30 makes a close corporation.
#ASSERT `s 342(a) the corporation is a close corporation` (`dg10 test certificate` TRUE TRUE TRUE TRUE 30 TRUE TRUE)
#ASSERT `s 342(a) the corporation is a close corporation` (`dg10 test certificate` TRUE TRUE TRUE TRUE 1 TRUE TRUE)
-- "not exceeding 30": 31 is too many.
#ASSERT NOT (`s 342(a) the corporation is a close corporation` (`dg10 test certificate` TRUE TRUE TRUE TRUE 31 TRUE TRUE))
#ASSERT NOT (`s 342(a)(1) the certificate provides for certificated stock held of record by a specified number of persons not exceeding 30` (`dg10 test certificate` TRUE TRUE TRUE TRUE 31 TRUE TRUE))
#ASSERT `s 342(a)(1) the certificate provides for certificated stock held of record by a specified number of persons not exceeding 30` (`dg10 test certificate` TRUE TRUE TRUE TRUE 30 TRUE TRUE)
-- Each other element is required.
#ASSERT NOT (`s 342(a) the corporation is a close corporation` (`dg10 test certificate` FALSE TRUE TRUE TRUE 30 TRUE TRUE))
#ASSERT NOT (`s 342(a) the corporation is a close corporation` (`dg10 test certificate` TRUE FALSE TRUE TRUE 30 TRUE TRUE))
#ASSERT NOT (`s 342(a) the corporation is a close corporation` (`dg10 test certificate` TRUE TRUE FALSE TRUE 30 TRUE TRUE))
#ASSERT NOT (`s 342(a) the corporation is a close corporation` (`dg10 test certificate` TRUE TRUE TRUE FALSE 30 TRUE TRUE))
#ASSERT NOT (`s 342(a) the corporation is a close corporation` (`dg10 test certificate` TRUE TRUE TRUE TRUE 30 FALSE TRUE))
#ASSERT NOT (`s 342(a) the corporation is a close corporation` (`dg10 test certificate` TRUE TRUE TRUE TRUE 30 TRUE FALSE))
#ASSERT `s 342(a)(2) the certificate subjects all the issued stock to restrictions on transfer permitted by s 202` (`dg10 test certificate` TRUE TRUE TRUE TRUE 30 TRUE TRUE)
#ASSERT NOT (`s 342(a)(2) the certificate subjects all the issued stock to restrictions on transfer permitted by s 202` (`dg10 test certificate` TRUE TRUE TRUE TRUE 30 FALSE TRUE))
#ASSERT `s 342(a)(3) the certificate provides for no public offering of the stock` (`dg10 test certificate` TRUE TRUE TRUE TRUE 30 TRUE TRUE)
#ASSERT NOT (`s 342(a)(3) the certificate provides for no public offering of the stock` (`dg10 test certificate` TRUE TRUE TRUE TRUE 30 TRUE FALSE))
-- (b): qualifications of stockholders.
#ASSERT `s 342(b) the person is entitled under the certificate to be a holder of record of the stock` FALSE FALSE FALSE FALSE
#ASSERT `s 342(b) the person is entitled under the certificate to be a holder of record of the stock` TRUE TRUE FALSE FALSE
#ASSERT NOT (`s 342(b) the person is entitled under the certificate to be a holder of record of the stock` TRUE FALSE FALSE FALSE)
#ASSERT NOT (`s 342(b) the person is entitled under the certificate to be a holder of record of the stock` FALSE FALSE TRUE TRUE)
#ASSERT `s 342(b) the person is entitled under the certificate to be a holder of record of the stock` FALSE FALSE TRUE FALSE
#ASSERT `s 342(b) the person is entitled under the certificate to be a holder of record of the stock` TRUE TRUE TRUE FALSE
#ASSERT NOT (`s 342(b) the person is entitled under the certificate to be a holder of record of the stock` TRUE TRUE TRUE TRUE)
-- (c): each joint or common tenancy, or tenancy by the entireties, counts as one holder.
#ASSERT `s 342(c) the number of holders of record of the stock` 25 3 EQUALS 28
#ASSERT `s 342(a)(1) the stock is held of record by more persons than the certificate specifies` 31 30
#ASSERT NOT (`s 342(a)(1) the stock is held of record by more persons than the certificate specifies` 30 30)

§ `s 343: formation`

#ASSERT `s 343 the close corporation is formed` TRUE TRUE (`dg10 test certificate` TRUE TRUE TRUE TRUE 30 TRUE TRUE)
#ASSERT NOT (`s 343 the close corporation is formed` FALSE TRUE (`dg10 test certificate` TRUE TRUE TRUE TRUE 30 TRUE TRUE))
#ASSERT NOT (`s 343 the close corporation is formed` TRUE FALSE (`dg10 test certificate` TRUE TRUE TRUE TRUE 30 TRUE TRUE))
#ASSERT NOT (`s 343 the close corporation is formed` TRUE TRUE (`dg10 test certificate` TRUE TRUE TRUE TRUE 31 TRUE TRUE))
#ASSERT `s 343(1) the certificate of incorporation has the heading the paragraph requires` TRUE
#ASSERT `s 343(2) the certificate of incorporation contains the provisions required by s 342` (`dg10 test certificate` TRUE TRUE TRUE TRUE 30 TRUE TRUE)

§ `s 344: election by an existing corporation`

-- At least 2/3 of the outstanding shares of each class: 200 of 300 is exactly 2/3.
`dg10 test class vote 344` MEANS `s 344 Class vote` WITH
    `the number of shares of the class that are outstanding, for the s 344 vote` IS 300
    `the number of those shares held of record by the holders who approved, for the s 344 vote` IS 200
`dg10 test class vote 344 short` MEANS `s 344 Class vote` WITH
    `the number of shares of the class that are outstanding, for the s 344 vote` IS 300
    `the number of those shares held of record by the holders who approved, for the s 344 vote` IS 199
`dg10 test class vote 344 empty class` MEANS `s 344 Class vote` WITH
    `the number of shares of the class that are outstanding, for the s 344 vote` IS 0
    `the number of those shares held of record by the holders who approved, for the s 344 vote` IS 0

GIVETH A LIST OF `s 344 Class vote`
`dg10 test no classes 344` MEANS EMPTY

GIVETH A LIST OF `s 346 Class vote`
`dg10 test no classes 346` MEANS EMPTY

#ASSERT `s 344 the holders of at least 2/3 of the shares of the class approved` `dg10 test class vote 344` EQUALS JUST TRUE
#ASSERT `s 344 the holders of at least 2/3 of the shares of the class approved` `dg10 test class vote 344 short` EQUALS JUST FALSE
-- A class with no outstanding shares cannot be a vote: not covered.
#ASSERT `s 344 the holders of at least 2/3 of the shares of the class approved` `dg10 test class vote 344 empty class` EQUALS NOTHING
#ASSERT `s 344 the holders of at least 2/3 of the shares of each class approved` (LIST `dg10 test class vote 344`, `dg10 test class vote 344`) EQUALS JUST TRUE
-- Every class must approve.
#ASSERT `s 344 the holders of at least 2/3 of the shares of each class approved` (LIST `dg10 test class vote 344`, `dg10 test class vote 344 short`) EQUALS JUST FALSE
#ASSERT `s 344 the holders of at least 2/3 of the shares of each class approved` (LIST `dg10 test class vote 344 short`, `dg10 test class vote 344`) EQUALS JUST FALSE
-- A class that is not covered leaves the whole not covered, unless another class plainly failed.
#ASSERT `s 344 the holders of at least 2/3 of the shares of each class approved` (LIST `dg10 test class vote 344`, `dg10 test class vote 344 empty class`) EQUALS NOTHING
#ASSERT `s 344 the holders of at least 2/3 of the shares of each class approved` (LIST `dg10 test class vote 344 empty class`, `dg10 test class vote 344 short`) EQUALS JUST FALSE
#ASSERT `s 344 the holders of at least 2/3 of the shares of each class approved` (LIST `dg10 test class vote 344 short`, `dg10 test class vote 344 empty class`) EQUALS JUST FALSE
#ASSERT `s 344 the holders of at least 2/3 of the shares of each class approved` (LIST `dg10 test class vote 344 empty class`, `dg10 test class vote 344`) EQUALS NOTHING
-- No class at all: not covered.
#ASSERT `s 344 the holders of at least 2/3 of the shares of each class approved` `dg10 test no classes 344` EQUALS NOTHING

GIVEN organized IS A BOOLEAN
      statement IS A BOOLEAN
      provisions IS A BOOLEAN
      heading IS A BOOLEAN
      filed IS A BOOLEAN
      adopted IS A BOOLEAN
GIVETH A `s 344 Election to become a close corporation`
`dg10 test election` organized statement provisions heading filed adopted MEANS
    `s 344 Election to become a close corporation` WITH
        `the corporation is organized under this chapter` IS organized
        `the certificate of amendment contains a statement that the corporation elects to become a close corporation` IS statement
        `the certificate of amendment contains the provisions required by s 342 to appear in the certificate of a close corporation` IS provisions
        `the certificate of amendment contains a heading stating the name of the corporation and that it is a close corporation` IS heading
        `the certificate of amendment was executed, acknowledged and filed in accordance with s 103` IS filed
        `the amendment was adopted in accordance with the requirements of s 241 or s 242` IS adopted

#ASSERT `s 344 the corporation has become a close corporation by election` (`dg10 test election` TRUE TRUE TRUE TRUE TRUE TRUE) (LIST `dg10 test class vote 344`) EQUALS JUST TRUE
#ASSERT `s 344 the corporation has become a close corporation by election` (`dg10 test election` TRUE TRUE TRUE TRUE TRUE TRUE) (LIST `dg10 test class vote 344 short`) EQUALS JUST FALSE
#ASSERT `s 344 the corporation has become a close corporation by election` (`dg10 test election` TRUE TRUE TRUE TRUE TRUE TRUE) (LIST `dg10 test class vote 344 empty class`) EQUALS NOTHING
-- Anything else missing: not a close corporation, whatever the vote.
#ASSERT `s 344 the corporation has become a close corporation by election` (`dg10 test election` FALSE TRUE TRUE TRUE TRUE TRUE) (LIST `dg10 test class vote 344`) EQUALS JUST FALSE
#ASSERT `s 344 the corporation has become a close corporation by election` (`dg10 test election` TRUE FALSE TRUE TRUE TRUE TRUE) (LIST `dg10 test class vote 344`) EQUALS JUST FALSE
#ASSERT `s 344 the corporation has become a close corporation by election` (`dg10 test election` TRUE TRUE FALSE TRUE TRUE TRUE) (LIST `dg10 test class vote 344`) EQUALS JUST FALSE
#ASSERT `s 344 the corporation has become a close corporation by election` (`dg10 test election` TRUE TRUE TRUE FALSE TRUE TRUE) (LIST `dg10 test class vote 344`) EQUALS JUST FALSE
#ASSERT `s 344 the corporation has become a close corporation by election` (`dg10 test election` TRUE TRUE TRUE TRUE FALSE TRUE) (LIST `dg10 test class vote 344`) EQUALS JUST FALSE
#ASSERT `s 344 the corporation has become a close corporation by election` (`dg10 test election` TRUE TRUE TRUE TRUE TRUE FALSE) (LIST `dg10 test class vote 344`) EQUALS JUST FALSE

§ `s 345: continuation`

#ASSERT `s 345 the corporation continues to be a close corporation` TRUE FALSE FALSE FALSE
-- Deleting the s 342 provisions ends it.
#ASSERT NOT (`s 345 the corporation continues to be a close corporation` TRUE TRUE FALSE FALSE)
-- A breach ends it unless the s 348 steps are taken.
#ASSERT NOT (`s 345 the corporation continues to be a close corporation` TRUE FALSE TRUE FALSE)
#ASSERT `s 345 the corporation continues to be a close corporation` TRUE FALSE TRUE TRUE
-- Not a close corporation to begin with.
#ASSERT NOT (`s 345 the corporation continues to be a close corporation` FALSE FALSE FALSE FALSE)

§ `s 346: voluntary termination`

#ASSERT `s 346(b) the proportion of the class required to terminate close corporation status` NOTHING EQUALS (2 DIVIDED BY 3)
#ASSERT `s 346(b) the proportion of the class required to terminate close corporation status` (JUST (3 DIVIDED BY 4)) EQUALS (3 DIVIDED BY 4)
-- A vote of all shares of a class.
#ASSERT `s 346(b) the proportion of the class required to terminate close corporation status` (JUST 1) EQUALS 1
-- A figure below 2/3 is not a greater vote.
#ASSERT `s 346(b) the proportion of the class required to terminate close corporation status` (JUST (1 DIVIDED BY 2)) EQUALS (2 DIVIDED BY 3)
#ASSERT `s 346(b) the proportion of the class required to terminate close corporation status` (JUST (2 DIVIDED BY 3)) EQUALS (2 DIVIDED BY 3)
-- The same vote is needed to amend, repeal or modify the greater-vote provision.
#ASSERT `s 346(b) the proportion of the class required to amend, repeal or modify the greater-vote provision` (JUST (3 DIVIDED BY 4)) EQUALS (3 DIVIDED BY 4)
#ASSERT `s 346(b) the proportion of the class required to amend, repeal or modify the greater-vote provision` NOTHING EQUALS (2 DIVIDED BY 3)

GIVEN outstanding IS A NUMBER
      approved IS A NUMBER
      greater IS A MAYBE NUMBER
GIVETH A `s 346 Class vote`
`dg10 test class vote 346` outstanding approved greater MEANS
    `s 346 Class vote` WITH
        `the number of shares of the class that are outstanding, for the s 346 vote` IS outstanding
        `the number of those shares held of record by the holders who approved, for the s 346 vote` IS approved
        `the greater proportion of the class that the certificate of incorporation requires, if it requires one` IS greater

#ASSERT `s 346(a) the holders of the required proportion of the shares of the class approved the amendment` (`dg10 test class vote 346` 300 200 NOTHING) EQUALS JUST TRUE
#ASSERT `s 346(a) the holders of the required proportion of the shares of the class approved the amendment` (`dg10 test class vote 346` 300 199 NOTHING) EQUALS JUST FALSE
-- A certificate requiring 3/4: 225 of 300 is exactly 3/4.
#ASSERT `s 346(a) the holders of the required proportion of the shares of the class approved the amendment` (`dg10 test class vote 346` 300 225 (JUST (3 DIVIDED BY 4))) EQUALS JUST TRUE
#ASSERT `s 346(a) the holders of the required proportion of the shares of the class approved the amendment` (`dg10 test class vote 346` 300 224 (JUST (3 DIVIDED BY 4))) EQUALS JUST FALSE
-- A certificate requiring all the shares of the class.
#ASSERT `s 346(a) the holders of the required proportion of the shares of the class approved the amendment` (`dg10 test class vote 346` 300 300 (JUST 1)) EQUALS JUST TRUE
#ASSERT `s 346(a) the holders of the required proportion of the shares of the class approved the amendment` (`dg10 test class vote 346` 300 299 (JUST 1)) EQUALS JUST FALSE
#ASSERT `s 346(a) the holders of the required proportion of the shares of the class approved the amendment` (`dg10 test class vote 346` 0 0 NOTHING) EQUALS NOTHING
-- The amendment must also be adopted and become effective under s 242.
#ASSERT `s 346(a) the corporation has voluntarily terminated its close corporation status` (LIST `dg10 test class vote 346` 300 200 NOTHING) TRUE EQUALS JUST TRUE
#ASSERT `s 346(a) the corporation has voluntarily terminated its close corporation status` (LIST `dg10 test class vote 346` 300 200 NOTHING) FALSE EQUALS JUST FALSE
#ASSERT `s 346(a) the corporation has voluntarily terminated its close corporation status` (LIST `dg10 test class vote 346` 300 200 NOTHING, `dg10 test class vote 346` 300 224 (JUST (3 DIVIDED BY 4))) TRUE EQUALS JUST FALSE
#ASSERT `s 346(a) the corporation has voluntarily terminated its close corporation status` `dg10 test no classes 346` TRUE EQUALS NOTHING

§ `s 347: issuance or transfer in breach`

#ASSERT `s 347(a) the transferee is conclusively presumed to have notice of the transferee's ineligibility` TRUE TRUE
#ASSERT NOT (`s 347(a) the transferee is conclusively presumed to have notice of the transferee's ineligibility` FALSE TRUE)
#ASSERT NOT (`s 347(a) the transferee is conclusively presumed to have notice of the transferee's ineligibility` TRUE FALSE)
-- (b): the certificate states 30; a transfer would put the stock in 31 hands.
#ASSERT `s 347(b) the transferee is conclusively presumed to have notice that the stock would be held by more than the stated number of persons` TRUE 30 TRUE 31
#ASSERT NOT (`s 347(b) the transferee is conclusively presumed to have notice that the stock would be held by more than the stated number of persons` TRUE 30 TRUE 30)
#ASSERT NOT (`s 347(b) the transferee is conclusively presumed to have notice that the stock would be held by more than the stated number of persons` TRUE 30 FALSE 31)
#ASSERT NOT (`s 347(b) the transferee is conclusively presumed to have notice that the stock would be held by more than the stated number of persons` FALSE 30 TRUE 31)
-- A stated number in excess of 30 is outside the paragraph.
#ASSERT NOT (`s 347(b) the transferee is conclusively presumed to have notice that the stock would be held by more than the stated number of persons` TRUE 31 TRUE 32)
#ASSERT `s 347(b) the transferee is conclusively presumed to have notice that the stock would be held by more than the stated number of persons` TRUE 10 TRUE 11
-- (c)
#ASSERT `s 347(c) the transferee is conclusively presumed to have notice that the stock was acquired in violation of the restriction` TRUE TRUE TRUE
#ASSERT NOT (`s 347(c) the transferee is conclusively presumed to have notice that the stock was acquired in violation of the restriction` FALSE TRUE TRUE)
#ASSERT NOT (`s 347(c) the transferee is conclusively presumed to have notice that the stock was acquired in violation of the restriction` TRUE FALSE TRUE)
#ASSERT NOT (`s 347(c) the transferee is conclusively presumed to have notice that the stock was acquired in violation of the restriction` TRUE TRUE FALSE)
-- (e), then (d)
#ASSERT `s 347(e) subsection (d) does not apply` TRUE FALSE
#ASSERT `s 347(e) subsection (d) does not apply` FALSE TRUE
#ASSERT NOT (`s 347(e) subsection (d) does not apply` FALSE FALSE)
#ASSERT `s 347(d) the corporation may refuse to register the transfer of the stock into the name of the transferee` TRUE FALSE FALSE FALSE
#ASSERT `s 347(d) the corporation may refuse to register the transfer of the stock into the name of the transferee` FALSE TRUE FALSE FALSE
#ASSERT `s 347(d) the corporation may refuse to register the transfer of the stock into the name of the transferee` FALSE FALSE TRUE FALSE
#ASSERT NOT (`s 347(d) the corporation may refuse to register the transfer of the stock into the name of the transferee` FALSE FALSE FALSE FALSE)
-- All the stockholders consented, or the certificate was amended under s 346: subsection (d) does not apply.
#ASSERT NOT (`s 347(d) the corporation may refuse to register the transfer of the stock into the name of the transferee` TRUE TRUE TRUE TRUE)
-- (f), (g)
#ASSERT `s 347(f) the issuance or transfer, whether or not for value, is a transfer for the purposes of s 347` TRUE
#ASSERT NOT (`s 347(f) the issuance or transfer, whether or not for value, is a transfer for the purposes of s 347` FALSE)
#ASSERT `s 347(g) the section impairs the transferee's right to rescind the transaction or to recover under a warranty` TRUE EQUALS JUST FALSE
#ASSERT `s 347(g) the section impairs the transferee's right to rescind the transaction or to recover under a warranty` FALSE EQUALS NOTHING

§ `s 348: involuntary termination`

-- Event 1 March 2027, discovered 15 March 2027: 30 days after the event is 31 March, after discovery 14 April.
#ASSERT `s 348(a)(1) the later of 30 days after the event and 30 days after its discovery` (YMD 2027 3 1) (YMD 2027 3 15) EQUALS (YMD 2027 4 14)
-- Discovered the same day: both limbs agree.
#ASSERT `s 348(a)(1) the later of 30 days after the event and 30 days after its discovery` (YMD 2027 3 1) (YMD 2027 3 1) EQUALS (YMD 2027 3 31)
-- February 2027 has 28 days: 1 February + 30 is 3 March; 10 February + 30 is 12 March.
#ASSERT `s 348(a)(1) the later of 30 days after the event and 30 days after its discovery` (YMD 2027 2 1) (YMD 2027 2 10) EQUALS (YMD 2027 3 12)
#ASSERT `s 348(a)(1) the last day for the corporation to file the certificate` (YMD 2027 3 1) (JUST (YMD 2027 3 15)) EQUALS JUST (YMD 2027 4 14)
-- Not yet discovered: not covered.
#ASSERT `s 348(a)(1) the last day for the corporation to file the certificate` (YMD 2027 3 1) NOTHING EQUALS NOTHING

GIVEN occurred IS A DATE
      discovered IS A MAYBE DATE
      filed IS A DATE
      states IS A BOOLEAN
      executed IS A BOOLEAN
      copy IS A BOOLEAN
      corrected IS A BOOLEAN
GIVETH A `s 348(a) Steps taken after a breach`
`dg10 test steps 348` occurred discovered filed states executed copy corrected MEANS
    `s 348(a) Steps taken after a breach` WITH
        `the date the event occurred` IS occurred
        `the date the event was discovered, if it has been discovered` IS discovered
        `the date the certificate was filed with the Secretary of State` IS filed
        `the certificate states that a specified provision or condition has ceased to be applicable` IS states
        `the certificate was executed and acknowledged in accordance with s 103` IS executed
        `a copy of the certificate was furnished to each stockholder` IS copy
        `the corporation took the steps necessary to correct the situation on the date the certificate was filed` IS corrected

-- Filed on the last day, 14 April: in time (fork F1). Filed 15 April: late.
#ASSERT `s 348(a)(1) the corporation filed the certificate in time and furnished a copy to each stockholder` (`dg10 test steps 348` (YMD 2027 3 1) (JUST (YMD 2027 3 15)) (YMD 2027 4 14) TRUE TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT `s 348(a)(1) the corporation filed the certificate in time and furnished a copy to each stockholder` (`dg10 test steps 348` (YMD 2027 3 1) (JUST (YMD 2027 3 15)) (YMD 2027 4 15) TRUE TRUE TRUE TRUE) EQUALS JUST FALSE
-- Filed 31 March: within 30 days of the event itself, and so in time.
#ASSERT `s 348(a)(1) the corporation filed the certificate in time and furnished a copy to each stockholder` (`dg10 test steps 348` (YMD 2027 3 1) (JUST (YMD 2027 3 15)) (YMD 2027 3 31) TRUE TRUE TRUE TRUE) EQUALS JUST TRUE
-- No copy to each stockholder, no statement, or not executed and acknowledged: not in order.
#ASSERT `s 348(a)(1) the corporation filed the certificate in time and furnished a copy to each stockholder` (`dg10 test steps 348` (YMD 2027 3 1) (JUST (YMD 2027 3 15)) (YMD 2027 4 14) TRUE TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT `s 348(a)(1) the corporation filed the certificate in time and furnished a copy to each stockholder` (`dg10 test steps 348` (YMD 2027 3 1) (JUST (YMD 2027 3 15)) (YMD 2027 4 14) FALSE TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT `s 348(a)(1) the corporation filed the certificate in time and furnished a copy to each stockholder` (`dg10 test steps 348` (YMD 2027 3 1) (JUST (YMD 2027 3 15)) (YMD 2027 4 14) TRUE FALSE TRUE TRUE) EQUALS JUST FALSE
-- Not yet discovered: the time limit cannot be applied.
#ASSERT `s 348(a)(1) the corporation filed the certificate in time and furnished a copy to each stockholder` (`dg10 test steps 348` (YMD 2027 3 1) NOTHING (YMD 2027 4 14) TRUE TRUE TRUE TRUE) EQUALS NOTHING
#ASSERT `s 348(a)(1) the corporation filed the certificate in time and furnished a copy to each stockholder` (`dg10 test steps 348` (YMD 2027 3 1) NOTHING (YMD 2027 4 14) TRUE TRUE FALSE TRUE) EQUALS JUST FALSE
-- (a): the status survives only if (1) and (2).
#ASSERT `s 348(a) the corporation's status as a close corporation survives the breach` (`dg10 test steps 348` (YMD 2027 3 1) (JUST (YMD 2027 3 15)) (YMD 2027 4 14) TRUE TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT `s 348(a) the corporation's status as a close corporation survives the breach` (`dg10 test steps 348` (YMD 2027 3 1) (JUST (YMD 2027 3 15)) (YMD 2027 4 14) TRUE TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT `s 348(a) the corporation's status as a close corporation survives the breach` (`dg10 test steps 348` (YMD 2027 3 1) (JUST (YMD 2027 3 15)) (YMD 2027 4 15) TRUE TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT `s 348(a) the corporation's status as a close corporation survives the breach` (`dg10 test steps 348` (YMD 2027 3 1) NOTHING (YMD 2027 4 14) TRUE TRUE TRUE TRUE) EQUALS NOTHING
#ASSERT `s 348(a) the corporation's status as a close corporation survives the breach` (`dg10 test steps 348` (YMD 2027 3 1) NOTHING (YMD 2027 4 14) TRUE TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT `s 348(a)(2) the corporation concurrently took the steps necessary to correct the situation` (`dg10 test steps 348` (YMD 2027 3 1) NOTHING (YMD 2027 4 14) TRUE TRUE TRUE TRUE)
#ASSERT NOT (`s 348(a)(2) the corporation concurrently took the steps necessary to correct the situation` (`dg10 test steps 348` (YMD 2027 3 1) NOTHING (YMD 2027 4 14) TRUE TRUE TRUE FALSE))
-- (b)
#ASSERT `s 348(b) the Court of Chancery has jurisdiction to issue orders to prevent loss of close corporation status or to restore it` TRUE TRUE FALSE
#ASSERT NOT (`s 348(b) the Court of Chancery has jurisdiction to issue orders to prevent loss of close corporation status or to restore it` TRUE TRUE TRUE)
#ASSERT NOT (`s 348(b) the Court of Chancery has jurisdiction to issue orders to prevent loss of close corporation status or to restore it` FALSE TRUE FALSE)
#ASSERT NOT (`s 348(b) the Court of Chancery has jurisdiction to issue orders to prevent loss of close corporation status or to restore it` TRUE FALSE FALSE)
#ASSERT `s 348(b) the Court of Chancery may enjoin or set aside the transfer or threatened transfer of stock` TRUE TRUE
#ASSERT NOT (`s 348(b) the Court of Chancery may enjoin or set aside the transfer or threatened transfer of stock` TRUE FALSE)
#ASSERT NOT (`s 348(b) the Court of Chancery may enjoin or set aside the transfer or threatened transfer of stock` FALSE TRUE)
#ASSERT `s 348(b) the Court of Chancery may enjoin the public offering or threatened public offering of stock` TRUE TRUE
#ASSERT NOT (`s 348(b) the Court of Chancery may enjoin the public offering or threatened public offering of stock` TRUE FALSE)

§ `s 349: the corporation's option`

#ASSERT `s 349 the last day of the corporation's option to acquire the restricted security` (YMD 2027 3 1) EQUALS (YMD 2027 3 31)
#ASSERT `s 349 the last day of the corporation's option to acquire the restricted security` (YMD 2027 12 15) EQUALS (YMD 2028 1 14)
#ASSERT `s 349 the corporation may still exercise its option to acquire the restricted security` TRUE (YMD 2027 3 1) (YMD 2027 3 31)
#ASSERT `s 349 the corporation may still exercise its option to acquire the restricted security` TRUE (YMD 2027 3 1) (YMD 2027 3 1)
#ASSERT NOT (`s 349 the corporation may still exercise its option to acquire the restricted security` TRUE (YMD 2027 3 1) (YMD 2027 4 1))
#ASSERT NOT (`s 349 the corporation may still exercise its option to acquire the restricted security` TRUE (YMD 2027 3 1) (YMD 2027 2 28))
#ASSERT NOT (`s 349 the corporation may still exercise its option to acquire the restricted security` FALSE (YMD 2027 3 1) (YMD 2027 3 10))
#ASSERT `s 349 the price at which the corporation may acquire the restricted security` (JUST 1000) (JUST 900) EQUALS JUST 1000
#ASSERT `s 349 the price at which the corporation may acquire the restricted security` NOTHING (JUST 900) EQUALS JUST 900
#ASSERT `s 349 the price at which the corporation may acquire the restricted security` NOTHING NOTHING EQUALS NOTHING

§ `s 350: agreements restricting the discretion of directors`

-- A majority of the votes: 51 of 100 is a majority; 50 of 100 is not.
#ASSERT `s 350 the agreement is a written agreement of stockholders holding a majority of the outstanding stock entitled to vote` TRUE 51 100 EQUALS JUST TRUE
#ASSERT `s 350 the agreement is a written agreement of stockholders holding a majority of the outstanding stock entitled to vote` TRUE 50 100 EQUALS JUST FALSE
#ASSERT `s 350 the agreement is a written agreement of stockholders holding a majority of the outstanding stock entitled to vote` FALSE 51 100 EQUALS JUST FALSE
#ASSERT `s 350 the agreement is a written agreement of stockholders holding a majority of the outstanding stock entitled to vote` TRUE 0 0 EQUALS NOTHING
#ASSERT `s 350 the agreement is invalid, as between the parties, on the ground that it restricts or interferes with the discretion or powers of the board` (JUST TRUE) EQUALS JUST FALSE
-- An agreement outside the section: not covered.
#ASSERT `s 350 the agreement is invalid, as between the parties, on the ground that it restricts or interferes with the discretion or powers of the board` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 350 the agreement is invalid, as between the parties, on the ground that it restricts or interferes with the discretion or powers of the board` NOTHING EQUALS NOTHING
#ASSERT `s 350 the stockholders who are parties bear the liability for managerial acts or omissions that is imposed on directors, and the directors are relieved` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 350 the stockholders who are parties bear the liability for managerial acts or omissions that is imposed on directors, and the directors are relieved` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 350 the stockholders who are parties bear the liability for managerial acts or omissions that is imposed on directors, and the directors are relieved` (JUST FALSE) TRUE EQUALS NOTHING

§ `s 351: management by stockholders`

#ASSERT `s 351 the provision for management by the stockholders is in effect` TRUE
#ASSERT `s 351(1) a meeting of stockholders must be called to elect directors` TRUE EQUALS JUST FALSE
#ASSERT `s 351(1) a meeting of stockholders must be called to elect directors` FALSE EQUALS NOTHING
#ASSERT `s 351(2) the stockholders are deemed to be directors for purposes of applying the provision of this chapter` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 351(2) the stockholders are deemed to be directors for purposes of applying the provision of this chapter` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 351(2) the stockholders are deemed to be directors for purposes of applying the provision of this chapter` FALSE FALSE EQUALS NOTHING
#ASSERT `s 351(3) the stockholders are subject to all liabilities of directors` TRUE EQUALS JUST TRUE
#ASSERT `s 351(3) the stockholders are subject to all liabilities of directors` FALSE EQUALS NOTHING
