IMPORT prelude
IMPORT daydate
IMPORT `dg-core`
IMPORT `dg6-s251a-agreement`
IMPORT `dg6-s251f-no-vote`

-- Tests of dg6-s251f-no-vote.l4 (8 Del. C. § 251(f) and (g)).
-- Every expected value was written by hand from the text (de-code-t8-ch1-2026-10-01.txt, lines 1080-1090) before the file
-- was run. A failing assertion is a finding: no expected value was edited to match the code.

§ `Tests of s 251(f) and (g)`

§§ `s 251(f)`

-- Terms of the merger, in the order of the record:
--   amends the certificate, every share identical, no common stock issued or delivered,
--   authorized unissued or treasury common shares to be issued, shares issuable on conversion, constituent's common shares outstanding
GIVEN amends IS A BOOLEAN
      identical IS A BOOLEAN
      none IS A BOOLEAN
      issued IS A NUMBER
      convertible IS A NUMBER
      outstanding IS A NUMBER
GIVETH A `s 251(f) Terms of the merger`
`test f terms` amends identical none issued convertible outstanding MEANS
    `s 251(f) Terms of the merger` OF amends, identical, none, issued, convertible, outstanding

-- Limb (3): "do not exceed 20%" of 1,000 outstanding common shares is 200. 150 + 50 = 200 is within; 150 + 51 = 201 is not.
#ASSERT `s 251(f)(3) the issue of common stock is within the limit` (`test f terms` FALSE TRUE FALSE 150 50 1000)
#ASSERT `s 251(f)(3) the issue of common stock is within the limit` (`test f terms` FALSE TRUE FALSE 150 49 1000)
#ASSERT NOT (`s 251(f)(3) the issue of common stock is within the limit` (`test f terms` FALSE TRUE FALSE 150 51 1000))
#ASSERT NOT (`s 251(f)(3) the issue of common stock is within the limit` (`test f terms` FALSE TRUE FALSE 201 0 1000))
-- Either nothing is issued or delivered, or the count is within 20%: the first alternative needs no count.
#ASSERT `s 251(f)(3) the issue of common stock is within the limit` (`test f terms` FALSE TRUE TRUE 0 0 1000)
-- With no common stock outstanding, 20% of nothing is nothing.
#ASSERT `s 251(f)(3) the issue of common stock is within the limit` (`test f terms` FALSE TRUE FALSE 0 0 0)
#ASSERT NOT (`s 251(f)(3) the issue of common stock is within the limit` (`test f terms` FALSE TRUE FALSE 1 0 0))

-- First sentence: a constituent corporation surviving a merger; certificate does not require a vote; (1), (2), (3).
`good f terms` MEANS `test f terms` FALSE TRUE TRUE 0 0 1000
#ASSERT `s 251(f) no vote of the stockholders is necessary under the first sentence` `a merger into a single surviving corporation` TRUE FALSE `good f terms`
-- "unless required by its certificate of incorporation"
#ASSERT NOT (`s 251(f) no vote of the stockholders is necessary under the first sentence` `a merger into a single surviving corporation` TRUE TRUE `good f terms`)
-- (1) the agreement does not amend the certificate in any respect
#ASSERT NOT (`s 251(f) no vote of the stockholders is necessary under the first sentence` `a merger into a single surviving corporation` TRUE FALSE (`test f terms` TRUE TRUE TRUE 0 0 1000))
-- (2) each share becomes an identical outstanding or treasury share
#ASSERT NOT (`s 251(f) no vote of the stockholders is necessary under the first sentence` `a merger into a single surviving corporation` TRUE FALSE (`test f terms` FALSE FALSE TRUE 0 0 1000))
-- (3) fails at 201 of 1,000, passes at 200 of 1,000
#ASSERT NOT (`s 251(f) no vote of the stockholders is necessary under the first sentence` `a merger into a single surviving corporation` TRUE FALSE (`test f terms` FALSE TRUE FALSE 201 0 1000))
#ASSERT `s 251(f) no vote of the stockholders is necessary under the first sentence` `a merger into a single surviving corporation` TRUE FALSE (`test f terms` FALSE TRUE FALSE 200 0 1000)
-- It is a constituent corporation "surviving a merger": a constituent that does not survive, or a consolidation, is not covered by it.
#ASSERT NOT (`s 251(f) no vote of the stockholders is necessary under the first sentence` `a merger into a single surviving corporation` FALSE FALSE `good f terms`)
#ASSERT NOT (`s 251(f) no vote of the stockholders is necessary under the first sentence` `a consolidation into a new resulting corporation` TRUE FALSE `good f terms`)

-- Second sentence: no shares issued before the board adopted the resolution.
#ASSERT `s 251(f) no vote of the stockholders is necessary under the second sentence` TRUE
#ASSERT NOT (`s 251(f) no vote of the stockholders is necessary under the second sentence` FALSE)
#ASSERT `s 251(f) no vote of the stockholders of the constituent corporation is necessary` TRUE FALSE
#ASSERT `s 251(f) no vote of the stockholders of the constituent corporation is necessary` FALSE TRUE
#ASSERT NOT (`s 251(f) no vote of the stockholders of the constituent corporation is necessary` FALSE FALSE)

-- Certification.
#ASSERT `s 251(f) what the secretary or assistant secretary must certify on the agreement` TRUE `the first sentence of s 251(f)` FALSE EQUALS `that the agreement has been adopted pursuant to s 251(f) and that the conditions specified in its first sentence have been satisfied`
#ASSERT `s 251(f) what the secretary or assistant secretary must certify on the agreement` TRUE `the second sentence of s 251(f)` FALSE EQUALS `that the agreement has been adopted pursuant to s 251(f) and that no shares of stock were issued before the board adopted the resolution approving the agreement`
-- "provided that such certification on the agreement shall not be required if a certificate ... is filed in lieu"
#ASSERT `s 251(f) what the secretary or assistant secretary must certify on the agreement` TRUE `the first sentence of s 251(f)` TRUE EQUALS `nothing, because the agreement was not adopted under s 251(f) without a vote of the stockholders, or a certificate is filed in lieu of the agreement`
#ASSERT `s 251(f) what the secretary or assistant secretary must certify on the agreement` FALSE `the first sentence of s 251(f)` FALSE EQUALS `nothing, because the agreement was not adopted under s 251(f) without a vote of the stockholders, or a certificate is filed in lieu of the agreement`
#ASSERT `s 251(f) the agreement so adopted and certified is then to be filed` TRUE
#ASSERT NOT (`s 251(f) the agreement so adopted and certified is then to be filed` FALSE)
#ASSERT `s 251(f) the person who executes the agreement represents that the facts stated in the certificate remain true` TRUE
#ASSERT NOT (`s 251(f) the person who executes the agreement represents that the facts stated in the certificate remain true` FALSE)

§§ `s 251(g)`

-- Entities.
`a Delaware stock corporation` MEANS Entity WITH `kind of entity` IS `a corporation` (`a stock corporation`), `where formed` IS `this State`
`a Delaware limited liability company` MEANS Entity WITH `kind of entity` IS `a limited liability company`, `where formed` IS `this State`
`a Nevada stock corporation` MEANS Entity WITH `kind of entity` IS `a corporation` (`a stock corporation`), `where formed` IS `another jurisdiction of the United States`
`a Delaware limited liability partnership` MEANS Entity WITH `kind of entity` IS `a limited liability partnership`, `where formed` IS `this State`

#ASSERT `s 251(g)(3) the entity is a corporation of this State` `a Delaware stock corporation`
#ASSERT NOT (`s 251(g)(3) the entity is a corporation of this State` `a Nevada stock corporation`)
#ASSERT NOT (`s 251(g)(3) the entity is a corporation of this State` `a Delaware limited liability company`)
#ASSERT `s 251(g)(3) the entity is a corporation or limited liability company of this State` `a Delaware stock corporation`
#ASSERT `s 251(g)(3) the entity is a corporation or limited liability company of this State` `a Delaware limited liability company`
#ASSERT NOT (`s 251(g)(3) the entity is a corporation or limited liability company of this State` `a Nevada stock corporation`)
#ASSERT NOT (`s 251(g)(3) the entity is a corporation or limited liability company of this State` `a Delaware limited liability partnership`)

-- Terms of the holding company merger, in the order of the record:
--   1 only constituent entities, 2 conversion into identical stock, 3 holding company, 4 constituent corporation, 5 other constituent entity,
--   6 charter and bylaws identical, 7 becomes subsidiary, 8 directors remain, 9 surviving entity,
--   10 (g)(7)(A), 11 (g)(7)(A) proviso, 12 (g)(7)(B), 13 board's tax determination
GIVEN t1 IS A BOOLEAN
      t2 IS A BOOLEAN
      holding IS AN Entity
      constituent IS AN Entity
      other IS AN Entity
      t6 IS A BOOLEAN
      t7 IS A BOOLEAN
      t8 IS A BOOLEAN
      survivor IS AN Entity
      t10 IS A BOOLEAN
      t11 IS A BOOLEAN
      t12 IS A BOOLEAN
      t13 IS A BOOLEAN
GIVETH A `s 251(g) Terms of the merger`
`test g terms` t1 t2 holding constituent other t6 t7 t8 survivor t10 t11 t12 t13 MEANS
    `s 251(g) Terms of the merger` OF t1, t2, holding, constituent, other, t6, t7, t8, survivor, t10, t11, t12, t13

-- A holding company merger into a Delaware limited liability company, which survives.
`good g terms` MEANS `test g terms` TRUE TRUE `a Delaware stock corporation` `a Delaware stock corporation` `a Delaware limited liability company` TRUE TRUE TRUE `a Delaware limited liability company` TRUE TRUE TRUE TRUE
#ASSERT `s 251(g) no vote of the stockholders of the constituent corporation is necessary` FALSE `good g terms`
-- "unless expressly required by its certificate of incorporation"
#ASSERT NOT (`s 251(g) no vote of the stockholders of the constituent corporation is necessary` TRUE `good g terms`)
-- Each of (1) to (8) is needed.
#ASSERT NOT (`s 251(g) no vote of the stockholders of the constituent corporation is necessary` FALSE (`test g terms` FALSE TRUE `a Delaware stock corporation` `a Delaware stock corporation` `a Delaware limited liability company` TRUE TRUE TRUE `a Delaware limited liability company` TRUE TRUE TRUE TRUE))
#ASSERT NOT (`s 251(g) no vote of the stockholders of the constituent corporation is necessary` FALSE (`test g terms` TRUE FALSE `a Delaware stock corporation` `a Delaware stock corporation` `a Delaware limited liability company` TRUE TRUE TRUE `a Delaware limited liability company` TRUE TRUE TRUE TRUE))
#ASSERT NOT (`s 251(g) no vote of the stockholders of the constituent corporation is necessary` FALSE (`test g terms` TRUE TRUE `a Nevada stock corporation` `a Delaware stock corporation` `a Delaware limited liability company` TRUE TRUE TRUE `a Delaware limited liability company` TRUE TRUE TRUE TRUE))
#ASSERT NOT (`s 251(g) no vote of the stockholders of the constituent corporation is necessary` FALSE (`test g terms` TRUE TRUE `a Delaware stock corporation` `a Nevada stock corporation` `a Delaware limited liability company` TRUE TRUE TRUE `a Delaware limited liability company` TRUE TRUE TRUE TRUE))
#ASSERT NOT (`s 251(g) no vote of the stockholders of the constituent corporation is necessary` FALSE (`test g terms` TRUE TRUE `a Delaware stock corporation` `a Delaware stock corporation` `a Delaware limited liability partnership` TRUE TRUE TRUE `a Delaware limited liability company` TRUE TRUE TRUE TRUE))
#ASSERT NOT (`s 251(g) no vote of the stockholders of the constituent corporation is necessary` FALSE (`test g terms` TRUE TRUE `a Delaware stock corporation` `a Delaware stock corporation` `a Delaware limited liability company` FALSE TRUE TRUE `a Delaware limited liability company` TRUE TRUE TRUE TRUE))
#ASSERT NOT (`s 251(g) no vote of the stockholders of the constituent corporation is necessary` FALSE (`test g terms` TRUE TRUE `a Delaware stock corporation` `a Delaware stock corporation` `a Delaware limited liability company` TRUE FALSE TRUE `a Delaware limited liability company` TRUE TRUE TRUE TRUE))
#ASSERT NOT (`s 251(g) no vote of the stockholders of the constituent corporation is necessary` FALSE (`test g terms` TRUE TRUE `a Delaware stock corporation` `a Delaware stock corporation` `a Delaware limited liability company` TRUE TRUE FALSE `a Delaware limited liability company` TRUE TRUE TRUE TRUE))
#ASSERT NOT (`s 251(g) no vote of the stockholders of the constituent corporation is necessary` FALSE (`test g terms` TRUE TRUE `a Delaware stock corporation` `a Delaware stock corporation` `a Delaware limited liability company` TRUE TRUE TRUE `a Delaware limited liability company` TRUE TRUE TRUE FALSE))
-- The other constituent entity may be a corporation of this State instead of a limited liability company.
#ASSERT `s 251(g) no vote of the stockholders of the constituent corporation is necessary` FALSE (`test g terms` TRUE TRUE `a Delaware stock corporation` `a Delaware stock corporation` `a Delaware stock corporation` TRUE TRUE TRUE `a Delaware stock corporation` TRUE FALSE FALSE TRUE)

-- (g)(7): (A) always; the proviso and (B) only where the surviving entity is not a corporation.
#ASSERT `s 251(g)(7) the organizational documents of the surviving entity contain the provisions the paragraph requires` `good g terms`
#ASSERT `s 251(g)(7) the organizational documents of the surviving entity contain the provisions the paragraph requires` (`test g terms` TRUE TRUE `a Delaware stock corporation` `a Delaware stock corporation` `a Delaware stock corporation` TRUE TRUE TRUE `a Delaware stock corporation` TRUE FALSE FALSE TRUE)
#ASSERT NOT (`s 251(g)(7) the organizational documents of the surviving entity contain the provisions the paragraph requires` (`test g terms` TRUE TRUE `a Delaware stock corporation` `a Delaware stock corporation` `a Delaware stock corporation` TRUE TRUE TRUE `a Delaware stock corporation` FALSE TRUE TRUE TRUE))
#ASSERT NOT (`s 251(g)(7) the organizational documents of the surviving entity contain the provisions the paragraph requires` (`test g terms` TRUE TRUE `a Delaware stock corporation` `a Delaware stock corporation` `a Delaware limited liability company` TRUE TRUE TRUE `a Delaware limited liability company` TRUE FALSE TRUE TRUE))
#ASSERT NOT (`s 251(g)(7) the organizational documents of the surviving entity contain the provisions the paragraph requires` (`test g terms` TRUE TRUE `a Delaware stock corporation` `a Delaware stock corporation` `a Delaware limited liability company` TRUE TRUE TRUE `a Delaware limited liability company` TRUE TRUE FALSE TRUE))
#ASSERT `s 251(g)(7) the provision is construed to require approval of the stockholders of the holding company to elect or remove directors or managers of the surviving entity` TRUE EQUALS JUST FALSE
#ASSERT `s 251(g)(7) the provision is construed to require approval of the stockholders of the holding company to elect or remove directors or managers of the surviving entity` FALSE EQUALS NOTHING

-- "organizational documents": the certificate of incorporation of a corporation; the agreement of a limited liability company.
#ASSERT `s 251(g) the organizational documents of the entity` `a Delaware stock corporation` EQUALS JUST `the certificate of incorporation of a corporation`
#ASSERT `s 251(g) the organizational documents of the entity` `a Delaware limited liability company` EQUALS JUST `the limited liability company agreement of a limited liability company`
#ASSERT `s 251(g) the organizational documents of the entity` `a Delaware limited liability partnership` EQUALS NOTHING

-- "holding company": a corporation, wholly-owned subsidiary from incorporation until the merger, whose stock is issued in the merger.
#ASSERT `s 251(g) the entity is a holding company` `a Delaware stock corporation` TRUE TRUE
#ASSERT NOT (`s 251(g) the entity is a holding company` `a Delaware stock corporation` FALSE TRUE)
#ASSERT NOT (`s 251(g) the entity is a holding company` `a Delaware stock corporation` TRUE FALSE)
#ASSERT NOT (`s 251(g) the entity is a holding company` `a Delaware limited liability company` TRUE TRUE)

-- After the merger.
#ASSERT `s 251(g)(i) the restrictions of s 203 apply to the holding company and its stockholders` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 251(g)(i) the restrictions of s 203 apply to the holding company and its stockholders` TRUE FALSE EQUALS NOTHING
#ASSERT `s 251(g)(i) the restrictions of s 203 apply to the holding company and its stockholders` FALSE TRUE EQUALS NOTHING
#ASSERT `s 251(g)(i) the date on which the holding company shares are deemed acquired for s 203` (YearMonthDay 2019 5 17) EQUALS YearMonthDay 2019 5 17
#ASSERT `s 251(g)(i) the merger alone makes the stockholder an interested stockholder of the holding company` FALSE EQUALS JUST FALSE
#ASSERT `s 251(g)(i) the merger alone makes the stockholder an interested stockholder of the holding company` TRUE EQUALS NOTHING
#ASSERT `s 251(g)(ii) the stock certificates that represented the constituent corporation's shares represent the holding company's shares` TRUE EQUALS JUST TRUE
#ASSERT `s 251(g)(ii) the stock certificates that represented the constituent corporation's shares represent the holding company's shares` FALSE EQUALS NOTHING
#ASSERT `s 251(g)(iii) the stockholder keeps standing to institute or maintain derivative litigation` TRUE EQUALS JUST TRUE
#ASSERT `s 251(g)(iii) the stockholder keeps standing to institute or maintain derivative litigation` FALSE EQUALS NOTHING

-- Certification, filing and representation.
#ASSERT `s 251(g) the secretary or assistant secretary must certify that the agreement was adopted under s 251(g) and that its conditions are satisfied` TRUE FALSE
#ASSERT NOT (`s 251(g) the secretary or assistant secretary must certify that the agreement was adopted under s 251(g) and that its conditions are satisfied` TRUE TRUE)
#ASSERT NOT (`s 251(g) the secretary or assistant secretary must certify that the agreement was adopted under s 251(g) and that its conditions are satisfied` FALSE FALSE)
#ASSERT `s 251(g) the agreement so adopted and certified is then to be filed` TRUE
#ASSERT NOT (`s 251(g) the agreement so adopted and certified is then to be filed` FALSE)
#ASSERT `s 251(g) the person who executes the agreement represents that the facts stated in the certificate remain true` TRUE
#ASSERT NOT (`s 251(g) the person who executes the agreement represents that the facts stated in the certificate remain true` FALSE)
