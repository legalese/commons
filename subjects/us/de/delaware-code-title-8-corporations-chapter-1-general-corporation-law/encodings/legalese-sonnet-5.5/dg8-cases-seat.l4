#ASSERT NOT (`Is the merger authorized and the certificate of ownership and merger filed as section 267(a) requires (s 267(a))` TRUE TRUE TRUE FALSE TRUE TRUE FALSE)
-- Terms stated.
#ASSERT `Is the merger authorized and the certificate of ownership and merger filed as section 267(a) requires (s 267(a))` TRUE TRUE TRUE FALSE TRUE TRUE TRUE
