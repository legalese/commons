#ASSERT `May a term of the merger depend on facts outside the certificate (s 267(a))` TRUE TRUE
-- Not set out.
#ASSERT NOT (`May a term of the merger depend on facts outside the certificate (s 267(a))` TRUE FALSE)
-- The survivor is formed outside Delaware and the terms obligate it.
#ASSERT `Does section 252(d) apply to the merger and bind the survivor (s 267(a))` TRUE TRUE
-- The terms do not.
#ASSERT NOT (`Does section 252(d) apply to the merger and bind the survivor (s 267(a))` TRUE FALSE)
-- A Delaware survivor: nothing is asked of the terms.
#ASSERT `Does section 252(d) apply to the merger and bind the survivor (s 267(a))` FALSE FALSE
-- The survivor is formed outside Delaware.
#ASSERT `Does section 252(d) also apply to a merger under section 267 (s 267(a))` TRUE
-- A Delaware survivor.
#ASSERT NOT (`Does section 252(d) also apply to a merger under section 267 (s 267(a))` FALSE)
-- The survivor is the parent entity, formed outside Delaware.
#ASSERT `Is the word corporation in section 252(d) read to include the parent entity (s 267(a))` TRUE `the entity merges the corporation or corporations into itself and assumes all of its or their obligations`
-- A subsidiary corporation survives.
#ASSERT NOT (`Is the word corporation in section 252(d) read to include the parent entity (s 267(a))` TRUE `the entity merges itself, or itself and 1 or more of the corporations, into 1 of the other corporations`)
-- "Agreement of merger" in section 251(e) means the terms set out in the certificate of ownership and merger.
#ASSERT `How is this reference read in a merger under section 267 (s 267(b))` `the words agreement of merger in s 251(e)` EQUALS `the terms and conditions of the merger set forth in the certificate of ownership and merger`
-- "Corporation" in section 328 includes the entity, as applicable.
#ASSERT `How is this reference read in a merger under section 267 (s 267(b))` `the word corporation in s 328` EQUALS `a corporation or, as applicable, the entity`
-- The parent merges the subsidiaries into itself.
#ASSERT `Which party survives the merger (s 267(a))` `the entity merges the corporation or corporations into itself and assumes all of its or their obligations`
-- A subsidiary survives.
#ASSERT NOT (`Which party survives the merger (s 267(a))` `the entity merges itself, or itself and 1 or more of the corporations, into 1 of the other corporations`)
-- Section 260 applies where a Delaware corporation survives.
#ASSERT `Does this provision apply to a merger under section 267 (s 267(b))` `s 260 as applied by s 267(b)` TRUE TRUE
-- The survivor is not a Delaware corporation.
#ASSERT NOT (`Does this provision apply to a merger under section 267 (s 267(b))` `s 260 as applied by s 267(b)` TRUE FALSE)
-- Section 259 applies insofar as applicable.
#ASSERT `Does this provision apply to a merger under section 267 (s 267(b))` `s 259 as applied by s 267(b)` TRUE FALSE
-- The parent owned all the stock: no appraisal.
#ASSERT NOT (`Does section 262 apply to a merger under section 267 (s 267(b))` TRUE)
-- Not all owned: appraisal as subsection (c) provides.
#ASSERT `Does section 262 apply to a merger under section 267 (s 267(b))` FALSE
-- I hold shares the parent does not own.
#ASSERT `Do I have appraisal rights in a merger under section 267 (s 267(c))` FALSE
-- The parent owned all the stock.
#ASSERT NOT (`Do I have appraisal rights in a merger under section 267 (s 267(c))` TRUE)
-- A merger not under section 251(g) in which all shares are cashed out.
#ASSERT `Does section 268(a) apply to my constituent corporation (s 268(a))` FALSE TRUE
-- A section 251(g) merger is left out.
#ASSERT NOT (`Does section 268(a) apply to my constituent corporation (s 268(a))` TRUE TRUE)
