#ASSERT `May the board approve an agreement that is silent on the surviving corporation's certificate of incorporation (s 268(a)(i))` FALSE TRUE EQUALS JUST TRUE
-- The subsection does not apply: it says nothing.
#ASSERT `May the board approve an agreement that is silent on the surviving corporation's certificate of incorporation (s 268(a)(i))` TRUE TRUE EQUALS NOTHING
-- The constituent corporation's board may adopt the amendment.
#ASSERT `May this person adopt an amendment of the surviving corporation's certificate of incorporation (s 268(a)(ii))` `the board of directors of the constituent corporation` FALSE TRUE FALSE EQUALS JUST TRUE
-- The constituent entity's board may not unless its interests are converted into all the surviving corporation's shares.
#ASSERT `May this person adopt an amendment of the surviving corporation's certificate of incorporation (s 268(a)(ii))` `the board of directors or governing body of a constituent entity whose shares or equity interests are to be converted into all of the shares of capital stock of the surviving corporation` FALSE TRUE FALSE EQUALS JUST FALSE
-- They are so converted: the entity's board may.
#ASSERT `May this person adopt an amendment of the surviving corporation's certificate of incorporation (s 268(a)(ii))` `the board of directors or governing body of a constituent entity whose shares or equity interests are to be converted into all of the shares of capital stock of the surviving corporation` FALSE TRUE TRUE EQUALS JUST TRUE
-- A person the subsection does not name.
#ASSERT `May this person adopt an amendment of the surviving corporation's certificate of incorporation (s 268(a)(ii))` `any other person` FALSE TRUE FALSE EQUALS NOTHING
-- Where it applies, no change is deemed an amendment.
#ASSERT `Is a change to the surviving corporation's certificate of incorporation an amendment to the merger agreement (s 268(a)(iii))` FALSE TRUE EQUALS JUST FALSE
-- Where it does not apply, nothing is said.
#ASSERT `Is a change to the surviving corporation's certificate of incorporation an amendment to the merger agreement (s 268(a)(iii))` TRUE TRUE EQUALS NOTHING
