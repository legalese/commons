-- No other designated.
#ASSERT `To what address must the Secretary of State mail the letter to the converted entity (s 266(c)(6))` "10 Harbor Road" EMPTY EQUALS "10 Harbor Road"
-- Sent as required.
#ASSERT `Was the Secretary of State's letter to the converted entity sent as section 266(c)(6) requires (s 266(c)(6))` TRUE TRUE
-- No record of signed delivery.
#ASSERT NOT (`Was the Secretary of State's letter to the converted entity sent as section 266(c)(6) requires (s 266(c)(6))` FALSE TRUE)
-- Did all three.
