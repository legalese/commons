#ASSERT `Does the conversion leave the choice of law for earlier matters untouched (s 266(e))` TRUE EQUALS JUST TRUE
-- A matter after: nothing said.
#ASSERT `Does the conversion leave the choice of law for earlier matters untouched (s 266(e))` FALSE EQUALS NOTHING
