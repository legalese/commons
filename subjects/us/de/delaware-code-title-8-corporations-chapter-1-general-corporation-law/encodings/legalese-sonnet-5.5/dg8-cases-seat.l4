#ASSERT `Are the disclosure schedules part of the merger agreement for the Law (s 268(b))` TRUE FALSE EQUALS JUST FALSE
-- The agreement expressly provides otherwise.
#ASSERT `Are the disclosure schedules part of the merger agreement for the Law (s 268(b))` TRUE TRUE EQUALS NOTHING
-- They have the effects the agreement provides.
#ASSERT `Do the disclosure schedules have the effects the agreement gives them (s 268(b))` TRUE FALSE
-- Where it provides otherwise the subsection does not give them.
#ASSERT NOT (`Do the disclosure schedules have the effects the agreement gives them (s 268(b))` TRUE TRUE)
