#ASSERT `Does the conversion leave my earlier liability untouched (s 266(e))` TRUE EQUALS JUST TRUE
-- Incurred after: nothing said.
#ASSERT `Does the conversion leave my earlier liability untouched (s 266(e))` FALSE EQUALS NOTHING
