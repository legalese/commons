#ASSERT `Under section 103(d), on what date is my instrument effective` (YearMonthDay 2026 1 1) TRUE (YearMonthDay 2026 3 1) EQUALS JUST (YearMonthDay 2026 3 1)
#ASSERT `Under section 103(d), on what date is my instrument effective` (YearMonthDay 2026 1 1) TRUE (YearMonthDay 2026 4 2) EQUALS NOTHING
#ASSERT `Have I validly terminated or amended an instrument that has a future effective date` (YearMonthDay 2026 2 28) TRUE TRUE TRUE (YearMonthDay 2026 3 1) EQUALS JUST TRUE
#ASSERT `Have I validly terminated or amended an instrument that has a future effective date` (YearMonthDay 2026 3 2) TRUE TRUE TRUE (YearMonthDay 2026 3 1) EQUALS JUST FALSE
#ASSERT `Have I validly terminated or amended an instrument that has a future effective date` (YearMonthDay 2026 3 1) TRUE TRUE TRUE (YearMonthDay 2026 3 1) EQUALS NOTHING
#ASSERT `Under section 103(e), does another section of the Law govern this instrument` TRUE TRUE
#ASSERT NOT (`Under section 103(e), does another section of the Law govern this instrument` TRUE FALSE)
#ASSERT `May a filed instrument be corrected or nullified by a certificate of correction` TRUE TRUE FALSE
