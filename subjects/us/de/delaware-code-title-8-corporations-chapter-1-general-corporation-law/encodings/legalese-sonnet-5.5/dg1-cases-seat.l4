#ASSERT NOT (`Has this certificate or early instrument been signed as the Law requires of the incorporators` TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE)
#ASSERT `Has this certificate or early instrument been signed as the Law requires of the incorporators` FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE
#ASSERT `Has this certificate or early instrument been signed as the Law requires of the incorporators` FALSE FALSE FALSE TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`Has this certificate or early instrument been signed as the Law requires of the incorporators` FALSE FALSE FALSE TRUE TRUE TRUE FALSE TRUE)
