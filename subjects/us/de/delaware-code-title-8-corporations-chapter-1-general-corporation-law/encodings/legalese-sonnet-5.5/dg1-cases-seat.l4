#ASSERT NOT (`Is the Secretary of State barred from issuing my corporation a certificate of good standing` FALSE)
-- The filing date, for delivery on 15 March 2026.
#ASSERT `Under section 103(c), what is my instrument's filing date` `the date I delivered it` (YearMonthDay 2026 3 15) (YearMonthDay 2026 3 20) (YearMonthDay 2026 3 2) 5 TRUE (YearMonthDay 2026 3 14) 4 TRUE (YearMonthDay 2026 3 10) EQUALS YearMonthDay 2026 3 15
#ASSERT `Under section 103(c), what is my instrument's filing date` `a later date that I asked for and the Secretary of State set` (YearMonthDay 2026 3 15) (YearMonthDay 2026 3 20) (YearMonthDay 2026 3 2) 5 TRUE (YearMonthDay 2026 3 14) 4 TRUE (YearMonthDay 2026 3 10) EQUALS YearMonthDay 2026 3 20
#ASSERT `Under section 103(c), what is my instrument's filing date` `the replacement of an instrument held in suspension` (YearMonthDay 2026 3 15) (YearMonthDay 2026 3 20) (YearMonthDay 2026 3 2) 5 TRUE (YearMonthDay 2026 3 14) 4 TRUE (YearMonthDay 2026 3 10) EQUALS YearMonthDay 2026 3 2
#ASSERT `Under section 103(c), what is my instrument's filing date` `the replacement of an instrument held in suspension` (YearMonthDay 2026 3 15) (YearMonthDay 2026 3 20) (YearMonthDay 2026 3 2) 6 TRUE (YearMonthDay 2026 3 14) 4 TRUE (YearMonthDay 2026 3 10) EQUALS YearMonthDay 2026 3 15
#ASSERT `Under section 103(c), what is my instrument's filing date` `the date the Secretary of State entered the information` (YearMonthDay 2026 3 15) (YearMonthDay 2026 3 20) (YearMonthDay 2026 3 2) 5 TRUE (YearMonthDay 2026 3 14) 4 TRUE (YearMonthDay 2026 3 10) EQUALS YearMonthDay 2026 3 14
#ASSERT `Under section 103(c), what is my instrument's filing date` `the date the Secretary of State entered the information` (YearMonthDay 2026 3 15) (YearMonthDay 2026 3 20) (YearMonthDay 2026 3 2) 5 TRUE (YearMonthDay 2026 3 14) 5 TRUE (YearMonthDay 2026 3 10) EQUALS YearMonthDay 2026 3 15
#ASSERT `Under section 103(c), what is my instrument's filing date` `an earlier date set because of an extraordinary condition` (YearMonthDay 2026 3 15) (YearMonthDay 2026 3 20) (YearMonthDay 2026 3 2) 5 TRUE (YearMonthDay 2026 3 14) 4 TRUE (YearMonthDay 2026 3 10) EQUALS YearMonthDay 2026 3 10
-- Fees: a 3-page instrument pays $24 + 2 x $9 = $42 to the counties and $40 to the courthouse municipality; a qualifying dissolution certificate pays neither.
#ASSERT `What county assessment fee must I tender with my instrument` 1 FALSE FALSE EQUALS JUST 24
#ASSERT `What county assessment fee must I tender with my instrument` 3 FALSE FALSE EQUALS JUST 42
#ASSERT `What county assessment fee must I tender with my instrument` 3 TRUE FALSE EQUALS JUST 0
#ASSERT `What county assessment fee must I tender with my instrument` 0 FALSE FALSE EQUALS NOTHING
#ASSERT `What courthouse municipality fee must I tender with my instrument` FALSE FALSE FALSE EQUALS 40
#ASSERT `What courthouse municipality fee must I tender with my instrument` TRUE FALSE FALSE EQUALS 0
-- A later effective date: filing on 1 January 2026, the ninetieth day is 1 April 2026; the same date is not covered.
#ASSERT `May my instrument say that it becomes effective on a later date` (YearMonthDay 2026 1 1) (YearMonthDay 2026 4 1) EQUALS JUST TRUE
#ASSERT `May my instrument say that it becomes effective on a later date` (YearMonthDay 2026 1 1) (YearMonthDay 2026 4 2) EQUALS JUST FALSE
#ASSERT `May my instrument say that it becomes effective on a later date` (YearMonthDay 2026 1 1) (YearMonthDay 2026 1 1) EQUALS NOTHING
