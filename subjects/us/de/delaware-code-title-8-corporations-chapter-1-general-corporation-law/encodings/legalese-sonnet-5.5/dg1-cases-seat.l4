#ASSERT NOT (`Has this instrument been signed as the Law requires for the corporation` FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE)
#ASSERT `Has this instrument been signed as the Law requires for the corporation` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE
