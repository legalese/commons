#ASSERT `Have I validly terminated or amended an instrument that has a future effective date` (YearMonthDay 2026 2 28) TRUE TRUE FALSE (YearMonthDay 2026 3 1) EQUALS JUST FALSE
-- Section 103(f): a certificate of correction must be executed, and must specify the inaccuracy; a corrected instrument must meet all four of its conditions.
#ASSERT NOT (`Is my certificate of correction in the form the Law requires` FALSE TRUE TRUE TRUE FALSE)
#ASSERT NOT (`Is my certificate of correction in the form the Law requires` TRUE TRUE FALSE TRUE FALSE)
#ASSERT NOT (`Is my corrected instrument in the form the Law requires` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`Is my corrected instrument in the form the Law requires` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`Is my corrected instrument in the form the Law requires` TRUE TRUE TRUE FALSE)
-- Section 103(i)(1): the affidavit needs its three parts (or the waiver), and the Secretary of State's three determinations.
#ASSERT NOT (`May the Secretary of State give my instrument the earlier filing date` TRUE TRUE FALSE FALSE TRUE TRUE TRUE 2)
#ASSERT NOT (`May the Secretary of State give my instrument the earlier filing date` TRUE FALSE TRUE FALSE TRUE TRUE TRUE 2)
#ASSERT NOT (`May the Secretary of State give my instrument the earlier filing date` FALSE TRUE TRUE FALSE TRUE TRUE TRUE 2)
#ASSERT NOT (`May the Secretary of State give my instrument the earlier filing date` FALSE FALSE FALSE TRUE FALSE TRUE TRUE 2)
#ASSERT NOT (`May the Secretary of State give my instrument the earlier filing date` FALSE FALSE FALSE TRUE TRUE FALSE TRUE 2)
#ASSERT NOT (`May the Secretary of State give my instrument the earlier filing date` FALSE FALSE FALSE TRUE TRUE TRUE FALSE 2)
-- Section 108(b): notice need not be given to anyone who attends, or who waives notice before or after the meeting.
#ASSERT NOT (`Must I give notice of the organization meeting to this incorporator or director` FALSE TRUE FALSE)
#ASSERT NOT (`Must I give notice of the organization meeting to this incorporator or director` FALSE FALSE TRUE)
-- Section 108(d): the person for whom an unavailable incorporator acted needs every condition.
#ASSERT NOT (`As the person for whom an unavailable incorporator acted, may I take the incorporator's action` FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`As the person for whom an unavailable incorporator acted, may I take the incorporator's action` TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`As the person for whom an unavailable incorporator acted, may I take the incorporator's action` TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`As the person for whom an unavailable incorporator acted, may I take the incorporator's action` TRUE TRUE TRUE TRUE FALSE)
-- Section 109(b): the same ban reaches a claim over which this title gives Chancery jurisdiction, and a claim a stockholder brought.
#ASSERT NOT (`May the bylaws make me liable for fees or expenses in a claim` TRUE FALSE TRUE FALSE)
#ASSERT NOT (`May the bylaws make me liable for fees or expenses in a claim` TRUE FALSE FALSE TRUE)
-- Section 110(a): without a quorum, a majority of the directors present may adopt; with one, the board must.
#ASSERT `Were the emergency bylaws validly adopted` TRUE FALSE 0 0 EQUALS JUST FALSE
#ASSERT `Were the emergency bylaws validly adopted` FALSE TRUE 2 3 EQUALS JUST TRUE
-- Section 110(a)(3), (g): each condition of the list is needed.
#ASSERT NOT (`Am I deemed a director at the emergency meeting because I am on the list` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`Am I deemed a director at the emergency meeting because I am on the list` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`Am I deemed a director at the emergency meeting because I am on the list` TRUE TRUE FALSE TRUE)
-- Section 110(i): with a quorum the board must act; without one, a majority of the directors present.
#ASSERT NOT (`May the board act on the stockholders' meeting during an emergency condition` `a nuclear or atomic disaster` TRUE FALSE TRUE)
-- The text does not say whether, when a quorum cannot be readily convened, the board's own action still counts or only that of a majority of the directors present (Fork register, F32).
-- The reading taken is that the board's action still counts. A first version of this case expected the other reading and failed; that first expectation is kept, failing on purpose, in dg1-cases-seat-first-reading.l4 (listed in check.sh) and recorded as a finding in NOTES.
#ASSERT `May the board act on the stockholders' meeting during an emergency condition` `a nuclear or atomic disaster` FALSE TRUE FALSE
-- Sections 112 and 113: each condition is needed.
#ASSERT NOT (`Can I require the corporation to include my nominee in its proxy solicitation materials` FALSE TRUE TRUE)
#ASSERT NOT (`Can I require the corporation to include my nominee in its proxy solicitation materials` TRUE TRUE FALSE)
#ASSERT NOT (`Can I require the corporation to reimburse the expenses of my proxy solicitation` TRUE FALSE TRUE)
#ASSERT NOT (`Can I require the corporation to reimburse the expenses of my proxy solicitation` TRUE TRUE FALSE)
-- Section 114(d)(2): a membership interest is a share of profits and losses, or a right to distributions, or both, unless the certificate provides otherwise.
#ASSERT `Does a member's interest count as a membership interest` FALSE FALSE TRUE
#ASSERT NOT (`Does a member's interest count as a membership interest` FALSE FALSE FALSE)
#ASSERT NOT (`Does a member's interest count as a membership interest` TRUE FALSE TRUE)
-- Section 115(c): each of the stockholder's three conditions is needed.
#ASSERT `Can the certificate or bylaws force me to bring a claim only in a prescribed forum` FALSE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Can the certificate or bylaws force me to bring a claim only in a prescribed forum` FALSE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Can the certificate or bylaws force me to bring a claim only in a prescribed forum` FALSE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
-- Section 116(a)(2): each of the four elements of an electronic signature is needed.
#ASSERT NOT (`Under section 116(a)(2), is my symbol or process an electronic signature` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`Under section 116(a)(2), is my symbol or process an electronic signature` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`Under section 116(a)(2), is my symbol or process an electronic signature` TRUE TRUE FALSE TRUE)
-- Section 116(a)(3): the system, the form and the retrieval are each needed.
#ASSERT `Under section 116(a)(3), is my electronic transmission deemed delivered to the recipient` FALSE FALSE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Under section 116(a)(3), is my electronic transmission deemed delivered to the recipient` FALSE TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Under section 116(a)(3), is my electronic transmission deemed delivered to the recipient` FALSE TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- Section 103(b)(2): a full formal acknowledgment before a person who has no seal is made, so the signature is not "without more".
#ASSERT NOT (`By signing alone, do I affirm under penalties of perjury that the facts stated are true` TRUE TRUE TRUE FALSE TRUE)
-- Section 103(f): a defectively executed instrument that has been filed may be corrected; an instrument that was not filed may not.
#ASSERT `May a filed instrument be corrected or nullified by a certificate of correction` TRUE FALSE TRUE
#ASSERT NOT (`May a filed instrument be corrected or nullified by a certificate of correction` FALSE TRUE FALSE)
-- Section 103(f): a certificate that nullifies needs the specification and the provision for nullification; setting out a corrected portion as well does not take it out of form.
#ASSERT `Is my certificate of correction in the form the Law requires` TRUE FALSE TRUE TRUE TRUE
