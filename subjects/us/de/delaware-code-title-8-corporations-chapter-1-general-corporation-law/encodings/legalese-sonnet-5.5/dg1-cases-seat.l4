#ASSERT NOT (`By signing alone, do I affirm under penalties of perjury that the facts stated are true` TRUE TRUE TRUE FALSE FALSE)
#ASSERT `As of what date must the facts I affirm by signing be true` (YearMonthDay 2026 3 1) FALSE (YearMonthDay 2026 1 1) EQUALS JUST (YearMonthDay 2026 3 1)
#ASSERT `As of what date must the facts I affirm by signing be true` (YearMonthDay 2026 3 1) TRUE (YearMonthDay 2026 4 1) EQUALS JUST (YearMonthDay 2026 4 1)
#ASSERT `As of what date must the facts I affirm by signing be true` (YearMonthDay 2026 3 1) TRUE (YearMonthDay 2026 7 1) EQUALS NOTHING
#ASSERT `Have I done everything that filing requires of me` TRUE TRUE
#ASSERT NOT (`Have I done everything that filing requires of me` TRUE FALSE)
#ASSERT `Must the Secretary of State certify my instrument as filed` TRUE TRUE FALSE
#ASSERT NOT (`Must the Secretary of State certify my instrument as filed` TRUE TRUE TRUE)
