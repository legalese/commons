IMPORT prelude
IMPORT `dg-core`
IMPORT `dg1-s116-documents`

-- Tests of section 116 (dg1-s116-documents.l4). Every expected value is written by hand from the text
-- (src:222-238), beside the assertion, and was decided before the module was run.

§ `Tests of section 116`

§§ `s 116(a)(1) documents`

#ASSERT `s 116(a)(1) the medium is a document` `a tangible medium on which information is inscribed, including handwritten, typed, printed or similar instruments, and copies of such instruments`
#ASSERT `s 116(a)(1) the medium is a document` `an electronic transmission`
#ASSERT NOT (`s 116(a)(1) the medium is a document` `another medium`)
-- an electronic transmission is deemed the equivalent of a written document
#ASSERT `s 116(a)(1) the medium is deemed the equivalent of a written document` `an electronic transmission`
#ASSERT `s 116(a)(1) the medium is deemed the equivalent of a written document` `a tangible medium on which information is inscribed, including handwritten, typed, printed or similar instruments, and copies of such instruments`
#ASSERT NOT (`s 116(a)(1) the medium is deemed the equivalent of a written document` `another medium`)

§§ `s 116(a)(2) signatures`

#ASSERT `s 116(a)(2) the form of signature may be used` `a manual signature` EQUALS JUST TRUE
#ASSERT `s 116(a)(2) the form of signature may be used` `a facsimile signature` EQUALS JUST TRUE
#ASSERT `s 116(a)(2) the form of signature may be used` `a conformed signature` EQUALS JUST TRUE
#ASSERT `s 116(a)(2) the form of signature may be used` `an electronic signature` EQUALS JUST TRUE
#ASSERT `s 116(a)(2) the form of signature may be used` `another form of signature` EQUALS NOTHING
-- an electronic signature: an electronic symbol or process, attached to or logically associated with a document, executed or adopted by a person with intent to execute, authenticate or adopt
#ASSERT `s 116(a)(2) the symbol or process is an electronic signature` TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 116(a)(2) the symbol or process is an electronic signature` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`s 116(a)(2) the symbol or process is an electronic signature` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 116(a)(2) the symbol or process is an electronic signature` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 116(a)(2) the symbol or process is an electronic signature` TRUE TRUE TRUE FALSE)
#ASSERT `s 116(a)(2) the person may execute a document with the person's signature` TRUE
#ASSERT NOT (`s 116(a)(2) the person may execute a document with the person's signature` FALSE)

§§ `s 116(a)(3) delivery`

-- facts, in order: agreed otherwise; entered the designated system; capable of being processed; person able to retrieve; a proxy or consent of a stockholder; the additional requirements met
#ASSERT `s 116(a)(3) the electronic transmission is deemed delivered to the person` FALSE TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 116(a)(3) the electronic transmission is deemed delivered to the person` FALSE FALSE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 116(a)(3) the electronic transmission is deemed delivered to the person` FALSE TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 116(a)(3) the electronic transmission is deemed delivered to the person` FALSE TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- a proxy or consent given by or on behalf of a stockholder is subject to the additional requirements
#ASSERT `s 116(a)(3) the electronic transmission is deemed delivered to the person` FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 116(a)(3) the electronic transmission is deemed delivered to the person` FALSE TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- unless otherwise agreed between the sender and recipient: the agreement governs
#ASSERT `s 116(a)(3) the electronic transmission is deemed delivered to the person` TRUE TRUE TRUE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 116(a)(3) the person has designated the information processing system` TRUE FALSE
#ASSERT `s 116(a)(3) the person has designated the information processing system` FALSE TRUE
#ASSERT NOT (`s 116(a)(3) the person has designated the information processing system` FALSE FALSE)
#ASSERT NOT (`s 116(a)(3) delivery requires that a person be aware of the receipt`)
#ASSERT `s 116(a)(3) the electronic acknowledgement establishes that the electronic transmission was received` TRUE
#ASSERT NOT (`s 116(a)(3) the electronic acknowledgement establishes that the electronic transmission was received` FALSE)
#ASSERT NOT (`s 116(a)(3) the electronic acknowledgement by itself establishes that the content sent corresponds to the content received`)
#ASSERT `s 116(a) this chapter does not prohibit conducting the transaction in accordance with Chapter 12A of Title 6` TRUE
#ASSERT NOT (`s 116(a) this chapter does not prohibit conducting the transaction in accordance with Chapter 12A of Title 6` FALSE)

§§ `s 116(b) exclusions`

#ASSERT NOT (`s 116(b) subsection (a) applies to the document` `a document filed with or submitted to the Secretary of State, the Register in Chancery, or a court or other judicial or governmental body of this State`)
#ASSERT NOT (`s 116(b) subsection (a) applies to the document` `a document comprising part of the stock ledger`)
#ASSERT NOT (`s 116(b) subsection (a) applies to the document` `a certificate representing a security`)
#ASSERT NOT (`s 116(b) subsection (a) applies to the document` `any document expressly referenced as a notice (or waiver of notice) by this chapter, the certificate of incorporation or the bylaws`)
#ASSERT NOT (`s 116(b) subsection (a) applies to the document` `a ballot to vote on actions at a meeting of stockholders`)
#ASSERT NOT (`s 116(b) subsection (a) applies to the document` `an act or transaction effected pursuant to § 280 of this title or subchapters III, XIII or XVI of this chapter`)
#ASSERT `s 116(b) subsection (a) applies to the document` `any other document`
#ASSERT NOT (`s 116(b) a presumption arises from the exclusions about the lawful means to document, sign or deliver`)
-- only an express restriction or prohibition limits subsection (a)
#ASSERT `s 116(b) the provision of the certificate of incorporation or the bylaws limits the application of subsection (a)` TRUE FALSE
#ASSERT `s 116(b) the provision of the certificate of incorporation or the bylaws limits the application of subsection (a)` FALSE TRUE
#ASSERT NOT (`s 116(b) the provision of the certificate of incorporation or the bylaws limits the application of subsection (a)` FALSE FALSE)

§§ `s 116(c)`

#ASSERT `s 116(c) this chapter controls` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 116(c) this chapter controls` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 116(c) this chapter controls` FALSE TRUE EQUALS NOTHING
