#ASSERT `s 373(a)(2) the foreign corporation is excused as one soliciting orders through salespersons` TRUE TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 373(a)(2) the foreign corporation is excused as one soliciting orders through salespersons` TRUE TRUE TRUE TRUE FALSE TRUE)
