#ASSERT NOT (`s 373(a)(3) the foreign corporation is excused as a seller of machinery, plants or equipment` FALSE TRUE TRUE)
#ASSERT NOT (`s 373(a)(3) the foreign corporation is excused as a seller of machinery, plants or equipment` TRUE FALSE TRUE)
#ASSERT NOT (`s 373(a)(3) the foreign corporation is excused as a seller of machinery, plants or equipment` TRUE TRUE FALSE)
#ASSERT `s 373(a)(4) the foreign corporation is excused because its operations are wholly interstate` TRUE
#ASSERT NOT (`s 373(a)(4) the foreign corporation is excused because its operations are wholly interstate` FALSE)
#ASSERT `s 373(a)(5) the foreign corporation is excused as an insurance company` TRUE
#ASSERT `s 373(a)(6) the foreign corporation is excused because it creates or acquires evidences of debt, mortgages or liens` TRUE
#ASSERT `s 373(a)(7) the foreign corporation is excused because it secures or collects debts or enforces rights in property securing them` TRUE
-- Any one of the seven excuses it.
#ASSERT `s 373(a) the foreign corporation is not required to comply with ss 371 and 372` TRUE FALSE FALSE FALSE FALSE FALSE FALSE
#ASSERT `s 373(a) the foreign corporation is not required to comply with ss 371 and 372` FALSE TRUE FALSE FALSE FALSE FALSE FALSE
#ASSERT `s 373(a) the foreign corporation is not required to comply with ss 371 and 372` FALSE FALSE TRUE FALSE FALSE FALSE FALSE
#ASSERT `s 373(a) the foreign corporation is not required to comply with ss 371 and 372` FALSE FALSE FALSE TRUE FALSE FALSE FALSE
#ASSERT `s 373(a) the foreign corporation is not required to comply with ss 371 and 372` FALSE FALSE FALSE FALSE TRUE FALSE FALSE
#ASSERT `s 373(a) the foreign corporation is not required to comply with ss 371 and 372` FALSE FALSE FALSE FALSE FALSE TRUE FALSE
#ASSERT `s 373(a) the foreign corporation is not required to comply with ss 371 and 372` FALSE FALSE FALSE FALSE FALSE FALSE TRUE
#ASSERT NOT (`s 373(a) the foreign corporation is not required to comply with ss 371 and 372` FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
-- (b): the exception settles nothing about service and suit under s 382.
#ASSERT NOT (`s 373(b) the exception settles whether the foreign corporation is subject to service of process and suit in this State` TRUE)
#ASSERT NOT (`s 373(b) the exception settles whether the foreign corporation is subject to service of process and suit in this State` FALSE)

§ `s 374: annual report`

#ASSERT `s 374 the last day to file the annual report for the year` 2027 EQUALS (YearMonthDay 2027 6 30)
#ASSERT `s 374 the annual report was filed in time` 2027 (YearMonthDay 2027 6 30)
#ASSERT `s 374 the annual report was filed in time` 2027 (YearMonthDay 2027 1 2)
#ASSERT NOT (`s 374 the annual report was filed in time` 2027 (YearMonthDay 2027 7 1))
#ASSERT `s 374 the foreign corporation must file an annual report with the Secretary of State` TRUE
#ASSERT NOT (`s 374 the foreign corporation must file an annual report with the Secretary of State` FALSE)
#ASSERT `s 374 the person may sign the annual report` `the corporation's president under s 374` FALSE TRUE
#ASSERT `s 374 the person may sign the annual report` `the corporation's secretary under s 374` FALSE TRUE
#ASSERT `s 374 the person may sign the annual report` `the corporation's treasurer under s 374` FALSE TRUE
#ASSERT `s 374 the person may sign the annual report` `another proper officer duly authorized so to act under s 374` FALSE TRUE
#ASSERT `s 374 the person may sign the annual report` `one of the corporation's directors under s 374` FALSE TRUE
-- An incorporator may sign only an initial report, the board not having been elected.
#ASSERT `s 374 the person may sign the annual report` `an incorporator under s 374` TRUE FALSE
#ASSERT NOT (`s 374 the person may sign the annual report` `an incorporator under s 374` FALSE FALSE)
#ASSERT NOT (`s 374 the person may sign the annual report` `an incorporator under s 374` TRUE TRUE)
#ASSERT NOT (`s 374 the person may sign the annual report` `a person who is none of these under s 374` TRUE FALSE)
#ASSERT `s 374 the report is made and signed as the section requires` TRUE TRUE TRUE
#ASSERT NOT (`s 374 the report is made and signed as the section requires` FALSE TRUE TRUE)
#ASSERT NOT (`s 374 the report is made and signed as the section requires` TRUE FALSE TRUE)
#ASSERT NOT (`s 374 the report is made and signed as the section requires` TRUE TRUE FALSE)
#ASSERT `s 374 the signature is prima facie evidence that the individual is authorized to certify the report` TRUE
#ASSERT `s 374(1) the report contains the location of the registered office` TRUE
#ASSERT `s 374(2) the report contains the name of the agent for service of process` TRUE
#ASSERT `s 374(3) the report contains the location of the principal place of business` TRUE
#ASSERT `s 374(4) the report contains the names and addresses of the directors and of the signing officer` TRUE TRUE
#ASSERT NOT (`s 374(4) the report contains the names and addresses of the directors and of the signing officer` TRUE FALSE)
#ASSERT NOT (`s 374(4) the report contains the names and addresses of the directors and of the signing officer` FALSE TRUE)
#ASSERT `s 374 the officer or director is guilty of perjury` TRUE TRUE
#ASSERT NOT (`s 374 the officer or director is guilty of perjury` TRUE FALSE)
#ASSERT NOT (`s 374 the officer or director is guilty of perjury` FALSE TRUE)

§ `s 375: failure to file the report`

#ASSERT `s 375 the Secretary of State may investigate the reasons for the failure` TRUE
#ASSERT NOT (`s 375 the Secretary of State may investigate the reasons for the failure` FALSE)
-- No report within any 2-year period: last report 15 January 2025; the 2 years end on 15 January 2027.
#ASSERT `s 375 the Secretary of State must terminate the right of the foreign corporation to do business within this State` (JUST (YearMonthDay 2025 1 15)) (YearMonthDay 2027 1 15) EQUALS JUST FALSE
#ASSERT `s 375 the Secretary of State must terminate the right of the foreign corporation to do business within this State` (JUST (YearMonthDay 2025 1 15)) (YearMonthDay 2027 1 16) EQUALS JUST TRUE
#ASSERT `s 375 the Secretary of State must terminate the right of the foreign corporation to do business within this State` (JUST (YearMonthDay 2025 1 15)) (YearMonthDay 2026 6 1) EQUALS JUST FALSE
-- Never filed: the text does not say from when the 2 years run.
#ASSERT `s 375 the Secretary of State must terminate the right of the foreign corporation to do business within this State` NOTHING (YearMonthDay 2027 1 16) EQUALS NOTHING

§ `s 376: service on a qualified foreign corporation`

#ASSERT `s 376(a) the process, order, rule or notice may be served on the person` TRUE TRUE TRUE FALSE
#ASSERT `s 376(a) the process, order, rule or notice may be served on the person` TRUE FALSE FALSE TRUE
#ASSERT NOT (`s 376(a) the process, order, rule or notice may be served on the person` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 376(a) the process, order, rule or notice may be served on the person` FALSE TRUE TRUE FALSE)
#ASSERT NOT (`s 376(a) the process, order, rule or notice may be served on the person` TRUE FALSE FALSE FALSE)
#ASSERT `s 376(b) service on the Secretary of State is as effectual as service under subsection (a)` TRUE FALSE FALSE
#ASSERT NOT (`s 376(b) service on the Secretary of State is as effectual as service under subsection (a)` FALSE FALSE FALSE)
#ASSERT `s 376(b) service on the Secretary of State is as effectual as service under subsection (a)` TRUE TRUE TRUE
#ASSERT NOT (`s 376(b) service on the Secretary of State is as effectual as service under subsection (a)` TRUE TRUE FALSE)
-- The letter goes to the principal place of business on the last annual report, or else the last registered office.
#ASSERT `s 376(b) the letter is addressed as the subsection requires` TRUE TRUE FALSE
#ASSERT NOT (`s 376(b) the letter is addressed as the subsection requires` TRUE FALSE TRUE)
#ASSERT `s 376(b) the letter is addressed as the subsection requires` FALSE FALSE TRUE
#ASSERT NOT (`s 376(b) the letter is addressed as the subsection requires` FALSE TRUE FALSE)

`dg10 test letter` MEANS `s 321(b) Letter from the Secretary of State` WITH
    `the Secretary of State sent the letter forthwith` IS TRUE
    `the letter was sent by mail or courier with a record of mailing or deposit and a record of delivery signed` IS TRUE
    `the letter enclosed a copy of the process and any other papers served on the Secretary of State` IS TRUE

`dg10 test late letter` MEANS `s 321(b) Letter from the Secretary of State` WITH
    `the Secretary of State sent the letter forthwith` IS FALSE
    `the letter was sent by mail or courier with a record of mailing or deposit and a record of delivery signed` IS TRUE
    `the letter enclosed a copy of the process and any other papers served on the Secretary of State` IS TRUE

`dg10 test steps` MEANS `s 321(b) Plaintiff's steps` WITH
    `the plaintiff served the process and any other papers in duplicate` IS TRUE
    `the plaintiff notified the Secretary of State that service was being effected so` IS TRUE
    `the amount the plaintiff paid the Secretary of State for the use of the State` IS 75

`dg10 test record` MEANS `s 321(b) Record of service` WITH
    `the record is alphabetical` IS TRUE
    `the record gives the name of the plaintiff and defendant` IS TRUE
    `the record gives the title, docket number and nature of the proceeding` IS TRUE
    `the record gives the fact that service has been effected through the Secretary of State` IS TRUE
    `the record gives the return date` IS TRUE
    `the record gives the day and hour when the service was made` IS FALSE

-- The wrappers of ss 376(b), 381(d) and 382(c) give the same answers as s 321(b)'s rules (fee 75 paid in full; the
-- record lacks the day and hour; the letter late).
#ASSERT `s 376(b) the Secretary of State's letter meets the subsection` `dg10 test letter` TRUE
#ASSERT NOT (`s 376(b) the Secretary of State's letter meets the subsection` `dg10 test late letter` TRUE)
#ASSERT `s 376(b) the plaintiff has done what the subsection requires` `dg10 test steps` 75
#ASSERT NOT (`s 376(b) the plaintiff has done what the subsection requires` `dg10 test steps` 76)
#ASSERT `s 376(b) the fee is taxed as part of the costs` TRUE
#ASSERT NOT (`s 376(b) the record of service lists what the subsection requires` `dg10 test record`)
#ASSERT `s 376(b) the Secretary of State must still retain the record of service` (YearMonthDay 2020 1 15) (YearMonthDay 2025 1 15)
#ASSERT NOT (`s 376(b) the Secretary of State must still retain the record of service` (YearMonthDay 2020 1 15) (YearMonthDay 2025 1 16))

