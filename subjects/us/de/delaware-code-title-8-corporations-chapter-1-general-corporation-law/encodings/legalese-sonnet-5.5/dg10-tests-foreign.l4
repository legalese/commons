IMPORT prelude
IMPORT daydate
IMPORT `dg-core`
IMPORT `dg10-sos-service`
IMPORT `dg10-foreign-qualification`
IMPORT `dg10-foreign-withdrawal-and-suits`

-- Tests of dg10-foreign-qualification.l4 and dg10-foreign-withdrawal-and-suits.l4 (ss 371-385).
-- Every expected value is written by hand from the text (src:1831-1934) beside the assertion, before the run.

§ `Fixtures`

GIVEN dated IS A DATE
      issued IS A BOOLEAN
      evidences IS A BOOLEAN
      foreign IS A BOOLEAN
      translated IS A BOOLEAN
GIVETH A `s 371(b)(1) Certificate of corporate existence`
`dg10 test existence certificate` dated issued evidences foreign translated MEANS
    `s 371(b)(1) Certificate of corporate existence` WITH
        `the date of the certificate` IS dated
        `the certificate was issued by an authorized officer of the jurisdiction of incorporation` IS issued
        `the certificate evidences the foreign corporation's corporate existence` IS evidences
        `the certificate is in a foreign language` IS foreign
        `a translation of the certificate, under oath of the translator, is attached` IS translated

GIVEN executed IS A BOOLEAN
      agent IS A BOOLEAN
      allowed IS A BOOLEAN
      dated IS A DATE
      assets IS A BOOLEAN
      business IS A BOOLEAN
      acknowledged IS A BOOLEAN
GIVETH A `s 371(b)(2) Statement of the foreign corporation`
`dg10 test statement` executed agent allowed dated assets business acknowledged MEANS
    `s 371(b)(2) Statement of the foreign corporation` WITH
        `the statement was executed by an authorized officer of the corporation` IS executed
        `the statement sets forth the name and address of its registered agent in this State` IS agent
        `the registered agent is one that s 371(b)(2)(i) allows` IS allowed
        `the date as of which the statement of the assets and liabilities of the corporation is made` IS dated
        `the statement sets forth the assets and liabilities of the corporation` IS assets
        `the statement sets forth the business the corporation proposes to do in this State and that it is authorized to do that business in the jurisdiction of its incorporation` IS business
        `the statement was acknowledged in accordance with s 103` IS acknowledged

§ `s 371: definition and qualification`

#ASSERT NOT (`s 371(a) the corporation is a foreign corporation` `this State`)
#ASSERT `s 371(a) the corporation is a foreign corporation` `another jurisdiction of the United States`
#ASSERT `s 371(a) the corporation is a foreign corporation` `a foreign jurisdiction outside the United States`
-- (b)(1): not earlier than 6 months prior to the filing date. Filing 15 September 2027: 15 March 2027 is in time.
#ASSERT `s 371(b)(1) the certificate meets the paragraph` (`dg10 test existence certificate` (YearMonthDay 2027 3 15) TRUE TRUE FALSE FALSE) (YearMonthDay 2027 9 15)
#ASSERT NOT (`s 371(b)(1) the certificate meets the paragraph` (`dg10 test existence certificate` (YearMonthDay 2027 3 14) TRUE TRUE FALSE FALSE) (YearMonthDay 2027 9 15))
#ASSERT `s 371(b)(1) the certificate meets the paragraph` (`dg10 test existence certificate` (YearMonthDay 2027 9 15) TRUE TRUE FALSE FALSE) (YearMonthDay 2027 9 15)
-- Filing 31 August 2027: six months before clamps to 28 February 2027 (the core's reading, fork F4).
#ASSERT `s 371(b)(1) the certificate meets the paragraph` (`dg10 test existence certificate` (YearMonthDay 2027 2 28) TRUE TRUE FALSE FALSE) (YearMonthDay 2027 8 31)
#ASSERT NOT (`s 371(b)(1) the certificate meets the paragraph` (`dg10 test existence certificate` (YearMonthDay 2027 2 27) TRUE TRUE FALSE FALSE) (YearMonthDay 2027 8 31))
#ASSERT NOT (`s 371(b)(1) the certificate meets the paragraph` (`dg10 test existence certificate` (YearMonthDay 2027 6 1) FALSE TRUE FALSE FALSE) (YearMonthDay 2027 9 15))
#ASSERT NOT (`s 371(b)(1) the certificate meets the paragraph` (`dg10 test existence certificate` (YearMonthDay 2027 6 1) TRUE FALSE FALSE FALSE) (YearMonthDay 2027 9 15))
-- A certificate in a foreign language needs a translation under oath of the translator.
#ASSERT NOT (`s 371(b)(1) the certificate meets the paragraph` (`dg10 test existence certificate` (YearMonthDay 2027 6 1) TRUE TRUE TRUE FALSE) (YearMonthDay 2027 9 15))
#ASSERT `s 371(b)(1) the certificate meets the paragraph` (`dg10 test existence certificate` (YearMonthDay 2027 6 1) TRUE TRUE TRUE TRUE) (YearMonthDay 2027 9 15)
-- (b)(2)(i): the registered agent.
#ASSERT `s 371(b)(2)(i) the registered agent is one that the subparagraph allows` TRUE `a natural person` FALSE
#ASSERT `s 371(b)(2)(i) the registered agent is one that the subparagraph allows` FALSE `a natural person` TRUE
#ASSERT NOT (`s 371(b)(2)(i) the registered agent is one that the subparagraph allows` FALSE `a natural person` FALSE)
#ASSERT `s 371(b)(2)(i) the registered agent is one that the subparagraph allows` FALSE (`a corporation` `a stock corporation`) FALSE
#ASSERT `s 371(b)(2)(i) the registered agent is one that the subparagraph allows` FALSE `a general partnership` FALSE
#ASSERT `s 371(b)(2)(i) the registered agent is one that the subparagraph allows` FALSE `a limited partnership` FALSE
#ASSERT `s 371(b)(2)(i) the registered agent is one that the subparagraph allows` FALSE `a limited liability partnership` FALSE
#ASSERT `s 371(b)(2)(i) the registered agent is one that the subparagraph allows` FALSE `a limited liability limited partnership` FALSE
#ASSERT `s 371(b)(2)(i) the registered agent is one that the subparagraph allows` FALSE `a limited liability company` FALSE
#ASSERT `s 371(b)(2)(i) the registered agent is one that the subparagraph allows` FALSE `a statutory trust` FALSE
-- Kinds the list does not name.
#ASSERT NOT (`s 371(b)(2)(i) the registered agent is one that the subparagraph allows` FALSE `a business trust or association` FALSE)
#ASSERT NOT (`s 371(b)(2)(i) the registered agent is one that the subparagraph allows` FALSE `a real estate investment trust` FALSE)
#ASSERT NOT (`s 371(b)(2)(i) the registered agent is one that the subparagraph allows` FALSE `a common-law trust` FALSE)
#ASSERT NOT (`s 371(b)(2)(i) the registered agent is one that the subparagraph allows` FALSE `a joint-stock association` FALSE)
#ASSERT NOT (`s 371(b)(2)(i) the registered agent is one that the subparagraph allows` FALSE `any other unincorporated business or association` FALSE)
-- (b)(2): the statement.
#ASSERT `s 371(b)(2) the statement meets the paragraph` (`dg10 test statement` TRUE TRUE TRUE (YearMonthDay 2027 3 15) TRUE TRUE TRUE) (YearMonthDay 2027 9 15)
#ASSERT NOT (`s 371(b)(2) the statement meets the paragraph` (`dg10 test statement` TRUE TRUE TRUE (YearMonthDay 2027 3 14) TRUE TRUE TRUE) (YearMonthDay 2027 9 15))
#ASSERT NOT (`s 371(b)(2) the statement meets the paragraph` (`dg10 test statement` FALSE TRUE TRUE (YearMonthDay 2027 3 15) TRUE TRUE TRUE) (YearMonthDay 2027 9 15))
#ASSERT NOT (`s 371(b)(2) the statement meets the paragraph` (`dg10 test statement` TRUE FALSE TRUE (YearMonthDay 2027 3 15) TRUE TRUE TRUE) (YearMonthDay 2027 9 15))
#ASSERT NOT (`s 371(b)(2) the statement meets the paragraph` (`dg10 test statement` TRUE TRUE FALSE (YearMonthDay 2027 3 15) TRUE TRUE TRUE) (YearMonthDay 2027 9 15))
#ASSERT NOT (`s 371(b)(2) the statement meets the paragraph` (`dg10 test statement` TRUE TRUE TRUE (YearMonthDay 2027 3 15) FALSE TRUE TRUE) (YearMonthDay 2027 9 15))
#ASSERT NOT (`s 371(b)(2) the statement meets the paragraph` (`dg10 test statement` TRUE TRUE TRUE (YearMonthDay 2027 3 15) TRUE FALSE TRUE) (YearMonthDay 2027 9 15))
#ASSERT NOT (`s 371(b)(2) the statement meets the paragraph` (`dg10 test statement` TRUE TRUE TRUE (YearMonthDay 2027 3 15) TRUE TRUE FALSE) (YearMonthDay 2027 9 15))
-- (b): $80 and both filings.
#ASSERT `s 371(b) the foreign corporation has paid and filed what the subsection requires` 80 (`dg10 test existence certificate` (YearMonthDay 2027 6 1) TRUE TRUE FALSE FALSE) (`dg10 test statement` TRUE TRUE TRUE (YearMonthDay 2027 6 1) TRUE TRUE TRUE) (YearMonthDay 2027 9 15)
#ASSERT NOT (`s 371(b) the foreign corporation has paid and filed what the subsection requires` 79 (`dg10 test existence certificate` (YearMonthDay 2027 6 1) TRUE TRUE FALSE FALSE) (`dg10 test statement` TRUE TRUE TRUE (YearMonthDay 2027 6 1) TRUE TRUE TRUE) (YearMonthDay 2027 9 15))
#ASSERT NOT (`s 371(b) the foreign corporation has paid and filed what the subsection requires` 80 (`dg10 test existence certificate` (YearMonthDay 2026 6 1) TRUE TRUE FALSE FALSE) (`dg10 test statement` TRUE TRUE TRUE (YearMonthDay 2027 6 1) TRUE TRUE TRUE) (YearMonthDay 2027 9 15))
#ASSERT NOT (`s 371(b) the foreign corporation has paid and filed what the subsection requires` 80 (`dg10 test existence certificate` (YearMonthDay 2027 6 1) TRUE TRUE FALSE FALSE) (`dg10 test statement` TRUE TRUE TRUE (YearMonthDay 2026 6 1) TRUE TRUE TRUE) (YearMonthDay 2027 9 15))
#ASSERT `s 371(b) the foreign corporation may do business in this State through branch offices, agents or representatives located here` TRUE FALSE
#ASSERT `s 371(b) the foreign corporation may do business in this State through branch offices, agents or representatives located here` FALSE TRUE
#ASSERT NOT (`s 371(b) the foreign corporation may do business in this State through branch offices, agents or representatives located here` FALSE FALSE)
-- (c)
#ASSERT `s 371(c) the certificate of the Secretary of State is prima facie evidence of the right to do business in this State` TRUE
#ASSERT `s 371(c) the Secretary of State may issue the certificate as to the name` TRUE FALSE
#ASSERT `s 371(c) the Secretary of State may issue the certificate as to the name` FALSE TRUE
#ASSERT NOT (`s 371(c) the Secretary of State may issue the certificate as to the name` FALSE FALSE)
#ASSERT `s 371(c) the foreign corporation may qualify to do business under an assumed name` TRUE TRUE TRUE
#ASSERT NOT (`s 371(c) the foreign corporation may qualify to do business under an assumed name` TRUE FALSE TRUE)
#ASSERT NOT (`s 371(c) the foreign corporation may qualify to do business under an assumed name` TRUE TRUE FALSE)
#ASSERT NOT (`s 371(c) the foreign corporation may qualify to do business under an assumed name` FALSE TRUE TRUE)

§ `s 372: changes`

#ASSERT `s 372(a) the last day for the foreign corporation to file the certificate of change` (YearMonthDay 2027 1 15) EQUALS (YearMonthDay 2027 2 14)
#ASSERT `s 372(a) the last day for the foreign corporation to file the certificate of change` (YearMonthDay 2027 12 15) EQUALS (YearMonthDay 2028 1 14)
#ASSERT `s 372(b) the last day for the surviving foreign corporation to file the certificate attesting to the merger` (YearMonthDay 2027 1 31) EQUALS (YearMonthDay 2027 3 2)

GIVEN namechanged IS A BOOLEAN
      businesschanged IS A BOOLEAN
      name IS A BOOLEAN
      jurisdiction IS A BOOLEAN
      authorized IS A BOOLEAN
      relinquished IS A BOOLEAN
      newname IS A BOOLEAN
      effected IS A BOOLEAN
      reflecting IS A BOOLEAN
      athome IS A BOOLEAN
GIVETH A `s 372(a) Certificate of change`
`dg10 test change` namechanged businesschanged name jurisdiction authorized relinquished newname effected reflecting athome MEANS
    `s 372(a) Certificate of change` WITH
        `the foreign corporation changed its corporate name` IS namechanged
        `the foreign corporation enlarged, limited or otherwise changed the business it proposes to do in this State` IS businesschanged
        `the certificate sets forth the name of the foreign corporation as it appears on the records of the Secretary of State` IS name
        `the certificate sets forth the jurisdiction of its incorporation` IS jurisdiction
        `the certificate sets forth the date it was authorized to do business in this State` IS authorized
        `the certificate states the name relinquished` IS relinquished
        `the certificate states the new name` IS newname
        `the certificate states that the change of name has been effected under the laws of the jurisdiction of its incorporation and the date it was effected` IS effected
        `the certificate contains a statement reflecting the change in the business` IS reflecting
        `the certificate states that the foreign corporation is authorized to do in the jurisdiction of its incorporation the business it proposes to do in this State` IS athome

-- A change of name only.
#ASSERT `s 372(a) the certificate of change sets forth what the subsection requires` (`dg10 test change` TRUE FALSE TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE)
#ASSERT NOT (`s 372(a) the certificate of change sets forth what the subsection requires` (`dg10 test change` TRUE FALSE FALSE TRUE TRUE TRUE TRUE TRUE FALSE FALSE))
#ASSERT NOT (`s 372(a) the certificate of change sets forth what the subsection requires` (`dg10 test change` TRUE FALSE TRUE FALSE TRUE TRUE TRUE TRUE FALSE FALSE))
#ASSERT NOT (`s 372(a) the certificate of change sets forth what the subsection requires` (`dg10 test change` TRUE FALSE TRUE TRUE FALSE TRUE TRUE TRUE FALSE FALSE))
#ASSERT NOT (`s 372(a) the certificate of change sets forth what the subsection requires` (`dg10 test change` TRUE FALSE TRUE TRUE TRUE FALSE TRUE TRUE FALSE FALSE))
#ASSERT NOT (`s 372(a) the certificate of change sets forth what the subsection requires` (`dg10 test change` TRUE FALSE TRUE TRUE TRUE TRUE FALSE TRUE FALSE FALSE))
#ASSERT NOT (`s 372(a) the certificate of change sets forth what the subsection requires` (`dg10 test change` TRUE FALSE TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE))
-- A change of business only.
#ASSERT `s 372(a) the certificate of change sets forth what the subsection requires` (`dg10 test change` FALSE TRUE TRUE TRUE TRUE FALSE FALSE FALSE TRUE TRUE)
#ASSERT NOT (`s 372(a) the certificate of change sets forth what the subsection requires` (`dg10 test change` FALSE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE TRUE))
#ASSERT NOT (`s 372(a) the certificate of change sets forth what the subsection requires` (`dg10 test change` FALSE TRUE TRUE TRUE TRUE FALSE FALSE FALSE TRUE FALSE))
-- Both.
#ASSERT `s 372(a) the certificate of change sets forth what the subsection requires` (`dg10 test change` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE)
-- (b), (c)
#ASSERT `s 372(b) the certificate attesting to the merger is as the subsection requires` TRUE TRUE
#ASSERT NOT (`s 372(b) the certificate attesting to the merger is as the subsection requires` FALSE TRUE)
#ASSERT NOT (`s 372(b) the certificate attesting to the merger is as the subsection requires` TRUE FALSE)
#ASSERT `s 372(b) the surviving foreign corporation must also comply with subsection (a)` TRUE FALSE
#ASSERT `s 372(b) the surviving foreign corporation must also comply with subsection (a)` FALSE TRUE
#ASSERT NOT (`s 372(b) the surviving foreign corporation must also comply with subsection (a)` FALSE FALSE)
#ASSERT `s 372(c) the foreign corporation must comply with s 381` TRUE
#ASSERT NOT (`s 372(c) the foreign corporation must comply with s 381` FALSE)
-- (d): $50 for each certificate under (a) or (b); a further $50 on a change of name.
#ASSERT `s 372(d) the amount to be paid to the Secretary of State` 1 FALSE EQUALS 50
#ASSERT `s 372(d) the amount to be paid to the Secretary of State` 1 TRUE EQUALS 100
#ASSERT `s 372(d) the amount to be paid to the Secretary of State` 2 FALSE EQUALS 100
#ASSERT `s 372(d) the amount to be paid to the Secretary of State` 2 TRUE EQUALS 150

