IMPORT prelude
IMPORT daydate
IMPORT `dg-core`
IMPORT `dg2-support`
IMPORT `dg2-board-action`

-- Tests of dg2-board-action.l4 (8 Del. C. section 141(d) to (i) and (k)). Expected values are written by hand from src:369 to src:379
-- of de-code-t8-ch1-2026-10-01.txt, beside each assertion, before the run.

§ `Section 141(d)`

-- src:369: classes by the certificate, an initial bylaw, or a bylaw adopted by a vote of the stockholders; 1, 2 or 3 classes.
#ASSERT `s 141(d) the directors may be divided into classes by the instrument` `the certificate of incorporation, under s 141(d)` 3
#ASSERT `s 141(d) the directors may be divided into classes by the instrument` `an initial bylaw, under s 141(d)` 1
#ASSERT `s 141(d) the directors may be divided into classes by the instrument` `a bylaw adopted by a vote of the stockholders, under s 141(d)` 2
#ASSERT NOT `s 141(d) the directors may be divided into classes by the instrument` `a bylaw adopted by the directors alone, under s 141(d)` 2
#ASSERT NOT `s 141(d) the directors may be divided into classes by the instrument` `the certificate of incorporation, under s 141(d)` 4
#ASSERT NOT `s 141(d) the directors may be divided into classes by the instrument` `the certificate of incorporation, under s 141(d)` 0

-- src:369: first class expires at the first annual meeting after classification; the second 1 year thereafter; the third 2 years thereafter.
#ASSERT `s 141(d) the date the term of the class expires` 1 (YearMonthDay 2027 5 10) EQUALS JUST (YearMonthDay 2027 5 10)
#ASSERT `s 141(d) the date the term of the class expires` 2 (YearMonthDay 2027 5 10) EQUALS JUST (YearMonthDay 2028 5 10)
#ASSERT `s 141(d) the date the term of the class expires` 3 (YearMonthDay 2027 5 10) EQUALS JUST (YearMonthDay 2029 5 10)
-- A fourth class, or class 0, is not in the text.
#ASSERT `s 141(d) the date the term of the class expires` 4 (YearMonthDay 2027 5 10) EQUALS NOTHING
#ASSERT `s 141(d) the date the term of the class expires` 0 (YearMonthDay 2027 5 10) EQUALS NOTHING
-- 29 February 2028 plus 1 year: the core's calendar arithmetic gives 28 February 2029 (core Fork F2).
#ASSERT `s 141(d) the date the term of the class expires` 2 (YearMonthDay 2028 2 29) EQUALS JUST (YearMonthDay 2029 2 28)

#ASSERT `s 141(d) the board may assign the directors in office to the classes` TRUE EQUALS JUST TRUE
#ASSERT `s 141(d) the board may assign the directors in office to the classes` FALSE EQUALS NOTHING

#ASSERT `s 141(d) the holders of a class or series of stock may be given the right to elect directors` `in the certificate of incorporation`
#ASSERT NOT `s 141(d) the holders of a class or series of stock may be given the right to elect directors` `in the bylaws`
#ASSERT NOT `s 141(d) the holders of a class or series of stock may be given the right to elect directors` `in none of these`
#ASSERT `s 141(d) a director may be given greater or lesser voting power than other directors` `in the certificate of incorporation`
#ASSERT NOT `s 141(d) a director may be given greater or lesser voting power than other directors` `in the bylaws`

-- src:369: the greater or lesser voting power applies in committees unless the certificate or the bylaws provide otherwise.
#ASSERT `s 141(d) the greater or lesser voting power applies to voting in a committee` `in none of these`
#ASSERT NOT `s 141(d) the greater or lesser voting power applies to voting in a committee` `in the certificate of incorporation`
#ASSERT NOT `s 141(d) the greater or lesser voting power applies to voting in a committee` `in the bylaws`
#ASSERT `s 141(d) the greater or lesser voting power applies to voting in a committee` `in a resolution of the board of directors`

#ASSERT `s 141(d) a majority or other proportion of the directors is a proportion of the votes of the directors` TRUE
#ASSERT NOT `s 141(d) a majority or other proportion of the directors is a proportion of the votes of the directors` FALSE

§ `Section 141(e)`

-- src:370. The arguments: member, relied in good faith, what relied on, believes within competence, selected with reasonable care.
#ASSERT `s 141(e) the member is fully protected in relying` TRUE TRUE `the records of the corporation` FALSE FALSE
#ASSERT `s 141(e) the member is fully protected in relying` TRUE TRUE `information, opinions, reports or statements presented to the corporation by an officer or employee of the corporation` FALSE FALSE
#ASSERT `s 141(e) the member is fully protected in relying` TRUE TRUE `information, opinions, reports or statements presented to the corporation by a committee of the board of directors` FALSE FALSE
#ASSERT `s 141(e) the member is fully protected in relying` TRUE TRUE `information, opinions, reports or statements presented to the corporation by any other person` TRUE TRUE
#ASSERT NOT `s 141(e) the member is fully protected in relying` TRUE TRUE `information, opinions, reports or statements presented to the corporation by any other person` FALSE TRUE
#ASSERT NOT `s 141(e) the member is fully protected in relying` TRUE TRUE `information, opinions, reports or statements presented to the corporation by any other person` TRUE FALSE
#ASSERT NOT `s 141(e) the member is fully protected in relying` TRUE FALSE `the records of the corporation` TRUE TRUE
#ASSERT NOT `s 141(e) the member is fully protected in relying` FALSE TRUE `the records of the corporation` TRUE TRUE

§ `Section 141(f)`

-- src:371: all members consent in writing or by electronic transmission; documented as section 116 permits; not restricted.
#ASSERT `s 141(f) the board or committee may act without a meeting` 5 5 TRUE `in none of these`
#ASSERT NOT `s 141(f) the board or committee may act without a meeting` 5 4 TRUE `in none of these`
#ASSERT NOT `s 141(f) the board or committee may act without a meeting` 5 5 FALSE `in none of these`
#ASSERT NOT `s 141(f) the board or committee may act without a meeting` 5 5 TRUE `in the certificate of incorporation`
#ASSERT NOT `s 141(f) the board or committee may act without a meeting` 5 5 TRUE `in the bylaws`
-- A restriction said to be made only in a board resolution is not one the text recognises.
#ASSERT `s 141(f) the board or committee may act without a meeting` 5 5 TRUE `in a resolution of the board of directors`
#ASSERT `s 141(f) the board or committee may act without a meeting` 1 1 TRUE `in none of these`
#ASSERT NOT `s 141(f) the board or committee may act without a meeting` 0 0 TRUE `in none of these`

-- src:371: a consent effective at a future time no later than 60 days after the instruction: 10 January 2026 plus 60 days is 11 March 2026.
#ASSERT `s 141(f) the consent is deemed given at its effective time` (YearMonthDay 2026 1 10) (YearMonthDay 2026 3 11) TRUE FALSE
#ASSERT NOT `s 141(f) the consent is deemed given at its effective time` (YearMonthDay 2026 1 10) (YearMonthDay 2026 3 12) TRUE FALSE
#ASSERT `s 141(f) the consent is deemed given at its effective time` (YearMonthDay 2026 1 10) (YearMonthDay 2026 1 10) TRUE FALSE
#ASSERT NOT `s 141(f) the consent is deemed given at its effective time` (YearMonthDay 2026 1 10) (YearMonthDay 2026 2 1) FALSE FALSE
#ASSERT NOT `s 141(f) the consent is deemed given at its effective time` (YearMonthDay 2026 1 10) (YearMonthDay 2026 2 1) TRUE TRUE

-- src:371: revocable before it becomes effective; after that the text does not say.
#ASSERT `s 141(f) the consent may be revoked` FALSE EQUALS JUST TRUE
#ASSERT `s 141(f) the consent may be revoked` TRUE EQUALS NOTHING

#ASSERT `s 141(f) the consents have been filed as the Law requires` TRUE TRUE
#ASSERT NOT `s 141(f) the consents have been filed as the Law requires` TRUE FALSE
#ASSERT NOT `s 141(f) the consents have been filed as the Law requires` FALSE TRUE

§ `Section 141(g), (h), (i)`

#ASSERT `s 141(g) the board may hold its meetings, and have an office or offices, outside this State` `in none of these`
#ASSERT NOT `s 141(g) the board may hold its meetings, and have an office or offices, outside this State` `in the certificate of incorporation`
#ASSERT NOT `s 141(g) the board may hold its meetings, and have an office or offices, outside this State` `in the bylaws`
#ASSERT `s 141(g) the board may hold its meetings, and have an office or offices, outside this State` `in a resolution of the board of directors`
#ASSERT `s 141(h) the board has the authority to fix the compensation of directors` `in none of these`
#ASSERT NOT `s 141(h) the board has the authority to fix the compensation of directors` `in the bylaws`
#ASSERT `s 141(i) the participation constitutes presence in person at the meeting` TRUE TRUE `in none of these`
#ASSERT NOT `s 141(i) the participation constitutes presence in person at the meeting` FALSE TRUE `in none of these`
#ASSERT NOT `s 141(i) the participation constitutes presence in person at the meeting` TRUE FALSE `in none of these`
#ASSERT NOT `s 141(i) the participation constitutes presence in person at the meeting` TRUE TRUE `in the certificate of incorporation`

§ `Section 141(k)`

-- a removal: for cause, classified, certificate allows a classified board to be removed without cause, cumulative voting, less than
-- the entire board, votes against sufficient to elect, elected by a class, shares entitled, in favor, class entitled, class in favor.
GIVEN a IS A BOOLEAN
      b IS A BOOLEAN
      c IS A BOOLEAN
      d IS A BOOLEAN
      e IS A BOOLEAN
      f IS A BOOLEAN
      g IS A BOOLEAN
      h IS A NUMBER
      i IS A NUMBER
      j IS A NUMBER
      k IS A NUMBER
GIVETH A `s 141(k) Removal`
`a removal` a b c d e f g h i j k MEANS `s 141(k) Removal` WITH
    `the removal is for cause` IS a
    `the board is classified as provided in subsection (d)` IS b
    `the certificate of incorporation provides that stockholders may remove a classified board without cause` IS c
    `the corporation has cumulative voting` IS d
    `less than the entire board is to be removed` IS e
    `the votes cast against the removal would be sufficient to elect the director if then cumulatively voted` IS f
    `the director was elected by the holders of a class or series of stock under the certificate of incorporation` IS g
    `the number of shares then entitled to vote at an election of directors` IS h
    `the number of those shares voted in favor of removal` IS i
    `the number of shares of the class or series then entitled to vote` IS j
    `the number of those shares voted in favor of removal, of the class or series` IS k

-- With or without cause, by a majority of the shares then entitled to vote: 51 of 100 carries, 50 of 100 does not.
#ASSERT `s 141(k) the stockholders may remove the director` (`a removal` FALSE FALSE FALSE FALSE FALSE FALSE FALSE 100 51 0 0) EQUALS JUST TRUE
#ASSERT `s 141(k) the stockholders may remove the director` (`a removal` FALSE FALSE FALSE FALSE FALSE FALSE FALSE 100 50 0 0) EQUALS JUST FALSE
#ASSERT `s 141(k) the stockholders may remove the director` (`a removal` TRUE FALSE FALSE FALSE FALSE FALSE FALSE 100 51 0 0) EQUALS JUST TRUE
-- (1) a classified board: only for cause, unless the certificate otherwise provides.
#ASSERT `s 141(k) the stockholders may remove the director` (`a removal` TRUE TRUE FALSE FALSE FALSE FALSE FALSE 100 51 0 0) EQUALS JUST TRUE
#ASSERT `s 141(k) the stockholders may remove the director` (`a removal` FALSE TRUE FALSE FALSE FALSE FALSE FALSE 100 100 0 0) EQUALS JUST FALSE
#ASSERT `s 141(k) the stockholders may remove the director` (`a removal` FALSE TRUE TRUE FALSE FALSE FALSE FALSE 100 51 0 0) EQUALS JUST TRUE
-- (2) cumulative voting, less than the entire board, votes against sufficient to elect: not without cause.
#ASSERT `s 141(k) the stockholders may remove the director` (`a removal` FALSE FALSE FALSE TRUE TRUE TRUE FALSE 100 51 0 0) EQUALS JUST FALSE
#ASSERT `s 141(k) the stockholders may remove the director` (`a removal` FALSE FALSE FALSE TRUE FALSE TRUE FALSE 100 51 0 0) EQUALS JUST TRUE
#ASSERT `s 141(k) the stockholders may remove the director` (`a removal` FALSE FALSE FALSE TRUE TRUE FALSE FALSE 100 51 0 0) EQUALS JUST TRUE
#ASSERT `s 141(k) the stockholders may remove the director` (`a removal` TRUE FALSE FALSE TRUE TRUE TRUE FALSE 100 51 0 0) EQUALS JUST TRUE
-- Without cause, the director elected by a class or series: the vote is of that class or series (5 of 10 is half; 6 of 10 is a majority).
#ASSERT `s 141(k) the stockholders may remove the director` (`a removal` FALSE FALSE FALSE FALSE FALSE FALSE TRUE 100 90 10 5) EQUALS JUST FALSE
#ASSERT `s 141(k) the stockholders may remove the director` (`a removal` FALSE FALSE FALSE FALSE FALSE FALSE TRUE 100 10 10 6) EQUALS JUST TRUE
-- For cause, the whole vote is taken (Fork F-141-6).
#ASSERT `s 141(k) the stockholders may remove the director` (`a removal` TRUE FALSE FALSE FALSE FALSE FALSE TRUE 100 51 10 0) EQUALS JUST TRUE
-- Counts that cannot be a vote: not covered.
#ASSERT `s 141(k) the stockholders may remove the director` (`a removal` FALSE FALSE FALSE FALSE FALSE FALSE FALSE 0 0 0 0) EQUALS NOTHING
#ASSERT `s 141(k) the stockholders may remove the director` (`a removal` FALSE FALSE FALSE FALSE FALSE FALSE FALSE 100 101 0 0) EQUALS NOTHING
#ASSERT `s 141(k) the stockholders may remove the director` (`a removal` FALSE FALSE FALSE FALSE FALSE FALSE TRUE 100 90 0 0) EQUALS NOTHING
