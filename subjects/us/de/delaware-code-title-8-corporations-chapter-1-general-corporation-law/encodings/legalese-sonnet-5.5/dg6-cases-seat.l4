#ASSERT `s 254(e) Is my personal liability as a stockholder of the association extinguished by the merger` FALSE TRUE EQUALS NOTHING
#ASSERT `s 254(e) Can my personal liability pass to a transferee or another stockholder of the survivor` FALSE TRUE EQUALS NOTHING
