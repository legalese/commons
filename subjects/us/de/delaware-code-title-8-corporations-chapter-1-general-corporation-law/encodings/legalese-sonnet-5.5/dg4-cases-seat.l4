#ASSERT `Is the amendment to the voting trust agreement made as required` `a stock corporation` TRUE FALSE EQUALS JUST FALSE

-- Case 125. Alex and another stockholder sign a written agreement on how to vote their shares.
#ASSERT `May our agreement among stockholders provide how our shares are voted` `a stock corporation` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `May our agreement among stockholders provide how our shares are voted` `a stock corporation` TRUE FALSE TRUE EQUALS JUST FALSE
-- It applies to Park Commons too (members), since s 218(c) is not taken out for a nonprofit corporation.
#ASSERT `May our agreement among stockholders provide how our shares are voted` `a nonprofit nonstock corporation that is not charitable` TRUE TRUE TRUE EQUALS JUST TRUE

-- Case 126. Section 218 does not invalidate an agreement that is not otherwise illegal; if it is otherwise illegal the text does not say.
#ASSERT `Does section 218 invalidate our voting agreement or irrevocable proxy` `a stock corporation` FALSE EQUALS JUST FALSE
#ASSERT `Does section 218 invalidate our voting agreement or irrevocable proxy` `a stock corporation` TRUE EQUALS NOTHING

-- Case 127. Section 219 applies to Acme only (a stock corporation).
#ASSERT `Does section 219 apply to my corporation` `a stock corporation`
#ASSERT NOT (`Does section 219 apply to my corporation` `a nonstock corporation with membership interests`)

-- Case 128. Meeting 20 March 2026: the list is due by 10 March.
#ASSERT `By what day must the corporation prepare the list of stockholders` `a stock corporation` (YearMonthDay 2026 3 20) EQUALS JUST (YearMonthDay 2026 3 10)
#ASSERT `By what day must the corporation prepare the list of stockholders` `a charitable nonstock corporation` (YearMonthDay 2026 3 20) EQUALS NOTHING

-- Case 129. Record date 15 March, less than 10 days before the meeting: the list reflects 10 March. Record date 1 March: 1 March.
#ASSERT `As of what day does the list reflect the stockholders entitled to vote` `a stock corporation` (YearMonthDay 2026 3 15) (YearMonthDay 2026 3 20) EQUALS JUST (YearMonthDay 2026 3 10)
#ASSERT `As of what day does the list reflect the stockholders entitled to vote` `a stock corporation` (YearMonthDay 2026 3 1) (YearMonthDay 2026 3 20) EQUALS JUST (YearMonthDay 2026 3 1)

-- Case 130. The list is alphabetical, with addresses and share numbers.
#ASSERT `Does the list of stockholders contain what section 219(a) requires` `a stock corporation` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Does the list of stockholders contain what section 219(a) requires` `a stock corporation` TRUE FALSE TRUE EQUALS JUST FALSE

-- Case 131. The list need not include electronic mail addresses.
#ASSERT NOT (`Must the list include electronic mail addresses`)

-- Case 132. Alex, a stockholder with a germane purpose, asks on 12 March to see the list for the 20 March meeting: allowed.
#ASSERT `May I examine the list of stockholders` `a stock corporation` TRUE TRUE (YearMonthDay 2026 3 12) (YearMonthDay 2026 3 20) FALSE TRUE EQUALS JUST TRUE
#ASSERT `May I examine the list of stockholders` `a stock corporation` TRUE TRUE (YearMonthDay 2026 3 20) (YearMonthDay 2026 3 20) FALSE TRUE EQUALS JUST FALSE
#ASSERT `May I examine the list of stockholders` `a stock corporation` TRUE FALSE (YearMonthDay 2026 3 12) (YearMonthDay 2026 3 20) FALSE TRUE EQUALS JUST FALSE
#ASSERT `May I examine the list of stockholders` `a stock corporation` TRUE TRUE (YearMonthDay 2026 3 10) (YearMonthDay 2026 3 20) TRUE FALSE EQUALS JUST TRUE

-- Case 133. Acme puts the list on an electronic network: it may limit access to stockholders.
#ASSERT `May the corporation limit electronic access to the list to stockholders` `a stock corporation` TRUE EQUALS JUST TRUE

-- Case 134. Acme refuses Alex the list: Alex may apply to the Court of Chancery.
#ASSERT `May I apply to the Court of Chancery to compel examination of the list` `a stock corporation` TRUE TRUE EQUALS JUST TRUE
#ASSERT `May I apply to the Court of Chancery to compel examination of the list` `a stock corporation` TRUE FALSE EQUALS JUST FALSE

-- Case 135. Acme must prove that Alex's purpose is not germane.
#ASSERT `Who must prove my purpose is not germane to the meeting` EQUALS `the corporation`

-- Case 136. The Court may postpone the meeting or void its results on Alex's application.
#ASSERT `May the Court of Chancery make this order on a stockholder's application about the list` `an additional order postponing the meeting` TRUE
#ASSERT `May the Court of Chancery make this order on a stockholder's application about the list` `an additional order voiding the results of the meeting` TRUE
#ASSERT NOT (`May the Court of Chancery make this order on a stockholder's application about the list` `an additional order voiding the results of the meeting` FALSE)

-- Case 137. Acme's records are the stock ledger when they record all the stockholders, addresses, shares and transfers under s 224.
#ASSERT `Do these records make up the stock ledger` TRUE TRUE TRUE TRUE
#ASSERT NOT (`Do these records make up the stock ledger` TRUE TRUE TRUE FALSE)

-- Case 138. Only the ledger shows who may examine the list or vote: Alex is shown there.
#ASSERT `Does the stock ledger show that I am entitled to examine the list or to vote` TRUE
#ASSERT NOT (`Does the stock ledger show that I am entitled to examine the list or to vote` FALSE)

§ `Cases for the seat: s 220`

-- Case 139. Alex's demand is dated 1 June 2026. Board minutes of any date are books and records; stockholder minutes before 1 June 2023 are not.
#ASSERT `Is this record among the books and records I may demand` `minutes of a meeting of the board of directors or a committee and records of an action of the board or a committee` (YearMonthDay 2010 1 1) (YearMonthDay 2026 6 1)
#ASSERT `Is this record among the books and records I may demand` `minutes of meetings of stockholders and signed consents evidencing action taken by stockholders without a meeting` (YearMonthDay 2023 6 1) (YearMonthDay 2026 6 1)
#ASSERT NOT (`Is this record among the books and records I may demand` `minutes of meetings of stockholders and signed consents evidencing action taken by stockholders without a meeting` (YearMonthDay 2023 5 31) (YearMonthDay 2026 6 1))
#ASSERT NOT (`Is this record among the books and records I may demand` `any other record of the corporation` (YearMonthDay 2026 1 1) (YearMonthDay 2026 6 1))

-- Case 140. Alex wants to know whether Acme's board is conflicted: that is reasonably related to his interest as a stockholder.
#ASSERT `Is my purpose a proper purpose` TRUE
#ASSERT NOT (`Is my purpose a proper purpose` FALSE)

-- Case 141. Alex is the record holder of Acme stock: a stockholder. Dee is a member of a nonstock corporation: a stockholder too.
#ASSERT `Am I a stockholder for the purposes of section 220` `a stock corporation` TRUE FALSE FALSE FALSE
#ASSERT `Am I a stockholder for the purposes of section 220` `a stock corporation` FALSE TRUE FALSE FALSE
#ASSERT `Am I a stockholder for the purposes of section 220` `a nonprofit nonstock corporation that is not charitable` FALSE FALSE FALSE TRUE
#ASSERT NOT (`Am I a stockholder for the purposes of section 220` `a stock corporation` FALSE FALSE FALSE FALSE)

-- Case 142. A company Acme owns in part and controls is Acme's subsidiary.
#ASSERT `Is this entity a subsidiary of the corporation` TRUE TRUE
#ASSERT NOT (`Is this entity a subsidiary of the corporation` TRUE FALSE)

-- Case 143. A statement affirmed under penalty of perjury under United States law is under oath.
#ASSERT `Is my statement under oath` FALSE TRUE
#ASSERT NOT (`Is my statement under oath` FALSE FALSE)

-- Case 144. Alex, a record holder, writes a demand under oath to Acme's registered office: it complies. A beneficial owner must also attach evidence.
#ASSERT `Does my demand comply with the form and manner section 220 requires` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE
#ASSERT NOT (`Does my demand comply with the form and manner section 220 requires` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE)
#ASSERT `Does my demand comply with the form and manner section 220 requires` TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE TRUE
#ASSERT NOT (`Does my demand comply with the form and manner section 220 requires` TRUE TRUE TRUE TRUE FALSE TRUE FALSE FALSE TRUE)
-- An attorney needs a power of attorney.
#ASSERT `Does my demand comply with the form and manner section 220 requires` TRUE TRUE FALSE FALSE FALSE FALSE TRUE TRUE TRUE
#ASSERT NOT (`Does my demand comply with the form and manner section 220 requires` TRUE TRUE FALSE FALSE FALSE FALSE TRUE FALSE TRUE)

-- Case 145. Alex's demand is in good faith for a proper purpose, describes both with particularity, and the records are specifically related.
#ASSERT `Are the conditions for inspecting the corporation's books and records met` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`Are the conditions for inspecting the corporation's books and records met` TRUE TRUE TRUE FALSE TRUE)

-- Case 146. For the stock ledger and list Alex needs only to be a stockholder who made a proper demand for a proper purpose.
#ASSERT `May I inspect and copy the stock ledger and the list of stockholders` TRUE TRUE TRUE
#ASSERT NOT (`May I inspect and copy the stock ledger and the list of stockholders` TRUE FALSE TRUE)

-- Case 147. For books and records the section (b)(2) conditions and the definition apply too.
#ASSERT `May I inspect and copy the corporation's books and records` TRUE TRUE TRUE TRUE
#ASSERT NOT (`May I inspect and copy the corporation's books and records` TRUE TRUE FALSE TRUE)

-- Case 148. A subsidiary's records Acme has actual possession and control of: Alex may inspect them too.
#ASSERT `May I inspect and copy a subsidiary's books and records` TRUE TRUE FALSE FALSE FALSE
#ASSERT `May I inspect and copy a subsidiary's books and records` TRUE FALSE TRUE TRUE TRUE
#ASSERT NOT (`May I inspect and copy a subsidiary's books and records` TRUE FALSE TRUE FALSE TRUE)

-- Case 149. Acme may require Alex to agree to confidentiality, and may redact what is unrelated to his purpose; it may not redact what is related.
#ASSERT `May the corporation impose this condition or redact when it produces records to me` `impose reasonable restrictions on the confidentiality, use or distribution of books and records` TRUE FALSE
#ASSERT `May the corporation impose this condition or redact when it produces records to me` `redact a portion of the books and records produced` TRUE FALSE
#ASSERT NOT (`May the corporation impose this condition or redact when it produces records to me` `redact a portion of the books and records produced` TRUE TRUE)

-- Case 150. Alex is suing Acme: section 220 does not affect his right to seek discovery. Not in litigation: the text is silent.
#ASSERT `Does section 220 affect my right to seek discovery of books and records in litigation` TRUE EQUALS JUST FALSE
#ASSERT `Does section 220 affect my right to seek discovery of books and records in litigation` FALSE EQUALS NOTHING

-- Case 151. A court's independent power to compel production of books and records at a stockholder's request needs the stockholder to have met (b).
#ASSERT `May a court compel production of the corporation's records independently of section 220` TRUE TRUE
#ASSERT NOT (`May a court compel production of the corporation's records independently of section 220` TRUE FALSE)
#ASSERT `May a court compel production of the corporation's records independently of section 220` FALSE FALSE

-- Case 152. Acme refused, or has not replied after 5 business days: Alex may apply to the Court of Chancery.
#ASSERT `May I apply to the Court of Chancery to compel the inspection` TRUE FALSE 0
#ASSERT `May I apply to the Court of Chancery to compel the inspection` FALSE FALSE 5
#ASSERT NOT (`May I apply to the Court of Chancery to compel the inspection` FALSE FALSE 4)
#ASSERT NOT (`May I apply to the Court of Chancery to compel the inspection` FALSE TRUE 9)

-- Case 153. Only the Court of Chancery has jurisdiction to decide Alex's entitlement.
#ASSERT `Does the court have jurisdiction to decide whether I am entitled to the inspection` TRUE
#ASSERT NOT (`Does the court have jurisdiction to decide whether I am entitled to the inspection` FALSE)

-- Case 154. The Court may order Acme to furnish a list as of a specific date.
#ASSERT `May the Court of Chancery make this order on my application` `an order that the corporation furnish the stockholder a list of its stockholders as of a specific date` TRUE
#ASSERT `May the Court of Chancery make this order on my application` `an order that books, documents and records, extracts or authenticated copies be brought within this State and kept in this State` TRUE
#ASSERT NOT (`May the Court of Chancery make this order on my application` `a limitation or condition with reference to the inspection` FALSE)

-- Case 155. If the Court orders the list, Alex must first pay the reasonable cost.
#ASSERT `Must I first pay the cost of the list of stockholders the Court orders` TRUE
#ASSERT NOT (`Must I first pay the cost of the list of stockholders the Court orders` FALSE)

-- Case 156. For books and records Alex must first establish he is a stockholder, complied with the form and manner, and has a proper purpose.
#ASSERT `Have I first established what section 220(c) requires for books and records` TRUE TRUE TRUE
#ASSERT NOT (`Have I first established what section 220(c) requires for books and records` TRUE TRUE FALSE)

-- Case 157. For books and records Alex bears the burden as to purpose; for the ledger or list, once he has established the two matters, Acme does.
#ASSERT `Who bears the burden of proof as to the purpose of my inspection` FALSE TRUE TRUE EQUALS JUST `a stockholder`
#ASSERT `Who bears the burden of proof as to the purpose of my inspection` TRUE TRUE TRUE EQUALS JUST `the corporation`
#ASSERT `Who bears the burden of proof as to the purpose of my inspection` TRUE FALSE TRUE EQUALS NOTHING

-- Case 158. Bea, a director, may examine the corporation's records for a purpose reasonably related to her position.
#ASSERT `As a director, may I examine the stock ledger, the list of stockholders and the corporation's records` TRUE TRUE
#ASSERT NOT (`As a director, may I examine the stock ledger, the list of stockholders and the corporation's records` TRUE FALSE)

-- Case 159. The Court may order summary inspection on Bea's application.
#ASSERT `May the Court of Chancery make this order on a director's application` `a summary order that the corporation permit the director to inspect the stock ledger, the list of stockholders, the books and records and other corporate records and to make copies or extracts` TRUE
#ASSERT NOT (`May the Court of Chancery make this order on a director's application` `a limitation or condition with reference to the inspection` FALSE)

-- Case 160. If Acme says Bea's purpose is improper, Acme must prove it.
#ASSERT `Who must prove that a director's inspection is for an improper purpose` EQUALS `the corporation`

-- Case 161. Alex asks for a record outside the defined books and records; no other route: the Court may not order it. The ledger and list stay available.
#ASSERT NOT (`May the Court of Chancery order the corporation to produce this record in a stockholder's proceeding` FALSE FALSE FALSE FALSE)
#ASSERT `May the Court of Chancery order the corporation to produce this record in a stockholder's proceeding` TRUE FALSE FALSE FALSE
#ASSERT `May the Court of Chancery order the corporation to produce this record in a stockholder's proceeding` FALSE TRUE FALSE FALSE
#ASSERT `May the Court of Chancery order the corporation to produce this record in a stockholder's proceeding` FALSE FALSE TRUE FALSE

-- Case 162. Acme keeps no board minutes; the functional equivalent, necessary and essential to Alex's purpose, may be ordered.
#ASSERT `May the Court of Chancery order the functional equivalent of records the corporation does not have` TRUE FALSE FALSE TRUE TRUE TRUE
#ASSERT NOT (`May the Court of Chancery order the functional equivalent of records the corporation does not have` TRUE FALSE FALSE TRUE TRUE FALSE)
-- Acme (not listed) lacks D&O questionnaires: (f) does not reach them. If it were listed, it would.
#ASSERT NOT (`May the Court of Chancery order the functional equivalent of records the corporation does not have` FALSE FALSE TRUE TRUE TRUE TRUE)
#ASSERT `May the Court of Chancery order the functional equivalent of records the corporation does not have` FALSE TRUE TRUE TRUE TRUE TRUE

-- Case 163. Other specific records: a compelling need and clear and convincing evidence that they are necessary and essential.
#ASSERT `May the Court of Chancery order the corporation to produce other specific records` TRUE TRUE TRUE
#ASSERT NOT (`May the Court of Chancery order the corporation to produce other specific records` TRUE TRUE FALSE)

-- Case 164. On records produced under (f) or (g) the Court may impose reasonable restrictions.
#ASSERT `May the Court of Chancery impose restrictions on records produced under section 220(f) or (g)` TRUE EQUALS JUST TRUE
#ASSERT `May the Court of Chancery impose restrictions on records produced under section 220(f) or (g)` FALSE EQUALS NOTHING
