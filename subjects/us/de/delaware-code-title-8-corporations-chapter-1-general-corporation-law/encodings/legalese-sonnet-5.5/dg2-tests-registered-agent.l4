IMPORT prelude
IMPORT daydate
IMPORT `dg-core`
IMPORT `dg2-support`
IMPORT `dg2-registered-agent`

-- Tests of dg2-registered-agent.l4 (8 Del. C. sections 131 and 132). Expected values are written by hand from src:295 to src:340 of
-- de-code-t8-ch1-2026-10-01.txt, beside each assertion, before the run.

§ `Section 131`

#ASSERT `s 131(a) the corporation must have and maintain a registered office in this State` TRUE EQUALS JUST TRUE
#ASSERT `s 131(a) the corporation must have and maintain a registered office in this State` FALSE EQUALS NOTHING
#ASSERT `s 131(a) the registered office may be a place of the corporation's business in this State` TRUE
#ASSERT `s 131(a) the registered office may be a place of the corporation's business in this State` FALSE
#ASSERT `s 131(b) the registered office` "1 Main Street, Dover" TRUE EQUALS JUST "1 Main Street, Dover"
#ASSERT `s 131(b) the registered office` "1 Main Street, Dover" FALSE EQUALS NOTHING
-- src:298: street, number, city, county and postal code.
#ASSERT `s 131(c) the address of the registered office as contained in the filed document is complete` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT `s 131(c) the address of the registered office as contained in the filed document is complete` FALSE TRUE TRUE TRUE TRUE
#ASSERT NOT `s 131(c) the address of the registered office as contained in the filed document is complete` TRUE FALSE TRUE TRUE TRUE
#ASSERT NOT `s 131(c) the address of the registered office as contained in the filed document is complete` TRUE TRUE FALSE TRUE TRUE
#ASSERT NOT `s 131(c) the address of the registered office as contained in the filed document is complete` TRUE TRUE TRUE FALSE TRUE
#ASSERT NOT `s 131(c) the address of the registered office as contained in the filed document is complete` TRUE TRUE TRUE TRUE FALSE

§ `Section 132(a): who may be the registered agent`

-- (kind, where formed, resident in this State)
#ASSERT `s 132(a) the candidate may be the registered agent of the corporation` `a natural person` `this State` TRUE
#ASSERT NOT `s 132(a) the candidate may be the registered agent of the corporation` `a natural person` `this State` FALSE
-- Any corporation: the corporation itself, a domestic one, or a foreign one.
#ASSERT `s 132(a) the candidate may be the registered agent of the corporation` (`a corporation` `a stock corporation`) `this State` FALSE
#ASSERT `s 132(a) the candidate may be the registered agent of the corporation` (`a corporation` `a stock corporation`) `another jurisdiction of the United States` FALSE
#ASSERT `s 132(a) the candidate may be the registered agent of the corporation` (`a corporation` `a charitable nonstock corporation`) `a foreign jurisdiction outside the United States` FALSE
-- A general partnership: domestic only; foreign limited partnerships, LLPs and LLLPs are named, a foreign general partnership is not.
#ASSERT `s 132(a) the candidate may be the registered agent of the corporation` `a general partnership` `this State` FALSE
#ASSERT NOT `s 132(a) the candidate may be the registered agent of the corporation` `a general partnership` `another jurisdiction of the United States` FALSE
#ASSERT NOT `s 132(a) the candidate may be the registered agent of the corporation` `a general partnership` `a foreign jurisdiction outside the United States` FALSE
#ASSERT `s 132(a) the candidate may be the registered agent of the corporation` `a limited partnership` `this State` FALSE
#ASSERT `s 132(a) the candidate may be the registered agent of the corporation` `a limited partnership` `another jurisdiction of the United States` FALSE
#ASSERT `s 132(a) the candidate may be the registered agent of the corporation` `a limited liability partnership` `this State` FALSE
#ASSERT `s 132(a) the candidate may be the registered agent of the corporation` `a limited liability partnership` `a foreign jurisdiction outside the United States` FALSE
#ASSERT `s 132(a) the candidate may be the registered agent of the corporation` `a limited liability limited partnership` `this State` FALSE
#ASSERT `s 132(a) the candidate may be the registered agent of the corporation` `a limited liability limited partnership` `another jurisdiction of the United States` FALSE
#ASSERT `s 132(a) the candidate may be the registered agent of the corporation` `a limited liability company` `this State` FALSE
#ASSERT `s 132(a) the candidate may be the registered agent of the corporation` `a limited liability company` `another jurisdiction of the United States` FALSE
#ASSERT `s 132(a) the candidate may be the registered agent of the corporation` `a statutory trust` `this State` FALSE
#ASSERT `s 132(a) the candidate may be the registered agent of the corporation` `a statutory trust` `a foreign jurisdiction outside the United States` FALSE
-- Not in the list: a business trust or association, a real estate investment trust, a common-law trust, a joint-stock association, any other unincorporated business.
#ASSERT NOT `s 132(a) the candidate may be the registered agent of the corporation` `a business trust or association` `this State` FALSE
#ASSERT NOT `s 132(a) the candidate may be the registered agent of the corporation` `a real estate investment trust` `this State` FALSE
#ASSERT NOT `s 132(a) the candidate may be the registered agent of the corporation` `a common-law trust` `this State` FALSE
#ASSERT NOT `s 132(a) the candidate may be the registered agent of the corporation` `a joint-stock association` `this State` FALSE
#ASSERT NOT `s 132(a) the candidate may be the registered agent of the corporation` `any other unincorporated business or association` `this State` FALSE

§ `Section 132(b)`

-- (the agent is an individual, an entity's business office, an individual's presence, a foreign entity, authorized to transact business, accepts
-- and forwards, forwards the annual report, adheres to the Secretary's regulations)
GIVEN a IS A BOOLEAN
      b IS A BOOLEAN
      c IS A BOOLEAN
      d IS A BOOLEAN
      e IS A BOOLEAN
      f IS A BOOLEAN
      g IS A BOOLEAN
      h IS A BOOLEAN
GIVETH A `s 132(b) Facts about a registered agent`
`an agent` a b c d e f g h MEANS `s 132(b) Facts about a registered agent` WITH
    `the agent is an individual` IS a
    `the agent, an entity, maintains a business office in this State which is generally open at sufficiently frequent times to accept service of process and otherwise perform the functions of a registered agent` IS b
    `the agent, an individual, is generally present at a designated location in this State at sufficiently frequent times to accept service of process and otherwise perform the functions of a registered agent` IS c
    `the agent is a foreign entity` IS d
    `the agent is authorized to transact business in this State` IS e
    `the agent accepts service of process and other communications directed to the corporations it serves and forwards them to the corporation to which the service or communication is directed` IS f
    `the agent forwards to the corporations it serves the annual report required by section 502 or an electronic notification of it in a form satisfactory to the Secretary of State` IS g
    `the agent satisfies and adheres to the regulations established by the Secretary regarding the verification of the identity of the entity's contacts and the individuals for which the agent maintains a record` IS h

#ASSERT `s 132(b)(1) the registered agent has done what the Law requires of every registered agent` (`an agent` FALSE TRUE FALSE FALSE FALSE TRUE TRUE TRUE)
-- a. an entity needs a business office generally open; an individual needs to be generally present at a designated location.
#ASSERT NOT `s 132(b)(1) the registered agent has done what the Law requires of every registered agent` (`an agent` FALSE FALSE TRUE FALSE FALSE TRUE TRUE TRUE)
#ASSERT `s 132(b)(1) the registered agent has done what the Law requires of every registered agent` (`an agent` TRUE FALSE TRUE FALSE FALSE TRUE TRUE TRUE)
#ASSERT NOT `s 132(b)(1) the registered agent has done what the Law requires of every registered agent` (`an agent` TRUE TRUE FALSE FALSE FALSE TRUE TRUE TRUE)
-- b. a foreign entity must be authorized to transact business in this State.
#ASSERT `s 132(b)(1) the registered agent has done what the Law requires of every registered agent` (`an agent` FALSE TRUE FALSE TRUE TRUE TRUE TRUE TRUE)
#ASSERT NOT `s 132(b)(1) the registered agent has done what the Law requires of every registered agent` (`an agent` FALSE TRUE FALSE TRUE FALSE TRUE TRUE TRUE)
-- c., d., e.
#ASSERT NOT `s 132(b)(1) the registered agent has done what the Law requires of every registered agent` (`an agent` FALSE TRUE FALSE FALSE FALSE FALSE TRUE TRUE)
#ASSERT NOT `s 132(b)(1) the registered agent has done what the Law requires of every registered agent` (`an agent` FALSE TRUE FALSE FALSE FALSE TRUE FALSE TRUE)
#ASSERT NOT `s 132(b)(1) the registered agent has done what the Law requires of every registered agent` (`an agent` FALSE TRUE FALSE FALSE FALSE TRUE TRUE FALSE)

-- src:313: not solely through a virtual office, a mail forwarding service, or both.
#ASSERT NOT `s 132(b)(2) the registered agent may perform its duties or functions in this way` TRUE FALSE FALSE
#ASSERT NOT `s 132(b)(2) the registered agent may perform its duties or functions in this way` FALSE TRUE FALSE
#ASSERT NOT `s 132(b)(2) the registered agent may perform its duties or functions in this way` TRUE TRUE FALSE
#ASSERT `s 132(b)(2) the registered agent may perform its duties or functions in this way` TRUE FALSE TRUE
#ASSERT `s 132(b)(2) the registered agent may perform its duties or functions in this way` FALSE TRUE TRUE
#ASSERT `s 132(b)(2) the registered agent may perform its duties or functions in this way` FALSE FALSE FALSE

§ `Section 132(c)`

#ASSERT `s 132(c) the number of entities above which an agent is a commercial registered agent` EQUALS 50
-- "more than 50 entities": 50 is not enough, 51 is.
#ASSERT NOT `s 132(c) the registered agent is a commercial registered agent` 50 FALSE 0
#ASSERT `s 132(c) the registered agent is a commercial registered agent` 51 FALSE 0
-- (c)(3): an officer, director or managing agent in common, and more than 50 collectively.
#ASSERT `s 132(c) the registered agent is a commercial registered agent` 10 TRUE 51
#ASSERT NOT `s 132(c) the registered agent is a commercial registered agent` 10 TRUE 50
#ASSERT NOT `s 132(c) the registered agent is a commercial registered agent` 10 FALSE 100

-- (natural person, principal residence or principal place of business in this State, business office within this State generally open, a Delaware
-- business license, generally present at a designated location, an officer, director or managing agent present at the office, provides the Secretary
-- information, adheres to the Secretary's regulations)
GIVEN a IS A BOOLEAN
      b IS A BOOLEAN
      c IS A BOOLEAN
      d IS A BOOLEAN
      e IS A BOOLEAN
      f IS A BOOLEAN
      g IS A BOOLEAN
      h IS A BOOLEAN
GIVETH A `s 132(c) Facts about a commercial registered agent`
`a commercial agent` a b c d e f g h MEANS `s 132(c) Facts about a commercial registered agent` WITH
    `the agent is a natural person` IS a
    `the agent maintains a principal residence or a principal place of business in this State` IS b
    `the agent has a business office within this State which is generally open during normal business hours to accept service of process and otherwise perform the functions of a registered agent as specified in subsection (b)` IS c
    `the agent maintains a Delaware business license` IS d
    `the agent, a natural person, is generally present at a designated location within this State during normal business hours to accept service of process and otherwise perform the functions of a registered agent as specified in subsection (b)` IS e
    `an officer, director or managing agent who is a natural person is generally present at the office during normal business hours` IS f
    `the agent provides the Secretary upon request with the information identifying and enabling communication with the agent that the Secretary requires` IS g
    `the agent satisfies and adheres to the regulations established by the Secretary regarding the verification of the identity of the entity's contacts and the individuals for which it maintains a record` IS h

-- (c)(1) a natural person: residence or place of business, a license, presence, information, regulations. The entity limbs are not read.
#ASSERT `s 132(c) the commercial registered agent meets the qualifications` (`a commercial agent` TRUE TRUE FALSE TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT `s 132(c) the commercial registered agent meets the qualifications` (`a commercial agent` TRUE FALSE FALSE TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT `s 132(c) the commercial registered agent meets the qualifications` (`a commercial agent` TRUE TRUE FALSE TRUE FALSE FALSE TRUE TRUE)
#ASSERT NOT `s 132(c) the commercial registered agent meets the qualifications` (`a commercial agent` TRUE TRUE FALSE FALSE TRUE FALSE TRUE TRUE)
-- (c)(2) an entity: a business office generally open, an officer, director or managing agent who is a natural person present, a license, information, regulations.
#ASSERT `s 132(c) the commercial registered agent meets the qualifications` (`a commercial agent` FALSE FALSE TRUE TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT `s 132(c) the commercial registered agent meets the qualifications` (`a commercial agent` FALSE FALSE FALSE TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT `s 132(c) the commercial registered agent meets the qualifications` (`a commercial agent` FALSE FALSE TRUE TRUE FALSE FALSE TRUE TRUE)
#ASSERT NOT `s 132(c) the commercial registered agent meets the qualifications` (`a commercial agent` FALSE FALSE TRUE FALSE FALSE TRUE TRUE TRUE)
#ASSERT NOT `s 132(c) the commercial registered agent meets the qualifications` (`a commercial agent` FALSE FALSE TRUE TRUE FALSE TRUE FALSE TRUE)
#ASSERT NOT `s 132(c) the commercial registered agent meets the qualifications` (`a commercial agent` FALSE FALSE TRUE TRUE FALSE TRUE TRUE FALSE)
-- An agent that is not a commercial registered agent is not subject to subsection (c).
#ASSERT `s 132(c) the registered agent is in compliance with subsection (c)` FALSE FALSE
#ASSERT NOT `s 132(c) the registered agent is in compliance with subsection (c)` TRUE FALSE
#ASSERT `s 132(c) the registered agent is in compliance with subsection (c)` TRUE TRUE

§ `Section 132(d) and (e)`

-- (formed under the laws of this State or qualified here, name, business address, business telephone number, a natural person who is an officer, director,
-- employee or designated agent, authorized to receive communications, updated)
GIVEN a IS A BOOLEAN
      b IS A BOOLEAN
      c IS A BOOLEAN
      d IS A BOOLEAN
      e IS A BOOLEAN
      f IS A BOOLEAN
      g IS A BOOLEAN
GIVETH A `s 132(d) Facts about the communications contact`
`a contact` a b c d e f g MEANS `s 132(d) Facts about the communications contact` WITH
    `the corporation is formed under the laws of this State or qualified to do business in this State` IS a
    `the corporation has provided the registered agent with the name of the person` IS b
    `the corporation has provided the registered agent with the business address of the person` IS c
    `the corporation has provided the registered agent with the business telephone number of the person` IS d
    `the person is a natural person who is an officer, director, employee, or designated agent of the corporation` IS e
    `the person is then authorized to receive communications from the registered agent` IS f
    `the corporation has updated the information from time to time as necessary` IS g

#ASSERT `s 132(d) the corporation has provided the registered agent with a communications contact as the Law requires` (`a contact` TRUE TRUE TRUE TRUE TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT `s 132(d) the corporation has provided the registered agent with a communications contact as the Law requires` (`a contact` TRUE FALSE TRUE TRUE TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT `s 132(d) the corporation has provided the registered agent with a communications contact as the Law requires` (`a contact` TRUE TRUE FALSE TRUE TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT `s 132(d) the corporation has provided the registered agent with a communications contact as the Law requires` (`a contact` TRUE TRUE TRUE FALSE TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT `s 132(d) the corporation has provided the registered agent with a communications contact as the Law requires` (`a contact` TRUE TRUE TRUE TRUE FALSE TRUE TRUE) EQUALS JUST FALSE
#ASSERT `s 132(d) the corporation has provided the registered agent with a communications contact as the Law requires` (`a contact` TRUE TRUE TRUE TRUE TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT `s 132(d) the corporation has provided the registered agent with a communications contact as the Law requires` (`a contact` TRUE TRUE TRUE TRUE TRUE TRUE FALSE) EQUALS JUST FALSE
-- A corporation neither formed here nor qualified here: the subsection does not speak.
#ASSERT `s 132(d) the corporation has provided the registered agent with a communications contact as the Law requires` (`a contact` FALSE TRUE TRUE TRUE TRUE TRUE TRUE) EQUALS NOTHING
#ASSERT `s 132(d) the registered agent retains the information about the communications contact as the Law requires` TRUE FALSE
#ASSERT `s 132(d) the registered agent retains the information about the communications contact as the Law requires` FALSE TRUE
#ASSERT NOT `s 132(d) the registered agent retains the information about the communications contact as the Law requires` FALSE FALSE
#ASSERT `s 132(d) the registered agent may resign as the registered agent pursuant to section 136` TRUE EQUALS JUST TRUE
#ASSERT `s 132(d) the registered agent may resign as the registered agent pursuant to section 136` FALSE EQUALS NOTHING
#ASSERT `s 132(e) the Secretary may refuse to file the document` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 132(e) the Secretary may refuse to file the document` TRUE FALSE EQUALS NOTHING
#ASSERT `s 132(e) the Secretary may refuse to file the document` FALSE TRUE EQUALS NOTHING

§ `Section 132(f)`

-- (the latest date on or before the complaint on which the agent was a commercial registered agent, the date of the complaint, failed after notice and
-- warning, convicted, deceptive conduct)
GIVEN a IS A MAYBE DATE
      b IS A DATE
      c IS A BOOLEAN
      d IS A BOOLEAN
      e IS A BOOLEAN
GIVETH A `s 132(f)(2) Facts about the grounds`
`a ground` a b c d e MEANS `s 132(f)(2) Facts about the grounds` WITH
    `the latest date on or before the filing of the complaint on which the registered agent was a commercial registered agent` IS a
    `the date the Secretary's complaint was filed` IS b
    `the registered agent failed, after notice and warning, to comply with the qualifications in subsection (b) or the requirements of subsection (c) or (d)` IS c
    `the person serving as registered agent, or an officer, director or managing agent of an entity registered agent, has been convicted of a felony or of a crime which includes an element of dishonesty or fraud or involves moral turpitude` IS d
    `the registered agent has engaged in conduct in connection with acting as a registered agent that is intended to or likely to deceive or defraud the public` IS e

-- a. a commercial registered agent at any time within 1 year immediately before the complaint (1 March 2025 to 1 March 2026 is within; 28 February 2025 is not), and failed after notice and warning.
#ASSERT `s 132(f)(2) a ground exists that is a sufficient basis to grant an injunction` (`a ground` (JUST (YMD 2025 3 1)) (YMD 2026 3 1) TRUE FALSE FALSE)
#ASSERT NOT `s 132(f)(2) a ground exists that is a sufficient basis to grant an injunction` (`a ground` (JUST (YMD 2025 2 28)) (YMD 2026 3 1) TRUE FALSE FALSE)
#ASSERT NOT `s 132(f)(2) a ground exists that is a sufficient basis to grant an injunction` (`a ground` (JUST (YMD 2025 3 1)) (YMD 2026 3 1) FALSE FALSE FALSE)
#ASSERT NOT `s 132(f)(2) a ground exists that is a sufficient basis to grant an injunction` (`a ground` NOTHING (YMD 2026 3 1) TRUE FALSE FALSE)
-- b. a conviction; c. deceptive conduct. Any one suffices.
#ASSERT `s 132(f)(2) a ground exists that is a sufficient basis to grant an injunction` (`a ground` NOTHING (YMD 2026 3 1) FALSE TRUE FALSE)
#ASSERT `s 132(f)(2) a ground exists that is a sufficient basis to grant an injunction` (`a ground` NOTHING (YMD 2026 3 1) FALSE FALSE TRUE)
#ASSERT NOT `s 132(f)(2) a ground exists that is a sufficient basis to grant an injunction` (`a ground` NOTHING (YMD 2026 3 1) FALSE FALSE FALSE)
-- (f): the Court may enjoin on the Secretary's application; a ground is a sufficient basis but not the only one.
#ASSERT `s 132(f) the Court of Chancery may enjoin the person or entity from serving` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 132(f) the Court of Chancery may enjoin the person or entity from serving` TRUE FALSE EQUALS NOTHING
#ASSERT `s 132(f) the Court of Chancery may enjoin the person or entity from serving` FALSE TRUE EQUALS JUST FALSE

-- (f)(1): once the Secretary has filed a complaint the Court may make orders, interim or final; without one the text does not say.
#ASSERT `s 132(f)(1) the Court may make orders respecting the proceeding and enter orders granting interim or final relief` TRUE EQUALS JUST TRUE
#ASSERT `s 132(f)(1) the Court may make orders respecting the proceeding and enter orders granting interim or final relief` FALSE EQUALS NOTHING
-- (f)(3): consent to service by an officer, director or managing agent serving on or after 1 January 2007.
#ASSERT `s 132(f)(3) January 1, 2007` EQUALS YMD 2007 1 1
#ASSERT `s 132(f)(3) the person is deemed to have consented to the appointment of the registered agent as agent for service of process` TRUE (YMD 2007 1 1) EQUALS JUST TRUE
#ASSERT `s 132(f)(3) the person is deemed to have consented to the appointment of the registered agent as agent for service of process` TRUE (YMD 2026 1 1) EQUALS JUST TRUE
#ASSERT `s 132(f)(3) the person is deemed to have consented to the appointment of the registered agent as agent for service of process` TRUE (YMD 2006 12 31) EQUALS NOTHING
#ASSERT `s 132(f)(3) the person is deemed to have consented to the appointment of the registered agent as agent for service of process` FALSE (YMD 2026 1 1) EQUALS NOTHING
#ASSERT `s 132(f)(3) the court may direct the order to the person` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 132(f)(3) the court may direct the order to the person` TRUE FALSE EQUALS NOTHING
#ASSERT `s 132(f)(3) the court may direct the order to the person` FALSE TRUE EQUALS NOTHING

-- (f)(4): (where the corporation is formed, notice mailed or delivered as required, the date of the notice, the date a new agent was obtained and designated, the date as of which the question is asked)
GIVEN a IS A `Where an entity is formed`
      b IS A BOOLEAN
      c IS A DATE
      d IS A MAYBE DATE
      e IS A DATE
GIVETH A `s 132(f)(4) Facts about the corporation`
`a corporation whose agent is enjoined` a b c d e MEANS `s 132(f)(4) Facts about the corporation` WITH
    `where the corporation is formed` IS a
    `the Secretary mailed or delivered notice of the order to the corporation at the address of its principal place of business specified in its most recent franchise tax report or other record of the Secretary` IS b
    `the date the notice was given` IS c
    `the date the corporation obtained and designated a new registered agent` IS d
    `the date as of which the question is asked` IS e

-- Notice given 31 January 2026: the thirtieth day after is 2 March 2026.
#ASSERT `s 132(f)(4) the last day for the corporation to obtain and designate a new registered agent` (`a corporation whose agent is enjoined` `this State` TRUE (YMD 2026 1 31) NOTHING (YMD 2026 4 1)) EQUALS YMD 2026 3 2
#ASSERT `s 132(f)(4) what follows for the corporation` (`a corporation whose agent is enjoined` `this State` TRUE (YMD 2026 1 31) (JUST (YMD 2026 3 2)) (YMD 2026 4 1)) EQUALS JUST `the corporation is not forfeited, because it obtained and designated a new registered agent in time`
#ASSERT `s 132(f)(4) what follows for the corporation` (`a corporation whose agent is enjoined` `this State` TRUE (YMD 2026 1 31) (JUST (YMD 2026 3 3)) (YMD 2026 4 1)) EQUALS JUST `the Secretary of State declares the charter of the domestic corporation forfeited`
#ASSERT `s 132(f)(4) what follows for the corporation` (`a corporation whose agent is enjoined` `this State` TRUE (YMD 2026 1 31) NOTHING (YMD 2026 3 2)) EQUALS NOTHING
#ASSERT `s 132(f)(4) what follows for the corporation` (`a corporation whose agent is enjoined` `this State` TRUE (YMD 2026 1 31) NOTHING (YMD 2026 3 3)) EQUALS JUST `the Secretary of State declares the charter of the domestic corporation forfeited`
#ASSERT `s 132(f)(4) what follows for the corporation` (`a corporation whose agent is enjoined` `another jurisdiction of the United States` TRUE (YMD 2026 1 31) NOTHING (YMD 2026 3 3)) EQUALS JUST `the Secretary of State forfeits the foreign corporation's qualification or authority to do business in this State`
#ASSERT `s 132(f)(4) what follows for the corporation` (`a corporation whose agent is enjoined` `a foreign jurisdiction outside the United States` TRUE (YMD 2026 1 31) (JUST (YMD 2026 3 3)) (YMD 2026 4 1)) EQUALS JUST `the Secretary of State forfeits the foreign corporation's qualification or authority to do business in this State`
-- Notice not given as the subsection requires: the thirty days have not started.
#ASSERT `s 132(f)(4) what follows for the corporation` (`a corporation whose agent is enjoined` `this State` FALSE (YMD 2026 1 31) NOTHING (YMD 2026 4 1)) EQUALS NOTHING
#ASSERT `s 132(f)(4) service of legal process against the corporation is upon the Secretary` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 132(f)(4) service of legal process against the corporation is upon the Secretary` TRUE TRUE EQUALS NOTHING
#ASSERT `s 132(f)(4) service of legal process against the corporation is upon the Secretary` FALSE FALSE EQUALS NOTHING
#ASSERT `s 132(f)(4) the Court of Chancery may order that the Secretary be given access to the former registered agent's information` TRUE EQUALS JUST TRUE
#ASSERT `s 132(f)(4) the Court of Chancery may order that the Secretary be given access to the former registered agent's information` FALSE EQUALS NOTHING

§ `Section 132(h)`

#ASSERT `s 132(h) the term is deemed to refer to the corporation's registered agent` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 132(h) the term is deemed to refer to the corporation's registered agent` TRUE TRUE EQUALS NOTHING
#ASSERT `s 132(h) the term is deemed to refer to the corporation's registered agent` FALSE FALSE EQUALS NOTHING
#ASSERT NOT `s 132(h) the corporation must amend its certificate of incorporation or any other document to comply with section 132` TRUE
