IMPORT prelude
IMPORT daydate
IMPORT `dg-core`
IMPORT `dg2-support`
IMPORT `dg2-board-approvals`

-- Tests of dg2-board-approvals.l4 (8 Del. C. sections 146 and 147). Expected values are written by hand from src:459 and src:463 of
-- de-code-t8-ch1-2026-10-01.txt, beside each assertion, before the run.

-- src:459: the corporation may agree to submit a matter to a stockholder vote whether or not the board later considers it no longer advisable.
#ASSERT `s 146 the corporation may agree to submit the matter to a vote of its stockholders` TRUE
#ASSERT `s 146 the corporation may agree to submit the matter to a vote of its stockholders` FALSE

-- src:463: where the chapter expressly requires board action, approval in final form or substantially final form.
#ASSERT `s 147 the board of directors may approve the agreement, instrument or document in this form` TRUE `in final form` EQUALS JUST TRUE
#ASSERT `s 147 the board of directors may approve the agreement, instrument or document in this form` TRUE `in substantially final form` EQUALS JUST TRUE
#ASSERT `s 147 the board of directors may approve the agreement, instrument or document in this form` TRUE `in some other form` EQUALS NOTHING
#ASSERT `s 147 the board of directors may approve the agreement, instrument or document in this form` FALSE `in final form` EQUALS NOTHING

-- src:463: ratification after approval and before the filing takes effect.
#ASSERT `s 147 the board of directors may adopt a resolution ratifying the agreement, instrument or document` TRUE TRUE TRUE
#ASSERT NOT `s 147 the board of directors may adopt a resolution ratifying the agreement, instrument or document` FALSE TRUE TRUE
#ASSERT NOT `s 147 the board of directors may adopt a resolution ratifying the agreement, instrument or document` TRUE FALSE TRUE
#ASSERT NOT `s 147 the board of directors may adopt a resolution ratifying the agreement, instrument or document` TRUE TRUE FALSE
#ASSERT `s 147 the date as of which the ratification is effective` (YMD 2026 3 1) EQUALS YMD 2026 3 1
#ASSERT `s 147 the ratification satisfies a requirement that the board of directors approve or act in a specific manner or sequence` TRUE EQUALS JUST TRUE
#ASSERT `s 147 the ratification satisfies a requirement that the board of directors approve or act in a specific manner or sequence` FALSE EQUALS NOTHING
#ASSERT NOT `s 147 ratification under this section is the exclusive means of ratifying it` TRUE
