IMPORT prelude
IMPORT daydate
IMPORT `dg-core`
IMPORT `dg10-suits`
IMPORT `dg10-pbc`

-- Tests of dg10-pbc.l4 (ss 361-368).
-- Every expected value is written by hand from the text (src:1783-1828) beside the assertion, before the run.

§ `Fixtures`

GIVEN a IS A BOOLEAN
      b IS A BOOLEAN
      c IS A BOOLEAN
GIVETH A `s 362(a) Corporation said to be a public benefit corporation`
`dg10 test pbc` a b c MEANS
    `s 362(a) Corporation said to be a public benefit corporation` WITH
        `the corporation is a for-profit corporation organized under and subject to the requirements of this chapter` IS a
        `the corporation is intended to produce a public benefit or public benefits` IS b
        `the corporation is intended to operate in a responsible and sustainable manner` IS c

GIVEN a IS A BOOLEAN
      b IS A BOOLEAN
      c IS A BOOLEAN
GIVETH A `s 362(a) Balancing of interests`
`dg10 test balancing` a b c MEANS
    `s 362(a) Balancing of interests` WITH
        `the stockholders' pecuniary interests are balanced` IS a
        `the best interests of those materially affected by the corporation's conduct are balanced` IS b
        `the public benefit or public benefits identified in the certificate of incorporation are balanced` IS c

GIVEN a IS A BOOLEAN
      b IS A BOOLEAN
      c IS A BOOLEAN
      d IS A BOOLEAN
GIVETH A `s 366(b) Statement to the stockholders`
`dg10 test statement` a b c d MEANS
    `s 366(b) Statement to the stockholders` WITH
        `the statement gives the objectives the board of directors has established to promote the public benefit or public benefits and interests` IS a
        `the statement gives the standards the board of directors has adopted to measure the corporation's progress` IS b
        `the statement gives objective factual information based on those standards regarding the corporation's success in meeting the objectives` IS c
        `the statement gives an assessment of the corporation's success in meeting the objectives and promoting the public benefit or public benefits and interests` IS d

§ `s 361: law applicable`

#ASSERT `s 361 this subchapter applies to the corporation` TRUE
#ASSERT NOT (`s 361 this subchapter applies to the corporation` FALSE)
#ASSERT `s 361 the requirement of this subchapter applies in place of the requirement of this chapter` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 361 the requirement of this subchapter applies in place of the requirement of this chapter` TRUE FALSE EQUALS JUST FALSE
-- Not a public benefit corporation: the section does not speak.
#ASSERT `s 361 the requirement of this subchapter applies in place of the requirement of this chapter` FALSE TRUE EQUALS NOTHING

§ `s 362: definition, certificate, name`

#ASSERT `s 362(a) the corporation is a public benefit corporation` (`dg10 test pbc` TRUE TRUE TRUE)
#ASSERT NOT (`s 362(a) the corporation is a public benefit corporation` (`dg10 test pbc` FALSE TRUE TRUE))
#ASSERT NOT (`s 362(a) the corporation is a public benefit corporation` (`dg10 test pbc` TRUE FALSE TRUE))
#ASSERT NOT (`s 362(a) the corporation is a public benefit corporation` (`dg10 test pbc` TRUE TRUE FALSE))
#ASSERT `s 362(a) the corporation is managed in a manner that balances the three interests` (`dg10 test balancing` TRUE TRUE TRUE)
#ASSERT NOT (`s 362(a) the corporation is managed in a manner that balances the three interests` (`dg10 test balancing` FALSE TRUE TRUE))
#ASSERT NOT (`s 362(a) the corporation is managed in a manner that balances the three interests` (`dg10 test balancing` TRUE FALSE TRUE))
#ASSERT NOT (`s 362(a) the corporation is managed in a manner that balances the three interests` (`dg10 test balancing` TRUE TRUE FALSE))
-- (a)(1): one or more specific public benefits.
#ASSERT `s 362(a)(1) the certificate identifies within its statement of business or purpose one or more specific public benefits` 1
#ASSERT `s 362(a)(1) the certificate identifies within its statement of business or purpose one or more specific public benefits` 3
#ASSERT NOT (`s 362(a)(1) the certificate identifies within its statement of business or purpose one or more specific public benefits` 0)
#ASSERT `s 362(a)(2) the certificate states within its heading that it is a public benefit corporation` TRUE
#ASSERT NOT (`s 362(a)(2) the certificate states within its heading that it is a public benefit corporation` FALSE)
-- (b)
#ASSERT `s 362(b) the effect is a public benefit` TRUE TRUE
#ASSERT NOT (`s 362(b) the effect is a public benefit` FALSE TRUE)
#ASSERT NOT (`s 362(b) the effect is a public benefit` TRUE FALSE)
#ASSERT `s 362(b) the provision is a public benefit provision` TRUE
#ASSERT NOT (`s 362(b) the provision is a public benefit provision` FALSE)
-- (c): the name designations.
#ASSERT `s 362(c) the name is deemed to satisfy the requirements of s 102(a)(1)(i)` TRUE FALSE FALSE
#ASSERT `s 362(c) the name is deemed to satisfy the requirements of s 102(a)(1)(i)` FALSE TRUE FALSE
#ASSERT `s 362(c) the name is deemed to satisfy the requirements of s 102(a)(1)(i)` FALSE FALSE TRUE
#ASSERT NOT (`s 362(c) the name is deemed to satisfy the requirements of s 102(a)(1)(i)` FALSE FALSE FALSE)
-- The notice owed on issuing unissued shares or disposing of treasury shares when the name does not say so.
#ASSERT `s 362(c) the corporation must give notice that it is a public benefit corporation to the person who acquires the stock` TRUE FALSE FALSE FALSE
#ASSERT NOT (`s 362(c) the corporation must give notice that it is a public benefit corporation to the person who acquires the stock` TRUE TRUE FALSE FALSE)
#ASSERT NOT (`s 362(c) the corporation must give notice that it is a public benefit corporation to the person who acquires the stock` TRUE FALSE TRUE FALSE)
#ASSERT NOT (`s 362(c) the corporation must give notice that it is a public benefit corporation to the person who acquires the stock` TRUE FALSE FALSE TRUE)
#ASSERT NOT (`s 362(c) the corporation must give notice that it is a public benefit corporation to the person who acquires the stock` FALSE FALSE FALSE FALSE)

§ `s 363: nonprofit nonstock corporations`

#ASSERT `s 363 the corporation may be a constituent corporation to the merger or consolidation` `a nonprofit nonstock corporation that is not charitable` TRUE FALSE EQUALS JUST FALSE
-- A charitable nonstock corporation is a nonprofit nonstock corporation (s 114(d)(3)).
#ASSERT `s 363 the corporation may be a constituent corporation to the merger or consolidation` `a charitable nonstock corporation` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 363 the corporation may be a constituent corporation to the merger or consolidation` `a nonprofit nonstock corporation that is not charitable` FALSE TRUE EQUALS JUST FALSE
-- A merger with neither feature is outside the section: not covered.
#ASSERT `s 363 the corporation may be a constituent corporation to the merger or consolidation` `a nonprofit nonstock corporation that is not charitable` FALSE FALSE EQUALS NOTHING
-- A stock corporation, or a nonstock corporation with membership interests, is not a nonprofit nonstock corporation.
#ASSERT `s 363 the corporation may be a constituent corporation to the merger or consolidation` `a stock corporation` TRUE TRUE EQUALS NOTHING
#ASSERT `s 363 the corporation may be a constituent corporation to the merger or consolidation` `a nonstock corporation with membership interests` TRUE TRUE EQUALS NOTHING

§ `s 364: notes on certificates and notices`

#ASSERT `s 364 the stock certificate meets the requirement to note that the corporation is a public benefit corporation` TRUE
#ASSERT NOT (`s 364 the stock certificate meets the requirement to note that the corporation is a public benefit corporation` FALSE)
#ASSERT `s 364 the notice meets the requirement to state that the corporation is a public benefit corporation` TRUE
#ASSERT NOT (`s 364 the notice meets the requirement to state that the corporation is a public benefit corporation` FALSE)

§ `s 365: duties of directors`

#ASSERT `s 365(a) the board manages or directs the business and affairs in a manner that balances the three interests` (`dg10 test balancing` TRUE TRUE TRUE)
#ASSERT NOT (`s 365(a) the board manages or directs the business and affairs in a manner that balances the three interests` (`dg10 test balancing` TRUE TRUE FALSE))
-- (b): no duty by virtue of the public benefit provisions or s 362(a).
#ASSERT `s 365(b) the director has a duty to the person by virtue of the public benefit provisions or s 362(a)` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 365(b) the director has a duty to the person by virtue of the public benefit provisions or s 362(a)` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 365(b) the director has a duty to the person by virtue of the public benefit provisions or s 362(a)` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 365(b) the director has a duty to the person by virtue of the public benefit provisions or s 362(a)` FALSE FALSE EQUALS NOTHING
-- Deemed to satisfy fiduciary duties: informed and disinterested and not irrational.
#ASSERT `s 365(b) the director is deemed to satisfy the director's fiduciary duties to the stockholders and the corporation` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 365(b) the director is deemed to satisfy the director's fiduciary duties to the stockholders and the corporation` FALSE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 365(b) the director is deemed to satisfy the director's fiduciary duties to the stockholders and the corporation` TRUE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 365(b) the director is deemed to satisfy the director's fiduciary duties to the stockholders and the corporation` TRUE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 365(b) the director is deemed to satisfy the director's fiduciary duties to the stockholders and the corporation` TRUE TRUE TRUE TRUE EQUALS NOTHING
-- (c)
#ASSERT `s 365(c) the director's ownership of or interest in the stock creates a conflict of interest for the balancing decision` FALSE EQUALS FALSE
#ASSERT `s 365(c) the director's ownership of or interest in the stock creates a conflict of interest for the balancing decision` TRUE
#ASSERT `s 365(c) a failure to satisfy the balancing requirement is an act or omission not in good faith, or a breach of the duty of loyalty, for the purposes of s 102(b)(7) or s 145` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 365(c) a failure to satisfy the balancing requirement is an act or omission not in good faith, or a breach of the duty of loyalty, for the purposes of s 102(b)(7) or s 145` TRUE FALSE EQUALS NOTHING
#ASSERT `s 365(c) a failure to satisfy the balancing requirement is an act or omission not in good faith, or a breach of the duty of loyalty, for the purposes of s 102(b)(7) or s 145` FALSE TRUE EQUALS NOTHING

§ `s 366: statements and certification`

#ASSERT `s 366(a) the notice of the meeting meets the requirement to include the statement` TRUE
#ASSERT NOT (`s 366(a) the notice of the meeting meets the requirement to include the statement` FALSE)
#ASSERT `s 366(b) the statement includes what the subsection requires` (`dg10 test statement` TRUE TRUE TRUE TRUE)
#ASSERT NOT (`s 366(b) the statement includes what the subsection requires` (`dg10 test statement` FALSE TRUE TRUE TRUE))
#ASSERT NOT (`s 366(b) the statement includes what the subsection requires` (`dg10 test statement` TRUE FALSE TRUE TRUE))
#ASSERT NOT (`s 366(b) the statement includes what the subsection requires` (`dg10 test statement` TRUE TRUE FALSE TRUE))
#ASSERT NOT (`s 366(b) the statement includes what the subsection requires` (`dg10 test statement` TRUE TRUE TRUE FALSE))
#ASSERT `s 366(b)(1) the statement includes the objectives the board of directors has established` (`dg10 test statement` TRUE FALSE FALSE FALSE)
#ASSERT `s 366(b)(2) the statement includes the standards the board of directors has adopted to measure progress` (`dg10 test statement` FALSE TRUE FALSE FALSE)
#ASSERT `s 366(b)(3) the statement includes objective factual information based on those standards` (`dg10 test statement` FALSE FALSE TRUE FALSE)
#ASSERT `s 366(b)(4) the statement includes an assessment of the corporation's success` (`dg10 test statement` FALSE FALSE FALSE TRUE)
-- (c)(1): a more frequent statement than biennially, in the certificate or bylaws only.
#ASSERT `s 366(c)(1) the number of months between statements` `in the certificate of incorporation` 12 EQUALS 12
#ASSERT `s 366(c)(1) the number of months between statements` `in the bylaws` 12 EQUALS 12
#ASSERT `s 366(c)(1) the number of months between statements` `in the certificate of incorporation` 36 EQUALS 24
#ASSERT `s 366(c)(1) the number of months between statements` `in the certificate of incorporation` 24 EQUALS 24
#ASSERT `s 366(c)(1) the number of months between statements` `in a resolution of the board of directors` 12 EQUALS 24
#ASSERT `s 366(c)(1) the number of months between statements` `in none of these` 12 EQUALS 24
-- No less than biennially: the last statement 15 January 2025, the next due 15 January 2027.
#ASSERT `s 366(b) the last day for the next statement` (JUST (YearMonthDay 2025 1 15)) 24 EQUALS JUST (YearMonthDay 2027 1 15)
#ASSERT `s 366(b) the last day for the next statement` (JUST (YearMonthDay 2025 3 31)) 12 EQUALS JUST (YearMonthDay 2026 3 31)
-- 29 February 2024 plus 24 months clamps to 28 February 2026 (the core's reading).
#ASSERT `s 366(b) the last day for the next statement` (JUST (YearMonthDay 2024 2 29)) 24 EQUALS JUST (YearMonthDay 2026 2 28)
-- No earlier statement: the text does not say from when the first is counted.
#ASSERT `s 366(b) the last day for the next statement` NOTHING 24 EQUALS NOTHING
#ASSERT `s 366(b) the next statement was provided in time` (JUST (YearMonthDay 2025 1 15)) 24 (YearMonthDay 2027 1 15) EQUALS JUST TRUE
#ASSERT `s 366(b) the next statement was provided in time` (JUST (YearMonthDay 2025 1 15)) 24 (YearMonthDay 2027 1 16) EQUALS JUST FALSE
#ASSERT `s 366(b) the next statement was provided in time` NOTHING 24 (YearMonthDay 2027 1 16) EQUALS NOTHING
#ASSERT `s 366(c)(2) the corporation must make the statement available to the public` `in the certificate of incorporation`
#ASSERT `s 366(c)(2) the corporation must make the statement available to the public` `in the bylaws`
#ASSERT NOT (`s 366(c)(2) the corporation must make the statement available to the public` `in none of these`)
#ASSERT NOT (`s 366(c)(2) the corporation must make the statement available to the public` `in a resolution of the board of directors`)
#ASSERT `s 366(c)(3) the corporation must use a third-party standard or attain a periodic third-party certification` `in the certificate of incorporation`
#ASSERT `s 366(c)(3) the corporation must use a third-party standard or attain a periodic third-party certification` `in the bylaws`
#ASSERT NOT (`s 366(c)(3) the corporation must use a third-party standard or attain a periodic third-party certification` `in none of these`)

§ `s 367: suits to enforce s 365(a)`

-- 2% of 1,000 outstanding shares is 20 shares.
#ASSERT `s 367 the plaintiffs own enough shares to bring the action` 20 1000 FALSE 0 EQUALS JUST TRUE
#ASSERT `s 367 the plaintiffs own enough shares to bring the action` 19 1000 FALSE 0 EQUALS JUST FALSE
-- A listed corporation: the lesser of 2% or $2,000,000 of shares. 19 shares worth exactly $2,000,000 suffice.
#ASSERT `s 367 the plaintiffs own enough shares to bring the action` 19 1000 TRUE 2000000 EQUALS JUST TRUE
#ASSERT `s 367 the plaintiffs own enough shares to bring the action` 19 1000 TRUE 1999999 EQUALS JUST FALSE
#ASSERT `s 367 the plaintiffs own enough shares to bring the action` 20 1000 TRUE 1 EQUALS JUST TRUE
-- Not listed: the market value measure is not available.
#ASSERT `s 367 the plaintiffs own enough shares to bring the action` 19 1000 FALSE 5000000 EQUALS JUST FALSE
-- No outstanding shares: no percentage.
#ASSERT `s 367 the plaintiffs own enough shares to bring the action` 0 0 FALSE 0 EQUALS NOTHING
-- The other conditions: s 327 for a derivative action, and the rules of the court.
#ASSERT `s 367 the plaintiffs may bring the action to enforce the balancing requirement` (JUST TRUE) TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 367 the plaintiffs may bring the action to enforce the balancing requirement` (JUST TRUE) TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 367 the plaintiffs may bring the action to enforce the balancing requirement` (JUST TRUE) FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 367 the plaintiffs may bring the action to enforce the balancing requirement` (JUST TRUE) TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 367 the plaintiffs may bring the action to enforce the balancing requirement` (JUST FALSE) TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 367 the plaintiffs may bring the action to enforce the balancing requirement` NOTHING TRUE TRUE TRUE EQUALS NOTHING

§ `s 368: no effect on other corporations`

#ASSERT `s 368 this subchapter affects the statute or rule of law applicable to the corporation` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 368 this subchapter affects the statute or rule of law applicable to the corporation` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 368 this subchapter affects the statute or rule of law applicable to the corporation` TRUE FALSE EQUALS NOTHING
