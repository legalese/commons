IMPORT prelude
IMPORT daydate
IMPORT `dg-core`
IMPORT `dg3-subscriptions`

-- Tests of dg3-subscriptions.l4 (sections 162 to 166).
-- Every expected value was decided by reading the section, then written beside the assertion; none is copied from the encoding's output.

§ `Section 162: liability of stockholder or subscriber for stock not paid in full`

-- (a): bound only if the consideration is not all paid in and the assets are insufficient to satisfy the creditors
#ASSERT `s 162(a) the holder of or subscriber for the shares is bound to pay the unpaid balance` TRUE TRUE
#ASSERT NOT (`s 162(a) the holder of or subscriber for the shares is bound to pay the unpaid balance` TRUE FALSE)
#ASSERT NOT (`s 162(a) the holder of or subscriber for the shares is bound to pay the unpaid balance` FALSE TRUE)
-- 50 shares, 3 unpaid on each: 150
#ASSERT `s 162(a) the sum the holder or subscriber is bound to pay` 50 3 EQUALS 150
-- (b): recovered as section 325 provides, after a writ of execution has been returned unsatisfied
#ASSERT `s 162(b) the amount payable may be recovered as provided in section 325` TRUE TRUE
#ASSERT NOT (`s 162(b) the amount payable may be recovered as provided in section 325` TRUE FALSE)
#ASSERT NOT (`s 162(b) the amount payable may be recovered as provided in section 325` FALSE TRUE)
-- (c): a good-faith assignee or transferee without knowledge or notice is not liable; the transferor remains liable
#ASSERT `s 162(c) the assignee or transferee is not personally liable for the unpaid portion` TRUE TRUE
#ASSERT NOT (`s 162(c) the assignee or transferee is not personally liable for the unpaid portion` TRUE FALSE)
#ASSERT NOT (`s 162(c) the assignee or transferee is not personally liable for the unpaid portion` FALSE TRUE)
#ASSERT `s 162(c) the transferor remains liable for the unpaid portion` TRUE EQUALS JUST TRUE
-- a transferee who is not so protected: the subsection does not say who is liable
#ASSERT `s 162(c) the transferor remains liable for the unpaid portion` FALSE EQUALS NOTHING
-- (d): a holder as collateral security, or a fiduciary, is not personally liable as a stockholder
#ASSERT `s 162(d) the person holding the shares is personally liable as a stockholder` `as collateral security under s 162(d)` EQUALS JUST FALSE
#ASSERT `s 162(d) the person holding the shares is personally liable as a stockholder` `as an executor, administrator, guardian, trustee or other fiduciary under s 162(d)` EQUALS JUST FALSE
#ASSERT `s 162(d) the person holding the shares is personally liable as a stockholder` `in another capacity under s 162(d)` EQUALS NOTHING
#ASSERT `s 162(d) the person pledging the shares is considered the holder and is liable as a stockholder` `as collateral security under s 162(d)`
#ASSERT NOT (`s 162(d) the person pledging the shares is considered the holder and is liable as a stockholder` `in another capacity under s 162(d)`)
#ASSERT `s 162(d) the estate or funds held in the fiduciary capacity are liable` `as an executor, administrator, guardian, trustee or other fiduciary under s 162(d)`
#ASSERT NOT (`s 162(d) the estate or funds held in the fiduciary capacity are liable` `as collateral security under s 162(d)`)
-- (e): not more than 6 years after the issuance of the stock or the date of the subscription (15 January 2026 plus 6 years is 15 January 2032)
#ASSERT `s 162(e) the liability may be asserted` (YearMonthDay 2026 1 15) (YearMonthDay 2032 1 15)
#ASSERT NOT (`s 162(e) the liability may be asserted` (YearMonthDay 2026 1 15) (YearMonthDay 2032 1 16))
-- issued on 29 February 2024: 6 years later is 28 February 2030 (dg-core's date arithmetic clamps; Fork F10)
#ASSERT `s 162(e) the liability may be asserted` (YearMonthDay 2024 2 29) (YearMonthDay 2030 2 28)
#ASSERT NOT (`s 162(e) the liability may be asserted` (YearMonthDay 2024 2 29) (YearMonthDay 2030 3 1))
-- (f): a stockholder or subscriber may appear and contest a receiver's, trustee's or judgment creditor's claim
#ASSERT `s 162(f) the stockholder or subscriber may appear and contest the claim` TRUE TRUE
#ASSERT NOT (`s 162(f) the stockholder or subscriber may appear and contest the claim` TRUE FALSE)
#ASSERT NOT (`s 162(f) the stockholder or subscriber may appear and contest the claim` FALSE TRUE)

§ `Section 163: payment for stock not paid in full`

-- the board's judgment, and the sums demanded in the whole not exceeding the balance remaining unpaid (100)
#ASSERT `s 163 the directors may demand the payment` TRUE 100 100
#ASSERT NOT (`s 163 the directors may demand the payment` TRUE 101 100)
#ASSERT NOT (`s 163 the directors may demand the payment` FALSE 50 100)
-- notice at least 30 days before the time for the payment (31 May 2026 less 30 days is 1 May 2026)
#ASSERT `s 163 the notice of the payment is as the section requires` (YearMonthDay 2026 5 1) (YearMonthDay 2026 5 31) TRUE TRUE
#ASSERT NOT (`s 163 the notice of the payment is as the section requires` (YearMonthDay 2026 5 2) (YearMonthDay 2026 5 31) TRUE TRUE)
#ASSERT NOT (`s 163 the notice of the payment is as the section requires` (YearMonthDay 2026 5 1) (YearMonthDay 2026 5 31) FALSE TRUE)
#ASSERT NOT (`s 163 the notice of the payment is as the section requires` (YearMonthDay 2026 5 1) (YearMonthDay 2026 5 31) TRUE FALSE)

§ `Section 164: failure to pay for stock; remedies`

#ASSERT `s 164 the directors may collect the amount by an action at law or sell the delinquent stockholder's shares at public sale` TRUE
#ASSERT NOT (`s 164 the directors may collect the amount by an action at law or sell the delinquent stockholder's shares at public sale` FALSE)
-- sale on 31 July 2026: advertisement at least 1 week before (24 July), notice mailed at least 20 days before (11 July)
#ASSERT `s 164 the notice of the sale is as the section requires` (YearMonthDay 2026 7 31) (YearMonthDay 2026 7 24) (YearMonthDay 2026 7 11) TRUE TRUE TRUE
#ASSERT NOT (`s 164 the notice of the sale is as the section requires` (YearMonthDay 2026 7 31) (YearMonthDay 2026 7 25) (YearMonthDay 2026 7 11) TRUE TRUE TRUE)
#ASSERT NOT (`s 164 the notice of the sale is as the section requires` (YearMonthDay 2026 7 31) (YearMonthDay 2026 7 24) (YearMonthDay 2026 7 12) TRUE TRUE TRUE)
#ASSERT NOT (`s 164 the notice of the sale is as the section requires` (YearMonthDay 2026 7 31) (YearMonthDay 2026 7 24) (YearMonthDay 2026 7 11) FALSE TRUE TRUE)
#ASSERT NOT (`s 164 the notice of the sale is as the section requires` (YearMonthDay 2026 7 31) (YearMonthDay 2026 7 24) (YearMonthDay 2026 7 11) TRUE FALSE TRUE)
#ASSERT NOT (`s 164 the notice of the sale is as the section requires` (YearMonthDay 2026 7 31) (YearMonthDay 2026 7 24) (YearMonthDay 2026 7 11) TRUE TRUE FALSE)
-- forfeiture: no bidder, and the amount not collected by the action within 1 year of its being brought (brought 10 January 2025)
#ASSERT `s 164 the stock and the amount previously paid in are forfeited to the corporation` TRUE (JUST (YearMonthDay 2025 1 10)) NOTHING (YearMonthDay 2026 1 11) EQUALS JUST TRUE
-- still within the year on 10 January 2026
#ASSERT `s 164 the stock and the amount previously paid in are forfeited to the corporation` TRUE (JUST (YearMonthDay 2025 1 10)) NOTHING (YearMonthDay 2026 1 10) EQUALS JUST FALSE
-- collected within the year: no forfeiture
#ASSERT `s 164 the stock and the amount previously paid in are forfeited to the corporation` TRUE (JUST (YearMonthDay 2025 1 10)) (JUST (YearMonthDay 2026 1 10)) (YearMonthDay 2026 6 1) EQUALS JUST FALSE
-- collected only after the year: not "within 1 year", so forfeited
#ASSERT `s 164 the stock and the amount previously paid in are forfeited to the corporation` TRUE (JUST (YearMonthDay 2025 1 10)) (JUST (YearMonthDay 2026 1 11)) (YearMonthDay 2026 6 1) EQUALS JUST TRUE
-- a bidder can be had: no forfeiture
#ASSERT `s 164 the stock and the amount previously paid in are forfeited to the corporation` FALSE (JUST (YearMonthDay 2025 1 10)) NOTHING (YearMonthDay 2026 6 1) EQUALS JUST FALSE
-- no action at law brought at all: the section runs the year from the bringing of the action, so it does not say
#ASSERT `s 164 the stock and the amount previously paid in are forfeited to the corporation` TRUE NOTHING NOTHING (YearMonthDay 2026 6 1) EQUALS NOTHING

§ `Section 165: revocability of preincorporation subscriptions`

-- subscription dated 15 January 2026: irrevocable for 6 months, to and including 15 July 2026
#ASSERT `s 165 the subscription is irrevocable on the day of the revocation` TRUE FALSE FALSE FALSE (YearMonthDay 2026 1 15) (YearMonthDay 2026 7 15) EQUALS JUST TRUE
#ASSERT `s 165 the subscription is irrevocable on the day of the revocation` TRUE FALSE FALSE FALSE (YearMonthDay 2026 1 15) (YearMonthDay 2026 7 16) EQUALS JUST FALSE
-- terms otherwise, or the consent of all other subscribers, or the consent of the corporation
#ASSERT `s 165 the subscription is irrevocable on the day of the revocation` TRUE TRUE FALSE FALSE (YearMonthDay 2026 1 15) (YearMonthDay 2026 3 1) EQUALS JUST FALSE
#ASSERT `s 165 the subscription is irrevocable on the day of the revocation` TRUE FALSE TRUE FALSE (YearMonthDay 2026 1 15) (YearMonthDay 2026 3 1) EQUALS JUST FALSE
#ASSERT `s 165 the subscription is irrevocable on the day of the revocation` TRUE FALSE FALSE TRUE (YearMonthDay 2026 1 15) (YearMonthDay 2026 3 1) EQUALS JUST FALSE
-- 31 August 2026 plus 6 months: 28 February 2027 (dg-core's date arithmetic clamps)
#ASSERT `s 165 the subscription is irrevocable on the day of the revocation` TRUE FALSE FALSE FALSE (YearMonthDay 2026 8 31) (YearMonthDay 2027 2 28) EQUALS JUST TRUE
#ASSERT `s 165 the subscription is irrevocable on the day of the revocation` TRUE FALSE FALSE FALSE (YearMonthDay 2026 8 31) (YearMonthDay 2027 3 1) EQUALS JUST FALSE
-- a subscription for a corporation already formed: the section says nothing
#ASSERT `s 165 the subscription is irrevocable on the day of the revocation` FALSE FALSE FALSE FALSE (YearMonthDay 2026 1 15) (YearMonthDay 2026 3 1) EQUALS NOTHING

§ `Section 166: formalities required of stock subscriptions`

#ASSERT `s 166 the subscription is not enforceable against the subscriber` FALSE TRUE
#ASSERT `s 166 the subscription is not enforceable against the subscriber` TRUE FALSE
#ASSERT `s 166 the subscription is not enforceable against the subscriber` FALSE FALSE
#ASSERT NOT (`s 166 the subscription is not enforceable against the subscriber` TRUE TRUE)
