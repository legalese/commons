IMPORT prelude
IMPORT daydate
IMPORT `dg-core`
IMPORT `dg1-s102e-name-reservation`

-- Tests of section 102(e) (dg1-s102e-name-reservation.l4). Every expected value is written by hand from the text
-- (src:70-75), beside the assertion, and was decided before the module was run.

§ `Tests of section 102(e)`

§§ `Who may reserve, and the application`

#ASSERT `s 102(e) the exclusive right to use the name may be reserved by or on behalf of the person` `a person intending to incorporate or organize a corporation with that name under this chapter, or contemplating such incorporation or organization` TRUE
#ASSERT `s 102(e) the exclusive right to use the name may be reserved by or on behalf of the person` `a domestic corporation or a foreign corporation qualified to do business in the State of Delaware, intending to change its name or contemplating such a change` TRUE
#ASSERT `s 102(e) the exclusive right to use the name may be reserved by or on behalf of the person` `a foreign corporation intending to qualify to do business in the State of Delaware and adopt that name, or contemplating such qualification and adoption` TRUE
#ASSERT `s 102(e) the exclusive right to use the name may be reserved by or on behalf of the person` `a person intending to organize a foreign corporation and have it qualify to do business in the State of Delaware and adopt that name, or contemplating such organization, qualification and adoption` TRUE
#ASSERT NOT (`s 102(e) the exclusive right to use the name may be reserved by or on behalf of the person` `another person` TRUE)
-- only a name that is available for use by a domestic or foreign corporation
#ASSERT NOT (`s 102(e) the exclusive right to use the name may be reserved by or on behalf of the person` `a person intending to incorporate or organize a corporation with that name under this chapter, or contemplating such incorporation or organization` FALSE)
-- the application: executed, certifying, naming the name, naming the applicant
#ASSERT `s 102(e) the application to reserve a name is in the form required` (`s 102(e) Application to reserve a name` OF TRUE, TRUE, TRUE, TRUE)
#ASSERT NOT (`s 102(e) the application to reserve a name is in the form required` (`s 102(e) Application to reserve a name` OF FALSE, TRUE, TRUE, TRUE))
#ASSERT NOT (`s 102(e) the application to reserve a name is in the form required` (`s 102(e) Application to reserve a name` OF TRUE, FALSE, TRUE, TRUE))
#ASSERT NOT (`s 102(e) the application to reserve a name is in the form required` (`s 102(e) Application to reserve a name` OF TRUE, TRUE, FALSE, TRUE))
#ASSERT NOT (`s 102(e) the application to reserve a name is in the form required` (`s 102(e) Application to reserve a name` OF TRUE, TRUE, TRUE, FALSE))
-- the Secretary of State shall reserve the name if it finds it available
#ASSERT `s 102(e) the Secretary of State must reserve the name for the applicant for a period of 120 days` TRUE TRUE
#ASSERT NOT (`s 102(e) the Secretary of State must reserve the name for the applicant for a period of 120 days` TRUE FALSE)
#ASSERT NOT (`s 102(e) the Secretary of State must reserve the name for the applicant for a period of 120 days` FALSE TRUE)

§§ `The period of the reservation, and renewal`

-- reserved on 1 January 2026: 120 days later is 1 May 2026 (31 + 28 + 31 + 30 = 120)
#ASSERT `s 102(e) the last day of the reservation` (YearMonthDay 2026 1 1) 0 EQUALS YearMonthDay 2026 5 1
-- one renewal adds a further 120 days: 29 August 2026 (1 May + 31 + 30 + 31 + 31 = 124, so 1 May + 120 days is 29 August)
#ASSERT `s 102(e) the last day of the reservation` (YearMonthDay 2026 1 1) 1 EQUALS YearMonthDay 2026 8 29
-- order: executed; certifies; specifies the reservation to be renewed; specifies the name and address of the applicant; the date filed
#ASSERT `s 102(e) the application for renewal renews the reservation` (`s 102(e) Application for renewal` OF TRUE, TRUE, TRUE, TRUE, (YearMonthDay 2026 5 1)) (YearMonthDay 2026 5 1)
-- a filing before the last day, and on it, is prior to the expiration; a filing the next day is not
#ASSERT `s 102(e) the application for renewal renews the reservation` (`s 102(e) Application for renewal` OF TRUE, TRUE, TRUE, TRUE, (YearMonthDay 2026 4 30)) (YearMonthDay 2026 5 1)
#ASSERT NOT (`s 102(e) the application for renewal renews the reservation` (`s 102(e) Application for renewal` OF TRUE, TRUE, TRUE, TRUE, (YearMonthDay 2026 5 2)) (YearMonthDay 2026 5 1))
#ASSERT NOT (`s 102(e) the application for renewal renews the reservation` (`s 102(e) Application for renewal` OF FALSE, TRUE, TRUE, TRUE, (YearMonthDay 2026 4 30)) (YearMonthDay 2026 5 1))
#ASSERT NOT (`s 102(e) the application for renewal renews the reservation` (`s 102(e) Application for renewal` OF TRUE, FALSE, TRUE, TRUE, (YearMonthDay 2026 4 30)) (YearMonthDay 2026 5 1))
#ASSERT NOT (`s 102(e) the application for renewal renews the reservation` (`s 102(e) Application for renewal` OF TRUE, TRUE, FALSE, TRUE, (YearMonthDay 2026 4 30)) (YearMonthDay 2026 5 1))
#ASSERT NOT (`s 102(e) the application for renewal renews the reservation` (`s 102(e) Application for renewal` OF TRUE, TRUE, TRUE, FALSE, (YearMonthDay 2026 4 30)) (YearMonthDay 2026 5 1))

§§ `Transfer, cancellation, copies and fees`

#ASSERT `s 102(e) the right to the exclusive use of the reserved name has been transferred` (`s 102(e) Notice of transfer` OF TRUE, TRUE, TRUE, TRUE)
#ASSERT NOT (`s 102(e) the right to the exclusive use of the reserved name has been transferred` (`s 102(e) Notice of transfer` OF FALSE, TRUE, TRUE, TRUE))
#ASSERT NOT (`s 102(e) the right to the exclusive use of the reserved name has been transferred` (`s 102(e) Notice of transfer` OF TRUE, FALSE, TRUE, TRUE))
#ASSERT NOT (`s 102(e) the right to the exclusive use of the reserved name has been transferred` (`s 102(e) Notice of transfer` OF TRUE, TRUE, FALSE, TRUE))
#ASSERT NOT (`s 102(e) the right to the exclusive use of the reserved name has been transferred` (`s 102(e) Notice of transfer` OF TRUE, TRUE, TRUE, FALSE))
#ASSERT `s 102(e) the reservation has been cancelled` (`s 102(e) Notice of cancellation` OF TRUE, TRUE, TRUE, TRUE)
#ASSERT NOT (`s 102(e) the reservation has been cancelled` (`s 102(e) Notice of cancellation` OF FALSE, TRUE, TRUE, TRUE))
#ASSERT NOT (`s 102(e) the reservation has been cancelled` (`s 102(e) Notice of cancellation` OF TRUE, FALSE, TRUE, TRUE))
#ASSERT NOT (`s 102(e) the reservation has been cancelled` (`s 102(e) Notice of cancellation` OF TRUE, TRUE, FALSE, TRUE))
#ASSERT NOT (`s 102(e) the reservation has been cancelled` (`s 102(e) Notice of cancellation` OF TRUE, TRUE, TRUE, FALSE))
-- a copy is returned unless the Secretary of State finds the instrument does not conform to law, upon receipt of the fees
#ASSERT `s 102(e) the Secretary of State must return a copy of the filed instrument with a notation of the action taken` FALSE TRUE
#ASSERT NOT (`s 102(e) the Secretary of State must return a copy of the filed instrument with a notation of the action taken` TRUE TRUE)
#ASSERT NOT (`s 102(e) the Secretary of State must return a copy of the filed instrument with a notation of the action taken` FALSE FALSE)
-- the fee is payable at the four times named; the amount comes from section 391
#ASSERT `s 102(e) the fee payable at the time of the filing` `the reservation of a name` 75 EQUALS JUST 75
#ASSERT `s 102(e) the fee payable at the time of the filing` `the renewal of a reservation` 75 EQUALS JUST 75
#ASSERT `s 102(e) the fee payable at the time of the filing` `the filing of a notice of the transfer of a reservation` 50 EQUALS JUST 50
#ASSERT `s 102(e) the fee payable at the time of the filing` `the filing of a notice of the cancellation of a reservation` 50 EQUALS JUST 50
#ASSERT `s 102(e) the fee payable at the time of the filing` `another filing` 50 EQUALS NOTHING
