IMPORT prelude
IMPORT daydate
IMPORT `dg-core`
IMPORT `dg1-s103-filing`

-- Tests of section 103 (dg1-s103-filing.l4). Every expected value is written by hand from the text of
-- section 103 (src:80-111), beside the assertion, and was decided before the module was run.
-- Records are built with positional OF in the order of their DECLARE; each builder names the order.

§ `Tests of section 103`

§§ `s 103(a) builders`

-- order: the instrument is the certificate; to be filed before the election of the initial board; initial directors named
GIVEN cert IS A BOOLEAN
      early IS A BOOLEAN
      named IS A BOOLEAN
GIVETH A `s 103(a) Instrument`
`t103 instrument` cert early named MEANS `s 103(a) Instrument` OF cert, early, named

-- order: every incorporator signed; successors and assigns signed; incorporator not available; person for whom the
-- incorporator acted signed; states not available and the reason; states acted as employee or agent for that person;
-- states that person's signature is otherwise authorized and not wrongful
GIVEN every IS A BOOLEAN
      successors IS A BOOLEAN
      unavailable IS A BOOLEAN
      person IS A BOOLEAN
      s1 IS A BOOLEAN
      s2 IS A BOOLEAN
      s3 IS A BOOLEAN
GIVETH A `s 103(a)(1) Signing by the incorporators`
`t103 incorporators signing` every successors unavailable person s1 s2 s3 MEANS `s 103(a)(1) Signing by the incorporators` OF every, successors, unavailable, person, s1, s2, s3

-- order: officer signed; no officers appear; majority of directors; designated directors; no officers or directors appear;
-- majority of holders; designated holders; all holders
GIVEN officer IS A BOOLEAN
      noofficers IS A BOOLEAN
      majdirs IS A BOOLEAN
      desdirs IS A BOOLEAN
      noboth IS A BOOLEAN
      majholders IS A BOOLEAN
      desholders IS A BOOLEAN
      allholders IS A BOOLEAN
GIVETH A `s 103(a)(2) Signing for the corporation`
`t103 corporation signing` officer noofficers majdirs desdirs noboth majholders desholders allholders MEANS `s 103(a)(2) Signing for the corporation` OF officer, noofficers, majdirs, desdirs, noboth, majholders, desholders, allholders

§§ `s 103(a) cases`

-- Which paragraph governs: the certificate always (a)(1); another instrument only if filed before the initial board is elected and the certificate did not name the initial directors.
#ASSERT `s 103(a)(1) the instrument is one that the incorporators sign` (`t103 instrument` TRUE FALSE FALSE)
#ASSERT `s 103(a)(1) the instrument is one that the incorporators sign` (`t103 instrument` FALSE TRUE FALSE)
#ASSERT NOT (`s 103(a)(1) the instrument is one that the incorporators sign` (`t103 instrument` FALSE TRUE TRUE))
#ASSERT NOT (`s 103(a)(1) the instrument is one that the incorporators sign` (`t103 instrument` FALSE FALSE FALSE))

-- The certificate: all the incorporators must sign; successors and assigns do not do for the certificate.
#ASSERT `s 103(a)(1) the instrument is signed as required of the incorporators` (`t103 instrument` TRUE FALSE FALSE) (`t103 incorporators signing` TRUE FALSE FALSE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`s 103(a)(1) the instrument is signed as required of the incorporators` (`t103 instrument` TRUE FALSE FALSE) (`t103 incorporators signing` FALSE TRUE FALSE FALSE FALSE FALSE FALSE))
#ASSERT NOT (`s 103(a)(1) the instrument is signed as required of the incorporators` (`t103 instrument` TRUE FALSE FALSE) (`t103 incorporators signing` FALSE FALSE TRUE TRUE TRUE TRUE TRUE))

-- Another early instrument: the incorporators, or their successors and assigns, or (not available) the other person with all three statements.
#ASSERT `s 103(a)(1) the instrument is signed as required of the incorporators` (`t103 instrument` FALSE TRUE FALSE) (`t103 incorporators signing` TRUE FALSE FALSE FALSE FALSE FALSE FALSE)
#ASSERT `s 103(a)(1) the instrument is signed as required of the incorporators` (`t103 instrument` FALSE TRUE FALSE) (`t103 incorporators signing` FALSE TRUE FALSE FALSE FALSE FALSE FALSE)
#ASSERT `s 103(a)(1) the instrument is signed as required of the incorporators` (`t103 instrument` FALSE TRUE FALSE) (`t103 incorporators signing` FALSE FALSE TRUE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`s 103(a)(1) the instrument is signed as required of the incorporators` (`t103 instrument` FALSE TRUE FALSE) (`t103 incorporators signing` FALSE FALSE TRUE TRUE FALSE TRUE TRUE))
#ASSERT NOT (`s 103(a)(1) the instrument is signed as required of the incorporators` (`t103 instrument` FALSE TRUE FALSE) (`t103 incorporators signing` FALSE FALSE TRUE TRUE TRUE FALSE TRUE))
#ASSERT NOT (`s 103(a)(1) the instrument is signed as required of the incorporators` (`t103 instrument` FALSE TRUE FALSE) (`t103 incorporators signing` FALSE FALSE TRUE TRUE TRUE TRUE FALSE))
#ASSERT NOT (`s 103(a)(1) the instrument is signed as required of the incorporators` (`t103 instrument` FALSE TRUE FALSE) (`t103 incorporators signing` FALSE FALSE FALSE TRUE TRUE TRUE TRUE))
#ASSERT NOT (`s 103(a)(1) the instrument is signed as required of the incorporators` (`t103 instrument` FALSE TRUE FALSE) (`t103 incorporators signing` FALSE FALSE TRUE FALSE TRUE TRUE TRUE))

-- Paragraph (a)(2): alternatives a. to d.
#ASSERT `s 103(a)(2) the instrument is signed as required for the corporation` (`t103 corporation signing` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`s 103(a)(2) the instrument is signed as required for the corporation` (`t103 corporation signing` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE))
#ASSERT `s 103(a)(2) the instrument is signed as required for the corporation` (`t103 corporation signing` FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE)
#ASSERT `s 103(a)(2) the instrument is signed as required for the corporation` (`t103 corporation signing` FALSE TRUE FALSE TRUE FALSE FALSE FALSE FALSE)
-- b. needs it to appear that there are no officers
#ASSERT NOT (`s 103(a)(2) the instrument is signed as required for the corporation` (`t103 corporation signing` FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE))
#ASSERT `s 103(a)(2) the instrument is signed as required for the corporation` (`t103 corporation signing` FALSE TRUE FALSE FALSE TRUE TRUE FALSE FALSE)
#ASSERT `s 103(a)(2) the instrument is signed as required for the corporation` (`t103 corporation signing` FALSE TRUE FALSE FALSE TRUE FALSE TRUE FALSE)
-- c. needs it to appear that there are no officers or directors
#ASSERT NOT (`s 103(a)(2) the instrument is signed as required for the corporation` (`t103 corporation signing` FALSE TRUE FALSE FALSE FALSE TRUE TRUE FALSE))
-- d. is open at all times
#ASSERT `s 103(a)(2) the instrument is signed as required for the corporation` (`t103 corporation signing` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE)

-- Overall: the certificate is judged under (a)(1), another instrument under (a)(2).
#ASSERT `s 103(a) the instrument is executed as required` (`t103 instrument` TRUE FALSE FALSE) (`t103 incorporators signing` TRUE FALSE FALSE FALSE FALSE FALSE FALSE) (`t103 corporation signing` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`s 103(a) the instrument is executed as required` (`t103 instrument` TRUE FALSE FALSE) (`t103 incorporators signing` FALSE FALSE FALSE FALSE FALSE FALSE FALSE) (`t103 corporation signing` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE))
#ASSERT `s 103(a) the instrument is executed as required` (`t103 instrument` FALSE FALSE FALSE) (`t103 incorporators signing` FALSE FALSE FALSE FALSE FALSE FALSE FALSE) (`t103 corporation signing` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`s 103(a) the instrument is executed as required` (`t103 instrument` FALSE FALSE FALSE) (`t103 incorporators signing` TRUE FALSE FALSE FALSE FALSE FALSE FALSE) (`t103 corporation signing` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE))

§§ `s 103(b) cases`

-- order: signed; acknowledged act and deed and facts true; before a person authorized to take acknowledgments of deeds; that person has a seal; affixed it
GIVEN signed IS A BOOLEAN
      acked IS A BOOLEAN
      authorized IS A BOOLEAN
      seal IS A BOOLEAN
      affixed IS A BOOLEAN
GIVETH A `s 103(b) Acknowledgment`
`t103 acknowledgment` signed acked authorized seal affixed MEANS `s 103(b) Acknowledgment` OF signed, acked, authorized, seal, affixed

#ASSERT `s 103(b)(1) the formal acknowledgment has been made` (`t103 acknowledgment` TRUE TRUE TRUE FALSE FALSE)
#ASSERT `s 103(b)(1) the formal acknowledgment has been made` (`t103 acknowledgment` TRUE TRUE TRUE TRUE TRUE)
-- a person with a seal of office must affix it
#ASSERT NOT (`s 103(b)(1) the formal acknowledgment has been made` (`t103 acknowledgment` TRUE TRUE TRUE TRUE FALSE))
#ASSERT NOT (`s 103(b)(1) the formal acknowledgment has been made` (`t103 acknowledgment` TRUE TRUE FALSE FALSE FALSE))
#ASSERT NOT (`s 103(b)(1) the formal acknowledgment has been made` (`t103 acknowledgment` TRUE FALSE TRUE FALSE FALSE))
-- the signature without more is the acknowledgment
#ASSERT `s 103(b)(2) the signature alone is the acknowledgment` (`t103 acknowledgment` TRUE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`s 103(b)(2) the signature alone is the acknowledgment` (`t103 acknowledgment` FALSE TRUE TRUE FALSE FALSE))
#ASSERT `s 103(b) the requirement that the instrument be acknowledged is satisfied` (`t103 acknowledgment` TRUE FALSE FALSE FALSE FALSE)
#ASSERT `s 103(b) the requirement that the instrument be acknowledged is satisfied` (`t103 acknowledgment` FALSE TRUE TRUE FALSE FALSE)
#ASSERT NOT (`s 103(b) the requirement that the instrument be acknowledged is satisfied` (`t103 acknowledgment` FALSE FALSE FALSE FALSE FALSE))
-- relying on the signature alone is the affirmation under penalties of perjury
#ASSERT `s 103(b)(2) the signatory affirms under penalties of perjury that the facts stated are true` (`t103 acknowledgment` TRUE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`s 103(b)(2) the signatory affirms under penalties of perjury that the facts stated are true` (`t103 acknowledgment` TRUE TRUE TRUE FALSE FALSE))
#ASSERT NOT (`s 103(b)(2) the signatory affirms under penalties of perjury that the facts stated are true` (`t103 acknowledgment` FALSE FALSE FALSE FALSE FALSE))

§§ `s 103(c) cases`

-- order: delivered; taxes and fees tendered; the Secretary of State refused for error, omission or imperfection; endorsed Filed
GIVEN delivered IS A BOOLEAN
      tendered IS A BOOLEAN
      refused IS A BOOLEAN
      endorsed IS A BOOLEAN
GIVETH A `s 103(c) Steps of filing`
`t103 steps` delivered tendered refused endorsed MEANS `s 103(c) Steps of filing` OF delivered, tendered, refused, endorsed

#ASSERT `s 103(c)(1) and (2) the filer has done what filing requires of the filer` (`t103 steps` TRUE TRUE FALSE FALSE)
#ASSERT NOT (`s 103(c)(1) and (2) the filer has done what filing requires of the filer` (`t103 steps` TRUE FALSE FALSE FALSE))
#ASSERT NOT (`s 103(c)(1) and (2) the filer has done what filing requires of the filer` (`t103 steps` FALSE TRUE FALSE FALSE))
#ASSERT `s 103(c)(3) the Secretary of State must certify the instrument as filed` (`t103 steps` TRUE TRUE FALSE FALSE)
#ASSERT NOT (`s 103(c)(3) the Secretary of State must certify the instrument as filed` (`t103 steps` TRUE TRUE TRUE FALSE))
#ASSERT NOT (`s 103(c)(3) the Secretary of State must certify the instrument as filed` (`t103 steps` TRUE FALSE FALSE FALSE))
#ASSERT `s 103(c) the instrument has been filed` (`t103 steps` TRUE TRUE FALSE TRUE)
-- delivered and tendered but not yet endorsed: not yet filed
#ASSERT NOT (`s 103(c) the instrument has been filed` (`t103 steps` TRUE TRUE FALSE FALSE))
#ASSERT `s 103(c)(4) the Secretary of State may hold the instrument in suspension` (`t103 steps` TRUE TRUE TRUE FALSE)
#ASSERT NOT (`s 103(c)(4) the Secretary of State may hold the instrument in suspension` (`t103 steps` TRUE TRUE FALSE FALSE))
#ASSERT `s 103(c)(4) the Secretary of State is barred from issuing a certificate of good standing` TRUE
#ASSERT NOT (`s 103(c)(4) the Secretary of State is barred from issuing a certificate of good standing` FALSE)
#ASSERT `s 103(c)(8) the instrument and its information must be permanently maintained as a public record` (`t103 steps` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 103(c)(8) the instrument and its information must be permanently maintained as a public record` (`t103 steps` TRUE TRUE FALSE FALSE))
#ASSERT `s 103(c)(8) the Secretary of State may grant the registered agent direct access to the system` TRUE
#ASSERT NOT (`s 103(c)(8) the Secretary of State may grant the registered agent direct access to the system` FALSE)
#ASSERT `s 103(c)(8) the registered agent granted direct access has complied with the condition on that access` TRUE
#ASSERT NOT (`s 103(c)(8) the registered agent granted direct access has complied with the condition on that access` FALSE)

-- The filing date, from a delivery on 15 March 2026.
#ASSERT `s 103(c)(3) the filing date of the instrument` `the date of delivery` (YMD 2026 3 15) EQUALS YMD 2026 3 15
#ASSERT `s 103(c)(3) the filing date of the instrument` (`a later date established on request made on or before delivery` (YMD 2026 3 20)) (YMD 2026 3 15) EQUALS YMD 2026 3 20
-- replacement of a suspended instrument: the date the rejected instrument would have had, if within 5 business days
#ASSERT `s 103(c)(3) the filing date of the instrument` (`replacement of an instrument held in suspension` (YMD 2026 3 2) 5 TRUE) (YMD 2026 3 15) EQUALS YMD 2026 3 2
#ASSERT `s 103(c)(3) the filing date of the instrument` (`replacement of an instrument held in suspension` (YMD 2026 3 2) 0 TRUE) (YMD 2026 3 15) EQUALS YMD 2026 3 2
#ASSERT `s 103(c)(3) the filing date of the instrument` (`replacement of an instrument held in suspension` (YMD 2026 3 2) 6 TRUE) (YMD 2026 3 15) EQUALS YMD 2026 3 15
#ASSERT `s 103(c)(3) the filing date of the instrument` (`replacement of an instrument held in suspension` (YMD 2026 3 2) 5 FALSE) (YMD 2026 3 15) EQUALS YMD 2026 3 15
#ASSERT `s 103(c)(3) the filing date of the instrument` (`replacement of an instrument held in suspension` (YMD 2026 3 2) (0 MINUS 1) TRUE) (YMD 2026 3 15) EQUALS YMD 2026 3 15
-- the date the information was entered, if the instrument is delivered the same date and within 4 hours after
#ASSERT `s 103(c)(3) the filing date of the instrument` (`entry of the information under paragraph (c)(8)` (YMD 2026 3 15) 4 TRUE) (YMD 2026 3 15) EQUALS YMD 2026 3 15
#ASSERT `s 103(c)(3) the filing date of the instrument` (`entry of the information under paragraph (c)(8)` (YMD 2026 3 14) 4 TRUE) (YMD 2026 3 15) EQUALS YMD 2026 3 14
#ASSERT `s 103(c)(3) the filing date of the instrument` (`entry of the information under paragraph (c)(8)` (YMD 2026 3 14) 5 TRUE) (YMD 2026 3 15) EQUALS YMD 2026 3 15
#ASSERT `s 103(c)(3) the filing date of the instrument` (`entry of the information under paragraph (c)(8)` (YMD 2026 3 14) 4 FALSE) (YMD 2026 3 15) EQUALS YMD 2026 3 15
#ASSERT `s 103(c)(3) the filing date of the instrument` (`entry of the information under paragraph (c)(8)` (YMD 2026 3 14) 0 TRUE) (YMD 2026 3 15) EQUALS YMD 2026 3 14
#ASSERT `s 103(c)(3) the filing date of the instrument` (`an earlier date established under subsection (i)` (YMD 2026 3 10)) (YMD 2026 3 15) EQUALS YMD 2026 3 10

-- Fees. The county assessment fee: $24 for a 1-page instrument and $9.00 for each additional page.
#ASSERT `s 103(c)(6) the county assessment fee` 1 FALSE FALSE EQUALS JUST 24
#ASSERT `s 103(c)(6) the county assessment fee` 2 FALSE FALSE EQUALS JUST 33
#ASSERT `s 103(c)(6) the county assessment fee` 3 FALSE FALSE EQUALS JUST 42
#ASSERT `s 103(c)(6) the county assessment fee` 10 FALSE FALSE EQUALS JUST 105
-- no fee for a qualifying certificate of dissolution or a subchapter XVI document
#ASSERT `s 103(c)(6) the county assessment fee` 3 TRUE FALSE EQUALS JUST 0
#ASSERT `s 103(c)(6) the county assessment fee` 3 FALSE TRUE EQUALS JUST 0
-- a number of pages that cannot be one (below 1, or not whole) is not covered
#ASSERT `s 103(c)(6) the county assessment fee` 0 FALSE FALSE EQUALS NOTHING
#ASSERT `s 103(c)(6) the county assessment fee` 1.5 FALSE FALSE EQUALS NOTHING
#ASSERT `s 103(c)(6) the county whose recorder's office receives the assessment fee` "Kent" EQUALS "Kent"
-- the courthouse municipality fee: $40 per instrument, except three kinds
#ASSERT `s 103(c)(7) the courthouse municipality fee` FALSE FALSE FALSE EQUALS 40
#ASSERT `s 103(c)(7) the courthouse municipality fee` TRUE FALSE FALSE EQUALS 0
#ASSERT `s 103(c)(7) the courthouse municipality fee` FALSE TRUE FALSE EQUALS 0
#ASSERT `s 103(c)(7) the courthouse municipality fee` FALSE FALSE TRUE EQUALS 0
#ASSERT `s 103(c)(7) the municipality that receives the courthouse municipality fee` "Dover" EQUALS "Dover"
-- the Secretary of State retains 1 percent of the total fees collected
#ASSERT `s 103(c)(5) the administrative charge the Secretary of State retains and pays to the General Fund` 2400 EQUALS 24
#ASSERT `s 103(c)(5) the administrative charge the Secretary of State retains and pays to the General Fund` 0 EQUALS 0

§§ `s 103(d) cases`

-- Filing on 1 January 2026: the ninetieth day after is 1 April 2026 (31 + 28 + 31 = 90 days).
#ASSERT `s 103(d) the instrument may become effective on the specified later date` (YMD 2026 1 1) (YMD 2026 4 1) EQUALS JUST TRUE
#ASSERT `s 103(d) the instrument may become effective on the specified later date` (YMD 2026 1 1) (YMD 2026 4 2) EQUALS JUST FALSE
#ASSERT `s 103(d) the instrument may become effective on the specified later date` (YMD 2026 1 1) (YMD 2026 1 2) EQUALS JUST TRUE
-- the same date: depends on the time of day, which is not carried
#ASSERT `s 103(d) the instrument may become effective on the specified later date` (YMD 2026 1 1) (YMD 2026 1 1) EQUALS NOTHING
#ASSERT `s 103(d) the instrument may become effective on the specified later date` (YMD 2026 1 1) (YMD 2025 12 31) EQUALS JUST FALSE
-- in a leap year the ninetieth day after 1 January 2028 is 30 March 2028
#ASSERT `s 103(d) the instrument may become effective on the specified later date` (YMD 2028 1 1) (YMD 2028 3 31) EQUALS JUST TRUE
#ASSERT `s 103(d) the instrument may become effective on the specified later date` (YMD 2028 1 1) (YMD 2028 4 1) EQUALS JUST FALSE
-- the effective date
#ASSERT `s 103(d) the date on which the instrument is effective` (YMD 2026 1 1) NOTHING EQUALS JUST (YMD 2026 1 1)
#ASSERT `s 103(d) the date on which the instrument is effective` (YMD 2026 1 1) (JUST (YMD 2026 3 1)) EQUALS JUST (YMD 2026 3 1)
#ASSERT `s 103(d) the date on which the instrument is effective` (YMD 2026 1 1) (JUST (YMD 2026 4 2)) EQUALS NOTHING
#ASSERT `s 103(d) the date on which the instrument is effective` (YMD 2026 1 1) (JUST (YMD 2026 1 1)) EQUALS NOTHING
#ASSERT `s 103(b)(2) the date as of which the facts stated by a signatory relying on the signature alone must be true` (YMD 2026 3 1) EQUALS YMD 2026 3 1
-- terminating or amending an instrument with a future effective date: filed prior to that date, in due form
GIVEN filed IS A DATE
      executed IS A BOOLEAN
      identifies IS A BOOLEAN
      states IS A BOOLEAN
GIVETH A `s 103(d) Certificate of termination or amendment`
`t103 termination` filed executed identifies states MEANS `s 103(d) Certificate of termination or amendment` OF filed, executed, identifies, states

#ASSERT `s 103(d) the future effective instrument has been terminated or amended by a certificate in due form and time` (`t103 termination` (YMD 2026 2 28) TRUE TRUE TRUE) (YMD 2026 3 1) EQUALS JUST TRUE
#ASSERT `s 103(d) the future effective instrument has been terminated or amended by a certificate in due form and time` (`t103 termination` (YMD 2026 3 2) TRUE TRUE TRUE) (YMD 2026 3 1) EQUALS JUST FALSE
#ASSERT `s 103(d) the future effective instrument has been terminated or amended by a certificate in due form and time` (`t103 termination` (YMD 2026 3 1) TRUE TRUE TRUE) (YMD 2026 3 1) EQUALS NOTHING
#ASSERT `s 103(d) the future effective instrument has been terminated or amended by a certificate in due form and time` (`t103 termination` (YMD 2026 2 28) FALSE TRUE TRUE) (YMD 2026 3 1) EQUALS JUST FALSE
#ASSERT `s 103(d) the future effective instrument has been terminated or amended by a certificate in due form and time` (`t103 termination` (YMD 2026 2 28) TRUE FALSE TRUE) (YMD 2026 3 1) EQUALS JUST FALSE
#ASSERT `s 103(d) the future effective instrument has been terminated or amended by a certificate in due form and time` (`t103 termination` (YMD 2026 2 28) TRUE TRUE FALSE) (YMD 2026 3 1) EQUALS JUST FALSE

§§ `s 103(e) cases`

#ASSERT `s 103(e) the other section governs` TRUE TRUE
#ASSERT NOT (`s 103(e) the other section governs` TRUE FALSE)
#ASSERT NOT (`s 103(e) the other section governs` FALSE TRUE)

§§ `s 103(f) cases`

-- order: authorized and has been filed; inaccurate record; defectively or erroneously executed, sealed or acknowledged
GIVEN filed IS A BOOLEAN
      inaccurate IS A BOOLEAN
      defective IS A BOOLEAN
GIVETH A `s 103(f) Filed instrument`
`t103 filed instrument` filed inaccurate defective MEANS `s 103(f) Filed instrument` OF filed, inaccurate, defective

#ASSERT `s 103(f) the instrument may be corrected or nullified by a certificate of correction` (`t103 filed instrument` TRUE TRUE FALSE)
#ASSERT `s 103(f) the instrument may be corrected or nullified by a certificate of correction` (`t103 filed instrument` TRUE FALSE TRUE)
#ASSERT NOT (`s 103(f) the instrument may be corrected or nullified by a certificate of correction` (`t103 filed instrument` TRUE FALSE FALSE))
#ASSERT NOT (`s 103(f) the instrument may be corrected or nullified by a certificate of correction` (`t103 filed instrument` FALSE TRUE TRUE))

-- order: executed, acknowledged and filed in accordance with this section; to be corrected (not nullified); specifies the inaccuracy or defect; sets forth the portion in corrected form; provides for nullification
GIVEN executed IS A BOOLEAN
      correcting IS A BOOLEAN
      specifies IS A BOOLEAN
      portion IS A BOOLEAN
      nullifies IS A BOOLEAN
GIVETH A `s 103(f) Certificate of correction`
`t103 certificate of correction` executed correcting specifies portion nullifies MEANS `s 103(f) Certificate of correction` OF executed, correcting, specifies, portion, nullifies

#ASSERT `s 103(f) the certificate of correction is in the form required` (`t103 certificate of correction` TRUE TRUE TRUE TRUE FALSE)
#ASSERT NOT (`s 103(f) the certificate of correction is in the form required` (`t103 certificate of correction` TRUE TRUE TRUE FALSE FALSE))
#ASSERT `s 103(f) the certificate of correction is in the form required` (`t103 certificate of correction` TRUE FALSE TRUE FALSE TRUE)
#ASSERT NOT (`s 103(f) the certificate of correction is in the form required` (`t103 certificate of correction` TRUE FALSE TRUE TRUE FALSE))
#ASSERT NOT (`s 103(f) the certificate of correction is in the form required` (`t103 certificate of correction` TRUE TRUE FALSE TRUE FALSE))
#ASSERT NOT (`s 103(f) the certificate of correction is in the form required` (`t103 certificate of correction` FALSE TRUE TRUE TRUE FALSE))

-- order: executed, acknowledged and filed; designated as such in its heading; specifies the inaccuracy or defect; sets forth the entire instrument
#ASSERT `s 103(f) the corrected instrument is in the form required` (`s 103(f) Corrected instrument` OF TRUE, TRUE, TRUE, TRUE)
#ASSERT NOT (`s 103(f) the corrected instrument is in the form required` (`s 103(f) Corrected instrument` OF TRUE, FALSE, TRUE, TRUE))
#ASSERT NOT (`s 103(f) the corrected instrument is in the form required` (`s 103(f) Corrected instrument` OF TRUE, TRUE, FALSE, TRUE))
#ASSERT NOT (`s 103(f) the corrected instrument is in the form required` (`s 103(f) Corrected instrument` OF TRUE, TRUE, TRUE, FALSE))
#ASSERT NOT (`s 103(f) the corrected instrument is in the form required` (`s 103(f) Corrected instrument` OF FALSE, TRUE, TRUE, TRUE))

-- effective as of the original filing date, except as to a person substantially and adversely affected, as to whom from the filing date of the correction
#ASSERT `s 103(f) the date from which the corrected or nullified instrument is effective as to the person` (YMD 2026 1 5) (YMD 2026 6 1) FALSE EQUALS YMD 2026 1 5
#ASSERT `s 103(f) the date from which the corrected or nullified instrument is effective as to the person` (YMD 2026 1 5) (YMD 2026 6 1) TRUE EQUALS YMD 2026 6 1

§§ `s 103(g) and (h) cases`

#ASSERT `s 103(g) the Secretary of State is liable to any person for the act` `preclearance for filing` EQUALS JUST FALSE
#ASSERT `s 103(g) the Secretary of State is liable to any person for the act` `acceptance for filing` EQUALS JUST FALSE
#ASSERT `s 103(g) the Secretary of State is liable to any person for the act` `filing and indexing` EQUALS JUST FALSE
#ASSERT `s 103(g) the Secretary of State is liable to any person for the act` `another act of the Secretary of State` EQUALS NOTHING
#ASSERT `s 103(h) the form of signature is permitted on an instrument authorized to be filed` `a facsimile signature on an instrument to be filed` EQUALS JUST TRUE
#ASSERT `s 103(h) the form of signature is permitted on an instrument authorized to be filed` `a conformed signature on an instrument to be filed` EQUALS JUST TRUE
#ASSERT `s 103(h) the form of signature is permitted on an instrument authorized to be filed` `an electronically transmitted signature` EQUALS JUST TRUE
#ASSERT `s 103(h) the form of signature is permitted on an instrument authorized to be filed` `a manual signature on an instrument to be filed` EQUALS JUST TRUE
#ASSERT `s 103(h) the form of signature is permitted on an instrument authorized to be filed` `another form of signature on an instrument to be filed` EQUALS NOTHING

§§ `s 103(i) cases`

-- order: affidavit delivered; affidavit attests good faith effort; affidavit specifies and requests; written waiver; extraordinary condition existed; effort unsuccessful as a result; delivery within a reasonable period; business days
GIVEN affidavit IS A BOOLEAN
      attests IS A BOOLEAN
      specifies IS A BOOLEAN
      waiver IS A BOOLEAN
      condition IS A BOOLEAN
      unsuccessful IS A BOOLEAN
      reasonable IS A BOOLEAN
      days IS A NUMBER
GIVETH A `s 103(i)(1) Request for an earlier filing date`
`t103 request` affidavit attests specifies waiver condition unsuccessful reasonable days MEANS `s 103(i)(1) Request for an earlier filing date` OF affidavit, attests, specifies, waiver, condition, unsuccessful, reasonable, days

-- limb a. (all three parts of the affidavit) and limb c.
#ASSERT `s 103(i)(1) the Secretary of State may establish the earlier date and time as the filing date` (`t103 request` TRUE TRUE TRUE FALSE TRUE TRUE TRUE 2)
-- limb b. (the waiver) and limb c.
#ASSERT `s 103(i)(1) the Secretary of State may establish the earlier date and time as the filing date` (`t103 request` FALSE FALSE FALSE TRUE TRUE TRUE TRUE 1)
-- neither limb a. nor limb b.
#ASSERT NOT (`s 103(i)(1) the Secretary of State may establish the earlier date and time as the filing date` (`t103 request` FALSE FALSE FALSE FALSE TRUE TRUE TRUE 1))
-- the affidavit lacks one of its three parts
#ASSERT NOT (`s 103(i)(1) the Secretary of State may establish the earlier date and time as the filing date` (`t103 request` FALSE TRUE TRUE FALSE TRUE TRUE TRUE 1))
#ASSERT NOT (`s 103(i)(1) the Secretary of State may establish the earlier date and time as the filing date` (`t103 request` TRUE FALSE TRUE FALSE TRUE TRUE TRUE 1))
#ASSERT NOT (`s 103(i)(1) the Secretary of State may establish the earlier date and time as the filing date` (`t103 request` TRUE TRUE FALSE FALSE TRUE TRUE TRUE 1))
-- limb c. is cumulative: each of its three determinations is needed
#ASSERT NOT (`s 103(i)(1) the Secretary of State may establish the earlier date and time as the filing date` (`t103 request` TRUE TRUE TRUE FALSE FALSE TRUE TRUE 1))
#ASSERT NOT (`s 103(i)(1) the Secretary of State may establish the earlier date and time as the filing date` (`t103 request` TRUE TRUE TRUE FALSE TRUE FALSE TRUE 1))
#ASSERT NOT (`s 103(i)(1) the Secretary of State may establish the earlier date and time as the filing date` (`t103 request` TRUE TRUE TRUE FALSE TRUE TRUE FALSE 1))
-- a reasonable period "not to exceed 2 business days": 2 is inside, 3 is outside
#ASSERT `s 103(i)(1) the Secretary of State may establish the earlier date and time as the filing date` (`t103 request` TRUE TRUE TRUE FALSE TRUE TRUE TRUE 0)
#ASSERT NOT (`s 103(i)(1) the Secretary of State may establish the earlier date and time as the filing date` (`t103 request` TRUE TRUE TRUE FALSE TRUE TRUE TRUE 3))
#ASSERT NOT (`s 103(i)(1) the Secretary of State may establish the earlier date and time as the filing date` (`t103 request` TRUE TRUE TRUE FALSE TRUE TRUE TRUE (0 MINUS 1)))
-- no fee is paid for receiving an affidavit of extraordinary condition
#ASSERT `s 103(i)(1) the fee payable to the Secretary of State for receiving an affidavit of extraordinary condition` EQUALS 0
-- paragraph (i)(2): the definition of an extraordinary condition
#ASSERT `s 103(i)(2) there is an extraordinary condition` `an attack on, or invasion or occupation by foreign military forces of` `the United States` TRUE FALSE
#ASSERT `s 103(i)(2) there is an extraordinary condition` `a disaster, catastrophe, war or other armed conflict, revolution or insurrection, or rioting or civil commotion in` `a locality in which the Secretary of State conducts its business` TRUE FALSE
#ASSERT `s 103(i)(2) there is an extraordinary condition` `a disaster, catastrophe, war or other armed conflict, revolution or insurrection, or rioting or civil commotion in` `a locality in which the good faith effort to deliver the instrument and tender the taxes and fees is made` TRUE FALSE
#ASSERT NOT (`s 103(i)(2) there is an extraordinary condition` `a disaster, catastrophe, war or other armed conflict, revolution or insurrection, or rioting or civil commotion in` `another place` TRUE FALSE)
#ASSERT NOT (`s 103(i)(2) there is an extraordinary condition` `an attack on, or invasion or occupation by foreign military forces of` `the United States` FALSE TRUE)
#ASSERT `s 103(i)(2) there is an extraordinary condition` `a malfunction or outage of the electrical or telephone service to the office of the Secretary of State` `another place` FALSE TRUE
#ASSERT `s 103(i)(2) there is an extraordinary condition` `weather or other condition in or about a locality in which the Secretary of State conducts its business` `a locality in which the Secretary of State conducts its business` FALSE TRUE
#ASSERT NOT (`s 103(i)(2) there is an extraordinary condition` `weather or other condition in or about a locality in which the Secretary of State conducts its business` `a locality in which the Secretary of State conducts its business` TRUE FALSE)
#ASSERT NOT (`s 103(i)(2) there is an extraordinary condition` `another event` `the United States` TRUE TRUE)
#ASSERT `s 103(i)(2) the determination of the Secretary of State is conclusive` FALSE
#ASSERT NOT (`s 103(i)(2) the determination of the Secretary of State is conclusive` TRUE)
-- paragraph (i)(3)
#ASSERT `s 103(i)(3) the date from which the instrument is effective as to the person` (YMD 2026 3 10) (YMD 2026 3 15) FALSE EQUALS YMD 2026 3 10
#ASSERT `s 103(i)(3) the date from which the instrument is effective as to the person` (YMD 2026 3 10) (YMD 2026 3 15) TRUE EQUALS YMD 2026 3 15

§§ `s 103(j) cases`

#ASSERT `s 103(j) the date before which a filed document need not be amended to comply with § 131(c)` EQUALS YMD 2011 8 1
#ASSERT `s 103(j) the corporation need not amend the document to comply with § 131(c)` (YMD 2011 7 31)
#ASSERT NOT (`s 103(j) the corporation need not amend the document to comply with § 131(c)` (YMD 2011 8 1))
#ASSERT `s 103(j) the document must comply with § 131(c)` (YMD 2011 8 1) TRUE EQUALS JUST TRUE
#ASSERT `s 103(j) the document must comply with § 131(c)` (YMD 2026 1 1) TRUE EQUALS JUST TRUE
-- on or after the date but not changing the address: not mentioned
#ASSERT `s 103(j) the document must comply with § 131(c)` (YMD 2026 1 1) FALSE EQUALS NOTHING
-- before the date: the proviso says nothing
#ASSERT `s 103(j) the document must comply with § 131(c)` (YMD 2011 7 31) TRUE EQUALS NOTHING
