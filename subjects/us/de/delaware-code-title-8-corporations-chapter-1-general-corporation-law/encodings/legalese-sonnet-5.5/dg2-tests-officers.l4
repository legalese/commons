IMPORT prelude
IMPORT daydate
IMPORT `dg-core`
IMPORT `dg2-support`
IMPORT `dg2-officers`

-- Tests of dg2-officers.l4 (8 Del. C. sections 142 and 143). Expected values are written by hand from src:383 to src:391 of
-- de-code-t8-ch1-2026-10-01.txt, beside each assertion, before the run.

§ `Section 142`

-- src:383: titles and duties stated in the bylaws, or in a board resolution not inconsistent with the bylaws.
#ASSERT `s 142(a) the titles and duties of the officers are stated as the Law requires` `in the bylaws` FALSE EQUALS JUST TRUE
#ASSERT `s 142(a) the titles and duties of the officers are stated as the Law requires` `in a resolution of the board of directors` FALSE EQUALS JUST TRUE
#ASSERT `s 142(a) the titles and duties of the officers are stated as the Law requires` `in a resolution of the board of directors` TRUE EQUALS JUST FALSE
-- A statement only in the certificate is not one of the two places the text names; a statement nowhere is not a statement.
#ASSERT `s 142(a) the titles and duties of the officers are stated as the Law requires` `in the certificate of incorporation` FALSE EQUALS NOTHING
#ASSERT `s 142(a) the titles and duties of the officers are stated as the Law requires` `in none of these` FALSE EQUALS JUST FALSE

#ASSERT `s 142(a) the corporation has the officers it needs to sign instruments and stock certificates` TRUE
#ASSERT NOT `s 142(a) the corporation has the officers it needs to sign instruments and stock certificates` FALSE
#ASSERT `s 142(a) one of the officers has the duty to record the proceedings of the meetings` 1
#ASSERT `s 142(a) one of the officers has the duty to record the proceedings of the meetings` 2
#ASSERT NOT `s 142(a) one of the officers has the duty to record the proceedings of the meetings` 0

-- src:383: any number of offices may be held by the same person unless the certificate or bylaws otherwise provide.
#ASSERT `s 142(a) the same person may hold any number of offices` `in none of these`
#ASSERT NOT `s 142(a) the same person may hold any number of offices` `in the certificate of incorporation`
#ASSERT NOT `s 142(a) the same person may hold any number of offices` `in the bylaws`
#ASSERT `s 142(a) the same person may hold any number of offices` `in a resolution of the board of directors`

-- src:384.
#ASSERT `s 142(b) the manner of choosing the officers and their terms are fixed as the Law provides` TRUE FALSE
#ASSERT `s 142(b) the manner of choosing the officers and their terms are fixed as the Law provides` FALSE TRUE
#ASSERT NOT `s 142(b) the manner of choosing the officers and their terms are fixed as the Law provides` FALSE FALSE
#ASSERT `s 142(b) the officer still holds office` FALSE FALSE FALSE
#ASSERT NOT `s 142(b) the officer still holds office` TRUE FALSE FALSE
#ASSERT NOT `s 142(b) the officer still holds office` FALSE TRUE FALSE
#ASSERT NOT `s 142(b) the officer still holds office` FALSE FALSE TRUE
#ASSERT `s 142(b) the officer may resign` TRUE EQUALS JUST TRUE
#ASSERT `s 142(b) the officer may resign` FALSE EQUALS NOTHING

-- src:385 to 387.
#ASSERT `s 142(c) the corporation may secure the fidelity of the person by bond or otherwise` TRUE EQUALS JUST TRUE
#ASSERT `s 142(c) the corporation may secure the fidelity of the person by bond or otherwise` FALSE EQUALS NOTHING
#ASSERT NOT `s 142(d) the failure to elect officers dissolves or otherwise affects the corporation` TRUE
#ASSERT NOT `s 142(d) the failure to elect officers dissolves or otherwise affects the corporation` FALSE
#ASSERT `s 142(e) how the vacancy in the office is filled` TRUE EQUALS `as the bylaws provide`
#ASSERT `s 142(e) how the vacancy in the office is filled` FALSE EQUALS `the board of directors or other governing body`

§ `Section 143`

-- src:391: an officer or other employee of the corporation or its subsidiary (a director included), whenever the directors judge it may reasonably be expected to benefit the corporation.
#ASSERT `s 143 the corporation may lend money to, guarantee an obligation of, or otherwise assist the person` TRUE TRUE
#ASSERT NOT `s 143 the corporation may lend money to, guarantee an obligation of, or otherwise assist the person` TRUE FALSE
#ASSERT NOT `s 143 the corporation may lend money to, guarantee an obligation of, or otherwise assist the person` FALSE TRUE
#ASSERT `s 143 the loan, guaranty or other assistance may be with or without interest` TRUE
#ASSERT `s 143 the loan, guaranty or other assistance may be with or without interest` FALSE
#ASSERT `s 143 the loan, guaranty or other assistance may be secured in this way` `unsecured`
#ASSERT `s 143 the loan, guaranty or other assistance may be secured in this way` `secured in a manner the board of directors approves`
#ASSERT `s 143 the loan, guaranty or other assistance may be secured in this way` `secured by a pledge of shares of stock of the corporation, a manner the board of directors approves`
#ASSERT NOT `s 143 the loan, guaranty or other assistance may be secured in this way` `secured in a manner the board of directors has not approved`
#ASSERT NOT `s 143 this section denies, limits or restricts the power` TRUE
