IMPORT prelude
IMPORT daydate
IMPORT `dg-core`
IMPORT `dg2-support`

-- Tests of dg2-support.l4: the three-valued helpers and the test of where a provision is made. Not law; expected values are the truth tables.

#ASSERT `dg2 both findings hold` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `dg2 both findings hold` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `dg2 both findings hold` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `dg2 both findings hold` (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `dg2 both findings hold` NOTHING (JUST FALSE) EQUALS JUST FALSE
#ASSERT `dg2 both findings hold` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `dg2 both findings hold` NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `dg2 both findings hold` NOTHING NOTHING EQUALS NOTHING

#ASSERT `dg2 either finding holds` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `dg2 either finding holds` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `dg2 either finding holds` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `dg2 either finding holds` NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `dg2 either finding holds` (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `dg2 either finding holds` NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `dg2 either finding holds` (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `dg2 either finding holds` NOTHING NOTHING EQUALS NOTHING

#ASSERT `dg2 the finding is certain` TRUE EQUALS JUST TRUE
#ASSERT `dg2 the finding is certain` FALSE EQUALS JUST FALSE

#ASSERT `dg2 the place is the certificate of incorporation or the bylaws` `in the certificate of incorporation`
#ASSERT `dg2 the place is the certificate of incorporation or the bylaws` `in the bylaws`
#ASSERT NOT `dg2 the place is the certificate of incorporation or the bylaws` `in a resolution of the board of directors`
#ASSERT NOT `dg2 the place is the certificate of incorporation or the bylaws` `in none of these`
