IMPORT prelude
IMPORT daydate
IMPORT `dg-core`
IMPORT `dg4-s212-voting-proxies`

-- Tests of dg4-s212-voting-proxies.l4 (ss 212 and 214). Expected values are written by hand from the text
-- (de-code-t8-ch1-2026-10-01.txt, lines 777-785 and 794-796), beside each assertion, never copied from the module's own output.

§ `Tests of ss 212 and 214`

§§ `s 212(a): votes`

-- src:778: 1 vote per share unless the certificate provides otherwise
#ASSERT `s 212(a) the number of votes each share carries on the matter` FALSE 0 EQUALS 1
#ASSERT `s 212(a) the number of votes each share carries on the matter` FALSE 10 EQUALS 1
#ASSERT `s 212(a) the number of votes each share carries on the matter` TRUE 10 EQUALS 10
#ASSERT `s 212(a) the number of votes each share carries on the matter` TRUE 0 EQUALS 0
-- the stockholder entitled under s 213 holds shares times votes; one not entitled under s 213 holds none
#ASSERT `s 212(a) the number of votes the stockholder is entitled to cast` TRUE 100 1 EQUALS 100
#ASSERT `s 212(a) the number of votes the stockholder is entitled to cast` TRUE 100 10 EQUALS 1000
#ASSERT `s 212(a) the number of votes the stockholder is entitled to cast` TRUE 0.5 1 EQUALS 0.5
#ASSERT `s 212(a) the number of votes the stockholder is entitled to cast` FALSE 100 1 EQUALS 0
-- a class with 10 votes per share: 1,000 votes in favour of 2,500 votes outstanding is not a majority, 1,251 is
#ASSERT `the vote carries` (`a majority of` `the outstanding stock entitled to vote`) 1251 2500 EQUALS JUST TRUE
#ASSERT `the vote carries` (`a majority of` `the outstanding stock entitled to vote`) 1250 2500 EQUALS JUST FALSE

§§ `s 212(b): proxies`

#ASSERT `s 212(b) the stockholder may authorize another person or persons to act for the stockholder by proxy` TRUE FALSE
#ASSERT `s 212(b) the stockholder may authorize another person or persons to act for the stockholder by proxy` FALSE TRUE
#ASSERT NOT (`s 212(b) the stockholder may authorize another person or persons to act for the stockholder by proxy` FALSE FALSE)
-- src:779: not after 3 years from its date. A proxy dated 1 June 2023: 1 June 2026 is the last day.
#ASSERT `s 212(b) the three-year limit does not stop the proxy being voted or acted upon` (YearMonthDay 2023 6 1) FALSE NOTHING (YearMonthDay 2026 6 1)
#ASSERT NOT (`s 212(b) the three-year limit does not stop the proxy being voted or acted upon` (YearMonthDay 2023 6 1) FALSE NOTHING (YearMonthDay 2026 6 2))
#ASSERT `s 212(b) the three-year limit does not stop the proxy being voted or acted upon` (YearMonthDay 2023 6 1) FALSE NOTHING (YearMonthDay 2023 6 2)
-- a proxy dated 29 February 2024: the third anniversary clamps to 28 February 2027
#ASSERT `s 212(b) the three-year limit does not stop the proxy being voted or acted upon` (YearMonthDay 2024 2 29) FALSE NOTHING (YearMonthDay 2027 2 28)
#ASSERT NOT (`s 212(b) the three-year limit does not stop the proxy being voted or acted upon` (YearMonthDay 2024 2 29) FALSE NOTHING (YearMonthDay 2027 3 1))
-- a proxy that provides for a longer period: until 1 June 2030
#ASSERT `s 212(b) the three-year limit does not stop the proxy being voted or acted upon` (YearMonthDay 2023 6 1) TRUE (JUST (YearMonthDay 2030 6 1)) (YearMonthDay 2029 1 1)
#ASSERT `s 212(b) the three-year limit does not stop the proxy being voted or acted upon` (YearMonthDay 2023 6 1) TRUE (JUST (YearMonthDay 2030 6 1)) (YearMonthDay 2030 6 1)
#ASSERT NOT (`s 212(b) the three-year limit does not stop the proxy being voted or acted upon` (YearMonthDay 2023 6 1) TRUE (JUST (YearMonthDay 2030 6 1)) (YearMonthDay 2030 6 2))
-- a longer period with no stated last day: the 3 years do not apply
#ASSERT `s 212(b) the three-year limit does not stop the proxy being voted or acted upon` (YearMonthDay 2023 6 1) TRUE NOTHING (YearMonthDay 2040 1 1)

§§ `s 212(c): valid means`

GIVEN executed IS A BOOLEAN
      sent IS A BOOLEAN
      info IS A BOOLEAN
      s116 IS A BOOLEAN
      identity IS A BOOLEAN
GIVETH A `s 212(c) Facts about the authorization`
`t212 authorization` executed sent info s116 identity MEANS
    `s 212(c) Facts about the authorization` WITH
        `the document was executed by the stockholder or by the stockholder's authorized officer, director, employee or agent` IS executed
        `the electronic transmission was sent to the person who will hold the proxy or to an agent duly authorized by that person to receive it` IS sent
        `the transmission sets forth, or is submitted with, information from which it can be determined that the stockholder authorized it` IS info
        `the authorization was documented, signed and delivered in accordance with s 116` IS s116
        `the authorization sets forth, or is delivered with information enabling the corporation to determine, the identity of the stockholder` IS identity

#ASSERT `s 212(c) the way of authorizing the proxy is a valid means` `a document executed by the stockholder or the stockholder's authorized officer, director, employee or agent` (`t212 authorization` TRUE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `s 212(c) the way of authorizing the proxy is a valid means` `a document executed by the stockholder or the stockholder's authorized officer, director, employee or agent` (`t212 authorization` FALSE TRUE TRUE TRUE TRUE) EQUALS NOTHING
#ASSERT `s 212(c) the way of authorizing the proxy is a valid means` `an electronic transmission to the holder of the proxy or to a duly authorized proxy solicitation firm, proxy support service organization or like agent` (`t212 authorization` FALSE TRUE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `s 212(c) the way of authorizing the proxy is a valid means` `an electronic transmission to the holder of the proxy or to a duly authorized proxy solicitation firm, proxy support service organization or like agent` (`t212 authorization` TRUE TRUE FALSE TRUE TRUE) EQUALS NOTHING
#ASSERT `s 212(c) the way of authorizing the proxy is a valid means` `an electronic transmission to the holder of the proxy or to a duly authorized proxy solicitation firm, proxy support service organization or like agent` (`t212 authorization` TRUE FALSE TRUE TRUE TRUE) EQUALS NOTHING
#ASSERT `s 212(c) the way of authorizing the proxy is a valid means` `an authorization documented, signed and delivered in accordance with s 116` (`t212 authorization` FALSE FALSE FALSE TRUE TRUE) EQUALS JUST TRUE
#ASSERT `s 212(c) the way of authorizing the proxy is a valid means` `an authorization documented, signed and delivered in accordance with s 116` (`t212 authorization` TRUE TRUE TRUE TRUE FALSE) EQUALS NOTHING
#ASSERT `s 212(c) the way of authorizing the proxy is a valid means` `an authorization documented, signed and delivered in accordance with s 116` (`t212 authorization` TRUE TRUE TRUE FALSE TRUE) EQUALS NOTHING
#ASSERT `s 212(c)(2) the inspectors or the other persons making the determination must specify the information upon which they relied` TRUE
#ASSERT NOT (`s 212(c)(2) the inspectors or the other persons making the determination must specify the information upon which they relied` FALSE)

§§ `s 212(d): reproductions`

#ASSERT `s 212(d) the reproduction may be substituted or used in lieu of the original for any purpose for which the original could be used` TRUE TRUE
#ASSERT NOT (`s 212(d) the reproduction may be substituted or used in lieu of the original for any purpose for which the original could be used` TRUE FALSE)
#ASSERT NOT (`s 212(d) the reproduction may be substituted or used in lieu of the original for any purpose for which the original could be used` FALSE TRUE)

§§ `s 212(e): irrevocable proxies`

-- src:785: duly executed, states it is irrevocable, and coupled with an interest sufficient in law; the interest may be in the stock or in the corporation generally
#ASSERT `s 212(e) the proxy is irrevocable` TRUE TRUE `an interest in the stock itself` TRUE
#ASSERT `s 212(e) the proxy is irrevocable` TRUE TRUE `an interest in the corporation generally` TRUE
#ASSERT NOT (`s 212(e) the proxy is irrevocable` TRUE TRUE `no interest` TRUE)
#ASSERT NOT (`s 212(e) the proxy is irrevocable` TRUE TRUE `an interest in the stock itself` FALSE)
#ASSERT NOT (`s 212(e) the proxy is irrevocable` TRUE FALSE `an interest in the stock itself` TRUE)
#ASSERT NOT (`s 212(e) the proxy is irrevocable` FALSE TRUE `an interest in the stock itself` TRUE)

§§ `s 214: cumulative voting`

-- src:795: votes the holder would otherwise cast, multiplied by the number of directors to be elected. 100 votes, 3 seats: 300.
#ASSERT `s 214 the number of votes the holder is entitled to cast in the election of directors` TRUE TRUE 100 3 EQUALS JUST 300
#ASSERT `s 214 the number of votes the holder is entitled to cast in the election of directors` TRUE TRUE 100 1 EQUALS JUST 100
-- no cumulative voting unless the certificate provides it, and only for the stock it covers
#ASSERT `s 214 the number of votes the holder is entitled to cast in the election of directors` FALSE TRUE 100 3 EQUALS NOTHING
#ASSERT `s 214 the number of votes the holder is entitled to cast in the election of directors` TRUE FALSE 100 3 EQUALS NOTHING
#ASSERT `s 214 the holder may cast all the votes for a single director or distribute them among the directors to be voted for` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 214 the holder may cast all the votes for a single director or distribute them among the directors to be voted for` FALSE TRUE EQUALS NOTHING
