IMPORT prelude
IMPORT daydate
IMPORT `dg-core`
IMPORT `dg7-governing-provisions`
IMPORT `dg7-appraisal-rights`
IMPORT `dg7-appraisal-procedure`
IMPORT `dg7-appraisal-proceeding`

-- Tests of dg7-appraisal-proceeding.l4 (8 Del. C. s 262(g) to (l)).
-- Every expected value is decided here from the text of s 262(g) to (l) (src:1269-1274), then compared with the rule's answer.

§ `Fixtures`

GIVEN listed IS A BOOLEAN
      entitled IS A NUMBER
      outstanding IS A NUMBER
      value IS A NUMBER
      shortForm IS A BOOLEAN
GIVETH A `s 262(g) Shares seeking appraisal`
`test shares seeking appraisal with` listed entitled outstanding value shortForm MEANS
    `s 262(g) Shares seeking appraisal` WITH
        `the shares were listed on a national securities exchange immediately before the transaction` IS listed
        `the total number of shares entitled to appraisal` IS entitled
        `the number of outstanding shares of the class or series eligible for appraisal` IS outstanding
        `the value of the consideration provided in the transaction for such total number of shares` IS value
        `the merger was approved pursuant to s 253 or s 267` IS shortForm

§ `s 262(g) -- the hearing and dismissal`

#ASSERT `s 262(g) the person is one of the persons the Court has determined to be entitled to appraisal rights` TRUE
#ASSERT NOT (`s 262(g) the person is one of the persons the Court has determined to be entitled to appraisal rights` FALSE)

-- Certificates: all four things must be so.
#ASSERT `s 262(g) the Court may dismiss the proceedings as to the person for not submitting certificates` TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 262(g) the Court may dismiss the proceedings as to the person for not submitting certificates` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`s 262(g) the Court may dismiss the proceedings as to the person for not submitting certificates` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 262(g) the Court may dismiss the proceedings as to the person for not submitting certificates` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 262(g) the Court may dismiss the proceedings as to the person for not submitting certificates` TRUE TRUE TRUE FALSE)

-- The de minimis dismissal of a listed class. Listed, 0.1% of the shares, $500,000: must dismiss.
#ASSERT `s 262(g) the Court must dismiss the proceedings as to all holders of the shares` (`test shares seeking appraisal with` TRUE 100 100000 500000 FALSE) EQUALS JUST TRUE
-- Exactly 1% (1,000 of 100,000) does not "exceed 1%": must dismiss.
#ASSERT `s 262(g) the Court must dismiss the proceedings as to all holders of the shares` (`test shares seeking appraisal with` TRUE 1000 100000 500000 FALSE) EQUALS JUST TRUE
-- 1,001 of 100,000 exceeds 1%: not dismissed.
#ASSERT `s 262(g) the Court must dismiss the proceedings as to all holders of the shares` (`test shares seeking appraisal with` TRUE 1001 100000 500000 FALSE) EQUALS JUST FALSE
-- Consideration of exactly $1,000,000 does not "exceed $1 million": must dismiss; $1,000,001 exceeds it.
#ASSERT `s 262(g) the Court must dismiss the proceedings as to all holders of the shares` (`test shares seeking appraisal with` TRUE 100 100000 1000000 FALSE) EQUALS JUST TRUE
#ASSERT `s 262(g) the Court must dismiss the proceedings as to all holders of the shares` (`test shares seeking appraisal with` TRUE 100 100000 1000001 FALSE) EQUALS JUST FALSE
-- A merger approved under s 253 or s 267: not dismissed.
#ASSERT `s 262(g) the Court must dismiss the proceedings as to all holders of the shares` (`test shares seeking appraisal with` TRUE 100 100000 500000 TRUE) EQUALS JUST FALSE
-- Not listed: this sentence does not apply, however small the holding.
#ASSERT `s 262(g) the Court must dismiss the proceedings as to all holders of the shares` (`test shares seeking appraisal with` FALSE 100 100000 500000 FALSE) EQUALS JUST FALSE
-- Not covered: listed, but no outstanding shares eligible, more shares entitled than outstanding, or a negative count.
#ASSERT `s 262(g) the Court must dismiss the proceedings as to all holders of the shares` (`test shares seeking appraisal with` TRUE 100 0 500000 FALSE) EQUALS NOTHING
#ASSERT `s 262(g) the Court must dismiss the proceedings as to all holders of the shares` (`test shares seeking appraisal with` TRUE 100001 100000 500000 FALSE) EQUALS NOTHING
#ASSERT `s 262(g) the Court must dismiss the proceedings as to all holders of the shares` (`test shares seeking appraisal with` TRUE (0 MINUS 1) 100000 500000 FALSE) EQUALS NOTHING
-- Not listed with impossible counts: the sentence does not apply, so FALSE.
#ASSERT `s 262(g) the Court must dismiss the proceedings as to all holders of the shares` (`test shares seeking appraisal with` FALSE 100001 100000 500000 FALSE) EQUALS JUST FALSE

§ `s 262(h) -- valuation, interest and participation`

-- Fair value exclusive of the element of value arising from the accomplishment or expectation of the merger: 1,000,000 less 150,000.
#ASSERT `s 262(h) the fair value of the shares` 1000000 150000 EQUALS 850000
#ASSERT `s 262(h) the fair value of the shares` 1000000 0 EQUALS 1000000

-- Interest, two whole quarters at a discount rate of 3%: each quarter (3% + 5%) / 4 = 2%, so 1.02 x 1.02 = 1.0404; on $100,000 that is $4,040.
#ASSERT `s 262(h) the interest on the fair value` 100000 NOTHING (LIST 3%, 3%) 0 EQUALS JUST 4040
-- One quarter at 3.5%: (3.5% + 5%) / 4 = 2.125%; on $200,000 that is $4,250.
#ASSERT `s 262(h) the interest on the fair value` 200000 NOTHING (LIST 3.5%) 0 EQUALS JUST 4250
-- Rates that change from quarter to quarter: 2% then 4%: (7% / 4) = 1.75% and (9% / 4) = 2.25%; 1.0175 x 1.0225 = 1.04039375; on $1,000,000: $40,393.75.
#ASSERT `s 262(h) the interest on the fair value` 1000000 NOTHING (LIST 2%, 4%) 0 EQUALS JUST 40393.75
-- No whole quarter has run: no interest yet.
#ASSERT `s 262(h) the interest on the fair value` 1000000 NOTHING EMPTY 0 EQUALS JUST 0
-- Not covered: a part of a quarter remains (the text does not say how it accrues).
#ASSERT `s 262(h) the interest on the fair value` 100000 NOTHING (LIST 3%, 3%) 10 EQUALS NOTHING
-- The Court determines otherwise for good cause shown: whatever it determines.
#ASSERT `s 262(h) the interest on the fair value` 100000 (JUST 123) (LIST 3%, 3%) 0 EQUALS JUST 123
#ASSERT `s 262(h) the interest on the fair value` 100000 (JUST 0) (LIST 3%, 3%) 10 EQUALS JUST 0

-- After a payment in cash: interest accrues only on (fair value less the payment) plus accrued interest not paid.
-- Fair value 1,000,000, paid 600,000, accrued 20,000 not paid at that time: 400,000 + 20,000.
#ASSERT `s 262(h) the sum on which interest accrues after a payment in cash` 1000000 600000 20000 FALSE EQUALS 420000
-- The accrued interest was paid with the payment: 400,000 alone.
#ASSERT `s 262(h) the sum on which interest accrues after a payment in cash` 1000000 600000 20000 TRUE EQUALS 400000
-- "the difference, if any": a payment above the fair value leaves no difference, only the unpaid accrued interest.
#ASSERT `s 262(h) the sum on which interest accrues after a payment in cash` 1000000 1100000 5000 FALSE EQUALS 5000

#ASSERT `s 262(h) the applicant may apply for trial before the persons entitled are finally determined` TRUE FALSE
#ASSERT `s 262(h) the applicant may apply for trial before the persons entitled are finally determined` FALSE TRUE
#ASSERT NOT (`s 262(h) the applicant may apply for trial before the persons entitled are finally determined` FALSE FALSE)

#ASSERT `s 262(h) the person may participate fully in all proceedings` TRUE FALSE
#ASSERT NOT (`s 262(h) the person may participate fully in all proceedings` TRUE TRUE)
#ASSERT NOT (`s 262(h) the person may participate fully in all proceedings` FALSE FALSE)

§ `s 262(i) -- the direction to pay`

#ASSERT `s 262(i) the amount the Court directs the entity to pay the person` 850000 (JUST 4250) EQUALS JUST 854250
#ASSERT `s 262(i) the amount the Court directs the entity to pay the person` 850000 (JUST 0) EQUALS JUST 850000
#ASSERT `s 262(i) the amount the Court directs the entity to pay the person` 850000 NOTHING EQUALS NOTHING

-- "whether such surviving, resulting or converted entity be an entity of this State or of any state".
#ASSERT `s 262(i) the decree may be enforced as other decrees of the Court of Chancery are enforced` `this State` EQUALS JUST TRUE
#ASSERT `s 262(i) the decree may be enforced as other decrees of the Court of Chancery are enforced` `another jurisdiction of the United States` EQUALS JUST TRUE
-- Not covered: an entity formed outside the United States is not an entity "of any state".
#ASSERT `s 262(i) the decree may be enforced as other decrees of the Court of Chancery are enforced` `a foreign jurisdiction outside the United States` EQUALS NOTHING

§ `s 262(j) -- costs and expenses`

#ASSERT `s 262(j) the costs of the proceeding may be taxed upon the person` TRUE TRUE
#ASSERT NOT (`s 262(j) the costs of the proceeding may be taxed upon the person` FALSE TRUE)
#ASSERT NOT (`s 262(j) the costs of the proceeding may be taxed upon the person` TRUE FALSE)

#ASSERT `s 262(j) the person may apply for an order that expenses be charged against the shares` TRUE TRUE TRUE
#ASSERT NOT (`s 262(j) the person may apply for an order that expenses be charged against the shares` FALSE TRUE TRUE)
#ASSERT NOT (`s 262(j) the person may apply for an order that expenses be charged against the shares` TRUE FALSE TRUE)
#ASSERT NOT (`s 262(j) the person may apply for an order that expenses be charged against the shares` TRUE TRUE FALSE)

-- Pro rata: $90,000 ordered; the person's shares are worth 2,000,000 of 18,000,000: one ninth, $10,000.
#ASSERT `s 262(j) the person's pro rata share of the expenses charged against the shares` 90000 2000000 18000000 EQUALS JUST 10000
-- A holder of all the shares bears all of it; a holder of none bears none.
#ASSERT `s 262(j) the person's pro rata share of the expenses charged against the shares` 90000 18000000 18000000 EQUALS JUST 90000
#ASSERT `s 262(j) the person's pro rata share of the expenses charged against the shares` 90000 0 18000000 EQUALS JUST 0
-- Not covered: no shares to spread over, a negative value, or a holding worth more than the total.
#ASSERT `s 262(j) the person's pro rata share of the expenses charged against the shares` 90000 0 0 EQUALS NOTHING
#ASSERT `s 262(j) the person's pro rata share of the expenses charged against the shares` 90000 (0 MINUS 5) 18000000 EQUALS NOTHING
#ASSERT `s 262(j) the person's pro rata share of the expenses charged against the shares` 90000 18000001 18000000 EQUALS NOTHING

§ `s 262(k) -- the person who has demanded appraisal`

-- Effective 25 June 2026. A person who demanded and has not withdrawn cannot vote the shares from the effective date on.
#ASSERT `s 262(k) the person is barred from voting the shares` TRUE FALSE (YearMonthDay 2026 6 26) (YearMonthDay 2026 6 25) EQUALS JUST TRUE
#ASSERT `s 262(k) the person is barred from voting the shares` TRUE FALSE (YearMonthDay 2026 6 25) (YearMonthDay 2026 6 25) EQUALS JUST TRUE
-- Before the effective date, the subsection bars nothing.
#ASSERT `s 262(k) the person is barred from voting the shares` TRUE FALSE (YearMonthDay 2026 6 24) (YearMonthDay 2026 6 25) EQUALS JUST FALSE
-- A person who did not demand is not barred by this subsection.
#ASSERT `s 262(k) the person is barred from voting the shares` FALSE FALSE (YearMonthDay 2026 7 1) (YearMonthDay 2026 6 25) EQUALS JUST FALSE
-- Not covered: the right has since ceased (the text does not say whether the bar lifts).
#ASSERT `s 262(k) the person is barred from voting the shares` TRUE TRUE (YearMonthDay 2026 7 1) (YearMonthDay 2026 6 25) EQUALS NOTHING

-- Dividends: barred, except those payable to stockholders of record at a date prior to the effective date.
#ASSERT `s 262(k) the person is barred from receiving the dividend or distribution on the shares` TRUE FALSE (YearMonthDay 2026 7 15) (YearMonthDay 2026 7 1) (YearMonthDay 2026 6 25) EQUALS JUST TRUE
#ASSERT `s 262(k) the person is barred from receiving the dividend or distribution on the shares` TRUE FALSE (YearMonthDay 2026 7 15) (YearMonthDay 2026 6 25) (YearMonthDay 2026 6 25) EQUALS JUST TRUE
-- Record date prior to the effective date, paid after it: not barred.
#ASSERT `s 262(k) the person is barred from receiving the dividend or distribution on the shares` TRUE FALSE (YearMonthDay 2026 7 15) (YearMonthDay 2026 6 24) (YearMonthDay 2026 6 25) EQUALS JUST FALSE
-- Paid before the effective date: not barred.
#ASSERT `s 262(k) the person is barred from receiving the dividend or distribution on the shares` TRUE FALSE (YearMonthDay 2026 6 20) (YearMonthDay 2026 6 1) (YearMonthDay 2026 6 25) EQUALS JUST FALSE
#ASSERT `s 262(k) the person is barred from receiving the dividend or distribution on the shares` FALSE FALSE (YearMonthDay 2026 7 15) (YearMonthDay 2026 7 1) (YearMonthDay 2026 6 25) EQUALS JUST FALSE
#ASSERT `s 262(k) the person is barred from receiving the dividend or distribution on the shares` TRUE TRUE (YearMonthDay 2026 7 15) (YearMonthDay 2026 7 1) (YearMonthDay 2026 6 25) EQUALS NOTHING

-- Withdrawal within 60 days after 25 June 2026 (to 24 August 2026), or later with the corporation's written approval.
#ASSERT `s 262(k) the right of the person to an appraisal of the shares subject to the withdrawal ceases` TRUE (YearMonthDay 2026 8 24) FALSE (YearMonthDay 2026 6 25)
#ASSERT NOT (`s 262(k) the right of the person to an appraisal of the shares subject to the withdrawal ceases` TRUE (YearMonthDay 2026 8 25) FALSE (YearMonthDay 2026 6 25))
#ASSERT `s 262(k) the right of the person to an appraisal of the shares subject to the withdrawal ceases` TRUE (YearMonthDay 2026 8 25) TRUE (YearMonthDay 2026 6 25)
#ASSERT NOT (`s 262(k) the right of the person to an appraisal of the shares subject to the withdrawal ceases` FALSE (YearMonthDay 2026 7 1) TRUE (YearMonthDay 2026 6 25))

#ASSERT `s 262(k) the proceeding cannot be dismissed as to the person without the approval of the Court` TRUE
#ASSERT NOT (`s 262(k) the proceeding cannot be dismissed as to the person without the approval of the Court` FALSE)

-- No petition within 120 days of 25 June 2026 (the last day is 23 October 2026).
#ASSERT `s 262(k) the right to appraisal with respect to all shares has ceased for want of a petition` (JUST (YearMonthDay 2026 10 23)) (YearMonthDay 2026 6 25) (YearMonthDay 2027 1 1) EQUALS FALSE
#ASSERT `s 262(k) the right to appraisal with respect to all shares has ceased for want of a petition` (JUST (YearMonthDay 2026 10 24)) (YearMonthDay 2026 6 25) (YearMonthDay 2027 1 1) EQUALS TRUE
#ASSERT `s 262(k) the right to appraisal with respect to all shares has ceased for want of a petition` NOTHING (YearMonthDay 2026 6 25) (YearMonthDay 2026 10 23) EQUALS FALSE
#ASSERT `s 262(k) the right to appraisal with respect to all shares has ceased for want of a petition` NOTHING (YearMonthDay 2026 6 25) (YearMonthDay 2026 10 24) EQUALS TRUE

§ `s 262(l) -- the shares that would have been issued`

#ASSERT `s 262(l) the shares or equity interests have the status of authorized but not outstanding` TRUE TRUE
#ASSERT NOT (`s 262(l) the shares or equity interests have the status of authorized but not outstanding` TRUE FALSE)
#ASSERT NOT (`s 262(l) the shares or equity interests have the status of authorized but not outstanding` FALSE TRUE)
