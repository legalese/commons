#ASSERT NOT (`s 114(b) and (c) subsection (a) does not apply to the provision` `a nonprofit nonstock corporation that is not charitable` (`s 114 the whole of section` 205))
#ASSERT NOT (`s 114(b) and (c) subsection (a) does not apply to the provision` `a nonprofit nonstock corporation that is not charitable` (`s 114 the whole of section` 175))
#ASSERT NOT (`s 114(b) and (c) subsection (a) does not apply to the provision` `a nonprofit nonstock corporation that is not charitable` (`s 114 the whole of section` 369))
-- subchapters V, VI and XV are not out for a nonstock corporation with membership interests
#ASSERT NOT (`s 114(b) and (c) subsection (a) does not apply to the provision` `a nonstock corporation with membership interests` (`s 114 the whole of section` 160))
#ASSERT NOT (`s 114(b) and (c) subsection (a) does not apply to the provision` `a nonstock corporation with membership interests` (`s 114 the whole of section` 361))
-- the reading, applying the lists
#ASSERT `s 114(a) how the reference in the provision is read` `a nonstock corporation with membership interests` (`s 114 the whole of section` 160) `a reference to stockholders of the corporation` EQUALS `as a reference to members of the corporation`
#ASSERT `s 114(a) how the reference in the provision is read` `a nonprofit nonstock corporation that is not charitable` (`s 114 the whole of section` 160) `a reference to stockholders of the corporation` EQUALS `as written`
#ASSERT `s 114(a) how the reference in the provision is read` `a nonprofit nonstock corporation that is not charitable` (`s 114 the whole of section` 204) `a reference to stockholders of the corporation` EQUALS `as a reference to members of the corporation`
#ASSERT `s 114(a) how the reference in the provision is read` `a nonstock corporation with membership interests` (`s 114 the whole of section` 141) `a reference to the board of directors of the corporation` EQUALS `as written`

§§ `s 114(d) definitions`

-- a nonstock corporation: organized under the chapter and not authorized to issue capital stock
#ASSERT `s 114(d)(4) the corporation is a nonstock corporation` TRUE FALSE
#ASSERT NOT (`s 114(d)(4) the corporation is a nonstock corporation` TRUE TRUE)
#ASSERT NOT (`s 114(d)(4) the corporation is a nonstock corporation` FALSE FALSE)
-- a membership interest: a share of profits and losses, or a right to distributions of assets, or both, unless the certificate provides otherwise
#ASSERT `s 114(d)(2) the interest of the member is a membership interest` FALSE TRUE FALSE
#ASSERT `s 114(d)(2) the interest of the member is a membership interest` FALSE FALSE TRUE
#ASSERT `s 114(d)(2) the interest of the member is a membership interest` FALSE TRUE TRUE
#ASSERT NOT (`s 114(d)(2) the interest of the member is a membership interest` FALSE FALSE FALSE)
#ASSERT NOT (`s 114(d)(2) the interest of the member is a membership interest` TRUE TRUE TRUE)
-- a nonprofit nonstock corporation: a nonstock corporation that does not have membership interests
#ASSERT `s 114(d)(3) the corporation is a nonprofit nonstock corporation` TRUE FALSE
#ASSERT NOT (`s 114(d)(3) the corporation is a nonprofit nonstock corporation` TRUE TRUE)
#ASSERT NOT (`s 114(d)(3) the corporation is a nonprofit nonstock corporation` FALSE FALSE)
-- a charitable nonstock corporation: a nonprofit nonstock corporation exempt under section 501(c)(3)
#ASSERT `s 114(d)(1) the corporation is a charitable nonstock corporation` TRUE TRUE
#ASSERT NOT (`s 114(d)(1) the corporation is a charitable nonstock corporation` TRUE FALSE)
#ASSERT NOT (`s 114(d)(1) the corporation is a charitable nonstock corporation` FALSE TRUE)
-- the four kinds
#ASSERT `s 114(d) the kind of the corporation` TRUE TRUE FALSE FALSE EQUALS JUST `a stock corporation`
#ASSERT `s 114(d) the kind of the corporation` TRUE FALSE TRUE FALSE EQUALS JUST `a nonstock corporation with membership interests`
#ASSERT `s 114(d) the kind of the corporation` TRUE FALSE FALSE FALSE EQUALS JUST `a nonprofit nonstock corporation that is not charitable`
#ASSERT `s 114(d) the kind of the corporation` TRUE FALSE FALSE TRUE EQUALS JUST `a charitable nonstock corporation`
-- membership interests make it not nonprofit, whether or not it is exempt
#ASSERT `s 114(d) the kind of the corporation` TRUE FALSE TRUE TRUE EQUALS JUST `a nonstock corporation with membership interests`
-- not organized under this chapter: not covered
#ASSERT `s 114(d) the kind of the corporation` FALSE FALSE FALSE FALSE EQUALS NOTHING
-- the core's predicates read the kinds decided here
#ASSERT `the kind is a nonstock corporation` `a charitable nonstock corporation`
#ASSERT `the kind is a nonprofit nonstock corporation` `a charitable nonstock corporation`
#ASSERT NOT (`the kind is a nonprofit nonstock corporation` `a nonstock corporation with membership interests`)
