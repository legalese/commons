IMPORT prelude
IMPORT `dg-core`
IMPORT `dg11-s395-trust-in-name`

-- Tests of dg11-s395-trust-in-name.l4 (section 395). Expected values are written by hand from the text, beside each assertion.
-- Argument order in every call is the order of the rule's GIVEN, as the .l4 module lists it.

§ `Section 395(d) - the exception`

-- src:2095-2098: all five limbs hold -> the exception applies. Arguments: supervised?, federally regulated?, (1) no trust business,
-- (2) not misleading, (3) the officials' determination of no pattern and practice of abuse.
#ASSERT `s 395(d) the requirements and restrictions of subsections (a) and (b) do not apply to the corporation` FALSE FALSE TRUE TRUE TRUE
-- supervised by the Commissioner: no exception ("not subject to the supervision")
#ASSERT NOT `s 395(d) the requirements and restrictions of subsections (a) and (b) do not apply to the corporation` TRUE FALSE TRUE TRUE TRUE
-- regulated under the federal statutes: no exception
#ASSERT NOT `s 395(d) the requirements and restrictions of subsections (a) and (b) do not apply to the corporation` FALSE TRUE TRUE TRUE TRUE
-- (1) fails: the use does refer to a trust business
#ASSERT NOT `s 395(d) the requirements and restrictions of subsections (a) and (b) do not apply to the corporation` FALSE FALSE FALSE TRUE TRUE
-- (2) fails: likely to mislead
#ASSERT NOT `s 395(d) the requirements and restrictions of subsections (a) and (b) do not apply to the corporation` FALSE FALSE TRUE FALSE TRUE
-- (3) fails: the Director and the Commissioner have not so determined
#ASSERT NOT `s 395(d) the requirements and restrictions of subsections (a) and (b) do not apply to the corporation` FALSE FALSE TRUE TRUE FALSE

§ `Section 395(a) - supervision and reports`

-- src:2092. Arguments: uses "trust" in its name?, federally regulated?, subsection (d) exception applies?
-- uses trust, not regulated, no exception: under supervision and must report
#ASSERT `s 395(a) the corporation is under the supervision of the State Bank Commissioner and must make reports to the Commissioner` TRUE FALSE FALSE
-- regulated under the federal statutes: excepted
#ASSERT NOT `s 395(a) the corporation is under the supervision of the State Bank Commissioner and must make reports to the Commissioner` TRUE TRUE FALSE
-- subsection (d) exception applies: "Except as provided below in subsection (d)"
#ASSERT NOT `s 395(a) the corporation is under the supervision of the State Bank Commissioner and must make reports to the Commissioner` TRUE FALSE TRUE
-- does not use the word trust: not within the subsection
#ASSERT NOT `s 395(a) the corporation is under the supervision of the State Bank Commissioner and must make reports to the Commissioner` FALSE FALSE FALSE

#ASSERT `s 395(a) the fewest reports that the corporation must make to the Commissioner during each year` EQUALS 2
#ASSERT `s 395(a) the fewest directors whose signatures must attest each report` EQUALS 3

-- A report: in the prescribed form; verified by president or vice-president AND by treasurer or secretary; attested by at least 3 directors.
`a report that meets every requirement` MEANS `s 395(a) Report made to the State Bank Commissioner` WITH
    `report is in the form prescribed by the Commissioner` IS TRUE
    `report is verified by the oath or affirmation of the president or vice-president` IS TRUE
    `report is verified by the oath or affirmation of the treasurer or secretary` IS TRUE
    `directors whose signatures attest the report` IS 3

#ASSERT `s 395(a) the report is in the form, verified and attested as required` `a report that meets every requirement`

-- three directors is enough (boundary), two is not
`a report attested by only 2 directors` MEANS `s 395(a) Report made to the State Bank Commissioner` WITH
    `report is in the form prescribed by the Commissioner` IS TRUE
    `report is verified by the oath or affirmation of the president or vice-president` IS TRUE
    `report is verified by the oath or affirmation of the treasurer or secretary` IS TRUE
    `directors whose signatures attest the report` IS 2

#ASSERT NOT `s 395(a) the report is in the form, verified and attested as required` `a report attested by only 2 directors`

`a report attested by 4 directors` MEANS `s 395(a) Report made to the State Bank Commissioner` WITH
    `report is in the form prescribed by the Commissioner` IS TRUE
    `report is verified by the oath or affirmation of the president or vice-president` IS TRUE
    `report is verified by the oath or affirmation of the treasurer or secretary` IS TRUE
    `directors whose signatures attest the report` IS 4

#ASSERT `s 395(a) the report is in the form, verified and attested as required` `a report attested by 4 directors`

-- verified by the president or a vice-president only (not also by the treasurer or secretary): fails; verified by the treasurer only: fails
`a report verified only by the president` MEANS `s 395(a) Report made to the State Bank Commissioner` WITH
    `report is in the form prescribed by the Commissioner` IS TRUE
    `report is verified by the oath or affirmation of the president or vice-president` IS TRUE
    `report is verified by the oath or affirmation of the treasurer or secretary` IS FALSE
    `directors whose signatures attest the report` IS 3

#ASSERT NOT `s 395(a) the report is in the form, verified and attested as required` `a report verified only by the president`

`a report verified only by the treasurer` MEANS `s 395(a) Report made to the State Bank Commissioner` WITH
    `report is in the form prescribed by the Commissioner` IS TRUE
    `report is verified by the oath or affirmation of the president or vice-president` IS FALSE
    `report is verified by the oath or affirmation of the treasurer or secretary` IS TRUE
    `directors whose signatures attest the report` IS 3

#ASSERT NOT `s 395(a) the report is in the form, verified and attested as required` `a report verified only by the treasurer`

`a report not in the prescribed form` MEANS `s 395(a) Report made to the State Bank Commissioner` WITH
    `report is in the form prescribed by the Commissioner` IS FALSE
    `report is verified by the oath or affirmation of the president or vice-president` IS TRUE
    `report is verified by the oath or affirmation of the treasurer or secretary` IS TRUE
    `directors whose signatures attest the report` IS 3

#ASSERT NOT `s 395(a) the report is in the form, verified and attested as required` `a report not in the prescribed form`

-- "not less than 2 reports during each year": 2 is enough, 1 is not, 3 is more than enough
#ASSERT `s 395(a) the corporation has made enough reports during the year` 2
#ASSERT `s 395(a) the corporation has made enough reports during the year` 3
#ASSERT NOT `s 395(a) the corporation has made enough reports during the year` 1
#ASSERT NOT `s 395(a) the corporation has made enough reports during the year` 0

§ `Section 395(b) - the name`

-- src:2093, first sentence. Arguments: reports to and under the supervision of the Commissioner?, federally regulated?, subsection (d) exception?
#ASSERT `s 395(b) the corporation may use the word trust as part of its name` TRUE FALSE FALSE
#ASSERT `s 395(b) the corporation may use the word trust as part of its name` FALSE TRUE FALSE
#ASSERT `s 395(b) the corporation may use the word trust as part of its name` FALSE FALSE TRUE
#ASSERT NOT `s 395(b) the corporation may use the word trust as part of its name` FALSE FALSE FALSE

-- src:2093, last sentence. Arguments: reports and supervised?, regulated under the BHCA or the Savings and Loan Holding Company Act?, (d) exception?
#ASSERT `s 395(b) the corporation's name may be amended so as to include the word trust` TRUE FALSE FALSE
#ASSERT `s 395(b) the corporation's name may be amended so as to include the word trust` FALSE TRUE FALSE
#ASSERT `s 395(b) the corporation's name may be amended so as to include the word trust` FALSE FALSE TRUE
#ASSERT NOT `s 395(b) the corporation's name may be amended so as to include the word trust` FALSE FALSE FALSE

§ `Section 395(c) - acting as a trust company`

-- src:2094. Arguments: reports and supervised?, federally regulated? There is no subsection (d) exception to (c).
#ASSERT `s 395(c) the corporation may advertise, solicit or receive deposits or transact business as a trust company` TRUE FALSE
#ASSERT `s 395(c) the corporation may advertise, solicit or receive deposits or transact business as a trust company` FALSE TRUE
#ASSERT NOT `s 395(c) the corporation may advertise, solicit or receive deposits or transact business as a trust company` FALSE FALSE
