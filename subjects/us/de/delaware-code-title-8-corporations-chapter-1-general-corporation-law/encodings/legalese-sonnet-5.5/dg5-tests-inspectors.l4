IMPORT prelude
IMPORT daydate
IMPORT `dg-core`
IMPORT `dg5-s231-inspectors`

-- Tests of dg5-s231-inspectors.l4 (8 Del. C. s 231).
-- Every expected value is written by hand from the text (src:954-967 of de-code-t8-ch1-2026-10-01.txt), beside the assertion.

§ `Section 231(e) -- whether the section applies`

-- helper arguments, in order: a class listed on a national exchange, a class quoted on an interdealer system, the most stockholders of record of a class,
-- where a provision otherwise providing is made, that provision makes section 231 apply.
GIVEN l IS A BOOLEAN
      q IS A BOOLEAN
      n IS A NUMBER
      w IS A `Where a provision is made`
      p IS A BOOLEAN
GIVETH A `dg5 s 231(e) Voting stock of the corporation`
`dg5 test voting stock` l q n w p MEANS
    `dg5 s 231(e) Voting stock of the corporation` WITH
          `the corporation has a class of voting stock that is listed on a national securities exchange` IS l
        , `the corporation has a class of voting stock that is authorized for quotation on an interdealer quotation system of a registered national securities association` IS q
        , `the number of stockholders of record of the class of voting stock held of record by the most stockholders` IS n
        , `where a provision otherwise providing is made` IS w
        , `that provision makes section 231 apply to the corporation` IS p

#ASSERT `s 231(e) section 231 applies to the corporation` (`dg5 test voting stock` TRUE FALSE 10 `in none of these` FALSE)
#ASSERT `s 231(e) section 231 applies to the corporation` (`dg5 test voting stock` FALSE TRUE 10 `in none of these` FALSE)
-- Held of record by more than 2,000 stockholders: 2,001 is enough, 2,000 is not.
#ASSERT `s 231(e) section 231 applies to the corporation` (`dg5 test voting stock` FALSE FALSE 2001 `in none of these` FALSE)
#ASSERT NOT (`s 231(e) section 231 applies to the corporation` (`dg5 test voting stock` FALSE FALSE 2000 `in none of these` FALSE))
#ASSERT NOT (`s 231(e) section 231 applies to the corporation` (`dg5 test voting stock` FALSE FALSE 12 `in none of these` FALSE))
-- Unless the certificate of incorporation or bylaws provide otherwise: a provision there that makes the section apply.
#ASSERT `s 231(e) section 231 applies to the corporation` (`dg5 test voting stock` FALSE FALSE 12 `in the certificate of incorporation` TRUE)
#ASSERT `s 231(e) section 231 applies to the corporation` (`dg5 test voting stock` FALSE FALSE 12 `in the bylaws` TRUE)
#ASSERT NOT (`s 231(e) section 231 applies to the corporation` (`dg5 test voting stock` FALSE FALSE 12 `in a resolution of the board of directors` TRUE))
#ASSERT NOT (`s 231(e) section 231 applies to the corporation` (`dg5 test voting stock` FALSE FALSE 12 `in the bylaws` FALSE))

§ `Section 231(a) to (d)`

#ASSERT `s 231(a) who must appoint the inspectors` TRUE FALSE EQUALS `the corporation, in advance of the meeting of stockholders`
#ASSERT `s 231(a) who must appoint the inspectors` TRUE TRUE EQUALS `the person presiding at the meeting of stockholders`
#ASSERT `s 231(a) who must appoint the inspectors` FALSE FALSE EQUALS `no one, because section 231 does not apply to the corporation`
#ASSERT `s 231(a) who must appoint the inspectors` FALSE TRUE EQUALS `no one, because section 231 does not apply to the corporation`
#ASSERT `s 231(a) the inspector may enter upon the discharge of the duties of inspector` TRUE
#ASSERT NOT (`s 231(a) the inspector may enter upon the discharge of the duties of inspector` FALSE)

-- helper arguments, in order: ascertained shares and voting power, determined shares represented and validity, counted, retained the challenge record, certified.
GIVEN a IS A BOOLEAN
      b IS A BOOLEAN
      c IS A BOOLEAN
      d IS A BOOLEAN
      e IS A BOOLEAN
GIVETH A `dg5 s 231(b) What the inspectors have done`
`dg5 test duties` a b c d e MEANS
    `dg5 s 231(b) What the inspectors have done` WITH
          `they ascertained the number of shares outstanding and the voting power of each` IS a
        , `they determined the shares represented at the meeting and the validity of proxies and ballots` IS b
        , `they counted all votes and ballots` IS c
        , `they determined and retained for a reasonable period a record of the disposition of any challenges made to any determination by them` IS d
        , `they certified their determination of the number of shares represented at the meeting and their count of all votes and ballots` IS e

#ASSERT `s 231(b) the inspectors have performed their duties` (`dg5 test duties` TRUE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`s 231(b) the inspectors have performed their duties` (`dg5 test duties` FALSE TRUE TRUE TRUE TRUE))
#ASSERT NOT (`s 231(b) the inspectors have performed their duties` (`dg5 test duties` TRUE FALSE TRUE TRUE TRUE))
#ASSERT NOT (`s 231(b) the inspectors have performed their duties` (`dg5 test duties` TRUE TRUE FALSE TRUE TRUE))
#ASSERT NOT (`s 231(b) the inspectors have performed their duties` (`dg5 test duties` TRUE TRUE TRUE FALSE TRUE))
#ASSERT NOT (`s 231(b) the inspectors have performed their duties` (`dg5 test duties` TRUE TRUE TRUE TRUE FALSE))
#ASSERT `s 231(b) the inspectors may appoint or retain other persons or entities to assist them` TRUE
#ASSERT NOT (`s 231(b) the inspectors may appoint or retain other persons or entities to assist them` FALSE)

#ASSERT `s 231(c) the announcement of the opening and the closing of the polls was made as the subsection requires` TRUE
#ASSERT NOT (`s 231(c) the announcement of the opening and the closing of the polls was made as the subsection requires` FALSE)
-- After the polls close, nothing is accepted unless the Court of Chancery, on a stockholder's application, determines otherwise.
#ASSERT `s 231(c) the inspectors may accept the ballot, proxy, vote, revocation or change` FALSE FALSE
#ASSERT NOT (`s 231(c) the inspectors may accept the ballot, proxy, vote, revocation or change` TRUE FALSE)
#ASSERT `s 231(c) the inspectors may accept the ballot, proxy, vote, revocation or change` TRUE TRUE

#ASSERT `s 231(d) the inspectors may consider the information in determining the validity and counting of proxies and ballots` `the proxies the inspectors examine` FALSE
#ASSERT `s 231(d) the inspectors may consider the information in determining the validity and counting of proxies and ballots` `any envelopes submitted with the proxies` FALSE
#ASSERT `s 231(d) the inspectors may consider the information in determining the validity and counting of proxies and ballots` `information provided in accordance with section 211(e) or section 212(c)(2)` FALSE
#ASSERT `s 231(d) the inspectors may consider the information in determining the validity and counting of proxies and ballots` `information provided pursuant to section 211(a)(2)b.(i) or (iii)` FALSE
#ASSERT `s 231(d) the inspectors may consider the information in determining the validity and counting of proxies and ballots` `the ballots the inspectors examine` FALSE
#ASSERT `s 231(d) the inspectors may consider the information in determining the validity and counting of proxies and ballots` `the regular books and records of the corporation` FALSE
-- Other reliable information: only for the limited purpose of reconciling.
#ASSERT NOT (`s 231(d) the inspectors may consider the information in determining the validity and counting of proxies and ballots` `other reliable information the inspectors consider` FALSE)
#ASSERT `s 231(d) the inspectors may consider the information in determining the validity and counting of proxies and ballots` `other reliable information the inspectors consider` TRUE

-- helper arguments, in order: considered other reliable information, specifies the precise information, the person or persons, when, the means, the basis.
GIVEN o IS A BOOLEAN
      p IS A BOOLEAN
      w IS A BOOLEAN
      t IS A BOOLEAN
      m IS A BOOLEAN
      b IS A BOOLEAN
GIVETH A `dg5 s 231(d) Certification of other reliable information`
`dg5 test certification` o p w t m b MEANS
    `dg5 s 231(d) Certification of other reliable information` WITH
          `the inspectors considered other reliable information for the limited purpose permitted` IS o
        , `the certification specifies the precise information considered` IS p
        , `the certification specifies the person or persons from whom the information was obtained` IS w
        , `the certification specifies when the information was obtained` IS t
        , `the certification specifies the means by which the information was obtained` IS m
        , `the certification specifies the basis for the inspectors' belief that the information is accurate and reliable` IS b

#ASSERT `s 231(d) the certification under paragraph (b)(5) specifies what it must` (`dg5 test certification` FALSE FALSE FALSE FALSE FALSE FALSE)
#ASSERT `s 231(d) the certification under paragraph (b)(5) specifies what it must` (`dg5 test certification` TRUE TRUE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`s 231(d) the certification under paragraph (b)(5) specifies what it must` (`dg5 test certification` TRUE FALSE TRUE TRUE TRUE TRUE))
#ASSERT NOT (`s 231(d) the certification under paragraph (b)(5) specifies what it must` (`dg5 test certification` TRUE TRUE FALSE TRUE TRUE TRUE))
#ASSERT NOT (`s 231(d) the certification under paragraph (b)(5) specifies what it must` (`dg5 test certification` TRUE TRUE TRUE FALSE TRUE TRUE))
#ASSERT NOT (`s 231(d) the certification under paragraph (b)(5) specifies what it must` (`dg5 test certification` TRUE TRUE TRUE TRUE FALSE TRUE))
#ASSERT NOT (`s 231(d) the certification under paragraph (b)(5) specifies what it must` (`dg5 test certification` TRUE TRUE TRUE TRUE TRUE FALSE))
