IMPORT prelude
IMPORT daydate
IMPORT `dg-core`
IMPORT `dg2-support`
IMPORT `dg2-board`

-- Tests of dg2-board.l4 (8 Del. C. section 141(a), (b) and (j)). Every expected value is written by hand from the text of
-- section 141 (src:363, 364, 375 of de-code-t8-ch1-2026-10-01.txt), beside the assertion, before the run; none is copied from output.

§ `Section 141(a): who manages`

-- src:363: the board manages unless this chapter or the certificate provides otherwise; a certificate provision decides who exercises
-- the powers the chapter confers on the board.
#ASSERT `s 141(a) who manages the business and affairs` FALSE FALSE EQUALS `the board of directors, by itself or through those it directs, under s 141(a)`
#ASSERT `s 141(a) who manages the business and affairs` TRUE FALSE EQUALS `the person or persons this chapter provides in place of the board, under s 141(a)`
#ASSERT `s 141(a) who manages the business and affairs` FALSE TRUE EQUALS `the person or persons the certificate of incorporation provides in place of the board, under s 141(a)`
-- Both at once: the second sentence (the certificate's provision governs the powers the chapter confers on the board) is applied first (Fork F-141-3).
#ASSERT `s 141(a) who manages the business and affairs` TRUE TRUE EQUALS `the person or persons the certificate of incorporation provides in place of the board, under s 141(a)`

§ `Section 141(b): members and qualifications`

-- src:364: "1 or more members". 0 is not a board; 1 is the boundary; 7 is plainly enough.
#ASSERT NOT `s 141(b) the board consists of one or more members` 0
#ASSERT `s 141(b) the board consists of one or more members` 1
#ASSERT `s 141(b) the board consists of one or more members` 7

-- src:364: "each of whom shall be a natural person".
#ASSERT `s 141(b) a person of this kind may be a member of the board` `a natural person`
#ASSERT NOT `s 141(b) a person of this kind may be a member of the board` `a limited liability company`
#ASSERT NOT `s 141(b) a person of this kind may be a member of the board` (`a corporation` `a stock corporation`)
#ASSERT NOT `s 141(b) a person of this kind may be a member of the board` `a general partnership`

-- src:364: bylaws fix the number, unless the certificate fixes it; then a change only by amendment of the certificate.
#ASSERT `s 141(b) how the number of directors is changed` FALSE EQUALS `in the manner provided in the bylaws`
#ASSERT `s 141(b) how the number of directors is changed` TRUE EQUALS `only by amendment of the certificate of incorporation`

-- src:364: directors need not be stockholders unless the certificate or the bylaws so require.
#ASSERT `s 141(b) a director must be a stockholder` `in the certificate of incorporation`
#ASSERT `s 141(b) a director must be a stockholder` `in the bylaws`
#ASSERT NOT `s 141(b) a director must be a stockholder` `in none of these`
-- A requirement made only in a board resolution is not one the text recognises: directors "need not be" stockholders.
#ASSERT NOT `s 141(b) a director must be a stockholder` `in a resolution of the board of directors`

-- src:364: the certificate or the bylaws may prescribe other qualifications.
#ASSERT `s 141(b) a qualification for directors prescribed there is one the Law allows` `in the certificate of incorporation`
#ASSERT `s 141(b) a qualification for directors prescribed there is one the Law allows` `in the bylaws`
#ASSERT NOT `s 141(b) a qualification for directors prescribed there is one the Law allows` `in a resolution of the board of directors`

§ `Section 141(b): holding office and resignation`

-- src:364: a director holds office until a successor is elected and qualified, or until earlier resignation or removal.
#ASSERT `s 141(b) the director still holds office` FALSE FALSE FALSE
#ASSERT NOT `s 141(b) the director still holds office` TRUE FALSE FALSE
#ASSERT NOT `s 141(b) the director still holds office` FALSE TRUE FALSE
#ASSERT NOT `s 141(b) the director still holds office` FALSE FALSE TRUE

-- src:364: notice "given in writing or by electronic transmission to the corporation".
#ASSERT `s 141(b) the notice of resignation is in a form the Law allows` TRUE TRUE FALSE
#ASSERT `s 141(b) the notice of resignation is in a form the Law allows` TRUE FALSE TRUE
#ASSERT `s 141(b) the notice of resignation is in a form the Law allows` TRUE TRUE TRUE
#ASSERT NOT `s 141(b) the notice of resignation is in a form the Law allows` TRUE FALSE FALSE
#ASSERT NOT `s 141(b) the notice of resignation is in a form the Law allows` FALSE TRUE TRUE

-- src:364: effective when delivered, unless the resignation specifies a later date, or a date determined by an event.
`a resignation delivered 1 March 2026 that names no later date` MEANS `s 141(b) Resignation` WITH
    `the date the notice of resignation is delivered to the corporation` IS YearMonthDay 2026 3 1
    `the later effective date the resignation specifies` IS NOTHING
    `the resignation specifies an effective date determined upon the happening of an event or events` IS FALSE
    `the date the event or events happen` IS NOTHING

`a resignation delivered 1 March 2026 that names 15 March 2026` MEANS `s 141(b) Resignation` WITH
    `the date the notice of resignation is delivered to the corporation` IS YearMonthDay 2026 3 1
    `the later effective date the resignation specifies` IS JUST (YearMonthDay 2026 3 15)
    `the resignation specifies an effective date determined upon the happening of an event or events` IS FALSE
    `the date the event or events happen` IS NOTHING

`a resignation delivered 1 March 2026 that names 1 February 2026` MEANS `s 141(b) Resignation` WITH
    `the date the notice of resignation is delivered to the corporation` IS YearMonthDay 2026 3 1
    `the later effective date the resignation specifies` IS JUST (YearMonthDay 2026 2 1)
    `the resignation specifies an effective date determined upon the happening of an event or events` IS FALSE
    `the date the event or events happen` IS NOTHING

`a resignation delivered 1 March 2026 that names a date on the same day` MEANS `s 141(b) Resignation` WITH
    `the date the notice of resignation is delivered to the corporation` IS YearMonthDay 2026 3 1
    `the later effective date the resignation specifies` IS JUST (YearMonthDay 2026 3 1)
    `the resignation specifies an effective date determined upon the happening of an event or events` IS FALSE
    `the date the event or events happen` IS NOTHING

`a resignation delivered 1 March 2026 that waits for an event on 1 April 2026` MEANS `s 141(b) Resignation` WITH
    `the date the notice of resignation is delivered to the corporation` IS YearMonthDay 2026 3 1
    `the later effective date the resignation specifies` IS NOTHING
    `the resignation specifies an effective date determined upon the happening of an event or events` IS TRUE
    `the date the event or events happen` IS JUST (YearMonthDay 2026 4 1)

`a resignation delivered 1 March 2026 that waits for an event that has not happened` MEANS `s 141(b) Resignation` WITH
    `the date the notice of resignation is delivered to the corporation` IS YearMonthDay 2026 3 1
    `the later effective date the resignation specifies` IS NOTHING
    `the resignation specifies an effective date determined upon the happening of an event or events` IS TRUE
    `the date the event or events happen` IS NOTHING

#ASSERT `s 141(b) the date the resignation is effective` `a resignation delivered 1 March 2026 that names no later date` EQUALS JUST (YearMonthDay 2026 3 1)
#ASSERT `s 141(b) the date the resignation is effective` `a resignation delivered 1 March 2026 that names 15 March 2026` EQUALS JUST (YearMonthDay 2026 3 15)
-- A date that is not later than delivery does not postpone the resignation: it is effective when delivered.
#ASSERT `s 141(b) the date the resignation is effective` `a resignation delivered 1 March 2026 that names 1 February 2026` EQUALS JUST (YearMonthDay 2026 3 1)
#ASSERT `s 141(b) the date the resignation is effective` `a resignation delivered 1 March 2026 that names a date on the same day` EQUALS JUST (YearMonthDay 2026 3 1)
#ASSERT `s 141(b) the date the resignation is effective` `a resignation delivered 1 March 2026 that waits for an event on 1 April 2026` EQUALS JUST (YearMonthDay 2026 4 1)
-- While the event has not happened the effective date is not yet determined.
#ASSERT `s 141(b) the date the resignation is effective` `a resignation delivered 1 March 2026 that waits for an event that has not happened` EQUALS NOTHING

-- src:364: only a resignation conditioned on failing to receive a specified vote for reelection may provide that it is irrevocable.
#ASSERT `s 141(b) the resignation may provide that it is irrevocable` TRUE EQUALS JUST TRUE
-- The text says nothing about any other resignation: not covered.
#ASSERT `s 141(b) the resignation may provide that it is irrevocable` FALSE EQUALS NOTHING

§ `Section 141(b): the quorum`

`a nine-seat board with no quorum provision` MEANS `s 141(b) Quorum provisions` WITH
    `the total number of directors` IS 9
    `the number of directors the certificate of incorporation or the bylaws fix as a quorum` IS NOTHING
    `where that number is fixed` IS `in none of these`
    `the certificate of incorporation provides that the bylaws may not fix a smaller quorum` IS FALSE

`an eight-seat board with no quorum provision` MEANS `s 141(b) Quorum provisions` WITH
    `the total number of directors` IS 8
    `the number of directors the certificate of incorporation or the bylaws fix as a quorum` IS NOTHING
    `where that number is fixed` IS `in none of these`
    `the certificate of incorporation provides that the bylaws may not fix a smaller quorum` IS FALSE

`a nine-seat board whose bylaws require 7` MEANS `s 141(b) Quorum provisions` WITH
    `the total number of directors` IS 9
    `the number of directors the certificate of incorporation or the bylaws fix as a quorum` IS JUST 7
    `where that number is fixed` IS `in the bylaws`
    `the certificate of incorporation provides that the bylaws may not fix a smaller quorum` IS FALSE

`a nine-seat board whose certificate requires 7` MEANS `s 141(b) Quorum provisions` WITH
    `the total number of directors` IS 9
    `the number of directors the certificate of incorporation or the bylaws fix as a quorum` IS JUST 7
    `where that number is fixed` IS `in the certificate of incorporation`
    `the certificate of incorporation provides that the bylaws may not fix a smaller quorum` IS FALSE

`a nine-seat board whose resolution requires 7` MEANS `s 141(b) Quorum provisions` WITH
    `the total number of directors` IS 9
    `the number of directors the certificate of incorporation or the bylaws fix as a quorum` IS JUST 7
    `where that number is fixed` IS `in a resolution of the board of directors`
    `the certificate of incorporation provides that the bylaws may not fix a smaller quorum` IS FALSE

`a nine-seat board whose bylaws require 10` MEANS `s 141(b) Quorum provisions` WITH
    `the total number of directors` IS 9
    `the number of directors the certificate of incorporation or the bylaws fix as a quorum` IS JUST 10
    `where that number is fixed` IS `in the bylaws`
    `the certificate of incorporation provides that the bylaws may not fix a smaller quorum` IS FALSE

`a nine-seat board whose bylaws fix a quorum of 3` MEANS `s 141(b) Quorum provisions` WITH
    `the total number of directors` IS 9
    `the number of directors the certificate of incorporation or the bylaws fix as a quorum` IS JUST 3
    `where that number is fixed` IS `in the bylaws`
    `the certificate of incorporation provides that the bylaws may not fix a smaller quorum` IS FALSE

`a nine-seat board whose bylaws fix a quorum of 2` MEANS `s 141(b) Quorum provisions` WITH
    `the total number of directors` IS 9
    `the number of directors the certificate of incorporation or the bylaws fix as a quorum` IS JUST 2
    `where that number is fixed` IS `in the bylaws`
    `the certificate of incorporation provides that the bylaws may not fix a smaller quorum` IS FALSE

`a nine-seat board whose bylaws fix a quorum of 3 but whose certificate forbids it` MEANS `s 141(b) Quorum provisions` WITH
    `the total number of directors` IS 9
    `the number of directors the certificate of incorporation or the bylaws fix as a quorum` IS JUST 3
    `where that number is fixed` IS `in the bylaws`
    `the certificate of incorporation provides that the bylaws may not fix a smaller quorum` IS TRUE

`a nine-seat board whose certificate itself fixes a quorum of 3` MEANS `s 141(b) Quorum provisions` WITH
    `the total number of directors` IS 9
    `the number of directors the certificate of incorporation or the bylaws fix as a quorum` IS JUST 3
    `where that number is fixed` IS `in the certificate of incorporation`
    `the certificate of incorporation provides that the bylaws may not fix a smaller quorum` IS FALSE

`an eight-seat board whose bylaws fix a quorum of 4` MEANS `s 141(b) Quorum provisions` WITH
    `the total number of directors` IS 8
    `the number of directors the certificate of incorporation or the bylaws fix as a quorum` IS JUST 4
    `where that number is fixed` IS `in the bylaws`
    `the certificate of incorporation provides that the bylaws may not fix a smaller quorum` IS FALSE

`a ten-seat board whose bylaws fix a quorum of 3` MEANS `s 141(b) Quorum provisions` WITH
    `the total number of directors` IS 10
    `the number of directors the certificate of incorporation or the bylaws fix as a quorum` IS JUST 3
    `where that number is fixed` IS `in the bylaws`
    `the certificate of incorporation provides that the bylaws may not fix a smaller quorum` IS FALSE

`a ten-seat board whose bylaws fix a quorum of 4` MEANS `s 141(b) Quorum provisions` WITH
    `the total number of directors` IS 10
    `the number of directors the certificate of incorporation or the bylaws fix as a quorum` IS JUST 4
    `where that number is fixed` IS `in the bylaws`
    `the certificate of incorporation provides that the bylaws may not fix a smaller quorum` IS FALSE

`a board of no seats` MEANS `s 141(b) Quorum provisions` WITH
    `the total number of directors` IS 0
    `the number of directors the certificate of incorporation or the bylaws fix as a quorum` IS NOTHING
    `where that number is fixed` IS `in none of these`
    `the certificate of incorporation provides that the bylaws may not fix a smaller quorum` IS FALSE

-- src:364: "A majority of the total number of directors shall constitute a quorum": of 9, a majority is 5; of 8, a majority is 5 (4 is half).
#ASSERT `s 141(b) a quorum of the directors is present` 5 `a nine-seat board with no quorum provision` EQUALS JUST TRUE
#ASSERT `s 141(b) a quorum of the directors is present` 4 `a nine-seat board with no quorum provision` EQUALS JUST FALSE
#ASSERT `s 141(b) a quorum of the directors is present` 9 `a nine-seat board with no quorum provision` EQUALS JUST TRUE
#ASSERT `s 141(b) a quorum of the directors is present` 5 `an eight-seat board with no quorum provision` EQUALS JUST TRUE
#ASSERT `s 141(b) a quorum of the directors is present` 4 `an eight-seat board with no quorum provision` EQUALS JUST FALSE
-- Counts that cannot be a vote (more present than seats, a negative count, a board of no seats): not covered.
#ASSERT `s 141(b) a quorum of the directors is present` 10 `a nine-seat board with no quorum provision` EQUALS NOTHING
#ASSERT `s 141(b) a quorum of the directors is present` 0 `a board of no seats` EQUALS NOTHING

-- src:364: "unless the certificate of incorporation or the bylaws require a greater number": 7 of 9 in the bylaws or in the certificate.
#ASSERT `s 141(b) a quorum of the directors is present` 7 `a nine-seat board whose bylaws require 7` EQUALS JUST TRUE
#ASSERT `s 141(b) a quorum of the directors is present` 6 `a nine-seat board whose bylaws require 7` EQUALS JUST FALSE
#ASSERT `s 141(b) a quorum of the directors is present` 7 `a nine-seat board whose certificate requires 7` EQUALS JUST TRUE
#ASSERT `s 141(b) a quorum of the directors is present` 6 `a nine-seat board whose certificate requires 7` EQUALS JUST FALSE
-- A number said to be fixed only in a board resolution is not one the text recognises: the majority of 5 stands.
#ASSERT `s 141(b) a quorum of the directors is present` 5 `a nine-seat board whose resolution requires 7` EQUALS JUST TRUE
-- A requirement above the total number of directors cannot be met: not covered.
#ASSERT `s 141(b) a quorum of the directors is present` 9 `a nine-seat board whose bylaws require 10` EQUALS NOTHING

-- src:364: bylaws may provide a number less than a majority, never less than 1/3 of the total, unless the certificate provides otherwise.
-- 1/3 of 9 is 3: 3 is the boundary and is allowed; 2 is below it.
#ASSERT `s 141(b) a quorum of the directors is present` 3 `a nine-seat board whose bylaws fix a quorum of 3` EQUALS JUST TRUE
#ASSERT `s 141(b) a quorum of the directors is present` 2 `a nine-seat board whose bylaws fix a quorum of 3` EQUALS JUST FALSE
#ASSERT `s 141(b) a quorum of the directors is present` 3 `a nine-seat board whose bylaws fix a quorum of 2` EQUALS NOTHING
-- The certificate provides otherwise: the bylaws' smaller number has no effect, so the majority of 5 stands.
#ASSERT `s 141(b) a quorum of the directors is present` 3 `a nine-seat board whose bylaws fix a quorum of 3 but whose certificate forbids it` EQUALS JUST FALSE
#ASSERT `s 141(b) a quorum of the directors is present` 5 `a nine-seat board whose bylaws fix a quorum of 3 but whose certificate forbids it` EQUALS JUST TRUE
-- The text lets only the bylaws fix the smaller number: a smaller number in the certificate is not covered.
#ASSERT `s 141(b) a quorum of the directors is present` 3 `a nine-seat board whose certificate itself fixes a quorum of 3` EQUALS NOTHING
-- Exactly half is not a majority, so 4 of 8 is a smaller number; 4 is above 1/3 of 8 (2 and 2/3).
#ASSERT `s 141(b) a quorum of the directors is present` 4 `an eight-seat board whose bylaws fix a quorum of 4` EQUALS JUST TRUE
#ASSERT `s 141(b) a quorum of the directors is present` 3 `an eight-seat board whose bylaws fix a quorum of 4` EQUALS JUST FALSE
-- 1/3 of 10 is 3 and 1/3: 3 is below it, 4 is above it.
#ASSERT `s 141(b) a quorum of the directors is present` 3 `a ten-seat board whose bylaws fix a quorum of 3` EQUALS NOTHING
#ASSERT `s 141(b) a quorum of the directors is present` 4 `a ten-seat board whose bylaws fix a quorum of 4` EQUALS JUST TRUE

§ `Section 141(b): the act of the board`

`a vote of 7 present, 4 in favor, on a nine-seat board` MEANS `s 141(b) Vote of the board` WITH
    `the number of directors present at the meeting` IS 7
    `the number of directors voting in favor` IS 4
    `where a vote of a greater number is required` IS `in none of these`
    `the greater number of directors required to vote in favor` IS 0

`a vote of 7 present, 3 in favor, on a nine-seat board` MEANS `s 141(b) Vote of the board` WITH
    `the number of directors present at the meeting` IS 7
    `the number of directors voting in favor` IS 3
    `where a vote of a greater number is required` IS `in none of these`
    `the greater number of directors required to vote in favor` IS 0

`a vote of 4 present, 4 in favor, on a nine-seat board` MEANS `s 141(b) Vote of the board` WITH
    `the number of directors present at the meeting` IS 4
    `the number of directors voting in favor` IS 4
    `where a vote of a greater number is required` IS `in none of these`
    `the greater number of directors required to vote in favor` IS 0

`a vote of 6 present, 3 in favor, on a nine-seat board` MEANS `s 141(b) Vote of the board` WITH
    `the number of directors present at the meeting` IS 6
    `the number of directors voting in favor` IS 3
    `where a vote of a greater number is required` IS `in none of these`
    `the greater number of directors required to vote in favor` IS 0

`a vote of 7 present, 4 in favor, where the bylaws require 5` MEANS `s 141(b) Vote of the board` WITH
    `the number of directors present at the meeting` IS 7
    `the number of directors voting in favor` IS 4
    `where a vote of a greater number is required` IS `in the bylaws`
    `the greater number of directors required to vote in favor` IS 5

`a vote of 7 present, 5 in favor, where the certificate requires 5` MEANS `s 141(b) Vote of the board` WITH
    `the number of directors present at the meeting` IS 7
    `the number of directors voting in favor` IS 5
    `where a vote of a greater number is required` IS `in the certificate of incorporation`
    `the greater number of directors required to vote in favor` IS 5

`a vote of 7 present, 4 in favor, where only a resolution requires 5` MEANS `s 141(b) Vote of the board` WITH
    `the number of directors present at the meeting` IS 7
    `the number of directors voting in favor` IS 4
    `where a vote of a greater number is required` IS `in a resolution of the board of directors`
    `the greater number of directors required to vote in favor` IS 5

-- src:364: the majority of the directors present, at a meeting at which a quorum is present. Of 7 present, 4 is a majority and 3 is not.
#ASSERT `s 141(b) the act of the board of directors is carried` `a nine-seat board with no quorum provision` `a vote of 7 present, 4 in favor, on a nine-seat board` EQUALS JUST TRUE
#ASSERT `s 141(b) the act of the board of directors is carried` `a nine-seat board with no quorum provision` `a vote of 7 present, 3 in favor, on a nine-seat board` EQUALS JUST FALSE
-- Of 6 present, 3 is exactly half: not a majority.
#ASSERT `s 141(b) the act of the board of directors is carried` `a nine-seat board with no quorum provision` `a vote of 6 present, 3 in favor, on a nine-seat board` EQUALS JUST FALSE
-- 4 present is below the quorum of 5, so even a unanimous 4 is no act of the board (Fork F-141-2).
#ASSERT `s 141(b) the act of the board of directors is carried` `a nine-seat board with no quorum provision` `a vote of 4 present, 4 in favor, on a nine-seat board` EQUALS JUST FALSE
-- A greater number of votes required in the bylaws or the certificate: 5 needed; 4 does not carry, 5 does.
#ASSERT `s 141(b) the act of the board of directors is carried` `a nine-seat board with no quorum provision` `a vote of 7 present, 4 in favor, where the bylaws require 5` EQUALS JUST FALSE
#ASSERT `s 141(b) the act of the board of directors is carried` `a nine-seat board with no quorum provision` `a vote of 7 present, 5 in favor, where the certificate requires 5` EQUALS JUST TRUE
-- A greater number named only in a board resolution is ignored: 4 of 7 carries.
#ASSERT `s 141(b) the act of the board of directors is carried` `a nine-seat board with no quorum provision` `a vote of 7 present, 4 in favor, where only a resolution requires 5` EQUALS JUST TRUE
-- Where the quorum is not covered (bylaws fix a quorum of 2 of 9), neither is the act.
#ASSERT `s 141(b) the act of the board of directors is carried` `a nine-seat board whose bylaws fix a quorum of 2` `a vote of 7 present, 4 in favor, on a nine-seat board` EQUALS NOTHING

§ `Section 141(j): the board of a nonstock corporation`

-- src:375: the certificate (not the bylaws) of a nonstock corporation may set a quorum below 1/3.
#ASSERT `s 141(j) a quorum of less than one third of the members of the governing body may be provided` `a nonprofit nonstock corporation that is not charitable` `in the certificate of incorporation`
#ASSERT `s 141(j) a quorum of less than one third of the members of the governing body may be provided` `a nonstock corporation with membership interests` `in the certificate of incorporation`
#ASSERT `s 141(j) a quorum of less than one third of the members of the governing body may be provided` `a charitable nonstock corporation` `in the certificate of incorporation`
#ASSERT NOT `s 141(j) a quorum of less than one third of the members of the governing body may be provided` `a nonprofit nonstock corporation that is not charitable` `in the bylaws`
#ASSERT NOT `s 141(j) a quorum of less than one third of the members of the governing body may be provided` `a stock corporation` `in the certificate of incorporation`
#ASSERT `s 141(j) the business and affairs may be managed in a different manner` `a nonstock corporation with membership interests` `in the certificate of incorporation`
#ASSERT NOT `s 141(j) the business and affairs may be managed in a different manner` `a stock corporation` `in the certificate of incorporation`
#ASSERT NOT `s 141(j) the business and affairs may be managed in a different manner` `a nonstock corporation with membership interests` `in the bylaws`

-- src:375: how a reference in section 141 is read for a nonstock corporation.
#ASSERT `s 141(j) how a reference in section 141 is read` `a reference in section 141 to the board of directors` `a nonprofit nonstock corporation that is not charitable` FALSE EQUALS JUST `the governing body of the corporation, under s 141(j)`
#ASSERT `s 141(j) how a reference in section 141 is read` `a reference in section 141 to a member of the board of directors` `a nonstock corporation with membership interests` FALSE EQUALS JUST `a member of the governing body of the corporation, under s 141(j)`
#ASSERT `s 141(j) how a reference in section 141 is read` `a reference in section 141 to stockholders` `a charitable nonstock corporation` FALSE EQUALS JUST `the members of the corporation, under s 141(j)`
-- "stock, capital stock, or shares" is read as memberships of a nonprofit nonstock corporation (the charitable kind is a nonprofit kind) and as membership interests of any other nonstock corporation.
#ASSERT `s 141(j) how a reference in section 141 is read` `a reference in section 141 to stock, capital stock, or shares thereof` `a nonprofit nonstock corporation that is not charitable` FALSE EQUALS JUST `memberships of a nonprofit nonstock corporation, under s 141(j)`
#ASSERT `s 141(j) how a reference in section 141 is read` `a reference in section 141 to stock, capital stock, or shares thereof` `a charitable nonstock corporation` FALSE EQUALS JUST `memberships of a nonprofit nonstock corporation, under s 141(j)`
#ASSERT `s 141(j) how a reference in section 141 is read` `a reference in section 141 to stock, capital stock, or shares thereof` `a nonstock corporation with membership interests` FALSE EQUALS JUST `membership interests of a nonstock corporation that is not a nonprofit nonstock corporation, under s 141(j)`
-- Not covered: a stock corporation (the sentence speaks of a nonstock corporation), and a certificate that provides otherwise.
#ASSERT `s 141(j) how a reference in section 141 is read` `a reference in section 141 to the board of directors` `a stock corporation` FALSE EQUALS NOTHING
#ASSERT `s 141(j) how a reference in section 141 is read` `a reference in section 141 to the board of directors` `a nonprofit nonstock corporation that is not charitable` TRUE EQUALS NOTHING
