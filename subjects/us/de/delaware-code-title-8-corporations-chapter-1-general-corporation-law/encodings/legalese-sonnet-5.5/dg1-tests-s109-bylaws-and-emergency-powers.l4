IMPORT prelude
IMPORT daydate
IMPORT `dg-core`
IMPORT `dg1-s111-s115-jurisdiction-and-forum`
IMPORT `dg1-s109-bylaws-and-emergency-powers`

-- Tests of sections 109, 110, 112 and 113 (dg1-s109-bylaws-and-emergency-powers.l4). Every expected value is
-- written by hand from the text (src:141-142, 146-157, 176-182, 186-191), beside the assertion, and was decided
-- before the module was run.

§ `Tests of sections 109, 110, 112 and 113`

§§ `s 109(a)`

-- facts, in order: kind; initial directors (or initial members) named; payment received for stock; certificate confers the power on the directors
-- a stock corporation that has received no payment: the incorporators, the initial directors if named, and the board
#ASSERT `s 109(a) the holder has the power to adopt, amend or repeal bylaws` `the incorporators as holders of the power to adopt, amend or repeal bylaws` `a stock corporation` FALSE FALSE FALSE
#ASSERT `s 109(a) the holder has the power to adopt, amend or repeal bylaws` `the initial directors of a corporation other than a nonstock corporation, if named in the certificate of incorporation` `a stock corporation` TRUE FALSE FALSE
#ASSERT NOT (`s 109(a) the holder has the power to adopt, amend or repeal bylaws` `the initial directors of a corporation other than a nonstock corporation, if named in the certificate of incorporation` `a stock corporation` FALSE FALSE FALSE)
#ASSERT `s 109(a) the holder has the power to adopt, amend or repeal bylaws` `the board of directors of a corporation other than a nonstock corporation, before the corporation has received any payment for any of its stock` `a stock corporation` FALSE FALSE FALSE
-- before payment the stockholders do not hold it
#ASSERT NOT (`s 109(a) the holder has the power to adopt, amend or repeal bylaws` `the stockholders entitled to vote, after a corporation other than a nonstock corporation has received any payment for any of its stock` `a stock corporation` FALSE FALSE FALSE)
-- after the corporation has received any payment for any of its stock the power is in the stockholders entitled to vote
#ASSERT `s 109(a) the holder has the power to adopt, amend or repeal bylaws` `the stockholders entitled to vote, after a corporation other than a nonstock corporation has received any payment for any of its stock` `a stock corporation` FALSE TRUE FALSE
#ASSERT NOT (`s 109(a) the holder has the power to adopt, amend or repeal bylaws` `the board of directors of a corporation other than a nonstock corporation, before the corporation has received any payment for any of its stock` `a stock corporation` FALSE TRUE FALSE)
#ASSERT NOT (`s 109(a) the holder has the power to adopt, amend or repeal bylaws` `the initial directors of a corporation other than a nonstock corporation, if named in the certificate of incorporation` `a stock corporation` TRUE TRUE FALSE)
#ASSERT NOT (`s 109(a) the holder has the power to adopt, amend or repeal bylaws` `the incorporators as holders of the power to adopt, amend or repeal bylaws` `a stock corporation` FALSE TRUE FALSE)
-- the certificate may confer the power on the directors, before or after payment, without divesting the stockholders
#ASSERT `s 109(a) the holder has the power to adopt, amend or repeal bylaws` `the directors or, in the case of a nonstock corporation, the governing body, on whom the certificate of incorporation confers the power` `a stock corporation` FALSE TRUE TRUE
#ASSERT NOT (`s 109(a) the holder has the power to adopt, amend or repeal bylaws` `the directors or, in the case of a nonstock corporation, the governing body, on whom the certificate of incorporation confers the power` `a stock corporation` FALSE TRUE FALSE)
#ASSERT `s 109(a) the holder has the power to adopt, amend or repeal bylaws` `the stockholders entitled to vote, after a corporation other than a nonstock corporation has received any payment for any of its stock` `a stock corporation` FALSE TRUE TRUE
#ASSERT NOT (`s 109(a) the conferral of the power on the directors or governing body divests the stockholders or members of the power` TRUE)
-- a nonstock corporation: its members entitled to vote, the incorporators, and any initial members of the governing body named
#ASSERT `s 109(a) the holder has the power to adopt, amend or repeal bylaws` `the members of a nonstock corporation entitled to vote` `a charitable nonstock corporation` FALSE FALSE FALSE
#ASSERT `s 109(a) the holder has the power to adopt, amend or repeal bylaws` `the initial members of the governing body of a nonstock corporation, if named in the certificate of incorporation` `a nonstock corporation with membership interests` TRUE FALSE FALSE
#ASSERT NOT (`s 109(a) the holder has the power to adopt, amend or repeal bylaws` `the initial members of the governing body of a nonstock corporation, if named in the certificate of incorporation` `a nonstock corporation with membership interests` FALSE FALSE FALSE)
#ASSERT `s 109(a) the holder has the power to adopt, amend or repeal bylaws` `the incorporators as holders of the power to adopt, amend or repeal bylaws` `a nonprofit nonstock corporation that is not charitable` FALSE FALSE FALSE
-- a stock corporation's members entitled to vote, and a nonstock corporation's board or stockholders, do not exist
#ASSERT NOT (`s 109(a) the holder has the power to adopt, amend or repeal bylaws` `the members of a nonstock corporation entitled to vote` `a stock corporation` FALSE FALSE FALSE)
#ASSERT NOT (`s 109(a) the holder has the power to adopt, amend or repeal bylaws` `the stockholders entitled to vote, after a corporation other than a nonstock corporation has received any payment for any of its stock` `a charitable nonstock corporation` FALSE TRUE FALSE)
#ASSERT NOT (`s 109(a) the holder has the power to adopt, amend or repeal bylaws` `the board of directors of a corporation other than a nonstock corporation, before the corporation has received any payment for any of its stock` `a charitable nonstock corporation` FALSE FALSE FALSE)

§§ `s 109(b)`

#ASSERT `s 109(b) the bylaws may contain the provision` TRUE FALSE
#ASSERT NOT (`s 109(b) the bylaws may contain the provision` TRUE TRUE)
#ASSERT NOT (`s 109(b) the bylaws may contain the provision` FALSE FALSE)
-- no liability of a stockholder for fees or expenses, in an internal corporate claim or in any claim a stockholder has brought
#ASSERT NOT (`s 109(b) the bylaws may contain the provision on fees and expenses` TRUE TRUE FALSE FALSE)
#ASSERT NOT (`s 109(b) the bylaws may contain the provision on fees and expenses` TRUE FALSE TRUE FALSE)
#ASSERT NOT (`s 109(b) the bylaws may contain the provision on fees and expenses` TRUE FALSE FALSE TRUE)
#ASSERT `s 109(b) the bylaws may contain the provision on fees and expenses` TRUE FALSE FALSE FALSE
#ASSERT `s 109(b) the bylaws may contain the provision on fees and expenses` FALSE TRUE TRUE TRUE

§§ `s 110(a) emergency bylaws`

#ASSERT `s 110(a) the emergency bylaws are operative` `an attack on the United States or on a locality in which the corporation conducts its business or customarily holds meetings of its board of directors or its stockholders` TRUE FALSE
#ASSERT `s 110(a) the emergency bylaws are operative` `a nuclear or atomic disaster` TRUE FALSE
#ASSERT `s 110(a) the emergency bylaws are operative` `the existence of a catastrophe, including, but not limited to, an epidemic or pandemic, and a declaration of a national emergency by the United States government` TRUE FALSE
#ASSERT `s 110(a) the emergency bylaws are operative` `another similar emergency condition` TRUE FALSE
-- no emergency, none adopted, or the emergency has terminated
#ASSERT NOT (`s 110(a) the emergency bylaws are operative` `no emergency` TRUE FALSE)
#ASSERT NOT (`s 110(a) the emergency bylaws are operative` `a nuclear or atomic disaster` FALSE FALSE)
#ASSERT NOT (`s 110(a) the emergency bylaws are operative` `a nuclear or atomic disaster` TRUE TRUE)
#ASSERT `s 110(e) the bylaw of the corporation remains in effect during the emergency` FALSE
#ASSERT NOT (`s 110(e) the bylaw of the corporation remains in effect during the emergency` TRUE)
-- adoption: by the board; or, if a quorum cannot be readily convened, by a majority of the directors present
#ASSERT `s 110(a) the emergency bylaws were validly adopted` TRUE TRUE 0 0 EQUALS JUST TRUE
#ASSERT `s 110(a) the emergency bylaws were validly adopted` TRUE FALSE 3 3 EQUALS JUST FALSE
#ASSERT `s 110(a) the emergency bylaws were validly adopted` FALSE FALSE 2 3 EQUALS JUST TRUE
#ASSERT `s 110(a) the emergency bylaws were validly adopted` FALSE FALSE 1 2 EQUALS JUST FALSE
#ASSERT `s 110(a) the emergency bylaws were validly adopted` FALSE TRUE 1 2 EQUALS JUST TRUE
#ASSERT `s 110(a) the emergency bylaws were validly adopted` FALSE FALSE 1 1 EQUALS JUST TRUE
#ASSERT `s 110(a) the emergency bylaws were validly adopted` FALSE FALSE 0 0 EQUALS NOTHING
#ASSERT `s 110(a) the emergency bylaws were validly adopted` FALSE FALSE 4 3 EQUALS NOTHING
#ASSERT `s 110(a) the emergency bylaws are subject to repeal or change by action of the stockholders` TRUE
#ASSERT NOT (`s 110(a) the emergency bylaws are subject to repeal or change by action of the stockholders` FALSE)
#ASSERT `s 110(a) the emergency bylaws may make the provision` TRUE
#ASSERT NOT (`s 110(a) the emergency bylaws may make the provision` FALSE)
#ASSERT `s 110(a)(1) the person may call a meeting of the board of directors or a committee` TRUE TRUE
#ASSERT NOT (`s 110(a)(1) the person may call a meeting of the board of directors or a committee` FALSE TRUE)
#ASSERT NOT (`s 110(a)(1) the person may call a meeting of the board of directors or a committee` TRUE FALSE)
-- the directors in attendance, or any greater number the emergency bylaws fix, are a quorum
#ASSERT `s 110(a)(2) the directors in attendance constitute a quorum` 1 NOTHING
#ASSERT NOT (`s 110(a)(2) the directors in attendance constitute a quorum` 0 NOTHING)
#ASSERT `s 110(a)(2) the directors in attendance constitute a quorum` 3 (JUST 3)
#ASSERT NOT (`s 110(a)(2) the directors in attendance constitute a quorum` 2 (JUST 3))
-- deemed directors
#ASSERT `s 110(a)(3) the person is deemed a director for the meeting` TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 110(a)(3) the person is deemed a director for the meeting` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`s 110(a)(3) the person is deemed a director for the meeting` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 110(a)(3) the person is deemed a director for the meeting` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 110(a)(3) the person is deemed a director for the meeting` TRUE TRUE TRUE FALSE)

§§ `s 110(b) to (h)`

#ASSERT `s 110(b) the board of directors may provide, and from time to time modify, lines of succession` `before the emergency` EQUALS JUST TRUE
#ASSERT `s 110(b) the board of directors may provide, and from time to time modify, lines of succession` `during the emergency` EQUALS JUST TRUE
#ASSERT `s 110(b) the board of directors may provide, and from time to time modify, lines of succession` `after the emergency` EQUALS NOTHING
#ASSERT `s 110(c) the board of directors may, effective in the emergency, change the head office or designate alternative head offices or regional offices, or authorize the officers to do so` `before the emergency` EQUALS JUST TRUE
#ASSERT `s 110(c) the board of directors may, effective in the emergency, change the head office or designate alternative head offices or regional offices, or authorize the officers to do so` `after the emergency` EQUALS NOTHING
-- no liability except for wilful misconduct
#ASSERT `s 110(d) the person is protected from liability` `an officer` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 110(d) the person is protected from liability` `a director` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 110(d) the person is protected from liability` `an employee` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 110(d) the person is protected from liability` `a director` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 110(d) the person is protected from liability` `a director` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 110(d) the person is protected from liability` `a stockholder` TRUE FALSE EQUALS NOTHING
-- notice during an emergency
#ASSERT `s 110(f) the notice of the meeting of the board of directors is sufficient` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 110(f) the notice of the meeting of the board of directors is sufficient` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 110(f) the notice of the meeting of the board of directors is sufficient` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 110(f) the notice of the meeting of the board of directors is sufficient` TRUE TRUE TRUE EQUALS NOTHING
-- officers deemed directors, in order of rank and seniority, to the extent required for a quorum
#ASSERT `s 110(g) the officer present is deemed a director for the meeting` FALSE 1 2
#ASSERT `s 110(g) the officer present is deemed a director for the meeting` FALSE 2 2
#ASSERT NOT (`s 110(g) the officer present is deemed a director for the meeting` FALSE 3 2)
#ASSERT NOT (`s 110(g) the officer present is deemed a director for the meeting` FALSE 0 2)
#ASSERT NOT (`s 110(g) the officer present is deemed a director for the meeting` TRUE 1 2)
#ASSERT NOT (`s 110(g) the officer present is deemed a director for the meeting` FALSE 1 0)
#ASSERT `s 110(h) the provision for emergency powers is permitted in addition to this section` TRUE
#ASSERT NOT (`s 110(h) the provision for emergency powers is permitted in addition to this section` FALSE)

§§ `s 110(i)`

#ASSERT `s 110(i) the action with respect to the meeting of stockholders is authorized` `a nuclear or atomic disaster` TRUE TRUE FALSE
#ASSERT NOT (`s 110(i) the action with respect to the meeting of stockholders is authorized` `a nuclear or atomic disaster` TRUE FALSE TRUE)
#ASSERT `s 110(i) the action with respect to the meeting of stockholders is authorized` `a nuclear or atomic disaster` FALSE FALSE TRUE
#ASSERT NOT (`s 110(i) the action with respect to the meeting of stockholders is authorized` `a nuclear or atomic disaster` FALSE FALSE FALSE)
-- no quorum, the board acted and a majority of those present did not: the text does not settle it (Fork register, F32); the reading taken counts the board's action
#ASSERT `s 110(i) the action with respect to the meeting of stockholders is authorized` `a nuclear or atomic disaster` FALSE TRUE FALSE
#ASSERT NOT (`s 110(i) the action with respect to the meeting of stockholders is authorized` `no emergency` TRUE TRUE TRUE)
#ASSERT `s 110(i)(i)(1) the record date that applies to the postponed meeting` (YMD 2026 3 1) EQUALS YMD 2026 3 1
#ASSERT `s 110(i)(i)(2) the corporation may give the notice solely by a document publicly filed with the Securities and Exchange Commission` TRUE
#ASSERT NOT (`s 110(i)(i)(2) the corporation may give the notice solely by a document publicly filed with the Securities and Exchange Commission` FALSE)
-- dividend: both dates moved later; the payment date not more than 60 days after the record date as changed (record date 1 May 2026: 60 days is 30 June 2026)
#ASSERT `s 110(i)(ii) the board of directors may change the record date and the payment date of the declared dividend as it has` TRUE (YMD 2026 4 1) (YMD 2026 4 15) (YMD 2026 5 1) (YMD 2026 6 30)
#ASSERT NOT (`s 110(i)(ii) the board of directors may change the record date and the payment date of the declared dividend as it has` TRUE (YMD 2026 4 1) (YMD 2026 4 15) (YMD 2026 5 1) (YMD 2026 7 1))
#ASSERT NOT (`s 110(i)(ii) the board of directors may change the record date and the payment date of the declared dividend as it has` FALSE (YMD 2026 4 1) (YMD 2026 4 15) (YMD 2026 5 1) (YMD 2026 5 2))
#ASSERT NOT (`s 110(i)(ii) the board of directors may change the record date and the payment date of the declared dividend as it has` TRUE (YMD 2026 4 1) (YMD 2026 4 15) (YMD 2026 4 1) (YMD 2026 5 2))
#ASSERT NOT (`s 110(i)(ii) the board of directors may change the record date and the payment date of the declared dividend as it has` TRUE (YMD 2026 4 1) (YMD 2026 4 15) (YMD 2026 5 1) (YMD 2026 4 15))
-- notice as promptly as practicable, and in any event before the record date theretofore in effect
#ASSERT `s 110(i) the corporation has given notice of the change in time` (YMD 2026 3 31) (YMD 2026 4 1) TRUE
#ASSERT NOT (`s 110(i) the corporation has given notice of the change in time` (YMD 2026 4 1) (YMD 2026 4 1) TRUE)
#ASSERT NOT (`s 110(i) the corporation has given notice of the change in time` (YMD 2026 3 31) (YMD 2026 4 1) FALSE)
#ASSERT `s 110(i) the failure to make a stocklist available is excused` `a nuclear or atomic disaster` TRUE
#ASSERT NOT (`s 110(i) the failure to make a stocklist available is excused` `a nuclear or atomic disaster` FALSE)
#ASSERT NOT (`s 110(i) the failure to make a stocklist available is excused` `no emergency` TRUE)

§§ `s 112 and s 113`

#ASSERT `s 112 the corporation may be required to include the stockholder's nominee in its proxy solicitation materials` TRUE TRUE TRUE
#ASSERT NOT (`s 112 the corporation may be required to include the stockholder's nominee in its proxy solicitation materials` FALSE TRUE TRUE)
#ASSERT NOT (`s 112 the corporation may be required to include the stockholder's nominee in its proxy solicitation materials` TRUE FALSE TRUE)
#ASSERT NOT (`s 112 the corporation may be required to include the stockholder's nominee in its proxy solicitation materials` TRUE TRUE FALSE)
-- the five conditions the text lists are permitted; any other condition only if lawful
#ASSERT `s 112 the bylaws may impose the condition` `a minimum record or beneficial ownership, or duration of ownership, of shares of the corporation's capital stock by the nominating stockholder` FALSE
#ASSERT `s 112 the bylaws may impose the condition` `submission of specified information concerning the stockholder and the stockholder's nominees` FALSE
#ASSERT `s 112 the bylaws may impose the condition` `eligibility conditioned upon the number or proportion of directors nominated by stockholders or whether the stockholder previously sought to require such inclusion` FALSE
#ASSERT `s 112 the bylaws may impose the condition` `preclusion of nominations by a person, a nominee or an affiliate or associate who has acquired or publicly proposed to acquire a specified percentage of the voting power within a specified period before the election` FALSE
#ASSERT `s 112 the bylaws may impose the condition` `the nominating stockholder's undertaking to indemnify the corporation in respect of any loss arising from false or misleading information` FALSE
#ASSERT `s 112 the bylaws may impose the condition` `any other condition` TRUE
#ASSERT NOT (`s 112 the bylaws may impose the condition` `any other condition` FALSE)
#ASSERT `s 113(a) the corporation may be required to reimburse the stockholder's expenses` TRUE TRUE TRUE
#ASSERT NOT (`s 113(a) the corporation may be required to reimburse the stockholder's expenses` FALSE TRUE TRUE)
#ASSERT NOT (`s 113(a) the corporation may be required to reimburse the stockholder's expenses` TRUE FALSE TRUE)
#ASSERT NOT (`s 113(a) the corporation may be required to reimburse the stockholder's expenses` TRUE TRUE FALSE)
#ASSERT `s 113(a) the bylaws may prescribe the condition` `eligibility conditioned upon the number or proportion of persons nominated by the stockholder seeking reimbursement, or whether the stockholder previously sought reimbursement for similar expenses` FALSE
#ASSERT `s 113(a) the bylaws may prescribe the condition` `a limitation on the amount of reimbursement based upon the proportion of votes cast in favor of 1 or more of the persons nominated by the stockholder, or upon the amount spent by the corporation in soliciting proxies in connection with the election` FALSE
#ASSERT `s 113(a) the bylaws may prescribe the condition` `a limitation concerning elections of directors by cumulative voting pursuant to § 214` FALSE
#ASSERT `s 113(a) the bylaws may prescribe the condition` `any other condition` TRUE
#ASSERT NOT (`s 113(a) the bylaws may prescribe the condition` `any other condition` FALSE)
-- no bylaw so adopted applies to an election for which any record date precedes its adoption
#ASSERT `s 113(b) the bylaw applies to the election` (YMD 2026 6 1) (YMD 2026 5 31)
#ASSERT `s 113(b) the bylaw applies to the election` (YMD 2026 6 1) (YMD 2026 6 1)
#ASSERT NOT (`s 113(b) the bylaw applies to the election` (YMD 2026 6 1) (YMD 2026 6 2))
