IMPORT prelude
IMPORT `dg-core`
IMPORT `dg1-s111-s115-jurisdiction-and-forum`

-- Tests of sections 111 and 115 (dg1-s111-s115-jurisdiction-and-forum.l4). Every expected value is written by
-- hand from the text (src:161-172, 216-218), beside the assertion, and was decided before the module was run.

§ `Tests of sections 111 and 115`

§§ `s 111 cases`

-- subsection (a): each of the nine listed subjects may be brought in the Court of Chancery ...
#ASSERT `s 111(a) the civil action may be brought in the Court of Chancery` `the certificate of incorporation or the bylaws of a corporation` FALSE EQUALS JUST TRUE
#ASSERT `s 111(a) the civil action may be brought in the Court of Chancery` `an instrument, document or agreement by which a corporation creates or sells, or offers to create or sell, any of its stock, or any rights or options respecting its stock` FALSE EQUALS JUST TRUE
#ASSERT `s 111(a) the civil action may be brought in the Court of Chancery` `an instrument, document or agreement to which a corporation and 1 or more holders of its stock are parties, and pursuant to which any such holder sells or offers to sell any of such stock` FALSE EQUALS JUST TRUE
#ASSERT `s 111(a) the civil action may be brought in the Court of Chancery` `an instrument, document or agreement by which a corporation agrees to sell, lease or exchange any of its property or assets, and which by its terms provides that 1 or more holders of its stock approve of or consent to the sale, lease or exchange` FALSE EQUALS JUST TRUE
#ASSERT `s 111(a) the civil action may be brought in the Court of Chancery` `written restrictions on the transfer, registration of transfer or ownership of securities under § 202` FALSE EQUALS JUST TRUE
#ASSERT `s 111(a) the civil action may be brought in the Court of Chancery` `a proxy under § 212 or § 215` FALSE EQUALS JUST TRUE
#ASSERT `s 111(a) the civil action may be brought in the Court of Chancery` `a voting trust or other voting agreement under § 218` FALSE EQUALS JUST TRUE
#ASSERT `s 111(a) the civil action may be brought in the Court of Chancery` `an agreement, certificate of merger or consolidation, or certificate of ownership and merger governed by §§ 251-253, §§ 255-258, §§ 263-264, or § 267` FALSE EQUALS JUST TRUE
#ASSERT `s 111(a) the civil action may be brought in the Court of Chancery` `a certificate of conversion under § 265 or § 266` FALSE EQUALS JUST TRUE
#ASSERT `s 111(a) the civil action may be brought in the Court of Chancery` `a certificate of domestication, transfer or continuance under § 388, § 389 or § 390` FALSE EQUALS JUST TRUE
#ASSERT `s 111(a) the civil action may be brought in the Court of Chancery` `any other instrument, document, agreement or certificate required by any provision of this title` FALSE EQUALS JUST TRUE
-- ... except to the extent that a statute confers exclusive jurisdiction on another court, agency or tribunal
#ASSERT `s 111(a) the civil action may be brought in the Court of Chancery` `the certificate of incorporation or the bylaws of a corporation` TRUE EQUALS JUST FALSE
#ASSERT `s 111(a) the civil action may be brought in the Court of Chancery` `a proxy under § 212 or § 215` TRUE EQUALS JUST FALSE
-- a matter that is none of the listed subjects: subsection (a) does not speak
#ASSERT `s 111(a) the civil action may be brought in the Court of Chancery` `a matter that is none of those` FALSE EQUALS NOTHING
-- subsection (b)
#ASSERT `s 111(b) the civil action may be brought in the Court of Chancery` TRUE EQUALS JUST TRUE
#ASSERT `s 111(b) the civil action may be brought in the Court of Chancery` FALSE EQUALS NOTHING

§§ `s 115 cases`

-- (b)(i): based on a violation of a duty by a current or former director, officer or stockholder in such capacity
#ASSERT `s 115(b) the claim is an internal corporate claim` TRUE FALSE
-- (b)(ii): as to which the title confers jurisdiction on the Court of Chancery
#ASSERT `s 115(b) the claim is an internal corporate claim` FALSE TRUE
#ASSERT NOT (`s 115(b) the claim is an internal corporate claim` FALSE FALSE)
-- section 111 says so: the title confers jurisdiction on this reading
#ASSERT `s 115(b)(ii) this title confers jurisdiction upon the Court of Chancery as to the claim` (JUST TRUE) FALSE
#ASSERT NOT (`s 115(b)(ii) this title confers jurisdiction upon the Court of Chancery as to the claim` (JUST FALSE) FALSE)
#ASSERT `s 115(b)(ii) this title confers jurisdiction upon the Court of Chancery as to the claim` (JUST FALSE) TRUE
#ASSERT NOT (`s 115(b)(ii) this title confers jurisdiction upon the Court of Chancery as to the claim` NOTHING FALSE)
#ASSERT `s 115(b)(ii) this title confers jurisdiction upon the Court of Chancery as to the claim` NOTHING TRUE
-- (a): a provision requiring the State courts, consistent with jurisdictional requirements, is permitted ...
#ASSERT `s 115(a) the provision of the certificate of incorporation or the bylaws is permitted` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 115(a) the provision of the certificate of incorporation or the bylaws is permitted` TRUE FALSE FALSE EQUALS JUST FALSE
-- ... and no provision may prohibit bringing the claims in the courts of this State
#ASSERT `s 115(a) the provision of the certificate of incorporation or the bylaws is permitted` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 115(a) the provision of the certificate of incorporation or the bylaws is permitted` TRUE TRUE TRUE EQUALS JUST FALSE
-- a provision that neither requires nor prohibits: not addressed
#ASSERT `s 115(a) the provision of the certificate of incorporation or the bylaws is permitted` FALSE FALSE TRUE EQUALS NOTHING
-- (c): not internal; acting as stockholder; relates to the business etc.; consistent; at least one court in this State
#ASSERT `s 115(c) the certificate or the bylaws may require the stockholder to bring the claim only in the prescribed forums` FALSE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 115(c) the certificate or the bylaws may require the stockholder to bring the claim only in the prescribed forums` FALSE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 115(c) the certificate or the bylaws may require the stockholder to bring the claim only in the prescribed forums` FALSE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 115(c) the certificate or the bylaws may require the stockholder to bring the claim only in the prescribed forums` FALSE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 115(c) the certificate or the bylaws may require the stockholder to bring the claim only in the prescribed forums` FALSE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- an internal corporate claim is governed by subsection (a), not (c)
#ASSERT `s 115(c) the certificate or the bylaws may require the stockholder to bring the claim only in the prescribed forums` TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING
