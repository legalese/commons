IMPORT prelude
IMPORT daydate
IMPORT `dg-core`
IMPORT `dg1-s102a-required-contents`

-- Tests of section 102(a) (dg1-s102a-required-contents.l4). Every expected value is written by hand from the text
-- of section 102(a) (src:41-47), beside the assertion, and was decided before the module was run.
-- Records are built with positional OF in the order of their DECLARE; each builder names the order.

§ `Tests of section 102(a)`

§§ `s 102(a)(1) the name`

-- order: listed word; word of like import; certificate of total assets filed; total assets stated; Division finds the name appears to be a natural person's; association of professionals; the Division waives
GIVEN word IS A BOOLEAN
      import IS A BOOLEAN
      filed IS A BOOLEAN
      assets IS A NUMBER
      natural IS A BOOLEAN
      professionals IS A BOOLEAN
      waives IS A BOOLEAN
GIVETH A `s 102(a)(1)(i) Name words`
`t102a words` word import filed assets natural professionals waives MEANS `s 102(a)(1)(i) Name words` OF word, import, filed, assets, natural, professionals, waives

#ASSERT count (`s 102(a)(1)(i) the words one of which the name must contain`) EQUALS 12
#ASSERT elem "limited" (`s 102(a)(1)(i) the words one of which the name must contain`)
#ASSERT elem "syndicate" (`s 102(a)(1)(i) the words one of which the name must contain`)
#ASSERT NOT (elem "trust" (`s 102(a)(1)(i) the words one of which the name must contain`))

-- a listed word, or a word of like import, satisfies limb (i)
#ASSERT `s 102(a)(1)(i) the name satisfies the requirement as to words` (`t102a words` TRUE FALSE FALSE 0 FALSE FALSE FALSE) `a stock corporation`
#ASSERT `s 102(a)(1)(i) the name satisfies the requirement as to words` (`t102a words` FALSE TRUE FALSE 0 FALSE FALSE FALSE) `a stock corporation`
#ASSERT NOT (`s 102(a)(1)(i) the name satisfies the requirement as to words` (`t102a words` FALSE FALSE FALSE 0 FALSE FALSE FALSE) `a stock corporation`)
-- waiver on the strength of a certificate of total assets of not less than $10,000,000: the boundary
#ASSERT `s 102(a)(1)(i) the name satisfies the requirement as to words` (`t102a words` FALSE FALSE TRUE 10_000_000 FALSE FALSE TRUE) `a stock corporation`
#ASSERT `s 102(a)(1)(i) the name satisfies the requirement as to words` (`t102a words` FALSE FALSE TRUE 25_000_000 FALSE FALSE TRUE) `a stock corporation`
#ASSERT NOT (`s 102(a)(1)(i) the name satisfies the requirement as to words` (`t102a words` FALSE FALSE TRUE 9_999_999 FALSE FALSE TRUE) `a stock corporation`)
-- the Division has not waived: no waiver
#ASSERT NOT (`s 102(a)(1)(i) the name satisfies the requirement as to words` (`t102a words` FALSE FALSE TRUE 10_000_000 FALSE FALSE FALSE) `a stock corporation`)
-- the certificate was not executed, acknowledged and filed
#ASSERT NOT (`s 102(a)(1)(i) the name satisfies the requirement as to words` (`t102a words` FALSE FALSE FALSE 10_000_000 FALSE FALSE TRUE) `a stock corporation`)
-- unless the Division determines that the name appears to be that of a natural person
#ASSERT NOT (`s 102(a)(1)(i) the name satisfies the requirement as to words` (`t102a words` FALSE FALSE TRUE 10_000_000 TRUE FALSE TRUE) `a stock corporation`)
-- a nonprofit nonstock corporation that is an association of professionals, in the Division's sole discretion
#ASSERT `s 102(a)(1)(i) the name satisfies the requirement as to words` (`t102a words` FALSE FALSE FALSE 0 FALSE TRUE TRUE) `a nonprofit nonstock corporation that is not charitable`
#ASSERT `s 102(a)(1)(i) the name satisfies the requirement as to words` (`t102a words` FALSE FALSE FALSE 0 FALSE TRUE TRUE) `a charitable nonstock corporation`
-- the same association of professionals that is a stock corporation or a nonstock corporation with membership interests: no
#ASSERT NOT (`s 102(a)(1)(i) the name satisfies the requirement as to words` (`t102a words` FALSE FALSE FALSE 0 FALSE TRUE TRUE) `a stock corporation`)
#ASSERT NOT (`s 102(a)(1)(i) the name satisfies the requirement as to words` (`t102a words` FALSE FALSE FALSE 0 FALSE TRUE TRUE) `a nonstock corporation with membership interests`)
#ASSERT NOT (`s 102(a)(1)(i) the name satisfies the requirement as to words` (`t102a words` FALSE FALSE FALSE 0 FALSE TRUE FALSE) `a charitable nonstock corporation`)
#ASSERT NOT (`s 102(a)(1)(i) the name satisfies the requirement as to words` (`t102a words` FALSE FALSE FALSE 0 TRUE TRUE TRUE) `a charitable nonstock corporation`)

-- order: distinguishable on the records; written consent filed; the Division waives; substantial use; reasonable efforts; waiver in the interest of the State
GIVEN a IS A BOOLEAN
      b IS A BOOLEAN
      c IS A BOOLEAN
      d IS A BOOLEAN
      e IS A BOOLEAN
      f IS A BOOLEAN
GIVETH A `s 102(a)(1)(ii) Name distinct`
`t102a distinct` a b c d e f MEANS `s 102(a)(1)(ii) Name distinct` OF a, b, c, d, e, f

#ASSERT `s 102(a)(1)(ii) the name satisfies the requirement as to distinction on the records` (`t102a distinct` TRUE FALSE FALSE FALSE FALSE FALSE)
#ASSERT `s 102(a)(1)(ii) the name satisfies the requirement as to distinction on the records` (`t102a distinct` FALSE TRUE FALSE FALSE FALSE FALSE)
#ASSERT `s 102(a)(1)(ii) the name satisfies the requirement as to distinction on the records` (`t102a distinct` FALSE FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`s 102(a)(1)(ii) the name satisfies the requirement as to distinction on the records` (`t102a distinct` FALSE FALSE FALSE FALSE FALSE FALSE))
-- the waiver needs all three showings
#ASSERT NOT (`s 102(a)(1)(ii) the name satisfies the requirement as to distinction on the records` (`t102a distinct` FALSE FALSE TRUE FALSE TRUE TRUE))
#ASSERT NOT (`s 102(a)(1)(ii) the name satisfies the requirement as to distinction on the records` (`t102a distinct` FALSE FALSE TRUE TRUE FALSE TRUE))
#ASSERT NOT (`s 102(a)(1)(ii) the name satisfies the requirement as to distinction on the records` (`t102a distinct` FALSE FALSE TRUE TRUE TRUE FALSE))
#ASSERT NOT (`s 102(a)(1)(ii) the name satisfies the requirement as to distinction on the records` (`t102a distinct` FALSE FALSE FALSE TRUE TRUE TRUE))

#ASSERT `s 102(a)(1)(iii) the name satisfies the requirement as to the word trust` FALSE FALSE
#ASSERT `s 102(a)(1)(iii) the name satisfies the requirement as to the word trust` TRUE TRUE
#ASSERT NOT (`s 102(a)(1)(iii) the name satisfies the requirement as to the word trust` TRUE FALSE)

-- order: contains bank; bank under the State Bank Commissioner; subsidiary of a bank or savings association; regulated under the Bank Holding Company Act or Home Owners' Loan Act; context clearly not banking; not otherwise misleading
GIVEN a IS A BOOLEAN
      b IS A BOOLEAN
      c IS A BOOLEAN
      d IS A BOOLEAN
      e IS A BOOLEAN
      f IS A BOOLEAN
GIVETH A `s 102(a)(1)(iv) Name bank`
`t102a bank` a b c d e f MEANS `s 102(a)(1)(iv) Name bank` OF a, b, c, d, e, f

#ASSERT `s 102(a)(1)(iv) the name satisfies the requirement as to the word bank` (`t102a bank` FALSE FALSE FALSE FALSE FALSE FALSE)
#ASSERT `s 102(a)(1)(iv) the name satisfies the requirement as to the word bank` (`t102a bank` TRUE TRUE FALSE FALSE FALSE FALSE)
#ASSERT `s 102(a)(1)(iv) the name satisfies the requirement as to the word bank` (`t102a bank` TRUE FALSE TRUE FALSE FALSE FALSE)
#ASSERT `s 102(a)(1)(iv) the name satisfies the requirement as to the word bank` (`t102a bank` TRUE FALSE FALSE TRUE FALSE FALSE)
#ASSERT NOT (`s 102(a)(1)(iv) the name satisfies the requirement as to the word bank` (`t102a bank` TRUE FALSE FALSE FALSE FALSE FALSE))
-- the context proviso, as the Division determines it (read as both conditions together)
#ASSERT `s 102(a)(1)(iv) the name satisfies the requirement as to the word bank` (`t102a bank` TRUE FALSE FALSE FALSE TRUE TRUE)
#ASSERT NOT (`s 102(a)(1)(iv) the name satisfies the requirement as to the word bank` (`t102a bank` TRUE FALSE FALSE FALSE TRUE FALSE))
#ASSERT NOT (`s 102(a)(1)(iv) the name satisfies the requirement as to the word bank` (`t102a bank` TRUE FALSE FALSE FALSE FALSE TRUE))

-- all four limbs together
#ASSERT `s 102(a)(1) the name of the corporation complies` TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 102(a)(1) the name of the corporation complies` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`s 102(a)(1) the name of the corporation complies` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 102(a)(1) the name of the corporation complies` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 102(a)(1) the name of the corporation complies` TRUE TRUE TRUE FALSE)

§§ `s 102(a)(2) and (3)`

#ASSERT `s 102(a)(2) the certificate sets forth the registered office and registered agent` (`s 102(a)(2) Registered office and agent stated` OF TRUE, TRUE, TRUE)
-- the address must be stated in accordance with section 131(c)
#ASSERT NOT (`s 102(a)(2) the certificate sets forth the registered office and registered agent` (`s 102(a)(2) Registered office and agent stated` OF TRUE, FALSE, TRUE))
#ASSERT NOT (`s 102(a)(2) the certificate sets forth the registered office and registered agent` (`s 102(a)(2) Registered office and agent stated` OF FALSE, TRUE, TRUE))
#ASSERT NOT (`s 102(a)(2) the certificate sets forth the registered office and registered agent` (`s 102(a)(2) Registered office and agent stated` OF TRUE, TRUE, FALSE))

#ASSERT `s 102(a)(3) the certificate sets forth the nature of the business or purposes` TRUE FALSE
#ASSERT `s 102(a)(3) the certificate sets forth the nature of the business or purposes` FALSE TRUE
#ASSERT NOT (`s 102(a)(3) the certificate sets forth the nature of the business or purposes` FALSE FALSE)
-- the general statement brings in all lawful acts, except express limitations
#ASSERT `s 102(a)(3) the act or activity is within the purposes of the corporation` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 102(a)(3) the act or activity is within the purposes of the corporation` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 102(a)(3) the act or activity is within the purposes of the corporation` TRUE FALSE FALSE EQUALS JUST FALSE
-- particular purposes only: not decided
#ASSERT `s 102(a)(3) the act or activity is within the purposes of the corporation` FALSE TRUE FALSE EQUALS NOTHING

§§ `s 102(a)(4) stock and nonstock`

-- order: number of classes; total number of shares; par value of each (or all without par); number of shares of each class; classes with and without par; desire to fix by certificate; statement; desire to grant board authority; express grant
GIVEN classes IS A NUMBER
      total IS A BOOLEAN
      par IS A BOOLEAN
      each IS A BOOLEAN
      specifies IS A BOOLEAN
      desirefix IS A BOOLEAN
      statement IS A BOOLEAN
      desiregrant IS A BOOLEAN
      grant IS A BOOLEAN
GIVETH A `s 102(a)(4) Authorized stock stated`
`t102a stock` classes total par each specifies desirefix statement desiregrant grant MEANS `s 102(a)(4) Authorized stock stated` OF classes, total, par, each, specifies, desirefix, statement, desiregrant, grant

-- one class: the total number of shares and the par value (or no par)
#ASSERT `s 102(a)(4) the certificate sets forth the authorized stock` (`t102a stock` 1 TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `s 102(a)(4) the certificate sets forth the authorized stock` (`t102a stock` 1 TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 102(a)(4) the certificate sets forth the authorized stock` (`t102a stock` 1 FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
-- more than one class: total, number of each class, and which have par value
#ASSERT `s 102(a)(4) the certificate sets forth the authorized stock` (`t102a stock` 2 TRUE FALSE TRUE TRUE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `s 102(a)(4) the certificate sets forth the authorized stock` (`t102a stock` 3 TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 102(a)(4) the certificate sets forth the authorized stock` (`t102a stock` 3 TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 102(a)(4) the certificate sets forth the authorized stock` (`t102a stock` 3 FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
-- the statement of rights and the grant of authority to the board are needed only if desired
#ASSERT `s 102(a)(4) the certificate sets forth the authorized stock` (`t102a stock` 2 TRUE FALSE TRUE TRUE TRUE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `s 102(a)(4) the certificate sets forth the authorized stock` (`t102a stock` 2 TRUE FALSE TRUE TRUE TRUE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 102(a)(4) the certificate sets forth the authorized stock` (`t102a stock` 2 TRUE FALSE TRUE TRUE FALSE FALSE TRUE TRUE) EQUALS JUST TRUE
#ASSERT `s 102(a)(4) the certificate sets forth the authorized stock` (`t102a stock` 2 TRUE FALSE TRUE TRUE FALSE FALSE TRUE FALSE) EQUALS JUST FALSE
#ASSERT `s 102(a)(4) the certificate sets forth the authorized stock` (`t102a stock` 1 TRUE TRUE FALSE FALSE TRUE TRUE TRUE TRUE) EQUALS JUST TRUE
-- no class, or a fractional number of classes: not covered
#ASSERT `s 102(a)(4) the certificate sets forth the authorized stock` (`t102a stock` 0 TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE) EQUALS NOTHING
#ASSERT `s 102(a)(4) the certificate sets forth the authorized stock` (`t102a stock` 1.5 TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE) EQUALS NOTHING

-- nonstock: the statement that no capital stock may be issued, and the conditions of membership (certificate or bylaws)
#ASSERT `s 102(a)(4) the certificate and the bylaws set forth what a nonstock corporation must state` (`s 102(a)(4) Nonstock corporation stated` OF TRUE, TRUE)
#ASSERT NOT (`s 102(a)(4) the certificate and the bylaws set forth what a nonstock corporation must state` (`s 102(a)(4) Nonstock corporation stated` OF TRUE, FALSE))
#ASSERT NOT (`s 102(a)(4) the certificate and the bylaws set forth what a nonstock corporation must state` (`s 102(a)(4) Nonstock corporation stated` OF FALSE, TRUE))
-- the stock provisions "shall not apply to nonstock corporations"
#ASSERT `s 102(a)(4) the certificate and the bylaws set forth what paragraph (a)(4) requires` `a charitable nonstock corporation` (`t102a stock` 0 FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE) (`s 102(a)(4) Nonstock corporation stated` OF TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `s 102(a)(4) the certificate and the bylaws set forth what paragraph (a)(4) requires` `a nonstock corporation with membership interests` (`t102a stock` 1 TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE) (`s 102(a)(4) Nonstock corporation stated` OF FALSE, TRUE) EQUALS JUST FALSE
#ASSERT `s 102(a)(4) the certificate and the bylaws set forth what paragraph (a)(4) requires` `a stock corporation` (`t102a stock` 1 TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE) (`s 102(a)(4) Nonstock corporation stated` OF FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `s 102(a)(4) the certificate and the bylaws set forth what paragraph (a)(4) requires` `a stock corporation` (`t102a stock` 0 TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE) (`s 102(a)(4) Nonstock corporation stated` OF TRUE, TRUE) EQUALS NOTHING
-- members: those the stated criteria identify, or, if none is stated, those entitled to vote for the governing body
#ASSERT `s 102(a)(4) the person is a member of the nonstock corporation` TRUE TRUE FALSE
#ASSERT NOT (`s 102(a)(4) the person is a member of the nonstock corporation` TRUE FALSE TRUE)
#ASSERT `s 102(a)(4) the person is a member of the nonstock corporation` FALSE FALSE TRUE
#ASSERT NOT (`s 102(a)(4) the person is a member of the nonstock corporation` FALSE TRUE FALSE)
#ASSERT `s 102(a)(4) the corporate act remains valid although the nonstock corporation has no members` TRUE
#ASSERT NOT (`s 102(a)(4) the corporate act remains valid although the nonstock corporation has no members` FALSE)
#ASSERT NOT (`s 102(a)(4) the nonstock corporation has forfeited its existence or is dissolved because it has no members`)
-- provision for classes, groups and voting
#ASSERT `s 102(a)(4) the nonstock corporation may make the provision for its members` `a charitable nonstock corporation` `classes or groups of members having relative rights, powers and duties` FALSE TRUE
#ASSERT `s 102(a)(4) the nonstock corporation may make the provision for its members` `a nonstock corporation with membership interests` `provision for the future creation of additional classes or groups of members, including ones senior to existing classes and groups` FALSE TRUE
#ASSERT `s 102(a)(4) the nonstock corporation may make the provision for its members` `a nonprofit nonstock corporation that is not charitable` `full, limited or no voting rights or powers for a member or class or group of members` FALSE TRUE
#ASSERT `s 102(a)(4) the nonstock corporation may make the provision for its members` `a nonprofit nonstock corporation that is not charitable` `voting by members on a per capita, number, financial interest, class, group or any other basis` TRUE TRUE
-- the voting rights grant is "except as otherwise provided in this chapter"
#ASSERT NOT (`s 102(a)(4) the nonstock corporation may make the provision for its members` `a nonprofit nonstock corporation that is not charitable` `full, limited or no voting rights or powers for a member or class or group of members` TRUE TRUE)
#ASSERT NOT (`s 102(a)(4) the nonstock corporation may make the provision for its members` `a charitable nonstock corporation` `the right to vote on a specified transaction without the right to vote for the election of the members of the governing body` TRUE TRUE)
#ASSERT `s 102(a)(4) the nonstock corporation may make the provision for its members` `a charitable nonstock corporation` `the right to vote on a specified transaction without the right to vote for the election of the members of the governing body` FALSE TRUE
-- not set forth in the certificate or bylaws, or not a nonstock corporation
#ASSERT NOT (`s 102(a)(4) the nonstock corporation may make the provision for its members` `a charitable nonstock corporation` `classes or groups of members having relative rights, powers and duties` FALSE FALSE)
#ASSERT NOT (`s 102(a)(4) the nonstock corporation may make the provision for its members` `a stock corporation` `classes or groups of members having relative rights, powers and duties` FALSE TRUE)

§§ `s 102(a)(5) and (6), and the six together`

#ASSERT `s 102(a)(5) the certificate sets forth the incorporators` TRUE
#ASSERT NOT (`s 102(a)(5) the certificate sets forth the incorporators` FALSE)
-- the first directors are named only if the incorporators' powers end on filing
#ASSERT `s 102(a)(6) the certificate sets forth the first directors` FALSE FALSE
#ASSERT `s 102(a)(6) the certificate sets forth the first directors` TRUE TRUE
#ASSERT NOT (`s 102(a)(6) the certificate sets forth the first directors` TRUE FALSE)
#ASSERT `s 102(a) the certificate of incorporation sets forth everything that subsection (a) requires` TRUE TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 102(a) the certificate of incorporation sets forth everything that subsection (a) requires` FALSE TRUE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`s 102(a) the certificate of incorporation sets forth everything that subsection (a) requires` TRUE FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`s 102(a) the certificate of incorporation sets forth everything that subsection (a) requires` TRUE TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`s 102(a) the certificate of incorporation sets forth everything that subsection (a) requires` TRUE TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 102(a) the certificate of incorporation sets forth everything that subsection (a) requires` TRUE TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 102(a) the certificate of incorporation sets forth everything that subsection (a) requires` TRUE TRUE TRUE TRUE TRUE FALSE)
