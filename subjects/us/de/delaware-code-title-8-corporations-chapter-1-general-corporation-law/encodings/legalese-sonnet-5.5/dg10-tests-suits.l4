#ASSERT `s 327 the complaint contains the averment of stock ownership that the section requires` TRUE FALSE
#ASSERT `s 327 the complaint contains the averment of stock ownership that the section requires` FALSE TRUE
#ASSERT `s 327 the complaint contains the averment of stock ownership that the section requires` TRUE TRUE
#ASSERT NOT (`s 327 the complaint contains the averment of stock ownership that the section requires` FALSE FALSE)

§ `s 328: liability and remedies not impaired`

#ASSERT `s 328 the event lessens or impairs the liability or the rights or remedies` TRUE `a sale of the assets of the corporation under s 328` EQUALS JUST FALSE
#ASSERT `s 328 the event lessens or impairs the liability or the rights or remedies` TRUE `an increase in the capital stock of the corporation under s 328` EQUALS JUST FALSE
#ASSERT `s 328 the event lessens or impairs the liability or the rights or remedies` TRUE `a decrease in the capital stock of the corporation under s 328` EQUALS JUST FALSE
#ASSERT `s 328 the event lessens or impairs the liability or the rights or remedies` TRUE `a merger or consolidation of the corporation with 1 or more corporations under s 328` EQUALS JUST FALSE
#ASSERT `s 328 the event lessens or impairs the liability or the rights or remedies` TRUE `a change or amendment in the certificate of incorporation under s 328` EQUALS JUST FALSE
-- An event the section does not list, and a corporation not of this State: not covered.
#ASSERT `s 328 the event lessens or impairs the liability or the rights or remedies` TRUE `an event that s 328 does not list` EQUALS NOTHING
#ASSERT `s 328 the event lessens or impairs the liability or the rights or remedies` FALSE `a sale of the assets of the corporation under s 328` EQUALS NOTHING

§ `s 329: want of legal organization`

#ASSERT `s 329(a) the party is permitted to assert want of legal organization as a defense to a claim` `a corporation of this State under s 329(a)` EQUALS JUST FALSE
#ASSERT `s 329(a) the party is permitted to assert want of legal organization as a defense to a claim` `a person sued by a corporation of this State under s 329(a)` EQUALS JUST FALSE
#ASSERT `s 329(a) the party is permitted to assert want of legal organization as a defense to a claim` `another party under s 329(a)` EQUALS NOTHING
#ASSERT `s 329(b) judicial inquiry into the regularity or validity of the organization or the lawful possession of the power is not prevented` TRUE TRUE
#ASSERT NOT (`s 329(b) judicial inquiry into the regularity or validity of the organization or the lawful possession of the power is not prevented` TRUE FALSE)
#ASSERT NOT (`s 329(b) judicial inquiry into the regularity or validity of the organization or the lawful possession of the power is not prevented` FALSE TRUE)
#ASSERT `s 329(b) evidence tending to sustain the challenge is admissible` TRUE TRUE
#ASSERT NOT (`s 329(b) evidence tending to sustain the challenge is admissible` TRUE FALSE)

§ `s 330: usury`

#ASSERT `s 330 the corporation may plead a statute against usury` TRUE EQUALS JUST FALSE
-- A suit that is not to enforce the corporation's own bond, note or evidence of indebtedness: not covered.
#ASSERT `s 330 the corporation may plead a statute against usury` FALSE EQUALS NOTHING
