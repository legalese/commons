IMPORT prelude
IMPORT daydate
IMPORT `dg-core`
IMPORT `dg10-sos-service`
IMPORT `dg10-suits`

-- Tests of dg10-sos-service.l4 and dg10-suits.l4 (ss 321-330).
-- Every expected value is written by hand from the text (src:1634-1679) beside the assertion, before the run.
-- The expected value is never copied from the encoding's own output.

§ `Fixtures`

-- ways of service
`dg10 test way officer` MEANS `a copy delivered personally in this State to an officer or director under s 321(a)`
`dg10 test way agent` MEANS `a copy delivered personally in this State to the registered agent under s 321(a)`
`dg10 test way abode` MEANS `a copy left at the dwelling house or usual place of abode in this State of an officer, director or individual registered agent under s 321(a)`
`dg10 test way office` MEANS `a copy left at the registered office of the corporation in this State under s 321(a)`
`dg10 test way place` MEANS `a copy left at another place of business of the corporation in this State under s 321(a)`
`dg10 test way corporate agent` MEANS `a copy served in this State on the president, vice-president, secretary, assistant secretary or a director of the corporate registered agent under s 321(a)`
`dg10 test way unlisted` MEANS `a way of service that s 321(a) does not list`

GIVEN way IS A `s 321(a) Way of serving process on the corporation`
      left IS A DATE
      returns IS A DATE
      adult IS A BOOLEAN
      stated IS A BOOLEAN
      forthwith IS A BOOLEAN
GIVETH A `s 321(a) Service of process`
`dg10 test service` way left returns adult stated forthwith MEANS
    `s 321(a) Service of process` WITH
        `the way the process was served` IS way
        `the date the copy was left` IS left
        `the return date of the process` IS returns
        `the copy was left in the presence of an adult person` IS adult
        `the officer serving the process distinctly stated the manner of service in the return` IS stated
        `the process is returnable forthwith` IS forthwith

§ `s 321(a): modes of service`

-- Personal delivery to an officer, director or the registered agent is enough; nothing else is asked.
#ASSERT `s 321(a) service is effective under subsection (a)` (`dg10 test service` `dg10 test way officer` (YMD 2027 3 1) (YMD 2027 3 2) FALSE FALSE FALSE)
#ASSERT `s 321(a) service is effective under subsection (a)` (`dg10 test service` `dg10 test way agent` (YMD 2027 3 1) (YMD 2027 3 2) FALSE FALSE FALSE)
-- A corporate registered agent may be served on its president and the others named.
#ASSERT `s 321(a) service is effective under subsection (a)` (`dg10 test service` `dg10 test way corporate agent` (YMD 2027 3 1) (YMD 2027 3 2) FALSE FALSE FALSE)
-- A copy left at an abode, the registered office or another place of business: delivered at least 6 days before the
-- return date, in the presence of an adult, and the manner of service stated in the return. Return date 7 March:
-- 1 March is exactly 6 days before and is in time.
#ASSERT `s 321(a) service is effective under subsection (a)` (`dg10 test service` `dg10 test way abode` (YMD 2027 3 1) (YMD 2027 3 7) TRUE TRUE FALSE)
#ASSERT `s 321(a) service is effective under subsection (a)` (`dg10 test service` `dg10 test way office` (YMD 2027 3 1) (YMD 2027 3 7) TRUE TRUE FALSE)
#ASSERT `s 321(a) service is effective under subsection (a)` (`dg10 test service` `dg10 test way place` (YMD 2027 3 1) (YMD 2027 3 7) TRUE TRUE FALSE)
-- 2 March is only 5 days before the return date: too late.
#ASSERT NOT (`s 321(a) service is effective under subsection (a)` (`dg10 test service` `dg10 test way office` (YMD 2027 3 2) (YMD 2027 3 7) TRUE TRUE FALSE))
-- Much earlier is fine.
#ASSERT `s 321(a) service is effective under subsection (a)` (`dg10 test service` `dg10 test way office` (YMD 2027 1 1) (YMD 2027 3 7) TRUE TRUE FALSE)
-- No adult present: not effective.
#ASSERT NOT (`s 321(a) service is effective under subsection (a)` (`dg10 test service` `dg10 test way office` (YMD 2027 3 1) (YMD 2027 3 7) FALSE TRUE FALSE))
-- Manner of service not stated in the return: not effective.
#ASSERT NOT (`s 321(a) service is effective under subsection (a)` (`dg10 test service` `dg10 test way office` (YMD 2027 3 1) (YMD 2027 3 7) TRUE FALSE FALSE))
-- Across a month end: return date 3 April, 6 days before is 28 March.
#ASSERT `s 321(a) service is effective under subsection (a)` (`dg10 test service` `dg10 test way place` (YMD 2027 3 28) (YMD 2027 4 3) TRUE TRUE FALSE)
#ASSERT NOT (`s 321(a) service is effective under subsection (a)` (`dg10 test service` `dg10 test way place` (YMD 2027 3 29) (YMD 2027 4 3) TRUE TRUE FALSE))
-- Process returnable forthwith must be delivered personally to the officer, director or registered agent.
#ASSERT `s 321(a) service is effective under subsection (a)` (`dg10 test service` `dg10 test way officer` (YMD 2027 3 1) (YMD 2027 3 1) FALSE FALSE TRUE)
#ASSERT `s 321(a) service is effective under subsection (a)` (`dg10 test service` `dg10 test way agent` (YMD 2027 3 1) (YMD 2027 3 1) FALSE FALSE TRUE)
#ASSERT `s 321(a) service is effective under subsection (a)` (`dg10 test service` `dg10 test way corporate agent` (YMD 2027 3 1) (YMD 2027 3 1) FALSE FALSE TRUE)
#ASSERT NOT (`s 321(a) service is effective under subsection (a)` (`dg10 test service` `dg10 test way abode` (YMD 2027 1 1) (YMD 2027 3 1) TRUE TRUE TRUE))
#ASSERT NOT (`s 321(a) service is effective under subsection (a)` (`dg10 test service` `dg10 test way office` (YMD 2027 1 1) (YMD 2027 3 1) TRUE TRUE TRUE))
-- A way subsection (a) does not list is not service under (a).
#ASSERT NOT (`s 321(a) service is effective under subsection (a)` (`dg10 test service` `dg10 test way unlisted` (YMD 2027 1 1) (YMD 2027 3 1) TRUE TRUE FALSE))

§ `s 321(b) and (c): the Secretary of State and other statutes`

-- Service on the Secretary of State when the server cannot serve under (a) by due diligence.
#ASSERT `s 321(b) service on the Secretary of State is as effectual as service under subsection (a)` TRUE FALSE FALSE
#ASSERT NOT (`s 321(b) service on the Secretary of State is as effectual as service under subsection (a)` FALSE FALSE FALSE)
-- Electronic transmission only as prescribed by the Secretary of State.
#ASSERT `s 321(b) service on the Secretary of State is as effectual as service under subsection (a)` TRUE TRUE TRUE
#ASSERT NOT (`s 321(b) service on the Secretary of State is as effectual as service under subsection (a)` TRUE TRUE FALSE)
-- The letter goes to the principal place of business on the records, or if none appears to the last registered office.
#ASSERT `s 321(b) the letter is addressed as the subsection requires` TRUE TRUE FALSE
#ASSERT NOT (`s 321(b) the letter is addressed as the subsection requires` TRUE FALSE TRUE)
#ASSERT `s 321(b) the letter is addressed as the subsection requires` FALSE FALSE TRUE
#ASSERT NOT (`s 321(b) the letter is addressed as the subsection requires` FALSE TRUE FALSE)
-- (c) another statute or rule of court.
#ASSERT `s 321(c) service is made in accordance with s 3111 of Title 10 or another statute or rule of court` TRUE
#ASSERT NOT (`s 321(c) service is made in accordance with s 3111 of Title 10 or another statute or rule of court` FALSE)
-- The three routes together.
#ASSERT `s 321 service of process on the corporation is effective` (`dg10 test service` `dg10 test way officer` (YMD 2027 3 1) (YMD 2027 3 2) FALSE FALSE FALSE) FALSE FALSE FALSE FALSE
#ASSERT `s 321 service of process on the corporation is effective` (`dg10 test service` `dg10 test way unlisted` (YMD 2027 3 1) (YMD 2027 3 2) FALSE FALSE FALSE) TRUE FALSE FALSE FALSE
#ASSERT `s 321 service of process on the corporation is effective` (`dg10 test service` `dg10 test way unlisted` (YMD 2027 3 1) (YMD 2027 3 2) FALSE FALSE FALSE) FALSE FALSE FALSE TRUE
#ASSERT NOT (`s 321 service of process on the corporation is effective` (`dg10 test service` `dg10 test way unlisted` (YMD 2027 3 1) (YMD 2027 3 2) FALSE FALSE FALSE) FALSE FALSE FALSE FALSE)

§ `ss 321(b), 376(b), 381(d), 382(c): the letter, the plaintiff's steps and the record (dg10-sos-service.l4)`

`dg10 test letter` MEANS `s 321(b) Letter from the Secretary of State` WITH
    `the Secretary of State sent the letter forthwith` IS TRUE
    `the letter was sent by mail or courier with a record of mailing or deposit and a record of delivery signed` IS TRUE
    `the letter enclosed a copy of the process and any other papers served on the Secretary of State` IS TRUE

`dg10 test letter late` MEANS `s 321(b) Letter from the Secretary of State` WITH
    `the Secretary of State sent the letter forthwith` IS FALSE
    `the letter was sent by mail or courier with a record of mailing or deposit and a record of delivery signed` IS TRUE
    `the letter enclosed a copy of the process and any other papers served on the Secretary of State` IS TRUE

`dg10 test letter plain post` MEANS `s 321(b) Letter from the Secretary of State` WITH
    `the Secretary of State sent the letter forthwith` IS TRUE
    `the letter was sent by mail or courier with a record of mailing or deposit and a record of delivery signed` IS FALSE
    `the letter enclosed a copy of the process and any other papers served on the Secretary of State` IS TRUE

`dg10 test letter bare` MEANS `s 321(b) Letter from the Secretary of State` WITH
    `the Secretary of State sent the letter forthwith` IS TRUE
    `the letter was sent by mail or courier with a record of mailing or deposit and a record of delivery signed` IS TRUE
    `the letter enclosed a copy of the process and any other papers served on the Secretary of State` IS FALSE

#ASSERT `s 321(b) the Secretary of State's letter meets the section` `dg10 test letter` TRUE
#ASSERT NOT (`s 321(b) the Secretary of State's letter meets the section` `dg10 test letter` FALSE)
#ASSERT NOT (`s 321(b) the Secretary of State's letter meets the section` `dg10 test letter late` TRUE)
#ASSERT NOT (`s 321(b) the Secretary of State's letter meets the section` `dg10 test letter plain post` TRUE)
#ASSERT NOT (`s 321(b) the Secretary of State's letter meets the section` `dg10 test letter bare` TRUE)

GIVEN duplicate IS A BOOLEAN
      notified IS A BOOLEAN
      paid IS A NUMBER
GIVETH A `s 321(b) Plaintiff's steps`
`dg10 test steps` duplicate notified paid MEANS
    `s 321(b) Plaintiff's steps` WITH
        `the plaintiff served the process and any other papers in duplicate` IS duplicate
        `the plaintiff notified the Secretary of State that service was being effected so` IS notified
        `the amount the plaintiff paid the Secretary of State for the use of the State` IS paid

-- The fee is the amount prescribed under s 391(a)(29); here 50 (a stated figure for the test only).
#ASSERT `s 321(b) the plaintiff has done what the subsection requires` (`dg10 test steps` TRUE TRUE 50) 50
#ASSERT NOT (`s 321(b) the plaintiff has done what the subsection requires` (`dg10 test steps` TRUE TRUE 49) 50)
#ASSERT `s 321(b) the plaintiff has done what the subsection requires` (`dg10 test steps` TRUE TRUE 51) 50
#ASSERT NOT (`s 321(b) the plaintiff has done what the subsection requires` (`dg10 test steps` FALSE TRUE 50) 50)
#ASSERT NOT (`s 321(b) the plaintiff has done what the subsection requires` (`dg10 test steps` TRUE FALSE 50) 50)
-- The fee is taxed as part of the costs if the plaintiff prevails.
#ASSERT `s 321(b) the fee is taxed as part of the costs` TRUE
#ASSERT NOT (`s 321(b) the fee is taxed as part of the costs` FALSE)

`dg10 test record complete` MEANS `s 321(b) Record of service` WITH
    `the record is alphabetical` IS TRUE
    `the record gives the name of the plaintiff and defendant` IS TRUE
    `the record gives the title, docket number and nature of the proceeding` IS TRUE
    `the record gives the fact that service has been effected through the Secretary of State` IS TRUE
    `the record gives the return date` IS TRUE
    `the record gives the day and hour when the service was made` IS TRUE

`dg10 test record without the hour` MEANS `s 321(b) Record of service` WITH
    `the record is alphabetical` IS TRUE
    `the record gives the name of the plaintiff and defendant` IS TRUE
    `the record gives the title, docket number and nature of the proceeding` IS TRUE
    `the record gives the fact that service has been effected through the Secretary of State` IS TRUE
    `the record gives the return date` IS TRUE
    `the record gives the day and hour when the service was made` IS FALSE

`dg10 test record not alphabetical` MEANS `s 321(b) Record of service` WITH
    `the record is alphabetical` IS FALSE
    `the record gives the name of the plaintiff and defendant` IS TRUE
    `the record gives the title, docket number and nature of the proceeding` IS TRUE
    `the record gives the fact that service has been effected through the Secretary of State` IS TRUE
    `the record gives the return date` IS TRUE
    `the record gives the day and hour when the service was made` IS TRUE

#ASSERT `s 321(b) the record of service lists what the subsection requires` `dg10 test record complete`
#ASSERT NOT (`s 321(b) the record of service lists what the subsection requires` `dg10 test record without the hour`)
#ASSERT NOT (`s 321(b) the record of service lists what the subsection requires` `dg10 test record not alphabetical`)

-- Retention: not required to retain for longer than 5 years from receipt. Received 15 January 2020: the fifth
-- anniversary is 15 January 2025 (inside, fork F1); the next day is outside.
#ASSERT `s 321(b) the Secretary of State must still retain the record of service` (YMD 2020 1 15) (YMD 2025 1 15)
#ASSERT NOT (`s 321(b) the Secretary of State must still retain the record of service` (YMD 2020 1 15) (YMD 2025 1 16))
#ASSERT `s 321(b) the Secretary of State must still retain the record of service` (YMD 2020 1 15) (YMD 2022 6 1)
-- Received 29 February 2020: five years later clamps to 28 February 2025 (core fork F2).
#ASSERT `s 321(b) the Secretary of State must still retain the record of service` (YMD 2020 2 29) (YMD 2025 2 28)
#ASSERT NOT (`s 321(b) the Secretary of State must still retain the record of service` (YMD 2020 2 29) (YMD 2025 3 1))

§ `s 322: failure to obey a court order`

#ASSERT `s 322 the receiver for which the failure to obey is a sufficient ground` TRUE `this State` EQUALS `a receiver of the corporation under s 322`
#ASSERT `s 322 the receiver for which the failure to obey is a sufficient ground` TRUE `another jurisdiction of the United States` EQUALS `a receiver of the assets of the corporation within this State under s 322`
#ASSERT `s 322 the receiver for which the failure to obey is a sufficient ground` TRUE `a foreign jurisdiction outside the United States` EQUALS `a receiver of the assets of the corporation within this State under s 322`
#ASSERT `s 322 the receiver for which the failure to obey is a sufficient ground` FALSE `this State` EQUALS `no receiver on the ground in s 322`
#ASSERT `s 322 the receiver for which the failure to obey is a sufficient ground` FALSE `a foreign jurisdiction outside the United States` EQUALS `no receiver on the ground in s 322`

§ `s 323: failure to obey a peremptory writ of mandamus`

GIVEN days IS A NUMBER
      party IS A BOOLEAN
      prepared IS A BOOLEAN
      filed IS A BOOLEAN
      proof IS A BOOLEAN
GIVETH A `s 323 Failure to obey a peremptory writ of mandamus`
`dg10 test failure` days party prepared filed proof MEANS
    `s 323 Failure to obey a peremptory writ of mandamus` WITH
        `the number of days the corporation has failed to obey the writ since it was served on the corporation` IS days
        `the person is a party in interest in the proceeding in which the writ issued` IS party
        `the statement of the failure was prepared by that party or that party's attorney` IS prepared
        `the statement has been filed with the Attorney General` IS filed
        `the court has competent proof of the failure and proper proceedings have been had in quo warranto` IS proof

-- 30 days after service: 29 is too soon, 30 is enough.
#ASSERT NOT (`s 323 the party in interest may file a statement with the Attorney General` (`dg10 test failure` 29 TRUE TRUE FALSE FALSE))
#ASSERT `s 323 the party in interest may file a statement with the Attorney General` (`dg10 test failure` 30 TRUE TRUE FALSE FALSE)
#ASSERT `s 323 the party in interest may file a statement with the Attorney General` (`dg10 test failure` 31 TRUE TRUE FALSE FALSE)
#ASSERT NOT (`s 323 the party in interest may file a statement with the Attorney General` (`dg10 test failure` 30 FALSE TRUE FALSE FALSE))
#ASSERT NOT (`s 323 the party in interest may file a statement with the Attorney General` (`dg10 test failure` 30 TRUE FALSE FALSE FALSE))
-- The Attorney General's duty follows the filing of the statement.
#ASSERT `s 323 the Attorney General must forthwith commence quo warranto proceedings against the corporation` (`dg10 test failure` 30 TRUE TRUE TRUE FALSE)
#ASSERT NOT (`s 323 the Attorney General must forthwith commence quo warranto proceedings against the corporation` (`dg10 test failure` 30 TRUE TRUE FALSE FALSE))
#ASSERT NOT (`s 323 the Attorney General must forthwith commence quo warranto proceedings against the corporation` (`dg10 test failure` 29 TRUE TRUE TRUE FALSE))
-- The court decrees forfeiture on competent proof and proper proceedings.
#ASSERT `s 323 the court must decree the charter of the corporation forfeited` (`dg10 test failure` 30 TRUE TRUE TRUE TRUE)
#ASSERT NOT (`s 323 the court must decree the charter of the corporation forfeited` (`dg10 test failure` 30 TRUE TRUE TRUE FALSE))

§ `s 324: attachment of shares`

-- (a) attachment for a debt of a person who appears on the books to hold the shares.
#ASSERT `s 324(a) the shares, option, right or interest may be attached` TRUE TRUE
#ASSERT NOT (`s 324(a) the shares, option, right or interest may be attached` TRUE FALSE)
#ASSERT NOT (`s 324(a) the shares, option, right or interest may be attached` FALSE TRUE)
-- s 8-112 of Title 6 (or an uncertificated security) before the attachment is laid.
#ASSERT `s 324(a) the attachment may be laid` TRUE FALSE
#ASSERT `s 324(a) the attachment may be laid` FALSE TRUE
#ASSERT NOT (`s 324(a) the attachment may be laid` FALSE FALSE)
-- An order of sale: after final judgment, s 8-112 satisfied (unless uncertificated), and notice as for sales upon execution.
#ASSERT `s 324(a) an order of sale may issue` FALSE TRUE TRUE TRUE
#ASSERT `s 324(a) an order of sale may issue` TRUE FALSE TRUE TRUE
#ASSERT NOT (`s 324(a) an order of sale may issue` FALSE FALSE TRUE TRUE)
#ASSERT NOT (`s 324(a) an order of sale may issue` FALSE TRUE FALSE TRUE)
#ASSERT NOT (`s 324(a) an order of sale may issue` FALSE TRUE TRUE FALSE)
-- So much may be sold as suffices: debt 1000 + interest 50 + costs 20 = 1070.
#ASSERT `s 324(a) the part already sold is sufficient to satisfy the debt, interest and costs` 1000 50 20 1070
#ASSERT NOT (`s 324(a) the part already sold is sufficient to satisfy the debt, interest and costs` 1000 50 20 1069)
#ASSERT `s 324(a) the part already sold is sufficient to satisfy the debt, interest and costs` 1000 50 20 5000

GIVEN outside IS A BOOLEAN
      nonresident IS A BOOLEAN
      mailed IS A BOOLEAN
      newspaper IS A BOOLEAN
      published IS A BOOLEAN
      times IS A NUMBER
      weeks IS A NUMBER
      processcounty IS A BOOLEAN
      days IS A NUMBER
GIVETH A `s 324(a) Notice of the sale`
`dg10 test notice` outside nonresident mailed newspaper published times weeks processcounty days MEANS
    `s 324(a) Notice of the sale` WITH
        `the debtor lives out of the county` IS outside
        `the debtor is a nonresident of this State` IS nonresident
        `a copy of the order was sent by registered or certified mail, return receipt requested, to the debtor's last known address` IS mailed
        `a newspaper is published in the county of the debtor's last known residence` IS newspaper
        `the order was published in a newspaper published in the county of the debtor's last known residence` IS published
        `the number of times the order was published` IS times
        `the number of successive weeks over which the order was published` IS weeks
        `the order was published in a newspaper published in the county where the attachment process issued` IS processcounty
        `the number of days from the last publication to the sale` IS days

-- A debtor who lives in the county: this subsection's mailing and publication is not required.
#ASSERT `s 324(a) the notice of the sale by mail and publication is sufficient` (`dg10 test notice` FALSE FALSE FALSE FALSE FALSE 0 0 FALSE 0)
-- A debtor who lives out of the county but in this State: mailed, and published in the county of last known
-- residence at least 10 days before the sale.
#ASSERT `s 324(a) the notice of the sale by mail and publication is sufficient` (`dg10 test notice` TRUE FALSE TRUE TRUE TRUE 1 1 FALSE 10)
#ASSERT NOT (`s 324(a) the notice of the sale by mail and publication is sufficient` (`dg10 test notice` TRUE FALSE TRUE TRUE TRUE 1 1 FALSE 9))
#ASSERT NOT (`s 324(a) the notice of the sale by mail and publication is sufficient` (`dg10 test notice` TRUE FALSE FALSE TRUE TRUE 1 1 FALSE 10))
#ASSERT NOT (`s 324(a) the notice of the sale by mail and publication is sufficient` (`dg10 test notice` TRUE FALSE TRUE TRUE FALSE 0 0 FALSE 10))
-- "if there be any": no newspaper published in that county, so only the mailing is required.
#ASSERT `s 324(a) the notice of the sale by mail and publication is sufficient` (`dg10 test notice` TRUE FALSE TRUE FALSE FALSE 0 0 FALSE 0)
-- A nonresident of this State: mailed, and published at least twice for 2 successive weeks in the county where
-- the attachment issued, the last publication at least 10 days before the sale.
#ASSERT `s 324(a) the notice of the sale by mail and publication is sufficient` (`dg10 test notice` TRUE TRUE TRUE FALSE FALSE 2 2 TRUE 10)
#ASSERT NOT (`s 324(a) the notice of the sale by mail and publication is sufficient` (`dg10 test notice` TRUE TRUE TRUE FALSE FALSE 1 2 TRUE 10))
#ASSERT NOT (`s 324(a) the notice of the sale by mail and publication is sufficient` (`dg10 test notice` TRUE TRUE TRUE FALSE FALSE 2 1 TRUE 10))
#ASSERT NOT (`s 324(a) the notice of the sale by mail and publication is sufficient` (`dg10 test notice` TRUE TRUE TRUE FALSE FALSE 2 2 TRUE 9))
#ASSERT NOT (`s 324(a) the notice of the sale by mail and publication is sufficient` (`dg10 test notice` TRUE TRUE TRUE FALSE FALSE 2 2 FALSE 10))
#ASSERT NOT (`s 324(a) the notice of the sale by mail and publication is sufficient` (`dg10 test notice` TRUE TRUE FALSE FALSE FALSE 2 2 TRUE 10))
-- A transfer by the debtor after attachment is void if the shares are sold.
#ASSERT `s 324(a) the debtor's assignment or transfer after attachment is void` TRUE TRUE
#ASSERT NOT (`s 324(a) the debtor's assignment or transfer after attachment is void` TRUE FALSE)
#ASSERT NOT (`s 324(a) the debtor's assignment or transfer after attachment is void` FALSE TRUE)

-- (b) service of the process on the corporation, and 20 days.
#ASSERT `s 324(b) the process has been served on the corporation` TRUE FALSE
#ASSERT `s 324(b) the process has been served on the corporation` FALSE TRUE
#ASSERT NOT (`s 324(b) the process has been served on the corporation` FALSE FALSE)
#ASSERT `s 324(b) the last day for the corporation to serve the certificate on the plaintiff` (YMD 2027 3 1) EQUALS (YMD 2027 3 21)
-- Across a month end and a year end.
#ASSERT `s 324(b) the last day for the corporation to serve the certificate on the plaintiff` (YMD 2027 12 20) EQUALS (YMD 2028 1 9)
#ASSERT `s 324(b) the corporation served the certificate in time` (YMD 2027 3 1) (YMD 2027 3 21)
#ASSERT NOT (`s 324(b) the corporation served the certificate in time` (YMD 2027 3 1) (YMD 2027 3 22))
#ASSERT `s 324(b) the corporation served the certificate in time` (YMD 2027 3 1) (YMD 2027 3 2)
-- What the certificate must state.
#ASSERT `s 324(b) the certificate states what the subsection requires` TRUE TRUE FALSE FALSE
#ASSERT NOT (`s 324(b) the certificate states what the subsection requires` TRUE FALSE FALSE FALSE)
#ASSERT `s 324(b) the certificate states what the subsection requires` FALSE FALSE TRUE TRUE
#ASSERT NOT (`s 324(b) the certificate states what the subsection requires` FALSE FALSE TRUE FALSE)
#ASSERT `s 324(b) the certificate states what the subsection requires` TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 324(b) the certificate states what the subsection requires` TRUE TRUE TRUE FALSE)
-- A provision made in the certificate of incorporation or bylaws does not relieve the corporation.
#ASSERT NOT (`s 324(b) a provision of the certificate of incorporation or bylaws relieves the corporation of the duty to serve the certificate` `in the certificate of incorporation`)
#ASSERT NOT (`s 324(b) a provision of the certificate of incorporation or bylaws relieves the corporation of the duty to serve the certificate` `in the bylaws`)
#ASSERT NOT (`s 324(b) a provision of the certificate of incorporation or bylaws relieves the corporation of the duty to serve the certificate` `in none of these`)

-- (c) the purchaser.
#ASSERT `s 324(c) the purchaser is entitled to the shares, option, right or interest` TRUE TRUE TRUE TRUE
#ASSERT `s 324(c) the purchaser is entitled to the shares, option, right or interest` TRUE TRUE FALSE FALSE
#ASSERT NOT (`s 324(c) the purchaser is entitled to the shares, option, right or interest` TRUE TRUE TRUE FALSE)
#ASSERT NOT (`s 324(c) the purchaser is entitled to the shares, option, right or interest` FALSE TRUE FALSE FALSE)
#ASSERT NOT (`s 324(c) the purchaser is entitled to the shares, option, right or interest` TRUE FALSE FALSE FALSE)
#ASSERT `s 324(c) the purchaser is entitled to the income or dividend` TRUE TRUE
#ASSERT NOT (`s 324(c) the purchaser is entitled to the income or dividend` TRUE FALSE)
#ASSERT NOT (`s 324(c) the purchaser is entitled to the income or dividend` FALSE TRUE)
#ASSERT `s 324(c) the sale transfers the shares, option, right or interest to the purchaser despite any contrary provision of the certificate of incorporation or bylaws` TRUE
#ASSERT NOT (`s 324(c) the sale transfers the shares, option, right or interest to the purchaser despite any contrary provision of the certificate of incorporation or bylaws` FALSE)
#ASSERT `s 324(c) the court has the power to order the corporation to issue new certificates or uncertificated shares to the purchaser and to cancel the registration` TRUE TRUE TRUE
#ASSERT NOT (`s 324(c) the court has the power to order the corporation to issue new certificates or uncertificated shares to the purchaser and to cancel the registration` TRUE TRUE FALSE)
#ASSERT NOT (`s 324(c) the court has the power to order the corporation to issue new certificates or uncertificated shares to the purchaser and to cancel the registration` TRUE FALSE TRUE)
#ASSERT NOT (`s 324(c) the court has the power to order the corporation to issue new certificates or uncertificated shares to the purchaser and to cancel the registration` FALSE TRUE TRUE)
-- (d) the money.
#ASSERT `s 324(d) the money is applied and paid by the public official as the law of attachment of personal property directs` TRUE
#ASSERT NOT (`s 324(d) the money is applied and paid by the public official as the law of attachment of personal property directs` FALSE)

§ `s 325: actions against officers, directors or stockholders`

#ASSERT `s 325(a) the plaintiff may sue the defendant at law or in equity` TRUE TRUE TRUE
#ASSERT NOT (`s 325(a) the plaintiff may sue the defendant at law or in equity` FALSE TRUE TRUE)
#ASSERT NOT (`s 325(a) the plaintiff may sue the defendant at law or in equity` TRUE FALSE TRUE)
#ASSERT NOT (`s 325(a) the plaintiff may sue the defendant at law or in equity` TRUE TRUE FALSE)
#ASSERT `s 325(a) the complaint states what the subsection requires` TRUE TRUE
#ASSERT NOT (`s 325(a) the complaint states what the subsection requires` TRUE FALSE)
#ASSERT NOT (`s 325(a) the complaint states what the subsection requires` FALSE TRUE)
-- (b) judgment against the corporation AND execution returned unsatisfied.
#ASSERT `s 325(b) a suit may be brought against the officer, director or stockholder for the debt of the corporation` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 325(b) a suit may be brought against the officer, director or stockholder for the debt of the corporation` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 325(b) a suit may be brought against the officer, director or stockholder for the debt of the corporation` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 325(b) a suit may be brought against the officer, director or stockholder for the debt of the corporation` TRUE FALSE FALSE EQUALS JUST FALSE
-- A defendant who is not an officer, director or stockholder is outside the subsection: not covered.
#ASSERT `s 325(b) a suit may be brought against the officer, director or stockholder for the debt of the corporation` FALSE TRUE TRUE EQUALS NOTHING

