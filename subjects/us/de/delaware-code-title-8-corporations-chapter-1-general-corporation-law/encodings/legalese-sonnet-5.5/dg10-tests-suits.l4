#ASSERT `s 326 the person may recover the amount paid from the corporation` TRUE TRUE TRUE
#ASSERT NOT (`s 326 the person may recover the amount paid from the corporation` FALSE TRUE TRUE)
#ASSERT NOT (`s 326 the person may recover the amount paid from the corporation` TRUE FALSE TRUE)
#ASSERT NOT (`s 326 the person may recover the amount paid from the corporation` TRUE TRUE FALSE)
#ASSERT `s 326 the amount the person may recover` TRUE 12500 EQUALS JUST 12500
-- No right under the section: not answered here.
#ASSERT `s 326 the amount the person may recover` FALSE 12500 EQUALS NOTHING
#ASSERT `s 326 the property is liable to be taken in the action` TRUE
#ASSERT NOT (`s 326 the property is liable to be taken in the action` FALSE)

