#ASSERT `Does our committee have the power to act in this matter` `paragraph (c)(1) of section 141 governs the corporation` `adopting a bylaw of the corporation` TRUE TRUE FALSE FALSE EQUALS NOTHING
-- #88 Under (c)(1), any other matter in the board's power.
#ASSERT `Does our committee have the power to act in this matter` `paragraph (c)(1) of section 141 governs the corporation` `any other matter in the management of the business and affairs of the corporation` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- #88 Under (c)(1), fixing share terms within a section 151(a) resolution.
#ASSERT `Does our committee have the power to act in this matter` `paragraph (c)(1) of section 141 governs the corporation` `fixing the designations and preferences or rights of shares, or the number of shares of a series, or authorizing an increase or decrease in them, under a resolution adopted by the board as provided in s 151(a)` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
-- #88 Under (c)(1), fixing share terms outside any section 151(a) resolution.
#ASSERT `Does our committee have the power to act in this matter` `paragraph (c)(1) of section 141 governs the corporation` `fixing the designations and preferences or rights of shares, or the number of shares of a series, or authorizing an increase or decrease in them, under a resolution adopted by the board as provided in s 151(a)` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- #88 Under (c)(2), a matter the chapter submits to stockholders.
#ASSERT `Does our committee have the power to act in this matter` `paragraph (c)(2) of section 141 governs the corporation` `approving or adopting, or recommending to the stockholders, an action or matter expressly required by this chapter to be submitted to stockholders for approval` TRUE FALSE FALSE TRUE EQUALS JUST FALSE
-- #88 Under (c)(2), adopting a bylaw.
#ASSERT `Does our committee have the power to act in this matter` `paragraph (c)(2) of section 141 governs the corporation` `adopting a bylaw of the corporation` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- #88 Under (c)(2), approving the election of directors.
#ASSERT `Does our committee have the power to act in this matter` `paragraph (c)(2) of section 141 governs the corporation` `approving or recommending the election or removal of directors` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- #88 Under (c)(2), declaring a dividend, which the chapter does not submit to stockholders.
#ASSERT `Does our committee have the power to act in this matter` `paragraph (c)(2) of section 141 governs the corporation` `declaring a dividend` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- #88 Under (c)(2), a matter the chapter submits to stockholders, in the general case.
#ASSERT `Does our committee have the power to act in this matter` `paragraph (c)(2) of section 141 governs the corporation` `any other matter in the management of the business and affairs of the corporation` TRUE FALSE FALSE TRUE EQUALS JUST FALSE
-- #89 Nothing otherwise provided; a subcommittee of two committee members.
#ASSERT `May our committee create a subcommittee and delegate its powers to it` `in none of these` 2 TRUE EQUALS TRUE
-- #89 The bylaws provide otherwise.
#ASSERT `May our committee create a subcommittee and delegate its powers to it` `in the bylaws` 2 TRUE EQUALS FALSE
-- #89 A subcommittee with a member who is not on the committee.
#ASSERT `May our committee create a subcommittee and delegate its powers to it` `in none of these` 2 FALSE EQUALS FALSE
-- #89 A subcommittee of no members.
#ASSERT `May our committee create a subcommittee and delegate its powers to it` `in none of these` 0 TRUE EQUALS FALSE
-- #90 A reference elsewhere in the chapter to a committee includes a subcommittee.
#ASSERT `Does a reference in the Law to a committee of the board include a subcommittee` FALSE EQUALS TRUE
-- #90 A reference inside subsection (c) does not.
#ASSERT `Does a reference in the Law to a committee of the board include a subcommittee` TRUE EQUALS FALSE
-- #91 Five serving, none fixed: three present is a majority.
#ASSERT `Is there a quorum of our committee or subcommittee` 3 5 FALSE 0 `in none of these, for a committee under s 141(c)(4)` EQUALS JUST TRUE
-- #91 Two present of five serving.
#ASSERT `Is there a quorum of our committee or subcommittee` 2 5 FALSE 0 `in none of these, for a committee under s 141(c)(4)` EQUALS JUST FALSE
-- #91 The bylaws fix a quorum of two of five serving: two present is enough.
#ASSERT `Is there a quorum of our committee or subcommittee` 2 5 TRUE 2 `in the bylaws, for a committee under s 141(c)(4)` EQUALS JUST TRUE
-- #91 The bylaws fix two: one present is not.
#ASSERT `Is there a quorum of our committee or subcommittee` 1 5 TRUE 2 `in the bylaws, for a committee under s 141(c)(4)` EQUALS JUST FALSE
-- #91 A quorum of one of five serving is below one third: the text does not say.
#ASSERT `Is there a quorum of our committee or subcommittee` 1 5 TRUE 1 `in the bylaws, for a committee under s 141(c)(4)` EQUALS NOTHING
-- #91 A quorum of six when five serve: the text does not say.
#ASSERT `Is there a quorum of our committee or subcommittee` 5 5 TRUE 6 `in the bylaws, for a committee under s 141(c)(4)` EQUALS NOTHING
-- #91 A number fixed nowhere the text recognises is ignored.
#ASSERT `Is there a quorum of our committee or subcommittee` 2 5 TRUE 2 `in none of these, for a committee under s 141(c)(4)` EQUALS JUST FALSE
-- #91 A quorum fixed in a board resolution.
#ASSERT `Is there a quorum of our committee or subcommittee` 2 5 TRUE 2 `in a resolution of the board of directors, for a committee under s 141(c)(4)` EQUALS JUST TRUE
-- #92 Four present of five, three in favor: a majority of those present.
#ASSERT `Did our committee or subcommittee carry the act at this meeting` 4 3 5 FALSE 0 `in none of these, for a committee under s 141(c)(4)` FALSE 0 `in none of these, for a committee under s 141(c)(4)` EQUALS JUST TRUE
-- #92 Four present, two in favor: not a majority.
#ASSERT `Did our committee or subcommittee carry the act at this meeting` 4 2 5 FALSE 0 `in none of these, for a committee under s 141(c)(4)` FALSE 0 `in none of these, for a committee under s 141(c)(4)` EQUALS JUST FALSE
-- #92 Two present of five: no quorum.
#ASSERT `Did our committee or subcommittee carry the act at this meeting` 2 2 5 FALSE 0 `in none of these, for a committee under s 141(c)(4)` FALSE 0 `in none of these, for a committee under s 141(c)(4)` EQUALS JUST FALSE
-- #92 The bylaws require four votes: three in favor is not enough.
#ASSERT `Did our committee or subcommittee carry the act at this meeting` 4 3 5 FALSE 0 `in none of these, for a committee under s 141(c)(4)` TRUE 4 `in the bylaws, for a committee under s 141(c)(4)` EQUALS JUST FALSE
-- #92 The bylaws require four votes: four in favor is enough.
#ASSERT `Did our committee or subcommittee carry the act at this meeting` 4 4 5 FALSE 0 `in none of these, for a committee under s 141(c)(4)` TRUE 4 `in the bylaws, for a committee under s 141(c)(4)` EQUALS JUST TRUE
-- #92 A greater vote recorded nowhere the text recognises is ignored.
#ASSERT `Did our committee or subcommittee carry the act at this meeting` 4 3 5 FALSE 0 `in none of these, for a committee under s 141(c)(4)` TRUE 4 `in none of these, for a committee under s 141(c)(4)` EQUALS JUST TRUE
-- #92 A quorum the text does not cover makes the act not covered.
#ASSERT `Did our committee or subcommittee carry the act at this meeting` 4 3 5 TRUE 1 `in the bylaws, for a committee under s 141(c)(4)` FALSE 0 `in none of these, for a committee under s 141(c)(4)` EQUALS NOTHING

§§ `Classes of directors, reliance, action without a meeting, meetings, removal (s 141(d) to (k))`
-- #93 The certificate divides the directors into three classes.
#ASSERT `May the directors of my corporation be divided into classes by this instrument` `the certificate of incorporation, under s 141(d)` 3 EQUALS TRUE
-- #93 A bylaw adopted by the stockholders: two classes.
#ASSERT `May the directors of my corporation be divided into classes by this instrument` `a bylaw adopted by a vote of the stockholders, under s 141(d)` 2 EQUALS TRUE
-- #93 A bylaw adopted by the directors alone is none of the three the text names.
#ASSERT `May the directors of my corporation be divided into classes by this instrument` `a bylaw adopted by the directors alone, under s 141(d)` 3 EQUALS FALSE
-- #93 Four classes are too many.
#ASSERT `May the directors of my corporation be divided into classes by this instrument` `the certificate of incorporation, under s 141(d)` 4 EQUALS FALSE
-- #94 The first class expires at the first annual meeting after classification, May 15, 2026.
#ASSERT `On what date does the term of my class of directors expire` 1 (YMD 2026 5 15) EQUALS JUST (YMD 2026 5 15)
-- #94 The second class, one year thereafter.
#ASSERT `On what date does the term of my class of directors expire` 2 (YMD 2026 5 15) EQUALS JUST (YMD 2027 5 15)
-- #94 The third class, two years thereafter.
#ASSERT `On what date does the term of my class of directors expire` 3 (YMD 2026 5 15) EQUALS JUST (YMD 2028 5 15)
-- #94 There is no fourth class: the text does not say.
#ASSERT `On what date does the term of my class of directors expire` 4 (YMD 2026 5 15) EQUALS NOTHING
-- #95 The provision authorizes the board to assign directors in office to the classes.
#ASSERT `May our board assign the directors already in office to the classes` TRUE EQUALS JUST TRUE
-- #95 It does not: the text does not say.
#ASSERT `May our board assign the directors already in office to the classes` FALSE EQUALS NOTHING
-- #96 The certificate confers the right to elect directors on a class of stock.
#ASSERT `May the holders of a class or series of our stock be given the right to elect directors in this way` `in the certificate of incorporation` EQUALS TRUE
-- #96 A bylaw cannot.
#ASSERT `May the holders of a class or series of our stock be given the right to elect directors in this way` `in the bylaws` EQUALS FALSE
-- #97 The certificate gives a director greater voting power.
#ASSERT `May a director of my corporation be given greater or lesser voting power than the other directors in this way` `in the certificate of incorporation` EQUALS TRUE
-- #97 A board resolution cannot.
#ASSERT `May a director of my corporation be given greater or lesser voting power than the other directors in this way` `in a resolution of the board of directors` EQUALS FALSE
-- #98 Nothing provides otherwise: the unequal votes apply in committee.
#ASSERT `Does a director's greater or lesser voting power apply to voting in a committee` `in none of these` EQUALS TRUE
-- #98 The bylaws provide otherwise.
#ASSERT `Does a director's greater or lesser voting power apply to voting in a committee` `in the bylaws` EQUALS FALSE
-- #99 The certificate gives some director two votes: proportions count votes.
#ASSERT `Do the Law's references to a majority or other proportion of the directors count the directors' votes in my corporation` TRUE EQUALS TRUE
-- #99 Every director has one vote.
#ASSERT `Do the Law's references to a majority or other proportion of the directors count the directors' votes in my corporation` FALSE EQUALS FALSE
-- #100 I relied in good faith on the corporation's records.
#ASSERT `Am I fully protected, as a director or committee member, in relying on this record or report` TRUE TRUE `the records of the corporation` FALSE FALSE EQUALS TRUE
-- #100 I relied in good faith on an outside adviser I reasonably believed expert and who was selected with care.
#ASSERT `Am I fully protected, as a director or committee member, in relying on this record or report` TRUE TRUE `information, opinions, reports or statements presented to the corporation by any other person` TRUE TRUE EQUALS TRUE
-- #100 The outside adviser was not selected with reasonable care.
#ASSERT `Am I fully protected, as a director or committee member, in relying on this record or report` TRUE TRUE `information, opinions, reports or statements presented to the corporation by any other person` TRUE FALSE EQUALS FALSE
-- #100 I did not rely in good faith.
#ASSERT `Am I fully protected, as a director or committee member, in relying on this record or report` TRUE FALSE `the records of the corporation` FALSE FALSE EQUALS FALSE
-- #100 I am not a director or committee member.
#ASSERT `Am I fully protected, as a director or committee member, in relying on this record or report` FALSE TRUE `the records of the corporation` FALSE FALSE EQUALS FALSE
-- #101 All five members of the board consent, documented as section 116 allows.
#ASSERT `May our board or committee act without a meeting` 5 5 TRUE `in none of these` EQUALS TRUE
-- #101 Four of five consent.
#ASSERT `May our board or committee act without a meeting` 5 4 TRUE `in none of these` EQUALS FALSE
-- #101 The bylaws restrict action without a meeting.
#ASSERT `May our board or committee act without a meeting` 5 5 TRUE `in the bylaws` EQUALS FALSE
-- #101 The consents are not documented as section 116 allows.
#ASSERT `May our board or committee act without a meeting` 5 5 FALSE `in none of these` EQUALS FALSE
-- #102 Instruction on January 1, 2026; effective March 2, 2026: the sixtieth day.
#ASSERT `Is my consent, effective at a future time, deemed given at that time` (YMD 2026 1 1) (YMD 2026 3 2) TRUE FALSE EQUALS TRUE
-- #102 Effective March 3, 2026: one day beyond sixty.
#ASSERT `Is my consent, effective at a future time, deemed given at that time` (YMD 2026 1 1) (YMD 2026 3 3) TRUE FALSE EQUALS FALSE
-- #102 I revoked the consent before it took effect.
#ASSERT `Is my consent, effective at a future time, deemed given at that time` (YMD 2026 1 1) (YMD 2026 2 1) TRUE TRUE EQUALS FALSE
-- #102 I am not a director at the effective time.
#ASSERT `Is my consent, effective at a future time, deemed given at that time` (YMD 2026 1 1) (YMD 2026 2 1) FALSE FALSE EQUALS FALSE
-- #103 My consent has not yet become effective: I may revoke it.
#ASSERT `May I still revoke my consent to board action without a meeting` FALSE EQUALS JUST TRUE
-- #103 It has become effective: the text does not say.
#ASSERT `May I still revoke my consent to board action without a meeting` TRUE EQUALS NOTHING
-- #104 The consents are filed with the minutes in the same form.
#ASSERT `Have the consents been filed as the Law requires after the board's action` TRUE TRUE EQUALS TRUE
-- #104 They are filed in a different form from the minutes.
#ASSERT `Have the consents been filed as the Law requires after the board's action` TRUE FALSE EQUALS FALSE
-- #105 No instrument restricts it: the board may meet and have offices outside Delaware.
#ASSERT `May our board hold its meetings, and have an office, outside Delaware` `in none of these` EQUALS TRUE
-- #105 The certificate restricts it.
#ASSERT `May our board hold its meetings, and have an office, outside Delaware` `in the certificate of incorporation` EQUALS FALSE
-- #106 No instrument restricts it: the board fixes directors' compensation.
#ASSERT `Does our board have the authority to fix the compensation of directors` `in none of these` EQUALS TRUE
-- #106 The bylaws restrict it.
#ASSERT `Does our board have the authority to fix the compensation of directors` `in the bylaws` EQUALS FALSE
-- #107 I join by conference telephone, everyone can hear, nothing restricts it.
#ASSERT `Does my participation in a board meeting by telephone count as being present in person` TRUE TRUE `in none of these` EQUALS TRUE
-- #107 Not everyone can hear everyone.
#ASSERT `Does my participation in a board meeting by telephone count as being present in person` TRUE FALSE `in none of these` EQUALS FALSE
-- #107 The certificate restricts participation by telephone.
#ASSERT `Does my participation in a board meeting by telephone count as being present in person` TRUE TRUE `in the certificate of incorporation` EQUALS FALSE
-- #108 Without cause, plain board, entire board: 501 of 1,000 shares vote to remove.
#ASSERT `May the stockholders remove this director from office` FALSE FALSE FALSE FALSE FALSE FALSE FALSE 1000 501 0 0 EQUALS JUST TRUE
-- #108 Exactly 500 of 1,000: not a majority.
#ASSERT `May the stockholders remove this director from office` FALSE FALSE FALSE FALSE FALSE FALSE FALSE 1000 500 0 0 EQUALS JUST FALSE
-- #108 A classified board, removal without cause, certificate silent.
#ASSERT `May the stockholders remove this director from office` FALSE TRUE FALSE FALSE FALSE FALSE FALSE 1000 800 0 0 EQUALS JUST FALSE
-- #108 A classified board, removal for cause.
#ASSERT `May the stockholders remove this director from office` TRUE TRUE FALSE FALSE FALSE FALSE FALSE 1000 800 0 0 EQUALS JUST TRUE
-- #108 A classified board whose certificate allows removal without cause.
#ASSERT `May the stockholders remove this director from office` FALSE TRUE TRUE FALSE FALSE FALSE FALSE 1000 800 0 0 EQUALS JUST TRUE
-- #108 Cumulative voting, one director, the votes against would elect the director, no cause.
#ASSERT `May the stockholders remove this director from office` FALSE FALSE FALSE TRUE TRUE TRUE FALSE 1000 800 0 0 EQUALS JUST FALSE
-- #108 Cumulative voting, one director, the votes against would not elect the director.
#ASSERT `May the stockholders remove this director from office` FALSE FALSE FALSE TRUE TRUE FALSE FALSE 1000 800 0 0 EQUALS JUST TRUE
-- #108 A director elected by a class, removed without cause: 51 of 100 class shares suffices though the whole vote does not.
#ASSERT `May the stockholders remove this director from office` FALSE FALSE FALSE FALSE FALSE FALSE TRUE 1000 100 100 51 EQUALS JUST TRUE
-- #108 A director elected by a class: 50 of 100 class shares is not a majority.
#ASSERT `May the stockholders remove this director from office` FALSE FALSE FALSE FALSE FALSE FALSE TRUE 1000 900 100 50 EQUALS JUST FALSE

§§ `Officers and loans to them (ss 142 and 143)`
-- #109 The officers' titles and duties are in the bylaws.
#ASSERT `Are the titles and duties of my corporation's officers stated as the Law requires` `in the bylaws` FALSE EQUALS JUST TRUE
-- #109 They are in a board resolution consistent with the bylaws.
#ASSERT `Are the titles and duties of my corporation's officers stated as the Law requires` `in a resolution of the board of directors` FALSE EQUALS JUST TRUE
-- #109 They are in a board resolution that contradicts the bylaws.
#ASSERT `Are the titles and duties of my corporation's officers stated as the Law requires` `in a resolution of the board of directors` TRUE EQUALS JUST FALSE
-- #109 They are stated only in the certificate: the text does not name that place.
#ASSERT `Are the titles and duties of my corporation's officers stated as the Law requires` `in the certificate of incorporation` FALSE EQUALS NOTHING
-- #109 They are stated nowhere.
#ASSERT `Are the titles and duties of my corporation's officers stated as the Law requires` `in none of these` FALSE EQUALS JUST FALSE
-- #110 Our officers can sign the instruments and stock certificates.
#ASSERT `Does my corporation have the officers it needs to sign instruments and stock certificates` TRUE EQUALS TRUE
-- #110 They cannot.
#ASSERT `Does my corporation have the officers it needs to sign instruments and stock certificates` FALSE EQUALS FALSE
-- #111 One officer records the proceedings.
#ASSERT `Does one of my corporation's officers have the duty to record the proceedings of the meetings of stockholders and directors` 1 EQUALS TRUE
-- #111 No officer does.
#ASSERT `Does one of my corporation's officers have the duty to record the proceedings of the meetings of stockholders and directors` 0 EQUALS FALSE
-- #112 Neither the certificate nor the bylaws limit it: one person may hold any number of offices.
#ASSERT `May one person hold any number of offices in my corporation` `in none of these` EQUALS TRUE
-- #112 The bylaws limit it.
#ASSERT `May one person hold any number of offices in my corporation` `in the bylaws` EQUALS FALSE
-- #112 The certificate limits it.
#ASSERT `May one person hold any number of offices in my corporation` `in the certificate of incorporation` EQUALS FALSE
-- #112 Only a board resolution limits it: the text does not recognise that.
#ASSERT `May one person hold any number of offices in my corporation` `in a resolution of the board of directors` EQUALS TRUE
-- #113 Our bylaws prescribe how officers are chosen and their terms.
#ASSERT `Are my corporation's officers chosen, and their terms fixed, as the Law provides` TRUE FALSE EQUALS TRUE
-- #113 The board determines both.
#ASSERT `Are my corporation's officers chosen, and their terms fixed, as the Law provides` FALSE TRUE EQUALS TRUE
-- #113 Neither does.
#ASSERT `Are my corporation's officers chosen, and their terms fixed, as the Law provides` FALSE FALSE EQUALS FALSE
-- #114 My successor has not qualified and I have neither resigned nor been removed.
#ASSERT `Do I still hold office as an officer of my corporation` FALSE FALSE FALSE EQUALS TRUE
-- #114 My successor has been elected and qualified.
#ASSERT `Do I still hold office as an officer of my corporation` TRUE FALSE FALSE EQUALS FALSE
-- #114 I have resigned.
#ASSERT `Do I still hold office as an officer of my corporation` FALSE TRUE FALSE EQUALS FALSE
-- #114 I have been removed.
#ASSERT `Do I still hold office as an officer of my corporation` FALSE FALSE TRUE EQUALS FALSE
-- #115 I gave written notice to the corporation.
#ASSERT `May I resign as an officer of my corporation` TRUE EQUALS JUST TRUE
-- #115 I gave no written notice: the text does not say how else.
#ASSERT `May I resign as an officer of my corporation` FALSE EQUALS NOTHING
-- #116 The person is an officer or agent.
#ASSERT `May my corporation secure the fidelity of this person by bond or otherwise` TRUE EQUALS JUST TRUE
-- #116 The person is neither: the text does not say.
#ASSERT `May my corporation secure the fidelity of this person by bond or otherwise` FALSE EQUALS NOTHING
-- #117 We have not elected officers: the corporation is not dissolved or affected.
#ASSERT `Does my corporation's failure to elect officers dissolve it or otherwise affect it` TRUE EQUALS FALSE
-- #117 We have elected officers.
#ASSERT `Does my corporation's failure to elect officers dissolve it or otherwise affect it` FALSE EQUALS FALSE
-- #118 The bylaws say how a vacancy is filled.
#ASSERT `Who fills a vacancy in an office of my corporation` TRUE EQUALS `as the bylaws provide`
-- #118 The bylaws are silent: the board fills it.
#ASSERT `Who fills a vacancy in an office of my corporation` FALSE EQUALS `the board of directors or other governing body`
-- #119 I am an officer and the directors judge the loan will benefit the corporation.
#ASSERT `May my corporation lend me money, guarantee my obligation or otherwise assist me, as an officer or employee` TRUE TRUE EQUALS TRUE
-- #119 The directors do not judge that it will benefit the corporation.
#ASSERT `May my corporation lend me money, guarantee my obligation or otherwise assist me, as an officer or employee` TRUE FALSE EQUALS FALSE
-- #119 I am neither an officer nor an employee.
#ASSERT `May my corporation lend me money, guarantee my obligation or otherwise assist me, as an officer or employee` FALSE TRUE EQUALS FALSE
-- #120 The loan bears interest.
#ASSERT `May a loan, guaranty or other assistance to an officer or employee be with or without interest` TRUE EQUALS TRUE
-- #120 It bears none.
#ASSERT `May a loan, guaranty or other assistance to an officer or employee be with or without interest` FALSE EQUALS TRUE
-- #121 The loan is unsecured.
#ASSERT `May a loan, guaranty or other assistance to an officer or employee be secured in this way` `unsecured` EQUALS TRUE
-- #121 It is secured by a pledge of the corporation's shares in a manner the board approves.
#ASSERT `May a loan, guaranty or other assistance to an officer or employee be secured in this way` `secured by a pledge of shares of stock of the corporation, a manner the board of directors approves` EQUALS TRUE
-- #121 It is secured in a manner the board has not approved.
#ASSERT `May a loan, guaranty or other assistance to an officer or employee be secured in this way` `secured in a manner the board of directors has not approved` EQUALS FALSE
-- #122 The corporation has the power of guaranty at common law: section 143 does not limit it.
#ASSERT `Does section 143 limit my corporation's powers of guaranty or warranty at common law or under a statute` TRUE EQUALS FALSE
-- #122 The power is not one it has elsewhere: section 143 still limits nothing.
#ASSERT `Does section 143 limit my corporation's powers of guaranty or warranty at common law or under a statute` FALSE EQUALS FALSE

§§ `Interested directors and officers; controlling stockholders (s 144)`
-- #123 Not a section 251(h) offer: the votes actually cast count.
#ASSERT (`How many votes are counted as cast, and as cast in favor, when disinterested stockholders' shares are tendered in an offer under section 251(h)` FALSE 100 60 0 0)'s `the votes counted as cast` EQUALS 100
-- #123 Not a section 251(h) offer: the votes actually cast in favor count.
#ASSERT (`How many votes are counted as cast, and as cast in favor, when disinterested stockholders' shares are tendered in an offer under section 251(h)` FALSE 100 60 0 0)'s `the votes counted as cast in favor` EQUALS 60
-- #123 A section 251(h) offer: accepted shares and shares not accepted are all deemed cast.
#ASSERT (`How many votes are counted as cast, and as cast in favor, when disinterested stockholders' shares are tendered in an offer under section 251(h)` TRUE 0 0 700 300)'s `the votes counted as cast` EQUALS 1000
-- #123 A section 251(h) offer: only the accepted shares are deemed in favor.
#ASSERT (`How many votes are counted as cast, and as cast in favor, when disinterested stockholders' shares are tendered in an offer under section 251(h)` TRUE 0 0 700 300)'s `the votes counted as cast in favor` EQUALS 700
