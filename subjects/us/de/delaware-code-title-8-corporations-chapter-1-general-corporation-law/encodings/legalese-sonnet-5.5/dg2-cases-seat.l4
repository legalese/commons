-- #126 The disinterested stockholders approved it by an informed, uncoerced majority.
#ASSERT `Is an act or transaction in which a director or officer is interested protected from equitable relief and damages` TRUE FALSE FALSE FALSE FALSE FALSE 0 0 5 3 FALSE FALSE TRUE TRUE 100 80 0 0 FALSE EQUALS JUST TRUE
-- #126 A controlling stockholder transaction: subsections (b) and (c) govern.
#ASSERT `Is an act or transaction in which a director or officer is interested protected from equitable relief and damages` TRUE FALSE TRUE TRUE TRUE TRUE 3 2 5 3 FALSE FALSE FALSE FALSE 0 0 0 0 TRUE EQUALS NOTHING
-- #126 No director or officer is on the other side: the text does not say.
#ASSERT `Is an act or transaction in which a director or officer is interested protected from equitable relief and damages` FALSE FALSE FALSE TRUE TRUE TRUE 3 2 5 3 FALSE FALSE FALSE FALSE 0 0 0 0 TRUE EQUALS NOTHING
-- #127 Disclosed, delegated, good faith, two of three disinterested committee members approved.
#ASSERT `Did a committee of disinterested directors approve the controlling stockholder transaction as the Law requires` TRUE TRUE TRUE TRUE 3 2 TRUE EQUALS JUST TRUE
-- #127 Only one of three approved.
#ASSERT `Did a committee of disinterested directors approve the controlling stockholder transaction as the Law requires` TRUE TRUE TRUE TRUE 3 1 TRUE EQUALS JUST FALSE
-- #127 The board did not delegate the authority to negotiate and reject.
#ASSERT `Did a committee of disinterested directors approve the controlling stockholder transaction as the Law requires` TRUE FALSE TRUE TRUE 3 3 TRUE EQUALS JUST FALSE
-- #127 The committee is not two or more determined disinterested directors.
#ASSERT `Did a committee of disinterested directors approve the controlling stockholder transaction as the Law requires` TRUE TRUE TRUE TRUE 3 3 FALSE EQUALS JUST FALSE
-- #128 Conditioned on disinterested stockholders' approval; informed, uncoerced, 60 of 100 in favor.
#ASSERT `Did the disinterested stockholders approve the controlling stockholder transaction, as its terms conditioned, by an informed, uncoerced majority of the votes cast` TRUE FALSE TRUE TRUE 100 60 0 0 EQUALS JUST TRUE
-- #128 Not conditioned on their approval.
#ASSERT `Did the disinterested stockholders approve the controlling stockholder transaction, as its terms conditioned, by an informed, uncoerced majority of the votes cast` FALSE FALSE TRUE TRUE 100 60 0 0 EQUALS JUST FALSE
-- #128 Conditioned, but only 50 of 100 in favor.
#ASSERT `Did the disinterested stockholders approve the controlling stockholder transaction, as its terms conditioned, by an informed, uncoerced majority of the votes cast` TRUE FALSE TRUE TRUE 100 50 0 0 EQUALS JUST FALSE
-- #128 A section 251(h) offer with 700 of 1,000 shares accepted.
#ASSERT `Did the disinterested stockholders approve the controlling stockholder transaction, as its terms conditioned, by an informed, uncoerced majority of the votes cast` TRUE TRUE TRUE TRUE 0 0 700 300 EQUALS JUST TRUE
-- #129 A controlling stockholder transaction (not going private) approved by the committee.
#ASSERT `Is a controlling stockholder transaction that is not a going private transaction protected from equitable relief and damages on a fiduciary claim` TRUE FALSE TRUE TRUE TRUE TRUE 3 2 TRUE FALSE FALSE FALSE FALSE 0 0 0 0 FALSE EQUALS JUST TRUE
-- #129 Approved only by the disinterested stockholders as the terms conditioned.
#ASSERT `Is a controlling stockholder transaction that is not a going private transaction protected from equitable relief and damages on a fiduciary claim` TRUE FALSE FALSE FALSE FALSE FALSE 0 0 FALSE TRUE FALSE TRUE TRUE 100 60 0 0 FALSE EQUALS JUST TRUE
-- #129 Approved by no one but fair.
#ASSERT `Is a controlling stockholder transaction that is not a going private transaction protected from equitable relief and damages on a fiduciary claim` TRUE FALSE FALSE FALSE FALSE FALSE 0 0 FALSE FALSE FALSE FALSE FALSE 0 0 0 0 TRUE EQUALS JUST TRUE
-- #129 Approved by no one and not fair.
#ASSERT `Is a controlling stockholder transaction that is not a going private transaction protected from equitable relief and damages on a fiduciary claim` TRUE FALSE FALSE FALSE FALSE FALSE 0 0 FALSE FALSE FALSE FALSE FALSE 0 0 0 0 FALSE EQUALS JUST FALSE
-- #129 It is a going private transaction: subsection (c) governs.
#ASSERT `Is a controlling stockholder transaction that is not a going private transaction protected from equitable relief and damages on a fiduciary claim` TRUE TRUE TRUE TRUE TRUE TRUE 3 2 TRUE TRUE FALSE TRUE TRUE 100 60 0 0 TRUE EQUALS NOTHING
-- #129 It is not a controlling stockholder transaction.
#ASSERT `Is a controlling stockholder transaction that is not a going private transaction protected from equitable relief and damages on a fiduciary claim` FALSE FALSE TRUE TRUE TRUE TRUE 3 2 TRUE TRUE FALSE TRUE TRUE 100 60 0 0 TRUE EQUALS NOTHING
-- #130 A going private transaction approved by the committee AND by the disinterested stockholders.
#ASSERT `Is a going private transaction protected from equitable relief and damages on a fiduciary claim` TRUE TRUE TRUE TRUE TRUE TRUE 3 2 TRUE TRUE FALSE TRUE TRUE 100 60 0 0 FALSE EQUALS JUST TRUE
-- #130 Approved by the committee only, not fair.
#ASSERT `Is a going private transaction protected from equitable relief and damages on a fiduciary claim` TRUE TRUE TRUE TRUE TRUE TRUE 3 2 TRUE FALSE FALSE FALSE FALSE 0 0 0 0 FALSE EQUALS JUST FALSE
-- #130 Approved by the disinterested stockholders only, not fair.
#ASSERT `Is a going private transaction protected from equitable relief and damages on a fiduciary claim` TRUE TRUE FALSE FALSE FALSE FALSE 0 0 FALSE TRUE FALSE TRUE TRUE 100 60 0 0 FALSE EQUALS JUST FALSE
-- #130 Approved by no one but fair.
#ASSERT `Is a going private transaction protected from equitable relief and damages on a fiduciary claim` TRUE TRUE FALSE FALSE FALSE FALSE 0 0 FALSE FALSE FALSE FALSE FALSE 0 0 0 0 TRUE EQUALS JUST TRUE
-- #130 It is not a going private transaction: subsection (b) governs.
#ASSERT `Is a going private transaction protected from equitable relief and damages on a fiduciary claim` TRUE FALSE TRUE TRUE TRUE TRUE 3 2 TRUE TRUE FALSE TRUE TRUE 100 60 0 0 TRUE EQUALS NOTHING
-- #130 It is not a controlling stockholder transaction.
#ASSERT `Is a going private transaction protected from equitable relief and damages on a fiduciary claim` FALSE TRUE TRUE TRUE TRUE TRUE 3 2 TRUE TRUE FALSE TRUE TRUE 100 60 0 0 TRUE EQUALS NOTHING
-- #131 The meeting of the board authorizes the act or transaction.
#ASSERT `May interested directors be counted in determining the presence of a quorum at the meeting that authorizes the act or transaction` TRUE EQUALS JUST TRUE
-- #131 Any other meeting: the text does not say.
#ASSERT `May interested directors be counted in determining the presence of a quorum at the meeting that authorizes the act or transaction` FALSE EQUALS NOTHING
-- #132 Our stock is listed, I am not a party, the board found me independent.
#ASSERT `Is this director presumed to be a disinterested director because the corporation's stock is listed` TRUE FALSE TRUE EQUALS TRUE
-- #132 I am a party to the transaction.
#ASSERT `Is this director presumed to be a disinterested director because the corporation's stock is listed` TRUE TRUE TRUE EQUALS FALSE
-- #132 Our stock is not listed.
#ASSERT `Is this director presumed to be a disinterested director because the corporation's stock is listed` FALSE FALSE TRUE EQUALS FALSE
-- #132 The board has not found me independent.
#ASSERT `Is this director presumed to be a disinterested director because the corporation's stock is listed` TRUE FALSE FALSE EQUALS FALSE
-- #133 Substantial and particularized facts show a material interest.
#ASSERT `Is the presumption that this director is disinterested rebutted` TRUE FALSE EQUALS TRUE
-- #133 Substantial and particularized facts show a material relationship.
#ASSERT `Is the presumption that this director is disinterested rebutted` FALSE TRUE EQUALS TRUE
-- #133 No such facts.
#ASSERT `Is the presumption that this director is disinterested rebutted` FALSE FALSE EQUALS FALSE
-- #134 A person with a material interest nominated the director: not of itself evidence.
#ASSERT `Is it evidence that a director is not disinterested that a person with a material interest designated, nominated or voted for the director` TRUE EQUALS FALSE
-- #134 No such nomination.
#ASSERT `Is it evidence that a director is not disinterested that a person with a material interest designated, nominated or voted for the director` FALSE EQUALS FALSE
-- #135 I own 60 of 100 votes in the election of directors.
#ASSERT `May I be deemed a controlling stockholder` 60 100 FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- #135 I own 50 of 100: not a majority, and nothing else applies.
#ASSERT `May I be deemed a controlling stockholder` 50 100 FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- #135 I own 34 of 100 and can exercise managerial authority.
#ASSERT `May I be deemed a controlling stockholder` 34 100 FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- #135 I own 33 of 100 and can exercise managerial authority: under one third.
#ASSERT `May I be deemed a controlling stockholder` 33 100 FALSE FALSE FALSE TRUE EQUALS JUST FALSE
-- #135 I own 40 of 100 but have no managerial authority.
#ASSERT `May I be deemed a controlling stockholder` 40 100 FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- #135 I can cause the election of a majority of the board by contract.
#ASSERT `May I be deemed a controlling stockholder` 10 100 FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- #135 I control a majority of the directors' votes.
#ASSERT `May I be deemed a controlling stockholder` 10 100 TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- #135 The total voting power is nil: the numbers cannot be a vote.
#ASSERT `May I be deemed a controlling stockholder` 0 0 FALSE FALSE FALSE FALSE EQUALS NOTHING
-- #136 Two of us, neither a controlling stockholder alone, bound together and together controlling.
#ASSERT `Are we, 2 or more stockholders, a control group` 2 TRUE TRUE TRUE EQUALS TRUE
-- #136 One person alone.
#ASSERT `Are we, 2 or more stockholders, a control group` 1 TRUE TRUE TRUE EQUALS FALSE
-- #136 One of us is a controlling stockholder already.
#ASSERT `Are we, 2 or more stockholders, a control group` 2 FALSE TRUE TRUE EQUALS FALSE
-- #136 We have no agreement or understanding.
#ASSERT `Are we, 2 or more stockholders, a control group` 2 TRUE FALSE TRUE EQUALS FALSE
-- #136 Together we are not a controlling stockholder.
#ASSERT `Are we, 2 or more stockholders, a control group` 2 TRUE TRUE FALSE EQUALS FALSE
-- #137 The transaction is between the corporation and a controlling stockholder.
#ASSERT `Is this act or transaction a controlling stockholder transaction` TRUE FALSE EQUALS TRUE
-- #137 A controlling stockholder gets a benefit not shared with stockholders generally.
#ASSERT `Is this act or transaction a controlling stockholder transaction` FALSE TRUE EQUALS TRUE
-- #137 Neither.
#ASSERT `Is this act or transaction a controlling stockholder transaction` FALSE FALSE EQUALS FALSE
-- #138 A listed corporation and a Rule 13e-3 transaction.
#ASSERT `Is this transaction a going private transaction` TRUE TRUE FALSE FALSE EQUALS TRUE
-- #138 A listed corporation: only a Rule 13e-3 transaction counts, whatever else.
#ASSERT `Is this transaction a going private transaction` TRUE FALSE TRUE TRUE EQUALS FALSE
-- #138 An unlisted corporation: a controlling stockholder transaction taking out the disinterested stockholders.
#ASSERT `Is this transaction a going private transaction` FALSE FALSE TRUE TRUE EQUALS TRUE
-- #138 An unlisted corporation: a controlling stockholder transaction that leaves the disinterested stockholders' shares.
#ASSERT `Is this transaction a going private transaction` FALSE FALSE TRUE FALSE EQUALS FALSE
-- #139 I am not a party and have no material interest or relationship.
#ASSERT `Am I a disinterested director with respect to this act or transaction` FALSE FALSE FALSE EQUALS TRUE
-- #139 I am a party.
#ASSERT `Am I a disinterested director with respect to this act or transaction` TRUE FALSE FALSE EQUALS FALSE
-- #139 I have a material interest.
#ASSERT `Am I a disinterested director with respect to this act or transaction` FALSE TRUE FALSE EQUALS FALSE
-- #139 I have a material relationship with a person who has a material interest.
#ASSERT `Am I a disinterested director with respect to this act or transaction` FALSE FALSE TRUE EQUALS FALSE
-- #140 I have no material interest and no material relationship.
#ASSERT `Am I a disinterested stockholder with respect to this act or transaction` FALSE TRUE FALSE EQUALS TRUE
-- #140 I have a material interest.
#ASSERT `Am I a disinterested stockholder with respect to this act or transaction` TRUE TRUE FALSE EQUALS FALSE
-- #140 A controlling stockholder is involved and I have a material relationship with them.
#ASSERT `Am I a disinterested stockholder with respect to this act or transaction` FALSE TRUE TRUE EQUALS FALSE
-- #140 No controlling stockholder or interested person is involved: the relationship limb does not apply.
#ASSERT `Am I a disinterested stockholder with respect to this act or transaction` FALSE FALSE TRUE EQUALS TRUE
-- #141 I am a director; the benefit is mine alone and would impair my objectivity.
#ASSERT `Does this benefit give me a material interest in the act or transaction` `a director, for the purposes of s 144(e)(7) and (8)` TRUE FALSE TRUE FALSE EQUALS TRUE
-- #141 I am a director; the benefit would devolve on all stockholders.
#ASSERT `Does this benefit give me a material interest in the act or transaction` `a director, for the purposes of s 144(e)(7) and (8)` TRUE TRUE TRUE FALSE EQUALS FALSE
-- #141 I am a director; the benefit would not impair my objectivity, though it would be material to me.
#ASSERT `Does this benefit give me a material interest in the act or transaction` `a director, for the purposes of s 144(e)(7) and (8)` TRUE FALSE FALSE TRUE EQUALS FALSE
-- #141 I am a stockholder; the benefit would be material to me.
#ASSERT `Does this benefit give me a material interest in the act or transaction` `a stockholder, for the purposes of s 144(e)(7) and (8)` TRUE FALSE FALSE TRUE EQUALS TRUE
-- #141 I am another person; the benefit would not be material to me.
#ASSERT `Does this benefit give me a material interest in the act or transaction` `a person other than a director or stockholder, for the purposes of s 144(e)(7) and (8)` TRUE FALSE FALSE FALSE EQUALS FALSE
-- #141 There is no benefit.
#ASSERT `Does this benefit give me a material interest in the act or transaction` `a director, for the purposes of s 144(e)(7) and (8)` FALSE FALSE TRUE TRUE EQUALS FALSE
-- #142 I am a director; the relationship would impair my objectivity.
#ASSERT `Does this relationship give me a material relationship with the person` `a director, for the purposes of s 144(e)(7) and (8)` TRUE FALSE EQUALS JUST TRUE
-- #142 I am a stockholder; the relationship would not be material to me.
#ASSERT `Does this relationship give me a material relationship with the person` `a stockholder, for the purposes of s 144(e)(7) and (8)` TRUE FALSE EQUALS JUST FALSE
-- #142 I am neither a director nor a stockholder: the definition does not say.
#ASSERT `Does this relationship give me a material relationship with the person` `a person other than a director or stockholder, for the purposes of s 144(e)(7) and (8)` TRUE TRUE EQUALS NOTHING
-- #143 I am a controlling stockholder: a breach of the duty of loyalty.
#ASSERT `Am I shielded from monetary damages as a controlling stockholder or member of a control group for this kind of breach of fiduciary duty` TRUE `a breach of the duty of loyalty to the corporation or the other stockholders` EQUALS JUST FALSE
-- #143 I am a controlling stockholder: a transaction from which I derived an improper personal benefit.
#ASSERT `Am I shielded from monetary damages as a controlling stockholder or member of a control group for this kind of breach of fiduciary duty` TRUE `a transaction from which the person derived an improper personal benefit` EQUALS JUST FALSE
-- #143 I am a controlling stockholder: acts not in good faith.
#ASSERT `Am I shielded from monetary damages as a controlling stockholder or member of a control group for this kind of breach of fiduciary duty` TRUE `acts or omissions not in good faith or which involve intentional misconduct or a knowing violation of law` EQUALS JUST FALSE
-- #143 I am a controlling stockholder: a breach of fiduciary duty of any other kind.
#ASSERT `Am I shielded from monetary damages as a controlling stockholder or member of a control group for this kind of breach of fiduciary duty` TRUE `a breach of fiduciary duty of any other kind` EQUALS JUST TRUE
-- #143 I am neither a controlling stockholder nor a member of a control group.
#ASSERT `Am I shielded from monetary damages as a controlling stockholder or member of a control group for this kind of breach of fiduciary duty` FALSE `a breach of fiduciary duty of any other kind` EQUALS NOTHING
-- #144 The ground is that the act was not authorized in compliance with the chapter.
#ASSERT `Can I still seek relief on this ground even if the act or transaction was approved under section 144(a), (b) or (c)` `that the act or transaction was not authorized or approved in compliance with the procedures set forth in this chapter` EQUALS JUST TRUE
-- #144 The ground is aiding and abetting a breach of fiduciary duty.
#ASSERT `Can I still seek relief on this ground even if the act or transaction was approved under section 144(a), (b) or (c)` `that a stockholder or other person knowingly aided and abetted a breach of fiduciary duty by 1 or more of the directors` EQUALS JUST TRUE
-- #144 A ground of any other kind: the text does not say.
#ASSERT `Can I still seek relief on this ground even if the act or transaction was approved under section 144(a), (b) or (c)` `a ground of any other kind` EQUALS NOTHING

§§ `Indemnification and insurance (s 145)`
-- #145 A civil suit by a third party; I am sued as a director; expenses; I acted in good faith and reasonably believed my act in the corporation's interest.
#ASSERT `May my corporation indemnify me against this amount in a proceeding that is not by or in the right of the corporation` TRUE FALSE TRUE `expenses (including attorneys' fees)` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- #145 A judgment in a civil suit, same facts.
#ASSERT `May my corporation indemnify me against this amount in a proceeding that is not by or in the right of the corporation` TRUE FALSE TRUE `judgments` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- #145 The suit is by or in the right of the corporation: subsection (b) governs.
#ASSERT `May my corporation indemnify me against this amount in a proceeding that is not by or in the right of the corporation` TRUE TRUE TRUE `expenses (including attorneys' fees)` TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
-- #145 I did not act in good faith.
#ASSERT `May my corporation indemnify me against this amount in a proceeding that is not by or in the right of the corporation` TRUE FALSE TRUE `expenses (including attorneys' fees)` TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
-- #145 A criminal proceeding and I had reasonable cause to believe my conduct unlawful.
#ASSERT `May my corporation indemnify me against this amount in a proceeding that is not by or in the right of the corporation` TRUE FALSE TRUE `expenses (including attorneys' fees)` TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- #145 A criminal proceeding and I had no reasonable cause to believe my conduct unlawful.
#ASSERT `May my corporation indemnify me against this amount in a proceeding that is not by or in the right of the corporation` TRUE FALSE TRUE `expenses (including attorneys' fees)` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- #145 The proceeding is not by reason of my role in the corporation.
#ASSERT `May my corporation indemnify me against this amount in a proceeding that is not by or in the right of the corporation` TRUE FALSE FALSE `expenses (including attorneys' fees)` TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
-- #145 An amount of any other kind: the text does not say.
#ASSERT `May my corporation indemnify me against this amount in a proceeding that is not by or in the right of the corporation` TRUE FALSE TRUE `an amount of any other kind` TRUE TRUE TRUE FALSE FALSE EQUALS NOTHING
-- #146 It ended by judgment: that does not of itself create the presumption.
#ASSERT `Does the way the proceeding ended, of itself, create a presumption that I did not act in good faith` `by judgment` EQUALS JUST FALSE
-- #146 It ended upon a plea of nolo contendere.
#ASSERT `Does the way the proceeding ended, of itself, create a presumption that I did not act in good faith` `upon a plea of nolo contendere or its equivalent` EQUALS JUST FALSE
-- #146 It ended by conviction.
#ASSERT `Does the way the proceeding ended, of itself, create a presumption that I did not act in good faith` `by conviction` EQUALS JUST FALSE
-- #146 It ended in any other way: the text does not say.
#ASSERT `Does the way the proceeding ended, of itself, create a presumption that I did not act in good faith` `in any other way` EQUALS NOTHING
-- #147 A derivative suit; I acted in good faith; my expenses were 1,000; no adjudication of liability.
#ASSERT `May my corporation indemnify me against my expenses in an action or suit by or in the right of the corporation` TRUE TRUE 1000 TRUE TRUE FALSE FALSE 0 EQUALS TRUE
-- #147 I was adjudged liable to the corporation and no court has found me fairly entitled.
#ASSERT `May my corporation indemnify me against my expenses in an action or suit by or in the right of the corporation` TRUE TRUE 1000 TRUE TRUE TRUE FALSE 0 EQUALS FALSE
-- #147 I was adjudged liable but the court found me fairly entitled to 300.
#ASSERT `May my corporation indemnify me against my expenses in an action or suit by or in the right of the corporation` TRUE TRUE 1000 TRUE TRUE TRUE TRUE 300 EQUALS TRUE
-- #147 I did not act in good faith.
#ASSERT `May my corporation indemnify me against my expenses in an action or suit by or in the right of the corporation` TRUE TRUE 1000 FALSE TRUE FALSE FALSE 0 EQUALS FALSE
-- #148 No adjudication: all 1,000 of my expenses.
#ASSERT `What is the most my corporation may indemnify me against in an action or suit by or in the right of the corporation` TRUE TRUE 1000 TRUE TRUE FALSE FALSE 0 EQUALS 1000
-- #148 Adjudged liable but the court deemed 300 proper: no more than 300.
#ASSERT `What is the most my corporation may indemnify me against in an action or suit by or in the right of the corporation` TRUE TRUE 1000 TRUE TRUE TRUE TRUE 300 EQUALS 300
-- #148 Adjudged liable and the court deemed 1,500 proper: no more than my 1,000 of expenses.
#ASSERT `What is the most my corporation may indemnify me against in an action or suit by or in the right of the corporation` TRUE TRUE 1000 TRUE TRUE TRUE TRUE 1500 EQUALS 1000
-- #148 Adjudged liable and no court has found me fairly entitled: nothing.
#ASSERT `What is the most my corporation may indemnify me against in an action or suit by or in the right of the corporation` TRUE TRUE 1000 TRUE TRUE TRUE FALSE 0 EQUALS 0
-- #148 I did not act in good faith: nothing.
#ASSERT `What is the most my corporation may indemnify me against in an action or suit by or in the right of the corporation` TRUE TRUE 1000 FALSE TRUE FALSE FALSE 0 EQUALS 0
-- #149 I am a director and I succeeded on the merits.
#ASSERT `Must my corporation indemnify me against the expenses of my defense because I was successful` TRUE FALSE (YMD 2026 1 1) FALSE TRUE 5000 EQUALS TRUE
-- #149 I was successful, but I am not a director.
#ASSERT `Must my corporation indemnify me against the expenses of my defense because I was successful` FALSE FALSE (YMD 2026 1 1) FALSE TRUE 5000 EQUALS FALSE
-- #149 I am an officer; the act was on December 31, 2020.
#ASSERT `Must my corporation indemnify me against the expenses of my defense because I was successful` FALSE TRUE (YMD 2020 12 31) FALSE TRUE 5000 EQUALS TRUE
-- #149 I am an officer; the act was on January 1, 2021 and I am not deemed to have consented to service.
#ASSERT `Must my corporation indemnify me against the expenses of my defense because I was successful` FALSE TRUE (YMD 2021 1 1) FALSE TRUE 5000 EQUALS FALSE
-- #149 I am an officer; the act was in 2021 and I am deemed to have consented to service.
#ASSERT `Must my corporation indemnify me against the expenses of my defense because I was successful` FALSE TRUE (YMD 2021 6 1) TRUE TRUE 5000 EQUALS TRUE
-- #149 I was not successful.
#ASSERT `Must my corporation indemnify me against the expenses of my defense because I was successful` TRUE FALSE (YMD 2026 1 1) FALSE FALSE 5000 EQUALS FALSE
-- #150 A director, successful: all 5,000.
#ASSERT `How much must my corporation indemnify me for the expenses of my defense because I was successful` TRUE FALSE (YMD 2026 1 1) FALSE TRUE 5000 EQUALS 5000
-- #150 A director who was not successful: nothing is owed.
#ASSERT `How much must my corporation indemnify me for the expenses of my defense because I was successful` TRUE FALSE (YMD 2026 1 1) FALSE FALSE 5000 EQUALS 0
-- #150 An officer for an act in 2021 who did not consent to service: nothing is owed.
#ASSERT `How much must my corporation indemnify me for the expenses of my defense because I was successful` FALSE TRUE (YMD 2021 6 1) FALSE TRUE 5000 EQUALS 0
-- #151 An employee, neither director nor officer, was successful.
#ASSERT `May my corporation indemnify me against the expenses of my defense because I was successful, though I am not a director or an officer within section 145(c)(1)` FALSE FALSE (YMD 2026 1 1) FALSE TRUE EQUALS TRUE
-- #151 A director: paragraph (c)(1) governs.
#ASSERT `May my corporation indemnify me against the expenses of my defense because I was successful, though I am not a director or an officer within section 145(c)(1)` TRUE FALSE (YMD 2026 1 1) FALSE TRUE EQUALS FALSE
-- #151 An officer for an act in 2021 not deemed to have consented: not an officer for (c)(1), so the corporation may.
#ASSERT `May my corporation indemnify me against the expenses of my defense because I was successful, though I am not a director or an officer within section 145(c)(1)` FALSE TRUE (YMD 2021 6 1) FALSE TRUE EQUALS TRUE
-- #151 An employee who was not successful.
#ASSERT `May my corporation indemnify me against the expenses of my defense because I was successful, though I am not a director or an officer within section 145(c)(1)` FALSE FALSE (YMD 2026 1 1) FALSE FALSE EQUALS FALSE
-- #152 A court ordered the indemnification.
#ASSERT `May my corporation make the indemnification under subsection (a) or (b) in my case` TRUE TRUE FALSE FALSE `someone else` FALSE FALSE FALSE EQUALS TRUE
-- #152 I am a former director; the determination was made in my case and found I met the standard.
#ASSERT `May my corporation make the indemnification under subsection (a) or (b) in my case` FALSE FALSE TRUE TRUE `someone else` FALSE FALSE FALSE EQUALS TRUE
-- #152 I am a director; the non-party directors by majority vote found I met the standard.
#ASSERT `May my corporation make the indemnification under subsection (a) or (b) in my case` FALSE TRUE TRUE TRUE `a majority vote of the directors who are not parties to the action, suit or proceeding, even though less than a quorum` FALSE FALSE FALSE EQUALS TRUE
-- #152 I am a director; a committee designated by the non-party directors found it.
#ASSERT `May my corporation make the indemnification under subsection (a) or (b) in my case` FALSE TRUE TRUE TRUE `a committee of such directors designated by majority vote of such directors, even though less than a quorum` TRUE FALSE FALSE EQUALS TRUE
-- #152 The committee was not designated by the non-party directors.
#ASSERT `May my corporation make the indemnification under subsection (a) or (b) in my case` FALSE TRUE TRUE TRUE `a committee of such directors designated by majority vote of such directors, even though less than a quorum` FALSE FALSE FALSE EQUALS FALSE
-- #152 Independent legal counsel, at the direction of the non-party directors.
#ASSERT `May my corporation make the indemnification under subsection (a) or (b) in my case` FALSE TRUE TRUE TRUE `independent legal counsel in a written opinion` FALSE FALSE TRUE EQUALS TRUE
-- #152 Independent legal counsel because there are no non-party directors.
#ASSERT `May my corporation make the indemnification under subsection (a) or (b) in my case` FALSE TRUE TRUE TRUE `independent legal counsel in a written opinion` FALSE TRUE FALSE EQUALS TRUE
-- #152 Independent legal counsel of its own motion.
#ASSERT `May my corporation make the indemnification under subsection (a) or (b) in my case` FALSE TRUE TRUE TRUE `independent legal counsel in a written opinion` FALSE FALSE FALSE EQUALS FALSE
-- #152 The stockholders decided.
#ASSERT `May my corporation make the indemnification under subsection (a) or (b) in my case` FALSE TRUE TRUE TRUE `the stockholders` FALSE FALSE FALSE EQUALS TRUE
-- #152 Someone else decided, and I am a director.
#ASSERT `May my corporation make the indemnification under subsection (a) or (b) in my case` FALSE TRUE TRUE TRUE `someone else` FALSE FALSE FALSE EQUALS FALSE
-- #152 No determination was made in my specific case.
#ASSERT `May my corporation make the indemnification under subsection (a) or (b) in my case` FALSE TRUE FALSE TRUE `a majority vote of the directors who are not parties to the action, suit or proceeding, even though less than a quorum` FALSE FALSE FALSE EQUALS FALSE
-- #152 The determination is that I did not meet the standard.
#ASSERT `May my corporation make the indemnification under subsection (a) or (b) in my case` FALSE TRUE TRUE FALSE `a majority vote of the directors who are not parties to the action, suit or proceeding, even though less than a quorum` FALSE FALSE FALSE EQUALS FALSE
-- #153 I am a present director, defending a suit, and the corporation has my undertaking to repay.
#ASSERT `May my corporation pay my expenses of defending the proceeding before its final disposition` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
-- #153 I am a present director and have given no undertaking.
#ASSERT `May my corporation pay my expenses of defending the proceeding before its final disposition` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
-- #153 I am a former director, defending a suit: no undertaking is required by the text.
#ASSERT `May my corporation pay my expenses of defending the proceeding before its final disposition` FALSE TRUE TRUE FALSE EQUALS JUST TRUE
-- #153 The expenses are not for defending a proceeding: the text does not say.
#ASSERT `May my corporation pay my expenses of defending the proceeding before its final disposition` TRUE FALSE FALSE TRUE EQUALS NOTHING
-- #153 I am in neither class: the text does not say.
#ASSERT `May my corporation pay my expenses of defending the proceeding before its final disposition` FALSE FALSE TRUE TRUE EQUALS NOTHING
-- #154 I have another right under a bylaw or agreement: section 145 is not exclusive.
#ASSERT `Are my rights to indemnification and advancement under section 145 the only ones I have` TRUE EQUALS FALSE
-- #154 I have none: still not exclusive of other rights I might have.
#ASSERT `Are my rights to indemnification and advancement under section 145 the only ones I have` FALSE EQUALS FALSE
-- #155 My right is in the certificate; it was amended after the act, and the provision did not authorize impairment.
#ASSERT `Is my right to indemnification or advancement protected from later elimination or impairment` `in the certificate of incorporation` (YMD 2026 1 1) (YMD 2026 6 1) FALSE EQUALS TRUE
-- #155 It is in the bylaws; same facts.
#ASSERT `Is my right to indemnification or advancement protected from later elimination or impairment` `in the bylaws` (YMD 2026 1 1) (YMD 2026 6 1) FALSE EQUALS TRUE
-- #155 The amendment came before the act: not protected by this rule.
#ASSERT `Is my right to indemnification or advancement protected from later elimination or impairment` `in the certificate of incorporation` (YMD 2026 1 1) (YMD 2025 12 31) FALSE EQUALS FALSE
-- #155 The amendment is dated the same day as the act: not later.
#ASSERT `Is my right to indemnification or advancement protected from later elimination or impairment` `in the certificate of incorporation` (YMD 2026 1 1) (YMD 2026 1 1) FALSE EQUALS FALSE
-- #155 The provision in effect at the act explicitly authorized later impairment.
#ASSERT `Is my right to indemnification or advancement protected from later elimination or impairment` `in the certificate of incorporation` (YMD 2026 1 1) (YMD 2026 6 1) TRUE EQUALS FALSE
-- #155 The right is given only by a board resolution.
#ASSERT `Is my right to indemnification or advancement protected from later elimination or impairment` `in a resolution of the board of directors` (YMD 2026 1 1) (YMD 2026 6 1) FALSE EQUALS FALSE
-- #156 I am a director: the corporation may buy insurance for me even if it could not indemnify me.
#ASSERT `May my corporation buy insurance on my behalf for liability asserted against me because of my role` TRUE FALSE EQUALS JUST TRUE
-- #156 I am a director and it could indemnify me.
#ASSERT `May my corporation buy insurance on my behalf for liability asserted against me because of my role` TRUE TRUE EQUALS JUST TRUE
-- #156 I am nobody in the corporation: the text does not say.
#ASSERT `May my corporation buy insurance on my behalf for liability asserted against me because of my role` FALSE TRUE EQUALS NOTHING
-- #157 Ordinary insurance, not through a captive.
#ASSERT `Does insurance through a captive insurance company count as insurance for section 145(g)` FALSE FALSE FALSE FALSE FALSE EQUALS TRUE
-- #157 Through a licensed captive that meets all four terms.
#ASSERT `Does insurance through a captive insurance company count as insurance for section 145(g)` TRUE TRUE TRUE TRUE TRUE EQUALS TRUE
-- #157 Through a captive whose terms omit the notice to stockholders.
#ASSERT `Does insurance through a captive insurance company count as insurance for section 145(g)` TRUE TRUE TRUE TRUE FALSE EQUALS FALSE
-- #157 Through an unlicensed captive.
#ASSERT `Does insurance through a captive insurance company count as insurance for section 145(g)` TRUE FALSE TRUE TRUE TRUE EQUALS FALSE
-- #158 The conduct is another insured person's: not imputed to me.
#ASSERT `Is another insured person's conduct imputed to me for the captive-insurance conditions of section 145(g)(1)` TRUE EQUALS FALSE
-- #158 The conduct is my own: the question is not about imputing.
#ASSERT `Is another insured person's conduct imputed to me for the captive-insurance conditions of section 145(g)(1)` FALSE EQUALS FALSE
-- #159 We maintain a captive insurer for this: still not subject to Title 18 solely for that.
#ASSERT `Does my corporation become subject to Title 18 solely because it maintains a captive insurance company that insures under section 145` TRUE EQUALS FALSE
-- #159 We do not.
#ASSERT `Does my corporation become subject to Title 18 solely because it maintains a captive insurance company that insures under section 145` FALSE EQUALS FALSE
-- #160 My corporation merged into the surviving one; it could have indemnified its people; I served it.
#ASSERT `Do I stand in the same position with respect to the surviving corporation as I did with the constituent corporation` TRUE TRUE TRUE EQUALS JUST TRUE
-- #160 It could not have indemnified: the text does not say.
#ASSERT `Do I stand in the same position with respect to the surviving corporation as I did with the constituent corporation` TRUE FALSE TRUE EQUALS NOTHING
-- #160 My corporation was not a constituent corporation.
#ASSERT `Do I stand in the same position with respect to the surviving corporation as I did with the constituent corporation` FALSE TRUE TRUE EQUALS NOTHING
-- #161 An employee benefit plan, as another enterprise.
#ASSERT `Does a reference to an employee benefit plan, an excise tax or service for a plan fall within the references in section 145` `an employee benefit plan, as an other enterprise` EQUALS JUST TRUE
-- #161 An excise tax on me for a plan is a fine.
#ASSERT `Does a reference to an employee benefit plan, an excise tax or service for a plan fall within the references in section 145` `an excise tax assessed on a person with respect to an employee benefit plan, as a fine` EQUALS JUST TRUE
-- #161 Service that involves duties to a plan is service at the corporation's request.
#ASSERT `Does a reference to an employee benefit plan, an excise tax or service for a plan fall within the references in section 145` `service as a director, officer, employee or agent of the corporation which imposes duties on, or involves services by, the person with respect to an employee benefit plan, its participants or beneficiaries, as serving at the request of the corporation` EQUALS JUST TRUE
-- #161 Anything else: the text does not say.
#ASSERT `Does a reference to an employee benefit plan, an excise tax or service for a plan fall within the references in section 145` `anything else` EQUALS NOTHING
-- #162 I acted in good faith and reasonably believed it in the participants' interest.
#ASSERT `Am I deemed to have acted in a manner not opposed to the best interests of the corporation because I acted for an employee benefit plan's participants` TRUE TRUE EQUALS JUST TRUE
-- #162 I did not so believe: the text does not say.
#ASSERT `Am I deemed to have acted in a manner not opposed to the best interests of the corporation because I acted for an employee benefit plan's participants` TRUE FALSE EQUALS NOTHING
-- #162 I did not act in good faith: the text does not say.
#ASSERT `Am I deemed to have acted in a manner not opposed to the best interests of the corporation because I acted for an employee benefit plan's participants` FALSE TRUE EQUALS NOTHING
-- #163 Nothing otherwise provided when it was authorized: it continues after I cease to serve.
#ASSERT `Does my indemnification and advancement continue after I cease to be a director, officer, employee or agent` FALSE EQUALS TRUE
-- #163 It was otherwise provided when authorized.
#ASSERT `Does my indemnification and advancement continue after I cease to be a director, officer, employee or agent` TRUE EQUALS FALSE
-- #164 Nothing otherwise provided: it passes to my heirs, executors and administrators.
#ASSERT `Do my indemnification and advancement pass to my heirs, executors and administrators` FALSE EQUALS TRUE
-- #164 It was otherwise provided when authorized.
#ASSERT `Do my indemnification and advancement pass to my heirs, executors and administrators` TRUE EQUALS FALSE
-- #165 My action is for advancement or indemnification: the Court of Chancery has exclusive jurisdiction.
#ASSERT `Does the Court of Chancery have exclusive jurisdiction over my action for advancement or indemnification` TRUE EQUALS JUST TRUE
-- #165 It is some other action: the text does not say.
#ASSERT `Does the Court of Chancery have exclusive jurisdiction over my action for advancement or indemnification` FALSE EQUALS NOTHING
-- #166 The question is the corporation's obligation to advance my expenses.
#ASSERT `Can the Court of Chancery summarily determine the corporation's obligation to advance my expenses` TRUE EQUALS JUST TRUE
-- #166 The question is something else: the text does not say.
#ASSERT `Can the Court of Chancery summarily determine the corporation's obligation to advance my expenses` FALSE EQUALS NOTHING

§§ `Putting a matter to the stockholders, and approving or ratifying instruments (ss 146 and 147)`
-- #167 The board has recommended that the stockholders reject the matter it approved: the corporation may still agree to submit it.
#ASSERT `May my corporation agree to submit a matter to a vote of its stockholders even though the board no longer recommends it` TRUE EQUALS TRUE
-- #167 The board has not changed its recommendation.
#ASSERT `May my corporation agree to submit a matter to a vote of its stockholders even though the board no longer recommends it` FALSE EQUALS TRUE
-- #168 The chapter requires board action; the board approves the document in final form.
#ASSERT `May the board approve an agreement, instrument or document in this form when the Law requires it to approve it` TRUE `in final form` EQUALS JUST TRUE
-- #168 In substantially final form.
#ASSERT `May the board approve an agreement, instrument or document in this form when the Law requires it to approve it` TRUE `in substantially final form` EQUALS JUST TRUE
-- #168 In some other form: the text does not say.
#ASSERT `May the board approve an agreement, instrument or document in this form when the Law requires it to approve it` TRUE `in some other form` EQUALS NOTHING
-- #168 The chapter does not expressly require board action: the text does not say.
#ASSERT `May the board approve an agreement, instrument or document in this form when the Law requires it to approve it` FALSE `in final form` EQUALS NOTHING
-- #169 The board approved the document; it must be filed and the filing is not yet effective.
#ASSERT `May the board ratify an agreement, instrument or document it approved, before its filing takes effect` TRUE TRUE TRUE EQUALS TRUE
-- #169 The filing has already become effective.
#ASSERT `May the board ratify an agreement, instrument or document it approved, before its filing takes effect` TRUE TRUE FALSE EQUALS FALSE
-- #169 The document is not one the chapter requires to be filed.
#ASSERT `May the board ratify an agreement, instrument or document it approved, before its filing takes effect` TRUE FALSE TRUE EQUALS FALSE
-- #169 The board never acted on it.
#ASSERT `May the board ratify an agreement, instrument or document it approved, before its filing takes effect` FALSE TRUE TRUE EQUALS FALSE
-- #170 The board first approved the document on March 1, 2026.
#ASSERT `As of what date is a ratification under section 147 effective` (YMD 2026 3 1) EQUALS (YMD 2026 3 1)
-- #171 A ratification under section 147 satisfies a requirement of manner or sequence.
#ASSERT `Does a ratification under section 147 satisfy a requirement that the board approve or act in a specific manner or sequence` TRUE EQUALS JUST TRUE
-- #171 A ratification under some other route: the text does not say.
#ASSERT `Does a ratification under section 147 satisfy a requirement that the board approve or act in a specific manner or sequence` FALSE EQUALS NOTHING
-- #172 Ratification under section 147 is not the exclusive means.
#ASSERT `Is ratification under section 147 the only way to ratify an agreement, instrument or document the board approved under that section` TRUE EQUALS FALSE
-- #172 Even if the board did not approve under section 147: not exclusive either.
#ASSERT `Is ratification under section 147 the only way to ratify an agreement, instrument or document the board approved under that section` FALSE EQUALS FALSE
