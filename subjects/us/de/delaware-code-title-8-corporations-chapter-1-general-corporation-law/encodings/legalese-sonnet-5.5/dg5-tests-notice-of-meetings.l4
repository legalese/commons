IMPORT prelude
IMPORT daydate
IMPORT `dg-core`
IMPORT `dg5-s222-s229-s230-notice-of-meetings`

-- Tests of dg5-s222-s229-s230-notice-of-meetings.l4 (8 Del. C. ss 222, 229, 230).
-- Every expected value is written by hand from the text (src:895-897, 944, 948-950 of de-code-t8-ch1-2026-10-01.txt), beside the assertion.

§ `Section 222(a) -- what the notice must say`

-- helper arguments, in order: special meeting, has a place, remote communications, voting record date differs,
-- states place, states date and hour, states remote means, states voting record date, states purposes.
GIVEN sp IS A BOOLEAN
      pl IS A BOOLEAN
      rm IS A BOOLEAN
      rd IS A BOOLEAN
      spl IS A BOOLEAN
      sdh IS A BOOLEAN
      srm IS A BOOLEAN
      srd IS A BOOLEAN
      spu IS A BOOLEAN
GIVETH A `dg5 s 222(a) Notice of a meeting of stockholders`
`dg5 test meeting notice` sp pl rm rd spl sdh srm srd spu MEANS
    `dg5 s 222(a) Notice of a meeting of stockholders` WITH
          `the meeting is a special meeting` IS sp
        , `the meeting has a place` IS pl
        , `stockholders and proxy holders may be deemed present in person and vote by remote communications` IS rm
        , `the record date for voting differs from the record date for notice` IS rd
        , `the notice states the place of the meeting` IS spl
        , `the notice states the date and hour of the meeting` IS sdh
        , `the notice states the means of remote communications` IS srm
        , `the notice states the record date for determining the stockholders entitled to vote` IS srd
        , `the notice states the purpose or purposes for which the meeting is called` IS spu

-- A special meeting with a place, remote participation and a different voting record date: all five items stated.
#ASSERT `s 222(a) the notice of the meeting states what it must` (`dg5 test meeting notice` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE)
-- The meeting has a place that the notice does not state.
#ASSERT NOT (`s 222(a) the notice of the meeting states what it must` (`dg5 test meeting notice` TRUE TRUE TRUE TRUE FALSE TRUE TRUE TRUE TRUE))
-- The date and hour are always required.
#ASSERT NOT (`s 222(a) the notice of the meeting states what it must` (`dg5 test meeting notice` TRUE TRUE TRUE TRUE TRUE FALSE TRUE TRUE TRUE))
-- Remote communications are available but the notice does not state the means.
#ASSERT NOT (`s 222(a) the notice of the meeting states what it must` (`dg5 test meeting notice` TRUE TRUE TRUE TRUE TRUE TRUE FALSE TRUE TRUE))
-- The voting record date differs from the notice record date and the notice does not state it.
#ASSERT NOT (`s 222(a) the notice of the meeting states what it must` (`dg5 test meeting notice` TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE TRUE))
-- A special meeting whose notice does not state the purposes.
#ASSERT NOT (`s 222(a) the notice of the meeting states what it must` (`dg5 test meeting notice` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE))
-- An annual meeting with no place, no remote means and one record date needs only the date and hour.
#ASSERT `s 222(a) the notice of the meeting states what it must` (`dg5 test meeting notice` FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE)
-- ... and not even that if the date and hour are missing.
#ASSERT NOT (`s 222(a) the notice of the meeting states what it must` (`dg5 test meeting notice` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE))
-- Stockholders are required or permitted to act at the meeting: a notice of it must be given. Neither required nor permitted: no duty from this subsection.
#ASSERT `s 222(a) a notice of the meeting must be given` TRUE
#ASSERT NOT (`s 222(a) a notice of the meeting must be given` FALSE)

§ `Section 222(b) -- the time allowed`

-- The default is 10 to 60 days before the meeting. The meeting is on 30 June 2026.
-- 10 days before is 20 June; 60 days before is 1 May (30 June less 30 days is 31 May; less 30 more is 1 May).
#ASSERT `the date` (`period in days` 10) `before` (YearMonthDay 2026 6 30) EQUALS YearMonthDay 2026 6 20
#ASSERT `the date` (`period in days` 60) `before` (YearMonthDay 2026 6 30) EQUALS YearMonthDay 2026 5 1
#ASSERT `s 222(b) the notice was given within the time allowed` (JUST (YearMonthDay 2026 6 20)) (YearMonthDay 2026 6 30) NOTHING EQUALS JUST TRUE
#ASSERT `s 222(b) the notice was given within the time allowed` (JUST (YearMonthDay 2026 6 21)) (YearMonthDay 2026 6 30) NOTHING EQUALS JUST FALSE
#ASSERT `s 222(b) the notice was given within the time allowed` (JUST (YearMonthDay 2026 5 1)) (YearMonthDay 2026 6 30) NOTHING EQUALS JUST TRUE
#ASSERT `s 222(b) the notice was given within the time allowed` (JUST (YearMonthDay 2026 4 30)) (YearMonthDay 2026 6 30) NOTHING EQUALS JUST FALSE
#ASSERT `s 222(b) the notice was given within the time allowed` (JUST (YearMonthDay 2026 6 30)) (YearMonthDay 2026 6 30) NOTHING EQUALS JUST FALSE
#ASSERT `s 222(b) the notice was given within the time allowed` (JUST (YearMonthDay 2026 6 1)) (YearMonthDay 2026 6 30) NOTHING EQUALS JUST TRUE
-- Section 232 does not make the notice effective: this subsection cannot say.
#ASSERT `s 222(b) the notice was given within the time allowed` NOTHING (YearMonthDay 2026 6 30) NOTHING EQUALS NOTHING
-- "Unless otherwise provided in this chapter": a hypothetical other section allows 20 to 90 days.
-- 20 days before 30 June is 10 June; 90 days before is 1 April.
`dg5 test other time` MEANS JUST (`dg5 s 222(b) Time allowed for a notice` WITH `the shortest time before the meeting that the notice may be given` IS `period in days` 20, `the longest time before the meeting that the notice may be given` IS `period in days` 90)
#ASSERT `s 222(b) the notice was given within the time allowed` (JUST (YearMonthDay 2026 6 10)) (YearMonthDay 2026 6 30) `dg5 test other time` EQUALS JUST TRUE
#ASSERT `s 222(b) the notice was given within the time allowed` (JUST (YearMonthDay 2026 6 11)) (YearMonthDay 2026 6 30) `dg5 test other time` EQUALS JUST FALSE
#ASSERT `s 222(b) the notice was given within the time allowed` (JUST (YearMonthDay 2026 4 1)) (YearMonthDay 2026 6 30) `dg5 test other time` EQUALS JUST TRUE
#ASSERT `s 222(b) the notice was given within the time allowed` (JUST (YearMonthDay 2026 3 31)) (YearMonthDay 2026 6 30) `dg5 test other time` EQUALS JUST FALSE
#ASSERT (`s 222(b) the time that applies to the notice` NOTHING)'s `the shortest time before the meeting that the notice may be given` EQUALS `period in days` 10
#ASSERT (`s 222(b) the time that applies to the notice` NOTHING)'s `the longest time before the meeting that the notice may be given` EQUALS `period in days` 60
-- Who is owed the notice: a stockholder of record on the record date for notice who is entitled to vote at the meeting.
#ASSERT `s 222(b) the stockholder must be given the notice of the meeting` TRUE TRUE
#ASSERT NOT (`s 222(b) the stockholder must be given the notice of the meeting` TRUE FALSE)
#ASSERT NOT (`s 222(b) the stockholder must be given the notice of the meeting` FALSE TRUE)

§ `Section 222(c) -- an adjourned meeting`

-- helper arguments, in order: bylaws require notice, announced, displayed, set forth in the notice, date of the meeting adjourned, date of the adjourned meeting, new voting record date.
GIVEN b IS A BOOLEAN
      an IS A BOOLEAN
      di IS A BOOLEAN
      sf IS A BOOLEAN
      d1 IS A DATE
      d2 IS A DATE
      nr IS A BOOLEAN
GIVETH A `dg5 s 222(c) Adjournment of a meeting`
`dg5 test adjournment` b an di sf d1 d2 nr MEANS
    `dg5 s 222(c) Adjournment of a meeting` WITH
          `the bylaws require notice of the adjourned meeting` IS b
        , `the time, place and means of remote communications of the adjourned meeting were announced at the meeting at which the adjournment was taken` IS an
        , `the time, place and means of remote communications of the adjourned meeting were displayed during the time scheduled for the meeting on the electronic network used for remote participation` IS di
        , `the time, place and means of remote communications of the adjourned meeting were set forth in the notice of the meeting given under s 222(a)` IS sf
        , `the date of the meeting that was adjourned` IS d1
        , `the date of the adjourned meeting` IS d2
        , `a new record date for stockholders entitled to vote was fixed for the adjourned meeting` IS nr

-- The original meeting is on 1 June 2026; 30 days later is 1 July 2026.
-- Announced at the meeting, adjourned 29 days: no notice needed.
#ASSERT NOT (`s 222(c) notice of the adjourned meeting must be given` (`dg5 test adjournment` FALSE TRUE FALSE FALSE (YearMonthDay 2026 6 1) (YearMonthDay 2026 6 30) FALSE))
-- ... exactly 30 days: still not "more than 30 days".
#ASSERT NOT (`s 222(c) notice of the adjourned meeting must be given` (`dg5 test adjournment` FALSE TRUE FALSE FALSE (YearMonthDay 2026 6 1) (YearMonthDay 2026 7 1) FALSE))
#ASSERT NOT (`s 222(c) the adjournment is for more than 30 days` (`dg5 test adjournment` FALSE TRUE FALSE FALSE (YearMonthDay 2026 6 1) (YearMonthDay 2026 7 1) FALSE))
-- ... 31 days: more than 30, so notice must be given even though the adjourned meeting was announced.
#ASSERT `s 222(c) the adjournment is for more than 30 days` (`dg5 test adjournment` FALSE TRUE FALSE FALSE (YearMonthDay 2026 6 1) (YearMonthDay 2026 7 2) FALSE)
#ASSERT `s 222(c) notice of the adjourned meeting must be given` (`dg5 test adjournment` FALSE TRUE FALSE FALSE (YearMonthDay 2026 6 1) (YearMonthDay 2026 7 2) FALSE)
-- Each of the three ways alone suffices.
#ASSERT NOT (`s 222(c) notice of the adjourned meeting must be given` (`dg5 test adjournment` FALSE FALSE TRUE FALSE (YearMonthDay 2026 6 1) (YearMonthDay 2026 6 15) FALSE))
#ASSERT NOT (`s 222(c) notice of the adjourned meeting must be given` (`dg5 test adjournment` FALSE FALSE FALSE TRUE (YearMonthDay 2026 6 1) (YearMonthDay 2026 6 15) FALSE))
#ASSERT `s 222(c) the adjourned meeting was made known in one of the three ways` (`dg5 test adjournment` FALSE FALSE FALSE TRUE (YearMonthDay 2026 6 1) (YearMonthDay 2026 6 15) FALSE)
-- None of the three ways was used (Fork F4: then notice must be given).
#ASSERT `s 222(c) notice of the adjourned meeting must be given` (`dg5 test adjournment` FALSE FALSE FALSE FALSE (YearMonthDay 2026 6 1) (YearMonthDay 2026 6 15) FALSE)
#ASSERT NOT (`s 222(c) the adjourned meeting was made known in one of the three ways` (`dg5 test adjournment` FALSE FALSE FALSE FALSE (YearMonthDay 2026 6 1) (YearMonthDay 2026 6 15) FALSE))
-- "Unless the bylaws otherwise require."
#ASSERT `s 222(c) notice of the adjourned meeting must be given` (`dg5 test adjournment` TRUE TRUE FALSE FALSE (YearMonthDay 2026 6 1) (YearMonthDay 2026 6 15) FALSE)
-- A new record date for voting fixed for the adjourned meeting: the board fixes a new record date for notice and notice must be given.
#ASSERT `s 222(c) notice of the adjourned meeting must be given` (`dg5 test adjournment` FALSE TRUE FALSE FALSE (YearMonthDay 2026 6 1) (YearMonthDay 2026 6 15) TRUE)
#ASSERT `s 222(c) the board of directors must fix a new record date for notice of the adjourned meeting` (`dg5 test adjournment` FALSE TRUE FALSE FALSE (YearMonthDay 2026 6 1) (YearMonthDay 2026 6 15) TRUE)
#ASSERT NOT (`s 222(c) the board of directors must fix a new record date for notice of the adjourned meeting` (`dg5 test adjournment` FALSE TRUE FALSE FALSE (YearMonthDay 2026 6 1) (YearMonthDay 2026 6 15) FALSE))
-- The stockholder owed notice: notice must be given and the person was a stockholder of record entitled to vote as of the record date that applies.
#ASSERT `s 222(c) the stockholder must be given notice of the adjourned meeting` (`dg5 test adjournment` FALSE FALSE FALSE FALSE (YearMonthDay 2026 6 1) (YearMonthDay 2026 6 15) FALSE) TRUE
#ASSERT NOT (`s 222(c) the stockholder must be given notice of the adjourned meeting` (`dg5 test adjournment` FALSE FALSE FALSE FALSE (YearMonthDay 2026 6 1) (YearMonthDay 2026 6 15) FALSE) FALSE)
#ASSERT NOT (`s 222(c) the stockholder must be given notice of the adjourned meeting` (`dg5 test adjournment` FALSE TRUE FALSE FALSE (YearMonthDay 2026 6 1) (YearMonthDay 2026 6 15) FALSE) TRUE)
-- Business at the adjourned meeting.
#ASSERT `s 222(c) the corporation may transact the business at the adjourned meeting` TRUE
#ASSERT NOT (`s 222(c) the corporation may transact the business at the adjourned meeting` FALSE)

§ `Section 229 -- waiver of notice`

-- helper arguments, in order: signed written waiver, waiver by electronic transmission, attended the meeting, attended to object.
GIVEN a IS A BOOLEAN
      b IS A BOOLEAN
      c IS A BOOLEAN
      d IS A BOOLEAN
GIVETH A `dg5 s 229 Waiver of notice`
`dg5 test waiver` a b c d MEANS
    `dg5 s 229 Waiver of notice` WITH
          `the person entitled to notice signed a written waiver` IS a
        , `the person entitled to notice gave a waiver by electronic transmission` IS b
        , `the person attended the meeting of which notice was required` IS c
        , `the person attended for the express purpose of objecting at the beginning of the meeting to the transaction of any business because the meeting is not lawfully called or convened` IS d

#ASSERT `s 229 notice is waived` (`dg5 test waiver` TRUE FALSE FALSE FALSE)
#ASSERT `s 229 notice is waived` (`dg5 test waiver` FALSE TRUE FALSE FALSE)
-- Attendance waives, unless the person attended for the express purpose of objecting at the beginning.
#ASSERT `s 229 notice is waived` (`dg5 test waiver` FALSE FALSE TRUE FALSE)
#ASSERT NOT (`s 229 notice is waived` (`dg5 test waiver` FALSE FALSE TRUE TRUE))
-- Attendance to object does not undo a signed waiver.
#ASSERT `s 229 notice is waived` (`dg5 test waiver` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 229 notice is waived` (`dg5 test waiver` FALSE FALSE FALSE FALSE))
-- "unless so required by the certificate of incorporation or the bylaws."
#ASSERT `s 229 the waiver must specify the business or the purpose of the meeting` `in the certificate of incorporation`
#ASSERT `s 229 the waiver must specify the business or the purpose of the meeting` `in the bylaws`
#ASSERT NOT (`s 229 the waiver must specify the business or the purpose of the meeting` `in none of these`)
#ASSERT NOT (`s 229 the waiver must specify the business or the purpose of the meeting` `in a resolution of the board of directors`)

§ `Section 230 -- exceptions to the requirements of notice`

#ASSERT `s 230(a) notice is not required to the person` TRUE
#ASSERT NOT (`s 230(a) notice is not required to the person` FALSE)
#ASSERT `s 230(a) the corporation need not apply for a license or permit to give the notice to the person` TRUE
#ASSERT NOT (`s 230(a) the corporation need not apply for a license or permit to give the notice to the person` FALSE)
#ASSERT `s 230(a) the action or meeting held without notice to the person has the same force and effect as if notice had been given` TRUE EQUALS JUST TRUE
-- Where communication was lawful the subsection says nothing about the effect: not covered.
#ASSERT `s 230(a) the action or meeting held without notice to the person has the same force and effect as if notice had been given` FALSE EQUALS NOTHING
#ASSERT `s 230(a) the certificate must state that notice was given to all persons entitled to receive notice except those with whom communication is unlawful` TRUE TRUE TRUE
#ASSERT NOT (`s 230(a) the certificate must state that notice was given to all persons entitled to receive notice except those with whom communication is unlawful` FALSE TRUE TRUE)
#ASSERT NOT (`s 230(a) the certificate must state that notice was given to all persons entitled to receive notice except those with whom communication is unlawful` TRUE FALSE TRUE)
#ASSERT NOT (`s 230(a) the certificate must state that notice was given to all persons entitled to receive notice except those with whom communication is unlawful` TRUE TRUE FALSE)

-- helper arguments, in order: notices of 2 annual meetings returned, all notices between returned, payments sent by first-class mail,
-- payments returned, the person gave a current address, a returned notice was given by electronic transmission,
-- e-mail address on the records, electronic notice prohibited by section 232.
GIVEN a IS A BOOLEAN
      b IS A BOOLEAN
      s IS A NUMBER
      r IS A NUMBER
      ad IS A BOOLEAN
      et IS A BOOLEAN
      em IS A BOOLEAN
      pr IS A BOOLEAN
GIVETH A `dg5 s 230(b) Notices and payments returned undeliverable`
`dg5 test returned mail` a b s r ad et em pr MEANS
    `dg5 s 230(b) Notices and payments returned undeliverable` WITH
          `notices of 2 consecutive annual meetings were mailed to the person at the address on the corporation's records and returned undeliverable` IS a
        , `all notices of meetings or of the taking of action by written consent mailed to the person between those 2 consecutive annual meetings were returned undeliverable` IS b
        , `the number of payments of dividends or interest on securities sent to the person by first-class mail during a 12-month period` IS s
        , `the number of those payments returned undeliverable` IS r
        , `the person delivered to the corporation a written notice setting forth the person's then current address` IS ad
        , `a returned notice was given by electronic transmission` IS et
        , `the person's electronic mail address appears on the records of the corporation` IS em
        , `notice by electronic transmission to the person is prohibited by s 232` IS pr

-- Paragraph (b)(1): two consecutive annual meetings' notices AND all notices between them.
#ASSERT `s 230(b)(1) notices of two annual meetings and all notices between them were returned undeliverable` (`dg5 test returned mail` TRUE TRUE 0 0 FALSE FALSE FALSE FALSE)
#ASSERT NOT (`s 230(b)(1) notices of two annual meetings and all notices between them were returned undeliverable` (`dg5 test returned mail` TRUE FALSE 0 0 FALSE FALSE FALSE FALSE))
#ASSERT NOT (`s 230(b)(1) notices of two annual meetings and all notices between them were returned undeliverable` (`dg5 test returned mail` FALSE TRUE 0 0 FALSE FALSE FALSE FALSE))
-- Paragraph (b)(2): all, and at least 2, payments returned. 3 of 3 and 2 of 2 are enough; 2 of 3 is not all; 1 of 1 is not at least 2.
#ASSERT `s 230(b)(2) all and at least 2 payments sent by first-class mail were returned undeliverable` (`dg5 test returned mail` FALSE FALSE 3 3 FALSE FALSE FALSE FALSE)
#ASSERT `s 230(b)(2) all and at least 2 payments sent by first-class mail were returned undeliverable` (`dg5 test returned mail` FALSE FALSE 2 2 FALSE FALSE FALSE FALSE)
#ASSERT NOT (`s 230(b)(2) all and at least 2 payments sent by first-class mail were returned undeliverable` (`dg5 test returned mail` FALSE FALSE 3 2 FALSE FALSE FALSE FALSE))
#ASSERT NOT (`s 230(b)(2) all and at least 2 payments sent by first-class mail were returned undeliverable` (`dg5 test returned mail` FALSE FALSE 1 1 FALSE FALSE FALSE FALSE))
#ASSERT NOT (`s 230(b)(2) all and at least 2 payments sent by first-class mail were returned undeliverable` (`dg5 test returned mail` FALSE FALSE 0 0 FALSE FALSE FALSE FALSE))
-- Subsection (c) removes (b)(1) for a returned notice given by electronic transmission, or where an e-mail address is on the records and electronic notice is not prohibited.
#ASSERT `s 230(c) the exception in paragraph (b)(1) is not applicable` (`dg5 test returned mail` TRUE TRUE 0 0 FALSE TRUE FALSE FALSE)
#ASSERT `s 230(c) the exception in paragraph (b)(1) is not applicable` (`dg5 test returned mail` TRUE TRUE 0 0 FALSE FALSE TRUE FALSE)
#ASSERT NOT (`s 230(c) the exception in paragraph (b)(1) is not applicable` (`dg5 test returned mail` TRUE TRUE 0 0 FALSE FALSE TRUE TRUE))
#ASSERT NOT (`s 230(c) the exception in paragraph (b)(1) is not applicable` (`dg5 test returned mail` TRUE TRUE 0 0 FALSE FALSE FALSE FALSE))
-- Notice need not be given.
#ASSERT `s 230(b) notice need not be given to the stockholder or member` (`dg5 test returned mail` TRUE TRUE 0 0 FALSE FALSE FALSE FALSE)
-- (b)(1) with an e-mail address on the records: subsection (c) takes the exception away.
#ASSERT NOT (`s 230(b) notice need not be given to the stockholder or member` (`dg5 test returned mail` TRUE TRUE 0 0 FALSE FALSE TRUE FALSE))
-- ... unless electronic notice to the person is prohibited by section 232.
#ASSERT `s 230(b) notice need not be given to the stockholder or member` (`dg5 test returned mail` TRUE TRUE 0 0 FALSE FALSE TRUE TRUE)
-- ... and the returned notice was itself given by electronic transmission.
#ASSERT NOT (`s 230(b) notice need not be given to the stockholder or member` (`dg5 test returned mail` TRUE TRUE 0 0 FALSE TRUE FALSE FALSE))
-- (b)(2) is not touched by subsection (c).
#ASSERT `s 230(b) notice need not be given to the stockholder or member` (`dg5 test returned mail` FALSE FALSE 2 2 FALSE FALSE TRUE FALSE)
-- The requirement is reinstated if the person delivers a written notice of the current address.
#ASSERT NOT (`s 230(b) notice need not be given to the stockholder or member` (`dg5 test returned mail` TRUE TRUE 0 0 TRUE FALSE FALSE FALSE))
#ASSERT NOT (`s 230(b) notice need not be given to the stockholder or member` (`dg5 test returned mail` FALSE FALSE 2 2 TRUE FALSE FALSE FALSE))
-- Neither paragraph applies.
#ASSERT NOT (`s 230(b) notice need not be given to the stockholder or member` (`dg5 test returned mail` FALSE FALSE 1 1 FALSE FALSE FALSE FALSE))
-- Effect of the exception.
#ASSERT `s 230(b) the action or meeting held without notice to the person has the same force and effect as if notice had been given` (`dg5 test returned mail` TRUE TRUE 0 0 FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `s 230(b) the action or meeting held without notice to the person has the same force and effect as if notice had been given` (`dg5 test returned mail` FALSE FALSE 1 1 FALSE FALSE FALSE FALSE) EQUALS NOTHING
#ASSERT `s 230(b) the certificate need not state that notice was not given to the person` (`dg5 test returned mail` FALSE FALSE 2 2 FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `s 230(b) the certificate need not state that notice was not given to the person` (`dg5 test returned mail` FALSE FALSE 1 1 FALSE FALSE FALSE FALSE) EQUALS NOTHING
