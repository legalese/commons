#ASSERT NOT (`s 258(a) the corporations may merge or consolidate` (LIST `test a Nevada-style stock corporation`, `test a foreign-country nonstock corporation`) FALSE TRUE)
#ASSERT NOT (`s 258(a) the corporations may merge or consolidate` (LIST `test a Delaware stock corporation`, `test a Nevada-style stock corporation`) FALSE FALSE)
-- The survivor may be a domestic or foreign stock or nonstock corporation.
#ASSERT `s 258(a) the surviving or resulting corporation may be of this kind` `a stock corporation`
#ASSERT `s 258(a) the surviving or resulting corporation may be of this kind` `a charitable nonstock corporation`

-- (b): the agreement is as s 257 provides, and sets out what the foreign laws require.
#ASSERT `s 258(b) the agreement states what the subsection requires` `test a merger` `test a complete merger agreement`
#ASSERT NOT (`s 258(b) the agreement states what the subsection requires` `test a merger` (`test an agreement with` TRUE TRUE TRUE FALSE TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE))
#ASSERT NOT (`s 258(b) the agreement states what the subsection requires` `test a merger` (`test an agreement with` TRUE TRUE TRUE FALSE TRUE TRUE TRUE TRUE FALSE FALSE FALSE TRUE))
-- A Delaware constituent is approved as s 257 prescribes; a foreign one by its own law.
#ASSERT `s 258(b) the constituent corporation has approved the agreement as the subsection requires` (`s 258(b) Approval by one constituent corporation` WITH `where the corporation is formed` IS `this State`, `the agreement was adopted, approved, certified, executed and acknowledged in accordance with the laws under which it is organized` IS FALSE, `the corporation was approved by the method and procedure that s 257 prescribes` IS TRUE)
#ASSERT NOT (`s 258(b) the constituent corporation has approved the agreement as the subsection requires` (`s 258(b) Approval by one constituent corporation` WITH `where the corporation is formed` IS `this State`, `the agreement was adopted, approved, certified, executed and acknowledged in accordance with the laws under which it is organized` IS TRUE, `the corporation was approved by the method and procedure that s 257 prescribes` IS FALSE))
#ASSERT `s 258(b) the constituent corporation has approved the agreement as the subsection requires` (`s 258(b) Approval by one constituent corporation` WITH `where the corporation is formed` IS `a foreign jurisdiction outside the United States`, `the agreement was adopted, approved, certified, executed and acknowledged in accordance with the laws under which it is organized` IS TRUE, `the corporation was approved by the method and procedure that s 257 prescribes` IS FALSE)
#ASSERT NOT (`s 258(b) the constituent corporation has approved the agreement as the subsection requires` (`s 258(b) Approval by one constituent corporation` WITH `where the corporation is formed` IS `a foreign jurisdiction outside the United States`, `the agreement was adopted, approved, certified, executed and acknowledged in accordance with the laws under which it is organized` IS FALSE, `the corporation was approved by the method and procedure that s 257 prescribes` IS TRUE))

