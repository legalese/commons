IMPORT prelude
IMPORT daydate
IMPORT `dg-core`
IMPORT `dg5-s241-s242-amendment`

-- Tests of dg5-s241-s242-amendment.l4 (8 Del. C. ss 241 and 242).
-- Every expected value is written by hand from the text (src:1004-1030 of de-code-t8-ch1-2026-10-01.txt), beside the assertion.

§ `Section 241 -- before receipt of payment for stock`

-- A stock corporation that has received no payment is under section 241; one that has received payment is under section 242.
#ASSERT `s 241 the section governs the amendment` `a stock corporation` FALSE FALSE
#ASSERT NOT (`s 241 the section governs the amendment` `a stock corporation` TRUE FALSE)
-- A nonstock corporation: section 241(c) applies "before such a corporation has any members".
#ASSERT `s 241 the section governs the amendment` `a nonprofit nonstock corporation that is not charitable` FALSE FALSE
#ASSERT NOT (`s 241 the section governs the amendment` `a nonstock corporation with membership interests` FALSE TRUE)
#ASSERT `s 241 the section governs the amendment` `a charitable nonstock corporation` TRUE FALSE
-- Section 241(a): lawful and proper provisions only.
#ASSERT `s 241(a) the corporation may amend its certificate of incorporation` `a stock corporation` FALSE FALSE TRUE
#ASSERT NOT (`s 241(a) the corporation may amend its certificate of incorporation` `a stock corporation` FALSE FALSE FALSE)
#ASSERT NOT (`s 241(a) the corporation may amend its certificate of incorporation` `a stock corporation` TRUE FALSE TRUE)
-- Section 241(b): who adopts. Directors named or elected and qualified: a majority of the directors; otherwise a majority of the incorporators.
GIVEN named IS A BOOLEAN
      ni IS A NUMBER
      nif IS A NUMBER
      nd IS A NUMBER
      ndf IS A NUMBER
GIVETH A `dg5 s 241(b) Adoption of an amendment before payment`
`dg5 test adoption before payment` named ni nif nd ndf MEANS
    `dg5 s 241(b) Adoption of an amendment before payment` WITH
          `directors were named in the original certificate of incorporation or have been elected and have qualified` IS named
        , `the number of incorporators` IS ni
        , `the number of incorporators voting in favor` IS nif
        , `the number of directors` IS nd
        , `the number of directors voting in favor` IS ndf

-- 3 directors, 2 in favor: a majority.
#ASSERT `s 241(b) the amendment has been adopted by the incorporators or the directors` (`dg5 test adoption before payment` TRUE 2 0 3 2) EQUALS JUST TRUE
-- 4 directors, 2 in favor: exactly half is not a majority.
#ASSERT `s 241(b) the amendment has been adopted by the incorporators or the directors` (`dg5 test adoption before payment` TRUE 2 0 4 2) EQUALS JUST FALSE
#ASSERT `s 241(b) the amendment has been adopted by the incorporators or the directors` (`dg5 test adoption before payment` TRUE 2 0 4 3) EQUALS JUST TRUE
-- Directors have been elected, so the incorporators' vote is not the one that counts, even if unanimous.
#ASSERT `s 241(b) the amendment has been adopted by the incorporators or the directors` (`dg5 test adoption before payment` TRUE 2 2 3 1) EQUALS JUST FALSE
-- No directors named or elected: 2 incorporators, 1 in favor is not a majority; 3, 2 in favor is.
#ASSERT `s 241(b) the amendment has been adopted by the incorporators or the directors` (`dg5 test adoption before payment` FALSE 2 1 0 0) EQUALS JUST FALSE
#ASSERT `s 241(b) the amendment has been adopted by the incorporators or the directors` (`dg5 test adoption before payment` FALSE 3 2 0 0) EQUALS JUST TRUE
#ASSERT `s 241(b) the amendment has been adopted by the incorporators or the directors` (`dg5 test adoption before payment` FALSE 1 1 0 0) EQUALS JUST TRUE
-- Counts that cannot be a vote: not covered.
#ASSERT `s 241(b) the amendment has been adopted by the incorporators or the directors` (`dg5 test adoption before payment` FALSE 2 3 0 0) EQUALS NOTHING
#ASSERT `s 241(b) the amendment has been adopted by the incorporators or the directors` (`dg5 test adoption before payment` TRUE 0 0 0 0) EQUALS NOTHING
-- The certificate of amendment.
#ASSERT `s 241(b) the certificate of amendment is in order` TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 241(b) the certificate of amendment is in order` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`s 241(b) the certificate of amendment is in order` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 241(b) the certificate of amendment is in order` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 241(b) the certificate of amendment is in order` TRUE TRUE TRUE FALSE)
-- Effective as of the day the original certificate became effective (1 March 2026), except as to a person substantially and adversely affected, from the filing date (1 June 2026).
#ASSERT `s 241(b) the date from which the amendment is effective as to the person` (YearMonthDay 2026 3 1) (YearMonthDay 2026 6 1) FALSE EQUALS YearMonthDay 2026 3 1
#ASSERT `s 241(b) the date from which the amendment is effective as to the person` (YearMonthDay 2026 3 1) (YearMonthDay 2026 6 1) TRUE EQUALS YearMonthDay 2026 6 1

§ `Section 242(a) -- the power to amend`

#ASSERT `s 242(a) the corporation may amend its certificate of incorporation` `a stock corporation` TRUE FALSE TRUE
#ASSERT NOT (`s 242(a) the corporation may amend its certificate of incorporation` `a stock corporation` FALSE FALSE TRUE)
#ASSERT `s 242(a) the corporation may amend its certificate of incorporation` `a nonprofit nonstock corporation that is not charitable` FALSE TRUE TRUE
#ASSERT NOT (`s 242(a) the corporation may amend its certificate of incorporation` `a nonprofit nonstock corporation that is not charitable` FALSE FALSE TRUE)
#ASSERT NOT (`s 242(a) the corporation may amend its certificate of incorporation` `a stock corporation` TRUE FALSE FALSE)
-- Paragraph (a)(1) or (7): the name, and the two deletions.
#ASSERT `s 242(a) the change is described in paragraph (a)(1) or (a)(7)` `a change of the corporate name`
#ASSERT `s 242(a) the change is described in paragraph (a)(1) or (a)(7)` `the deletion of the provisions of the original certificate of incorporation which named the incorporators, the initial board of directors and the original subscribers for shares`
#ASSERT `s 242(a) the change is described in paragraph (a)(1) or (a)(7)` `the deletion of provisions of an amendment that were necessary to effect a change, exchange, reclassification, subdivision, combination or cancellation of stock that has become effective`
#ASSERT NOT (`s 242(a) the change is described in paragraph (a)(1) or (a)(7)` `a change, substitution, enlargement or diminution of the nature of its business or its corporate powers and purposes`)
#ASSERT NOT (`s 242(a) the change is described in paragraph (a)(1) or (a)(7)` `an increase or decrease of the authorized capital stock or a reclassification of it`)
#ASSERT NOT (`s 242(a) the change is described in paragraph (a)(1) or (a)(7)` `the cancellation of, or other effect on, the right of the holders of the shares of a class to receive dividends which have accrued but have not been declared`)
#ASSERT NOT (`s 242(a) the change is described in paragraph (a)(1) or (a)(7)` `the creation of new classes of stock having rights and preferences prior and superior, or subordinate and inferior, to the stock of any class then authorized`)
#ASSERT NOT (`s 242(a) the change is described in paragraph (a)(1) or (a)(7)` `a change of the period of its duration`)
-- "Any or all such changes may be effected by 1 certificate of amendment."
#ASSERT `s 242(a) the changes may be effected by 1 certificate of amendment` 1
#ASSERT `s 242(a) the changes may be effected by 1 certificate of amendment` 3
#ASSERT NOT (`s 242(a) the changes may be effected by 1 certificate of amendment` 0)

§ `Section 242(b)(1) -- adoption by a stock corporation`

GIVETH A LIST OF `dg5 s 242(b)(1) Vote of a class on an amendment`
`dg5 test no classes` MEANS EMPTY
`dg5 test class entitled 60 of 100` MEANS `dg5 s 242(b)(1) Vote of a class on an amendment` WITH `the class is entitled to vote as a class on the amendment` IS TRUE, `the number of votes of the class in favor of the amendment` IS 60, `the number of outstanding votes of the class` IS 100
`dg5 test class entitled 50 of 100` MEANS `dg5 s 242(b)(1) Vote of a class on an amendment` WITH `the class is entitled to vote as a class on the amendment` IS TRUE, `the number of votes of the class in favor of the amendment` IS 50, `the number of outstanding votes of the class` IS 100
`dg5 test class entitled 51 of 100` MEANS `dg5 s 242(b)(1) Vote of a class on an amendment` WITH `the class is entitled to vote as a class on the amendment` IS TRUE, `the number of votes of the class in favor of the amendment` IS 51, `the number of outstanding votes of the class` IS 100
`dg5 test class not entitled` MEANS `dg5 s 242(b)(1) Vote of a class on an amendment` WITH `the class is entitled to vote as a class on the amendment` IS FALSE, `the number of votes of the class in favor of the amendment` IS 0, `the number of outstanding votes of the class` IS 100
`dg5 test class impossible counts` MEANS `dg5 s 242(b)(1) Vote of a class on an amendment` WITH `the class is entitled to vote as a class on the amendment` IS TRUE, `the number of votes of the class in favor of the amendment` IS 5, `the number of outstanding votes of the class` IS 0

-- helper arguments, in order: resolution, advisable, called or directed, notice under s 222, notice sets forth the amendment, internet-availability notice,
-- vote of stockholders required, votes in favor, outstanding votes, classes.
GIVEN r IS A BOOLEAN
      a IS A BOOLEAN
      c IS A BOOLEAN
      n IS A BOOLEAN
      sf IS A BOOLEAN
      ia IS A BOOLEAN
      vr IS A BOOLEAN
      f IS A NUMBER
      o IS A NUMBER
      cl IS A LIST OF `dg5 s 242(b)(1) Vote of a class on an amendment`
GIVETH A `dg5 s 242(b)(1) Adoption of an amendment by a corporation with capital stock`
`dg5 test stock adoption` r a c n sf ia vr f o cl MEANS
    `dg5 s 242(b)(1) Adoption of an amendment by a corporation with capital stock` WITH
          `the board of directors adopted a resolution setting forth the amendment proposed` IS r
        , `the resolution declared the amendment advisable` IS a
        , `the resolution called a special meeting of the stockholders entitled to vote or directed that the amendment be considered at the next annual meeting` IS c
        , `the meeting was called and held upon notice in accordance with s 222` IS n
        , `the notice set forth the amendment in full or a brief summary of the changes` IS sf
        , `the notice constitutes a notice of internet availability of proxy materials under the rules promulgated under the Securities Exchange Act of 1934` IS ia
        , `a vote of stockholders is required to adopt the amendment` IS vr
        , `the number of votes in favor of the amendment` IS f
        , `the number of outstanding votes entitled to vote on the amendment` IS o
        , `the classes entitled to vote as a class` IS cl

-- A majority of the outstanding stock entitled to vote: 51 of 100 carries, 50 of 100 does not.
#ASSERT `s 242(b)(1) the amendment has been duly adopted` (`dg5 test stock adoption` TRUE TRUE TRUE TRUE TRUE FALSE TRUE 51 100 `dg5 test no classes`) EQUALS JUST TRUE
#ASSERT `s 242(b)(1) the amendment has been duly adopted` (`dg5 test stock adoption` TRUE TRUE TRUE TRUE TRUE FALSE TRUE 50 100 `dg5 test no classes`) EQUALS JUST FALSE
-- If no vote of stockholders is required, the votes do not matter.
#ASSERT `s 242(b)(1) the amendment has been duly adopted` (`dg5 test stock adoption` TRUE TRUE TRUE TRUE TRUE FALSE FALSE 0 0 `dg5 test no classes`) EQUALS JUST TRUE
-- The board's three steps, each necessary.
#ASSERT `s 242(b)(1) the amendment has been duly adopted` (`dg5 test stock adoption` FALSE TRUE TRUE TRUE TRUE FALSE TRUE 51 100 `dg5 test no classes`) EQUALS JUST FALSE
#ASSERT `s 242(b)(1) the amendment has been duly adopted` (`dg5 test stock adoption` TRUE FALSE TRUE TRUE TRUE FALSE TRUE 51 100 `dg5 test no classes`) EQUALS JUST FALSE
#ASSERT `s 242(b)(1) the amendment has been duly adopted` (`dg5 test stock adoption` TRUE TRUE FALSE TRUE TRUE FALSE TRUE 51 100 `dg5 test no classes`) EQUALS JUST FALSE
-- Notice in accordance with section 222; it sets forth the amendment or a brief summary, unless it is a notice of internet availability.
#ASSERT `s 242(b)(1) the amendment has been duly adopted` (`dg5 test stock adoption` TRUE TRUE TRUE FALSE TRUE FALSE TRUE 51 100 `dg5 test no classes`) EQUALS JUST FALSE
#ASSERT `s 242(b)(1) the amendment has been duly adopted` (`dg5 test stock adoption` TRUE TRUE TRUE TRUE FALSE TRUE TRUE 51 100 `dg5 test no classes`) EQUALS JUST TRUE
#ASSERT `s 242(b)(1) the amendment has been duly adopted` (`dg5 test stock adoption` TRUE TRUE TRUE TRUE FALSE FALSE TRUE 51 100 `dg5 test no classes`) EQUALS JUST FALSE
-- Each class entitled to vote as a class must also have a majority of its own outstanding stock in favor (cumulative with the overall majority).
#ASSERT `s 242(b)(1) the amendment has been duly adopted` (`dg5 test stock adoption` TRUE TRUE TRUE TRUE TRUE FALSE TRUE 51 100 (LIST `dg5 test class entitled 60 of 100`)) EQUALS JUST TRUE
#ASSERT `s 242(b)(1) the amendment has been duly adopted` (`dg5 test stock adoption` TRUE TRUE TRUE TRUE TRUE FALSE TRUE 51 100 (LIST `dg5 test class entitled 50 of 100`)) EQUALS JUST FALSE
#ASSERT `s 242(b)(1) the amendment has been duly adopted` (`dg5 test stock adoption` TRUE TRUE TRUE TRUE TRUE FALSE TRUE 51 100 (LIST `dg5 test class entitled 51 of 100`, `dg5 test class entitled 60 of 100`)) EQUALS JUST TRUE
#ASSERT `s 242(b)(1) the amendment has been duly adopted` (`dg5 test stock adoption` TRUE TRUE TRUE TRUE TRUE FALSE TRUE 51 100 (LIST `dg5 test class entitled 60 of 100`, `dg5 test class entitled 50 of 100`)) EQUALS JUST FALSE
-- A class majority does not make up for a missing overall majority.
#ASSERT `s 242(b)(1) the amendment has been duly adopted` (`dg5 test stock adoption` TRUE TRUE TRUE TRUE TRUE FALSE TRUE 50 100 (LIST `dg5 test class entitled 60 of 100`)) EQUALS JUST FALSE
-- A class not entitled to vote as a class is ignored.
#ASSERT `s 242(b)(1) the amendment has been duly adopted` (`dg5 test stock adoption` TRUE TRUE TRUE TRUE TRUE FALSE TRUE 51 100 (LIST `dg5 test class not entitled`)) EQUALS JUST TRUE
-- Counts that cannot be a vote: not covered.
#ASSERT `s 242(b)(1) the amendment has been duly adopted` (`dg5 test stock adoption` TRUE TRUE TRUE TRUE TRUE FALSE TRUE 5 0 `dg5 test no classes`) EQUALS NOTHING
#ASSERT `s 242(b)(1) the amendment has been duly adopted` (`dg5 test stock adoption` TRUE TRUE TRUE TRUE TRUE FALSE TRUE 51 100 (LIST `dg5 test class impossible counts`)) EQUALS NOTHING
-- Filing and effectiveness (section 103 is an input).
#ASSERT `s 242(b)(1) the amendment becomes effective in accordance with s 103` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 242(b)(1) the amendment becomes effective in accordance with s 103` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 242(b)(1) the amendment becomes effective in accordance with s 103` (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 242(b)(1) the amendment becomes effective in accordance with s 103` (JUST FALSE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 242(b)(1) the amendment becomes effective in accordance with s 103` NOTHING TRUE TRUE EQUALS NOTHING

§ `Section 242(b)(2) -- the class vote`

-- helper arguments, in order: changes the aggregate number of authorized shares, changes par value, alters powers adversely, affects only a series,
-- the certificate lets a majority of the stock change the number, would go below the number outstanding.
GIVEN num IS A BOOLEAN
      par IS A BOOLEAN
      adv IS A BOOLEAN
      ser IS A BOOLEAN
      opt IS A BOOLEAN
      low IS A BOOLEAN
GIVETH A `dg5 s 242(b)(2) Effect of a proposed amendment on a class`
`dg5 test class effect` num par adv ser opt low MEANS
    `dg5 s 242(b)(2) Effect of a proposed amendment on a class` WITH
          `the amendment would increase or decrease the aggregate number of authorized shares of the class` IS num
        , `the amendment would increase or decrease the par value of the shares of the class` IS par
        , `the amendment would alter or change the powers, preferences, or special rights of the shares of the class so as to affect them adversely` IS adv
        , `the amendment would so affect only 1 or more series of the class and not the entire class` IS ser
        , `the certificate provides that the number of authorized shares of the class may be changed by the vote of a majority of the stock entitled to vote` IS opt
        , `the amendment would take the number of authorized shares of the class below the number then outstanding` IS low

-- Changing the aggregate number of authorized shares gives the class a vote ...
#ASSERT `s 242(b)(2) the holders who vote as a class on the amendment` (`dg5 test class effect` TRUE FALSE FALSE FALSE FALSE FALSE) EQUALS `the holders of the whole class vote as a class`
-- ... unless the certificate so provides, and the number does not go below the number outstanding.
#ASSERT `s 242(b)(2) the holders who vote as a class on the amendment` (`dg5 test class effect` TRUE FALSE FALSE FALSE TRUE FALSE) EQUALS `no class vote is required on the amendment under paragraph (b)(2)`
#ASSERT `s 242(b)(2) the holders who vote as a class on the amendment` (`dg5 test class effect` TRUE FALSE FALSE FALSE TRUE TRUE) EQUALS `the holders of the whole class vote as a class`
-- Par value: always a class vote, whatever the certificate says about the number.
#ASSERT `s 242(b)(2) the holders who vote as a class on the amendment` (`dg5 test class effect` FALSE TRUE FALSE FALSE FALSE FALSE) EQUALS `the holders of the whole class vote as a class`
#ASSERT `s 242(b)(2) the holders who vote as a class on the amendment` (`dg5 test class effect` TRUE TRUE FALSE FALSE TRUE FALSE) EQUALS `the holders of the whole class vote as a class`
-- Adverse alteration of powers, preferences or special rights: the whole class if it affects the entire class; only the series if only series are affected.
#ASSERT `s 242(b)(2) the holders who vote as a class on the amendment` (`dg5 test class effect` FALSE FALSE TRUE FALSE FALSE FALSE) EQUALS `the holders of the whole class vote as a class`
#ASSERT `s 242(b)(2) the holders who vote as a class on the amendment` (`dg5 test class effect` FALSE FALSE TRUE TRUE FALSE FALSE) EQUALS `only the holders of the series so affected vote as a separate class`
-- A series-only adverse alteration together with a change of the aggregate number that has no opt-out: the whole class.
#ASSERT `s 242(b)(2) the holders who vote as a class on the amendment` (`dg5 test class effect` TRUE FALSE TRUE TRUE FALSE FALSE) EQUALS `the holders of the whole class vote as a class`
-- ... with the opt-out, the number needs no class vote and the series alone votes.
#ASSERT `s 242(b)(2) the holders who vote as a class on the amendment` (`dg5 test class effect` TRUE FALSE TRUE TRUE TRUE FALSE) EQUALS `only the holders of the series so affected vote as a separate class`
-- None of the triggers.
#ASSERT `s 242(b)(2) the holders who vote as a class on the amendment` (`dg5 test class effect` FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS `no class vote is required on the amendment under paragraph (b)(2)`
-- The majority-of-the-stock route for the number of authorized shares.
#ASSERT `s 242(b)(2) the number of authorized shares may be changed by a majority of the stock entitled to vote irrespective of the class vote` (`dg5 test class effect` TRUE FALSE FALSE FALSE TRUE FALSE)
#ASSERT NOT (`s 242(b)(2) the number of authorized shares may be changed by a majority of the stock entitled to vote irrespective of the class vote` (`dg5 test class effect` TRUE FALSE FALSE FALSE TRUE TRUE))
#ASSERT NOT (`s 242(b)(2) the number of authorized shares may be changed by a majority of the stock entitled to vote irrespective of the class vote` (`dg5 test class effect` TRUE FALSE FALSE FALSE FALSE FALSE))
-- The holder's own question.
#ASSERT `s 242(b)(2) the holder is entitled to vote as a class` `the holders of the whole class vote as a class` TRUE FALSE
#ASSERT NOT (`s 242(b)(2) the holder is entitled to vote as a class` `the holders of the whole class vote as a class` FALSE FALSE)
#ASSERT `s 242(b)(2) the holder is entitled to vote as a class` `only the holders of the series so affected vote as a separate class` TRUE TRUE
#ASSERT NOT (`s 242(b)(2) the holder is entitled to vote as a class` `only the holders of the series so affected vote as a separate class` TRUE FALSE)
#ASSERT NOT (`s 242(b)(2) the holder is entitled to vote as a class` `no class vote is required on the amendment under paragraph (b)(2)` TRUE TRUE)

§ `Section 242(b)(3) and (4) -- nonstock corporations; a certificate requiring a greater vote`

-- helper arguments, in order: resolution, number of members of the governing body, number in favor, the certificate requires member approval, members approved.
GIVEN r IS A BOOLEAN
      n IS A NUMBER
      f IS A NUMBER
      rq IS A BOOLEAN
      ap IS A BOOLEAN
GIVETH A `dg5 s 242(b)(3) Adoption of an amendment by a nonstock corporation`
`dg5 test nonstock adoption` r n f rq ap MEANS
    `dg5 s 242(b)(3) Adoption of an amendment by a nonstock corporation` WITH
          `the governing body adopted a resolution setting forth the amendment proposed and declaring its advisability` IS r
        , `the number of members of the governing body` IS n
        , `the number of members of the governing body voting in favor` IS f
        , `the certificate requires approval by a specified number or percentage of the members or of a specified class of members` IS rq
        , `the members or the specified class of members approved the amendment by that number or percentage` IS ap

-- "a majority of all the members of the governing body": 3 of 5 carries; 2 of 4 does not.
#ASSERT `s 242(b)(3) the amendment has been duly adopted` (`dg5 test nonstock adoption` TRUE 5 3 FALSE FALSE) EQUALS JUST TRUE
#ASSERT `s 242(b)(3) the amendment has been duly adopted` (`dg5 test nonstock adoption` TRUE 4 2 FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 242(b)(3) the amendment has been duly adopted` (`dg5 test nonstock adoption` FALSE 5 5 FALSE FALSE) EQUALS JUST FALSE
-- The certificate requires a specified number or percentage of the members to approve as well.
#ASSERT `s 242(b)(3) the amendment has been duly adopted` (`dg5 test nonstock adoption` TRUE 5 3 TRUE TRUE) EQUALS JUST TRUE
#ASSERT `s 242(b)(3) the amendment has been duly adopted` (`dg5 test nonstock adoption` TRUE 5 3 TRUE FALSE) EQUALS JUST FALSE
#ASSERT `s 242(b)(3) the amendment has been duly adopted` (`dg5 test nonstock adoption` TRUE 5 2 TRUE TRUE) EQUALS JUST FALSE
#ASSERT `s 242(b)(3) the amendment has been duly adopted` (`dg5 test nonstock adoption` TRUE 0 0 FALSE FALSE) EQUALS NOTHING
-- Paragraph (b)(4): a certificate that requires a greater vote than any section requires, say at least 2/3 of the outstanding stock: that vote is needed to alter the provision.
#ASSERT `s 242(b)(4) the vote needed to alter, amend or repeal the provision requiring the greater vote` (JUST (`at least` (2 DIVIDED BY 3) `the outstanding stock entitled to vote`)) EQUALS JUST (`at least` (2 DIVIDED BY 3) `the outstanding stock entitled to vote`)
#ASSERT `s 242(b)(4) the vote needed to alter, amend or repeal the provision requiring the greater vote` NOTHING EQUALS NOTHING
-- 2/3 of 99 is exactly 66: "at least" is reached at 66, not at 65.
#ASSERT `the vote carries` (`at least` (2 DIVIDED BY 3) `the outstanding stock entitled to vote`) 65 99 EQUALS JUST FALSE
#ASSERT `the vote carries` (`at least` (2 DIVIDED BY 3) `the outstanding stock entitled to vote`) 66 99 EQUALS JUST TRUE
#ASSERT `the vote carries` (`at least` (2 DIVIDED BY 3) `the outstanding stock entitled to vote`) 67 99 EQUALS JUST TRUE

§ `Section 242(c) and (d)`

-- Abandonment before the filing has become effective, if the resolution so provides.
#ASSERT `s 242(c) the board of directors or governing body may abandon the proposed amendment without further action by the stockholders or members` TRUE FALSE
#ASSERT NOT (`s 242(c) the board of directors or governing body may abandon the proposed amendment without further action by the stockholders or members` TRUE TRUE)
#ASSERT NOT (`s 242(c) the board of directors or governing body may abandon the proposed amendment without further action by the stockholders or members` FALSE FALSE)

-- helper arguments, in order: a majority-vote provision exists, it expressly says the corporation is not governed by (d)(1) or (2), it requires a greater vote, the certificate otherwise expressly requires a vote.
GIVEN m IS A BOOLEAN
      s IS A BOOLEAN
      g IS A BOOLEAN
      o IS A BOOLEAN
GIVETH A `dg5 s 242(d) Certificate provision on the number of authorized shares`
`dg5 test certificate provision` m s g o MEANS
    `dg5 s 242(d) Certificate provision on the number of authorized shares` WITH
          `the certificate provides that the number of authorized shares of 1 or more classes may be increased or decreased by a majority of the stock entitled to vote irrespective of the last sentence of paragraph (b)(2)` IS m
        , `that provision expressly states that the corporation is not to be governed by paragraph (d)(1) or (2), or both` IS s
        , `that provision requires a greater or additional vote than is contemplated by the last sentence of paragraph (b)(2)` IS g
        , `the certificate otherwise expressly requires a meeting or vote of stockholders` IS o

-- The closing paragraph of (d): the majority-vote provision alone is not an express requirement.
#ASSERT NOT (`s 242(d) the certificate expressly requires otherwise` (`dg5 test certificate provision` TRUE FALSE FALSE FALSE))
#ASSERT `s 242(d) the certificate expressly requires otherwise` (`dg5 test certificate provision` TRUE TRUE FALSE FALSE)
#ASSERT `s 242(d) the certificate expressly requires otherwise` (`dg5 test certificate provision` TRUE FALSE TRUE FALSE)
#ASSERT `s 242(d) the certificate expressly requires otherwise` (`dg5 test certificate provision` FALSE FALSE FALSE TRUE)
#ASSERT NOT (`s 242(d) the certificate expressly requires otherwise` (`dg5 test certificate provision` FALSE FALSE FALSE FALSE))
-- The two qualifications only qualify that provision: without it they are nothing.
#ASSERT NOT (`s 242(d) the certificate expressly requires otherwise` (`dg5 test certificate provision` FALSE TRUE TRUE FALSE))

-- Paragraph (d)(1)(A).
GIVETH A LIST OF `dg5 s 242(a) Change a corporation may make by amendment`
`dg5 test no changes` MEANS EMPTY

#ASSERT `s 242(d)(1)(A) the amendment affects only changes described in paragraph (a)(1) or (7)` (LIST `a change of the corporate name`)
#ASSERT `s 242(d)(1)(A) the amendment affects only changes described in paragraph (a)(1) or (7)` (LIST `a change of the corporate name`, `the deletion of the provisions of the original certificate of incorporation which named the incorporators, the initial board of directors and the original subscribers for shares`)
#ASSERT NOT (`s 242(d)(1)(A) the amendment affects only changes described in paragraph (a)(1) or (7)` (LIST `a change of the corporate name`, `a change of the period of its duration`))
#ASSERT NOT (`s 242(d)(1)(A) the amendment affects only changes described in paragraph (a)(1) or (7)` `dg5 test no changes`)

-- Paragraph (d)(1)(B): helper arguments, in order: subdivides, only 1 class, divided into series, issued before, issued after, authorized before, authorized after.
GIVEN sd IS A BOOLEAN
      oc IS A BOOLEAN
      ds IS A BOOLEAN
      ib IS A NUMBER
      ia IS A NUMBER
      ab IS A NUMBER
      aa IS A NUMBER
GIVETH A `dg5 s 242(d)(1) Subdivision of the issued shares of a class`
`dg5 test subdivision` sd oc ds ib ia ab aa MEANS
    `dg5 s 242(d)(1) Subdivision of the issued shares of a class` WITH
          `the amendment reclassifies by subdividing the issued shares of a class into a greater number of issued shares of the same class` IS sd
        , `the corporation has only 1 class of stock outstanding` IS oc
        , `that class is divided into series` IS ds
        , `the number of issued shares of the class before the subdivision` IS ib
        , `the number of issued shares of the class after the subdivision` IS ia
        , `the number of authorized shares of the class before the amendment` IS ab
        , `the number of authorized shares of the class after the amendment` IS aa

-- A 2-for-1 subdivision (100 issued shares become 200): the authorized number may rise up to 2 times, from 1,000 to 2,000.
#ASSERT `s 242(d)(1)(B) the amendment is a subdivision that needs no vote` (`dg5 test subdivision` TRUE TRUE FALSE 100 200 1000 2000)
#ASSERT `s 242(d)(1)(B) the amendment is a subdivision that needs no vote` (`dg5 test subdivision` TRUE TRUE FALSE 100 200 1000 1500)
#ASSERT NOT (`s 242(d)(1)(B) the amendment is a subdivision that needs no vote` (`dg5 test subdivision` TRUE TRUE FALSE 100 200 1000 2001))
#ASSERT NOT (`s 242(d)(1)(B) the amendment is a subdivision that needs no vote` (`dg5 test subdivision` FALSE TRUE FALSE 100 200 1000 2000))
#ASSERT NOT (`s 242(d)(1)(B) the amendment is a subdivision that needs no vote` (`dg5 test subdivision` TRUE FALSE FALSE 100 200 1000 2000))
#ASSERT NOT (`s 242(d)(1)(B) the amendment is a subdivision that needs no vote` (`dg5 test subdivision` TRUE TRUE TRUE 100 200 1000 2000))
-- Paragraph (d)(1) as a whole.
#ASSERT `s 242(d)(1) no meeting or vote of stockholders is required to adopt the amendment` TRUE FALSE FALSE
#ASSERT `s 242(d)(1) no meeting or vote of stockholders is required to adopt the amendment` FALSE TRUE FALSE
#ASSERT NOT (`s 242(d)(1) no meeting or vote of stockholders is required to adopt the amendment` FALSE FALSE FALSE)
#ASSERT NOT (`s 242(d)(1) no meeting or vote of stockholders is required to adopt the amendment` TRUE TRUE TRUE)

-- Paragraph (d)(2): helper arguments, in order: the kind of amendment, listed before, meets the holders requirement after, meeting and vote as a single class,
-- votes for, votes against, a class without provision under the last sentence of (b)(2), class votes for, class votes against.
GIVEN k IS A BOOLEAN
      l IS A BOOLEAN
      h IS A BOOLEAN
      mv IS A BOOLEAN
      vf IS A NUMBER
      va IS A NUMBER
      cp IS A BOOLEAN
      cf IS A NUMBER
      ca IS A NUMBER
GIVETH A `dg5 s 242(d)(2) Amendment of the number of authorized shares by a listed corporation`
`dg5 test listed amendment` k l h mv vf va cp cf ca MEANS
    `dg5 s 242(d)(2) Amendment of the number of authorized shares by a listed corporation` WITH
          `the amendment increases or decreases the authorized number of shares of a class of capital stock or reclassifies by combining the issued shares of a class into a lesser number of issued shares of the same class` IS k
        , `the shares of the class are listed on a national securities exchange immediately before the amendment becomes effective` IS l
        , `the shares meet the listing requirements of that exchange relating to the minimum number of holders immediately after the amendment becomes effective` IS h
        , `a meeting was called in accordance with paragraph (b)(1) and a vote of the stockholders entitled to vote, voting as a single class, was taken for and against the proposed amendment` IS mv
        , `the votes cast for the amendment` IS vf
        , `the votes cast against the amendment` IS va
        , `the amendment increases or decreases the authorized number of shares of a class for which no provision has been made under the last sentence of paragraph (b)(2)` IS cp
        , `the votes cast for the amendment by the holders of that class` IS cf
        , `the votes cast against the amendment by the holders of that class` IS ca

-- All conditions met, 60 votes for and 40 against.
#ASSERT `s 242(d)(2) the amendment may be made without the vote otherwise required by subsection (b)` (`dg5 test listed amendment` TRUE TRUE TRUE TRUE 60 40 FALSE 0 0)
-- "exceed": equal votes do not.
#ASSERT NOT (`s 242(d)(2) the amendment may be made without the vote otherwise required by subsection (b)` (`dg5 test listed amendment` TRUE TRUE TRUE TRUE 50 50 FALSE 0 0))
#ASSERT `s 242(d)(2) the amendment may be made without the vote otherwise required by subsection (b)` (`dg5 test listed amendment` TRUE TRUE TRUE TRUE 51 50 FALSE 0 0)
-- Each of (A), (B) and the kind of amendment is necessary.
#ASSERT NOT (`s 242(d)(2) the amendment may be made without the vote otherwise required by subsection (b)` (`dg5 test listed amendment` FALSE TRUE TRUE TRUE 60 40 FALSE 0 0))
#ASSERT NOT (`s 242(d)(2) the amendment may be made without the vote otherwise required by subsection (b)` (`dg5 test listed amendment` TRUE FALSE TRUE TRUE 60 40 FALSE 0 0))
#ASSERT NOT (`s 242(d)(2) the amendment may be made without the vote otherwise required by subsection (b)` (`dg5 test listed amendment` TRUE TRUE FALSE TRUE 60 40 FALSE 0 0))
#ASSERT NOT (`s 242(d)(2) the amendment may be made without the vote otherwise required by subsection (b)` (`dg5 test listed amendment` TRUE TRUE TRUE FALSE 60 40 FALSE 0 0))
-- (C): for a class with no (b)(2) provision, the votes of that class for must exceed the votes of that class against.
#ASSERT `s 242(d)(2) the amendment may be made without the vote otherwise required by subsection (b)` (`dg5 test listed amendment` TRUE TRUE TRUE TRUE 60 40 TRUE 11 10)
#ASSERT NOT (`s 242(d)(2) the amendment may be made without the vote otherwise required by subsection (b)` (`dg5 test listed amendment` TRUE TRUE TRUE TRUE 60 40 TRUE 10 10))
#ASSERT NOT (`s 242(d)(2) the amendment may be made without the vote otherwise required by subsection (b)` (`dg5 test listed amendment` TRUE TRUE TRUE TRUE 60 40 TRUE 9 10))
