#ASSERT NOT (`May I apply for trial on the appraisal before the persons entitled are finally determined` FALSE FALSE)
#ASSERT `May I participate fully in all the proceedings` TRUE FALSE
#ASSERT NOT (`May I participate fully in all the proceedings` TRUE TRUE)

-- The Court directs payment of the fair value $850,000 plus two quarters' interest at 3% discount rate (4.04%): $884,340.
#ASSERT `How much will the Court direct the entity to pay me` 850000 FALSE 0 (LIST 3%, 3%) 0 EQUALS JUST 884340
-- Not covered where the interest is not.
#ASSERT `How much will the Court direct the entity to pay me` 850000 FALSE 0 (LIST 3%, 3%) 10 EQUALS NOTHING

-- The entity is a Delaware or other State's entity: the decree is enforceable as other decrees are.
#ASSERT `Can the Court's decree be enforced against an entity formed under this law` `this State` EQUALS JUST TRUE
#ASSERT `Can the Court's decree be enforced against an entity formed under this law` `another jurisdiction of the United States` EQUALS JUST TRUE
-- Not covered: an entity formed outside the United States is not an entity "of any state".
#ASSERT `Can the Court's decree be enforced against an entity formed under this law` `a foreign jurisdiction outside the United States` EQUALS NOTHING

#ASSERT `May the costs of the proceeding be taxed upon me` TRUE TRUE
#ASSERT NOT (`May the costs of the proceeding be taxed upon me` FALSE TRUE)
#ASSERT NOT (`May the costs of the proceeding be taxed upon me` TRUE FALSE)
#ASSERT `May I apply for an order that my expenses be charged against the appraised shares` TRUE TRUE TRUE
#ASSERT NOT (`May I apply for an order that my expenses be charged against the appraised shares` TRUE TRUE FALSE)
-- $90,000 of expenses ordered; my shares are worth $2,000,000 of $18,000,000: one ninth, $10,000.
#ASSERT `How much of the expenses ordered will be charged against my shares` 90000 2000000 18000000 EQUALS JUST 10000
-- Not covered: nothing to spread the charge over.
#ASSERT `How much of the expenses ordered will be charged against my shares` 90000 2000000 0 EQUALS NOTHING

-- I demanded appraisal; the transaction became effective on 25 June 2026; the vote is on 26 June.
#ASSERT `Am I barred from voting my shares now that I have demanded appraisal` TRUE FALSE (YearMonthDay 2026 6 26) (YearMonthDay 2026 6 25) EQUALS JUST TRUE
-- A vote the day before the effective date.
#ASSERT `Am I barred from voting my shares now that I have demanded appraisal` TRUE FALSE (YearMonthDay 2026 6 24) (YearMonthDay 2026 6 25) EQUALS JUST FALSE
-- My right has since ended: the text does not say whether the bar lifts.
#ASSERT `Am I barred from voting my shares now that I have demanded appraisal` TRUE TRUE (YearMonthDay 2026 7 26) (YearMonthDay 2026 6 25) EQUALS NOTHING
-- A dividend paid on 15 July on a record date of 1 July: barred.
#ASSERT `Am I barred from receiving this dividend now that I have demanded appraisal` TRUE FALSE (YearMonthDay 2026 7 15) (YearMonthDay 2026 7 1) (YearMonthDay 2026 6 25) EQUALS JUST TRUE
-- ... on a record date before the effective date: not barred.
#ASSERT `Am I barred from receiving this dividend now that I have demanded appraisal` TRUE FALSE (YearMonthDay 2026 7 15) (YearMonthDay 2026 6 24) (YearMonthDay 2026 6 25) EQUALS JUST FALSE

-- Withdrawing in writing on 24 August 2026 (the 60th day): my right to appraisal ceases.
#ASSERT `Does my right to appraisal of the shares end when I withdraw my demand` TRUE (YearMonthDay 2026 8 24) FALSE (YearMonthDay 2026 6 25)
-- On 25 August without the corporation's approval: it does not.
#ASSERT NOT (`Does my right to appraisal of the shares end when I withdraw my demand` TRUE (YearMonthDay 2026 8 25) FALSE (YearMonthDay 2026 6 25))
-- ... with the corporation's written approval: it does.
#ASSERT `Does my right to appraisal of the shares end when I withdraw my demand` TRUE (YearMonthDay 2026 8 25) TRUE (YearMonthDay 2026 6 25)

#ASSERT `Is the Court's approval needed to dismiss the proceeding as to me` TRUE
#ASSERT NOT (`Is the Court's approval needed to dismiss the proceeding as to me` FALSE)

-- The first petition was filed on 23 October 2026, the last day: the right continues.
#ASSERT NOT (`Has the right to appraisal of all shares ended because no petition was filed in time` TRUE (YearMonthDay 2026 10 23) (YearMonthDay 2026 6 25) (YearMonthDay 2027 1 1))
-- A petition filed on 24 October 2026: too late.
#ASSERT `Has the right to appraisal of all shares ended because no petition was filed in time` TRUE (YearMonthDay 2026 10 24) (YearMonthDay 2026 6 25) (YearMonthDay 2027 1 1)
-- No petition so far, asked on the last day, and the day after.
#ASSERT NOT (`Has the right to appraisal of all shares ended because no petition was filed in time` FALSE (YearMonthDay 2026 1 1) (YearMonthDay 2026 6 25) (YearMonthDay 2026 10 23))
#ASSERT `Has the right to appraisal of all shares ended because no petition was filed in time` FALSE (YearMonthDay 2026 1 1) (YearMonthDay 2026 6 25) (YearMonthDay 2026 10 24)

-- The shares I would have received but for my demand are authorized but not outstanding while I remain entitled.
#ASSERT `Do the shares I would have received have the status of authorized but not outstanding` TRUE TRUE
#ASSERT NOT (`Do the shares I would have received have the status of authorized but not outstanding` TRUE FALSE)
