§ `Section 391(c) - copies`

-- $10 for the first page and $2.00 for each additional page
#ASSERT `s 391(c) the fee for photocopies or electronic image copies that the Secretary of State does not certify` 1 EQUALS JUST 10
#ASSERT `s 391(c) the fee for photocopies or electronic image copies that the Secretary of State does not certify` 2 EQUALS JUST 12
#ASSERT `s 391(c) the fee for photocopies or electronic image copies that the Secretary of State does not certify` 5 EQUALS JUST 18
-- no pages: not a case the text describes
#ASSERT `s 391(c) the fee for photocopies or electronic image copies that the Secretary of State does not certify` 0 EQUALS NOTHING
-- the forms: photocopies and electronic image copies against payment; never an electronic medium or any other form
#ASSERT `s 391(c) the Secretary of State must provide the public records in the form asked for` `photocopies of public records` TRUE
#ASSERT NOT `s 391(c) the Secretary of State must provide the public records in the form asked for` `photocopies of public records` FALSE
#ASSERT `s 391(c) the Secretary of State must provide the public records in the form asked for` `electronic image copies of public records` TRUE
#ASSERT NOT `s 391(c) the Secretary of State must provide the public records in the form asked for` `electronic image copies of public records` FALSE
#ASSERT NOT `s 391(c) the Secretary of State must provide the public records in the form asked for` `copies, or access to copies, in an electronic medium or in any other form, including bulk data, databases and digital copies` TRUE

§ `Section 391(d), (e), (f), (g)`

#ASSERT `s 391(d) no fee for the use of the State is charged or collected from the corporation` TRUE EQUALS JUST TRUE
#ASSERT `s 391(d) no fee for the use of the State is charged or collected from the corporation` FALSE EQUALS NOTHING
#ASSERT `s 391(e) the fees may be paid on credit` TRUE
#ASSERT NOT `s 391(e) the fees may be paid on credit` FALSE
-- (f): the fund is "at least $500, but not more than $1,500"
#ASSERT `s 391(f) the least sum that the Secretary of State retains as a fund for refunds` EQUALS 500
#ASSERT `s 391(f) the greatest sum that the Secretary of State retains as a fund for refunds` EQUALS 1_500
#ASSERT `s 391(f) the fund retained for refunds is within the permitted range` 500
#ASSERT NOT `s 391(f) the fund retained for refunds is within the permitted range` 499.99
#ASSERT `s 391(f) the fund retained for refunds is within the permitted range` 1_500
#ASSERT NOT `s 391(f) the fund retained for refunds is within the permitted range` 1_500.01
-- a refund of a payment "to the extent that it exceeds the fees required"
#ASSERT `s 391(f) the part of a payment that exceeds the fees required, which the Secretary of State may refund` 150 115 EQUALS 35
#ASSERT `s 391(f) the part of a payment that exceeds the fees required, which the Secretary of State may refund` 115 115 EQUALS 0
#ASSERT `s 391(f) the part of a payment that exceeds the fees required, which the Secretary of State may refund` 100 115 EQUALS 0
-- (g): $60 for a returned check, if the Secretary of State exercises the discretion. Arguments: a check for a Chapter 1 or 6 fee or tax?, returned?, discretion exercised?
#ASSERT `s 391(g) the charge for a returned check` TRUE TRUE TRUE EQUALS JUST 60
#ASSERT `s 391(g) the charge for a returned check` TRUE TRUE FALSE EQUALS JUST 0
#ASSERT `s 391(g) the charge for a returned check` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 391(g) the charge for a returned check` TRUE FALSE TRUE EQUALS NOTHING

