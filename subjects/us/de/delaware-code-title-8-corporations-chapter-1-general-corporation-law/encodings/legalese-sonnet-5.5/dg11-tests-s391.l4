#ASSERT `s 391(h) the additional sum in the schedule is within the limit` `completed within a 24-hour period from the time of the request` TRUE FALSE 300.01 EQUALS JUST FALSE
#ASSERT `s 391(h) the additional sum in the schedule is within the limit` `completed within a 24-hour period from the time of the request` TRUE FALSE (0 MINUS 1) EQUALS JUST FALSE
#ASSERT `s 391(h) the additional sum in the schedule is within the limit` `completed at a speed that s 391(h) does not name` TRUE FALSE 10 EQUALS NOTHING

§ `Section 391(i) - loss of good standing`

-- The demand is mailed on 1 January 2026; the ninetieth day following is 1 April 2026 (31 + 28 + 31 = 90 days).
-- Arguments: neglected to pay a fee or tax?, date the demand was mailed, date of payment in full (if any), the date asked about.
-- the 89th day (31 March): not yet
#ASSERT NOT `s 391(i) the corporation has ceased to be in good standing or registered` TRUE (JUST (YMD 2026 1 1)) NOTHING (YMD 2026 3 31)
-- the 90th day (1 April): ceased
#ASSERT `s 391(i) the corporation has ceased to be in good standing or registered` TRUE (JUST (YMD 2026 1 1)) NOTHING (YMD 2026 4 1)
-- paid in full on the 89th day, "prior to the ninetieth day": saved
#ASSERT NOT `s 391(i) the corporation has ceased to be in good standing or registered` TRUE (JUST (YMD 2026 1 1)) (JUST (YMD 2026 3 31)) (YMD 2026 5 1)
-- paid in full on the 90th day: too late
#ASSERT `s 391(i) the corporation has ceased to be in good standing or registered` TRUE (JUST (YMD 2026 1 1)) (JUST (YMD 2026 4 1)) (YMD 2026 5 1)
-- no demand mailed
#ASSERT NOT `s 391(i) the corporation has ceased to be in good standing or registered` TRUE NOTHING NOTHING (YMD 2027 1 1)
-- no neglect to pay
#ASSERT NOT `s 391(i) the corporation has ceased to be in good standing or registered` FALSE (JUST (YMD 2026 1 1)) NOTHING (YMD 2027 1 1)
-- restoration: ceased, fee or tax paid; the subsection (g) fee too if applicable
#ASSERT `s 391(i) the corporation is restored to good standing or registered status` TRUE TRUE FALSE FALSE
#ASSERT NOT `s 391(i) the corporation is restored to good standing or registered status` TRUE TRUE TRUE FALSE
#ASSERT `s 391(i) the corporation is restored to good standing or registered status` TRUE TRUE TRUE TRUE
#ASSERT NOT `s 391(i) the corporation is restored to good standing or registered status` TRUE FALSE FALSE FALSE
#ASSERT NOT `s 391(i) the corporation is restored to good standing or registered status` FALSE TRUE FALSE FALSE
-- the bar on filing and on a certificate of good standing: while ceased and not restored
#ASSERT `s 391(i) the Secretary of State is barred from accepting an instrument for filing from the corporation or issuing a certificate of good standing for it` TRUE FALSE
#ASSERT NOT `s 391(i) the Secretary of State is barred from accepting an instrument for filing from the corporation or issuing a certificate of good standing for it` TRUE TRUE
#ASSERT NOT `s 391(i) the Secretary of State is barred from accepting an instrument for filing from the corporation or issuing a certificate of good standing for it` FALSE FALSE

§ `Section 391(j) - exempt corporation`

#ASSERT `s 391(j) the corporation is an exempt corporation` TRUE
#ASSERT NOT `s 391(j) the corporation is an exempt corporation` FALSE
