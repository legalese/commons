IMPORT prelude
IMPORT daydate
IMPORT `dg-core`
IMPORT `dg11-s391-fees`

-- Tests of dg11-s391-fees.l4 (section 391). Expected values are worked by hand from the text of the section and written beside each assertion;
-- none is copied from the rules' own output. Amounts are United States dollars.

-- A fixture: the authorized capital stock with this many shares having par value, of this par value each, and this many shares without par value.
GIVEN shares IS A NUMBER
      par IS A NUMBER
      nopar IS A NUMBER
GIVETH A `s 391 Authorized capital stock`
`a capital stock of` shares `shares at` par `each and` nopar `shares without par value` MEANS
    `s 391 Authorized capital stock` WITH
        `number of authorized shares having par value` IS shares
        `par value of each authorized share having par value, in dollars` IS par
        `number of authorized shares without par value` IS nopar

-- A fixture: a change that makes none of the four kinds of change, and the four kinds one at a time.
`no change of the four kinds` MEANS `s 391(b)(2) Change that a certificate makes to the authorized capital stock` WITH
    `increase in the number of shares` IS FALSE
    `increase in the par value of shares` IS FALSE
    `change of shares with par value into shares without par value` IS FALSE
    `change of shares without par value into shares with par value` IS FALSE

`an increase in the number of shares` MEANS `s 391(b)(2) Change that a certificate makes to the authorized capital stock` WITH
    `increase in the number of shares` IS TRUE
    `increase in the par value of shares` IS FALSE
    `change of shares with par value into shares without par value` IS FALSE
    `change of shares without par value into shares with par value` IS FALSE

`a change of par value shares into no par value shares` MEANS `s 391(b)(2) Change that a certificate makes to the authorized capital stock` WITH
    `increase in the number of shares` IS FALSE
    `increase in the par value of shares` IS FALSE
    `change of shares with par value into shares without par value` IS TRUE
    `change of shares without par value into shares with par value` IS FALSE

`an increase in the par value of shares` MEANS `s 391(b)(2) Change that a certificate makes to the authorized capital stock` WITH
    `increase in the number of shares` IS FALSE
    `increase in the par value of shares` IS TRUE
    `change of shares with par value into shares without par value` IS FALSE
    `change of shares without par value into shares with par value` IS FALSE

§ `Section 391(a) - the party that is paid`

#ASSERT `s 391(a) the party to whom the fees and penalties are paid` EQUALS `the Secretary of State`

§ `Section 391(b)(1) and (a)(1) - the fee on an original certificate of incorporation`

-- (b)(1): authorized, not outstanding.
#ASSERT `s 391(b)(1) the number of shares counted as the authorized capital stock` 1_000 500 EQUALS 1_000

-- The bands. 25,000 shares: 5,000 of them lie above 20,000 and up to 200,000; 10,000 shares: none; 300,000 shares: 180,000 (the whole band).
#ASSERT `s 391(a)(1) the number of shares inside the band above lower and up to and including upper` 25_000 20_000 200_000 EQUALS 5_000
#ASSERT `s 391(a)(1) the number of shares inside the band above lower and up to and including upper` 10_000 20_000 200_000 EQUALS 0
#ASSERT `s 391(a)(1) the number of shares inside the band above lower and up to and including upper` 300_000 20_000 200_000 EQUALS 180_000
#ASSERT `s 391(a)(1) the number of shares inside the band above lower and up to and including upper` 20_000 0 20_000 EQUALS 20_000

-- Each whole $100 of authorized capital stock counts as 1 assessable share; a part of $100 does not count.
#ASSERT `s 391(a)(1) the assessable shares counted for stock having par value` 10_000 EQUALS 100
#ASSERT `s 391(a)(1) the assessable shares counted for stock having par value` 100 EQUALS 1
#ASSERT `s 391(a)(1) the assessable shares counted for stock having par value` 99 EQUALS 0
#ASSERT `s 391(a)(1) the assessable shares counted for stock having par value` 199 EQUALS 1
#ASSERT `s 391(a)(1) the assessable shares counted for stock having par value` 250 EQUALS 2
#ASSERT `s 391(a)(1) the assessable shares counted for stock having par value` 0 EQUALS 0

-- Shares having par value: $0.02 up to and including 20,000; $0.01 for those over 20,000 up to and including 200,000; 2/5 of $0.01 for those over 200,000.
#ASSERT `s 391(a)(1) the fee on assessable shares of stock having par value` 0 EQUALS 0
#ASSERT `s 391(a)(1) the fee on assessable shares of stock having par value` 1 EQUALS 0.02
#ASSERT `s 391(a)(1) the fee on assessable shares of stock having par value` 20_000 EQUALS 400
#ASSERT `s 391(a)(1) the fee on assessable shares of stock having par value` 20_001 EQUALS 400.01
#ASSERT `s 391(a)(1) the fee on assessable shares of stock having par value` 200_000 EQUALS 2_200
#ASSERT `s 391(a)(1) the fee on assessable shares of stock having par value` 200_001 EQUALS 2_200.004
#ASSERT `s 391(a)(1) the fee on assessable shares of stock having par value` 300_000 EQUALS 2_600

-- Shares without par value: $0.01 up to and including 20,000; 1/2 of $0.01 for those over 20,000 up to and including 2,000,000; 2/5 of $0.01 for those over 2,000,000.
#ASSERT `s 391(a)(1) the fee on shares without par value` 0 EQUALS 0
#ASSERT `s 391(a)(1) the fee on shares without par value` 1 EQUALS 0.01
#ASSERT `s 391(a)(1) the fee on shares without par value` 20_000 EQUALS 200
#ASSERT `s 391(a)(1) the fee on shares without par value` 20_001 EQUALS 200.005
#ASSERT `s 391(a)(1) the fee on shares without par value` 2_000_000 EQUALS 10_100
#ASSERT `s 391(a)(1) the fee on shares without par value` 2_000_001 EQUALS 10_100.004
#ASSERT `s 391(a)(1) the fee on shares without par value` 3_000_000 EQUALS 14_100

-- Both schedules added: $2,000,000 of par value stock (20,000 assessable shares, $400) and 20,000 shares without par value ($200) is $600;
-- $10,000 of par value stock (100 assessable shares, $2.00) and 1,000 shares without par value ($10) is $12.
#ASSERT `s 391(a)(1) the fee at the foregoing rates` 2_000_000 20_000 EQUALS 600
#ASSERT `s 391(a)(1) the fee at the foregoing rates` 10_000 1_000 EQUALS 12
#ASSERT `s 391(a)(1) the total par value of the authorized shares of the capital stock` (`a capital stock of` 1_000_000 `shares at` 0.01 `each and` 0 `shares without par value`) EQUALS 10_000
#ASSERT `s 391(a)(1) the fee at the foregoing rates on the authorized capital stock` (`a capital stock of` 1_000_000 `shares at` 0.01 `each and` 1_000 `shares without par value`) EQUALS 12

-- The floor of $15: "In no case shall the amount paid be less than $15." 749 assessable shares are $14.98 -> $15; 750 are exactly $15; 751 are $15.02.
#ASSERT `s 391(a)(1) the least fee on an original certificate of incorporation` EQUALS 15
#ASSERT `s 391(a)(1) the fee on an original certificate of incorporation` (`a capital stock of` 74_900 `shares at` 1 `each and` 0 `shares without par value`) EQUALS 15
#ASSERT `s 391(a)(1) the fee on an original certificate of incorporation` (`a capital stock of` 75_000 `shares at` 1 `each and` 0 `shares without par value`) EQUALS 15
#ASSERT `s 391(a)(1) the fee on an original certificate of incorporation` (`a capital stock of` 75_100 `shares at` 1 `each and` 0 `shares without par value`) EQUALS 15.02
-- 1,000,000 shares of $0.01 par value: $10,000 -> 100 assessable shares -> $2.00 -> floor $15.
#ASSERT `s 391(a)(1) the fee on an original certificate of incorporation` (`a capital stock of` 1_000_000 `shares at` 0.01 `each and` 0 `shares without par value`) EQUALS 15
-- 100,000,000 shares of $0.001 par value: $100,000 -> 1,000 assessable shares -> $20.00.
#ASSERT `s 391(a)(1) the fee on an original certificate of incorporation` (`a capital stock of` 100_000_000 `shares at` 0.001 `each and` 0 `shares without par value`) EQUALS 20
-- No par value stock only: 1,000 shares -> $10.00 -> floor $15; 20,000 shares -> $200.
#ASSERT `s 391(a)(1) the fee on an original certificate of incorporation` (`a capital stock of` 0 `shares at` 0 `each and` 1_000 `shares without par value`) EQUALS 15
#ASSERT `s 391(a)(1) the fee on an original certificate of incorporation` (`a capital stock of` 0 `shares at` 0 `each and` 20_000 `shares without par value`) EQUALS 200

§ `Section 391(b)(2) and (a)(2), (a)(3) - amendments and restated certificates`

-- (b)(2): both conditions are needed. 1,000,000 shares of $1 par value (10,000 assessable, $200) -> 3,000,000 shares (30,000 assessable: $400 + $100 = $500): an increase.
#ASSERT `s 391(b)(2) the certificate is considered as increasing the authorized capital stock` `an increase in the number of shares` (`a capital stock of` 3_000_000 `shares at` 1 `each and` 0 `shares without par value`) (`a capital stock of` 1_000_000 `shares at` 1 `each and` 0 `shares without par value`)
-- 10,000 -> 10,050 shares of $1 par value: more shares, but 100 assessable shares both before and after, so the fee does not exceed: not an increase.
#ASSERT NOT `s 391(b)(2) the certificate is considered as increasing the authorized capital stock` `an increase in the number of shares` (`a capital stock of` 10_050 `shares at` 1 `each and` 0 `shares without par value`) (`a capital stock of` 10_000 `shares at` 1 `each and` 0 `shares without par value`)
-- None of the four kinds of change is made (the facts say so) although the fee computed would be higher: not an increase.
#ASSERT NOT `s 391(b)(2) the certificate is considered as increasing the authorized capital stock` `no change of the four kinds` (`a capital stock of` 3_000_000 `shares at` 1 `each and` 0 `shares without par value`) (`a capital stock of` 1_000_000 `shares at` 1 `each and` 0 `shares without par value`)
-- Par value stock changed into stock without par value: 10,000 shares of $1 par value ($2.00) -> 10,000 shares without par value ($100): an increase.
#ASSERT `s 391(b)(2) the certificate is considered as increasing the authorized capital stock` `a change of par value shares into no par value shares` (`a capital stock of` 0 `shares at` 0 `each and` 10_000 `shares without par value`) (`a capital stock of` 10_000 `shares at` 1 `each and` 0 `shares without par value`)
-- An increase in the par value of shares: 10,000 shares at $1 -> 10,000 shares at $5 (100 -> 500 assessable shares, $2 -> $10): an increase.
#ASSERT `s 391(b)(2) the certificate is considered as increasing the authorized capital stock` `an increase in the par value of shares` (`a capital stock of` 10_000 `shares at` 5 `each and` 0 `shares without par value`) (`a capital stock of` 10_000 `shares at` 1 `each and` 0 `shares without par value`)
-- A reduction in the capital: the fee after is lower, so not an increase.
#ASSERT NOT `s 391(b)(2) the certificate is considered as increasing the authorized capital stock` `an increase in the number of shares` (`a capital stock of` 1_000_000 `shares at` 1 `each and` 0 `shares without par value`) (`a capital stock of` 3_000_000 `shares at` 1 `each and` 0 `shares without par value`)

-- (a)(2): the difference of the fees at the foregoing rates, never less than $30.
#ASSERT `s 391(a)(2) the least fee on a certificate increasing the authorized capital stock` EQUALS 30
-- $500 (30,000 assessable shares) less $200 (10,000) is $300.
#ASSERT `s 391(a)(2) the fee on a certificate increasing the authorized capital stock` (`a capital stock of` 3_000_000 `shares at` 1 `each and` 0 `shares without par value`) (`a capital stock of` 1_000_000 `shares at` 1 `each and` 0 `shares without par value`) EQUALS 300
-- $30.00 (1,500) less $20.00 (1,000) is $10 -> floor $30.
#ASSERT `s 391(a)(2) the fee on a certificate increasing the authorized capital stock` (`a capital stock of` 150_000 `shares at` 1 `each and` 0 `shares without par value`) (`a capital stock of` 100_000 `shares at` 1 `each and` 0 `shares without par value`) EQUALS 30
-- exactly $30: $430 (23,000 assessable shares) less $400 (20,000); and a cent more: $430.01 (23,001) less $400.
#ASSERT `s 391(a)(2) the fee on a certificate increasing the authorized capital stock` (`a capital stock of` 2_300_000 `shares at` 1 `each and` 0 `shares without par value`) (`a capital stock of` 2_000_000 `shares at` 1 `each and` 0 `shares without par value`) EQUALS 30
#ASSERT `s 391(a)(2) the fee on a certificate increasing the authorized capital stock` (`a capital stock of` 2_300_100 `shares at` 1 `each and` 0 `shares without par value`) (`a capital stock of` 2_000_000 `shares at` 1 `each and` 0 `shares without par value`) EQUALS 30.01

-- (a)(3): $30 for an amendment, a restated certificate or a certificate of retirement of stock that does not increase the capital; $5.00 for any other certificate; nothing in the case of an exempt corporation.
#ASSERT `s 391(a)(3) the fee on a certificate of amendment or restated certificate not involving an increase, or a certificate of retirement of stock` FALSE EQUALS 30
#ASSERT `s 391(a)(3) the fee on a certificate of amendment or restated certificate not involving an increase, or a certificate of retirement of stock` TRUE EQUALS 0
#ASSERT `s 391(a)(3) the fee on any other certificate relating to corporations, not otherwise provided for` FALSE EQUALS 5
#ASSERT `s 391(a)(3) the fee on any other certificate relating to corporations, not otherwise provided for` TRUE EQUALS 0
#ASSERT `s 391(a)(3) the fee under paragraph (a)(3) in the case of an exempt corporation` EQUALS 0

-- The paragraph that applies is decided by (b)(2).
#ASSERT `s 391(a)(2) or (3) the fee on a certificate of amendment or a restated certificate` `an increase in the number of shares` (`a capital stock of` 3_000_000 `shares at` 1 `each and` 0 `shares without par value`) (`a capital stock of` 1_000_000 `shares at` 1 `each and` 0 `shares without par value`) FALSE EQUALS 300
#ASSERT `s 391(a)(2) or (3) the fee on a certificate of amendment or a restated certificate` `no change of the four kinds` (`a capital stock of` 1_000_000 `shares at` 1 `each and` 0 `shares without par value`) (`a capital stock of` 1_000_000 `shares at` 1 `each and` 0 `shares without par value`) FALSE EQUALS 30
#ASSERT `s 391(a)(2) or (3) the fee on a certificate of amendment or a restated certificate` `no change of the four kinds` (`a capital stock of` 1_000_000 `shares at` 1 `each and` 0 `shares without par value`) (`a capital stock of` 1_000_000 `shares at` 1 `each and` 0 `shares without par value`) TRUE EQUALS 0
-- an exempt corporation that DOES increase its capital pays under (a)(2), not (a)(3)
#ASSERT `s 391(a)(2) or (3) the fee on a certificate of amendment or a restated certificate` `an increase in the number of shares` (`a capital stock of` 3_000_000 `shares at` 1 `each and` 0 `shares without par value`) (`a capital stock of` 1_000_000 `shares at` 1 `each and` 0 `shares without par value`) TRUE EQUALS 300

§ `Section 391(a)(4) - certificates of merger or consolidation`

-- Two constituents of 1,000,000 shares of $1 par value each (10,000 assessable shares each; together 20,000: $400); the new corporation 5,000,000 shares of $1 par value (50,000: $400 + 30,000 x $0.01 = $700).
-- The difference is $300.
#ASSERT `s 391(a)(4) the fee on a certificate of merger or consolidation, from the aggregate figures` (`a capital stock of` 5_000_000 `shares at` 1 `each and` 0 `shares without par value`) 2_000_000 0 EQUALS 300
-- The aggregate is ONE computation, not the sum of each constituent's fee: two constituents of 15,000 assessable shares each ($300 each, $600 as a sum) together make 30,000 ($400 + $100 = $500);
-- the new corporation 100,000 assessable shares ($400 + 80,000 x $0.01 = $1,200); the difference is $700, not $600.
#ASSERT `s 391(a)(4) the fee on a certificate of merger or consolidation of 2 or more corporations` (`a capital stock of` 10_000_000 `shares at` 1 `each and` 0 `shares without par value`) (LIST (`a capital stock of` 1_500_000 `shares at` 1 `each and` 0 `shares without par value`), (`a capital stock of` 1_500_000 `shares at` 1 `each and` 0 `shares without par value`)) EQUALS 700
-- the least fee is $75: no difference, or a negative difference, still pays $75; a difference of exactly $75 pays $75; a cent more pays $75.01
#ASSERT `s 391(a)(4) the least fee on a certificate of merger or consolidation` EQUALS 75
#ASSERT `s 391(a)(4) the fee on a certificate of merger or consolidation, from the aggregate figures` (`a capital stock of` 2_000_000 `shares at` 1 `each and` 0 `shares without par value`) 2_000_000 0 EQUALS 75
#ASSERT `s 391(a)(4) the fee on a certificate of merger or consolidation, from the aggregate figures` (`a capital stock of` 1_000_000 `shares at` 1 `each and` 0 `shares without par value`) 2_000_000 0 EQUALS 75
#ASSERT `s 391(a)(4) the fee on a certificate of merger or consolidation, from the aggregate figures` (`a capital stock of` 2_750_000 `shares at` 1 `each and` 0 `shares without par value`) 2_000_000 0 EQUALS 75
#ASSERT `s 391(a)(4) the fee on a certificate of merger or consolidation, from the aggregate figures` (`a capital stock of` 2_750_100 `shares at` 1 `each and` 0 `shares without par value`) 2_000_000 0 EQUALS 75.01
-- shares without par value count in the aggregate: constituents 10,000 and 12,000 shares without par value together 22,000 ($200 + 2,000 x $0.005 = $210); the new corporation 25,000 ($200 + 5,000 x $0.005 = $225): $15 -> $75
#ASSERT `s 391(a)(4) the fee on a certificate of merger or consolidation of 2 or more corporations` (`a capital stock of` 0 `shares at` 0 `each and` 25_000 `shares without par value`) (LIST (`a capital stock of` 0 `shares at` 0 `each and` 10_000 `shares without par value`), (`a capital stock of` 0 `shares at` 0 `each and` 12_000 `shares without par value`)) EQUALS 75
-- the fee is in addition to a tax or fee of another law on a constituent that is not a corporation
#ASSERT `s 391(a)(4) the total payable on the certificate of merger or consolidation, with the tax or fee of another law` 300 25.50 EQUALS 325.5

§ `Section 391(a)(5) - certificates of dissolution`

-- $50 for a certificate that certifies all three of 1, 2 and 3; $40 otherwise (each of the three missing in turn).
`a dissolution certificate certifying all three` MEANS `s 391(a)(5) What a certificate of dissolution certifies` OF TRUE, TRUE, TRUE
`a dissolution certificate not certifying no assets` MEANS `s 391(a)(5) What a certificate of dissolution certifies` OF FALSE, TRUE, TRUE
`a dissolution certificate not certifying minimum franchise tax` MEANS `s 391(a)(5) What a certificate of dissolution certifies` OF TRUE, FALSE, TRUE
`a dissolution certificate not certifying taxes paid` MEANS `s 391(a)(5) What a certificate of dissolution certifies` OF TRUE, TRUE, FALSE

#ASSERT `s 391(a)(5)b. the certificate of dissolution is one that qualifies for the fee of $50` `a dissolution certificate certifying all three`
#ASSERT NOT `s 391(a)(5)b. the certificate of dissolution is one that qualifies for the fee of $50` `a dissolution certificate not certifying no assets`
#ASSERT NOT `s 391(a)(5)b. the certificate of dissolution is one that qualifies for the fee of $50` `a dissolution certificate not certifying minimum franchise tax`
#ASSERT NOT `s 391(a)(5)b. the certificate of dissolution is one that qualifies for the fee of $50` `a dissolution certificate not certifying taxes paid`
#ASSERT `s 391(a)(5) the fee on a certificate of dissolution` `a dissolution certificate certifying all three` EQUALS 50
#ASSERT `s 391(a)(5) the fee on a certificate of dissolution` `a dissolution certificate not certifying no assets` EQUALS 40
#ASSERT `s 391(a)(5) the fee on a certificate of dissolution` `a dissolution certificate not certifying minimum franchise tax` EQUALS 40
#ASSERT `s 391(a)(5) the fee on a certificate of dissolution` `a dissolution certificate not certifying taxes paid` EQUALS 40

§ `Section 391(a)(6) and (a)(7)`

#ASSERT `s 391(a)(6) the fee on a certificate of reinstatement of a foreign corporation or a certificate of surrender and withdrawal from the State by a foreign corporation` EQUALS 10
#ASSERT `s 391(a)(7) the fee on a paper for which no different fee is specifically prescribed` EQUALS 115
#ASSERT `s 391(a)(7) the fee on a certificate of incorporation filed as required by § 102` EQUALS 25
#ASSERT `s 391(a)(7) the fee for entering information from an instrument into the Delaware Corporation Information System` EQUALS 5
#ASSERT `s 391(a)(7)a. the certificate of dissolution is not subject to the fee of $115` `a dissolution certificate certifying all three`
#ASSERT NOT `s 391(a)(7)a. the certificate of dissolution is not subject to the fee of $115` `a dissolution certificate not certifying taxes paid`
-- Fees that paragraph (a)(7) lays on one instrument. Arguments: a certificate of incorporation under s 102?, a different fee specifically prescribed?, a qualifying dissolution certificate?
-- a certificate of incorporation: $5 + $25
#ASSERT `s 391(a)(7) the fees that paragraph (a)(7) lays on an instrument` TRUE TRUE FALSE EQUALS 30
-- a paper with no different fee prescribed: $5 + $115
#ASSERT `s 391(a)(7) the fees that paragraph (a)(7) lays on an instrument` FALSE FALSE FALSE EQUALS 120
-- a paper for which another paragraph prescribes a fee: $5 only
#ASSERT `s 391(a)(7) the fees that paragraph (a)(7) lays on an instrument` FALSE TRUE FALSE EQUALS 5
-- a qualifying certificate of dissolution is not subject to the $115 fee: $5 only
#ASSERT `s 391(a)(7) the fees that paragraph (a)(7) lays on an instrument` FALSE FALSE TRUE EQUALS 5
#ASSERT `s 391(a)(7) the fees that paragraph (a)(7) lays on an instrument` FALSE TRUE TRUE EQUALS 5

§ `Section 391(a)(8) - annual report of a foreign corporation`

#ASSERT `s 391(a)(8) the fee on the annual report of a foreign corporation doing business in this State` EQUALS 250
#ASSERT `s 391(a)(8) the penalty for failing to file the annual report on or before June 30` EQUALS 200
-- "on or before June 30 each year": filed on June 30 -> no penalty; filed on July 1 -> penalty; not yet filed: penalty once the date asked about is after June 30.
#ASSERT NOT `s 391(a)(8) the foreign corporation owes the penalty for the year` 2025 (JUST (YMD 2025 6 30)) (YMD 2025 12 31)
#ASSERT `s 391(a)(8) the foreign corporation owes the penalty for the year` 2025 (JUST (YMD 2025 7 1)) (YMD 2025 12 31)
#ASSERT NOT `s 391(a)(8) the foreign corporation owes the penalty for the year` 2025 (JUST (YMD 2025 6 1)) (YMD 2025 12 31)
#ASSERT NOT `s 391(a)(8) the foreign corporation owes the penalty for the year` 2025 NOTHING (YMD 2025 6 30)
#ASSERT `s 391(a)(8) the foreign corporation owes the penalty for the year` 2025 NOTHING (YMD 2025 7 1)

§ `Section 391(a)(9) and (a)(10) - recording, indexing, certified copies`

#ASSERT `s 391(a)(9) the fee for recording and indexing articles of association and other papers required to be recorded` 500 EQUALS 5
#ASSERT `s 391(a)(9) the fee for recording and indexing articles of association and other papers required to be recorded` 1 EQUALS 0.01
#ASSERT `s 391(a)(9) the fee for recording and indexing articles of association and other papers required to be recorded` 0 EQUALS 0
-- $50 for each copy certified; and $2.00 a page where the Secretary of State provides the copies
#ASSERT `s 391(a)(10) the fee for certifying copies of a paper on file` 1 3 TRUE EQUALS 56
#ASSERT `s 391(a)(10) the fee for certifying copies of a paper on file` 2 3 TRUE EQUALS 112
#ASSERT `s 391(a)(10) the fee for certifying copies of a paper on file` 2 3 FALSE EQUALS 100
#ASSERT `s 391(a)(10) the fee for certifying copies of a paper on file` 0 3 TRUE EQUALS 0

§ `Section 391(a)(11) to (a)(15)`

#ASSERT `s 391(a)(11) the most that may be charged for each certificate` `a certificate of the Secretary of State other than a certification of a copy and other than one reciting all of a corporation's filings` EQUALS 50
#ASSERT `s 391(a)(11) the most that may be charged for each certificate` `a certificate of the Secretary of State that recites all of a corporation's filings with the Secretary of State` EQUALS 175
#ASSERT `s 391(a)(11) the most that may be charged for each certificate` `a certificate of the Secretary of State issued via the Division's online services` EQUALS 175
#ASSERT `s 391(a)(12) the fee on a certificate of change of location or change of registered agent` EQUALS 50
#ASSERT NOT `s 391(a)(12) a fee under § 103(c)(6) or (c)(7) is charged on the certificate of change of location or change of registered agent`
-- $50 plus the same fees as for a certificate of incorporation, here stated by the filer as $30
#ASSERT `s 391(a)(13) the fee on a certificate of change of address or change of name of registered agent` 30 EQUALS 80
#ASSERT `s 391(a)(14) the fee on a certificate of resignation of a registered agent and appointment of a successor` EQUALS 50
-- $2.00 for each corporation whose registered agent has resigned by the certificate
#ASSERT `s 391(a)(15) the fee on a certificate of resignation of a registered agent without appointment of a successor` 1 EQUALS 2
#ASSERT `s 391(a)(15) the fee on a certificate of resignation of a registered agent without appointment of a successor` 3 EQUALS 6

§ `Section 391(a)(16) to (a)(18)`

#ASSERT `s 391(a)(16) the most that may be charged for a written report of a record search` EQUALS 200
#ASSERT `s 391(a)(17) the fee for preclearance of a document for filing` FALSE EQUALS 350
#ASSERT `s 391(a)(17) the fee for preclearance of a document for filing` TRUE EQUALS 1_500
#ASSERT `s 391(a)(18) the fee on an annual franchise tax report of a corporation` TRUE EQUALS 25
#ASSERT `s 391(a)(18) the fee on an annual franchise tax report of a corporation` FALSE EQUALS 50

§ `Section 391(a)(19) to (a)(29)`

-- (a)(19): $165 plus the fee on an original certificate of incorporation. 1,000,000 shares of $0.01 par value: fee $2.00 -> $15 floor -> $180; 2,000,000 shares of $1: $400 -> $565.
#ASSERT `s 391(a)(19) the fee on a certificate of domestication and certificate of incorporation prescribed in § 388(d)` (`a capital stock of` 1_000_000 `shares at` 0.01 `each and` 0 `shares without par value`) EQUALS 180
#ASSERT `s 391(a)(19) the fee on a certificate of domestication and certificate of incorporation prescribed in § 388(d)` (`a capital stock of` 2_000_000 `shares at` 1 `each and` 0 `shares without par value`) EQUALS 565
#ASSERT `s 391(a)(20) the fee on the documents prescribed in § 389(c)` EQUALS 10_000
#ASSERT `s 391(a)(21) the annual fee on the documents prescribed in § 389(d)` EQUALS 2_500
#ASSERT `s 391(a)(22) the fee of the Secretary of State for a service for which this section provides no fee` 123.45 EQUALS 123.45
#ASSERT `s 391(a)(23) the total fees an exempt corporation pays on a certificate of change of registered agent or registered office or a certificate of revival` EQUALS 5
#ASSERT NOT `s 391(a)(23) an assessment under § 103(c)(6) or (c)(7) is charged on an exempt corporation's certificate of change of registered agent or registered office or certificate of revival`
#ASSERT `s 391(a)(24) the most that may be charged for accepting a corporate name reservation application, a renewal application or a notice of transfer or cancellation` EQUALS 75
#ASSERT `s 391(a)(25) the fee on a certificate of transfer or a certificate of continuance prescribed in § 390` EQUALS 1_000
-- (a)(26): $115 plus the fee on an original certificate of incorporation: $115 + $15 = $130; $115 + $400 = $515.
#ASSERT `s 391(a)(26) the fee on a certificate of conversion and certificate of incorporation prescribed in § 265` (`a capital stock of` 1_000_000 `shares at` 0.01 `each and` 0 `shares without par value`) EQUALS 130
#ASSERT `s 391(a)(26) the fee on a certificate of conversion and certificate of incorporation prescribed in § 265` (`a capital stock of` 2_000_000 `shares at` 1 `each and` 0 `shares without par value`) EQUALS 515
#ASSERT `s 391(a)(27) the fee on a certificate of conversion prescribed in § 266` EQUALS 165
-- (a)(28): $2,500; plus the (a)(2) fee if the certificate of validation increases the authorized capital stock.
#ASSERT `s 391(a)(28) the fee on a certificate of validation prescribed in § 204` `no change of the four kinds` (`a capital stock of` 1_000_000 `shares at` 1 `each and` 0 `shares without par value`) (`a capital stock of` 1_000_000 `shares at` 1 `each and` 0 `shares without par value`) EQUALS 2_500
#ASSERT `s 391(a)(28) the fee on a certificate of validation prescribed in § 204` `an increase in the number of shares` (`a capital stock of` 3_000_000 `shares at` 1 `each and` 0 `shares without par value`) (`a capital stock of` 1_000_000 `shares at` 1 `each and` 0 `shares without par value`) EQUALS 2_800
-- an increase worth only $5 of fee: the (a)(2) floor of $30 applies to the additional fee
#ASSERT `s 391(a)(28) the fee on a certificate of validation prescribed in § 204` `an increase in the number of shares` (`a capital stock of` 2_050_000 `shares at` 1 `each and` 0 `shares without par value`) (`a capital stock of` 2_000_000 `shares at` 1 `each and` 0 `shares without par value`) EQUALS 2_530
#ASSERT `s 391(a)(29) the fee for accepting service of process under this title` EQUALS 100

