IMPORT prelude
IMPORT daydate
IMPORT `dg-core`
IMPORT `dg4-s219-stockholder-list`

-- Tests of dg4-s219-stockholder-list.l4. Expected values are written by hand from the text of s 219
-- (de-code-t8-ch1-2026-10-01.txt, lines 835-839), beside each assertion, never copied from the module's own output.

§ `Tests of s 219`

§§ `(a): the list`

-- the meeting is on 20 March 2026: the list is due no later than the tenth day before, 10 March
#ASSERT `s 219(a) the last day by which the corporation must prepare the list` (YMD 2026 3 20) EQUALS YMD 2026 3 10
#ASSERT `s 219(a) the last day by which the corporation must prepare the list` (YMD 2026 3 5) EQUALS YMD 2026 2 23
-- the record date is less than 10 days before the meeting: the list reflects the stockholders as of the tenth day before (10 March)
#ASSERT `s 219(a) the day as of which the list reflects the stockholders entitled to vote` (YMD 2026 3 15) (YMD 2026 3 20) EQUALS YMD 2026 3 10
#ASSERT `s 219(a) the day as of which the list reflects the stockholders entitled to vote` (YMD 2026 3 11) (YMD 2026 3 20) EQUALS YMD 2026 3 10
-- the record date is 10 or more days before the meeting: the record date
#ASSERT `s 219(a) the day as of which the list reflects the stockholders entitled to vote` (YMD 2026 3 10) (YMD 2026 3 20) EQUALS YMD 2026 3 10
#ASSERT `s 219(a) the day as of which the list reflects the stockholders entitled to vote` (YMD 2026 3 1) (YMD 2026 3 20) EQUALS YMD 2026 3 1
-- contents
#ASSERT `s 219(a) the list contains what the subsection requires` TRUE TRUE TRUE
#ASSERT NOT (`s 219(a) the list contains what the subsection requires` FALSE TRUE TRUE)
#ASSERT NOT (`s 219(a) the list contains what the subsection requires` TRUE FALSE TRUE)
#ASSERT NOT (`s 219(a) the list contains what the subsection requires` TRUE TRUE FALSE)
#ASSERT NOT (`s 219(a) the list must include electronic mail addresses or other electronic contact information`)
-- examination: for 10 days ending on the day before the meeting (10 March to 19 March inclusive)
#ASSERT `s 219(a) the stockholder may examine the list` TRUE TRUE (YMD 2026 3 10) (YMD 2026 3 20) FALSE TRUE
#ASSERT `s 219(a) the stockholder may examine the list` TRUE TRUE (YMD 2026 3 19) (YMD 2026 3 20) FALSE TRUE
#ASSERT NOT (`s 219(a) the stockholder may examine the list` TRUE TRUE (YMD 2026 3 9) (YMD 2026 3 20) FALSE TRUE)
#ASSERT NOT (`s 219(a) the stockholder may examine the list` TRUE TRUE (YMD 2026 3 20) (YMD 2026 3 20) FALSE TRUE)
-- either manner will do
#ASSERT `s 219(a) the stockholder may examine the list` TRUE TRUE (YMD 2026 3 15) (YMD 2026 3 20) TRUE FALSE
#ASSERT NOT (`s 219(a) the stockholder may examine the list` TRUE TRUE (YMD 2026 3 15) (YMD 2026 3 20) FALSE FALSE)
-- only a stockholder, and only for a purpose germane to the meeting
#ASSERT NOT (`s 219(a) the stockholder may examine the list` FALSE TRUE (YMD 2026 3 15) (YMD 2026 3 20) TRUE TRUE)
#ASSERT NOT (`s 219(a) the stockholder may examine the list` TRUE FALSE (YMD 2026 3 15) (YMD 2026 3 20) TRUE TRUE)
#ASSERT `s 219(a) the corporation may take reasonable steps to ensure the information is available only to stockholders` TRUE
#ASSERT NOT (`s 219(a) the corporation may take reasonable steps to ensure the information is available only to stockholders` FALSE)

§§ `(b): refusal`

#ASSERT `s 219(b) the stockholder may apply to the Court of Chancery for an order to compel the corporation to permit the examination` TRUE TRUE
#ASSERT NOT (`s 219(b) the stockholder may apply to the Court of Chancery for an order to compel the corporation to permit the examination` TRUE FALSE)
#ASSERT NOT (`s 219(b) the stockholder may apply to the Court of Chancery for an order to compel the corporation to permit the examination` FALSE TRUE)
#ASSERT `s 219(b) the party who bears the burden of proof that the examination sought is for a purpose not germane to the meeting` EQUALS `the corporation`
#ASSERT `s 219(b) the Court of Chancery may make the order` `a summary order that the corporation permit examination of the list upon such conditions as the Court deems appropriate` TRUE
#ASSERT `s 219(b) the Court of Chancery may make the order` `an additional order postponing the meeting` TRUE
#ASSERT `s 219(b) the Court of Chancery may make the order` `an additional order voiding the results of the meeting` TRUE
#ASSERT `s 219(b) the Court of Chancery may make the order` `any other additional order that is appropriate` TRUE
#ASSERT NOT (`s 219(b) the Court of Chancery may make the order` `an additional order voiding the results of the meeting` FALSE)

§§ `(c): the stock ledger`

#ASSERT `s 219(c) the records are the stock ledger` TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 219(c) the records are the stock ledger` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`s 219(c) the records are the stock ledger` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 219(c) the records are the stock ledger` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 219(c) the records are the stock ledger` TRUE TRUE TRUE FALSE)
#ASSERT `s 219(c) the stock ledger shows the person to be a stockholder entitled to examine the list or to vote` TRUE
#ASSERT NOT (`s 219(c) the stock ledger shows the person to be a stockholder entitled to examine the list or to vote` FALSE)
