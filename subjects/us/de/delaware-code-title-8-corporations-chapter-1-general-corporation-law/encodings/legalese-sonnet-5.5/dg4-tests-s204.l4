#ASSERT `s 204(e)(1) the corporation must file a certificate of validation in lieu of the certificate the other section requires` TRUE TRUE TRUE
#ASSERT NOT (`s 204(e)(1) the corporation must file a certificate of validation in lieu of the certificate the other section requires` TRUE FALSE FALSE)
#ASSERT NOT (`s 204(e)(1) the corporation must file a certificate of validation in lieu of the certificate the other section requires` FALSE TRUE TRUE)

§§ `(e)(2): one certificate for each act, with two exceptions`

-- src:697: a separate certificate for each act, except (i) a single certificate would have been filed under another provision, (ii) overissues
#ASSERT `s 204(e)(2) each of two or more acts needs its own certificate of validation` FALSE FALSE
#ASSERT NOT (`s 204(e)(2) each of two or more acts needs its own certificate of validation` TRUE FALSE)
#ASSERT NOT (`s 204(e)(2) each of two or more acts needs its own certificate of validation` FALSE TRUE)
#ASSERT NOT (`s 204(e)(2) each of two or more acts needs its own certificate of validation` TRUE TRUE)
-- the increase in authorized shares is effective as of the date of the first overissue
