#ASSERT `Does section 233 apply to a notice under another section (s 233(d))` 222

§ `Section 241 -- amendment before payment for stock`

#ASSERT `May the corporation amend its certificate of incorporation before it has received payment for any of its stock (s 241(a))` TRUE FALSE FALSE TRUE
#ASSERT NOT (`May the corporation amend its certificate of incorporation before it has received payment for any of its stock (s 241(a))` TRUE TRUE FALSE TRUE)
-- Directors were named and have qualified: 3 directors, 2 in favor.
#ASSERT `Has the amendment been adopted by the incorporators or the directors, as section 241 requires (s 241(b))` TRUE 2 0 3 2 EQUALS JUST TRUE
-- No directors yet: 2 incorporators, 1 in favor is not a majority.
#ASSERT `Has the amendment been adopted by the incorporators or the directors, as section 241 requires (s 241(b))` FALSE 2 1 0 0 EQUALS JUST FALSE
#ASSERT `Is the certificate of amendment in order (s 241(b))` TRUE TRUE TRUE TRUE
-- Pam is substantially and adversely affected: the amendment is effective as to her from the filing date, 1 June 2026, not from 1 March 2026.
#ASSERT `From what date is the amendment effective as to me (s 241(b))` (YearMonthDay 2026 3 1) (YearMonthDay 2026 6 1) TRUE EQUALS YearMonthDay 2026 6 1
#ASSERT `From what date is the amendment effective as to me (s 241(b))` (YearMonthDay 2026 3 1) (YearMonthDay 2026 6 1) FALSE EQUALS YearMonthDay 2026 3 1

§ `Section 242 -- amendment after payment for stock`

#ASSERT `May the corporation amend its certificate of incorporation now that it has received payment for stock (s 242(a))` TRUE TRUE FALSE TRUE
#ASSERT `May several changes to the certificate be made in one certificate of amendment (s 242(a))` 3
-- 51 of 100 votes in favor; Class A (60 of 100) votes as a class and carries.
#ASSERT `Has the stockholders' amendment of the certificate been duly adopted (s 242(b)(1))` TRUE TRUE TRUE TRUE TRUE FALSE TRUE 51 100 TRUE 60 100 FALSE 0 0 EQUALS JUST TRUE
-- Class A has only 50 of 100: the overall majority is not enough.
#ASSERT `Has the stockholders' amendment of the certificate been duly adopted (s 242(b)(1))` TRUE TRUE TRUE TRUE TRUE FALSE TRUE 51 100 TRUE 50 100 FALSE 0 0 EQUALS JUST FALSE
-- NOT COVERED: the outstanding votes are zero, which cannot be a vote.
#ASSERT `Has the stockholders' amendment of the certificate been duly adopted (s 242(b)(1))` TRUE TRUE TRUE TRUE TRUE FALSE TRUE 5 0 FALSE 0 0 FALSE 0 0 EQUALS NOTHING
#ASSERT `Does the amendment take effect in accordance with section 103 (s 242(b)(1))` TRUE TRUE TRUE EQUALS JUST TRUE
-- Quinn holds Class A preferred. The amendment would cut the authorized number of Class A shares, and the certificate has no majority-vote provision: Quinn's class votes.
#ASSERT `Do I get to vote as a class on the proposed amendment (s 242(b)(2))` TRUE FALSE FALSE FALSE FALSE FALSE TRUE FALSE
-- MIRROR: the board asks which holders must vote as a class on the same amendment.
#ASSERT `Which holders must vote as a class on the proposed amendment (s 242(b)(2))` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS `the holders of the whole class vote as a class`
-- Only a series is adversely affected: Quinn holds shares of another series and has no class vote.
#ASSERT NOT (`Do I get to vote as a class on the proposed amendment (s 242(b)(2))` FALSE FALSE TRUE TRUE FALSE FALSE TRUE FALSE)
#ASSERT `Which holders must vote as a class on the proposed amendment (s 242(b)(2))` FALSE FALSE TRUE TRUE FALSE FALSE EQUALS `only the holders of the series so affected vote as a separate class`
#ASSERT `Can the number of authorized shares of a class be changed by a majority of all the stock entitled to vote, without a class vote (s 242(b)(2))` TRUE FALSE
-- A nonstock corporation: 3 of the 5 members of the governing body vote for the amendment.
#ASSERT `Has the nonstock corporation's amendment of its certificate been duly adopted (s 242(b)(3))` TRUE 5 3 FALSE FALSE EQUALS JUST TRUE
-- A certificate that requires two-thirds: 66 of 99 votes reach it, 65 do not.
#ASSERT `Does the vote carry to alter a provision of the certificate that requires a greater vote (s 242(b)(4))` TRUE 2 3 FALSE 66 99 EQUALS JUST TRUE
#ASSERT `Does the vote carry to alter a provision of the certificate that requires a greater vote (s 242(b)(4))` TRUE 2 3 FALSE 65 99 EQUALS JUST FALSE
-- NOT COVERED: the certificate requires no greater vote, so paragraph (b)(4) adds nothing.
#ASSERT `Does the vote carry to alter a provision of the certificate that requires a greater vote (s 242(b)(4))` FALSE 2 3 FALSE 66 99 EQUALS NOTHING
#ASSERT `May the board abandon the proposed amendment without asking the stockholders again (s 242(c))` TRUE FALSE
#ASSERT NOT (`May the board abandon the proposed amendment without asking the stockholders again (s 242(c))` TRUE TRUE)
-- A certificate with a majority-vote provision and nothing more does not expressly require a vote.
#ASSERT NOT (`Does my certificate expressly require a stockholder vote that subsection (d) would otherwise dispense with (s 242(d))` TRUE FALSE FALSE FALSE)
#ASSERT `Does my certificate expressly require a stockholder vote that subsection (d) would otherwise dispense with (s 242(d))` TRUE TRUE FALSE FALSE
-- A name change alone needs no stockholder vote.
#ASSERT `Does this amendment need a meeting or vote of the stockholders at all (s 242(d)(1))` TRUE FALSE FALSE FALSE FALSE FALSE FALSE 0 0 0 0 FALSE FALSE FALSE FALSE
-- A name change together with some other change does.
#ASSERT NOT (`Does this amendment need a meeting or vote of the stockholders at all (s 242(d)(1))` TRUE FALSE FALSE TRUE FALSE FALSE FALSE 0 0 0 0 FALSE FALSE FALSE FALSE)
-- A listed corporation: a majority of votes cast (60 for, 40 against) suffices for a change of its authorized number.
#ASSERT `Can a listed corporation change its authorized shares on a simple majority of votes cast, without the usual stockholder vote (s 242(d)(2))` TRUE TRUE TRUE TRUE 60 40 FALSE 0 0
#ASSERT NOT (`Can a listed corporation change its authorized shares on a simple majority of votes cast, without the usual stockholder vote (s 242(d)(2))` TRUE TRUE TRUE TRUE 50 50 FALSE 0 0)

§ `Section 243 -- retiring stock`

#ASSERT `May the corporation retire these shares by a resolution of its board (s 243(a))` TRUE TRUE
#ASSERT NOT (`May the corporation retire these shares by a resolution of its board (s 243(a))` TRUE FALSE)
#ASSERT `What is the status of shares the corporation has retired (s 243(b))` FALSE EQUALS `they resume the status of authorized and unissued shares of the class or series to which they belong`
#ASSERT `What is the status of shares the corporation has retired (s 243(b))` TRUE EQUALS `their status is what the certificate of incorporation provides`
#ASSERT `Must a certificate be filed saying that retired shares cannot be reissued (s 243(b))` TRUE
-- 300 of 1,000 authorized shares retired and barred from reissue: 700 remain.
#ASSERT `How many authorized shares of the class or series remain after the certificate on retired shares takes effect (s 243(b))` 1000 300 EQUALS JUST 700
#ASSERT `Is the class or series wiped out of the certificate when all its authorized shares are retired (s 243(b))` 1000 1000
#ASSERT `Must a reduction of capital that comes with the retirement go through section 244 (s 243(c))` TRUE

§ `Section 244 -- reducing capital`

-- Transfer to surplus of $200 of capital not represented by any class; the assets remaining ($500) equal the debts not provided for ($500).
#ASSERT `May the corporation reduce its capital in this way and by this amount (s 244)` `by transferring to surplus some or all of the capital not represented by any particular class of its capital stock` TRUE 200 0 0 200 0 0 0 0 500 500
-- $201 is more than the unallocated capital.
#ASSERT NOT (`May the corporation reduce its capital in this way and by this amount (s 244)` `by transferring to surplus some or all of the capital not represented by any particular class of its capital stock` TRUE 201 0 0 200 0 0 0 0 500 500)
#ASSERT `Are the corporation's remaining assets enough to pay its debts, so that it may reduce its capital (s 244(b))` 500 500
#ASSERT NOT (`Are the corporation's remaining assets enough to pay its debts, so that it may reduce its capital (s 244(b))` 499 500)
-- Rae's shares are only half paid: a reduction of capital does not release what she still owes.
#ASSERT `Am I still liable for the unpaid part of my shares if the corporation reduces its capital (s 244(b))` FALSE EQUALS JUST TRUE
-- NOT COVERED: fully paid shares carry no liability to release.
#ASSERT `Am I still liable for the unpaid part of my shares if the corporation reduces its capital (s 244(b))` TRUE EQUALS NOTHING

§ `Section 245 -- the restated certificate of incorporation`

#ASSERT `May the corporation integrate its certificate into a single restated certificate (s 245(a))` TRUE
#ASSERT `How must the restated certificate be adopted (s 245(b))` TRUE FALSE FALSE EQUALS `by the board of directors without a vote of the stockholders`
#ASSERT `How must the restated certificate be adopted (s 245(b))` FALSE TRUE FALSE EQUALS `adopted in the manner and by the vote prescribed by section 241`
#ASSERT `Does the restated certificate say everything it must (s 245(c))` TRUE TRUE FALSE FALSE TRUE TRUE FALSE FALSE
#ASSERT NOT (`Does the restated certificate say everything it must (s 245(c))` TRUE TRUE TRUE FALSE TRUE TRUE FALSE FALSE)
#ASSERT `Is it a further amendment to leave this provision out of the restated certificate (s 245(c))` `provisions of the original certificate of incorporation which named the incorporator or incorporators, the initial board of directors and the original subscribers for shares` EQUALS JUST TRUE
-- NOT COVERED: leaving out any other provision.
#ASSERT `Is it a further amendment to leave this provision out of the restated certificate (s 245(c))` `any other provision than the two that section 245(c) lets a restated certificate omit` EQUALS NOTHING
#ASSERT `Does the restated certificate take the place of the original certificate (s 245(d))` TRUE
#ASSERT `What is the corporation's date of incorporation once the restated certificate is filed (s 245(d))` (YearMonthDay 2019 4 2) EQUALS YearMonthDay 2019 4 2
#ASSERT `Is a change made in the restatement subject to another provision of the Law (s 245(e))` TRUE FALSE
#ASSERT NOT (`Is a change made in the restatement subject to another provision of the Law (s 245(e))` TRUE TRUE)
