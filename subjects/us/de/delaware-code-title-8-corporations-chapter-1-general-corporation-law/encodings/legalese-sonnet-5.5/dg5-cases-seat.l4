IMPORT prelude
IMPORT daydate
IMPORT `dg-core`
IMPORT `dg5-seat`

-- Worked cases for dg5-seat.l4: one case at least for each of the 118 questions, in the order of the seat, each with the facts a real person in the seat would state.
-- Every expected value is written by hand from the text (de-code-t8-ch1-2026-10-01.txt, src:891-1054), beside the assertion; none is copied from the encoding's own output.
-- Mirror cases (the same facts asked from the other side of the same relation, with answers that agree) are marked MIRROR.
-- A case outside the encoding (the text does not answer, so the answer is NOTHING) is marked NOT COVERED.

§ `Section 221 -- bonds, debentures and other obligations`

-- Mei holds debentures. The certificate gives debenture holders a vote: s 221 lets a corporation do that in its certificate.
#ASSERT `Can I vote on the corporation's affairs as a holder of its obligations (s 221)` TRUE TRUE
-- Her debentures carry a vote only because the certificate says so: where it does not, she has none.
#ASSERT NOT (`Can I vote on the corporation's affairs as a holder of its obligations (s 221)` TRUE FALSE)
#ASSERT `Do I have a stockholder's right of inspection as a holder of the corporation's obligations (s 221)` TRUE TRUE
#ASSERT `Am I treated as a stockholder for a stockholder vote as a holder of the corporation's obligations (s 221)` TRUE TRUE
#ASSERT NOT (`Am I treated as a stockholder for a stockholder vote as a holder of the corporation's obligations (s 221)` TRUE FALSE)
-- Ravi holds common stock. The certificate takes away the stockholders' vote on a matter and the matter is not a class vote under s 242(b)(2): he has lost the vote.
#ASSERT `Can the certificate take away my right as a stockholder to vote on this matter (s 221)` TRUE FALSE
-- ... but if the matter is a class vote under s 242(b)(2) (say a cut in his class's par value), the certificate cannot take it away.
#ASSERT NOT (`Can the certificate take away my right as a stockholder to vote on this matter (s 221)` TRUE TRUE)

§ `Section 222 -- notice of stockholders' meetings`

-- Ana is a stockholder of record on the record date for notice and may vote at the annual meeting at which stockholders will elect directors.
#ASSERT `Must the corporation give me notice of the stockholders' meeting (s 222)` TRUE TRUE TRUE
-- MIRROR: the secretary asks the same about Ana.
#ASSERT `Must we give this stockholder notice of the stockholders' meeting (s 222)` TRUE TRUE TRUE
-- Ben bought after the record date for notice: no notice is owed to him for this meeting.
#ASSERT NOT (`Must the corporation give me notice of the stockholders' meeting (s 222)` TRUE FALSE TRUE)
-- Notice on 20 June 2026 for a meeting on 30 June 2026 is 10 days before: inside the window. 21 June is 9 days before: too late.
#ASSERT `Was the notice of the meeting given early enough, and not too early (s 222)` (YearMonthDay 2026 6 20) (YearMonthDay 2026 6 30) FALSE 0 0 EQUALS JUST TRUE
#ASSERT `Was the notice of the meeting given early enough, and not too early (s 222)` (YearMonthDay 2026 6 21) (YearMonthDay 2026 6 30) FALSE 0 0 EQUALS JUST FALSE
-- A merger section that allows 20 to 90 days: notice on 10 June 2026 is 20 days before 30 June.
#ASSERT `Was the notice of the meeting given early enough, and not too early (s 222)` (YearMonthDay 2026 6 10) (YearMonthDay 2026 6 30) TRUE 20 90 EQUALS JUST TRUE
-- The special meeting has a place, remote participation and a different voting record date, and the notice states all of them and the purposes.
#ASSERT `Does the notice of the meeting say everything it must (s 222)` TRUE TRUE FALSE TRUE TRUE TRUE FALSE TRUE TRUE
-- ... but the notice of another special meeting leaves out the purposes.
#ASSERT NOT (`Does the notice of the meeting say everything it must (s 222)` TRUE TRUE FALSE TRUE TRUE TRUE FALSE TRUE FALSE)
-- The meeting of 1 June 2026 was adjourned to 15 June 2026 and the new time and place were announced at the meeting: Ana needs no further notice.
#ASSERT NOT (`Must I be given notice of the adjourned meeting (s 222(c))` FALSE TRUE FALSE FALSE (YearMonthDay 2026 6 1) (YearMonthDay 2026 6 15) FALSE TRUE)
-- Adjourned to 2 July 2026 (31 days): notice must be given even though it was announced.
#ASSERT `Must I be given notice of the adjourned meeting (s 222(c))` FALSE TRUE FALSE FALSE (YearMonthDay 2026 6 1) (YearMonthDay 2026 7 2) FALSE TRUE
-- MIRROR: the secretary asks the same about the 31-day adjournment.
#ASSERT `Must we give notice of the adjourned meeting (s 222(c))` FALSE TRUE FALSE FALSE (YearMonthDay 2026 6 1) (YearMonthDay 2026 7 2) FALSE
#ASSERT NOT (`Must we give notice of the adjourned meeting (s 222(c))` FALSE TRUE FALSE FALSE (YearMonthDay 2026 6 1) (YearMonthDay 2026 6 15) FALSE)
-- A new record date for voting was fixed for the adjourned meeting: the board must fix a new record date for notice.
#ASSERT `As a director, must the board fix a new record date for notice of the adjourned meeting (s 222(c))` TRUE
#ASSERT NOT (`As a director, must the board fix a new record date for notice of the adjourned meeting (s 222(c))` FALSE)
#ASSERT `May the corporation transact at the adjourned meeting the business that could have been transacted at the original meeting (s 222(c))` TRUE

§ `Section 223 -- vacancies and newly created directorships`

-- Five directors are in office; the seat was elected by all the stockholders as a single class; nothing in the certificate or bylaws says otherwise; three vote to fill it.
#ASSERT `Have the directors validly filled the vacancy or newly created directorship (s 223(a))` TRUE FALSE FALSE FALSE 5 3 EQUALS JUST TRUE
#ASSERT `Have the directors validly filled the vacancy or newly created directorship (s 223(a))` TRUE FALSE FALSE FALSE 4 2 EQUALS JUST FALSE
-- NOT COVERED: a seat that is neither a single-class seat nor a class or series seat.
#ASSERT `Have the directors validly filled the vacancy or newly created directorship (s 223(a))` FALSE FALSE FALSE FALSE 5 3 EQUALS NOTHING
-- The corporation has no directors. Dina, an officer, may call a special meeting in accordance with the bylaws, and may ask the Court for an election.
#ASSERT `May I call a special meeting of stockholders to elect directors when the corporation has none (s 223(a))` TRUE FALSE FALSE TRUE TRUE
#ASSERT NOT (`May I call a special meeting of stockholders to elect directors when the corporation has none (s 223(a))` FALSE FALSE FALSE TRUE TRUE)
#ASSERT `May I ask the Court of Chancery to order an election when the corporation has no directors (s 223(a))` FALSE TRUE FALSE TRUE
-- Directors chosen on a classified board hold office until the next election of their class, 20 May 2027.
#ASSERT `Until when does a director chosen to fill a vacancy hold office (s 223(b))` TRUE (YearMonthDay 2027 5 20) EQUALS JUST (YearMonthDay 2027 5 20)
-- NOT COVERED: no classes, so section 223(b) says nothing about the term.
#ASSERT `Until when does a director chosen to fill a vacancy hold office (s 223(b))` FALSE (YearMonthDay 2027 5 20) EQUALS NOTHING
-- Two of the five directors of the whole board are in office; Eve and others hold 10 of 100 votes: exactly 10 percent.
#ASSERT `May I, as a stockholder with enough stock, ask the Court of Chancery to order an election to fill vacancies (s 223(c))` 2 5 10 100 EQUALS JUST TRUE
#ASSERT `May I, as a stockholder with enough stock, ask the Court of Chancery to order an election to fill vacancies (s 223(c))` 2 5 9 100 EQUALS JUST FALSE
-- Five directors in office including one who has resigned from a future date; three vote to fill the resignation's vacancy.
#ASSERT `Can the directors fill a vacancy before a resigning director's resignation takes effect (s 223(d))` FALSE FALSE 5 3 EQUALS JUST TRUE

§ `Section 224 -- keeping the corporation's records`

-- The stock ledger is kept electronically, converts to paper, serves the stockholder list, records what the Law specifies and the transfers.
#ASSERT `May the corporation keep its records in electronic form (s 224)` TRUE TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`May the corporation keep its records in electronic form (s 224)` TRUE TRUE TRUE FALSE TRUE TRUE)
-- Fay is entitled to inspect under section 220: the corporation must give her the records on paper.
#ASSERT `Must the corporation give me its records on paper if I ask (s 224)` TRUE TRUE
#ASSERT `Is the paper copy of the corporation's records as good as the original in evidence (s 224)` TRUE TRUE

§ `Section 225 -- contested elections and proceedings in the Court`

-- Gus is a stockholder; he may ask the Court who is validly a director. An unrelated outsider may not.
#ASSERT `May I ask the Court of Chancery to decide who is validly a director or officer (s 225(a))` TRUE FALSE FALSE
#ASSERT NOT (`May I ask the Court of Chancery to decide who is validly a director or officer (s 225(a))` FALSE FALSE FALSE)
-- The result of a vote on a merger: a stockholder may ask, and so may the corporation itself.
#ASSERT `May I ask the Court of Chancery to decide the result of a stockholder vote (s 225(b))` TRUE FALSE TRUE
#ASSERT `May I ask the Court of Chancery to decide the result of a stockholder vote (s 225(b))` FALSE TRUE TRUE
-- On an application about a vote, no other party need be joined.
#ASSERT `Must another party be joined for the Court to decide the result of the vote (s 225(b))` TRUE EQUALS JUST FALSE
-- NOT COVERED: the application is not one under subsection (b).
#ASSERT `Must another party be joined for the Court to decide the result of the vote (s 225(b))` FALSE EQUALS NOTHING
-- Service on the registered agent of an application about an election is service on the officer whose title is contested.
#ASSERT `Is service on the registered agent treated as service on me (s 225)` FALSE FALSE TRUE FALSE FALSE TRUE
-- ... and of an application to remove a director, on the director whose removal is sought.
#ASSERT `Is service on the registered agent treated as service on me (s 225)` TRUE FALSE FALSE FALSE TRUE TRUE
#ASSERT `As the registered agent, must I forward a copy of the application immediately (s 225)` FALSE FALSE TRUE EQUALS JUST TRUE
-- NOT COVERED: subsection (b) states no duty to forward.
#ASSERT `As the registered agent, must I forward a copy of the application immediately (s 225)` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `Was the copy forwarded to me in the way the Law requires (s 225)` TRUE TRUE
-- The Court may order an election once it has determined that no valid election has been held.
#ASSERT `What can the Court of Chancery do on an application about an election (s 225(a))` `to order an election to be held in accordance with section 211 or section 215` TRUE TRUE FALSE
#ASSERT NOT (`What can the Court of Chancery do on an application about an election (s 225(a))` `to order an election to be held in accordance with section 211 or section 215` TRUE FALSE FALSE)
-- Hal, a director, was convicted of a felony in connection with his duties; the corporation applies in a subsequent action; the Court finds no good faith and irreparable harm.
#ASSERT `Can the Court of Chancery remove me from office as a director (s 225(c))` TRUE FALSE TRUE TRUE TRUE TRUE
#ASSERT NOT (`Can the Court of Chancery remove me from office as a director (s 225(c))` TRUE FALSE TRUE TRUE TRUE FALSE)

§ `Section 226 -- a custodian or receiver`

-- Ida, a stockholder: at the election meeting the stockholders are so divided that they failed to elect successors to directors whose terms had expired.
#ASSERT `May I, as a stockholder, ask the Court of Chancery to appoint a custodian for the corporation (s 226(a))` TRUE FALSE FALSE FALSE FALSE
#ASSERT NOT (`May I, as a stockholder, ask the Court of Chancery to appoint a custodian for the corporation (s 226(a))` FALSE TRUE FALSE FALSE FALSE)
-- The corporation is also insolvent: the Court may appoint a receiver as well.
#ASSERT `May the Court of Chancery appoint a receiver for the corporation as well (s 226(a))` TRUE FALSE FALSE FALSE FALSE TRUE
#ASSERT NOT (`May the Court of Chancery appoint a receiver for the corporation as well (s 226(a))` TRUE FALSE FALSE FALSE FALSE FALSE)
-- A custodian's authority is to continue the business, unless the Court orders otherwise or the case is abandonment or a close corporation under section 352(a)(2).
#ASSERT `Is a custodian's authority limited to continuing the business (s 226(b))` FALSE FALSE FALSE
#ASSERT NOT (`Is a custodian's authority limited to continuing the business (s 226(b))` FALSE TRUE FALSE)
-- A charitable nonstock corporation: filed on 1 March 2026, the copy to the Attorney General is due within 1 week, by 8 March 2026.
#ASSERT `By when must I give the Attorney General a copy of my application for a custodian (s 226(c))` FALSE TRUE (YearMonthDay 2026 3 1) EQUALS JUST (YearMonthDay 2026 3 8)
-- NOT COVERED: a stock corporation has no such duty.
#ASSERT `By when must I give the Attorney General a copy of my application for a custodian (s 226(c))` TRUE FALSE (YearMonthDay 2026 3 1) EQUALS NOTHING
#ASSERT `Did I give the Attorney General the copy in time (s 226(c))` FALSE TRUE (YearMonthDay 2026 3 1) TRUE (YearMonthDay 2026 3 8) EQUALS JUST TRUE
#ASSERT `Did I give the Attorney General the copy in time (s 226(c))` FALSE TRUE (YearMonthDay 2026 3 1) TRUE (YearMonthDay 2026 3 9) EQUALS JUST FALSE
#ASSERT `Did I give the Attorney General the copy in time (s 226(c))` FALSE TRUE (YearMonthDay 2026 3 1) FALSE (YearMonthDay 2026 3 1) EQUALS JUST FALSE

§ `Section 227 -- powers of the Court in elections`

#ASSERT `Can the Court of Chancery decide whether I have the right to vote my stock in an election proceeding (s 227(a))` FALSE FALSE TRUE
#ASSERT NOT (`Can the Court of Chancery decide whether I have the right to vote my stock in an election proceeding (s 227(a))` FALSE FALSE FALSE)
#ASSERT `Can the Court of Chancery appoint a magistrate to hold the election (s 227(b))` TRUE FALSE FALSE
#ASSERT `Can the Court of Chancery punish me for contempt if I disobey its order as an officer or director (s 227(b))` TRUE
-- The most the Court may fine a corporation that disobeys an order is $5,000.
#ASSERT `What is the most the Court of Chancery may fine the corporation for disobeying its order, in dollars (s 227(b))` TRUE EQUALS JUST 5000
-- NOT COVERED: the corporation has not disobeyed an order.
#ASSERT `What is the most the Court of Chancery may fine the corporation for disobeying its order, in dollars (s 227(b))` FALSE EQUALS NOTHING

§ `Section 228 -- written consent in place of a meeting`

-- A majority of 100 votes is more than half: 51 votes by consent are enough for a stock corporation whose certificate does not shut the consent route.
#ASSERT `Can the stockholders or members take this action by written consent, without a meeting (s 228(a), (b))` TRUE FALSE 1 2 TRUE 51 100 EQUALS JUST TRUE
#ASSERT `Can the stockholders or members take this action by written consent, without a meeting (s 228(a), (b))` TRUE FALSE 1 2 TRUE 50 100 EQUALS JUST FALSE
-- A nonstock corporation: members with 3 of 5 votes.
#ASSERT `Can the stockholders or members take this action by written consent, without a meeting (s 228(a), (b))` FALSE FALSE 1 2 TRUE 3 5 EQUALS JUST TRUE
-- NOT COVERED: a fraction with no denominator.
#ASSERT `Can the stockholders or members take this action by written consent, without a meeting (s 228(a), (b))` TRUE FALSE 1 0 TRUE 51 100 EQUALS NOTHING
-- Joan's consent: in writing, delivered to the principal place of business in paper form.
#ASSERT `Is my written consent a consent that section 228 permits (s 228(c), (d))` TRUE `to the principal place of business of the corporation` FALSE TRUE FALSE FALSE FALSE FALSE
#ASSERT NOT (`Is my written consent a consent that section 228 permits (s 228(c), (d))` TRUE `to the principal place of business of the corporation` FALSE FALSE FALSE FALSE FALSE FALSE)
-- Delivered on 10 March 2026; the first consent was delivered on 1 March 2026 (the 60 days end on 30 April).
#ASSERT `Does my written consent count toward the action (s 228(c))` TRUE `to the principal place of business of the corporation` FALSE TRUE FALSE FALSE FALSE FALSE (YearMonthDay 2026 3 10) (YearMonthDay 2026 3 1) FALSE (YearMonthDay 2026 3 1) (YearMonthDay 2026 3 1) FALSE TRUE FALSE FALSE FALSE
-- Delivered on 1 May 2026: after the 60 days, so it does not count.
#ASSERT NOT (`Does my written consent count toward the action (s 228(c))` TRUE `to the principal place of business of the corporation` FALSE TRUE FALSE FALSE FALSE FALSE (YearMonthDay 2026 5 1) (YearMonthDay 2026 3 1) FALSE (YearMonthDay 2026 3 1) (YearMonthDay 2026 3 1) FALSE TRUE FALSE FALSE FALSE)
#ASSERT `By when must consents carrying enough votes be delivered (s 228(c))` (YearMonthDay 2026 3 1) EQUALS YearMonthDay 2026 4 30
#ASSERT `Is my revocation of my consent effective (s 228(c))` TRUE FALSE
#ASSERT NOT (`Is my revocation of my consent effective (s 228(c))` TRUE TRUE)
#ASSERT `May a copy or facsimile of a written consent be used instead of the original (s 228(d)(2))` TRUE
#ASSERT `Is a consent that I documented and signed under section 116 treated as in writing (s 228(d)(2))` TRUE
-- Kim did not consent; the action was taken by less than unanimous consent. She was a stockholder on the record date and would have had notice of a meeting.
#ASSERT `Must I be told promptly that the action was taken by consent, when I did not consent (s 228(e))` TRUE TRUE FALSE TRUE
-- MIRROR: the secretary asks about Kim.
#ASSERT `Must we give this stockholder prompt notice that we took the action by consent (s 228(e))` TRUE TRUE FALSE TRUE
#ASSERT NOT (`Must I be told promptly that the action was taken by consent, when I did not consent (s 228(e))` TRUE TRUE TRUE TRUE)
#ASSERT `May we give that notice as a notice of internet availability of proxy materials (s 228(e))` TRUE
#ASSERT `Must the certificate we file say that consent was given instead of stating a vote (s 228(e))` TRUE

§ `Section 229 -- waiver of notice`

#ASSERT `Is notice waived as to me (s 229)` TRUE FALSE FALSE FALSE
-- Lee attended the meeting only to object that it was not lawfully called: no waiver.
#ASSERT NOT (`Is notice waived as to me (s 229)` FALSE FALSE TRUE TRUE)
#ASSERT `Is notice waived as to me (s 229)` FALSE FALSE TRUE FALSE
#ASSERT `Must a waiver of notice say what business the meeting will transact (s 229)` TRUE
#ASSERT NOT (`Must a waiver of notice say what business the meeting will transact (s 229)` FALSE)

§ `Section 230 -- when notice is not required`

#ASSERT `Is the corporation excused from giving me notice because communication with me is unlawful (s 230(a))` TRUE
#ASSERT `Is an action taken without notice to me valid when communication with me is unlawful (s 230(a))` TRUE EQUALS JUST TRUE
-- NOT COVERED: where communication with the person is lawful the subsection says nothing about the effect of an action without notice.
#ASSERT `Is an action taken without notice to me valid when communication with me is unlawful (s 230(a))` FALSE EQUALS NOTHING
#ASSERT `Must the certificate say that notice was given to everyone except those with whom communication is unlawful (s 230(a))` TRUE TRUE TRUE
-- Mail to Ned came back for two consecutive annual meetings and everything between; his e-mail address is not on the records.
#ASSERT `May the corporation stop giving me notice because its mail to me came back undeliverable (s 230(b))` TRUE TRUE 0 0 FALSE FALSE FALSE FALSE
-- ... if his e-mail address is on the records and electronic notice to him is not prohibited, subsection (c) takes the exception away.
#ASSERT NOT (`May the corporation stop giving me notice because its mail to me came back undeliverable (s 230(b))` TRUE TRUE 0 0 FALSE FALSE TRUE FALSE)
#ASSERT `Does the returned-mail exception fail to apply to me because of my e-mail address (s 230(c))` FALSE TRUE FALSE
-- Two of two dividend checks came back: the exception in (b)(2).
#ASSERT `May the corporation stop giving me notice because its mail to me came back undeliverable (s 230(b))` FALSE FALSE 2 2 FALSE FALSE FALSE FALSE
#ASSERT `Is an action taken without notice to me valid, when the corporation's mail to me came back (s 230(b))` TRUE TRUE 0 0 FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- NOT COVERED: only one payment, so neither paragraph applies and the subsection says nothing about validity.
#ASSERT `Is an action taken without notice to me valid, when the corporation's mail to me came back (s 230(b))` FALSE FALSE 1 1 FALSE FALSE FALSE FALSE EQUALS NOTHING

§ `Section 231 -- inspectors of election`

-- A corporation with 12 stockholders and no listed or quoted stock is outside section 231 unless its certificate or bylaws say so.
#ASSERT NOT (`Does section 231 apply to my corporation, so that it must use inspectors of election (s 231(e))` FALSE FALSE 12 FALSE)
#ASSERT `Does section 231 apply to my corporation, so that it must use inspectors of election (s 231(e))` TRUE FALSE 12 FALSE
#ASSERT `Does section 231 apply to my corporation, so that it must use inspectors of election (s 231(e))` FALSE FALSE 2001 FALSE
#ASSERT NOT (`Does section 231 apply to my corporation, so that it must use inspectors of election (s 231(e))` FALSE FALSE 2000 FALSE)
#ASSERT `Who must appoint the inspectors of election for the stockholders' meeting (s 231(a))` TRUE FALSE EQUALS `the corporation, in advance of the meeting of stockholders`
#ASSERT `Who must appoint the inspectors of election for the stockholders' meeting (s 231(a))` TRUE TRUE EQUALS `the person presiding at the meeting of stockholders`
#ASSERT `Who must appoint the inspectors of election for the stockholders' meeting (s 231(a))` FALSE FALSE EQUALS `no one, because section 231 does not apply to the corporation`
#ASSERT `May I act as an inspector of election after taking an oath (s 231(a))` TRUE
#ASSERT `Have the inspectors done what the Law requires of them (s 231(b))` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`Have the inspectors done what the Law requires of them (s 231(b))` TRUE TRUE TRUE FALSE TRUE)
#ASSERT `May the inspectors appoint or retain others to assist them (s 231(b))` TRUE
#ASSERT `Must the opening and the closing of the polls be announced at the meeting (s 231(c))` TRUE
-- Oli's proxy arrived after the polls closed: it is not accepted unless the Court, on a stockholder's application, determined otherwise.
#ASSERT NOT (`May the inspectors accept my proxy or ballot after the polls have closed (s 231(c))` TRUE FALSE)
#ASSERT `May the inspectors accept my proxy or ballot after the polls have closed (s 231(c))` TRUE TRUE
#ASSERT `May the inspectors look at this information when they count the proxies and ballots (s 231(d))` `the proxies the inspectors examine` FALSE
#ASSERT NOT (`May the inspectors look at this information when they count the proxies and ballots (s 231(d))` `other reliable information the inspectors consider` FALSE)
#ASSERT `May the inspectors look at this information when they count the proxies and ballots (s 231(d))` `other reliable information the inspectors consider` TRUE
#ASSERT `Does the inspectors' certification say what the Law requires about other information they used (s 231(d))` TRUE TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`Does the inspectors' certification say what the Law requires about other information they used (s 231(d))` TRUE TRUE TRUE TRUE TRUE FALSE)

§ `Section 232 -- how and when notice reaches a stockholder`

-- A notice mailed to the address on the records on 10 March 2026 is given on 10 March.
#ASSERT `On what date was a notice mailed to me treated as given (s 232(a)(1))` TRUE (YearMonthDay 2026 3 10) EQUALS JUST (YearMonthDay 2026 3 10)
-- NOT COVERED: mailed elsewhere than to the address on the records.
#ASSERT `On what date was a notice mailed to me treated as given (s 232(a)(1))` FALSE (YearMonthDay 2026 3 10) EQUALS NOTHING
-- By courier, received on 12 March and left at the address on 11 March: the earlier, 11 March.
#ASSERT `On what date was a notice sent to me by courier treated as given (s 232(a)(2))` TRUE TRUE (YearMonthDay 2026 3 12) TRUE (YearMonthDay 2026 3 11) EQUALS JUST (YearMonthDay 2026 3 11)
-- By e-mail with the legend, no objection, not barred: given when directed, 10 March.
#ASSERT `On what date was an e-mail notice to me treated as given (s 232(a)(3))` TRUE TRUE FALSE (YearMonthDay 2026 3 10) FALSE (YearMonthDay 2000 1 1) EQUALS JUST (YearMonthDay 2026 3 10)
#ASSERT `On what date was an e-mail notice to me treated as given (s 232(a)(3))` TRUE FALSE FALSE (YearMonthDay 2026 3 10) FALSE (YearMonthDay 2000 1 1) EQUALS NOTHING
#ASSERT `On what date was a facsimile notice to me treated as given (s 232(c)(1))` TRUE FALSE (YearMonthDay 2026 3 10) FALSE (YearMonthDay 2000 1 1) EQUALS JUST (YearMonthDay 2026 3 10)
-- Posted on 10 March, separate notice on 12 March: the later date.
#ASSERT `On what date was a posting-and-separate-notice to me treated as given (s 232(c)(2))` TRUE FALSE (YearMonthDay 2026 3 10) TRUE (YearMonthDay 2026 3 12) FALSE (YearMonthDay 2000 1 1) EQUALS JUST (YearMonthDay 2026 3 12)
#ASSERT `On what date was a posting-and-separate-notice to me treated as given (s 232(c)(2))` TRUE FALSE (YearMonthDay 2026 3 10) FALSE (YearMonthDay 2000 1 1) FALSE (YearMonthDay 2000 1 1) EQUALS NOTHING
#ASSERT `On what date was any other electronic notice to me treated as given (s 232(c)(3))` TRUE FALSE (YearMonthDay 2026 3 10) FALSE (YearMonthDay 2000 1 1) EQUALS JUST (YearMonthDay 2026 3 10)
-- Barred from 10 March: a transmission directed that day is not given.
#ASSERT `On what date was any other electronic notice to me treated as given (s 232(c)(3))` TRUE FALSE (YearMonthDay 2026 3 10) TRUE (YearMonthDay 2026 3 10) EQUALS NOTHING
#ASSERT `From what date may notice by electronic transmission no longer be given (s 232(e))` TRUE (YearMonthDay 2026 3 5) TRUE EQUALS JUST (YearMonthDay 2026 3 5)
#ASSERT `From what date may notice by electronic transmission no longer be given (s 232(e))` TRUE (YearMonthDay 2026 3 5) FALSE EQUALS NOTHING
#ASSERT `Is a meeting invalid because the inability to deliver notices electronically was not discovered (s 232(e))` TRUE EQUALS JUST FALSE
-- NOT COVERED: the failure to discover was not inadvertent.
#ASSERT `Is a meeting invalid because the inability to deliver notices electronically was not discovered (s 232(e))` FALSE EQUALS NOTHING
#ASSERT `Is this communication an electronic transmission (s 232(d)(1))` TRUE TRUE TRUE
#ASSERT NOT (`Is this communication an electronic transmission (s 232(d)(1))` TRUE TRUE FALSE)
#ASSERT `Is this destination an electronic mail address (s 232(d)(3))` TRUE TRUE TRUE
#ASSERT `Is this communication electronic mail (s 232(d)(2))` TRUE TRUE
#ASSERT `Are the attached files and linked information part of the electronic mail notice (s 232(d)(2))` TRUE TRUE
#ASSERT NOT (`Are the attached files and linked information part of the electronic mail notice (s 232(d)(2))` TRUE FALSE)
#ASSERT `Are the attached files and linked information part of the electronic mail notice (s 232(d)(2))` FALSE FALSE
#ASSERT `Is the secretary's affidavit that notice was given evidence against me (s 232(f))` TRUE TRUE FALSE
#ASSERT NOT (`Is the secretary's affidavit that notice was given evidence against me (s 232(f))` TRUE TRUE TRUE)
#ASSERT `Is a document enclosed with a notice part of the notice (s 232(g))` TRUE FALSE TRUE
#ASSERT NOT (`Is a document enclosed with a notice part of the notice (s 232(g))` FALSE FALSE TRUE)
#ASSERT `Does this part of section 232 apply to a notice under another section (s 232(h))` `paragraph (a)(1) of section 232` 164
#ASSERT NOT (`Does this part of section 232 apply to a notice under another section (s 232(h))` `another provision of section 232` 312)
#ASSERT `Does this part of section 232 apply to a notice under another section (s 232(h))` `another provision of section 232` 222

§ `Section 233 -- one notice for stockholders who share an address`

#ASSERT `Is a single written notice sent to my household effective as to me (s 233(a))` TRUE FALSE FALSE
-- MIRROR: the secretary asks about the same stockholder.
#ASSERT `May we send one written notice to the stockholders who share an address (s 233(a))` TRUE FALSE FALSE
#ASSERT NOT (`Is a single written notice sent to my household effective as to me (s 233(a))` TRUE FALSE TRUE)
-- The corporation gave written notice of its intention on 1 January 2026; 60 days after is 2 March 2026.
#ASSERT `Am I deemed to have consented to receiving a single notice (s 233(b))` (YearMonthDay 2026 1 1) FALSE (YearMonthDay 2000 1 1) (YearMonthDay 2026 3 3) EQUALS JUST TRUE
#ASSERT `Am I deemed to have consented to receiving a single notice (s 233(b))` (YearMonthDay 2026 1 1) TRUE (YearMonthDay 2026 3 2) (YearMonthDay 2026 4 1) EQUALS JUST FALSE
-- NOT COVERED: asked on the 60th day itself, with no objection yet: the period has not run.
#ASSERT `Am I deemed to have consented to receiving a single notice (s 233(b))` (YearMonthDay 2026 1 1) FALSE (YearMonthDay 2000 1 1) (YearMonthDay 2026 3 2) EQUALS NOTHING
