-- Filed in the wrong place.
#ASSERT NOT (`s 294 the inventory the trustees or receivers filed is full and complete` WITH `itemized inventory of all the assets of the corporation` IS TRUE, `statement of the nature of the assets` IS TRUE, `statement of the probable value of the assets` IS TRUE, `account of all debts due from the corporation` IS TRUE, `account of all debts due to the corporation` IS TRUE, `the inventory is filed in the office of the Register in Chancery of the county in which the proceeding is pending` IS FALSE)

