IMPORT prelude
IMPORT daydate
IMPORT `ri-works`
IMPORT `ri-works-seat`

-- RI Works (218-RICR-20-00-2) -- worked cases from the seat of the parent or caretaker relative.
-- Every assertion is a claim about the ENCODING on stated facts. Expected values were worked by hand from the deposited
-- text, never copied from the encoding's output. The families are hypothetical.

-- ---------------------------------------------------------------------------------------------------------------------
-- The eligible child (s 2.5.2).
#ASSERT `Is this child eligible by age` 17 FALSE FALSE
#ASSERT `Is this child eligible by age` 18 TRUE TRUE
#ASSERT (NOT (`Is this child eligible by age` 18 FALSE FALSE))
#ASSERT (NOT (`Is this child eligible by age` 18 TRUE FALSE))
#ASSERT (NOT (`Is this child eligible by age` 19 TRUE TRUE))

-- Resources (s 2.14).
-- One adult, $3,000 in the bank, two cars: $8,000 (claimed excluded) and $4,000 of equity. One car is excluded: 7,000.
#ASSERT `How much of our property counts` 3000 1 (LIST 8000, 4000) EQUALS 7000
#ASSERT (NOT (`Are our resources within the limit` 3000 1 (LIST 8000, 4000)))
-- Two adults: both cars excluded: 3,000, within the limit.
#ASSERT `How much of our property counts` 3000 2 (LIST 8000, 4000) EQUALS 3000
#ASSERT `Are our resources within the limit` 3000 2 (LIST 8000, 4000)
-- Three adults, three cars: no more than two excluded per household: 3,000 + 3 = 3,003.
#ASSERT `How much of our property counts` 3000 3 (LIST 1, 2, 3) EQUALS 3003
-- The limit is exceeded only above $5,000: $5,000 exactly is within it, $5,001 is not.
#ASSERT `Are our resources within the limit` 5000 1 (LIST 0)
#ASSERT (NOT (`Are our resources within the limit` 5001 1 EMPTY))

-- The standard (s 2.18).
#ASSERT `What is our payment standard` 1 FALSE EQUALS 510
#ASSERT `What is our payment standard` 3 FALSE EQUALS 865
#ASSERT `What is our payment standard` 3 TRUE EQUALS 800
#ASSERT `What is our payment standard` 10 FALSE EQUALS 1740
#ASSERT `What is our payment standard` 17 FALSE EQUALS 2615

-- ---------------------------------------------------------------------------------------------------------------------
-- Income (s 2.15). A mother earning $1,125 a month with a three-year-old in paid care ($200 a month) and $150 of child
-- support for the child; no set aside, no other income. Inputs: month, earnings 1 and set aside, earnings 2 and set
-- aside, care under 2 and count, care 2+ and count, support and children, other unearned.
-- Earnings left: (1,125 - 525) / 2 = 300. Care disregard: 200 capped at 175. Earned after care: 125.
-- October 2026: support over the first $50 counts: 100. Net adjusted income: 225.
#ASSERT `How much of our income counts` (Date 1 10 2026) 1125 FALSE 0 FALSE 0 0 200 1 150 1 0 EQUALS 225
-- December 2026, under the Amendment of 10 November 2026: the first $100 for one child is excluded: 50 counts: 175.
#ASSERT `How much of our income counts` (Date 1 12 2026) 1125 FALSE 0 FALSE 0 0 200 1 150 1 0 EQUALS 175
-- With $250 of support for two children in December 2026: $200 excluded, 50 counts.
#ASSERT `How much of our income counts` (Date 1 12 2026) 1125 FALSE 0 FALSE 0 0 200 1 250 2 0 EQUALS 175
-- Earnings of $400: under $525, nothing counts.
#ASSERT `How much of our income counts` (Date 1 10 2026) 400 FALSE 0 FALSE 0 0 0 0 0 0 0 EQUALS 0
-- Two adults, $1,525 and $725: (1,000 / 2) + (200 / 2) = 600.
#ASSERT `How much of our income counts` (Date 1 10 2026) 1525 FALSE 725 FALSE 0 0 0 0 0 0 0 EQUALS 600
-- Two children under two in care costing $450: capped at 2 x 200 = 400; earnings left 300 - 400 cannot go below nil;
-- $300 of Social Security for one child still counts: 300.
#ASSERT `How much of our income counts` (Date 1 10 2026) 1125 FALSE 0 FALSE 450 2 0 0 0 0 300 EQUALS 300

-- The payment (ss 2.15.5(B), 2.18.3, 2.18.5). Mother and child (plan size 2, standard 701).
-- October 2026: 701 - 225 = 476.
#ASSERT `How much RI Works will we get` 2 FALSE (Date 1 10 2026) 1125 FALSE 0 FALSE 0 0 200 1 150 1 0 EQUALS `a monthly payment of` 476
-- December 2026: 701 - 175 = 526.
#ASSERT `How much RI Works will we get` 2 FALSE (Date 1 12 2026) 1125 FALSE 0 FALSE 0 0 200 1 150 1 0 EQUALS `a monthly payment of` 526
-- In subsidized housing in October 2026: (701 - 65) - 225 = 411.
#ASSERT `How much RI Works will we get` 2 TRUE (Date 1 10 2026) 1125 FALSE 0 FALSE 0 0 200 1 150 1 0 EQUALS `a monthly payment of` 411
-- She takes a job paying $1,500 while on RI Works and asks for the set aside: nothing counts but the support: 701 - 100 = 601.
#ASSERT `How much RI Works will we get` 2 FALSE (Date 1 10 2026) 1500 TRUE 0 FALSE 0 0 0 0 150 1 0 EQUALS `a monthly payment of` 601
-- Earnings of $2,000, no set aside: (2,000 - 525) / 2 = 737.50, not less than 701: not financially eligible.
#ASSERT `How much RI Works will we get` 2 FALSE (Date 1 10 2026) 2000 FALSE 0 FALSE 0 0 0 0 0 0 0 EQUALS `not financially eligible: net adjusted income is not less than the payment standard (s 2.15.5(B))`
-- Earnings of $1,915: (1,915 - 525) / 2 = 695; 701 - 695 = 6, under $10: no payment, still a recipient.
#ASSERT `How much RI Works will we get` 2 FALSE (Date 1 10 2026) 1915 FALSE 0 FALSE 0 0 0 0 0 0 0 EQUALS `eligible, but no payment this month: the amount would be less than $10 (s 2.18.5); still a recipient for all other purposes`
-- Earnings of $1,907: 691; 701 - 691 = 10, not less than $10: a payment of 10.
#ASSERT `How much RI Works will we get` 2 FALSE (Date 1 10 2026) 1907 FALSE 0 FALSE 0 0 0 0 0 0 0 EQUALS `a monthly payment of` 10

-- ---------------------------------------------------------------------------------------------------------------------
-- The time limit (s 2.6).
#ASSERT `Where do I stand on the time limit` 40 FALSE FALSE FALSE EQUALS `within the time limit` 20
#ASSERT `Where do I stand on the time limit` 60 FALSE FALSE FALSE EQUALS `the 60-month limit is reached; cash assistance ends unless DHS grants a hardship extension, for which one of the s 2.6.3 criteria is needed`
#ASSERT `Where do I stand on the time limit` 62 FALSE FALSE TRUE EQUALS `the 60-month limit is reached, but a hardship extension of six months at a time is granted (ss 2.6.3, 2.6.4)`
#ASSERT `Where do I stand on the time limit` 75 TRUE FALSE FALSE EQUALS `the time limit does not apply to this family (s 2.6.1)`
#ASSERT `Where do I stand on the time limit` 75 FALSE TRUE FALSE EQUALS `the time limit does not apply to this family (s 2.6.1)`
#ASSERT `Do I meet a hardship extension criterion` FALSE FALSE TRUE FALSE FALSE
#ASSERT (NOT (`Do I meet a hardship extension criterion` FALSE FALSE FALSE FALSE FALSE))

-- The work penalty (s 2.11.11): a family of two loses $105; a family of four, the portion DHS attributes ($125 here).
#ASSERT `How much is our cash cut for not keeping to my plan` 2 0 EQUALS 105
#ASSERT `How much is our cash cut for not keeping to my plan` 4 125 EQUALS 125

-- ---------------------------------------------------------------------------------------------------------------------
-- Notice and appeal (ss 2.29, 2.11.12).
#ASSERT `When can the adverse action take effect` (Date 1 10 2026) EQUALS Date 11 10 2026
#ASSERT `Does my cash continue until the hearing decision` TRUE 9 FALSE FALSE
#ASSERT `Does my cash continue until the hearing decision` TRUE 10 FALSE FALSE
#ASSERT (NOT (`Does my cash continue until the hearing decision` TRUE 11 FALSE FALSE))
#ASSERT (NOT (`Does my cash continue until the hearing decision` FALSE 3 FALSE FALSE))
#ASSERT (NOT (`Does my cash continue until the hearing decision` TRUE 3 TRUE FALSE))
#ASSERT `Does my cash continue until the hearing decision` TRUE 3 TRUE TRUE

-- The regulative rules. Day 0 is the day of the change (or of becoming aware, or the first day of the sixth month, or
-- the mailing of the notice).
#ASSERT EVALTRACE `the duty to report a change` 0 (LIST (EVENT `the adult family member` `report the change` 8)) EQUALS FULFILLED
#ASSERT EVALTRACE `the duty to report a child's absence` 0 (LIST (EVENT `the adult family member` `report the absence of the minor child` 4)) EQUALS FULFILLED
#ASSERT EVALTRACE `the duty to return the Interim Report` 0 (LIST (EVENT `the household` `return the completed Interim Report with its verifications` 3)) EQUALS FULFILLED
#ASSERT EVALTRACE `the duty to return the Interim Report after a warning notice` 0 (LIST (EVENT `the household` `return the completed Interim Report with its verifications` 9)) EQUALS FULFILLED
-- Not asking for a hearing is no breach ("may").
#ASSERT EVALTRACE `the right to a hearing` 0 (LIST (WAITUNTIL 40)) EQUALS FULFILLED
#ASSERT EVALTRACE `the right to a hearing with continued benefits` 0 (LIST (EVENT `the recipient` `request a hearing and continued benefits` 7)) EQUALS FULFILLED
-- expect: BREACH by the adult family member (a change reported on day 12)
#TRACE `the duty to report a change` AT 0 WITH
    PARTY `the adult family member` DOES `report the change` AT 12
-- expect: BREACH by the adult family member (the absence reported on day 6 of the period, counting the day of awareness as day 1)
#TRACE `the duty to report a child's absence` AT 0 WITH
    PARTY `the adult family member` DOES `report the absence of the minor child` AT 5
-- expect: BREACH by the household (no Interim Report within ten days of the warning notice)
#TRACE `the duty to return the Interim Report after a warning notice` AT 0 WITH
    (WAITUNTIL 11)
