IMPORT prelude
IMPORT mstanf

-- Cases for mstanf.l4. Expected values worked out by hand from s 43-17-5 as reprinted in House Bill 121 (2026, as
-- introduced; the struck text is the law in force), not copied from the encoding's output. Family facts are invented.

§ `Cases`

§§ `The most a family can get (s 43-17-5(1))`

-- One member: $200. Two: 200 + 36 = 236. Three: 236 + 24 = 260. Five: 236 + 3 x 24 = 308.
#ASSERT `What is the most TANF my family can get` 1 FALSE EQUALS JUST 200
#ASSERT `What is the most TANF my family can get` 2 FALSE EQUALS JUST 236
#ASSERT `What is the most TANF my family can get` 3 FALSE EQUALS JUST 260
#ASSERT `What is the most TANF my family can get` 5 FALSE EQUALS JUST 308
-- A foster, medical or disability case: the limits may be exceeded, so no single figure.
#ASSERT `What is the most TANF my family can get` 3 TRUE EQUALS NOTHING

-- The family cap: a child conceived after the first application, with no break and no waiver, is not covered.
#ASSERT `Can TANF be granted for this child` TRUE FALSE FALSE
#ASSERT (NOT (`Can TANF be granted for this child` FALSE FALSE FALSE))
#ASSERT `Can TANF be granted for this child` FALSE TRUE FALSE

§§ `Denial (s 43-17-5(3))`

#ASSERT `Will my family be denied TANF` TRUE 10 TRUE TRUE FALSE FALSE FALSE FALSE EQUALS `not denied under s 43-17-5(3) on the facts given`
#ASSERT `Will my family be denied TANF` FALSE 10 TRUE TRUE FALSE FALSE FALSE FALSE EQUALS `denied: no minor child resides with the custodial parent or other adult caretaker relative (s 43-17-5(3)(a))`
#ASSERT `Will my family be denied TANF` TRUE 60 TRUE TRUE TRUE TRUE FALSE FALSE EQUALS `denied: an adult has received TANF for 60 months (s 43-17-5(3)(b))`
#ASSERT `Will my family be denied TANF` TRUE 10 FALSE TRUE FALSE FALSE FALSE FALSE EQUALS `denied: the family has not assigned its support rights to the state (s 43-17-5(3)(c))`
#ASSERT `Will my family be denied TANF` TRUE 10 TRUE FALSE FALSE FALSE FALSE FALSE EQUALS `denied: the family has not cooperated in establishing paternity or obtaining child support (s 43-17-5(3)(d))`
-- 24 months of TANF and no work activity: denied under (j).
#ASSERT `Will my family be denied TANF` TRUE 24 TRUE TRUE TRUE FALSE FALSE FALSE EQUALS `denied: a parent or caretaker relative has not engaged in an allowable work activity once found ready to work or after 24 months of TANF (s 43-17-5(3)(j))`
#ASSERT `Will my family be denied TANF` TRUE 10 TRUE TRUE FALSE FALSE TRUE FALSE EQUALS `denied for that individual: a category in s 43-17-5(3)(e) to (i) or (k) to (o) applies`
-- Good cause allowed by federal law excuses the denial.
#ASSERT `Will my family be denied TANF` TRUE 60 TRUE TRUE FALSE FALSE FALSE TRUE EQUALS `not denied under s 43-17-5(3) on the facts given`

§§ `Work activity (s 43-17-5(6))`

-- Argument order: incapacity/illness/pregnancy, baby, months exempt for a baby, ill person or disabled child, age,
-- treatment, domestic violence, months exempt for domestic violence.
#ASSERT `Am I exempt from work activity` FALSE TRUE 5 FALSE 25 FALSE FALSE 0
#ASSERT (NOT (`Am I exempt from work activity` FALSE TRUE 12 FALSE 25 FALSE FALSE 0))
#ASSERT `Am I exempt from work activity` FALSE FALSE 0 FALSE 61 FALSE FALSE 0
#ASSERT (NOT (`Am I exempt from work activity` FALSE FALSE 0 FALSE 60 FALSE FALSE 0))
#ASSERT `Am I exempt from work activity` FALSE FALSE 0 FALSE 17 FALSE FALSE 0
#ASSERT `Am I exempt from work activity` FALSE FALSE 0 FALSE 30 FALSE TRUE 6
#ASSERT (NOT (`Am I exempt from work activity` FALSE FALSE 0 FALSE 30 FALSE TRUE 12))
#ASSERT `How many hours of work activity` FALSE EQUALS 20
#ASSERT `How many hours of work activity` TRUE EQUALS 35
#ASSERT `What is the work sanction` 1 EQUALS `family TANF terminated for at least` 2
#ASSERT `What is the work sanction` 2 EQUALS `family TANF terminated for at least` 6
#ASSERT `What is the work sanction` 3 EQUALS `family TANF terminated for at least` 12
#ASSERT `What is the work sanction` 4 EQUALS `permanently disqualified (s 43-17-5(6)(e)(iv))`

§§ `School and vaccination sanctions (s 43-17-5(4)(f), (5))`

-- Grant $260. A 9-year-old missed school: 25% (65) off: 195. Vaccinations also missing: another 65: 130. A 14-year-old's
-- $24 share removed as well: 106.
#ASSERT `How much TANF after school or vaccination sanctions` 260 0 TRUE FALSE EQUALS 195
#ASSERT `How much TANF after school or vaccination sanctions` 260 0 TRUE TRUE EQUALS 130
#ASSERT `How much TANF after school or vaccination sanctions` 260 24 TRUE TRUE EQUALS 106
#ASSERT `How much TANF after school or vaccination sanctions` 260 0 FALSE FALSE EQUALS 260

§§ `Duties with deadlines`

-- A child's absence is notified on day 3 of the five-day period: fulfilled.
#ASSERT EVALTRACE `s 43-17-5(3)(h) -- notify the department of a child's 30-day absence within the five-day period` 0 (LIST (EVENT `the parent or caretaker relative` `notify the department of the child's absence` 3)) EQUALS FULFILLED
-- expect: BREACH by the parent or caretaker relative -- nothing notified by day 5.
#TRACE `s 43-17-5(3)(h) -- notify the department of a child's 30-day absence within the five-day period` AT 0 WITH
    (WAITUNTIL 5)
-- The job search workshop attended on day 45 after applying: fulfilled.
#ASSERT EVALTRACE `s 43-17-5(6)(b) -- the job search skills workshop within 60 days of applying` 0 (LIST (EVENT `the TANF recipient` `participate in a job search skills training workshop or job readiness program` 45)) EQUALS FULFILLED
-- Vaccinations done on day 20 after notice: fulfilled, no sanction.
#ASSERT EVALTRACE `s 43-17-5(5) -- vaccinations within 30 days of notice, or a 25% sanction` 0 (LIST (EVENT `the parent or caretaker relative` `have the children receive the required vaccinations` 20)) EQUALS FULFILLED
-- Not done by day 30; the Department imposes the 25% sanction on day 40 (the day-31 event only moves the clock on): the
-- rule has run its course, FULFILLED, with the sanction in place.
#ASSERT EVALTRACE `s 43-17-5(5) -- vaccinations within 30 days of notice, or a 25% sanction` 0 (LIST (EVENT `the Department of Human Services` `sanction the family's TANF benefits by 25%` 31), (EVENT `the Department of Human Services` `sanction the family's TANF benefits by 25%` 40)) EQUALS FULFILLED
