IMPORT prelude
IMPORT msit

-- Cases for msit.l4. Expected values worked out by hand from s 27-7-5 as amended by HB 1 (2025), and ss 27-7-17(3)(b) and
-- 27-7-21 as reprinted in the deposited 2026 bills, not copied from the encoding's output. Incomes are invented.

§ `Cases`

§§ `The rates (s 27-7-5)`

-- Nothing on the first $10,000 from 2023: $9,000 of taxable income pays nothing in any year.
#ASSERT `What tax is charged on my taxable income` 2026 9000 0 EQUALS 0
-- 2024: 4.7% x 40,000 = 1,880. 2025: 4.4% x 40,000 = 1,760. 2026: 4% x 40,000 = 1,600.
#ASSERT `What tax is charged on my taxable income` 2024 50000 0 EQUALS 1880
#ASSERT `What tax is charged on my taxable income` 2025 50000 0 EQUALS 1760
#ASSERT `What tax is charged on my taxable income` 2026 50000 0 EQUALS 1600
-- 2027: 3.75%; 2028: 3.5%; 2029: 3.25%; 2030: 3%, each on the $40,000 over $10,000.
#ASSERT `What tax is charged on my taxable income` 2027 50000 0 EQUALS 1500
#ASSERT `What tax is charged on my taxable income` 2028 50000 0 EQUALS 1400
#ASSERT `What tax is charged on my taxable income` 2029 50000 0 EQUALS 1300
#ASSERT `What tax is charged on my taxable income` 2030 50000 0 EQUALS 1200
-- 2031 with a Section 2 reduction of 0.2 points in effect: 2.8% x 10,000 = 280; with no reduction, 3%: 300.
#ASSERT `What tax is charged on my taxable income` 2031 20000 0.2 EQUALS 280
#ASSERT `What tax is charged on my taxable income` 2031 20000 0 EQUALS 300
-- Reductions reaching 3 points: the tax is eliminated (Section 2(4)).
#ASSERT `What tax is charged on my taxable income` 2040 20000 3 EQUALS 0

§§ `Exemptions (s 27-7-21) and the standard deduction (s 27-7-17(3)(b))`

#ASSERT `How much may I deduct for exemptions` "single" 0 0 0 EQUALS 6000
-- Joint, two children: 12,000 + 2 x 1,500 = 15,000. Joint, both 65: 12,000 + 3,000 = 15,000.
#ASSERT `How much may I deduct for exemptions` "married filing jointly" 2 0 0 EQUALS 15000
#ASSERT `How much may I deduct for exemptions` "married filing jointly" 0 2 0 EQUALS 15000
-- Head of family with one dependent: 9,500 (the qualifying dependent earns no extra); with three: 9,500 + 2 x 1,500 = 12,500.
#ASSERT `How much may I deduct for exemptions` "head of family" 1 0 0 EQUALS 9500
#ASSERT `How much may I deduct for exemptions` "head of family" 3 0 0 EQUALS 12500
-- Married filing separately, two children: (12,000 + 3,000) / 2 = 7,500 each.
#ASSERT `How much may I deduct for exemptions` "married filing separately" 2 0 0 EQUALS 7500
-- Single, blind: 6,000 + 1,500.
#ASSERT `How much may I deduct for exemptions` "single" 0 0 1 EQUALS 7500
#ASSERT `What is my standard deduction` "married filing jointly" FALSE EQUALS 4600
#ASSERT `What is my standard deduction` "married filing separately" FALSE EQUALS 2300
#ASSERT `What is my standard deduction` "married filing separately" TRUE EQUALS 0
#ASSERT `What is my standard deduction` "head of family" FALSE EQUALS 3400
#ASSERT `What is my standard deduction` "single" FALSE EQUALS 2300

§§ `Whole returns`

-- Single, 2025, $50,000: 50,000 - 2,300 - 6,000 = 41,700; 4.4% x 31,700 = 1,394.80.
#ASSERT `How much Mississippi income tax do I owe` 2025 TRUE "single" 50000 FALSE 0 FALSE 0 0 0 0 EQUALS `answered` (`My Mississippi tax` WITH `deduction` IS 2300, `exemptions` IS 6000, `taxable income` IS 41700, `income tax` IS 1394.8)
-- Joint, two children, 2026, $80,000: 80,000 - 4,600 - 15,000 = 60,400; 4% x 50,400 = 2,016.
#ASSERT `How much Mississippi income tax do I owe` 2026 TRUE "married filing jointly" 80000 FALSE 0 FALSE 2 0 0 0 EQUALS `answered` (`My Mississippi tax` WITH `deduction` IS 4600, `exemptions` IS 15000, `taxable income` IS 60400, `income tax` IS 2016)
-- Head of family, one child, 2027, $30,000: 30,000 - 3,400 - 9,500 = 17,100; 3.75% x 7,100 = 266.25.
#ASSERT `How much Mississippi income tax do I owe` 2027 TRUE "head of family" 30000 FALSE 0 FALSE 1 0 0 0 EQUALS `answered` (`My Mississippi tax` WITH `deduction` IS 3400, `exemptions` IS 9500, `taxable income` IS 17100, `income tax` IS 266.25)
-- Itemizing $12,000, single, 2026, $40,000: 40,000 - 12,000 - 6,000 = 22,000; 4% x 12,000 = 480.
#ASSERT `How much Mississippi income tax do I owe` 2026 TRUE "single" 40000 TRUE 12000 FALSE 0 0 0 0 EQUALS `answered` (`My Mississippi tax` WITH `deduction` IS 12000, `exemptions` IS 6000, `taxable income` IS 22000, `income tax` IS 480)
-- Outside the encoding.
#ASSERT `How much Mississippi income tax do I owe` 2025 FALSE "single" 50000 FALSE 0 FALSE 0 0 0 0 EQUALS `not covered` `a nonresident or part-year resident is not encoded (s 27-7-21(i), s 27-7-17(3)(c))`
#ASSERT `How much Mississippi income tax do I owe` 2023 TRUE "single" 50000 FALSE 0 FALSE 0 0 0 0 EQUALS `not covered` `only calendar years 2024 and later are encoded`
