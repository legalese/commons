IMPORT prelude
IMPORT daydate
IMPORT `tx-tanf`

-- Texas TANF (Hum. Res. Code ch. 31) -- the applicant's and recipient's questions, worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Expected values were worked by hand
-- from the deposited text. The vehicle exclusion ($5,000 indexed) and poverty-level figures are HYPOTHETICAL inputs.

-- ---------------------------------------------------------------------------------------------------------------------
-- s 31.002(a): dependent child.
-- A 6-year-old living in Texas with her mother, father absent, needy: yes.
#ASSERT `Is my child a dependent child` TRUE 6 FALSE `a parent is continually absent from home` TRUE `a relative listed in s 31.002(a)(5)` EQUALS `yes, a dependent child (s 31.002(a))`
-- Both parents at home, neither incapacitated: no deprivation, so no (the Texas text keeps the deprivation test).
#ASSERT `Is my child a dependent child` TRUE 6 FALSE `not deprived of a parent's support or care` TRUE `a relative listed in s 31.002(a)(5)` EQUALS `no, not a dependent child under s 31.002(a)`
-- 18, full-time in high school, will finish before 19: yes.
#ASSERT `Is my child a dependent child` TRUE 18 TRUE `a parent has died` TRUE `a relative listed in s 31.002(a)(5)` EQUALS `yes, a dependent child (s 31.002(a))`
-- 18 and not a student: no.
#ASSERT `Is my child a dependent child` TRUE 18 FALSE `a parent has died` TRUE `a relative listed in s 31.002(a)(5)` EQUALS `no, not a dependent child under s 31.002(a)`
-- Living with a family friend, not a listed relative: no.
#ASSERT `Is my child a dependent child` TRUE 6 FALSE `a parent has died` TRUE `someone else` EQUALS `no, not a dependent child under s 31.002(a)`
-- In foster care: not covered.
#ASSERT `Is my child a dependent child` TRUE 6 FALSE `a parent has died` TRUE `in foster care through the Department of Family and Protective Services` EQUALS `not covered: a child in foster care is under s 31.002(b), which is not encoded`

-- ---------------------------------------------------------------------------------------------------------------------
-- s 31.032(d): resources. $1,600 in the bank, a car worth $7,000, no other vehicle, HYPOTHETICAL exclusion $5,000:
-- (1,600 - 1,000) + (7,000 - 5,000) = 600 + 2,000 = 2,600.
#ASSERT `How much of our resources count` 1600 7000 0 5000 EQUALS 2600
-- $800 in the bank and a $4,000 car: nothing counts.
#ASSERT `How much of our resources count` 800 4000 0 5000 EQUALS 0
-- A second car worth $1,500 counts in full: 1,500.
#ASSERT `How much of our resources count` 800 4000 1500 5000 EQUALS 1500

-- ss 31.0036, 31.0038: income.
-- Household earnings 1,400, of which a schoolchild's part-time job 400: 1,000 counts.
#ASSERT `How much of our earned income counts` 1400 400 EQUALS 1000
-- Married 15 March 2026 while receiving TANF; asked about 1 June 2026; combined income 3,000 against a HYPOTHETICAL 200%
-- poverty figure of 4,000: left out.
#ASSERT `Is my new spouse's income left out` TRUE (Date 15 3 2026) (Date 1 6 2026) 3000 4000
-- Asked about 15 September 2026: the six months have ended.
#ASSERT (NOT (`Is my new spouse's income left out` TRUE (Date 15 3 2026) (Date 15 9 2026) 3000 4000))
-- Combined income 4,500, over 200%: not left out.
#ASSERT (NOT (`Is my new spouse's income left out` TRUE (Date 15 3 2026) (Date 1 6 2026) 4500 4000))
-- Not receiving TANF when they married: not left out.
#ASSERT (NOT (`Is my new spouse's income left out` FALSE (Date 15 3 2026) (Date 1 6 2026) 3000 4000))

-- ---------------------------------------------------------------------------------------------------------------------
-- s 31.0065: time limits.
-- High school diploma: 12 months.
#ASSERT `How many months of TANF can I receive` `high school diploma, equivalency certificate, or a college, technical or vocational certificate or degree` 0 EQUALS 12
-- Three years of high school, no work: 24.
#ASSERT `How many months of TANF can I receive` `completed three years of high school` 2 EQUALS 24
-- Two years of high school, 10 months' work: 24 (work of 6 to 18 months).
#ASSERT `How many months of TANF can I receive` `completed less than three years of high school` 10 EQUALS 24
-- Two years of high school, 18 months' work: 12 (18 months or more).
#ASSERT `How many months of TANF can I receive` `completed less than three years of high school` 18 EQUALS 12
-- Two years of high school, 3 months' work: 36.
#ASSERT `How many months of TANF can I receive` `completed less than three years of high school` 3 EQUALS 36

-- Clock start: notified of an opening 2 February 2026: 2 February 2026.
#ASSERT `When does my time limit start` (Date 2 2 2026) FALSE (Date 1 1 2026) EQUALS Date 2 2 2026
-- 36-month tier, cooperated, assessment completed 10 March 2026: the first anniversary, 10 March 2027.
#ASSERT `When does my time limit start` (Date 2 2 2026) TRUE (Date 10 3 2026) EQUALS Date 10 3 2027
-- Totally disqualified 30 June 2026: may reapply on or after 30 June 2031.
#ASSERT `When may I reapply after the time limit` (Date 30 6 2026) EQUALS Date 30 6 2031

-- ---------------------------------------------------------------------------------------------------------------------
-- s 31.012: the work requirement.
#ASSERT `Do I meet the work requirement` TRUE FALSE FALSE 0 0 EQUALS `exempt: I care for a child with a disability who needs me there (s 31.012(c))`
#ASSERT `Do I meet the work requirement` FALSE TRUE TRUE 0 0 EQUALS `exempt until my youngest child (when I first became eligible) turns one (s 31.012(c))`
-- Two parents, baby under one: the single-caretaker exemption does not apply; 32 hours of work meets it.
#ASSERT `Do I meet the work requirement` FALSE FALSE TRUE 32 0 EQUALS `I meet the work requirement this month (s 31.012(a))`
-- 20 hours in the employment program meets it.
#ASSERT `Do I meet the work requirement` FALSE TRUE FALSE 0 20 EQUALS `I meet the work requirement this month (s 31.012(a))`
-- 25 hours' work and 10 hours' activity: neither threshold is met (the section does not add them: finding 3).
#ASSERT `Do I meet the work requirement` FALSE TRUE FALSE 25 10 EQUALS `I do not meet the work requirement this month: I must work 30 hours a week or take part 20 hours a week in the employment program (s 31.012(a))`

-- ---------------------------------------------------------------------------------------------------------------------
-- ss 31.0032, 31.0033, 31.00331: sanctions.
#ASSERT `What happens if I am not cooperating` FALSE 0 FALSE FALSE EQUALS `no sanction: I am cooperating with the responsibility agreement`
#ASSERT `What happens if I am not cooperating` TRUE 1 FALSE FALSE EQUALS `the whole family's assistance stops until I show cooperation, and for at least one month (s 31.0032(a), (a-1))`
#ASSERT `What happens if I am not cooperating` TRUE 1 TRUE FALSE EQUALS `no sanction yet: my good cause hearing request was in time, so payment may not be withheld until good cause is decided (s 31.0033(a))`
#ASSERT `What happens if I am not cooperating` TRUE 1 TRUE TRUE EQUALS `the whole family's assistance stops until I show cooperation, and for at least one month (s 31.0032(a), (a-1))`
#ASSERT `What happens if I am not cooperating` TRUE 2 FALSE FALSE EQUALS `the family is ineligible after two consecutive months of not cooperating; on reapplying I must cooperate for a month before a payment (s 31.00331)`

-- s 31.0033(e): good cause on child support.
#ASSERT `Do I have good cause on child support` TRUE FALSE FALSE
#ASSERT (NOT (`Do I have good cause on child support` FALSE FALSE FALSE))

-- ---------------------------------------------------------------------------------------------------------------------
-- Deadlines.
-- Found eligible 1 March 2026: immunization proof by 28 August 2026 (180 days).
#ASSERT `By when must I prove immunization` (Date 1 3 2026) EQUALS Date 28 8 2026
-- Notice sent 5 May 2026: hearing request by 18 May 2026 (the 13th day after).
#ASSERT `By when must I ask for a good cause hearing` (Date 5 5 2026) EQUALS Date 18 5 2026

-- The duties.
#ASSERT EVALTRACE `my duty to prove immunization` 0 (LIST (EVENT `the applicant or recipient` `give proof of the child's immunization` 150)) EQUALS FULFILLED
#TRACE `my duty to prove immunization` AT 0 WITH
    PARTY `the applicant or recipient` DOES `give proof of the child's immunization` AT 200
-- expect: BREACH BY the applicant or recipient, "proof of immunization was not given by the 180th day after eligibility was determined (s 31.031(e))"
#ASSERT EVALTRACE `my duty to report more income` 0 (LIST (EVENT `the applicant or recipient` `notify the commission of more income or resources` 1)) EQUALS FULFILLED
#ASSERT EVALTRACE `my right to a good cause hearing` 0 (LIST (EVENT `the applicant or recipient` `request a good cause hearing` 13)) EQUALS FULFILLED

-- ---------------------------------------------------------------------------------------------------------------------
-- s 31.036 and s 31.0041.
-- Moved out: no. Away temporarily with approval: yes. Away without approval: no. Not away at all: yes.
#ASSERT (NOT (`Do I keep TANF if I leave Texas` TRUE FALSE TRUE))
#ASSERT `Do I keep TANF if I leave Texas` FALSE TRUE TRUE
#ASSERT (NOT (`Do I keep TANF if I leave Texas` FALSE TRUE FALSE))
#ASSERT `Do I keep TANF if I leave Texas` FALSE FALSE FALSE
-- A 58-year-old grandmother raising her grandson, primary caretaker, income and resources within: up to 1,000.
#ASSERT `Most supplemental payment I can get` 58 TRUE TRUE TRUE TRUE TRUE FALSE EQUALS 1000
-- A 23-year-old sister: under 25: none.
#ASSERT `Most supplemental payment I can get` 23 TRUE TRUE TRUE TRUE TRUE FALSE EQUALS 0
-- Already paid to another relative for this child: none.
#ASSERT `Most supplemental payment I can get` 58 TRUE TRUE TRUE TRUE TRUE TRUE EQUALS 0
