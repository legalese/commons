IMPORT prelude
IMPORT `tx-ui`

-- Texas Unemployment Compensation Act -- the claimant's questions, worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Expected values were worked by hand
-- from the deposited text. The maximum and minimum weekly benefit amounts used here ($600 and $80) are HYPOTHETICAL: the
-- commission sets them each year and they are not in the deposited text.

-- ---------------------------------------------------------------------------------------------------------------------
-- s 207.002: 1/25 of the highest base-period quarter, between the minimum and maximum, raised to a whole dollar.
-- Quarters 5,000 / 8,000 / 10,000 / 2,000: 10,000 / 25 = 400.
#ASSERT `How much is my weekly benefit` (LIST 5000, 8000, 10000, 2000) 600 80 EQUALS 400
-- Highest quarter 16,000: 640, capped at 600.
#ASSERT `How much is my weekly benefit` (LIST 12000, 13000, 16000, 15000) 600 80 EQUALS 600
-- Highest quarter 1,000: 40, raised to the 80 minimum.
#ASSERT `How much is my weekly benefit` (LIST 1000, 0, 0, 500) 600 80 EQUALS 80
-- Highest quarter 6,010: 240.40, raised to 241 (s 207.006).
#ASSERT `How much is my weekly benefit` (LIST 6010, 3000, 0, 0) 600 80 EQUALS 241

-- s 207.005: the lesser of 26 x the benefit amount and 27% of base-period wages.
-- 26 x 400 = 10,400; 27% of 25,000 = 6,750: 6,750.
#ASSERT `What is the most I can be paid this benefit year` (LIST 5000, 8000, 10000, 2000) 600 80 EQUALS 6750
-- Four quarters of 10,000: 26 x 400 = 10,400; 27% of 40,000 = 10,800: 10,400.
#ASSERT `What is the most I can be paid this benefit year` (LIST 10000, 10000, 10000, 10000) 600 80 EQUALS 10400
-- 27% of 25,001 = 6,750.27, raised to 6,751.
#ASSERT `What is the most I can be paid this benefit year` (LIST 5001, 8000, 10000, 2000) 600 80 EQUALS 6751

-- ---------------------------------------------------------------------------------------------------------------------
-- ss 201.091, 207.003: a week with some earnings, benefit amount 400 (25% = 100, more than $5).
-- Earned 100: not more than 100, so totally unemployed: 400.
#ASSERT `How much for a week with some earnings` 400 100 TRUE EQUALS 400
-- Earned 150 working part time: 400 + 100 - 150 = 350.
#ASSERT `How much for a week with some earnings` 400 150 TRUE EQUALS 350
-- Earned 500 part time: not less than 400 + 100, so not unemployed: 0.
#ASSERT `How much for a week with some earnings` 400 500 TRUE EQUALS 0
-- Earned 499.50 part time: 0.50, raised to 1.
#ASSERT `How much for a week with some earnings` 400 499.50 TRUE EQUALS 1
-- Earned 150 working full time: not partially unemployed: 0.
#ASSERT `How much for a week with some earnings` 400 150 FALSE EQUALS 0
-- Benefit amount 16: 25% is 4, so $5 is the greater; earned 5: totally unemployed: 16.
#ASSERT `How much for a week with some earnings` 16 5 TRUE EQUALS 16

-- ---------------------------------------------------------------------------------------------------------------------
-- s 207.021: eligibility. Base: registered, claim, able, available, seeking, quarters 5,000 / 8,000 / 10,000 / 2,000
-- (benefit amount 400; 37 x 400 = 14,800, wages 25,000), no earlier benefit year, waiting week served.
#ASSERT `Am I eligible for unemployment benefits` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE (LIST 5000, 8000, 10000, 2000) 600 80 FALSE 0 TRUE FALSE EQUALS `eligible for this benefit period, unless disqualified`
-- All wages in one quarter (20,000): fewer than two quarters.
#ASSERT `Am I eligible for unemployment benefits` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE (LIST 20000, 0, 0, 0) 600 80 FALSE 0 TRUE FALSE EQUALS `not eligible` `base period wages in fewer than two quarters (s 207.021(a)(6)(A))`
-- 8,000 and 1,000: benefit amount 320; 37 x 320 = 11,840 > 9,000.
#ASSERT `Am I eligible for unemployment benefits` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE (LIST 8000, 1000, 0, 0) 600 80 FALSE 0 TRUE FALSE EQUALS `not eligible` `base period wages less than 37 times the benefit amount (s 207.021(a)(6)(B))`
-- An earlier benefit year, 1,000 earned since: less than 6 x 400 = 2,400.
#ASSERT `Am I eligible for unemployment benefits` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE (LIST 5000, 8000, 10000, 2000) 600 80 TRUE 1000 TRUE FALSE EQUALS `not eligible` `not enough wages since the last benefit year began: less than 6 times the benefit amount (s 207.021(a)(7))`
-- Earned exactly 2,400 since: "not less than six times": eligible.
#ASSERT `Am I eligible for unemployment benefits` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE (LIST 5000, 8000, 10000, 2000) 600 80 TRUE 2400 TRUE FALSE EQUALS `eligible for this benefit period, unless disqualified`
-- Waiting week not served.
#ASSERT `Am I eligible for unemployment benefits` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE (LIST 5000, 8000, 10000, 2000) 600 80 FALSE 0 FALSE FALSE EQUALS `not eligible` `the seven-day waiting period is not served (s 207.021(a)(8))`
-- Not able to work full time, but a permanently disabled part-time worker on SSDI meeting all of s 207.0211: eligible.
#ASSERT `Am I eligible for unemployment benefits` TRUE TRUE FALSE FALSE TRUE TRUE TRUE TRUE TRUE TRUE (LIST 3000, 3000, 3000, 3000) 600 80 FALSE 0 TRUE FALSE EQUALS `eligible for this benefit period, unless disqualified`
-- The same person without SSDI: not able to work.
#ASSERT `Am I eligible for unemployment benefits` TRUE TRUE FALSE FALSE TRUE TRUE TRUE TRUE FALSE TRUE (LIST 3000, 3000, 3000, 3000) 600 80 FALSE 0 TRUE FALSE EQUALS `not eligible` `not able to work (s 207.021(a)(3))`
-- Required reemployment services not taken up without reasonable cause.
#ASSERT `Am I eligible for unemployment benefits` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE (LIST 5000, 8000, 10000, 2000) 600 80 FALSE 0 TRUE TRUE EQUALS `not eligible` `not taking part in required reemployment services (s 207.021(a)(9))`

-- ---------------------------------------------------------------------------------------------------------------------
-- ss 207.044 to 207.047: disqualification.
#ASSERT `Am I disqualified for how I left` `laid off or let go, not for misconduct` TRUE FALSE FALSE EQUALS `not disqualified for how I left`
#ASSERT `Am I disqualified for how I left` `discharged for misconduct connected with my last work` TRUE FALSE FALSE EQUALS `disqualified until I return to work and work six weeks or earn six times my benefit amount (ss 207.044(b), 207.045(b), 207.047(b))`
-- Misconduct, but since then six weeks' work: the disqualification has ended.
#ASSERT `Am I disqualified for how I left` `discharged for misconduct connected with my last work` TRUE FALSE TRUE EQUALS `not disqualified for how I left`
#ASSERT `Am I disqualified for how I left` `quit without good cause connected with the work` TRUE FALSE FALSE EQUALS `disqualified until I return to work and work six weeks or earn six times my benefit amount (ss 207.044(b), 207.045(b), 207.047(b))`
#ASSERT `Am I disqualified for how I left` `quit to move with my spouse` TRUE FALSE FALSE EQUALS `disqualified for six to 25 benefit periods after a valid claim, as the commission decides (s 207.045(c))`
-- Quit because of pregnancy, available to work: s 207.045(d) protects.
#ASSERT `Am I disqualified for how I left` `quit for a reason in s 207.045(d) or an involuntary separation under s 207.046` TRUE FALSE FALSE EQUALS `not disqualified for how I left`
-- Laid off but refused suitable work this benefit year.
#ASSERT `Am I disqualified for how I left` `laid off or let go, not for misconduct` TRUE TRUE FALSE EQUALS `disqualified until I return to work and work six weeks or earn six times my benefit amount (ss 207.044(b), 207.045(b), 207.047(b))`
-- Not reenlisting is not leaving voluntarily (s 207.045(f)).
#ASSERT `Am I disqualified for how I left` `did not reenlist in the military` TRUE FALSE FALSE EQUALS `not disqualified for how I left`

-- ---------------------------------------------------------------------------------------------------------------------
-- ss 207.049, 207.050: other payments, benefit amount 400.
-- Severance pay for the week: disqualified for it: 0.
#ASSERT `How much for a week with other payments` 400 TRUE 0 FALSE EQUALS 0
-- Social Security of 300: no reduction.
#ASSERT `How much for a week with other payments` 400 FALSE 300 TRUE EQUALS 400
-- A work pension of 150 a week: 400 - 150 = 250.
#ASSERT `How much for a week with other payments` 400 FALSE 150 FALSE EQUALS 250
-- 150.50: 249.50, raised to 250.
#ASSERT `How much for a week with other payments` 400 FALSE 150.50 FALSE EQUALS 250
-- A work pension of 450, more than the benefit: disqualified for the week: 0.
#ASSERT `How much for a week with other payments` 400 FALSE 450 FALSE EQUALS 0
