IMPORT prelude
IMPORT `wy-power`

-- Wyoming POWER, state SSI supplement and burial assistance -- cases from the applicant's seat. Expected values worked by hand
-- from the deposited text (W.S. 42-2; DFS rule 049.0030 ch. 1), never copied from the encoding's output. The current maximum
-- payment ($780 for the family below) and the poverty level ($15,650) are HYPOTHETICAL figures.

-- W.S. 42-2-104(b): dependent child. Arguments: age, lives with relative, attends school, expected to graduate before 19,
-- minor parent.
#ASSERT `Is my child a dependent child for POWER` 10 TRUE TRUE FALSE FALSE
#ASSERT NOT (`Is my child a dependent child for POWER` 10 TRUE FALSE FALSE FALSE)
#ASSERT `Is my child a dependent child for POWER` 18 TRUE FALSE TRUE FALSE
#ASSERT NOT (`Is my child a dependent child for POWER` 18 TRUE TRUE FALSE FALSE)
#ASSERT NOT (`Is my child a dependent child for POWER` 19 TRUE TRUE TRUE FALSE)
#ASSERT NOT (`Is my child a dependent child for POWER` 15 TRUE TRUE FALSE TRUE)
#ASSERT NOT (`Is my child a dependent child for POWER` 10 FALSE TRUE FALSE FALSE)

-- Assets: $5,000 is within the limit; $5,001 is not.
#ASSERT `Are we under the POWER asset limit` 5000
#ASSERT NOT (`Are we under the POWER asset limit` 5001)

-- The 2008 table (W.S. 42-2-103(e)(iii)).
#ASSERT `What was the 2008 maximum POWER payment` 1 EQUALS 290
#ASSERT `What was the 2008 maximum POWER payment` 2 EQUALS 476
#ASSERT `What was the 2008 maximum POWER payment` 3 EQUALS 506
#ASSERT `What was the 2008 maximum POWER payment` 5 EQUALS 536
#ASSERT `What was the 2008 maximum POWER payment` 8 EQUALS 566

-- The payment. Arguments: maximum payment, gross earnings, married couple with child in common, unearned income, veterans'
-- compensation, annual poverty level.
-- No income: the whole maximum, 780.
#ASSERT `What is our POWER payment` 780 0 FALSE 0 0 15650 EQUALS `a performance payment of` 780
-- Earnings $900 less the $600 disregard = 300, plus $100 support: balance 400; payment 380.
#ASSERT `What is our POWER payment` 780 900 FALSE 100 0 15650 EQUALS `a performance payment of` 380
-- A married couple with a child in common earning $1,500: less $1,200 = 300; payment 480.
#ASSERT `What is our POWER payment` 780 1500 TRUE 0 0 15650 EQUALS `a performance payment of` 480
-- A single parent earning $1,500: balance 900, not less than 780: not eligible.
#ASSERT `What is our POWER payment` 780 1500 FALSE 0 0 15650 EQUALS `not eligible: the balance is not less than the maximum payment (rule s 9(a)(vii)(B)(VI))`
-- Veterans' disability compensation of $1,000 a month ($12,000 a year, under the poverty level) is not counted: 780.
#ASSERT `What is our POWER payment` 780 0 FALSE 0 1000 15650 EQUALS `a performance payment of` 780
-- $1,500 a month ($18,000 a year, over the poverty level) is counted: balance 1,500: not eligible.
#ASSERT `What is our POWER payment` 780 0 FALSE 0 1500 15650 EQUALS `not eligible: the balance is not less than the maximum payment (rule s 9(a)(vii)(B)(VI))`

-- The earned income incentive: 50% of the maximum, for up to six months while employed.
#ASSERT `How much is our earned income incentive` 780 TRUE 0 TRUE EQUALS 390
#ASSERT `How much is our earned income incentive` 780 TRUE 6 TRUE EQUALS 0
#ASSERT `How much is our earned income incentive` 780 TRUE 2 FALSE EQUALS 0
#ASSERT `How much is our earned income incentive` 780 FALSE 0 TRUE EQUALS 0

-- W.S. 42-2-103(e)(i): the five years. Arguments: months, disabled or carer, extension, domestic violence waiver.
#ASSERT `Can we still receive POWER under the five-year limit` 40 FALSE FALSE FALSE EQUALS `within the five-year lifetime limit`
#ASSERT `Can we still receive POWER under the five-year limit` 60 FALSE FALSE FALSE EQUALS `past the five-year lifetime limit`
#ASSERT `Can we still receive POWER under the five-year limit` 60 TRUE FALSE FALSE EQUALS `not subject to the limit: totally disabled, or the full-time carer of a totally disabled or incapacitated family member (W.S. 42-2-103(e)(i))`
#ASSERT `Can we still receive POWER under the five-year limit` 70 FALSE TRUE FALSE EQUALS `past five years, but an extension applies (abandonment, or continuing an associate or baccalaureate degree in the state-funded program)`
#ASSERT `Can we still receive POWER under the five-year limit` 70 FALSE FALSE TRUE EQUALS `past five years, but the time limit is waived for domestic violence (W.S. 42-2-103(e)(viii))`

-- W.S. 42-2-103(d): the state SSI supplement.
#ASSERT `Am I entitled to the state SSI supplement` TRUE FALSE
#ASSERT NOT (`Am I entitled to the state SSI supplement` TRUE TRUE)
#ASSERT NOT (`Am I entitled to the state SSI supplement` FALSE FALSE)

-- W.S. 42-2-103(c): burial. $3,000 of expenses with $1,000 available: the state pays at most $1,500.
#ASSERT `How much burial assistance` 3000 1000 FALSE 0 EQUALS 1500
-- A veteran: $2,000 less $1,000 = 1,000, plus transport capped at $500 (cost $600): 1,500.
#ASSERT `How much burial assistance` 2000 1000 TRUE 600 EQUALS 1500
-- $1,200 of expenses, nothing available: 1,200.
#ASSERT `How much burial assistance` 1200 0 FALSE 0 EQUALS 1200

-- W.S. 42-2-109(b): report a change within 10 calendar days.
-- expect: FULFILLED
#TRACE `my duty to report a change` AT 0 WITH
    PARTY `the recipient` DOES `notify the department of the change` AT 7
-- expect: BREACH by the recipient (the noncompliance penalty)
#TRACE `my duty to report a change` AT 0 WITH
    (WAITUNTIL 11)
-- Rule s 9(a)(vii)(G): verifications within 10 days of the notice.
-- expect: FULFILLED
#TRACE `my duty to provide verifications` AT 0 WITH
    PARTY `the recipient` DOES `provide the verifications requested` AT 9
-- expect: BREACH by the recipient
#TRACE `my duty to provide verifications` AT 0 WITH
    (WAITUNTIL 11)
