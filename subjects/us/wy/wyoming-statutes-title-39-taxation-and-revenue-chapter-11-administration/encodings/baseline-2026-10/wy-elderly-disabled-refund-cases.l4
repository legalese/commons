IMPORT prelude
IMPORT `wy-elderly-disabled-refund`

-- Wyoming refund for the elderly and disabled (W.S. 39-11-109(c)) -- cases from the applicant's seat. Expected values worked by
-- hand from the deposited text, never copied from the encoding's output. The printed asset ceiling ($25,000) is used.

-- Who qualifies. Arguments: age, disabled for the past year, months resident, claimed residency elsewhere, institution, assets,
-- adults, ceiling.
#ASSERT `Do I qualify for the elderly and disabled refund` 66 FALSE 24 FALSE FALSE 20000 1 25000
#ASSERT NOT (`Do I qualify for the elderly and disabled refund` 66 FALSE 24 FALSE FALSE 30000 1 25000)
#ASSERT `Do I qualify for the elderly and disabled refund` 66 FALSE 24 FALSE FALSE 45000 2 25000
#ASSERT `Do I qualify for the elderly and disabled refund` 50 TRUE 24 FALSE FALSE 0 1 25000
#ASSERT NOT (`Do I qualify for the elderly and disabled refund` 17 TRUE 24 FALSE FALSE 0 1 25000)
#ASSERT NOT (`Do I qualify for the elderly and disabled refund` 50 FALSE 24 FALSE FALSE 0 1 25000)
#ASSERT NOT (`Do I qualify for the elderly and disabled refund` 66 FALSE 11 FALSE FALSE 0 1 25000)
#ASSERT NOT (`Do I qualify for the elderly and disabled refund` 66 FALSE 24 TRUE FALSE 0 1 25000)
#ASSERT NOT (`Do I qualify for the elderly and disabled refund` 66 FALSE 24 FALSE TRUE 0 1 25000)

-- The amount. Arguments: married, actual income, last year's property tax relief, appropriation fraction.
-- Single: $9,000 -> 800; $12,000 -> 20% over $10,000 -> 640; $17,000 -> 70% -> 240; $17,500 -> not "less than": 0.
#ASSERT `How much is my elderly and disabled refund` FALSE 9000 0 1 EQUALS 800
#ASSERT `How much is my elderly and disabled refund` FALSE 12000 0 1 EQUALS 640
#ASSERT `How much is my elderly and disabled refund` FALSE 17000 0 1 EQUALS 240
#ASSERT `How much is my elderly and disabled refund` FALSE 17500 0 1 EQUALS 0
-- Married: $16,000 -> 900; $20,000 -> 25% over $16,000 -> 675; $28,000 -> 75% -> 225; $28,500 -> 0.
#ASSERT `How much is my elderly and disabled refund` TRUE 16000 0 1 EQUALS 900
#ASSERT `How much is my elderly and disabled refund` TRUE 20000 0 1 EQUALS 675
#ASSERT `How much is my elderly and disabled refund` TRUE 28000 0 1 EQUALS 225
#ASSERT `How much is my elderly and disabled refund` TRUE 28500 0 1 EQUALS 0
-- Reductions: single $12,000 with $100 of last year's property tax relief: 540; at an appropriation fraction of 0.9: 486.
#ASSERT `How much is my elderly and disabled refund` FALSE 12000 100 1 EQUALS 540
#ASSERT `How much is my elderly and disabled refund` FALSE 12000 100 0.9 EQUALS 486
-- A fraction above 1 cannot raise the refund above the (c)(ii) amount.
#ASSERT `How much is my elderly and disabled refund` FALSE 12000 100 1.2 EQUALS 540

-- Applying and the warrant: 150 days to the last working day in August, then 110 days to December 20.
-- expect: FULFILLED (applied on day 100; warrant mailed on day 150, within 110 days of the application)
#TRACE `my application for the refund` 150 110 AT 0 WITH
    PARTY `the applicant` DOES `apply under oath with a copy of last year's federal return or a statement that none was required` AT 100
    PARTY `the department of health` DOES `mail the refund warrant with its letter of transmittal` AT 150
-- Not applying is no breach (the refund is simply not paid). expect: FULFILLED
#TRACE `my application for the refund` 150 110 AT 0 WITH
    (WAITUNTIL 151)
-- expect: BREACH by the department of health (no warrant by December 20)
#TRACE `my application for the refund` 150 110 AT 0 WITH
    PARTY `the applicant` DOES `apply under oath with a copy of last year's federal return or a statement that none was required` AT 100
    (WAITUNTIL 300)
