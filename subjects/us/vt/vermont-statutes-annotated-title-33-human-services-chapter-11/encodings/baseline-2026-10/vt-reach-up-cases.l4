IMPORT prelude
IMPORT `vt-reach-up`

-- Reach Up (33 V.S.A. ch. 11) -- worked cases from the applicant's seat. Expected values were worked by hand from the
-- deposited text (vt-33-vsa-ch11-2026.txt), never copied from the encoding's output. Payment standards and housing
-- allowances below are HYPOTHETICAL figures (the real ones are set by rule and not deposited).

-- s 1101(10): dependent child.
#ASSERT `Is my child a dependent child` TRUE 10 FALSE FALSE
#ASSERT `Is my child a dependent child` TRUE 19 TRUE TRUE
#ASSERT NOT (`Is my child a dependent child` TRUE 19 TRUE FALSE)
#ASSERT NOT (`Is my child a dependent child` TRUE 19 FALSE TRUE)
#ASSERT NOT (`Is my child a dependent child` FALSE 10 FALSE FALSE)

-- s 1101(12): a family.
#ASSERT `Are we a family for Reach Up` 2 TRUE FALSE
#ASSERT `Are we a family for Reach Up` 0 FALSE TRUE
#ASSERT NOT (`Are we a family for Reach Up` 0 TRUE FALSE)
#ASSERT NOT (`Are we a family for Reach Up` 1 FALSE FALSE)

-- s 1103(c)(5): no asset limit.
#ASSERT NOT (`Is there an asset limit for Reach Up`)

-- s 1103(c)(1), (f): the grant at the statutory minimum disregards. HYPOTHETICAL payment standard $900.
-- No income: the whole standard, $900.
#ASSERT `At least how much is our Reach Up grant` 900 0 0 0 EQUALS 900
-- Earnings $300: all disregarded; $900.
#ASSERT `At least how much is our Reach Up grant` 900 300 0 0 EQUALS 900
-- Earnings $1,150: disregard 350 + 25% x 800 = 550; countable 600; grant 300.
#ASSERT `At least how much is our Reach Up grant` 900 1150 0 0 EQUALS 300
-- Child support $250: $100 disregarded, $150 counted; earnings $750: disregard 350 + 100 = 450, counted 300; grant 900 - 450 = 450.
#ASSERT `At least how much is our Reach Up grant` 900 750 250 0 EQUALS 450
-- Child support $60: all disregarded.
#ASSERT `At least how much is our Reach Up grant` 900 0 60 0 EQUALS 900
-- Countable income above the standard: nil (earnings $2,000: disregard 350 + 412.50 = 762.50; countable 1,237.50).
#ASSERT `At least how much is our Reach Up grant` 900 2000 0 0 EQUALS 0
-- Other countable income $400 on top of nothing else: 500.
#ASSERT `At least how much is our Reach Up grant` 900 0 0 400 EQUALS 500

-- s 1108: the 60 months.
#ASSERT `Am I within the 60-month limit` FALSE 40 0 FALSE FALSE FALSE EQUALS `within the 60 months: eligible as to the time limit (s 1108(a))`
-- 59 counted months: still "fewer than 60".
#ASSERT `Am I within the 60-month limit` FALSE 59 0 FALSE FALSE FALSE EQUALS `within the 60 months: eligible as to the time limit (s 1108(a))`
-- 60 counted months: past the limit; no exemption, no determination.
#ASSERT `Am I within the 60-month limit` FALSE 60 0 FALSE FALSE FALSE EQUALS `past the 60 months: not eligible`
-- 72 months received, 14 not counted (a year with a baby under one, two months before turning 18): 58 counted.
#ASSERT `Am I within the 60-month limit` FALSE 72 14 FALSE FALSE FALSE EQUALS `within the 60 months: eligible as to the time limit (s 1108(a))`
-- Past 60, no (b) criterion, working: the hardship exemption.
#ASSERT `Am I within the 60-month limit` FALSE 65 0 FALSE TRUE FALSE EQUALS `past the 60 months: the hardship exemption applies while I am engaged in work activities (s 1108(d))`
-- Past 60, a (b) criterion now applies, working: (d) does not apply (it needs none of the (b) criteria); the director decides.
#ASSERT `Am I within the 60-month limit` FALSE 65 0 TRUE TRUE TRUE EQUALS `past the 60 months: I may continue only if the program director determines, month by month, that I am actively participating (s 1108(e))`
-- Past 60, not working, director satisfied: (e).
#ASSERT `Am I within the 60-month limit` FALSE 65 0 FALSE FALSE TRUE EQUALS `past the 60 months: I may continue only if the program director determines, month by month, that I am actively participating (s 1108(e))`
-- A grandmother caring for grandchildren: no limit.
#ASSERT `Am I within the 60-month limit` TRUE 100 0 FALSE FALSE FALSE EQUALS `a grant for children in the care of persons other than their parents: the time limit does not apply (s 1108(a))`

-- s 1114, s 1115(a): deferment.
#ASSERT `Are my participation requirements deferred` 60 FALSE FALSE FALSE FALSE
#ASSERT NOT (`Are my participation requirements deferred` 59 FALSE FALSE FALSE FALSE)
#ASSERT `Are my participation requirements deferred` 30 TRUE FALSE FALSE FALSE
#ASSERT `Are my participation requirements deferred` 30 FALSE TRUE FALSE FALSE
#ASSERT `Are my participation requirements deferred` 30 FALSE FALSE FALSE TRUE

-- s 1116: sanctions. HYPOTHETICAL grant $800, housing $500, housing allowance $400, no other income.
-- Month 1, first sanctioned month: $75 off: $725 (the housing floor of $400 is below).
#ASSERT `How much is our grant after a sanction` 800 1 1 1 500 400 0 EQUALS 725
-- Month 4, two adults: $300 off: $500; still within six months, floor $400 is below.
#ASSERT `How much is our grant after a sanction` 800 4 2 4 500 400 0 EQUALS 500
-- Month 5, two adults, grant $600: 600 - 300 = 300, but within six months the floor is min(500, 400) - 0 = 400.
#ASSERT `How much is our grant after a sanction` 600 5 2 5 500 400 0 EQUALS 400
-- The same in the seventh cumulative month: no protection (s 1116(g)): 300.
#ASSERT `How much is our grant after a sanction` 600 7 2 7 500 400 0 EQUALS 300
-- Floor with other income $150: 400 - 150 = 250; reduced 300 is above it: 300.
#ASSERT `How much is our grant after a sanction` 600 5 2 5 500 400 150 EQUALS 300
-- The floor never raises the grant above what it was: grant $350, month 1: 275, floor min(350, 400) = 350.
#ASSERT `How much is our grant after a sanction` 350 1 1 1 500 400 0 EQUALS 350

-- s 1132(c): payments continue if the appeal is received before the effective date.
#ASSERT `Do my payments continue during my appeal` 8 10
#ASSERT NOT (`Do my payments continue during my appeal` 10 10)

-- s 1116(h): the monthly meeting while sanctioned.
-- expect: FULFILLED (met on day 12)
#TRACE `my monthly meeting while sanctioned` AT 0 WITH
    PARTY `the participating adult` DOES `meet the case manager to report circumstances or take part in assessment` AT 12
-- expect: BREACH by the participating adult (no meeting in the month: no payment, s 1116(h))
#TRACE `my monthly meeting while sanctioned` AT 0 WITH
    (WAITUNTIL 31)

-- s 1132(c): appeal on day 8 of 10; the Department continues payments: FULFILLED.
-- expect: FULFILLED
#TRACE `my appeal of a sanction` 10 AT 0 WITH
    PARTY `the participating adult` DOES `appeal the sanction to the Human Services Board` AT 8
    PARTY `the Department for Children and Families` DOES `continue financial assistance payments pending the appeal` AT 9
-- No appeal: a permission not used is no breach. expect: FULFILLED
#TRACE `my appeal of a sanction` 10 AT 0 WITH
    (WAITUNTIL 11)
-- Appeal in time but payments stopped. expect: BREACH by the Department for Children and Families (s 1132(c))
#TRACE `my appeal of a sanction` 10 AT 0 WITH
    PARTY `the participating adult` DOES `appeal the sanction to the Human Services Board` AT 8
    (WAITUNTIL 40)
