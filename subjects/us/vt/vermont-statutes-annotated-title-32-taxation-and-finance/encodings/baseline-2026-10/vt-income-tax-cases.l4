IMPORT prelude
IMPORT `vt-income-tax`

-- Vermont personal income tax (32 V.S.A. ch. 151) -- worked cases from the taxpayer's seat.
-- Every assertion is a claim about the ENCODING on stated facts. Expected values were worked by hand from the deposited text
-- (vt-32-vsa-ch151-2026.txt), never copied from the encoding's output. All the cases use the amounts printed in the statute
-- (personal exemption $4,150; standard deduction $6,000 / $9,000 / $12,000; additional deduction $1,000; the s 5822(a)
-- ceilings). The Commissioner's inflation-adjusted figures for a real year would change every tax amount below.

-- ---------------------------------------------------------------------------------------------------------------------
-- s 5822(a): the printed fixed amounts are the tax on each ceiling at the lower rates, to the nearest dollar.
-- Joint: 64,600 x 3.35% = 2,164.10 -> 2,164; + 91,550 x 6.6% = 6,042.30 -> 8,206; + 81,800 x 7.6% = 6,216.80 -> 14,423.
#ASSERT `the fixed amount at the first ceiling` (`the amounts printed in the statute` `married filing jointly`) EQUALS 2164
#ASSERT `the fixed amount at the second ceiling` (`the amounts printed in the statute` `married filing jointly`) EQUALS 8206
#ASSERT `the fixed amount at the third ceiling` (`the amounts printed in the statute` `married filing jointly`) EQUALS 14423
-- Head of household: 1,736.975 -> 1,737; + 5,412 -> 7,149; + 6,296.60 -> 13,446.
#ASSERT `the fixed amount at the first ceiling` (`the amounts printed in the statute` `head of household`) EQUALS 1737
#ASSERT `the fixed amount at the second ceiling` (`the amounts printed in the statute` `head of household`) EQUALS 7149
#ASSERT `the fixed amount at the third ceiling` (`the amounts printed in the statute` `head of household`) EQUALS 13446
-- Unmarried: 1,296.45 -> 1,296; + 3,630 -> 4,926; + 7,733 -> 12,659.
#ASSERT `the fixed amount at the first ceiling` (`the amounts printed in the statute` `unmarried`) EQUALS 1296
#ASSERT `the fixed amount at the second ceiling` (`the amounts printed in the statute` `unmarried`) EQUALS 4926
#ASSERT `the fixed amount at the third ceiling` (`the amounts printed in the statute` `unmarried`) EQUALS 12659
-- Married filing separately: 1,082.05 -> 1,082; + 3,021.15 -> 4,103; + 3,108.40 -> 7,212.
#ASSERT `the fixed amount at the first ceiling` (`the amounts printed in the statute` `married filing separately`) EQUALS 1082
#ASSERT `the fixed amount at the second ceiling` (`the amounts printed in the statute` `married filing separately`) EQUALS 4103
#ASSERT `the fixed amount at the third ceiling` (`the amounts printed in the statute` `married filing separately`) EQUALS 7212
-- Surviving spouse uses the joint table (s 5822(a)(1)).
#ASSERT `the fixed amount at the third ceiling` (`the amounts printed in the statute` `surviving spouse`) EQUALS 14423

-- ---------------------------------------------------------------------------------------------------------------------
-- s 5861(a): must I file?
-- Required to file federally, $5,000 of Vermont income: yes.
#ASSERT `Must I file a Vermont return` TRUE 5000 0 FALSE
-- Not required to file federally and no Vermont liability: no, whatever the income.
#ASSERT NOT (`Must I file a Vermont return` FALSE 5000 5000 FALSE)
-- Not required to file federally but a Vermont liability: yes ("or has a tax liability").
#ASSERT `Must I file a Vermont return` FALSE 0 0 TRUE
-- Exactly $100 of Vermont income and exactly $1,000 of s 5823(b) income: neither is "more than"; no.
#ASSERT NOT (`Must I file a Vermont return` TRUE 100 1000 FALSE)
-- A nonresident with $1,001 of Vermont-source wages: yes.
#ASSERT `Must I file a Vermont return` TRUE 0 1001 FALSE
-- s 5861(c): a joint federal return means a joint Vermont return, unless the Commissioner allows otherwise.
#ASSERT `Must we file a joint Vermont return` TRUE FALSE
#ASSERT NOT (`Must we file a joint Vermont return` TRUE TRUE)
#ASSERT NOT (`Must we file a joint Vermont return` FALSE FALSE)

-- s 5861(b), s 5871(3): file, and pay any balance, by the federal due date (here day 105 from the end of the year).
-- expect: FULFILLED (filed on day 90 with the balance paid)
#TRACE `my duty to file and pay` 105 TRUE AT 0 WITH
    PARTY `the taxpayer` DOES `file a Vermont personal income tax return` AT 90
    PARTY `the taxpayer` DOES `pay the tax not discharged by withholding or estimated payments` AT 90
-- expect: FULFILLED (no balance; filing is enough)
#TRACE `my duty to file and pay` 105 FALSE AT 0 WITH
    PARTY `the taxpayer` DOES `file a Vermont personal income tax return` AT 100
-- expect: BREACH by the taxpayer, no return by day 105 (s 5861(b))
#TRACE `my duty to file and pay` 105 FALSE AT 0 WITH
    (WAITUNTIL 106)
-- expect: BREACH by the taxpayer, balance not paid with the return (s 5871(3))
#TRACE `my duty to file and pay` 105 TRUE AT 0 WITH
    PARTY `the taxpayer` DOES `file a Vermont personal income tax return` AT 90
    (WAITUNTIL 95)

-- ---------------------------------------------------------------------------------------------------------------------
-- s 5830e(a): the Social Security exclusion.
-- Single, AGI $55,000, $10,000 taxable benefits: all excluded.
#ASSERT `How much of my Social Security does Vermont exclude` `unmarried` 55000 10000 EQUALS 10000
-- Single, AGI $60,000: (65,000 - 60,000) / 10,000 = 0.5 of $10,000 = $5,000.
#ASSERT `How much of my Social Security does Vermont exclude` `unmarried` 60000 10000 EQUALS 5000
-- Single, AGI $65,000: none.
#ASSERT `How much of my Social Security does Vermont exclude` `unmarried` 65000 10000 EQUALS 0
-- Head of household uses the single figures: AGI $64,000 -> 0.1 of $10,000.
#ASSERT `How much of my Social Security does Vermont exclude` `head of household` 64000 10000 EQUALS 1000
-- Joint, AGI $75,000, $8,000 taxable benefits: (80,000 - 75,000) / 10,000 = 0.5 -> $4,000.
#ASSERT `How much of my Social Security does Vermont exclude` `married filing jointly` 75000 8000 EQUALS 4000
-- Joint, AGI $70,000: all.
#ASSERT `How much of my Social Security does Vermont exclude` `married filing jointly` 70000 8000 EQUALS 8000

-- ---------------------------------------------------------------------------------------------------------------------
-- s 5811(21), s 5822: taxable income and tax, printed amounts.
-- A: single resident, AGI $50,000, nothing else. Taxable 50,000 - 4,150 - 6,000 = 39,850.
-- Tax: 1,296 + 6.6% x (39,850 - 38,700 = 1,150) = 1,296 + 75.90 = 1,371.90.
#ASSERT `What is my Vermont taxable income` `unmarried` `a resident all year` 50000 0 0 0 FALSE FALSE 0 0 0 4150 6000 1000 EQUALS 39850
#ASSERT `How much Vermont income tax do I owe` `unmarried` `a resident all year` 50000 0 0 0 FALSE FALSE 0 0 0 50000 0 4150 6000 1000 38700 93700 195450 EQUALS `answered` 1371.9

-- B: joint resident, AGI $200,000, two dependents, $10,000 to charity. Exemptions 4 x 4,150 = 16,600; standard 12,000;
-- taxable 171,400. Table: 8,206 + 7.6% x 15,250 = 8,206 + 1,159 = 9,365; 3% of 200,000 = 6,000 is less, so 9,365.
-- Charitable credit 5% of 10,000 = 500. Tax 8,865.
#ASSERT `What is my Vermont taxable income` `married filing jointly` `a resident all year` 200000 0 0 0 FALSE FALSE 2 0 0 4150 12000 1000 EQUALS 171400
#ASSERT `How much Vermont income tax do I owe` `married filing jointly` `a resident all year` 200000 0 0 0 FALSE FALSE 2 0 0 200000 10000 4150 12000 1000 64600 156150 237950 EQUALS `answered` 8865
-- Charity above $20,000 counts only to $20,000: credit 1,000, tax 8,365.
#ASSERT `How much Vermont income tax do I owe` `married filing jointly` `a resident all year` 200000 0 0 0 FALSE FALSE 2 0 0 200000 50000 4150 12000 1000 64600 156150 237950 EQUALS `answered` 8365

-- C: the 3% minimum (s 5822(a)(6)). Single, AGI $160,000 with $100,000 of Vermont subtractions: modified AGI 60,000;
-- taxable 60,000 - 10,150 = 49,850; table 1,296 + 6.6% x 11,150 = 2,031.90; 3% x 160,000 = 4,800 is greater.
#ASSERT `How much Vermont income tax do I owe` `unmarried` `a resident all year` 160000 0 100000 0 FALSE FALSE 0 0 0 60000 0 4150 6000 1000 38700 93700 195450 EQUALS `answered` 4800
-- AGI of exactly $150,000 does not "exceed": the table alone. Taxable 150,000 - 10,150 = 139,850:
-- 4,926 + 7.6% x 46,150 = 4,926 + 3,507.40 = 8,433.40.
#ASSERT `How much Vermont income tax do I owe` `unmarried` `a resident all year` 150000 0 0 0 FALSE FALSE 0 0 0 150000 0 4150 6000 1000 38700 93700 195450 EQUALS `answered` 8433.4

-- D: a retired couple. Joint residents, both 65, AGI $40,000 including $12,000 of taxable Social Security (all excluded at
-- AGI up to $70,000). Modified AGI 28,000; less 2 x 4,150 + 12,000 + 2 x 1,000 = 22,300; taxable 5,700; tax 3.35% = 190.95.
#ASSERT `What is my Vermont taxable income` `married filing jointly` `a resident all year` 40000 0 0 12000 FALSE FALSE 0 2 0 4150 12000 1000 EQUALS 5700
#ASSERT `How much Vermont income tax do I owe` `married filing jointly` `a resident all year` 40000 0 0 12000 FALSE FALSE 0 2 0 28000 0 4150 12000 1000 64600 156150 237950 EQUALS `answered` 190.95

-- E: the medical deduction (s 5811(21)(C)(iv)). Single, AGI $50,000, $15,000 federal medical deduction: 15,000 - 10,150 =
-- 4,850 more; taxable 35,000. With $5,000 the remainder is negative and nothing more is deducted.
#ASSERT `What is my Vermont taxable income` `unmarried` `a resident all year` 50000 0 0 0 FALSE FALSE 0 0 15000 4150 6000 1000 EQUALS 35000
#ASSERT `What is my Vermont taxable income` `unmarried` `a resident all year` 50000 0 0 0 FALSE FALSE 0 0 5000 4150 6000 1000 EQUALS 39850

-- F: a student claimed as someone's dependent. Single, AGI $8,000: no personal exemption; taxable 2,000; tax 67.
#ASSERT `What is my Vermont taxable income` `unmarried` `a resident all year` 8000 0 0 0 TRUE FALSE 0 0 0 4150 6000 1000 EQUALS 2000
#ASSERT `How much Vermont income tax do I owe` `unmarried` `a resident all year` 8000 0 0 0 TRUE FALSE 0 0 0 8000 0 4150 6000 1000 38700 93700 195450 EQUALS `answered` 67
-- Income below the deductions: taxable income nil, tax nil.
#ASSERT `How much Vermont income tax do I owe` `unmarried` `a resident all year` 5000 0 0 0 FALSE FALSE 0 0 0 5000 0 4150 6000 1000 38700 93700 195450 EQUALS `answered` 0

-- G: a part-year resident (s 5822(e)). Facts of A, but Vermont income $25,000 of $50,000: 1,371.90 x 0.5 = 685.95.
#ASSERT `How much Vermont income tax do I owe` `unmarried` `a part-year resident` 50000 0 0 0 FALSE FALSE 0 0 0 25000 0 4150 6000 1000 38700 93700 195450 EQUALS `answered` 685.95
-- A nonresident whose Vermont income is nil: not covered.
#ASSERT `How much Vermont income tax do I owe` `unmarried` `a nonresident all year` 50000 0 0 0 FALSE FALSE 0 0 0 0 0 4150 6000 1000 38700 93700 195450 EQUALS `not covered` `my Vermont income is zero or negative, and s 5822(e) then turns on my Vermont income computed without the s 5823(a) reductions, which this encoding does not ask`

-- ---------------------------------------------------------------------------------------------------------------------
-- s 5828b: the earned income tax credit.
-- No qualifying children, federal credit $600: 100% = $600.
#ASSERT `How much is my Vermont earned income tax credit` `a resident all year` 600 FALSE 0 0 EQUALS 600
-- Qualifying children, federal credit $4,000: 38% = $1,520.
#ASSERT `How much is my Vermont earned income tax credit` `a resident all year` 4000 TRUE 0 0 EQUALS 1520
-- Part-year resident with $30,000 of $40,000 earned while resident: 1,520 x 0.75 = 1,140.
#ASSERT `How much is my Vermont earned income tax credit` `a part-year resident` 4000 TRUE 30000 40000 EQUALS 1140
-- A nonresident all year has none.
#ASSERT `How much is my Vermont earned income tax credit` `a nonresident all year` 4000 TRUE 0 0 EQUALS 0

-- s 5830f: the Vermont child tax credit.
-- Two children aged six or younger, AGI $100,000: $2,000.
#ASSERT `How much is my Vermont child tax credit` `a resident all year` TRUE 2 100000 0 0 EQUALS 2000
-- AGI $126,000: $1,000 over, $20 less a child: 2 x 980 = 1,960.
#ASSERT `How much is my Vermont child tax credit` `a resident all year` TRUE 2 126000 0 0 EQUALS 1960
-- AGI $130,500: $5,500 over is 6 thousands "or fraction thereof": $120 less a child: 2 x 880 = 1,760.
#ASSERT `How much is my Vermont child tax credit` `a resident all year` TRUE 2 130500 0 0 EQUALS 1760
-- AGI $175,000: $50,000 over: $1,000 less a child: nil. AGI $300,000: still nil, "not below zero".
#ASSERT `How much is my Vermont child tax credit` `a resident all year` TRUE 2 175000 0 0 EQUALS 0
#ASSERT `How much is my Vermont child tax credit` `a resident all year` TRUE 2 300000 0 0 EQUALS 0
-- Not entitled to the federal credit (and not for want of a TIN): nil.
#ASSERT `How much is my Vermont child tax credit` `a resident all year` FALSE 2 50000 0 0 EQUALS 0
-- Part-year resident, half the income while resident, one child, AGI $60,000: 500.
#ASSERT `How much is my Vermont child tax credit` `a part-year resident` TRUE 1 60000 30000 60000 EQUALS 500

-- s 5828c: the child and dependent care credit, 72% of the federal credit.
#ASSERT `How much is my Vermont child and dependent care credit` `a resident all year` 1000 0 0 EQUALS 720
#ASSERT `How much is my Vermont child and dependent care credit` `a part-year resident` 1000 10000 40000 EQUALS 180
