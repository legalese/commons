IMPORT prelude
IMPORT daydate
IMPORT `nd-tanf`
IMPORT `nd-tanf-seat`

-- North Dakota TANF -- worked cases from the applicant's seat.
-- Every assertion is a claim about the ENCODING on stated facts. Expected values were worked by hand from the deposited
-- texts (ndcc-t50c09.txt; nd-admin-code-75-02-01-2-tanf-income-and-standards.txt), never copied from the encoding's output.
-- All the households are HYPOTHETICAL, and so are the standard of need ($600) and the income incentive limit ($1,000):
-- neither is in the deposited text (NOTES.md finding 2).

-- ---------------------------------------------------------------------------------------------------------------------
-- s 50-09-29(1)(b), (c): benefits for "no more than sixty months".
#ASSERT (`Does the sixty-month limit stop our TANF` 59 FALSE) EQUALS FALSE
#ASSERT `Does the sixty-month limit stop our TANF` 60 FALSE
-- A parent subject to domestic violence (a hardship): exempt.
#ASSERT (`Does the sixty-month limit stop our TANF` 60 TRUE) EQUALS FALSE

-- s 50-09-29(1)(s): a child away more than one calendar month.
#ASSERT `Is TANF denied for the absent child` TRUE FALSE
#ASSERT (`Is TANF denied for the absent child` TRUE TRUE) EQUALS FALSE
#ASSERT (`Is TANF denied for the absent child` FALSE FALSE) EQUALS FALSE

-- s 50-09-06.1: the application itself assigns support rights.
#ASSERT `Does applying assign our support rights` TRUE

-- ---------------------------------------------------------------------------------------------------------------------
-- 75-02-01.2-22: the asset limit.
#ASSERT `What is our asset limit` 1 EQUALS 9000
#ASSERT `What is our asset limit` 2 EQUALS 15000
#ASSERT `What is our asset limit` 4 EQUALS 16000
-- Three people (limit $15,500): $15,400 of assets: within.
#ASSERT `Are our assets within the limit` 3 15400 0
-- $16,000 of assets that would cost $600 to sell: $15,400 net: within.
#ASSERT `Are our assets within the limit` 3 16000 600
-- $16,000 with no costs: over.
#ASSERT (`Are our assets within the limit` 3 16000 0) EQUALS FALSE

-- ---------------------------------------------------------------------------------------------------------------------
-- 75-02-01.2-50(7), -51(2)(a): the standard employment expense allowance.
-- $500 gross: the greater of $180 and $135 is $180: $320 net.
#ASSERT `net earned income` 500 EQUALS 320
-- $1,000 gross: 27% is $270: $730 net.
#ASSERT `net earned income` 1000 EQUALS 730
-- $100 gross: the $180 allowance takes it all.
#ASSERT `net earned income` 100 EQUALS 0

-- -51(2)(c)(5), (3): availability of the incentive.
#ASSERT `Is the earnings incentive available to me` FALSE FALSE
#ASSERT (`Is the earnings incentive available to me` TRUE FALSE) EQUALS FALSE
#ASSERT `Is the earnings incentive available to me` TRUE TRUE

-- -51(2)(b), (c): $730 net, within a $1,000 limit.
-- Month 3: at least 50% disregarded: $365 counts.
#ASSERT `countable earned income` 730 1000 3 TRUE EQUALS 365
-- Month 8: 35%: $474.50 counts.
#ASSERT `countable earned income` 730 1000 8 TRUE EQUALS 474.5
-- Month 11: 25%: $547.50 counts.
#ASSERT `countable earned income` 730 1000 11 TRUE EQUALS 547.5
-- Month 13: none disregarded after the twelfth month.
#ASSERT `countable earned income` 730 1000 13 TRUE EQUALS 730
-- A $500 limit, month 3: half of $500 ($250) plus all of the $230 above the limit: $480.
#ASSERT `countable earned income` 730 500 3 TRUE EQUALS 480
-- The incentive is not available: all $730 counts.
#ASSERT `countable earned income` 730 1000 3 FALSE EQUALS 730
-- The seat question, from $1,000 gross, month 3: $365.
#ASSERT `How much of our earnings counts` 1000 1000 3 TRUE EQUALS 365

-- ---------------------------------------------------------------------------------------------------------------------
-- -47, -48, -42, -43: the grant.
-- Countable earnings $365, $200 unearned, $50 premium, $100 child care: adjusted net income $415.
#ASSERT `adjusted net income` 365 200 50 100 EQUALS 415
-- Standard of need $600: passes; grant $185.
#ASSERT `the household passes the net income test` 415 600 0
#ASSERT `How much TANF a month` 600 0 365 200 50 100 EQUALS 185
-- Adjusted net income $415.50: $184.50 rounded down to $184.
#ASSERT `How much TANF a month` 600 0 365.5 200 50 100 EQUALS 184
-- Adjusted net income $595: $5 is under $10: no payment.
#ASSERT `How much TANF a month` 600 0 595 0 0 0 EQUALS 0
-- Adjusted net income equal to the need: fails the test (-47(2): "equals or exceeds").
#ASSERT (`the household passes the net income test` 600 600 0) EQUALS FALSE
#ASSERT `How much TANF a month` 600 0 600 0 0 0 EQUALS 0
-- A $40 special item of need: the test and the grant use $640.
#ASSERT `How much TANF a month` 600 40 600 0 0 0 EQUALS 40

-- The no-payment rule as a prohibition: a calculated benefit of $5; the agency issues nothing in the month (an attempt
-- logged only at month 2, after it): respected.
#ASSERT EVALTRACE (`no payment for the month` 5 FALSE) 0 (LIST EVENT `the state agency` `issue a benefit payment for the month` 2) EQUALS FULFILLED
-- expect: BREACH BY `the state agency`, "payment issued under ten dollars (N.D.A.C. 75-02-01.2-43) or beyond sixty months (N.D.C.C. s 50-09-29(1)(b))" -- a payment issued within the month.
#TRACE `no payment for the month` 5 FALSE AT 0 WITH
    PARTY `the state agency` DOES `issue a benefit payment for the month` AT 0.5
-- A $185 benefit and no time limit: no prohibition.
#ASSERT EVALTRACE (`no payment for the month` 185 FALSE) 0 (LIST EVENT `the state agency` `issue a benefit payment for the month` 0.5) EQUALS FULFILLED

-- s 50-09-14(1): an appeal: the state agency must afford notice and a fair hearing.
#ASSERT EVALTRACE (`my fair hearing on appeal` TRUE) 0 (LIST EVENT `the state agency` `afford reasonable notice and an opportunity for a fair hearing` 30) EQUALS FULFILLED
