IMPORT prelude
IMPORT daydate
IMPORT `nd-pit`
IMPORT `nd-pit-seat`

-- North Dakota Century Code chapter 57-38 -- worked cases from the seat of the individual taxpayer.
-- Every assertion is a claim about the ENCODING on stated facts. Expected values were worked by hand from the deposited
-- text (ndcc-t57c38.txt, 07/01/25 update), never copied from the encoding's output. All the people are HYPOTHETICAL, and so
-- are the indexed thresholds (47,000 / 235,000) and the federal basic standard deduction (32,200) used below: the deposited
-- text does not state them (NOTES.md findings 3 and 6).

-- ---------------------------------------------------------------------------------------------------------------------
-- s 57-38-01(11): residence.
#ASSERT `Am I a North Dakota resident` TRUE FALSE 0
#ASSERT `Am I a North Dakota resident` FALSE TRUE 8
-- Seven months is not "more than seven months".
#ASSERT (`Am I a North Dakota resident` FALSE TRUE 7) EQUALS FALSE
-- No permanent place of abode: months alone do not make a resident.
#ASSERT (`Am I a North Dakota resident` FALSE FALSE 10) EQUALS FALSE

-- s 57-38-31(1): who must file.
#ASSERT `Must I file a North Dakota return` TRUE TRUE FALSE
-- A nonresident with North Dakota wages must file.
#ASSERT `Must I file a North Dakota return` FALSE FALSE TRUE
-- A resident with no federal filing requirement and no North Dakota-source income need not.
#ASSERT (`Must I file a North Dakota return` TRUE FALSE FALSE) EQUALS FALSE
-- A nonresident with no North Dakota-source income need not, even if a federal return is required.
#ASSERT (`Must I file a North Dakota return` FALSE TRUE FALSE) EQUALS FALSE

-- s 57-38-34(2): the 2026 return is due on 15 April 2027, with payment (s 57-38-35).
#ASSERT `By when must I file and pay` 2026 EQUALS Date 15 4 2027
#ASSERT EVALTRACE (`my duty to file and pay` 2026) 0 (LIST EVENT `the taxpayer` `file the return` 100, EVENT `the taxpayer` `pay the tax computed on the return` 100) EQUALS FULFILLED

-- s 57-38-34.4: an IRS change final on 1 June 2026 must be reported by 30 August 2026.
#ASSERT `By when must I report a federal change` (Date 1 6 2026) EQUALS Date 30 8 2026
#ASSERT EVALTRACE (`my duty to report a federal change` `changed or corrected by the IRS or other competent authority`) 0 (LIST EVENT `the taxpayer` `report the federal change by an amended state return` 80) EQUALS FULFILLED
#ASSERT EVALTRACE (`my duty to report a federal change` `an amended federal return I filed`) 0 (LIST EVENT `the taxpayer` `file an amended state return with a copy of the amended federal return` 90) EQUALS FULFILLED
-- expect: BREACH BY `the taxpayer`, "federal change not reported within ninety days of the final determination (s 57-38-34.4(1))" -- reported on day 100.
#TRACE `my duty to report a federal change` `changed or corrected by the IRS or other competent authority` AT 0 WITH
    PARTY `the taxpayer` DOES `report the federal change by an amended state return` AT 100

-- ---------------------------------------------------------------------------------------------------------------------
-- s 57-38-30.3(2): North Dakota taxable income.
-- Federal taxable income $60,000; $500 of US bond interest; $10,000 long-term gain (40% = $4,000); $12,000 of taxable social
-- security: $60,000 - $500 - $4,000 - $12,000 = $43,500.
#ASSERT `What is my North Dakota taxable income` 60000 500 10000 0 0 0 0 12000 0 0 EQUALS 43500
-- (d): a net capital loss gives no reduction; $1,000 of qualified dividends gives $400.
#ASSERT `the s 57-38-30.3(2)(d) reduction` (-3000) 1000 EQUALS 400
-- (g), (r): $20,000 of military retirement and $5,000 of guard pay come off; (e): a $8,000 averaged lump sum is added.
#ASSERT `What is my North Dakota taxable income` 70000 0 0 0 8000 5000 20000 0 0 0 EQUALS 53000
-- Never below zero.
#ASSERT `What is my North Dakota taxable income` 10000 0 0 0 0 0 0 15000 0 0 EQUALS 0

-- s 57-38-30.3(1): the tax on the schedules printed in the Century Code.
-- Single, $43,500: within the 0.00% bracket (to $44,725): nil.
#ASSERT `How much North Dakota tax on the printed schedule` `single` TRUE 43500 EQUALS `answered` 0
-- Single, $100,000: 1.95% of $55,275 = $1,077.8625.
#ASSERT `How much North Dakota tax on the printed schedule` `single` TRUE 100000 EQUALS `answered` 1077.8625
-- Single, $300,000: 1.95% of $181,250 ($3,534.375; printed as $3,534.38) + 2.50% of $74,025 ($1,850.625) = $5,385.
#ASSERT `How much North Dakota tax on the printed schedule` `single` TRUE 300000 EQUALS `answered` 5385
-- Joint, $100,000: 1.95% of $25,250 = $492.375. Surviving spouse: the same schedule.
#ASSERT `How much North Dakota tax on the printed schedule` `married filing jointly` TRUE 100000 EQUALS `answered` 492.375
#ASSERT `How much North Dakota tax on the printed schedule` `surviving spouse` TRUE 100000 EQUALS `answered` 492.375
-- Head of household at exactly $59,950: "not over" the first figure: nil.
#ASSERT `How much North Dakota tax on the printed schedule` `head of household` TRUE 59950 EQUALS `answered` 0
-- Married filing separately, $200,000: 1.95% of $100,175 ($1,953.4125) + 2.50% of $62,450 ($1,561.25) = $3,514.6625.
#ASSERT `How much North Dakota tax on the printed schedule` `married filing separately` TRUE 200000 EQUALS `answered` 3514.6625
-- A part-year resident: not covered.
#ASSERT `How much North Dakota tax on the printed schedule` `single` FALSE 100000 EQUALS `not covered` `the tax of an individual who is not a resident for the entire year is prorated under s 57-38-30.3(1)(f), which is not encoded`

-- s 57-38-30.3(1)(g): an indexed schedule (HYPOTHETICAL figures $47,000 / $235,000), single, $100,000: 1.95% of $53,000.
#ASSERT `How much North Dakota tax on the indexed schedule` TRUE 100000 47000 235000 EQUALS `answered` 1033.5
-- The printed figures given as inputs reproduce the printed schedule.
#ASSERT `How much North Dakota tax on the indexed schedule` TRUE 300000 44725 225975 EQUALS `answered` 5385

-- ---------------------------------------------------------------------------------------------------------------------
-- s 57-38-01.28: the marriage penalty credit, printed schedules, federal exemption amount 0, a HYPOTHETICAL federal basic
-- standard deduction of $32,200 (half: $16,100), maximum $300.
-- Joint income $150,000, lower earner's qualifying income $60,000: q = $43,900. Joint tax: 1.95% of $75,250 = $1,467.375.
-- As two singles: $43,900 is in the 0.00% bracket; $106,100 is 1.95% of $61,375 = $1,196.8125. Credit: $270.5625.
#ASSERT `How much is our marriage penalty credit` 150000 60000 0 32200 300 EQUALS 270.5625
-- Joint income $100,000, lower earner $50,000: q = $33,900; joint tax $492.375; singles $0 + 1.95% of $21,375 ($416.8125).
#ASSERT `How much is our marriage penalty credit` 100000 50000 0 32200 300 EQUALS 75.5625
-- Joint income $400,000, lower earner $200,000: joint tax $7,029.325, singles $6,055.725: $973.60, capped at $300.
#ASSERT `How much is our marriage penalty credit` 400000 200000 0 32200 300 EQUALS 300
-- A one-earner couple (lower earner's qualifying income nil): q = 0; joint tax on $100,000 is $492.375, single tax on
-- $100,000 is $1,077.8625: the joint return already costs less, so no credit.
#ASSERT `How much is our marriage penalty credit` 100000 0 0 32200 300 EQUALS 0
