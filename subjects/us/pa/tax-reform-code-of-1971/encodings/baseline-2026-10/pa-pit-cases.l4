IMPORT prelude
IMPORT `pa-pit`
IMPORT `pa-pit-seat`

-- Tax Reform Code of 1971, Article III -- worked cases from the taxpayer's seat.
-- Every assertion is a claim about the ENCODING on stated facts. Expected values were worked by hand from the deposited
-- text (ss 301(p), 302, 303, 304, 312, 314, 330, 332, 336.1), never copied from the encoding's output. The people are
-- hypothetical.

-- ---------------------------------------------------------------------------------------------------------------------
-- Residence, s 301(p).
-- Domiciled in Pennsylvania, no permanent abode there, a permanent abode elsewhere, 20 days in the state: the "unless"
-- limb applies, so not a resident.
#ASSERT (NOT (`Am I a Pennsylvania resident individual` TRUE FALSE TRUE 20))
-- The same, but 31 days in the state: more than thirty, so the exception fails and the domiciliary is a resident.
#ASSERT `Am I a Pennsylvania resident individual` TRUE FALSE TRUE 31
-- Domiciled, keeps a home in Pennsylvania: a resident whatever the days.
#ASSERT `Am I a Pennsylvania resident individual` TRUE TRUE TRUE 0
-- Not domiciled, keeps a Pennsylvania abode: resident at 184 days, not at 183 ("more than one hundred eighty-three").
#ASSERT `Am I a Pennsylvania resident individual` FALSE TRUE TRUE 184
#ASSERT (NOT (`Am I a Pennsylvania resident individual` FALSE TRUE TRUE 183))
-- Not domiciled, no Pennsylvania abode: not a resident even at 200 days.
#ASSERT (NOT (`Am I a Pennsylvania resident individual` FALSE FALSE TRUE 200))

-- ---------------------------------------------------------------------------------------------------------------------
-- Must I file, s 330(a): "every taxpayer having income for the taxable year". There is no filing threshold.
-- A student with $10 of interest must file.
#ASSERT `Must I file a Pennsylvania return` 0 0 0 0 0 10 0 0 EQUALS `yes: I have income in a class, so I must file a return, and pay any tax due, by the day my federal income tax return is due or would be due (ss 330(a), 332)`
-- Only a business loss: no income in any class, no return required.
#ASSERT `Must I file a Pennsylvania return` 0 (0 MINUS 4000) 0 0 0 0 0 0 EQUALS `no: I have no income in any class of s 303 for the year, so s 330(a) does not require a return`

-- ---------------------------------------------------------------------------------------------------------------------
-- The tax, s 302: 3.07% of each dollar of income in each class; a loss in one class does not reduce another.
-- Resident: wages 50,000, interest 200, a 3,000 loss on selling shares. Taxed: 50,200. 50,200 x 3.07% = 1,541.14.
#ASSERT `How much Pennsylvania tax is imposed on me` `resident for the whole taxable year` 50000 0 (0 MINUS 3000) 0 0 200 0 0 EQUALS `answered` 1541.14
-- Nonresident with 20,000 of Pennsylvania-source wages: 614.
#ASSERT `How much Pennsylvania tax is imposed on me` `nonresident for the whole taxable year` 20000 0 0 0 0 0 0 0 EQUALS `answered` 614
-- Part-year resident: not covered.
#ASSERT `How much Pennsylvania tax is imposed on me` `resident for part of the taxable year` 20000 0 0 0 0 0 0 0 EQUALS `not covered` `a part-year resident's tax is not encoded (the year is split between the resident and nonresident rules of s 302(a) and (b) by department regulation, not deposited)`

-- ---------------------------------------------------------------------------------------------------------------------
-- Tax Forgiveness, s 304(d).
-- The limit: single 6,500; married 13,000; plus 9,500 for each dependent.
#ASSERT `The most poverty income for full forgiveness` FALSE FALSE FALSE FALSE 0 EQUALS 6500
#ASSERT `The most poverty income for full forgiveness` FALSE FALSE FALSE FALSE 2 EQUALS 25500
#ASSERT `The most poverty income for full forgiveness` TRUE FALSE FALSE FALSE 1 EQUALS 22500
-- Married, separate returns, lived apart for the last six months: not "married" for s 304, so the single limit.
#ASSERT `The most poverty income for full forgiveness` TRUE TRUE TRUE FALSE 0 EQUALS 6500
-- Married, separate returns, separated under a written agreement: likewise.
#ASSERT `The most poverty income for full forgiveness` TRUE TRUE FALSE TRUE 0 EQUALS 6500
-- Married, separate returns but living together: both conditions are needed ("and"), so still married: 13,000.
#ASSERT `The most poverty income for full forgiveness` TRUE TRUE FALSE FALSE 0 EQUALS 13000

-- A single parent with two dependent children and poverty income of 25,500: all forgiven.
#ASSERT `What share of my tax is forgiven` FALSE FALSE FALSE FALSE FALSE 25500 2 EQUALS 100%
-- 25,600: 100 over the limit, "not in excess of" 250: 90 per cent.
#ASSERT `What share of my tax is forgiven` FALSE FALSE FALSE FALSE FALSE 25600 2 EQUALS 90%
-- 26,000: 500 over: 80 per cent (500 is "not in excess of" 500).
#ASSERT `What share of my tax is forgiven` FALSE FALSE FALSE FALSE FALSE 26000 2 EQUALS 80%
-- 27,750: 2,250 over: 10 per cent. 27,751: nothing.
#ASSERT `What share of my tax is forgiven` FALSE FALSE FALSE FALSE FALSE 27750 2 EQUALS 10%
#ASSERT `What share of my tax is forgiven` FALSE FALSE FALSE FALSE FALSE 27751 2 EQUALS 0
-- A married couple, joint poverty income 13,000, no children: all forgiven.
#ASSERT `What share of my tax is forgiven` FALSE TRUE FALSE FALSE FALSE 13000 0 EQUALS 100%
-- A student whom her parents claim as a dependent, with poverty income of 3,000: not a "claimant" (s 301(c.2)): nothing.
#ASSERT `What share of my tax is forgiven` TRUE FALSE FALSE FALSE FALSE 3000 0 EQUALS 0

-- ---------------------------------------------------------------------------------------------------------------------
-- Credit for tax paid to another state, s 314.
-- Resident, 100,000 taxable (tax 3,070); 40,000 of it also taxed by another state, which charged 2,000.
-- The cap: 3,070 x 40,000 / 100,000 = 1,228. Credit 1,228.
#ASSERT `My credit for tax paid to another state` `resident for the whole taxable year` 3070 100000 40000 2000 EQUALS `answered` 1228
-- The other state charged 1,000: under the cap, so 1,000.
#ASSERT `My credit for tax paid to another state` `resident for the whole taxable year` 3070 100000 40000 1000 EQUALS `answered` 1000
-- A nonresident gets none (s 314(a) is for "a resident taxpayer").
#ASSERT `My credit for tax paid to another state` `nonresident for the whole taxable year` 3070 100000 40000 2000 EQUALS `answered` 0

-- ---------------------------------------------------------------------------------------------------------------------
-- What is left, ss 314, 304, 312.
-- The 100,000 resident above, 1,800 withheld, no forgiveness: 3,070 - 1,228 = 1,842; less 1,800 = 42 to pay.
#ASSERT `How much Pennsylvania tax do I still owe` `resident for the whole taxable year` 100000 0 0 0 0 0 0 0 40000 2000 FALSE FALSE FALSE FALSE FALSE 100000 0 1800 EQUALS `answered` 42
-- The 50,200 resident, 1,540 withheld: 1.14 to pay.
#ASSERT `How much Pennsylvania tax do I still owe` `resident for the whole taxable year` 50000 0 (0 MINUS 3000) 0 0 200 0 0 0 0 FALSE FALSE FALSE FALSE FALSE 50200 0 1540 EQUALS `answered` 1.14
-- Single parent, two children, wages 26,000 (poverty income 26,000), 798.20 withheld. Tax 26,000 x 3.07% = 798.20;
-- 80 per cent forgiven = 638.56; liability 159.64; less 798.20 withheld = 638.56 to come back.
#ASSERT `How much Pennsylvania tax do I still owe` `resident for the whole taxable year` 26000 0 0 0 0 0 0 0 0 0 FALSE FALSE FALSE FALSE FALSE 26000 2 798.20 EQUALS `answered` (0 MINUS 638.56)
-- Single parent, two children, wages 25,000, 767.50 withheld: all forgiven, all 767.50 comes back.
#ASSERT `How much Pennsylvania tax do I still owe` `resident for the whole taxable year` 25000 0 0 0 0 0 0 0 0 0 FALSE FALSE FALSE FALSE FALSE 25000 2 767.50 EQUALS `answered` (0 MINUS 767.50)
-- Part-year: not covered.
#ASSERT `How much Pennsylvania tax do I still owe` `resident for part of the taxable year` 25000 0 0 0 0 0 0 0 0 0 FALSE FALSE FALSE FALSE FALSE 25000 2 767.50 EQUALS `not covered` `a part-year resident's tax is not encoded (the year is split between the resident and nonresident rules of s 302(a) and (b) by department regulation, not deposited)`

-- ---------------------------------------------------------------------------------------------------------------------
-- The duties, ss 330(a), 332, 336.1. Day 0 is the end of the taxable year (31 December); a hypothetical federal due date
-- 105 days later (15 April in a non-leap year).
#ASSERT EVALTRACE (`the duty to file a return` 105) 0 (LIST (EVENT `the taxpayer` `file a Pennsylvania personal income tax return` 100)) EQUALS FULFILLED
#ASSERT EVALTRACE (`the duty to pay the tax due` 105) 0 (LIST (EVENT `the taxpayer` `pay the tax due` 105)) EQUALS FULFILLED
-- Not claiming Tax Forgiveness is no breach (s 336.1, "may").
#ASSERT EVALTRACE (`the permission to claim the special tax provisions` 105) 0 (LIST (WAITUNTIL 200)) EQUALS FULFILLED
-- expect: BREACH by the taxpayer (no return by day 105)
#TRACE (`the duty to file a return` 105) AT 0 WITH
    (WAITUNTIL 106)
-- expect: BREACH by the taxpayer (an extension to file does not move the day to pay; payment on day 150 is late)
#TRACE (`the duty to pay the tax due` 105) AT 0 WITH
    PARTY `the taxpayer` DOES `pay the tax due` AT 150
