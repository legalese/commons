IMPORT prelude
IMPORT daydate
IMPORT `pa-hsc`
IMPORT `pa-hsc-seat`

-- Human Services Code, Article IV -- worked cases from the seat of the applicant for, or recipient of, cash assistance.
-- Every assertion is a claim about the ENCODING on stated facts. Expected values were worked by hand from the deposited
-- text, never copied from the encoding's output. The people are hypothetical.

-- ---------------------------------------------------------------------------------------------------------------------
-- General assistance cash ceased on 1 August 2019 (s 403.2(a)).
#ASSERT `Can I get general assistance cash` (Date 24 10 2026) EQUALS `no general assistance cash is payable: the program ceased on August 1, 2019 (s 403.2(a)); general assistance-related medical assistance continues (s 403.2(b))`
#ASSERT `Can I get general assistance cash` (Date 1 8 2019) EQUALS `no general assistance cash is payable: the program ceased on August 1, 2019 (s 403.2(a)); general assistance-related medical assistance continues (s 403.2(b))`
#ASSERT `Can I get general assistance cash` (Date 31 7 2019) EQUALS `general assistance cash could be payable for this day, which is before August 1, 2019, if the person was in a class of s 432(3)`

-- State supplemental assistance (s 432(2)).
-- An SSI recipient: eligible (i).
#ASSERT `Am I eligible for State supplemental assistance` TRUE TRUE 0 0
-- Not on SSI, disabled, income 900 against a combined 1,000: eligible (ii). At 1,000 exactly: not "less than".
#ASSERT `Am I eligible for State supplemental assistance` FALSE TRUE 900 1000
#ASSERT (NOT (`Am I eligible for State supplemental assistance` FALSE TRUE 1000 1000))
-- Not aged, blind or disabled and not on SSI: not eligible.
#ASSERT (NOT (`Am I eligible for State supplemental assistance` FALSE FALSE 100 1000))

-- ---------------------------------------------------------------------------------------------------------------------
-- What bars me (ss 432, 432.22). Order of inputs: citizen, federal law requires, resident, inmate, gave property away,
-- SSI, ABD, SSI income, combined, sentenced, served, paid, parole/probation, payment plan, age, ever married, pregnant or
-- caring, lives with adult, department exception, evidence.
-- A 30-year-old citizen mother in Pittsburgh with nothing in her past: nothing bars her.
#ASSERT `Is anything barring me from cash assistance` TRUE FALSE TRUE FALSE FALSE FALSE FALSE 0 0 FALSE FALSE FALSE FALSE FALSE 30 TRUE TRUE FALSE FALSE FALSE EQUALS `nothing in s 432(4), (5)(i), (9), (10) or s 432.22 bars me; the class, resource, income and work conditions still apply`
-- A non-citizen whom federal law does not require be assisted: barred (s 432.22).
#ASSERT `Is anything barring me from cash assistance` FALSE FALSE TRUE FALSE FALSE FALSE FALSE 0 0 FALSE FALSE FALSE FALSE FALSE 30 TRUE TRUE FALSE FALSE FALSE EQUALS `barred` `not a citizen, and federal law does not specifically require assistance (s 432.22)`
-- A non-citizen whom federal law requires be assisted: not barred by s 432.22.
#ASSERT `Is anything barring me from cash assistance` FALSE TRUE TRUE FALSE FALSE FALSE FALSE 0 0 FALSE FALSE FALSE FALSE FALSE 30 TRUE TRUE FALSE FALSE FALSE EQUALS `nothing in s 432(4), (5)(i), (9), (10) or s 432.22 bars me; the class, resource, income and work conditions still apply`
-- Gave away a $2,000 car a year before applying: barred (s 432(4)(i)) ...
#ASSERT `Is anything barring me from cash assistance` TRUE FALSE TRUE FALSE TRUE FALSE FALSE 0 0 FALSE FALSE FALSE FALSE FALSE 30 TRUE TRUE FALSE FALSE FALSE EQUALS `barred` `disposed of property worth $500 or more without fair consideration in the two years before applying, and not eligible for State supplemental assistance (s 432(4)(i))`
-- ... unless she is eligible for State supplemental assistance (here, an SSI recipient).
#ASSERT `Is anything barring me from cash assistance` TRUE FALSE TRUE FALSE TRUE TRUE TRUE 0 0 FALSE FALSE FALSE FALSE FALSE 30 TRUE TRUE FALSE FALSE FALSE EQUALS `nothing in s 432(4), (5)(i), (9), (10) or s 432.22 bars me; the class, resource, income and work conditions still apply`
-- Served her sentence but owes restitution, not on parole or probation: barred (s 432(9)).
#ASSERT `Is anything barring me from cash assistance` TRUE FALSE TRUE FALSE FALSE FALSE FALSE 0 0 TRUE TRUE FALSE FALSE FALSE 30 TRUE TRUE FALSE FALSE FALSE EQUALS `barred` `sentenced for a felony or misdemeanor and has not satisfied the penalty (s 432(9))`
-- On parole and keeping to an approved payment plan: not excluded ("Nothing in this clause shall be deemed to exclude").
#ASSERT `Is anything barring me from cash assistance` TRUE FALSE TRUE FALSE FALSE FALSE FALSE 0 0 TRUE FALSE FALSE TRUE TRUE 30 TRUE TRUE FALSE FALSE FALSE EQUALS `nothing in s 432(4), (5)(i), (9), (10) or s 432.22 bars me; the class, resource, income and work conditions still apply`
-- On probation but neither paid nor on a payment plan: barred.
#ASSERT `Is anything barring me from cash assistance` TRUE FALSE TRUE FALSE FALSE FALSE FALSE 0 0 TRUE FALSE FALSE TRUE FALSE 30 TRUE TRUE FALSE FALSE FALSE EQUALS `barred` `sentenced for a felony or misdemeanor and has not satisfied the penalty (s 432(9))`
-- A 17-year-old unmarried mother living on her own, no exception: barred (s 432(10)).
#ASSERT `Is anything barring me from cash assistance` TRUE FALSE TRUE FALSE FALSE FALSE FALSE 0 0 FALSE FALSE FALSE FALSE FALSE 17 FALSE TRUE FALSE FALSE FALSE EQUALS `barred` `an unmarried parent under 18 who is not living with a parent, legal guardian or other adult relative or in an approved adult-supervised arrangement, and no exception applies (s 432(10))`
-- The same, but she can show her mother refuses to house her: the exception applies.
#ASSERT `Is anything barring me from cash assistance` TRUE FALSE TRUE FALSE FALSE FALSE FALSE 0 0 FALSE FALSE FALSE FALSE FALSE 17 FALSE TRUE FALSE FALSE TRUE EQUALS `nothing in s 432(4), (5)(i), (9), (10) or s 432.22 bars me; the class, resource, income and work conditions still apply`
-- The same at 18: s 432(10) is for those "under eighteen".
#ASSERT `Is anything barring me from cash assistance` TRUE FALSE TRUE FALSE FALSE FALSE FALSE 0 0 FALSE FALSE FALSE FALSE FALSE 18 FALSE TRUE FALSE FALSE FALSE EQUALS `nothing in s 432(4), (5)(i), (9), (10) or s 432.22 bars me; the class, resource, income and work conditions still apply`
-- Not a resident of Pennsylvania: barred (s 432(5)(i)).
#ASSERT `Is anything barring me from cash assistance` TRUE FALSE FALSE FALSE FALSE FALSE FALSE 0 0 FALSE FALSE FALSE FALSE FALSE 30 TRUE TRUE FALSE FALSE FALSE EQUALS `barred` `not a resident of Pennsylvania (s 432(5)(i)); a transient may be given up to seven days of assistance as vendor payments`
-- A strike month: no aid for that month (s 432(6)).
#ASSERT `no aid is paid to the family for the month because of a strike` TRUE

-- ---------------------------------------------------------------------------------------------------------------------
-- Resources (s 432.5).
-- A single person with $600 in the bank and a car worth $10,000 clear: $350 is an available resource.
#ASSERT `How much of our property counts as a resource` 1 600 10000 EQUALS 350
-- A mother and two children with $900: within the $1,000 allowance: nothing.
#ASSERT `How much of our property counts as a resource` 3 900 0 EQUALS 0
-- The same family with $1,500 and a car with $45,000 of equity: the car is not excluded: 1,500 + 45,000 - 1,000 = 45,500.
#ASSERT `How much of our property counts as a resource` 3 1500 45000 EQUALS 45500
-- The car at $39,999 of equity is excluded: 1,500 - 1,000 = 500.
#ASSERT `How much of our property counts as a resource` 3 1500 39999 EQUALS 500

-- ---------------------------------------------------------------------------------------------------------------------
-- Whose income counts (s 432.12(a)).
#ASSERT (NOT (`Does this member's income count` 13 FALSE FALSE))
#ASSERT (NOT (`Does this member's income count` 15 TRUE FALSE))
#ASSERT `Does this member's income count` 15 FALSE FALSE
#ASSERT `Does this member's income count` 17 TRUE TRUE
#ASSERT (NOT (`Does this member's income count` 21 TRUE FALSE))
#ASSERT `Does this member's income count` 22 TRUE FALSE
-- The 50 per cent disregard is for recipients: earnings 1,000 and child support 200 count as 700 for a recipient and
-- 1,200 for an applicant.
#ASSERT `How much of our income counts for eligibility` TRUE 1000 200 EQUALS 700
#ASSERT `How much of our income counts for eligibility` FALSE 1000 200 EQUALS 1200

-- A family six months in Pennsylvania from a state paying at most $300: capped at $300 if Pennsylvania's maximum is $403.
#ASSERT `The most cash assistance we can get` 6 300 403 EQUALS 300
#ASSERT `The most cash assistance we can get` 12 300 403 EQUALS 403
#ASSERT `The most cash assistance we can get` 6 500 403 EQUALS 403

-- ---------------------------------------------------------------------------------------------------------------------
-- Work requirements (s 405.1).
-- A 16-year-old mother: exempt (a.3)(3).
#ASSERT `What work requirement applies to me` FALSE FALSE 16 0 3 EQUALS `exempt under s 405.1(a.3); may still take part (s 405.1(b)); one under 18 must pursue a high school diploma or equivalency`
-- A mother caring for a two-year-old with no child care: exempt (a.3)(2).
#ASSERT `What work requirement applies to me` FALSE TRUE 28 0 3 EQUALS `exempt under s 405.1(a.3); may still take part (s 405.1(b)); one under 18 must pursue a high school diploma or equivalency`
-- Ten months in, working 25 hours a week: seek, accept and keep work.
#ASSERT `What work requirement applies to me` FALSE FALSE 28 25 10 EQUALS `must seek employment, accept any offer of employment and maintain employment (s 405.1(a.2)(1))`
-- Ten months in, working 5 hours a week: a work-related activity, starting with up to eight weeks of job search.
#ASSERT `What work requirement applies to me` FALSE FALSE 28 5 10 EQUALS `must also take part in a work-related activity, beginning with an independent job search of up to eight weeks (s 405.1(a.2)(2), (3))`
-- Twenty-four months in: the 20-hour rule.
#ASSERT `What work requirement applies to me` FALSE FALSE 28 25 24 EQUALS `having received assistance for 24 months, must work or take part in subsidized employment, work experience, on-the-job training, community service or workfare for an average of at least 20 hours a week (s 405.1(a.2)(6))`

-- Disqualification (s 432.3).
#ASSERT `What disqualification do I face` 1 10 EQUALS `Disqualification outcome` WITH `length` IS `at least 30 days, and until willing to comply`, `who` IS `only the individual`
#ASSERT `What disqualification do I face` 1 24 EQUALS `Disqualification outcome` WITH `length` IS `at least 30 days, and until willing to comply`, `who` IS `only the individual`
#ASSERT `What disqualification do I face` 2 30 EQUALS `Disqualification outcome` WITH `length` IS `at least 60 days, and until willing to comply`, `who` IS `the entire assistance group`
#ASSERT `What disqualification do I face` 3 30 EQUALS `Disqualification outcome` WITH `length` IS `permanent`, `who` IS `the entire assistance group`
#ASSERT `The earliest day my disqualification can end` (Date 1 3 2026) 1 EQUALS JUST (Date 31 3 2026)
#ASSERT `The earliest day my disqualification can end` (Date 1 3 2026) 2 EQUALS JUST (Date 30 4 2026)
#ASSERT `The earliest day my disqualification can end` (Date 1 3 2026) 3 EQUALS NOTHING

-- After a disability exemption ends (s 405.1(a.4)(1)): immediately in the first 22 months; within eight weeks after.
#ASSERT `How long do I have to start the work requirements` 10 EQUALS 0
#ASSERT `How long do I have to start the work requirements` 22 EQUALS 56

-- ---------------------------------------------------------------------------------------------------------------------
-- Notice and appeal (ss 432.17, 423).
-- Notice mailed 1 October 2026: the cut can take effect from 11 October 2026.
#ASSERT `When can the cut take effect` (Date 1 10 2026) EQUALS Date 11 10 2026
-- Appealed within the period, on the facts: assistance continues. On law or policy only: it does not.
#ASSERT `Does my assistance continue pending the hearing` TRUE TRUE FALSE
#ASSERT (NOT (`Does my assistance continue pending the hearing` TRUE TRUE TRUE))
#ASSERT (NOT (`Does my assistance continue pending the hearing` TRUE FALSE FALSE))

-- The regulative rules.
#ASSERT EVALTRACE (`the duty to comply once a disability exemption ends` 30) 0 (LIST (EVENT `the applicant or recipient` `comply with the employment and work-related activity requirements` 50)) EQUALS FULFILLED
#ASSERT EVALTRACE (`the duty to report a change` 10) 0 (LIST (EVENT `the applicant or recipient` `report the change in circumstances` 7)) EQUALS FULFILLED
-- Not appealing is no breach (s 423, "may").
#ASSERT EVALTRACE `the right to request a fair hearing within the timely notice period` 0 (LIST (WAITUNTIL 30)) EQUALS FULFILLED
-- expect: BREACH by the applicant or recipient (change reported on day 12, after the 10-day period)
#TRACE (`the duty to report a change` 10) AT 0 WITH
    PARTY `the applicant or recipient` DOES `report the change in circumstances` AT 12
-- expect: BREACH by the applicant or recipient (exemption ended in month 10: compliance was due at once)
#TRACE (`the duty to comply once a disability exemption ends` 10) AT 0 WITH
    PARTY `the applicant or recipient` DOES `comply with the employment and work-related activity requirements` AT 5
