IMPORT prelude
IMPORT daydate
IMPORT `sc-income-tax`

-- South Carolina Income Tax Act -- the individual taxpayer's questions, worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Expected values were worked by hand
-- from the deposited text (the rate formulas of s 12-6-510 and the 2025 Tax Computation Schedule in its Editor's Note),
-- not copied from the encoding's output. Federal figures (standard deduction, EITC, the dependent exemption as indexed)
-- are inputs; figures marked HYPOTHETICAL are invented for the case and are not the real amounts.

-- ---------------------------------------------------------------------------------------------------------------------
-- s 12-6-510 and the 2025 schedule: tax on a given South Carolina taxable income.
-- $3,000: under $3,560, 0%.
#ASSERT `What is my 2025 South Carolina tax before credits` 3000 EQUALS 0
-- $3,560: 3% x 3,560 = 106.80, less 107 = -0.20, floored at 0 (finding 2).
#ASSERT `What is my 2025 South Carolina tax before credits` 3560 EQUALS 0
-- $10,000: 3% x 10,000 = 300, less 107 = 193.
#ASSERT `What is my 2025 South Carolina tax before credits` 10000 EQUALS 193
-- $17,830: top bracket begins; 6% x 17,830 = 1,069.80, less 642 = 427.80.
#ASSERT `What is my 2025 South Carolina tax before credits` 17830 EQUALS 427.80
-- $50,000: 6% x 50,000 = 3,000, less 642 = 2,358.
#ASSERT `What is my 2025 South Carolina tax before credits` 50000 EQUALS 2358

-- ---------------------------------------------------------------------------------------------------------------------
-- South Carolina taxable income (ss 12-6-1110 to 12-6-1170).

-- A single resident with $80,000 federal taxable income who itemized $20,000 including $6,000 state income tax, against a
-- $15,000 standard deduction (HYPOTHETICAL): add back the lesser of 6,000 and 20,000 - 15,000 = 5,000 (s 12-6-1130(2));
-- add $1,000 of other states' bond interest (s 12-6-1120(1)); subtract a $500 state refund (s 12-6-1120(2)).
-- 80,000 + 5,000 + 1,000 - 500 = 85,500.
#ASSERT `What is my South Carolina taxable income` `resident for the whole year` 80000 1000 0 500 0 TRUE 6000 20000 15000 0 0 0 0 FALSE 0 FALSE FALSE 0 EQUALS `answered` 85500

-- Net capital gain: $20,000 federal taxable income including $10,000 net capital gain; 44% of 10,000 = 4,400 is deducted
-- (s 12-6-1150(A)): 15,600.
#ASSERT `What is my South Carolina taxable income` `resident for the whole year` 20000 0 0 0 0 FALSE 0 0 0 10000 0 0 0 FALSE 0 FALSE FALSE 0 EQUALS `answered` 15600

-- Head of household, $30,000 federal taxable income, two dependents, one under six, dependent exemption $4,930
-- (HYPOTHETICAL indexed figure): 2 x 4,930 + 1 x 4,930 = 14,790 deducted (ss 12-6-1140(13), 12-6-1160): 15,210.
#ASSERT `What is my South Carolina taxable income` `resident for the whole year` 30000 0 0 0 0 FALSE 0 0 0 0 2 1 4930 FALSE 0 FALSE FALSE 0 EQUALS `answered` 15210

-- Retired couple filing jointly, both 65 or older: $40,000 federal taxable income including $8,000 taxable Social
-- Security, my retirement income $20,000, my spouse's $5,000.
--   Social Security subtracted in full (s 12-6-1120(4)): 8,000.
--   Me: retirement deduction min(20,000, 10,000) = 10,000; age 65 deduction 15,000 - 10,000 = 5,000.
--   Spouse: retirement deduction min(5,000, 10,000) = 5,000; age 65 deduction 15,000 - 5,000 = 10,000.
--   40,000 - (8,000 + 10,000 + 5,000 + 5,000 + 10,000) = 2,000.
#ASSERT `What is my South Carolina taxable income` `resident for the whole year` 40000 0 0 0 8000 FALSE 0 0 0 0 0 0 0 TRUE 20000 TRUE TRUE 5000 EQUALS `answered` 2000

-- Under 65 with $2,000 of retirement income: deduction min(2,000, 3,000) = 2,000. $25,000 - 2,000 = 23,000.
#ASSERT `What is my South Carolina taxable income` `resident for the whole year` 25000 0 0 0 0 FALSE 0 0 0 0 0 0 0 FALSE 2000 FALSE FALSE 0 EQUALS `answered` 23000

-- Deductions larger than the income: floored at zero. $10,000 federal taxable income, 65, no retirement income: age 65
-- deduction 15,000; 10,000 - 15,000 < 0, so 0.
#ASSERT `What is my South Carolina taxable income` `resident for the whole year` 10000 0 0 0 0 FALSE 0 0 0 0 0 0 0 TRUE 0 FALSE FALSE 0 EQUALS `answered` 0

-- A nonresident or part-year resident: not covered.
#ASSERT `What is my South Carolina taxable income` `nonresident` 50000 0 0 0 0 FALSE 0 0 0 0 0 0 0 FALSE 0 FALSE FALSE 0 EQUALS `not covered` `a nonresident or part-year resident computes South Carolina taxable income under Article 13 (ss 12-6-1710, 12-6-1720), which is not encoded`
#ASSERT `What is my South Carolina taxable income` `part-year resident` 50000 0 0 0 0 FALSE 0 0 0 0 0 0 0 FALSE 0 FALSE FALSE 0 EQUALS `not covered` `a nonresident or part-year resident computes South Carolina taxable income under Article 13 (ss 12-6-1710, 12-6-1720), which is not encoded`

-- ---------------------------------------------------------------------------------------------------------------------
-- Credits.

-- s 12-6-3632: 125% of a $2,000 federal EITC = 2,500, nonrefundable: limited to a $349.30 tax.
#ASSERT `How much is my South Carolina EITC` `resident for the whole year` 2000 349.30 EQUALS 349.30
-- With $3,000 of tax: the whole 2,500.
#ASSERT `How much is my South Carolina EITC` `resident for the whole year` 2000 3000 EQUALS 2500
-- A part-year resident gets none (full-year residents only).
#ASSERT `How much is my South Carolina EITC` `part-year resident` 2000 3000 EQUALS 0

-- s 12-6-3330: joint, $60,000 and $30,000 qualified earned income: 0.7% x 30,000 = 210.
#ASSERT `How much is our two wage earner credit` `married filing jointly` 60000 30000 EQUALS 210
-- $70,000 and $55,000: the lesser is capped at 50,000: 0.7% x 50,000 = 350.
#ASSERT `How much is our two wage earner credit` `married filing jointly` 70000 55000 EQUALS 350
-- Only one spouse earns: none.
#ASSERT `How much is our two wage earner credit` `married filing jointly` 70000 0 EQUALS 0
-- Not a joint return: none.
#ASSERT `How much is our two wage earner credit` `married filing separately` 60000 30000 EQUALS 0

-- ---------------------------------------------------------------------------------------------------------------------
-- The whole computation for 2025.

-- Single, $50,000 federal taxable income, nothing else: SC taxable income 50,000; tax 2,358.
#ASSERT `How much South Carolina tax do I owe` 2025 single 50000 0 0 0 0 FALSE 0 0 0 0 0 0 0 FALSE 0 FALSE 0 0 0 0 0 EQUALS `answered` 2358

-- The head of household above: SC taxable income 15,210; tax 3% x 15,210 = 456.30 less 107 = 349.30; a $2,000 federal
-- EITC gives 2,500, nonrefundable: tax 0.
#ASSERT `How much South Carolina tax do I owe` 2025 `head of household` 30000 0 0 0 0 FALSE 0 0 0 0 2 1 4930 FALSE 0 FALSE 0 2000 0 0 0 EQUALS `answered` 0
-- The same family with no EITC but $3,000 of child care expenses counting under IRC s 21: 7% x 3,000 = 210;
-- 349.30 - 210 = 139.30.
#ASSERT `How much South Carolina tax do I owe` 2025 `head of household` 30000 0 0 0 0 FALSE 0 0 0 0 2 1 4930 FALSE 0 FALSE 0 0 0 0 3000 EQUALS `answered` 139.30

-- A couple filing jointly, $100,000 federal taxable income, qualified earned income $60,000 and $45,000:
-- tax 6% x 100,000 = 6,000 less 642 = 5,358; two wage earner credit 0.7% x 45,000 = 315; 5,358 - 315 = 5,043.
#ASSERT `How much South Carolina tax do I owe` 2025 `married filing jointly` 100000 0 0 0 0 FALSE 0 0 0 0 0 0 0 FALSE 0 FALSE 0 0 60000 45000 0 EQUALS `answered` 5043

-- 2024: the top rate depends on the phase-down, not encoded.
#ASSERT `How much South Carolina tax do I owe` 2024 single 50000 0 0 0 0 FALSE 0 0 0 0 0 0 0 FALSE 0 FALSE 0 0 0 0 0 EQUALS `not covered` `the rates for tax years 2022 to 2024 depend on the top-rate phase-down in s 12-6-510(B)(3), which is not encoded`
-- 2026: the exported question supplies no published schedule, so not covered.
#ASSERT `How much South Carolina tax do I owe` 2026 single 50000 0 0 0 0 FALSE 0 0 0 0 0 0 0 FALSE 0 FALSE 0 0 0 0 0 EQUALS `not covered` `the rate schedule for that tax year is not in the deposited text: give the department's published figures for the year`

-- 2026 through the core function with a HYPOTHETICAL published schedule (3,640 / 18,230 / 109 / 6% / 656):
-- 6% x 50,000 = 3,000 less 656 = 2,344.
`a hypothetical 2026 schedule` MEANS `Rate schedule` WITH
    `the 3 percent bracket starts at`        IS 3640
    `the top bracket starts at`              IS 18230
    `subtracted in the 3 percent bracket`    IS 109
    `the top rate`                           IS 6%
    `subtracted in the top bracket`          IS 656

`a single filer with 50,000` MEANS `My year` WITH
    `federal taxable income`                                       IS 50000
    `interest on other states' obligations excluded federally`     IS 0
    `interest on US obligations included federally`                IS 0
    `state income tax refund included federally`                   IS 0
    `social security and tier 1 railroad benefits taxed federally` IS 0
    `I itemized federally`                                         IS FALSE
    `state and local income taxes in my federal itemized deductions` IS 0
    `my federal itemized deductions`                               IS 0
    `the standard deduction I would have had`                      IS 0
    `net capital gain`                                             IS 0
    `dependents`                                                   IS 0
    `dependents under six`                                         IS 0
    `the dependent exemption amount for the year`                  IS 0
    `I reach 65 this year`                                         IS FALSE
    `my retirement income`                                         IS 0
    `my spouse is on this return`                                  IS FALSE
    `my spouse reaches 65 this year`                               IS FALSE
    `my spouse's retirement income`                                IS 0

#ASSERT `the South Carolina tax of a full-year resident` 2026 single `a single filer with 50,000` 0 0 0 0 (JUST `a hypothetical 2026 schedule`) EQUALS `answered` 2344

-- ---------------------------------------------------------------------------------------------------------------------
-- s 12-6-4910(1): must I file? Federal figures HYPOTHETICAL: exemption amount 0, standard deduction 15,000 single and
-- 30,000 joint.
-- Single resident, gross income 14,000: below 0 + 15,000: no.
#ASSERT (NOT (`Must I file a South Carolina return` `resident for the whole year` single 14000 FALSE FALSE 0 15000 0))
-- Exactly 15,000: "at least": yes.
#ASSERT `Must I file a South Carolina return` `resident for the whole year` single 15000 FALSE FALSE 0 15000 0
-- Joint, exactly 30,000: "more than" twice 0 plus 30,000: no.
#ASSERT (NOT (`Must I file a South Carolina return` `resident for the whole year` `married filing jointly` 30000 FALSE FALSE 0 30000 0))
-- Joint, 30,001: yes.
#ASSERT `Must I file a South Carolina return` `resident for the whole year` `married filing jointly` 30001 FALSE FALSE 0 30000 0
-- Single, 65, gross 30,000, standard deduction with the age addition 17,000 (HYPOTHETICAL), s 12-6-1170(B) 15,000:
-- threshold 32,000: no.
#ASSERT (NOT (`Must I file a South Carolina return` `resident for the whole year` single 30000 FALSE FALSE 0 17000 15000))
-- A dependent in (c) with gross income 500 over an exemption amount of 0: yes.
#ASSERT `Must I file a South Carolina return` `resident for the whole year` single 500 TRUE FALSE 0 15000 0
-- Married filing separately, spouse itemizes: standard deduction zero, (c)(iii): gross 1,000 over 0: yes.
#ASSERT `Must I file a South Carolina return` `resident for the whole year` `married filing separately` 1000 FALSE TRUE 0 15000 0
-- Married filing separately, spouse does not itemize: 1,000 below 15,000: no.
#ASSERT (NOT (`Must I file a South Carolina return` `resident for the whole year` `married filing separately` 1000 FALSE FALSE 0 15000 0))
-- A nonresident with South Carolina gross income of 100 over a personal exemption of 0: yes (s 12-6-4910(1)(d)).
#ASSERT `Must I file a South Carolina return` `nonresident` single 100 FALSE FALSE 0 15000 0

-- ---------------------------------------------------------------------------------------------------------------------
-- ss 12-6-4970, 12-6-4980, 12-6-4990: when.
-- Calendar year 2025: the fifteenth day of the fourth month after it is 15 April 2026.
#ASSERT `When is my South Carolina return due` (Date 31 12 2025) EQUALS Date 15 4 2026
-- Fiscal year ending 30 June 2026: 15 October 2026.
#ASSERT `When is my South Carolina return due` (Date 30 6 2026) EQUALS Date 15 10 2026
-- An extension "not to exceed six months": 15 October 2026 for calendar 2025.
#ASSERT `When is my extended return due` (Date 31 12 2025) EQUALS Date 15 10 2026
-- Payment is still due 15 April 2026.
#ASSERT `When must I pay even with an extension` (Date 31 12 2025) EQUALS Date 15 4 2026

-- The duties, counted in days after 31 December 2025: 15 April 2026 is day 105; 15 October 2026 is day 288.
-- Filed on day 100 (10 April): fulfilled.
#ASSERT EVALTRACE (`my duty to file` (Date 31 12 2025) FALSE) 0 (LIST (EVENT `the taxpayer` `file the South Carolina return` 100)) EQUALS FULFILLED
-- With an extension, filed on day 200 (19 July): fulfilled.
#ASSERT EVALTRACE (`my duty to file` (Date 31 12 2025) TRUE) 0 (LIST (EVENT `the taxpayer` `file the South Carolina return` 200)) EQUALS FULFILLED
-- Paid on day 105: fulfilled.
#ASSERT EVALTRACE (`my duty to pay` (Date 31 12 2025)) 0 (LIST (EVENT `the taxpayer` `pay the tax due` 105)) EQUALS FULFILLED

-- Without an extension, filed on day 200.
#TRACE (`my duty to file` (Date 31 12 2025) FALSE) AT 0 WITH
    PARTY `the taxpayer` DOES `file the South Carolina return` AT 200
-- expect: BREACH BY the taxpayer, "the return was not filed on or before the fifteenth day of the fourth month after the taxable year (s 12-6-4970(A))"

-- With an extension, filed on day 300 (after 15 October).
#TRACE (`my duty to file` (Date 31 12 2025) TRUE) AT 0 WITH
    PARTY `the taxpayer` DOES `file the South Carolina return` AT 300
-- expect: BREACH BY the taxpayer, "the return was not filed by the extended due date (s 12-6-4980(A))"

-- Paid on day 200 even though an extension to file was allowed.
#TRACE (`my duty to pay` (Date 31 12 2025)) AT 0 WITH
    PARTY `the taxpayer` DOES `pay the tax due` AT 200
-- expect: BREACH BY the taxpayer, "the tax due was not paid by the original due date; an extension does not extend the time to pay (ss 12-6-4980(B), 12-6-4990)"

-- ---------------------------------------------------------------------------------------------------------------------
-- s 12-6-5000: joint or separate.
#ASSERT `Joint or separate South Carolina return` TRUE TRUE FALSE EQUALS `a joint South Carolina return, because our federal taxable income is determined on a joint federal return (s 12-6-5000(B), (C)(1))`
#ASSERT `Joint or separate South Carolina return` TRUE FALSE FALSE EQUALS `separate South Carolina returns, because our federal taxable income is determined on separate federal returns (s 12-6-5000(A))`
#ASSERT `Joint or separate South Carolina return` TRUE TRUE TRUE EQUALS `a separate South Carolina return, because the nonresident spouse's state does not allow a South Carolina resident a joint return (s 12-6-5000(C)(2))`
#ASSERT `Joint or separate South Carolina return` FALSE FALSE FALSE EQUALS `separate returns, unless we both elect a joint South Carolina return (s 12-6-5000(D))`
