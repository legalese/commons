IMPORT prelude
IMPORT daydate
IMPORT `ga-ui-claimant`

-- Georgia unemployment insurance, Rules 300-2-4-.02, .03, .08 -- worked cases, from the claimant's seat.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Expected values were written by hand
-- from the deposited text (gac-300-2-4.txt), never copied from the encoding's output.

-- ---------------------------------------------------------------------------------------------------------------------
-- Rule .02: registering for work. Argument order: definite recall date, weeks to recall, partial claimant, approved
-- training, union hiring hall, labor dispute, locked out and directed.
-- Laid off with no recall date: must register.
#ASSERT `Must I register for work` FALSE 0 FALSE FALSE FALSE FALSE FALSE EQUALS TRUE
-- Laid off with recall in 5 weeks: (4)(a), need not.
#ASSERT `Must I register for work` TRUE 5 FALSE FALSE FALSE FALSE FALSE EQUALS FALSE
-- Recall in 8 weeks is beyond six: must register.
#ASSERT `Must I register for work` TRUE 8 FALSE FALSE FALSE FALSE FALSE EQUALS TRUE
-- In approved training: (4)(c).
#ASSERT `Must I register for work` FALSE 0 FALSE TRUE FALSE FALSE FALSE EQUALS FALSE
-- On strike: (4)(e), need not; locked out and directed to register: must.
#ASSERT `Must I register for work` FALSE 0 FALSE FALSE FALSE TRUE FALSE EQUALS FALSE
#ASSERT `Must I register for work` FALSE 0 FALSE FALSE FALSE TRUE TRUE EQUALS TRUE
-- The duty: registered on day 5 of the 10 days the Department gave.
#ASSERT EVALTRACE (`Rule 300-2-4-.02(2) -- I must register for work within the time the Department directs` 10) 0 (LIST (EVENT `the claimant` `register for work with WorkSource Georgia` 5)) EQUALS FULFILLED
-- expect: BREACH by the claimant (not registered by day 10): ineligible for the weeks the requirement is unmet.
#TRACE `Rule 300-2-4-.02(2) -- I must register for work within the time the Department directs` 10 AT 0 WITH
    (WAITUNTIL 11)

-- ---------------------------------------------------------------------------------------------------------------------
-- Rule .03(1)(a): asking to be paid. Claim filed Monday 2 November 2026; the benefit week ends Saturday 7 November 2026.
#ASSERT `Can I still request payment for this week` (Date 7 11 2026) (Date 2 11 2026) (Date 6 11 2026) EQUALS `not yet: the benefit week has not ended (Rule .03(1)(a)2.(i))`
#ASSERT `Can I still request payment for this week` (Date 7 11 2026) (Date 2 11 2026) (Date 7 11 2026) EQUALS `not yet: the benefit week has not ended (Rule .03(1)(a)2.(i))`
#ASSERT `Can I still request payment for this week` (Date 7 11 2026) (Date 2 11 2026) (Date 8 11 2026) EQUALS `yes: the week has ended and it is no later than two weeks after its end (Rule .03(1)(a)2.(ii))`
-- Two weeks after 7 November is 21 November: still in time on the 21st, too late on the 22nd.
#ASSERT `Can I still request payment for this week` (Date 7 11 2026) (Date 2 11 2026) (Date 21 11 2026) EQUALS `yes: the week has ended and it is no later than two weeks after its end (Rule .03(1)(a)2.(ii))`
#ASSERT `Can I still request payment for this week` (Date 7 11 2026) (Date 2 11 2026) (Date 22 11 2026) EQUALS `no: it is more than two weeks after the end of the week, so I am considered ineligible for that week (Rule .03(1)(a)2.(iii))`
-- The week ending 31 October 2026 ended before the claim was filed.
#ASSERT `Can I still request payment for this week` (Date 31 10 2026) (Date 2 11 2026) (Date 3 11 2026) EQUALS `no: the week ended before the date I filed my initial claim (Rule .03(1)(a)2.(ii))`
-- The duty, counted from the end of the week.
#ASSERT EVALTRACE `Rule 300-2-4-.03(1)(a) -- I must request payment for a week within two weeks after it ends` 0 (LIST (EVENT `the claimant` `request payment for the benefit week` 3)) EQUALS FULFILLED
-- expect: BREACH by the claimant (no request by day 14): ineligible for that week.
#TRACE `Rule 300-2-4-.03(1)(a) -- I must request payment for a week within two weeks after it ends` AT 0 WITH
    (WAITUNTIL 15)
-- 2.(iv): three or more consecutive weeks.
#ASSERT `May I have to reopen my claim` 2 EQUALS FALSE
#ASSERT `May I have to reopen my claim` 3 EQUALS TRUE

-- Rule .03(1)(b): work search.
#ASSERT `Do my benefits stay payable on my work search` TRUE TRUE EQUALS TRUE
#ASSERT `Do my benefits stay payable on my work search` TRUE FALSE EQUALS FALSE
#ASSERT `Do my benefits stay payable on my work search` FALSE TRUE EQUALS FALSE

-- ---------------------------------------------------------------------------------------------------------------------
-- Rule .03(3): reporting late. Directed to report on Tuesday 10 November 2026.
-- My father died on 7 November: the requirement is waived from the 7th to the 11th.
#ASSERT `Will my late report be accepted` (Date 10 11 2026) (Date 13 11 2026) `a member of my immediate family died` (Date 7 11 2026) EQUALS `the reporting requirement is waived: the reporting date fell on the day of the death or the four calendar days after it (Rule .03(3)(b)(i))`
-- My father died on 1 November: the waiver ran out on the 5th; a death is still good cause, and I reported on the 12th, in the two days.
#ASSERT `Will my late report be accepted` (Date 10 11 2026) (Date 12 11 2026) `a member of my immediate family died` (Date 1 11 2026) EQUALS `the department may permit it: a listed good cause and I reported within the two days after the date I was directed to report (Rule .03(3))`
-- Flu, having called the department beforehand; reported on the 12th: may be permitted. On the 13th: too late.
#ASSERT `Will my late report be accepted` (Date 10 11 2026) (Date 12 11 2026) `a temporary illness or disability of mine or a dependent family member prevented me, and I tried diligently to tell the department before the reporting date` (Date 1 1 2000) EQUALS `the department may permit it: a listed good cause and I reported within the two days after the date I was directed to report (Rule .03(3))`
#ASSERT `Will my late report be accepted` (Date 10 11 2026) (Date 13 11 2026) `a temporary illness or disability of mine or a dependent family member prevented me, and I tried diligently to tell the department before the reporting date` (Date 1 1 2000) EQUALS `no: I reported more than two days after the date I was directed to report`
-- My car broke down: not on the list ("such as"), so it turns on the department's finding.
#ASSERT `Will my late report be accepted` (Date 10 11 2026) (Date 11 11 2026) `another circumstance beyond my control` (Date 1 1 2000) EQUALS `the department may permit it if it finds the circumstance beyond my control is good cause, since I reported within the two days after the date I was directed to report (Rule .03(3))`
-- I forgot.
#ASSERT `Will my late report be accepted` (Date 10 11 2026) (Date 11 11 2026) `no reason beyond my control` (Date 1 1 2000) EQUALS `no: no circumstance beyond my control prevented me from reporting`

-- ---------------------------------------------------------------------------------------------------------------------
-- Rule .08: an overpayment. Notice of Overpayment released 2 March 2027.
-- Fifteen calendar days after 2 March is 17 March.
#ASSERT `Can I apply for a waiver of my overpayment` (Date 2 3 2027) (Date 17 3 2027) FALSE FALSE EQUALS `yes: I am within the fifteen calendar days after the Notice of Overpayment was released (Rule .08(3)(b)1)`
#ASSERT `Can I apply for a waiver of my overpayment` (Date 2 3 2027) (Date 18 3 2027) FALSE FALSE EQUALS `only if the department accepts that extenuating circumstances beyond my control prevented a timely application (Rule .08(3)(b)1)`
#ASSERT `Can I apply for a waiver of my overpayment` (Date 2 3 2027) (Date 5 3 2027) TRUE FALSE EQUALS `no: the department determined the overpayment was the result of fraud attributable to me (Rule .08(3)(a)1)`
#ASSERT `Can I apply for a waiver of my overpayment` (Date 2 3 2027) (Date 5 3 2027) FALSE TRUE EQUALS `not covered: the overpayment is for claim weeks ending 8 February 2020 to 26 June 2021, where the Covid-19 special rule of Rule .08(3)(b)2 applies`
-- Approval: without fault, and both limbs of "contrary to equity and good conscience".
#ASSERT `Can my overpayment be waived` FALSE TRUE TRUE FALSE EQUALS TRUE
#ASSERT `Can my overpayment be waived` TRUE TRUE TRUE FALSE EQUALS FALSE
#ASSERT `Can my overpayment be waived` FALSE TRUE FALSE FALSE EQUALS FALSE
#ASSERT `Can my overpayment be waived` FALSE TRUE TRUE TRUE EQUALS FALSE
#ASSERT `Is collection of my overpayment suspended` TRUE EQUALS TRUE
-- The waiver decision delivered on 20 April 2027: appeal by 5 May 2027.
#ASSERT `By when must I appeal the waiver decision` (Date 20 4 2027) EQUALS Date 5 5 2027
-- The sequence. I apply on day 10; the Commissioner approves and tells me: done, nothing to repay.
#ASSERT EVALTRACE (`Rule 300-2-4-.08(1), (3)(b), (g) -- apply for a waiver within 15 days or repay; if refused, appeal within 15 days or repay` TRUE) 0 (LIST (EVENT `the claimant` `file an application for waiver of the overpayment` 10), (EVENT `the Commissioner` `notify me in writing whether the waiver is approved or denied` 40)) EQUALS FULFILLED
-- Refused; I appeal on day 50, ten days after the notice: done for now.
#ASSERT EVALTRACE (`Rule 300-2-4-.08(1), (3)(b), (g) -- apply for a waiver within 15 days or repay; if refused, appeal within 15 days or repay` FALSE) 0 (LIST (EVENT `the claimant` `file an application for waiver of the overpayment` 10), (EVENT `the Commissioner` `notify me in writing whether the waiver is approved or denied` 40), (EVENT `the claimant` `appeal the waiver decision` 50)) EQUALS FULFILLED
-- I never apply and repay on day 60: done.
#ASSERT EVALTRACE (`Rule 300-2-4-.08(1), (3)(b), (g) -- apply for a waiver within 15 days or repay; if refused, appeal within 15 days or repay` FALSE) 0 (LIST (WAITUNTIL 16), (EVENT `the claimant` `repay the overpayment` 60)) EQUALS FULFILLED
-- expect: the repayment still owed (residual PARTY `the claimant` MUST `repay the overpayment`), no breach: I applied on
-- day 20, outside the 15 days, and that application does not count.
#TRACE `Rule 300-2-4-.08(1), (3)(b), (g) -- apply for a waiver within 15 days or repay; if refused, appeal within 15 days or repay` TRUE AT 0 WITH
    PARTY `the claimant` DOES `file an application for waiver of the overpayment` AT 20
