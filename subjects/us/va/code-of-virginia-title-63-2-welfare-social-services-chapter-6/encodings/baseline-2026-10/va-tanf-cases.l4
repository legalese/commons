IMPORT prelude
IMPORT `va-tanf`

-- Virginia TANF -- worked cases from the caretaker's seat. Expected values were worked by hand from the deposited text
-- (Va. Code ch. 6 of Title 63.2; 22VAC40-295-10, -50), never copied from the encoding's output. The standard of assistance
-- ($500) and the SNAP standard deduction ($204) are HYPOTHETICAL figures (neither is in the deposited text).

-- s 63.2-602 A: the child. Arguments: age, full-time student, resident, lives with listed relative, school attendance.
#ASSERT `Does my child meet the TANF conditions` 10 FALSE TRUE TRUE TRUE
-- 18 and a full-time secondary student: under 19; the attendance condition applies only under 18.
#ASSERT `Does my child meet the TANF conditions` 18 TRUE TRUE TRUE FALSE
#ASSERT NOT (`Does my child meet the TANF conditions` 19 TRUE TRUE TRUE TRUE)
#ASSERT NOT (`Does my child meet the TANF conditions` 18 FALSE TRUE TRUE TRUE)
#ASSERT NOT (`Does my child meet the TANF conditions` 10 FALSE TRUE TRUE FALSE)
#ASSERT NOT (`Does my child meet the TANF conditions` 10 FALSE TRUE FALSE TRUE)
#ASSERT NOT (`Does my child meet the TANF conditions` 10 FALSE FALSE TRUE TRUE)

-- s 63.2-602 B: the applicant's conditions.
#ASSERT `Have I met the applicant requirements` TRUE TRUE TRUE TRUE
#ASSERT NOT (`Have I met the applicant requirements` TRUE FALSE TRUE TRUE)

-- 22VAC40-295-50: income and payment. Arguments: standard, earned, SNAP deduction, support, other unearned, unverified
-- children, reason identified.
-- No income: the whole standard, $500.
#ASSERT `What is our Virginia TANF payment` 500 0 204 0 0 0 FALSE EQUALS `a monthly payment of` 500
-- Earnings $400, support $100: (400 - 204) x 80% = 156.80; support 100 - 50 = 50; net 206.80; payment 293.20.
#ASSERT `What is our Virginia TANF payment` 500 400 204 100 0 0 FALSE EQUALS `a monthly payment of` 293.2
-- The same with two children's immunizations unverified, reason identified and barriers removed: less 50 + 25 = 218.20.
#ASSERT `What is our Virginia TANF payment` 500 400 204 100 0 2 TRUE EQUALS `a monthly payment of` 218.2
-- Reason not yet identified: no reduction (s 63.2-603).
#ASSERT `What is our Virginia TANF payment` 500 400 204 100 0 2 FALSE EQUALS `a monthly payment of` 293.2
-- Earnings $1,000, support $100: 796 x 80% = 636.80 + 50 = 686.80, not less than 500: not income eligible.
#ASSERT `What is our Virginia TANF payment` 500 1000 204 100 0 0 FALSE EQUALS `not income eligible: net income is not less than the standard of assistance (22VAC40-295-50 A)`
-- Net income exactly equal to the standard: not "less than": not eligible.
#ASSERT `What is our Virginia TANF payment` 500 0 204 0 500 0 FALSE EQUALS `not income eligible: net income is not less than the standard of assistance (22VAC40-295-50 A)`
-- Support of $40: all within the $50 disregard: payment 500.
#ASSERT `What is our Virginia TANF payment` 500 0 204 40 0 0 FALSE EQUALS `a monthly payment of` 500
-- Earnings below the SNAP deduction: nothing counted.
#ASSERT `What is our Virginia TANF payment` 500 150 204 0 0 0 FALSE EQUALS `a monthly payment of` 500

-- s 63.2-617 A: diversionary assistance: 120 days (four months) of the payment or $1,500, whichever is greater.
#ASSERT `At most how much diversionary assistance can I get` 300 EQUALS 1500
#ASSERT `At most how much diversionary assistance can I get` 450 EQUALS 1800
-- 120 days granted waives 120 x 1.33 = 159.6 days.
#ASSERT `How many days of TANF eligibility would I waive` 120 EQUALS 159.6

-- s 63.2-609: VIEW exemptions. Arguments: age, school, postsecondary, medical, SSDI/SSI, caregiver, infant, infant months.
#ASSERT `Am I exempt from VIEW` 15 FALSE FALSE FALSE FALSE FALSE FALSE 0
#ASSERT `Am I exempt from VIEW` 17 TRUE FALSE FALSE FALSE FALSE FALSE 0
#ASSERT NOT (`Am I exempt from VIEW` 20 TRUE FALSE FALSE FALSE FALSE FALSE 0)
#ASSERT `Am I exempt from VIEW` 60 FALSE FALSE FALSE FALSE FALSE FALSE 0
#ASSERT `Am I exempt from VIEW` 30 FALSE FALSE FALSE TRUE FALSE FALSE 0
#ASSERT `Am I exempt from VIEW` 30 FALSE FALSE FALSE FALSE FALSE TRUE 11
#ASSERT NOT (`Am I exempt from VIEW` 30 FALSE FALSE FALSE FALSE FALSE TRUE 12)
#ASSERT NOT (`Am I exempt from VIEW` 30 FALSE FALSE FALSE FALSE FALSE FALSE 0)

-- s 63.2-612: the 24 months.
#ASSERT `Can we still receive TANF under the 24-month limit` TRUE 40 FALSE FALSE 0 EQUALS `exempt from VIEW: the 24-month limit does not apply to me (s 63.2-612 "Unless otherwise exempt")`
#ASSERT `Can we still receive TANF under the 24-month limit` FALSE 10 FALSE FALSE 0 EQUALS `within the 24 months`
#ASSERT `Can we still receive TANF under the 24-month limit` FALSE 24 TRUE FALSE 0 EQUALS `past 24 months, but a hardship exception applies (s 63.2-613)`
#ASSERT `Can we still receive TANF under the 24-month limit` FALSE 24 FALSE TRUE 0 EQUALS `a relative with whom a child was placed after a child protective services report: eligible at once (s 63.2-612)`
#ASSERT `Can we still receive TANF under the 24-month limit` FALSE 24 FALSE FALSE 10 EQUALS `past 24 months: not eligible until 24 further months have passed`
#ASSERT `Can we still receive TANF under the 24-month limit` FALSE 24 FALSE FALSE 24 EQUALS `eligible again after the 24-month period of ineligibility`

-- s 63.2-618: payments continue if the hearing request comes before the effective date.
#ASSERT `Does my TANF continue while I appeal` 5 10
#ASSERT NOT (`Does my TANF continue while I appeal` 10 10)

-- s 63.2-612: notice 60 days before termination. Termination 90 days away: notice due by day 30.
-- expect: FULFILLED
#TRACE `the notice I must be given before TANF ends` 90 AT 0 WITH
    PARTY `the local department` DOES `give written notice that TANF is scheduled to end` AT 20
-- expect: BREACH by the local department (no notice by day 30)
#TRACE `the notice I must be given before TANF ends` 90 AT 0 WITH
    (WAITUNTIL 31)

-- s 63.2-618: the appeal.
-- expect: FULFILLED
#TRACE `my appeal of a change in benefits` 10 AT 0 WITH
    PARTY `the caretaker` DOES `request a hearing` AT 5
    PARTY `the local department` DOES `continue direct payment of TANF pending the appeal` AT 6
-- No hearing requested: no duty on anyone. expect: FULFILLED
#TRACE `my appeal of a change in benefits` 10 AT 0 WITH
    (WAITUNTIL 11)
-- expect: BREACH by the local department (payment stopped despite a timely request)
#TRACE `my appeal of a change in benefits` 10 AT 0 WITH
    PARTY `the caretaker` DOES `request a hearing` AT 5
    (WAITUNTIL 40)
