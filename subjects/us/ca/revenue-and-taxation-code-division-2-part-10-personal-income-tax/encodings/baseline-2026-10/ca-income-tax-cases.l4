IMPORT prelude
IMPORT `ca-income-tax`

-- Rev. & Tax. Code Part 10 -- worked cases for 2025, from the seat of the individual taxpayer.
-- Every expected value was worked out by hand from the deposited text and the FTB's 2025 figures (the rate schedules as
-- transcribed in ftb-2025-540-tax-rate-schedules.formulas.md), never copied from the encoding's output.
-- The taxpayers are HYPOTHETICAL. In each, California AGI equals federal AGI unless stated.

-- -------------------------------------------------------------------------------------------------------------------
-- ss 17014, 17016: resident.
#ASSERT `Am I a California resident` TRUE FALSE FALSE FALSE 0 FALSE
#ASSERT `Am I a California resident` FALSE TRUE FALSE FALSE 0 FALSE
-- away 546 days on a work contract: outside for other than a temporary purpose; unless intangible income is over $200,000.
#ASSERT (NOT (`Am I a California resident` FALSE TRUE TRUE FALSE 0 FALSE))
#ASSERT `Am I a California resident` FALSE TRUE TRUE TRUE 0 FALSE
-- ten months: presumed; presumption overcome: not resident.
#ASSERT `Am I a California resident` FALSE FALSE FALSE FALSE 10 FALSE
#ASSERT (NOT (`Am I a California resident` FALSE FALSE FALSE FALSE 10 TRUE))

-- -------------------------------------------------------------------------------------------------------------------
-- ss 17054, 17054.1: exemption credits.
-- single, $60,000: one personal credit, $153.
#ASSERT `What are my 2025 exemption credits` `single` 60000 FALSE 0 0 0 EQUALS 153
-- joint, two children: 2 x $153 + 2 x $475 = $1,256.
#ASSERT `What are my 2025 exemption credits` `married or RDP filing jointly` 120000 FALSE 0 0 2 EQUALS 1256
-- someone can claim me: no personal credit.
#ASSERT `What are my 2025 exemption credits` `single` 10000 TRUE 0 0 0 EQUALS 0
-- single at exactly the $252,203 threshold: no reduction.
#ASSERT `What are my 2025 exemption credits` `single` 252203 FALSE 0 0 0 EQUALS 153
-- single at $260,000, one dependent: $7,797 over is 4 steps of $2,500 "or fraction": $24 off each credit:
-- $129 + $451 = $580.
#ASSERT `What are my 2025 exemption credits` `single` 260000 FALSE 0 0 1 EQUALS 580
-- separate at $260,000: 7 steps of $1,250: $42 off: $111.
#ASSERT `What are my 2025 exemption credits` `married or RDP filing separately` 260000 FALSE 0 0 0 EQUALS 111
-- joint at $510,000: $5,589 over $504,411 is 3 steps: $18 off each of the two personal credits ($12 a step for the joint
-- credit): 2 x $135 = $270.
#ASSERT `What are my 2025 exemption credits` `married or RDP filing jointly` 510000 FALSE 0 0 0 EQUALS 270
-- single, 66 and blind: 3 x $153 = $459.
#ASSERT `What are my 2025 exemption credits` `single` 40000 FALSE 1 1 0 EQUALS 459

-- s 17053.5: renter's credit.
#ASSERT `What is my 2025 renter's credit` `single` 53994 TRUE EQUALS 60
#ASSERT `What is my 2025 renter's credit` `single` 53995 TRUE EQUALS 0
#ASSERT `What is my 2025 renter's credit` `married or RDP filing jointly` 107988 TRUE EQUALS 120
#ASSERT `What is my 2025 renter's credit` `head of household` 40000 TRUE EQUALS 120
#ASSERT `What is my 2025 renter's credit` `married or RDP filing separately` 40000 TRUE EQUALS 60
#ASSERT `What is my 2025 renter's credit` `single` 30000 FALSE EQUALS 0

-- -------------------------------------------------------------------------------------------------------------------
-- How much do I owe? Arguments: year, resident, status, federal AGI, California AGI, standard deduction?, itemized,
-- claimable as a dependent, blind, 65+, dependents, qualified renter.

-- 1. Single, $60,000. Taxable $54,294. Schedule X: $1,022.01 + 6% of $12,842 ($770.52) = $1,792.53. Less $153: $1,639.53.
#ASSERT `How much California income tax do I owe for 2025` 2025 TRUE `single` 60000 60000 TRUE 0 FALSE 0 0 0 FALSE EQUALS `answered` 1639.53

-- 2. Joint, $120,000, two children, renting (over the $107,988 limit). Taxable $108,588. Schedule Y: $2,044.02 + 6% of
--    $25,684 ($1,541.04) = $3,585.06. Less $1,256: $2,329.06.
#ASSERT `How much California income tax do I owe for 2025` 2025 TRUE `married or RDP filing jointly` 120000 120000 TRUE 0 FALSE 0 0 2 TRUE EQUALS `answered` 2329.06

-- 3. Head of household, $40,000, one child, renting. Taxable $28,588. Schedule Z: $221.73 + 2% of $6,415 ($128.30) =
--    $350.03. Credits $153 + $475 + $120 = $748, more than the tax: nil.
#ASSERT `How much California income tax do I owe for 2025` 2025 TRUE `head of household` 40000 40000 TRUE 0 FALSE 0 0 1 TRUE EQUALS `answered` 0

-- 4. Single, 66, renting, $30,000. Taxable $24,294. Schedule X: $110.79 + 2% of $13,215 ($264.30) = $375.09. Credits
--    $153 + $153 + $60 = $366: $9.09.
#ASSERT `How much California income tax do I owe for 2025` 2025 TRUE `single` 30000 30000 TRUE 0 FALSE 0 1 0 TRUE EQUALS `answered` 9.09

-- 5. Single, $1,200,000, itemizing $50,000. Taxable $1,150,000. Schedule X: $72,219.84 + 12.3% of $407,047
--    ($50,066.781) = $122,286.621. The exemption credit is phased out entirely (380 steps x $6). Plus 1% of the $150,000
--    over $1,000,000 ($1,500): $123,786.621.
#ASSERT `How much California income tax do I owe for 2025` 2025 TRUE `single` 1200000 1200000 FALSE 50000 FALSE 0 0 0 FALSE EQUALS `answered` 123786.621

-- 6. California AGI different from federal: single, federal AGI $70,000 including $10,000 of Social Security, which
--    California excludes (s 17087): California AGI $60,000, as in case 1: $1,639.53.
#ASSERT `How much California income tax do I owe for 2025` 2025 TRUE `single` 70000 60000 TRUE 0 FALSE 0 0 0 FALSE EQUALS `answered` 1639.53

-- 7. Outside the encoding.
#ASSERT `How much California income tax do I owe for 2025` 2026 TRUE `single` 60000 60000 TRUE 0 FALSE 0 0 0 FALSE EQUALS `not covered` `this encoding has the Franchise Tax Board's figures for the 2025 taxable year only`
#ASSERT `How much California income tax do I owe for 2025` 2025 FALSE `single` 60000 60000 TRUE 0 FALSE 0 0 0 FALSE EQUALS `not covered` `the tax of a part-year resident or nonresident is not encoded`

-- -------------------------------------------------------------------------------------------------------------------
-- The election and the duty, traced.
#ASSERT EVALTRACE (`the standard deduction election` `the taxpayer`) 0 (LIST EVENT `the taxpayer` `elect the standard deduction` 100) EQUALS FULFILLED
#ASSERT EVALTRACE (`the duty to identify dependents` `the taxpayer`) 0 (LIST EVENT `the taxpayer` `include each dependent's identifying number or the information the Board prescribes` 100) EQUALS FULFILLED
