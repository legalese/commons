#ASSERT `Gov. Code § 7.6(a) lets the officer designate` TRUE TRUE TRUE TRUE
#ASSERT NOT (`Gov. Code § 7.6(a) lets the officer designate` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`Gov. Code § 7.6(a) lets the officer designate` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`Gov. Code § 7.6(a) lets the officer designate` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`Gov. Code § 7.6(a) lets the officer designate` TRUE TRUE TRUE FALSE)

§ `Gov. Code § 7.6(b): the Lieutenant Governor`

-- A person in the office holding a position specified in (c) or in (f).
#ASSERT `Gov. Code § 7.6(b) lets the Lieutenant Governor designate` TRUE TRUE FALSE
#ASSERT `Gov. Code § 7.6(b) lets the Lieutenant Governor designate` TRUE FALSE TRUE
#ASSERT `Gov. Code § 7.6(b) lets the Lieutenant Governor designate` TRUE TRUE TRUE
#ASSERT NOT (`Gov. Code § 7.6(b) lets the Lieutenant Governor designate` TRUE FALSE FALSE)
#ASSERT NOT (`Gov. Code § 7.6(b) lets the Lieutenant Governor designate` FALSE TRUE TRUE)

§ `Gov. Code § 7.6(b), § 7.6(e), § 7.9(c): where a deputy may not be appointed`

-- The Lieutenant Governor: the Senate, the Regents and the Trustees.
#ASSERT `a deputy may not be appointed to act for the officer at meetings of` `the Lieutenant Governor` `the Senate`
#ASSERT `a deputy may not be appointed to act for the officer at meetings of` `the Lieutenant Governor` `the Regents of the University of California`
#ASSERT `a deputy may not be appointed to act for the officer at meetings of` `the Lieutenant Governor` `the Trustees of the California State University`
#ASSERT NOT (`a deputy may not be appointed to act for the officer at meetings of` `the Lieutenant Governor` `the State Board of Education`)
#ASSERT NOT (`a deputy may not be appointed to act for the officer at meetings of` `the Lieutenant Governor` `the State Lands Commission`)
#ASSERT NOT (`a deputy may not be appointed to act for the officer at meetings of` `the Lieutenant Governor` `the State Allocation Board`)
-- The Superintendent of Public Instruction: the State Board of Education, the Regents and the Trustees.
#ASSERT NOT (`a deputy may not be appointed to act for the officer at meetings of` `the Superintendent of Public Instruction` `the Senate`)
#ASSERT `a deputy may not be appointed to act for the officer at meetings of` `the Superintendent of Public Instruction` `the Regents of the University of California`
#ASSERT `a deputy may not be appointed to act for the officer at meetings of` `the Superintendent of Public Instruction` `the Trustees of the California State University`
#ASSERT `a deputy may not be appointed to act for the officer at meetings of` `the Superintendent of Public Instruction` `the State Board of Education`
#ASSERT NOT (`a deputy may not be appointed to act for the officer at meetings of` `the Superintendent of Public Instruction` `the State Lands Commission`)
#ASSERT NOT (`a deputy may not be appointed to act for the officer at meetings of` `the Superintendent of Public Instruction` `the State Allocation Board`)
-- No other office the text names is forbidden by these sentences.
#ASSERT NOT (`a deputy may not be appointed to act for the officer at meetings of` `the Attorney General` `the Regents of the University of California`)
#ASSERT NOT (`a deputy may not be appointed to act for the officer at meetings of` `the Controller` `the Regents of the University of California`)
#ASSERT NOT (`a deputy may not be appointed to act for the officer at meetings of` `the Treasurer` `the Regents of the University of California`)
#ASSERT NOT (`a deputy may not be appointed to act for the officer at meetings of` `the Director of Finance` `the Regents of the University of California`)
#ASSERT NOT (`a deputy may not be appointed to act for the officer at meetings of` `the Chief Justice of the California Supreme Court` `the Regents of the University of California`)
#ASSERT NOT (`a deputy may not be appointed to act for the officer at meetings of` `an office the text does not name` `the Regents of the University of California`)

