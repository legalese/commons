IMPORT prelude
IMPORT `ca-unemployment`

-- Unemployment Insurance Code, Chapter 5 -- worked cases, from the seat of the unemployed worker.
-- Every expected value was worked out by hand from the deposited text, never copied from the encoding's output.
-- The workers are HYPOTHETICAL. Amounts are US dollars; time in the traces is in days.

-- -------------------------------------------------------------------------------------------------------------------
-- s 1280(c): the weekly benefit amount.
#ASSERT `What is my weekly benefit amount` 2026 899 EQUALS `answered` 0
#ASSERT `What is my weekly benefit amount` 2026 900 EQUALS `answered` 40
#ASSERT `What is my weekly benefit amount` 2026 948.99 EQUALS `answered` 40
#ASSERT `What is my weekly benefit amount` 2026 949 EQUALS `answered` 41
-- $1,500 falls in the $1,495.00-$1,520.99 row: $60.
#ASSERT `What is my weekly benefit amount` 2026 1500 EQUALS `answered` 60
#ASSERT `What is my weekly benefit amount` 2026 1832.99 EQUALS `answered` 70
-- $1,833: 50% is $916.50, / 13 = $70.50, up to $71.
#ASSERT `What is my weekly benefit amount` 2026 1833 EQUALS `answered` 71
-- $5,000: $2,500 / 13 = $192.31, up to $193.
#ASSERT `What is my weekly benefit amount` 2026 5000 EQUALS `answered` 193
-- $11,700: $5,850 / 13 = exactly $450. $20,000: capped at $450.
#ASSERT `What is my weekly benefit amount` 2026 11700 EQUALS `answered` 450
#ASSERT `What is my weekly benefit amount` 2026 20000 EQUALS `answered` 450
#ASSERT `What is my weekly benefit amount` 2004 5000 EQUALS `not covered` `this encoding computes the weekly benefit amount for new claims effective on or after 1 January 2005 only`

-- s 1281(a): the base-period test.
#ASSERT `Can I establish a claim` 1300 1300
#ASSERT `Can I establish a claim` 1000 1250
#ASSERT (NOT (`Can I establish a claim` 1000 1249))
#ASSERT (NOT (`Can I establish a claim` 899 5000))

-- s 1281(b), (c): the maximum award.
-- $193 a week, $20,000 base: 26 x $193 = $5,018 against $10,000: $5,018.
#ASSERT `What is the most I can get` 193 20000 EQUALS 5018
-- $450 a week, $30,000 base: $11,700 against $15,000: $11,700.
#ASSERT `What is the most I can get` 450 30000 EQUALS 11700
-- $193 a week, $9,001 base: half is $4,500.50, the lower; up to $4,501.
#ASSERT `What is the most I can get` 193 9001 EQUALS 4501

-- ss 1252, 1279: a week with wages, at $193 a week.
-- $100: $25 and 25% are both $25; $75 is less than $193, so unemployed. Deduct the smaller of $75 and $75: $118.
#ASSERT `How much will I be paid this week` 193 100 EQUALS 118
-- $200: deduct the smaller of $175 and $150: $43.
#ASSERT `How much will I be paid this week` 193 200 EQUALS 43
-- $80: deduct the smaller of $55 and $60: $138.
#ASSERT `How much will I be paid this week` 193 80 EQUALS 138
-- $20: nothing over $25: the full $193.
#ASSERT `How much will I be paid this week` 193 20 EQUALS 193
-- $300: reduced by $75 it is $225, not less than $193: not unemployed that week; nothing.
#ASSERT `How much will I be paid this week` 193 300 EQUALS 0
-- $100 a week, $30.50 wages: deduct $5.50; $94.50 up to $95.
#ASSERT `How much will I be paid this week` 100 30.5 EQUALS 95

-- s 1255.3: a $50 weekly pension from a base-period employer's plan comes off; another pension does not.
#ASSERT `What is my payment after my pension` 193 50 TRUE EQUALS 143
#ASSERT `What is my payment after my pension` 193 50 FALSE EQUALS 193

-- s 1253: eligibility for a week.
#ASSERT `Am I eligible this week` TRUE TRUE TRUE TRUE TRUE TRUE
#ASSERT (NOT (`Am I eligible this week` TRUE TRUE TRUE FALSE TRUE TRUE))
#ASSERT (NOT (`Am I eligible this week` TRUE TRUE TRUE TRUE FALSE TRUE))

-- ss 1256, 1260(a): how the job ended.
#ASSERT `Does how my job ended disqualify me` `laid off or let go for no misconduct` FALSE EQUALS `not disqualified`
#ASSERT `Does how my job ended disqualify me` `quit without good cause` TRUE EQUALS `disqualified until earning five times the weekly benefit amount in new work`
-- no employer notice: the presumption stands.
#ASSERT `Does how my job ended disqualify me` `quit without good cause` FALSE EQUALS `not disqualified`
#ASSERT `Does how my job ended disqualify me` `discharged for misconduct connected with the work` TRUE EQUALS `disqualified until earning five times the weekly benefit amount in new work`
#ASSERT `Does how my job ended disqualify me` `quit to follow a spouse or partner, or to escape domestic violence` TRUE EQUALS `not disqualified`
#ASSERT `Does how my job ended disqualify me` `quit by electing a seniority layoff, or compulsory retirement under a collective agreement` TRUE EQUALS `not disqualified`
-- requalifying at $193 a week: 5 x $193 = $965.
#ASSERT `How much must I earn to requalify` 193 EQUALS 965

-- s 1260(b): a suitable-work disqualification must be 2 to 10 weeks.
#ASSERT `a lawful period for refusing suitable work` 2
#ASSERT `a lawful period for refusing suitable work` 10
#ASSERT (NOT (`a lawful period for refusing suitable work` 11))
#ASSERT (NOT (`a lawful period for refusing suitable work` 1))

-- -------------------------------------------------------------------------------------------------------------------
-- The duties, traced.
#ASSERT EVALTRACE (`the weekly work search` `the claimant`) 0 (LIST EVENT `the claimant` `search for suitable work as instructed` 3) EQUALS FULFILLED
-- expect: BREACH BY `the claimant` BECAUSE "s 1253(e): no search for suitable work as instructed; not eligible for the week"
#TRACE `the weekly work search` `the claimant` AT 0 WITH
    (WAITUNTIL 8)
#ASSERT EVALTRACE (`the employer's time to submit facts` `the last employing unit`) 0 (LIST EVENT `the last employing unit` `submit facts affecting the claimant's eligibility` 9) EQUALS FULFILLED
-- expect: BREACH BY `the last employing unit` BECAUSE "s 1327: no facts submitted within 10 days of the notice"
#TRACE `the employer's time to submit facts` `the last employing unit` AT 0 WITH
    (WAITUNTIL 11)
#ASSERT EVALTRACE (`the right to appeal` `the claimant`) 0 (LIST EVENT `the claimant` `appeal to an administrative law judge` 20) EQUALS FULFILLED
