IMPORT prelude
IMPORT daydate
IMPORT `s121-nouns`
IMPORT `s121-support`
IMPORT `s121-d9-service`

-- Tests for subsections (d)(9) to (d)(12). Expected values are worked out by hand from the text and the calendar.

§ `Tests: (d)(9) to (d)(12)`

-- A period of service built from the facts the definitions ask about; every field is named, none is positional.
GIVEN capacity IS A `Capacity of service`
      miles IS A NUMBER
      quarters IS A BOOLEAN
      active IS A BOOLEAN
      calldays IS A NUMBER
      indefinite IS A BOOLEAN
GIVETH A `Period of service`
`a test service` MEANS `Period of service` WITH
    `days` IS Span OF (Date 1 1 2024), (Date 30 6 2024)
    `capacity` IS capacity
    `serving outside the United States` IS TRUE
    `miles from the duty station to the property` IS miles
    `residing under Government orders in Government quarters` IS quarters
    `on active duty pursuant to a call or order` IS active
    `days the call or order is for` IS calldays
    `the call or order is for an indefinite period` IS indefinite
    `a member of the uniformed services under section 101(a)(5) of title 10` IS TRUE
    `a member of the Service under section 103(1) to (5) of the Foreign Service Act of 1980` IS TRUE
    `an employee as defined by section 2105 of title 5` IS TRUE
    `office of the intelligence community` IS `the Central Intelligence Agency`
    `an enrolled volunteer under section 5 of the Peace Corps Act` IS TRUE
    `a volunteer leader under section 6 of the Peace Corps Act` IS FALSE

-- (d)(9)(C)(v) extended duty: more than 90 days, or indefinite.
#ASSERT `s 121(d)(9)(C)(v) the duty is extended duty` (`a test service` `member of the uniformed services` 60 FALSE TRUE 91 FALSE) EQUALS JUST TRUE
#ASSERT `s 121(d)(9)(C)(v) the duty is extended duty` (`a test service` `member of the uniformed services` 60 FALSE TRUE 90 FALSE) EQUALS JUST FALSE
#ASSERT `s 121(d)(9)(C)(v) the duty is extended duty` (`a test service` `member of the uniformed services` 60 FALSE TRUE 0 TRUE) EQUALS JUST TRUE
#ASSERT `s 121(d)(9)(C)(v) the duty is extended duty` (`a test service` `member of the uniformed services` 60 FALSE FALSE 500 TRUE) EQUALS JUST FALSE

-- (d)(9)(C)(i) qualified official extended duty: extended duty, and a duty station 50 miles or more away, or Government quarters.
#ASSERT `s 121(d)(9)(C)(i) the duty is qualified official extended duty` (`a test service` `member of the uniformed services` 50 FALSE TRUE 91 FALSE) EQUALS JUST TRUE
#ASSERT `s 121(d)(9)(C)(i) the duty is qualified official extended duty` (`a test service` `member of the uniformed services` 49 FALSE TRUE 91 FALSE) EQUALS JUST FALSE
#ASSERT `s 121(d)(9)(C)(i) the duty is qualified official extended duty` (`a test service` `member of the uniformed services` 49 TRUE TRUE 91 FALSE) EQUALS JUST TRUE
#ASSERT `s 121(d)(9)(C)(i) the duty is qualified official extended duty` (`a test service` `member of the uniformed services` 50 FALSE TRUE 90 FALSE) EQUALS JUST FALSE

-- (d)(9)(C)(ii) and (iii): the borrowed meanings are the caller's facts.
#ASSERT `s 121(d)(9)(C)(ii) the person is a member of the uniformed services` (`a test service` `member of the uniformed services` 60 FALSE TRUE 91 FALSE) EQUALS JUST TRUE
#ASSERT `s 121(d)(9)(C)(iii) the person is a member of the Foreign Service of the United States` (`a test service` `member of the Foreign Service of the United States` 60 FALSE TRUE 91 FALSE) EQUALS JUST TRUE

-- (d)(9)(C)(iv): every office the text names, with the clause that names it; an office it does not name has none.
#ASSERT `s 121(d)(9)(C)(iv) the clause that names the office` `the Office of the Director of National Intelligence` EQUALS JUST "(I)"
#ASSERT `s 121(d)(9)(C)(iv) the clause that names the office` `the Central Intelligence Agency` EQUALS JUST "(II)"
#ASSERT `s 121(d)(9)(C)(iv) the clause that names the office` `the National Security Agency` EQUALS JUST "(III)"
#ASSERT `s 121(d)(9)(C)(iv) the clause that names the office` `the Defense Intelligence Agency` EQUALS JUST "(IV)"
#ASSERT `s 121(d)(9)(C)(iv) the clause that names the office` `the National Geospatial-Intelligence Agency` EQUALS JUST "(V)"
#ASSERT `s 121(d)(9)(C)(iv) the clause that names the office` `the National Reconnaissance Office` EQUALS JUST "(VI)"
#ASSERT `s 121(d)(9)(C)(iv) the clause that names the office` `another office within the Department of Defense for the collection of specialized national intelligence through reconnaissance programs` EQUALS JUST "(VII)"
#ASSERT `s 121(d)(9)(C)(iv) the clause that names the office` `an intelligence element of the Army` EQUALS JUST "(VIII)"
#ASSERT `s 121(d)(9)(C)(iv) the clause that names the office` `an intelligence element of the Navy` EQUALS JUST "(VIII)"
#ASSERT `s 121(d)(9)(C)(iv) the clause that names the office` `an intelligence element of the Air Force` EQUALS JUST "(VIII)"
#ASSERT `s 121(d)(9)(C)(iv) the clause that names the office` `an intelligence element of the Marine Corps` EQUALS JUST "(VIII)"
#ASSERT `s 121(d)(9)(C)(iv) the clause that names the office` `an intelligence element of the Federal Bureau of Investigation` EQUALS JUST "(VIII)"
#ASSERT `s 121(d)(9)(C)(iv) the clause that names the office` `an intelligence element of the Department of Treasury` EQUALS JUST "(VIII)"
#ASSERT `s 121(d)(9)(C)(iv) the clause that names the office` `an intelligence element of the Department of Energy` EQUALS JUST "(VIII)"
#ASSERT `s 121(d)(9)(C)(iv) the clause that names the office` `an intelligence element of the Coast Guard` EQUALS JUST "(VIII)"
#ASSERT `s 121(d)(9)(C)(iv) the clause that names the office` `the Bureau of Intelligence and Research of the Department of State` EQUALS JUST "(IX)"
#ASSERT `s 121(d)(9)(C)(iv) the clause that names the office` `an element of the Department of Homeland Security concerned with the analyses of foreign intelligence information` EQUALS JUST "(X)"
#ASSERT `s 121(d)(9)(C)(iv) the clause that names the office` `some other office` EQUALS NOTHING

-- (d)(9)(C)(iv) as a definition: an employee (title 5 meaning, the caller's fact) of a named office; "means" closes it.
`a test intelligence employee` MEANS `Period of service` WITH
    `days` IS Span OF (Date 1 1 2024), (Date 30 6 2024)
    `capacity` IS `employee of the intelligence community`
    `serving outside the United States` IS FALSE
    `miles from the duty station to the property` IS 60
    `residing under Government orders in Government quarters` IS FALSE
    `on active duty pursuant to a call or order` IS TRUE
    `days the call or order is for` IS 200
    `the call or order is for an indefinite period` IS FALSE
    `a member of the uniformed services under section 101(a)(5) of title 10` IS FALSE
    `a member of the Service under section 103(1) to (5) of the Foreign Service Act of 1980` IS FALSE
    `an employee as defined by section 2105 of title 5` IS TRUE
    `office of the intelligence community` IS `an intelligence element of the Coast Guard`
    `an enrolled volunteer under section 5 of the Peace Corps Act` IS FALSE
    `a volunteer leader under section 6 of the Peace Corps Act` IS FALSE
`a test intelligence non-employee` MEANS `Period of service` WITH
    `days` IS Span OF (Date 1 1 2024), (Date 30 6 2024)
    `capacity` IS `employee of the intelligence community`
    `serving outside the United States` IS FALSE
    `miles from the duty station to the property` IS 60
    `residing under Government orders in Government quarters` IS FALSE
    `on active duty pursuant to a call or order` IS TRUE
    `days the call or order is for` IS 200
    `the call or order is for an indefinite period` IS FALSE
    `a member of the uniformed services under section 101(a)(5) of title 10` IS FALSE
    `a member of the Service under section 103(1) to (5) of the Foreign Service Act of 1980` IS FALSE
    `an employee as defined by section 2105 of title 5` IS FALSE
    `office of the intelligence community` IS `the Central Intelligence Agency`
    `an enrolled volunteer under section 5 of the Peace Corps Act` IS FALSE
    `a volunteer leader under section 6 of the Peace Corps Act` IS FALSE
`a test other-office employee` MEANS `Period of service` WITH
    `days` IS Span OF (Date 1 1 2024), (Date 30 6 2024)
    `capacity` IS `employee of the intelligence community`
    `serving outside the United States` IS FALSE
    `miles from the duty station to the property` IS 60
    `residing under Government orders in Government quarters` IS FALSE
    `on active duty pursuant to a call or order` IS TRUE
    `days the call or order is for` IS 200
    `the call or order is for an indefinite period` IS FALSE
    `a member of the uniformed services under section 101(a)(5) of title 10` IS FALSE
    `a member of the Service under section 103(1) to (5) of the Foreign Service Act of 1980` IS FALSE
    `an employee as defined by section 2105 of title 5` IS TRUE
    `office of the intelligence community` IS `some other office`
    `an enrolled volunteer under section 5 of the Peace Corps Act` IS FALSE
    `a volunteer leader under section 6 of the Peace Corps Act` IS FALSE
#ASSERT `s 121(d)(9)(C)(iv) the person is an employee of the intelligence community` `a test intelligence employee` EQUALS JUST TRUE
#ASSERT `s 121(d)(9)(C)(iv) the person is an employee of the intelligence community` `a test intelligence non-employee` EQUALS JUST FALSE
#ASSERT `s 121(d)(9)(C)(iv) the person is an employee of the intelligence community` `a test other-office employee` EQUALS JUST FALSE

-- (d)(9)(A): each of the three capacities with qualified official extended duty; another capacity is outside the text's limit.
#ASSERT `s 121(d)(9)(A) the service is qualified official extended duty described in clause (i), (ii) or (iii)` (`a test service` `member of the uniformed services` 60 FALSE TRUE 91 FALSE) EQUALS JUST TRUE
#ASSERT `s 121(d)(9)(A) the service is qualified official extended duty described in clause (i), (ii) or (iii)` (`a test service` `member of the uniformed services` 49 FALSE TRUE 91 FALSE) EQUALS JUST FALSE
#ASSERT `s 121(d)(9)(A) the service is qualified official extended duty described in clause (i), (ii) or (iii)` (`a test service` `member of the Foreign Service of the United States` 60 FALSE TRUE 91 FALSE) EQUALS JUST TRUE
#ASSERT `s 121(d)(9)(A) the service is qualified official extended duty described in clause (i), (ii) or (iii)` `a test intelligence employee` EQUALS JUST TRUE
#ASSERT `s 121(d)(9)(A) the service is qualified official extended duty described in clause (i), (ii) or (iii)` `a test intelligence non-employee` EQUALS JUST FALSE
#ASSERT `s 121(d)(9)(A) the service is qualified official extended duty described in clause (i), (ii) or (iii)` (`a test service` `some other capacity` 60 FALSE TRUE 91 FALSE) EQUALS NOTHING

-- (d)(9)(D): the election. No election: not covered. Another election in effect: the text says it may not be made. Revoked: not covered.
#ASSERT `s 121(d)(9)(A) the running of the 5-year period is suspended at the individual's election` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 121(d)(9)(A) the running of the 5-year period is suspended at the individual's election` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 121(d)(9)(A) the running of the 5-year period is suspended at the individual's election` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 121(d)(9)(A) the running of the 5-year period is suspended at the individual's election` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 121(d)(12)(A) the running of the 5-year period is suspended at the individual's election` TRUE TRUE FALSE EQUALS JUST FALSE

-- (d)(9)(B): the extended 5-year period, for a sale on 15 March 2026 (the plain 5-year period starts 16 March 2021 and has 1826 days).
`a test sale on 15 March 2026` MEANS Date 15 3 2026
-- no qualifying service: the plain period
#ASSERT (`s 121(d)(9)(B) the 5-year period as extended, by no more than 10 years` `a test sale on 15 March 2026` EMPTY)'s `first day` EQUALS Date 16 3 2021
-- 365 days of service in 2023: 16 March 2020 to 15 March 2026 is 2191 days, 2191 - 365 = 1826
`a test duty 2023` MEANS LIST Span OF (Date 1 1 2023), (Date 31 12 2023)
#ASSERT (`s 121(d)(9)(B) the 5-year period as extended, by no more than 10 years` `a test sale on 15 March 2026` `a test duty 2023`)'s `first day` EQUALS Date 16 3 2020
#ASSERT (`s 121(d)(9)(B) the 5-year period as extended, by no more than 10 years` `a test sale on 15 March 2026` `a test duty 2023`)'s `last day` EQUALS Date 15 3 2026
-- two stretches of service, 183 days in 2025 and 182 days in 2024: 2191 - 365 = 1826 again
`a test two duties` MEANS LIST
    Span OF (Date 1 6 2025), (Date 30 11 2025)
    Span OF (Date 1 1 2024), (Date 30 6 2024)
#ASSERT (`s 121(d)(9)(B) the 5-year period as extended, by no more than 10 years` `a test sale on 15 March 2026` `a test two duties`)'s `first day` EQUALS Date 16 3 2020
-- the spouse's overlapping service is one stretch, not two: Jan-Jun and Apr-Dec 2023 make the whole of 2023
`a test overlapping duties` MEANS LIST
    Span OF (Date 1 1 2023), (Date 30 6 2023)
    Span OF (Date 1 4 2023), (Date 31 12 2023)
#ASSERT (`s 121(d)(9)(B) the 5-year period as extended, by no more than 10 years` `a test sale on 15 March 2026` `a test overlapping duties`)'s `first day` EQUALS Date 16 3 2020
-- service that runs up to the sale date: the 1826 days to count end on 31 December 2024, so the period starts 2 January 2020
`a test duty to the sale` MEANS LIST Span OF (Date 1 1 2025), (Date 15 3 2026)
#ASSERT (`s 121(d)(9)(B) the 5-year period as extended, by no more than 10 years` `a test sale on 15 March 2026` `a test duty to the sale`)'s `first day` EQUALS Date 2 1 2020
-- the cap: service from 2000 to 2024 cannot push the period back more than 10 years, so it starts 16 March 2011, the first day of the 15 years ending on the sale date
`a test very long duty` MEANS LIST Span OF (Date 1 1 2000), (Date 31 12 2024)
#ASSERT (`s 121(d)(9)(B) the 5-year period as extended, by no more than 10 years` `a test sale on 15 March 2026` `a test very long duty`)'s `first day` EQUALS Date 16 3 2011
-- (d)(12)(B): the same cap and counting
#ASSERT (`s 121(d)(12)(B) the 5-year period as extended by rules similar to (d)(9)(B)` `a test sale on 15 March 2026` `a test very long duty`)'s `first day` EQUALS Date 16 3 2011

-- the days of service that suspend the period: qualifying (d)(9) service and (d)(12) service count, other service does not
`a test peace corps employee` MEANS `Period of service` WITH
    `days` IS Span OF (Date 1 1 2022), (Date 30 6 2022)
    `capacity` IS `employee of the Peace Corps`
    `serving outside the United States` IS TRUE
    `miles from the duty station to the property` IS 60
    `residing under Government orders in Government quarters` IS FALSE
    `on active duty pursuant to a call or order` IS TRUE
    `days the call or order is for` IS 200
    `the call or order is for an indefinite period` IS FALSE
    `a member of the uniformed services under section 101(a)(5) of title 10` IS FALSE
    `a member of the Service under section 103(1) to (5) of the Foreign Service Act of 1980` IS FALSE
    `an employee as defined by section 2105 of title 5` IS FALSE
    `office of the intelligence community` IS `some other office`
    `an enrolled volunteer under section 5 of the Peace Corps Act` IS FALSE
    `a volunteer leader under section 6 of the Peace Corps Act` IS FALSE
`a test peace corps volunteer` MEANS `Period of service` WITH
    `days` IS Span OF (Date 1 1 2021), (Date 30 6 2021)
    `capacity` IS `enrolled volunteer or volunteer leader under the Peace Corps Act`
    `serving outside the United States` IS TRUE
    `miles from the duty station to the property` IS 0
    `residing under Government orders in Government quarters` IS FALSE
    `on active duty pursuant to a call or order` IS FALSE
    `days the call or order is for` IS 0
    `the call or order is for an indefinite period` IS FALSE
    `a member of the uniformed services under section 101(a)(5) of title 10` IS FALSE
    `a member of the Service under section 103(1) to (5) of the Foreign Service Act of 1980` IS FALSE
    `an employee as defined by section 2105 of title 5` IS FALSE
    `office of the intelligence community` IS `some other office`
    `an enrolled volunteer under section 5 of the Peace Corps Act` IS TRUE
    `a volunteer leader under section 6 of the Peace Corps Act` IS FALSE
`a test peace corps volunteer at home` MEANS `Period of service` WITH
    `days` IS Span OF (Date 1 1 2021), (Date 30 6 2021)
    `capacity` IS `enrolled volunteer or volunteer leader under the Peace Corps Act`
    `serving outside the United States` IS FALSE
    `miles from the duty station to the property` IS 0
    `residing under Government orders in Government quarters` IS FALSE
    `on active duty pursuant to a call or order` IS FALSE
    `days the call or order is for` IS 0
    `the call or order is for an indefinite period` IS FALSE
    `a member of the uniformed services under section 101(a)(5) of title 10` IS FALSE
    `a member of the Service under section 103(1) to (5) of the Foreign Service Act of 1980` IS FALSE
    `an employee as defined by section 2105 of title 5` IS FALSE
    `office of the intelligence community` IS `some other office`
    `an enrolled volunteer under section 5 of the Peace Corps Act` IS TRUE
    `a volunteer leader under section 6 of the Peace Corps Act` IS FALSE
#ASSERT `s 121(d)(12)(A) the service is serving outside the United States as described in clause (i) or (ii)` `a test peace corps employee` EQUALS JUST TRUE
#ASSERT `s 121(d)(12)(A) the service is serving outside the United States as described in clause (i) or (ii)` `a test peace corps volunteer` EQUALS JUST TRUE
#ASSERT `s 121(d)(12)(A) the service is serving outside the United States as described in clause (i) or (ii)` `a test peace corps volunteer at home` EQUALS JUST FALSE
#ASSERT `s 121(d)(12)(A) the service is serving outside the United States as described in clause (i) or (ii)` (`a test service` `some other capacity` 60 FALSE TRUE 91 FALSE) EQUALS NOTHING
`a test mixed services` MEANS LIST
      `a test peace corps employee`
    , `a test peace corps volunteer at home`
    , `a test intelligence employee`
    , `a test intelligence non-employee`
#ASSERT count (`s 121(d)(9)(A) and (d)(12)(A) the days of service that suspend the 5-year period` `a test mixed services`) EQUALS 2

-- (d)(10): property acquired 1 July 2022 in a like-kind exchange; the 5-year period beginning with that date ends on 30 June 2027.
#ASSERT `s 121(d)(10) subsection (a) shall not apply to the sale of property acquired in a like-kind exchange` TRUE TRUE (Date 1 7 2022) (Date 30 6 2027) EQUALS JUST TRUE
#ASSERT `s 121(d)(10) subsection (a) shall not apply to the sale of property acquired in a like-kind exchange` TRUE TRUE (Date 1 7 2022) (Date 1 7 2022) EQUALS JUST TRUE
#ASSERT `s 121(d)(10) subsection (a) shall not apply to the sale of property acquired in a like-kind exchange` TRUE TRUE (Date 1 7 2022) (Date 1 7 2027) EQUALS JUST FALSE
#ASSERT `s 121(d)(10) subsection (a) shall not apply to the sale of property acquired in a like-kind exchange` TRUE TRUE (Date 1 7 2022) (Date 30 6 2022) EQUALS JUST FALSE
#ASSERT `s 121(d)(10) subsection (a) shall not apply to the sale of property acquired in a like-kind exchange` FALSE TRUE (Date 1 7 2022) (Date 30 6 2027) EQUALS NOTHING
#ASSERT `s 121(d)(10) subsection (a) shall not apply to the sale of property acquired in a like-kind exchange` TRUE FALSE (Date 1 7 2022) (Date 30 6 2027) EQUALS NOTHING

-- the days of (d)(9)(A)(i)-(iii) service alone, which is what (b)(5)(C)(ii)(II) names: the Peace Corps employee's days are not among them
#ASSERT count (`s 121(d)(9)(A) the days of service on qualified official extended duty described in clause (i), (ii) or (iii)` `a test mixed services`) EQUALS 1
