IMPORT prelude
IMPORT daydate
IMPORT `s121-nouns`
IMPORT `s121-support`
IMPORT `s121-c-reduced`
IMPORT `s121-efg`

-- Tests for subsections (c), (e), (f) and (g). Expected values are worked out by hand from the text and the calendar, then run.

§ `Tests: (c)(2)`

#ASSERT `s 121(c)(2)(A)(i) subsection (a) would not apply by reason of a failure to meet the ownership and use requirements` (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 121(c)(2)(A)(i) subsection (a) would not apply by reason of a failure to meet the ownership and use requirements` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 121(c)(2)(A)(i) subsection (a) would not apply by reason of a failure to meet the ownership and use requirements` NOTHING EQUALS NOTHING
#ASSERT `s 121(c)(2)(A)(ii) subsection (a) would not apply by reason of subsection (b)(3)` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 121(c)(2)(A)(ii) subsection (a) would not apply by reason of subsection (b)(3)` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 121(c)(2)(A) subsection (a) would not (but for this subsection) apply by reason of (i) or (ii)` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 121(c)(2)(A) subsection (a) would not (but for this subsection) apply by reason of (i) or (ii)` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 121(c)(2)(A) subsection (a) would not (but for this subsection) apply by reason of (i) or (ii)` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
-- (B): any one of the three reasons
#ASSERT `s 121(c)(2)(B) the sale is by reason of a change in place of employment, health, or unforeseen circumstances` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 121(c)(2)(B) the sale is by reason of a change in place of employment, health, or unforeseen circumstances` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 121(c)(2)(B) the sale is by reason of a change in place of employment, health, or unforeseen circumstances` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 121(c)(2)(B) the sale is by reason of a change in place of employment, health, or unforeseen circumstances` FALSE FALSE FALSE EQUALS JUST FALSE
-- (c)(2) as a whole
#ASSERT `s 121(c)(2) this subsection applies to the sale or exchange` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 121(c)(2) this subsection applies to the sale or exchange` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 121(c)(2) this subsection applies to the sale or exchange` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 121(c)(2) this subsection applies to the sale or exchange` (JUST TRUE) NOTHING EQUALS NOTHING

§ `Tests: (c)(1)`

-- (B)(i)(I): owned from 1 January 2025 and used from 1 June 2025 to the sale on 15 March 2026: the days in both are 1 June 2025 to 15 March 2026 = 214 + 74 = 288
`a test holding for the reduced exclusion` MEANS Holding OF (LIST Span OF (Date 1 1 2025), (Date 15 3 2026)), (LIST Span OF (Date 1 6 2025), (Date 15 3 2026))
`a test window for the reduced exclusion` MEANS Span OF (Date 16 3 2021), (Date 15 3 2026)
#ASSERT `s 121(c)(1)(B)(i)(I) the aggregate periods during the 5-year period the property has been owned and used as the principal residence` `a test holding for the reduced exclusion` `a test window for the reduced exclusion` EQUALS 288
-- (B)(i)(II): the days strictly between a prior sale on 1 January 2025 and the sale on 15 March 2026: 2 January 2025 to 14 March 2026 = 437
#ASSERT `s 121(c)(1)(B)(i)(II) the period after the most recent prior sale or exchange and before the date of such sale` (Date 15 3 2026) (LIST Date 1 1 2025) EQUALS JUST 437
#ASSERT `s 121(c)(1)(B)(i)(II) the period after the most recent prior sale or exchange and before the date of such sale` (Date 15 3 2026) (LIST Date 1 1 2020, Date 1 1 2025) EQUALS JUST 437
#ASSERT `s 121(c)(1)(B)(i)(II) the period after the most recent prior sale or exchange and before the date of such sale` (Date 15 3 2026) (LIST Date 14 3 2026) EQUALS JUST 0
#ASSERT `s 121(c)(1)(B)(i)(II) the period after the most recent prior sale or exchange and before the date of such sale` (Date 15 3 2026) (LIST Date 13 3 2026) EQUALS JUST 1
#ASSERT `s 121(c)(1)(B)(i)(II) the period after the most recent prior sale or exchange and before the date of such sale` (Date 15 3 2026) EMPTY EQUALS NOTHING
-- (B)(i): the shorter
#ASSERT `s 121(c)(1)(B)(i) the shorter of (I) and (II)` 288 (JUST 437) EQUALS 288
#ASSERT `s 121(c)(1)(B)(i) the shorter of (I) and (II)` 500 (JUST 437) EQUALS 437
#ASSERT `s 121(c)(1)(B)(i) the shorter of (I) and (II)` 437 (JUST 437) EQUALS 437
#ASSERT `s 121(c)(1)(B)(i) the shorter of (I) and (II)` 500 NOTHING EQUALS 500
-- (B)(ii): 2 years ending on 15 March 2026 is 730 days
#ASSERT `s 121(c)(1)(B)(ii) 2 years, counted in days, ending on the date of the sale or exchange` (Date 15 3 2026) EQUALS 730
-- (c)(1): the reduced limitation
#ASSERT `s 121(c)(1) the dollar limitation as reduced` 250000 365 730 EQUALS 125000
#ASSERT `s 121(c)(1) the dollar limitation as reduced` 250000 730 730 EQUALS 250000
#ASSERT `s 121(c)(1) the dollar limitation as reduced` 250000 0 730 EQUALS 0
#ASSERT `s 121(c)(1) the dollar limitation as reduced` 500000 288 730 EQUALS 144000000 DIVIDED BY 730
-- (c)(1) first clause
#ASSERT `s 121(c)(1) the ownership and use requirements of subsection (a), and subsection (b)(3), shall not apply to the sale` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 121(c)(1) the ownership and use requirements of subsection (a), and subsection (b)(3), shall not apply to the sale` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 121(c)(1) the ownership and use requirements of subsection (a), and subsection (b)(3), shall not apply to the sale` NOTHING EQUALS NOTHING

§ `Tests: (e), (f), (g)`

#ASSERT `s 121(e) this section applies to the sale or exchange by the individual` TRUE EQUALS JUST FALSE
#ASSERT `s 121(e) this section applies to the sale or exchange by the individual` FALSE EQUALS NOTHING
#ASSERT `s 121(f) this section applies to the sale or exchange` TRUE EQUALS JUST FALSE
#ASSERT `s 121(f) this section applies to the sale or exchange` FALSE EQUALS NOTHING
#ASSERT `s 121(g) the days the other residence was owned and used are included` TRUE 400 EQUALS JUST 400
#ASSERT `s 121(g) the days the other residence was owned and used are included` TRUE 0 EQUALS JUST 0
#ASSERT `s 121(g) the days the other residence was owned and used are included` FALSE 400 EQUALS NOTHING
