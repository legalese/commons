IMPORT prelude
IMPORT `snap-core`
IMPORT `snap-seat`

-- Cases for the applicant's seat (snap-seat.l4) and the regulative rules of the core (snap-core.l4).
-- Every expected value was worked by hand from the deposited text (usc07-ch51.txt) and the FY 2027 COLA tables
-- (fna-snap-cola-fy2027.txt), never copied from the encoding's output; the arithmetic is in the comment above each.
-- No scenario life raised this Act: the households are the encoder's, HYPOTHETICAL throughout.
--
-- Household questions take 16 answers, in this order: the month asked about; 48 States or DC; household size; an
-- elderly or disabled member; every member on TANF/SSI; monthly earnings; other monthly income; child support paid;
-- State deducts child support; dependent care; medical costs of elderly/disabled members; shelter costs; all homeless;
-- free shelter all month; chooses the homeless deduction; countable resources.
--
-- A breached or still-pending DEONTIC cannot be asserted on the stable l4, so regulative rules are asserted where the
-- trace ends FULFILLED, and #TRACEd with an "-- expect:" line where it does not. Clock: days.

`1 Nov 2026`  MEANS DATE_FROM_DMY 1 11 2026
`16 Nov 2026` MEANS DATE_FROM_DMY 16 11 2026
`30 Nov 2026` MEANS DATE_FROM_DMY 30 11 2026
`15 Feb 2027` MEANS DATE_FROM_DMY 15 2 2027
`30 Sep 2026` MEANS DATE_FROM_DMY 30 9 2026
`1 Oct 2027`  MEANS DATE_FROM_DMY 1 10 2027

-- =====================================================================================================================
-- CASE 1. A single adult. HYPOTHETICAL: Alex, 30, lives alone in Ohio, works 25 hours a week for $1,000 a month,
-- pays $700 rent including utilities, has $500 in the bank. November 2026 (FY 2027).
-- =====================================================================================================================

-- s 2012(m)(1)(A): lives alone.
#ASSERT `Who is my SNAP household` `1 Nov 2026` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 0 0 EQUALS `a household of my own (s 2012(m)(1)(A))`

-- Gross: 1000 (s 2014(c)(2)); limit for 1 is 1729.
#ASSERT `What is our gross income for SNAP` `1 Nov 2026` TRUE 1 FALSE FALSE 1000 0 0 FALSE 0 0 700 FALSE FALSE FALSE 500 EQUALS 1000
-- After other deductions: 1000 - 217 (standard, 1-3) - 200 (20% earned) = 583; half is 291.50; excess shelter
-- 700 - 291.50 = 408.50, under the $769 cap.
#ASSERT `What is our shelter deduction` `1 Nov 2026` TRUE 1 FALSE FALSE 1000 0 0 FALSE 0 0 700 FALSE FALSE FALSE 500 EQUALS `the amount, in US dollars a month, is` 408.5
-- Net: 583 - 408.50 = 174.50; limit for 1 is 1330.
#ASSERT `What is our net income for SNAP` `1 Nov 2026` TRUE 1 FALSE FALSE 1000 0 0 FALSE 0 0 700 FALSE FALSE FALSE 500 EQUALS `the amount, in US dollars a month, is` 174.5
-- Resources 500 <= 3000.
#ASSERT `Does my household qualify for SNAP` `1 Nov 2026` TRUE 1 FALSE FALSE 1000 0 0 FALSE 0 0 700 FALSE FALSE FALSE 500 EQUALS `eligible: the household meets the income and resource tests (s 2014(c), (g))`
-- s 2017(a): 306 - 30% x 174.50 = 306 - 52.35 = 253.65, rounded down: 253.
#ASSERT `How much SNAP will we get each month` `1 Nov 2026` TRUE 1 FALSE FALSE 1000 0 0 FALSE 0 0 700 FALSE FALSE FALSE 500 EQUALS `the amount, in US dollars a month, is` 253
-- s 2017(c): applies 16 November; November has 30 days; 15 days remain counting the 16th: 253 x 15/30 = 126.50.
#ASSERT `How much SNAP will we get for the first month` `16 Nov 2026` TRUE 1 FALSE FALSE 1000 0 0 FALSE 0 0 700 FALSE FALSE FALSE 500 EQUALS `the amount, in US dollars a month, is` 126.5
-- s 2015(d)(1): 30, fit, 25 hours a week (< 30). HYPOTHETICAL weekly earnings $230.77 ($12,000 a year / 52) are at
-- least 30 x $7.25 = $217.50, so (d)(2)(E) exempts: not required. At $200 a week: required.
#ASSERT NOT (`Must I meet the SNAP work requirements` 30 TRUE FALSE FALSE FALSE FALSE 25 230.77 7.25 TRUE)
#ASSERT `Must I meet the SNAP work requirements` 30 TRUE FALSE FALSE FALSE FALSE 25 200 7.25 TRUE
-- Exactly 30 x 7.25 = 217.50 a week is enough ("equal").
#ASSERT NOT (`Must I meet the SNAP work requirements` 30 TRUE FALSE FALSE FALSE FALSE 25 217.5 7.25 TRUE)
-- 30 hours a week exempts, whatever the pay.
#ASSERT NOT (`Must I meet the SNAP work requirements` 30 TRUE FALSE FALSE FALSE FALSE 30 100 7.25 TRUE)
-- Age: "over the age of 15 and under the age of 60". 60: not required. Not fit: not required.
#ASSERT NOT (`Must I meet the SNAP work requirements` 60 TRUE FALSE FALSE FALSE FALSE 0 0 7.25 TRUE)
#ASSERT NOT (`Must I meet the SNAP work requirements` 30 FALSE FALSE FALSE FALSE FALSE 0 0 7.25 TRUE)
-- (d)(2)(F): 17, not head of household: exempt; 17 and head of household, not in school: required; 18, not head: required.
#ASSERT NOT (`Must I meet the SNAP work requirements` 17 TRUE FALSE FALSE FALSE FALSE 0 0 7.25 FALSE)
#ASSERT `Must I meet the SNAP work requirements` 17 TRUE FALSE FALSE FALSE FALSE 0 0 7.25 TRUE
#ASSERT `Must I meet the SNAP work requirements` 18 TRUE FALSE FALSE FALSE FALSE 0 0 7.25 FALSE
-- (d)(1)(C): first finding 1 month at least, State may set up to 3; second 3 and 6; third 6, no cap, may be permanent.
#ASSERT (`How long am I barred for a work requirement violation` 1)'s `at least months` EQUALS 1
#ASSERT (`How long am I barred for a work requirement violation` 1)'s `the State agency may set up to months` EQUALS JUST 3
#ASSERT (`How long am I barred for a work requirement violation` 2)'s `at least months` EQUALS 3
#ASSERT (`How long am I barred for a work requirement violation` 2)'s `the State agency may set up to months` EQUALS JUST 6
#ASSERT (`How long am I barred for a work requirement violation` 3)'s `the State agency may set up to months` EQUALS NOTHING
#ASSERT (`How long am I barred for a work requirement violation` 3)'s `the State agency may make it permanent`
#ASSERT NOT ((`How long am I barred for a work requirement violation` 2)'s `the State agency may make it permanent`)

-- s 2015(o). HYPOTHETICAL: Alex works 25 hours a week at $200 a week (so not exempt under (d)(2)(E)): 20 hours or
-- more, so the month does not count. (At $230.77 a week the (d)(2)(E) exemption would make (o)(3)(D) apply instead.)
#ASSERT `Does the time limit stop me getting SNAP` 30 FALSE FALSE FALSE FALSE FALSE FALSE 25 200 7.25 FALSE FALSE FALSE FALSE TRUE 0 EQUALS `I meet the work requirement this month, so the month does not count (s 2015(o)(2)(A)-(C))`

-- ---------------------------------------------------------------------------------------------------------------------
-- CASE 1b. HYPOTHETICAL: Alex loses the job: no income, stays with a friend rent-free, $80 in the bank.
-- ---------------------------------------------------------------------------------------------------------------------
-- Net: 0 - 217 floors at 0; allotment 306 - 0 = 306 (the maximum for 1).
#ASSERT `How much SNAP will we get each month` `1 Nov 2026` TRUE 1 FALSE FALSE 0 0 0 FALSE 0 0 0 FALSE FALSE FALSE 80 EQUALS `the amount, in US dollars a month, is` 306
-- s 2020(e)(9)(A): gross 0 < 150 and liquid 80 <= 100: expedited, 7 days.
#ASSERT `Are we entitled to expedited service` 0 80 0 FALSE
#ASSERT `Within how many days must the State give us benefits` 0 80 0 FALSE EQUALS 7
-- $101 in the bank: not (A); (B) 0 + 101 is not less than rent 0: 30 days.
#ASSERT NOT (`Are we entitled to expedited service` 0 101 0 FALSE)
#ASSERT `Within how many days must the State give us benefits` 0 101 0 FALSE EQUALS 30
-- (e)(9)(B): gross 400 + liquid 300 = 700 < rent and utilities 900: expedited. 900 exactly: not ("less than").
#ASSERT `Are we entitled to expedited service` 400 300 900 FALSE
#ASSERT NOT (`Are we entitled to expedited service` 400 500 900 FALSE)
-- (e)(9)(A)(i)(II): a destitute migrant household with $100: expedited whatever its income.
#ASSERT `Are we entitled to expedited service` 900 100 0 TRUE
-- s 2015(o): out of work, no exception, no waiver; 2 months used: one left; 3 used: not eligible.
#ASSERT `Does the time limit stop me getting SNAP` 30 FALSE FALSE FALSE FALSE FALSE FALSE 0 0 7.25 FALSE FALSE FALSE FALSE FALSE 2 EQUALS `I can still get SNAP without meeting the work requirement` 1
#ASSERT `Does the time limit stop me getting SNAP` 30 FALSE FALSE FALSE FALSE FALSE FALSE 0 0 7.25 FALSE FALSE FALSE FALSE FALSE 0 EQUALS `I can still get SNAP without meeting the work requirement` 3
#ASSERT `Does the time limit stop me getting SNAP` 30 FALSE FALSE FALSE FALSE FALSE FALSE 0 0 7.25 FALSE FALSE FALSE FALSE FALSE 3 EQUALS `I am not eligible: I have had 3 months in the 36-month period without meeting the work requirement (s 2015(o)(2))`
-- A waiver area, or a State exemption, lifts it.
#ASSERT `Does the time limit stop me getting SNAP` 30 FALSE FALSE FALSE FALSE FALSE FALSE 0 0 7.25 FALSE FALSE TRUE FALSE FALSE 3 EQUALS `the time limit does not apply to me: my area is covered by a waiver (s 2015(o)(4))`
#ASSERT `Does the time limit stop me getting SNAP` 30 FALSE FALSE FALSE FALSE FALSE FALSE 0 0 7.25 FALSE FALSE FALSE TRUE FALSE 3 EQUALS `the time limit does not apply to me: the State agency has exempted me (s 2015(o)(6))`
-- (o)(3)(A) "under 18, or over 65": at 65 the limit still applies; at 66 it does not. Pregnant: excepted.
#ASSERT `Does the time limit stop me getting SNAP` 65 FALSE FALSE FALSE FALSE FALSE FALSE 0 0 7.25 FALSE FALSE FALSE FALSE FALSE 3 EQUALS `I am not eligible: I have had 3 months in the 36-month period without meeting the work requirement (s 2015(o)(2))`
#ASSERT `Does the time limit stop me getting SNAP` 66 FALSE FALSE FALSE FALSE FALSE FALSE 0 0 7.25 FALSE FALSE FALSE FALSE FALSE 3 EQUALS `the time limit does not apply to me: an exception in s 2015(o)(3) applies`
#ASSERT `Does the time limit stop me getting SNAP` 17 FALSE FALSE FALSE FALSE FALSE FALSE 0 0 7.25 FALSE FALSE FALSE FALSE FALSE 3 EQUALS `the time limit does not apply to me: an exception in s 2015(o)(3) applies`
#ASSERT `Does the time limit stop me getting SNAP` 30 FALSE FALSE FALSE FALSE FALSE FALSE 0 0 7.25 TRUE FALSE FALSE FALSE FALSE 3 EQUALS `the time limit does not apply to me: an exception in s 2015(o)(3) applies`
-- (o)(3)(F): an Indian: excepted.
#ASSERT `Does the time limit stop me getting SNAP` 30 FALSE FALSE FALSE FALSE FALSE FALSE 0 0 7.25 FALSE TRUE FALSE FALSE FALSE 3 EQUALS `the time limit does not apply to me: an exception in s 2015(o)(3) applies`
-- (o)(5)(A): 80 hours in 30 days regains eligibility; 79 does not; workfare does.
#ASSERT `Have I regained SNAP eligibility after the time limit` 80 FALSE
#ASSERT NOT (`Have I regained SNAP eligibility after the time limit` 79 FALSE)
#ASSERT `Have I regained SNAP eligibility after the time limit` 0 TRUE

-- ---------------------------------------------------------------------------------------------------------------------
-- CASE 1c. Boundaries for one person, no earnings, no shelter costs. HYPOTHETICAL other income.
-- ---------------------------------------------------------------------------------------------------------------------
-- Other income 1547: gross 1547 <= 1729; net 1547 - 217 = 1330, exactly the net limit (not "exceeds"): eligible.
-- 306 - 30% x 1330 = 306 - 399 < 0, so the one-person minimum: $25.
#ASSERT `How much SNAP will we get each month` `1 Nov 2026` TRUE 1 FALSE FALSE 0 1547 0 FALSE 0 0 0 FALSE FALSE FALSE 0 EQUALS `the amount, in US dollars a month, is` 25
-- 1548: net 1331 > 1330: not eligible on net income.
#ASSERT `How much SNAP will we get each month` `1 Nov 2026` TRUE 1 FALSE FALSE 0 1548 0 FALSE 0 0 0 FALSE FALSE FALSE 0 EQUALS `my household is not eligible` `not eligible: net income is over the poverty line (s 2014(c)(1))`
-- First month of the $25 minimum, applying on 30 November: 25 x 1/30 < $10, so no allotment for that month.
#ASSERT `How much SNAP will we get for the first month` `30 Nov 2026` TRUE 1 FALSE FALSE 0 1547 0 FALSE 0 0 0 FALSE FALSE FALSE 0 EQUALS `the amount, in US dollars a month, is` 0
-- Resources $3,000 exactly pass; $3,001 fail (s 2014(g), FY 2027 limit for other households).
#ASSERT `Does my household qualify for SNAP` `1 Nov 2026` TRUE 1 FALSE FALSE 0 500 0 FALSE 0 0 0 FALSE FALSE FALSE 3000 EQUALS `eligible: the household meets the income and resource tests (s 2014(c), (g))`
#ASSERT `Does my household qualify for SNAP` `1 Nov 2026` TRUE 1 FALSE FALSE 0 500 0 FALSE 0 0 0 FALSE FALSE FALSE 3001 EQUALS `not eligible: resources are over the limit (s 2014(g))`

-- Child support paid (s 2014(d)(6), (e)(4)). HYPOTHETICAL: earns 1000, pays 200 support. Excluded: gross 800.
-- Deducted instead: gross 1000. Either way the net is the same: 800 - 217 - 200 = 383; 1000 - 217 - 200 - 200 = 383.
#ASSERT `What is our gross income for SNAP` `1 Nov 2026` TRUE 1 FALSE FALSE 1000 0 200 FALSE 0 0 0 FALSE FALSE FALSE 0 EQUALS 800
#ASSERT `What is our gross income for SNAP` `1 Nov 2026` TRUE 1 FALSE FALSE 1000 0 200 TRUE 0 0 0 FALSE FALSE FALSE 0 EQUALS 1000
#ASSERT `What is our net income for SNAP` `1 Nov 2026` TRUE 1 FALSE FALSE 1000 0 200 FALSE 0 0 0 FALSE FALSE FALSE 0 EQUALS `the amount, in US dollars a month, is` 383
#ASSERT `What is our net income for SNAP` `1 Nov 2026` TRUE 1 FALSE FALSE 1000 0 200 TRUE 0 0 0 FALSE FALSE FALSE 0 EQUALS `the amount, in US dollars a month, is` 383

-- Homeless (s 2014(e)(6)(D)). HYPOTHETICAL: one homeless adult, $500 other income, not in free shelter, takes the flat
-- deduction: $205.66. Net 500 - 217 - 205.66 = 77.34; 306 - 23.202 = 282.798, rounded down: 282.
#ASSERT `What is our shelter deduction` `1 Nov 2026` TRUE 1 FALSE FALSE 0 500 0 FALSE 0 0 0 TRUE FALSE TRUE 0 EQUALS `the amount, in US dollars a month, is` 205.66
#ASSERT `How much SNAP will we get each month` `1 Nov 2026` TRUE 1 FALSE FALSE 0 500 0 FALSE 0 0 0 TRUE FALSE TRUE 0 EQUALS `the amount, in US dollars a month, is` 282
-- In free shelter all month: no homeless deduction; with no shelter costs, no shelter deduction at all.
#ASSERT `What is our shelter deduction` `1 Nov 2026` TRUE 1 FALSE FALSE 0 500 0 FALSE 0 0 0 TRUE TRUE TRUE 0 EQUALS `the amount, in US dollars a month, is` 0

-- Not covered: the day before FY 2027, the day after, and Alaska.
#ASSERT `How much SNAP will we get each month` `30 Sep 2026` TRUE 1 FALSE FALSE 1000 0 0 FALSE 0 0 700 FALSE FALSE FALSE 500 EQUALS `not covered: no deposited SNAP figures for that day, or my household is outside the 48 States and DC`
#ASSERT `How much SNAP will we get each month` `1 Oct 2027` TRUE 1 FALSE FALSE 1000 0 0 FALSE 0 0 700 FALSE FALSE FALSE 500 EQUALS `not covered: no deposited SNAP figures for that day, or my household is outside the 48 States and DC`
#ASSERT `How much SNAP will we get each month` `1 Nov 2026` FALSE 1 FALSE FALSE 1000 0 0 FALSE 0 0 700 FALSE FALSE FALSE 500 EQUALS `not covered: no deposited SNAP figures for that day, or my household is outside the 48 States and DC`
#ASSERT `Does my household qualify for SNAP` `1 Oct 2027` TRUE 1 FALSE FALSE 1000 0 0 FALSE 0 0 700 FALSE FALSE FALSE 500 EQUALS `not covered: no deposited figures for that day, or the household is outside the 48 States and DC`

-- =====================================================================================================================
-- CASE 2. An elderly couple on Social Security. HYPOTHETICAL: Ruth, 70, and Sam, 68, married, living together in an
-- apartment in New Jersey. Social Security retirement benefits $2,600 a month between them; rent and utilities $2,000;
-- out-of-pocket medical costs (Medicare Part B premiums, prescriptions) $200; savings $4,000. November 2026.
-- =====================================================================================================================

-- s 2012(j)(1): 70 is "sixty years of age or older". 59 with nothing else: not.
#ASSERT `Is this member elderly or disabled` 70 FALSE FALSE FALSE
#ASSERT NOT (`Is this member elderly or disabled` 59 FALSE FALSE FALSE)
#ASSERT `Is this member elderly or disabled` 45 FALSE TRUE FALSE
-- s 2012(m)(2): spouses who live together are one household.
#ASSERT `Who is my SNAP household` `1 Nov 2026` FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE TRUE FALSE 0 0 EQUALS `one household with my spouse, parent or child, or the adult whose parental control I am under, even if we buy and cook separately (s 2012(m)(2))`

-- Gross 2600 is over 130% for 2 (2345), but the gross test does not apply to a household with an elderly member.
#ASSERT `What is our gross income for SNAP` `1 Nov 2026` TRUE 2 TRUE FALSE 0 2600 0 FALSE 0 200 2000 FALSE FALSE FALSE 4000 EQUALS 2600
-- After other deductions: 2600 - 217 - (200 - 35 = 165 medical) = 2218; half 1109; excess shelter 2000 - 1109 = 891,
-- uncapped (above $769) because the household contains an elderly member (s 2014(e)(6)(B)).
#ASSERT `What is our shelter deduction` `1 Nov 2026` TRUE 2 TRUE FALSE 0 2600 0 FALSE 0 200 2000 FALSE FALSE FALSE 4000 EQUALS `the amount, in US dollars a month, is` 891
-- Net 2218 - 891 = 1327 <= 1804. Resources 4000 <= 4750 (the elderly or disabled limit).
#ASSERT `What is our net income for SNAP` `1 Nov 2026` TRUE 2 TRUE FALSE 0 2600 0 FALSE 0 200 2000 FALSE FALSE FALSE 4000 EQUALS `the amount, in US dollars a month, is` 1327
#ASSERT `Does my household qualify for SNAP` `1 Nov 2026` TRUE 2 TRUE FALSE 0 2600 0 FALSE 0 200 2000 FALSE FALSE FALSE 4000 EQUALS `eligible: the household meets the income and resource tests (s 2014(c), (g))`
-- s 2017(a): 562 - 30% x 1327 = 562 - 398.10 = 163.90, rounded down: 163.
#ASSERT `How much SNAP will we get each month` `1 Nov 2026` TRUE 2 TRUE FALSE 0 2600 0 FALSE 0 200 2000 FALSE FALSE FALSE 4000 EQUALS `the amount, in US dollars a month, is` 163
-- s 2017(c): applying 15 February 2027 (28 days): 14 days remain counting the 15th: 163 x 14/28 = 81.50.
#ASSERT `How much SNAP will we get for the first month` `15 Feb 2027` TRUE 2 TRUE FALSE 0 2600 0 FALSE 0 200 2000 FALSE FALSE FALSE 4000 EQUALS `the amount, in US dollars a month, is` 81.5
-- Counterfactual: the same couple with no elderly or disabled member fails the gross test (2600 > 2345).
#ASSERT `Does my household qualify for SNAP` `1 Nov 2026` TRUE 2 FALSE FALSE 0 2600 0 FALSE 0 200 2000 FALSE FALSE FALSE 4000 EQUALS `not eligible: gross income is over 130 percent of the poverty line (s 2014(c)(2))`
-- ... and its shelter deduction would be capped: no medical deduction, 2600 - 217 = 2383; half 1191.50; 2000 - 1191.50
-- = 808.50 > 769, so $769.
#ASSERT `What is our shelter deduction` `1 Nov 2026` TRUE 2 FALSE FALSE 0 2600 0 FALSE 0 200 2000 FALSE FALSE FALSE 4000 EQUALS `the amount, in US dollars a month, is` 769
-- Savings $5,000: over $4,750.
#ASSERT `How much SNAP will we get each month` `1 Nov 2026` TRUE 2 TRUE FALSE 0 2600 0 FALSE 0 200 2000 FALSE FALSE FALSE 5000 EQUALS `my household is not eligible` `not eligible: resources are over the limit (s 2014(g))`
-- s 2014(a): if both received SSI, the household is eligible without the income and resource tests, even with $5,000.
#ASSERT `Does my household qualify for SNAP` `1 Nov 2026` TRUE 2 TRUE TRUE 0 2600 0 FALSE 0 200 2000 FALSE FALSE FALSE 5000 EQUALS `eligible: every member receives TANF, SSI or aid to the aged, blind or disabled (s 2014(a))`
-- Medical costs of $35 or less give no deduction: 2600 - 217 = 2383; half 1191.50; 2000 - 1191.50 = 808.50 uncapped;
-- net 2383 - 808.50 = 1574.50; 562 - 472.35 = 89.65, rounded down: 89.
#ASSERT `How much SNAP will we get each month` `1 Nov 2026` TRUE 2 TRUE FALSE 0 2600 0 FALSE 0 35 2000 FALSE FALSE FALSE 4000 EQUALS `the amount, in US dollars a month, is` 89
-- Their time limit: Ruth at 70 is over 65 (s 2015(o)(3)(A)); their work requirement: over 59 (s 2015(d)(1)(A)).
#ASSERT `Does the time limit stop me getting SNAP` 70 FALSE FALSE FALSE FALSE FALSE FALSE 0 0 7.25 FALSE FALSE FALSE FALSE FALSE 0 EQUALS `the time limit does not apply to me: an exception in s 2015(o)(3) applies`
#ASSERT NOT (`Must I meet the SNAP work requirements` 68 TRUE FALSE FALSE FALSE FALSE 0 0 7.25 FALSE)

-- =====================================================================================================================
-- CASE 3. A family of four with earnings and high rent. HYPOTHETICAL: Maria (35) and Luis (33), married, with children
-- aged 4 and 8, in Texas. Luis works 40 hours a week for $3,000 a month; Maria cares for the children; after-school care
-- for the 8-year-old while both parents are at work and job training costs $300 a month; rent and utilities $2,100;
-- savings $1,500. November 2026.
-- =====================================================================================================================

-- s 2012(m)(2): parents and their children 21 or younger who live together are one household.
#ASSERT `Who is my SNAP household` `1 Nov 2026` FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE 0 0 EQUALS `one household with my spouse, parent or child, or the adult whose parental control I am under, even if we buy and cook separately (s 2012(m)(2))`
-- Gross 3000 <= 3575.
#ASSERT `What is our gross income for SNAP` `1 Nov 2026` TRUE 4 FALSE FALSE 3000 0 0 FALSE 300 0 2100 FALSE FALSE FALSE 1500 EQUALS 3000
-- After other deductions: 3000 - 229 (standard, 4) - 600 (20% earned) - 300 (dependent care) = 1871; half 935.50;
-- excess 2100 - 935.50 = 1164.50, capped at $769.
#ASSERT `What is our shelter deduction` `1 Nov 2026` TRUE 4 FALSE FALSE 3000 0 0 FALSE 300 0 2100 FALSE FALSE FALSE 1500 EQUALS `the amount, in US dollars a month, is` 769
-- Net 1871 - 769 = 1102 <= 2750.
#ASSERT `What is our net income for SNAP` `1 Nov 2026` TRUE 4 FALSE FALSE 3000 0 0 FALSE 300 0 2100 FALSE FALSE FALSE 1500 EQUALS `the amount, in US dollars a month, is` 1102
#ASSERT `Does my household qualify for SNAP` `1 Nov 2026` TRUE 4 FALSE FALSE 3000 0 0 FALSE 300 0 2100 FALSE FALSE FALSE 1500 EQUALS `eligible: the household meets the income and resource tests (s 2014(c), (g))`
-- s 2017(a): 1023 - 30% x 1102 = 1023 - 330.60 = 692.40, rounded down: 692.
#ASSERT `How much SNAP will we get each month` `1 Nov 2026` TRUE 4 FALSE FALSE 3000 0 0 FALSE 300 0 2100 FALSE FALSE FALSE 1500 EQUALS `the amount, in US dollars a month, is` 692
-- s 2017(c): applying 16 November: 692 x 15/30 = 346.
#ASSERT `How much SNAP will we get for the first month` `16 Nov 2026` TRUE 4 FALSE FALSE 3000 0 0 FALSE 300 0 2100 FALSE FALSE FALSE 1500 EQUALS `the amount, in US dollars a month, is` 346
-- Counterfactual: earnings of $3,600 are over 130% for 4 (3575): not eligible however high the rent.
#ASSERT `How much SNAP will we get each month` `1 Nov 2026` TRUE 4 FALSE FALSE 3600 0 0 FALSE 300 0 2100 FALSE FALSE FALSE 1500 EQUALS `my household is not eligible` `not eligible: gross income is over 130 percent of the poverty line (s 2014(c)(2))`
-- Not expedited: 3000 + 1500 = 4500 is not less than 2100; the State agency has 30 days.
#ASSERT `Within how many days must the State give us benefits` 3000 1500 2100 FALSE EQUALS 30
-- Work: Luis works 40 hours (exempt, (d)(2)(E)); Maria cares for a child under 6 (exempt, (d)(2)(B)).
#ASSERT NOT (`Must I meet the SNAP work requirements` 33 TRUE FALSE FALSE FALSE FALSE 40 692 7.25 TRUE)
#ASSERT NOT (`Must I meet the SNAP work requirements` 35 TRUE FALSE TRUE FALSE FALSE 0 0 7.25 FALSE)
-- Time limit: both are parents with a child under 14 ((o)(3)(C)).
#ASSERT `Does the time limit stop me getting SNAP` 35 FALSE TRUE FALSE TRUE FALSE FALSE 0 0 7.25 FALSE FALSE FALSE FALSE FALSE 3 EQUALS `the time limit does not apply to me: an exception in s 2015(o)(3) applies`
-- When the children are 14 and older, a parent who is not working, not exempt, with 3 months used: the time limit bites.
#ASSERT `Does the time limit stop me getting SNAP` 35 FALSE FALSE FALSE FALSE FALSE FALSE 0 0 7.25 FALSE FALSE FALSE FALSE FALSE 3 EQUALS `I am not eligible: I have had 3 months in the 36-month period without meeting the work requirement (s 2015(o)(2))`

-- =====================================================================================================================
-- Other households (s 2012(m)). HYPOTHETICAL.
-- =====================================================================================================================
-- An adult of 25 living with her parents, buying and cooking separately: her own household ((m)(2) reaches children
-- 21 or younger only).
#ASSERT `Who is my SNAP household` `1 Nov 2026` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 0 0 EQUALS `a household of my own (s 2012(m)(1)(A))`
-- A 20-year-old in the same position: one household with the parents.
#ASSERT `Who is my SNAP household` `1 Nov 2026` FALSE TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE 0 0 EQUALS `one household with my spouse, parent or child, or the adult whose parental control I am under, even if we buy and cook separately (s 2012(m)(2))`
-- Housemates who buy and cook together: one household under (m)(1)(B).
#ASSERT `Who is my SNAP household` `1 Nov 2026` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 0 0 EQUALS `one household with the people I buy food and prepare meals with (s 2012(m)(1)(B))`
-- (m)(3): a widow of 75 who cannot shop or cook because of a certified permanent disability lives with her daughter's
-- family of three, whose income is $3,000 a month: within 165% for 3 ($3,757): a separate household.
#ASSERT `Who is my SNAP household` `1 Nov 2026` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE 3000 3 EQUALS `a separate household of my own, together with my spouse if any (s 2012(m)(3))`
-- ... with $3,800 (over $3,757), and buying food with them: one household under (m)(1)(B).
#ASSERT `Who is my SNAP household` `1 Nov 2026` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE 3800 3 EQUALS `one household with the people I buy food and prepare meals with (s 2012(m)(1)(B))`
-- ... asked for a day with no deposited figures: not covered.
#ASSERT `Who is my SNAP household` `1 Oct 2027` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE 3000 3 EQUALS `not covered: the (m)(3) poverty line is not in a deposited publication for that day`
-- (m)(4): a boarding house resident, or a lodger who pays for meals: no household. (m)(5): a battered women's shelter
-- is not an institution.
#ASSERT `Who is my SNAP household` `1 Nov 2026` FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE 0 0 EQUALS `not a household: I live in an institution or boarding house, or pay the people I live with for meals (s 2012(m)(4))`
#ASSERT `Who is my SNAP household` `1 Nov 2026` FALSE TRUE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE 0 0 EQUALS `not a household: I live in an institution or boarding house, or pay the people I live with for meals (s 2012(m)(4))`
#ASSERT `Who is my SNAP household` `1 Nov 2026` FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE 0 0 EQUALS `a household of my own: the facility I live in is not an institution for SNAP (s 2012(m)(5))`

-- Sizes beyond the table rows. Maximum allotment for 10: 1841 + 2 x 225 = 2291; for 20: the 18+ figure 3887.
#ASSERT `the maximum allotment for` 10 `under` `FY 2027 figures` EQUALS 2291
#ASSERT `the maximum allotment for` 20 `under` `FY 2027 figures` EQUALS 3887
-- Net income limit for 9: 4644 + 474 = 5118. Standard deduction for 7: the 6+ figure 308.
#ASSERT `the limit for size` 9 `from` (`FY 2027 figures`'s `net income limits for 1 to 8 members`) `and` (`FY 2027 figures`'s `net income limit for each additional member`) EQUALS 5118
#ASSERT `the standard deduction for` 7 `under` `FY 2027 figures` EQUALS 308

-- =====================================================================================================================
-- Applying and recertifying (s 2020(e)(4)). HYPOTHETICAL dates in FY 2027.
-- =====================================================================================================================
-- Certification ends 31 March 2027; filed 10 March (on or before 16 March, 15 days before); last allotment 3 March:
-- the next allotment must arrive by 3 April 2027.
#ASSERT `By when must our renewed SNAP arrive` (DATE_FROM_DMY 10 3 2027) (DATE_FROM_DMY 31 3 2027) (DATE_FROM_DMY 3 3 2027) EQUALS `if we are still eligible, our next allotment must arrive no later than` (DATE_FROM_DMY 3 4 2027)
-- Filed 16 March, exactly 15 days before: still in time.
#ASSERT `By when must our renewed SNAP arrive` (DATE_FROM_DMY 16 3 2027) (DATE_FROM_DMY 31 3 2027) (DATE_FROM_DMY 3 3 2027) EQUALS `if we are still eligible, our next allotment must arrive no later than` (DATE_FROM_DMY 3 4 2027)
-- Filed 20 March: s 2020(e)(4) sets no date.
#ASSERT `By when must our renewed SNAP arrive` (DATE_FROM_DMY 20 3 2027) (DATE_FROM_DMY 31 3 2027) (DATE_FROM_DMY 3 3 2027) EQUALS `s 2020(e)(4) sets no date: we applied later than 15 days before our certification period ends`
-- One month after 31 January 2027 is read as 28 February 2027.
#ASSERT `By when must our renewed SNAP arrive` (DATE_FROM_DMY 1 2 2027) (DATE_FROM_DMY 28 2 2027) (DATE_FROM_DMY 31 1 2027) EQUALS `if we are still eligible, our next allotment must arrive no later than` (DATE_FROM_DMY 28 2 2027)
-- The notice of expiration must come before the last month (March) starts: by 28 February 2027.
#ASSERT `By when must we get our expiry notice` (DATE_FROM_DMY 31 3 2027) EQUALS DATE_FROM_DMY 28 2 2027

-- =====================================================================================================================
-- Regulative rules (snap-core.l4). Day 0 is the day the rule starts.
-- =====================================================================================================================
-- s 2020(e)(2)(B)(iii): Alex walks in on day 0 and is let apply that day: fulfilled.
#ASSERT EVALTRACE `s 2020(e)(2)(B)(iii) -- the State agency must let the household apply on the day it first comes in` 0 (LIST (EVENT `the State agency` `let the household apply that day` 0)) EQUALS FULFILLED
-- expect: BREACH BY the State agency, "s 2020(e)(2)(B)(iii): ..." (told to come back the next day)
#TRACE `s 2020(e)(2)(B)(iii) -- the State agency must let the household apply on the day it first comes in` AT 0 WITH
    PARTY `the State agency` DOES `let the household apply that day` AT 1

-- s 2020(e)(3): the family of four (eligible, not expedited): the statement on day 0, benefits on day 25: fulfilled.
#ASSERT EVALTRACE (`s 2020(e)(3), (9) -- the State agency must explain the application and, if the household is eligible, provide benefits within 30 days, or 7 if expedited` TRUE FALSE) 0 (LIST (EVENT `the State agency` `give the household a written statement of what it must do to complete the application` 0), (EVENT `the State agency` `certify the household and provide its allotment` 25)) EQUALS FULFILLED
-- Day 30 exactly is in time ("not later than thirty days").
#ASSERT EVALTRACE (`s 2020(e)(3), (9) -- the State agency must explain the application and, if the household is eligible, provide benefits within 30 days, or 7 if expedited` TRUE FALSE) 0 (LIST (EVENT `the State agency` `give the household a written statement of what it must do to complete the application` 0), (EVENT `the State agency` `certify the household and provide its allotment` 30)) EQUALS FULFILLED
-- expect: BREACH BY the State agency, "s 2020(e)(3), (9): ..." (benefits only on day 31)
#TRACE `s 2020(e)(3), (9) -- the State agency must explain the application and, if the household is eligible, provide benefits within 30 days, or 7 if expedited` TRUE FALSE AT 0 WITH
    PARTY `the State agency` DOES `give the household a written statement of what it must do to complete the application` AT 0
    PARTY `the State agency` DOES `certify the household and provide its allotment` AT 31
-- Alex out of work (expedited): benefits on day 7: fulfilled.
#ASSERT EVALTRACE (`s 2020(e)(3), (9) -- the State agency must explain the application and, if the household is eligible, provide benefits within 30 days, or 7 if expedited` TRUE TRUE) 0 (LIST (EVENT `the State agency` `give the household a written statement of what it must do to complete the application` 0), (EVENT `the State agency` `certify the household and provide its allotment` 7)) EQUALS FULFILLED
-- expect: BREACH BY the State agency, "s 2020(e)(3), (9): ..." (expedited, benefits only on day 8)
#TRACE `s 2020(e)(3), (9) -- the State agency must explain the application and, if the household is eligible, provide benefits within 30 days, or 7 if expedited` TRUE TRUE AT 0 WITH
    PARTY `the State agency` DOES `give the household a written statement of what it must do to complete the application` AT 0
    PARTY `the State agency` DOES `certify the household and provide its allotment` AT 8
-- A household that turns out not to be eligible is owed the written statement only.
#ASSERT EVALTRACE (`s 2020(e)(3), (9) -- the State agency must explain the application and, if the household is eligible, provide benefits within 30 days, or 7 if expedited` FALSE FALSE) 0 (LIST (EVENT `the State agency` `give the household a written statement of what it must do to complete the application` 0)) EQUALS FULFILLED

-- s 2020(e)(4) notice of expiration: 30 days from day 0 to the start of the last month; sent on day 20: fulfilled.
#ASSERT EVALTRACE (`s 2020(e)(4) -- the State agency must send a notice of expiration before the last month of certification` 30) 0 (LIST (EVENT `the State agency` `send the household a notice of expiration of its certification` 20)) EQUALS FULFILLED
-- expect: BREACH BY the State agency, "s 2020(e)(4): the household must receive a notice of expiration ..." (sent on day 30, the first day of the last month)
#TRACE `s 2020(e)(4) -- the State agency must send a notice of expiration before the last month of certification` 30 AT 0 WITH
    PARTY `the State agency` DOES `send the household a notice of expiration of its certification` AT 30
-- After a timely recertification filed 10 March with the last allotment on 3 March: 24 days to 3 April. Paid day 24.
#ASSERT EVALTRACE (`s 2020(e)(4) -- after a timely recertification, the next allotment must come within one month of the last` 24) 0 (LIST (EVENT `the State agency` `provide the first allotment of the new certification period` 24)) EQUALS FULFILLED
-- expect: BREACH BY the State agency, "s 2020(e)(4): a household that applied for recertification ..." (paid on day 25)
#TRACE `s 2020(e)(4) -- after a timely recertification, the next allotment must come within one month of the last` 24 AT 0 WITH
    PARTY `the State agency` DOES `provide the first allotment of the new certification period` AT 25

-- s 2014a: a household that moves out of the State and reports it: fulfilled. One that has not moved owes nothing.
#ASSERT EVALTRACE (`s 2014a -- the household must report that it no longer lives in the State` TRUE) 0 (LIST (EVENT `the household` `report that it no longer lives in the State` 5)) EQUALS FULFILLED
#ASSERT EVALTRACE (`s 2014a -- the household must report that it no longer lives in the State` FALSE) 0 (LIST (EVENT `the household` `report that it no longer lives in the State` 5)) EQUALS FULFILLED
-- expect: the obligation still pending (no period is stated, so it never becomes a breach by time alone)
#TRACE `s 2014a -- the household must report that it no longer lives in the State` TRUE AT 0 WITH
    (WAITUNTIL 400)

-- s 2020(e)(10): HYPOTHETICAL 10 days to ask (regulations), 60 days left in certification. Asked on day 5, no cut
-- before day 65: fulfilled. Not asked at all: fulfilled (asking is a choice).
#ASSERT EVALTRACE (`s 2020(e)(10) -- a timely hearing request keeps benefits going until the decision or the end of certification` 10 60 FALSE) 0 (LIST (EVENT `the household` `request a fair hearing` 5), (WAITUNTIL 70)) EQUALS FULFILLED
#ASSERT EVALTRACE (`s 2020(e)(10) -- a timely hearing request keeps benefits going until the decision or the end of certification` 10 60 FALSE) 0 (LIST (WAITUNTIL 11)) EQUALS FULFILLED
-- The household's own written statement clearly requires the cut: no continuation.
#ASSERT EVALTRACE (`s 2020(e)(10) -- a timely hearing request keeps benefits going until the decision or the end of certification` 10 60 TRUE) 0 (LIST (EVENT `the State agency` `reduce or terminate the household's benefits before the hearing decision` 6)) EQUALS FULFILLED
-- expect: BREACH BY the State agency, "s 2020(e)(10): after a timely request ..." (asked day 5, cut day 20)
#TRACE `s 2020(e)(10) -- a timely hearing request keeps benefits going until the decision or the end of certification` 10 60 FALSE AT 0 WITH
    PARTY `the household` DOES `request a fair hearing` AT 5
    PARTY `the State agency` DOES `reduce or terminate the household's benefits before the hearing decision` AT 20
