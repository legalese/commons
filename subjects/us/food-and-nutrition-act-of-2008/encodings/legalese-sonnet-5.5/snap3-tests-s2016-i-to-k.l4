IMPORT prelude
IMPORT daydate
IMPORT `snap-core`
IMPORT `snap3-s2016-i-to-k`

-- TESTS for section 2016(i) to (k) (snap3-s2016-i-to-k.l4). Every expected value is worked out from the text and written beside the assertion, BEFORE running.

§ `Tests -- the dates`

#ASSERT `s 2016(j)(2) the last day for ensuring interoperability and portability` EQUALS Date 1 10 2002
#ASSERT `s 2016(j)(6)(A)(i) the day after which the first period of costs begins` EQUALS Date 11 2 2000
#ASSERT `s 2016(j)(6)(A)(ii) the day after which the second period of costs begins` EQUALS Date 30 9 2002

§ `Tests -- s 2016(i) State option`

-- (1): arguments are ineligible solely as a result of section 2015(o)(2) or section 1612 or 1613 of title 8, the State agency has the Secretary's approval
#ASSERT `s 2016(i)(1) the State agency may issue benefits under this chapter to the individual` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2016(i)(1) the State agency may issue benefits under this chapter to the individual` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2016(i)(1) the State agency may issue benefits under this chapter to the individual` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2016(i)(1) the State agency may issue benefits under this chapter to the individual` FALSE FALSE EQUALS NOTHING
-- (2)(A): arguments are the value of the benefits, the costs as the Secretary determines them
#ASSERT `s 2016(i)(2)(A) the amount the State agency must pay the Secretary` 100 (JUST 20) EQUALS JUST 120
#ASSERT `s 2016(i)(2)(A) the amount the State agency must pay the Secretary` 0 (JUST 0) EQUALS JUST 0
#ASSERT `s 2016(i)(2)(A) the amount the State agency must pay the Secretary` 100 NOTHING EQUALS NOTHING
-- the day of payment against the day of issue: "Not later than the date the State agency issues benefits"
#ASSERT `s 2016(i)(2)(A) the State agency paid the Secretary in time` (Date 5 3 2026) (Date 5 3 2026) EQUALS JUST TRUE
#ASSERT `s 2016(i)(2)(A) the State agency paid the Secretary in time` (Date 4 3 2026) (Date 5 3 2026) EQUALS JUST TRUE
#ASSERT `s 2016(i)(2)(A) the State agency paid the Secretary in time` (Date 6 3 2026) (Date 5 3 2026) EQUALS JUST FALSE
#ASSERT `s 2016(i)(2)(B) the payment is credited to the supplemental nutrition assistance program appropriation account or the account from which the costs were drawn, as appropriate, for the fiscal year in which the payment is received` TRUE EQUALS JUST TRUE
#ASSERT `s 2016(i)(2)(B) the payment is credited to the supplemental nutrition assistance program appropriation account or the account from which the costs were drawn, as appropriate, for the fiscal year in which the payment is received` FALSE EQUALS NOTHING
-- (3), (4): conditions of eligibility; meeting them does not make the State agency eligible
#ASSERT `s 2016(i)(3) the State agency meets the reporting condition for eligibility to issue benefits under this subsection` TRUE EQUALS NOTHING
#ASSERT `s 2016(i)(3) the State agency meets the reporting condition for eligibility to issue benefits under this subsection` FALSE EQUALS JUST FALSE
#ASSERT `s 2016(i)(4) the State agency meets the plan condition for eligibility to issue benefits under this subsection` TRUE TRUE EQUALS NOTHING
#ASSERT `s 2016(i)(4) the State agency meets the plan condition for eligibility to issue benefits under this subsection` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2016(i)(4) the State agency meets the plan condition for eligibility to issue benefits under this subsection` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2016(i)(4) the State agency meets the plan condition for eligibility to issue benefits under this subsection` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2016(i)(5) a sanction, disqualification, fine, or other penalty prescribed under Federal law applies to the violation` TRUE EQUALS JUST TRUE
#ASSERT `s 2016(i)(5) a sanction, disqualification, fine, or other penalty prescribed under Federal law applies to the violation` FALSE EQUALS NOTHING
#ASSERT `s 2016(i)(6) the cost is eligible for Federal funding under this chapter` TRUE EQUALS JUST FALSE
#ASSERT `s 2016(i)(6) the cost is eligible for Federal funding under this chapter` FALSE EQUALS NOTHING
#ASSERT `s 2016(i)(7) section 2025(c) applies to the benefit` TRUE EQUALS JUST FALSE
#ASSERT `s 2016(i)(7) section 2025(c) applies to the benefit` FALSE EQUALS NOTHING

§ `Tests -- s 2016(j)(1) definitions`

#ASSERT `s 2016(j)(1)(A) the card is an electronic benefit transfer card` TRUE EQUALS JUST TRUE
#ASSERT `s 2016(j)(1)(A) the card is an electronic benefit transfer card` FALSE EQUALS JUST FALSE
#ASSERT `s 2016(j)(1)(B) the contract is an electronic benefit transfer contract` TRUE EQUALS JUST TRUE
#ASSERT `s 2016(j)(1)(B) the contract is an electronic benefit transfer contract` FALSE EQUALS JUST FALSE
#ASSERT `s 2016(j)(1)(C) the system provides interoperability` TRUE EQUALS JUST TRUE
#ASSERT `s 2016(j)(1)(C) the system provides interoperability` FALSE EQUALS JUST FALSE
-- (D): arguments are initiated in 1 State, initiated by the use of a card, the card is issued in another State
#ASSERT `s 2016(j)(1)(D) the transaction is an interstate transaction` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2016(j)(1)(D) the transaction is an interstate transaction` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2016(j)(1)(D) the transaction is an interstate transaction` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2016(j)(1)(D) the transaction is an interstate transaction` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2016(j)(1)(E) the system provides portability` TRUE EQUALS JUST TRUE
#ASSERT `s 2016(j)(1)(E) the system provides portability` FALSE EQUALS JUST FALSE
-- (F): arguments are the movement is from an issuer in 1 State to a store in another, it accomplishes an interstate transaction
#ASSERT `s 2016(j)(1)(F) the movement is settling` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2016(j)(1)(F) the movement is settling` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2016(j)(1)(F) the movement is settling` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2016(j)(1)(G) the card is a smart card` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2016(j)(1)(G) the card is a smart card` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2016(j)(1)(G) the card is a smart card` NOTHING EQUALS NOTHING
#ASSERT `s 2016(j)(1)(H) the routing is switching` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2016(j)(1)(H) the routing is switching` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2016(j)(1)(H) the routing is switching` TRUE FALSE EQUALS JUST FALSE

§ `Tests -- s 2016(j)(2) to (6)`

-- (2): the date the Secretary ensured it; 1 October 2002 itself is in time
#ASSERT `s 2016(j)(2) the Secretary ensured interoperability and portability in time` NOTHING EQUALS NOTHING
#ASSERT `s 2016(j)(2) the Secretary ensured interoperability and portability in time` (JUST (Date 30 9 2002)) EQUALS JUST TRUE
#ASSERT `s 2016(j)(2) the Secretary ensured interoperability and portability in time` (JUST (Date 1 10 2002)) EQUALS JUST TRUE
#ASSERT `s 2016(j)(2) the Secretary ensured interoperability and portability in time` (JUST (Date 2 10 2002)) EQUALS JUST FALSE
#ASSERT `s 2016(j)(3) the cost of achieving the interoperability and portability may be imposed on the retail store or wholesale food concern` TRUE EQUALS JUST FALSE
#ASSERT `s 2016(j)(3) the cost of achieving the interoperability and portability may be imposed on the retail store or wholesale food concern` FALSE EQUALS NOTHING
-- (5)(A): arguments are the date the contract is entered into, the date the regulations are promulgated, the date the contract expires, the transfer is before expiration. The regulations are promulgated 1 September 2000, so 30 days later is 1 October 2000.
#ASSERT `s 2016(j)(5)(A) the requirements of paragraph (2) apply to the transfer of benefits under the electronic benefit transfer contract` (Date 30 9 2000) (Date 1 9 2000) (Date 2 10 2002) TRUE EQUALS JUST FALSE
#ASSERT `s 2016(j)(5)(A) the requirements of paragraph (2) apply to the transfer of benefits under the electronic benefit transfer contract` (Date 1 10 2000) (Date 1 9 2000) (Date 2 10 2002) TRUE EQUALS NOTHING
#ASSERT `s 2016(j)(5)(A) the requirements of paragraph (2) apply to the transfer of benefits under the electronic benefit transfer contract` (Date 30 9 2000) (Date 1 9 2000) (Date 1 10 2002) TRUE EQUALS NOTHING
#ASSERT `s 2016(j)(5)(A) the requirements of paragraph (2) apply to the transfer of benefits under the electronic benefit transfer contract` (Date 30 9 2000) (Date 1 9 2000) (Date 2 10 2002) FALSE EQUALS NOTHING
-- (5)(B): arguments are the State agency requests it, the waivers already provided, barriers established to the Secretary's satisfaction, best interest demonstrated, a date specified
#ASSERT `s 2016(j)(5)(B) the Secretary may provide the waiver` FALSE 0 (JUST TRUE) (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `s 2016(j)(5)(B) the Secretary may provide the waiver` TRUE 1 (JUST TRUE) (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 2016(j)(5)(B) the Secretary may provide the waiver` TRUE 0 (JUST TRUE) (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 2016(j)(5)(B) the Secretary may provide the waiver` TRUE 0 NOTHING (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `s 2016(j)(5)(B) the Secretary may provide the waiver` TRUE 0 (JUST FALSE) (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 2016(j)(5)(B) the Secretary may provide the waiver` TRUE 0 (JUST TRUE) (JUST TRUE) FALSE EQUALS JUST FALSE
-- the waiver period ends on or before the date specified
#ASSERT `s 2016(j)(5)(B) the waiver period is within the limit` (Date 1 6 2002) (Date 1 10 2002) EQUALS JUST TRUE
#ASSERT `s 2016(j)(5)(B) the waiver period is within the limit` (Date 1 10 2002) (Date 1 10 2002) EQUALS JUST TRUE
#ASSERT `s 2016(j)(5)(B) the waiver period is within the limit` (Date 2 10 2002) (Date 1 10 2002) EQUALS JUST FALSE
#ASSERT `s 2016(j)(5)(C) the Secretary must allow the State agency to comply with paragraph (2) at the later time` TRUE EQUALS JUST TRUE
#ASSERT `s 2016(j)(5)(C) the Secretary must allow the State agency to comply with paragraph (2) at the later time` FALSE EQUALS NOTHING
-- (6)(A): arguments are the date the cost was incurred, switching and settling interstate transactions, the majority standard is used, the uniform national standard is used
#ASSERT `s 2016(j)(6)(A) the Secretary must pay 100 percent of the cost` (Date 11 2 2000) TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 2016(j)(6)(A) the Secretary must pay 100 percent of the cost` (Date 12 2 2000) TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2016(j)(6)(A) the Secretary must pay 100 percent of the cost` (Date 12 2 2000) TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2016(j)(6)(A) the Secretary must pay 100 percent of the cost` (Date 30 9 2002) TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2016(j)(6)(A) the Secretary must pay 100 percent of the cost` (Date 1 10 2002) TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 2016(j)(6)(A) the Secretary must pay 100 percent of the cost` (Date 1 10 2002) TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2016(j)(6)(A) the Secretary must pay 100 percent of the cost` (Date 1 1 2000) TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 2016(j)(6)(A) the Secretary must pay 100 percent of the cost` (Date 12 2 2000) FALSE TRUE TRUE EQUALS NOTHING
-- (6)(B): $500,000 exactly is within the limit
#ASSERT `s 2016(j)(6)(B) the total amount paid is within the limit` 0 EQUALS JUST TRUE
#ASSERT `s 2016(j)(6)(B) the total amount paid is within the limit` 500000 EQUALS JUST TRUE
#ASSERT `s 2016(j)(6)(B) the total amount paid is within the limit` 500000.01 EQUALS JUST FALSE

§ `Tests -- s 2016(k) on-line transactions`

-- (1): arguments are the paragraph (2) answer, paragraph (4) permits approval
#ASSERT `s 2016(k)(1) the Secretary must approve the retail food store to accept benefits through on-line transactions` (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 2016(k)(1) the Secretary must approve the retail food store to accept benefits through on-line transactions` (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 2016(k)(1) the Secretary must approve the retail food store to accept benefits through on-line transactions` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 2016(k)(1) the Secretary must approve the retail food store to accept benefits through on-line transactions` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 2016(k)(1) the Secretary must approve the retail food store to accept benefits through on-line transactions` NOTHING TRUE EQUALS NOTHING
-- (2): arguments are limbs (A), (B), (C)(i), (C)(ii), (D), (E)
#ASSERT `s 2016(k)(2) the retail food store meets the requirements of paragraph (2)` TRUE TRUE TRUE TRUE (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2016(k)(2) the retail food store meets the requirements of paragraph (2)` TRUE FALSE TRUE TRUE (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 2016(k)(2) the retail food store meets the requirements of paragraph (2)` TRUE TRUE FALSE TRUE (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 2016(k)(2) the retail food store meets the requirements of paragraph (2)` TRUE TRUE TRUE FALSE (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 2016(k)(2) the retail food store meets the requirements of paragraph (2)` TRUE TRUE TRUE TRUE NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 2016(k)(2) the retail food store meets the requirements of paragraph (2)` TRUE TRUE TRUE TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2016(k)(2)(B) the benefits may be used to pay the charge` TRUE EQUALS JUST FALSE
#ASSERT `s 2016(k)(2)(B) the benefits may be used to pay the charge` FALSE EQUALS NOTHING
#ASSERT `s 2016(k)(3) the State agency has done what the paragraph requires` TRUE EQUALS JUST TRUE
#ASSERT `s 2016(k)(3) the State agency has done what the paragraph requires` FALSE EQUALS NOTHING
-- (4)(A): arguments are the Secretary has authorized implementation in all States, has carried out demonstration projects
#ASSERT `s 2016(k)(4)(A) the Secretary carried out the demonstration projects before authorizing implementation in all States` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2016(k)(4)(A) the Secretary carried out the demonstration projects before authorizing implementation in all States` FALSE FALSE EQUALS NOTHING
#ASSERT `s 2016(k)(4)(A) the Secretary carried out the demonstration projects before authorizing implementation in all States` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2016(k)(4)(A) the Secretary carried out the demonstration projects before authorizing implementation in all States` TRUE FALSE EQUALS JUST FALSE
-- (4)(B): arguments are items (i) to (vi)
#ASSERT `s 2016(k)(4)(B) the plan includes what the subparagraph requires` TRUE TRUE TRUE TRUE (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2016(k)(4)(B) the plan includes what the subparagraph requires` TRUE TRUE TRUE FALSE NOTHING NOTHING EQUALS JUST FALSE
#ASSERT `s 2016(k)(4)(B) the plan includes what the subparagraph requires` TRUE TRUE TRUE TRUE NOTHING (JUST TRUE) EQUALS NOTHING
