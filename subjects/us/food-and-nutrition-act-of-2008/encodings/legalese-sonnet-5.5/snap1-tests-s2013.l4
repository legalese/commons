IMPORT prelude
IMPORT daydate
IMPORT `snap-core`
IMPORT `snap1-logic`
IMPORT `snap1-s2013`

-- Tests for 7 U.S.C. 2013. Expected values are written from the text before the code was run.

§ `s 2013(a)(1) tests`

-- Arguments: funds are available, the State agency has requested the program, the household is eligible, the Secretary determines that sales taxes are collected.
#ASSERT `s 2013(a)(1) the eligible household is provided an opportunity to obtain a more nutritious diet through the issuance of an allotment` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2013(a)(1) the eligible household is provided an opportunity to obtain a more nutritious diet through the issuance of an allotment` TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2013(a)(1) the eligible household is provided an opportunity to obtain a more nutritious diet through the issuance of an allotment` FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2013(a)(1) the eligible household is provided an opportunity to obtain a more nutritious diet through the issuance of an allotment` FALSE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 2013(a)(1) the eligible household is provided an opportunity to obtain a more nutritious diet through the issuance of an allotment` TRUE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 2013(a)(1) the eligible household is provided an opportunity to obtain a more nutritious diet through the issuance of an allotment` TRUE TRUE FALSE FALSE EQUALS NOTHING
-- "only": a purchase of something other than food, or from a store that is not approved, is outside; inside, the sentence does not itself allow it
#ASSERT `s 2013(a)(1) the benefits may be used for the purchase` TRUE TRUE EQUALS NOTHING
#ASSERT `s 2013(a)(1) the benefits may be used for the purchase` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2013(a)(1) the benefits may be used for the purchase` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2013(a)(1) the benefits may be used for the purchase` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2013(a)(1) the benefits are redeemable at face value by the Secretary through the facilities of the Treasury` TRUE EQUALS JUST TRUE
#ASSERT `s 2013(a)(1) the benefits are redeemable at face value by the Secretary through the facilities of the Treasury` FALSE EQUALS NOTHING

§ `s 2013(a)(2) tests`

`s 2013 test rate 2025` MEANS `s 2013(a)(2) payment error rate of a year` WITH
    `s 2013(a)(2) the fiscal year` IS 2025
    `s 2013(a)(2) the payment error rate, in percent` IS 7.5
`s 2013 test rate 2026` MEANS `s 2013(a)(2) payment error rate of a year` WITH
    `s 2013(a)(2) the fiscal year` IS 2026
    `s 2013(a)(2) the payment error rate, in percent` IS 9
`s 2013 test rate 2027` MEANS `s 2013(a)(2) payment error rate of a year` WITH
    `s 2013(a)(2) the fiscal year` IS 2027
    `s 2013(a)(2) the payment error rate, in percent` IS 5
`s 2013 test rate 2028` MEANS `s 2013(a)(2) payment error rate of a year` WITH
    `s 2013(a)(2) the fiscal year` IS 2028
    `s 2013(a)(2) the payment error rate, in percent` IS 4
`s 2013 test rates` MEANS LIST `s 2013 test rate 2025`, `s 2013 test rate 2026`, `s 2013 test rate 2027`, `s 2013 test rate 2028`

#ASSERT `s 2013(a)(2)(A) the payment error rate of the State for the fiscal year` `s 2013 test rates` 2025 EQUALS JUST 7.5
#ASSERT `s 2013(a)(2)(A) the payment error rate of the State for the fiscal year` `s 2013 test rates` 2028 EQUALS JUST 4
#ASSERT `s 2013(a)(2)(A) the payment error rate of the State for the fiscal year` `s 2013 test rates` 2030 EQUALS NOTHING
#ASSERT `s 2013(a)(2)(A) the payment error rate of the State for the fiscal year` EMPTY 2025 EQUALS NOTHING
-- (ii)(I): for fiscal year 2028 the State elects 2025 or 2026; (ii)(II): from 2029 the third fiscal year before
#ASSERT `s 2013(a)(2)(B)(ii)(I) the payment error rate the State elects to use for fiscal year 2028` `s 2013 test rates` (JUST 2025) EQUALS JUST 7.5
#ASSERT `s 2013(a)(2)(B)(ii)(I) the payment error rate the State elects to use for fiscal year 2028` `s 2013 test rates` (JUST 2026) EQUALS JUST 9
#ASSERT `s 2013(a)(2)(B)(ii)(I) the payment error rate the State elects to use for fiscal year 2028` `s 2013 test rates` (JUST 2027) EQUALS NOTHING
#ASSERT `s 2013(a)(2)(B)(ii)(I) the payment error rate the State elects to use for fiscal year 2028` `s 2013 test rates` NOTHING EQUALS NOTHING
#ASSERT `s 2013(a)(2)(B)(ii)(I) the payment error rate the State elects to use for fiscal year 2028` EMPTY (JUST 2025) EQUALS NOTHING
#ASSERT `s 2013(a)(2)(B)(ii)(II) the payment error rate the Secretary uses for fiscal year 2029 and each fiscal year thereafter` `s 2013 test rates` 2029 EQUALS JUST 9
#ASSERT `s 2013(a)(2)(B)(ii)(II) the payment error rate the Secretary uses for fiscal year 2029 and each fiscal year thereafter` `s 2013 test rates` 2030 EQUALS JUST 5
#ASSERT `s 2013(a)(2)(B)(ii)(II) the payment error rate the Secretary uses for fiscal year 2029 and each fiscal year thereafter` `s 2013 test rates` 2031 EQUALS JUST 4
#ASSERT `s 2013(a)(2)(B)(ii)(II) the payment error rate the Secretary uses for fiscal year 2029 and each fiscal year thereafter` `s 2013 test rates` 2032 EQUALS NOTHING
#ASSERT `s 2013(a)(2)(B)(ii)(II) the payment error rate the Secretary uses for fiscal year 2029 and each fiscal year thereafter` `s 2013 test rates` 2028 EQUALS NOTHING
-- (iii): 1.5 times the rate, equal to or above 20 percent (40/3 times 1.5 is exactly 20)
#ASSERT `s 2013(a)(2)(B)(iii) the payment error rate multiplied by 1.5 is equal to or above 20 percent` (JUST 14) EQUALS JUST TRUE
#ASSERT `s 2013(a)(2)(B)(iii) the payment error rate multiplied by 1.5 is equal to or above 20 percent` (JUST 13) EQUALS JUST FALSE
#ASSERT `s 2013(a)(2)(B)(iii) the payment error rate multiplied by 1.5 is equal to or above 20 percent` (JUST (40 DIVIDED BY 3)) EQUALS JUST TRUE
#ASSERT `s 2013(a)(2)(B)(iii) the payment error rate multiplied by 1.5 is equal to or above 20 percent` NOTHING EQUALS NOTHING
#ASSERT `s 2013(a)(2)(B)(iii) the fiscal year in which the implementation date under clause (i) falls` (JUST 10) (JUST 10) EQUALS JUST 2028
#ASSERT `s 2013(a)(2)(B)(iii) the fiscal year in which the implementation date under clause (i) falls` (JUST 14) (JUST 10) EQUALS JUST 2029
#ASSERT `s 2013(a)(2)(B)(iii) the fiscal year in which the implementation date under clause (i) falls` (JUST 10) (JUST 14) EQUALS JUST 2030
#ASSERT `s 2013(a)(2)(B)(iii) the fiscal year in which the implementation date under clause (i) falls` (JUST 14) (JUST 14) EQUALS NOTHING
#ASSERT `s 2013(a)(2)(B)(iii) the fiscal year in which the implementation date under clause (i) falls` NOTHING (JUST 10) EQUALS NOTHING
#ASSERT `s 2013(a)(2)(B)(iii) the fiscal year in which the implementation date under clause (i) falls` (JUST 10) NOTHING EQUALS NOTHING
#ASSERT `s 2013(a)(2)(B)(iii) the fiscal year in which the implementation date under clause (i) falls` NOTHING (JUST 14) EQUALS NOTHING
#ASSERT `s 2013(a)(2)(B)(iii) the fiscal year in which the implementation date under clause (i) falls` (JUST 14) NOTHING EQUALS NOTHING
#ASSERT `s 2013(a)(2)(B)(iii) the fiscal year in which the implementation date under clause (i) falls` NOTHING NOTHING EQUALS NOTHING
-- (i): the four bands, with both edges of each
#ASSERT (`s 2013(a)(2)(B)(i) the shares for the payment error rate` 0)'s `s 2013(a)(2) the Federal share of the cost of the allotment, in percent` EQUALS 100
#ASSERT (`s 2013(a)(2)(B)(i) the shares for the payment error rate` 5.99)'s `s 2013(a)(2) the Federal share of the cost of the allotment, in percent` EQUALS 100
#ASSERT (`s 2013(a)(2)(B)(i) the shares for the payment error rate` 5.99)'s `s 2013(a)(2) the State share of the cost of the allotment, in percent` EQUALS 0
#ASSERT (`s 2013(a)(2)(B)(i) the shares for the payment error rate` 6)'s `s 2013(a)(2) the Federal share of the cost of the allotment, in percent` EQUALS 95
#ASSERT (`s 2013(a)(2)(B)(i) the shares for the payment error rate` 7.99)'s `s 2013(a)(2) the State share of the cost of the allotment, in percent` EQUALS 5
#ASSERT (`s 2013(a)(2)(B)(i) the shares for the payment error rate` 8)'s `s 2013(a)(2) the Federal share of the cost of the allotment, in percent` EQUALS 90
#ASSERT (`s 2013(a)(2)(B)(i) the shares for the payment error rate` 9.99)'s `s 2013(a)(2) the State share of the cost of the allotment, in percent` EQUALS 10
#ASSERT (`s 2013(a)(2)(B)(i) the shares for the payment error rate` 10)'s `s 2013(a)(2) the Federal share of the cost of the allotment, in percent` EQUALS 85
#ASSERT (`s 2013(a)(2)(B)(i) the shares for the payment error rate` 25)'s `s 2013(a)(2) the State share of the cost of the allotment, in percent` EQUALS 15

GIVEN shares IS A MAYBE `s 2013(a)(2) shares`
GIVETH A MAYBE NUMBER
`s 2013 test the Federal share` MEANS
    CONSIDER shares
        WHEN NOTHING THEN NOTHING
        WHEN JUST x THEN JUST (x's `s 2013(a)(2) the Federal share of the cost of the allotment, in percent`)

#ASSERT `s 2013 test the Federal share` (`s 2013(a)(2)(B)(i) the shares of the cost of the allotment for the State in the fiscal year` 2028 (JUST 2028) (JUST 5)) EQUALS JUST 100
#ASSERT `s 2013 test the Federal share` (`s 2013(a)(2)(B)(i) the shares of the cost of the allotment for the State in the fiscal year` 2027 (JUST 2028) (JUST 5)) EQUALS NOTHING
#ASSERT `s 2013 test the Federal share` (`s 2013(a)(2)(B)(i) the shares of the cost of the allotment for the State in the fiscal year` 2028 (JUST 2029) (JUST 5)) EQUALS NOTHING
#ASSERT `s 2013 test the Federal share` (`s 2013(a)(2)(B)(i) the shares of the cost of the allotment for the State in the fiscal year` 2029 (JUST 2029) (JUST 12)) EQUALS JUST 85
#ASSERT `s 2013 test the Federal share` (`s 2013(a)(2)(B)(i) the shares of the cost of the allotment for the State in the fiscal year` 2030 (JUST 2029) (JUST 7)) EQUALS JUST 95
#ASSERT `s 2013 test the Federal share` (`s 2013(a)(2)(B)(i) the shares of the cost of the allotment for the State in the fiscal year` 2028 NOTHING (JUST 5)) EQUALS NOTHING
#ASSERT `s 2013 test the Federal share` (`s 2013(a)(2)(B)(i) the shares of the cost of the allotment for the State in the fiscal year` 2028 (JUST 2028) NOTHING) EQUALS NOTHING
-- (3): a ceiling at the Federal share of the cost (85 percent of 1,000 is 850)
#ASSERT `s 2013(a)(3) the Secretary may pay the amount towards the cost of the allotment` 900 1000 85 EQUALS JUST FALSE
#ASSERT `s 2013(a)(3) the Secretary may pay the amount towards the cost of the allotment` 851 1000 85 EQUALS JUST FALSE
#ASSERT `s 2013(a)(3) the Secretary may pay the amount towards the cost of the allotment` 850 1000 85 EQUALS NOTHING
#ASSERT `s 2013(a)(3) the Secretary may pay the amount towards the cost of the allotment` 0 1000 85 EQUALS NOTHING
#ASSERT `s 2013(a)(3) the Secretary may pay the amount towards the cost of the allotment` 1000 1000 100 EQUALS NOTHING
#ASSERT `s 2013(a)(3) the Secretary may pay the amount towards the cost of the allotment` 1001 1000 100 EQUALS JUST FALSE

§ `s 2013(b) tests`

#ASSERT `s 2013(b)(1) the distribution of commodities shall be made` TRUE EQUALS JUST TRUE
#ASSERT `s 2013(b)(1) the distribution of commodities shall be made` FALSE EQUALS JUST FALSE
#ASSERT `s 2013(b)(2)(B) the tribal organization is capable of effectively and efficiently administering the distribution` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2013(b)(2)(B) the tribal organization is capable of effectively and efficiently administering the distribution` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2013(b)(2)(B) the tribal organization is capable of effectively and efficiently administering the distribution` NOTHING EQUALS NOTHING
#ASSERT `s 2013(b)(2) the party that administers the distribution` TRUE (JUST TRUE) EQUALS JUST `a tribal organization`
#ASSERT `s 2013(b)(2) the party that administers the distribution` TRUE (JUST FALSE) EQUALS JUST `the State agency`
#ASSERT `s 2013(b)(2) the party that administers the distribution` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 2013(b)(2) the party that administers the distribution` FALSE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 2013(b)(2)(C) the Secretary may approve the plan` TRUE EQUALS JUST FALSE
#ASSERT `s 2013(b)(2)(C) the Secretary may approve the plan` FALSE EQUALS NOTHING
#ASSERT `s 2013(b)(3) the period for which the individual is not eligible to participate in the supplemental nutrition assistance program` TRUE EQUALS JUST `for a period the Secretary prescribes by regulation, not stated in this text`
#ASSERT `s 2013(b)(3) the period for which the individual is not eligible to participate in the supplemental nutrition assistance program` FALSE EQUALS NOTHING
#ASSERT `s 2013(b)(3) the individual is not eligible to participate in the supplemental nutrition assistance program` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2013(b)(3) the individual is not eligible to participate in the supplemental nutrition assistance program` TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 2013(b)(3) the individual is not eligible to participate in the supplemental nutrition assistance program` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 2013(b)(3) the individual is not eligible to participate in the supplemental nutrition assistance program` FALSE (JUST TRUE) EQUALS NOTHING
-- (4)
#ASSERT `s 2013(b)(4)(A) the least amount the Secretary must pay` 1000 EQUALS 800
#ASSERT `s 2013(b)(4)(A) the least amount the Secretary must pay` 0 EQUALS 0
#ASSERT `s 2013(b)(4)(B) the Secretary must waive the non-Federal share of the costs` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2013(b)(4)(B) the Secretary must waive the non-Federal share of the costs` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 2013(b)(4)(B) the Secretary must waive the non-Federal share of the costs` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2013(b)(4)(B) the Secretary must waive the non-Federal share of the costs` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2013(b)(4)(C) the Secretary may reduce the benefits or services to the tribal organization` TRUE EQUALS JUST FALSE
#ASSERT `s 2013(b)(4)(C) the Secretary may reduce the benefits or services to the tribal organization` FALSE EQUALS NOTHING
#ASSERT `s 2013(b)(4)(D) the Secretary may allow the tribal organization to use the funds to satisfy the non-Federal share` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2013(b)(4)(D) the Secretary may allow the tribal organization to use the funds to satisfy the non-Federal share` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2013(b)(4)(D) the Secretary may allow the tribal organization to use the funds to satisfy the non-Federal share` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2013(b)(4)(D) the Secretary may allow the tribal organization to use the funds to satisfy the non-Federal share` FALSE FALSE EQUALS NOTHING
-- (5) to (7)
#ASSERT `s 2013(b)(5) the Secretary may purchase the bison meat` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2013(b)(5) the Secretary may purchase the bison meat` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2013(b)(5) the Secretary may purchase the bison meat` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2013(b)(6)(A) the Secretary must establish the fund` TRUE EQUALS JUST TRUE
#ASSERT `s 2013(b)(6)(A) the Secretary must establish the fund` FALSE EQUALS NOTHING
#ASSERT `s 2013(b)(6)(B) the food provided meets the requirement for Native American producers` TRUE 50 EQUALS JUST TRUE
#ASSERT `s 2013(b)(6)(B) the food provided meets the requirement for Native American producers` TRUE 100 EQUALS JUST TRUE
#ASSERT `s 2013(b)(6)(B) the food provided meets the requirement for Native American producers` TRUE 49.99 EQUALS JUST FALSE
#ASSERT `s 2013(b)(6)(B) the food provided meets the requirement for Native American producers` TRUE 0 EQUALS JUST FALSE
#ASSERT `s 2013(b)(6)(B) the food provided meets the requirement for Native American producers` FALSE 10 EQUALS NOTHING
#ASSERT `s 2013(b)(6)(D) the Secretary must purchase or offer to purchase the food` TRUE EQUALS JUST TRUE
#ASSERT `s 2013(b)(6)(D) the Secretary must purchase or offer to purchase the food` FALSE EQUALS NOTHING
#ASSERT `s 2013(b)(6)(E) the amount authorized to be appropriated for the fiscal year` 2008 EQUALS JUST 5000000
#ASSERT `s 2013(b)(6)(E) the amount authorized to be appropriated for the fiscal year` 2023 EQUALS JUST 5000000
#ASSERT `s 2013(b)(6)(E) the amount authorized to be appropriated for the fiscal year` 2007 EQUALS NOTHING
#ASSERT `s 2013(b)(6)(E) the amount authorized to be appropriated for the fiscal year` 2024 EQUALS NOTHING
#ASSERT `s 2013(b)(7)(A) the last fiscal year in which the funds remain available for obligation` 2027 EQUALS 2028
#ASSERT `s 2013(b)(7)(B) the last fiscal year in which the funds for administrative costs remain available for obligation` 2027 EQUALS 2028
