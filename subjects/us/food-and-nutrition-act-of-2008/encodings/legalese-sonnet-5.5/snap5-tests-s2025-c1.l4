IMPORT prelude
IMPORT daydate
IMPORT `snap5-s2025-c1`

-- TESTS for snap5-s2025-c1.l4 (section 2025(c)(1)). Expected values written from the text before the file was run.

§ `s 2025(c)(1)(A) the system`

#ASSERT `s 2025(c)(1)(A)(i) the Secretary's quality control system is the system required` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2025(c)(1)(A)(i) the Secretary's quality control system is the system required` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2025(c)(1)(A)(i) the Secretary's quality control system is the system required` TRUE FALSE EQUALS JUST FALSE
-- fiscal year 2014: "an amount not greater than $37"; edge
#ASSERT `s 2025(c)(1)(A)(ii)(I) the tolerance level set is within the limit` 2014 37 EQUALS JUST TRUE
#ASSERT `s 2025(c)(1)(A)(ii)(I) the tolerance level set is within the limit` 2014 37.01 EQUALS JUST FALSE
#ASSERT `s 2025(c)(1)(A)(ii)(I) the tolerance level set is within the limit` 2014 0 EQUALS JUST TRUE
#ASSERT `s 2025(c)(1)(A)(ii)(I) the tolerance level set is within the limit` 2015 37 EQUALS NOTHING
#ASSERT `s 2025(c)(1)(A)(ii)(I) the tolerance level set is within the limit` 2013 37 EQUALS NOTHING
-- each year after: $37 adjusted by the percentage; 37 TIMES 1.10 is 40.7; 30 TIMES 1.10 is 33
#ASSERT `s 2025(c)(1)(A)(ii)(II) the tolerance level for the fiscal year` 2015 37 0.10 EQUALS JUST 40.7
#ASSERT `s 2025(c)(1)(A)(ii)(II) the tolerance level for the fiscal year` 2020 37 0 EQUALS JUST 37
#ASSERT `s 2025(c)(1)(A)(ii)(II) the tolerance level for the fiscal year` 2016 30 0.10 EQUALS JUST 33
#ASSERT `s 2025(c)(1)(A)(ii)(II) the tolerance level for the fiscal year` 2014 37 0.10 EQUALS NOTHING
#ASSERT `s 2025(c)(1)(A)(ii)(II) the tolerance level for the fiscal year` 2015 38 0.10 EQUALS NOTHING

§ `s 2025(c)(1)(B) system integrity`

-- 20 December 2018 plus 180 days: 11 to 31 December, 42 to 31 January, 70 to 28 February, 101 to 31 March, 131 to 30 April, 162 to 31 May, 180 to 18 June 2019
#ASSERT `s 2025(c)(1)(B)(i) the last day for the interim final regulations` EQUALS Date 18 6 2019
#ASSERT `s 2025(c)(1)(B)(i) the interim final regulations are issued in time` (Date 18 6 2019) EQUALS JUST TRUE
#ASSERT `s 2025(c)(1)(B)(i) the interim final regulations are issued in time` (Date 19 6 2019) EQUALS JUST FALSE
#ASSERT `s 2025(c)(1)(B)(i) the interim final regulations are issued in time` (Date 1 1 2019) EQUALS JUST TRUE
-- the content: edge on "not fewer than 2 State agencies"
#ASSERT `s 2025(c)(1)(B)(i) the interim final regulations have the content required` TRUE TRUE TRUE 2 EQUALS JUST TRUE
#ASSERT `s 2025(c)(1)(B)(i) the interim final regulations have the content required` TRUE TRUE TRUE 1 EQUALS JUST FALSE
#ASSERT `s 2025(c)(1)(B)(i) the interim final regulations have the content required` FALSE TRUE TRUE 5 EQUALS JUST FALSE
#ASSERT `s 2025(c)(1)(B)(i) the interim final regulations have the content required` TRUE FALSE TRUE 5 EQUALS JUST FALSE
#ASSERT `s 2025(c)(1)(B)(i) the interim final regulations have the content required` TRUE TRUE FALSE 5 EQUALS JUST FALSE
#ASSERT `s 2025(c)(1)(B)(ii) the Secretary shall debar the person` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2025(c)(1)(B)(ii) the Secretary shall debar the person` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2025(c)(1)(B)(ii) the Secretary shall debar the person` TRUE FALSE EQUALS NOTHING

§ `s 2025(c)(1)(C) the liability amount`

#ASSERT `s 2025(c)(1)(C) the Secretary shall establish a liability amount for the State agency` 2004 (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2025(c)(1)(C) the Secretary shall establish a liability amount for the State agency` 2010 (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2025(c)(1)(C) the Secretary shall establish a liability amount for the State agency` 2010 (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2025(c)(1)(C) the Secretary shall establish a liability amount for the State agency` 2010 NOTHING EQUALS NOTHING
-- edge: fiscal year 2003 is before "fiscal year 2004" (the heading says 2003; the text governs: finding 2)
#ASSERT `s 2025(c)(1)(C) the Secretary shall establish a liability amount for the State agency` 2003 (JUST TRUE) EQUALS NOTHING
-- 1,000,000,000 TIMES (0.08 MINUS 0.06) TIMES 0.10 is 2,000,000; 500,000,000 TIMES 0.01 TIMES 0.10 is 500,000
#ASSERT `s 2025(c)(1)(C) the liability amount` 1_000_000_000 0.08 EQUALS JUST 2_000_000
#ASSERT `s 2025(c)(1)(C) the liability amount` 500_000_000 0.07 EQUALS JUST 500_000
#ASSERT `s 2025(c)(1)(C) the liability amount` 1_000_000_000 0.06 EQUALS JUST 0
#ASSERT `s 2025(c)(1)(C) the liability amount` 1_000_000_000 0.0599 EQUALS NOTHING

§ `s 2025(c)(1)(D) authority of the Secretary`

-- 50 percent of 1,000 is 500; edge
#ASSERT `s 2025(c)(1)(D)(i)(I) the portion required for new investment is within the limit` 1_000 500 EQUALS JUST TRUE
#ASSERT `s 2025(c)(1)(D)(i)(I) the portion required for new investment is within the limit` 1_000 500.01 EQUALS JUST FALSE
#ASSERT `s 2025(c)(1)(D)(i)(I) the new investment amount may be matched by Federal funds` TRUE EQUALS JUST FALSE
#ASSERT `s 2025(c)(1)(D)(i)(I) the new investment amount may be matched by Federal funds` FALSE EQUALS NOTHING
#ASSERT `s 2025(c)(1)(D)(i)(II) the portion designated as the at-risk amount is within the limit` 1_000 500 EQUALS JUST TRUE
#ASSERT `s 2025(c)(1)(D)(i)(II) the portion designated as the at-risk amount is within the limit` 1_000 500.01 EQUALS JUST FALSE
#ASSERT `s 2025(c)(1)(D)(i)(III) the combination of actions is allowed` 1_000 500 500 EQUALS JUST TRUE
#ASSERT `s 2025(c)(1)(D)(i)(III) the combination of actions is allowed` 1_000 501 500 EQUALS JUST FALSE
#ASSERT `s 2025(c)(1)(D)(i)(III) the combination of actions is allowed` 1_000 500 501 EQUALS JUST FALSE
#ASSERT `s 2025(c)(1)(D)(i)(III) the combination of actions is allowed` 1_000 0 0 EQUALS JUST TRUE
-- the settlement: only a new investment amount, and before the end of the fiscal year; edge on the last day
#ASSERT `s 2025(c)(1)(D)(ii) the settlement with the State agency is permitted` TRUE (Date 30 9 2026) (Date 30 9 2026) EQUALS JUST TRUE
#ASSERT `s 2025(c)(1)(D)(ii) the settlement with the State agency is permitted` TRUE (Date 1 10 2026) (Date 30 9 2026) EQUALS JUST FALSE
#ASSERT `s 2025(c)(1)(D)(ii) the settlement with the State agency is permitted` FALSE (Date 1 9 2026) (Date 30 9 2026) EQUALS JUST FALSE

