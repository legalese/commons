IMPORT prelude
IMPORT daydate
IMPORT `snap1-logic`
IMPORT `snap1-s2014a`

-- Tests for 7 U.S.C. 2014a. Arguments are certified, no longer resides in the State where certified, the date.
#ASSERT `s 2014a the household is required to report that it no longer resides in the State in which it is certified` TRUE TRUE (Date 5 5 2017) EQUALS JUST TRUE
#ASSERT `s 2014a the household is required to report that it no longer resides in the State in which it is certified` TRUE TRUE (Date 4 5 2017) EQUALS NOTHING
#ASSERT `s 2014a the household is required to report that it no longer resides in the State in which it is certified` TRUE TRUE (Date 1 3 2026) EQUALS JUST TRUE
#ASSERT `s 2014a the household is required to report that it no longer resides in the State in which it is certified` TRUE FALSE (Date 1 3 2026) EQUALS JUST FALSE
#ASSERT `s 2014a the household is required to report that it no longer resides in the State in which it is certified` FALSE TRUE (Date 1 3 2026) EQUALS NOTHING
#ASSERT `s 2014a the household is required to report that it no longer resides in the State in which it is certified` FALSE FALSE (Date 1 3 2026) EQUALS NOTHING
#ASSERT `s 2014a the household is required to report that it no longer resides in the State in which it is certified` TRUE FALSE (Date 4 5 2017) EQUALS NOTHING
