#ASSERT `s 2025(e)(2) the account numbers are used in the administration of the program` TRUE EQUALS JUST TRUE
#ASSERT `s 2025(e)(2) the account numbers are used in the administration of the program` FALSE EQUALS JUST FALSE
#ASSERT `s 2025(e) the Secretary and State agencies shall have access to the information` TRUE (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 2025(e) the Secretary and State agencies shall have access to the information` TRUE (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 2025(e) the Secretary and State agencies shall have access to the information` TRUE NOTHING TRUE EQUALS NOTHING
#ASSERT `s 2025(e) the Secretary and State agencies shall have access to the information` TRUE (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 2025(e) the Secretary and State agencies shall have access to the information` FALSE (JUST TRUE) TRUE EQUALS NOTHING

