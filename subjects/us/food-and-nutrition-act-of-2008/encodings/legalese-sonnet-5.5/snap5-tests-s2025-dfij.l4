#ASSERT `s 2025(d)(5) the State agency may use the performance bonus payment for the use` `s 2025(d)(5)(B) improvements in administration and distribution` EQUALS JUST TRUE
#ASSERT `s 2025(d)(5) the State agency may use the performance bonus payment for the use` `s 2025(d)(5)(C) actions to prevent fraud, waste, and abuse` EQUALS JUST TRUE
#ASSERT `s 2025(d)(5) the State agency may use the performance bonus payment for the use` `s 2025(d)(5) another use that carries out the program established under this chapter` EQUALS JUST TRUE
#ASSERT `s 2025(d)(5) the State agency may use the performance bonus payment for the use` `s 2025(d)(5) a use that does not carry out the program established under this chapter` EQUALS JUST FALSE
#ASSERT `s 2025(d)(6)(B) the Secretary may award performance bonus payments` 2019 2018 EQUALS JUST FALSE
#ASSERT `s 2025(d)(6)(B) the Secretary may award performance bonus payments` 2020 2019 EQUALS NOTHING
#ASSERT `s 2025(d)(6)(B) the Secretary may award performance bonus payments` 2019 2019 EQUALS NOTHING
#ASSERT `s 2025(d)(6)(B) the Secretary may award performance bonus payments` 2018 2018 EQUALS NOTHING

§ `s 2025(e) social security account numbers; access to information`

#ASSERT `s 2025(e)(1) the household member has met the condition of eligibility of furnishing a social security account number` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2025(e)(1) the household member has met the condition of eligibility of furnishing a social security account number` TRUE FALSE EQUALS JUST FALSE
