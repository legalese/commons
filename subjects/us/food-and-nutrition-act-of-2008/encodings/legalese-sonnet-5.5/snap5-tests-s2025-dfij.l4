#ASSERT `s 2025(j) the instructional materials are published as required` 0 (Date 19 3 1989) TRUE EQUALS JUST FALSE
#ASSERT `s 2025(j) the instructional materials are published as required` 0 (Date 18 3 1989) FALSE EQUALS JUST FALSE
#ASSERT `s 2025(j) the instructional materials are published as required` 1 (Date 18 3 1990) TRUE EQUALS JUST TRUE
