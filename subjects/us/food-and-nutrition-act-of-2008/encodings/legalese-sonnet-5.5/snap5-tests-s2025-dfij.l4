IMPORT prelude
IMPORT daydate
IMPORT `snap5-s2025-dfij`

-- TESTS for snap5-s2025-dfij.l4 (section 2025(d), (e), (f), (i), (j)). Expected values written from the text before the file was run.

§ `s 2025(d)(1) fiscal years 2003 and 2004`

-- "not later than October 1, 2002"; edge
#ASSERT `s 2025(d)(1)(A) the guidance is issued in time` (Date 1 10 2002) EQUALS JUST TRUE
#ASSERT `s 2025(d)(1)(A) the guidance is issued in time` (Date 30 9 2002) EQUALS JUST TRUE
#ASSERT `s 2025(d)(1)(A) the guidance is issued in time` (Date 2 10 2002) EQUALS JUST FALSE
#ASSERT `s 2025(d)(1)(A) the guidance has the content required` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2025(d)(1)(A) the guidance has the content required` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2025(d)(1)(A) the guidance has the content required` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2025(d)(1)(A) the guidance has the content required` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2025(d)(1)(B)(i) the performance of each State agency has been measured` 2003 TRUE EQUALS JUST TRUE
#ASSERT `s 2025(d)(1)(B)(i) the performance of each State agency has been measured` 2004 FALSE EQUALS JUST FALSE
#ASSERT `s 2025(d)(1)(B)(i) the performance of each State agency has been measured` 2005 TRUE EQUALS NOTHING
#ASSERT `s 2025(d)(1)(B)(i) the performance of each State agency has been measured` 2002 TRUE EQUALS NOTHING
#ASSERT `s 2025(d)(1)(B)(ii) the total amount of performance bonus payments for the fiscal year` 2003 EQUALS JUST 48_000_000
#ASSERT `s 2025(d)(1)(B)(ii) the total amount of performance bonus payments for the fiscal year` 2004 EQUALS JUST 48_000_000
#ASSERT `s 2025(d)(1)(B)(ii) the total amount of performance bonus payments for the fiscal year` 2005 EQUALS NOTHING
#ASSERT `s 2025(d)(1)(B)(ii) the total amount of performance bonus payments for the fiscal year` 2002 EQUALS NOTHING
-- the award: in the following fiscal year, to a State agency that meets the standards, and not barred by paragraph (3)
#ASSERT `s 2025(d)(1)(B)(ii) the State agency shall be awarded a performance bonus payment` 2003 2004 TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 2025(d)(1)(B)(ii) the State agency shall be awarded a performance bonus payment` 2003 2004 TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2025(d)(1)(B)(ii) the State agency shall be awarded a performance bonus payment` 2003 2004 TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2025(d)(1)(B)(ii) the State agency shall be awarded a performance bonus payment` 2003 2005 TRUE NOTHING EQUALS JUST FALSE
#ASSERT `s 2025(d)(1)(B)(ii) the State agency shall be awarded a performance bonus payment` 2003 2004 FALSE NOTHING EQUALS NOTHING
#ASSERT `s 2025(d)(1)(B)(ii) the State agency shall be awarded a performance bonus payment` 2005 2006 TRUE NOTHING EQUALS NOTHING

§ `s 2025(d)(2) fiscal years 2005 through 2017`

-- edge on 2005 and 2017
#ASSERT `s 2025(d)(2)(B)(i) the performance of each State agency has been measured` 2005 TRUE EQUALS JUST TRUE
#ASSERT `s 2025(d)(2)(B)(i) the performance of each State agency has been measured` 2017 FALSE EQUALS JUST FALSE
#ASSERT `s 2025(d)(2)(B)(i) the performance of each State agency has been measured` 2004 TRUE EQUALS NOTHING
#ASSERT `s 2025(d)(2)(B)(i) the performance of each State agency has been measured` 2018 TRUE EQUALS NOTHING
#ASSERT `s 2025(d)(2)(B)(ii) the total amount of performance bonus payments for the fiscal year` 2005 EQUALS JUST 48_000_000
#ASSERT `s 2025(d)(2)(B)(ii) the total amount of performance bonus payments for the fiscal year` 2017 EQUALS JUST 48_000_000
#ASSERT `s 2025(d)(2)(B)(ii) the total amount of performance bonus payments for the fiscal year` 2004 EQUALS NOTHING
#ASSERT `s 2025(d)(2)(B)(ii) the total amount of performance bonus payments for the fiscal year` 2018 EQUALS NOTHING
#ASSERT `s 2025(d)(2)(B)(ii) the State agency shall be awarded a performance bonus payment` 2017 2018 TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 2025(d)(2)(B)(ii) the State agency shall be awarded a performance bonus payment` 2010 2011 TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2025(d)(2)(B)(ii) the State agency shall be awarded a performance bonus payment` 2010 2012 TRUE NOTHING EQUALS JUST FALSE
#ASSERT `s 2025(d)(2)(B)(ii) the State agency shall be awarded a performance bonus payment` 2010 2011 FALSE NOTHING EQUALS NOTHING
#ASSERT `s 2025(d)(2)(B)(ii) the State agency shall be awarded a performance bonus payment` 2018 2019 TRUE NOTHING EQUALS NOTHING

§ `s 2025(d)(3) to (6)`

#ASSERT `s 2025(d)(3) the State agency is eligible for a performance bonus payment for the fiscal year` TRUE EQUALS JUST FALSE
#ASSERT `s 2025(d)(3) the State agency is eligible for a performance bonus payment for the fiscal year` FALSE EQUALS NOTHING
#ASSERT `s 2025(d)(4) the determination is subject to administrative or judicial review` TRUE EQUALS JUST FALSE
#ASSERT `s 2025(d)(4) the determination is subject to administrative or judicial review` FALSE EQUALS NOTHING
