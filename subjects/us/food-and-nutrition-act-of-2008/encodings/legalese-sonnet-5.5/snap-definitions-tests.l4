-- ---------------------------------------------------------------------------------------------------
-- (o) retail food store
-- (1) seller fields: sells food for home preparation and consumption; varieties in meat/poultry/fish, bread/cereals, vegetables/fruits, dairy; categories with perishables; share of sales in staple foods
-- ---------------------------------------------------------------------------------------------------
`a grocery with 7 varieties in each category`  MEANS `s 2012(o)(1) seller` OF TRUE, 7, 7, 7, 7, 3, 0.10
`a grocery with 6 varieties of dairy`          MEANS `s 2012(o)(1) seller` OF TRUE, 7, 7, 7, 6, 3, 0.10
`a grocery with perishables in 2 categories`   MEANS `s 2012(o)(1) seller` OF TRUE, 7, 7, 7, 7, 2, 0.10
`a shop selling 51 percent staple foods`       MEANS `s 2012(o)(1) seller` OF TRUE, 1, 1, 1, 1, 0, 0.51
`a shop selling exactly 50 percent staple foods` MEANS `s 2012(o)(1) seller` OF TRUE, 1, 1, 1, 1, 0, 0.50
`a stall that does not sell food`              MEANS `s 2012(o)(1) seller` OF FALSE, 7, 7, 7, 7, 3, 0.90
#ASSERT `s 2012(o)(1) the seller is a retail food store under paragraph (1)` `a grocery with 7 varieties in each category` EQUALS JUST TRUE  -- (1)(A) "at least 7 foods in each of the 4 categories ... perishable foods in at least 3"
#ASSERT `s 2012(o)(1) the seller is a retail food store under paragraph (1)` `a grocery with 6 varieties of dairy` EQUALS JUST FALSE  -- 6 is under 7 in one category, and the sales test is not met
#ASSERT `s 2012(o)(1) the seller is a retail food store under paragraph (1)` `a grocery with perishables in 2 categories` EQUALS JUST FALSE  -- perishables in only 2 of the categories
#ASSERT `s 2012(o)(1) the seller is a retail food store under paragraph (1)` `a shop selling 51 percent staple foods` EQUALS JUST TRUE  -- (1)(B) "over 50 percent"
#ASSERT `s 2012(o)(1) the seller is a retail food store under paragraph (1)` `a shop selling exactly 50 percent staple foods` EQUALS JUST FALSE  -- exactly 50 is not "over 50 percent"
#ASSERT `s 2012(o)(1) the seller is a retail food store under paragraph (1)` `a stall that does not sell food` EQUALS JUST FALSE  -- (1) opens "an establishment ... that sells food for home preparation and consumption"
-- (5) service fields: a delivery service; buys for and delivers to people who cannot shop and are 60+ or disabled; notifies of any fee; notifies that a fee cannot be paid with benefits; sells at the price paid, no markup
#ASSERT `s 2012(o)(5) the service is a retail food store under paragraph (5)` (`s 2012(o)(5) service` OF TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST TRUE  -- (5)(A), (B) and (C) all met
#ASSERT `s 2012(o)(5) the service is a retail food store under paragraph (5)` (`s 2012(o)(5) service` OF TRUE, TRUE, TRUE, TRUE, FALSE) EQUALS JUST FALSE  -- (5)(C) "without any additional cost markup"
#ASSERT `s 2012(o)(5) the service is a retail food store under paragraph (5)` (`s 2012(o)(5) service` OF TRUE, TRUE, TRUE, FALSE, TRUE) EQUALS JUST FALSE  -- (5)(B)(ii) must tell the household a fee cannot be paid with benefits
#ASSERT `s 2012(o)(5) the service is a retail food store under paragraph (5)` (`s 2012(o)(5) service` OF TRUE, FALSE, TRUE, TRUE, TRUE) EQUALS JUST FALSE  -- (5)(A) serves people who are unable to shop and 60 or older or disabled
-- whole: fields: paragraph (1); (2); (3); (4); paragraph (5)
#ASSERT `s 2012(o) the seller is a retail food store` (JUST TRUE) FALSE FALSE FALSE (JUST FALSE) EQUALS JUST TRUE  -- (1)
#ASSERT `s 2012(o) the seller is a retail food store` (JUST FALSE) TRUE FALSE FALSE (JUST FALSE) EQUALS JUST TRUE  -- (2) a place serving meals under (k)
#ASSERT `s 2012(o) the seller is a retail food store` (JUST FALSE) FALSE TRUE FALSE (JUST FALSE) EQUALS JUST TRUE  -- (3) a store for hunting and fishing equipment
#ASSERT `s 2012(o) the seller is a retail food store` (JUST FALSE) FALSE FALSE TRUE (JUST FALSE) EQUALS JUST TRUE  -- (4) a food cooperative or a farmer selling direct
#ASSERT `s 2012(o) the seller is a retail food store` (JUST FALSE) FALSE FALSE FALSE (JUST TRUE) EQUALS JUST TRUE  -- (5)
#ASSERT `s 2012(o) the seller is a retail food store` (JUST FALSE) FALSE FALSE FALSE (JUST FALSE) EQUALS JUST FALSE  -- none of the five kinds

