#ASSERT `s 2012(s) the body is a State agency` (`s 2012(s) agency` OF TRUE, FALSE, FALSE, NOTHING) EQUALS JUST TRUE  -- (s)(1)
#ASSERT `s 2012(s) the body is a State agency` (`s 2012(s) agency` OF FALSE, TRUE, FALSE, NOTHING) EQUALS JUST TRUE  -- (s)(1) "the counterpart local agencies"
#ASSERT `s 2012(s) the body is a State agency` (`s 2012(s) agency` OF FALSE, FALSE, TRUE, JUST TRUE) EQUALS JUST TRUE  -- (s)(2) determined by the Secretary to be capable
#ASSERT `s 2012(s) the body is a State agency` (`s 2012(s) agency` OF FALSE, FALSE, TRUE, JUST FALSE) EQUALS JUST FALSE  -- (s)(2) the Secretary has made no such determination, or found it not capable
#ASSERT `s 2012(s) the body is a State agency` (`s 2012(s) agency` OF FALSE, FALSE, TRUE, NOTHING) EQUALS NOTHING  -- (s)(2) the caller cannot say whether the Secretary has determined it
#ASSERT `s 2012(s) the body is a State agency` (`s 2012(s) agency` OF FALSE, FALSE, FALSE, NOTHING) EQUALS JUST FALSE  -- neither limb
#ASSERT `s 2012(t) the program is the supplemental nutrition assistance program` TRUE EQUALS JUST TRUE  -- "the program operated pursuant to this chapter"
#ASSERT `s 2012(t) the program is the supplemental nutrition assistance program` FALSE EQUALS JUST FALSE  -- a program not operated under this chapter
-- (v) body fields: the governing body of an Indian tribe; the tribe is an Indian tribe as defined in 25 U.S.C. 5304; holds a treaty with a State government
#ASSERT `s 2012(v) the body is a tribal organization` (`s 2012(v) body` OF TRUE, TRUE, FALSE) EQUALS JUST TRUE  -- "the recognized governing body of an Indian tribe"
#ASSERT `s 2012(v) the body is a tribal organization` (`s 2012(v) body` OF TRUE, FALSE, FALSE) EQUALS JUST FALSE  -- the tribe is not an "Indian tribe" as 25 U.S.C. 5304 defines it
#ASSERT `s 2012(v) the body is a tribal organization` (`s 2012(v) body` OF FALSE, FALSE, TRUE) EQUALS JUST TRUE  -- "as well as any Indian tribe, band, or community holding a treaty with a State government"
#ASSERT `s 2012(v) the body is a tribal organization` (`s 2012(v) body` OF FALSE, FALSE, FALSE) EQUALS JUST FALSE  -- neither limb

-- ---------------------------------------------------------------------------------------------------
-- (u) thrifty food plan
-- (1) plan fields: a diet to feed a family of 4; the family is as stated; uses the 2021 report or a successor; (A) baskets change only per (4); (B) uniform allotments; (C) adjusted only per this subsection
-- ---------------------------------------------------------------------------------------------------
#ASSERT `s 2012(u)(1) the plan is the thrifty food plan` (`s 2012(u)(1) plan` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST TRUE  -- (u)(1) with conditions (A), (B) and (C)
#ASSERT `s 2012(u)(1) the plan is the thrifty food plan` (`s 2012(u)(1) plan` OF TRUE, TRUE, TRUE, TRUE, TRUE, FALSE) EQUALS JUST FALSE  -- condition (C) fails
#ASSERT `s 2012(u)(1) the plan is the thrifty food plan` (`s 2012(u)(1) plan` OF TRUE, FALSE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST FALSE  -- not the reference family of 4
-- (2) ratios: 30, 55, 79, 100, 119, 143, 158, 180 percent for 1 to 8; 9 or more: 180 plus 22 per person over 8, the addition capped at 200
#ASSERT `s 2012(u)(2) the household adjustment ratio` 1 EQUALS JUST 0.30  -- (A) 30 percent
#ASSERT `s 2012(u)(2) the household adjustment ratio` 2 EQUALS JUST 0.55  -- (B)
#ASSERT `s 2012(u)(2) the household adjustment ratio` 3 EQUALS JUST 0.79  -- (C)
#ASSERT `s 2012(u)(2) the household adjustment ratio` 4 EQUALS JUST 1.00  -- (D) 100 percent
#ASSERT `s 2012(u)(2) the household adjustment ratio` 5 EQUALS JUST 1.19  -- (E)
#ASSERT `s 2012(u)(2) the household adjustment ratio` 6 EQUALS JUST 1.43  -- (F)
#ASSERT `s 2012(u)(2) the household adjustment ratio` 7 EQUALS JUST 1.58  -- (G)
#ASSERT `s 2012(u)(2) the household adjustment ratio` 8 EQUALS JUST 1.80  -- (H)
#ASSERT `s 2012(u)(2) the household adjustment ratio` 9 EQUALS JUST 2.02  -- (I) 180 + 22 for the ninth person
#ASSERT `s 2012(u)(2) the household adjustment ratio` 17 EQUALS JUST 3.78  -- (I) 180 + 9 x 22 = 378; the addition is 198, under the cap of 200
#ASSERT `s 2012(u)(2) the household adjustment ratio` 18 EQUALS JUST 3.80  -- (I) the addition would be 220; capped at 200, so 380 (the COLA row 18+ is $3,887 = 3.80 x $1,023)
#ASSERT `s 2012(u)(2) the household adjustment ratio` 40 EQUALS JUST 3.80  -- the cap holds for any larger household
#ASSERT `s 2012(u)(2) the household adjustment ratio` 0 EQUALS NOTHING  -- the Act gives no ratio for a household of no one
-- (3)(A) areas; (3)(B) Guam and the Virgin Islands; (3)(C) the October 1 adjustment
#ASSERT `s 2012(u)(3)(A) the Secretary must make a cost adjustment for the area` Hawaii EQUALS JUST TRUE  -- (3)(A) "Hawaii"
#ASSERT `s 2012(u)(3)(A) the Secretary must make a cost adjustment for the area` `Alaska, urban` EQUALS JUST TRUE  -- (3)(A) "urban and rural parts of Alaska"
#ASSERT `s 2012(u)(3)(A) the Secretary must make a cost adjustment for the area` `Alaska, rural 2` EQUALS JUST TRUE  -- (3)(A) rural Alaska
#ASSERT `s 2012(u)(3)(A) the Secretary must make a cost adjustment for the area` Guam EQUALS NOTHING  -- not (3)(A): Guam is under (3)(B)
#ASSERT `s 2012(u)(3)(A) the Secretary must make a cost adjustment for the area` `the 48 contiguous States and the District of Columbia` EQUALS NOTHING  -- the 48 States and DC are under neither
#ASSERT `s 2012(u)(3)(B) the plan cost for Guam or the Virgin Islands` 1500 1400 EQUALS 1400  -- "not to exceed the cost of food in the 50 States and the District of Columbia"
#ASSERT `s 2012(u)(3)(B) the plan cost for Guam or the Virgin Islands` 1300 1400 EQUALS 1300  -- below the cap: the cost reflecting the cost of food there
#ASSERT `s 2012(u)(3)(B) the plan cost for Guam or the Virgin Islands` 1400 1400 EQUALS 1400  -- equal to the cap: does not exceed it
#ASSERT `s 2012(u)(3)(C) the Secretary must adjust the cost to reflect the Consumer Price Index on the date` (Date 1 10 2025) EQUALS JUST TRUE  -- "on October 1, 2025"
#ASSERT `s 2012(u)(3)(C) the Secretary must adjust the cost to reflect the Consumer Price Index on the date` (Date 1 10 2026) EQUALS JUST TRUE  -- "each October 1 thereafter"
#ASSERT `s 2012(u)(3)(C) the Secretary must adjust the cost to reflect the Consumer Price Index on the date` (Date 1 10 2024) EQUALS NOTHING  -- before October 1, 2025
#ASSERT `s 2012(u)(3)(C) the Secretary must adjust the cost to reflect the Consumer Price Index on the date` (Date 2 10 2026) EQUALS NOTHING  -- not an October 1
-- (4)
#ASSERT `s 2012(u)(4)(A) the Secretary may re-evaluate the market baskets on the date` (Date 1 10 2027) EQUALS JUST TRUE  -- "Not earlier than October 1, 2027": that day is not earlier
#ASSERT `s 2012(u)(4)(A) the Secretary may re-evaluate the market baskets on the date` (Date 30 9 2027) EQUALS NOTHING  -- the day before: the text grants "not earlier than" and says no more
#ASSERT `s 2012(u)(4)(B) the cost after a re-evaluation is allowed` 1000 1001 EQUALS JUST FALSE  -- "shall not increase the cost"
#ASSERT `s 2012(u)(4)(B) the cost after a re-evaluation is allowed` 1000 1000 EQUALS NOTHING  -- no increase: the text does not say that this is permitted
#ASSERT `s 2012(u)(4)(B) the cost after a re-evaluation is allowed` 1000 900 EQUALS NOTHING  -- a decrease: the text is silent

-- ---------------------------------------------------------------------------------------------------
-- The core's nouns can be built and read. Naming every constructor here is the guard against a name that collides with the prelude or
-- daydate: a clash shows only where a name is USED, and the core has no directive of its own.
-- ---------------------------------------------------------------------------------------------------
`all the areas` MEANS LIST `the 48 contiguous States and the District of Columbia`, `Alaska, urban`, `Alaska, rural 1`, `Alaska, rural 2`, Guam, Hawaii, `the Virgin Islands of the United States`
#ASSERT count `all the areas` EQUALS 7  -- the seven columns of the cost-of-living tables (core comment)
`all the kinds of place` MEANS LIST `one of the fifty States`, `the District of Columbia as a place`, `the territory of Guam`, `the territory of the Virgin Islands`, `a reservation of an Indian tribe`, `any other place`
#ASSERT count `all the kinds of place` EQUALS 6  -- the five places s 2012(r) names, plus "any other place"
`all the immigration statuses` MEANS LIST `a citizen or national of the United States`, `an alien lawfully admitted for permanent residence`, `a Cuban or Haitian entrant`, `a resident under a Compact of Free Association`, `any other status`
#ASSERT count `all the immigration statuses` EQUALS 5  -- s 2015(f)(2)(A) to (D), plus "any other status"
`all the parties` MEANS LIST `the household`, `a household member`, `an applicant household`, `the State agency`, `the Secretary`, `a tribal organization`, `a benefit issuer`, `a retail food store`, `a wholesale food concern`, `a sponsor of an alien`, `a court`, `an administrative agency`
#ASSERT count `all the parties` EQUALS 12
`all the kinds of decision` MEANS LIST `certify a household as eligible`, `deny an application`, `terminate a certification`, `reduce an allotment`, `disqualify an individual`, `approve a retail food store or wholesale food concern`, `disqualify a retail food store or wholesale food concern`, `establish a claim for an overissuance`, `grant a waiver`
#ASSERT count `all the kinds of decision` EQUALS 9
`all the periods of ineligibility` MEANS LIST `for a number of days` 180, `for a number of months` 12, `for a number of years` 2, `permanently`, `until a stated condition ends` "the finding is reversed by a court", `for a period the Secretary prescribes by regulation, not stated in this text`, `for a period the State agency determines, not stated in this text`
#ASSERT count `all the periods of ineligibility` EQUALS 7
`all the forms of benefit` MEANS LIST `an electronic benefit transfer under section 2016(h)`, `other means of providing assistance, as determined by the Secretary`
#ASSERT count `all the forms of benefit` EQUALS 2  -- s 2012(d)(1) and (2)

`a household of two` MEANS Household OF (LIST `a 30 year old`, `a 60 year old`), Hawaii, (LIST `Income item` OF "wages", 1200, TRUE)
#ASSERT count (`a household of two`'s `the members`) EQUALS 2
#ASSERT `a household of two`'s `where it lives` EQUALS Hawaii
#ASSERT count (`a household of two`'s `the income items`) EQUALS 1
#ASSERT (`a 60 year old`'s `age in years`) EQUALS 60
`the claim` MEANS Claim OF 250, `the household`, `the State agency`
#ASSERT `the claim`'s `amount in dollars` EQUALS 250
#ASSERT `the claim`'s `owed by` EQUALS `the household`
`a certification period` MEANS `Certification period` OF Date 1 10 2026, 12
#ASSERT `a certification period`'s `length in months` EQUALS 12
`the December benefit's month` MEANS `the December benefit`'s `month it is for begins`
#ASSERT `the December benefit's month` EQUALS Date 1 12 2026

-- src:fna-snap-cola-fy2027:22 | 1 | $1,330 | $1,663 | $1,530
@ref USDA Food and Nutrition Administration, SNAP COLA FY 2027, Table 1 (src:fna-snap-cola-fy2027:22)
-- One row of the FY2027 net monthly income limit, household size 1: $1,330 in the 48 States, DC, Guam and the Virgin Islands; $1,663 in Alaska; $1,530 in Hawaii.
-- This only shows that the core's row types hold the table; the part that encodes s 2014(c) fills the whole table.
`a sample row of the net monthly income limit` MEANS `Table row` OF 1, (`Dollars by area` OF 1330, 1663, 1663, 1663, 1330, 1530, 1330)
#ASSERT `a sample row of the net monthly income limit`'s `the dollars`'s `in Hawaii` EQUALS 1530  -- the Hawaii column
#ASSERT `a sample row of the net monthly income limit`'s `the dollars`'s `in Guam` EQUALS 1330  -- Guam shares the first column
`the sample table` MEANS `Annual table` OF 2027, "net monthly income limit (100 percent of the poverty level)", (LIST `a sample row of the net monthly income limit`)
#ASSERT `the sample table`'s `fiscal year` EQUALS 2027  -- effective 1 October 2026 to 30 September 2027
#ASSERT count (`the sample table`'s `the rows`) EQUALS 1
