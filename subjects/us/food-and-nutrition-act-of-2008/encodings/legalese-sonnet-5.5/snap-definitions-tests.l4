#ASSERT `s 2012(p) the officer is the Secretary` FALSE EQUALS JUST FALSE  -- any other officer
#ASSERT `s 2012(q) the food is a staple food` `meat, poultry, or fish` EQUALS JUST TRUE  -- (q)(1)(A)
#ASSERT `s 2012(q) the food is a staple food` `bread or cereals` EQUALS JUST TRUE  -- (q)(1)(B)
#ASSERT `s 2012(q) the food is a staple food` `vegetables or fruits` EQUALS JUST TRUE  -- (q)(1)(C)
#ASSERT `s 2012(q) the food is a staple food` `dairy products` EQUALS JUST TRUE  -- (q)(1)(D)
#ASSERT `s 2012(q) the food is a staple food` `coffee, tea, cocoa, a carbonated or uncarbonated drink, candy, a condiment, or a spice` EQUALS JUST FALSE  -- (q)(2) "do not include accessory food items, such as coffee, tea, cocoa ..."
#ASSERT `s 2012(q) the food is a staple food` `another food that may be an accessory food item` EQUALS NOTHING  -- (q)(2) "such as": the examples do not close the list
#ASSERT `s 2012(q) the food is a staple food` `any other food` EQUALS JUST FALSE  -- "means foods in the following categories"
#ASSERT `s 2012(r) the place is a State` `one of the fifty States` TRUE EQUALS JUST TRUE  -- "the fifty States"
#ASSERT `s 2012(r) the place is a State` `the District of Columbia as a place` TRUE EQUALS JUST TRUE  -- "the District of Columbia"
#ASSERT `s 2012(r) the place is a State` `the territory of Guam` TRUE EQUALS JUST TRUE  -- "Guam"
#ASSERT `s 2012(r) the place is a State` `the territory of the Virgin Islands` TRUE EQUALS JUST TRUE  -- "the Virgin Islands of the United States"
#ASSERT `s 2012(r) the place is a State` `a reservation of an Indian tribe` TRUE EQUALS JUST TRUE  -- "the reservations of an Indian tribe whose tribal organization meets the requirements"
#ASSERT `s 2012(r) the place is a State` `a reservation of an Indian tribe` FALSE EQUALS JUST FALSE  -- a reservation whose tribal organization does not meet them
#ASSERT `s 2012(r) the place is a State` `any other place` TRUE EQUALS JUST FALSE  -- not on the list
