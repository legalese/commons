#ASSERT `s 2012(m)(5) the person is not a resident of an institution and is an individual household` (`s 2012(m)(5) person` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST TRUE  -- (A) "Residents of federally subsidized housing for the elderly"
#ASSERT `s 2012(m)(5) the person is not a resident of an institution and is an individual household` (`s 2012(m)(5) person` OF FALSE, TRUE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST TRUE  -- (A) "disabled or blind recipients of benefits under title I, II, X, XIV, or XVI"
#ASSERT `s 2012(m)(5) the person is not a resident of an institution and is an individual household` (`s 2012(m)(5) person` OF FALSE, FALSE, TRUE, FALSE, FALSE, FALSE) EQUALS JUST TRUE  -- (B)
#ASSERT `s 2012(m)(5) the person is not a resident of an institution and is an individual household` (`s 2012(m)(5) person` OF FALSE, FALSE, FALSE, TRUE, FALSE, FALSE) EQUALS JUST TRUE  -- (C)
#ASSERT `s 2012(m)(5) the person is not a resident of an institution and is an individual household` (`s 2012(m)(5) person` OF FALSE, FALSE, FALSE, FALSE, TRUE, FALSE) EQUALS JUST TRUE  -- (D)
#ASSERT `s 2012(m)(5) the person is not a resident of an institution and is an individual household` (`s 2012(m)(5) person` OF FALSE, FALSE, FALSE, FALSE, FALSE, TRUE) EQUALS JUST TRUE  -- (E)
#ASSERT `s 2012(m)(5) the person is not a resident of an institution and is an individual household` (`s 2012(m)(5) person` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS NOTHING  -- not one of the five classes: the list does not say that no one else qualifies
-- whole: fields: lives alone; with others, eats separately; group together; (2); (3); (4); (5)
`a person living alone`       MEANS `s 2012(m) circumstances` OF TRUE, FALSE, FALSE, NOTHING, NOTHING, NOTHING, NOTHING
`a lodger who eats separately` MEANS `s 2012(m) circumstances` OF FALSE, TRUE, FALSE, NOTHING, NOTHING, NOTHING, NOTHING
`a group who cook together`   MEANS `s 2012(m) circumstances` OF FALSE, FALSE, TRUE, NOTHING, NOTHING, NOTHING, NOTHING
`a couple deemed to eat together` MEANS `s 2012(m) circumstances` OF FALSE, FALSE, FALSE, JUST TRUE, NOTHING, NOTHING, NOTHING
`an old person under paragraph (3)` MEANS `s 2012(m) circumstances` OF FALSE, FALSE, FALSE, NOTHING, JUST TRUE, NOTHING, NOTHING
`a boarding house resident living alone` MEANS `s 2012(m) circumstances` OF TRUE, FALSE, FALSE, NOTHING, NOTHING, JUST FALSE, NOTHING
`a subsidized housing resident` MEANS `s 2012(m) circumstances` OF TRUE, FALSE, FALSE, NOTHING, NOTHING, JUST FALSE, JUST TRUE
`people who share a roof but not meals` MEANS `s 2012(m) circumstances` OF FALSE, FALSE, FALSE, NOTHING, NOTHING, NOTHING, NOTHING
#ASSERT `s 2012(m) the individual or group is a household` `a person living alone` EQUALS JUST TRUE  -- (1)(A) "an individual who lives alone"
#ASSERT `s 2012(m) the individual or group is a household` `a lodger who eats separately` EQUALS JUST TRUE  -- (1)(A) "while living with others, customarily purchases food and prepares meals ... separate and apart"
#ASSERT `s 2012(m) the individual or group is a household` `a group who cook together` EQUALS JUST TRUE  -- (1)(B)
#ASSERT `s 2012(m) the individual or group is a household` `a couple deemed to eat together` EQUALS JUST TRUE  -- (2)
#ASSERT `s 2012(m) the individual or group is a household` `an old person under paragraph (3)` EQUALS JUST TRUE  -- (3)
#ASSERT `s 2012(m) the individual or group is a household` `a boarding house resident living alone` EQUALS JUST FALSE  -- (4) "In no event"
#ASSERT `s 2012(m) the individual or group is a household` `a subsidized housing resident` EQUALS JUST TRUE  -- (5) "shall not be considered to be residents of institutions and shall be considered to be individual households"
#ASSERT `s 2012(m) the individual or group is a household` `people who share a roof but not meals` EQUALS JUST FALSE  -- neither (1)(A) nor (1)(B) nor (2) nor (3)
-- The independent reviewer expected JUST FALSE from paragraph (2) and (3) themselves for the three cases below; the text says no at the level of the defined term
-- ("Household" means ...), so the no is asserted there, and the paragraph functions are asserted to say NOTHING (paragraph (2)'s ages and its exclusion of foster children,
-- paragraph (3)'s sixty years of age, are limits of those grants in their own wording; Marginal readings MB-9 and MB-11, NOTES.md).
`a parent and a child of 22 who buy and cook apart` MEANS `s 2012(m) circumstances` OF FALSE, FALSE, FALSE, (`s 2012(m)(2) the pair is treated as customarily purchasing and preparing meals together` (`s 2012(m)(2) pair` OF FALSE, TRUE, 22, FALSE, FALSE)), NOTHING, NOTHING, NOTHING
`a foster parent and a foster child of 10 who buy and cook apart` MEANS `s 2012(m) circumstances` OF FALSE, FALSE, FALSE, (`s 2012(m)(2) the pair is treated as customarily purchasing and preparing meals together` (`s 2012(m)(2) pair` OF FALSE, FALSE, 10, FALSE, TRUE)), NOTHING, NOTHING, NOTHING
`a 59 year old who cannot cook, living with others who buy and cook apart` MEANS `s 2012(m) circumstances` OF FALSE, FALSE, FALSE, NOTHING, (`s 2012(m)(3) the individual is considered an individual household with the spouse` (`s 2012(m)(3) individual` OF FALSE, TRUE, TRUE, TRUE, 100, 1000)), NOTHING, NOTHING
#ASSERT `s 2012(m) the individual or group is a household` `a parent and a child of 22 who buy and cook apart` EQUALS JUST FALSE  -- "parents and their children 21 years of age or younger": 22 is outside paragraph (2), and (1)(A) and (1)(B) are not met
#ASSERT `s 2012(m) the individual or group is a household` `a foster parent and a foster child of 10 who buy and cook apart` EQUALS JUST FALSE  -- "children (excluding foster children)": outside paragraph (2), and (1)(A) and (1)(B) are not met
#ASSERT `s 2012(m) the individual or group is a household` `a 59 year old who cannot cook, living with others who buy and cook apart` EQUALS JUST FALSE  -- "who is sixty years of age or older": outside paragraph (3), and (1)(A) and (1)(B) are not met

