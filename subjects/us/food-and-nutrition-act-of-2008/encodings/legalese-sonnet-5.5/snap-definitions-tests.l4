IMPORT prelude
IMPORT daydate
IMPORT `snap-core`
IMPORT `snap-definitions`

-- Tests for snap-definitions.l4 (Food and Nutrition Act of 2008, s 2012). Every expected value is written beside its assertion and decided from
-- the text of s 2012 (usc07-ch51.txt, a plain-text rendering, not the official text), not from what the code returned.
-- JUST TRUE: the text says yes. JUST FALSE: the text says no in its own words. NOTHING: the text does not say.

-- ---------------------------------------------------------------------------------------------------
-- (a) access device. Fields: a card/plate/code/account number/other means of access; usable to obtain things of value; usable to initiate a transfer
-- ---------------------------------------------------------------------------------------------------
`a card that can be used to obtain benefits`        MEANS `s 2012(a) thing` OF TRUE, TRUE, FALSE
`an account number that can only start a transfer`  MEANS `s 2012(a) thing` OF TRUE, FALSE, TRUE
`a card that can be used for nothing`               MEANS `s 2012(a) thing` OF TRUE, FALSE, FALSE
`a receipt, which is no means of access`            MEANS `s 2012(a) thing` OF FALSE, TRUE, TRUE
#ASSERT `s 2012(a) the thing is an access device` `a card that can be used to obtain benefits` EQUALS JUST TRUE  -- "can be used ... to obtain payments, allotments, benefits"
#ASSERT `s 2012(a) the thing is an access device` `an account number that can only start a transfer` EQUALS JUST TRUE  -- "or that can be used to initiate a transfer of funds"
#ASSERT `s 2012(a) the thing is an access device` `a card that can be used for nothing` EQUALS JUST FALSE  -- "that can be used" is part of what the definition means
#ASSERT `s 2012(a) the thing is an access device` `a receipt, which is no means of access` EQUALS JUST FALSE  -- not a card, plate, code, account number or other means of access

-- ---------------------------------------------------------------------------------------------------
-- (b) allotment: the total value of the benefits authorized for the month
-- ---------------------------------------------------------------------------------------------------
`the first November benefit`  MEANS Benefit OF 100, `an electronic benefit transfer under section 2016(h)`, Date 1 11 2026
`the second November benefit` MEANS Benefit OF 50, `other means of providing assistance, as determined by the Secretary`, Date 1 11 2026
`the December benefit`        MEANS Benefit OF 70, `an electronic benefit transfer under section 2016(h)`, Date 1 12 2026
`the three benefits`          MEANS LIST `the first November benefit`, `the second November benefit`, `the December benefit`
#ASSERT `s 2012(b) the allotment for the month` `the three benefits` (Date 1 11 2026) EQUALS 150  -- 100 + 50, the two benefits authorized for November
#ASSERT `s 2012(b) the allotment for the month` `the three benefits` (Date 1 12 2026) EQUALS 70   -- only the December benefit
#ASSERT `s 2012(b) the allotment for the month` `the three benefits` (Date 1 1 2027) EQUALS 0     -- no benefit authorized for January: a total of nothing

-- ---------------------------------------------------------------------------------------------------
-- (c) allowable medical expenses. Fields: kind; prescribed by licensed practitioner; approved OTC; health-and-accident policy; prescribed eye glasses; transport necessary; due to age
-- ---------------------------------------------------------------------------------------------------
`a dental visit`                    MEANS `s 2012(c) expenditure` OF `medical and dental care`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`a week in hospital`                MEANS `s 2012(c) expenditure` OF `hospitalization or nursing care`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`a prescribed drug`                 MEANS `s 2012(c) expenditure` OF `prescription drugs`, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE
`a drug nobody prescribed`          MEANS `s 2012(c) expenditure` OF `prescription drugs`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`approved insulin`                  MEANS `s 2012(c) expenditure` OF `over-the-counter medication, including insulin`, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE
`unapproved cough syrup`            MEANS `s 2012(c) expenditure` OF `over-the-counter medication, including insulin`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`a health insurance premium`        MEANS `s 2012(c) expenditure` OF `a health and hospitalization insurance policy`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`an income maintenance policy`      MEANS `s 2012(c) expenditure` OF `a health and hospitalization insurance policy`, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE
`a medicare premium`                MEANS `s 2012(c) expenditure` OF `a medicare premium related to coverage under title XVIII of the Social Security Act`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`hearing aids`                      MEANS `s 2012(c) expenditure` OF `dentures, hearing aids, or prosthetics, including a seeing eye dog`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`prescribed eye glasses`            MEANS `s 2012(c) expenditure` OF `eye glasses`, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE
`eye glasses nobody prescribed`     MEANS `s 2012(c) expenditure` OF `eye glasses`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`a necessary taxi to the clinic`    MEANS `s 2012(c) expenditure` OF `transportation to secure medical treatment or services`, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE
`a pleasure trip`                   MEANS `s 2012(c) expenditure` OF `transportation to secure medical treatment or services`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`a home health aide for infirmity`  MEANS `s 2012(c) expenditure` OF `an attendant, homemaker, home health aide, housekeeper, or child care services`, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE
`a housekeeper for convenience`     MEANS `s 2012(c) expenditure` OF `an attendant, homemaker, home health aide, housekeeper, or child care services`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`a gym membership`                  MEANS `s 2012(c) expenditure` OF `any other expenditure`, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
#ASSERT `s 2012(c) the expenditure is an allowable medical expense` `a dental visit` EQUALS JUST TRUE  -- (1)
#ASSERT `s 2012(c) the expenditure is an allowable medical expense` `a week in hospital` EQUALS JUST TRUE  -- (2)
#ASSERT `s 2012(c) the expenditure is an allowable medical expense` `a prescribed drug` EQUALS JUST TRUE  -- (3) "when prescribed by a licensed practitioner"
#ASSERT `s 2012(c) the expenditure is an allowable medical expense` `a drug nobody prescribed` EQUALS JUST FALSE  -- the "when prescribed" qualifier is part of what (3) means
#ASSERT `s 2012(c) the expenditure is an allowable medical expense` `approved insulin` EQUALS JUST TRUE  -- (3) "over-the-counter medication (including insulin) when approved"
#ASSERT `s 2012(c) the expenditure is an allowable medical expense` `unapproved cough syrup` EQUALS JUST FALSE  -- not approved
#ASSERT `s 2012(c) the expenditure is an allowable medical expense` `a health insurance premium` EQUALS JUST TRUE  -- (4)
#ASSERT `s 2012(c) the expenditure is an allowable medical expense` `an income maintenance policy` EQUALS JUST FALSE  -- (4) "excluding the costs of health and accident or income maintenance policies"
#ASSERT `s 2012(c) the expenditure is an allowable medical expense` `a medicare premium` EQUALS JUST TRUE  -- (5)
#ASSERT `s 2012(c) the expenditure is an allowable medical expense` `hearing aids` EQUALS JUST TRUE  -- (6)
#ASSERT `s 2012(c) the expenditure is an allowable medical expense` `prescribed eye glasses` EQUALS JUST TRUE  -- (7)
#ASSERT `s 2012(c) the expenditure is an allowable medical expense` `eye glasses nobody prescribed` EQUALS JUST FALSE  -- (7) "prescribed by a physician skilled in eye disease or by an optometrist"
#ASSERT `s 2012(c) the expenditure is an allowable medical expense` `a necessary taxi to the clinic` EQUALS JUST TRUE  -- (8)
#ASSERT `s 2012(c) the expenditure is an allowable medical expense` `a pleasure trip` EQUALS JUST FALSE  -- (8) "necessary to secure medical treatment or services"
#ASSERT `s 2012(c) the expenditure is an allowable medical expense` `a home health aide for infirmity` EQUALS JUST TRUE  -- (9)
#ASSERT `s 2012(c) the expenditure is an allowable medical expense` `a housekeeper for convenience` EQUALS JUST FALSE  -- (9) "due to age, infirmity, or illness"
#ASSERT `s 2012(c) the expenditure is an allowable medical expense` `a gym membership` EQUALS JUST FALSE  -- not one of the nine kinds

-- ---------------------------------------------------------------------------------------------------
-- (d) benefit. Fields: nutrition assistance provided to a household; the form; the Secretary's determination of the other means
-- ---------------------------------------------------------------------------------------------------
`an EBT payment`                      MEANS `s 2012(d) assistance` OF TRUE, `an electronic benefit transfer under section 2016(h)`, NOTHING
`other means the Secretary approved`  MEANS `s 2012(d) assistance` OF TRUE, `other means of providing assistance, as determined by the Secretary`, JUST TRUE
`other means the Secretary refused`   MEANS `s 2012(d) assistance` OF TRUE, `other means of providing assistance, as determined by the Secretary`, JUST FALSE
`other means the Secretary has not ruled on` MEANS `s 2012(d) assistance` OF TRUE, `other means of providing assistance, as determined by the Secretary`, JUST FALSE
`other means, the caller cannot say whether the Secretary ruled`     MEANS `s 2012(d) assistance` OF TRUE, `other means of providing assistance, as determined by the Secretary`, NOTHING
`a cash gift from a neighbour`        MEANS `s 2012(d) assistance` OF FALSE, `an electronic benefit transfer under section 2016(h)`, NOTHING
#ASSERT `s 2012(d) the assistance is a benefit` `an EBT payment` EQUALS JUST TRUE  -- (d)(1)
#ASSERT `s 2012(d) the assistance is a benefit` `other means the Secretary approved` EQUALS JUST TRUE  -- (d)(2) "as determined by the Secretary": determined
#ASSERT `s 2012(d) the assistance is a benefit` `other means the Secretary refused` EQUALS JUST FALSE  -- (d)(2): the Secretary determined it is not
#ASSERT `s 2012(d) the assistance is a benefit` `other means the Secretary has not ruled on` EQUALS JUST FALSE  -- (d)(2) "as determined by the Secretary": the Secretary has made no determination, so the means is not within limb (2); the caller says so with JUST FALSE
#ASSERT `s 2012(d) the assistance is a benefit` `other means, the caller cannot say whether the Secretary ruled` EQUALS NOTHING  -- (d)(2): the caller cannot say whether the Secretary has determined it
#ASSERT `s 2012(d) the assistance is a benefit` `a cash gift from a neighbour` EQUALS JUST FALSE  -- not "supplemental nutrition assistance provided to a household"

-- ---------------------------------------------------------------------------------------------------
-- (e) benefit issuer. Fields: an office of the State agency; a person or other entity; contracted for issuance; delegated responsibility for issuance
-- ---------------------------------------------------------------------------------------------------
`a State agency office`            MEANS `s 2012(e) entity` OF TRUE, FALSE, FALSE, FALSE
`a bank under contract`            MEANS `s 2012(e) entity` OF FALSE, TRUE, TRUE, FALSE
`a county given the job`           MEANS `s 2012(e) entity` OF FALSE, TRUE, FALSE, TRUE
`a company with no link`           MEANS `s 2012(e) entity` OF FALSE, TRUE, FALSE, FALSE
#ASSERT `s 2012(e) the entity is a benefit issuer` `a State agency office` EQUALS JUST TRUE  -- "any office of the State agency"
#ASSERT `s 2012(e) the entity is a benefit issuer` `a bank under contract` EQUALS JUST TRUE  -- "with which a State agency has contracted for ... the issuance of benefits"
#ASSERT `s 2012(e) the entity is a benefit issuer` `a county given the job` EQUALS JUST TRUE  -- "to which it has delegated functional responsibility in connection with ... the issuance of benefits"
#ASSERT `s 2012(e) the entity is a benefit issuer` `a company with no link` EQUALS JUST FALSE  -- neither contracted nor delegated

-- ---------------------------------------------------------------------------------------------------
-- (f) certification period: at most 12 months, 24 if all adult members are elderly or disabled; the State agency contacts the household at least once in 12 months
-- ---------------------------------------------------------------------------------------------------
`a 12 month period`                   MEANS `s 2012(f) the period and its setting` OF (`Certification period` OF Date 1 10 2026, 12), FALSE, FALSE
`a 13 month period`                   MEANS `s 2012(f) the period and its setting` OF (`Certification period` OF Date 1 10 2026, 13), FALSE, FALSE
`a 24 month period for an elderly household` MEANS `s 2012(f) the period and its setting` OF (`Certification period` OF Date 1 10 2026, 24), TRUE, FALSE
`a 25 month period for an elderly household` MEANS `s 2012(f) the period and its setting` OF (`Certification period` OF Date 1 10 2026, 25), TRUE, FALSE
`a 24 month period for an ordinary household` MEANS `s 2012(f) the period and its setting` OF (`Certification period` OF Date 1 10 2026, 24), FALSE, FALSE
`a 18 month period inside a transitional benefit period` MEANS `s 2012(f) the period and its setting` OF (`Certification period` OF Date 1 10 2026, 18), FALSE, TRUE
#ASSERT `s 2012(f) the certification period is within the limit` `a 12 month period` EQUALS JUST TRUE  -- "shall not exceed 12 months": 12 does not exceed
#ASSERT `s 2012(f) the certification period is within the limit` `a 13 month period` EQUALS JUST FALSE  -- 13 exceeds 12 and not all adult members are elderly or disabled
#ASSERT `s 2012(f) the certification period is within the limit` `a 24 month period for an elderly household` EQUALS JUST TRUE  -- "up to 24 months if all adult household members are elderly or disabled"
#ASSERT `s 2012(f) the certification period is within the limit` `a 25 month period for an elderly household` EQUALS JUST FALSE  -- over 24
#ASSERT `s 2012(f) the certification period is within the limit` `a 24 month period for an ordinary household` EQUALS JUST FALSE  -- 24 needs all adults elderly or disabled
#ASSERT `s 2012(f) the certification period is within the limit` `a 18 month period inside a transitional benefit period` EQUALS NOTHING  -- the limits "may be extended" for a transitional benefit period under s 2020(s): not in the keel's lines
#ASSERT `s 2012(f) the State agency has had the required contact` 1 FALSE EQUALS JUST TRUE  -- "at least 1 contact"
#ASSERT `s 2012(f) the State agency has had the required contact` 0 FALSE EQUALS JUST FALSE  -- none in 12 months
#ASSERT `s 2012(f) the State agency has had the required contact` 0 TRUE EQUALS NOTHING  -- the limit may be extended for a transitional benefit period

-- ---------------------------------------------------------------------------------------------------
-- (g) coupon. Fields: the kind of thing; issued in lieu of a coupon
-- ---------------------------------------------------------------------------------------------------
`a plain coupon`                       MEANS `s 2012(g) thing issued` OF `a coupon`, FALSE
`a stamp`                              MEANS `s 2012(g) thing issued` OF `a stamp`, FALSE
`a certificate`                        MEANS `s 2012(g) thing issued` OF `a type of certificate`, FALSE
`an authorization card`                MEANS `s 2012(g) thing issued` OF `an authorization card`, FALSE
`cash given instead of a coupon`       MEANS `s 2012(g) thing issued` OF `cash`, TRUE
`cash given for some other reason`     MEANS `s 2012(g) thing issued` OF `cash`, FALSE
`a check given instead of a coupon`    MEANS `s 2012(g) thing issued` OF `a check`, TRUE
`a check given for some other reason`  MEANS `s 2012(g) thing issued` OF `a check`, FALSE
`a gift voucher`                       MEANS `s 2012(g) thing issued` OF `any other thing`, TRUE
#ASSERT `s 2012(g) the thing is a coupon` `a plain coupon` EQUALS JUST TRUE  -- "any coupon"
#ASSERT `s 2012(g) the thing is a coupon` `a stamp` EQUALS JUST TRUE  -- "stamp" (reading taken: the "in lieu" words qualify cash or check)
#ASSERT `s 2012(g) the thing is a coupon` `a certificate` EQUALS JUST TRUE  -- "type of certificate"
#ASSERT `s 2012(g) the thing is a coupon` `an authorization card` EQUALS JUST TRUE  -- "authorization card"
#ASSERT `s 2012(g) the thing is a coupon` `cash given instead of a coupon` EQUALS JUST TRUE  -- "cash ... issued in lieu of a coupon"
#ASSERT `s 2012(g) the thing is a coupon` `cash given for some other reason` EQUALS JUST FALSE  -- cash not issued in lieu of a coupon
#ASSERT `s 2012(g) the thing is a coupon` `a check given instead of a coupon` EQUALS JUST TRUE  -- "check issued in lieu of a coupon"
#ASSERT `s 2012(g) the thing is a coupon` `a check given for some other reason` EQUALS JUST FALSE  -- check not issued in lieu of a coupon
#ASSERT `s 2012(g) the thing is a coupon` `a gift voucher` EQUALS JUST FALSE  -- not in the list, though issued in lieu of a coupon
-- Fork F-1, the other reading: "issued in lieu of a coupon" qualifies every kind. A stamp issued for another reason is then not a coupon.
#ASSERT `s 2012(g) the thing is a coupon, on the reading that "issued in lieu of a coupon" qualifies every kind` `a stamp` EQUALS JUST FALSE
#ASSERT `s 2012(g) the thing is a coupon, on the reading that "issued in lieu of a coupon" qualifies every kind` `cash given instead of a coupon` EQUALS JUST TRUE
#ASSERT `s 2012(g) the thing is a coupon, on the reading that "issued in lieu of a coupon" qualifies every kind` `a gift voucher` EQUALS JUST FALSE

-- ---------------------------------------------------------------------------------------------------
-- (h) treatment program. Fields: private nonprofit; public community mental health center; under part B of title XIX of the PHSA; provides treatment
-- ---------------------------------------------------------------------------------------------------
`a nonprofit clinic program`        MEANS `s 2012(h) program` OF TRUE, FALSE, TRUE, TRUE
`a public mental health centre program` MEANS `s 2012(h) program` OF FALSE, TRUE, TRUE, TRUE
`a for-profit clinic program`       MEANS `s 2012(h) program` OF FALSE, FALSE, TRUE, TRUE
`a nonprofit program outside part B` MEANS `s 2012(h) program` OF TRUE, FALSE, FALSE, TRUE
`a nonprofit program with no treatment` MEANS `s 2012(h) program` OF TRUE, FALSE, TRUE, FALSE
#ASSERT `s 2012(h) the program is a drug addiction or alcoholic treatment and rehabilitation program` `a nonprofit clinic program` EQUALS JUST TRUE  -- "private nonprofit organization or institution"
#ASSERT `s 2012(h) the program is a drug addiction or alcoholic treatment and rehabilitation program` `a public mental health centre program` EQUALS JUST TRUE  -- "publicly operated community mental health center"
#ASSERT `s 2012(h) the program is a drug addiction or alcoholic treatment and rehabilitation program` `a for-profit clinic program` EQUALS JUST FALSE  -- neither conductor named
#ASSERT `s 2012(h) the program is a drug addiction or alcoholic treatment and rehabilitation program` `a nonprofit program outside part B` EQUALS JUST FALSE  -- "under part B of title XIX"
#ASSERT `s 2012(h) the program is a drug addiction or alcoholic treatment and rehabilitation program` `a nonprofit program with no treatment` EQUALS JUST FALSE  -- "to provide treatment that can lead to the rehabilitation"

-- ---------------------------------------------------------------------------------------------------
-- (i) EBT card. Fields: an electronic benefit transfer card; issued under section 2016(h)
-- ---------------------------------------------------------------------------------------------------
#ASSERT `s 2012(i) the card is an EBT card` (`s 2012(i) card` OF TRUE, TRUE) EQUALS JUST TRUE  -- "an electronic benefit transfer card issued under section 2016(h)"
#ASSERT `s 2012(i) the card is an EBT card` (`s 2012(i) card` OF TRUE, FALSE) EQUALS JUST FALSE  -- a transfer card not issued under 2016(h)
#ASSERT `s 2012(i) the card is an EBT card` (`s 2012(i) card` OF FALSE, TRUE) EQUALS JUST FALSE  -- not an electronic benefit transfer card

-- ---------------------------------------------------------------------------------------------------
-- (j) elderly or disabled member.
-- Individual fields: age; fit; pregnant; immigration status; resident; receives SSI; hours worked; enrolled
-- Facts, in order: 1 supplemental benefits of the 212(a) type; 2 assistance of the 1616(a) type; 3 interim assistance; 4 disability-related medical assistance;
--   5 disability-based State general assistance; 6 the Secretary's determination (2)(B); 7 disability or blindness payments; 8 disability retirement benefits;
--   9 a veteran; 10 total disability rating; 11 aid and attendance or housebound; 12 surviving spouse of a veteran; 13 entitled to death compensation or pension;
--   14 a disability considered permanent under 221(i); 15 child of a veteran; 16 permanently incapable of self-support; 17 railroad annuity;
--   18 service included in "employment"; 19 application for disability benefits filed
-- ---------------------------------------------------------------------------------------------------
`a 30 year old`   MEANS Individual OF 30, TRUE, FALSE, `a citizen or national of the United States`, TRUE, FALSE, 0, FALSE
`a 59 year old`   MEANS Individual OF 59, TRUE, FALSE, `a citizen or national of the United States`, TRUE, FALSE, 0, FALSE
`a 60 year old`   MEANS Individual OF 60, TRUE, FALSE, `a citizen or national of the United States`, TRUE, FALSE, 0, FALSE
`a 30 year old on SSI` MEANS Individual OF 30, TRUE, FALSE, `a citizen or national of the United States`, TRUE, TRUE, 0, FALSE

`no (j) facts`            MEANS `s 2012(j) facts about the member` OF FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`212(a) benefits`         MEANS `s 2012(j) facts about the member` OF TRUE, FALSE, FALSE, FALSE, FALSE, NOTHING, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`interim aid, Secretary found it as stringent` MEANS `s 2012(j) facts about the member` OF FALSE, FALSE, TRUE, FALSE, FALSE, JUST TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`interim aid, Secretary found it less stringent` MEANS `s 2012(j) facts about the member` OF FALSE, FALSE, TRUE, FALSE, FALSE, JUST FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`interim aid, the Secretary has made no determination` MEANS `s 2012(j) facts about the member` OF FALSE, FALSE, TRUE, FALSE, FALSE, JUST FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`interim aid, the caller cannot say whether the Secretary decided` MEANS `s 2012(j) facts about the member` OF FALSE, FALSE, TRUE, FALSE, FALSE, NOTHING, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`general assistance, Secretary found it as stringent` MEANS `s 2012(j) facts about the member` OF FALSE, FALSE, FALSE, FALSE, TRUE, JUST TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`disability payments`     MEANS `s 2012(j) facts about the member` OF FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`disability retirement`   MEANS `s 2012(j) facts about the member` OF FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`a veteran rated totally disabled` MEANS `s 2012(j) facts about the member` OF FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING, FALSE, FALSE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`a veteran needing aid and attendance` MEANS `s 2012(j) facts about the member` OF FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING, FALSE, FALSE, TRUE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`a veteran with nothing else` MEANS `s 2012(j) facts about the member` OF FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`a total rating held by a non-veteran` MEANS `s 2012(j) facts about the member` OF FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`a veteran's widow needing aid` MEANS `s 2012(j) facts about the member` OF FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING, FALSE, FALSE, FALSE, FALSE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`a veteran's widow with a pension and a permanent disability` MEANS `s 2012(j) facts about the member` OF FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE
`a veteran's widow with a pension only` MEANS `s 2012(j) facts about the member` OF FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`a veteran's child unable to support themselves` MEANS `s 2012(j) facts about the member` OF FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, TRUE, FALSE, FALSE, FALSE
`a veteran's child with a pension and a permanent disability` MEANS `s 2012(j) facts about the member` OF FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE
`a veteran's child with a pension only` MEANS `s 2012(j) facts about the member` OF FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE
`a railroad annuitant who applied` MEANS `s 2012(j) facts about the member` OF FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, TRUE, TRUE
`a railroad annuitant who never applied` MEANS `s 2012(j) facts about the member` OF FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, TRUE, FALSE

#ASSERT `s 2012(j)(1) the member is sixty years of age or older` `a 59 year old` EQUALS JUST FALSE  -- 59 is under sixty
#ASSERT `s 2012(j)(1) the member is sixty years of age or older` `a 60 year old` EQUALS JUST TRUE  -- "sixty years of age or older": 60 is enough
#ASSERT `s 2012(j) the member is an elderly or disabled member` `a 30 year old` `no (j) facts` EQUALS JUST FALSE  -- no limb holds
#ASSERT `s 2012(j) the member is an elderly or disabled member` `a 59 year old` `no (j) facts` EQUALS JUST FALSE  -- (1) boundary
#ASSERT `s 2012(j) the member is an elderly or disabled member` `a 60 year old` `no (j) facts` EQUALS JUST TRUE  -- (1)
#ASSERT `s 2012(j) the member is an elderly or disabled member` `a 30 year old on SSI` `no (j) facts` EQUALS JUST TRUE  -- (2)(A) supplemental security income
#ASSERT `s 2012(j) the member is an elderly or disabled member` `a 30 year old` `212(a) benefits` EQUALS JUST TRUE  -- (2)(A) benefits of the type in section 212(a) of Public Law 93-66
#ASSERT `s 2012(j) the member is an elderly or disabled member` `a 30 year old` `interim aid, Secretary found it as stringent` EQUALS JUST TRUE  -- (2)(B) "if the Secretary determines"
#ASSERT `s 2012(j) the member is an elderly or disabled member` `a 30 year old` `interim aid, Secretary found it less stringent` EQUALS JUST FALSE  -- (2)(B): the condition failed
#ASSERT `s 2012(j) the member is an elderly or disabled member` `a 30 year old` `interim aid, the caller cannot say whether the Secretary decided` EQUALS NOTHING  -- (2)(B): the caller cannot say whether the Secretary has determined it
#ASSERT `s 2012(j) the member is an elderly or disabled member` `a 30 year old` `interim aid, the Secretary has made no determination` EQUALS JUST FALSE  -- (2)(B) "if the Secretary determines": no determination has been made, so the "if" is unmet; the caller says so with JUST FALSE
#ASSERT `s 2012(j) the member is an elderly or disabled member` `a 30 year old` `general assistance, Secretary found it as stringent` EQUALS JUST TRUE  -- (2)(B) disability-based State general assistance
#ASSERT `s 2012(j) the member is an elderly or disabled member` `a 30 year old` `disability payments` EQUALS JUST TRUE  -- (3)
#ASSERT `s 2012(j) the member is an elderly or disabled member` `a 30 year old` `disability retirement` EQUALS JUST TRUE  -- (3) disability retirement benefits
#ASSERT `s 2012(j) the member is an elderly or disabled member` `a 30 year old` `a veteran rated totally disabled` EQUALS JUST TRUE  -- (4)(A)
#ASSERT `s 2012(j) the member is an elderly or disabled member` `a 30 year old` `a veteran needing aid and attendance` EQUALS JUST TRUE  -- (4)(B)
#ASSERT `s 2012(j) the member is an elderly or disabled member` `a 30 year old` `a veteran with nothing else` EQUALS JUST FALSE  -- (4) needs (A) or (B)
#ASSERT `s 2012(j) the member is an elderly or disabled member` `a 30 year old` `a total rating held by a non-veteran` EQUALS JUST FALSE  -- (4) "is a veteran who"
#ASSERT `s 2012(j) the member is an elderly or disabled member` `a 30 year old` `a veteran's widow needing aid` EQUALS JUST TRUE  -- (5)(A)
#ASSERT `s 2012(j) the member is an elderly or disabled member` `a 30 year old` `a veteran's widow with a pension and a permanent disability` EQUALS JUST TRUE  -- (5)(B)
#ASSERT `s 2012(j) the member is an elderly or disabled member` `a 30 year old` `a veteran's widow with a pension only` EQUALS JUST FALSE  -- (5)(B) needs the permanent disability too
#ASSERT `s 2012(j) the member is an elderly or disabled member` `a 30 year old` `a veteran's child unable to support themselves` EQUALS JUST TRUE  -- (6)(A)
#ASSERT `s 2012(j) the member is an elderly or disabled member` `a 30 year old` `a veteran's child with a pension and a permanent disability` EQUALS JUST TRUE  -- (6)(B)
#ASSERT `s 2012(j) the member is an elderly or disabled member` `a 30 year old` `a veteran's child with a pension only` EQUALS JUST FALSE  -- (6)(B) needs the permanent disability too
#ASSERT `s 2012(j) the member is an elderly or disabled member` `a 30 year old` `a railroad annuitant who applied` EQUALS JUST TRUE  -- (7)
#ASSERT `s 2012(j) the member is an elderly or disabled member` `a 30 year old` `a railroad annuitant who never applied` EQUALS JUST FALSE  -- (7) "if an application for disability benefits had been filed"

-- ---------------------------------------------------------------------------------------------------
-- (k) food
-- ---------------------------------------------------------------------------------------------------
`bread bought at a shop`        MEANS `food or a food product for home consumption` FALSE FALSE FALSE NOTHING
`a bottle of wine`              MEANS `food or a food product for home consumption` TRUE FALSE FALSE NOTHING
`a packet of cigarettes`        MEANS `food or a food product for home consumption` FALSE TRUE FALSE NOTHING
`a hot pie, served under a clause (3) to (9) arrangement` MEANS `food or a food product for home consumption` FALSE FALSE TRUE (JUST TRUE)
`a hot pie, not served under any such arrangement` MEANS `food or a food product for home consumption` FALSE FALSE TRUE (JUST FALSE)
`a hot pie, arrangement not known` MEANS `food or a food product for home consumption` FALSE FALSE TRUE NOTHING
#ASSERT `s 2012(k) the item or meal is food` `bread bought at a shop` EQUALS JUST TRUE  -- (1) "any food or food product for home consumption"
#ASSERT `s 2012(k) the item or meal is food` `a bottle of wine` EQUALS JUST FALSE  -- (1) "except alcoholic beverages"
#ASSERT `s 2012(k) the item or meal is food` `a packet of cigarettes` EQUALS JUST FALSE  -- (1) "except ... tobacco"
#ASSERT `s 2012(k) the item or meal is food` `a hot pie, served under a clause (3) to (9) arrangement` EQUALS JUST TRUE  -- (1) hot food "other than those authorized pursuant to clauses (3), (4), (5), (7), (8), and (9)"
#ASSERT `s 2012(k) the item or meal is food` `a hot pie, not served under any such arrangement` EQUALS JUST FALSE  -- (1) hot food ready for immediate consumption, not so authorized
#ASSERT `s 2012(k) the item or meal is food` `a hot pie, arrangement not known` EQUALS NOTHING  -- whether clauses (3) to (9) authorize it is not supplied
#ASSERT `s 2012(k) the item or meal is food` (`a deposit fee on a returnable bottle or can` TRUE) EQUALS JUST TRUE  -- (1) "any deposit fee in excess of the amount of the State fee reimbursement"
#ASSERT `s 2012(k) the item or meal is food` (`a deposit fee on a returnable bottle or can` FALSE) EQUALS JUST FALSE  -- a fee not in excess is not within (1)
#ASSERT `s 2012(k) the item or meal is food` (`seeds and plants` TRUE) EQUALS JUST TRUE  -- (2)
#ASSERT `s 2012(k) the item or meal is food` (`seeds and plants` FALSE) EQUALS JUST FALSE  -- (2) only seeds and plants for a food garden
-- (3): fields: eater is 60+ / on SSI / spouse; the place; permitted under section 2018(h)
#ASSERT `s 2012(k) the item or meal is food` (`a meal under clause (3)` TRUE `a senior citizens' center` FALSE) EQUALS JUST TRUE  -- (3) a senior citizens' center
#ASSERT `s 2012(k) the item or meal is food` (`a meal under clause (3)` TRUE `an apartment building occupied primarily by such persons` FALSE) EQUALS JUST TRUE  -- (3)
#ASSERT `s 2012(k) the item or meal is food` (`a meal under clause (3)` TRUE `a public or private nonprofit establishment (eating or otherwise) that feeds such persons` FALSE) EQUALS JUST TRUE  -- (3)
#ASSERT `s 2012(k) the item or meal is food` (`a meal under clause (3)` TRUE `federally subsidized housing for the elderly` FALSE) EQUALS JUST TRUE  -- (3) "meals prepared for and served to residents of federally subsidized housing for the elderly"
#ASSERT `s 2012(k) the item or meal is food` (`a meal under clause (3)` TRUE `a private establishment that contracts with the appropriate agency of the State to offer meals for such persons at concessional prices` TRUE) EQUALS JUST TRUE  -- (3) subject to section 2018(h): permitted
#ASSERT `s 2012(k) the item or meal is food` (`a meal under clause (3)` TRUE `a private establishment that contracts with the appropriate agency of the State to offer meals for such persons at concessional prices` FALSE) EQUALS NOTHING  -- (3) "subject to section 2018(h)": not permitted there, which is outside the keel's lines
#ASSERT `s 2012(k) the item or meal is food` (`a meal under clause (3)` FALSE `a senior citizens' center` FALSE) EQUALS JUST FALSE  -- (3) "in the case of those persons who are sixty years of age or over ..."
#ASSERT `s 2012(k) the item or meal is food` (`a meal under clause (3)` TRUE `any other place` FALSE) EQUALS JUST FALSE  -- not one of the listed places
-- (4): fields: eater is 60+ / disabled / spouse; delivered at home; the provider; permitted under section 2018(h)
#ASSERT `s 2012(k) the item or meal is food` (`a meal under clause (4)` TRUE TRUE `a public or private nonprofit organization` FALSE) EQUALS JUST TRUE  -- (4)
#ASSERT `s 2012(k) the item or meal is food` (`a meal under clause (4)` TRUE TRUE `a private establishment that contracts with the appropriate State agency to perform such services at concessional prices` TRUE) EQUALS JUST TRUE  -- (4) permitted
#ASSERT `s 2012(k) the item or meal is food` (`a meal under clause (4)` TRUE TRUE `a private establishment that contracts with the appropriate State agency to perform such services at concessional prices` FALSE) EQUALS NOTHING  -- (4) "subject to section 2018(h)"
#ASSERT `s 2012(k) the item or meal is food` (`a meal under clause (4)` TRUE FALSE `a public or private nonprofit organization` FALSE) EQUALS JUST FALSE  -- (4) "meals prepared for and delivered to them ... at their home": not delivered
#ASSERT `s 2012(k) the item or meal is food` (`a meal under clause (4)` TRUE TRUE `any other provider` FALSE) EQUALS JUST FALSE  -- not a provider (4) names
-- (5), (7), (8): fields as the constructors declare them
#ASSERT `s 2012(k) the item or meal is food` (`a meal under clause (5)` TRUE TRUE) EQUALS JUST TRUE  -- (5)
#ASSERT `s 2012(k) the item or meal is food` (`a meal under clause (5)` TRUE FALSE) EQUALS JUST FALSE  -- (5) "meals prepared and served under such programs"
#ASSERT `s 2012(k) the item or meal is food` (`a meal under clause (7)` TRUE TRUE TRUE) EQUALS JUST TRUE  -- (7)
#ASSERT `s 2012(k) the item or meal is food` (`a meal under clause (7)` TRUE FALSE TRUE) EQUALS JUST FALSE  -- (7) a group living arrangement of no more than sixteen residents certified as the clause requires
#ASSERT `s 2012(k) the item or meal is food` (`a meal under clause (8)` TRUE TRUE) EQUALS JUST TRUE  -- (8)
#ASSERT `s 2012(k) the item or meal is food` (`a meal under clause (8)` FALSE TRUE) EQUALS JUST FALSE  -- (8) "women and children temporarily residing in ... shelters"
-- (6): fields: hunting and fishing gear; transport/clothing/shelter/firearm; Alaska household; the Secretary's finding
#ASSERT `s 2012(k) the item or meal is food` (`equipment under clause (6)` TRUE FALSE TRUE (JUST TRUE)) EQUALS JUST TRUE  -- (6) nets, hooks, rods, harpoons, knives, if the Secretary so finds
#ASSERT `s 2012(k) the item or meal is food` (`equipment under clause (6)` TRUE TRUE TRUE (JUST TRUE)) EQUALS JUST FALSE  -- (6) "but not equipment for purposes of transportation, clothing, or shelter, and not firearms, ammunition, and explosives"
#ASSERT `s 2012(k) the item or meal is food` (`equipment under clause (6)` TRUE FALSE FALSE (JUST TRUE)) EQUALS JUST FALSE  -- (6) "certain eligible households living in Alaska"
#ASSERT `s 2012(k) the item or meal is food` (`equipment under clause (6)` TRUE FALSE TRUE (JUST FALSE)) EQUALS JUST FALSE  -- (6) "if the Secretary determines": the Secretary has made no such finding, or found the household is not so placed
#ASSERT `s 2012(k) the item or meal is food` (`equipment under clause (6)` TRUE FALSE TRUE NOTHING) EQUALS NOTHING  -- (6) the caller cannot say whether the Secretary has made the finding
#ASSERT `s 2012(k) the item or meal is food` (`equipment under clause (6)` FALSE FALSE TRUE (JUST TRUE)) EQUALS JUST FALSE  -- not equipment for procuring food by hunting and fishing
-- (9): fields: eater in a household with no permanent dwelling or no fixed mailing address; the provider; permitted under section 2018(h)
#ASSERT `s 2012(k) the item or meal is food` (`a meal under clause (9)` TRUE `a public or private nonprofit establishment (approved by an appropriate State or local agency) that feeds such individuals` FALSE) EQUALS JUST TRUE  -- (9)
#ASSERT `s 2012(k) the item or meal is food` (`a meal under clause (9)` TRUE `a private establishment that contracts with the appropriate agency of the State to offer meals for such individuals at concessional prices` TRUE) EQUALS JUST TRUE  -- (9) permitted
#ASSERT `s 2012(k) the item or meal is food` (`a meal under clause (9)` TRUE `a private establishment that contracts with the appropriate agency of the State to offer meals for such individuals at concessional prices` FALSE) EQUALS NOTHING  -- (9) "subject to section 2018(h)"
#ASSERT `s 2012(k) the item or meal is food` (`a meal under clause (9)` FALSE `a public or private nonprofit establishment (approved by an appropriate State or local agency) that feeds such individuals` FALSE) EQUALS JUST FALSE  -- (9) "households that do not reside in permanent dwellings"
#ASSERT `s 2012(k) the item or meal is food` (`a meal under clause (9)` TRUE `any other provider` FALSE) EQUALS JUST FALSE  -- not a provider (9) names

-- ---------------------------------------------------------------------------------------------------
-- (l) homeless individual. Fields: lacks a fixed and regular nighttime residence; the primary nighttime residence
-- ---------------------------------------------------------------------------------------------------
#ASSERT `s 2012(l) the individual is a homeless individual` (`s 2012(l) individual` OF TRUE, `none of those places`) EQUALS JUST TRUE  -- (1)
#ASSERT `s 2012(l) the individual is a homeless individual` (`s 2012(l) individual` OF FALSE, `a supervised publicly or privately operated shelter designed to provide temporary living accommodations, including a welfare hotel or congregate shelter`) EQUALS JUST TRUE  -- (2)(A)
#ASSERT `s 2012(l) the individual is a homeless individual` (`s 2012(l) individual` OF FALSE, `an institution that provides a temporary residence for individuals intended to be institutionalized`) EQUALS JUST TRUE  -- (2)(B)
#ASSERT `s 2012(l) the individual is a homeless individual` (`s 2012(l) individual` OF FALSE, `a temporary accommodation in the residence of another individual` 90) EQUALS JUST TRUE  -- (2)(C) "not more than 90 days": 90 is allowed
#ASSERT `s 2012(l) the individual is a homeless individual` (`s 2012(l) individual` OF FALSE, `a temporary accommodation in the residence of another individual` 91) EQUALS JUST FALSE  -- 91 days is more than 90
#ASSERT `s 2012(l) the individual is a homeless individual` (`s 2012(l) individual` OF FALSE, `a public or private place not designed for, or ordinarily used as, a regular sleeping accommodation for human beings`) EQUALS JUST TRUE  -- (2)(D)
#ASSERT `s 2012(l) the individual is a homeless individual` (`s 2012(l) individual` OF FALSE, `none of those places`) EQUALS JUST FALSE  -- has a fixed and regular residence, and none of (2)(A) to (D)

