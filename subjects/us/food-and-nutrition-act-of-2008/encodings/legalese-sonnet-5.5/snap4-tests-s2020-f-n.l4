#ASSERT `s 2020(g) the Secretary must proceed to withhold the funds the Secretary determines to be appropriate` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2020(g) the Secretary must proceed to withhold the funds the Secretary determines to be appropriate` FALSE TRUE EQUALS JUST FALSE
