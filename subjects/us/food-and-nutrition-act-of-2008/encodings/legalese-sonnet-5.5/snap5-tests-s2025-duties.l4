IMPORT prelude
IMPORT daydate
IMPORT `snap5-s2025-duties`
IMPORT `snap5-s2025-c2`
IMPORT `snap5-s2025-k`
IMPORT `snap5-s2028`

-- TESTS for snap5-s2025-duties.l4. A #TRACE result cannot be asserted on the stable binary, so the expected result is written in a comment before each trace
-- (from the text, before the file was run), and the twin decision function from the module named in the heading is asserted on the same facts on the next lines.
-- Day 0 of a trace is the day the window opens; the dates in the twin are that day plus the same number of days.

§ `s 2025(c)(8)(D) to (G) a State agency appeals a payment claim`

-- every step in time: notice on day 5, evidence on day 40, the Secretary's response on day 80 (40 days after the evidence), rebuttal on day 100, decision on day 150
-- expected: FULFILLED
#TRACE `s 2025(c)(8)(D) to (G) a State agency appeals a payment claim` AT 0 WITH
    PARTY `s 2025(c)(8) a State agency` DOES `s 2025(c)(8)(D)(i) submit a notice of appeal` AT 5
    PARTY `s 2025(c)(8) a State agency` DOES `s 2025(c)(8)(D)(ii) submit evidence in support of the appeal` AT 40
    PARTY `s 2025(c)(8) the Secretary` DOES `s 2025(c)(8)(E) submit responsive evidence` AT 80
    PARTY `s 2025(c)(8) a State agency` DOES `s 2025(c)(8)(F) submit rebuttal evidence` AT 100
    PARTY `s 2025(c)(8) the administrative law judge` DOES `s 2025(c)(8)(G) decide the appeal` AT 150
#ASSERT `s 2025(c)(8)(D)(i) the notice of appeal is submitted in time` (Date 1 3 2026) ((Date 1 3 2026) PLUS 5) NOTHING EQUALS JUST TRUE
#ASSERT `s 2025(c)(8)(D)(ii) the evidence in support of the appeal is submitted in time` (Date 1 3 2026) ((Date 1 3 2026) PLUS 40) NOTHING EQUALS JUST TRUE
#ASSERT `s 2025(c)(8)(E) the responsive evidence is submitted in time` TRUE ((Date 1 3 2026) PLUS 40) ((Date 1 3 2026) PLUS 80) NOTHING EQUALS JUST TRUE
#ASSERT `s 2025(c)(8)(F) the rebuttal evidence is submitted in time` TRUE ((Date 1 3 2026) PLUS 80) ((Date 1 3 2026) PLUS 100) NOTHING EQUALS JUST TRUE
#ASSERT `s 2025(c)(8)(G) the appeal is decided in time` TRUE (JUST ((Date 1 3 2026) PLUS 100)) ((Date 1 3 2026) PLUS 40) ((Date 1 3 2026) PLUS 150) NOTHING EQUALS JUST TRUE

-- the notice of appeal on day 11, one day late
-- expected: BREACH BY a State agency (no notice of appeal within 10 days)
#TRACE `s 2025(c)(8)(D) to (G) a State agency appeals a payment claim` AT 0 WITH
    PARTY `s 2025(c)(8) a State agency` DOES `s 2025(c)(8)(D)(i) submit a notice of appeal` AT 11
#ASSERT `s 2025(c)(8)(D)(i) the notice of appeal is submitted in time` (Date 1 3 2026) ((Date 1 3 2026) PLUS 11) NOTHING EQUALS JUST FALSE
#ASSERT `s 2025(c)(8)(D)(i) the notice of appeal is submitted in time` (Date 1 3 2026) ((Date 1 3 2026) PLUS 10) NOTHING EQUALS JUST TRUE

-- the notice on day 10, then no evidence by day 61
-- expected: BREACH BY a State agency (no evidence within 60 days)
#TRACE `s 2025(c)(8)(D) to (G) a State agency appeals a payment claim` AT 0 WITH
    PARTY `s 2025(c)(8) a State agency` DOES `s 2025(c)(8)(D)(i) submit a notice of appeal` AT 10
    (WAITUNTIL 61)
#ASSERT `s 2025(c)(8)(D)(ii) the evidence in support of the appeal is submitted in time` (Date 1 3 2026) ((Date 1 3 2026) PLUS 61) NOTHING EQUALS JUST FALSE
#ASSERT `s 2025(c)(8)(D)(ii) the evidence in support of the appeal is submitted in time` (Date 1 3 2026) ((Date 1 3 2026) PLUS 60) NOTHING EQUALS JUST TRUE

-- evidence on day 60, the Secretary's response on day 121 (61 days after)
-- expected: BREACH BY the Secretary (no responsive evidence within 60 days)
#TRACE `s 2025(c)(8)(D) to (G) a State agency appeals a payment claim` AT 0 WITH
    PARTY `s 2025(c)(8) a State agency` DOES `s 2025(c)(8)(D)(i) submit a notice of appeal` AT 10
    PARTY `s 2025(c)(8) a State agency` DOES `s 2025(c)(8)(D)(ii) submit evidence in support of the appeal` AT 60
    (WAITUNTIL 121)
#ASSERT `s 2025(c)(8)(E) the responsive evidence is submitted in time` TRUE ((Date 1 3 2026) PLUS 60) ((Date 1 3 2026) PLUS 121) NOTHING EQUALS JUST FALSE
#ASSERT `s 2025(c)(8)(E) the responsive evidence is submitted in time` TRUE ((Date 1 3 2026) PLUS 60) ((Date 1 3 2026) PLUS 120) NOTHING EQUALS JUST TRUE

-- the Secretary's response on day 70, rebuttal on day 101 (31 days after)
-- expected: BREACH BY a State agency (no rebuttal evidence within 30 days)
#TRACE `s 2025(c)(8)(D) to (G) a State agency appeals a payment claim` AT 0 WITH
    PARTY `s 2025(c)(8) a State agency` DOES `s 2025(c)(8)(D)(i) submit a notice of appeal` AT 10
    PARTY `s 2025(c)(8) a State agency` DOES `s 2025(c)(8)(D)(ii) submit evidence in support of the appeal` AT 20
    PARTY `s 2025(c)(8) the Secretary` DOES `s 2025(c)(8)(E) submit responsive evidence` AT 70
    (WAITUNTIL 101)
#ASSERT `s 2025(c)(8)(F) the rebuttal evidence is submitted in time` TRUE ((Date 1 3 2026) PLUS 70) ((Date 1 3 2026) PLUS 101) NOTHING EQUALS JUST FALSE
#ASSERT `s 2025(c)(8)(F) the rebuttal evidence is submitted in time` TRUE ((Date 1 3 2026) PLUS 70) ((Date 1 3 2026) PLUS 100) NOTHING EQUALS JUST TRUE

-- rebuttal on day 40, decision on day 101 (61 days after)
-- expected: BREACH BY the administrative law judge (no decision within 60 days)
#TRACE `s 2025(c)(8)(D) to (G) a State agency appeals a payment claim` AT 0 WITH
    PARTY `s 2025(c)(8) a State agency` DOES `s 2025(c)(8)(D)(i) submit a notice of appeal` AT 10
    PARTY `s 2025(c)(8) a State agency` DOES `s 2025(c)(8)(D)(ii) submit evidence in support of the appeal` AT 20
    PARTY `s 2025(c)(8) the Secretary` DOES `s 2025(c)(8)(E) submit responsive evidence` AT 30
    PARTY `s 2025(c)(8) a State agency` DOES `s 2025(c)(8)(F) submit rebuttal evidence` AT 40
    (WAITUNTIL 101)
#ASSERT `s 2025(c)(8)(G) the appeal is decided in time` TRUE (JUST ((Date 1 3 2026) PLUS 40)) ((Date 1 3 2026) PLUS 20) ((Date 1 3 2026) PLUS 101) NOTHING EQUALS JUST FALSE
#ASSERT `s 2025(c)(8)(G) the appeal is decided in time` TRUE (JUST ((Date 1 3 2026) PLUS 40)) ((Date 1 3 2026) PLUS 20) ((Date 1 3 2026) PLUS 100) NOTHING EQUALS JUST TRUE

-- no rebuttal evidence: decision 90 days after the notice and evidence
-- expected: FULFILLED
#TRACE `s 2025(c)(8)(G)(ii) the administrative law judge decides when no rebuttal evidence is submitted` AT 0 WITH
    PARTY `s 2025(c)(8) the administrative law judge` DOES `s 2025(c)(8)(G) decide the appeal` AT 90
#ASSERT `s 2025(c)(8)(G) the appeal is decided in time` TRUE NOTHING (Date 1 3 2026) ((Date 1 3 2026) PLUS 90) NOTHING EQUALS JUST TRUE
-- expected: BREACH BY the administrative law judge (no decision within 90 days)
#TRACE `s 2025(c)(8)(G)(ii) the administrative law judge decides when no rebuttal evidence is submitted` AT 0 WITH
    (WAITUNTIL 91)
#ASSERT `s 2025(c)(8)(G) the appeal is decided in time` TRUE NOTHING (Date 1 3 2026) ((Date 1 3 2026) PLUS 91) NOTHING EQUALS JUST FALSE

§ `s 2025(k) the determination, the reduction and the appeal`

-- 180 days after June 23, 1998
-- expected: FULFILLED
#TRACE `s 2025(k)(2) the Secretary of Health and Human Services makes the determinations` AT 0 WITH
    PARTY `s 2025(k) the Secretary of Health and Human Services` DOES `s 2025(k)(2) make the determinations` AT 180
#ASSERT `s 2025(k)(2) the determinations are made as required` TRUE TRUE ((Date 23 6 1998) PLUS 180) EQUALS JUST TRUE
-- expected: BREACH BY the Secretary of Health and Human Services (not made within 180 days)
#TRACE `s 2025(k)(2) the Secretary of Health and Human Services makes the determinations` AT 0 WITH
    (WAITUNTIL 181)
#ASSERT `s 2025(k)(2) the determinations are made as required` TRUE TRUE ((Date 23 6 1998) PLUS 181) EQUALS JUST FALSE

-- (4)(A) the Secretary notifies within 5 days
-- expected: FULFILLED
#TRACE `s 2025(k)(4)(A) the Secretary notifies the chief executive officer of the State` AT 0 WITH
    PARTY `s 2025(k) the Secretary` DOES `s 2025(k)(4)(A) notify the chief executive officer of the State of the determination` AT 5
#ASSERT `s 2025(k)(4)(A) the Secretary notifies the chief executive officer in time` (Date 1 3 2000) ((Date 1 3 2000) PLUS 5) EQUALS JUST TRUE
-- expected: BREACH BY the Secretary (not notified within 5 days)
#TRACE `s 2025(k)(4)(A) the Secretary notifies the chief executive officer of the State` AT 0 WITH
    (WAITUNTIL 6)
#ASSERT `s 2025(k)(4)(A) the Secretary notifies the chief executive officer in time` (Date 1 3 2000) ((Date 1 3 2000) PLUS 6) EQUALS JUST FALSE

-- (4)(B)(i) the State may appeal within 60 days; a permission unused is not a breach
-- expected: FULFILLED
#TRACE `s 2025(k)(4)(B)(i) the State appeals to an administrative law judge` AT 0 WITH
    PARTY `s 2025(k) the State` DOES `s 2025(k)(4)(B)(i) appeal the determination to an administrative law judge` AT 60
#ASSERT `s 2025(k)(4)(B)(i) the State may appeal the determination` (Date 1 3 2000) ((Date 1 3 2000) PLUS 60) EQUALS JUST TRUE
-- expected: FULFILLED (the permission lapses)
#TRACE `s 2025(k)(4)(B)(i) the State appeals to an administrative law judge` AT 0 WITH
    (WAITUNTIL 61)
#ASSERT `s 2025(k)(4)(B)(i) the State may appeal the determination` (Date 1 3 2000) ((Date 1 3 2000) PLUS 61) EQUALS JUST FALSE

-- (4)(B)(iv) the judge decides and notifies within 60 days after the record is closed
-- expected: FULFILLED
#TRACE `s 2025(k)(4)(B)(iv) the administrative law judge decides and notifies` AT 0 WITH
    PARTY `s 2025(k) the administrative law judge` DOES `s 2025(k)(4)(B)(iv)(I) make a final decision on the appeal` AT 59
    PARTY `s 2025(k) the administrative law judge` DOES `s 2025(k)(4)(B)(iv)(II) notify the chief executive officer of the State of the decision` AT 60
#ASSERT `s 2025(k)(4)(B)(iv) the administrative law judge decides and notifies in time` (Date 15 6 2000) ((Date 15 6 2000) PLUS 59) ((Date 15 6 2000) PLUS 60) EQUALS JUST TRUE
-- expected: BREACH BY the administrative law judge (the notice is one day late)
#TRACE `s 2025(k)(4)(B)(iv) the administrative law judge decides and notifies` AT 0 WITH
    PARTY `s 2025(k) the administrative law judge` DOES `s 2025(k)(4)(B)(iv)(I) make a final decision on the appeal` AT 60
    (WAITUNTIL 61)
#ASSERT `s 2025(k)(4)(B)(iv) the administrative law judge decides and notifies in time` (Date 15 6 2000) ((Date 15 6 2000) PLUS 60) ((Date 15 6 2000) PLUS 61) EQUALS JUST FALSE

-- (4)(C)(i) the State may appeal to the Board within 30 days
-- expected: FULFILLED
#TRACE `s 2025(k)(4)(C)(i) the State appeals to the Departmental Appeals Board` AT 0 WITH
    PARTY `s 2025(k) the State` DOES `s 2025(k)(4)(C)(i) appeal the decision to the Departmental Appeals Board` AT 30
#ASSERT `s 2025(k)(4)(C)(i) the State may appeal the decision` (Date 1 3 2000) ((Date 1 3 2000) PLUS 30) EQUALS JUST TRUE
#ASSERT `s 2025(k)(4)(C)(i) the State may appeal the decision` (Date 1 3 2000) ((Date 1 3 2000) PLUS 31) EQUALS JUST FALSE

-- (4)(C)(iii) the Board decides and notifies within 60 days after the appeal is filed
-- expected: FULFILLED
#TRACE `s 2025(k)(4)(C)(iii) the Board decides and notifies` AT 0 WITH
    PARTY `s 2025(k) the Departmental Appeals Board` DOES `s 2025(k)(4)(C)(iii)(I) make a final decision on the appeal to the Board` AT 59
    PARTY `s 2025(k) the Departmental Appeals Board` DOES `s 2025(k)(4)(C)(iii)(II) notify the chief executive officer of the State of the Board decision` AT 60
#ASSERT `s 2025(k)(4)(C)(iii) the Board decides and notifies in time` (Date 1 1 2001) ((Date 1 1 2001) PLUS 59) ((Date 1 1 2001) PLUS 60) EQUALS JUST TRUE
-- expected: BREACH BY the Departmental Appeals Board (no decision by day 60)
#TRACE `s 2025(k)(4)(C)(iii) the Board decides and notifies` AT 0 WITH
    (WAITUNTIL 61)
#ASSERT `s 2025(k)(4)(C)(iii) the Board decides and notifies in time` (Date 1 1 2001) ((Date 1 1 2001) PLUS 61) ((Date 1 1 2001) PLUS 61) EQUALS JUST FALSE

§ `s 2028(b) the Commonwealth's plan, audit and statement`

-- (1)(A) the plan by July 1: day 0 is 1 June 2026, so July 1 is day 30
-- expected: FULFILLED
#TRACE `s 2028(b)(1)(A) the Commonwealth submits a plan` 30 AT 0 WITH
    PARTY `s 2028(b) the Commonwealth` DOES `s 2028(b)(1)(A) submit a plan` AT 30
#ASSERT `s 2028(b)(1)(A) the plan is submitted in time` TRUE ((Date 1 6 2026) PLUS 30) 2026 EQUALS JUST TRUE
-- expected: BREACH BY the Commonwealth (no plan by July 1)
#TRACE `s 2028(b)(1)(A) the Commonwealth submits a plan` 30 AT 0 WITH
    (WAITUNTIL 31)
#ASSERT `s 2028(b)(1)(A) the plan is submitted in time` TRUE ((Date 1 6 2026) PLUS 31) 2026 EQUALS JUST FALSE

-- (1)(B)(i) the Secretary decides no later than August 1: day 0 is 1 July 2026, so August 1 is day 31
-- expected: FULFILLED
#TRACE `s 2028(b)(1)(B)(i) the Secretary approves or disapproves the plan` 31 AT 0 WITH
    PARTY `s 2028(b) the Secretary` DOES `s 2028(b)(1)(B)(i) approve or disapprove the plan` AT 31
#ASSERT `s 2028(b)(1)(B)(i) the Secretary's decision on the plan is in time` ((Date 1 7 2026) PLUS 31) 2026 EQUALS JUST TRUE
-- expected: BREACH BY the Secretary (not decided by August 1)
#TRACE `s 2028(b)(1)(B)(i) the Secretary approves or disapproves the plan` 31 AT 0 WITH
    (WAITUNTIL 32)
#ASSERT `s 2028(b)(1)(B)(i) the Secretary's decision on the plan is in time` ((Date 1 7 2026) PLUS 32) 2026 EQUALS JUST FALSE

-- (2)(A) the audit findings within 120 days of the end of the fiscal year
-- expected: FULFILLED
#TRACE `s 2028(b)(2)(A) the Commonwealth reports the findings of the audit` AT 0 WITH
    PARTY `s 2028(b) the Commonwealth` DOES `s 2028(b)(2)(A) report the findings of the audit to the Secretary` AT 120
#ASSERT `s 2028(b)(2)(A) the report of the audit findings is in time` (Date 30 9 2026) ((Date 30 9 2026) PLUS 120) EQUALS JUST TRUE
-- expected: BREACH BY the Commonwealth (not reported within 120 days)
#TRACE `s 2028(b)(2)(A) the Commonwealth reports the findings of the audit` AT 0 WITH
    (WAITUNTIL 121)
#ASSERT `s 2028(b)(2)(A) the report of the audit findings is in time` (Date 30 9 2026) ((Date 30 9 2026) PLUS 121) EQUALS JUST FALSE

-- (2)(B) the statement within 120 days of the end of the fiscal year
-- expected: FULFILLED
#TRACE `s 2028(b)(2)(B) the Commonwealth provides the Secretary with a statement` AT 0 WITH
    PARTY `s 2028(b) the Commonwealth` DOES `s 2028(b)(2)(B) provide the Secretary with a statement` AT 120
#ASSERT `s 2028(b)(2)(B) the statement is provided in time` (Date 30 9 2026) ((Date 30 9 2026) PLUS 120) EQUALS JUST TRUE
-- expected: BREACH BY the Commonwealth (no statement within 120 days)
#TRACE `s 2028(b)(2)(B) the Commonwealth provides the Secretary with a statement` AT 0 WITH
    (WAITUNTIL 121)
#ASSERT `s 2028(b)(2)(B) the statement is provided in time` (Date 30 9 2026) ((Date 30 9 2026) PLUS 121) EQUALS JUST FALSE

§ `every declared type and constructor is used`

#ASSERT `s 2025(c)(8) a State agency` EQUALS `s 2025(c)(8) a State agency`
#ASSERT `s 2025(c)(8) the Secretary` EQUALS `s 2025(c)(8) the Secretary`
#ASSERT `s 2025(c)(8) the administrative law judge` EQUALS `s 2025(c)(8) the administrative law judge`
#ASSERT `s 2025(k) the Secretary` EQUALS `s 2025(k) the Secretary`
#ASSERT `s 2025(k) the Secretary of Health and Human Services` EQUALS `s 2025(k) the Secretary of Health and Human Services`
#ASSERT `s 2025(k) the State` EQUALS `s 2025(k) the State`
#ASSERT `s 2025(k) the administrative law judge` EQUALS `s 2025(k) the administrative law judge`
#ASSERT `s 2025(k) the Departmental Appeals Board` EQUALS `s 2025(k) the Departmental Appeals Board`
#ASSERT `s 2028(b) the Commonwealth` EQUALS `s 2028(b) the Commonwealth`
#ASSERT `s 2028(b) the Secretary` EQUALS `s 2028(b) the Secretary`
