IMPORT prelude
IMPORT daydate
IMPORT `snap-core`
IMPORT `snap1-logic`
IMPORT `snap1-s2014-hn`

-- Tests for 7 U.S.C. 2014(h) to (n). Expected values are written from the text before the code was run.

§ `s 2014(h) tests`

-- (h)(1): the class is the victims of a disaster; inside it, both "if" limbs must hold (a failed "if" is the text's no, marginal reading (a)).
#ASSERT `s 2014(h)(1) the Secretary must establish temporary emergency standards of eligibility for the household` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2014(h)(1) the Secretary must establish temporary emergency standards of eligibility for the household` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2014(h)(1) the Secretary must establish temporary emergency standards of eligibility for the household` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2014(h)(1) the Secretary must establish temporary emergency standards of eligibility for the household` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2014(h)(1) the Secretary must establish temporary emergency standards of eligibility for the household` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 2014(h)(1) the Secretary must establish temporary emergency standards of eligibility for the household` FALSE FALSE FALSE EQUALS NOTHING
-- (h)(3)(A)
#ASSERT `s 2014(h)(3)(A) the household is provided an emergency allotment to replace food destroyed in a disaster` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2014(h)(3)(A) the household is provided an emergency allotment to replace food destroyed in a disaster` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2014(h)(3)(A) the household is provided an emergency allotment to replace food destroyed in a disaster` FALSE TRUE EQUALS NOTHING
-- the value actually lost, up to a limit the Secretary approves that is not greater than the maximum monthly allotment: the least of the three
#ASSERT `s 2014(h)(3)(A) the value of the food replaced` 300 250 200 EQUALS 200
#ASSERT `s 2014(h)(3)(A) the value of the food replaced` 150 250 200 EQUALS 150
#ASSERT `s 2014(h)(3)(A) the value of the food replaced` 300 250 400 EQUALS 250
#ASSERT `s 2014(h)(3)(A) the value of the food replaced` 300 500 400 EQUALS 300
#ASSERT `s 2014(h)(3)(A) the value of the food replaced` 0 250 400 EQUALS 0
-- (h)(3)(B)
#ASSERT count `s 2014(h)(3)(B) the factors the Secretary must consider` EQUALS 3
#ASSERT any (GIVEN f YIELD f EQUALS `s 2014(h)(3)(B) the availability of the State agency's offices and personnel`) `s 2014(h)(3)(B) the factors the Secretary must consider`
#ASSERT any (GIVEN f YIELD f EQUALS `s 2014(h)(3)(B) conditions that make reliance on electronic benefit transfer systems impracticable`) `s 2014(h)(3)(B) the factors the Secretary must consider`
#ASSERT any (GIVEN f YIELD f EQUALS `s 2014(h)(3)(B) damage to or disruption of transportation and communication facilities`) `s 2014(h)(3)(B) the factors the Secretary must consider`
#ASSERT `s 2014(h)(3)(B) the Secretary must adjust the issuance methods and the reporting and other application requirements for the household` TRUE EQUALS JUST TRUE
#ASSERT `s 2014(h)(3)(B) the Secretary must adjust the issuance methods and the reporting and other application requirements for the household` FALSE EQUALS NOTHING

§ `s 2014(i) tests`

-- (2)(E): a member of the sponsor's household, or under 18, is outside the subsection.
#ASSERT `s 2014(i)(2)(E) the subsection applies to the alien` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2014(i)(2)(E) the subsection applies to the alien` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2014(i)(2)(E) the subsection applies to the alien` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2014(i)(2)(E) the subsection applies to the alien` FALSE FALSE EQUALS NOTHING
-- (1): arguments are the alien described in 2015(f)(2)(B) (MAYBE), the affidavit, member of the sponsor's household, under 18, the date of entry, the date of the determination.
-- Entry on 1 June 2024: three years run to 31 May 2027 (35 whole months), and 1 June 2027 (36) is outside.
#ASSERT `s 2014(i)(1) the income and resources of the sponsor are deemed to be the income and resources of the individual` (JUST TRUE) TRUE FALSE FALSE (Date 1 6 2024) (Date 1 6 2025) EQUALS JUST TRUE
#ASSERT `s 2014(i)(1) the income and resources of the sponsor are deemed to be the income and resources of the individual` (JUST TRUE) TRUE FALSE FALSE (Date 1 6 2024) (Date 1 6 2024) EQUALS JUST TRUE
#ASSERT `s 2014(i)(1) the income and resources of the sponsor are deemed to be the income and resources of the individual` (JUST TRUE) TRUE FALSE FALSE (Date 1 6 2024) (Date 31 5 2027) EQUALS JUST TRUE
#ASSERT `s 2014(i)(1) the income and resources of the sponsor are deemed to be the income and resources of the individual` (JUST TRUE) TRUE FALSE FALSE (Date 1 6 2024) (Date 1 6 2027) EQUALS NOTHING
#ASSERT `s 2014(i)(1) the income and resources of the sponsor are deemed to be the income and resources of the individual` (JUST TRUE) TRUE FALSE FALSE (Date 1 6 2024) (Date 31 5 2024) EQUALS NOTHING
#ASSERT `s 2014(i)(1) the income and resources of the sponsor are deemed to be the income and resources of the individual` (JUST FALSE) TRUE FALSE FALSE (Date 1 6 2024) (Date 1 6 2025) EQUALS NOTHING
#ASSERT `s 2014(i)(1) the income and resources of the sponsor are deemed to be the income and resources of the individual` NOTHING TRUE FALSE FALSE (Date 1 6 2024) (Date 1 6 2025) EQUALS NOTHING
#ASSERT `s 2014(i)(1) the income and resources of the sponsor are deemed to be the income and resources of the individual` (JUST TRUE) FALSE FALSE FALSE (Date 1 6 2024) (Date 1 6 2025) EQUALS NOTHING
#ASSERT `s 2014(i)(1) the income and resources of the sponsor are deemed to be the income and resources of the individual` (JUST TRUE) TRUE TRUE FALSE (Date 1 6 2024) (Date 1 6 2025) EQUALS JUST FALSE
#ASSERT `s 2014(i)(1) the income and resources of the sponsor are deemed to be the income and resources of the individual` (JUST TRUE) TRUE FALSE TRUE (Date 1 6 2024) (Date 1 6 2025) EQUALS JUST FALSE
-- the deemed income is unearned income of the individual
#ASSERT (`s 2014(i)(1) the deemed income as an item of the individual's income` 250)'s `monthly amount in dollars` EQUALS 250
#ASSERT (`s 2014(i)(1) the deemed income as an item of the individual's income` 250)'s `earned income` EQUALS FALSE
#ASSERT (`s 2014(i)(1) the deemed income as an item of the individual's income` 250)'s `description` EQUALS "income deemed to be the individual's under section 2014(i)"
-- (2)(A): (48,000 - 12,000) / 12 = 3,000 a month; no reduction below nothing is stated, so a standard above the income is not covered
#ASSERT `s 2014(i)(2)(A) the monthly income attributed to the alien` 48000 12000 EQUALS JUST 3000
#ASSERT `s 2014(i)(2)(A) the monthly income attributed to the alien` 36000 36000 EQUALS JUST 0
#ASSERT `s 2014(i)(2)(A) the monthly income attributed to the alien` 36000 40000 EQUALS NOTHING
#ASSERT `s 2014(i)(2)(A)(ii) the size of the sponsor's household` TRUE 2 EQUALS 4
#ASSERT `s 2014(i)(2)(A)(ii) the size of the sponsor's household` FALSE 0 EQUALS 1
#ASSERT `s 2014(i)(2)(A)(ii) the size of the sponsor's household` FALSE 3 EQUALS 4
#ASSERT `s 2014(i)(2)(A)(ii) the size of the sponsor's household` TRUE 0 EQUALS 2
-- (2)(B): reduced by $1,500; below it the text is silent
#ASSERT `s 2014(i)(2)(B) the resources deemed to be the alien's resources` 5000 EQUALS JUST 3500
#ASSERT `s 2014(i)(2)(B) the resources deemed to be the alien's resources` 1501 EQUALS JUST 1
#ASSERT `s 2014(i)(2)(B) the resources deemed to be the alien's resources` 1500 EQUALS JUST 0
#ASSERT `s 2014(i)(2)(B) the resources deemed to be the alien's resources` 1499 EQUALS NOTHING
#ASSERT `s 2014(i)(2)(B)(iii) the resources of the alien with the resources deemed` 200 (JUST 3500) EQUALS JUST 3700
#ASSERT `s 2014(i)(2)(B)(iii) the resources of the alien with the resources deemed` 200 NOTHING EQUALS NOTHING
-- (2)(C)(i): arguments are provided, entry date, determination date
#ASSERT `s 2014(i)(2)(C)(i) the alien is barred from being an eligible individual or eligible spouse for not providing the information` FALSE (Date 1 6 2024) (Date 1 6 2025) EQUALS JUST TRUE
#ASSERT `s 2014(i)(2)(C)(i) the alien is barred from being an eligible individual or eligible spouse for not providing the information` TRUE (Date 1 6 2024) (Date 1 6 2025) EQUALS JUST FALSE
#ASSERT `s 2014(i)(2)(C)(i) the alien is barred from being an eligible individual or eligible spouse for not providing the information` FALSE (Date 1 6 2024) (Date 31 5 2027) EQUALS JUST TRUE
#ASSERT `s 2014(i)(2)(C)(i) the alien is barred from being an eligible individual or eligible spouse for not providing the information` FALSE (Date 1 6 2024) (Date 1 6 2027) EQUALS NOTHING
#ASSERT `s 2014(i)(2)(C)(i) the alien is barred from being an eligible individual or eligible spouse for not providing the information` FALSE (Date 1 6 2024) (Date 31 5 2024) EQUALS NOTHING
-- (2)(D): arguments are entry date, date of the overpayment, on account of the sponsor's failure, without fault, good cause
#ASSERT `s 2014(i)(2)(D) the sponsor and the alien are jointly and severally liable for the overpayment` (Date 1 6 2024) (Date 1 6 2025) TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2014(i)(2)(D) the sponsor and the alien are jointly and severally liable for the overpayment` (Date 1 6 2024) (Date 1 6 2025) TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2014(i)(2)(D) the sponsor and the alien are jointly and severally liable for the overpayment` (Date 1 6 2024) (Date 1 6 2025) TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2014(i)(2)(D) the sponsor and the alien are jointly and severally liable for the overpayment` (Date 1 6 2024) (Date 31 5 2027) TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2014(i)(2)(D) the sponsor and the alien are jointly and severally liable for the overpayment` (Date 1 6 2024) (Date 1 6 2027) TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 2014(i)(2)(D) the sponsor and the alien are jointly and severally liable for the overpayment` (Date 1 6 2024) (Date 31 5 2024) TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 2014(i)(2)(D) the sponsor and the alien are jointly and severally liable for the overpayment` (Date 1 6 2024) (Date 1 6 2025) FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 2014(i)(2)(D) the sponsor and the alien are jointly and severally liable for the overpayment` (Date 1 6 2024) (Date 1 6 2025) FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 2014(i)(2)(D) the amount for which the sponsor and the alien are each liable` (JUST TRUE) 400 EQUALS JUST 400
#ASSERT `s 2014(i)(2)(D) the amount for which the sponsor and the alien are each liable` (JUST FALSE) 400 EQUALS JUST 0
#ASSERT `s 2014(i)(2)(D) the amount for which the sponsor and the alien are each liable` NOTHING 400 EQUALS NOTHING
#ASSERT `s 2014(i)(2)(D) the overpayment is to be recovered in accordance with section 2022(b)` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 2014(i)(2)(D) the overpayment is to be recovered in accordance with section 2022(b)` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 2014(i)(2)(D) the overpayment is to be recovered in accordance with section 2022(b)` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 2014(i)(2)(D) the overpayment is to be recovered in accordance with section 2022(b)` NOTHING TRUE EQUALS NOTHING

§ `s 2014(j) tests`

`s 2014(j) test member with SSI` MEANS Individual WITH
    `age in years` IS 40
    `physically and mentally fit` IS TRUE
    `pregnant` IS FALSE
    `immigration status` IS `a citizen or national of the United States`
    `resident of the United States` IS TRUE
    `receives supplemental security income benefits` IS TRUE
    `hours worked per week, averaged monthly` IS 0
    `enrolled at least half-time in an institution of higher education` IS FALSE
`s 2014(j) test member without SSI` MEANS Individual WITH
    `age in years` IS 40
    `physically and mentally fit` IS TRUE
    `pregnant` IS FALSE
    `immigration status` IS `a citizen or national of the United States`
    `resident of the United States` IS TRUE
    `receives supplemental security income benefits` IS FALSE
    `hours worked per week, averaged monthly` IS 0
    `enrolled at least half-time in an institution of higher education` IS FALSE

#ASSERT `s 2014(j) the member is considered to have satisfied the resource limitations of subsection (g)` `s 2014(j) test member with SSI` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2014(j) the member is considered to have satisfied the resource limitations of subsection (g)` `s 2014(j) test member without SSI` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2014(j) the member is considered to have satisfied the resource limitations of subsection (g)` `s 2014(j) test member without SSI` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 2014(j) the member is considered to have satisfied the resource limitations of subsection (g)` `s 2014(j) test member without SSI` FALSE FALSE EQUALS NOTHING

§ `s 2014(k) tests`

-- (2): each of the seven classes, and none
#ASSERT `s 2014(k)(2) paragraph (1) does not apply to the assistance` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2014(k)(2) paragraph (1) does not apply to the assistance` FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2014(k)(2) paragraph (1) does not apply to the assistance` FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2014(k)(2) paragraph (1) does not apply to the assistance` FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2014(k)(2) paragraph (1) does not apply to the assistance` FALSE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2014(k)(2) paragraph (1) does not apply to the assistance` FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2014(k)(2) paragraph (1) does not apply to the assistance` FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 2014(k)(2) paragraph (1) does not apply to the assistance` FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- (1): arguments are government third-party assistance, in lieu of TANF living expenses, in lieu of general assistance housing, in lieu of comparable housing, and the answer of (2)
#ASSERT `s 2014(k)(1) the assistance to a third party is considered money payable directly to the household` TRUE TRUE FALSE FALSE NOTHING EQUALS JUST TRUE
#ASSERT `s 2014(k)(1) the assistance to a third party is considered money payable directly to the household` TRUE FALSE TRUE FALSE NOTHING EQUALS JUST TRUE
#ASSERT `s 2014(k)(1) the assistance to a third party is considered money payable directly to the household` TRUE FALSE FALSE TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 2014(k)(1) the assistance to a third party is considered money payable directly to the household` TRUE FALSE FALSE FALSE NOTHING EQUALS JUST FALSE
#ASSERT `s 2014(k)(1) the assistance to a third party is considered money payable directly to the household` FALSE TRUE FALSE FALSE NOTHING EQUALS NOTHING
#ASSERT `s 2014(k)(1) the assistance to a third party is considered money payable directly to the household` TRUE TRUE FALSE FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 2014(k)(1) the assistance to a third party is considered money payable directly to the household` TRUE TRUE FALSE FALSE (JUST FALSE) EQUALS JUST TRUE
-- (3)
#ASSERT `s 2014(k)(3) the educational assistance is treated as money payable directly to the household` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2014(k)(3) the educational assistance is treated as money payable directly to the household` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2014(k)(3) the educational assistance is treated as money payable directly to the household` FALSE TRUE EQUALS NOTHING
-- (4)(A): a household WITHOUT an elderly or disabled member; (4)(B): a household WITH one
#ASSERT `s 2014(k)(4)(A) the energy assistance payment is considered money payable directly to the household` TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 2014(k)(4)(A) the energy assistance payment is considered money payable directly to the household` TRUE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 2014(k)(4)(A) the energy assistance payment is considered money payable directly to the household` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 2014(k)(4)(A) the energy assistance payment is considered money payable directly to the household` FALSE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 2014(k)(4)(B) the energy assistance expense is considered an out-of-pocket expense incurred and paid by the household` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2014(k)(4)(B) the energy assistance expense is considered an out-of-pocket expense incurred and paid by the household` TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 2014(k)(4)(B) the energy assistance expense is considered an out-of-pocket expense incurred and paid by the household` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 2014(k)(4)(B) the energy assistance expense is considered an out-of-pocket expense incurred and paid by the household` FALSE (JUST TRUE) EQUALS NOTHING

§ `s 2014(l) tests`

`s 2014(l) test person aged 18` MEANS Individual WITH
    `age in years` IS 18
    `physically and mentally fit` IS TRUE
    `pregnant` IS FALSE
    `immigration status` IS `a citizen or national of the United States`
    `resident of the United States` IS TRUE
    `receives supplemental security income benefits` IS FALSE
    `hours worked per week, averaged monthly` IS 20
    `enrolled at least half-time in an institution of higher education` IS FALSE
`s 2014(l) test person aged 19` MEANS Individual WITH
    `age in years` IS 19
    `physically and mentally fit` IS TRUE
    `pregnant` IS FALSE
    `immigration status` IS `a citizen or national of the United States`
    `resident of the United States` IS TRUE
    `receives supplemental security income benefits` IS FALSE
    `hours worked per week, averaged monthly` IS 20
    `enrolled at least half-time in an institution of higher education` IS FALSE

-- the dependent aged 18 is excepted, the dependent aged 19 is not, and an 18-year-old who is not a dependent is not
#ASSERT `s 2014(l) the earnings of the individual in on-the-job training are considered earned income` `s 2014(l) test person aged 18` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2014(l) the earnings of the individual in on-the-job training are considered earned income` `s 2014(l) test person aged 19` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2014(l) the earnings of the individual in on-the-job training are considered earned income` `s 2014(l) test person aged 18` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2014(l) the earnings of the individual in on-the-job training are considered earned income` `s 2014(l) test person aged 18` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2014(l) the earnings of the individual in on-the-job training are considered earned income` `s 2014(l) test person aged 19` FALSE FALSE EQUALS NOTHING

§ `s 2014(m) tests`

-- (1): arguments are submitted, designed not to increase Federal costs, approved, reasonable estimate
#ASSERT `s 2014(m)(1) the method may be used in lieu of calculating the actual cost of producing self-employment income` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2014(m)(1) the method may be used in lieu of calculating the actual cost of producing self-employment income` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 2014(m)(1) the method may be used in lieu of calculating the actual cost of producing self-employment income` TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 2014(m)(1) the method may be used in lieu of calculating the actual cost of producing self-employment income` TRUE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 2014(m)(1) the method may be used in lieu of calculating the actual cost of producing self-employment income` TRUE TRUE TRUE FALSE EQUALS NOTHING
-- (2) and (3): a method for all types, a method limited to particular types, and a method that differs by type
`s 2014(m) test estimate for sales` MEANS `s 2014(m) estimate for a type` WITH
    `s 2014(m) the type of self-employment income` IS "sales"
    `s 2014(m) the estimated income excluded under subsection (d)(9), in dollars` IS 250
`s 2014(m) test method for all types` MEANS `s 2014(m) method` WITH
    `s 2014(m) the estimate for all types of self-employment income, if the method allows one` IS JUST 100
    `s 2014(m) the estimates for particular types of self-employment income` IS EMPTY
`s 2014(m) test method limited to sales` MEANS `s 2014(m) method` WITH
    `s 2014(m) the estimate for all types of self-employment income, if the method allows one` IS NOTHING
    `s 2014(m) the estimates for particular types of self-employment income` IS LIST `s 2014(m) test estimate for sales`
`s 2014(m) test method that differs by type` MEANS `s 2014(m) method` WITH
    `s 2014(m) the estimate for all types of self-employment income, if the method allows one` IS JUST 100
    `s 2014(m) the estimates for particular types of self-employment income` IS LIST `s 2014(m) test estimate for sales`

#ASSERT `s 2014(m)(3) the estimate of the method for the type of self-employment income` `s 2014(m) test method for all types` "sales" EQUALS JUST 100
#ASSERT `s 2014(m)(3) the estimate of the method for the type of self-employment income` `s 2014(m) test method for all types` "farming" EQUALS JUST 100
#ASSERT `s 2014(m)(3) the estimate of the method for the type of self-employment income` `s 2014(m) test method limited to sales` "sales" EQUALS JUST 250
#ASSERT `s 2014(m)(3) the estimate of the method for the type of self-employment income` `s 2014(m) test method limited to sales` "farming" EQUALS NOTHING
#ASSERT `s 2014(m)(3) the estimate of the method for the type of self-employment income` `s 2014(m) test method that differs by type` "sales" EQUALS JUST 250
#ASSERT `s 2014(m)(3) the estimate of the method for the type of self-employment income` `s 2014(m) test method that differs by type` "farming" EQUALS JUST 100

§ `s 2014(n) tests`

#ASSERT `s 2014(n) the State agency may rely on information from the child support agency in lieu of obtaining current information from the household` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2014(n) the State agency may rely on information from the child support agency in lieu of obtaining current information from the household` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2014(n) the State agency may rely on information from the child support agency in lieu of obtaining current information from the household` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2014(n) the State agency may rely on information from the child support agency in lieu of obtaining current information from the household` FALSE FALSE EQUALS NOTHING

-- (i)(2)(C)(i), second sentence (arguments: it is what was provided in support of the immigration application, the State agency has requested it).
#ASSERT `s 2014(i)(2)(C)(i) the alien is required to provide the information and documentation given in support of the immigration application` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2014(i)(2)(C)(i) the alien is required to provide the information and documentation given in support of the immigration application` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2014(i)(2)(C)(i) the alien is required to provide the information and documentation given in support of the immigration application` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2014(i)(2)(C)(i) the alien is required to provide the information and documentation given in support of the immigration application` FALSE FALSE EQUALS NOTHING
