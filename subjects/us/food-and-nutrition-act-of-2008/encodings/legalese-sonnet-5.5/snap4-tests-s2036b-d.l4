IMPORT prelude
IMPORT `snap-core`
IMPORT `snap4-s2036b-d`

-- Tests for snap4-s2036b-d.l4. Every expected value is written from the text of lines 3265-3323 BEFORE running.
-- A failing assertion is a finding: no expected value here was edited to match the code.

§ `tests -- s 2036b`

-- (b)(1): additional funds provided under the section supplement the Department's integrity activities.
#ASSERT `s 2036b(b)(1) the funds supplement the retail food store and recipient integrity activities of the Department` TRUE EQUALS JUST TRUE
#ASSERT `s 2036b(b)(1) the funds supplement the retail food store and recipient integrity activities of the Department` FALSE EQUALS NOTHING
-- (b)(2): an appropriate amount of those funds goes to data mining, data warehousing and other information technologies, to administer the program and enforce the regulations.
#ASSERT `s 2036b(b)(2) the Secretary must use an appropriate amount of the funds` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2036b(b)(2) the Secretary must use an appropriate amount of the funds` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 2036b(b)(2) the Secretary must use an appropriate amount of the funds` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 2036b(b)(2) the Secretary must use an appropriate amount of the funds` TRUE TRUE FALSE EQUALS NOTHING

-- (c)(1): $5,000,000 for each of fiscal years 2014 through 2023.
#ASSERT `s 2036b(c)(1) the amount authorized to be appropriated for the fiscal year, in dollars` 2013 EQUALS NOTHING
#ASSERT `s 2036b(c)(1) the amount authorized to be appropriated for the fiscal year, in dollars` 2014 EQUALS JUST 5000000
#ASSERT `s 2036b(c)(1) the amount authorized to be appropriated for the fiscal year, in dollars` 2018 EQUALS JUST 5000000
#ASSERT `s 2036b(c)(1) the amount authorized to be appropriated for the fiscal year, in dollars` 2023 EQUALS JUST 5000000
#ASSERT `s 2036b(c)(1) the amount authorized to be appropriated for the fiscal year, in dollars` 2024 EQUALS NOTHING
-- (c)(2)(A): not less than $15,000,000 for fiscal year 2014.
#ASSERT `s 2036b(c)(2)(A) the transfer to the Secretary is as large as the text requires` 2014 15000000 EQUALS JUST TRUE
#ASSERT `s 2036b(c)(2)(A) the transfer to the Secretary is as large as the text requires` 2014 20000000 EQUALS JUST TRUE
#ASSERT `s 2036b(c)(2)(A) the transfer to the Secretary is as large as the text requires` 2014 14999999 EQUALS JUST FALSE
#ASSERT `s 2036b(c)(2)(A) the transfer to the Secretary is as large as the text requires` 2015 15000000 EQUALS NOTHING
#ASSERT `s 2036b(c)(2)(A) the transfer to the Secretary is as large as the text requires` 2015 0 EQUALS NOTHING
-- (c)(2)(A): to remain available until expended.
#ASSERT `s 2036b(c)(2)(A) the transferred funds remain available` FALSE
#ASSERT NOT (`s 2036b(c)(2)(A) the transferred funds remain available` TRUE)
-- (c)(2)(B): the Secretary receives, accepts and uses the transferred funds without further appropriation.
#ASSERT `s 2036b(c)(2)(B) the Secretary may receive, accept and use the funds without further appropriation` TRUE EQUALS JUST TRUE
#ASSERT `s 2036b(c)(2)(B) the Secretary may receive, accept and use the funds without further appropriation` FALSE EQUALS NOTHING
-- (c)(2)(C): supplement, and not supplant, other Federal funding.
#ASSERT `s 2036b(c)(2)(C) the funding supplants other Federal funding for programs carried out under this chapter` TRUE EQUALS JUST FALSE
#ASSERT `s 2036b(c)(2)(C) the funding supplants other Federal funding for programs carried out under this chapter` FALSE EQUALS NOTHING

§ `tests -- s 2036c`

-- (a): the date the Secretary specifies is in the 180-day period beginning on February 7, 2014, which ends on August 5, 2014 (fork F-3).
#ASSERT `s 2036c(a) the date specified falls within the 180-day period beginning on February 7, 2014` (Date 7 2 2014)
#ASSERT `s 2036c(a) the date specified falls within the 180-day period beginning on February 7, 2014` (Date 5 8 2014)
#ASSERT NOT (`s 2036c(a) the date specified falls within the 180-day period beginning on February 7, 2014` (Date 6 2 2014))
#ASSERT NOT (`s 2036c(a) the date specified falls within the 180-day period beginning on February 7, 2014` (Date 6 8 2014))
-- (a): the first report is due 1 year after the specified date, and the nth is due n years after it.
#ASSERT `s 2036c(a) the report was submitted by its due date` (Date 1 8 2014) 1 (Date 1 8 2015) EQUALS JUST TRUE
#ASSERT `s 2036c(a) the report was submitted by its due date` (Date 1 8 2014) 1 (Date 2 8 2015) EQUALS JUST FALSE
#ASSERT `s 2036c(a) the report was submitted by its due date` (Date 1 8 2014) 2 (Date 1 8 2016) EQUALS JUST TRUE
#ASSERT `s 2036c(a) the report was submitted by its due date` (Date 1 8 2014) 2 (Date 2 8 2016) EQUALS JUST FALSE
#ASSERT `s 2036c(a) the report was submitted by its due date` (Date 1 8 2014) 2 (Date 1 8 2015) EQUALS JUST TRUE
#ASSERT `s 2036c(a) the report was submitted by its due date` (Date 1 8 2014) 0 (Date 1 8 2014) EQUALS NOTHING
-- (a)(1), (2): sufficient information on two matters.
#ASSERT `s 2036c(a) the report must contain sufficient information on the matter` `s 2036c(a)(1) the State agency did not issue benefits to a deceased individual` EQUALS JUST TRUE
#ASSERT `s 2036c(a) the report must contain sufficient information on the matter` `s 2036c(a)(2) the State agency did not issue benefits to an individual who had been permanently disqualified from receiving benefits` EQUALS JUST TRUE
#ASSERT `s 2036c(a) the report must contain sufficient information on the matter` `s 2036c(a) some other matter` EQUALS NOTHING
-- (a): compliance is all three at once.
#ASSERT `s 2036c(a) the State agency complies with subsection (a)` TRUE TRUE TRUE
#ASSERT NOT (`s 2036c(a) the State agency complies with subsection (a)` FALSE TRUE TRUE)
#ASSERT NOT (`s 2036c(a) the State agency complies with subsection (a)` TRUE FALSE TRUE)
#ASSERT NOT (`s 2036c(a) the State agency complies with subsection (a)` TRUE TRUE FALSE)
-- (b): a penalty for a fiscal year of non-compliance, with a reduction of up to 50 percent of the amount otherwise payable.
#ASSERT `s 2036c(b) the Secretary must impose a penalty for the fiscal year` TRUE EQUALS JUST TRUE
#ASSERT `s 2036c(b) the Secretary must impose a penalty for the fiscal year` FALSE EQUALS NOTHING
#ASSERT `s 2036c(b) the reduction is within the limit` 50 EQUALS JUST TRUE
#ASSERT `s 2036c(b) the reduction is within the limit` 0 EQUALS JUST TRUE
#ASSERT `s 2036c(b) the reduction is within the limit` 49.5 EQUALS JUST TRUE
#ASSERT `s 2036c(b) the reduction is within the limit` 50.5 EQUALS JUST FALSE
#ASSERT `s 2036c(b) the reduction is within the limit` 51 EQUALS JUST FALSE
#ASSERT `s 2036c(b) the largest reduction, in dollars` 1000000 EQUALS 500000
#ASSERT `s 2036c(b) the largest reduction, in dollars` 200 EQUALS 100
#ASSERT `s 2036c(b) the largest reduction, in dollars` 0 EQUALS 0
-- (c): not later than 90 days after completion: 1 March 2020 plus 90 days is 30 May 2020.
#ASSERT `s 2036c(c) the report was submitted within 90 days after the completion of the pilot program` (Date 1 3 2020) (Date 30 5 2020)
#ASSERT `s 2036c(c) the report was submitted within 90 days after the completion of the pilot program` (Date 1 3 2020) (Date 1 3 2020)
#ASSERT NOT (`s 2036c(c) the report was submitted within 90 days after the completion of the pilot program` (Date 1 3 2020) (Date 31 5 2020))
#ASSERT `s 2036c(c) the report must assess the matter` `s 2036c(c) the feasibility for the expansion of the pilot program nationwide` EQUALS JUST TRUE
#ASSERT `s 2036c(c) the report must assess the matter` `s 2036c(c) the effectiveness for the expansion of the pilot program nationwide` EQUALS JUST TRUE
#ASSERT `s 2036c(c) the report must assess the matter` `s 2036c(c) the cost for the expansion of the pilot program nationwide` EQUALS JUST TRUE
#ASSERT `s 2036c(c) the report must assess the matter` `s 2036c(c) some other matter` EQUALS NOTHING

§ `tests -- s 2036d`

-- (a): on application, not more than 10 pilot projects.
#ASSERT `s 2036d(a) the Secretary may approve a pilot project` TRUE 0 EQUALS JUST TRUE
#ASSERT `s 2036d(a) the Secretary may approve a pilot project` TRUE 9 EQUALS JUST TRUE
#ASSERT `s 2036d(a) the Secretary may approve a pilot project` TRUE 10 EQUALS JUST FALSE
#ASSERT `s 2036d(a) the Secretary may approve a pilot project` FALSE 3 EQUALS NOTHING
#ASSERT `s 2036d(a) the Secretary may approve a pilot project` FALSE 10 EQUALS JUST FALSE
-- (b)(1): eligible entity means a nonprofit, a community-based organization, an institution of higher education, or a private entity as the Secretary determines.
#ASSERT `s 2036d(b)(1) the entity is an eligible entity` `s 2036d(b)(1)(A) a nonprofit organization` NOTHING EQUALS JUST TRUE
#ASSERT `s 2036d(b)(1) the entity is an eligible entity` `s 2036d(b)(1)(B) a community-based organization` NOTHING EQUALS JUST TRUE
#ASSERT `s 2036d(b)(1) the entity is an eligible entity` `s 2036d(b)(1)(C) an institution of higher education` NOTHING EQUALS JUST TRUE
#ASSERT `s 2036d(b)(1) the entity is an eligible entity` `s 2036d(b)(1)(D) a private entity` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2036d(b)(1) the entity is an eligible entity` `s 2036d(b)(1)(D) a private entity` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2036d(b)(1) the entity is an eligible entity` `s 2036d(b)(1)(D) a private entity` NOTHING EQUALS NOTHING
#ASSERT `s 2036d(b)(1) the entity is an eligible entity` `s 2036d(b)(1) some other kind of entity` (JUST TRUE) EQUALS JUST FALSE
-- (b)(2): public agency means a department, agency, other unit, or instrumentality of Federal, State, or local government.
#ASSERT `s 2036d(b)(2) the body is a public agency` TRUE `s 2036d(b)(2) Federal government` EQUALS JUST TRUE
#ASSERT `s 2036d(b)(2) the body is a public agency` TRUE `s 2036d(b)(2) State government` EQUALS JUST TRUE
#ASSERT `s 2036d(b)(2) the body is a public agency` TRUE `s 2036d(b)(2) local government` EQUALS JUST TRUE
#ASSERT `s 2036d(b)(2) the body is a public agency` TRUE `s 2036d(b)(2) some other government` EQUALS JUST FALSE
#ASSERT `s 2036d(b)(2) the body is a public agency` FALSE `s 2036d(b)(2) Federal government` EQUALS JUST FALSE
#ASSERT `s 2036d(b)(2) the body is a public agency` FALSE `s 2036d(b)(2) some other government` EQUALS JUST FALSE
-- (c)(1): limited to 2 years in length.
#ASSERT `s 2036d(c)(1) the approved project's length is within the limit` 24 EQUALS JUST TRUE
#ASSERT `s 2036d(c)(1) the approved project's length is within the limit` 12 EQUALS JUST TRUE
#ASSERT `s 2036d(c)(1) the approved project's length is within the limit` 25 EQUALS JUST FALSE
-- (c)(2): a collaboration of one or more public agencies and one or more eligible entities, with three effects.
#ASSERT `s 2036d(c)(2) the approved project includes the collaboration the text requires` 1 1 TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2036d(c)(2) the approved project includes the collaboration the text requires` 3 2 TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2036d(c)(2) the approved project includes the collaboration the text requires` 0 1 TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 2036d(c)(2) the approved project includes the collaboration the text requires` 1 0 TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 2036d(c)(2) the approved project includes the collaboration the text requires` 1 1 FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 2036d(c)(2) the approved project includes the collaboration the text requires` 1 1 TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 2036d(c)(2) the approved project includes the collaboration the text requires` 1 1 TRUE TRUE FALSE EQUALS NOTHING
-- (d): the independent evaluation includes three things.
#ASSERT `s 2036d(d) the independent evaluation must include the element` `s 2036d(d)(1) a summary of the activities conducted under the pilot projects` EQUALS JUST TRUE
#ASSERT `s 2036d(d) the independent evaluation must include the element` `s 2036d(d)(2) an assessment of the effectiveness of the pilot projects` EQUALS JUST TRUE
#ASSERT `s 2036d(d) the independent evaluation must include the element` `s 2036d(d)(3) best practices regarding the use of public-private partnerships to improve the effectiveness of public benefit programs to address food insecurity and poverty` EQUALS JUST TRUE
#ASSERT `s 2036d(d) the independent evaluation must include the element` `s 2036d(d) any other element` EQUALS NOTHING
-- (e)(1): $5,000,000. (e)(2): only advance appropriations made specifically for the section under paragraph (1).
#ASSERT `s 2036d(e)(1) the amount authorized to be appropriated, in dollars` EQUALS 5000000
#ASSERT `s 2036d(e)(2) the funds are available to carry out the section` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2036d(e)(2) the funds are available to carry out the section` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2036d(e)(2) the funds are available to carry out the section` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2036d(e)(2) the funds are available to carry out the section` TRUE TRUE FALSE EQUALS JUST FALSE
