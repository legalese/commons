IMPORT prelude
IMPORT daydate
IMPORT `snap-core`
IMPORT `snap3-s2024`

-- TESTS for section 2024 (snap3-s2024.l4). Every expected value is worked out from the text of section 2024 and written beside the assertion, BEFORE running.
-- A punishment is written `s 2024 punishment` OF grade, most fine, least years, most years, imprisonment must be imposed.

§ `Tests -- s 2024(a)`

#ASSERT `s 2024(a) the Secretary may provide for the issuance or presentment for redemption of benefits to such person or persons, at such times and in such manner` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2024(a) the Secretary may provide for the issuance or presentment for redemption of benefits to such person or persons, at such times and in such manner` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 2024(a) the Secretary may provide for the issuance or presentment for redemption of benefits to such person or persons, at such times and in such manner` NOTHING EQUALS NOTHING

§ `Tests -- s 2024(b)(1) the offence and its punishment`

-- arguments: knowingly, one of the five acts, contrary to the chapter or regulations
#ASSERT `s 2024(b)(1) the person commits the offence` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2024(b)(1) the person commits the offence` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 2024(b)(1) the person commits the offence` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 2024(b)(1) the person commits the offence` TRUE TRUE FALSE EQUALS NOTHING
-- the punishment: arguments are the value of the benefits and whether it is the second or a subsequent conviction
-- $5,000 or more: a felony, a fine of not more than $250,000 or imprisonment of not more than twenty years, or both; the text does not distinguish first from later convictions here
#ASSERT `s 2024(b)(1) the punishment for the offence` 5000 FALSE EQUALS JUST (`s 2024 punishment` OF `s 2024 a felony`, 250000, 0, 20, FALSE)
#ASSERT `s 2024(b)(1) the punishment for the offence` 5000 TRUE EQUALS JUST (`s 2024 punishment` OF `s 2024 a felony`, 250000, 0, 20, FALSE)
#ASSERT `s 2024(b)(1) the punishment for the offence` 1000000 TRUE EQUALS JUST (`s 2024 punishment` OF `s 2024 a felony`, 250000, 0, 20, FALSE)
-- $4,999.99: under $5,000, so the middle band: a felony; first conviction a fine of not more than $10,000 or imprisonment of not more than five years, or both
#ASSERT `s 2024(b)(1) the punishment for the offence` 4999.99 FALSE EQUALS JUST (`s 2024 punishment` OF `s 2024 a felony`, 10000, 0, 5, FALSE)
-- second and any subsequent conviction: imprisoned for not less than six months nor more than five years, and may also be fined not more than $10,000
#ASSERT `s 2024(b)(1) the punishment for the offence` 4999.99 TRUE EQUALS JUST (`s 2024 punishment` OF `s 2024 a felony`, 10000, 0.5, 5, TRUE)
-- $100 exactly is "$100 or more": the middle band
#ASSERT `s 2024(b)(1) the punishment for the offence` 100 FALSE EQUALS JUST (`s 2024 punishment` OF `s 2024 a felony`, 10000, 0, 5, FALSE)
#ASSERT `s 2024(b)(1) the punishment for the offence` 100 TRUE EQUALS JUST (`s 2024 punishment` OF `s 2024 a felony`, 10000, 0.5, 5, TRUE)
-- $99.99: "less than $100": a misdemeanor; first conviction a fine of not more than $1,000 or imprisonment of not more than one year, or both
#ASSERT `s 2024(b)(1) the punishment for the offence` 99.99 FALSE EQUALS JUST (`s 2024 punishment` OF `s 2024 a misdemeanor`, 1000, 0, 1, FALSE)
-- second and any subsequent conviction: imprisoned for not more than one year, and may also be fined not more than $1,000
#ASSERT `s 2024(b)(1) the punishment for the offence` 99.99 TRUE EQUALS JUST (`s 2024 punishment` OF `s 2024 a misdemeanor`, 1000, 0, 1, TRUE)
-- a value of nothing is "less than $100"
#ASSERT `s 2024(b)(1) the punishment for the offence` 0 FALSE EQUALS JUST (`s 2024 punishment` OF `s 2024 a misdemeanor`, 1000, 0, 1, FALSE)
-- a value below zero is not a value of benefits: the text does not say
#ASSERT `s 2024(b)(1) the punishment for the offence` (0 MINUS 1) FALSE EQUALS NOTHING
-- the additional suspension: "up to eighteen months"
#ASSERT `s 2024(b)(1) the court may suspend the person for the additional period` TRUE 18 EQUALS JUST TRUE
#ASSERT `s 2024(b)(1) the court may suspend the person for the additional period` TRUE 6 EQUALS JUST TRUE
#ASSERT `s 2024(b)(1) the court may suspend the person for the additional period` TRUE 18.5 EQUALS NOTHING
#ASSERT `s 2024(b)(1) the court may suspend the person for the additional period` FALSE 12 EQUALS NOTHING
#ASSERT `s 2024(b)(1) the longest additional suspension` TRUE EQUALS JUST (`for a number of months` 18)
#ASSERT `s 2024(b)(1) the longest additional suspension` FALSE EQUALS NOTHING

§ `Tests -- s 2024(b)(2) work approved by the court for restitution`

#ASSERT `s 2024(b)(2) the court may permit the individual to perform work approved by the court for restitution` TRUE EQUALS JUST TRUE
#ASSERT `s 2024(b)(2) the court may permit the individual to perform work approved by the court for restitution` FALSE EQUALS NOTHING
-- arguments: the court permits the work, the individual agrees
#ASSERT `s 2024(b)(2) the court must withhold the imposition of the sentence on the condition that the work is performed` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2024(b)(2) the court must withhold the imposition of the sentence on the condition that the work is performed` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2024(b)(2) the court must withhold the imposition of the sentence on the condition that the work is performed` FALSE TRUE EQUALS NOTHING
-- arguments: the court withheld the sentence on condition, the work was successfully completed
#ASSERT `s 2024(b)(2) the court may suspend the sentence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2024(b)(2) the court may suspend the sentence` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2024(b)(2) the court may suspend the sentence` FALSE TRUE EQUALS NOTHING

§ `Tests -- s 2024(c) presentation for payment or redemption`

-- arguments: presented, or caused to be presented, benefits for payment or redemption; knew they had been received, transferred or used in violation
#ASSERT `s 2024(c) the person commits the offence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2024(c) the person commits the offence` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2024(c) the person commits the offence` FALSE TRUE EQUALS NOTHING
-- $100 or more: a felony; first conviction a fine of not more than $20,000 or imprisonment of not more than five years, or both
#ASSERT `s 2024(c) the punishment for the offence` 100 FALSE EQUALS JUST (`s 2024 punishment` OF `s 2024 a felony`, 20000, 0, 5, FALSE)
-- second and any subsequent conviction: imprisoned for not less than one year nor more than five years, and may also be fined not more than $20,000
#ASSERT `s 2024(c) the punishment for the offence` 100 TRUE EQUALS JUST (`s 2024 punishment` OF `s 2024 a felony`, 20000, 1, 5, TRUE)
#ASSERT `s 2024(c) the punishment for the offence` 250000 FALSE EQUALS JUST (`s 2024 punishment` OF `s 2024 a felony`, 20000, 0, 5, FALSE)
-- under $100: a misdemeanor; first conviction a fine of not more than $1,000 or imprisonment of not more than one year, or both; later, imprisoned for not more than one year and may also be fined
#ASSERT `s 2024(c) the punishment for the offence` 99.99 FALSE EQUALS JUST (`s 2024 punishment` OF `s 2024 a misdemeanor`, 1000, 0, 1, FALSE)
#ASSERT `s 2024(c) the punishment for the offence` 99.99 TRUE EQUALS JUST (`s 2024 punishment` OF `s 2024 a misdemeanor`, 1000, 0, 1, TRUE)
#ASSERT `s 2024(c) the punishment for the offence` 0 FALSE EQUALS JUST (`s 2024 punishment` OF `s 2024 a misdemeanor`, 1000, 0, 1, FALSE)
#ASSERT `s 2024(c) the punishment for the offence` (0 MINUS 5) TRUE EQUALS NOTHING
#ASSERT `s 2024(c) the court may suspend the person for the additional period` TRUE 18 EQUALS JUST TRUE
#ASSERT `s 2024(c) the court may suspend the person for the additional period` TRUE 19 EQUALS NOTHING
#ASSERT `s 2024(c) the court may suspend the person for the additional period` FALSE 1 EQUALS NOTHING

§ `Tests -- s 2024(d), (e)`

#ASSERT `s 2024(d) the benefits are deemed to be obligations of the United States within the meaning of section 8 of title 18` TRUE EQUALS JUST TRUE
#ASSERT `s 2024(d) the benefits are deemed to be obligations of the United States within the meaning of section 8 of title 18` FALSE EQUALS NOTHING
-- (e) arguments: furnished in exchange for benefits or obtained by use of an access device, in a manner contrary to the chapter or regulations
#ASSERT `s 2024(e) the Secretary may subject the property to forfeiture and denial of property rights` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2024(e) the Secretary may subject the property to forfeiture and denial of property rights` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2024(e) the Secretary may subject the property to forfeiture and denial of property rights` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2024(e) the forfeiture and disposal were conducted as the subsection requires` TRUE EQUALS JUST TRUE
#ASSERT `s 2024(e) the forfeiture and disposal were conducted as the subsection requires` FALSE EQUALS JUST FALSE

§ `Tests -- s 2024(f) criminal forfeiture`

#ASSERT `s 2024(f)(1) the court must order the person to forfeit to the United States all property described in paragraph (2)` TRUE EQUALS JUST TRUE
#ASSERT `s 2024(f)(1) the court must order the person to forfeit to the United States all property described in paragraph (2)` FALSE EQUALS NOTHING
-- (f)(2) arguments: used in a transaction to commit or facilitate a violation, the violation was a misdemeanor, proceeds traceable to a violation
#ASSERT `s 2024(f)(2) the property is subject to forfeiture to the United States` TRUE FALSE FALSE EQUALS JUST TRUE
-- "a violation (other than a misdemeanor)": property used in a misdemeanor violation is not caught by the first limb
#ASSERT `s 2024(f)(2) the property is subject to forfeiture to the United States` TRUE TRUE FALSE EQUALS JUST FALSE
-- proceeds traceable to a violation are caught whatever the grade
#ASSERT `s 2024(f)(2) the property is subject to forfeiture to the United States` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2024(f)(2) the property is subject to forfeiture to the United States` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 2024(f)(2) the property is subject to forfeiture to the United States` FALSE FALSE FALSE EQUALS NOTHING
-- (f)(3)
#ASSERT `s 2024(f)(3) the interest of the owner in the property may be forfeited as the result of the act or omission` TRUE EQUALS JUST FALSE
#ASSERT `s 2024(f)(3) the interest of the owner in the property may be forfeited as the result of the act or omission` FALSE EQUALS NOTHING
-- (f)(4) arguments: the proceeds, then the costs of (A) the Department of Justice, (B) the Office of Inspector General, (C) law enforcement agencies
-- 1000 covers 300 + 200 + 100 = 600 and leaves 400 for (D)
#ASSERT `s 2024(f)(4) the application of the proceeds` 1000 300 200 100 EQUALS `s 2024(f)(4) application of proceeds` OF 300, 200, 100, 400
-- 450: (A) takes 300, (B) the 150 left of its 200, (C) nothing, (D) nothing
#ASSERT `s 2024(f)(4) the application of the proceeds` 450 300 200 100 EQUALS `s 2024(f)(4) application of proceeds` OF 300, 150, 0, 0
-- 250 does not cover (A) in full
#ASSERT `s 2024(f)(4) the application of the proceeds` 250 300 200 100 EQUALS `s 2024(f)(4) application of proceeds` OF 250, 0, 0, 0
-- exactly 600 covers all three costs and leaves nothing; 601 leaves 1
#ASSERT `s 2024(f)(4) the application of the proceeds` 600 300 200 100 EQUALS `s 2024(f)(4) application of proceeds` OF 300, 200, 100, 0
#ASSERT `s 2024(f)(4) the application of the proceeds` 601 300 200 100 EQUALS `s 2024(f)(4) application of proceeds` OF 300, 200, 100, 1
#ASSERT `s 2024(f)(4) the application of the proceeds` 0 300 200 100 EQUALS `s 2024(f)(4) application of proceeds` OF 0, 0, 0, 0

§ `Tests -- every constructor declared in snap3-s2024.l4 is built once`

#ASSERT `s 2024 a felony` EQUALS `s 2024 a felony`
#ASSERT `s 2024 a misdemeanor` EQUALS `s 2024 a misdemeanor`
#ASSERT NOT (`s 2024 a felony` EQUALS `s 2024 a misdemeanor`)
#ASSERT (`s 2024 punishment` OF `s 2024 a felony`, 1, 2, 3, TRUE)'s `s 2024 the most the fine may be, in dollars` EQUALS 1
#ASSERT (`s 2024 punishment` OF `s 2024 a felony`, 1, 2, 3, TRUE)'s `s 2024 the least term of imprisonment, in years` EQUALS 2
#ASSERT (`s 2024 punishment` OF `s 2024 a felony`, 1, 2, 3, TRUE)'s `s 2024 the most term of imprisonment, in years` EQUALS 3
#ASSERT (`s 2024 punishment` OF `s 2024 a felony`, 1, 2, 3, TRUE)'s `s 2024 imprisonment must be imposed` EQUALS TRUE
#ASSERT (`s 2024 punishment` OF `s 2024 a felony`, 1, 2, 3, TRUE)'s `s 2024 the grade of the offence` EQUALS `s 2024 a felony`
#ASSERT (`s 2024(f)(4) application of proceeds` OF 1, 2, 3, 4)'s `s 2024(f)(4)(A) to reimburse the Department of Justice` EQUALS 1
#ASSERT (`s 2024(f)(4) application of proceeds` OF 1, 2, 3, 4)'s `s 2024(f)(4)(B) to reimburse the Department of Agriculture Office of Inspector General` EQUALS 2
#ASSERT (`s 2024(f)(4) application of proceeds` OF 1, 2, 3, 4)'s `s 2024(f)(4)(C) to reimburse any Federal or State law enforcement agency` EQUALS 3
#ASSERT (`s 2024(f)(4) application of proceeds` OF 1, 2, 3, 4)'s `s 2024(f)(4)(D) to the Secretary for retail store and wholesale food concern investigations` EQUALS 4
