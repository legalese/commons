-- helper: a person (fields no assertion below depends on are fixed to ordinary values)
GIVEN age IS A NUMBER
      ssi IS A BOOLEAN
GIVETH AN Individual
`t person` MEANS Individual WITH
    `age in years` IS age
    `physically and mentally fit` IS TRUE
    `pregnant` IS FALSE
    `immigration status` IS `a citizen or national of the United States`
    `resident of the United States` IS TRUE
    `receives supplemental security income benefits` IS ssi
    `hours worked per week, averaged monthly` IS 0
    `enrolled at least half-time in an institution of higher education` IS FALSE

-- helper: a benefit paid by EBT for the month beginning on the given day
GIVEN v IS A NUMBER
      d IS A DATE
GIVETH A Benefit
`t benefit` MEANS Benefit WITH
    `value in dollars` IS v
    `form` IS `an electronic benefit transfer under section 2016(h)`
    `month it is for begins` IS d

-- helpers: read one field of the punishment record the encoding returns (s 2024)
GIVEN p IS A MAYBE `s 2024 punishment`
GIVETH A MAYBE NUMBER
`t most fine of` MEANS
    CONSIDER p
    WHEN NOTHING THEN NOTHING
    WHEN JUST x THEN JUST (x's `s 2024 the most the fine may be, in dollars`)

GIVEN p IS A MAYBE `s 2024 punishment`
GIVETH A MAYBE NUMBER
`t most prison of` MEANS
    CONSIDER p
    WHEN NOTHING THEN NOTHING
    WHEN JUST x THEN JUST (x's `s 2024 the most term of imprisonment, in years`)

GIVEN p IS A MAYBE `s 2024 punishment`
GIVETH A MAYBE NUMBER
`t least prison of` MEANS
    CONSIDER p
    WHEN NOTHING THEN NOTHING
    WHEN JUST x THEN JUST (x's `s 2024 the least term of imprisonment, in years`)

GIVEN p IS A MAYBE `s 2024 punishment`
GIVETH A MAYBE `s 2024 grade of offence`
`t grade of` MEANS
    CONSIDER p
    WHEN NOTHING THEN NOTHING
    WHEN JUST x THEN JUST (x's `s 2024 the grade of the offence`)
