IMPORT prelude
IMPORT daydate
IMPORT `snap-core`
IMPORT `snap3-s2023`

-- TESTS for section 2023 (snap3-s2023.l4). Every expected value is worked out from the text and written beside the assertion, BEFORE running.

§ `Tests -- s 2023(a)(1) and (2) notice`

-- arguments: the action, the party involved
#ASSERT `s 2023(a)(1) notice of the administrative action must be issued to the party involved` `s 2023(a)(1) denial of an application of a retail food store or wholesale food concern to participate, under section 2018` `a retail food store` EQUALS JUST TRUE
#ASSERT `s 2023(a)(1) notice of the administrative action must be issued to the party involved` `s 2023(a)(1) denial of an application of a retail food store or wholesale food concern to participate, under section 2018` `a wholesale food concern` EQUALS JUST TRUE
#ASSERT `s 2023(a)(1) notice of the administrative action must be issued to the party involved` `s 2023(a)(1) denial of an application of a retail food store or wholesale food concern to participate, under section 2018` `the State agency` EQUALS NOTHING
#ASSERT `s 2023(a)(1) notice of the administrative action must be issued to the party involved` `s 2023(a)(1) disqualification or a civil money penalty under section 2021` `a retail food store` EQUALS JUST TRUE
#ASSERT `s 2023(a)(1) notice of the administrative action must be issued to the party involved` `s 2023(a)(1) forfeiture of a bond under section 2021(d)` `a wholesale food concern` EQUALS JUST TRUE
#ASSERT `s 2023(a)(1) notice of the administrative action must be issued to the party involved` `s 2023(a)(1) denial of all or part of a claim of a retail food store or wholesale food concern under section 2022` `a retail food store` EQUALS JUST TRUE
#ASSERT `s 2023(a)(1) notice of the administrative action must be issued to the party involved` `s 2023(a)(1) a claim against a State agency stated under section 2022` `the State agency` EQUALS JUST TRUE
#ASSERT `s 2023(a)(1) notice of the administrative action must be issued to the party involved` `s 2023(a)(1) a claim against a State agency stated under section 2022` `a retail food store` EQUALS NOTHING
#ASSERT `s 2023(a)(1) notice of the administrative action must be issued to the party involved` `s 2023(a)(1) any other action` `a retail food store` EQUALS NOTHING
#ASSERT `s 2023(a)(1) notice of the administrative action must be issued to the party involved` `s 2023(a)(1) disqualification or a civil money penalty under section 2021` `the household` EQUALS NOTHING
#ASSERT `s 2023(a)(2) the form of delivery meets the requirement` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2023(a)(2) the form of delivery meets the requirement` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2023(a)(2) the form of delivery meets the requirement` NOTHING EQUALS NOTHING

§ `Tests -- s 2023(a)(3) to (5) the request and the determination`

-- (3): arguments are aggrieved, the date of delivery, the date the request is filed. The tenth day counts.
#ASSERT `s 2023(a)(3) the written request was filed in time` TRUE (Date 1 1 2026) (Date 1 1 2026) EQUALS JUST TRUE
#ASSERT `s 2023(a)(3) the written request was filed in time` TRUE (Date 1 1 2026) (Date 11 1 2026) EQUALS JUST TRUE
#ASSERT `s 2023(a)(3) the written request was filed in time` TRUE (Date 1 1 2026) (Date 12 1 2026) EQUALS JUST FALSE
-- across a month end: 25 January plus 10 days is 4 February
#ASSERT `s 2023(a)(3) the written request was filed in time` TRUE (Date 25 1 2026) (Date 4 2 2026) EQUALS JUST TRUE
#ASSERT `s 2023(a)(3) the written request was filed in time` TRUE (Date 25 1 2026) (Date 5 2 2026) EQUALS JUST FALSE
#ASSERT `s 2023(a)(3) the written request was filed in time` FALSE (Date 1 1 2026) (Date 5 1 2026) EQUALS NOTHING
-- (4): arguments are a request is made, information is submitted after filing it
#ASSERT `s 2023(a)(4) the administrative determination is final` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2023(a)(4) the administrative determination is final` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 2023(a)(4) the administrative determination is final` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2023(a)(4) the administrative determination is final` TRUE TRUE EQUALS NOTHING
-- (5): arguments are a request is made, the date of delivery or service of the final notice
#ASSERT `s 2023(a)(5) the date on which the determination takes effect` TRUE (Date 1 1 2026) EQUALS JUST (Date 31 1 2026)
#ASSERT `s 2023(a)(5) the date on which the determination takes effect` TRUE (Date 15 1 2026) EQUALS JUST (Date 14 2 2026)
#ASSERT `s 2023(a)(5) the date on which the determination takes effect` FALSE (Date 1 1 2026) EQUALS NOTHING
#ASSERT `s 2023(a)(5) the determination made after review is final` TRUE EQUALS JUST TRUE
#ASSERT `s 2023(a)(5) the determination made after review is final` FALSE EQUALS NOTHING

§ `Tests -- s 2023(a)(6) to (12) claims under section 2025(c)`

#ASSERT `s 2023(a)(6) the determination must be made on the record after an opportunity for an agency hearing` TRUE EQUALS JUST TRUE
#ASSERT `s 2023(a)(6) the determination must be made on the record after an opportunity for an agency hearing` FALSE EQUALS NOTHING
#ASSERT `s 2023(a)(7) the judge has authority to issue and enforce subpoenas in the manner prescribed in sections 499m(c) and (d)` TRUE EQUALS JUST TRUE
#ASSERT `s 2023(a)(7) the judge has authority to issue and enforce subpoenas in the manner prescribed in sections 499m(c) and (d)` FALSE EQUALS NOTHING
#ASSERT `s 2023(a)(7) the judge has authority to appoint expert witnesses under the provisions of Rule 706 of the Federal Rules of Evidence` TRUE EQUALS JUST TRUE
#ASSERT `s 2023(a)(7) the judge has authority to appoint expert witnesses under the provisions of Rule 706 of the Federal Rules of Evidence` FALSE EQUALS NOTHING
#ASSERT `s 2023(a)(8) the Secretary may limit the authority of the judge` TRUE EQUALS JUST FALSE
#ASSERT `s 2023(a)(8) the Secretary may limit the authority of the judge` FALSE EQUALS NOTHING
-- (9): arguments are a claim under section 2025(c), the amount of the claim. $50,000 exactly is not "less than $50,000".
#ASSERT `s 2023(a)(9) the Secretary must provide a summary procedure for the claim` TRUE 49999.99 EQUALS JUST TRUE
#ASSERT `s 2023(a)(9) the Secretary must provide a summary procedure for the claim` TRUE 0 EQUALS JUST TRUE
#ASSERT `s 2023(a)(9) the Secretary must provide a summary procedure for the claim` TRUE 50000 EQUALS NOTHING
#ASSERT `s 2023(a)(9) the Secretary must provide a summary procedure for the claim` FALSE 100 EQUALS NOTHING
#ASSERT `s 2023(a)(10) the procedure must include an oral hearing` TRUE EQUALS JUST FALSE
#ASSERT `s 2023(a)(10) the procedure must include an oral hearing` FALSE EQUALS NOTHING
-- (11): arguments are a petition by the State agency or the Secretary acting sua sponte, the amount of the claim
#ASSERT `s 2023(a)(11) the Secretary may permit the full administrative review procedure to be used in lieu of the summary review procedure` TRUE 49999 EQUALS JUST TRUE
#ASSERT `s 2023(a)(11) the Secretary may permit the full administrative review procedure to be used in lieu of the summary review procedure` TRUE 50000 EQUALS NOTHING
#ASSERT `s 2023(a)(11) the Secretary may permit the full administrative review procedure to be used in lieu of the summary review procedure` FALSE 100 EQUALS NOTHING
-- (12): arguments are a determination of an administrative law judge on a section 2025(c) claim, the date of delivery or service
#ASSERT `s 2023(a)(12) the date on which the administrative law judge's determination takes effect` TRUE (Date 1 3 2026) EQUALS JUST (Date 31 3 2026)
#ASSERT `s 2023(a)(12) the date on which the administrative law judge's determination takes effect` FALSE (Date 1 3 2026) EQUALS NOTHING

§ `Tests -- s 2023(a)(13) to (18) judicial review`

-- (13): arguments are aggrieved, the date of the final notice, the date the complaint is filed. The thirtieth day counts.
#ASSERT `s 2023(a)(13) the complaint was filed in time` TRUE (Date 1 1 2026) (Date 31 1 2026) EQUALS JUST TRUE
#ASSERT `s 2023(a)(13) the complaint was filed in time` TRUE (Date 1 1 2026) (Date 1 2 2026) EQUALS JUST FALSE
#ASSERT `s 2023(a)(13) the complaint was filed in time` TRUE (Date 15 1 2026) (Date 14 2 2026) EQUALS JUST TRUE
#ASSERT `s 2023(a)(13) the complaint was filed in time` TRUE (Date 15 1 2026) (Date 15 2 2026) EQUALS JUST FALSE
#ASSERT `s 2023(a)(13) the complaint was filed in time` FALSE (Date 1 1 2026) (Date 5 1 2026) EQUALS NOTHING
-- the court: arguments are the party filing, a United States court for its district, a court of record of the State
#ASSERT `s 2023(a)(13) the complaint may be filed in the court` `a retail food store` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2023(a)(13) the complaint may be filed in the court` `the State agency` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2023(a)(13) the complaint may be filed in the court` `a retail food store` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 2023(a)(13) the complaint may be filed in the court` `a wholesale food concern` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 2023(a)(13) the complaint may be filed in the court` `the State agency` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2023(a)(13) the complaint may be filed in the court` `a retail food store` FALSE FALSE EQUALS NOTHING
#ASSERT `s 2023(a)(14) the copy of the summons and complaint has been sent as the paragraph requires` TRUE EQUALS JUST TRUE
#ASSERT `s 2023(a)(14) the copy of the summons and complaint has been sent as the paragraph requires` FALSE EQUALS NOTHING
#ASSERT `s 2023(a)(15) the court reviews the determination by` TRUE EQUALS `s 2023(a)(15) review on the administrative record`
#ASSERT `s 2023(a)(15) the court reviews the determination by` FALSE EQUALS `s 2023(a)(15) trial de novo`
#ASSERT `s 2023(a)(16) the court must enter judgment or order as it determines is in accordance with the law and the evidence` TRUE EQUALS JUST TRUE
#ASSERT `s 2023(a)(16) the court must enter judgment or order as it determines is in accordance with the law and the evidence` FALSE EQUALS JUST FALSE
-- (17): arguments are review pending, the court has stayed the action, the days of notice on the application, a hearing was held, the court considered likelihood of success and irreparable injury
#ASSERT `s 2023(a)(17) the administrative action remains in full force and effect` FALSE TRUE 10 TRUE TRUE EQUALS NOTHING
#ASSERT `s 2023(a)(17) the administrative action remains in full force and effect` TRUE TRUE 10 TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2023(a)(17) the administrative action remains in full force and effect` TRUE TRUE 30 TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2023(a)(17) the administrative action remains in full force and effect` TRUE TRUE 9 TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2023(a)(17) the administrative action remains in full force and effect` TRUE TRUE 10 FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 2023(a)(17) the administrative action remains in full force and effect` TRUE TRUE 10 TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2023(a)(17) the administrative action remains in full force and effect` TRUE FALSE 10 TRUE TRUE EQUALS JUST TRUE
-- (18): arguments are a permanent disqualification under section 2021(b)(3) or (4), the date of receipt of the notice
#ASSERT `s 2023(a)(18) the date from which the permanent disqualification is effective` TRUE (Date 5 3 2026) EQUALS JUST (Date 5 3 2026)
#ASSERT `s 2023(a)(18) the date from which the permanent disqualification is effective` FALSE (Date 5 3 2026) EQUALS NOTHING
-- arguments are a permanent disqualification under section 2021(b)(3) or (4), it is reversed
#ASSERT `s 2023(a)(18) the Secretary is liable for the value of sales lost during the disqualification period` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2023(a)(18) the Secretary is liable for the value of sales lost during the disqualification period` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2023(a)(18) the Secretary is liable for the value of sales lost during the disqualification period` FALSE TRUE EQUALS NOTHING

§ `Tests -- s 2023(b) restoration of allotments`

-- arguments: the date the action began, the action reviews a final State agency decision, the date a request for restoration was filed with the State, the date the State agency was notified or discovered the loss
-- only the commencement limit applies: one year before 15 June 2026 is 15 June 2025
#ASSERT `s 2023(b) the earliest date from which allotments may be restored` (Date 15 6 2026) FALSE NOTHING NOTHING EQUALS Date 15 6 2025
-- a review of a final State agency decision, request filed 1 March 2026: one year before is 1 March 2025, the earlier of the two
#ASSERT `s 2023(b) the earliest date from which allotments may be restored` (Date 15 6 2026) TRUE (JUST (Date 1 3 2026)) NOTHING EQUALS Date 1 3 2025
-- not a review of a final State agency decision: the request-to-State limit does not apply
#ASSERT `s 2023(b) the earliest date from which allotments may be restored` (Date 15 6 2026) FALSE (JUST (Date 1 3 2026)) NOTHING EQUALS Date 15 6 2025
-- a review with no request date given: the request-to-State limit has nothing to run from
#ASSERT `s 2023(b) the earliest date from which allotments may be restored` (Date 15 6 2026) TRUE NOTHING NOTHING EQUALS Date 15 6 2025
-- the State agency discovered the loss on 1 January 2025: one year before is 1 January 2024, the earliest of the limits
#ASSERT `s 2023(b) the earliest date from which allotments may be restored` (Date 15 6 2026) FALSE NOTHING (JUST (Date 1 1 2025)) EQUALS Date 1 1 2024
-- discovery later than the commencement limit is not the earliest
#ASSERT `s 2023(b) the earliest date from which allotments may be restored` (Date 15 6 2026) FALSE NOTHING (JUST (Date 1 9 2026)) EQUALS Date 15 6 2025
-- all three: commencement 15 June 2025, request 1 March 2025, discovery 1 September 2025; the request limit is earliest
#ASSERT `s 2023(b) the earliest date from which allotments may be restored` (Date 15 6 2026) TRUE (JUST (Date 1 3 2026)) (JUST (Date 1 9 2026)) EQUALS Date 1 3 2025
-- a commencement date of 29 February 2028 less one year lands on 28 February 2027 (there is no 29 February 2027)
#ASSERT `s 2023(b) the earliest date from which allotments may be restored` (Date 29 2 2028) FALSE NOTHING NOTHING EQUALS Date 28 2 2027
-- the period test: arguments are the four dates above and the first day of the period sought
#ASSERT `s 2023(b) the allotments may be restored for the period` (Date 15 6 2026) FALSE NOTHING NOTHING (Date 15 6 2025) EQUALS JUST TRUE
#ASSERT `s 2023(b) the allotments may be restored for the period` (Date 15 6 2026) FALSE NOTHING NOTHING (Date 14 6 2025) EQUALS JUST FALSE
#ASSERT `s 2023(b) the allotments may be restored for the period` (Date 15 6 2026) FALSE NOTHING NOTHING (Date 1 1 2026) EQUALS JUST TRUE
#ASSERT `s 2023(b) the allotments may be restored for the period` (Date 15 6 2026) FALSE NOTHING (JUST (Date 1 1 2025)) (Date 1 1 2024) EQUALS JUST TRUE
#ASSERT `s 2023(b) the allotments may be restored for the period` (Date 15 6 2026) FALSE NOTHING (JUST (Date 1 1 2025)) (Date 31 12 2023) EQUALS JUST FALSE

§ `Tests -- every constructor declared in snap3-s2023.l4 is built once`

#ASSERT `s 2023(a)(1) any other action` EQUALS `s 2023(a)(1) any other action`
#ASSERT NOT (`s 2023(a)(1) any other action` EQUALS `s 2023(a)(1) a claim against a State agency stated under section 2022`)
#ASSERT `s 2023(a)(1) forfeiture of a bond under section 2021(d)` EQUALS `s 2023(a)(1) forfeiture of a bond under section 2021(d)`
#ASSERT NOT (`s 2023(a)(15) trial de novo` EQUALS `s 2023(a)(15) review on the administrative record`)
