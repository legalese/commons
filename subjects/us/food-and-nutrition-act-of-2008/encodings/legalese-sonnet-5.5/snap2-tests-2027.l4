IMPORT prelude
IMPORT daydate
IMPORT `snap-core`
IMPORT `snap2-3val`
IMPORT `snap2-2027`

-- Tests of section 2027. Expected values are decided from the quoted words before the run.

§ `Tests: 2027(a)(1)`
-- "for each of fiscal years 2008 through 2023"
#ASSERT `s 2027(a)(1) sums are authorized to be appropriated for the fiscal year` 2007 EQUALS NOTHING
#ASSERT `s 2027(a)(1) sums are authorized to be appropriated for the fiscal year` 2008 EQUALS JUST TRUE
#ASSERT `s 2027(a)(1) sums are authorized to be appropriated for the fiscal year` 2023 EQUALS JUST TRUE
#ASSERT `s 2027(a)(1) sums are authorized to be appropriated for the fiscal year` 2024 EQUALS NOTHING
-- argument order: the fiscal year, the previous year's appropriation; one-fourth of 1 per centum is 1/400
#ASSERT `s 2027(a)(1) the most that is authorized in the fiscal year to carry out section 2026` 2008 100000 EQUALS JUST 250
#ASSERT `s 2027(a)(1) the most that is authorized in the fiscal year to carry out section 2026` 2023 400 EQUALS JUST 1
#ASSERT `s 2027(a)(1) the most that is authorized in the fiscal year to carry out section 2026` 2007 100000 EQUALS NOTHING
#ASSERT `s 2027(a)(1) the most that is authorized in the fiscal year to carry out section 2026` 2024 100000 EQUALS NOTHING
-- argument order: the fiscal year, the previous year's appropriation, the amount appropriated for section 2026; "Not to exceed"
#ASSERT `s 2027(a)(1) the amount for section 2026 is within what is authorized` 2015 100000 250 EQUALS JUST TRUE
#ASSERT `s 2027(a)(1) the amount for section 2026 is within what is authorized` 2015 100000 251 EQUALS JUST FALSE
#ASSERT `s 2027(a)(1) the amount for section 2026 is within what is authorized` 2015 100000 0 EQUALS JUST TRUE
#ASSERT `s 2027(a)(1) the amount for section 2026 is within what is authorized` 2024 100000 251 EQUALS NOTHING
#ASSERT `s 2027(a)(1) the amount for section 2026 is within what is authorized` 2007 100000 1 EQUALS NOTHING

§ `Tests: 2027(a)(2)`
-- argument order: the use is to interfere with or impede, the use is legal and related assistance
#ASSERT `s 2027(a)(2) the limitation on the use of funds bars the use` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2027(a)(2) the limitation on the use of funds bars the use` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2027(a)(2) the limitation on the use of funds bars the use` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2027(a)(2) the limitation on the use of funds bars the use` FALSE FALSE EQUALS NOTHING
#ASSERT `s 2027(a)(2) the President is required to ensure that paragraph (2) is complied with` EQUALS JUST TRUE

§ `Tests: 2027(a)(3)`
-- (A) argument order: the amount used, 2-year competitive, enhances interagency cooperation, develops cost effective ways
#ASSERT `s 2027(a)(3)(A) the Secretary may use the amount for the grants` 2000000 TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2027(a)(3)(A) the Secretary may use the amount for the grants` 2000001 TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2027(a)(3)(A) the Secretary may use the amount for the grants` 0 TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2027(a)(3)(A) the Secretary may use the amount for the grants` 1000 FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 2027(a)(3)(A) the Secretary may use the amount for the grants` 1000 TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 2027(a)(3)(A) the Secretary may use the amount for the grants` 1000 TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 2027(a)(3)(A) the Secretary may use the amount for the grants` 3000000 FALSE TRUE TRUE EQUALS NOTHING
-- (B), (C), (D)
#ASSERT `s 2027(a)(3)(B) the Secretary is required to make an award under paragraph (3) to the body` TRUE EQUALS JUST TRUE
#ASSERT `s 2027(a)(3)(B) the Secretary is required to make an award under paragraph (3) to the body` FALSE EQUALS NOTHING
#ASSERT `s 2027(a)(3)(B) the body is required to administer the grants in coordination with other State or local agencies serving low-income people` TRUE EQUALS JUST TRUE
#ASSERT `s 2027(a)(3)(B) the body is required to administer the grants in coordination with other State or local agencies serving low-income people` FALSE EQUALS NOTHING
#ASSERT `s 2027(a)(3)(C) the project is required to include an evaluation component and to develop an implementation plan for replication in other States` TRUE EQUALS JUST TRUE
#ASSERT `s 2027(a)(3)(C) the project is required to include an evaluation component and to develop an implementation plan for replication in other States` FALSE EQUALS NOTHING
#ASSERT `s 2027(a)(3)(D) the Secretary is required to report on the results of the projects and to disseminate the results` TRUE EQUALS JUST TRUE
#ASSERT `s 2027(a)(3)(D) the Secretary is required to report on the results of the projects and to disseminate the results` FALSE EQUALS NOTHING

§ `Tests: 2027(b) and (c)`
-- argument order: the value of the allotments issued, the appropriation; "not in excess of"
#ASSERT `s 2027(b) the value of the allotments issued is within the limit` 1000 1000 EQUALS JUST TRUE
#ASSERT `s 2027(b) the value of the allotments issued is within the limit` 1001 1000 EQUALS JUST FALSE
#ASSERT `s 2027(b) the value of the allotments issued is within the limit` 999 1000 EQUALS JUST TRUE
-- the direction to State agencies rests on the Secretary's finding
#ASSERT `s 2027(b) the Secretary is required to direct State agencies to reduce the value of the allotments to be issued` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2027(b) the Secretary is required to direct State agencies to reduce the value of the allotments to be issued` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2027(b) the Secretary is required to direct State agencies to reduce the value of the allotments to be issued` NOTHING EQUALS NOTHING
-- argument order: the requirements of participating States, the appropriation
#ASSERT `s 2027(b) the reduction in the value of the allotments to the extent necessary to comply with the subsection` 1200 1000 EQUALS JUST 200
#ASSERT `s 2027(b) the reduction in the value of the allotments to the extent necessary to comply with the subsection` 1000 1000 EQUALS NOTHING
#ASSERT `s 2027(b) the reduction in the value of the allotments to the extent necessary to comply with the subsection` 900 1000 EQUALS NOTHING
-- (c) the duty, the ratio, the permissions
#ASSERT `s 2027(c) the Secretary is required to ensure that the reductions reflect the ratio of household income to the income standards of eligibility` TRUE EQUALS JUST TRUE
#ASSERT `s 2027(c) the Secretary is required to ensure that the reductions reflect the ratio of household income to the income standards of eligibility` FALSE EQUALS NOTHING
#ASSERT `s 2027(c) the ratio of household income to the income standard of eligibility` 800 1600 EQUALS JUST 0.5
#ASSERT `s 2027(c) the ratio of household income to the income standard of eligibility` 800 0 EQUALS NOTHING
#ASSERT `s 2027(c) the ratio of household income to the income standard of eligibility` 0 1600 EQUALS JUST 0
-- "persons sixty years of age or over and persons who are physically or mentally handicapped or otherwise disabled"
#ASSERT `s 2027(c)(1) the Secretary may establish special provisions applicable to the person in prescribing the manner of reducing allotments` (Individual OF 60, TRUE, FALSE, `a citizen or national of the United States`, TRUE, FALSE, 0, FALSE) FALSE EQUALS JUST TRUE
#ASSERT `s 2027(c)(1) the Secretary may establish special provisions applicable to the person in prescribing the manner of reducing allotments` (Individual OF 59, TRUE, FALSE, `a citizen or national of the United States`, TRUE, FALSE, 0, FALSE) FALSE EQUALS NOTHING
#ASSERT `s 2027(c)(1) the Secretary may establish special provisions applicable to the person in prescribing the manner of reducing allotments` (Individual OF 30, TRUE, FALSE, `a citizen or national of the United States`, TRUE, FALSE, 0, FALSE) TRUE EQUALS JUST TRUE
#ASSERT `s 2027(c)(2) the Secretary may establish minimum allotments after any reductions are otherwise determined` TRUE EQUALS JUST TRUE
#ASSERT `s 2027(c)(2) the Secretary may establish minimum allotments after any reductions are otherwise determined` FALSE EQUALS NOTHING

§ `Tests: 2027(d)`
#ASSERT `s 2027(d) the Secretary is required to take the requisite action to reduce allotments` TRUE EQUALS JUST TRUE
#ASSERT `s 2027(d) the Secretary is required to take the requisite action to reduce allotments` FALSE EQUALS NOTHING
-- "Not later than sixty days after the issuance of a report": 1 March 2027 plus 60 days is 30 April 2027
#ASSERT `s 2027(d) the last day for the requisite action` (Date 1 3 2027) EQUALS Date 30 4 2027
-- the duty is run: the Secretary acts within the sixty days (a trace cannot be asserted on the stable binary: it is run and read)
#TRACE `s 2027(d) the Secretary must take the requisite action within sixty days of the report` AT 0 WITH
    PARTY `the Secretary` DOES `s 2027(d) take the requisite action to reduce allotments` AT 60
#TRACE `s 2027(d) the Secretary must take the requisite action within sixty days of the report` AT 0 WITH
    PARTY `the Secretary` DOES `s 2027(d) take the requisite action to reduce allotments` AT 61
-- argument order: the date of the report, the date of the action
#ASSERT `s 2027(d) the action was taken in time` (Date 1 3 2027) (Date 30 4 2027) EQUALS JUST TRUE
#ASSERT `s 2027(d) the action was taken in time` (Date 1 3 2027) (Date 1 5 2027) EQUALS JUST FALSE
#ASSERT `s 2027(d) the action was taken in time` (Date 1 3 2027) (Date 1 3 2027) EQUALS JUST TRUE
#ASSERT `s 2027(d) the action was taken in time` (Date 1 3 2027) (Date 28 2 2027) EQUALS NOTHING
#ASSERT `s 2027(d) the Secretary is required to furnish the Committees a statement` TRUE EQUALS JUST TRUE
#ASSERT `s 2027(d) the Secretary is required to furnish the Committees a statement` FALSE EQUALS NOTHING
-- "Not later than seven days after the Secretary takes any action": 10 May 2027 plus 7 days is 17 May 2027
#ASSERT `s 2027(d) the last day for the statement` (Date 10 5 2027) EQUALS Date 17 5 2027
#TRACE `s 2027(d) the Secretary must furnish the Committees a statement within seven days of the action` AT 0 WITH
    PARTY `the Secretary` DOES `s 2027(d) furnish the Committees a statement` AT 7
#TRACE `s 2027(d) the Secretary must furnish the Committees a statement within seven days of the action` AT 0 WITH
    PARTY `the Secretary` DOES `s 2027(d) furnish the Committees a statement` AT 8
-- argument order: the date of the action, the date the statement was furnished
#ASSERT `s 2027(d) the statement was furnished in time` (Date 10 5 2027) (Date 17 5 2027) EQUALS JUST TRUE
#ASSERT `s 2027(d) the statement was furnished in time` (Date 10 5 2027) (Date 18 5 2027) EQUALS JUST FALSE
#ASSERT `s 2027(d) the statement was furnished in time` (Date 10 5 2027) (Date 9 5 2027) EQUALS NOTHING
-- the statement sets forth (1), (2) and (3)
#ASSERT `s 2027(d) the statement sets forth what the subsection requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2027(d) the statement sets forth what the subsection requires` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2027(d) the statement sets forth what the subsection requires` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2027(d) the statement sets forth what the subsection requires` TRUE TRUE FALSE EQUALS JUST FALSE

§ `Tests: 2027(e) and (f)`
-- a claim: amount, owed by, owed to
#ASSERT `s 2027(e) the claim is against a household or a State agency` (Claim OF 500, `the household`, `the State agency`) EQUALS JUST TRUE
#ASSERT `s 2027(e) the claim is against a household or a State agency` (Claim OF 500, `a household member`, `the State agency`) EQUALS JUST TRUE
#ASSERT `s 2027(e) the claim is against a household or a State agency` (Claim OF 500, `an applicant household`, `the State agency`) EQUALS JUST TRUE
#ASSERT `s 2027(e) the claim is against a household or a State agency` (Claim OF 500, `the State agency`, `the Secretary`) EQUALS JUST TRUE
#ASSERT `s 2027(e) the claim is against a household or a State agency` (Claim OF 500, `a retail food store`, `the Secretary`) EQUALS NOTHING
#ASSERT `s 2027(e) the claim is against a household or a State agency` (Claim OF 500, `a wholesale food concern`, `the Secretary`) EQUALS NOTHING
#ASSERT `s 2027(e) the claim is against a household or a State agency` (Claim OF 500, `the Secretary`, `the State agency`) EQUALS NOTHING
#ASSERT `s 2027(e) the claim is against a household or a State agency` (Claim OF 500, `a tribal organization`, `the State agency`) EQUALS NOTHING
#ASSERT `s 2027(e) the claim is against a household or a State agency` (Claim OF 500, `a benefit issuer`, `the State agency`) EQUALS NOTHING
#ASSERT `s 2027(e) the claim is against a household or a State agency` (Claim OF 500, `a sponsor of an alien`, `the State agency`) EQUALS NOTHING
#ASSERT `s 2027(e) the claim is against a household or a State agency` (Claim OF 500, `a court`, `the State agency`) EQUALS NOTHING
#ASSERT `s 2027(e) the claim is against a household or a State agency` (Claim OF 500, `an administrative agency`, `the State agency`) EQUALS NOTHING
-- the account is that of the fiscal year in which the collection occurs
#ASSERT `s 2027(e) the fiscal year of the supplemental nutrition assistance program appropriation account to which the funds collected on the claim are credited` (Claim OF 500, `the household`, `the State agency`) 2027 EQUALS JUST 2027
#ASSERT `s 2027(e) the fiscal year of the supplemental nutrition assistance program appropriation account to which the funds collected on the claim are credited` (Claim OF 500, `a retail food store`, `the Secretary`) 2027 EQUALS NOTHING
-- funds provided to State agencies under section 2025(c) are paid from the account of the fiscal year in which they are provided
#ASSERT `s 2027(e) the fiscal year of the appropriation account from which the funds provided to State agencies are paid` TRUE 2028 EQUALS JUST 2028
#ASSERT `s 2027(e) the fiscal year of the appropriation account from which the funds provided to State agencies are paid` FALSE 2028 EQUALS NOTHING
-- (f) argument order: appropriated to carry out this chapter, the recipient
#ASSERT `s 2027(f) the funds may be transferred to the recipient` TRUE `s 2027(f) the Office of the Inspector General of the Department of Agriculture` EQUALS JUST FALSE
#ASSERT `s 2027(f) the funds may be transferred to the recipient` TRUE `s 2027(f) the Office of the General Counsel of the Department of Agriculture` EQUALS JUST FALSE
#ASSERT `s 2027(f) the funds may be transferred to the recipient` TRUE `s 2027(f) any other recipient` EQUALS NOTHING
#ASSERT `s 2027(f) the funds may be transferred to the recipient` FALSE `s 2027(f) the Office of the Inspector General of the Department of Agriculture` EQUALS NOTHING

§ `Tests: 2027(g) and (h)`
-- (g) argument order: the activity, the funds are authorized under this chapter, used by the Secretary, a programmatic activity under section 2014(h)
#ASSERT `s 2027(g) the ban bars the use of the funds for the activity` `s 2027(g)(1)(A) recruitment activities designed to persuade an individual to apply for benefits` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2027(g) the ban bars the use of the funds for the activity` `s 2027(g)(1)(B) television, radio, or billboard advertisements designed to promote benefits and enrollment` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2027(g) the ban bars the use of the funds for the activity` `s 2027(g)(1)(C) agreements with foreign governments designed to promote benefits and enrollment` TRUE TRUE FALSE EQUALS JUST TRUE
-- (2) paragraph (1)(B) does not apply to programmatic activities with respect to benefits under section 2014(h); (A) and (C) are not touched by it
#ASSERT `s 2027(g) the ban bars the use of the funds for the activity` `s 2027(g)(1)(B) television, radio, or billboard advertisements designed to promote benefits and enrollment` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2027(g) the ban bars the use of the funds for the activity` `s 2027(g)(1)(A) recruitment activities designed to persuade an individual to apply for benefits` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2027(g) the ban bars the use of the funds for the activity` `s 2027(g)(1)(C) agreements with foreign governments designed to promote benefits and enrollment` TRUE TRUE TRUE EQUALS JUST TRUE
-- any other activity, other funds, or another user is not addressed
#ASSERT `s 2027(g) the ban bars the use of the funds for the activity` `s 2027(g)(1) any other activity` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 2027(g) the ban bars the use of the funds for the activity` `s 2027(g)(1)(A) recruitment activities designed to persuade an individual to apply for benefits` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 2027(g) the ban bars the use of the funds for the activity` `s 2027(g)(1)(A) recruitment activities designed to persuade an individual to apply for benefits` TRUE FALSE FALSE EQUALS NOTHING
-- (h)
#ASSERT `s 2027(h) the Secretary is required to issue the regulations` EQUALS JUST TRUE
-- argument order: the entity receives funds, the compensation is for outreach or recruiting, based on the number of individuals who apply
#ASSERT `s 2027(h) the regulations are to prohibit the entity from compensating the person` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2027(h) the regulations are to prohibit the entity from compensating the person` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2027(h) the regulations are to prohibit the entity from compensating the person` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 2027(h) the regulations are to prohibit the entity from compensating the person` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 2027(h) the regulations are to prohibit the entity from compensating the person` TRUE FALSE FALSE EQUALS NOTHING
