IMPORT prelude
IMPORT daydate
IMPORT `snap-core`
IMPORT `snap3-s2017`

-- TESTS for section 2017 (snap3-s2017.l4). Every expected value is worked out from the text of section 2017 and written beside the assertion,
-- BEFORE running. A failing assertion is a finding. Positional arguments follow the GIVEN order of each function.

§ `Tests -- s 2017(a) calculation`

-- (a) "the cost ... of the thrifty food plan reduced by an amount equal to 30 per centum of the household's income ... rounded to the nearest lower whole dollar"
-- 306 - 30% of 0 = 306
#ASSERT `s 2017(a) the cost of the thrifty food plan reduced by 30 per centum of income, rounded to the nearest lower whole dollar` 306 0 EQUALS 306
-- 1000 - 30% of 100 = 970 exactly, nothing to round
#ASSERT `s 2017(a) the cost of the thrifty food plan reduced by 30 per centum of income, rounded to the nearest lower whole dollar` 1000 100 EQUALS 970
-- 1023 - 30% of 501.70 = 1023 - 150.51 = 872.49, rounded to the nearest LOWER whole dollar = 872
#ASSERT `s 2017(a) the cost of the thrifty food plan reduced by 30 per centum of income, rounded to the nearest lower whole dollar` 1023 501.7 EQUALS 872
-- 1023 - 30% of 500 = 873
#ASSERT `s 2017(a) the cost of the thrifty food plan reduced by 30 per centum of income, rounded to the nearest lower whole dollar` 1023 500 EQUALS 873
-- 306 - 30% of 1000 = 6
#ASSERT `s 2017(a) the cost of the thrifty food plan reduced by 30 per centum of income, rounded to the nearest lower whole dollar` 306 1000 EQUALS 6
-- 808 - 30% of 3000 = 808 - 900 = -92 (lower whole dollar of a negative figure is itself)
#ASSERT `s 2017(a) the cost of the thrifty food plan reduced by 30 per centum of income, rounded to the nearest lower whole dollar` 808 3000 EQUALS (0 MINUS 92)
-- a half dollar of reduction: 100 - 30% of 1.5 = 99.55, the nearest lower whole dollar is 99
#ASSERT `s 2017(a) the cost of the thrifty food plan reduced by 30 per centum of income, rounded to the nearest lower whole dollar` 100 1.5 EQUALS 99

-- (a) proviso: the minimum allotment is 8 percent of the 1-member cost, rounded to the nearest whole dollar
-- 8% of 306.30 = 24.504, nearest whole dollar is 25
#ASSERT `s 2017(a) the minimum allotment, 8 percent of the cost for 1 member rounded to the nearest whole dollar` 306.3 EQUALS 25
-- 8% of 306 = 24.48, nearest whole dollar is 24 (FINDING: the USDA page publishes $25 for the 48 States, which this rule gives only for a cost of 306.25 or more)
#ASSERT `s 2017(a) the minimum allotment, 8 percent of the cost for 1 member rounded to the nearest whole dollar` 306 EQUALS 24
-- 8% of 300 = 24 exactly
#ASSERT `s 2017(a) the minimum allotment, 8 percent of the cost for 1 member rounded to the nearest whole dollar` 300 EQUALS 24
-- 8% of 306.25 = 24.5: the text does not say which way a half goes; half up (assumed) gives 25
#ASSERT `s 2017(a) the minimum allotment, 8 percent of the cost for 1 member rounded to the nearest whole dollar` 306.25 EQUALS 25
-- 8% of 306.24 = 24.4992, below a half, so 24
#ASSERT `s 2017(a) the minimum allotment, 8 percent of the cost for 1 member rounded to the nearest whole dollar` 306.24 EQUALS 24

-- (a) the value of the allotment: arguments are certified, persons, cost, income, minimum allotment
-- a certified household of 1, cost 306, income 0: 306
#ASSERT `s 2017(a) the value of the allotment` TRUE 1 306 0 25 EQUALS JUST 306
-- a household of 1 whose reduced cost is 6 gets the minimum allotment, 25 ("for households of one and two persons the minimum allotment")
#ASSERT `s 2017(a) the value of the allotment` TRUE 1 306 1000 25 EQUALS JUST 25
-- a household of 2 whose reduced cost is negative still gets the minimum: 562 - 900 = -338
#ASSERT `s 2017(a) the value of the allotment` TRUE 2 562 3000 25 EQUALS JUST 25
-- a household of 2 whose reduced cost (500) is above the minimum keeps 500: 562 - 30% of 206.67 = 562 - 62.001 = 499.999, lower whole dollar 499
#ASSERT `s 2017(a) the value of the allotment` TRUE 2 562 206.67 25 EQUALS JUST 499
-- a household of 3, cost 808, income 2000: 808 - 600 = 208
#ASSERT `s 2017(a) the value of the allotment` TRUE 3 808 2000 25 EQUALS JUST 208
-- a household of 3 whose reduced cost is exactly 0: 0 is a figure (not below zero)
#ASSERT `s 2017(a) the value of the allotment` TRUE 3 600 2000 25 EQUALS JUST 0
-- a household of 3 whose reduced cost is negative: the text gives no value
#ASSERT `s 2017(a) the value of the allotment` TRUE 3 808 3000 25 EQUALS NOTHING
-- a household not certified: the section speaks of "households certified as eligible", so the text does not say
#ASSERT `s 2017(a) the value of the allotment` FALSE 3 808 2000 25 EQUALS NOTHING
-- a household of no members: silent
#ASSERT `s 2017(a) the value of the allotment` TRUE 0 808 0 25 EQUALS NOTHING

§ `Tests -- s 2017(b) benefits not deemed income or resources`

-- (b) "shall not be considered income or resources for any purpose under any Federal, State, or local laws"
#ASSERT `s 2017(b) the value of the benefits is considered income or resources for the purpose` TRUE EQUALS JUST FALSE
-- a purpose that is not under any Federal, State or local law (for example a private lender's form): the text does not say
#ASSERT `s 2017(b) the value of the benefits is considered income or resources for the purpose` FALSE EQUALS NOTHING
-- (b) "no participating State or political subdivision thereof shall decrease any assistance ... because of the receipt of benefits": arguments are body, assistance otherwise provided, decrease because of benefits
#ASSERT `s 2017(b) the participating State or political subdivision may decrease the assistance` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2017(b) the participating State or political subdivision may decrease the assistance` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 2017(b) the participating State or political subdivision may decrease the assistance` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 2017(b) the participating State or political subdivision may decrease the assistance` TRUE TRUE FALSE EQUALS NOTHING

§ `Tests -- s 2017(c) first month benefits prorated`

-- (c)(1) arguments: the full allotment, the date of application, the first day, the last day of the month or period. June 2026 has 30 days.
-- applying on 16 June: days remaining 16 to 30 inclusive = 15 of 30 = one half of 100 = 50
#ASSERT `s 2017(c)(1) the initial allotment` 100 (Date 16 6 2026) (Date 1 6 2026) (Date 30 6 2026) EQUALS `s 2017(c)(1) an allotment of` 50
-- applying on 1 June: all 30 of 30 days remain: the whole 100
#ASSERT `s 2017(c)(1) the initial allotment` 100 (Date 1 6 2026) (Date 1 6 2026) (Date 30 6 2026) EQUALS `s 2017(c)(1) an allotment of` 100
-- applying on 27 June with a full allotment of 300: 4 of 30 days = 40
#ASSERT `s 2017(c)(1) the initial allotment` 300 (Date 27 6 2026) (Date 1 6 2026) (Date 30 6 2026) EQUALS `s 2017(c)(1) an allotment of` 40
-- the $10 line: applying on 30 June with a full allotment of 300: 1 of 30 days = exactly 10, which is not "less than $10", so it is issued
#ASSERT `s 2017(c)(1) the initial allotment` 300 (Date 30 6 2026) (Date 1 6 2026) (Date 30 6 2026) EQUALS `s 2017(c)(1) an allotment of` 10
-- just under: a full allotment of 299.70, 1 of 30 days = 9.99: less than $10, so no allotment may be issued
#ASSERT `s 2017(c)(1) the initial allotment` 299.7 (Date 30 6 2026) (Date 1 6 2026) (Date 30 6 2026) EQUALS `s 2017(c)(1) no allotment may be issued`
-- a full allotment of 100 on the last day: 3.33... is less than 10
#ASSERT `s 2017(c)(1) the initial allotment` 100 (Date 30 6 2026) (Date 1 6 2026) (Date 30 6 2026) EQUALS `s 2017(c)(1) no allotment may be issued`
-- an application date outside the period: the text does not say
#ASSERT `s 2017(c)(1) the initial allotment` 100 (Date 1 7 2026) (Date 1 6 2026) (Date 30 6 2026) EQUALS `s 2017(c)(1) not covered`
#ASSERT `s 2017(c)(1) the initial allotment` 100 (Date 31 5 2026) (Date 1 6 2026) (Date 30 6 2026) EQUALS `s 2017(c)(1) not covered`
-- a period that ends before it starts: the text does not say
#ASSERT `s 2017(c)(1) the initial allotment` 100 (Date 5 6 2026) (Date 10 6 2026) (Date 1 6 2026) EQUALS `s 2017(c)(1) not covered`

-- (c)(1) second sentence: "Households shall receive full months' allotments for all months within a certification period, except ... an initial month"
#ASSERT `s 2017(c)(1) the household receives the full month's allotment` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2017(c)(1) the household receives the full month's allotment` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2017(c)(1) the household receives the full month's allotment` FALSE FALSE EQUALS NOTHING
#ASSERT `s 2017(c)(1) the household receives the full month's allotment` FALSE TRUE EQUALS NOTHING

-- (c)(2) "initial month" means (A) the first month for which an allotment is issued, (B) the first month after a break (expiry, or termination after notice and a hearing opportunity), (C) farmworker household after more than 30 days
-- arguments: (A), (B expiry), (B termination), migrant or seasonal farmworker household, days not participating
#ASSERT `s 2017(c)(2) the month is an initial month` TRUE FALSE FALSE FALSE 0 EQUALS JUST TRUE
#ASSERT `s 2017(c)(2) the month is an initial month` FALSE TRUE FALSE FALSE 0 EQUALS JUST TRUE
#ASSERT `s 2017(c)(2) the month is an initial month` FALSE FALSE TRUE FALSE 0 EQUALS JUST TRUE
-- (C): a farmworker household returning after 31 days
#ASSERT `s 2017(c)(2) the month is an initial month` FALSE FALSE FALSE TRUE 31 EQUALS JUST TRUE
-- (C): after exactly 30 days is not "more than 30 days"
#ASSERT `s 2017(c)(2) the month is an initial month` FALSE FALSE FALSE TRUE 30 EQUALS JUST FALSE
-- (C) is for a farmworker household only: a household that is not one, away 45 days, is not within (C)
#ASSERT `s 2017(c)(2) the month is an initial month` FALSE FALSE FALSE FALSE 45 EQUALS JUST FALSE
#ASSERT `s 2017(c)(2) the month is an initial month` FALSE FALSE FALSE FALSE 0 EQUALS JUST FALSE

-- (c)(3) "A State agency may provide to an eligible household applying after the 15th day of a month ... a combined allotment"
#ASSERT `s 2017(c)(3) the State agency may provide a combined allotment` TRUE (Date 16 6 2026) EQUALS JUST TRUE
#ASSERT `s 2017(c)(3) the State agency may provide a combined allotment` TRUE (Date 15 6 2026) EQUALS NOTHING
#ASSERT `s 2017(c)(3) the State agency may provide a combined allotment` TRUE (Date 31 7 2026) EQUALS JUST TRUE
#ASSERT `s 2017(c)(3) the State agency may provide a combined allotment` FALSE (Date 20 6 2026) EQUALS NOTHING
-- the combined allotment is "the total amount of the initial allotment and the first regular allotment": 40 + 306 = 346
#ASSERT `s 2017(c)(3) the combined allotment` 40 306 EQUALS 346
-- section 2020(e)(3) for a household not entitled to expedited service; paragraphs (3) and (9) of section 2020(e) for one that is
#ASSERT `s 2017(c)(3) the provisions of section 2020(e) that govern the combined allotment` FALSE EQUALS `s 2017(c)(3) section 2020(e)(3) governs`
#ASSERT `s 2017(c)(3) the provisions of section 2020(e) that govern the combined allotment` TRUE EQUALS `s 2017(c)(3) paragraphs (3) and (9) of section 2020(e) govern`

§ `Tests -- s 2017(d) reduction of public assistance benefits`

-- (d)(1)(A) "the household may not receive an increased allotment as the result of a decrease in the income of the household to the extent that the decrease is the result of the reduction"
-- arguments: the benefits are reduced for failure to perform a required action, the decrease in income is the result of the reduction
#ASSERT `s 2017(d)(1)(A) the household may receive an increased allotment as the result of a decrease in income` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2017(d)(1)(A) the household may receive an increased allotment as the result of a decrease in income` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2017(d)(1)(A) the household may receive an increased allotment as the result of a decrease in income` FALSE TRUE EQUALS NOTHING
-- (d)(1)(B) "the State agency may reduce the allotment of the household by not more than 25 percent": arguments are the lead-in, the percentage proposed
#ASSERT `s 2017(d)(1)(B) the State agency may reduce the allotment of the household by the percentage` TRUE 25 EQUALS JUST TRUE
#ASSERT `s 2017(d)(1)(B) the State agency may reduce the allotment of the household by the percentage` TRUE 10 EQUALS JUST TRUE
-- 25.01 is more than 25: the grant does not reach it, and the text does not itself say no (limited by its own wording)
#ASSERT `s 2017(d)(1)(B) the State agency may reduce the allotment of the household by the percentage` TRUE 25.01 EQUALS NOTHING
#ASSERT `s 2017(d)(1)(B) the State agency may reduce the allotment of the household by the percentage` FALSE 10 EQUALS NOTHING
-- the most that may be taken off an allotment of 400 is 25 percent = 100
#ASSERT `s 2017(d)(1)(B) the greatest reduction of the allotment` TRUE 400 EQUALS JUST 100
#ASSERT `s 2017(d)(1)(B) the greatest reduction of the allotment` FALSE 400 EQUALS NOTHING
-- (d)(2) part A of title IV: arguments are the allotment is reduced under this subsection, the failure was under part A of title IV
#ASSERT `s 2017(d)(2) the State agency may use the rules and procedures that apply under part A of title IV` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2017(d)(2) the State agency may use the rules and procedures that apply under part A of title IV` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2017(d)(2) the State agency may use the rules and procedures that apply under part A of title IV` FALSE TRUE EQUALS NOTHING

§ `Tests -- s 2017(e) allotments for households residing in centers`

-- (e)(1)(A) arguments: the program is a drug or alcoholic treatment program of s 2012(m)(5), the individual resides in the center, the period in months
#ASSERT `s 2017(e)(1)(A) the State agency may provide an allotment for the individual to the center as an authorized representative` TRUE TRUE 0.5 EQUALS JUST TRUE
-- "for a period that is less than 1 month": exactly 1 month is not less than 1
#ASSERT `s 2017(e)(1)(A) the State agency may provide an allotment for the individual to the center as an authorized representative` TRUE TRUE 1 EQUALS NOTHING
#ASSERT `s 2017(e)(1)(A) the State agency may provide an allotment for the individual to the center as an authorized representative` FALSE TRUE 0.5 EQUALS NOTHING
#ASSERT `s 2017(e)(1)(A) the State agency may provide an allotment for the individual to the center as an authorized representative` TRUE FALSE 0.5 EQUALS NOTHING
-- (e)(1)(B) arguments: the program, the individual resided in the center, the individual has left
#ASSERT `s 2017(e)(1)(B) the State agency may provide an allotment for the individual to the individual` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2017(e)(1)(B) the State agency may provide an allotment for the individual to the individual` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 2017(e)(1)(B) the State agency may provide an allotment for the individual to the individual` FALSE TRUE TRUE EQUALS NOTHING
-- (e)(2) arguments: the program, the individual resides in the center
#ASSERT `s 2017(e)(2) the State agency may require the individual to designate the center as authorized representative` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2017(e)(2) the State agency may require the individual to designate the center as authorized representative` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2017(e)(2) the State agency may require the individual to designate the center as authorized representative` FALSE TRUE EQUALS NOTHING

§ `Tests -- s 2017(f) alternative procedures for residents of certain group facilities`

-- (f)(1)(A) arguments: the facility is one described in 2012(m)(5)(B)-(E), the State agency chose, the Secretary authorized all States, the facility is in a pilot project
-- chosen, in a pilot project, not yet authorized in all States: allowed
#ASSERT `s 2017(f)(1)(A) allotments for residents may be determined and issued under paragraph (1) in lieu of subsection (a)` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
-- chosen, authorized in all States, facility not in a pilot project: allowed
#ASSERT `s 2017(f)(1)(A) allotments for residents may be determined and issued under paragraph (1) in lieu of subsection (a)` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
-- chosen, but neither authorized in all States nor in a pilot project: "shall apply only to residents of covered facilities participating in a pilot project"
#ASSERT `s 2017(f)(1)(A) allotments for residents may be determined and issued under paragraph (1) in lieu of subsection (a)` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
-- not chosen by the State agency, in a pilot project: "at the option of the State agency": the text does not say
#ASSERT `s 2017(f)(1)(A) allotments for residents may be determined and issued under paragraph (1) in lieu of subsection (a)` TRUE FALSE FALSE TRUE EQUALS NOTHING
-- not a covered facility: the text does not say
#ASSERT `s 2017(f)(1)(A) allotments for residents may be determined and issued under paragraph (1) in lieu of subsection (a)` FALSE TRUE TRUE TRUE EQUALS NOTHING
-- (f)(1)(B) arguments: an eligible resident described in (A), the amount under the Secretary's standardized procedures
#ASSERT `s 2017(f)(1)(B) the allotment for the eligible resident` TRUE (JUST 150) EQUALS JUST 150
#ASSERT `s 2017(f)(1)(B) the allotment for the eligible resident` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 2017(f)(1)(B) the allotment for the eligible resident` FALSE (JUST 150) EQUALS NOTHING
-- (f)(1)(C)(i) shall issue to the covered facility as authorized representative
#ASSERT `s 2017(f)(1)(C)(i) the State agency must issue the allotment to the covered facility as the authorized representative of the residents` TRUE EQUALS JUST TRUE
#ASSERT `s 2017(f)(1)(C)(i) the State agency must issue the allotment to the covered facility as the authorized representative of the residents` FALSE EQUALS NOTHING
-- (f)(1)(C)(ii) arguments: the monthly allotment, days lived in the facility, days in the month. 10 of 30 days of a 300 allotment = 100
#ASSERT `s 2017(f)(1)(C)(ii) the greatest part of the resident's monthly allotment the covered facility may receive` 300 10 30 EQUALS JUST 100
-- the whole month: all 300
#ASSERT `s 2017(f)(1)(C)(ii) the greatest part of the resident's monthly allotment the covered facility may receive` 300 30 30 EQUALS JUST 300
-- more days than the month has: silent
#ASSERT `s 2017(f)(1)(C)(ii) the greatest part of the resident's monthly allotment the covered facility may receive` 300 31 30 EQUALS NOTHING
#ASSERT `s 2017(f)(1)(C)(ii) the greatest part of the resident's monthly allotment the covered facility may receive` 300 10 0 EQUALS NOTHING
-- (f)(1)(D)(i)(II) what the facility must tell the resident before leaving: two things
#ASSERT count `s 2017(f)(1)(D)(i)(II) what the covered facility must tell the resident before the departure` EQUALS 2
#ASSERT elem "the resident is eligible for continued benefits under the supplemental nutrition assistance program" `s 2017(f)(1)(D)(i)(II) what the covered facility must tell the resident before the departure`
#ASSERT elem "the resident should contact the State agency concerning continuation of the benefits" `s 2017(f)(1)(D)(i)(II) what the covered facility must tell the resident before the departure`
-- (f)(1)(D)(i) arguments: the facility receives an allotment for the resident, notified the State agency promptly, notified the resident before departure
#ASSERT `s 2017(f)(1)(D)(i) the covered facility has given the notifications` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2017(f)(1)(D)(i) the covered facility has given the notifications` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2017(f)(1)(D)(i) the covered facility has given the notifications` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2017(f)(1)(D)(i) the covered facility has given the notifications` FALSE FALSE FALSE EQUALS NOTHING
-- (f)(1)(D)(ii)(I) arguments: the State agency received the notification, the resident reapplied, the State agency elected not to issue, it lacks sufficient information
#ASSERT `s 2017(f)(1)(D)(ii)(I) the State agency must issue the departed resident an allotment for the days of the month after the departure` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- reapplied: "unless the departed resident reapplies"
#ASSERT `s 2017(f)(1)(D)(ii)(I) the State agency must issue the departed resident an allotment for the days of the month after the departure` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
-- elected not to issue AND lacks the information: clause (iii) allows the election, so no duty
#ASSERT `s 2017(f)(1)(D)(ii)(I) the State agency must issue the departed resident an allotment for the days of the month after the departure` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
-- elected not to issue but does NOT lack the information: clause (iii) does not allow the election, the duty stands
#ASSERT `s 2017(f)(1)(D)(ii)(I) the State agency must issue the departed resident an allotment for the days of the month after the departure` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
-- lacks the information but has not elected: the election is an option, the duty stands until it is made
#ASSERT `s 2017(f)(1)(D)(ii)(I) the State agency must issue the departed resident an allotment for the days of the month after the departure` TRUE FALSE FALSE TRUE EQUALS JUST TRUE
-- no notification received: the duty runs "On receiving a notification"
#ASSERT `s 2017(f)(1)(D)(ii)(I) the State agency must issue the departed resident an allotment for the days of the month after the departure` FALSE FALSE FALSE FALSE EQUALS NOTHING
-- (f)(1)(D)(ii)(II) arguments: the State agency received the notification, the resident reapplied, months after the month of departure
#ASSERT `s 2017(f)(1)(D)(ii)(II) the State agency may issue an allotment for the month based on this paragraph` TRUE FALSE 1 EQUALS JUST TRUE
-- "but not any subsequent month"
#ASSERT `s 2017(f)(1)(D)(ii)(II) the State agency may issue an allotment for the month based on this paragraph` TRUE FALSE 2 EQUALS JUST FALSE
#ASSERT `s 2017(f)(1)(D)(ii)(II) the State agency may issue an allotment for the month based on this paragraph` TRUE TRUE 1 EQUALS JUST FALSE
-- the month of the departure itself (0 months after) is covered by (I), not by this grant
#ASSERT `s 2017(f)(1)(D)(ii)(II) the State agency may issue an allotment for the month based on this paragraph` TRUE FALSE 0 EQUALS NOTHING
#ASSERT `s 2017(f)(1)(D)(ii)(II) the State agency may issue an allotment for the month based on this paragraph` FALSE FALSE 1 EQUALS NOTHING
-- (f)(1)(D)(iii)
#ASSERT `s 2017(f)(1)(D)(iii) the State agency may elect not to issue an allotment under clause (ii)(I)` TRUE EQUALS JUST TRUE
#ASSERT `s 2017(f)(1)(D)(iii) the State agency may elect not to issue an allotment under clause (ii)(I)` FALSE EQUALS NOTHING
-- (f)(1)(D)(iv)
#ASSERT `s 2017(f)(1)(D)(iv) the allotment of the departed resident is determined without regard to paragraph (1)` TRUE EQUALS JUST TRUE
#ASSERT `s 2017(f)(1)(D)(iv) the allotment of the departed resident is determined without regard to paragraph (1)` FALSE EQUALS NOTHING
-- (f)(2)(A) arguments: State agencies requested, the Secretary authorized all States, the Secretary has carried out the pilot projects
#ASSERT `s 2017(f)(2)(A) the Secretary has carried out the pilot projects required before authorizing implementation in all States` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 2017(f)(2)(A) the Secretary has carried out the pilot projects required before authorizing implementation in all States` TRUE FALSE FALSE EQUALS NOTHING
-- (f)(2)(B) arguments: (i) facilities, (ii) schedule, (iii) procedures, (iv) commitment
#ASSERT `s 2017(f)(2)(B) the project plan includes what a State agency must submit to be eligible to participate` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2017(f)(2)(B) the project plan includes what a State agency must submit to be eligible to participate` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2017(f)(2)(B) the project plan includes what a State agency must submit to be eligible to participate` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2017(f)(2)(B) the project plan includes what a State agency must submit to be eligible to participate` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2017(f)(2)(B) the project plan includes what a State agency must submit to be eligible to participate` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- (f)(3)(A) arguments: the Secretary determined, the Secretary notified the Committees
#ASSERT `s 2017(f)(3)(A) the Secretary has determined and notified` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2017(f)(3)(A) the Secretary has determined and notified` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2017(f)(3)(A) the Secretary has determined and notified` FALSE FALSE EQUALS NOTHING
-- (f)(3)(B)(ii) arguments: (I) too few eligible plans, (II)(aa) enough pilot projects carried out, (II)(bb) all-State authorization not in the program's best interest
#ASSERT `s 2017(f)(3)(B)(ii) the finding exists` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2017(f)(3)(B)(ii) the finding exists` FALSE TRUE TRUE EQUALS JUST TRUE
-- (II) needs both (aa) and (bb)
#ASSERT `s 2017(f)(3)(B)(ii) the finding exists` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2017(f)(3)(B)(ii) the finding exists` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2017(f)(3)(B)(ii) the finding exists` FALSE FALSE FALSE EQUALS JUST FALSE
-- (f)(3)(B)(i): with the finding, the Secretary "shall not authorize implementation" and "shall terminate all pilot projects"
#ASSERT `s 2017(f)(3)(B)(i)(I) the Secretary may authorize implementation of paragraph (1) in all States` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 2017(f)(3)(B)(i)(I) the Secretary may authorize implementation of paragraph (1) in all States` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 2017(f)(3)(B)(i)(I) the Secretary may authorize implementation of paragraph (1) in all States` NOTHING EQUALS NOTHING
#ASSERT `s 2017(f)(3)(B)(i)(II) the Secretary must terminate all pilot projects under paragraph (2) within a reasonable period` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2017(f)(3)(B)(i)(II) the Secretary must terminate all pilot projects under paragraph (2) within a reasonable period` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 2017(f)(3)(B)(i)(II) the Secretary must terminate all pilot projects under paragraph (2) within a reasonable period` NOTHING EQUALS NOTHING

§ `Tests -- every constructor and type declared in snap3-s2017.l4 is built once`

#ASSERT `s 2017(c)(1) no allotment may be issued` EQUALS `s 2017(c)(1) no allotment may be issued`
#ASSERT `s 2017(c)(1) not covered` EQUALS `s 2017(c)(1) not covered`
#ASSERT `s 2017(c)(1) an allotment of` 1 EQUALS `s 2017(c)(1) an allotment of` 1
#ASSERT NOT (`s 2017(c)(1) an allotment of` 1 EQUALS `s 2017(c)(1) an allotment of` 2)
#ASSERT `s 2017(c)(3) section 2020(e)(3) governs` EQUALS `s 2017(c)(3) section 2020(e)(3) governs`
#ASSERT `s 2017(c)(3) paragraphs (3) and (9) of section 2020(e) govern` EQUALS `s 2017(c)(3) paragraphs (3) and (9) of section 2020(e) govern`
#ASSERT NOT (`s 2017(c)(3) section 2020(e)(3) governs` EQUALS `s 2017(c)(3) paragraphs (3) and (9) of section 2020(e) govern`)
