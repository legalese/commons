IMPORT prelude
IMPORT daydate
IMPORT `snap-core`
IMPORT `snap1-logic`
IMPORT `snap1-s2014-f`

-- Tests for 7 U.S.C. 2014(f). Expected values are written from the text before the code was run.

§ `s 2014(f)(1) tests`

-- (A) first sentence
#ASSERT `s 2014(f)(1)(A) the household income is averaged over a twelve-month period` TRUE EQUALS JUST TRUE
#ASSERT `s 2014(f)(1)(A) the household income is averaged over a twelve-month period` FALSE EQUALS NOTHING
-- 12,000 dollars derived in a shorter period, spread over twelve months, is 1,000 a month
#ASSERT `s 2014(f)(1)(A) the monthly income when averaged over a twelve-month period` 12000 EQUALS 1000
#ASSERT `s 2014(f)(1)(A) the monthly income when averaged over a twelve-month period` 0 EQUALS 0
#ASSERT `s 2014(f)(1)(A) the monthly income when averaged over a twelve-month period` 6000 EQUALS 500
-- (A) second sentence: the option of the household, and each of the three limbs of the class
#ASSERT `s 2014(f)(1)(A) the farming income and expenses may be averaged over a 12-month period` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2014(f)(1)(A) the farming income and expenses may be averaged over a 12-month period` TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 2014(f)(1)(A) the farming income and expenses may be averaged over a 12-month period` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 2014(f)(1)(A) the farming income and expenses may be averaged over a 12-month period` TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 2014(f)(1)(A) the farming income and expenses may be averaged over a 12-month period` TRUE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 2014(f)(1)(A) the monthly expenses when averaged over a 12-month period` 3600 EQUALS 300
-- (A) third sentence: both limbs together, the State agency must use anticipated earnings; a failed "if" is the text's no (marginal reading (a))
#ASSERT `s 2014(f)(1)(A) the State agency must calculate the self-employment income on anticipated earnings` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2014(f)(1)(A) the State agency must calculate the self-employment income on anticipated earnings` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2014(f)(1)(A) the State agency must calculate the self-employment income on anticipated earnings` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2014(f)(1)(A) the State agency must calculate the self-employment income on anticipated earnings` FALSE FALSE EQUALS JUST FALSE
-- (B)
#ASSERT `s 2014(f)(1)(B) the household income is averaged over the period for which it is received` TRUE EQUALS JUST TRUE
#ASSERT `s 2014(f)(1)(B) the household income is averaged over the period for which it is received` FALSE EQUALS NOTHING
#ASSERT `s 2014(f)(1)(B) the monthly income when averaged over the period for which it is received` 1200 4 EQUALS JUST 300
#ASSERT `s 2014(f)(1)(B) the monthly income when averaged over the period for which it is received` 900 3 EQUALS JUST 300
#ASSERT `s 2014(f)(1)(B) the monthly income when averaged over the period for which it is received` 900 1 EQUALS JUST 900
#ASSERT `s 2014(f)(1)(B) the monthly income when averaged over the period for which it is received` 900 0 EQUALS NOTHING
#ASSERT `s 2014(f)(1)(B) the monthly income when averaged over the period for which it is received` 900 (0 MINUS 1) EQUALS NOTHING
-- (C): the two changes that may not be disregarded, whatever else is true; a change that affects deductions may be; any other change is not covered
#ASSERT `s 2014(f)(1)(C) the State agency may disregard the change until the next recertification` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2014(f)(1)(C) the State agency may disregard the change until the next recertification` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2014(f)(1)(C) the State agency may disregard the change until the next recertification` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2014(f)(1)(C) the State agency may disregard the change until the next recertification` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2014(f)(1)(C) the State agency may disregard the change until the next recertification` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2014(f)(1)(C) the State agency may disregard the change until the next recertification` FALSE FALSE FALSE EQUALS NOTHING

§ `s 2014(f)(2) tests`

-- Arguments: first month, second month, State opted to apply (B) to the second month, household in (C) clauses (MAYBE), household monthly-reporting (MAYBE), State opted retrospective.
-- (B) governs the first month, and the second month if the State opted, unless the household is in (C) (the text does not say which wins) or whether it is was not supplied.
#ASSERT `s 2014(f)(2) the basis on which the household's income is calculated` TRUE FALSE FALSE (JUST FALSE) (JUST FALSE) FALSE EQUALS `s 2014(f)(2)(B) the income and circumstances of the first or second month`
#ASSERT `s 2014(f)(2) the basis on which the household's income is calculated` TRUE FALSE FALSE (JUST FALSE) (JUST TRUE) FALSE EQUALS `s 2014(f)(2)(B) the income and circumstances of the first or second month`
#ASSERT `s 2014(f)(2) the basis on which the household's income is calculated` TRUE FALSE FALSE (JUST FALSE) NOTHING TRUE EQUALS `s 2014(f)(2)(B) the income and circumstances of the first or second month`
#ASSERT `s 2014(f)(2) the basis on which the household's income is calculated` TRUE FALSE FALSE (JUST TRUE) (JUST FALSE) FALSE EQUALS `s 2014(f)(2) basis not covered by this text`
#ASSERT `s 2014(f)(2) the basis on which the household's income is calculated` TRUE FALSE FALSE NOTHING (JUST FALSE) FALSE EQUALS `s 2014(f)(2) basis not covered by this text`
#ASSERT `s 2014(f)(2) the basis on which the household's income is calculated` FALSE TRUE TRUE (JUST FALSE) (JUST FALSE) FALSE EQUALS `s 2014(f)(2)(B) the income and circumstances of the first or second month`
#ASSERT `s 2014(f)(2) the basis on which the household's income is calculated` FALSE TRUE TRUE (JUST TRUE) (JUST FALSE) FALSE EQUALS `s 2014(f)(2) basis not covered by this text`
-- the second month when the State did not opt is an ordinary month
#ASSERT `s 2014(f)(2) the basis on which the household's income is calculated` FALSE TRUE FALSE (JUST FALSE) (JUST FALSE) FALSE EQUALS `s 2014(f)(3)(A) prospective basis`
#ASSERT `s 2014(f)(2) the basis on which the household's income is calculated` FALSE TRUE FALSE (JUST FALSE) (JUST TRUE) FALSE EQUALS `s 2014(f)(3)(B) retrospective basis`
-- an ordinary month: (C) households prospective, (D) households retrospective, the rest (A) at the State's option
#ASSERT `s 2014(f)(2) the basis on which the household's income is calculated` FALSE FALSE FALSE (JUST TRUE) (JUST FALSE) FALSE EQUALS `s 2014(f)(3)(A) prospective basis`
#ASSERT `s 2014(f)(2) the basis on which the household's income is calculated` FALSE FALSE FALSE (JUST TRUE) (JUST FALSE) TRUE EQUALS `s 2014(f)(3)(A) prospective basis`
#ASSERT `s 2014(f)(2) the basis on which the household's income is calculated` FALSE FALSE FALSE (JUST FALSE) (JUST TRUE) FALSE EQUALS `s 2014(f)(3)(B) retrospective basis`
#ASSERT `s 2014(f)(2) the basis on which the household's income is calculated` FALSE FALSE FALSE (JUST FALSE) (JUST TRUE) TRUE EQUALS `s 2014(f)(3)(B) retrospective basis`
#ASSERT `s 2014(f)(2) the basis on which the household's income is calculated` FALSE FALSE FALSE (JUST FALSE) (JUST FALSE) FALSE EQUALS `s 2014(f)(3)(A) prospective basis`
#ASSERT `s 2014(f)(2) the basis on which the household's income is calculated` FALSE FALSE FALSE (JUST FALSE) (JUST FALSE) TRUE EQUALS `s 2014(f)(3)(B) retrospective basis`
-- not covered: in both (C) and (D); or an answer for (C) or (D) was not supplied
#ASSERT `s 2014(f)(2) the basis on which the household's income is calculated` FALSE FALSE FALSE (JUST TRUE) (JUST TRUE) FALSE EQUALS `s 2014(f)(2) basis not covered by this text`
#ASSERT `s 2014(f)(2) the basis on which the household's income is calculated` FALSE FALSE FALSE NOTHING (JUST FALSE) FALSE EQUALS `s 2014(f)(2) basis not covered by this text`
#ASSERT `s 2014(f)(2) the basis on which the household's income is calculated` FALSE FALSE FALSE (JUST FALSE) NOTHING FALSE EQUALS `s 2014(f)(2) basis not covered by this text`
#ASSERT `s 2014(f)(2) the basis on which the household's income is calculated` FALSE FALSE FALSE (JUST TRUE) NOTHING FALSE EQUALS `s 2014(f)(2) basis not covered by this text`

§ `s 2014(f)(3) tests`

-- The prospective calculation takes into account both figures; the text does not say how they are combined.
#ASSERT (`s 2014(f)(3)(A) the figures the prospective calculation takes into account` 1000 250)'s `s 2014(f)(3)(A) the income reasonably anticipated to be received by the household during the period for which eligibility or benefits are being determined` EQUALS 1000
#ASSERT (`s 2014(f)(3)(A) the figures the prospective calculation takes into account` 1000 250)'s `s 2014(f)(3)(A) the income received by the household during the preceding thirty days` EQUALS 250
#ASSERT `s 2014(f)(3)(B) the income calculated on a retrospective basis` 800 EQUALS 800
#ASSERT `s 2014(f)(3)(B) the initial allotment must be supplemented` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2014(f)(3)(B) the initial allotment must be supplemented` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2014(f)(3)(B) the initial allotment must be supplemented` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2014(f)(3)(B) the initial allotment must be supplemented` FALSE FALSE EQUALS NOTHING

§ `s 2014(f)(4) tests`

-- Arguments: the State agency has requested the waiver, the provision is paragraph (2)(A), the waiver is necessary for the title IV-A basis.
#ASSERT `s 2014(f)(4) the Secretary may waive the provision` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 2014(f)(4) the Secretary may waive the provision` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2014(f)(4) the Secretary may waive the provision` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2014(f)(4) the Secretary may waive the provision` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 2014(f)(4) the Secretary may waive the provision` FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 2014(f)(4) the Secretary may waive the provision` FALSE FALSE FALSE EQUALS NOTHING
