IMPORT prelude
IMPORT daydate
IMPORT `snap-core`
IMPORT `snap3-s2016-a-to-g`

-- TESTS for section 2016(a) to (g) (snap3-s2016-a-to-g.l4). Every expected value is worked out from the text and written beside the assertion, BEFORE running.
-- The date of enactment is taken as 18 June 2008 (NOTES.md, fork F-2016-1), so one year after is 18 June 2009.

§ `Tests -- the dates the section counts from`

#ASSERT `s 2016(f)(3) the date of enactment of the Food, Conservation, and Energy Act of 2008` EQUALS Date 18 6 2008
#ASSERT `s 2016(f)(4)(A) the date from which the bar on manual vouchers takes effect` EQUALS Date 7 2 2014

§ `Tests -- s 2016(a) EBT cards go only to certified households`

-- arguments: the household has been duly certified, the card is issued under subsection (i)
#ASSERT `s 2016(a) an EBT card may be issued to the household` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 2016(a) an EBT card may be issued to the household` (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 2016(a) an EBT card may be issued to the household` NOTHING FALSE EQUALS NOTHING
-- "Except as provided in subsection (i)": the exception sends the question to subsection (i)
#ASSERT `s 2016(a) an EBT card may be issued to the household` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 2016(a) an EBT card may be issued to the household` (JUST TRUE) TRUE EQUALS NOTHING

§ `Tests -- s 2016(b) use of benefits`

-- arguments: the thing bought is food, bought from an approved retail food store, the price is the prevailing price
#ASSERT `s 2016(b) the household may use the benefits for the purchase` (JUST TRUE) (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 2016(b) the household may use the benefits for the purchase` (JUST FALSE) (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 2016(b) the household may use the benefits for the purchase` (JUST TRUE) (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 2016(b) the household may use the benefits for the purchase` (JUST TRUE) (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 2016(b) the household may use the benefits for the purchase` NOTHING (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `s 2016(b) the household may use the benefits for the purchase` (JUST TRUE) NOTHING TRUE EQUALS NOTHING
#ASSERT `s 2016(b) the household may use the benefits for the purchase` NOTHING NOTHING FALSE EQUALS JUST FALSE
-- the proviso on prices
#ASSERT `s 2016(b) this chapter authorizes the Secretary to specify the prices` TRUE EQUALS JUST FALSE
#ASSERT `s 2016(b) this chapter authorizes the Secretary to specify the prices` FALSE EQUALS NOTHING

§ `Tests -- s 2016(c) design`

-- arguments: simple in design, every word and illustration required to explain the purpose
#ASSERT `s 2016(c)(1) the EBT card is as the paragraph requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2016(c)(1) the EBT card is as the paragraph requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2016(c)(1) the EBT card is as the paragraph requires` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2016(c)(2) the EBT card may bear the name of the public official` TRUE EQUALS JUST FALSE
#ASSERT `s 2016(c)(2) the EBT card may bear the name of the public official` FALSE EQUALS NOTHING

§ `Tests -- s 2016(e) State issuance liability`

-- arguments: a financial loss in the acceptance, storage and issuance of benefits, from a mailed authorization
#ASSERT `s 2016(e) the State agency is strictly liable to the Secretary for the loss` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2016(e) the State agency is strictly liable to the Secretary for the loss` TRUE TRUE EQUALS NOTHING
#ASSERT `s 2016(e) the State agency is strictly liable to the Secretary for the loss` FALSE FALSE EQUALS NOTHING
#ASSERT `s 2016(e) the State agency is strictly liable to the Secretary for the loss` FALSE TRUE EQUALS NOTHING
-- arguments: the loss kind, from a mailed authorization, the loss in dollars, the dollars the regulations make the State agency liable for
#ASSERT `s 2016(e) the amount of the loss for which the State agency is liable to the Secretary` TRUE FALSE 1000 NOTHING EQUALS JUST 1000
#ASSERT `s 2016(e) the amount of the loss for which the State agency is liable to the Secretary` TRUE TRUE 1000 (JUST 400) EQUALS JUST 400
#ASSERT `s 2016(e) the amount of the loss for which the State agency is liable to the Secretary` TRUE TRUE 1000 NOTHING EQUALS NOTHING
#ASSERT `s 2016(e) the amount of the loss for which the State agency is liable to the Secretary` FALSE FALSE 1000 (JUST 400) EQUALS NOTHING

§ `Tests -- s 2016(f)(1) alternative methods`

#ASSERT `s 2016(f)(1) the Secretary must require a State agency to issue or deliver benefits using alternative methods` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2016(f)(1) the Secretary must require a State agency to issue or deliver benefits using alternative methods` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2016(f)(1) the Secretary must require a State agency to issue or deliver benefits using alternative methods` NOTHING EQUALS NOTHING

§ `Tests -- s 2016(f)(2) costs of point-of-sale equipment`

-- arguments: a participating retail food store, exempted under subparagraph (B)
#ASSERT `s 2016(f)(2)(A) the percent of the costs the Secretary must require the store to pay` TRUE FALSE EQUALS JUST 100
#ASSERT `s 2016(f)(2)(A) the percent of the costs the Secretary must require the store to pay` TRUE TRUE EQUALS NOTHING
#ASSERT `s 2016(f)(2)(A) the percent of the costs the Secretary must require the store to pay` FALSE FALSE EQUALS NOTHING
-- arguments: farmers' market, military commissary, nonprofit cooperative, 2012(k)(5)(7)(8), 2012(k)(3)(4)(9), restaurant in a State option restaurant program
#ASSERT `s 2016(f)(2)(B) the Secretary may exempt the store from subparagraph (A)` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2016(f)(2)(B) the Secretary may exempt the store from subparagraph (A)` FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2016(f)(2)(B) the Secretary may exempt the store from subparagraph (A)` FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2016(f)(2)(B) the Secretary may exempt the store from subparagraph (A)` FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2016(f)(2)(B) the Secretary may exempt the store from subparagraph (A)` FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
-- clause (ii) excludes restaurants in a State option restaurant program
#ASSERT `s 2016(f)(2)(B) the Secretary may exempt the store from subparagraph (A)` FALSE FALSE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
-- but a farmers' market within clause (i) is exempt whether or not it is also such a restaurant
#ASSERT `s 2016(f)(2)(B) the Secretary may exempt the store from subparagraph (A)` TRUE FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2016(f)(2)(B) the Secretary may exempt the store from subparagraph (A)` FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 2016(f)(2)(B) the Secretary may exempt the store from subparagraph (A)` FALSE FALSE FALSE FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 2016(f)(2)(C) paragraph (2) permits the charging of the fee` TRUE EQUALS JUST FALSE
#ASSERT `s 2016(f)(2)(C) paragraph (2) permits the charging of the fee` FALSE EQUALS NOTHING

§ `Tests -- s 2016(f)(3) coupons, EBT cards and the end of paper`

-- (A): arguments are the date of issue, whether the thing is a coupon, stamp, certificate or authorization card. Enactment is 18 June 2008.
#ASSERT `s 2016(f)(3)(A) a State may issue the thing to a household that receives supplemental nutrition assistance` (Date 18 6 2008) TRUE EQUALS JUST FALSE
#ASSERT `s 2016(f)(3)(A) a State may issue the thing to a household that receives supplemental nutrition assistance` (Date 17 6 2008) TRUE EQUALS NOTHING
#ASSERT `s 2016(f)(3)(A) a State may issue the thing to a household that receives supplemental nutrition assistance` (Date 1 1 2027) TRUE EQUALS JUST FALSE
#ASSERT `s 2016(f)(3)(A) a State may issue the thing to a household that receives supplemental nutrition assistance` (Date 18 6 2008) FALSE EQUALS NOTHING
-- (B): arguments are the date of the exchange, whether the card was issued under subsection (i). One year after enactment is 18 June 2009.
#ASSERT `s 2016(f)(3)(B) the card is eligible for exchange at a retail food store` (Date 17 6 2009) FALSE EQUALS NOTHING
#ASSERT `s 2016(f)(3)(B) the card is eligible for exchange at a retail food store` (Date 18 6 2009) FALSE EQUALS JUST FALSE
#ASSERT `s 2016(f)(3)(B) the card is eligible for exchange at a retail food store` (Date 18 6 2009) TRUE EQUALS NOTHING
#ASSERT `s 2016(f)(3)(B) the card is eligible for exchange at a retail food store` (Date 1 1 2027) FALSE EQUALS JUST FALSE
-- (C): arguments are the date the question is asked, whether the coupon was redeemed in the year beginning on the date of enactment
#ASSERT `s 2016(f)(3)(C) the coupon is still an obligation of the Federal Government` (Date 17 6 2009) FALSE EQUALS NOTHING
#ASSERT `s 2016(f)(3)(C) the coupon is still an obligation of the Federal Government` (Date 18 6 2009) FALSE EQUALS JUST FALSE
#ASSERT `s 2016(f)(3)(C) the coupon is still an obligation of the Federal Government` (Date 18 6 2009) TRUE EQUALS NOTHING
#ASSERT `s 2016(f)(3)(C) the coupon is redeemable` (Date 17 6 2009) FALSE EQUALS NOTHING
#ASSERT `s 2016(f)(3)(C) the coupon is redeemable` (Date 18 6 2009) FALSE EQUALS JUST FALSE
#ASSERT `s 2016(f)(3)(C) the coupon is redeemable` (Date 18 6 2009) TRUE EQUALS NOTHING

§ `Tests -- s 2016(f)(4) manual vouchers`

-- arguments: the date of issue or acceptance, the Secretary's determination that manual vouchers are necessary
#ASSERT `s 2016(f)(4)(A) a State may issue manual vouchers to a household or allow retail food stores to accept them` (Date 6 2 2014) NOTHING EQUALS NOTHING
#ASSERT `s 2016(f)(4)(A) a State may issue manual vouchers to a household or allow retail food stores to accept them` (Date 6 2 2014) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 2016(f)(4)(A) a State may issue manual vouchers to a household or allow retail food stores to accept them` (Date 7 2 2014) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2016(f)(4)(A) a State may issue manual vouchers to a household or allow retail food stores to accept them` (Date 7 2 2014) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 2016(f)(4)(A) a State may issue manual vouchers to a household or allow retail food stores to accept them` (Date 7 2 2014) NOTHING EQUALS NOTHING
#ASSERT `s 2016(f)(4)(B) the Secretary may exempt the category of retail food stores or the individual retail food store from subparagraph (A)` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2016(f)(4)(B) the Secretary may exempt the category of retail food stores or the individual retail food store from subparagraph (A)` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2016(f)(4)(B) the Secretary may exempt the category of retail food stores or the individual retail food store from subparagraph (A)` NOTHING EQUALS NOTHING

§ `Tests -- s 2016(f)(5) unique terminal identification and point-of-sale devices`

#ASSERT `s 2016(f)(5)(A) the Secretary has done what the subparagraph requires` TRUE EQUALS JUST TRUE
#ASSERT `s 2016(f)(5)(A) the Secretary has done what the subparagraph requires` FALSE EQUALS NOTHING
-- arguments: exempt under (2)(B)(i), gave location and hours, device reports its location, Secretary's determination that the technology is not available, gave the other information
#ASSERT `s 2016(f)(5)(C) the farmers' market or direct marketing farmer shall be allowed to operate the device at more than 1 location under the same authorization` FALSE TRUE TRUE NOTHING FALSE EQUALS NOTHING
#ASSERT `s 2016(f)(5)(C) the farmers' market or direct marketing farmer shall be allowed to operate the device at more than 1 location under the same authorization` TRUE FALSE TRUE NOTHING FALSE EQUALS JUST FALSE
#ASSERT `s 2016(f)(5)(C) the farmers' market or direct marketing farmer shall be allowed to operate the device at more than 1 location under the same authorization` TRUE TRUE TRUE NOTHING FALSE EQUALS JUST TRUE
#ASSERT `s 2016(f)(5)(C) the farmers' market or direct marketing farmer shall be allowed to operate the device at more than 1 location under the same authorization` TRUE TRUE FALSE (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 2016(f)(5)(C) the farmers' market or direct marketing farmer shall be allowed to operate the device at more than 1 location under the same authorization` TRUE TRUE FALSE (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 2016(f)(5)(C) the farmers' market or direct marketing farmer shall be allowed to operate the device at more than 1 location under the same authorization` TRUE TRUE FALSE NOTHING TRUE EQUALS NOTHING
#ASSERT `s 2016(f)(5)(C) the farmers' market or direct marketing farmer shall be allowed to operate the device at more than 1 location under the same authorization` TRUE TRUE FALSE (JUST FALSE) TRUE EQUALS JUST FALSE

§ `Tests -- s 2016(g) staggered issuance`

#ASSERT `s 2016(g)(1) the State agency may establish a procedure for staggering the issuance of benefits` TRUE EQUALS JUST TRUE
#ASSERT `s 2016(g)(1) the State agency may establish a procedure for staggering the issuance of benefits` FALSE EQUALS NOTHING
-- arguments: the tribal organization has made the request, the households are eligible households on the reservation
#ASSERT `s 2016(g)(1) the State agency must stagger the issuance of benefits for the households` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2016(g)(1) the State agency must stagger the issuance of benefits for the households` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2016(g)(1) the State agency must stagger the issuance of benefits for the households` FALSE TRUE EQUALS NOTHING
-- "at least 15 days of a month"
#ASSERT `s 2016(g)(1) the staggering for households on reservations meets the requirement` 15 EQUALS JUST TRUE
#ASSERT `s 2016(g)(1) the staggering for households on reservations meets the requirement` 31 EQUALS JUST TRUE
#ASSERT `s 2016(g)(1) the staggering for households on reservations meets the requirement` 14 EQUALS JUST FALSE
#ASSERT `s 2016(g)(1) the staggering for households on reservations meets the requirement` 14.5 EQUALS JUST FALSE
-- (2)(A)(i): the amount by which the procedure reduces the allotment
#ASSERT `s 2016(g)(2)(A)(i) the procedure meets the requirement that it not reduce the allotment of any household` 0 EQUALS JUST TRUE
#ASSERT `s 2016(g)(2)(A)(i) the procedure meets the requirement that it not reduce the allotment of any household` 0.01 EQUALS JUST FALSE
#ASSERT `s 2016(g)(2)(A)(i) the procedure meets the requirement that it not reduce the allotment of any household` 10 EQUALS JUST FALSE
-- (2)(A)(ii): "an interval between issuances of more than 40 days"
#ASSERT `s 2016(g)(2)(A)(ii) the interval between issuances meets the requirement` 39 EQUALS JUST TRUE
#ASSERT `s 2016(g)(2)(A)(ii) the interval between issuances meets the requirement` 40 EQUALS JUST TRUE
#ASSERT `s 2016(g)(2)(A)(ii) the interval between issuances meets the requirement` 41 EQUALS JUST FALSE
#ASSERT `s 2016(g)(2)(A)(ii) the interval between issuances meets the requirement` 40.5 EQUALS JUST FALSE
-- (2)(B): arguments are the number of issuances in the month, whether a benefit correction is necessary
#ASSERT `s 2016(g)(2)(B) the procedure may include the issuances` 1 FALSE EQUALS NOTHING
#ASSERT `s 2016(g)(2)(B) the procedure may include the issuances` 0 FALSE EQUALS NOTHING
#ASSERT `s 2016(g)(2)(B) the procedure may include the issuances` 2 TRUE EQUALS NOTHING
#ASSERT `s 2016(g)(2)(B) the procedure may include the issuances` 2 FALSE EQUALS JUST FALSE
#ASSERT `s 2016(g)(2)(B) the procedure may include the issuances` 3 FALSE EQUALS JUST FALSE
