IMPORT prelude
IMPORT daydate
IMPORT `snap5-s2028`

-- TESTS for snap5-s2028.l4 (section 2028). Every expected value was written down from the text before the file was run.
-- A pair of assertions on either side of a threshold is marked "edge".

§ `s 2028(a)(1) governmental entity`

#ASSERT `s 2028(a)(1) the place is a governmental entity` `s 2028 the Commonwealth of Puerto Rico` EQUALS JUST TRUE
#ASSERT `s 2028(a)(1) the place is a governmental entity` `s 2028 American Samoa` EQUALS JUST TRUE
#ASSERT `s 2028(a)(1) the place is a governmental entity` `s 2028 any other place` EQUALS JUST FALSE

§ `s 2028(a)(2)(A) the amount of the block grants`

-- clause (i): $1,401,000,000 for fiscal year 2003, whatever the percentage and the appropriation
#ASSERT `s 2028(a)(2)(A) the amount of the block grants for the fiscal year` 2003 0.05 NOTHING EQUALS JUST 1_401_000_000
-- clause (ii): 1,401,000,000 TIMES 1.05 is 1,471,050,000
#ASSERT `s 2028(a)(2)(A) the amount of the block grants for the fiscal year` 2004 0.05 (JUST TRUE) EQUALS JUST 1_471_050_000
#ASSERT `s 2028(a)(2)(A) the amount of the block grants for the fiscal year` 2004 0 (JUST TRUE) EQUALS JUST 1_401_000_000
-- subject to the availability of appropriations: no appropriation, or none stated, is not covered
#ASSERT `s 2028(a)(2)(A) the amount of the block grants for the fiscal year` 2004 0.05 (JUST FALSE) EQUALS NOTHING
#ASSERT `s 2028(a)(2)(A) the amount of the block grants for the fiscal year` 2004 0.05 NOTHING EQUALS NOTHING
-- edge: fiscal year 2002 is before the first year the text names
#ASSERT `s 2028(a)(2)(A) the amount of the block grants for the fiscal year` 2002 0.05 (JUST TRUE) EQUALS NOTHING

§ `s 2028(a)(2)(B) payments to the Commonwealth of Puerto Rico`

-- 99.6 percent of 1,000,000,000 is 996,000,000
#ASSERT `s 2028(a)(2)(B)(i) the Commonwealth's share of the funds` 2003 1_000_000_000 EQUALS JUST 996_000_000
#ASSERT `s 2028(a)(2)(B)(i) the Commonwealth's share of the funds` 2010 1_000 EQUALS JUST 996
-- edge: fiscal year 2002 is before "fiscal year 2003 and each fiscal year thereafter"
#ASSERT `s 2028(a)(2)(B)(i) the Commonwealth's share of the funds` 2002 1_000_000_000 EQUALS NOTHING
-- 100 percent of 1,000 plus 50 percent of 200 is 1,100; 100 percent of 0 plus 50 percent of 50 is 25
#ASSERT `s 2028(a)(2)(B)(i) the payment toward the Commonwealth's expenditures and administrative expenses` 1_000 200 EQUALS 1_100
#ASSERT `s 2028(a)(2)(B)(i) the payment toward the Commonwealth's expenditures and administrative expenses` 0 50 EQUALS 25

-- clause (ii): fiscal year 2002 or 2003, the three listed costs, not more than $6,000,000
#ASSERT `s 2028(a)(2)(B)(ii) the Commonwealth may spend the amount on the cost` 2002 `s 2028(a)(2)(B)(ii) upgrading and modernizing the electronic data processing system` 6_000_000 EQUALS JUST TRUE
#ASSERT `s 2028(a)(2)(B)(ii) the Commonwealth may spend the amount on the cost` 2003 `s 2028(a)(2)(B)(ii) implementing systems to simplify the determination of eligibility` 100 EQUALS JUST TRUE
#ASSERT `s 2028(a)(2)(B)(ii) the Commonwealth may spend the amount on the cost` 2003 `s 2028(a)(2)(B)(ii) operating systems to deliver the nutrition assistance through electronic benefit transfers` 100 EQUALS JUST TRUE
-- edge: one dollar over the $6,000,000
#ASSERT `s 2028(a)(2)(B)(ii) the Commonwealth may spend the amount on the cost` 2002 `s 2028(a)(2)(B)(ii) upgrading and modernizing the electronic data processing system` 6_000_001 EQUALS JUST FALSE
-- a cost the clause does not list, in a year the clause names: not covered
#ASSERT `s 2028(a)(2)(B)(ii) the Commonwealth may spend the amount on the cost` 2003 `s 2028(a)(2)(B)(ii) any other cost` 100 EQUALS NOTHING
-- edge: fiscal years 2001 and 2004 are outside "fiscal year 2002 or 2003"
#ASSERT `s 2028(a)(2)(B)(ii) the Commonwealth may spend the amount on the cost` 2001 `s 2028(a)(2)(B)(ii) upgrading and modernizing the electronic data processing system` 100 EQUALS NOTHING
#ASSERT `s 2028(a)(2)(B)(ii) the Commonwealth may spend the amount on the cost` 2004 `s 2028(a)(2)(B)(ii) upgrading and modernizing the electronic data processing system` 100 EQUALS NOTHING

§ `s 2028(a)(2)(C) payments to American Samoa`

-- 0.4 percent of 1,000,000,000 is 4,000,000
#ASSERT `s 2028(a)(2)(C) American Samoa's share of the funds` 2003 1_000_000_000 EQUALS JUST 4_000_000
#ASSERT `s 2028(a)(2)(C) American Samoa's share of the funds` 2002 1_000_000_000 EQUALS NOTHING
#ASSERT `s 2028(a)(2)(C) the payment toward American Samoa's expenditures` 500 TRUE EQUALS JUST 500
#ASSERT `s 2028(a)(2)(C) the payment toward American Samoa's expenditures` 500 FALSE EQUALS NOTHING

§ `s 2028(a)(2)(D) carryover`

-- 2 percent of 1,000 is 20; edge: 20 is within the limit, 20.01 is not
#ASSERT `s 2028(a)(2)(D) the carryover is within the limit` 2002 1_000 20 EQUALS JUST TRUE
#ASSERT `s 2028(a)(2)(D) the carryover is within the limit` 2002 1_000 20.01 EQUALS JUST FALSE
#ASSERT `s 2028(a)(2)(D) the carryover is within the limit` 2010 1_000 0 EQUALS JUST TRUE
-- edge: fiscal year 2001 is before "fiscal year 2002"
#ASSERT `s 2028(a)(2)(D) the carryover is within the limit` 2001 1_000 500 EQUALS NOTHING

§ `s 2028(a)(3) the payment to the Commonwealth`

-- 1,000 minus a prior overpayment of 50 plus a current underpayment of 30 is 980
#ASSERT `s 2028(a)(3) the payment to the Commonwealth for the fiscal year` 1_000 50 30 (JUST TRUE) EQUALS JUST 980
#ASSERT `s 2028(a)(3) the payment to the Commonwealth for the fiscal year` 1_000 0 0 (JUST TRUE) EQUALS JUST 1_000
#ASSERT `s 2028(a)(3) the payment to the Commonwealth for the fiscal year` 1_000 50 30 (JUST FALSE) EQUALS NOTHING
#ASSERT `s 2028(a)(3) the payment to the Commonwealth for the fiscal year` 1_000 50 30 NOTHING EQUALS NOTHING

§ `s 2028(b)(1) the plan`

#ASSERT `s 2028(b)(1) the Commonwealth may receive payments` TRUE EQUALS JUST TRUE
#ASSERT `s 2028(b)(1) the Commonwealth may receive payments` FALSE EQUALS JUST FALSE

-- by July 1; edge: 1 July is in time, 2 July is not
#ASSERT `s 2028(b)(1)(A) the plan is submitted in time` TRUE (Date 1 7 2026) 2026 EQUALS JUST TRUE
#ASSERT `s 2028(b)(1)(A) the plan is submitted in time` TRUE (Date 2 7 2026) 2026 EQUALS JUST FALSE
#ASSERT `s 2028(b)(1)(A) the plan is submitted in time` TRUE (Date 30 6 2026) 2026 EQUALS JUST TRUE
-- if the Commonwealth does not wish to receive payments, the deadline is not engaged
#ASSERT `s 2028(b)(1)(A) the plan is submitted in time` FALSE (Date 2 7 2026) 2026 EQUALS NOTHING

-- the five contents; edge: an estimate equal to the amount provided is "up to" it
#ASSERT `s 2028(b)(1)(A) the plan has the required contents` TRUE TRUE TRUE 100 200 TRUE EQUALS JUST TRUE
#ASSERT `s 2028(b)(1)(A) the plan has the required contents` TRUE TRUE TRUE 200 200 TRUE EQUALS JUST TRUE
#ASSERT `s 2028(b)(1)(A) the plan has the required contents` TRUE TRUE TRUE 201 200 TRUE EQUALS JUST FALSE
#ASSERT `s 2028(b)(1)(A) the plan has the required contents` FALSE TRUE TRUE 100 200 TRUE EQUALS JUST FALSE
#ASSERT `s 2028(b)(1)(A) the plan has the required contents` TRUE FALSE TRUE 100 200 TRUE EQUALS JUST FALSE
#ASSERT `s 2028(b)(1)(A) the plan has the required contents` TRUE TRUE FALSE 100 200 TRUE EQUALS JUST FALSE
#ASSERT `s 2028(b)(1)(A) the plan has the required contents` TRUE TRUE TRUE 100 200 FALSE EQUALS JUST FALSE

-- approval by August 1 of the year of submission; edge
#ASSERT `s 2028(b)(1)(B)(i) the Secretary's decision on the plan is in time` (Date 1 8 2026) 2026 EQUALS JUST TRUE
#ASSERT `s 2028(b)(1)(B)(i) the Secretary's decision on the plan is in time` (Date 2 8 2026) 2026 EQUALS JUST FALSE
#ASSERT `s 2028(b)(1)(B)(i) the Secretary shall approve the plan` TRUE EQUALS JUST TRUE
#ASSERT `s 2028(b)(1)(B)(i) the Secretary shall approve the plan` FALSE EQUALS NOTHING

-- disapproved for noncompliance: no payments until the Secretary is satisfied
#ASSERT `s 2028(b)(1)(B)(i) payments may be made for the fiscal year of the plan` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2028(b)(1)(B)(i) payments may be made for the fiscal year of the plan` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 2028(b)(1)(B)(i) payments may be made for the fiscal year of the plan` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 2028(b)(1)(B)(i) payments may be made for the fiscal year of the plan` TRUE FALSE TRUE EQUALS NOTHING

-- clause (ii): the denial suspended and payments withheld instead
#ASSERT `s 2028(b)(1)(B)(ii) the withheld payments are to be paid` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2028(b)(1)(B)(ii) the withheld payments are to be paid` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2028(b)(1)(B)(ii) the withheld payments are to be paid` FALSE TRUE EQUALS NOTHING

§ `s 2028(b)(2) audit, report, noncompliance`

-- 30 September 2026 plus 120 days is 28 January 2027 (31 October +31, 30 November +61, 31 December +92, 28 January +120)
#ASSERT `s 2028(b)(2)(A) the last day for the report of the audit findings` (Date 30 9 2026) EQUALS Date 28 1 2027
#ASSERT `s 2028(b)(2)(A) the report of the audit findings is in time` (Date 30 9 2026) (Date 28 1 2027) EQUALS JUST TRUE
#ASSERT `s 2028(b)(2)(A) the report of the audit findings is in time` (Date 30 9 2026) (Date 29 1 2027) EQUALS JUST FALSE
-- biennial: every two years; edge: a gap of 2 is biennial, a gap of 3 is not
#ASSERT `s 2028(b)(2)(A) the audit is biennial` 2020 2022 EQUALS JUST TRUE
#ASSERT `s 2028(b)(2)(A) the audit is biennial` 2020 2021 EQUALS JUST TRUE
#ASSERT `s 2028(b)(2)(A) the audit is biennial` 2020 2023 EQUALS JUST FALSE

#ASSERT `s 2028(b)(2)(B) the statement is provided in time` (Date 30 9 2026) (Date 28 1 2027) EQUALS JUST TRUE
#ASSERT `s 2028(b)(2)(B) the statement is provided in time` (Date 30 9 2026) (Date 29 1 2027) EQUALS JUST FALSE
#ASSERT `s 2028(b)(2)(B) the statement has the required contents` TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 2028(b)(2)(B) the statement has the required contents` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- an excess stated without the amount, no statement at all, and a missing "other information" all fail
#ASSERT `s 2028(b)(2)(B) the statement has the required contents` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2028(b)(2)(B) the statement has the required contents` FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2028(b)(2)(B) the statement has the required contents` TRUE FALSE FALSE FALSE EQUALS JUST FALSE

#ASSERT `s 2028(b)(2)(C)(i) further payments may be made` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2028(b)(2)(C)(i) further payments may be made` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 2028(b)(2)(C)(i) further payments may be made` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 2028(b)(2)(C)(i) further payments may be made` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 2028(b)(2)(C)(ii) the withheld payments are to be paid` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2028(b)(2)(C)(ii) the withheld payments are to be paid` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2028(b)(2)(C)(ii) the withheld payments are to be paid` FALSE FALSE EQUALS NOTHING
#ASSERT `s 2028(b)(2)(C)(iii) the Secretary may refer the matter to the Attorney General` TRUE EQUALS JUST TRUE
#ASSERT `s 2028(b)(2)(C)(iii) the Secretary may refer the matter to the Attorney General` FALSE EQUALS NOTHING
#ASSERT `s 2028(b)(2)(C)(iii) appropriate injunctive relief shall issue` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2028(b)(2)(C)(iii) appropriate injunctive relief shall issue` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2028(b)(2)(C)(iii) appropriate injunctive relief shall issue` FALSE TRUE EQUALS NOTHING

§ `s 2028(c) review; technical assistance`

#ASSERT `s 2028(c)(1) the Secretary shall provide for the review of the program` TRUE EQUALS JUST TRUE
#ASSERT `s 2028(c)(1) the Secretary shall provide for the review of the program` FALSE EQUALS NOTHING
#ASSERT `s 2028(c)(2) the Secretary may provide technical assistance` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2028(c)(2) the Secretary may provide technical assistance` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 2028(c)(2) the Secretary may provide technical assistance` NOTHING EQUALS NOTHING

§ `s 2028(d) penalty`

#ASSERT `s 2028(d) the conduct is within the offence` `s 2028(d) embezzles` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2028(d) the conduct is within the offence` `s 2028(d) misapplies` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2028(d) the conduct is within the offence` `s 2028(d) steals` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2028(d) the conduct is within the offence` `s 2028(d) obtains by fraud` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2028(d) the conduct is within the offence` `s 2028(d) obtains by false statement` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2028(d) the conduct is within the offence` `s 2028(d) obtains by forgery` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2028(d) the conduct is within the offence` `s 2028(d) any other conduct` TRUE TRUE EQUALS NOTHING
#ASSERT `s 2028(d) the conduct is within the offence` `s 2028(d) steals` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2028(d) the conduct is within the offence` `s 2028(d) steals` TRUE FALSE EQUALS NOTHING
-- edge: "not over $200" includes $200 itself
#ASSERT `s 2028(d) the most the person may be fined, in dollars` 200 EQUALS JUST 1_000
#ASSERT `s 2028(d) the most the person may be fined, in dollars` 200.01 EQUALS JUST 10_000
#ASSERT `s 2028(d) the most the person may be fined, in dollars` 0 EQUALS JUST 1_000
#ASSERT `s 2028(d) the most the person may be fined, in dollars` 50_000 EQUALS JUST 10_000
#ASSERT `s 2028(d) the most the person may be fined, in dollars` (0 MINUS 1) EQUALS NOTHING
#ASSERT `s 2028(d) the longest term of imprisonment, in years` 200 EQUALS JUST 1
#ASSERT `s 2028(d) the longest term of imprisonment, in years` 200.01 EQUALS JUST 5
#ASSERT `s 2028(d) the longest term of imprisonment, in years` 50_000 EQUALS JUST 5
#ASSERT `s 2028(d) the longest term of imprisonment, in years` (0 MINUS 1) EQUALS NOTHING

§ `s 2028(e) cash benefits in Puerto Rico`

#ASSERT `s 2028(e)(1) the review includes the required examinations` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2028(e)(1) the review includes the required examinations` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2028(e)(1) the review includes the required examinations` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
-- 18 months after 7 February 2014 is 7 August 2015; edge
#ASSERT `s 2028(e)(2) the last day for the report` EQUALS Date 7 8 2015
#ASSERT `s 2028(e)(2) the report is in time` (Date 7 8 2015) EQUALS JUST TRUE
#ASSERT `s 2028(e)(2) the report is in time` (Date 8 8 2015) EQUALS JUST FALSE

-- the caps: 20, 15, 10, 5 percent and none for fiscal years 2017 to 2021
#ASSERT `s 2028(e)(3)(A) the largest share of a participant's benefit a plan may distribute in cash` 2017 EQUALS JUST 0.20
#ASSERT `s 2028(e)(3)(A) the largest share of a participant's benefit a plan may distribute in cash` 2018 EQUALS JUST 0.15
#ASSERT `s 2028(e)(3)(A) the largest share of a participant's benefit a plan may distribute in cash` 2019 EQUALS JUST 0.10
#ASSERT `s 2028(e)(3)(A) the largest share of a participant's benefit a plan may distribute in cash` 2020 EQUALS JUST 0.05
#ASSERT `s 2028(e)(3)(A) the largest share of a participant's benefit a plan may distribute in cash` 2021 EQUALS JUST 0
#ASSERT `s 2028(e)(3)(A) the largest share of a participant's benefit a plan may distribute in cash` 2016 EQUALS NOTHING
#ASSERT `s 2028(e)(3)(A) the largest share of a participant's benefit a plan may distribute in cash` 2022 EQUALS NOTHING
-- edge on each side of each cap: "more than" the cap is disapproved, the cap itself is not mentioned
#ASSERT `s 2028(e)(3)(A) the Secretary shall disapprove the plan` 2017 0.21 EQUALS JUST TRUE
#ASSERT `s 2028(e)(3)(A) the Secretary shall disapprove the plan` 2017 0.20 EQUALS NOTHING
#ASSERT `s 2028(e)(3)(A) the Secretary shall disapprove the plan` 2018 0.16 EQUALS JUST TRUE
#ASSERT `s 2028(e)(3)(A) the Secretary shall disapprove the plan` 2018 0.15 EQUALS NOTHING
#ASSERT `s 2028(e)(3)(A) the Secretary shall disapprove the plan` 2019 0.11 EQUALS JUST TRUE
#ASSERT `s 2028(e)(3)(A) the Secretary shall disapprove the plan` 2019 0.10 EQUALS NOTHING
#ASSERT `s 2028(e)(3)(A) the Secretary shall disapprove the plan` 2020 0.06 EQUALS JUST TRUE
#ASSERT `s 2028(e)(3)(A) the Secretary shall disapprove the plan` 2020 0.05 EQUALS NOTHING
#ASSERT `s 2028(e)(3)(A) the Secretary shall disapprove the plan` 2021 0.01 EQUALS JUST TRUE
#ASSERT `s 2028(e)(3)(A) the Secretary shall disapprove the plan` 2021 0 EQUALS NOTHING
-- a year the text states no limit for
#ASSERT `s 2028(e)(3)(A) the Secretary shall disapprove the plan` 2016 0.90 EQUALS NOTHING
#ASSERT `s 2028(e)(3)(A) the Secretary shall disapprove the plan` 2022 0.50 EQUALS NOTHING
-- subparagraph (B): the Secretary's determination
#ASSERT `s 2028(e)(3)(B) the Secretary may approve a plan that exempts participants or categories of participants` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2028(e)(3)(B) the Secretary may approve a plan that exempts participants or categories of participants` (JUST FALSE) EQUALS JUST FALSE
