IMPORT prelude
IMPORT daydate
IMPORT `snap1-logic`

-- Truth tables of the three-valued helpers, written from the definition of Kleene's operators, not from the code.
-- AND: FALSE decides; OR: TRUE decides; NOTHING otherwise. 9 rows each.
#ASSERT `snap1 both` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `snap1 both` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `snap1 both` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `snap1 both` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `snap1 both` NOTHING (JUST FALSE) EQUALS JUST FALSE
#ASSERT `snap1 both` (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `snap1 both` NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `snap1 both` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `snap1 both` NOTHING NOTHING EQUALS NOTHING

#ASSERT `snap1 either` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `snap1 either` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `snap1 either` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `snap1 either` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `snap1 either` NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `snap1 either` (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `snap1 either` NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `snap1 either` (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `snap1 either` NOTHING NOTHING EQUALS NOTHING

#ASSERT `snap1 known` TRUE EQUALS JUST TRUE
#ASSERT `snap1 known` FALSE EQUALS JUST FALSE
#ASSERT `snap1 not` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `snap1 not` (JUST FALSE) EQUALS JUST TRUE
#ASSERT `snap1 not` NOTHING EQUALS NOTHING
#ASSERT `snap1 is definitely yes` (JUST TRUE)
#ASSERT NOT (`snap1 is definitely yes` (JUST FALSE))
#ASSERT NOT (`snap1 is definitely yes` NOTHING)
#ASSERT `snap1 is definitely no` (JUST FALSE)
#ASSERT NOT (`snap1 is definitely no` (JUST TRUE))
#ASSERT NOT (`snap1 is definitely no` NOTHING)

-- Whole months between two dates, worked by hand: 15 Mar 2026 to 14 Mar 2027 is 11 whole months, to 15 Mar 2027 is 12, and the same day is 0.
#ASSERT `snap1 whole months from the earlier date to the later date` (Date 15 3 2026) (Date 14 3 2027) EQUALS 11
#ASSERT `snap1 whole months from the earlier date to the later date` (Date 15 3 2026) (Date 15 3 2027) EQUALS 12
#ASSERT `snap1 whole months from the earlier date to the later date` (Date 15 3 2026) (Date 15 3 2026) EQUALS 0
#ASSERT `snap1 whole months from the earlier date to the later date` (Date 31 1 2026) (Date 28 2 2026) EQUALS 0
#ASSERT `snap1 whole months from the earlier date to the later date` (Date 1 10 2026) (Date 30 9 2029) EQUALS 35
#ASSERT `snap1 whole months from the earlier date to the later date` (Date 1 10 2026) (Date 1 10 2029) EQUALS 36
