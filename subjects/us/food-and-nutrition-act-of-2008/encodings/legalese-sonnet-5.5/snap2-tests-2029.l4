IMPORT prelude
IMPORT daydate
IMPORT `snap-core`
IMPORT `snap2-3val`
IMPORT `snap2-2029`

-- Tests of section 2029. Expected values are decided from the quoted words before the run.

§ `Tests: 2029(a)`
-- argument order: applies and submits a plan, the plan complies with the guidelines
#ASSERT `s 2029(a)(1) the Secretary is required to permit the political subdivision to operate a workfare program` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2029(a)(1) the Secretary is required to permit the political subdivision to operate a workfare program` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2029(a)(1) the Secretary is required to permit the political subdivision to operate a workfare program` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2029(a)(1) the Secretary is required to permit the political subdivision to operate a workfare program` FALSE FALSE EQUALS NOTHING
-- argument order: participates in the program, the subdivision operates a workfare program, the (b) exemption answer
#ASSERT `s 2029(a)(1) the member is required to accept an offer from the subdivision to perform work` TRUE TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 2029(a)(1) the member is required to accept an offer from the subdivision to perform work` TRUE TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 2029(a)(1) the member is required to accept an offer from the subdivision to perform work` TRUE TRUE NOTHING EQUALS NOTHING
#ASSERT `s 2029(a)(1) the member is required to accept an offer from the subdivision to perform work` FALSE TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 2029(a)(1) the member is required to accept an offer from the subdivision to perform work` TRUE FALSE (JUST FALSE) EQUALS NOTHING
-- argument order: hours of work, the State minimum wage, the Federal minimum hourly rate; the higher of the two rates
#ASSERT `s 2029(a)(1) the portion of the allotment the household is entitled to for the hours of work` 10 8.5 7.25 EQUALS JUST 85
#ASSERT `s 2029(a)(1) the portion of the allotment the household is entitled to for the hours of work` 10 7 7.25 EQUALS JUST 72.5
#ASSERT `s 2029(a)(1) the portion of the allotment the household is entitled to for the hours of work` 10 7.25 7.25 EQUALS JUST 72.5
#ASSERT `s 2029(a)(1) the portion of the allotment the household is entitled to for the hours of work` 0 8.5 7.25 EQUALS JUST 0
#ASSERT `s 2029(a)(1) the portion of the allotment the household is entitled to for the hours of work` (0 MINUS 1) 8.5 7.25 EQUALS NOTHING
#ASSERT `s 2029(a)(1) the portion of the allotment the household is entitled to for the hours of work` 10 (0 MINUS 1) 7.25 EQUALS NOTHING
#ASSERT `s 2029(a)(2)(A) the Secretary is required to promulgate guidelines under paragraph (1)` EQUALS JUST TRUE
#ASSERT `s 2029(a)(2)(B) the political subdivision may comply with the requirements of this section by operating the program` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2029(a)(2)(B) the political subdivision may comply with the requirements of this section by operating the program` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 2029(a)(2)(B) the political subdivision may comply with the requirements of this section by operating the program` NOTHING EQUALS NOTHING

§ `Tests: 2029(b)`
-- a person: age, physically and mentally fit, pregnant, immigration status, resident, SSI, hours worked, enrolled half-time
GIVEN age IS A NUMBER, fit IS A BOOLEAN
GIVETH AN Individual
`test: person` MEANS Individual OF age, fit, FALSE, `a citizen or national of the United States`, TRUE, FALSE, 0, FALSE
-- argument order: the person, the (d)(2)(B) to (F) answer, the agency opted, subject to a title IV work activity, currently actively and satisfactorily participating, hours a week, parent or caretaker, another member subject to the requirements, another member employed fulltime
-- a person who is none of the six: no ground, so the text's "if" fails
#ASSERT `s 2029(b) the household member is exempt from workfare requirements` (`test: person` 30 TRUE) (JUST FALSE) FALSE FALSE FALSE 0 FALSE FALSE FALSE EQUALS JUST FALSE
-- (1) exempt from section 2015(d)(1) as the result of clause (B), (C), (D), (E), or (F)
#ASSERT `s 2029(b) the household member is exempt from workfare requirements` (`test: person` 30 TRUE) (JUST TRUE) FALSE FALSE FALSE 0 FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2029(b) the household member is exempt from workfare requirements` (`test: person` 30 TRUE) NOTHING FALSE FALSE FALSE 0 FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 2029(b) the household member is exempt from workfare requirements` (`test: person` 15 TRUE) NOTHING FALSE FALSE FALSE 0 FALSE FALSE FALSE EQUALS JUST TRUE
-- (2) at the option of the operating agency, subject to and currently actively and satisfactorily participating at least 20 hours a week
#ASSERT `s 2029(b) the household member is exempt from workfare requirements` (`test: person` 30 TRUE) (JUST FALSE) TRUE TRUE TRUE 20 FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2029(b) the household member is exempt from workfare requirements` (`test: person` 30 TRUE) (JUST FALSE) TRUE TRUE TRUE 19 FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2029(b) the household member is exempt from workfare requirements` (`test: person` 30 TRUE) (JUST FALSE) FALSE TRUE TRUE 20 FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2029(b) the household member is exempt from workfare requirements` (`test: person` 30 TRUE) (JUST FALSE) TRUE FALSE TRUE 20 FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2029(b) the household member is exempt from workfare requirements` (`test: person` 30 TRUE) (JUST FALSE) TRUE TRUE FALSE 20 FALSE FALSE FALSE EQUALS JUST FALSE
-- (3) mentally or physically unfit
#ASSERT `s 2029(b) the household member is exempt from workfare requirements` (`test: person` 30 FALSE) (JUST FALSE) FALSE FALSE FALSE 0 FALSE FALSE FALSE EQUALS JUST TRUE
-- (4) under sixteen years of age: 15 is, 16 is not
#ASSERT `s 2029(b) the household member is exempt from workfare requirements` (`test: person` 15 TRUE) (JUST FALSE) FALSE FALSE FALSE 0 FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2029(b) the household member is exempt from workfare requirements` (`test: person` 16 TRUE) (JUST FALSE) FALSE FALSE FALSE 0 FALSE FALSE FALSE EQUALS JUST FALSE
-- (5) sixty years of age or older: 60 is, 59 is not
#ASSERT `s 2029(b) the household member is exempt from workfare requirements` (`test: person` 60 TRUE) (JUST FALSE) FALSE FALSE FALSE 0 FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2029(b) the household member is exempt from workfare requirements` (`test: person` 59 TRUE) (JUST FALSE) FALSE FALSE FALSE 0 FALSE FALSE FALSE EQUALS JUST FALSE
-- (6) a parent or other caretaker of a child in a household in which another member is subject to the requirements of this section or is employed fulltime
#ASSERT `s 2029(b) the household member is exempt from workfare requirements` (`test: person` 30 TRUE) (JUST FALSE) FALSE FALSE FALSE 0 TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2029(b) the household member is exempt from workfare requirements` (`test: person` 30 TRUE) (JUST FALSE) FALSE FALSE FALSE 0 TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 2029(b) the household member is exempt from workfare requirements` (`test: person` 30 TRUE) (JUST FALSE) FALSE FALSE FALSE 0 TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2029(b) the household member is exempt from workfare requirements` (`test: person` 30 TRUE) (JUST FALSE) FALSE FALSE FALSE 0 FALSE TRUE TRUE EQUALS JUST FALSE

§ `Tests: 2029(c) to (f)`
-- (c) argument order: the value of the work, the allotment, hours of workfare work that week, other hours worked that week for compensation
#ASSERT `s 2029(c) the operating agency may require the work` 200 200 20 10 EQUALS NOTHING
#ASSERT `s 2029(c) the operating agency may require the work` 201 200 20 10 EQUALS JUST FALSE
-- "exceeds thirty hours a week": 30 does not exceed, 31 does
#ASSERT `s 2029(c) the operating agency may require the work` 200 200 20 10 EQUALS NOTHING
#ASSERT `s 2029(c) the operating agency may require the work` 200 200 20 11 EQUALS JUST FALSE
#ASSERT `s 2029(c) the operating agency may require the work` 100 200 30 0 EQUALS NOTHING
#ASSERT `s 2029(c) the operating agency may require the work` 100 200 31 0 EQUALS JUST FALSE
-- argument order: the other hours, the allotment, the value of an hour; the least of 30 less the other hours and allotment over hourly value
#ASSERT `s 2029(c) the most hours of workfare work the agency may require of the member that week` 10 200 10 EQUALS JUST 20
#ASSERT `s 2029(c) the most hours of workfare work the agency may require of the member that week` 0 150 10 EQUALS JUST 15
#ASSERT `s 2029(c) the most hours of workfare work the agency may require of the member that week` 40 200 10 EQUALS JUST 0
#ASSERT `s 2029(c) the most hours of workfare work the agency may require of the member that week` 0 600 10 EQUALS JUST 30
#ASSERT `s 2029(c) the most hours of workfare work the agency may require of the member that week` 0 200 0 EQUALS NOTHING
#ASSERT `s 2029(c) the most hours of workfare work the agency may require of the member that week` (0 MINUS 1) 200 10 EQUALS NOTHING
#ASSERT `s 2029(c) the most hours of workfare work the agency may require of the member that week` 0 (0 MINUS 1) 10 EQUALS NOTHING
-- (d)(1) to (3)
#ASSERT `s 2029(d)(1) the operating agency may provide the work` TRUE EQUALS JUST FALSE
#ASSERT `s 2029(d)(1) the operating agency may provide the work` FALSE EQUALS NOTHING
#ASSERT `s 2029(d)(2) the operating agency is required to provide the same benefits and working conditions that are provided at the job site` TRUE EQUALS JUST TRUE
#ASSERT `s 2029(d)(2) the operating agency is required to provide the same benefits and working conditions that are provided at the job site` FALSE EQUALS NOTHING
#ASSERT `s 2029(d)(3) the amount the operating agency is required to reimburse for the month` 10 EQUALS JUST 10
#ASSERT `s 2029(d)(3) the amount the operating agency is required to reimburse for the month` 25 EQUALS JUST 25
#ASSERT `s 2029(d)(3) the amount the operating agency is required to reimburse for the month` 26 EQUALS JUST 25
#ASSERT `s 2029(d)(3) the amount the operating agency is required to reimburse for the month` 0 EQUALS JUST 0
#ASSERT `s 2029(d)(3) the amount the operating agency is required to reimburse for the month` (0 MINUS 5) EQUALS NOTHING
-- (e) "of up to thirty days": a longer period is not addressed, which is not a no
#ASSERT `s 2029(e) the operating agency may allow a job search period of the length, prior to making workfare assignments` 30 EQUALS JUST TRUE
#ASSERT `s 2029(e) the operating agency may allow a job search period of the length, prior to making workfare assignments` 0 EQUALS JUST TRUE
#ASSERT `s 2029(e) the operating agency may allow a job search period of the length, prior to making workfare assignments` 31 EQUALS NOTHING
#ASSERT `s 2029(e) the operating agency may allow a job search period of the length, prior to making workfare assignments` (0 MINUS 1) EQUALS NOTHING
#ASSERT `s 2029(e) the last day of the longest job search period` (Date 1 3 2027) EQUALS Date 31 3 2027
-- (f)
#ASSERT `s 2029(f) the individual or household may become ineligible under section 2015(d)(1) for failing to comply with this section` TRUE EQUALS JUST TRUE
#ASSERT `s 2029(f) the individual or household may become ineligible under section 2015(d)(1) for failing to comply with this section` FALSE EQUALS NOTHING

§ `Tests: 2029(g)`
-- (1) 50 per centum of all administrative expenses
#ASSERT `s 2029(g)(1) the amount the Secretary is required to pay to the operating agency` 1000 EQUALS JUST 500
#ASSERT `s 2029(g)(1) the amount the Secretary is required to pay to the operating agency` 0 EQUALS JUST 0
#ASSERT `s 2029(g)(1) the amount the Secretary is required to pay to the operating agency` (0 MINUS 1) EQUALS NOTHING
-- (2)(B) argument order: the dollar value of the decrease in allotments, (i) while participating for the first time, the first participation has been terminated, the date it was terminated, the date the employment commences; three times the decrease
#ASSERT `s 2029(g)(2)(B) the funds saved from employment related to a workfare program` 100 TRUE FALSE (Date 1 1 2027) (Date 15 1 2027) EQUALS JUST 300
-- (ii) the thirty-day period beginning on the date of termination: 1 January to 30 January
#ASSERT `s 2029(g)(2)(B) the funds saved from employment related to a workfare program` 100 FALSE TRUE (Date 1 1 2027) (Date 1 1 2027) EQUALS JUST 300
#ASSERT `s 2029(g)(2)(B) the funds saved from employment related to a workfare program` 100 FALSE TRUE (Date 1 1 2027) (Date 30 1 2027) EQUALS JUST 300
#ASSERT `s 2029(g)(2)(B) the funds saved from employment related to a workfare program` 100 FALSE TRUE (Date 1 1 2027) (Date 31 1 2027) EQUALS JUST 0
#ASSERT `s 2029(g)(2)(B) the funds saved from employment related to a workfare program` 100 FALSE TRUE (Date 1 1 2027) (Date 31 12 2026) EQUALS JUST 0
#ASSERT `s 2029(g)(2)(B) the funds saved from employment related to a workfare program` 100 FALSE FALSE (Date 1 1 2027) (Date 15 1 2027) EQUALS JUST 0
#ASSERT `s 2029(g)(2)(B) the funds saved from employment related to a workfare program` 0 TRUE FALSE (Date 1 1 2027) (Date 15 1 2027) EQUALS JUST 0
#ASSERT `s 2029(g)(2)(B) the funds saved from employment related to a workfare program` (0 MINUS 1) TRUE FALSE (Date 1 1 2027) (Date 15 1 2027) EQUALS NOTHING
-- (2)(A) argument order: the funds saved, the administrative expenses; half the funds saved, at most the half of the expenses not reimbursed under (1)
#ASSERT `s 2029(g)(2)(A) the amount the Secretary is required to pay to the operating agency from the funds saved` 300 1000 EQUALS JUST 150
#ASSERT `s 2029(g)(2)(A) the amount the Secretary is required to pay to the operating agency from the funds saved` 2000 1000 EQUALS JUST 500
#ASSERT `s 2029(g)(2)(A) the amount the Secretary is required to pay to the operating agency from the funds saved` 1000 1000 EQUALS JUST 500
#ASSERT `s 2029(g)(2)(A) the amount the Secretary is required to pay to the operating agency from the funds saved` 0 1000 EQUALS JUST 0
#ASSERT `s 2029(g)(2)(A) the amount the Secretary is required to pay to the operating agency from the funds saved` (0 MINUS 1) 1000 EQUALS NOTHING
#ASSERT `s 2029(g)(2)(A) the amount the Secretary is required to pay to the operating agency from the funds saved` 300 (0 MINUS 1) EQUALS NOTHING
-- (3) "upon a finding"
#ASSERT `s 2029(g)(3) the Secretary may suspend or cancel some or all of the payments, or withdraw approval from the subdivision` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2029(g)(3) the Secretary may suspend or cancel some or all of the payments, or withdraw approval from the subdivision` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 2029(g)(3) the Secretary may suspend or cancel some or all of the payments, or withdraw approval from the subdivision` NOTHING EQUALS NOTHING
