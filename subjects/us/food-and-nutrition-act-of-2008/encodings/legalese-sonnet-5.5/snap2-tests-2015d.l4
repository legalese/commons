IMPORT prelude
IMPORT daydate
IMPORT `snap-core`
IMPORT `snap2-3val`
IMPORT `snap2-2015d`

-- Tests of section 2015(d)(1) to (3). Expected values are decided from the quoted words before the run.

§ `Tests: 2015(d)(1)(A)`
-- A conduct with every ground off except the ones the arguments turn on.
-- argument order: refuses to register, refuses E&T, refuses an offer, the offered hourly wage, the minimum wage, refuses information, quits, reduces work effort, hours after the reduction, fails section 2029, good cause
GIVEN reg IS A BOOLEAN, etp IS A BOOLEAN, offer IS A BOOLEAN, wage IS A NUMBER, minwage IS A NUMBER, info IS A BOOLEAN, quit IS A BOOLEAN, reduce IS A BOOLEAN, hours IS A NUMBER, s2029 IS A BOOLEAN, gc IS A MAYBE BOOLEAN
GIVETH A `s 2015(d)(1)(A) conduct`
`s 2015(d)(1)(A) test: a conduct` MEANS
    `s 2015(d)(1)(A) conduct` OF reg, etp, offer, TRUE, wage, minwage, 10, info, quit, reduce, hours, s2029, gc

-- (i) registration: no good-cause qualifier
#ASSERT `s 2015(d)(1)(A) the individual is ineligible to participate in the program` 30 TRUE (`s 2015(d)(1)(A) test: a conduct` TRUE FALSE FALSE 0 7.25 FALSE FALSE FALSE 40 FALSE NOTHING) EQUALS JUST TRUE
-- no ground: the "if" fails
#ASSERT `s 2015(d)(1)(A) the individual is ineligible to participate in the program` 30 TRUE (`s 2015(d)(1)(A) test: a conduct` FALSE FALSE FALSE 0 7.25 FALSE FALSE FALSE 40 FALSE (JUST FALSE)) EQUALS JUST FALSE
-- "over the age of 15 and under the age of 60": 15 and 60 are outside, 16 and 59 inside
#ASSERT `s 2015(d)(1)(A) the individual is ineligible to participate in the program` 15 TRUE (`s 2015(d)(1)(A) test: a conduct` TRUE FALSE FALSE 0 7.25 FALSE FALSE FALSE 40 FALSE NOTHING) EQUALS NOTHING
#ASSERT `s 2015(d)(1)(A) the individual is ineligible to participate in the program` 16 TRUE (`s 2015(d)(1)(A) test: a conduct` TRUE FALSE FALSE 0 7.25 FALSE FALSE FALSE 40 FALSE NOTHING) EQUALS JUST TRUE
#ASSERT `s 2015(d)(1)(A) the individual is ineligible to participate in the program` 59 TRUE (`s 2015(d)(1)(A) test: a conduct` TRUE FALSE FALSE 0 7.25 FALSE FALSE FALSE 40 FALSE NOTHING) EQUALS JUST TRUE
#ASSERT `s 2015(d)(1)(A) the individual is ineligible to participate in the program` 60 TRUE (`s 2015(d)(1)(A) test: a conduct` TRUE FALSE FALSE 0 7.25 FALSE FALSE FALSE 40 FALSE NOTHING) EQUALS NOTHING
-- "physically and mentally fit"
#ASSERT `s 2015(d)(1)(A) the individual is ineligible to participate in the program` 30 FALSE (`s 2015(d)(1)(A) test: a conduct` TRUE FALSE FALSE 0 7.25 FALSE FALSE FALSE 40 FALSE NOTHING) EQUALS NOTHING
-- (ii) "refuses without good cause to participate in an employment and training program"
#ASSERT `s 2015(d)(1)(A) the individual is ineligible to participate in the program` 30 TRUE (`s 2015(d)(1)(A) test: a conduct` FALSE TRUE FALSE 0 7.25 FALSE FALSE FALSE 40 FALSE (JUST FALSE)) EQUALS JUST TRUE
#ASSERT `s 2015(d)(1)(A) the individual is ineligible to participate in the program` 30 TRUE (`s 2015(d)(1)(A) test: a conduct` FALSE TRUE FALSE 0 7.25 FALSE FALSE FALSE 40 FALSE (JUST TRUE)) EQUALS JUST FALSE
#ASSERT `s 2015(d)(1)(A) the individual is ineligible to participate in the program` 30 TRUE (`s 2015(d)(1)(A) test: a conduct` FALSE TRUE FALSE 0 7.25 FALSE FALSE FALSE 40 FALSE NOTHING) EQUALS NOTHING
-- (iii) the offered wage must be "not less than the higher of" the minimum wage and 80 percent of the wage that would have governed (here 80 percent of 10 is 8)
#ASSERT `s 2015(d)(1)(A) the individual is ineligible to participate in the program` 30 TRUE (`s 2015(d)(1)(A) test: a conduct` FALSE FALSE TRUE 8 7.25 FALSE FALSE FALSE 40 FALSE (JUST FALSE)) EQUALS JUST TRUE
#ASSERT `s 2015(d)(1)(A) the individual is ineligible to participate in the program` 30 TRUE (`s 2015(d)(1)(A) test: a conduct` FALSE FALSE TRUE 7.99 7.25 FALSE FALSE FALSE 40 FALSE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT `s 2015(d)(1)(A) the individual is ineligible to participate in the program` 30 TRUE (`s 2015(d)(1)(A) test: a conduct` FALSE FALSE TRUE 9 9 FALSE FALSE FALSE 40 FALSE (JUST FALSE)) EQUALS JUST TRUE
#ASSERT `s 2015(d)(1)(A) the individual is ineligible to participate in the program` 30 TRUE (`s 2015(d)(1)(A) test: a conduct` FALSE FALSE TRUE 8.99 9 FALSE FALSE FALSE 40 FALSE (JUST FALSE)) EQUALS JUST FALSE
-- (iii) the site or plant must not be subject to a strike or lockout
#ASSERT `s 2015(d)(1)(A) the individual is ineligible to participate in the program` 30 TRUE (`s 2015(d)(1)(A) conduct` OF FALSE, FALSE, TRUE, FALSE, 8, 7.25, 10, FALSE, FALSE, FALSE, 40, FALSE, JUST FALSE) EQUALS JUST FALSE
-- (iv) information
#ASSERT `s 2015(d)(1)(A) the individual is ineligible to participate in the program` 30 TRUE (`s 2015(d)(1)(A) test: a conduct` FALSE FALSE FALSE 0 7.25 TRUE FALSE FALSE 40 FALSE (JUST FALSE)) EQUALS JUST TRUE
#ASSERT `s 2015(d)(1)(A) the individual is ineligible to participate in the program` 30 TRUE (`s 2015(d)(1)(A) test: a conduct` FALSE FALSE FALSE 0 7.25 TRUE FALSE FALSE 40 FALSE (JUST TRUE)) EQUALS JUST FALSE
-- (v)(I) quits a job; (v)(II) reduces work effort to less than 30 hours per week (29 is, 30 is not)
#ASSERT `s 2015(d)(1)(A) the individual is ineligible to participate in the program` 30 TRUE (`s 2015(d)(1)(A) test: a conduct` FALSE FALSE FALSE 0 7.25 FALSE TRUE FALSE 40 FALSE (JUST FALSE)) EQUALS JUST TRUE
#ASSERT `s 2015(d)(1)(A) the individual is ineligible to participate in the program` 30 TRUE (`s 2015(d)(1)(A) test: a conduct` FALSE FALSE FALSE 0 7.25 FALSE FALSE TRUE 29 FALSE (JUST FALSE)) EQUALS JUST TRUE
#ASSERT `s 2015(d)(1)(A) the individual is ineligible to participate in the program` 30 TRUE (`s 2015(d)(1)(A) test: a conduct` FALSE FALSE FALSE 0 7.25 FALSE FALSE TRUE 30 FALSE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT `s 2015(d)(1)(A) the individual is ineligible to participate in the program` 30 TRUE (`s 2015(d)(1)(A) test: a conduct` FALSE FALSE FALSE 0 7.25 FALSE TRUE FALSE 40 FALSE (JUST TRUE)) EQUALS JUST FALSE
-- (vi) fails to comply with section 2029: no good-cause qualifier, so an undetermined good cause does not matter
#ASSERT `s 2015(d)(1)(A) the individual is ineligible to participate in the program` 30 TRUE (`s 2015(d)(1)(A) test: a conduct` FALSE FALSE FALSE 0 7.25 FALSE FALSE FALSE 40 TRUE NOTHING) EQUALS JUST TRUE
-- one ground made out settles it even when another depends on an undetermined good cause
#ASSERT `s 2015(d)(1)(A) the individual is ineligible to participate in the program` 30 TRUE (`s 2015(d)(1)(A) test: a conduct` TRUE TRUE FALSE 0 7.25 FALSE FALSE FALSE 40 FALSE NOTHING) EQUALS JUST TRUE

§ `Tests: 2015(d)(1)(B) and (C)`
-- (B) argument order: head of household, individual ineligible under (A), State agency chose, duration in days
#ASSERT `s 2015(d)(1)(B) the longest period of household ineligibility the State agency may determine, in days` TRUE (JUST TRUE) TRUE 90 EQUALS JUST 90
#ASSERT `s 2015(d)(1)(B) the longest period of household ineligibility the State agency may determine, in days` TRUE (JUST TRUE) TRUE 180 EQUALS JUST 180
#ASSERT `s 2015(d)(1)(B) the longest period of household ineligibility the State agency may determine, in days` TRUE (JUST TRUE) TRUE 200 EQUALS JUST 180
#ASSERT `s 2015(d)(1)(B) the longest period of household ineligibility the State agency may determine, in days` FALSE (JUST TRUE) TRUE 90 EQUALS NOTHING
#ASSERT `s 2015(d)(1)(B) the longest period of household ineligibility the State agency may determine, in days` TRUE NOTHING TRUE 90 EQUALS NOTHING
#ASSERT `s 2015(d)(1)(B) the longest period of household ineligibility the State agency may determine, in days` TRUE (JUST FALSE) TRUE 90 EQUALS NOTHING
#ASSERT `s 2015(d)(1)(B) the longest period of household ineligibility the State agency may determine, in days` TRUE (JUST TRUE) FALSE 90 EQUALS NOTHING
#ASSERT `s 2015(d)(1)(B) the period the State agency determined is allowed` (JUST 90) 90 EQUALS JUST TRUE
#ASSERT `s 2015(d)(1)(B) the period the State agency determined is allowed` (JUST 90) 91 EQUALS JUST FALSE
#ASSERT `s 2015(d)(1)(B) the period the State agency determined is allowed` NOTHING 10 EQUALS NOTHING
-- (C) argument order: number of the violation, date ineligible, date eligible under (A), date the State agency determined, permanent option elected
-- first violation: the later of (I) eligibility, (II) 1 month after 15 January 2026 = 15 February, (III) the State's date no later than 3 months after (15 April)
#ASSERT `s 2015(d)(1)(C) the individual remains ineligible until` 1 (Date 15 1 2026) (JUST (Date 16 1 2026)) NOTHING FALSE EQUALS `s 2015(d)(1)(C) remains ineligible until` (Date 15 2 2026)
#ASSERT `s 2015(d)(1)(C) the individual remains ineligible until` 1 (Date 15 1 2026) (JUST (Date 1 3 2026)) NOTHING FALSE EQUALS `s 2015(d)(1)(C) remains ineligible until` (Date 1 3 2026)
#ASSERT `s 2015(d)(1)(C) the individual remains ineligible until` 1 (Date 15 1 2026) (JUST (Date 16 1 2026)) (JUST (Date 15 4 2026)) FALSE EQUALS `s 2015(d)(1)(C) remains ineligible until` (Date 15 4 2026)
#ASSERT `s 2015(d)(1)(C) the individual remains ineligible until` 1 (Date 15 1 2026) (JUST (Date 16 1 2026)) (JUST (Date 16 4 2026)) FALSE EQUALS `s 2015(d)(1)(C) not covered`
-- month arithmetic clamps: 1 month after 31 January 2026 is 28 February
#ASSERT `s 2015(d)(1)(C) the individual remains ineligible until` 1 (Date 31 1 2026) (JUST (Date 1 2 2026)) NOTHING FALSE EQUALS `s 2015(d)(1)(C) remains ineligible until` (Date 28 2 2026)
-- second violation: 3 months (15 April); the State's date no later than 6 months (15 July)
#ASSERT `s 2015(d)(1)(C) the individual remains ineligible until` 2 (Date 15 1 2026) (JUST (Date 16 1 2026)) NOTHING FALSE EQUALS `s 2015(d)(1)(C) remains ineligible until` (Date 15 4 2026)
#ASSERT `s 2015(d)(1)(C) the individual remains ineligible until` 2 (Date 15 1 2026) (JUST (Date 16 1 2026)) (JUST (Date 15 7 2026)) FALSE EQUALS `s 2015(d)(1)(C) remains ineligible until` (Date 15 7 2026)
#ASSERT `s 2015(d)(1)(C) the individual remains ineligible until` 2 (Date 15 1 2026) (JUST (Date 16 1 2026)) (JUST (Date 16 7 2026)) FALSE EQUALS `s 2015(d)(1)(C) not covered`
-- the permanent option is for the third or subsequent violation only
#ASSERT `s 2015(d)(1)(C) the individual remains ineligible until` 2 (Date 15 1 2026) (JUST (Date 16 1 2026)) NOTHING TRUE EQUALS `s 2015(d)(1)(C) remains ineligible until` (Date 15 4 2026)
-- third violation: 6 months (15 July); the State's date has no cap; permanently at the State agency's option
#ASSERT `s 2015(d)(1)(C) the individual remains ineligible until` 3 (Date 15 1 2026) (JUST (Date 16 1 2026)) NOTHING FALSE EQUALS `s 2015(d)(1)(C) remains ineligible until` (Date 15 7 2026)
#ASSERT `s 2015(d)(1)(C) the individual remains ineligible until` 3 (Date 15 1 2026) (JUST (Date 16 1 2026)) (JUST (Date 15 9 2026)) FALSE EQUALS `s 2015(d)(1)(C) remains ineligible until` (Date 15 9 2026)
#ASSERT `s 2015(d)(1)(C) the individual remains ineligible until` 3 (Date 15 1 2026) (JUST (Date 16 1 2026)) NOTHING TRUE EQUALS `s 2015(d)(1)(C) remains ineligible permanently`
#ASSERT `s 2015(d)(1)(C) the individual remains ineligible until` 4 (Date 15 1 2026) (JUST (Date 16 1 2026)) NOTHING TRUE EQUALS `s 2015(d)(1)(C) remains ineligible permanently`
-- not covered: no first violation; eligibility under (A) has not yet come
#ASSERT `s 2015(d)(1)(C) the individual remains ineligible until` 0 (Date 15 1 2026) (JUST (Date 16 1 2026)) NOTHING FALSE EQUALS `s 2015(d)(1)(C) not covered`
#ASSERT `s 2015(d)(1)(C) the individual remains ineligible until` 1 (Date 15 1 2026) NOTHING NOTHING FALSE EQUALS `s 2015(d)(1)(C) not covered`

§ `Tests: 2015(d)(1)(D)`
-- (i) and (ii): the Secretary's meaning is passed through
#ASSERT `s 2015(d)(1)(D)(i) and (ii) there is good cause, or the individual voluntarily quit or reduced work effort, as the Secretary determines` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2015(d)(1)(D)(i) and (ii) there is good cause, or the individual voluntarily quit or reduced work effort, as the Secretary determines` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2015(d)(1)(D)(i) and (ii) there is good cause, or the individual voluntarily quit or reduced work effort, as the Secretary determines` NOTHING EQUALS NOTHING
-- (iii)(I): the State agency's determination is passed through; (II): "may not use a meaning ... less restrictive"
#ASSERT `s 2015(d)(1)(D)(iii)(I) the State agency determines the meaning of a term, the procedure, or whether the individual is in compliance` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2015(d)(1)(D)(iii)(I) the State agency determines the meaning of a term, the procedure, or whether the individual is in compliance` NOTHING EQUALS NOTHING
#ASSERT `s 2015(d)(1)(D)(iii)(II) the State agency may use the meaning, procedure or determination` TRUE EQUALS JUST FALSE
#ASSERT `s 2015(d)(1)(D)(iii)(II) the State agency may use the meaning, procedure or determination` FALSE EQUALS NOTHING
-- (iv): argument order: an employee of a government, dismissed for participating in a strike against it
#ASSERT `s 2015(d)(1)(D)(iv) the individual is considered to have voluntarily quit without good cause` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2015(d)(1)(D)(iv) the individual is considered to have voluntarily quit without good cause` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2015(d)(1)(D)(iv) the individual is considered to have voluntarily quit without good cause` FALSE TRUE EQUALS NOTHING
-- (v)(I): argument order: adult parent of a child in the household, all adult applicants agree
#ASSERT `s 2015(d)(1)(D)(v)(I) the State agency must allow the household to select the person as head of the household` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2015(d)(1)(D)(v)(I) the State agency must allow the household to select the person as head of the household` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2015(d)(1)(D)(v)(I) the State agency must allow the household to select the person as head of the household` FALSE TRUE EQUALS NOTHING
-- (v)(II): argument order: being certified, within a certification period, change in composition
#ASSERT `s 2015(d)(1)(D)(v)(II) the household is barred from changing the designation of the head` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2015(d)(1)(D)(v)(II) the household is barred from changing the designation of the head` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2015(d)(1)(D)(v)(II) the household is barred from changing the designation of the head` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2015(d)(1)(D)(v)(II) the household is barred from changing the designation of the head` FALSE FALSE FALSE EQUALS NOTHING
-- (vi): argument order: the head leaves during the (B) period, otherwise eligible / becomes head of another household
#ASSERT `s 2015(d)(1)(D)(vi)(I) the household becomes eligible when the head leaves` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2015(d)(1)(D)(vi)(I) the household becomes eligible when the head leaves` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2015(d)(1)(D)(vi)(I) the household becomes eligible when the head leaves` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2015(d)(1)(D)(vi)(II) the household the former head now heads is ineligible for the remaining period` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2015(d)(1)(D)(vi)(II) the household the former head now heads is ineligible for the remaining period` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2015(d)(1)(D)(vi)(II) the household the former head now heads is ineligible for the remaining period` FALSE TRUE EQUALS NOTHING

§ `Tests: 2015(d)(2)`
-- (A) "currently subject to and complying with a work registration requirement"
#ASSERT `s 2015(d)(2)(A) the person is exempt because subject to and complying with another work registration requirement` TRUE EQUALS JUST TRUE
#ASSERT `s 2015(d)(2)(A) the person is exempt because subject to and complying with another work registration requirement` FALSE EQUALS JUST FALSE
#ASSERT `s 2015(d)(2)(A) the failure is the same as failure to comply with paragraph (1)` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 2015(d)(2)(A) the failure is the same as failure to comply with paragraph (1)` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 2015(d)(2)(A) the failure is the same as failure to comply with paragraph (1)` (JUST TRUE) FALSE EQUALS NOTHING
-- (B) argument order: parent or other member responsible for a dependent child, the child's age, the age limit, responsible for an incapacitated person; "under age six"
#ASSERT `s 2015(d)(2)(B) the person is exempt because of responsibility for the care of a dependent child or an incapacitated person` TRUE 5 6 FALSE EQUALS JUST TRUE
#ASSERT `s 2015(d)(2)(B) the person is exempt because of responsibility for the care of a dependent child or an incapacitated person` TRUE 6 6 FALSE EQUALS JUST FALSE
#ASSERT `s 2015(d)(2)(B) the person is exempt because of responsibility for the care of a dependent child or an incapacitated person` TRUE 6 6 TRUE EQUALS JUST TRUE
#ASSERT `s 2015(d)(2)(B) the person is exempt because of responsibility for the care of a dependent child or an incapacitated person` FALSE 2 6 FALSE EQUALS JUST FALSE
#ASSERT `s 2015(d)(2)(B) the person is exempt because of responsibility for the care of a dependent child or an incapacitated person` TRUE 3 3 FALSE EQUALS JUST FALSE
#ASSERT `s 2015(d)(2)(B) the person is exempt because of responsibility for the care of a dependent child or an incapacitated person` TRUE 2 3 FALSE EQUALS JUST TRUE
-- the State's lowering of the age: argument order: waiver requested and denied as of 1 August 1996, years, the age
#ASSERT `s 2015(d)(2) the State may lower the age of the dependent child` TRUE 3 3 EQUALS JUST TRUE
#ASSERT `s 2015(d)(2) the State may lower the age of the dependent child` TRUE 4 3 EQUALS JUST FALSE
#ASSERT `s 2015(d)(2) the State may lower the age of the dependent child` TRUE 3 1 EQUALS JUST TRUE
#ASSERT `s 2015(d)(2) the State may lower the age of the dependent child` TRUE 3 0.5 EQUALS JUST FALSE
#ASSERT `s 2015(d)(2) the State may lower the age of the dependent child` TRUE 3 5 EQUALS JUST TRUE
#ASSERT `s 2015(d)(2) the State may lower the age of the dependent child` TRUE 3 6 EQUALS JUST FALSE
#ASSERT `s 2015(d)(2) the State may lower the age of the dependent child` FALSE 3 3 EQUALS NOTHING
-- (C) argument order: bona fide student at least half time, in higher education, meets subsection (e)
#ASSERT `s 2015(d)(2)(C) the person is exempt because a bona fide student enrolled at least half time` TRUE FALSE NOTHING EQUALS JUST TRUE
#ASSERT `s 2015(d)(2)(C) the person is exempt because a bona fide student enrolled at least half time` TRUE TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2015(d)(2)(C) the person is exempt because a bona fide student enrolled at least half time` TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2015(d)(2)(C) the person is exempt because a bona fide student enrolled at least half time` TRUE TRUE NOTHING EQUALS NOTHING
#ASSERT `s 2015(d)(2)(C) the person is exempt because a bona fide student enrolled at least half time` FALSE FALSE (JUST TRUE) EQUALS JUST FALSE
-- (D) argument order: regular participant, the program is a treatment and rehabilitation program (s 2012(h))
#ASSERT `s 2015(d)(2)(D) the person is exempt because a regular participant in a treatment and rehabilitation program` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2015(d)(2)(D) the person is exempt because a regular participant in a treatment and rehabilitation program` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2015(d)(2)(D) the person is exempt because a regular participant in a treatment and rehabilitation program` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 2015(d)(2)(D) the person is exempt because a regular participant in a treatment and rehabilitation program` FALSE (JUST TRUE) EQUALS JUST FALSE
-- (E) argument order: hours per week, weekly earnings, the minimum hourly rate; thirty hours, or earnings equal to the rate times thirty (7.25 times 30 is 217.50)
#ASSERT `s 2015(d)(2)(E) the person is exempt because employed or earning at the minimum rate for thirty hours` 30 0 7.25 EQUALS JUST TRUE
#ASSERT `s 2015(d)(2)(E) the person is exempt because employed or earning at the minimum rate for thirty hours` 29 217.5 7.25 EQUALS JUST TRUE
#ASSERT `s 2015(d)(2)(E) the person is exempt because employed or earning at the minimum rate for thirty hours` 29 217.49 7.25 EQUALS JUST FALSE
-- (F) argument order: age, head of a household, attending school or in an employment training program at least half time; "between the ages of sixteen and eighteen"
#ASSERT `s 2015(d)(2)(F) the person is exempt because a person between sixteen and eighteen` 16 FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2015(d)(2)(F) the person is exempt because a person between sixteen and eighteen` 18 FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2015(d)(2)(F) the person is exempt because a person between sixteen and eighteen` 15 FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2015(d)(2)(F) the person is exempt because a person between sixteen and eighteen` 19 FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2015(d)(2)(F) the person is exempt because a person between sixteen and eighteen` 17 TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2015(d)(2)(F) the person is exempt because a person between sixteen and eighteen` 17 TRUE TRUE EQUALS JUST TRUE
-- the six limbs together
#ASSERT `s 2015(d)(2) the person is exempt from the requirements of paragraph (1)` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2015(d)(2) the person is exempt from the requirements of paragraph (1)` (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 2015(d)(2) the person is exempt from the requirements of paragraph (1)` (JUST FALSE) NOTHING (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 2015(d)(2)(B) to (F) the person is exempt from section 2015(d)(1) as the result of clause (B), (C), (D), (E), or (F)` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2015(d)(2)(B) to (F) the person is exempt from section 2015(d)(1) as the result of clause (B), (C), (D), (E), or (F)` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE

§ `Tests: 2015(d)(3)`
-- argument order: a non-exempt member is on strike, eligible immediately prior, the household has no striking member and a member refuses employment because of a strike or lockout
#ASSERT `s 2015(d)(3) the household shall not participate while the member is on strike` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2015(d)(3) the household shall not participate while the member is on strike` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2015(d)(3) the household shall not participate while the member is on strike` TRUE FALSE TRUE EQUALS JUST FALSE
-- the second proviso: no member on strike, and a member refuses a job at a plant or site because of a strike or lockout, so "such ineligibility shall not apply" (found by the independent review, item 218)
#ASSERT `s 2015(d)(3) the household shall not participate while the member is on strike` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2015(d)(3) the household shall not participate while the member is on strike` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2015(d)(3) the household shall not participate while the member is on strike` FALSE FALSE FALSE EQUALS NOTHING
-- argument order: eligible immediately prior, a member is striking, the increase results from the decrease in the striking member's income
#ASSERT `s 2015(d)(3) the household may receive an increased allotment as the result of a decrease in the income of the striking member` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2015(d)(3) the household may receive an increased allotment as the result of a decrease in the income of the striking member` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 2015(d)(3) the household may receive an increased allotment as the result of a decrease in the income of the striking member` TRUE TRUE FALSE EQUALS NOTHING

§ `Touching every constructor and field declared in snap2-2015d`
#ASSERT (`s 2015(d)(1)(A) test: a conduct` TRUE FALSE FALSE 0 7.25 FALSE FALSE FALSE 40 FALSE NOTHING)'s `refuses to register for employment at the time of application and every 12 months thereafter` EQUALS TRUE
#ASSERT (`s 2015(d)(1)(A) test: a conduct` TRUE FALSE FALSE 0 7.25 FALSE FALSE FALSE 40 FALSE NOTHING)'s `there was good cause` EQUALS NOTHING
#ASSERT `s 2015(d)(1)(C) remains ineligible permanently` EQUALS `s 2015(d)(1)(C) remains ineligible permanently`
