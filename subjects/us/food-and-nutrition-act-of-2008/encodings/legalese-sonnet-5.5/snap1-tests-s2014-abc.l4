IMPORT prelude
IMPORT daydate
IMPORT `snap-core`
IMPORT `snap1-logic`
IMPORT `snap1-s2014-abc`

-- Tests for 7 U.S.C. 2014(a), (b), (c). Every expected value is written from the text (or from the USDA's FY 2027 page for the
-- figures) before the code was run. A branch answered JUST FALSE is a FALSE-kind branch; a branch answered NOTHING is a NOTHING-kind branch.

§ `s 2014(a) tests`

-- First sentence: "limited to those households whose incomes and other financial resources ... are determined to be a substantial limiting factor".
#ASSERT `s 2014(a) the household may participate in the program` FALSE EQUALS JUST FALSE
#ASSERT `s 2014(a) the household may participate in the program` TRUE EQUALS NOTHING

-- Second sentence: a listed benefit (TANF, SSI, aid to the aged, blind, or disabled), each member.
`s 2014(a) test member with TANF` MEANS `s 2014(a) member` WITH
    `receives benefits under a State program funded under part A of title IV of the Social Security Act` IS TRUE
    `receives supplemental security income benefits under title XVI of the Social Security Act` IS FALSE
    `receives aid to the aged, blind, or disabled under title I, X, XIV, or XVI of the Social Security Act` IS FALSE
`s 2014(a) test member with SSI` MEANS `s 2014(a) member` WITH
    `receives benefits under a State program funded under part A of title IV of the Social Security Act` IS FALSE
    `receives supplemental security income benefits under title XVI of the Social Security Act` IS TRUE
    `receives aid to the aged, blind, or disabled under title I, X, XIV, or XVI of the Social Security Act` IS FALSE
`s 2014(a) test member with aid` MEANS `s 2014(a) member` WITH
    `receives benefits under a State program funded under part A of title IV of the Social Security Act` IS FALSE
    `receives supplemental security income benefits under title XVI of the Social Security Act` IS FALSE
    `receives aid to the aged, blind, or disabled under title I, X, XIV, or XVI of the Social Security Act` IS TRUE
`s 2014(a) test member with nothing` MEANS `s 2014(a) member` WITH
    `receives benefits under a State program funded under part A of title IV of the Social Security Act` IS FALSE
    `receives supplemental security income benefits under title XVI of the Social Security Act` IS FALSE
    `receives aid to the aged, blind, or disabled under title I, X, XIV, or XVI of the Social Security Act` IS FALSE

#ASSERT `s 2014(a) the member receives one of the listed benefits` `s 2014(a) test member with TANF`
#ASSERT `s 2014(a) the member receives one of the listed benefits` `s 2014(a) test member with SSI`
#ASSERT `s 2014(a) the member receives one of the listed benefits` `s 2014(a) test member with aid`
#ASSERT NOT (`s 2014(a) the member receives one of the listed benefits` `s 2014(a) test member with nothing`)
#ASSERT `s 2014(a) each member of the household receives one of the listed benefits` (LIST `s 2014(a) test member with TANF`, `s 2014(a) test member with SSI`)
#ASSERT NOT (`s 2014(a) each member of the household receives one of the listed benefits` (LIST `s 2014(a) test member with TANF`, `s 2014(a) test member with nothing`))
-- a household with no member is not "a household in which each member receives" a benefit
#ASSERT NOT (`s 2014(a) each member of the household receives one of the listed benefits` EMPTY)

-- all five exceptions answered "does not apply": JUST TRUE. The (m)(4) answer NOTHING means paragraph (4) does not bar them.
#ASSERT `s 2014(a) the household is eligible because each member receives a listed benefit` TRUE (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2014(a) the household is eligible because each member receives a listed benefit` TRUE (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) NOTHING EQUALS JUST TRUE
-- not every member receives a listed benefit: the sentence does not reach the household
#ASSERT `s 2014(a) the household is eligible because each member receives a listed benefit` FALSE (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS NOTHING
-- each excepted provision applies: JUST FALSE ("Notwithstanding ... except ..." / "Except for ..."; the sentence does not make the household eligible, marginal reading (a))
#ASSERT `s 2014(a) the household is eligible because each member receives a listed benefit` TRUE (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 2014(a) the household is eligible because each member receives a listed benefit` TRUE (JUST FALSE) (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 2014(a) the household is eligible because each member receives a listed benefit` TRUE (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 2014(a) the household is eligible because each member receives a listed benefit` TRUE (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 2014(a) the household is eligible because each member receives a listed benefit` TRUE (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
-- an exception's answer not supplied: not covered
#ASSERT `s 2014(a) the household is eligible because each member receives a listed benefit` TRUE NOTHING (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS NOTHING
-- one exception unknown, another known to apply: the known one decides, JUST FALSE
#ASSERT `s 2014(a) the household is eligible because each member receives a listed benefit` TRUE NOTHING (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE

-- Third sentence: general assistance, comparable income criteria, not one-time emergency payments.
#ASSERT `s 2014(a) the household is eligible because each member receives general assistance` TRUE TRUE TRUE (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2014(a) the household is eligible because each member receives general assistance` FALSE TRUE TRUE (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 2014(a) the household is eligible because each member receives general assistance` TRUE FALSE TRUE (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 2014(a) the household is eligible because each member receives general assistance` TRUE TRUE FALSE (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS NOTHING
-- an excepted provision applies (section 2015, section 2025(e)(1), or section 2012(m)(4) says the group is not a household): JUST FALSE, as above
#ASSERT `s 2014(a) the household is eligible because each member receives general assistance` TRUE TRUE TRUE (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 2014(a) the household is eligible because each member receives general assistance` TRUE TRUE TRUE (JUST FALSE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 2014(a) the household is eligible because each member receives general assistance` TRUE TRUE TRUE (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2014(a) the household is eligible because each member receives general assistance` TRUE TRUE TRUE NOTHING (JUST FALSE) (JUST TRUE) EQUALS NOTHING

-- Fourth sentence: "shall be furnished to all eligible households who make application".
#ASSERT `s 2014(a) assistance must be furnished to the household` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2014(a) assistance must be furnished to the household` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2014(a) assistance must be furnished to the household` FALSE TRUE EQUALS NOTHING

§ `s 2014(b) tests`

#ASSERT `s 2014(b) a standard of eligibility may differ from place to place` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2014(b) a standard of eligibility may differ from place to place` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2014(b) a standard of eligibility may differ from place to place` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2014(b) the plan of operation may be approved` FALSE EQUALS JUST FALSE
#ASSERT `s 2014(b) the plan of operation may be approved` TRUE EQUALS NOTHING
#ASSERT `s 2014(b) the State agency may impose the standard` TRUE EQUALS JUST FALSE
#ASSERT `s 2014(b) the State agency may impose the standard` FALSE EQUALS NOTHING

§ `s 2014(c) tests`

-- helper for the finding above (not a rule of the Act): the published gross limit against 1.3 times the whole-dollar poverty line
GIVEN n IS A NUMBER
GIVETH A BOOLEAN
`s 2014(c) test: Table 2 is within a dollar of 130 percent of the poverty line for the size` MEANS
    CONSIDER `s 2014(c)(1) the poverty line for the household` 2027 `the 48 contiguous States and the District of Columbia` n
        WHEN NOTHING THEN FALSE
        WHEN JUST p THEN
            CONSIDER `s 2014(c)(2) the gross monthly income limit for the household` 2027 `the 48 contiguous States and the District of Columbia` n
                WHEN NOTHING THEN FALSE
                WHEN JUST u THEN ((p TIMES 1.3) MINUS u) LESS THAN 1 AND (u MINUS (p TIMES 1.3)) LESS THAN 1


-- The FY 2027 poverty line (USDA Table 1, lines 22-30 of the COLA page): 48 States, Alaska, Hawaii, Guam, the Virgin Islands.
#ASSERT `s 2014(c)(1) the poverty line for the household` 2027 `the 48 contiguous States and the District of Columbia` 1 EQUALS JUST 1330
#ASSERT `s 2014(c)(1) the poverty line for the household` 2027 `the 48 contiguous States and the District of Columbia` 4 EQUALS JUST 2750
#ASSERT `s 2014(c)(1) the poverty line for the household` 2027 `the 48 contiguous States and the District of Columbia` 8 EQUALS JUST 4644
-- a household of 9 or more: the 8-person figure plus the USDA's "Each Additional Member" ($474 in the 48 States)
#ASSERT `s 2014(c)(1) the poverty line for the household` 2027 `the 48 contiguous States and the District of Columbia` 9 EQUALS JUST 5118
#ASSERT `s 2014(c)(1) the poverty line for the household` 2027 `the 48 contiguous States and the District of Columbia` 10 EQUALS JUST 5592
#ASSERT `s 2014(c)(1) the poverty line for the household` 2027 `Alaska, urban` 1 EQUALS JUST 1663
#ASSERT `s 2014(c)(1) the poverty line for the household` 2027 `Alaska, rural 1` 4 EQUALS JUST 3438
#ASSERT `s 2014(c)(1) the poverty line for the household` 2027 `Alaska, rural 2` 8 EQUALS JUST 5805
#ASSERT `s 2014(c)(1) the poverty line for the household` 2027 Hawaii 3 EQUALS JUST 2619
#ASSERT `s 2014(c)(1) the poverty line for the household` 2027 Guam 2 EQUALS JUST 1804
#ASSERT `s 2014(c)(1) the poverty line for the household` 2027 `the Virgin Islands of the United States` 5 EQUALS JUST 3224
-- no member, or a fiscal year whose figures were not supplied: not covered
#ASSERT `s 2014(c)(1) the poverty line for the household` 2027 Hawaii 0 EQUALS NOTHING
#ASSERT `s 2014(c)(1) the poverty line for the household` 2026 Hawaii 3 EQUALS NOTHING

-- The gross monthly income limit is the USDA's published Table 2 (lines 34-43 of the COLA page), copied by hand from the page, not computed.
-- 48 States, DC, Guam and the Virgin Islands share a column; Alaska has one column for all three of the core's areas.
#ASSERT `s 2014(c)(2) the gross monthly income limit for the household` 2027 `the 48 contiguous States and the District of Columbia` 1 EQUALS JUST 1729
#ASSERT `s 2014(c)(2) the gross monthly income limit for the household` 2027 `the 48 contiguous States and the District of Columbia` 2 EQUALS JUST 2345
#ASSERT `s 2014(c)(2) the gross monthly income limit for the household` 2027 `the 48 contiguous States and the District of Columbia` 3 EQUALS JUST 2960
#ASSERT `s 2014(c)(2) the gross monthly income limit for the household` 2027 `the 48 contiguous States and the District of Columbia` 4 EQUALS JUST 3575
#ASSERT `s 2014(c)(2) the gross monthly income limit for the household` 2027 `the 48 contiguous States and the District of Columbia` 5 EQUALS JUST 4191
#ASSERT `s 2014(c)(2) the gross monthly income limit for the household` 2027 `the 48 contiguous States and the District of Columbia` 8 EQUALS JUST 6037
-- a household of 9 or more: the 8-person figure plus "Each Additional Member" ($616 in the 48 States), as the USDA states it
#ASSERT `s 2014(c)(2) the gross monthly income limit for the household` 2027 `the 48 contiguous States and the District of Columbia` 9 EQUALS JUST 6653
#ASSERT `s 2014(c)(2) the gross monthly income limit for the household` 2027 `the 48 contiguous States and the District of Columbia` 10 EQUALS JUST 7269
#ASSERT `s 2014(c)(2) the gross monthly income limit for the household` 2027 Guam 3 EQUALS JUST 2960
#ASSERT `s 2014(c)(2) the gross monthly income limit for the household` 2027 `the Virgin Islands of the United States` 5 EQUALS JUST 4191
#ASSERT `s 2014(c)(2) the gross monthly income limit for the household` 2027 `Alaska, urban` 1 EQUALS JUST 2162
#ASSERT `s 2014(c)(2) the gross monthly income limit for the household` 2027 `Alaska, rural 1` 5 EQUALS JUST 5238
#ASSERT `s 2014(c)(2) the gross monthly income limit for the household` 2027 `Alaska, rural 2` 8 EQUALS JUST 7546
#ASSERT `s 2014(c)(2) the gross monthly income limit for the household` 2027 `Alaska, urban` 9 EQUALS JUST 8316
#ASSERT `s 2014(c)(2) the gross monthly income limit for the household` 2027 Hawaii 1 EQUALS JUST 1989
#ASSERT `s 2014(c)(2) the gross monthly income limit for the household` 2027 Hawaii 5 EQUALS JUST 4819
#ASSERT `s 2014(c)(2) the gross monthly income limit for the household` 2027 Hawaii 8 EQUALS JUST 6941
#ASSERT `s 2014(c)(2) the gross monthly income limit for the household` 2027 Hawaii 9 EQUALS JUST 7649
-- no member, or a fiscal year whose figures were not supplied: not covered
#ASSERT `s 2014(c)(2) the gross monthly income limit for the household` 2027 Hawaii 0 EQUALS NOTHING
#ASSERT `s 2014(c)(2) the gross monthly income limit for the household` 2026 Hawaii 3 EQUALS NOTHING
-- 1.3 x 1804 = 2345.2 and 1.3 x 1663 = 2161.9: the page prints $2,345 and $2,162 (finding F-T1); the published figures are the limits
#ASSERT `s 2014(c) the figure in the table for the household` `s 2014(c)(2) Table 2 gross monthly income limit, FY 2027` `s 2014(c)(2) Table 2 gross monthly income limit, FY 2027, each additional member` `the 48 contiguous States and the District of Columbia` 2 EQUALS JUST 2345
#ASSERT `s 2014(c) the figure in the table for the household` `s 2014(c)(2) Table 2 gross monthly income limit, FY 2027` `s 2014(c)(2) Table 2 gross monthly income limit, FY 2027, each additional member` Hawaii 8 EQUALS JUST 6941
#ASSERT `s 2014(c) the figure in the table for the household` `s 2014(c)(2) Table 2 gross monthly income limit, FY 2027` `s 2014(c)(2) Table 2 gross monthly income limit, FY 2027, each additional member` `Alaska, urban` 9 EQUALS JUST 8316
#ASSERT all `s 2014(c) test: Table 2 is within a dollar of 130 percent of the poverty line for the size` (LIST 1, 2, 3, 4, 5, 6, 7, 8)

-- The USDA's Table 3 (165 percent, lines 46-54): the standard of the keel's s 2012(m)(3).
#ASSERT `s 2014(c) the USDA's Table 3 limit for the household` 2027 `the 48 contiguous States and the District of Columbia` 1 EQUALS JUST 2195
#ASSERT `s 2014(c) the USDA's Table 3 limit for the household` 2027 `Alaska, rural 2` 8 EQUALS JUST 9577
#ASSERT `s 2014(c) the USDA's Table 3 limit for the household` 2027 Hawaii 9 EQUALS JUST 9708
#ASSERT `s 2014(c) the USDA's Table 3 limit for the household` 2026 Hawaii 9 EQUALS NOTHING

-- (c)(1): "exceeds the poverty line". Exactly at the line is not "exceeds".
#ASSERT `s 2014(c)(1) the household is ineligible because its net income exceeds the poverty line` 2750 2750 EQUALS JUST FALSE
#ASSERT `s 2014(c)(1) the household is ineligible because its net income exceeds the poverty line` 2750.01 2750 EQUALS JUST TRUE
#ASSERT `s 2014(c)(1) the household is ineligible because its net income exceeds the poverty line` 0 2750 EQUALS JUST FALSE

-- (c)(2): "in the case of a household that does not include an elderly or disabled member ... by more than 30 per centum".
-- 130 percent of 2750 is 3575. Exactly 3575 is not "more than 30 per centum".
#ASSERT `s 2014(c)(2) the household is ineligible because its gross income exceeds the poverty line by more than 30 per centum` (JUST FALSE) 3575 2750 EQUALS JUST FALSE
#ASSERT `s 2014(c)(2) the household is ineligible because its gross income exceeds the poverty line by more than 30 per centum` (JUST FALSE) 3575.01 2750 EQUALS JUST TRUE
-- a household that includes an elderly or disabled member fails the "if" clause "(2) in the case of a household that does not include an elderly or disabled member", whatever its income: JUST FALSE (marginal reading (a))
#ASSERT `s 2014(c)(2) the household is ineligible because its gross income exceeds the poverty line by more than 30 per centum` (JUST TRUE) 9999 2750 EQUALS JUST FALSE
#ASSERT `s 2014(c)(2) the household is ineligible because its gross income exceeds the poverty line by more than 30 per centum` (JUST TRUE) 0 2750 EQUALS JUST FALSE
-- whether the household includes such a member not supplied: over the limit it is not known; at or under the limit the clause fails either way
#ASSERT `s 2014(c)(2) the household is ineligible because its gross income exceeds the poverty line by more than 30 per centum` NOTHING 3575.01 2750 EQUALS NOTHING
#ASSERT `s 2014(c)(2) the household is ineligible because its gross income exceeds the poverty line by more than 30 per centum` NOTHING 3575 2750 EQUALS JUST FALSE

-- (c)(2) against the limit in dollars (the published Table 2 figure): exactly at the limit is not "more than 30 per centum" over the line.
-- Alaska urban, a household of 1: Table 2 prints $2,162 (130 percent of $1,663 is 2161.9, which would make 2162 ineligible).
#ASSERT `s 2014(c)(2) the household is ineligible because its gross income exceeds the gross monthly income limit` (JUST FALSE) 2162 2162 EQUALS JUST FALSE
#ASSERT `s 2014(c)(2) the household is ineligible because its gross income exceeds the gross monthly income limit` (JUST FALSE) 2162.01 2162 EQUALS JUST TRUE
#ASSERT `s 2014(c)(2) the household is ineligible because its gross income exceeds the gross monthly income limit` (JUST FALSE) 0 2162 EQUALS JUST FALSE
#ASSERT `s 2014(c)(2) the household is ineligible because its gross income exceeds the gross monthly income limit` (JUST TRUE) 9999 2162 EQUALS JUST FALSE
#ASSERT `s 2014(c)(2) the household is ineligible because its gross income exceeds the gross monthly income limit` NOTHING 2162.01 2162 EQUALS NOTHING
#ASSERT `s 2014(c)(2) the household is ineligible because its gross income exceeds the gross monthly income limit` NOTHING 2162 2162 EQUALS JUST FALSE

-- The two tests together (reading R1 of F-C1: either test makes the household ineligible).
#ASSERT `s 2014(c) the household is ineligible on income` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 2014(c) the household is ineligible on income` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2014(c) the household is ineligible on income` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2014(c) the household is ineligible on income` (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 2014(c) the household is ineligible on income` NOTHING (JUST TRUE) EQUALS JUST TRUE

-- "In no event shall the standards ... for the Virgin Islands ... or Guam exceed those in the forty-eight contiguous States."
#ASSERT `s 2014(c) the standard of eligibility for Guam or the Virgin Islands after the cap` 1900 1800 EQUALS 1800
#ASSERT `s 2014(c) the standard of eligibility for Guam or the Virgin Islands after the cap` 1700 1800 EQUALS 1700
#ASSERT `s 2014(c) the standard of eligibility for Guam or the Virgin Islands after the cap` 1800 1800 EQUALS 1800

-- "adjusted each October 1"
#ASSERT `s 2014(c) the standards are adjusted on the date` (Date 1 10 2026) EQUALS JUST TRUE
#ASSERT `s 2014(c) the standards are adjusted on the date` (Date 2 10 2026) EQUALS NOTHING
#ASSERT `s 2014(c) the standards are adjusted on the date` (Date 1 11 2026) EQUALS NOTHING
