IMPORT prelude
IMPORT `snap-core`
IMPORT `snap6-s2035`

-- TESTS for snap6-s2035.l4 (section 2035, Simplified supplemental nutrition assistance program).
-- Every expected value is written here from the text quoted above the assertion, before the module was run.
-- JUST FALSE = "the text says no in its own words"; NOTHING = "not covered"; JUST TRUE = "the text says yes".

§ `Tests of section 2035`

§§ `(a) "Federal costs" defined`
-- src:3059 | In this section, the term “Federal costs” does not include any Federal costs incurred under section 2026 of this title.
#ASSERT `s 2035(a) the cost is a Federal cost for this section` TRUE EQUALS JUST FALSE
#ASSERT `s 2035(a) the cost is a Federal cost for this section` FALSE EQUALS NOTHING

§§ `(b) Election`
-- src:3061 | Subject to subsection (d), a State may elect to carry out a simplified supplemental nutrition assistance program (referred to in this section as a “Program”), statewide or in a political subdivision of the State, in accordance with this section.
#ASSERT `s 2035(b) the State may elect to carry out a Program there` `s 2035 statewide` EQUALS JUST TRUE
#ASSERT `s 2035(b) the State may elect to carry out a Program there` `s 2035 in a political subdivision of the State` EQUALS JUST TRUE
#ASSERT `s 2035(b) the State may elect to carry out a Program there` `s 2035 somewhere else` EQUALS NOTHING

§§ `(c)(1) no member on a TANF-funded program`
-- src:3064 | (1) a household in which no members receive assistance under a State program funded under part A of title IV of the Social Security Act (42 U.S.C. 601 et seq.) may not participate in the Program;
-- a household of 3 with 0 members receiving assistance: "may not participate".
#ASSERT `s 2035(c)(1) the household may participate in the Program` 3 0 EQUALS JUST FALSE
-- one member receives: (c)(1) does not speak to it.
#ASSERT `s 2035(c)(1) the household may participate in the Program` 3 1 EQUALS NOTHING
-- no members at all is not a household; more recipients than members is inconsistent.
#ASSERT `s 2035(c)(1) the household may participate in the Program` 0 0 EQUALS NOTHING
#ASSERT `s 2035(c)(1) the household may participate in the Program` 3 4 EQUALS NOTHING

§§ `(c)(2) all members on a TANF-funded program`
-- src:3065 | (2) a household in which all members receive assistance under a State program funded under part A of title IV of the Social Security Act (42 U.S.C. 601 et seq.) shall automatically be eligible to participate in the Program;
#ASSERT `s 2035(c)(2) the household is eligible to participate in the Program` 3 3 EQUALS JUST TRUE
#ASSERT `s 2035(c)(2) the household is eligible to participate in the Program` 1 1 EQUALS JUST TRUE
#ASSERT `s 2035(c)(2) the household is eligible to participate in the Program` 3 2 EQUALS NOTHING
#ASSERT `s 2035(c)(2) the household is eligible to participate in the Program` 0 0 EQUALS NOTHING

§§ `(c)(3) some but not all members on a TANF-funded program`
-- src:3066 | (3) if approved by the Secretary, a household in which 1 or more members but not all members receive assistance under a State program funded under part A of title IV of the Social Security Act (42 U.S.C. 601 et seq.) may be eligible to participate in the Program; and
-- 1 of 3, approved by the Secretary: "may be eligible".
#ASSERT `s 2035(c)(3) the household may be eligible to participate in the Program` 3 1 (JUST TRUE) EQUALS JUST TRUE
-- 2 of 3, the Secretary has not approved ("if approved by the Secretary" fails).
#ASSERT `s 2035(c)(3) the household may be eligible to participate in the Program` 3 2 (JUST FALSE) EQUALS JUST FALSE
-- no approval information supplied: not covered.
#ASSERT `s 2035(c)(3) the household may be eligible to participate in the Program` 3 1 NOTHING EQUALS NOTHING
-- not the mixed case: (c)(3) says nothing, whatever the approval.
#ASSERT `s 2035(c)(3) the household may be eligible to participate in the Program` 3 0 (JUST TRUE) EQUALS NOTHING
#ASSERT `s 2035(c)(3) the household may be eligible to participate in the Program` 3 3 (JUST TRUE) EQUALS NOTHING

§§ `(c) as a whole`
-- src:3062 | (c) Operation of Program
-- src:3063 | If a State elects to carry out a Program, within the State or a political subdivision of the State—
-- src:3064 | (1) a household in which no members receive assistance under a State program funded under part A of title IV of the Social Security Act (42 U.S.C. 601 et seq.) may not participate in the Program;
-- src:3065 | (2) a household in which all members receive assistance under a State program funded under part A of title IV of the Social Security Act (42 U.S.C. 601 et seq.) shall automatically be eligible to participate in the Program;
-- src:3066 | (3) if approved by the Secretary, a household in which 1 or more members but not all members receive assistance under a State program funded under part A of title IV of the Social Security Act (42 U.S.C. 601 et seq.) may be eligible to participate in the Program; and
#ASSERT `s 2035(c) the household may participate in the Program` 3 0 NOTHING EQUALS JUST FALSE
#ASSERT `s 2035(c) the household may participate in the Program` 3 3 (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 2035(c) the household may participate in the Program` 3 1 (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2035(c) the household may participate in the Program` 3 1 (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2035(c) the household may participate in the Program` 3 1 NOTHING EQUALS NOTHING
#ASSERT `s 2035(c) the household may participate in the Program` 0 0 (JUST TRUE) EQUALS NOTHING
#ASSERT `s 2035(c) the household may participate in the Program` 2 5 (JUST TRUE) EQUALS NOTHING

§§ `(c)(4) sources of the benefit rules`
-- src:3067 | (4) subject to subsection (f), benefits under the Program shall be determined under rules and procedures established by the State under—
-- src:3068 | (A) a State program funded under part A of title IV of the Social Security Act (42 U.S.C. 601 et seq.);
-- src:3069 | (B) the supplemental nutrition assistance program; or
-- src:3070 | (C) a combination of a State program funded under part A of title IV of the Social Security Act (42 U.S.C. 601 et seq.) and the supplemental nutrition assistance program.
#ASSERT `s 2035(c)(4) benefits under the Program may be determined under rules from this source` `s 2035 a State program funded under part A of title IV of the Social Security Act` EQUALS JUST TRUE
#ASSERT `s 2035(c)(4) benefits under the Program may be determined under rules from this source` `s 2035 the supplemental nutrition assistance program` EQUALS JUST TRUE
#ASSERT `s 2035(c)(4) benefits under the Program may be determined under rules from this source` `s 2035 a combination of the State TANF-funded program and the supplemental nutrition assistance program` EQUALS JUST TRUE
#ASSERT `s 2035(c)(4) benefits under the Program may be determined under rules from this source` `s 2035 some other source` EQUALS NOTHING

§§ `(d)(1) State plan`
-- src:3073 | A State agency may not operate a Program unless the Secretary approves a State plan for the operation of the Program under paragraph (2).
#ASSERT `s 2035(d)(1) the State agency may operate a Program` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2035(d)(1) the State agency may operate a Program` (JUST TRUE) EQUALS NOTHING
#ASSERT `s 2035(d)(1) the State agency may operate a Program` NOTHING EQUALS NOTHING

§§ `(d)(2) Approval of plan`
-- src:3075 | The Secretary shall approve any State plan to carry out a Program if the Secretary determines that the plan—
-- src:3076 | (A) complies with this section; and
-- src:3077 | (B) contains sufficient documentation that the plan will not increase Federal costs for any fiscal year.
#ASSERT `s 2035(d)(2) the Secretary shall approve the State plan` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2035(d)(2) the Secretary shall approve the State plan` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2035(d)(2) the Secretary shall approve the State plan` (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `s 2035(d)(2) the Secretary shall approve the State plan` NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 2035(d)(2) the Secretary shall approve the State plan` NOTHING NOTHING EQUALS NOTHING

§§ `(e)(2) notification in time (the twin of the duty)`
-- src:3087 | If the Secretary determines that the Program has increased Federal costs under this chapter for any fiscal year or any portion of any fiscal year, the Secretary shall notify the State not later than 30 days after the Secretary makes the determination under paragraph (1).
-- "not later than 30 days after": day 30 is in time, day 31 is not.
#ASSERT `s 2035(e)(2) the Secretary notified the State in time` TRUE 30 EQUALS JUST TRUE
#ASSERT `s 2035(e)(2) the Secretary notified the State in time` TRUE 31 EQUALS JUST FALSE
#ASSERT `s 2035(e)(2) the Secretary notified the State in time` FALSE 31 EQUALS JUST FALSE
#ASSERT `s 2035(e)(2) the Secretary notified the State in time` FALSE 30 EQUALS NOTHING
#ASSERT `s 2035(e)(2) the Secretary notified the State in time` FALSE 0 EQUALS NOTHING

§§ `(e)(3)(A) plan in time (the twin of the duty)`
-- src:3090 | Not later than 90 days after the date of a notification under paragraph (2), the State shall submit a plan for approval by the Secretary for prompt corrective action that is designed to prevent the Program from increasing Federal costs under this chapter.
#ASSERT `s 2035(e)(3)(A) the State submitted its plan in time` TRUE 90 EQUALS JUST TRUE
#ASSERT `s 2035(e)(3)(A) the State submitted its plan in time` TRUE 91 EQUALS JUST FALSE
#ASSERT `s 2035(e)(3)(A) the State submitted its plan in time` FALSE 91 EQUALS JUST FALSE
#ASSERT `s 2035(e)(3)(A) the State submitted its plan in time` FALSE 90 EQUALS NOTHING

§§ `(e)(3)(B) termination`
-- src:3092 | If the State does not submit a plan under subparagraph (A) or carry out a plan approved by the Secretary, the Secretary shall terminate the approval of the State agency operating the Program and the State agency shall be ineligible to operate a future Program.
-- no plan submitted: the Secretary shall terminate.
#ASSERT `s 2035(e)(3)(B) the Secretary shall terminate the approval of the State agency` FALSE NOTHING EQUALS JUST TRUE
-- plan submitted but the approved plan was not carried out.
#ASSERT `s 2035(e)(3)(B) the Secretary shall terminate the approval of the State agency` TRUE (JUST FALSE) EQUALS JUST TRUE
-- plan submitted and carried out: the "if" fails.
#ASSERT `s 2035(e)(3)(B) the Secretary shall terminate the approval of the State agency` TRUE (JUST TRUE) EQUALS JUST FALSE
-- plan submitted, nothing supplied about carrying it out.
#ASSERT `s 2035(e)(3)(B) the Secretary shall terminate the approval of the State agency` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 2035(e)(3)(B) the State agency may operate a future Program` TRUE EQUALS JUST FALSE
#ASSERT `s 2035(e)(3)(B) the State agency may operate a future Program` FALSE EQUALS NOTHING

§§ `(f)(1) to (f)(4)`
-- src:3095 | In operating a Program, a State or political subdivision of a State may follow the rules and procedures established by the State or political subdivision under a State program funded under part A of title IV of the Social Security Act (42 U.S.C. 601 et seq.) or under the supplemental nutrition assistance program.
#ASSERT `s 2035(f)(1) the State may follow the rules and procedures from this source` `s 2035 a State program funded under part A of title IV of the Social Security Act` EQUALS JUST TRUE
#ASSERT `s 2035(f)(1) the State may follow the rules and procedures from this source` `s 2035 the supplemental nutrition assistance program` EQUALS JUST TRUE
#ASSERT `s 2035(f)(1) the State may follow the rules and procedures from this source` `s 2035 a combination of the State TANF-funded program and the supplemental nutrition assistance program` EQUALS NOTHING
#ASSERT `s 2035(f)(1) the State may follow the rules and procedures from this source` `s 2035 some other source` EQUALS NOTHING
-- src:3097 | In operating a Program, a State or political subdivision of a State may standardize the deductions provided under section 2014(e) of this title. In developing the standardized deduction, the State shall consider the work expenses, dependent care costs, and shelter costs of participating households.
#ASSERT `s 2035(f)(2) the State may standardize the deduction` TRUE EQUALS JUST TRUE
#ASSERT `s 2035(f)(2) the State may standardize the deduction` FALSE EQUALS NOTHING
#ASSERT `s 2035(f)(2) the State has considered what it shall consider` (`s 2035 what the State considered` OF TRUE, TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `s 2035(f)(2) the State has considered what it shall consider` (`s 2035 what the State considered` OF FALSE, TRUE, TRUE) EQUALS NOTHING
#ASSERT `s 2035(f)(2) the State has considered what it shall consider` (`s 2035 what the State considered` OF TRUE, FALSE, TRUE) EQUALS NOTHING
#ASSERT `s 2035(f)(2) the State has considered what it shall consider` (`s 2035 what the State considered` OF TRUE, TRUE, FALSE) EQUALS NOTHING
-- src:3101 | (B) section 2017(a) of this title (except that the income of a household may be determined under a State program funded under part A of title IV of the Social Security Act (42 U.S.C. 601 et seq.));
#ASSERT `s 2035(f)(3)(B) the household's income may be determined under this source` `s 2035 a State program funded under part A of title IV of the Social Security Act` EQUALS JUST TRUE
#ASSERT `s 2035(f)(3)(B) the household's income may be determined under this source` `s 2035 the supplemental nutrition assistance program` EQUALS NOTHING
-- src:3099 | In operating a Program, a State or political subdivision shall comply with the requirements of—
-- src:3100 | (A) subsections (a) through (f) of section 2016 of this title;
-- src:3101 | (B) section 2017(a) of this title (except that the income of a household may be determined under a State program funded under part A of title IV of the Social Security Act (42 U.S.C. 601 et seq.));
-- src:3102 | (C) subsections (b) and (d) of section 2017 of this title;
-- src:3103 | (D) subsections (a), (c), (d), and (n) of section 2020 of this title;
-- src:3104 | (E) paragraphs (8), (12), (15), (17), (18), (22), and (23) of section 2020(e) of this title;
-- src:3105 | (F) section 2020(e)(10) of this title (or a comparable requirement established by the State under a State program funded under part A of title IV of the Social Security Act (42 U.S.C. 601 et seq.)); and
-- src:3106 | (G) section 2025 of this title.
-- all seven groups met, (e)(10) met and no comparable requirement supplied.
#ASSERT `s 2035(f)(3) the State complies with the requirements it shall comply with` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) NOTHING (JUST TRUE) EQUALS JUST TRUE
-- (e)(10) not met but the comparable State requirement is.
#ASSERT `s 2035(f)(3) the State complies with the requirements it shall comply with` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
-- neither (e)(10) nor the comparable requirement is met.
#ASSERT `s 2035(f)(3) the State complies with the requirements it shall comply with` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
-- section 2025 not met.
#ASSERT `s 2035(f)(3) the State complies with the requirements it shall comply with` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
-- one answer not supplied and none false.
#ASSERT `s 2035(f)(3) the State complies with the requirements it shall comply with` NOTHING (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS NOTHING
-- one answer not supplied and another false: decided without the missing one.
#ASSERT `s 2035(f)(3) the State complies with the requirements it shall comply with` NOTHING (JUST FALSE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
-- src:3107 | (4) Limitation on eligibility
-- src:3108 | Notwithstanding any other provision of this section, a household may not receive benefits under this section as a result of the eligibility of the household under a State program funded under part A of title IV of the Social Security Act (42 U.S.C. 601 et seq.), unless the Secretary determines that any household with income above 130 percent of the poverty guidelines is not eligible for the program.
#ASSERT `s 2035(f)(4) the household may receive benefits under this section as a result of its eligibility under the State program` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2035(f)(4) the household may receive benefits under this section as a result of its eligibility under the State program` (JUST TRUE) EQUALS NOTHING
#ASSERT `s 2035(f)(4) the household may receive benefits under this section as a result of its eligibility under the State program` NOTHING EQUALS NOTHING

§§ `Regulative rules of (e), run with #TRACE`
-- The stable binary does not let #ASSERT take a #TRACE outcome (`#ASSERT <rule> EQUALS FULFILLED` compares the rule itself and
-- fails), so each trace states the outcome it should print, and the twins above carry the asserted tests.
-- src:3081 | The Secretary shall determine whether a Program being carried out by a State agency is increasing Federal costs under this chapter.
-- (e)(1)(A): the Secretary determines. Expected: FULFILLED.
#TRACE `s 2035(e)(1)(A) the Secretary's duty to determine whether the Program is increasing Federal costs` AT 0 WITH
    PARTY `the Secretary` DOES `s 2035 determine whether the Program is increasing Federal costs` AT 5
-- src:3083 | In making a determination under subparagraph (A), the Secretary shall not require the State agency to collect or report any information on households not included in the Program.
-- (e)(1)(B): the Secretary requires reporting on excluded households. Expected: BREACH BY the Secretary.
#TRACE `s 2035(e)(1)(B) the Secretary's prohibition on requiring information on households not in the Program` AT 0 WITH
    PARTY `the Secretary` DOES `s 2035 require the State agency to collect or report information on households not included in the Program` AT 5
-- src:3085 | The Secretary may approve the request of a State agency to apply alternative accounting periods to determine if Federal costs do not exceed the Federal costs had the State agency not elected to carry out the Program.
-- (e)(1)(C): the Secretary approves a request. Expected: FULFILLED.
#TRACE `s 2035(e)(1)(C) the Secretary's permission to approve alternative accounting periods` AT 0 WITH
    PARTY `the Secretary` DOES `s 2035 approve alternative accounting periods` AT 5
-- src:3087 | If the Secretary determines that the Program has increased Federal costs under this chapter for any fiscal year or any portion of any fiscal year, the Secretary shall notify the State not later than 30 days after the Secretary makes the determination under paragraph (1).
-- (e)(2): notified on day 20 and the State files on day 80 (60 days after the notification). Expected: FULFILLED.
#TRACE `s 2035(e)(2) the Secretary's duty to notify the State` AT 0 WITH
    PARTY `the Secretary` DOES `s 2035 notify the State that the Program has increased Federal costs` AT 20
    PARTY `the State agency` DOES `s 2035 submit a plan for prompt corrective action` AT 80
-- (e)(2): no notification by day 31. Expected: BREACH BY the Secretary.
#TRACE `s 2035(e)(2) the Secretary's duty to notify the State` AT 0 WITH
    (WAITUNTIL 31)
-- (e)(2) then (3)(A) then (3)(B): notified on day 20, no plan by day 111, the Secretary then terminates on day 120.
-- Expected: FULFILLED (the Secretary's duty to terminate is discharged).
#TRACE `s 2035(e)(2) the Secretary's duty to notify the State` AT 0 WITH
    PARTY `the Secretary` DOES `s 2035 notify the State that the Program has increased Federal costs` AT 20
    (WAITUNTIL 111)
    PARTY `the Secretary` DOES `s 2035 terminate the approval of the State agency operating the Program` AT 120

§§ `Every constructor and field declared in snap6-s2035.l4`
#ASSERT `s 2035 statewide` EQUALS `s 2035 statewide`
#ASSERT `s 2035 in a political subdivision of the State` EQUALS `s 2035 in a political subdivision of the State`
#ASSERT `s 2035 somewhere else` EQUALS `s 2035 somewhere else`
#ASSERT `s 2035 a State program funded under part A of title IV of the Social Security Act` EQUALS `s 2035 a State program funded under part A of title IV of the Social Security Act`
#ASSERT `s 2035 the supplemental nutrition assistance program` EQUALS `s 2035 the supplemental nutrition assistance program`
#ASSERT `s 2035 a combination of the State TANF-funded program and the supplemental nutrition assistance program` EQUALS `s 2035 a combination of the State TANF-funded program and the supplemental nutrition assistance program`
#ASSERT `s 2035 some other source` EQUALS `s 2035 some other source`
#ASSERT `s 2035 determine whether the Program is increasing Federal costs` EQUALS `s 2035 determine whether the Program is increasing Federal costs`
#ASSERT `s 2035 require the State agency to collect or report information on households not included in the Program` EQUALS `s 2035 require the State agency to collect or report information on households not included in the Program`
#ASSERT `s 2035 approve alternative accounting periods` EQUALS `s 2035 approve alternative accounting periods`
#ASSERT `s 2035 notify the State that the Program has increased Federal costs` EQUALS `s 2035 notify the State that the Program has increased Federal costs`
#ASSERT `s 2035 submit a plan for prompt corrective action` EQUALS `s 2035 submit a plan for prompt corrective action`
#ASSERT `s 2035 terminate the approval of the State agency operating the Program` EQUALS `s 2035 terminate the approval of the State agency operating the Program`
#ASSERT `s 2035 subsections (a) through (f) of section 2016` EQUALS `s 2035 subsections (a) through (f) of section 2016`
#ASSERT `s 2035 section 2017(a)` EQUALS `s 2035 section 2017(a)`
#ASSERT `s 2035 subsections (b) and (d) of section 2017` EQUALS `s 2035 subsections (b) and (d) of section 2017`
#ASSERT `s 2035 subsections (a), (c), (d) and (n) of section 2020` EQUALS `s 2035 subsections (a), (c), (d) and (n) of section 2020`
#ASSERT `s 2035 paragraphs (8), (12), (15), (17), (18), (22) and (23) of section 2020(e)` EQUALS `s 2035 paragraphs (8), (12), (15), (17), (18), (22) and (23) of section 2020(e)`
#ASSERT `s 2035 section 2020(e)(10) or a comparable State TANF requirement` EQUALS `s 2035 section 2020(e)(10) or a comparable State TANF requirement`
#ASSERT `s 2035 section 2025` EQUALS `s 2035 section 2025`
#ASSERT (`s 2035 what the State considered` OF TRUE, FALSE, TRUE)'s `work expenses` EQUALS TRUE
#ASSERT (`s 2035 what the State considered` OF TRUE, FALSE, TRUE)'s `dependent care costs` EQUALS FALSE
#ASSERT (`s 2035 what the State considered` OF TRUE, FALSE, TRUE)'s `shelter costs` EQUALS TRUE
