IMPORT prelude
IMPORT `snap-core`
IMPORT `snap4-s2020-a-d`

-- Tests for snap4-s2020-a-d.l4. Every expected value is written from the text of lines 1425-1462 BEFORE running.
-- A failing assertion is a finding: no expected value here was edited to match the code.

§ `tests -- s 2020(a)`

-- (a)(1): the State agency of each PARTICIPATING State is responsible; a State that does not participate is not spoken of.
#ASSERT `s 2020(a)(1) the party responsible for certifying applicant households and issuing EBT cards` TRUE EQUALS JUST `the State agency`
#ASSERT `s 2020(a)(1) the party responsible for certifying applicant households and issuing EBT cards` FALSE EQUALS NOTHING

-- (a)(2): "shall not be affected" by State- or county-administration; any other basis is not named.
#ASSERT `s 2020(a)(2) the responsibility of the State agency is affected by the basis of operation` `s 2020(a)(2) State-administered` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 2020(a)(2) the responsibility of the State agency is affected by the basis of operation` `s 2020(a)(2) county-administered` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 2020(a)(2) the responsibility of the State agency is affected by the basis of operation` `s 2020(a)(2) administered on some other basis` (JUST TRUE) EQUALS NOTHING
#ASSERT `s 2020(a)(2) the responsibility of the State agency is affected by the basis of operation` `s 2020(a)(2) State-administered` NOTHING EQUALS NOTHING
#ASSERT `s 2020(a)(2) the responsibility of the State agency is affected by the basis of operation` `s 2020(a)(2) State-administered` (JUST FALSE) EQUALS NOTHING

-- (a)(3)(A): "such records as may be necessary".
#ASSERT `s 2020(a)(3)(A) the State agency must keep the record` TRUE EQUALS JUST TRUE
#ASSERT `s 2020(a)(3)(A) the State agency must keep the record` FALSE EQUALS NOTHING

-- (a)(3)(B)(i): inspection and audit by the Secretary, subject to agreed protocols.
#ASSERT `s 2020(a)(3)(B)(i) the records and information systems must be made available for inspection and audit` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2020(a)(3)(B)(i) the records and information systems must be made available for inspection and audit` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2020(a)(3)(B)(i) the records and information systems must be made available for inspection and audit` FALSE TRUE EQUALS NOTHING

-- (a)(3)(B)(ii): review in a household's action, subject to (e)(8).
#ASSERT `s 2020(a)(3)(B)(ii) the records must be available for review in the action` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2020(a)(3)(B)(ii) the records must be available for review in the action` TRUE TRUE EQUALS NOTHING
#ASSERT `s 2020(a)(3)(B)(ii) the records must be available for review in the action` FALSE FALSE EQUALS NOTHING

-- (a)(3)(B)(iii): "not less than 3 years as may be specified in regulations": both sides of 3, and of a longer regulation.
#ASSERT `s 2020(a)(3)(B)(iii) the records are preserved for long enough` 2 NOTHING EQUALS JUST FALSE
#ASSERT `s 2020(a)(3)(B)(iii) the records are preserved for long enough` 3 NOTHING EQUALS NOTHING
#ASSERT `s 2020(a)(3)(B)(iii) the records are preserved for long enough` 3 (JUST 3) EQUALS JUST TRUE
#ASSERT `s 2020(a)(3)(B)(iii) the records are preserved for long enough` 5 (JUST 5) EQUALS JUST TRUE
#ASSERT `s 2020(a)(3)(B)(iii) the records are preserved for long enough` 4 (JUST 5) EQUALS JUST FALSE
#ASSERT `s 2020(a)(3)(B)(iii) the records are preserved for long enough` 2 (JUST 5) EQUALS JUST FALSE

-- (a)(4)(A): the standards must reach the four listed kinds, "including" leaves other kinds open.
#ASSERT `s 2020(a)(4)(A) the Secretary's standards for identifying major changes must reach the change` `s 2020(a)(4)(A)(i) many low-income households live far from an office performing the major functions of subsection (e)` EQUALS JUST TRUE
#ASSERT `s 2020(a)(4)(A) the Secretary's standards for identifying major changes must reach the change` `s 2020(a)(4)(A)(ii) automated systems replace personnel described in subsection (e)(6)(B)` EQUALS JUST TRUE
#ASSERT `s 2020(a)(4)(A) the Secretary's standards for identifying major changes must reach the change` `s 2020(a)(4)(A)(iii) it is harder to report information under subsection (e) or section 2015(c)` EQUALS JUST TRUE
#ASSERT `s 2020(a)(4)(A) the Secretary's standards for identifying major changes must reach the change` `s 2020(a)(4)(A)(iv) the burdens grow disproportionately on a type of household in subsection (e)(2)(A)` EQUALS JUST TRUE
#ASSERT `s 2020(a)(4)(A) the Secretary's standards for identifying major changes must reach the change` `s 2020(a)(4)(A) any other change` EQUALS NOTHING

-- (a)(4)(B): "If a State agency implements a major change".
#ASSERT `s 2020(a)(4)(B) the State agency must notify the Secretary and collect the required information` TRUE EQUALS JUST TRUE
#ASSERT `s 2020(a)(4)(B) the State agency must notify the Secretary and collect the required information` FALSE EQUALS JUST FALSE

§ `tests -- s 2020(b)`

#ASSERT `s 2020(b) the State agency must promptly restore the improperly denied benefits` TRUE EQUALS JUST TRUE
#ASSERT `s 2020(b) the State agency must promptly restore the improperly denied benefits` FALSE EQUALS NOTHING
#ASSERT `s 2020(b) the State agency must take other steps to prevent a recurrence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2020(b) the State agency must take other steps to prevent a recurrence` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2020(b) the State agency must take other steps to prevent a recurrence` FALSE TRUE EQUALS NOTHING

§ `tests -- s 2020(c)`

-- (c)(1): the five named grounds are barred; the sixth is not spoken of.
#ASSERT `s 2020(c)(1) the certification of applicant households may discriminate by reason of the ground` `s 2020(c)(1) race` EQUALS JUST FALSE
#ASSERT `s 2020(c)(1) the certification of applicant households may discriminate by reason of the ground` `s 2020(c)(1) sex` EQUALS JUST FALSE
#ASSERT `s 2020(c)(1) the certification of applicant households may discriminate by reason of the ground` `s 2020(c)(1) religious creed` EQUALS JUST FALSE
#ASSERT `s 2020(c)(1) the certification of applicant households may discriminate by reason of the ground` `s 2020(c)(1) national origin` EQUALS JUST FALSE
#ASSERT `s 2020(c)(1) the certification of applicant households may discriminate by reason of the ground` `s 2020(c)(1) political affiliation` EQUALS JUST FALSE
#ASSERT `s 2020(c)(1) the certification of applicant households may discriminate by reason of the ground` `s 2020(c)(1) some other ground` EQUALS NOTHING

-- (c)(2): the four laws are respected; a list without "only" leaves any other law open.
#ASSERT `s 2020(c)(2) the administration of the program must be consistent with the household's rights under the law` `s 2020(c)(2)(A) the Age Discrimination Act of 1975` EQUALS JUST TRUE
#ASSERT `s 2020(c)(2) the administration of the program must be consistent with the household's rights under the law` `s 2020(c)(2)(B) section 504 of the Rehabilitation Act of 1973` EQUALS JUST TRUE
#ASSERT `s 2020(c)(2) the administration of the program must be consistent with the household's rights under the law` `s 2020(c)(2)(C) the Americans with Disabilities Act of 1990` EQUALS JUST TRUE
#ASSERT `s 2020(c)(2) the administration of the program must be consistent with the household's rights under the law` `s 2020(c)(2)(D) title VI of the Civil Rights Act of 1964` EQUALS JUST TRUE
#ASSERT `s 2020(c)(2) the administration of the program must be consistent with the household's rights under the law` `s 2020(c)(2) some other law` EQUALS NOTHING

§ `tests -- s 2020(d)`

-- (d) first sentence: the State agency of a State desiring to participate submits a plan.
#ASSERT `s 2020(d) the State agency must submit a plan of operation for approval` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 2020(d) the State agency must submit a plan of operation for approval` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 2020(d) the State agency must submit a plan of operation for approval` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 2020(d) the State agency must submit a plan of operation for approval` NOTHING TRUE EQUALS NOTHING

-- (d) second sentence: "may not ... unless the State determines".
#ASSERT `s 2020(d) the Secretary may require the State to submit the material for prior approval` FALSE EQUALS JUST FALSE
#ASSERT `s 2020(d) the Secretary may require the State to submit the material for prior approval` TRUE EQUALS NOTHING

-- (d) third sentence: reservation. The State agency is responsible unless the Secretary makes BOTH determinations.
`both determinations` MEANS `s 2020(d) the Secretary's finding on a reservation` WITH `the Secretary determines that the State agency is failing properly to administer the program on the reservation` IS JUST TRUE, `the Secretary determines that the tribal organization is capable of effectively and efficiently conducting the program` IS JUST TRUE
`not failing` MEANS `s 2020(d) the Secretary's finding on a reservation` WITH `the Secretary determines that the State agency is failing properly to administer the program on the reservation` IS JUST FALSE, `the Secretary determines that the tribal organization is capable of effectively and efficiently conducting the program` IS NOTHING
`failing but not capable` MEANS `s 2020(d) the Secretary's finding on a reservation` WITH `the Secretary determines that the State agency is failing properly to administer the program on the reservation` IS NOTHING, `the Secretary determines that the tribal organization is capable of effectively and efficiently conducting the program` IS JUST FALSE
`failing only` MEANS `s 2020(d) the Secretary's finding on a reservation` WITH `the Secretary determines that the State agency is failing properly to administer the program on the reservation` IS JUST TRUE, `the Secretary determines that the tribal organization is capable of effectively and efficiently conducting the program` IS NOTHING
`no determination` MEANS `s 2020(d) the Secretary's finding on a reservation` WITH `the Secretary determines that the State agency is failing properly to administer the program on the reservation` IS NOTHING, `the Secretary determines that the tribal organization is capable of effectively and efficiently conducting the program` IS NOTHING
#ASSERT `s 2020(d) the party responsible for conducting the program on the reservation` `both determinations` EQUALS JUST `a tribal organization`
#ASSERT `s 2020(d) the party responsible for conducting the program on the reservation` `not failing` EQUALS JUST `the State agency`
#ASSERT `s 2020(d) the party responsible for conducting the program on the reservation` `failing but not capable` EQUALS JUST `the State agency`
#ASSERT `s 2020(d) the party responsible for conducting the program on the reservation` `failing only` EQUALS NOTHING
#ASSERT `s 2020(d) the party responsible for conducting the program on the reservation` `no determination` EQUALS NOTHING

-- (d) the determination of capability must be made in light of the four factors.
`all four factors` MEANS `s 2020(d) factors the Secretary weighs` WITH `the distance of the reservation from State agency-operated certification and issuance centers` IS TRUE, `the previous experience of the tribal organization in programs authorized under the Indian Self-Determination Act and similar Acts` IS TRUE, `the tribal organization's management and fiscal capabilities` IS TRUE, `the adequacy of measures to ensure there is no discrimination on the basis of race, color, sex, or national origin` IS TRUE
`three factors` MEANS `s 2020(d) factors the Secretary weighs` WITH `the distance of the reservation from State agency-operated certification and issuance centers` IS TRUE, `the previous experience of the tribal organization in programs authorized under the Indian Self-Determination Act and similar Acts` IS TRUE, `the tribal organization's management and fiscal capabilities` IS TRUE, `the adequacy of measures to ensure there is no discrimination on the basis of race, color, sex, or national origin` IS FALSE
#ASSERT `s 2020(d) the Secretary has determined that the tribal organization is capable of conducting the program` (JUST TRUE) `all four factors` EQUALS JUST TRUE
#ASSERT `s 2020(d) the Secretary has determined that the tribal organization is capable of conducting the program` (JUST FALSE) `all four factors` EQUALS JUST FALSE
#ASSERT `s 2020(d) the Secretary has determined that the tribal organization is capable of conducting the program` (JUST TRUE) `three factors` EQUALS NOTHING
#ASSERT `s 2020(d) the Secretary has determined that the tribal organization is capable of conducting the program` NOTHING `all four factors` EQUALS NOTHING

-- (d) fourth and fifth sentences.
#ASSERT `s 2020(d) the Secretary must provide the designees with training and technical assistance` TRUE EQUALS JUST TRUE
#ASSERT `s 2020(d) the Secretary must provide the designees with training and technical assistance` FALSE EQUALS NOTHING
#ASSERT `s 2020(d) the State agency must consult in good faith with the tribal organization` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2020(d) the State agency must consult in good faith with the tribal organization` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2020(d) the State agency must consult in good faith with the tribal organization` FALSE TRUE EQUALS NOTHING

