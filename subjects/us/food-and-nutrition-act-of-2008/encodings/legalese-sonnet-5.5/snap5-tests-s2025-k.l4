IMPORT prelude
IMPORT daydate
IMPORT `snap5-s2025-k`

-- TESTS for snap5-s2025-k.l4 (section 2025(k)). Expected values written from the text before the file was run.

§ `s 2025(k)(1) definitions`

-- "means": a flat definition, so a program that is not described is not the AFDC program
#ASSERT `s 2025(k)(1)(A) the program is the AFDC program` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2025(k)(1)(A) the program is the AFDC program` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2025(k)(1)(A) the program is the AFDC program` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2025(k)(1)(A) the program is the AFDC program` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2025(k)(1)(B) the period is the base period` TRUE EQUALS JUST TRUE
#ASSERT `s 2025(k)(1)(B) the period is the base period` FALSE EQUALS JUST FALSE
-- a State plan or a waiver of the plan
#ASSERT `s 2025(k)(1)(C) the program is the medicaid program` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2025(k)(1)(C) the program is the medicaid program` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 2025(k)(1)(C) the program is the medicaid program` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2025(k)(1)(C) the program is the medicaid program` FALSE FALSE EQUALS JUST FALSE

§ `s 2025(k)(2) determinations`

-- 23 June 1998 plus 180 days: 7 to 30 June, 38 to 31 July, 69 to 31 August, 99 to 30 September, 130 to 31 October, 160 to 30 November, 180 to 20 December
#ASSERT `s 2025(k)(2) the date by which the Secretary of Health and Human Services must make the determinations` EQUALS Date 20 12 1998
#ASSERT `s 2025(k)(2) the determinations are made as required` TRUE TRUE (Date 20 12 1998) EQUALS JUST TRUE
#ASSERT `s 2025(k)(2) the determinations are made as required` TRUE TRUE (Date 21 12 1998) EQUALS JUST FALSE
#ASSERT `s 2025(k)(2) the determinations are made as required` TRUE TRUE (Date 1 1 1998) EQUALS JUST TRUE
#ASSERT `s 2025(k)(2) the determinations are made as required` FALSE TRUE (Date 1 1 1998) EQUALS JUST FALSE
#ASSERT `s 2025(k)(2) the determinations are made as required` TRUE FALSE (Date 1 1 1998) EQUALS JUST FALSE
-- (B): costs allocated equally among the programs for which the individual, family, or household was eligible or applied
#ASSERT `s 2025(k)(2)(B) the amount of common costs allocated to each program when allocated equally` 300 3 EQUALS JUST 100
#ASSERT `s 2025(k)(2)(B) the amount of common costs allocated to each program when allocated equally` 300 2 EQUALS JUST 150
#ASSERT `s 2025(k)(2)(B) the amount of common costs allocated to each program when allocated equally` 300 1 EQUALS JUST 300
#ASSERT `s 2025(k)(2)(B) the amount of common costs allocated to each program when allocated equally` 100 3 EQUALS JUST (100 DIVIDED BY 3)
#ASSERT `s 2025(k)(2)(B) the amount of common costs allocated to each program when allocated equally` 300 0 EQUALS NOTHING

§ `s 2025(k)(3) reduction in payment`

#ASSERT `s 2025(k)(3)(A) the amount paid to the State after the reduction` 1000 300 EQUALS JUST 700
#ASSERT `s 2025(k)(3)(A) the amount paid to the State after the reduction` 300 300 EQUALS JUST 0
#ASSERT `s 2025(k)(3)(A) the amount paid to the State after the reduction` 300 301 EQUALS NOTHING
-- quarterly "to the extent practicable"
#ASSERT `s 2025(k)(3)(A) the reductions are made on a quarterly basis as required` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2025(k)(3)(A) the reductions are made on a quarterly basis as required` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2025(k)(3)(A) the reductions are made on a quarterly basis as required` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2025(k)(3)(A) the reductions are made on a quarterly basis as required` FALSE FALSE EQUALS NOTHING
-- (B): determinations not made by September 30, 1999
#ASSERT `s 2025(k)(3)(B) the determinations were not made by September 30, 1999` (Date 30 9 1999) EQUALS JUST FALSE
#ASSERT `s 2025(k)(3)(B) the determinations were not made by September 30, 1999` (Date 1 10 1999) EQUALS JUST TRUE
#ASSERT `s 2025(k)(3)(B) the determinations were not made by September 30, 1999` (Date 1 1 1999) EQUALS JUST FALSE
-- (i) the sum of the amounts for fiscal year 1999 through the fiscal year the determinations are made
#ASSERT `s 2025(k)(3)(B)(i) the amount of the reduction in the fiscal year in which the determinations are made` (Date 1 10 1999) (LIST 100, 200, 300) EQUALS JUST 600
#ASSERT `s 2025(k)(3)(B)(i) the amount of the reduction in the fiscal year in which the determinations are made` (Date 1 10 1999) (LIST 250) EQUALS JUST 250
#ASSERT `s 2025(k)(3)(B)(i) the amount of the reduction in the fiscal year in which the determinations are made` (Date 1 10 1999) EMPTY EQUALS JUST 0
#ASSERT `s 2025(k)(3)(B)(i) the amount of the reduction in the fiscal year in which the determinations are made` (Date 30 9 1999) (LIST 100, 200, 300) EQUALS NOTHING
-- (ii) for each subsequent fiscal year, subparagraph (A) applies
#ASSERT `s 2025(k)(3)(B)(ii) subparagraph (A) applies in the fiscal year` (Date 1 10 1999) 2001 2000 EQUALS JUST TRUE
#ASSERT `s 2025(k)(3)(B)(ii) subparagraph (A) applies in the fiscal year` (Date 1 10 1999) 2000 2000 EQUALS NOTHING
#ASSERT `s 2025(k)(3)(B)(ii) subparagraph (A) applies in the fiscal year` (Date 1 10 1999) 1999 2000 EQUALS NOTHING
#ASSERT `s 2025(k)(3)(B)(ii) subparagraph (A) applies in the fiscal year` (Date 30 9 1999) 2001 2000 EQUALS NOTHING

§ `s 2025(k)(4) appeal of determinations`

-- (A): 5 days; 28 February 2000 plus 5 days is 4 March 2000 (29 February, 1, 2, 3, 4 March)
#ASSERT `s 2025(k)(4)(A) the last day for the Secretary to notify the chief executive officer of the State` (Date 1 3 2000) EQUALS Date 6 3 2000
#ASSERT `s 2025(k)(4)(A) the last day for the Secretary to notify the chief executive officer of the State` (Date 28 2 2000) EQUALS Date 4 3 2000
#ASSERT `s 2025(k)(4)(A) the Secretary notifies the chief executive officer in time` (Date 1 3 2000) (Date 6 3 2000) EQUALS JUST TRUE
#ASSERT `s 2025(k)(4)(A) the Secretary notifies the chief executive officer in time` (Date 1 3 2000) (Date 7 3 2000) EQUALS JUST FALSE
#ASSERT `s 2025(k)(4)(A) the Secretary notifies the chief executive officer in time` (Date 1 3 2000) (Date 2 3 2000) EQUALS JUST TRUE
-- (B)(i): 60 days after the State receives notice; 1 March 2000 plus 60 days is 30 April 2000 (30 to 31 March, 30 more to 30 April)
#ASSERT `s 2025(k)(4)(B)(i) the last day for the State to appeal to an administrative law judge` (Date 1 3 2000) EQUALS Date 30 4 2000
#ASSERT `s 2025(k)(4)(B)(i) the State may appeal the determination` (Date 1 3 2000) (Date 30 4 2000) EQUALS JUST TRUE
#ASSERT `s 2025(k)(4)(B)(i) the State may appeal the determination` (Date 1 3 2000) (Date 1 5 2000) EQUALS JUST FALSE
-- (B)(ii)-(iii)
#ASSERT `s 2025(k)(4)(B) the administrative law judge has reviewed the appeal as required` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2025(k)(4)(B) the administrative law judge has reviewed the appeal as required` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2025(k)(4)(B) the administrative law judge has reviewed the appeal as required` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2025(k)(4)(B) the administrative law judge has reviewed the appeal as required` TRUE TRUE FALSE EQUALS JUST FALSE
-- (B)(iv): 60 days after the record is closed; 15 June 2000 plus 60 days is 14 August 2000 (15 to 30 June, 31 to 31 July, 14 to 14 August)
#ASSERT `s 2025(k)(4)(B)(iv) the last day for the administrative law judge to decide and notify` (Date 15 6 2000) EQUALS Date 14 8 2000
#ASSERT `s 2025(k)(4)(B)(iv) the administrative law judge decides and notifies in time` (Date 15 6 2000) (Date 14 8 2000) (Date 14 8 2000) EQUALS JUST TRUE
#ASSERT `s 2025(k)(4)(B)(iv) the administrative law judge decides and notifies in time` (Date 15 6 2000) (Date 14 8 2000) (Date 15 8 2000) EQUALS JUST FALSE
#ASSERT `s 2025(k)(4)(B)(iv) the administrative law judge decides and notifies in time` (Date 15 6 2000) (Date 15 8 2000) (Date 14 8 2000) EQUALS JUST FALSE
#ASSERT `s 2025(k)(4)(B)(iv) the administrative law judge decides and notifies in time` (Date 15 6 2000) (Date 1 7 2000) (Date 2 7 2000) EQUALS JUST TRUE
-- (C)(i): 30 days after the State receives notice of a final decision; 1 March 2000 plus 30 days is 31 March 2000
#ASSERT `s 2025(k)(4)(C)(i) the last day for the State to appeal to the Departmental Appeals Board` (Date 1 3 2000) EQUALS Date 31 3 2000
#ASSERT `s 2025(k)(4)(C)(i) the State may appeal the decision` (Date 1 3 2000) (Date 31 3 2000) EQUALS JUST TRUE
#ASSERT `s 2025(k)(4)(C)(i) the State may appeal the decision` (Date 1 3 2000) (Date 1 4 2000) EQUALS JUST FALSE
-- (C)(ii)
#ASSERT `s 2025(k)(4)(C)(ii) the Board has reviewed the decision as required` TRUE EQUALS JUST TRUE
#ASSERT `s 2025(k)(4)(C)(ii) the Board has reviewed the decision as required` FALSE EQUALS JUST FALSE
-- (C)(iii): 60 days after the appeal is filed; 1 January 2001 plus 60 days is 2 March 2001 (30 to 31 January, 28 to 28 February, 2 to 2 March)
#ASSERT `s 2025(k)(4)(C)(iii) the last day for the Board to decide and notify` (Date 1 1 2001) EQUALS Date 2 3 2001
#ASSERT `s 2025(k)(4)(C)(iii) the Board decides and notifies in time` (Date 1 1 2001) (Date 2 3 2001) (Date 2 3 2001) EQUALS JUST TRUE
#ASSERT `s 2025(k)(4)(C)(iii) the Board decides and notifies in time` (Date 1 1 2001) (Date 3 3 2001) (Date 2 3 2001) EQUALS JUST FALSE
#ASSERT `s 2025(k)(4)(C)(iii) the Board decides and notifies in time` (Date 1 1 2001) (Date 2 3 2001) (Date 3 3 2001) EQUALS JUST FALSE
-- (D): no judicial review of the determination, or a final decision of the judge or the Board
#ASSERT `s 2025(k)(4)(D) the determination or decision is subject to judicial review` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2025(k)(4)(D) the determination or decision is subject to judicial review` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2025(k)(4)(D) the determination or decision is subject to judicial review` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2025(k)(4)(D) the determination or decision is subject to judicial review` FALSE FALSE FALSE EQUALS NOTHING
-- (E)
#ASSERT `s 2025(k)(4)(E) the pendency of the appeal affects the requirement that the Secretary reduce payments` TRUE EQUALS JUST FALSE
#ASSERT `s 2025(k)(4)(E) the pendency of the appeal affects the requirement that the Secretary reduce payments` FALSE EQUALS NOTHING

§ `s 2025(k)(5) allocation of administrative costs`

-- the four kinds in subparagraph (B), both conditions of subparagraph (A): the bar
#ASSERT `s 2025(k)(5) the funds or expenditures may be used to pay for the costs` `s 2025(k)(5)(B)(i) funds made available to carry out part A of title IV, or title XX, of the Social Security Act` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2025(k)(5) the funds or expenditures may be used to pay for the costs` `s 2025(k)(5)(B)(ii) expenditures made as qualified State expenditures` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2025(k)(5) the funds or expenditures may be used to pay for the costs` `s 2025(k)(5)(B)(iii) any other Federal funds` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2025(k)(5) the funds or expenditures may be used to pay for the costs` `s 2025(k)(5)(B)(iv)(I) State funds expended as a condition of receiving Federal funds` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2025(k)(5) the funds or expenditures may be used to pay for the costs` `s 2025(k)(5)(B)(iv)(II) State funds used to match Federal funds under a Federal program other than the supplemental nutrition assistance program` TRUE TRUE EQUALS JUST FALSE
-- if either condition fails, the bar does not speak
#ASSERT `s 2025(k)(5) the funds or expenditures may be used to pay for the costs` `s 2025(k)(5)(B)(i) funds made available to carry out part A of title IV, or title XX, of the Social Security Act` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2025(k)(5) the funds or expenditures may be used to pay for the costs` `s 2025(k)(5)(B)(i) funds made available to carry out part A of title IV, or title XX, of the Social Security Act` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2025(k)(5) the funds or expenditures may be used to pay for the costs` `s 2025(k)(5)(B)(i) funds made available to carry out part A of title IV, or title XX, of the Social Security Act` FALSE FALSE EQUALS NOTHING
-- funds provided under subsection (a) are excepted from (iii), and the list is closed
#ASSERT `s 2025(k)(5) the funds or expenditures may be used to pay for the costs` `s 2025(k)(5)(B)(iii) funds provided under subsection (a)` TRUE TRUE EQUALS NOTHING
#ASSERT `s 2025(k)(5) the funds or expenditures may be used to pay for the costs` `s 2025(k)(5)(B) any other funds or expenditures` TRUE TRUE EQUALS NOTHING

§ `every declared type and constructor is used`

#ASSERT `s 2025(k)(5)(B)(i) funds made available to carry out part A of title IV, or title XX, of the Social Security Act` EQUALS `s 2025(k)(5)(B)(i) funds made available to carry out part A of title IV, or title XX, of the Social Security Act`
#ASSERT `s 2025(k)(5)(B)(ii) expenditures made as qualified State expenditures` EQUALS `s 2025(k)(5)(B)(ii) expenditures made as qualified State expenditures`
#ASSERT `s 2025(k)(5)(B)(iii) any other Federal funds` EQUALS `s 2025(k)(5)(B)(iii) any other Federal funds`
#ASSERT `s 2025(k)(5)(B)(iii) funds provided under subsection (a)` EQUALS `s 2025(k)(5)(B)(iii) funds provided under subsection (a)`
#ASSERT `s 2025(k)(5)(B)(iv)(I) State funds expended as a condition of receiving Federal funds` EQUALS `s 2025(k)(5)(B)(iv)(I) State funds expended as a condition of receiving Federal funds`
#ASSERT `s 2025(k)(5)(B)(iv)(II) State funds used to match Federal funds under a Federal program other than the supplemental nutrition assistance program` EQUALS `s 2025(k)(5)(B)(iv)(II) State funds used to match Federal funds under a Federal program other than the supplemental nutrition assistance program`
#ASSERT `s 2025(k)(5)(B) any other funds or expenditures` EQUALS `s 2025(k)(5)(B) any other funds or expenditures`
