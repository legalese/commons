IMPORT prelude
IMPORT daydate
IMPORT `snap-core`
IMPORT `snap2-3val`
IMPORT `snap2-2015e-n`

-- Tests of section 2015(e) to (n). Expected values are decided from the quoted words before the run.

§ `Tests: 2015(e)`
-- an enrolled student in an otherwise eligible household, with the arguments below; every exception off unless an argument turns it on
-- argument order: age, fit, (3)(A) WIOA, (3)(B)(i), (3)(B)(ii), (3)(C), (3)(D) Secretary, (4) hours per week, (4) work study, (5) parent, child's age, adequate child care, (6) TANF, (7) work incentive, (8) full-time, (8) single parent
GIVEN age IS A NUMBER, fit IS A BOOLEAN, wioa IS A BOOLEAN, b1 IS A BOOLEAN, b2 IS A BOOLEAN, c IS A BOOLEAN, d IS A MAYBE BOOLEAN, hours IS A NUMBER, ws IS A BOOLEAN, parent IS A BOOLEAN, childAge IS A NUMBER, care IS A BOOLEAN, tanf IS A BOOLEAN, wi IS A BOOLEAN, ft IS A BOOLEAN, single IS A BOOLEAN
GIVETH A `s 2015(e) facts`
`s 2015(e) test: facts` MEANS
    `s 2015(e) facts` OF TRUE, TRUE, age, fit, wioa, b1, b2, c, d, hours, ws, parent, childAge, care, tanf, wi, ft, single
#ASSERT `s 2015(e) the individual is ineligible as a student` (`s 2015(e) test: facts` 25 TRUE FALSE FALSE FALSE FALSE (JUST FALSE) 0 FALSE FALSE 0 TRUE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `s 2015(e) the individual is ineligible as a student` (`s 2015(e) facts` OF FALSE, TRUE, 25, TRUE, FALSE, FALSE, FALSE, FALSE, JUST FALSE, 0, FALSE, FALSE, 0, TRUE, FALSE, FALSE, FALSE, FALSE) EQUALS NOTHING
#ASSERT `s 2015(e) the individual is ineligible as a student` (`s 2015(e) facts` OF TRUE, FALSE, 25, TRUE, FALSE, FALSE, FALSE, FALSE, JUST FALSE, 0, FALSE, FALSE, 0, TRUE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST FALSE
-- (1) "is under age 18 or is age 50 or older"
#ASSERT `s 2015(e) the individual is ineligible as a student` (`s 2015(e) test: facts` 17 TRUE FALSE FALSE FALSE FALSE (JUST FALSE) 0 FALSE FALSE 0 TRUE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 2015(e) the individual is ineligible as a student` (`s 2015(e) test: facts` 18 TRUE FALSE FALSE FALSE FALSE (JUST FALSE) 0 FALSE FALSE 0 TRUE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `s 2015(e) the individual is ineligible as a student` (`s 2015(e) test: facts` 49 TRUE FALSE FALSE FALSE FALSE (JUST FALSE) 0 FALSE FALSE 0 TRUE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `s 2015(e) the individual is ineligible as a student` (`s 2015(e) test: facts` 50 TRUE FALSE FALSE FALSE FALSE (JUST FALSE) 0 FALSE FALSE 0 TRUE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
-- (2) "is not physically or mentally fit"
#ASSERT `s 2015(e) the individual is ineligible as a student` (`s 2015(e) test: facts` 25 FALSE FALSE FALSE FALSE FALSE (JUST FALSE) 0 FALSE FALSE 0 TRUE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
-- (3) each placement
#ASSERT `s 2015(e) the individual is ineligible as a student` (`s 2015(e) test: facts` 25 TRUE TRUE FALSE FALSE FALSE (JUST FALSE) 0 FALSE FALSE 0 TRUE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 2015(e) the individual is ineligible as a student` (`s 2015(e) test: facts` 25 TRUE FALSE TRUE FALSE FALSE (JUST FALSE) 0 FALSE FALSE 0 TRUE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 2015(e) the individual is ineligible as a student` (`s 2015(e) test: facts` 25 TRUE FALSE FALSE TRUE FALSE (JUST FALSE) 0 FALSE FALSE 0 TRUE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 2015(e) the individual is ineligible as a student` (`s 2015(e) test: facts` 25 TRUE FALSE FALSE FALSE TRUE (JUST FALSE) 0 FALSE FALSE 0 TRUE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 2015(e) the individual is ineligible as a student` (`s 2015(e) test: facts` 25 TRUE FALSE FALSE FALSE FALSE (JUST TRUE) 0 FALSE FALSE 0 TRUE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 2015(e) the individual is ineligible as a student` (`s 2015(e) test: facts` 25 TRUE FALSE FALSE FALSE FALSE NOTHING 0 FALSE FALSE 0 TRUE FALSE FALSE FALSE FALSE) EQUALS NOTHING
-- (4) "a minimum of 20 hours per week" or a work study program
#ASSERT `s 2015(e) the individual is ineligible as a student` (`s 2015(e) test: facts` 25 TRUE FALSE FALSE FALSE FALSE (JUST FALSE) 20 FALSE FALSE 0 TRUE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 2015(e) the individual is ineligible as a student` (`s 2015(e) test: facts` 25 TRUE FALSE FALSE FALSE FALSE (JUST FALSE) 19 FALSE FALSE 0 TRUE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `s 2015(e) the individual is ineligible as a student` (`s 2015(e) test: facts` 25 TRUE FALSE FALSE FALSE FALSE (JUST FALSE) 0 TRUE FALSE 0 TRUE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
-- (5)(A) a parent of a child under age 6
#ASSERT `s 2015(e) the individual is ineligible as a student` (`s 2015(e) test: facts` 25 TRUE FALSE FALSE FALSE FALSE (JUST FALSE) 0 FALSE TRUE 5 TRUE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 2015(e) the individual is ineligible as a student` (`s 2015(e) test: facts` 25 TRUE FALSE FALSE FALSE FALSE (JUST FALSE) 0 FALSE TRUE 6 TRUE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
-- (5)(B) a parent of a child above 5 and under 12 for whom adequate child care is not available
#ASSERT `s 2015(e) the individual is ineligible as a student` (`s 2015(e) test: facts` 25 TRUE FALSE FALSE FALSE FALSE (JUST FALSE) 0 FALSE TRUE 6 FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 2015(e) the individual is ineligible as a student` (`s 2015(e) test: facts` 25 TRUE FALSE FALSE FALSE FALSE (JUST FALSE) 0 FALSE TRUE 11 FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 2015(e) the individual is ineligible as a student` (`s 2015(e) test: facts` 25 TRUE FALSE FALSE FALSE FALSE (JUST FALSE) 0 FALSE TRUE 12 FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `s 2015(e) the individual is ineligible as a student` (`s 2015(e) test: facts` 25 TRUE FALSE FALSE FALSE FALSE (JUST FALSE) 0 FALSE FALSE 6 FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
-- (6) TANF, (7) work incentive program
#ASSERT `s 2015(e) the individual is ineligible as a student` (`s 2015(e) test: facts` 25 TRUE FALSE FALSE FALSE FALSE (JUST FALSE) 0 FALSE FALSE 0 TRUE TRUE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 2015(e) the individual is ineligible as a student` (`s 2015(e) test: facts` 25 TRUE FALSE FALSE FALSE FALSE (JUST FALSE) 0 FALSE FALSE 0 TRUE FALSE TRUE FALSE FALSE) EQUALS JUST FALSE
-- (8) enrolled full-time and a single parent of a dependent child under age 12
#ASSERT `s 2015(e) the individual is ineligible as a student` (`s 2015(e) test: facts` 25 TRUE FALSE FALSE FALSE FALSE (JUST FALSE) 0 FALSE TRUE 11 TRUE FALSE FALSE TRUE TRUE) EQUALS JUST FALSE
#ASSERT `s 2015(e) the individual is ineligible as a student` (`s 2015(e) test: facts` 25 TRUE FALSE FALSE FALSE FALSE (JUST FALSE) 0 FALSE TRUE 12 TRUE FALSE FALSE TRUE TRUE) EQUALS JUST TRUE
#ASSERT `s 2015(e) the individual is ineligible as a student` (`s 2015(e) test: facts` 25 TRUE FALSE FALSE FALSE FALSE (JUST FALSE) 0 FALSE TRUE 11 TRUE FALSE FALSE TRUE FALSE) EQUALS JUST TRUE
#ASSERT `s 2015(e) the individual is ineligible as a student` (`s 2015(e) test: facts` 25 TRUE FALSE FALSE FALSE FALSE (JUST FALSE) 0 FALSE TRUE 11 TRUE FALSE FALSE FALSE TRUE) EQUALS JUST TRUE

§ `Tests: 2015(f)`
-- Individual: age, fit, pregnant, immigration status, resident, receives SSI, hours worked, enrolled half-time
#ASSERT `s 2015(f) the individual is ineligible for want of residence or status` (Individual OF 30, TRUE, FALSE, `a citizen or national of the United States`, TRUE, FALSE, 0, FALSE) EQUALS JUST FALSE
#ASSERT `s 2015(f) the individual is ineligible for want of residence or status` (Individual OF 30, TRUE, FALSE, `an alien lawfully admitted for permanent residence`, TRUE, FALSE, 0, FALSE) EQUALS JUST FALSE
#ASSERT `s 2015(f) the individual is ineligible for want of residence or status` (Individual OF 30, TRUE, FALSE, `a Cuban or Haitian entrant`, TRUE, FALSE, 0, FALSE) EQUALS JUST FALSE
#ASSERT `s 2015(f) the individual is ineligible for want of residence or status` (Individual OF 30, TRUE, FALSE, `a resident under a Compact of Free Association`, TRUE, FALSE, 0, FALSE) EQUALS JUST FALSE
#ASSERT `s 2015(f) the individual is ineligible for want of residence or status` (Individual OF 30, TRUE, FALSE, `any other status`, TRUE, FALSE, 0, FALSE) EQUALS JUST TRUE
#ASSERT `s 2015(f) the individual is ineligible for want of residence or status` (Individual OF 30, TRUE, FALSE, `a citizen or national of the United States`, FALSE, FALSE, 0, FALSE) EQUALS JUST TRUE
-- the closing paragraph: argument order: rendered ineligible, the individual's income, State chose to leave out a pro rata share, the share
#ASSERT `s 2015(f) the income of the ineligible individual counted for the household, in dollars` TRUE 800 FALSE 0 EQUALS JUST 800
#ASSERT `s 2015(f) the income of the ineligible individual counted for the household, in dollars` TRUE 800 TRUE 200 EQUALS JUST 600
#ASSERT `s 2015(f) the income of the ineligible individual counted for the household, in dollars` FALSE 800 TRUE 200 EQUALS NOTHING
#ASSERT `s 2015(f) the financial resources of the ineligible individual are considered for the household` TRUE EQUALS JUST TRUE
#ASSERT `s 2015(f) the financial resources of the ineligible individual are considered for the household` FALSE EQUALS NOTHING

§ `Tests: 2015(g) and (h)`
-- (g) argument order: receives SSI or like payments, resides in a State with such supplementary payments, the Commissioner's finding
#ASSERT `s 2015(g) the individual is not considered a member of a household for the month` TRUE TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2015(g) the individual is not considered a member of a household for the month` TRUE FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 2015(g) the individual is not considered a member of a household for the month` TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2015(g) the individual is not considered a member of a household for the month` TRUE TRUE NOTHING EQUALS NOTHING
#ASSERT `s 2015(g) the individual is not considered a member of a household for the month` FALSE TRUE (JUST TRUE) EQUALS NOTHING
-- (h) argument order: knowingly transferred, for the purpose of qualifying, date of discovery, months ineligible, date asked about; "up to one year from the date of discovery"
#ASSERT `s 2015(h) the household is ineligible on the date` TRUE TRUE (Date 15 1 2026) 12 (Date 15 1 2026) EQUALS `s 2015(h) ineligible for a period of up to one year from the date of discovery, ending` (Date 14 1 2027)
#ASSERT `s 2015(h) the household is ineligible on the date` TRUE TRUE (Date 15 1 2026) 12 (Date 14 1 2027) EQUALS `s 2015(h) ineligible for a period of up to one year from the date of discovery, ending` (Date 14 1 2027)
#ASSERT `s 2015(h) the household is ineligible on the date` TRUE TRUE (Date 15 1 2026) 12 (Date 15 1 2027) EQUALS `s 2015(h) not ineligible under this subsection`
#ASSERT `s 2015(h) the household is ineligible on the date` TRUE TRUE (Date 15 1 2026) 12 (Date 14 1 2026) EQUALS `s 2015(h) not ineligible under this subsection`
#ASSERT `s 2015(h) the household is ineligible on the date` TRUE TRUE (Date 15 1 2026) 6 (Date 14 7 2026) EQUALS `s 2015(h) ineligible for a period of up to one year from the date of discovery, ending` (Date 14 7 2026)
#ASSERT `s 2015(h) the household is ineligible on the date` TRUE TRUE (Date 15 1 2026) 6 (Date 15 7 2026) EQUALS `s 2015(h) not ineligible under this subsection`
#ASSERT `s 2015(h) the household is ineligible on the date` TRUE TRUE (Date 15 1 2026) 13 (Date 15 1 2026) EQUALS `s 2015(h) not covered`
#ASSERT `s 2015(h) the household is ineligible on the date` FALSE TRUE (Date 15 1 2026) 12 (Date 15 1 2026) EQUALS `s 2015(h) not ineligible under this subsection`
#ASSERT `s 2015(h) the household is ineligible on the date` TRUE FALSE (Date 15 1 2026) 12 (Date 15 1 2026) EQUALS `s 2015(h) not ineligible under this subsection`

§ `Tests: 2015(i) and (j)`
#ASSERT `s 2015(i)(1) the State agency may impose the same disqualification under the program` TRUE EQUALS JUST TRUE
#ASSERT `s 2015(i)(1) the State agency may impose the same disqualification under the program` FALSE EQUALS NOTHING
#ASSERT `s 2015(i)(2) the State agency may use the rules and procedures of part A of title IV` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2015(i)(2) the State agency may use the rules and procedures of part A of title IV` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2015(i)(2) the State agency may use the rules and procedures of part A of title IV` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2015(i)(3) the member who applies is treated as a new applicant` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2015(i)(3) the member who applies is treated as a new applicant` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2015(i)(3) a prior disqualification under subsection (d) is considered in determining the former member's eligibility` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2015(i)(3) a prior disqualification under subsection (d) is considered in determining the former member's eligibility` TRUE TRUE FALSE EQUALS NOTHING
-- (j) argument order: found by a State agency, convicted, identity or place of residence, in order to receive multiple benefits
#ASSERT `s 2015(j) the period of ineligibility for receiving multiple benefits` TRUE FALSE TRUE TRUE EQUALS `s 2015(j) ineligible for a period` (`for a number of years` 10)
#ASSERT `s 2015(j) the period of ineligibility for receiving multiple benefits` FALSE TRUE TRUE TRUE EQUALS `s 2015(j) ineligible for a period` (`for a number of years` 10)
#ASSERT `s 2015(j) the period of ineligibility for receiving multiple benefits` FALSE FALSE TRUE TRUE EQUALS `s 2015(j) not ineligible under this subsection`
#ASSERT `s 2015(j) the period of ineligibility for receiving multiple benefits` TRUE FALSE FALSE TRUE EQUALS `s 2015(j) not ineligible under this subsection`
#ASSERT `s 2015(j) the period of ineligibility for receiving multiple benefits` TRUE FALSE TRUE FALSE EQUALS `s 2015(j) not ineligible under this subsection`

§ `Tests: 2015(k)`
-- (1) argument order: otherwise eligible member, fleeing as the Secretary defines it, the flight is for a felony (or a New Jersey high misdemeanor), violating probation or parole
#ASSERT `s 2015(k)(1) the individual is ineligible while fleeing or violating probation or parole` TRUE (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2015(k)(1) the individual is ineligible while fleeing or violating probation or parole` TRUE (JUST FALSE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2015(k)(1) the individual is ineligible while fleeing or violating probation or parole` TRUE NOTHING TRUE FALSE EQUALS NOTHING
#ASSERT `s 2015(k)(1) the individual is ineligible while fleeing or violating probation or parole` TRUE (JUST TRUE) FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2015(k)(1) the individual is ineligible while fleeing or violating probation or parole` TRUE (JUST FALSE) FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 2015(k)(1) the individual is ineligible while fleeing or violating probation or parole` FALSE (JUST TRUE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 2015(k)(2)(A) the individual is fleeing or actively sought, as the Secretary defines the terms` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2015(k)(2)(A) the individual is fleeing or actively sought, as the Secretary defines the terms` NOTHING EQUALS NOTHING
#ASSERT `s 2015(k)(2)(B) the State agency is to disqualify the individual under the Secretary's consistent procedures` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2015(k)(2)(B) the State agency is to disqualify the individual under the Secretary's consistent procedures` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 2015(k)(2)(B) the State agency is to disqualify the individual under the Secretary's consistent procedures` NOTHING EQUALS NOTHING

§ `Tests: 2015(l) to (n)`
-- (l)(1) argument order: option taken, custodial parent of a child under 18 with an absent parent, born out of wedlock, cooperates on paternity, cooperates on support, good cause found
#ASSERT `s 2015(l) the individual is ineligible for want of cooperation with the child support agency` TRUE TRUE TRUE TRUE TRUE NOTHING EQUALS JUST FALSE
#ASSERT `s 2015(l) the individual is ineligible for want of cooperation with the child support agency` TRUE TRUE TRUE FALSE TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 2015(l) the individual is ineligible for want of cooperation with the child support agency` TRUE TRUE FALSE FALSE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2015(l) the individual is ineligible for want of cooperation with the child support agency` TRUE TRUE TRUE TRUE FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 2015(l) the individual is ineligible for want of cooperation with the child support agency` TRUE TRUE TRUE FALSE FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 2015(l) the individual is ineligible for want of cooperation with the child support agency` TRUE TRUE TRUE FALSE FALSE NOTHING EQUALS NOTHING
#ASSERT `s 2015(l) the individual is ineligible for want of cooperation with the child support agency` FALSE TRUE TRUE FALSE FALSE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 2015(l) the individual is ineligible for want of cooperation with the child support agency` TRUE FALSE TRUE FALSE FALSE (JUST FALSE) EQUALS NOTHING
-- (l)(2): good cause found, so paragraph (1) does not apply
#ASSERT `s 2015(l)(2) paragraph (1) does not apply to the individual` (JUST TRUE) EQUALS JUST TRUE
-- (l)(2): good cause not found, the "if" fails (reading (a)), so the text says paragraph (1) applies
#ASSERT `s 2015(l)(2) paragraph (1) does not apply to the individual` (JUST FALSE) EQUALS JUST FALSE
-- (l)(2): no finding supplied, the State agency's finding is not in the text
#ASSERT `s 2015(l)(2) paragraph (1) does not apply to the individual` NOTHING EQUALS NOTHING
#ASSERT `s 2015(l)(3) the individual is required to pay a fee or other cost for the service` TRUE EQUALS JUST FALSE
#ASSERT `s 2015(l)(3) the individual is required to pay a fee or other cost for the service` FALSE EQUALS NOTHING
-- (m)(1) argument order: option taken, noncustodial parent of a child under 18, born out of wedlock, refuses on paternity, refuses on support
#ASSERT `s 2015(m)(1) the noncustodial parent is ineligible for refusing to cooperate with the child support agency` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2015(m)(1) the noncustodial parent is ineligible for refusing to cooperate with the child support agency` TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2015(m)(1) the noncustodial parent is ineligible for refusing to cooperate with the child support agency` TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2015(m)(1) the noncustodial parent is ineligible for refusing to cooperate with the child support agency` TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 2015(m)(1) the noncustodial parent is ineligible for refusing to cooperate with the child support agency` TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2015(m)(1) the noncustodial parent is ineligible for refusing to cooperate with the child support agency` FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 2015(m)(1) the noncustodial parent is ineligible for refusing to cooperate with the child support agency` TRUE FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 2015(m)(2) the matter is a refusal to cooperate under the guidelines and procedures` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2015(m)(2) the matter is a refusal to cooperate under the guidelines and procedures` NOTHING EQUALS NOTHING
#ASSERT `s 2015(m)(3) the individual is required to pay a fee or other cost for the service` TRUE EQUALS JUST FALSE
#ASSERT `s 2015(m)(3) the individual is required to pay a fee or other cost for the service` FALSE EQUALS NOTHING
#ASSERT `s 2015(m)(4) the State agency is required to provide safeguards restricting the use of the information to the purposes for which it was collected` TRUE EQUALS JUST TRUE
#ASSERT `s 2015(m)(4) the State agency is required to provide safeguards restricting the use of the information to the purposes for which it was collected` FALSE EQUALS NOTHING
-- (n) argument order: option taken, delinquent during the month, a court is allowing delay, complying with an approved payment plan
#ASSERT `s 2015(n) the individual is ineligible for the month for child support arrears` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2015(n) the individual is ineligible for the month for child support arrears` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2015(n) the individual is ineligible for the month for child support arrears` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2015(n) the individual is ineligible for the month for child support arrears` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2015(n) the individual is ineligible for the month for child support arrears` FALSE TRUE FALSE FALSE EQUALS NOTHING

§ `Touching every constructor and field declared in snap2-2015e-n`
#ASSERT (`s 2015(e) test: facts` 25 TRUE FALSE FALSE FALSE FALSE (JUST FALSE) 0 FALSE FALSE 0 TRUE FALSE FALSE FALSE FALSE)'s `the individual is a single parent` EQUALS FALSE
#ASSERT `s 2015(h) not covered` EQUALS `s 2015(h) not covered`
#ASSERT `s 2015(j) not ineligible under this subsection` EQUALS `s 2015(j) not ineligible under this subsection`
