#ASSERT `s 2014(e)(5)(B)(ii)(III) further reporting or verification of the change may be required` FALSE EQUALS NOTHING
#ASSERT `s 2014(e)(5)(C) the expense is treated as a medical expense` TRUE EQUALS JUST FALSE
#ASSERT `s 2014(e)(5)(C) the expense is treated as a medical expense` FALSE EQUALS NOTHING

§ `s 2014(e)(6) tests`

-- (A): 50 percent of income after the other deductions; exactly at 50 percent is not "exceeds"
#ASSERT `s 2014(e)(6)(A) the excess shelter expense deduction before the maximum` 800 1000 EQUALS 300
#ASSERT `s 2014(e)(6)(A) the excess shelter expense deduction before the maximum` 400 1000 EQUALS 0
#ASSERT `s 2014(e)(6)(A) the excess shelter expense deduction before the maximum` 500 1000 EQUALS 0
#ASSERT `s 2014(e)(6)(A) the excess shelter expense deduction before the maximum` 501 1000 EQUALS 1
#ASSERT `s 2014(e)(6)(A) the excess shelter expense deduction before the maximum` 100 0 EQUALS 100

