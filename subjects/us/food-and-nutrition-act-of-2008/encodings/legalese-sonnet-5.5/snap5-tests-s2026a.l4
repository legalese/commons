IMPORT prelude
IMPORT daydate
IMPORT `snap5-s2026a`

-- TESTS for snap5-s2026a.l4 (section 2026a). Expected values written from the text before the file was run.

§ `s 2026a(a) fluid milk`

-- all four limbs (the fourth taken as three standards, FDA, State and local, all required: fork F-2 in NOTES.md)
#ASSERT `s 2026a(a) the product is fluid milk` TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- each limb failing alone is "not fluid milk" under "means"
#ASSERT `s 2026a(a) the product is fluid milk` FALSE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2026a(a) the product is fluid milk` TRUE FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2026a(a) the product is fluid milk` TRUE TRUE FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2026a(a) the product is fluid milk` TRUE TRUE TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2026a(a) the product is fluid milk` TRUE TRUE TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2026a(a) the product is fluid milk` TRUE TRUE TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2026a(a) the product is fluid milk` TRUE TRUE TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE

§ `s 2026a(b) projects`

#ASSERT `s 2026a(b) the project is a healthy fluid milk incentive project the Secretary is to carry out` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2026a(b) the project is a healthy fluid milk incentive project the Secretary is to carry out` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 2026a(b) the project is a healthy fluid milk incentive project the Secretary is to carry out` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 2026a(b) the project is a healthy fluid milk incentive project the Secretary is to carry out` TRUE TRUE FALSE EQUALS NOTHING

§ `s 2026a(c) grants or cooperative agreements`

#ASSERT `s 2026a(c)(1) the Secretary shall enter into the agreement with, or provide the grant to, the entity` `s 2026a(c) a governmental entity` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2026a(c)(1) the Secretary shall enter into the agreement with, or provide the grant to, the entity` `s 2026a(c) a nonprofit organization` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2026a(c)(1) the Secretary shall enter into the agreement with, or provide the grant to, the entity` `s 2026a(c) a nonprofit organization` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2026a(c)(1) the Secretary shall enter into the agreement with, or provide the grant to, the entity` `s 2026a(c) a governmental entity` TRUE FALSE EQUALS NOTHING
-- an entity of neither kind: the list is not closed
#ASSERT `s 2026a(c)(1) the Secretary shall enter into the agreement with, or provide the grant to, the entity` `s 2026a(c) any other entity` TRUE TRUE EQUALS NOTHING
#ASSERT `s 2026a(c)(2) the entity has met the application requirement` TRUE EQUALS JUST TRUE
#ASSERT `s 2026a(c)(2) the entity has met the application requirement` FALSE EQUALS JUST FALSE
#ASSERT `s 2026a(c)(3) the projects are evaluated against the required criteria` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2026a(c)(3) the projects are evaluated against the required criteria` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2026a(c)(3) the projects are evaluated against the required criteria` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2026a(c)(4) the funds made available under this section may be used for the project` TRUE EQUALS JUST FALSE
#ASSERT `s 2026a(c)(4) the funds made available under this section may be used for the project` FALSE EQUALS NOTHING

§ `s 2026a(d) evaluation and reporting`

#ASSERT `s 2026a(d)(1)(A)(i) the evaluation is the independent evaluation required` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2026a(d)(1)(A)(i) the evaluation is the independent evaluation required` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2026a(d)(1)(A)(i) the evaluation is the independent evaluation required` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2026a(d)(1)(A)(ii) the evaluation meets the requirement of rigorous methodologies` TRUE EQUALS JUST TRUE
#ASSERT `s 2026a(d)(1)(A)(ii) the evaluation meets the requirement of rigorous methodologies` FALSE EQUALS JUST FALSE
-- 7 percent of 1,000,000 is 70,000; edge: 70,000 is within the limit, 70,001 is not
#ASSERT `s 2026a(d)(1)(B) the amount used for evaluation is within the limit` 1_000_000 70_000 EQUALS JUST TRUE
#ASSERT `s 2026a(d)(1)(B) the amount used for evaluation is within the limit` 1_000_000 70_001 EQUALS JUST FALSE
#ASSERT `s 2026a(d)(1)(B) the amount used for evaluation is within the limit` 1_000_000 0 EQUALS JUST TRUE
-- December 31 of 2020 and biennially thereafter
#ASSERT `s 2026a(d)(2) the date by which the report is due in the year` 2020 EQUALS JUST (Date 31 12 2020)
#ASSERT `s 2026a(d)(2) the date by which the report is due in the year` 2022 EQUALS JUST (Date 31 12 2022)
#ASSERT `s 2026a(d)(2) the date by which the report is due in the year` 2030 EQUALS JUST (Date 31 12 2030)
#ASSERT `s 2026a(d)(2) the date by which the report is due in the year` 2021 EQUALS NOTHING
#ASSERT `s 2026a(d)(2) the date by which the report is due in the year` 2019 EQUALS NOTHING
#ASSERT `s 2026a(d)(2) the date by which the report is due in the year` 2018 EQUALS NOTHING
-- edge: 31 December is in time, 1 January of the next year is not
#ASSERT `s 2026a(d)(2) the report is submitted in time` 2020 (Date 31 12 2020) EQUALS JUST TRUE
#ASSERT `s 2026a(d)(2) the report is submitted in time` 2020 (Date 1 1 2021) EQUALS JUST FALSE
#ASSERT `s 2026a(d)(2) the report is submitted in time` 2024 (Date 1 6 2024) EQUALS JUST TRUE
#ASSERT `s 2026a(d)(2) the report is submitted in time` 2023 (Date 1 6 2023) EQUALS NOTHING
#ASSERT `s 2026a(d)(2) the report describes the matters required` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2026a(d)(2) the report describes the matters required` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2026a(d)(2) the report describes the matters required` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2026a(d)(2) the report describes the matters required` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2026a(d)(3) the evaluation results are shared as required` TRUE EQUALS JUST TRUE
#ASSERT `s 2026a(d)(3) the evaluation results are shared as required` FALSE EQUALS JUST FALSE

§ `s 2026a(e) funding`

#ASSERT `s 2026a(e)(1) the amount authorized to be appropriated, in dollars` EQUALS 20_000_000
#ASSERT `s 2026a(e)(2) the funds are available to carry out this section` TRUE EQUALS JUST TRUE
#ASSERT `s 2026a(e)(2) the funds are available to carry out this section` FALSE EQUALS JUST FALSE

