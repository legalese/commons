IMPORT prelude
IMPORT daydate
IMPORT `snap-core`
IMPORT `snap1-logic`
IMPORT `snap1-s2014-e2`
IMPORT `snap1-s2014-g`

-- Tests for 7 U.S.C. 2014(g). Expected values are written from the text before the code was run.

§ `s 2014(g)(1) tests`

-- Against one limit (3,000): "exceed" is strictly more; a resource that may count but is not shown to count leaves the answer open.
#ASSERT `s 2014(g)(1)(A) the resources exceed the limit` 3001 3001 3000 EQUALS JUST TRUE
#ASSERT `s 2014(g)(1)(A) the resources exceed the limit` 3000 3000 3000 EQUALS JUST FALSE
#ASSERT `s 2014(g)(1)(A) the resources exceed the limit` 2500 2500 3000 EQUALS JUST FALSE
#ASSERT `s 2014(g)(1)(A) the resources exceed the limit` 0 5000 3000 EQUALS NOTHING
#ASSERT `s 2014(g)(1)(A) the resources exceed the limit` 3001 9000 3000 EQUALS JUST TRUE
#ASSERT `s 2014(g)(1)(A) the resources exceed the limit` 0 3000 3000 EQUALS JUST FALSE
#ASSERT `s 2014(g)(1)(A) the resources exceed the limit` 0 3001 3000 EQUALS NOTHING
-- Which limit: arguments are shown, may, elderly or disabled (MAYBE), the lower limit (3,000), the higher limit (4,750).
#ASSERT `s 2014(g)(1)(A) the household is ineligible because its resources exceed the limit` 3500 3500 (JUST TRUE) 3000 4750 EQUALS JUST FALSE
#ASSERT `s 2014(g)(1)(A) the household is ineligible because its resources exceed the limit` 3500 3500 (JUST FALSE) 3000 4750 EQUALS JUST TRUE
#ASSERT `s 2014(g)(1)(A) the household is ineligible because its resources exceed the limit` 3500 3500 NOTHING 3000 4750 EQUALS NOTHING
#ASSERT `s 2014(g)(1)(A) the household is ineligible because its resources exceed the limit` 5000 5000 NOTHING 3000 4750 EQUALS JUST TRUE
#ASSERT `s 2014(g)(1)(A) the household is ineligible because its resources exceed the limit` 100 100 NOTHING 3000 4750 EQUALS JUST FALSE
#ASSERT `s 2014(g)(1)(A) the household is ineligible because its resources exceed the limit` 0 5000 NOTHING 3000 4750 EQUALS NOTHING
#ASSERT `s 2014(g)(1)(A) the household is ineligible because its resources exceed the limit` 0 3500 NOTHING 3000 4750 EQUALS NOTHING
#ASSERT `s 2014(g)(1)(A) the household is ineligible because its resources exceed the limit` 4750 4750 (JUST TRUE) 3000 4750 EQUALS JUST FALSE
#ASSERT `s 2014(g)(1)(A) the household is ineligible because its resources exceed the limit` 4751 4751 (JUST TRUE) 3000 4750 EQUALS JUST TRUE
-- The limits in force (the USDA's FY 2027 table: 3,000 and 4,750).
#ASSERT `s 2014(g)(1) the resource limit for the household` 2027 (JUST TRUE) EQUALS JUST 4750
#ASSERT `s 2014(g)(1) the resource limit for the household` 2027 (JUST FALSE) EQUALS JUST 3000
#ASSERT `s 2014(g)(1) the resource limit for the household` 2027 NOTHING EQUALS NOTHING
#ASSERT `s 2014(g)(1) the resource limit for the household` 2026 (JUST TRUE) EQUALS NOTHING
#ASSERT `s 2014(g)(1) the resource limit for the household` 2028 (JUST FALSE) EQUALS NOTHING
-- The adjustment: 3,000 grown by 5 percent is 3,150, which rounds down to 3,000; the rounding is to $250 steps.
#ASSERT `s 2014(g)(1)(B)(i) the adjusted amount before rounding` 3000 0.05 EQUALS 3150
#ASSERT `s 2014(g)(1)(B)(i) the adjusted amount rounded down to the nearest $250 increment` 3150 EQUALS 3000
#ASSERT `s 2014(g)(1)(B)(i) the adjusted amount rounded down to the nearest $250 increment` 3250 EQUALS 3250
#ASSERT `s 2014(g)(1)(B)(i) the adjusted amount rounded down to the nearest $250 increment` 3249.99 EQUALS 3000
#ASSERT `s 2014(g)(1)(B)(i) the adjusted amount rounded down to the nearest $250 increment` 3500 EQUALS 3500
#ASSERT `s 2014(g)(1)(B)(i) the adjusted amount rounded down to the nearest $250 increment` 249 EQUALS 0
-- (ii): the next year starts from the unrounded 3,150 (x 1.04 = 3,276, rounds to 3,250), not from the rounded 3,000 (x 1.04 = 3,120, rounds to 3,000).
#ASSERT `s 2014(g)(1)(B)(i) the adjusted amount rounded down to the nearest $250 increment` (`s 2014(g)(1)(B)(i) the adjusted amount before rounding` 3150 0.04) EQUALS 3250
#ASSERT `s 2014(g)(1)(B)(i) the adjusted amount rounded down to the nearest $250 increment` (`s 2014(g)(1)(B)(i) the adjusted amount before rounding` 3000 0.04) EQUALS 3000
#ASSERT `s 2014(g)(1)(B)(ii) the adjustment conforms` TRUE EQUALS JUST TRUE
#ASSERT `s 2014(g)(1)(B)(ii) the adjustment conforms` FALSE EQUALS NOTHING

-- The pair of totals. Five resources: counted by the text; not decided by the text; included and excluded at once; not excluded but not included; not included.
`s 2014(g) test resource counted` MEANS `s 2014(g) resource` WITH
    `s 2014(g) the value of the resource if it counts, in dollars` IS 500
    `s 2014(g) whether the text includes the resource` IS JUST TRUE
    `s 2014(g) whether the text excludes the resource` IS NOTHING
`s 2014(g) test resource undecided` MEANS `s 2014(g) resource` WITH
    `s 2014(g) the value of the resource if it counts, in dollars` IS 4000
    `s 2014(g) whether the text includes the resource` IS NOTHING
    `s 2014(g) whether the text excludes the resource` IS NOTHING
`s 2014(g) test resource included and excluded` MEANS `s 2014(g) resource` WITH
    `s 2014(g) the value of the resource if it counts, in dollars` IS 9000
    `s 2014(g) whether the text includes the resource` IS JUST TRUE
    `s 2014(g) whether the text excludes the resource` IS JUST TRUE
`s 2014(g) test resource not excluded` MEANS `s 2014(g) resource` WITH
    `s 2014(g) the value of the resource if it counts, in dollars` IS 1200
    `s 2014(g) whether the text includes the resource` IS NOTHING
    `s 2014(g) whether the text excludes the resource` IS JUST FALSE
`s 2014(g) test resource not included` MEANS `s 2014(g) resource` WITH
    `s 2014(g) the value of the resource if it counts, in dollars` IS 700
    `s 2014(g) whether the text includes the resource` IS JUST FALSE
    `s 2014(g) whether the text excludes the resource` IS NOTHING

#ASSERT `s 2014(g)(1) the value of the resource that is shown to count` `s 2014(g) test resource counted` EQUALS 500
#ASSERT `s 2014(g)(1) the value of the resource that may count` `s 2014(g) test resource counted` EQUALS 500
#ASSERT `s 2014(g)(1) the value of the resource that is shown to count` `s 2014(g) test resource undecided` EQUALS 0
#ASSERT `s 2014(g)(1) the value of the resource that may count` `s 2014(g) test resource undecided` EQUALS 4000
#ASSERT `s 2014(g)(1) the value of the resource that is shown to count` `s 2014(g) test resource included and excluded` EQUALS 0
#ASSERT `s 2014(g)(1) the value of the resource that may count` `s 2014(g) test resource included and excluded` EQUALS 0
#ASSERT `s 2014(g)(1) the value of the resource that is shown to count` `s 2014(g) test resource not excluded` EQUALS 0
#ASSERT `s 2014(g)(1) the value of the resource that may count` `s 2014(g) test resource not excluded` EQUALS 1200
#ASSERT `s 2014(g)(1) the value of the resource that is shown to count` `s 2014(g) test resource not included` EQUALS 0
#ASSERT `s 2014(g)(1) the value of the resource that may count` `s 2014(g) test resource not included` EQUALS 0
#ASSERT `s 2014(g)(1) the total value of the resources shown to count` (LIST `s 2014(g) test resource counted`, `s 2014(g) test resource undecided`, `s 2014(g) test resource included and excluded`, `s 2014(g) test resource not excluded`, `s 2014(g) test resource not included`) EQUALS 500
#ASSERT `s 2014(g)(1) the total value of the resources that may count` (LIST `s 2014(g) test resource counted`, `s 2014(g) test resource undecided`, `s 2014(g) test resource included and excluded`, `s 2014(g) test resource not excluded`, `s 2014(g) test resource not included`) EQUALS 5700
#ASSERT `s 2014(g)(1) the total value of the resources shown to count` EMPTY EQUALS 0

§ `s 2014(g)(2) tests`

-- (A): a licensed vehicle and an inaccessible resource are not the regulations' business; the rest takes the answer of the regulations of 1 June 1982.
#ASSERT `s 2014(g)(2)(A) the resource is included in financial resources by the regulations in force as of June 1, 1982` TRUE FALSE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 2014(g)(2)(A) the resource is included in financial resources by the regulations in force as of June 1, 1982` FALSE TRUE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 2014(g)(2)(A) the resource is included in financial resources by the regulations in force as of June 1, 1982` FALSE FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2014(g)(2)(A) the resource is included in financial resources by the regulations in force as of June 1, 1982` FALSE FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2014(g)(2)(A) the resource is included in financial resources by the regulations in force as of June 1, 1982` FALSE FALSE NOTHING EQUALS NOTHING
-- (B)(i) to (v)
#ASSERT `s 2014(g)(2)(B)(i) the resource is included in financial resources` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2014(g)(2)(B)(i) the resource is included in financial resources` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2014(g)(2)(B)(i) the resource is included in financial resources` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2014(g)(2)(B)(ii) the resource is included in financial resources` TRUE EQUALS JUST TRUE
#ASSERT `s 2014(g)(2)(B)(ii) the resource is included in financial resources` FALSE EQUALS NOTHING
#ASSERT `s 2014(g)(2)(B)(iii) the resource is included in financial resources` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2014(g)(2)(B)(iii) the resource is included in financial resources` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2014(g)(2)(B)(iii) the resource is included in financial resources` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2014(g)(2)(B)(v) the resource is included in financial resources` TRUE EQUALS JUST TRUE
#ASSERT `s 2014(g)(2)(B)(v) the resource is included in financial resources` FALSE EQUALS NOTHING
-- (C): each of the three limbs excludes; none leaves it open; related property follows an excluded vehicle only.
#ASSERT `s 2014(g)(2)(C) the vehicle is included in financial resources under paragraph (2)` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2014(g)(2)(C) the vehicle is included in financial resources under paragraph (2)` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2014(g)(2)(C) the vehicle is included in financial resources under paragraph (2)` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2014(g)(2)(C) the vehicle is included in financial resources under paragraph (2)` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 2014(g)(2)(C) the property related to the vehicle is included in financial resources under paragraph (2)` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2014(g)(2)(C) the property related to the vehicle is included in financial resources under paragraph (2)` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2014(g)(2)(C) the property related to the vehicle is included in financial resources under paragraph (2)` FALSE TRUE EQUALS NOTHING
-- (D)
#ASSERT `s 2014(g)(2)(D) the State agency may apply the State vehicle allowance standards to the household` TRUE EQUALS JUST TRUE
#ASSERT `s 2014(g)(2)(D) the State agency may apply the State vehicle allowance standards to the household` FALSE EQUALS JUST FALSE
-- (B)(iv): arguments are used, excluded under (C), State agency elected, lower under State standards, the State attribution, the fair market value.
#ASSERT `s 2014(g)(2)(B)(iv) the value of the vehicle that counts as a resource` TRUE FALSE FALSE FALSE 0 10000 EQUALS JUST 5350
#ASSERT `s 2014(g)(2)(B)(iv) the value of the vehicle that counts as a resource` TRUE FALSE FALSE FALSE 0 4651 EQUALS JUST 1
#ASSERT `s 2014(g)(2)(B)(iv) the value of the vehicle that counts as a resource` TRUE FALSE FALSE FALSE 0 4650 EQUALS JUST 0
#ASSERT `s 2014(g)(2)(B)(iv) the value of the vehicle that counts as a resource` TRUE FALSE FALSE FALSE 0 4000 EQUALS JUST 0
#ASSERT `s 2014(g)(2)(B)(iv) the value of the vehicle that counts as a resource` TRUE TRUE FALSE FALSE 0 10000 EQUALS JUST 0
#ASSERT `s 2014(g)(2)(B)(iv) the value of the vehicle that counts as a resource` FALSE TRUE FALSE FALSE 0 10000 EQUALS JUST 0
#ASSERT `s 2014(g)(2)(B)(iv) the value of the vehicle that counts as a resource` FALSE FALSE FALSE FALSE 0 10000 EQUALS NOTHING
#ASSERT `s 2014(g)(2)(B)(iv) the value of the vehicle that counts as a resource` TRUE FALSE TRUE TRUE 2000 10000 EQUALS JUST 2000
#ASSERT `s 2014(g)(2)(B)(iv) the value of the vehicle that counts as a resource` TRUE FALSE TRUE FALSE 2000 10000 EQUALS JUST 5350
#ASSERT `s 2014(g)(2)(B)(iv) the value of the vehicle that counts as a resource` TRUE FALSE FALSE TRUE 2000 10000 EQUALS JUST 5350

§ `s 2014(g)(3) to (8) tests`

#ASSERT `s 2014(g)(3) the burial plot is excluded from financial resources` TRUE EQUALS JUST TRUE
#ASSERT `s 2014(g)(3) the burial plot is excluded from financial resources` FALSE EQUALS NOTHING
#ASSERT `s 2014(g)(3) the nonliquid resource for the plan is excluded from financial resources` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2014(g)(3) the nonliquid resource for the plan is excluded from financial resources` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 2014(g)(3) the nonliquid resource for the plan is excluded from financial resources` TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 2014(g)(3) the nonliquid resource for the plan is excluded from financial resources` TRUE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 2014(g)(3) the nonliquid resource for the plan is excluded from financial resources` TRUE TRUE TRUE FALSE EQUALS NOTHING
-- The earned income tax credit, received on 15 March 2026: 12 months run to the day before 15 March 2027.
#ASSERT `s 2014(g)(3) the earned income tax credit is excluded from financial resources` TRUE TRUE TRUE (Date 15 3 2026) (Date 15 3 2026) EQUALS JUST TRUE
#ASSERT `s 2014(g)(3) the earned income tax credit is excluded from financial resources` TRUE TRUE TRUE (Date 15 3 2026) (Date 14 3 2027) EQUALS JUST TRUE
#ASSERT `s 2014(g)(3) the earned income tax credit is excluded from financial resources` TRUE TRUE TRUE (Date 15 3 2026) (Date 15 3 2027) EQUALS NOTHING
#ASSERT `s 2014(g)(3) the earned income tax credit is excluded from financial resources` TRUE TRUE TRUE (Date 15 3 2026) (Date 14 3 2026) EQUALS NOTHING
#ASSERT `s 2014(g)(3) the earned income tax credit is excluded from financial resources` TRUE FALSE TRUE (Date 15 3 2026) (Date 1 6 2026) EQUALS JUST FALSE
#ASSERT `s 2014(g)(3) the earned income tax credit is excluded from financial resources` TRUE TRUE FALSE (Date 15 3 2026) (Date 1 6 2026) EQUALS JUST FALSE
#ASSERT `s 2014(g)(3) the earned income tax credit is excluded from financial resources` FALSE TRUE TRUE (Date 15 3 2026) (Date 1 6 2026) EQUALS NOTHING
-- Farm property, the member ceased on 1 June 2026: the 1-year period runs to 31 May 2027.
#ASSERT `s 2014(g)(4) the farm property is excluded from financial resources` TRUE TRUE (Date 1 6 2026) (Date 1 6 2030) EQUALS JUST TRUE
#ASSERT `s 2014(g)(4) the farm property is excluded from financial resources` TRUE FALSE (Date 1 6 2026) (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `s 2014(g)(4) the farm property is excluded from financial resources` TRUE FALSE (Date 1 6 2026) (Date 31 5 2027) EQUALS JUST TRUE
#ASSERT `s 2014(g)(4) the farm property is excluded from financial resources` TRUE FALSE (Date 1 6 2026) (Date 1 6 2027) EQUALS NOTHING
#ASSERT `s 2014(g)(4) the farm property is excluded from financial resources` TRUE FALSE (Date 1 6 2026) (Date 31 5 2026) EQUALS NOTHING
#ASSERT `s 2014(g)(4) the farm property is excluded from financial resources` FALSE TRUE (Date 1 6 2026) (Date 1 6 2026) EQUALS NOTHING
-- (5)
#ASSERT `s 2014(g)(5) the resource is excluded as an inaccessible resource` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2014(g)(5) the resource is excluded as an inaccessible resource` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 2014(g)(5) the resource is excluded as an inaccessible resource` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2014(g)(5) the Secretary may require the State agency to require verification of the value of the resource` FALSE EQUALS JUST FALSE
#ASSERT `s 2014(g)(5) the Secretary may require the State agency to require verification of the value of the resource` TRUE EQUALS NOTHING
-- (6): arguments are no cash assistance, no medical assistance, cash, licensed vehicle, readily available account, similar type, excluded under another paragraph.
#ASSERT `s 2014(g)(6) the State agency may exclude the type of resource` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2014(g)(6) the State agency may exclude the type of resource` FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2014(g)(6) the State agency may exclude the type of resource` FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 2014(g)(6) the State agency may exclude the type of resource` TRUE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2014(g)(6) the State agency may exclude the type of resource` TRUE TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2014(g)(6) the State agency may exclude the type of resource` TRUE TRUE FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2014(g)(6) the State agency may exclude the type of resource` TRUE TRUE FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2014(g)(6) the State agency may exclude the type of resource` TRUE TRUE TRUE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 2014(g)(6) the State agency may exclude the type of resource` FALSE FALSE TRUE FALSE FALSE FALSE TRUE EQUALS NOTHING
-- (7) and (8)
#ASSERT `s 2014(g)(7)(A) the retirement funds are excluded from financial resources` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2014(g)(7)(A) the retirement funds are excluded from financial resources` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 2014(g)(7)(A) the retirement funds are excluded from financial resources` FALSE FALSE EQUALS NOTHING
#ASSERT `s 2014(g)(7)(B) the Secretary may exclude the retirement plan, contract, or account` TRUE EQUALS JUST TRUE
#ASSERT `s 2014(g)(7)(B) the Secretary may exclude the retirement plan, contract, or account` FALSE EQUALS NOTHING
#ASSERT `s 2014(g)(8)(A) the education funds are excluded from financial resources` TRUE EQUALS JUST TRUE
#ASSERT `s 2014(g)(8)(A) the education funds are excluded from financial resources` FALSE EQUALS NOTHING
#ASSERT `s 2014(g)(8)(B) the Secretary may exclude the education program, contract, or account` TRUE EQUALS JUST TRUE
#ASSERT `s 2014(g)(8)(B) the Secretary may exclude the education program, contract, or account` FALSE EQUALS NOTHING
