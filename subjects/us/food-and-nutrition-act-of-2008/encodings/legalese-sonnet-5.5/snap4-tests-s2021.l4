IMPORT prelude
IMPORT `snap-core`
IMPORT `snap4-s2021`

-- Tests for snap4-s2021.l4. Every expected value is written from the text of lines 1702-1793 BEFORE running.
-- A failing assertion is a finding: no expected value here was edited to match the code.

§ `tests -- s 2021(a)`

-- (a)(1): "may be" disqualified, fined up to $100,000, or both; other sanctions are not named; the seller must be approved and in violation.
#ASSERT `s 2021(a)(1) the seller may be subjected to the sanction` (JUST TRUE) TRUE `s 2021(a)(1)(A) disqualification for a specified period of time from further participation` EQUALS JUST TRUE
#ASSERT `s 2021(a)(1) the seller may be subjected to the sanction` (JUST TRUE) TRUE `s 2021(a)(1)(B) a civil penalty of up to $100,000 for each violation` EQUALS JUST TRUE
#ASSERT `s 2021(a)(1) the seller may be subjected to the sanction` (JUST TRUE) TRUE `s 2021(a)(1)(C) both` EQUALS JUST TRUE
#ASSERT `s 2021(a)(1) the seller may be subjected to the sanction` (JUST TRUE) TRUE `s 2021(a)(1) some other sanction` EQUALS NOTHING
#ASSERT `s 2021(a)(1) the seller may be subjected to the sanction` (JUST FALSE) TRUE `s 2021(a)(1)(C) both` EQUALS NOTHING
#ASSERT `s 2021(a)(1) the seller may be subjected to the sanction` (JUST TRUE) FALSE `s 2021(a)(1)(C) both` EQUALS NOTHING
#ASSERT `s 2021(a)(1) the seller may be subjected to the sanction` NOTHING TRUE `s 2021(a)(1)(C) both` EQUALS NOTHING

-- (a)(1)(B): up to $100,000 for each violation.
#ASSERT `s 2021(a)(1)(B) the civil penalty for each violation is within the limit` 100000 EQUALS JUST TRUE
#ASSERT `s 2021(a)(1)(B) the civil penalty for each violation is within the limit` 99999 EQUALS JUST TRUE
#ASSERT `s 2021(a)(1)(B) the civil penalty for each violation is within the limit` 100001 EQUALS JUST FALSE
#ASSERT `s 2021(a)(1)(B) the civil penalty for each violation is within the limit` 0 EQUALS JUST TRUE

-- (a)(2): evidence "may include" three named kinds; any other kind is not settled by the text.
#ASSERT `s 2021(a)(2) the finding of a violation may rest on the evidence` `s 2021(a)(2) facts established through on-site investigations` EQUALS JUST TRUE
#ASSERT `s 2021(a)(2) the finding of a violation may rest on the evidence` `s 2021(a)(2) inconsistent redemption data` EQUALS JUST TRUE
#ASSERT `s 2021(a)(2) the finding of a violation may rest on the evidence` `s 2021(a)(2) evidence obtained through a transaction report under an electronic benefit transfer system` EQUALS JUST TRUE
#ASSERT `s 2021(a)(2) the finding of a violation may rest on the evidence` `s 2021(a)(2) any other evidence` EQUALS NOTHING

§ `tests -- s 2021(b)`

-- (b)(1)-(2): first occasion up to 5 years, second up to 10; (b)(3)(A): third and later, permanent.
#ASSERT `s 2021(b) the disqualification the text requires` 1 FALSE FALSE FALSE EQUALS JUST (`s 2021(b) a reasonable period of time not exceeding the maximum` 5)
#ASSERT `s 2021(b) the disqualification the text requires` 2 FALSE FALSE FALSE EQUALS JUST (`s 2021(b) a reasonable period of time not exceeding the maximum` 10)
#ASSERT `s 2021(b) the disqualification the text requires` 3 FALSE FALSE FALSE EQUALS JUST `s 2021(b) permanent`
#ASSERT `s 2021(b) the disqualification the text requires` 4 FALSE FALSE FALSE EQUALS JUST `s 2021(b) permanent`
-- The text counts occasions from the first: an occasion numbered 0 is not spoken of.
#ASSERT `s 2021(b) the disqualification the text requires` 0 FALSE FALSE FALSE EQUALS NOTHING

-- (b)(3)(B): trafficking, or unauthorized use of EBT cards, is permanent from the first occasion; (b)(3)(C): firearms etc. likewise.
#ASSERT `s 2021(b) the disqualification the text requires` 1 TRUE FALSE FALSE EQUALS JUST `s 2021(b) permanent`
#ASSERT `s 2021(b) the disqualification the text requires` 2 TRUE FALSE FALSE EQUALS JUST `s 2021(b) permanent`
#ASSERT `s 2021(b) the disqualification the text requires` 1 FALSE TRUE FALSE EQUALS JUST `s 2021(b) permanent`
#ASSERT `s 2021(b) the disqualification the text requires` 2 FALSE TRUE FALSE EQUALS JUST `s 2021(b) permanent`

-- (b)(4): a false application, a period for the Secretary to determine (fork F-2 for the first and second occasions); a third occasion is permanent by (b)(3)(A).
#ASSERT `s 2021(b) the disqualification the text requires` 1 FALSE FALSE TRUE EQUALS JUST `s 2021(b)(4) a reasonable period of time determined by the Secretary, including permanent`
#ASSERT `s 2021(b) the disqualification the text requires` 2 FALSE FALSE TRUE EQUALS JUST `s 2021(b)(4) a reasonable period of time determined by the Secretary, including permanent`
#ASSERT `s 2021(b) the disqualification the text requires` 3 FALSE FALSE TRUE EQUALS JUST `s 2021(b) permanent`

-- The period actually imposed, against what the text requires. First occasion: reasonable, not over 5 years.
#ASSERT `s 2021(b) the period imposed is allowed` 1 FALSE FALSE FALSE TRUE (`for a number of years` 5) EQUALS JUST TRUE
#ASSERT `s 2021(b) the period imposed is allowed` 1 FALSE FALSE FALSE TRUE (`for a number of years` 6) EQUALS JUST FALSE
#ASSERT `s 2021(b) the period imposed is allowed` 1 FALSE FALSE FALSE TRUE (`for a number of months` 60) EQUALS JUST TRUE
#ASSERT `s 2021(b) the period imposed is allowed` 1 FALSE FALSE FALSE TRUE (`for a number of months` 61) EQUALS JUST FALSE
#ASSERT `s 2021(b) the period imposed is allowed` 1 FALSE FALSE FALSE TRUE `permanently` EQUALS JUST FALSE
#ASSERT `s 2021(b) the period imposed is allowed` 1 FALSE FALSE FALSE FALSE (`for a number of years` 1) EQUALS JUST FALSE
-- Days: up to 5 x 365 = 1825 always fit; over 5 x 366 + 1 = 1831 never fit; between, it depends on the day the disqualification begins.
#ASSERT `s 2021(b) the period imposed is allowed` 1 FALSE FALSE FALSE TRUE (`for a number of days` 30) EQUALS JUST TRUE
#ASSERT `s 2021(b) the period imposed is allowed` 1 FALSE FALSE FALSE TRUE (`for a number of days` 1825) EQUALS JUST TRUE
#ASSERT `s 2021(b) the period imposed is allowed` 1 FALSE FALSE FALSE TRUE (`for a number of days` 1826) EQUALS NOTHING
#ASSERT `s 2021(b) the period imposed is allowed` 1 FALSE FALSE FALSE TRUE (`for a number of days` 1831) EQUALS NOTHING
#ASSERT `s 2021(b) the period imposed is allowed` 1 FALSE FALSE FALSE TRUE (`for a number of days` 1832) EQUALS JUST FALSE
-- A period the text hands to someone else is not covered.
#ASSERT `s 2021(b) the period imposed is allowed` 1 FALSE FALSE FALSE TRUE (`until a stated condition ends` "the store pays the penalty") EQUALS NOTHING
#ASSERT `s 2021(b) the period imposed is allowed` 1 FALSE FALSE FALSE TRUE `for a period the Secretary prescribes by regulation, not stated in this text` EQUALS NOTHING
#ASSERT `s 2021(b) the period imposed is allowed` 1 FALSE FALSE FALSE TRUE `for a period the State agency determines, not stated in this text` EQUALS NOTHING
-- Second occasion: not over 10 years.
#ASSERT `s 2021(b) the period imposed is allowed` 2 FALSE FALSE FALSE TRUE (`for a number of years` 10) EQUALS JUST TRUE
#ASSERT `s 2021(b) the period imposed is allowed` 2 FALSE FALSE FALSE TRUE (`for a number of years` 11) EQUALS JUST FALSE
#ASSERT `s 2021(b) the period imposed is allowed` 2 FALSE FALSE FALSE TRUE (`for a number of months` 120) EQUALS JUST TRUE
#ASSERT `s 2021(b) the period imposed is allowed` 2 FALSE FALSE FALSE TRUE (`for a number of days` 3650) EQUALS JUST TRUE
#ASSERT `s 2021(b) the period imposed is allowed` 2 FALSE FALSE FALSE TRUE (`for a number of days` 3662) EQUALS JUST FALSE
#ASSERT `s 2021(b) the period imposed is allowed` 2 FALSE FALSE FALSE TRUE `permanently` EQUALS JUST FALSE
-- Third occasion, and the two permanent grounds: only permanent will do.
#ASSERT `s 2021(b) the period imposed is allowed` 3 FALSE FALSE FALSE TRUE `permanently` EQUALS JUST TRUE
#ASSERT `s 2021(b) the period imposed is allowed` 3 FALSE FALSE FALSE TRUE (`for a number of years` 20) EQUALS JUST FALSE
#ASSERT `s 2021(b) the period imposed is allowed` 3 FALSE FALSE FALSE TRUE (`for a number of months` 6) EQUALS JUST FALSE
#ASSERT `s 2021(b) the period imposed is allowed` 3 FALSE FALSE FALSE TRUE (`for a number of days` 100) EQUALS JUST FALSE
#ASSERT `s 2021(b) the period imposed is allowed` 1 TRUE FALSE FALSE TRUE `permanently` EQUALS JUST TRUE
#ASSERT `s 2021(b) the period imposed is allowed` 1 TRUE FALSE FALSE TRUE (`for a number of years` 5) EQUALS JUST FALSE
#ASSERT `s 2021(b) the period imposed is allowed` 1 FALSE TRUE FALSE TRUE `permanently` EQUALS JUST TRUE
#ASSERT `s 2021(b) the period imposed is allowed` 1 FALSE TRUE FALSE TRUE (`for a number of years` 5) EQUALS JUST FALSE
-- (b)(4): any reasonable period, permanent included; an unreasonable one is not allowed.
#ASSERT `s 2021(b) the period imposed is allowed` 1 FALSE FALSE TRUE TRUE `permanently` EQUALS JUST TRUE
#ASSERT `s 2021(b) the period imposed is allowed` 1 FALSE FALSE TRUE TRUE (`for a number of years` 30) EQUALS JUST TRUE
#ASSERT `s 2021(b) the period imposed is allowed` 1 FALSE FALSE TRUE TRUE (`for a number of months` 7) EQUALS JUST TRUE
#ASSERT `s 2021(b) the period imposed is allowed` 1 FALSE FALSE TRUE TRUE (`for a number of days` 3) EQUALS JUST TRUE
#ASSERT `s 2021(b) the period imposed is allowed` 1 FALSE FALSE TRUE FALSE `permanently` EQUALS JUST FALSE
#ASSERT `s 2021(b) the period imposed is allowed` 1 FALSE FALSE TRUE TRUE `for a period the Secretary prescribes by regulation, not stated in this text` EQUALS NOTHING
-- An occasion the text does not count: no disqualification is required, so none is judged.
#ASSERT `s 2021(b) the period imposed is allowed` 0 FALSE FALSE FALSE TRUE (`for a number of years` 1) EQUALS NOTHING

-- (b)(3)(B): civil penalty in lieu of permanent disqualification for trafficking.
-- Arguments: the violation is a purchase or trafficking; the Secretary's determination; ownership evidence; management evidence.
#ASSERT `s 2021(b)(3)(B) the Secretary may impose a civil penalty in lieu of permanent disqualification` TRUE (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2021(b)(3)(B) the Secretary may impose a civil penalty in lieu of permanent disqualification` TRUE (JUST TRUE) TRUE FALSE EQUALS NOTHING
#ASSERT `s 2021(b)(3)(B) the Secretary may impose a civil penalty in lieu of permanent disqualification` TRUE (JUST TRUE) FALSE TRUE EQUALS NOTHING
#ASSERT `s 2021(b)(3)(B) the Secretary may impose a civil penalty in lieu of permanent disqualification` TRUE (JUST FALSE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2021(b)(3)(B) the Secretary may impose a civil penalty in lieu of permanent disqualification` TRUE NOTHING TRUE TRUE EQUALS NOTHING
#ASSERT `s 2021(b)(3)(B) the Secretary may impose a civil penalty in lieu of permanent disqualification` FALSE (JUST TRUE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 2021(b)(3)(B) the Secretary may impose a civil penalty in lieu of permanent disqualification` FALSE (JUST FALSE) TRUE TRUE EQUALS NOTHING
-- Up to $20,000 a violation, and $40,000 for the violations of a single investigation.
#ASSERT `s 2021(b)(3)(B) the civil penalty in lieu of disqualification is within the limits` 20000 40000 EQUALS JUST TRUE
#ASSERT `s 2021(b)(3)(B) the civil penalty in lieu of disqualification is within the limits` 20001 40000 EQUALS JUST FALSE
#ASSERT `s 2021(b)(3)(B) the civil penalty in lieu of disqualification is within the limits` 20000 40001 EQUALS JUST FALSE
#ASSERT `s 2021(b)(3)(B) the civil penalty in lieu of disqualification is within the limits` 0 0 EQUALS JUST TRUE

-- (b)(3)(C): firearms, ammunition, explosives, controlled substances.
#ASSERT `s 2021(b)(3)(C) the Secretary may impose a civil penalty in lieu of permanent disqualification` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 2021(b)(3)(C) the Secretary may impose a civil penalty in lieu of permanent disqualification` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 2021(b)(3)(C) the Secretary may impose a civil penalty in lieu of permanent disqualification` (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 2021(b)(3)(C) the Secretary may impose a civil penalty in lieu of permanent disqualification` NOTHING TRUE EQUALS NOTHING
#ASSERT `s 2021(b)(3)(C) the civil penalty in lieu of disqualification is within the limits` 20000 40000 EQUALS JUST TRUE
#ASSERT `s 2021(b)(3)(C) the civil penalty in lieu of disqualification is within the limits` 20001 40000 EQUALS JUST FALSE
#ASSERT `s 2021(b)(3)(C) the civil penalty in lieu of disqualification is within the limits` 20000 40001 EQUALS JUST FALSE

§ `tests -- s 2021(c)`

-- (c)(1): in addition to a disqualification, a penalty not over $100,000 for each violation.
#ASSERT `s 2021(c)(1) the Secretary may assess the civil penalty in addition to a disqualification` 100000 EQUALS JUST TRUE
#ASSERT `s 2021(c)(1) the Secretary may assess the civil penalty in addition to a disqualification` 100001 EQUALS JUST FALSE
-- (c)(2): both actions are reviewable under section 2023; no other action is named.
