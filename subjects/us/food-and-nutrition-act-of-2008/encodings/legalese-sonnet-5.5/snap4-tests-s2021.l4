#ASSERT `s 2021(d)(4) the amount of the bond the store or concern forfeits to the Secretary` (JUST TRUE) 300 1000 EQUALS JUST 300
#ASSERT `s 2021(d)(4) the amount of the bond the store or concern forfeits to the Secretary` (JUST TRUE) 1000 1000 EQUALS JUST 1000
#ASSERT `s 2021(d)(4) the amount of the bond the store or concern forfeits to the Secretary` (JUST TRUE) 1500 1000 EQUALS NOTHING
#ASSERT `s 2021(d)(4) the amount of the bond the store or concern forfeits to the Secretary` (JUST FALSE) 300 1000 EQUALS NOTHING
#ASSERT `s 2021(d)(4) the amount of the bond the store or concern forfeits to the Secretary` NOTHING 300 1000 EQUALS NOTHING
-- (d)(5): a hearing on the forfeiture pursuant to section 2023.
#ASSERT `s 2021(d)(5) the store or concern may obtain a hearing on the forfeiture pursuant to section 2023` TRUE EQUALS JUST TRUE
#ASSERT `s 2021(d)(5) the store or concern may obtain a hearing on the forfeiture pursuant to section 2023` FALSE EQUALS NOTHING

§ `tests -- s 2021(e)`

-- (e)(1): a disqualified store or concern is sold or its ownership transferred.
#ASSERT `s 2021(e)(1) the persons who transfer ownership must be subjected to a civil penalty` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2021(e)(1) the persons who transfer ownership must be subjected to a civil penalty` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2021(e)(1) the persons who transfer ownership must be subjected to a civil penalty` FALSE TRUE EQUALS NOTHING
-- A permanent disqualification: double the ten-year penalty.
#ASSERT `s 2021(e)(1) the civil penalty when the store or concern has been disqualified permanently` TRUE 500 EQUALS JUST 1000
#ASSERT `s 2021(e)(1) the civil penalty when the store or concern has been disqualified permanently` TRUE 0 EQUALS JUST 0
#ASSERT `s 2021(e)(1) the civil penalty when the store or concern has been disqualified permanently` FALSE 500 EQUALS NOTHING
-- The disqualification period continues in effect for those who transferred ownership.
#ASSERT `s 2021(e)(1) the disqualification period continues in effect as to the persons who transferred ownership` TRUE EQUALS JUST TRUE
#ASSERT `s 2021(e)(1) the disqualification period continues in effect as to the persons who transferred ownership` FALSE EQUALS NOTHING
-- (e)(2): after the penalty is final, the Secretary may ask the Attorney General to sue; the penalty is then not open to review.
#ASSERT `s 2021(e)(2) the Secretary may request the Attorney General to institute a civil action to collect the penalty` TRUE EQUALS JUST TRUE
#ASSERT `s 2021(e)(2) the Secretary may request the Attorney General to institute a civil action to collect the penalty` FALSE EQUALS NOTHING
#ASSERT `s 2021(e)(2) the validity and amount of the penalty are subject to review in the action` TRUE EQUALS JUST FALSE
#ASSERT `s 2021(e)(2) the validity and amount of the penalty are subject to review in the action` FALSE EQUALS NOTHING
-- (e)(3): a fine for loose coupons, other than the denomination used for making change.
#ASSERT `s 2021(e)(3) the Secretary may impose a fine against the store or concern` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2021(e)(3) the Secretary may impose a fine against the store or concern` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2021(e)(3) the Secretary may impose a fine against the store or concern` FALSE FALSE EQUALS NOTHING
#ASSERT `s 2021(e)(3) the Secretary may impose a fine against the store or concern` FALSE TRUE EQUALS NOTHING

