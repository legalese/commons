IMPORT prelude
IMPORT daydate
IMPORT `snap5-s2025-c2`

-- TESTS for snap5-s2025-c2.l4 (section 2025(c)(2) to (9)). Expected values written from the text before the file was run.

§ `s 2025(c)(2) error rate definitions`

-- the sum of the point estimates: 0.03 PLUS 0.02 is 0.05
#ASSERT `s 2025(c)(2)(A) the payment error rate` 0.03 0.02 EQUALS 0.05
#ASSERT `s 2025(c)(2)(A) the payment error rate` 0 0 EQUALS 0
-- overpayments: (30 + 20) / 1,000 is 0.05
#ASSERT `s 2025(c)(2)(B) the overpayment error rate` 1_000 30 20 EQUALS JUST 0.05
#ASSERT `s 2025(c)(2)(B) the overpayment error rate` 1_000 0 0 EQUALS JUST 0
#ASSERT `s 2025(c)(2)(B) the overpayment error rate` 0 0 0 EQUALS NOTHING
#ASSERT `s 2025(c)(2)(B) the overpayment error rate` (0 MINUS 1) 0 0 EQUALS NOTHING
-- underpayments: 15 / 1,000 is 0.015
#ASSERT `s 2025(c)(2)(C) the underpayment error rate` 15 1_000 EQUALS JUST 0.015
#ASSERT `s 2025(c)(2)(C) the underpayment error rate` 15 0 EQUALS NOTHING

§ `s 2025(c)(3) exclusions`

-- 1 January 2024 plus 120 days is 30 April 2024 (a leap year: 31 January +30, 29 February +59, 31 March +90, 30 April +120); edge on the last day
#ASSERT `s 2025(c)(3)(A) the error is excluded from the payment error rate` TRUE (Date 1 1 2024) (Date 1 1 2024) EQUALS JUST TRUE
#ASSERT `s 2025(c)(3)(A) the error is excluded from the payment error rate` TRUE (Date 30 4 2024) (Date 1 1 2024) EQUALS JUST TRUE
#ASSERT `s 2025(c)(3)(A) the error is excluded from the payment error rate` TRUE (Date 1 5 2024) (Date 1 1 2024) EQUALS NOTHING
#ASSERT `s 2025(c)(3)(A) the error is excluded from the payment error rate` TRUE (Date 31 12 2023) (Date 1 1 2024) EQUALS NOTHING
#ASSERT `s 2025(c)(3)(A) the error is excluded from the payment error rate` FALSE (Date 1 2 2024) (Date 1 1 2024) EQUALS NOTHING
#ASSERT `s 2025(c)(3)(B) the error is excluded from the payment error rate` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2025(c)(3)(B) the error is excluded from the payment error rate` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 2025(c)(3)(B) the error is excluded from the payment error rate` FALSE FALSE EQUALS NOTHING

§ `s 2025(c)(4) to (5) reporting and procedures`

#ASSERT `s 2025(c)(4) the Secretary may require the State agency to report the factor` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 2025(c)(4) the Secretary may require the State agency to report the factor` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 2025(c)(4) the Secretary may require the State agency to report the factor` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 2025(c)(4) the Secretary may require the State agency to report the factor` NOTHING TRUE EQUALS NOTHING
#ASSERT `s 2025(c)(4) the Secretary shall base the determination on all pertinent information available` TRUE EQUALS JUST TRUE
#ASSERT `s 2025(c)(4) the Secretary shall base the determination on all pertinent information available` FALSE EQUALS NOTHING
#ASSERT `s 2025(c)(5) the State agency has submitted the data as required` TRUE EQUALS JUST TRUE
#ASSERT `s 2025(c)(5) the State agency has submitted the data as required` FALSE EQUALS JUST FALSE
-- before the end of the fiscal year following; edge on the last day
#ASSERT `s 2025(c)(5) the collection efforts are initiated in time` TRUE (Date 30 9 2027) (Date 30 9 2027) EQUALS JUST TRUE
#ASSERT `s 2025(c)(5) the collection efforts are initiated in time` TRUE (Date 1 10 2027) (Date 30 9 2027) EQUALS JUST FALSE
#ASSERT `s 2025(c)(5) the collection efforts are initiated in time` FALSE (Date 1 10 2027) (Date 30 9 2027) EQUALS NOTHING

§ `s 2025(c)(6) national performance measure`

-- two State agencies: error rate 0.10 on 100 and 0.05 on 300; (0.10 TIMES 100 PLUS 0.05 TIMES 300) / 400 is 0.0625
`s 2025(c)(6)(A) test agency A` MEANS `s 2025(c)(6)(A) State agency figures` OF 0.10, 100
`s 2025(c)(6)(A) test agency B` MEANS `s 2025(c)(6)(A) State agency figures` OF 0.05, 300
`s 2025(c)(6)(A) test agency C` MEANS `s 2025(c)(6)(A) State agency figures` OF 0.07, 500
`s 2025(c)(6)(A) test agency D` MEANS `s 2025(c)(6)(A) State agency figures` OF 0.10, 0
#ASSERT `s 2025(c)(6)(A) the national performance measure` (LIST `s 2025(c)(6)(A) test agency A`, `s 2025(c)(6)(A) test agency B`) EQUALS JUST 0.0625
#ASSERT `s 2025(c)(6)(A) the national performance measure` (LIST `s 2025(c)(6)(A) test agency C`) EQUALS JUST 0.07
-- no value of allotments, no proportion
#ASSERT `s 2025(c)(6)(A) the national performance measure` (LIST `s 2025(c)(6)(A) test agency D`) EQUALS NOTHING
#ASSERT `s 2025(c)(6)(A) the national performance measure` EMPTY EQUALS NOTHING
#ASSERT `s 2025(c)(6)(B) the Secretary may use another measure of the State's error` TRUE EQUALS JUST TRUE
#ASSERT `s 2025(c)(6)(B) the Secretary may use another measure of the State's error` FALSE EQUALS NOTHING
#ASSERT `s 2025(c)(6)(C) the announced national performance measure shall be used` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2025(c)(6)(C) the announced national performance measure shall be used` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2025(c)(6)(C) the announced national performance measure shall be used` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2025(c)(6)(D) the national performance measure is subject to administrative or judicial review` TRUE EQUALS JUST FALSE
#ASSERT `s 2025(c)(6)(D) the national performance measure is subject to administrative or judicial review` FALSE EQUALS NOTHING

§ `s 2025(c)(7) administrative and judicial review`

#ASSERT `s 2025(c)(7)(A) the State may seek administrative and judicial review of the action under section 2023` TRUE EQUALS JUST TRUE
#ASSERT `s 2025(c)(7)(A) the State may seek administrative and judicial review of the action under section 2023` FALSE EQUALS NOTHING
#ASSERT `s 2025(c)(7)(B) the determination is subject to administrative or judicial review` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2025(c)(7)(B) the determination is subject to administrative or judicial review` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2025(c)(7)(B) the determination is subject to administrative or judicial review` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2025(c)(7)(C) the action is subject to administrative or judicial review` TRUE EQUALS JUST FALSE
#ASSERT `s 2025(c)(7)(C) the action is subject to administrative or judicial review` FALSE EQUALS NOTHING

§ `s 2025(c)(8) criteria for payment by a State agency`

#ASSERT `s 2025(c)(8)(A) this paragraph applies to the determination` TRUE EQUALS JUST TRUE
#ASSERT `s 2025(c)(8)(A) this paragraph applies to the determination` FALSE EQUALS NOTHING
-- the first May 31 after the end of the fiscal year: a fiscal year ending 30 September 2026 gives 31 May 2027; the day itself is not "after"
#ASSERT `s 2025(c)(8)(B) the first May 31 after the end of the fiscal year` (Date 30 9 2026) EQUALS Date 31 5 2027
#ASSERT `s 2025(c)(8)(B) the first May 31 after the end of the fiscal year` (Date 15 5 2026) EQUALS Date 31 5 2026
#ASSERT `s 2025(c)(8)(B) the first May 31 after the end of the fiscal year` (Date 31 5 2026) EQUALS Date 31 5 2027
#ASSERT `s 2025(c)(8)(B) the first May 31 after the end of the fiscal year` (Date 1 6 2026) EQUALS Date 31 5 2027
#ASSERT `s 2025(c)(8)(B) the case review and arbitrations are completed in time` (Date 30 9 2026) (Date 31 5 2027) EQUALS JUST TRUE
#ASSERT `s 2025(c)(8)(B) the case review and arbitrations are completed in time` (Date 30 9 2026) (Date 1 6 2027) EQUALS JUST FALSE
-- the first June 30
#ASSERT `s 2025(c)(8)(C) the first June 30 after the end of the fiscal year` (Date 30 9 2026) EQUALS Date 30 6 2027
#ASSERT `s 2025(c)(8)(C) the first June 30 after the end of the fiscal year` (Date 29 6 2026) EQUALS Date 30 6 2026
#ASSERT `s 2025(c)(8)(C) the first June 30 after the end of the fiscal year` (Date 30 6 2026) EQUALS Date 30 6 2027
#ASSERT `s 2025(c)(8)(C)(i) the final error rates are determined in time` (Date 30 9 2026) (Date 30 6 2027) EQUALS JUST TRUE
#ASSERT `s 2025(c)(8)(C)(i) the final error rates are determined in time` (Date 30 9 2026) (Date 1 7 2027) EQUALS JUST FALSE
#ASSERT `s 2025(c)(8)(C)(ii) the State agencies are notified in time` (Date 30 9 2026) (Date 30 6 2027) EQUALS JUST TRUE
#ASSERT `s 2025(c)(8)(C)(ii) the State agencies are notified in time` (Date 30 9 2026) (Date 1 7 2027) EQUALS JUST FALSE
#ASSERT `s 2025(c)(8)(C)(iii) the copy is provided in time to the chief executive officer and the legislature` (Date 30 9 2026) (Date 30 6 2027) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2025(c)(8)(C)(iii) the copy is provided in time to the chief executive officer and the legislature` (Date 30 9 2026) (Date 30 6 2027) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2025(c)(8)(C)(iii) the copy is provided in time to the chief executive officer and the legislature` (Date 30 9 2026) (Date 30 6 2027) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2025(c)(8)(C)(iii) the copy is provided in time to the chief executive officer and the legislature` (Date 30 9 2026) (Date 1 7 2027) TRUE TRUE EQUALS JUST FALSE
-- subparagraph (I): the later of the deadline and the extension
#ASSERT `s 2025(c)(8)(I) the deadline as extended for cause shown` (Date 10 1 2026) (JUST (Date 20 1 2026)) EQUALS Date 20 1 2026
#ASSERT `s 2025(c)(8)(I) the deadline as extended for cause shown` (Date 10 1 2026) (JUST (Date 5 1 2026)) EQUALS Date 10 1 2026
#ASSERT `s 2025(c)(8)(I) the deadline as extended for cause shown` (Date 10 1 2026) NOTHING EQUALS Date 10 1 2026
#ASSERT `s 2025(c)(8)(I) the administrative law judge shall extend the deadline` TRUE EQUALS JUST TRUE
#ASSERT `s 2025(c)(8)(I) the administrative law judge shall extend the deadline` FALSE EQUALS NOTHING
-- (D)(i): 10 days after receiving the notice on 1 January 2026 is 11 January 2026
#ASSERT `s 2025(c)(8)(D)(i) the notice of appeal is submitted in time` (Date 1 1 2026) (Date 11 1 2026) NOTHING EQUALS JUST TRUE
#ASSERT `s 2025(c)(8)(D)(i) the notice of appeal is submitted in time` (Date 1 1 2026) (Date 12 1 2026) NOTHING EQUALS JUST FALSE
#ASSERT `s 2025(c)(8)(D)(i) the notice of appeal is submitted in time` (Date 1 1 2026) (Date 15 1 2026) (JUST (Date 20 1 2026)) EQUALS JUST TRUE
#ASSERT `s 2025(c)(8)(D)(i) the notice of appeal is submitted in time` (Date 1 1 2026) (Date 21 1 2026) (JUST (Date 20 1 2026)) EQUALS JUST FALSE
-- (D)(ii): 60 days after 1 January 2026 is 2 March 2026 (31 January +31 to 1 February, 28 days to 1 March, +1)
#ASSERT `s 2025(c)(8)(D)(ii) the evidence in support of the appeal is submitted in time` (Date 1 1 2026) (Date 2 3 2026) NOTHING EQUALS JUST TRUE
#ASSERT `s 2025(c)(8)(D)(ii) the evidence in support of the appeal is submitted in time` (Date 1 1 2026) (Date 3 3 2026) NOTHING EQUALS JUST FALSE
-- (E): 60 days after the State's evidence on 1 March 2026 is 30 April 2026
#ASSERT `s 2025(c)(8)(E) the responsive evidence is submitted in time` TRUE (Date 1 3 2026) (Date 30 4 2026) NOTHING EQUALS JUST TRUE
#ASSERT `s 2025(c)(8)(E) the responsive evidence is submitted in time` TRUE (Date 1 3 2026) (Date 1 5 2026) NOTHING EQUALS JUST FALSE
#ASSERT `s 2025(c)(8)(E) the responsive evidence is submitted in time` FALSE (Date 1 3 2026) (Date 1 5 2026) NOTHING EQUALS NOTHING
