#ASSERT `s 2025(c)(8)(G) the appeal is decided in time` TRUE (JUST (Date 1 6 2026)) (Date 2 3 2026) (Date 1 8 2026) NOTHING EQUALS JUST FALSE
#ASSERT `s 2025(c)(8)(G) the appeal is decided in time` TRUE NOTHING (Date 2 3 2026) (Date 31 5 2026) NOTHING EQUALS JUST TRUE
#ASSERT `s 2025(c)(8)(G) the appeal is decided in time` TRUE NOTHING (Date 2 3 2026) (Date 1 6 2026) NOTHING EQUALS JUST FALSE
#ASSERT `s 2025(c)(8)(G) the appeal is decided in time` FALSE NOTHING (Date 2 3 2026) (Date 1 6 2026) NOTHING EQUALS NOTHING
#ASSERT `s 2025(c)(8)(G) the appeal is decided in time` TRUE (JUST (Date 1 6 2026)) (Date 2 3 2026) (Date 10 8 2026) (JUST (Date 15 8 2026)) EQUALS JUST TRUE
-- (H): the judge must consider all grounds, and the waiver contention if made
#ASSERT `s 2025(c)(8)(H) the administrative law judge has considered what the text requires` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2025(c)(8)(H) the administrative law judge has considered what the text requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2025(c)(8)(H) the administrative law judge has considered what the text requires` TRUE TRUE FALSE EQUALS JUST FALSE
