IMPORT prelude
IMPORT daydate
IMPORT `snap-core`
IMPORT `snap2-3val`
IMPORT `snap2-2015d4`

-- Tests of section 2015(d)(4). Expected values are decided from the quoted words before the run.

§ `Tests: 2015(d)(4)(A)`
-- (i) argument order: designed by the State agency, consulted the workforce board, the State demonstrates employer consultation is better, consulted employers, approved by the Secretary, the purpose
#ASSERT `s 2015(d)(4)(A)(i) the State agency is required to implement the program` TRUE TRUE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(A)(i) the State agency is required to implement the program` TRUE FALSE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(A)(i) the State agency is required to implement the program` TRUE FALSE FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 2015(d)(4)(A)(i) the State agency is required to implement the program` TRUE TRUE FALSE FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 2015(d)(4)(A)(i) the State agency is required to implement the program` FALSE TRUE FALSE FALSE TRUE TRUE EQUALS NOTHING
-- (ii) argument order: carried out under this paragraph to meet clause (i), available locally through the statewide system
#ASSERT `s 2015(d)(4)(A)(ii) the component must be delivered through the statewide workforce development system` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(A)(ii) the component must be delivered through the statewide workforce development system` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2015(d)(4)(A)(ii) the component must be delivered through the statewide workforce development system` FALSE TRUE EQUALS NOTHING

§ `Tests: 2015(d)(4)(B)`
-- each component of (B)(i)
#ASSERT `s 2015(d)(4)(B)(i) the component is one of those the definition lists` `s 2015(d)(4)(B)(i)(I) supervised job search programs` EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(B)(i) the component is one of those the definition lists` `s 2015(d)(4)(B)(i)(II) job search training programs` EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(B)(i) the component is one of those the definition lists` `s 2015(d)(4)(B)(i)(III) workfare programs operated under section 2029` EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(B)(i) the component is one of those the definition lists` (`s 2015(d)(4)(B)(i)(IV) work experience or training programs` TRUE TRUE) EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(B)(i) the component is one of those the definition lists` (`s 2015(d)(4)(B)(i)(IV) work experience or training programs` TRUE FALSE) EQUALS JUST FALSE
#ASSERT `s 2015(d)(4)(B)(i) the component is one of those the definition lists` (`s 2015(d)(4)(B)(i)(IV) work experience or training programs` FALSE TRUE) EQUALS JUST FALSE
#ASSERT `s 2015(d)(4)(B)(i) the component is one of those the definition lists` `s 2015(d)(4)(B)(i)(V) educational programs or activities` EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(B)(i) the component is one of those the definition lists` `s 2015(d)(4)(B)(i)(VI) self-employment programs` EQUALS JUST TRUE
-- (VII) "not less than 30 days but not more than 90 days"
#ASSERT `s 2015(d)(4)(B)(i) the component is one of those the definition lists` (`s 2015(d)(4)(B)(i)(VII) job retention programs` 30) EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(B)(i) the component is one of those the definition lists` (`s 2015(d)(4)(B)(i)(VII) job retention programs` 90) EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(B)(i) the component is one of those the definition lists` (`s 2015(d)(4)(B)(i)(VII) job retention programs` 29) EQUALS JUST FALSE
#ASSERT `s 2015(d)(4)(B)(i) the component is one of those the definition lists` (`s 2015(d)(4)(B)(i)(VII) job retention programs` 91) EQUALS JUST FALSE
-- (VIII) the Secretary's determination; (IX) approval
#ASSERT `s 2015(d)(4)(B)(i) the component is one of those the definition lists` (`s 2015(d)(4)(B)(i)(VIII) programs and activities under section 2025(h)(1)(F)(iv)` (JUST TRUE)) EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(B)(i) the component is one of those the definition lists` (`s 2015(d)(4)(B)(i)(VIII) programs and activities under section 2025(h)(1)(F)(iv)` NOTHING) EQUALS NOTHING
#ASSERT `s 2015(d)(4)(B)(i) the component is one of those the definition lists` (`s 2015(d)(4)(B)(i)(IX) other programs approved by the Secretary or the State` TRUE) EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(B)(i) the component is one of those the definition lists` (`s 2015(d)(4)(B)(i)(IX) other programs approved by the Secretary or the State` FALSE) EQUALS JUST FALSE
-- the program: "contains case management services ... and one or more of the following components"
#ASSERT `s 2015(d)(4)(B)(i) the program is an employment and training program` TRUE (LIST `s 2015(d)(4)(B)(i)(V) educational programs or activities`) EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(B)(i) the program is an employment and training program` FALSE (LIST `s 2015(d)(4)(B)(i)(V) educational programs or activities`) EQUALS JUST FALSE
#ASSERT `s 2015(d)(4)(B)(i) the program is an employment and training program` TRUE (LIST `s 2015(d)(4)(B)(i)(VII) job retention programs` 10, `s 2015(d)(4)(B)(i)(VI) self-employment programs`) EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(B)(i) the program is an employment and training program` TRUE (LIST `s 2015(d)(4)(B)(i)(VII) job retention programs` 10) EQUALS JUST FALSE
#ASSERT `s 2015(d)(4)(B)(i) the program is an employment and training program` TRUE (LIST `s 2015(d)(4)(B)(i)(VIII) programs and activities under section 2025(h)(1)(F)(iv)` NOTHING) EQUALS NOTHING
#ASSERT `s 2015(d)(4)(B)(i) the program is an employment and training program` TRUE (EMPTY) EQUALS JUST FALSE
#ASSERT `s 2015(d)(4)(B)(i) the State agency may apply employment requirements under the clause to the applicant` TRUE EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(B)(i) the State agency may apply employment requirements under the clause to the applicant` FALSE EQUALS NOTHING

-- the workforce partnership: a program in which every limb holds
GIVEN employer IS A BOOLEAN, woia IS A BOOLEAN, certified IS A BOOLEAN, assist IS A BOOLEAN, hours IS A NUMBER, nofunds IS A BOOLEAN, info IS A BOOLEAN, reference IS A BOOLEAN, criteria IS A BOOLEAN, flsaApplies IS A BOOLEAN, flsaComplies IS A BOOLEAN, multistate IS A BOOLEAN
GIVETH A `s 2015(d)(4)(B)(ii) program`
`s 2015(d)(4)(B)(ii) test: a program` MEANS
    `s 2015(d)(4)(B)(ii) program` OF employer, woia, certified, assist, hours, nofunds, info, reference, criteria, flsaApplies, flsaComplies, multistate
-- argument order of the test program: employer-type operator, WIOA provider, certified, assists, hours, no chapter funds, information, reference, other criteria, FLSA applies, complies, multistate
#ASSERT `s 2015(d)(4)(B)(ii) the program is a workforce partnership` (`s 2015(d)(4)(B)(ii) test: a program` TRUE FALSE TRUE TRUE 20 TRUE TRUE TRUE TRUE TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(B)(ii) the program is a workforce partnership` (`s 2015(d)(4)(B)(ii) test: a program` FALSE TRUE TRUE TRUE 25 TRUE TRUE TRUE TRUE FALSE FALSE FALSE) EQUALS JUST TRUE
-- (II) a multistate program is included
#ASSERT `s 2015(d)(4)(B)(ii) the program is a workforce partnership` (`s 2015(d)(4)(B)(ii) test: a program` TRUE FALSE TRUE TRUE 20 TRUE TRUE TRUE TRUE TRUE TRUE TRUE) EQUALS JUST TRUE
-- "not less than 20 hours per week"
#ASSERT `s 2015(d)(4)(B)(ii) the program is a workforce partnership` (`s 2015(d)(4)(B)(ii) test: a program` TRUE FALSE TRUE TRUE 19 TRUE TRUE TRUE TRUE TRUE TRUE FALSE) EQUALS JUST FALSE
-- each other limb failing
#ASSERT `s 2015(d)(4)(B)(ii) the program is a workforce partnership` (`s 2015(d)(4)(B)(ii) test: a program` FALSE FALSE TRUE TRUE 20 TRUE TRUE TRUE TRUE TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT `s 2015(d)(4)(B)(ii) the program is a workforce partnership` (`s 2015(d)(4)(B)(ii) test: a program` TRUE FALSE FALSE TRUE 20 TRUE TRUE TRUE TRUE TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT `s 2015(d)(4)(B)(ii) the program is a workforce partnership` (`s 2015(d)(4)(B)(ii) test: a program` TRUE FALSE TRUE FALSE 20 TRUE TRUE TRUE TRUE TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT `s 2015(d)(4)(B)(ii) the program is a workforce partnership` (`s 2015(d)(4)(B)(ii) test: a program` TRUE FALSE TRUE TRUE 20 FALSE TRUE TRUE TRUE TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT `s 2015(d)(4)(B)(ii) the program is a workforce partnership` (`s 2015(d)(4)(B)(ii) test: a program` TRUE FALSE TRUE TRUE 20 TRUE FALSE TRUE TRUE TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT `s 2015(d)(4)(B)(ii) the program is a workforce partnership` (`s 2015(d)(4)(B)(ii) test: a program` TRUE FALSE TRUE TRUE 20 TRUE TRUE FALSE TRUE TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT `s 2015(d)(4)(B)(ii) the program is a workforce partnership` (`s 2015(d)(4)(B)(ii) test: a program` TRUE FALSE TRUE TRUE 20 TRUE TRUE TRUE FALSE TRUE TRUE FALSE) EQUALS JUST FALSE
-- (cc) "is in compliance with the Fair Labor Standards Act of 1938 ..., if applicable"
#ASSERT `s 2015(d)(4)(B)(ii) the program is a workforce partnership` (`s 2015(d)(4)(B)(ii) test: a program` TRUE FALSE TRUE TRUE 20 TRUE TRUE TRUE TRUE TRUE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 2015(d)(4)(B)(ii) the program is a workforce partnership` (`s 2015(d)(4)(B)(ii) test: a program` TRUE FALSE TRUE TRUE 20 TRUE TRUE TRUE TRUE FALSE FALSE FALSE) EQUALS JUST TRUE

§ `Tests: 2015(d)(4)(C) to (H)`
#ASSERT `s 2015(d)(4)(C) the State agency may provide that participation supplements or supplants the other requirements` TRUE EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(C) the State agency may provide that participation supplements or supplants the other requirements` FALSE EQUALS NOTHING
-- (D) argument order: the exemption is for a category, the member is in a category already exempted
#ASSERT `s 2015(d)(4)(D) the State agency may exempt the category or the individual member from the requirement` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(D) the State agency may exempt the category or the individual member from the requirement` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(D) the State agency may exempt the category or the individual member from the requirement` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2015(d)(4)(D)(iii) the exemption is to be periodically evaluated to determine whether it continues to be valid` TRUE EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(D)(iii) the exemption is to be periodically evaluated to determine whether it continues to be valid` FALSE EQUALS NOTHING
#ASSERT `s 2015(d)(4)(E) the State agency is required to establish requirements for participation by the individual` FALSE EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(E) the State agency is required to establish requirements for participation by the individual` TRUE EQUALS NOTHING
#ASSERT `s 2015(d)(4)(E)(iii) the individual is considered to be in compliance with the employment and training requirements` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(E)(iii) the individual is considered to be in compliance with the employment and training requirements` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2015(d)(4)(E)(iii) the individual is considered to be in compliance with the employment and training requirements` TRUE FALSE EQUALS NOTHING
-- (F)(i) argument order: total hours, the allotment in dollars, the higher minimum wage, voluntary election; 400 dollars at 8 dollars an hour is 50 hours
#ASSERT `s 2015(d)(4)(F)(i) the required hours of the household's members exceed the limit` 50 400 8 FALSE EQUALS JUST FALSE
#ASSERT `s 2015(d)(4)(F)(i) the required hours of the household's members exceed the limit` 51 400 8 FALSE EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(F)(i) the required hours of the household's members exceed the limit` 51 400 8 TRUE EQUALS JUST FALSE
-- (F)(ii) argument order: hours required of the member, hours in another section 2029 program, hours worked for compensation elsewhere, voluntary election; "shall not exceed one hundred and twenty hours per month"
#ASSERT `s 2015(d)(4)(F)(ii) the required hours of the member exceed one hundred and twenty hours per month` 80 20 20 FALSE EQUALS JUST FALSE
#ASSERT `s 2015(d)(4)(F)(ii) the required hours of the member exceed one hundred and twenty hours per month` 80 20 21 FALSE EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(F)(ii) the required hours of the member exceed one hundred and twenty hours per month` 80 20 21 TRUE EQUALS JUST FALSE
#ASSERT `s 2015(d)(4)(G) the State agency may operate the program component` TRUE EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(G) the State agency may operate the program component` FALSE EQUALS NOTHING
#ASSERT `s 2015(d)(4)(H) the Federal funds may be used` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2015(d)(4)(H) the Federal funds may be used` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2015(d)(4)(H) the Federal funds may be used` FALSE TRUE EQUALS NOTHING

§ `Tests: 2015(d)(4)(I) to (M)`
-- (I)(i)(I) argument order: participant, a transportation or other actual cost, reasonably necessary and directly related
#ASSERT `s 2015(d)(4)(I)(i)(I) the State agency is required to pay or reimburse the cost` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(I)(i)(I) the State agency is required to pay or reimburse the cost` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 2015(d)(4)(I)(i)(I) the State agency is required to pay or reimburse the cost` FALSE TRUE TRUE EQUALS NOTHING
-- (I)(i)(II) argument order: participant, dependent care the State agency found necessary, the person is the caretaker relative in a title IV family
#ASSERT `s 2015(d)(4)(I)(i)(II) the State agency is required to pay or reimburse the dependent care cost` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(I)(i)(II) the State agency is required to pay or reimburse the dependent care cost` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2015(d)(4)(I)(i)(II) the State agency is required to pay or reimburse the dependent care cost` TRUE FALSE FALSE EQUALS NOTHING
-- the cap: "no such payment or reimbursement shall exceed the applicable local market rate"
#ASSERT `s 2015(d)(4)(I)(i)(II) the most the State agency may pay or reimburse for the dependent care, in dollars` 300 250 EQUALS 250
#ASSERT `s 2015(d)(4)(I)(i)(II) the most the State agency may pay or reimburse for the dependent care, in dollars` 200 250 EQUALS 200
#ASSERT `s 2015(d)(4)(I)(i) the individual may be required to participate in the program` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2015(d)(4)(I)(i) the individual may be required to participate in the program` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2015(d)(4)(I)(i) the individual may be required to participate in the program` FALSE FALSE EQUALS NOTHING
#ASSERT `s 2015(d)(4)(I)(ii) the State agency may arrange dependent care instead of reimbursing it` TRUE EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(I)(ii) the State agency may arrange dependent care instead of reimbursing it` FALSE EQUALS NOTHING
#ASSERT `s 2015(d)(4)(I)(iii)(I) the value or amount is treated as income for the other program` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2015(d)(4)(I)(iii)(I) the value or amount is treated as income for the other program` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2015(d)(4)(I)(iii)(II) the value or amount may be claimed as an employment-related expense for the credit under section 21 of title 26` TRUE EQUALS JUST FALSE
#ASSERT `s 2015(d)(4)(I)(iii)(II) the value or amount may be claimed as an employment-related expense for the credit under section 21 of title 26` FALSE EQUALS NOTHING
#ASSERT `s 2015(d)(4)(J) the Secretary is required to promulgate the guideline` TRUE EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(J) the Secretary is required to promulgate the guideline` FALSE EQUALS NOTHING
-- (K) argument order: funds used now, funds used in fiscal year 1995
#ASSERT `s 2015(d)(4)(K) the funds the State agency uses exceed the limit` 1000 1000 EQUALS JUST FALSE
#ASSERT `s 2015(d)(4)(K) the funds the State agency uses exceed the limit` 1001 1000 EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(L) the Secretary is required to ensure that the State agencies comply with the requirement` TRUE EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(L) the Secretary is required to ensure that the State agencies comply with the requirement` FALSE EQUALS NOTHING
#ASSERT `s 2015(d)(4)(M) the facilities may be used` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(M) the facilities may be used` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2015(d)(4)(M) the facilities may be used` FALSE TRUE EQUALS NOTHING

§ `Tests: 2015(d)(4)(N) and (O)`
#ASSERT `s 2015(d)(4)(N)(i) the Secretary or the State agency is required to require the program to submit the information` TRUE EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(N)(i) the Secretary or the State agency is required to require the program to submit the information` FALSE EQUALS NOTHING
#ASSERT `s 2015(d)(4)(N)(ii) the State agency may use the workforce partnership` FALSE EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(N)(ii) the State agency may use the workforce partnership` TRUE EQUALS JUST FALSE
#ASSERT `s 2015(d)(4)(N)(iii)(I) the State agency is required to provide the list of certified workforce partnerships to the household member` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(N)(iii)(I) the State agency is required to provide the list of certified workforce partnerships to the household member` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2015(d)(4)(N)(iii)(I) the State agency is required to provide the list of certified workforce partnerships to the household member` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2015(d)(4)(N)(iii)(II) the State agency may require the member to participate in a workforce partnership` TRUE EQUALS JUST FALSE
#ASSERT `s 2015(d)(4)(N)(iii)(II) the State agency may require the member to participate in a workforce partnership` FALSE EQUALS NOTHING
#ASSERT `s 2015(d)(4)(N)(iv)(I) the workforce partnership may replace the employment or training of the individual` TRUE EQUALS JUST FALSE
#ASSERT `s 2015(d)(4)(N)(iv)(I) the workforce partnership may replace the employment or training of the individual` FALSE EQUALS NOTHING
#ASSERT `s 2015(d)(4)(N)(iv)(II) this subsection or subsection (o) affects the criteria or screening process for selecting participants` TRUE EQUALS JUST FALSE
#ASSERT `s 2015(d)(4)(N)(iv)(II) this subsection or subsection (o) affects the criteria or screening process for selecting participants` FALSE EQUALS NOTHING
#ASSERT `s 2015(d)(4)(N)(v) the reporting requirement may be imposed on the workforce partnership` TRUE EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(N)(v) the reporting requirement may be imposed on the workforce partnership` FALSE EQUALS JUST FALSE
-- (O)(i) argument order: not eligible for an exemption under paragraph (2), determined ill-suited, the step
#ASSERT `s 2015(d)(4)(O)(i) the step is one the State agency is to take` (JUST TRUE) TRUE `s 2015(d)(4)(O)(i)(I) refer the individual to an appropriate employment and training program component` EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(O)(i) the step is one the State agency is to take` (JUST TRUE) TRUE `s 2015(d)(4)(O)(i)(II) refer the individual to an appropriate workforce partnership, if available` EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(O)(i) the step is one the State agency is to take` (JUST TRUE) TRUE `s 2015(d)(4)(O)(i)(III) reassess the physical and mental fitness of the individual under paragraph (1)(A)` EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(O)(i) the step is one the State agency is to take` (JUST TRUE) TRUE `s 2015(d)(4)(O)(i)(IV) coordinate with other Federal, State, or local workforce or assistance programs to identify work opportunities or assistance` EQUALS JUST TRUE
#ASSERT `s 2015(d)(4)(O)(i) the step is one the State agency is to take` (JUST TRUE) TRUE `s 2015(d)(4)(O)(i) another step` EQUALS NOTHING
#ASSERT `s 2015(d)(4)(O)(i) the step is one the State agency is to take` (JUST FALSE) TRUE `s 2015(d)(4)(O)(i)(I) refer the individual to an appropriate employment and training program component` EQUALS NOTHING
#ASSERT `s 2015(d)(4)(O)(i) the step is one the State agency is to take` (JUST TRUE) FALSE `s 2015(d)(4)(O)(i)(I) refer the individual to an appropriate employment and training program component` EQUALS NOTHING
#ASSERT `s 2015(d)(4)(O)(ii) the individual is found to have refused without good cause to participate in an employment and training program` TRUE EQUALS JUST FALSE
#ASSERT `s 2015(d)(4)(O)(ii) the individual is found to have refused without good cause to participate in an employment and training program` FALSE EQUALS NOTHING
