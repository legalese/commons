IMPORT prelude
IMPORT `snap1-logic`
IMPORT `snap1-s2012a`

-- Tests for 7 U.S.C. 2012a. Arguments are the provision, whether it concerns the programs, whether the center is a publicly operated community health center.
#ASSERT `s 2012a the provision is also applicable to the center` `s 2012a section 2019` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2012a the provision is also applicable to the center` `s 2012a section 2019` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2012a the provision is also applicable to the center` `s 2012a section 2019` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2012a the provision is also applicable to the center` `s 2012a subsection (f) of section 2012 as lettered in this text` TRUE TRUE EQUALS NOTHING
#ASSERT `s 2012a the provision is also applicable to the center` `s 2012a subsection (i) of section 2012 as lettered in this text` TRUE TRUE EQUALS NOTHING
#ASSERT `s 2012a the provision is also applicable to the center` `s 2012a subsection (f) of section 2012 as lettered in this text` FALSE TRUE EQUALS NOTHING
