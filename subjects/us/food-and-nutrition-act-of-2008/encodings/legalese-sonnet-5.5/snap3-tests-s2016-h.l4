IMPORT prelude
IMPORT daydate
IMPORT `snap-core`
IMPORT `snap3-s2016-h`

-- TESTS for section 2016(h) (snap3-s2016-h.l4). Every expected value is worked out from the text and written beside the assertion, BEFORE running.

§ `Tests -- the last days`

#ASSERT `s 2016(h)(1)(A) the last day for implementing an electronic benefit transfer system` EQUALS Date 1 10 2002
#ASSERT `s 2016(h)(14)(B)(iv) the last day for approving the demonstration projects` EQUALS Date 1 1 2021
#ASSERT `s 2016(h)(14)(C)(i) the last day for authorizing implementation in all States` EQUALS Date 1 1 2022
#ASSERT `s 2016(h)(13)(B) the last day of fiscal year 2023` EQUALS Date 30 9 2023

§ `Tests -- s 2016(h)(1) implementation`

-- arguments: the Secretary provides a waiver, the date the State agency implemented the system
#ASSERT `s 2016(h)(1)(A) the State agency has met the duty to implement an electronic benefit transfer system in time` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 2016(h)(1)(A) the State agency has met the duty to implement an electronic benefit transfer system in time` TRUE (JUST (Date 1 1 2020)) EQUALS NOTHING
-- a waiver does not undo an implementation made in time: on or before 1 October 2002 the duty was met whether or not a waiver was given
#ASSERT `s 2016(h)(1)(A) the State agency has met the duty to implement an electronic benefit transfer system in time` TRUE (JUST (Date 1 10 2002)) EQUALS JUST TRUE
#ASSERT `s 2016(h)(1)(A) the State agency has met the duty to implement an electronic benefit transfer system in time` TRUE (JUST (Date 30 9 2002)) EQUALS JUST TRUE
#ASSERT `s 2016(h)(1)(A) the State agency has met the duty to implement an electronic benefit transfer system in time` TRUE (JUST (Date 2 10 2002)) EQUALS NOTHING
#ASSERT `s 2016(h)(1)(A) the State agency has met the duty to implement an electronic benefit transfer system in time` FALSE NOTHING EQUALS NOTHING
#ASSERT `s 2016(h)(1)(A) the State agency has met the duty to implement an electronic benefit transfer system in time` FALSE (JUST (Date 1 10 2002)) EQUALS JUST TRUE
#ASSERT `s 2016(h)(1)(A) the State agency has met the duty to implement an electronic benefit transfer system in time` FALSE (JUST (Date 30 9 2002)) EQUALS JUST TRUE
#ASSERT `s 2016(h)(1)(A) the State agency has met the duty to implement an electronic benefit transfer system in time` FALSE (JUST (Date 2 10 2002)) EQUALS JUST FALSE
-- (B) and (D) only encourage ("is encouraged", "should take into account"): the text neither requires nor forbids, so the answer is NOTHING, never FALSE
#ASSERT `s 2016(h)(1)(B) the State agency is required to implement the system as soon as practicable` EQUALS NOTHING
#ASSERT `s 2016(h)(1)(D) the electronic benefit transfer system is required to take into account the standard operating rules` EQUALS NOTHING
#ASSERT `s 2016(h)(1)(C) the State agency may procure and implement the system under the terms, conditions, and design that it considers appropriate` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2016(h)(1)(C) the State agency may procure and implement the system under the terms, conditions, and design that it considers appropriate` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2016(h)(1)(C) the State agency may procure and implement the system under the terms, conditions, and design that it considers appropriate` NOTHING EQUALS NOTHING

§ `Tests -- s 2016(h)(3) to (6)`

-- (3): arguments are participation not optional, enough stores agreed, equipment operational as the Secretary determines
#ASSERT `s 2016(h)(3) the Secretary may approve the system` FALSE TRUE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 2016(h)(3) the Secretary may approve the system` TRUE FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 2016(h)(3) the Secretary may approve the system` TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2016(h)(3) the Secretary may approve the system` TRUE TRUE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 2016(h)(3) the Secretary may approve the system` TRUE TRUE NOTHING EQUALS NOTHING
#ASSERT `s 2016(h)(3) the Secretary may approve the system` TRUE FALSE NOTHING EQUALS JUST FALSE
-- (4): arguments are the cost was incurred in connection with activities under this subsection, the section 2025(g) answer
#ASSERT `s 2016(h)(4) the administrative cost is eligible for reimbursement in accordance with section 2025` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2016(h)(4) the administrative cost is eligible for reimbursement in accordance with section 2025` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2016(h)(4) the administrative cost is eligible for reimbursement in accordance with section 2025` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 2016(h)(4) the administrative cost is eligible for reimbursement in accordance with section 2025` FALSE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 2016(h)(5) the Secretary has done what the paragraph requires` TRUE EQUALS JUST TRUE
#ASSERT `s 2016(h)(5) the Secretary has done what the paragraph requires` FALSE EQUALS NOTHING
#ASSERT `s 2016(h)(6) this subsection diminishes the authority of the Secretary to conduct the project` TRUE EQUALS JUST FALSE
#ASSERT `s 2016(h)(6) this subsection diminishes the authority of the Secretary to conduct the project` FALSE EQUALS NOTHING

§ `Tests -- s 2016(h)(8) replacement of cards`

#ASSERT `s 2016(h)(8)(A) the State agency may collect a charge by reducing the monthly allotment of the household receiving the replacement card` TRUE EQUALS JUST TRUE
#ASSERT `s 2016(h)(8)(A) the State agency may collect a charge by reducing the monthly allotment of the household receiving the replacement card` FALSE EQUALS NOTHING
-- (B)(i): arguments are excessive requests, the household provides an explanation
#ASSERT `s 2016(h)(8)(B)(i) the Secretary may require the State agency to decline to issue a replacement card to the household` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2016(h)(8)(B)(i) the Secretary may require the State agency to decline to issue a replacement card to the household` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2016(h)(8)(B)(i) the Secretary may require the State agency to decline to issue a replacement card to the household` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2016(h)(8)(B)(i) the Secretary may require the State agency to decline to issue a replacement card to the household` FALSE TRUE EQUALS JUST FALSE
-- (B)(ii): arguments are limbs (I), (II), (III)
#ASSERT `s 2016(h)(8)(B)(ii) the terms and conditions established by the Secretary provide what the clause requires` TRUE TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2016(h)(8)(B)(ii) the terms and conditions established by the Secretary provide what the clause requires` TRUE TRUE NOTHING EQUALS NOTHING
#ASSERT `s 2016(h)(8)(B)(ii) the terms and conditions established by the Secretary provide what the clause requires` FALSE TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 2016(h)(8)(B)(ii) the terms and conditions established by the Secretary provide what the clause requires` TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2016(h)(8)(B)(ii) the terms and conditions established by the Secretary provide what the clause requires` FALSE TRUE NOTHING EQUALS JUST FALSE
-- (C): arguments are a vulnerable person, lost a card, is intentionally committing fraud
#ASSERT `s 2016(h)(8)(C) the State agency must act to protect the person` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2016(h)(8)(C) the State agency must act to protect the person` (JUST TRUE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2016(h)(8)(C) the State agency must act to protect the person` (JUST TRUE) FALSE FALSE EQUALS NOTHING
#ASSERT `s 2016(h)(8)(C) the State agency must act to protect the person` (JUST FALSE) TRUE FALSE EQUALS NOTHING
#ASSERT `s 2016(h)(8)(C) the State agency must act to protect the person` NOTHING TRUE FALSE EQUALS NOTHING
#ASSERT `s 2016(h)(8)(C) the State agency must act to protect the person` (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2016(h)(8)(C) the State agency has done what the subparagraph requires` TRUE EQUALS JUST TRUE
#ASSERT `s 2016(h)(8)(C) the State agency has done what the subparagraph requires` FALSE EQUALS NOTHING
#ASSERT `s 2016(h)(8) declining to issue the card is a denial of, or a limitation on, the eligibility for benefits under section 2014` TRUE EQUALS JUST FALSE
#ASSERT `s 2016(h)(8) declining to issue the card is a denial of, or a limitation on, the eligibility for benefits under section 2014` FALSE EQUALS NOTHING

§ `Tests -- s 2016(h)(9) and (10)`

#ASSERT `s 2016(h)(9)(A) the State agency may require an electronic benefit card to contain a photograph` TRUE EQUALS JUST TRUE
#ASSERT `s 2016(h)(9)(A) the State agency may require an electronic benefit card to contain a photograph` FALSE EQUALS NOTHING
