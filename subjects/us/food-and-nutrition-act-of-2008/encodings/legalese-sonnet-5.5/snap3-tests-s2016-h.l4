#ASSERT `s 2016(h)(13)(B) the person may impose the fee` (Date 30 9 2023) TRUE FALSE EQUALS NOTHING

§ `Tests -- s 2016(h)(14) mobile technologies`

#ASSERT `s 2016(h)(14)(A) the Secretary has done what the subparagraph requires` TRUE EQUALS JUST TRUE
#ASSERT `s 2016(h)(14)(A) the Secretary has done what the subparagraph requires` FALSE EQUALS NOTHING
#ASSERT `s 2016(h)(14)(B)(i) the Secretary approved a number of proposals the clause allows` 0 EQUALS JUST TRUE
#ASSERT `s 2016(h)(14)(B)(i) the Secretary approved a number of proposals the clause allows` 4 EQUALS JUST TRUE
#ASSERT `s 2016(h)(14)(B)(i) the Secretary approved a number of proposals the clause allows` 5 EQUALS JUST TRUE
#ASSERT `s 2016(h)(14)(B)(i) the Secretary approved a number of proposals the clause allows` 6 EQUALS JUST FALSE
-- (ii): arguments are limbs (I) to (VIII) in order; (V) and (VIII) are the Secretary's judgments
#ASSERT `s 2016(h)(14)(B)(ii) the plan contains what the clause requires` TRUE TRUE TRUE TRUE (JUST TRUE) TRUE TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2016(h)(14)(B)(ii) the plan contains what the clause requires` TRUE TRUE TRUE TRUE NOTHING TRUE TRUE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 2016(h)(14)(B)(ii) the plan contains what the clause requires` TRUE TRUE TRUE FALSE NOTHING TRUE TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 2016(h)(14)(B)(ii) the plan contains what the clause requires` TRUE TRUE TRUE TRUE (JUST TRUE) TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
-- (iii): arguments are reduce fraud, encourage nutritional outcomes, meet other criteria as the Secretary determines
#ASSERT `s 2016(h)(14)(B)(iii) the Secretary may prioritize the proposal` TRUE FALSE NOTHING EQUALS JUST TRUE
#ASSERT `s 2016(h)(14)(B)(iii) the Secretary may prioritize the proposal` FALSE TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 2016(h)(14)(B)(iii) the Secretary may prioritize the proposal` FALSE FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2016(h)(14)(B)(iii) the Secretary may prioritize the proposal` FALSE FALSE NOTHING EQUALS NOTHING
#ASSERT `s 2016(h)(14)(B)(iii) the Secretary may prioritize the proposal` FALSE FALSE (JUST FALSE) EQUALS NOTHING
-- (iv): the date the Secretary approved the projects; 1 January 2021 itself is in time
#ASSERT `s 2016(h)(14)(B)(iv) the Secretary approved the demonstration projects in time` NOTHING EQUALS NOTHING
#ASSERT `s 2016(h)(14)(B)(iv) the Secretary approved the demonstration projects in time` (JUST (Date 31 12 2020)) EQUALS JUST TRUE
#ASSERT `s 2016(h)(14)(B)(iv) the Secretary approved the demonstration projects in time` (JUST (Date 1 1 2021)) EQUALS JUST TRUE
#ASSERT `s 2016(h)(14)(B)(iv) the Secretary approved the demonstration projects in time` (JUST (Date 2 1 2021)) EQUALS JUST FALSE
-- (C)(i): arguments are the Secretary's finding, the date the Secretary authorized all States
#ASSERT `s 2016(h)(14)(C)(i) the Secretary authorized implementation in all States in time` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 2016(h)(14)(C)(i) the Secretary authorized implementation in all States in time` TRUE (JUST (Date 1 1 2030)) EQUALS NOTHING
-- a finding does not undo an authorization made in time: on or before 1 January 2022 the requirement was met whether or not a finding was made
#ASSERT `s 2016(h)(14)(C)(i) the Secretary authorized implementation in all States in time` TRUE (JUST (Date 1 1 2022)) EQUALS JUST TRUE
#ASSERT `s 2016(h)(14)(C)(i) the Secretary authorized implementation in all States in time` TRUE (JUST (Date 2 1 2022)) EQUALS NOTHING
#ASSERT `s 2016(h)(14)(C)(i) the Secretary authorized implementation in all States in time` FALSE NOTHING EQUALS NOTHING
#ASSERT `s 2016(h)(14)(C)(i) the Secretary authorized implementation in all States in time` FALSE (JUST (Date 1 1 2022)) EQUALS JUST TRUE
#ASSERT `s 2016(h)(14)(C)(i) the Secretary authorized implementation in all States in time` FALSE (JUST (Date 2 1 2022)) EQUALS JUST FALSE
-- (C)(ii): arguments are the determination in clause (i) is not to implement, the report has been submitted
#ASSERT `s 2016(h)(14)(C)(ii) the Secretary has done what the clause requires` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2016(h)(14)(C)(ii) the Secretary has done what the clause requires` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2016(h)(14)(C)(ii) the Secretary has done what the clause requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2016(h)(14)(C)(ii) the Secretary has done what the clause requires` TRUE FALSE EQUALS NOTHING

