#ASSERT `s 2016(h)(9)(B) the State agency has done what the subparagraph requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2016(h)(9)(B) the State agency has done what the subparagraph requires` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2016(h)(10) section 1693o–2 of title 15 applies to the system` TRUE EQUALS JUST FALSE
#ASSERT `s 2016(h)(10) section 1693o–2 of title 15 applies to the system` FALSE EQUALS NOTHING

§ `Tests -- s 2016(h)(11) anti-tying`

#ASSERT `s 2016(h)(11)(A)(i) the entity is an affiliate` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2016(h)(11)(A)(i) the entity is an affiliate` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2016(h)(11)(A)(i) the entity is an affiliate` NOTHING EQUALS NOTHING
-- (ii): arguments are the title 12 answer, the entity is a bank, a bank holding company or a subsidiary of one
#ASSERT `s 2016(h)(11)(A)(ii) the entity is a company` (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 2016(h)(11)(A)(ii) the entity is a company` (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 2016(h)(11)(A)(ii) the entity is a company` NOTHING FALSE EQUALS NOTHING
#ASSERT `s 2016(h)(11)(A)(ii) the entity is a company` (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 2016(h)(11)(A)(ii) the entity is a company` NOTHING TRUE EQUALS JUST FALSE
-- (iii): arguments are processing of electronic transfers of benefits under 2017(a) or 2035, central databank, accessed at the point of sale, provided by a Federal or State government
#ASSERT `s 2016(h)(11)(A)(iii) the service is an electronic benefit transfer service` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2016(h)(11)(A)(iii) the service is an electronic benefit transfer service` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2016(h)(11)(A)(iii) the service is an electronic benefit transfer service` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2016(h)(11)(A)(iii) the service is an electronic benefit transfer service` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2016(h)(11)(A)(iv) the product or service is a point-of-sale service` TRUE EQUALS JUST TRUE
#ASSERT `s 2016(h)(11)(A)(iv) the product or service is a point-of-sale service` FALSE EQUALS JUST FALSE
-- (B): arguments are the seller is a company, conditioned on obtaining an additional service from the company or an affiliate, conditioned on not obtaining one from a competitor
#ASSERT `s 2016(h)(11)(B) the company may sell or provide electronic benefit transfer services, or fix or vary the consideration, on the condition` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2016(h)(11)(B) the company may sell or provide electronic benefit transfer services, or fix or vary the consideration, on the condition` (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2016(h)(11)(B) the company may sell or provide electronic benefit transfer services, or fix or vary the consideration, on the condition` (JUST TRUE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2016(h)(11)(B) the company may sell or provide electronic benefit transfer services, or fix or vary the consideration, on the condition` (JUST TRUE) FALSE FALSE EQUALS NOTHING
#ASSERT `s 2016(h)(11)(B) the company may sell or provide electronic benefit transfer services, or fix or vary the consideration, on the condition` (JUST FALSE) TRUE FALSE EQUALS NOTHING
#ASSERT `s 2016(h)(11)(B) the company may sell or provide electronic benefit transfer services, or fix or vary the consideration, on the condition` NOTHING TRUE FALSE EQUALS NOTHING

§ `Tests -- s 2016(h)(12) recovering electronic benefits`

#ASSERT `s 2016(h)(12)(A) the State agency has done what the subparagraph requires` TRUE EQUALS JUST TRUE
#ASSERT `s 2016(h)(12)(A) the State agency has done what the subparagraph requires` FALSE EQUALS NOTHING
-- (B)(i): arguments are the whole months without access, the State agency acts in accordance with clause (ii)
#ASSERT `s 2016(h)(12)(B)(i) the State agency may store the recovered electronic benefits off-line` 2 TRUE EQUALS JUST FALSE
#ASSERT `s 2016(h)(12)(B)(i) the State agency may store the recovered electronic benefits off-line` 2.9 TRUE EQUALS JUST FALSE
#ASSERT `s 2016(h)(12)(B)(i) the State agency may store the recovered electronic benefits off-line` 3 TRUE EQUALS JUST TRUE
#ASSERT `s 2016(h)(12)(B)(i) the State agency may store the recovered electronic benefits off-line` 3 FALSE EQUALS JUST FALSE
#ASSERT `s 2016(h)(12)(B)(i) the State agency may store the recovered electronic benefits off-line` 12 TRUE EQUALS JUST TRUE
#ASSERT `s 2016(h)(12)(B)(ii)(I) the State agency has done what the subclause requires` TRUE EQUALS JUST TRUE
#ASSERT `s 2016(h)(12)(B)(ii)(I) the State agency has done what the subclause requires` FALSE EQUALS NOTHING
-- (B)(ii)(II): hours from the request to the moment the benefits are made available; 48 hours exactly is in time
#ASSERT `s 2016(h)(12)(B)(ii)(II) the State agency made the stored benefits available in time` 0 EQUALS JUST TRUE
#ASSERT `s 2016(h)(12)(B)(ii)(II) the State agency made the stored benefits available in time` 47.9 EQUALS JUST TRUE
#ASSERT `s 2016(h)(12)(B)(ii)(II) the State agency made the stored benefits available in time` 48 EQUALS JUST TRUE
#ASSERT `s 2016(h)(12)(B)(ii)(II) the State agency made the stored benefits available in time` 48.5 EQUALS JUST FALSE
#ASSERT `s 2016(h)(12)(B)(ii)(II) the State agency made the stored benefits available in time` 49 EQUALS JUST FALSE
-- (C)(i): arguments are the whole months without access, verified that all members are deceased, the notice that clause (ii) requires has been given
#ASSERT `s 2016(h)(12)(C)(i) the State agency must expunge the benefits` 8 FALSE TRUE EQUALS NOTHING
#ASSERT `s 2016(h)(12)(C)(i) the State agency must expunge the benefits` 9 FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 2016(h)(12)(C)(i) the State agency must expunge the benefits` 9 FALSE FALSE EQUALS NOTHING
#ASSERT `s 2016(h)(12)(C)(i) the State agency must expunge the benefits` 3 TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2016(h)(12)(C)(i) the State agency must expunge the benefits` 3 TRUE FALSE EQUALS NOTHING
-- (C)(ii): the last day for notice is 30 days before the expunging date
#ASSERT `s 2016(h)(12)(C)(ii) the last day for giving notice before expunging` (Date 31 1 2026) EQUALS Date 1 1 2026
#ASSERT `s 2016(h)(12)(C)(ii) the last day for giving notice before expunging` (Date 1 3 2026) EQUALS Date 30 1 2026
-- (I): arguments are sufficient content, the date of the notice, the expunging date
#ASSERT `s 2016(h)(12)(C)(ii)(I) the State agency gave sufficient notice in time` TRUE (Date 1 1 2026) (Date 31 1 2026) EQUALS JUST TRUE
#ASSERT `s 2016(h)(12)(C)(ii)(I) the State agency gave sufficient notice in time` TRUE (Date 31 12 2025) (Date 31 1 2026) EQUALS JUST TRUE
#ASSERT `s 2016(h)(12)(C)(ii)(I) the State agency gave sufficient notice in time` TRUE (Date 2 1 2026) (Date 31 1 2026) EQUALS JUST FALSE
#ASSERT `s 2016(h)(12)(C)(ii)(I) the State agency gave sufficient notice in time` FALSE (Date 1 1 2026) (Date 31 1 2026) EQUALS JUST FALSE
-- (II): arguments are stored off-line, the date the opportunity was given, the expunging date
#ASSERT `s 2016(h)(12)(C)(ii)(II) the State agency gave the opportunity to request restoration in time` FALSE (Date 1 1 2026) (Date 31 1 2026) EQUALS NOTHING
#ASSERT `s 2016(h)(12)(C)(ii)(II) the State agency gave the opportunity to request restoration in time` TRUE (Date 1 1 2026) (Date 31 1 2026) EQUALS JUST TRUE
#ASSERT `s 2016(h)(12)(C)(ii)(II) the State agency gave the opportunity to request restoration in time` TRUE (Date 2 1 2026) (Date 31 1 2026) EQUALS JUST FALSE
#ASSERT `s 2016(h)(12)(C)(ii)(III) the State agency made the benefits available in time` 48 EQUALS JUST TRUE
#ASSERT `s 2016(h)(12)(C)(ii)(III) the State agency made the benefits available in time` 49 EQUALS JUST FALSE
-- (D): repeats (B)(ii)
#ASSERT `s 2016(h)(12)(D)(i) the State agency has done what the clause requires` TRUE EQUALS JUST TRUE
#ASSERT `s 2016(h)(12)(D)(i) the State agency has done what the clause requires` FALSE EQUALS NOTHING
#ASSERT `s 2016(h)(12)(D)(ii) the State agency made the stored benefits available in time` 48 EQUALS JUST TRUE
#ASSERT `s 2016(h)(12)(D)(ii) the State agency made the stored benefits available in time` 49 EQUALS JUST FALSE

§ `Tests -- s 2016(h)(12) the duties as regulative rules`

-- Expected: FULFILLED when the act is done at or before the deadline; the deadline is inclusive, so 48 is in time and the first moment past it is 49.
#TRACE `s 2016(h)(12)(B)(ii)(II) duty to make the stored benefits available within 48 hours of the request` AT 0 WITH
    PARTY `the State agency` DOES `make the stored benefits available to the household` AT 48
-- Expected: BREACH BY the State agency, with the reason, when the clock reaches 49 without the act.
#TRACE `s 2016(h)(12)(B)(ii)(II) duty to make the stored benefits available within 48 hours of the request` AT 0 WITH
    (WAITUNTIL 49)
-- Notice: the expunging date is 31 January 2026 and the clock starts on 20 December 2025, so the last day for notice (1 January 2026) is 12 days on. Expected FULFILLED at 12, BREACH once the clock reaches 13.
#TRACE `s 2016(h)(12)(C)(ii)(I) duty to give sufficient notice before expunging` 12 AT 0 WITH
    PARTY `the State agency` DOES `provide sufficient notice to the household that benefits will be expunged due to inactivity` AT 12
#TRACE `s 2016(h)(12)(C)(ii)(I) duty to give sufficient notice before expunging` 12 AT 0 WITH
    (WAITUNTIL 13)
-- the clock figure used above is the difference of two dates, checked here
#ASSERT Day (`s 2016(h)(12)(C)(ii) the last day for giving notice before expunging` (Date 31 1 2026)) MINUS Day (Date 20 12 2025) EQUALS 12

