IMPORT prelude
IMPORT daydate
IMPORT `snap-core`
IMPORT `snap2-3val`
IMPORT `snap2-2015a-c`

-- Tests of section 2015(a) to (c). Every expected value is decided from the words of the section (quoted beside it) before the run.

§ `Tests: 2015(a)`
-- "must also meet and comply with the specific requirements of this section to be eligible": both needed.
#ASSERT `s 2015(a) the household or individual is eligible to participate` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2015(a) the household or individual is eligible to participate` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2015(a) the household or individual is eligible to participate` (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `s 2015(a) the household or individual is eligible to participate` NOTHING (JUST TRUE) EQUALS NOTHING

§ `Tests: 2015(b)(1)`
-- argument order: found, statement, violation, purpose, occasion, controlled-substance occasion, firearms, 2024 conviction, item value
-- "(i) for a period of 1 year upon the first occasion"
#ASSERT `s 2015(b)(1) the period of ineligibility the finding carries` TRUE TRUE FALSE TRUE 1 0 FALSE FALSE 0 EQUALS `s 2015(b)(1) ineligible for a period` (`for a number of years` 1)
-- (A) false statement and (B) violation are alternatives ("or")
#ASSERT `s 2015(b)(1) the period of ineligibility the finding carries` TRUE FALSE TRUE TRUE 1 0 FALSE FALSE 0 EQUALS `s 2015(b)(1) ineligible for a period` (`for a number of years` 1)
-- "(ii) for a period of 2 years upon (I) the second occasion of any such determination"
#ASSERT `s 2015(b)(1) the period of ineligibility the finding carries` TRUE TRUE FALSE TRUE 2 0 FALSE FALSE 0 EQUALS `s 2015(b)(1) ineligible for a period` (`for a number of years` 2)
-- "(II) the first occasion of a finding by a Federal, State, or local court of the trading of a controlled substance"
#ASSERT `s 2015(b)(1) the period of ineligibility the finding carries` TRUE TRUE FALSE TRUE 1 1 FALSE FALSE 0 EQUALS `s 2015(b)(1) ineligible for a period` (`for a number of years` 2)
-- "(iii) permanently upon (I) the third occasion"
#ASSERT `s 2015(b)(1) the period of ineligibility the finding carries` TRUE TRUE FALSE TRUE 3 0 FALSE FALSE 0 EQUALS `s 2015(b)(1) ineligible for a period` `permanently`
-- "(II) the second occasion of a finding ... of the trading of a controlled substance"
#ASSERT `s 2015(b)(1) the period of ineligibility the finding carries` TRUE TRUE FALSE TRUE 1 2 FALSE FALSE 0 EQUALS `s 2015(b)(1) ineligible for a period` `permanently`
-- "(III) the first occasion of a finding ... of the trading of firearms, ammunition, or explosives for benefits"
#ASSERT `s 2015(b)(1) the period of ineligibility the finding carries` TRUE TRUE FALSE TRUE 1 0 TRUE FALSE 0 EQUALS `s 2015(b)(1) ineligible for a period` `permanently`
-- "(IV) a conviction ... having a value of $500 or more": 500 is enough, 499 is not
#ASSERT `s 2015(b)(1) the period of ineligibility the finding carries` TRUE TRUE FALSE TRUE 1 0 FALSE TRUE 500 EQUALS `s 2015(b)(1) ineligible for a period` `permanently`
#ASSERT `s 2015(b)(1) the period of ineligibility the finding carries` TRUE TRUE FALSE TRUE 1 0 FALSE TRUE 499 EQUALS `s 2015(b)(1) ineligible for a period` (`for a number of years` 1)
-- a $500 item with no conviction does not count
#ASSERT `s 2015(b)(1) the period of ineligibility the finding carries` TRUE TRUE FALSE TRUE 1 0 FALSE FALSE 900 EQUALS `s 2015(b)(1) ineligible for a period` (`for a number of years` 1)
-- the chapeau: "found by any State or Federal court or administrative agency to have intentionally ... for the purpose of"; outside that class the paragraph does not speak
#ASSERT `s 2015(b)(1) the period of ineligibility the finding carries` FALSE TRUE FALSE TRUE 1 0 FALSE FALSE 0 EQUALS `s 2015(b)(1) not covered`
#ASSERT `s 2015(b)(1) the period of ineligibility the finding carries` TRUE FALSE FALSE TRUE 1 0 FALSE FALSE 0 EQUALS `s 2015(b)(1) not covered`
#ASSERT `s 2015(b)(1) the period of ineligibility the finding carries` TRUE TRUE FALSE FALSE 1 0 FALSE FALSE 0 EQUALS `s 2015(b)(1) not covered`
-- not covered: a found person whose occasion count is below the first
#ASSERT `s 2015(b)(1) the period of ineligibility the finding carries` TRUE TRUE FALSE TRUE 0 0 FALSE FALSE 0 EQUALS `s 2015(b)(1) not covered`
-- the closing words: "no household shall receive increased benefits"
#ASSERT `s 2015(b)(1) the household may receive increased benefits as the result of the member's disqualification` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2015(b)(1) the household may receive increased benefits as the result of the member's disqualification` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 2015(b)(1) the household may receive increased benefits as the result of the member's disqualification` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 2015(b)(1) the household may receive increased benefits as the result of the member's disqualification` FALSE TRUE TRUE EQUALS NOTHING

§ `Tests: 2015(b)(2) to (4)`
-- argument order: alleged, hearing, referral
#ASSERT `s 2015(b)(2) the State agency has proceeded against the individual in a way the paragraph provides` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2015(b)(2) the State agency has proceeded against the individual in a way the paragraph provides` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 2015(b)(2) the State agency has proceeded against the individual in a way the paragraph provides` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2015(b)(2) the State agency has proceeded against the individual in a way the paragraph provides` FALSE TRUE TRUE EQUALS NOTHING
-- the duty is run: the State agency proceeds by an administrative hearing
#TRACE `s 2015(b)(2) the State agency must proceed against the individual` AT 0 WITH
    PARTY `the State agency` DOES `s 2015(b)(2) proceed by an administrative hearing` AT 1
#ASSERT `s 2015(b)(2) proceed by an administrative hearing` EQUALS `s 2015(b)(2) proceed by an administrative hearing`
#ASSERT `s 2015(b)(2) refer the matter for civil or criminal action in a court of law` EQUALS `s 2015(b)(2) refer the matter for civil or criminal action in a court of law`
-- (3): "shall remain in effect ... unless and until the finding ... is subsequently reversed"
#ASSERT `s 2015(b)(3) the period of ineligibility remains in effect` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2015(b)(3) the period of ineligibility remains in effect` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2015(b)(3) the period of ineligibility remains in effect` FALSE FALSE EQUALS NOTHING
#ASSERT `s 2015(b)(3) the period of ineligibility can be stayed administratively or reviewed` TRUE EQUALS JUST FALSE
#ASSERT `s 2015(b)(3) the period of ineligibility can be stayed administratively or reviewed` FALSE EQUALS NOTHING
-- (4): "No State shall withhold such information from the Secretary"
#ASSERT `s 2015(b)(4) the State may withhold the information from the Secretary` TRUE EQUALS JUST FALSE
#ASSERT `s 2015(b)(4) the State may withhold the information from the Secretary` FALSE EQUALS NOTHING

§ `Tests: 2015(c) intro`
-- argument order: transitional benefits, refuses, necessary
#ASSERT `s 2015(c) the household is ineligible for refusing to provide necessary information` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2015(c) the household is ineligible for refusing to provide necessary information` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2015(c) the household is ineligible for refusing to provide necessary information` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2015(c) the household is ineligible for refusing to provide necessary information` FALSE TRUE FALSE EQUALS JUST FALSE

§ `Tests: 2015(c)(1)`
-- (A) argument order: months, migrant, all members homeless, earned income, all adults elderly or disabled, accords with the Secretary's standards
-- "(i) for periods shorter than 4 months by migrant or seasonal farmworker households"
#ASSERT `s 2015(c)(1)(A) the State agency may require periodic reports for the period` 3 TRUE (JUST FALSE) TRUE (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 2015(c)(1)(A) the State agency may require periodic reports for the period` 4 TRUE (JUST FALSE) TRUE (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
-- "(ii) for periods shorter than 4 months by households in which all members are homeless individuals"
#ASSERT `s 2015(c)(1)(A) the State agency may require periodic reports for the period` 3 FALSE (JUST TRUE) TRUE (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 2015(c)(1)(A) the State agency may require periodic reports for the period` 4 FALSE (JUST TRUE) TRUE (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2015(c)(1)(A) the State agency may require periodic reports for the period` 3 FALSE NOTHING TRUE (JUST FALSE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 2015(c)(1)(A) the State agency may require periodic reports for the period` 3 FALSE (JUST FALSE) TRUE (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
-- "(iii) for periods shorter than 1 year by households that have no earned income and in which all adult members are elderly or disabled"
#ASSERT `s 2015(c)(1)(A) the State agency may require periodic reports for the period` 11 FALSE (JUST FALSE) FALSE (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 2015(c)(1)(A) the State agency may require periodic reports for the period` 12 FALSE (JUST FALSE) FALSE (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2015(c)(1)(A) the State agency may require periodic reports for the period` 11 FALSE (JUST FALSE) TRUE (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2015(c)(1)(A) the State agency may require periodic reports for the period` 11 FALSE (JUST FALSE) FALSE NOTHING (JUST TRUE) EQUALS NOTHING
-- the grant is "in accordance with standards prescribed by the Secretary": not stated, so not supplied is not covered
#ASSERT `s 2015(c)(1)(A) the State agency may require periodic reports for the period` 6 FALSE (JUST FALSE) TRUE (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 2015(c)(1)(A) the State agency may require periodic reports for the period` 6 FALSE (JUST FALSE) TRUE (JUST FALSE) (JUST FALSE) EQUALS NOTHING
-- (B) argument order: not required to file periodic reports, the Secretary considers the change necessary
#ASSERT `s 2015(c)(1)(B) the household is required to report the change in income or household circumstances` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2015(c)(1)(B) the household is required to report the change in income or household circumstances` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 2015(c)(1)(B) the household is required to report the change in income or household circumstances` TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 2015(c)(1)(B) the household is required to report the change in income or household circumstances` FALSE (JUST TRUE) EQUALS NOTHING
-- (C) argument order: on a reservation, (i), (ii), (iii), certification period in months, just cause shown
#ASSERT `s 2015(c)(1)(C) the State agency may require monthly periodic reporting by households on a reservation` (JUST TRUE) TRUE TRUE TRUE 24 FALSE EQUALS JUST TRUE
#ASSERT `s 2015(c)(1)(C) the State agency may require monthly periodic reporting by households on a reservation` (JUST TRUE) FALSE TRUE TRUE 24 FALSE EQUALS JUST FALSE
#ASSERT `s 2015(c)(1)(C) the State agency may require monthly periodic reporting by households on a reservation` (JUST TRUE) TRUE FALSE TRUE 24 FALSE EQUALS JUST FALSE
#ASSERT `s 2015(c)(1)(C) the State agency may require monthly periodic reporting by households on a reservation` (JUST TRUE) TRUE TRUE FALSE 24 FALSE EQUALS JUST FALSE
#ASSERT `s 2015(c)(1)(C) the State agency may require monthly periodic reporting by households on a reservation` (JUST TRUE) TRUE TRUE TRUE 12 FALSE EQUALS JUST FALSE
#ASSERT `s 2015(c)(1)(C) the State agency may require monthly periodic reporting by households on a reservation` (JUST TRUE) TRUE TRUE TRUE 12 TRUE EQUALS JUST TRUE
#ASSERT `s 2015(c)(1)(C) the State agency may require monthly periodic reporting by households on a reservation` (JUST FALSE) TRUE TRUE TRUE 24 FALSE EQUALS NOTHING
#ASSERT `s 2015(c)(1)(C) the State agency may require monthly periodic reporting by households on a reservation` NOTHING TRUE TRUE TRUE 24 FALSE EQUALS NOTHING
-- (D)(i) argument order: reports periodically, (A) or (C) provides otherwise, interval in months; "not less often than once each 6 months; but not more often than once each month"
#ASSERT `s 2015(c)(1)(D)(i) the State agency may require reports at the interval` TRUE FALSE 6 EQUALS JUST TRUE
#ASSERT `s 2015(c)(1)(D)(i) the State agency may require reports at the interval` TRUE FALSE 1 EQUALS JUST TRUE
-- review items 192a, 192c: the bounds are worded with "not" ("not less often than ...; but not more often than ..."), so outside them the answer is the text's no; these two were NOTHING before the triage of 2026-11-04
#ASSERT `s 2015(c)(1)(D)(i) the State agency may require reports at the interval` TRUE FALSE 7 EQUALS JUST FALSE
#ASSERT `s 2015(c)(1)(D)(i) the State agency may require reports at the interval` TRUE FALSE 0.5 EQUALS JUST FALSE
#ASSERT `s 2015(c)(1)(D)(i) the State agency may require reports at the interval` TRUE FALSE 0 EQUALS NOTHING
#ASSERT `s 2015(c)(1)(D)(i) the State agency may require reports at the interval` TRUE FALSE (0 MINUS 1) EQUALS NOTHING
#ASSERT `s 2015(c)(1)(D)(i) the State agency may require reports at the interval` TRUE TRUE 3 EQUALS NOTHING
#ASSERT `s 2015(c)(1)(D)(i) the State agency may require reports at the interval` FALSE FALSE 3 EQUALS NOTHING
-- (D)(ii) argument order: interval in months, income for the month, income standard; "less often than once each 3 months" is an interval above 3; "exceeds" is strictly above
#ASSERT `s 2015(c)(1)(D)(ii) the household must report in the manner the Secretary prescribes` 4 1001 1000 EQUALS JUST TRUE
#ASSERT `s 2015(c)(1)(D)(ii) the household must report in the manner the Secretary prescribes` 3 1001 1000 EQUALS NOTHING
#ASSERT `s 2015(c)(1)(D)(ii) the household must report in the manner the Secretary prescribes` 1 500 1000 EQUALS NOTHING
#ASSERT `s 2015(c)(1)(D)(ii) the household must report in the manner the Secretary prescribes` 4 1000 1000 EQUALS JUST FALSE

§ `Tests: 2015(c)(2) to (5)`
-- (2)(A) argument order: last day of the month, eligible and filed timely and completely, longer period determined, its days; "within thirty days of the end of that month"
#ASSERT `s 2015(c)(2)(A) the date by which the allotment must be received` (Date 31 1 2026) TRUE FALSE 0 EQUALS JUST (Date 2 3 2026)
#ASSERT `s 2015(c)(2)(A) the date by which the allotment must be received` (Date 31 1 2026) TRUE TRUE 45 EQUALS JUST (Date 17 3 2026)
#ASSERT `s 2015(c)(2)(A) the date by which the allotment must be received` (Date 31 1 2026) FALSE FALSE 0 EQUALS NOTHING
#TRACE `s 2015(c)(2)(A) the State agency must give the household its allotment within thirty days of the end of the month` AT 0 WITH
    PARTY `the State agency` DOES `s 2015(c)(2)(A) issue the allotment to the household` AT 30
#TRACE `s 2015(c)(2)(A) the State agency must give the household its allotment within thirty days of the end of the month` AT 0 WITH
    PARTY `the State agency` DOES `s 2015(c)(2)(A) issue the allotment to the household` AT 31
#ASSERT `s 2015(c)(2)(A) issue the allotment to the household` EQUALS `s 2015(c)(2)(A) issue the allotment to the household`
-- (B) argument order: required to file, every adult unable
#ASSERT `s 2015(c)(2)(B) the household is to have special procedures available for filing` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2015(c)(2)(B) the household is to have special procedures available for filing` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2015(c)(2)(B) the household is to have special procedures available for filing` FALSE TRUE EQUALS NOTHING
-- (D) argument order: required to file, failed to file timely or completely
#ASSERT `s 2015(c)(2)(D) the household is to be given prompt notice of the failure and a reasonable opportunity to cure` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2015(c)(2)(D) the household is to be given prompt notice of the failure and a reasonable opportunity to cure` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2015(c)(2)(D) the household is to be given prompt notice of the failure and a reasonable opportunity to cure` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2015(c)(2)(C) and (E) the household is to have a reasonable period to file and a simple form with clear instructions each month` TRUE EQUALS JUST TRUE
#ASSERT `s 2015(c)(2)(C) and (E) the household is to have a reasonable period to file and a simple form with clear instructions each month` FALSE EQUALS NOTHING
-- (3)
#ASSERT `s 2015(c)(3) the report is considered complete` TRUE EQUALS JUST TRUE
#ASSERT `s 2015(c)(3) the report is considered complete` FALSE EQUALS JUST FALSE
#ASSERT `s 2015(c)(3) the form is to carry a description of the civil and criminal provisions and penalties in prominent bold face lettering` TRUE EQUALS JUST TRUE
#ASSERT `s 2015(c)(3) the form is to carry a description of the civil and criminal provisions and penalties in prominent bold face lettering` FALSE EQUALS NOTHING
#ASSERT `s 2015(c)(3) a further reporting requirement may be imposed for the subject matter` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2015(c)(3) a further reporting requirement may be imposed for the subject matter` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2015(c)(3) a further reporting requirement may be imposed for the subject matter` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2015(c)(3) the household is to be given the opportunity to file reports at the same time under both Acts` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2015(c)(3) the household is to be given the opportunity to file reports at the same time under both Acts` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 2015(c)(3) the household is to be given the opportunity to file reports at the same time under both Acts` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 2015(c)(3) the household is to be given the opportunity to file reports at the same time under both Acts` FALSE TRUE TRUE EQUALS NOTHING
-- (4) argument order: fails to submit, paragraph (1)(C) provides otherwise, report since submitted
#ASSERT `s 2015(c)(4) the household shall not receive an allotment for the payment period to which the report applies` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2015(c)(4) the household shall not receive an allotment for the payment period to which the report applies` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2015(c)(4) the household shall not receive an allotment for the payment period to which the report applies` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2015(c)(4) the household shall not receive an allotment for the payment period to which the report applies` FALSE FALSE FALSE EQUALS NOTHING
-- (5) argument order: State agency requested, provision is in the excepted first sentence, necessary for similar requirements
#ASSERT `s 2015(c)(5) the Secretary is authorized to waive the provision` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 2015(c)(5) the Secretary is authorized to waive the provision` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2015(c)(5) the Secretary is authorized to waive the provision` FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 2015(c)(5) the Secretary is authorized to waive the provision` TRUE FALSE FALSE EQUALS NOTHING
