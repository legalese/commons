    THEN JUST TRUE   -- TRUE-kind: "the State shall exclude from the Project applicants or participating families or individuals affected by such amendments"
    ELSE JUST FALSE  -- FALSE-kind (the text says no in its own words): a failed "If ... are amended" (marginal reading (a))

