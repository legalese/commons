IMPORT prelude
IMPORT daydate
IMPORT `snap-core`
IMPORT `snap1-logic`
IMPORT `snap1-s2014-d`

-- Tests for 7 U.S.C. 2014(d). Expected values are written from the text before the code was run.

§ `s 2014(d) tests`

-- Chapeau: "shall include all income from whatever source excluding only" the paragraphs: the list is closed.
#ASSERT `s 2014(d) the item is included in household income` (LIST NOTHING, JUST TRUE, NOTHING) EQUALS JUST FALSE
#ASSERT `s 2014(d) the item is included in household income` (LIST NOTHING, NOTHING) EQUALS JUST TRUE
#ASSERT `s 2014(d) the item is included in household income` (LIST JUST FALSE, NOTHING) EQUALS JUST TRUE
#ASSERT `s 2014(d) the item is included in household income` EMPTY EQUALS JUST TRUE

-- (1)
#ASSERT `s 2014(d)(1) the item is excluded because it is not money payable directly to a household` TRUE EQUALS JUST TRUE
#ASSERT `s 2014(d)(1) the item is excluded because it is not money payable directly to a household` FALSE EQUALS NOTHING

-- (2): "not in excess of $30 in a quarter, subject to modification by the Secretary"
#ASSERT `s 2014(d)(2) the amount excluded in the quarter` TRUE 20 NOTHING EQUALS JUST 20
#ASSERT `s 2014(d)(2) the amount excluded in the quarter` TRUE 30 NOTHING EQUALS JUST 30
#ASSERT `s 2014(d)(2) the amount excluded in the quarter` TRUE 31 NOTHING EQUALS JUST 30
#ASSERT `s 2014(d)(2) the amount excluded in the quarter` TRUE 100 (JUST 50) EQUALS JUST 50
#ASSERT `s 2014(d)(2) the amount excluded in the quarter` TRUE 100 (JUST 10) EQUALS JUST 10
#ASSERT `s 2014(d)(2) the amount excluded in the quarter` FALSE 20 NOTHING EQUALS NOTHING

-- (3): an award to an enrolled member, up to the allowance (plus the loan's fees and premiums). Reading assumed: fees add to the allowance (finding F-D2).
#ASSERT `s 2014(d)(3) the amount excluded` TRUE TRUE 800 500 50 EQUALS JUST 550
#ASSERT `s 2014(d)(3) the amount excluded` TRUE TRUE 400 500 50 EQUALS JUST 400
#ASSERT `s 2014(d)(3) the amount excluded` TRUE TRUE 550 500 50 EQUALS JUST 550
#ASSERT `s 2014(d)(3) the amount excluded` TRUE FALSE 800 500 50 EQUALS NOTHING
#ASSERT `s 2014(d)(3) the amount excluded` FALSE TRUE 800 500 50 EQUALS NOTHING

-- (4)
#ASSERT `s 2014(d)(4) the loan is excluded` TRUE EQUALS JUST TRUE
#ASSERT `s 2014(d)(4) the loan is excluded` FALSE EQUALS NOTHING

-- (5): reimbursement, school allowance, the exception for a State agency that reduces TANF, the proviso.
#ASSERT `s 2014(d)(5) the item is excluded as a reimbursement or a school allowance` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2014(d)(5) the item is excluded as a reimbursement or a school allowance` FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2014(d)(5) the item is excluded as a reimbursement or a school allowance` FALSE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2014(d)(5) the item is excluded as a reimbursement or a school allowance` TRUE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2014(d)(5) the item is excluded as a reimbursement or a school allowance` TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2014(d)(5) the item is excluded as a reimbursement or a school allowance` FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING

-- (6)
#ASSERT `s 2014(d)(6) the item is excluded as care and maintenance of a third party or child support paid out` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2014(d)(6) the item is excluded as care and maintenance of a third party or child support paid out` FALSE TRUE TRUE EQUALS JUST TRUE
-- a child support payment the household member is not legally obligated to make fails the "if": JUST FALSE (marginal reading (a))
#ASSERT `s 2014(d)(6) the item is excluded as care and maintenance of a third party or child support paid out` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2014(d)(6) the item is excluded as care and maintenance of a third party or child support paid out` FALSE FALSE TRUE EQUALS NOTHING

-- (7): a child member, a school student, "17 years of age or younger"
#ASSERT `s 2014(d)(7) the child's earned income is excluded` TRUE TRUE 17 EQUALS JUST TRUE
#ASSERT `s 2014(d)(7) the child's earned income is excluded` TRUE TRUE 18 EQUALS NOTHING
#ASSERT `s 2014(d)(7) the child's earned income is excluded` TRUE FALSE 10 EQUALS NOTHING
#ASSERT `s 2014(d)(7) the child's earned income is excluded` FALSE TRUE 10 EQUALS NOTHING

-- (8): $300 in the aggregate in a quarter; lump sums; the resource proviso
#ASSERT `s 2014(d)(8) the cash donation excluded in the quarter` TRUE 250 EQUALS JUST 250
#ASSERT `s 2014(d)(8) the cash donation excluded in the quarter` TRUE 300 EQUALS JUST 300
#ASSERT `s 2014(d)(8) the cash donation excluded in the quarter` TRUE 301 EQUALS JUST 300
#ASSERT `s 2014(d)(8) the cash donation excluded in the quarter` FALSE 301 EQUALS NOTHING
#ASSERT `s 2014(d)(8) the lump-sum payment is excluded from income` TRUE EQUALS JUST TRUE
#ASSERT `s 2014(d)(8) the lump-sum payment is excluded from income` FALSE EQUALS NOTHING
#ASSERT `s 2014(d)(8) the excluded payment is counted as a resource` FALSE EQUALS JUST TRUE
#ASSERT `s 2014(d)(8) the excluded payment is counted as a resource` TRUE EQUALS JUST FALSE

-- (9): the cost is excluded; the excess over the farm income reduces the other income
#ASSERT `s 2014(d)(9) the cost of producing self-employed income that is excluded` 800 EQUALS 800
#ASSERT `s 2014(d)(9) the reduction of the other income that is included` 800 500 EQUALS 300
#ASSERT `s 2014(d)(9) the reduction of the other income that is included` 500 800 EQUALS 0
#ASSERT `s 2014(d)(9) the reduction of the other income that is included` 500 500 EQUALS 0

-- (10): "except as otherwise provided in subsection (k)"
#ASSERT `s 2014(d)(10) the income is excluded because another Federal law excludes it` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2014(d)(10) the income is excluded because another Federal law excludes it` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2014(d)(10) the income is excluded because another Federal law excludes it` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2014(d)(10) the income is excluded because another Federal law excludes it` FALSE FALSE EQUALS NOTHING

-- (11)(A) and (B)
#ASSERT `s 2014(d)(11) the payment or allowance is excluded` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2014(d)(11) the payment or allowance is excluded` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 2014(d)(11) the payment or allowance is excluded` FALSE FALSE EQUALS NOTHING

-- (12): a cost-of-living adjustment made on or after July 1 of the fiscal year, excluded through September 30
#ASSERT `s 2014(d)(12) the cost-of-living increase is excluded on the date` (Date 1 7 2026) (Date 30 9 2026) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2014(d)(12) the cost-of-living increase is excluded on the date` (Date 15 9 2026) (Date 15 9 2026) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2014(d)(12) the cost-of-living increase is excluded on the date` (Date 1 7 2026) (Date 1 10 2026) TRUE TRUE EQUALS NOTHING
#ASSERT `s 2014(d)(12) the cost-of-living increase is excluded on the date` (Date 30 6 2026) (Date 30 9 2026) TRUE TRUE EQUALS NOTHING
#ASSERT `s 2014(d)(12) the cost-of-living increase is excluded on the date` (Date 1 12 2025) (Date 30 9 2026) TRUE TRUE EQUALS NOTHING
#ASSERT `s 2014(d)(12) the cost-of-living increase is excluded on the date` (Date 1 7 2026) (Date 30 9 2026) FALSE TRUE EQUALS NOTHING
-- the household was not certified and received no allotment in the preceding month: the "if" fails, JUST FALSE (marginal reading (a))
#ASSERT `s 2014(d)(12) the cost-of-living increase is excluded on the date` (Date 1 7 2026) (Date 30 9 2026) TRUE FALSE EQUALS JUST FALSE
-- the "if" fails and the date is also outside the period: the failed "if" decides
#ASSERT `s 2014(d)(12) the cost-of-living increase is excluded on the date` (Date 1 7 2026) (Date 1 10 2026) TRUE FALSE EQUALS JUST FALSE

-- (13), (14), (15)
#ASSERT `s 2014(d)(13) the advance earned income credit payment is excluded` TRUE EQUALS JUST TRUE
#ASSERT `s 2014(d)(13) the advance earned income credit payment is excluded` FALSE EQUALS NOTHING
#ASSERT `s 2014(d)(14) the payment for work related expenses or dependent care is excluded` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2014(d)(14) the payment for work related expenses or dependent care is excluded` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2014(d)(14) the payment for work related expenses or dependent care is excluded` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2014(d)(15) the amount for a plan for achieving self-support is excluded` TRUE EQUALS JUST TRUE
#ASSERT `s 2014(d)(15) the amount for a plan for achieving self-support is excluded` FALSE EQUALS NOTHING

-- (16), (17), (18): at the option of the State agency
#ASSERT `s 2014(d)(16) the educational award is excluded at the option of the State agency` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2014(d)(16) the educational award is excluded at the option of the State agency` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 2014(d)(16) the educational award is excluded at the option of the State agency` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 2014(d)(16) the educational award is excluded at the option of the State agency` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 2014(d)(17) the State complementary assistance payment is excluded at the option of the State agency` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2014(d)(17) the State complementary assistance payment is excluded at the option of the State agency` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2014(d)(17) the State complementary assistance payment is excluded at the option of the State agency` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2014(d)(18) the income is excluded at the option of the State agency` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2014(d)(18) the income is excluded at the option of the State agency` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2014(d)(18) the income is excluded at the option of the State agency` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 2014(d)(18) the income is excluded at the option of the State agency` TRUE FALSE FALSE EQUALS NOTHING

-- (19): both conditions of (A) and (B)
#ASSERT `s 2014(d)(19) the combat pay is excluded` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
-- a payment of the kind that fails (A) or (B) fails the "if": JUST FALSE (marginal reading (a)); a payment outside the kind the paragraph names is not covered
#ASSERT `s 2014(d)(19) the combat pay is excluded` TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2014(d)(19) the combat pay is excluded` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2014(d)(19) the combat pay is excluded` TRUE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 2014(d)(19) the combat pay is excluded` FALSE TRUE TRUE FALSE EQUALS NOTHING

-- counting: what is left of an item, and the household's income
#ASSERT `s 2014(d) the monthly dollars excluded under a quarterly limit` 10 40 30 EQUALS 7.5
#ASSERT `s 2014(d) the monthly dollars excluded under a quarterly limit` 10 0 0 EQUALS 0
#ASSERT `s 2014(d) the monthly amount of the item that counts as income` 100 TRUE 0 EQUALS 0
#ASSERT `s 2014(d) the monthly amount of the item that counts as income` 100 FALSE 30 EQUALS 70
#ASSERT `s 2014(d) the monthly amount of the item that counts as income` 100 FALSE 150 EQUALS 0
#ASSERT `s 2014(d) the monthly amount of the item that counts as income` 100 FALSE 0 EQUALS 100
#ASSERT `s 2014(d) household income` (LIST 100, 200.5) 50.5 EQUALS 250
#ASSERT `s 2014(d) household income` EMPTY 0 EQUALS 0
