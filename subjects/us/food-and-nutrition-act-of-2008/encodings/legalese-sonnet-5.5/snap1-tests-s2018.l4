§ `s 2018(h) tests`

-- (2)(A): criteria established on 1 March 2015; 180 days run to 28 August 2015
#ASSERT `s 2018(h)(2)(A) the operation of the private establishment may continue without the determination of need` TRUE TRUE (Date 1 3 2015) (Date 28 8 2015) EQUALS JUST TRUE
#ASSERT `s 2018(h)(2)(A) the operation of the private establishment may continue without the determination of need` TRUE TRUE (Date 1 3 2015) (Date 29 8 2015) EQUALS NOTHING
#ASSERT `s 2018(h)(2)(A) the operation of the private establishment may continue without the determination of need` TRUE TRUE (Date 1 3 2015) (Date 1 3 2015) EQUALS JUST TRUE
#ASSERT `s 2018(h)(2)(A) the operation of the private establishment may continue without the determination of need` TRUE TRUE (Date 1 3 2015) (Date 1 1 2015) EQUALS JUST TRUE
-- the "if" of the sentence fails (no contract on the day before 7 February 2014, or the Secretary has determined the need): JUST FALSE (marginal reading (a))
#ASSERT `s 2018(h)(2)(A) the operation of the private establishment may continue without the determination of need` FALSE TRUE (Date 1 3 2015) (Date 1 4 2015) EQUALS JUST FALSE
#ASSERT `s 2018(h)(2)(A) the operation of the private establishment may continue without the determination of need` TRUE FALSE (Date 1 3 2015) (Date 1 4 2015) EQUALS JUST FALSE
-- (1): arguments are described in 2012(k)(3),(4),(9); the Secretary's determination of a documented need; the answer of (2)(A)
#ASSERT `s 2018(h)(1) the private establishment may be authorized to accept and redeem benefits` FALSE FALSE NOTHING EQUALS NOTHING
#ASSERT `s 2018(h)(1) the private establishment may be authorized to accept and redeem benefits` TRUE TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 2018(h)(1) the private establishment may be authorized to accept and redeem benefits` TRUE FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2018(h)(1) the private establishment may be authorized to accept and redeem benefits` TRUE FALSE NOTHING EQUALS JUST FALSE
#ASSERT `s 2018(h)(1) the private establishment may be authorized to accept and redeem benefits` TRUE FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2018(h)(1) the private establishment may be authorized to accept and redeem benefits` TRUE TRUE (JUST TRUE) EQUALS JUST TRUE
-- the BOOLEAN answer the keel asks for: FALSE only where the text says no
#ASSERT NOT (`s 2018(h) permitted under section 2018(h)` FALSE (JUST FALSE))
#ASSERT NOT (`s 2018(h) permitted under section 2018(h)` FALSE NOTHING)
#ASSERT `s 2018(h) permitted under section 2018(h)` FALSE (JUST TRUE)
#ASSERT `s 2018(h) permitted under section 2018(h)` TRUE (JUST FALSE)
#ASSERT `s 2018(h) permitted under section 2018(h)` TRUE NOTHING
#ASSERT `s 2018(h)(2)(B) the Secretary must provide justification to the State for the termination` TRUE EQUALS JUST TRUE
#ASSERT `s 2018(h)(2)(B) the Secretary must provide justification to the State for the termination` FALSE EQUALS JUST FALSE
-- (3): 90 days after the 30th of September is the 29th of December, in every year
#ASSERT `s 2018(h)(3) the date the report is due` 2014 EQUALS JUST (Date 29 12 2014)
#ASSERT `s 2018(h)(3) the date the report is due` 2016 EQUALS JUST (Date 29 12 2016)
#ASSERT `s 2018(h)(3) the date the report is due` 2023 EQUALS JUST (Date 29 12 2023)
#ASSERT `s 2018(h)(3) the date the report is due` 2013 EQUALS NOTHING
#ASSERT `s 2018(h)(3) the report was submitted not later than the date it was due` 2014 (Date 29 12 2014) EQUALS JUST TRUE
#ASSERT `s 2018(h)(3) the report was submitted not later than the date it was due` 2014 (Date 30 12 2014) EQUALS JUST FALSE
#ASSERT `s 2018(h)(3) the report was submitted not later than the date it was due` 2016 (Date 29 12 2016) EQUALS JUST TRUE
#ASSERT `s 2018(h)(3) the report was submitted not later than the date it was due` 2016 (Date 30 12 2016) EQUALS JUST FALSE
#ASSERT `s 2018(h)(3) the report was submitted not later than the date it was due` 2013 (Date 1 1 2014) EQUALS NOTHING
-- the regulative rule: submitted on day 90 is in time, on day 91 is a breach, and silence to day 100 is a breach
#TRACE `s 2018(h)(3) the duty to submit the report` AT 0 WITH
    PARTY `the Secretary` DOES `s 2018(h)(3) submit the report to the committees` AT 90
#TRACE `s 2018(h)(3) the duty to submit the report` AT 0 WITH
    PARTY `the Secretary` DOES `s 2018(h)(3) submit the report to the committees` AT 91
#TRACE `s 2018(h)(3) the duty to submit the report` AT 0 WITH
    (WAITUNTIL 100)

