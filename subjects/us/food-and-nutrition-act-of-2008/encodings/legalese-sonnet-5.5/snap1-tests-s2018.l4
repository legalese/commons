IMPORT prelude
IMPORT daydate
IMPORT `snap-core`
IMPORT `snap1-logic`
IMPORT `snap1-s2018`

-- Tests for 7 U.S.C. 2018. Expected values are written from the text before the code was run.

§ `s 2018(a) tests`

#ASSERT `s 2018(a)(1)(A) the applicant is to be approved under the regulations` TRUE EQUALS JUST TRUE
#ASSERT `s 2018(a)(1)(A) the applicant is to be approved under the regulations` FALSE EQUALS NOTHING
-- the five factors, and the list is not the whole of what may be considered
#ASSERT count `s 2018(a)(1)(B) the factors that must be considered among such other factors as may be appropriate` EQUALS 5
#ASSERT any (GIVEN f YIELD f EQUALS `s 2018(a)(1)(B)(i) the nature and extent of the food business conducted by the applicant`) `s 2018(a)(1)(B) the factors that must be considered among such other factors as may be appropriate`
#ASSERT any (GIVEN f YIELD f EQUALS `s 2018(a)(1)(B)(ii) the volume of benefit transactions which may reasonably be expected to be conducted by the applicant food store or wholesale food concern`) `s 2018(a)(1)(B) the factors that must be considered among such other factors as may be appropriate`
#ASSERT any (GIVEN f YIELD f EQUALS `s 2018(a)(1)(B)(iii) whether the applicant is located in an area with significantly limited access to food`) `s 2018(a)(1)(B) the factors that must be considered among such other factors as may be appropriate`
#ASSERT any (GIVEN f YIELD f EQUALS `s 2018(a)(1)(B)(iv) any information, if available, about the ability of the anticipated or existing electronic benefit transfer equipment and service provider of the applicant to provide sufficient information through the electronic benefit transfer system to minimize the risk of fraudulent transactions`) `s 2018(a)(1)(B) the factors that must be considered among such other factors as may be appropriate`
#ASSERT any (GIVEN f YIELD f EQUALS `s 2018(a)(1)(B)(v) the business integrity and reputation of the applicant`) `s 2018(a)(1)(B) the factors that must be considered among such other factors as may be appropriate`
#ASSERT `s 2018(a)(1)(C) the approval is evidenced by the issuance of a certificate of approval` TRUE EQUALS JUST TRUE
#ASSERT `s 2018(a)(1)(C) the approval is evidenced by the issuance of a certificate of approval` FALSE EQUALS NOTHING
#ASSERT `s 2018(a)(1)(C) the certificate of approval may be transferred` TRUE EQUALS JUST FALSE
#ASSERT `s 2018(a)(1)(C) the certificate of approval may be transferred` FALSE EQUALS NOTHING
-- (D): arguments are of a type the Secretary determined, and visited
#ASSERT `s 2018(a)(1)(D) the store or concern may be approved to be authorized or reauthorized` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2018(a)(1)(D) the store or concern may be approved to be authorized or reauthorized` TRUE TRUE EQUALS NOTHING
#ASSERT `s 2018(a)(1)(D) the store or concern may be approved to be authorized or reauthorized` FALSE FALSE EQUALS NOTHING
#ASSERT `s 2018(a)(1)(D) the store or concern may be approved to be authorized or reauthorized` FALSE TRUE EQUALS NOTHING

§ `s 2018(b) tests`

#ASSERT `s 2018(b)(1) the wholesale food concern may be authorized to accept and redeem benefits` FALSE EQUALS JUST FALSE
#ASSERT `s 2018(b)(1) the wholesale food concern may be authorized to accept and redeem benefits` TRUE EQUALS NOTHING
#ASSERT `s 2018(b)(1) the co-located wholesale-retail food concern may be authorized to accept and redeem benefits as a retail food store` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2018(b)(1) the co-located wholesale-retail food concern may be authorized to accept and redeem benefits as a retail food store` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2018(b)(1) the co-located wholesale-retail food concern may be authorized to accept and redeem benefits as a retail food store` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2018(b)(1) the co-located wholesale-retail food concern may be authorized to accept and redeem benefits as a retail food store` TRUE TRUE EQUALS NOTHING
#ASSERT `s 2018(b)(1) the firm may be authorized as both a retail food store and a wholesale food concern at the same time` TRUE EQUALS JUST FALSE
#ASSERT `s 2018(b)(1) the firm may be authorized as both a retail food store and a wholesale food concern at the same time` FALSE EQUALS NOTHING
-- (2)(A): arguments are disqualified under 2021(a), a bona fide buyer or transferee, full payment received
#ASSERT `s 2018(b)(2)(A) the buyer or transferee may accept or redeem benefits` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2018(b)(2)(A) the buyer or transferee may accept or redeem benefits` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 2018(b)(2)(A) the buyer or transferee may accept or redeem benefits` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 2018(b)(2)(A) the buyer or transferee may accept or redeem benefits` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 2018(b)(2)(B) the buyer or transferee may be required to furnish a bond under section 2021(d)` TRUE EQUALS JUST FALSE
#ASSERT `s 2018(b)(2)(B) the buyer or transferee may be required to furnish a bond under section 2021(d)` FALSE EQUALS NOTHING

§ `s 2018(c) tests`

-- arguments: Federal or State law enforcement, its purpose, a WIC State agency, its purpose
#ASSERT `s 2018(c) the information obtained under the subsection may be disclosed to and used by the recipient` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2018(c) the information obtained under the subsection may be disclosed to and used by the recipient` FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2018(c) the information obtained under the subsection may be disclosed to and used by the recipient` TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 2018(c) the information obtained under the subsection may be disclosed to and used by the recipient` TRUE FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 2018(c) the information obtained under the subsection may be disclosed to and used by the recipient` FALSE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 2018(c) the information obtained under the subsection may be disclosed to and used by the recipient` FALSE FALSE FALSE FALSE EQUALS NOTHING

GIVEN penalty IS A MAYBE `s 2018(c) penalty`
GIVETH A MAYBE NUMBER
`s 2018 test the greatest fine` MEANS
    CONSIDER penalty
        WHEN NOTHING THEN NOTHING
        WHEN JUST p THEN JUST (p's `s 2018(c) the greatest fine, in dollars`)

GIVEN penalty IS A MAYBE `s 2018(c) penalty`
GIVETH A MAYBE NUMBER
`s 2018 test the longest imprisonment` MEANS
    CONSIDER penalty
        WHEN NOTHING THEN NOTHING
        WHEN JUST p THEN JUST (p's `s 2018(c) the longest imprisonment, in years`)

#ASSERT `s 2018 test the greatest fine` (`s 2018(c) the penalty to which the person is liable` TRUE) EQUALS JUST 1000
#ASSERT `s 2018 test the longest imprisonment` (`s 2018(c) the penalty to which the person is liable` TRUE) EQUALS JUST 1
#ASSERT `s 2018 test the greatest fine` (`s 2018(c) the penalty to which the person is liable` FALSE) EQUALS NOTHING
-- within the limits (assumed, not ruled: a predicate named for the limits answers its own name): JUST TRUE, at the ceiling and below it. The other way: both NOTHING.
#ASSERT `s 2018(c) the sentence is within the limits the subsection sets` 1000 1 EQUALS JUST TRUE
#ASSERT `s 2018(c) the sentence is within the limits the subsection sets` 0 0 EQUALS JUST TRUE
#ASSERT `s 2018(c) the sentence is within the limits the subsection sets` 1001 0 EQUALS JUST FALSE
#ASSERT `s 2018(c) the sentence is within the limits the subsection sets` 0 2 EQUALS JUST FALSE
#ASSERT `s 2018(c) the sentence is within the limits the subsection sets` 1001 2 EQUALS JUST FALSE

