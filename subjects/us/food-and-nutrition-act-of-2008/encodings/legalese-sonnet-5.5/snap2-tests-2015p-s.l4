IMPORT prelude
IMPORT daydate
IMPORT `snap-core`
IMPORT `snap2-3val`
IMPORT `snap2-2015p-s`

-- Tests of section 2015(p) to (s). Expected values are decided from the quoted words before the run.

§ `Tests: 2015(p)`
-- argument order: found in a hearing under subsection (b), the finding is the conduct described
#ASSERT `s 2015(p) the person is ineligible for benefits` TRUE TRUE EQUALS JUST TRUE
-- a person outside the class "any person who has been found ... in a hearing under subsection (b)": the text does not say
#ASSERT `s 2015(p) the person is ineligible for benefits` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2015(p) the person is ineligible for benefits` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2015(p) the person is ineligible for benefits` FALSE FALSE EQUALS NOTHING
-- the length is the Secretary's, by regulation: the core's "not stated in this text" value, never a number
#ASSERT `s 2015(p) the period of ineligibility` TRUE TRUE EQUALS JUST `for a period the Secretary prescribes by regulation, not stated in this text`
#ASSERT `s 2015(p) the period of ineligibility` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2015(p) the period of ineligibility` TRUE FALSE EQUALS NOTHING

§ `Tests: 2015(q)`
#ASSERT `s 2015(q) the person is ineligible for benefits` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2015(q) the person is ineligible for benefits` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2015(q) the person is ineligible for benefits` TRUE FALSE EQUALS NOTHING
#ASSERT `s 2015(q) the person is ineligible for benefits` FALSE FALSE EQUALS NOTHING
#ASSERT `s 2015(q) the period of ineligibility` TRUE TRUE EQUALS JUST `for a period the Secretary prescribes by regulation, not stated in this text`
#ASSERT `s 2015(q) the period of ineligibility` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2015(q) the period of ineligibility` TRUE FALSE EQUALS NOTHING

§ `Tests: 2015(r)(1)`
-- clause (A): the offenses named in (i) to (v)
#ASSERT `s 2015(r)(1)(A) the offense is one of those named in clauses (i) to (v)` `s 2015(r)(1)(A)(i) aggravated sexual abuse under section 2241 of title 18` EQUALS JUST TRUE
#ASSERT `s 2015(r)(1)(A) the offense is one of those named in clauses (i) to (v)` `s 2015(r)(1)(A)(ii) murder under section 1111 of title 18` EQUALS JUST TRUE
#ASSERT `s 2015(r)(1)(A) the offense is one of those named in clauses (i) to (v)` `s 2015(r)(1)(A)(iii) an offense under chapter 110 of title 18` EQUALS JUST TRUE
#ASSERT `s 2015(r)(1)(A) the offense is one of those named in clauses (i) to (v)` `s 2015(r)(1)(A)(iv) a Federal or State offense involving sexual assault, as defined in section 13925(a) of title 42` EQUALS JUST TRUE
-- (v) turns on the Attorney General's determination, which the caller supplies
#ASSERT `s 2015(r)(1)(A) the offense is one of those named in clauses (i) to (v)` (`s 2015(r)(1)(A)(v) an offense under State law` OF (JUST TRUE)) EQUALS JUST TRUE
#ASSERT `s 2015(r)(1)(A) the offense is one of those named in clauses (i) to (v)` (`s 2015(r)(1)(A)(v) an offense under State law` OF (JUST FALSE)) EQUALS JUST FALSE
#ASSERT `s 2015(r)(1)(A) the offense is one of those named in clauses (i) to (v)` (`s 2015(r)(1)(A)(v) an offense under State law` OF NOTHING) EQUALS NOTHING
#ASSERT `s 2015(r)(1)(A) the offense is one of those named in clauses (i) to (v)` `s 2015(r)(1)(A) some other offense` EQUALS JUST FALSE

-- the whole paragraph; argument order: convicted of an offense, the offense, in compliance with the terms of the sentence, the answer of s 2015(k)(1) (the restrictions under subsection (k) bite)
#ASSERT `s 2015(r)(1) the individual is ineligible for benefits` TRUE `s 2015(r)(1)(A)(ii) murder under section 1111 of title 18` FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 2015(r)(1) the individual is ineligible for benefits` TRUE `s 2015(r)(1)(A)(ii) murder under section 1111 of title 18` TRUE (JUST TRUE) EQUALS JUST TRUE
-- convicted, complying with the sentence and not bound by (k): clause (B) fails
#ASSERT `s 2015(r)(1) the individual is ineligible for benefits` TRUE `s 2015(r)(1)(A)(ii) murder under section 1111 of title 18` TRUE (JUST FALSE) EQUALS JUST FALSE
-- clause (B) with the (k) answer not supplied: not complying with the sentence is enough, complying is not
#ASSERT `s 2015(r)(1) the individual is ineligible for benefits` TRUE `s 2015(r)(1)(A)(ii) murder under section 1111 of title 18` FALSE NOTHING EQUALS JUST TRUE
#ASSERT `s 2015(r)(1) the individual is ineligible for benefits` TRUE `s 2015(r)(1)(A)(ii) murder under section 1111 of title 18` TRUE NOTHING EQUALS NOTHING
-- not convicted of an offense: clause (A) fails
#ASSERT `s 2015(r)(1) the individual is ineligible for benefits` FALSE `s 2015(r)(1)(A)(ii) murder under section 1111 of title 18` FALSE (JUST TRUE) EQUALS JUST FALSE
-- convicted of some other offense: clause (A) fails
#ASSERT `s 2015(r)(1) the individual is ineligible for benefits` TRUE `s 2015(r)(1)(A) some other offense` FALSE (JUST TRUE) EQUALS JUST FALSE
-- (v) with no determination supplied and clause (B) met: not covered; with clause (B) not met: the offense decides
#ASSERT `s 2015(r)(1) the individual is ineligible for benefits` TRUE (`s 2015(r)(1)(A)(v) an offense under State law` OF NOTHING) FALSE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 2015(r)(1) the individual is ineligible for benefits` TRUE (`s 2015(r)(1)(A)(v) an offense under State law` OF NOTHING) TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2015(r)(1) the individual is ineligible for benefits` TRUE (`s 2015(r)(1)(A)(v) an offense under State law` OF (JUST TRUE)) FALSE NOTHING EQUALS JUST TRUE

§ `Tests: 2015(r)(2) and (3)`
-- (2) the individual to whom paragraph (1) applies is not counted as a member, and the income and resources are
#ASSERT `s 2015(r)(2) the individual is counted as a member of the household` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 2015(r)(2) the individual is counted as a member of the household` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 2015(r)(2) the individual is counted as a member of the household` NOTHING EQUALS NOTHING
#ASSERT `s 2015(r)(2) the number of members of the household counted in determining the amount of benefits` 4 (JUST TRUE) EQUALS JUST 3
#ASSERT `s 2015(r)(2) the number of members of the household counted in determining the amount of benefits` 1 (JUST TRUE) EQUALS JUST 0
#ASSERT `s 2015(r)(2) the number of members of the household counted in determining the amount of benefits` 0 (JUST TRUE) EQUALS NOTHING
#ASSERT `s 2015(r)(2) the number of members of the household counted in determining the amount of benefits` 4 (JUST FALSE) EQUALS NOTHING
#ASSERT `s 2015(r)(2) the number of members of the household counted in determining the amount of benefits` 4 NOTHING EQUALS NOTHING
#ASSERT `s 2015(r)(2) the income and resources of the individual are counted as income and resources of the household` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2015(r)(2) the income and resources of the individual are counted as income and resources of the household` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 2015(r)(2) the income and resources of the individual are counted as income and resources of the household` NOTHING EQUALS NOTHING
-- (3) the State's duty towards "each individual applying"
#ASSERT `s 2015(r)(3) the State is required to require the individual to attest to whether the individual or any member of the household has been convicted of a crime described in paragraph (1)` TRUE EQUALS JUST TRUE
#ASSERT `s 2015(r)(3) the State is required to require the individual to attest to whether the individual or any member of the household has been convicted of a crime described in paragraph (1)` FALSE EQUALS NOTHING

§ `Tests: 2015(s)`
-- (1) argument order: a member received lottery or gambling winnings, the Secretary has determined they are substantial
#ASSERT `s 2015(s)(1) the household loses eligibility for benefits upon receipt of the winnings` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2015(s)(1) the household loses eligibility for benefits upon receipt of the winnings` TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 2015(s)(1) the household loses eligibility for benefits upon receipt of the winnings` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 2015(s)(1) the household loses eligibility for benefits upon receipt of the winnings` FALSE (JUST TRUE) EQUALS NOTHING
-- (2) argument order: paragraph (1) applies, the household meets the section 2014 requirements
#ASSERT `s 2015(s)(2) the household remains ineligible for participation` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 2015(s)(2) the household remains ineligible for participation` (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 2015(s)(2) the household remains ineligible for participation` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 2015(s)(2) the household remains ineligible for participation` (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 2015(s)(2) the household remains ineligible for participation` NOTHING (JUST FALSE) EQUALS NOTHING
-- (1) and (2) on a date; argument order: winnings received, substantial, the date received, the date asked about, the requirements met between the receipt and the date
#ASSERT `s 2015(s) the household is ineligible on the date` TRUE (JUST TRUE) (Date 10 3 2027) (Date 10 3 2027) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 2015(s) the household is ineligible on the date` TRUE (JUST TRUE) (Date 10 3 2027) (Date 1 9 2027) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 2015(s) the household is ineligible on the date` TRUE (JUST TRUE) (Date 10 3 2027) (Date 1 9 2027) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 2015(s) the household is ineligible on the date` TRUE (JUST TRUE) (Date 10 3 2027) (Date 1 9 2027) NOTHING EQUALS NOTHING
-- before the receipt the text is silent
#ASSERT `s 2015(s) the household is ineligible on the date` TRUE (JUST TRUE) (Date 10 3 2027) (Date 9 3 2027) (JUST FALSE) EQUALS NOTHING
-- outside the class of paragraph (1)
#ASSERT `s 2015(s) the household is ineligible on the date` FALSE (JUST TRUE) (Date 10 3 2027) (Date 1 9 2027) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 2015(s) the household is ineligible on the date` TRUE (JUST FALSE) (Date 10 3 2027) (Date 1 9 2027) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 2015(s) the household is ineligible on the date` TRUE NOTHING (Date 10 3 2027) (Date 1 9 2027) (JUST FALSE) EQUALS NOTHING
-- (3) the State agency's duty, "to the maximum extent practicable"
#ASSERT `s 2015(s)(3) the State agency is required to establish agreements with the entities responsible for the regulation or sponsorship of gaming in the State` TRUE EQUALS JUST TRUE
#ASSERT `s 2015(s)(3) the State agency is required to establish agreements with the entities responsible for the regulation or sponsorship of gaming in the State` FALSE EQUALS NOTHING
