@lang en

-- tests-ch3.l4 : tests for us-ch3-codes.l4 (sections 201 to 208 and 210 to 213).
-- Expected values come from the text of each section, decided before the run. A FALSE for a "section N provides"
-- function reads "section N does not provide this"; those assertions are written NOT ....

IMPORT prelude
IMPORT daydate
IMPORT `us-nouns`
IMPORT `us-interpretation-time`
IMPORT `us-ch3-codes`

§ `Section 201(a) - dispensing with slip or pamphlet publication`

--                                                                                          enumerated, enacted, committee directs
#ASSERT     `section 201(a) dispenses with publication in slip or pamphlet form or in the Statutes at Large` TRUE  TRUE  TRUE
#ASSERT NOT `section 201(a) dispenses with publication in slip or pamphlet form or in the Statutes at Large` FALSE TRUE  TRUE
#ASSERT NOT `section 201(a) dispenses with publication in slip or pamphlet form or in the Statutes at Large` TRUE  FALSE TRUE
#ASSERT NOT `section 201(a) dispenses with publication in slip or pamphlet form or in the Statutes at Large` TRUE  TRUE  FALSE

§ `Section 201(b) - curtailing the number`

-- the Committee directs 500 and 300 are needed for depository libraries and sale: 500 (fork F-201b, the floor reading)
#ASSERT `the number to be printed and distributed once section 201(b) is applied` TRUE 500 300 EQUALS 500
-- the Committee directs 100 but 300 are needed: the exception raises it to 300
#ASSERT `the number to be printed and distributed once section 201(b) is applied` TRUE 100 300 EQUALS 300
#ASSERT `the number to be printed and distributed once section 201(b) is applied` TRUE 300 300 EQUALS 300
-- a publication not enumerated in sections 202 and 203: the section says nothing
#ASSERT REFUSED `the number to be printed and distributed once section 201(b) is applied` FALSE 500 300 BECAUSE "section 201(b) speaks only to the volumes and publications enumerated in sections 202 and 203"

§ `Section 201(c) - one supplement for each Congress`

-- "at least one supplement to each such code, containing the legislation of such Congress": dispensing with this one is allowed only if another remains
#ASSERT     `section 201(c) lets the Committee dispense with the printing and distribution of the supplement` 1
#ASSERT     `section 201(c) lets the Committee dispense with the printing and distribution of the supplement` 2
#ASSERT NOT `section 201(c) lets the Committee dispense with the printing and distribution of the supplement` 0

§ `Section 202(c) - no new edition oftener than once in each five years`

-- the previous new edition on 2020-03-01: five years later is 2025-03-01
#ASSERT     `section 202(c) allows a new edition to be published on the day` (YMD 2020 3 1) (YMD 2025 3 1)
#ASSERT     `section 202(c) allows a new edition to be published on the day` (YMD 2020 3 1) (YMD 2025 3 2)
#ASSERT NOT `section 202(c) allows a new edition to be published on the day` (YMD 2020 3 1) (YMD 2025 2 28)
#ASSERT NOT `section 202(c) allows a new edition to be published on the day` (YMD 2020 3 1) (YMD 2020 3 1)
-- a previous edition on 2019-02-28: five years later is 2024-02-28, and 2024 has a 29 February
#ASSERT     `section 202(c) allows a new edition to be published on the day` (YMD 2019 2 28) (YMD 2024 2 28)
#ASSERT NOT `section 202(c) allows a new edition to be published on the day` (YMD 2019 2 28) (YMD 2024 2 27)
-- a previous edition on 29 February 2024: 2029 has no 29 February, and Title 1 does not say what follows
#ASSERT REFUSED `section 202(c) allows a new edition to be published on the day` (YMD 2024 2 29) (YMD 2029 3 1) BECAUSE "the same calendar date does not exist that many years after the date, and Title 1 does not say what then"

#ASSERT     `section 202(c) forbids the supplement to contain the legislation of an earlier supplement` TRUE  TRUE
#ASSERT NOT `section 202(c) forbids the supplement to contain the legislation of an earlier supplement` TRUE  FALSE
#ASSERT NOT `section 202(c) forbids the supplement to contain the legislation of an earlier supplement` FALSE TRUE

§ `Section 207 - slip copies`

#ASSERT `the number of additional copies in slip form that section 207 directs to be printed` TRUE  FALSE EQUALS JUST 20
#ASSERT `the number of additional copies in slip form that section 207 directs to be printed` FALSE TRUE  EQUALS JUST 20
#ASSERT `the number of additional copies in slip form that section 207 directs to be printed` TRUE  TRUE  EQUALS JUST 20
-- a private Act is not a "public Act" and is not a joint resolution: the section directs none
#ASSERT `the number of additional copies in slip form that section 207 directs to be printed` FALSE FALSE EQUALS NOTHING

§ `Section 208 - delegation`

#ASSERT     `section 208 allows the function to be vested in another agency` 201 TRUE
#ASSERT     `section 208 allows the function to be vested in another agency` 202 TRUE
#ASSERT NOT `section 208 allows the function to be vested in another agency` 203 TRUE
#ASSERT     `section 208 allows the function to be vested in another agency` 204 TRUE
#ASSERT     `section 208 allows the function to be vested in another agency` 205 TRUE
#ASSERT     `section 208 allows the function to be vested in another agency` 206 TRUE
#ASSERT     `section 208 allows the function to be vested in another agency` 207 TRUE
#ASSERT NOT `section 208 allows the function to be vested in another agency` 208 TRUE
#ASSERT NOT `section 208 allows the function to be vested in another agency` 209 TRUE
#ASSERT NOT `section 208 allows the function to be vested in another agency` 200 TRUE
-- the concurrent resolution is a condition
#ASSERT NOT `section 208 allows the function to be vested in another agency` 201 FALSE

#ASSERT     `section 208 puts the printing, binding and distribution under the direction of the Joint Committee on Printing` TRUE
#ASSERT NOT `section 208 puts the printing, binding and distribution under the direction of the Joint Committee on Printing` FALSE

§ `Section 210 - slip and pamphlet copies of the District of Columbia Code and supplements`

#ASSERT     `section 210 says the copy need not be printed or distributed` TRUE
#ASSERT NOT `section 210 says the copy need not be printed or distributed` FALSE

§ `Section 211 - copies to Members of Congress`

-- 10 for each of 100 Members, 10 times 20 members of the two Judiciary Committees, and 1 for each of 15 committees
#ASSERT `the number of copies of each publication that section 211 requires, in addition to the quotas of section 210` 100 20 15 EQUALS 1215
#ASSERT `the number of copies of each publication that section 211 requires, in addition to the quotas of section 210` 10 4 3 EQUALS 143
#ASSERT `the number of copies of each publication that section 211 requires, in addition to the quotas of section 210` 0 0 0 EQUALS 0

§ `Section 212 - additional distribution at each new Congress`

--                                                                                     Member, first session, applied, certified, volume, already received
#ASSERT     `section 212 requires the Superintendent of Documents to supply the person one copy of the volume` TRUE  TRUE  TRUE  TRUE  TRUE  0
#ASSERT NOT `section 212 requires the Superintendent of Documents to supply the person one copy of the volume` FALSE TRUE  TRUE  TRUE  TRUE  0
#ASSERT NOT `section 212 requires the Superintendent of Documents to supply the person one copy of the volume` TRUE  FALSE TRUE  TRUE  TRUE  0
#ASSERT NOT `section 212 requires the Superintendent of Documents to supply the person one copy of the volume` TRUE  TRUE  FALSE TRUE  TRUE  0
#ASSERT NOT `section 212 requires the Superintendent of Documents to supply the person one copy of the volume` TRUE  TRUE  TRUE  FALSE TRUE  0
#ASSERT NOT `section 212 requires the Superintendent of Documents to supply the person one copy of the volume` TRUE  TRUE  TRUE  TRUE  FALSE 0
-- "no Senator or Representative during his term of service shall receive under this section more than one copy each"
#ASSERT NOT `section 212 requires the Superintendent of Documents to supply the person one copy of the volume` TRUE  TRUE  TRUE  TRUE  TRUE  1
#ASSERT NOT `section 212 requires the Superintendent of Documents to supply the person one copy of the volume` TRUE  TRUE  TRUE  TRUE  TRUE  2

§ `Section 213 - appropriation`

#ASSERT `the annual appropriation in dollars that section 213 authorizes` TRUE EQUALS 6500
#ASSERT REFUSED `the annual appropriation in dollars that section 213 authorizes` FALSE BECAUSE "section 213 authorizes an appropriation only to carry out the purposes of sections 202 and 203"
