@lang en

-- tests-112b.l4 : tests for us-ch2-international-agreements.l4 (sections 112a(b) and 112b).
-- Dates are worked by hand from the calendar and written down before the run. A FALSE for a "section N provides" function
-- reads "section N does not provide this"; those assertions are written NOT ....

IMPORT prelude
IMPORT daydate
IMPORT `us-nouns`
IMPORT `us-interpretation-time`
IMPORT `us-ch2-international-agreements`

§ `Fixtures`

--                                                 classified, military, foreign assistance, project annex, separately published
`an instrument in no category`        MEANS `An instrument under section 112b` OF FALSE, FALSE, FALSE, FALSE, FALSE
`an instrument in category A`         MEANS `An instrument under section 112b` OF TRUE,  FALSE, FALSE, FALSE, FALSE
`an instrument in category B`         MEANS `An instrument under section 112b` OF FALSE, TRUE,  FALSE, FALSE, FALSE
`an instrument in category C`         MEANS `An instrument under section 112b` OF FALSE, FALSE, TRUE,  FALSE, FALSE
`an instrument in category D`         MEANS `An instrument under section 112b` OF FALSE, FALSE, FALSE, TRUE,  FALSE
`an instrument in category E`         MEANS `An instrument under section 112b` OF FALSE, FALSE, FALSE, FALSE, TRUE

§ `Section 112b(b)(3) - exemptions`

#ASSERT NOT `section 112b(b)(3) exempts the text of the instrument from the posting requirements` `an instrument in no category`
#ASSERT     `section 112b(b)(3) exempts the text of the instrument from the posting requirements` `an instrument in category A`
#ASSERT     `section 112b(b)(3) exempts the text of the instrument from the posting requirements` `an instrument in category B`
#ASSERT     `section 112b(b)(3) exempts the text of the instrument from the posting requirements` `an instrument in category C`
#ASSERT     `section 112b(b)(3) exempts the text of the instrument from the posting requirements` `an instrument in category D`
#ASSERT     `section 112b(b)(3) exempts the text of the instrument from the posting requirements` `an instrument in category E`
-- the information on legal authority and implementation stays in for category E: "except that the Secretary shall make the information ... available"
#ASSERT NOT `section 112b(b)(3) exempts the information on legal authority and implementation from the posting requirements` `an instrument in no category`
#ASSERT     `section 112b(b)(3) exempts the information on legal authority and implementation from the posting requirements` `an instrument in category A`
#ASSERT     `section 112b(b)(3) exempts the information on legal authority and implementation from the posting requirements` `an instrument in category B`
#ASSERT     `section 112b(b)(3) exempts the information on legal authority and implementation from the posting requirements` `an instrument in category C`
#ASSERT     `section 112b(b)(3) exempts the information on legal authority and implementation from the posting requirements` `an instrument in category D`
#ASSERT NOT `section 112b(b)(3) exempts the information on legal authority and implementation from the posting requirements` `an instrument in category E`
#ASSERT     `the instrument is described in section 112b(b)(3)(A)` `an instrument in category A`
#ASSERT NOT `the instrument is described in section 112b(b)(3)(A)` `an instrument in category B`
#ASSERT NOT `the instrument is described in section 112b(b)(3)(A)` `an instrument in category E`

§ `Section 112a(b) - copies on request`

--                                                                               in possession, published, request
#ASSERT     `section 112a(b) requires the Department of State to make the copy available` `an instrument in no category` TRUE FALSE TRUE
#ASSERT NOT `section 112a(b) requires the Department of State to make the copy available` `an instrument in no category` TRUE TRUE  TRUE
#ASSERT NOT `section 112a(b) requires the Department of State to make the copy available` `an instrument in no category` TRUE FALSE FALSE
#ASSERT NOT `section 112a(b) requires the Department of State to make the copy available` `an instrument in no category` FALSE FALSE TRUE
-- only category (A) is taken out ("other than the agreements described in section 112b(b)(3)(A)")
#ASSERT NOT `section 112a(b) requires the Department of State to make the copy available` `an instrument in category A` TRUE FALSE TRUE
#ASSERT     `section 112a(b) requires the Department of State to make the copy available` `an instrument in category B` TRUE FALSE TRUE
#ASSERT     `section 112a(b) requires the Department of State to make the copy available` `an instrument in category E` TRUE FALSE TRUE

§ `Section 112b(a) - reports`

#ASSERT REFUSED `Title 1 does not say what a month is, so section 112b(a) cannot fix the days of once each month or of the prior month` BECAUSE "Title 1 does not say what a month is, so section 112b(a) cannot fix the days of once each month or of the prior month"
#ASSERT     `section 112b(a)(1)(B)(ii) requires the text to be provided again` TRUE  TRUE
#ASSERT NOT `section 112b(a)(1)(B)(ii) requires the text to be provided again` TRUE  FALSE
#ASSERT NOT `section 112b(a)(1)(B)(ii) requires the text to be provided again` FALSE TRUE
#ASSERT     `section 112b(a)(2) allows the submission` TRUE
#ASSERT NOT `section 112b(a)(2) allows the submission` FALSE

§ `Section 112b(b) - posting`

-- 120 days after 2026-01-01: 30 days left in January after the 1st, 28 in February, 31 in March, 30 in April, so the 120th day is 2026-05-01
#ASSERT `the latest day to post the text of an international agreement under section 112b(b)(1)` (YMD 2026 1 1) EQUALS YMD 2026 5 1
-- a leap year: 2024-01-01 + 31 + 29 + 31 + 29 = 2024-04-30
#ASSERT `the latest day to post the text of an international agreement under section 112b(b)(1)` (YMD 2024 1 1) EQUALS YMD 2024 4 30
-- across a year end: 2024-12-31 + 31 + 28 + 31 + 30 = 2025-04-30
#ASSERT `the latest day to post the text of an international agreement under section 112b(b)(1)` (YMD 2024 12 31) EQUALS YMD 2025 4 30
#ASSERT `the latest day for the next posting of qualifying non-binding instruments under section 112b(b)(2)` (YMD 2026 1 1) EQUALS YMD 2026 5 1

-- the posting is on 2026-05-01; the preceding 120 days are 2026-01-01 to 2026-04-30
#ASSERT     `section 112b(b)(2) covers the instrument in the posting` (YMD 2026 1 1)  (YMD 2026 5 1)
#ASSERT     `section 112b(b)(2) covers the instrument in the posting` (YMD 2026 4 30) (YMD 2026 5 1)
#ASSERT NOT `section 112b(b)(2) covers the instrument in the posting` (YMD 2025 12 31) (YMD 2026 5 1)
#ASSERT NOT `section 112b(b)(2) covers the instrument in the posting` (YMD 2026 5 1)  (YMD 2026 5 1)
#ASSERT NOT `section 112b(b)(2) covers the instrument in the posting` (YMD 2026 5 2)  (YMD 2026 5 1)

§ `Section 112b(c) and (d) - the 30-day and 15-day deadlines`

-- 2026-03-10 + 21 days is 2026-03-31, and 9 more is 2026-04-09
#ASSERT `the latest day to submit the implementing agreements or arrangements under section 112b(c)` (YMD 2026 3 10) EQUALS YMD 2026 4 9
-- 2024-02-10 + 19 days is 2024-02-29 and 11 more is 2024-03-11
#ASSERT `the latest day to submit the implementing agreements or arrangements under section 112b(c)` (YMD 2024 2 10) EQUALS YMD 2024 3 11
#ASSERT `the latest day for an agency to provide the text of an international agreement to the Secretary under section 112b(d)(1)` (YMD 2026 1 20) EQUALS YMD 2026 2 4
#ASSERT `the latest day for an agency to provide the text of a qualifying non-binding instrument to the Secretary under section 112b(d)(2)` (YMD 2025 12 25) EQUALS YMD 2026 1 9
#ASSERT `the latest day for an agency to provide the description of legal authority to the Secretary under section 112b(d)(3)` (YMD 2026 2 20) EQUALS YMD 2026 3 7
#ASSERT `the latest day for an agency to provide the description of legal authority to the Secretary under section 112b(d)(3)` (YMD 2028 2 20) EQUALS YMD 2028 3 6

§ `Section 112b(f) and (g)`

#ASSERT     `section 112b(f) requires the substance of the agreement to be reduced to writing for the purpose of subsections (a) and (b)` TRUE
#ASSERT NOT `section 112b(f) requires the substance of the agreement to be reduced to writing for the purpose of subsections (a) and (b)` FALSE
#ASSERT     `section 112b(g) allows the agreement to be signed or otherwise concluded on behalf of the United States` TRUE
#ASSERT NOT `section 112b(g) allows the agreement to be signed or otherwise concluded on behalf of the United States` FALSE

§ `Section 112b(h) - audits`

-- the section is enacted on 2023-06-15: the first audit by 2026-06-15, the next by 2029-06-15, and 2032-06-15 is the first day after the nine-year period
#ASSERT `the latest day for the first audit under section 112b(h)(1)` (YMD 2023 6 15) EQUALS YMD 2026 6 15
#ASSERT `the latest day for the next audit after an audit under section 112b(h)(1)` (YMD 2026 6 15) (YMD 2023 6 15) EQUALS YMD 2029 6 15
#ASSERT     `section 112b(h)(1) requires a further audit after an audit` (YMD 2026 6 15) (YMD 2023 6 15)
#ASSERT NOT `section 112b(h)(1) requires a further audit after an audit` (YMD 2029 6 15) (YMD 2023 6 15)
-- an audit made earlier than the deadline moves the next one earlier
#ASSERT     `section 112b(h)(1) requires a further audit after an audit` (YMD 2028 12 31) (YMD 2023 6 15)
#ASSERT NOT `section 112b(h)(1) requires a further audit after an audit` (YMD 2029 6 16) (YMD 2023 6 15)
-- an enactment on 29 February: three years later has no 29 February
#ASSERT REFUSED `the latest day for the first audit under section 112b(h)(1)` (YMD 2024 2 29) BECAUSE "the same calendar date does not exist that many years after the date, and Title 1 does not say what then"
#ASSERT REFUSED `section 112b(h)(1) requires a further audit after an audit` (YMD 2027 3 1) (YMD 2024 2 29) BECAUSE "the same calendar date does not exist that many years after the date, and Title 1 does not say what then"

§ `Section 112b(k) - definitions`

#ASSERT     `section 112b(k)(4) expressly includes the matter in the term international agreement` TRUE  FALSE
#ASSERT     `section 112b(k)(4) expressly includes the matter in the term international agreement` FALSE TRUE
#ASSERT NOT `section 112b(k)(4) expressly includes the matter in the term international agreement` FALSE FALSE

--                                                           (i) abroad, (I) foreign-policy impact, (II) written communication, DoD exclusion
`a qualifying instrument by foreign policy impact`    MEANS `A non-binding instrument` OF TRUE,  TRUE,  FALSE, FALSE
`a qualifying instrument by written communication`    MEANS `A non-binding instrument` OF TRUE,  FALSE, TRUE,  FALSE
`an instrument under Defense authorities`             MEANS `A non-binding instrument` OF TRUE,  TRUE,  TRUE,  TRUE
`an instrument not dealt with abroad`                 MEANS `A non-binding instrument` OF FALSE, TRUE,  TRUE,  FALSE
`an instrument of no foreign policy significance`     MEANS `A non-binding instrument` OF TRUE,  FALSE, FALSE, FALSE

#ASSERT     `the instrument is a qualifying non-binding instrument` `a qualifying instrument by foreign policy impact`
#ASSERT     `the instrument is a qualifying non-binding instrument` `a qualifying instrument by written communication`
#ASSERT NOT `the instrument is a qualifying non-binding instrument` `an instrument under Defense authorities`
#ASSERT NOT `the instrument is a qualifying non-binding instrument` `an instrument not dealt with abroad`
#ASSERT NOT `the instrument is a qualifying non-binding instrument` `an instrument of no foreign policy significance`

--                                                                                   annex etc, implementing, in conjunction
#ASSERT     `section 112b(k)(7) expressly includes the document in the text of the agreement or instrument` TRUE  FALSE TRUE
#ASSERT     `section 112b(k)(7) expressly includes the document in the text of the agreement or instrument` FALSE TRUE  TRUE
#ASSERT NOT `section 112b(k)(7) expressly includes the document in the text of the agreement or instrument` FALSE FALSE TRUE
#ASSERT NOT `section 112b(k)(7) expressly includes the document in the text of the agreement or instrument` TRUE  FALSE FALSE
#ASSERT NOT `section 112b(k)(7) expressly includes the document in the text of the agreement or instrument` FALSE TRUE  FALSE

§ `Section 112b(l) - non-construction`

#ASSERT     `section 112b does not authorize withholding the record from the public` TRUE
#ASSERT NOT `section 112b does not authorize withholding the record from the public` FALSE
#ASSERT     `section 112b does not require the provision of the implementing material` TRUE  FALSE
#ASSERT NOT `section 112b does not require the provision of the implementing material` TRUE  TRUE
#ASSERT NOT `section 112b does not require the provision of the implementing material` FALSE FALSE
