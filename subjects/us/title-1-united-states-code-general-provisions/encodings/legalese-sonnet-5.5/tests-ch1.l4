@lang en

-- tests-ch1.l4 : tests for us-ch1-construction.l4 (Title 1, sections 1 to 8).
-- Expected values are decided from the text of each section and written here before the run.
-- Records are built positionally with OF; the column order is the DECLARE order in us-nouns.l4 and is stated in a ruler
-- comment above each block of fixtures.

IMPORT prelude
IMPORT `us-nouns`
IMPORT `us-ch1-construction`

§ `Section 1 - person, whoever`

#ASSERT `section 1 expressly includes the body in the words person and whoever` `an individual` FALSE
#ASSERT `section 1 expressly includes the body in the words person and whoever` `a corporation` FALSE
#ASSERT `section 1 expressly includes the body in the words person and whoever` `a company` FALSE
#ASSERT `section 1 expressly includes the body in the words person and whoever` `an association` FALSE
#ASSERT `section 1 expressly includes the body in the words person and whoever` `a firm` FALSE
#ASSERT `section 1 expressly includes the body in the words person and whoever` `a partnership` FALSE
#ASSERT `section 1 expressly includes the body in the words person and whoever` `a society` FALSE
#ASSERT `section 1 expressly includes the body in the words person and whoever` `a joint stock company` FALSE
-- the list is not closed: a body of some other kind is simply not named
#ASSERT NOT `section 1 expressly includes the body in the words person and whoever` `a body of some other kind` FALSE
-- unless the context indicates otherwise
#ASSERT NOT `section 1 expressly includes the body in the words person and whoever` `a corporation` TRUE
#ASSERT NOT `section 1 expressly includes the body in the words person and whoever` `an individual` TRUE

§ `Section 1 - officer, signature, oath, writing`

#ASSERT     `section 1 expressly includes the individual in the word officer` TRUE FALSE
#ASSERT NOT `section 1 expressly includes the individual in the word officer` FALSE FALSE
#ASSERT NOT `section 1 expressly includes the individual in the word officer` TRUE TRUE

#ASSERT     `section 1 expressly includes the mark in the words signature and subscription` TRUE FALSE
#ASSERT NOT `section 1 expressly includes the mark in the words signature and subscription` FALSE FALSE
#ASSERT NOT `section 1 expressly includes the mark in the words signature and subscription` TRUE TRUE

#ASSERT     `section 1 treats an affirmation as an oath and an affirmed statement as sworn` FALSE
#ASSERT NOT `section 1 treats an affirmation as an oath and an affirmed statement as sworn` TRUE

#ASSERT     `section 1 expressly includes the way in the word writing` `printing` FALSE
#ASSERT     `section 1 expressly includes the way in the word writing` `typewriting` FALSE
#ASSERT     `section 1 expressly includes the way in the word writing` `photographing` FALSE
#ASSERT     `section 1 expressly includes the way in the word writing` `multigraphing` FALSE
#ASSERT     `section 1 expressly includes the way in the word writing` `mimeographing` FALSE
#ASSERT     `section 1 expressly includes the way in the word writing` `manifolding` FALSE
#ASSERT     `section 1 expressly includes the way in the word writing` `some other way of reproducing visual symbols` FALSE
#ASSERT NOT `section 1 expressly includes the way in the word writing` `a way that does not reproduce visual symbols` FALSE
#ASSERT NOT `section 1 expressly includes the way in the word writing` `printing` TRUE

§ `Section 2 - county`

--                                                   of a State or Territory, a parish, another equivalent subdivision
`a parish in a State`                      MEANS `A subdivision` OF TRUE,  TRUE,  FALSE
`a parish elsewhere`                       MEANS `A subdivision` OF FALSE, TRUE,  FALSE
`an equivalent subdivision of a Territory` MEANS `A subdivision` OF TRUE,  FALSE, TRUE
`an equivalent subdivision elsewhere`      MEANS `A subdivision` OF FALSE, FALSE, TRUE
`an ordinary county`                       MEANS `A subdivision` OF TRUE,  FALSE, FALSE

#ASSERT     `section 2 expressly includes the subdivision in the word county` `a parish in a State`
#ASSERT NOT `section 2 expressly includes the subdivision in the word county` `a parish elsewhere`
#ASSERT     `section 2 expressly includes the subdivision in the word county` `an equivalent subdivision of a Territory`
#ASSERT NOT `section 2 expressly includes the subdivision in the word county` `an equivalent subdivision elsewhere`
-- a county is a county without section 2; section 2 does not say so
#ASSERT NOT `section 2 expressly includes the subdivision in the word county` `an ordinary county`

§ `Sections 3 and 4 - vessel, vehicle`

--                                                          watercraft, other contrivance, used, capable
`a watercraft in use`                       MEANS `A watercraft or other contrivance` OF TRUE,  FALSE, TRUE,  TRUE
`a watercraft laid up but capable of use`   MEANS `A watercraft or other contrivance` OF TRUE,  FALSE, FALSE, TRUE
`a watercraft that cannot be used`          MEANS `A watercraft or other contrivance` OF TRUE,  FALSE, FALSE, FALSE
`another contrivance in use on water`       MEANS `A watercraft or other contrivance` OF FALSE, TRUE,  TRUE,  TRUE
`another contrivance capable of use`        MEANS `A watercraft or other contrivance` OF FALSE, TRUE,  FALSE, TRUE
`another contrivance that cannot be used`   MEANS `A watercraft or other contrivance` OF FALSE, TRUE,  FALSE, FALSE
`a thing that is neither, but is used`      MEANS `A watercraft or other contrivance` OF FALSE, FALSE, TRUE,  TRUE

#ASSERT     `section 3 expressly includes the contrivance in the word vessel` `a watercraft in use`
#ASSERT     `section 3 expressly includes the contrivance in the word vessel` `a watercraft laid up but capable of use`
-- reading (i) of F-3: the phrase "used, or capable of being used" governs the watercraft too, so this is not included
#ASSERT NOT `section 3 expressly includes the contrivance in the word vessel` `a watercraft that cannot be used`
#ASSERT     `section 3 expressly includes the contrivance in the word vessel` `another contrivance in use on water`
#ASSERT     `section 3 expressly includes the contrivance in the word vessel` `another contrivance capable of use`
#ASSERT NOT `section 3 expressly includes the contrivance in the word vessel` `another contrivance that cannot be used`
#ASSERT NOT `section 3 expressly includes the contrivance in the word vessel` `a thing that is neither, but is used`

--                                                         carriage, other contrivance, used, capable
`a carriage in use`                         MEANS `A carriage or other contrivance` OF TRUE,  FALSE, TRUE,  TRUE
`a carriage kept in a barn`                 MEANS `A carriage or other contrivance` OF TRUE,  FALSE, FALSE, TRUE
`a carriage that cannot be used`            MEANS `A carriage or other contrivance` OF TRUE,  FALSE, FALSE, FALSE
`another contrivance in use on land`        MEANS `A carriage or other contrivance` OF FALSE, TRUE,  TRUE,  TRUE
`another contrivance that cannot be used on land` MEANS `A carriage or other contrivance` OF FALSE, TRUE, FALSE, FALSE
`a thing that is neither a carriage nor a contrivance` MEANS `A carriage or other contrivance` OF FALSE, FALSE, TRUE, TRUE

#ASSERT     `section 4 expressly includes the contrivance in the word vehicle` `a carriage in use`
#ASSERT     `section 4 expressly includes the contrivance in the word vehicle` `a carriage kept in a barn`
#ASSERT NOT `section 4 expressly includes the contrivance in the word vehicle` `a carriage that cannot be used`
#ASSERT     `section 4 expressly includes the contrivance in the word vehicle` `another contrivance in use on land`
#ASSERT NOT `section 4 expressly includes the contrivance in the word vehicle` `another contrivance that cannot be used on land`
#ASSERT NOT `section 4 expressly includes the contrivance in the word vehicle` `a thing that is neither a carriage nor a contrivance`

§ `Section 5 - company, association`

#ASSERT     `section 5 deems the words company and association to embrace successors and assigns` TRUE
#ASSERT NOT `section 5 deems the words company and association to embrace successors and assigns` FALSE

§ `Section 6 - products of American fisheries`

--                                                          fillet, steak, slice, free of bone, foreign, labor of non-residents
`a foreign fillet made with foreign labor`        MEANS `A fish product` OF TRUE,  FALSE, FALSE, FALSE, TRUE,  TRUE
`a foreign steak with bone, made with foreign labor` MEANS `A fish product` OF FALSE, TRUE,  FALSE, FALSE, TRUE,  TRUE
`a foreign boneless slice made with foreign labor` MEANS `A fish product` OF FALSE, FALSE, TRUE,  TRUE,  TRUE,  TRUE
`a foreign slice with bone, made with foreign labor` MEANS `A fish product` OF FALSE, FALSE, TRUE,  FALSE, TRUE,  TRUE
`a domestic fillet`                               MEANS `A fish product` OF TRUE,  FALSE, FALSE, FALSE, FALSE, TRUE
`a foreign fillet made with resident labor only`  MEANS `A fish product` OF TRUE,  FALSE, FALSE, FALSE, TRUE,  FALSE
`a whole foreign fish made with foreign labor`    MEANS `A fish product` OF FALSE, FALSE, FALSE, FALSE, TRUE,  TRUE

#ASSERT     `section 6 excludes the product from the term products of American fisheries` `a foreign fillet made with foreign labor`
#ASSERT     `section 6 excludes the product from the term products of American fisheries` `a foreign steak with bone, made with foreign labor`
#ASSERT     `section 6 excludes the product from the term products of American fisheries` `a foreign boneless slice made with foreign labor`
-- fork F-6, reading (i): "substantially free of bone" qualifies slices only, so a slice with bone is not within the exclusion
#ASSERT NOT `section 6 excludes the product from the term products of American fisheries` `a foreign slice with bone, made with foreign labor`
#ASSERT NOT `section 6 excludes the product from the term products of American fisheries` `a domestic fillet`
#ASSERT NOT `section 6 excludes the product from the term products of American fisheries` `a foreign fillet made with resident labor only`
#ASSERT NOT `section 6 excludes the product from the term products of American fisheries` `a whole foreign fish made with foreign labor`

§ `Section 7 - marriage`

#ASSERT     `section 7(b) says the place is a State` `a State of the Union`
#ASSERT     `section 7(b) says the place is a State` `the District of Columbia`
#ASSERT     `section 7(b) says the place is a State` `the Commonwealth of Puerto Rico`
#ASSERT     `section 7(b) says the place is a State` `another territory or possession of the United States`
#ASSERT NOT `section 7(b) says the place is a State` `a place outside any State`

--                                      parties, where entered into,                 valid then, could have been in a State
`a valid marriage in a State`           MEANS `A marriage` OF 2, `a State of the Union`,                         TRUE,  FALSE
`an invalid marriage in a State`        MEANS `A marriage` OF 2, `a State of the Union`,                         FALSE, TRUE
`a marriage of three individuals`       MEANS `A marriage` OF 3, `a State of the Union`,                         TRUE,  TRUE
`a marriage of one individual`          MEANS `A marriage` OF 1, `a State of the Union`,                         TRUE,  TRUE
`a valid marriage in the District`      MEANS `A marriage` OF 2, `the District of Columbia`,                     TRUE,  FALSE
`a valid marriage in Puerto Rico`       MEANS `A marriage` OF 2, `the Commonwealth of Puerto Rico`,              TRUE,  FALSE
`a valid marriage in a territory`       MEANS `A marriage` OF 2, `another territory or possession of the United States`, TRUE, FALSE
`a valid marriage abroad that could have been made in a State` MEANS `A marriage` OF 2, `a place outside any State`, TRUE, TRUE
`a valid marriage abroad that could not have been made in a State` MEANS `A marriage` OF 2, `a place outside any State`, TRUE, FALSE
`an invalid marriage abroad that could have been made in a State` MEANS `A marriage` OF 2, `a place outside any State`, FALSE, TRUE

#ASSERT     `section 7(a) considers the individual married` `a valid marriage in a State` TRUE
#ASSERT NOT `section 7(a) considers the individual married` `a valid marriage in a State` FALSE
#ASSERT NOT `section 7(a) considers the individual married` `an invalid marriage in a State` TRUE
#ASSERT NOT `section 7(a) considers the individual married` `a marriage of three individuals` TRUE
#ASSERT NOT `section 7(a) considers the individual married` `a marriage of one individual` TRUE
#ASSERT     `section 7(a) considers the individual married` `a valid marriage in the District` TRUE
#ASSERT     `section 7(a) considers the individual married` `a valid marriage in Puerto Rico` TRUE
#ASSERT     `section 7(a) considers the individual married` `a valid marriage in a territory` TRUE
#ASSERT     `section 7(a) considers the individual married` `a valid marriage abroad that could have been made in a State` TRUE
#ASSERT NOT `section 7(a) considers the individual married` `a valid marriage abroad that could not have been made in a State` TRUE
#ASSERT NOT `section 7(a) considers the individual married` `an invalid marriage abroad that could have been made in a State` TRUE

§ `Section 8 - born alive`

--                                      expulsion, breathes, heart, pulsation, movement, cord cut, way of birth
`breathing after natural labor`         MEANS `A birth` OF TRUE,  TRUE,  FALSE, FALSE, FALSE, TRUE,  `natural labor`
`a beating heart only`                  MEANS `A birth` OF TRUE,  FALSE, TRUE,  FALSE, FALSE, TRUE,  `natural labor`
`pulsation of the cord only`            MEANS `A birth` OF TRUE,  FALSE, FALSE, TRUE,  FALSE, FALSE, `cesarean section`
`movement of voluntary muscles only`    MEANS `A birth` OF TRUE,  FALSE, FALSE, FALSE, TRUE,  TRUE,  `induced labor`
`no sign of life after expulsion`       MEANS `A birth` OF TRUE,  FALSE, FALSE, FALSE, FALSE, TRUE,  `natural labor`
`signs of life but no expulsion`        MEANS `A birth` OF FALSE, TRUE,  TRUE,  TRUE,  TRUE,  FALSE, `natural labor`
`breathing after induced abortion`      MEANS `A birth` OF TRUE,  TRUE,  FALSE, FALSE, FALSE, TRUE,  `induced abortion`
`breathing, cord uncut, other way`      MEANS `A birth` OF TRUE,  TRUE,  FALSE, FALSE, FALSE, FALSE, `some other way`
`breathing after cesarean section`      MEANS `A birth` OF TRUE,  TRUE,  FALSE, FALSE, FALSE, TRUE,  `cesarean section`
`breathing after induced labor`         MEANS `A birth` OF TRUE,  TRUE,  FALSE, FALSE, FALSE, TRUE,  `induced labor`

#ASSERT     `section 8(b) says the infant was born alive` `breathing after natural labor`
#ASSERT     `section 8(b) says the infant was born alive` `a beating heart only`
#ASSERT     `section 8(b) says the infant was born alive` `pulsation of the cord only`
#ASSERT     `section 8(b) says the infant was born alive` `movement of voluntary muscles only`
#ASSERT NOT `section 8(b) says the infant was born alive` `no sign of life after expulsion`
#ASSERT NOT `section 8(b) says the infant was born alive` `signs of life but no expulsion`
-- "regardless of whether the umbilical cord has been cut" and "regardless of whether ... natural or induced labor, cesarean section, or induced abortion"
#ASSERT     `section 8(b) says the infant was born alive` `breathing after induced abortion`
#ASSERT     `section 8(b) says the infant was born alive` `breathing, cord uncut, other way`
#ASSERT     `section 8(b) says the infant was born alive` `breathing after cesarean section`
#ASSERT     `section 8(b) says the infant was born alive` `breathing after induced labor`

#ASSERT     `section 8(a) includes the infant in the words person, human being, child and individual` `breathing after natural labor`
#ASSERT     `section 8(a) includes the infant in the words person, human being, child and individual` `breathing after induced abortion`
-- section 8(c): for a member not born alive, section 8(a) affirms nothing and denies nothing
#ASSERT NOT `section 8(a) includes the infant in the words person, human being, child and individual` `no sign of life after expulsion`
#ASSERT NOT `section 8(a) includes the infant in the words person, human being, child and individual` `signs of life but no expulsion`
