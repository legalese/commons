-- Tests for regwb-lowquality.l4 (12 CFR 223.3(v), 223.15).
--
-- The regulation prints no worked example for these sections, so each fixture is built for the purpose and each
-- group names the words of the text it exercises.  The member bank is Bank, P is its parent (an affiliate), U has
-- no connection with it.  Every expected value is written from those words.

IMPORT prelude
IMPORT `regw-nouns`
IMPORT `regw-control`
IMPORT `regw-affiliate`
IMPORT `regwb-nouns`
IMPORT `regwb-lowquality`

§ `Fixtures`

GIVEN n IS A STRING
GIVETH A Party
corp MEANS Party OF n, Corporation, FALSE, FALSE, `Some other activity`, `Not held through a debt previously contracted`, FALSE

GIVEN
    a IS A STRING
    b IS A STRING
    p IS A NUMBER
GIVETH A Holding
stake MEANS Holding OF a, b, "common", p, 0, FALSE, FALSE

GIVETH A Structure
`the structure` MEANS Structure OF "Bank", parties, holdings, EMPTY, EMPTY, EMPTY, EMPTY, EMPTY, EMPTY, EMPTY
    WHERE
        parties MEANS LIST corp "Bank", corp "P", corp "U"
        holdings MEANS LIST stake "P" "Bank" 100

GIVETH A Readings
`default readings` MEANS Readings OF `The member bank is not its own affiliate`, `One board at a time: the member bank, or one controlling company`, `Control through the controller's own holdings and elections, without attribution`, `A subsidiary of a company described in paragraphs (a)(1) through (10) only`

GIVETH AN `Asset condition`
`a sound asset` MEANS `Asset condition` OF FALSE, FALSE, 0, FALSE, FALSE

GIVEN d IS A NUMBER
GIVETH AN `Asset condition`
`an asset past due by` MEANS `Asset condition` OF FALSE, FALSE, d, FALSE, FALSE

GIVEN
    k IS A `Transaction kind`
    w IS A STRING
GIVETH A Transaction
`transaction of` MEANS Transaction OF k, w, w, 100, FALSE

GIVEN
    isRenewal IS A BOOLEAN
    notLqa    IS A BOOLEAN
    board     IS A BOOLEAN
    origDi    IS A BOOLEAN
    exec      IS A BOOLEAN
    senior    IS A BOOLEAN
    standards IS A BOOLEAN
    meets     IS A BOOLEAN
    reviews   IS A BOOLEAN
    share     IS A NUMBER
    prop      IS A NUMBER
    agency    IS A BOOLEAN
    days      IS A NUMBER
GIVETH A `Participation renewal`
`renewal of` MEANS `Participation renewal` OF isRenewal, notLqa, board, origDi, exec, senior, standards, meets, reviews, share, prop, agency, days

-- A renewal that meets every condition: the board approves, the share is the proportional share, notice in 10 days.
GIVETH A `Participation renewal`
`a good renewal` MEANS `renewal of` TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE 25 25 FALSE 10

-- Not a renewal at all.
GIVETH A `Participation renewal`
`no renewal` MEANS `renewal of` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 0 0 FALSE 0

§ `223.3(v): what makes an asset a low-quality asset`

-- (1) classified or specially treated.
#ASSERT `is a low-quality asset` (`Asset condition` OF TRUE, FALSE, 0, FALSE, FALSE)
-- (2) nonaccrual status.
#ASSERT `is a low-quality asset` (`Asset condition` OF FALSE, TRUE, 0, FALSE, FALSE)
-- (3) "more than thirty days past due": 31 is, 30 is not.
#ASSERT `is a low-quality asset` (`an asset past due by` 31)
#ASSERT NOT (`is a low-quality asset` (`an asset past due by` 30))
-- (4) renegotiated or compromised due to the deteriorating financial condition of the obligor.
#ASSERT `is a low-quality asset` (`Asset condition` OF FALSE, FALSE, 0, TRUE, FALSE)
-- (5) acquired in satisfaction of a debt and not yet reviewed.
#ASSERT `is a low-quality asset` (`Asset condition` OF FALSE, FALSE, 0, FALSE, TRUE)
-- None of the five.
#ASSERT NOT (`is a low-quality asset` `a sound asset`)

§ `223.15(b)(1) to (4): the renewal exception`

-- All four conditions met: "(1) The loan was not a low-quality asset at the time ...; (2) ... approved ... by the board of
-- directors of the participating member bank ...; (3) ... does not exceed its proportional share ...; and (4) ... notice
-- ... not later than 20 days after consummation."
#ASSERT `the renewal exception applies` `a good renewal` `Five percentage points above the proportional share`
-- It must be "the renewal of, or extension of additional credit with respect to, a member bank's participation".
#ASSERT NOT (`the renewal exception applies` `no renewal` `Five percentage points above the proportional share`)
-- (1): the loan was a low-quality asset when the bank bought its participation.
#ASSERT NOT (`the renewal exception applies` (`renewal of` TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE 25 25 FALSE 10) `Five percentage points above the proportional share`)
-- (2): nobody approved.
#ASSERT NOT (`the renewal exception applies` (`renewal of` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 25 25 FALSE 10) `Five percentage points above the proportional share`)
-- (2): "if the originating affiliate is a depository institution, by: (i) An executive committee of the board".
#ASSERT `the renewal exception applies` (`renewal of` TRUE TRUE FALSE TRUE TRUE FALSE FALSE FALSE FALSE 25 25 FALSE 10) `Five percentage points above the proportional share`
-- An executive committee counts only when the originating affiliate is a depository institution.
#ASSERT NOT (`the renewal exception applies` (`renewal of` TRUE TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE 25 25 FALSE 10) `Five percentage points above the proportional share`)
-- (ii) "One or more senior management officials ..., if: (A) standards ... (B) each renewal meets ... (C) periodic review".
#ASSERT `the renewal exception applies` (`renewal of` TRUE TRUE FALSE TRUE FALSE TRUE TRUE TRUE TRUE 25 25 FALSE 10) `Five percentage points above the proportional share`
#ASSERT NOT (`the renewal exception applies` (`renewal of` TRUE TRUE FALSE TRUE FALSE TRUE FALSE TRUE TRUE 25 25 FALSE 10) `Five percentage points above the proportional share`)
#ASSERT NOT (`the renewal exception applies` (`renewal of` TRUE TRUE FALSE TRUE FALSE TRUE TRUE FALSE TRUE 25 25 FALSE 10) `Five percentage points above the proportional share`)
#ASSERT NOT (`the renewal exception applies` (`renewal of` TRUE TRUE FALSE TRUE FALSE TRUE TRUE TRUE FALSE 25 25 FALSE 10) `Five percentage points above the proportional share`)
-- Senior management alone is not enough where the originating affiliate is not a depository institution.
#ASSERT NOT (`the renewal exception applies` (`renewal of` TRUE TRUE FALSE FALSE FALSE TRUE TRUE TRUE TRUE 25 25 FALSE 10) `Five percentage points above the proportional share`)
-- (4): 20 days is "not later than 20 days", 21 is not.
#ASSERT `the renewal exception applies` (`renewal of` TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE 25 25 FALSE 20) `Five percentage points above the proportional share`
#ASSERT NOT (`the renewal exception applies` (`renewal of` TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE 25 25 FALSE 21) `Five percentage points above the proportional share`)
-- (3): "by more than 5 percent, unless the member bank obtains the prior written approval of its appropriate
-- Federal banking agency".  The proportional share is 25: a share of 30 is exactly five points over ...
#ASSERT `the renewal exception applies` (`renewal of` TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE 30 25 FALSE 10) `Five percentage points above the proportional share`
-- ... 31 is more than five points over, which the agency's prior written approval cures.
#ASSERT NOT (`the renewal exception applies` (`renewal of` TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE 31 25 FALSE 10) `Five percentage points above the proportional share`)
#ASSERT `the renewal exception applies` (`renewal of` TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE 31 25 TRUE 10) `Five percentage points above the proportional share`

§ `223.15(b)(3): the two readings of "more than 5 percent"`

-- "does not exceed its proportional share of the original transaction by more than 5 percent": five percentage
-- points of the transaction, or five percent of the bank's proportional share.  With a proportional share of 25,
-- the first allows up to 30 and the second up to 26.25.
#ASSERT `share is within the five percent allowance` 29 25 `Five percentage points above the proportional share`
#ASSERT NOT (`share is within the five percent allowance` 29 25 `Five percent more than the proportional share`)
#ASSERT `share is within the five percent allowance` 26.25 25 `Five percent more than the proportional share`
#ASSERT NOT (`share is within the five percent allowance` 26.3 25 `Five percent more than the proportional share`)

§ `223.15(a): the prohibition`

-- "A member bank may not purchase a low-quality asset from an affiliate unless, pursuant to an independent credit
-- evaluation, the member bank had committed itself to purchase the asset before the time the asset was acquired by
-- the affiliate."  A past-due asset (31 days) bought from P, the parent:
#ASSERT `purchase of a low-quality asset is prohibited` `the structure` `default readings` (`transaction of` `A purchase of an asset` "P") (`an asset past due by` 31) FALSE FALSE `no renewal` `Five percentage points above the proportional share`
-- An independent credit evaluation and a commitment before the affiliate acquired it take it out of the prohibition.
#ASSERT NOT (`purchase of a low-quality asset is prohibited` `the structure` `default readings` (`transaction of` `A purchase of an asset` "P") (`an asset past due by` 31) TRUE TRUE `no renewal` `Five percentage points above the proportional share`)
-- An evaluation without a prior commitment, or a commitment without an evaluation, does not.
#ASSERT `purchase of a low-quality asset is prohibited` `the structure` `default readings` (`transaction of` `A purchase of an asset` "P") (`an asset past due by` 31) TRUE FALSE `no renewal` `Five percentage points above the proportional share`
#ASSERT `purchase of a low-quality asset is prohibited` `the structure` `default readings` (`transaction of` `A purchase of an asset` "P") (`an asset past due by` 31) FALSE TRUE `no renewal` `Five percentage points above the proportional share`
-- An asset that is not a low-quality asset (30 days past due), a seller who is not an affiliate, and a transaction that is
-- not a purchase are all outside it.
#ASSERT NOT (`purchase of a low-quality asset is prohibited` `the structure` `default readings` (`transaction of` `A purchase of an asset` "P") (`an asset past due by` 30) FALSE FALSE `no renewal` `Five percentage points above the proportional share`)
#ASSERT NOT (`purchase of a low-quality asset is prohibited` `the structure` `default readings` (`transaction of` `A purchase of an asset` "U") (`an asset past due by` 31) FALSE FALSE `no renewal` `Five percentage points above the proportional share`)
#ASSERT NOT (`purchase of a low-quality asset is prohibited` `the structure` `default readings` (`transaction of` `An extension of credit` "P") (`an asset past due by` 31) FALSE FALSE `no renewal` `Five percentage points above the proportional share`)
-- "asset (including a security)": a security bought from an affiliate counts.
#ASSERT `purchase of a low-quality asset is prohibited` `the structure` `default readings` (`transaction of` `A purchase of, or an investment in, a security` "P") (`Asset condition` OF TRUE, FALSE, 0, FALSE, FALSE) FALSE FALSE `no renewal` `Five percentage points above the proportional share`
-- (b): the prohibition "does not apply to the renewal of, or extension of additional credit with respect to" a participation.
#ASSERT NOT (`purchase of a low-quality asset is prohibited` `the structure` `default readings` (`transaction of` `A purchase of an asset` "P") (`an asset past due by` 31) FALSE FALSE `a good renewal` `Five percentage points above the proportional share`)
