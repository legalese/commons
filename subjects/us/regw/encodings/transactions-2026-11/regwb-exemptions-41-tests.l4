-- Tests for regwb-exemptions-41.l4 (12 CFR 223.41 and 223.16(c)).
--
-- The regulation prints worked examples for 223.16(c)(4)(iv) only, and that one is a sequence of monthly
-- computations, so it is not encoded; the other cases are built for the purpose and name the words of the text they
-- exercise.  Every expected value is written from those words.

IMPORT prelude
IMPORT `regwb-exemptions-41`

§ `223.41(a): a parent or subsidiary depository institution`

-- "if the member bank controls 80 percent or more of the voting securities of the depository institution or the
-- depository institution controls 80 percent or more of the voting securities of the member bank".
#ASSERT `exempt as a parent or subsidiary institution` TRUE 80 0
#ASSERT `exempt as a parent or subsidiary institution` TRUE 0 80
#ASSERT NOT (`exempt as a parent or subsidiary institution` TRUE 79 79)
-- Only "with a depository institution".
#ASSERT NOT (`exempt as a parent or subsidiary institution` FALSE 100 100)

§ `223.41(b): depository institutions under the same holding company`

-- "if the same company controls 80 percent or more of the voting securities of the member bank and the depository
-- institution": both, not one.
#ASSERT `exempt as an institution under the same holding company` TRUE 80 80
#ASSERT NOT (`exempt as an institution under the same holding company` TRUE 80 79)
#ASSERT NOT (`exempt as an institution under the same holding company` TRUE 79 80)
#ASSERT NOT (`exempt as an institution under the same holding company` FALSE 100 100)

§ `223.41(c): nonrecourse loan purchases`

-- "Purchasing a loan on a nonrecourse basis from an affiliated depository institution."
#ASSERT `exempt as a nonrecourse loan purchase` TRUE TRUE TRUE
#ASSERT NOT (`exempt as a nonrecourse loan purchase` TRUE FALSE TRUE)
#ASSERT NOT (`exempt as a nonrecourse loan purchase` TRUE TRUE FALSE)
#ASSERT NOT (`exempt as a nonrecourse loan purchase` FALSE TRUE TRUE)

§ `223.41(d): internal corporate reorganization transactions`

-- All seven conditions met, the aggregate 99 against capital stock and surplus of 1,000: "less than 10 percent".
#ASSERT `exempt as an internal corporate reorganization` TRUE TRUE TRUE TRUE TRUE TRUE TRUE 99 1000 10 TRUE
-- Exactly 10 percent is not "less than 10 percent".
#ASSERT NOT (`exempt as an internal corporate reorganization` TRUE TRUE TRUE TRUE TRUE TRUE TRUE 100 1000 10 TRUE)
-- "(or such higher amount, up to 25 percent ..., as may be permitted by the member bank's appropriate Federal banking
-- agency ...)": 249 against 25 percent of 1,000 is under; 26 percent is more than the text allows.
#ASSERT `exempt as an internal corporate reorganization` TRUE TRUE TRUE TRUE TRUE TRUE TRUE 249 1000 25 TRUE
#ASSERT NOT (`exempt as an internal corporate reorganization` TRUE TRUE TRUE TRUE TRUE TRUE TRUE 100 1000 26 TRUE)
-- Each of the other conditions, failed in turn: (1) not a purchase of assets from an affiliate, (1) not part of an
-- internal reorganization, (1) not all or substantially all, (2) no written notice, (3) no commitment, (4) the holding
-- company does not comply, (5) a majority of directors did not approve, (7) not well capitalized and well managed.
#ASSERT NOT (`exempt as an internal corporate reorganization` FALSE TRUE TRUE TRUE TRUE TRUE TRUE 99 1000 10 TRUE)
#ASSERT NOT (`exempt as an internal corporate reorganization` TRUE FALSE TRUE TRUE TRUE TRUE TRUE 99 1000 10 TRUE)
#ASSERT NOT (`exempt as an internal corporate reorganization` TRUE TRUE FALSE TRUE TRUE TRUE TRUE 99 1000 10 TRUE)
#ASSERT NOT (`exempt as an internal corporate reorganization` TRUE TRUE TRUE FALSE TRUE TRUE TRUE 99 1000 10 TRUE)
#ASSERT NOT (`exempt as an internal corporate reorganization` TRUE TRUE TRUE TRUE FALSE TRUE TRUE 99 1000 10 TRUE)
#ASSERT NOT (`exempt as an internal corporate reorganization` TRUE TRUE TRUE TRUE TRUE FALSE TRUE 99 1000 10 TRUE)
#ASSERT NOT (`exempt as an internal corporate reorganization` TRUE TRUE TRUE TRUE TRUE TRUE FALSE 99 1000 10 TRUE)
#ASSERT NOT (`exempt as an internal corporate reorganization` TRUE TRUE TRUE TRUE TRUE TRUE TRUE 99 1000 10 FALSE)

§ `223.16(c)(1) to (3): credit to a nonaffiliate used to buy securities`

-- (c)(2) "substantially the same as, or lower than, those prevailing at the same time for comparable transactions".
#ASSERT `exempt as a commission, fee or mark-up on market terms` TRUE TRUE
#ASSERT NOT (`exempt as a commission, fee or mark-up on market terms` TRUE FALSE)
-- (c)(1) all three of (i), (ii) and (iii), on an extension of credit to a nonaffiliate.
#ASSERT `exempt as a riskless principal credit` TRUE TRUE TRUE TRUE
#ASSERT NOT (`exempt as a riskless principal credit` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`exempt as a riskless principal credit` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`exempt as a riskless principal credit` TRUE TRUE TRUE FALSE)
#ASSERT NOT (`exempt as a riskless principal credit` FALSE TRUE TRUE TRUE)
-- (c)(3) both of (i) and (ii).
#ASSERT `exempt as a credit under a preexisting line` TRUE TRUE TRUE TRUE
#ASSERT NOT (`exempt as a credit under a preexisting line` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`exempt as a credit under a preexisting line` TRUE TRUE FALSE TRUE)
-- "not established in contemplation of the purchase".
#ASSERT NOT (`exempt as a credit under a preexisting line` TRUE TRUE TRUE FALSE)

§ `223.16(c)(4): general purpose credit cards`

-- (ii)(A) "Less than 25 percent": 24.9 is, 25 is not.
#ASSERT `is a general purpose credit card` TRUE 24.9 FALSE FALSE FALSE
#ASSERT NOT (`is a general purpose credit card` TRUE 25 FALSE FALSE FALSE)
-- (iv) the printed example: 27 percent for the 12 months is over the 25 percent test.
#ASSERT NOT (`is a general purpose credit card` TRUE 27 FALSE FALSE FALSE)
-- (B) all affiliates permissible for a financial holding company, and no reason to believe 25 percent or more.
#ASSERT `is a general purpose credit card` TRUE 27 TRUE TRUE FALSE
#ASSERT NOT (`is a general purpose credit card` TRUE 27 TRUE FALSE FALSE)
-- (C) the Board accepts the bank's showing.
#ASSERT `is a general purpose credit card` TRUE 27 FALSE FALSE TRUE
-- "widely accepted by merchants that are not affiliates".
#ASSERT NOT (`is a general purpose credit card` FALSE 10 TRUE TRUE TRUE)
-- (c)(4)(i) the credit itself, and (iii) the three-month grace period for a card that has just ceased to qualify.
#ASSERT `exempt as a general purpose credit card transaction` TRUE TRUE TRUE TRUE FALSE
#ASSERT `exempt as a general purpose credit card transaction` TRUE TRUE TRUE FALSE TRUE
#ASSERT NOT (`exempt as a general purpose credit card transaction` TRUE TRUE TRUE FALSE FALSE)
#ASSERT NOT (`exempt as a general purpose credit card transaction` TRUE FALSE TRUE TRUE FALSE)
#ASSERT NOT (`exempt as a general purpose credit card transaction` TRUE TRUE FALSE TRUE FALSE)
