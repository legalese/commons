-- Tests for regwb-exemptions-42.l4 (12 CFR 223.42).
--
-- The regulation prints one worked example in this section, for (c)(2); it comes first.  The rest are built for the
-- purpose, and each group names the words of the text it exercises.  Every expected value is written from those words.

IMPORT prelude
IMPORT `regwb-nouns`
IMPORT `regwb-collateral`
IMPORT `regwb-exemptions-42`

§ `Fixtures`

GIVEN
    k  IS A `Collateral kind`
    mv IS A NUMBER
GIVETH A Collateral
`collateral of` MEANS Collateral OF k, mv, 0, 0, FALSE, TRUE

§ `223.42(c): the printed example`

-- "A member bank makes a $100 non-amortizing term loan to an affiliate secured by U.S. Treasury securities with a market
-- value of $50 and real estate with a market value of $75. The value of the covered transaction is $50."
#ASSERT `value of a credit transaction after the exemption for cash or government securities` 100 (LIST `collateral of` `Obligations of the United States or its agencies` 50, `collateral of` `Stock, leases, or other real or personal property` 75) EQUALS 50
-- "If the market value of the U.S. Treasury securities falls to $45 during the life of the loan, the value of the covered
-- transaction would increase to $55."
#ASSERT `value of a credit transaction after the exemption for cash or government securities` 100 (LIST `collateral of` `Obligations of the United States or its agencies` 45, `collateral of` `Stock, leases, or other real or personal property` 75) EQUALS 55
-- "to the extent that": the exempt part is the secured part, and no more than the transaction.
#ASSERT `exempt part of a credit transaction secured by cash or government securities` 100 (LIST `collateral of` `Obligations of the United States or its agencies` 150) EQUALS 100
-- (iii) a segregated, earmarked deposit account; (ii) obligations fully guaranteed.
#ASSERT `exempt part of a credit transaction secured by cash or government securities` 100 (LIST `collateral of` `A segregated, earmarked deposit account with the member bank for the sole purpose of securing credit transactions with affiliates` 30, `collateral of` `Obligations fully guaranteed by the United States or its agencies as to principal and interest` 20) EQUALS 50
-- State obligations and other collateral do not qualify.
#ASSERT `exempt part of a credit transaction secured by cash or government securities` 100 (LIST `collateral of` `Obligations of a State or political subdivision of a State` 100) EQUALS 0

§ `223.42(a), (b), (d), (e): deposits, uncollected items, servicing affiliates, liquid assets`

#ASSERT `exempt as a correspondent banking deposit` TRUE TRUE
#ASSERT NOT (`exempt as a correspondent banking deposit` TRUE FALSE)
#ASSERT NOT (`exempt as a correspondent banking deposit` FALSE TRUE)
#ASSERT `exempt as credit for uncollected items` TRUE TRUE
#ASSERT NOT (`exempt as credit for uncollected items` TRUE FALSE)
#ASSERT `exempt as a purchase of securities of a servicing affiliate` TRUE TRUE
#ASSERT NOT (`exempt as a purchase of securities of a servicing affiliate` TRUE FALSE)
-- (e) "purchased at or below the asset's current market quotation": equal is at, one cent over is not.
#ASSERT `exempt as a purchase of a liquid asset` TRUE 100 100
#ASSERT NOT (`exempt as a purchase of a liquid asset` TRUE 100.01 100)
#ASSERT NOT (`exempt as a purchase of a liquid asset` FALSE 90 100)

§ `223.42(f): marketable securities`

-- All six conditions met, no underwriting.
#ASSERT `exempt as a purchase of a marketable security` TRUE TRUE TRUE TRUE FALSE FALSE FALSE TRUE 99 100 TRUE TRUE
-- (4): the bank may not buy "during an underwriting, or within 30 days of an underwriting, if an affiliate is an underwriter",
-- unless it is part of an issue of obligations of the United States or its agencies.
#ASSERT NOT (`exempt as a purchase of a marketable security` TRUE TRUE TRUE TRUE TRUE TRUE FALSE TRUE 99 100 TRUE TRUE)
#ASSERT `exempt as a purchase of a marketable security` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE 99 100 TRUE TRUE
-- Within 30 days of an underwriting that no affiliate underwrote, or an affiliate underwrote but not within 30 days: fine.
#ASSERT `exempt as a purchase of a marketable security` TRUE TRUE TRUE TRUE FALSE TRUE FALSE TRUE 99 100 TRUE TRUE
#ASSERT `exempt as a purchase of a marketable security` TRUE TRUE TRUE TRUE TRUE FALSE FALSE TRUE 99 100 TRUE TRUE
-- (5)(i) above the quotation; (5)(ii) the size casts doubt; (6) no records; (3) a low-quality asset; (1) no ready market.
#ASSERT NOT (`exempt as a purchase of a marketable security` TRUE TRUE TRUE TRUE FALSE FALSE FALSE TRUE 101 100 TRUE TRUE)
#ASSERT NOT (`exempt as a purchase of a marketable security` TRUE TRUE TRUE TRUE FALSE FALSE FALSE TRUE 99 100 FALSE TRUE)
#ASSERT NOT (`exempt as a purchase of a marketable security` TRUE TRUE TRUE TRUE FALSE FALSE FALSE TRUE 99 100 TRUE FALSE)
#ASSERT NOT (`exempt as a purchase of a marketable security` TRUE TRUE TRUE FALSE FALSE FALSE FALSE TRUE 99 100 TRUE TRUE)
#ASSERT NOT (`exempt as a purchase of a marketable security` TRUE FALSE TRUE TRUE FALSE FALSE FALSE TRUE 99 100 TRUE TRUE)
-- From a securities affiliate only.
#ASSERT NOT (`exempt as a purchase of a marketable security` FALSE TRUE TRUE TRUE FALSE FALSE FALSE TRUE 99 100 TRUE TRUE)

§ `223.42(g): municipal securities`

-- (1) "rated by a nationally recognized statistical rating organization or ... part of an issue ... that does not exceed $25
-- million"; (3)(i) quoted on an electronic service, at or below the quotation.
#ASSERT `exempt as a purchase of a municipal security` TRUE TRUE 30000000 TRUE TRUE 99 100 TRUE FALSE FALSE 0 FALSE FALSE
-- Unrated, but the issue is exactly $25 million: "does not exceed".
#ASSERT `exempt as a purchase of a municipal security` TRUE FALSE 25000000 TRUE TRUE 99 100 TRUE FALSE FALSE 0 FALSE FALSE
#ASSERT NOT (`exempt as a purchase of a municipal security` TRUE FALSE 25000001 TRUE TRUE 99 100 TRUE FALSE FALSE 0 FALSE FALSE)
-- (3)(ii) two or more quotes from unaffiliated broker-dealers, similar size, price no higher than their average.
#ASSERT `exempt as a purchase of a municipal security` TRUE TRUE 1 TRUE FALSE 0 0 FALSE TRUE TRUE 100 FALSE FALSE
#ASSERT NOT (`exempt as a purchase of a municipal security` TRUE TRUE 1 TRUE FALSE 101 0 FALSE TRUE TRUE 100 FALSE FALSE)
-- (3)(iii) the syndicate manager's summary: bought in the underwriting period at or below it, copy kept three years.
#ASSERT `exempt as a purchase of a municipal security` TRUE TRUE 1 TRUE FALSE 0 0 FALSE FALSE FALSE 0 TRUE TRUE
#ASSERT NOT (`exempt as a purchase of a municipal security` TRUE TRUE 1 TRUE FALSE 0 0 FALSE FALSE FALSE 0 TRUE FALSE)
-- None of (3)(i), (ii) or (iii).
#ASSERT NOT (`exempt as a purchase of a municipal security` TRUE TRUE 1 TRUE FALSE 0 0 FALSE FALSE FALSE 0 FALSE FALSE)
-- (2) not eligible for a State member bank to buy; and from a securities affiliate only.
#ASSERT NOT (`exempt as a purchase of a municipal security` TRUE TRUE 1 FALSE TRUE 99 100 TRUE FALSE FALSE 0 FALSE FALSE)
#ASSERT NOT (`exempt as a purchase of a municipal security` FALSE TRUE 1 TRUE TRUE 99 100 TRUE FALSE FALSE 0 FALSE FALSE)

§ `223.42(h) to (j)`

#ASSERT `exempt as a purchase subject to a repurchase agreement` TRUE TRUE TRUE
#ASSERT NOT (`exempt as a purchase subject to a repurchase agreement` TRUE TRUE FALSE)
#ASSERT NOT (`exempt as a purchase subject to a repurchase agreement` TRUE FALSE TRUE)
#ASSERT `exempt as an asset purchase by a newly formed member bank` TRUE TRUE
#ASSERT NOT (`exempt as an asset purchase by a newly formed member bank` TRUE FALSE)
#ASSERT `exempt as a transaction approved under the Bank Merger Act` TRUE TRUE
#ASSERT NOT (`exempt as a transaction approved under the Bank Merger Act` TRUE FALSE)

§ `223.42(k): nonrecourse purchase of an extension of credit`

-- 10 bought now and 30 in the preceding 12 months, against 80 originated: 40 is exactly 50 percent of 80, not "more than".
#ASSERT `exempt as a nonrecourse purchase of an extension of credit` TRUE TRUE TRUE TRUE TRUE 10 30 80 50
-- 41 of 80 is more than 50 percent.
#ASSERT NOT (`exempt as a nonrecourse purchase of an extension of credit` TRUE TRUE TRUE TRUE TRUE 11 30 80 50)
-- "(or such lower percent as is imposed by the member bank's appropriate Federal banking agency)": at 40 percent the same 40 is over.
#ASSERT `exempt as a nonrecourse purchase of an extension of credit` TRUE TRUE TRUE TRUE TRUE 10 22 80 40
#ASSERT NOT (`exempt as a nonrecourse purchase of an extension of credit` TRUE TRUE TRUE TRUE TRUE 10 30 80 40)
-- A percentage above 50 is not what the text allows.
#ASSERT NOT (`exempt as a nonrecourse purchase of an extension of credit` TRUE TRUE TRUE TRUE TRUE 10 30 80 60)
-- Each of (1) to (4) failed in turn, and recourse.
#ASSERT NOT (`exempt as a nonrecourse purchase of an extension of credit` FALSE TRUE TRUE TRUE TRUE 10 30 80 50)
#ASSERT NOT (`exempt as a nonrecourse purchase of an extension of credit` TRUE FALSE TRUE TRUE TRUE 10 30 80 50)
#ASSERT NOT (`exempt as a nonrecourse purchase of an extension of credit` TRUE TRUE FALSE TRUE TRUE 10 30 80 50)
#ASSERT NOT (`exempt as a nonrecourse purchase of an extension of credit` TRUE TRUE TRUE FALSE TRUE 10 30 80 50)
#ASSERT NOT (`exempt as a nonrecourse purchase of an extension of credit` TRUE TRUE TRUE TRUE FALSE 10 30 80 50)

§ `223.42(l): intraday extensions of credit`

#ASSERT `exempt as an intraday extension of credit` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`exempt as an intraday extension of credit` FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`exempt as an intraday extension of credit` TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`exempt as an intraday extension of credit` TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`exempt as an intraday extension of credit` TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`exempt as an intraday extension of credit` TRUE TRUE TRUE TRUE FALSE)

§ `223.42(m) to (o)`

#ASSERT `exempt as a riskless principal purchase` TRUE TRUE TRUE
#ASSERT NOT (`exempt as a riskless principal purchase` TRUE FALSE TRUE)
#ASSERT NOT (`exempt as a riskless principal purchase` TRUE TRUE FALSE)
#ASSERT NOT (`exempt as a riskless principal purchase` FALSE TRUE TRUE)
-- (n) all five conditions while the period runs; not once it has ended ("unless further extended by the Board").
#ASSERT `exempt as a securities financing transaction` TRUE TRUE TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`exempt as a securities financing transaction` FALSE TRUE TRUE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`exempt as a securities financing transaction` TRUE FALSE TRUE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`exempt as a securities financing transaction` TRUE TRUE FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`exempt as a securities financing transaction` TRUE TRUE TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`exempt as a securities financing transaction` TRUE TRUE TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`exempt as a securities financing transaction` TRUE TRUE TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`exempt as a securities financing transaction` TRUE TRUE TRUE TRUE TRUE TRUE FALSE)
-- (o) the three conditions.
#ASSERT `exempt as a purchase of asset-backed commercial paper` TRUE TRUE TRUE TRUE
#ASSERT NOT (`exempt as a purchase of asset-backed commercial paper` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`exempt as a purchase of asset-backed commercial paper` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`exempt as a purchase of asset-backed commercial paper` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`exempt as a purchase of asset-backed commercial paper` TRUE TRUE TRUE FALSE)
