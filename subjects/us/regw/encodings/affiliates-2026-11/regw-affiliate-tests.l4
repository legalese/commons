-- Tests for regw-affiliate.l4 (12 CFR 223.2).
--
-- The regulation prints no diagram of who owns whom and no worked example for the affiliate
-- definition, so every fixture is a small structure built for the purpose, and each group of tests
-- names the words of the text it exercises.  Every expected value is written from those words,
-- not from the output.  The member bank is always the party named Bank.

IMPORT prelude
IMPORT `regw-nouns`
IMPORT `regw-control`
IMPORT `regw-affiliate`

§ `Fixture builders`

GIVEN n IS A STRING
GIVETH A Party
corp MEANS Party OF n, Corporation, FALSE, FALSE, `Some other activity`, `Not held through a debt previously contracted`, FALSE

GIVEN
    n IS A STRING
    k IS A `Party kind`
GIVETH A Party
`party of kind` MEANS Party OF n, k, FALSE, FALSE, `Some other activity`, `Not held through a debt previously contracted`, FALSE

GIVEN n IS A STRING
GIVETH A Party
`depository institution` MEANS Party OF n, Corporation, TRUE, FALSE, `Some other activity`, `Not held through a debt previously contracted`, FALSE

GIVEN n IS A STRING
GIVETH A Party
`financial subsidiary` MEANS Party OF n, Corporation, FALSE, TRUE, `Some other activity`, `Not held through a debt previously contracted`, FALSE

GIVEN n IS A STRING
GIVETH A Party
`employee plan` MEANS Party OF n, `Business trust`, FALSE, FALSE, `Some other activity`, `Not held through a debt previously contracted`, TRUE

GIVEN
    n IS A STRING
    a IS A `Sole activity`
GIVETH A Party
`engaged solely` MEANS Party OF n, Corporation, FALSE, FALSE, a, `Not held through a debt previously contracted`, FALSE

GIVEN
    n IS A STRING
    d IS A `Debt control`
GIVETH A Party
`held by debt` MEANS Party OF n, Corporation, FALSE, FALSE, `Some other activity`, d, FALSE

GIVEN
    a IS A STRING
    b IS A STRING
    c IS A STRING
    p IS A NUMBER
GIVETH A Holding
stake MEANS Holding OF a, b, c, p, 0, FALSE, FALSE

GIVEN
    a IS A STRING
    b IS A STRING
GIVETH A Link
link MEANS Link OF a, b

GIVEN
    ps IS A LIST OF Party
    hs IS A LIST OF Holding
GIVETH A Structure
`structure of` MEANS Structure OF "Bank", ps, hs, EMPTY, EMPTY, EMPTY, EMPTY, EMPTY, EMPTY, EMPTY

GIVEN
    ps IS A LIST OF Party
    hs IS A LIST OF Holding
    es IS A LIST OF Link
GIVETH A Structure
`structure with elections` MEANS Structure OF "Bank", ps, hs, es, EMPTY, EMPTY, EMPTY, EMPTY, EMPTY, EMPTY

GIVEN
    ps IS A LIST OF Party
    hs IS A LIST OF Holding
    os IS A LIST OF Link
GIVETH A Structure
`structure with offices` MEANS Structure OF "Bank", ps, hs, EMPTY, EMPTY, os, EMPTY, EMPTY, EMPTY, EMPTY

GIVEN
    ps IS A LIST OF Party
    hs IS A LIST OF Holding
    sp IS A LIST OF Link
GIVETH A Structure
`structure with sponsorships` MEANS Structure OF "Bank", ps, hs, EMPTY, EMPTY, EMPTY, sp, EMPTY, EMPTY, EMPTY

GIVEN
    ps IS A LIST OF Party
    hs IS A LIST OF Holding
    es IS A LIST OF Link
    sp IS A LIST OF Link
GIVETH A Structure
`structure with elections and sponsorships` MEANS Structure OF "Bank", ps, hs, es, EMPTY, EMPTY, sp, EMPTY, EMPTY, EMPTY

GIVEN
    ps IS A LIST OF Party
    hs IS A LIST OF Holding
    gp IS A LIST OF Link
GIVETH A Structure
`structure with general partners` MEANS Structure OF "Bank", ps, hs, EMPTY, EMPTY, EMPTY, EMPTY, gp, EMPTY, EMPTY

GIVEN
    ps IS A LIST OF Party
    hs IS A LIST OF Holding
    ns IS A LIST OF STRING
GIVETH A Structure
`structure with determined affiliates` MEANS Structure OF "Bank", ps, hs, EMPTY, EMPTY, EMPTY, EMPTY, EMPTY, ns, EMPTY

GIVETH A Readings
`default readings` MEANS Readings OF `The member bank is not its own affiliate`, `One board at a time: the member bank, or one controlling company`, `Control through the controller's own holdings and elections, without attribution`, `A subsidiary of a company described in paragraphs (a)(1) through (10) only`

GIVETH A Readings
`literal self-affiliation` MEANS Readings OF `The member bank is its own affiliate on the literal words`, `One board at a time: the member bank, or one controlling company`, `Control through the controller's own holdings and elections, without attribution`, `A subsidiary of a company described in paragraphs (a)(1) through (10) only`

GIVETH A Readings
`pooled offices` MEANS Readings OF `The member bank is not its own affiliate`, `The offices of the member bank and of every controlling company pooled`, `Control through the controller's own holdings and elections, without attribution`, `A subsidiary of a company described in paragraphs (a)(1) through (10) only`

GIVETH A Readings
`attributed direct control` MEANS Readings OF `The member bank is not its own affiliate`, `One board at a time: the member bank, or one controlling company`, `Any control, including securities attributed from subsidiaries`, `A subsidiary of a company described in paragraphs (a)(1) through (10) only`

GIVETH A Readings
`chaining prong 11` MEANS Readings OF `The member bank is not its own affiliate`, `One board at a time: the member bank, or one controlling company`, `Control through the controller's own holdings and elections, without attribution`, `A subsidiary of any affiliate, so that the prong chains`

GIVEN
    s    IS A Structure
    name IS A STRING
GIVETH A BOOLEAN
`affiliate by default` MEANS `is an affiliate` s `default readings` `Section 23A` name

§ `223.2(a)(1): parent companies`

-- "Any company that controls the member bank": P holds 100 percent of Bank.
#ASSERT `affiliate by default` (`structure of` (LIST corp "Bank", corp "P", corp "U") (LIST stake "P" "Bank" "common" 100)) "P"
-- U has no connection with Bank.
#ASSERT NOT (`affiliate by default` (`structure of` (LIST corp "Bank", corp "P", corp "U") (LIST stake "P" "Bank" "common" 100)) "U")
-- 24 percent is not control, so the holder is not a parent.
#ASSERT NOT (`affiliate by default` (`structure of` (LIST corp "Bank", corp "P") (LIST stake "P" "Bank" "common" 24)) "P")

§ `223.2(a)(2): companies under common control by a parent company`

-- "Any company ... that is controlled by a company that controls the member bank": S is P's.
#ASSERT `affiliate by default` (`structure of` (LIST corp "Bank", corp "P", corp "S") (LIST stake "P" "Bank" "common" 100, stake "P" "S" "common" 100)) "S"
-- The member bank itself: it is a company, and it is controlled by P, a company that controls it.
-- On the literal words it is its own affiliate; the default reading says it is not (NOTES.md).
#ASSERT NOT (`affiliate by default` (`structure of` (LIST corp "Bank", corp "P") (LIST stake "P" "Bank" "common" 100)) "Bank")
#ASSERT `is an affiliate` (`structure of` (LIST corp "Bank", corp "P") (LIST stake "P" "Bank" "common" 100)) `literal self-affiliation` `Section 23A` "Bank"
-- With no company controlling the bank there is no literal self-affiliation either.
#ASSERT NOT (`is an affiliate` (`structure of` (LIST corp "Bank") EMPTY) `literal self-affiliation` `Section 23A` "Bank")

§ `223.2(a)(3): companies under other common control`

-- "controlled ... by or for the benefit of shareholders who ... control ... the member bank":
-- Ann, an individual, holds 30 percent of Bank and 30 percent of Co.
#ASSERT `affiliate by default` (`structure of` (LIST corp "Bank", `party of kind` "Ann" Individual, corp "Co") (LIST stake "Ann" "Bank" "common" 30, stake "Ann" "Co" "common" 30)) "Co"
-- Ann is a person and not a company, so she is not an affiliate herself.
#ASSERT NOT (`affiliate by default` (`structure of` (LIST corp "Bank", `party of kind` "Ann" Individual, corp "Co") (LIST stake "Ann" "Bank" "common" 30, stake "Ann" "Co" "common" 30)) "Ann")
-- At 20 percent of Co she does not control it.
#ASSERT NOT (`affiliate by default` (`structure of` (LIST corp "Bank", `party of kind` "Ann" Individual, corp "Co") (LIST stake "Ann" "Bank" "common" 30, stake "Ann" "Co" "common" 20)) "Co")

§ `223.2(a)(4): companies with interlocking directorates`

-- Bank's directors are p1, p2, p3; P (which controls Bank) has p4, p5, p6; X has p1, p2, p4, p5;
-- Y has p1, p2, p3; Z has p1, p7, p8.
-- "a majority of its directors ... constitute a majority of the persons holding any such office
-- with the member bank or any company that controls the member bank":
-- Y's directors are all Bank's, a majority of each board, on either reading.
#ASSERT `affiliate by default` (`structure with offices` (LIST corp "Bank", corp "P", corp "X", corp "Y", corp "Z") (LIST stake "P" "Bank" "common" 100) (LIST link "p1" "Bank", link "p2" "Bank", link "p3" "Bank", link "p4" "P", link "p5" "P", link "p6" "P", link "p1" "X", link "p2" "X", link "p4" "X", link "p5" "X", link "p1" "Y", link "p2" "Y", link "p3" "Y", link "p1" "Z", link "p7" "Z", link "p8" "Z")) "Y"
-- X: two of its four directors sit on Bank's board and two on P's, so taken one board at a time
-- the persons in common are not a majority of X's board ...
#ASSERT NOT (`affiliate by default` (`structure with offices` (LIST corp "Bank", corp "P", corp "X", corp "Y", corp "Z") (LIST stake "P" "Bank" "common" 100) (LIST link "p1" "Bank", link "p2" "Bank", link "p3" "Bank", link "p4" "P", link "p5" "P", link "p6" "P", link "p1" "X", link "p2" "X", link "p4" "X", link "p5" "X", link "p1" "Y", link "p2" "Y", link "p3" "Y", link "p1" "Z", link "p7" "Z", link "p8" "Z")) "X")
-- ... but pooling the offices of Bank and P, all four are among the six office holders, a majority
-- of X's board (4 of 4) and of the pool (4 of 6).
#ASSERT `is an affiliate` (`structure with offices` (LIST corp "Bank", corp "P", corp "X", corp "Y", corp "Z") (LIST stake "P" "Bank" "common" 100) (LIST link "p1" "Bank", link "p2" "Bank", link "p3" "Bank", link "p4" "P", link "p5" "P", link "p6" "P", link "p1" "X", link "p2" "X", link "p4" "X", link "p5" "X", link "p1" "Y", link "p2" "Y", link "p3" "Y", link "p1" "Z", link "p7" "Z", link "p8" "Z")) `pooled offices` `Section 23A` "X"
-- Z shares only p1, one of three, on either reading.
#ASSERT NOT (`affiliate by default` (`structure with offices` (LIST corp "Bank", corp "P", corp "X", corp "Y", corp "Z") (LIST stake "P" "Bank" "common" 100) (LIST link "p1" "Bank", link "p2" "Bank", link "p3" "Bank", link "p4" "P", link "p5" "P", link "p6" "P", link "p1" "X", link "p2" "X", link "p4" "X", link "p5" "X", link "p1" "Y", link "p2" "Y", link "p3" "Y", link "p1" "Z", link "p7" "Z", link "p8" "Z")) "Z")
#ASSERT NOT (`is an affiliate` (`structure with offices` (LIST corp "Bank", corp "P", corp "X", corp "Y", corp "Z") (LIST stake "P" "Bank" "common" 100) (LIST link "p1" "Bank", link "p2" "Bank", link "p3" "Bank", link "p4" "P", link "p5" "P", link "p6" "P", link "p1" "X", link "p2" "X", link "p4" "X", link "p5" "X", link "p1" "Y", link "p2" "Y", link "p3" "Y", link "p1" "Z", link "p7" "Z", link "p8" "Z")) `pooled offices` `Section 23A` "Z")

§ `223.2(a)(5): sponsored and advised companies`

-- "sponsored and advised on a contractual basis by the member bank or an affiliate of the member
-- bank": F by Bank, G by P (an affiliate, being Bank's parent), H by U (unconnected).
#ASSERT `affiliate by default` (`structure with sponsorships` (LIST corp "Bank", corp "P", corp "F", corp "G", corp "H", corp "U") (LIST stake "P" "Bank" "common" 100) (LIST link "Bank" "F", link "P" "G", link "U" "H")) "F"
#ASSERT `affiliate by default` (`structure with sponsorships` (LIST corp "Bank", corp "P", corp "F", corp "G", corp "H", corp "U") (LIST stake "P" "Bank" "common" 100) (LIST link "Bank" "F", link "P" "G", link "U" "H")) "G"
#ASSERT NOT (`affiliate by default` (`structure with sponsorships` (LIST corp "Bank", corp "P", corp "F", corp "G", corp "H", corp "U") (LIST stake "P" "Bank" "common" 100) (LIST link "Bank" "F", link "P" "G", link "U" "H")) "H")

§ `223.2(a)(7) and (8): depository institution and financial subsidiaries`

-- "A depository institution that is a subsidiary of the member bank": D, held 100 percent by Bank.
-- It is excluded from (b)(1) by (b)(1)(i), so it stays an affiliate.
#ASSERT `affiliate by default` (`structure of` (LIST corp "Bank", `depository institution` "D") (LIST stake "Bank" "D" "common" 100)) "D"
-- "A financial subsidiary of the member bank": FS; excluded from (b)(1) by (b)(1)(ii).
#ASSERT `affiliate by default` (`structure of` (LIST corp "Bank", `financial subsidiary` "FS") (LIST stake "Bank" "FS" "common" 100)) "FS"
-- A subsidiary that is neither: Sub, so (b)(1) excludes it (and see the groups on (b)(1) below).
#ASSERT NOT (`affiliate by default` (`structure of` (LIST corp "Bank", corp "Sub") (LIST stake "Bank" "Sub" "common" 100)) "Sub")

§ `223.2(a)(10): partnerships associated with the member bank or an affiliate`

-- "Any partnership for which the member bank or any affiliate of the member bank serves as a
-- general partner": W by Bank, X by P (an affiliate); nothing for V, a corporation, or for T, whose
-- general partner is unconnected.
#ASSERT `affiliate by default` (`structure with general partners` (LIST corp "Bank", corp "P", `party of kind` "W" Partnership, `party of kind` "X" Partnership, `party of kind` "T" Partnership, corp "V", corp "U") (LIST stake "P" "Bank" "common" 100) (LIST link "Bank" "W", link "P" "X", link "U" "T", link "Bank" "V")) "W"
#ASSERT `affiliate by default` (`structure with general partners` (LIST corp "Bank", corp "P", `party of kind` "W" Partnership, `party of kind` "X" Partnership, `party of kind` "T" Partnership, corp "V", corp "U") (LIST stake "P" "Bank" "common" 100) (LIST link "Bank" "W", link "P" "X", link "U" "T", link "Bank" "V")) "X"
#ASSERT NOT (`affiliate by default` (`structure with general partners` (LIST corp "Bank", corp "P", `party of kind` "W" Partnership, `party of kind` "X" Partnership, `party of kind` "T" Partnership, corp "V", corp "U") (LIST stake "P" "Bank" "common" 100) (LIST link "Bank" "W", link "P" "X", link "U" "T", link "Bank" "V")) "T")
#ASSERT NOT (`affiliate by default` (`structure with general partners` (LIST corp "Bank", corp "P", `party of kind` "W" Partnership, `party of kind` "X" Partnership, `party of kind` "T" Partnership, corp "V", corp "U") (LIST stake "P" "Bank" "common" 100) (LIST link "Bank" "W", link "P" "X", link "U" "T", link "Bank" "V")) "V")

§ `223.2(a)(11): subsidiaries of affiliates`

-- F is sponsored by Bank, so it is a company described in (a)(5); Q is F's subsidiary (100 percent),
-- so Q is an affiliate under (a)(11).  R is controlled by Q only through its directors.
-- R is not a subsidiary of a company "described in paragraphs (a)(1) through (10)": Q is not so
-- described, it is an affiliate only through (a)(11).  So on the literal words R is not an
-- affiliate, and on the reading that the prong chains it is.
#ASSERT `affiliate by default` (`structure with elections and sponsorships` (LIST corp "Bank", corp "F", corp "Q", corp "R") (LIST stake "F" "Q" "common" 100) (LIST link "Q" "R") (LIST link "Bank" "F")) "F"
#ASSERT `affiliate by default` (`structure with elections and sponsorships` (LIST corp "Bank", corp "F", corp "Q", corp "R") (LIST stake "F" "Q" "common" 100) (LIST link "Q" "R") (LIST link "Bank" "F")) "Q"
#ASSERT NOT (`affiliate by default` (`structure with elections and sponsorships` (LIST corp "Bank", corp "F", corp "Q", corp "R") (LIST stake "F" "Q" "common" 100) (LIST link "Q" "R") (LIST link "Bank" "F")) "R")
#ASSERT `is an affiliate` (`structure with elections and sponsorships` (LIST corp "Bank", corp "F", corp "Q", corp "R") (LIST stake "F" "Q" "common" 100) (LIST link "Q" "R") (LIST link "Bank" "F")) `chaining prong 11` `Section 23A` "R"

§ `223.2(a)(12): other companies`

-- "Any company that the Board determines by regulation or order ... to have a relationship with the
-- member bank": a determination is stated.  O has no other connection with Bank.
#ASSERT `affiliate by default` (`structure with determined affiliates` (LIST corp "Bank", corp "O", corp "N") EMPTY (LIST "O")) "O"
#ASSERT NOT (`affiliate by default` (`structure with determined affiliates` (LIST corp "Bank", corp "O", corp "N") EMPTY (LIST "O")) "N")

§ `223.2(b)(1): subsidiaries of the member bank`

-- A subsidiary Sub of Bank (Bank holds 100 percent), Bank's parent P holding 100 percent of Bank.
-- "unless the company is ... (iii) directly controlled by (A) one or more affiliates (other than
-- depository institution affiliates)": P is an affiliate and not a depository institution.
-- Here P holds 25 percent of Sub itself, directly.
#ASSERT `affiliate by default` (`structure of` (LIST corp "Bank", corp "P", corp "Sub") (LIST stake "P" "Bank" "common" 100, stake "Bank" "Sub" "common" 100, stake "P" "Sub" "common" 25)) "Sub"
-- P holds nothing in Sub itself: on the reading that "directly" means the controller's own
-- holdings, P does not directly control Sub, so (b)(1) excludes it ...
#ASSERT NOT (`affiliate by default` (`structure of` (LIST corp "Bank", corp "P", corp "Sub") (LIST stake "P" "Bank" "common" 100, stake "Bank" "Sub" "common" 100)) "Sub")
-- ... and on the reading that it includes securities attributed from subsidiaries, P controls Sub
-- through Bank and Sub comes back in.
#ASSERT `is an affiliate` (`structure of` (LIST corp "Bank", corp "P", corp "Sub") (LIST stake "P" "Bank" "common" 100, stake "Bank" "Sub" "common" 100)) `attributed direct control` `Section 23A` "Sub"
-- (A) says "other than depository institution affiliates": E is a depository institution controlled
-- by P and holds 25 percent of Sub, with Bank's 30 percent making Sub Bank's subsidiary.
-- E's direct control does not bring Sub back in.
#ASSERT NOT (`affiliate by default` (`structure of` (LIST corp "Bank", corp "P", `depository institution` "E", corp "Sub") (LIST stake "P" "Bank" "common" 100, stake "P" "E" "common" 100, stake "Bank" "Sub" "common" 30, stake "E" "Sub" "common" 25)) "Sub")
-- (B) "A shareholder that controls the member bank": Ann holds 30 percent of Bank and 25 percent
-- of Sub, and Bank holds 30 percent of Sub.
#ASSERT `affiliate by default` (`structure of` (LIST corp "Bank", `party of kind` "Ann" Individual, corp "Sub") (LIST stake "Ann" "Bank" "common" 30, stake "Bank" "Sub" "common" 30, stake "Ann" "Sub" "common" 25)) "Sub"
-- Ann holds only 20 percent of Sub, so she does not control it, and Sub is excluded.
#ASSERT NOT (`affiliate by default` (`structure of` (LIST corp "Bank", `party of kind` "Ann" Individual, corp "Sub") (LIST stake "Ann" "Bank" "common" 30, stake "Bank" "Sub" "common" 30, stake "Ann" "Sub" "common" 20)) "Sub")
-- (iv) "An employee stock option plan, trust, or similar organization": a plan controlled by Bank.
#ASSERT `affiliate by default` (`structure of` (LIST corp "Bank", corp "P", `employee plan` "Plan") (LIST stake "P" "Bank" "common" 100, stake "Bank" "Plan" "common" 100)) "Plan"
-- (v) "Any other company determined to be an affiliate under paragraph (a)(12)": Sub is so determined.
#ASSERT `affiliate by default` (`structure with determined affiliates` (LIST corp "Bank", corp "Sub") (LIST stake "Bank" "Sub" "common" 100) (LIST "Sub")) "Sub"

§ `223.2(b)(2) to (5) and (c)`

-- Each company below is controlled by P, which controls Bank, so (a)(2) would make it an affiliate.
-- (b)(2) "engaged solely in holding the premises of the member bank"; (b)(3) "solely in conducting
-- a safe deposit business"; (b)(4) "solely in holding obligations of the United States or its
-- agencies": excluded.
#ASSERT NOT (`affiliate by default` (`structure of` (LIST corp "Bank", corp "P", `engaged solely` "S" `Holds the premises of the member bank`) (LIST stake "P" "Bank" "common" 100, stake "P" "S" "common" 100)) "S")
#ASSERT NOT (`affiliate by default` (`structure of` (LIST corp "Bank", corp "P", `engaged solely` "S" `Conducts a safe deposit business`) (LIST stake "P" "Bank" "common" 100, stake "P" "S" "common" 100)) "S")
#ASSERT NOT (`affiliate by default` (`structure of` (LIST corp "Bank", corp "P", `engaged solely` "S" `Holds obligations of the United States or its agencies`) (LIST stake "P" "Bank" "common" 100, stake "P" "S" "common" 100)) "S")
-- (b)(5) "control results from the exercise of rights arising out of a bona fide debt previously
-- contracted": excluded for the authorized period, and an affiliate once it has expired.
#ASSERT NOT (`affiliate by default` (`structure of` (LIST corp "Bank", corp "P", `held by debt` "S" `Held through a debt previously contracted, within the authorized period`) (LIST stake "P" "Bank" "common" 100, stake "P" "S" "common" 100)) "S")
#ASSERT `affiliate by default` (`structure of` (LIST corp "Bank", corp "P", `held by debt` "S" `Held through a debt previously contracted, period expired`) (LIST stake "P" "Bank" "common" 100, stake "P" "S" "common" 100)) "S"
-- (c) "For purposes of subpart F ... 'affiliate' ... also does not include any depository
-- institution": E is a depository institution controlled by P, an affiliate for section 23A only.
#ASSERT `is an affiliate` (`structure of` (LIST corp "Bank", corp "P", `depository institution` "E") (LIST stake "P" "Bank" "common" 100, stake "P" "E" "common" 100)) `default readings` `Section 23A` "E"
#ASSERT NOT (`is an affiliate` (`structure of` (LIST corp "Bank", corp "P", `depository institution` "E") (LIST stake "P" "Bank" "common" 100, stake "P" "E" "common" 100)) `default readings` `Subpart F, section 23B` "E")
-- P is not a depository institution, so it stays an affiliate for subpart F.
#ASSERT `is an affiliate` (`structure of` (LIST corp "Bank", corp "P", `depository institution` "E") (LIST stake "P" "Bank" "common" 100, stake "P" "E" "common" 100)) `default readings` `Subpart F, section 23B` "P"

§ `Two fixed points of the affiliate definition`

-- P holds 100 percent of Bank; Bank holds 30 percent of S1 and of S2; S1 and S2 each hold 25 percent
-- of the other.  Each of S1 and S2 is controlled by P through Bank, so (a)(2) describes it, and each
-- is a subsidiary of Bank, so (b)(1) excludes it unless "directly controlled by ... affiliates
-- (other than depository institution affiliates)": the other one is such an affiliate if it is one.
-- With only P found, neither is an affiliate; with P, S1 and S2 found, each is, and the set holds.
-- So the definition has two fixed points here, and the encoding takes the least (NOTES.md).
#ASSERT NOT (`affiliate step` (`inquiry about` (`structure of` (LIST corp "Bank", corp "P", corp "S1", corp "S2") (LIST stake "P" "Bank" "common" 100, stake "Bank" "S1" "common" 30, stake "Bank" "S2" "common" 30, stake "S1" "S2" "common" 25, stake "S2" "S1" "common" 25)) `default readings` `Section 23A`) (LIST "P") (corp "S1"))
#ASSERT `affiliate step` (`inquiry about` (`structure of` (LIST corp "Bank", corp "P", corp "S1", corp "S2") (LIST stake "P" "Bank" "common" 100, stake "Bank" "S1" "common" 30, stake "Bank" "S2" "common" 30, stake "S1" "S2" "common" 25, stake "S2" "S1" "common" 25)) `default readings` `Section 23A`) (LIST "P", "S1", "S2") (corp "S1")
#ASSERT `affiliate step` (`inquiry about` (`structure of` (LIST corp "Bank", corp "P", corp "S1", corp "S2") (LIST stake "P" "Bank" "common" 100, stake "Bank" "S1" "common" 30, stake "Bank" "S2" "common" 30, stake "S1" "S2" "common" 25, stake "S2" "S1" "common" 25)) `default readings` `Section 23A`) (LIST "P", "S1", "S2") (corp "S2")
#ASSERT count (`affiliates of the member bank` (`structure of` (LIST corp "Bank", corp "P", corp "S1", corp "S2") (LIST stake "P" "Bank" "common" 100, stake "Bank" "S1" "common" 30, stake "Bank" "S2" "common" 30, stake "S1" "S2" "common" 25, stake "S2" "S1" "common" 25)) `default readings` `Section 23A`) EQUALS 1

§ `More limbs of (a)(3) and (a)(4)`

-- (a)(4) against the controlling company's board alone: W's directors are P's three directors, so
-- the persons in common are a majority of W's board and of P's, on either reading.
#ASSERT `affiliate by default` (`structure with offices` (LIST corp "Bank", corp "P", corp "W") (LIST stake "P" "Bank" "common" 100) (LIST link "p1" "Bank", link "p2" "Bank", link "p3" "Bank", link "p4" "P", link "p5" "P", link "p6" "P", link "p4" "W", link "p5" "W", link "p6" "W")) "W"
-- (a)(3) through "any company that controls the member bank": P controls Bank only through its
-- directors, Ann controls P only through its directors and holds 30 percent of Co.  Ann holds
-- nothing in Bank, so she is not a shareholder who controls Bank, but she controls P, which does.
#ASSERT `affiliate by default` (`structure with elections` (LIST corp "Bank", corp "P", corp "Co", `party of kind` "Ann" Individual) (LIST stake "Ann" "Co" "common" 30) (LIST link "P" "Bank", link "Ann" "P")) "Co"
-- Without Ann's control of P, Co is unconnected.
#ASSERT NOT (`affiliate by default` (`structure with elections` (LIST corp "Bank", corp "P", corp "Co", `party of kind` "Ann" Individual) (LIST stake "Ann" "Co" "common" 30) (LIST link "P" "Bank")) "Co")
