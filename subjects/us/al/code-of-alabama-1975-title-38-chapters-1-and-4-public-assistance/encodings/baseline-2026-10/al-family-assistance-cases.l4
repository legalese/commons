IMPORT prelude
IMPORT daydate
IMPORT `al-family-assistance`

-- Alabama Family Assistance -- worked cases, from the seat of the applicant.
-- Every expected value was worked out by hand from the deposited text, never copied from the encoding's output.
-- The families are HYPOTHETICAL. The payment standards used ($215, $150, $120) are made-up inputs, not DHR's figures,
-- which are not deposited. Amounts are US dollars a month.

-- Eligibility arguments, in order: dependent child, home in Alabama, gave away property, other federally matched
-- assistance, in a public institution, jobs applied for, doing work activities, quit or refused work, drug felony,
-- sentence completed, on probation, months of TANF, hardship exemption, net countable income, payment standard.

-- A family meeting every condition: income $100 against a $215 standard, a deficit of $115.
#ASSERT `Is my family eligible for Family Assistance` TRUE TRUE FALSE FALSE FALSE 3 TRUE FALSE FALSE FALSE FALSE 0 FALSE 100 215

-- Income $210: deficit $5, under the $10 minimum: not needy (r 660-2-2-.27 with -.10).
#ASSERT (NOT (`Is my family eligible for Family Assistance` TRUE TRUE FALSE FALSE FALSE 3 TRUE FALSE FALSE FALSE FALSE 0 FALSE 210 215))
-- Income $205: deficit exactly $10: needy.
#ASSERT `Is my family eligible for Family Assistance` TRUE TRUE FALSE FALSE FALSE 3 TRUE FALSE FALSE FALSE FALSE 0 FALSE 205 215
-- Income above the standard: not needy.
#ASSERT (NOT (`Is my family eligible for Family Assistance` TRUE TRUE FALSE FALSE FALSE 3 TRUE FALSE FALSE FALSE FALSE 0 FALSE 300 215))

-- Only two job applications before completing the application (s 38-11A-2(b)): not eligible.
#ASSERT (NOT (`Is my family eligible for Family Assistance` TRUE TRUE FALSE FALSE FALSE 2 TRUE FALSE FALSE FALSE FALSE 0 FALSE 100 215))
-- Quit a job without good cause while receiving (s 38-11A-2(c)): not eligible.
#ASSERT (NOT (`Is my family eligible for Family Assistance` TRUE TRUE FALSE FALSE FALSE 3 TRUE TRUE FALSE FALSE FALSE 0 FALSE 100 215))
-- The child does not make its home in Alabama (s 38-4-1(d)(2)); or property was given away to qualify ((d)(3)): not
-- eligible.
#ASSERT (NOT (`Is my family eligible for Family Assistance` TRUE FALSE FALSE FALSE FALSE 3 TRUE FALSE FALSE FALSE FALSE 0 FALSE 100 215))
#ASSERT (NOT (`Is my family eligible for Family Assistance` TRUE TRUE TRUE FALSE FALSE 3 TRUE FALSE FALSE FALSE FALSE 0 FALSE 100 215))

-- A drug felony, sentence not completed, not on probation: barred. Satisfactorily on probation, or sentence completed:
-- eligible (s 38-1-8).
#ASSERT (NOT (`Is my family eligible for Family Assistance` TRUE TRUE FALSE FALSE FALSE 3 TRUE FALSE TRUE FALSE FALSE 0 FALSE 100 215))
#ASSERT `Is my family eligible for Family Assistance` TRUE TRUE FALSE FALSE FALSE 3 TRUE FALSE TRUE FALSE TRUE 0 FALSE 100 215
#ASSERT `Is my family eligible for Family Assistance` TRUE TRUE FALSE FALSE FALSE 3 TRUE FALSE TRUE TRUE FALSE 0 FALSE 100 215

-- 60 months already: not eligible without a hardship exemption; with one, eligible; at 59 months, eligible.
#ASSERT (NOT (`Is my family eligible for Family Assistance` TRUE TRUE FALSE FALSE FALSE 3 TRUE FALSE FALSE FALSE FALSE 60 FALSE 100 215))
#ASSERT `Is my family eligible for Family Assistance` TRUE TRUE FALSE FALSE FALSE 3 TRUE FALSE FALSE FALSE FALSE 60 TRUE 100 215
#ASSERT `Is my family eligible for Family Assistance` TRUE TRUE FALSE FALSE FALSE 3 TRUE FALSE FALSE FALSE FALSE 59 FALSE 100 215

-- -------------------------------------------------------------------------------------------------------------------
-- The grant (rr 660-2-2-.10, -.32).
-- $215 less $100 = $115 for a full month.
#ASSERT `How much Family Assistance would we get a month` 100 215 TRUE EQUALS 115
-- deficit $10: the minimum grant, paid.
#ASSERT `How much Family Assistance would we get a month` 205 215 TRUE EQUALS 10
-- deficit $5: nothing.
#ASSERT `How much Family Assistance would we get a month` 210 215 TRUE EQUALS 0
-- the other conditions not met: nothing.
#ASSERT `How much Family Assistance would we get a month` 100 215 FALSE EQUALS 0

-- Applied on 20 January 2026: 12 days from the 20th to the 31st, inclusive. $115 x 12 / 30 = $46.
#ASSERT `How much would we get for the month I applied` 100 215 TRUE (Date 20 1 2026) EQUALS 46
-- Applied on 1 December 2026 with a $120 deficit ($0 income, $120 standard): 31 days. $120 x 31 / 30 = $124.
#ASSERT `How much would we get for the month I applied` 0 120 TRUE (Date 1 12 2026) EQUALS 124
-- Applied on 28 February 2026 with a $150 deficit: 1 day. $150 x 1 / 30 = $5, paid although under $10 (finding 4).
#ASSERT `How much would we get for the month I applied` 0 150 TRUE (Date 28 2 2026) EQUALS 5

-- -------------------------------------------------------------------------------------------------------------------
-- s 38-4-5: the fair hearing.
#ASSERT `Can I appeal for a fair hearing` FALSE FALSE TRUE FALSE FALSE
#ASSERT `Can I appeal for a fair hearing` FALSE FALSE FALSE FALSE TRUE
#ASSERT (NOT (`Can I appeal for a fair hearing` FALSE FALSE FALSE FALSE FALSE))

-- -------------------------------------------------------------------------------------------------------------------
-- The duties, traced (days).
-- New earnings reported the same day: fulfilled.
#ASSERT EVALTRACE (`the duty to report new income` `the recipient`) 0 (LIST EVENT `the recipient` `notify the county department of the new income or resources` 0) EQUALS FULFILLED
-- Not reported: breached.
-- expect: BREACH BY `the recipient` BECAUSE "s 38-4-4(a): new income or resources not reported immediately"
#TRACE `the duty to report new income` `the recipient` AT 0 WITH
    (WAITUNTIL 30)
-- The county director's written notice of the decision.
#ASSERT EVALTRACE (`the duty to give written notice` `the county director`) 0 (LIST EVENT `the county director` `give the applicant written notice of the action taken` 25) EQUALS FULFILLED
-- An appeal for a fair hearing, filed on day 20.
#ASSERT EVALTRACE (`the right to a fair hearing` `the applicant`) 0 (LIST EVENT `the applicant` `appeal to the state department for a fair hearing` 20) EQUALS FULFILLED
