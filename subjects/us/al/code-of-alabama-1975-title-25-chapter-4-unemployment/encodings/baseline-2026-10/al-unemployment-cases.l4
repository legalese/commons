IMPORT prelude
IMPORT `al-unemployment`

-- Code of Alabama 1975, Title 25, Chapter 4 -- worked cases, from the seat of the unemployed worker.
-- Every expected value was worked out by hand from the deposited text, never copied from the encoding's output.
-- The workers are HYPOTHETICAL. Amounts are US dollars; time in the traces is in days.

-- -------------------------------------------------------------------------------------------------------------------
-- s 25-4-72: the weekly benefit amount.
-- $6,500 and $5,500: average $6,000, / 26 = $230.77; 77 cents is over 50 cents, so up: $231.
#ASSERT `What is my weekly benefit amount` 2026 6500 5500 EQUALS `answered` 231
-- $3,000 and $3,000: $3,000 / 26 = $115.38; dropped to $115.
#ASSERT `What is my weekly benefit amount` 2026 3000 3000 EQUALS `answered` 115
-- $6,513 and $6,513: exactly $250.50; fifty cents "or less" is dropped: $250.
#ASSERT `What is my weekly benefit amount` 2026 6513 6513 EQUALS `answered` 250
-- $1,157 and $1,157: exactly $44.50, "not in excess of" $44.50: no weekly benefit amount.
#ASSERT `What is my weekly benefit amount` 2026 1157 1157 EQUALS `answered` 0
-- $1,200 and $1,200: $46.15: $46.
#ASSERT `What is my weekly benefit amount` 2026 1200 1200 EQUALS `answered` 46
-- $9,000 and $8,000: $326.92, more than $274.50: the $275 maximum.
#ASSERT `What is my weekly benefit amount` 2026 9000 8000 EQUALS `answered` 275
-- $7,137 and $7,137: exactly $274.50, not more than $274.50; fifty cents dropped: $274.
#ASSERT `What is my weekly benefit amount` 2026 7137 7137 EQUALS `answered` 274
-- A benefit year beginning in 2019: outside the encoding.
#ASSERT `What is my weekly benefit amount` 2019 6500 5500 EQUALS `not covered` `this encoding computes benefits for benefit years beginning on or after 1 January 2020 only`

-- -------------------------------------------------------------------------------------------------------------------
-- s 25-4-77(a)(6): the base-period wage test.
-- $15,000 in the base period against 1.5 x $6,500 = $9,750: met.
#ASSERT `Have I earned enough to qualify` 6500 5500 15000 FALSE 0 0
-- $9,000 against $9,750: not met.
#ASSERT (NOT (`Have I earned enough to qualify` 6500 2500 9000 FALSE 0 0))
-- Wages enough, but no weekly benefit amount ($44.50 or less): not met.
#ASSERT (NOT (`Have I earned enough to qualify` 1157 1157 3000 FALSE 0 0))
-- Benefits last benefit year at $200 a week: needs 8 x $200 = $1,600 since. $1,500: not met; $1,600: met.
#ASSERT (NOT (`Have I earned enough to qualify` 6500 5500 15000 TRUE 200 1500))
#ASSERT `Have I earned enough to qualify` 6500 5500 15000 TRUE 200 1600

-- -------------------------------------------------------------------------------------------------------------------
-- s 25-4-74(a): the maximum total.
-- $231 a week, $20,000 base-period wages, rate 3.1%: 14 x $231 = $3,234 against $5,000: $3,234.
#ASSERT `What is the most I can get in my benefit year` 231 20000 3.1 EQUALS 3234
-- base-period wages $10,000: a quarter is $2,500, the lesser.
#ASSERT `What is the most I can get in my benefit year` 231 10000 3.1 EQUALS 2500
-- base-period wages $12,001: a quarter is $3,000.25, less than $3,234; to the dollar $3,000.
#ASSERT `What is the most I can get in my benefit year` 231 12001 3.1 EQUALS 3000
-- rate 7.0%: one 0.5% step above 6.5%: 15 x $231 = $3,465. Rate 7.4%: still one complete step.
#ASSERT `What is the most I can get in my benefit year` 231 20000 7.0 EQUALS 3465
#ASSERT `What is the most I can get in my benefit year` 231 20000 7.4 EQUALS 3465
-- rate 9.5%: 20 x $231 = $4,620; rate 12%: still at most 20.
#ASSERT `What is the most I can get in my benefit year` 231 20000 9.5 EQUALS 4620
#ASSERT `What is the most I can get in my benefit year` 231 30000 12 EQUALS 4620

-- -------------------------------------------------------------------------------------------------------------------
-- s 25-4-73: the payment for a week.
-- $231 a week, $100 wages: a third of $231 is $77; $23 over it comes off: $208.
#ASSERT `How much will I be paid for this week` 231 100 FALSE EQUALS 208
-- $50 wages, under a third: the full $231.
#ASSERT `How much will I be paid for this week` 231 50 FALSE EQUALS 231
-- $400 wages: nothing.
#ASSERT `How much will I be paid for this week` 231 400 FALSE EQUALS 0
-- $230 a week, $100 wages: a third is $76.67, $23.33 comes off, $206.67, to the dollar $207.
#ASSERT `How much will I be paid for this week` 230 100 FALSE EQUALS 207
-- the waiting week: nothing (s 25-4-73(c)).
#ASSERT `How much will I be paid for this week` 231 0 TRUE EQUALS 0

-- -------------------------------------------------------------------------------------------------------------------
-- s 25-4-77(a)(1)-(5): eligibility for a week.
#ASSERT `Am I eligible this week` TRUE TRUE TRUE FALSE TRUE 3 FALSE
#ASSERT (NOT (`Am I eligible this week` TRUE TRUE TRUE FALSE TRUE 2 FALSE))
-- no contacts, because of a jury summons: eligible.
#ASSERT `Am I eligible this week` TRUE TRUE TRUE FALSE TRUE 0 TRUE
-- not available, but in approved training: eligible (s 25-4-77(b)).
#ASSERT `Am I eligible this week` TRUE TRUE FALSE TRUE TRUE 3 FALSE
-- no claim filed for the week: not eligible.
#ASSERT (NOT (`Am I eligible this week` FALSE TRUE TRUE FALSE TRUE 3 FALSE))

-- -------------------------------------------------------------------------------------------------------------------
-- s 25-4-78(2), (3): how the job ended.
#ASSERT `Does how my job ended disqualify me` `laid off or let go for no fault of mine` FALSE EQUALS `no disqualification`
#ASSERT `Does how my job ended disqualify me` `quit with good cause connected with the work` FALSE EQUALS `no disqualification`
#ASSERT `Does how my job ended disqualify me` `quit without good cause connected with the work` FALSE EQUALS `no benefits until requalified, and the total reduced by 3 to 9 weekly amounts`
-- quit to move with a military spouse under orders: an exception, s 25-4-78(2)d.
#ASSERT `Does how my job ended disqualify me` `quit without good cause connected with the work` TRUE EQUALS `no disqualification`
#ASSERT `Does how my job ended disqualify me` `discharged for a dishonest or criminal act, sabotage, endangering others, or drugs after warning` FALSE EQUALS `no benefits until requalified, and none ever on that employer's wages`
#ASSERT `Does how my job ended disqualify me` `discharged for misconduct repeated after warning` FALSE EQUALS `no benefits until requalified, and the total reduced by 3 to 9 weekly amounts`
#ASSERT `Does how my job ended disqualify me` `discharged for other misconduct connected with the work` FALSE EQUALS `no benefits for the week of discharge and 1 to 4 more weeks, and the total reduced by those weeks`

-- requalifying at $231 a week: 10 x $231 = $2,310.
#ASSERT `How much must I earn to requalify` 231 EQUALS 2310
-- $3,234 less 5 weekly amounts of $231 = $3,234 - $1,155 = $2,079.
#ASSERT `What is my reduced maximum` 3234 231 5 EQUALS 2079

-- s 25-4-78(5)b: never suitable.
#ASSERT `Can I refuse this work` FALSE TRUE FALSE
#ASSERT (NOT (`Can I refuse this work` FALSE FALSE FALSE))

-- s 25-4-78(8): $208 less a $50 employer pension = $158; a Social Security payment takes nothing off.
#ASSERT `What is my payment after my pension` 208 50 TRUE FALSE EQUALS 158
#ASSERT `What is my payment after my pension` 208 50 TRUE TRUE EQUALS 208
-- a pension the worker contributed to (not wholly employer-financed): nothing off.
#ASSERT `What is my payment after my pension` 208 50 FALSE FALSE EQUALS 208

-- s 25-4-91(d)(1): 15 days if mailed, 7 if delivered.
#ASSERT `How many days do I have to appeal` TRUE EQUALS 15
#ASSERT `How many days do I have to appeal` FALSE EQUALS 7

-- -------------------------------------------------------------------------------------------------------------------
-- The duties, traced.
-- The week's certification shows four employers contacted, on day 6: fulfilled.
#ASSERT EVALTRACE (`the weekly work search` `the claimant`) 0 (LIST EVENT `the claimant` (`certify the week's work search` 4) 6) EQUALS FULFILLED
-- A certification showing two employers does not count; nothing else by day 7: breached.
-- expect: BREACH BECAUSE "s 25-4-77(a)(5): fewer than three prospective employers contacted; not eligible for the week"
#TRACE `the weekly work search` `the claimant` AT 0 WITH
    PARTY `the claimant` DOES `certify the week's work search` 2 AT 6
    (WAITUNTIL 8)

-- An appeal filed on day 5 of the 7 allowed after delivery.
#ASSERT EVALTRACE (`the right to appeal` `the claimant` (`the days to appeal` FALSE)) 0 (LIST EVENT `the claimant` `file an appeal from the determination` 5) EQUALS FULFILLED
-- No appeal: the permission lapses with no breach, and the determination is final.
-- expect: FULFILLED
#TRACE `the right to appeal` `the claimant` 15 AT 0 WITH
    (WAITUNTIL 16)

-- Disputed benefits repaid after a final decision against the claimant.
#ASSERT EVALTRACE (`the duty to repay disputed benefits` `the claimant`) 0 (LIST EVENT `the claimant` `repay the disputed benefits to the fund` 30) EQUALS FULFILLED
