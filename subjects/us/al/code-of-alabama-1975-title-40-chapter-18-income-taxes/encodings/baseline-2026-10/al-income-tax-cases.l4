IMPORT prelude
IMPORT daydate
IMPORT `al-income-tax`

-- Code of Alabama 1975, Title 40, Chapter 18 -- worked cases, from the seat of the individual taxpayer.
-- Every expected value was worked out by hand from the deposited text, never copied from the encoding's output.
-- The people are HYPOTHETICAL. Amounts are US dollars.

-- -------------------------------------------------------------------------------------------------------------------
-- s 40-18-2(b): residence presumption.
#ASSERT `Am I presumed to be an Alabama resident` TRUE FALSE 0
#ASSERT `Am I presumed to be an Alabama resident` FALSE TRUE 0
-- more than seven months in the state: presumed; exactly seven: not
#ASSERT `Am I presumed to be an Alabama resident` FALSE FALSE 8
#ASSERT (NOT (`Am I presumed to be an Alabama resident` FALSE FALSE 7))

-- -------------------------------------------------------------------------------------------------------------------
-- s 40-18-15(b)(4): the optional standard deduction.
-- single: $3,000 to $25,500; $25,999 is $499 over, no complete $500, still $3,000; $26,000 is one step, $2,975
#ASSERT `What is my Alabama standard deduction` `single` 20000 EQUALS 3000
#ASSERT `What is my Alabama standard deduction` `single` 25999 EQUALS 3000
#ASSERT `What is my Alabama standard deduction` `single` 26000 EQUALS 2975
-- single, $40,000: 29 steps of $25 = $725, $2,275, raised to the $2,500 floor
#ASSERT `What is my Alabama standard deduction` `single` 40000 EQUALS 2500
-- joint, $30,000: 9 steps of $175 = $1,575, $8,500 less $1,575 = $6,925
#ASSERT `What is my Alabama standard deduction` `married filing joint return` 30000 EQUALS 6925
-- joint, $60,000: 69 steps would take it below the $5,000 floor
#ASSERT `What is my Alabama standard deduction` `married filing joint return` 60000 EQUALS 5000
-- separate, $13,250: $500 over $12,750 is two steps of $250, 2 x $88 = $176, $4,250 less $176 = $4,074
#ASSERT `What is my Alabama standard deduction` `married filing separate return` 13250 EQUALS 4074
-- head of family, $30,000: 9 steps of $135 = $1,215, $5,200 less $1,215 = $3,985
#ASSERT `What is my Alabama standard deduction` `head of family` 30000 EQUALS 3985

-- -------------------------------------------------------------------------------------------------------------------
-- s 40-18-19(a)(8), (9): personal and dependent exemptions.
#ASSERT `What are my Alabama personal and dependent exemptions` `single` 30000 0 EQUALS 1500
#ASSERT `What are my Alabama personal and dependent exemptions` `married filing separate return` 30000 0 EQUALS 1500
-- joint, AGI $50,000 and two dependents: $3,000 + 2 x $1,000
#ASSERT `What are my Alabama personal and dependent exemptions` `married filing joint return` 50000 2 EQUALS 5000
-- head of family, AGI $50,001 and one dependent: $3,000 + $500
#ASSERT `What are my Alabama personal and dependent exemptions` `head of family` 50001 1 EQUALS 3500
-- AGI $100,000: still $500 each; $100,001: $300 each
#ASSERT `What are my Alabama personal and dependent exemptions` `married filing joint return` 100000 1 EQUALS 3500
#ASSERT `What are my Alabama personal and dependent exemptions` `married filing joint return` 100001 1 EQUALS 3300

-- -------------------------------------------------------------------------------------------------------------------
-- s 40-18-19.1: severance and unemployment compensation after a downsizing.
#ASSERT `How much of my severance or unemployment pay is exempt` TRUE FALSE 60000 EQUALS 50000
#ASSERT `How much of my severance or unemployment pay is exempt` TRUE FALSE 20000 EQUALS 20000
#ASSERT `How much of my severance or unemployment pay is exempt` TRUE TRUE 20000 EQUALS 0
#ASSERT `How much of my severance or unemployment pay is exempt` FALSE FALSE 20000 EQUALS 0

-- -------------------------------------------------------------------------------------------------------------------
-- s 40-18-27(a): must I file?
-- single, gross and AGI $5,000: $3,000 + $1,500 = $4,500, exceeded
#ASSERT `Must I file an Alabama return` `single` 5000 5000
#ASSERT (NOT (`Must I file an Alabama return` `single` 4000 4000))
-- joint, $11,000: $8,500 + $3,000 = $11,500, not exceeded
#ASSERT (NOT (`Must I file an Alabama return` `married filing joint return` 11000 11000))
-- head of family, $8,500: $5,200 + $3,000 = $8,200, exceeded
#ASSERT `Must I file an Alabama return` `head of family` 8500 8500

-- -------------------------------------------------------------------------------------------------------------------
-- How much do I owe? Arguments: year, resident, status, AGI, itemise, itemised, federal tax, dependents, 65+, retirement
-- income, spouse 65+, spouse's retirement income.

-- A. Single, 2025, AGI $40,000, federal tax $3,000. $40,000 - $2,500 - $3,000 - $1,500 = $33,000.
--    2% of $500 = $10; 4% of $2,500 = $100; 5% of $30,000 = $1,500. Total $1,610.
#ASSERT `How much Alabama income tax do I owe` 2025 TRUE `single` 40000 FALSE 0 3000 0 FALSE 0 FALSE 0 EQUALS `answered` 1610

-- B. Joint, 2025, AGI $30,000, two dependents, federal tax $600. $30,000 - $6,925 - $600 - $3,000 - $2,000 = $17,475.
--    2% of $1,000 = $20; 4% of $5,000 = $200; 5% of $11,475 = $573.75. Total $793.75.
#ASSERT `How much Alabama income tax do I owe` 2025 TRUE `married filing joint return` 30000 FALSE 0 600 2 FALSE 0 FALSE 0 EQUALS `answered` 793.75

-- C. Head of family, 2024, AGI $20,000, one dependent, no federal tax. $20,000 - $5,200 - $3,000 - $1,000 = $10,800.
--    $10 + $100 + 5% of $7,800 = $390. Total $500.
#ASSERT `How much Alabama income tax do I owe` 2024 TRUE `head of family` 20000 FALSE 0 0 1 FALSE 0 FALSE 0 EQUALS `answered` 500

-- D. Single, 2025, AGI $120,000, itemises $15,000, federal tax $18,000, one dependent ($300 above $100,000).
--    $120,000 - $15,000 - $18,000 - $1,500 - $300 = $85,200. $110 + 5% of $82,200 = $4,110. Total $4,220.
#ASSERT `How much Alabama income tax do I owe` 2025 TRUE `single` 120000 TRUE 15000 18000 1 FALSE 0 FALSE 0 EQUALS `answered` 4220

-- E. Single, 66, 2025, AGI $30,000 with $10,000 of taxable retirement income, federal tax $1,000. Standard deduction
--    $3,000 - 9 x $25 = $2,775. Exemptions $1,500 + $6,000. $30,000 - $2,775 - $1,000 - $7,500 = $18,725.
--    $110 + 5% of $15,725 = $786.25. Total $896.25.
#ASSERT `How much Alabama income tax do I owe` 2025 TRUE `single` 30000 FALSE 0 1000 0 TRUE 10000 FALSE 0 EQUALS `answered` 896.25
-- The same in 2022: no retirement income exemption before 2023. $24,725 taxable; $110 + $1,086.25 = $1,196.25.
#ASSERT `How much Alabama income tax do I owe` 2022 TRUE `single` 30000 FALSE 0 1000 0 TRUE 10000 FALSE 0 EQUALS `answered` 1196.25

-- F. Joint, both 65 or older, 2025, AGI $60,000 with $4,000 of retirement income each, federal tax $2,000. Standard
--    deduction $5,000 (floor). Exemptions $3,000 + $4,000 + $4,000. $60,000 - $5,000 - $2,000 - $11,000 = $42,000.
--    $20 + $200 + 5% of $36,000 = $1,800. Total $2,020.
#ASSERT `How much Alabama income tax do I owe` 2025 TRUE `married filing joint return` 60000 FALSE 0 2000 0 TRUE 4000 TRUE 4000 EQUALS `answered` 2020

-- G. Single, AGI $300: deductions exceed income; no tax.
#ASSERT `How much Alabama income tax do I owe` 2025 TRUE `single` 300 FALSE 0 0 0 FALSE 0 FALSE 0 EQUALS `answered` 0

-- H. Outside the encoding: a 2021 return, and a nonresident.
#ASSERT `How much Alabama income tax do I owe` 2021 TRUE `single` 40000 FALSE 0 3000 0 FALSE 0 FALSE 0 EQUALS `not covered` `this encoding computes the tax for tax years from 2022 only`
#ASSERT `How much Alabama income tax do I owe` 2025 FALSE `single` 40000 FALSE 0 3000 0 FALSE 0 FALSE 0 EQUALS `not covered` `the tax of a nonresident individual is not encoded`

-- -------------------------------------------------------------------------------------------------------------------
-- s 40-18-75(a): the wage statement.
#ASSERT `By when must my employer give me my wage statement` 2026 FALSE (Date 15 12 2026) EQUALS Date 31 1 2027
-- the job ended with a last payment on 15 December 2026: 30 days later is 14 January 2027
#ASSERT `By when must my employer give me my wage statement` 2026 TRUE (Date 15 12 2026) EQUALS Date 14 1 2027

-- -------------------------------------------------------------------------------------------------------------------
-- The duties, traced. Time is in days.

-- s 40-18-27: due date 105 days after the year ends; the return is filed on day 100.
#ASSERT EVALTRACE (`the duty to file` `the taxpayer` 105) 0 (LIST EVENT `the taxpayer` `file the return with the Department of Revenue` 100) EQUALS FULFILLED
-- not filed by day 105: breached (s 40-18-50).
-- expect: BREACH BY `the taxpayer` BECAUSE "s 40-18-50: no return within the time allowed; ..."
#TRACE `the duty to file` `the taxpayer` 105 AT 0 WITH
    (WAITUNTIL 106)

-- s 40-18-42(a): the balance paid on day 105.
#ASSERT EVALTRACE (`the duty to pay the balance` `the taxpayer` 105) 0 (LIST EVENT `the taxpayer` `pay the balance of the tax` 105) EQUALS FULFILLED

-- s 40-18-73(a): the employee hands in a signed Form A-4 on the first day of work.
#ASSERT EVALTRACE (`the duty to furnish a Form A-4` `the employee` `the employer`) 0 (LIST EVENT `the employee` `furnish a signed Alabama Form A-4` 0) EQUALS FULFILLED
-- s 40-18-73(c): no Form A-4 by the first day; the employer then withholds using no exemptions, which ends the matter.
-- (Traced, not asserted: the deadline is noticed only at the WAITUNTIL, and a list of events cannot hold one.)
-- expect: FULFILLED
#TRACE `the duty to furnish a Form A-4` `the employee` `the employer` AT 0 WITH
    (WAITUNTIL 1)
    PARTY `the employer` DOES `withhold using no exemptions` AT 7
-- and until the employer does, that duty stays owed: s 40-18-73(c) sets no time for it, so the rule has no WITHIN.
-- expect: residual obligation PARTY employer MUST `withhold using no exemptions`
#TRACE `the duty to furnish a Form A-4` `the employee` `the employer` AT 0 WITH
    (WAITUNTIL 1)

-- s 40-18-73(a): inflating exemptions breaches the prohibition.
-- expect: BREACH BY `the employee` BECAUSE "s 40-18-73(a): exemptions inflated on Form A-4; penalty of $500 under s 40-29-75"
#TRACE `the prohibition on inflating exemptions` `the employee` AT 0 WITH
    PARTY `the employee` DOES `claim more withholding exemptions than the employee is entitled to` AT 3

-- s 40-18-73(g): a new certificate after a change in exemptions.
#ASSERT EVALTRACE (`the duty to update the certificate` `the employee`) 0 (LIST EVENT `the employee` `submit a new withholding exemption certificate` 40) EQUALS FULFILLED

-- s 40-18-75(a): wage statement given on day 20 of 31 allowed.
#ASSERT EVALTRACE (`the duty to give the wage statement` `the employer` 31) 0 (LIST EVENT `the employer` `furnish the written wage statement` 20) EQUALS FULFILLED
