-- Payable: in the eligibility period, exhausted by expiry, nothing barring, 0 paid of 5,000.
#ASSERT `in these cases, extended compensation is payable for the person with` (Date 3 3 2013) FALSE FALSE 0
-- 4,600 paid of 5,000: still room.
#ASSERT `in these cases, extended compensation is payable for the person with` (Date 3 3 2013) FALSE FALSE 4600
-- 5,000 paid of 5,000: the account is used up.
#ASSERT NOT (`in these cases, extended compensation is payable for the person with` (Date 3 3 2013) FALSE FALSE 5000)
-- Turned down a job that had to be accepted (500 a week against a benefit of 400, in writing, State law would deny): not payable.
#ASSERT NOT (`in these cases, extended compensation is payable for the person with` (Date 3 3 2013) FALSE TRUE 0)
-- The week of 24 February 2013, inside the benefit year, with regular compensation still available: not exhausted, not payable.
#ASSERT NOT (`in these cases, extended compensation is payable for the person with` (Date 24 2 2013) FALSE FALSE 0)
-- The same week with everything received: payable.
#ASSERT `in these cases, extended compensation is payable for the person with` (Date 24 2 2013) TRUE FALSE 0
-- The week of 27 January 2013 is before the period begins: not in the eligibility period.
#ASSERT NOT (`in these cases, extended compensation is payable for the person with` (Date 27 1 2013) TRUE FALSE 0)

§§ `Section 203: the extended benefit period`

-- First "on" week 13 January 2013, no earlier period: the third week after is 3 February 2013.
#ASSERT `In which week does my State's extended benefit period begin` (Date 13 1 2013) FALSE (Date 1 1 1900) EQUALS Date 3 2 2013
-- An earlier period closed in the week of 4 November 2012: 4 November + 98 days is 10 February 2013, later than 3 February.
#ASSERT `In which week does my State's extended benefit period begin` (Date 13 1 2013) TRUE (Date 4 11 2012) EQUALS Date 10 2 2013
-- Began 3 February; first "off" 10 February: the third week after is 3 March but 13 weeks run to 28 April 2013.
#ASSERT `In which week does my State's extended benefit period end` (Date 3 2 2013) (Date 10 2 2013) EQUALS Date 28 4 2013
#ASSERT `In which week does my State's extended benefit period end` (Date 3 2 2013) (Date 14 4 2013) EQUALS Date 5 5 2013

-- Week of 3 March 2013: begins in the period; the benefit year ended 28 February, inside the period.
#ASSERT `Is this week in my eligibility period` (Date 3 3 2013) (Date 1 3 2012) (Date 28 2 2013) (Date 3 2 2013) FALSE (Date 1 1 1900)
#ASSERT NOT (`Is this week in my eligibility period` (Date 27 1 2013) (Date 1 3 2012) (Date 28 2 2013) (Date 3 2 2013) FALSE (Date 1 1 1900))
-- The period ended with the week of 28 April 2013: the week of 5 May 2013 is outside.
#ASSERT NOT (`Is this week in my eligibility period` (Date 5 5 2013) (Date 1 3 2012) (Date 28 2 2013) (Date 3 2 2013) TRUE (Date 28 4 2013))

#ASSERT `Must the Secretary of Labor publish notice when my State's extended benefit period begins or ends` TRUE
#ASSERT NOT (`Must the Secretary of Labor publish notice when my State's extended benefit period begins or ends` FALSE)

-- 5 claimants on average, covered employment of 100: 5 per cent. NOT COVERED: with no covered employment there is nothing to divide by.
#ASSERT `What is my State's rate of insured unemployment` 5 100 EQUALS JUST 5
#ASSERT `What is my State's rate of insured unemployment` 5 0 EQUALS NOTHING

-- The first four of the six quarters, 100 200 300 400, average 250.
#ASSERT `What average monthly covered employment must my State use for a thirteen-week period` 100 200 300 400 500 600 EQUALS JUST 250

-- 6 against 5 and 5: exactly 120 per cent of 5 and at least 5: on. 5.9: off.
#ASSERT `Is my State on for this week by the insured unemployment test` (Date 6 1 2013) 6 5 5 0 FALSE (Date 1 1 1900) FALSE (Date 1 1 1900)
#ASSERT NOT (`Is my State on for this week by the insured unemployment test` (Date 6 1 2013) 5.9 5 5 0 FALSE (Date 1 1 1900) FALSE (Date 1 1 1900))
-- 6 against 10 and 10 is on only under the 6 per cent option, adopted from 1 January 2011, for the week of 1 March 2011.
#ASSERT `Is my State on for this week by the insured unemployment test` (Date 1 3 2011) 6 10 10 0 TRUE (Date 1 1 2011) FALSE (Date 1 1 1900)
#ASSERT NOT (`Is my State on for this week by the insured unemployment test` (Date 1 3 2011) 6 10 10 0 FALSE (Date 1 1 1900) FALSE (Date 1 1 1900))

-- 6.5 against 5 and 5, trigger adopted, week after 6 March 1993: on. Trigger not adopted: not on.
#ASSERT `Is my State on for this week by the total unemployment trigger` (Date 3 3 2013) 6.5 5 5 0 TRUE FALSE (Date 1 1 1900)
#ASSERT NOT (`Is my State on for this week by the total unemployment trigger` (Date 3 3 2013) 6.5 5 5 0 FALSE FALSE (Date 1 1 1900))
-- 6.4 falls short of 6.5.
#ASSERT NOT (`Is my State on for this week by the total unemployment trigger` (Date 3 3 2013) 6.4 5 5 0 TRUE FALSE (Date 1 1 1900))

-- Insured test fails (4.9 against 4 and 4) but the total unemployment trigger is met: on by either test.
#ASSERT `Is my State on for this week by either test` (Date 3 3 2013) 4.9 4 4 0 FALSE (Date 1 1 1900) FALSE (Date 1 1 1900) 6.5 5 5 0 TRUE FALSE (Date 1 1 1900)
-- Neither: not on.
#ASSERT NOT (`Is my State on for this week by either test` (Date 3 3 2013) 4.9 4 4 0 FALSE (Date 1 1 1900) FALSE (Date 1 1 1900) 6.4 5 5 0 TRUE FALSE (Date 1 1 1900))
-- The insured test is met (5 against 4 and 4) though the trigger is not adopted: on, as the last sentence of section 203(f)(1) says.
#ASSERT `Is my State on for this week by either test` (Date 3 3 2013) 5 4 4 0 FALSE (Date 1 1 1900) FALSE (Date 1 1 1900) 3 3 3 0 FALSE FALSE (Date 1 1 1900)

§§ `Section 205: definitions`

-- A cash benefit under State law for a week in an extended benefit period under conforming provisions: extended compensation.
#ASSERT `Is the payment I receive extended compensation` TRUE TRUE TRUE FALSE FALSE TRUE TRUE
-- The same payment for a week outside any extended benefit period: not extended compensation.
#ASSERT NOT (`Is the payment I receive extended compensation` TRUE TRUE TRUE FALSE FALSE FALSE TRUE)

#ASSERT `Does the place where I live count as a State for this Act` `a State of the United States` EQUALS `counts as a State for this title`
#ASSERT `Does the place where I live count as a State for this Act` `the Virgin Islands` EQUALS `counts as a State for this title`
-- NOT COVERED: a place the definition does not name (it says what a State "includes", not what it excludes).
#ASSERT `Does the place where I live count as a State for this Act` `a place the definition of State does not name` EQUALS `is not named by the definition of State, which says only what a State includes`

§§ `Section 207: dates`

-- A week beginning 1 January 1972 may start a period; one beginning 31 December 1971 may not, unless an approved State law so provides.
#ASSERT `Can an extended benefit period begin with the week I am claiming for` (Date 1 1 1972) FALSE
-- NOT COVERED: before 1 January 1972 without such a State law, the Act's extended benefit period cannot begin.
#ASSERT NOT (`Can an extended benefit period begin with the week I am claiming for` (Date 31 12 1971) FALSE)
-- With an approved State law, from 60 days after 10 August 1970, which is 9 October 1970.
#ASSERT `Can an extended benefit period begin with the week I am claiming for` (Date 9 10 1970) TRUE
#ASSERT NOT (`Can an extended benefit period begin with the week I am claiming for` (Date 8 10 1970) TRUE)

#ASSERT `Is a State law required to provide extended compensation for the week I am claiming for` (Date 1 1 1972) FALSE
#ASSERT NOT (`Is a State law required to provide extended compensation for the week I am claiming for` (Date 30 6 1972) TRUE)
#ASSERT `Is a State law required to provide extended compensation for the week I am claiming for` (Date 1 7 1972) TRUE

§§ `Section 208: self-employment assistance`

-- Weeks beginning after 22 February 2012 only.
#ASSERT `May I be paid self-employment assistance instead of extended compensation for this week` (Date 23 2 2012) TRUE TRUE
#ASSERT NOT (`May I be paid self-employment assistance instead of extended compensation for this week` (Date 22 2 2012) TRUE TRUE)
#ASSERT NOT (`May I be paid self-employment assistance instead of extended compensation for this week` (Date 3 3 2013) FALSE TRUE)

-- An allowance of 400 out of 5,000 leaves 4,600.
#ASSERT `How much will my extended compensation account hold after a self-employment assistance allowance` 5000 400 EQUALS 4600
-- 20 of the combined 26 weeks used: 6 left. 30 recorded: none.
#ASSERT `How many more weeks of self-employment assistance can I get` 20 EQUALS 6
#ASSERT `How many more weeks of self-employment assistance can I get` 30 EQUALS 0
-- 25 weeks when extended compensation ran out: may carry on to 26. 26: no.
#ASSERT `Can I carry on with self-employment assistance under the 2008 Act when my extended compensation runs out` TRUE 25 TRUE
#ASSERT NOT (`Can I carry on with self-employment assistance under the 2008 Act when my extended compensation runs out` TRUE 26 TRUE)
-- 13 x 400 = 5,200.
#ASSERT `Does the State expect me to be entitled to enough to be paid self-employment assistance` 5200 400
#ASSERT NOT (`Does the State expect me to be entitled to enough to be paid self-employment assistance` 5199 400)
#ASSERT `May I stop taking part in self-employment assistance whenever I want` TRUE
-- Participation ended and I still qualify: up to the 3,000 left in the account.
#ASSERT `How much more extended compensation can I be paid after I stop self-employment assistance` TRUE TRUE 3000 EQUALS 3000
#ASSERT `How much more extended compensation can I be paid after I stop self-employment assistance` TRUE FALSE 3000 EQUALS 0
