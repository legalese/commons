IMPORT prelude
IMPORT daydate
IMPORT `ks-tanf`
IMPORT `ks-tanf-seat`

-- Kansas TANF -- worked cases from the applicant's seat. Expected values worked by hand from the deposited texts
-- (K.S.A. 39-702, 39-709, 39-719b, 39-7,124, 39-7,127; K.A.R. 30-4-100, 30-4-101) before the encoding was run. Each
-- assertion is a claim about the encoding on stated facts, not about the law.

§ `Cases`

§§ `39-702(g) -- dependent child`

#ASSERT `Is this child a dependent child` 10 FALSE TRUE EQUALS TRUE
#ASSERT `Is this child a dependent child` 18 TRUE TRUE EQUALS TRUE
#ASSERT `Is this child a dependent child` 18 FALSE TRUE EQUALS FALSE
#ASSERT `Is this child a dependent child` 10 FALSE FALSE EQUALS FALSE

§§ `39-709(a) -- general requirements`

#ASSERT `Do I meet the general requirements` TRUE TRUE TRUE FALSE FALSE EQUALS TRUE
#ASSERT `Do I meet the general requirements` TRUE TRUE TRUE TRUE FALSE EQUALS FALSE
#ASSERT `Do I meet the general requirements` TRUE TRUE FALSE FALSE FALSE EQUALS FALSE
#ASSERT `Do I meet the general requirements` TRUE TRUE TRUE FALSE TRUE EQUALS FALSE

§§ `39-709(b)(3) -- time limit`

#ASSERT `Are we within the time limit` 20 `no hardship` FALSE EQUALS TRUE
#ASSERT `Are we within the time limit` 24 `no hardship` FALSE EQUALS FALSE
#ASSERT `Are we within the time limit` 30 `needs an extension to overcome the effects of domestic violence or sexual assault` TRUE EQUALS TRUE
#ASSERT `Are we within the time limit` 30 `needs an extension to overcome the effects of domestic violence or sexual assault` FALSE EQUALS FALSE
-- No extension beyond 36 months.
#ASSERT `Are we within the time limit` 36 `caretaker of a disabled family member living in the household` TRUE EQUALS FALSE

§§ `39-7,124 -- minor parent`

#ASSERT `Can a grant be paid for me as a minor parent` 16 FALSE TRUE FALSE FALSE EQUALS FALSE
#ASSERT `Can a grant be paid for me as a minor parent` 16 FALSE TRUE TRUE FALSE EQUALS TRUE
#ASSERT `Can a grant be paid for me as a minor parent` 16 FALSE TRUE FALSE TRUE EQUALS TRUE
#ASSERT `Can a grant be paid for me as a minor parent` 18 FALSE TRUE FALSE FALSE EQUALS TRUE

§§ `39-709(b)(5), (6), (8) -- work`

#ASSERT `Must I complete an assessment module` `no good cause` FALSE EQUALS TRUE
#ASSERT `Must I complete an assessment module` `a valid offer of employment, or employed at least 20 hours a week` FALSE EQUALS FALSE
#ASSERT `Must I complete an assessment module` `no good cause` TRUE EQUALS FALSE
-- One parent, youngest child 6 or older: 30 hours, 20 primary.
#ASSERT `How many hours a week must we take part` FALSE FALSE FALSE EQUALS 30
#ASSERT `How many hours must be primary` FALSE FALSE FALSE EQUALS 20
-- One parent, a child under 6: 20 hours, all primary.
#ASSERT `How many hours a week must we take part` FALSE TRUE FALSE EQUALS 20
#ASSERT `How many hours must be primary` FALSE TRUE FALSE EQUALS 20
-- Two parents with department child care: 55, 50 primary; without: 35, 30 primary.
#ASSERT `How many hours a week must we take part` TRUE FALSE TRUE EQUALS 55
#ASSERT `How many hours must be primary` TRUE FALSE TRUE EQUALS 50
#ASSERT `How many hours a week must we take part` TRUE FALSE FALSE EQUALS 35
#ASSERT `How many hours must be primary` TRUE FALSE FALSE EQUALS 30
-- A single mother caring for her six-week-old: exempt. Not if two parents are in the home, or if she is 18 without a
-- diploma.
#ASSERT `Am I exempt for a young child` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS TRUE
#ASSERT `Am I exempt for a young child` TRUE FALSE TRUE FALSE FALSE FALSE EQUALS FALSE
#ASSERT `Am I exempt for a young child` TRUE FALSE FALSE FALSE TRUE FALSE EQUALS FALSE
-- Penalties: 3, 6, 12 months, then 10 years.
#ASSERT `How long is my TANF penalty` 1 EQUALS JUST 3
#ASSERT `How long is my TANF penalty` 2 EQUALS JUST 6
#ASSERT `How long is my TANF penalty` 3 EQUALS JUST 12
#ASSERT `How long is my TANF penalty` 5 EQUALS JUST 120
#ASSERT `How long is my TANF penalty` 0 EQUALS NOTHING

§§ `K.A.R. 30-4-100, 30-4-101 -- payment standard`

-- A mother and two children in Johnson County, nobody else at home: 294 + 135 = 429.
#ASSERT `What is our TANF payment standard` 3 "Johnson" FALSE EQUALS JUST 429
-- The same family in Sedgwick County, living with the mother's brother who is not in the plan: 294 + 109 less 40% =
-- 294 + 65.40 = 359.40.
#ASSERT `What is our TANF payment standard` 3 "Sedgwick" TRUE EQUALS JUST 359.4
-- One person in plan in Allen County with others at home: 132 + 92 less 60% = 168.80.
#ASSERT `What is our TANF payment standard` 1 "Allen" TRUE EQUALS JUST 168.8
-- Six in Seward County: 362 + 2 x 61 = 484, plus 97: 581.
#ASSERT `What is our TANF payment standard` 6 "Seward" FALSE EQUALS JUST 581
-- Seven in Douglas County with others at home: 362 + 3 x 61 = 545, plus 135 less 20% = 108: 653.
#ASSERT `What is our TANF payment standard` 7 "Douglas" TRUE EQUALS JUST 653
-- Not a Kansas county: no answer.
#ASSERT `What is our TANF payment standard` 3 "Gotham" FALSE EQUALS NOTHING

§§ `39-7,127 -- the earned income disregard`

-- 500 earned: 90 + 40% of 410 = 254 disregarded, 246 counted.
#ASSERT `How much of my earnings counts` 500 EQUALS 246
#ASSERT `How much of my earnings counts` 50 EQUALS 0

§§ `Duties`

#ASSERT EVALTRACE `the 39-719b duty to report a change` 0 (LIST (EVENT `the recipient` `notify the secretary of the change` 3)) EQUALS FULFILLED
#ASSERT EVALTRACE (`the 39-709(b)(6) duty to complete an assessment module` 30) 0 (LIST (EVENT `the applicant` `complete a module of the work program assessment` 10)) EQUALS FULFILLED
`thirty days` MEANS 30
-- expect: BREACH BY the applicant, "no module of the work program assessment was completed during the application processing period ..." (completed on day 40 of a 30-day period)
#TRACE `the 39-709(b)(6) duty to complete an assessment module` `thirty days` AT 0 WITH
    PARTY `the applicant` DOES `complete a module of the work program assessment` AT 40
-- expect: BREACH BY the recipient, "TANF was used for a purchase or at a place 39-709(b)(10) prohibits"
#TRACE `the 39-709(b)(10) bar on prohibited uses of TANF` AT 0 WITH
    PARTY `the recipient` DOES `use TANF for a prohibited purchase or at a prohibited place` AT 5
