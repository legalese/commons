IMPORT prelude
IMPORT daydate
IMPORT `ks-income-tax`
IMPORT `ks-income-tax-seat`

-- Kansas income tax act -- worked cases from the taxpayer's seat.
-- Every expected value was worked by hand from the deposited text (Kansas Statutes online, 2025 session laws) before the
-- encoding was run. Federal figures are stated facts. Each assertion is a claim about the encoding on those facts, not
-- about the law; none has been checked against a Kansas Department of Revenue form K-40.

§ `Cases`

§§ `79-32,109(b) -- resident`

#ASSERT `Am I a Kansas resident` TRUE FALSE FALSE EQUALS TRUE
#ASSERT `Am I a Kansas resident` FALSE TRUE FALSE EQUALS TRUE
#ASSERT `Am I a Kansas resident` FALSE TRUE TRUE EQUALS FALSE
#ASSERT `Am I a Kansas resident` FALSE FALSE FALSE EQUALS FALSE

§§ `79-32,117 -- Kansas AGI`

-- Federal AGI 60,000 + 500 other states' bond interest - 200 US interest - 10,000 military retirement - 12,000 social
-- security = 38,300.
#ASSERT `What is my Kansas adjusted gross income` 60000 500 200 10000 12000 0 0 0 EQUALS 38300
-- KPERS benefits of 15,000 come out too (exempt under another Kansas law): 45,000 - 15,000 = 30,000.
#ASSERT `What is my Kansas adjusted gross income` 45000 0 0 0 0 15000 0 0 EQUALS 30000

§§ `79-32,116 to 79-32,121b -- Kansas taxable income`

-- Single, Kansas AGI 50,000, no dependents, $1,000 of gifts: standard 3,605 beats it; exemption 9,160. 37,235.
#ASSERT `What is my Kansas taxable income` 50000 `single` 0 0 0 0 1000 0 0 0 0 EQUALS `answered` 37235
-- Married filing jointly, both 65 (two additional deductions), two dependents, one born this year; Kansas AGI 100,000;
-- itemized 5,000 + 8,000 + 4,000 = 17,000 beats 8,240 + 2 x 700 = 9,640. Exemptions 18,320 + 2 x 2,320 + 2,320 = 25,280.
-- 100,000 - 17,000 - 25,280 = 57,720.
#ASSERT `What is my Kansas taxable income` 100000 `married filing jointly` 2 2 1 0 5000 0 8000 4000 0 EQUALS `answered` 57720
-- Head of household, one dependent, Kansas AGI 40,000: 6,180 standard; 9,160 + 2,320 + 2,320 (79-32,121b(b)(1)) =
-- 13,800. 20,020.
#ASSERT `What is my Kansas taxable income` 40000 `head of household` 0 1 0 0 0 0 0 0 0 EQUALS `answered` 20020
-- Single, Kansas AGI 10,000: below the deduction and exemption, so 0.
#ASSERT `What is my Kansas taxable income` 10000 `single` 0 0 0 0 0 0 0 0 0 EQUALS `answered` 0
-- Itemized deductions reduced by the state income taxes in them: 6,000 of property tax and 3,000 of interest, less 2,000
-- of income tax = 7,000, beats 3,605. Single, Kansas AGI 30,000: 30,000 - 7,000 - 9,160 = 13,840.
#ASSERT `What is my Kansas taxable income` 30000 `single` 0 0 0 0 0 0 3000 6000 2000 EQUALS `answered` 13840
#ASSERT `What is my Kansas taxable income` 30000 `married filing separately` 0 0 0 0 0 0 0 0 0 EQUALS `not covered` `a married person filing a separate return is not encoded: 79-32,119(c)(2) gives one standard deduction for "married filing status" and does not say how it applies to a separate return`

§§ `79-32,110 -- the schedule`

#ASSERT `tax under the 79-32,110(a) schedule` `single` 20000 EQUALS 1040
#ASSERT `tax under the 79-32,110(a) schedule` `single` 23000 EQUALS 1196
#ASSERT `tax under the 79-32,110(a) schedule` `single` 37235 EQUALS 1990.313
#ASSERT `tax under the 79-32,110(a) schedule` `married filing jointly` 46000 EQUALS 2392
#ASSERT `tax under the 79-32,110(a) schedule` `married filing jointly` 57720 EQUALS 3045.976

§§ `79-3220 -- must I file`

-- Required to file federally: a Kansas return is required.
#ASSERT `Must I make a Kansas return` TRUE 5000 `single` 0 0 FALSE EQUALS `answered` TRUE
-- Single, not required federally, gross 12,000 against 3,605 + 9,160 = 12,765: no return. At 13,000: a return.
#ASSERT `Must I make a Kansas return` FALSE 12000 `single` 0 0 FALSE EQUALS `answered` FALSE
#ASSERT `Must I make a Kansas return` FALSE 13000 `single` 0 0 FALSE EQUALS `answered` TRUE
-- Married jointly, two dependents, gross 30,000 against 8,240 + 18,320 + 4,640 = 31,200: no return.
#ASSERT `Must I make a Kansas return` FALSE 30000 `married filing jointly` 0 2 FALSE EQUALS `answered` FALSE
-- A nonresident whose only Kansas income is from an electing pass-through entity: no return.
#ASSERT `Must I make a Kansas return` TRUE 90000 `single` 0 0 TRUE EQUALS `answered` FALSE
#ASSERT `Must I make a Kansas return` TRUE 90000 `married filing separately` 0 0 FALSE EQUALS `not covered` `a married person filing a separate return is not encoded: 79-32,119(c)(2) gives one standard deduction for "married filing status" and does not say how it applies to a separate return`

§§ `79-3221, 79-3225 -- when it is due`

#ASSERT `When must I file my Kansas return` 12 2025 FALSE (DATE_FROM_DMY 1 1 2026) EQUALS (DATE_FROM_DMY 15 4 2026)
#ASSERT `When must I file my Kansas return` 12 2025 TRUE (DATE_FROM_DMY 15 10 2026) EQUALS (DATE_FROM_DMY 15 10 2026)
#ASSERT `When must I file my Kansas return` 6 2026 FALSE (DATE_FROM_DMY 1 1 2026) EQUALS (DATE_FROM_DMY 15 10 2026)
#ASSERT `When must I pay my Kansas tax` 12 2025 0 EQUALS (DATE_FROM_DMY 15 4 2026)
-- The director extends payment by six months: 15 October 2026.
#ASSERT `When must I pay my Kansas tax` 12 2025 6 EQUALS (DATE_FROM_DMY 15 10 2026)

-- The duties, in days from 31 December 2025 (15 April 2026 = day 105).
`day 105` MEANS 105
#ASSERT EVALTRACE (`the 79-3220 and 79-3221 duty to file the return` 105) 0 (LIST (EVENT `the individual` `file the return` 100)) EQUALS FULFILLED
#ASSERT EVALTRACE (`the 79-3225 duty to pay the tax` 105) 0 (LIST (EVENT `the individual` `pay the tax` 105)) EQUALS FULFILLED
-- expect: BREACH BY the individual, "the return was not filed by the 15th day of the fourth month ..." (filed on day 110, no IRS extension)
#TRACE `the 79-3220 and 79-3221 duty to file the return` `day 105` AT 0 WITH
    PARTY `the individual` DOES `file the return` AT 110
-- expect: BREACH BY the individual, "the tax was not paid on the 15th day of the fourth month ..." (paid on day 120)
#TRACE `the 79-3225 duty to pay the tax` `day 105` AT 0 WITH
    PARTY `the individual` DOES `pay the tax` AT 120

§§ `What I owe or get back`

-- Inputs: year, resident all year, status, Kansas AGI, Kansas taxable income, Kansas-source income, tax to another
-- state, 79-32,110c reduction, disabled veteran, SSNs on return, my SSN all year, spouse's SSN and joint, federal EIC,
-- federal care credit, age, household income, poverty level for two, property tax, homestead refund, withheld.

-- A. Single resident, taxable income 37,235: tax 1,990.313; withheld 2,000: refund 9.687.
#ASSERT `What do I owe or get back in Kansas` 2025 TRUE `single` 50000 37235 50000 FALSE FALSE FALSE TRUE TRUE FALSE 0 0 40 0 0 0 FALSE 2000 EQUALS `answered` (-9.687)
-- B. Head of household, taxable income 20,020: tax 1,041.04. Care credit 50% of 600 = 300: 741.04. EIC 17% of 2,000
-- = 340: 401.04. Withheld 400: 1.04 shown due, under $5, canceled (79-3225(a)): 0.
#ASSERT `What do I owe or get back in Kansas` 2025 TRUE `head of household` 40000 20020 40000 FALSE FALSE FALSE TRUE TRUE FALSE 2000 600 35 0 0 0 FALSE 400 EQUALS `answered` 0
-- C. The same without valid social security numbers on the return: no credits (79-32,265). 1,041.04 - 400 = 641.04.
#ASSERT `What do I owe or get back in Kansas` 2025 TRUE `head of household` 40000 20020 40000 FALSE FALSE FALSE FALSE TRUE FALSE 2000 600 35 0 0 0 FALSE 400 EQUALS `answered` 641.04
-- D. Single, 70, Kansas AGI 20,000; taxable income 20,000 - 3,605 - 850 - 9,160 = 6,385; tax 332.02. Household income
-- 25,000 is within 120% of a 21,150 poverty level (25,380); SAFESR 75% of 1,200 = 900, refundable: -567.98.
#ASSERT `What do I owe or get back in Kansas` 2025 TRUE `single` 20000 6385 20000 FALSE FALSE FALSE TRUE TRUE FALSE 0 0 70 25000 21150 1200 FALSE 0 EQUALS `answered` (-567.98)
-- D2. The same with a homestead refund for the home: no SAFESR. 332.02.
#ASSERT `What do I owe or get back in Kansas` 2025 TRUE `single` 20000 6385 20000 FALSE FALSE FALSE TRUE TRUE FALSE 0 0 70 25000 21150 1200 TRUE 0 EQUALS `answered` 332.02
-- E. Nonresident, single, Kansas AGI 80,000, taxable income 67,235, Kansas-source 20,000. Tax as a resident 1,196 +
-- 5.58% of 44,235 = 3,664.313; times 20,000 / 80,000 = 916.07825. Withheld 900: 16.07825.
#ASSERT `What do I owe or get back in Kansas` 2025 FALSE `single` 80000 67235 20000 FALSE FALSE FALSE TRUE TRUE FALSE 0 0 40 0 0 0 FALSE 900 EQUALS `answered` 16.07825
-- F. Single resident, taxable income 10,000: tax 520. Care credit 50% of 1,200 = 600, cut to 520. EIC 17% of 500 = 85
-- refunded: -85.
#ASSERT `What do I owe or get back in Kansas` 2025 TRUE `single` 20000 10000 20000 FALSE FALSE FALSE TRUE TRUE FALSE 500 1200 30 0 0 0 FALSE 0 EQUALS `answered` (-85)
-- Not covered.
#ASSERT `What do I owe or get back in Kansas` 2024 TRUE `single` 50000 37235 50000 FALSE FALSE FALSE TRUE TRUE FALSE 0 0 40 0 0 0 FALSE 0 EQUALS `not covered` `tax years before 2025 are not encoded: the 2025 exemption amounts of 79-32,121 and 79-32,121b are the ones encoded`
#ASSERT `What do I owe or get back in Kansas` 2026 TRUE `single` 50000 37235 50000 FALSE TRUE FALSE TRUE TRUE FALSE 0 0 40 0 0 0 FALSE 0 EQUALS `not covered` `a rate reduction certified and published by the secretary of revenue under 79-32,110c is not encoded: the rates would be those the secretary published`
#ASSERT `What do I owe or get back in Kansas` 2025 TRUE `single` 50000 37235 50000 FALSE FALSE TRUE TRUE TRUE FALSE 0 0 40 0 0 0 FALSE 0 EQUALS `not covered` `the additional exemption of a 100% disabled veteran is not encoded: 79-32,121(b) gives $2,250 and 79-32,121b(b)(2) gives $2,320 for the same person, and the two 2025 Acts are not reconciled in the deposited text`
#ASSERT `What do I owe or get back in Kansas` 2025 TRUE `single` 50000 37235 50000 TRUE FALSE FALSE TRUE TRUE FALSE 0 0 40 0 0 0 FALSE 0 EQUALS `not covered` `the credit for income tax paid to another state (79-32,111(a)) is not encoded`
#ASSERT `What do I owe or get back in Kansas` 2025 TRUE `married filing separately` 50000 37235 50000 FALSE FALSE FALSE TRUE TRUE FALSE 0 0 40 0 0 0 FALSE 0 EQUALS `not covered` `a married person filing a separate return is not encoded: 79-32,119(c)(2) gives one standard deduction for "married filing status" and does not say how it applies to a separate return`

§§ `79-32,205, 79-32,263 -- the credits alone`

#ASSERT `What is my Kansas earned income credit` 1000 EQUALS 170
#ASSERT `What is my SAFESR credit` 64 20000 21150 1000 FALSE EQUALS 0
#ASSERT `What is my SAFESR credit` 65 25380 21150 1000 FALSE EQUALS 750
#ASSERT `What is my SAFESR credit` 65 25381 21150 1000 FALSE EQUALS 0
