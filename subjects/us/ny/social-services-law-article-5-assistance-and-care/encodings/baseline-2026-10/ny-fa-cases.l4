IMPORT prelude
IMPORT daydate
IMPORT `ny-fa`
IMPORT `ny-fa-seat`

-- New York Social Services Law Article 5 (family assistance) -- worked cases from the applicant's seat.
-- Every assertion is a claim about the ENCODING on stated facts. Expected values were worked by hand from the deposited
-- text (ny-ssl-art5-selected.txt), never copied from the encoding's output. All the families are HYPOTHETICAL; the shelter
-- amounts and the 50% disregard percentage are the encoder's inputs (NOTES.md findings 4 and 6).

-- ---------------------------------------------------------------------------------------------------------------------
-- s 349 A: a child.
#ASSERT `Does this child count for family assistance` 17 FALSE
#ASSERT `Does this child count for family assistance` 18 TRUE
#ASSERT (`Does this child count for family assistance` 18 FALSE) EQUALS FALSE
#ASSERT (`Does this child count for family assistance` 19 TRUE) EQUALS FALSE

-- s 349 A, B: the group given family assistance.
#ASSERT `Is my family in the group given family assistance` TRUE FALSE FALSE FALSE FALSE FALSE
#ASSERT `Is my family in the group given family assistance` FALSE TRUE TRUE TRUE TRUE TRUE
-- The official does not judge the applicant fit: not given.
#ASSERT (`Is my family in the group given family assistance` FALSE TRUE TRUE TRUE FALSE TRUE) EQUALS FALSE
-- The child was not a New York resident on the day of application: not given.
#ASSERT (`Is my family in the group given family assistance` FALSE TRUE TRUE TRUE TRUE FALSE) EQUALS FALSE

-- s 131(6): a parent of 17, unmarried, caring for her baby.
-- Living in her mother's home: allowed.
#ASSERT `Does my living arrangement allow me family assistance` TRUE TRUE TRUE FALSE FALSE FALSE
-- Living alone, no exception: not allowed.
#ASSERT (`Does my living arrangement allow me family assistance` TRUE TRUE FALSE FALSE FALSE FALSE) EQUALS FALSE
-- Living alone, an exception (for example abuse in the parent's home) and the current arrangement found appropriate: allowed.
#ASSERT `Does my living arrangement allow me family assistance` TRUE TRUE FALSE FALSE TRUE TRUE
-- An exception, but the current arrangement not found appropriate: she must live in a supervised arrangement.
#ASSERT (`Does my living arrangement allow me family assistance` TRUE TRUE FALSE FALSE TRUE FALSE) EQUALS FALSE
#ASSERT `Does my living arrangement allow me family assistance` TRUE TRUE FALSE TRUE TRUE FALSE
-- Not under 18: the rule does not apply.
#ASSERT `Does my living arrangement allow me family assistance` FALSE TRUE FALSE FALSE FALSE FALSE

-- s 131(6): the fair hearing within thirty days of a timely request. Held on day 25: met.
#ASSERT EVALTRACE (`the minor parent's fair hearing` TRUE) 0 (LIST EVENT `the social services district` `hold a fair hearing` 25) EQUALS FULFILLED
-- expect: BREACH BY `the social services district`, "no fair hearing held within thirty days of the request (s 131(6))" -- held on day 40.
#TRACE `the minor parent's fair hearing` TRUE AT 0 WITH
    PARTY `the social services district` DOES `hold a fair hearing` AT 40

-- ---------------------------------------------------------------------------------------------------------------------
-- s 350(2): sixty months as an adult: not yet "longer than sixty months".
#ASSERT (`Does the sixty-month limit stop my family assistance` 60 FALSE) EQUALS FALSE
#ASSERT `Does the sixty-month limit stop my family assistance` 61 FALSE
-- The hardship exemption (an independently verified impairment, or SSI): not stopped.
#ASSERT (`Does the sixty-month limit stop my family assistance` 61 TRUE) EQUALS FALSE

-- s 131(10): quit on 1 March 2026 to qualify: disqualified for ninety days, to 30 May 2026.
#ASSERT `From when may I get assistance after quitting to qualify` (Date 1 3 2026) EQUALS Date 30 5 2026
-- The district gives no assistance within the ninety days: the prohibition is respected.
#ASSERT EVALTRACE (`the voluntary quit disqualification` TRUE) 0 (LIST EVENT `the social services district` `give public assistance to the applicant` 95) EQUALS FULFILLED
-- expect: BREACH BY `the social services district`, "assistance given within ninety days of a voluntary quit to qualify (s 131(10))" -- assistance on day 45.
#TRACE `the voluntary quit disqualification` TRUE AT 0 WITH
    PARTY `the social services district` DOES `give public assistance to the applicant` AT 45
-- No voluntary quit: nothing barred.
#ASSERT EVALTRACE (`the voluntary quit disqualification` FALSE) 0 (LIST EVENT `the social services district` `give public assistance to the applicant` 5) EQUALS FULFILLED

-- s 349 D: a strike on the last day of the month bars that month.
#ASSERT `Does a strike stop family assistance this month` TRUE
#ASSERT (`Does a strike stop family assistance this month` FALSE) EQUALS FALSE

-- ---------------------------------------------------------------------------------------------------------------------
-- s 131-n(1): resources.
-- Applicant, $3,000 cash, a car worth $15,000: $3,000 of the car is over $12,000; $6,000 less $2,500 = $3,500 counts.
#ASSERT `How much of my resources counts` FALSE FALSE 3000 15000 0 EQUALS 3500
-- The same family already receiving assistance: $10,000 is exempt: nothing counts.
#ASSERT `How much of my resources counts` TRUE FALSE 3000 15000 0 EQUALS 0
-- An applicant household with a member aged 60: $3,750 exempt; $3,000 cash, no car: nothing counts.
#ASSERT `How much of my resources counts` FALSE TRUE 3000 0 0 EQUALS 0
-- A district that has adopted a $16,000 car limit: the $15,000 car is exempt; $3,000 less $2,500 = $500.
#ASSERT `How much of my resources counts` FALSE FALSE 3000 15000 16000 EQUALS 500

-- s 131-a(2): the standard of need.
-- Three people, shelter $400: $336 + $30.00 + $23 + $400 = $789.
#ASSERT `What is my standard of need` 3 400 0 0 EQUALS 789
-- One person, shelter $300: $158 + $14.10 + $11 + $300 = $483.10, rounded down to $483 (s 131-a(2)(e)).
#ASSERT `What is my standard of need` 1 300 0 0 EQUALS 483
-- Eight people, shelter $500: $617 + 2 x $85; $55.20 + 2 x $7.50; $42 + 2 x $5: $787 + $70.20 + $52 + $500 = $1,409.20, to $1,409.
#ASSERT `What is my standard of need` 8 500 0 0 EQUALS 1409
-- Fuel for heating of $60 and $25 for meals added: $789 + $85 = $874.
#ASSERT `What is my standard of need` 3 400 60 25 EQUALS 874

-- s 131-a(8): earnings.
-- $1,000 a month, 50%: $500; less $150: $350 counts.
#ASSERT `How much of my earnings counts` 1000 0.5 FALSE FALSE FALSE EQUALS 350
-- (c): income above need and no assistance in the last four months: no $150: $500.
#ASSERT `How much of my earnings counts` 1000 0.5 FALSE TRUE FALSE EQUALS 500
-- (b): quit without good cause within 75 days: neither disregard: $1,000.
#ASSERT `How much of my earnings counts` 1000 0.5 TRUE FALSE FALSE EQUALS 1000
-- (xiii): the lifetime six months after job entry: nothing counts.
#ASSERT `How much of my earnings counts` 1000 0.5 FALSE FALSE TRUE EQUALS 0
-- $200: $100 after 50%, under $150: nothing counts.
#ASSERT `How much of my earnings counts` 200 0.5 FALSE FALSE FALSE EQUALS 0
-- (c) itself: gross $900 against a need of $789, no assistance in the last four months: the bar is met.
#ASSERT `Do I lose the 150 dollar disregard` 900 789 FALSE
#ASSERT (`Do I lose the 150 dollar disregard` 900 789 TRUE) EQUALS FALSE
#ASSERT (`Do I lose the 150 dollar disregard` 700 789 FALSE) EQUALS FALSE

-- (v): child support for one child: $150 received, $100 disregarded, $50 counts; for two children, $150 is all disregarded.
#ASSERT `countable support payments` 150 FALSE EQUALS 50
#ASSERT `countable support payments` 150 TRUE EQUALS 0

-- s 131-a(1), (3): the monthly grant.
-- Need $789, countable earnings $350, $150 support for one child ($50 counts), no other income or resources: $389.
#ASSERT `How much family assistance a month` 789 350 150 FALSE 0 0 EQUALS 389
-- The same with $3,500 of countable resources: nothing.
#ASSERT `How much family assistance a month` 789 350 150 FALSE 0 3500 EQUALS 0
-- Need $789, income $782.50: $6.50 rounds to $6, under $10: no payment (s 131-a(3)(b)).
#ASSERT `How much family assistance a month` 789 782.5 0 FALSE 0 0 EQUALS 0
-- Need $789, income $100.50: $688.50 rounds down to $688 (s 131-a(3)(c)).
#ASSERT `How much family assistance a month` 789 100.5 0 FALSE 0 0 EQUALS 688
-- One person, need $483, no income: $483.
#ASSERT `How much family assistance a month` 483 0 0 FALSE 0 0 EQUALS 483

-- A whole family: a mother applying for herself and two children, shelter $400, earning $1,000 a month, $1,000 in the bank
-- and a car worth $8,000, no assistance in the last four months. Resources: nothing counts. Need $789. Gross $1,000 is above
-- $789 and she had no recent assistance, so (c) takes away the $150: earnings count at $500. Grant: $789 - $500 = $289.
#ASSERT `How much of my resources counts` FALSE FALSE 1000 8000 0 EQUALS 0
#ASSERT `Do I lose the 150 dollar disregard` 1000 (`What is my standard of need` 3 400 0 0) FALSE
#ASSERT `How much family assistance a month` (`What is my standard of need` 3 400 0 0) (`How much of my earnings counts` 1000 0.5 FALSE TRUE FALSE) 0 FALSE 0 0 EQUALS 289

-- s 131-a(7): rent not paid out of the shelter allowance: the district must pay the landlord directly.
#ASSERT EVALTRACE (`direct payment of my shelter allowance` TRUE FALSE) 0 (LIST EVENT `the social services district` `pay the shelter allowance directly to the landlord` 10) EQUALS FULFILLED
-- Rent withheld under a court order: no duty arises.
#ASSERT EVALTRACE (`direct payment of my shelter allowance` TRUE TRUE) 0 (LIST) EQUALS FULFILLED
