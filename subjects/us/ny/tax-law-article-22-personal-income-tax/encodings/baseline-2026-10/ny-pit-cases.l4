IMPORT prelude
IMPORT daydate
IMPORT `ny-pit`
IMPORT `ny-pit-seat`

-- New York Tax Law Article 22 -- worked cases from the seat of the resident individual taxpayer.
-- Every assertion is a claim about the ENCODING on stated facts. Expected values were worked by hand from the deposited
-- text (ny-tax-law-art22-selected.txt), never copied from the encoding's output. All the people are HYPOTHETICAL.
-- The s 614(f) cost-of-living increases used (500 single, 700 head of household, 1,050 joint) are the encoder's
-- HYPOTHETICAL inputs: the deposited text does not state the adjusted amounts (NOTES.md finding 2).

-- ---------------------------------------------------------------------------------------------------------------------
-- s 605(b)(1): residence.
-- Domiciled in New York, no abode there, an abode elsewhere, 25 days in the state: not a resident ((A)(i)).
#ASSERT (`Am I a New York resident` TRUE FALSE TRUE 25 FALSE FALSE) EQUALS FALSE
-- The same, with 31 days: the exception needs "not more than thirty days", so a resident.
#ASSERT `Am I a New York resident` TRUE FALSE TRUE 31 FALSE FALSE
-- Domiciled in New York and keeping an abode there: a resident whatever the days.
#ASSERT `Am I a New York resident` TRUE TRUE FALSE 10 FALSE FALSE
-- Domiciled, but meeting the 548-day foreign presence test: not a resident ((A)(ii)).
#ASSERT (`Am I a New York resident` TRUE TRUE FALSE 10 TRUE FALSE) EQUALS FALSE
-- Statutory resident ((B)): domiciled elsewhere, an abode in New York, 184 days: a resident; 183 days: not.
#ASSERT `Am I a New York resident` FALSE TRUE TRUE 184 FALSE FALSE
#ASSERT (`Am I a New York resident` FALSE TRUE TRUE 183 FALSE FALSE) EQUALS FALSE
-- (B) does not reach an individual in active service in the armed forces.
#ASSERT (`Am I a New York resident` FALSE TRUE TRUE 200 FALSE TRUE) EQUALS FALSE

-- ---------------------------------------------------------------------------------------------------------------------
-- s 614: the standard deduction.
#ASSERT `What is my New York standard deduction` `single` FALSE 0 EQUALS 7500
#ASSERT `What is my New York standard deduction` `single` FALSE 500 EQUALS 8000
#ASSERT `What is my New York standard deduction` `married filing jointly` FALSE 0 EQUALS 15000
#ASSERT `What is my New York standard deduction` `surviving spouse` FALSE 0 EQUALS 15000
#ASSERT `What is my New York standard deduction` `head of household` FALSE 0 EQUALS 10500
#ASSERT `What is my New York standard deduction` `married filing separately` FALSE 0 EQUALS 7500
#ASSERT `What is my New York standard deduction` `single` TRUE 0 EQUALS 3000

-- ---------------------------------------------------------------------------------------------------------------------
-- s 651(a)(1): who must file.
-- A resident with $3,500 of federal AGI, no federal return required, standard deduction $8,000: the lower figure is
-- $4,000, and $3,500 does not exceed it: no return required.
#ASSERT (`Must I file a New York return` TRUE FALSE 3500 0 8000 FALSE) EQUALS FALSE
-- $4,001: in excess of $4,000: must file.
#ASSERT `Must I file a New York return` TRUE FALSE 4001 0 8000 FALSE
-- $3,800 of federal AGI plus $300 of s 612(b) additions = $4,100: must file.
#ASSERT `Must I file a New York return` TRUE FALSE 3800 300 8000 FALSE
-- A dependant with a $3,100 standard deduction (lower than $4,000) and $3,200 of federal AGI: must file.
#ASSERT `Must I file a New York return` TRUE FALSE 3200 0 3100 FALSE
-- Required to file federally: must file, whatever the income.
#ASSERT `Must I file a New York return` TRUE TRUE 1000 0 8000 FALSE
-- A lump sum distribution taxed under s 603: must file.
#ASSERT `Must I file a New York return` TRUE FALSE 0 0 8000 TRUE
-- Not a resident: s 651(a)(1) does not apply (s 651(a)(3) is not encoded).
#ASSERT (`Must I file a New York return` FALSE TRUE 90000 0 8000 FALSE) EQUALS FALSE

-- ss 651(a), 652(a): the 2026 return and the tax are due on 15 April 2027.
#ASSERT `By when must I file and pay` 2026 EQUALS Date 15 4 2027
-- s 652(b): Department-computed tax, notice and demand of 10 April 2027: ten days later, 20 April 2027, is the later date.
#ASSERT `By when must I pay a tax the Department computed` 2026 (Date 10 4 2027) EQUALS Date 20 4 2027
-- Notice of 1 March 2027: ten days later is 11 March, so the filing date, 15 April 2027, is the later.
#ASSERT `By when must I pay a tax the Department computed` 2026 (Date 1 3 2027) EQUALS Date 15 4 2027

-- The regulative rule: 105 days run from 31 December 2026 to 15 April 2027 (31 + 28 + 31 + 15).
#ASSERT ((`the due date for the return and the tax` 2026) MINUS (Date 31 12 2026)) EQUALS 105
-- Filing and paying on day 100: both duties met.
#ASSERT EVALTRACE (`my duty to file and pay` 2026) 0 (LIST EVENT `the taxpayer` `make and file the return` 100, EVENT `the taxpayer` `pay the tax due` 100) EQUALS FULFILLED
-- expect: BREACH BY `the taxpayer`, "no return filed by the fifteenth day of the fourth month after the taxable year (s 651(a))" -- the return comes on day 120, after the due date.
#TRACE `my duty to file and pay` 2026 AT 0 WITH
    PARTY `the taxpayer` DOES `pay the tax due` AT 100
    PARTY `the taxpayer` DOES `make and file the return` AT 120

-- ---------------------------------------------------------------------------------------------------------------------
-- s 612: New York AGI.
-- s 612(c)(3-a): aged 65 with $25,000 of private pension: $20,000 may be subtracted; under 59 and a half: nothing.
#ASSERT `How much is my pension subtraction` TRUE 25000 EQUALS 20000
#ASSERT `How much is my pension subtraction` TRUE 12000 EQUALS 12000
#ASSERT `How much is my pension subtraction` FALSE 25000 EQUALS 0
-- Federal AGI $90,000; $10,000 taxable social security (3-c) and the $20,000 pension subtraction: New York AGI $60,000.
#ASSERT `What is my New York AGI` 90000 0 0 20000 0 10000 0 EQUALS 60000
-- With $1,500 of other-state bond interest added (612(b)(1)) and a $5,000 New York State pension subtracted ((c)(3)(i)).
#ASSERT `What is my New York AGI` 90000 1500 5000 20000 0 10000 0 EQUALS 56500

-- ss 611, 613, 616: New York taxable income.
-- New York AGI $50,000, standard deduction $8,000, no dependants: $42,000.
#ASSERT `What is my New York taxable income` 50000 8000 FALSE 0 0 EQUALS 42000
-- Two dependants: $1,000 each (s 616(a)): $40,000.
#ASSERT `What is my New York taxable income` 50000 8000 FALSE 0 2 EQUALS 40000
-- Itemizing $12,000: $38,000.
#ASSERT `What is my New York taxable income` 50000 8000 TRUE 12000 0 EQUALS 38000
-- Itemizing only $6,000, below the $8,000 standard deduction: the department recomputes on the standard deduction (s 613).
#ASSERT `What is my New York taxable income` 50000 8000 TRUE 6000 0 EQUALS 42000
#ASSERT EVALTRACE (`the department's duty to recompute on the standard deduction` 8000 6000) 0 (LIST EVENT `the department` `recompute the tax on the standard deduction and notify the taxpayer` 30) EQUALS FULFILLED
#ASSERT EVALTRACE (`the department's duty to recompute on the standard deduction` 8000 12000) 0 (LIST) EQUALS FULFILLED
-- Never below zero.
#ASSERT `What is my New York taxable income` 5000 8000 FALSE 0 0 EQUALS 0

-- ---------------------------------------------------------------------------------------------------------------------
-- s 601: the tax.
-- Single, 2026, taxable income $42,000: over $13,900 and not over $80,650: $586 + 5.40% of $28,100 = $586 + $1,517.40.
#ASSERT `How much New York tax before credits` `single` 2026 50000 42000 EQUALS `answered` 2103.4
-- The same in 2027 (s 601(c)(1)(B)(viii)): $572 + 5.30% of $28,100 = $572 + $1,489.30.
#ASSERT `How much New York tax before credits` `single` 2027 50000 42000 EQUALS `answered` 2061.3
-- Single, 2026, $8,000: the bottom row, 3.90%: $312.
#ASSERT `How much New York tax before credits` `single` 2026 16000 8000 EQUALS `answered` 312
-- At a bracket edge: $8,500 is "not over $8,500": 3.90% = $331.50 (the next row's $332 is the rounded figure).
#ASSERT `How much New York tax before credits` `married filing separately` 2026 16500 8500 EQUALS `answered` 331.5
-- Head of household, 2026, $16,800: over $12,800, not over $17,650: $499 + 4.40% of $4,000 = $675.
#ASSERT `How much New York tax before credits` `head of household` 2026 30000 16800 EQUALS `answered` 675
-- Joint, 2027, $43,950: over $27,900, not over $161,550: $1,146 + 5.30% of $16,050 = $1,996.65.
#ASSERT `How much New York tax before credits` `married filing jointly` 2027 60000 43950 EQUALS `answered` 1996.65
-- Surviving spouse uses table (a): 2026, $20,000: $669 + 4.40% of $2,850 = $794.40.
#ASSERT `How much New York tax before credits` `surviving spouse` 2026 35000 20000 EQUALS `answered` 794.4
-- New York AGI over $100,000: the s 601(d-1) recapture applies and is not encoded.
#ASSERT `How much New York tax before credits` `single` 2026 120000 110000 EQUALS `not covered` `New York adjusted gross income over $100,000 brings in the tax table benefit recapture (s 601(d-1)), which is not encoded`
-- Tax year 2025: not encoded.
#ASSERT `How much New York tax before credits` `single` 2025 50000 42000 EQUALS `not covered` `only tax years 2026 and 2027 are encoded (s 601(a)(1)(B)(vii), (viii))`

-- ---------------------------------------------------------------------------------------------------------------------
-- s 606(b): the household credit.
-- Single, household gross income $6,500: $50, within a tax of $253.50.
#ASSERT `How much is my household credit` `single` FALSE 6500 1 253.5 EQUALS 50
-- The same, but a tax of only $30: capped at the tax (s 606(b)(1)).
#ASSERT `How much is my household credit` `single` FALSE 6500 1 30 EQUALS 30
-- Single over $28,000: none.
#ASSERT `How much is my household credit` `single` FALSE 28001 1 900 EQUALS 0
-- A dependant is not a "household" (s 606(b)(3)(B)): none.
#ASSERT `How much is my household credit` `single` TRUE 4000 1 100 EQUALS 0
-- Head of household with two dependants (3 exemptions), $30,000: $20 + $5 x 2 = $30.
#ASSERT `How much is my household credit` `head of household` FALSE 30000 3 675 EQUALS 30
-- Married, joint, four exemptions, $18,000: $60 + $15 x 3 = $105.
#ASSERT `How much is my household credit` `married filing jointly` FALSE 18000 4 500 EQUALS 105
-- Married filing separately, combined household income $18,000, four exemptions: half of $105.
#ASSERT `How much is my household credit` `married filing separately` FALSE 18000 4 500 EQUALS 52.5
-- Joint, over $32,000: none.
#ASSERT `How much is my household credit` `married filing jointly` FALSE 32001 4 900 EQUALS 0

-- s 606(c-1)(1-a)(D): a qualifying child.
#ASSERT `Does this child qualify for the Empire State child credit` TRUE TRUE 16 FALSE FALSE TRUE
#ASSERT (`Does this child qualify for the Empire State child credit` TRUE TRUE 17 FALSE FALSE TRUE) EQUALS FALSE
#ASSERT (`Does this child qualify for the Empire State child credit` TRUE FALSE 5 FALSE FALSE TRUE) EQUALS FALSE
#ASSERT (`Does this child qualify for the Empire State child credit` TRUE TRUE 15 FALSE FALSE FALSE) EQUALS FALSE

-- s 606(c-1)(1-a)(B), (C): the Empire State child credit for 2026 and 2027.
-- Two children, aged 2 and 6, head of household, federal AGI $30,000: $1,000 + $500 = $1,500.
#ASSERT `How much is my Empire State child credit` `head of household` 30000 1 1 EQUALS 1500
-- Joint, one child aged 5, federal AGI $115,500: $5,500 over $110,000, five whole thousands: $500 - 5 x $16.50 = $417.50.
#ASSERT `How much is my Empire State child credit` `married filing jointly` 115500 0 1 EQUALS 417.5
-- Married filing separately, federal AGI $55,999: less than a whole $1,000 over $55,000: no reduction.
#ASSERT `How much is my Empire State child credit` `married filing separately` 55999 1 0 EQUALS 1000
-- Single, one child aged 10, federal AGI $120,000: $45,000 over: 45 x $16.50 = $742.50 exceeds $500: nil, not below zero.
#ASSERT `How much is my Empire State child credit` `single` 120000 0 1 EQUALS 0
-- Surviving spouse ("qualified surving spouse" in (C)(ii)), federal AGI $76,000, one child aged 8: $1,000 over $75,000: $500 - $16.50.
#ASSERT `How much is my Empire State child credit` `surviving spouse` 76000 0 1 EQUALS 483.5

-- s 606(d): the earned income credit. Federal EIC $5,000, household credit $30: 30% of $5,000 less $30 = $1,470.
#ASSERT `How much is my New York earned income credit` 5000 30 EQUALS 1470
-- After the reversion event, 20%: $1,000 less $30.
#ASSERT `the New York earned income credit` 5000 30 TRUE EQUALS 970
-- A small federal EIC of $100: $30 less a $15 household credit = $15; less a $75 household credit: nil, not below zero.
#ASSERT `How much is my New York earned income credit` 100 15 EQUALS 15
#ASSERT `How much is my New York earned income credit` 100 75 EQUALS 0

-- ---------------------------------------------------------------------------------------------------------------------
-- The bottom line.
-- Single, 2026, federal AGI $50,000, no adjustments, standard deduction $8,000 (7,500 + 500): tax $2,103.40, no credits.
#ASSERT `How much New York tax do I owe after credits` 2026 TRUE `single` FALSE FALSE 50000 0 0 0 500 FALSE 0 0 0 0 0 EQUALS `answered` 2103.4
-- Head of household, 2026, federal AGI $30,000, two children (2 and 6), standard deduction $11,200, federal EIC $5,000:
-- taxable $30,000 - $11,200 - $2,000 = $16,800; tax $675; household credit $30; Empire State child credit $1,500;
-- New York EIC $1,470: $645 - $2,970 = -$2,325, a refund of $2,325.
#ASSERT `How much New York tax do I owe after credits` 2026 TRUE `head of household` FALSE FALSE 30000 0 0 0 700 FALSE 0 2 1 1 5000 EQUALS `answered` (-2325)
#ASSERT EVALTRACE (`the comptroller's duty to pay my excess credit` 2325) 0 (LIST EVENT `the comptroller` `pay the excess credit as an overpayment` 60) EQUALS FULFILLED
-- Joint, 2027, federal AGI $90,000, subtractions $30,000 (taxable social security $10,000, pension $20,000), standard
-- deduction $16,050: taxable $43,950; tax $1,996.65; household credit nil (over $32,000); no children; no EIC.
#ASSERT `How much New York tax do I owe after credits` 2027 TRUE `married filing jointly` FALSE FALSE 90000 0 0 30000 1050 FALSE 0 0 0 0 0 EQUALS `answered` 1996.65
-- Not a resident: not covered.
#ASSERT `How much New York tax do I owe after credits` 2026 FALSE `single` FALSE FALSE 50000 0 0 0 500 FALSE 0 0 0 0 0 EQUALS `not covered` `only resident individuals are encoded; nonresident and part-year resident tax (s 601(e), Part III) is not`
-- A lump sum distribution taxed under s 603: not covered.
#ASSERT `How much New York tax do I owe after credits` 2026 TRUE `single` FALSE TRUE 50000 0 0 0 500 FALSE 0 0 0 0 0 EQUALS `not covered` `a lump sum distribution taxed under s 603 is not encoded`
-- New York AGI $150,000: the recapture: not covered.
#ASSERT `How much New York tax do I owe after credits` 2026 TRUE `single` FALSE FALSE 150000 0 0 0 500 FALSE 0 0 0 0 0 EQUALS `not covered` `New York adjusted gross income over $100,000 brings in the tax table benefit recapture (s 601(d-1)), which is not encoded`
