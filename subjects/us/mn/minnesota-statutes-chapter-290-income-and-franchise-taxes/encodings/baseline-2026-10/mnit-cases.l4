IMPORT prelude
IMPORT mnit

-- Cases for mnit.l4. Expected values worked out by hand from the deposited Minnesota Statutes 2025, ch. 290 (290.01,
-- 290.0121, 290.0123, 290.0132, subd. 26, 290.06, subds. 2c, 2d, 290.0661, 290.0671), not copied from the encoding's output.
-- Most cases use inflation factors of 1, which gives the statutory-year figures; they are not the figures for any one tax
-- year (the statutory years differ: 2019, 2023, 2025). Federal figures are invented.

§ `Cases`

§§ `Residence (290.01, subd. 7)`

#ASSERT `Am I a Minnesota resident` TRUE FALSE 0 365 FALSE FALSE
#ASSERT `Am I a Minnesota resident` FALSE TRUE 183 365 FALSE FALSE
#ASSERT (NOT (`Am I a Minnesota resident` FALSE TRUE 182 365 FALSE FALSE))
#ASSERT (NOT (`Am I a Minnesota resident` FALSE TRUE 200 365 FALSE TRUE))

§§ `The rates (290.06, subds. 2c, 2d)`

-- Single, $50,000: 5.35% x 26,520 = 1,418.82; 6.8% x 23,480 = 1,596.64; total 3,015.46.
#ASSERT `What Minnesota tax is charged on my income` "single" 50000 1 EQUALS 3015.46
-- Joint, $200,000: 2,074.195 + 6.8% x 115,250 (7,837) + 7.85% x 45,980 (3,609.43) = 13,520.625.
#ASSERT `What Minnesota tax is charged on my income` "married filing jointly" 200000 1 EQUALS 13520.625
-- Separate, $100,000: brackets halved (19,385; 77,010; 134,505): 1,037.0975 + 3,918.5 + 1,804.715 = 6,760.3125.
#ASSERT `What Minnesota tax is charged on my income` "married filing separately" 100000 1 EQUALS 6760.3125
-- Head of household with a factor of 1.1: 32,650 x 1.1 = 35,915, which ends in 5 and rounds up to 35,920. At $40,000:
-- 5.35% x 35,920 = 1,921.72, plus 6.8% x 4,080 = 277.44: 2,199.16.
#ASSERT `What Minnesota tax is charged on my income` "head of household" 40000 1.1 EQUALS 2199.16

§§ `The standard deduction (290.0123)`

#ASSERT `What is my Minnesota standard deduction` "single" 50000 FALSE FALSE FALSE FALSE 1 EQUALS 13825
#ASSERT `What is my Minnesota standard deduction` "head of household" 50000 FALSE FALSE FALSE FALSE 1 EQUALS 20800
-- Single, 65 and blind: 13,825 + 2 x 1,850 = 17,525. Joint, both 65: 27,650 + 2 x 1,450 = 30,550.
#ASSERT `What is my Minnesota standard deduction` "single" 50000 TRUE TRUE FALSE FALSE 1 EQUALS 17525
#ASSERT `What is my Minnesota standard deduction` "married filing jointly" 50000 TRUE FALSE TRUE FALSE 1 EQUALS 30550
-- Factor 1.03: joint 27,650 x 1.03 = 28,479.50, down to 28,450; single is half: 14,225.
#ASSERT `What is my Minnesota standard deduction` "single" 50000 FALSE FALSE FALSE FALSE 1.03 EQUALS 14225
-- Single, AGI $250,000: 3% x 29,350 = 880.50, less than 80% (11,060): 13,825 - 880.50 = 12,944.50.
#ASSERT `What is my Minnesota standard deduction` "single" 250000 FALSE FALSE FALSE FALSE 1 EQUALS 12944.5
-- AGI $400,000: 3% x 84,320 + 10% x 95,030 = 12,032.60, more than 80%: reduced by 11,060 to 2,765. Over $1,000,000: 2,765.
#ASSERT `What is my Minnesota standard deduction` "single" 400000 FALSE FALSE FALSE FALSE 1 EQUALS 2765
#ASSERT `What is my Minnesota standard deduction` "single" 1200000 FALSE FALSE FALSE FALSE 1 EQUALS 2765

§§ `The Social Security subtraction (290.0132, subd. 26)`

-- Single, AGI $90,000, $20,000 taxable benefits, provisional income $80,000. Simplified: 12,000 over 78,000 is 3 steps of
-- $4,000: 30% off: 14,000. Alternate: 4,560 - 20% x 10,750 = 2,410. The greater: 14,000.
#ASSERT `How much Social Security may I subtract` "single" 20000 90000 80000 1 EQUALS 14000
-- AGI $130,000: 52,000 over is 13 steps, 130%: simplified 0. Alternate with provisional $70,000: 4,560 - 150 = 4,410.
#ASSERT `How much Social Security may I subtract` "single" 20000 130000 70000 1 EQUALS 4410
-- Joint, AGI $100,500: 1 step (fraction of $4,000), 10% off $30,000 = 27,000.
#ASSERT `How much Social Security may I subtract` "married filing jointly" 30000 100500 95000 1 EQUALS 27000

§§ `The child tax credit and working family credit (290.0661, 290.0671)`

-- Head of household, two children under 18, earned income and AGI $25,000: 2 x 1,750 + 4% x 8,750 = 3,850; under the
-- $29,500 threshold.
#ASSERT `How much child tax credit and working family credit do I get` "head of household" TRUE 25000 25000 2 0 1 1 1 EQUALS 3850
-- Earned income $40,000: 12% x 10,500 = 1,260 off: 2,590.
#ASSERT `How much child tax credit and working family credit do I get` "head of household" TRUE 40000 40000 2 0 1 1 1 EQUALS 2590
-- Joint, two under 18 and one aged 19 at school, $50,000: 3,500 + 350 + 925 = 4,775, less 12% x 15,000 = 1,800: 2,975.
#ASSERT `How much child tax credit and working family credit do I get` "married filing jointly" TRUE 50000 50000 2 1 1 1 1 EQUALS 2975
-- Single with one qualifying older child only, $30,000: 350 + 925 = 1,275, phased out at 9%: 9% x 500 = 45: 1,230.
#ASSERT `How much child tax credit and working family credit do I get` "single" TRUE 30000 30000 0 1 1 1 1 EQUALS 1230
-- No children, aged 30, $10,000: 4% x 8,750 = 350.
#ASSERT `How much child tax credit and working family credit do I get` "single" TRUE 10000 10000 0 0 1 1 1 EQUALS 350
-- Not eligible under 290.0671, subd. 1(a): nothing.
#ASSERT `How much child tax credit and working family credit do I get` "single" FALSE 10000 10000 1 0 1 1 1 EQUALS 0
-- Factor since 2025 of 1.02: 1,750 x 1.02 = 1,785, nearest $60 is 1,800; two children: 3,600 + 350 = 3,950.
#ASSERT `How much child tax credit and working family credit do I get` "head of household" TRUE 25000 25000 2 0 1 1 1.02 EQUALS 3950

§§ `Whole returns`

-- Head of household, AGI and earned income $25,000, two children (dependents): 25,000 - 20,800 - 2 x 4,250 < 0, so net
-- income 0 and no tax; credits 3,850, all refunded: -3,850.
`the single parent` MEANS `How much Minnesota income tax do I owe` TRUE FALSE FALSE "head of household" 25000 0 0 0 0 FALSE 0 FALSE FALSE FALSE FALSE 2 TRUE 25000 2 0 1 1 1
#ASSERT `the single parent` EQUALS `answered` (`My Minnesota tax` WITH `net income` IS 0, `tax before credits` IS 0, `child tax credit and working family credit` IS 3850, `tax after credits, or refund if negative` IS -3850)
-- Single, AGI and earned income $60,000, no dependents: net 60,000 - 13,825 = 46,175; tax 1,418.82 + 6.8% x 19,655 (1,336.54)
-- = 2,755.36; the working family credit (350) is phased out (12% x 30,500 exceeds it): 2,755.36 owed.
`the single worker` MEANS `How much Minnesota income tax do I owe` TRUE FALSE FALSE "single" 60000 0 0 0 0 FALSE 0 FALSE FALSE FALSE FALSE 0 TRUE 60000 0 0 1 1 1
#ASSERT `the single worker` EQUALS `answered` (`My Minnesota tax` WITH `net income` IS 46175, `tax before credits` IS 2755.36, `child tax credit and working family credit` IS 0, `tax after credits, or refund if negative` IS 2755.36)
-- Joint, AGI $300,000, two dependents, itemizing $40,000: dependent exemption 8,500 less 8% (8,050 over $291,950 is four
-- steps of $2,500) = 7,820; net 300,000 - 40,000 - 7,820 = 252,180; tax 2,074.195 + 7,837 + 7,705.56 (7.85% x 98,160)
-- = 17,616.755; no credits (not eligible).
`the high earners` MEANS `How much Minnesota income tax do I owe` TRUE FALSE FALSE "married filing jointly" 300000 0 0 0 0 TRUE 40000 FALSE FALSE FALSE FALSE 2 FALSE 300000 2 0 1 1 1
#ASSERT `the high earners` EQUALS `answered` (`My Minnesota tax` WITH `net income` IS 252180, `tax before credits` IS 17616.755, `child tax credit and working family credit` IS 0, `tax after credits, or refund if negative` IS 17616.755)
-- Outside the encoding.
#ASSERT `How much Minnesota income tax do I owe` FALSE FALSE FALSE "single" 60000 0 0 0 0 FALSE 0 FALSE FALSE FALSE FALSE 0 TRUE 60000 0 0 1 1 1 EQUALS `not covered` `a nonresident or part-year resident is not encoded (290.06, subd. 2c(e))`
#ASSERT `How much Minnesota income tax do I owe` TRUE TRUE FALSE "single" 6000 0 0 0 0 FALSE 0 FALSE FALSE FALSE FALSE 0 TRUE 6000 0 0 1 1 1 EQUALS `not covered` `an individual who is a dependent of another taxpayer is not encoded (290.0123, subd. 3)`

§§ `The refund (290.0661, subd. 6; 290.0671, subd. 4)`

-- The single parent: credits 3,850 against no tax; the commissioner refunds 3,850.
#ASSERT EVALTRACE (`290.0661, subd. 6 and 290.0671, subd. 4 -- the commissioner must refund the excess of the credits` 3850 0) 0 (LIST (EVENT `the commissioner of revenue` (`refund the excess to the claimant` 3850) 30)) EQUALS FULFILLED
-- expect: not FULFILLED -- a refund of 3,000 does not match the 3,850 owed, so the obligation stays open.
#TRACE (`290.0661, subd. 6 and 290.0671, subd. 4 -- the commissioner must refund the excess of the credits` 3850 0) AT 0 WITH
    PARTY `the commissioner of revenue` DOES `refund the excess to the claimant` 3000 AT 30
