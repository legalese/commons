IMPORT prelude
IMPORT mfip

-- Cases for mfip.l4. Expected values worked out by hand from the deposited Minn. Stat. 142G.16, 142G.17, 142G.31, subd.
-- 6, 142G.32, 142G.40, 256P.02, 256P.03, 256P.07 and the Transitional Standard at 51 SR 472, not copied from the
-- encoding's output. Family facts and the housing grant figure ($110, unadjusted) are invented inputs.
--
-- Argument order of `Can my family get MFIP`: minor child or pregnancy, general conditions met, property value, months of
-- TANF cash, family size, gross earnings, unearned income, dependent care paid, children under 2 in care, children 2 or
-- older in care, support paid out, unmet need allocation, HUD subsidy, subsidy exception, child-only case, housing grant.

§ `Cases`

§§ `Standards (142G.17; 51 SR 472) and the disregard (256P.03)`

#ASSERT `What is my MFIP Transitional Standard` 3 EQUALS 1470
#ASSERT `What is my MFIP Transitional Standard` 1 EQUALS 697
-- Twelve people: 3,360 + 2 x 256 = 3,872.
#ASSERT `What is my MFIP Transitional Standard` 12 EQUALS 3872
-- Family wage level for three: 110% x 1,470 = 1,617.
#ASSERT `the family wage level` 1470 EQUALS 1617
-- $1,065 earned: 65 + half of 1,000 = 565 disregarded. $50 earned: all of it.
#ASSERT `How much of my earnings is disregarded` 1065 EQUALS 565
#ASSERT `How much of my earnings is disregarded` 50 EQUALS 50

§§ `Payments for a family of three`

-- No income: 1,617 - 0 is at least 1,470, so the payment is 1,470, with the $110 housing grant.
#ASSERT `Can my family get MFIP` TRUE TRUE 2000 12 3 0 0 0 0 0 0 0 0 FALSE FALSE 110 EQUALS `yes, with` (`an assistance payment of` 1470 110)
-- Earnings $1,065: 500 counted; 1,617 - 500 = 1,117, less than 1,470: 1,117.
#ASSERT `Can my family get MFIP` TRUE TRUE 2000 12 3 1065 0 0 0 0 0 0 0 FALSE FALSE 110 EQUALS `yes, with` (`an assistance payment of` 1117 110)
-- The same with $300 of child support received: 1,117 - 300 = 817.
#ASSERT `Can my family get MFIP` TRUE TRUE 2000 12 3 1065 300 0 0 0 0 0 0 FALSE FALSE 110 EQUALS `yes, with` (`an assistance payment of` 817 110)
-- Earnings $2,965: 65 + 1,450 disregarded, 1,450 counted; 1,617 - 1,450 = 167.
#ASSERT `Can my family get MFIP` TRUE TRUE 2000 12 3 2965 0 0 0 0 0 0 0 FALSE FALSE 110 EQUALS `yes, with` (`an assistance payment of` 167 110)
-- A HUD rental subsidy of $300 and no exception: $50 counted as unearned income, 1,470 - 50 = 1,420, and no housing grant.
#ASSERT `Can my family get MFIP` TRUE TRUE 2000 12 3 0 0 0 0 0 0 0 300 FALSE FALSE 110 EQUALS `yes, with` (`an assistance payment of` 1420 0)
-- The same with a member aged 60 or over: the subsidy is not counted and the housing grant is paid.
#ASSERT `Can my family get MFIP` TRUE TRUE 2000 12 3 0 0 0 0 0 0 0 300 TRUE FALSE 110 EQUALS `yes, with` (`an assistance payment of` 1470 110)
-- Unearned income $1,500: passes the initial test (1,500 < 1,617) but 1,470 - 1,500 is under $1: not eligible.
#ASSERT `Can my family get MFIP` TRUE TRUE 2000 12 3 0 1500 0 0 0 0 0 0 FALSE FALSE 110 EQUALS `yes, with` `not eligible: the result of 142G.16, subd. 2 is less than $1`
-- Earnings $3,400: 65 + 1,667.50 disregarded, 1,667.50 counted, not below 1,617: fails the initial test.
#ASSERT `Can my family get MFIP` TRUE TRUE 2000 12 3 3400 0 0 0 0 0 0 0 FALSE FALSE 110 EQUALS `no: countable income after the disregards is not below the family wage level (142G.16, subd. 1)`
-- With $400 of care for a baby: the initial test allows $200, 1,467.50 < 1,617, so it passes; but subd. 2 allows no dependent
-- care, 1,617 - 1,667.50 < 1: no payment (NOTES.md finding 3).
#ASSERT `Can my family get MFIP` TRUE TRUE 2000 12 3 3400 0 400 1 0 0 0 0 FALSE FALSE 110 EQUALS `yes, with` `not eligible: the result of 142G.16, subd. 2 is less than $1`

§§ `Other conditions`

#ASSERT `Can my family get MFIP` FALSE TRUE 2000 12 3 0 0 0 0 0 0 0 0 FALSE FALSE 110 EQUALS `no: the family must include a minor child living with a caregiver, or be a pregnant woman and her spouse (142G.17, subd. 1)`
#ASSERT `Can my family get MFIP` TRUE FALSE 2000 12 3 0 0 0 0 0 0 0 0 FALSE FALSE 110 EQUALS `no: the general eligibility requirements of 142G.11 to 142G.15 must be met (142G.10, subd. 1)`
#ASSERT `Can my family get MFIP` TRUE TRUE 10001 12 3 0 0 0 0 0 0 0 0 FALSE FALSE 110 EQUALS `no: the unit's countable personal property is over $10,000 (256P.02, subd. 2)`
#ASSERT `Can my family get MFIP` TRUE TRUE 10000 12 3 0 0 0 0 0 0 0 0 FALSE FALSE 110 EQUALS `yes, with` (`an assistance payment of` 1470 110)
#ASSERT `Can my family get MFIP` TRUE TRUE 2000 60 3 0 0 0 0 0 0 0 0 FALSE FALSE 110 EQUALS `no: an adult caregiver has received 60 counted months of TANF-funded cash assistance (142G.40, subd. 1)`

§§ `Reporting a change (256P.07, subd. 2)`

#ASSERT `By what day of the next month must I report a change` EQUALS 10
-- Reported on the 10th (day 9): fulfilled.
#ASSERT EVALTRACE `256P.07, subd. 2 -- report a change by the tenth of the following month` 0 (LIST (EVENT `the assistance unit` `report the change to the agency` 9)) EQUALS FULFILLED
-- expect: BREACH by the assistance unit -- nothing reported by the 11th (day 10).
#TRACE `256P.07, subd. 2 -- report a change by the tenth of the following month` AT 0 WITH
    (WAITUNTIL 10)
