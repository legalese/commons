IMPORT prelude
IMPORT daydate
IMPORT mdit

-- Cases for mdit.l4. Every expected value was worked out by hand from the deposited text of Tax-General ss 10-101 to
-- 10-223, 10-704, 10-709, 10-751, 10-805, 10-807 and 10-820 (the arithmetic is shown beside each case), not copied from
-- the encoding's output. Federal figures (federal AGI, the federal EIC, the s 6012(a) amounts, the HHS poverty guideline),
-- the county rates and the Comptroller's 2026 cost-of-living adjustment are invented inputs, not official figures.

§ `Cases`

-- Each case below writes out the whole return; the inputs it does not need are 0 or FALSE, the county rate 3.2% unless stated.

§§ `Residence (s 10-101(k))`

#ASSERT `Am I a Maryland resident` TRUE 0
#ASSERT `Am I a Maryland resident` FALSE 7
#ASSERT (NOT (`Am I a Maryland resident` FALSE 6))

§§ `Exemptions (s 10-211) and the standard deduction (s 10-217)`

-- Single, FAGI $60,000: one exemption at $3,200.
#ASSERT `How much may I deduct for exemptions` "single" 60000 FALSE 0 0 0 0 EQUALS 3200
-- Single, FAGI $130,000: (c)(1)(ii), $800.
#ASSERT `How much may I deduct for exemptions` "single" 130000 FALSE 0 0 0 0 EQUALS 800
-- Single, FAGI $151,000: (c)(1)(iii), $0; the $1,000 for being 65 is not limited.
#ASSERT `How much may I deduct for exemptions` "single" 151000 FALSE 0 0 1 0 EQUALS 1000
-- Married filing separately, spouse with no income, FAGI $50,000: 2 x $3,200.
#ASSERT `How much may I deduct for exemptions` "married filing separately" 50000 TRUE 0 0 0 0 EQUALS 6400
-- Joint, FAGI $160,000, two children, one blind spouse: (c)(2)(i) $1,600 x 4 + $1,000.
#ASSERT `How much may I deduct for exemptions` "married filing jointly" 160000 FALSE 2 0 0 1 EQUALS 7400
-- Head of household, FAGI $40,000, one dependant parent aged 70: (1 + 1) x 3,200 + 3,200 for the dependant over 65.
#ASSERT `How much may I deduct for exemptions` "head of household" 40000 FALSE 1 1 0 0 EQUALS 9600
-- Standard deduction: 2025 single $3,350; 2025 joint $6,700; 2026 single with a 2.5% adjustment: 3,350 x 0.025 = 83.75,
-- rounded down to $50: $3,400; 2026 head of household with 3%: 6,700 x 0.03 = 201, down to 200: $6,900.
#ASSERT `What is my standard deduction` "single" 2025 0 EQUALS 3350
#ASSERT `What is my standard deduction` "married filing jointly" 2025 0 EQUALS 6700
#ASSERT `What is my standard deduction` "single" 2026 0.025 EQUALS 3400
#ASSERT `What is my standard deduction` "head of household" 2026 0.03 EQUALS 6900

§§ `The State rates (s 10-105(a))`

-- Single, $53,450: 20 + 30 + 40 + 4.75% x 50,450 (2,396.375) = 2,486.375.
#ASSERT `What State income tax is charged on my income` "single" 53450 60000 0 EQUALS 2486.375
-- Single, $1,200,000: 20 + 30 + 40 + 4,607.5 + 1,250 + 1,312.5 + 5,500 + 14,375 + 31,250 + 6.5% x 200,000 (13,000) = 71,385.
#ASSERT `What State income tax is charged on my income` "single" 1200000 1200000 0 EQUALS 71385
-- Joint, $375,000 with $50,000 gain and FAGI $400,000: 90 + 6,982.5 + 1,250 + 2,625 + 4,125 + 4,312.5 = 19,385, plus 2% of
-- 50,000 = 1,000: 20,385.
#ASSERT `What State income tax is charged on my income` "married filing jointly" 375000 400000 50000 EQUALS 20385
-- The same gain with FAGI of exactly $350,000: s 10-105(a)(4) needs "in excess of $350,000", so no 2%: 19,385.
#ASSERT `What State income tax is charged on my income` "married filing jointly" 375000 350000 50000 EQUALS 19385

§§ `Whole returns`

-- Case A. Single, 2025, FAGI $60,000, county rate 3.2%. Exemption 3,200, standard deduction 3,350, MTI 53,450.
-- State 2,486.375; county 0.032 x 53,450 = 1,710.40; no credits; net 4,196.775.
`case A` MEANS `the tax on my return` (`My Maryland return` WITH
    `the taxable year`                                 IS 2025
    `filing status`                                    IS `single`
    `federal adjusted gross income`                    IS 60000
    `additions`                                        IS 0
    `Social Security and Railroad Retirement benefits` IS 0
    `other subtractions`                               IS 0
    `spouse has no income and is no one's dependent`   IS FALSE
    `dependants`                                       IS 0
    `dependants at least 65`                           IS 0
    `filers at least 65`                               IS 0
    `filers blind`                                     IS 0
    `itemized federally`                               IS FALSE
    `federal itemized deductions less income taxes`    IS 0
    `cost-of-living adjustment`                        IS 0
    `net capital gain subject to 2%`                   IS 0
    `county rate`                                      IS 0.032
    `refundable county earned income credit`           IS FALSE
    `federal earned income credit`                     IS 0
    `qualifying child for the earned income credit`    IS FALSE
    `earned income`                                    IS 0
    `poverty income level`                             IS 0
    `qualified children`                               IS 0)
#ASSERT `case A`'s `Maryland taxable income` EQUALS 53450
#ASSERT `case A`'s `county income tax` EQUALS 1710.4
#ASSERT `case A`'s `net tax after credits and refunds` EQUALS 4196.775

-- Case B. Joint, 2025, FAGI $120,000, two dependants, itemized federally: $30,000 net of income taxes (no s 10-218(c)
-- reduction below $200,000), larger than $6,700. Exemptions 4 x 3,200 = 12,800. MTI 120,000 - 12,800 - 30,000 = 77,200.
-- State 90 + 4.75% x 74,200 (3,524.5) = 3,614.5; county 2.25% x 77,200 = 1,737; net 5,351.5.
`case B` MEANS `the tax on my return` (`My Maryland return` WITH
    `the taxable year`                                 IS 2025
    `filing status`                                    IS `married filing jointly`
    `federal adjusted gross income`                    IS 120000
    `additions`                                        IS 0
    `Social Security and Railroad Retirement benefits` IS 0
    `other subtractions`                               IS 0
    `spouse has no income and is no one's dependent`   IS FALSE
    `dependants`                                       IS 2
    `dependants at least 65`                           IS 0
    `filers at least 65`                               IS 0
    `filers blind`                                     IS 0
    `itemized federally`                               IS TRUE
    `federal itemized deductions less income taxes`    IS 30000
    `cost-of-living adjustment`                        IS 0
    `net capital gain subject to 2%`                   IS 0
    `county rate`                                      IS 0.0225
    `refundable county earned income credit`           IS FALSE
    `federal earned income credit`                     IS 0
    `qualifying child for the earned income credit`    IS FALSE
    `earned income`                                    IS 0
    `poverty income level`                             IS 0
    `qualified children`                               IS 0)
#ASSERT `case B`'s `deduction` EQUALS 30000
#ASSERT `case B`'s `exemptions` EQUALS 12800
#ASSERT `case B`'s `State income tax` EQUALS 3614.5
#ASSERT `case B`'s `net tax after credits and refunds` EQUALS 5351.5

-- Case C. Head of household, 2025, FAGI and earned income $14,000, one child under 6, federal EIC $3,000 with a qualifying
-- child, county 3%. Exemptions 2 x 3,200 = 6,400; standard 6,700; MTI 900. State 2% x 900 = 18; county 27.
-- s 10-704(c)(1): min(1,500, 18) = 18; (c)(2): 45% x 3,000 = 1,350, less 18 = 1,332 refunded.
-- s 10-704(d)(1): min(3,000 x 10 x 0.03 = 900, 27) = 27.
-- s 10-709: the State EIC (18) is not less than the State tax (18), so (a)(3)(iv) fails: no poverty-level credit.
-- s 10-751: FAGI under $15,000, one qualified child: $500, nothing left to set it against, all refunded.
-- Net: (18 - 18) + (27 - 27) - (1,332 + 500) = -1,832.
`case C` MEANS `the tax on my return` (`My Maryland return` WITH
    `the taxable year`                                 IS 2025
    `filing status`                                    IS `head of household`
    `federal adjusted gross income`                    IS 14000
    `additions`                                        IS 0
    `Social Security and Railroad Retirement benefits` IS 0
    `other subtractions`                               IS 0
    `spouse has no income and is no one's dependent`   IS FALSE
    `dependants`                                       IS 1
    `dependants at least 65`                           IS 0
    `filers at least 65`                               IS 0
    `filers blind`                                     IS 0
    `itemized federally`                               IS FALSE
    `federal itemized deductions less income taxes`    IS 0
    `cost-of-living adjustment`                        IS 0
    `net capital gain subject to 2%`                   IS 0
    `county rate`                                      IS 0.03
    `refundable county earned income credit`           IS FALSE
    `federal earned income credit`                     IS 3000
    `qualifying child for the earned income credit`    IS TRUE
    `earned income`                                    IS 14000
    `poverty income level`                             IS 21150
    `qualified children`                               IS 1)
#ASSERT `case C`'s `State income tax` EQUALS 18
#ASSERT `case C`'s `credits against the State tax` EQUALS 18
#ASSERT `case C`'s `credits against the county tax` EQUALS 27
#ASSERT `case C`'s `refundable amounts` EQUALS 1832
#ASSERT `case C`'s `net tax after credits and refunds` EQUALS -1832

-- Case D. Single, 2025, FAGI and earned income $15,000, no EIC, poverty guideline $15,650, county 3%. MTI 15,000 - 3,200
-- - 3,350 = 8,450. State 90 + 4.75% x 5,450 = 348.875; county 253.5. Eligible low income taxpayer (15,000 <= 15,650; 0 <
-- 348.875). s 10-709(c): min(348.875, 5% x 15,000 = 750) = 348.875; (d): min(253.5, 0.03 x 15,000 = 450) = 253.5. Net 0.
`case D` MEANS `the tax on my return` (`My Maryland return` WITH
    `the taxable year`                                 IS 2025
    `filing status`                                    IS `single`
    `federal adjusted gross income`                    IS 15000
    `additions`                                        IS 0
    `Social Security and Railroad Retirement benefits` IS 0
    `other subtractions`                               IS 0
    `spouse has no income and is no one's dependent`   IS FALSE
    `dependants`                                       IS 0
    `dependants at least 65`                           IS 0
    `filers at least 65`                               IS 0
    `filers blind`                                     IS 0
    `itemized federally`                               IS FALSE
    `federal itemized deductions less income taxes`    IS 0
    `cost-of-living adjustment`                        IS 0
    `net capital gain subject to 2%`                   IS 0
    `county rate`                                      IS 0.03
    `refundable county earned income credit`           IS FALSE
    `federal earned income credit`                     IS 0
    `qualifying child for the earned income credit`    IS FALSE
    `earned income`                                    IS 15000
    `poverty income level`                             IS 15650
    `qualified children`                               IS 0)
#ASSERT `case D`'s `State income tax` EQUALS 348.875
#ASSERT `case D`'s `credits against the State tax` EQUALS 348.875
#ASSERT `case D`'s `credits against the county tax` EQUALS 253.5
#ASSERT `case D`'s `net tax after credits and refunds` EQUALS 0

-- Case E. Joint, 2026, cost-of-living adjustment 3%, FAGI $400,000 with $50,000 net capital gain, itemized $40,000 net of
-- income taxes, less 7.5% x 200,000 = 15,000: 25,000 (larger than the 6,900 standard). Exemptions 0 each above $200,000.
-- MTI 375,000. State 20,385; county 3.2% x 375,000 = 12,000; net 32,385.
`case E` MEANS `the tax on my return` (`My Maryland return` WITH
    `the taxable year`                                 IS 2026
    `filing status`                                    IS `married filing jointly`
    `federal adjusted gross income`                    IS 400000
    `additions`                                        IS 0
    `Social Security and Railroad Retirement benefits` IS 0
    `other subtractions`                               IS 0
    `spouse has no income and is no one's dependent`   IS FALSE
    `dependants`                                       IS 0
    `dependants at least 65`                           IS 0
    `filers at least 65`                               IS 0
    `filers blind`                                     IS 0
    `itemized federally`                               IS TRUE
    `federal itemized deductions less income taxes`    IS 40000
    `cost-of-living adjustment`                        IS 0.03
    `net capital gain subject to 2%`                   IS 50000
    `county rate`                                      IS 0.032
    `refundable county earned income credit`           IS FALSE
    `federal earned income credit`                     IS 0
    `qualifying child for the earned income credit`    IS FALSE
    `earned income`                                    IS 0
    `poverty income level`                             IS 0
    `qualified children`                               IS 0)
#ASSERT `case E`'s `deduction` EQUALS 25000
#ASSERT `case E`'s `exemptions` EQUALS 0
#ASSERT `case E`'s `net tax after credits and refunds` EQUALS 32385

-- Case F. Single retiree aged 66, 2025, FAGI $40,000 including $20,000 of Social Security benefits (s 10-207(j)): MAGI
-- 20,000. Exemptions 3,200 + 1,000; standard 3,350; MTI 12,450. State 90 + 4.75% x 9,450 = 538.875; county 3% x 12,450 =
-- 373.5; net 912.375.
`case F` MEANS `the tax on my return` (`My Maryland return` WITH
    `the taxable year`                                 IS 2025
    `filing status`                                    IS `single`
    `federal adjusted gross income`                    IS 40000
    `additions`                                        IS 0
    `Social Security and Railroad Retirement benefits` IS 20000
    `other subtractions`                               IS 0
    `spouse has no income and is no one's dependent`   IS FALSE
    `dependants`                                       IS 0
    `dependants at least 65`                           IS 0
    `filers at least 65`                               IS 1
    `filers blind`                                     IS 0
    `itemized federally`                               IS FALSE
    `federal itemized deductions less income taxes`    IS 0
    `cost-of-living adjustment`                        IS 0
    `net capital gain subject to 2%`                   IS 0
    `county rate`                                      IS 0.03
    `refundable county earned income credit`           IS FALSE
    `federal earned income credit`                     IS 0
    `qualifying child for the earned income credit`    IS FALSE
    `earned income`                                    IS 0
    `poverty income level`                             IS 0
    `qualified children`                               IS 0)
#ASSERT `case F`'s `Maryland adjusted gross income` EQUALS 20000
#ASSERT `case F`'s `net tax after credits and refunds` EQUALS 912.375

-- Case A through the exported question, with its plain inputs.
`case A asked` MEANS `How much Maryland income tax do I owe` 2025 TRUE FALSE "single" 60000 0 0 0 FALSE 0 0 0 0 FALSE 0 0 0 0.032 FALSE FALSE 0 FALSE 0 0 0
#ASSERT `case A asked` EQUALS `answered` `case A`

-- Outside the encoding: a part-year resident, someone claimed by another taxpayer, a bracket county, 2024.
#ASSERT `How much Maryland income tax do I owe` 2025 FALSE FALSE "single" 60000 0 0 0 FALSE 0 0 0 0 FALSE 0 0 0 0.032 FALSE FALSE 0 FALSE 0 0 0 EQUALS `not covered` `a nonresident or part-year resident is not encoded (ss 10-105(d), 10-219, 10-704(e))`
#ASSERT `How much Maryland income tax do I owe` 2025 TRUE TRUE "single" 6000 0 0 0 FALSE 0 0 0 0 FALSE 0 0 0 0.032 FALSE FALSE 0 FALSE 0 0 0 EQUALS `not covered` `an individual who is claimed as an exemption on another taxpayer's return is not encoded`
#ASSERT `How much Maryland income tax do I owe` 2025 TRUE FALSE "single" 60000 0 0 0 FALSE 0 0 0 0 FALSE 0 0 0 0.032 TRUE FALSE 0 FALSE 0 0 0 EQUALS `not covered` `a county that applies its income tax on a bracket basis (s 10-106(c)) is not encoded`
#ASSERT `How much Maryland income tax do I owe` 2024 TRUE FALSE "single" 60000 0 0 0 FALSE 0 0 0 0 FALSE 0 0 0 0.032 FALSE FALSE 0 FALSE 0 0 0 EQUALS `not covered` `only taxable years beginning in 2025 or 2026 are encoded`

§§ `The child tax credit (s 10-751)`

-- FAGI $14,999, two qualified children: 2 x $500 = $1,000. FAGI $15,000 is not "lower than" $15,000: nothing. A nonresident:
-- nothing. The (c) reduction never bites below the threshold (NOTES.md finding 1).
#ASSERT `How much child tax credit can I claim` TRUE 14999 2 EQUALS 1000
#ASSERT `How much child tax credit can I claim` TRUE 15000 2 EQUALS 0
#ASSERT `How much child tax credit can I claim` FALSE 10000 1 EQUALS 0

§§ `Filing (ss 10-805, 10-807, 10-820)`

-- Not a dependant, required to file federally: must file.
#ASSERT `Must I file a Maryland return` FALSE TRUE 20000 0 15750 0
-- Not a dependant, not required federally, gross income $10,000 against an invented $15,750 threshold: need not file.
#ASSERT (NOT (`Must I file a Maryland return` FALSE FALSE 10000 0 15750 0))
-- The same with $15,000 and $1,000 of additions: 16,000 exceeds 15,750, so s 10-805(a)(2) requires a return.
#ASSERT `Must I file a Maryland return` FALSE FALSE 15000 1000 15750 0
-- A dependant with $2,000 gross income against an invented $1,350 amount: must file; with $1,000 of subtractions, 1,000
-- does not exceed 1,350: need not.
#ASSERT `Must I file a Maryland return` TRUE FALSE 2000 0 1350 0
#ASSERT (NOT (`Must I file a Maryland return` TRUE FALSE 2000 0 1350 1000))

#ASSERT `How must we file` TRUE FALSE FALSE FALSE FALSE EQUALS `we must file a joint Maryland return (s 10-807(a))`
#ASSERT `How must we file` TRUE FALSE TRUE FALSE FALSE EQUALS `we may file a joint Maryland return or separate returns (s 10-807(b))`
#ASSERT `How must we file` FALSE FALSE FALSE FALSE FALSE EQUALS `s 10-807 does not apply: we did not file a joint federal return`

-- 2025 return: due 15 April 2026. A later federal e-file date of 17 April 2026 moves it only for a return filed and paid
-- electronically.
#ASSERT `By what date must I file` 2025 FALSE (Date 1 1 2026) FALSE EQUALS Date 15 4 2026
#ASSERT `By what date must I file` 2025 TRUE (Date 17 4 2026) TRUE EQUALS Date 17 4 2026
#ASSERT `By what date must I file` 2025 TRUE (Date 17 4 2026) FALSE EQUALS Date 15 4 2026

-- The duty as a regulative rule: 1 January 2026 is day 0, 15 April 2026 is day 31 + 28 + 31 + 14 = 104.
#ASSERT `days from 1 January to 15 April` 2025 EQUALS 104
#ASSERT `days from 1 January to 15 April` 2027 EQUALS 105
#ASSERT EVALTRACE (`s 10-805, s 10-820(a)(1) -- a resident required to file must file by 15 April` 2025) 0 (LIST (EVENT `the resident required to file` `complete and file a Maryland income tax return with the Comptroller` 100)) EQUALS FULFILLED
-- expect: BREACH by the resident required to file, "no Maryland return filed by 15 April of the next year".
#TRACE `s 10-805, s 10-820(a)(1) -- a resident required to file must file by 15 April` 2025 AT 0 WITH
    (WAITUNTIL 106)
