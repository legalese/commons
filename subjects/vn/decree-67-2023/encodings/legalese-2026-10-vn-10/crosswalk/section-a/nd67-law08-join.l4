    `operates to carry on insurance brokerage activity` IS FALSE
    `carries on life insurance` IS FALSE
    `carries on non-life insurance` IS FALSE
    `carries on health insurance` IS FALSE
    `is a legal person` IS FALSE
    `is a dependent unit of a foreign insurer or reinsurer` IS FALSE
    `the foreign insurer or reinsurer guarantees and answers for all its obligations in Vietnam` IS FALSE
    `keeps independent accounts` IS FALSE
    `was founded by members or a body representing members` IS FALSE
    `operates without a profit purpose, for mutual support among members` IS FALSE
    `is voluntary, financially autonomous and answerable only within the assets formed from microinsurance` IS FALSE
    `the foreign body is a non-life insurer` IS FALSE
    `the foreign body is a reinsurer` IS FALSE

