§§ `Each ground input reaches its ground`

-- With the document and request inputs all false, the list of grounds shows only what the ground inputs ticked raise. One ground input at a time for the grounds that one fact settles; the facts that must come together are ticked together.
#ASSERT (count (`seat grounds in force` (LIST "harm to international relations")) EQUALS 1) AND (elem `section 3 no. 1` (`seat grounds in force` (LIST "harm to international relations")))
#ASSERT (count (`seat grounds in force` (LIST "harm to Bundeswehr security interests")) EQUALS 1) AND (elem `section 3 no. 1` (`seat grounds in force` (LIST "harm to Bundeswehr security interests")))
#ASSERT (count (`seat grounds in force` (LIST "harm to internal or external security")) EQUALS 1) AND (elem `section 3 no. 1` (`seat grounds in force` (LIST "harm to internal or external security")))
#ASSERT (count (`seat grounds in force` (LIST "harm to supervision by a financial, competition or regulatory authority")) EQUALS 1) AND (elem `section 3 no. 1` (`seat grounds in force` (LIST "harm to supervision by a financial, competition or regulatory authority")))
#ASSERT (count (`seat grounds in force` (LIST "harm to external financial control")) EQUALS 1) AND (elem `section 3 no. 1` (`seat grounds in force` (LIST "harm to external financial control")))
#ASSERT (count (`seat grounds in force` (LIST "harm to measures against unlawful foreign trade")) EQUALS 1) AND (elem `section 3 no. 1` (`seat grounds in force` (LIST "harm to measures against unlawful foreign trade")))
#ASSERT (count (`seat grounds in force` (LIST "harm to a pending court case")) EQUALS 1) AND (elem `section 3 no. 1` (`seat grounds in force` (LIST "harm to a pending court case")))
#ASSERT (count (`seat grounds in force` (LIST "harm to a fair trial")) EQUALS 1) AND (elem `section 3 no. 1` (`seat grounds in force` (LIST "harm to a fair trial")))
#ASSERT (count (`seat grounds in force` (LIST "harm to an investigation")) EQUALS 1) AND (elem `section 3 no. 1` (`seat grounds in force` (LIST "harm to an investigation")))
#ASSERT (count (`seat grounds in force` (LIST "danger to public safety")) EQUALS 1) AND (elem `section 3 no. 2` (`seat grounds in force` (LIST "danger to public safety")))
#ASSERT (count (`seat grounds in force` (LIST "impairs confidential international negotiations")) EQUALS 1) AND (elem `section 3 no. 3` (`seat grounds in force` (LIST "impairs confidential international negotiations")))
#ASSERT (count (`seat grounds in force` (LIST "impairs the deliberations of an authority")) EQUALS 1) AND (elem `section 3 no. 3` (`seat grounds in force` (LIST "impairs the deliberations of an authority")))
#ASSERT (count (`seat grounds in force` (LIST "classified as a Verschlusssache")) EQUALS 1) AND (elem `section 3 no. 4 by classification or by a professional or official secret` (`seat grounds in force` (LIST "classified as a Verschlusssache")))
#ASSERT (count (`seat grounds in force` (LIST "professional secret")) EQUALS 1) AND (elem `section 3 no. 4 by classification or by a professional or official secret` (`seat grounds in force` (LIST "professional secret")))
#ASSERT (count (`seat grounds in force` (LIST "special official secret")) EQUALS 1) AND (elem `section 3 no. 4 by classification or by a professional or official secret` (`seat grounds in force` (LIST "special official secret")))
-- § 3 no. 5 needs all three facts: ticked together it is a ground, with any one left out it is not.
#ASSERT (count (`seat grounds in force` (LIST "comes from another public body", "drawn in only temporarily", "not meant to join its own records")) EQUALS 1) AND (elem `section 3 no. 5` (`seat grounds in force` (LIST "comes from another public body", "drawn in only temporarily", "not meant to join its own records")))
#ASSERT count (`seat grounds in force` (LIST "drawn in only temporarily", "not meant to join its own records")) EQUALS 0
#ASSERT count (`seat grounds in force` (LIST "comes from another public body", "not meant to join its own records")) EQUALS 0
#ASSERT count (`seat grounds in force` (LIST "comes from another public body", "drawn in only temporarily")) EQUALS 0
#ASSERT (count (`seat grounds in force` (LIST "harm to Federal fiscal interests in commerce")) EQUALS 1) AND (elem `section 3 no. 6` (`seat grounds in force` (LIST "harm to Federal fiscal interests in commerce")))
#ASSERT (count (`seat grounds in force` (LIST "harm to economic interests of the social insurance funds")) EQUALS 1) AND (elem `section 3 no. 6` (`seat grounds in force` (LIST "harm to economic interests of the social insurance funds")))
-- § 3 no. 7 needs both.
#ASSERT (count (`seat grounds in force` (LIST "received in confidence", "third party still wants confidence")) EQUALS 1) AND (elem `section 3 no. 7` (`seat grounds in force` (LIST "received in confidence", "third party still wants confidence")))
#ASSERT count (`seat grounds in force` (LIST "received in confidence")) EQUALS 0
#ASSERT count (`seat grounds in force` (LIST "third party still wants confidence")) EQUALS 0
#ASSERT (count (`seat grounds in force` (LIST "asking an intelligence service")) EQUALS 1) AND (elem `section 3 no. 8` (`seat grounds in force` (LIST "asking an intelligence service")))
#ASSERT (count (`seat grounds in force` (LIST "asking about security-clearance tasks")) EQUALS 1) AND (elem `section 3 no. 8` (`seat grounds in force` (LIST "asking about security-clearance tasks")))
-- § 4(1).
#ASSERT (count (`seat grounds in force` (LIST "a draft of a decision", "early disclosure would frustrate the decision")) EQUALS 1) AND (elem `section 4(1)` (`seat grounds in force` (LIST "a draft of a decision", "early disclosure would frustrate the decision")))
#ASSERT (count (`seat grounds in force` (LIST "work immediately preparing a decision", "early disclosure would frustrate the decision")) EQUALS 1) AND (elem `section 4(1)` (`seat grounds in force` (LIST "work immediately preparing a decision", "early disclosure would frustrate the decision")))
#ASSERT (count (`seat grounds in force` (LIST "evidence, expert opinion or third-party statement", "such a paper still prepares a decision", "early disclosure would frustrate the decision")) EQUALS 1) AND (elem `section 4(1)` (`seat grounds in force` (LIST "evidence, expert opinion or third-party statement", "such a paper still prepares a decision", "early disclosure would frustrate the decision")))
#ASSERT count (`seat grounds in force` (LIST "evidence, expert opinion or third-party statement", "early disclosure would frustrate the decision")) EQUALS 0
#ASSERT count (`seat grounds in force` (LIST "a draft of a decision", "early disclosure would frustrate the decision", "atypical case, access should still be granted")) EQUALS 0
-- § 5(1).
#ASSERT (count (`seat grounds in force` (LIST "personal data of a third party")) EQUALS 1) AND (elem `section 5(1)` (`seat grounds in force` (LIST "personal data of a third party")))
#ASSERT count (`seat grounds in force` (LIST "personal data of a third party", "my interest outweighs the third party interest")) EQUALS 0
#ASSERT count (`seat grounds in force` (LIST "personal data of a third party", "the third party consented")) EQUALS 0
#ASSERT (count (`seat grounds in force` (LIST "personal data of a third party", "special category personal data", "the third party consented")) EQUALS 1) AND (elem `section 5(1)` (`seat grounds in force` (LIST "personal data of a third party", "special category personal data", "the third party consented")))
#ASSERT count (`seat grounds in force` (LIST "personal data of a third party", "special category personal data", "the third party consented", "the consent was express")) EQUALS 0
#ASSERT (count (`seat grounds in force` (LIST "personal data of a third party", "data from service, office or mandate files", "my interest outweighs the third party interest")) EQUALS 1) AND (elem `section 5(1)` (`seat grounds in force` (LIST "personal data of a third party", "data from service, office or mandate files", "my interest outweighs the third party interest")))
#ASSERT (count (`seat grounds in force` (LIST "personal data of a third party", "personal data under a professional or official secret", "my interest outweighs the third party interest")) EQUALS 1) AND (elem `section 5(1)` (`seat grounds in force` (LIST "personal data of a third party", "personal data under a professional or official secret", "my interest outweighs the third party interest")))
#ASSERT count (`seat grounds in force` (LIST "personal data of a third party", "only name, title and office contact details", "the third party gave an expert opinion")) EQUALS 0
#ASSERT (count (`seat grounds in force` (LIST "personal data of a third party", "only name, title and office contact details", "the third party gave an expert opinion", "atypical case for section 5(3)")) EQUALS 1) AND (elem `section 5(1)` (`seat grounds in force` (LIST "personal data of a third party", "only name, title and office contact details", "the third party gave an expert opinion", "atypical case for section 5(3)")))
-- § 6.
#ASSERT (count (`seat grounds in force` (LIST "copyright or other intellectual property", "that protection stands in the way")) EQUALS 1) AND (elem `section 6` (`seat grounds in force` (LIST "copyright or other intellectual property", "that protection stands in the way")))
#ASSERT count (`seat grounds in force` (LIST "copyright or other intellectual property")) EQUALS 0
#ASSERT (count (`seat grounds in force` (LIST "a trade or business secret")) EQUALS 1) AND (elem `section 6` (`seat grounds in force` (LIST "a trade or business secret")))
#ASSERT count (`seat grounds in force` (LIST "a trade or business secret", "the holder of the secret consented")) EQUALS 0

§§ `The document and request inputs, with § 9(5) as in force and if the amendment is void`

-- In force: a paper submitted to the Council that is not one of the documents § 9(5) sentence 1 makes public is confidential, a statutory duty within § 3 no. 4.
#ASSERT (count (`seat grounds in force` (LIST "submitted to the Council")) EQUALS 1) AND (elem `section 3 no. 4 by a statute` (`seat grounds in force` (LIST "submitted to the Council")))
#ASSERT count (`seat grounds in force` (LIST "submitted to the Council", "recommendation or report")) EQUALS 0
#ASSERT (count (`seat grounds in force` (LIST "another duty attaches")) EQUALS 1) AND (elem `section 3 no. 4 by a statute` (`seat grounds in force` (LIST "another duty attaches")))
#ASSERT count (`seat grounds in force` (LIST "prepared outside")) EQUALS 0
#ASSERT count (`seat grounds in force` (LIST "federal request")) EQUALS 0
-- If the 2026 amendment is void: the earlier wording covers only papers made inside, so an outside paper is not confidential unless the exception to the citation requirement is accepted.
#ASSERT (count (`seat grounds if void` (LIST "submitted to the Council")) EQUALS 1) AND (elem `section 3 no. 4 by a statute` (`seat grounds if void` (LIST "submitted to the Council")))
#ASSERT count (`seat grounds if void` (LIST "submitted to the Council", "prepared outside")) EQUALS 0
#ASSERT (count (`seat grounds if void` (LIST "submitted to the Council", "prepared outside", "an exception applies")) EQUALS 1) AND (elem `section 3 no. 4 by a statute` (`seat grounds if void` (LIST "submitted to the Council", "prepared outside", "an exception applies")))
#ASSERT (count (`seat grounds if void` (LIST "another duty attaches")) EQUALS 1) AND (elem `section 3 no. 4 by a statute` (`seat grounds if void` (LIST "another duty attaches")))
#ASSERT count (`seat grounds if void` (LIST "submitted to the Council", "recommendation or report")) EQUALS 0

§§ `Cases: the entitlement question`

-- Case A: the journalist and the association's statement (the article's Case 1; footnote 8: nothing else applies). With § 9(5) as in force access is barred; if the amendment is void and no exception is accepted she is entitled.
#ASSERT `seat entitlement in force` (LIST "federal request", "prepared outside", "submitted to the Council") EQUALS FALSE
#ASSERT `seat entitlement if void` (LIST "federal request", "prepared outside", "submitted to the Council") EQUALS TRUE
#ASSERT `seat entitlement if void` (LIST "federal request", "prepared outside", "submitted to the Council", "an exception applies") EQUALS FALSE
-- The same answers as the first seat, bkv-seat.l4, which takes the grounds as one input, `another ground applies`, false: the two seats agree where they should.
#ASSERT `seat entitlement in force` (LIST "federal request", "prepared outside", "submitted to the Council") EQUALS `am I entitled to access with section 9(5) BKV as in force` TRUE TRUE TRUE FALSE FALSE FALSE
#ASSERT `seat entitlement if void` (LIST "federal request", "prepared outside", "submitted to the Council") EQUALS `am I entitled to access if the 2026 amendment is void` TRUE TRUE TRUE FALSE FALSE FALSE FALSE
-- The first seat with its one ground input true gives the same answer as a spelled-out ground.
#ASSERT `seat entitlement if void` (LIST "federal request", "prepared outside", "submitted to the Council", "personal data of a third party") EQUALS `am I entitled to access if the 2026 amendment is void` TRUE TRUE TRUE FALSE TRUE FALSE FALSE
-- Case B: the Council's own closing report is published (§ 9(5) sentence 1): entitled on both readings.
#ASSERT `seat entitlement in force` (LIST "federal request", "submitted to the Council", "recommendation or report") EQUALS TRUE
#ASSERT `seat entitlement if void` (LIST "federal request", "submitted to the Council", "recommendation or report") EQUALS TRUE
-- Case C: a paper made inside the Council stays confidential on both readings.
#ASSERT `seat entitlement in force` (LIST "federal request", "submitted to the Council") EQUALS FALSE
#ASSERT `seat entitlement if void` (LIST "federal request", "submitted to the Council") EQUALS FALSE
-- The claim lies only against a federal authority (§ 1(1) sentence 1).
#ASSERT `seat entitlement if void` (LIST "prepared outside", "submitted to the Council") EQUALS FALSE
-- With § 9(5) as in force the external statement is already confidential, so access is barred whatever else is true: no in every row below.
#ASSERT `seat entitlement in force` (LIST "federal request", "prepared outside", "submitted to the Council", "received in confidence", "third party still wants confidence") EQUALS FALSE
#ASSERT `seat entitlement in force` (LIST "federal request", "prepared outside", "submitted to the Council", "received in confidence") EQUALS FALSE
#ASSERT `seat entitlement in force` (LIST "federal request", "prepared outside", "submitted to the Council", "harm to international relations") EQUALS FALSE
#ASSERT `seat entitlement in force` (LIST "federal request", "prepared outside", "submitted to the Council", "danger to public safety") EQUALS FALSE
#ASSERT `seat entitlement in force` (LIST "federal request", "prepared outside", "submitted to the Council", "impairs the deliberations of an authority") EQUALS FALSE
#ASSERT `seat entitlement in force` (LIST "federal request", "prepared outside", "submitted to the Council", "classified as a Verschlusssache") EQUALS FALSE
#ASSERT `seat entitlement in force` (LIST "federal request", "prepared outside", "submitted to the Council", "professional secret") EQUALS FALSE
#ASSERT `seat entitlement in force` (LIST "federal request", "prepared outside", "submitted to the Council", "evidence, expert opinion or third-party statement", "early disclosure would frustrate the decision") EQUALS FALSE
#ASSERT `seat entitlement in force` (LIST "federal request", "prepared outside", "submitted to the Council", "a draft of a decision", "early disclosure would frustrate the decision") EQUALS FALSE
#ASSERT `seat entitlement in force` (LIST "federal request", "prepared outside", "submitted to the Council", "personal data of a third party") EQUALS FALSE
#ASSERT `seat entitlement in force` (LIST "federal request", "prepared outside", "submitted to the Council", "personal data of a third party", "the third party consented") EQUALS FALSE
#ASSERT `seat entitlement in force` (LIST "federal request", "prepared outside", "submitted to the Council", "copyright or other intellectual property", "that protection stands in the way") EQUALS FALSE
#ASSERT `seat entitlement in force` (LIST "federal request", "prepared outside", "submitted to the Council", "a trade or business secret") EQUALS FALSE
#ASSERT `seat entitlement in force` (LIST "federal request", "prepared outside", "submitted to the Council", "a trade or business secret", "the holder of the secret consented") EQUALS FALSE
-- Each ground, with the amendment void and no exception, so that § 9(5) is out of the way and the ground alone decides.
-- § 3 no. 7 (footnote 8's 'submitted as non-confidential' is the first input false).
#ASSERT `seat entitlement if void` (LIST "federal request", "prepared outside", "submitted to the Council", "received in confidence", "third party still wants confidence") EQUALS FALSE
#ASSERT `seat entitlement if void` (LIST "federal request", "prepared outside", "submitted to the Council", "received in confidence") EQUALS TRUE
-- § 3 no. 4, a Verschlusssache and a professional secret.
#ASSERT `seat entitlement if void` (LIST "federal request", "prepared outside", "submitted to the Council", "classified as a Verschlusssache") EQUALS FALSE
#ASSERT `seat entitlement if void` (LIST "federal request", "prepared outside", "submitted to the Council", "professional secret") EQUALS FALSE
-- § 3 no. 1, public safety and § 3 no. 3 b.
#ASSERT `seat entitlement if void` (LIST "federal request", "prepared outside", "submitted to the Council", "harm to international relations") EQUALS FALSE
#ASSERT `seat entitlement if void` (LIST "federal request", "prepared outside", "submitted to the Council", "danger to public safety") EQUALS FALSE
#ASSERT `seat entitlement if void` (LIST "federal request", "prepared outside", "submitted to the Council", "impairs the deliberations of an authority") EQUALS FALSE
-- § 4(1): the association's statement is a third party's statement, which regularly does not prepare a decision (sentence 2), so the ground does not apply and she is still entitled.
#ASSERT `seat entitlement if void` (LIST "federal request", "prepared outside", "submitted to the Council", "evidence, expert opinion or third-party statement", "early disclosure would frustrate the decision") EQUALS TRUE
#ASSERT `seat entitlement if void` (LIST "federal request", "prepared outside", "submitted to the Council", "a draft of a decision", "early disclosure would frustrate the decision") EQUALS FALSE
-- § 5(1): personal data of a third party, no consent, no favourable weighing; and with consent.
#ASSERT `seat entitlement if void` (LIST "federal request", "prepared outside", "submitted to the Council", "personal data of a third party") EQUALS FALSE
#ASSERT `seat entitlement if void` (LIST "federal request", "prepared outside", "submitted to the Council", "personal data of a third party", "the third party consented") EQUALS TRUE
-- § 6: copyright standing in the way; a trade secret without and with consent.
#ASSERT `seat entitlement if void` (LIST "federal request", "prepared outside", "submitted to the Council", "copyright or other intellectual property", "that protection stands in the way") EQUALS FALSE
#ASSERT `seat entitlement if void` (LIST "federal request", "prepared outside", "submitted to the Council", "a trade or business secret") EQUALS FALSE
#ASSERT `seat entitlement if void` (LIST "federal request", "prepared outside", "submitted to the Council", "a trade or business secret", "the holder of the secret consented") EQUALS TRUE

