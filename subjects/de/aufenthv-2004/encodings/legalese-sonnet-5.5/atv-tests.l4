IMPORT prelude
IMPORT `atv-law`
IMPORT `atv-seat`

-- Tests for the AufenthV airport transit visa encoding. Expected values are written from the deposited text (AufenthV § 26, Anlage C), not from this encoding's output.
-- Arguments to `the passenger who`, in order: nationality, only in the transit area, holds a transit visa, exempt under Visa Code Art. 3(5),
-- Annex IV state, visa and ticket for AU/IL/NZ, returning to Jordan, onward flight within twelve hours, official passport.

§ `Annex C as printed: who needs the visa`

-- Mali is listed in Anlage C and nothing exempts the traveller (§ 26(2) sentence 1, second limb).
#ASSERT `the traveller must hold an airport transit visa under the reading` `as printed` (`the passenger who` "Mali" TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
-- Holding the visa does not remove the requirement; it satisfies it.
#ASSERT `the traveller must hold an airport transit visa under the reading` `as printed` (`the passenger who` "Mali" TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE)
-- An exemption under Art. 3(5) of the Visa Code removes the requirement for an Annex C national too (§ 26(2) sentence 1: "sofern diese nicht nach Artikel 3 Absatz 5 ... befreit sind").
#ASSERT NOT (`the traveller must hold an airport transit visa under the reading` `as printed` (`the passenger who` "Mali" TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE))
-- Every state in Anlage C: a traveller with no exemption needs the visa.
#ASSERT `the traveller must hold an airport transit visa under the reading` `as printed` (`the passenger who` "Cuba" TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
#ASSERT `the traveller must hold an airport transit visa under the reading` `as printed` (`the passenger who` "Lebanon" TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
#ASSERT `the traveller must hold an airport transit visa under the reading` `as printed` (`the passenger who` "Sudan" TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
#ASSERT `the traveller must hold an airport transit visa under the reading` `as printed` (`the passenger who` "South Sudan" TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
#ASSERT `the traveller must hold an airport transit visa under the reading` `as printed` (`the passenger who` "Syria" TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
#ASSERT `the traveller must hold an airport transit visa under the reading` `as printed` (`the passenger who` "Jordan" TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
#ASSERT `the traveller must hold an airport transit visa under the reading` `as printed` (`the passenger who` "Türkiye" TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
-- A state not in Anlage C and not in Annex IV: no visa. India is not in the annex as printed on 2026-11-02, nor is France.
#ASSERT NOT (`the traveller must hold an airport transit visa under the reading` `as printed` (`the passenger who` "India" TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE))
#ASSERT NOT (`the traveller must hold an airport transit visa under the reading` `as printed` (`the passenger who` "France" TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE))
-- A national of an Annex IV state needs the visa by the first limb, whether or not the state is in Anlage C.
#ASSERT `the traveller must hold an airport transit visa under the reading` `as printed` (`the passenger who` "Nigeria" TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`the traveller must hold an airport transit visa under the reading` `as printed` (`the passenger who` "Nigeria" TRUE FALSE TRUE TRUE FALSE FALSE FALSE FALSE))
-- The annex has eight states.
#ASSERT count `the states listed in Annex C as printed` EQUALS 8

§ `Annex C: the exemptions written into the entries for Jordan and Türkiye`

-- Jordan (a): a valid visa for Australia, Israel or New Zealand and a ticket there, and an onward flight within twelve hours.
#ASSERT NOT (`the traveller must hold an airport transit visa under the reading` `as printed` (`the passenger who` "Jordan" TRUE FALSE FALSE FALSE TRUE FALSE TRUE FALSE))
-- Jordan (a) without the twelve-hour onward flight: no exemption.
#ASSERT `the traveller must hold an airport transit visa under the reading` `as printed` (`the passenger who` "Jordan" TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE)
-- Jordan (b): returning to Jordan from a lawful stay there, with a ticket, and an onward flight within twelve hours.
#ASSERT NOT (`the traveller must hold an airport transit visa under the reading` `as printed` (`the passenger who` "Jordan" TRUE FALSE FALSE FALSE FALSE TRUE TRUE FALSE))
-- Jordan: the twelve-hour flight alone is not enough.
#ASSERT `the traveller must hold an airport transit visa under the reading` `as printed` (`the passenger who` "Jordan" TRUE FALSE FALSE FALSE FALSE FALSE TRUE FALSE)
-- The Jordan exemption is for Jordanian nationals: a Syrian national with the same papers needs the visa.
#ASSERT `the traveller must hold an airport transit visa under the reading` `as printed` (`the passenger who` "Syria" TRUE FALSE FALSE FALSE TRUE FALSE TRUE FALSE)
-- Türkiye: a service, ministerial or other official-capacity passport.
#ASSERT NOT (`the traveller must hold an airport transit visa under the reading` `as printed` (`the passenger who` "Türkiye" TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE))
#ASSERT `the traveller must hold an airport transit visa under the reading` `as printed` (`the passenger who` "Türkiye" TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
-- The Türkiye exemption does not reach a Jordanian national.
#ASSERT `the traveller must hold an airport transit visa under the reading` `as printed` (`the passenger who` "Jordan" TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE)

§ `§ 26(1) and (2) sentence 2: the residence-title exemption in transit`

-- A Malian national who stays in the transit area but holds no visa is not exempt: sentence 2 keeps the exemption only for a holder.
#ASSERT NOT (`the traveller is exempt from the residence-title requirement under the reading` `as printed` (`the passenger who` "Mali" TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE))
#ASSERT `the traveller is exempt from the residence-title requirement under the reading` `as printed` (`the passenger who` "Mali" TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE)
-- Where no visa is required the exemption stands without one.
#ASSERT `the traveller is exempt from the residence-title requirement under the reading` `as printed` (`the passenger who` "France" TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
-- Someone who does not stay in the transit area has entered; § 26(1) does not exempt them.
#ASSERT NOT (`the traveller is exempt from the residence-title requirement under the reading` `as printed` (`the passenger who` "France" FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE))
#ASSERT NOT (`the traveller is exempt from the residence-title requirement under the reading` `as printed` (`the passenger who` "Mali" FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE))

§ `Grundgesetz Art. 80(1) sentence 3: the 2015 preamble does not cite § 99(3a)`

-- The one fact this encoding adds to the record: the article's quotation of the 2015 preamble names four powers, none of them § 99(3a).
#ASSERT NOT (`does the 2015 preamble cite the power to add a state to Annex C`)
#ASSERT count `the powers cited in the preamble of the 2015 amending regulation` EQUALS 4
-- Control: the same test says yes for a preamble that does cite it, so the harness can answer yes.
#ASSERT `the preamble cites the power` `AufenthG 99(3a)` (LIST `AufenthG 99(1) nos. 1 to 3 and 13a`, `AufenthG 99(3a)`)
-- Void when the power is missing and no exception is accepted; not void if an exception is accepted.
#ASSERT `the 2015 addition to Annex C is void for want of citation` FALSE
#ASSERT NOT (`the 2015 addition to Annex C is void for want of citation` TRUE)
#ASSERT `the reading of Annex C to apply` FALSE EQUALS `without the entries the 2015 amending regulation added`
#ASSERT `the reading of Annex C to apply` TRUE EQUALS `as printed`

§ `If the 2015 additions are void (no exception accepted)`

-- Mali and South Sudan: no entry in Annex C, so no visa requirement through it.
#ASSERT NOT (`must I hold an airport transit visa if the 2015 additions are void` "Mali" TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`must I hold an airport transit visa if the 2015 additions are void` "South Sudan" TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
-- The other entries stand: they were not added by the 2015 regulation, on the article's account.
#ASSERT `must I hold an airport transit visa if the 2015 additions are void` "Syria" TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE
#ASSERT `must I hold an airport transit visa if the 2015 additions are void` "Sudan" TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE
-- The EU's own list is untouched: a Malian national who is also in an Annex IV state still needs the visa.
#ASSERT `must I hold an airport transit visa if the 2015 additions are void` "Mali" TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE
-- If an exception is accepted, the additions stand and Mali is back.
#ASSERT `must I hold an airport transit visa if the 2015 additions are void` "Mali" TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE
-- A Malian passenger in transit with no visa is exempt from the residence-title requirement if the additions are void.
#ASSERT `am I exempt from the residence title requirement in transit if the 2015 additions are void` "Mali" TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE
#ASSERT NOT (`am I exempt from the residence title requirement in transit if the 2015 additions are void` "Mali" TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE)
