--
-- Tests for bc-interpretation-definitions.l4 (Interpretation Act (British Columbia), RSBC 1996,
-- c. 238, ss 1, 2, 5, 14, 18, 24, 28, 29, 33, 38 and 42). Expected values were decided from the
-- text before the first run.

IMPORT prelude
IMPORT daydate
IMPORT `bc-interpretation-definitions`

§ `s 1 regulation and enactment`

-- A listed kind of instrument, enacted under an Act, that is neither excluded kind of order: a regulation.
#ASSERT `s 1 an instrument is a regulation` TRUE TRUE FALSE FALSE FALSE
#ASSERT `s 1 an instrument is a regulation` TRUE FALSE TRUE FALSE FALSE
#ASSERT `s 1 an instrument is a regulation` TRUE TRUE TRUE FALSE FALSE
-- Enacted neither in execution of a power under an Act nor by or under the authority of the LGiC: not.
#ASSERT NOT (`s 1 an instrument is a regulation` TRUE FALSE FALSE FALSE FALSE)
-- An order of a court made in the course of an action, or an order made by a public officer or
-- administrative tribunal in a dispute between 2 or more persons, is not.
#ASSERT NOT (`s 1 an instrument is a regulation` TRUE TRUE TRUE TRUE FALSE)
#ASSERT NOT (`s 1 an instrument is a regulation` TRUE TRUE TRUE FALSE TRUE)
-- Not of a listed kind at all.
#ASSERT NOT (`s 1 an instrument is a regulation` FALSE TRUE TRUE FALSE FALSE)

#ASSERT `s 1 a thing is an enactment` TRUE FALSE FALSE
#ASSERT `s 1 a thing is an enactment` FALSE TRUE FALSE
#ASSERT `s 1 a thing is an enactment` FALSE FALSE TRUE
#ASSERT NOT (`s 1 a thing is an enactment` FALSE FALSE FALSE)

§ `s 2 Application`

#ASSERT `s 2(1) a provision of this Act applies to an enactment` FALSE FALSE
#ASSERT NOT (`s 2(1) a provision of this Act applies to an enactment` TRUE FALSE)
#ASSERT NOT (`s 2(1) a provision of this Act applies to an enactment` FALSE TRUE)

§ `s 5(1) A thing done before commencement`

-- From the day of commencement on, it has effect.
#ASSERT `s 5(1) a thing done before commencement has effect on a day` (YMD 2026 6 1) (YMD 2026 6 1) FALSE
#ASSERT `s 5(1) a thing done before commencement has effect on a day` (YMD 2026 6 1) (YMD 2026 7 1) FALSE
-- Before it, none, except insofar as necessary to make the enactment effective on its coming into force.
#ASSERT NOT (`s 5(1) a thing done before commencement has effect on a day` (YMD 2026 6 1) (YMD 2026 5 31) FALSE)
#ASSERT `s 5(1) a thing done before commencement has effect on a day` (YMD 2026 6 1) (YMD 2026 5 31) TRUE

§ `s 14 Government bound by enactments`

#ASSERT `s 14 an enactment binds the government` FALSE FALSE
-- It specifically provides otherwise.
#ASSERT NOT (`s 14 an enactment binds the government` TRUE FALSE)
-- Despite subsection (1), an enactment that would bind or affect the government in the use or
-- development of land does not.
#ASSERT NOT (`s 14 an enactment binds the government` FALSE TRUE)
#ASSERT NOT (`s 14 an enactment binds the government` TRUE TRUE)

§ `s 18 Majority and quorum`

-- 5 persons: 3 are a majority, 2 are not. Exactly half of 4 is not a majority.
#ASSERT `s 18(1) a majority of the persons may do the act` 5 3
#ASSERT NOT (`s 18(1) a majority of the persons may do the act` 5 2)
#ASSERT `s 18(1) a majority of the persons may do the act` 4 3
#ASSERT NOT (`s 18(1) a majority of the persons may do the act` 4 2)
#ASSERT `s 18(1) a majority of the persons may do the act` 3 2
-- The section applies to "more than 2 persons": it says nothing about 2 or 1.
#ASSERT REFUSED `s 18(1) a majority of the persons may do the act` 2 2
        BECAUSE "s 18(1) applies only where more than 2 persons are to do the act"
#ASSERT REFUSED `s 18(1) a majority of the persons may do the act` 1 1

-- A fixed number of members: at least 1/2 of it is a quorum (para (a)).
#ASSERT `s 18(2) the number the members present must reach to constitute a quorum` 10 TRUE 8 TRUE EQUALS 5
#ASSERT `s 18(2) the number the members present must reach to constitute a quorum` 7 TRUE 7 TRUE EQUALS 3.5
-- Not a fixed number: at least 1/2 of the members in office, within the authorized limits (para (b)).
#ASSERT `s 18(2) the number the members present must reach to constitute a quorum` 10 FALSE 8 TRUE EQUALS 4
-- ... and outside the limits the text does not say.
#ASSERT REFUSED `s 18(2) the number the members present must reach to constitute a quorum` 10 FALSE 8 FALSE
        BECAUSE "s 18(2)(b) does not say what constitutes a quorum when the number of members is outside the authorized maximum or minimum"
-- A body of fewer than 3 members is outside subsection (2).
#ASSERT REFUSED `s 18(2) the number the members present must reach to constitute a quorum` 2 TRUE 2 TRUE
        BECAUSE "s 18(2) applies only to a body of 3 or more members"

-- Para (c): a majority of those present, if they constitute a quorum.
#ASSERT `s 18(2)(c) the act is deemed to have been done by the association` 6 5 4
#ASSERT NOT (`s 18(2)(c) the act is deemed to have been done by the association` 6 5 3)
#ASSERT NOT (`s 18(2)(c) the act is deemed to have been done by the association` 4 5 3)
-- Para (d): a vacancy does not impair the members in office, if they are not fewer than a quorum.
#ASSERT `s 18(2)(d) a vacancy does not impair the right of the members in office to act` 5 5
#ASSERT `s 18(2)(d) a vacancy does not impair the right of the members in office to act` 6 5
#ASSERT NOT (`s 18(2)(d) a vacancy does not impair the right of the members in office to act` 4 5)

§ `s 24 Documentary evidence`

#ASSERT `s 24 the document is admissible in evidence in any proceeding` TRUE FALSE
#ASSERT NOT (`s 24 the document is admissible in evidence in any proceeding` TRUE TRUE)
#ASSERT NOT (`s 24 the document is admissible in evidence in any proceeding` FALSE FALSE)
#ASSERT `s 24 the fact is deemed to be established` TRUE FALSE FALSE
#ASSERT NOT (`s 24 the fact is deemed to be established` TRUE FALSE TRUE)
#ASSERT NOT (`s 24 the fact is deemed to be established` TRUE TRUE FALSE)

§ `s 28(1) Forms`

#ASSERT `s 28(1) the deviation does not invalidate the form used` TRUE FALSE FALSE
#ASSERT NOT (`s 28(1) the deviation does not invalidate the form used` TRUE TRUE FALSE)
#ASSERT NOT (`s 28(1) the deviation does not invalidate the form used` TRUE FALSE TRUE)
#ASSERT NOT (`s 28(1) the deviation does not invalidate the form used` FALSE FALSE FALSE)

§ `s 29 deliver, mail and minor`

-- A notice mailed (deposited in the Canada Post Office, in Canada, postage prepaid) is delivered
-- on the day it is deposited.
#ASSERT `s 29 the day a notice or other document is delivered` (`Mailed to the person` (YMD 2026 3 10) TRUE TRUE) EQUALS YMD 2026 3 10
#ASSERT `s 29 the day a notice or other document is delivered` (`Left with the person` (YMD 2026 3 11)) EQUALS YMD 2026 3 11
#ASSERT `s 29 the day a notice or other document is delivered` (`Deposited in the person's mailbox or receptacle at the person's residence or place of business` (YMD 2026 3 12)) EQUALS YMD 2026 3 12
-- A deposit outside Canada, or without postage prepaid, is not "mail" in the Act's sense.
#ASSERT REFUSED `s 29 the day a notice or other document is delivered` (`Mailed to the person` (YMD 2026 3 10) FALSE TRUE)
        BECAUSE "s 29 does not make a deposit that is outside Canada or without prepaid postage a mailing"
#ASSERT REFUSED `s 29 the day a notice or other document is delivered` (`Mailed to the person` (YMD 2026 3 10) TRUE FALSE)
-- When a mailed document is received: the Act has no rule on it.
#ASSERT REFUSED `s 29 does not say when a mailed notice or other document is received` (`Mailed to the person` (YMD 2026 3 10) TRUE TRUE)
        BECAUSE "s 29 does not say when a mailed notice or other document is received"

#ASSERT `s 29 a person is a minor` 17 18
#ASSERT NOT (`s 29 a person is a minor` 18 18)

§ `s 33(1) A series of numbers`

#ASSERT `s 33(1) a number is in a series referred to by its first and last numbers` 3 7 3
#ASSERT `s 33(1) a number is in a series referred to by its first and last numbers` 3 7 7
#ASSERT `s 33(1) a number is in a series referred to by its first and last numbers` 3 7 5
#ASSERT NOT (`s 33(1) a number is in a series referred to by its first and last numbers` 3 7 2)
#ASSERT NOT (`s 33(1) a number is in a series referred to by its first and last numbers` 3 7 8)

§ `s 38 Notice by newspaper`

#ASSERT `s 38 publication in the nearest British Columbia newspaper makes the notice sufficiently given` FALSE TRUE
#ASSERT NOT (`s 38 publication in the nearest British Columbia newspaper makes the notice sufficiently given` TRUE TRUE)
#ASSERT NOT (`s 38 publication in the nearest British Columbia newspaper makes the notice sufficiently given` FALSE FALSE)

§ `s 42(2) Enactments before 1 July 1974`

-- Enacted before 1974-07-01: a clause is a paragraph, a paragraph a subparagraph, a subparagraph a clause.
#ASSERT `s 42(2) the subdivision a reference means` (YMD 1974 6 30) Clause EQUALS Paragraph
#ASSERT `s 42(2) the subdivision a reference means` (YMD 1974 6 30) Paragraph EQUALS Subparagraph
#ASSERT `s 42(2) the subdivision a reference means` (YMD 1974 6 30) Subparagraph EQUALS Clause
-- Enacted on or after 1974-07-01: the words mean what s 42(1) says.
#ASSERT `s 42(2) the subdivision a reference means` (YMD 1974 7 1) Clause EQUALS Clause
#ASSERT `s 42(2) the subdivision a reference means` (YMD 1974 7 1) Paragraph EQUALS Paragraph
#ASSERT `s 42(2) the subdivision a reference means` (YMD 2026 1 1) Subparagraph EQUALS Subparagraph
-- A subsection is not renamed.
#ASSERT `s 42(2) the subdivision a reference means` (YMD 1960 1 1) Subsection EQUALS Subsection
