--
-- Tests for bc-interpretation-repeal.l4 (Interpretation Act (British Columbia), RSBC 1996, c. 238,
-- ss 4(4), 32, 35 and 36). Expected values were decided from the text before the first run.

IMPORT prelude
IMPORT daydate
IMPORT `bc-interpretation-repeal`

§ `s 4(4) Expiry is repeal`

#ASSERT `s 4(4) the enactment is deemed to be repealed for the purposes of this Act` TRUE
#ASSERT REFUSED `s 4(4) the enactment is deemed to be repealed for the purposes of this Act` FALSE
        BECAUSE "s 4(4) speaks only of an enactment that has expired or otherwise ceased to have effect"

§ `s 32 References to enactments that are amended or repealed`

-- A reference to an amended domestic enactment is to the amended enactment for a subsequent
-- transaction, matter or thing: the text as it stands on the day of that transaction.
#ASSERT `s 32 the day whose text of the named enactment the reference is to` (`A domestic enactment that has been amended, including by repeal and replacement on the same subject matter, revision or consolidation` (YMD 2026 8 1)) EQUALS YMD 2026 8 1
-- Repealed and not replaced: as it read immediately before its repeal, the last day it had effect.
#ASSERT `s 32 the day whose text of the named enactment the reference is to` (`A domestic enactment that has been repealed and not replaced with a domestic enactment on the same subject matter` (YMD 2026 8 31)) EQUALS YMD 2026 8 31
-- A foreign enactment: as it read on the day the British Columbia enactment containing the
-- reference was enacted.
#ASSERT `s 32 the day whose text of the named enactment the reference is to` (`A foreign enactment` (YMD 2019 5 2)) EQUALS YMD 2019 5 2

§ `s 35(1) What a repeal does not do`

#ASSERT `s 35(1) the repeal leaves the matter unaffected` `Reviving an enactment or thing not in force or existing immediately before the time when the repeal takes effect` FALSE
#ASSERT `s 35(1) the repeal leaves the matter unaffected` `The previous operation of the repealed enactment, or anything done or suffered under it` FALSE
#ASSERT `s 35(1) the repeal leaves the matter unaffected` `A right or obligation acquired, accrued, accruing or incurred under the repealed enactment` FALSE
#ASSERT `s 35(1) the repeal leaves the matter unaffected` `An offence committed against, or a contravention of, the repealed enactment, or a penalty, forfeiture or punishment incurred under it` FALSE
#ASSERT `s 35(1) the repeal leaves the matter unaffected` `An investigation, proceeding or remedy for such a right, obligation, penalty, forfeiture or punishment` FALSE
-- Para (d) is subject to s 36(1)(d): a penalty that a substituted enactment reduces is reduced.
#ASSERT NOT (`s 35(1) the repeal leaves the matter unaffected` `An offence committed against, or a contravention of, the repealed enactment, or a penalty, forfeiture or punishment incurred under it` TRUE)
#ASSERT `s 35(1) the repeal leaves the matter unaffected` `A right or obligation acquired, accrued, accruing or incurred under the repealed enactment` TRUE

#ASSERT `s 35(2) the basis on which an investigation, proceeding or remedy may be instituted, continued or enforced` FALSE EQUALS `As if the enactment had not been repealed`
#ASSERT `s 35(2) the basis on which an investigation, proceeding or remedy may be instituted, continued or enforced` TRUE EQUALS `As if the enactment had not been repealed, subject to section 36 (1) because another enactment is substituted`

§ `s 36 Repeal and replacement`

-- (a) a person acting under the former enactment continues until another is appointed or elected.
#ASSERT `s 36(1)(a) a person acting under the former enactment must continue to act` TRUE FALSE
#ASSERT NOT (`s 36(1)(a) a person acting under the former enactment must continue to act` TRUE TRUE)
#ASSERT REFUSED `s 36(1)(a) a person acting under the former enactment must continue to act` FALSE FALSE
        BECAUSE "s 36(1) applies only where another enactment is substituted for the repealed one"

-- (d) a penalty reduced or mitigated by the new enactment, imposed or adjusted after the repeal,
-- is reduced accordingly; otherwise the former penalty stands.
#ASSERT `s 36(1)(d) the penalty that may be imposed or adjusted` 1000 500 TRUE EQUALS 500
#ASSERT `s 36(1)(d) the penalty that may be imposed or adjusted` 1000 500 FALSE EQUALS 1000
#ASSERT `s 36(1)(d) the penalty that may be imposed or adjusted` 1000 2000 TRUE EQUALS 1000
#ASSERT `s 36(1)(d) the penalty that may be imposed or adjusted` 1000 1000 TRUE EQUALS 1000

-- (e) regulations under the former enactment remain in force insofar as not inconsistent with the
-- new enactment, until repealed or replaced.
#ASSERT `s 36(1)(e) a regulation made under the former enactment remains in force` TRUE FALSE FALSE FALSE
#ASSERT NOT (`s 36(1)(e) a regulation made under the former enactment remains in force` TRUE TRUE FALSE FALSE)
#ASSERT NOT (`s 36(1)(e) a regulation made under the former enactment remains in force` TRUE FALSE TRUE FALSE)
#ASSERT NOT (`s 36(1)(e) a regulation made under the former enactment remains in force` TRUE FALSE FALSE TRUE)
#ASSERT REFUSED `s 36(1)(e) a regulation made under the former enactment remains in force` FALSE FALSE FALSE FALSE
