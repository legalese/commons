IMPORT prelude
IMPORT daydate
IMPORT `nt-pit`
IMPORT `nt-pit-duties`
IMPORT `nt-pit-seat`

-- Northwest Territories Income Tax Act -- worked cases from the seat of the resident individual and the parent.
-- Every assertion is a claim about the ENCODING on stated facts. Expected values were worked by hand from the deposited
-- texts (income-tax.a.2023-11-23.txt, income-tax.r1.2025-06-02.txt, cra-tax-rates-brackets-2026.txt), never copied from
-- the encoding's output. All the people are HYPOTHETICAL. The indexed credit amounts used (basic personal amount
-- $17,842, age amount $8,000 reduced above $40,000, disability amount $12,000) are the encoder's HYPOTHETICAL inputs: the
-- deposited texts do not state the indexed figures (NOTES.md finding 2).

-- ---------------------------------------------------------------------------------------------------------------------
-- s 2(1): who pays.
#ASSERT `Am I liable to NWT income tax` TRUE FALSE
#ASSERT `Am I liable to NWT income tax` FALSE TRUE
#ASSERT (`Am I liable to NWT income tax` FALSE FALSE) EQUALS FALSE

-- ---------------------------------------------------------------------------------------------------------------------
-- s 2.11(4), (5) with the 2026 thresholds $53,003, $106,009, $172,346.
-- $40,000: within tier one: 5.9% x 40,000 = 2,360.
#ASSERT `What is my NWT tax before credits for 2026` TRUE FALSE 40000 EQUALS `answered` 2360
-- $53,003 exactly: still tier one (para (a): "does not exceed"): 5.9% x 53,003 = 3,127.177, not rounded (s 2.11(5) rounds
-- only the fixed parts in (b)(i), (c)(i), (d)(i)).
#ASSERT `What is my NWT tax before credits for 2026` TRUE FALSE 53003 EQUALS `answered` 3127.177
-- $80,000: (b): 5.9% x 53,003 = 3,127.177, rounded 3,127; plus 8.6% x 26,997 = 2,321.742; total 5,448.742.
#ASSERT `What is my NWT tax before credits for 2026` TRUE FALSE 80000 EQUALS `answered` 5448.742
-- $150,000: (c): 3,127.177 + 8.6% x 53,006 (4,558.516) = 7,685.693, rounded 7,686; plus 12.2% x 43,991 = 5,366.902;
-- total 13,052.902.
#ASSERT `What is my NWT tax before credits for 2026` TRUE FALSE 150000 EQUALS `answered` 13052.902
-- $200,000: (d): 3,127.177 + 4,558.516 + 12.2% x 66,337 (8,093.114) = 15,778.807, rounded 15,779; plus 14.05% x 27,654 =
-- 3,885.387; total 19,664.387.
#ASSERT `What is my NWT tax before credits for 2026` TRUE FALSE 200000 EQUALS `answered` 19664.387
-- Not resident on 31 December: not covered.
#ASSERT `What is my NWT tax before credits for 2026` FALSE FALSE 80000 EQUALS `not covered` `only an individual resident in the Northwest Territories on the last day of the year is encoded (s 2(1)(a)); s 2(1)(b) is not`
-- Income earned outside the Territories: s 2.44, not covered.
#ASSERT `What is my NWT tax before credits for 2026` TRUE TRUE 80000 EQUALS `not covered` `income earned outside the Northwest Territories brings in the apportionment of s 2.44, which is not encoded`
-- A negative amount taxable: not covered.
#ASSERT `What is my NWT tax before credits for 2026` TRUE FALSE (0 MINUS 5) EQUALS `not covered` `the amount taxable cannot be negative`
-- Another year with hypothetical thresholds 1,050 / 5,000 / 9,000: $2,050 is in tier two: 5.9% x 1,050 = 61.95, rounded
-- (half and over up) to 62; plus 8.6% x 1,000 = 86; total 148.
#ASSERT `What is my NWT tax before credits for a given year` 2019 TRUE FALSE 2050 1050 5000 9000 EQUALS `answered` 148
-- The 2004 thresholds, $40,000 in 2004: before 2005, not covered.
#ASSERT `What is my NWT tax before credits for a given year` 2004 TRUE FALSE 40000 33245 66492 108101 EQUALS `not covered` `only the 2005 and later taxation years are encoded (s 2.11(2))`

-- s 2.11(6), (7): indexing a threshold. 33,245 with CPI 102.0 over 100.0: factor 0.02; 33,245 x 1.02 = 33,909.9; rounded
-- 33,910. With CPI 101.85 over 100: A/B - 1 = 0.0185, equidistant, so the higher one-thousandth, 0.019; 33,245 x 1.019 =
-- 33,876.655 carried forward, 33,877 used.
#ASSERT `the threshold under s 2.11(6) and (7)` 33245 102 100 EQUALS 33910
#ASSERT `the threshold before rounding under s 2.11(6)` 33245 101.85 100 EQUALS 33876.655
#ASSERT `the threshold under s 2.11(6) and (7)` 33245 101.85 100 EQUALS 33877

-- ---------------------------------------------------------------------------------------------------------------------
-- ss 2.14 to 2.16, with a hypothetical basic personal amount of $17,842.
-- Single: 5.9% x 17,842 = 1,052.678.
#ASSERT `What is my NWT basic credit` `I am single with no eligible dependant` 0 17842 EQUALS 1052.678
-- Supporting a spouse with $5,000 of income: 5.9% x (17,842 + 12,842) = 5.9% x 30,684 = 1,810.356.
#ASSERT `What is my NWT basic credit` `I support my spouse or common-law partner` 5000 17842 EQUALS 1810.356
-- Spouse with $20,000 of income: (B) would be -2,158, read as nil: 5.9% x 17,842 = 1,052.678 (NOTES.md finding 4).
#ASSERT `What is my NWT basic credit` `I support my spouse or common-law partner` 20000 17842 EQUALS 1052.678
-- Eligible dependant with no income: 5.9% x 35,684 = 2,105.356.
#ASSERT `What is my NWT basic credit` `I am single and support an eligible dependant` 0 17842 EQUALS 2105.356

-- s 2.2, with a hypothetical age amount of $8,000 reduced above $40,000.
-- 65, net income $50,000: C = 15% x 10,000 = 1,500; 5.9% x 6,500 = 383.5.
#ASSERT `What is my NWT age credit` TRUE 50000 8000 40000 EQUALS 383.5
-- Net income $30,000: no reduction: 5.9% x 8,000 = 472.
#ASSERT `What is my NWT age credit` TRUE 30000 8000 40000 EQUALS 472
-- Net income $100,000: C = 9,000 exceeds B: nil.
#ASSERT `What is my NWT age credit` TRUE 100000 8000 40000 EQUALS 0
-- Under 65: none.
#ASSERT `What is my NWT age credit` FALSE 30000 8000 40000 EQUALS 0

-- s 2.21: $2,000 of eligible pension income: the lesser is $1,000: 59. $600: 35.4. Not resident on 31 December: none.
#ASSERT `What is my NWT pension credit` TRUE 2000 EQUALS 59
#ASSERT `What is my NWT pension credit` TRUE 600 EQUALS 35.4
#ASSERT `What is my NWT pension credit` FALSE 2000 EQUALS 0

-- s 2.22: $150 of gifts: 5.9% x 150 = 8.85. $1,000: 5.9% x 200 = 11.8 plus 14.05% x 800 = 112.4: 124.2.
#ASSERT `What is my NWT donations credit` 150 EQUALS 8.85
#ASSERT `What is my NWT donations credit` 1000 EQUALS 124.2

-- s 2.24(1), hypothetical disability amount $12,000: 5.9% x 12,000 = 708. Not entitled federally: none.
#ASSERT `What is my NWT disability credit` TRUE 12000 EQUALS 708
#ASSERT `What is my NWT disability credit` FALSE 12000 EQUALS 0

-- s 2.26: 8 full-time months and 2 part-time months: 5.9% x (3,200 + 240) = 202.96.
#ASSERT `What is my NWT education credit` 8 2 EQUALS 202.96

-- ss 2.25, 2.28, 2.29: $5,000 tuition, $300 interest, $4,000 CPP and EI: 5.9% x 9,300 = 548.7.
#ASSERT `What are my NWT tuition, interest and contribution credits` 5000 300 4000 EQUALS 548.7

-- s 2.32: $1,150 of other than eligible dividends (taxable amount) and $1,380 of eligible: 6% x 1,150 = 69 plus 11.5% x
-- 1,380 = 158.7: 227.7. Not resident on 31 December: none.
#ASSERT `What is my NWT dividend credit` TRUE 1150 1380 EQUALS 227.7
#ASSERT `What is my NWT dividend credit` FALSE 1150 1380 EQUALS 0

-- The tax payable: $80,000 of taxable income (tax 5,448.742), the single credit 1,052.678 and 548.7 of other credits:
-- 5,448.742 - 1,601.378 = 3,847.364.
#ASSERT `What is my NWT tax payable` 5448.742 1052.678 0 0 0 0 548.7 0 EQUALS 3847.364
-- Credits larger than the tax: nil, not a refund (NOTES.md finding 4).
#ASSERT `What is my NWT tax payable` 500 1052.678 0 0 0 0 0 0 EQUALS 0

-- ---------------------------------------------------------------------------------------------------------------------
-- Filing and paying.
#ASSERT (`Must I file an NWT return` FALSE FALSE FALSE FALSE) EQUALS FALSE
#ASSERT `Must I file an NWT return` TRUE FALSE FALSE FALSE
#ASSERT `Must I file an NWT return` FALSE TRUE FALSE FALSE
#ASSERT `By when must I file` 2026 FALSE EQUALS Date 30 4 2027
#ASSERT `By when must I file` 2026 TRUE EQUALS Date 15 6 2027
#ASSERT `By when must I pay the balance` 2026 EQUALS Date 30 4 2027
#ASSERT `How much is each instalment` 4000 EQUALS 1000

-- The duty to file the 2026 return (days from 1 January 2026; 30 April 2027 is day 484): filed on day 450: fulfilled.
#ASSERT EVALTRACE (`my duty to file` 2026 FALSE TRUE) 0 (LIST EVENT `the individual` `file the return of income` 450) EQUALS FULFILLED
-- Not required to file: nothing is owed.
#ASSERT EVALTRACE (`my duty to file` 2026 FALSE FALSE) 0 (LIST) EQUALS FULFILLED
-- expect: BREACH BY `the individual`, "return not filed by the date in federal s 150(1)(d), applied by s 11" -- filed on day 500, after 30 April 2027.
#TRACE `my duty to file` 2026 FALSE TRUE AT 0 WITH
    PARTY `the individual` DOES `file the return of income` AT 500

-- Instalments for 2026 (15 March is day 73, 15 June day 165, 15 September day 257, 15 December day 348, 30 April 2027 day
-- 484): all paid in time: fulfilled.
#ASSERT EVALTRACE (`my duty to pay the tax` 2026 TRUE) 0 (LIST EVENT `the individual` `pay the March instalment` 70, EVENT `the individual` `pay the June instalment` 160, EVENT `the individual` `pay the September instalment` 250, EVENT `the individual` `pay the December instalment` 340, EVENT `the individual` `pay the remainder of the tax` 480) EQUALS FULFILLED
-- No federal instalments required (s 17): one payment by the balance-due day.
#ASSERT EVALTRACE (`my duty to pay the tax` 2026 FALSE) 0 (LIST EVENT `the individual` `pay the remainder of the tax` 480) EQUALS FULFILLED
-- expect: BREACH BY `the individual`, "June 15 instalment not paid (s 16(1)(a))" -- the June instalment is paid on day 170.
#TRACE `my duty to pay the tax` 2026 TRUE AT 0 WITH
    PARTY `the individual` DOES `pay the March instalment` AT 70
    PARTY `the individual` DOES `pay the June instalment` AT 170

-- ---------------------------------------------------------------------------------------------------------------------
-- NWT Child Benefit.
-- Eligibility (s 3.1).
#ASSERT `Am I an eligible individual for the NWT Child Benefit` TRUE TRUE `I am the parent who primarily fulfils the responsibility for the child's care and upbringing` FALSE TRUE
#ASSERT `Am I an eligible individual for the NWT Child Benefit` TRUE TRUE `I am a shared custody parent` FALSE TRUE
#ASSERT (`Am I an eligible individual for the NWT Child Benefit` TRUE TRUE `neither` FALSE TRUE) EQUALS FALSE
#ASSERT (`Am I an eligible individual for the NWT Child Benefit` TRUE TRUE `I am the parent who primarily fulfils the responsibility for the child's care and upbringing` TRUE TRUE) EQUALS FALSE
#ASSERT (`Am I an eligible individual for the NWT Child Benefit` TRUE FALSE `I am the parent who primarily fulfils the responsibility for the child's care and upbringing` FALSE TRUE) EQUALS FALSE
#ASSERT `Is the child a qualified dependant` 17 TRUE FALSE FALSE
#ASSERT (`Is the child a qualified dependant` 18 TRUE FALSE FALSE) EQUALS FALSE
#ASSERT (`Is the child a qualified dependant` 10 TRUE FALSE TRUE) EQUALS FALSE

-- The amount (s 3.2(2), Regulations s 1.1).
-- Adjusted income $25,000, one child under six and one six or over: C = 815, D = 652 (each keyed to its own count,
-- NOTES.md finding 5): 1,467 / 12 = 122.25.
#ASSERT `How much NWT Child Benefit do I get this month` TRUE TRUE TRUE TRUE TRUE 25000 1 1 `I am the parent who primarily fulfils the responsibility for the child's care and upbringing` EQUALS 122.25
-- Two children under six, income $30,000 (A equal to B): C = 1,467: 122.25.
#ASSERT `How much NWT Child Benefit do I get this month` TRUE TRUE TRUE TRUE TRUE 30000 2 0 `I am the parent who primarily fulfils the responsibility for the child's care and upbringing` EQUALS 122.25
-- Income $55,000, one under six and one over: 1,467 - 25,000 x 1,467 / 50,000 = 1,467 - 733.5 = 733.5; / 12 = 61.125.
#ASSERT `How much NWT Child Benefit do I get this month` TRUE TRUE TRUE TRUE TRUE 55000 1 1 `I am the parent who primarily fulfils the responsibility for the child's care and upbringing` EQUALS 61.125
-- Income $80,000 (E): nil. Income $90,000: the formula gives a negative amount, read as nil (NOTES.md finding 6).
#ASSERT `How much NWT Child Benefit do I get this month` TRUE TRUE TRUE TRUE TRUE 80000 1 1 `I am the parent who primarily fulfils the responsibility for the child's care and upbringing` EQUALS 0
#ASSERT `How much NWT Child Benefit do I get this month` TRUE TRUE TRUE TRUE TRUE 90000 1 1 `I am the parent who primarily fulfils the responsibility for the child's care and upbringing` EQUALS 0
-- Five children under six, income $20,000: C = 2,445 + 367 = 2,812; monthly 2,812 / 12.
#ASSERT `How much NWT Child Benefit do I get this month` TRUE TRUE TRUE TRUE TRUE 20000 5 0 `I am the parent who primarily fulfils the responsibility for the child's care and upbringing` EQUALS 2812 DIVIDED BY 12
-- Six children six or over, income $20,000: D = 1,956 + 2 x 293 = 2,542; monthly 2,542 / 12.
#ASSERT `How much NWT Child Benefit do I get this month` TRUE TRUE TRUE TRUE TRUE 20000 0 6 `I am the parent who primarily fulfils the responsibility for the child's care and upbringing` EQUALS 2542 DIVIDED BY 12
-- A shared custody parent, income $25,000, one child under six: half of 815 / 12 = 815 / 24 (s 3.2(2.1), finding 7).
#ASSERT `How much NWT Child Benefit do I get this month` TRUE TRUE TRUE TRUE TRUE 25000 1 0 `I am a shared custody parent` EQUALS 815 DIVIDED BY 24
-- No return filed for the base year: nothing.
#ASSERT `How much NWT Child Benefit do I get this month` TRUE FALSE TRUE TRUE TRUE 25000 1 0 `I am the parent who primarily fulfils the responsibility for the child's care and upbringing` EQUALS 0
-- Moved to the Territories during the month (not resident on the day before the month): nothing for that month.
#ASSERT `How much NWT Child Benefit do I get this month` TRUE TRUE TRUE FALSE TRUE 25000 1 0 `I am the parent who primarily fulfils the responsibility for the child's care and upbringing` EQUALS 0

-- The base taxation year: March 2027 uses 2025; July 2027 uses 2026.
#ASSERT `Which year's income counts for my NWT Child Benefit` 3 2027 EQUALS 2025
#ASSERT `Which year's income counts for my NWT Child Benefit` 7 2027 EQUALS 2026
-- s 3.3(1): the notice for January 2026 is due 11 months after the end of January: 31 December 2026. June 2026: 31 May 2027.
#ASSERT `By when must I apply for a month of NWT Child Benefit` 1 2026 EQUALS Date 31 12 2026
#ASSERT `By when must I apply for a month of NWT Child Benefit` 6 2026 EQUALS Date 31 5 2027
-- s 3.3(3): ceased on 10 March 2026: before the end of April: 30 April 2026. 15 November: 31 December. 5 December 2026:
-- 31 January 2027.
#ASSERT `By when must I report that I stopped being eligible` (Date 10 3 2026) EQUALS Date 30 4 2026
#ASSERT `By when must I report that I stopped being eligible` (Date 15 11 2026) EQUALS Date 31 12 2026
#ASSERT `By when must I report that I stopped being eligible` (Date 5 12 2026) EQUALS Date 31 1 2027
-- The duty: ceased on 10 March 2026 (deadline 51 days later), told the CRA on day 30: fulfilled. A child turning 18:
-- no notice is needed.
#ASSERT EVALTRACE (`my duty to notify that I ceased to be eligible` (Date 10 3 2026) FALSE) 0 (LIST EVENT `the individual` `notify the Minister that I have ceased to be an eligible individual` 30) EQUALS FULFILLED
#ASSERT EVALTRACE (`my duty to notify that I ceased to be eligible` (Date 10 3 2026) TRUE) 0 (LIST) EQUALS FULFILLED
-- expect: BREACH BY `the individual`, "the Minister was not told before the end of the month after the person ceased to be an eligible individual (s 3.3(3))" -- told on day 60.
#TRACE `my duty to notify that I ceased to be eligible` (Date 10 3 2026) FALSE AT 0 WITH
    PARTY `the individual` DOES `notify the Minister that I have ceased to be an eligible individual` AT 60

-- ---------------------------------------------------------------------------------------------------------------------
-- Cost of Living Offset (s 3.5, Regulations s 1.2): every prescribed amount is $0, so an entitled individual in Zone 2
-- with a spouse and three children is deemed to have paid 25% x 0 = 0 (NOTES.md finding 8).
#ASSERT `How much Cost of Living Offset do I get` TRUE TRUE TRUE `Zone 2` TRUE 3 EQUALS 0
#ASSERT `How much Cost of Living Offset do I get` TRUE TRUE TRUE `Zone 3` FALSE 0 EQUALS 0
#ASSERT `How much Cost of Living Offset do I get` FALSE TRUE TRUE `Zone 1` FALSE 0 EQUALS 0
