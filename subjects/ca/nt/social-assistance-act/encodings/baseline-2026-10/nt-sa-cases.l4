IMPORT prelude
IMPORT daydate
IMPORT `nt-sa`
IMPORT `nt-sa-duties`
IMPORT `nt-sa-seat`

-- Northwest Territories income assistance -- worked cases from the seat of the applicant and recipient.
-- Every assertion is a claim about the ENCODING on stated facts. Expected values were worked by hand from the deposited
-- texts (social-assistance.a.2018-11-21.txt, social-assistance.r1.2026-07-06.txt, social-assistance.r5.2026-07-06.txt),
-- never copied from the encoding's output. All the people are HYPOTHETICAL.

-- ---------------------------------------------------------------------------------------------------------------------
-- Which program: SPD s 4(a).
#ASSERT `Can I apply under the seniors and disabilities program` 62 FALSE FALSE
#ASSERT `Can I apply under the seniors and disabilities program` 45 TRUE FALSE
#ASSERT `Can I apply under the seniors and disabilities program` 45 FALSE TRUE
#ASSERT (`Can I apply under the seniors and disabilities program` 59 FALSE FALSE) EQUALS FALSE

-- ---------------------------------------------------------------------------------------------------------------------
-- Income Assistance: eligibility (IA ss 3, 3.1).
#ASSERT `Am I eligible for Income Assistance` `a Canadian citizen` FALSE FALSE FALSE FALSE
#ASSERT `Am I eligible for Income Assistance` `a foreign national with a pending section 25(1) request` FALSE FALSE FALSE FALSE
#ASSERT (`Am I eligible for Income Assistance` `none of these` FALSE FALSE FALSE FALSE) EQUALS FALSE
-- An SPD application still undecided: not eligible (s 3.1(1)(a)).
#ASSERT (`Am I eligible for Income Assistance` `a permanent resident` TRUE FALSE FALSE FALSE) EQUALS FALSE
-- A former SPD recipient: not eligible (s 3.1(1)(b)), unless the SPD assistance ended because the person was not a person
-- with a disability (s 3.1(3)).
#ASSERT (`Am I eligible for Income Assistance` `a Canadian citizen` FALSE TRUE FALSE FALSE) EQUALS FALSE
#ASSERT `Am I eligible for Income Assistance` `a Canadian citizen` FALSE TRUE TRUE FALSE
-- During a sanction period: not eligible.
#ASSERT (`Am I eligible for Income Assistance` `a Canadian citizen` FALSE FALSE FALSE TRUE) EQUALS FALSE

-- IA s 22: monthly income.
-- $1,200 earned, no spouse, $400 unearned, $1,000 in the bank against a $1,500 budget (exempt up to $3,000):
-- A + B = 1,600; C = (500 + 25% x 700 = 675) + 350 = 1,025; monthly income 575.
#ASSERT `What is my monthly income for Income Assistance` 1200 0 400 0 1000 0 1500 EQUALS 575
-- The same with $4,000 in the bank: $1,000 over twice the budget counts as unearned income: 1,200 + 1,400 - 1,025 = 1,575.
#ASSERT `What is my monthly income for Income Assistance` 1200 0 400 0 4000 0 1500 EQUALS 1575
-- $300 of the $400 unearned is the Canada-NWT Housing Benefit: only $100 can be allowable (s 22(9)): 1,600 - (675 + 100)
-- = 825.
#ASSERT `What is my monthly income for Income Assistance` 1200 0 400 300 0 0 1500 EQUALS 825
-- A spouse earning $300: wholly allowable ($500 for each adult): 1,500 - (675 + 300) = 525.
#ASSERT `What is my monthly income for Income Assistance` 1200 300 0 0 0 0 1500 EQUALS 525

-- IA Schedule: the base assistance.
-- Yellowknife is Zone F: basic benefit $573 for one adult, $810 for two.
#ASSERT `What is the most Income Assistance base assistance` `Yellowknife` `the basic benefit` 1 EQUALS `answered` 573
#ASSERT `What is the most Income Assistance base assistance` `Yellowknife` `the basic benefit` 2 EQUALS `answered` 810
-- Inuvik is Zone B: room and board for three adults $262.
#ASSERT `What is the most Income Assistance base assistance` `Inuvik` `the room and board benefit` 3 EQUALS `answered` 262
-- Łutselk’e is Zone D: basic benefit for one adult $721.
#ASSERT `What is the most Income Assistance base assistance` `Łutselk’e` `the basic benefit` 1 EQUALS `answered` 721
-- Colville Lake is Zone A: $946 for one adult.
#ASSERT `What is the most Income Assistance base assistance` `Colville Lake` `the basic benefit` 1 EQUALS `answered` 946
-- Four adults: the tables stop at three.
#ASSERT `What is the most Income Assistance base assistance` `Yellowknife` `the basic benefit` 4 EQUALS `not covered` `the benefit tables give amounts for one, two or three adults only`
#ASSERT `What is the most Income Assistance base assistance` `Yellowknife` `the basic benefit` 0 EQUALS `not covered` `a family needs at least one adult or senior to apply`

-- The budget: Yellowknife, one adult, $1,400 rent, $150 utilities: 573 + 1,400 + 150 = 2,123.
#ASSERT `What is my Income Assistance budget` `Yellowknife` `the basic benefit` 1 1400 FALSE 0 0 150 EQUALS `answered` 2123
-- In subsidised housing with rent of $1,000 and a minimum rental rate of $75: 573 + 75 + 150 = 798 (Schedule item 3(3)).
#ASSERT `What is my Income Assistance budget` `Yellowknife` `the basic benefit` 1 1000 TRUE 75 0 150 EQUALS `answered` 798
-- The deficit: 2,123 - 575 = 1,548. A budget of 798 against income of 1,575: nil.
#ASSERT `How much Income Assistance can I get` 2123 575 EQUALS 1548
#ASSERT `How much Income Assistance can I get` 798 1575 EQUALS 0

-- IA s 2: person in need.
#ASSERT `Am I a person in need for Income Assistance` TRUE 1548 FALSE 30 FALSE FALSE FALSE FALSE FALSE
-- Age 18 (a "mature child"): not a person in need (s 2(2)(a)).
#ASSERT (`Am I a person in need for Income Assistance` TRUE 1548 FALSE 18 FALSE FALSE FALSE FALSE FALSE) EQUALS FALSE
-- Not drawing a pension at 60: still in need; at 66: not (s 2(2)(d)).
#ASSERT `Am I a person in need for Income Assistance` TRUE 1548 FALSE 60 FALSE FALSE FALSE TRUE FALSE
#ASSERT (`Am I a person in need for Income Assistance` TRUE 1548 FALSE 66 FALSE FALSE FALSE TRUE FALSE) EQUALS FALSE
-- No deficit, but the Director finds the surplus inadequate: in need; without that finding: not.
#ASSERT `Am I a person in need for Income Assistance` TRUE 0 TRUE 30 FALSE FALSE FALSE FALSE FALSE
#ASSERT (`Am I a person in need for Income Assistance` TRUE 0 FALSE 30 FALSE FALSE FALSE FALSE FALSE) EQUALS FALSE
-- Incarcerated: not.
#ASSERT (`Am I a person in need for Income Assistance` TRUE 1548 FALSE 30 TRUE FALSE FALSE FALSE FALSE) EQUALS FALSE

-- IA ss 4, 5 (and SPD ss 5, 6): the sanction period.
#ASSERT `How many months am I ineligible` FALSE 0 TRUE EQUALS 1
#ASSERT `How many months am I ineligible` TRUE 12 TRUE EQUALS 2
#ASSERT `How many months am I ineligible` TRUE 36 TRUE EQUALS 1
#ASSERT `How many months am I ineligible` TRUE 12 FALSE EQUALS 1

-- ---------------------------------------------------------------------------------------------------------------------
-- Seniors and Persons with Disabilities: eligibility (SPD ss 4, 4.1).
#ASSERT `Am I eligible for the seniors and disabilities program` TRUE `a Canadian citizen` FALSE FALSE FALSE
#ASSERT (`Am I eligible for the seniors and disabilities program` FALSE `a Canadian citizen` FALSE FALSE FALSE) EQUALS FALSE
#ASSERT (`Am I eligible for the seniors and disabilities program` TRUE `a Canadian citizen` FALSE TRUE FALSE) EQUALS FALSE
#ASSERT (`Am I eligible for the seniors and disabilities program` TRUE `none of these` FALSE FALSE FALSE) EQUALS FALSE
#ASSERT (`Am I eligible for the seniors and disabilities program` TRUE `a Canadian citizen` TRUE FALSE FALSE) EQUALS FALSE

-- SPD s 22: net annual income.
-- Line 23600 $20,000, no spouse: 20,000 - 6,000 = 14,000.
#ASSERT `What is my net annual income for the seniors and disabilities program` 20000 FALSE 0 0 0 0 EQUALS 14000
-- $18,000 and a spouse with $4,000: 22,000 - (6,000 + 4,000) = 12,000.
#ASSERT `What is my net annual income for the seniors and disabilities program` 18000 TRUE 4000 0 0 0 EQUALS 12000
-- $9,000 of which $6,000 CPP disability: before D 3,000; D is cut to 3,000 (s 22(5)): nil.
#ASSERT `What is my net annual income for the seniors and disabilities program` 9000 FALSE 0 0 6000 0 EQUALS 0
-- $5,000 with $7,000 of GNWT social assistance: before D -2,000; D cannot apply, and the text leaves the result at
-- -2,000 (NOTES.md finding 5).
#ASSERT `What is my net annual income for the seniors and disabilities program` 5000 FALSE 0 7000 0 0 EQUALS (0 MINUS 2000)
-- A spouse's line 23600 is ignored when the spouse is not part of the application.
#ASSERT `What is my net annual income for the seniors and disabilities program` 20000 FALSE 4000 0 0 0 EQUALS 14000

-- SPD Schedule: by community.
#ASSERT `What is the most seniors and disabilities base assistance` `Yellowknife` `the basic benefit` 1 EQUALS `answered` 866
#ASSERT `What is the most seniors and disabilities base assistance` `Paulatuk` `the basic benefit` 1 EQUALS `answered` 1291
-- Délînê (spelt "Délîne" in the SPD basic benefit table): two adults and seniors $1,881.
#ASSERT `What is the most seniors and disabilities base assistance` `Délînê` `the basic benefit` 2 EQUALS `answered` 1881
#ASSERT `What is the most seniors and disabilities base assistance` `Łutselk’e` `the room and board benefit` 2 EQUALS `answered` 643
-- Kátł’odeeche ("Kátł’odeeche (Hay River Reserve)" in the room and board table): $428.
#ASSERT `What is the most seniors and disabilities base assistance` `Kátł’odeeche First Nation` `the room and board benefit` 1 EQUALS `answered` 428
#ASSERT `What is the most seniors and disabilities base assistance` `Sachs Harbour` `the room and board benefit` 1 EQUALS `answered` 557
#ASSERT `What is the most seniors and disabilities base assistance` `Hay River` `the basic benefit` 4 EQUALS `not covered` `the benefit tables give amounts for one, two or three adults only`

-- The SPD budget: Yellowknife, one senior, $1,200 rent, $100 utilities: 866 + 1,200 + 100 = 2,166.
#ASSERT `What is my seniors and disabilities budget` `Yellowknife` `the basic benefit` 1 1200 FALSE 0 0 100 EQUALS `answered` 2166
-- The monthly deficit with net annual income $14,000: 2,166 - 14,000 / 12 (NOTES.md finding 7).
#ASSERT `How much seniors and disabilities assistance can I get` 2166 14000 EQUALS 2166 MINUS (14000 DIVIDED BY 12)
-- Net annual income -2,000 is read as nil against the budget: 2,166.
#ASSERT `How much seniors and disabilities assistance can I get` 2166 (0 MINUS 2000) EQUALS 2166
-- Net annual income $30,000 (2,500 a month): nil.
#ASSERT `How much seniors and disabilities assistance can I get` 2166 30000 EQUALS 0

-- SPD s 3: person in need.
#ASSERT `Am I a person in need for the seniors and disabilities program` 1000 FALSE 62 FALSE FALSE FALSE FALSE 20000 FALSE
-- $75,000 in banks: not "exceeds": still in need. $80,000: not (s 3(2)(e)).
#ASSERT `Am I a person in need for the seniors and disabilities program` 1000 FALSE 62 FALSE FALSE FALSE FALSE 75000 FALSE
#ASSERT (`Am I a person in need for the seniors and disabilities program` 1000 FALSE 62 FALSE FALSE FALSE FALSE 80000 FALSE) EQUALS FALSE
-- Not drawing a pension at 62: still in need (s 3(3)); at 66: not.
#ASSERT `Am I a person in need for the seniors and disabilities program` 1000 FALSE 62 FALSE FALSE FALSE TRUE 20000 FALSE
#ASSERT (`Am I a person in need for the seniors and disabilities program` 1000 FALSE 66 FALSE FALSE FALSE TRUE 20000 FALSE) EQUALS FALSE
-- On the general program: not (s 3(2)(f)).
#ASSERT (`Am I a person in need for the seniors and disabilities program` 1000 FALSE 62 FALSE FALSE FALSE FALSE 20000 TRUE) EQUALS FALSE

-- ---------------------------------------------------------------------------------------------------------------------
-- Reporting and deadlines.
-- IA s 19(1): a change on 12 March 2026: by 1 April 2026. On 20 December 2026: by 1 January 2027.
#ASSERT `By when must I report a change` `the Income Assistance Regulations` (Date 12 3 2026) EQUALS Date 1 4 2026
#ASSERT `By when must I report a change` `the Income Assistance Regulations` (Date 20 12 2026) EQUALS Date 1 1 2027
-- SPD s 19(1): within 60 days: 12 March 2026 + 60 = 11 May 2026.
#ASSERT `By when must I report a change` `the Seniors and Persons with Disabilities Regulations` (Date 12 3 2026) EQUALS Date 11 5 2026
-- IA s 10(3): two months after 15 January 2026: 15 March 2026. After 31 December 2026: 28 February 2027. After 30
-- November 2026: 30 January 2027.
#ASSERT `By when must I prove my social insurance number application` (Date 15 1 2026) EQUALS Date 15 3 2026
#ASSERT `By when must I prove my social insurance number application` (Date 31 12 2026) EQUALS Date 28 2 2027
#ASSERT `By when must I prove my social insurance number application` (Date 30 11 2026) EQUALS Date 30 1 2027
-- SPD s 11(3): 60 days after 1 March 2026: 30 April 2026; with 90 days allowed: 30 May 2026.
#ASSERT `By when must I provide my seniors and disabilities documents` (Date 1 3 2026) 0 EQUALS Date 30 4 2026
#ASSERT `By when must I provide my seniors and disabilities documents` (Date 1 3 2026) 90 EQUALS Date 30 5 2026

-- The duties (days counted from the change or the application).
-- IA: a change on 12 March 2026 (deadline 20 days later, 1 April), reported on day 15: fulfilled.
#ASSERT EVALTRACE (`my duty to report a change` `the Income Assistance Regulations` (Date 12 3 2026)) 0 (LIST EVENT `the applicant` `inform the Officer of the change in circumstances` 15) EQUALS FULFILLED
-- expect: BREACH BY `the applicant`, "change not reported in time (IA or SPD s 19(1)); ..." -- reported on day 25.
#TRACE `my duty to report a change` `the Income Assistance Regulations` (Date 12 3 2026) AT 0 WITH
    PARTY `the applicant` DOES `inform the Officer of the change in circumstances` AT 25
-- SPD: the same change reported on day 45: within 60 days: fulfilled.
#ASSERT EVALTRACE (`my duty to report a change` `the Seniors and Persons with Disabilities Regulations` (Date 12 3 2026)) 0 (LIST EVENT `the applicant` `inform the Officer of the change in circumstances` 45) EQUALS FULFILLED
-- SIN proof: applied 15 January 2026 (deadline 59 days later), proof on day 50: fulfilled.
#ASSERT EVALTRACE (`my duty to prove a social insurance number application` (Date 15 1 2026)) 0 (LIST EVENT `the applicant` `provide proof of having applied for a social insurance number` 50) EQUALS FULFILLED
-- expect: BREACH BY `the applicant`, "information and documents not provided within 60 days or the time the Officer allowed; ..." -- provided on day 61.
#TRACE `my duty to provide the SPD documents` (Date 1 3 2026) 0 AT 0 WITH
    PARTY `the applicant` DOES `provide the information and documents required by SPD s 11(2)` AT 61
-- What the applicant must be given on a refusal: reasons on day 3 of 5: fulfilled.
#ASSERT EVALTRACE (`what I must be given on a refusal` 5) 0 (LIST EVENT `the Officer` `inform the applicant of the refusal and give written reasons` 3) EQUALS FULFILLED
-- No false statement over a 30-day month: the time runs out (an unrelated event on day 40 moves the clock): fulfilled.
#ASSERT EVALTRACE (`my duty not to make a false statement` 30) 0 (LIST EVENT `the Officer` `inform the applicant of the refusal and give written reasons` 40) EQUALS FULFILLED
-- expect: BREACH BY `the applicant`, "false or misleading statement to obtain assistance: ..." -- a false statement on day 10.
#TRACE `my duty not to make a false statement` 30 AT 0 WITH
    PARTY `the applicant` DOES `make a false or misleading statement to obtain assistance` AT 10

-- ---------------------------------------------------------------------------------------------------------------------
-- Appeals (Act s 8(1)).
#ASSERT `Can I appeal` TRUE `a decision on my eligibility`
#ASSERT `Can I appeal` TRUE `a decision on the amount of my assistance`
#ASSERT (`Can I appeal` TRUE `some other decision`) EQUALS FALSE
#ASSERT (`Can I appeal` FALSE `a decision on my eligibility`) EQUALS FALSE
