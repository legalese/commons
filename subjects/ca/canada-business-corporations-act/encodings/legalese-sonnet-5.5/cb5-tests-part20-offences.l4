IMPORT prelude
IMPORT `cbca-core`
IMPORT `cb5-nouns`
IMPORT `cb5-part20-offences`

-- TESTS of cb5-part20-offences.l4 (ss 250 to 252). Every expected value is written from the text of the
-- section named beside it, before the run; none is copied from the module's output.

§ `Tests of Part XX (offences and punishment)`

§§ `s 250(1) the elements; s 250(4) the register; s 250(3) immunity`

-- The document must be one "required ... to be sent to the Director or to any other person".
#ASSERT `the elements of the offence are met within s 250(1)` TRUE TRUE TRUE TRUE FALSE
#ASSERT `the elements of the offence are met within s 250(1)` TRUE TRUE TRUE FALSE TRUE
#ASSERT `the elements of the offence are met within s 250(1)` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`the elements of the offence are met within s 250(1)` TRUE TRUE TRUE FALSE FALSE)
#ASSERT NOT (`the elements of the offence are met within s 250(1)` FALSE TRUE TRUE TRUE FALSE)
#ASSERT NOT (`the elements of the offence are met within s 250(1)` TRUE FALSE TRUE TRUE FALSE)
#ASSERT NOT (`the elements of the offence are met within s 250(1)` TRUE TRUE FALSE TRUE FALSE)
-- (4): a register of individuals with significant control, or an extract, is not such a document.
#ASSERT `the document is a report, return, notice or other document for the purposes of s 250 within s 250(4)` TRUE FALSE
#ASSERT NOT (`the document is a report, return, notice or other document for the purposes of s 250 within s 250(4)` TRUE TRUE)
#ASSERT NOT (`the document is a report, return, notice or other document for the purposes of s 250 within s 250(4)` FALSE FALSE)
-- (3): both limbs.
#ASSERT `the person has the immunity within s 250(3)` TRUE TRUE
#ASSERT NOT (`the person has the immunity within s 250(3)` TRUE FALSE)
#ASSERT NOT (`the person has the immunity within s 250(3)` FALSE TRUE)
#ASSERT NOT (`the person has the immunity within s 250(3)` FALSE FALSE)
-- Guilty: elements met and no immunity.
#ASSERT `the person is guilty of an offence within s 250(1) and s 250(3)` TRUE FALSE
#ASSERT NOT (`the person is guilty of an offence within s 250(1) and s 250(3)` TRUE TRUE)
#ASSERT NOT (`the person is guilty of an offence within s 250(1) and s 250(3)` FALSE FALSE)
-- Ceilings: five thousand dollars, six months, or both.
#ASSERT (`the most the court may impose within s 250(1)`)'s `largest fine in dollars` EQUALS 5000
#ASSERT (`the most the court may impose within s 250(1)`)'s `longest imprisonment in months` EQUALS 6
#ASSERT (`the most the court may impose within s 250(1)`)'s `fine and imprisonment may both be imposed`
#ASSERT (`the most the court may impose on a director or officer within s 250(2)`)'s `largest fine in dollars` EQUALS 5000
#ASSERT (`the most the court may impose on a director or officer within s 250(2)`)'s `longest imprisonment in months` EQUALS 6

§§ `s 250(2) directors and officers`

#ASSERT `the director or officer is a party to and guilty of the offence within s 250(2)` TRUE TRUE TRUE FALSE
#ASSERT NOT (`the director or officer is a party to and guilty of the offence within s 250(2)` FALSE TRUE TRUE FALSE)
#ASSERT NOT (`the director or officer is a party to and guilty of the offence within s 250(2)` TRUE FALSE TRUE FALSE)
#ASSERT NOT (`the director or officer is a party to and guilty of the offence within s 250(2)` TRUE TRUE FALSE FALSE)
-- Immunity under (3) applies to "any person", so it protects the director or officer too.
#ASSERT NOT (`the director or officer is a party to and guilty of the offence within s 250(2)` TRUE TRUE TRUE TRUE)

§§ `s 251 the general offence`

#ASSERT `the person is guilty of an offence within s 251` TRUE TRUE FALSE
#ASSERT NOT (`the person is guilty of an offence within s 251` FALSE TRUE FALSE)
-- A provision for which a punishment is provided is outside s 251.
#ASSERT NOT (`the person is guilty of an offence within s 251` TRUE FALSE FALSE)
-- With reasonable cause: no offence.
#ASSERT NOT (`the person is guilty of an offence within s 251` TRUE TRUE TRUE)
-- The text states no maximum punishment for s 251: the answer is NOTHING, not a figure.
#ASSERT `the most the court may impose within s 251` EQUALS NOTHING

§§ `s 252 order to comply, limitation period, civil remedy`

#ASSERT `the court may order the person to comply within s 252(1)` TRUE TRUE TRUE
#ASSERT NOT (`the court may order the person to comply within s 252(1)` TRUE FALSE TRUE)
#ASSERT NOT (`the court may order the person to comply within s 252(1)` TRUE TRUE FALSE)
#ASSERT NOT (`the court may order the person to comply within s 252(1)` FALSE TRUE TRUE)
-- Two years: the subject-matter arose on 15 June 2024; the last day is 15 June 2026, inclusive.
#ASSERT `the last day to institute a prosecution within s 252(2)` (YMD 2024 6 15) EQUALS YMD 2026 6 15
#ASSERT `the prosecution is instituted in time within s 252(2)` (YMD 2024 6 15) (YMD 2026 6 15)
#ASSERT `the prosecution is instituted in time within s 252(2)` (YMD 2024 6 15) (YMD 2024 6 15)
#ASSERT NOT (`the prosecution is instituted in time within s 252(2)` (YMD 2024 6 15) (YMD 2026 6 16))
-- A prosecution cannot be instituted before the subject-matter arose.
#ASSERT NOT (`the prosecution is instituted in time within s 252(2)` (YMD 2024 6 15) (YMD 2024 6 14))
-- 29 February: a limitation that starts on a leap day ends on the last day of February two years on.
#ASSERT `the last day to institute a prosecution within s 252(2)` (YMD 2024 2 29) EQUALS YMD 2026 2 28
#ASSERT NOT `a civil remedy is suspended or affected by reason that the act or omission is an offence under this Act within s 252(3)`
