IMPORT prelude
IMPORT `cbca-core`
IMPORT `cbca-core-definitions`
IMPORT `cb4-common`
IMPORT `cb4-amendment`

-- Tests of cb4-amendment.l4 (Part XV, ss 173 to 180). Every expected value is written from the text of
-- the section named beside it, before the run; none is copied from the encoding's output.

§ `Tests -- ss 173 to 180`

§§ `Votes used in the tests`

-- A special resolution needs two-thirds or more of the votes cast (s 2(1), src:72): 200 of 300 passes.
`a tally of 200 for and 100 against` MEANS `Vote tally` WITH
    `votes cast in favour` IS 200
    `votes cast against` IS 100
    `signed by all the shareholders entitled to vote on the resolution` IS FALSE

`a tally of 199 for and 101 against` MEANS `Vote tally` WITH
    `votes cast in favour` IS 199
    `votes cast against` IS 101
    `signed by all the shareholders entitled to vote on the resolution` IS FALSE

`a tally signed by all with no votes cast` MEANS `Vote tally` WITH
    `votes cast in favour` IS 0
    `votes cast against` IS 0
    `signed by all the shareholders entitled to vote on the resolution` IS TRUE

§§ `s 173(1)`

-- (a): a change of name needs only the special resolution.
#ASSERT `the articles may be amended by special resolution within s 173(1)` WITH kind IS `to change the name (s 173(1)(a))`, `the stated capital is set out in the articles` IS FALSE, `the change complies with sections 107 and 112` IS FALSE, `this Act permits the provision to be set out in the articles` IS FALSE, tally IS `a tally of 200 for and 100 against`
-- Just under two-thirds: not passed.
#ASSERT NOT (`the articles may be amended by special resolution within s 173(1)` WITH kind IS `to change the name (s 173(1)(a))`, `the stated capital is set out in the articles` IS FALSE, `the change complies with sections 107 and 112` IS FALSE, `this Act permits the provision to be set out in the articles` IS FALSE, tally IS `a tally of 199 for and 101 against`)
-- Signed by all the shareholders entitled to vote: passed with no votes cast.
#ASSERT `the articles may be amended by special resolution within s 173(1)` WITH kind IS `to change the province of the registered office (s 173(1)(b))`, `the stated capital is set out in the articles` IS FALSE, `the change complies with sections 107 and 112` IS FALSE, `this Act permits the provision to be set out in the articles` IS FALSE, tally IS `a tally signed by all with no votes cast`
-- (f): only if the stated capital is set out in the articles.
#ASSERT `the articles may be amended by special resolution within s 173(1)` WITH kind IS `to reduce or increase stated capital set out in the articles (s 173(1)(f))`, `the stated capital is set out in the articles` IS TRUE, `the change complies with sections 107 and 112` IS FALSE, `this Act permits the provision to be set out in the articles` IS FALSE, tally IS `a tally of 200 for and 100 against`
#ASSERT NOT (`the articles may be amended by special resolution within s 173(1)` WITH kind IS `to reduce or increase stated capital set out in the articles (s 173(1)(f))`, `the stated capital is set out in the articles` IS FALSE, `the change complies with sections 107 and 112` IS TRUE, `this Act permits the provision to be set out in the articles` IS TRUE, tally IS `a tally of 200 for and 100 against`)
-- (m): subject to sections 107 and 112.
#ASSERT `the articles may be amended by special resolution within s 173(1)` WITH kind IS `to change the number of directors or the minimum or maximum number (s 173(1)(m))`, `the stated capital is set out in the articles` IS FALSE, `the change complies with sections 107 and 112` IS TRUE, `this Act permits the provision to be set out in the articles` IS FALSE, tally IS `a tally of 200 for and 100 against`
#ASSERT NOT (`the articles may be amended by special resolution within s 173(1)` WITH kind IS `to change the number of directors or the minimum or maximum number (s 173(1)(m))`, `the stated capital is set out in the articles` IS TRUE, `the change complies with sections 107 and 112` IS FALSE, `this Act permits the provision to be set out in the articles` IS TRUE, tally IS `a tally of 200 for and 100 against`)
-- (o): only a provision this Act permits to be set out in the articles.
#ASSERT `the articles may be amended by special resolution within s 173(1)` WITH kind IS `to add, change or remove any other provision permitted by this Act to be set out in the articles (s 173(1)(o))`, `the stated capital is set out in the articles` IS FALSE, `the change complies with sections 107 and 112` IS FALSE, `this Act permits the provision to be set out in the articles` IS TRUE, tally IS `a tally of 200 for and 100 against`
#ASSERT NOT (`the articles may be amended by special resolution within s 173(1)` WITH kind IS `to add, change or remove any other provision permitted by this Act to be set out in the articles (s 173(1)(o))`, `the stated capital is set out in the articles` IS TRUE, `the change complies with sections 107 and 112` IS TRUE, `this Act permits the provision to be set out in the articles` IS FALSE, tally IS `a tally of 200 for and 100 against`)
-- A change no paragraph lists is not authorized by s 173(1), even with a passing vote and every side condition.
#ASSERT NOT (`the articles may be amended by special resolution within s 173(1)` WITH kind IS `a change that s 173(1) does not list`, `the stated capital is set out in the articles` IS TRUE, `the change complies with sections 107 and 112` IS TRUE, `this Act permits the provision to be set out in the articles` IS TRUE, tally IS `a tally of 200 for and 100 against`)

-- Adopted: the general special resolution AND the separate vote of each class (fork F1, cumulative).
#ASSERT `the amendment is adopted within s 173(1) and s 176(6)` WITH `the articles may be amended by special resolution` IS TRUE, `every class or series entitled to vote separately has approved by special resolution` IS TRUE
#ASSERT NOT (`the amendment is adopted within s 173(1) and s 176(6)` WITH `the articles may be amended by special resolution` IS TRUE, `every class or series entitled to vote separately has approved by special resolution` IS FALSE)
#ASSERT NOT (`the amendment is adopted within s 173(1) and s 176(6)` WITH `the articles may be amended by special resolution` IS FALSE, `every class or series entitled to vote separately has approved by special resolution` IS TRUE)

§§ `s 173(2) and (3)`

#ASSERT `the directors may revoke the resolution without further approval of the shareholders within s 173(2)` TRUE FALSE
-- Not authorized in the resolution: the directors may not revoke it.
#ASSERT NOT (`the directors may revoke the resolution without further approval of the shareholders within s 173(2)` FALSE FALSE)
-- Already acted on: too late to revoke.
#ASSERT NOT (`the directors may revoke the resolution without further approval of the shareholders within s 173(2)` TRUE TRUE)
#ASSERT `the directors may amend the articles to change a number name within s 173(3)` TRUE TRUE
#ASSERT NOT (`the directors may amend the articles to change a number name within s 173(3)` TRUE FALSE)
#ASSERT NOT (`the directors may amend the articles to change a number name within s 173(3)` FALSE TRUE)

§§ `s 174`

-- One builder, every field named at the call. The default values describe a sound proposal under (a).
GIVEN `the corporation is a distributing corporation` IS A BOOLEAN
      `issued shares of the corporation remain outstanding` IS A BOOLEAN
      `those outstanding shares are held by more than one person` IS A BOOLEAN
      `the constraint proposed` IS A `Kind of constraint under s 174(1)`
      `the law concerned is a prescribed law` IS A BOOLEAN
      `the amendment is made in accordance with the regulations` IS A BOOLEAN
      `shares of the class or series affected are outstanding` IS A BOOLEAN
      `those shares are already subject to a constraint permitted under paragraph 174(1)(c)` IS A BOOLEAN
GIVETH A `Proposed constraint on shares (s 174)`
`a proposal for a constraint` MEANS `Proposed constraint on shares (s 174)` WITH
    `the corporation is a distributing corporation` IS `the corporation is a distributing corporation`
    `issued shares of the corporation remain outstanding` IS `issued shares of the corporation remain outstanding`
    `those outstanding shares are held by more than one person` IS `those outstanding shares are held by more than one person`
    `the constraint proposed` IS `the constraint proposed`
    `the law concerned is a prescribed law` IS `the law concerned is a prescribed law`
    `the amendment is made in accordance with the regulations` IS `the amendment is made in accordance with the regulations`
    `shares of the class or series affected are outstanding` IS `shares of the class or series affected are outstanding`
    `those shares are already subject to a constraint permitted under paragraph 174(1)(c)` IS `those shares are already subject to a constraint permitted under paragraph 174(1)(c)`

-- (a) to residents: the sound proposal.
#ASSERT `the corporation may amend its articles to constrain shares by special resolution within s 174(1)` (`a proposal for a constraint` TRUE TRUE TRUE `on the issue or transfer of shares to persons who are not resident Canadians (s 174(1)(a))` FALSE TRUE FALSE FALSE) `a tally of 200 for and 100 against`
-- Not a distributing corporation.
#ASSERT NOT (`the corporation may amend its articles to constrain shares by special resolution within s 174(1)` (`a proposal for a constraint` FALSE TRUE TRUE `on the issue or transfer of shares to persons who are not resident Canadians (s 174(1)(a))` FALSE TRUE FALSE FALSE) `a tally of 200 for and 100 against`)
-- No issued shares remain outstanding.
#ASSERT NOT (`the corporation may amend its articles to constrain shares by special resolution within s 174(1)` (`a proposal for a constraint` TRUE FALSE TRUE `on the issue or transfer of shares to persons who are not resident Canadians (s 174(1)(a))` FALSE TRUE FALSE FALSE) `a tally of 200 for and 100 against`)
-- The outstanding shares are held by one person only.
#ASSERT NOT (`the corporation may amend its articles to constrain shares by special resolution within s 174(1)` (`a proposal for a constraint` TRUE TRUE FALSE `on the issue or transfer of shares to persons who are not resident Canadians (s 174(1)(a))` FALSE TRUE FALSE FALSE) `a tally of 200 for and 100 against`)
-- Not in accordance with the regulations.
#ASSERT NOT (`the corporation may amend its articles to constrain shares by special resolution within s 174(1)` (`a proposal for a constraint` TRUE TRUE TRUE `on the issue or transfer of shares to persons who are not resident Canadians (s 174(1)(a))` FALSE FALSE FALSE FALSE) `a tally of 200 for and 100 against`)
-- The special resolution fails by one vote.
#ASSERT NOT (`the corporation may amend its articles to constrain shares by special resolution within s 174(1)` (`a proposal for a constraint` TRUE TRUE TRUE `on the issue or transfer of shares to persons who are not resident Canadians (s 174(1)(a))` FALSE TRUE FALSE FALSE) `a tally of 199 for and 101 against`)
-- (b)(i), (ii), (iii): each needs a prescribed law.
#ASSERT `the corporation may amend its articles to constrain shares by special resolution within s 174(1)` (`a proposal for a constraint` TRUE TRUE TRUE `on issue or transfer to qualify for a licence to carry on a business under a prescribed law (s 174(1)(b)(i))` TRUE TRUE FALSE FALSE) `a tally of 200 for and 100 against`
#ASSERT NOT (`the corporation may amend its articles to constrain shares by special resolution within s 174(1)` (`a proposal for a constraint` TRUE TRUE TRUE `on issue or transfer to qualify for a licence to carry on a business under a prescribed law (s 174(1)(b)(i))` FALSE TRUE FALSE FALSE) `a tally of 200 for and 100 against`)
#ASSERT `the corporation may amend its articles to constrain shares by special resolution within s 174(1)` (`a proposal for a constraint` TRUE TRUE TRUE `on issue or transfer to become a publisher of a Canadian newspaper or periodical under a prescribed law (s 174(1)(b)(ii))` TRUE TRUE FALSE FALSE) `a tally of 200 for and 100 against`
#ASSERT NOT (`the corporation may amend its articles to constrain shares by special resolution within s 174(1)` (`a proposal for a constraint` TRUE TRUE TRUE `on issue or transfer to become a publisher of a Canadian newspaper or periodical under a prescribed law (s 174(1)(b)(ii))` FALSE TRUE FALSE FALSE) `a tally of 200 for and 100 against`)
#ASSERT `the corporation may amend its articles to constrain shares by special resolution within s 174(1)` (`a proposal for a constraint` TRUE TRUE TRUE `on issue or transfer to acquire shares of a financial intermediary under a prescribed law (s 174(1)(b)(iii))` TRUE TRUE FALSE FALSE) `a tally of 200 for and 100 against`
#ASSERT NOT (`the corporation may amend its articles to constrain shares by special resolution within s 174(1)` (`a proposal for a constraint` TRUE TRUE TRUE `on issue or transfer to acquire shares of a financial intermediary under a prescribed law (s 174(1)(b)(iii))` FALSE TRUE FALSE FALSE) `a tally of 200 for and 100 against`)
-- (c): a prescribed law, and s 174(2): no outstanding shares of the class, or those already constrained.
#ASSERT `the corporation may amend its articles to constrain shares by special resolution within s 174(1)` (`a proposal for a constraint` TRUE TRUE TRUE `on issue, transfer or ownership to qualify for licences, permits, grants or benefits by a level of Canadian ownership or control (s 174(1)(c))` TRUE TRUE FALSE FALSE) `a tally of 200 for and 100 against`
#ASSERT NOT (`the corporation may amend its articles to constrain shares by special resolution within s 174(1)` (`a proposal for a constraint` TRUE TRUE TRUE `on issue, transfer or ownership to qualify for licences, permits, grants or benefits by a level of Canadian ownership or control (s 174(1)(c))` TRUE TRUE TRUE FALSE) `a tally of 200 for and 100 against`)
#ASSERT `the corporation may amend its articles to constrain shares by special resolution within s 174(1)` (`a proposal for a constraint` TRUE TRUE TRUE `on issue, transfer or ownership to qualify for licences, permits, grants or benefits by a level of Canadian ownership or control (s 174(1)(c))` TRUE TRUE TRUE TRUE) `a tally of 200 for and 100 against`
#ASSERT NOT (`the corporation may amend its articles to constrain shares by special resolution within s 174(1)` (`a proposal for a constraint` TRUE TRUE TRUE `on issue, transfer or ownership to qualify for licences, permits, grants or benefits by a level of Canadian ownership or control (s 174(1)(c))` FALSE TRUE FALSE FALSE) `a tally of 200 for and 100 against`)
-- (d): a prescribed law. (e): no prescribed law needed.
#ASSERT `the corporation may amend its articles to constrain shares by special resolution within s 174(1)` (`a proposal for a constraint` TRUE TRUE TRUE `on issue, transfer or ownership to comply with a prescribed law (s 174(1)(d))` TRUE TRUE FALSE FALSE) `a tally of 200 for and 100 against`
#ASSERT NOT (`the corporation may amend its articles to constrain shares by special resolution within s 174(1)` (`a proposal for a constraint` TRUE TRUE TRUE `on issue, transfer or ownership to comply with a prescribed law (s 174(1)(d))` FALSE TRUE FALSE FALSE) `a tally of 200 for and 100 against`)
#ASSERT `the corporation may amend its articles to constrain shares by special resolution within s 174(1)` (`a proposal for a constraint` TRUE TRUE TRUE `on issue, transfer or ownership to be a registered labour-sponsored venture capital corporation (s 174(1)(e))` FALSE TRUE FALSE FALSE) `a tally of 200 for and 100 against`
-- A constraint s 174(1) does not list.
#ASSERT NOT (`the corporation may amend its articles to constrain shares by special resolution within s 174(1)` (`a proposal for a constraint` TRUE TRUE TRUE `a constraint that s 174(1) does not list` TRUE TRUE FALSE FALSE) `a tally of 200 for and 100 against`)

-- (2): the shares of the class are not outstanding, or already constrained, or neither.
#ASSERT `paragraph 174(1)(c) permits a constraint on the class or series within s 174(2)` (`a proposal for a constraint` TRUE TRUE TRUE `on issue, transfer or ownership to qualify for licences, permits, grants or benefits by a level of Canadian ownership or control (s 174(1)(c))` TRUE TRUE FALSE FALSE)
#ASSERT NOT (`paragraph 174(1)(c) permits a constraint on the class or series within s 174(2)` (`a proposal for a constraint` TRUE TRUE TRUE `on issue, transfer or ownership to qualify for licences, permits, grants or benefits by a level of Canadian ownership or control (s 174(1)(c))` TRUE TRUE TRUE FALSE))
#ASSERT `paragraph 174(1)(c) permits a constraint on the class or series within s 174(2)` (`a proposal for a constraint` TRUE TRUE TRUE `on issue, transfer or ownership to qualify for licences, permits, grants or benefits by a level of Canadian ownership or control (s 174(1)(c))` TRUE TRUE TRUE TRUE)

-- (3): all three conditions.
#ASSERT `the corporation may limit or prohibit a person's ownership of shares within s 174(3)` TRUE TRUE TRUE
#ASSERT NOT (`the corporation may limit or prohibit a person's ownership of shares within s 174(3)` FALSE TRUE TRUE)
#ASSERT NOT (`the corporation may limit or prohibit a person's ownership of shares within s 174(3)` TRUE FALSE TRUE)
#ASSERT NOT (`the corporation may limit or prohibit a person's ownership of shares within s 174(3)` TRUE TRUE FALSE)

-- (4): a corporation referred to in subsection (1), and a special resolution.
#ASSERT `the corporation may amend its articles to change or remove a constraint by special resolution within s 174(4)` TRUE TRUE TRUE `a tally of 200 for and 100 against`
#ASSERT NOT (`the corporation may amend its articles to change or remove a constraint by special resolution within s 174(4)` FALSE TRUE TRUE `a tally of 200 for and 100 against`)
#ASSERT NOT (`the corporation may amend its articles to change or remove a constraint by special resolution within s 174(4)` TRUE FALSE TRUE `a tally of 200 for and 100 against`)
#ASSERT NOT (`the corporation may amend its articles to change or remove a constraint by special resolution within s 174(4)` TRUE TRUE FALSE `a tally of 200 for and 100 against`)
#ASSERT NOT (`the corporation may amend its articles to change or remove a constraint by special resolution within s 174(4)` TRUE TRUE TRUE `a tally of 199 for and 101 against`)

-- (5): as 173(2).
#ASSERT `the directors may revoke the resolution without further approval of the shareholders within s 174(5)` TRUE FALSE
#ASSERT NOT (`the directors may revoke the resolution without further approval of the shareholders within s 174(5)` FALSE FALSE)
#ASSERT NOT (`the directors may revoke the resolution without further approval of the shareholders within s 174(5)` TRUE TRUE)

-- (7): validity despite a failure to comply with s 174: JUST TRUE; any other defect is not decided.
#ASSERT `the issue, transfer or act is valid despite a failure to comply with s 174 within s 174(7)` TRUE EQUALS JUST TRUE
#ASSERT `the issue, transfer or act is valid despite a failure to comply with s 174 within s 174(7)` FALSE EQUALS NOTHING

§§ `s 175`

#ASSERT `a person may make a proposal to amend the articles within s 175(1)` TRUE FALSE TRUE
#ASSERT `a person may make a proposal to amend the articles within s 175(1)` FALSE TRUE TRUE
#ASSERT NOT (`a person may make a proposal to amend the articles within s 175(1)` FALSE FALSE TRUE)
#ASSERT NOT (`a person may make a proposal to amend the articles within s 175(1)` TRUE FALSE FALSE)
-- (2): sets out the amendment; states the dissent right where there is one.
#ASSERT `the notice of the meeting complies within s 175(2)` TRUE TRUE TRUE
#ASSERT `the notice of the meeting complies within s 175(2)` TRUE FALSE FALSE
#ASSERT NOT (`the notice of the meeting complies within s 175(2)` TRUE TRUE FALSE)
#ASSERT NOT (`the notice of the meeting complies within s 175(2)` FALSE FALSE FALSE)
#ASSERT `the effect on the amendment of leaving out the dissent statement within s 175(2)` TRUE EQUALS `the omission does not make the action invalid`
#ASSERT `the effect on the amendment of leaving out the dissent statement within s 175(2)` FALSE EQUALS `the Act does not say whether the omission makes the action invalid`

§§ `s 176`

-- (a) and (b): a class vote, unless the articles otherwise provide.
#ASSERT `the holders of the class are entitled to vote separately as a class within s 176(1)` `an increase or decrease of a maximum number of authorized shares of the class, or an increase for an equal or superior class (s 176(1)(a))` FALSE FALSE FALSE
#ASSERT NOT (`the holders of the class are entitled to vote separately as a class within s 176(1)` `an increase or decrease of a maximum number of authorized shares of the class, or an increase for an equal or superior class (s 176(1)(a))` TRUE FALSE FALSE)
#ASSERT `the holders of the class are entitled to vote separately as a class within s 176(1)` `an exchange, reclassification or cancellation of all or part of the shares of the class (s 176(1)(b))` FALSE FALSE FALSE
#ASSERT NOT (`the holders of the class are entitled to vote separately as a class within s 176(1)` `an exchange, reclassification or cancellation of all or part of the shares of the class (s 176(1)(b))` TRUE FALSE FALSE)
-- (c), (d), (f), (g), (h): the articles cannot displace the vote.
#ASSERT `the holders of the class are entitled to vote separately as a class within s 176(1)` `a change to the rights, privileges, restrictions or conditions attached to the shares of the class (s 176(1)(c))` TRUE FALSE FALSE
#ASSERT `the holders of the class are entitled to vote separately as a class within s 176(1)` `an increase of the rights or privileges of a class with equal or superior rights or privileges (s 176(1)(d))` TRUE FALSE FALSE
#ASSERT `the holders of the class are entitled to vote separately as a class within s 176(1)` `making a class with inferior rights or privileges equal or superior to the class (s 176(1)(f))` TRUE FALSE FALSE
#ASSERT `the holders of the class are entitled to vote separately as a class within s 176(1)` `an exchange, or a right of exchange, of shares of another class into shares of the class (s 176(1)(g))` TRUE FALSE FALSE
#ASSERT `the holders of the class are entitled to vote separately as a class within s 176(1)` `a constraint on the issue, transfer or ownership of shares of the class, or a change or removal of it (s 176(1)(h))` TRUE FALSE FALSE
-- (e): displaced by the articles; and the s 176(3) deeming.
#ASSERT `the holders of the class are entitled to vote separately as a class within s 176(1)` `the creation of a new class equal or superior to the class (s 176(1)(e))` FALSE FALSE FALSE
#ASSERT NOT (`the holders of the class are entitled to vote separately as a class within s 176(1)` `the creation of a new class equal or superior to the class (s 176(1)(e))` TRUE FALSE FALSE)
#ASSERT NOT (`the holders of the class are entitled to vote separately as a class within s 176(1)` `the creation of a new class equal or superior to the class (s 176(1)(e))` FALSE TRUE FALSE)
-- No listed effect.
#ASSERT NOT (`the holders of the class are entitled to vote separately as a class within s 176(1)` `no effect that s 176(1) lists` FALSE FALSE FALSE)
-- (2): the exception removes the vote for any effect.
#ASSERT NOT (`the holders of the class are entitled to vote separately as a class within s 176(1)` `a change to the rights, privileges, restrictions or conditions attached to the shares of the class (s 176(1)(c))` FALSE FALSE TRUE)
-- (4): a series votes separately only if affected differently.
#ASSERT `the holders of a series are entitled to vote separately as a series within s 176(4)` TRUE TRUE
#ASSERT NOT (`the holders of a series are entitled to vote separately as a series within s 176(4)` TRUE FALSE)
#ASSERT NOT (`the holders of a series are entitled to vote separately as a series within s 176(4)` FALSE TRUE)
-- (5): whether the shares otherwise carry a vote changes nothing.
#ASSERT `the holders may vote separately even if the shares carry no other vote within s 176(5)` TRUE FALSE
#ASSERT `the holders may vote separately even if the shares carry no other vote within s 176(5)` TRUE TRUE
#ASSERT NOT (`the holders may vote separately even if the shares carry no other vote within s 176(5)` FALSE FALSE)
#ASSERT NOT (`the holders may vote separately even if the shares carry no other vote within s 176(5)` FALSE TRUE)
-- (6): every class or series approves by special resolution; no class entitled: vacuously approved.
#ASSERT `every class or series entitled to vote separately has approved within s 176(6)` (LIST `a tally of 200 for and 100 against`, `a tally signed by all with no votes cast`)
#ASSERT NOT (`every class or series entitled to vote separately has approved within s 176(6)` (LIST `a tally of 200 for and 100 against`, `a tally of 199 for and 101 against`))
#ASSERT `every class or series entitled to vote separately has approved within s 176(6)` (EMPTY)

§§ `ss 177 to 180`

#ASSERT `the corporation must send articles of amendment to the Director within s 177(1)` TRUE FALSE
#ASSERT NOT (`the corporation must send articles of amendment to the Director within s 177(1)` TRUE TRUE)
#ASSERT NOT (`the corporation must send articles of amendment to the Director within s 177(1)` FALSE FALSE)
#ASSERT `subsections 38(3) and (4) apply to the amendment within s 177(2)` TRUE
#ASSERT NOT (`subsections 38(3) and (4) apply to the amendment within s 177(2)` FALSE)
#ASSERT `the Director must issue a certificate of amendment within s 178` TRUE
#ASSERT NOT (`the Director must issue a certificate of amendment within s 178` FALSE)
-- s 179(1): effective ON the date shown, not the day before.
#ASSERT `the amendment is effective and the articles stand amended on a day within s 179(1)` (YMD 2026 3 10) (YMD 2026 3 10)
#ASSERT `the amendment is effective and the articles stand amended on a day within s 179(1)` (YMD 2026 3 10) (YMD 2026 3 11)
#ASSERT NOT (`the amendment is effective and the articles stand amended on a day within s 179(1)` (YMD 2026 3 10) (YMD 2026 3 9))
#ASSERT `whether a matter is unaffected by an amendment within s 179(2)` TRUE EQUALS JUST TRUE
#ASSERT `whether a matter is unaffected by an amendment within s 179(2)` FALSE EQUALS NOTHING
-- s 180
#ASSERT `the directors' position on restating the articles within s 180(1)` TRUE EQUALS `the directors must restate the articles`
#ASSERT `the directors' position on restating the articles within s 180(1)` FALSE EQUALS `the directors may restate the articles at any time and are not required to`
#ASSERT `the restated articles must be sent to the Director within s 180(2)` TRUE
#ASSERT NOT (`the restated articles must be sent to the Director within s 180(2)` FALSE)
#ASSERT `the Director must issue a restated certificate of incorporation within s 180(3)` TRUE
#ASSERT NOT (`the Director must issue a restated certificate of incorporation within s 180(3)` FALSE)
#ASSERT `the restated articles are effective and supersede the earlier articles on a day within s 180(4)` (YMD 2026 4 1) (YMD 2026 4 1)
#ASSERT NOT (`the restated articles are effective and supersede the earlier articles on a day within s 180(4)` (YMD 2026 4 1) (YMD 2026 3 31))

§§ `s 176 -- class or series together (used by s 183(4))`

-- A class: the same answer as s 176(1).
#ASSERT `the holders of a class or series are entitled to vote separately within s 176(1) and s 176(4)` `the creation of a new class equal or superior to the class (s 176(1)(e))` FALSE FALSE FALSE FALSE FALSE
-- A series: needs both s 176(1) and s 176(4).
#ASSERT `the holders of a class or series are entitled to vote separately within s 176(1) and s 176(4)` `the creation of a new class equal or superior to the class (s 176(1)(e))` FALSE FALSE FALSE TRUE TRUE
#ASSERT NOT (`the holders of a class or series are entitled to vote separately within s 176(1) and s 176(4)` `the creation of a new class equal or superior to the class (s 176(1)(e))` FALSE FALSE FALSE TRUE FALSE)
#ASSERT NOT (`the holders of a class or series are entitled to vote separately within s 176(1) and s 176(4)` `no effect that s 176(1) lists` FALSE FALSE FALSE TRUE TRUE)
