IMPORT prelude
IMPORT `cbca-core`
IMPORT `cb2-nouns`
IMPORT `cb2-part7-issue`

-- Tests of cb2-part7-issue.l4 (ss 55 to 59). Every expected value is written from the text of the
-- provision named beside it, not from the output of the rule.

§ `Tests of ss 55 to 59`

§§ `s 55(1): the terms of the security`
-- args: stated on the security, incorporated by reference, the incorporated term conflicts with a stated term
#ASSERT `the term is a term of the security within s 55(1)` TRUE FALSE FALSE
#ASSERT `the term is a term of the security within s 55(1)` FALSE TRUE FALSE
#ASSERT NOT (`the term is a term of the security within s 55(1)` FALSE TRUE TRUE)
#ASSERT NOT (`the term is a term of the security within s 55(1)` FALSE FALSE FALSE)
-- a stated term is a term even if an incorporated term conflicts with it
#ASSERT `the term is a term of the security within s 55(1)` TRUE TRUE TRUE
-- args: the security refers to another instrument or act
#ASSERT `the reference is of itself notice to a purchaser for value of a defect going to validity within s 55(1)` TRUE EQUALS (JUST FALSE)
#ASSERT `the reference is of itself notice to a purchaser for value of a defect going to validity within s 55(1)` FALSE EQUALS NOTHING

§§ `s 55(2): purchaser for value`
#ASSERT `the security is valid in the hands of the purchaser for value without notice within s 55(2)` TRUE FALSE
#ASSERT NOT (`the security is valid in the hands of the purchaser for value without notice within s 55(2)` TRUE TRUE)
#ASSERT NOT (`the security is valid in the hands of the purchaser for value without notice within s 55(2)` FALSE FALSE)

§§ `s 55(3): lack of genuineness is a complete defence, subject to s 57`
-- args: not genuine; then the five s 57 facts: unauthorized, before or in the course of issue, purchaser for value without notice, signed by a trustee/registrar/agent, signed by an employee
#ASSERT `lack of genuineness is a complete defence within s 55(3)` TRUE FALSE FALSE FALSE FALSE FALSE
#ASSERT NOT (`lack of genuineness is a complete defence within s 55(3)` FALSE FALSE FALSE FALSE FALSE FALSE)
-- s 57 makes the signature effective in favour of the purchaser: the defence fails
#ASSERT NOT (`lack of genuineness is a complete defence within s 55(3)` TRUE TRUE TRUE TRUE TRUE FALSE)
#ASSERT NOT (`lack of genuineness is a complete defence within s 55(3)` TRUE TRUE TRUE TRUE FALSE TRUE)
-- s 57 does not apply because the purchaser had notice: the defence stands
#ASSERT `lack of genuineness is a complete defence within s 55(3)` TRUE TRUE TRUE FALSE TRUE FALSE

§§ `s 55(4): ineffective defences`
-- args: a defence other than lack of genuineness, a purchaser for value, has notice of the particular defence
#ASSERT `the defence of the issuer is ineffective against the purchaser within s 55(4)` TRUE TRUE FALSE
#ASSERT NOT (`the defence of the issuer is ineffective against the purchaser within s 55(4)` TRUE TRUE TRUE)
#ASSERT NOT (`the defence of the issuer is ineffective against the purchaser within s 55(4)` TRUE FALSE FALSE)
#ASSERT NOT (`the defence of the issuer is ineffective against the purchaser within s 55(4)` FALSE TRUE FALSE)

§§ `s 56: staleness as notice of defect`
-- args: the event requires payment or delivery on presentation or surrender, money or securities available on the date set, the date set for payment or exchange, the date set for presentation or surrender or performance due, the date the purchaser takes the security
-- limb (a): more than one year after the date set (1 March 2020: 1 March 2021 is one year on)
#ASSERT `the purchaser is deemed to have notice of a defect or defence within s 56` TRUE TRUE (JUST (YearMonthDay 2020 3 1)) NOTHING (YearMonthDay 2021 3 2)
#ASSERT NOT (`the purchaser is deemed to have notice of a defect or defence within s 56` TRUE TRUE (JUST (YearMonthDay 2020 3 1)) NOTHING (YearMonthDay 2021 3 1))
#ASSERT NOT (`the purchaser is deemed to have notice of a defect or defence within s 56` TRUE TRUE (JUST (YearMonthDay 2020 3 1)) NOTHING (YearMonthDay 2020 3 1))
-- limb (a) needs the money or securities to be available
#ASSERT NOT (`the purchaser is deemed to have notice of a defect or defence within s 56` TRUE FALSE (JUST (YearMonthDay 2020 3 1)) NOTHING (YearMonthDay 2021 3 2))
-- limb (a) needs the event to require payment or delivery
#ASSERT NOT (`the purchaser is deemed to have notice of a defect or defence within s 56` FALSE TRUE (JUST (YearMonthDay 2020 3 1)) NOTHING (YearMonthDay 2021 3 2))
-- limb (a) needs a date set for payment or exchange
#ASSERT NOT (`the purchaser is deemed to have notice of a defect or defence within s 56` TRUE TRUE NOTHING NOTHING (YearMonthDay 2030 1 1))
-- limb (b): more than two years after the date set for presentation or surrender, whatever the event requires
#ASSERT `the purchaser is deemed to have notice of a defect or defence within s 56` FALSE FALSE NOTHING (JUST (YearMonthDay 2020 3 1)) (YearMonthDay 2022 3 2)
#ASSERT NOT (`the purchaser is deemed to have notice of a defect or defence within s 56` FALSE FALSE NOTHING (JUST (YearMonthDay 2020 3 1)) (YearMonthDay 2022 3 1))
-- the two dates are independent: a payment date long past does not make limb (b) apply to a later presentation date
#ASSERT NOT (`the purchaser is deemed to have notice of a defect or defence within s 56` FALSE FALSE (JUST (YearMonthDay 2010 1 1)) (JUST (YearMonthDay 2021 3 1)) (YearMonthDay 2022 3 1))

§§ `s 57: unauthorized signature`
-- args: unauthorized, before or in the course of issue, purchaser for value without notice, signed by trustee/registrar/agent, signed by employee
#ASSERT `an unauthorized signature is effective in favour of the purchaser within s 57` TRUE TRUE TRUE TRUE FALSE
#ASSERT `an unauthorized signature is effective in favour of the purchaser within s 57` TRUE TRUE TRUE FALSE TRUE
#ASSERT NOT (`an unauthorized signature is effective in favour of the purchaser within s 57` TRUE TRUE TRUE FALSE FALSE)
#ASSERT NOT (`an unauthorized signature is effective in favour of the purchaser within s 57` TRUE TRUE FALSE TRUE FALSE)
#ASSERT NOT (`an unauthorized signature is effective in favour of the purchaser within s 57` TRUE FALSE TRUE TRUE FALSE)
#ASSERT NOT (`an unauthorized signature is effective in favour of the purchaser within s 57` FALSE TRUE TRUE TRUE FALSE)
#ASSERT `an unauthorized signature is ineffective within s 57` TRUE TRUE FALSE FALSE FALSE
#ASSERT `an unauthorized signature is ineffective within s 57` TRUE TRUE TRUE FALSE FALSE
#ASSERT NOT (`an unauthorized signature is ineffective within s 57` TRUE TRUE TRUE TRUE FALSE)
#ASSERT NOT (`an unauthorized signature is ineffective within s 57` TRUE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`an unauthorized signature is ineffective within s 57` FALSE TRUE FALSE FALSE FALSE)

§§ `s 58: completion or alteration`
-- (1)(a) args: has the necessary signatures, incomplete in some other respect, blanks filled in per authority
#ASSERT `a person may complete the security by filling in the blanks within s 58(1)(a)` TRUE TRUE TRUE
#ASSERT NOT (`a person may complete the security by filling in the blanks within s 58(1)(a)` FALSE TRUE TRUE)
#ASSERT NOT (`a person may complete the security by filling in the blanks within s 58(1)(a)` TRUE FALSE TRUE)
#ASSERT NOT (`a person may complete the security by filling in the blanks within s 58(1)(a)` TRUE TRUE FALSE)
-- (1)(b) args: has the necessary signatures, was incomplete, incorrectly filled in, took for value, took without notice
#ASSERT `the security as completed is enforceable by the purchaser within s 58(1)(b)` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`the security as completed is enforceable by the purchaser within s 58(1)(b)` TRUE TRUE TRUE TRUE FALSE)
#ASSERT NOT (`the security as completed is enforceable by the purchaser within s 58(1)(b)` TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`the security as completed is enforceable by the purchaser within s 58(1)(b)` TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`the security as completed is enforceable by the purchaser within s 58(1)(b)` TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`the security as completed is enforceable by the purchaser within s 58(1)(b)` FALSE TRUE TRUE TRUE TRUE)
-- (2)
#ASSERT `the security remains enforceable only according to its original terms within s 58(2)` TRUE TRUE
#ASSERT NOT (`the security remains enforceable only according to its original terms within s 58(2)` TRUE FALSE)
#ASSERT NOT (`the security remains enforceable only according to its original terms within s 58(2)` FALSE TRUE)

§§ `s 59: warranties of those who sign`
-- args: signs as authenticating trustee, registrar, transfer agent or other person entrusted by the issuer; the other party is a purchaser for value without notice
#ASSERT `the warranties the signer gives within s 59(1)` TRUE TRUE EQUALS (JUST (LIST `a warranty that the security is genuine`, `a warranty that the signer's acts in connection with the issue of the security are within their authority`, `a warranty that the signer has reasonable grounds for believing that the security is in the form and within the amount the issuer is authorized to issue`))
#ASSERT `the warranties the signer gives within s 59(1)` TRUE FALSE EQUALS NOTHING
#ASSERT `the warranties the signer gives within s 59(1)` FALSE TRUE EQUALS NOTHING
-- args: the person is one referred to in s 59(1), the parties otherwise agreed
#ASSERT `the person assumes no further liability for the validity of the security within s 59(2)` TRUE FALSE
#ASSERT NOT (`the person assumes no further liability for the validity of the security within s 59(2)` TRUE TRUE)
#ASSERT NOT (`the person assumes no further liability for the validity of the security within s 59(2)` FALSE FALSE)
