IMPORT prelude
IMPORT `cbca-core`
IMPORT `cbca-core-definitions`
IMPORT `cb4-common`
IMPORT `cb4-borrowing-sale`

-- Tests of cb4-borrowing-sale.l4 (Part XV, s 189). Every expected value is written from the text of the
-- section named beside it, before the run; none is copied from the encoding's output.

§ `Tests -- s 189`

§§ `s 189(1) and (2)`

#ASSERT `the directors may exercise the power without the shareholders' authorization within s 189(1)` `to borrow money on the credit of the corporation (s 189(1)(a))` FALSE FALSE FALSE
#ASSERT `the directors may exercise the power without the shareholders' authorization within s 189(1)` `to issue, reissue, sell, pledge or hypothecate debt obligations of the corporation (s 189(1)(b))` FALSE FALSE FALSE
#ASSERT `the directors may exercise the power without the shareholders' authorization within s 189(1)` `to give a guarantee on behalf of the corporation to secure performance of an obligation of any person (s 189(1)(c))` FALSE FALSE FALSE
#ASSERT `the directors may exercise the power without the shareholders' authorization within s 189(1)` `to mortgage, hypothecate, pledge or otherwise create a security interest in all or any property of the corporation to secure any obligation of the corporation (s 189(1)(d))` FALSE FALSE FALSE
-- Not a listed power.
#ASSERT NOT (`the directors may exercise the power without the shareholders' authorization within s 189(1)` `a power that s 189(1) does not list` FALSE FALSE FALSE)
-- Each of the three sources can take the power away.
#ASSERT NOT (`the directors may exercise the power without the shareholders' authorization within s 189(1)` `to borrow money on the credit of the corporation (s 189(1)(a))` TRUE FALSE FALSE)
#ASSERT NOT (`the directors may exercise the power without the shareholders' authorization within s 189(1)` `to borrow money on the credit of the corporation (s 189(1)(a))` FALSE TRUE FALSE)
#ASSERT NOT (`the directors may exercise the power without the shareholders' authorization within s 189(1)` `to borrow money on the credit of the corporation (s 189(1)(a))` FALSE FALSE TRUE)

#ASSERT `the directors may delegate the powers in subsection 189(1) within s 189(2)` `a director delegated the borrowing powers (s 189(2))` TRUE FALSE FALSE FALSE
#ASSERT `the directors may delegate the powers in subsection 189(1) within s 189(2)` `a committee of directors` TRUE FALSE FALSE FALSE
#ASSERT `the directors may delegate the powers in subsection 189(1) within s 189(2)` `an officer delegated the borrowing powers (s 189(2))` TRUE FALSE FALSE FALSE
-- To a person who is none of these (an employee, for example): not authorized.
#ASSERT NOT (`the directors may delegate the powers in subsection 189(1) within s 189(2)` `a person who is neither a director, a committee of directors nor an officer (s 189(2))` TRUE FALSE FALSE FALSE)
-- Without a resolution: not authorized.
#ASSERT NOT (`the directors may delegate the powers in subsection 189(1) within s 189(2)` `an officer delegated the borrowing powers (s 189(2))` FALSE FALSE FALSE FALSE)
#ASSERT NOT (`the directors may delegate the powers in subsection 189(1) within s 189(2)` `an officer delegated the borrowing powers (s 189(2))` TRUE TRUE FALSE FALSE)
#ASSERT NOT (`the directors may delegate the powers in subsection 189(1) within s 189(2)` `an officer delegated the borrowing powers (s 189(2))` TRUE FALSE TRUE FALSE)
#ASSERT NOT (`the directors may delegate the powers in subsection 189(1) within s 189(2)` `an officer delegated the borrowing powers (s 189(2))` TRUE FALSE FALSE TRUE)

§§ `s 189(3) to (9)`

#ASSERT `the sale, lease or exchange needs the approval of the shareholders within s 189(3)` TRUE TRUE
#ASSERT NOT (`the sale, lease or exchange needs the approval of the shareholders within s 189(3)` TRUE FALSE)
#ASSERT NOT (`the sale, lease or exchange needs the approval of the shareholders within s 189(3)` FALSE TRUE)
#ASSERT `the notice of the meeting complies within s 189(4)` TRUE TRUE TRUE TRUE TRUE
#ASSERT `the notice of the meeting complies within s 189(4)` TRUE TRUE TRUE FALSE FALSE
#ASSERT NOT (`the notice of the meeting complies within s 189(4)` TRUE TRUE TRUE TRUE FALSE)
#ASSERT NOT (`the notice of the meeting complies within s 189(4)` TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`the notice of the meeting complies within s 189(4)` TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`the notice of the meeting complies within s 189(4)` FALSE TRUE TRUE TRUE TRUE)
#ASSERT `the effect on the sale, lease or exchange of leaving out the dissent statement within s 189(4)(b)` TRUE EQUALS `the omission does not make the action invalid`
#ASSERT `the effect on the sale, lease or exchange of leaving out the dissent statement within s 189(4)(b)` FALSE EQUALS `the Act does not say whether the omission makes the action invalid`
#ASSERT `the shareholders may authorize the sale, lease or exchange and fix or authorize the directors to fix its terms within s 189(5)` TRUE
#ASSERT NOT (`the shareholders may authorize the sale, lease or exchange and fix or authorize the directors to fix its terms within s 189(5)` FALSE)
#ASSERT `the share carries the right to vote on the sale, lease or exchange within s 189(6)` TRUE
#ASSERT `the share carries the right to vote on the sale, lease or exchange within s 189(6)` FALSE
#ASSERT `the holders of a class or series are entitled to vote separately on the sale, lease or exchange within s 189(7)` TRUE
#ASSERT NOT (`the holders of a class or series are entitled to vote separately on the sale, lease or exchange within s 189(7)` FALSE)

-- (8): two-thirds boundary on the general vote; every separately voting class must also pass (the class
-- tallies themselves are tested at s 176(6) and not repeated here).
#ASSERT `the sale, lease or exchange is adopted within s 189(8)` (`Vote tally` WITH `votes cast in favour` IS 200, `votes cast against` IS 100, `signed by all the shareholders entitled to vote on the resolution` IS FALSE) TRUE
#ASSERT NOT (`the sale, lease or exchange is adopted within s 189(8)` (`Vote tally` WITH `votes cast in favour` IS 199, `votes cast against` IS 101, `signed by all the shareholders entitled to vote on the resolution` IS FALSE) TRUE)
#ASSERT NOT (`the sale, lease or exchange is adopted within s 189(8)` (`Vote tally` WITH `votes cast in favour` IS 200, `votes cast against` IS 100, `signed by all the shareholders entitled to vote on the resolution` IS FALSE) FALSE)
#ASSERT `the sale, lease or exchange is adopted within s 189(8)` (`Vote tally` WITH `votes cast in favour` IS 0, `votes cast against` IS 0, `signed by all the shareholders entitled to vote on the resolution` IS TRUE) TRUE
-- (9): authorized, and no third-party right is defeated.
#ASSERT `the directors may abandon the sale, lease or exchange without further approval of the shareholders within s 189(9)` TRUE FALSE
#ASSERT NOT (`the directors may abandon the sale, lease or exchange without further approval of the shareholders within s 189(9)` TRUE TRUE)
#ASSERT NOT (`the directors may abandon the sale, lease or exchange without further approval of the shareholders within s 189(9)` FALSE FALSE)
