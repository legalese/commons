IMPORT prelude
IMPORT `cbca-core`
IMPORT `cbca-core-definitions`
IMPORT `cb4-common`
IMPORT `cb4-liquidator`

-- Tests of cb4-liquidator.l4 (ss 221 to 225). Expected values are written from the text of the section
-- named beside each group, before the run.

§ `Tests -- ss 221 to 225`

§§ `s 221`

#ASSERT `the liquidator must give notice of the appointment to the Director and each known claimant and creditor within s 221(a)` TRUE
#ASSERT NOT (`the liquidator must give notice of the appointment to the Director and each known claimant and creditor within s 221(a)` FALSE)
#ASSERT `the liquidator's notice of the appointment is complete within s 221(a)` TRUE TRUE
#ASSERT NOT (`the liquidator's notice of the appointment is complete within s 221(a)` TRUE FALSE)
#ASSERT NOT (`the liquidator's notice of the appointment is complete within s 221(a)` FALSE TRUE)
#ASSERT `the liquidator must publish and give notice of the appointment within s 221(b)` TRUE
#ASSERT NOT (`the liquidator must publish and give notice of the appointment within s 221(b)` FALSE)
#ASSERT `the liquidator's publication and notice are complete within s 221(b)` TRUE TRUE TRUE
#ASSERT NOT (`the liquidator's publication and notice are complete within s 221(b)` FALSE TRUE TRUE)
#ASSERT NOT (`the liquidator's publication and notice are complete within s 221(b)` TRUE FALSE TRUE)
#ASSERT NOT (`the liquidator's publication and notice are complete within s 221(b)` TRUE TRUE FALSE)
#ASSERT `a person indebted to the corporation is required to render an account and pay within s 221(b)(i)` TRUE
#ASSERT NOT (`a person indebted to the corporation is required to render an account and pay within s 221(b)(i)` FALSE)
#ASSERT `a person possessing property of the corporation is required to deliver it within s 221(b)(ii)` TRUE
#ASSERT NOT (`a person possessing property of the corporation is required to deliver it within s 221(b)(ii)` FALSE)
#ASSERT `a person with a claim is required to present particulars in writing within s 221(b)(iii)` TRUE
#ASSERT NOT (`a person with a claim is required to present particulars in writing within s 221(b)(iii)` FALSE)
-- first publication 1 July 2026: two months later is 1 September 2026.
#ASSERT (`the last day for a person with a claim to present particulars within s 221(b)(iii)` (YearMonthDay 2026 7 1)) EQUALS YearMonthDay 2026 9 1
#ASSERT `the particulars were presented in time within s 221(b)(iii)` (YearMonthDay 2026 7 1) (YearMonthDay 2026 9 1)
#ASSERT NOT (`the particulars were presented in time within s 221(b)(iii)` (YearMonthDay 2026 7 1) (YearMonthDay 2026 9 2))
#ASSERT `the particulars were presented in time within s 221(b)(iii)` (YearMonthDay 2026 7 1) (YearMonthDay 2026 7 1)
-- the end-of-month case: first publication 31 December 2026; two months later is the last day of February.
#ASSERT (`the last day for a person with a claim to present particulars within s 221(b)(iii)` (YearMonthDay 2026 12 31)) EQUALS YearMonthDay 2027 2 28
#ASSERT `the liquidator must take into custody and control the property of the corporation within s 221(c)` TRUE
#ASSERT NOT (`the liquidator must take into custody and control the property of the corporation within s 221(c)` FALSE)
#ASSERT `the liquidator must open and maintain a trust account for the moneys of the corporation within s 221(d)` TRUE
#ASSERT NOT (`the liquidator must open and maintain a trust account for the moneys of the corporation within s 221(d)` FALSE)
#ASSERT `the liquidator must keep accounts of the moneys received and paid out within s 221(e)` TRUE
#ASSERT NOT (`the liquidator must keep accounts of the moneys received and paid out within s 221(e)` FALSE)
#ASSERT `the liquidator must maintain separate lists of shareholders, creditors and other claimants within s 221(f)` TRUE
#ASSERT NOT (`the liquidator must maintain separate lists of shareholders, creditors and other claimants within s 221(f)` FALSE)
#ASSERT `the liquidator must apply to the court for directions within s 221(g)` TRUE
#ASSERT NOT (`the liquidator must apply to the court for directions within s 221(g)` FALSE)
-- (h): appointed 1 July 2026: the first twelve months end 1 July 2027.
#ASSERT (`the last day for the financial statements for a twelve month period within s 221(h)` (YearMonthDay 2026 7 1)) EQUALS YearMonthDay 2027 7 1
#ASSERT `the financial statements were delivered in time within s 221(h)` (YearMonthDay 2026 7 1) (YearMonthDay 2027 7 1) (YearMonthDay 2027 7 1)
#ASSERT NOT (`the financial statements were delivered in time within s 221(h)` (YearMonthDay 2026 7 1) (YearMonthDay 2027 7 2) (YearMonthDay 2027 7 1))
#ASSERT NOT (`the financial statements were delivered in time within s 221(h)` (YearMonthDay 2026 7 1) (YearMonthDay 2027 7 1) (YearMonthDay 2027 7 2))
#ASSERT `the form of the financial statements is acceptable within s 221(h)` TRUE FALSE FALSE
#ASSERT `the form of the financial statements is acceptable within s 221(h)` FALSE TRUE FALSE
#ASSERT `the form of the financial statements is acceptable within s 221(h)` FALSE FALSE TRUE
#ASSERT NOT (`the form of the financial statements is acceptable within s 221(h)` FALSE FALSE FALSE)
#ASSERT `the liquidator must distribute the remaining property among the shareholders within s 221(i)` TRUE
#ASSERT NOT (`the liquidator must distribute the remaining property among the shareholders within s 221(i)` FALSE)

§§ `s 222`

#ASSERT (`whether a liquidator may do the act within s 222(1)` `retain lawyers, accountants, engineers, appraisers and other professional advisers (s 222(1)(a))` FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`whether a liquidator may do the act within s 222(1)` `bring, defend or take part in any civil, criminal or administrative action or proceeding in the name and on behalf of the corporation (s 222(1)(b))` FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`whether a liquidator may do the act within s 222(1)` `carry on the business of the corporation (s 222(1)(c))` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`whether a liquidator may do the act within s 222(1)` `carry on the business of the corporation (s 222(1)(c))` FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`whether a liquidator may do the act within s 222(1)` `sell any property of the corporation by public auction or private sale (s 222(1)(d))` FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`whether a liquidator may do the act within s 222(1)` `do all acts and execute or, in Quebec, sign any documents in the name and on behalf of the corporation (s 222(1)(e))` FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`whether a liquidator may do the act within s 222(1)` `borrow money on the security of the property of the corporation (s 222(1)(f))` FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`whether a liquidator may do the act within s 222(1)` `settle or compromise any claims by or against the corporation (s 222(1)(g))` FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`whether a liquidator may do the act within s 222(1)` `do another thing necessary for the liquidation and distribution of the property (s 222(1)(h))` FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`whether a liquidator may do the act within s 222(1)` `do another thing necessary for the liquidation and distribution of the property (s 222(1)(h))` TRUE FALSE) EQUALS JUST FALSE
-- not listed: the section does not decide.
#ASSERT (`whether a liquidator may do the act within s 222(1)` `an act the section does not list` TRUE TRUE) EQUALS NOTHING
-- (2): any one route to the standard.
#ASSERT `the liquidator is not liable within s 222(2)` TRUE FALSE FALSE
#ASSERT `the liquidator is not liable within s 222(2)` FALSE TRUE FALSE
#ASSERT `the liquidator is not liable within s 222(2)` FALSE FALSE TRUE
#ASSERT NOT (`the liquidator is not liable within s 222(2)` FALSE FALSE FALSE)
#ASSERT `the liquidator may apply for an order that the person appear and be examined within s 222(3)` TRUE
#ASSERT NOT (`the liquidator may apply for an order that the person appear and be examined within s 222(3)` FALSE)
#ASSERT `the court may order the person to restore the property or pay compensation to the liquidator within s 222(4)` TRUE
#ASSERT NOT (`the court may order the person to restore the property or pay compensation to the liquidator within s 222(4)` FALSE)

§§ `s 223`

#ASSERT `the liquidator must pay the costs of liquidation and pay or provide for all claims within s 223(1)` TRUE
#ASSERT NOT (`the liquidator must pay the costs of liquidation and pay or provide for all claims within s 223(1)` FALSE)
-- (2): appointed 1 July 2026; one year ends 1 July 2027.
#ASSERT (`the last day for the liquidator's application to the court within s 223(2)` (YearMonthDay 2026 7 1)) EQUALS YearMonthDay 2027 7 1
#ASSERT `the liquidator must apply to the court within s 223(2)` TRUE
#ASSERT NOT (`the liquidator must apply to the court within s 223(2)` FALSE)
#ASSERT `the liquidator's application satisfies s 223(2)` (YearMonthDay 2026 7 1) (YearMonthDay 2027 7 1) `for approval of the final accounts and an order permitting distribution of the remaining property to the shareholders (s 223(2)(a))` FALSE
#ASSERT NOT (`the liquidator's application satisfies s 223(2)` (YearMonthDay 2026 7 1) (YearMonthDay 2027 7 2) `for approval of the final accounts and an order permitting distribution of the remaining property to the shareholders (s 223(2)(a))` FALSE)
#ASSERT `the liquidator's application satisfies s 223(2)` (YearMonthDay 2026 7 1) (YearMonthDay 2027 6 30) `for an extension of time, setting out the reasons (s 223(2)(b))` TRUE
#ASSERT NOT (`the liquidator's application satisfies s 223(2)` (YearMonthDay 2026 7 1) (YearMonthDay 2027 6 30) `for an extension of time, setting out the reasons (s 223(2)(b))` FALSE)
-- an extension asked for a day late is as late as a final-accounts application a day late.
#ASSERT NOT (`the liquidator's application satisfies s 223(2)` (YearMonthDay 2026 7 1) (YearMonthDay 2027 7 2) `for an extension of time, setting out the reasons (s 223(2)(b))` TRUE)
#ASSERT `the liquidator's application satisfies s 223(2)` (YearMonthDay 2026 7 1) (YearMonthDay 2027 7 1) `for an extension of time, setting out the reasons (s 223(2)(b))` TRUE
#ASSERT NOT (`the liquidator's application satisfies s 223(2)` (YearMonthDay 2026 7 1) (YearMonthDay 2027 6 30) `an application of another kind` TRUE)
#ASSERT `a shareholder may apply for an order that the liquidator show cause within s 223(3)` TRUE TRUE
#ASSERT NOT (`a shareholder may apply for an order that the liquidator show cause within s 223(3)` FALSE TRUE)
#ASSERT NOT (`a shareholder may apply for an order that the liquidator show cause within s 223(3)` TRUE FALSE)
#ASSERT `the liquidator's notice of intention to apply complies with s 223(4)` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`the liquidator's notice of intention to apply complies with s 223(4)` FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`the liquidator's notice of intention to apply complies with s 223(4)` TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`the liquidator's notice of intention to apply complies with s 223(4)` TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`the liquidator's notice of intention to apply complies with s 223(4)` TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`the liquidator's notice of intention to apply complies with s 223(4)` TRUE TRUE TRUE TRUE FALSE)
#ASSERT `the court must order the Director to issue a certificate of dissolution within s 223(5)(a)` TRUE
#ASSERT NOT (`the court must order the Director to issue a certificate of dissolution within s 223(5)(a)` FALSE)
#ASSERT `the court must order the custody or disposal of the documents and records within s 223(5)(b)` TRUE
#ASSERT NOT (`the court must order the custody or disposal of the documents and records within s 223(5)(b)` FALSE)
-- (c) depends on the approval alone: (6) is not a condition of the order.
#ASSERT `the court must order the liquidator's discharge within s 223(5)(c)` TRUE
#ASSERT NOT (`the court must order the liquidator's discharge within s 223(5)(c)` FALSE)
#ASSERT `the liquidator must send a certified copy of the order to the Director within s 223(6)` TRUE
#ASSERT NOT (`the liquidator must send a certified copy of the order to the Director within s 223(6)` FALSE)
#ASSERT `the Director must issue a certificate of dissolution within s 223(7)` TRUE
#ASSERT NOT (`the Director must issue a certificate of dissolution within s 223(7)` FALSE)
#ASSERT `the corporation exists on a day within s 223(8)` (YearMonthDay 2027 9 1) (YearMonthDay 2027 8 31)
#ASSERT NOT (`the corporation exists on a day within s 223(8)` (YearMonthDay 2027 9 1) (YearMonthDay 2027 9 1))

§§ `s 224`

#ASSERT `a shareholder may apply to the court for a distribution in money within s 224(1)` TRUE FALSE TRUE
#ASSERT `a shareholder may apply to the court for a distribution in money within s 224(1)` FALSE TRUE TRUE
#ASSERT NOT (`a shareholder may apply to the court for a distribution in money within s 224(1)` FALSE FALSE TRUE)
#ASSERT NOT (`a shareholder may apply to the court for a distribution in money within s 224(1)` TRUE TRUE FALSE)
#ASSERT `the court may make the order within s 224(2)` TRUE `an order that all the property of the corporation be converted into and distributed in money (s 224(2)(a))`
#ASSERT `the court may make the order within s 224(2)` TRUE `an order that the claims of the applying shareholder be satisfied by a distribution in money (s 224(2)(b))`
#ASSERT NOT (`the court may make the order within s 224(2)` TRUE `an order of another kind than those s 224(2) names`)
#ASSERT NOT (`the court may make the order within s 224(2)` FALSE `an order that all the property of the corporation be converted into and distributed in money (s 224(2)(a))`)
#ASSERT `subsections 190(20) to (22) apply within s 224(2)(b)` `an order that the claims of the applying shareholder be satisfied by a distribution in money (s 224(2)(b))`
#ASSERT NOT (`subsections 190(20) to (22) apply within s 224(2)(b)` `an order that all the property of the corporation be converted into and distributed in money (s 224(2)(a))`)

§§ `s 225`

-- the prescribed period ends 31 December 2031; an order under s 223(5) fixed a shorter period ending 30 June 2029.
#ASSERT (`the last day the custodian remains liable to produce the documents and records within s 225(1)` (YearMonthDay 2031 12 31) NOTHING) EQUALS YearMonthDay 2031 12 31
#ASSERT (`the last day the custodian remains liable to produce the documents and records within s 225(1)` (YearMonthDay 2031 12 31) (JUST (YearMonthDay 2029 6 30))) EQUALS YearMonthDay 2029 6 30
-- an order that fixes a LONGER period does not extend the prescribed one ("shorter" only).
#ASSERT (`the last day the custodian remains liable to produce the documents and records within s 225(1)` (YearMonthDay 2031 12 31) (JUST (YearMonthDay 2033 1 1))) EQUALS YearMonthDay 2031 12 31
#ASSERT `the custodian remains liable to produce the documents and records on a day within s 225(1)` TRUE (YearMonthDay 2029 6 30) (YearMonthDay 2029 6 30)
#ASSERT NOT (`the custodian remains liable to produce the documents and records on a day within s 225(1)` TRUE (YearMonthDay 2029 6 30) (YearMonthDay 2029 7 1))
#ASSERT NOT (`the custodian remains liable to produce the documents and records on a day within s 225(1)` FALSE (YearMonthDay 2029 6 30) (YearMonthDay 2029 6 1))
#ASSERT `the custodian is guilty of an offence within s 225(2)` TRUE FALSE
#ASSERT NOT (`the custodian is guilty of an offence within s 225(2)` TRUE TRUE)
#ASSERT NOT (`the custodian is guilty of an offence within s 225(2)` FALSE FALSE)
#ASSERT `the penalty is within the limits of s 225(2)` 5000 6
#ASSERT NOT (`the penalty is within the limits of s 225(2)` 5001 6)
#ASSERT NOT (`the penalty is within the limits of s 225(2)` 5000 7)
#ASSERT `the penalty is within the limits of s 225(2)` 0 0
