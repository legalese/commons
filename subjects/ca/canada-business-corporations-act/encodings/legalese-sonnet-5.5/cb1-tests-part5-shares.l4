§§ `s 27`

-- src:490-492
#ASSERT `the articles may authorize the issue of a class of shares in series in that way within s 27(1)` `the articles fix the number of shares in, and determine the designation, rights, privileges, restrictions and conditions attaching to the shares of, each series`
#ASSERT `the articles may authorize the issue of a class of shares in series in that way within s 27(1)` `the articles authorize the directors to fix the number of shares in, and determine the designation, rights, privileges, restrictions and conditions attaching to the shares of, each series`
#ASSERT NOT (`the articles may authorize the issue of a class of shares in series in that way within s 27(1)` `any other way`)
-- src:494: rateably. 600 available; this series is owed 400 of the 1,000 owed to all: it receives 240.
#ASSERT `the amount this series receives within s 27(2)` 600 400 1000 EQUALS JUST 240
-- enough for everyone: each receives what it is owed
#ASSERT `the amount this series receives within s 27(2)` 2000 400 1000 EQUALS JUST 400
#ASSERT `the amount this series receives within s 27(2)` 1000 400 1000 EQUALS JUST 400
-- nothing available
#ASSERT `the amount this series receives within s 27(2)` 0 400 1000 EQUALS JUST 0
-- nothing owed to any series: the proportion has no meaning
#ASSERT `the amount this series receives within s 27(2)` 600 0 0 EQUALS NOTHING
-- src:496
#ASSERT `the rights attached to the series are permitted within s 27(3)` FALSE
#ASSERT NOT (`the rights attached to the series are permitted within s 27(3)` TRUE)
-- src:498: before the issue of shares of the series
#ASSERT `the directors have complied with the duty to send articles of amendment before the issue within s 27(4)` TRUE (YearMonthDay 2026 5 1) (YearMonthDay 2026 5 2)
#ASSERT NOT (`the directors have complied with the duty to send articles of amendment before the issue within s 27(4)` TRUE (YearMonthDay 2026 5 2) (YearMonthDay 2026 5 2))
#ASSERT NOT (`the directors have complied with the duty to send articles of amendment before the issue within s 27(4)` TRUE (YearMonthDay 2026 5 3) (YearMonthDay 2026 5 2))
#ASSERT `the directors have complied with the duty to send articles of amendment before the issue within s 27(4)` FALSE (YearMonthDay 2026 5 3) (YearMonthDay 2026 5 2)
-- src:500, 502
#ASSERT `the Director must issue a certificate of amendment within s 27(5)` TRUE
#ASSERT NOT (`the Director must issue a certificate of amendment within s 27(5)` FALSE)
#ASSERT `the articles are amended by the certificate of amendment by the day within s 27(6)` (YearMonthDay 2026 5 5) (YearMonthDay 2026 5 5)
#ASSERT NOT (`the articles are amended by the certificate of amendment by the day within s 27(6)` (YearMonthDay 2026 5 5) (YearMonthDay 2026 5 4))

§§ `s 28`

-- src:504, 506-509: if the articles so provide; no right for non-money consideration, share dividends, conversion/option/right exercise
#ASSERT `shareholders of the class have a pre-emptive right in respect of the shares within s 28(1) and s 28(2)` TRUE `any other issue of shares`
#ASSERT NOT (`shareholders of the class have a pre-emptive right in respect of the shares within s 28(1) and s 28(2)` FALSE `any other issue of shares`)
#ASSERT NOT (`shareholders of the class have a pre-emptive right in respect of the shares within s 28(1) and s 28(2)` TRUE `shares to be issued for a consideration other than money`)
#ASSERT NOT (`shareholders of the class have a pre-emptive right in respect of the shares within s 28(1) and s 28(2)` TRUE `shares to be issued as a share dividend`)
#ASSERT NOT (`shareholders of the class have a pre-emptive right in respect of the shares within s 28(1) and s 28(2)` TRUE `shares to be issued pursuant to the exercise of conversion privileges, options or rights previously granted by the corporation`)
-- in proportion to their holdings: 250 of 1,000 held, 400 shares offered, so 100
#ASSERT `the number of the offered shares the shareholder has a pre-emptive right to acquire within s 28(1)` 400 250 1000 EQUALS JUST 100
#ASSERT `the number of the offered shares the shareholder has a pre-emptive right to acquire within s 28(1)` 400 0 1000 EQUALS JUST 0
#ASSERT `the number of the offered shares the shareholder has a pre-emptive right to acquire within s 28(1)` 400 0 0 EQUALS NOTHING
-- no shares of the class may be issued unless first offered
#ASSERT `the shares of the class may be issued within s 28(1)` TRUE TRUE FALSE
#ASSERT NOT (`the shares of the class may be issued within s 28(1)` TRUE FALSE FALSE)
#ASSERT `the shares of the class may be issued within s 28(1)` TRUE FALSE TRUE
#ASSERT `the shares of the class may be issued within s 28(1)` FALSE FALSE FALSE

