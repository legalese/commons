#ASSERT `the stated capital of the body corporate for the purposes of s 34(2), s 38, s 42 and paragraph 185(2)(a) within s 26(9)` TRUE 900 800 EQUALS 900
#ASSERT `the stated capital of the body corporate for the purposes of s 34(2), s 38, s 42 and paragraph 185(2)(a) within s 26(9)` FALSE 500 800 EQUALS 500
