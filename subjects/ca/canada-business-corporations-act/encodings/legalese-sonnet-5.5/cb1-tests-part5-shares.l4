IMPORT prelude
IMPORT `cbca-core`
IMPORT `cb1-nouns`
IMPORT `cb1-part5-shares`

-- Tests of cb1-part5-shares.l4 (s 24 to s 29.1). Expected values are written from the text of the Act
-- (src:435-521), never from the code's output: each comment says what the text gives.

§ `Tests -- Part V shares, stated capital, series, pre-emptive right, options`

§§ `s 24`

-- src:435, 437: registered form, no nominal or par value; a pre-continuation par value share is deemed to be without
#ASSERT `the share is as s 24(1) requires within s 24(1) and s 24(2)` TRUE FALSE FALSE
#ASSERT `the share is as s 24(1) requires within s 24(1) and s 24(2)` TRUE TRUE TRUE
#ASSERT NOT (`the share is as s 24(1) requires within s 24(1) and s 24(2)` TRUE TRUE FALSE)
#ASSERT NOT (`the share is as s 24(1) requires within s 24(1) and s 24(2)` FALSE FALSE FALSE)

-- src:439-442: only one class: vote, dividend, remaining property
#ASSERT `the holders of the only class have the right within s 24(3)` TRUE `to vote at any meeting of shareholders of the corporation` EQUALS JUST TRUE
#ASSERT `the holders of the only class have the right within s 24(3)` TRUE `to receive any dividend declared by the corporation` EQUALS JUST TRUE
#ASSERT `the holders of the only class have the right within s 24(3)` TRUE `to receive the remaining property of the corporation on dissolution` EQUALS JUST TRUE
-- a right the subsection does not list is not answered
#ASSERT `the holders of the only class have the right within s 24(3)` TRUE `any other right` EQUALS NOTHING
-- more than one class: the subsection does not speak
#ASSERT `the holders of the only class have the right within s 24(3)` FALSE `to vote at any meeting of shareholders of the corporation` EQUALS NOTHING
#ASSERT `the rights of the holders of the only class are as s 24(3) requires` TRUE TRUE
#ASSERT NOT (`the rights of the holders of the only class are as s 24(3) requires` TRUE FALSE)
#ASSERT `the rights of the holders of the only class are as s 24(3) requires` FALSE FALSE

-- src:444-446: with more than one class, the rights of each are set out; the three rights go on at least one class, not all on one
#ASSERT `the articles meet the requirements for classes of shares within s 24(4)` TRUE TRUE TRUE TRUE TRUE
#ASSERT `the articles meet the requirements for classes of shares within s 24(4)` FALSE FALSE FALSE FALSE FALSE
#ASSERT NOT (`the articles meet the requirements for classes of shares within s 24(4)` TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`the articles meet the requirements for classes of shares within s 24(4)` TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`the articles meet the requirements for classes of shares within s 24(4)` TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`the articles meet the requirements for classes of shares within s 24(4)` TRUE TRUE TRUE TRUE FALSE)

§§ `s 25`

-- src:448: subject to the articles, by-laws, any unanimous shareholder agreement and s 28
#ASSERT `the directors may determine the times, persons and consideration of an issue of shares within s 25(1)` FALSE FALSE
#ASSERT NOT (`the directors may determine the times, persons and consideration of an issue of shares within s 25(1)` TRUE FALSE)
#ASSERT NOT (`the directors may determine the times, persons and consideration of an issue of shares within s 25(1)` FALSE TRUE)
-- src:450: non-assessable
#ASSERT `the holder is liable in respect of the share to the corporation or its creditors within s 25(2)` TRUE EQUALS JUST FALSE
#ASSERT `the holder is liable in respect of the share to the corporation or its creditors within s 25(2)` FALSE EQUALS NOTHING
-- src:452: fully paid in money, or property or past services not less than the fair equivalent
#ASSERT `the share may be issued for the consideration within s 25(3)` `money` TRUE TRUE TRUE
#ASSERT NOT (`the share may be issued for the consideration within s 25(3)` `money` FALSE TRUE TRUE)
#ASSERT `the share may be issued for the consideration within s 25(3)` `property` TRUE TRUE TRUE
#ASSERT NOT (`the share may be issued for the consideration within s 25(3)` `property` TRUE FALSE TRUE)
#ASSERT NOT (`the share may be issued for the consideration within s 25(3)` `property` TRUE TRUE FALSE)
#ASSERT NOT (`the share may be issued for the consideration within s 25(3)` `property` FALSE TRUE TRUE)
#ASSERT `the share may be issued for the consideration within s 25(3)` `past services` TRUE TRUE FALSE
#ASSERT NOT (`the share may be issued for the consideration within s 25(3)` `past services` TRUE FALSE FALSE)
#ASSERT NOT (`the share may be issued for the consideration within s 25(3)` `any other consideration` TRUE TRUE TRUE)
-- src:454: items the directors may take into account
#ASSERT `the directors may take the item into account in determining the fair equivalent within s 25(4)` `reasonable charges and expenses of organization and reorganization` EQUALS JUST TRUE
#ASSERT `the directors may take the item into account in determining the fair equivalent within s 25(4)` `payments for property and past services reasonably expected to benefit the corporation` EQUALS JUST TRUE
#ASSERT `the directors may take the item into account in determining the fair equivalent within s 25(4)` `any other item` EQUALS NOTHING
-- src:456: a promissory note made by the person to whom a share is issued, or by a person not at arm's length, is not property
#ASSERT `the thing is property for the purposes of s 25 within s 25(5)` TRUE FALSE FALSE
#ASSERT `the thing is property for the purposes of s 25 within s 25(5)` TRUE TRUE FALSE
#ASSERT NOT (`the thing is property for the purposes of s 25 within s 25(5)` TRUE TRUE TRUE)
#ASSERT NOT (`the thing is property for the purposes of s 25 within s 25(5)` FALSE FALSE FALSE)

§§ `s 26`

-- src:458
#ASSERT `the corporation has complied with the duty to maintain stated capital accounts within s 26(1)` TRUE
#ASSERT NOT (`the corporation has complied with the duty to maintain stated capital accounts within s 26(1)` FALSE)
-- src:462-467: the exchanges in which less than the full consideration may be added
#ASSERT `the corporation may add less than the full consideration within s 26(3)` `in exchange for property of a person who immediately before the exchange did not deal with the corporation at arm's length` FALSE
#ASSERT `the corporation may add less than the full consideration within s 26(3)` `in exchange for shares of, or another interest or right in, a body corporate that immediately before the exchange, or because of the exchange, did not deal with the corporation at arm's length` FALSE
#ASSERT `the corporation may add less than the full consideration within s 26(3)` `in exchange for property of a person who dealt with the corporation at arm's length, and the person, the corporation and all the holders of shares in the class or series so issued consent to the exchange` TRUE
#ASSERT NOT (`the corporation may add less than the full consideration within s 26(3)` `in exchange for property of a person who dealt with the corporation at arm's length, and the person, the corporation and all the holders of shares in the class or series so issued consent to the exchange` FALSE)
#ASSERT `the corporation may add less than the full consideration within s 26(3)` `pursuant to an agreement referred to in subsection 182(1) or an arrangement referred to in paragraph 192(1)(b) or (c), or to shareholders of an amalgamating body corporate who receive the shares in addition to or instead of securities of the amalgamated body corporate` FALSE
#ASSERT NOT (`the corporation may add less than the full consideration within s 26(3)` `any other issue of shares` TRUE)
-- src:460, 462, 469: the full amount, never more; less only in a listed exchange
#ASSERT `the amount added to the stated capital account is permitted within s 26(2), s 26(3) and s 26(4)` 1000 1000 FALSE
#ASSERT NOT (`the amount added to the stated capital account is permitted within s 26(2), s 26(3) and s 26(4)` 1000 1001 FALSE)
#ASSERT NOT (`the amount added to the stated capital account is permitted within s 26(2), s 26(3) and s 26(4)` 1000 1001 TRUE)
#ASSERT `the amount added to the stated capital account is permitted within s 26(2), s 26(3) and s 26(4)` 1000 600 TRUE
#ASSERT NOT (`the amount added to the stated capital account is permitted within s 26(2), s 26(3) and s 26(4)` 1000 600 FALSE)
-- src:471-474: special resolution for an addition not received as consideration, with more than one class or series
#ASSERT `the addition must be approved by special resolution within s 26(5)` FALSE TRUE FALSE
#ASSERT NOT (`the addition must be approved by special resolution within s 26(5)` TRUE TRUE FALSE)
#ASSERT NOT (`the addition must be approved by special resolution within s 26(5)` FALSE FALSE FALSE)
#ASSERT NOT (`the addition must be approved by special resolution within s 26(5)` FALSE TRUE TRUE)
DECIDE `a passing tally` IS `Vote tally` WITH
    `votes cast in favour` IS 67
    `votes cast against` IS 33
    `signed by all the shareholders entitled to vote on the resolution` IS FALSE

DECIDE `a failing tally` IS `Vote tally` WITH
    `votes cast in favour` IS 66
    `votes cast against` IS 34
    `signed by all the shareholders entitled to vote on the resolution` IS FALSE

-- two thirds of 100 votes cast is 66.67: 67 passes, 66 does not
#ASSERT `the addition has the approval s 26(5) requires` TRUE `a passing tally`
#ASSERT NOT (`the addition has the approval s 26(5) requires` TRUE `a failing tally`)
#ASSERT `the addition has the approval s 26(5) requires` FALSE `a failing tally`
-- src:476
#ASSERT `the corporation may add the amount to a stated capital account within s 26(6)` `consideration received by a continued body corporate for a share it issued` TRUE FALSE EQUALS JUST TRUE
#ASSERT `the corporation may add the amount to a stated capital account within s 26(6)` `consideration received by a continued body corporate for a share it issued` FALSE FALSE EQUALS JUST FALSE
#ASSERT `the corporation may add the amount to a stated capital account within s 26(6)` `an amount credited to a retained earnings or other surplus account` FALSE TRUE EQUALS JUST TRUE
#ASSERT `the corporation may add the amount to a stated capital account within s 26(6)` `an amount credited to a retained earnings or other surplus account` FALSE FALSE EQUALS JUST FALSE
#ASSERT `the corporation may add the amount to a stated capital account within s 26(6)` `any other amount` TRUE TRUE EQUALS NOTHING
