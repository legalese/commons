IMPORT prelude
IMPORT `cbca-core`
IMPORT `cb5-nouns`
IMPORT `cb5-part19-investigation`

-- TESTS of cb5-part19-investigation.l4 (Part XIX, ss 229 to 237). Every expected value is written from the
-- text of the section named beside it, before the run; none is copied from the module's output.
-- Arguments are positional, in the order of the rule's GIVEN: see the module.

§ `Tests of Part XIX`

§§ `s 229(1) who may apply: a security holder or the Director, to the court of the registered office`

#ASSERT `may apply for an order directing an investigation within s 229(1)` `a security holder` TRUE
#ASSERT `may apply for an order directing an investigation within s 229(1)` `the Director` TRUE
-- Not in the list "a security holder or the Director".
#ASSERT NOT (`may apply for an order directing an investigation within s 229(1)` `a creditor` TRUE)
#ASSERT NOT (`may apply for an order directing an investigation within s 229(1)` `a director` TRUE)
#ASSERT NOT (`may apply for an order directing an investigation within s 229(1)` `an incorporator` TRUE)
-- The right court: the one where the corporation has its registered office.
#ASSERT NOT (`may apply for an order directing an investigation within s 229(1)` `a security holder` FALSE)
#ASSERT NOT (`may apply for an order directing an investigation within s 229(1)` `the Director` FALSE)

§§ `s 229(2) the four grounds, each enough alone, after an application`

#ASSERT `the court may order an investigation within s 229(2)` TRUE TRUE FALSE FALSE FALSE
#ASSERT `the court may order an investigation within s 229(2)` TRUE FALSE TRUE FALSE FALSE
#ASSERT `the court may order an investigation within s 229(2)` TRUE FALSE FALSE TRUE FALSE
#ASSERT `the court may order an investigation within s 229(2)` TRUE FALSE FALSE FALSE TRUE
#ASSERT `the court may order an investigation within s 229(2)` TRUE TRUE TRUE TRUE TRUE
-- No ground appears to the court: no order.
#ASSERT NOT (`the court may order an investigation within s 229(2)` TRUE FALSE FALSE FALSE FALSE)
-- A ground without an application under subsection (1): the power is "on an application under subsection (1)".
#ASSERT NOT (`the court may order an investigation within s 229(2)` FALSE TRUE TRUE TRUE TRUE)

§§ `s 229(3) notice to the Director; s 229(4) no security for costs; s 229(5) in camera; s 229(6) publication`

#ASSERT `the applicant must give the Director reasonable notice within s 229(3)` `a security holder`
#ASSERT NOT (`the applicant must give the Director reasonable notice within s 229(3)` `the Director`)
#ASSERT `the applicant has complied with the duty to notify the Director within s 229(3)` `a security holder` TRUE
#ASSERT NOT (`the applicant has complied with the duty to notify the Director within s 229(3)` `a security holder` FALSE)
-- The Director who applies owes notice to nobody.
#ASSERT `the applicant has complied with the duty to notify the Director within s 229(3)` `the Director` FALSE
#ASSERT `the Director is entitled to appear and be heard within s 229(3)` TRUE
#ASSERT NOT (`the Director is entitled to appear and be heard within s 229(3)` FALSE)
#ASSERT NOT `an applicant under s 229 is required to give security for costs within s 229(4)`
#ASSERT `the application must be heard in camera within s 229(5)` TRUE
#ASSERT NOT (`the application must be heard in camera within s 229(5)` FALSE)
-- Ex parte proceedings: publication needs the court's authorization or the corporation's written consent.
#ASSERT NOT (`publishing anything relating to the proceedings is permitted within s 229(6)` TRUE FALSE FALSE)
#ASSERT `publishing anything relating to the proceedings is permitted within s 229(6)` TRUE TRUE FALSE
#ASSERT `publishing anything relating to the proceedings is permitted within s 229(6)` TRUE FALSE TRUE
#ASSERT `publishing anything relating to the proceedings is permitted within s 229(6)` TRUE TRUE TRUE
-- Proceedings that are not ex parte are outside the prohibition.
#ASSERT `publishing anything relating to the proceedings is permitted within s 229(6)` FALSE FALSE FALSE

§§ `s 230 the court's orders in an investigation`

#ASSERT `the court may make an order of the kind within s 230(1)` `an order to investigate (s 230(1)(a))` TRUE
#ASSERT `the court may make an order of the kind within s 230(1)` `an order appointing, remunerating or replacing an inspector (s 230(1)(b))` TRUE
#ASSERT `the court may make an order of the kind within s 230(1)` `an order fixing notice to an interested person or dispensing with it (s 230(1)(c))` TRUE
#ASSERT `the court may make an order of the kind within s 230(1)` `an order authorizing an inspector to enter premises and copy documents (s 230(1)(d))` TRUE
#ASSERT `the court may make an order of the kind within s 230(1)` `an order requiring any person to produce documents or records to the inspector (s 230(1)(e))` TRUE
#ASSERT `the court may make an order of the kind within s 230(1)` `an order authorizing an inspector to hold a hearing and examine on oath (s 230(1)(f))` TRUE
#ASSERT `the court may make an order of the kind within s 230(1)` `an order requiring any person to attend a hearing and give evidence on oath (s 230(1)(g))` TRUE
#ASSERT `the court may make an order of the kind within s 230(1)` `an order giving directions to an inspector or an interested person (s 230(1)(h))` TRUE
#ASSERT `the court may make an order of the kind within s 230(1)` `an order requiring an inspector to report to the court (s 230(1)(i))` TRUE
#ASSERT `the court may make an order of the kind within s 230(1)` `an order on whether and how an inspector's report is published (s 230(1)(j))` TRUE
#ASSERT `the court may make an order of the kind within s 230(1)` `an order requiring an inspector to discontinue the investigation (s 230(1)(k))` TRUE
#ASSERT `the court may make an order of the kind within s 230(1)` `an order requiring the corporation to pay the costs of the investigation (s 230(1)(l))` TRUE
#ASSERT `the court may make an order of the kind within s 230(1)` `any other order the court thinks fit (s 230(1))` TRUE
-- Not in connection with an investigation under Part XIX: no power under this section.
#ASSERT NOT (`the court may make an order of the kind within s 230(1)` `an order requiring any person to produce documents or records to the inspector (s 230(1)(e))` FALSE)
#ASSERT NOT (`the court may make an order of the kind within s 230(1)` `any other order the court thinks fit (s 230(1))` FALSE)
-- s 230(2): the inspector sends the Director a copy of every report.
#ASSERT `the inspector has complied with the duty to send the Director a copy of a report within s 230(2)` TRUE TRUE
#ASSERT NOT (`the inspector has complied with the duty to send the Director a copy of a report within s 230(2)` TRUE FALSE)
#ASSERT `the inspector has complied with the duty to send the Director a copy of a report within s 230(2)` FALSE FALSE

§§ `s 231 an inspector's powers; s 232 hearings and counsel`

#ASSERT `an inspector has the power within s 231(1)` TRUE
#ASSERT NOT (`an inspector has the power within s 231(1)` FALSE)
#ASSERT `an inspector may furnish information to or exchange it with the official within s 231(2)` TRUE TRUE TRUE TRUE
#ASSERT NOT (`an inspector may furnish information to or exchange it with the official within s 231(2)` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`an inspector may furnish information to or exchange it with the official within s 231(2)` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`an inspector may furnish information to or exchange it with the official within s 231(2)` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`an inspector may furnish information to or exchange it with the official within s 231(2)` TRUE TRUE TRUE FALSE)
#ASSERT `the inspector must produce a copy of the order within s 231(3)` TRUE TRUE TRUE
#ASSERT NOT (`the inspector must produce a copy of the order within s 231(3)` FALSE TRUE TRUE)
#ASSERT NOT (`the inspector must produce a copy of the order within s 231(3)` TRUE FALSE TRUE)
#ASSERT NOT (`the inspector must produce a copy of the order within s 231(3)` TRUE TRUE FALSE)
#ASSERT `an interested person may apply to the court for an in camera hearing and directions within s 232(1)` TRUE TRUE
#ASSERT NOT (`an interested person may apply to the court for an in camera hearing and directions within s 232(1)` FALSE TRUE)
#ASSERT NOT (`an interested person may apply to the court for an in camera hearing and directions within s 232(1)` TRUE FALSE)
#ASSERT `the person has a right to be represented by counsel within s 232(2)` TRUE FALSE
#ASSERT `the person has a right to be represented by counsel within s 232(2)` FALSE TRUE
#ASSERT `the person has a right to be represented by counsel within s 232(2)` TRUE TRUE
#ASSERT NOT (`the person has a right to be represented by counsel within s 232(2)` FALSE FALSE)

§§ `s 233 criminating statements; s 234 absolute privilege`

#ASSERT NOT `a person is excused from giving evidence by reason only that it tends to criminate within s 233`
-- Evidence given under compulsion, later proceeding under an Act of Parliament, neither exception: barred.
#ASSERT `the use of the evidence within s 233` TRUE TRUE TRUE FALSE FALSE EQUALS `s 233 bars the use of the evidence against the person`
-- The two exceptions: the perjury prosecution under Criminal Code s 132 and the prosecution under s 136.
#ASSERT `the use of the evidence within s 233` TRUE TRUE TRUE TRUE FALSE EQUALS `s 233 does not bar the use of the evidence against the person`
#ASSERT `the use of the evidence within s 233` TRUE TRUE TRUE FALSE TRUE EQUALS `s 233 does not bar the use of the evidence against the person`
-- A proceeding not under an Act of Parliament, or one instituted before the evidence was given, or
-- evidence that does not tend to criminate: s 233 does not bar.
#ASSERT `the use of the evidence within s 233` TRUE TRUE FALSE FALSE FALSE EQUALS `s 233 does not bar the use of the evidence against the person`
#ASSERT `the use of the evidence within s 233` TRUE FALSE TRUE FALSE FALSE EQUALS `s 233 does not bar the use of the evidence against the person`
#ASSERT `the use of the evidence within s 233` FALSE TRUE TRUE FALSE FALSE EQUALS `s 233 does not bar the use of the evidence against the person`
#ASSERT `the statement or report has absolute privilege within s 234` TRUE
#ASSERT NOT (`the statement or report has absolute privilege within s 234` FALSE)

§§ `s 235 the Director's inquiry into ownership and control, and the offence`

#ASSERT `the Director may require the person to report within s 235(1)` TRUE TRUE
#ASSERT NOT (`the Director may require the person to report within s 235(1)` FALSE TRUE)
#ASSERT NOT (`the Director may require the person to report within s 235(1)` TRUE FALSE)
#ASSERT `the person has made the report required within s 235(1)` TRUE TRUE
#ASSERT NOT (`the person has made the report required within s 235(1)` TRUE FALSE)
#ASSERT NOT (`the person has made the report required within s 235(1)` FALSE TRUE)
#ASSERT `the person is deemed to have an interest or right in the security within s 235(2)` TRUE FALSE FALSE
#ASSERT `the person is deemed to have an interest or right in the security within s 235(2)` FALSE TRUE FALSE
#ASSERT `the person is deemed to have an interest or right in the security within s 235(2)` FALSE FALSE TRUE
#ASSERT NOT (`the person is deemed to have an interest or right in the security within s 235(2)` FALSE FALSE FALSE)
#ASSERT `the Director must publish the particulars within s 235(3)` TRUE TRUE TRUE
#ASSERT NOT (`the Director must publish the particulars within s 235(3)` FALSE TRUE TRUE)
#ASSERT NOT (`the Director must publish the particulars within s 235(3)` TRUE FALSE TRUE)
#ASSERT NOT (`the Director must publish the particulars within s 235(3)` TRUE TRUE FALSE)
#ASSERT `the person is guilty of an offence within s 235(4)` TRUE FALSE
#ASSERT NOT (`the person is guilty of an offence within s 235(4)` TRUE TRUE)
#ASSERT NOT (`the person is guilty of an offence within s 235(4)` FALSE FALSE)
-- The ceilings: five thousand dollars, six months, or both (s 235(4)); the same for a director or officer (s 235(5)).
#ASSERT (`the most the court may impose within s 235(4)`)'s `largest fine in dollars` EQUALS 5000
#ASSERT (`the most the court may impose within s 235(4)`)'s `longest imprisonment in months` EQUALS 6
#ASSERT (`the most the court may impose within s 235(4)`)'s `fine and imprisonment may both be imposed`
#ASSERT (`the most the court may impose on a director or officer within s 235(5)`)'s `largest fine in dollars` EQUALS 5000
#ASSERT (`the most the court may impose on a director or officer within s 235(5)`)'s `longest imprisonment in months` EQUALS 6
#ASSERT `the director or officer is a party to and guilty of the offence within s 235(5)` TRUE TRUE TRUE
#ASSERT NOT (`the director or officer is a party to and guilty of the offence within s 235(5)` FALSE TRUE TRUE)
#ASSERT NOT (`the director or officer is a party to and guilty of the offence within s 235(5)` TRUE FALSE TRUE)
#ASSERT NOT (`the director or officer is a party to and guilty of the offence within s 235(5)` TRUE TRUE FALSE)

§§ `s 236 solicitor-client privilege; s 237 inquiries by the Director`

#ASSERT NOT `Part XIX affects solicitor-client privilege or professional secrecy within s 236`
#ASSERT `the Director may make the inquiry and require records within s 237(1)` TRUE
#ASSERT NOT (`the Director may make the inquiry and require records within s 237(1)` FALSE)
#ASSERT `the person has complied with the duty to respond within s 237(2)` TRUE TRUE
#ASSERT NOT (`the person has complied with the duty to respond within s 237(2)` TRUE FALSE)
#ASSERT `the person has complied with the duty to respond within s 237(2)` FALSE FALSE
