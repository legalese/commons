IMPORT prelude
IMPORT `cb1-part3-capacity`

-- Tests of cb1-part3-capacity.l4 (s 15 to s 18). Expected values are written from the text of the Act
-- (src:216-238), never from the code's output: each comment says what the text gives.

§ `Tests -- Part III capacity and powers`

§§ `s 15`

-- src:216: the capacity and, subject to this Act, the rights, powers and privileges of a natural person.
#ASSERT `the corporation has the right, power or privilege of a natural person within s 15(1)` TRUE FALSE
#ASSERT NOT (`the corporation has the right, power or privilege of a natural person within s 15(1)` TRUE TRUE)
#ASSERT NOT (`the corporation has the right, power or privilege of a natural person within s 15(1)` FALSE FALSE)
-- src:218
#ASSERT `the corporation may carry on business throughout Canada within s 15(2)` TRUE
#ASSERT NOT (`the corporation may carry on business throughout Canada within s 15(2)` FALSE)
-- src:220: outside Canada, to the extent that the laws there permit
#ASSERT `the corporation has the capacity to act in the jurisdiction outside Canada within s 15(3)` TRUE TRUE
#ASSERT NOT (`the corporation has the capacity to act in the jurisdiction outside Canada within s 15(3)` TRUE FALSE)

§§ `s 16`

-- src:222: a by-law is not necessary. The same answer whether or not one was passed.
#ASSERT `the corporation or its directors have the power within s 16(1)` TRUE FALSE
#ASSERT `the corporation or its directors have the power within s 16(1)` TRUE TRUE
#ASSERT NOT (`the corporation or its directors have the power within s 16(1)` FALSE TRUE)
-- src:224: shall not do what its articles restrict, nor act contrary to them.
#ASSERT `the corporation is forbidden to carry on the business or exercise the power within s 16(2)` TRUE FALSE
#ASSERT `the corporation is forbidden to carry on the business or exercise the power within s 16(2)` FALSE TRUE
#ASSERT NOT (`the corporation is forbidden to carry on the business or exercise the power within s 16(2)` FALSE FALSE)
-- src:226: no act is invalid by reason only that it is contrary to the articles or the Act.
#ASSERT NOT (`the act of the corporation is invalid within s 16(3)` TRUE FALSE)
#ASSERT `the act of the corporation is invalid within s 16(3)` TRUE TRUE
#ASSERT `the act of the corporation is invalid within s 16(3)` FALSE TRUE

§§ `s 17`

-- src:228: filing or availability for inspection, by itself, gives no notice.
#ASSERT NOT (`the person is affected by or deemed to have notice of the contents of the document within s 17` TRUE FALSE FALSE)
#ASSERT NOT (`the person is affected by or deemed to have notice of the contents of the document within s 17` FALSE TRUE FALSE)
#ASSERT NOT (`the person is affected by or deemed to have notice of the contents of the document within s 17` TRUE TRUE FALSE)
#ASSERT `the person is affected by or deemed to have notice of the contents of the document within s 17` TRUE TRUE TRUE

§§ `s 18`

-- src:230-236: the corporation or a guarantor may not assert any of the six against a person dealing with it.
#ASSERT `the assertion is barred against the person within s 18` `the articles, by-laws and any unanimous shareholder agreement have not been complied with` TRUE TRUE FALSE
#ASSERT `the assertion is barred against the person within s 18` `the persons named in the most recent notice sent to the Director under section 106 or 113 are not the directors of the corporation` TRUE TRUE FALSE
#ASSERT `the assertion is barred against the person within s 18` `the place named in the most recent notice sent to the Director under section 19 is not the registered office of the corporation` TRUE TRUE FALSE
#ASSERT `the assertion is barred against the person within s 18` `a person held out by the corporation as a director, officer, agent or mandatary has not been duly appointed or has no authority to exercise the customary or usual powers and duties` TRUE TRUE FALSE
#ASSERT `the assertion is barred against the person within s 18` `a document issued by a director, officer, agent or mandatary with actual or usual authority to issue it is not valid or genuine` TRUE TRUE FALSE
#ASSERT `the assertion is barred against the person within s 18` `a sale, lease or exchange of property referred to in subsection 189(3) was not authorized` TRUE TRUE FALSE
-- not an assertion s 18(1) lists
#ASSERT NOT (`the assertion is barred against the person within s 18` `any other assertion` TRUE TRUE FALSE)
-- src:238: not against a person who has, or ought to have, knowledge by virtue of their relationship to the corporation
#ASSERT NOT (`the assertion is barred against the person within s 18` `the articles, by-laws and any unanimous shareholder agreement have not been complied with` TRUE TRUE TRUE)
-- the one asserting is neither the corporation nor a guarantor: s 18(1) is not about it
#ASSERT NOT (`the assertion is barred against the person within s 18` `the articles, by-laws and any unanimous shareholder agreement have not been complied with` FALSE TRUE FALSE)
-- the person does not deal with the corporation and acquired nothing from it
#ASSERT NOT (`the assertion is barred against the person within s 18` `the articles, by-laws and any unanimous shareholder agreement have not been complied with` TRUE FALSE FALSE)
