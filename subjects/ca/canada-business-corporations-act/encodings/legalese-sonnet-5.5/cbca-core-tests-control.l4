IMPORT prelude
IMPORT `cbca-core`
IMPORT `cbca-core-control`

-- Tests for cbca-core-control.l4 (s 2(2) to (5)). Expected values are written from the words of the
-- definitions: control needs MORE THAN fifty per cent AND votes sufficient to elect a majority; a
-- subsidiary is controlled by the other body corporate alone (i), by it together with bodies it
-- controls (ii), or by two or more bodies it controls (iii), or is a subsidiary of a subsidiary (b).

§ `Tests -- control, subsidiary, holding body corporate, affiliated`

-- The test helper: one holding, with the body, who holds, whether they are bodies corporate, the
-- fraction of the votes to elect directors, and whether the votes suffice to elect a majority.
GIVEN body IS A STRING
      holders IS A LIST OF STRING
      bodies IS A BOOLEAN
      fraction IS A NUMBER
      sufficient IS A BOOLEAN
GIVETH A `Holding in a body corporate`
`a holding in` body holders bodies fraction sufficient MEANS
    `Holding in a body corporate` WITH
        `the body corporate` IS body
        `the persons holding` IS holders
        `the persons holding are bodies corporate` IS bodies
        `fraction of the votes to elect directors held, other than by way of security only` IS fraction
        `the votes held are sufficient, if exercised, to elect a majority of the directors` IS sufficient

§§ `s 2(3) control`

#ASSERT `controlled within s 2(3)` (`a holding in` "B" (LIST "A") TRUE (60%) TRUE)
-- "more than fifty per cent": exactly fifty is not more
#ASSERT (NOT `controlled within s 2(3)(a)` (`a holding in` "B" (LIST "A") TRUE (50%) TRUE))
#ASSERT (NOT `controlled within s 2(3)` (`a holding in` "B" (LIST "A") TRUE (50%) TRUE))
#ASSERT `controlled within s 2(3)` (`a holding in` "B" (LIST "A") TRUE 0.5001 TRUE)
-- limb (a) met and limb (b) not: the votes would not elect a majority of the directors
#ASSERT `controlled within s 2(3)(a)` (`a holding in` "B" (LIST "A") TRUE (60%) FALSE)
#ASSERT (NOT `controlled within s 2(3)(b)` (`a holding in` "B" (LIST "A") TRUE (60%) FALSE))
#ASSERT (NOT `controlled within s 2(3)` (`a holding in` "B" (LIST "A") TRUE (60%) FALSE))
-- limb (b) alone is not enough
#ASSERT (NOT `controlled within s 2(3)` (`a holding in` "B" (LIST "A") TRUE (40%) TRUE))
-- control "by two or more bodies corporate" together
#ASSERT `controlled within s 2(3)` (`a holding in` "Z" (LIST "M", "N") TRUE (60%) TRUE)

§§ `s 2(5) subsidiary and s 2(4) holding body corporate: a chain A > B > C`

`a chain of control A, B, C` MEANS LIST
    (`a holding in` "B" (LIST "A") TRUE (60%) TRUE),
    (`a holding in` "C" (LIST "B") TRUE (100%) TRUE)

-- (a)(i): controlled by that other body corporate
#ASSERT `subsidiary within s 2(5)(a)` `a chain of control A, B, C` "B" "A"
#ASSERT `subsidiary within s 2(5)(a)` `a chain of control A, B, C` "C" "B"
#ASSERT `subsidiary within s 2(5)` `a chain of control A, B, C` "B" "A"
#ASSERT `subsidiary within s 2(5)` `a chain of control A, B, C` "C" "B"
-- (b): a subsidiary of a body corporate that is a subsidiary of that other
#ASSERT (NOT `subsidiary within s 2(5)(a)` `a chain of control A, B, C` "C" "A")
#ASSERT `subsidiary within s 2(5)` `a chain of control A, B, C` "C" "A"
-- and not the other way round, nor of itself, nor of a stranger
#ASSERT (NOT `subsidiary within s 2(5)` `a chain of control A, B, C` "A" "C")
#ASSERT (NOT `subsidiary within s 2(5)` `a chain of control A, B, C` "A" "B")
#ASSERT (NOT `subsidiary within s 2(5)` `a chain of control A, B, C` "B" "B")
#ASSERT (NOT `subsidiary within s 2(5)` `a chain of control A, B, C` "C" "D")
-- s 2(4): A is the holding body corporate of B and, through B, of C
#ASSERT `holding body corporate within s 2(4)` `a chain of control A, B, C` "A" "B"
#ASSERT `holding body corporate within s 2(4)` `a chain of control A, B, C` "A" "C"
#ASSERT (NOT `holding body corporate within s 2(4)` `a chain of control A, B, C` "C" "A")
#ASSERT (count (`the bodies corporate above` `a chain of control A, B, C` "C")) EQUALS 2
#ASSERT (count (`the bodies corporate above` `a chain of control A, B, C` "A")) EQUALS 0

§§ `s 2(5): control that falls short`

`exactly fifty per cent` MEANS LIST (`a holding in` "B" (LIST "A") TRUE (50%) TRUE)
`sixty per cent but not enough to elect a majority` MEANS LIST (`a holding in` "B" (LIST "A") TRUE (60%) FALSE)

#ASSERT (NOT `subsidiary within s 2(5)` `exactly fifty per cent` "B" "A")
#ASSERT (NOT `subsidiary within s 2(5)` `sixty per cent but not enough to elect a majority` "B" "A")
#ASSERT (NOT `holding body corporate within s 2(4)` `exactly fifty per cent` "A" "B")

§§ `s 2(5)(a)(ii) and (iii): control together with, or by, bodies the other controls`

-- (ii) X is controlled by P and Q, and Q is controlled by P: X is a subsidiary of P, not of Q.
`P and a body P controls control X` MEANS LIST
    (`a holding in` "Q" (LIST "P") TRUE (100%) TRUE),
    (`a holding in` "X" (LIST "P", "Q") TRUE (70%) TRUE)

#ASSERT `subsidiary within s 2(5)(a)` `P and a body P controls control X` "X" "P"
#ASSERT `subsidiary within s 2(5)(a)` `P and a body P controls control X` "Q" "P"
#ASSERT (NOT `subsidiary within s 2(5)(a)` `P and a body P controls control X` "X" "Q")
#ASSERT (NOT `subsidiary within s 2(5)` `P and a body P controls control X` "P" "X")

-- (iii) Y is controlled by Q and R, each controlled by P: Y is a subsidiary of P, not of Q or R.
`two bodies P controls control Y` MEANS LIST
    (`a holding in` "Q" (LIST "P") TRUE (100%) TRUE),
    (`a holding in` "R" (LIST "P") TRUE (100%) TRUE),
    (`a holding in` "Y" (LIST "Q", "R") TRUE (60%) TRUE)

#ASSERT `subsidiary within s 2(5)(a)` `two bodies P controls control Y` "Y" "P"
#ASSERT (NOT `subsidiary within s 2(5)(a)` `two bodies P controls control Y` "Y" "Q")
#ASSERT (NOT `subsidiary within s 2(5)(a)` `two bodies P controls control Y` "Y" "R")

-- Two bodies corporate that nothing joins, controlling together: Z is controlled (s 2(3)) but is a
-- subsidiary of neither, because neither is controlled by the other.
`two unrelated bodies control Z` MEANS LIST (`a holding in` "Z" (LIST "M", "N") TRUE (60%) TRUE)

#ASSERT `controlled within s 2(3)` (`a holding in` "Z" (LIST "M", "N") TRUE (60%) TRUE)
#ASSERT (NOT `subsidiary within s 2(5)` `two unrelated bodies control Z` "Z" "M")
#ASSERT (NOT `subsidiary within s 2(5)` `two unrelated bodies control Z` "Z" "N")

-- One controller that is controlled by P, and is not P: W is a subsidiary of that controller (i), and of
-- P only through (b), not through (a).
`W is controlled by Q, which P controls` MEANS LIST
    (`a holding in` "Q" (LIST "P") TRUE (100%) TRUE),
    (`a holding in` "W" (LIST "Q") TRUE (100%) TRUE)

#ASSERT `subsidiary within s 2(5)(a)` `W is controlled by Q, which P controls` "W" "Q"
#ASSERT (NOT `subsidiary within s 2(5)(a)` `W is controlled by Q, which P controls` "W" "P")
#ASSERT `subsidiary within s 2(5)` `W is controlled by Q, which P controls` "W" "P"

§§ `A person who is not a body corporate`

-- Mr X, an individual, controls A: A is controlled, but is not a subsidiary of a body corporate by that.
`Mr X controls A` MEANS LIST (`a holding in` "A" (LIST "Mr X") FALSE (60%) TRUE)

#ASSERT `controlled within s 2(3)` (`a holding in` "A" (LIST "Mr X") FALSE (60%) TRUE)
#ASSERT (NOT `subsidiary within s 2(5)` `Mr X controls A` "A" "Mr X")
#ASSERT `controlled by alone` `Mr X controls A` "A" "Mr X"
#ASSERT (NOT `controlled by a body corporate alone` `Mr X controls A` "A" "Mr X")

§§ `A circular structure terminates`

`A and B hold each other` MEANS LIST
    (`a holding in` "B" (LIST "A") TRUE (60%) TRUE),
    (`a holding in` "A" (LIST "B") TRUE (60%) TRUE)

#ASSERT `subsidiary within s 2(5)` `A and B hold each other` "B" "A"
#ASSERT `subsidiary within s 2(5)` `A and B hold each other` "A" "B"
#ASSERT (NOT `subsidiary within s 2(5)` `A and B hold each other` "A" "C")

§§ `s 2(2) affiliated bodies corporate: the pairwise facts`

#ASSERT (NOT `affiliated within s 2(2)` FALSE FALSE FALSE FALSE)
#ASSERT `affiliated within s 2(2)` TRUE FALSE FALSE FALSE
#ASSERT `affiliated within s 2(2)` FALSE TRUE FALSE FALSE
#ASSERT `affiliated within s 2(2)` FALSE FALSE TRUE FALSE
#ASSERT `affiliated within s 2(2)` FALSE FALSE FALSE TRUE
#ASSERT `affiliated within s 2(2)(a)` FALSE FALSE TRUE
#ASSERT (NOT `affiliated within s 2(2)(a)` FALSE FALSE FALSE)
#ASSERT `affiliated within s 2(2)(b)` TRUE
#ASSERT (NOT `affiliated within s 2(2)(b)` FALSE)
#ASSERT `affiliate within s 2(1) by the facts` FALSE TRUE FALSE FALSE
#ASSERT (NOT `affiliate within s 2(1) by the facts` FALSE FALSE FALSE FALSE)

§§ `s 2(2) affiliated bodies corporate: from the holdings`

-- Parent and subsidiary (one is the subsidiary of the other).
`P controls S1 and S2` MEANS LIST
    (`a holding in` "S1" (LIST "P") TRUE (60%) TRUE),
    (`a holding in` "S2" (LIST "P") TRUE (60%) TRUE)

#ASSERT `affiliated by the holdings within s 2(2)(a)` `P controls S1 and S2` "P" "S1"
#ASSERT `affiliated by the holdings within s 2(2)(a)` `P controls S1 and S2` "S1" "P"
-- Both are subsidiaries of the same body corporate (siblings).
#ASSERT `both are subsidiaries of the same body corporate by` `P controls S1 and S2` "S1" "S2"
#ASSERT `affiliated by the holdings within s 2(2)(a)` `P controls S1 and S2` "S1" "S2"
#ASSERT `affiliate within s 2(1)` `P controls S1 and S2` "S1" "S2"
-- Two bodies with different parents are not affiliated.
`P controls S1 and Q controls S2` MEANS LIST
    (`a holding in` "S1" (LIST "P") TRUE (60%) TRUE),
    (`a holding in` "S2" (LIST "Q") TRUE (60%) TRUE)

#ASSERT (NOT `affiliated by the holdings within s 2(2)` `P controls S1 and Q controls S2` "S1" "S2")
#ASSERT (NOT `affiliate within s 2(1)` `P controls S1 and Q controls S2` "S1" "S2")
-- Each controlled by the same person, who is not a body corporate.
`Mr X controls W1 and W2` MEANS LIST
    (`a holding in` "W1" (LIST "Mr X") FALSE (60%) TRUE),
    (`a holding in` "W2" (LIST "Mr X") FALSE (60%) TRUE)

#ASSERT `each is controlled by the same person by` `Mr X controls W1 and W2` "W1" "W2"
#ASSERT `affiliated by the holdings within s 2(2)(a)` `Mr X controls W1 and W2` "W1" "W2"
#ASSERT (NOT `both are subsidiaries of the same body corporate by` `Mr X controls W1 and W2` "W1" "W2")

-- (b): A and C have the same controller (Mr X); D is C's subsidiary. A and D are each affiliated with
-- C, and nothing else joins them, so only (b) makes them affiliated with each other.
`Mr X controls A and C, and C controls D` MEANS LIST
    (`a holding in` "A" (LIST "Mr X") FALSE (60%) TRUE),
    (`a holding in` "C" (LIST "Mr X") FALSE (60%) TRUE),
    (`a holding in` "D" (LIST "C") TRUE (60%) TRUE)

#ASSERT `affiliated by the holdings within s 2(2)(a)` `Mr X controls A and C, and C controls D` "A" "C"
#ASSERT `affiliated by the holdings within s 2(2)(a)` `Mr X controls A and C, and C controls D` "C" "D"
#ASSERT (NOT `affiliated by the holdings within s 2(2)(a)` `Mr X controls A and C, and C controls D` "A" "D")
#ASSERT `affiliated by the holdings within s 2(2)` `Mr X controls A and C, and C controls D` "A" "D"
#ASSERT `affiliated by the holdings within s 2(2)` `Mr X controls A and C, and C controls D` "D" "A"
#ASSERT `affiliate within s 2(1)` `Mr X controls A and C, and C controls D` "A" "D"
-- a body corporate in no holding is affiliated with nothing, and nothing is affiliated with itself
#ASSERT (NOT `affiliated by the holdings within s 2(2)` `Mr X controls A and C, and C controls D` "A" "Z")
#ASSERT (NOT `affiliated by the holdings within s 2(2)` `Mr X controls A and C, and C controls D` "A" "A")

§§ `s 2(2)(b) deemed affiliation, taken again as an affiliation (fork F3 in NOTES.md)`

-- Mr X controls A and B, A controls A1, B controls B1. Each of A1-A, A-B and B-B1 is an affiliation by
-- (a). A1 and B1 have no body corporate in common that each is affiliated with by (a), so they are
-- affiliated with each other only if A1's deemed affiliation with B (through A) is itself taken as being
-- "affiliated with the same body corporate" as B1 is: the reading F3 takes.
`two small families under Mr X` MEANS LIST
    (`a holding in` "A" (LIST "Mr X") FALSE (60%) TRUE),
    (`a holding in` "B" (LIST "Mr X") FALSE (60%) TRUE),
    (`a holding in` "A1" (LIST "A") TRUE (60%) TRUE),
    (`a holding in` "B1" (LIST "B") TRUE (60%) TRUE)

#ASSERT `affiliated by the holdings within s 2(2)(a)` `two small families under Mr X` "A" "B"
#ASSERT `affiliated by the holdings within s 2(2)(a)` `two small families under Mr X` "A1" "A"
#ASSERT `affiliated by the holdings within s 2(2)(a)` `two small families under Mr X` "B" "B1"
#ASSERT (NOT `affiliated by the holdings within s 2(2)(a)` `two small families under Mr X` "A1" "B")
#ASSERT (NOT `affiliated by the holdings within s 2(2)(a)` `two small families under Mr X` "A1" "B1")
-- one step of (b)
#ASSERT `affiliated by the holdings within s 2(2)` `two small families under Mr X` "A1" "B"
#ASSERT `affiliated by the holdings within s 2(2)` `two small families under Mr X` "A" "B1"
-- two steps of (b): the closure
#ASSERT `affiliated by the holdings within s 2(2)` `two small families under Mr X` "A1" "B1"
#ASSERT `affiliated by the holdings within s 2(2)` `two small families under Mr X` "B1" "A1"
