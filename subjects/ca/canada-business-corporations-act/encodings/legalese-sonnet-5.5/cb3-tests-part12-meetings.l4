IMPORT prelude
IMPORT `cbca-core`
IMPORT `cb3-nouns`
IMPORT `cb3-part12-meetings`

-- Tests of cb3-part12-meetings.l4 (CBCA ss 132 to 136). Every expected value is written from the text of
-- the section, quoted in the module; none is copied from the module's own output.

§ `Tests of Part XII, meetings`

§§ `s 132(1) -- place of meeting`

-- arguments: the place is within Canada, the by-laws provide a place, the place is the by-laws', the place is the directors'
#ASSERT `the place of the meeting complies with s 132(1)` TRUE TRUE TRUE FALSE
-- the by-laws provide a place and the directors chose another: not "the place provided in the by-laws"
#ASSERT NOT `the place of the meeting complies with s 132(1)` TRUE TRUE FALSE TRUE
-- the by-laws are silent: the directors determine the place
#ASSERT `the place of the meeting complies with s 132(1)` TRUE FALSE FALSE TRUE
#ASSERT NOT `the place of the meeting complies with s 132(1)` TRUE FALSE TRUE FALSE
-- outside Canada, s 132(1) is not met
#ASSERT NOT `the place of the meeting complies with s 132(1)` FALSE TRUE TRUE FALSE
#ASSERT NOT `the place of the meeting complies with s 132(1)` FALSE FALSE FALSE TRUE

§§ `s 132(2) -- outside Canada`

-- arguments: the place is outside Canada, specified in the articles, all shareholders entitled to vote agree
#ASSERT `a meeting may be held outside Canada within s 132(2)` TRUE TRUE FALSE
#ASSERT `a meeting may be held outside Canada within s 132(2)` TRUE FALSE TRUE
#ASSERT `a meeting may be held outside Canada within s 132(2)` TRUE TRUE TRUE
#ASSERT NOT `a meeting may be held outside Canada within s 132(2)` TRUE FALSE FALSE
#ASSERT NOT `a meeting may be held outside Canada within s 132(2)` FALSE TRUE TRUE

§§ `s 132(3) -- a shareholder attending a meeting outside Canada`

-- arguments: attends a meeting held outside Canada, attends for the express purpose of objecting
#ASSERT `the shareholder is deemed to have agreed to the meeting being held outside Canada within s 132(3)` TRUE FALSE
#ASSERT NOT `the shareholder is deemed to have agreed to the meeting being held outside Canada within s 132(3)` TRUE TRUE
#ASSERT NOT `the shareholder is deemed to have agreed to the meeting being held outside Canada within s 132(3)` FALSE FALSE

§§ `s 132(4) -- participation by electronic means`

-- arguments: entitled to attend, the by-laws otherwise provide, the corporation makes a facility available, the
-- facility permits all participants to communicate adequately, in accordance with the regulations if any
#ASSERT `a person may participate by electronic means within s 132(4)` TRUE FALSE TRUE TRUE TRUE
#ASSERT NOT `a person may participate by electronic means within s 132(4)` FALSE FALSE TRUE TRUE TRUE
-- "unless the by-laws otherwise provide"
#ASSERT NOT `a person may participate by electronic means within s 132(4)` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT `a person may participate by electronic means within s 132(4)` TRUE FALSE FALSE TRUE TRUE
#ASSERT NOT `a person may participate by electronic means within s 132(4)` TRUE FALSE TRUE FALSE TRUE
#ASSERT NOT `a person may participate by electronic means within s 132(4)` TRUE FALSE TRUE TRUE FALSE
#ASSERT `a person participating by electronic means is present at the meeting within s 132(4)` TRUE
#ASSERT NOT `a person participating by electronic means is present at the meeting within s 132(4)` FALSE

§§ `s 132(5) -- a meeting held entirely by electronic means`

-- arguments: the directors or shareholders call the meeting pursuant to the Act, the by-laws so provide, the
-- facility permits adequate communication, in accordance with the regulations if any
#ASSERT `the callers may determine that the meeting is held entirely by electronic means within s 132(5)` TRUE TRUE TRUE TRUE
#ASSERT NOT `the callers may determine that the meeting is held entirely by electronic means within s 132(5)` FALSE TRUE TRUE TRUE
-- "if the by-laws so provide"
#ASSERT NOT `the callers may determine that the meeting is held entirely by electronic means within s 132(5)` TRUE FALSE TRUE TRUE
#ASSERT NOT `the callers may determine that the meeting is held entirely by electronic means within s 132(5)` TRUE TRUE FALSE TRUE
#ASSERT NOT `the callers may determine that the meeting is held entirely by electronic means within s 132(5)` TRUE TRUE TRUE FALSE

§§ `s 133(1)(a) -- the first annual meeting: eighteen months`

#ASSERT `the last day to call the first annual meeting within s 133(1)(a)` (YMD 2027 1 15) EQUALS (YMD 2028 7 15)
-- no 31 February: 31 August 2026 plus eighteen months falls in February 2028, a leap year (the keel's clamp)
#ASSERT `the last day to call the first annual meeting within s 133(1)(a)` (YMD 2026 8 31) EQUALS (YMD 2028 2 29)
-- arguments: the date the corporation comes into existence, the date the directors call the meeting
#ASSERT `the first annual meeting is called in time within s 133(1)(a)` (YMD 2027 1 15) (YMD 2028 7 15)
#ASSERT NOT `the first annual meeting is called in time within s 133(1)(a)` (YMD 2027 1 15) (YMD 2028 7 16)
#ASSERT `the first annual meeting is called in time within s 133(1)(a)` (YMD 2027 1 15) (YMD 2027 6 1)

§§ `s 133(1)(b) -- later annual meetings: the earlier of two limits`

-- arguments: the date the last annual meeting was held, the end of the preceding financial year
-- the last annual meeting 31 May 2027, the year ended 31 December 2027: fifteen months after the meeting is 31 August 2028,
-- six months after the year end is 30 June 2028; the earlier is 30 June 2028
#ASSERT `the last day to call a subsequent annual meeting within s 133(1)(b)` (YMD 2027 5 31) (YMD 2027 12 31) EQUALS (YMD 2028 6 30)
-- the last annual meeting 31 January 2027, the year ended 31 December 2027: fifteen months after is 30 April 2028
-- (no 31 April), six months after the year end is 30 June 2028; the earlier is 30 April 2028
#ASSERT `the last day to call a subsequent annual meeting within s 133(1)(b)` (YMD 2027 1 31) (YMD 2027 12 31) EQUALS (YMD 2028 4 30)
-- the two limits fall on the same day, 30 September 2028
#ASSERT `the last day to call a subsequent annual meeting within s 133(1)(b)` (YMD 2027 6 30) (YMD 2028 3 31) EQUALS (YMD 2028 9 30)
-- arguments: the last annual meeting, the preceding year end, the date the directors call the meeting
#ASSERT `a subsequent annual meeting is called in time within s 133(1)(b)` (YMD 2027 5 31) (YMD 2027 12 31) (YMD 2028 6 30)
#ASSERT NOT `a subsequent annual meeting is called in time within s 133(1)(b)` (YMD 2027 5 31) (YMD 2027 12 31) (YMD 2028 7 1)
#ASSERT `a subsequent annual meeting is called in time within s 133(1)(b)` (YMD 2027 1 31) (YMD 2027 12 31) (YMD 2028 4 30)
#ASSERT NOT `a subsequent annual meeting is called in time within s 133(1)(b)` (YMD 2027 1 31) (YMD 2027 12 31) (YMD 2028 5 1)

§§ `s 133(2), (3) -- special meetings; the court`

#ASSERT `the directors may call a special meeting at any time within s 133(2)` TRUE
#ASSERT NOT `the directors may call a special meeting at any time within s 133(2)` FALSE
-- arguments: the applicant is the corporation, the application is for an order extending the time for calling an annual meeting
#ASSERT `the corporation may apply to the court to extend the time for calling an annual meeting within s 133(3)` TRUE TRUE
#ASSERT NOT `the corporation may apply to the court to extend the time for calling an annual meeting within s 133(3)` FALSE TRUE
#ASSERT NOT `the corporation may apply to the court to extend the time for calling an annual meeting within s 133(3)` TRUE FALSE

§§ `s 134(1) -- fixing a record date`

-- arguments: the persons fixing the date are the directors, the date is fixed in advance, within the prescribed period
#ASSERT `the directors may fix a record date within s 134(1)` TRUE TRUE TRUE
#ASSERT NOT `the directors may fix a record date within s 134(1)` FALSE TRUE TRUE
#ASSERT NOT `the directors may fix a record date within s 134(1)` TRUE FALSE TRUE
#ASSERT NOT `the directors may fix a record date within s 134(1)` TRUE TRUE FALSE

§§ `s 134(2) -- no record date fixed`

-- (a)(i) the day immediately preceding the day on which the notice is given
-- arguments: the date notice is given (if given), the date the meeting is held
#ASSERT `the record date for notice of a meeting when none is fixed within s 134(2)(a)` (JUST (YMD 2027 6 15)) (YMD 2027 6 30) EQUALS (YMD 2027 6 14)
-- across a month end
#ASSERT `the record date for notice of a meeting when none is fixed within s 134(2)(a)` (JUST (YMD 2027 7 1)) (YMD 2027 8 15) EQUALS (YMD 2027 6 30)
-- across a leap day
#ASSERT `the record date for notice of a meeting when none is fixed within s 134(2)(a)` (JUST (YMD 2028 3 1)) (YMD 2028 4 1) EQUALS (YMD 2028 2 29)
-- (a)(ii) no notice is given: the day on which the meeting is held
#ASSERT `the record date for notice of a meeting when none is fixed within s 134(2)(a)` NOTHING (YMD 2027 6 30) EQUALS (YMD 2027 6 30)
-- (b) the day on which the directors pass the resolution relating to the purpose
#ASSERT `the record date for a purpose other than notice or voting when none is fixed within s 134(2)(b)` (YMD 2027 9 9) EQUALS (YMD 2027 9 9)
-- by purpose; arguments: the purpose, the date notice is given, the meeting date, the date of the directors' resolution
#ASSERT `the record date when none is fixed within s 134(2)` `a record date for receiving payment of a dividend` (JUST (YMD 2027 6 15)) (YMD 2027 6 30) (YMD 2027 3 3) EQUALS JUST (YMD 2027 3 3)
#ASSERT `the record date when none is fixed within s 134(2)` `a record date for participating in a liquidation distribution` (JUST (YMD 2027 6 15)) (YMD 2027 6 30) (YMD 2027 3 3) EQUALS JUST (YMD 2027 3 3)
#ASSERT `the record date when none is fixed within s 134(2)` `a record date for receiving notice of a meeting of shareholders` (JUST (YMD 2027 6 15)) (YMD 2027 6 30) (YMD 2027 3 3) EQUALS JUST (YMD 2027 6 14)
#ASSERT `the record date when none is fixed within s 134(2)` `a record date for any other purpose` (JUST (YMD 2027 6 15)) (YMD 2027 6 30) (YMD 2027 3 3) EQUALS JUST (YMD 2027 3 3)
-- voting: (a) is for notice and (b) expressly excludes voting, so the text gives no default (NOTHING, not a guess)
#ASSERT `the record date when none is fixed within s 134(2)` `a record date for voting at a meeting of shareholders` (JUST (YMD 2027 6 15)) (YMD 2027 6 30) (YMD 2027 3 3) EQUALS NOTHING

§§ `s 134(3) -- notice of a record date that is fixed`

-- arguments: a record date is fixed, every holder named in the register at close of business on the day has waived notice in writing
#ASSERT `notice of the record date must be given within s 134(3)` TRUE FALSE
#ASSERT NOT `notice of the record date must be given within s 134(3)` TRUE TRUE
#ASSERT NOT `notice of the record date must be given within s 134(3)` FALSE FALSE
-- arguments: within the prescribed period, the newspaper advertisement, the written notice to each stock exchange
#ASSERT `notice of the record date is given as s 134(3) requires within s 134(3)` TRUE TRUE TRUE
-- (a) "and" (b)
#ASSERT NOT `notice of the record date is given as s 134(3) requires within s 134(3)` TRUE TRUE FALSE
#ASSERT NOT `notice of the record date is given as s 134(3) requires within s 134(3)` TRUE FALSE TRUE
#ASSERT NOT `notice of the record date is given as s 134(3) requires within s 134(3)` FALSE TRUE TRUE

§§ `s 135(1), (1.1) -- notice of a meeting`

-- arguments: the person is a shareholder entitled to vote, a director, the auditor
#ASSERT `notice of the meeting is owed to a person within s 135(1)` TRUE FALSE FALSE
#ASSERT `notice of the meeting is owed to a person within s 135(1)` FALSE TRUE FALSE
#ASSERT `notice of the meeting is owed to a person within s 135(1)` FALSE FALSE TRUE
#ASSERT NOT `notice of the meeting is owed to a person within s 135(1)` FALSE FALSE FALSE
-- arguments: sent within the prescribed period, the corporation is a distributing corporation, the articles or by-laws
-- specify a shorter period, sent within the shorter period
#ASSERT `the notice of the meeting was sent in time within s 135(1) and (1.1)` TRUE TRUE FALSE FALSE
#ASSERT `the notice of the meeting was sent in time within s 135(1) and (1.1)` FALSE FALSE TRUE TRUE
-- a distributing corporation has no shorter period
#ASSERT NOT `the notice of the meeting was sent in time within s 135(1) and (1.1)` FALSE TRUE TRUE TRUE
-- no shorter period is specified
#ASSERT NOT `the notice of the meeting was sent in time within s 135(1) and (1.1)` FALSE FALSE FALSE TRUE
-- a shorter period is specified and the notice missed it
#ASSERT NOT `the notice of the meeting was sent in time within s 135(1) and (1.1)` FALSE FALSE TRUE FALSE

§§ `s 135(2) -- shareholders not registered; failure to receive`

#ASSERT `notice need not be sent to the shareholder within s 135(2)` FALSE
#ASSERT NOT `notice need not be sent to the shareholder within s 135(2)` TRUE
-- arguments: entitled to vote at the meeting, received the notice
#ASSERT `the shareholder keeps the right to vote without having received notice within s 135(2)` TRUE FALSE
#ASSERT `the shareholder keeps the right to vote without having received notice within s 135(2)` TRUE TRUE
#ASSERT NOT `the shareholder keeps the right to vote without having received notice within s 135(2)` FALSE FALSE

§§ `s 135(3), (4) -- adjournment`

-- arguments: the days adjourned in aggregate, the by-laws otherwise provide
#ASSERT `notice of the adjourned meeting other than by announcement is unnecessary within s 135(3)` 29 FALSE
#ASSERT `notice of the adjourned meeting other than by announcement is unnecessary within s 135(3)` 0 FALSE
#ASSERT NOT `notice of the adjourned meeting other than by announcement is unnecessary within s 135(3)` 30 FALSE
#ASSERT NOT `notice of the adjourned meeting other than by announcement is unnecessary within s 135(3)` 29 TRUE
#ASSERT NOT `notice of the adjourned meeting is required as for an original meeting within s 135(4)` 29
#ASSERT `notice of the adjourned meeting is required as for an original meeting within s 135(4)` 30
#ASSERT `notice of the adjourned meeting is required as for an original meeting within s 135(4)` 31
-- "more than ninety days": ninety is not more
#ASSERT NOT `subsection 149(1) applies to the adjourned meeting within s 135(4)` 30
#ASSERT NOT `subsection 149(1) applies to the adjourned meeting within s 135(4)` 90
#ASSERT `subsection 149(1) applies to the adjourned meeting within s 135(4)` 91
#ASSERT NOT `subsection 149(1) applies to the adjourned meeting within s 135(4)` 29

§§ `s 135(5) -- special business`

-- arguments: a special meeting, business is the financial statements, the auditor's report, the election of directors,
-- the re-appointment of the incumbent auditor
-- everything at a special meeting
#ASSERT `the business is deemed to be special business within s 135(5)` TRUE FALSE FALSE FALSE FALSE
#ASSERT `the business is deemed to be special business within s 135(5)` TRUE TRUE FALSE FALSE FALSE
-- at an annual meeting, anything but the four named items
#ASSERT `the business is deemed to be special business within s 135(5)` FALSE FALSE FALSE FALSE FALSE
#ASSERT NOT `the business is deemed to be special business within s 135(5)` FALSE TRUE FALSE FALSE FALSE
#ASSERT NOT `the business is deemed to be special business within s 135(5)` FALSE FALSE TRUE FALSE FALSE
#ASSERT NOT `the business is deemed to be special business within s 135(5)` FALSE FALSE FALSE TRUE FALSE
#ASSERT NOT `the business is deemed to be special business within s 135(5)` FALSE FALSE FALSE FALSE TRUE

§§ `s 135(6) -- the content of a notice of special business`

-- arguments: special business is to be transacted, the notice states its nature in sufficient detail, a special
-- resolution is to be submitted, the notice states its text
#ASSERT `the notice of the meeting has the content s 135(6) requires within s 135(6)` TRUE TRUE FALSE FALSE
#ASSERT `the notice of the meeting has the content s 135(6) requires within s 135(6)` TRUE TRUE TRUE TRUE
#ASSERT NOT `the notice of the meeting has the content s 135(6) requires within s 135(6)` TRUE TRUE TRUE FALSE
#ASSERT NOT `the notice of the meeting has the content s 135(6) requires within s 135(6)` TRUE FALSE FALSE FALSE
#ASSERT NOT `the notice of the meeting has the content s 135(6) requires within s 135(6)` TRUE FALSE TRUE TRUE
-- no special business: s 135(6) asks nothing of the notice
#ASSERT `the notice of the meeting has the content s 135(6) requires within s 135(6)` FALSE FALSE FALSE FALSE

§§ `s 136 -- waiver of notice`

#ASSERT `a person may waive notice of the meeting within s 136` TRUE
#ASSERT NOT `a person may waive notice of the meeting within s 136` FALSE
-- arguments: entitled to attend, attends, attends for the express purpose of objecting
#ASSERT `attendance is a waiver of notice within s 136` TRUE TRUE FALSE
#ASSERT NOT `attendance is a waiver of notice within s 136` TRUE TRUE TRUE
#ASSERT NOT `attendance is a waiver of notice within s 136` TRUE FALSE FALSE
#ASSERT NOT `attendance is a waiver of notice within s 136` FALSE TRUE FALSE
