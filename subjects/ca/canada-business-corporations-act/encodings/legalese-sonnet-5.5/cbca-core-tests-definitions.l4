#ASSERT (NOT `associate within s 2(1)` `a stranger`)
-- (a) "more than ten per cent": exactly ten is not more.
#ASSERT (NOT `associate within s 2(1)(a)` `a company with 10 per cent`)
#ASSERT `associate within s 2(1)(a)` `a company with 11 per cent`
#ASSERT `associate within s 2(1)` `a company with 11 per cent`
#ASSERT (NOT `associate within s 2(1)(a)` `a non-company with 60 per cent`)
-- (b)
#ASSERT `associate within s 2(1)(b)` `a partner acting for the firm`
#ASSERT `associate within s 2(1)` `a partner acting for the firm`
-- (c) a substantial beneficial interest, or serving as trustee or liquidator or similar
#ASSERT `associate within s 2(1)(c)` `a trust with a substantial interest`
#ASSERT `associate within s 2(1)(c)` `an estate the person serves as trustee of`
#ASSERT (NOT `associate within s 2(1)(c)` `a stranger`)
-- (d) a spouse; or a conjugal cohabitant who has cohabited for at least one year
#ASSERT `associate within s 2(1)(d)` `a spouse`
#ASSERT `associate within s 2(1)(d)` `a cohabitant of one year`
#ASSERT (NOT `associate within s 2(1)(d)` `a cohabitant of 11 months`)
#ASSERT (NOT `associate within s 2(1)` `a cohabitant of 11 months`)
-- (e) a child of the person or of the (d) spouse or individual
#ASSERT `associate within s 2(1)(e)` `a child of the person`
#ASSERT `associate within s 2(1)(e)` `a child of the spouse`
-- (f) a relative with the same residence as the person
#ASSERT `associate within s 2(1)(f)` `a relative at the same address`
#ASSERT (NOT `associate within s 2(1)(f)` `a relative elsewhere`)
#ASSERT `associate within s 2(1)(f)` `a relative of the spouse at the same address`
#ASSERT (NOT `associate within s 2(1)(f)` `a non-relative at the same address`)
#ASSERT `associate within s 2(1)` `a relative of the spouse at the same address`
#ASSERT (NOT `associate within s 2(1)` `a relative elsewhere`)

