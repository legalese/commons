§§ `s 2(1) squeeze-out transaction`

-- arguments: by a corporation, the corporation is distributing, needs an amendment to the articles, terminates a holder's
-- interest without consent, equivalent value substituted, in shares of the corporation, with equal or greater rights
#ASSERT `squeeze-out transaction within s 2(1)` TRUE FALSE TRUE TRUE FALSE FALSE FALSE
#ASSERT (NOT `squeeze-out transaction within s 2(1)` TRUE TRUE TRUE TRUE FALSE FALSE FALSE)
#ASSERT (NOT `squeeze-out transaction within s 2(1)` TRUE FALSE FALSE TRUE FALSE FALSE FALSE)
#ASSERT (NOT `squeeze-out transaction within s 2(1)` TRUE FALSE TRUE FALSE FALSE FALSE FALSE)
-- an interest of equivalent value in the corporation's own shares with equal or greater rights: not a squeeze-out
#ASSERT (NOT `squeeze-out transaction within s 2(1)` TRUE FALSE TRUE TRUE TRUE TRUE TRUE)
-- substitution that fails any of its three limbs leaves it a squeeze-out
#ASSERT `squeeze-out transaction within s 2(1)` TRUE FALSE TRUE TRUE TRUE TRUE FALSE
#ASSERT `squeeze-out transaction within s 2(1)` TRUE FALSE TRUE TRUE TRUE FALSE TRUE
#ASSERT `squeeze-out transaction within s 2(1)` TRUE FALSE TRUE TRUE FALSE TRUE TRUE

