IMPORT prelude
IMPORT `cbca-core`
IMPORT `cbca-core-definitions`

-- Tests for cbca-core-definitions.l4 (s 2(1), 2(6), 2(7), 2(8)). Every expected value is written from
-- the words of the definition it tests, on both sides of each boundary the words draw ("more than ten
-- per cent", "at least one year", "not less than two-thirds", "for more than one year").

§ `Tests -- section 2 definitions`

§§ `s 2(1) affairs`

#ASSERT `affairs within s 2(1)` TRUE FALSE
#ASSERT (NOT `affairs within s 2(1)` TRUE TRUE)
#ASSERT (NOT `affairs within s 2(1)` FALSE FALSE)

§§ `s 2(1) articles: the nine kinds, and any amendment to them`

#ASSERT `articles within s 2(1)` (JUST `articles of revival`) FALSE
#ASSERT `articles within s 2(1)` (JUST `the original articles of incorporation`) FALSE
#ASSERT `articles within s 2(1)` NOTHING TRUE
#ASSERT (NOT `articles within s 2(1)` NOTHING FALSE)

