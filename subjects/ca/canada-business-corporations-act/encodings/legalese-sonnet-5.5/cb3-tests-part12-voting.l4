IMPORT prelude
IMPORT `cbca-core`
IMPORT `cb3-part12-voting`

-- Tests of cb3-part12-voting.l4 (CBCA ss 138 to 142). Every expected value is written from the text of the
-- sections, quoted in the module; none is copied from the module's own output.

§ `Tests of Part XII, lists, quorum, voting, written resolutions`


§§ `s 138(1) -- the list of shareholders entitled to receive notice`

-- arguments: the record date fixed under 134(1)(c) if any, the record date established under 134(2)(a)
#ASSERT `the last day to prepare the list of shareholders entitled to receive notice within s 138(1)` (JUST (YearMonthDay 2027 3 1)) (YearMonthDay 2027 3 20) EQUALS (YearMonthDay 2027 3 11)
-- ten days after 25 February 2027 (not a leap year) is 7 March
#ASSERT `the last day to prepare the list of shareholders entitled to receive notice within s 138(1)` (JUST (YearMonthDay 2027 2 25)) (YearMonthDay 2027 3 20) EQUALS (YearMonthDay 2027 3 7)
-- no record date fixed: on the record date established under 134(2)(a)
#ASSERT `the last day to prepare the list of shareholders entitled to receive notice within s 138(1)` NOTHING (YearMonthDay 2027 3 20) EQUALS (YearMonthDay 2027 3 20)
-- arguments: the fixed date, the established date, the date the list was prepared, alphabetical, shows the number of shares
#ASSERT `the list of shareholders entitled to receive notice complies with s 138(1)` (JUST (YearMonthDay 2027 3 1)) (YearMonthDay 2027 3 20) (YearMonthDay 2027 3 11) TRUE TRUE
#ASSERT `the list of shareholders entitled to receive notice complies with s 138(1)` (JUST (YearMonthDay 2027 3 1)) (YearMonthDay 2027 3 20) (YearMonthDay 2027 3 1) TRUE TRUE
#ASSERT NOT `the list of shareholders entitled to receive notice complies with s 138(1)` (JUST (YearMonthDay 2027 3 1)) (YearMonthDay 2027 3 20) (YearMonthDay 2027 3 12) TRUE TRUE
#ASSERT `the list of shareholders entitled to receive notice complies with s 138(1)` NOTHING (YearMonthDay 2027 3 20) (YearMonthDay 2027 3 20) TRUE TRUE
-- (b) says ON the record date: a day early or a day late is not on it (fork F-138-1b)
#ASSERT NOT `the list of shareholders entitled to receive notice complies with s 138(1)` NOTHING (YearMonthDay 2027 3 20) (YearMonthDay 2027 3 19) TRUE TRUE
#ASSERT NOT `the list of shareholders entitled to receive notice complies with s 138(1)` NOTHING (YearMonthDay 2027 3 20) (YearMonthDay 2027 3 21) TRUE TRUE
#ASSERT NOT `the list of shareholders entitled to receive notice complies with s 138(1)` (JUST (YearMonthDay 2027 3 1)) (YearMonthDay 2027 3 20) (YearMonthDay 2027 3 11) FALSE TRUE
#ASSERT NOT `the list of shareholders entitled to receive notice complies with s 138(1)` (JUST (YearMonthDay 2027 3 1)) (YearMonthDay 2027 3 20) (YearMonthDay 2027 3 11) TRUE FALSE

§§ `s 138(2), (3) -- the list of shareholders entitled to vote`

-- arguments: the record date for voting fixed under 134(1)(d) if any, the record date fixed under 134(1)(c) if any, the date established under 134(2)(a)
-- (2): ten days after the voting record date, whatever the others are
#ASSERT `the last day to prepare the list of shareholders entitled to vote within s 138(2) and (3)` (JUST (YearMonthDay 2027 4 1)) (JUST (YearMonthDay 2027 3 1)) (YearMonthDay 2027 3 20) EQUALS (YearMonthDay 2027 4 11)
-- (3): no voting record date, a record date fixed for notice: ten days after that
#ASSERT `the last day to prepare the list of shareholders entitled to vote within s 138(2) and (3)` NOTHING (JUST (YearMonthDay 2027 3 1)) (YearMonthDay 2027 3 20) EQUALS (YearMonthDay 2027 3 11)
-- (3): no record date fixed at all: not later than the date established under 134(2)(a)
#ASSERT `the last day to prepare the list of shareholders entitled to vote within s 138(2) and (3)` NOTHING NOTHING (YearMonthDay 2027 3 20) EQUALS (YearMonthDay 2027 3 20)
-- arguments: those three, the date the list was prepared, alphabetical, shows the number of shares
#ASSERT `the list of shareholders entitled to vote complies with s 138(2) and (3)` (JUST (YearMonthDay 2027 4 1)) (JUST (YearMonthDay 2027 3 1)) (YearMonthDay 2027 3 20) (YearMonthDay 2027 4 11) TRUE TRUE
#ASSERT NOT `the list of shareholders entitled to vote complies with s 138(2) and (3)` (JUST (YearMonthDay 2027 4 1)) (JUST (YearMonthDay 2027 3 1)) (YearMonthDay 2027 3 20) (YearMonthDay 2027 4 12) TRUE TRUE
#ASSERT `the list of shareholders entitled to vote complies with s 138(2) and (3)` NOTHING (JUST (YearMonthDay 2027 3 1)) (YearMonthDay 2027 3 20) (YearMonthDay 2027 3 11) TRUE TRUE
#ASSERT NOT `the list of shareholders entitled to vote complies with s 138(2) and (3)` NOTHING (JUST (YearMonthDay 2027 3 1)) (YearMonthDay 2027 3 20) (YearMonthDay 2027 3 12) TRUE TRUE
#ASSERT `the list of shareholders entitled to vote complies with s 138(2) and (3)` NOTHING NOTHING (YearMonthDay 2027 3 20) (YearMonthDay 2027 3 20) TRUE TRUE
-- not later than the established date: earlier is in time here
#ASSERT `the list of shareholders entitled to vote complies with s 138(2) and (3)` NOTHING NOTHING (YearMonthDay 2027 3 20) (YearMonthDay 2027 3 19) TRUE TRUE
#ASSERT NOT `the list of shareholders entitled to vote complies with s 138(2) and (3)` NOTHING NOTHING (YearMonthDay 2027 3 20) (YearMonthDay 2027 3 21) TRUE TRUE
#ASSERT NOT `the list of shareholders entitled to vote complies with s 138(2) and (3)` NOTHING NOTHING (YearMonthDay 2027 3 20) (YearMonthDay 2027 3 20) FALSE TRUE
#ASSERT NOT `the list of shareholders entitled to vote complies with s 138(2) and (3)` NOTHING NOTHING (YearMonthDay 2027 3 20) (YearMonthDay 2027 3 20) TRUE FALSE

§§ `s 138(3.1) -- entitlement to vote the shares shown`

#ASSERT `the shares the shareholder may vote at the meeting within s 138(3.1)` TRUE 500 EQUALS JUST 500
-- a shareholder not on the list: the section does not say, so NOTHING (not nought shares)
#ASSERT `the shares the shareholder may vote at the meeting within s 138(3.1)` FALSE 500 EQUALS NOTHING

§§ `s 138(4) -- examination of the list`

-- arguments: the person is a shareholder, during usual business hours, at the registered office or the place of the central register, at the meeting
#ASSERT `a shareholder may examine the list within s 138(4)` TRUE TRUE TRUE FALSE
#ASSERT `a shareholder may examine the list within s 138(4)` TRUE FALSE FALSE TRUE
#ASSERT NOT `a shareholder may examine the list within s 138(4)` TRUE FALSE TRUE FALSE
#ASSERT NOT `a shareholder may examine the list within s 138(4)` TRUE TRUE FALSE FALSE
#ASSERT NOT `a shareholder may examine the list within s 138(4)` FALSE TRUE TRUE TRUE
#ASSERT NOT `a shareholder may examine the list within s 138(4)` TRUE FALSE FALSE FALSE

§§ `s 139(1) -- quorum`

-- arguments: the by-laws otherwise provide, the by-laws' quorum is present, shares present, shares entitled to vote
#ASSERT `a quorum of shareholders is present within s 139(1)` FALSE FALSE 501 1000
-- exactly half is not a majority (fork F-139-tie)
#ASSERT NOT `a quorum of shareholders is present within s 139(1)` FALSE FALSE 500 1000
#ASSERT NOT `a quorum of shareholders is present within s 139(1)` FALSE FALSE 499 1000
#ASSERT `a quorum of shareholders is present within s 139(1)` FALSE FALSE 1 1
#ASSERT NOT `a quorum of shareholders is present within s 139(1)` FALSE FALSE 0 0
-- the by-laws otherwise provide: their rule governs, whatever the shares present
#ASSERT `a quorum of shareholders is present within s 139(1)` TRUE TRUE 1 1000
#ASSERT NOT `a quorum of shareholders is present within s 139(1)` TRUE FALSE 999 1000
-- irrespective of the number of persons present: only shares count
#ASSERT `a quorum of shareholders is present within s 139(1)` FALSE FALSE 6 10

§§ `s 139(2), (3), (4) -- the opening quorum, adjournment, one shareholder`

#ASSERT `the shareholders present may proceed with the business within s 139(2)` TRUE FALSE
#ASSERT NOT `the shareholders present may proceed with the business within s 139(2)` TRUE TRUE
#ASSERT NOT `the shareholders present may proceed with the business within s 139(2)` FALSE FALSE
#ASSERT `the shareholders present may adjourn the meeting to a fixed time and place within s 139(3)` FALSE
#ASSERT NOT `the shareholders present may adjourn the meeting to a fixed time and place within s 139(3)` TRUE
#ASSERT `the shareholders present may transact other business within s 139(3)` FALSE EQUALS JUST FALSE
-- a quorum at the opening: s 139(3) is silent, so NOTHING
#ASSERT `the shareholders present may transact other business within s 139(3)` TRUE EQUALS NOTHING
#ASSERT `the shareholder present constitutes a meeting within s 139(4)` TRUE TRUE
#ASSERT NOT `the shareholder present constitutes a meeting within s 139(4)` TRUE FALSE
#ASSERT NOT `the shareholder present constitutes a meeting within s 139(4)` FALSE TRUE

§§ `s 140(1) -- one vote a share`

-- arguments: the articles otherwise provide, the votes per share they provide if any
#ASSERT `the votes each share carries within s 140(1)` FALSE NOTHING EQUALS JUST 1
#ASSERT `the votes each share carries within s 140(1)` FALSE (JUST 5) EQUALS JUST 1
#ASSERT `the votes each share carries within s 140(1)` TRUE (JUST 10) EQUALS JUST 10
-- non-voting shares: the articles provide none
#ASSERT `the votes each share carries within s 140(1)` TRUE (JUST 0) EQUALS JUST 0
#ASSERT `the votes each share carries within s 140(1)` TRUE NOTHING EQUALS NOTHING
-- arguments: the number of shares held, the votes each share carries
#ASSERT `the votes a holder may cast within s 140(1)` 100 (JUST 1) EQUALS JUST 100
#ASSERT `the votes a holder may cast within s 140(1)` 100 (JUST 10) EQUALS JUST 1000
#ASSERT `the votes a holder may cast within s 140(1)` 100 NOTHING EQUALS NOTHING
#ASSERT `the votes a holder may cast within s 140(1)` 0 (JUST 1) EQUALS JUST 0

§§ `s 140(2), (3), (4) -- representatives and joint holders`

#ASSERT `the corporation must recognize the individual as the representative within s 140(2)` TRUE TRUE
#ASSERT NOT `the corporation must recognize the individual as the representative within s 140(2)` TRUE FALSE
#ASSERT NOT `the corporation must recognize the individual as the representative within s 140(2)` FALSE TRUE
#ASSERT `the representative may exercise all the powers of an individual shareholder within s 140(3)` TRUE
#ASSERT NOT `the representative may exercise all the powers of an individual shareholder within s 140(3)` FALSE
-- arguments: the by-laws otherwise provide, the shares are held jointly, the number of those holders present
#ASSERT `one joint holder present may vote the shares in the absence of the others within s 140(4)` FALSE TRUE 1
#ASSERT NOT `one joint holder present may vote the shares in the absence of the others within s 140(4)` FALSE TRUE 2
#ASSERT NOT `one joint holder present may vote the shares in the absence of the others within s 140(4)` FALSE TRUE 0
#ASSERT NOT `one joint holder present may vote the shares in the absence of the others within s 140(4)` TRUE TRUE 1
#ASSERT NOT `one joint holder present may vote the shares in the absence of the others within s 140(4)` FALSE FALSE 1
-- arguments: the by-laws otherwise provide, the shares are held jointly, the number of those present who vote
#ASSERT `the joint holders who vote must vote as one within s 140(4)` FALSE TRUE 2
#ASSERT `the joint holders who vote must vote as one within s 140(4)` FALSE TRUE 3
#ASSERT NOT `the joint holders who vote must vote as one within s 140(4)` FALSE TRUE 1
#ASSERT NOT `the joint holders who vote must vote as one within s 140(4)` TRUE TRUE 2
#ASSERT NOT `the joint holders who vote must vote as one within s 140(4)` FALSE FALSE 2

§§ `s 141 -- voting`

-- arguments: the by-laws otherwise provide, a ballot is demanded by a shareholder or proxyholder entitled to vote
#ASSERT `voting is by show of hands within s 141(1)` FALSE FALSE
#ASSERT NOT `voting is by show of hands within s 141(1)` FALSE TRUE
#ASSERT NOT `voting is by show of hands within s 141(1)` TRUE FALSE
#ASSERT NOT `voting is by show of hands within s 141(1)` TRUE TRUE
-- arguments: the person is a shareholder or proxyholder, the demand is before or after a vote by show of hands
#ASSERT `a ballot may be demanded within s 141(2)` TRUE TRUE
#ASSERT NOT `a ballot may be demanded within s 141(2)` TRUE FALSE
#ASSERT NOT `a ballot may be demanded within s 141(2)` FALSE TRUE
-- arguments: the by-laws otherwise provide, the corporation makes a facility available, in accordance with the regulations if any
#ASSERT `a vote may be held entirely by electronic means within s 141(3)` FALSE TRUE TRUE
#ASSERT NOT `a vote may be held entirely by electronic means within s 141(3)` TRUE TRUE TRUE
#ASSERT NOT `a vote may be held entirely by electronic means within s 141(3)` FALSE FALSE TRUE
#ASSERT NOT `a vote may be held entirely by electronic means within s 141(3)` FALSE TRUE FALSE
-- arguments: participates under 132(4) or (5), entitled to vote, the by-laws otherwise provide, a facility is made available for voting, in accordance with the regulations if any
#ASSERT `a participant may vote by the facility within s 141(4)` TRUE TRUE FALSE TRUE TRUE
#ASSERT NOT `a participant may vote by the facility within s 141(4)` FALSE TRUE FALSE TRUE TRUE
#ASSERT NOT `a participant may vote by the facility within s 141(4)` TRUE FALSE FALSE TRUE TRUE
#ASSERT NOT `a participant may vote by the facility within s 141(4)` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT `a participant may vote by the facility within s 141(4)` TRUE TRUE FALSE FALSE TRUE
#ASSERT NOT `a participant may vote by the facility within s 141(4)` TRUE TRUE FALSE TRUE FALSE

§§ `s 142(1) -- written resolutions`

-- arguments: a director's statement under 110(2), an auditor's statement under 168(5), in writing, signed by all the shareholders entitled to vote on it
#ASSERT `a written resolution is as valid as if passed at a meeting within s 142(1)(a)` FALSE FALSE TRUE TRUE
#ASSERT NOT `a written resolution is as valid as if passed at a meeting within s 142(1)(a)` TRUE FALSE TRUE TRUE
#ASSERT NOT `a written resolution is as valid as if passed at a meeting within s 142(1)(a)` FALSE TRUE TRUE TRUE
#ASSERT NOT `a written resolution is as valid as if passed at a meeting within s 142(1)(a)` FALSE FALSE FALSE TRUE
#ASSERT NOT `a written resolution is as valid as if passed at a meeting within s 142(1)(a)` FALSE FALSE TRUE FALSE
-- (b) arguments: the two statements, in writing, deals with all matters required to be dealt with at a meeting, signed by all entitled to vote at that meeting
#ASSERT `a written resolution satisfies the requirements relating to meetings within s 142(1)(b)` FALSE FALSE TRUE TRUE TRUE
#ASSERT NOT `a written resolution satisfies the requirements relating to meetings within s 142(1)(b)` TRUE FALSE TRUE TRUE TRUE
#ASSERT NOT `a written resolution satisfies the requirements relating to meetings within s 142(1)(b)` FALSE TRUE TRUE TRUE TRUE
#ASSERT NOT `a written resolution satisfies the requirements relating to meetings within s 142(1)(b)` FALSE FALSE FALSE TRUE TRUE
#ASSERT NOT `a written resolution satisfies the requirements relating to meetings within s 142(1)(b)` FALSE FALSE TRUE FALSE TRUE
#ASSERT NOT `a written resolution satisfies the requirements relating to meetings within s 142(1)(b)` FALSE FALSE TRUE TRUE FALSE

§§ `s 142(2), (3) -- keeping the resolution; the minutes as proof`

#ASSERT `the corporation must keep a copy of the resolution with the minutes within s 142(2)` TRUE
#ASSERT NOT `the corporation must keep a copy of the resolution with the minutes within s 142(2)` FALSE
#ASSERT `the duty to keep a copy of the resolution is met within s 142(2)` TRUE TRUE
#ASSERT NOT `the duty to keep a copy of the resolution is met within s 142(2)` TRUE FALSE
#ASSERT `the duty to keep a copy of the resolution is met within s 142(2)` FALSE FALSE
-- arguments: a ballot is demanded, the minutes have the entry, there is evidence to the contrary
#ASSERT `the minutes entry is proof of the declaration within s 142(3)` FALSE TRUE FALSE
#ASSERT NOT `the minutes entry is proof of the declaration within s 142(3)` TRUE TRUE FALSE
#ASSERT NOT `the minutes entry is proof of the declaration within s 142(3)` FALSE FALSE FALSE
#ASSERT NOT `the minutes entry is proof of the declaration within s 142(3)` FALSE TRUE TRUE
