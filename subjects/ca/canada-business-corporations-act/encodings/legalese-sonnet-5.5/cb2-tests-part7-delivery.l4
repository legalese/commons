#ASSERT `the person has a right to reclaim possession of the security within s 72(2)` FALSE FALSE TRUE TRUE
#ASSERT `the person has a right to reclaim possession of the security within s 72(2)` TRUE TRUE TRUE TRUE
#ASSERT NOT (`the person has a right to reclaim possession of the security within s 72(2)` TRUE TRUE FALSE FALSE)
#ASSERT NOT (`the person has a right to reclaim possession of the security within s 72(2)` FALSE FALSE TRUE FALSE)
#ASSERT NOT (`the person has a right to reclaim possession of the security within s 72(2)` FALSE FALSE FALSE TRUE)
#ASSERT NOT (`the person has a right to reclaim possession of the security within s 72(2)` FALSE FALSE FALSE FALSE)
#ASSERT `the right to reclaim possession may be specifically enforced, the transfer restrained and the security impounded or sequestrated pending litigation within s 72(3)` TRUE FALSE FALSE FALSE
#ASSERT `the right to reclaim possession may be specifically enforced, the transfer restrained and the security impounded or sequestrated pending litigation within s 72(3)` FALSE FALSE TRUE TRUE
#ASSERT NOT (`the right to reclaim possession may be specifically enforced, the transfer restrained and the security impounded or sequestrated pending litigation within s 72(3)` TRUE TRUE FALSE FALSE)
#ASSERT NOT (`the right to reclaim possession may be specifically enforced, the transfer restrained and the security impounded or sequestrated pending litigation within s 72(3)` FALSE FALSE FALSE FALSE)

