IMPORT prelude
IMPORT `cbca-core`
IMPORT `cb2-nouns`
IMPORT `cb2-part7-delivery`

-- Tests of cb2-part7-delivery.l4 (ss 70 to 75). Every expected value is written from the text of the
-- provision named beside it, not from the output of the rule. GENERATED by inputs/work/gen/delivery_tests.py.

§ `Tests of ss 70 to 75`

§§ `s 70(1): delivery to a purchaser occurs`
-- args: (a) purchaser or designee takes possession; (b) broker takes possession of a specially endorsed or purchaser-named security; (c) broker confirms and identifies in a record; (d) third person acknowledges
#ASSERT `delivery to a purchaser occurs within s 70(1)` TRUE FALSE FALSE FALSE
#ASSERT `delivery to a purchaser occurs within s 70(1)` FALSE TRUE FALSE FALSE
#ASSERT `delivery to a purchaser occurs within s 70(1)` FALSE FALSE TRUE FALSE
#ASSERT `delivery to a purchaser occurs within s 70(1)` FALSE FALSE FALSE TRUE
#ASSERT NOT (`delivery to a purchaser occurs within s 70(1)` FALSE FALSE FALSE FALSE)
#ASSERT `delivery occurs through the purchaser's broker within s 70(1)` TRUE FALSE
#ASSERT `delivery occurs through the purchaser's broker within s 70(1)` FALSE TRUE
#ASSERT NOT (`delivery occurs through the purchaser's broker within s 70(1)` FALSE FALSE)

§§ `s 70(2): the purchaser is the owner, and a holder only in cases (1)(b) and (c)`
#ASSERT `the purchaser is the owner of a security that a broker holds for the purchaser within s 70(2)` TRUE
#ASSERT NOT (`the purchaser is the owner of a security that a broker holds for the purchaser within s 70(2)` FALSE)
-- args: a broker holds the security for the purchaser, case (1)(b), case (1)(c)
#ASSERT `the purchaser is a holder of a security that a broker holds for the purchaser within s 70(2)` TRUE TRUE FALSE
#ASSERT `the purchaser is a holder of a security that a broker holds for the purchaser within s 70(2)` TRUE FALSE TRUE
#ASSERT NOT (`the purchaser is a holder of a security that a broker holds for the purchaser within s 70(2)` TRUE FALSE FALSE)
#ASSERT NOT (`the purchaser is a holder of a security that a broker holds for the purchaser within s 70(2)` FALSE TRUE FALSE)
#ASSERT NOT (`the purchaser is a holder of a security that a broker holds for the purchaser within s 70(2)` FALSE FALSE TRUE)

§§ `s 70(3): proportionate share of a fungible bulk`
-- args: part of a fungible bulk, the number purchased, the number in the bulk
#ASSERT `the purchaser's proportionate share of the fungible bulk within s 70(3)` TRUE 250 1000 EQUALS (JUST 0.25)
#ASSERT `the purchaser's proportionate share of the fungible bulk within s 70(3)` TRUE 1000 1000 EQUALS (JUST 1)
#ASSERT `the purchaser's proportionate share of the fungible bulk within s 70(3)` FALSE 250 1000 EQUALS NOTHING
#ASSERT `the purchaser's proportionate share of the fungible bulk within s 70(3)` TRUE 250 0 EQUALS NOTHING

§§ `s 70(4): notice to broker`
#ASSERT `the notice of an adverse claim is ineffective against the broker and the purchaser within s 70(4)` TRUE
#ASSERT NOT (`the notice of an adverse claim is ineffective against the broker and the purchaser within s 70(4)` FALSE)
#ASSERT `the purchaser may demand delivery of an equivalent security from the broker within s 70(4)` TRUE
#ASSERT NOT (`the purchaser may demand delivery of an equivalent security from the broker within s 70(4)` FALSE)

§§ `s 71: delivery of a security`
-- args: sale on an exchange or through brokers, otherwise agreed, delivers to the selling broker or designee, causes an acknowledgment
#ASSERT `the selling customer has fulfilled the duty to deliver within s 71(1)` TRUE FALSE TRUE FALSE
#ASSERT `the selling customer has fulfilled the duty to deliver within s 71(1)` TRUE FALSE FALSE TRUE
#ASSERT NOT (`the selling customer has fulfilled the duty to deliver within s 71(1)` TRUE FALSE FALSE FALSE)
#ASSERT NOT (`the selling customer has fulfilled the duty to deliver within s 71(1)` FALSE FALSE TRUE FALSE)
#ASSERT NOT (`the selling customer has fulfilled the duty to deliver within s 71(1)` TRUE TRUE TRUE FALSE)
-- args: sale on an exchange or through brokers, otherwise agreed, delivers the security or a like security to the buying broker or designee, effects clearance
#ASSERT `the selling broker has fulfilled the duty to deliver within s 71(1)` TRUE FALSE TRUE FALSE
#ASSERT `the selling broker has fulfilled the duty to deliver within s 71(1)` TRUE FALSE FALSE TRUE
#ASSERT NOT (`the selling broker has fulfilled the duty to deliver within s 71(1)` TRUE FALSE FALSE FALSE)
#ASSERT NOT (`the selling broker has fulfilled the duty to deliver within s 71(1)` FALSE FALSE TRUE FALSE)
#ASSERT NOT (`the selling broker has fulfilled the duty to deliver within s 71(1)` TRUE TRUE TRUE FALSE)
-- args: otherwise agreed, delivers the security in negotiable form, causes an acknowledgment
#ASSERT `the transferor has fulfilled the duty to deliver under a contract of purchase within s 71(2)` FALSE TRUE FALSE
#ASSERT `the transferor has fulfilled the duty to deliver under a contract of purchase within s 71(2)` FALSE FALSE TRUE
#ASSERT NOT (`the transferor has fulfilled the duty to deliver under a contract of purchase within s 71(2)` FALSE FALSE FALSE)
#ASSERT NOT (`the transferor has fulfilled the duty to deliver under a contract of purchase within s 71(2)` TRUE TRUE FALSE)
-- args: a sale to a broker purchasing for its own account, made on a stock exchange
#ASSERT `subsection 71(2) governs the sale and subsection 71(1) does not within s 71(3)` TRUE FALSE
#ASSERT NOT (`subsection 71(2) governs the sale and subsection 71(1) does not within s 71(3)` TRUE TRUE)
#ASSERT NOT (`subsection 71(2) governs the sale and subsection 71(1) does not within s 71(3)` FALSE FALSE)
#ASSERT NOT (`subsection 71(2) governs the sale and subsection 71(1) does not within s 71(3)` FALSE TRUE)

§§ `s 72: reclaiming possession`
-- args: wrongful against the person, the other party is a bona fide purchaser
#ASSERT `the person may reclaim possession, obtain a new security or claim damages within s 72(1)` TRUE FALSE
#ASSERT NOT (`the person may reclaim possession, obtain a new security or claim damages within s 72(1)` TRUE TRUE)
#ASSERT NOT (`the person may reclaim possession, obtain a new security or claim damages within s 72(1)` FALSE FALSE)
