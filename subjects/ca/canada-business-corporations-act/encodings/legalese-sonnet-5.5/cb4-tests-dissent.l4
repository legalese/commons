IMPORT prelude
IMPORT `cbca-core`
IMPORT `cbca-core-definitions`
IMPORT `cb4-common`
IMPORT `cb4-dissent`

-- Tests of cb4-dissent.l4 (Part XV, s 190). Every expected value is written from the text of the section
-- named beside it, before the run; none is copied from the encoding's output. Dates: a period of N days
-- runs from day 0 (the start) to day N, both included (keel fork F1); the day before the start and the
-- day after the last day are out of time.

§ `Tests -- s 190`

§§ `s 190(1), (2), (2.1)`

-- (1): each listed action gives the right; the order under 192(4)(d) and (b) to (f) need no class fact.
#ASSERT `a holder of shares of a class may dissent within s 190(1)` `an order under paragraph 192(4)(d) that affects the holder` FALSE FALSE FALSE
#ASSERT `a holder of shares of a class may dissent within s 190(1)` `a resolution to amend the articles under section 173 or 174 to add, change or remove provisions restricting or constraining the issue, transfer or ownership of shares of that class (s 190(1)(a))` TRUE FALSE FALSE
-- (a) is about "shares of that class": if the provisions concern another class, no right.
#ASSERT NOT (`a holder of shares of a class may dissent within s 190(1)` `a resolution to amend the articles under section 173 or 174 to add, change or remove provisions restricting or constraining the issue, transfer or ownership of shares of that class (s 190(1)(a))` FALSE FALSE FALSE)
#ASSERT `a holder of shares of a class may dissent within s 190(1)` `a resolution to amend the articles under section 173 to add, change or remove a restriction on the business or businesses the corporation may carry on (s 190(1)(b))` FALSE FALSE FALSE
#ASSERT `a holder of shares of a class may dissent within s 190(1)` `a resolution to amalgamate otherwise than under section 184 (s 190(1)(c))` FALSE FALSE FALSE
#ASSERT `a holder of shares of a class may dissent within s 190(1)` `a resolution to be continued under section 188 (s 190(1)(d))` FALSE FALSE FALSE
#ASSERT `a holder of shares of a class may dissent within s 190(1)` `a resolution to sell, lease or exchange all or substantially all the property under subsection 189(3) (s 190(1)(e))` FALSE FALSE FALSE
#ASSERT `a holder of shares of a class may dissent within s 190(1)` `a resolution to carry out a going-private transaction or a squeeze-out transaction (s 190(1)(f))` FALSE FALSE FALSE
-- An action the subsection does not list: no right.
#ASSERT NOT (`a holder of shares of a class may dissent within s 190(1)` `an action that s 190(1) does not list` TRUE TRUE TRUE)
-- "Subject to sections 191 and 241".
#ASSERT NOT (`a holder of shares of a class may dissent within s 190(1)` `a resolution to amalgamate otherwise than under section 184 (s 190(1)(c))` FALSE TRUE FALSE)
#ASSERT NOT (`a holder of shares of a class may dissent within s 190(1)` `a resolution to amalgamate otherwise than under section 184 (s 190(1)(c))` FALSE FALSE TRUE)
-- (2) and (2.1).
#ASSERT `a holder of shares of a class or series may dissent within s 190(2)` TRUE TRUE
#ASSERT NOT (`a holder of shares of a class or series may dissent within s 190(2)` FALSE TRUE)
#ASSERT NOT (`a holder of shares of a class or series may dissent within s 190(2)` TRUE FALSE)
#ASSERT `the right in subsection 190(2) applies whatever the number of classes within s 190(2.1)` TRUE
#ASSERT `the right in subsection 190(2) applies whatever the number of classes within s 190(2.1)` FALSE

§§ `s 190(3), (4)`

#ASSERT `the dissenting shareholder is entitled to be paid the fair value of the shares within s 190(3)` TRUE TRUE
#ASSERT NOT (`the dissenting shareholder is entitled to be paid the fair value of the shares within s 190(3)` FALSE TRUE)
#ASSERT NOT (`the dissenting shareholder is entitled to be paid the fair value of the shares within s 190(3)` TRUE FALSE)
-- Fair value is fixed as of the day before the resolution: 1 March is fixed as of 28 February (2026).
#ASSERT (`the day as of which fair value is determined within s 190(3)` (YMD 2026 3 1)) EQUALS YMD 2026 2 28
#ASSERT (`the day as of which fair value is determined within s 190(3)` (YMD 2026 1 1)) EQUALS YMD 2025 12 31
#ASSERT `the shareholder has taken every step of s 190` TRUE TRUE TRUE TRUE
#ASSERT NOT (`the shareholder has taken every step of s 190` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`the shareholder has taken every step of s 190` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`the shareholder has taken every step of s 190` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`the shareholder has taken every step of s 190` TRUE TRUE TRUE FALSE)
-- (4): all the shares held for one beneficial owner: exactly equal.
#ASSERT `the claim is permitted within s 190(4)` 100 100
#ASSERT NOT (`the claim is permitted within s 190(4)` 99 100)
#ASSERT NOT (`the claim is permitted within s 190(4)` 101 100)

§§ `s 190(5) to (10)`

#ASSERT `the objection requirement is satisfied within s 190(5)` TRUE FALSE
#ASSERT `the objection requirement is satisfied within s 190(5)` FALSE TRUE
#ASSERT `the objection requirement is satisfied within s 190(5)` TRUE TRUE
#ASSERT NOT (`the objection requirement is satisfied within s 190(5)` FALSE FALSE)

-- (6): the notice is owed to one who filed the objection, did not vote for it and did not withdraw.
#ASSERT `the corporation must send the shareholder notice that the resolution has been adopted within s 190(6)` TRUE FALSE FALSE
#ASSERT NOT (`the corporation must send the shareholder notice that the resolution has been adopted within s 190(6)` FALSE FALSE FALSE)
#ASSERT NOT (`the corporation must send the shareholder notice that the resolution has been adopted within s 190(6)` TRUE TRUE FALSE)
#ASSERT NOT (`the corporation must send the shareholder notice that the resolution has been adopted within s 190(6)` TRUE FALSE TRUE)
-- Ten days after adoption on 1 March 2026: the last day is 11 March; 12 March is late.
#ASSERT (`the last day for the corporation to send the notice of adoption within s 190(6)` (YMD 2026 3 1)) EQUALS YMD 2026 3 11
#ASSERT `the notice of adoption was sent in time within s 190(6)` (YMD 2026 3 1) (YMD 2026 3 11)
#ASSERT NOT (`the notice of adoption was sent in time within s 190(6)` (YMD 2026 3 1) (YMD 2026 3 12))
#ASSERT `the notice of adoption was sent in time within s 190(6)` (YMD 2026 3 1) (YMD 2026 3 1)
#ASSERT NOT (`the notice of adoption was sent in time within s 190(6)` (YMD 2026 3 1) (YMD 2026 2 28))

-- (7): the twenty days start from receipt of the (6) notice, or if none, from learning of the adoption.
#ASSERT (`the day the twenty days for the demand for payment start within s 190(7)` TRUE (YMD 2026 3 12) (YMD 2026 3 5)) EQUALS YMD 2026 3 12
#ASSERT (`the day the twenty days for the demand for payment start within s 190(7)` FALSE (YMD 2026 3 12) (YMD 2026 3 5)) EQUALS YMD 2026 3 5
#ASSERT (`the last day for the shareholder to send the demand for payment within s 190(7)` (YMD 2026 3 12)) EQUALS YMD 2026 4 1
#ASSERT `the demand for payment was sent in time within s 190(7)` (YMD 2026 3 12) (YMD 2026 4 1)
#ASSERT NOT (`the demand for payment was sent in time within s 190(7)` (YMD 2026 3 12) (YMD 2026 4 2))
#ASSERT `the demand for payment was sent in time within s 190(7)` (YMD 2026 3 12) (YMD 2026 3 31)
#ASSERT NOT (`the demand for payment was sent in time within s 190(7)` (YMD 2026 3 12) (YMD 2026 3 11))
-- (7)(a) to (c): all three.
#ASSERT `the notice contains what s 190(7) requires` TRUE TRUE TRUE
#ASSERT NOT (`the notice contains what s 190(7) requires` FALSE TRUE TRUE)
#ASSERT NOT (`the notice contains what s 190(7) requires` TRUE FALSE TRUE)
#ASSERT NOT (`the notice contains what s 190(7) requires` TRUE TRUE FALSE)

-- (8): thirty days from sending the (7) notice (1 April 2026): last day 1 May.
#ASSERT (`the last day for the shareholder to send the certificates within s 190(8)` (YMD 2026 4 1)) EQUALS YMD 2026 5 1
#ASSERT `the certificates were sent in time within s 190(8)` (YMD 2026 4 1) (YMD 2026 5 1)
#ASSERT NOT (`the certificates were sent in time within s 190(8)` (YMD 2026 4 1) (YMD 2026 5 2))
#ASSERT `the certificates were sent in time within s 190(8)` (YMD 2026 4 1) (YMD 2026 4 1)
-- (9), (10).
#ASSERT `the shareholder is barred from making a claim within s 190(9)` FALSE
#ASSERT NOT (`the shareholder is barred from making a claim within s 190(9)` TRUE)
#ASSERT `the corporation or its transfer agent must endorse the certificate and return it within s 190(10)` TRUE
#ASSERT NOT (`the corporation or its transfer agent must endorse the certificate and return it within s 190(10)` FALSE)

§§ `s 190(11)`

-- Arguments: sent the (7) notice; (a) withdrew before an offer; corporation failed to make an offer; (b)
-- the shareholder withdrew; (c) directors revoked etc.
#ASSERT NOT (`the shareholder's rights as a shareholder are reinstated within s 190(11)` TRUE FALSE FALSE FALSE FALSE)
#ASSERT `the shareholder's rights as a shareholder are reinstated within s 190(11)` TRUE TRUE FALSE FALSE FALSE
#ASSERT `the shareholder's rights as a shareholder are reinstated within s 190(11)` TRUE FALSE TRUE TRUE FALSE
-- (b) needs BOTH the failure to offer and the withdrawal.
#ASSERT NOT (`the shareholder's rights as a shareholder are reinstated within s 190(11)` TRUE FALSE TRUE FALSE FALSE)
#ASSERT NOT (`the shareholder's rights as a shareholder are reinstated within s 190(11)` TRUE FALSE FALSE TRUE FALSE)
#ASSERT `the shareholder's rights as a shareholder are reinstated within s 190(11)` TRUE FALSE FALSE FALSE TRUE
-- No notice sent yet: nothing to reinstate.
#ASSERT NOT (`the shareholder's rights as a shareholder are reinstated within s 190(11)` FALSE TRUE TRUE TRUE TRUE)
#ASSERT `the shareholder has no rights as a shareholder other than to be paid within s 190(11)` TRUE FALSE FALSE FALSE FALSE
#ASSERT NOT (`the shareholder has no rights as a shareholder other than to be paid within s 190(11)` TRUE TRUE FALSE FALSE FALSE)
#ASSERT NOT (`the shareholder has no rights as a shareholder other than to be paid within s 190(11)` FALSE FALSE FALSE FALSE FALSE)
#ASSERT (`the day from which the reinstated rights count within s 190(11)` (YMD 2026 4 1) TRUE) EQUALS JUST (YMD 2026 4 1)
#ASSERT (`the day from which the reinstated rights count within s 190(11)` (YMD 2026 4 1) FALSE) EQUALS NOTHING

§§ `s 190(12) to (14)`

-- (12): seven days after the LATER of the effective day (10 April) and receipt of the (7) notice (4 April,
-- 12 April).
#ASSERT (`the day the seven days for the offer start within s 190(12)` (YMD 2026 4 10) (YMD 2026 4 4)) EQUALS YMD 2026 4 10
#ASSERT (`the day the seven days for the offer start within s 190(12)` (YMD 2026 4 10) (YMD 2026 4 12)) EQUALS YMD 2026 4 12
#ASSERT (`the day the seven days for the offer start within s 190(12)` (YMD 2026 4 10) (YMD 2026 4 10)) EQUALS YMD 2026 4 10
#ASSERT (`the last day for the corporation to send the offer within s 190(12)` (YMD 2026 4 10)) EQUALS YMD 2026 4 17
#ASSERT `the offer or notification was sent in time within s 190(12)` (YMD 2026 4 10) (YMD 2026 4 17)
#ASSERT NOT (`the offer or notification was sent in time within s 190(12)` (YMD 2026 4 10) (YMD 2026 4 18))
-- (12)(a), (b). Arguments: offer sent, amount considered fair, statement, (26) applies, notification sent.
#ASSERT `the corporation's response to the dissenting shareholder complies with s 190(12)` TRUE TRUE TRUE FALSE FALSE
#ASSERT NOT (`the corporation's response to the dissenting shareholder complies with s 190(12)` TRUE TRUE FALSE FALSE FALSE)
#ASSERT NOT (`the corporation's response to the dissenting shareholder complies with s 190(12)` TRUE FALSE TRUE FALSE FALSE)
#ASSERT NOT (`the corporation's response to the dissenting shareholder complies with s 190(12)` FALSE FALSE FALSE FALSE FALSE)
#ASSERT `the corporation's response to the dissenting shareholder complies with s 190(12)` FALSE FALSE FALSE TRUE TRUE
-- A notification of inability is no answer unless (26) applies.
#ASSERT NOT (`the corporation's response to the dissenting shareholder complies with s 190(12)` FALSE FALSE FALSE FALSE TRUE)
#ASSERT NOT (`the corporation's response to the dissenting shareholder complies with s 190(12)` FALSE FALSE FALSE TRUE FALSE)
-- (13).
#ASSERT `the offers comply with s 190(13)` TRUE TRUE
#ASSERT NOT (`the offers comply with s 190(13)` TRUE FALSE)
#ASSERT `the offers comply with s 190(13)` FALSE FALSE
-- (14): payment after acceptance, unless (26); ten days to pay (accepted 20 April: last day 30 April).
#ASSERT `the corporation must pay for the shares within s 190(14)` TRUE FALSE
#ASSERT NOT (`the corporation must pay for the shares within s 190(14)` TRUE TRUE)
#ASSERT NOT (`the corporation must pay for the shares within s 190(14)` FALSE FALSE)
#ASSERT (`the last day for the corporation to pay within s 190(14)` (YMD 2026 4 20)) EQUALS YMD 2026 4 30
#ASSERT `the payment was made in time within s 190(14)` (YMD 2026 4 20) (YMD 2026 4 30)
#ASSERT NOT (`the payment was made in time within s 190(14)` (YMD 2026 4 20) (YMD 2026 5 1))
-- Offer made 17 April: acceptance must be received by 17 May (30 days).
#ASSERT (`the last day for the corporation to receive an acceptance within s 190(14)` (YMD 2026 4 17)) EQUALS YMD 2026 5 17
-- No acceptance: lapsed after 17 May, not on it.
#ASSERT NOT (`the offer has lapsed on a day within s 190(14)` (YMD 2026 4 17) FALSE (YMD 2026 4 17) (YMD 2026 5 17))
#ASSERT `the offer has lapsed on a day within s 190(14)` (YMD 2026 4 17) FALSE (YMD 2026 4 17) (YMD 2026 5 18)
-- Accepted in time (17 May): never lapses.
#ASSERT NOT (`the offer has lapsed on a day within s 190(14)` (YMD 2026 4 17) TRUE (YMD 2026 5 17) (YMD 2026 6 30))
-- Accepted late (18 May): lapsed.
#ASSERT `the offer has lapsed on a day within s 190(14)` (YMD 2026 4 17) TRUE (YMD 2026 5 18) (YMD 2026 5 19)

§§ `s 190(15) to (24)`

-- (15): action effective on 1 June 2026: the corporation's fifty days end on 21 July.
#ASSERT (`the last day for the corporation to apply to a court within s 190(15)` (YMD 2026 6 1)) EQUALS YMD 2026 7 21
#ASSERT `the corporation may apply to a court to fix a fair value within s 190(15)` TRUE FALSE (YMD 2026 6 1) (YMD 2026 7 21) FALSE (YMD 2026 6 1)
#ASSERT NOT (`the corporation may apply to a court to fix a fair value within s 190(15)` TRUE FALSE (YMD 2026 6 1) (YMD 2026 7 22) FALSE (YMD 2026 6 1))
-- A court allowed a further period to 31 July: 25 July is in time.
#ASSERT `the corporation may apply to a court to fix a fair value within s 190(15)` TRUE FALSE (YMD 2026 6 1) (YMD 2026 7 25) TRUE (YMD 2026 7 31)
#ASSERT NOT (`the corporation may apply to a court to fix a fair value within s 190(15)` TRUE FALSE (YMD 2026 6 1) (YMD 2026 8 1) TRUE (YMD 2026 7 31))
-- No failure of either kind: no right to apply.
#ASSERT NOT (`the corporation may apply to a court to fix a fair value within s 190(15)` FALSE FALSE (YMD 2026 6 1) (YMD 2026 6 15) FALSE (YMD 2026 6 1))
#ASSERT `the corporation may apply to a court to fix a fair value within s 190(15)` FALSE TRUE (YMD 2026 6 1) (YMD 2026 6 15) FALSE (YMD 2026 6 1)
-- (16): the shareholder: after the corporation failed (after 21 July) and within a further twenty days
-- (to 10 August).
#ASSERT (`the last day for the dissenting shareholder to apply to a court within s 190(16)` (YMD 2026 6 1)) EQUALS YMD 2026 8 10
#ASSERT `the dissenting shareholder may apply to a court to fix a fair value within s 190(16)` TRUE (YMD 2026 6 1) (YMD 2026 8 10) FALSE (YMD 2026 6 1)
#ASSERT NOT (`the dissenting shareholder may apply to a court to fix a fair value within s 190(16)` TRUE (YMD 2026 6 1) (YMD 2026 8 11) FALSE (YMD 2026 6 1))
#ASSERT `the dissenting shareholder may apply to a court to fix a fair value within s 190(16)` TRUE (YMD 2026 6 1) (YMD 2026 7 22) FALSE (YMD 2026 6 1)
-- Not before the corporation's fifty days have run out.
#ASSERT NOT (`the dissenting shareholder may apply to a court to fix a fair value within s 190(16)` TRUE (YMD 2026 6 1) (YMD 2026 7 21) FALSE (YMD 2026 6 1))
-- The corporation did apply: the shareholder has no (16) right.
#ASSERT NOT (`the dissenting shareholder may apply to a court to fix a fair value within s 190(16)` FALSE (YMD 2026 6 1) (YMD 2026 8 1) FALSE (YMD 2026 6 1))
-- A court allowed the shareholder until 31 August.
#ASSERT `the dissenting shareholder may apply to a court to fix a fair value within s 190(16)` TRUE (YMD 2026 6 1) (YMD 2026 8 20) TRUE (YMD 2026 8 31)
-- (17).
#ASSERT `the court is a proper court within s 190(17)` TRUE FALSE FALSE
#ASSERT `the court is a proper court within s 190(17)` FALSE TRUE TRUE
#ASSERT NOT (`the court is a proper court within s 190(17)` FALSE TRUE FALSE)
#ASSERT NOT (`the court is a proper court within s 190(17)` FALSE FALSE TRUE)
-- (18): no security for costs for a (15) or (16) application; silent otherwise.
#ASSERT (`a dissenting shareholder is required to give security for costs within s 190(18)` TRUE) EQUALS JUST FALSE
#ASSERT (`a dissenting shareholder is required to give security for costs within s 190(18)` FALSE) EQUALS NOTHING
-- (19).
#ASSERT `the dissenting shareholder must be joined as a party and is bound by the decision within s 190(19)(a)` TRUE
#ASSERT NOT (`the dissenting shareholder must be joined as a party and is bound by the decision within s 190(19)(a)` FALSE)
#ASSERT `the corporation's notice to the dissenting shareholder complies with s 190(19)(b)` TRUE TRUE TRUE TRUE
#ASSERT NOT (`the corporation's notice to the dissenting shareholder complies with s 190(19)(b)` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`the corporation's notice to the dissenting shareholder complies with s 190(19)(b)` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`the corporation's notice to the dissenting shareholder complies with s 190(19)(b)` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`the corporation's notice to the dissenting shareholder complies with s 190(19)(b)` TRUE TRUE TRUE FALSE)
-- (20) to (22).
#ASSERT `the court must fix a fair value for the shares of all dissenting shareholders within s 190(20)` TRUE
#ASSERT NOT (`the court must fix a fair value for the shares of all dissenting shareholders within s 190(20)` FALSE)
#ASSERT `the court may appoint appraisers within s 190(21)` TRUE
#ASSERT NOT (`the court may appoint appraisers within s 190(21)` FALSE)
#ASSERT `the final order is rendered against the corporation in favour of each dissenting shareholder within s 190(22)` TRUE
#ASSERT NOT (`the final order is rendered against the corporation in favour of each dissenting shareholder within s 190(22)` FALSE)
-- (23): interest from the day the action is effective (1 June) until the day of payment (30 June).
#ASSERT `the court may allow interest for a day within s 190(23)` (YMD 2026 6 1) (YMD 2026 6 30) (YMD 2026 6 1)
#ASSERT `the court may allow interest for a day within s 190(23)` (YMD 2026 6 1) (YMD 2026 6 30) (YMD 2026 6 30)
#ASSERT `the court may allow interest for a day within s 190(23)` (YMD 2026 6 1) (YMD 2026 6 30) (YMD 2026 6 15)
#ASSERT NOT (`the court may allow interest for a day within s 190(23)` (YMD 2026 6 1) (YMD 2026 6 30) (YMD 2026 5 31))
#ASSERT NOT (`the court may allow interest for a day within s 190(23)` (YMD 2026 6 1) (YMD 2026 6 30) (YMD 2026 7 1))
-- (24): (26) applies and an order was pronounced; ten days from 1 August: 11 August.
#ASSERT `the corporation must notify each dissenting shareholder that it is unable lawfully to pay within s 190(24)` TRUE TRUE
#ASSERT NOT (`the corporation must notify each dissenting shareholder that it is unable lawfully to pay within s 190(24)` FALSE TRUE)
#ASSERT NOT (`the corporation must notify each dissenting shareholder that it is unable lawfully to pay within s 190(24)` TRUE FALSE)
#ASSERT (`the last day for the corporation to give the notice within s 190(24)` (YMD 2026 8 1)) EQUALS YMD 2026 8 11
#ASSERT `the notice was given in time within s 190(24)` (YMD 2026 8 1) (YMD 2026 8 11)
#ASSERT NOT (`the notice was given in time within s 190(24)` (YMD 2026 8 1) (YMD 2026 8 12))

§§ `s 190(25), (26)`

-- (25): thirty days after receiving the (24) notice on 15 August: last day 14 September.
#ASSERT (`the last day for the shareholder to deliver the written notice within s 190(25)` (YMD 2026 8 15)) EQUALS YMD 2026 9 14
#ASSERT `the written notice was delivered in time within s 190(25)` (YMD 2026 8 15) (YMD 2026 9 14)
#ASSERT NOT (`the written notice was delivered in time within s 190(25)` (YMD 2026 8 15) (YMD 2026 9 15))
#ASSERT `the effect of the shareholder's choice within s 190(25)` TRUE TRUE `to withdraw the notice of dissent` EQUALS `the corporation is deemed to consent to the withdrawal and the shareholder is reinstated to their full rights as a shareholder`
#ASSERT `the effect of the shareholder's choice within s 190(25)` TRUE TRUE `to retain a status as a claimant against the corporation` EQUALS `the shareholder is a claimant, paid as soon as the corporation is lawfully able to do so, or in a liquidation ranked after the creditors and before the shareholders`
-- Not in time, or (26) does not apply: the Act does not say.
#ASSERT `the effect of the shareholder's choice within s 190(25)` TRUE FALSE `to withdraw the notice of dissent` EQUALS `the Act does not say what the effect is`
#ASSERT `the effect of the shareholder's choice within s 190(25)` FALSE TRUE `to retain a status as a claimant against the corporation` EQUALS `the Act does not say what the effect is`
-- (26): either ground bars the payment.
#ASSERT `the corporation must not make a payment to a dissenting shareholder within s 190(26)` TRUE FALSE
#ASSERT `the corporation must not make a payment to a dissenting shareholder within s 190(26)` FALSE TRUE
#ASSERT `the corporation must not make a payment to a dissenting shareholder within s 190(26)` TRUE TRUE
#ASSERT NOT (`the corporation must not make a payment to a dissenting shareholder within s 190(26)` FALSE FALSE)
