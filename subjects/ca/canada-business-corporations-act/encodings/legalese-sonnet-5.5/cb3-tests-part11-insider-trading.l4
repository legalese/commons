IMPORT prelude
IMPORT `cbca-core`
IMPORT `cbca-core-definitions`
IMPORT `cb3-nouns`
IMPORT `cb3-part11-insider-trading`

-- Tests of cb3-part11-insider-trading.l4 (CBCA ss 126 to 131). Every expected value is written from the
-- text of the section, quoted in the module; none is copied from the module's own output.

§ `Tests of Part XI`

§§ `s 126(1) business combination`

#ASSERT `business combination within s 126(1)` TRUE FALSE FALSE
#ASSERT `business combination within s 126(1)` FALSE TRUE FALSE
#ASSERT `business combination within s 126(1)` FALSE FALSE TRUE
#ASSERT NOT `business combination within s 126(1)` FALSE FALSE FALSE

§§ `s 126(1) insider: four limbs, and "except in section 131"`

-- arguments: used in s 131, (a) director/officer of a distributing corporation, (b) of a subsidiary of one,
-- (c) of a body corporate in a business combination with one, (d) employed or retained by one
#ASSERT `insider within s 126(1)` FALSE TRUE FALSE FALSE FALSE
#ASSERT `insider within s 126(1)` FALSE FALSE TRUE FALSE FALSE
#ASSERT `insider within s 126(1)` FALSE FALSE FALSE TRUE FALSE
#ASSERT `insider within s 126(1)` FALSE FALSE FALSE FALSE TRUE
#ASSERT NOT `insider within s 126(1)` FALSE FALSE FALSE FALSE FALSE
-- "insider means, except in section 131": used in s 131 this definition does not apply, whatever the limbs
#ASSERT NOT `insider within s 126(1)` TRUE TRUE TRUE TRUE TRUE

§§ `s 126(1) officer: the listed offices of an entity, and no s 121 limb`

-- each listed office, held in a body corporate (an entity, s 2(1))
#ASSERT `officer within s 126(1)` `the chairperson of the board of directors` TRUE `a body corporate`
#ASSERT `officer within s 126(1)` `the president` TRUE `a body corporate`
#ASSERT `officer within s 126(1)` `a vice-president` TRUE `a body corporate`
#ASSERT `officer within s 126(1)` `the secretary` TRUE `a body corporate`
#ASSERT `officer within s 126(1)` `the treasurer` TRUE `a body corporate`
#ASSERT `officer within s 126(1)` `the comptroller` TRUE `a body corporate`
#ASSERT `officer within s 126(1)` `the general counsel` TRUE `a body corporate`
#ASSERT `officer within s 126(1)` `the general manager` TRUE `a body corporate`
#ASSERT `officer within s 126(1)` `a managing director` TRUE `a body corporate`
-- "of an entity": a partnership, a trust and an unincorporated association are entities too
#ASSERT `officer within s 126(1)` `the president` TRUE `a partnership`
#ASSERT `officer within s 126(1)` `the president` TRUE `a trust`
#ASSERT `officer within s 126(1)` `the president` TRUE `an unincorporated association or organization`
-- an individual is not an entity (s 2(1) "entity"), so an office "of" an individual is not an office of an entity
#ASSERT NOT `officer within s 126(1)` `the president` TRUE `an individual`
-- "any other individual who performs functions for an entity similar to those normally performed ...": needs an individual
#ASSERT `officer within s 126(1)` `another individual performing functions similar to those of one of these offices` TRUE `a body corporate`
#ASSERT NOT `officer within s 126(1)` `another individual performing functions similar to those of one of these offices` FALSE `a body corporate`
-- s 126(1) has no limb for "an individual appointed as an officer under section 121" (s 2(1) has): FALSE here
#ASSERT NOT `officer within s 126(1)` `an officer appointed under section 121` TRUE `a body corporate`
#ASSERT `officer within s 2(1)` TRUE `an officer appointed under section 121`
#ASSERT NOT `officer within s 126(1)` `holds no office and performs no similar function` TRUE `a body corporate`

§§ `s 126(1) share`

#ASSERT `share within s 126(1)` TRUE FALSE FALSE FALSE
#ASSERT `share within s 126(1)` FALSE TRUE FALSE FALSE
#ASSERT `share within s 126(1)` FALSE FALSE TRUE FALSE
#ASSERT `share within s 126(1)` FALSE FALSE FALSE TRUE
#ASSERT NOT `share within s 126(1)` FALSE FALSE FALSE FALSE

§§ `s 126(2) -- further interpretation`

-- (a) "more than the prescribed percentage": exactly the percentage is not enough
#ASSERT `deemed insider within s 126(2)(a)` TRUE (20%) (10%)
#ASSERT `deemed insider within s 126(2)(a)` TRUE (10.01%) (10%)
#ASSERT NOT `deemed insider within s 126(2)(a)` TRUE (10%) (10%)
#ASSERT NOT `deemed insider within s 126(2)(a)` TRUE (5%) (10%)
#ASSERT NOT `deemed insider within s 126(2)(a)` FALSE (20%) (10%)
-- (b)
#ASSERT `deemed insider within s 126(2)(b)` TRUE TRUE
#ASSERT NOT `deemed insider within s 126(2)(b)` TRUE FALSE
#ASSERT NOT `deemed insider within s 126(2)(b)` FALSE TRUE
-- (c) deemed to own what a controlled body corporate owns
#ASSERT `shares deemed beneficially owned by a person within s 126(2)(c)` 100 (LIST 50, 25) EQUALS 175
#ASSERT `shares deemed beneficially owned by a person within s 126(2)(c)` 10 EMPTY EQUALS 10
#ASSERT `shares deemed beneficially owned by a person within s 126(2)(c)` 0 (LIST 7) EQUALS 7
-- (d) deemed to own what its affiliates own
#ASSERT `shares deemed beneficially owned by a body corporate within s 126(2)(d)` 40 (LIST 1000, 500) EQUALS 1540
#ASSERT `shares deemed beneficially owned by a body corporate within s 126(2)(d)` 40 EMPTY EQUALS 40
-- (e)
#ASSERT `change in beneficial ownership deemed within s 126(2)(e)` TRUE TRUE
#ASSERT NOT `change in beneficial ownership deemed within s 126(2)(e)` TRUE FALSE
#ASSERT NOT `change in beneficial ownership deemed within s 126(2)(e)` FALSE TRUE

§§ `s 130(1) -- short sale`

-- arguments: insider, knowingly sells (directly or indirectly), security of a distributing corporation or an
-- affiliate, does not own it, has not fully paid for it
#ASSERT `a short sale is prohibited within s 130(1)` TRUE TRUE TRUE TRUE FALSE
-- owns it but has not fully paid for it: "does not own or has not fully paid for"
#ASSERT `a short sale is prohibited within s 130(1)` TRUE TRUE TRUE FALSE TRUE
-- owns it and has paid for it: not a short sale
#ASSERT NOT `a short sale is prohibited within s 130(1)` TRUE TRUE TRUE FALSE FALSE
#ASSERT NOT `a short sale is prohibited within s 130(1)` FALSE TRUE TRUE TRUE TRUE
#ASSERT NOT `a short sale is prohibited within s 130(1)` TRUE FALSE TRUE TRUE TRUE
#ASSERT NOT `a short sale is prohibited within s 130(1)` TRUE TRUE FALSE TRUE TRUE

§§ `s 130(2) -- calls and puts`

-- arguments: insider, sells a call, buys a put, in respect of a security of the corporation or an affiliate
#ASSERT `selling a call or buying a put is prohibited within s 130(2)` TRUE TRUE FALSE TRUE
#ASSERT `selling a call or buying a put is prohibited within s 130(2)` TRUE FALSE TRUE TRUE
#ASSERT `selling a call or buying a put is prohibited within s 130(2)` TRUE TRUE TRUE TRUE
#ASSERT NOT `selling a call or buying a put is prohibited within s 130(2)` TRUE FALSE FALSE TRUE
#ASSERT NOT `selling a call or buying a put is prohibited within s 130(2)` TRUE TRUE FALSE FALSE
#ASSERT NOT `selling a call or buying a put is prohibited within s 130(2)` FALSE TRUE FALSE TRUE

§§ `s 130(3) -- the exception: ten days after the sale`

-- arguments: does not own the security, owns another security convertible into it (or an option or right),
-- date of the sale, date (a) was done (exercise and delivery), date (b) was done (transfer)
-- (a) done on the tenth day after the sale: in time (the last day is in time, fork F1)
#ASSERT `the exception to a short sale applies within s 130(3)` TRUE TRUE (YearMonthDay 2027 3 1) (JUST (YearMonthDay 2027 3 11)) NOTHING
-- (a) done on the eleventh day: too late
#ASSERT NOT `the exception to a short sale applies within s 130(3)` TRUE TRUE (YearMonthDay 2027 3 1) (JUST (YearMonthDay 2027 3 12)) NOTHING
-- (a) done on the day of the sale: in time ("within ten days after the sale")
#ASSERT `the exception to a short sale applies within s 130(3)` TRUE TRUE (YearMonthDay 2027 3 1) (JUST (YearMonthDay 2027 3 1)) NOTHING
-- (a) done the day BEFORE the sale: not "after the sale"
#ASSERT NOT `the exception to a short sale applies within s 130(3)` TRUE TRUE (YearMonthDay 2027 3 1) (JUST (YearMonthDay 2027 2 28)) NOTHING
-- (b) the transfer instead, in time
#ASSERT `the exception to a short sale applies within s 130(3)` TRUE TRUE (YearMonthDay 2027 3 1) NOTHING (JUST (YearMonthDay 2027 3 5))
-- (b) too late
#ASSERT NOT `the exception to a short sale applies within s 130(3)` TRUE TRUE (YearMonthDay 2027 3 1) NOTHING (JUST (YearMonthDay 2027 3 20))
-- neither done: no exception
#ASSERT NOT `the exception to a short sale applies within s 130(3)` TRUE TRUE (YearMonthDay 2027 3 1) NOTHING NOTHING
-- (a) late but (b) in time: either suffices ("or")
#ASSERT `the exception to a short sale applies within s 130(3)` TRUE TRUE (YearMonthDay 2027 3 1) (JUST (YearMonthDay 2027 3 30)) (JUST (YearMonthDay 2027 3 2))
-- the insider owns the security (so the exception, which is for a security they "do not own", is not in point)
#ASSERT NOT `the exception to a short sale applies within s 130(3)` FALSE TRUE (YearMonthDay 2027 3 1) (JUST (YearMonthDay 2027 3 5)) NOTHING
-- the insider owns no convertible security, option or right
#ASSERT NOT `the exception to a short sale applies within s 130(3)` TRUE FALSE (YearMonthDay 2027 3 1) (JUST (YearMonthDay 2027 3 5)) NOTHING
-- the tenth day across a month end and a leap day: 25 February 2028 plus ten days is 6 March 2028
#ASSERT `the exception to a short sale applies within s 130(3)` TRUE TRUE (YearMonthDay 2028 2 25) (JUST (YearMonthDay 2028 3 6)) NOTHING
#ASSERT NOT `the exception to a short sale applies within s 130(3)` TRUE TRUE (YearMonthDay 2028 2 25) (JUST (YearMonthDay 2028 3 7)) NOTHING

§§ `s 130(4) -- the offence and its ceiling`

-- arguments: short sale prohibited by (1), exception applies, call or put prohibited by (2)
#ASSERT `the insider contravenes s 130(1) or (2) within s 130(4)` TRUE FALSE FALSE
-- the exception relieves (1) ...
#ASSERT NOT `the insider contravenes s 130(1) or (2) within s 130(4)` TRUE TRUE FALSE
-- ... but not (2): "Despite subsection (1)"
#ASSERT `the insider contravenes s 130(1) or (2) within s 130(4)` TRUE TRUE TRUE
#ASSERT `the insider contravenes s 130(1) or (2) within s 130(4)` FALSE FALSE TRUE
#ASSERT NOT `the insider contravenes s 130(1) or (2) within s 130(4)` FALSE FALSE FALSE
#ASSERT `the insider is guilty of an offence within s 130(4)` TRUE
#ASSERT NOT `the insider is guilty of an offence within s 130(4)` FALSE

-- the fine ceiling is the greater of one million dollars and three times the profit
#ASSERT (`the penalty ceiling within s 130(4)` 0)'s `maximum fine in dollars` EQUALS 1_000_000
#ASSERT (`the penalty ceiling within s 130(4)` 333_333)'s `maximum fine in dollars` EQUALS 1_000_000
#ASSERT (`the penalty ceiling within s 130(4)` 333_334)'s `maximum fine in dollars` EQUALS 1_000_002
#ASSERT (`the penalty ceiling within s 130(4)` 1_000_000)'s `maximum fine in dollars` EQUALS 3_000_000
#ASSERT (`the penalty ceiling within s 130(4)` (0 MINUS 5))'s `maximum fine in dollars` EQUALS 1_000_000
-- imprisonment not exceeding six months, whatever the profit
#ASSERT (`the penalty ceiling within s 130(4)` 0)'s `maximum imprisonment in months` EQUALS JUST 6
#ASSERT (`the penalty ceiling within s 130(4)` 5_000_000)'s `maximum imprisonment in months` EQUALS JUST 6

§§ `s 131(1) -- insider, limb by limb`

-- A helper to build one person's connection. Arguments, in the declared order: (a) the corporation itself,
-- (b) an affiliate, (c1) a director or officer of the corporation, (c2) a director or officer of a (b), (d) or
-- (f) person, (d) the fraction of the voting rights, (e1) employed or retained by the corporation, (e2) employed
-- or retained by a (f) person, (f) engages in business with it, (g) received information while a (a)-(f)
-- person, (h1) received information from a described person, (h2) knows or ought to have known that, (i) a
-- prescribed person.
GIVEN a IS A BOOLEAN
      b IS A BOOLEAN
      c1 IS A BOOLEAN
      c2 IS A BOOLEAN
      d IS A NUMBER
      e1 IS A BOOLEAN
      e2 IS A BOOLEAN
      f IS A BOOLEAN
      g IS A BOOLEAN
      h1 IS A BOOLEAN
      h2 IS A BOOLEAN
      i IS A BOOLEAN
GIVETH A `Connection of a person to a corporation under s 131(1)`
`a test connection` a b c1 c2 d e1 e2 f g h1 h2 i MEANS
    `Connection of a person to a corporation under s 131(1)` WITH
        `the corporation itself` IS a
        `an affiliate of the corporation` IS b
        `a director or an officer of the corporation` IS c1
        `a director or an officer of a person described in paragraph (b), (d) or (f)` IS c2
        `fraction of the voting rights beneficially owned, controlled or directed, not counting shares held as underwriter in the course of a distribution to the public` IS d
        `employed or retained by the corporation` IS e1
        `employed or retained by a person described in paragraph (f)` IS e2
        `engages in or proposes to engage in any business or professional activity with or on behalf of the corporation` IS f
        `received material confidential information concerning the corporation while a person described in any of paragraphs (a) to (f)` IS g
        `received material confidential information from a person described in subsection 131(1), (3) or (3.1)` IS h1
        `knows or ought reasonably to have known that the person giving the information is such a person` IS h2
        `a prescribed person` IS i

`a connection: none` MEANS `a test connection` FALSE FALSE FALSE FALSE 0 FALSE FALSE FALSE FALSE FALSE FALSE FALSE

-- (a) the corporation itself
`a connection: the corporation itself` MEANS `a test connection` TRUE FALSE FALSE FALSE 0 FALSE FALSE FALSE FALSE FALSE FALSE FALSE
#ASSERT `insider within s 131(1)(a)` `a connection: the corporation itself`
#ASSERT NOT `insider within s 131(1)(a)` `a connection: none`
-- (b) an affiliate of the corporation
`a connection: an affiliate` MEANS `a test connection` FALSE TRUE FALSE FALSE 0 FALSE FALSE FALSE FALSE FALSE FALSE FALSE
#ASSERT `insider within s 131(1)(b)` `a connection: an affiliate`
#ASSERT NOT `insider within s 131(1)(b)` `a connection: none`
-- (c) director or officer of the corporation, or of a (b), (d) or (f) person
`a connection: a director of the corporation` MEANS `a test connection` FALSE FALSE TRUE FALSE 0 FALSE FALSE FALSE FALSE FALSE FALSE FALSE
`a connection: a director of an affiliate` MEANS `a test connection` FALSE FALSE FALSE TRUE 0 FALSE FALSE FALSE FALSE FALSE FALSE FALSE
#ASSERT `insider within s 131(1)(c)` `a connection: a director of the corporation`
#ASSERT `insider within s 131(1)(c)` `a connection: a director of an affiliate`
#ASSERT NOT `insider within s 131(1)(c)` `a connection: none`
-- (d) MORE THAN the prescribed percentage: 11% against 10% is, 10% is not
`a connection: a holder of eleven percent` MEANS `a test connection` FALSE FALSE FALSE FALSE 0.11 FALSE FALSE FALSE FALSE FALSE FALSE FALSE
`a connection: a holder of ten percent` MEANS `a test connection` FALSE FALSE FALSE FALSE 0.10 FALSE FALSE FALSE FALSE FALSE FALSE FALSE
#ASSERT `insider within s 131(1)(d)` `a connection: a holder of eleven percent` (10%)
#ASSERT NOT `insider within s 131(1)(d)` `a connection: a holder of ten percent` (10%)
#ASSERT NOT `insider within s 131(1)(d)` `a connection: none` (10%)
-- (e) employed or retained by the corporation or by a (f) person, "other than a person described in paragraph (f)"
`a connection: an employee of the corporation` MEANS `a test connection` FALSE FALSE FALSE FALSE 0 TRUE FALSE FALSE FALSE FALSE FALSE FALSE
`a connection: an employee of a person doing business with the corporation` MEANS `a test connection` FALSE FALSE FALSE FALSE 0 FALSE TRUE FALSE FALSE FALSE FALSE FALSE
`a connection: an employee who also does business with the corporation` MEANS `a test connection` FALSE FALSE FALSE FALSE 0 TRUE FALSE TRUE FALSE FALSE FALSE FALSE
#ASSERT `insider within s 131(1)(e)` `a connection: an employee of the corporation`
#ASSERT `insider within s 131(1)(e)` `a connection: an employee of a person doing business with the corporation`
#ASSERT NOT `insider within s 131(1)(e)` `a connection: an employee who also does business with the corporation`
#ASSERT NOT `insider within s 131(1)(e)` `a connection: none`
-- (f) engages in or proposes to engage in business or professional activity with the corporation
`a connection: a person doing business with the corporation` MEANS `a test connection` FALSE FALSE FALSE FALSE 0 FALSE FALSE TRUE FALSE FALSE FALSE FALSE
#ASSERT `insider within s 131(1)(f)` `a connection: a person doing business with the corporation`
#ASSERT NOT `insider within s 131(1)(f)` `a connection: none`
-- (g) received material confidential information while a person described in (a) to (f)
`a connection: a former insider who received information` MEANS `a test connection` FALSE FALSE FALSE FALSE 0 FALSE FALSE FALSE TRUE FALSE FALSE FALSE
#ASSERT `insider within s 131(1)(g)` `a connection: a former insider who received information`
#ASSERT NOT `insider within s 131(1)(g)` `a connection: none`
-- (h) received it from a described person AND knows or ought reasonably to have known that
`a connection: a tippee who knew` MEANS `a test connection` FALSE FALSE FALSE FALSE 0 FALSE FALSE FALSE FALSE TRUE TRUE FALSE
`a connection: a tippee who did not and could not know` MEANS `a test connection` FALSE FALSE FALSE FALSE 0 FALSE FALSE FALSE FALSE TRUE FALSE FALSE
`a connection: someone who knows the giver is an insider but received nothing` MEANS `a test connection` FALSE FALSE FALSE FALSE 0 FALSE FALSE FALSE FALSE FALSE TRUE FALSE
#ASSERT `insider within s 131(1)(h)` `a connection: a tippee who knew`
#ASSERT NOT `insider within s 131(1)(h)` `a connection: a tippee who did not and could not know`
#ASSERT NOT `insider within s 131(1)(h)` `a connection: someone who knows the giver is an insider but received nothing`
-- (i) a prescribed person
`a connection: a prescribed person` MEANS `a test connection` FALSE FALSE FALSE FALSE 0 FALSE FALSE FALSE FALSE FALSE FALSE TRUE
#ASSERT `insider within s 131(1)(i)` `a connection: a prescribed person`
#ASSERT NOT `insider within s 131(1)(i)` `a connection: none`

-- the whole definition: any of (a) to (i)
#ASSERT `insider within s 131(1)` `a connection: the corporation itself` (10%)
#ASSERT `insider within s 131(1)` `a connection: an affiliate` (10%)
#ASSERT `insider within s 131(1)` `a connection: a holder of eleven percent` (10%)
#ASSERT `insider within s 131(1)` `a connection: a tippee who knew` (10%)
#ASSERT `insider within s 131(1)` `a connection: a prescribed person` (10%)
#ASSERT NOT `insider within s 131(1)` `a connection: none` (10%)
#ASSERT NOT `insider within s 131(1)` `a connection: a holder of ten percent` (10%)
-- limbs (b) to (i) leave out (a): the corporation itself is not an insider "of a person" under (3.1)
#ASSERT NOT `insider within s 131(1)(b) to (i)` `a connection: the corporation itself` (10%)
#ASSERT `insider within s 131(1)(b) to (i)` `a connection: an affiliate` (10%)
#ASSERT `insider within s 131(1)(b) to (i)` `a connection: a person doing business with the corporation` (10%)
#ASSERT NOT `insider within s 131(1)(b) to (i)` `a connection: none` (10%)

§§ `s 131(2) -- expanded definition of security`

#ASSERT `security of the corporation within s 131(2)` TRUE FALSE FALSE
#ASSERT `security of the corporation within s 131(2)` FALSE TRUE FALSE
#ASSERT `security of the corporation within s 131(2)` FALSE FALSE TRUE
#ASSERT NOT `security of the corporation within s 131(2)` FALSE FALSE FALSE

§§ `s 131(3), (3.1) -- deemed insiders`

#ASSERT `deemed insider within s 131(3)` TRUE FALSE
#ASSERT `deemed insider within s 131(3)` FALSE TRUE
#ASSERT NOT `deemed insider within s 131(3)` FALSE FALSE
-- (3.1): an insider of the (3) person, by (1)(b) to (i), or an affiliate or associate of that person
#ASSERT `insider within s 131(3.1)` `a connection: an affiliate` (10%) FALSE
#ASSERT `insider within s 131(3.1)` `a connection: none` (10%) TRUE
#ASSERT NOT `insider within s 131(3.1)` `a connection: none` (10%) FALSE
-- limb (a), the corporation itself, is not applied to the (3) person
#ASSERT NOT `insider within s 131(3.1)` `a connection: the corporation itself` (10%) FALSE
-- who is an insider for the information at issue
-- arguments: insider by (1), deemed by (3), information obtained from the corporation, insider by (3.1)
#ASSERT `insider with respect to the information within s 131(1), (3) and (3.1)` TRUE FALSE FALSE FALSE
#ASSERT `insider with respect to the information within s 131(1), (3) and (3.1)` FALSE TRUE TRUE FALSE
-- a (3) person is an insider only "with respect to material confidential information obtained from the corporation"
#ASSERT NOT `insider with respect to the information within s 131(1), (3) and (3.1)` FALSE TRUE FALSE FALSE
#ASSERT `insider with respect to the information within s 131(1), (3) and (3.1)` FALSE FALSE FALSE TRUE
#ASSERT NOT `insider with respect to the information within s 131(1), (3) and (3.1)` FALSE FALSE TRUE FALSE

§§ `s 131(4), (5) -- insider trading`

-- the trade: insider for the information, purchases or sells a security, with knowledge of confidential
-- information, that if generally known might reasonably be expected to affect materially the value
#ASSERT `trade described in s 131(4)` TRUE TRUE TRUE TRUE
#ASSERT NOT `trade described in s 131(4)` FALSE TRUE TRUE TRUE
#ASSERT NOT `trade described in s 131(4)` TRUE FALSE TRUE TRUE
#ASSERT NOT `trade described in s 131(4)` TRUE TRUE FALSE TRUE
#ASSERT NOT `trade described in s 131(4)` TRUE TRUE TRUE FALSE
-- the claim; arguments: the trade, defence (a), defence (b), defence (c)
#ASSERT `compensation is owed to the counterparty of the trade within s 131(4)` TRUE FALSE FALSE FALSE
#ASSERT NOT `compensation is owed to the counterparty of the trade within s 131(4)` TRUE TRUE FALSE FALSE
#ASSERT NOT `compensation is owed to the counterparty of the trade within s 131(4)` TRUE FALSE TRUE FALSE
#ASSERT NOT `compensation is owed to the counterparty of the trade within s 131(4)` TRUE FALSE FALSE TRUE
#ASSERT NOT `compensation is owed to the counterparty of the trade within s 131(4)` FALSE FALSE FALSE FALSE
-- (5): accountable to the corporation unless (4)(a) is established; (4)(b) and (c) do not help the insider here
#ASSERT `the insider is accountable to the corporation within s 131(5)` TRUE FALSE
#ASSERT NOT `the insider is accountable to the corporation within s 131(5)` TRUE TRUE
#ASSERT NOT `the insider is accountable to the corporation within s 131(5)` FALSE FALSE
-- the same facts under (4) and (5): defence (b) established (the counterparty knew): no compensation under (4),
-- but still accountable to the corporation under (5), which has no defence (b) input at all
#ASSERT NOT `compensation is owed to the counterparty of the trade within s 131(4)` TRUE FALSE TRUE FALSE
#ASSERT `the insider is accountable to the corporation within s 131(5)` TRUE FALSE

§§ `s 131(6), (7) -- tipping`

-- the disclosure: insider for the information, discloses confidential information about the corporation to
-- another person, not generally disclosed, that if generally known might reasonably be expected to affect
-- the value of the securities materially
#ASSERT `disclosure described in s 131(6)` TRUE TRUE TRUE TRUE
#ASSERT NOT `disclosure described in s 131(6)` FALSE TRUE TRUE TRUE
#ASSERT NOT `disclosure described in s 131(6)` TRUE FALSE TRUE TRUE
#ASSERT NOT `disclosure described in s 131(6)` TRUE TRUE FALSE TRUE
#ASSERT NOT `disclosure described in s 131(6)` TRUE TRUE TRUE FALSE
-- the claim; arguments: the disclosure, claimant traded with a recipient, insider is a (3) or (3.1) person,
-- defence (a), (b), (c), (d)
#ASSERT `compensation is owed to the claimant of the disclosure within s 131(6)` TRUE TRUE FALSE FALSE FALSE FALSE FALSE
#ASSERT NOT `compensation is owed to the claimant of the disclosure within s 131(6)` TRUE TRUE FALSE TRUE FALSE FALSE FALSE
#ASSERT NOT `compensation is owed to the claimant of the disclosure within s 131(6)` TRUE TRUE FALSE FALSE TRUE FALSE FALSE
-- (c) is open to an insider who is not a (3) or (3.1) person
#ASSERT NOT `compensation is owed to the claimant of the disclosure within s 131(6)` TRUE TRUE FALSE FALSE FALSE TRUE FALSE
-- ... and is not open to one who is
#ASSERT `compensation is owed to the claimant of the disclosure within s 131(6)` TRUE TRUE TRUE FALSE FALSE TRUE FALSE
-- (d) is open to a (3) or (3.1) person
#ASSERT NOT `compensation is owed to the claimant of the disclosure within s 131(6)` TRUE TRUE TRUE FALSE FALSE FALSE TRUE
-- ... and is not open to one who is not
#ASSERT `compensation is owed to the claimant of the disclosure within s 131(6)` TRUE TRUE FALSE FALSE FALSE FALSE TRUE
-- the claimant did not trade with a recipient, or there was no such disclosure: no claim
#ASSERT NOT `compensation is owed to the claimant of the disclosure within s 131(6)` TRUE FALSE FALSE FALSE FALSE FALSE FALSE
#ASSERT NOT `compensation is owed to the claimant of the disclosure within s 131(6)` FALSE TRUE FALSE FALSE FALSE FALSE FALSE
-- (7); arguments: the disclosure, (3)/(3.1) person, defence (a), (c), (d)
#ASSERT `the insider is accountable to the corporation for the disclosure within s 131(7)` TRUE FALSE FALSE FALSE FALSE
#ASSERT NOT `the insider is accountable to the corporation for the disclosure within s 131(7)` TRUE FALSE TRUE FALSE FALSE
#ASSERT NOT `the insider is accountable to the corporation for the disclosure within s 131(7)` TRUE FALSE FALSE TRUE FALSE
#ASSERT `the insider is accountable to the corporation for the disclosure within s 131(7)` TRUE TRUE FALSE TRUE FALSE
#ASSERT NOT `the insider is accountable to the corporation for the disclosure within s 131(7)` TRUE TRUE FALSE FALSE TRUE
#ASSERT `the insider is accountable to the corporation for the disclosure within s 131(7)` TRUE FALSE FALSE FALSE TRUE
#ASSERT NOT `the insider is accountable to the corporation for the disclosure within s 131(7)` FALSE FALSE FALSE FALSE FALSE
-- defence (b) of (6) (the claimant knew) removes the claimant's claim under (6) but (7) has no such defence:
-- the same facts leave the insider accountable to the corporation
#ASSERT NOT `compensation is owed to the claimant of the disclosure within s 131(6)` TRUE TRUE FALSE FALSE TRUE FALSE FALSE
#ASSERT `the insider is accountable to the corporation for the disclosure within s 131(7)` TRUE FALSE FALSE FALSE FALSE

§§ `s 131(8) -- the measure of damages`

#ASSERT `the court must consider the comparison with the post-disclosure price within s 131(8)` TRUE
#ASSERT NOT `the court must consider the comparison with the post-disclosure price within s 131(8)` FALSE
-- (a) purchaser: price paid less the average market price over the twenty trading days after disclosure
#ASSERT `amount the court must consider where the plaintiff is a purchaser within s 131(8)(a)` 10.50 9.00 EQUALS 1.5
-- a purchaser who paid less than the later average: a negative amount, still the amount to be considered
#ASSERT `amount the court must consider where the plaintiff is a purchaser within s 131(8)(a)` 8 9 EQUALS (0 MINUS 1)
-- (b) seller: the average market price less the price the plaintiff received
#ASSERT `amount the court must consider where the plaintiff is a seller within s 131(8)(b)` 12 10 EQUALS 2
#ASSERT `amount the court must consider where the plaintiff is a seller within s 131(8)(b)` 12 13 EQUALS (0 MINUS 1)

§§ `s 131(9) -- joint and several liability`

#ASSERT NOT `liability is joint and several within s 131(9)` 0
#ASSERT NOT `liability is joint and several within s 131(9)` 1
#ASSERT `liability is joint and several within s 131(9)` 2
#ASSERT `liability is joint and several within s 131(9)` 3

§§ `s 131(10) -- two years after discovery`

#ASSERT `the last day to commence an action within s 131(10)` (YearMonthDay 2027 3 1) EQUALS (YearMonthDay 2029 3 1)
-- discovered on a leap day: two years later is 28 February (the keel's clamp, fork F1)
#ASSERT `the last day to commence an action within s 131(10)` (YearMonthDay 2028 2 29) EQUALS (YearMonthDay 2030 2 28)
#ASSERT `an action may be commenced within s 131(10)` (YearMonthDay 2027 3 1) (YearMonthDay 2029 3 1)
