IMPORT prelude
IMPORT `cbca-core`
IMPORT `cb5-nouns`
IMPORT `cb5-part20-1-electronic`

-- TESTS of cb5-part20-1-electronic.l4 (ss 252.1 to 252.7). Every expected value is written from the text of
-- the section named beside it, before the run; none is copied from the module's output.

§ `Tests of Part XX.1 (documents in electronic or other form)`

§§ `s 252.1 definitions`

#ASSERT `electronic document within s 252.1` TRUE TRUE TRUE
#ASSERT NOT (`electronic document within s 252.1` FALSE TRUE TRUE)
#ASSERT NOT (`electronic document within s 252.1` TRUE FALSE TRUE)
#ASSERT NOT (`electronic document within s 252.1` TRUE TRUE FALSE)
#ASSERT `information system within s 252.1` TRUE
#ASSERT NOT (`information system within s 252.1` FALSE)

§§ `s 252.2 application`

#ASSERT `Part XX.1 applies within s 252.2` FALSE FALSE
-- Sent to or issued by the Director: outside the Part.
#ASSERT NOT (`Part XX.1 applies within s 252.2` TRUE FALSE)
-- Prescribed to be outside: outside the Part.
#ASSERT NOT (`Part XX.1 applies within s 252.2` FALSE TRUE)
#ASSERT NOT (`Part XX.1 applies within s 252.2` TRUE TRUE)

§§ `s 252.3 use not mandatory, consent, revocation`

#ASSERT NOT `this Act or the regulations require a person to create or provide an electronic document within s 252.3(1)`
-- Consent in the prescribed manner, a designated system, delivery to it.
#ASSERT `the provision of an electronic document satisfies the requirement to provide it to the addressee within s 252.3(2)` TRUE FALSE TRUE TRUE FALSE
-- Provided elsewhere than the designated system: satisfied only if the regulations otherwise prescribe.
#ASSERT NOT (`the provision of an electronic document satisfies the requirement to provide it to the addressee within s 252.3(2)` TRUE FALSE TRUE FALSE FALSE)
#ASSERT `the provision of an electronic document satisfies the requirement to provide it to the addressee within s 252.3(2)` TRUE FALSE TRUE FALSE TRUE
-- No consent, no designated system: not satisfied.
#ASSERT NOT (`the provision of an electronic document satisfies the requirement to provide it to the addressee within s 252.3(2)` FALSE FALSE TRUE TRUE FALSE)
#ASSERT NOT (`the provision of an electronic document satisfies the requirement to provide it to the addressee within s 252.3(2)` TRUE FALSE FALSE TRUE FALSE)
-- Consent revoked: no longer a consent.
#ASSERT NOT (`the provision of an electronic document satisfies the requirement to provide it to the addressee within s 252.3(2)` TRUE TRUE TRUE TRUE FALSE)
#ASSERT `the revocation takes effect within s 252.3(3)` TRUE TRUE
#ASSERT NOT (`the revocation takes effect within s 252.3(3)` FALSE TRUE)
#ASSERT NOT (`the revocation takes effect within s 252.3(3)` TRUE FALSE)

§§ `s 252.4 creation and provision`

#ASSERT `an electronic document satisfies the requirement to create or provide within s 252.4` FALSE TRUE
#ASSERT NOT (`an electronic document satisfies the requirement to create or provide within s 252.4` TRUE TRUE)
#ASSERT NOT (`an electronic document satisfies the requirement to create or provide within s 252.4` FALSE FALSE)
-- Provision to a person: both s 252.4 and s 252.3(2).
#ASSERT `an electronic document satisfies a requirement to provide a notice to a person within s 252.3(2) and s 252.4` TRUE TRUE
#ASSERT NOT (`an electronic document satisfies a requirement to provide a notice to a person within s 252.3(2) and s 252.4` TRUE FALSE)
#ASSERT NOT (`an electronic document satisfies a requirement to provide a notice to a person within s 252.3(2) and s 252.4` FALSE TRUE)

§§ `s 252.5 in writing, copies, registered mail`

#ASSERT `an electronic document satisfies the requirement to create in writing within s 252.5(1)` TRUE TRUE TRUE
#ASSERT NOT (`an electronic document satisfies the requirement to create in writing within s 252.5(1)` FALSE TRUE TRUE)
#ASSERT NOT (`an electronic document satisfies the requirement to create in writing within s 252.5(1)` TRUE FALSE TRUE)
#ASSERT NOT (`an electronic document satisfies the requirement to create in writing within s 252.5(1)` TRUE TRUE FALSE)
#ASSERT `an electronic document satisfies the requirement to provide in writing within s 252.5(2)` TRUE TRUE TRUE
#ASSERT NOT (`an electronic document satisfies the requirement to provide in writing within s 252.5(2)` FALSE TRUE TRUE)
#ASSERT NOT (`an electronic document satisfies the requirement to provide in writing within s 252.5(2)` TRUE FALSE TRUE)
#ASSERT NOT (`an electronic document satisfies the requirement to provide in writing within s 252.5(2)` TRUE TRUE FALSE)
#ASSERT `a single version of an electronic document satisfies the requirement for copies within s 252.5(3)` TRUE TRUE
#ASSERT NOT (`a single version of an electronic document satisfies the requirement for copies within s 252.5(3)` TRUE FALSE)
#ASSERT NOT (`a single version of an electronic document satisfies the requirement for copies within s 252.5(3)` FALSE TRUE)
-- Registered mail: not satisfied by an electronic document unless prescribed.
#ASSERT NOT (`sending an electronic document satisfies the requirement to provide by registered mail within s 252.5(4)` TRUE FALSE)
#ASSERT `sending an electronic document satisfies the requirement to provide by registered mail within s 252.5(4)` TRUE TRUE

§§ `s 252.6 statutory declarations and affidavits; s 252.7 signatures`

#ASSERT `a statutory declaration or affidavit may be created or provided in an electronic document within s 252.6(1)` TRUE TRUE TRUE
#ASSERT NOT (`a statutory declaration or affidavit may be created or provided in an electronic document within s 252.6(1)` FALSE TRUE TRUE)
#ASSERT NOT (`a statutory declaration or affidavit may be created or provided in an electronic document within s 252.6(1)` TRUE FALSE TRUE)
#ASSERT NOT (`a statutory declaration or affidavit may be created or provided in an electronic document within s 252.6(1)` TRUE TRUE FALSE)
#ASSERT `electronic document within s 252.6` TRUE
#ASSERT NOT (`electronic document within s 252.6` FALSE)
#ASSERT `a requirement for a signature or for a document to be executed is satisfied within s 252.7` FALSE TRUE TRUE TRUE TRUE
#ASSERT NOT (`a requirement for a signature or for a document to be executed is satisfied within s 252.7` TRUE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`a requirement for a signature or for a document to be executed is satisfied within s 252.7` FALSE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`a requirement for a signature or for a document to be executed is satisfied within s 252.7` FALSE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`a requirement for a signature or for a document to be executed is satisfied within s 252.7` FALSE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`a requirement for a signature or for a document to be executed is satisfied within s 252.7` FALSE TRUE TRUE TRUE FALSE)
