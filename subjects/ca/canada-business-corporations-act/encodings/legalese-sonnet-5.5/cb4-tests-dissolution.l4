#ASSERT NOT (`the holders of a class have approved the liquidation and dissolution by special resolution within s 211(3)` (`Vote tally` WITH `votes cast in favour` IS 1, `votes cast against` IS 1, `signed by all the shareholders entitled to vote on the resolution` IS FALSE))
#ASSERT `the statement of intent to dissolve has been sent as s 211(4) requires` TRUE
#ASSERT NOT (`the statement of intent to dissolve has been sent as s 211(4) requires` FALSE)
#ASSERT `the Director must issue a certificate of intent to dissolve within s 211(5)` TRUE
#ASSERT NOT (`the Director must issue a certificate of intent to dissolve within s 211(5)` FALSE)
-- (6): after the certificate of intent, only what the liquidation needs.
#ASSERT `the corporation may carry on the business within s 211(6)` FALSE FALSE
#ASSERT `the corporation may carry on the business within s 211(6)` TRUE TRUE
#ASSERT NOT (`the corporation may carry on the business within s 211(6)` TRUE FALSE)
-- (7).
#ASSERT `the corporation must immediately notify each known creditor within s 211(7)(a)` TRUE
#ASSERT NOT (`the corporation must immediately notify each known creditor within s 211(7)(a)` FALSE)
#ASSERT `the corporation must take reasonable steps to give notice in the province within s 211(7)(b)` TRUE TRUE
#ASSERT NOT (`the corporation must take reasonable steps to give notice in the province within s 211(7)(b)` TRUE FALSE)
#ASSERT NOT (`the corporation must take reasonable steps to give notice in the province within s 211(7)(b)` FALSE TRUE)
#ASSERT `the corporation must proceed to collect its property and liquidate its business within s 211(7)(c)` TRUE
#ASSERT NOT (`the corporation must proceed to collect its property and liquidate its business within s 211(7)(c)` FALSE)
