§§ `s 212`

-- (1)(a)(i): certificate dated 1 January 2023: three years end 1 January 2026; the ground exists from 2 January
-- 2026 unless business commenced by 1 January 2026.
#ASSERT `the corporation has not commenced business within three years after the date shown in its certificate of incorporation on a day within s 212(1)(a)(i)` (YMD 2023 1 1) FALSE (YMD 2023 1 1) (YMD 2026 1 2)
#ASSERT NOT (`the corporation has not commenced business within three years after the date shown in its certificate of incorporation on a day within s 212(1)(a)(i)` (YMD 2023 1 1) FALSE (YMD 2023 1 1) (YMD 2026 1 1))
#ASSERT `the corporation has not commenced business within three years after the date shown in its certificate of incorporation on a day within s 212(1)(a)(i)` (YMD 2023 1 1) TRUE (YMD 2026 1 2) (YMD 2027 1 1)
#ASSERT NOT (`the corporation has not commenced business within three years after the date shown in its certificate of incorporation on a day within s 212(1)(a)(i)` (YMD 2023 1 1) TRUE (YMD 2026 1 1) (YMD 2027 1 1))
-- (ii): three consecutive years.
#ASSERT `the corporation has not carried on its business for three consecutive years within s 212(1)(a)(ii)` 3
#ASSERT `the corporation has not carried on its business for three consecutive years within s 212(1)(a)(ii)` 4
#ASSERT NOT (`the corporation has not carried on its business for three consecutive years within s 212(1)(a)(ii)` 2)
-- (iii): default began 1 January 2025: the ground exists from 1 January 2026.
#ASSERT `the corporation is in default for one year in sending a fee, notice, document or information within s 212(1)(a)(iii)` (YMD 2025 1 1) TRUE (YMD 2026 1 1)
#ASSERT NOT (`the corporation is in default for one year in sending a fee, notice, document or information within s 212(1)(a)(iii)` (YMD 2025 1 1) TRUE (YMD 2025 12 31))
#ASSERT NOT (`the corporation is in default for one year in sending a fee, notice, document or information within s 212(1)(a)(iii)` (YMD 2025 1 1) FALSE (YMD 2026 6 1))
-- (iv), (v).
#ASSERT `the corporation has no directors or is in the situation of s 109(4) within s 212(1)(a)(iv)` TRUE FALSE
#ASSERT `the corporation has no directors or is in the situation of s 109(4) within s 212(1)(a)(iv)` FALSE TRUE
#ASSERT NOT (`the corporation has no directors or is in the situation of s 109(4) within s 212(1)(a)(iv)` FALSE FALSE)
#ASSERT `the corporation is a listed entity notified to the Director within s 212(1)(a)(v)` TRUE
#ASSERT NOT (`the corporation is a listed entity notified to the Director within s 212(1)(a)(v)` FALSE)
#ASSERT `the Director may dissolve the corporation on a ground within s 212(1)(a)` TRUE FALSE FALSE FALSE FALSE
#ASSERT `the Director may dissolve the corporation on a ground within s 212(1)(a)` FALSE TRUE FALSE FALSE FALSE
#ASSERT `the Director may dissolve the corporation on a ground within s 212(1)(a)` FALSE FALSE TRUE FALSE FALSE
#ASSERT `the Director may dissolve the corporation on a ground within s 212(1)(a)` FALSE FALSE FALSE TRUE FALSE
#ASSERT `the Director may dissolve the corporation on a ground within s 212(1)(a)` FALSE FALSE FALSE FALSE TRUE
#ASSERT NOT (`the Director may dissolve the corporation on a ground within s 212(1)(a)` FALSE FALSE FALSE FALSE FALSE)
#ASSERT `the Director may apply to a court for an order dissolving the corporation within s 212(1)(b)` TRUE
#ASSERT NOT (`the Director may apply to a court for an order dissolving the corporation within s 212(1)(b)` FALSE)
-- (2), (2.1).
#ASSERT `the Director has met the conditions of s 212(2)` TRUE TRUE TRUE
#ASSERT NOT (`the Director has met the conditions of s 212(2)` FALSE TRUE TRUE)
#ASSERT NOT (`the Director has met the conditions of s 212(2)` TRUE FALSE TRUE)
#ASSERT NOT (`the Director has met the conditions of s 212(2)` TRUE TRUE FALSE)
#ASSERT `subsection 212(2) applies within s 212(2.1)` FALSE
#ASSERT NOT (`subsection 212(2) applies within s 212(2.1)` TRUE)
-- (3): notice given 1 March 2026: 120 days end 29 June; the earliest certificate day is 30 June.
#ASSERT (`the earliest day the certificate of dissolution may be issued within s 212(3)` (YMD 2026 3 1)) EQUALS YMD 2026 6 30
#ASSERT `the Director may issue a certificate of dissolution on a day within s 212(3)` FALSE FALSE TRUE (YMD 2026 3 1) (YMD 2026 6 30)
#ASSERT NOT (`the Director may issue a certificate of dissolution on a day within s 212(3)` FALSE FALSE TRUE (YMD 2026 3 1) (YMD 2026 6 29))
#ASSERT `the Director may issue a certificate of dissolution on a day within s 212(3)` FALSE FALSE FALSE (YMD 2026 3 1) (YMD 2026 3 2)
#ASSERT NOT (`the Director may issue a certificate of dissolution on a day within s 212(3)` TRUE FALSE FALSE (YMD 2026 3 1) (YMD 2026 7 1))
#ASSERT NOT (`the Director may issue a certificate of dissolution on a day within s 212(3)` FALSE TRUE FALSE (YMD 2026 3 1) (YMD 2026 7 1))
#ASSERT `the Director may dissolve the corporation despite the rest of s 212 within s 212(3.1)` TRUE FALSE
#ASSERT `the Director may dissolve the corporation despite the rest of s 212 within s 212(3.1)` FALSE TRUE
#ASSERT NOT (`the Director may dissolve the corporation despite the rest of s 212 within s 212(3.1)` FALSE FALSE)
