#ASSERT NOT (`the corporation shall distribute its remaining property among its shareholders within s 211(7)(d)` TRUE FALSE)
#ASSERT NOT (`the corporation shall distribute its remaining property among its shareholders within s 211(7)(d)` FALSE TRUE)
-- (8), (9).
#ASSERT `the Director or an interested person may apply for the court's supervision within s 211(8)` TRUE TRUE
#ASSERT NOT (`the Director or an interested person may apply for the court's supervision within s 211(8)` FALSE TRUE)
#ASSERT NOT (`the Director or an interested person may apply for the court's supervision within s 211(8)` TRUE FALSE)
#ASSERT `the court may order supervision and make any further order it thinks fit within s 211(8)` TRUE
#ASSERT NOT (`the court may order supervision and make any further order it thinks fit within s 211(8)` FALSE)
