#ASSERT NOT (`the certificate of intent to dissolve may be revoked within s 211(10)` TRUE TRUE TRUE TRUE)
#ASSERT NOT (`the certificate of intent to dissolve may be revoked within s 211(10)` TRUE FALSE FALSE TRUE)
#ASSERT NOT (`the certificate of intent to dissolve may be revoked within s 211(10)` TRUE FALSE TRUE FALSE)
