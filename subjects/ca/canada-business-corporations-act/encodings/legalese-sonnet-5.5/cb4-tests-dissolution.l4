IMPORT prelude
IMPORT `cbca-core`
IMPORT `cbca-core-definitions`
IMPORT `cb4-common`
IMPORT `cb4-dissolution`

-- Tests of cb4-dissolution.l4 (Part XVIII, ss 207 to 213). Every expected value is written from the text
-- of the section named beside it, before the run; none is copied from the encoding's output.

§ `Tests -- ss 207 to 213`

§§ `s 207, s 208`

#ASSERT `a court is the court of this Part within s 207` TRUE
#ASSERT NOT (`a court is the court of this Part within s 207` FALSE)
-- (1): ss 209 and 212 apply even to an insolvent person or bankrupt; the rest of the Part does not.
#ASSERT `this Part applies to the corporation within s 208(1)` FALSE FALSE FALSE
#ASSERT NOT (`this Part applies to the corporation within s 208(1)` FALSE TRUE FALSE)
#ASSERT NOT (`this Part applies to the corporation within s 208(1)` FALSE FALSE TRUE)
#ASSERT `this Part applies to the corporation within s 208(1)` TRUE TRUE TRUE
#ASSERT `this Part applies to the corporation within s 208(1)` TRUE FALSE FALSE
#ASSERT `the proceedings are stayed within s 208(2)` TRUE TRUE
#ASSERT NOT (`the proceedings are stayed within s 208(2)` TRUE FALSE)
#ASSERT NOT (`the proceedings are stayed within s 208(2)` FALSE TRUE)

§§ `s 209`

#ASSERT `an interested person may apply to the Director for revival within s 209(1)` `dissolved under this Part` TRUE
#ASSERT `an interested person may apply to the Director for revival within s 209(1)` `dissolved under section 268 of this Act` TRUE
#ASSERT `an interested person may apply to the Director for revival within s 209(1)` `dissolved under section 261 of the Canada Business Corporations Act, chapter 33 of the Statutes of Canada, 1974-75-76` TRUE
#ASSERT `an interested person may apply to the Director for revival within s 209(1)` `dissolved under subsection 297(6) of the Canada Not-for-profit Corporations Act` TRUE
#ASSERT NOT (`an interested person may apply to the Director for revival within s 209(1)` `dissolved in some other way` TRUE)
#ASSERT NOT (`an interested person may apply to the Director for revival within s 209(1)` `dissolved under this Part` FALSE)
#ASSERT `the articles of revival have been sent as s 209(2) requires` TRUE
#ASSERT NOT (`the articles of revival have been sent as s 209(2) requires` FALSE)
-- (3): both conditions.
#ASSERT `the Director must issue a certificate of revival within s 209(3)` TRUE TRUE FALSE
#ASSERT NOT (`the Director must issue a certificate of revival within s 209(3)` FALSE TRUE FALSE)
#ASSERT NOT (`the Director must issue a certificate of revival within s 209(3)` TRUE FALSE FALSE)
#ASSERT NOT (`the Director must issue a certificate of revival within s 209(3)` TRUE TRUE TRUE)
#ASSERT `the body corporate is revived as a corporation under this Act on a day within s 209(3.1)` (YMD 2026 11 1) (YMD 2026 11 1)
#ASSERT NOT (`the body corporate is revived as a corporation under this Act on a day within s 209(3.1)` (YMD 2026 11 1) (YMD 2026 10 31))
-- (4): restored and liable, except where one of the three matters limits it.
#ASSERT `the revived corporation is restored to its previous position in respect of the matter within s 209(4)(a)` TRUE `none of these`
#ASSERT NOT (`the revived corporation is restored to its previous position in respect of the matter within s 209(4)(a)` TRUE `a reasonable term imposed by the Director`)
#ASSERT NOT (`the revived corporation is restored to its previous position in respect of the matter within s 209(4)(a)` TRUE `a right acquired by a person after the dissolution`)
#ASSERT NOT (`the revived corporation is restored to its previous position in respect of the matter within s 209(4)(a)` TRUE `a change to the internal affairs of the body corporate after its dissolution`)
#ASSERT NOT (`the revived corporation is restored to its previous position in respect of the matter within s 209(4)(a)` FALSE `none of these`)
#ASSERT `the revived corporation is liable for the obligations it would have had in respect of the matter within s 209(4)(b)` TRUE `none of these`
#ASSERT NOT (`the revived corporation is liable for the obligations it would have had in respect of the matter within s 209(4)(b)` TRUE `a reasonable term imposed by the Director`)
#ASSERT NOT (`the revived corporation is liable for the obligations it would have had in respect of the matter within s 209(4)(b)` FALSE `none of these`)
#ASSERT `a legal action taken between dissolution and revival is valid and effective within s 209(5)` TRUE TRUE
#ASSERT NOT (`a legal action taken between dissolution and revival is valid and effective within s 209(5)` TRUE FALSE)
#ASSERT NOT (`a legal action taken between dissolution and revival is valid and effective within s 209(5)` FALSE TRUE)
-- (6): "includes".
#ASSERT (`whether the person is an interested person within s 209(6)` `a shareholder of the dissolved body corporate (s 209(6)(a))` FALSE) EQUALS JUST TRUE
#ASSERT (`whether the person is an interested person within s 209(6)` `a director of the dissolved body corporate (s 209(6)(a))` FALSE) EQUALS JUST TRUE
#ASSERT (`whether the person is an interested person within s 209(6)` `an officer of the dissolved body corporate (s 209(6)(a))` FALSE) EQUALS JUST TRUE
#ASSERT (`whether the person is an interested person within s 209(6)` `an employee of the dissolved body corporate (s 209(6)(a))` FALSE) EQUALS JUST TRUE
#ASSERT (`whether the person is an interested person within s 209(6)` `a creditor of the dissolved body corporate (s 209(6)(a))` FALSE) EQUALS JUST TRUE
#ASSERT (`whether the person is an interested person within s 209(6)` `a person who has a contract with the dissolved body corporate (s 209(6)(b))` FALSE) EQUALS JUST TRUE
-- A contract by gratuitous title in Quebec is excluded from (b): the paragraph does not decide.
#ASSERT (`whether the person is an interested person within s 209(6)` `a person who has a contract with the dissolved body corporate (s 209(6)(b))` TRUE) EQUALS NOTHING
#ASSERT (`whether the person is an interested person within s 209(6)` `a person who would be such a person if a certificate of revival is issued (s 209(6)(c))` FALSE) EQUALS JUST TRUE
#ASSERT (`whether the person is an interested person within s 209(6)` `a trustee in bankruptcy or liquidator for the dissolved body corporate (s 209(6)(d))` FALSE) EQUALS JUST TRUE
#ASSERT (`whether the person is an interested person within s 209(6)` `a person not named in s 209(6)` FALSE) EQUALS NOTHING

§§ `s 210`

#ASSERT `the corporation may be dissolved by resolution of all the directors within s 210(1)` FALSE TRUE
#ASSERT NOT (`the corporation may be dissolved by resolution of all the directors within s 210(1)` TRUE TRUE)
#ASSERT NOT (`the corporation may be dissolved by resolution of all the directors within s 210(1)` FALSE FALSE)
-- (2): no property and no liabilities; one class: the shareholders' special resolution (two-thirds).
#ASSERT `the corporation may be dissolved by special resolution within s 210(2)` TRUE TRUE FALSE (`Vote tally` WITH `votes cast in favour` IS 200, `votes cast against` IS 100, `signed by all the shareholders entitled to vote on the resolution` IS FALSE) FALSE
#ASSERT NOT (`the corporation may be dissolved by special resolution within s 210(2)` TRUE TRUE FALSE (`Vote tally` WITH `votes cast in favour` IS 199, `votes cast against` IS 101, `signed by all the shareholders entitled to vote on the resolution` IS FALSE) FALSE)
#ASSERT NOT (`the corporation may be dissolved by special resolution within s 210(2)` FALSE TRUE FALSE (`Vote tally` WITH `votes cast in favour` IS 200, `votes cast against` IS 100, `signed by all the shareholders entitled to vote on the resolution` IS FALSE) FALSE)
#ASSERT NOT (`the corporation may be dissolved by special resolution within s 210(2)` TRUE FALSE FALSE (`Vote tally` WITH `votes cast in favour` IS 200, `votes cast against` IS 100, `signed by all the shareholders entitled to vote on the resolution` IS FALSE) FALSE)
-- More than one class: each class must pass; the shareholders' tally alone is not enough.
#ASSERT `the corporation may be dissolved by special resolution within s 210(2)` TRUE TRUE TRUE (`Vote tally` WITH `votes cast in favour` IS 0, `votes cast against` IS 100, `signed by all the shareholders entitled to vote on the resolution` IS FALSE) TRUE
#ASSERT NOT (`the corporation may be dissolved by special resolution within s 210(2)` TRUE TRUE TRUE (`Vote tally` WITH `votes cast in favour` IS 200, `votes cast against` IS 100, `signed by all the shareholders entitled to vote on the resolution` IS FALSE) FALSE)
#ASSERT `the holders of a class have approved the dissolution by special resolution within s 210(2)` (`Vote tally` WITH `votes cast in favour` IS 2, `votes cast against` IS 1, `signed by all the shareholders entitled to vote on the resolution` IS FALSE)
#ASSERT NOT (`the holders of a class have approved the dissolution by special resolution within s 210(2)` (`Vote tally` WITH `votes cast in favour` IS 1, `votes cast against` IS 1, `signed by all the shareholders entitled to vote on the resolution` IS FALSE))
-- (3): property or liabilities, with the authorization and the distribution before the articles are sent.
#ASSERT `the corporation may be dissolved by special resolution within s 210(3)` TRUE FALSE (`Vote tally` WITH `votes cast in favour` IS 200, `votes cast against` IS 100, `signed by all the shareholders entitled to vote on the resolution` IS FALSE) FALSE TRUE TRUE
#ASSERT NOT (`the corporation may be dissolved by special resolution within s 210(3)` FALSE FALSE (`Vote tally` WITH `votes cast in favour` IS 200, `votes cast against` IS 100, `signed by all the shareholders entitled to vote on the resolution` IS FALSE) FALSE TRUE TRUE)
#ASSERT NOT (`the corporation may be dissolved by special resolution within s 210(3)` TRUE FALSE (`Vote tally` WITH `votes cast in favour` IS 199, `votes cast against` IS 101, `signed by all the shareholders entitled to vote on the resolution` IS FALSE) FALSE TRUE TRUE)
#ASSERT NOT (`the corporation may be dissolved by special resolution within s 210(3)` TRUE FALSE (`Vote tally` WITH `votes cast in favour` IS 200, `votes cast against` IS 100, `signed by all the shareholders entitled to vote on the resolution` IS FALSE) FALSE FALSE TRUE)
#ASSERT NOT (`the corporation may be dissolved by special resolution within s 210(3)` TRUE FALSE (`Vote tally` WITH `votes cast in favour` IS 200, `votes cast against` IS 100, `signed by all the shareholders entitled to vote on the resolution` IS FALSE) FALSE TRUE FALSE)
#ASSERT `the corporation may be dissolved by special resolution within s 210(3)` TRUE TRUE (`Vote tally` WITH `votes cast in favour` IS 0, `votes cast against` IS 5, `signed by all the shareholders entitled to vote on the resolution` IS FALSE) TRUE TRUE TRUE
#ASSERT NOT (`the corporation may be dissolved by special resolution within s 210(3)` TRUE TRUE (`Vote tally` WITH `votes cast in favour` IS 200, `votes cast against` IS 100, `signed by all the shareholders entitled to vote on the resolution` IS FALSE) FALSE TRUE TRUE)
#ASSERT `the articles of dissolution have been sent as s 210(4) requires` TRUE
#ASSERT NOT (`the articles of dissolution have been sent as s 210(4) requires` FALSE)
#ASSERT `the Director must issue a certificate of dissolution within s 210(5)` TRUE
#ASSERT NOT (`the Director must issue a certificate of dissolution within s 210(5)` FALSE)
-- (6): the corporation exists before the date shown, not on it.
#ASSERT `the corporation exists on a day within s 210(6)` (YMD 2026 12 1) (YMD 2026 11 30)
#ASSERT NOT (`the corporation exists on a day within s 210(6)` (YMD 2026 12 1) (YMD 2026 12 1))
#ASSERT NOT (`the corporation exists on a day within s 210(6)` (YMD 2026 12 1) (YMD 2026 12 2))

§§ `s 211`

#ASSERT `a person may propose voluntary liquidation and dissolution within s 211(1)` TRUE FALSE FALSE
#ASSERT `a person may propose voluntary liquidation and dissolution within s 211(1)` FALSE TRUE TRUE
#ASSERT NOT (`a person may propose voluntary liquidation and dissolution within s 211(1)` FALSE TRUE FALSE)
#ASSERT NOT (`a person may propose voluntary liquidation and dissolution within s 211(1)` FALSE FALSE TRUE)
