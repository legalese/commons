#ASSERT NOT (`the applicant must give the Director notice of the application within s 211(9)` FALSE)
#ASSERT `the Director is entitled to appear and be heard in person or by counsel within s 211(9)` TRUE
#ASSERT NOT (`the Director is entitled to appear and be heard in person or by counsel within s 211(9)` FALSE)
