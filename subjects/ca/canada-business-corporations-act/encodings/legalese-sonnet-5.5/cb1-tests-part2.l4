§§ `s 6(2) to s 6(4)`

-- src:157: the articles may set out provisions that the Act or the law permits in the by-laws.
#ASSERT `the articles may set out the provision within s 6(2)` TRUE
#ASSERT NOT (`the articles may set out the provision within s 6(2)` FALSE)

-- src:161: the articles may not require more votes to remove a director than s 109 does. Take s 109 at two thirds.
#ASSERT `an articles requirement for the removal of a director is permitted within s 6(4)` (2 / 3) (2 / 3)
#ASSERT `an articles requirement for the removal of a director is permitted within s 6(4)` (1 / 2) (2 / 3)
#ASSERT NOT (`an articles requirement for the removal of a director is permitted within s 6(4)` (3 / 4) (2 / 3))

-- src:159: a higher number required by the articles or a unanimous shareholder agreement prevails (3), subject to (4).
-- No articles, no agreement: the Act's number.
#ASSERT `the fraction of the votes needed to effect the action within s 6(3)` (2 / 3) NOTHING NOTHING FALSE EQUALS (2 / 3)
-- the articles require three quarters for an ordinary action: three quarters prevails
#ASSERT `the fraction of the votes needed to effect the action within s 6(3)` (2 / 3) (JUST (3 / 4)) NOTHING FALSE EQUALS (3 / 4)
-- the articles require less than the Act: the Act's number stays (the text speaks only of "a greater number")
#ASSERT `the fraction of the votes needed to effect the action within s 6(3)` (2 / 3) (JUST (1 / 2)) NOTHING FALSE EQUALS (2 / 3)
-- a unanimous shareholder agreement requires a greater number
#ASSERT `the fraction of the votes needed to effect the action within s 6(3)` (2 / 3) NOTHING (JUST (9 / 10)) FALSE EQUALS (9 / 10)
-- the articles require three quarters to remove a director, which s 6(4) bars: the Act's number stays
#ASSERT `the fraction of the votes needed to effect the action within s 6(3)` (2 / 3) (JUST (3 / 4)) NOTHING TRUE EQUALS (2 / 3)
-- the agreement requires three quarters to remove a director: s 6(4) limits only the articles (fork cb1-F2), so it prevails
#ASSERT `the fraction of the votes needed to effect the action within s 6(3)` (2 / 3) NOTHING (JUST (3 / 4)) TRUE EQUALS (3 / 4)

§§ `s 7 and s 8`

-- src:163: articles and the documents required by sections 19 and 106 are all sent.
#ASSERT `the incorporator has complied with the duty to send the articles and documents within s 7` TRUE TRUE TRUE
#ASSERT NOT (`the incorporator has complied with the duty to send the articles and documents within s 7` FALSE TRUE TRUE)
#ASSERT NOT (`the incorporator has complied with the duty to send the articles and documents within s 7` TRUE FALSE TRUE)
#ASSERT NOT (`the incorporator has complied with the duty to send the articles and documents within s 7` TRUE TRUE FALSE)

-- src:165: on receipt, the Director shall issue; src:167: the Director may refuse if a notice indicates non-compliance.
#ASSERT `what the Director must or may do on receiving articles of incorporation within s 8` TRUE FALSE EQUALS `the Director must issue a certificate of incorporation`
#ASSERT `what the Director must or may do on receiving articles of incorporation within s 8` TRUE TRUE EQUALS `the Director may either issue or refuse the certificate of incorporation`
-- no articles received: no duty to issue arises, whatever a notice says
#ASSERT `what the Director must or may do on receiving articles of incorporation within s 8` FALSE FALSE EQUALS `no duty to issue a certificate arises because the Director has not received articles of incorporation`
#ASSERT `what the Director must or may do on receiving articles of incorporation within s 8` FALSE TRUE EQUALS `no duty to issue a certificate arises because the Director has not received articles of incorporation`

§§ `s 9`

-- src:169: a corporation comes into existence on the date shown in the certificate. The day before it does not.
#ASSERT `the corporation has come into existence by the day within s 9` (YMD 2026 3 1) (YMD 2026 3 1)
#ASSERT `the corporation has come into existence by the day within s 9` (YMD 2026 3 1) (YMD 2026 3 2)
#ASSERT NOT (`the corporation has come into existence by the day within s 9` (YMD 2026 3 1) (YMD 2026 2 28))

§§ `s 10`

-- src:171: six words and five abbreviations.
#ASSERT count `the corporate words and abbreviations that s 10(1) lists` EQUALS 11
#ASSERT `the corporate name carries a required word within s 10(1)` (LIST "Inc.")
#ASSERT `the corporate name carries a required word within s 10(1)` (LIST "Société par actions de régime fédéral")
-- the word used only in a figurative or descriptive sense is not counted, so the input list is empty
#ASSERT NOT (`the corporate name carries a required word within s 10(1)` EMPTY)
#ASSERT NOT (`the corporate name carries a required word within s 10(1)` (LIST "Company"))

-- src:173, 175: the saving for "S.C.C." and the exemption of a continued body corporate.
#ASSERT `the corporation must carry a required word in its name within s 10(1), s 10(1.1) and s 10(2)` FALSE FALSE FALSE
#ASSERT NOT (`the corporation must carry a required word in its name within s 10(1), s 10(1.1) and s 10(2)` TRUE FALSE FALSE)
#ASSERT NOT (`the corporation must carry a required word in its name within s 10(1), s 10(1.1) and s 10(2)` FALSE TRUE TRUE)
-- the Director exempts a body that was not continued: there is nothing to exempt, so the duty stays
#ASSERT `the corporation must carry a required word in its name within s 10(1), s 10(1.1) and s 10(2)` FALSE FALSE TRUE

-- src:171: "either the full or the corresponding abbreviated form".
#ASSERT `the corporation may use and be legally designated by the form within s 10(1)` "Ltd." "Ltd."
#ASSERT `the corporation may use and be legally designated by the form within s 10(1)` "Limited" "Ltd."
#ASSERT `the corporation may use and be legally designated by the form within s 10(1)` "Ltd." "Limited"
#ASSERT `the corporation may use and be legally designated by the form within s 10(1)` "Incorporée" "Inc."
#ASSERT `the corporation may use and be legally designated by the form within s 10(1)` "Société par actions de régime fédéral" "S.A.R.F."
-- a form that is not the corresponding one
#ASSERT NOT (`the corporation may use and be legally designated by the form within s 10(1)` "Limited" "Inc.")
#ASSERT NOT (`the corporation may use and be legally designated by the form within s 10(1)` "Corporation" "Ltd.")
-- src:173: a corporation within the saving may use either the expression or the abbreviation.
#ASSERT `the corporation may use and be legally designated by the expression or abbreviation within s 10(1.1)` TRUE "Société commerciale canadienne"
#ASSERT `the corporation may use and be legally designated by the expression or abbreviation within s 10(1.1)` TRUE "S.C.C."
#ASSERT NOT (`the corporation may use and be legally designated by the expression or abbreviation within s 10(1.1)` FALSE "S.C.C.")
#ASSERT NOT (`the corporation may use and be legally designated by the expression or abbreviation within s 10(1.1)` TRUE "Inc.")

-- src:177: forms of the name; a combined form needs the prescribed criteria; subject to s 12(1).
#ASSERT `the form of name may be set out in the articles within s 10(3)` `an English form` FALSE FALSE
#ASSERT `the form of name may be set out in the articles within s 10(3)` `a French form` FALSE FALSE
#ASSERT `the form of name may be set out in the articles within s 10(3)` `an English form and a French form` FALSE FALSE
#ASSERT `the form of name may be set out in the articles within s 10(3)` `a combined English and French form` TRUE FALSE
#ASSERT NOT (`the form of name may be set out in the articles within s 10(3)` `a combined English and French form` FALSE FALSE)
#ASSERT NOT (`the form of name may be set out in the articles within s 10(3)` `an English form` FALSE TRUE)
#ASSERT NOT (`the form of name may be set out in the articles within s 10(3)` `any other form` FALSE FALSE)
#ASSERT `the corporation may use and be legally designated by the form within s 10(3)` TRUE TRUE
#ASSERT NOT (`the corporation may use and be legally designated by the form within s 10(3)` TRUE FALSE)

-- src:179: any language form for use outside Canada, subject to s 12(1).
#ASSERT `the corporation may use and be legally designated by the name outside Canada within s 10(4)` TRUE TRUE FALSE
#ASSERT NOT (`the corporation may use and be legally designated by the name outside Canada within s 10(4)` TRUE FALSE FALSE)
#ASSERT NOT (`the corporation may use and be legally designated by the name outside Canada within s 10(4)` TRUE TRUE TRUE)

-- src:181: the name in legible characters in contracts, invoices, negotiable instruments and orders.
#ASSERT `the corporation must set out its name in legible characters on the document within s 10(5)` `a contract issued or made by or on behalf of the corporation`
#ASSERT `the corporation must set out its name in legible characters on the document within s 10(5)` `an invoice issued or made by or on behalf of the corporation`
#ASSERT `the corporation must set out its name in legible characters on the document within s 10(5)` `a negotiable instrument issued or made by or on behalf of the corporation`
#ASSERT `the corporation must set out its name in legible characters on the document within s 10(5)` `an order for goods or services issued or made by or on behalf of the corporation`
#ASSERT NOT (`the corporation must set out its name in legible characters on the document within s 10(5)` `any other document`)
#ASSERT `the corporation has complied with the duty to set out its name within s 10(5)` TRUE TRUE
#ASSERT NOT (`the corporation has complied with the duty to set out its name within s 10(5)` TRUE FALSE)
#ASSERT `the corporation has complied with the duty to set out its name within s 10(5)` FALSE FALSE

-- src:183: another name for business, if it does not contain a corporate word (other than figuratively), subject to s 12(1).
#ASSERT `the corporation may carry on business under or identify itself by the other name within s 10(6)` EMPTY FALSE
#ASSERT NOT (`the corporation may carry on business under or identify itself by the other name within s 10(6)` (LIST "Ltd.") FALSE)
#ASSERT NOT (`the corporation may carry on business under or identify itself by the other name within s 10(6)` EMPTY TRUE)

§§ `s 11`

-- src:185: the Director may, on request, reserve a name for an intended corporation or one that intends to change its name.
#ASSERT `the Director may reserve the name within s 11(1)` TRUE TRUE
#ASSERT NOT (`the Director may reserve the name within s 11(1)` FALSE TRUE)
#ASSERT NOT (`the Director may reserve the name within s 11(1)` TRUE FALSE)

DECIDE `ninety days` IS `Time limit` WITH
    `number of units` IS 90
    `unit of time` IS `calendar days`

-- the prescribed period is not in the sources: take ninety days as a stand-in, and count from the day of reservation (fork F1).
#ASSERT `the last day the name stays reserved within s 11(1)` (YMD 2026 1 1) `ninety days` EQUALS YMD 2026 4 1

-- src:187: on request, the Director shall assign a designating number name.
#ASSERT `the Director must assign a designating number name within s 11(2)` TRUE FALSE
#ASSERT `the Director must assign a designating number name within s 11(2)` FALSE TRUE
#ASSERT NOT (`the Director must assign a designating number name within s 11(2)` FALSE FALSE)
#ASSERT `the name is a designating number name within s 11(2)` TRUE "Ltd."
#ASSERT `the name is a designating number name within s 11(2)` TRUE "Société par actions de régime fédéral"
#ASSERT NOT (`the name is a designating number name within s 11(2)` TRUE "Company")
#ASSERT NOT (`the name is a designating number name within s 11(2)` FALSE "Inc.")

§§ `s 12`

-- src:189: a name prohibited by the regulations, or one that does not meet the prescribed requirements.
#ASSERT `the name is prohibited within s 12(1)` TRUE TRUE
#ASSERT `the name is prohibited within s 12(1)` FALSE FALSE
#ASSERT `the name is prohibited within s 12(1)` TRUE FALSE
#ASSERT NOT (`the name is prohibited within s 12(1)` FALSE TRUE)

-- src:191: the Director may direct a change of name if the corporation acquires a prohibited name.
#ASSERT `the Director may direct the corporation to change its name within s 12(2)` TRUE TRUE FALSE
#ASSERT NOT (`the Director may direct the corporation to change its name within s 12(2)` FALSE TRUE FALSE)
#ASSERT NOT (`the Director may direct the corporation to change its name within s 12(2)` TRUE FALSE TRUE)

-- src:194: a designating number as the name: the Director may direct a change.
#ASSERT `the Director may direct the corporation to change a designating number name within s 12(4)` TRUE
#ASSERT NOT (`the Director may direct the corporation to change a designating number name within s 12(4)` FALSE)

-- src:196: an undertaking not honoured within the s 12(5) period.
#ASSERT `the Director may direct the corporation to change its name because an undertaking was not honoured within s 12(4.1)` TRUE FALSE
#ASSERT NOT (`the Director may direct the corporation to change its name because an undertaking was not honoured within s 12(4.1)` TRUE TRUE)
#ASSERT NOT (`the Director may direct the corporation to change its name because an undertaking was not honoured within s 12(4.1)` FALSE FALSE)

-- src:198: a directive not followed within the prescribed period: the Director may revoke the name and assign one.
#ASSERT `the Director may revoke the corporation's name and assign a name within s 12(5)` TRUE FALSE
#ASSERT NOT (`the Director may revoke the corporation's name and assign a name within s 12(5)` TRUE TRUE)
#ASSERT NOT (`the Director may revoke the corporation's name and assign a name within s 12(5)` FALSE FALSE)

DECIDE `thirty days` IS `Time limit` WITH
    `number of units` IS 30
    `unit of time` IS `calendar days`

#ASSERT `the last day for the corporation to follow the directive within s 12(5)` (YMD 2026 6 1) `thirty days` EQUALS YMD 2026 7 1

-- src:198: until changed under section 173 the name is the name the Director assigned.
#ASSERT `the name of the corporation within s 12(5)` "Old Ltd." FALSE "" FALSE "" EQUALS "Old Ltd."
#ASSERT `the name of the corporation within s 12(5)` "Old Ltd." TRUE "123 Canada Inc." FALSE "" EQUALS "123 Canada Inc."
#ASSERT `the name of the corporation within s 12(5)` "Old Ltd." TRUE "123 Canada Inc." TRUE "New Ltd." EQUALS "New Ltd."

§§ `s 13`

-- src:200: after a revocation, the Director shall issue a certificate of amendment and give notice.
#ASSERT `the Director must issue a certificate of amendment and give notice of the new name within s 13(1)` TRUE
#ASSERT NOT (`the Director must issue a certificate of amendment and give notice of the new name within s 13(1)` FALSE)
-- src:202: the articles are amended on the date shown in the certificate.
#ASSERT `the articles are amended by the certificate of amendment by the day within s 13(2)` (YMD 2026 5 5) (YMD 2026 5 5)
#ASSERT NOT (`the articles are amended by the certificate of amendment by the day within s 13(2)` (YMD 2026 5 5) (YMD 2026 5 4))

§§ `s 14`

-- src:204: a person who enters into a written contract in the name of a corporation not yet in existence is personally bound.
#ASSERT `the person is personally bound by the pre-incorporation contract at the outset within s 14(1)` TRUE TRUE TRUE
#ASSERT NOT (`the person is personally bound by the pre-incorporation contract at the outset within s 14(1)` FALSE TRUE TRUE)
#ASSERT NOT (`the person is personally bound by the pre-incorporation contract at the outset within s 14(1)` TRUE FALSE TRUE)
#ASSERT NOT (`the person is personally bound by the pre-incorporation contract at the outset within s 14(1)` TRUE TRUE FALSE)

-- src:206: adoption needs a written pre-incorporation contract, conduct signifying intention, and a reasonable time.
#ASSERT `the corporation has adopted the contract within s 14(2)` TRUE TRUE TRUE
#ASSERT NOT (`the corporation has adopted the contract within s 14(2)` TRUE TRUE FALSE)
#ASSERT NOT (`the corporation has adopted the contract within s 14(2)` TRUE FALSE TRUE)
#ASSERT NOT (`the corporation has adopted the contract within s 14(2)` FALSE TRUE TRUE)

-- src:207: on adoption the corporation is bound and entitled.
#ASSERT `the corporation is bound by and entitled to the benefits of the contract as if it had been a party from the date of the contract within s 14(2)(a)` TRUE
#ASSERT NOT (`the corporation is bound by and entitled to the benefits of the contract as if it had been a party from the date of the contract within s 14(2)(a)` FALSE)

-- src:208, 210, 212: bound at the outset; ceases on adoption unless a court order says otherwise; exempt if the contract says so.
#ASSERT `the person is personally bound by and entitled to the benefits of the contract within s 14` TRUE FALSE FALSE FALSE
#ASSERT NOT (`the person is personally bound by and entitled to the benefits of the contract within s 14` TRUE TRUE FALSE FALSE)
#ASSERT `the person is personally bound by and entitled to the benefits of the contract within s 14` TRUE TRUE FALSE TRUE
#ASSERT NOT (`the person is personally bound by and entitled to the benefits of the contract within s 14` TRUE FALSE TRUE FALSE)
-- (3) is subject to (4): a court order does not bind a person whom the contract exempts
#ASSERT NOT (`the person is personally bound by and entitled to the benefits of the contract within s 14` TRUE TRUE TRUE TRUE)
#ASSERT NOT (`the person is personally bound by and entitled to the benefits of the contract within s 14` FALSE FALSE FALSE FALSE)

-- src:210: a party may apply to a court whether or not the contract was adopted; the court may make any order it thinks fit.
#ASSERT `a party may apply to a court for an order within s 14(3)` TRUE TRUE
#ASSERT NOT (`a party may apply to a court for an order within s 14(3)` TRUE FALSE)
#ASSERT `the court may make an order about the obligations of the person within s 14(3)` TRUE FALSE
#ASSERT NOT (`the court may make an order about the obligations of the person within s 14(3)` TRUE TRUE)
#ASSERT NOT (`the court may make an order about the obligations of the person within s 14(3)` FALSE FALSE)

-- src:212: expressly so provided in the contract.
#ASSERT `the person is exempt from the contract within s 14(4)` TRUE
#ASSERT NOT (`the person is exempt from the contract within s 14(4)` FALSE)
