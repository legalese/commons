IMPORT prelude
IMPORT `cbca-core`
IMPORT `cb5-nouns`
IMPORT `cb5-part21-charter`

-- TESTS of cb5-part21-charter.l4 (s 268). Every expected value is written from the text of the subsection
-- named beside it, before the run; none is copied from the module's output.

§ `Tests of section 268`

§§ `s 268(1), s 268(4.2) definitions`

#ASSERT `charter within s 268(1)` FALSE TRUE FALSE
#ASSERT `charter within s 268(1)` FALSE FALSE TRUE
#ASSERT `charter within s 268(1)` TRUE FALSE FALSE
#ASSERT NOT (`charter within s 268(1)` FALSE FALSE FALSE)
#ASSERT `the body corporate is deemed to be incorporated or continued by or under an Act of Parliament other than this Act or a special Act within s 268(4.2)` TRUE TRUE FALSE FALSE FALSE
#ASSERT `the body corporate is deemed to be incorporated or continued by or under an Act of Parliament other than this Act or a special Act within s 268(4.2)` TRUE FALSE TRUE FALSE FALSE
#ASSERT `the body corporate is deemed to be incorporated or continued by or under an Act of Parliament other than this Act or a special Act within s 268(4.2)` TRUE FALSE FALSE TRUE FALSE
#ASSERT `the body corporate is deemed to be incorporated or continued by or under an Act of Parliament other than this Act or a special Act within s 268(4.2)` TRUE FALSE FALSE FALSE TRUE
#ASSERT NOT (`the body corporate is deemed to be incorporated or continued by or under an Act of Parliament other than this Act or a special Act within s 268(4.2)` TRUE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`the body corporate is deemed to be incorporated or continued by or under an Act of Parliament other than this Act or a special Act within s 268(4.2)` FALSE TRUE FALSE FALSE FALSE)

§§ `s 268(2), (2.1), (3) amending the charter on a continuance`

#ASSERT `the shareholders may authorize the directors and amend the charter by special resolution despite the charter within s 268(2)` TRUE TRUE TRUE
#ASSERT NOT (`the shareholders may authorize the directors and amend the charter by special resolution despite the charter within s 268(2)` FALSE TRUE TRUE)
#ASSERT NOT (`the shareholders may authorize the directors and amend the charter by special resolution despite the charter within s 268(2)` TRUE FALSE TRUE)
#ASSERT NOT (`the shareholders may authorize the directors and amend the charter by special resolution despite the charter within s 268(2)` TRUE TRUE FALSE)
#ASSERT `the shareholders may authorize the directors and amend the charter by special resolution subject to any other Act and the charter within s 268(2.1)` TRUE TRUE TRUE FALSE
-- Subject to any other Act or the charter: where one forbids it, the power is not there.
#ASSERT NOT (`the shareholders may authorize the directors and amend the charter by special resolution subject to any other Act and the charter within s 268(2.1)` TRUE TRUE TRUE TRUE)
#ASSERT NOT (`the shareholders may authorize the directors and amend the charter by special resolution subject to any other Act and the charter within s 268(2.1)` TRUE FALSE TRUE FALSE)
-- (3): a change of the s 176(1) nature affecting a class or series needs the charter's permission (for (a), (b), (e)) or the holders' approval.
#ASSERT `the shareholders may make the change by special resolution under subsection 268(2) or (2.1) within s 268(3)` FALSE FALSE FALSE FALSE
#ASSERT NOT (`the shareholders may make the change by special resolution under subsection 268(2) or (2.1) within s 268(3)` TRUE FALSE FALSE FALSE)
#ASSERT `the shareholders may make the change by special resolution under subsection 268(2) or (2.1) within s 268(3)` TRUE TRUE TRUE FALSE
-- The charter provides otherwise, but the change is not of the nature in (a), (b) or (e): not enough.
#ASSERT NOT (`the shareholders may make the change by special resolution under subsection 268(2) or (2.1) within s 268(3)` TRUE FALSE TRUE FALSE)
#ASSERT `the shareholders may make the change by special resolution under subsection 268(2) or (2.1) within s 268(3)` TRUE FALSE FALSE TRUE

§§ `s 268(4), (4.1), (5) the directors apply; no dissent`

#ASSERT `the directors may apply for a certificate of continuance despite the charter within s 268(4)` TRUE TRUE
#ASSERT NOT (`the directors may apply for a certificate of continuance despite the charter within s 268(4)` TRUE FALSE)
#ASSERT NOT (`the directors may apply for a certificate of continuance despite the charter within s 268(4)` FALSE TRUE)
#ASSERT `the directors may apply for a certificate of continuance subject to any other Act and the charter within s 268(4.1)` TRUE TRUE FALSE
#ASSERT NOT (`the directors may apply for a certificate of continuance subject to any other Act and the charter within s 268(4.1)` TRUE TRUE TRUE)
#ASSERT NOT (`the directors may apply for a certificate of continuance subject to any other Act and the charter within s 268(4.1)` TRUE FALSE FALSE)
#ASSERT `a shareholder is not entitled to dissent under section 190 within s 268(5)` TRUE
#ASSERT NOT (`a shareholder is not entitled to dissent under section 190 within s 268(5)` FALSE)

§§ `s 268(6), (9) discretionary continuance and dissolution`

#ASSERT `the Governor in Council may require the body corporate to apply for a certificate of continuance within s 268(6)` TRUE FALSE FALSE FALSE FALSE FALSE
#ASSERT NOT (`the Governor in Council may require the body corporate to apply for a certificate of continuance within s 268(6)` FALSE FALSE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`the Governor in Council may require the body corporate to apply for a certificate of continuance within s 268(6)` TRUE TRUE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`the Governor in Council may require the body corporate to apply for a certificate of continuance within s 268(6)` TRUE FALSE TRUE FALSE FALSE FALSE)
#ASSERT NOT (`the Governor in Council may require the body corporate to apply for a certificate of continuance within s 268(6)` TRUE FALSE FALSE TRUE FALSE FALSE)
#ASSERT NOT (`the Governor in Council may require the body corporate to apply for a certificate of continuance within s 268(6)` TRUE FALSE FALSE FALSE TRUE FALSE)
#ASSERT NOT (`the Governor in Council may require the body corporate to apply for a certificate of continuance within s 268(6)` TRUE FALSE FALSE FALSE FALSE TRUE)
-- (9): dissolved on the expiration of the period.
#ASSERT `the body corporate is dissolved on the expiration of the period within s 268(9)` TRUE FALSE (YMD 2028 1 1) (YMD 2027 12 31)
#ASSERT NOT (`the body corporate is dissolved on the expiration of the period within s 268(9)` TRUE FALSE (YMD 2027 12 31) (YMD 2027 12 31))
#ASSERT NOT (`the body corporate is dissolved on the expiration of the period within s 268(9)` TRUE TRUE (YMD 2028 1 1) (YMD 2027 12 31))
#ASSERT NOT (`the body corporate is dissolved on the expiration of the period within s 268(9)` FALSE FALSE (YMD 2028 1 1) (YMD 2027 12 31))

§§ `s 268(8), (8.1), (10), (11) fees, special Act, who may apply`

#ASSERT `the body corporate is not required to pay the fees otherwise payable for the continuance within s 268(8)` TRUE
#ASSERT NOT (`the body corporate is not required to pay the fees otherwise payable for the continuance within s 268(8)` FALSE)
#ASSERT `the special Act ceases to apply to the corporation within s 268(8.1)` TRUE
#ASSERT NOT (`the special Act ceases to apply to the corporation within s 268(8.1)` FALSE)
#ASSERT `the body corporate may not apply for a certificate of continuance under section 187 within s 268(10)` TRUE FALSE
#ASSERT `the body corporate may not apply for a certificate of continuance under section 187 within s 268(10)` FALSE TRUE
#ASSERT NOT (`the body corporate may not apply for a certificate of continuance under section 187 within s 268(10)` FALSE FALSE)
#ASSERT `the body corporate may apply for a certificate of continuance under section 187 within s 268(11)` TRUE
#ASSERT NOT (`the body corporate may apply for a certificate of continuance under section 187 within s 268(11)` FALSE)
-- Together: (11) is an exception to (10).
#ASSERT `the body corporate may apply for a certificate of continuance within s 268(10) and s 268(11)` TRUE TRUE
#ASSERT `the body corporate may apply for a certificate of continuance within s 268(10) and s 268(11)` FALSE FALSE
#ASSERT NOT (`the body corporate may apply for a certificate of continuance within s 268(10) and s 268(11)` TRUE FALSE)
