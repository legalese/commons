IMPORT prelude
IMPORT `cbca-core`
IMPORT `cb2-nouns`
IMPORT `cb2-part7-registers`

-- Tests of cb2-part7-registers.l4 (ss 50 to 54). Every expected value is written from the text of the
-- provision named beside it, not from the output of the rule.

§ `Tests of ss 50 to 54`

§§ `s 50(1) the register`
#ASSERT `the corporation maintains the securities register as required within s 50(1)` TRUE TRUE TRUE TRUE
#ASSERT NOT (`the corporation maintains the securities register as required within s 50(1)` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`the corporation maintains the securities register as required within s 50(1)` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`the corporation maintains the securities register as required within s 50(1)` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`the corporation maintains the securities register as required within s 50(1)` TRUE TRUE TRUE FALSE)

§§ `s 50(2) to (6)`
#ASSERT `the corporation may appoint the person to maintain a central or branch securities register within s 50(2)` TRUE
#ASSERT NOT (`the corporation may appoint the person to maintain a central or branch securities register within s 50(2)` FALSE)
-- args: kept at the registered office, kept at another place in Canada designated by the directors
#ASSERT `the central securities register is kept at a permitted place within s 50(3)` TRUE FALSE
#ASSERT `the central securities register is kept at a permitted place within s 50(3)` FALSE TRUE
-- a central register kept outside Canada, away from the registered office, is not at a permitted place
#ASSERT NOT (`the central securities register is kept at a permitted place within s 50(3)` FALSE FALSE)
#ASSERT `a branch securities register is kept at a permitted place within s 50(3)` TRUE
#ASSERT NOT (`a branch securities register is kept at a permitted place within s 50(3)` FALSE)
-- args: registered in the central register, registered in a branch register
#ASSERT `the registration is complete and valid for all purposes within s 50(4)` TRUE FALSE
#ASSERT `the registration is complete and valid for all purposes within s 50(4)` FALSE TRUE
#ASSERT NOT (`the registration is complete and valid for all purposes within s 50(4)` FALSE FALSE)
#ASSERT `a branch securities register contains only what it may within s 50(5)` TRUE
#ASSERT NOT (`a branch securities register contains only what it may within s 50(5)` FALSE)
-- args: registered in a branch register, also kept in the central register
#ASSERT `the particulars are also kept in the central securities register as required within s 50(6)` TRUE TRUE
#ASSERT `the particulars are also kept in the central securities register as required within s 50(6)` FALSE FALSE
#ASSERT NOT (`the particulars are also kept in the central securities register as required within s 50(6)` TRUE FALSE)

§§ `s 50(7) destruction of certificates: when the instrument need not be produced`
-- args: form, date cancelled if it was, date expired if it did, the day asked about
-- (a) registered form: six years after the date of cancellation (cancelled 1 March 2020: 1 March 2026 is six years after)
#ASSERT `the corporation, its agent or a trustee need not produce the instrument within s 50(7)` `an instrument in registered form under s 50(7)` (JUST (YearMonthDay 2020 3 1)) NOTHING (YearMonthDay 2026 3 1)
#ASSERT NOT (`the corporation, its agent or a trustee need not produce the instrument within s 50(7)` `an instrument in registered form under s 50(7)` (JUST (YearMonthDay 2020 3 1)) NOTHING (YearMonthDay 2026 2 28))
-- cancelled on 29 February 2020: six years later falls on 28 February 2026 (the core's counting convention)
#ASSERT `the corporation, its agent or a trustee need not produce the instrument within s 50(7)` `an instrument in registered form under s 50(7)` (JUST (YearMonthDay 2020 2 29)) NOTHING (YearMonthDay 2026 2 28)
-- not cancelled: limb (a) does not apply
#ASSERT NOT (`the corporation, its agent or a trustee need not produce the instrument within s 50(7)` `an instrument in registered form under s 50(7)` NOTHING NOTHING (YearMonthDay 2040 1 1))
-- (b) bearer form: after the date of cancellation
#ASSERT `the corporation, its agent or a trustee need not produce the instrument within s 50(7)` `an instrument in bearer form under s 50(7)` (JUST (YearMonthDay 2020 3 1)) NOTHING (YearMonthDay 2020 3 2)
#ASSERT NOT (`the corporation, its agent or a trustee need not produce the instrument within s 50(7)` `an instrument in bearer form under s 50(7)` (JUST (YearMonthDay 2020 3 1)) NOTHING (YearMonthDay 2020 3 1))
-- (c) an expired instrument: after the date of its expiration, whatever its form
#ASSERT `the corporation, its agent or a trustee need not produce the instrument within s 50(7)` `an instrument in neither registered nor bearer form under s 50(7)` NOTHING (JUST (YearMonthDay 2020 3 1)) (YearMonthDay 2020 3 2)
#ASSERT NOT (`the corporation, its agent or a trustee need not produce the instrument within s 50(7)` `an instrument in neither registered nor bearer form under s 50(7)` NOTHING (JUST (YearMonthDay 2020 3 1)) (YearMonthDay 2020 3 1))
#ASSERT `the corporation, its agent or a trustee need not produce the instrument within s 50(7)` `an instrument in registered form under s 50(7)` NOTHING (JUST (YearMonthDay 2020 3 1)) (YearMonthDay 2020 3 2)
-- not relieved: cancelled, but in neither form, and not expired
#ASSERT NOT (`the corporation, its agent or a trustee need not produce the instrument within s 50(7)` `an instrument in neither registered nor bearer form under s 50(7)` (JUST (YearMonthDay 2020 3 1)) NOTHING (YearMonthDay 2040 1 1))

§§ `s 51(1) to (6)`
-- args: registered owner, ss 134/135/138 limit it
#ASSERT `the corporation may treat the registered owner as exclusively entitled within s 51(1)` TRUE FALSE
#ASSERT NOT (`the corporation may treat the registered owner as exclusively entitled within s 51(1)` TRUE TRUE)
#ASSERT NOT (`the corporation may treat the registered owner as exclusively entitled within s 51(1)` FALSE FALSE)
-- s 51(2): shall (articles restrict transfer), may (they do not), not covered (no capacity or no evidence)
#ASSERT `whether the corporation must or may treat the person as a registered security holder within s 51(2)` TRUE `the heir of a deceased security holder` TRUE EQUALS (JUST `the corporation must treat the person as a registered security holder`)
#ASSERT `whether the corporation must or may treat the person as a registered security holder within s 51(2)` FALSE `the heir of a deceased security holder` TRUE EQUALS (JUST `the corporation may treat the person as a registered security holder`)
#ASSERT `whether the corporation must or may treat the person as a registered security holder within s 51(2)` TRUE `a liquidator of a registered security holder` TRUE EQUALS (JUST `the corporation must treat the person as a registered security holder`)
#ASSERT `whether the corporation must or may treat the person as a registered security holder within s 51(2)` FALSE `a trustee in bankruptcy for a registered security holder` TRUE EQUALS (JUST `the corporation may treat the person as a registered security holder`)
#ASSERT `whether the corporation must or may treat the person as a registered security holder within s 51(2)` TRUE `a personal representative of a registered security holder who is an infant, an incapable person or a missing person` TRUE EQUALS (JUST `the corporation must treat the person as a registered security holder`)
#ASSERT `whether the corporation must or may treat the person as a registered security holder within s 51(2)` TRUE `the personal representative of the estate or succession of a deceased security holder` FALSE EQUALS NOTHING
#ASSERT `whether the corporation must or may treat the person as a registered security holder within s 51(2)` TRUE `a person in none of these capacities under s 51(2)` TRUE EQUALS NOTHING
-- s 51(3) args: devolves by operation of law, capacity of the person, not registered in their name, proof of authority
#ASSERT `the corporation must treat the person as entitled to exercise the rights within s 51(3)` TRUE `a person in none of these capacities under s 51(2)` TRUE TRUE
#ASSERT NOT (`the corporation must treat the person as entitled to exercise the rights within s 51(3)` TRUE `the heir of a deceased security holder` TRUE TRUE)
#ASSERT NOT (`the corporation must treat the person as entitled to exercise the rights within s 51(3)` TRUE `a liquidator of a registered security holder` TRUE TRUE)
#ASSERT NOT (`the corporation must treat the person as entitled to exercise the rights within s 51(3)` TRUE `a person in none of these capacities under s 51(2)` TRUE FALSE)
#ASSERT NOT (`the corporation must treat the person as entitled to exercise the rights within s 51(3)` FALSE `a person in none of these capacities under s 51(2)` TRUE TRUE)
#ASSERT NOT (`the corporation must treat the person as entitled to exercise the rights within s 51(3)` TRUE `a person in none of these capacities under s 51(2)` FALSE TRUE)
-- args: owed to a third person, by a registered holder, by a person treated as owner under s 51
#ASSERT `the corporation is not required to inquire into or see to the duty within s 51(4)` TRUE TRUE FALSE
#ASSERT `the corporation is not required to inquire into or see to the duty within s 51(4)` TRUE FALSE TRUE
#ASSERT NOT (`the corporation is not required to inquire into or see to the duty within s 51(4)` FALSE TRUE FALSE)
#ASSERT NOT (`the corporation is not required to inquire into or see to the duty within s 51(4)` TRUE FALSE FALSE)
-- s 51(5): under 18 when exercising rights; 18 itself is not "less than 18"
#ASSERT `a later repudiation, avoidance, annulment or reduction of obligations is ineffective against the corporation within s 51(5)` 17
#ASSERT NOT (`a later repudiation, avoidance, annulment or reduction of obligations is ineffective against the corporation within s 51(5)` 18)
-- args: issued to joint holders, proof of death received, satisfied with the proof
#ASSERT `the corporation may treat the survivors as owner of the security within s 51(6)` TRUE TRUE TRUE
#ASSERT NOT (`the corporation may treat the survivors as owner of the security within s 51(6)` TRUE TRUE FALSE)
#ASSERT NOT (`the corporation may treat the survivors as owner of the security within s 51(6)` TRUE FALSE TRUE)
#ASSERT NOT (`the corporation may treat the survivors as owner of the security within s 51(6)` FALSE TRUE TRUE)

§§ `s 51(7) to (9) transmission on death`
-- a person referred to in paragraph 51(2)(a) is the heir, the personal representative of the heirs, or of the estate or succession
#ASSERT `the person is a person referred to in paragraph 51(2)(a) within s 51(2)` `the heir of a deceased security holder`
#ASSERT `the person is a person referred to in paragraph 51(2)(a) within s 51(2)` `the personal representative of the heirs of a deceased security holder`
#ASSERT `the person is a person referred to in paragraph 51(2)(a) within s 51(2)` `the personal representative of the estate or succession of a deceased security holder`
#ASSERT NOT (`the person is a person referred to in paragraph 51(2)(a) within s 51(2)` `a personal representative of a registered security holder who is an infant, an incapable person or a missing person`)
#ASSERT NOT (`the person is a person referred to in paragraph 51(2)(a) within s 51(2)` `a trustee in bankruptcy for a registered security holder`)
#ASSERT NOT (`the person is a person referred to in paragraph 51(2)(a) within s 51(2)` `a person in none of these capacities under s 51(2)`)
-- the documents (7): original grant; certified copy; Quebec authentic copy; affidavit; the certificate; transfer is to a (2)(a) person; certificate endorsed per s 65; assurance
#ASSERT `the documents required by subsection 51(7) have been deposited within s 51(7)` TRUE FALSE FALSE TRUE TRUE TRUE FALSE TRUE
#ASSERT `the documents required by subsection 51(7) have been deposited within s 51(7)` FALSE TRUE FALSE TRUE TRUE FALSE TRUE TRUE
#ASSERT `the documents required by subsection 51(7) have been deposited within s 51(7)` FALSE FALSE TRUE TRUE TRUE TRUE FALSE TRUE
-- a transfer to anyone else needs the certificate endorsed under section 65
#ASSERT NOT (`the documents required by subsection 51(7) have been deposited within s 51(7)` TRUE FALSE FALSE TRUE TRUE FALSE FALSE TRUE)
-- no probate document at all
#ASSERT NOT (`the documents required by subsection 51(7) have been deposited within s 51(7)` FALSE FALSE FALSE TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`the documents required by subsection 51(7) have been deposited within s 51(7)` TRUE FALSE FALSE FALSE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`the documents required by subsection 51(7) have been deposited within s 51(7)` TRUE FALSE FALSE TRUE FALSE TRUE FALSE TRUE)
#ASSERT NOT (`the documents required by subsection 51(7) have been deposited within s 51(7)` TRUE FALSE FALSE TRUE TRUE TRUE FALSE FALSE)
-- the entitlement: capacity, then the same eight deposit facts, then tax-collection law
#ASSERT `the person is entitled to become or designate a registered holder within s 51(7)` `the heir of a deceased security holder` TRUE FALSE FALSE TRUE TRUE TRUE FALSE TRUE FALSE
#ASSERT `the person is entitled to become or designate a registered holder within s 51(7)` `the personal representative of the estate or succession of a deceased security holder` FALSE TRUE FALSE TRUE TRUE FALSE TRUE TRUE FALSE
-- a (2)(b) or (c) person is not within s 51(7)
#ASSERT NOT (`the person is entitled to become or designate a registered holder within s 51(7)` `a liquidator of a registered security holder` TRUE FALSE FALSE TRUE TRUE TRUE FALSE TRUE FALSE)
#ASSERT NOT (`the person is entitled to become or designate a registered holder within s 51(7)` `a person in none of these capacities under s 51(2)` TRUE FALSE FALSE TRUE TRUE TRUE FALSE TRUE FALSE)
-- subject to tax-collection law
#ASSERT NOT (`the person is entitled to become or designate a registered holder within s 51(7)` `the heir of a deceased security holder` TRUE FALSE FALSE TRUE TRUE TRUE FALSE TRUE TRUE)
-- documents missing
#ASSERT NOT (`the person is entitled to become or designate a registered holder within s 51(7)` `the heir of a deceased security holder` FALSE FALSE FALSE TRUE TRUE TRUE FALSE TRUE FALSE)
-- (8) the documents: the certificate; reasonable proof
#ASSERT `the documents required by subsection 51(8) have been deposited within s 51(8)` TRUE TRUE
#ASSERT NOT (`the documents required by subsection 51(8) have been deposited within s 51(8)` FALSE TRUE)
#ASSERT NOT (`the documents required by subsection 51(8) have been deposited within s 51(8)` TRUE FALSE)
-- (8) args: a personal representative; the governing laws require no grant; the certificate; the proof; tax law stands in the way
#ASSERT `the personal representative is entitled to become or designate a registered holder within s 51(8)` TRUE TRUE TRUE TRUE FALSE
#ASSERT NOT (`the personal representative is entitled to become or designate a registered holder within s 51(8)` TRUE FALSE TRUE TRUE FALSE)
#ASSERT NOT (`the personal representative is entitled to become or designate a registered holder within s 51(8)` TRUE TRUE FALSE TRUE FALSE)
#ASSERT NOT (`the personal representative is entitled to become or designate a registered holder within s 51(8)` TRUE TRUE TRUE FALSE FALSE)
#ASSERT NOT (`the personal representative is entitled to become or designate a registered holder within s 51(8)` TRUE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`the personal representative is entitled to become or designate a registered holder within s 51(8)` FALSE TRUE TRUE TRUE FALSE)
-- (9) args: the eight (7) deposit facts, then the (8) proof
#ASSERT `the corporation may record the transmission and treat the new registered holder as owner within s 51(9)` TRUE FALSE FALSE TRUE TRUE TRUE FALSE TRUE FALSE
#ASSERT `the corporation may record the transmission and treat the new registered holder as owner within s 51(9)` FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE TRUE
#ASSERT NOT (`the corporation may record the transmission and treat the new registered holder as owner within s 51(9)` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`the corporation may record the transmission and treat the new registered holder as owner within s 51(9)` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE)

§§ `s 52 overissue`
-- args: would result in overissue, a valid similar security is reasonably available, the price the last purchaser paid
#ASSERT `what the person entitled to validation or issue may do within s 52(1)` FALSE TRUE 100 EQUALS `the provisions of this Part apply, because there would be no overissue`
#ASSERT `what the person entitled to validation or issue may do within s 52(1)` TRUE TRUE 100 EQUALS `the person may compel the issuer to purchase and deliver a similar valid security against surrender of the security held`
#ASSERT `what the person entitled to validation or issue may do within s 52(1)` TRUE FALSE 100 EQUALS (`the person may recover from the issuer the price the last purchaser for value paid for the invalid security` WITH `the amount in dollars` IS 100)
-- args: authorized after the amendment, previously authorized, overissued
#ASSERT `the overissued securities are valid from the date of their issue within s 52(2)` 1500 1000 500
#ASSERT NOT (`the overissued securities are valid from the date of their issue within s 52(2)` 1499 1000 500)
#ASSERT `the overissued securities are valid from the date of their issue within s 52(2)` 2000 1000 500
#ASSERT `sections 34, 35, 36 and 39 apply to the purchase or payment within s 52(3)` TRUE EQUALS (JUST FALSE)
#ASSERT `sections 34, 35, 36 and 39 apply to the purchase or payment within s 52(3)` FALSE EQUALS NOTHING

§§ `s 53 burden of proof`
-- (a) args: an action on a security, a signature on the security or in a necessary endorsement, specifically denied
#ASSERT `the signature is admitted within s 53(a)` TRUE TRUE FALSE
#ASSERT NOT (`the signature is admitted within s 53(a)` TRUE TRUE TRUE)
#ASSERT NOT (`the signature is admitted within s 53(a)` FALSE TRUE FALSE)
#ASSERT NOT (`the signature is admitted within s 53(a)` TRUE FALSE FALSE)
-- (b)
#ASSERT `the signature is presumed to be genuine and authorized within s 53(b)` TRUE TRUE
#ASSERT NOT (`the signature is presumed to be genuine and authorized within s 53(b)` TRUE FALSE)
#ASSERT `the party claiming under the signature bears the burden of establishing that it is genuine and authorized within s 53(b)` TRUE TRUE TRUE
#ASSERT NOT (`the party claiming under the signature bears the burden of establishing that it is genuine and authorized within s 53(b)` TRUE TRUE FALSE)
-- (c) args: action on a security, signature admitted or established, produced by a holder, defendant establishes a defence or defect
#ASSERT `production of the instrument entitles the holder to recover within s 53(c)` TRUE TRUE TRUE FALSE
#ASSERT NOT (`production of the instrument entitles the holder to recover within s 53(c)` TRUE TRUE TRUE TRUE)
#ASSERT NOT (`production of the instrument entitles the holder to recover within s 53(c)` TRUE FALSE TRUE FALSE)
#ASSERT NOT (`production of the instrument entitles the holder to recover within s 53(c)` TRUE TRUE FALSE FALSE)
-- (d)
#ASSERT `the plaintiff bears the burden of establishing that the defence or defect is ineffective within s 53(d)` TRUE TRUE
#ASSERT NOT (`the plaintiff bears the burden of establishing that the defence or defect is ineffective within s 53(d)` TRUE FALSE)

§§ `s 54 fungible securities`
-- args: required to deliver, of the specified issue, otherwise agreed, another provision requires otherwise
#ASSERT `the person may deliver any security of the specified issue within s 54` TRUE TRUE FALSE FALSE
#ASSERT NOT (`the person may deliver any security of the specified issue within s 54` TRUE TRUE TRUE FALSE)
#ASSERT NOT (`the person may deliver any security of the specified issue within s 54` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`the person may deliver any security of the specified issue within s 54` TRUE FALSE FALSE FALSE)
#ASSERT NOT (`the person may deliver any security of the specified issue within s 54` FALSE TRUE FALSE FALSE)
