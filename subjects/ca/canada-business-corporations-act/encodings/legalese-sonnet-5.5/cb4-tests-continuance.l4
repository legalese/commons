IMPORT prelude
IMPORT `cbca-core`
IMPORT `cbca-core-definitions`
IMPORT `cb4-common`
IMPORT `cb4-continuance`

-- Tests of cb4-continuance.l4 (Part XV, ss 187 and 188). Every expected value is written from the text
-- of the section named beside it, before the run; none is copied from the encoding's output.

§ `Tests -- ss 187 and 188`

§§ `s 187 (import)`

#ASSERT `the body corporate may apply to the Director for a certificate of continuance within s 187(1)` TRUE TRUE
-- Incorporated by an Act of Parliament: not eligible.
#ASSERT NOT (`the body corporate may apply to the Director for a certificate of continuance within s 187(1)` FALSE TRUE)
-- Its home law does not authorize it: not eligible.
#ASSERT NOT (`the body corporate may apply to the Director for a certificate of continuance within s 187(1)` TRUE FALSE)

#ASSERT `the articles of continuance may effect the amendment without stating it within s 187(2)` TRUE TRUE
#ASSERT NOT (`the articles of continuance may effect the amendment without stating it within s 187(2)` TRUE FALSE)
#ASSERT NOT (`the articles of continuance may effect the amendment without stating it within s 187(2)` FALSE TRUE)

#ASSERT `the articles of continuance have been sent as s 187(3) requires` TRUE TRUE
#ASSERT NOT (`the articles of continuance have been sent as s 187(3) requires` TRUE FALSE)
#ASSERT NOT (`the articles of continuance have been sent as s 187(3) requires` FALSE TRUE)

#ASSERT `the Director must issue a certificate of continuance within s 187(4)` TRUE
#ASSERT NOT (`the Director must issue a certificate of continuance within s 187(4)` FALSE)

-- (5): effects begin on the date shown (15 June 2026).
#ASSERT `the body corporate is a corporation to which this Act applies on a day within s 187(5)(a)` (YearMonthDay 2026 6 15) (YearMonthDay 2026 6 15)
#ASSERT `the body corporate is a corporation to which this Act applies on a day within s 187(5)(a)` (YearMonthDay 2026 6 15) (YearMonthDay 2026 6 16)
#ASSERT NOT (`the body corporate is a corporation to which this Act applies on a day within s 187(5)(a)` (YearMonthDay 2026 6 15) (YearMonthDay 2026 6 14))
#ASSERT `the articles of continuance are deemed the articles of incorporation on a day within s 187(5)(b)` (YearMonthDay 2026 6 15) (YearMonthDay 2026 6 15)
#ASSERT NOT (`the articles of continuance are deemed the articles of incorporation on a day within s 187(5)(b)` (YearMonthDay 2026 6 15) (YearMonthDay 2026 6 14))
#ASSERT `the certificate of continuance is deemed the certificate of incorporation on a day within s 187(5)(c)` (YearMonthDay 2026 6 15) (YearMonthDay 2026 6 15)
#ASSERT NOT (`the certificate of continuance is deemed the certificate of incorporation on a day within s 187(5)(c)` (YearMonthDay 2026 6 15) (YearMonthDay 2026 6 14))

#ASSERT `the Director must send a copy of the certificate to the official or body of the home jurisdiction within s 187(6)` TRUE
#ASSERT NOT (`the Director must send a copy of the certificate to the official or body of the home jurisdiction within s 187(6)` FALSE)

-- (7): rights preserved once continued.
#ASSERT `the property of the body corporate continues to be the corporation's within s 187(7)(a)` TRUE
#ASSERT NOT (`the property of the body corporate continues to be the corporation's within s 187(7)(a)` FALSE)
#ASSERT `the corporation continues to be liable for the body corporate's obligations within s 187(7)(b)` TRUE
#ASSERT NOT (`the corporation continues to be liable for the body corporate's obligations within s 187(7)(b)` FALSE)
#ASSERT `an existing cause of action, claim or liability to prosecution is unaffected by the continuance within s 187(7)(c)` TRUE
#ASSERT NOT (`an existing cause of action, claim or liability to prosecution is unaffected by the continuance within s 187(7)(c)` FALSE)
#ASSERT `a pending proceeding by or against the body corporate may be continued by or against the corporation within s 187(7)(d)` TRUE
#ASSERT NOT (`a pending proceeding by or against the body corporate may be continued by or against the corporation within s 187(7)(d)` FALSE)
#ASSERT `a conviction, ruling, order or judgment may be enforced by or against the corporation within s 187(7)(e)` TRUE
#ASSERT NOT (`a conviction, ruling, order or judgment may be enforced by or against the corporation within s 187(7)(e)` FALSE)

-- (8): a share issued before continuance is deemed compliant unless s 49(8) applies; for a later share the
-- subsection says nothing.
#ASSERT (`the share is deemed to have been issued in compliance with this Act within s 187(8)` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`the share is deemed to have been issued in compliance with this Act within s 187(8)` TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`the share is deemed to have been issued in compliance with this Act within s 187(8)` FALSE FALSE) EQUALS NOTHING
#ASSERT (`the holder keeps the rights and the liabilities in respect of the share within s 187(8)` TRUE) EQUALS JUST TRUE
#ASSERT (`the holder keeps the rights and the liabilities in respect of the share within s 187(8)` FALSE) EQUALS NOTHING

-- (9): no bearer certificate where a holder of a convertible registered certificate exercises conversion.
#ASSERT NOT (`the corporation may issue a share certificate in bearer form within s 187(9)` TRUE TRUE)
#ASSERT `the corporation may issue a share certificate in bearer form within s 187(9)` TRUE FALSE
#ASSERT `the corporation may issue a share certificate in bearer form within s 187(9)` FALSE TRUE
#ASSERT `the corporation may issue a share certificate in bearer form within s 187(9)` FALSE FALSE

-- (10): share includes three kinds of instrument; a like instrument is one; anything else is not.
#ASSERT `the instrument is a share for subsections 187(8) and 187(9) within s 187(10)` `an ordinary share`
#ASSERT `the instrument is a share for subsections 187(8) and 187(9) within s 187(10)` `an instrument referred to in subsection 29(1)`
#ASSERT `the instrument is a share for subsections 187(8) and 187(9) within s 187(10)` `a share warrant as defined in the Canada Corporations Act`
#ASSERT `the instrument is a share for subsections 187(8) and 187(9) within s 187(10)` `a like instrument`
#ASSERT NOT (`the instrument is a share for subsections 187(8) and 187(9) within s 187(10)` `an instrument that is none of these`)

-- (11), (12).
#ASSERT `the Director may permit continued reference to par value shares within s 187(11)` TRUE TRUE
#ASSERT NOT (`the Director may permit continued reference to par value shares within s 187(11)` TRUE FALSE)
#ASSERT NOT (`the Director may permit continued reference to par value shares within s 187(11)` FALSE TRUE)
#ASSERT `the articles comply with the duty to set out the maximum number within s 187(12)` TRUE TRUE
#ASSERT NOT (`the articles comply with the duty to set out the maximum number within s 187(12)` TRUE FALSE)
-- Not permitted to refer to par value shares: the duty does not arise.
#ASSERT `the articles comply with the duty to set out the maximum number within s 187(12)` FALSE FALSE
#ASSERT NOT (`the corporation may make the amendment within s 187(12)` TRUE TRUE FALSE)
#ASSERT NOT (`the corporation may make the amendment within s 187(12)` TRUE FALSE TRUE)
#ASSERT `the corporation may make the amendment within s 187(12)` TRUE FALSE FALSE
#ASSERT `the corporation may make the amendment within s 187(12)` FALSE TRUE TRUE

§§ `s 188 (export)`

-- (10): all five limbs.
#ASSERT `the corporation may be continued under the laws of another jurisdiction within s 188(10)` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`the corporation may be continued under the laws of another jurisdiction within s 188(10)` FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`the corporation may be continued under the laws of another jurisdiction within s 188(10)` TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`the corporation may be continued under the laws of another jurisdiction within s 188(10)` TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`the corporation may be continued under the laws of another jurisdiction within s 188(10)` TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`the corporation may be continued under the laws of another jurisdiction within s 188(10)` TRUE TRUE TRUE TRUE FALSE)

-- (1): authorized, shown to the Director's satisfaction, and subject to (10).
#ASSERT `the corporation may apply to another jurisdiction to be continued within s 188(1)` TRUE TRUE TRUE
#ASSERT NOT (`the corporation may apply to another jurisdiction to be continued within s 188(1)` FALSE TRUE TRUE)
#ASSERT NOT (`the corporation may apply to another jurisdiction to be continued within s 188(1)` TRUE FALSE TRUE)
#ASSERT NOT (`the corporation may apply to another jurisdiction to be continued within s 188(1)` TRUE TRUE FALSE)
#ASSERT `the corporation may apply to the appropriate Minister for continuance under another federal Act within s 188(2)` TRUE TRUE
#ASSERT NOT (`the corporation may apply to the appropriate Minister for continuance under another federal Act within s 188(2)` FALSE TRUE)
#ASSERT NOT (`the corporation may apply to the appropriate Minister for continuance under another federal Act within s 188(2)` TRUE FALSE)

-- (3).
#ASSERT `the notice of the meeting complies within s 188(3)` TRUE TRUE TRUE TRUE
#ASSERT `the notice of the meeting complies within s 188(3)` TRUE TRUE FALSE FALSE
#ASSERT NOT (`the notice of the meeting complies within s 188(3)` TRUE TRUE TRUE FALSE)
#ASSERT NOT (`the notice of the meeting complies within s 188(3)` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`the notice of the meeting complies within s 188(3)` TRUE FALSE TRUE TRUE)
#ASSERT `the effect on the discontinuance of leaving out the dissent statement within s 188(3)` TRUE EQUALS `the omission does not make the action invalid`
#ASSERT `the effect on the discontinuance of leaving out the dissent statement within s 188(3)` FALSE EQUALS `the Act does not say whether the omission makes the action invalid`
#ASSERT `the share carries the right to vote on the continuance within s 188(4)` TRUE
#ASSERT `the share carries the right to vote on the continuance within s 188(4)` FALSE

-- (5): special resolution of the shareholders voting: two-thirds boundary.
#ASSERT `the application for continuance is authorized within s 188(5)` (`Vote tally` WITH `votes cast in favour` IS 200, `votes cast against` IS 100, `signed by all the shareholders entitled to vote on the resolution` IS FALSE)
#ASSERT NOT (`the application for continuance is authorized within s 188(5)` (`Vote tally` WITH `votes cast in favour` IS 199, `votes cast against` IS 101, `signed by all the shareholders entitled to vote on the resolution` IS FALSE))
#ASSERT `the application for continuance is authorized within s 188(5)` (`Vote tally` WITH `votes cast in favour` IS 0, `votes cast against` IS 0, `signed by all the shareholders entitled to vote on the resolution` IS TRUE)

#ASSERT `the directors may abandon the application without further approval of the shareholders within s 188(6)` TRUE
#ASSERT NOT (`the directors may abandon the application without further approval of the shareholders within s 188(6)` FALSE)
#ASSERT `the Director must file the notice and issue a certificate of discontinuance within s 188(7)` TRUE TRUE
#ASSERT NOT (`the Director must file the notice and issue a certificate of discontinuance within s 188(7)` TRUE FALSE)
#ASSERT NOT (`the Director must file the notice and issue a certificate of discontinuance within s 188(7)` FALSE TRUE)
#ASSERT `the notice is deemed to be articles in the form the Director fixes for section 262 within s 188(8)` TRUE
#ASSERT NOT (`the notice is deemed to be articles in the form the Director fixes for section 262 within s 188(8)` FALSE)
-- (9): the Act applies up to, not on, the date shown (fork F2).
#ASSERT `this Act still applies to the corporation on a day within s 188(9)` (YearMonthDay 2026 7 1) (YearMonthDay 2026 6 30)
#ASSERT NOT (`this Act still applies to the corporation on a day within s 188(9)` (YearMonthDay 2026 7 1) (YearMonthDay 2026 7 1))
#ASSERT NOT (`this Act still applies to the corporation on a day within s 188(9)` (YearMonthDay 2026 7 1) (YearMonthDay 2026 7 2))
