IMPORT prelude
IMPORT `cbca-core`
IMPORT `cbca-core-definitions`
IMPORT `cb4-common`
IMPORT `cb4-reorg-arrangement`

-- Tests of cb4-reorg-arrangement.l4 (Part XV, ss 191 and 192). Every expected value is written from the
-- text of the section named beside it, before the run; none is copied from the encoding's output.

§ `Tests -- ss 191 and 192`

§§ `s 191`

#ASSERT `the order is a reorganization within s 191(1)` `an order made under section 241`
#ASSERT `the order is a reorganization within s 191(1)` `an order under the Bankruptcy and Insolvency Act approving a proposal`
#ASSERT `the order is a reorganization within s 191(1)` `an order under any other Act of Parliament that affects the rights among the corporation, its shareholders and creditors`
#ASSERT NOT (`the order is a reorganization within s 191(1)` `an order that is none of these`)

#ASSERT `the order may amend the articles to effect the change within s 191(2)` TRUE TRUE
#ASSERT NOT (`the order may amend the articles to effect the change within s 191(2)` TRUE FALSE)
#ASSERT NOT (`the order may amend the articles to effect the change within s 191(2)` FALSE TRUE)
#ASSERT `the court may authorize the issue of debt obligations and fix their terms within s 191(3)(a)` TRUE
#ASSERT NOT (`the court may authorize the issue of debt obligations and fix their terms within s 191(3)(a)` FALSE)
#ASSERT `the court may appoint directors in place of or in addition to those in office within s 191(3)(b)` TRUE
#ASSERT NOT (`the court may appoint directors in place of or in addition to those in office within s 191(3)(b)` FALSE)

#ASSERT `the corporation must send articles of reorganization to the Director within s 191(4)` TRUE
#ASSERT NOT (`the corporation must send articles of reorganization to the Director within s 191(4)` FALSE)
-- Documents "if applicable": sent when applicable, or not applicable at all.
#ASSERT `the articles of reorganization have been sent as s 191(4) requires` TRUE TRUE TRUE
#ASSERT `the articles of reorganization have been sent as s 191(4) requires` TRUE FALSE FALSE
#ASSERT NOT (`the articles of reorganization have been sent as s 191(4) requires` TRUE TRUE FALSE)
#ASSERT NOT (`the articles of reorganization have been sent as s 191(4) requires` FALSE FALSE FALSE)
#ASSERT `the Director must issue a certificate of amendment within s 191(5)` TRUE
#ASSERT NOT (`the Director must issue a certificate of amendment within s 191(5)` FALSE)
-- (6): effective ON the date shown.
#ASSERT `the reorganization is effective and the articles are amended on a day within s 191(6)` (YearMonthDay 2026 9 1) (YearMonthDay 2026 9 1)
#ASSERT `the reorganization is effective and the articles are amended on a day within s 191(6)` (YearMonthDay 2026 9 1) (YearMonthDay 2026 9 2)
#ASSERT NOT (`the reorganization is effective and the articles are amended on a day within s 191(6)` (YearMonthDay 2026 9 1) (YearMonthDay 2026 8 31))
#ASSERT `a shareholder is not entitled to dissent under section 190 within s 191(7)` TRUE
#ASSERT NOT (`a shareholder is not entitled to dissent under section 190 within s 191(7)` FALSE)

§§ `s 192`

-- (1): a listed transaction is an arrangement; one not listed is not decided ("includes").
#ASSERT (`whether the transaction is an arrangement within s 192(1)` `an amendment to the articles of a corporation (s 192(1)(a))`) EQUALS JUST TRUE
#ASSERT (`whether the transaction is an arrangement within s 192(1)` `an amalgamation of two or more corporations (s 192(1)(b))`) EQUALS JUST TRUE
#ASSERT (`whether the transaction is an arrangement within s 192(1)` `an amalgamation of a body corporate with a corporation that results in an amalgamated corporation subject to this Act (s 192(1)(c))`) EQUALS JUST TRUE
#ASSERT (`whether the transaction is an arrangement within s 192(1)` `a division of the business carried on by a corporation (s 192(1)(d))`) EQUALS JUST TRUE
#ASSERT (`whether the transaction is an arrangement within s 192(1)` `a transfer of all or substantially all the property of a corporation to another body corporate in exchange for property, money or securities of the body corporate (s 192(1)(e))`) EQUALS JUST TRUE
#ASSERT (`whether the transaction is an arrangement within s 192(1)` `an exchange of securities of a corporation for property, money or other securities of the corporation or property, money or securities of another body corporate (s 192(1)(f))`) EQUALS JUST TRUE
#ASSERT (`whether the transaction is an arrangement within s 192(1)` `a going-private transaction or a squeeze-out transaction in relation to a corporation (s 192(1)(f.1))`) EQUALS JUST TRUE
#ASSERT (`whether the transaction is an arrangement within s 192(1)` `a liquidation and dissolution of a corporation (s 192(1)(g))`) EQUALS JUST TRUE
#ASSERT (`whether the transaction is an arrangement within s 192(1)` `any combination of the foregoing (s 192(1)(h))`) EQUALS JUST TRUE
#ASSERT (`whether the transaction is an arrangement within s 192(1)` `a transaction that is not named in s 192(1)`) EQUALS NOTHING

-- (2): insolvent. Assets 1,000; liabilities 600; stated capital 400: 1,000 is not less than 1,000: solvent.
#ASSERT NOT (`the corporation is insolvent within s 192(2)` FALSE 1000 600 400)
#ASSERT `the corporation is insolvent within s 192(2)` FALSE 999 600 400
#ASSERT `the corporation is insolvent within s 192(2)` FALSE 1001 600 402
#ASSERT NOT (`the corporation is insolvent within s 192(2)` FALSE 1001 600 400)
-- Limb (a) alone is enough, whatever the figures.
#ASSERT `the corporation is insolvent within s 192(2)` TRUE 5000 100 100

-- (3): solvent, and not practicable under any other provision.
#ASSERT `the corporation may apply to a court for an order approving an arrangement within s 192(3)` FALSE TRUE
#ASSERT NOT (`the corporation may apply to a court for an order approving an arrangement within s 192(3)` TRUE TRUE)
#ASSERT NOT (`the corporation may apply to a court for an order approving an arrangement within s 192(3)` FALSE FALSE)

-- (4): every kind of order if an application is made and the court thinks it fit; not an order dispensing
-- with notice to the Director.
#ASSERT `the court may make the order within s 192(4)` TRUE TRUE `an order determining the notice to be given to any interested person, or dispensing with notice to a person other than the Director (s 192(4)(a))`
#ASSERT NOT (`the court may make the order within s 192(4)` TRUE TRUE `an order dispensing with notice to the Director`)
#ASSERT `the court may make the order within s 192(4)` TRUE TRUE `an order appointing counsel, at the expense of the corporation, to represent the interests of the shareholders (s 192(4)(b))`
#ASSERT `the court may make the order within s 192(4)` TRUE TRUE `an order requiring the corporation to call, hold and conduct a meeting of holders of securities or options or rights in the manner the court directs (s 192(4)(c))`
#ASSERT `the court may make the order within s 192(4)` TRUE TRUE `an order permitting a shareholder to dissent under section 190 (s 192(4)(d))`
#ASSERT `the court may make the order within s 192(4)` TRUE TRUE `an order approving the arrangement as proposed or as amended in a manner the court directs (s 192(4)(e))`
#ASSERT `the court may make the order within s 192(4)` TRUE TRUE `any other interim or final order the court thinks fit`
-- No application, or the court does not think it fit.
#ASSERT NOT (`the court may make the order within s 192(4)` FALSE TRUE `an order permitting a shareholder to dissent under section 190 (s 192(4)(d))`)
#ASSERT NOT (`the court may make the order within s 192(4)` TRUE FALSE `an order permitting a shareholder to dissent under section 190 (s 192(4)(d))`)
-- (5).
#ASSERT `the applicant must give the Director notice of the application within s 192(5)` TRUE
#ASSERT NOT (`the applicant must give the Director notice of the application within s 192(5)` FALSE)
#ASSERT `the Director is entitled to appear and be heard in person or by counsel within s 192(5)` TRUE
#ASSERT NOT (`the Director is entitled to appear and be heard in person or by counsel within s 192(5)` FALSE)
-- (6) to (8).
#ASSERT `the corporation must send articles of arrangement to the Director within s 192(6)` TRUE
#ASSERT NOT (`the corporation must send articles of arrangement to the Director within s 192(6)` FALSE)
#ASSERT `the articles of arrangement have been sent as s 192(6) requires` TRUE TRUE TRUE
#ASSERT `the articles of arrangement have been sent as s 192(6) requires` TRUE FALSE FALSE
#ASSERT NOT (`the articles of arrangement have been sent as s 192(6) requires` TRUE TRUE FALSE)
#ASSERT NOT (`the articles of arrangement have been sent as s 192(6) requires` FALSE TRUE TRUE)
#ASSERT `the Director must issue a certificate of arrangement within s 192(7)` TRUE
#ASSERT NOT (`the Director must issue a certificate of arrangement within s 192(7)` FALSE)
#ASSERT `the arrangement is effective on a day within s 192(8)` (YearMonthDay 2026 10 1) (YearMonthDay 2026 10 1)
#ASSERT NOT (`the arrangement is effective on a day within s 192(8)` (YearMonthDay 2026 10 1) (YearMonthDay 2026 9 30))
