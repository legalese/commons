IMPORT prelude
IMPORT `cbca-core`
IMPORT `cbca-core-definitions`
IMPORT `cb4-common`
IMPORT `cb4-takeover`

-- Tests of cb4-takeover.l4 (Part XVII, ss 206 and 206.1). Every expected value is written from the text of
-- the section named beside it, before the run; none is copied from the encoding's output. Dates: a period
-- of N days runs from day 0 to day N, both included (keel fork F1).

§ `Tests -- ss 206 and 206.1`

§§ `s 206(1) definitions`

-- dissenting offeree: a bid for all the shares of a class; a holder who has not accepted; or a subsequent
-- holder of such a share.
#ASSERT `a person is a dissenting offeree within s 206(1)` TRUE TRUE FALSE FALSE
#ASSERT NOT (`a person is a dissenting offeree within s 206(1)` TRUE TRUE TRUE FALSE)
#ASSERT `a person is a dissenting offeree within s 206(1)` TRUE FALSE FALSE TRUE
#ASSERT NOT (`a person is a dissenting offeree within s 206(1)` FALSE TRUE FALSE FALSE)
#ASSERT NOT (`a person is a dissenting offeree within s 206(1)` TRUE FALSE FALSE FALSE)
-- offer includes an invitation to make an offer.
#ASSERT (`whether a communication is an offer within s 206(1)` TRUE) EQUALS JUST TRUE
#ASSERT (`whether a communication is an offer within s 206(1)` FALSE) EQUALS NOTHING
#ASSERT `a person is an offeree within s 206(1)` TRUE
#ASSERT NOT (`a person is an offeree within s 206(1)` FALSE)
#ASSERT `a corporation is an offeree corporation within s 206(1)` TRUE TRUE
#ASSERT NOT (`a corporation is an offeree corporation within s 206(1)` FALSE TRUE)
#ASSERT NOT (`a corporation is an offeree corporation within s 206(1)` TRUE FALSE)
-- offeror: makes a bid and is not an agent; or acts jointly or in concert.
#ASSERT `a person is an offeror within s 206(1)` TRUE FALSE FALSE FALSE
#ASSERT NOT (`a person is an offeror within s 206(1)` TRUE TRUE FALSE FALSE)
#ASSERT `a person is an offeror within s 206(1)` FALSE FALSE TRUE FALSE
#ASSERT `a person is an offeror within s 206(1)` FALSE FALSE FALSE TRUE
#ASSERT NOT (`a person is an offeror within s 206(1)` FALSE FALSE FALSE FALSE)
-- share: a share, a convertible security, an exercisable option or right; not another interest.
#ASSERT `the interest is a share within s 206(1)` `a share, with or without voting rights`
#ASSERT `the interest is a share within s 206(1)` `a security currently convertible into such a share (s 206(1) share (a))`
#ASSERT `the interest is a share within s 206(1)` `a currently exercisable option or right to acquire such a share or such a convertible security (s 206(1) share (b))`
#ASSERT NOT (`the interest is a share within s 206(1)` `an interest that is none of these`)
-- take-over bid.
#ASSERT `an offer is a take-over bid within s 206(1)` TRUE TRUE TRUE FALSE
#ASSERT NOT (`an offer is a take-over bid within s 206(1)` FALSE TRUE TRUE FALSE)
#ASSERT NOT (`an offer is a take-over bid within s 206(1)` TRUE FALSE TRUE FALSE)
#ASSERT NOT (`an offer is a take-over bid within s 206(1)` TRUE TRUE FALSE FALSE)
#ASSERT `an offer is a take-over bid within s 206(1)` FALSE FALSE FALSE TRUE

§§ `s 206(2), (3)`

-- (2): 120 days after the bid (1 March 2026): the last day is 29 June 2026.
#ASSERT (`the last day for acceptances to count within s 206(2)` (YMD 2026 3 1)) EQUALS YMD 2026 6 29
#ASSERT `the acceptance counts within s 206(2)` (YMD 2026 3 1) (YMD 2026 6 29)
#ASSERT NOT (`the acceptance counts within s 206(2)` (YMD 2026 3 1) (YMD 2026 6 30))
#ASSERT `the acceptance counts within s 206(2)` (YMD 2026 3 1) (YMD 2026 3 1)
#ASSERT NOT (`the acceptance counts within s 206(2)` (YMD 2026 3 1) (YMD 2026 2 28))
-- 90 per cent of the shares other than the offeror group's: 1,000 shares, 100 held by the group: 900; 90
-- per cent of 900 is 810.
#ASSERT `the bid has been accepted by not less than ninety per cent within s 206(2)` 1000 100 810
#ASSERT NOT (`the bid has been accepted by not less than ninety per cent within s 206(2)` 1000 100 809)
#ASSERT `the bid has been accepted by not less than ninety per cent within s 206(2)` 1000 100 900
-- Counting the group's shares would have required 900, not 810: 850 passes only because they are left out.
#ASSERT `the bid has been accepted by not less than ninety per cent within s 206(2)` 1000 100 850
#ASSERT NOT (`the bid has been accepted by not less than ninety per cent within s 206(2)` 1000 0 850)
#ASSERT `the bid has been accepted by not less than ninety per cent within s 206(2)` 1000 0 900
#ASSERT NOT (`the bid has been accepted by not less than ninety per cent within s 206(2)` 1000 0 899)
#ASSERT `the offeror is entitled to acquire the shares held by the dissenting offerees within s 206(2)` TRUE TRUE
#ASSERT NOT (`the offeror is entitled to acquire the shares held by the dissenting offerees within s 206(2)` TRUE FALSE)
#ASSERT NOT (`the offeror is entitled to acquire the shares held by the dissenting offerees within s 206(2)` FALSE TRUE)
-- (3): bid 1 March 2026, terminated 1 June 2026: 60 days after termination is 31 July; 180 days after the bid
-- is 28 August: the earlier is 31 July.
#ASSERT (`the last day for the offeror's notice within s 206(3)` (YMD 2026 6 1) (YMD 2026 3 1)) EQUALS YMD 2026 7 31
-- Terminated 1 August: 60 days is 30 September; 180 days after the bid is 28 August: the earlier is 28 August.
#ASSERT (`the last day for the offeror's notice within s 206(3)` (YMD 2026 8 1) (YMD 2026 3 1)) EQUALS YMD 2026 8 28
#ASSERT `the offeror's notice was sent in time within s 206(3)` (YMD 2026 6 1) (YMD 2026 3 1) (YMD 2026 7 31)
#ASSERT NOT (`the offeror's notice was sent in time within s 206(3)` (YMD 2026 6 1) (YMD 2026 3 1) (YMD 2026 8 1))
#ASSERT `the offeror's notice was sent in time within s 206(3)` (YMD 2026 8 1) (YMD 2026 3 1) (YMD 2026 8 28)
#ASSERT NOT (`the offeror's notice was sent in time within s 206(3)` (YMD 2026 8 1) (YMD 2026 3 1) (YMD 2026 8 29))
#ASSERT `the offeror's notice states what s 206(3) requires` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`the offeror's notice states what s 206(3) requires` FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`the offeror's notice states what s 206(3) requires` TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`the offeror's notice states what s 206(3) requires` TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`the offeror's notice states what s 206(3) requires` TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`the offeror's notice states what s 206(3) requires` TRUE TRUE TRUE TRUE FALSE)
#ASSERT `the offeror's notice complies with s 206(3)` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`the offeror's notice complies with s 206(3)` FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`the offeror's notice complies with s 206(3)` TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`the offeror's notice complies with s 206(3)` TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`the offeror's notice complies with s 206(3)` TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`the offeror's notice complies with s 206(3)` TRUE TRUE TRUE TRUE FALSE)

§§ `s 206(4) to (8)`

#ASSERT `the offeror must send the offeree corporation a notice of adverse claim for each share held by a dissenting offeree within s 206(4)` TRUE
#ASSERT NOT (`the offeror must send the offeree corporation a notice of adverse claim for each share held by a dissenting offeree within s 206(4)` FALSE)
#ASSERT `the notice of adverse claim complies with s 206(4)` TRUE TRUE TRUE
#ASSERT NOT (`the notice of adverse claim complies with s 206(4)` FALSE TRUE TRUE)
#ASSERT NOT (`the notice of adverse claim complies with s 206(4)` TRUE FALSE TRUE)
#ASSERT NOT (`the notice of adverse claim complies with s 206(4)` TRUE TRUE FALSE)
-- (5): the notice received 1 July 2026: 21 July is the last day.
#ASSERT (`the last day for the dissenting offeree to send the certificates and elect within s 206(5)` (YMD 2026 7 1)) EQUALS YMD 2026 7 21
#ASSERT `the certificates were sent in time within s 206(5)(a)` (YMD 2026 7 1) (YMD 2026 7 21)
#ASSERT NOT (`the certificates were sent in time within s 206(5)(a)` (YMD 2026 7 1) (YMD 2026 7 22))
-- Election: a demand notified in time elects fair value; late or none is DEEMED a transfer (s 206(5.1)).
#ASSERT (`the election of the dissenting offeree within s 206(5) and s 206(5.1)` TRUE (YMD 2026 7 1) (YMD 2026 7 21)) EQUALS `to demand payment of the fair value of the shares`
#ASSERT (`the election of the dissenting offeree within s 206(5) and s 206(5.1)` TRUE (YMD 2026 7 1) (YMD 2026 7 22)) EQUALS `to transfer the shares on the terms on which the offeror acquired the shares of the offerees who accepted`
#ASSERT (`the election of the dissenting offeree within s 206(5) and s 206(5.1)` FALSE (YMD 2026 7 1) (YMD 2026 7 10)) EQUALS `to transfer the shares on the terms on which the offeror acquired the shares of the offerees who accepted`
-- (6): twenty days after the offeror sends the notice (1 July): 21 July.
#ASSERT (`the last day for the offeror to pay or transfer to the offeree corporation within s 206(6)` (YMD 2026 7 1)) EQUALS YMD 2026 7 21
#ASSERT `the offeror paid or transferred in time within s 206(6)` (YMD 2026 7 1) (YMD 2026 7 21)
#ASSERT NOT (`the offeror paid or transferred in time within s 206(6)` (YMD 2026 7 1) (YMD 2026 7 22))
-- (7), (7.1).
#ASSERT `the offeree corporation holds the money or consideration in trust for the dissenting shareholders within s 206(7)` TRUE
#ASSERT NOT (`the offeree corporation holds the money or consideration in trust for the dissenting shareholders within s 206(7)` FALSE)
#ASSERT `the deposit and custody comply with s 206(7)` TRUE TRUE TRUE
#ASSERT NOT (`the deposit and custody comply with s 206(7)` FALSE TRUE TRUE)
#ASSERT NOT (`the deposit and custody comply with s 206(7)` TRUE FALSE TRUE)
#ASSERT NOT (`the deposit and custody comply with s 206(7)` TRUE TRUE FALSE)
#ASSERT `the corporation holds the money and consideration in trust for the dissenting shareholders within s 206(7.1)` TRUE
#ASSERT NOT (`the corporation holds the money and consideration in trust for the dissenting shareholders within s 206(7.1)` FALSE)
#ASSERT (`the last day for the corporation to deposit the money within s 206(7.1)` (YMD 2026 7 1)) EQUALS YMD 2026 7 21
#ASSERT `the corporation deposited in time within s 206(7.1)` (YMD 2026 7 1) (YMD 2026 7 21)
#ASSERT NOT (`the corporation deposited in time within s 206(7.1)` (YMD 2026 7 1) (YMD 2026 7 22))
-- (8): thirty days after the offeror sends the notice (1 July): 31 July.
#ASSERT (`the last day for the offeree corporation to act within s 206(8)` (YMD 2026 7 1)) EQUALS YMD 2026 7 31
#ASSERT `the offeree corporation acted in time within s 206(8)` (YMD 2026 7 1) (YMD 2026 7 31)
#ASSERT NOT (`the offeree corporation acted in time within s 206(8)` (YMD 2026 7 1) (YMD 2026 8 1))
#ASSERT `the offeree corporation must issue the offeror a share certificate within s 206(8)(a)` TRUE
#ASSERT NOT (`the offeree corporation must issue the offeror a share certificate within s 206(8)(a)` FALSE)
#ASSERT `the offeree corporation must give the dissenting offeree the money or consideration within s 206(8)(b)` TRUE TRUE
#ASSERT NOT (`the offeree corporation must give the dissenting offeree the money or consideration within s 206(8)(b)` TRUE FALSE)
#ASSERT NOT (`the offeree corporation must give the dissenting offeree the money or consideration within s 206(8)(b)` FALSE TRUE)
#ASSERT `the offeree corporation must send the dissenting shareholder the notice within s 206(8)(c)` TRUE TRUE TRUE
#ASSERT NOT (`the offeree corporation must send the dissenting shareholder the notice within s 206(8)(c)` FALSE TRUE TRUE)
#ASSERT NOT (`the offeree corporation must send the dissenting shareholder the notice within s 206(8)(c)` TRUE FALSE TRUE)
#ASSERT NOT (`the offeree corporation must send the dissenting shareholder the notice within s 206(8)(c)` TRUE TRUE FALSE)
#ASSERT `the offeree corporation's notice states what s 206(8)(c) requires` TRUE TRUE TRUE
#ASSERT NOT (`the offeree corporation's notice states what s 206(8)(c) requires` FALSE TRUE TRUE)
#ASSERT NOT (`the offeree corporation's notice states what s 206(8)(c) requires` TRUE FALSE TRUE)
#ASSERT NOT (`the offeree corporation's notice states what s 206(8)(c) requires` TRUE TRUE FALSE)

§§ `s 206(9) to (18)`

-- (9): paid 21 July 2026: the offeror may apply until 10 August.
#ASSERT (`the last day for the offeror to apply to a court within s 206(9)` (YMD 2026 7 21)) EQUALS YMD 2026 8 10
#ASSERT `the offeror may apply to a court to fix the fair value within s 206(9)` TRUE (YMD 2026 7 21) (YMD 2026 8 10)
#ASSERT NOT (`the offeror may apply to a court to fix the fair value within s 206(9)` TRUE (YMD 2026 7 21) (YMD 2026 8 11))
#ASSERT NOT (`the offeror may apply to a court to fix the fair value within s 206(9)` FALSE (YMD 2026 7 21) (YMD 2026 8 1))
-- (10): a further twenty days after that: 11 to 30 August.
#ASSERT (`the last day for the dissenting offeree to apply to a court within s 206(10)` (YMD 2026 7 21)) EQUALS YMD 2026 8 30
#ASSERT `the dissenting offeree may apply to a court to fix the fair value within s 206(10)` TRUE (YMD 2026 7 21) (YMD 2026 8 30)
#ASSERT NOT (`the dissenting offeree may apply to a court to fix the fair value within s 206(10)` TRUE (YMD 2026 7 21) (YMD 2026 8 31))
#ASSERT `the dissenting offeree may apply to a court to fix the fair value within s 206(10)` TRUE (YMD 2026 7 21) (YMD 2026 8 11)
#ASSERT NOT (`the dissenting offeree may apply to a court to fix the fair value within s 206(10)` TRUE (YMD 2026 7 21) (YMD 2026 8 10))
#ASSERT NOT (`the dissenting offeree may apply to a court to fix the fair value within s 206(10)` FALSE (YMD 2026 7 21) (YMD 2026 8 20))
-- (11).
#ASSERT (`the deemed election within s 206(11)` TRUE) EQUALS JUST `to transfer the shares on the terms on which the offeror acquired the shares of the offerees who accepted`
#ASSERT (`the deemed election within s 206(11)` FALSE) EQUALS NOTHING
-- (12), (13).
#ASSERT `the court is a proper court within s 206(12)` TRUE FALSE FALSE
#ASSERT `the court is a proper court within s 206(12)` FALSE TRUE TRUE
#ASSERT NOT (`the court is a proper court within s 206(12)` FALSE TRUE FALSE)
#ASSERT NOT (`the court is a proper court within s 206(12)` FALSE FALSE TRUE)
#ASSERT (`a dissenting offeree is required to give security for costs within s 206(13)` TRUE) EQUALS JUST FALSE
#ASSERT (`a dissenting offeree is required to give security for costs within s 206(13)` FALSE) EQUALS NOTHING
-- (14).
#ASSERT `the dissenting offeree must be joined as a party and is bound by the decision within s 206(14)(a)` TRUE
#ASSERT NOT (`the dissenting offeree must be joined as a party and is bound by the decision within s 206(14)(a)` FALSE)
#ASSERT `the offeror's notice to the dissenting offeree complies with s 206(14)(b)` TRUE TRUE TRUE TRUE
#ASSERT NOT (`the offeror's notice to the dissenting offeree complies with s 206(14)(b)` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`the offeror's notice to the dissenting offeree complies with s 206(14)(b)` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`the offeror's notice to the dissenting offeree complies with s 206(14)(b)` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`the offeror's notice to the dissenting offeree complies with s 206(14)(b)` TRUE TRUE TRUE FALSE)
-- (15) to (17).
#ASSERT `the court must fix a fair value for the shares of all dissenting offerees within s 206(15)` TRUE
#ASSERT NOT (`the court must fix a fair value for the shares of all dissenting offerees within s 206(15)` FALSE)
#ASSERT `the court may appoint appraisers within s 206(16)` TRUE
#ASSERT NOT (`the court may appoint appraisers within s 206(16)` FALSE)
#ASSERT `the final order is made against the offeror in favour of each dissenting offeree within s 206(17)` TRUE
#ASSERT NOT (`the final order is made against the offeror in favour of each dissenting offeree within s 206(17)` FALSE)
-- (18): each named order and any other, if the court thinks it fit and it is in these proceedings.
#ASSERT `the court may make the order within s 206(18)` TRUE TRUE `an order fixing the amount of money or other consideration required to be held in trust under subsection (7) or (7.1) (s 206(18)(a))`
#ASSERT `the court may make the order within s 206(18)` TRUE TRUE `an order that the money or other consideration be held in trust by a person other than the offeree corporation (s 206(18)(b))`
#ASSERT `the court may make the order within s 206(18)` TRUE TRUE `an order allowing a reasonable rate of interest on the amount payable to each dissenting offeree (s 206(18)(c))`
#ASSERT `the court may make the order within s 206(18)` TRUE TRUE `an order that money payable to a shareholder who cannot be found be paid to the Receiver General, with subsection 227(3) applying (s 206(18)(d))`
#ASSERT `the court may make the order within s 206(18)` TRUE TRUE `any other order the court thinks fit under s 206(18)`
#ASSERT NOT (`the court may make the order within s 206(18)` FALSE TRUE `any other order the court thinks fit under s 206(18)`)
#ASSERT NOT (`the court may make the order within s 206(18)` TRUE FALSE `any other order the court thinks fit under s 206(18)`)
-- Interest from the day the certificates were sent (21 July) until payment (31 August), both included.
#ASSERT `the court may allow interest for a day within s 206(18)(c)` (YMD 2026 7 21) (YMD 2026 8 31) (YMD 2026 7 21)
#ASSERT `the court may allow interest for a day within s 206(18)(c)` (YMD 2026 7 21) (YMD 2026 8 31) (YMD 2026 8 31)
#ASSERT NOT (`the court may allow interest for a day within s 206(18)(c)` (YMD 2026 7 21) (YMD 2026 8 31) (YMD 2026 7 20))
#ASSERT NOT (`the court may allow interest for a day within s 206(18)(c)` (YMD 2026 7 21) (YMD 2026 8 31) (YMD 2026 9 1))

§§ `s 206.1`

-- (1): a shareholder who received an offer counts ninety days from termination (1 June 2026): last day 30
-- August. One who never received an offer counts from the later of termination and learning of the bid.
#ASSERT (`the day the ninety days for the shareholder start within s 206.1(1)` TRUE (YMD 2026 6 1) (YMD 2026 6 20)) EQUALS YMD 2026 6 1
#ASSERT (`the day the ninety days for the shareholder start within s 206.1(1)` FALSE (YMD 2026 6 1) (YMD 2026 6 20)) EQUALS YMD 2026 6 20
#ASSERT (`the day the ninety days for the shareholder start within s 206.1(1)` FALSE (YMD 2026 6 20) (YMD 2026 6 1)) EQUALS YMD 2026 6 20
#ASSERT (`the day the ninety days for the shareholder start within s 206.1(1)` FALSE (YMD 2026 6 1) (YMD 2026 6 1)) EQUALS YMD 2026 6 1
#ASSERT (`the last day for the shareholder to require the offeror to acquire within s 206.1(1)` (YMD 2026 6 1)) EQUALS YMD 2026 8 30
#ASSERT `the shareholder may require the offeror to acquire the shares within s 206.1(1)` TRUE TRUE (YMD 2026 6 1) (YMD 2026 8 30)
#ASSERT NOT (`the shareholder may require the offeror to acquire the shares within s 206.1(1)` TRUE TRUE (YMD 2026 6 1) (YMD 2026 8 31))
#ASSERT NOT (`the shareholder may require the offeror to acquire the shares within s 206.1(1)` TRUE FALSE (YMD 2026 6 1) (YMD 2026 8 1))
#ASSERT NOT (`the shareholder may require the offeror to acquire the shares within s 206.1(1)` FALSE TRUE (YMD 2026 6 1) (YMD 2026 8 1))
#ASSERT `the offeror must acquire the shares on the same terms as the offerees who accepted within s 206.1(2)` TRUE
#ASSERT NOT (`the offeror must acquire the shares on the same terms as the offerees who accepted within s 206.1(2)` FALSE)
