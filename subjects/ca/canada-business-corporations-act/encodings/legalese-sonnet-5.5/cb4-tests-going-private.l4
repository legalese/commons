IMPORT prelude
IMPORT `cbca-core`
IMPORT `cbca-core-definitions`
IMPORT `cb4-common`
IMPORT `cb4-going-private`

-- Tests of cb4-going-private.l4 (Part XVI, ss 193 and 194). Every expected value is written from the text
-- of the section named beside it, before the run; none is copied from the encoding's output.

§ `Tests -- ss 193 and 194`

§§ `s 193`

#ASSERT `a corporation may carry out a going-private transaction within s 193` FALSE FALSE
#ASSERT `a corporation may carry out a going-private transaction within s 193` FALSE TRUE
#ASSERT `a corporation may carry out a going-private transaction within s 193` TRUE TRUE
#ASSERT NOT (`a corporation may carry out a going-private transaction within s 193` TRUE FALSE)

§§ `s 194`

-- Who may vote: not an affiliate, and not a holder who gets greater value or superior rights; the shares'
-- ordinary right to vote makes no difference either way.
#ASSERT `the holder may vote on the squeeze-out resolution within s 194` FALSE FALSE FALSE
#ASSERT `the holder may vote on the squeeze-out resolution within s 194` TRUE FALSE FALSE
#ASSERT NOT (`the holder may vote on the squeeze-out resolution within s 194` TRUE TRUE FALSE)
#ASSERT NOT (`the holder may vote on the squeeze-out resolution within s 194` TRUE FALSE TRUE)
#ASSERT NOT (`the holder may vote on the squeeze-out resolution within s 194` FALSE TRUE TRUE)
-- Ordinary resolution: more than half the votes cast. 51 to 49 passes; 50 to 50 does not.
#ASSERT `the holders of a class have approved the squeeze-out transaction within s 194` (`Vote tally` WITH `votes cast in favour` IS 51, `votes cast against` IS 49, `signed by all the shareholders entitled to vote on the resolution` IS FALSE)
#ASSERT NOT (`the holders of a class have approved the squeeze-out transaction within s 194` (`Vote tally` WITH `votes cast in favour` IS 50, `votes cast against` IS 50, `signed by all the shareholders entitled to vote on the resolution` IS FALSE))
-- The definition of "ordinary resolution" (s 2(1)) is "a majority of the votes cast"; unlike "special
-- resolution" it has no "signed by all the shareholders" alternative. With no votes cast there is no
-- majority, so under the s 2(1) rule a tally of 0 to 0 does not pass even if every holder signed. (My
-- first draft of this assertion expected the opposite, copying the special-resolution rule; the s 2(1)
-- definition says otherwise. This asserts the keel's s 2(1) rule ONLY: section 142(1)(a) (src:1765-1766,
-- outside this piece) makes a resolution in writing signed by all the shareholders entitled to vote as
-- valid as one passed at a meeting, and the keel does not model that route. NOTES records the gap.)
#ASSERT NOT (`the holders of a class have approved the squeeze-out transaction within s 194` (`Vote tally` WITH `votes cast in favour` IS 0, `votes cast against` IS 0, `signed by all the shareholders entitled to vote on the resolution` IS TRUE))
-- The transaction as a whole.
#ASSERT (`the corporation may carry out the squeeze-out transaction within s 194` TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`the corporation may carry out the squeeze-out transaction within s 194` TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`the corporation may carry out the squeeze-out transaction within s 194` TRUE TRUE FALSE) EQUALS JUST FALSE
-- Not a squeeze-out transaction: section 194 sets no condition.
#ASSERT (`the corporation may carry out the squeeze-out transaction within s 194` FALSE FALSE FALSE) EQUALS NOTHING
