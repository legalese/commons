IMPORT prelude
IMPORT `cbca-core`
IMPORT `cb2-nouns`
IMPORT `cb2-part7-purchase`

-- Tests of cb2-part7-purchase.l4 (ss 60 to 64). Every expected value is written from the text of the
-- provision named beside it, not from the output of the rule.

§ `Tests of ss 60 to 64`

§§ `s 60: title of purchaser`
-- args: delivered, party to fraud or illegality, prior holder with notice of an adverse claim, takes from a later bona fide purchaser
#ASSERT `the rights the purchaser acquires on delivery within s 60(1)` TRUE FALSE FALSE FALSE EQUALS (JUST `the purchaser acquires the rights the transferor had or had authority to convey`)
#ASSERT `the rights the purchaser acquires on delivery within s 60(1)` TRUE TRUE FALSE FALSE EQUALS (JUST `the purchaser acquires the rights the transferor had or had authority to convey`)
#ASSERT `the rights the purchaser acquires on delivery within s 60(1)` TRUE TRUE FALSE TRUE EQUALS (JUST `the purchaser does not improve their position by taking from a later bona fide purchaser`)
#ASSERT `the rights the purchaser acquires on delivery within s 60(1)` TRUE FALSE TRUE TRUE EQUALS (JUST `the purchaser does not improve their position by taking from a later bona fide purchaser`)
#ASSERT `the rights the purchaser acquires on delivery within s 60(1)` TRUE FALSE FALSE TRUE EQUALS (JUST `the purchaser acquires the rights the transferor had or had authority to convey`)
-- not covered: no delivery
#ASSERT `the rights the purchaser acquires on delivery within s 60(1)` FALSE FALSE FALSE FALSE EQUALS NOTHING
-- (2) args: delivered, a bona fide purchaser
#ASSERT `the bona fide purchaser acquires the security free from any adverse claim within s 60(2)` TRUE TRUE
#ASSERT NOT (`the bona fide purchaser acquires the security free from any adverse claim within s 60(2)` TRUE FALSE)
#ASSERT NOT (`the bona fide purchaser acquires the security free from any adverse claim within s 60(2)` FALSE TRUE)
-- (3) the right claimed must not exceed the interest purchased
#ASSERT `the purchaser acquires the right claimed within s 60(3)` 100 100
#ASSERT `the purchaser acquires the right claimed within s 60(3)` 100 99
#ASSERT NOT (`the purchaser acquires the right claimed within s 60(3)` 100 101)

§§ `s 61: deemed notice of an adverse claim`
-- args: endorsed for collection or surrender or another purpose not involving transfer, in bearer form, statement of another's ownership, that statement is the mere writing of a name
#ASSERT `the purchaser or broker is deemed to have notice of an adverse claim within s 61(1)` TRUE FALSE FALSE FALSE
#ASSERT `the purchaser or broker is deemed to have notice of an adverse claim within s 61(1)` FALSE TRUE TRUE FALSE
#ASSERT NOT (`the purchaser or broker is deemed to have notice of an adverse claim within s 61(1)` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`the purchaser or broker is deemed to have notice of an adverse claim within s 61(1)` FALSE FALSE TRUE FALSE)
#ASSERT NOT (`the purchaser or broker is deemed to have notice of an adverse claim within s 61(1)` FALSE TRUE FALSE FALSE)
-- (2) args: has notice that the security is held for a third person or in a fiduciary's name; knows the transaction is for the fiduciary's benefit or in breach of duty
#ASSERT `the purchaser or broker is deemed to have notice of an adverse claim within s 61(2)` TRUE TRUE EQUALS (JUST TRUE)
#ASSERT `the purchaser or broker is deemed to have notice of an adverse claim within s 61(2)` TRUE FALSE EQUALS (JUST FALSE)
#ASSERT `the purchaser or broker is deemed to have notice of an adverse claim within s 61(2)` FALSE TRUE EQUALS NOTHING
#ASSERT `the purchaser or broker has a duty to inquire into the rightfulness of the transfer within s 61(2)` TRUE EQUALS (JUST FALSE)
#ASSERT `the purchaser or broker has a duty to inquire into the rightfulness of the transfer within s 61(2)` FALSE EQUALS NOTHING

§§ `s 62: staleness as notice of an adverse claim`
-- args: date set for presentation or surrender, date set for payment, funds available on that date, the date of the purchase
-- (a) presentation or surrender: more than one year after the date set (1 March 2020: 1 March 2021 is one year on)
#ASSERT `the event is of itself notice of an adverse claim within s 62` (JUST (YearMonthDay 2020 3 1)) NOTHING FALSE (YearMonthDay 2021 3 2)
#ASSERT NOT (`the event is of itself notice of an adverse claim within s 62` (JUST (YearMonthDay 2020 3 1)) NOTHING FALSE (YearMonthDay 2021 3 1))
-- no date set for presentation or surrender and none for payment
#ASSERT NOT (`the event is of itself notice of an adverse claim within s 62` NOTHING NOTHING TRUE (YearMonthDay 2030 1 1))
-- (b) payment against presentation: more than six months after the date set, if funds are available
#ASSERT `the event is of itself notice of an adverse claim within s 62` NOTHING (JUST (YearMonthDay 2020 3 1)) TRUE (YearMonthDay 2020 9 2)
#ASSERT NOT (`the event is of itself notice of an adverse claim within s 62` NOTHING (JUST (YearMonthDay 2020 3 1)) TRUE (YearMonthDay 2020 9 1))
#ASSERT NOT (`the event is of itself notice of an adverse claim within s 62` NOTHING (JUST (YearMonthDay 2020 3 1)) FALSE (YearMonthDay 2020 9 2))
-- no date set for payment: limb (b) cannot apply, whatever the funds
#ASSERT NOT (`the event is of itself notice of an adverse claim within s 62` (JUST (YearMonthDay 2020 3 1)) NOTHING TRUE (YearMonthDay 2020 9 2))

§§ `s 63: warranties`
-- (1) args: presents for registration of transfer, payment or exchange; is a purchaser for value without notice who receives a new, reissued or re-registered security
#ASSERT `the warranties given to the issuer within s 63(1)` TRUE FALSE EQUALS (JUST (LIST `a warranty to the issuer that the person is entitled to the registration, payment or exchange`))
#ASSERT `the warranties given to the issuer within s 63(1)` TRUE TRUE EQUALS (JUST (LIST `a warranty to the issuer that the purchaser has no knowledge of any unauthorized signature in a necessary endorsement`))
#ASSERT `the warranties given to the issuer within s 63(1)` FALSE FALSE EQUALS NOTHING
-- (2)
#ASSERT `the warranties given to the purchaser within s 63(2)` TRUE EQUALS (JUST (LIST `a warranty to the purchaser that the transfer is effective and rightful`, `a warranty to the purchaser that the security is genuine and has not been materially altered`, `a warranty to the purchaser that the transferor knows of nothing that might impair the validity of the security`))
#ASSERT `the warranties given to the purchaser within s 63(2)` FALSE EQUALS NOTHING
-- (3)
#ASSERT `the warranties given by the intermediary within s 63(3)` TRUE EQUALS (JUST (LIST `a warranty by an intermediary of their good faith`, `a warranty by an intermediary of their authority`))
#ASSERT `the warranties given by the intermediary within s 63(3)` FALSE EQUALS NOTHING
-- (4) args: a pledgee or other holder for security, redelivers or delivers on the debtor's order
#ASSERT `the warranties given by the pledgee within s 63(4)` TRUE TRUE EQUALS (JUST (LIST `a warranty by an intermediary of their good faith`, `a warranty by an intermediary of their authority`))
#ASSERT `the warranties given by the pledgee within s 63(4)` TRUE FALSE EQUALS NOTHING
#ASSERT `the warranties given by the pledgee within s 63(4)` FALSE TRUE EQUALS NOTHING
-- (5)
#ASSERT `the broker gives the warranties and has the rights and privileges of a purchaser under this section within s 63(5)` TRUE
#ASSERT NOT (`the broker gives the warranties and has the rights and privileges of a purchaser under this section within s 63(5)` FALSE)
#ASSERT `the broker's warranties are in addition to those given by and in favour of the customer within s 63(5)` TRUE TRUE
#ASSERT NOT (`the broker's warranties are in addition to those given by and in favour of the customer within s 63(5)` TRUE FALSE)
#ASSERT NOT (`the broker's warranties are in addition to those given by and in favour of the customer within s 63(5)` FALSE TRUE)

§§ `s 64: the right to compel an endorsement`
-- args: in registered form, delivered without a necessary endorsement, endorsement supplied by the time asked about
#ASSERT `the purchaser may be a bona fide purchaser at the time asked about within s 64` TRUE TRUE TRUE EQUALS (JUST TRUE)
#ASSERT `the purchaser may be a bona fide purchaser at the time asked about within s 64` TRUE TRUE FALSE EQUALS (JUST FALSE)
#ASSERT `the purchaser may be a bona fide purchaser at the time asked about within s 64` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `the purchaser may be a bona fide purchaser at the time asked about within s 64` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `against the transferor the transfer is complete on delivery and the purchaser may enforce the supplying of the endorsement within s 64` TRUE TRUE
#ASSERT NOT (`against the transferor the transfer is complete on delivery and the purchaser may enforce the supplying of the endorsement within s 64` TRUE FALSE)
#ASSERT NOT (`against the transferor the transfer is complete on delivery and the purchaser may enforce the supplying of the endorsement within s 64` FALSE TRUE)
