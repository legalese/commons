IMPORT prelude
IMPORT `cbca-core`
IMPORT `cb5-nouns`
IMPORT `cb5-part19-1-damages`

-- TESTS of cb5-part19-1-damages.l4 (Part XIX.1, ss 237.1 to 237.9). Every expected value is written from
-- the text of the section named beside it, before the run; none is copied from the module's output.
-- Arguments are positional, in the order of the rule's GIVEN: see the module.

§ `Tests of Part XIX.1`

§§ `s 237.1 definitions`

-- A security is a financial interest.
#ASSERT `financial interest within s 237.1` `a security (s 237.1 "financial interest" (a))` FALSE FALSE FALSE
-- Paragraph (h): an income or annuity contract is one unless an insurance company governed by an Act of
-- Parliament or a law of a province issued it.
#ASSERT `financial interest within s 237.1` `an income or annuity contract (s 237.1 "financial interest" (h))` FALSE FALSE FALSE
#ASSERT NOT (`financial interest within s 237.1` `an income or annuity contract (s 237.1 "financial interest" (h))` FALSE TRUE FALSE)
-- Paragraph (j): only if the regulations prescribe it.
#ASSERT `financial interest within s 237.1` `anything prescribed to be a financial interest (s 237.1 "financial interest" (j))` FALSE FALSE TRUE
#ASSERT NOT (`financial interest within s 237.1` `anything prescribed to be a financial interest (s 237.1 "financial interest" (j))` FALSE FALSE FALSE)
-- "Includes": a thing outside the ten kinds can still be one.
#ASSERT `financial interest within s 237.1` `none of these kinds of financial interest (s 237.1)` TRUE FALSE FALSE
#ASSERT NOT (`financial interest within s 237.1` `none of these kinds of financial interest (s 237.1)` FALSE FALSE FALSE)
#ASSERT `financial interest within s 237.1` `an investment contract (s 237.1 "financial interest" (i))` FALSE TRUE FALSE
-- Financial loss: all three limbs.
#ASSERT `financial loss within s 237.1` TRUE TRUE TRUE
#ASSERT NOT (`financial loss within s 237.1` TRUE TRUE FALSE)
#ASSERT NOT (`financial loss within s 237.1` TRUE FALSE TRUE)
#ASSERT NOT (`financial loss within s 237.1` FALSE TRUE TRUE)
#ASSERT `third party within s 237.1` TRUE FALSE
#ASSERT `third party within s 237.1` FALSE TRUE
#ASSERT NOT (`third party within s 237.1` FALSE FALSE)

§§ `s 237.2 when the part applies`

#ASSERT `Part XIX.1 applies to the apportionment within s 237.2(1)` TRUE 2
#ASSERT `Part XIX.1 applies to the apportionment within s 237.2(1)` TRUE 3
-- One defendant is not "more than one".
#ASSERT NOT (`Part XIX.1 applies to the apportionment within s 237.2(1)` TRUE 1)
#ASSERT NOT (`Part XIX.1 applies to the apportionment within s 237.2(1)` TRUE 0)
-- No damages awarded for financial loss.
#ASSERT NOT (`Part XIX.1 applies to the apportionment within s 237.2(1)` FALSE 5)
#ASSERT `Part XIX.1 does not apply to the plaintiff within s 237.2(2)` `Her Majesty in right of Canada or of a province (s 237.2(2)(a))` FALSE
#ASSERT `Part XIX.1 does not apply to the plaintiff within s 237.2(2)` `a charitable organization, private foundation or public foundation (s 237.2(2)(c))` FALSE
#ASSERT `Part XIX.1 does not apply to the plaintiff within s 237.2(2)` `an unsecured creditor in respect of goods or services provided to a corporation (s 237.2(2)(d))` FALSE
-- An agent of the Crown is excluded unless a substantial part of its activities involves trading in securities.
#ASSERT `Part XIX.1 does not apply to the plaintiff within s 237.2(2)` `an agent of Her Majesty, a Crown corporation or a government agency (s 237.2(2)(b))` FALSE
#ASSERT NOT (`Part XIX.1 does not apply to the plaintiff within s 237.2(2)` `an agent of Her Majesty, a Crown corporation or a government agency (s 237.2(2)(b))` TRUE)
#ASSERT NOT (`Part XIX.1 does not apply to the plaintiff within s 237.2(2)` `any other plaintiff (s 237.2(2))` FALSE)

§§ `s 237.3 apportionment`

-- 40% of $100,000 is $40,000.
#ASSERT `the portion of the damages for which a defendant or third party is liable within s 237.3(1)` 100000 (40%) EQUALS 40000
#ASSERT `the portion of the damages for which a defendant or third party is liable within s 237.3(1)` 250000 (10%) EQUALS 25000
-- s 237.3(2): one year after the date the judgment was made enforceable; the anniversary is in time and the day after is not.
#ASSERT `the last day to apply to reallocate an uncollectable amount within s 237.3(2)` (YMD 2025 3 10) EQUALS YMD 2026 3 10
#ASSERT `the court may reallocate the uncollectable amount within s 237.3(2)` TRUE TRUE (YMD 2025 3 10) (YMD 2026 3 10)
#ASSERT NOT (`the court may reallocate the uncollectable amount within s 237.3(2)` TRUE TRUE (YMD 2025 3 10) (YMD 2026 3 11))
#ASSERT `the court may reallocate the uncollectable amount within s 237.3(2)` TRUE TRUE (YMD 2025 3 10) (YMD 2025 3 11)
-- Nothing uncollectable, or no application: no reallocation.
#ASSERT NOT (`the court may reallocate the uncollectable amount within s 237.3(2)` FALSE TRUE (YMD 2025 3 10) (YMD 2025 3 11))
#ASSERT NOT (`the court may reallocate the uncollectable amount within s 237.3(2)` TRUE FALSE (YMD 2025 3 10) (YMD 2025 3 11))
-- s 237.3(3): $20,000 uncollectable, the other's responsibility 25% of the total loss: $5,000.
#ASSERT `the amount that may be reallocated to the other defendant or third party within s 237.3(3)` 20000 (25%) EQUALS 5000
-- s 237.3(4): at most fifty per cent of the amount originally awarded against that defendant or third party.
#ASSERT `the most that may be reallocated to that defendant or third party within s 237.3(4)` 5000 20000 EQUALS 5000
#ASSERT `the most that may be reallocated to that defendant or third party within s 237.3(4)` 10000 20000 EQUALS 10000
#ASSERT `the most that may be reallocated to that defendant or third party within s 237.3(4)` 10001 20000 EQUALS 10000
#ASSERT `the most that may be reallocated to that defendant or third party within s 237.3(4)` 30000 20000 EQUALS 10000

§§ `s 237.4 fraud`

#ASSERT `the plaintiff may recover the whole amount of the damages from the defendant or third party within s 237.4(1)` TRUE TRUE
#ASSERT NOT (`the plaintiff may recover the whole amount of the damages from the defendant or third party within s 237.4(1)` TRUE FALSE)
#ASSERT NOT (`the plaintiff may recover the whole amount of the damages from the defendant or third party within s 237.4(1)` FALSE TRUE)
#ASSERT `the defendant or third party is entitled to claim contribution within s 237.4(2)` TRUE TRUE
#ASSERT NOT (`the defendant or third party is entitled to claim contribution within s 237.4(2)` TRUE FALSE)
#ASSERT NOT (`the defendant or third party is entitled to claim contribution within s 237.4(2)` FALSE TRUE)

§§ `s 237.5 joint and several liability`

-- A personal body corporate: not in business AND controlled by an individual or a group of relatives.
#ASSERT `personal body corporate within s 237.5(2)(a)` TRUE TRUE FALSE
#ASSERT `personal body corporate within s 237.5(2)(a)` TRUE FALSE TRUE
#ASSERT NOT (`personal body corporate within s 237.5(2)(a)` FALSE TRUE FALSE)
#ASSERT NOT (`personal body corporate within s 237.5(2)(a)` TRUE FALSE FALSE)
-- A common-law partnership: cohabiting in a conjugal relationship for a period of at least one year.
#ASSERT `common-law partnership within s 237.5(2)(b)` TRUE 1
#ASSERT `common-law partnership within s 237.5(2)(b)` TRUE 7
#ASSERT NOT (`common-law partnership within s 237.5(2)(b)` TRUE 0)
#ASSERT NOT (`common-law partnership within s 237.5(2)(b)` FALSE 10)
-- (1)(a): a financial interest on the day of the error, or acquired between that day and the day of disclosure (both ends in the period).

-- Fixtures: a close-of-business position is a day, whether an interest was acquired that day, and the
-- value in dollars of the whole holding that evening.
GIVEN `the day of the position` IS A DATE
      `an interest was acquired that day` IS A BOOLEAN
      `the value of the whole holding in dollars` IS A NUMBER
GIVETH A `Close of business position of a plaintiff (s 237.5(1))`
DECIDE `a position for the tests` IS
    `Close of business position of a plaintiff (s 237.5(1))` WITH
        `the day` IS `the day of the position`
        `the plaintiff acquired a financial interest on that day` IS `an interest was acquired that day`
        `value of the plaintiff's total financial interest in the corporation in dollars` IS `the value of the whole holding in dollars`

-- The error occurred on 10 May 2024 and was generally disclosed on 10 June 2024 (as the court found).
#ASSERT `the position is an acquisition in the period within s 237.5(1)(a)` (`a position for the tests` (YMD 2024 5 10) TRUE 1000) (YMD 2024 5 10) (YMD 2024 6 10)
#ASSERT `the position is an acquisition in the period within s 237.5(1)(a)` (`a position for the tests` (YMD 2024 6 10) TRUE 1000) (YMD 2024 5 10) (YMD 2024 6 10)
#ASSERT `the position is an acquisition in the period within s 237.5(1)(a)` (`a position for the tests` (YMD 2024 5 25) TRUE 1000) (YMD 2024 5 10) (YMD 2024 6 10)
#ASSERT NOT (`the position is an acquisition in the period within s 237.5(1)(a)` (`a position for the tests` (YMD 2024 5 9) TRUE 1000) (YMD 2024 5 10) (YMD 2024 6 10))
#ASSERT NOT (`the position is an acquisition in the period within s 237.5(1)(a)` (`a position for the tests` (YMD 2024 6 11) TRUE 1000) (YMD 2024 5 10) (YMD 2024 6 10))
-- A day in the period on which nothing was acquired does not count.
#ASSERT NOT (`the position is an acquisition in the period within s 237.5(1)(a)` (`a position for the tests` (YMD 2024 5 25) FALSE 1000) (YMD 2024 5 10) (YMD 2024 6 10))
-- (1)(a) as a whole: held on the day of the error, or acquired in the period.
#ASSERT `the plaintiff had or acquired a financial interest in time within s 237.5(1)(a)` TRUE (YMD 2024 5 10) (YMD 2024 6 10) EMPTY
#ASSERT `the plaintiff had or acquired a financial interest in time within s 237.5(1)(a)` FALSE (YMD 2024 5 10) (YMD 2024 6 10) (LIST (`a position for the tests` (YMD 2024 5 25) TRUE 1000))
#ASSERT NOT (`the plaintiff had or acquired a financial interest in time within s 237.5(1)(a)` FALSE (YMD 2024 5 10) (YMD 2024 6 10) (LIST (`a position for the tests` (YMD 2024 6 11) TRUE 1000)))
#ASSERT NOT (`the plaintiff had or acquired a financial interest in time within s 237.5(1)(a)` FALSE (YMD 2024 5 10) (YMD 2024 6 10) EMPTY)
-- (1)(b): not more than the prescribed amount (here $100,000, a figure the regulations would fix): equal qualifies.
#ASSERT `the value of the total financial interest was within the prescribed amount within s 237.5(1)(b)` TRUE 100000 (YMD 2024 5 10) (YMD 2024 6 10) EMPTY 100000
#ASSERT `the value of the total financial interest was within the prescribed amount within s 237.5(1)(b)` TRUE 99999 (YMD 2024 5 10) (YMD 2024 6 10) EMPTY 100000
#ASSERT NOT (`the value of the total financial interest was within the prescribed amount within s 237.5(1)(b)` TRUE 100001 (YMD 2024 5 10) (YMD 2024 6 10) EMPTY 100000)
-- The plaintiff must have established the value.
#ASSERT NOT (`the value of the total financial interest was within the prescribed amount within s 237.5(1)(b)` FALSE 1 (YMD 2024 5 10) (YMD 2024 6 10) EMPTY 100000)
-- Or on a day the plaintiff acquired an interest in the period, the evening's holding is within the amount.
#ASSERT `the value of the total financial interest was within the prescribed amount within s 237.5(1)(b)` TRUE 500000 (YMD 2024 5 10) (YMD 2024 6 10) (LIST (`a position for the tests` (YMD 2024 5 25) TRUE 90000)) 100000
#ASSERT NOT (`the value of the total financial interest was within the prescribed amount within s 237.5(1)(b)` TRUE 500000 (YMD 2024 5 10) (YMD 2024 6 10) (LIST (`a position for the tests` (YMD 2024 5 25) TRUE 100001)) 100000)
-- (1.1): the exception, either way of bringing the action.
#ASSERT `subsection 237.5(1) does not apply to the plaintiff within s 237.5(1.1)` TRUE FALSE
#ASSERT `subsection 237.5(1) does not apply to the plaintiff within s 237.5(1.1)` FALSE TRUE
#ASSERT NOT (`subsection 237.5(1) does not apply to the plaintiff within s 237.5(1.1)` FALSE FALSE)
-- (1) as a whole: an individual who held the interest on the day of the error, with a holding worth $50,000 against $100,000.
#ASSERT `the defendants and third parties are jointly and severally liable within s 237.5(1)` TRUE TRUE FALSE TRUE (YMD 2024 5 10) (YMD 2024 6 10) EMPTY TRUE 50000 100000 FALSE
-- A personal body corporate instead of an individual: also covered.
#ASSERT `the defendants and third parties are jointly and severally liable within s 237.5(1)` TRUE FALSE TRUE TRUE (YMD 2024 5 10) (YMD 2024 6 10) EMPTY TRUE 50000 100000 FALSE
-- Neither an individual nor a personal body corporate (for example a body corporate in business): not covered.
#ASSERT NOT (`the defendants and third parties are jointly and severally liable within s 237.5(1)` TRUE FALSE FALSE TRUE (YMD 2024 5 10) (YMD 2024 6 10) EMPTY TRUE 50000 100000 FALSE)
-- A holding above the prescribed amount: not covered by (1); s 237.6 may still reach it.
#ASSERT NOT (`the defendants and third parties are jointly and severally liable within s 237.5(1)` TRUE TRUE FALSE TRUE (YMD 2024 5 10) (YMD 2024 6 10) EMPTY TRUE 100001 100000 FALSE)
-- The defendants are not those referred to in 237.2(1).
#ASSERT NOT (`the defendants and third parties are jointly and severally liable within s 237.5(1)` FALSE TRUE FALSE TRUE (YMD 2024 5 10) (YMD 2024 6 10) EMPTY TRUE 50000 100000 FALSE)
-- Subsection (1.1) takes the plaintiff out.
#ASSERT NOT (`the defendants and third parties are jointly and severally liable within s 237.5(1)` TRUE TRUE FALSE TRUE (YMD 2024 5 10) (YMD 2024 6 10) EMPTY TRUE 50000 100000 TRUE)
-- Not established.
#ASSERT NOT (`the defendants and third parties are jointly and severally liable within s 237.5(1)` TRUE TRUE FALSE TRUE (YMD 2024 5 10) (YMD 2024 6 10) EMPTY FALSE 50000 100000 FALSE)

§§ `s 237.6 equitable grounds`

#ASSERT `the court may hold the defendants and third parties jointly and severally liable within s 237.6(1)` 100001 100000 TRUE
-- Equal to the prescribed amount is not "greater than": s 237.5(1)(b) already covers it.
#ASSERT NOT (`the court may hold the defendants and third parties jointly and severally liable within s 237.6(1)` 100000 100000 TRUE)
-- The court does not consider it just and reasonable.
#ASSERT NOT (`the court may hold the defendants and third parties jointly and severally liable within s 237.6(1)` 500000 100000 FALSE)

§§ `s 237.7 value of a security`

#ASSERT `organized market within s 237.7(4)` TRUE FALSE
#ASSERT `organized market within s 237.7(4)` FALSE TRUE
#ASSERT NOT (`organized market within s 237.7(4)` FALSE FALSE)
-- (a) the closing price.
#ASSERT `the value of the security within s 237.7(1)` TRUE (JUST 10) (JUST 12) (JUST 8) TRUE (JUST 9) (JUST 11) EQUALS JUST 10
-- (b) no closing price given: the average of the highest and lowest prices, (12 + 8) / 2 = 10.
#ASSERT `the value of the security within s 237.7(1)` TRUE NOTHING (JUST 12) (JUST 8) TRUE NOTHING NOTHING EQUALS JUST 10
#ASSERT `the value of the security within s 237.7(1)` TRUE NOTHING (JUST 15) (JUST 5) TRUE NOTHING NOTHING EQUALS JUST 10
-- (c) the security was not traded: the average of the bid and ask prices, (9 + 11) / 2 = 10.
#ASSERT `the value of the security within s 237.7(1)` TRUE NOTHING NOTHING NOTHING FALSE (JUST 9) (JUST 11) EQUALS JUST 10
#ASSERT `the value of the security within s 237.7(1)` TRUE NOTHING NOTHING NOTHING FALSE (JUST 8) (JUST 12) EQUALS JUST 10
-- Not covered by this subsection: no organized market, or the figures the limb needs are not given.
#ASSERT `the value of the security within s 237.7(1)` FALSE (JUST 10) (JUST 12) (JUST 8) TRUE (JUST 9) (JUST 11) EQUALS NOTHING
#ASSERT `the value of the security within s 237.7(1)` TRUE NOTHING NOTHING NOTHING TRUE NOTHING NOTHING EQUALS NOTHING
#ASSERT `the value of the security within s 237.7(1)` TRUE NOTHING (JUST 12) NOTHING TRUE NOTHING NOTHING EQUALS NOTHING
#ASSERT `the court may adjust the value within s 237.7(2)` TRUE
#ASSERT NOT (`the court may adjust the value within s 237.7(2)` FALSE)
-- (3): valued as of the day of the error unless acquired in the period, then as of the day acquired.
#ASSERT `the day as of which the value is determined within s 237.7(3)` (YMD 2024 5 10) (YMD 2024 6 10) NOTHING EQUALS YMD 2024 5 10
#ASSERT `the day as of which the value is determined within s 237.7(3)` (YMD 2024 5 10) (YMD 2024 6 10) (JUST (YMD 2024 5 25)) EQUALS YMD 2024 5 25
#ASSERT `the day as of which the value is determined within s 237.7(3)` (YMD 2024 5 10) (YMD 2024 6 10) (JUST (YMD 2024 6 10)) EQUALS YMD 2024 6 10
#ASSERT `the day as of which the value is determined within s 237.7(3)` (YMD 2024 5 10) (YMD 2024 6 10) (JUST (YMD 2024 6 11)) EQUALS YMD 2024 5 10
#ASSERT `the day as of which the value is determined within s 237.7(3)` (YMD 2024 5 10) (YMD 2024 6 10) (JUST (YMD 2024 5 9)) EQUALS YMD 2024 5 10

§§ `s 237.8 and s 237.9 other financial interests; application to determine value`

#ASSERT `the court must determine the value within s 237.8(1)` TRUE FALSE
#ASSERT `the court must determine the value within s 237.8(1)` FALSE TRUE
#ASSERT NOT (`the court must determine the value within s 237.8(1)` FALSE FALSE)
#ASSERT `the plaintiff may apply for the court to determine the value of the financial interest within s 237.9` TRUE
#ASSERT NOT (`the plaintiff may apply for the court to determine the value of the financial interest within s 237.9` FALSE)

§§ `the basis of liability: the three exceptions in front of the general rule`

#ASSERT `the basis of the liability within s 237.3(1) and s 237.4 to s 237.6` FALSE FALSE FALSE EQUALS `liable only for the portion of the damages that corresponds to their degree of responsibility`
#ASSERT `the basis of the liability within s 237.3(1) and s 237.4 to s 237.6` TRUE FALSE FALSE EQUALS `liable for the whole amount of the damages awarded because they acted fraudulently or dishonestly`
#ASSERT `the basis of the liability within s 237.3(1) and s 237.4 to s 237.6` FALSE TRUE FALSE EQUALS `jointly and severally, or solidarily, liable for the damages awarded`
#ASSERT `the basis of the liability within s 237.3(1) and s 237.4 to s 237.6` FALSE FALSE TRUE EQUALS `jointly and severally, or solidarily, liable for the damages awarded`
