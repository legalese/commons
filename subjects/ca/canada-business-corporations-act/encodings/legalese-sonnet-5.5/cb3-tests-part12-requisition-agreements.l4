IMPORT prelude
IMPORT `cbca-core`
IMPORT `cb3-part12-requisition-agreements`

-- Tests of cb3-part12-requisition-agreements.l4 (CBCA ss 143 to 146). Every expected value is written from the
-- text of the sections, quoted in the module; none is copied from the module's own output.

§ `Tests of Part XII, requisition, court meetings, agreements`


§§ `s 143(1), (2) -- the requisition`

#ASSERT `holders may requisition the directors to call a meeting within s 143(1)` 0.05
#ASSERT `holders may requisition the directors to call a meeting within s 143(1)` 0.5
#ASSERT NOT `holders may requisition the directors to call a meeting within s 143(1)` 0.0499
#ASSERT NOT `holders may requisition the directors to call a meeting within s 143(1)` 0
-- arguments: states the business, sent to each director, sent to the registered office, several documents are of like form and signed
#ASSERT `the requisition complies with s 143(2)` TRUE TRUE TRUE TRUE
#ASSERT NOT `the requisition complies with s 143(2)` FALSE TRUE TRUE TRUE
#ASSERT NOT `the requisition complies with s 143(2)` TRUE FALSE TRUE TRUE
#ASSERT NOT `the requisition complies with s 143(2)` TRUE TRUE FALSE TRUE
#ASSERT NOT `the requisition complies with s 143(2)` TRUE TRUE TRUE FALSE

§§ `s 143(3) -- the directors call the meeting, unless`

-- arguments: holders may requisition, the requisition complies, (a) a record date fixed under 134(1)(c), (a) notice of it given under 134(3),
-- (b) the directors have called a meeting and given notice under s 135, (c) the business includes matters described in 137(5)(b) to (e)
#ASSERT `the directors must call the meeting within s 143(3)` TRUE TRUE FALSE FALSE FALSE FALSE
#ASSERT NOT `the directors must call the meeting within s 143(3)` FALSE TRUE FALSE FALSE FALSE FALSE
#ASSERT NOT `the directors must call the meeting within s 143(3)` TRUE FALSE FALSE FALSE FALSE FALSE
-- (a) needs both the record date and the notice of it
#ASSERT NOT `the directors must call the meeting within s 143(3)` TRUE TRUE TRUE TRUE FALSE FALSE
#ASSERT `the directors must call the meeting within s 143(3)` TRUE TRUE TRUE FALSE FALSE FALSE
#ASSERT `the directors must call the meeting within s 143(3)` TRUE TRUE FALSE TRUE FALSE FALSE
-- (b) and (c) each excuse the directors
#ASSERT NOT `the directors must call the meeting within s 143(3)` TRUE TRUE FALSE FALSE TRUE FALSE
#ASSERT NOT `the directors must call the meeting within s 143(3)` TRUE TRUE FALSE FALSE FALSE TRUE
#ASSERT NOT `the directors must call the meeting within s 143(3)` TRUE TRUE TRUE TRUE TRUE TRUE

§§ `s 143(4) -- a shareholder calls the meeting`

#ASSERT `the last day for the directors to call the meeting within s 143(4)` (YMD 2027 3 1) EQUALS (YMD 2027 3 22)
-- across a month end, and across a leap day
#ASSERT `the last day for the directors to call the meeting within s 143(4)` (YMD 2027 3 20) EQUALS (YMD 2027 4 10)
#ASSERT `the last day for the directors to call the meeting within s 143(4)` (YMD 2028 2 20) EQUALS (YMD 2028 3 12)
-- arguments: the person signed the requisition, the directors were required to call by (3), the date the directors received it,
-- the date the directors called a meeting if they did, the date the shareholder calls the meeting
#ASSERT `a shareholder who signed may call the meeting within s 143(4)` TRUE TRUE (YMD 2027 3 1) NOTHING (YMD 2027 3 23)
-- the twenty-first day is still the directors' day
#ASSERT NOT `a shareholder who signed may call the meeting within s 143(4)` TRUE TRUE (YMD 2027 3 1) NOTHING (YMD 2027 3 22)
-- the directors called within the twenty-one days
#ASSERT NOT `a shareholder who signed may call the meeting within s 143(4)` TRUE TRUE (YMD 2027 3 1) (JUST (YMD 2027 3 22)) (YMD 2027 3 23)
#ASSERT NOT `a shareholder who signed may call the meeting within s 143(4)` TRUE TRUE (YMD 2027 3 1) (JUST (YMD 2027 3 10)) (YMD 2027 3 23)
-- the directors called, but late: the power arose on the twenty-third day
#ASSERT `a shareholder who signed may call the meeting within s 143(4)` TRUE TRUE (YMD 2027 3 1) (JUST (YMD 2027 3 30)) (YMD 2027 3 23)
#ASSERT NOT `a shareholder who signed may call the meeting within s 143(4)` FALSE TRUE (YMD 2027 3 1) NOTHING (YMD 2027 3 23)
-- the directors were not required to call (fork F-143-4)
#ASSERT NOT `a shareholder who signed may call the meeting within s 143(4)` TRUE FALSE (YMD 2027 3 1) NOTHING (YMD 2027 3 23)

§§ `s 143(5), (6) -- procedure and reimbursement`

#ASSERT `the meeting is called as s 143(5) requires within s 143(5)` TRUE TRUE
#ASSERT NOT `the meeting is called as s 143(5) requires within s 143(5)` TRUE FALSE
#ASSERT `the meeting is called as s 143(5) requires within s 143(5)` FALSE FALSE
-- arguments: a requisition was made, the meeting was called by the shareholders under (4), the shareholders resolved otherwise
#ASSERT `the corporation must reimburse the shareholders' expenses within s 143(6)` TRUE FALSE FALSE
#ASSERT `the corporation must reimburse the shareholders' expenses within s 143(6)` TRUE TRUE FALSE
#ASSERT NOT `the corporation must reimburse the shareholders' expenses within s 143(6)` TRUE TRUE TRUE
-- the contrary resolution is open only at a meeting called under (4) (fork F-143-6)
#ASSERT `the corporation must reimburse the shareholders' expenses within s 143(6)` TRUE FALSE TRUE
#ASSERT NOT `the corporation must reimburse the shareholders' expenses within s 143(6)` FALSE FALSE FALSE
-- arguments: the duty, the expenses reasonably incurred
#ASSERT `the amount to reimburse within s 143(6)` TRUE 1500 EQUALS JUST 1500
#ASSERT `the amount to reimburse within s 143(6)` TRUE 0 EQUALS JUST 0
-- no duty: the section gives no amount
#ASSERT `the amount to reimburse within s 143(6)` FALSE 1500 EQUALS NOTHING

§§ `s 144 -- a meeting called by the court`

-- arguments: the applicant is a director, a shareholder entitled to vote, the Director
#ASSERT `a person may apply to the court for a meeting within s 144(1)` TRUE FALSE FALSE
#ASSERT `a person may apply to the court for a meeting within s 144(1)` FALSE TRUE FALSE
#ASSERT `a person may apply to the court for a meeting within s 144(1)` FALSE FALSE TRUE
#ASSERT NOT `a person may apply to the court for a meeting within s 144(1)` FALSE FALSE FALSE
-- arguments: the application is by a person who may apply, (a) impracticable to call, (b) impracticable to conduct, (c) the court thinks it should
#ASSERT `the court may order a meeting to be called, held and conducted within s 144(1)` TRUE TRUE FALSE FALSE
#ASSERT `the court may order a meeting to be called, held and conducted within s 144(1)` TRUE FALSE TRUE FALSE
#ASSERT `the court may order a meeting to be called, held and conducted within s 144(1)` TRUE FALSE FALSE TRUE
#ASSERT NOT `the court may order a meeting to be called, held and conducted within s 144(1)` TRUE FALSE FALSE FALSE
#ASSERT NOT `the court may order a meeting to be called, held and conducted within s 144(1)` FALSE TRUE TRUE TRUE
#ASSERT `the court may vary or dispense with the quorum within s 144(2)` TRUE
#ASSERT NOT `the court may vary or dispense with the quorum within s 144(2)` FALSE
#ASSERT `the meeting is for all purposes a meeting duly called, held and conducted within s 144(3)` TRUE
#ASSERT NOT `the meeting is for all purposes a meeting duly called, held and conducted within s 144(3)` FALSE

§§ `s 145 -- court review of an election or appointment`

-- arguments: the applicant is the corporation, a shareholder or a director, the controversy is about an election or appointment of a director or auditor
#ASSERT `a person may apply to the court to determine a controversy within s 145(1)` TRUE TRUE
#ASSERT NOT `a person may apply to the court to determine a controversy within s 145(1)` TRUE FALSE
#ASSERT NOT `a person may apply to the court to determine a controversy within s 145(1)` FALSE TRUE
-- arguments: the application is made under s 145, the kind of order
#ASSERT `the court may make an order of a kind within s 145(2)` TRUE `an order restraining a director or auditor whose election or appointment is challenged from acting pending determination of the dispute`
#ASSERT `the court may make an order of a kind within s 145(2)` TRUE `an order declaring the result of the disputed election or appointment`
#ASSERT `the court may make an order of a kind within s 145(2)` TRUE `an order requiring a new election or appointment, with directions for the management of the business and affairs of the corporation until it is held or made`
#ASSERT `the court may make an order of a kind within s 145(2)` TRUE `an order determining the voting rights of shareholders and of persons claiming to own shares`
#ASSERT `the court may make an order of a kind within s 145(2)` TRUE `any other order the court thinks fit`
#ASSERT NOT `the court may make an order of a kind within s 145(2)` FALSE `an order declaring the result of the disputed election or appointment`
#ASSERT NOT `the court may make an order of a kind within s 145(2)` FALSE `any other order the court thinks fit`

§§ `s 145.1 -- pooling agreement`

-- arguments: in writing, the number of shareholders who are parties, it provides how the shares are to be voted
#ASSERT `an agreement may bind the shares to be voted as provided within s 145.1` TRUE 2 TRUE
#ASSERT `an agreement may bind the shares to be voted as provided within s 145.1` TRUE 3 TRUE
#ASSERT NOT `an agreement may bind the shares to be voted as provided within s 145.1` TRUE 1 TRUE
#ASSERT NOT `an agreement may bind the shares to be voted as provided within s 145.1` FALSE 2 TRUE
#ASSERT NOT `an agreement may bind the shares to be voted as provided within s 145.1` TRUE 2 FALSE

§§ `s 146 -- unanimous shareholder agreement`

-- (1) arguments: in writing, otherwise lawful, all the shareholders are parties, restricts the powers of the directors
#ASSERT `the agreement is valid within s 146(1)` TRUE TRUE TRUE TRUE
#ASSERT NOT `the agreement is valid within s 146(1)` FALSE TRUE TRUE TRUE
#ASSERT NOT `the agreement is valid within s 146(1)` TRUE FALSE TRUE TRUE
#ASSERT NOT `the agreement is valid within s 146(1)` TRUE TRUE FALSE TRUE
#ASSERT NOT `the agreement is valid within s 146(1)` TRUE TRUE TRUE FALSE
-- (2) arguments: the beneficial owner of all the issued shares, in writing, restricts the powers of the directors
#ASSERT `the declaration is deemed to be a unanimous shareholder agreement within s 146(2)` TRUE TRUE TRUE
#ASSERT NOT `the declaration is deemed to be a unanimous shareholder agreement within s 146(2)` FALSE TRUE TRUE
#ASSERT NOT `the declaration is deemed to be a unanimous shareholder agreement within s 146(2)` TRUE FALSE TRUE
#ASSERT NOT `the declaration is deemed to be a unanimous shareholder agreement within s 146(2)` TRUE TRUE FALSE
-- the keel's input, answered by (1) or (2)
#ASSERT `there is a unanimous shareholder agreement within s 146(1) and (2)` TRUE FALSE
#ASSERT `there is a unanimous shareholder agreement within s 146(1) and (2)` FALSE TRUE
#ASSERT `there is a unanimous shareholder agreement within s 146(1) and (2)` TRUE TRUE
#ASSERT NOT `there is a unanimous shareholder agreement within s 146(1) and (2)` FALSE FALSE
#ASSERT `the purchaser or transferee is deemed to be a party within s 146(3)` TRUE TRUE
#ASSERT NOT `the purchaser or transferee is deemed to be a party within s 146(3)` TRUE FALSE
#ASSERT NOT `the purchaser or transferee is deemed to be a party within s 146(3)` FALSE TRUE
#ASSERT `the last day to rescind within s 146(4)` (YMD 2027 3 1) EQUALS (YMD 2027 3 31)
-- thirty days after 15 February 2027 is 17 March; after 15 February 2028 (a leap year) it is 16 March
#ASSERT `the last day to rescind within s 146(4)` (YMD 2027 2 15) EQUALS (YMD 2027 3 17)
#ASSERT `the last day to rescind within s 146(4)` (YMD 2028 2 15) EQUALS (YMD 2028 3 16)
-- arguments: notice was given, the date the purchaser became aware, the date they rescind
#ASSERT `the purchaser or transferee may rescind the transaction within s 146(4)` FALSE (YMD 2027 3 1) (YMD 2027 3 31)
#ASSERT NOT `the purchaser or transferee may rescind the transaction within s 146(4)` FALSE (YMD 2027 3 1) (YMD 2027 4 1)
#ASSERT `the purchaser or transferee may rescind the transaction within s 146(4)` FALSE (YMD 2027 3 1) (YMD 2027 3 1)
-- notice was given: no right to rescind, however prompt
#ASSERT NOT `the purchaser or transferee may rescind the transaction within s 146(4)` TRUE (YMD 2027 3 1) (YMD 2027 3 2)
-- (5) arguments: the right, power, duty or liability is one the agreement takes from the directors, the person is a party given the power
#ASSERT `the party has the right, power, duty or liability of a director within s 146(5)` TRUE TRUE
#ASSERT NOT `the party has the right, power, duty or liability of a director within s 146(5)` TRUE FALSE
#ASSERT NOT `the party has the right, power, duty or liability of a director within s 146(5)` FALSE TRUE
#ASSERT `the directors are relieved of the right, power, duty or liability within s 146(5)` TRUE
#ASSERT NOT `the directors are relieved of the right, power, duty or liability within s 146(5)` FALSE
#ASSERT `shareholders may fetter their discretion within s 146(6)` TRUE
#ASSERT NOT `shareholders may fetter their discretion within s 146(6)` FALSE
