IMPORT prelude
IMPORT `cbca-core`
IMPORT `cb1-nouns`
IMPORT `cb1-part6-constrained-shares`

-- Tests of cb1-part6-constrained-shares.l4 (s 46 and s 47). Expected values are written from the text of the
-- Act (src:671-692), never from the code's output: each comment says what the text gives.

§ `Tests -- Part VI sale of constrained shares`

§§ `s 46`

-- src:671-674: three purposes, constraints in place, shares held contrary to them, prescribed conditions and notice
#ASSERT `the corporation may sell the constrained shares as if it were their owner within s 46(1)` `to assist the corporation or any of its affiliates or associates to qualify under a prescribed law of Canada or a province to receive licences, permits, grants, payments or other benefits by reason of attaining or maintaining a specified level of Canadian ownership or control` TRUE TRUE TRUE
#ASSERT `the corporation may sell the constrained shares as if it were their owner within s 46(1)` `to assist the corporation to comply with a prescribed law` TRUE TRUE TRUE
#ASSERT `the corporation may sell the constrained shares as if it were their owner within s 46(1)` `to attain or maintain a level of Canadian ownership specified in its articles` TRUE TRUE TRUE
#ASSERT NOT (`the corporation may sell the constrained shares as if it were their owner within s 46(1)` `any other purpose` TRUE TRUE TRUE)
#ASSERT NOT (`the corporation may sell the constrained shares as if it were their owner within s 46(1)` `to assist the corporation to comply with a prescribed law` FALSE TRUE TRUE)
#ASSERT NOT (`the corporation may sell the constrained shares as if it were their owner within s 46(1)` `to assist the corporation to comply with a prescribed law` TRUE FALSE TRUE)
#ASSERT NOT (`the corporation may sell the constrained shares as if it were their owner within s 46(1)` `to assist the corporation to comply with a prescribed law` TRUE TRUE FALSE)
-- src:676: in good faith, and not unfairly prejudicial to, nor unfairly disregarding, the holders taken as a whole
#ASSERT `the directors have complied with the duty in selecting the shares for sale within s 46(2)` TRUE FALSE FALSE
#ASSERT NOT (`the directors have complied with the duty in selecting the shares for sale within s 46(2)` FALSE FALSE FALSE)
#ASSERT NOT (`the directors have complied with the duty in selecting the shares for sale within s 46(2)` TRUE TRUE FALSE)
#ASSERT NOT (`the directors have complied with the duty in selecting the shares for sale within s 46(2)` TRUE FALSE TRUE)
-- src:678: divested; the person who would be the registered owner receives only the net proceeds, with income, less taxes and costs
#ASSERT `the owner immediately before the sale is divested of their interest or right in the shares within s 46(3)` TRUE
#ASSERT NOT (`the owner immediately before the sale is divested of their interest or right in the shares within s 46(3)` FALSE)
#ASSERT `what the person who would otherwise be the registered owner receives within s 46(3)` 1000 20 50 30 EQUALS 940
#ASSERT `what the person who would otherwise be the registered owner receives within s 46(3)` 1000 0 0 0 EQUALS 1000
#ASSERT `the person is entitled to receive only the net proceeds of the sale within s 46(3)` TRUE TRUE FALSE
#ASSERT `the person is entitled to receive only the net proceeds of the sale within s 46(3)` TRUE FALSE TRUE
#ASSERT NOT (`the person is entitled to receive only the net proceeds of the sale within s 46(3)` TRUE FALSE FALSE)
#ASSERT NOT (`the person is entitled to receive only the net proceeds of the sale within s 46(3)` FALSE TRUE TRUE)
-- src:680
#ASSERT `subsections 51(4) to (6) apply to the person as if the proceeds were a security and the person were a registered holder or owner within s 46(4)` TRUE
#ASSERT NOT (`subsections 51(4) to (6) apply to the person as if the proceeds were a security and the person were a registered holder or owner within s 46(4)` FALSE)

§§ `s 47`

-- src:682
#ASSERT `the proceeds constitute a trust fund in the hands of the corporation within s 47(1)` TRUE
#ASSERT NOT (`the proceeds constitute a trust fund in the hands of the corporation within s 47(1)` FALSE)
#ASSERT `the trust fund has been invested as s 47(1) requires` TRUE
#ASSERT NOT (`the trust fund has been invested as s 47(1) requires` FALSE)
-- src:684
#ASSERT `the corporation may deduct the costs from the trust fund and any income earned thereon within s 47(2)` TRUE
#ASSERT NOT (`the corporation may deduct the costs from the trust fund and any income earned thereon within s 47(2)` FALSE)
-- src:686
#ASSERT `the corporation may transfer the trust fund and its administration to the transferee within s 47(3)` TRUE
#ASSERT NOT (`the corporation may transfer the trust fund and its administration to the transferee within s 47(3)` FALSE)
#ASSERT `the corporation is discharged of all further liability in respect of the trust fund within s 47(3)` TRUE
#ASSERT NOT (`the corporation is discharged of all further liability in respect of the trust fund within s 47(3)` FALSE)
-- src:688
#ASSERT `the receipt is a complete discharge of the corporation and of any trust company within s 47(4)` TRUE
#ASSERT NOT (`the receipt is a complete discharge of the corporation and of any trust company within s 47(4)` FALSE)
-- src:690: unclaimed for ten years after the sale (1 March 2026), the last day is 1 March 2036 (fork F1)
#ASSERT `the last day the fund can be claimed before it vests in the Crown within s 47(5)` (YearMonthDay 2026 3 1) EQUALS YearMonthDay 2036 3 1
#ASSERT NOT (`the fund has vested in Her Majesty in right of Canada on the day within s 47(5)` (YearMonthDay 2026 3 1) FALSE (YearMonthDay 2036 3 1))
#ASSERT `the fund has vested in Her Majesty in right of Canada on the day within s 47(5)` (YearMonthDay 2026 3 1) FALSE (YearMonthDay 2036 3 2)
-- claimed: it does not vest
#ASSERT NOT (`the fund has vested in Her Majesty in right of Canada on the day within s 47(5)` (YearMonthDay 2026 3 1) TRUE (YearMonthDay 2040 1 1))
-- before the sale, nothing has vested
#ASSERT NOT (`the fund has vested in Her Majesty in right of Canada on the day within s 47(5)` (YearMonthDay 2026 3 1) FALSE (YearMonthDay 2025 1 1))
-- src:692
#ASSERT `sections 3 to 5 of the Escheats Act apply to the fund within s 47(6)` TRUE
#ASSERT NOT (`sections 3 to 5 of the Escheats Act apply to the fund within s 47(6)` FALSE)
