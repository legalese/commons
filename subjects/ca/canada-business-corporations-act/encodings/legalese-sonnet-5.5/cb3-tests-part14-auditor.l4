§§ `s 170 -- the right to information`

-- arguments: the auditor demands it, a present or former director etc., information or access, necessary in the auditor's opinion, reasonably able
#ASSERT `the person must provide it on the auditor's demand within s 170(1)` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT `the person must provide it on the auditor's demand within s 170(1)` FALSE TRUE TRUE TRUE TRUE
#ASSERT NOT `the person must provide it on the auditor's demand within s 170(1)` TRUE FALSE TRUE TRUE TRUE
#ASSERT NOT `the person must provide it on the auditor's demand within s 170(1)` TRUE TRUE FALSE TRUE TRUE
#ASSERT NOT `the person must provide it on the auditor's demand within s 170(1)` TRUE TRUE TRUE FALSE TRUE
#ASSERT NOT `the person must provide it on the auditor's demand within s 170(1)` TRUE TRUE TRUE TRUE FALSE
-- (2) arguments: the auditor demands it, those a subsidiary's people are reasonably able to provide, necessary in the auditor's opinion
#ASSERT `the directors must obtain and furnish the information within s 170(2)` TRUE TRUE TRUE
#ASSERT NOT `the directors must obtain and furnish the information within s 170(2)` FALSE TRUE TRUE
#ASSERT NOT `the directors must obtain and furnish the information within s 170(2)` TRUE FALSE TRUE
#ASSERT NOT `the directors must obtain and furnish the information within s 170(2)` TRUE TRUE FALSE
-- arguments: the duty, obtained, furnished
#ASSERT `the duty to obtain and furnish the information is met within s 170(2)` TRUE TRUE TRUE
#ASSERT NOT `the duty to obtain and furnish the information is met within s 170(2)` TRUE TRUE FALSE
#ASSERT NOT `the duty to obtain and furnish the information is met within s 170(2)` TRUE FALSE TRUE
#ASSERT `the duty to obtain and furnish the information is met within s 170(2)` FALSE FALSE FALSE
-- (3) arguments: in good faith under (1) or (2), a civil proceeding arising from the communication
#ASSERT `the person is not liable in the civil proceeding within s 170(3)` TRUE TRUE
#ASSERT NOT `the person is not liable in the civil proceeding within s 170(3)` TRUE FALSE
#ASSERT NOT `the person is not liable in the civil proceeding within s 170(3)` FALSE TRUE

§§ `s 171 -- the audit committee`

-- arguments: the corporation is described in s 102(2), the Director has authorized it to dispense with a committee
#ASSERT `the corporation must have an audit committee within s 171(1)` TRUE FALSE
#ASSERT NOT `the corporation must have an audit committee within s 171(1)` TRUE TRUE
#ASSERT NOT `the corporation must have an audit committee within s 171(1)` FALSE FALSE
#ASSERT `a corporation not described in subsection 102(2) may have an audit committee within s 171(1)` FALSE
#ASSERT NOT `a corporation not described in subsection 102(2) may have an audit committee within s 171(1)` TRUE
-- arguments: the number of members, all are directors, the number who are not officers or employees of the corporation or its affiliates
#ASSERT `the audit committee is composed as s 171(1) requires within s 171(1)` 3 TRUE 2
#ASSERT `the audit committee is composed as s 171(1) requires within s 171(1)` 4 TRUE 3
#ASSERT `the audit committee is composed as s 171(1) requires within s 171(1)` 5 TRUE 3
-- a majority is more than half
#ASSERT NOT `the audit committee is composed as s 171(1) requires within s 171(1)` 3 TRUE 1
#ASSERT NOT `the audit committee is composed as s 171(1) requires within s 171(1)` 4 TRUE 2
-- not fewer than three
#ASSERT NOT `the audit committee is composed as s 171(1) requires within s 171(1)` 2 TRUE 2
-- all directors
#ASSERT NOT `the audit committee is composed as s 171(1) requires within s 171(1)` 3 FALSE 3
#ASSERT `the Director may authorize the corporation to dispense with an audit committee within s 171(2)` TRUE
#ASSERT NOT `the Director may authorize the corporation to dispense with an audit committee within s 171(2)` FALSE
#ASSERT `the Director may permit the corporation to dispense with an audit committee on conditions within s 171(2)` TRUE TRUE
#ASSERT NOT `the Director may permit the corporation to dispense with an audit committee on conditions within s 171(2)` TRUE FALSE
#ASSERT NOT `the Director may permit the corporation to dispense with an audit committee on conditions within s 171(2)` FALSE TRUE
-- (3) arguments: the date of the review, the date of the approval under s 158 (a date has no time: same day counts as before, fork F-171-before)
#ASSERT `the audit committee reviewed the statements before they were approved within s 171(3)` (YearMonthDay 2027 3 1) (YearMonthDay 2027 3 2)
#ASSERT `the audit committee reviewed the statements before they were approved within s 171(3)` (YearMonthDay 2027 3 2) (YearMonthDay 2027 3 2)
#ASSERT NOT `the audit committee reviewed the statements before they were approved within s 171(3)` (YearMonthDay 2027 3 3) (YearMonthDay 2027 3 2)
#ASSERT `the auditor is entitled to notice of and to attend and be heard at the committee's meetings within s 171(4)` TRUE
#ASSERT NOT `the auditor is entitled to notice of and to attend and be heard at the committee's meetings within s 171(4)` FALSE
-- arguments: a member has requested the auditor to attend, the meeting is held during the auditor's term of office
#ASSERT `the auditor must attend the committee's meeting within s 171(4)` TRUE TRUE
#ASSERT NOT `the auditor must attend the committee's meeting within s 171(4)` TRUE FALSE
#ASSERT NOT `the auditor must attend the committee's meeting within s 171(4)` FALSE TRUE
#ASSERT `a person may call a meeting of the audit committee within s 171(5)` TRUE FALSE
#ASSERT `a person may call a meeting of the audit committee within s 171(5)` FALSE TRUE
#ASSERT NOT `a person may call a meeting of the audit committee within s 171(5)` FALSE FALSE
-- (6) arguments: a director or officer, becomes aware of an error or mis-statement in a statement the auditor reported on
#ASSERT `the director or officer must notify the committee and the auditor within s 171(6)` TRUE TRUE
#ASSERT NOT `the director or officer must notify the committee and the auditor within s 171(6)` TRUE FALSE
#ASSERT NOT `the director or officer must notify the committee and the auditor within s 171(6)` FALSE TRUE
#ASSERT `the duty to notify the committee and the auditor is met within s 171(6)` TRUE TRUE TRUE
#ASSERT NOT `the duty to notify the committee and the auditor is met within s 171(6)` TRUE TRUE FALSE
#ASSERT NOT `the duty to notify the committee and the auditor is met within s 171(6)` TRUE FALSE TRUE
#ASSERT `the duty to notify the committee and the auditor is met within s 171(6)` FALSE FALSE FALSE
