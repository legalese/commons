IMPORT prelude
IMPORT `cbca-core`
IMPORT `cb3-nouns`
IMPORT `cb3-part14-auditor`

-- Tests of cb3-part14-auditor.l4 (CBCA ss 161 to 172). Every expected value is written from the text of the
-- sections, quoted in the module; none is copied from the module's own output.

§ `Tests of Part XIV, the auditor`

-- Three tallies of votes on an ordinary resolution (s 2(1): a majority of the votes cast by the shareholders who voted).
`a tally: 60 for, 40 against` MEANS `Vote tally` WITH `votes cast in favour` IS 60, `votes cast against` IS 40, `signed by all the shareholders entitled to vote on the resolution` IS FALSE
`a tally: 40 for, 60 against` MEANS `Vote tally` WITH `votes cast in favour` IS 40, `votes cast against` IS 60, `signed by all the shareholders entitled to vote on the resolution` IS FALSE
`a tally: 50 for, 50 against` MEANS `Vote tally` WITH `votes cast in favour` IS 50, `votes cast against` IS 50, `signed by all the shareholders entitled to vote on the resolution` IS FALSE


§§ `s 161 -- qualification`

#ASSERT `a business partner within s 161(2.1)` TRUE FALSE
#ASSERT `a business partner within s 161(2.1)` FALSE TRUE
#ASSERT `a business partner within s 161(2.1)` TRUE TRUE
#ASSERT NOT `a business partner within s 161(2.1)` FALSE FALSE
-- (2)(b) arguments: (i) partner, director, officer or employee, (ii) a material interest, (iii) the last day the person or partner was a receiver etc. if ever,
-- the date of the proposed appointment
#ASSERT `the person is deemed not independent within s 161(2)(b)` TRUE FALSE NOTHING (YearMonthDay 2027 1 1)
#ASSERT `the person is deemed not independent within s 161(2)(b)` FALSE TRUE NOTHING (YearMonthDay 2027 1 1)
#ASSERT NOT `the person is deemed not independent within s 161(2)(b)` FALSE FALSE NOTHING (YearMonthDay 2027 1 1)
-- (iii) within two years of the proposed appointment: two years after 15 January 2025 is 15 January 2027
#ASSERT `the person is deemed not independent within s 161(2)(b)` FALSE FALSE (JUST (YearMonthDay 2025 1 15)) (YearMonthDay 2027 1 15)
#ASSERT NOT `the person is deemed not independent within s 161(2)(b)` FALSE FALSE (JUST (YearMonthDay 2025 1 15)) (YearMonthDay 2027 1 16)
-- two years after 29 February 2024 is 28 February 2026 (the keel's clamp)
#ASSERT `the person is deemed not independent within s 161(2)(b)` FALSE FALSE (JUST (YearMonthDay 2024 2 29)) (YearMonthDay 2026 2 28)
#ASSERT NOT `the person is deemed not independent within s 161(2)(b)` FALSE FALSE (JUST (YearMonthDay 2024 2 29)) (YearMonthDay 2026 3 1)
-- still in the office at the appointment
#ASSERT `the person is deemed not independent within s 161(2)(b)` FALSE FALSE (JUST (YearMonthDay 2027 6 1)) (YearMonthDay 2027 1 1)
-- arguments: independent as a question of fact, deemed not independent under (2)(b)
#ASSERT NOT `the person is not independent within s 161(2)` TRUE FALSE
#ASSERT `the person is not independent within s 161(2)` TRUE TRUE
#ASSERT `the person is not independent within s 161(2)` FALSE FALSE
#ASSERT `the person is not independent within s 161(2)` FALSE TRUE
-- arguments: the person is not independent, an exemption order has been made
#ASSERT `a person is disqualified from being an auditor within s 161(1)` TRUE FALSE
#ASSERT NOT `a person is disqualified from being an auditor within s 161(1)` TRUE TRUE
#ASSERT NOT `a person is disqualified from being an auditor within s 161(1)` FALSE FALSE
#ASSERT NOT `a person is disqualified from being an auditor within s 161(1)` FALSE TRUE
#ASSERT `the auditor must resign forthwith within s 161(3)` TRUE
#ASSERT NOT `the auditor must resign forthwith within s 161(3)` FALSE
#ASSERT `the duty to resign is met within s 161(3)` TRUE TRUE
#ASSERT NOT `the duty to resign is met within s 161(3)` TRUE FALSE
#ASSERT `the duty to resign is met within s 161(3)` FALSE FALSE
-- arguments: the applicant is an interested person, the auditor is disqualified
#ASSERT `an interested person may apply for a disqualification order within s 161(4)` TRUE TRUE
#ASSERT NOT `an interested person may apply for a disqualification order within s 161(4)` TRUE FALSE
#ASSERT NOT `an interested person may apply for a disqualification order within s 161(4)` FALSE TRUE
#ASSERT `an interested person may apply for an exemption order within s 161(5)` TRUE
#ASSERT NOT `an interested person may apply for an exemption order within s 161(5)` FALSE
-- arguments: an application is made by an interested person, the court is satisfied the exemption would not unfairly prejudice the shareholders
#ASSERT `the court may make an exemption order within s 161(5)` TRUE TRUE
#ASSERT NOT `the court may make an exemption order within s 161(5)` TRUE FALSE
#ASSERT NOT `the court may make an exemption order within s 161(5)` FALSE TRUE
#ASSERT `the exemption order may have retrospective effect within s 161(5)` TRUE
#ASSERT NOT `the exemption order may have retrospective effect within s 161(5)` FALSE

§§ `s 162 -- appointment`

-- arguments: the first or a succeeding annual meeting, the shareholders have resolved under s 163 not to appoint
#ASSERT `the shareholders must appoint an auditor within s 162(1)` TRUE FALSE
#ASSERT NOT `the shareholders must appoint an auditor within s 162(1)` TRUE TRUE
#ASSERT NOT `the shareholders must appoint an auditor within s 162(1)` FALSE FALSE
-- arguments: the duty, the tally of the vote
#ASSERT `the auditor is appointed by ordinary resolution within s 162(1)` TRUE `a tally: 60 for, 40 against`
#ASSERT NOT `the auditor is appointed by ordinary resolution within s 162(1)` TRUE `a tally: 40 for, 60 against`
-- a tie is not a majority of the votes cast
#ASSERT NOT `the auditor is appointed by ordinary resolution within s 162(1)` TRUE `a tally: 50 for, 50 against`
#ASSERT `the auditor is appointed by ordinary resolution within s 162(1)` FALSE `a tally: 40 for, 60 against`
-- arguments: the date, the date of the close of the next annual meeting
#ASSERT `the appointed auditor holds office within s 162(1)` (YearMonthDay 2027 5 1) (YearMonthDay 2028 5 31)
#ASSERT `the appointed auditor holds office within s 162(1)` (YearMonthDay 2028 5 31) (YearMonthDay 2028 5 31)
#ASSERT NOT `the appointed auditor holds office within s 162(1)` (YearMonthDay 2028 6 1) (YearMonthDay 2028 5 31)
#ASSERT `the auditor appointed under section 104 is eligible within s 162(2)` TRUE
#ASSERT NOT `the auditor appointed under section 104 is eligible within s 162(2)` FALSE
-- arguments: an auditor is not appointed at a meeting, a successor has been appointed
#ASSERT `the incumbent auditor continues in office within s 162(3)` TRUE FALSE
#ASSERT NOT `the incumbent auditor continues in office within s 162(3)` TRUE TRUE
#ASSERT NOT `the incumbent auditor continues in office within s 162(3)` FALSE FALSE
-- arguments: the remuneration has been fixed by ordinary resolution
#ASSERT `the directors may fix the remuneration of the auditor within s 162(4)` FALSE
#ASSERT NOT `the directors may fix the remuneration of the auditor within s 162(4)` TRUE

§§ `s 163 -- dispensing with the auditor`

#ASSERT `shareholders may resolve not to appoint an auditor within s 163(1)` FALSE
#ASSERT NOT `shareholders may resolve not to appoint an auditor within s 163(1)` TRUE
-- arguments: a distributing corporation, consented to by all the shareholders including non-voting, the date, the date of the next succeeding annual meeting
#ASSERT `the resolution not to appoint an auditor is valid within s 163` FALSE TRUE (YearMonthDay 2027 5 1) (YearMonthDay 2028 5 31)
-- valid only until the next annual meeting (fork F-163-until): not on the day of it
#ASSERT NOT `the resolution not to appoint an auditor is valid within s 163` FALSE TRUE (YearMonthDay 2028 5 31) (YearMonthDay 2028 5 31)
#ASSERT NOT `the resolution not to appoint an auditor is valid within s 163` FALSE TRUE (YearMonthDay 2028 6 1) (YearMonthDay 2028 5 31)
#ASSERT `the resolution not to appoint an auditor is valid within s 163` FALSE TRUE (YearMonthDay 2028 5 30) (YearMonthDay 2028 5 31)
-- not valid unless every shareholder consents
#ASSERT NOT `the resolution not to appoint an auditor is valid within s 163` FALSE FALSE (YearMonthDay 2027 5 1) (YearMonthDay 2028 5 31)
-- not for a distributing corporation
#ASSERT NOT `the resolution not to appoint an auditor is valid within s 163` TRUE TRUE (YearMonthDay 2027 5 1) (YearMonthDay 2028 5 31)

§§ `s 164 -- ceasing to hold office`

#ASSERT `the auditor ceases to hold office within s 164(1)` TRUE FALSE FALSE
#ASSERT `the auditor ceases to hold office within s 164(1)` FALSE TRUE FALSE
#ASSERT `the auditor ceases to hold office within s 164(1)` FALSE FALSE TRUE
#ASSERT NOT `the auditor ceases to hold office within s 164(1)` FALSE FALSE FALSE
-- arguments: the date the written resignation is sent, the date specified in it if any
#ASSERT `the date the resignation becomes effective within s 164(2)` (YearMonthDay 2027 3 1) (JUST (YearMonthDay 2027 4 1)) EQUALS (YearMonthDay 2027 4 1)
-- whichever is later: a date specified before the sending day does not bring it forward
#ASSERT `the date the resignation becomes effective within s 164(2)` (YearMonthDay 2027 3 1) (JUST (YearMonthDay 2027 2 1)) EQUALS (YearMonthDay 2027 3 1)
#ASSERT `the date the resignation becomes effective within s 164(2)` (YearMonthDay 2027 3 1) NOTHING EQUALS (YearMonthDay 2027 3 1)
#ASSERT `the date the resignation becomes effective within s 164(2)` (YearMonthDay 2027 3 1) (JUST (YearMonthDay 2027 3 1)) EQUALS (YearMonthDay 2027 3 1)

§§ `s 165 -- removal`

-- arguments: the resolution is passed at a special meeting, the tally, the auditor was appointed by a court under s 167
#ASSERT `the shareholders may remove the auditor within s 165(1)` TRUE `a tally: 60 for, 40 against` FALSE
#ASSERT NOT `the shareholders may remove the auditor within s 165(1)` TRUE `a tally: 40 for, 60 against` FALSE
#ASSERT NOT `the shareholders may remove the auditor within s 165(1)` TRUE `a tally: 50 for, 50 against` FALSE
#ASSERT NOT `the shareholders may remove the auditor within s 165(1)` TRUE `a tally: 60 for, 40 against` TRUE
#ASSERT NOT `the shareholders may remove the auditor within s 165(1)` FALSE `a tally: 60 for, 40 against` FALSE
-- arguments: the vacancy was created by removal, the filling is at the removal meeting
#ASSERT `the vacancy may be filled at the meeting of removal within s 165(2)` TRUE TRUE
#ASSERT NOT `the vacancy may be filled at the meeting of removal within s 165(2)` TRUE FALSE
#ASSERT NOT `the vacancy may be filled at the meeting of removal within s 165(2)` FALSE TRUE
-- arguments: the vacancy was created by removal, it was not filled at that meeting
#ASSERT `the vacancy may be filled under section 166 within s 165(2)` TRUE TRUE
#ASSERT NOT `the vacancy may be filled under section 166 within s 165(2)` TRUE FALSE
#ASSERT NOT `the vacancy may be filled under section 166 within s 165(2)` FALSE TRUE

§§ `s 166 -- filling a vacancy`

-- arguments: there is a vacancy, the articles provide that it shall only be filled by vote of the shareholders
#ASSERT `the directors must fill the vacancy forthwith within s 166(1)` TRUE FALSE
#ASSERT NOT `the directors must fill the vacancy forthwith within s 166(1)` TRUE TRUE
#ASSERT NOT `the directors must fill the vacancy forthwith within s 166(1)` FALSE FALSE
#ASSERT `the duty to fill the vacancy is met within s 166(1)` TRUE TRUE
#ASSERT NOT `the duty to fill the vacancy is met within s 166(1)` TRUE FALSE
#ASSERT `the duty to fill the vacancy is met within s 166(1)` FALSE FALSE
#ASSERT `the articles may so provide within s 166(3)` TRUE
#ASSERT `the articles may so provide within s 166(3)` FALSE
#ASSERT `the last day for the directors in office to call the meeting within s 166(2)` (YearMonthDay 2027 3 1) EQUALS (YearMonthDay 2027 3 22)
#ASSERT `the last day for the directors in office to call the meeting within s 166(2)` (YearMonthDay 2028 2 20) EQUALS (YearMonthDay 2028 3 12)
-- arguments: there is a vacancy, there is not a quorum of directors
#ASSERT `the directors then in office must call a special meeting within s 166(2)` TRUE TRUE
#ASSERT NOT `the directors then in office must call a special meeting within s 166(2)` TRUE FALSE
#ASSERT NOT `the directors then in office must call a special meeting within s 166(2)` FALSE TRUE
-- arguments: there are no directors, the directors in office must call, the date the vacancy occurs, the date the directors called if they did, the date the shareholder calls
#ASSERT `any shareholder may call the meeting within s 166(2)` TRUE FALSE (YearMonthDay 2027 3 1) NOTHING (YearMonthDay 2027 3 2)
#ASSERT `any shareholder may call the meeting within s 166(2)` FALSE TRUE (YearMonthDay 2027 3 1) NOTHING (YearMonthDay 2027 3 23)
#ASSERT NOT `any shareholder may call the meeting within s 166(2)` FALSE TRUE (YearMonthDay 2027 3 1) NOTHING (YearMonthDay 2027 3 22)
#ASSERT NOT `any shareholder may call the meeting within s 166(2)` FALSE TRUE (YearMonthDay 2027 3 1) (JUST (YearMonthDay 2027 3 20)) (YearMonthDay 2027 3 23)
-- the directors called, but late
#ASSERT `any shareholder may call the meeting within s 166(2)` FALSE TRUE (YearMonthDay 2027 3 1) (JUST (YearMonthDay 2027 3 25)) (YearMonthDay 2027 3 23)
-- a quorum of directors: the directors fill the vacancy under (1), not the shareholders
#ASSERT NOT `any shareholder may call the meeting within s 166(2)` FALSE FALSE (YearMonthDay 2027 3 1) NOTHING (YearMonthDay 2027 3 30)
#ASSERT `the date the term of the auditor appointed to fill the vacancy ends within s 166(4)` (YearMonthDay 2028 5 31) EQUALS (YearMonthDay 2028 5 31)

§§ `s 167 -- an auditor appointed by the court`

-- arguments: the corporation does not have an auditor, the applicant is a shareholder, the Director, the shareholders have resolved under s 163 not to appoint
#ASSERT `the court may appoint an auditor and fix the remuneration within s 167` TRUE TRUE FALSE FALSE
#ASSERT `the court may appoint an auditor and fix the remuneration within s 167` TRUE FALSE TRUE FALSE
#ASSERT NOT `the court may appoint an auditor and fix the remuneration within s 167` TRUE FALSE FALSE FALSE
#ASSERT NOT `the court may appoint an auditor and fix the remuneration within s 167` FALSE TRUE FALSE FALSE
#ASSERT NOT `the court may appoint an auditor and fix the remuneration within s 167` TRUE TRUE FALSE TRUE

§§ `s 168 -- the auditor, statements, replacement`

#ASSERT `the auditor is entitled to notice of and to attend and be heard at shareholders' meetings within s 168(1)` TRUE
#ASSERT NOT `the auditor is entitled to notice of and to attend and be heard at shareholders' meetings within s 168(1)` FALSE
#ASSERT `the corporation bears the expense of the auditor's attendance within s 168(1)` TRUE TRUE
#ASSERT NOT `the corporation bears the expense of the auditor's attendance within s 168(1)` TRUE FALSE
#ASSERT NOT `the corporation bears the expense of the auditor's attendance within s 168(1)` FALSE TRUE
-- (2) arguments: the auditor or a former auditor, a director or shareholder gave written notice, the date of the notice, the date of the meeting
#ASSERT `the auditor or former auditor must attend the meeting within s 168(2)` TRUE TRUE (YearMonthDay 2027 6 20) (YearMonthDay 2027 6 30)
#ASSERT `the auditor or former auditor must attend the meeting within s 168(2)` TRUE TRUE (YearMonthDay 2027 6 1) (YearMonthDay 2027 6 30)
-- not less than ten days before: the tenth day before is the last
#ASSERT NOT `the auditor or former auditor must attend the meeting within s 168(2)` TRUE TRUE (YearMonthDay 2027 6 21) (YearMonthDay 2027 6 30)
#ASSERT `the auditor or former auditor must attend the meeting within s 168(2)` TRUE TRUE (YearMonthDay 2027 6 25) (YearMonthDay 2027 7 5)
#ASSERT NOT `the auditor or former auditor must attend the meeting within s 168(2)` TRUE TRUE (YearMonthDay 2027 6 26) (YearMonthDay 2027 7 5)
#ASSERT NOT `the auditor or former auditor must attend the meeting within s 168(2)` FALSE TRUE (YearMonthDay 2027 6 1) (YearMonthDay 2027 6 30)
#ASSERT NOT `the auditor or former auditor must attend the meeting within s 168(2)` TRUE FALSE (YearMonthDay 2027 6 1) (YearMonthDay 2027 6 30)
-- arguments: the duty, attends, answers questions relating to their duties
#ASSERT `the duty to attend and answer questions is met within s 168(2)` TRUE TRUE TRUE
#ASSERT NOT `the duty to attend and answer questions is met within s 168(2)` TRUE TRUE FALSE
#ASSERT NOT `the duty to attend and answer questions is met within s 168(2)` TRUE FALSE TRUE
#ASSERT `the duty to attend and answer questions is met within s 168(2)` FALSE FALSE FALSE
-- (3) arguments: the date the notice was sent, the date the copy was sent to the corporation
#ASSERT `the copy of the notice to the corporation is sent as s 168(3) requires within s 168(3)` (YearMonthDay 2027 6 1) (YearMonthDay 2027 6 1)
#ASSERT NOT `the copy of the notice to the corporation is sent as s 168(3) requires within s 168(3)` (YearMonthDay 2027 6 1) (YearMonthDay 2027 6 2)
#ASSERT NOT `the copy of the notice to the corporation is sent as s 168(3) requires within s 168(3)` (YearMonthDay 2027 6 1) (YearMonthDay 2027 5 31)
-- (4) arguments: must attend, failed to comply, without reasonable cause
#ASSERT `the auditor or former auditor is guilty of an offence within s 168(4)` TRUE TRUE TRUE
#ASSERT NOT `the auditor or former auditor is guilty of an offence within s 168(4)` FALSE TRUE TRUE
#ASSERT NOT `the auditor or former auditor is guilty of an offence within s 168(4)` TRUE FALSE TRUE
#ASSERT NOT `the auditor or former auditor is guilty of an offence within s 168(4)` TRUE TRUE FALSE
#ASSERT (`the penalty ceiling within s 168(4)`)'s `maximum fine in dollars` EQUALS 5000
#ASSERT (`the penalty ceiling within s 168(4)`)'s `maximum imprisonment in months` EQUALS JUST 6
-- (5) arguments: resigns, learns of a removal meeting, learns of a meeting to appoint another person, learns of a s 163 meeting
#ASSERT `the auditor is entitled to submit a statement within s 168(5)` TRUE FALSE FALSE FALSE
#ASSERT `the auditor is entitled to submit a statement within s 168(5)` FALSE TRUE FALSE FALSE
#ASSERT `the auditor is entitled to submit a statement within s 168(5)` FALSE FALSE TRUE FALSE
#ASSERT `the auditor is entitled to submit a statement within s 168(5)` FALSE FALSE FALSE TRUE
#ASSERT NOT `the auditor is entitled to submit a statement within s 168(5)` FALSE FALSE FALSE FALSE
#ASSERT `the corporation must make a statement on the reasons for the replacement within s 168(5.1)(a)` TRUE
#ASSERT NOT `the corporation must make a statement on the reasons for the replacement within s 168(5.1)(a)` FALSE
#ASSERT `the proposed replacement auditor may comment within s 168(5.1)(b)` TRUE
#ASSERT NOT `the proposed replacement auditor may comment within s 168(5.1)(b)` FALSE
-- (6) arguments: there is a statement, it is included in or attached to a management proxy circular
#ASSERT `the corporation must send a copy of the statements within s 168(6)` TRUE FALSE
#ASSERT NOT `the corporation must send a copy of the statements within s 168(6)` TRUE TRUE
#ASSERT NOT `the corporation must send a copy of the statements within s 168(6)` FALSE FALSE
-- arguments: the duty, sent without delay to every shareholder entitled to notice, sent without delay to the Director
#ASSERT `the duty to send a copy of the statements is met within s 168(6)` TRUE TRUE TRUE
#ASSERT NOT `the duty to send a copy of the statements is met within s 168(6)` TRUE TRUE FALSE
#ASSERT NOT `the duty to send a copy of the statements is met within s 168(6)` TRUE FALSE TRUE
#ASSERT `the duty to send a copy of the statements is met within s 168(6)` FALSE FALSE FALSE
-- (7), (8) arguments: otherwise qualified, the date the person made the request if they did, the date they received the statement if they did, the date they accept
#ASSERT `a person may accept the appointment within s 168(7) and (8)` TRUE (JUST (YearMonthDay 2027 3 1)) (JUST (YearMonthDay 2027 3 5)) (YearMonthDay 2027 3 10)
-- (8): no reply within fifteen days; the fifteenth day after 1 March is 16 March, so 17 March is the first day they may accept
#ASSERT `a person may accept the appointment within s 168(7) and (8)` TRUE (JUST (YearMonthDay 2027 3 1)) NOTHING (YearMonthDay 2027 3 17)
#ASSERT NOT `a person may accept the appointment within s 168(7) and (8)` TRUE (JUST (YearMonthDay 2027 3 1)) NOTHING (YearMonthDay 2027 3 16)
#ASSERT NOT `a person may accept the appointment within s 168(7) and (8)` TRUE (JUST (YearMonthDay 2027 3 1)) NOTHING (YearMonthDay 2027 3 10)
-- (8) is for a person otherwise qualified
#ASSERT NOT `a person may accept the appointment within s 168(7) and (8)` FALSE (JUST (YearMonthDay 2027 3 1)) NOTHING (YearMonthDay 2027 3 17)
-- never requested
#ASSERT NOT `a person may accept the appointment within s 168(7) and (8)` TRUE NOTHING NOTHING (YearMonthDay 2027 3 17)
#ASSERT NOT `a person may accept the appointment within s 168(7) and (8)` TRUE NOTHING (JUST (YearMonthDay 2027 3 5)) (YearMonthDay 2027 3 17)
-- a reply that comes after the fifteen days, when they accept on the sixteenth day after the request: (8) applies
#ASSERT `a person may accept the appointment within s 168(7) and (8)` TRUE (JUST (YearMonthDay 2027 3 1)) (JUST (YearMonthDay 2027 3 20)) (YearMonthDay 2027 3 17)
-- a reply that comes only after they accept, within the fifteen days: neither (7) nor (8)
#ASSERT NOT `a person may accept the appointment within s 168(7) and (8)` TRUE (JUST (YearMonthDay 2027 3 1)) (JUST (YearMonthDay 2027 3 10)) (YearMonthDay 2027 3 5)
-- (7) needs no qualification: a person who has the statement may accept
#ASSERT `a person may accept the appointment within s 168(7) and (8)` FALSE (JUST (YearMonthDay 2027 3 1)) (JUST (YearMonthDay 2027 3 5)) (YearMonthDay 2027 3 10)
-- fifteen days across a month end: the request on 20 February 2027 gives 7 March as the last day
#ASSERT `the last day for the auditor to reply within s 168(8)` (YearMonthDay 2027 2 20) EQUALS (YearMonthDay 2027 3 7)
#ASSERT `a person may accept the appointment within s 168(7) and (8)` TRUE (JUST (YearMonthDay 2027 2 20)) NOTHING (YearMonthDay 2027 3 8)
#ASSERT NOT `a person may accept the appointment within s 168(7) and (8)` TRUE (JUST (YearMonthDay 2027 2 20)) NOTHING (YearMonthDay 2027 3 7)
-- (9) arguments: the person may accept under (7) and (8)
#ASSERT `the appointment is void within s 168(9)` FALSE
#ASSERT NOT `the appointment is void within s 168(9)` TRUE

