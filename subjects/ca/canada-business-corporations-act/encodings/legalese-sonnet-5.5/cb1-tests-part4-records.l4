IMPORT prelude
IMPORT `cbca-core`
IMPORT `cb1-nouns`
IMPORT `cb1-part4-records`

-- Tests of cb1-part4-records.l4 (s 19 to s 23). Expected values are written from the text of the Act
-- (src:242-431), never from the code's output: each comment says what the text gives.

§ `Tests -- Part IV registered office and records`

§§ `s 19`

-- src:242
#ASSERT `the corporation has the registered office that s 19(1) requires` TRUE TRUE
#ASSERT NOT (`the corporation has the registered office that s 19(1) requires` TRUE FALSE)
#ASSERT NOT (`the corporation has the registered office that s 19(1) requires` FALSE TRUE)
-- src:244: the notice goes with articles that designate or change the province; otherwise nothing is owed
#ASSERT `the corporation has complied with the duty to send a notice of registered office within s 19(2)` TRUE TRUE
#ASSERT `the corporation has complied with the duty to send a notice of registered office within s 19(2)` FALSE FALSE
#ASSERT NOT (`the corporation has complied with the duty to send a notice of registered office within s 19(2)` TRUE FALSE)
-- src:246: within the province specified in the articles
#ASSERT `the directors may change the place and address of the registered office within s 19(3)` TRUE
#ASSERT NOT (`the directors may change the place and address of the registered office within s 19(3)` FALSE)
-- src:248: fifteen days of the change. A change on 1 March: the fifteenth day is 16 March (fork F1: the start day is day 0).
#ASSERT `the last day to send the notice of change of address within s 19(4)` (YMD 2026 3 1) EQUALS YMD 2026 3 16
#ASSERT `the notice of change of address was sent in time within s 19(4)` (YMD 2026 3 1) (YMD 2026 3 16)
#ASSERT `the notice of change of address was sent in time within s 19(4)` (YMD 2026 3 1) (YMD 2026 3 1)
#ASSERT NOT (`the notice of change of address was sent in time within s 19(4)` (YMD 2026 3 1) (YMD 2026 3 17))
-- a February change: 20 February 2026 plus fifteen days is 7 March
#ASSERT `the last day to send the notice of change of address within s 19(4)` (YMD 2026 2 20) EQUALS YMD 2026 3 7
#ASSERT `the Director must file the notice of change of address within s 19(4)` TRUE
#ASSERT NOT (`the Director must file the notice of change of address within s 19(4)` FALSE)

§§ `s 20`

DECIDE `all four corporate records` IS `Corporate records kept under s 20(1)` WITH
    `the articles and the by-laws, and all amendments thereto, and a copy of any unanimous shareholder agreement` IS TRUE
    `minutes of meetings and resolutions of shareholders` IS TRUE
    `copies of all notices required by section 106 or 113` IS TRUE
    `a securities register that complies with section 50` IS TRUE

GIVEN a IS A BOOLEAN
      b IS A BOOLEAN
      c IS A BOOLEAN
      d IS A BOOLEAN
GIVETH A `Corporate records kept under s 20(1)`
`corporate records` a b c d MEANS
    `Corporate records kept under s 20(1)` WITH
        `the articles and the by-laws, and all amendments thereto, and a copy of any unanimous shareholder agreement` IS a
        `minutes of meetings and resolutions of shareholders` IS b
        `copies of all notices required by section 106 or 113` IS c
        `a securities register that complies with section 50` IS d

-- src:251-254: all four kinds
#ASSERT `the corporation keeps all the records s 20(1) lists` (`corporate records` TRUE TRUE TRUE TRUE)
#ASSERT NOT (`the corporation keeps all the records s 20(1) lists` (`corporate records` FALSE TRUE TRUE TRUE))
#ASSERT NOT (`the corporation keeps all the records s 20(1) lists` (`corporate records` TRUE FALSE TRUE TRUE))
#ASSERT NOT (`the corporation keeps all the records s 20(1) lists` (`corporate records` TRUE TRUE FALSE TRUE))
#ASSERT NOT (`the corporation keeps all the records s 20(1) lists` (`corporate records` TRUE TRUE TRUE FALSE))

GIVEN a IS A BOOLEAN
      b IS A BOOLEAN
GIVETH A `Directors and accounting records kept under s 20(2)`
`directors records` a b MEANS
    `Directors and accounting records kept under s 20(2)` WITH
        `adequate accounting records` IS a
        `records containing minutes of meetings and resolutions of the directors and any committee of the directors` IS b

-- src:256
#ASSERT `the corporation keeps all the records s 20(2) lists` (`directors records` TRUE TRUE)
#ASSERT NOT (`the corporation keeps all the records s 20(2) lists` (`directors records` FALSE TRUE))
#ASSERT NOT (`the corporation keeps all the records s 20(2) lists` (`directors records` TRUE FALSE))

DECIDE `three years` IS `Time limit` WITH
    `number of units` IS 3
    `unit of time` IS `calendar years`

DECIDE `ten years` IS `Time limit` WITH
    `number of units` IS 10
    `unit of time` IS `calendar years`

-- src:258: six years after the end of the financial year (year end 31 December 2026), unless another Act provides longer
#ASSERT `the last day the corporation must retain the accounting records within s 20(2.1)` (YMD 2026 12 31) NOTHING EQUALS YMD 2032 12 31
#ASSERT `the last day the corporation must retain the accounting records within s 20(2.1)` (YMD 2026 12 31) (JUST `ten years`) EQUALS YMD 2036 12 31
-- "longer": a shorter period in another Act does not shorten the six years
#ASSERT `the last day the corporation must retain the accounting records within s 20(2.1)` (YMD 2026 12 31) (JUST `three years`) EQUALS YMD 2032 12 31

-- src:260: a continued body corporate's earlier similar records count
#ASSERT `the record counts as a record for paragraph 20(1)(b) and subsection 20(2) within s 20(3)` TRUE FALSE FALSE
#ASSERT `the record counts as a record for paragraph 20(1)(b) and subsection 20(2) within s 20(3)` FALSE TRUE TRUE
#ASSERT NOT (`the record counts as a record for paragraph 20(1)(b) and subsection 20(2) within s 20(3)` FALSE FALSE TRUE)
#ASSERT NOT (`the record counts as a record for paragraph 20(1)(b) and subsection 20(2) within s 20(3)` FALSE TRUE FALSE)

-- src:262: registered office or such other place as the directors think fit; open to the directors at all reasonable times
#ASSERT `the records of subsection 20(2) are kept as s 20(4) requires` TRUE FALSE TRUE
#ASSERT `the records of subsection 20(2) are kept as s 20(4) requires` FALSE TRUE TRUE
#ASSERT NOT (`the records of subsection 20(2) are kept as s 20(4) requires` FALSE FALSE TRUE)
#ASSERT NOT (`the records of subsection 20(2) are kept as s 20(4) requires` TRUE FALSE FALSE)

-- src:266-268: records outside Canada if available by computer terminal and the corporation gives technical help, subject to the tax Acts
#ASSERT `the corporation may keep the records at a place outside Canada within s 20(5.1)` FALSE TRUE TRUE
#ASSERT NOT (`the corporation may keep the records at a place outside Canada within s 20(5.1)` TRUE TRUE TRUE)
#ASSERT NOT (`the corporation may keep the records at a place outside Canada within s 20(5.1)` FALSE FALSE TRUE)
#ASSERT NOT (`the corporation may keep the records at a place outside Canada within s 20(5.1)` FALSE TRUE FALSE)

-- src:250: at the registered office or another place in Canada designated by the directors
#ASSERT `the corporate records are kept at a permitted place within s 20(1) and s 20(5.1)` `at the registered office of the corporation` FALSE
#ASSERT `the corporate records are kept at a permitted place within s 20(1) and s 20(5.1)` `at another place in Canada designated by the directors` FALSE
#ASSERT NOT (`the corporate records are kept at a permitted place within s 20(1) and s 20(5.1)` `at a place in Canada that the directors have not designated` TRUE)
#ASSERT NOT (`the corporate records are kept at a permitted place within s 20(1) and s 20(5.1)` `at a place outside Canada` FALSE)
#ASSERT `the corporate records are kept at a permitted place within s 20(1) and s 20(5.1)` `at a place outside Canada` TRUE

-- src:264: accounting records kept outside Canada; a quarterly set in Canada unless (5.1) applies
#ASSERT `the corporation has complied with the duty to keep quarterly accounting records in Canada within s 20(5)` FALSE FALSE FALSE
#ASSERT `the corporation has complied with the duty to keep quarterly accounting records in Canada within s 20(5)` TRUE FALSE TRUE
#ASSERT `the corporation has complied with the duty to keep quarterly accounting records in Canada within s 20(5)` TRUE TRUE FALSE
#ASSERT NOT (`the corporation has complied with the duty to keep quarterly accounting records in Canada within s 20(5)` TRUE FALSE FALSE)

-- src:270: an offence without reasonable cause, a fine not exceeding $5,000, no imprisonment
#ASSERT `the corporation is guilty of an offence within s 20(6)` TRUE FALSE
#ASSERT NOT (`the corporation is guilty of an offence within s 20(6)` TRUE TRUE)
#ASSERT NOT (`the corporation is guilty of an offence within s 20(6)` FALSE FALSE)
#ASSERT (`the most a court may impose on summary conviction within s 20(6)`)'s `maximum fine in dollars` EQUALS 5000
#ASSERT (`the most a court may impose on summary conviction within s 20(6)`)'s `maximum imprisonment in months` EQUALS NOTHING

§§ `s 21`

-- src:272: shareholders, creditors, their personal representatives and the Director, free of charge
#ASSERT `the access the person has to the corporate records within s 21(1) and s 21(1.1)` `a shareholder of the corporation` FALSE FALSE FALSE EQUALS `may examine the records during the usual business hours and take extracts, free of charge`
#ASSERT `the access the person has to the corporate records within s 21(1) and s 21(1.1)` `a creditor of the corporation` TRUE FALSE FALSE EQUALS `may examine the records during the usual business hours and take extracts, free of charge`
#ASSERT `the access the person has to the corporate records within s 21(1) and s 21(1.1)` `a personal representative of a shareholder or creditor of the corporation` FALSE FALSE FALSE EQUALS `may examine the records during the usual business hours and take extracts, free of charge`
#ASSERT `the access the person has to the corporate records within s 21(1) and s 21(1.1)` `the Director` TRUE FALSE FALSE EQUALS `may examine the records during the usual business hours and take extracts, free of charge`
-- any other person, only if the corporation is a distributing corporation, on payment of a reasonable fee
#ASSERT `the access the person has to the corporate records within s 21(1) and s 21(1.1)` `any other person` TRUE FALSE FALSE EQUALS `may examine the records during the usual business hours and take extracts, on payment of a reasonable fee`
#ASSERT `the access the person has to the corporate records within s 21(1) and s 21(1.1)` `any other person` FALSE FALSE FALSE EQUALS `has no right of access under s 21(1)`
-- src:274: the securities register of a distributing corporation: request with affidavit first
#ASSERT `the access the person has to the corporate records within s 21(1) and s 21(1.1)` `a shareholder of the corporation` TRUE TRUE FALSE EQUALS `must first make a request to the corporation or its agent or mandatary, accompanied by an affidavit referred to in subsection 21(7)`
#ASSERT `the access the person has to the corporate records within s 21(1) and s 21(1.1)` `a shareholder of the corporation` TRUE TRUE TRUE EQUALS `may examine the securities register during the usual business hours once the affidavit is received, and have an extract on payment of a reasonable fee`
#ASSERT `the access the person has to the corporate records within s 21(1) and s 21(1.1)` `any other person` TRUE TRUE FALSE EQUALS `must first make a request to the corporation or its agent or mandatary, accompanied by an affidavit referred to in subsection 21(7)`
-- (1.1) is about a distributing corporation only: a shareholder of another corporation needs no affidavit
#ASSERT `the access the person has to the corporate records within s 21(1) and s 21(1.1)` `a shareholder of the corporation` FALSE TRUE FALSE EQUALS `may examine the records during the usual business hours and take extracts, free of charge`

