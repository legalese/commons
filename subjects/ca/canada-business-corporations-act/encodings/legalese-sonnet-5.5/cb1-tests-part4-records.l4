#ASSERT `the person may require the corporation to provide a basic list within s 21(3)` `any other person` TRUE TRUE TRUE
#ASSERT NOT (`the person may require the corporation to provide a basic list within s 21(3)` `any other person` FALSE TRUE TRUE)
#ASSERT NOT (`the person may require the corporation to provide a basic list within s 21(3)` `a shareholder of the corporation` FALSE FALSE TRUE)
#ASSERT NOT (`the person may require the corporation to provide a basic list within s 21(3)` `a shareholder of the corporation` FALSE TRUE FALSE)

-- the affidavit is received on 20 June 2026: ten days is 30 June; the list is made up to a date no earlier than 10 June
#ASSERT `the last day to provide the basic list within s 21(3)` (YMD 2026 6 20) EQUALS YMD 2026 6 30
#ASSERT `the earliest date the basic list may be made up to within s 21(3)` (YMD 2026 6 20) EQUALS YMD 2026 6 10
#ASSERT `the corporation has provided the basic list as s 21(3) requires` (YMD 2026 6 20) (YMD 2026 6 30) (YMD 2026 6 10)
#ASSERT `the corporation has provided the basic list as s 21(3) requires` (YMD 2026 6 20) (YMD 2026 6 21) (YMD 2026 6 20)
#ASSERT NOT (`the corporation has provided the basic list as s 21(3) requires` (YMD 2026 6 20) (YMD 2026 7 1) (YMD 2026 6 15))
#ASSERT NOT (`the corporation has provided the basic list as s 21(3) requires` (YMD 2026 6 20) (YMD 2026 6 25) (YMD 2026 6 9))
#ASSERT NOT (`the corporation has provided the basic list as s 21(3) requires` (YMD 2026 6 20) (YMD 2026 6 25) (YMD 2026 6 21))

-- src:280: supplemental lists, on the statement in the affidavit and payment of a fee
#ASSERT `the person may require supplemental lists within s 21(4)` TRUE TRUE TRUE
#ASSERT NOT (`the person may require supplemental lists within s 21(4)` FALSE TRUE TRUE)
#ASSERT NOT (`the person may require supplemental lists within s 21(4)` TRUE FALSE TRUE)
#ASSERT NOT (`the person may require supplemental lists within s 21(4)` TRUE TRUE FALSE)

-- src:282-284: changes before the date the basic list is furnished: due that day; on or after: the next business day
-- (the basic list is furnished Wednesday 1 July 2026; the business day after Thursday 2 July is Friday 3 July)
#ASSERT `the day the supplemental list is due within s 21(5)` (YMD 2026 7 1) (YMD 2026 6 29) (YMD 2026 6 30) EQUALS YMD 2026 7 1
#ASSERT `the day the supplemental list is due within s 21(5)` (YMD 2026 7 1) (YMD 2026 7 1) (YMD 2026 7 2) EQUALS YMD 2026 7 2
#ASSERT `the day the supplemental list is due within s 21(5)` (YMD 2026 7 1) (YMD 2026 7 2) (YMD 2026 7 3) EQUALS YMD 2026 7 3

-- src:286
#ASSERT `the person may also require the list to include the known holders of options within s 21(6)` TRUE
#ASSERT NOT (`the person may also require the list to include the known holders of options within s 21(6)` FALSE)

GIVEN a IS A BOOLEAN
      b IS A BOOLEAN
      c IS A BOOLEAN
      d IS A BOOLEAN
      e IS A BOOLEAN
GIVETH AN `Affidavit under s 21(7)`
`an affidavit` a b c d e MEANS
    `Affidavit under s 21(7)` WITH
        `states the name and address of the applicant` IS a
        `the applicant is a body corporate` IS b
        `states the name and address for service of the body corporate` IS c
        `states that the lists or the securities register information will not be used except as permitted under subsection 21(9)` IS d
        `is made by a director or officer of the body corporate` IS e

-- src:289-293: name and address; for a body corporate, an address for service and a director or officer as deponent; the undertaking
