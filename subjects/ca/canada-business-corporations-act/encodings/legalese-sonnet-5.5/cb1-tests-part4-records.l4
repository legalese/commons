#ASSERT `the affidavit has the contents s 21(7) and s 21(8) require` (`an affidavit` TRUE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`the affidavit has the contents s 21(7) and s 21(8) require` (`an affidavit` FALSE FALSE FALSE TRUE FALSE))
#ASSERT NOT (`the affidavit has the contents s 21(7) and s 21(8) require` (`an affidavit` TRUE FALSE FALSE FALSE FALSE))
#ASSERT NOT (`the affidavit has the contents s 21(7) and s 21(8) require` (`an affidavit` TRUE TRUE FALSE TRUE TRUE))
#ASSERT NOT (`the affidavit has the contents s 21(7) and s 21(8) require` (`an affidavit` TRUE TRUE TRUE TRUE FALSE))

