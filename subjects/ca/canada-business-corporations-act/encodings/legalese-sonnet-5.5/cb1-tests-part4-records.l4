#ASSERT NOT (`the shareholder is entitled to one copy of the articles, by-laws and any unanimous shareholder agreement, without charge, within s 21(2)` FALSE TRUE)
#ASSERT NOT (`the shareholder is entitled to one copy of the articles, by-laws and any unanimous shareholder agreement, without charge, within s 21(2)` TRUE FALSE)

