IMPORT prelude
IMPORT `cbca-core`
IMPORT `cb3-part12-proposals`

-- Tests of cb3-part12-proposals.l4 (CBCA s 137). Every expected value is written from the text of the
-- section, quoted in the module; none is copied from the module's own output.

§ `Tests of Part XII, proposals`


§§ `s 137(1)(a), (b) -- the right to submit and to discuss`

#ASSERT `a person may submit a proposal within s 137(1)(a)` TRUE TRUE
#ASSERT NOT `a person may submit a proposal within s 137(1)(a)` TRUE FALSE
#ASSERT NOT `a person may submit a proposal within s 137(1)(a)` FALSE TRUE
#ASSERT NOT `a person may submit a proposal within s 137(1)(a)` FALSE FALSE
#ASSERT `a person may discuss a matter at the meeting within s 137(1)(b)` TRUE TRUE
#ASSERT NOT `a person may discuss a matter at the meeting within s 137(1)(b)` TRUE FALSE
#ASSERT NOT `a person may discuss a matter at the meeting within s 137(1)(b)` FALSE TRUE

§§ `s 137(1.1) -- eligibility`

-- arguments: shares the person has held or owned for at least the prescribed period, the aggregate of the person and the supporters,
-- the person has the support of those persons, the prescribed number
#ASSERT `the person is eligible to submit a proposal within s 137(1.1)` 100 0 FALSE 100
#ASSERT NOT `the person is eligible to submit a proposal within s 137(1.1)` 99 0 FALSE 100
#ASSERT `the person is eligible to submit a proposal within s 137(1.1)` 99 100 TRUE 100
#ASSERT NOT `the person is eligible to submit a proposal within s 137(1.1)` 99 100 FALSE 100
#ASSERT NOT `the person is eligible to submit a proposal within s 137(1.1)` 99 99 TRUE 100
-- the proposer need not hold any: "including or not including the person that submits the proposal"
#ASSERT `the person is eligible to submit a proposal within s 137(1.1)` 0 100 TRUE 100
#ASSERT `the person is eligible to submit a proposal within s 137(1.1)` 250 0 FALSE 100

§§ `s 137(1.2) -- accompanying information`

-- arguments: relies on supporters, name and address of the person, name and address of the supporters, shares of the person and date, shares of the supporters and date
#ASSERT `the proposal is accompanied by the information s 137(1.2) requires within s 137(1.2)` FALSE TRUE FALSE TRUE FALSE
#ASSERT `the proposal is accompanied by the information s 137(1.2) requires within s 137(1.2)` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT `the proposal is accompanied by the information s 137(1.2) requires within s 137(1.2)` FALSE FALSE FALSE TRUE FALSE
#ASSERT NOT `the proposal is accompanied by the information s 137(1.2) requires within s 137(1.2)` FALSE TRUE FALSE FALSE FALSE
#ASSERT NOT `the proposal is accompanied by the information s 137(1.2) requires within s 137(1.2)` TRUE TRUE FALSE TRUE TRUE
#ASSERT NOT `the proposal is accompanied by the information s 137(1.2) requires within s 137(1.2)` TRUE TRUE TRUE TRUE FALSE
#ASSERT NOT `the proposal is accompanied by the information s 137(1.2) requires within s 137(1.2)` TRUE TRUE TRUE FALSE TRUE
#ASSERT NOT `the proposal is accompanied by the information s 137(1.2) requires within s 137(1.2)` TRUE FALSE TRUE TRUE TRUE
-- supporters' details are asked for only "if applicable"
#ASSERT `the proposal is accompanied by the information s 137(1.2) requires within s 137(1.2)` FALSE TRUE TRUE TRUE TRUE

§§ `s 137(1.3) -- the words that count`

#ASSERT `the words that count toward the prescribed maximum within s 137(1.3)` 100 50 999 EQUALS 150
#ASSERT `the words that count toward the prescribed maximum within s 137(1.3)` 100 50 0 EQUALS 150
#ASSERT `the words that count toward the prescribed maximum within s 137(1.3)` 0 0 5 EQUALS 0

§§ `s 137(1.4) -- proof of eligibility`

#ASSERT `the person must provide proof of eligibility within s 137(1.4)` TRUE
#ASSERT NOT `the person must provide proof of eligibility within s 137(1.4)` FALSE
-- arguments: the corporation requests proof within the prescribed period, the person provides it within the prescribed period, it shows (1.1) is met
#ASSERT `the duty to provide proof of eligibility is met within s 137(1.4)` FALSE FALSE FALSE
#ASSERT `the duty to provide proof of eligibility is met within s 137(1.4)` TRUE TRUE TRUE
#ASSERT NOT `the duty to provide proof of eligibility is met within s 137(1.4)` TRUE FALSE TRUE
#ASSERT NOT `the duty to provide proof of eligibility is met within s 137(1.4)` TRUE TRUE FALSE
#ASSERT NOT `the duty to provide proof of eligibility is met within s 137(1.4)` TRUE FALSE FALSE

§§ `s 137(5) -- exemptions`

-- arguments, in order: (a) not submitted in time, (b) personal claim or grievance, (b.1) no significant relation to the business,
-- (c) failed to present an earlier proposal, (d) substantially the same proposal lacked support, (e) abuse to secure publicity
#ASSERT NOT `the corporation is not required to comply with s 137(2) and (3) within s 137(5)` FALSE FALSE FALSE FALSE FALSE FALSE
#ASSERT `the corporation is not required to comply with s 137(2) and (3) within s 137(5)` TRUE FALSE FALSE FALSE FALSE FALSE
#ASSERT `the corporation is not required to comply with s 137(2) and (3) within s 137(5)` FALSE TRUE FALSE FALSE FALSE FALSE
#ASSERT `the corporation is not required to comply with s 137(2) and (3) within s 137(5)` FALSE FALSE TRUE FALSE FALSE FALSE
#ASSERT `the corporation is not required to comply with s 137(2) and (3) within s 137(5)` FALSE FALSE FALSE TRUE FALSE FALSE
#ASSERT `the corporation is not required to comply with s 137(2) and (3) within s 137(5)` FALSE FALSE FALSE FALSE TRUE FALSE
#ASSERT `the corporation is not required to comply with s 137(2) and (3) within s 137(5)` FALSE FALSE FALSE FALSE FALSE TRUE
#ASSERT `the corporation is not required to comply with s 137(2) and (3) within s 137(5)` TRUE TRUE TRUE TRUE TRUE TRUE

§§ `s 137(5.1) -- failure to continue to hold`

#ASSERT `the corporation is not required to set out the person's later proposal within s 137(5.1)` TRUE TRUE
#ASSERT NOT `the corporation is not required to set out the person's later proposal within s 137(5.1)` TRUE FALSE
#ASSERT NOT `the corporation is not required to set out the person's later proposal within s 137(5.1)` FALSE TRUE
#ASSERT NOT `the corporation is not required to set out the person's later proposal within s 137(5.1)` FALSE FALSE

§§ `s 137(2) -- circulating the proposal`

-- arguments: the corporation solicits proxies, a proposal was submitted by a person who may submit it, (5) exempts, (5.1) exempts
#ASSERT `the corporation must circulate the proposal within s 137(2)` TRUE TRUE FALSE FALSE
#ASSERT NOT `the corporation must circulate the proposal within s 137(2)` FALSE TRUE FALSE FALSE
#ASSERT NOT `the corporation must circulate the proposal within s 137(2)` TRUE FALSE FALSE FALSE
#ASSERT NOT `the corporation must circulate the proposal within s 137(2)` TRUE TRUE TRUE FALSE
#ASSERT NOT `the corporation must circulate the proposal within s 137(2)` TRUE TRUE FALSE TRUE
#ASSERT NOT `the corporation must circulate the proposal within s 137(2)` TRUE TRUE TRUE TRUE
-- arguments: the duty arises, set out in the circular, attached to it
#ASSERT `the duty to circulate the proposal is met within s 137(2)` TRUE TRUE FALSE
#ASSERT `the duty to circulate the proposal is met within s 137(2)` TRUE FALSE TRUE
#ASSERT `the duty to circulate the proposal is met within s 137(2)` TRUE TRUE TRUE
#ASSERT NOT `the duty to circulate the proposal is met within s 137(2)` TRUE FALSE FALSE
-- no duty, nothing to meet
#ASSERT `the duty to circulate the proposal is met within s 137(2)` FALSE FALSE FALSE

§§ `s 137(3) -- the supporting statement`

-- arguments: the person requests a supporting statement, the (2) duty arises
#ASSERT `the corporation must include the supporting statement within s 137(3)` TRUE TRUE
#ASSERT NOT `the corporation must include the supporting statement within s 137(3)` TRUE FALSE
#ASSERT NOT `the corporation must include the supporting statement within s 137(3)` FALSE TRUE
#ASSERT NOT `the corporation must include the supporting statement within s 137(3)` FALSE FALSE
-- arguments: the duty arises, the statement is included, attached, the name and address are included or attached
#ASSERT `the duty to include the supporting statement is met within s 137(3)` TRUE TRUE FALSE TRUE
#ASSERT `the duty to include the supporting statement is met within s 137(3)` TRUE FALSE TRUE TRUE
#ASSERT NOT `the duty to include the supporting statement is met within s 137(3)` TRUE TRUE FALSE FALSE
#ASSERT NOT `the duty to include the supporting statement is met within s 137(3)` TRUE FALSE FALSE TRUE
#ASSERT NOT `the duty to include the supporting statement is met within s 137(3)` TRUE FALSE FALSE FALSE
#ASSERT `the duty to include the supporting statement is met within s 137(3)` FALSE FALSE FALSE FALSE
-- arguments: the words that count, the prescribed maximum
#ASSERT `the proposal and the statement are within the word limit within s 137(3)` 100 100
#ASSERT `the proposal and the statement are within the word limit within s 137(3)` 99 100
#ASSERT `the proposal and the statement are within the word limit within s 137(3)` 0 0
#ASSERT NOT `the proposal and the statement are within the word limit within s 137(3)` 101 100
-- with the (1.3) word count: 60 words of proposal and 40 of statement are 100 words however long the (1.2) information is
#ASSERT `the proposal and the statement are within the word limit within s 137(3)` (`the words that count toward the prescribed maximum within s 137(1.3)` 60 40 9999) 100
#ASSERT NOT `the proposal and the statement are within the word limit within s 137(3)` (`the words that count toward the prescribed maximum within s 137(1.3)` 61 40 0) 100

§§ `s 137(4) -- nominations for election of directors`

-- arguments: signed by one or more holders, the fraction of the shares entitled to vote that the signers hold, the fraction of each class
#ASSERT `a proposal may include nominations of directors within s 137(4)` TRUE 0.05 EMPTY
#ASSERT NOT `a proposal may include nominations of directors within s 137(4)` TRUE 0.0499 EMPTY
#ASSERT `a proposal may include nominations of directors within s 137(4)` TRUE 0.06 (LIST 0.01)
-- five per cent of the shares of a class is enough
#ASSERT `a proposal may include nominations of directors within s 137(4)` TRUE 0.01 (LIST 0.02, 0.05)
#ASSERT NOT `a proposal may include nominations of directors within s 137(4)` TRUE 0.01 (LIST 0.02, 0.0499)
#ASSERT NOT `a proposal may include nominations of directors within s 137(4)` FALSE 0.5 (LIST 0.5)
#ASSERT NOT `a proposal may include nominations of directors within s 137(4)` TRUE 0.01 EMPTY

§§ `s 137(6) -- immunity`

-- arguments: the corporation or a person on its behalf circulates a proposal or statement, in compliance with s 137, the liability is claimed by reason only of the circulating
#ASSERT `no liability is incurred by reason only of circulating within s 137(6)` TRUE TRUE TRUE
#ASSERT NOT `no liability is incurred by reason only of circulating within s 137(6)` TRUE FALSE TRUE
#ASSERT NOT `no liability is incurred by reason only of circulating within s 137(6)` TRUE TRUE FALSE
#ASSERT NOT `no liability is incurred by reason only of circulating within s 137(6)` FALSE TRUE TRUE

§§ `s 137(7) -- notice of refusal`

#ASSERT `the corporation must notify the person of the refusal within s 137(7)` TRUE
#ASSERT NOT `the corporation must notify the person of the refusal within s 137(7)` FALSE
-- arguments: the duty arises, in writing, states the intention to omit, states the reasons, within the prescribed period
#ASSERT `the duty to notify the person of the refusal is met within s 137(7)` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT `the duty to notify the person of the refusal is met within s 137(7)` TRUE FALSE TRUE TRUE TRUE
#ASSERT NOT `the duty to notify the person of the refusal is met within s 137(7)` TRUE TRUE FALSE TRUE TRUE
#ASSERT NOT `the duty to notify the person of the refusal is met within s 137(7)` TRUE TRUE TRUE FALSE TRUE
#ASSERT NOT `the duty to notify the person of the refusal is met within s 137(7)` TRUE TRUE TRUE TRUE FALSE
#ASSERT `the duty to notify the person of the refusal is met within s 137(7)` FALSE FALSE FALSE FALSE FALSE

§§ `s 137(8), (9), (10) -- the court, and the Director`

-- (8) arguments: the applicant submitted the proposal, claims to be aggrieved by the refusal
#ASSERT `a person may apply to the court within s 137(8)` TRUE TRUE
#ASSERT NOT `a person may apply to the court within s 137(8)` TRUE FALSE
#ASSERT NOT `a person may apply to the court within s 137(8)` FALSE TRUE
-- (9) arguments: the applicant is the corporation, the applicant is a person claiming to be aggrieved by a proposal
#ASSERT `the corporation or an aggrieved person may apply to the court within s 137(9)` TRUE FALSE
#ASSERT `the corporation or an aggrieved person may apply to the court within s 137(9)` FALSE TRUE
#ASSERT `the corporation or an aggrieved person may apply to the court within s 137(9)` TRUE TRUE
#ASSERT NOT `the corporation or an aggrieved person may apply to the court within s 137(9)` FALSE FALSE
-- arguments: an application is made, the court is satisfied that (5) applies
#ASSERT `the court may make an order on the application within s 137(9)` TRUE TRUE
#ASSERT NOT `the court may make an order on the application within s 137(9)` TRUE FALSE
#ASSERT NOT `the court may make an order on the application within s 137(9)` FALSE TRUE
-- (10) arguments: the applicant applies under (8), under (9)
#ASSERT `the applicant must give the Director notice within s 137(10)` TRUE FALSE
#ASSERT `the applicant must give the Director notice within s 137(10)` FALSE TRUE
#ASSERT NOT `the applicant must give the Director notice within s 137(10)` FALSE FALSE
-- arguments: the duty arises, the applicant gave the Director notice
#ASSERT `the duty to give the Director notice is met within s 137(10)` TRUE TRUE
#ASSERT NOT `the duty to give the Director notice is met within s 137(10)` TRUE FALSE
#ASSERT `the duty to give the Director notice is met within s 137(10)` FALSE FALSE
#ASSERT `the Director is entitled to appear and be heard within s 137(10)` TRUE
#ASSERT NOT `the Director is entitled to appear and be heard within s 137(10)` FALSE
