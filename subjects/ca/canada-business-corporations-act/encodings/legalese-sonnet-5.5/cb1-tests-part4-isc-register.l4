-- src:321: a shareholder asked for information replies accurately, completely and as soon as feasible
#ASSERT `the shareholder has complied with the duty to reply within s 21.1(4)` FALSE FALSE FALSE
#ASSERT `the shareholder has complied with the duty to reply within s 21.1(4)` TRUE TRUE TRUE
#ASSERT NOT (`the shareholder has complied with the duty to reply within s 21.1(4)` TRUE FALSE TRUE)
#ASSERT NOT (`the shareholder has complied with the duty to reply within s 21.1(4)` TRUE TRUE FALSE)

-- src:323: within one year after the sixth anniversary. Ceased on 15 March 2020: anniversary 15 March 2026; last day 15 March 2027.
#ASSERT `the last day to dispose of the personal information within s 21.1(5)` (JUST (YMD 2020 3 15)) FALSE EQUALS JUST (YMD 2027 3 15)
-- another Act provides a longer retention period: this subsection names no date
#ASSERT `the last day to dispose of the personal information within s 21.1(5)` (JUST (YMD 2020 3 15)) TRUE EQUALS NOTHING
-- the individual has not ceased to be an individual with significant control
#ASSERT `the last day to dispose of the personal information within s 21.1(5)` NOTHING FALSE EQUALS NOTHING

-- src:325: an offence without reasonable cause; a fine not exceeding $100,000
