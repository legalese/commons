#ASSERT NOT (`the corporation is guilty of an offence within s 21.1(6)` TRUE TRUE)
#ASSERT NOT (`the corporation is guilty of an offence within s 21.1(6)` FALSE FALSE)
#ASSERT (`the most a court may impose on summary conviction within s 21.1(6)`)'s `maximum fine in dollars` EQUALS 100000
#ASSERT (`the most a court may impose on summary conviction within s 21.1(6)`)'s `maximum imprisonment in months` EQUALS NOTHING

