IMPORT prelude
IMPORT `cbca-core`
IMPORT `cbca-core-isc`

-- Tests for cbca-core-isc.l4 (s 2.1). Expected values are written from the words of s 2.1: "25% or more",
-- "any combination", "two or more individuals are each considered", and the two alternatives (a) and (b)
-- of "a significant number of shares".

§ `Tests -- individual with significant control`

-- The corporation: 1,000 votes on its outstanding voting shares; its outstanding shares are worth
-- 1,000,000 dollars. A block is written votes, then fair market value in dollars.
`the corporation's whole` MEANS `Block of shares` WITH
    `votes carried` IS 1000
    `fair market value in dollars` IS 1000000

`exactly 25 per cent of the votes, worth little` MEANS `Block of shares` WITH
    `votes carried` IS 250
    `fair market value in dollars` IS 1000
`just under 25 per cent of the votes, worth little` MEANS `Block of shares` WITH
    `votes carried` IS 249
    `fair market value in dollars` IS 1000
`few votes but exactly 25 per cent of the value` MEANS `Block of shares` WITH
    `votes carried` IS 10
    `fair market value in dollars` IS 250000
`few votes and just under 25 per cent of the value` MEANS `Block of shares` WITH
    `votes carried` IS 10
    `fair market value in dollars` IS 249999
`all the shares` MEANS `Block of shares` WITH
    `votes carried` IS 1000
    `fair market value in dollars` IS 1000000
`no shares` MEANS `Block of shares` WITH
    `votes carried` IS 0
    `fair market value in dollars` IS 0

§§ `s 2.1(3) significant number of shares`

-- (a) "25% or more" of the voting rights: exactly 25% counts, one vote fewer does not.
#ASSERT `significant number of shares within s 2.1(3)(a)` `exactly 25 per cent of the votes, worth little` `the corporation's whole`
#ASSERT (NOT `significant number of shares within s 2.1(3)(a)` `just under 25 per cent of the votes, worth little` `the corporation's whole`)
-- (b) "equal to 25% or more of all of the corporation's outstanding shares measured by fair market value"
#ASSERT `significant number of shares within s 2.1(3)(b)` `few votes but exactly 25 per cent of the value` `the corporation's whole`
#ASSERT (NOT `significant number of shares within s 2.1(3)(b)` `few votes and just under 25 per cent of the value` `the corporation's whole`)
-- either measure is enough
#ASSERT `significant number of shares within s 2.1(3)` `exactly 25 per cent of the votes, worth little` `the corporation's whole`
#ASSERT `significant number of shares within s 2.1(3)` `few votes but exactly 25 per cent of the value` `the corporation's whole`
#ASSERT (NOT `significant number of shares within s 2.1(3)` `few votes and just under 25 per cent of the value` `the corporation's whole`)
#ASSERT (NOT `significant number of shares within s 2.1(3)` `just under 25 per cent of the votes, worth little` `the corporation's whole`)
#ASSERT `significant number of shares within s 2.1(3)` `all the shares` `the corporation's whole`
-- a corporation with no voting shares outstanding, or no value: nothing is "25% or more" of nothing
#ASSERT (NOT `significant number of shares within s 2.1(3)(a)` `no shares` `no shares`)
#ASSERT (NOT `significant number of shares within s 2.1(3)(b)` `no shares` `no shares`)

§§ `s 2.1(1)(a) shares`

-- arguments: registered holder, beneficial owner, direct or indirect control or direction, the individual's shares, the whole
#ASSERT `individual with significant control within s 2.1(1)(a)` TRUE FALSE FALSE `exactly 25 per cent of the votes, worth little` `the corporation's whole`
#ASSERT `individual with significant control within s 2.1(1)(a)` FALSE TRUE FALSE `exactly 25 per cent of the votes, worth little` `the corporation's whole`
#ASSERT `individual with significant control within s 2.1(1)(a)` FALSE FALSE TRUE `exactly 25 per cent of the votes, worth little` `the corporation's whole`
-- any combination of the interests, over the combined block, counted once
#ASSERT `individual with significant control within s 2.1(1)(a)` TRUE TRUE TRUE `few votes but exactly 25 per cent of the value` `the corporation's whole`
-- a significant number but no interest or right in them
#ASSERT (NOT `individual with significant control within s 2.1(1)(a)` FALSE FALSE FALSE `all the shares` `the corporation's whole`)
-- an interest but not in a significant number of shares
#ASSERT (NOT `individual with significant control within s 2.1(1)(a)` TRUE TRUE TRUE `just under 25 per cent of the votes, worth little` `the corporation's whole`)

§§ `s 2.1(1)(b) and (c): control in fact, prescribed circumstances`

#ASSERT `individual with significant control within s 2.1(1)(b)` TRUE
#ASSERT (NOT `individual with significant control within s 2.1(1)(b)` FALSE)
#ASSERT `individual with significant control within s 2.1(1)(c)` TRUE
#ASSERT (NOT `individual with significant control within s 2.1(1)(c)` FALSE)

§§ `s 2.1(2) joint ownership or control`

-- arguments: number of individuals, held jointly, the shares held jointly, subject to an agreement or arrangement to exercise
-- jointly or in concert, the shares subject to it, the whole
#ASSERT `each individual with significant control within s 2.1(2)` 2 TRUE `exactly 25 per cent of the votes, worth little` FALSE `no shares` `the corporation's whole`
#ASSERT `each individual with significant control within s 2.1(2)` 3 FALSE `no shares` TRUE `few votes but exactly 25 per cent of the value` `the corporation's whole`
-- each alternative needs its own significant number of shares
#ASSERT (NOT `each individual with significant control within s 2.1(2)` 2 TRUE `just under 25 per cent of the votes, worth little` FALSE `no shares` `the corporation's whole`)
-- a joint holding of a significant number, but the agreement concerns too few shares: (a) is met
#ASSERT `each individual with significant control within s 2.1(2)` 2 TRUE `all the shares` TRUE `no shares` `the corporation's whole`
-- neither alternative
#ASSERT (NOT `each individual with significant control within s 2.1(2)` 2 FALSE `all the shares` FALSE `all the shares` `the corporation's whole`)
-- "two or more individuals": one individual is not enough
#ASSERT (NOT `each individual with significant control within s 2.1(2)` 1 TRUE `all the shares` TRUE `all the shares` `the corporation's whole`)
