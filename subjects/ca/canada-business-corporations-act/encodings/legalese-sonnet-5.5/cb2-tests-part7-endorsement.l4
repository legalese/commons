#ASSERT NOT (`an endorsement of a security in registered form is made within s 65(3)` FALSE TRUE FALSE)
#ASSERT NOT (`an endorsement of a security in registered form is made within s 65(3)` FALSE FALSE TRUE)

§§ `s 65(4) to (7): special or blank; conversion`
-- args: specifies the person to whom the security is to be transferred or who has power to transfer it; is to bearer
#ASSERT `the kind of an endorsement within s 65(4)` TRUE FALSE EQUALS (JUST `a special endorsement`)
#ASSERT `the kind of an endorsement within s 65(4)` FALSE TRUE EQUALS (JUST `an endorsement in blank`)
#ASSERT `the kind of an endorsement within s 65(4)` TRUE TRUE EQUALS (JUST `a special endorsement`)
#ASSERT `the kind of an endorsement within s 65(4)` FALSE FALSE EQUALS NOTHING
-- args: the person is a holder, the kind of the endorsement
#ASSERT `a holder may convert the endorsement into a special endorsement within s 65(7)` TRUE `an endorsement in blank`
#ASSERT NOT (`a holder may convert the endorsement into a special endorsement within s 65(7)` TRUE `a special endorsement`)
#ASSERT NOT (`a holder may convert the endorsement into a special endorsement within s 65(7)` FALSE `an endorsement in blank`)

