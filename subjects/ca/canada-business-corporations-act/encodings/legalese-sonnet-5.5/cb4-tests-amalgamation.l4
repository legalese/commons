IMPORT prelude
IMPORT `cbca-core`
IMPORT `cbca-core-definitions`
IMPORT `cb4-common`
IMPORT `cb4-amendment`
IMPORT `cb4-amalgamation`

-- Tests of cb4-amalgamation.l4 (Part XV, ss 181 to 186.1). Every expected value is written from the text
-- of the section named beside it, before the run; none is copied from the encoding's output.

§ `Tests -- ss 181 to 186.1`

§§ `s 181`

#ASSERT `the corporations may amalgamate and continue as one corporation within s 181` 2
#ASSERT `the corporations may amalgamate and continue as one corporation within s 181` 3
#ASSERT NOT (`the corporations may amalgamate and continue as one corporation within s 181` 1)

§§ `s 182`

-- The agreement builder: every field named in the Act's order (a) to (g); see the record's declaration.
GIVEN entered IS A BOOLEAN
      `paragraph (a)` IS A BOOLEAN
      `paragraph (b)` IS A BOOLEAN
      `paragraph (c)` IS A BOOLEAN
      `some shares are not converted` IS A BOOLEAN
      `paragraph (d)` IS A BOOLEAN
      `paragraph (e)` IS A BOOLEAN
      `paragraph (f), whether` IS A BOOLEAN
      `by-laws are not those of a corporation` IS A BOOLEAN
      `paragraph (f), copy` IS A BOOLEAN
      `paragraph (g)` IS A BOOLEAN
GIVETH A `Amalgamation agreement (s 182)`
`an agreement with` MEANS `Amalgamation agreement (s 182)` WITH
    `every corporation proposing to amalgamate has entered into the agreement` IS entered
    `sets out the provisions required to be in articles of incorporation under section 6` IS `paragraph (a)`
    `sets out the name and address of each proposed director of the amalgamated corporation` IS `paragraph (b)`
    `sets out how the shares of each amalgamating corporation are to be converted into shares or other securities of the amalgamated corporation` IS `paragraph (c)`
    `some shares of an amalgamating corporation are not to be converted into securities of the amalgamated corporation` IS `some shares are not converted`
    `sets out the money or securities those holders are to receive in addition to or instead of securities of the amalgamated corporation` IS `paragraph (d)`
    `sets out how money is to be paid instead of fractional shares` IS `paragraph (e)`
    `states whether the by-laws are to be those of one of the amalgamating corporations` IS `paragraph (f), whether`
    `the by-laws are not to be those of one of the amalgamating corporations` IS `by-laws are not those of a corporation`
    `includes a copy of the proposed by-laws` IS `paragraph (f), copy`
    `sets out details of arrangements necessary to perfect the amalgamation and provide for the subsequent management and operation` IS `paragraph (g)`

-- Everything stated, shares converted and by-laws those of an amalgamating corporation.
#ASSERT `the amalgamation agreement contains what s 182(1) requires` (`an agreement with` TRUE TRUE TRUE TRUE FALSE FALSE TRUE TRUE FALSE FALSE TRUE)
-- Each unconditional item missing: not compliant.
#ASSERT NOT (`the amalgamation agreement contains what s 182(1) requires` (`an agreement with` FALSE TRUE TRUE TRUE FALSE FALSE TRUE TRUE FALSE FALSE TRUE))
#ASSERT NOT (`the amalgamation agreement contains what s 182(1) requires` (`an agreement with` TRUE FALSE TRUE TRUE FALSE FALSE TRUE TRUE FALSE FALSE TRUE))
#ASSERT NOT (`the amalgamation agreement contains what s 182(1) requires` (`an agreement with` TRUE TRUE FALSE TRUE FALSE FALSE TRUE TRUE FALSE FALSE TRUE))
#ASSERT NOT (`the amalgamation agreement contains what s 182(1) requires` (`an agreement with` TRUE TRUE TRUE FALSE FALSE FALSE TRUE TRUE FALSE FALSE TRUE))
#ASSERT NOT (`the amalgamation agreement contains what s 182(1) requires` (`an agreement with` TRUE TRUE TRUE TRUE FALSE FALSE FALSE TRUE FALSE FALSE TRUE))
#ASSERT NOT (`the amalgamation agreement contains what s 182(1) requires` (`an agreement with` TRUE TRUE TRUE TRUE FALSE FALSE TRUE FALSE FALSE FALSE TRUE))
#ASSERT NOT (`the amalgamation agreement contains what s 182(1) requires` (`an agreement with` TRUE TRUE TRUE TRUE FALSE FALSE TRUE TRUE FALSE FALSE FALSE))
-- (d): required only if some shares are not converted.
#ASSERT NOT (`the amalgamation agreement contains what s 182(1) requires` (`an agreement with` TRUE TRUE TRUE TRUE TRUE FALSE TRUE TRUE FALSE FALSE TRUE))
#ASSERT `the amalgamation agreement contains what s 182(1) requires` (`an agreement with` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE TRUE)
-- (f): a copy of the by-laws is required only if they are not those of an amalgamating corporation.
#ASSERT NOT (`the amalgamation agreement contains what s 182(1) requires` (`an agreement with` TRUE TRUE TRUE TRUE FALSE FALSE TRUE TRUE TRUE FALSE TRUE))
#ASSERT `the amalgamation agreement contains what s 182(1) requires` (`an agreement with` TRUE TRUE TRUE TRUE FALSE FALSE TRUE TRUE TRUE TRUE TRUE)

-- (2): shares held within the group are cancelled, not converted.
#ASSERT `the agreement deals as s 182(2) requires with shares held within the group` FALSE FALSE FALSE
#ASSERT `the agreement deals as s 182(2) requires with shares held within the group` TRUE TRUE FALSE
#ASSERT NOT (`the agreement deals as s 182(2) requires with shares held within the group` TRUE FALSE FALSE)
#ASSERT NOT (`the agreement deals as s 182(2) requires with shares held within the group` TRUE TRUE TRUE)

§§ `s 183`

#ASSERT `the directors of each amalgamating corporation must submit the agreement to a meeting of shareholders within s 183(1)` TRUE
#ASSERT NOT (`the directors of each amalgamating corporation must submit the agreement to a meeting of shareholders within s 183(1)` FALSE)
-- (2): the notice.
#ASSERT `the notice of the meeting complies within s 183(2)` TRUE TRUE TRUE TRUE TRUE
#ASSERT `the notice of the meeting complies within s 183(2)` TRUE TRUE TRUE FALSE FALSE
#ASSERT NOT (`the notice of the meeting complies within s 183(2)` TRUE TRUE TRUE TRUE FALSE)
#ASSERT NOT (`the notice of the meeting complies within s 183(2)` FALSE TRUE TRUE FALSE FALSE)
#ASSERT NOT (`the notice of the meeting complies within s 183(2)` TRUE FALSE TRUE FALSE FALSE)
#ASSERT NOT (`the notice of the meeting complies within s 183(2)` TRUE TRUE FALSE FALSE FALSE)
#ASSERT `the effect on the amalgamation of leaving out the dissent statement within s 183(2)(b)` TRUE EQUALS `the omission does not make the action invalid`
#ASSERT `the effect on the amalgamation of leaving out the dissent statement within s 183(2)(b)` FALSE EQUALS `the Act does not say whether the omission makes the action invalid`
-- (3): the vote is carried whether or not the share otherwise votes.
#ASSERT `the share carries the right to vote on the amalgamation agreement within s 183(3)` TRUE
#ASSERT `the share carries the right to vote on the amalgamation agreement within s 183(3)` FALSE
-- (4): the class vote, by the same tests as s 176.
#ASSERT `the holders of a class or series are entitled to vote separately on the amalgamation agreement within s 183(4)` `a change to the rights, privileges, restrictions or conditions attached to the shares of the class (s 176(1)(c))` FALSE FALSE FALSE FALSE FALSE
#ASSERT NOT (`the holders of a class or series are entitled to vote separately on the amalgamation agreement within s 183(4)` `no effect that s 176(1) lists` FALSE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`the holders of a class or series are entitled to vote separately on the amalgamation agreement within s 183(4)` `a change to the rights, privileges, restrictions or conditions attached to the shares of the class (s 176(1)(c))` FALSE FALSE FALSE TRUE FALSE)
#ASSERT `the holders of a class or series are entitled to vote separately on the amalgamation agreement within s 183(4)` `a change to the rights, privileges, restrictions or conditions attached to the shares of the class (s 176(1)(c))` FALSE FALSE FALSE TRUE TRUE
-- (5): one corporation's shareholders.
#ASSERT `the shareholders of an amalgamating corporation have approved the agreement within s 183(5)` (`Vote tally` WITH `votes cast in favour` IS 200, `votes cast against` IS 100, `signed by all the shareholders entitled to vote on the resolution` IS FALSE) TRUE
#ASSERT NOT (`the shareholders of an amalgamating corporation have approved the agreement within s 183(5)` (`Vote tally` WITH `votes cast in favour` IS 199, `votes cast against` IS 101, `signed by all the shareholders entitled to vote on the resolution` IS FALSE) TRUE)
#ASSERT NOT (`the shareholders of an amalgamating corporation have approved the agreement within s 183(5)` (`Vote tally` WITH `votes cast in favour` IS 200, `votes cast against` IS 100, `signed by all the shareholders entitled to vote on the resolution` IS FALSE) FALSE)
#ASSERT `the shareholders of an amalgamating corporation have approved the agreement within s 183(5)` (`Vote tally` WITH `votes cast in favour` IS 0, `votes cast against` IS 0, `signed by all the shareholders entitled to vote on the resolution` IS TRUE) TRUE
-- Adopted when EACH amalgamating corporation's shareholders have approved.
#ASSERT `the amalgamation agreement is adopted within s 183(5)` (LIST TRUE, TRUE)
#ASSERT NOT (`the amalgamation agreement is adopted within s 183(5)` (LIST TRUE, FALSE))
#ASSERT NOT (`the amalgamation agreement is adopted within s 183(5)` (LIST FALSE, TRUE, TRUE))
-- (6): termination before the certificate.
#ASSERT `the directors may terminate the agreement notwithstanding the shareholders' approval within s 183(6)` TRUE FALSE
#ASSERT NOT (`the directors may terminate the agreement notwithstanding the shareholders' approval within s 183(6)` TRUE TRUE)
#ASSERT NOT (`the directors may terminate the agreement notwithstanding the shareholders' approval within s 183(6)` FALSE FALSE)

§§ `s 184`

#ASSERT `the corporations may amalgamate without complying with sections 182 and 183 within s 184(1)` TRUE TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`the corporations may amalgamate without complying with sections 182 and 183 within s 184(1)` FALSE TRUE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`the corporations may amalgamate without complying with sections 182 and 183 within s 184(1)` TRUE FALSE TRUE TRUE TRUE TRUE)
-- (a.1): a subsidiary not wholly held within the group.
#ASSERT NOT (`the corporations may amalgamate without complying with sections 182 and 183 within s 184(1)` TRUE TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`the corporations may amalgamate without complying with sections 182 and 183 within s 184(1)` TRUE TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`the corporations may amalgamate without complying with sections 182 and 183 within s 184(1)` TRUE TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`the corporations may amalgamate without complying with sections 182 and 183 within s 184(1)` TRUE TRUE TRUE TRUE TRUE FALSE)
#ASSERT `the subsidiary corporations may amalgamate without complying with sections 182 and 183 within s 184(2)` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`the subsidiary corporations may amalgamate without complying with sections 182 and 183 within s 184(2)` FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`the subsidiary corporations may amalgamate without complying with sections 182 and 183 within s 184(2)` TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`the subsidiary corporations may amalgamate without complying with sections 182 and 183 within s 184(2)` TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`the subsidiary corporations may amalgamate without complying with sections 182 and 183 within s 184(2)` TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`the subsidiary corporations may amalgamate without complying with sections 182 and 183 within s 184(2)` TRUE TRUE TRUE TRUE FALSE)

§§ `s 185`

#ASSERT `the corporation must send articles of amalgamation to the Director within s 185(1)` TRUE FALSE FALSE
#ASSERT `the corporation must send articles of amalgamation to the Director within s 185(1)` FALSE TRUE FALSE
#ASSERT NOT (`the corporation must send articles of amalgamation to the Director within s 185(1)` TRUE FALSE TRUE)
#ASSERT NOT (`the corporation must send articles of amalgamation to the Director within s 185(1)` FALSE FALSE FALSE)
#ASSERT `the articles of amalgamation have been sent as s 185(1) requires` TRUE TRUE
#ASSERT NOT (`the articles of amalgamation have been sent as s 185(1) requires` TRUE FALSE)
#ASSERT NOT (`the articles of amalgamation have been sent as s 185(1) requires` FALSE TRUE)
-- (2): the declaration. Arguments: attached, (a)(i), (a)(ii), (b)(i), (b)(ii) notice, (b)(ii) no objection, Director satisfied.
#ASSERT `the statutory declaration meets s 185(2)` TRUE TRUE TRUE TRUE FALSE FALSE TRUE
#ASSERT `the statutory declaration meets s 185(2)` TRUE TRUE TRUE FALSE TRUE TRUE TRUE
#ASSERT NOT (`the statutory declaration meets s 185(2)` TRUE TRUE TRUE FALSE TRUE FALSE TRUE)
#ASSERT NOT (`the statutory declaration meets s 185(2)` TRUE TRUE TRUE FALSE FALSE TRUE TRUE)
#ASSERT NOT (`the statutory declaration meets s 185(2)` FALSE TRUE TRUE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`the statutory declaration meets s 185(2)` TRUE FALSE TRUE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`the statutory declaration meets s 185(2)` TRUE TRUE FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`the statutory declaration meets s 185(2)` TRUE TRUE TRUE TRUE TRUE TRUE FALSE)
-- (3)(a): a claim must EXCEED one thousand dollars.
#ASSERT NOT (`the creditor must be sent a written notice within s 185(3)(a)` 1000)
#ASSERT `the creditor must be sent a written notice within s 185(3)(a)` 1000.01
#ASSERT NOT (`the creditor must be sent a written notice within s 185(3)(a)` 999)
#ASSERT `the creditor must be sent a written notice within s 185(3)(a)` 5000
-- (3): adequate notice needs all five.
#ASSERT `adequate notice has been given to creditors within s 185(3)` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`adequate notice has been given to creditors within s 185(3)` FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`adequate notice has been given to creditors within s 185(3)` TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`adequate notice has been given to creditors within s 185(3)` TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`adequate notice has been given to creditors within s 185(3)` TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`adequate notice has been given to creditors within s 185(3)` TRUE TRUE TRUE TRUE FALSE)
-- (3)(c): thirty days from the date of the notice: 31 January 2026 plus 30 days is 2 March 2026.
#ASSERT `the last day on which a creditor may object within s 185(3)(c)` (YMD 2026 1 31) EQUALS YMD 2026 3 2
#ASSERT `the last day on which a creditor may object within s 185(3)(c)` (YMD 2026 3 10) EQUALS YMD 2026 4 9
#ASSERT `the Director must issue a certificate of amalgamation within s 185(4)` TRUE
#ASSERT NOT (`the Director must issue a certificate of amalgamation within s 185(4)` FALSE)

§§ `s 186`

#ASSERT `the amalgamation and continuance as one corporation are effective on a day within s 186(a)` (YMD 2026 5 1) (YMD 2026 5 1)
#ASSERT NOT (`the amalgamation and continuance as one corporation are effective on a day within s 186(a)` (YMD 2026 5 1) (YMD 2026 4 30))
#ASSERT `the amalgamation and continuance as one corporation are effective on a day within s 186(a)` (YMD 2026 5 1) (YMD 2026 5 2)
#ASSERT `the property of each amalgamating corporation is the amalgamated corporation's on a day within s 186(b)` (YMD 2026 5 1) (YMD 2026 5 1)
#ASSERT NOT (`the property of each amalgamating corporation is the amalgamated corporation's on a day within s 186(b)` (YMD 2026 5 1) (YMD 2026 4 30))
#ASSERT `the amalgamated corporation is liable for the obligations of each amalgamating corporation on a day within s 186(c)` (YMD 2026 5 1) (YMD 2026 5 1)
#ASSERT NOT (`the amalgamated corporation is liable for the obligations of each amalgamating corporation on a day within s 186(c)` (YMD 2026 5 1) (YMD 2026 4 30))
#ASSERT `an existing cause of action, claim or liability to prosecution is unaffected on a day within s 186(d)` (YMD 2026 5 1) (YMD 2026 5 1)
#ASSERT NOT (`an existing cause of action, claim or liability to prosecution is unaffected on a day within s 186(d)` (YMD 2026 5 1) (YMD 2026 4 30))
#ASSERT `a pending proceeding by or against an amalgamating corporation may be continued by or against the amalgamated corporation on a day within s 186(e)` (YMD 2026 5 1) (YMD 2026 5 1)
#ASSERT NOT (`a pending proceeding by or against an amalgamating corporation may be continued by or against the amalgamated corporation on a day within s 186(e)` (YMD 2026 5 1) (YMD 2026 4 30))
#ASSERT `a conviction, ruling, order or judgment may be enforced by or against the amalgamated corporation on a day within s 186(f)` (YMD 2026 5 1) (YMD 2026 5 1)
#ASSERT NOT (`a conviction, ruling, order or judgment may be enforced by or against the amalgamated corporation on a day within s 186(f)` (YMD 2026 5 1) (YMD 2026 4 30))
#ASSERT `the articles and the certificate of amalgamation are deemed the articles and certificate of incorporation on a day within s 186(g)` (YMD 2026 5 1) (YMD 2026 5 1)
#ASSERT NOT (`the articles and the certificate of amalgamation are deemed the articles and certificate of incorporation on a day within s 186(g)` (YMD 2026 5 1) (YMD 2026 4 30))

§§ `s 186.1`

-- (1): under one of the listed Acts, first authorized by the shareholders in accordance with s 183.
#ASSERT `the corporation may amalgamate pursuant to another federal Act within s 186.1(1)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `the corporation may amalgamate pursuant to another federal Act within s 186.1(1)` TRUE FALSE EQUALS JUST FALSE
-- Not under one of the listed Acts: the subsection does not speak.
#ASSERT `the corporation may amalgamate pursuant to another federal Act within s 186.1(1)` FALSE TRUE EQUALS NOTHING
#ASSERT `the corporation may amalgamate in short form pursuant to another federal Act within s 186.1(2)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `the corporation may amalgamate in short form pursuant to another federal Act within s 186.1(2)` TRUE FALSE EQUALS JUST FALSE
#ASSERT `the corporation may amalgamate in short form pursuant to another federal Act within s 186.1(2)` FALSE FALSE EQUALS NOTHING
-- (3): the Director's duty needs a notice satisfactory to the Director.
#ASSERT `the Director must file the notice and issue a certificate of discontinuance within s 186.1(3)` TRUE TRUE
#ASSERT NOT (`the Director must file the notice and issue a certificate of discontinuance within s 186.1(3)` TRUE FALSE)
#ASSERT NOT (`the Director must file the notice and issue a certificate of discontinuance within s 186.1(3)` FALSE TRUE)
#ASSERT `the notice is deemed to be articles in the form the Director fixes for section 262 within s 186.1(4)` TRUE
#ASSERT NOT (`the notice is deemed to be articles in the form the Director fixes for section 262 within s 186.1(4)` FALSE)
-- (5): the Act ceases to apply ON the date shown: it applies the day before, not on the date (fork F2).
#ASSERT `this Act still applies to the corporation on a day within s 186.1(5)` (YMD 2026 6 1) (YMD 2026 5 31)
#ASSERT NOT (`this Act still applies to the corporation on a day within s 186.1(5)` (YMD 2026 6 1) (YMD 2026 6 1))
#ASSERT NOT (`this Act still applies to the corporation on a day within s 186.1(5)` (YMD 2026 6 1) (YMD 2026 6 2))
#ASSERT `section 185 does not apply to the corporation within s 186.1(6)` TRUE
#ASSERT NOT (`section 185 does not apply to the corporation within s 186.1(6)` FALSE)
