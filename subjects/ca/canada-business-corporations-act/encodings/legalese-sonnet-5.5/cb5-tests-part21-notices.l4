IMPORT prelude
IMPORT `cbca-core`
IMPORT `cb5-nouns`
IMPORT `cb5-part21-notices`

-- TESTS of cb5-part21-notices.l4 (ss 253 to 257). Every expected value is written from the text of the
-- section named beside it, before the run; none is copied from the module's output.

§ `Tests of Part XXI (notices, certificates and proof)`

§§ `s 253 notice to directors and shareholders`

-- (1): prepaid mail or personal delivery, to the latest address in the records.
#ASSERT `a notice or document may be sent in the way within s 253(1)` `a shareholder` `prepaid mail (s 253(1))` TRUE FALSE
#ASSERT `a notice or document may be sent in the way within s 253(1)` `a shareholder` `personal delivery (s 253(1))` TRUE FALSE
#ASSERT `a notice or document may be sent in the way within s 253(1)` `a director` `prepaid mail (s 253(1))` FALSE TRUE
#ASSERT `a notice or document may be sent in the way within s 253(1)` `a director` `personal delivery (s 253(1))` FALSE TRUE
-- The wrong address for the kind of recipient: the shareholder's address standard does not cover a director.
#ASSERT NOT (`a notice or document may be sent in the way within s 253(1)` `a director` `prepaid mail (s 253(1))` TRUE FALSE)
#ASSERT NOT (`a notice or document may be sent in the way within s 253(1)` `a shareholder` `prepaid mail (s 253(1))` FALSE TRUE)
-- Another way of sending (for example email) is not within s 253(1).
#ASSERT NOT (`a notice or document may be sent in the way within s 253(1)` `a shareholder` `any other way of sending (s 253(1))` TRUE TRUE)
-- A creditor is neither a shareholder nor a director.
#ASSERT NOT (`a notice or document may be sent in the way within s 253(1)` `a creditor` `prepaid mail (s 253(1))` TRUE TRUE)
-- (2): named in a notice sent by a corporation to the Director and filed.
#ASSERT `the person is presumed to be a director of the corporation within s 253(2)` TRUE TRUE TRUE
#ASSERT NOT (`the person is presumed to be a director of the corporation within s 253(2)` TRUE TRUE FALSE)
#ASSERT NOT (`the person is presumed to be a director of the corporation within s 253(2)` TRUE FALSE TRUE)
#ASSERT NOT (`the person is presumed to be a director of the corporation within s 253(2)` FALSE TRUE TRUE)
-- (3): deemed receipt on the ordinary-course delivery date.
#ASSERT `the date the notice is deemed received within s 253(3)` TRUE `a shareholder` FALSE (YMD 2026 5 14) EQUALS JUST (YMD 2026 5 14)
#ASSERT `the date the notice is deemed received within s 253(3)` TRUE `a director` FALSE (YMD 2026 5 14) EQUALS JUST (YMD 2026 5 14)
#ASSERT `the date the notice is deemed received within s 253(3)` TRUE `a shareholder` TRUE (YMD 2026 5 14) EQUALS NOTHING
#ASSERT `the date the notice is deemed received within s 253(3)` FALSE `a shareholder` FALSE (YMD 2026 5 14) EQUALS NOTHING
#ASSERT `the date the notice is deemed received within s 253(3)` TRUE `a creditor` FALSE (YMD 2026 5 14) EQUALS NOTHING
-- (4): two consecutive returns, no new address.
#ASSERT `the corporation is not required to send further notices to the shareholder within s 253(4)` 2 FALSE
#ASSERT `the corporation is not required to send further notices to the shareholder within s 253(4)` 3 FALSE
#ASSERT NOT (`the corporation is not required to send further notices to the shareholder within s 253(4)` 1 FALSE)
#ASSERT NOT (`the corporation is not required to send further notices to the shareholder within s 253(4)` 0 FALSE)
#ASSERT NOT (`the corporation is not required to send further notices to the shareholder within s 253(4)` 2 TRUE)

§§ `s 254 notice to a corporation; s 255 waiver`

#ASSERT `a notice or document may be sent to or served on a corporation within s 254` TRUE TRUE
#ASSERT NOT (`a notice or document may be sent to or served on a corporation within s 254` FALSE TRUE)
#ASSERT NOT (`a notice or document may be sent to or served on a corporation within s 254` TRUE FALSE)
#ASSERT `the date the notice is deemed received or served within s 254` TRUE FALSE (YMD 2026 5 14) EQUALS JUST (YMD 2026 5 14)
#ASSERT `the date the notice is deemed received or served within s 254` TRUE TRUE (YMD 2026 5 14) EQUALS NOTHING
#ASSERT `the date the notice is deemed received or served within s 254` FALSE FALSE (YMD 2026 5 14) EQUALS NOTHING
#ASSERT `the sending or the time may be waived or abridged within s 255` TRUE TRUE
-- Required only by the articles or by-laws: outside the section.
#ASSERT NOT (`the sending or the time may be waived or abridged within s 255` FALSE TRUE)
#ASSERT NOT (`the sending or the time may be waived or abridged within s 255` TRUE FALSE)

§§ `s 256 certificate of the Director`

#ASSERT `the certificate of the Director is validly signed within s 256(1)` TRUE FALSE
#ASSERT `the certificate of the Director is validly signed within s 256(1)` FALSE TRUE
#ASSERT NOT (`the certificate of the Director is validly signed within s 256(1)` FALSE FALSE)
#ASSERT `the strength of proof of a certificate of the Director within s 256(2)` TRUE TRUE FALSE EQUALS `conclusive proof of the facts certified`
-- In a proceeding under section 213 the section does not make it conclusive.
#ASSERT `the strength of proof of a certificate of the Director within s 256(2)` TRUE TRUE TRUE EQUALS `no proof of the facts certified by force of the Act`
#ASSERT `the strength of proof of a certificate of the Director within s 256(2)` TRUE FALSE FALSE EQUALS `no proof of the facts certified by force of the Act`
#ASSERT `the strength of proof of a certificate of the Director within s 256(2)` FALSE TRUE FALSE EQUALS `no proof of the facts certified by force of the Act`

§§ `s 257 certificate of a corporation; proof`

#ASSERT `a certificate issued on behalf of a corporation may be signed by the person within s 257(1)` TRUE TRUE FALSE FALSE
#ASSERT `a certificate issued on behalf of a corporation may be signed by the person within s 257(1)` TRUE FALSE TRUE FALSE
#ASSERT `a certificate issued on behalf of a corporation may be signed by the person within s 257(1)` TRUE FALSE FALSE TRUE
#ASSERT NOT (`a certificate issued on behalf of a corporation may be signed by the person within s 257(1)` TRUE FALSE FALSE FALSE)
#ASSERT NOT (`a certificate issued on behalf of a corporation may be signed by the person within s 257(1)` FALSE TRUE TRUE TRUE)
#ASSERT `the strength of proof of a corporation's certificate, extract or minutes within s 257(2)` TRUE FALSE FALSE TRUE FALSE EQUALS `proof of the facts certified, in the absence of evidence to the contrary`
#ASSERT `the strength of proof of a corporation's certificate, extract or minutes within s 257(2)` FALSE TRUE FALSE TRUE FALSE EQUALS `proof of the facts certified, in the absence of evidence to the contrary`
#ASSERT `the strength of proof of a corporation's certificate, extract or minutes within s 257(2)` FALSE FALSE TRUE TRUE FALSE EQUALS `proof of the facts certified, in the absence of evidence to the contrary`
-- Evidence to the contrary displaces it; not introduced as evidence in a proceeding: no proof by force of the Act.
#ASSERT `the strength of proof of a corporation's certificate, extract or minutes within s 257(2)` TRUE FALSE FALSE TRUE TRUE EQUALS `no proof of the facts certified by force of the Act`
#ASSERT `the strength of proof of a corporation's certificate, extract or minutes within s 257(2)` TRUE FALSE FALSE FALSE FALSE EQUALS `no proof of the facts certified by force of the Act`
#ASSERT `the strength of proof of a corporation's certificate, extract or minutes within s 257(2)` FALSE FALSE FALSE TRUE FALSE EQUALS `no proof of the facts certified by force of the Act`
#ASSERT `the entry or certificate is proof that the registered person is the owner of the securities within s 257(3)` TRUE FALSE
#ASSERT NOT (`the entry or certificate is proof that the registered person is the owner of the securities within s 257(3)` TRUE TRUE)
#ASSERT NOT (`the entry or certificate is proof that the registered person is the owner of the securities within s 257(3)` FALSE FALSE)
