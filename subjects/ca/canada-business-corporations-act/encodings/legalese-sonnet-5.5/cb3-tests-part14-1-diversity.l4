IMPORT prelude
IMPORT `cbca-core`
IMPORT `cb3-part14-1-diversity`

-- Tests of cb3-part14-1-diversity.l4 (CBCA s 172.1). Every expected value is written from the text of
-- s 172.1, quoted in the module; none is copied from the module's own output.

§ `Tests of s 172.1`

§§ `s 172.1(1): the duty arises for a prescribed corporation at an annual meeting only`

-- "The directors of a prescribed corporation shall place before the shareholders, at every annual meeting ..."
#ASSERT `the directors must place the diversity information before the shareholders within s 172.1(1)` TRUE TRUE
-- a special meeting is not an annual meeting: no duty
#ASSERT NOT `the directors must place the diversity information before the shareholders within s 172.1(1)` TRUE FALSE
-- a corporation the regulations do not prescribe: no duty
#ASSERT NOT `the directors must place the diversity information before the shareholders within s 172.1(1)` FALSE TRUE
#ASSERT NOT `the directors must place the diversity information before the shareholders within s 172.1(1)` FALSE FALSE

§§ `s 172.1(1): complying means placing both halves of the information`

-- "... the prescribed information respecting diversity among the directors and among the members of senior management ..."
-- prescribed, annual meeting, both halves placed: complied
#ASSERT `the directors have complied with s 172.1(1)` TRUE TRUE TRUE TRUE
-- prescribed, annual meeting, only the directors' half: not complied
#ASSERT NOT `the directors have complied with s 172.1(1)` TRUE TRUE TRUE FALSE
-- prescribed, annual meeting, only the senior management half: not complied
#ASSERT NOT `the directors have complied with s 172.1(1)` TRUE TRUE FALSE TRUE
-- prescribed, annual meeting, nothing placed: not complied
#ASSERT NOT `the directors have complied with s 172.1(1)` TRUE TRUE FALSE FALSE
-- prescribed but a special meeting: no duty, so not in default even if nothing was placed
#ASSERT `the directors have complied with s 172.1(1)` TRUE FALSE FALSE FALSE
-- not prescribed: no duty, so not in default
#ASSERT `the directors have complied with s 172.1(1)` FALSE TRUE FALSE FALSE

§§ `s 172.1(2): to each shareholder, except one who has opted out in writing`

-- prescribed, shareholder has not opted out: the corporation must provide it
#ASSERT `the corporation must provide the diversity information to a shareholder within s 172.1(2)` TRUE FALSE
-- "except to a shareholder who has informed the corporation in writing that they do not want to receive that information"
#ASSERT NOT `the corporation must provide the diversity information to a shareholder within s 172.1(2)` TRUE TRUE
-- not a prescribed corporation: nothing to provide
#ASSERT NOT `the corporation must provide the diversity information to a shareholder within s 172.1(2)` FALSE FALSE

-- "by sending the information along with the notice referred to in subsection 135(1) or by making
-- the information available along with a proxy circular referred to in subsection 150(1)": either
#ASSERT `the information was provided in a manner the section allows within s 172.1(2)` TRUE FALSE
#ASSERT `the information was provided in a manner the section allows within s 172.1(2)` FALSE TRUE
#ASSERT `the information was provided in a manner the section allows within s 172.1(2)` TRUE TRUE
#ASSERT NOT `the information was provided in a manner the section allows within s 172.1(2)` FALSE FALSE

§§ `s 172.1(3): to the Director, concurrently`

#ASSERT `the corporation must send the diversity information to the Director within s 172.1(3)` TRUE
#ASSERT NOT `the corporation must send the diversity information to the Director within s 172.1(3)` FALSE

-- "concurrently" read as the same day (fork F-CONC)
#ASSERT `the information was sent to the Director concurrently within s 172.1(3)` (YearMonthDay 2027 3 1) (YearMonthDay 2027 3 1)
#ASSERT NOT `the information was sent to the Director concurrently within s 172.1(3)` (YearMonthDay 2027 3 1) (YearMonthDay 2027 3 2)
#ASSERT NOT `the information was sent to the Director concurrently within s 172.1(3)` (YearMonthDay 2027 3 2) (YearMonthDay 2027 3 1)
