IMPORT prelude
IMPORT `cbca-core`
IMPORT `cb2-nouns`
IMPORT `cb2-part7-interpretation`

-- Tests of cb2-part7-interpretation.l4 (s 48). Every expected value is written from the text of the
-- provision named beside it, not from the output of the rule.

§ `Tests of s 48`

§§ `s 48(1)`
-- src:698: the transfer or transmission of a security is governed by Part VII.
#ASSERT `the matter is governed by Part VII within s 48(1)` TRUE
#ASSERT NOT (`the matter is governed by Part VII within s 48(1)` FALSE)

§§ `s 48(2) adverse claim: the two listed claims, or any claim that is one in the ordinary sense`
#ASSERT `adverse claim within s 48(2)` TRUE FALSE FALSE
#ASSERT `adverse claim within s 48(2)` FALSE TRUE FALSE
#ASSERT `adverse claim within s 48(2)` FALSE FALSE TRUE
#ASSERT NOT (`adverse claim within s 48(2)` FALSE FALSE FALSE)

§§ `s 48(2) bearer: in possession of a security payable to bearer or endorsed in blank`
#ASSERT `bearer within s 48(2)` TRUE TRUE FALSE
#ASSERT `bearer within s 48(2)` TRUE FALSE TRUE
#ASSERT NOT (`bearer within s 48(2)` TRUE FALSE FALSE)
#ASSERT NOT (`bearer within s 48(2)` FALSE TRUE TRUE)

§§ `s 48(2) bona fide purchaser`
-- args: for value, good faith, without notice, takes delivery, form, registered security issued or endorsed to the purchaser or in blank
#ASSERT `bona fide purchaser within s 48(2)` TRUE TRUE TRUE TRUE `a security in bearer form` FALSE
#ASSERT `bona fide purchaser within s 48(2)` TRUE TRUE TRUE TRUE `a security in order form` FALSE
#ASSERT `bona fide purchaser within s 48(2)` TRUE TRUE TRUE TRUE `a security in registered form` TRUE
-- a registered-form security not issued or endorsed to the purchaser or in blank does not qualify
#ASSERT NOT (`bona fide purchaser within s 48(2)` TRUE TRUE TRUE TRUE `a security in registered form` FALSE)
#ASSERT NOT (`bona fide purchaser within s 48(2)` FALSE TRUE TRUE TRUE `a security in bearer form` FALSE)
#ASSERT NOT (`bona fide purchaser within s 48(2)` TRUE FALSE TRUE TRUE `a security in bearer form` FALSE)
#ASSERT NOT (`bona fide purchaser within s 48(2)` TRUE TRUE FALSE TRUE `a security in bearer form` FALSE)
#ASSERT NOT (`bona fide purchaser within s 48(2)` TRUE TRUE TRUE FALSE `a security in bearer form` FALSE)
-- a thing in none of the three forms is not a security the definition reaches
#ASSERT NOT (`bona fide purchaser within s 48(2)` TRUE TRUE TRUE TRUE `a security in none of the three forms in section 48` TRUE)

§§ `s 48(2) broker`
-- args: engaged in the business, acts for a customer, buys from a customer, sells to a customer
#ASSERT `broker within s 48(2)` TRUE TRUE FALSE FALSE
#ASSERT `broker within s 48(2)` TRUE FALSE TRUE FALSE
#ASSERT `broker within s 48(2)` TRUE FALSE FALSE TRUE
#ASSERT NOT (`broker within s 48(2)` TRUE FALSE FALSE FALSE)
#ASSERT NOT (`broker within s 48(2)` FALSE TRUE TRUE TRUE)

§§ `s 48(2) delivery, good faith`
#ASSERT `delivery within s 48(2)` TRUE
#ASSERT NOT (`delivery within s 48(2)` FALSE)
#ASSERT `good faith within s 48(2)` TRUE
#ASSERT NOT (`good faith within s 48(2)` FALSE)

§§ `s 48(2) fiduciary`
#ASSERT `fiduciary within s 48(2)` TRUE FALSE FALSE
#ASSERT `fiduciary within s 48(2)` FALSE TRUE FALSE
#ASSERT `fiduciary within s 48(2)` FALSE FALSE TRUE
#ASSERT NOT (`fiduciary within s 48(2)` FALSE FALSE FALSE)

§§ `s 48(2) fungible, genuine`
#ASSERT `fungible within s 48(2)` TRUE FALSE
#ASSERT `fungible within s 48(2)` FALSE TRUE
#ASSERT NOT (`fungible within s 48(2)` FALSE FALSE)
#ASSERT `genuine within s 48(2)` FALSE FALSE
#ASSERT NOT (`genuine within s 48(2)` TRUE FALSE)
#ASSERT NOT (`genuine within s 48(2)` FALSE TRUE)
#ASSERT NOT (`genuine within s 48(2)` TRUE TRUE)

§§ `s 48(2) holder`
-- args: in possession, issued or endorsed to the person, to the bearer, in blank
#ASSERT `holder within s 48(2)` TRUE TRUE FALSE FALSE
#ASSERT `holder within s 48(2)` TRUE FALSE TRUE FALSE
#ASSERT `holder within s 48(2)` TRUE FALSE FALSE TRUE
#ASSERT NOT (`holder within s 48(2)` TRUE FALSE FALSE FALSE)
#ASSERT NOT (`holder within s 48(2)` FALSE TRUE TRUE TRUE)

§§ `s 48(2) issuer`
#ASSERT `issuer within s 48(2)` TRUE FALSE FALSE FALSE
#ASSERT `issuer within s 48(2)` FALSE TRUE FALSE FALSE
#ASSERT `issuer within s 48(2)` FALSE FALSE TRUE FALSE
#ASSERT `issuer within s 48(2)` FALSE FALSE FALSE TRUE
#ASSERT NOT (`issuer within s 48(2)` FALSE FALSE FALSE FALSE)

§§ `s 48(2) overissue: in excess of ANY maximum the articles or a trust indenture authorize`
-- args: number issued, maximum in the articles, maximum in a trust indenture
#ASSERT `overissue within s 48(2)` 101 (JUST 100) NOTHING
-- at the maximum is not in excess of it
#ASSERT NOT (`overissue within s 48(2)` 100 (JUST 100) NOTHING)
#ASSERT `overissue within s 48(2)` 51 NOTHING (JUST 50)
-- over the indenture's maximum although within the articles' maximum
#ASSERT `overissue within s 48(2)` 80 (JUST 100) (JUST 50)
-- no maximum stated anywhere: nothing is exceeded
#ASSERT NOT (`overissue within s 48(2)` 1000000 NOTHING NOTHING)
#ASSERT `the number issued is above a maximum that is stated, if there is one, within s 48(2)` 5 (JUST 4)
#ASSERT NOT (`the number issued is above a maximum that is stated, if there is one, within s 48(2)` 5 NOTHING)

§§ `s 48(2) purchaser`
#ASSERT `purchaser within s 48(2)` `taking an interest in a security by sale`
#ASSERT `purchaser within s 48(2)` `taking an interest in a security by mortgage`
#ASSERT `purchaser within s 48(2)` `taking an interest in a security by hypothec`
#ASSERT `purchaser within s 48(2)` `taking an interest in a security by pledge`
#ASSERT `purchaser within s 48(2)` `taking an interest in a security by issue`
#ASSERT `purchaser within s 48(2)` `taking an interest in a security by reissue`
#ASSERT `purchaser within s 48(2)` `taking an interest in a security by gift`
#ASSERT `purchaser within s 48(2)` `taking an interest in a security by another voluntary transaction`
#ASSERT NOT (`purchaser within s 48(2)` `taking an interest in a security in a way that is not a voluntary transaction`)

§§ `s 48(2) security or security certificate: all four of (a) to (d)`
#ASSERT `security or security certificate within s 48(2)` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`security or security certificate within s 48(2)` FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`security or security certificate within s 48(2)` TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`security or security certificate within s 48(2)` TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`security or security certificate within s 48(2)` TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`security or security certificate within s 48(2)` TRUE TRUE TRUE TRUE FALSE)

§§ `s 48(2) transfer, unauthorized, valid`
#ASSERT `transfer within s 48(2)` TRUE FALSE
#ASSERT `transfer within s 48(2)` FALSE TRUE
#ASSERT NOT (`transfer within s 48(2)` FALSE FALSE)
-- args: actual, implied, apparent authority, forgery
#ASSERT `unauthorized within s 48(2)` FALSE FALSE FALSE FALSE
#ASSERT NOT (`unauthorized within s 48(2)` TRUE FALSE FALSE FALSE)
#ASSERT NOT (`unauthorized within s 48(2)` FALSE TRUE FALSE FALSE)
#ASSERT NOT (`unauthorized within s 48(2)` FALSE FALSE TRUE FALSE)
-- "includes a forgery": a forgery is unauthorized even if the forger had apparent authority
#ASSERT `unauthorized within s 48(2)` FALSE FALSE TRUE TRUE
-- args: in accordance with the law, with the articles, validated under section 52
#ASSERT `valid within s 48(2)` TRUE TRUE FALSE
#ASSERT NOT (`valid within s 48(2)` TRUE FALSE FALSE)
#ASSERT NOT (`valid within s 48(2)` FALSE TRUE FALSE)
#ASSERT `valid within s 48(2)` FALSE FALSE TRUE

§§ `s 48(3) to (7)`
-- args: transfer restricted, restriction noted in accordance with s 49(8)
#ASSERT NOT (`a security is a negotiable instrument within s 48(3)` TRUE TRUE)
#ASSERT `a security is a negotiable instrument within s 48(3)` TRUE FALSE
#ASSERT `a security is a negotiable instrument within s 48(3)` FALSE FALSE
#ASSERT `a security is a negotiable instrument within s 48(3)` FALSE TRUE
-- args: specifies a person, transfer recordable, bears a statement
#ASSERT `a security is in registered form within s 48(4)` TRUE TRUE FALSE
#ASSERT NOT (`a security is in registered form within s 48(4)` TRUE FALSE FALSE)
#ASSERT NOT (`a security is in registered form within s 48(4)` FALSE TRUE FALSE)
#ASSERT `a security is in registered form within s 48(4)` FALSE FALSE TRUE
-- args: a debt obligation, payable to the order or assigns, payable to that person's order
#ASSERT `a debt obligation is in order form within s 48(5)` TRUE TRUE FALSE
#ASSERT `a debt obligation is in order form within s 48(5)` TRUE FALSE TRUE
#ASSERT NOT (`a debt obligation is in order form within s 48(5)` TRUE FALSE FALSE)
#ASSERT NOT (`a debt obligation is in order form within s 48(5)` FALSE TRUE TRUE)
-- args: payable to bearer by its terms, payable to bearer only by reason of an endorsement
#ASSERT `a security is in bearer form within s 48(6)` TRUE FALSE
#ASSERT NOT (`a security is in bearer form within s 48(6)` TRUE TRUE)
#ASSERT NOT (`a security is in bearer form within s 48(6)` FALSE FALSE)
-- args: a guarantor, noted on the security: noting or not, a guarantor is deemed an issuer
#ASSERT `a guarantor is deemed to be an issuer to the extent of the guarantee within s 48(7)` TRUE
#ASSERT NOT (`a guarantor is deemed to be an issuer to the extent of the guarantee within s 48(7)` FALSE)

§§ `s 48(4) to (6) the forms a security takes, and the case that is in none`
#ASSERT `the forms of a security within s 48(4) to (6)` TRUE FALSE FALSE EQUALS LIST `a security in registered form`
#ASSERT `the forms of a security within s 48(4) to (6)` FALSE TRUE FALSE EQUALS LIST `a security in order form`
#ASSERT `the forms of a security within s 48(4) to (6)` FALSE FALSE TRUE EQUALS LIST `a security in bearer form`
#ASSERT `the forms of a security within s 48(4) to (6)` TRUE FALSE TRUE EQUALS LIST `a security in registered form`, `a security in bearer form`
-- not covered: in none of the three forms is a named answer, not an empty list and not FALSE
#ASSERT `the forms of a security within s 48(4) to (6)` FALSE FALSE FALSE EQUALS LIST `a security in none of the three forms in section 48`
