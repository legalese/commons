IMPORT prelude
IMPORT `cbca-core`
IMPORT `cb5-nouns`
IMPORT `cb5-part21-director`

-- TESTS of cb5-part21-director.l4 (ss 258 to 267.1). Every expected value is written from the text of the
-- section named beside it, before the run; none is copied from the module's output.

§ `Tests of Part XXI (the Director's documents)`

§§ `s 258, s 258.2, s 259`

#ASSERT `the Director may accept a photostatic or photographic copy within s 258` TRUE TRUE
#ASSERT NOT (`the Director may accept a photostatic or photographic copy within s 258` FALSE TRUE)
#ASSERT NOT (`the Director may accept a photostatic or photographic copy within s 258` TRUE FALSE)
#ASSERT `the Director may exempt the notices or documents from being sent to the Director within s 258.2` TRUE TRUE
#ASSERT NOT (`the Director may exempt the notices or documents from being sent to the Director within s 258.2` FALSE TRUE)
#ASSERT NOT (`the Director may exempt the notices or documents from being sent to the Director within s 258.2` TRUE FALSE)
#ASSERT `the Director may require verification within s 259(1)` TRUE
#ASSERT NOT (`the Director may require verification within s 259(1)` FALSE)
#ASSERT `the document or fact is verified within s 259(2)` TRUE FALSE TRUE
#ASSERT `the document or fact is verified within s 259(2)` FALSE TRUE TRUE
#ASSERT NOT (`the document or fact is verified within s 259(2)` TRUE TRUE FALSE)
#ASSERT NOT (`the document or fact is verified within s 259(2)` FALSE FALSE TRUE)

§§ `s 261.1 fees`

#ASSERT `when the fee must be paid to the Director within s 261.1` `receipt or copying of a document or other information (s 261.1)` EQUALS `when the document or other information is received or copied`
#ASSERT `when the fee must be paid to the Director within s 261.1` `examination, filing or issuance of a document or other information, or an action the Director is required or authorized to take (s 261.1)` EQUALS `before the document or other information is examined, filed or issued or the action is taken`

§§ `s 262 articles, statements and certificates`

#ASSERT `statement within s 262(1)` TRUE FALSE
#ASSERT `statement within s 262(1)` FALSE TRUE
#ASSERT NOT (`statement within s 262(1)` FALSE FALSE)
#ASSERT `the duty is due within s 262(2)` `to record the date of receipt (s 262(2)(a))` TRUE TRUE TRUE TRUE
#ASSERT `the duty is due within s 262(2)` `to issue the appropriate certificate (s 262(2)(b))` TRUE TRUE TRUE TRUE
#ASSERT `the duty is due within s 262(2)` `to send the certificate, or a copy or reproduction of it, to the corporation or its agent or mandatary (s 262(2)(c))` TRUE TRUE TRUE TRUE
#ASSERT `the duty is due within s 262(2)` `to publish a notice of the issuance of the certificate in a publication generally available to the public (s 262(2)(d))` TRUE TRUE TRUE TRUE
-- Any one condition missing: no duty is due.
#ASSERT NOT (`the duty is due within s 262(2)` `to issue the appropriate certificate (s 262(2)(b))` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`the duty is due within s 262(2)` `to issue the appropriate certificate (s 262(2)(b))` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`the duty is due within s 262(2)` `to issue the appropriate certificate (s 262(2)(b))` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`the duty is due within s 262(2)` `to issue the appropriate certificate (s 262(2)(b))` TRUE TRUE TRUE FALSE)
-- (3): the day of receipt, or a later day specified.
#ASSERT `a certificate may be dated as of the day within s 262(3)` (YMD 2026 4 1) (YMD 2026 4 1) FALSE
#ASSERT `a certificate may be dated as of the day within s 262(3)` (YMD 2026 4 9) (YMD 2026 4 1) TRUE
#ASSERT NOT (`a certificate may be dated as of the day within s 262(3)` (YMD 2026 4 9) (YMD 2026 4 1) FALSE)
-- An earlier day, even one specified, is not "a later day".
#ASSERT NOT (`a certificate may be dated as of the day within s 262(3)` (YMD 2026 3 30) (YMD 2026 4 1) TRUE)
-- (5): a certificate of discontinuance only.
#ASSERT `a certificate of discontinuance may be dated as of the day within s 262(5)` TRUE TRUE
#ASSERT NOT (`a certificate of discontinuance may be dated as of the day within s 262(5)` FALSE TRUE)
#ASSERT NOT (`a certificate of discontinuance may be dated as of the day within s 262(5)` TRUE FALSE)

§§ `s 262.1, s 262.2, s 263, s 263.1`

#ASSERT `a signature on a certificate issued by the Director is allowed within s 262.1(1)` TRUE FALSE
#ASSERT `a signature on a certificate issued by the Director is allowed within s 262.1(1)` FALSE TRUE
#ASSERT NOT (`a signature on a certificate issued by the Director is allowed within s 262.1(1)` FALSE FALSE)
#ASSERT `the documents are deemed to constitute one document within s 262.1(3)` TRUE TRUE TRUE TRUE
#ASSERT NOT (`the documents are deemed to constitute one document within s 262.1(3)` TRUE TRUE TRUE FALSE)
#ASSERT NOT (`the documents are deemed to constitute one document within s 262.1(3)` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`the documents are deemed to constitute one document within s 262.1(3)` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`the documents are deemed to constitute one document within s 262.1(3)` FALSE TRUE TRUE TRUE)
#ASSERT `the Director must publish a notice of the decision within s 262.2` `an application under subsection 2(6) (s 262.2)` TRUE
#ASSERT `the Director must publish a notice of the decision within s 262.2` `an application under subsection 10(2) (s 262.2)` TRUE
#ASSERT `the Director must publish a notice of the decision within s 262.2` `an application under subsection 21.303(3) (s 262.2)` TRUE
#ASSERT `the Director must publish a notice of the decision within s 262.2` `an application under subsection 82(3) (s 262.2)` TRUE
#ASSERT `the Director must publish a notice of the decision within s 262.2` `an application under subsection 151(1) (s 262.2)` TRUE
#ASSERT `the Director must publish a notice of the decision within s 262.2` `an application under section 156 (s 262.2)` TRUE
#ASSERT `the Director must publish a notice of the decision within s 262.2` `an application under subsection 171(2) (s 262.2)` TRUE
#ASSERT `the Director must publish a notice of the decision within s 262.2` `an application under subsection 187(11) (s 262.2)` TRUE
-- A decision that refuses, or an application of another kind: no duty under s 262.2.
#ASSERT NOT (`the Director must publish a notice of the decision within s 262.2` `an application under subsection 2(6) (s 262.2)` FALSE)
#ASSERT NOT (`the Director must publish a notice of the decision within s 262.2` `any other application (s 262.2)` TRUE)
#ASSERT `the corporation has complied with the duty to send an annual return within s 263` TRUE TRUE TRUE
#ASSERT NOT (`the corporation has complied with the duty to send an annual return within s 263` FALSE TRUE TRUE)
#ASSERT NOT (`the corporation has complied with the duty to send an annual return within s 263` TRUE FALSE TRUE)
#ASSERT NOT (`the corporation has complied with the duty to send an annual return within s 263` TRUE TRUE FALSE)
#ASSERT `the Director may provide any person with a certificate of the statement within s 263.1(1)` `that it has sent to the Director a document or other information required to be sent under this Act (s 263.1(1)(a))`
#ASSERT `the Director may provide any person with a certificate of the statement within s 263.1(1)` `that it has paid all required fees (s 263.1(1)(b))`
#ASSERT `the Director may provide any person with a certificate of the statement within s 263.1(1)` `that it exists as of a certain date (s 263.1(1)(c))`
#ASSERT NOT (`the Director may provide any person with a certificate of the statement within s 263.1(1)` `any other statement (s 263.1(1))`)
#ASSERT `the Director may refuse to issue a certificate of existence within s 263.1(2)` `that it exists as of a certain date (s 263.1(1)(c))` TRUE FALSE
#ASSERT `the Director may refuse to issue a certificate of existence within s 263.1(2)` `that it exists as of a certain date (s 263.1(1)(c))` FALSE TRUE
#ASSERT NOT (`the Director may refuse to issue a certificate of existence within s 263.1(2)` `that it exists as of a certain date (s 263.1(1)(c))` FALSE FALSE)
-- Only a certificate of existence may be refused on this ground.
#ASSERT NOT (`the Director may refuse to issue a certificate of existence within s 263.1(2)` `that it has paid all required fees (s 263.1(1)(b))` TRUE TRUE)

§§ `s 264, s 265 corrections`

#ASSERT `the Director may alter a notice or document within s 264` FALSE TRUE
#ASSERT NOT (`the Director may alter a notice or document within s 264` TRUE TRUE)
#ASSERT NOT (`the Director may alter a notice or document within s 264` FALSE FALSE)
#ASSERT `the directors or shareholders must pass the resolutions and take the steps within s 265(1)` TRUE TRUE
#ASSERT NOT (`the directors or shareholders must pass the resolutions and take the steps within s 265(1)` TRUE FALSE)
#ASSERT NOT (`the directors or shareholders must pass the resolutions and take the steps within s 265(1)` FALSE TRUE)
#ASSERT `the Director may proceed under subsection 265(1) within s 265(2)` TRUE
#ASSERT NOT (`the Director may proceed under subsection 265(1) within s 265(2)` FALSE)
-- (3): directors' approval is needed unless the error is obvious or the Director's own.
#ASSERT `the Director may accept the correction within s 265(3)` TRUE TRUE FALSE FALSE TRUE TRUE
#ASSERT `the Director may accept the correction within s 265(3)` TRUE FALSE TRUE FALSE TRUE TRUE
#ASSERT `the Director may accept the correction within s 265(3)` TRUE FALSE FALSE TRUE TRUE TRUE
#ASSERT NOT (`the Director may accept the correction within s 265(3)` TRUE FALSE FALSE FALSE TRUE TRUE)
#ASSERT NOT (`the Director may accept the correction within s 265(3)` TRUE TRUE FALSE FALSE FALSE TRUE)
#ASSERT NOT (`the Director may accept the correction within s 265(3)` TRUE TRUE FALSE FALSE TRUE FALSE)
#ASSERT NOT (`the Director may accept the correction within s 265(3)` FALSE TRUE FALSE FALSE TRUE TRUE)
#ASSERT `the applicant may apply to the court for an order that the document be corrected within s 265(4)` `the Director` TRUE FALSE
#ASSERT `the applicant may apply to the court for an order that the document be corrected within s 265(4)` `the corporation` TRUE FALSE
#ASSERT `the applicant may apply to the court for an order that the document be corrected within s 265(4)` `a creditor` TRUE TRUE
#ASSERT NOT (`the applicant may apply to the court for an order that the document be corrected within s 265(4)` `a creditor` TRUE FALSE)
#ASSERT NOT (`the applicant may apply to the court for an order that the document be corrected within s 265(4)` `the Director` FALSE FALSE)
#ASSERT `the applicant must give the Director notice within s 265(5)` TRUE
#ASSERT NOT (`the applicant must give the Director notice within s 265(5)` FALSE)
#ASSERT `the Director may demand the surrender of the original document within s 265(6)` TRUE
-- (7): the date of the replaced document unless the correction is of the date, or the court decides otherwise.
#ASSERT `the date the corrected document bears within s 265(7)` (YMD 2025 1 10) FALSE (YMD 2025 1 11) NOTHING EQUALS YMD 2025 1 10
#ASSERT `the date the corrected document bears within s 265(7)` (YMD 2025 1 10) TRUE (YMD 2025 1 11) NOTHING EQUALS YMD 2025 1 11
#ASSERT `the date the corrected document bears within s 265(7)` (YMD 2025 1 10) FALSE (YMD 2025 1 11) (JUST (YMD 2025 2 1)) EQUALS YMD 2025 2 1
#ASSERT `the date the corrected document bears within s 265(7)` (YMD 2025 1 10) TRUE (YMD 2025 1 11) (JUST (YMD 2025 2 1)) EQUALS YMD 2025 2 1
#ASSERT `the Director must without delay give notice of the correction within s 265(8)` TRUE
#ASSERT NOT (`the Director must without delay give notice of the correction within s 265(8)` FALSE)

