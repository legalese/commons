IMPORT prelude
IMPORT `cbca-core`
IMPORT `cb5-nouns`
IMPORT `cb5-part20-remedies`

-- TESTS of cb5-part20-remedies.l4 (Part XX, ss 238 to 249). Every expected value is written from the text of
-- the section named beside it, before the run; none is copied from the module's output.
-- Arguments are positional, in the order of the rule's GIVEN: see the module.

§ `Tests of Part XX (remedies)`

§§ `s 238 definitions`

#ASSERT `action within s 238` TRUE
#ASSERT NOT (`action within s 238` FALSE)
-- Each of the four paragraphs is enough on its own.
#ASSERT `complainant within s 238` TRUE FALSE FALSE FALSE
#ASSERT `complainant within s 238` FALSE TRUE FALSE FALSE
#ASSERT `complainant within s 238` FALSE FALSE TRUE FALSE
#ASSERT `complainant within s 238` FALSE FALSE FALSE TRUE
#ASSERT NOT (`complainant within s 238` FALSE FALSE FALSE FALSE)

§§ `s 239 derivative action`

#ASSERT `a complainant may apply to a court for leave to act for the corporation within s 239(1)` TRUE TRUE TRUE
#ASSERT NOT (`a complainant may apply to a court for leave to act for the corporation within s 239(1)` FALSE TRUE TRUE)
#ASSERT NOT (`a complainant may apply to a court for leave to act for the corporation within s 239(1)` TRUE FALSE TRUE)
#ASSERT NOT (`a complainant may apply to a court for leave to act for the corporation within s 239(1)` TRUE TRUE FALSE)
-- (2)(a): notice at least fourteen days before the application. Notice on 1 March, application on 15 March: exactly fourteen days.
#ASSERT `the condition of notice to the directors is met within s 239(2)(a)` (YearMonthDay 2026 3 1) (YearMonthDay 2026 3 15) FALSE TRUE
-- Thirteen days: too short ...
#ASSERT NOT (`the condition of notice to the directors is met within s 239(2)(a)` (YearMonthDay 2026 3 2) (YearMonthDay 2026 3 15) FALSE TRUE)
-- ... unless the court ordered otherwise.
#ASSERT `the condition of notice to the directors is met within s 239(2)(a)` (YearMonthDay 2026 3 2) (YearMonthDay 2026 3 15) TRUE TRUE
-- The directors are acting: the condition is not met.
#ASSERT NOT (`the condition of notice to the directors is met within s 239(2)(a)` (YearMonthDay 2026 1 1) (YearMonthDay 2026 3 15) FALSE FALSE)
#ASSERT `the condition of good faith is met within s 239(2)(b)` TRUE
#ASSERT NOT (`the condition of good faith is met within s 239(2)(b)` FALSE)
#ASSERT `the condition of the interests of the corporation is met within s 239(2)(c)` TRUE
#ASSERT NOT (`the condition of the interests of the corporation is met within s 239(2)(c)` FALSE)
#ASSERT `the action may be brought or the intervention made within s 239(2)` TRUE TRUE TRUE
#ASSERT NOT (`the action may be brought or the intervention made within s 239(2)` FALSE TRUE TRUE)
#ASSERT NOT (`the action may be brought or the intervention made within s 239(2)` TRUE FALSE TRUE)
#ASSERT NOT (`the action may be brought or the intervention made within s 239(2)` TRUE TRUE FALSE)

§§ `s 240 orders in a derivative action`

#ASSERT `the court may make an order of the kind within s 240` `an order authorizing the complainant or any other person to control the conduct of the action (s 240(a))` TRUE
#ASSERT `the court may make an order of the kind within s 240` `an order giving directions for the conduct of the action (s 240(b))` TRUE
#ASSERT `the court may make an order of the kind within s 240` `an order directing that an amount adjudged payable by a defendant be paid directly to former and present security holders instead of to the corporation or its subsidiary (s 240(c))` TRUE
#ASSERT `the court may make an order of the kind within s 240` `an order requiring the corporation or its subsidiary to pay the complainant's reasonable legal fees in connection with the action (s 240(d))` TRUE
#ASSERT `the court may make an order of the kind within s 240` `any other order the court thinks fit in connection with the action (s 240)` TRUE
#ASSERT NOT (`the court may make an order of the kind within s 240` `any other order the court thinks fit in connection with the action (s 240)` FALSE)
#ASSERT NOT (`the court may make an order of the kind within s 240` `an order giving directions for the conduct of the action (s 240(b))` FALSE)

§§ `s 241 oppression`

#ASSERT `a complainant may apply to a court for an order within s 241(1)` TRUE
#ASSERT NOT (`a complainant may apply to a court for an order within s 241(1)` FALSE)
-- (2): each limb alone, with the characterization and a protected party.
#ASSERT `the court may make an order to rectify the matters complained of within s 241(2)` TRUE TRUE FALSE FALSE TRUE `a security holder`
#ASSERT `the court may make an order to rectify the matters complained of within s 241(2)` TRUE FALSE TRUE FALSE TRUE `a creditor`
#ASSERT `the court may make an order to rectify the matters complained of within s 241(2)` TRUE FALSE FALSE TRUE TRUE `a director`
#ASSERT `the court may make an order to rectify the matters complained of within s 241(2)` TRUE TRUE FALSE FALSE TRUE `an officer`
-- Not a protected party of the four.
#ASSERT NOT (`the court may make an order to rectify the matters complained of within s 241(2)` TRUE TRUE FALSE FALSE TRUE `the auditor`)
#ASSERT NOT (`the court may make an order to rectify the matters complained of within s 241(2)` TRUE TRUE FALSE FALSE TRUE `a proxyholder`)
-- No limb satisfied; not oppressive; no application.
#ASSERT NOT (`the court may make an order to rectify the matters complained of within s 241(2)` TRUE FALSE FALSE FALSE TRUE `a security holder`)
#ASSERT NOT (`the court may make an order to rectify the matters complained of within s 241(2)` TRUE TRUE TRUE TRUE FALSE `a security holder`)
#ASSERT NOT (`the court may make an order to rectify the matters complained of within s 241(2)` FALSE TRUE TRUE TRUE TRUE `a security holder`)
-- (3): fifteen kinds. (f) and (g) are barred when the order directs a payment that (6) forbids.
#ASSERT `the court may make an order of the kind within s 241(3)` `an order restraining the conduct complained of (s 241(3)(a))` TRUE FALSE
#ASSERT `the court may make an order of the kind within s 241(3)` `an order appointing a receiver or receiver-manager (s 241(3)(b))` TRUE FALSE
#ASSERT `the court may make an order of the kind within s 241(3)` `an order to regulate the corporation's affairs by amending the articles or by-laws or creating or amending a unanimous shareholder agreement (s 241(3)(c))` TRUE FALSE
#ASSERT `the court may make an order of the kind within s 241(3)` `an order directing an issue or exchange of securities (s 241(3)(d))` TRUE FALSE
#ASSERT `the court may make an order of the kind within s 241(3)` `an order appointing directors in place of or in addition to the directors in office (s 241(3)(e))` TRUE FALSE
#ASSERT `the court may make an order of the kind within s 241(3)` `an order directing the corporation or any other person to purchase securities of a security holder (s 241(3)(f))` TRUE FALSE
#ASSERT NOT (`the court may make an order of the kind within s 241(3)` `an order directing the corporation or any other person to purchase securities of a security holder (s 241(3)(f))` TRUE TRUE)
#ASSERT `the court may make an order of the kind within s 241(3)` `an order directing the corporation or any other person to pay a security holder part of the money the security holder paid for securities (s 241(3)(g))` TRUE FALSE
#ASSERT NOT (`the court may make an order of the kind within s 241(3)` `an order directing the corporation or any other person to pay a security holder part of the money the security holder paid for securities (s 241(3)(g))` TRUE TRUE)
#ASSERT `the court may make an order of the kind within s 241(3)` `an order varying or setting aside a transaction or contract to which the corporation is a party and compensating the corporation or any other party (s 241(3)(h))` TRUE FALSE
#ASSERT `the court may make an order of the kind within s 241(3)` `an order requiring the corporation to produce financial statements or an accounting to the court or an interested person within a time the court specifies (s 241(3)(i))` TRUE FALSE
#ASSERT `the court may make an order of the kind within s 241(3)` `an order compensating an aggrieved person (s 241(3)(j))` TRUE FALSE
#ASSERT `the court may make an order of the kind within s 241(3)` `an order directing rectification of the registers or other records of the corporation under section 243 (s 241(3)(k))` TRUE FALSE
#ASSERT `the court may make an order of the kind within s 241(3)` `an order liquidating and dissolving the corporation (s 241(3)(l))` TRUE FALSE
#ASSERT `the court may make an order of the kind within s 241(3)` `an order directing an investigation under Part XIX to be made (s 241(3)(m))` TRUE FALSE
#ASSERT `the court may make an order of the kind within s 241(3)` `an order requiring the trial of any issue (s 241(3)(n))` TRUE FALSE
#ASSERT `the court may make an order of the kind within s 241(3)` `any other interim or final order the court thinks fit (s 241(3))` TRUE FALSE
-- Not in connection with an application under s 241.
#ASSERT NOT (`the court may make an order of the kind within s 241(3)` `an order liquidating and dissolving the corporation (s 241(3)(l))` FALSE FALSE)
-- (4), (5), (7).
#ASSERT `the directors must forthwith comply with subsection 191(4) within s 241(4)(a)` TRUE
#ASSERT NOT (`the directors must forthwith comply with subsection 191(4) within s 241(4)(a)` FALSE)
#ASSERT `another amendment to the articles or by-laws is barred within s 241(4)(b)` TRUE FALSE FALSE
#ASSERT NOT (`another amendment to the articles or by-laws is barred within s 241(4)(b)` TRUE TRUE FALSE)
#ASSERT NOT (`another amendment to the articles or by-laws is barred within s 241(4)(b)` TRUE FALSE TRUE)
#ASSERT NOT (`another amendment to the articles or by-laws is barred within s 241(4)(b)` FALSE FALSE FALSE)
#ASSERT `a shareholder is not entitled to dissent under section 190 within s 241(5)` TRUE
#ASSERT NOT (`a shareholder is not entitled to dissent under section 190 within s 241(5)` FALSE)
#ASSERT `the applicant may apply in the alternative for an order under section 214 within s 241(7)` TRUE
#ASSERT NOT (`the applicant may apply in the alternative for an order under section 214 within s 241(7)` FALSE)
-- (6): a payment to a shareholder under (3)(f) or (g) is forbidden on either ground.
#ASSERT `the corporation must not make the payment within s 241(6)` TRUE TRUE FALSE
#ASSERT `the corporation must not make the payment within s 241(6)` TRUE FALSE TRUE
#ASSERT `the corporation must not make the payment within s 241(6)` TRUE TRUE TRUE
#ASSERT NOT (`the corporation must not make the payment within s 241(6)` TRUE FALSE FALSE)
-- Not a payment to a shareholder (for example to a holder of debt obligations only): not caught by the words.
#ASSERT NOT (`the corporation must not make the payment within s 241(6)` FALSE TRUE TRUE)

§§ `s 242 stays, discontinuances, costs`

#ASSERT NOT `an application or action under Part XX is stayed or dismissed by reason only of approval by the shareholders within s 242(1)`
#ASSERT `the court may take evidence of approval by the shareholders into account within s 242(1)` TRUE
#ASSERT NOT (`the court may take evidence of approval by the shareholders into account within s 242(1)` FALSE)
#ASSERT `the approval of the court is required for the step within s 242(2)` `a stay (s 242(2))` FALSE
#ASSERT `the approval of the court is required for the step within s 242(2)` `a discontinuance (s 242(2))` FALSE
#ASSERT `the approval of the court is required for the step within s 242(2)` `a settlement (s 242(2))` FALSE
#ASSERT `the approval of the court is required for the step within s 242(2)` `a dismissal for want of prosecution (s 242(2))` FALSE
#ASSERT `the approval of the court is required for the step within s 242(2)` `in Quebec, a dismissal for failure to respect the agreement between the parties as to the conduct of the proceeding (s 242(2))` TRUE
#ASSERT NOT (`the approval of the court is required for the step within s 242(2)` `in Quebec, a dismissal for failure to respect the agreement between the parties as to the conduct of the proceeding (s 242(2))` FALSE)
#ASSERT NOT (`the approval of the court is required for the step within s 242(2)` `any other step in the application or action (s 242(2))` TRUE)
#ASSERT `the court may order a party to give notice to the complainant within s 242(2)` TRUE
#ASSERT NOT (`the court may order a party to give notice to the complainant within s 242(2)` FALSE)
#ASSERT NOT `a complainant is required to give security for costs within s 242(3)`
#ASSERT `the court may order the corporation or its subsidiary to pay interim costs to the complainant within s 242(4)` TRUE
#ASSERT NOT (`the court may order the corporation or its subsidiary to pay interim costs to the complainant within s 242(4)` FALSE)
#ASSERT `the complainant may be held accountable for the interim costs within s 242(4)` TRUE TRUE
#ASSERT NOT (`the complainant may be held accountable for the interim costs within s 242(4)` TRUE FALSE)
#ASSERT NOT (`the complainant may be held accountable for the interim costs within s 242(4)` FALSE TRUE)

§§ `s 243 rectification of registers`

#ASSERT `may apply to a court for an order that the registers or records be rectified within s 243(1)` `the corporation` TRUE FALSE
#ASSERT `may apply to a court for an order that the registers or records be rectified within s 243(1)` `a security holder` TRUE FALSE
#ASSERT `may apply to a court for an order that the registers or records be rectified within s 243(1)` `a creditor` TRUE TRUE
#ASSERT NOT (`may apply to a court for an order that the registers or records be rectified within s 243(1)` `a creditor` TRUE FALSE)
#ASSERT NOT (`may apply to a court for an order that the registers or records be rectified within s 243(1)` `the corporation` FALSE FALSE)
#ASSERT `the applicant must give the Director notice within s 243(2)` TRUE
#ASSERT NOT (`the applicant must give the Director notice within s 243(2)` FALSE)
#ASSERT `the Director is entitled to appear and be heard within s 243(2)` TRUE
#ASSERT `the court may make an order of the kind within s 243(3)` `an order requiring the registers or other records of the corporation to be rectified (s 243(3)(a))` TRUE
#ASSERT `the court may make an order of the kind within s 243(3)` `an order restraining the corporation from calling or holding a meeting of shareholders or paying a dividend before rectification (s 243(3)(b))` TRUE
#ASSERT `the court may make an order of the kind within s 243(3)` `an order determining the right of a party to have their name entered or retained in, or deleted or omitted from, the registers or records (s 243(3)(c))` TRUE
#ASSERT `the court may make an order of the kind within s 243(3)` `an order compensating a party who has incurred a loss (s 243(3)(d))` TRUE
#ASSERT `the court may make an order of the kind within s 243(3)` `any other order the court thinks fit on an application to rectify records (s 243(3))` TRUE
#ASSERT NOT (`the court may make an order of the kind within s 243(3)` `an order compensating a party who has incurred a loss (s 243(3)(d))` FALSE)

§§ `s 244 directions; s 245 notice of refusal; s 246 appeal from the Director`

#ASSERT `the Director may apply to a court for directions within s 244` TRUE
#ASSERT NOT (`the Director may apply to a court for directions within s 244` FALSE)
-- 245(1): twenty days from receipt; with a later approval, twenty days from that. Received 1 March: last day 21 March.
#ASSERT `the last day for the Director to give written notice of the refusal within s 245(1)` (YearMonthDay 2026 3 1) NOTHING EQUALS YearMonthDay 2026 3 21
-- An approval received on 10 March under another Act: twenty days from it, 30 March, is later.
#ASSERT `the last day for the Director to give written notice of the refusal within s 245(1)` (YearMonthDay 2026 3 1) (JUST (YearMonthDay 2026 3 10)) EQUALS YearMonthDay 2026 3 30
-- An approval received before the articles (an earlier date): the twenty days from receipt of the articles still govern.
#ASSERT `the last day for the Director to give written notice of the refusal within s 245(1)` (YearMonthDay 2026 3 10) (JUST (YearMonthDay 2026 3 1)) EQUALS YearMonthDay 2026 3 30
-- Notice on the last day is in time; the day after is not.
#ASSERT `the Director has complied with the duty to give notice of the refusal within s 245(1)` TRUE (JUST (YearMonthDay 2026 3 21)) (YearMonthDay 2026 3 21)
#ASSERT NOT (`the Director has complied with the duty to give notice of the refusal within s 245(1)` TRUE (JUST (YearMonthDay 2026 3 22)) (YearMonthDay 2026 3 21))
#ASSERT NOT (`the Director has complied with the duty to give notice of the refusal within s 245(1)` TRUE NOTHING (YearMonthDay 2026 3 21))
-- No refusal, no duty.
#ASSERT `the Director has complied with the duty to give notice of the refusal within s 245(1)` FALSE NOTHING (YearMonthDay 2026 3 21)
-- 245(2): deemed refusal once the twenty days have passed with neither filing nor notice.
#ASSERT `the Director is deemed to have refused to file the document for the purposes of s 246 within s 245(2)` (YearMonthDay 2026 3 22) (YearMonthDay 2026 3 21) NOTHING NOTHING
#ASSERT NOT (`the Director is deemed to have refused to file the document for the purposes of s 246 within s 245(2)` (YearMonthDay 2026 3 21) (YearMonthDay 2026 3 21) NOTHING NOTHING)
-- Filed in time, or notice given in time: no deemed refusal.
#ASSERT NOT (`the Director is deemed to have refused to file the document for the purposes of s 246 within s 245(2)` (YearMonthDay 2026 3 22) (YearMonthDay 2026 3 21) (JUST (YearMonthDay 2026 3 20)) NOTHING)
#ASSERT NOT (`the Director is deemed to have refused to file the document for the purposes of s 246 within s 245(2)` (YearMonthDay 2026 3 22) (YearMonthDay 2026 3 21) NOTHING (JUST (YearMonthDay 2026 3 21)))
-- Filed or notified late: still deemed refused (the deeming happened on the day after the limit).
#ASSERT `the Director is deemed to have refused to file the document for the purposes of s 246 within s 245(2)` (YearMonthDay 2026 3 25) (YearMonthDay 2026 3 21) (JUST (YearMonthDay 2026 3 24)) NOTHING
#ASSERT `the Director is deemed to have refused to file the document for the purposes of s 246 within s 245(2)` (YearMonthDay 2026 3 25) (YearMonthDay 2026 3 21) NOTHING (JUST (YearMonthDay 2026 3 24))
-- s 246: nine kinds of decision may be appealed by a person who feels aggrieved.
#ASSERT `a person may apply to a court for an order on the decision within s 246` `a decision to refuse to file in the form submitted articles or another document required to be filed (s 246(a))` TRUE
#ASSERT `a person may apply to a court for an order on the decision within s 246` `a decision to give a name, to change or revoke a name, or to refuse to reserve, accept, change or revoke a name under section 12 (s 246(b))` TRUE
#ASSERT `a person may apply to a court for an order on the decision within s 246` `a decision to grant, or to refuse to grant, an exemption that may be granted under this Act and the regulations (s 246(c))` TRUE
#ASSERT `a person may apply to a court for an order on the decision within s 246` `a decision to refuse under subsection 187(11) to permit a continued reference to shares having a nominal or par value (s 246(d))` TRUE
#ASSERT `a person may apply to a court for an order on the decision within s 246` `a decision to refuse to issue a certificate of discontinuance under section 188 or a certificate attesting that the corporation exists under subsection 263.1(2) (s 246(e))` TRUE
#ASSERT `a person may apply to a court for an order on the decision within s 246` `a decision to issue, or to refuse to issue, a certificate of revival under section 209, or the terms for revival imposed by the Director (s 246(f))` TRUE
#ASSERT `a person may apply to a court for an order on the decision within s 246` `a decision to correct, or to refuse to correct, articles, a notice, a certificate or other document under section 265 (s 246(f.1))` TRUE
#ASSERT `a person may apply to a court for an order on the decision within s 246` `a decision to cancel, or to refuse to cancel, the articles and related certificate under section 265.1 (s 246(f.2))` TRUE
#ASSERT `a person may apply to a court for an order on the decision within s 246` `a decision to dissolve a corporation under section 212 (s 246(g))` TRUE
#ASSERT NOT (`a person may apply to a court for an order on the decision within s 246` `any other decision of the Director (s 246)` TRUE)
#ASSERT NOT (`a person may apply to a court for an order on the decision within s 246` `a decision to dissolve a corporation under section 212 (s 246(g))` FALSE)
#ASSERT `the court may make any order it thinks fit on the appeal within s 246` TRUE
#ASSERT NOT (`the court may make any order it thinks fit on the appeal within s 246` FALSE)

§§ `s 247 compliance order; s 248 summary application; s 249 appeals`

#ASSERT `may apply to a court for a compliance or restraining order within s 247` TRUE FALSE TRUE TRUE
#ASSERT `may apply to a court for a compliance or restraining order within s 247` FALSE TRUE TRUE TRUE
#ASSERT NOT (`may apply to a court for a compliance or restraining order within s 247` FALSE FALSE TRUE TRUE)
#ASSERT NOT (`may apply to a court for a compliance or restraining order within s 247` TRUE FALSE FALSE TRUE)
#ASSERT NOT (`may apply to a court for a compliance or restraining order within s 247` TRUE FALSE TRUE FALSE)
-- A complainant under s 238 composed with s 247: a former director is a complainant and so may apply.
#ASSERT `may apply to a court for a compliance or restraining order within s 247` (`complainant within s 238` FALSE TRUE FALSE FALSE) FALSE TRUE TRUE
#ASSERT `the application may be made in a summary manner within s 248` TRUE
#ASSERT NOT (`the application may be made in a summary manner within s 248` FALSE)
#ASSERT `whether an appeal lies within s 249` TRUE TRUE EQUALS `an appeal lies to the court of appeal of the province as of right (s 249(1))`
#ASSERT `whether an appeal lies within s 249` TRUE FALSE EQUALS `an appeal lies to the court of appeal of the province only with its leave (s 249(2))`
#ASSERT `whether an appeal lies within s 249` FALSE TRUE EQUALS `s 249 gives no appeal`
#ASSERT `whether an appeal lies within s 249` FALSE FALSE EQUALS `s 249 gives no appeal`
