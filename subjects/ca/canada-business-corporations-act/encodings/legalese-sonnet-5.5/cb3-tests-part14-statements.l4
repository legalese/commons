IMPORT prelude
IMPORT `cbca-core`
IMPORT `cb3-nouns`
IMPORT `cb3-part14-statements`

-- Tests of cb3-part14-statements.l4 (CBCA ss 155 to 160). Every expected value is written from the text of the
-- sections, quoted in the module; none is copied from the module's own output.

§ `Tests of Part XIV, the statements`


§§ `s 155(1)(a)(i) -- the first period`

-- arguments: the end of the last completed financial year if any, the date the corporation came into existence, the date the period began,
-- the date the period ended, the date of the annual meeting
-- no completed financial year: the period began on the date the corporation came into existence
#ASSERT `the first period of the statements is as s 155(1)(a)(i) requires within s 155(1)(a)(i)` NOTHING (YearMonthDay 2026 1 15) (YearMonthDay 2026 1 15) (YearMonthDay 2026 12 31) (YearMonthDay 2027 6 30)
-- ended not more than six months before the meeting: 31 December 2026 and 30 June 2027 is the last day; 1 July is too late
#ASSERT NOT `the first period of the statements is as s 155(1)(a)(i) requires within s 155(1)(a)(i)` NOTHING (YearMonthDay 2026 1 15) (YearMonthDay 2026 1 15) (YearMonthDay 2026 12 31) (YearMonthDay 2027 7 1)
#ASSERT NOT `the first period of the statements is as s 155(1)(a)(i) requires within s 155(1)(a)(i)` NOTHING (YearMonthDay 2026 1 15) (YearMonthDay 2026 1 16) (YearMonthDay 2026 12 31) (YearMonthDay 2027 6 30)
-- a completed financial year: the period began immediately after its end
#ASSERT `the first period of the statements is as s 155(1)(a)(i) requires within s 155(1)(a)(i)` (JUST (YearMonthDay 2026 12 31)) (YearMonthDay 2026 1 15) (YearMonthDay 2027 1 1) (YearMonthDay 2027 12 31) (YearMonthDay 2028 6 30)
#ASSERT NOT `the first period of the statements is as s 155(1)(a)(i) requires within s 155(1)(a)(i)` (JUST (YearMonthDay 2026 12 31)) (YearMonthDay 2026 1 15) (YearMonthDay 2026 12 31) (YearMonthDay 2027 12 31) (YearMonthDay 2028 6 30)
#ASSERT NOT `the first period of the statements is as s 155(1)(a)(i) requires within s 155(1)(a)(i)` (JUST (YearMonthDay 2026 12 31)) (YearMonthDay 2026 1 15) (YearMonthDay 2027 1 2) (YearMonthDay 2027 12 31) (YearMonthDay 2028 6 30)
#ASSERT NOT `the first period of the statements is as s 155(1)(a)(i) requires within s 155(1)(a)(i)` (JUST (YearMonthDay 2026 12 31)) (YearMonthDay 2026 1 15) (YearMonthDay 2026 1 15) (YearMonthDay 2027 12 31) (YearMonthDay 2028 6 30)
-- the period cannot end after the meeting
#ASSERT NOT `the first period of the statements is as s 155(1)(a)(i) requires within s 155(1)(a)(i)` NOTHING (YearMonthDay 2026 1 15) (YearMonthDay 2026 1 15) (YearMonthDay 2027 7 1) (YearMonthDay 2027 6 30)
-- no 31 February: six months after 31 August 2026 is 28 February 2027; after 31 August 2027 it is 29 February 2028
#ASSERT `the first period of the statements is as s 155(1)(a)(i) requires within s 155(1)(a)(i)` NOTHING (YearMonthDay 2026 1 15) (YearMonthDay 2026 1 15) (YearMonthDay 2026 8 31) (YearMonthDay 2027 2 28)
#ASSERT NOT `the first period of the statements is as s 155(1)(a)(i) requires within s 155(1)(a)(i)` NOTHING (YearMonthDay 2026 1 15) (YearMonthDay 2026 1 15) (YearMonthDay 2026 8 31) (YearMonthDay 2027 3 1)
#ASSERT `the first period of the statements is as s 155(1)(a)(i) requires within s 155(1)(a)(i)` NOTHING (YearMonthDay 2026 1 15) (YearMonthDay 2026 1 15) (YearMonthDay 2027 8 31) (YearMonthDay 2028 2 29)
#ASSERT NOT `the first period of the statements is as s 155(1)(a)(i) requires within s 155(1)(a)(i)` NOTHING (YearMonthDay 2026 1 15) (YearMonthDay 2026 1 15) (YearMonthDay 2027 8 31) (YearMonthDay 2028 3 1)

§§ `s 155(1)(a), (2) -- the comparative statements`

-- arguments: prescribed and conforming, relate to the period of (i), relate to the preceding financial year, the reason for omitting them is set out
#ASSERT `the statements placed are as s 155(1)(a) requires within s 155(1)(a)` TRUE TRUE TRUE FALSE
#ASSERT `the statements placed are as s 155(1)(a) requires within s 155(1)(a)` TRUE TRUE FALSE TRUE
-- (2): the preceding year may be omitted only with the reason set out
#ASSERT NOT `the statements placed are as s 155(1)(a) requires within s 155(1)(a)` TRUE TRUE FALSE FALSE
#ASSERT NOT `the statements placed are as s 155(1)(a) requires within s 155(1)(a)` FALSE TRUE TRUE FALSE
#ASSERT NOT `the statements placed are as s 155(1)(a) requires within s 155(1)(a)` TRUE FALSE TRUE FALSE
#ASSERT NOT `the statements placed are as s 155(1)(a) requires within s 155(1)(a)` TRUE FALSE FALSE TRUE

§§ `s 155(1) -- what is placed before the shareholders`

-- arguments: the statements are as (a) requires, the corporation has an auditor, the report is placed, the articles etc. require further information, it is placed
#ASSERT `the directors have complied with s 155(1) within s 155(1)` TRUE FALSE FALSE FALSE FALSE
#ASSERT `the directors have complied with s 155(1) within s 155(1)` TRUE TRUE TRUE FALSE FALSE
#ASSERT `the directors have complied with s 155(1) within s 155(1)` TRUE FALSE FALSE TRUE TRUE
#ASSERT NOT `the directors have complied with s 155(1) within s 155(1)` TRUE TRUE FALSE FALSE FALSE
#ASSERT NOT `the directors have complied with s 155(1) within s 155(1)` TRUE FALSE FALSE TRUE FALSE
#ASSERT NOT `the directors have complied with s 155(1) within s 155(1)` FALSE FALSE FALSE FALSE FALSE
#ASSERT `the directors have complied with s 155(1) within s 155(1)` TRUE TRUE TRUE TRUE TRUE

§§ `s 156 -- exemption`

-- arguments: the applicant is the corporation, the requirement is of s 155 or ss 157 to 160, a distributing corporation, the Director's belief about the shareholders, about the public
#ASSERT `the Director may exempt the corporation within s 156` TRUE TRUE FALSE TRUE FALSE
-- a corporation that is not distributing: the benefit weighed is the shareholders'
#ASSERT NOT `the Director may exempt the corporation within s 156` TRUE TRUE FALSE FALSE TRUE
-- a distributing corporation: the benefit weighed is the public's
#ASSERT `the Director may exempt the corporation within s 156` TRUE TRUE TRUE FALSE TRUE
#ASSERT NOT `the Director may exempt the corporation within s 156` TRUE TRUE TRUE TRUE FALSE
#ASSERT NOT `the Director may exempt the corporation within s 156` FALSE TRUE FALSE TRUE FALSE
#ASSERT NOT `the Director may exempt the corporation within s 156` TRUE FALSE FALSE TRUE FALSE

§§ `s 157 -- consolidated statements`

-- arguments: the body corporate is a subsidiary, its accounts are consolidated
#ASSERT `the corporation must keep a copy of the statements within s 157(1)` TRUE FALSE
#ASSERT `the corporation must keep a copy of the statements within s 157(1)` FALSE TRUE
#ASSERT `the corporation must keep a copy of the statements within s 157(1)` TRUE TRUE
#ASSERT NOT `the corporation must keep a copy of the statements within s 157(1)` FALSE FALSE
#ASSERT `the duty to keep a copy at the registered office is met within s 157(1)` TRUE TRUE
#ASSERT NOT `the duty to keep a copy at the registered office is met within s 157(1)` TRUE FALSE
#ASSERT `the duty to keep a copy at the registered office is met within s 157(1)` FALSE FALSE
-- (2) arguments: a shareholder or personal representative, requests, during the usual business hours, the court has barred the right
#ASSERT `a shareholder may examine the statements and make extracts free of charge within s 157(2)` TRUE TRUE TRUE FALSE
#ASSERT NOT `a shareholder may examine the statements and make extracts free of charge within s 157(2)` FALSE TRUE TRUE FALSE
#ASSERT NOT `a shareholder may examine the statements and make extracts free of charge within s 157(2)` TRUE FALSE TRUE FALSE
#ASSERT NOT `a shareholder may examine the statements and make extracts free of charge within s 157(2)` TRUE TRUE FALSE FALSE
#ASSERT NOT `a shareholder may examine the statements and make extracts free of charge within s 157(2)` TRUE TRUE TRUE TRUE
#ASSERT `the last day to apply to bar the examination within s 157(3)` (YearMonthDay 2027 3 1) EQUALS (YearMonthDay 2027 3 16)
-- fifteen days after 20 February 2027 is 7 March; after 20 February 2028 (a leap year) it is 6 March
#ASSERT `the last day to apply to bar the examination within s 157(3)` (YearMonthDay 2027 2 20) EQUALS (YearMonthDay 2027 3 7)
#ASSERT `the last day to apply to bar the examination within s 157(3)` (YearMonthDay 2028 2 20) EQUALS (YearMonthDay 2028 3 6)
-- arguments: the date of the request, the date the corporation applies
#ASSERT `the corporation may apply to the court within s 157(3)` (YearMonthDay 2027 3 1) (YearMonthDay 2027 3 16)
#ASSERT NOT `the corporation may apply to the court within s 157(3)` (YearMonthDay 2027 3 1) (YearMonthDay 2027 3 17)
#ASSERT `the corporation may apply to the court within s 157(3)` (YearMonthDay 2027 3 1) (YearMonthDay 2027 3 1)
-- arguments: the application was made within fifteen days, the court is satisfied the examination would be detrimental
#ASSERT `the court may bar the right to examine within s 157(3)` TRUE TRUE
#ASSERT NOT `the court may bar the right to examine within s 157(3)` TRUE FALSE
#ASSERT NOT `the court may bar the right to examine within s 157(3)` FALSE TRUE
#ASSERT `the corporation must give notice of the application within s 157(4)` TRUE
#ASSERT NOT `the corporation must give notice of the application within s 157(4)` FALSE
-- arguments: the duty, notice was given to the Director, to the person asking to examine
#ASSERT `the duty to give notice of the application is met within s 157(4)` TRUE TRUE TRUE
#ASSERT NOT `the duty to give notice of the application is met within s 157(4)` TRUE TRUE FALSE
#ASSERT NOT `the duty to give notice of the application is met within s 157(4)` TRUE FALSE TRUE
#ASSERT `the duty to give notice of the application is met within s 157(4)` FALSE FALSE FALSE
#ASSERT `the Director and the person may appear and be heard within s 157(4)` TRUE
#ASSERT NOT `the Director and the person may appear and be heard within s 157(4)` FALSE

§§ `s 158 -- approval`

-- arguments: the number of directors who signed manually, a facsimile of the signatures is reproduced in the statements
#ASSERT `the approval is evidenced as s 158(1) requires within s 158(1)` 1 FALSE
#ASSERT `the approval is evidenced as s 158(1) requires within s 158(1)` 2 FALSE
#ASSERT `the approval is evidenced as s 158(1) requires within s 158(1)` 0 TRUE
#ASSERT NOT `the approval is evidenced as s 158(1) requires within s 158(1)` 0 FALSE
-- arguments: the statements are approved and signed, the corporation has an auditor, the statements are accompanied by the report
#ASSERT `the condition for issuing copies is met within s 158(2)` TRUE FALSE FALSE
#ASSERT `the condition for issuing copies is met within s 158(2)` TRUE TRUE TRUE
#ASSERT NOT `the condition for issuing copies is met within s 158(2)` TRUE TRUE FALSE
#ASSERT NOT `the condition for issuing copies is met within s 158(2)` FALSE FALSE FALSE
#ASSERT NOT `the condition for issuing copies is met within s 158(2)` FALSE TRUE TRUE
-- arguments: the corporation issues copies, the condition is met
#ASSERT `issuing copies is prohibited within s 158(2)` TRUE FALSE
#ASSERT NOT `issuing copies is prohibited within s 158(2)` TRUE TRUE
#ASSERT NOT `issuing copies is prohibited within s 158(2)` FALSE FALSE

§§ `s 159 -- copies to shareholders`

#ASSERT `the corporation must send the documents to the shareholder within s 159(1)` FALSE
#ASSERT NOT `the corporation must send the documents to the shareholder within s 159(1)` TRUE
#ASSERT `the last day to send the documents to the shareholders within s 159(1)` (YearMonthDay 2027 6 30) EQUALS (YearMonthDay 2027 6 9)
-- twenty-one days before 10 March 2027 is 17 February; before 10 March 2028 (a leap year) it is 18 February
#ASSERT `the last day to send the documents to the shareholders within s 159(1)` (YearMonthDay 2027 3 10) EQUALS (YearMonthDay 2027 2 17)
#ASSERT `the last day to send the documents to the shareholders within s 159(1)` (YearMonthDay 2028 3 10) EQUALS (YearMonthDay 2028 2 18)
-- arguments: the date of the annual meeting or of the signing of the resolution in lieu, the date the documents were sent
#ASSERT `the documents were sent in time within s 159(1)` (YearMonthDay 2027 6 30) (YearMonthDay 2027 6 9)
#ASSERT `the documents were sent in time within s 159(1)` (YearMonthDay 2027 6 30) (YearMonthDay 2027 6 1)
#ASSERT NOT `the documents were sent in time within s 159(1)` (YearMonthDay 2027 6 30) (YearMonthDay 2027 6 10)
#ASSERT NOT `the documents were sent in time within s 159(1)` (YearMonthDay 2027 6 30) (YearMonthDay 2027 6 30)
-- (2) arguments: failed to comply with (1), without reasonable cause
#ASSERT `the corporation is guilty of an offence within s 159(2)` TRUE TRUE
#ASSERT NOT `the corporation is guilty of an offence within s 159(2)` TRUE FALSE
#ASSERT NOT `the corporation is guilty of an offence within s 159(2)` FALSE TRUE
#ASSERT (`the penalty ceiling within s 159(2)`)'s `maximum fine in dollars` EQUALS 5000
#ASSERT (`the penalty ceiling within s 159(2)`)'s `maximum imprisonment in months` EQUALS NOTHING

§§ `s 160 -- copies to the Director`

-- (2) arguments: the holding corporation's statements are consolidated and include the subsidiary, they are included in the documents it sent
#ASSERT `the subsidiary corporation is not required to comply with s 160 within s 160(2)` TRUE TRUE
#ASSERT NOT `the subsidiary corporation is not required to comply with s 160 within s 160(2)` TRUE FALSE
#ASSERT NOT `the subsidiary corporation is not required to comply with s 160 within s 160(2)` FALSE TRUE
-- (1) arguments: a distributing corporation, issued securities remain outstanding, the number of persons who hold them, the (2) exemption
#ASSERT `the corporation must send the documents to the Director within s 160(1)` TRUE TRUE 2 FALSE
#ASSERT `the corporation must send the documents to the Director within s 160(1)` TRUE TRUE 100 FALSE
#ASSERT NOT `the corporation must send the documents to the Director within s 160(1)` TRUE TRUE 1 FALSE
#ASSERT NOT `the corporation must send the documents to the Director within s 160(1)` FALSE TRUE 2 FALSE
#ASSERT NOT `the corporation must send the documents to the Director within s 160(1)` TRUE FALSE 2 FALSE
#ASSERT NOT `the corporation must send the documents to the Director within s 160(1)` TRUE TRUE 2 TRUE
-- (a) arguments: a resolution in lieu is signed, the date of the annual meeting, the date sent, without delay after the resolution was signed
#ASSERT `the documents were sent to the Director in time within s 160(1)(a)` FALSE (YearMonthDay 2027 6 30) (YearMonthDay 2027 6 9) FALSE
#ASSERT NOT `the documents were sent to the Director in time within s 160(1)(a)` FALSE (YearMonthDay 2027 6 30) (YearMonthDay 2027 6 10) FALSE
#ASSERT `the documents were sent to the Director in time within s 160(1)(a)` TRUE (YearMonthDay 2027 6 30) (YearMonthDay 2027 9 1) TRUE
#ASSERT NOT `the documents were sent to the Director in time within s 160(1)(a)` TRUE (YearMonthDay 2027 6 30) (YearMonthDay 2027 6 1) FALSE
-- (b) arguments: the date the last preceding annual meeting should have been held, the end of the preceding financial year
-- fifteen months after 31 May 2027 is 31 August 2028; six months after 31 December 2027 is 30 June 2028; the earlier governs
#ASSERT `the last day to send the documents to the Director within s 160(1)(b)` (YearMonthDay 2027 5 31) (YearMonthDay 2027 12 31) EQUALS (YearMonthDay 2028 6 30)
-- fifteen months after 31 January 2027 is 30 April 2028 (no 31 April); six months after 31 December 2027 is 30 June 2028
#ASSERT `the last day to send the documents to the Director within s 160(1)(b)` (YearMonthDay 2027 1 31) (YearMonthDay 2027 12 31) EQUALS (YearMonthDay 2028 4 30)
-- arguments: those two dates, the date the documents were sent
#ASSERT `the documents were sent to the Director in any event in time within s 160(1)(b)` (YearMonthDay 2027 5 31) (YearMonthDay 2027 12 31) (YearMonthDay 2028 6 30)
#ASSERT NOT `the documents were sent to the Director in any event in time within s 160(1)(b)` (YearMonthDay 2027 5 31) (YearMonthDay 2027 12 31) (YearMonthDay 2028 7 1)
#ASSERT `the documents were sent to the Director in any event in time within s 160(1)(b)` (YearMonthDay 2027 1 31) (YearMonthDay 2027 12 31) (YearMonthDay 2028 4 30)
#ASSERT NOT `the documents were sent to the Director in any event in time within s 160(1)(b)` (YearMonthDay 2027 1 31) (YearMonthDay 2027 12 31) (YearMonthDay 2028 5 1)
-- (3) arguments: the corporation must send, it failed to comply
#ASSERT `the corporation is guilty of an offence within s 160(3)` TRUE TRUE
#ASSERT NOT `the corporation is guilty of an offence within s 160(3)` TRUE FALSE
#ASSERT NOT `the corporation is guilty of an offence within s 160(3)` FALSE TRUE
#ASSERT (`the penalty ceiling within s 160(3)`)'s `maximum fine in dollars` EQUALS 5000
#ASSERT (`the penalty ceiling within s 160(3)`)'s `maximum imprisonment in months` EQUALS NOTHING
