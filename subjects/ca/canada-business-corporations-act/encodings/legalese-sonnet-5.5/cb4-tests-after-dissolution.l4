IMPORT prelude
IMPORT `cbca-core`
IMPORT `cbca-core-definitions`
IMPORT `cb4-common`
IMPORT `cb4-after-dissolution`

-- Tests of cb4-after-dissolution.l4 (ss 226 to 228). Expected values are written from the text of the
-- section named beside each group, before the run.

§ `Tests -- ss 226 to 228`

§§ `s 226`

#ASSERT (`whether a person is a shareholder within s 226(1)` `a shareholder, for the word shareholder in s 226(1)`) EQUALS JUST TRUE
#ASSERT (`whether a person is a shareholder within s 226(1)` `an heir of a shareholder`) EQUALS JUST TRUE
#ASSERT (`whether a person is a shareholder within s 226(1)` `a personal representative of a shareholder`) EQUALS JUST TRUE
#ASSERT (`whether a person is a shareholder within s 226(1)` `a person who is not a shareholder, an heir or a personal representative (s 226(1))`) EQUALS NOTHING
-- (2)(a)
#ASSERT `the action may be continued as if the body corporate had not been dissolved within s 226(2)(a)` TRUE TRUE
#ASSERT NOT (`the action may be continued as if the body corporate had not been dissolved within s 226(2)(a)` TRUE FALSE)
#ASSERT NOT (`the action may be continued as if the body corporate had not been dissolved within s 226(2)(a)` FALSE TRUE)
-- (2)(b): dissolved 1 August 2026: the last day is 1 August 2028.
#ASSERT (`the last day for an action to be brought against the dissolved body corporate within s 226(2)(b)` (YearMonthDay 2026 8 1)) EQUALS YearMonthDay 2028 8 1
#ASSERT `the action may be brought against the dissolved body corporate within s 226(2)(b)` (YearMonthDay 2026 8 1) (YearMonthDay 2028 8 1)
#ASSERT NOT (`the action may be brought against the dissolved body corporate within s 226(2)(b)` (YearMonthDay 2026 8 1) (YearMonthDay 2028 8 2))
#ASSERT `the action may be brought against the dissolved body corporate within s 226(2)(b)` (YearMonthDay 2026 8 1) (YearMonthDay 2026 8 1)
#ASSERT `the action may be brought against the dissolved body corporate within s 226(2)(b)` (YearMonthDay 2026 8 1) (YearMonthDay 2028 7 31)
-- (2)(c)
#ASSERT `the property remains available to satisfy the judgment or order within s 226(2)(c)` TRUE TRUE
#ASSERT NOT (`the property remains available to satisfy the judgment or order within s 226(2)(c)` TRUE FALSE)
#ASSERT NOT (`the property remains available to satisfy the judgment or order within s 226(2)(c)` FALSE TRUE)
-- (3), (3.1): permissive, so a person not named gets NOTHING and not FALSE.
#ASSERT (`whether service on a dissolved corporation is effected by serving this person within s 226(3)` TRUE) EQUALS JUST TRUE
#ASSERT (`whether service on a dissolved corporation is effected by serving this person within s 226(3)` FALSE) EQUALS NOTHING
#ASSERT (`whether service on a company dissolved by subsection 261(8) is effected by serving this person within s 226(3.1)` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`whether service on a company dissolved by subsection 261(8) is effected by serving this person within s 226(3.1)` TRUE FALSE) EQUALS NOTHING
#ASSERT (`whether service on a company dissolved by subsection 261(8) is effected by serving this person within s 226(3.1)` FALSE TRUE) EQUALS NOTHING
-- (4): the least of the claim and what was received.
#ASSERT (`the most the shareholder is liable to pay within s 226(4)` TRUE TRUE 1000 400) EQUALS 400
#ASSERT (`the most the shareholder is liable to pay within s 226(4)` TRUE TRUE 300 400) EQUALS 300
#ASSERT (`the most the shareholder is liable to pay within s 226(4)` TRUE TRUE 400 400) EQUALS 400
#ASSERT (`the most the shareholder is liable to pay within s 226(4)` FALSE TRUE 1000 400) EQUALS 0
#ASSERT (`the most the shareholder is liable to pay within s 226(4)` TRUE FALSE 1000 400) EQUALS 0
#ASSERT (`the last day for an action against a shareholder to be brought within s 226(4)` (YearMonthDay 2026 8 1)) EQUALS YearMonthDay 2028 8 1
#ASSERT `the action against a shareholder is brought in time within s 226(4)` (YearMonthDay 2026 8 1) (YearMonthDay 2028 8 1)
#ASSERT NOT (`the action against a shareholder is brought in time within s 226(4)` (YearMonthDay 2026 8 1) (YearMonthDay 2028 8 2))
-- (5)
#ASSERT `a court may order the action to be brought against the former shareholders as a class within s 226(5)` TRUE
#ASSERT NOT (`a court may order the action to be brought against the former shareholders as a class within s 226(5)` FALSE)
#ASSERT `the referee may add as a party each former shareholder found by the plaintiff within s 226(5)(a)` TRUE
#ASSERT NOT (`the referee may add as a party each former shareholder found by the plaintiff within s 226(5)(a)` FALSE)
#ASSERT `the referee may require this contribution within s 226(5)(b)` TRUE 400 400
#ASSERT `the referee may require this contribution within s 226(5)(b)` TRUE 400 399
#ASSERT NOT (`the referee may require this contribution within s 226(5)(b)` TRUE 400 401)
#ASSERT NOT (`the referee may require this contribution within s 226(5)(b)` FALSE 400 100)
#ASSERT `the referee may direct payment of the amounts determined within s 226(5)(c)` TRUE
#ASSERT NOT (`the referee may direct payment of the amounts determined within s 226(5)(c)` FALSE)

§§ `s 227`

#ASSERT `the portion must be converted into money and paid to the Receiver General within s 227(1)` TRUE TRUE
#ASSERT NOT (`the portion must be converted into money and paid to the Receiver General within s 227(1)` TRUE FALSE)
#ASSERT NOT (`the portion must be converted into money and paid to the Receiver General within s 227(1)` FALSE TRUE)
#ASSERT `the payment is deemed to satisfy the debt or claim within s 227(2)` TRUE
#ASSERT NOT (`the payment is deemed to satisfy the debt or claim within s 227(2)` FALSE)
#ASSERT `the Receiver General must pay the person out of the Consolidated Revenue Fund within s 227(3)` TRUE
#ASSERT NOT (`the Receiver General must pay the person out of the Consolidated Revenue Fund within s 227(3)` FALSE)
#ASSERT (`the amount the Receiver General pays within s 227(3)` 1250) EQUALS 1250
#ASSERT (`the amount the Receiver General pays within s 227(3)` 0) EQUALS 0

§§ `s 228`

#ASSERT `the property vests in Her Majesty in right of Canada within s 228(1)` TRUE TRUE FALSE FALSE
#ASSERT NOT (`the property vests in Her Majesty in right of Canada within s 228(1)` FALSE TRUE FALSE FALSE)
#ASSERT NOT (`the property vests in Her Majesty in right of Canada within s 228(1)` TRUE FALSE FALSE FALSE)
#ASSERT NOT (`the property vests in Her Majesty in right of Canada within s 228(1)` TRUE TRUE TRUE FALSE)
#ASSERT NOT (`the property vests in Her Majesty in right of Canada within s 228(1)` TRUE TRUE FALSE TRUE)
#ASSERT `the property is returned to the corporation within s 228(2)` TRUE TRUE TRUE TRUE
#ASSERT NOT (`the property is returned to the corporation within s 228(2)` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`the property is returned to the corporation within s 228(2)` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`the property is returned to the corporation within s 228(2)` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`the property is returned to the corporation within s 228(2)` TRUE TRUE TRUE FALSE)
#ASSERT (`the amount paid to the corporation under s 228(2)(a)` TRUE 900) EQUALS 900
#ASSERT (`the amount paid to the corporation under s 228(2)(a)` FALSE 900) EQUALS 0
-- (b): the lesser of value at vesting and what was realized.
#ASSERT (`the amount paid to the corporation under s 228(2)(b)` TRUE TRUE 700 500) EQUALS 500
#ASSERT (`the amount paid to the corporation under s 228(2)(b)` TRUE TRUE 500 700) EQUALS 500
#ASSERT (`the amount paid to the corporation under s 228(2)(b)` TRUE TRUE 600 600) EQUALS 600
#ASSERT (`the amount paid to the corporation under s 228(2)(b)` TRUE FALSE 700 500) EQUALS 0
#ASSERT (`the amount paid to the corporation under s 228(2)(b)` FALSE TRUE 700 500) EQUALS 0
