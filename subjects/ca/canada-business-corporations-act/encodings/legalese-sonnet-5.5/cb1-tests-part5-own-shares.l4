IMPORT prelude
IMPORT `cbca-core`
IMPORT `cb1-nouns`
IMPORT `cb1-part5-own-shares`

-- Tests of cb1-part5-own-shares.l4 (s 30 to s 37). Expected values are written from the text of the Act
-- (src:523-599), never from the code's output: each comment says what the text gives.

§ `Tests -- Part V a corporation's own shares`

§§ `s 30`

-- src:524: held only under an exception
#ASSERT `the corporation may hold shares in itself or in its holding body corporate within s 30(1)(a)` TRUE FALSE FALSE
#ASSERT `the corporation may hold shares in itself or in its holding body corporate within s 30(1)(a)` FALSE TRUE FALSE
#ASSERT `the corporation may hold shares in itself or in its holding body corporate within s 30(1)(a)` FALSE FALSE TRUE
#ASSERT NOT (`the corporation may hold shares in itself or in its holding body corporate within s 30(1)(a)` FALSE FALSE FALSE)
-- src:525
#ASSERT `the corporation may permit a subsidiary body corporate to acquire shares of the corporation within s 30(1)(b)` TRUE FALSE
#ASSERT `the corporation may permit a subsidiary body corporate to acquire shares of the corporation within s 30(1)(b)` FALSE TRUE
#ASSERT NOT (`the corporation may permit a subsidiary body corporate to acquire shares of the corporation within s 30(1)(b)` FALSE FALSE)
-- src:527-529: five years from the later of the two dates (fork cb1-F8). A subsidiary since 1 March 2026, never continued:
#ASSERT `the last day for the subsidiary to dispose of the shares within s 30(2)` FALSE (YMD 2026 3 1) NOTHING EQUALS JUST (YMD 2031 3 1)
-- ... continued on 1 June 2026, after it became a subsidiary: five years from 1 June 2026
#ASSERT `the last day for the subsidiary to dispose of the shares within s 30(2)` FALSE (YMD 2026 3 1) (JUST (YMD 2026 6 1)) EQUALS JUST (YMD 2031 6 1)
-- ... continued on 1 January 2025, before it became a subsidiary: five years from becoming a subsidiary
#ASSERT `the last day for the subsidiary to dispose of the shares within s 30(2)` FALSE (YMD 2026 3 1) (JUST (YMD 2025 1 1)) EQUALS JUST (YMD 2031 3 1)
-- "Subject to section 31": no duty to dispose where section 31 permits the holding
#ASSERT `the last day for the subsidiary to dispose of the shares within s 30(2)` TRUE (YMD 2026 3 1) NOTHING EQUALS NOTHING

