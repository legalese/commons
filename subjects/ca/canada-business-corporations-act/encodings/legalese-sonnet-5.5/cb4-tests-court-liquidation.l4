IMPORT prelude
IMPORT `cbca-core`
IMPORT `cbca-core-definitions`
IMPORT `cb4-common`
IMPORT `cb4-court-liquidation`

-- Tests of cb4-court-liquidation.l4 (ss 214 to 220). Expected values are written from the text of the
-- section named beside each group, before the run.

§ `Tests -- ss 214 to 220`

§§ `s 214`

-- (1)(a): any one of the three routes is enough.
#ASSERT `the court is satisfied of oppression within s 214(1)(a)` TRUE FALSE FALSE
#ASSERT `the court is satisfied of oppression within s 214(1)(a)` FALSE TRUE FALSE
#ASSERT `the court is satisfied of oppression within s 214(1)(a)` FALSE FALSE TRUE
#ASSERT NOT (`the court is satisfied of oppression within s 214(1)(a)` FALSE FALSE FALSE)
-- (1)(b): the agreement AND the event, or just and equitable.
#ASSERT `the court is satisfied of a ground within s 214(1)(b)` TRUE TRUE FALSE
#ASSERT NOT (`the court is satisfied of a ground within s 214(1)(b)` TRUE FALSE FALSE)
#ASSERT NOT (`the court is satisfied of a ground within s 214(1)(b)` FALSE TRUE FALSE)
#ASSERT `the court is satisfied of a ground within s 214(1)(b)` FALSE FALSE TRUE
#ASSERT `the court is satisfied of a ground within s 214(1)(b)` TRUE FALSE TRUE
-- the whole subsection: a shareholder, plus either (a) or (b).
#ASSERT `a court may order the liquidation and dissolution of the corporation or an affiliate within s 214(1)` TRUE TRUE FALSE
#ASSERT `a court may order the liquidation and dissolution of the corporation or an affiliate within s 214(1)` TRUE FALSE TRUE
#ASSERT NOT (`a court may order the liquidation and dissolution of the corporation or an affiliate within s 214(1)` TRUE FALSE FALSE)
#ASSERT NOT (`a court may order the liquidation and dissolution of the corporation or an affiliate within s 214(1)` FALSE TRUE TRUE)
#ASSERT `the court may make an order under section 214 or section 241 within s 214(2)` TRUE
#ASSERT NOT (`the court may make an order under section 214 or section 241 within s 214(2)` FALSE)
#ASSERT `section 242 applies to the application within s 214(3)` TRUE
#ASSERT NOT (`section 242 applies to the application within s 214(3)` FALSE)

§§ `s 215, s 216`

#ASSERT `the application for supervision complies with s 215(1)` TRUE TRUE
#ASSERT NOT (`the application for supervision complies with s 215(1)` TRUE FALSE)
#ASSERT NOT (`the application for supervision complies with s 215(1)` FALSE TRUE)
#ASSERT `the liquidation and dissolution continues under the supervision of the court within s 215(2)` TRUE
#ASSERT NOT (`the liquidation and dissolution continues under the supervision of the court within s 215(2)` FALSE)
#ASSERT `the application under s 214(1) complies with s 216(1)` TRUE TRUE
#ASSERT NOT (`the application under s 214(1) complies with s 216(1)` TRUE FALSE)
#ASSERT NOT (`the application under s 214(1) complies with s 216(1)` FALSE TRUE)
#ASSERT `the court may order the corporation and persons interested to show cause within s 216(2)` TRUE
#ASSERT NOT (`the court may order the corporation and persons interested to show cause within s 216(2)` FALSE)
-- order dated 1 March 2026: four weeks is 28 days, the last day is 29 March; 30 March is a day too late.
#ASSERT (`the last day for the show cause time within s 216(2)` (YMD 2026 3 1)) EQUALS YMD 2026 3 29
#ASSERT `the time specified for showing cause is within four weeks after the order within s 216(2)` (YMD 2026 3 1) (YMD 2026 3 29)
#ASSERT NOT (`the time specified for showing cause is within four weeks after the order within s 216(2)` (YMD 2026 3 1) (YMD 2026 3 30))
#ASSERT `the time specified for showing cause is within four weeks after the order within s 216(2)` (YMD 2026 3 1) (YMD 2026 3 2)
#ASSERT `the court may order the directors and officers to furnish all material information within s 216(3)` TRUE
#ASSERT NOT (`the court may order the directors and officers to furnish all material information within s 216(3)` FALSE)
-- "including": a named kind is within the order though not otherwise called material; both need to be known.
#ASSERT `the information is within the order the court may make within s 216(3)` TRUE FALSE TRUE
#ASSERT `the information is within the order the court may make within s 216(3)` FALSE TRUE TRUE
#ASSERT NOT (`the information is within the order the court may make within s 216(3)` FALSE FALSE TRUE)
#ASSERT NOT (`the information is within the order the court may make within s 216(3)` TRUE TRUE FALSE)
#ASSERT `the order under s 216(2) has been published and served as s 216(4) requires` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`the order under s 216(2) has been published and served as s 216(4) requires` FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`the order under s 216(2) has been published and served as s 216(4) requires` TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`the order under s 216(2) has been published and served as s 216(4) requires` TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`the order under s 216(2) has been published and served as s 216(4) requires` TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`the order under s 216(2) has been published and served as s 216(4) requires` TRUE TRUE TRUE TRUE FALSE)
#ASSERT `publication and service are effected by the right person in the right manner within s 216(5)` TRUE FALSE TRUE
#ASSERT `publication and service are effected by the right person in the right manner within s 216(5)` FALSE TRUE TRUE
#ASSERT NOT (`publication and service are effected by the right person in the right manner within s 216(5)` FALSE FALSE TRUE)
#ASSERT NOT (`publication and service are effected by the right person in the right manner within s 216(5)` TRUE FALSE FALSE)

§§ `s 217`

#ASSERT `the court may make an order under the opening words of s 217` TRUE TRUE
#ASSERT NOT (`the court may make an order under the opening words of s 217` TRUE FALSE)
#ASSERT NOT (`the court may make an order under the opening words of s 217` FALSE TRUE)
-- an unconditional paragraph: the gate alone.
#ASSERT `the court may make this kind of order within s 217` `an order to liquidate (s 217(a))` TRUE FALSE FALSE FALSE FALSE FALSE
#ASSERT NOT (`the court may make this kind of order within s 217` `an order to liquidate (s 217(a))` FALSE TRUE TRUE TRUE TRUE TRUE)
#ASSERT `the court may make this kind of order within s 217` `an order disposing of any property belonging to creditors or shareholders who cannot be found (s 217(m))` TRUE FALSE FALSE FALSE FALSE FALSE
#ASSERT `the court may make this kind of order within s 217` `any other order the court thinks fit under s 217` TRUE FALSE FALSE FALSE FALSE FALSE
-- (j): creditor, inspectors or liquidator applies.
#ASSERT `the court may make this kind of order within s 217` `an order giving directions on a matter arising in the liquidation (s 217(j))` TRUE TRUE FALSE FALSE FALSE FALSE
#ASSERT NOT (`the court may make this kind of order within s 217` `an order giving directions on a matter arising in the liquidation (s 217(j))` TRUE FALSE TRUE TRUE TRUE TRUE)
-- (k): notice to all interested parties.
#ASSERT `the court may make this kind of order within s 217` `an order relieving a liquidator from an omission or default and confirming an act of the liquidator (s 217(k))` TRUE FALSE TRUE FALSE FALSE FALSE
#ASSERT NOT (`the court may make this kind of order within s 217` `an order relieving a liquidator from an omission or default and confirming an act of the liquidator (s 217(k))` TRUE TRUE FALSE TRUE TRUE TRUE)
-- (l): subject to s 223.
#ASSERT `the court may make this kind of order within s 217` `an order approving a proposed interim or final distribution to shareholders in money or in property (s 217(l))` TRUE FALSE FALSE TRUE FALSE FALSE
#ASSERT NOT (`the court may make this kind of order within s 217` `an order approving a proposed interim or final distribution to shareholders in money or in property (s 217(l))` TRUE TRUE TRUE FALSE TRUE TRUE)
-- (n): director, officer, security holder, creditor or liquidator applies.
#ASSERT `the court may make this kind of order within s 217` `an order staying the liquidation, continuing or discontinuing the liquidation proceedings, or directing the liquidator to restore the remaining property to the corporation (s 217(n))` TRUE FALSE FALSE FALSE TRUE FALSE
#ASSERT NOT (`the court may make this kind of order within s 217` `an order staying the liquidation, continuing or discontinuing the liquidation proceedings, or directing the liquidator to restore the remaining property to the corporation (s 217(n))` TRUE TRUE TRUE TRUE FALSE TRUE)
-- (o): after the final account.
#ASSERT `the court may make this kind of order within s 217` `an order dissolving the corporation after the liquidator's final account (s 217(o))` TRUE FALSE FALSE FALSE FALSE TRUE
#ASSERT NOT (`the court may make this kind of order within s 217` `an order dissolving the corporation after the liquidator's final account (s 217(o))` TRUE TRUE TRUE TRUE TRUE FALSE)
-- the gate fails: nothing is permitted, even an unconditional paragraph with every condition met.
#ASSERT NOT (`the court may make this kind of order within s 217` `an order dissolving the corporation after the liquidator's final account (s 217(o))` FALSE FALSE FALSE FALSE FALSE TRUE)

§§ `ss 218 to 220`

-- order made 1 June 2026: the liquidation commences on that day.
#ASSERT `the liquidation has commenced on a day within s 218` (YMD 2026 6 1) (YMD 2026 6 1)
#ASSERT NOT (`the liquidation has commenced on a day within s 218` (YMD 2026 6 1) (YMD 2026 5 31))
#ASSERT `the corporation may carry on the business within s 219(1)(a)` FALSE FALSE
#ASSERT `the corporation may carry on the business within s 219(1)(a)` TRUE TRUE
#ASSERT NOT (`the corporation may carry on the business within s 219(1)(a)` TRUE FALSE)
#ASSERT `the corporation continues in existence within s 219(1)(a)` TRUE
#ASSERT NOT (`the corporation continues in existence within s 219(1)(a)` FALSE)
#ASSERT `the powers of the directors and shareholders cease and vest in the liquidator within s 219(1)(b)` TRUE FALSE
#ASSERT NOT (`the powers of the directors and shareholders cease and vest in the liquidator within s 219(1)(b)` TRUE TRUE)
#ASSERT NOT (`the powers of the directors and shareholders cease and vest in the liquidator within s 219(1)(b)` FALSE FALSE)
#ASSERT `the liquidator may delegate the power within s 219(2)` TRUE TRUE
#ASSERT NOT (`the liquidator may delegate the power within s 219(2)` TRUE FALSE)
#ASSERT NOT (`the liquidator may delegate the power within s 219(2)` FALSE TRUE)
#ASSERT `the court may appoint a person as liquidator within s 220(1)` TRUE
#ASSERT NOT (`the court may appoint a person as liquidator within s 220(1)` FALSE)
#ASSERT `the property of the corporation is under the control of the court within s 220(2)` TRUE TRUE
#ASSERT NOT (`the property of the corporation is under the control of the court within s 220(2)` TRUE FALSE)
#ASSERT NOT (`the property of the corporation is under the control of the court within s 220(2)` FALSE TRUE)
