-- src:3401 | (t) subsection 99(1) (weapons trafficking);
-- src:3402 | (u) subsection 100(1) (possession for purpose of weapons trafficking);
-- src:3403 | (v) subsection 101(1) (transfer without authority);
-- src:3404 | (w) subsection 103(1) (importing or exporting knowing it is unauthorized);
-- src:3405 | (x) subsection 104(1) (unauthorized importing or exporting);
-- src:3406 | (y) subsection 119(1) (bribery of judicial officers, etc.);
