§§ `s 152 -- the proxyholder`

#ASSERT `the proxyholder must attend and comply with the directions within s 152(1)` TRUE TRUE
#ASSERT NOT `the proxyholder must attend and comply with the directions within s 152(1)` TRUE FALSE
#ASSERT NOT `the proxyholder must attend and comply with the directions within s 152(1)` FALSE TRUE
