#ASSERT NOT `the copy to the Director complies with s 150(2)` TRUE FALSE (YMD 2027 5 1) (YMD 2027 5 2) TRUE TRUE TRUE FALSE
#ASSERT NOT `the copy to the Director complies with s 150(2)` TRUE FALSE (YMD 2027 5 1) (YMD 2027 5 1) FALSE TRUE TRUE FALSE
#ASSERT NOT `the copy to the Director complies with s 150(2)` TRUE FALSE (YMD 2027 5 1) (YMD 2027 5 1) TRUE FALSE TRUE FALSE
#ASSERT NOT `the copy to the Director complies with s 150(2)` TRUE FALSE (YMD 2027 5 1) (YMD 2027 5 1) TRUE TRUE FALSE FALSE
#ASSERT `the copy to the Director complies with s 150(2)` FALSE TRUE (YMD 2027 5 1) (YMD 2027 5 9) FALSE FALSE FALSE FALSE
-- (3) arguments: failed to comply with (1), with (2)
#ASSERT `a person is guilty of an offence within s 150(3)` TRUE FALSE
#ASSERT `a person is guilty of an offence within s 150(3)` FALSE TRUE
#ASSERT `a person is guilty of an offence within s 150(3)` TRUE TRUE
#ASSERT NOT `a person is guilty of an offence within s 150(3)` FALSE FALSE
#ASSERT (`the penalty ceiling within s 150(3)`)'s `maximum fine in dollars` EQUALS 5000
#ASSERT (`the penalty ceiling within s 150(3)`)'s `maximum imprisonment in months` EQUALS JUST 6
