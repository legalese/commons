#ASSERT NOT `the duty to attend and comply with the directions is met within s 152(1)` TRUE FALSE FALSE TRUE
#ASSERT NOT `the duty to attend and comply with the directions is met within s 152(1)` TRUE TRUE FALSE FALSE
#ASSERT `the duty to attend and comply with the directions is met within s 152(1)` FALSE FALSE FALSE FALSE
#ASSERT `a proxyholder has the shareholder's right to speak within s 152(2)` TRUE
#ASSERT NOT `a proxyholder has the shareholder's right to speak within s 152(2)` FALSE
#ASSERT `a proxyholder has the shareholder's right to vote by ballot within s 152(2)` TRUE
#ASSERT NOT `a proxyholder has the shareholder's right to vote by ballot within s 152(2)` FALSE
-- arguments: the person is a proxyholder or alternate, has conflicting instructions from more than one shareholder
#ASSERT `a proxyholder has the shareholder's right to vote by a show of hands within s 152(2)` TRUE FALSE
#ASSERT NOT `a proxyholder has the shareholder's right to vote by a show of hands within s 152(2)` TRUE TRUE
#ASSERT NOT `a proxyholder has the shareholder's right to vote by a show of hands within s 152(2)` FALSE FALSE
-- (3)(a) arguments: the chairperson declares, the fraction of the votes required to be voted against, a shareholder or proxyholder demands a ballot
#ASSERT `the chairperson may conduct the vote by a show of hands within s 152(3)(a)` TRUE 0.04 FALSE
#ASSERT `the chairperson may conduct the vote by a show of hands within s 152(3)(a)` TRUE 0.049 FALSE
-- "less than five per cent": exactly five per cent is not less
#ASSERT NOT `the chairperson may conduct the vote by a show of hands within s 152(3)(a)` TRUE 0.05 FALSE
#ASSERT NOT `the chairperson may conduct the vote by a show of hands within s 152(3)(a)` FALSE 0.01 FALSE
#ASSERT NOT `the chairperson may conduct the vote by a show of hands within s 152(3)(a)` TRUE 0.04 TRUE
-- (3)(b) arguments: the chairperson may conduct by a show of hands, the person is a proxyholder
#ASSERT `a proxyholder may vote by a show of hands within s 152(3)(b)` TRUE TRUE
#ASSERT NOT `a proxyholder may vote by a show of hands within s 152(3)(b)` TRUE FALSE
#ASSERT NOT `a proxyholder may vote by a show of hands within s 152(3)(b)` FALSE TRUE
-- (4) arguments: a proxyholder, failed to comply with the directions, without reasonable cause
#ASSERT `a proxyholder is guilty of an offence within s 152(4)` TRUE TRUE TRUE
#ASSERT NOT `a proxyholder is guilty of an offence within s 152(4)` FALSE TRUE TRUE
#ASSERT NOT `a proxyholder is guilty of an offence within s 152(4)` TRUE FALSE TRUE
#ASSERT NOT `a proxyholder is guilty of an offence within s 152(4)` TRUE TRUE FALSE
#ASSERT (`the penalty ceiling within s 152(4)`)'s `maximum fine in dollars` EQUALS 5000
#ASSERT (`the penalty ceiling within s 152(4)`)'s `maximum imprisonment in months` EQUALS JUST 6

