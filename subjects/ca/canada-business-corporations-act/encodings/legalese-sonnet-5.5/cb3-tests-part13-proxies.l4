IMPORT prelude
IMPORT `cbca-core`
IMPORT `cb3-nouns`
IMPORT `cb3-part13-proxies`

-- Tests of cb3-part13-proxies.l4 (CBCA ss 147 to 154). Every expected value is written from the text of the
-- sections, quoted in the module; none is copied from the module's own output.

§ `Tests of Part XIII, proxies`


§§ `s 147 -- form of proxy and proxy`

#ASSERT `form of proxy within s 147` TRUE TRUE
#ASSERT NOT `form of proxy within s 147` TRUE FALSE
#ASSERT NOT `form of proxy within s 147` FALSE TRUE
#ASSERT `proxy within s 147` TRUE TRUE TRUE
#ASSERT NOT `proxy within s 147` FALSE TRUE TRUE
#ASSERT NOT `proxy within s 147` TRUE FALSE TRUE
#ASSERT NOT `proxy within s 147` TRUE TRUE FALSE

§§ `s 147 -- intermediary`

-- arguments: holds a security for another who is not the registered holder, then paragraphs (a) broker or dealer, (b) depositary,
-- (c) financial institution, (d) clearing agency's counterparty, (e) plan trustee, (f) nominee of (a) to (e), (g) similar functions, and (g) holds in its name for another
#ASSERT NOT `intermediary within s 147` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE
#ASSERT `intermediary within s 147` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE
#ASSERT `intermediary within s 147` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE
#ASSERT `intermediary within s 147` FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE
#ASSERT `intermediary within s 147` FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE
#ASSERT `intermediary within s 147` FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE
#ASSERT `intermediary within s 147` FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE
#ASSERT `intermediary within s 147` FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE
-- (g) needs both the similar functions and the holding in its own name
#ASSERT NOT `intermediary within s 147` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE
#ASSERT NOT `intermediary within s 147` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE
#ASSERT `intermediary within s 147` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE

§§ `s 147 -- solicit or solicitation`

-- the inclusions: arguments (a)(i) a request for a proxy, (ii) a request to execute or revoke, (iii) a communication calculated to procure,
-- (iv) the sending of a form of proxy under s 149
#ASSERT `act within the inclusions of solicit within s 147` TRUE FALSE FALSE FALSE
#ASSERT `act within the inclusions of solicit within s 147` FALSE TRUE FALSE FALSE
#ASSERT `act within the inclusions of solicit within s 147` FALSE FALSE TRUE FALSE
#ASSERT `act within the inclusions of solicit within s 147` FALSE FALSE FALSE TRUE
#ASSERT NOT `act within the inclusions of solicit within s 147` FALSE FALSE FALSE FALSE
-- the exclusions: arguments (b)(i) unsolicited request, (ii) administrative or professional services, (iii) the intermediary's documents,
-- (iv) beneficial owner, (v) public announcement, (vi) obtaining shares for a proposal, (vii) prescribed communication
#ASSERT `act within the exclusions of solicit within s 147` TRUE FALSE FALSE FALSE FALSE FALSE FALSE
#ASSERT `act within the exclusions of solicit within s 147` FALSE TRUE FALSE FALSE FALSE FALSE FALSE
#ASSERT `act within the exclusions of solicit within s 147` FALSE FALSE TRUE FALSE FALSE FALSE FALSE
#ASSERT `act within the exclusions of solicit within s 147` FALSE FALSE FALSE TRUE FALSE FALSE FALSE
#ASSERT `act within the exclusions of solicit within s 147` FALSE FALSE FALSE FALSE TRUE FALSE FALSE
#ASSERT `act within the exclusions of solicit within s 147` FALSE FALSE FALSE FALSE FALSE TRUE FALSE
#ASSERT `act within the exclusions of solicit within s 147` FALSE FALSE FALSE FALSE FALSE FALSE TRUE
#ASSERT NOT `act within the exclusions of solicit within s 147` FALSE FALSE FALSE FALSE FALSE FALSE FALSE
-- arguments: within the inclusions, within the exclusions; an act in neither is not decided by the definition
#ASSERT `solicitation within s 147` TRUE FALSE EQUALS JUST TRUE
#ASSERT `solicitation within s 147` FALSE FALSE EQUALS NOTHING
-- an excluded act is not a solicitation, even one that is also within the inclusions
#ASSERT `solicitation within s 147` TRUE TRUE EQUALS JUST FALSE
#ASSERT `solicitation within s 147` FALSE TRUE EQUALS JUST FALSE
-- by or on behalf of the management; arguments: a solicitation by any person, pursuant to a resolution or instructions, with the acquiescence
#ASSERT `solicitation by or on behalf of the management of a corporation within s 147` TRUE TRUE FALSE
#ASSERT `solicitation by or on behalf of the management of a corporation within s 147` TRUE FALSE TRUE
#ASSERT `solicitation by or on behalf of the management of a corporation within s 147` TRUE TRUE TRUE
#ASSERT NOT `solicitation by or on behalf of the management of a corporation within s 147` TRUE FALSE FALSE
#ASSERT NOT `solicitation by or on behalf of the management of a corporation within s 147` FALSE TRUE TRUE

§§ `s 148 -- proxies`

#ASSERT `a shareholder may appoint a proxyholder within s 148(1)` TRUE TRUE
#ASSERT NOT `a shareholder may appoint a proxyholder within s 148(1)` TRUE FALSE
#ASSERT NOT `a shareholder may appoint a proxyholder within s 148(1)` FALSE TRUE
-- arguments: executed by the shareholder, executed by the personal representative, the representative is authorized in writing
#ASSERT `the proxy is executed as s 148(2) requires within s 148(2)` TRUE FALSE FALSE
#ASSERT `the proxy is executed as s 148(2) requires within s 148(2)` FALSE TRUE TRUE
#ASSERT `the proxy is executed as s 148(2) requires within s 148(2)` TRUE TRUE FALSE
#ASSERT NOT `the proxy is executed as s 148(2) requires within s 148(2)` FALSE TRUE FALSE
#ASSERT NOT `the proxy is executed as s 148(2) requires within s 148(2)` FALSE FALSE FALSE
#ASSERT NOT `the proxy is executed as s 148(2) requires within s 148(2)` FALSE FALSE TRUE
-- arguments: the meeting for which the proxy is given, an adjournment of it
#ASSERT `the proxy is valid at the meeting within s 148(3)` TRUE FALSE
#ASSERT `the proxy is valid at the meeting within s 148(3)` FALSE TRUE
#ASSERT NOT `the proxy is valid at the meeting within s 148(3)` FALSE FALSE
-- arguments: the instrument is executed by the shareholder or the authorized representative, the date it was deposited at the registered office,
-- the last business day preceding the day of the meeting, deposited with the chairman on the day, revoked in any other manner permitted by law
-- up to and including the last business day
#ASSERT `the proxy is revoked within s 148(4)` TRUE (JUST (YMD 2027 6 10)) (YMD 2027 6 10) FALSE FALSE
#ASSERT `the proxy is revoked within s 148(4)` TRUE (JUST (YMD 2027 6 9)) (YMD 2027 6 10) FALSE FALSE
#ASSERT NOT `the proxy is revoked within s 148(4)` TRUE (JUST (YMD 2027 6 11)) (YMD 2027 6 10) FALSE FALSE
-- with the chairman on the day of the meeting
#ASSERT `the proxy is revoked within s 148(4)` TRUE NOTHING (YMD 2027 6 10) TRUE FALSE
#ASSERT NOT `the proxy is revoked within s 148(4)` TRUE NOTHING (YMD 2027 6 10) FALSE FALSE
-- late at the registered office, but with the chairman: either place is enough
#ASSERT `the proxy is revoked within s 148(4)` TRUE (JUST (YMD 2027 6 11)) (YMD 2027 6 10) TRUE FALSE
-- the instrument must be executed
#ASSERT NOT `the proxy is revoked within s 148(4)` FALSE (JUST (YMD 2027 6 1)) (YMD 2027 6 10) FALSE FALSE
#ASSERT NOT `the proxy is revoked within s 148(4)` FALSE NOTHING (YMD 2027 6 10) TRUE FALSE
-- (b) any other manner permitted by law
#ASSERT `the proxy is revoked within s 148(4)` FALSE NOTHING (YMD 2027 6 10) FALSE TRUE
-- arguments: the time is specified in a notice calling the meeting, the hours before the meeting excluding Saturdays and holidays
#ASSERT `the directors may specify the time for depositing proxies within s 148(5)` TRUE 48
#ASSERT `the directors may specify the time for depositing proxies within s 148(5)` TRUE 0
#ASSERT `the directors may specify the time for depositing proxies within s 148(5)` TRUE 24
#ASSERT NOT `the directors may specify the time for depositing proxies within s 148(5)` TRUE 49
#ASSERT NOT `the directors may specify the time for depositing proxies within s 148(5)` FALSE 24

§§ `s 149 -- mandatory solicitation`

-- (2) arguments: the corporation is a distributing corporation, the number of shareholders entitled to vote with joint holders counted as one
#ASSERT `management is not required to send a form of proxy within s 149(2)` FALSE 50
#ASSERT `management is not required to send a form of proxy within s 149(2)` FALSE 1
#ASSERT NOT `management is not required to send a form of proxy within s 149(2)` FALSE 51
#ASSERT NOT `management is not required to send a form of proxy within s 149(2)` TRUE 10
#ASSERT NOT `management is not required to send a form of proxy within s 149(2)` TRUE 100
-- (1) arguments: management is not required under (2)
#ASSERT `management must send a form of proxy within s 149(1)` FALSE
#ASSERT NOT `management must send a form of proxy within s 149(1)` TRUE
-- arguments: the duty, the date the notice was given, the date the form was sent, in the prescribed form, sent to each shareholder entitled to notice
#ASSERT `the duty to send a form of proxy is met within s 149(1)` TRUE (YMD 2027 5 1) (YMD 2027 5 1) TRUE TRUE
-- concurrently: the same day, not the day before or after
#ASSERT NOT `the duty to send a form of proxy is met within s 149(1)` TRUE (YMD 2027 5 1) (YMD 2027 5 2) TRUE TRUE
#ASSERT NOT `the duty to send a form of proxy is met within s 149(1)` TRUE (YMD 2027 5 1) (YMD 2027 4 30) TRUE TRUE
#ASSERT NOT `the duty to send a form of proxy is met within s 149(1)` TRUE (YMD 2027 5 1) (YMD 2027 5 1) FALSE TRUE
#ASSERT NOT `the duty to send a form of proxy is met within s 149(1)` TRUE (YMD 2027 5 1) (YMD 2027 5 1) TRUE FALSE
#ASSERT `the duty to send a form of proxy is met within s 149(1)` FALSE (YMD 2027 5 1) (YMD 2027 5 9) FALSE FALSE
-- (3) arguments: the duty, the management failed to comply, the failure was without reasonable cause
#ASSERT `the corporation is guilty of an offence within s 149(3)` TRUE TRUE TRUE
#ASSERT NOT `the corporation is guilty of an offence within s 149(3)` TRUE TRUE FALSE
#ASSERT NOT `the corporation is guilty of an offence within s 149(3)` TRUE FALSE TRUE
#ASSERT NOT `the corporation is guilty of an offence within s 149(3)` FALSE TRUE TRUE
#ASSERT (`the penalty ceiling within s 149(3)`)'s `maximum fine in dollars` EQUALS 5000
#ASSERT (`the penalty ceiling within s 149(3)`)'s `maximum imprisonment in months` EQUALS NOTHING
-- (4) arguments: the corporation commits an offence under (3), the person is a director or officer, knowingly authorized, permitted or acquiesced
#ASSERT `a director or officer is a party to and guilty of the offence within s 149(4)` TRUE TRUE TRUE
#ASSERT NOT `a director or officer is a party to and guilty of the offence within s 149(4)` FALSE TRUE TRUE
#ASSERT NOT `a director or officer is a party to and guilty of the offence within s 149(4)` TRUE FALSE TRUE
#ASSERT NOT `a director or officer is a party to and guilty of the offence within s 149(4)` TRUE TRUE FALSE
#ASSERT (`the penalty ceiling within s 149(4)`)'s `maximum fine in dollars` EQUALS 5000
#ASSERT (`the penalty ceiling within s 149(4)`)'s `maximum imprisonment in months` EQUALS JUST 6

§§ `s 150 -- soliciting proxies`

-- arguments: the solicitation is by the management, a management proxy circular is sent, a dissident's proxy circular is sent,
