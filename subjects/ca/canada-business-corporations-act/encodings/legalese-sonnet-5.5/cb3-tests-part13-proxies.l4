#ASSERT NOT `a director or officer of a body corporate is a party to and guilty of the offence within s 150(4)` FALSE TRUE TRUE
#ASSERT NOT `a director or officer of a body corporate is a party to and guilty of the offence within s 150(4)` TRUE FALSE TRUE
