#ASSERT `trustee within s 82(1)` FALSE TRUE
#ASSERT NOT (`trustee within s 82(1)` FALSE FALSE)
-- args: specified in a trust indenture; (a) security interest becomes enforceable; (b) moneys become or may be declared payable before maturity; all prescribed conditions satisfied
#ASSERT `event of default within s 82(1)` TRUE TRUE FALSE TRUE
#ASSERT `event of default within s 82(1)` TRUE FALSE TRUE TRUE
#ASSERT `event of default within s 82(1)` TRUE TRUE TRUE TRUE
#ASSERT NOT (`event of default within s 82(1)` TRUE FALSE FALSE TRUE)
#ASSERT NOT (`event of default within s 82(1)` TRUE TRUE TRUE FALSE)
#ASSERT NOT (`event of default within s 82(1)` FALSE TRUE TRUE TRUE)

