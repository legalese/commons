IMPORT prelude
IMPORT `cbca-core`
IMPORT `cb1-nouns`
IMPORT `cb1-part5-capital-dividends`

-- Tests of cb1-part5-capital-dividends.l4 (s 38 to s 45). Expected values are written from the text of the
-- Act (src:601-667), never from the code's output: each comment says what the text gives.

§ `Tests -- Part V reducing stated capital, adjustments, dividends`

GIVEN a IS A BOOLEAN
      b IS A NUMBER
      c IS A NUMBER
      d IS A NUMBER
      e IS A BOOLEAN
GIVETH A `Facts for a solvency test in Part V`
`solvency facts` a b c d e MEANS
    `Facts for a solvency test in Part V` WITH
        `reasonable grounds exist for believing that the corporation is, or would after the step be, unable to pay its liabilities as they become due` IS a
        `realizable value of the corporation's assets after the step, in dollars` IS b
        `liabilities of the corporation, in dollars` IS c
        `stated capital of all classes, in dollars` IS d
        `amount required, on a redemption or in a liquidation, to pay the holders of shares that must be paid before the shares to be acquired and not included in the liabilities, in dollars` IS 0
        `amount required, on a redemption or in a liquidation, to pay the holders of shares that must be paid rateably with or before the shares to be acquired and not included in the liabilities, in dollars` IS 0
        `the corporation is an open-end mutual fund` IS e

DECIDE `a passing tally` IS `Vote tally` WITH
    `votes cast in favour` IS 67
    `votes cast against` IS 33
    `signed by all the shareholders entitled to vote on the resolution` IS FALSE

DECIDE `a failing tally` IS `Vote tally` WITH
    `votes cast in favour` IS 66
    `votes cast against` IS 34
    `signed by all the shareholders entitled to vote on the resolution` IS FALSE

§§ `s 38`

-- src:608-610: no reduction for any purpose but (1)(c) if reasonable grounds for believing a shortfall; no stated capital term
#ASSERT NOT (`the corporation is forbidden to reduce its stated capital within s 38(3)` `extinguishing or reducing a liability in respect of an amount unpaid on any share` (`solvency facts` FALSE 500 500 400 FALSE))
#ASSERT `the corporation is forbidden to reduce its stated capital within s 38(3)` `extinguishing or reducing a liability in respect of an amount unpaid on any share` (`solvency facts` FALSE 499 500 400 FALSE)
#ASSERT `the corporation is forbidden to reduce its stated capital within s 38(3)` `distributing to the holder of an issued share of any class or series of shares an amount not exceeding the stated capital of the class or series` (`solvency facts` TRUE 5000 500 400 FALSE)
#ASSERT `the corporation is forbidden to reduce its stated capital within s 38(3)` `any other purpose` (`solvency facts` FALSE 499 500 400 FALSE)
-- the purpose of paragraph (1)(c) (stated capital not represented by realizable assets) is outside the limit, whatever the figures
#ASSERT NOT (`the corporation is forbidden to reduce its stated capital within s 38(3)` `declaring its stated capital to be reduced by an amount that is not represented by realizable assets` (`solvency facts` TRUE 0 500 400 FALSE))
-- src:601: by special resolution, subject to (3). Two thirds of 100 votes cast is 66.67: 67 passes, 66 does not.
#ASSERT `the corporation may reduce its stated capital within s 38(1)` `a passing tally` FALSE
#ASSERT NOT (`the corporation may reduce its stated capital within s 38(1)` `a failing tally` FALSE)
#ASSERT NOT (`the corporation may reduce its stated capital within s 38(1)` `a passing tally` TRUE)
-- src:603: not exceeding the stated capital of the class or series
#ASSERT `the distribution is within the limit of s 38(1)(b)` 400 400
#ASSERT NOT (`the distribution is within the limit of s 38(1)(b)` 401 400)
-- src:606
#ASSERT `the special resolution has the contents s 38(2) requires` TRUE
#ASSERT NOT (`the special resolution has the contents s 38(2) requires` FALSE)
-- src:612-614
#ASSERT `the creditor is entitled to apply to a court for the order within s 38(4)` `an order compelling a shareholder to pay to the corporation an amount equal to any liability of the shareholder that was extinguished or reduced contrary to section 38` TRUE TRUE
#ASSERT `the creditor is entitled to apply to a court for the order within s 38(4)` `an order compelling a shareholder or other recipient to pay or deliver to the corporation any money or property that was paid or distributed as a consequence of a reduction of capital made contrary to section 38` TRUE TRUE
#ASSERT NOT (`the creditor is entitled to apply to a court for the order within s 38(4)` `any other order` TRUE TRUE)
#ASSERT NOT (`the creditor is entitled to apply to a court for the order within s 38(4)` `an order compelling a shareholder to pay to the corporation an amount equal to any liability of the shareholder that was extinguished or reduced contrary to section 38` FALSE TRUE)
#ASSERT NOT (`the creditor is entitled to apply to a court for the order within s 38(4)` `an order compelling a shareholder to pay to the corporation an amount equal to any liability of the shareholder that was extinguished or reduced contrary to section 38` TRUE FALSE)
-- src:616: two years from the date of the act complained of (1 March 2026): the last day is 1 March 2028
#ASSERT `the last day to commence an action to enforce a liability imposed by section 38 within s 38(5)` (YMD 2026 3 1) EQUALS YMD 2028 3 1
#ASSERT `the action to enforce a liability imposed by section 38 is in time within s 38(5)` (YMD 2026 3 1) (YMD 2028 3 1)
#ASSERT NOT (`the action to enforce a liability imposed by section 38 is in time within s 38(5)` (YMD 2026 3 1) (YMD 2028 3 2))

§§ `s 39`

-- src:619: stated capital 1,000; 25 of 100 issued shares acquired: deduct 250
#ASSERT `the amount to deduct from the stated capital account on an acquisition within s 39(1)` 1000 25 100 EQUALS JUST 250
#ASSERT `the amount to deduct from the stated capital account on an acquisition within s 39(1)` 1000 0 100 EQUALS JUST 0
#ASSERT `the amount to deduct from the stated capital account on an acquisition within s 39(1)` 1000 25 0 EQUALS NOTHING
-- src:621
#ASSERT `the balance of the stated capital account after the payment within s 39(2)` 1000 300 EQUALS 700
-- src:623
#ASSERT `the corporation must adjust its stated capital accounts in accordance with the special resolution within s 39(3)` TRUE
#ASSERT NOT (`the corporation must adjust its stated capital accounts in accordance with the special resolution within s 39(3)` FALSE)
-- src:626-627: deduct 250 from the old account and add 250 plus the additional consideration to the new
#ASSERT `the amount to deduct on a conversion or change within s 39(4)(a)` 1000 25 100 EQUALS JUST 250
#ASSERT `the amount to add on a conversion or change within s 39(4)(b)` (JUST 250) 40 EQUALS JUST 290
#ASSERT `the amount to add on a conversion or change within s 39(4)(b)` NOTHING 40 EQUALS NOTHING
-- src:629: two classes each convertible into the other: the aggregate stated capital over the aggregate number of shares
#ASSERT `the corporation has two classes of convertible shares referred to in s 39(5)` TRUE TRUE
#ASSERT NOT (`the corporation has two classes of convertible shares referred to in s 39(5)` TRUE FALSE)
#ASSERT NOT (`the corporation has two classes of convertible shares referred to in s 39(5)` FALSE TRUE)
#ASSERT `the stated capital attributable to a share in either class within s 39(5)` FALSE 600 400 60 40 EQUALS JUST 10
-- "subject to its articles": the articles provide otherwise
#ASSERT `the stated capital attributable to a share in either class within s 39(5)` TRUE 600 400 60 40 EQUALS NOTHING
#ASSERT `the stated capital attributable to a share in either class within s 39(5)` FALSE 0 0 0 0 EQUALS NOTHING
-- src:631: cancelled or, if the articles limit the authorized shares, may be restored
#ASSERT `what becomes of the acquired shares within s 39(6)` TRUE EQUALS `the shares must be cancelled or may be restored to the status of authorized but unissued shares of the class`
#ASSERT `what becomes of the acquired shares within s 39(6)` FALSE EQUALS `the shares must be cancelled`
-- src:633
#ASSERT `the corporation is deemed not to have purchased, redeemed or otherwise acquired the shares for the purposes of s 39 within s 39(7)` TRUE
#ASSERT NOT (`the corporation is deemed not to have purchased, redeemed or otherwise acquired the shares for the purposes of s 39 within s 39(7)` FALSE)
-- src:635-638: shares still held at the expiration of two years are deemed acquired then (acquired 1 March 2026, deemed 1 March 2028)
#ASSERT `the day the shares are deemed to have been acquired within s 39(8)` TRUE (YMD 2026 3 1) TRUE EQUALS JUST (YMD 2028 3 1)
#ASSERT `the day the shares are deemed to have been acquired within s 39(8)` TRUE (YMD 2026 3 1) FALSE EQUALS NOTHING
#ASSERT `the day the shares are deemed to have been acquired within s 39(8)` FALSE (YMD 2026 3 1) TRUE EQUALS NOTHING
-- src:640
#ASSERT `the shares become issued shares of the class or series into which they were converted or changed within s 39(9)` TRUE
#ASSERT NOT (`the shares become issued shares of the class or series into which they were converted or changed within s 39(9)` FALSE)
-- src:642: unissued shares of the first class increase by the number that became shares of another class, unless the articles otherwise provide
#ASSERT `the number of unissued shares of the first class after the change within s 39(10)` TRUE FALSE 200 50 EQUALS JUST 250
#ASSERT `the number of unissued shares of the first class after the change within s 39(10)` TRUE TRUE 200 50 EQUALS NOTHING
#ASSERT `the number of unissued shares of the first class after the change within s 39(10)` FALSE FALSE 200 50 EQUALS NOTHING
-- src:644: repaying the indebtedness does not redeem the debt obligations by itself
#ASSERT NOT (`the debt obligations are redeemed within s 39(11)` TRUE FALSE)
#ASSERT `the debt obligations are redeemed within s 39(11)` TRUE TRUE
-- src:646
#ASSERT `the corporation may reissue, pledge or hypothecate the acquired debt obligations within s 39(12)` FALSE
#ASSERT NOT (`the corporation may reissue, pledge or hypothecate the acquired debt obligations within s 39(12)` TRUE)
#ASSERT NOT (`the acquisition and reissue, pledge or hypothecation is a cancellation of the debt obligations within s 39(12)` TRUE)

§§ `s 40 and s 41`

-- src:648
#ASSERT `the corporation must fulfil its obligations under the contract to buy shares within s 40(1)` FALSE
#ASSERT NOT (`the corporation must fulfil its obligations under the contract to buy shares within s 40(1)` TRUE)
-- src:650: subordinate to creditors and to holders of a class with prior rights; ahead of other shareholders
#ASSERT `the claimant ranks in priority to the person in a liquidation within s 40(2)` `a creditor of the corporation` EQUALS JUST FALSE
#ASSERT `the claimant ranks in priority to the person in a liquidation within s 40(2)` `a holder of a class of shares whose rights were in priority to the rights given to the holders of the class of shares being purchased` EQUALS JUST FALSE
#ASSERT `the claimant ranks in priority to the person in a liquidation within s 40(2)` `a holder of any other shares` EQUALS JUST TRUE
#ASSERT `the claimant ranks in priority to the person in a liquidation within s 40(2)` `any other person` EQUALS NOTHING
#ASSERT `the other party is entitled to be paid within s 40(2)` FALSE TRUE
#ASSERT NOT (`the other party is entitled to be paid within s 40(2)` FALSE FALSE)
#ASSERT NOT (`the other party is entitled to be paid within s 40(2)` TRUE TRUE)
-- src:652
#ASSERT `the directors may authorize the corporation to pay the commission within s 41` TRUE TRUE
#ASSERT NOT (`the directors may authorize the corporation to pay the commission within s 41` FALSE TRUE)
#ASSERT NOT (`the directors may authorize the corporation to pay the commission within s 41` TRUE FALSE)

§§ `s 42 and s 43`

-- src:654-656: assets against liabilities plus stated capital of all classes; 1,000 against 600 plus 400 is not less
#ASSERT NOT (`the corporation is forbidden to declare or pay a dividend within s 42` (`solvency facts` FALSE 1000 600 400 FALSE))
#ASSERT `the corporation is forbidden to declare or pay a dividend within s 42` (`solvency facts` FALSE 999 600 400 FALSE)
#ASSERT `the corporation is forbidden to declare or pay a dividend within s 42` (`solvency facts` TRUE 5000 600 400 FALSE)
-- an open-end mutual fund: stated capital term nil (fork cb1-F9)
#ASSERT NOT (`the corporation is forbidden to declare or pay a dividend within s 42` (`solvency facts` FALSE 600 600 400 TRUE))
#ASSERT `the corporation is forbidden to declare or pay a dividend within s 42` (`solvency facts` FALSE 599 600 400 TRUE)
-- src:658: shares, money or property, subject to s 42 (fork cb1-F10: s 42 reaches a share dividend as well)
#ASSERT `the corporation may pay the dividend in that form within s 43(1)` `by issuing fully paid shares of the corporation` FALSE
#ASSERT `the corporation may pay the dividend in that form within s 43(1)` `in money` FALSE
#ASSERT `the corporation may pay the dividend in that form within s 43(1)` `in property` FALSE
#ASSERT NOT (`the corporation may pay the dividend in that form within s 43(1)` `in money` TRUE)
#ASSERT NOT (`the corporation may pay the dividend in that form within s 43(1)` `by issuing fully paid shares of the corporation` TRUE)
#ASSERT NOT (`the corporation may pay the dividend in that form within s 43(1)` `any other form` FALSE)
-- src:660
#ASSERT `the amount to add to the stated capital account for the class or series issued within s 43(2)` TRUE 500 EQUALS JUST 500
#ASSERT `the amount to add to the stated capital account for the class or series issued within s 43(2)` FALSE 500 EQUALS NOTHING

§§ `s 45`

-- src:663: not liable as shareholders, except under s 38(4), 118(4) or (5), 146(5) or 226(4) or (5)
#ASSERT `section 45(1) shields the shareholder from the liability within s 45(1)` `as a shareholder only`
#ASSERT NOT (`section 45(1) shields the shareholder from the liability within s 45(1)` `under subsection 38(4)`)
#ASSERT NOT (`section 45(1) shields the shareholder from the liability within s 45(1)` `under subsection 118(4) or (5)`)
#ASSERT NOT (`section 45(1) shields the shareholder from the liability within s 45(1)` `under subsection 146(5)`)
#ASSERT NOT (`section 45(1) shields the shareholder from the liability within s 45(1)` `under subsection 226(4) or (5)`)
-- src:665, 667
#ASSERT `the articles may provide that the corporation has a lien or hypothec on the share within s 45(2)` TRUE TRUE FALSE
#ASSERT NOT (`the articles may provide that the corporation has a lien or hypothec on the share within s 45(2)` FALSE TRUE FALSE)
#ASSERT NOT (`the articles may provide that the corporation has a lien or hypothec on the share within s 45(2)` TRUE FALSE FALSE)
#ASSERT NOT (`the articles may provide that the corporation has a lien or hypothec on the share within s 45(2)` TRUE TRUE TRUE)
#ASSERT `the corporation may enforce the lien or hypothec within s 45(3)` TRUE TRUE
#ASSERT NOT (`the corporation may enforce the lien or hypothec within s 45(3)` TRUE FALSE)
#ASSERT NOT (`the corporation may enforce the lien or hypothec within s 45(3)` FALSE TRUE)
