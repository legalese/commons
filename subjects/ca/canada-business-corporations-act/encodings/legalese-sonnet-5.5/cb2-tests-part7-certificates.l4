IMPORT prelude
IMPORT `cbca-core`
IMPORT `cb2-nouns`
IMPORT `cb2-part7-certificates`

-- Tests of cb2-part7-certificates.l4 (s 49). Every expected value is written from the text of the
-- provision named beside it, not from the output of the rule.

§ `Tests of s 49`

§§ `s 49(1): the holder's option`
-- args: a security holder, opts for a certificate
#ASSERT `what the corporation must give the security holder at their option within s 49(1)` TRUE TRUE EQUALS (JUST `a security certificate that complies with the Act`)
#ASSERT `what the corporation must give the security holder at their option within s 49(1)` TRUE FALSE EQUALS (JUST `a non-transferable written acknowledgment of the right to obtain a security certificate`)
-- not covered: a person who is not a security holder is given nothing by s 49(1)
#ASSERT `what the corporation must give the security holder at their option within s 49(1)` FALSE TRUE EQUALS NOTHING
#ASSERT `what the corporation must give the security holder at their option within s 49(1)` FALSE FALSE EQUALS NOTHING

§§ `s 49(2): the fee, not exceeding the prescribed amount`
-- args: issued in respect of a transfer, the fee, the prescribed maximum
#ASSERT `the corporation may charge the fee within s 49(2)` TRUE 50 50 EQUALS (JUST TRUE)
#ASSERT `the corporation may charge the fee within s 49(2)` TRUE 49.99 50 EQUALS (JUST TRUE)
#ASSERT `the corporation may charge the fee within s 49(2)` TRUE 50.01 50 EQUALS (JUST FALSE)
-- not covered: a certificate not issued in respect of a transfer
#ASSERT `the corporation may charge the fee within s 49(2)` FALSE 10 50 EQUALS NOTHING

§§ `s 49(3): joint holders`
#ASSERT `the corporation need not issue more than one security certificate within s 49(3)` TRUE
#ASSERT NOT (`the corporation need not issue more than one security certificate within s 49(3)` FALSE)
#ASSERT `delivery to one joint holder is sufficient delivery to all within s 49(3)` TRUE TRUE
#ASSERT NOT (`delivery to one joint holder is sufficient delivery to all within s 49(3)` TRUE FALSE)
#ASSERT NOT (`delivery to one joint holder is sufficient delivery to all within s 49(3)` FALSE TRUE)

§§ `s 49(4): signatures, any one of the three suffices`
#ASSERT `a security certificate is signed as required within s 49(4)` TRUE FALSE FALSE
#ASSERT `a security certificate is signed as required within s 49(4)` FALSE TRUE FALSE
#ASSERT `a security certificate is signed as required within s 49(4)` FALSE FALSE TRUE
#ASSERT NOT (`a security certificate is signed as required within s 49(4)` FALSE FALSE FALSE)

§§ `s 49(6): continuation of signature`
-- args: carries a printed or mechanical signature of a person
#ASSERT `the corporation may issue the certificate within s 49(6)` TRUE
#ASSERT NOT (`the corporation may issue the certificate within s 49(6)` FALSE)
-- args: carries a printed or mechanical signature of a person, the person has ceased to be director or officer
#ASSERT `the signature is treated as that of a director or officer at the date of issue within s 49(6)` TRUE TRUE
#ASSERT NOT (`the signature is treated as that of a director or officer at the date of issue within s 49(6)` TRUE FALSE)
#ASSERT NOT (`the signature is treated as that of a director or officer at the date of issue within s 49(6)` FALSE TRUE)

§§ `s 49(7): what the face of a share certificate states`
#ASSERT `a share certificate states what it must on its face within s 49(7)` TRUE TRUE TRUE TRUE
#ASSERT NOT (`a share certificate states what it must on its face within s 49(7)` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`a share certificate states what it must on its face within s 49(7)` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`a share certificate states what it must on its face within s 49(7)` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`a share certificate states what it must on its face within s 49(7)` TRUE TRUE TRUE FALSE)

§§ `s 49(8): restrictions are ineffective against a transferee without knowledge unless noted`
-- args: issued by a corporation or pre-continuance body corporate, kind of item, transferee knows, noted conspicuously
#ASSERT `the item is ineffective against the transferee within s 49(8)` TRUE `a restriction on transfer other than a constraint under section 174` FALSE FALSE
#ASSERT `the item is ineffective against the transferee within s 49(8)` TRUE `a charge, lien or hypothec in favour of the corporation` FALSE FALSE
#ASSERT `the item is ineffective against the transferee within s 49(8)` TRUE `a unanimous shareholder agreement as an item under s 49(8)` FALSE FALSE
#ASSERT `the item is ineffective against the transferee within s 49(8)` TRUE `an endorsement under subsection 190(10)` FALSE FALSE
-- noted conspicuously: s 49(8) does not make it ineffective
#ASSERT NOT (`the item is ineffective against the transferee within s 49(8)` TRUE `a restriction on transfer other than a constraint under section 174` FALSE TRUE)
-- the transferee has actual knowledge: s 49(8) does not make it ineffective
#ASSERT NOT (`the item is ineffective against the transferee within s 49(8)` TRUE `a restriction on transfer other than a constraint under section 174` TRUE FALSE)
-- a constraint under s 174 is carved out of paragraph (a)
#ASSERT NOT (`the item is ineffective against the transferee within s 49(8)` TRUE `a constraint under section 174 as an item under s 49(8)` FALSE FALSE)
#ASSERT NOT (`the item is ineffective against the transferee within s 49(8)` TRUE `an item of none of these kinds under s 49(8)` FALSE FALSE)
-- a security not issued by a corporation or by a body corporate before it was continued
#ASSERT NOT (`the item is ineffective against the transferee within s 49(8)` FALSE `a charge, lien or hypothec in favour of the corporation` FALSE FALSE)

§§ `s 49(9): limit on restriction`
-- args: distributing corporation, issued shares outstanding held by more than one person, restriction is a permitted s 174 constraint
#ASSERT `the corporation may have the restriction on transfer or ownership within s 49(9)` TRUE TRUE TRUE EQUALS (JUST TRUE)
#ASSERT `the corporation may have the restriction on transfer or ownership within s 49(9)` TRUE TRUE FALSE EQUALS (JUST FALSE)
-- not covered: not a distributing corporation, or all the shares are held by one person
#ASSERT `the corporation may have the restriction on transfer or ownership within s 49(9)` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `the corporation may have the restriction on transfer or ownership within s 49(9)` TRUE FALSE FALSE EQUALS NOTHING

§§ `s 49(10): notation of a constraint, on a certificate issued AFTER the day the share became subject to it`
-- args: purpose (a), purpose (b), certificate evidences a constrained share, day issued, day the share became subject
#ASSERT `the constraint must be noted conspicuously on the certificate within s 49(10)` TRUE FALSE TRUE (YearMonthDay 2026 1 2) (YearMonthDay 2026 1 1)
#ASSERT `the constraint must be noted conspicuously on the certificate within s 49(10)` FALSE TRUE TRUE (YearMonthDay 2026 1 2) (YearMonthDay 2026 1 1)
-- issued on the very day the share became subject: not "after"
#ASSERT NOT (`the constraint must be noted conspicuously on the certificate within s 49(10)` TRUE FALSE TRUE (YearMonthDay 2026 1 1) (YearMonthDay 2026 1 1))
#ASSERT NOT (`the constraint must be noted conspicuously on the certificate within s 49(10)` TRUE FALSE TRUE (YearMonthDay 2025 12 31) (YearMonthDay 2026 1 1))
#ASSERT NOT (`the constraint must be noted conspicuously on the certificate within s 49(10)` FALSE FALSE TRUE (YearMonthDay 2026 1 2) (YearMonthDay 2026 1 1))
#ASSERT NOT (`the constraint must be noted conspicuously on the certificate within s 49(10)` TRUE TRUE FALSE (YearMonthDay 2026 1 2) (YearMonthDay 2026 1 1))

§§ `s 49(11): failure to note`
#ASSERT `the failure to note invalidates a share or certificate or makes the constraint ineffective within s 49(11)` TRUE EQUALS (JUST FALSE)
#ASSERT `the failure to note invalidates a share or certificate or makes the constraint ineffective within s 49(11)` FALSE EQUALS NOTHING

§§ `s 49(12): "private company"`
#ASSERT `the words "private company" are deemed notice of a restriction, lien, hypothec, agreement or endorsement within s 49(12)` TRUE TRUE TRUE
#ASSERT NOT (`the words "private company" are deemed notice of a restriction, lien, hypothec, agreement or endorsement within s 49(12)` FALSE TRUE TRUE)
#ASSERT NOT (`the words "private company" are deemed notice of a restriction, lien, hypothec, agreement or endorsement within s 49(12)` TRUE FALSE TRUE)
#ASSERT NOT (`the words "private company" are deemed notice of a restriction, lien, hypothec, agreement or endorsement within s 49(12)` TRUE TRUE FALSE)

§§ `s 49(13) and (14): particulars of class, and the duty to furnish them`
-- args: more than one class or series, states (a), states (b)
#ASSERT `a share certificate gives the particulars of the class or series within s 49(13)` FALSE FALSE FALSE
#ASSERT `a share certificate gives the particulars of the class or series within s 49(13)` TRUE TRUE FALSE
#ASSERT `a share certificate gives the particulars of the class or series within s 49(13)` TRUE FALSE TRUE
#ASSERT NOT (`a share certificate gives the particulars of the class or series within s 49(13)` TRUE FALSE FALSE)
-- args: contains the (13)(b) statement, the person is a shareholder, demands a copy
#ASSERT `the corporation must furnish a full copy of the text on demand within s 49(14)` TRUE TRUE TRUE
#ASSERT NOT (`the corporation must furnish a full copy of the text on demand within s 49(14)` FALSE TRUE TRUE)
#ASSERT NOT (`the corporation must furnish a full copy of the text on demand within s 49(14)` TRUE FALSE TRUE)
#ASSERT NOT (`the corporation must furnish a full copy of the text on demand within s 49(14)` TRUE TRUE FALSE)
#ASSERT `the most the corporation may charge for the copy in dollars within s 49(14)` TRUE TRUE TRUE EQUALS (JUST 0)
#ASSERT `the most the corporation may charge for the copy in dollars within s 49(14)` TRUE TRUE FALSE EQUALS NOTHING

§§ `s 49(15) and (15.1): fractional shares and scrip`
#ASSERT `the corporation may issue a certificate or scrip certificates for the fractional share within s 49(15)` TRUE TRUE
#ASSERT NOT (`the corporation may issue a certificate or scrip certificates for the fractional share within s 49(15)` TRUE FALSE)
#ASSERT NOT (`the corporation may issue a certificate or scrip certificates for the fractional share within s 49(15)` FALSE TRUE)
#ASSERT `the number of full-share certificates the holder may receive in exchange within s 49(15)` 2.5 EQUALS 2
#ASSERT `the number of full-share certificates the holder may receive in exchange within s 49(15)` 1 EQUALS 1
#ASSERT `the number of full-share certificates the holder may receive in exchange within s 49(15)` 0.99 EQUALS 0
-- args: requests an exchange, fractional-share or scrip certificate, in bearer form, day issued, day (15.1) came into force
#ASSERT `the corporation must issue a registered-form certificate in exchange within s 49(15.1)` TRUE TRUE TRUE (YearMonthDay 2000 12 31) (YearMonthDay 2001 1 1)
#ASSERT NOT (`the corporation must issue a registered-form certificate in exchange within s 49(15.1)` TRUE TRUE TRUE (YearMonthDay 2001 1 1) (YearMonthDay 2001 1 1))
#ASSERT NOT (`the corporation must issue a registered-form certificate in exchange within s 49(15.1)` TRUE TRUE FALSE (YearMonthDay 2000 12 31) (YearMonthDay 2001 1 1))
#ASSERT NOT (`the corporation must issue a registered-form certificate in exchange within s 49(15.1)` FALSE TRUE TRUE (YearMonthDay 2000 12 31) (YearMonthDay 2001 1 1))
#ASSERT NOT (`the corporation must issue a registered-form certificate in exchange within s 49(15.1)` TRUE FALSE TRUE (YearMonthDay 2000 12 31) (YearMonthDay 2001 1 1))

§§ `s 49(16): conditions on scrip certificates`
-- args: condition attached, exchanged before the specified date, the specified date, the day asked about
#ASSERT `the scrip certificate has become void within s 49(16)(a)` TRUE FALSE (YearMonthDay 2026 6 30) (YearMonthDay 2026 6 30)
#ASSERT `the scrip certificate has become void within s 49(16)(a)` TRUE FALSE (YearMonthDay 2026 6 30) (YearMonthDay 2026 7 15)
#ASSERT NOT (`the scrip certificate has become void within s 49(16)(a)` TRUE FALSE (YearMonthDay 2026 6 30) (YearMonthDay 2026 6 29))
#ASSERT NOT (`the scrip certificate has become void within s 49(16)(a)` TRUE TRUE (YearMonthDay 2026 6 30) (YearMonthDay 2026 7 15))
#ASSERT NOT (`the scrip certificate has become void within s 49(16)(a)` FALSE FALSE (YearMonthDay 2026 6 30) (YearMonthDay 2026 7 15))
#ASSERT `the shares may be issued to any person despite a pre-emptive right within s 49(16)(b)` TRUE
#ASSERT NOT (`the shares may be issued to any person despite a pre-emptive right within s 49(16)(b)` FALSE)
#ASSERT `the holder's rateable share of the proceeds in dollars within s 49(16)(b)` 1000 0.25 1 EQUALS (JUST 250)
#ASSERT `the holder's rateable share of the proceeds in dollars within s 49(16)(b)` 1000 0.25 0 EQUALS NOTHING

§§ `s 49(17) and (18): no vote and no dividend`
-- args: holds a fractional share, results from a consolidation, the articles otherwise provide
#ASSERT `the holder of the fractional share is barred from voting and from dividends within s 49(17)` TRUE FALSE FALSE
#ASSERT NOT (`the holder of the fractional share is barred from voting and from dividends within s 49(17)` TRUE TRUE FALSE)
#ASSERT NOT (`the holder of the fractional share is barred from voting and from dividends within s 49(17)` TRUE FALSE TRUE)
#ASSERT NOT (`the holder of the fractional share is barred from voting and from dividends within s 49(17)` FALSE FALSE FALSE)
#ASSERT `the holder of the scrip certificate is barred from voting and from dividends within s 49(18)` TRUE
#ASSERT NOT (`the holder of the scrip certificate is barred from voting and from dividends within s 49(18)` FALSE)
