#ASSERT `Am I deemed to have notice of an adverse claim because the security is held by a fiduciary` FALSE TRUE EQUALS NOTHING
#ASSERT `Am I deemed to have notice of an adverse claim because the security is held by a fiduciary` TRUE TRUE EQUALS (JUST TRUE)

-- Must I inquire into the rightfulness of a transfer by a fiduciary (s 61(2))?
#ASSERT `Must I inquire into the rightfulness of a transfer by a fiduciary` TRUE EQUALS (JUST FALSE)
#ASSERT `Must I inquire into the rightfulness of a transfer by a fiduciary` FALSE EQUALS NOTHING

-- Is an event, such as a call or a maturity, of itself notice to me of an adverse claim (s 62)?
#ASSERT `Is an event, such as a call or a maturity, of itself notice to me of an adverse claim` TRUE (YearMonthDay 2020 3 1) FALSE (YearMonthDay 2000 1 1) FALSE (YearMonthDay 2021 3 2)
#ASSERT NOT (`Is an event, such as a call or a maturity, of itself notice to me of an adverse claim` FALSE (YearMonthDay 2000 1 1) FALSE (YearMonthDay 2000 1 1) TRUE (YearMonthDay 2030 1 1))
#ASSERT `Is an event, such as a call or a maturity, of itself notice to me of an adverse claim` FALSE (YearMonthDay 2000 1 1) TRUE (YearMonthDay 2020 3 1) TRUE (YearMonthDay 2020 9 2)

-- What warranties do I give the corporation when I present a security for registration or payment (s 63(1))?
#ASSERT `What warranties do I give the corporation when I present a security for registration or payment` TRUE FALSE EQUALS (JUST (LIST `a warranty to the issuer that the person is entitled to the registration, payment or exchange`))
#ASSERT `What warranties do I give the corporation when I present a security for registration or payment` TRUE TRUE EQUALS (JUST (LIST `a warranty to the issuer that the purchaser has no knowledge of any unauthorized signature in a necessary endorsement`))
#ASSERT `What warranties do I give the corporation when I present a security for registration or payment` FALSE FALSE EQUALS NOTHING

-- What warranties do I give a purchaser when I transfer a security to them for value (s 63(2))?
#ASSERT `What warranties do I give a purchaser when I transfer a security to them for value` TRUE EQUALS (JUST (LIST `a warranty to the purchaser that the transfer is effective and rightful`, `a warranty to the purchaser that the security is genuine and has not been materially altered`, `a warranty to the purchaser that the transferor knows of nothing that might impair the validity of the security`))
#ASSERT `What warranties do I give a purchaser when I transfer a security to them for value` FALSE EQUALS NOTHING

-- What warranties do I give as an intermediary delivering a security (s 63(3))?
#ASSERT `What warranties do I give as an intermediary delivering a security` TRUE EQUALS (JUST (LIST `a warranty by an intermediary of their good faith`, `a warranty by an intermediary of their authority`))
#ASSERT `What warranties do I give as an intermediary delivering a security` FALSE EQUALS NOTHING

-- What warranties do I give as a pledgee who redelivers a security (s 63(4))?
#ASSERT `What warranties do I give as a pledgee who redelivers a security` TRUE FALSE EQUALS NOTHING
#ASSERT `What warranties do I give as a pledgee who redelivers a security` TRUE TRUE EQUALS (JUST (LIST `a warranty by an intermediary of their good faith`, `a warranty by an intermediary of their authority`))
#ASSERT `What warranties do I give as a pledgee who redelivers a security` FALSE TRUE EQUALS NOTHING

-- Do I give the warranties of a purchaser as a broker (s 63(5))?
#ASSERT `Do I give the warranties of a purchaser as a broker` TRUE
#ASSERT NOT (`Do I give the warranties of a purchaser as a broker` FALSE)

-- Can I be a bona fide purchaser of a registered security delivered without a necessary endorsement (s 64)?
#ASSERT `Can I be a bona fide purchaser of a registered security delivered without a necessary endorsement` TRUE TRUE FALSE EQUALS (JUST FALSE)
#ASSERT `Can I be a bona fide purchaser of a registered security delivered without a necessary endorsement` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `Can I be a bona fide purchaser of a registered security delivered without a necessary endorsement` TRUE TRUE TRUE EQUALS (JUST TRUE)
#ASSERT `Can I be a bona fide purchaser of a registered security delivered without a necessary endorsement` TRUE FALSE FALSE EQUALS NOTHING

