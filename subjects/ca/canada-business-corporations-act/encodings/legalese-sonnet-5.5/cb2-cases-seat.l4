#ASSERT NOT (`May the receiver-manager carry on the business of the corporation` `a receiver appointed in respect of property of a corporation` TRUE)
#ASSERT NOT (`May the receiver-manager carry on the business of the corporation` `a sequestrator of property of a corporation` TRUE)

