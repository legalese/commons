#ASSERT `May the corporation indemnify me for what I reasonably incurred in a proceeding because of my position` `an individual who acts or acted at the corporation's request as a director or officer of another entity` TRUE
#ASSERT `May the corporation indemnify me for what I reasonably incurred in a proceeding because of my position` `an individual who acts or acted at the corporation's request in a similar capacity of another entity` TRUE
#ASSERT NOT (`May the corporation indemnify me for what I reasonably incurred in a proceeding because of my position` `none of those` TRUE)

-- May the corporation advance moneys to me for the costs of a proceeding (s 124(2))?
#ASSERT `May the corporation advance moneys to me for the costs of a proceeding` TRUE
#ASSERT NOT (`May the corporation advance moneys to me for the costs of a proceeding` FALSE)

-- Must I repay moneys the corporation advanced to me (s 124(2))?
#ASSERT `Must I repay moneys the corporation advanced to me` TRUE FALSE
#ASSERT NOT (`Must I repay moneys the corporation advanced to me` FALSE TRUE)

-- May the corporation, with court approval, indemnify me in a derivative action (s 124(4))?
#ASSERT NOT (`May the corporation, with court approval, indemnify me in a derivative action` FALSE TRUE TRUE `a director or officer of the corporation` TRUE FALSE FALSE)
#ASSERT NOT (`May the corporation, with court approval, indemnify me in a derivative action` TRUE FALSE TRUE `a director or officer of the corporation` TRUE FALSE FALSE)
#ASSERT `May the corporation, with court approval, indemnify me in a derivative action` TRUE TRUE TRUE `a director or officer of the corporation` TRUE TRUE TRUE
#ASSERT NOT (`May the corporation, with court approval, indemnify me in a derivative action` TRUE TRUE FALSE `a director or officer of the corporation` TRUE FALSE FALSE)
#ASSERT `May the corporation, with court approval, indemnify me in a derivative action` TRUE TRUE TRUE `a former director or officer of the corporation` TRUE FALSE FALSE
#ASSERT `May the corporation, with court approval, indemnify me in a derivative action` TRUE TRUE TRUE `an individual who acts or acted at the corporation's request as a director or officer of another entity` TRUE FALSE FALSE
#ASSERT `May the corporation, with court approval, indemnify me in a derivative action` TRUE TRUE TRUE `an individual who acts or acted at the corporation's request in a similar capacity of another entity` TRUE FALSE FALSE
#ASSERT NOT (`May the corporation, with court approval, indemnify me in a derivative action` TRUE TRUE TRUE `none of those` TRUE FALSE FALSE)

-- May the corporation indemnify me, taking subsections 124(1), (3) and (4) together?
#ASSERT NOT (`May the corporation indemnify me, taking subsections 124(1), (3) and (4) together` `a director or officer of the corporation` TRUE TRUE FALSE TRUE FALSE FALSE)
#ASSERT `May the corporation indemnify me, taking subsections 124(1), (3) and (4) together` `a director or officer of the corporation` TRUE FALSE FALSE TRUE TRUE TRUE
#ASSERT NOT (`May the corporation indemnify me, taking subsections 124(1), (3) and (4) together` `a director or officer of the corporation` FALSE FALSE FALSE TRUE FALSE FALSE)
#ASSERT `May the corporation indemnify me, taking subsections 124(1), (3) and (4) together` `a former director or officer of the corporation` TRUE TRUE TRUE TRUE FALSE FALSE
#ASSERT NOT (`May the corporation indemnify me, taking subsections 124(1), (3) and (4) together` `a director or officer of the corporation` TRUE FALSE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`May the corporation indemnify me, taking subsections 124(1), (3) and (4) together` `none of those` TRUE FALSE FALSE TRUE FALSE FALSE)
#ASSERT NOT (`May the corporation indemnify me, taking subsections 124(1), (3) and (4) together` `a director or officer of the corporation` TRUE FALSE FALSE TRUE TRUE FALSE)
#ASSERT `May the corporation indemnify me, taking subsections 124(1), (3) and (4) together` `an individual who acts or acted at the corporation's request in a similar capacity of another entity` TRUE FALSE FALSE TRUE FALSE FALSE

-- Am I entitled to be indemnified for the cost of defending the proceeding (s 124(5))?
#ASSERT `Am I entitled to be indemnified for the cost of defending the proceeding` `a director or officer of the corporation` TRUE TRUE TRUE FALSE FALSE
#ASSERT NOT (`Am I entitled to be indemnified for the cost of defending the proceeding` `a director or officer of the corporation` FALSE TRUE TRUE FALSE FALSE)
#ASSERT NOT (`Am I entitled to be indemnified for the cost of defending the proceeding` `a director or officer of the corporation` TRUE FALSE TRUE FALSE FALSE)
#ASSERT NOT (`Am I entitled to be indemnified for the cost of defending the proceeding` `a director or officer of the corporation` TRUE TRUE TRUE TRUE FALSE)
#ASSERT NOT (`Am I entitled to be indemnified for the cost of defending the proceeding` `none of those` TRUE TRUE TRUE FALSE FALSE)
#ASSERT NOT (`Am I entitled to be indemnified for the cost of defending the proceeding` `a director or officer of the corporation` TRUE TRUE FALSE FALSE FALSE)
#ASSERT `Am I entitled to be indemnified for the cost of defending the proceeding` `a director or officer of the corporation` TRUE TRUE TRUE TRUE TRUE
#ASSERT `Am I entitled to be indemnified for the cost of defending the proceeding` `an individual who acts or acted at the corporation's request as a director or officer of another entity` TRUE TRUE TRUE FALSE FALSE

-- May the corporation buy and maintain insurance for me (s 124(6))?
#ASSERT `May the corporation buy and maintain insurance for me` `a director or officer of the corporation` TRUE FALSE
#ASSERT `May the corporation buy and maintain insurance for me` `an individual who acts or acted at the corporation's request as a director or officer of another entity` FALSE TRUE
#ASSERT NOT (`May the corporation buy and maintain insurance for me` `none of those` TRUE TRUE)
#ASSERT `May the corporation buy and maintain insurance for me` `a former director or officer of the corporation` TRUE FALSE
#ASSERT `May the corporation buy and maintain insurance for me` `an individual who acts or acted at the corporation's request in a similar capacity of another entity` FALSE TRUE

-- May I apply to a court for an order approving an indemnity (s 124(7))?
#ASSERT `May I apply to a court for an order approving an indemnity` TRUE FALSE FALSE
#ASSERT `May I apply to a court for an order approving an indemnity` FALSE TRUE FALSE
#ASSERT `May I apply to a court for an order approving an indemnity` FALSE FALSE TRUE
#ASSERT NOT (`May I apply to a court for an order approving an indemnity` FALSE FALSE FALSE)

-- May the court approve the indemnity and make any further order (s 124(7))?
#ASSERT `May the court approve the indemnity and make any further order` TRUE
#ASSERT NOT (`May the court approve the indemnity and make any further order` FALSE)

-- Must I give the Director notice of my application (s 124(8))?
#ASSERT `Must I give the Director notice of my application` TRUE
#ASSERT NOT (`Must I give the Director notice of my application` FALSE)

-- Is the Director entitled to appear and be heard on my application (s 124(8))?
#ASSERT `Is the Director entitled to appear and be heard on my application` TRUE
#ASSERT NOT (`Is the Director entitled to appear and be heard on my application` FALSE)

-- May the court order notice to be given to an interested person (s 124(9))?
#ASSERT `May the court order notice to be given to an interested person` TRUE
#ASSERT NOT (`May the court order notice to be given to an interested person` FALSE)

-- Am I entitled to appear and be heard as an interested person given notice by the court (s 124(9))?
#ASSERT `Am I entitled to appear and be heard as an interested person given notice by the court` TRUE
#ASSERT NOT (`Am I entitled to appear and be heard as an interested person given notice by the court` FALSE)

-- May the directors fix my remuneration (s 125)?
#ASSERT `May the directors fix my remuneration` `a director of the corporation` FALSE
#ASSERT NOT (`May the directors fix my remuneration` `an officer of the corporation` TRUE)
#ASSERT `May the directors fix my remuneration` `an employee of the corporation` FALSE
#ASSERT NOT (`May the directors fix my remuneration` `someone else` FALSE)


§ `Worked scenarios in the seat's words`

-- A founder: a distributing corporation whose securities are held by more than one person, three directors, two of them not officers or employees (s 102(2): not fewer than three, at least two outside).
#ASSERT `Does our board have enough directors` 3 TRUE TRUE 2

-- The same board with only one outside director.
#ASSERT NOT (`Does our board have enough directors` 3 TRUE TRUE 1)

-- A private start-up with one director (s 102(2): one or more).
#ASSERT `Does our board have enough directors` 1 FALSE FALSE 0

-- A seventeen-year-old asked to join the board (s 105(1)(a): under eighteen).
#ASSERT `Am I disqualified from being a director` 17 FALSE TRUE FALSE

-- The same person at eighteen.
#ASSERT NOT (`Am I disqualified from being a director` 18 FALSE TRUE FALSE)

-- An adult with the status of bankrupt (s 105(1)(d)).
#ASSERT `Am I disqualified from being a director` 45 FALSE TRUE TRUE

-- An ordinary corporation with seven directors: at least 25 per cent of seven is 1.75, so two (s 105(3)).
#ASSERT `How many of our directors must be resident Canadians` 7 FALSE FALSE FALSE 0 EQUALS 2

-- An ordinary corporation with three directors: fewer than four, so one (s 105(3)).
#ASSERT `How many of our directors must be resident Canadians` 3 FALSE FALSE FALSE 0 EQUALS 1

-- A corporation in a prescribed sector with three directors: a majority, so two (s 105(3.1)).
#ASSERT `How many of our directors must be resident Canadians` 3 TRUE FALSE FALSE 0 EQUALS 2

-- The same kind of corporation with two directors: one of them (s 105(3.3)).
#ASSERT `How many of our directors must be resident Canadians` 2 TRUE FALSE FALSE 0 EQUALS 1

-- A majority shareholder asks whether an ordinary resolution at a special meeting removes a director (s 109(1)).
#ASSERT `May the shareholders remove a director by ordinary resolution at a special meeting` TRUE TRUE FALSE FALSE

-- A minority shareholder holds enough votes, under cumulative voting, to block: the s 107(g) threshold is not met.
#ASSERT NOT (`May the shareholders remove a director by ordinary resolution at a special meeting` TRUE TRUE TRUE FALSE)

-- Removal attempted at an ordinary meeting, not a special meeting.
#ASSERT NOT (`May the shareholders remove a director by ordinary resolution at a special meeting` TRUE FALSE FALSE FALSE)

-- A director who has resigned (s 108(1)(a)).
#ASSERT `Have I ceased to be a director` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE

-- A sitting director with no cause to leave.
#ASSERT NOT (`Have I ceased to be a director` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)

-- A director who sends a written resignation on 1 March 2024 and names no later time (s 108(2): the time it is sent).
#ASSERT `On what date does my resignation take effect` (YearMonthDay 2024 3 1) FALSE (YearMonthDay 2000 1 1) EQUALS (YearMonthDay 2024 3 1)

-- The same director names 15 March 2024 in the resignation (s 108(2): whichever is later).
#ASSERT `On what date does my resignation take effect` (YearMonthDay 2024 3 1) TRUE (YearMonthDay 2024 3 15) EQUALS (YearMonthDay 2024 3 15)

-- A director voted to issue a share for property worth 7,500 dollars where money would have been 10,000 (s 118(1): the shortfall).
#ASSERT `What amount must I make good for a share issued for property worth less than its price` TRUE TRUE 10000 7500 EQUALS (JUST 2500)

-- The share was issued for money: s 118(1) says nothing.
#ASSERT `What amount must I make good for a share issued for property worth less than its price` TRUE FALSE 10000 7500 EQUALS NOTHING

-- A director owed 8,000 dollars in wages by the corporation, six months of wages being 6,000 dollars (s 119(1): capped).
#ASSERT `How much am I liable to an employee for unpaid wages` TRUE 8000 6000 EQUALS (JUST 6000)

-- Someone who was not a director when the services were performed: s 119(1) says nothing.
#ASSERT `How much am I liable to an employee for unpaid wages` FALSE 8000 6000 EQUALS NOTHING

-- A director who is a party to a material contract with the corporation (s 120(1)(a)).
#ASSERT `Must I disclose my interest in this contract or transaction` TRUE TRUE TRUE FALSE FALSE

-- A director with no party, office or material interest in the counterparty.
#ASSERT NOT (`Must I disclose my interest in this contract or transaction` TRUE TRUE FALSE FALSE FALSE)

-- The interested director may not vote on the resolution approving the contract (s 120(5)).
#ASSERT `Am I barred from voting on the resolution to approve the contract` TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE

-- The same, where the contract relates primarily to the director's own remuneration (s 120(5)(a)): the bar does not apply.
#ASSERT NOT (`Am I barred from voting on the resolution to approve the contract` TRUE TRUE TRUE FALSE FALSE TRUE FALSE FALSE)

-- A director who attended and said nothing is deemed to have consented (s 123(1)).
#ASSERT `Am I deemed to have consented to the resolution I was present for` TRUE FALSE FALSE FALSE

-- A director who had a dissent entered in the minutes (s 123(1)(a)).
#ASSERT NOT (`Am I deemed to have consented to the resolution I was present for` TRUE TRUE FALSE FALSE)

-- A serving director sued because of the office asks whether the corporation may indemnify the costs (s 124(1)).
#ASSERT `May the corporation indemnify me for what I reasonably incurred in a proceeding because of my position` `a director or officer of the corporation` TRUE

-- Someone with no such association with the corporation.
#ASSERT NOT (`May the corporation indemnify me for what I reasonably incurred in a proceeding because of my position` `none of those` TRUE)

-- A derivative action with court approval, and the s 124(3) conditions met.
#ASSERT `May the corporation, with court approval, indemnify me in a derivative action` TRUE TRUE TRUE `a director or officer of the corporation` TRUE FALSE FALSE

-- The same without court approval.
#ASSERT NOT (`May the corporation, with court approval, indemnify me in a derivative action` FALSE TRUE TRUE `a director or officer of the corporation` TRUE FALSE FALSE)

-- A board of five with three present: a majority (s 114(2)).
#ASSERT `Is there a quorum of directors` 5 3 FALSE 0

-- The same board with two present.
#ASSERT NOT (`Is there a quorum of directors` 5 2 FALSE 0)

-- A minority shareholder entitled to vote at the annual meeting makes a proposal under s 137 (s 103(5)).
#ASSERT `May I, as a shareholder, propose to make, amend or repeal a by-law` TRUE TRUE

-- A board that proposes a by-law the articles do not forbid (s 103(1)).
#ASSERT `May the directors make, amend or repeal a by-law by resolution` TRUE FALSE

-- The same, where a unanimous shareholder agreement says otherwise.
#ASSERT NOT (`May the directors make, amend or repeal a by-law by resolution` TRUE TRUE)

-- Shareholders rejected the by-law the directors made (s 103(3) and (4): it ceases to be effective).
#ASSERT `Is the by-law the directors made in effect` `the shareholders rejected it` TRUE TRUE EQUALS `no longer effective`

-- A by-law made by the directors and not yet put to the shareholders (s 103(3): effective until confirmed or rejected).
#ASSERT `Is the by-law the directors made in effect` `the shareholders have not yet acted on it` FALSE FALSE EQUALS `in effect from the date of the directors' resolution, awaiting the shareholders`

-- The annual meeting at which an election is required (s 106(3)).
#ASSERT `Must the shareholders elect directors at this meeting` TRUE TRUE

-- A shareholder with 100 votes in an election of five directors under cumulative voting (s 107(b): 100 times 5).
#ASSERT `How many votes may I cast in an election of directors under cumulative voting` TRUE 100 5 EQUALS (JUST 500)

-- Nine directors were elected at the last annual meeting; the board has appointed one and proposes two more: three is not more than a third of nine (s 106(8)).
#ASSERT `May the directors appoint additional directors` FALSE 9 1 2

-- Proposing three more makes four, over a third of nine.
#ASSERT NOT (`May the directors appoint additional directors` FALSE 9 1 3)

-- A director who used the care, diligence and skill of a reasonably prudent person (s 123(4)).
#ASSERT `Am I not liable under ss 118 and 119 because I used reasonable diligence` TRUE

-- A director who simply attended the meeting (s 114(6): attendance is a waiver).
#ASSERT `Have I waived notice of the meeting` FALSE TRUE FALSE

-- A director who attended only to object that the meeting was not lawfully called.
#ASSERT NOT (`Have I waived notice of the meeting` FALSE TRUE TRUE)

