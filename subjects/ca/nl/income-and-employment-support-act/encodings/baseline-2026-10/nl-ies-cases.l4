IMPORT prelude
IMPORT daydate
IMPORT `nl-ies`
IMPORT `nl-ies-deadlines`
IMPORT `nl-ies-seat`

-- Newfoundland and Labrador Income and Employment Support Act and Regulations -- worked cases from the seat of the
-- applicant or recipient. Every assertion is a claim about the ENCODING on stated facts. Expected values were worked by
-- hand from the deposited text (SNL2002-cI-0.1-selected.txt, NLR-144-04-part-i.txt), never copied from the encoding's
-- output. All the people are HYPOTHETICAL. Amounts are the most the regulations allow a month.

-- ---------------------------------------------------------------------------------------------------------------------
-- Act ss 13, 15, reg ss 4, 9(5): the basic conditions.
#ASSERT `Do I meet the basic conditions` TRUE 0 FALSE FALSE TRUE FALSE
-- Away 45 days for a purpose an officer approved: still living in the province.
#ASSERT `Do I meet the basic conditions` FALSE 45 TRUE FALSE TRUE FALSE
-- Away 90 days, approved but not medical: not; approved and medical: yes; away 30 days without approval: not.
#ASSERT (`Do I meet the basic conditions` FALSE 90 TRUE FALSE TRUE FALSE) EQUALS FALSE
#ASSERT `Do I meet the basic conditions` FALSE 90 TRUE TRUE TRUE FALSE
#ASSERT (`Do I meet the basic conditions` FALSE 30 FALSE FALSE TRUE FALSE) EQUALS FALSE
-- Not having pursued other resources (Act s 13(1)), or applying because of a strike (reg s 9(5)): not eligible.
#ASSERT (`Do I meet the basic conditions` TRUE 0 FALSE FALSE FALSE FALSE) EQUALS FALSE
#ASSERT (`Do I meet the basic conditions` TRUE 0 FALSE FALSE TRUE TRUE) EQUALS FALSE

-- ---------------------------------------------------------------------------------------------------------------------
-- Reg s 26: liquid assets.
#ASSERT `Are my liquid assets within the limit` 1 5000 0 FALSE
#ASSERT `Are my liquid assets within the limit` 1 6000 0 FALSE
#ASSERT (`Are my liquid assets within the limit` 1 6001 0 FALSE) EQUALS FALSE
-- Three people, $10,000 and $25,000 of RRSPs that can be cashed: 10,000 + 5,000 = 15,000 > 11,000.
#ASSERT (`Are my liquid assets within the limit` 3 10000 25000 TRUE) EQUALS FALSE
-- The same RRSPs locked in: only the $10,000 counts.
#ASSERT `Are my liquid assets within the limit` 3 10000 25000 FALSE
-- Two people, $10,000 and $20,000 of RRSPs: the RRSPs are wholly exempt (s 26(3)).
#ASSERT `Are my liquid assets within the limit` 2 10000 20000 TRUE
#ASSERT `the liquid assets counted` 10000 25000 TRUE EQUALS 15000

-- ---------------------------------------------------------------------------------------------------------------------
-- Reg s 9(3): the income test. One adult renting at $700: BR = 561 + 522 = 1,083; 1.4 x 1,083 = 1,516.20.
#ASSERT `Do I pass the income test` 1 `renting` 700 1400 0 0
#ASSERT (`Do I pass the income test` 1 `renting` 700 1600 0 0) EQUALS FALSE
-- With a $100 deduction authorized and $1,700 of income: 1,700 - 100 - 100 = 1,500, within 1,516.20 (finding 5).
#ASSERT `Do I pass the income test` 1 `renting` 700 1700 100 0
-- Two adults with a $900 mortgage: BR = 1,122 + 598 = 1,720; 1.4 x 1,720 = 2,408.
#ASSERT `Do I pass the income test` 2 `paying a mortgage` 900 2400 0 0
#ASSERT (`Do I pass the income test` 2 `paying a mortgage` 900 2410 0 0) EQUALS FALSE
-- Boarding: no s 16 amount; BR = 561.
#ASSERT `BR for the s 9(3) test` 1 `boarding` 400 EQUALS 561

-- ---------------------------------------------------------------------------------------------------------------------
-- Reg s 12(a): the earnings exemption.
#ASSERT `How much of my earnings is exempt` 1 FALSE 300 EQUALS 120
#ASSERT `How much of my earnings is exempt` 3 FALSE 300 EQUALS 180
#ASSERT `How much of my earnings is exempt` 1 TRUE 300 EQUALS 180
#ASSERT `How much of my earnings is exempt` 2 TRUE 300 EQUALS 260
#ASSERT `How much of my earnings is exempt` 1 FALSE 50 EQUALS 50

-- ---------------------------------------------------------------------------------------------------------------------
-- Regs ss 13, 16, 18, 19(1): the most a month.
-- A: single adult, apartment, no utilities in the rent, $700 rent, island, pays heat: 561 + 522 + 71 = 1,154.
#ASSERT `What is the most monthly income support I can get` 1 0 FALSE `an apartment or a house` `neither` `renting` 700 `the island portion of the province` TRUE 0 0 0 FALSE 0 0 0 EQUALS 1154
-- B: the same with heat and electricity in the rent: 561 - 76 = 485, and rent up to 522 + 76 = 598: 485 + 598 = 1,083.
#ASSERT `What is the most monthly income support I can get` 1 0 FALSE `an apartment or a house` `heat and electricity` `renting` 700 `the island portion of the province` FALSE 0 0 0 FALSE 0 0 0 EQUALS 1083
-- B2: rent of $550 with heat and electricity: the shelter amount is the actual $550 (s 16(2)): 485 + 550 = 1,035.
#ASSERT `What is the most monthly income support I can get` 1 0 FALSE `an apartment or a house` `heat and electricity` `renting` 550 `the island portion of the province` FALSE 0 0 0 FALSE 0 0 0 EQUALS 1035
-- C: a single parent with two children, coastal Labrador, $800 rent, pays heat, $400 earned: exemption for 2 or more
-- persons 150 + 20% x 250 = 200, so 200 is deducted: 1,083 - 200 = 883; plus fuel 132, coastal 150, single parent 168.
#ASSERT `What is the most monthly income support I can get` 1 2 FALSE `an apartment or a house` `neither` `renting` 800 `a coastal Labrador community` TRUE 0 0 0 FALSE 400 0 0 EQUALS 1333
-- D: a couple aged 65 and over with a $500 mortgage, island, pays heat, one with diabetes, $1,500 of CPP and OAS:
-- 1,122 + 500 = 1,622 - 1,500 = 122; plus fuel 71, 2 x 105, 60: 463.
#ASSERT `What is the most monthly income support I can get` 2 0 TRUE `an apartment or a house` `neither` `paying a mortgage` 500 `the island portion of the province` TRUE 2 0 1 FALSE 0 0 1500 EQUALS 463
-- E: boarding with $2,000 of pension: the s 13 amount is fully used up; nothing from s 19.
#ASSERT `What is the most monthly income support I can get` 1 0 FALSE `an apartment or a house` `neither` `boarding` 0 `the island portion of the province` FALSE 0 0 0 FALSE 0 0 2000 EQUALS 0
-- F: a bed sitting room with electricity in the rent, $400 rent: 561 - 12 = 549 and the actual 400 (up to 534): 949.
#ASSERT `What is the most monthly income support I can get` 1 0 FALSE `a bed sitting room` `electricity only` `renting` 400 `the island portion of the province` FALSE 0 0 0 FALSE 0 0 0 EQUALS 949
-- The s 13(2) reductions.
#ASSERT `the s 13(2) reduction` `a bed sitting room` `heat and electricity` EQUALS 61
#ASSERT `the s 13(2) reduction` `an apartment or a house` `heat only` EQUALS 49
#ASSERT `the s 13(2) reduction` `a bed sitting room` `heat only` EQUALS 49
-- Two adults renting: the rent maximum is $299 each.
#ASSERT `the s 16(1) maximum` 2 EQUALS 598
#ASSERT `the s 16(1) maximum` 3 EQUALS 897

-- ---------------------------------------------------------------------------------------------------------------------
-- Act s 17(5), reg s 7(1): reporting.
#ASSERT `Must I report the change` `my address`
#ASSERT `Must I report the change` `I received a liquid asset`
#ASSERT (`Must I report the change` `none of these`) EQUALS FALSE

-- ---------------------------------------------------------------------------------------------------------------------
-- Time limits.
-- Reg s 5(2): a written request on 1 March 2026: by 31 March 2026; with 10 extra days allowed, by 10 April 2026.
#ASSERT `By when must I answer the officer` (Date 1 3 2026) 0 EQUALS Date 31 3 2026
#ASSERT `By when must I answer the officer` (Date 1 3 2026) 10 EQUALS Date 10 4 2026
-- Act s 41(3): notified 15 January 2026: request a review by 16 March 2026.
#ASSERT `By when must I ask for an internal review` (Date 15 1 2026) EQUALS Date 16 3 2026
-- Act s 43(2): outcome received 20 November 2026: appeal by 19 January 2027.
#ASSERT `By when must I appeal` (Date 20 11 2026) EQUALS Date 19 1 2027

-- The regulative rules.
#ASSERT EVALTRACE (`my duty to answer the request for information` 0) 0 (LIST EVENT `the recipient` `provide the information requested` 25) EQUALS FULFILLED
#ASSERT EVALTRACE (`my duty to answer the request for information` 10) 0 (LIST EVENT `the recipient` `provide the information requested` 35) EQUALS FULFILLED
-- expect: BREACH BY `the recipient`, "information not provided within 30 days of the officer's written request: the officer may deny, vary, suspend or cancel income support (reg s 5(5))" -- the answer comes on day 31.
#TRACE `my duty to answer the request for information` 0 AT 0 WITH
    PARTY `the recipient` DOES `provide the information requested` AT 31
-- A review requested on day 50 and performed 12 days later: fulfilled.
#ASSERT EVALTRACE `my right to an internal review` 0 (LIST EVENT `the recipient` `request an internal review in writing` 50, EVENT `the internal reviewer` `perform the internal review` 62) EQUALS FULFILLED
-- expect: BREACH BY `the internal reviewer`, "internal review not performed within 15 days of receipt of the written request (Act s 41(5))" -- performed 20 days after the request.
#TRACE `my right to an internal review` AT 0 WITH
    PARTY `the recipient` DOES `request an internal review in writing` AT 50
    PARTY `the internal reviewer` DOES `perform the internal review` AT 70
-- An appeal on day 10, heard 25 days later: fulfilled.
#ASSERT EVALTRACE `my right to appeal` 0 (LIST EVENT `the recipient` `appeal in writing to the appeal board` 10, EVENT `the appeal board` `hear the appeal` 35) EQUALS FULFILLED
