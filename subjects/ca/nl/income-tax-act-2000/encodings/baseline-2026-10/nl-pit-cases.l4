IMPORT prelude
IMPORT daydate
IMPORT `nl-pit`
IMPORT `nl-pit-notice`
IMPORT `nl-pit-seat`

-- Newfoundland and Labrador Income Tax Act, 2000 -- worked cases from the seat of the individual taxpayer.
-- Every assertion is a claim about the ENCODING on stated facts. Expected values were worked by hand from the deposited
-- text (SNL2000-cI-1.1-selected.txt, NLR-32-16.txt, NLR-60-24.txt) and the Department of Finance figures
-- (nl-finance-personalincometax.txt), never copied from the encoding's output. All the people are HYPOTHETICAL.
-- The indexed income thresholds used for s 9(1) ($915), s 9(2) ($37,000) and s 21.1 ($23,390 and $39,551) are the
-- encoder's HYPOTHETICAL inputs: the deposited text does not state them for 2025 or 2026 (NOTES.md findings 3 and 5).

-- ---------------------------------------------------------------------------------------------------------------------
-- s 6(1): who must pay.
#ASSERT `Must I pay Newfoundland and Labrador income tax` TRUE FALSE
#ASSERT `Must I pay Newfoundland and Labrador income tax` FALSE TRUE
#ASSERT (`Must I pay Newfoundland and Labrador income tax` FALSE FALSE) EQUALS FALSE

-- ---------------------------------------------------------------------------------------------------------------------
-- s 7: the tax on taxable income.
-- 2026, $50,000: 44,678 x 8.7% = 3,886.986; 5,322 x 14.5% = 771.69; total 4,658.676.
#ASSERT `What is the tax on my taxable income` 2026 50000 EQUALS `answered` 4658.68
-- 2025, $100,000: 44,192 x 8.7% = 3,844.704; 44,190 x 14.5% = 6,407.55; 11,618 x 15.8% = 1,835.644; total 12,087.898.
#ASSERT `What is the tax on my taxable income` 2025 100000 EQUALS `answered` 12087.90
-- 2026, $1,200,000, every bracket: 3,886.986 + 6,478.02 + 11,087.492 + 11,358.536 + 12,271.842 + 59,346.352
-- + 121,545.681 + 12,802.05 = 238,776.959.
#ASSERT `What is the tax on my taxable income` 2026 1200000 EQUALS `answered` 238776.96
-- At the top of the first 2026 bracket: 44,678 x 8.7% = 3,886.986.
#ASSERT `What is the tax on my taxable income` 2026 44678 EQUALS `answered` 3886.99
#ASSERT `What is the tax on my taxable income` 2026 0 EQUALS `answered` 0
-- The thresholds printed in s 7(1) are the 2022 base: at $38,081 the tax is 38,081 x 8.7% = 3,313.047.
#ASSERT `to the cent` (`the s 7 tax on` 38081 `with thresholds` `the thresholds printed in s 7(1)`) EQUALS 3313.05
-- A year outside the encoding.
#ASSERT `What is the tax on my taxable income` 2024 50000 EQUALS `not covered` `only the 2025 and 2026 taxation years are encoded`

-- ---------------------------------------------------------------------------------------------------------------------
-- s 9 and s 17: credits. The appropriate percentage is the lowest s 7 rate.
#ASSERT `the appropriate percentage` EQUALS 0.087
-- 2026, basic amount only, $3,000 of CPP and EI: 8.7% x 13,094 = 1,139.178; 8.7% x 3,000 = 261; total 1,400.178.
#ASSERT `What are my personal credits` 2026 `paragraph (c) -- the basic amount only` 0 915 FALSE 50000 37000 0 3000 EQUALS `answered` 1400.18
-- 2025, basic amount only: 8.7% x 11,067 = 962.829.
#ASSERT `What are my personal credits` 2025 `paragraph (c) -- the basic amount only` 0 915 FALSE 30000 37000 0 0 EQUALS `answered` 962.83
-- 2026, supporting a spouse with $5,000 income (threshold 915): 9,142 - (5,000 - 915) = 5,057, so s 9(1) is 18,151;
-- aged 65 with $40,000 net income (threshold 37,000): 7,142 - 15% x 3,000 = 6,692; $2,000 of pension: $1,000.
-- 8.7% x (18,151 + 6,692 + 1,000) = 8.7% x 25,843 = 2,248.341.
#ASSERT `What are my personal credits` 2026 `paragraph (a) -- supporting a spouse or common law partner` 5000 915 TRUE 40000 37000 2000 0 EQUALS `answered` 2248.34
#ASSERT `What are my personal credits` 2027 `paragraph (c) -- the basic amount only` 0 915 FALSE 30000 37000 0 0 EQUALS `not covered` `only the 2025 and 2026 taxation years are encoded`
-- s 9(1)(a)(ii): a spouse with income under the threshold gives the whole 9,142; one with $20,000 would give
-- 9,142 - 19,085, a negative amount, treated as nil (finding 4).
#ASSERT `the s 9(1) amount` `paragraph (a) -- supporting a spouse or common law partner` `the 2026 credit amounts` 915 500 EQUALS 22236
#ASSERT `the s 9(1) amount` `paragraph (a) -- supporting a spouse or common law partner` `the 2026 credit amounts` 915 20000 EQUALS 13094
-- s 9(1)(b), an eligible dependant with $1,915 of income: 9,142 - 1,000 = 8,142; total 21,236.
#ASSERT `the s 9(1) amount` `paragraph (b) -- supporting an eligible dependant` `the 2026 credit amounts` 915 1915 EQUALS 21236
-- s 9(2): nothing under 65; nil when 15% of the excess is more than the amount (15% x 63,000 = 9,450 > 7,142).
#ASSERT `the s 9(2) amount` FALSE 7142 37000 20000 EQUALS 0
#ASSERT `the s 9(2) amount` TRUE 7142 37000 100000 EQUALS 0
#ASSERT `the s 9(2) amount` TRUE 7142 37000 30000 EQUALS 7142
-- s 9(3): at most $1,000.
#ASSERT `the s 9(3) amount` 600 EQUALS 600
#ASSERT `the s 9(3) amount` 5000 EQUALS 1000

-- ---------------------------------------------------------------------------------------------------------------------
-- s 21.1: the low income reduction, with the 2024 A and B of NLR 60/24 and hypothetical thresholds.
#ASSERT `A for 2024 under NLR 60/24` EQUALS 974
#ASSERT `B for 2024 under NLR 60/24` EQUALS 544
-- Single, $20,000: under the threshold, the whole $974.
#ASSERT `How much is my low income reduction` 20000 FALSE 974 544 23390 39551 EQUALS 974
-- Single, $26,000: 974 - 16% x 2,610 = 974 - 417.60 = 556.40.
#ASSERT `How much is my low income reduction` 26000 FALSE 974 544 23390 39551 EQUALS 556.40
-- With a spouse, family income $45,000: 1,518 - 16% x 5,449 = 1,518 - 871.84 = 646.16.
#ASSERT `How much is my low income reduction` 45000 TRUE 974 544 23390 39551 EQUALS 646.16
-- Single, $50,000: 974 - 16% x 26,610 is negative: nil.
#ASSERT `How much is my low income reduction` 50000 FALSE 974 544 23390 39551 EQUALS 0
-- Not an eligible individual (not resident on 31 December, or a trust): nothing.
#ASSERT `the s 21.1 reduction` FALSE FALSE 20000 974 544 23390 39551 EQUALS 0

-- ---------------------------------------------------------------------------------------------------------------------
-- The tax after credits and the reduction.
-- 2026, $50,000 taxable, credits 1,400.18: 4,658.676 - 1,400.18 = 3,258.496; no reduction at $50,000.
#ASSERT `How much Newfoundland and Labrador income tax do I pay` 2026 TRUE 50000 1400.18 50000 FALSE 974 544 23390 39551 EQUALS `answered` 3258.50
-- 2026, $20,000 taxable: 1,740 - 1,139.18 = 600.82; the $974 reduction takes it to nil.
#ASSERT `How much Newfoundland and Labrador income tax do I pay` 2026 TRUE 20000 1139.18 20000 FALSE 974 544 23390 39551 EQUALS `answered` 0
-- 2026, $26,000 taxable: 2,262 - 1,139.18 = 1,122.82; less 556.40 = 566.42.
#ASSERT `How much Newfoundland and Labrador income tax do I pay` 2026 TRUE 26000 1139.18 26000 FALSE 974 544 23390 39551 EQUALS `answered` 566.42
-- Credits larger than the tax: nil, not a refund (s 9 credits are deductions from tax).
#ASSERT `the tax after the personal credits` 500 1139.18 EQUALS 0
#ASSERT `How much Newfoundland and Labrador income tax do I pay` 2026 FALSE 50000 1400.18 50000 FALSE 974 544 23390 39551 EQUALS `not covered` `only an individual resident in the province on the last day of the taxation year is encoded`
#ASSERT `How much Newfoundland and Labrador income tax do I pay` 2024 TRUE 50000 1400.18 50000 FALSE 974 544 23390 39551 EQUALS `not covered` `only the 2025 and 2026 taxation years are encoded`

-- ---------------------------------------------------------------------------------------------------------------------
-- s 34 and NLR 32/16 s 3: the income supplement and seniors' benefit (yearly totals).
-- Single, $10,000: $254 (no phase-in below $15,000).
#ASSERT `How much income supplement and seniors' benefit do I get in the year` 2026 10000 FALSE 0 FALSE FALSE FALSE EQUALS `answered` 254
-- Single, $25,000: 254 + the lesser of 266 and 5.32% x 10,000 (532) = 520.
#ASSERT `How much income supplement and seniors' benefit do I get in the year` 2026 25000 FALSE 0 FALSE FALSE FALSE EQUALS `answered` 520
-- Couple with two children, $50,000: 254 + 266 + 69 + 462 = 1,051, less 9% x 10,000 = 900: 151.
#ASSERT `How much income supplement and seniors' benefit do I get in the year` 2025 50000 TRUE 2 FALSE FALSE FALSE EQUALS `answered` 151
-- Single senior, $20,000: 254 + 266 (5.32% x 5,000 = 266) = 520, plus the seniors' benefit 1,882: 2,402.
#ASSERT `How much income supplement and seniors' benefit do I get in the year` 2026 20000 FALSE 0 FALSE FALSE TRUE EQUALS `answered` 2402
-- The same senior eligible for the disability tax credit: plus 231 (adjusted income under $29,402): 2,633.
#ASSERT `How much income supplement and seniors' benefit do I get in the year` 2026 20000 FALSE 0 TRUE FALSE TRUE EQUALS `answered` 2633
-- Senior at $40,000: 520, plus 1,882 - 11.66% x 9,591 (1,118.3106) = 763.6894: 1,283.6894.
#ASSERT `How much income supplement and seniors' benefit do I get in the year` 2026 40000 FALSE 0 FALSE FALSE TRUE EQUALS `answered` 1283.69
-- Senior at $50,000: the supplement is phased out (900 > 520) and so is the benefit (11.66% x 19,591 > 1,882).
#ASSERT `How much income supplement and seniors' benefit do I get in the year` 2026 50000 FALSE 0 FALSE FALSE TRUE EQUALS `answered` 0
-- Disability amount at $39,402: 231 - 1.4% x 10,000 = 91.
#ASSERT `the disability amount` 39402 TRUE FALSE EQUALS 91
#ASSERT `How much income supplement and seniors' benefit do I get in the year` 2027 20000 FALSE 0 FALSE FALSE TRUE EQUALS `not covered` `only the 2025 and 2026 taxation years are encoded`
-- s 34(3): a quarter each specified month.
#ASSERT `How much is paid each quarter` 520 EQUALS 130
#ASSERT `How much is paid each quarter` 2402 EQUALS 600.50
-- s 34(10), (11): $30 a year is $7.50 a quarter, under $10: paid at once. $40 is $10 a quarter: not.
#ASSERT `Is it paid in one amount` 30
#ASSERT (`Is it paid in one amount` 40) EQUALS FALSE
#ASSERT (`Is it paid in one amount` 0) EQUALS FALSE

-- ---------------------------------------------------------------------------------------------------------------------
-- s 34(8): telling the Minister of National Revenue.
#ASSERT `Must I tell the CRA about the change` `someone became or stopped being my qualified relation`
#ASSERT `Must I tell the CRA about the change` `I stopped being an eligible individual`
#ASSERT (`Must I tell the CRA about the change` `a qualified dependant turned 19`) EQUALS FALSE
-- A change on 15 January 2026: by 28 February 2026. On 3 December 2026: by 31 January 2027. On 10 November 2026: by
-- 31 December 2026. On 31 January 2028: by 29 February 2028 (a leap year).
#ASSERT `By when must I tell the CRA` (Date 15 1 2026) EQUALS Date 28 2 2026
#ASSERT `By when must I tell the CRA` (Date 3 12 2026) EQUALS Date 31 1 2027
#ASSERT `By when must I tell the CRA` (Date 10 11 2026) EQUALS Date 31 12 2026
#ASSERT `By when must I tell the CRA` (Date 31 1 2028) EQUALS Date 29 2 2028
-- The regulative rule: from 15 January to 28 February 2026 is 44 days; notice on day 30 is in time.
#ASSERT ((`the last day of the month following` (Date 15 1 2026)) MINUS (Date 15 1 2026)) EQUALS 44
#ASSERT EVALTRACE (`my duty to notify the change` (Date 15 1 2026)) 0 (LIST EVENT `the individual` `notify the Minister of National Revenue of the event` 30) EQUALS FULFILLED
-- expect: BREACH BY `the individual`, "the change was not notified before the end of the month following the month in which it occurred (s 34(8))" -- notice on day 50, after the 44 days.
#TRACE `my duty to notify the change` (Date 15 1 2026) AT 0 WITH
    PARTY `the individual` DOES `notify the Minister of National Revenue of the event` AT 50
