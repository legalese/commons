IMPORT prelude
IMPORT `cdb-core`
IMPORT `cdb-seat`

-- Cases for the applicant's seat (cdb-seat.l4) and the regulative rules of the core (cdb-core.l4).
-- Every expected value was worked by hand from the deposited Regulations, never copied from the encoding's output; the
-- arithmetic is in the comment above each. No scenario life raised this Act: the people are the encoder's,
-- HYPOTHETICAL throughout.
--
-- For the payment period beginning July 2025 the indexing factor is 1 by the formula itself (s 6(5)). For the period
-- beginning July 2026 the cases use HYPOTHETICAL CPI figures (2024: 160; highest since: 164; factor 1.025), NOT
-- Statistics Canada's.
--
-- A breached or still-pending DEONTIC cannot be asserted on the stable l4, so regulative rules are asserted where the
-- trace ends FULFILLED, and #TRACEd with an "-- expect:" line where it does not. Clock: days.

-- =====================================================================================================================
-- Eligibility (s 2). Answers: age; turning 65 this month; DTC; resident; status; incarceration; filed; spouse; spouse
-- filed; waiver; suspended at own request.
-- =====================================================================================================================
#ASSERT `Am I eligible for the Canada disability benefit` 30 FALSE TRUE TRUE `a Canadian citizen` `not incarcerated` TRUE FALSE TRUE FALSE FALSE EQUALS `eligible for an allocation this month (s 2)`
#ASSERT `Am I eligible for the Canada disability benefit` 17 FALSE TRUE TRUE `a Canadian citizen` `not incarcerated` TRUE FALSE TRUE FALSE FALSE EQUALS `not eligible: under 18, or 65 or older (s 2(1)(a), (2))`
#ASSERT `Am I eligible for the Canada disability benefit` 64 FALSE TRUE TRUE `a Canadian citizen` `not incarcerated` TRUE FALSE TRUE FALSE FALSE EQUALS `eligible for an allocation this month (s 2)`
-- s 2(2): the month of turning 65.
#ASSERT `Am I eligible for the Canada disability benefit` 65 TRUE TRUE TRUE `a Canadian citizen` `not incarcerated` TRUE FALSE TRUE FALSE FALSE EQUALS `eligible for an allocation this month (s 2)`
-- The month after (finding 1).
#ASSERT `Am I eligible for the Canada disability benefit` 65 FALSE TRUE TRUE `a Canadian citizen` `not incarcerated` TRUE FALSE TRUE FALSE FALSE EQUALS `not eligible: under 18, or 65 or older (s 2(1)(a), (2))`
#ASSERT `Am I eligible for the Canada disability benefit` 30 FALSE FALSE TRUE `a Canadian citizen` `not incarcerated` TRUE FALSE TRUE FALSE FALSE EQUALS `not eligible: not a DTC-eligible individual (s 2(1)(b))`
-- s 2(1)(c)(iii): a temporary resident here under 18 months.
#ASSERT `Am I eligible for the Canada disability benefit` 30 FALSE TRUE TRUE `a temporary resident resident in Canada for less than 18 months` `not incarcerated` TRUE FALSE TRUE FALSE FALSE EQUALS `not eligible: not resident in Canada with a qualifying status (s 2(1)(c))`
#ASSERT `Am I eligible for the Canada disability benefit` 30 FALSE TRUE TRUE `a temporary resident resident in Canada for the previous 18 months` `not incarcerated` TRUE FALSE TRUE FALSE FALSE EQUALS `eligible for an allocation this month (s 2)`
-- A citizen not resident in Canada for income tax.
#ASSERT `Am I eligible for the Canada disability benefit` 30 FALSE TRUE FALSE `a Canadian citizen` `not incarcerated` TRUE FALSE TRUE FALSE FALSE EQUALS `not eligible: not resident in Canada with a qualifying status (s 2(1)(c))`
#ASSERT `Am I eligible for the Canada disability benefit` 30 FALSE TRUE TRUE `an Indian under the Indian Act` `not incarcerated` TRUE FALSE TRUE FALSE FALSE EQUALS `eligible for an allocation this month (s 2)`
-- s 2(1)(d), (3).
#ASSERT `Am I eligible for the Canada disability benefit` 30 FALSE TRUE TRUE `a Canadian citizen` `in a penitentiary for a sentence of two years or more` TRUE FALSE TRUE FALSE FALSE EQUALS `not eligible: in a penitentiary for a sentence of two years or more (s 2(1)(d))`
#ASSERT `Am I eligible for the Canada disability benefit` 30 FALSE TRUE TRUE `a Canadian citizen` `in a penitentiary for a sentence of two years or more, but this is the first month or the month of release` TRUE FALSE TRUE FALSE FALSE EQUALS `eligible for an allocation this month (s 2)`
-- s 2(1)(e).
#ASSERT `Am I eligible for the Canada disability benefit` 30 FALSE TRUE TRUE `a Canadian citizen` `not incarcerated` FALSE FALSE TRUE FALSE FALSE EQUALS `not eligible: no income tax return filed for the last year (s 2(1)(e))`
-- s 2(4): the spouse has not filed; (5): unless waived.
#ASSERT `Am I eligible for the Canada disability benefit` 30 FALSE TRUE TRUE `a Canadian citizen` `not incarcerated` TRUE TRUE FALSE FALSE FALSE EQUALS `not eligible: the cohabiting spouse or partner has not filed a return (s 2(4))`
#ASSERT `Am I eligible for the Canada disability benefit` 30 FALSE TRUE TRUE `a Canadian citizen` `not incarcerated` TRUE TRUE FALSE TRUE FALSE EQUALS `eligible for an allocation this month (s 2)`
-- s 2(6), s 11.
#ASSERT `Am I eligible for the Canada disability benefit` 30 FALSE TRUE TRUE `a Canadian citizen` `not incarcerated` TRUE FALSE TRUE FALSE TRUE EQUALS `not eligible: payment suspended at my request (s 2(6), s 11)`

-- =====================================================================================================================
-- Amount (s 6). Answers: period year; CPI 2024; highest CPI; then age ... filed (as above, without the spouse flag);
-- household; spouse filed; waiver; own adjusted income; family adjusted income; own working income; spouse's working
-- income; suspended.
-- =====================================================================================================================
-- s 6(5): for the period beginning 2025 the factor is 1, whatever CPI figures are entered.
#ASSERT `the indexing factor` 2025 150 999 EQUALS 1
#ASSERT `the indexing factor` 2026 160 164 EQUALS 1.025

-- Single, income 30,000, working 12,000: D = min(12,000, 10,000) = 10,000; B = 20% x (30,000 - 10,000 - 23,000) < 0,
-- so 0; (2,400 - 0)/12 = 200.
#ASSERT `How much Canada disability benefit can I get` 2025 1 1 30 FALSE TRUE TRUE `a Canadian citizen` `not incarcerated` TRUE `no cohabiting spouse or partner` TRUE FALSE 30000 0 12000 0 FALSE EQUALS `the amount, in Canadian dollars a month, is` 200
-- Single, 40,000 with 15,000 working: B = 20% x (40,000 - 10,000 - 23,000) = 1,400; (2,400 - 1,400)/12 = 83.333, 83.33.
#ASSERT `How much Canada disability benefit can I get` 2025 1 1 30 FALSE TRUE TRUE `a Canadian citizen` `not incarcerated` TRUE `no cohabiting spouse or partner` TRUE FALSE 40000 0 15000 0 FALSE EQUALS `the amount, in Canadian dollars a month, is` 83.33
-- Single, 45,000 with no work: B = 20% x 22,000 = 4,400 > 2,400: nothing (finding 3).
#ASSERT `How much Canada disability benefit can I get` 2025 1 1 30 FALSE TRUE TRUE `a Canadian citizen` `not incarcerated` TRUE `no cohabiting spouse or partner` TRUE FALSE 45000 0 0 0 FALSE EQUALS `the amount, in Canadian dollars a month, is` 0
-- Single, 44,000 with 10,000 working: B = 20% x 11,000 = 2,200; 200/12 = 16.666, 16.67; paid as a lump sum (s 8(2)).
#ASSERT `How much Canada disability benefit can I get` 2025 1 1 30 FALSE TRUE TRUE `a Canadian citizen` `not incarcerated` TRUE `no cohabiting spouse or partner` TRUE FALSE 44000 0 10000 0 FALSE EQUALS `the amount, in Canadian dollars a month, is` 16.67
#ASSERT `Is my Canada disability benefit paid as a lump sum` 16.67 EQUALS TRUE
#ASSERT `Is my Canada disability benefit paid as a lump sum` 20 EQUALS TRUE
#ASSERT `Is my Canada disability benefit paid as a lump sum` 20.01 EQUALS FALSE
-- s 6(3): spouse not a beneficiary; family 50,000; working 10,000 + 8,000 = 18,000, F = 14,000;
-- B = 20% x (50,000 - 14,000 - 32,500) = 700; (2,400 - 700)/12 = 141.666, 141.67.
#ASSERT `How much Canada disability benefit can I get` 2025 1 1 30 FALSE TRUE TRUE `a Canadian citizen` `not incarcerated` TRUE `a cohabiting spouse or partner who is not a beneficiary` TRUE FALSE 25000 50000 10000 8000 FALSE EQUALS `the amount, in Canadian dollars a month, is` 141.67
-- s 6(4): both beneficiaries: 10% x 3,500 = 350; (2,400 - 350)/12 = 170.833, 170.83 (finding 4).
#ASSERT `How much Canada disability benefit can I get` 2025 1 1 30 FALSE TRUE TRUE `a Canadian citizen` `not incarcerated` TRUE `a cohabiting spouse or partner who is also a beneficiary` TRUE FALSE 25000 50000 10000 8000 FALSE EQUALS `the amount, in Canadian dollars a month, is` 170.83
-- s 6(4.1): the spouse's filing condition waived: the single formula on own income 20,000: B = 0; 200.
#ASSERT `How much Canada disability benefit can I get` 2025 1 1 30 FALSE TRUE TRUE `a Canadian citizen` `not incarcerated` TRUE `a cohabiting spouse or partner who is not a beneficiary` FALSE TRUE 20000 90000 0 60000 FALSE EQUALS `the amount, in Canadian dollars a month, is` 200
-- Indexed period 2026 (factor 1.025), single, no income: 2,400 x 1.025 / 12 = 205.
#ASSERT `How much Canada disability benefit can I get` 2026 160 164 30 FALSE TRUE TRUE `a Canadian citizen` `not incarcerated` TRUE `no cohabiting spouse or partner` TRUE FALSE 0 0 0 0 FALSE EQUALS `the amount, in Canadian dollars a month, is` 205
-- Indexed, single, 30,000 and no work: threshold 23,000 x 1.025 = 23,575; B = 20% x 6,425 = 1,285;
-- (2,460 - 1,285)/12 = 97.9166, 97.92.
#ASSERT `How much Canada disability benefit can I get` 2026 160 164 30 FALSE TRUE TRUE `a Canadian citizen` `not incarcerated` TRUE `no cohabiting spouse or partner` TRUE FALSE 30000 0 0 0 FALSE EQUALS `the amount, in Canadian dollars a month, is` 97.92
-- Not eligible: no amount, and why.
#ASSERT `How much Canada disability benefit can I get` 2025 1 1 30 FALSE FALSE TRUE `a Canadian citizen` `not incarcerated` TRUE `no cohabiting spouse or partner` TRUE FALSE 0 0 0 0 FALSE EQUALS `no benefit this month` `not eligible: not a DTC-eligible individual (s 2(1)(b))`
-- With a spouse who has not filed: not eligible (s 2(4)).
#ASSERT `How much Canada disability benefit can I get` 2025 1 1 30 FALSE TRUE TRUE `a Canadian citizen` `not incarcerated` TRUE `a cohabiting spouse or partner who is not a beneficiary` FALSE FALSE 25000 50000 10000 8000 FALSE EQUALS `no benefit this month` `not eligible: the cohabiting spouse or partner has not filed a return (s 2(4))`

-- =====================================================================================================================
-- Supplemental amount (ss 2.1, 6.1) and start (ss 5, 7).
-- =====================================================================================================================
#ASSERT `Can I get the $150 supplemental amount` TRUE TRUE TRUE EQUALS 150
#ASSERT `Can I get the $150 supplemental amount` TRUE FALSE TRUE EQUALS 0
#ASSERT `Can I get the $150 supplemental amount` TRUE TRUE FALSE EQUALS 0
-- Eligible 30 months before applying: approval deemed 24 months back; allocation from the month after: 23 months back.
#ASSERT `How far back can my Canada disability benefit be paid` 30 EQUALS 23
-- Eligible 10 months back: 9 months back.
#ASSERT `How far back can my Canada disability benefit be paid` 10 EQUALS 9
-- Eligible only this month: from next month (-1).
#ASSERT `How far back can my Canada disability benefit be paid` 0 EQUALS (-1)

-- =====================================================================================================================
-- Regulative rules (cdb-core.l4). Day 0 is the day the rule starts.
-- =====================================================================================================================
-- Act s 6: information required and given on day 5: fulfilled; not required: nothing owed.
#ASSERT EVALTRACE (`Act s 6 -- an applicant must give the Minister the information required` TRUE) 0 (LIST (EVENT `the applicant or beneficiary` `provide the information the Minister requires` 5)) EQUALS FULFILLED
#ASSERT EVALTRACE (`Act s 6 -- an applicant must give the Minister the information required` FALSE) 0 (LIST (EVENT `the applicant or beneficiary` `provide the information the Minister requires` 5)) EQUALS FULFILLED
-- expect: an obligation still pending on the applicant (no period is set)
#TRACE `Act s 6 -- an applicant must give the Minister the information required` TRUE AT 0 WITH
    PARTY `the Minister` DOES `reconsider and notify the decision with reasons` AT 300

-- Regulations s 37(1): returned on day 4: fulfilled.
#ASSERT EVALTRACE `Regulations s 37(1) -- a person overpaid must return the overpayment as soon as feasible` 0 (LIST (EVENT `the applicant or beneficiary` `return the overpayment` 4)) EQUALS FULFILLED

-- Regulations s 18: asked on day 170 (within 180), decided on day 200: fulfilled.
#ASSERT EVALTRACE `Regulations s 18 -- I may ask for a reconsideration within 180 days, and the Minister must then reconsider and give reasons` 0 (LIST (EVENT `the applicant or beneficiary` `request a reconsideration` 170), (EVENT `the Minister` `reconsider and notify the decision with reasons` 200)) EQUALS FULFILLED
-- expect: the Minister's duty still pending after the request on day 170 ("within a reasonable time")
#TRACE `Regulations s 18 -- I may ask for a reconsideration within 180 days, and the Minister must then reconsider and give reasons` AT 0 WITH
    PARTY `the applicant or beneficiary` DOES `request a reconsideration` AT 170

-- Regulations s 19(1): extension asked 100 days after the 180 days ended: fulfilled.
#ASSERT EVALTRACE `Regulations s 19(1) -- I may ask for more time within 185 days after the 180 days end` 0 (LIST (EVENT `the applicant or beneficiary` `request an extension of the time to ask for a reconsideration` 100)) EQUALS FULFILLED

-- Regulations s 11(3): resumption asked on day 700 (within 24 months): fulfilled.
#ASSERT EVALTRACE `Regulations s 11(3) -- after asking for a suspension, I may ask for payment to resume within 24 months` 0 (LIST (EVENT `the applicant or beneficiary` `request resumption of payment` 700)) EQUALS FULFILLED
