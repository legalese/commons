IMPORT prelude
IMPORT daydate
IMPORT `cdba-nouns`
IMPORT `cdba-calendar`
IMPORT `cdba-reg-definitions`
IMPORT `cdba-reg-amount`
IMPORT `cdba-reg-penalties`

-- Tests for Regulations ss 35 and 36, with the working beside each assertion. The Consumer
-- Price Index figures are illustrative inputs, not published figures.

§ `Regulations s 35 -- tests`

-- A Consumer Price Index figure for one calendar year (illustrative).
GIVEN year IS A NUMBER
      cpi  IS A NUMBER
GIVETH A `Consumer Price Index figure`
`the figure for` year `is` cpi MEANS `Consumer Price Index figure` WITH
    `the calendar year of the figure` IS year
    `the annual average all-items Consumer Price Index for Canada, not seasonally adjusted` IS cpi

GIVEN knowing IS A BOOLEAN
      received IS A BOOLEAN
      mistaken IS A BOOLEAN
      prosecuted IS A BOOLEAN
      aware IS A DATE
GIVETH A `Violation facts`
`violation facts` knowing received mistaken prosecuted aware MEANS
    `Violation facts` WITH
        `knowingly made a false or misleading representation in relation to an application` IS knowing
        `made an application for, and received, a benefit knowing they were not eligible to receive it` IS received
        `the person mistakenly believed the representation true or believed they were eligible` IS mistaken
        `a prosecution for the act has been initiated against the person` IS prosecuted
        `the Minister became aware of the act on` IS aware

-- 35(1): either act is a violation.
#ASSERT `the person commits a violation` (`violation facts` TRUE FALSE FALSE FALSE (YMD 2026 3 10))
#ASSERT `the person commits a violation` (`violation facts` FALSE TRUE FALSE FALSE (YMD 2026 3 10))
#ASSERT `the person commits a violation` (`violation facts` TRUE TRUE FALSE FALSE (YMD 2026 3 10))
#ASSERT NOT `the person commits a violation` (`violation facts` FALSE FALSE FALSE FALSE (YMD 2026 3 10))

-- 35(5): a mistaken belief protects.
#ASSERT `the person is protected from a penalty by a mistaken belief` (`violation facts` TRUE FALSE TRUE FALSE (YMD 2026 3 10))
#ASSERT NOT `the person is protected from a penalty by a mistaken belief` (`violation facts` TRUE FALSE FALSE FALSE (YMD 2026 3 10))

-- 35(6): five years from awareness on 10 March 2026 are over at the end of 10 March 2031.
#ASSERT NOT `the time for imposing a penalty has run out` (`violation facts` TRUE FALSE FALSE FALSE (YMD 2026 3 10)) (YMD 2031 3 10)
#ASSERT `the time for imposing a penalty has run out` (`violation facts` TRUE FALSE FALSE FALSE (YMD 2026 3 10)) (YMD 2031 3 11)
#ASSERT NOT `the time for imposing a penalty has run out` (`violation facts` TRUE FALSE FALSE FALSE (YMD 2026 3 10)) (YMD 2027 1 1)
-- Aware on 29 February 2028: five years later is 28 February 2033 (clamped).
#ASSERT NOT `the time for imposing a penalty has run out` (`violation facts` TRUE FALSE FALSE FALSE (YMD 2028 2 29)) (YMD 2033 2 28)
#ASSERT `the time for imposing a penalty has run out` (`violation facts` TRUE FALSE FALSE FALSE (YMD 2028 2 29)) (YMD 2033 3 1)
-- A prosecution that has been started ends the time at once.
#ASSERT `the time for imposing a penalty has run out` (`violation facts` TRUE FALSE FALSE TRUE (YMD 2026 3 10)) (YMD 2027 1 1)

-- 35(2): the Minister's opinion, and none of the three bars.
#ASSERT `the Minister may impose a penalty` TRUE (`violation facts` TRUE FALSE FALSE FALSE (YMD 2026 3 10)) (YMD 2027 1 1)
#ASSERT NOT `the Minister may impose a penalty` FALSE (`violation facts` TRUE FALSE FALSE FALSE (YMD 2026 3 10)) (YMD 2027 1 1)
#ASSERT NOT `the Minister may impose a penalty` TRUE (`violation facts` TRUE FALSE TRUE FALSE (YMD 2026 3 10)) (YMD 2027 1 1)
#ASSERT NOT `the Minister may impose a penalty` TRUE (`violation facts` TRUE FALSE FALSE TRUE (YMD 2026 3 10)) (YMD 2027 1 1)
#ASSERT NOT `the Minister may impose a penalty` TRUE (`violation facts` TRUE FALSE FALSE FALSE (YMD 2026 3 10)) (YMD 2031 3 11)

-- 35(4): a violation on 15 June 2027. A penalty ten years before (15 June 2017) is inside the
-- ten years; a day earlier is outside; the day before the violation is inside; the day of it
-- and later days do not precede it.
#ASSERT `the violation is deemed to be a first violation` (YMD 2027 6 15) EMPTY
#ASSERT NOT `the violation is deemed to be a first violation` (YMD 2027 6 15) (LIST YMD 2017 6 15)
#ASSERT `the violation is deemed to be a first violation` (YMD 2027 6 15) (LIST YMD 2017 6 14)
#ASSERT NOT `the violation is deemed to be a first violation` (YMD 2027 6 15) (LIST YMD 2027 6 14)
#ASSERT `the violation is deemed to be a first violation` (YMD 2027 6 15) (LIST YMD 2027 6 15)
#ASSERT `the violation is deemed to be a first violation` (YMD 2027 6 15) (LIST YMD 2028 1 1)
#ASSERT NOT `the violation is deemed to be a first violation` (YMD 2027 6 15) (LIST YMD 2010 1 1, YMD 2020 1 1)
-- A violation on 29 February 2028: ten years before is 28 February 2018 (clamped).
#ASSERT NOT `the violation is deemed to be a first violation` (YMD 2028 2 29) (LIST YMD 2018 2 28)
#ASSERT `the violation is deemed to be a first violation` (YMD 2028 2 29) (LIST YMD 2018 2 27)

-- 35(3): the amounts. A violation on 15 June 2026 is in the payment period that began on
-- 1 July 2025: A = 1, basic amount 200.00, times 12 = 2,400; 15% = 360; 50% = 1,200.
#ASSERT `the penalty the Minister may issue` TRUE (YMD 2026 6 15) (LIST `the figure for` 2024 `is` 100) EQUALS JUST 360
#ASSERT `the penalty the Minister may issue` FALSE (YMD 2026 6 15) (LIST `the figure for` 2024 `is` 100) EQUALS JUST 1200
-- A violation on 15 September 2026 is in the period that began on 1 July 2026, with figures
-- 100 and 102: A = 1.02, basic amount 204.00, times 12 = 2,448; 15% = 367.20; 50% = 1,224.
#ASSERT `the penalty the Minister may issue` TRUE (YMD 2026 9 15) (LIST `the figure for` 2024 `is` 100, `the figure for` 2025 `is` 102) EQUALS JUST 367.2
#ASSERT `the penalty the Minister may issue` FALSE (YMD 2026 9 15) (LIST `the figure for` 2024 `is` 100, `the figure for` 2025 `is` 102) EQUALS JUST 1224
-- The basic amount is rounded to the cent before it is multiplied by 12: figures 99 and 100 give
-- A = 100/99, 2,400 x A / 12 = 202.0202... = 202.02; times 12 = 2,424.24; 15% = 363.636; 50% = 1,212.12.
#ASSERT `the penalty the Minister may issue` TRUE (YMD 2026 9 15) (LIST `the figure for` 2024 `is` 99, `the figure for` 2025 `is` 100) EQUALS JUST 363.636
#ASSERT `the penalty the Minister may issue` FALSE (YMD 2026 9 15) (LIST `the figure for` 2024 `is` 99, `the figure for` 2025 `is` 100) EQUALS JUST 1212.12
-- No indexing factor for the period that began on 1 July 2024, or without a 2024 figure: not covered.
#ASSERT `the penalty the Minister may issue` TRUE (YMD 2025 6 15) (LIST `the figure for` 2024 `is` 100) EQUALS NOTHING
#ASSERT `the penalty the Minister may issue` TRUE (YMD 2026 6 15) EMPTY EQUALS NOTHING

-- 35(7): new facts, or the Minister's satisfaction.
#ASSERT `the Minister may rescind the penalty` TRUE FALSE
#ASSERT `the Minister may rescind the penalty` FALSE TRUE
#ASSERT NOT `the Minister may rescind the penalty` FALSE FALSE

§ `Regulations s 36 -- tests`

#ASSERT `the person is guilty of an offence punishable on summary conviction` TRUE FALSE FALSE
#ASSERT `the person is guilty of an offence punishable on summary conviction` FALSE TRUE FALSE
#ASSERT `the person is guilty of an offence punishable on summary conviction` FALSE FALSE TRUE
#ASSERT NOT `the person is guilty of an offence punishable on summary conviction` FALSE FALSE FALSE
#ASSERT `a proceeding may be commenced under section 36 or the Criminal Code for the act` FALSE
#ASSERT NOT `a proceeding may be commenced under section 36 or the Criminal Code for the act` TRUE
