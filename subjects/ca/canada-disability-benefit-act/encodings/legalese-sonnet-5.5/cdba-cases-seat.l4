#ASSERT `Who decides a ground of my appeal that says the Minister got my income wrong` FALSE EQUALS `the Social Security Tribunal`

-- Will the Tribunal now go on to the other grounds of my appeal (Regs s 29)?
#ASSERT `Will the Tribunal now go on to the other grounds of my appeal` TRUE TRUE
#ASSERT NOT `Will the Tribunal now go on to the other grounds of my appeal` TRUE FALSE

-- Will another person be made a party to my appeal (Regs s 23)?
#ASSERT `Will another person be made a party to my appeal` TRUE TRUE
#ASSERT NOT `Will another person be made a party to my appeal` TRUE FALSE

-- Where will the hearing of my reference be held (Regs s 24(2))?
#ASSERT `Where will the hearing of my reference be held` FALSE EQUALS `the city, town or village in which, or nearest to which, the appellant is ordinarily resident`
#ASSERT `Where will the hearing of my reference be held` TRUE EQUALS `another place, or by audioconference or videoconference, with the appellant's written consent`

-- Must the Registrar tell me by registered mail when my hearing is set (Regs s 24(3))?
#ASSERT `Must the Registrar tell me by registered mail when my hearing is set` TRUE
#ASSERT NOT `Must the Registrar tell me by registered mail when my hearing is set` FALSE

-- Can the judge make me file written submissions (Regs s 26)?
#ASSERT NOT `Can the judge make me file written submissions` FALSE
#ASSERT `Can the judge make me file written submissions` TRUE

-- Can I be made to pay costs or fees on a reference to the Tax Court (Regs s 28)?
#ASSERT NOT `Can I be made to pay costs or fees on a reference to the Tax Court`


