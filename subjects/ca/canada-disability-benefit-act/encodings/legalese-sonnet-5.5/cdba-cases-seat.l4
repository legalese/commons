§§ `Regulations ss 35 and 36 -- Penalties and offences`

-- Have I committed a violation (Regs s 35(1))?
#ASSERT `Have I committed a violation` TRUE FALSE
#ASSERT `Have I committed a violation` FALSE TRUE
#ASSERT NOT `Have I committed a violation` FALSE FALSE

-- Can the Minister impose a penalty on me (Regs s 35(2), 35(5), 35(6))?
-- The Minister's opinion, no mistaken belief, no prosecution, well within five years.
#ASSERT `Can the Minister impose a penalty on me` TRUE FALSE FALSE FALSE FALSE (YMD 2026 3 10) (YMD 2027 1 1)
#ASSERT NOT `Can the Minister impose a penalty on me` FALSE FALSE FALSE FALSE FALSE (YMD 2026 3 10) (YMD 2027 1 1)
-- A mistaken belief protects me (s 35(5)).
#ASSERT NOT `Can the Minister impose a penalty on me` TRUE FALSE FALSE TRUE FALSE (YMD 2026 3 10) (YMD 2027 1 1)
-- A prosecution has been started (s 35(6)(a)).
#ASSERT NOT `Can the Minister impose a penalty on me` TRUE FALSE FALSE FALSE TRUE (YMD 2026 3 10) (YMD 2027 1 1)
-- Five years after 10 March 2026 are not over until the end of 10 March 2031.
#ASSERT `Can the Minister impose a penalty on me` TRUE FALSE FALSE FALSE FALSE (YMD 2026 3 10) (YMD 2031 3 10)
-- Five years have passed (s 35(6)(b)).
#ASSERT NOT `Can the Minister impose a penalty on me` TRUE FALSE FALSE FALSE FALSE (YMD 2026 3 10) (YMD 2031 3 11)

-- Is this a first violation for me (Regs s 35(4))?
-- No earlier penalty.
#ASSERT `Is this a first violation for me` (YMD 2027 6 15) FALSE (YMD 2020 1 1)
-- A penalty exactly ten years before is inside the ten years.
#ASSERT NOT `Is this a first violation for me` (YMD 2027 6 15) TRUE (YMD 2017 6 15)
-- A penalty a day more than ten years before is outside them.
#ASSERT `Is this a first violation for me` (YMD 2027 6 15) TRUE (YMD 2017 6 14)

-- How large could my penalty be (Regs s 35(3))?
-- Violation on 15 June 2026, in the period that began on 1 July 2025 (A = 1): 12 x 200.00 = 2,400; 15% = 360.
#ASSERT `How large could my penalty be` TRUE (YMD 2026 6 15) 100 0 0 EQUALS JUST 360
-- A subsequent violation: 50% of 2,400.
#ASSERT `How large could my penalty be` FALSE (YMD 2026 6 15) 100 0 0 EQUALS JUST 1200
-- 15 September 2026, indices 100 and 102 (A = 1.02): basic amount 204.00; 12 x 204.00 = 2,448; 15% = 367.20.
#ASSERT `How large could my penalty be` TRUE (YMD 2026 9 15) 100 102 0 EQUALS JUST 367.2
-- A violation in the payment period that began on 1 July 2024: no indexing factor, so not covered.
#ASSERT `How large could my penalty be` TRUE (YMD 2025 6 15) 100 0 0 EQUALS NOTHING

-- Can the Minister cancel a penalty imposed on me (Regs s 35(7))?
#ASSERT `Can the Minister cancel a penalty imposed on me` TRUE FALSE
#ASSERT `Can the Minister cancel a penalty imposed on me` FALSE TRUE
#ASSERT NOT `Can the Minister cancel a penalty imposed on me` FALSE FALSE

-- Am I guilty of an offence (Regs s 36(1))?
#ASSERT `Am I guilty of an offence` TRUE FALSE FALSE
#ASSERT `Am I guilty of an offence` FALSE TRUE FALSE
#ASSERT `Am I guilty of an offence` FALSE FALSE TRUE
#ASSERT NOT `Am I guilty of an offence` FALSE FALSE FALSE

-- Can I still be prosecuted for an act if a penalty was imposed for it (Regs s 36(2))?
#ASSERT NOT `Can I still be prosecuted for an act if a penalty was imposed for it` TRUE
#ASSERT `Can I still be prosecuted for an act if a penalty was imposed for it` FALSE


§§ `Act s 9 and Regulations ss 37 to 40 -- Overpayments, debts and recovery`

-- Can my benefit be taken to pay another debt or claim (Act s 9)?
#ASSERT `Can my benefit be taken to pay another debt or claim` `an operation of a law relating to bankruptcy or insolvency` EQUALS `the benefit is shielded from the claim`
#ASSERT `Can my benefit be taken to pay another debt or claim` `an assignment, charge, attachment or giving as security` EQUALS `the benefit is shielded from the claim`
#ASSERT `Can my benefit be taken to pay another debt or claim` `a retention by deduction, set-off or compensation under an Act of Parliament other than the Act` EQUALS `the benefit is shielded from the claim`
#ASSERT `Can my benefit be taken to pay another debt or claim` `a retention by deduction, set-off or compensation under the Act` EQUALS `section 9 does not shield the benefit from the claim`
#ASSERT `Can my benefit be taken to pay another debt or claim` `a garnishment for the purposes of the Family Orders and Agreements Enforcement Assistance Act` EQUALS `the benefit is garnishable moneys`
-- Not covered: section 9 says nothing about any other claim.
#ASSERT `Can my benefit be taken to pay another debt or claim` `any other claim` EQUALS `the text does not say`

-- What do I owe if I was paid more than I was entitled to (Regs s 37(1))?
#ASSERT `What do I owe if I was paid more than I was entitled to` 500 300 EQUALS 200
#ASSERT `What do I owe if I was paid more than I was entitled to` 500 500 EQUALS 0
-- A payment I was not entitled to at all.
#ASSERT `What do I owe if I was paid more than I was entitled to` 100 0 EQUALS 100

-- From what day is the overpayment a debt I owe (Regs s 37(2))?
#ASSERT `From what day is the overpayment a debt I owe` 500 300 (YMD 2026 3 1) EQUALS JUST (YMD 2026 3 1)
-- Nothing was overpaid, so there is no debt.
#ASSERT `From what day is the overpayment a debt I owe` 500 500 (YMD 2026 3 1) EQUALS NOTHING

-- Can I pay what I owe in instalments (Regs s 37(3))?
#ASSERT `Can I pay what I owe in instalments` TRUE TRUE
#ASSERT NOT `Can I pay what I owe in instalments` FALSE TRUE
#ASSERT NOT `Can I pay what I owe in instalments` TRUE FALSE

-- Will I be charged interest on what I owe (Regs s 37(4), 37(5))?
-- An ordinary overpayment: no interest.
#ASSERT NOT `Will I be charged interest on what I owe` FALSE FALSE
-- Because of a penalised violation, and no remedy open or pending: interest is payable.
#ASSERT `Will I be charged interest on what I owe` TRUE FALSE
#ASSERT NOT `Will I be charged interest on what I owe` TRUE TRUE

-- From what day is a penalty I was given a debt I owe (Regs s 38(1))?
-- A debt from the day it was imposed.
#ASSERT `From what day is a penalty I was given a debt I owe` (YMD 2026 8 12) EQUALS YMD 2026 8 12

-- Does interest run on my penalty (Regs s 38(2))?
#ASSERT NOT `Does interest run on my penalty` TRUE
#ASSERT `Does interest run on my penalty` FALSE

-- By what day must action be taken to recover money I owe (Regs s 39(1), 39(2))?
#ASSERT `By what day must action be taken to recover money I owe` (YMD 2026 1 1) 0 EQUALS YMD 2031 12 31
#ASSERT `By what day must action be taken to recover money I owe` (YMD 2026 1 1) 30 EQUALS YMD 2032 1 30
#ASSERT `By what day must action be taken to recover money I owe` (YMD 2028 2 29) 0 EQUALS YMD 2034 2 28

-- Does the six-year limit apply to the proceedings against me (Regs s 39(3))?
#ASSERT `Does the six-year limit apply to the proceedings against me` FALSE
#ASSERT NOT `Does the six-year limit apply to the proceedings against me` TRUE

-- When may the Minister certify what I owe (Regs s 40(1))?
-- 30 days after the default.
#ASSERT `When may the Minister certify what I owe` (YMD 2027 1 10) FALSE EQUALS YMD 2027 2 9
-- Without delay.
#ASSERT `When may the Minister certify what I owe` (YMD 2027 1 10) TRUE EQUALS YMD 2027 1 10

-- Can the Minister take money that someone owes me (Regs s 40(6))?
#ASSERT `Can the Minister take money that someone owes me` TRUE TRUE
#ASSERT NOT `Can the Minister take money that someone owes me` FALSE TRUE
#ASSERT NOT `Can the Minister take money that someone owes me` TRUE FALSE

-- If someone does not pay the Minister as a garnishment notice requires, is the amount a debt (Regs s 40(7))?
#ASSERT `Is an amount not paid as a garnishment notice requires a debt due to His Majesty` TRUE TRUE
#ASSERT NOT `Is an amount not paid as a garnishment notice requires a debt due to His Majesty` TRUE FALSE
