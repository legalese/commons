IMPORT prelude
IMPORT daydate
IMPORT `cdba-nouns`
IMPORT `cdba-calendar`
IMPORT `cdba-reg-suspension`

-- Tests for Regulations ss 10 and 11, with the working beside each assertion.

§ `Regulations s 10 -- tests`

-- 10(1): either ground is enough; neither is not.
#ASSERT `the Minister may suspend payment of the allocation` TRUE FALSE
#ASSERT `the Minister may suspend payment of the allocation` FALSE TRUE
#ASSERT `the Minister may suspend payment of the allocation` TRUE TRUE
#ASSERT NOT `the Minister may suspend payment of the allocation` FALSE FALSE
-- "until the Minister is satisfied": once satisfied the suspension may not be kept.
#ASSERT `the Minister may keep payment of the allocation suspended` FALSE
#ASSERT NOT `the Minister may keep payment of the allocation suspended` TRUE
-- 10(2): only a suspended beneficiary, after a reasonable time, with no review yet.
#ASSERT `the Minister has not reviewed the beneficiary's eligibility within a reasonable time` TRUE TRUE FALSE
#ASSERT NOT `the Minister has not reviewed the beneficiary's eligibility within a reasonable time` TRUE TRUE TRUE
#ASSERT NOT `the Minister has not reviewed the beneficiary's eligibility within a reasonable time` TRUE FALSE FALSE
#ASSERT NOT `the Minister has not reviewed the beneficiary's eligibility within a reasonable time` FALSE TRUE FALSE
-- 10(3): lifted means resume and pay the sum of the months' amounts (here three months of 166.67).
#ASSERT `the Minister must resume payment and pay a lump sum` TRUE
#ASSERT NOT `the Minister must resume payment and pay a lump sum` FALSE
#ASSERT `the lump sum on lifting a suspension` (LIST 166.67, 166.67, 166.67) EQUALS 500.01
#ASSERT `the lump sum on lifting a suspension` (LIST 166.67, 0, 178.33) EQUALS 345
#ASSERT `the lump sum on lifting a suspension` EMPTY EQUALS 0

§ `Regulations s 11 -- tests`

-- 11(2): the later of the last day of the processing month and the indicated day.
#ASSERT `the day on which payment of the allocation is suspended` TRUE (YearMonthDay 2025 8 10) NOTHING EQUALS JUST (YearMonthDay 2025 8 31)
#ASSERT `the day on which payment of the allocation is suspended` TRUE (YearMonthDay 2025 8 10) (JUST (YearMonthDay 2025 9 15)) EQUALS JUST (YearMonthDay 2025 9 15)
#ASSERT `the day on which payment of the allocation is suspended` TRUE (YearMonthDay 2025 8 10) (JUST (YearMonthDay 2025 8 5)) EQUALS JUST (YearMonthDay 2025 8 31)
#ASSERT `the day on which payment of the allocation is suspended` TRUE (YearMonthDay 2025 8 10) (JUST (YearMonthDay 2025 8 31)) EQUALS JUST (YearMonthDay 2025 8 31)
#ASSERT `the day on which payment of the allocation is suspended` TRUE (YearMonthDay 2028 2 15) NOTHING EQUALS JUST (YearMonthDay 2028 2 29)
-- 11(1): a request not in writing is not a request under s 11(1).
#ASSERT `the day on which payment of the allocation is suspended` FALSE (YearMonthDay 2025 8 10) NOTHING EQUALS NOTHING
-- 11(3): suspended 31 August 2025, 24 months later is 31 August 2027.
#ASSERT `a request to resume payment is made in time` (YearMonthDay 2025 8 31) (YearMonthDay 2027 8 31) TRUE
#ASSERT NOT `a request to resume payment is made in time` (YearMonthDay 2025 8 31) (YearMonthDay 2027 9 1) TRUE
#ASSERT NOT `a request to resume payment is made in time` (YearMonthDay 2025 8 31) (YearMonthDay 2026 1 5) FALSE
-- Suspended 29 February 2028: 24 months later is 28 February 2030 (clamped).
#ASSERT `a request to resume payment is made in time` (YearMonthDay 2028 2 29) (YearMonthDay 2030 2 28) TRUE
#ASSERT NOT `a request to resume payment is made in time` (YearMonthDay 2028 2 29) (YearMonthDay 2030 3 1) TRUE
-- Deemed ceased: no request in time and the 24 months have run out.
#ASSERT `the allocation is deemed to have ceased and a new application is needed` (YearMonthDay 2025 8 31) NOTHING (YearMonthDay 2027 9 1)
#ASSERT NOT `the allocation is deemed to have ceased and a new application is needed` (YearMonthDay 2025 8 31) NOTHING (YearMonthDay 2027 8 31)
#ASSERT NOT `the allocation is deemed to have ceased and a new application is needed` (YearMonthDay 2025 8 31) (JUST (YearMonthDay 2027 8 31)) (YearMonthDay 2030 1 1)
#ASSERT NOT `the allocation is deemed to have ceased and a new application is needed` (YearMonthDay 2025 8 31) (JUST (YearMonthDay 2026 1 5)) (YearMonthDay 2026 6 1)
-- 11(4): both a request and the Minister's satisfaction.
#ASSERT `the Minister must resume payment of the allocation` TRUE TRUE
#ASSERT NOT `the Minister must resume payment of the allocation` TRUE FALSE
#ASSERT NOT `the Minister must resume payment of the allocation` FALSE TRUE
-- 11(5): the later of the month after receipt and the month indicated.
#ASSERT `the month in which payment of the allocation resumes` (YearMonthDay 2025 10 10) NOTHING EQUALS YearMonthDay 2025 11 1
#ASSERT `the month in which payment of the allocation resumes` (YearMonthDay 2025 10 10) (JUST (YearMonthDay 2025 12 20)) EQUALS YearMonthDay 2025 12 1
#ASSERT `the month in which payment of the allocation resumes` (YearMonthDay 2025 10 10) (JUST (YearMonthDay 2025 9 20)) EQUALS YearMonthDay 2025 11 1
#ASSERT `the month in which payment of the allocation resumes` (YearMonthDay 2025 10 10) (JUST (YearMonthDay 2025 11 20)) EQUALS YearMonthDay 2025 11 1
#ASSERT `the month in which payment of the allocation resumes` (YearMonthDay 2025 12 20) NOTHING EQUALS YearMonthDay 2026 1 1
