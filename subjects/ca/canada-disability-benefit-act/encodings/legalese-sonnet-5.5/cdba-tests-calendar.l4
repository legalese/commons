IMPORT prelude
IMPORT daydate
IMPORT `cdba-calendar`

-- Tests for the calendar helpers. Expected values are decided from the calendar,
-- not from the code: 2024 is a leap year, 2025 and 2026 are not.

§ `Calendar helpers -- tests`

-- The shim reads year, month, day and builds the same date as the day-first `Date`.
#ASSERT YearMonthDay 2025 7 1 EQUALS Date 1 7 2025
#ASSERT YearMonthDay 2026 6 30 EQUALS Date 30 6 2026

-- Month numbers rise by one per month, across a year end.
#ASSERT `the month number of` (YearMonthDay 2025 12 31) PLUS 1 EQUALS `the month number of` (YearMonthDay 2026 1 1)
#ASSERT `the month number of` (YearMonthDay 2026 1 15) MINUS `the month number of` (YearMonthDay 2025 1 15) EQUALS 12

-- First and last days, including February in a leap year and in a common year.
#ASSERT `the first day of the month of` (YearMonthDay 2025 7 19) EQUALS YearMonthDay 2025 7 1
#ASSERT `the last day of the month of` (YearMonthDay 2025 7 19) EQUALS YearMonthDay 2025 7 31
#ASSERT `the last day of the month of` (YearMonthDay 2024 2 10) EQUALS YearMonthDay 2024 2 29
#ASSERT `the last day of the month of` (YearMonthDay 2025 2 10) EQUALS YearMonthDay 2025 2 28
#ASSERT `the last day of the month of` (YearMonthDay 2025 6 1) EQUALS YearMonthDay 2025 6 30

-- The first day of the month after: December rolls into the next January.
#ASSERT `the first day of the month after the month of` (YearMonthDay 2025 12 31) EQUALS YearMonthDay 2026 1 1
#ASSERT `the first day of the month after the month of` (YearMonthDay 2025 6 30) EQUALS YearMonthDay 2025 7 1

-- Which month a day falls in, on both sides of a month boundary.
#ASSERT `the day` (YearMonthDay 2025 6 30) `falls in the month of` (YearMonthDay 2025 6 1)
#ASSERT NOT (`the day` (YearMonthDay 2025 7 1) `falls in the month of` (YearMonthDay 2025 6 30))
#ASSERT NOT (`the day` (YearMonthDay 2024 6 15) `falls in the month of` (YearMonthDay 2025 6 15))

-- Later and earlier of two dates, and a tie.
#ASSERT `the later day of` (YearMonthDay 2025 6 1) `and` (YearMonthDay 2025 7 1) EQUALS YearMonthDay 2025 7 1
#ASSERT `the earlier day of` (YearMonthDay 2025 6 1) `and` (YearMonthDay 2025 7 1) EQUALS YearMonthDay 2025 6 1
#ASSERT `the later day of` (YearMonthDay 2025 6 1) `and` (YearMonthDay 2025 6 1) EQUALS YearMonthDay 2025 6 1

-- Counting months forward, from any day of the first month to any day of the second.
#ASSERT `the number of months from the month of` (YearMonthDay 2025 6 30) `to the month of` (YearMonthDay 2025 7 1) EQUALS 1
#ASSERT `the number of months from the month of` (YearMonthDay 2025 7 1) `to the month of` (YearMonthDay 2026 6 30) EQUALS 11
#ASSERT `the number of months from the month of` (YearMonthDay 2025 7 31) `to the month of` (YearMonthDay 2025 7 1) EQUALS 0
