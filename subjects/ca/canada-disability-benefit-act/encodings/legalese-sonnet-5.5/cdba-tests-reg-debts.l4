IMPORT prelude
IMPORT daydate
IMPORT `cdba-nouns`
IMPORT `cdba-calendar`
IMPORT `cdba-reg-amount`
IMPORT `cdba-reg-debts`

-- Tests for Regulations ss 37 to 40 and 42, with the working beside each assertion.

§ `Regulations s 37 -- tests`

-- 37(1): paid 500 against an entitlement of 300 is an overpayment of 200; paid exactly what was
-- due, or less, is nothing to return; paid 100 against no entitlement is an erroneous payment of 100.
#ASSERT `the amount that must be returned` 500 300 EQUALS 200
#ASSERT `the amount that must be returned` 300 300 EQUALS 0
#ASSERT `the amount that must be returned` 200 300 EQUALS 0
#ASSERT `the amount that must be returned` 100 0 EQUALS 100
-- 37(2): a debt from the day paid, only if there is something to return.
#ASSERT `the day from which the erroneous payment or overpayment is a debt due to His Majesty` 500 300 (YMD 2026 3 1) EQUALS JUST (YMD 2026 3 1)
#ASSERT `the day from which the erroneous payment or overpayment is a debt due to His Majesty` 300 300 (YMD 2026 3 1) EQUALS NOTHING
-- 37(3): instalments need the Minister's agreement and a sum that does not cause undue hardship.
#ASSERT `the debt may be paid in instalments` TRUE TRUE
#ASSERT NOT `the debt may be paid in instalments` TRUE FALSE
#ASSERT NOT `the debt may be paid in instalments` FALSE TRUE
-- 37(4) and (5): no interest on an ordinary overpayment; for a payment made because of a
-- penalised violation or a sentenced offence, interest only once no reconsideration,
-- judicial review or appeal can be made or is pending.
#ASSERT NOT `interest is payable on the amount owing` FALSE FALSE
#ASSERT NOT `interest is payable on the amount owing` FALSE TRUE
#ASSERT `interest is payable on the amount owing` TRUE FALSE
#ASSERT NOT `interest is payable on the amount owing` TRUE TRUE

§ `Regulations s 38 -- tests`

#ASSERT `the day from which a penalty is a debt due to His Majesty` (YMD 2026 9 1) EQUALS YMD 2026 9 1
#ASSERT `interest accrues on the penalty debt` FALSE
#ASSERT NOT `interest accrues on the penalty debt` TRUE

§ `Regulations s 39 -- tests`

-- The six-year period that begins on 1 January 2026 ends on 31 December 2031; on 15 June 2026,
-- 14 June 2032; on 31 December 2026, 30 December 2032; with 30 days suspended, 30 days later.
#ASSERT `the last day on which an action to recover money may be taken` (YMD 2026 1 1) 0 EQUALS YMD 2031 12 31
#ASSERT `the last day on which an action to recover money may be taken` (YMD 2026 6 15) 0 EQUALS YMD 2032 6 14
#ASSERT `the last day on which an action to recover money may be taken` (YMD 2026 12 31) 0 EQUALS YMD 2032 12 30
#ASSERT `the last day on which an action to recover money may be taken` (YMD 2026 1 1) 30 EQUALS YMD 2032 1 30
-- Due on 29 February 2028: six years from then is 29 February 2034, which does not exist, so the
-- period beginning on the day ends on 28 February 2034.
#ASSERT `the last day on which an action to recover money may be taken` (YMD 2028 2 29) 0 EQUALS YMD 2034 2 28
-- 39(3).
#ASSERT `the six-year limitation period applies` FALSE
#ASSERT NOT `the six-year limitation period applies` TRUE

§ `Regulations s 40 -- tests`

-- 40(1): without delay if the debtor is attempting to avoid payment; otherwise 30 days after the
-- default (10 January + 30 days = 9 February).
#ASSERT `the earliest day on which the unrecovered debt may be certified` (YMD 2027 1 10) TRUE EQUALS YMD 2027 1 10
#ASSERT `the earliest day on which the unrecovered debt may be certified` (YMD 2027 1 10) FALSE EQUALS YMD 2027 2 9
-- 40(6) and (7).
#ASSERT `the Minister may require the money to be paid to the Receiver General` TRUE TRUE
#ASSERT NOT `the Minister may require the money to be paid to the Receiver General` TRUE FALSE
#ASSERT NOT `the Minister may require the money to be paid to the Receiver General` FALSE TRUE
#ASSERT `the unpaid amount is a debt due to His Majesty` TRUE TRUE
#ASSERT NOT `the unpaid amount is a debt due to His Majesty` TRUE FALSE
#ASSERT NOT `the unpaid amount is a debt due to His Majesty` FALSE TRUE

§ `Regulations s 42 -- tests`

#ASSERT `the day the Regulations come into force` EQUALS YMD 2025 5 15
