IMPORT prelude
IMPORT `oas-core`
IMPORT `oas-seat`

-- Cases for the applicant's seat (oas-seat.l4) and the regulative rules of the core (oas-core.l4).
-- Every expected value was worked by hand from the deposited Act and Regulations, never copied from the encoding's
-- output; the arithmetic is in the comment above each. No scenario life raised this Act: the people are the encoder's,
-- HYPOTHETICAL throughout.
--
-- HYPOTHETICAL QUARTER FIGURES. The indexed amounts are inputs and none is deposited, so the cases use round figures
-- that are NOT the published ones: full monthly pension $750; maximum supplement $1,000 (single rate) and $600
-- (pensioner couple rate, also the supplement equivalent); supplement equivalent for the survivor $900; the $50 top-up
-- figure $200; the $35 top-up figure $120.
--
-- A breached or still-pending DEONTIC cannot be asserted on the stable l4, so regulative rules are asserted where the
-- trace ends FULFILLED, and #TRACEd with an "-- expect:" line where it does not. Clock: days.

`hypothetical figures` MEANS `the quarter's figures from my answers` 750 1000 600 900 200 120

-- =====================================================================================================================
-- Part I: who may be paid a pension. Answers in order: age; years in Canada after 18; resident the day before approval;
-- citizen or legal resident; the 1977 route; the last 10 years; years present before them; years absent during them;
-- the last year.
-- =====================================================================================================================

-- s 3(1)(c): 65 with 45 years after 18: full.
#ASSERT `Can I get an OAS pension` 65 45 TRUE TRUE FALSE TRUE 0 0 TRUE EQUALS `a full pension (s 3(1))`
-- s 3(2)-(4): 66 with 23.7 years: partial, rounded down to 23 fortieths.
#ASSERT `Can I get an OAS pension` 66 23.7 TRUE TRUE FALSE TRUE 0 0 TRUE EQUALS `a partial pension (s 3(2)), in fortieths` 23
-- s 3(2)(b): 15 years and living in Canada the day before approval: partial, 15 fortieths.
#ASSERT `Can I get an OAS pension` 65 15 TRUE TRUE FALSE TRUE 0 0 TRUE EQUALS `a partial pension (s 3(2)), in fortieths` 15
-- s 3(2)(b): 15 years (under 20) and living abroad the day before approval: none.
#ASSERT `Can I get an OAS pension` 65 15 FALSE TRUE FALSE FALSE 0 0 FALSE EQUALS `no pension: under 20 years of residence and not resident on the day before approval (s 3(2)(b))`
-- 25 years and living abroad: s 3(2)(b) asks residence the day before only "where that aggregate period is less than twenty years".
#ASSERT `Can I get an OAS pension` 67 25 FALSE TRUE FALSE FALSE 0 0 FALSE EQUALS `a partial pension (s 3(2)), in fortieths` 25
-- s 3: 64 is too young.
#ASSERT `Can I get an OAS pension` 64 45 TRUE TRUE FALSE TRUE 0 0 TRUE EQUALS `no pension: under 65 (s 3)`
-- s 3(2)(b): 8 years.
#ASSERT `Can I get an OAS pension` 65 8 TRUE TRUE FALSE TRUE 0 0 TRUE EQUALS `no pension: under 10 years of residence after 18, unless a social security agreement applies (s 3(2)(b))`
-- s 4(1): not a citizen and not legally resident.
#ASSERT `Can I get an OAS pension` 65 45 TRUE FALSE FALSE TRUE 0 0 TRUE EQUALS `no pension: not a citizen or legal resident (s 4(1))`
-- s 3(1)(b): 25 or older in 1977, only 30 years after 18, but the last 10 years in Canada: full.
#ASSERT `Can I get an OAS pension` 75 30 TRUE TRUE TRUE TRUE 0 0 TRUE EQUALS `a full pension (s 3(1))`
-- s 3(1)(b)(iii): not the last 10 years, but 12 years present before them = 3 x 4 years absent, and the last year: full.
#ASSERT `Can I get an OAS pension` 75 25 TRUE TRUE TRUE FALSE 12 4 TRUE EQUALS `a full pension (s 3(1))`
-- 12 < 3 x 5: the 1977 route fails, and 25 years gives a partial pension.
#ASSERT `Can I get an OAS pension` 75 25 TRUE TRUE TRUE FALSE 12 5 TRUE EQUALS `a partial pension (s 3(2)), in fortieths` 25

-- =====================================================================================================================
-- Part I: the amount. Answers: full pension; age; years at approval; resident day before; legal; years when first
-- qualified; months deferred to approval; months to age 70; suspended months; past the month of turning 75.
-- =====================================================================================================================

-- Full pension taken at 65: $750.
#ASSERT `How much is my OAS pension` 750 65 45 TRUE TRUE 45 0 60 0 FALSE EQUALS `the amount, in Canadian dollars a month, is` 750
-- s 7.1(1): deferred 60 months to 70: 750 x (1 + 0.006 x 60) = 750 x 1.36 = 1,020.00.
#ASSERT `How much is my OAS pension` 750 70 50 TRUE TRUE 45 60 60 0 FALSE EQUALS `the amount, in Canadian dollars a month, is` 1020
-- s 7.1(4)(b): deferred 72 months to 71; the months after 70 do not count: still 1,020.00.
#ASSERT `How much is my OAS pension` 750 71 51 TRUE TRUE 45 72 60 0 FALSE EQUALS `the amount, in Canadian dollars a month, is` 1020
-- s 7(5): past 75, no deferral: 750 x 1.1 = 825.00.
#ASSERT `How much is my OAS pension` 750 76 56 TRUE TRUE 45 0 60 0 TRUE EQUALS `the amount, in Canadian dollars a month, is` 825
-- s 7.1(5): deferred to 70 and now past 75: 1,020 x 1.1 = 1,122.00.
#ASSERT `How much is my OAS pension` 750 70 50 TRUE TRUE 45 60 60 0 TRUE EQUALS `the amount, in Canadian dollars a month, is` 1122
-- s 7.1(3): partial, 22 years at 65, approved 12 months later with 23 years.
-- (b) 750 x 22/40 = 412.50, x 1.072 = 442.20; (c) 750 x 23/40 = 431.25. The greater: 442.20.
#ASSERT `How much is my OAS pension` 750 66 23 TRUE TRUE 22 12 60 0 FALSE EQUALS `the amount, in Canadian dollars a month, is` 442.2
-- s 7.1(3): 20 years at 65, deferred 60 months to 70 with 25 years: (b) 375 x 1.36 = 510.00; (c) 750 x 25/40 = 468.75: 510.00.
#ASSERT `How much is my OAS pension` 750 70 25 TRUE TRUE 20 60 60 0 FALSE EQUALS `the amount, in Canadian dollars a month, is` 510
-- s 7.1(4)(c): the same, but 10 of the months abroad over six months: 375 x 1.30 = 487.50, more than 468.75.
#ASSERT `How much is my OAS pension` 750 70 25 TRUE TRUE 20 60 60 10 FALSE EQUALS `the amount, in Canadian dollars a month, is` 487.5
-- Partial, 15 fortieths, past 75: 750 x 1.1 = 825 x 15/40 = 309.375, to the cent (Regulations s 7) 309.38.
#ASSERT `How much is my OAS pension` 750 76 15 TRUE TRUE 15 0 60 0 TRUE EQUALS `the amount, in Canadian dollars a month, is` 309.38
-- Under 65: no pension, and why.
#ASSERT `How much is my OAS pension` 750 64 45 TRUE TRUE 45 0 60 0 FALSE EQUALS `no pension` `no pension: under 65 (s 3)`

-- =====================================================================================================================
-- s 9: outside Canada.
-- =====================================================================================================================
#ASSERT `Will my OAS pension stop while I am abroad` 25 12 EQUALS `the pension continues: 20 or more years of residence after 18 (s 9(2), (4))`
#ASSERT `Will my OAS pension stop while I am abroad` 15 6 EQUALS `the pension continues: not yet six months outside Canada (s 9(1), (3))`
#ASSERT `Will my OAS pension stop while I am abroad` 15 7 EQUALS `the pension is suspended until return (s 9(1), (3))`

-- =====================================================================================================================
-- s 2 "income". Answers: ITA income; employment income; EI premiums; CPP employee contributions; self-employment
-- earnings; CPP on self-employment; EI Part VII.1 premiums; OAS benefits included; CPP death benefit; social
-- assistance; other deductions.
-- =====================================================================================================================

-- Working pensioner: ITA income 30,000 (OAS 9,000, CPP 8,000, wages 13,000), EI 200, CPP 700.
-- Combined (b.1) = 13,000 - 200 - 700 = 12,100; exemption 5,000 + min(5,000, 7,100/2 = 3,550) = 8,550.
-- Income = 30,000 - 200 - 700 - 8,550 - 9,000 = 11,550.
#ASSERT `What is my income for the GIS` 30000 13000 200 700 0 0 0 9000 0 0 0 EQUALS 11550
-- No work: 20,000 with 9,000 OAS: 11,000.
#ASSERT `What is my income for the GIS` 20000 0 0 0 0 0 0 9000 0 0 0 EQUALS 11000
-- Small wages wholly exempt: 3,000 - 50 - 100 = 2,850 combined, exempt 2,850; income 3,000 - 150 - 2,850 = 0.
#ASSERT `What is my income for the GIS` 3000 3000 50 100 0 0 0 0 0 0 0 EQUALS 0
-- A self-employment loss is left out of the combined amount ("if ... greater than zero") but reduces ITA income:
-- wages 6,000, loss 2,000, ITA income 4,000; combined 6,000; exemption 5,000 + 500 = 5,500; income 4,000 - 5,500 = -1,500.
#ASSERT `What is my income for the GIS` 4000 6000 0 0 (-2000) 0 0 0 0 0 0 EQUALS (-1500)

-- =====================================================================================================================
-- Part II: the supplement. Answers: full pension; maximum single; maximum couple; $50 figure; $35 figure; situation;
-- my income; spouse's income; my pension (without deferral); my years; spouse's years; past 75; no pension this
-- month; six months abroad; sponsored.
-- =====================================================================================================================

-- Single, income 6,000, full pension 750. s 12(6)(a): base 500. s 12(5): (1,000 + 750 - 750) x 1 - 500/2 = 750.
-- s 12.1(1)(a): (6,000 - 2,000)/12 = 333.33, down to 332; 200 - 83 = 117. Total 867.
#ASSERT `How much GIS can I get` 750 1000 600 200 120 `no spouse or common-law partner` 6000 0 750 45 45 FALSE FALSE FALSE FALSE EQUALS 867
-- Single, no income: 1,000 + 200 = 1,200.
#ASSERT `How much GIS can I get` 750 1000 600 200 120 `no spouse or common-law partner` 0 0 750 45 45 FALSE FALSE FALSE FALSE EQUALS 1200
-- Single, income 30,000: 1,000 - 1,250 is below nil; top-up 200 - 583 below nil: 0.
#ASSERT `How much GIS can I get` 750 1000 600 200 120 `no spouse or common-law partner` 30000 0 750 45 45 FALSE FALSE FALSE FALSE EQUALS 0
-- Single partial pensioner (375, 20/40), income 6,000: (1,750 - 375) - 250 = 1,125; + 117 = 1,242 (finding 3).
#ASSERT `How much GIS can I get` 750 1000 600 200 120 `no spouse or common-law partner` 6000 0 375 20 20 FALSE FALSE FALSE FALSE EQUALS 1242
-- Single, past 75 (pension 825): A = 1,000 + 825, B = 825: the same 867 (the 10% does not reduce the supplement).
#ASSERT `How much GIS can I get` 750 1000 600 200 120 `no spouse or common-law partner` 6000 0 825 45 45 TRUE FALSE FALSE FALSE EQUALS 867
-- Two pensioners, 6,000 each. s 12(6)(c)(ii): base 12,000/24 = 500. (600 + 750 - 750) - 250 = 350.
-- s 12.1(2)(b): (12,000 - 4,000)/24 = 333.33, down to 332; 120 - 83 = 37. Total 387.
#ASSERT `How much GIS can I get` 750 1000 600 200 120 `a spouse or partner who is a pensioner` 6000 6000 750 45 45 FALSE FALSE FALSE FALSE EQUALS 387
-- Spouse not a pensioner, no allowance, 6,000 each. s 12(6)(b): 12,000/24 - (750 up to 752)/2 = 500 - 376 = 124.
-- (1,750 - 750) - 62 = 938. s 12.1(1)(b): 200 - 83 = 117. Total 1,055.
#ASSERT `How much GIS can I get` 750 1000 600 200 120 `a spouse or partner who is not a pensioner and gets no allowance` 6000 6000 750 45 45 FALSE FALSE FALSE FALSE EQUALS 1055
-- The same with no income: s 12(6)(b) gives 0 - 376 = -376; read as nil (finding 4): 1,000 + 200 = 1,200.
#ASSERT `How much GIS can I get` 750 1000 600 200 120 `a spouse or partner who is not a pensioner and gets no allowance` 0 0 750 45 45 FALSE FALSE FALSE FALSE EQUALS 1200
-- s 11(7)(e): a sponsorship undertaking in effect: none.
#ASSERT `How much GIS can I get` 750 1000 600 200 120 `no spouse or common-law partner` 0 0 750 45 45 FALSE FALSE FALSE TRUE EQUALS 0
-- s 11(7)(c): six months outside Canada: none.
#ASSERT `How much GIS can I get` 750 1000 600 200 120 `no spouse or common-law partner` 0 0 750 45 45 FALSE FALSE TRUE FALSE EQUALS 0
-- Specially qualified (5 years, a social security agreement), pension 750 x 5/40 = 93.75, no income, factor 0.5:
-- (1,750 - 93.75) x 0.5 = 828.125; top-up 200 x 0.5 = 100; 928.125 to the cent 928.13.
#ASSERT `How much GIS can I get` 750 1000 600 200 120 `no spouse or common-law partner` 0 0 93.75 5 45 FALSE FALSE FALSE FALSE EQUALS 928.13
-- Spouse gets the Allowance, 6,000 each. Threshold: 750 (a multiple of 3) x 4/3 = 1,000 (a multiple of 4).
-- s 22(2): (600 + 750 - 750) - (1,000 - 1,000)/4 = 600; s 22.1(1): 120 - 83 = 37; 637. Allowance (below) 637;
-- 637 + 637 = 1,274 is not less than the Part II 1,055, so s 22(6) does not apply: 637.
#ASSERT `How much GIS can I get` 750 1000 600 200 120 `a spouse or partner who gets the allowance` 6000 6000 750 45 45 FALSE FALSE FALSE FALSE EQUALS 637
-- Spouse gets the Allowance, 15,000 each (joint 30,000, 2,500 a month). s 22(2): 600 - (1,500)/4 = 225; top-up
-- (26,000/24 = 1,083.33, down to 1,080) 120 - 270: nil. Allowance: 600 - 375 = 225. Part II as if no allowance:
-- 1,250 - 376 = 874, 1,000 - 437 = 563, top-up nil. 225 + 225 = 450 < 563, so s 22(6): 563 - 225 = 338.
#ASSERT `How much GIS can I get` 750 1000 600 200 120 `a spouse or partner who gets the allowance` 15000 15000 750 45 45 FALSE FALSE FALSE FALSE EQUALS 338

-- =====================================================================================================================
-- Part III: the Allowance. Eligibility answers: age; years; resident day before; legal; six months abroad; sponsored;
-- living with the pensioner (or separated 3 months or less); the pensioner gets the GIS.
-- =====================================================================================================================
#ASSERT `Can I get the Allowance` 62 30 TRUE TRUE FALSE FALSE TRUE TRUE EQUALS `eligible for the allowance (s 19)`
#ASSERT `Can I get the Allowance` 65 30 TRUE TRUE FALSE FALSE TRUE TRUE EQUALS `not eligible: under 60 or 65 or over (s 19(1)(b), s 21(1)(a))`
#ASSERT `Can I get the Allowance` 59 30 TRUE TRUE FALSE FALSE TRUE TRUE EQUALS `not eligible: under 60 or 65 or over (s 19(1)(b), s 21(1)(a))`
#ASSERT `Can I get the Allowance` 62 30 TRUE TRUE FALSE FALSE FALSE TRUE EQUALS `not eligible: separated more than three months, or the pensioner gets no supplement (s 19(1)(a), (6)(b))`
#ASSERT `Can I get the Allowance` 62 30 TRUE TRUE FALSE FALSE TRUE FALSE EQUALS `not eligible: separated more than three months, or the pensioner gets no supplement (s 19(1)(a), (6)(b))`
#ASSERT `Can I get the Allowance` 62 15 FALSE TRUE FALSE FALSE TRUE TRUE EQUALS `not eligible: under 10 years of residence, or under 20 and not resident the day before approval (s 19(1)(c), s 21(1)(b))`
#ASSERT `Can I get the Allowance` 62 30 TRUE TRUE FALSE TRUE TRUE TRUE EQUALS `not eligible: absent six months or sponsored (s 19(6)(c)-(d), s 21(9)(b)-(c))`

-- Amount answers: full pension; supplement equivalent; $35 figure; then the eight eligibility answers; joint income.
-- Joint 12,000 (1,000 a month) = threshold 1,000: s 22(3)(b): 600 x 1 + max(0, 750 - 3/4 x 1,000) = 600; + 37 = 637.
#ASSERT `How much Allowance can I get` 750 600 120 62 30 TRUE TRUE FALSE FALSE TRUE TRUE 12000 EQUALS `the amount, in Canadian dollars a month, is` 637
-- No joint income: s 22(3)(a): 750 + 600 = 1,350; top-up 120; 1,470.
#ASSERT `How much Allowance can I get` 750 600 120 62 30 TRUE TRUE FALSE FALSE TRUE TRUE 0 EQUALS `the amount, in Canadian dollars a month, is` 1470
-- Joint 6,000 (500 a month): s 22(3)(b): 600 + (750 - 375) = 975; top-up (2,000/24 = 83.33, down to 80) 120 - 20 = 100; 1,075.
#ASSERT `How much Allowance can I get` 750 600 120 62 30 TRUE TRUE FALSE FALSE TRUE TRUE 6000 EQUALS `the amount, in Canadian dollars a month, is` 1075
-- Joint 18,000 (1,500): s 22(3)(c): 600 - 500/4 = 475; top-up (14,000/24 = 583.33, down to 580) 120 - 145: nil. 475.
#ASSERT `How much Allowance can I get` 750 600 120 62 30 TRUE TRUE FALSE FALSE TRUE TRUE 18000 EQUALS `the amount, in Canadian dollars a month, is` 475
-- Regulations s 6: joint 40,764 (3,397 a month): residual 2,397, down to 2,396; 600 - 599 = 1; paid as $2.
#ASSERT `How much Allowance can I get` 750 600 120 62 30 TRUE TRUE FALSE FALSE TRUE TRUE 40764 EQUALS `the amount, in Canadian dollars a month, is` 2
-- Not eligible (65): no allowance, and why.
#ASSERT `How much Allowance can I get` 750 600 120 65 30 TRUE TRUE FALSE FALSE TRUE TRUE 12000 EQUALS `no allowance` `not eligible: under 60 or 65 or over (s 19(1)(b), s 21(1)(a))`

-- =====================================================================================================================
-- Part III: the Allowance for the Survivor. Eligibility answers: age; years; resident day before; legal; six months
-- abroad; sponsored; spouse died; new spouse since; convicted.
-- =====================================================================================================================
#ASSERT `Can I get the Allowance for the Survivor` 61 40 TRUE TRUE FALSE FALSE TRUE FALSE FALSE EQUALS `eligible for the allowance for the survivor (s 21)`
-- s 2 "survivor": a new common-law partner since the death ends survivorship.
#ASSERT `Can I get the Allowance for the Survivor` 61 40 TRUE TRUE FALSE FALSE TRUE TRUE FALSE EQUALS `not eligible: not a survivor, or convicted of the spouse's murder or manslaughter (s 2, s 21.1)`
-- s 21.1(1).
#ASSERT `Can I get the Allowance for the Survivor` 61 40 TRUE TRUE FALSE FALSE TRUE FALSE TRUE EQUALS `not eligible: not a survivor, or convicted of the spouse's murder or manslaughter (s 2, s 21.1)`
#ASSERT `Can I get the Allowance for the Survivor` 66 40 TRUE TRUE FALSE FALSE TRUE FALSE FALSE EQUALS `not eligible: under 60 or 65 or over (s 19(1)(b), s 21(1)(a))`

-- Amount answers: full pension; supplement equivalent for the survivor; $50 figure; nine eligibility answers; income.
-- Income 6,000 (500 a month, under the 1,000 threshold): s 22(4)(b): 900 + max(0, 750 - 375) = 1,275;
-- s 22.1(3): (4,000/12 = 333.33, down to 332) 200 - 83 = 117. Total 1,392.
#ASSERT `How much Allowance for the Survivor can I get` 750 900 200 61 40 TRUE TRUE FALSE FALSE TRUE FALSE FALSE 6000 EQUALS `the amount, in Canadian dollars a month, is` 1392
-- No income: s 22(4)(a): 750 + 900 = 1,650; + 200 = 1,850.
#ASSERT `How much Allowance for the Survivor can I get` 750 900 200 61 40 TRUE TRUE FALSE FALSE TRUE FALSE FALSE 0 EQUALS `the amount, in Canadian dollars a month, is` 1850
-- Income 18,000 (1,500): s 22(4)(c): 900 - 500/2 = 650; top-up (16,000/12 = 1,333.33, down to 1,332) 200 - 333: nil. 650.
#ASSERT `How much Allowance for the Survivor can I get` 750 900 200 61 40 TRUE TRUE FALSE FALSE TRUE FALSE FALSE 18000 EQUALS `the amount, in Canadian dollars a month, is` 650
-- At the threshold, 12,000 (1,000): (b) gives 900 + max(0, 750 - 750) = 900, which (c) would also give; top-up (832) 200 - 208: nil. 900.
#ASSERT `How much Allowance for the Survivor can I get` 750 900 200 61 40 TRUE TRUE FALSE FALSE TRUE FALSE FALSE 12000 EQUALS `the amount, in Canadian dollars a month, is` 900

-- Core functions directly, against the same figures.
-- s 22(1): rounded pension equivalent of 751 is 753; x 4/3 = 1,004, a multiple of 4.
#ASSERT `the four-thirds threshold` (`the quarter's figures from my answers` 751 0 0 0 0 0) 1 EQUALS 1004
#ASSERT `the special qualifying factor` 7.9 EQUALS 0.7
#ASSERT `the special qualifying factor` 12 EQUALS 1

-- =====================================================================================================================
-- Regulative rules (oas-core.l4). Day 0 is the day the rule starts.
-- =====================================================================================================================
-- s 14(1): the income statement made in the application: fulfilled; waived: nothing owed.
#ASSERT EVALTRACE (`s 14(1) -- the applicant must state their income in the application for a supplement` FALSE) 0 (LIST (EVENT `the applicant or beneficiary` `state income for the base calendar year in the application` 0)) EQUALS FULFILLED
#ASSERT EVALTRACE (`s 14(1) -- the applicant must state their income in the application for a supplement` TRUE) 0 (LIST (EVENT `the applicant or beneficiary` `state income for the base calendar year in the application` 0)) EQUALS FULFILLED
-- expect: BREACH BY the applicant or beneficiary, "s 14(1): ..." (the application leaves income out, sent on day 1)
#TRACE `s 14(1) -- the applicant must state their income in the application for a supplement` FALSE AT 0 WITH
    PARTY `the applicant or beneficiary` DOES `state income for the base calendar year in the application` AT 1

-- s 15(9): a separation, reported on day 3: fulfilled.
#ASSERT EVALTRACE (`s 15(9) -- the applicant must tell the Minister without delay of a separation or a new spouse or partner` TRUE) 0 (LIST (EVENT `the applicant or beneficiary` `inform the Minister of a separation or a new spouse or partner` 3)) EQUALS FULFILLED
-- expect: an obligation still pending on the applicant (no time limit is stated; "without delay")
#TRACE `s 15(9) -- the applicant must tell the Minister without delay of a separation or a new spouse or partner` TRUE AT 0 WITH
    PARTY `the Minister` DOES `reconsider and notify the decision in writing` AT 400

-- Regulations s 25(1): back after two months abroad, notifies on day 20: fulfilled.
#ASSERT EVALTRACE `Regulations s 25(1) -- after returning from more than a month abroad, notify the return within one month` 0 (LIST (EVENT `the applicant or beneficiary` `notify the Minister of the return to Canada` 20)) EQUALS FULFILLED
-- expect: BREACH BY the applicant or beneficiary, "Regulations s 25(1): ..." (notified on day 31)
#TRACE `Regulations s 25(1) -- after returning from more than a month abroad, notify the return within one month` AT 0 WITH
    PARTY `the applicant or beneficiary` DOES `notify the Minister of the return to Canada` AT 31

-- s 37(1): overpaid, returns the amount on day 5: fulfilled.
#ASSERT EVALTRACE `s 37(1) -- a person overpaid must return the overpayment forthwith` 0 (LIST (EVENT `the applicant or beneficiary` `return the overpayment` 5)) EQUALS FULFILLED

-- s 27.1: asks on day 80; the Minister reconsiders and writes on day 120: fulfilled.
#ASSERT EVALTRACE `s 27.1 -- I may ask for a reconsideration within 90 days, and the Minister must then reconsider and tell me in writing` 0 (LIST (EVENT `the applicant or beneficiary` `request a reconsideration` 80), (EVENT `the Minister` `reconsider and notify the decision in writing` 120)) EQUALS FULFILLED
-- expect: the Minister's duty to reconsider still pending after the request on day 90 (no number of days is set)
#TRACE `s 27.1 -- I may ask for a reconsideration within 90 days, and the Minister must then reconsider and tell me in writing` AT 0 WITH
    PARTY `the applicant or beneficiary` DOES `request a reconsideration` AT 90

-- s 9.3 and Regulations s 26.1: cancellation asked on day 100, repaid on day 250 (within 182 days): fulfilled.
#ASSERT EVALTRACE `s 9.3 and Regulations s 26.1 -- I may cancel my pension within six months of its start, then repay within six months` 0 (LIST (EVENT `the applicant or beneficiary` `request cancellation of the pension or supplement` 100), (EVENT `the applicant or beneficiary` `repay the pension and related benefits` 250)) EQUALS FULFILLED
-- expect: BREACH BY the applicant or beneficiary, "s 9.3(2) and Regulations s 26.1(2): ..." (repaid on day 300, 200 days after the request)
#TRACE `s 9.3 and Regulations s 26.1 -- I may cancel my pension within six months of its start, then repay within six months` AT 0 WITH
    PARTY `the applicant or beneficiary` DOES `request cancellation of the pension or supplement` AT 100
    PARTY `the applicant or beneficiary` DOES `repay the pension and related benefits` AT 300
