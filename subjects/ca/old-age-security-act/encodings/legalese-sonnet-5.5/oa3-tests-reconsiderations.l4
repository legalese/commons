IMPORT prelude
IMPORT daydate
IMPORT `oas-core`
IMPORT `oas-core-measures`
IMPORT `oa3-part2-reconsiderations`

-- Tests of oa3-part2-reconsiderations.l4 (regs 29 to 47). Every expected value is worked out by hand from the words of the regulation;
-- the 365-day edge is tested across a leap year and a common year.

-- Reg 29(a): name AND address AND (Social Insurance Number OR Account Number). Arguments: name, address, SIN, Account Number.
#ASSERT `reg 29(a): the request sets out the particulars of the person` TRUE TRUE TRUE FALSE
#ASSERT `reg 29(a): the request sets out the particulars of the person` TRUE TRUE FALSE TRUE
#ASSERT `reg 29(a): the request sets out the particulars of the person` TRUE TRUE TRUE TRUE
#ASSERT NOT (`reg 29(a): the request sets out the particulars of the person` TRUE TRUE FALSE FALSE)
#ASSERT NOT (`reg 29(a): the request sets out the particulars of the person` FALSE TRUE TRUE FALSE)
#ASSERT NOT (`reg 29(a): the request sets out the particulars of the person` TRUE FALSE TRUE FALSE)

-- Reg 29(b): the grounds AND a statement of the facts.
#ASSERT `reg 29(b): the request sets out its grounds and the facts` TRUE TRUE
#ASSERT NOT (`reg 29(b): the request sets out its grounds and the facts` TRUE FALSE)
#ASSERT NOT (`reg 29(b): the request sets out its grounds and the facts` FALSE TRUE)
#ASSERT NOT (`reg 29(b): the request sets out its grounds and the facts` FALSE FALSE)

-- Reg 29: in writing, conveyed to the Minister, (a), (b).
#ASSERT `reg 29: the request for a reconsideration under section 27.1 of the Act is made as the Regulations require` TRUE TRUE TRUE TRUE
#ASSERT NOT (`reg 29: the request for a reconsideration under section 27.1 of the Act is made as the Regulations require` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`reg 29: the request for a reconsideration under section 27.1 of the Act is made as the Regulations require` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`reg 29: the request for a reconsideration under section 27.1 of the Act is made as the Regulations require` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`reg 29: the request for a reconsideration under section 27.1 of the Act is made as the Regulations require` TRUE TRUE TRUE FALSE)

-- Reg 29.1(2): a request after the 365-day period after the notice, or by a person who has applied again.
-- Notice on 2020-01-01: 365 days after it is 2020-12-31 (2020 has 366 days), so a request on that day is within the period and one on 2021-01-01 is after it.
#ASSERT NOT (`reg 29.1(2): the request for reconsideration is one that needs the further satisfaction of subsection (2)` (YearMonthDay 2020 12 31) (YearMonthDay 2020 1 1) FALSE)
#ASSERT `reg 29.1(2): the request for reconsideration is one that needs the further satisfaction of subsection (2)` (YearMonthDay 2021 1 1) (YearMonthDay 2020 1 1) FALSE
-- Notice on 2021-01-01: 365 days after it is 2022-01-01, a year to the day.
#ASSERT NOT (`reg 29.1(2): the request for reconsideration is one that needs the further satisfaction of subsection (2)` (YearMonthDay 2022 1 1) (YearMonthDay 2021 1 1) FALSE)
#ASSERT `reg 29.1(2): the request for reconsideration is one that needs the further satisfaction of subsection (2)` (YearMonthDay 2022 1 2) (YearMonthDay 2021 1 1) FALSE
-- Notice on 2019-03-01: 365 days after is 2020-02-29 (the leap day is counted as a day), so 2020-03-01 is after the period.
#ASSERT NOT (`reg 29.1(2): the request for reconsideration is one that needs the further satisfaction of subsection (2)` (YearMonthDay 2020 2 29) (YearMonthDay 2019 3 1) FALSE)
#ASSERT `reg 29.1(2): the request for reconsideration is one that needs the further satisfaction of subsection (2)` (YearMonthDay 2020 3 1) (YearMonthDay 2019 3 1) FALSE
-- Within the period but by a person who has applied again for the same benefit: (b) applies.
#ASSERT `reg 29.1(2): the request for reconsideration is one that needs the further satisfaction of subsection (2)` (YearMonthDay 2020 2 1) (YearMonthDay 2020 1 1) TRUE
#ASSERT NOT (`reg 29.1(2): the request for reconsideration is one that needs the further satisfaction of subsection (2)` (YearMonthDay 2020 2 1) (YearMonthDay 2020 1 1) FALSE)

-- Reg 29.1(1) and (2). Arguments: reasonable explanation, continuing intention, subsection (2) applies, reasonable chance of success, no prejudice.
#ASSERT `reg 29.1: the Minister may allow a longer period to make the request for reconsideration` TRUE TRUE FALSE FALSE FALSE
#ASSERT `reg 29.1: the Minister may allow a longer period to make the request for reconsideration` TRUE TRUE FALSE TRUE TRUE
#ASSERT `reg 29.1: the Minister may allow a longer period to make the request for reconsideration` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`reg 29.1: the Minister may allow a longer period to make the request for reconsideration` TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`reg 29.1: the Minister may allow a longer period to make the request for reconsideration` TRUE TRUE TRUE TRUE FALSE)
#ASSERT NOT (`reg 29.1: the Minister may allow a longer period to make the request for reconsideration` TRUE TRUE TRUE FALSE FALSE)
#ASSERT NOT (`reg 29.1: the Minister may allow a longer period to make the request for reconsideration` FALSE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`reg 29.1: the Minister may allow a longer period to make the request for reconsideration` TRUE FALSE FALSE TRUE TRUE)
#ASSERT NOT (`reg 29.1: the Minister may allow a longer period to make the request for reconsideration` FALSE FALSE FALSE FALSE FALSE)

-- Reg 29.1(3): no condition.
#ASSERT `reg 29.1(3): the Minister may take any necessary steps to obtain information required to decide whether to allow a longer period`

-- Reg 38: whom the Tribunal notifies, and the transmission of documents.
#ASSERT `reg 38(a): the persons the Social Security Tribunal must notify that the appeal on that ground has been referred to the Court` TRUE EQUALS LIST `reg 38: the appellant`, `reg 38: the Minister`
#ASSERT `reg 38(a): the persons the Social Security Tribunal must notify that the appeal on that ground has been referred to the Court` FALSE EQUALS EMPTY
#ASSERT `reg 38(b): the Social Security Tribunal must transmit to the Registrar of the Court a copy of the documents filed in the appeal that are relevant to the ground of appeal` TRUE
#ASSERT NOT (`reg 38(b): the Social Security Tribunal must transmit to the Registrar of the Court a copy of the documents filed in the appeal that are relevant to the ground of appeal` FALSE)

-- Reg 38.1(1): an appeal in relation to a reference AND the Minister's opinion that another person may be directly affected.
#ASSERT `reg 38.1(1): the Minister must notify the Social Security Tribunal` TRUE TRUE
#ASSERT NOT (`reg 38.1(1): the Minister must notify the Social Security Tribunal` TRUE FALSE)
#ASSERT NOT (`reg 38.1(1): the Minister must notify the Social Security Tribunal` FALSE TRUE)
#ASSERT NOT (`reg 38.1(1): the Minister must notify the Social Security Tribunal` FALSE FALSE)

-- Reg 38.1(2): the Tribunal's duty and the Registrar's.
#ASSERT `reg 38.1(2): the Social Security Tribunal must notify the Registrar of the Court` TRUE
#ASSERT NOT (`reg 38.1(2): the Social Security Tribunal must notify the Registrar of the Court` FALSE)

#ASSERT `reg 38.1(2): the Registrar of the Court must add the person as a party to the appeal` TRUE
#ASSERT NOT (`reg 38.1(2): the Registrar of the Court must add the person as a party to the appeal` FALSE)

-- Reg 39(1): the Registrar notifies the Chief Judge, the Tribunal, the Minister and any person added as a party.
#ASSERT `reg 39(1): the persons the Registrar of the Court must immediately notify of the receipt of the documents` TRUE FALSE EQUALS LIST `reg 38: the Chief Judge of the Court`, `reg 38: the Social Security Tribunal`, `reg 38: the Minister`
#ASSERT `reg 39(1): the persons the Registrar of the Court must immediately notify of the receipt of the documents` TRUE TRUE EQUALS LIST `reg 38: the Chief Judge of the Court`, `reg 38: the Social Security Tribunal`, `reg 38: the Minister`, `reg 38: a person added as a party to the appeal`
#ASSERT `reg 39(1): the persons the Registrar of the Court must immediately notify of the receipt of the documents` FALSE TRUE EQUALS EMPTY
#ASSERT `reg 39(1): the persons the Registrar of the Court must immediately notify of the receipt of the documents` FALSE FALSE EQUALS EMPTY
#ASSERT `reg 39(2): the Chief Judge of the Court must appoint a judge of the Court to hear the reference` TRUE
#ASSERT NOT (`reg 39(2): the Chief Judge of the Court must appoint a judge of the Court to hear the reference` FALSE)

#ASSERT `reg 40(1): the Registrar of the Court must fix the date, time and place for the hearing of the reference` TRUE
#ASSERT NOT (`reg 40(1): the Registrar of the Court must fix the date, time and place for the hearing of the reference` FALSE)

-- Reg 40(2): the hearing is where the appellant is ordinarily resident, unless the appellant consents in writing to another place.
#ASSERT `reg 40(2): the hearing of the reference may be held at that place` "Ottawa" "Ottawa" FALSE
#ASSERT NOT (`reg 40(2): the hearing of the reference may be held at that place` "Toronto" "Ottawa" FALSE)
#ASSERT `reg 40(2): the hearing of the reference may be held at that place` "Toronto" "Ottawa" TRUE
#ASSERT NOT (`reg 40(2): the hearing of the reference may be held at that place` "ottawa" "Ottawa" FALSE)

-- Reg 40(3): the same four recipients, by registered mail.
#ASSERT `reg 40(3): the persons the Registrar of the Court must notify by registered mail of the date, place and time fixed for the hearing` TRUE FALSE EQUALS LIST `reg 38: the appellant`, `reg 38: the Social Security Tribunal`, `reg 38: the Minister`
#ASSERT `reg 40(3): the persons the Registrar of the Court must notify by registered mail of the date, place and time fixed for the hearing` TRUE TRUE EQUALS LIST `reg 38: the appellant`, `reg 38: the Social Security Tribunal`, `reg 38: the Minister`, `reg 38: a person added as a party to the appeal`
#ASSERT `reg 40(3): the persons the Registrar of the Court must notify by registered mail of the date, place and time fixed for the hearing` FALSE TRUE EQUALS EMPTY

#ASSERT `reg 41(1): the proceedings must be informal and conducted in a summary manner` TRUE
#ASSERT NOT (`reg 41(1): the proceedings must be informal and conducted in a summary manner` FALSE)

#ASSERT `reg 41(2): the judge must determine the procedure to be followed at the hearing, subject to the right of all parties or their representatives to be heard` TRUE
#ASSERT NOT (`reg 41(2): the judge must determine the procedure to be followed at the hearing, subject to the right of all parties or their representatives to be heard` FALSE)

-- Reg 42: with the appellant's consent, written submissions from the appellant, the Minister and any person added.
#ASSERT `reg 42: the persons from whom the judge may require written submissions` TRUE FALSE EQUALS LIST `reg 38: the appellant`, `reg 38: the Minister`
#ASSERT `reg 42: the persons from whom the judge may require written submissions` TRUE TRUE EQUALS LIST `reg 38: the appellant`, `reg 38: the Minister`, `reg 38: a person added as a party to the appeal`
#ASSERT `reg 42: the persons from whom the judge may require written submissions` FALSE TRUE EQUALS EMPTY

#ASSERT `reg 44(1): the judge must advise the Registrar of the Court of the judge's decision` TRUE
#ASSERT NOT (`reg 44(1): the judge must advise the Registrar of the Court of the judge's decision` FALSE)

-- Reg 44(2): the Registrar forwards a certified copy to the appellant, the Tribunal, the Minister and any person added.
#ASSERT `reg 44(2): the persons to whom the Registrar of the Court must forward a certified copy of the decision` TRUE FALSE EQUALS LIST `reg 38: the appellant`, `reg 38: the Social Security Tribunal`, `reg 38: the Minister`
#ASSERT `reg 44(2): the persons to whom the Registrar of the Court must forward a certified copy of the decision` TRUE TRUE EQUALS LIST `reg 38: the appellant`, `reg 38: the Social Security Tribunal`, `reg 38: the Minister`, `reg 38: a person added as a party to the appeal`
#ASSERT `reg 44(2): the persons to whom the Registrar of the Court must forward a certified copy of the decision` FALSE FALSE EQUALS EMPTY

#ASSERT `reg 45: no costs may be awarded and no fees may be charged to the appellant by the Court` TRUE
#ASSERT NOT (`reg 45: no costs may be awarded and no fees may be charged to the appellant by the Court` FALSE)

-- Reg 46: a ground not referred AND a ground referred AND a certified copy of the Court's decision received.
#ASSERT `reg 46: the Social Security Tribunal must proceed in accordance with the Social Security Tribunal Rules of Procedure` TRUE TRUE TRUE
#ASSERT NOT (`reg 46: the Social Security Tribunal must proceed in accordance with the Social Security Tribunal Rules of Procedure` FALSE TRUE TRUE)
#ASSERT NOT (`reg 46: the Social Security Tribunal must proceed in accordance with the Social Security Tribunal Rules of Procedure` TRUE FALSE TRUE)
#ASSERT NOT (`reg 46: the Social Security Tribunal must proceed in accordance with the Social Security Tribunal Rules of Procedure` TRUE TRUE FALSE)

-- Reg 47: the address is the last known address of the person.
#ASSERT `reg 47: the address to which the notice, request or other document must be addressed` "12 Main Street, Ottawa" EQUALS "12 Main Street, Ottawa"
