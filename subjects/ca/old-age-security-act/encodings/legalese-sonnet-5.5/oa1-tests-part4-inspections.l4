IMPORT prelude
IMPORT daydate
IMPORT `oas-core`
IMPORT `oas-core-measures`
IMPORT `oa1-part4-inspections`

-- Tests of oa1-part4-inspections. Every expected value follows from the text of s 44.2.

§ `s 44.2(1): definitions`

#ASSERT `s 44.2(1): the thing is a document` TRUE FALSE
#ASSERT `s 44.2(1): the thing is a document` FALSE TRUE
#ASSERT NOT (`s 44.2(1): the thing is a document` FALSE FALSE)
#ASSERT `s 44.2(1): the place is a dwelling-house` TRUE FALSE FALSE
#ASSERT `s 44.2(1): the place is a dwelling-house` FALSE TRUE FALSE
#ASSERT `s 44.2(1): the place is a dwelling-house` FALSE FALSE TRUE
#ASSERT NOT (`s 44.2(1): the place is a dwelling-house` FALSE FALSE FALSE)
#ASSERT `s 44.2(1): the person is a judge` TRUE FALSE
#ASSERT `s 44.2(1): the person is a judge` FALSE TRUE
#ASSERT NOT (`s 44.2(1): the person is a judge` FALSE FALSE)

§ `s 44.2(2) and (3): examination and entry`

#ASSERT `s 44.2(2): the Minister may examine the document` TRUE TRUE TRUE
#ASSERT NOT (`s 44.2(2): the Minister may examine the document` FALSE TRUE TRUE)
#ASSERT NOT (`s 44.2(2): the Minister may examine the document` TRUE FALSE TRUE)
#ASSERT NOT (`s 44.2(2): the Minister may examine the document` TRUE TRUE FALSE)
-- Not a dwelling-house: enter. A dwelling-house: only with consent or under a warrant.
#ASSERT `s 44.2(3): the Minister may enter the premises or place` FALSE FALSE FALSE
#ASSERT `s 44.2(3): the Minister may enter the premises or place` TRUE TRUE FALSE
#ASSERT `s 44.2(3): the Minister may enter the premises or place` TRUE FALSE TRUE
#ASSERT NOT (`s 44.2(3): the Minister may enter the premises or place` TRUE FALSE FALSE)
#ASSERT `s 44.2(2)(a): the Minister may enter the premises or place` TRUE TRUE
#ASSERT NOT (`s 44.2(2)(a): the Minister may enter the premises or place` TRUE FALSE)
#ASSERT NOT (`s 44.2(2)(a): the Minister may enter the premises or place` FALSE TRUE)
#ASSERT `s 44.2(2)(b): the Minister may require the person to give all reasonable assistance, answer all proper questions and attend at the premises or place with the Minister` TRUE TRUE TRUE
#ASSERT NOT (`s 44.2(2)(b): the Minister may require the person to give all reasonable assistance, answer all proper questions and attend at the premises or place with the Minister` FALSE TRUE TRUE)
#ASSERT NOT (`s 44.2(2)(b): the Minister may require the person to give all reasonable assistance, answer all proper questions and attend at the premises or place with the Minister` TRUE FALSE TRUE)
#ASSERT NOT (`s 44.2(2)(b): the Minister may require the person to give all reasonable assistance, answer all proper questions and attend at the premises or place with the Minister` TRUE TRUE FALSE)

§ `s 44.2(4) and (5): warrants and access`

#ASSERT `s 44.2(4): a judge may issue a warrant authorizing the Minister to enter the dwelling-house` TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 44.2(4): a judge may issue a warrant authorizing the Minister to enter the dwelling-house` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`s 44.2(4): a judge may issue a warrant authorizing the Minister to enter the dwelling-house` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 44.2(4): a judge may issue a warrant authorizing the Minister to enter the dwelling-house` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 44.2(4): a judge may issue a warrant authorizing the Minister to enter the dwelling-house` TRUE TRUE TRUE FALSE)
-- (5): not satisfied that entry is necessary, but satisfied that access has been or may be refused.
#ASSERT `s 44.2(5): the judge may order the occupant to provide the Minister with reasonable access to the document and make any other appropriate order` FALSE TRUE
#ASSERT NOT (`s 44.2(5): the judge may order the occupant to provide the Minister with reasonable access to the document and make any other appropriate order` TRUE TRUE)
#ASSERT NOT (`s 44.2(5): the judge may order the occupant to provide the Minister with reasonable access to the document and make any other appropriate order` FALSE FALSE)

§ `s 44.2(6) to (11): requirements about documents and information`

#ASSERT `s 44.2(7): the Minister may impose the requirement on the third party` FALSE FALSE
#ASSERT `s 44.2(7): the Minister may impose the requirement on the third party` TRUE TRUE
#ASSERT NOT (`s 44.2(7): the Minister may impose the requirement on the third party` TRUE FALSE)
#ASSERT `s 44.2(6): the Minister may require the person to provide the information, additional information or document` TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 44.2(6): the Minister may require the person to provide the information, additional information or document` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`s 44.2(6): the Minister may require the person to provide the information, additional information or document` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 44.2(6): the Minister may require the person to provide the information, additional information or document` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 44.2(6): the Minister may require the person to provide the information, additional information or document` TRUE TRUE TRUE FALSE)
#ASSERT `s 44.2(8): a judge may authorize the Minister to impose on a third party a requirement relating to one or more unnamed persons` TRUE TRUE TRUE
#ASSERT NOT (`s 44.2(8): a judge may authorize the Minister to impose on a third party a requirement relating to one or more unnamed persons` FALSE TRUE TRUE)
#ASSERT NOT (`s 44.2(8): a judge may authorize the Minister to impose on a third party a requirement relating to one or more unnamed persons` TRUE FALSE TRUE)
#ASSERT NOT (`s 44.2(8): a judge may authorize the Minister to impose on a third party a requirement relating to one or more unnamed persons` TRUE TRUE FALSE)
#ASSERT `s 44.2(9): the authorization has been served as the Act requires` FALSE FALSE
#ASSERT `s 44.2(9): the authorization has been served as the Act requires` TRUE TRUE
#ASSERT NOT (`s 44.2(9): the authorization has been served as the Act requires` TRUE FALSE)
-- Served March 1, 2026: the fifteenth day after is March 16.
#ASSERT `s 44.2(10): the third party may apply for a review of the authorization on the day` (YMD 2026 3 1) (YMD 2026 3 16)
#ASSERT NOT (`s 44.2(10): the third party may apply for a review of the authorization on the day` (YMD 2026 3 1) (YMD 2026 3 17))
#ASSERT NOT (`s 44.2(10): the third party may apply for a review of the authorization on the day` (YMD 2026 3 1) (YMD 2026 2 28))
#ASSERT `s 44.2(11): the judge may cancel the authorization previously granted` TRUE
#ASSERT NOT (`s 44.2(11): the judge may cancel the authorization previously granted` FALSE)
#ASSERT `s 44.2(11): the judge may confirm or vary the authorization` FALSE
#ASSERT NOT (`s 44.2(11): the judge may confirm or vary the authorization` TRUE)

§ `s 44.2(12) and (13): copies and interference`

#ASSERT `s 44.2(12): the copy is evidence of the nature and content of the original document and has the same probative force as the original` TRUE TRUE TRUE
#ASSERT NOT (`s 44.2(12): the copy is evidence of the nature and content of the original document and has the same probative force as the original` FALSE TRUE TRUE)
#ASSERT NOT (`s 44.2(12): the copy is evidence of the nature and content of the original document and has the same probative force as the original` TRUE FALSE TRUE)
#ASSERT NOT (`s 44.2(12): the copy is evidence of the nature and content of the original document and has the same probative force as the original` TRUE TRUE FALSE)
#ASSERT `s 44.2(13): the person has contravened the prohibition` TRUE TRUE FALSE
#ASSERT `s 44.2(13): the person has contravened the prohibition` TRUE FALSE TRUE
#ASSERT NOT (`s 44.2(13): the person has contravened the prohibition` TRUE FALSE FALSE)
#ASSERT NOT (`s 44.2(13): the person has contravened the prohibition` FALSE TRUE TRUE)
-- NOT COVERED: the text states no penalty for the contravention.
#ASSERT `s 44.2(13): the greatest fine that this Act sets for the contravention` TRUE EQUALS NOTHING
