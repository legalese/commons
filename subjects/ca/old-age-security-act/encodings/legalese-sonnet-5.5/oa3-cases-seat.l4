-- not a reference.
#ASSERT NOT (`Am I free of costs and fees on a reference to the Tax Court (reg 45)` FALSE)

-- To what address must a notice to me be sent (reg 47)?

-- my last known address.
#ASSERT `To what address must a notice to me be sent (reg 47)` "12 Main Street, Ottawa" EQUALS "12 Main Street, Ottawa"

-- How much interest accrues on my debt in a month (reg 48(4))?

-- 10000 at 4.25 + 3 = 7.25% for all 31 days of January 2021: 725 x 31 / 365.
#ASSERT `How much interest accrues on my debt in a month (reg 48(4))` 10000 4.25 TRUE (YearMonthDay 2021 1 1) FALSE (YearMonthDay 2000 1 1) (YearMonthDay 2000 1 1) FALSE (YearMonthDay 2000 1 1) (YearMonthDay 2021 1 17) EQUALS JUST (22475 DIVIDED BY 365)
-- a proceeding pending 15 to 20 January: 25 days.
#ASSERT `How much interest accrues on my debt in a month (reg 48(4))` 10000 4.25 TRUE (YearMonthDay 2021 1 1) TRUE (YearMonthDay 2021 1 15) (YearMonthDay 2021 1 20) FALSE (YearMonthDay 2000 1 1) (YearMonthDay 2021 1 17) EQUALS JUST (18125 DIVIDED BY 365)
-- interest stopped on 10 January: 10 days.
#ASSERT `How much interest accrues on my debt in a month (reg 48(4))` 10000 4.25 TRUE (YearMonthDay 2021 1 1) FALSE (YearMonthDay 2000 1 1) (YearMonthDay 2000 1 1) TRUE (YearMonthDay 2021 1 10) (YearMonthDay 2021 1 17) EQUALS JUST (7250 DIVIDED BY 365)
-- not payable.
#ASSERT `How much interest accrues on my debt in a month (reg 48(4))` 10000 4.25 FALSE (YearMonthDay 2021 1 1) FALSE (YearMonthDay 2000 1 1) (YearMonthDay 2000 1 1) FALSE (YearMonthDay 2000 1 1) (YearMonthDay 2021 1 17) EQUALS JUST 0

-- May the Minister remit the interest I owe (reg 48(7))?

-- all four.
#ASSERT `May the Minister remit the interest I owe (reg 48(7))` TRUE TRUE TRUE TRUE
-- not ceased.
#ASSERT NOT (`May the Minister remit the interest I owe (reg 48(7))` FALSE TRUE TRUE TRUE)
-- collectable.
#ASSERT NOT (`May the Minister remit the interest I owe (reg 48(7))` TRUE FALSE TRUE TRUE)
-- costs below the interest.
#ASSERT NOT (`May the Minister remit the interest I owe (reg 48(7))` TRUE TRUE FALSE TRUE)
-- no hardship.
#ASSERT NOT (`May the Minister remit the interest I owe (reg 48(7))` TRUE TRUE TRUE FALSE)
