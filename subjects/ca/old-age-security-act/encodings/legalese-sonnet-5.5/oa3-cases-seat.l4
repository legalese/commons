-- held elsewhere, no consent.
#ASSERT NOT (`May the hearing of my reference be held at this place (reg 40(2))` "Toronto" "Ottawa" FALSE)
-- held elsewhere, with my written consent.
#ASSERT `May the hearing of my reference be held at this place (reg 40(2))` "Toronto" "Ottawa" TRUE

-- Will the Registrar notify me by registered mail of the date, place and time of the hearing (reg 40(3))?

-- fixed.
#ASSERT `Will the Registrar notify me by registered mail of the date, place and time of the hearing (reg 40(3))` TRUE
-- not yet fixed.
#ASSERT NOT (`Will the Registrar notify me by registered mail of the date, place and time of the hearing (reg 40(3))` FALSE)

-- Will the proceedings before the Court on my reference be informal and summary (reg 41(1))?

-- before the Court.
#ASSERT `Will the proceedings before the Court on my reference be informal and summary (reg 41(1))` TRUE
-- not before the Court.
#ASSERT NOT (`Will the proceedings before the Court on my reference be informal and summary (reg 41(1))` FALSE)

-- Must the judge hear me before determining the procedure for my hearing (reg 41(2))?

-- a judge appointed.
#ASSERT `Must the judge hear me before determining the procedure for my hearing (reg 41(2))` TRUE
-- no judge yet.
#ASSERT NOT (`Must the judge hear me before determining the procedure for my hearing (reg 41(2))` FALSE)

-- May the judge require me to file written submissions (reg 42)?

-- I consent.
#ASSERT `May the judge require me to file written submissions (reg 42)` TRUE
-- I do not consent.
