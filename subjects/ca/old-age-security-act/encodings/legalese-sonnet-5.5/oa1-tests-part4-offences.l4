IMPORT prelude
IMPORT daydate
IMPORT `oas-core`
IMPORT `oas-core-measures`
IMPORT `oa1-part4-offences`

-- Tests of oa1-part4-offences. Every expected value is worked by hand from the text of ss 44 and 44.1.

`oa1 test: facts none` MEANS `s 44.1(1): Facts about the person's acts or omissions` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`oa1 test: facts only (a)` MEANS `s 44.1(1): Facts about the person's acts or omissions` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE
`oa1 test: facts only (a.1)` MEANS `s 44.1(1): Facts about the person's acts or omissions` OF FALSE, TRUE, FALSE, FALSE, FALSE, FALSE
`oa1 test: facts only (b)` MEANS `s 44.1(1): Facts about the person's acts or omissions` OF FALSE, FALSE, TRUE, FALSE, FALSE, FALSE
`oa1 test: facts only (c)` MEANS `s 44.1(1): Facts about the person's acts or omissions` OF FALSE, FALSE, FALSE, TRUE, FALSE, FALSE
`oa1 test: facts only (d)` MEANS `s 44.1(1): Facts about the person's acts or omissions` OF FALSE, FALSE, FALSE, FALSE, TRUE, FALSE
`oa1 test: facts only (e)` MEANS `s 44.1(1): Facts about the person's acts or omissions` OF FALSE, FALSE, FALSE, FALSE, FALSE, TRUE

§ `s 44(1): the offence`

-- (a): each of the three limbs alone; none of them is not.
#ASSERT `s 44(1)(a): the person has done an act described in paragraph (a)` TRUE FALSE FALSE
#ASSERT `s 44(1)(a): the person has done an act described in paragraph (a)` FALSE TRUE FALSE
#ASSERT `s 44(1)(a): the person has done an act described in paragraph (a)` FALSE FALSE TRUE
#ASSERT NOT (`s 44(1)(a): the person has done an act described in paragraph (a)` FALSE FALSE FALSE)
-- (b): the payee, who negotiates or attempts to, a cheque not theirs: all three.
#ASSERT `s 44(1)(b): the person has done an act described in paragraph (b)` TRUE TRUE TRUE
#ASSERT NOT (`s 44(1)(b): the person has done an act described in paragraph (b)` FALSE TRUE TRUE)
#ASSERT NOT (`s 44(1)(b): the person has done an act described in paragraph (b)` TRUE FALSE TRUE)
#ASSERT NOT (`s 44(1)(b): the person has done an act described in paragraph (b)` TRUE TRUE FALSE)
#ASSERT `s 44(1): the person is guilty of an offence punishable on summary conviction` TRUE FALSE
#ASSERT `s 44(1): the person is guilty of an offence punishable on summary conviction` FALSE TRUE
#ASSERT NOT (`s 44(1): the person is guilty of an offence punishable on summary conviction` FALSE FALSE)
-- NOT COVERED: the text states no fine and no term.
#ASSERT `s 44(1): the greatest fine that this Act sets for the offence` TRUE EQUALS NOTHING
#ASSERT NOT (`s 44(2): the information or complaint is open to objection` TRUE)
#ASSERT NOT (`s 44(2): the information or complaint is open to objection` FALSE)

§ `s 44(3): five years`

-- The Minister became aware March 10, 2026: five years after is March 10, 2031; proceedings on that day are in time, on March 11, 2031 not.
#ASSERT `s 44(3): proceedings in respect of an offence may be commenced on the day` (YMD 2026 3 10) (YMD 2031 3 10)
#ASSERT NOT (`s 44(3): proceedings in respect of an offence may be commenced on the day` (YMD 2026 3 10) (YMD 2031 3 11))
#ASSERT `s 44(3): proceedings in respect of an offence may be commenced on the day` (YMD 2026 3 10) (YMD 2026 3 10)
-- February 29: aware February 29, 2024; five years after is February 28, 2029 (the keel clamps to the end of a shorter month).
#ASSERT `s 44(3): proceedings in respect of an offence may be commenced on the day` (YMD 2024 2 29) (YMD 2029 2 28)
#ASSERT NOT (`s 44(3): proceedings in respect of an offence may be commenced on the day` (YMD 2024 2 29) (YMD 2029 3 1))
#ASSERT `s 44(4): a proceeding may be commenced under this section or the Criminal Code for the act or omission` FALSE
#ASSERT NOT (`s 44(4): a proceeding may be commenced under this section or the Criminal Code for the act or omission` TRUE)

§ `s 44.1(1): the Minister may impose a penalty`

#ASSERT `s 44.1(1): the Minister may impose a penalty on the person` TRUE `oa1 test: facts only (a)`
#ASSERT `s 44.1(1): the Minister may impose a penalty on the person` TRUE `oa1 test: facts only (a.1)`
#ASSERT `s 44.1(1): the Minister may impose a penalty on the person` TRUE `oa1 test: facts only (b)`
#ASSERT `s 44.1(1): the Minister may impose a penalty on the person` TRUE `oa1 test: facts only (c)`
#ASSERT `s 44.1(1): the Minister may impose a penalty on the person` TRUE `oa1 test: facts only (d)`
#ASSERT `s 44.1(1): the Minister may impose a penalty on the person` TRUE `oa1 test: facts only (e)`
#ASSERT NOT (`s 44.1(1): the Minister may impose a penalty on the person` TRUE `oa1 test: facts none`)
-- Every ground needs the Minister to have become aware of facts that in the Minister's opinion establish it.
#ASSERT NOT (`s 44.1(1): the Minister may impose a penalty on the person` FALSE `oa1 test: facts only (a)`)
#ASSERT `s 44.1(1)(a): the person made a statement or declaration that the person knew was false or misleading` `oa1 test: facts only (a)`
#ASSERT NOT (`s 44.1(1)(a): the person made a statement or declaration that the person knew was false or misleading` `oa1 test: facts only (b)`)
#ASSERT `s 44.1(1)(a.1): the person knowingly failed to correct inaccuracies in the information provided by the Minister` `oa1 test: facts only (a.1)`
#ASSERT `s 44.1(1)(b): the person made a statement or declaration that the person knew was false or misleading because of the non-disclosure of facts` `oa1 test: facts only (b)`
#ASSERT `s 44.1(1)(c): the person knowingly failed to declare income to the Minister` `oa1 test: facts only (c)`
#ASSERT `s 44.1(1)(d): the person received a benefit payment the person knew they were not entitled to and did not return it without delay` `oa1 test: facts only (d)`
#ASSERT `s 44.1(1)(e): the person participated in, assented to or acquiesced in an act or omission mentioned in any of paragraphs (a) to (d)` `oa1 test: facts only (e)`
#ASSERT NOT (`s 44.1(1)(e): the person participated in, assented to or acquiesced in an act or omission mentioned in any of paragraphs (a) to (d)` `oa1 test: facts only (a)`)

§ `s 44.1: the penalty`

#ASSERT `s 44.1(1.1): the purpose of the penalty` EQUALS "to promote compliance with this Act and not to punish"
#ASSERT `s 44.1(2): the greatest amount of the penalty for each act or omission` EQUALS 10000
#ASSERT `s 44.1(2): the Minister may set the amount of the penalty at the amount` 10000
#ASSERT `s 44.1(2): the Minister may set the amount of the penalty at the amount` 250
#ASSERT NOT (`s 44.1(2): the Minister may set the amount of the penalty at the amount` 10000.01)

-- (3): aware March 10, 2026; no prosecution; five years run to March 10, 2031 (that day still within, March 11 not). A prosecution bars it.
#ASSERT `s 44.1(3): a penalty may be imposed on the person on the day` FALSE (YMD 2026 3 10) (YMD 2031 3 10)
#ASSERT NOT (`s 44.1(3): a penalty may be imposed on the person on the day` FALSE (YMD 2026 3 10) (YMD 2031 3 11))
#ASSERT NOT (`s 44.1(3): a penalty may be imposed on the person on the day` TRUE (YMD 2026 3 10) (YMD 2026 4 1))
#ASSERT `s 44.1(3): a penalty may be imposed on the person on the day` FALSE (YMD 2026 3 10) (YMD 2026 4 1)

-- (4): any one of four grounds.
#ASSERT `s 44.1(4): the Minister may rescind the imposition of the penalty or reduce it` TRUE FALSE FALSE FALSE
#ASSERT `s 44.1(4): the Minister may rescind the imposition of the penalty or reduce it` FALSE TRUE FALSE FALSE
#ASSERT `s 44.1(4): the Minister may rescind the imposition of the penalty or reduce it` FALSE FALSE TRUE FALSE
#ASSERT `s 44.1(4): the Minister may rescind the imposition of the penalty or reduce it` FALSE FALSE FALSE TRUE
#ASSERT NOT (`s 44.1(4): the Minister may rescind the imposition of the penalty or reduce it` FALSE FALSE FALSE FALSE)
