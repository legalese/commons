IMPORT prelude
IMPORT daydate
IMPORT `oas-core`
IMPORT `oas-core-measures`
IMPORT `oa1-part4-recovery`

-- Tests of oa1-part4-recovery. Every expected value is worked by hand from the text of ss 36 and 37.

§ `s 36(1) and (1.1): not assignable, not seizable`

#ASSERT `s 36(1): the transaction is void` TRUE
#ASSERT NOT (`s 36(1): the transaction is void` FALSE)
#ASSERT NOT (`s 36(1.1): the benefit is liable to the seizure or execution` TRUE)
#ASSERT NOT (`s 36(1.1): the benefit is liable to the seizure or execution` FALSE)

§ `s 36(2): a province or municipality`

-- The authority paid $300 for a month; a benefit later became payable for it; the prescribed terms are met: at most $300 may be deducted and paid.
#ASSERT `s 36(2): the most the Minister may deduct from the benefit and pay to the provincial authority or municipal authority` TRUE TRUE TRUE 300 EQUALS JUST 300
#ASSERT `s 36(2): the most the Minister may deduct from the benefit and pay to the provincial authority or municipal authority` FALSE TRUE TRUE 300 EQUALS NOTHING
#ASSERT `s 36(2): the most the Minister may deduct from the benefit and pay to the provincial authority or municipal authority` TRUE FALSE TRUE 300 EQUALS NOTHING
#ASSERT `s 36(2): the most the Minister may deduct from the benefit and pay to the provincial authority or municipal authority` TRUE TRUE FALSE 300 EQUALS NOTHING

§ `s 36(3): the Department of Veterans Affairs`

#ASSERT `s 36(3): the most the Minister may deduct from the benefit and pay to the Department of Veterans Affairs` TRUE TRUE TRUE 450 EQUALS JUST 450
#ASSERT `s 36(3): the most the Minister may deduct from the benefit and pay to the Department of Veterans Affairs` TRUE TRUE FALSE 450 EQUALS NOTHING
#ASSERT `s 36(3): the most the Minister may deduct from the benefit and pay to the Department of Veterans Affairs` FALSE TRUE TRUE 450 EQUALS NOTHING
#ASSERT `s 36(3): the most the Minister may deduct from the benefit and pay to the Department of Veterans Affairs` TRUE FALSE TRUE 450 EQUALS NOTHING

§ `s 37(1) and (2): return of a payment`

-- Received $1,000 and entitled to nothing: the whole payment is returned. Entitled to $800: the $200 excess. Entitled to more than received: nothing.
#ASSERT `s 37(1): the amount the person shall forthwith return` 1000 0 EQUALS 1000
#ASSERT `s 37(1): the amount the person shall forthwith return` 1000 800 EQUALS 200
#ASSERT `s 37(1): the amount the person shall forthwith return` 800 1000 EQUALS 0
#ASSERT `s 37(2): the debt due to Her Majesty for a benefit payment` 1000 800 EQUALS 200
#ASSERT `s 37(2): the debt is recoverable on the day` (YearMonthDay 2026 1 1)
#ASSERT `s 37(2): the debt is recoverable on the day` (YearMonthDay 2056 1 1)
#ASSERT `s 37(2.01): the debt due to Her Majesty for interest` 12.5 EQUALS 12.5
#ASSERT `s 37(2.02): the debt due to Her Majesty for a penalty` 2000 EQUALS 2000
#ASSERT `s 37(2.8): the debt due to Her Majesty for an amount not paid as the notice requires` 75 EQUALS 75
#ASSERT `oa1: the total of a person's debts for a payment, interest and a penalty` 200 12.5 2000 EQUALS 2212.5

§ `s 37(2.1): set-off`

-- A debt of $500 against $300 payable: $300; against $900 payable: $500; not in the prescribed manner: nothing.
#ASSERT `s 37(2.1): the most that may be deducted and retained out of the amount payable` 500 300 TRUE EQUALS 300
#ASSERT `s 37(2.1): the most that may be deducted and retained out of the amount payable` 500 900 TRUE EQUALS 500
#ASSERT `s 37(2.1): the most that may be deducted and retained out of the amount payable` 500 900 FALSE EQUALS 0

§ `s 37(2.2): certificates`

-- Attempting to avoid payment: without delay (the day of the default itself). Otherwise: after the thirtieth day after the default (default January 1: January 31 is the thirtieth day).
#ASSERT `s 37(2.2): the Minister may certify the debt that has not been recovered on the day` TRUE TRUE (YearMonthDay 2026 1 1) (YearMonthDay 2026 1 1)
#ASSERT NOT (`s 37(2.2): the Minister may certify the debt that has not been recovered on the day` TRUE FALSE (YearMonthDay 2026 1 1) (YearMonthDay 2026 1 31))
#ASSERT `s 37(2.2): the Minister may certify the debt that has not been recovered on the day` TRUE FALSE (YearMonthDay 2026 1 1) (YearMonthDay 2026 2 1)
#ASSERT NOT (`s 37(2.2): the Minister may certify the debt that has not been recovered on the day` FALSE TRUE (YearMonthDay 2026 1 1) (YearMonthDay 2026 2 1))

§ `s 37(2.3) to (2.9): judgment, costs, land, garnishment, evidence`

#ASSERT `s 37(2.3): the amount of the judgment debt that the certificate has the force and effect of` TRUE 1800 EQUALS JUST 1800
#ASSERT `s 37(2.3): the amount of the judgment debt that the certificate has the force and effect of` FALSE 1800 EQUALS NOTHING
#ASSERT `s 37(2.4): the certificate may also be registered in the superior court of a province` TRUE
#ASSERT NOT (`s 37(2.4): the certificate may also be registered in the superior court of a province` FALSE)
#ASSERT `s 37(2.5): the costs and charges that are recoverable in the same way` TRUE 150 EQUALS 150
#ASSERT `s 37(2.5): the costs and charges that are recoverable in the same way` FALSE 150 EQUALS 0
#ASSERT `s 37(2.6): the document may be recorded to create security, or a charge, lien or legal hypothec, on the land` TRUE TRUE
#ASSERT NOT (`s 37(2.6): the document may be recorded to create security, or a charge, lien or legal hypothec, on the land` TRUE FALSE)
#ASSERT NOT (`s 37(2.6): the document may be recorded to create security, or a charge, lien or legal hypothec, on the land` FALSE TRUE)
#ASSERT `s 37(2.7): the Minister may require the first person to pay the money otherwise payable to the second person to the Receiver General` TRUE TRUE
#ASSERT NOT (`s 37(2.7): the Minister may require the first person to pay the money otherwise payable to the second person to the Receiver General` TRUE FALSE)
#ASSERT NOT (`s 37(2.7): the Minister may require the first person to pay the money otherwise payable to the second person to the Receiver General` FALSE TRUE)
#ASSERT `s 37(2.9): the affidavit is evidence of the personal service and of the request, notice or demand` TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 37(2.9): the affidavit is evidence of the personal service and of the request, notice or demand` TRUE TRUE TRUE FALSE)
#ASSERT NOT (`s 37(2.9): the affidavit is evidence of the personal service and of the request, notice or demand` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 37(2.9): the affidavit is evidence of the personal service and of the request, notice or demand` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 37(2.9): the affidavit is evidence of the personal service and of the request, notice or demand` FALSE TRUE TRUE TRUE)

§ `s 37(4): remission`

-- Any one of the four grounds; not if convicted.
#ASSERT `s 37(4): the Minister may remit all or any portion of the amount or excess of the benefit payment` TRUE FALSE FALSE FALSE FALSE
#ASSERT `s 37(4): the Minister may remit all or any portion of the amount or excess of the benefit payment` FALSE TRUE FALSE FALSE FALSE
#ASSERT `s 37(4): the Minister may remit all or any portion of the amount or excess of the benefit payment` FALSE FALSE TRUE FALSE FALSE
#ASSERT `s 37(4): the Minister may remit all or any portion of the amount or excess of the benefit payment` FALSE FALSE FALSE TRUE FALSE
#ASSERT NOT (`s 37(4): the Minister may remit all or any portion of the amount or excess of the benefit payment` FALSE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`s 37(4): the Minister may remit all or any portion of the amount or excess of the benefit payment` TRUE TRUE TRUE TRUE TRUE)

§ `s 37(5): the Financial Administration Act`

#ASSERT NOT (`s 37(5): section 155.1 of the Financial Administration Act applies in relation to the amount` TRUE)
