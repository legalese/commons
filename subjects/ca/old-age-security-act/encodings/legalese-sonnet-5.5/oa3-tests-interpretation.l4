IMPORT prelude
IMPORT daydate
IMPORT `oas-core`
IMPORT `oas-core-measures`
IMPORT `oa3-regs-interpretation`

-- Tests of oa3-regs-interpretation.l4 (regulation 2). Every expected value is worked out by hand from the words of the definition.

-- Act: the Old Age Security Act, and nothing else.
#ASSERT `reg 2(1): the statute is the Act` TRUE
#ASSERT NOT (`reg 2(1): the statute is the Act` FALSE)

-- appeal: referred to in s 28(1) of the Act OR made in respect of a reference.
#ASSERT `reg 2(1): the appeal is an appeal for the purposes of these Regulations` TRUE FALSE
#ASSERT `reg 2(1): the appeal is an appeal for the purposes of these Regulations` FALSE TRUE
#ASSERT `reg 2(1): the appeal is an appeal for the purposes of these Regulations` TRUE TRUE
#ASSERT NOT (`reg 2(1): the appeal is an appeal for the purposes of these Regulations` FALSE FALSE)

-- appellant: a person who makes an appeal referred to in s 28(1) or (2) OR in respect of a reference.
#ASSERT `reg 2(1): the person is an appellant` TRUE FALSE
#ASSERT `reg 2(1): the person is an appellant` FALSE TRUE
#ASSERT `reg 2(1): the person is an appellant` TRUE TRUE
#ASSERT NOT (`reg 2(1): the person is an appellant` FALSE FALSE)

-- application form: the form of application required by the Minister.
#ASSERT `reg 2(1): the form is an application form` TRUE
#ASSERT NOT (`reg 2(1): the form is an application form` FALSE)

-- beneficiary includes a person on whose behalf a benefit has become payable.
#ASSERT `reg 2(1): the person is a beneficiary for the purposes of these Regulations` TRUE FALSE
#ASSERT `reg 2(1): the person is a beneficiary for the purposes of these Regulations` FALSE TRUE
#ASSERT `reg 2(1): the person is a beneficiary for the purposes of these Regulations` TRUE TRUE
#ASSERT NOT (`reg 2(1): the person is a beneficiary for the purposes of these Regulations` FALSE FALSE)

-- Court: the Tax Court of Canada.
#ASSERT `reg 2(1): the court is the Court` TRUE
#ASSERT NOT (`reg 2(1): the court is the Court` FALSE)

-- reference: a reference to the Tax Court of Canada under s 28(2) of the Act.
#ASSERT `reg 2(1): the proceeding is a reference` TRUE
#ASSERT NOT (`reg 2(1): the proceeding is a reference` FALSE)

-- request for reconsideration: a request to the Minister under s 27.1 of the Act.
#ASSERT `reg 2(1): the request is a request for reconsideration` TRUE
#ASSERT NOT (`reg 2(1): the request is a request for reconsideration` FALSE)

-- Reg 2(2): the date of union of Newfoundland with Canada is 1949-03-31 (an input); only days BEFORE it are deemed Canada.
#ASSERT `reg 2(2): the residence or presence in Newfoundland on the day is deemed to be residence or presence in Canada` (YMD 1949 3 30) (YMD 1949 3 31)
#ASSERT NOT (`reg 2(2): the residence or presence in Newfoundland on the day is deemed to be residence or presence in Canada` (YMD 1949 3 31) (YMD 1949 3 31))
#ASSERT NOT (`reg 2(2): the residence or presence in Newfoundland on the day is deemed to be residence or presence in Canada` (YMD 1949 4 1) (YMD 1949 3 31))
#ASSERT `reg 2(2): the residence or presence in Newfoundland on the day is deemed to be residence or presence in Canada` (YMD 1900 1 1) (YMD 1949 3 31)

-- Reg 2(3): (employed in a federal institution OR services required by one) AND (casual or temporary OR student employment program).
#ASSERT `reg 2(3): the individual is a prescribed individual for the purpose of the definition public officer in subsection 33(1) of the Act` TRUE FALSE TRUE FALSE
#ASSERT `reg 2(3): the individual is a prescribed individual for the purpose of the definition public officer in subsection 33(1) of the Act` FALSE TRUE FALSE TRUE
#ASSERT `reg 2(3): the individual is a prescribed individual for the purpose of the definition public officer in subsection 33(1) of the Act` TRUE FALSE TRUE TRUE
#ASSERT `reg 2(3): the individual is a prescribed individual for the purpose of the definition public officer in subsection 33(1) of the Act` FALSE TRUE TRUE FALSE
#ASSERT NOT (`reg 2(3): the individual is a prescribed individual for the purpose of the definition public officer in subsection 33(1) of the Act` TRUE FALSE FALSE FALSE)
#ASSERT NOT (`reg 2(3): the individual is a prescribed individual for the purpose of the definition public officer in subsection 33(1) of the Act` FALSE FALSE TRUE TRUE)
#ASSERT NOT (`reg 2(3): the individual is a prescribed individual for the purpose of the definition public officer in subsection 33(1) of the Act` TRUE TRUE FALSE FALSE)
#ASSERT NOT (`reg 2(3): the individual is a prescribed individual for the purpose of the definition public officer in subsection 33(1) of the Act` FALSE FALSE FALSE FALSE)
