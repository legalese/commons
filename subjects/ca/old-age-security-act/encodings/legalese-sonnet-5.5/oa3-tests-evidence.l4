IMPORT prelude
IMPORT daydate
IMPORT `oas-core`
IMPORT `oas-core-measures`
IMPORT `oa3-part1-evidence`

-- Tests of oa3-part1-evidence.l4 (regs 15 to 20 and 23). Every expected value is worked out by hand from the words of the regulation.

-- Reg 15: the power exists only where a number has not been assigned.
#ASSERT `reg 15: the Minister may assign or cause to be assigned a Social Insurance Number` TRUE
#ASSERT NOT (`reg 15: the Minister may assign or cause to be assigned a Social Insurance Number` FALSE)

-- Reg 16(1): the document depends on the kind of relationship; no document is called for once the information has arrived.
#ASSERT `reg 16(1): the document of which the Minister may require submission` TRUE `reg 16(1)(a): spouses` EQUALS JUST `reg 16(1)(a): a certificate of marriage, a copy of that certificate or a copy of the act of marriage`
#ASSERT `reg 16(1): the document of which the Minister may require submission` TRUE `reg 16(1)(b): common-law partners` EQUALS JUST `reg 16(1)(b): a statutory declaration setting out information as to the relationship or, if applicable, any other evidence of the relationship`
#ASSERT `reg 16(1): the document of which the Minister may require submission` FALSE `reg 16(1)(a): spouses` EQUALS NOTHING
#ASSERT `reg 16(1): the document of which the Minister may require submission` FALSE `reg 16(1)(b): common-law partners` EQUALS NOTHING
-- Reg 16(2): only on reasonable grounds to doubt the copy.
#ASSERT `reg 16(2): the Minister may require the original certificate of marriage or, if applicable, a copy of the act of marriage issued by the competent authority` TRUE
#ASSERT NOT (`reg 16(2): the Minister may require the original certificate of marriage or, if applicable, a copy of the act of marriage issued by the competent authority` FALSE)
-- Reg 16(3): only on reasonable grounds to believe none of the (1)(a) documents is available.
#ASSERT `reg 16(3): the Minister may determine the relationship on the basis of a statutory declaration or other evidence of the marriage` TRUE
#ASSERT NOT (`reg 16(3): the Minister may determine the relationship on the basis of a statutory declaration or other evidence of the marriage` FALSE)

-- Reg 17: waiver under s 11(3.1) AND not enough evidence about a spouse or common-law partner.
#ASSERT `reg 17: the Minister may use the person's tax return filed with the Minister of National Revenue` TRUE TRUE
#ASSERT NOT (`reg 17: the Minister may use the person's tax return filed with the Minister of National Revenue` TRUE FALSE)
#ASSERT NOT (`reg 17: the Minister may use the person's tax return filed with the Minister of National Revenue` FALSE TRUE)
#ASSERT NOT (`reg 17: the Minister may use the person's tax return filed with the Minister of National Revenue` FALSE FALSE)
-- Reg 17: the most recent calendar year for which the filing due date has passed (arguments: the question day, the due date of the previous calendar year's return).
-- after the 2021-04-30 due date of the 2020 return, 2020 counts.
#ASSERT `reg 17: the most recent calendar year for which the filing due date has passed` (YearMonthDay 2021 6 15) (YearMonthDay 2021 4 30) EQUALS 2020
-- before it, only the 2019 return counts.
#ASSERT `reg 17: the most recent calendar year for which the filing due date has passed` (YearMonthDay 2021 1 15) (YearMonthDay 2021 4 30) EQUALS 2019
-- on the due date itself it has not passed (fork F-17 in NOTES.md).
#ASSERT `reg 17: the most recent calendar year for which the filing due date has passed` (YearMonthDay 2021 4 30) (YearMonthDay 2021 4 30) EQUALS 2019
-- the day after the due date it has passed.
#ASSERT `reg 17: the most recent calendar year for which the filing due date has passed` (YearMonthDay 2021 5 1) (YearMonthDay 2021 4 30) EQUALS 2020
-- a 15 June due date (self-employed), on the day.
#ASSERT `reg 17: the most recent calendar year for which the filing due date has passed` (YearMonthDay 2021 6 15) (YearMonthDay 2021 6 15) EQUALS 2019
-- a 15 June due date, the day after.
#ASSERT `reg 17: the most recent calendar year for which the filing due date has passed` (YearMonthDay 2021 6 16) (YearMonthDay 2021 6 15) EQUALS 2020
-- 31 December 2020: the 2019 return (due 2020-04-30) is the latest whose date has passed, so 2019.
#ASSERT `reg 17: the most recent calendar year for which the filing due date has passed` (YearMonthDay 2020 12 31) (YearMonthDay 2020 4 30) EQUALS 2019
-- 1 January 2022: the 2021 return is not due until 2022-04-30, so the 2020 return (due 2021-04-30) is the latest whose date has passed.
#ASSERT `reg 17: the most recent calendar year for which the filing due date has passed` (YearMonthDay 2022 1 1) (YearMonthDay 2022 4 30) EQUALS 2020

-- Reg 18(1): a document under (a) or information under (b).
#ASSERT `reg 18(1): the Minister can determine the applicant's age and identity on the basis of paragraph (a) or (b)` TRUE FALSE
#ASSERT `reg 18(1): the Minister can determine the applicant's age and identity on the basis of paragraph (a) or (b)` FALSE TRUE
#ASSERT `reg 18(1): the Minister can determine the applicant's age and identity on the basis of paragraph (a) or (b)` TRUE TRUE
#ASSERT NOT (`reg 18(1): the Minister can determine the applicant's age and identity on the basis of paragraph (a) or (b)` FALSE FALSE)
-- Reg 18(2): only on reasonable grounds to doubt the copy.
#ASSERT `reg 18(2): the Minister may require the original birth certificate or, if applicable, a copy of the act of birth issued by the competent authority` TRUE
#ASSERT NOT (`reg 18(2): the Minister may require the original birth certificate or, if applicable, a copy of the act of birth issued by the competent authority` FALSE)
-- Reg 18(3): only on reasonable grounds to believe none of the (1)(a) documents is available.
#ASSERT `reg 18(3): the Minister may determine the applicant's age and identity on the basis of any other information or evidence` TRUE
#ASSERT NOT (`reg 18(3): the Minister may determine the applicant's age and identity on the basis of any other information or evidence` FALSE)
-- Reg 18(4): unable under (1) to (3), and it is possible.
#ASSERT `reg 18(4): the Minister may determine the applicant's age and identity on the basis of information obtained from Statistics Canada` TRUE TRUE
#ASSERT NOT (`reg 18(4): the Minister may determine the applicant's age and identity on the basis of information obtained from Statistics Canada` TRUE FALSE)
#ASSERT NOT (`reg 18(4): the Minister may determine the applicant's age and identity on the basis of information obtained from Statistics Canada` FALSE TRUE)
#ASSERT NOT (`reg 18(4): the Minister may determine the applicant's age and identity on the basis of information obtained from Statistics Canada` FALSE FALSE)

-- Reg 18.1(a): all three of (i) form, (ii) signed consent, (iii) specific information.
#ASSERT `reg 18.1(a): the request to Statistics Canada meets the conditions` TRUE TRUE TRUE
#ASSERT NOT (`reg 18.1(a): the request to Statistics Canada meets the conditions` FALSE TRUE TRUE)
#ASSERT NOT (`reg 18.1(a): the request to Statistics Canada meets the conditions` TRUE FALSE TRUE)
#ASSERT NOT (`reg 18.1(a): the request to Statistics Canada meets the conditions` TRUE TRUE FALSE)
#ASSERT NOT (`reg 18.1(a): the request to Statistics Canada meets the conditions` FALSE FALSE FALSE)
-- Reg 18.1(b): kept confidential AND not used for another purpose (arguments: kept confidential, used for another purpose).
#ASSERT `reg 18.1(b): the information supplied by Statistics Canada is handled as the condition requires` TRUE FALSE
#ASSERT NOT (`reg 18.1(b): the information supplied by Statistics Canada is handled as the condition requires` FALSE FALSE)
#ASSERT NOT (`reg 18.1(b): the information supplied by Statistics Canada is handled as the condition requires` TRUE TRUE)
#ASSERT NOT (`reg 18.1(b): the information supplied by Statistics Canada is handled as the condition requires` FALSE TRUE)
-- Reg 18.1 as a whole: (a) and (b).
#ASSERT `reg 18.1: the conditions for the purposes of section 6 of the Act are met` TRUE TRUE
#ASSERT NOT (`reg 18.1: the conditions for the purposes of section 6 of the Act are met` TRUE FALSE)
#ASSERT NOT (`reg 18.1: the conditions for the purposes of section 6 of the Act are met` FALSE TRUE)
#ASSERT NOT (`reg 18.1: the conditions for the purposes of section 6 of the Act are met` FALSE FALSE)
-- Reg 19.
#ASSERT `reg 19: the Minister may accept the determination of the applicant's age made under the Canada Pension Plan` TRUE
#ASSERT NOT (`reg 19: the Minister may accept the determination of the applicant's age made under the Canada Pension Plan` FALSE)

-- Reg 20(2): the Act's circumstances exist AND the Minister has not required otherwise.
#ASSERT `reg 20(2): the person is not required to provide a statement under subsection (1)` TRUE FALSE
#ASSERT NOT (`reg 20(2): the person is not required to provide a statement under subsection (1)` TRUE TRUE)
#ASSERT NOT (`reg 20(2): the person is not required to provide a statement under subsection (1)` FALSE FALSE)
#ASSERT NOT (`reg 20(2): the person is not required to provide a statement under subsection (1)` FALSE TRUE)
-- Reg 20(1): the duty to provide the statement (arguments: eligibility being determined, the Act's circumstances exist, the Minister requires otherwise).
#ASSERT `reg 20(1): the person or someone acting on the person's behalf must provide a statement giving full particulars of all periods of residence in Canada and of all absences from Canada that are relevant to that eligibility` TRUE FALSE FALSE
#ASSERT NOT (`reg 20(1): the person or someone acting on the person's behalf must provide a statement giving full particulars of all periods of residence in Canada and of all absences from Canada that are relevant to that eligibility` TRUE TRUE FALSE)
#ASSERT `reg 20(1): the person or someone acting on the person's behalf must provide a statement giving full particulars of all periods of residence in Canada and of all absences from Canada that are relevant to that eligibility` TRUE TRUE TRUE
#ASSERT `reg 20(1): the person or someone acting on the person's behalf must provide a statement giving full particulars of all periods of residence in Canada and of all absences from Canada that are relevant to that eligibility` TRUE FALSE TRUE
#ASSERT NOT (`reg 20(1): the person or someone acting on the person's behalf must provide a statement giving full particulars of all periods of residence in Canada and of all absences from Canada that are relevant to that eligibility` FALSE FALSE FALSE)
#ASSERT NOT (`reg 20(1): the person or someone acting on the person's behalf must provide a statement giving full particulars of all periods of residence in Canada and of all absences from Canada that are relevant to that eligibility` FALSE TRUE FALSE)

-- Reg 23(1): any of the four roles (arguments: applicant, person who applied for the applicant, beneficiary, person receiving payment for the applicant).
#ASSERT `reg 23(1): the Minister may require the person to make available or allow to be made available further information or evidence regarding the eligibility of the applicant or the beneficiary for a benefit` TRUE FALSE FALSE FALSE
#ASSERT `reg 23(1): the Minister may require the person to make available or allow to be made available further information or evidence regarding the eligibility of the applicant or the beneficiary for a benefit` FALSE TRUE FALSE FALSE
#ASSERT `reg 23(1): the Minister may require the person to make available or allow to be made available further information or evidence regarding the eligibility of the applicant or the beneficiary for a benefit` FALSE FALSE TRUE FALSE
#ASSERT `reg 23(1): the Minister may require the person to make available or allow to be made available further information or evidence regarding the eligibility of the applicant or the beneficiary for a benefit` FALSE FALSE FALSE TRUE
#ASSERT `reg 23(1): the Minister may require the person to make available or allow to be made available further information or evidence regarding the eligibility of the applicant or the beneficiary for a benefit` TRUE FALSE TRUE FALSE
#ASSERT NOT (`reg 23(1): the Minister may require the person to make available or allow to be made available further information or evidence regarding the eligibility of the applicant or the beneficiary for a benefit` FALSE FALSE FALSE FALSE)
-- Reg 23(2): no condition.
#ASSERT `reg 23(2): the Minister may at any time make an investigation into the eligibility of a person to receive a benefit`
