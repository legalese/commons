IMPORT prelude
IMPORT daydate
IMPORT `oas-core`
IMPORT `oas-core-measures`

-- Tests for the shared helpers in oas-core-measures. The helpers are not provisions; the expected values
-- are worked out by hand from the calendar and from ordinary arithmetic, not copied from the rules' output.

-- Months
#ASSERT `the first day of the month containing` (Date 22 10 2026) EQUALS Date 1 10 2026
#ASSERT `the first day of the month containing` (Date 1 10 2026) EQUALS Date 1 10 2026
#ASSERT `the last day of the month containing` (Date 22 10 2026) EQUALS Date 31 10 2026
#ASSERT `the last day of the month containing` (Date 1 2 2024) EQUALS Date 29 2 2024
#ASSERT `the last day of the month containing` (Date 15 2 2026) EQUALS Date 28 2 2026
#ASSERT `the last day of the month containing` (Date 15 4 2026) EQUALS Date 30 4 2026
-- November 2025 to March 2026: December, January, February, March.
#ASSERT `the number of months from the month containing` (Date 20 11 2025) `to the month containing` (Date 3 3 2026) EQUALS 4
#ASSERT `the number of months from the month containing` (Date 3 3 2026) `to the month containing` (Date 20 11 2025) EQUALS 0 MINUS 4
#ASSERT `the number of months from the month containing` (Date 1 7 2026) `to the month containing` (Date 30 7 2026) EQUALS 0
-- Five months before April 2026 is November 2025; three months after November 2025 is February 2026.
#ASSERT `the first day of the month that is` (0 MINUS 5) `months after the month containing` (Date 17 4 2026) EQUALS Date 1 11 2025
#ASSERT `the first day of the month that is` 3 `months after the month containing` (Date 17 11 2025) EQUALS Date 1 2 2026
#ASSERT `the first day of the month that is` 0 `months after the month containing` (Date 17 11 2025) EQUALS Date 1 11 2025
#ASSERT `the first day of the month that is` 14 `months after the month containing` (Date 31 10 2025) EQUALS Date 1 12 2026

-- YMD is Date with the arguments the other way round
#ASSERT YearMonthDay 2026 10 22 EQUALS Date 22 10 2026
#ASSERT YearMonthDay 2026 10 22 AT LEAST (YearMonthDay 2026 10 22)
#ASSERT YearMonthDay 1998 4 1 GREATER THAN (YearMonthDay 1998 3 31)

-- Ages. Born 15 March 1961: 65 years old from 15 March 2026.
#ASSERT `the age in complete years on` (Date 14 3 2026) `of a person born on` (Date 15 3 1961) EQUALS 64
#ASSERT `the age in complete years on` (Date 15 3 2026) `of a person born on` (Date 15 3 1961) EQUALS 65
#ASSERT `the age in complete years on` (Date 1 1 2027) `of a person born on` (Date 15 3 1961) EQUALS 65
#ASSERT `the age in complete years on` (Date 15 3 1961) `of a person born on` (Date 15 3 1961) EQUALS 0
#ASSERT `the day on which a person born on` (Date 31 1 1962) `attains the age of` 65 EQUALS Date 31 1 2027
#ASSERT `the month in which a person born on` (Date 31 1 1962) `attains the age of` 65 EQUALS Date 1 1 2027
-- A person born on 29 February 1960 (fork F5 in NOTES.md: the text does not say; add years clamps to 28 February).
#ASSERT `the day on which a person born on` (Date 29 2 1960) `attains the age of` 65 EQUALS Date 28 2 2025
#ASSERT `the age in complete years on` (Date 27 2 2025) `of a person born on` (Date 29 2 1960) EQUALS 64
#ASSERT `the age in complete years on` (Date 28 2 2025) `of a person born on` (Date 29 2 1960) EQUALS 65
#ASSERT `the age in complete years on` (Date 29 2 2028) `of a person born on` (Date 29 2 1960) EQUALS 68

-- Time limits. January, February and March 2026 have 31 + 28 + 31 = 90 days.
#ASSERT `the day that is` (`a limit in days` 90) `after` (Date 1 1 2026) EQUALS Date 1 4 2026
#ASSERT `the day that is` (`a limit in days` 0) `after` (Date 1 1 2026) EQUALS Date 1 1 2026
#ASSERT `the day that is` (`a limit in months` 3) `after` (Date 30 11 2025) EQUALS Date 28 2 2026
#ASSERT `the day that is` (`a limit in months` 6) `after` (Date 15 10 2026) EQUALS Date 15 4 2027
#ASSERT `the day that is` (`a limit in years` 1) `after` (Date 29 2 2024) EQUALS Date 28 2 2025
#ASSERT `the day that is` (`a limit in years` 1) `after` (Date 15 6 2025) EQUALS Date 15 6 2026
#ASSERT `the day that is` (`a limit in days` 15) `before` (Date 1 3 2026) EQUALS Date 14 2 2026
#ASSERT `the day that is` (`a limit in months` 11) `before` (Date 1 3 2026) EQUALS Date 1 4 2025
#ASSERT `the day that is` (`a limit in years` 2) `before` (Date 10 5 2026) EQUALS Date 10 5 2024
#ASSERT `the number of days from` (Date 1 1 2026) `to` (Date 1 4 2026) EQUALS 90
#ASSERT `the number of days from` (Date 1 4 2026) `to` (Date 1 1 2026) EQUALS 0 MINUS 90
#ASSERT (`a limit in months` 6)'s unit EQUALS Months
#ASSERT (`a limit in years` 1)'s `number of units` EQUALS 1

-- Rounding to a multiple
#ASSERT 13 `rounded to the next higher multiple of` 4 EQUALS 16
#ASSERT 12 `rounded to the next higher multiple of` 4 EQUALS 12
#ASSERT 12.01 `rounded to the next higher multiple of` 4 EQUALS 16
#ASSERT 0 `rounded to the next higher multiple of` 4 EQUALS 0
#ASSERT 13 `rounded to the next lower multiple of` 4 EQUALS 12
#ASSERT 12 `rounded to the next lower multiple of` 4 EQUALS 12
#ASSERT 15.99 `rounded to the next lower multiple of` 4 EQUALS 12
#ASSERT 2.5 `rounded to the next higher multiple of` 1 EQUALS 3
#ASSERT 7 `rounded to the next higher multiple of` 3 EQUALS 9
#ASSERT 9 `rounded to the next higher multiple of` 3 EQUALS 9

-- Rounding to the cent: a third digit of 5 raises the second; a third digit of 4 is dropped
#ASSERT `rounded to the nearest cent` 273.805 EQUALS 273.81
#ASSERT `rounded to the nearest cent` 273.8049 EQUALS 273.8
#ASSERT `rounded to the nearest cent` 273.804 EQUALS 273.8
#ASSERT `rounded to the nearest cent` 273.8 EQUALS 273.8
#ASSERT `rounded to the nearest cent` 1.995 EQUALS 2
#ASSERT `rounded to the nearest cent` 0.004 EQUALS 0
#ASSERT 1.25 `rounded half up to the number of decimal places` 1 EQUALS 1.3
#ASSERT 1.24 `rounded half up to the number of decimal places` 1 EQUALS 1.2
#ASSERT 0.12345 `rounded half up to the number of decimal places` 3 EQUALS 0.123
#ASSERT 0.1235 `rounded half up to the number of decimal places` 3 EQUALS 0.124
#ASSERT 5.5 `rounded half up to the number of decimal places` 0 EQUALS 6
