-- (4.3): the deadline for December 2022 is 15 days before December 1, November 16, 2022.
#ASSERT `s 19(4.3): the Minister must notify the spouse or common-law partner in writing that an application is required` TRUE TRUE
#ASSERT NOT `s 19(4.3): the Minister must notify the spouse or common-law partner in writing that an application is required` FALSE TRUE
#ASSERT NOT `s 19(4.3): the Minister must notify the spouse or common-law partner in writing that an application is required` TRUE FALSE
#ASSERT `s 19(4.3): the last day on which the Minister may give the notice` (YMD 2022 12 20) EQUALS (YMD 2022 11 16)

