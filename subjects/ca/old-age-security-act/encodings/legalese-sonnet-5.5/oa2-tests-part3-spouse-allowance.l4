#ASSERT NOT `s 19(4.01): the spouse or common-law partner may apply for an allowance individually` FALSE
#ASSERT `s 19(4.1): the Minister may waive the requirement for an application` TRUE
#ASSERT NOT `s 19(4.1): the Minister may waive the requirement for an application` FALSE
