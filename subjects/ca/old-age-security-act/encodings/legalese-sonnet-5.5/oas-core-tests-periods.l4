IMPORT prelude
IMPORT daydate
IMPORT `oas-core`
IMPORT `oas-core-measures`
IMPORT `oas-core-periods`

-- Tests for s 2 "payment period", "payment quarter", "first adjustment quarter", "second adjustment quarter"
-- and "Consumer Price Index". Every expected date is written from the words of the definition, not from the
-- rules' output.

-- payment period: (a) a month before April 1998 is in the fiscal year that includes it (April to March, F2)
#ASSERT (`the payment period in relation to the month containing` (Date 15 1 1996))'s `first day` EQUALS Date 1 4 1995
#ASSERT (`the payment period in relation to the month containing` (Date 15 1 1996))'s `last day` EQUALS Date 31 3 1996
#ASSERT (`the payment period in relation to the month containing` (Date 1 4 1997))'s `first day` EQUALS Date 1 4 1997
#ASSERT (`the payment period in relation to the month containing` (Date 1 4 1997))'s `last day` EQUALS Date 31 3 1998
-- the last month of paragraph (a): March 1998
#ASSERT (`the payment period in relation to the month containing` (Date 31 3 1998))'s `first day` EQUALS Date 1 4 1997
#ASSERT (`the payment period in relation to the month containing` (Date 31 3 1998))'s `last day` EQUALS Date 31 3 1998
-- (b) April 1, 1998 to June 30, 1999: both ends, and a month in the middle
#ASSERT (`the payment period in relation to the month containing` (Date 1 4 1998))'s `first day` EQUALS Date 1 4 1998
#ASSERT (`the payment period in relation to the month containing` (Date 1 4 1998))'s `last day` EQUALS Date 30 6 1999
#ASSERT (`the payment period in relation to the month containing` (Date 15 12 1998))'s `first day` EQUALS Date 1 4 1998
#ASSERT (`the payment period in relation to the month containing` (Date 15 12 1998))'s `last day` EQUALS Date 30 6 1999
#ASSERT (`the payment period in relation to the month containing` (Date 30 6 1999))'s `first day` EQUALS Date 1 4 1998
#ASSERT (`the payment period in relation to the month containing` (Date 30 6 1999))'s `last day` EQUALS Date 30 6 1999
-- (c) after June 30, 1999: July 1 to June 30
#ASSERT (`the payment period in relation to the month containing` (Date 1 7 1999))'s `first day` EQUALS Date 1 7 1999
#ASSERT (`the payment period in relation to the month containing` (Date 1 7 1999))'s `last day` EQUALS Date 30 6 2000
#ASSERT (`the payment period in relation to the month containing` (Date 15 10 2026))'s `first day` EQUALS Date 1 7 2026
#ASSERT (`the payment period in relation to the month containing` (Date 15 10 2026))'s `last day` EQUALS Date 30 6 2027
#ASSERT (`the payment period in relation to the month containing` (Date 15 5 2026))'s `first day` EQUALS Date 1 7 2025
#ASSERT (`the payment period in relation to the month containing` (Date 15 5 2026))'s `last day` EQUALS Date 30 6 2026
#ASSERT (`the payment period in relation to the month containing` (Date 30 6 2026))'s `first day` EQUALS Date 1 7 2025
#ASSERT (`the payment period in relation to the month containing` (Date 1 7 2026))'s `first day` EQUALS Date 1 7 2026
#ASSERT `the month in which a fiscal year begins` EQUALS 4

-- payment quarter: January, April, July, October
#ASSERT (`the payment quarter containing the month containing` (Date 3 2 2026))'s `first day` EQUALS Date 1 1 2026
#ASSERT (`the payment quarter containing the month containing` (Date 3 2 2026))'s `last day` EQUALS Date 31 3 2026
#ASSERT (`the payment quarter containing the month containing` (Date 31 3 2026))'s `first day` EQUALS Date 1 1 2026
#ASSERT (`the payment quarter containing the month containing` (Date 1 4 2026))'s `first day` EQUALS Date 1 4 2026
#ASSERT (`the payment quarter containing the month containing` (Date 1 4 2026))'s `last day` EQUALS Date 30 6 2026
#ASSERT (`the payment quarter containing the month containing` (Date 30 6 2026))'s `first day` EQUALS Date 1 4 2026
#ASSERT (`the payment quarter containing the month containing` (Date 1 7 2026))'s `first day` EQUALS Date 1 7 2026
#ASSERT (`the payment quarter containing the month containing` (Date 1 7 2026))'s `last day` EQUALS Date 30 9 2026
#ASSERT (`the payment quarter containing the month containing` (Date 22 10 2026))'s `first day` EQUALS Date 1 10 2026
#ASSERT (`the payment quarter containing the month containing` (Date 22 10 2026))'s `last day` EQUALS Date 31 12 2026
#ASSERT (`the payment quarter containing the month containing` (Date 31 12 2026))'s `first day` EQUALS Date 1 10 2026
-- the quarter that began on January 1, 1985 (s 7(1))
#ASSERT (`the payment quarter containing the month containing` (Date 15 2 1985))'s `first day` EQUALS Date 1 1 1985
#ASSERT (`the payment quarter containing the month containing` (Date 15 2 1985))'s `last day` EQUALS Date 31 3 1985

-- first adjustment quarter: (a) payment quarter commencing April 1, 2026 -> the three months commencing November 1, 2025
#ASSERT (`the first adjustment quarter in relation to the payment quarter containing` (Date 1 4 2026))'s `first day` EQUALS Date 1 11 2025
#ASSERT (`the first adjustment quarter in relation to the payment quarter containing` (Date 1 4 2026))'s `last day` EQUALS Date 31 1 2026
-- any date in the payment quarter gives the same answer
#ASSERT (`the first adjustment quarter in relation to the payment quarter containing` (Date 20 5 2026))'s `first day` EQUALS Date 1 11 2025
#ASSERT (`the first adjustment quarter in relation to the payment quarter containing` (Date 30 6 2026))'s `last day` EQUALS Date 31 1 2026
-- (b) July 1, 2026 -> February 1, 2026 to April 30, 2026
#ASSERT (`the first adjustment quarter in relation to the payment quarter containing` (Date 1 7 2026))'s `first day` EQUALS Date 1 2 2026
#ASSERT (`the first adjustment quarter in relation to the payment quarter containing` (Date 1 7 2026))'s `last day` EQUALS Date 30 4 2026
-- (c) October 1, 2026 -> May 1, 2026 to July 31, 2026
#ASSERT (`the first adjustment quarter in relation to the payment quarter containing` (Date 1 10 2026))'s `first day` EQUALS Date 1 5 2026
#ASSERT (`the first adjustment quarter in relation to the payment quarter containing` (Date 1 10 2026))'s `last day` EQUALS Date 31 7 2026
-- (d) January 1, 2026 -> August 1, 2025 to October 31, 2025
#ASSERT (`the first adjustment quarter in relation to the payment quarter containing` (Date 1 1 2026))'s `first day` EQUALS Date 1 8 2025
#ASSERT (`the first adjustment quarter in relation to the payment quarter containing` (Date 1 1 2026))'s `last day` EQUALS Date 31 10 2025
-- (d) in a leap-year neighbourhood: January 1, 2025 -> August 1, 2024 to October 31, 2024
#ASSERT (`the first adjustment quarter in relation to the payment quarter containing` (Date 15 2 2025))'s `first day` EQUALS Date 1 8 2024

-- second adjustment quarter: (a) April 1, 2026 -> August 1, 2025 to October 31, 2025
#ASSERT (`the second adjustment quarter in relation to the payment quarter containing` (Date 1 4 2026))'s `first day` EQUALS Date 1 8 2025
#ASSERT (`the second adjustment quarter in relation to the payment quarter containing` (Date 1 4 2026))'s `last day` EQUALS Date 31 10 2025
-- (b) July 1, 2026 -> November 1, 2025 to January 31, 2026
#ASSERT (`the second adjustment quarter in relation to the payment quarter containing` (Date 1 7 2026))'s `first day` EQUALS Date 1 11 2025
#ASSERT (`the second adjustment quarter in relation to the payment quarter containing` (Date 1 7 2026))'s `last day` EQUALS Date 31 1 2026
-- (c) October 1, 2026 -> February 1, 2026 to April 30, 2026
#ASSERT (`the second adjustment quarter in relation to the payment quarter containing` (Date 1 10 2026))'s `first day` EQUALS Date 1 2 2026
#ASSERT (`the second adjustment quarter in relation to the payment quarter containing` (Date 1 10 2026))'s `last day` EQUALS Date 30 4 2026
-- (d) January 1, 2026 -> May 1, 2025 to July 31, 2025
#ASSERT (`the second adjustment quarter in relation to the payment quarter containing` (Date 1 1 2026))'s `first day` EQUALS Date 1 5 2025
#ASSERT (`the second adjustment quarter in relation to the payment quarter containing` (Date 1 1 2026))'s `last day` EQUALS Date 31 7 2025
-- the quarter that began on January 1, 1985 (s 7(1)): its first adjustment quarter began August 1, 1984
#ASSERT (`the first adjustment quarter in relation to the payment quarter containing` (Date 1 1 1985))'s `first day` EQUALS Date 1 8 1984
#ASSERT (`the second adjustment quarter in relation to the payment quarter containing` (Date 1 1 1985))'s `first day` EQUALS Date 1 5 1984

-- Consumer Price Index: the average of the three monthly figures (306 / 3 = 102; 301 / 3 is not a whole number)
#ASSERT `the Consumer Price Index for an adjustment quarter` 100 101 105 EQUALS 102
#ASSERT `the Consumer Price Index for an adjustment quarter` 150 150 150 EQUALS 150
#ASSERT `the Consumer Price Index for an adjustment quarter` 100 100 101 EQUALS 301 DIVIDED BY 3
#ASSERT `the Consumer Price Index for an adjustment quarter` 158.4 159.0 160.2 EQUALS 159.2
