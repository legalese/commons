IMPORT prelude
IMPORT daydate
IMPORT `oas-core`
IMPORT `oas-core-measures`
IMPORT `oa1-related`

-- Tests of oa1-related. Every expected value follows from the text of the Related Provisions.

§ `2007, c. 11, ss 37 and 38`

#ASSERT `2007, c. 11, s. 37: subparagraphs 11(7)(e)(ii), 19(6)(d)(ii) and 21(9)(c)(ii), as they read immediately before royal assent, continue to apply to the person` TRUE FALSE
#ASSERT `2007, c. 11, s. 37: subparagraphs 11(7)(e)(ii), 19(6)(d)(ii) and 21(9)(c)(ii), as they read immediately before royal assent, continue to apply to the person` FALSE TRUE
#ASSERT NOT (`2007, c. 11, s. 37: subparagraphs 11(7)(e)(ii), 19(6)(d)(ii) and 21(9)(c)(ii), as they read immediately before royal assent, continue to apply to the person` FALSE FALSE)
#ASSERT `2007, c. 11, s. 38: section 29, as it read immediately before royal assent, continues to apply in respect of the application` TRUE
#ASSERT NOT (`2007, c. 11, s. 38: section 29, as it read immediately before royal assent, continues to apply in respect of the application` FALSE)

§ `2010, c. 12, ss 1828 and 1829`

#ASSERT `2010, c. 12, s. 1828: the day on which the Agreement with the Republic of Poland is deemed to have come into force in Canada` EQUALS (YMD 2009 10 1)
#ASSERT `2010, c. 12, s. 1828: the Agreement with the Republic of Poland is deemed to have been in force in Canada on the day` (YMD 2009 10 1)
#ASSERT NOT (`2010, c. 12, s. 1828: the Agreement with the Republic of Poland is deemed to have been in force in Canada on the day` (YMD 2009 9 30))
-- Section 1828 came into force (say) July 12, 2010: an action on October 1, 2009 or on July 12, 2010 is deemed lawful; one on September 30, 2009 or July 13, 2010 is not.
#ASSERT `2010, c. 12, s. 1829: the action is deemed to be lawful` TRUE (YMD 2009 10 1) (YMD 2010 7 12)
#ASSERT `2010, c. 12, s. 1829: the action is deemed to be lawful` TRUE (YMD 2010 7 12) (YMD 2010 7 12)
#ASSERT NOT (`2010, c. 12, s. 1829: the action is deemed to be lawful` TRUE (YMD 2009 9 30) (YMD 2010 7 12))
#ASSERT NOT (`2010, c. 12, s. 1829: the action is deemed to be lawful` TRUE (YMD 2010 7 13) (YMD 2010 7 12))
#ASSERT NOT (`2010, c. 12, s. 1829: the action is deemed to be lawful` FALSE (YMD 2010 1 1) (YMD 2010 7 12))

§ `2012, c. 19, s 262`

#ASSERT `2012, c. 19, s. 262: the repealed provisions of the Canada Pension Plan and the Old Age Security Act, and their related regulations, continue to apply to the appeal` TRUE
#ASSERT NOT (`2012, c. 19, s. 262: the repealed provisions of the Canada Pension Plan and the Old Age Security Act, and their related regulations, continue to apply to the appeal` FALSE)

§ `2021, c. 23, s 275`

-- Born June 30, 1947: 75 on June 30, 2022, the day named. Born July 1, 1947: 74 on that day.
#ASSERT `2021, c. 23, s. 275: the amount of the one-time payment to the pensioner that may be paid out of the Consolidated Revenue Fund` TRUE (YMD 1947 6 30) EQUALS JUST 500
#ASSERT `2021, c. 23, s. 275: the amount of the one-time payment to the pensioner that may be paid out of the Consolidated Revenue Fund` TRUE (YMD 1947 7 1) EQUALS NOTHING
#ASSERT `2021, c. 23, s. 275: the amount of the one-time payment to the pensioner that may be paid out of the Consolidated Revenue Fund` TRUE (YMD 1930 1 1) EQUALS JUST 500
#ASSERT `2021, c. 23, s. 275: the amount of the one-time payment to the pensioner that may be paid out of the Consolidated Revenue Fund` FALSE (YMD 1930 1 1) EQUALS NOTHING
