IMPORT prelude
IMPORT daydate
IMPORT `oas-core`
IMPORT `oas-core-measures`
IMPORT `oa1-part4-administration`

-- Tests of oa1-part4-administration. Every expected value is worked by hand from the text.

§ `s 38: oaths and affidavits`

#ASSERT `s 38(1): the person has all the powers of a commissioner for taking affidavits with respect to the oath, affidavit, declaration or affirmation` TRUE TRUE FALSE
#ASSERT NOT (`s 38(1): the person has all the powers of a commissioner for taking affidavits with respect to the oath, affidavit, declaration or affirmation` FALSE TRUE FALSE)
#ASSERT NOT (`s 38(1): the person has all the powers of a commissioner for taking affidavits with respect to the oath, affidavit, declaration or affirmation` TRUE FALSE FALSE)
#ASSERT NOT (`s 38(1): the person has all the powers of a commissioner for taking affidavits with respect to the oath, affidavit, declaration or affirmation` TRUE TRUE TRUE)
#ASSERT `s 38(2): the Minister may accept the oath, affidavit, declaration or solemn affirmation` TRUE TRUE TRUE
#ASSERT NOT (`s 38(2): the Minister may accept the oath, affidavit, declaration or solemn affirmation` FALSE TRUE TRUE)
#ASSERT NOT (`s 38(2): the Minister may accept the oath, affidavit, declaration or solemn affirmation` TRUE FALSE TRUE)
#ASSERT NOT (`s 38(2): the Minister may accept the oath, affidavit, declaration or solemn affirmation` TRUE TRUE FALSE)

§ `s 39: provincial benefits`

#ASSERT `s 39(1): the Minister may enter into an agreement with the government of the province` TRUE TRUE
#ASSERT NOT (`s 39(1): the Minister may enter into an agreement with the government of the province` TRUE FALSE)
#ASSERT NOT (`s 39(1): the Minister may enter into an agreement with the government of the province` FALSE TRUE)
#ASSERT `s 39(1.1): the Minister may administer the provincial benefits on behalf of the government of the province` TRUE TRUE
#ASSERT NOT (`s 39(1.1): the Minister may administer the provincial benefits on behalf of the government of the province` FALSE TRUE)
#ASSERT NOT (`s 39(1.1): the Minister may administer the provincial benefits on behalf of the government of the province` TRUE FALSE)
#ASSERT `s 39(2): the agreement has the term the Act requires` TRUE
#ASSERT NOT (`s 39(2): the agreement has the term the Act requires` FALSE)

§ `s 40: reciprocal arrangements`

#ASSERT `s 40(1): the Minister may enter into an agreement with the government of the country` TRUE TRUE
#ASSERT NOT (`s 40(1): the Minister may enter into an agreement with the government of the country` TRUE FALSE)
#ASSERT NOT (`s 40(1): the Minister may enter into an agreement with the government of the country` FALSE TRUE)
#ASSERT `s 40(1): the agreement may make reciprocal arrangements on the matter` (JUST `s 40(1)(a): the exchange of information`) FALSE
#ASSERT `s 40(1): the agreement may make reciprocal arrangements on the matter` (JUST `s 40(1)(d): the totalization of periods of residence and contribution`) FALSE
#ASSERT `s 40(1): the agreement may make reciprocal arrangements on the matter` NOTHING TRUE
#ASSERT NOT (`s 40(1): the agreement may make reciprocal arrangements on the matter` NOTHING FALSE)

§ `s 41: coming into force of agreements`

-- The order comes into force March 1, 2027; the agreement ceases to be in force March 1, 2032.
#ASSERT `s 41(1): the agreement has the force of law in Canada on the day` (YMD 2027 3 1) (JUST (YMD 2032 3 1)) (YMD 2027 3 1)
#ASSERT `s 41(1): the agreement has the force of law in Canada on the day` (YMD 2027 3 1) (JUST (YMD 2032 3 1)) (YMD 2032 2 29)
#ASSERT NOT (`s 41(1): the agreement has the force of law in Canada on the day` (YMD 2027 3 1) (JUST (YMD 2032 3 1)) (YMD 2027 2 28))
#ASSERT NOT (`s 41(1): the agreement has the force of law in Canada on the day` (YMD 2027 3 1) (JUST (YMD 2032 3 1)) (YMD 2032 3 1))
#ASSERT `s 41(1): the agreement has the force of law in Canada on the day` (YMD 2027 3 1) NOTHING (YMD 2099 1 1)
#ASSERT `s 41(2): the notice has been given as the Act requires` TRUE
#ASSERT NOT (`s 41(2): the notice has been given as the Act requires` FALSE)

§ `s 42: the tabling and the motion to revoke`

-- Laid on the 15th sitting day is within the first 15; the 16th is not.
#ASSERT `s 42(1): the order has been laid before the House in time` 1
#ASSERT `s 42(1): the order has been laid before the House in time` 15
#ASSERT NOT (`s 42(1): the order has been laid before the House in time` 16)
-- A motion signed by 50 members of the Commons or 20 of the Senate stops the order coming into force on the thirtieth sitting day; 49 and 19 do not.
#ASSERT `s 42(2): the order comes into force on the thirtieth sitting day after it has been laid before Parliament` 0 0
#ASSERT `s 42(2): the order comes into force on the thirtieth sitting day after it has been laid before Parliament` 49 19
#ASSERT NOT (`s 42(2): the order comes into force on the thirtieth sitting day after it has been laid before Parliament` 50 0)
#ASSERT NOT (`s 42(2): the order comes into force on the thirtieth sitting day after it has been laid before Parliament` 0 20)
-- (7) and (8): both Houses revoke; any failure brings the order into force at once.
#ASSERT `s 42(7): the order stands revoked` TRUE TRUE
#ASSERT NOT (`s 42(7): the order stands revoked` TRUE FALSE)
#ASSERT NOT (`s 42(7): the order stands revoked` FALSE TRUE)
#ASSERT `s 42(8): the order comes into force immediately on the failure to adopt the motion or concur in it` FALSE FALSE
#ASSERT `s 42(8): the order comes into force immediately on the failure to adopt the motion or concur in it` TRUE FALSE
#ASSERT NOT (`s 42(8): the order comes into force immediately on the failure to adopt the motion or concur in it` TRUE TRUE)
-- (9): a day either House sits.
#ASSERT `s 42(9): the day is a sitting day for the purposes of subsection 42(2)` TRUE FALSE
#ASSERT `s 42(9): the day is a sitting day for the purposes of subsection 42(2)` FALSE TRUE
#ASSERT NOT (`s 42(9): the day is a sitting day for the purposes of subsection 42(2)` FALSE FALSE)

§ `s 43: negative resolution`

#ASSERT `s 43: section 42 is thereupon repealed` TRUE
#ASSERT NOT (`s 43: section 42 is thereupon repealed` FALSE)
#ASSERT `s 43: the order is an order made subject to negative resolution of Parliament within the meaning of section 39 of the Interpretation Act` TRUE TRUE
#ASSERT NOT (`s 43: the order is an order made subject to negative resolution of Parliament within the meaning of section 39 of the Interpretation Act` TRUE FALSE)
#ASSERT NOT (`s 43: the order is an order made subject to negative resolution of Parliament within the meaning of section 39 of the Interpretation Act` FALSE TRUE)

§ `ss 45, 46 and 47`

#ASSERT `s 45: the fund out of which all benefits payable under this Act shall be paid` EQUALS "the Consolidated Revenue Fund"
#ASSERT `s 46: the one who administers this Act` EQUALS Minister
-- A fiscal year ending March 31, 2027: in session that day, the report is due as soon as possible from that day; not in session, from the first day of the next session (October 5, 2027).
#ASSERT `s 47: the day from which the Minister is to submit the report as soon as possible` (YMD 2027 3 31) TRUE (YMD 2027 10 5) EQUALS (YMD 2027 3 31)
#ASSERT `s 47: the day from which the Minister is to submit the report as soon as possible` (YMD 2027 3 31) FALSE (YMD 2027 10 5) EQUALS (YMD 2027 10 5)
#ASSERT `s 47: the report is what the Act requires` TRUE TRUE
#ASSERT NOT (`s 47: the report is what the Act requires` TRUE FALSE)
#ASSERT NOT (`s 47: the report is what the Act requires` FALSE TRUE)
