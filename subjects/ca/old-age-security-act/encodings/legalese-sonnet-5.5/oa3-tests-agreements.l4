IMPORT prelude
IMPORT daydate
IMPORT `oas-core`
IMPORT `oas-core-measures`
IMPORT `oa3-part1-agreements`

-- Tests of oa3-part1-agreements.l4 (regs 22.01 and 22.1 and the Schedule). Every expected value is worked out by hand from the words of
-- the regulation and from the printed Schedule.

-- The Schedule has one row for each of the 44 countries printed in it (Guernsey and Jersey each have a row of their own).
#ASSERT count `reg 22.01: the Schedule` EQUALS 44

-- Reg 22.01: a country is looked up by its name as printed.
#ASSERT `reg 22.01: the agreement with the country is one referred to in the Schedule` "Antigua and Barbuda"
#ASSERT `reg 22.01: the agreement with the country is one referred to in the Schedule` "Uruguay (Eastern Republic of)"
#ASSERT `reg 22.01: the agreement with the country is one referred to in the Schedule` "Austria (Republic of)"
#ASSERT `reg 22.01: the agreement with the country is one referred to in the Schedule` "United Kingdom of Great Britain and Northern Ireland"
#ASSERT `reg 22.01: the agreement with the country is one referred to in the Schedule` "United States of America"
#ASSERT `reg 22.01: the agreement with the country is one referred to in the Schedule` "Guernsey"
#ASSERT `reg 22.01: the agreement with the country is one referred to in the Schedule` "Jersey"
-- Canada has no agreement with itself; a country not in the Schedule; a country named otherwise than as printed ("Uruguay" for
-- "Uruguay (Eastern Republic of)", lower case); the empty name.
#ASSERT NOT (`reg 22.01: the agreement with the country is one referred to in the Schedule` "Canada")
#ASSERT NOT (`reg 22.01: the agreement with the country is one referred to in the Schedule` "Japan")
#ASSERT NOT (`reg 22.01: the agreement with the country is one referred to in the Schedule` "Uruguay")
#ASSERT NOT (`reg 22.01: the agreement with the country is one referred to in the Schedule` "austria (republic of)")
#ASSERT NOT (`reg 22.01: the agreement with the country is one referred to in the Schedule` "")
#ASSERT `reg 22.01: the treatment afforded to spouses is extended to common-law partners under the agreement with the country` "Barbados"
#ASSERT NOT (`reg 22.01: the treatment afforded to spouses is extended to common-law partners under the agreement with the country` "Brazil")

-- The agreements printed for a country: one row, kept as printed (Barbados); no row for a country not in the Schedule.
#ASSERT `reg 22.01: the agreements of the Schedule with the country, as printed` "Barbados" EQUALS LIST "Agreement on Social Security between the Government of Canada and the Government of Barbados, signed at Bridgetown on February 11, 1985"
#ASSERT `reg 22.01: the agreements of the Schedule with the country, as printed` "New Zealand" EQUALS LIST "Agreement on Social Security between Canada and New Zealand, signed on April 9, 1996"
#ASSERT `reg 22.01: the agreements of the Schedule with the country, as printed` "Japan" EQUALS EMPTY
-- A row that lists several instruments is still one row.
#ASSERT count (`reg 22.01: the agreements of the Schedule with the country, as printed` "United States of America") EQUALS 1

-- ---------------------------------------------------------------------------------------------
-- Reg 22.1(1): the events (a) death, (b) conviction, (c) bankruptcy, (d) a sentence of MORE than six months.
#ASSERT `reg 22.1(1): the events that have occurred in relation to the sponsor` TRUE TRUE TRUE (JUST 7) EQUALS LIST `reg 22.1(1)(a): the death of the sponsor`, `reg 22.1(1)(b): the sponsor's conviction of an offence under the Criminal Code relating to the sponsored individual`, `reg 22.1(1)(c): a determination that the sponsor is a bankrupt as defined in section 2 of the Bankruptcy and Insolvency Act`, `reg 22.1(1)(d): the sentencing of the sponsor to a term of imprisonment of more than six months`
#ASSERT `reg 22.1(1): the events that have occurred in relation to the sponsor` FALSE FALSE FALSE NOTHING EQUALS EMPTY
-- Exactly six months is not more than six months; six months and a little more is.
#ASSERT `reg 22.1(1): the events that have occurred in relation to the sponsor` FALSE FALSE FALSE (JUST 6) EQUALS EMPTY
#ASSERT `reg 22.1(1): the events that have occurred in relation to the sponsor` FALSE FALSE FALSE (JUST 6.01) EQUALS LIST `reg 22.1(1)(d): the sentencing of the sponsor to a term of imprisonment of more than six months`
#ASSERT `reg 22.1(1): the events that have occurred in relation to the sponsor` FALSE FALSE FALSE (JUST 12) EQUALS LIST `reg 22.1(1)(d): the sentencing of the sponsor to a term of imprisonment of more than six months`
#ASSERT `reg 22.1(1): the events that have occurred in relation to the sponsor` FALSE FALSE FALSE (JUST 0) EQUALS EMPTY
-- Each of (a), (b) and (c) on its own.
#ASSERT `reg 22.1(1): the events that have occurred in relation to the sponsor` TRUE FALSE FALSE NOTHING EQUALS LIST `reg 22.1(1)(a): the death of the sponsor`
#ASSERT `reg 22.1(1): the events that have occurred in relation to the sponsor` FALSE TRUE FALSE NOTHING EQUALS LIST `reg 22.1(1)(b): the sponsor's conviction of an offence under the Criminal Code relating to the sponsored individual`
#ASSERT `reg 22.1(1): the events that have occurred in relation to the sponsor` FALSE FALSE TRUE NOTHING EQUALS LIST `reg 22.1(1)(c): a determination that the sponsor is a bankrupt as defined in section 2 of the Bankruptcy and Insolvency Act`
-- (b) and (d) together.
#ASSERT `reg 22.1(1): the events that have occurred in relation to the sponsor` FALSE TRUE FALSE (JUST 24) EQUALS LIST `reg 22.1(1)(b): the sponsor's conviction of an offence under the Criminal Code relating to the sponsored individual`, `reg 22.1(1)(d): the sentencing of the sponsor to a term of imprisonment of more than six months`

-- Reg 22.1(2): (a) the undertaking was in effect on or after 7 March 1996, and (b) an event occurred on or after that day.
-- An undertaking still in effect (NOTHING), an event exactly on 1996-03-07: both limbs hold.
#ASSERT `reg 22.1(2): subsection (1) applies to the sponsor` NOTHING (LIST (YearMonthDay 1996 3 7))
-- An event the day before: limb (b) fails.
#ASSERT NOT (`reg 22.1(2): subsection (1) applies to the sponsor` NOTHING (LIST (YearMonthDay 1996 3 6)))
-- An undertaking that ended on 1996-03-07 was in effect on that day; one that ended the day before was not, whatever happened later.
#ASSERT `reg 22.1(2): subsection (1) applies to the sponsor` (JUST (YearMonthDay 1996 3 7)) (LIST (YearMonthDay 2000 1 1))
#ASSERT NOT (`reg 22.1(2): subsection (1) applies to the sponsor` (JUST (YearMonthDay 1996 3 6)) (LIST (YearMonthDay 2000 1 1)))
-- No event at all: limb (b) fails.
#ASSERT NOT (`reg 22.1(2): subsection (1) applies to the sponsor` NOTHING EMPTY)
-- Several events, one of them on or after the day: enough.
#ASSERT `reg 22.1(2): subsection (1) applies to the sponsor` NOTHING (LIST (YearMonthDay 1990 1 1), (YearMonthDay 2000 5 5))
-- Several events, all before the day: not enough.
#ASSERT NOT (`reg 22.1(2): subsection (1) applies to the sponsor` NOTHING (LIST (YearMonthDay 1990 1 1), (YearMonthDay 1996 3 6)))
