IMPORT prelude
IMPORT daydate
IMPORT `oas-core`
IMPORT `oa1-part4-information`

-- Tests of oa1-part4-information. Every expected value follows from the text of ss 33, 33.1, 35 and 35.1.

§ `s 33(1): definitions`

#ASSERT `s 33(1): the activity is administration` TRUE FALSE
#ASSERT `s 33(1): the activity is administration` FALSE TRUE
#ASSERT NOT (`s 33(1): the activity is administration` FALSE FALSE)
#ASSERT `s 33(1): the body is a federal institution` TRUE
#ASSERT NOT (`s 33(1): the body is a federal institution` FALSE)
#ASSERT `s 33(1): the individual is a public officer` TRUE FALSE
#ASSERT `s 33(1): the individual is a public officer` FALSE TRUE
#ASSERT NOT (`s 33(1): the individual is a public officer` FALSE FALSE)

§ `s 33.1: information obtained under other Acts`

-- Each of the four conditions of a paragraph is needed.
#ASSERT `s 33.1(a): the report may be made available` TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 33.1(a): the report may be made available` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`s 33.1(a): the report may be made available` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 33.1(a): the report may be made available` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 33.1(a): the report may be made available` TRUE TRUE TRUE FALSE)
#ASSERT `s 33.1(b): the information may be made available` TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 33.1(b): the information may be made available` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`s 33.1(b): the information may be made available` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 33.1(b): the information may be made available` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 33.1(b): the information may be made available` TRUE TRUE TRUE FALSE)
#ASSERT `s 33.1(c): the personal information may be made available` TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 33.1(c): the personal information may be made available` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`s 33.1(c): the personal information may be made available` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 33.1(c): the personal information may be made available` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 33.1(c): the personal information may be made available` TRUE TRUE TRUE FALSE)

§ `s 35: form of documents`

-- Where the Minister requires no form, any form will do. Where one is required, the document must be in it.
#ASSERT `s 35: the application, statement or notification is made or given as required` FALSE FALSE
#ASSERT `s 35: the application, statement or notification is made or given as required` TRUE TRUE
#ASSERT NOT (`s 35: the application, statement or notification is made or given as required` TRUE FALSE)

§ `s 35.1: attendance in person`

#ASSERT `s 35.1: the person is required to be at the place at the time` TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 35.1: the person is required to be at the place at the time` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`s 35.1: the person is required to be at the place at the time` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 35.1: the person is required to be at the place at the time` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 35.1: the person is required to be at the place at the time` TRUE TRUE TRUE FALSE)
