IMPORT prelude
IMPORT daydate
IMPORT `oas-core`
IMPORT `oas-core-measures`
IMPORT `oa3-helpers`
IMPORT `oa3-part2-interest`

-- Tests of oa3-part2-interest.l4 (regulation 48). Every expected value is worked out by hand from the words of the regulation: the
-- days of interest are counted on a calendar, and each money figure is a fraction worked out on paper (as 725 x 31 / 365).
-- The readings the Regulations leave open (fork F-48 in NOTES.md) are marked where a test depends on one: "ceases on" is the last
-- accruing day, the due date itself accrues, and the daily rate divides by the days of the calendar year.

-- A record of the facts about a debt, built by a rule because the encoding has no record update.
GIVEN payable IS A BOOLEAN
      due IS A DATE
      pending IS A LIST OF `Calendar span`
      ceases IS A MAYBE DATE
GIVETH A `reg 48: Facts about the accrual of interest on a debt`
`oa3test: facts` payable due pending ceases MEANS
    `reg 48: Facts about the accrual of interest on a debt` WITH
        `interest is payable on the debt` IS payable
        `the due date of the debt or portion of the debt` IS due
        `the periods during which a proceeding is pending in respect of the debt` IS pending
        `the day on which the accrual of interest ceases` IS ceases

GIVEN a IS A DATE
      b IS A DATE
GIVETH A `Calendar span`
`oa3test: span` a b MEANS
    `Calendar span` WITH `first day` IS a, `last day` IS b

-- ---------------------------------------------------------------------------------------------
-- Does interest accrue on a given day? (arguments: the facts, the day)
-- Payable, due 2021-01-10, pending 2021-01-20 to 2021-01-22, ceasing 2021-01-31.
#ASSERT NOT (`reg 48: interest accrues on the debt on the day` (`oa3test: facts` TRUE (YMD 2021 1 10) (LIST (`oa3test: span` (YMD 2021 1 20) (YMD 2021 1 22))) (JUST (YMD 2021 1 31))) (YMD 2021 1 9))
#ASSERT `reg 48: interest accrues on the debt on the day` (`oa3test: facts` TRUE (YMD 2021 1 10) (LIST (`oa3test: span` (YMD 2021 1 20) (YMD 2021 1 22))) (JUST (YMD 2021 1 31))) (YMD 2021 1 10)
#ASSERT `reg 48: interest accrues on the debt on the day` (`oa3test: facts` TRUE (YMD 2021 1 10) (LIST (`oa3test: span` (YMD 2021 1 20) (YMD 2021 1 22))) (JUST (YMD 2021 1 31))) (YMD 2021 1 19)
#ASSERT NOT (`reg 48: interest accrues on the debt on the day` (`oa3test: facts` TRUE (YMD 2021 1 10) (LIST (`oa3test: span` (YMD 2021 1 20) (YMD 2021 1 22))) (JUST (YMD 2021 1 31))) (YMD 2021 1 20))
#ASSERT NOT (`reg 48: interest accrues on the debt on the day` (`oa3test: facts` TRUE (YMD 2021 1 10) (LIST (`oa3test: span` (YMD 2021 1 20) (YMD 2021 1 22))) (JUST (YMD 2021 1 31))) (YMD 2021 1 22))
#ASSERT `reg 48: interest accrues on the debt on the day` (`oa3test: facts` TRUE (YMD 2021 1 10) (LIST (`oa3test: span` (YMD 2021 1 20) (YMD 2021 1 22))) (JUST (YMD 2021 1 31))) (YMD 2021 1 23)
#ASSERT `reg 48: interest accrues on the debt on the day` (`oa3test: facts` TRUE (YMD 2021 1 10) (LIST (`oa3test: span` (YMD 2021 1 20) (YMD 2021 1 22))) (JUST (YMD 2021 1 31))) (YMD 2021 1 31)
#ASSERT NOT (`reg 48: interest accrues on the debt on the day` (`oa3test: facts` TRUE (YMD 2021 1 10) (LIST (`oa3test: span` (YMD 2021 1 20) (YMD 2021 1 22))) (JUST (YMD 2021 1 31))) (YMD 2021 2 1))
#ASSERT NOT (`reg 48: interest accrues on the debt on the day` (`oa3test: facts` FALSE (YMD 2021 1 10) EMPTY NOTHING) (YMD 2021 1 15))

-- The accruing days of a month (arguments: the facts, any day of the month).
-- due on the first of the month: all 31 days of January 2021.
#ASSERT `reg 48: the number of days of the month on which interest accrues on the debt` (`oa3test: facts` TRUE (YMD 2021 1 1) EMPTY NOTHING) (YMD 2021 1 17) EQUALS 31
-- due 2021-01-11 (the due date itself accrues): 11th to 31st, 21 days.
#ASSERT `reg 48: the number of days of the month on which interest accrues on the debt` (`oa3test: facts` TRUE (YMD 2021 1 11) EMPTY NOTHING) (YMD 2021 1 17) EQUALS 21
-- due on the last day: 1 day.
#ASSERT `reg 48: the number of days of the month on which interest accrues on the debt` (`oa3test: facts` TRUE (YMD 2021 1 31) EMPTY NOTHING) (YMD 2021 1 17) EQUALS 1
-- due the first of the next month: none in January.
#ASSERT `reg 48: the number of days of the month on which interest accrues on the debt` (`oa3test: facts` TRUE (YMD 2021 2 1) EMPTY NOTHING) (YMD 2021 1 17) EQUALS 0
-- due long before: all 31 days.
#ASSERT `reg 48: the number of days of the month on which interest accrues on the debt` (`oa3test: facts` TRUE (YMD 2020 6 1) EMPTY NOTHING) (YMD 2021 1 17) EQUALS 31
-- pending 2021-01-15 to 2021-01-20 (6 days, both ends): 25 days.
#ASSERT `reg 48: the number of days of the month on which interest accrues on the debt` (`oa3test: facts` TRUE (YMD 2021 1 1) (LIST (`oa3test: span` (YMD 2021 1 15) (YMD 2021 1 20))) NOTHING) (YMD 2021 1 17) EQUALS 25
-- two pending periods, 2021-01-05 to 06 and 2021-01-30 to 31: 27 days.
#ASSERT `reg 48: the number of days of the month on which interest accrues on the debt` (`oa3test: facts` TRUE (YMD 2021 1 1) (LIST (`oa3test: span` (YMD 2021 1 5) (YMD 2021 1 6)), (`oa3test: span` (YMD 2021 1 30) (YMD 2021 1 31))) NOTHING) (YMD 2021 1 17) EQUALS 27
-- a pending period running on from the month's last day: 30 days.
#ASSERT `reg 48: the number of days of the month on which interest accrues on the debt` (`oa3test: facts` TRUE (YMD 2021 1 1) (LIST (`oa3test: span` (YMD 2021 1 31) (YMD 2021 2 10))) NOTHING) (YMD 2021 1 17) EQUALS 30
-- a pending period running up to the first of the month: 30 days.
#ASSERT `reg 48: the number of days of the month on which interest accrues on the debt` (`oa3test: facts` TRUE (YMD 2021 1 1) (LIST (`oa3test: span` (YMD 2020 12 1) (YMD 2021 1 1))) NOTHING) (YMD 2021 1 17) EQUALS 30
-- a pending period covering the month: none.
#ASSERT `reg 48: the number of days of the month on which interest accrues on the debt` (`oa3test: facts` TRUE (YMD 2021 1 1) (LIST (`oa3test: span` (YMD 2020 12 15) (YMD 2021 2 15))) NOTHING) (YMD 2021 1 17) EQUALS 0
-- ceasing 2021-01-10, the last accruing day: 10 days.
#ASSERT `reg 48: the number of days of the month on which interest accrues on the debt` (`oa3test: facts` TRUE (YMD 2021 1 1) EMPTY (JUST (YMD 2021 1 10))) (YMD 2021 1 17) EQUALS 10
-- ceasing on the last day of the month: 31 days.
#ASSERT `reg 48: the number of days of the month on which interest accrues on the debt` (`oa3test: facts` TRUE (YMD 2021 1 1) EMPTY (JUST (YMD 2021 1 31))) (YMD 2021 1 17) EQUALS 31
-- ceasing the day before the month: none.
#ASSERT `reg 48: the number of days of the month on which interest accrues on the debt` (`oa3test: facts` TRUE (YMD 2021 1 1) EMPTY (JUST (YMD 2020 12 31))) (YMD 2021 1 17) EQUALS 0
-- ceasing on the due date: 1 day.
#ASSERT `reg 48: the number of days of the month on which interest accrues on the debt` (`oa3test: facts` TRUE (YMD 2021 1 1) EMPTY (JUST (YMD 2021 1 1))) (YMD 2021 1 17) EQUALS 1
-- ceasing before the due date: none.
#ASSERT `reg 48: the number of days of the month on which interest accrues on the debt` (`oa3test: facts` TRUE (YMD 2021 1 10) EMPTY (JUST (YMD 2021 1 5))) (YMD 2021 1 17) EQUALS 0
-- interest not payable: none.
#ASSERT `reg 48: the number of days of the month on which interest accrues on the debt` (`oa3test: facts` FALSE (YMD 2021 1 1) EMPTY NOTHING) (YMD 2021 1 17) EQUALS 0
-- February 2020 (a leap year): 29 days.
#ASSERT `reg 48: the number of days of the month on which interest accrues on the debt` (`oa3test: facts` TRUE (YMD 2020 2 1) EMPTY NOTHING) (YMD 2020 2 10) EQUALS 29
-- February 2021: 28 days.
#ASSERT `reg 48: the number of days of the month on which interest accrues on the debt` (`oa3test: facts` TRUE (YMD 2021 2 1) EMPTY NOTHING) (YMD 2021 2 28) EQUALS 28

-- 48(4): the rate is the average bank rate plus 3 per cent a year; the average is the simple mean of the rates of the month before.
#ASSERT `reg 48(1): the average bank rate` (LIST 4, 5) EQUALS JUST 4.5
#ASSERT `reg 48(1): the average bank rate` (LIST 3) EQUALS JUST 3
#ASSERT `reg 48(1): the average bank rate` (LIST 1.25, 1.5, 1.75) EQUALS JUST 1.5
#ASSERT `reg 48(1): the average bank rate` (LIST 0, 1) EQUALS JUST 0.5
#ASSERT `reg 48(1): the average bank rate` EMPTY EQUALS NOTHING
#ASSERT `reg 48(4): the rate of interest for the month, in per cent a year` (LIST 4, 4.5) EQUALS JUST 7.25
#ASSERT `reg 48(4): the rate of interest for the month, in per cent a year` (LIST 0) EQUALS JUST 3
#ASSERT `reg 48(4): the rate of interest for the month, in per cent a year` (LIST 1.25, 1.5, 1.75) EQUALS JUST 4.5
#ASSERT `reg 48(4): the rate of interest for the month, in per cent a year` EMPTY EQUALS NOTHING

-- The interest of a month: 10000 at 7.25% a year, for the accruing days over the days of the year.
-- All 31 days of January 2021 (365-day year): 10000 x 0.0725 x 31 / 365 = 725 x 31 / 365 = 22475 / 365.
#ASSERT `reg 48(4): the interest accrued on the debt in the month` 10000 7.25 (`oa3test: facts` TRUE (YMD 2021 1 1) EMPTY NOTHING) (YMD 2021 1 17) EQUALS 22475 DIVIDED BY 365
-- 21 days (due 2021-01-11): 725 x 21 / 365 = 15225 / 365.
#ASSERT `reg 48(4): the interest accrued on the debt in the month` 10000 7.25 (`oa3test: facts` TRUE (YMD 2021 1 11) EMPTY NOTHING) (YMD 2021 1 17) EQUALS 15225 DIVIDED BY 365
-- February 2020: 29 days of a 366-day year: 725 x 29 / 366 = 21025 / 366.
#ASSERT `reg 48(4): the interest accrued on the debt in the month` 10000 7.25 (`oa3test: facts` TRUE (YMD 2020 2 1) EMPTY NOTHING) (YMD 2020 2 10) EQUALS 21025 DIVIDED BY 366
-- February 2021: 28 days of a 365-day year: 725 x 28 / 365 = 20300 / 365.
#ASSERT `reg 48(4): the interest accrued on the debt in the month` 10000 7.25 (`oa3test: facts` TRUE (YMD 2021 2 1) EMPTY NOTHING) (YMD 2021 2 10) EQUALS 20300 DIVIDED BY 365
-- A different principal and rate: 2400 at 5% for 30 days (April 2021) of 365: 2400 x 0.05 x 30 / 365 = 3600 / 365.
#ASSERT `reg 48(4): the interest accrued on the debt in the month` 2400 5 (`oa3test: facts` TRUE (YMD 2021 4 1) EMPTY NOTHING) (YMD 2021 4 15) EQUALS 3600 DIVIDED BY 365
-- No accruing day, or nothing owing: no interest.
#ASSERT `reg 48(4): the interest accrued on the debt in the month` 10000 7.25 (`oa3test: facts` FALSE (YMD 2021 1 1) EMPTY NOTHING) (YMD 2021 1 17) EQUALS 0
#ASSERT `reg 48(4): the interest accrued on the debt in the month` 0 7.25 (`oa3test: facts` TRUE (YMD 2021 1 1) EMPTY NOTHING) (YMD 2021 1 17) EQUALS 0
-- Compounded at the end of the month: the interest is added to the debt. 10000 + 22475 / 365.
#ASSERT `reg 48(4): the amount of the debt at the end of the month, with the interest of the month compounded` 10000 7.25 (`oa3test: facts` TRUE (YMD 2021 1 1) EMPTY NOTHING) (YMD 2021 1 17) EQUALS 10000 PLUS (22475 DIVIDED BY 365)
-- The next month's interest runs on the compounded sum: (10000 + 22475/365) x 0.0725 x 28 / 365.
#ASSERT `reg 48(4): the interest accrued on the debt in the month` (10000 PLUS (22475 DIVIDED BY 365)) 7.25 (`oa3test: facts` TRUE (YMD 2021 1 1) EMPTY NOTHING) (YMD 2021 2 10) EQUALS (10000 PLUS (22475 DIVIDED BY 365)) TIMES 0.0725 TIMES (28 DIVIDED BY 365)

-- 48(1) due date: scheduled days when a schedule has been established; otherwise 120 days after the demand for payment was issued.
#ASSERT `reg 48(1): the due dates of the debt` TRUE (LIST (YMD 2021 2 1), (YMD 2021 3 1)) NOTHING EQUALS LIST YMD 2021 2 1, YMD 2021 3 1
#ASSERT `reg 48(1): the due dates of the debt` TRUE EMPTY NOTHING EQUALS EMPTY
-- No schedule: 2021-01-01 + 120 days is 2021-05-01 (31 + 28 + 31 + 30); in 2020 it is 2020-04-30 (31 + 29 + 31 + 29).
#ASSERT `reg 48(1): the due dates of the debt` FALSE EMPTY (JUST (YMD 2021 1 1)) EQUALS LIST YMD 2021 5 1
#ASSERT `reg 48(1): the due dates of the debt` FALSE EMPTY (JUST (YMD 2020 1 1)) EQUALS LIST YMD 2020 4 30
#ASSERT `reg 48(1): the due dates of the debt` FALSE EMPTY NOTHING EQUALS EMPTY
-- The scheduled days win when there is a schedule, even if a demand was issued.
#ASSERT `reg 48(1): the due dates of the debt` TRUE (LIST (YMD 2021 2 1)) (JUST (YMD 2021 1 1)) EQUALS LIST YMD 2021 2 1

-- 48(2): payable on a debt recoverable on or after the day the section comes into force (arguments: is a debt, last day recoverable, commencement day).
#ASSERT `reg 48(2): interest is payable on the debt` TRUE (JUST (YMD 2020 6 1)) (YMD 2020 6 1)
#ASSERT NOT (`reg 48(2): interest is payable on the debt` TRUE (JUST (YMD 2020 5 31)) (YMD 2020 6 1))
#ASSERT `reg 48(2): interest is payable on the debt` TRUE (JUST (YMD 2020 6 2)) (YMD 2020 6 1)
#ASSERT `reg 48(2): interest is payable on the debt` TRUE NOTHING (YMD 2020 6 1)
#ASSERT NOT (`reg 48(2): interest is payable on the debt` FALSE NOTHING (YMD 2020 6 1))
#ASSERT NOT (`reg 48(2): interest is payable on the debt` FALSE (JUST (YMD 2021 1 1)) (YMD 2020 6 1))

-- 48(3): the accrual begins on the due date.
#ASSERT `reg 48(3): the first day on which interest accrues` (YMD 2021 5 1) EQUALS YMD 2021 5 1

-- 48(1) debt: (a) a 37(2) debt on which a 44.1 penalty was imposed, or (b) a 37(2.02) debt. Arguments: 37(2) debt, penalty imposed, 37(2.02) debt.
#ASSERT `reg 48(1): the amount is a debt` TRUE TRUE FALSE
#ASSERT NOT (`reg 48(1): the amount is a debt` TRUE FALSE FALSE)
#ASSERT NOT (`reg 48(1): the amount is a debt` FALSE TRUE FALSE)
#ASSERT `reg 48(1): the amount is a debt` FALSE FALSE TRUE
#ASSERT `reg 48(1): the amount is a debt` TRUE TRUE TRUE
#ASSERT NOT (`reg 48(1): the amount is a debt` FALSE FALSE FALSE)

-- 48(1) demand for payment: a written demand, and includes a notification of a penalty decision or of its amount.
#ASSERT `reg 48(1): the document is a demand for payment` TRUE FALSE FALSE
#ASSERT `reg 48(1): the document is a demand for payment` FALSE TRUE FALSE
#ASSERT `reg 48(1): the document is a demand for payment` FALSE FALSE TRUE
#ASSERT NOT (`reg 48(1): the document is a demand for payment` FALSE FALSE FALSE)

#ASSERT `reg 48(1): the rate is a bank rate` TRUE
#ASSERT NOT (`reg 48(1): the rate is a bank rate` FALSE)

-- 48(7): all four conditions.
#ASSERT `reg 48(7): the Minister may remit the interest payable under this section in whole or in part` TRUE TRUE TRUE TRUE
#ASSERT NOT (`reg 48(7): the Minister may remit the interest payable under this section in whole or in part` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`reg 48(7): the Minister may remit the interest payable under this section in whole or in part` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`reg 48(7): the Minister may remit the interest payable under this section in whole or in part` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`reg 48(7): the Minister may remit the interest payable under this section in whole or in part` TRUE TRUE TRUE FALSE)

-- 48(6): the day on which the accrual ceases (arguments: (a) payment received, (b) remitted, (c)(i) penalty reduced, whether (c)(ii) applies,
-- the day of the Minister's decision (A), the day of the appeal or review decision (B), (d) interest remitted, (e) debtor dies).
-- Nothing has happened: the accrual does not cease.
#ASSERT `reg 48(6): the day on which the accrual of interest ceases` NOTHING NOTHING NOTHING FALSE NOTHING NOTHING NOTHING NOTHING EQUALS NOTHING
-- (a) the day before payment is received: payment on 2021-01-11 ends accrual on 2021-01-10; on 2021-01-01 it ends it on 2020-12-31.
#ASSERT `reg 48(6): the day on which the accrual of interest ceases` (JUST (YMD 2021 1 11)) NOTHING NOTHING FALSE NOTHING NOTHING NOTHING NOTHING EQUALS JUST (YMD 2021 1 10)
#ASSERT `reg 48(6): the day on which the accrual of interest ceases` (JUST (YMD 2021 1 1)) NOTHING NOTHING FALSE NOTHING NOTHING NOTHING NOTHING EQUALS JUST (YMD 2020 12 31)
-- (b) remitted: the day itself.
#ASSERT `reg 48(6): the day on which the accrual of interest ceases` NOTHING (JUST (YMD 2021 1 11)) NOTHING FALSE NOTHING NOTHING NOTHING NOTHING EQUALS JUST (YMD 2021 1 11)
-- (c)(i) reduced or rescinded under 44.1(4): the day itself.
#ASSERT `reg 48(6): the day on which the accrual of interest ceases` NOTHING NOTHING (JUST (YMD 2021 1 12)) FALSE NOTHING NOTHING NOTHING NOTHING EQUALS JUST (YMD 2021 1 12)
-- (c)(ii) the latest of the Minister's decision and the appeal or review decision, when the penalty was reduced or rescinded under it.
#ASSERT `reg 48(6): the day on which the accrual of interest ceases` NOTHING NOTHING NOTHING TRUE (JUST (YMD 2021 1 5)) (JUST (YMD 2021 1 20)) NOTHING NOTHING EQUALS JUST (YMD 2021 1 20)
#ASSERT `reg 48(6): the day on which the accrual of interest ceases` NOTHING NOTHING NOTHING TRUE (JUST (YMD 2021 1 25)) (JUST (YMD 2021 1 20)) NOTHING NOTHING EQUALS JUST (YMD 2021 1 25)
#ASSERT `reg 48(6): the day on which the accrual of interest ceases` NOTHING NOTHING NOTHING TRUE (JUST (YMD 2021 1 5)) NOTHING NOTHING NOTHING EQUALS JUST (YMD 2021 1 5)
#ASSERT `reg 48(6): the day on which the accrual of interest ceases` NOTHING NOTHING NOTHING TRUE NOTHING (JUST (YMD 2021 1 20)) NOTHING NOTHING EQUALS JUST (YMD 2021 1 20)
#ASSERT `reg 48(6): the day on which the accrual of interest ceases` NOTHING NOTHING NOTHING TRUE NOTHING NOTHING NOTHING NOTHING EQUALS NOTHING
-- Decisions on their own, without a reduction or rescission under them, end nothing.
#ASSERT `reg 48(6): the day on which the accrual of interest ceases` NOTHING NOTHING NOTHING FALSE (JUST (YMD 2021 1 5)) (JUST (YMD 2021 1 20)) NOTHING NOTHING EQUALS NOTHING
-- (d) interest remitted under (7), (e) the debtor dies: the day itself.
#ASSERT `reg 48(6): the day on which the accrual of interest ceases` NOTHING NOTHING NOTHING FALSE NOTHING NOTHING (JUST (YMD 2021 1 13)) NOTHING EQUALS JUST (YMD 2021 1 13)
#ASSERT `reg 48(6): the day on which the accrual of interest ceases` NOTHING NOTHING NOTHING FALSE NOTHING NOTHING NOTHING (JUST (YMD 2021 1 14)) EQUALS JUST (YMD 2021 1 14)
-- Several: the earliest governs. (a) 2021-01-11 gives 2021-01-10, before the death on 2021-01-14 and a remission on 2021-01-31.
#ASSERT `reg 48(6): the day on which the accrual of interest ceases` (JUST (YMD 2021 1 11)) (JUST (YMD 2021 1 31)) NOTHING FALSE NOTHING NOTHING NOTHING (JUST (YMD 2021 1 14)) EQUALS JUST (YMD 2021 1 10)
-- A remission on 2021-01-05 is earlier than the day before a payment on 2021-01-11 (2021-01-10).
#ASSERT `reg 48(6): the day on which the accrual of interest ceases` (JUST (YMD 2021 1 11)) (JUST (YMD 2021 1 5)) NOTHING FALSE NOTHING NOTHING NOTHING NOTHING EQUALS JUST (YMD 2021 1 5)
