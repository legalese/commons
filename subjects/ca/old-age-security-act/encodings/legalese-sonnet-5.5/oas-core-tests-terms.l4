IMPORT prelude
IMPORT daydate
IMPORT `oas-core`
IMPORT `oas-core-measures`
IMPORT `oas-core-terms`

-- Tests for s 2 "applicant", "beneficiary", "pensioner", "survivor", "common-law partner", "cheque",
-- "release", and the Part under which each benefit is authorized. Expected values are written from the
-- words of each definition.

-- applicant: applied, OR deemed to have applied, OR application waived
#ASSERT `the person is an applicant` TRUE FALSE FALSE
#ASSERT `the person is an applicant` FALSE TRUE FALSE
#ASSERT `the person is an applicant` FALSE FALSE TRUE
#ASSERT `the person is an applicant` TRUE TRUE TRUE
#ASSERT NOT (`the person is an applicant` FALSE FALSE FALSE)

-- beneficiary: payment of a benefit has been approved
#ASSERT `the person is a beneficiary` TRUE
#ASSERT NOT (`the person is a beneficiary` FALSE)

-- pensioner: the application for a pension has been approved
#ASSERT `the person is a pensioner` TRUE
#ASSERT NOT (`the person is a pensioner` FALSE)

-- survivor: spouse or common-law partner has died AND has not thereafter become the partner of another
#ASSERT `the person is a survivor` TRUE FALSE
#ASSERT NOT (`the person is a survivor` TRUE TRUE)
#ASSERT NOT (`the person is a survivor` FALSE FALSE)
#ASSERT NOT (`the person is a survivor` FALSE TRUE)

-- common-law partner: cohabiting at the relevant time AND a continuous period of at least one year
-- cohabiting, no individual has died: the relevant time is the day the question is asked
#ASSERT `the person is a common-law partner of the individual` TRUE (Date 15 3 2025) NOTHING (Date 15 3 2026)
#ASSERT NOT (`the person is a common-law partner of the individual` TRUE (Date 15 3 2025) NOTHING (Date 14 3 2026))
#ASSERT `the person is a common-law partner of the individual` TRUE (Date 1 1 2000) NOTHING (Date 22 10 2026)
#ASSERT NOT (`the person is a common-law partner of the individual` FALSE (Date 1 1 2000) NOTHING (Date 22 10 2026))
-- the individual has died: the relevant time is the day of death, whenever the question is asked
#ASSERT `the person is a common-law partner of the individual` TRUE (Date 10 1 2025) (JUST (Date 10 1 2026)) (Date 15 6 2026)
#ASSERT NOT (`the person is a common-law partner of the individual` TRUE (Date 11 1 2025) (JUST (Date 10 1 2026)) (Date 15 6 2026))
#ASSERT NOT (`the person is a common-law partner of the individual` TRUE (Date 1 6 2025) (JUST (Date 1 12 2025)) (Date 1 12 2030))
#ASSERT `the person is a common-law partner of the individual` TRUE (Date 1 6 2001) (JUST (Date 1 12 2025)) (Date 1 1 2026)
#ASSERT NOT (`the person is a common-law partner of the individual` FALSE (Date 1 6 2001) (JUST (Date 1 12 2025)) (Date 1 1 2026))
-- a period that began on 29 February 2024 (fork F6: add years clamps to 28 February)
#ASSERT `the person is a common-law partner of the individual` TRUE (Date 29 2 2024) NOTHING (Date 28 2 2025)
#ASSERT NOT (`the person is a common-law partner of the individual` TRUE (Date 29 2 2024) NOTHING (Date 27 2 2025))

-- cheque: an instrument issued in payment of a benefit
#ASSERT `the instrument is a cheque` TRUE
#ASSERT NOT (`the instrument is a cheque` FALSE)

-- release: earned remission, expiry of a sentence, or parole or statutory release not terminated or revoked
#ASSERT `leaving custody in this way is a release` `Release on earned remission` FALSE
#ASSERT `leaving custody in this way is a release` `Release on earned remission` TRUE
#ASSERT `leaving custody in this way is a release` `Release at the expiry of a sentence` FALSE
#ASSERT `leaving custody in this way is a release` `Release on parole` FALSE
#ASSERT NOT (`leaving custody in this way is a release` `Release on parole` TRUE)
#ASSERT `leaving custody in this way is a release` `Release on statutory release` FALSE
#ASSERT NOT (`leaving custody in this way is a release` `Release on statutory release` TRUE)
#ASSERT NOT (`leaving custody in this way is a release` `Any other release from custody` FALSE)

-- the Part that authorizes each benefit: pension Part I, supplement Part II, allowance Part III
#ASSERT `the Part of the Act under which the benefit is authorized` Pension EQUALS 1
#ASSERT `the Part of the Act under which the benefit is authorized` Supplement EQUALS 2
#ASSERT `the Part of the Act under which the benefit is authorized` Allowance EQUALS 3
