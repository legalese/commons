#ASSERT `is a regulation` TRUE FALSE   -- #17 s.2(1) regulation, limb (a)
#ASSERT `is a regulation` FALSE TRUE   -- #18 s.2(1) regulation, limb (b)
#ASSERT `is a regulation` TRUE FALSE   -- #19 s.2(1) regulation, a form under an Act (dup of #17)
#ASSERT REFUSED `is a regulation` FALSE FALSE   -- #20 s.2(1) regulation (NC)
