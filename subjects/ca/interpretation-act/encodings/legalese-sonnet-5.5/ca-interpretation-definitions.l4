    WHEN Yukon                       THEN TRUE
    WHEN `the Northwest Territories` THEN TRUE
    WHEN Nunavut                     THEN TRUE
    OTHERWISE FALSE

-- src:356 | territory means Yukon, the Northwest Territories and Nunavut; (territoires)
