§ `s 35(1) "radio or radiocommunication"`

-- "any transmission, emission or reception of signs, signals, writing, images, sounds or intelligence of any nature by means of
-- electromagnetic waves of frequencies lower than 3 000 GHz propagated in space without artificial guide."
#ASSERT `is radiocommunication within section 35(1) where` TRUE `by waves that are electromagnetic` TRUE `of a frequency in gigahertz of` 100 `propagated without artificial guide` TRUE
#ASSERT `is radiocommunication within section 35(1) where` TRUE `by waves that are electromagnetic` TRUE `of a frequency in gigahertz of` 2999 `propagated without artificial guide` TRUE
-- Exactly 3 000 GHz is not "lower than 3 000 GHz".
#ASSERT NOT (`is radiocommunication within section 35(1) where` TRUE `by waves that are electromagnetic` TRUE `of a frequency in gigahertz of` 3000 `propagated without artificial guide` TRUE)
#ASSERT NOT (`is radiocommunication within section 35(1) where` TRUE `by waves that are electromagnetic` TRUE `of a frequency in gigahertz of` 3001 `propagated without artificial guide` TRUE)
-- Each of the other conditions failing, the others met.
#ASSERT NOT (`is radiocommunication within section 35(1) where` TRUE `by waves that are electromagnetic` FALSE `of a frequency in gigahertz of` 100 `propagated without artificial guide` TRUE)
#ASSERT NOT (`is radiocommunication within section 35(1) where` TRUE `by waves that are electromagnetic` TRUE `of a frequency in gigahertz of` 100 `propagated without artificial guide` FALSE)
#ASSERT NOT (`is radiocommunication within section 35(1) where` FALSE `by waves that are electromagnetic` TRUE `of a frequency in gigahertz of` 100 `propagated without artificial guide` TRUE)

§ `s 35(1) "regular force"`

#ASSERT `the term defined by` (`the definition of the term regular force`) `covers` "the component of the Canadian Forces that is referred to in the National Defence Act as the regular force"
#ASSERT NOT (`the term defined by` (`the definition of the term regular force`) `covers` "the component of the Canadian Forces that is referred to in the National Defence Act as the reserve force")
#ASSERT (`the definition of the term regular force`'s `what it points at`) EQUALS JUST "the National Defence Act"

§ `s 35(1) "reserve force"`

#ASSERT `the term defined by` (`the definition of the term reserve force`) `covers` "the component of the Canadian Forces that is referred to in the National Defence Act as the reserve force"
#ASSERT NOT (`the term defined by` (`the definition of the term reserve force`) `covers` "the component of the Canadian Forces that is referred to in the National Defence Act as the regular force")
#ASSERT (`the definition of the term reserve force`'s `what it points at`) EQUALS JUST "the National Defence Act"

§ `s 35(1) "statutory declaration"`

-- "statutory declaration means a solemn declaration made pursuant to section 41 of the Canada Evidence Act."
#ASSERT `is a statutory declaration within section 35(1) where` TRUE `and` TRUE
#ASSERT NOT (`is a statutory declaration within section 35(1) where` TRUE `and` FALSE)
#ASSERT NOT (`is a statutory declaration within section 35(1) where` FALSE `and` TRUE)

§ `s 35(1) "superior court"`

-- (a) Newfoundland and Labrador: the Supreme Court.
#ASSERT elem "the Supreme Court" (`the superior courts in` `Newfoundland and Labrador`)
-- (a.1) Ontario: the Court of Appeal for Ontario and the Superior Court of Justice.
#ASSERT elem "the Court of Appeal for Ontario" (`the superior courts in` Ontario)
#ASSERT elem "the Superior Court of Justice" (`the superior courts in` Ontario)
#ASSERT NOT (elem "the Supreme Court" (`the superior courts in` Ontario))
-- (b) Quebec: the Court of Appeal and the Superior Court in and for the Province.
#ASSERT elem "the Court of Appeal" (`the superior courts in` Quebec)
#ASSERT elem "the Superior Court in and for the Province" (`the superior courts in` Quebec)
-- (c) New Brunswick, Manitoba, Saskatchewan or Alberta: the Court of Appeal for the Province and the Court of Queen’s Bench for the Province.
#ASSERT elem "the Court of Appeal for the Province" (`the superior courts in` `New Brunswick`)
#ASSERT elem "the Court of Queen’s Bench for the Province" (`the superior courts in` `New Brunswick`)
#ASSERT elem "the Court of Queen’s Bench for the Province" (`the superior courts in` Manitoba)
#ASSERT elem "the Court of Queen’s Bench for the Province" (`the superior courts in` Saskatchewan)
#ASSERT elem "the Court of Queen’s Bench for the Province" (`the superior courts in` Alberta)
-- FORK F-QUEENS: taken, the court styled for the reigning Sovereign is the same court.
#ASSERT elem "the Court of King’s Bench for the Province" (`the superior courts in` Alberta)
#ASSERT NOT (elem "the Court of Queen’s Bench for the Province" (`the superior courts in` Ontario))
-- (d) Nova Scotia, British Columbia and Prince Edward Island: the Court of Appeal and the Supreme Court of the Province.
#ASSERT elem "the Court of Appeal" (`the superior courts in` `Nova Scotia`)
#ASSERT elem "the Supreme Court of the Province" (`the superior courts in` `Nova Scotia`)
#ASSERT elem "the Supreme Court of the Province" (`the superior courts in` `British Columbia`)
#ASSERT elem "the Supreme Court of the Province" (`the superior courts in` `Prince Edward Island`)
-- (e) the Supreme Court of Yukon, the Supreme Court of the Northwest Territories and the Nunavut Court of Justice.
#ASSERT elem "the Supreme Court of Yukon" (`the superior courts in` Yukon)
#ASSERT elem "the Supreme Court of the Northwest Territories" (`the superior courts in` `the Northwest Territories`)
#ASSERT elem "the Nunavut Court of Justice" (`the superior courts in` Nunavut)
-- The closing words: "and includes the Supreme Court of Canada, the Federal Court of Appeal, the Federal Court and the Tax Court of Canada",
-- wherever the enactment is applied.
#ASSERT elem "the Supreme Court of Canada" (`the superior courts in` Yukon)
#ASSERT elem "the Federal Court of Appeal" (`the superior courts in` Ontario)
#ASSERT elem "the Federal Court" (`the superior courts in` Quebec)
#ASSERT elem "the Tax Court of Canada" (`the superior courts in` Nunavut)
-- Counts, from the text: Ontario 2 + 4; Alberta 2 + 1 (the King’s style, F-QUEENS) + 4; Newfoundland and Labrador 1 + 4.
#ASSERT count (`the superior courts in` Ontario) EQUALS 6
#ASSERT count (`the superior courts in` Alberta) EQUALS 7
#ASSERT count (`the superior courts in` `Newfoundland and Labrador`) EQUALS 5

§ `s 35(1) "telecommunications"`

-- "the emission, transmission or reception of signs, signals, writing, images, sounds or intelligence of any nature by any wire, cable, radio,
-- optical or other electromagnetic system, or by any similar technical system."
#ASSERT `is telecommunications within section 35(1) where` TRUE `by` `a wire system`
#ASSERT `is telecommunications within section 35(1) where` TRUE `by` `a cable system`
#ASSERT `is telecommunications within section 35(1) where` TRUE `by` `a radio system`
#ASSERT `is telecommunications within section 35(1) where` TRUE `by` `an optical system`
#ASSERT `is telecommunications within section 35(1) where` TRUE `by` `another electromagnetic system`
#ASSERT `is telecommunications within section 35(1) where` TRUE `by` `a similar technical system`
#ASSERT NOT (`is telecommunications within section 35(1) where` TRUE `by` `a system of none of these kinds`)
#ASSERT NOT (`is telecommunications within section 35(1) where` FALSE `by` `a wire system`)

§ `s 35(1) "territorial sea"`

-- (a) in relation to Canada: "the territorial sea of Canada as determined under the Oceans Act and includes the airspace above and the seabed
-- and subsoil below that sea".
#ASSERT (`the territorial sea in relation to` `Canada as a state`)'s `what it is` EQUALS "the territorial sea of Canada"
#ASSERT (`the territorial sea in relation to` `Canada as a state`)'s `how it is fixed` EQUALS "as determined under the Oceans Act"
#ASSERT elem "the airspace above that sea" ((`the territorial sea in relation to` `Canada as a state`)'s `what it also includes`)
#ASSERT elem "the seabed and subsoil below that sea" ((`the territorial sea in relation to` `Canada as a state`)'s `what it also includes`)
-- (b) in relation to any other state.
#ASSERT (`the territorial sea in relation to` `a state other than Canada`)'s `what it is` EQUALS "the territorial sea of the other state"
#ASSERT (`the territorial sea in relation to` `a state other than Canada`)'s `how it is fixed` EQUALS "as determined in accordance with international law and the domestic laws of that other state"

§ `s 35(1) "territory"`

-- "territory means Yukon, the Northwest Territories and Nunavut."
#ASSERT `is a territory within section 35(1)` Yukon
#ASSERT `is a territory within section 35(1)` `the Northwest Territories`
#ASSERT `is a territory within section 35(1)` Nunavut
#ASSERT NOT (`is a territory within section 35(1)` Ontario)
#ASSERT NOT (`is a territory within section 35(1)` Alberta)
#ASSERT `the term defined by` (`the definition of the term territory`) `covers` "Nunavut"
#ASSERT NOT (`the term defined by` (`the definition of the term territory`) `covers` "Ontario")

