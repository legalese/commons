#ASSERT `are two justices within section 35(1) where there are` 2 `justices of the peace, and` TRUE
#ASSERT `are two justices within section 35(1) where there are` 3 `justices of the peace, and` TRUE
#ASSERT NOT (`are two justices within section 35(1) where there are` 1 `justices of the peace, and` TRUE)
#ASSERT NOT (`are two justices within section 35(1) where there are` 2 `justices of the peace, and` FALSE)

