IMPORT prelude
IMPORT daydate
IMPORT `sk-sis`
IMPORT `sk-sis-seat`

-- The Saskatchewan Assistance Act and The Saskatchewan Income Support Regulations -- worked cases from the seat of the
-- individual applying for, or receiving, SIS for their household. Every assertion is a claim about the ENCODING on stated
-- facts. Expected values were worked by hand from the deposited texts (R.S.S.-1978-c.-S-8.txt, R.R.S.-c.-S-8-Reg-13.txt),
-- never copied from the encoding's output. All the households are HYPOTHETICAL, and so are the benefit totals from the
-- minister's schedule of rates, which the regulations do not state (NOTES.md finding 1). Amounts are monthly dollars.
-- UNOFFICIAL VERSION: quoted from the King's Printer consolidations, (c) 2026, Government of Saskatchewan.

-- ---------------------------------------------------------------------------------------------------------------------
-- s 2-1(3): who may apply.
#ASSERT `Can I apply` TRUE 30 `Canadian citizen` FALSE
#ASSERT `Can I apply` TRUE 30 `refugee claimant or protection applicant awaiting a decision` FALSE
#ASSERT (`Can I apply` TRUE 17 `Canadian citizen` FALSE) EQUALS FALSE
#ASSERT (`Can I apply` TRUE 30 `another status, such as a visitor, student or worker` FALSE) EQUALS FALSE
-- s 2-10(1)(d): the minister's waiver for compassionate, compelling or medical reasons.
#ASSERT `Can I apply` TRUE 30 `another status, such as a visitor, student or worker` TRUE
#ASSERT `Can I apply` FALSE 30 `Canadian citizen` TRUE
#ASSERT (`Can I apply` FALSE 30 `Canadian citizen` FALSE) EQUALS FALSE
-- The waiver does not reach the age requirement.
#ASSERT (`Can I apply` TRUE 17 `Canadian citizen` TRUE) EQUALS FALSE

-- ---------------------------------------------------------------------------------------------------------------------
-- s 2-5: household members for whom nothing is paid.
#ASSERT `Is this member left out` 31 FALSE FALSE 0 FALSE FALSE FALSE
#ASSERT (`Is this member left out` 30 FALSE FALSE 0 FALSE FALSE FALSE) EQUALS FALSE
#ASSERT `Is this member left out` 0 TRUE FALSE 0 FALSE FALSE FALSE
#ASSERT `Is this member left out` 0 FALSE TRUE 0 FALSE FALSE FALSE
#ASSERT `Is this member left out` 0 FALSE FALSE 45 FALSE FALSE FALSE
#ASSERT (`Is this member left out` 0 FALSE FALSE 45 TRUE FALSE FALSE) EQUALS FALSE
#ASSERT (`Is this member left out` 0 FALSE FALSE 30 FALSE FALSE FALSE) EQUALS FALSE
#ASSERT `Is this member left out` 0 FALSE FALSE 0 FALSE TRUE FALSE
#ASSERT `Is this member left out` 0 FALSE FALSE 0 FALSE FALSE TRUE
#ASSERT (`Is this member left out` 0 FALSE FALSE 0 FALSE FALSE FALSE) EQUALS FALSE

-- ---------------------------------------------------------------------------------------------------------------------
-- s 2-7(2)(a): the earned income exemption.
#ASSERT `How much earned income is exempt` FALSE FALSE EQUALS 375
#ASSERT `How much earned income is exempt` TRUE FALSE EQUALS 475
#ASSERT `How much earned income is exempt` FALSE TRUE EQUALS 500
#ASSERT `How much earned income is exempt` TRUE TRUE EQUALS 500

-- s 2-7: income that counts.
-- Single person, $1,200 gross pay, $150 tax/CPP/EI: earned $1,050, less $375: $675.
#ASSERT `How much of our income counts` FALSE FALSE 1200 150 0 0 0 0 0 0 0 0 EQUALS 675
-- Single parent: pay $800 less $100 = $700, less $500 = $200; child support $750, $600 exempt: $150; gifts $250, $200
-- exempt: $50; Canada Child Benefit $900, exempt: total $400.
#ASSERT `How much of our income counts` FALSE TRUE 800 100 0 0 750 0 250 900 0 0 EQUALS 400
-- Child support $900 of which $200 is for special expenses over the table amount: exempt $200 + $600: $100 counts.
#ASSERT `How much of our income counts` FALSE TRUE 0 0 0 0 900 200 0 0 0 0 EQUALS 100
-- Earnings under the exemption count for nothing; Employment Insurance of $1,400 counts in full (not exempt).
#ASSERT `How much of our income counts` FALSE FALSE 300 0 0 0 0 0 0 0 1400 0 EQUALS 1400
-- Couple, union dues $40 required by the employer: $1,000 - $60 - $40 = $900, less $475: $425; $50 set off: $475.
#ASSERT `How much of our income counts` TRUE FALSE 1000 60 40 0 0 0 0 0 0 50 EQUALS 475
-- A self-employment loss does not reduce other income (s 2-7(1.1)): $300 of other income counts.
#ASSERT `How much of our income counts` FALSE FALSE 0 0 0 (0 MINUS 200) 0 0 0 0 300 0 EQUALS 300

-- ---------------------------------------------------------------------------------------------------------------------
-- s 2-6(4): liquid assets. $3,000 plus life insurance cash value $2,000 ($500 over $1,500 counts) = $3,500.
#ASSERT (`Are our liquid assets over the limit` 3000 2000 2) EQUALS FALSE
#ASSERT `Are our liquid assets over the limit` 3000 2000 1
-- Exactly $2,000 for one person is not "greater than".
#ASSERT (`Are our liquid assets over the limit` 2000 0 1) EQUALS FALSE
#ASSERT `Are our liquid assets over the limit` 2001 0 1

-- ss 1-2, 2-6(5)(a): excess assets.
#ASSERT `Do we own excess assets` TRUE 0 FALSE
#ASSERT (`Do we own excess assets` FALSE 5000 FALSE) EQUALS FALSE
#ASSERT `Do we own excess assets` FALSE 5001 FALSE
#ASSERT (`Do we own excess assets` TRUE 8000 TRUE) EQUALS FALSE

-- ---------------------------------------------------------------------------------------------------------------------
-- s 2-6(3): the budget deficit. Hypothetical schedule total $1,500.
#ASSERT `Do we have a budget deficit` 400 1500 FALSE FALSE FALSE
#ASSERT (`Do we have a budget deficit` 1600 1500 FALSE FALSE FALSE) EQUALS FALSE
#ASSERT (`Do we have a budget deficit` 1500 1500 FALSE FALSE FALSE) EQUALS FALSE
#ASSERT (`Do we have a budget deficit` 400 1500 TRUE FALSE FALSE) EQUALS FALSE
#ASSERT (`Do we have a budget deficit` 400 1500 FALSE TRUE FALSE) EQUALS FALSE
#ASSERT (`Do we have a budget deficit` 400 1500 FALSE FALSE TRUE) EQUALS FALSE

-- s 2-4: eligibility.
#ASSERT `Are we eligible` TRUE TRUE TRUE TRUE TRUE `none` TRUE
#ASSERT (`Are we eligible` TRUE TRUE TRUE TRUE TRUE `SAID benefits` TRUE) EQUALS FALSE
#ASSERT `Are we eligible` TRUE TRUE TRUE TRUE TRUE `SAID temporary benefits under SAID s 17` TRUE
#ASSERT (`Are we eligible` TRUE TRUE TRUE TRUE TRUE `federal resettlement assistance` TRUE) EQUALS FALSE
#ASSERT (`Are we eligible` TRUE TRUE TRUE TRUE FALSE `none` TRUE) EQUALS FALSE
#ASSERT (`Are we eligible` TRUE TRUE TRUE TRUE TRUE `none` FALSE) EQUALS FALSE
#ASSERT (`Are we eligible` TRUE FALSE TRUE TRUE TRUE `none` TRUE) EQUALS FALSE

-- s 3-1: the amount. $1,500 of benefits less $400 of counted income: $1,100; with $2,000 of income: nil.
#ASSERT `How much will we be paid` 1500 400 EQUALS 1100
#ASSERT `How much will we be paid` 1500 2000 EQUALS 0

-- s 3-3(1): a $6,900 lump sum, $1,000 of monthly benefits, no other income: 6,900 / 1,150 = 6 months.
#ASSERT `For how many months are we self-supporting` 6900 1000 0 EQUALS JUST 6
-- $5,000, benefits $1,200, other income $380: 5,000 / (1,380 - 380) = 5 months.
#ASSERT `For how many months are we self-supporting` 5000 1200 380 EQUALS JUST 5
-- $1,000, benefits $1,000, no income: 1,000 / 1,150 = 20/23 of a month (unrounded: finding 5).
#ASSERT `For how many months are we self-supporting` 1000 1000 0 EQUALS JUST (1000 DIVIDED BY 1150)
-- Income above 115% of benefits: the formula has no meaning: NOTHING.
#ASSERT `For how many months are we self-supporting` 5000 300 400 EQUALS NOTHING

-- ---------------------------------------------------------------------------------------------------------------------
-- Appeal and review deadlines.
#ASSERT `By when must I appeal to the ministry` (Date 1 3 2026) EQUALS Date 16 3 2026
#ASSERT `By when must I appeal to the appeal board` (Date 20 4 2026) EQUALS Date 5 5 2026
-- Certificate notice sent by registered mail on 1 June 2026: served 8 June; review by 8 July 2026.
#ASSERT `By when must I apply for review of a certificate` (Date 1 6 2026) TRUE EQUALS Date 8 7 2026
-- Handed over on 1 June 2026: by 1 July 2026.
#ASSERT `By when must I apply for review of a certificate` (Date 1 6 2026) FALSE EQUALS Date 1 7 2026
#ASSERT `When may a certificate be filed against me` (Date 1 6 2026) EQUALS Date 1 7 2026
-- s 29.7: a creditor cannot garnish; the ministry may recover an overpayment from future payments.
#ASSERT (`Can my payments be taken` FALSE) EQUALS FALSE
#ASSERT `Can my payments be taken` TRUE
-- ss 27, 28: maximum penalties for an individual.
#ASSERT `What is the most I can be fined` `contravening the Act, a regulation or an order (s 27)` EQUALS `Penalty` WITH `maximum fine` IS 100, `maximum months of imprisonment in default` IS 3
#ASSERT `What is the most I can be fined` `knowingly giving false information or concealing information to obtain assistance (s 28(1))` EQUALS `Penalty` WITH `maximum fine` IS 200, `maximum months of imprisonment in default` IS 6
#ASSERT `What is the most I can be fined` `continuing to receive assistance after receiving assets, knowing I am no longer eligible (s 28(3))` EQUALS `Penalty` WITH `maximum fine` IS 200, `maximum months of imprisonment in default` IS 6

-- ---------------------------------------------------------------------------------------------------------------------
-- The duties, as traces. Days count from the request, the change or the decision.
-- s 2-2(5), (6): confirmed in person on day 10: met.
#ASSERT EVALTRACE `my duty to confirm my application` 0 (LIST EVENT `the applicant` `confirm the application in person` 10) EQUALS FULFILLED
-- Confirmed on day 20: discontinued.
-- expect: BREACH BY `the applicant`, "application not confirmed within 15 days of the request: discontinued and not processed, unless the minister finds exceptional circumstances (s 2-2(6))"
#TRACE `my duty to confirm my application` AT 0 WITH
    PARTY `the applicant` DOES `confirm the application in person` AT 20

-- s 3-8: reported the same day: met. Reported five days later: breach.
#ASSERT EVALTRACE `my duty to report a change` 0 (LIST EVENT `the client` `report the change to the minister` 0) EQUALS FULFILLED
-- expect: BREACH BY `the client`, "change not reported immediately (Reg s 3-8, Act s 29.2): excess benefits are an overpayment (Act s 29.3)"
#TRACE `my duty to report a change` AT 0 WITH
    PARTY `the client` DOES `report the change to the minister` AT 5

-- s 3-11(2)(a), (4): a response on day 25 is in time; on day 40 it is in time only with a 15-day extension.
#ASSERT EVALTRACE (`my duty to respond to a review request` 0) 0 (LIST EVENT `the client` `respond to the minister's request` 25) EQUALS FULFILLED
#ASSERT EVALTRACE (`my duty to respond to a review request` 15) 0 (LIST EVENT `the client` `respond to the minister's request` 40) EQUALS FULFILLED
-- expect: BREACH BY `the client`, "no response within 30 days of the request: the minister may make inquiries and obtain information (s 3-11(2)(b))"
#TRACE `my duty to respond to a review request` 0 AT 0 WITH
    PARTY `the client` DOES `respond to the minister's request` AT 40

-- s 3-12: appeal on day 10; the minister reconsiders on day 15 (within 7 days of the appeal): met.
#ASSERT EVALTRACE `my right to appeal to the minister` 0 (LIST EVENT `the applicant` `appeal the decision in writing to the minister` 10, EVENT `the minister` `reconsider the decision and give a written decision` 15) EQUALS FULFILLED
-- The minister takes until day 20: the minister is in breach.
-- expect: BREACH BY `the minister`, "appeal not reconsidered within 7 days of receiving it (s 3-12(2))"
#TRACE `my right to appeal to the minister` AT 0 WITH
    PARTY `the applicant` DOES `appeal the decision in writing to the minister` AT 10
    PARTY `the minister` DOES `reconsider the decision and give a written decision` AT 20
-- No appeal within 15 days: the right lapses, which is no breach.
-- expect: FULFILLED
#TRACE `my right to appeal to the minister` AT 0 WITH
    (WAITUNTIL 16)

-- s 3-14(2): notice of appeal to the board on day 5: fine.
#ASSERT EVALTRACE `my right to appeal to the appeal board` 0 (LIST EVENT `the applicant` `give notice of appeal to the appeal board` 5) EQUALS FULFILLED
