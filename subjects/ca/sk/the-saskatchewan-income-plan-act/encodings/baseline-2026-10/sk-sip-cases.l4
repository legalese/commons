IMPORT prelude
IMPORT daydate
IMPORT `sk-sip`
IMPORT `sk-sip-seat`

-- The Saskatchewan Income Plan Act and The Seniors Income Plan Regulations -- worked cases from the seat of the senior.
-- Every assertion is a claim about the ENCODING on stated facts. Expected values were worked by hand from the deposited
-- texts (S.S.-1986-c.-S-25.1.txt, R.R.S.-c.-S-25.1-Reg-3.txt), never copied from the encoding's output. All the people are
-- HYPOTHETICAL; the GIS and Allowance reductions are hypothetical figures, not read from the federal Table of Rates.
-- UNOFFICIAL VERSION: quoted from the King's Printer consolidations, (c) 2026, Government of Saskatchewan.

-- Act s 4: eligibility.
#ASSERT `Am I eligible for the Seniors Income Plan` TRUE FALSE TRUE TRUE FALSE
#ASSERT (`Am I eligible for the Seniors Income Plan` TRUE TRUE TRUE TRUE FALSE) EQUALS FALSE
#ASSERT (`Am I eligible for the Seniors Income Plan` FALSE FALSE TRUE TRUE FALSE) EQUALS FALSE
#ASSERT (`Am I eligible for the Seniors Income Plan` TRUE FALSE TRUE FALSE FALSE) EQUALS FALSE
#ASSERT (`Am I eligible for the Seniors Income Plan` TRUE FALSE FALSE TRUE FALSE) EQUALS FALSE
#ASSERT (`Am I eligible for the Seniors Income Plan` TRUE FALSE TRUE TRUE TRUE) EQUALS FALSE

-- Reg s 4: the maximum.
#ASSERT `What is my maximum benefit` `no spouse or partner` FALSE EQUALS 360
#ASSERT `What is my maximum benefit` `spouse or partner is a pensioner` FALSE EQUALS 325
#ASSERT `What is my maximum benefit` `spouse or partner is neither a pensioner nor receiving an allowance` FALSE EQUALS 360
#ASSERT `What is my maximum benefit` `spouse or partner receives an allowance` FALSE EQUALS 360
#ASSERT `What is my maximum benefit` `no spouse or partner` TRUE EQUALS 50
#ASSERT `What is my maximum benefit` `spouse or partner is a pensioner` TRUE EQUALS 50

-- Reg ss 4-6: the monthly benefit.
-- Single, full GIS: $360.
#ASSERT `How much will I be paid each month` TRUE `no spouse or partner` FALSE 0 0 EQUALS 360
-- Single, GIS $100 below the maximum: $360 - $1.90 x 100 = $170.
#ASSERT `How much will I be paid each month` TRUE `no spouse or partner` FALSE 100 0 EQUALS 170
-- Single, GIS 50 cents below: $360 - $0.95 = $359.05 (finding 3: read proportionally).
#ASSERT `How much will I be paid each month` TRUE `no spouse or partner` FALSE 0.5 0 EQUALS 359.05
-- Single, GIS $185 below: $360 - $351.50 = $8.50, more than nil and less than $15: the $15 minimum (s 6(2)).
#ASSERT `How much will I be paid each month` TRUE `no spouse or partner` FALSE 185 0 EQUALS 15
-- Single, GIS $200 below: $360 - $380 is below nil: nothing, and the minimum does not apply to nil.
#ASSERT `How much will I be paid each month` TRUE `no spouse or partner` FALSE 200 0 EQUALS 0
-- Both pensioners, GIS $50 below: $325 - $2.10 x 50 = $220.
#ASSERT `How much will I be paid each month` TRUE `spouse or partner is a pensioner` FALSE 50 0 EQUALS 220
-- Spouse neither pensioner nor on the Allowance, GIS $40 below: $360 - $6.55 x 40 = $98.
#ASSERT `How much will I be paid each month` TRUE `spouse or partner is neither a pensioner nor receiving an allowance` FALSE 40 0 EQUALS 98
-- Spouse on the Allowance, $30 below the maximum Allowance: ten $3 steps: $360 - $19 = $341.
#ASSERT `How much will I be paid each month` TRUE `spouse or partner receives an allowance` FALSE 0 30 EQUALS 341
-- $31 below: ten full steps and one of less than $3 (s 5(2)(a)(iv)(B)): $360 - $20.90 = $339.10.
#ASSERT `How much will I be paid each month` TRUE `spouse or partner receives an allowance` FALSE 0 31 EQUALS 339.1
-- In a special-care home with the GIS $100 below: the $50 maximum of s 4(2), which s 5(2)(a) does not reduce (finding 4).
#ASSERT `How much will I be paid each month` TRUE `no spouse or partner` TRUE 100 0 EQUALS 50
-- Not eligible: nothing.
#ASSERT `How much will I be paid each month` FALSE `no spouse or partner` FALSE 0 0 EQUALS 0

-- Reg s 7: moved into a special-care home in November 2026: the new amount from January 2027; in March 2026: from May 2026.
#ASSERT `From which month does my benefit change` 11 2026 EQUALS `Month` WITH `month number` IS 1, `year` IS 2027
#ASSERT `From which month does my benefit change` 3 2026 EQUALS `Month` WITH `month number` IS 5, `year` IS 2026

-- Reg s 9: entitled from 1 January 2025; discovered in October 2026: arrears only from 1 July 2026.
#ASSERT `From what date will arrears be paid` (Date 1 1 2025) 10 2026 EQUALS Date 1 7 2026
-- Discovered in March 2026: the payment period began on 1 July 2025.
#ASSERT `From what date will arrears be paid` (Date 1 1 2025) 3 2026 EQUALS Date 1 7 2025
-- Entitled from 1 September 2026, discovered in October 2026: from 1 September 2026.
#ASSERT `From what date will arrears be paid` (Date 1 9 2026) 10 2026 EQUALS Date 1 9 2026
-- The minister's duty to pay arrears: met when paid; none without an underpayment.
#ASSERT EVALTRACE (`the minister's duty to pay my arrears` TRUE) 0 (LIST EVENT `the minister` `calculate and pay the benefits owing` 30) EQUALS FULFILLED
#ASSERT EVALTRACE (`the minister's duty to pay my arrears` FALSE) 0 (LIST) EQUALS FULFILLED

-- Act s 7: termination.
#ASSERT (`Does my benefit stop` TRUE FALSE) EQUALS FALSE
#ASSERT `Does my benefit stop` FALSE FALSE
#ASSERT `Does my benefit stop` TRUE TRUE

-- Act ss 8, 9: only overpayment recovery may be deducted.
#ASSERT (`May my benefit be reduced or taken` FALSE) EQUALS FALSE
#ASSERT `May my benefit be reduced or taken` TRUE
