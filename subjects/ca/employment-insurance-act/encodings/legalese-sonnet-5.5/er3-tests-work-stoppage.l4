IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `er3-nouns`
IMPORT `er3-work-stoppage`

-- Tests of er3-work-stoppage (regulations 52 and 53). Every expected value is written by hand from the text of
-- regs 52 and 53 (SOR-96-332.txt lines 787-808) before the module was run.

§ `reg 52(2) -- the table`

-- Weekly insurable earnings of 1000. The bands are "more than X but not more than Y": the upper end belongs to
-- the band, so 100 (10%) is band 0 and 101 is band 1.
#ASSERT `reg 52(2) the days of disentitlement in a week according to the table` 0 1000 EQUALS NOTHING
#ASSERT `reg 52(2) the days of disentitlement in a week according to the table` 1 1000 EQUALS JUST 0
#ASSERT `reg 52(2) the days of disentitlement in a week according to the table` 100 1000 EQUALS JUST 0
#ASSERT `reg 52(2) the days of disentitlement in a week according to the table` 101 1000 EQUALS JUST 1
#ASSERT `reg 52(2) the days of disentitlement in a week according to the table` 300 1000 EQUALS JUST 1
#ASSERT `reg 52(2) the days of disentitlement in a week according to the table` 301 1000 EQUALS JUST 2
#ASSERT `reg 52(2) the days of disentitlement in a week according to the table` 500 1000 EQUALS JUST 2
#ASSERT `reg 52(2) the days of disentitlement in a week according to the table` 501 1000 EQUALS JUST 3
#ASSERT `reg 52(2) the days of disentitlement in a week according to the table` 700 1000 EQUALS JUST 3
#ASSERT `reg 52(2) the days of disentitlement in a week according to the table` 701 1000 EQUALS JUST 4
#ASSERT `reg 52(2) the days of disentitlement in a week according to the table` 900 1000 EQUALS JUST 4
#ASSERT `reg 52(2) the days of disentitlement in a week according to the table` 901 1000 EQUALS JUST 5
#ASSERT `reg 52(2) the days of disentitlement in a week according to the table` 1000 1000 EQUALS JUST 5
-- "more than 90" has no upper end.
#ASSERT `reg 52(2) the days of disentitlement in a week according to the table` 1500 1000 EQUALS JUST 5
-- no weekly insurable earnings to measure against: not covered.
#ASSERT `reg 52(2) the days of disentitlement in a week according to the table` 500 0 EQUALS NOTHING

§ `reg 52(1) -- the days of disentitlement for the week`

-- a part-time job lost to a stoppage, no ending event yet: the table's days (50% is band 2).
#ASSERT `reg 52 the days of disentitlement for the week` TRUE FALSE 500 1000 EQUALS JUST 2
#ASSERT `reg 52 the days of disentitlement for the week` TRUE FALSE 950 1000 EQUALS JUST 5
-- an event of 36(1)(a) or (b) has occurred in respect of the job: no more disentitlement.
#ASSERT `reg 52 the days of disentitlement for the week` TRUE TRUE 500 1000 EQUALS JUST 0
-- not a job lost for a reason in s 36(1) of the Act: reg 52 does not apply.
#ASSERT `reg 52 the days of disentitlement for the week` FALSE FALSE 500 1000 EQUALS NOTHING
-- nothing earned in the part-time job: below the table.
#ASSERT `reg 52 the days of disentitlement for the week` TRUE FALSE 0 1000 EQUALS NOTHING

§ `reg 53(3), (1) -- the 85 per cent level`

-- (3): the part of a level due to exceptional or temporary measures is left out.
#ASSERT `reg 53(3) the level to be counted` 100 15 EQUALS 85
#ASSERT `reg 53(3) the level to be counted` 100 0 EQUALS 100
-- 85 of a normal 100 is enough; 84 is not.
#ASSERT `reg 53 the level to be counted is at least 85 per cent of the normal level` 85 0 100 EQUALS JUST TRUE
#ASSERT `reg 53 the level to be counted is at least 85 per cent of the normal level` 84 0 100 EQUALS JUST FALSE
-- 100 reached, but 20 of it by exceptional measures: 80 counts, below 85.
#ASSERT `reg 53 the level to be counted is at least 85 per cent of the normal level` 100 20 100 EQUALS JUST FALSE
#ASSERT `reg 53 the level to be counted is at least 85 per cent of the normal level` 105 20 100 EQUALS JUST TRUE
-- no normal level to measure against: not covered.
#ASSERT `reg 53 the level to be counted is at least 85 per cent of the normal level` 85 0 0 EQUALS NOTHING
-- (1): both the work-force and the activity.
#ASSERT `reg 53(1) the stoppage of work is terminated` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 53(1) the stoppage of work is terminated` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 53(1) the stoppage of work is terminated` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `reg 53(1) the stoppage of work is terminated` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
-- a level that cannot be measured leaves the question open unless the other level already settles it.
#ASSERT `reg 53(1) the stoppage of work is terminated` NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `reg 53(1) the stoppage of work is terminated` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `reg 53(1) the stoppage of work is terminated` (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `reg 53(1) the stoppage of work is terminated` NOTHING (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 53(1) the stoppage of work is terminated` NOTHING NOTHING EQUALS NOTHING

§ `reg 53(2) -- an occurrence prevents the 85 per cent level`

-- (a) discontinuance, permanent restructuring, act of God: the work-force OR the activity at 85 per cent of the adjusted level (fork F14).
#ASSERT `reg 53(2) the stoppage of work is terminated although an occurrence prevents the 85 per cent level` `er3 occurrence: a discontinuance of business` FALSE TRUE FALSE EQUALS TRUE
#ASSERT `reg 53(2) the stoppage of work is terminated although an occurrence prevents the 85 per cent level` `er3 occurrence: a permanent restructuring of activity` FALSE FALSE TRUE EQUALS TRUE
#ASSERT `reg 53(2) the stoppage of work is terminated although an occurrence prevents the 85 per cent level` `er3 occurrence: an act of God` FALSE TRUE TRUE EQUALS TRUE
#ASSERT `reg 53(2) the stoppage of work is terminated although an occurrence prevents the 85 per cent level` `er3 occurrence: an act of God` FALSE FALSE FALSE EQUALS FALSE
-- (b) a change in economic or market conditions or in technology: a resumption of activity AND both levels.
#ASSERT `reg 53(2) the stoppage of work is terminated although an occurrence prevents the 85 per cent level` `er3 occurrence: a change in economic or market conditions` TRUE TRUE TRUE EQUALS TRUE
#ASSERT `reg 53(2) the stoppage of work is terminated although an occurrence prevents the 85 per cent level` `er3 occurrence: a change in technology` TRUE TRUE TRUE EQUALS TRUE
#ASSERT `reg 53(2) the stoppage of work is terminated although an occurrence prevents the 85 per cent level` `er3 occurrence: a change in technology` FALSE TRUE TRUE EQUALS FALSE
#ASSERT `reg 53(2) the stoppage of work is terminated although an occurrence prevents the 85 per cent level` `er3 occurrence: a change in economic or market conditions` TRUE TRUE FALSE EQUALS FALSE
#ASSERT `reg 53(2) the stoppage of work is terminated although an occurrence prevents the 85 per cent level` `er3 occurrence: a change in economic or market conditions` TRUE FALSE TRUE EQUALS FALSE
-- no occurrence: (2) has nothing to say.
#ASSERT `reg 53(2) the stoppage of work is terminated although an occurrence prevents the 85 per cent level` `er3 occurrence: none` TRUE TRUE TRUE EQUALS FALSE
