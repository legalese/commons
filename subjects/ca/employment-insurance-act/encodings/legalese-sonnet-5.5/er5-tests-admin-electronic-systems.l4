IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `er5-admin-electronic-systems`

-- Tests of er5-admin-electronic-systems (regs 90 and 91). Expected values are written by hand from the text of the Regulations
-- (SOR-96-332.txt lines 1686-1695), beside each assertion, before the run.

§ `Reg 90 - a form and manner approved by the Commission (src:1686)`

#ASSERT `reg 90 the information must be provided in a form and manner approved by the Commission` TRUE
#ASSERT NOT (`reg 90 the information must be provided in a form and manner approved by the Commission` FALSE)
-- The argument order is: information is provided to the Commission for the purposes of the Act; the form and manner is one the Commission has approved.
#ASSERT `reg 90 the information is provided as the Commission requires` TRUE TRUE
#ASSERT NOT (`reg 90 the information is provided as the Commission requires` TRUE FALSE)
-- Information that is not provided to the Commission for the purposes of the Act is outside the section: nothing is required.
#ASSERT `reg 90 the information is provided as the Commission requires` FALSE FALSE
#ASSERT `reg 90 the information is provided as the Commission requires` FALSE TRUE

§ `Reg 91(1) - a claim by telephone or other electronic means (src:1687-1689)`

-- The argument order is: the claim is made by telephone or other electronic means; the claimant provides the information section 50 requires.
#ASSERT `reg 91(1) the claim is made by telephone or other electronic means with the information section 50 requires` TRUE TRUE
#ASSERT NOT (`reg 91(1) the claim is made by telephone or other electronic means with the information section 50 requires` TRUE FALSE)
#ASSERT NOT (`reg 91(1) the claim is made by telephone or other electronic means with the information section 50 requires` FALSE TRUE)
-- (a) and (b) follow the same condition.
#ASSERT `reg 91(1)(a) the claimant is deemed to have expressed an intention to make a claim and to have made it for the purposes of section 48, 49 or 152.1 of the Act` TRUE
#ASSERT NOT (`reg 91(1)(a) the claimant is deemed to have expressed an intention to make a claim and to have made it for the purposes of section 48, 49 or 152.1 of the Act` FALSE)
#ASSERT `reg 91(1)(b) the claimant is deemed to have supplied the information on the dated printout as responses to the questions of the interactive response system` TRUE
#ASSERT NOT (`reg 91(1)(b) the claimant is deemed to have supplied the information on the dated printout as responses to the questions of the interactive response system` FALSE)

§ `Reg 91(2) - deemed to have signed (src:1690-1692)`

-- The argument order is: the kind of claim; provides their Social Insurance Number; provides their date of birth; the initial claim is made by electronic means other than telephone;
-- provides the maiden name of their mother; provides their personal identification number.
-- An initial claim by telephone: Social Insurance Number and date of birth are enough.
#ASSERT `reg 91(2) the claimant is deemed to have signed the claim` `er5 an initial claim for benefits` TRUE TRUE FALSE FALSE FALSE
-- An initial claim by other electronic means: the mother's maiden name is also required.
#ASSERT `reg 91(2) the claimant is deemed to have signed the claim` `er5 an initial claim for benefits` TRUE TRUE TRUE TRUE FALSE
#ASSERT NOT (`reg 91(2) the claimant is deemed to have signed the claim` `er5 an initial claim for benefits` TRUE TRUE TRUE FALSE FALSE)
-- No date of birth.
#ASSERT NOT (`reg 91(2) the claimant is deemed to have signed the claim` `er5 an initial claim for benefits` TRUE FALSE FALSE FALSE FALSE)
-- No Social Insurance Number.
#ASSERT NOT (`reg 91(2) the claimant is deemed to have signed the claim` `er5 an initial claim for benefits` FALSE TRUE FALSE FALSE FALSE)
-- A claim for a week of unemployment: Social Insurance Number and personal identification number.
#ASSERT `reg 91(2) the claimant is deemed to have signed the claim` `er5 a claim for benefits for a week of unemployment` TRUE FALSE FALSE FALSE TRUE
-- Without the personal identification number, the date of birth does not do.
#ASSERT NOT (`reg 91(2) the claimant is deemed to have signed the claim` `er5 a claim for benefits for a week of unemployment` TRUE TRUE FALSE TRUE FALSE)
-- Without the Social Insurance Number.
#ASSERT NOT (`reg 91(2) the claimant is deemed to have signed the claim` `er5 a claim for benefits for a week of unemployment` FALSE FALSE FALSE FALSE TRUE)

§ `Reg 91(3) - the day the claim is made (src:1693)`

-- Received and recorded on March 9, 2020: the claim is deemed made that day.
#ASSERT `reg 91(3) the day on which the claim is deemed to have been made` TRUE (YearMonthDay 2020 3 9) EQUALS JUST (YearMonthDay 2020 3 9)
-- A claim not made by those means: the text says nothing here.
#ASSERT `reg 91(3) the day on which the claim is deemed to have been made` FALSE (YearMonthDay 2020 3 9) EQUALS NOTHING

§ `Reg 91(4) and (5) - sections 38 and 135, and interference with the systems (src:1694-1695)`

#ASSERT `reg 91(4) sections 38 and 135 of the Act apply to the declaration` TRUE
#ASSERT NOT (`reg 91(4) sections 38 and 135 of the Act apply to the declaration` FALSE)
#ASSERT `reg 91(5) the act is deemed to be an act or omission specified in subsections 38(1) and 135(1) of the Act` TRUE
#ASSERT NOT (`reg 91(5) the act is deemed to be an act or omission specified in subsections 38(1) and 135(1) of the Act` FALSE)
#ASSERT `reg 91(5) the penalty and the punishment include the right to refuse the person access to the electronic systems` TRUE
#ASSERT NOT (`reg 91(5) the penalty and the punishment include the right to refuse the person access to the electronic systems` FALSE)
