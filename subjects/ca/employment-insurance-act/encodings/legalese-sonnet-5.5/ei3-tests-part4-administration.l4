IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `ei3-part4-administration`

-- Tests of ei3-part4-administration.l4 (Act ss 97 to 102).
-- Expected values are hand-worked from the text of the section named beside each assertion. Every date is invented.

§ `s 97 administration`

#ASSERT `s 97(1) who administers the matter` TRUE EQUALS JUST `the Minister of National Revenue`
#ASSERT `s 97(1) who administers the matter` FALSE EQUALS NOTHING
#ASSERT `s 97(1) the Commissioner of Revenue may exercise the power and perform the duty` TRUE
#ASSERT NOT (`s 97(1) the Commissioner of Revenue may exercise the power and perform the duty` FALSE)
-- (2) Arguments: employed in the administration; designated by the Minister; in the course of employment; for the Act's purposes.
#ASSERT `s 97(2) the officer or employee may administer oaths and take and receive affidavits, declarations and solemn affirmations` TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 97(2) the officer or employee may administer oaths and take and receive affidavits, declarations and solemn affirmations` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`s 97(2) the officer or employee may administer oaths and take and receive affidavits, declarations and solemn affirmations` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 97(2) the officer or employee may administer oaths and take and receive affidavits, declarations and solemn affirmations` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 97(2) the officer or employee may administer oaths and take and receive affidavits, declarations and solemn affirmations` TRUE TRUE TRUE FALSE)
#ASSERT `s 97(2) the officer or employee has all the powers of a commissioner for administering oaths or taking affidavits` TRUE TRUE
#ASSERT NOT (`s 97(2) the officer or employee has all the powers of a commissioner for administering oaths or taking affidavits` FALSE TRUE)
#ASSERT NOT (`s 97(2) the officer or employee has all the powers of a commissioner for administering oaths or taking affidavits` TRUE FALSE)

§ `ss 98 and 99 Income Tax Act provisions`

#ASSERT `s 98(1) section 223 of the Income Tax Act applies to the amount` TRUE
#ASSERT NOT (`s 98(1) section 223 of the Income Tax Act applies to the amount` FALSE)
-- (2)(a): "after January 1, 1972": 2 January 1972 yes; 1 January 1972 and earlier no.
#ASSERT `s 98(2)(a) subsection (1) applies with respect to the certificate` (YMD 1972 1 2)
#ASSERT NOT (`s 98(2)(a) subsection (1) applies with respect to the certificate` (YMD 1972 1 1))
#ASSERT NOT (`s 98(2)(a) subsection (1) applies with respect to the certificate` (YMD 1971 12 31))
-- (2)(b): "after 1977": 1978 yes; 1977 no.
#ASSERT `s 98(2)(b) subsection (1) applies with respect to the document` 1978
#ASSERT NOT (`s 98(2)(b) subsection (1) applies with respect to the document` 1977)
-- (3): an action pending on 10 February 1988, or a decision given on or before that day.
#ASSERT `s 98(3) section 79 of the Unemployment Insurance Act, 1971, as it read immediately before September 13, 1988, continues to apply` TRUE NOTHING
#ASSERT `s 98(3) section 79 of the Unemployment Insurance Act, 1971, as it read immediately before September 13, 1988, continues to apply` FALSE (JUST (YMD 1988 2 10))
#ASSERT `s 98(3) section 79 of the Unemployment Insurance Act, 1971, as it read immediately before September 13, 1988, continues to apply` FALSE (JUST (YMD 1987 6 1))
#ASSERT NOT (`s 98(3) section 79 of the Unemployment Insurance Act, 1971, as it read immediately before September 13, 1988, continues to apply` FALSE (JUST (YMD 1988 2 11)))
#ASSERT NOT (`s 98(3) section 79 of the Unemployment Insurance Act, 1971, as it read immediately before September 13, 1988, continues to apply` FALSE NOTHING)
#ASSERT `s 99 the listed provisions of the Income Tax Act apply to the amount` TRUE
#ASSERT NOT (`s 99 the listed provisions of the Income Tax Act apply to the amount` FALSE)
#ASSERT `s 99(a) the reference in subsection 224(1.2) of the Income Tax Act to "subsection 227(10.1) or a similar provision" is read as a reference to` EQUALS "section 85 or 152.24, as the case may be, of the Employment Insurance Act"
#ASSERT `s 99(b) subsection 224(1.2) of the Income Tax Act applies to the amount` TRUE FALSE
#ASSERT NOT (`s 99(b) subsection 224(1.2) of the Income Tax Act applies to the amount` TRUE TRUE)
#ASSERT NOT (`s 99(b) subsection 224(1.2) of the Income Tax Act applies to the amount` FALSE FALSE)

§ `ss 100 and 101 cheques and corporations`

#ASSERT `s 100 the financial institution shall receive the cheque for deposit without charge for discount or commission` TRUE TRUE TRUE
#ASSERT NOT (`s 100 the financial institution shall receive the cheque for deposit without charge for discount or commission` FALSE TRUE TRUE)
#ASSERT NOT (`s 100 the financial institution shall receive the cheque for deposit without charge for discount or commission` TRUE FALSE TRUE)
#ASSERT NOT (`s 100 the financial institution shall receive the cheque for deposit without charge for discount or commission` TRUE TRUE FALSE)
#ASSERT `s 101 the document is signed for the corporation as required` TRUE TRUE FALSE
#ASSERT `s 101 the document is signed for the corporation as required` TRUE FALSE TRUE
#ASSERT NOT (`s 101 the document is signed for the corporation as required` TRUE FALSE FALSE)
#ASSERT NOT (`s 101 the document is signed for the corporation as required` FALSE TRUE TRUE)

§ `s 102(1) to (4) informations`

#ASSERT `s 102(1) the person may lay or make an information or complaint under this Part` TRUE FALSE FALSE
#ASSERT `s 102(1) the person may lay or make an information or complaint under this Part` FALSE TRUE FALSE
#ASSERT `s 102(1) the person may lay or make an information or complaint under this Part` FALSE FALSE TRUE
#ASSERT NOT (`s 102(1) the person may lay or make an information or complaint under this Part` FALSE FALSE FALSE)
#ASSERT `s 102(1) the information or complaint is deemed to have been laid or made by an authorized person` TRUE
#ASSERT NOT (`s 102(1) the information or complaint is deemed to have been laid or made by an authorized person` FALSE)
#ASSERT `s 102(1) the information or complaint may be called into question for lack of authority of the informant or complainant` TRUE
#ASSERT NOT (`s 102(1) the information or complaint may be called into question for lack of authority of the informant or complainant` FALSE)
#ASSERT `s 102(2) the information, complaint, warrant, conviction or other proceeding is objectionable or insufficient` TRUE EQUALS JUST FALSE
#ASSERT `s 102(2) the information, complaint, warrant, conviction or other proceeding is objectionable or insufficient` FALSE EQUALS NOTHING
-- (3) Any one connection to the judge's territory is enough.
#ASSERT `s 102(3) a provincial court judge may hear, try or determine the information or complaint although the matter did not arise within the jurisdiction` TRUE FALSE FALSE FALSE FALSE
#ASSERT `s 102(3) a provincial court judge may hear, try or determine the information or complaint although the matter did not arise within the jurisdiction` FALSE TRUE FALSE FALSE FALSE
#ASSERT `s 102(3) a provincial court judge may hear, try or determine the information or complaint although the matter did not arise within the jurisdiction` FALSE FALSE TRUE FALSE FALSE
#ASSERT `s 102(3) a provincial court judge may hear, try or determine the information or complaint although the matter did not arise within the jurisdiction` FALSE FALSE FALSE TRUE FALSE
#ASSERT `s 102(3) a provincial court judge may hear, try or determine the information or complaint although the matter did not arise within the jurisdiction` FALSE FALSE FALSE FALSE TRUE
#ASSERT NOT (`s 102(3) a provincial court judge may hear, try or determine the information or complaint although the matter did not arise within the jurisdiction` FALSE FALSE FALSE FALSE FALSE)
-- (4) The subject-matter arose on 15 March 2020: five years after is 15 March 2025, and that day is in time.
#ASSERT `s 102(4) the information or complaint is laid or made in time` (YMD 2020 3 15) (YMD 2025 3 15)
#ASSERT NOT (`s 102(4) the information or complaint is laid or made in time` (YMD 2020 3 15) (YMD 2025 3 16))
-- Arose 29 February 2020: the fifth anniversary clamps to 28 February 2025.
#ASSERT `s 102(4) the information or complaint is laid or made in time` (YMD 2020 2 29) (YMD 2025 2 28)
#ASSERT NOT (`s 102(4) the information or complaint is laid or made in time` (YMD 2020 2 29) (YMD 2025 3 1))

§ `s 102(5) to (10) affidavits of an officer of the Canada Revenue Agency`

-- (5) Arguments: provision for mailing; officer's affidavit; charge of records and knowledge; sent by registered letter on a named day; exhibits.
#ASSERT `s 102(5) the affidavit is evidence of the request, notice or demand and of its being sent` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 102(5) the affidavit is evidence of the request, notice or demand and of its being sent` FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`s 102(5) the affidavit is evidence of the request, notice or demand and of its being sent` TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`s 102(5) the affidavit is evidence of the request, notice or demand and of its being sent` TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 102(5) the affidavit is evidence of the request, notice or demand and of its being sent` TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 102(5) the affidavit is evidence of the request, notice or demand and of its being sent` TRUE TRUE TRUE TRUE FALSE)
-- (6) Same shape for personal service.
#ASSERT `s 102(6) the affidavit is evidence of the request, notice or demand and of its personal service` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 102(6) the affidavit is evidence of the request, notice or demand and of its personal service` FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`s 102(6) the affidavit is evidence of the request, notice or demand and of its personal service` TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`s 102(6) the affidavit is evidence of the request, notice or demand and of its personal service` TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 102(6) the affidavit is evidence of the request, notice or demand and of its personal service` TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 102(6) the affidavit is evidence of the request, notice or demand and of its personal service` TRUE TRUE TRUE TRUE FALSE)
-- (7) Failure to file.
#ASSERT `s 102(7) the affidavit is evidence that the person did not file or make it` TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 102(7) the affidavit is evidence that the person did not file or make it` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`s 102(7) the affidavit is evidence that the person did not file or make it` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 102(7) the affidavit is evidence that the person did not file or make it` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 102(7) the affidavit is evidence that the person did not file or make it` TRUE TRUE TRUE FALSE)
-- (8) Time of filing.
#ASSERT `s 102(8) the affidavit is evidence that it was filed or made on that day and not before` TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 102(8) the affidavit is evidence that it was filed or made on that day and not before` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`s 102(8) the affidavit is evidence that it was filed or made on that day and not before` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 102(8) the affidavit is evidence that it was filed or made on that day and not before` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 102(8) the affidavit is evidence that it was filed or made on that day and not before` TRUE TRUE TRUE FALSE)
-- (9), (10)
#ASSERT `s 102(9) the affidavit is evidence of the nature and contents of the document, admissible, with the same probative force as the original` TRUE TRUE TRUE
#ASSERT NOT (`s 102(9) the affidavit is evidence of the nature and contents of the document, admissible, with the same probative force as the original` FALSE TRUE TRUE)
#ASSERT NOT (`s 102(9) the affidavit is evidence of the nature and contents of the document, admissible, with the same probative force as the original` TRUE FALSE TRUE)
#ASSERT NOT (`s 102(9) the affidavit is evidence of the nature and contents of the document, admissible, with the same probative force as the original` TRUE TRUE FALSE)
#ASSERT `s 102(10) the affidavit is evidence of the statements contained in it` TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 102(10) the affidavit is evidence of the statements contained in it` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`s 102(10) the affidavit is evidence of the statements contained in it` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 102(10) the affidavit is evidence of the statements contained in it` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 102(10) the affidavit is evidence of the statements contained in it` TRUE TRUE TRUE FALSE)

§ `s 102(11) to (19) presumptions and deeming`

-- (11) Three things need not be proved; for any other matter the subsection says nothing.
#ASSERT `s 102(11) it is necessary to prove the matter` TRUE `ei3 the signature of the person making the affidavit` EQUALS JUST FALSE
#ASSERT `s 102(11) it is necessary to prove the matter` TRUE `ei3 that the person making the affidavit is an officer of the Canada Revenue Agency` EQUALS JUST FALSE
#ASSERT `s 102(11) it is necessary to prove the matter` TRUE `ei3 the signature or official character of the person before whom the affidavit was sworn` EQUALS JUST FALSE
#ASSERT `s 102(11) it is necessary to prove the matter` TRUE `ei3 any other matter` EQUALS NOTHING
#ASSERT `s 102(11) it is necessary to prove the matter` FALSE `ei3 the signature of the person making the affidavit` EQUALS NOTHING
#ASSERT `s 102(12) judicial notice shall be taken of the order without it being specially pleaded or proven` TRUE
#ASSERT NOT (`s 102(12) judicial notice shall be taken of the order without it being specially pleaded or proven` FALSE)
-- (13) Deemed signed, made and issued, unless called into question.
#ASSERT `s 102(13) the document is deemed to be a document signed, made and issued by that person` TRUE TRUE FALSE
#ASSERT NOT (`s 102(13) the document is deemed to be a document signed, made and issued by that person` TRUE TRUE TRUE)
#ASSERT NOT (`s 102(13) the document is deemed to be a document signed, made and issued by that person` FALSE TRUE FALSE)
#ASSERT NOT (`s 102(13) the document is deemed to be a document signed, made and issued by that person` TRUE FALSE FALSE)
-- (14) The day the notice is sent.
#ASSERT `s 102(14) the day on which the assessment is deemed to have been made` TRUE (YMD 2026 6 3) EQUALS JUST (YMD 2026 6 3)
#ASSERT `s 102(14) the day on which the assessment is deemed to have been made` FALSE (YMD 2026 6 3) EQUALS NOTHING
#ASSERT `s 102(15) the form is deemed to be a form authorized by the Minister under this Part` TRUE FALSE
#ASSERT NOT (`s 102(15) the form is deemed to be a form authorized by the Minister under this Part` TRUE TRUE)
#ASSERT NOT (`s 102(15) the form is deemed to be a form authorized by the Minister under this Part` FALSE FALSE)
-- (16), (17) Production is proof, in the absence of evidence to the contrary.
#ASSERT `s 102(16) the production is proof that it was filed, delivered, made or signed by or for the person charged` TRUE TRUE TRUE FALSE
#ASSERT NOT (`s 102(16) the production is proof that it was filed, delivered, made or signed by or for the person charged` TRUE TRUE TRUE TRUE)
#ASSERT NOT (`s 102(16) the production is proof that it was filed, delivered, made or signed by or for the person charged` FALSE TRUE TRUE FALSE)
#ASSERT NOT (`s 102(16) the production is proof that it was filed, delivered, made or signed by or for the person charged` TRUE FALSE TRUE FALSE)
#ASSERT NOT (`s 102(16) the production is proof that it was filed, delivered, made or signed by or for the person charged` TRUE TRUE FALSE FALSE)
#ASSERT `s 102(17) the production is proof that it was filed, delivered, made or signed by or for the employer` TRUE TRUE TRUE FALSE
#ASSERT NOT (`s 102(17) the production is proof that it was filed, delivered, made or signed by or for the employer` TRUE TRUE TRUE TRUE)
#ASSERT NOT (`s 102(17) the production is proof that it was filed, delivered, made or signed by or for the employer` FALSE TRUE TRUE FALSE)
#ASSERT NOT (`s 102(17) the production is proof that it was filed, delivered, made or signed by or for the employer` TRUE FALSE TRUE FALSE)
#ASSERT NOT (`s 102(17) the production is proof that it was filed, delivered, made or signed by or for the employer` TRUE TRUE FALSE FALSE)
-- (18)
#ASSERT `s 102(18) the affidavit is evidence of the statements contained in it` TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 102(18) the affidavit is evidence of the statements contained in it` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`s 102(18) the affidavit is evidence of the statements contained in it` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 102(18) the affidavit is evidence of the statements contained in it` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 102(18) the affidavit is evidence of the statements contained in it` TRUE TRUE TRUE FALSE)
-- (19)(a), (b): sent to the partnership at its address; else a limited partnership's unlimited member; else any member.
#ASSERT `s 102(19)(a) the reference is read as a reference to all the members of the partnership` TRUE
#ASSERT NOT (`s 102(19)(a) the reference is read as a reference to all the members of the partnership` FALSE)
#ASSERT `s 102(19)(b) the notice or other document is deemed to have been provided to each member of the partnership` TRUE FALSE FALSE FALSE
#ASSERT `s 102(19)(b) the notice or other document is deemed to have been provided to each member of the partnership` FALSE TRUE TRUE FALSE
#ASSERT `s 102(19)(b) the notice or other document is deemed to have been provided to each member of the partnership` FALSE FALSE FALSE TRUE
#ASSERT NOT (`s 102(19)(b) the notice or other document is deemed to have been provided to each member of the partnership` FALSE TRUE FALSE TRUE)
#ASSERT NOT (`s 102(19)(b) the notice or other document is deemed to have been provided to each member of the partnership` FALSE FALSE TRUE FALSE)
#ASSERT NOT (`s 102(19)(b) the notice or other document is deemed to have been provided to each member of the partnership` FALSE FALSE FALSE FALSE)
