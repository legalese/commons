IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `ei6-part-8-4-benefit`

-- Tests of ei6-part-8-4-benefit (Act ss 153.7 to 153.111, src:2807-2875). Expected values are read from the text by hand.
-- March 15, 2020 and September 27, 2020 are Sundays (the text itself calls September 27, 2020 "the week beginning").

§ `Section 153.7 - payment`

-- (1): payable to a claimant who makes a claim under section 153.8 and who is eligible (src:2807).
#ASSERT `s 153.7(1) the emergency response benefit is payable to the claimant` TRUE TRUE TRUE
#ASSERT NOT (`s 153.7(1) the emergency response benefit is payable to the claimant` FALSE TRUE TRUE)
#ASSERT NOT (`s 153.7(1) the emergency response benefit is payable to the claimant` TRUE FALSE TRUE)
#ASSERT NOT (`s 153.7(1) the emergency response benefit is payable to the claimant` TRUE TRUE FALSE)
-- (1.1): the Commission may pay in advance (src:2809).
#ASSERT `s 153.7(1.1) the Commission may pay the benefit before the customary time for paying it` TRUE
#ASSERT NOT (`s 153.7(1.1) the Commission may pay the benefit before the customary time for paying it` FALSE)
-- (2) and (3): receiving provincial money or financial aid changes nothing (src:2811, 2813).
#ASSERT `s 153.7(2) the claimant remains eligible despite provincial money or financial aid` TRUE TRUE
#ASSERT `s 153.7(2) the claimant remains eligible despite provincial money or financial aid` TRUE FALSE
#ASSERT NOT (`s 153.7(2) the claimant remains eligible despite provincial money or financial aid` FALSE TRUE)
#ASSERT `s 153.7(3) the claimant remains eligible despite financial aid under section 63` TRUE TRUE
#ASSERT NOT (`s 153.7(3) the claimant remains eligible despite financial aid under section 63` FALSE TRUE)

§ `Section 153.8 - the claim`

-- (1): a two-week period starting on a Sunday and falling within March 15 to October 3, 2020 (src:2815).
#ASSERT `s 153.8(1) the two-week period starts on a Sunday and falls within the period` (YMD 2020 3 15)
#ASSERT `s 153.8(1) the two-week period starts on a Sunday and falls within the period` (YMD 2020 3 22)
-- the last period that fits: September 20 to October 3.
#ASSERT `s 153.8(1) the two-week period starts on a Sunday and falls within the period` (YMD 2020 9 20)
-- September 27 to October 10 does not fall within (fork F-ei6-2).
#ASSERT NOT (`s 153.8(1) the two-week period starts on a Sunday and falls within the period` (YMD 2020 9 27))
-- a Sunday before the period, and days that are not Sundays.
#ASSERT NOT (`s 153.8(1) the two-week period starts on a Sunday and falls within the period` (YMD 2020 3 8))
#ASSERT NOT (`s 153.8(1) the two-week period starts on a Sunday and falls within the period` (YMD 2020 3 16))
#ASSERT NOT (`s 153.8(1) the two-week period starts on a Sunday and falls within the period` (YMD 2020 9 26))
#ASSERT `s 153.8(1) the claimant may make a claim for the two-week period` TRUE TRUE TRUE
#ASSERT NOT (`s 153.8(1) the claimant may make a claim for the two-week period` FALSE TRUE TRUE)
#ASSERT NOT (`s 153.8(1) the claimant may make a claim for the two-week period` TRUE FALSE TRUE)
#ASSERT NOT (`s 153.8(1) the claimant may make a claim for the two-week period` TRUE TRUE FALSE)
-- (1.1): the week beginning September 27, 2020 (src:2817).
#ASSERT NOT (`s 153.8(1.1) the benefit is not barred for the week` (YMD 2020 9 27) FALSE)
#ASSERT `s 153.8(1.1) the benefit is not barred for the week` (YMD 2020 9 27) TRUE
#ASSERT `s 153.8(1.1) the benefit is not barred for the week` (YMD 2020 9 20) FALSE
-- (2): no claim after December 2, 2020 (src:2819).
#ASSERT `s 153.8(2) the claim is made in time` (YMD 2020 12 1)
#ASSERT `s 153.8(2) the claim is made in time` (YMD 2020 12 2)
#ASSERT NOT (`s 153.8(2) the claim is made in time` (YMD 2020 12 3))
-- (3), (4): the duties to give the Minister the information the Minister requires (src:2821, 2823).
#ASSERT `s 153.8(3) the claimant must provide the Minister with the information` TRUE
#ASSERT NOT (`s 153.8(3) the claimant must provide the Minister with the information` FALSE)
#ASSERT `s 153.8(4) the employer must provide the Minister with the information` TRUE
#ASSERT NOT (`s 153.8(4) the employer must provide the Minister with the information` FALSE)
-- (5), (6): no benefit period for a benefit in 153.5(3)(a) beginning March 15 to September 26, 2020, nor September 27 to
-- October 3 if the benefit was paid before September 27 and the maximum weeks has not been claimed (src:2825-2829).
#ASSERT `s 153.8(5) and (6) no benefit period is to be established` (YMD 2020 3 15) TRUE FALSE 0 28
#ASSERT `s 153.8(5) and (6) no benefit period is to be established` (YMD 2020 9 26) TRUE FALSE 0 28
#ASSERT NOT (`s 153.8(5) and (6) no benefit period is to be established` (YMD 2020 3 14) TRUE FALSE 0 28)
#ASSERT `s 153.8(5) and (6) no benefit period is to be established` (YMD 2020 9 27) TRUE TRUE 27 28
#ASSERT NOT (`s 153.8(5) and (6) no benefit period is to be established` (YMD 2020 9 27) TRUE TRUE 28 28)
#ASSERT NOT (`s 153.8(5) and (6) no benefit period is to be established` (YMD 2020 9 27) TRUE FALSE 5 28)
#ASSERT `s 153.8(5) and (6) no benefit period is to be established` (YMD 2020 10 3) TRUE TRUE 10 28
#ASSERT NOT (`s 153.8(5) and (6) no benefit period is to be established` (YMD 2020 10 4) TRUE TRUE 10 28)
#ASSERT NOT (`s 153.8(5) and (6) no benefit period is to be established` (YMD 2020 6 1) FALSE TRUE 10 28)
-- (7): on receiving a claim the Commission shall decide and notify (src:2831).
#ASSERT `s 153.8(7) the Commission must decide whether the claimant is eligible and whether the benefit is payable, and notify the claimant` TRUE
#ASSERT NOT (`s 153.8(7) the Commission must decide whether the claimant is eligible and whether the benefit is payable, and notify the claimant` FALSE)

§ `Section 153.9 - eligibility`

-- (1)(a)(iii): at least $5,000 in 2019 or in the 52 weeks preceding the claim (src:2837).
#ASSERT `s 153.9(1)(a)(iii) insurable earnings of at least $5,000` 5000 0
#ASSERT `s 153.9(1)(a)(iii) insurable earnings of at least $5,000` 0 5000
#ASSERT `s 153.9(1)(a)(iii) insurable earnings of at least $5,000` 4000 5001
#ASSERT NOT (`s 153.9(1)(a)(iii) insurable earnings of at least $5,000` 4999.99 4999.99)
-- (3): leaving voluntarily is not ceasing to work (src:2857).
#ASSERT `s 153.9(3) the claimant ceases working for the purpose of subsection (1)` TRUE FALSE
#ASSERT NOT (`s 153.9(3) the claimant ceases working for the purpose of subsection (1)` TRUE TRUE)
#ASSERT NOT (`s 153.9(3) the claimant ceases working for the purpose of subsection (1)` FALSE FALSE)
-- (4): income of more than nothing and not more than $1,000 over four weeks is deemed to meet the requirements (src:2859).
#ASSERT NOT (`s 153.9(4) the claimant is deemed to meet the requirements on ceasing work and on income` 0)
#ASSERT `s 153.9(4) the claimant is deemed to meet the requirements on ceasing work and on income` 0.01
#ASSERT `s 153.9(4) the claimant is deemed to meet the requirements on ceasing work and on income` 1000
#ASSERT NOT (`s 153.9(4) the claimant is deemed to meet the requirements on ceasing work and on income` 1000.01)
-- (1)(a): resides in Canada, at least 15, earnings of $5,000, ceases working 7 consecutive days, no income (src:2833-2839).
#ASSERT `s 153.9(1)(a) eligible as a claimant who ceases working` TRUE 15 TRUE TRUE 7 0 FALSE
#ASSERT NOT (`s 153.9(1)(a) eligible as a claimant who ceases working` FALSE 15 TRUE TRUE 7 0 FALSE)
#ASSERT NOT (`s 153.9(1)(a) eligible as a claimant who ceases working` TRUE 14 TRUE TRUE 7 0 FALSE)
#ASSERT NOT (`s 153.9(1)(a) eligible as a claimant who ceases working` TRUE 15 FALSE TRUE 7 0 FALSE)
#ASSERT NOT (`s 153.9(1)(a) eligible as a claimant who ceases working` TRUE 15 TRUE FALSE 7 0 FALSE)
#ASSERT NOT (`s 153.9(1)(a) eligible as a claimant who ceases working` TRUE 15 TRUE TRUE 6 0 FALSE)
#ASSERT NOT (`s 153.9(1)(a) eligible as a claimant who ceases working` TRUE 15 TRUE TRUE 7 1 FALSE)
-- deemed by (4) to meet (iv) and (v), but the other conditions still apply.
#ASSERT `s 153.9(1)(a) eligible as a claimant who ceases working` TRUE 40 TRUE FALSE 3 500 TRUE
#ASSERT NOT (`s 153.9(1)(a) eligible as a claimant who ceases working` FALSE 40 TRUE FALSE 3 500 TRUE)
-- (1)(b): a claimant of 153.5(2)(b) with no income for 7 consecutive days (src:2840).
#ASSERT `s 153.9(1)(b) eligible as a claimant who could have had a benefit period established` TRUE 7 FALSE
#ASSERT NOT (`s 153.9(1)(b) eligible as a claimant who could have had a benefit period established` TRUE 6 FALSE)
#ASSERT `s 153.9(1)(b) eligible as a claimant who could have had a benefit period established` TRUE 6 TRUE
#ASSERT NOT (`s 153.9(1)(b) eligible as a claimant who could have had a benefit period established` FALSE 14 FALSE)
-- (1)(c): a claimant of 153.5(2)(c) or (d) who resides in Canada, is at least 15, has $5,000 and no income (src:2841-2845).
#ASSERT `s 153.9(1)(c) eligible as a claimant who is unable to start working` TRUE TRUE 15 TRUE 7 FALSE
#ASSERT NOT (`s 153.9(1)(c) eligible as a claimant who is unable to start working` FALSE TRUE 15 TRUE 7 FALSE)
#ASSERT NOT (`s 153.9(1)(c) eligible as a claimant who is unable to start working` TRUE FALSE 15 TRUE 7 FALSE)
#ASSERT NOT (`s 153.9(1)(c) eligible as a claimant who is unable to start working` TRUE TRUE 14 TRUE 7 FALSE)
#ASSERT NOT (`s 153.9(1)(c) eligible as a claimant who is unable to start working` TRUE TRUE 15 FALSE 7 FALSE)
#ASSERT NOT (`s 153.9(1)(c) eligible as a claimant who is unable to start working` TRUE TRUE 15 TRUE 6 FALSE)
#ASSERT `s 153.9(1)(c) eligible as a claimant who is unable to start working` TRUE TRUE 15 TRUE 6 TRUE
-- (1): the three paragraphs are alternatives.
#ASSERT `s 153.9(1) the claimant meets the conditions of eligibility` TRUE FALSE FALSE
#ASSERT `s 153.9(1) the claimant meets the conditions of eligibility` FALSE TRUE FALSE
#ASSERT `s 153.9(1) the claimant meets the conditions of eligibility` FALSE FALSE TRUE
#ASSERT NOT (`s 153.9(1) the claimant meets the conditions of eligibility` FALSE FALSE FALSE)
-- (5), (6): deemed eligible despite (2)(c) or (d), unless the Commission has informed the Minister (src:2861, 2863).
#ASSERT `s 153.9(5) the claimant is deemed to have been eligible despite paragraph (2)(c)` TRUE TRUE FALSE
#ASSERT NOT (`s 153.9(5) the claimant is deemed to have been eligible despite paragraph (2)(c)` TRUE TRUE TRUE)
#ASSERT NOT (`s 153.9(5) the claimant is deemed to have been eligible despite paragraph (2)(c)` FALSE TRUE FALSE)
#ASSERT NOT (`s 153.9(5) the claimant is deemed to have been eligible despite paragraph (2)(c)` TRUE FALSE FALSE)
#ASSERT `s 153.9(6) the claimant is deemed to have been eligible despite paragraph (2)(d)` TRUE TRUE FALSE
#ASSERT NOT (`s 153.9(6) the claimant is deemed to have been eligible despite paragraph (2)(d)` TRUE TRUE TRUE)
-- (2), (2.1): the grounds of ineligibility. Arguments: other benefit; provincial pregnancy; provincial new-born; CERB;
-- deemed (5); CESB; deemed (6); a later benefit period.
#ASSERT `s 153.9(2) a ground of ineligibility applies to the claimant` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE
#ASSERT `s 153.9(2) a ground of ineligibility applies to the claimant` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE
#ASSERT `s 153.9(2) a ground of ineligibility applies to the claimant` FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE
#ASSERT `s 153.9(2) a ground of ineligibility applies to the claimant` FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE
#ASSERT `s 153.9(2) a ground of ineligibility applies to the claimant` FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE
#ASSERT `s 153.9(2) a ground of ineligibility applies to the claimant` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE
#ASSERT NOT (`s 153.9(2) a ground of ineligibility applies to the claimant` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
-- CERB or CESB received, but lifted by (5) or (6): no ground.
#ASSERT NOT (`s 153.9(2) a ground of ineligibility applies to the claimant` FALSE FALSE FALSE TRUE TRUE FALSE FALSE FALSE)
#ASSERT NOT (`s 153.9(2) a ground of ineligibility applies to the claimant` FALSE FALSE FALSE FALSE FALSE TRUE TRUE FALSE)
-- (1) with (2): eligible if the conditions are met and no ground applies.
#ASSERT `s 153.9 the claimant is eligible for the emergency response benefit` TRUE FALSE
#ASSERT NOT (`s 153.9 the claimant is eligible for the emergency response benefit` TRUE TRUE)
#ASSERT NOT (`s 153.9 the claimant is eligible for the emergency response benefit` FALSE FALSE)

§ `Sections 153.10 and 153.11 - amount and maximum weeks`

#ASSERT `s 153.10(1) the amount of the emergency response benefit for a week` EQUALS 500
-- (2) and (3): provincial assistance does not reduce it; the family supplement is added (an input).
#ASSERT `s 153.10 the amount of the emergency response benefit for a week, with the family supplement` TRUE 0 EQUALS 500
#ASSERT `s 153.10 the amount of the emergency response benefit for a week, with the family supplement` FALSE 0 EQUALS 500
#ASSERT `s 153.10 the amount of the emergency response benefit for a week, with the family supplement` FALSE 125 EQUALS 625
-- 153.11: 28 minus the weeks of CERB or CESB (src:2871).
#ASSERT `s 153.11 the maximum number of weeks for which the emergency response benefit may be paid` 0 EQUALS JUST 28
#ASSERT `s 153.11 the maximum number of weeks for which the emergency response benefit may be paid` 5 EQUALS JUST 23
#ASSERT `s 153.11 the maximum number of weeks for which the emergency response benefit may be paid` 28 EQUALS JUST 0
-- more than 28 such weeks: the text gives a negative number and does not answer (fork F-ei6-6).
#ASSERT `s 153.11 the maximum number of weeks for which the emergency response benefit may be paid` 29 EQUALS NOTHING
#ASSERT `s 153.11 the benefit may still be paid for another week` 27 0 EQUALS JUST TRUE
#ASSERT `s 153.11 the benefit may still be paid for another week` 28 0 EQUALS JUST FALSE
#ASSERT `s 153.11 the benefit may still be paid for another week` 22 5 EQUALS JUST TRUE
#ASSERT `s 153.11 the benefit may still be paid for another week` 23 5 EQUALS JUST FALSE
#ASSERT `s 153.11 the benefit may still be paid for another week` 0 29 EQUALS NOTHING

§ `Section 153.111 - the Employment Insurance Operating Account`

#ASSERT `s 153.111 the amount to be credited to the Employment Insurance Operating Account` 1000000 EQUALS 1000000
