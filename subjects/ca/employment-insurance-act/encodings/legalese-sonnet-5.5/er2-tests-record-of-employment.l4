IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `er2-record-of-employment`

-- Tests of er2-record-of-employment (regulations 19 to 21). Every expected value is written by hand from the text of the regulation
-- named beside it and was decided before the run; none is copied from the encoding's output. One #ASSERT per line.
-- The dates are 2026 dates picked for their arithmetic: 2026 is not a leap year, so 26 February plus 5 days is 3 March.

§ `Regulation 19(1) - employer`

-- args: is an employer, has been an employer, sponsor/co-ordinator individual, question concerns their remuneration, bankrupt employer, trustee
#ASSERT     `reg 19(1) employer for the purposes of subsections (2) to (4)` TRUE FALSE FALSE FALSE FALSE FALSE
-- s 2(1) "employer" includes a person who has been an employer
#ASSERT     `reg 19(1) employer for the purposes of subsections (2) to (4)` FALSE TRUE FALSE FALSE FALSE FALSE
-- reg 19(1): includes a bankrupt employer
#ASSERT     `reg 19(1) employer for the purposes of subsections (2) to (4)` FALSE FALSE FALSE FALSE TRUE FALSE
-- reg 19(1): includes the trustee of a bankrupt employer
#ASSERT     `reg 19(1) employer for the purposes of subsections (2) to (4)` FALSE FALSE FALSE FALSE FALSE TRUE
-- s 2(1) "employer": the sponsor individual counts only for their own remuneration
#ASSERT     `reg 19(1) employer for the purposes of subsections (2) to (4)` FALSE FALSE TRUE TRUE FALSE FALSE
#ASSERT NOT (`reg 19(1) employer for the purposes of subsections (2) to (4)` FALSE FALSE TRUE FALSE FALSE FALSE)
#ASSERT NOT (`reg 19(1) employer for the purposes of subsections (2) to (4)` FALSE FALSE FALSE FALSE FALSE FALSE)

§ `Regulation 19(2) - the duty to complete a record of employment`

#ASSERT     `reg 19(2) a record of employment must be completed in respect of the person` TRUE TRUE TRUE
#ASSERT NOT (`reg 19(2) a record of employment must be completed in respect of the person` FALSE TRUE TRUE)
#ASSERT NOT (`reg 19(2) a record of employment must be completed in respect of the person` TRUE FALSE TRUE)
#ASSERT NOT (`reg 19(2) a record of employment must be completed in respect of the person` TRUE TRUE FALSE)

§ `Regulation 19(3) - paper copies`

-- (a): five days after the LATER of the first day of the interruption (Mon 2 Mar) and the day the employer becomes aware (Wed 4 Mar): 9 Mar.
#ASSERT `reg 19(3)(a) the last day for delivering the employee's copy to the insured person` (YMD 2026 3 2) (YMD 2026 3 4) EQUALS YMD 2026 3 9
-- the first day is the later one: 10 Mar plus 5 is 15 Mar
#ASSERT `reg 19(3)(a) the last day for delivering the employee's copy to the insured person` (YMD 2026 3 10) (YMD 2026 3 4) EQUALS YMD 2026 3 15
-- the same day twice: plus 5
#ASSERT `reg 19(3)(a) the last day for delivering the employee's copy to the insured person` (YMD 2026 3 4) (YMD 2026 3 4) EQUALS YMD 2026 3 9
-- across a month end: 26 Feb plus 5 is 3 Mar
#ASSERT `reg 19(3)(a) the last day for delivering the employee's copy to the insured person` (YMD 2026 2 25) (YMD 2026 2 26) EQUALS YMD 2026 3 3
-- "not later than": delivery on the last day is in time, the day after is not
#ASSERT     `reg 19(3)(a) the employee's copy was delivered in time` (YMD 2026 3 2) (YMD 2026 3 4) (YMD 2026 3 9)
#ASSERT NOT (`reg 19(3)(a) the employee's copy was delivered in time` (YMD 2026 3 2) (YMD 2026 3 4) (YMD 2026 3 10))
#ASSERT     `reg 19(3)(a) the employee's copy was delivered in time` (YMD 2026 3 2) (YMD 2026 3 4) (YMD 2026 3 3)
-- (b): the Commission's copy is due within the time limit set out in paragraph (a)
#ASSERT     `reg 19(3)(b) the Commission's copy was sent in time` (YMD 2026 3 2) (YMD 2026 3 4) (YMD 2026 3 9)
#ASSERT NOT (`reg 19(3)(b) the Commission's copy was sent in time` (YMD 2026 3 2) (YMD 2026 3 4) (YMD 2026 3 10))
-- (c): kept and retained
#ASSERT     `reg 19(3)(c) the employer's copy has been kept and retained` TRUE
#ASSERT NOT (`reg 19(3)(c) the employer's copy has been kept and retained` FALSE)

§ `Regulation 19(3.1) - electronic record of employment`

-- args: last day of the pay period in which the interruption began, first day of the interruption, pay periods per year
-- 12 pay periods (monthly): (i) 31 Mar plus 5 is 5 Apr; (ii) 10 Mar plus 15 is 25 Mar; the EARLIER, 25 Mar
#ASSERT `reg 19(3.1)(a) the last day for sending the electronic record of employment to the Commission` (YMD 2026 3 31) (YMD 2026 3 10) 12 EQUALS YMD 2026 3 25
-- exactly 13 pay periods: "13 or fewer", so limb (ii) is still a candidate
#ASSERT `reg 19(3.1)(a) the last day for sending the electronic record of employment to the Commission` (YMD 2026 3 31) (YMD 2026 3 10) 13 EQUALS YMD 2026 3 25
-- 14 pay periods: limb (ii) is not a candidate, so only limb (i): 5 Apr
#ASSERT `reg 19(3.1)(a) the last day for sending the electronic record of employment to the Commission` (YMD 2026 3 31) (YMD 2026 3 10) 14 EQUALS YMD 2026 4 5
#ASSERT `reg 19(3.1)(a) the last day for sending the electronic record of employment to the Commission` (YMD 2026 3 31) (YMD 2026 3 10) 52 EQUALS YMD 2026 4 5
-- limb (i) earlier than limb (ii): pay period ends Sat 7 Mar, interruption begins Thu 5 Mar: (i) 12 Mar, (ii) 20 Mar
#ASSERT `reg 19(3.1)(a) the last day for sending the electronic record of employment to the Commission` (YMD 2026 3 7) (YMD 2026 3 5) 12 EQUALS YMD 2026 3 12
#ASSERT `reg 19(3.1)(a) the last day for sending the electronic record of employment to the Commission` (YMD 2026 3 7) (YMD 2026 3 5) 26 EQUALS YMD 2026 3 12
-- in time on the last day, late the day after
#ASSERT     `reg 19(3.1)(a) the electronic record of employment was sent in time` (YMD 2026 3 31) (YMD 2026 3 10) 12 (YMD 2026 3 25)
#ASSERT NOT (`reg 19(3.1)(a) the electronic record of employment was sent in time` (YMD 2026 3 31) (YMD 2026 3 10) 12 (YMD 2026 3 26))
#ASSERT     `reg 19(3.1)(a) the electronic record of employment was sent in time` (YMD 2026 3 31) (YMD 2026 3 10) 14 (YMD 2026 4 5)
#ASSERT NOT (`reg 19(3.1)(a) the electronic record of employment was sent in time` (YMD 2026 3 31) (YMD 2026 3 10) 14 (YMD 2026 4 6))
#ASSERT     `reg 19(3.1)(b) the electronic record of employment has been kept and retained` TRUE
#ASSERT NOT (`reg 19(3.1)(b) the electronic record of employment has been kept and retained` FALSE)

§ `Regulation 19(4) - an employee's copy that cannot be delivered`

-- args: unable for reasons beyond the employer's control, knows the mailing address
#ASSERT `reg 19(4) what the employer must do with the employee's copy` TRUE TRUE EQUALS `er2 mail the copy to the insured person`
#ASSERT `reg 19(4) what the employer must do with the employee's copy` TRUE FALSE EQUALS `er2 retain the copy until the earliest of the Commission's request, the person's request and 52 weeks after completion`
#ASSERT `reg 19(4) what the employer must do with the employee's copy` FALSE TRUE EQUALS `er2 regulation 19(4) does not apply because delivery was not prevented for reasons beyond the employer's control`
#ASSERT `reg 19(4) what the employer must do with the employee's copy` FALSE FALSE EQUALS `er2 regulation 19(4) does not apply because delivery was not prevented for reasons beyond the employer's control`
-- (b): completed Mon 5 Jan 2026; 52 weeks is 364 days, so 4 Jan 2027; no request, so that day
#ASSERT `reg 19(4)(b) the day on which the employer may stop retaining the copy` (YMD 2026 1 5) NOTHING NOTHING EQUALS YMD 2027 1 4
-- the Commission asks on 1 Jun 2026: that comes first
#ASSERT `reg 19(4)(b) the day on which the employer may stop retaining the copy` (YMD 2026 1 5) (JUST (YMD 2026 6 1)) NOTHING EQUALS YMD 2026 6 1
-- the person asks on 3 Mar 2026 and the Commission on 1 Jun 2026: the person's request is first
#ASSERT `reg 19(4)(b) the day on which the employer may stop retaining the copy` (YMD 2026 1 5) (JUST (YMD 2026 6 1)) (JUST (YMD 2026 3 3)) EQUALS YMD 2026 3 3
-- the person asks only on 1 Mar 2027, after 52 weeks have elapsed: the 52 weeks come first
#ASSERT `reg 19(4)(b) the day on which the employer may stop retaining the copy` (YMD 2026 1 5) NOTHING (JUST (YMD 2027 3 1)) EQUALS YMD 2027 1 4

§ `Regulation 19(5) - the person's statement of hours and earnings`

-- args: failed to deliver to the person, failed to deliver to the Commission, employer not available, employer unable (records destroyed or lost),
-- the person applies for benefits, the person has applied for benefits
#ASSERT     `reg 19(5) the person may provide a statement of their hours of insurable employment and insurable earnings` TRUE FALSE FALSE FALSE TRUE FALSE
#ASSERT     `reg 19(5) the person may provide a statement of their hours of insurable employment and insurable earnings` FALSE TRUE FALSE FALSE TRUE FALSE
#ASSERT     `reg 19(5) the person may provide a statement of their hours of insurable employment and insurable earnings` FALSE FALSE TRUE FALSE TRUE FALSE
#ASSERT     `reg 19(5) the person may provide a statement of their hours of insurable employment and insurable earnings` FALSE FALSE FALSE TRUE TRUE FALSE
-- "on becoming a claimant": a person who has already applied is a claimant too (s 2(1) "claimant")
#ASSERT     `reg 19(5) the person may provide a statement of their hours of insurable employment and insurable earnings` TRUE FALSE FALSE FALSE FALSE TRUE
-- not yet a claimant: no
#ASSERT NOT (`reg 19(5) the person may provide a statement of their hours of insurable employment and insurable earnings` TRUE TRUE TRUE TRUE FALSE FALSE)
-- no failure at all: no
#ASSERT NOT (`reg 19(5) the person may provide a statement of their hours of insurable employment and insurable earnings` FALSE FALSE FALSE FALSE TRUE TRUE)

§ `Regulation 19(6) - a bankrupt employer's records`

-- args: bankrupt employer, trustee, not provided to the insured person, not provided to the Commission
#ASSERT     `reg 19(6) the hours of insurable employment and insurable earnings are determined from the payroll and personnel records of the bankrupt employer` TRUE FALSE TRUE FALSE
#ASSERT     `reg 19(6) the hours of insurable employment and insurable earnings are determined from the payroll and personnel records of the bankrupt employer` FALSE TRUE FALSE TRUE
#ASSERT     `reg 19(6) the hours of insurable employment and insurable earnings are determined from the payroll and personnel records of the bankrupt employer` TRUE FALSE TRUE TRUE
-- provided to both: the Commission has nothing to determine
#ASSERT NOT (`reg 19(6) the hours of insurable employment and insurable earnings are determined from the payroll and personnel records of the bankrupt employer` TRUE FALSE FALSE FALSE)
-- an employer that is neither bankrupt nor a trustee: not this provision
#ASSERT NOT (`reg 19(6) the hours of insurable employment and insurable earnings are determined from the payroll and personnel records of the bankrupt employer` FALSE FALSE TRUE TRUE)

§ `Regulations 20 and 21 - what a record of employment reports`

#ASSERT     `reg 20 the hours reported are the hours determined under Part I` 840 840
#ASSERT NOT (`reg 20 the hours reported are the hours determined under Part I` 840 839)
#ASSERT     `reg 21 the insurable earnings reported are the insurable earnings determined and allocated` 4200.50 4200.50
#ASSERT NOT (`reg 21 the insurable earnings reported are the insurable earnings determined and allocated` 4200.50 4200)
