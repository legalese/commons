IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `ei7-related-nouns`
IMPORT `ei7-related-2012-tribunal`

-- Tests of ei7-related-2012-tribunal. Every expected value is written by hand from the text of 2012, c. 19, ss. 251 to
-- 270 (src:3694-3761); none is copied from the encoding's output.

§ `Section 251 - the definitions`

#ASSERT `Act RP 2012 c. 19 s. 251 board of referees` TRUE TRUE
#ASSERT NOT (`Act RP 2012 c. 19 s. 251 board of referees` TRUE FALSE)
#ASSERT NOT (`Act RP 2012 c. 19 s. 251 board of referees` FALSE TRUE)
#ASSERT `Act RP 2012 c. 19 s. 251 Pension Appeals Board` TRUE TRUE
#ASSERT NOT (`Act RP 2012 c. 19 s. 251 Pension Appeals Board` TRUE FALSE)
#ASSERT `Act RP 2012 c. 19 s. 251 Review Tribunal` TRUE TRUE
#ASSERT NOT (`Act RP 2012 c. 19 s. 251 Review Tribunal` FALSE TRUE)
#ASSERT `Act RP 2012 c. 19 s. 251 Social Security Tribunal` TRUE
#ASSERT NOT (`Act RP 2012 c. 19 s. 251 Social Security Tribunal` FALSE)
#ASSERT `Act RP 2012 c. 19 s. 251 umpire` TRUE TRUE
#ASSERT NOT (`Act RP 2012 c. 19 s. 251 umpire` TRUE FALSE)

§ `Section 252 - information to be transferred`

#ASSERT `Act RP 2012 c. 19 s. 252 the body must transfer the information to the Social Security Tribunal` `ei7 the Pension Appeals Board` TRUE FALSE
#ASSERT `Act RP 2012 c. 19 s. 252 the body must transfer the information to the Social Security Tribunal` `ei7 a Review Tribunal` FALSE TRUE
#ASSERT `Act RP 2012 c. 19 s. 252 the body must transfer the information to the Social Security Tribunal` `ei7 the board of referees` TRUE TRUE
#ASSERT `Act RP 2012 c. 19 s. 252 the body must transfer the information to the Social Security Tribunal` `ei7 an umpire` TRUE FALSE
-- neither limb of the information is made out.
#ASSERT NOT (`Act RP 2012 c. 19 s. 252 the body must transfer the information to the Social Security Tribunal` `ei7 an umpire` FALSE FALSE)
-- a body that the section does not name.
#ASSERT NOT (`Act RP 2012 c. 19 s. 252 the body must transfer the information to the Social Security Tribunal` `ei7 the Social Security Tribunal` TRUE TRUE)
#ASSERT NOT (`Act RP 2012 c. 19 s. 252 the body must transfer the information to the Social Security Tribunal` `ei7 the General Division of the Social Security Tribunal` TRUE TRUE)

§ `Section 265 - appeals to the board of referees`

-- (1) filed under the old subsection 114(1), filed the day before April 1, 2013 and not decided before it.
#ASSERT `Act RP 2012 c. 19 s. 265(1) the board of referees remains seized of the appeal` TRUE (YMD 2013 3 31) FALSE
-- filed on April 1, 2013: not "before April 1, 2013".
#ASSERT NOT (`Act RP 2012 c. 19 s. 265(1) the board of referees remains seized of the appeal` TRUE (YMD 2013 4 1) FALSE)
-- decided before April 1, 2013.
#ASSERT NOT (`Act RP 2012 c. 19 s. 265(1) the board of referees remains seized of the appeal` TRUE (YMD 2013 3 31) TRUE)
-- not an appeal under the old subsection 114(1).
#ASSERT NOT (`Act RP 2012 c. 19 s. 265(1) the board of referees remains seized of the appeal` FALSE (YMD 2013 3 31) FALSE)
-- (2) October 31, 2013; with an order fixing November 30, 2013 (made-up day), the day before that.
#ASSERT `Act RP 2012 c. 19 s. 265(2) the last day on which the board of referees must make its decision` NOTHING EQUALS YMD 2013 10 31
#ASSERT `Act RP 2012 c. 19 s. 265(2) the last day on which the board of referees must make its decision` (JUST (YMD 2013 12 1)) EQUALS YMD 2013 11 30
#ASSERT `Act RP 2012 c. 19 s. 265(2) the last day on which the board of referees must make its decision` (JUST (YMD 2013 9 1)) EQUALS YMD 2013 8 31
-- (3) no decision by the last day: the General Division becomes seized.
#ASSERT `Act RP 2012 c. 19 s. 265(3) the body that becomes seized of the appeal` TRUE (YMD 2013 3 1) FALSE NOTHING NOTHING EQUALS JUST `ei7 the General Division of the Social Security Tribunal`
-- decided on October 31, 2013 (the last day, included): the board decided in time.
#ASSERT `Act RP 2012 c. 19 s. 265(3) the body that becomes seized of the appeal` TRUE (YMD 2013 3 1) FALSE (JUST (YMD 2013 10 31)) NOTHING EQUALS NOTHING
-- decided on November 1, 2013: too late, so no decision "by the day".
#ASSERT `Act RP 2012 c. 19 s. 265(3) the body that becomes seized of the appeal` TRUE (YMD 2013 3 1) FALSE (JUST (YMD 2013 11 1)) NOTHING EQUALS JUST `ei7 the General Division of the Social Security Tribunal`
-- an order fixing September 1, 2013: the last day is August 31, 2013.
#ASSERT `Act RP 2012 c. 19 s. 265(3) the body that becomes seized of the appeal` TRUE (YMD 2013 3 1) FALSE (JUST (YMD 2013 8 31)) (JUST (YMD 2013 9 1)) EQUALS NOTHING
#ASSERT `Act RP 2012 c. 19 s. 265(3) the body that becomes seized of the appeal` TRUE (YMD 2013 3 1) FALSE (JUST (YMD 2013 9 1)) (JUST (YMD 2013 9 1)) EQUALS JUST `ei7 the General Division of the Social Security Tribunal`
-- the board never was seized (decided before April 1, 2013).
#ASSERT `Act RP 2012 c. 19 s. 265(3) the body that becomes seized of the appeal` TRUE (YMD 2013 3 1) TRUE NOTHING NOTHING EQUALS NOTHING
#ASSERT `Act RP 2012 c. 19 s. 265(3) the day on which the appeal is deemed to have been filed with the General Division` NOTHING EQUALS YMD 2013 11 1
#ASSERT `Act RP 2012 c. 19 s. 265(3) the day on which the appeal is deemed to have been filed with the General Division` (JUST (YMD 2013 9 1)) EQUALS YMD 2013 9 1
-- (4)
#ASSERT `Act RP 2012 c. 19 s. 265(4) the body to which the person may appeal the decision` TRUE TRUE EQUALS JUST `ei7 the Appeal Division of the Social Security Tribunal`
#ASSERT `Act RP 2012 c. 19 s. 265(4) the body to which the person may appeal the decision` FALSE TRUE EQUALS NOTHING
#ASSERT `Act RP 2012 c. 19 s. 265(4) the body to which the person may appeal the decision` TRUE FALSE EQUALS NOTHING

§ `Section 266 - an appeal that could have gone to an umpire`

#ASSERT `Act RP 2012 c. 19 s. 266 the body to which the appeal may be appealed` TRUE TRUE EQUALS JUST `ei7 the Appeal Division of the Social Security Tribunal`
#ASSERT `Act RP 2012 c. 19 s. 266 the body to which the appeal may be appealed` TRUE FALSE EQUALS NOTHING
#ASSERT `Act RP 2012 c. 19 s. 266 the body to which the appeal may be appealed` FALSE TRUE EQUALS NOTHING

§ `Section 267 - appeals to an umpire`

-- (1) filed and heard before April 1, 2013.
#ASSERT `Act RP 2012 c. 19 s. 267(1) the umpire remains seized of the appeal` TRUE (YMD 2013 3 1) (JUST (YMD 2013 3 31))
#ASSERT NOT (`Act RP 2012 c. 19 s. 267(1) the umpire remains seized of the appeal` TRUE (YMD 2013 3 1) (JUST (YMD 2013 4 1)))
-- not yet heard: section 268 governs it instead.
#ASSERT NOT (`Act RP 2012 c. 19 s. 267(1) the umpire remains seized of the appeal` TRUE (YMD 2013 3 1) NOTHING)
#ASSERT NOT (`Act RP 2012 c. 19 s. 267(1) the umpire remains seized of the appeal` TRUE (YMD 2013 4 1) (JUST (YMD 2013 3 31)))
#ASSERT NOT (`Act RP 2012 c. 19 s. 267(1) the umpire remains seized of the appeal` FALSE (YMD 2013 3 1) (JUST (YMD 2013 3 31)))
-- (2)
#ASSERT `Act RP 2012 c. 19 s. 267(2) the last day on which the umpire must make the decision` EQUALS YMD 2014 3 31
-- (3) no decision: the Appeal Division becomes seized; decided on March 31, 2014 is in time; April 1, 2014 is late.
#ASSERT `Act RP 2012 c. 19 s. 267(3) the Appeal Division becomes seized of the appeal` TRUE (YMD 2013 3 1) (JUST (YMD 2013 3 15)) NOTHING
#ASSERT NOT (`Act RP 2012 c. 19 s. 267(3) the Appeal Division becomes seized of the appeal` TRUE (YMD 2013 3 1) (JUST (YMD 2013 3 15)) (JUST (YMD 2014 3 31)))
#ASSERT `Act RP 2012 c. 19 s. 267(3) the Appeal Division becomes seized of the appeal` TRUE (YMD 2013 3 1) (JUST (YMD 2013 3 15)) (JUST (YMD 2014 4 1))
-- the umpire never was seized.
#ASSERT NOT (`Act RP 2012 c. 19 s. 267(3) the Appeal Division becomes seized of the appeal` TRUE (YMD 2013 3 1) NOTHING NOTHING)
#ASSERT `Act RP 2012 c. 19 s. 267(3) the day on which the Appeal Division is deemed to have granted leave to appeal` TRUE EQUALS JUST (YMD 2014 4 1)
#ASSERT `Act RP 2012 c. 19 s. 267(3) the day on which the Appeal Division is deemed to have granted leave to appeal` FALSE EQUALS NOTHING

§ `Section 268 - appeals not heard before April 1, 2013`

#ASSERT `Act RP 2012 c. 19 s. 268 the day on which the Appeal Division is deemed to have granted leave to appeal` TRUE (YMD 2013 3 31) FALSE EQUALS JUST (YMD 2013 4 1)
#ASSERT `Act RP 2012 c. 19 s. 268 the day on which the Appeal Division is deemed to have granted leave to appeal` TRUE (YMD 2013 3 31) TRUE EQUALS NOTHING
#ASSERT `Act RP 2012 c. 19 s. 268 the day on which the Appeal Division is deemed to have granted leave to appeal` TRUE (YMD 2013 4 1) FALSE EQUALS NOTHING
#ASSERT `Act RP 2012 c. 19 s. 268 the day on which the Appeal Division is deemed to have granted leave to appeal` FALSE (YMD 2013 3 31) FALSE EQUALS NOTHING

§ `Section 269 - requests for reconsideration`

#ASSERT `Act RP 2012 c. 19 s. 269 the division of the Social Security Tribunal whose decision the application is deemed to relate to` `ei7 the board of referees` EQUALS JUST `ei7 the General Division of the Social Security Tribunal`
#ASSERT `Act RP 2012 c. 19 s. 269 the division of the Social Security Tribunal whose decision the application is deemed to relate to` `ei7 an umpire` EQUALS JUST `ei7 the Appeal Division of the Social Security Tribunal`
#ASSERT `Act RP 2012 c. 19 s. 269 the division of the Social Security Tribunal whose decision the application is deemed to relate to` `ei7 the Pension Appeals Board` EQUALS NOTHING
#ASSERT `Act RP 2012 c. 19 s. 269 the division of the Social Security Tribunal whose decision the application is deemed to relate to` `ei7 the Appeal Division of the Social Security Tribunal` EQUALS NOTHING
-- (1) the request is deemed an application made on April 1, 2013.
#ASSERT `Act RP 2012 c. 19 s. 269(1) the day on which the request is deemed to have been made as an application under section 66` TRUE FALSE EQUALS JUST (YMD 2013 4 1)
#ASSERT `Act RP 2012 c. 19 s. 269(1) the day on which the request is deemed to have been made as an application under section 66` TRUE TRUE EQUALS NOTHING
#ASSERT `Act RP 2012 c. 19 s. 269(1) the day on which the request is deemed to have been made as an application under section 66` FALSE FALSE EQUALS NOTHING
#ASSERT `Act RP 2012 c. 19 s. 269(1) the division whose decision the deemed application relates to` TRUE FALSE `ei7 the board of referees` EQUALS JUST `ei7 the General Division of the Social Security Tribunal`
#ASSERT `Act RP 2012 c. 19 s. 269(1) the division whose decision the deemed application relates to` TRUE FALSE `ei7 an umpire` EQUALS JUST `ei7 the Appeal Division of the Social Security Tribunal`
#ASSERT `Act RP 2012 c. 19 s. 269(1) the division whose decision the deemed application relates to` TRUE TRUE `ei7 an umpire` EQUALS NOTHING
-- (2) an application made after March 31, 2013.
#ASSERT `Act RP 2012 c. 19 s. 269(2) the division whose decision the application is deemed to relate to` (YMD 2013 4 1) `ei7 the board of referees` EQUALS JUST `ei7 the General Division of the Social Security Tribunal`
#ASSERT `Act RP 2012 c. 19 s. 269(2) the division whose decision the application is deemed to relate to` (YMD 2013 4 1) `ei7 an umpire` EQUALS JUST `ei7 the Appeal Division of the Social Security Tribunal`
#ASSERT `Act RP 2012 c. 19 s. 269(2) the division whose decision the application is deemed to relate to` (YMD 2013 3 31) `ei7 an umpire` EQUALS NOTHING

§ `Section 270 - continued application`

#ASSERT `Act RP 2012 c. 19 s. 270 the provisions repealed by that Act and their related regulations continue to apply to the appeal` TRUE
#ASSERT NOT (`Act RP 2012 c. 19 s. 270 the provisions repealed by that Act and their related regulations continue to apply to the appeal` FALSE)
