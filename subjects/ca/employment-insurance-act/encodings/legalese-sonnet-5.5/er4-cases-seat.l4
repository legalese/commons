#ASSERT `May the Canada Revenue Agency and the Minister of National Revenue disclose my information to my province` FALSE TRUE TRUE TRUE
#ASSERT `May the Canada Revenue Agency and the Minister of National Revenue disclose my information to my province` TRUE TRUE TRUE TRUE
#ASSERT NOT `May the Canada Revenue Agency and the Minister of National Revenue disclose my information to my province` FALSE TRUE FALSE TRUE
#ASSERT NOT `May the Canada Revenue Agency and the Minister of National Revenue disclose my information to my province` TRUE FALSE TRUE TRUE
