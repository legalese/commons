IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `ei3-part4-regulations`

-- Tests of ei3-part4-regulations.l4 (Act s 108).
-- Expected values are hand-worked from the text of the section named beside each assertion.

§ `s 108(1)(c) the penalty a regulation may prescribe`

-- The greater of $100 and $25 a day, to a maximum of $2,500.
#ASSERT `s 108(1)(c) the penalty a regulation may prescribe for non-compliance with regulations made under paragraph (a) or (b)` 0 EQUALS 100
#ASSERT `s 108(1)(c) the penalty a regulation may prescribe for non-compliance with regulations made under paragraph (a) or (b)` 1 EQUALS 100
#ASSERT `s 108(1)(c) the penalty a regulation may prescribe for non-compliance with regulations made under paragraph (a) or (b)` 4 EQUALS 100
#ASSERT `s 108(1)(c) the penalty a regulation may prescribe for non-compliance with regulations made under paragraph (a) or (b)` 5 EQUALS 125
#ASSERT `s 108(1)(c) the penalty a regulation may prescribe for non-compliance with regulations made under paragraph (a) or (b)` 100 EQUALS 2_500
#ASSERT `s 108(1)(c) the penalty a regulation may prescribe for non-compliance with regulations made under paragraph (a) or (b)` 101 EQUALS 2_500
#ASSERT `s 108(1)(c) the penalty a regulation may prescribe for non-compliance with regulations made under paragraph (a) or (b)` 400 EQUALS 2_500

§ `s 108(1.1) to (4) the Minister's powers`

#ASSERT `s 108(1.1) the officer may exercise the powers or perform the duties of the Minister under this Part` TRUE
#ASSERT NOT (`s 108(1.1) the officer may exercise the powers or perform the duties of the Minister under this Part` FALSE)
#ASSERT `s 108(2) the Minister may approve another method of defining and determining insurable earnings and determining the premiums payable` TRUE
#ASSERT NOT (`s 108(2) the Minister may approve another method of defining and determining insurable earnings and determining the premiums payable` FALSE)
#ASSERT `s 108(3) the Minister may at any time alter or rescind the approved method` TRUE
#ASSERT NOT (`s 108(3) the Minister may at any time alter or rescind the approved method` FALSE)
-- (4) Published 1 May 2026: effective then, or on the earlier or later day the regulations specify.
#ASSERT `s 108(4) the day on which the regulation takes effect` TRUE (YearMonthDay 2026 5 1) NOTHING EQUALS JUST (YearMonthDay 2026 5 1)
#ASSERT `s 108(4) the day on which the regulation takes effect` TRUE (YearMonthDay 2026 5 1) (JUST (YearMonthDay 2026 4 1)) EQUALS JUST (YearMonthDay 2026 4 1)
#ASSERT `s 108(4) the day on which the regulation takes effect` TRUE (YearMonthDay 2026 5 1) (JUST (YearMonthDay 2026 6 1)) EQUALS JUST (YearMonthDay 2026 6 1)
#ASSERT `s 108(4) the day on which the regulation takes effect` FALSE (YearMonthDay 2026 5 1) NOTHING EQUALS NOTHING
