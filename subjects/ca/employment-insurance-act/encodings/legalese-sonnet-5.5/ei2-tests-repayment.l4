IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `ei2-nouns`
IMPORT `ei2-repayment`

-- Tests of ei2-repayment (ss 42 to 47). Expected values are written by hand from the text.

§ `s 42 - not assignable; recovery; deduction`

-- (1) an attempt to assign benefits is void
#ASSERT `s 42(1) a transaction appearing to assign, charge, attach, anticipate or give benefits as security is void` TRUE TRUE FALSE EQUALS JUST TRUE
-- "Subject to subsections (2) and (3)": a recovery or deduction under them is not such a void transaction
#ASSERT `s 42(1) a transaction appearing to assign, charge, attach, anticipate or give benefits as security is void` TRUE TRUE TRUE EQUALS NOTHING
-- not about benefits, or not such a transaction: the subsection says nothing
#ASSERT `s 42(1) a transaction appearing to assign, charge, attach, anticipate or give benefits as security is void` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 42(1) a transaction appearing to assign, charge, attach, anticipate or give benefits as security is void` TRUE FALSE FALSE EQUALS NOTHING
-- (2)
#ASSERT `s 42(2) the amount may be recovered out of the benefits payable to the person` TRUE TRUE TRUE
#ASSERT NOT `s 42(2) the amount may be recovered out of the benefits payable to the person` FALSE TRUE TRUE
#ASSERT NOT `s 42(2) the amount may be recovered out of the benefits payable to the person` TRUE FALSE TRUE
#ASSERT NOT `s 42(2) the amount may be recovered out of the benefits payable to the person` TRUE TRUE FALSE
-- (3) an advance of $300 paid by a province for a week, benefits then payable for that week, the person had consented
#ASSERT `s 42(3) the Commission may deduct from the benefits and pay to the government or authority` TRUE TRUE TRUE TRUE
#ASSERT NOT `s 42(3) the Commission may deduct from the benefits and pay to the government or authority` FALSE TRUE TRUE TRUE
#ASSERT NOT `s 42(3) the Commission may deduct from the benefits and pay to the government or authority` TRUE FALSE TRUE TRUE
#ASSERT NOT `s 42(3) the Commission may deduct from the benefits and pay to the government or authority` TRUE TRUE FALSE TRUE
-- no consent on or before receiving it
#ASSERT NOT `s 42(3) the Commission may deduct from the benefits and pay to the government or authority` TRUE TRUE TRUE FALSE
#ASSERT `s 42(3) the amount the Commission may deduct and pay` TRUE 300 EQUALS JUST 300
#ASSERT `s 42(3) the amount the Commission may deduct and pay` FALSE 300 EQUALS NOTHING

§ `ss 43 to 45 - repayment`

#ASSERT `s 43 the claimant is liable to repay the amount` TRUE FALSE
#ASSERT `s 43 the claimant is liable to repay the amount` FALSE TRUE
#ASSERT NOT `s 43 the claimant is liable to repay the amount` FALSE FALSE
#ASSERT `s 43 the amount the claimant is liable to repay` TRUE 1200 EQUALS 1200
#ASSERT `s 43 the amount the claimant is liable to repay` FALSE 1200 EQUALS 0
-- 44: the amount disentitled plus the excess
#ASSERT `s 44 the amount the person shall return without delay` 500 0 EQUALS 500
#ASSERT `s 44 the amount the person shall return without delay` 0 80 EQUALS 80
#ASSERT `s 44 the amount the person shall return without delay` 500 80 EQUALS 580
#ASSERT `s 44 the amount the person shall return without delay` 0 0 EQUALS 0
-- 45: benefits received for a period, later earnings for the same period paid; $750 of benefits would not have been paid
#ASSERT `s 45 the amount the claimant shall pay to the Receiver General` TRUE TRUE TRUE 750 EQUALS 750
-- the earnings are not paid (only liable to pay)
#ASSERT `s 45 the amount the claimant shall pay to the Receiver General` TRUE TRUE FALSE 750 EQUALS 0
#ASSERT `s 45 the amount the claimant shall pay to the Receiver General` TRUE FALSE TRUE 750 EQUALS 0
#ASSERT `s 45 the amount the claimant shall pay to the Receiver General` FALSE TRUE TRUE 750 EQUALS 0

§ `s 46 and s 46.01 - employers`

#ASSERT `s 46(1) the amount to deduct from the earnings payable to the claimant and remit to the Receiver General` TRUE TRUE 750 EQUALS 750
#ASSERT `s 46(1) the amount to deduct from the earnings payable to the claimant and remit to the Receiver General` TRUE FALSE 750 EQUALS 0
#ASSERT `s 46(1) the amount to deduct from the earnings payable to the claimant and remit to the Receiver General` FALSE TRUE 750 EQUALS 0
#ASSERT `s 46(2) the amount the employer shall remit to the Receiver General` TRUE TRUE 400 EQUALS 400
#ASSERT `s 46(2) the amount the employer shall remit to the Receiver General` TRUE FALSE 400 EQUALS 0
#ASSERT `s 46(2) the amount the employer shall remit to the Receiver General` FALSE TRUE 400 EQUALS 0
-- 46.01: lay-off on 15 January 2020; more than 36 months have elapsed from 16 January 2023; and the Commission's opinion
#ASSERT `s 46.01 no amount is payable under section 45 or deductible under subsection 46(1)` (YearMonthDay 2020 1 15) (YearMonthDay 2023 1 16) TRUE
#ASSERT NOT `s 46.01 no amount is payable under section 45 or deductible under subsection 46(1)` (YearMonthDay 2020 1 15) (YearMonthDay 2023 1 15) TRUE
#ASSERT NOT `s 46.01 no amount is payable under section 45 or deductible under subsection 46(1)` (YearMonthDay 2020 1 15) (YearMonthDay 2023 1 16) FALSE

§ `s 46.1 - directors`

-- (2)(a) a certificate registered and execution returned unsatisfied
#ASSERT `s 46.1(2) a condition of the directors' liability is met` TRUE TRUE FALSE (YearMonthDay 2024 1 1) FALSE (YearMonthDay 2024 1 1) NOTHING
#ASSERT NOT `s 46.1(2) a condition of the directors' liability is met` TRUE FALSE FALSE (YearMonthDay 2024 1 1) FALSE (YearMonthDay 2024 1 1) NOTHING
#ASSERT NOT `s 46.1(2) a condition of the directors' liability is met` FALSE TRUE FALSE (YearMonthDay 2024 1 1) FALSE (YearMonthDay 2024 1 1) NOTHING
-- (2)(b) liquidation commenced on 1 March 2024 (the earlier date); claim proved on 1 September 2024 (six months later): in time; 2 September: not
#ASSERT `s 46.1(2) a condition of the directors' liability is met` FALSE FALSE TRUE (YearMonthDay 2024 3 1) FALSE (YearMonthDay 2024 1 1) (JUST (YearMonthDay 2024 9 1))
#ASSERT NOT `s 46.1(2) a condition of the directors' liability is met` FALSE FALSE TRUE (YearMonthDay 2024 3 1) FALSE (YearMonthDay 2024 1 1) (JUST (YearMonthDay 2024 9 2))
-- (2)(b) no claim proved
#ASSERT NOT `s 46.1(2) a condition of the directors' liability is met` FALSE FALSE TRUE (YearMonthDay 2024 3 1) FALSE (YearMonthDay 2024 1 1) NOTHING
-- (2)(c) assignment on 30 August 2024: six months later is 28 February 2025 (the clamp), 1 March 2025 is out
#ASSERT `s 46.1(2) a condition of the directors' liability is met` FALSE FALSE FALSE (YearMonthDay 2024 3 1) TRUE (YearMonthDay 2024 8 30) (JUST (YearMonthDay 2025 2 28))
#ASSERT NOT `s 46.1(2) a condition of the directors' liability is met` FALSE FALSE FALSE (YearMonthDay 2024 3 1) TRUE (YearMonthDay 2024 8 30) (JUST (YearMonthDay 2025 3 1))
-- (3) due diligence
#ASSERT `s 46.1(3) the director is not liable by reason of due diligence` TRUE
#ASSERT NOT `s 46.1(3) the director is not liable by reason of due diligence` FALSE
-- (4) act on 10 June 2018: six years on is 10 June 2024
#ASSERT `s 46.1(4) the action or proceedings may be commenced` (YearMonthDay 2018 6 10) (YearMonthDay 2024 6 10)
#ASSERT NOT `s 46.1(4) the action or proceedings may be commenced` (YearMonthDay 2018 6 10) (YearMonthDay 2024 6 11)
-- (1) all the elements
#ASSERT `s 46.1(1) the director is jointly and severally liable, together with the corporation, to pay the penalty` TRUE TRUE TRUE FALSE TRUE
#ASSERT NOT `s 46.1(1) the director is jointly and severally liable, together with the corporation, to pay the penalty` FALSE TRUE TRUE FALSE TRUE
#ASSERT NOT `s 46.1(1) the director is jointly and severally liable, together with the corporation, to pay the penalty` TRUE FALSE TRUE FALSE TRUE
#ASSERT NOT `s 46.1(1) the director is jointly and severally liable, together with the corporation, to pay the penalty` TRUE TRUE FALSE FALSE TRUE
#ASSERT NOT `s 46.1(1) the director is jointly and severally liable, together with the corporation, to pay the penalty` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT `s 46.1(1) the director is jointly and severally liable, together with the corporation, to pay the penalty` TRUE TRUE TRUE FALSE FALSE
-- (5)
#ASSERT `s 46.1(5) the amount recoverable from a director` TRUE 4000 EQUALS JUST 4000
#ASSERT `s 46.1(5) the amount recoverable from a director` FALSE 4000 EQUALS NOTHING
-- (6), (7)
#ASSERT `s 46.1(6)(a) the director is entitled to any preference that Her Majesty in right of Canada would have been entitled to` TRUE EQUALS JUST TRUE
#ASSERT `s 46.1(6)(a) the director is entitled to any preference that Her Majesty in right of Canada would have been entitled to` FALSE EQUALS NOTHING
#ASSERT `s 46.1(6)(b) the director is entitled to an assignment of the certificate` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 46.1(6)(b) the director is entitled to an assignment of the certificate` TRUE FALSE EQUALS NOTHING
#ASSERT `s 46.1(7) the director is entitled to contribution from the other director` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 46.1(7) the director is entitled to contribution from the other director` TRUE FALSE EQUALS NOTHING

§ `s 47 - debts to the Crown`

#ASSERT `s 47(1) the amount is a debt due to Her Majesty` TRUE EQUALS JUST TRUE
#ASSERT `s 47(1) the amount is a debt due to Her Majesty` FALSE EQUALS NOTHING
#ASSERT `s 47(2) the amount of the indebtedness may be deducted and retained out of the benefits` TRUE TRUE
#ASSERT NOT `s 47(2) the amount of the indebtedness may be deducted and retained out of the benefits` TRUE FALSE
#ASSERT NOT `s 47(2) the amount of the indebtedness may be deducted and retained out of the benefits` FALSE TRUE
-- (3) liability arose on 1 March 2020: 72 months on is 1 March 2026
#ASSERT `s 47(3) the amount may still be recovered` (YearMonthDay 2020 3 1) 0 (YearMonthDay 2026 3 1)
#ASSERT NOT `s 47(3) the amount may still be recovered` (YearMonthDay 2020 3 1) 0 (YearMonthDay 2026 3 2)
-- (4) an appeal pending for 100 days within the period: the limit moves 100 days later, from 1 March 2026 to 9 June 2026
#ASSERT `s 47(3) the amount may still be recovered` (YearMonthDay 2020 3 1) 100 (YearMonthDay 2026 6 9)
#ASSERT NOT `s 47(3) the amount may still be recovered` (YearMonthDay 2020 3 1) 100 (YearMonthDay 2026 6 10)
