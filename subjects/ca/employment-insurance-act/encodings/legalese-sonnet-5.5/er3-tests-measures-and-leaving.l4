IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `er3-nouns`
IMPORT `er3-outside-canada`
IMPORT `er3-measures-and-leaving`

-- Tests of er3-measures-and-leaving (regulations 50, 51 and 51.1). Every expected value is written by hand from
-- the text of regs 50, 51 and 51.1 (SOR-96-332.txt lines 760-784) before the module was run.

§ `reg 50 -- employment measures`

-- (a) a 59(b) measure established to help participants start businesses (i) or give work experience (ii).
#ASSERT `reg 50(a) an employment support measure referred to in paragraph 59(b) of the Act that is prescribed` TRUE TRUE FALSE EQUALS TRUE
#ASSERT `reg 50(a) an employment support measure referred to in paragraph 59(b) of the Act that is prescribed` TRUE FALSE TRUE EQUALS TRUE
#ASSERT `reg 50(a) an employment support measure referred to in paragraph 59(b) of the Act that is prescribed` TRUE FALSE FALSE EQUALS FALSE
#ASSERT `reg 50(a) an employment support measure referred to in paragraph 59(b) of the Act that is prescribed` FALSE TRUE TRUE EQUALS FALSE
-- (b) the same for a measure that is the subject of an agreement under s 63.
#ASSERT `reg 50(b) a measure that is the subject of an agreement under section 63 of the Act that is prescribed` TRUE TRUE FALSE EQUALS TRUE
#ASSERT `reg 50(b) a measure that is the subject of an agreement under section 63 of the Act that is prescribed` TRUE FALSE TRUE EQUALS TRUE
#ASSERT `reg 50(b) a measure that is the subject of an agreement under section 63 of the Act that is prescribed` TRUE FALSE FALSE EQUALS FALSE
#ASSERT `reg 50(b) a measure that is the subject of an agreement under section 63 of the Act that is prescribed` FALSE TRUE TRUE EQUALS FALSE
-- (a) or (b).
#ASSERT `reg 50 the measure is prescribed for the purposes of subparagraph 25(1)(b)(i) of the Act` TRUE FALSE TRUE FALSE EQUALS TRUE
#ASSERT `reg 50 the measure is prescribed for the purposes of subparagraph 25(1)(b)(i) of the Act` FALSE TRUE FALSE TRUE EQUALS TRUE
#ASSERT `reg 50 the measure is prescribed for the purposes of subparagraph 25(1)(b)(i) of the Act` FALSE FALSE TRUE TRUE EQUALS FALSE
#ASSERT `reg 50 the measure is prescribed for the purposes of subparagraph 25(1)(b)(i) of the Act` TRUE FALSE FALSE FALSE EQUALS FALSE

§ `reg 51 -- work-force reduction process`

-- (2) a process with all four features.
#ASSERT `reg 51(2) employer work-force reduction process` TRUE TRUE TRUE TRUE EQUALS TRUE
#ASSERT `reg 51(2) employer work-force reduction process` FALSE TRUE TRUE TRUE EQUALS FALSE
#ASSERT `reg 51(2) employer work-force reduction process` TRUE FALSE TRUE TRUE EQUALS FALSE
#ASSERT `reg 51(2) employer work-force reduction process` TRUE TRUE FALSE TRUE EQUALS FALSE
#ASSERT `reg 51(2) employer work-force reduction process` TRUE TRUE TRUE FALSE EQUALS FALSE
-- (1) left under such a process that preserves co-workers' jobs, accepted the offer, the employer confirmed.
#ASSERT `reg 51(1) benefits may be paid notwithstanding section 30 of the Act to a claimant who left under a work-force reduction process` TRUE TRUE TRUE TRUE TRUE EQUALS TRUE
#ASSERT `reg 51(1) benefits may be paid notwithstanding section 30 of the Act to a claimant who left under a work-force reduction process` FALSE TRUE TRUE TRUE TRUE EQUALS FALSE
#ASSERT `reg 51(1) benefits may be paid notwithstanding section 30 of the Act to a claimant who left under a work-force reduction process` TRUE FALSE TRUE TRUE TRUE EQUALS FALSE
#ASSERT `reg 51(1) benefits may be paid notwithstanding section 30 of the Act to a claimant who left under a work-force reduction process` TRUE TRUE FALSE TRUE TRUE EQUALS FALSE
#ASSERT `reg 51(1) benefits may be paid notwithstanding section 30 of the Act to a claimant who left under a work-force reduction process` TRUE TRUE TRUE FALSE TRUE EQUALS FALSE
#ASSERT `reg 51(1) benefits may be paid notwithstanding section 30 of the Act to a claimant who left under a work-force reduction process` TRUE TRUE TRUE TRUE FALSE EQUALS FALSE

§ `reg 51.1 -- prescribed circumstances`

-- (a) cohabiting since 2026-01-15: a year is complete on 2027-01-15, so leaving on 2027-01-14 is within "less than one year".
#ASSERT `reg 51.1(a) an obligation to accompany a partner of less than one year to another residence` TRUE (YearMonthDay 2026 1 15) (YearMonthDay 2026 9 1) TRUE FALSE FALSE EQUALS TRUE
#ASSERT `reg 51.1(a) an obligation to accompany a partner of less than one year to another residence` TRUE (YearMonthDay 2026 1 15) (YearMonthDay 2027 1 14) TRUE FALSE FALSE EQUALS TRUE
#ASSERT `reg 51.1(a) an obligation to accompany a partner of less than one year to another residence` TRUE (YearMonthDay 2026 1 15) (YearMonthDay 2027 1 15) TRUE FALSE FALSE EQUALS FALSE
-- (ii) and (iii) alone are enough; none of (i) to (iii) is not.
#ASSERT `reg 51.1(a) an obligation to accompany a partner of less than one year to another residence` TRUE (YearMonthDay 2026 1 15) (YearMonthDay 2026 9 1) FALSE TRUE FALSE EQUALS TRUE
#ASSERT `reg 51.1(a) an obligation to accompany a partner of less than one year to another residence` TRUE (YearMonthDay 2026 1 15) (YearMonthDay 2026 9 1) FALSE FALSE TRUE EQUALS TRUE
#ASSERT `reg 51.1(a) an obligation to accompany a partner of less than one year to another residence` TRUE (YearMonthDay 2026 1 15) (YearMonthDay 2026 9 1) FALSE FALSE FALSE EQUALS FALSE
#ASSERT `reg 51.1(a) an obligation to accompany a partner of less than one year to another residence` FALSE (YearMonthDay 2026 1 15) (YearMonthDay 2026 9 1) TRUE TRUE TRUE EQUALS FALSE
-- (b) an obligation to care for a member of the immediate family (reg 55(2)): a spouse, not a grandparent.
#ASSERT `reg 51.1(b) an obligation to care for a member of the immediate family` TRUE `er3 the claimant's spouse or common-law partner` EQUALS TRUE
#ASSERT `reg 51.1(b) an obligation to care for a member of the immediate family` TRUE `er3 a grandparent of the claimant or of the claimant's spouse or common-law partner` EQUALS FALSE
#ASSERT `reg 51.1(b) an obligation to care for a member of the immediate family` FALSE `er3 the claimant's spouse or common-law partner` EQUALS FALSE
-- "include": an open list; a circumstance outside it is not decided.
#ASSERT `reg 51.1 other reasonable circumstances include the circumstance` TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 51.1 other reasonable circumstances include the circumstance` FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 51.1 other reasonable circumstances include the circumstance` FALSE FALSE EQUALS NOTHING
