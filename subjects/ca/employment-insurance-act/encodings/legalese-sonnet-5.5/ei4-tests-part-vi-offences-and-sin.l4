IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `ei4-part-vi-offences-and-sin`

-- Tests of ei4-part-vi-offences-and-sin.l4 (Act ss 135 to 143). Expected values are written by hand from the text of the section;
-- none is copied from the module's output. Calendar arithmetic is done on a calendar.

§ `Fixtures: conduct under section 135(1)`

-- The record is built positionally; the ruler names the columns in the order of the DECLARE (paragraphs (a), (b), (b.1), (c), (d), (e), (f), (g)).
--
--                                                                                         (a)    (b)    (b.1)  (c)    (d)    (e)    (f)    (g)
`conduct: nothing alleged`                  MEANS `ei4 Conduct alleged under section 135(1)` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`conduct: a false representation (a)`       MEANS `ei4 Conduct alleged under section 135(1)` OF TRUE,  FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`conduct: false information (b)`            MEANS `ei4 Conduct alleged under section 135(1)` OF FALSE, TRUE,  FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`conduct: undeclared earnings (b.1)`        MEANS `ei4 Conduct alleged under section 135(1)` OF FALSE, FALSE, TRUE,  FALSE, FALSE, FALSE, FALSE, FALSE
`conduct: a claim hiding facts (c)`         MEANS `ei4 Conduct alleged under section 135(1)` OF FALSE, FALSE, FALSE, TRUE,  FALSE, FALSE, FALSE, FALSE
`conduct: negotiating a warrant (d)`        MEANS `ei4 Conduct alleged under section 135(1)` OF FALSE, FALSE, FALSE, FALSE, TRUE,  FALSE, FALSE, FALSE
`conduct: keeping a warrant (e)`            MEANS `ei4 Conduct alleged under section 135(1)` OF FALSE, FALSE, FALSE, FALSE, FALSE, TRUE,  FALSE, FALSE
`conduct: importing a document (f)`         MEANS `ei4 Conduct alleged under section 135(1)` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE,  FALSE
`conduct: acquiescing in one of those (g)`  MEANS `ei4 Conduct alleged under section 135(1)` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE

§ `s 135(1) -- the offence`

-- 135(1): each of paragraphs (a) to (g) is enough on its own.
#ASSERT `s 135(1) the person is guilty of an offence punishable on summary conviction` `conduct: a false representation (a)`
#ASSERT `s 135(1) the person is guilty of an offence punishable on summary conviction` `conduct: false information (b)`
#ASSERT `s 135(1) the person is guilty of an offence punishable on summary conviction` `conduct: undeclared earnings (b.1)`
#ASSERT `s 135(1) the person is guilty of an offence punishable on summary conviction` `conduct: a claim hiding facts (c)`
#ASSERT `s 135(1) the person is guilty of an offence punishable on summary conviction` `conduct: negotiating a warrant (d)`
#ASSERT `s 135(1) the person is guilty of an offence punishable on summary conviction` `conduct: keeping a warrant (e)`
#ASSERT `s 135(1) the person is guilty of an offence punishable on summary conviction` `conduct: importing a document (f)`
#ASSERT `s 135(1) the person is guilty of an offence punishable on summary conviction` `conduct: acquiescing in one of those (g)`
-- 135(1): none of them: no offence under this subsection (FALSE says only that s 135(1) does not make it one).
#ASSERT NOT `s 135(1) the person is guilty of an offence punishable on summary conviction` `conduct: nothing alleged`

§ `s 135(2) -- saving`

-- 135(2): no prosecution if a penalty for that offence has been imposed under section 38, 39 or 65.1.
#ASSERT NOT `s 135(2) a prosecution for the offence may be instituted` TRUE
#ASSERT `s 135(2) a prosecution for the offence may be instituted` FALSE

§ `s 135(3) -- punishment`

-- 135(3)(a): a fine of not less than $200 and not more than $5,000 (plus an addition); (b): imprisonment of not more than six months.
#ASSERT `s 135(3)(a) the least fine` EQUALS 200
#ASSERT `s 135(3)(a) the greatest fine before any addition` EQUALS 5000
#ASSERT `s 135(3)(b) the longest term of imprisonment, in months` EQUALS 6
-- 135(3)(a)(i): not more than double the total of the amount the benefits were reduced by (1000) and the amount that would have been paid (3000): 2 x 4000.
#ASSERT `s 135(3)(a)(i) the greatest addition in a case under paragraph (1)(b.1)` 1000 3000 EQUALS 8000
-- 135(3)(a)(ii): not more than double the amount of benefits that may have been paid (2500).
#ASSERT `s 135(3)(a)(ii) the greatest addition in any other appropriate case` 2500 EQUALS 5000
-- 135(3)(a): a (b.1) case: 5000 + 8000.
#ASSERT `s 135(3)(a) the greatest fine` TRUE FALSE 1000 3000 2500 EQUALS 13000
-- 135(3)(a): a (b.1) case is governed by (i) even if the court would also call it appropriate: (ii) is for "any other" case.
#ASSERT `s 135(3)(a) the greatest fine` TRUE TRUE 1000 3000 2500 EQUALS 13000
-- 135(3)(a): any other appropriate case: 5000 + 2 x 2500.
#ASSERT `s 135(3)(a) the greatest fine` FALSE TRUE 0 0 2500 EQUALS 10000
-- 135(3)(a): neither a (b.1) case nor an appropriate one: nothing is added.
#ASSERT `s 135(3)(a) the greatest fine` FALSE FALSE 0 0 2500 EQUALS 5000
-- 135(3): a fine of 200 is the least allowed, with no imprisonment.
#ASSERT `s 135(3) the punishment is within the limits` 200 0 5000
-- 135(3): 199 is below the least fine.
#ASSERT NOT `s 135(3) the punishment is within the limits` 199 0 5000
-- 135(3): a fine equal to the greatest fine is allowed; one dollar more is not.
#ASSERT `s 135(3) the punishment is within the limits` 5000 0 5000
#ASSERT NOT `s 135(3) the punishment is within the limits` 5001 0 5000
-- 135(3): with the addition in a (b.1) case, a fine of 13000 is within the limit of 13000 and 13001 is not.
#ASSERT `s 135(3) the punishment is within the limits` 13000 0 13000
#ASSERT NOT `s 135(3) the punishment is within the limits` 13001 0 13000
-- 135(3)(b): imprisonment of six months with the fine is allowed; seven months is not.
#ASSERT `s 135(3) the punishment is within the limits` 200 6 5000
#ASSERT NOT `s 135(3) the punishment is within the limits` 200 7 5000

§ `s 136 -- contravention and obstruction`

-- 136(1): contravening the Act or the regulations.
#ASSERT `s 136(1) the person is guilty of an offence` TRUE
#ASSERT NOT `s 136(1) the person is guilty of an offence` FALSE
-- 136(2): delaying or obstructing a person authorized by the Commission in exercising their powers or performing their duties.
#ASSERT `s 136(2) the person is guilty of an offence` TRUE FALSE TRUE
#ASSERT `s 136(2) the person is guilty of an offence` FALSE TRUE TRUE
-- 136(2): delaying someone who is not exercising powers or performing duties under the Act is outside the subsection.
#ASSERT NOT `s 136(2) the person is guilty of an offence` TRUE FALSE FALSE
-- 136(2): neither delay nor obstruction.
#ASSERT NOT `s 136(2) the person is guilty of an offence` FALSE FALSE TRUE

§ `s 137 -- general penalty`

-- 137: a fine of not less than $100 and not more than $2,000, or imprisonment of not more than six months, or both.
#ASSERT `s 137 the least fine` EQUALS 100
#ASSERT `s 137 the greatest fine` EQUALS 2000
#ASSERT `s 137 the longest term of imprisonment, in months` EQUALS 6
-- 137: applies to an offence under the Act for which no penalty is provided.
#ASSERT `s 137 the person is liable on summary conviction to the general penalty` TRUE FALSE
-- 137: not where the Act provides a penalty (s 135(3) does for s 135 offences).
#ASSERT NOT `s 137 the person is liable on summary conviction to the general penalty` TRUE TRUE
-- 137: not where the person is not guilty of an offence under the Act.
#ASSERT NOT `s 137 the person is liable on summary conviction to the general penalty` FALSE FALSE
-- 137: a fine of 100 alone is within the limits; 99 is not.
#ASSERT `s 137 the punishment is within the limits` TRUE 100 FALSE 0
#ASSERT NOT `s 137 the punishment is within the limits` TRUE 99 FALSE 0
-- 137: a fine of 2000 is the most; 2001 is too much.
#ASSERT `s 137 the punishment is within the limits` TRUE 2000 FALSE 0
#ASSERT NOT `s 137 the punishment is within the limits` TRUE 2001 FALSE 0
-- 137: imprisonment alone, six months at most.
#ASSERT `s 137 the punishment is within the limits` FALSE 0 TRUE 6
#ASSERT NOT `s 137 the punishment is within the limits` FALSE 0 TRUE 7
-- 137: both the fine and imprisonment ("or to both").
#ASSERT `s 137 the punishment is within the limits` TRUE 150 TRUE 3
-- 137: neither a fine nor imprisonment imposed is no punishment at all.
#ASSERT NOT `s 137 the punishment is within the limits` FALSE 0 FALSE 0
-- 137: a fine that is within the limits cannot cure imprisonment that is not.
#ASSERT NOT `s 137 the punishment is within the limits` TRUE 150 TRUE 7

§ `s 138 -- Social Insurance Number`

-- 138: a person employed in insurable employment must have a Social Insurance Number.
#ASSERT `s 138 the person must have a Social Insurance Number assigned under an Act of Parliament` TRUE FALSE
-- 138: so must a self-employed person in respect of whom Part VII.1 applies.
#ASSERT `s 138 the person must have a Social Insurance Number assigned under an Act of Parliament` FALSE TRUE
-- 138: neither.
#ASSERT NOT `s 138 the person must have a Social Insurance Number assigned under an Act of Parliament` FALSE FALSE

§ `s 139 -- change of name`

-- 139: a person with a Social Insurance Number whose name changes must inform the Commission, unless already told another authority.
#ASSERT `s 139 the person must inform the Commission of their new name` TRUE TRUE FALSE
#ASSERT NOT `s 139 the person must inform the Commission of their new name` TRUE TRUE TRUE
#ASSERT NOT `s 139 the person must inform the Commission of their new name` TRUE FALSE FALSE
#ASSERT NOT `s 139 the person must inform the Commission of their new name` FALSE TRUE FALSE
-- 139: the change of name takes effect on 1 March 2026; 60 days after is 30 April 2026.
#ASSERT `s 139 the last day on which the person must inform the Commission of their new name` TRUE TRUE FALSE (YMD 2026 3 1) EQUALS JUST (YMD 2026 4 30)
-- 139: effective 15 December 2026; 60 days after is 13 February 2027.
#ASSERT `s 139 the last day on which the person must inform the Commission of their new name` TRUE TRUE FALSE (YMD 2026 12 15) EQUALS JUST (YMD 2027 2 13)
-- 139: already informed another authority: the duty does not arise. NOT COVERED by a date: NOTHING.
#ASSERT `s 139 the last day on which the person must inform the Commission of their new name` TRUE TRUE TRUE (YMD 2026 3 1) EQUALS NOTHING

§ `ss 141 and 143 -- repealed`

#EVAL `s 141 repealed, and therefore not encoded`
#EVAL `s 143 repealed, and therefore not encoded`
