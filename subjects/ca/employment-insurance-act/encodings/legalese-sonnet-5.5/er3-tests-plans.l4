IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `er3-nouns`
IMPORT `er3-plans`

-- Tests of er3-plans (regulations 37 and 38). Every expected value is written by hand from the text of regs 37
-- and 38 (SOR-96-332.txt lines 670-691) before the module was run.

`test waiting` MEANS `er3 reason: the employee is serving the waiting period`
`test insufficient` MEANS `er3 reason: the employee has insufficient hours of insurable employment to qualify for benefits`
`test exhausted` MEANS `er3 reason: the employee has received all of the benefits to which the employee is entitled`
`test other reason` MEANS `er3 reason: some other reason`

§ `reg 37(2)(c) -- application for and receipt of benefits`

#ASSERT `reg 37(2)(c) the reason is one of subparagraphs (i) to (iii)` `test waiting` EQUALS TRUE
#ASSERT `reg 37(2)(c) the reason is one of subparagraphs (i) to (iii)` `test insufficient` EQUALS TRUE
#ASSERT `reg 37(2)(c) the reason is one of subparagraphs (i) to (iii)` `test exhausted` EQUALS TRUE
#ASSERT `reg 37(2)(c) the reason is one of subparagraphs (i) to (iii)` `test other reason` EQUALS FALSE
-- the plan requires application and receipt, and pays an employee not in receipt only for the three reasons.
#ASSERT `reg 37(2)(c) the plan requires application for and receipt of benefits, with only the permitted exceptions` TRUE (LIST `test waiting`, `test exhausted`) EQUALS TRUE
#ASSERT `reg 37(2)(c) the plan requires application for and receipt of benefits, with only the permitted exceptions` TRUE EMPTY EQUALS TRUE
#ASSERT `reg 37(2)(c) the plan requires application for and receipt of benefits, with only the permitted exceptions` TRUE (LIST `test waiting`, `test other reason`) EQUALS FALSE
#ASSERT `reg 37(2)(c) the plan requires application for and receipt of benefits, with only the permitted exceptions` FALSE EMPTY EQUALS FALSE

§ `reg 37(2)(d), (g) -- the 95 per cent cap and the 30 days`

-- 95% of normal weekly earnings of 1000 is 950, less the 550 portion of the benefit rate: 400.
#ASSERT `reg 37(2)(d) the most the plan may pay for a week` 1000 550 EQUALS 400
#ASSERT `reg 37(2)(d) the most the plan may pay for a week` 1000 0 EQUALS 950
-- the benefit rate portion already above 95%: nothing more may be paid.
#ASSERT `reg 37(2)(d) the most the plan may pay for a week` 1000 960 EQUALS 0
#ASSERT `reg 37(2)(d) the most the plan may pay for a week` 1000 950 EQUALS 0
-- notice of a change that took effect on 2026-03-01: the 30th day after is 2026-03-31.
#ASSERT `reg 37(2)(g) written notice of the change is given within 30 days after its effective date` (YearMonthDay 2026 3 1) (YearMonthDay 2026 3 31) EQUALS TRUE
#ASSERT `reg 37(2)(g) written notice of the change is given within 30 days after its effective date` (YearMonthDay 2026 3 1) (YearMonthDay 2026 4 1) EQUALS FALSE
#ASSERT `reg 37(2)(g) written notice of the change is given within 30 days after its effective date` (YearMonthDay 2026 3 1) (YearMonthDay 2026 3 1) EQUALS TRUE

§ `reg 37(2), (1) -- the plan and its payments`

-- all nine features
#ASSERT `reg 37(2) supplemental unemployment benefit plan` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS TRUE
-- each missing in turn
#ASSERT `reg 37(2) supplemental unemployment benefit plan` FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS FALSE
#ASSERT `reg 37(2) supplemental unemployment benefit plan` TRUE FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS FALSE
#ASSERT `reg 37(2) supplemental unemployment benefit plan` TRUE TRUE FALSE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS FALSE
#ASSERT `reg 37(2) supplemental unemployment benefit plan` TRUE TRUE TRUE FALSE TRUE TRUE TRUE TRUE TRUE EQUALS FALSE
#ASSERT `reg 37(2) supplemental unemployment benefit plan` TRUE TRUE TRUE TRUE FALSE TRUE TRUE TRUE TRUE EQUALS FALSE
#ASSERT `reg 37(2) supplemental unemployment benefit plan` TRUE TRUE TRUE TRUE TRUE FALSE TRUE TRUE TRUE EQUALS FALSE
#ASSERT `reg 37(2) supplemental unemployment benefit plan` TRUE TRUE TRUE TRUE TRUE TRUE FALSE TRUE TRUE EQUALS FALSE
#ASSERT `reg 37(2) supplemental unemployment benefit plan` TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE TRUE EQUALS FALSE
#ASSERT `reg 37(2) supplemental unemployment benefit plan` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE EQUALS FALSE
-- (1): not earnings for a deduction from benefits or for ss 45 and 46, not for section 14 of the Regulations.
#ASSERT `reg 37(1) payments under a supplemental unemployment benefit plan are not earnings for the purpose` TRUE TRUE `er3 purpose: the amount to be deducted from benefits` EQUALS TRUE
#ASSERT `reg 37(1) payments under a supplemental unemployment benefit plan are not earnings for the purpose` TRUE TRUE `er3 purpose: sections 45 and 46 of the Act` EQUALS TRUE
#ASSERT `reg 37(1) payments under a supplemental unemployment benefit plan are not earnings for the purpose` TRUE TRUE `er3 purpose: an interruption of earnings under subsection 14(2) of the Regulations` EQUALS FALSE
#ASSERT `reg 37(1) payments under a supplemental unemployment benefit plan are not earnings for the purpose` TRUE TRUE `er3 purpose: an interruption of earnings under section 14 of the Regulations, other than subsection (2)` EQUALS FALSE
-- received other than as an insured person, or under a plan that is not a supplemental unemployment benefit plan.
#ASSERT `reg 37(1) payments under a supplemental unemployment benefit plan are not earnings for the purpose` FALSE TRUE `er3 purpose: the amount to be deducted from benefits` EQUALS FALSE
#ASSERT `reg 37(1) payments under a supplemental unemployment benefit plan are not earnings for the purpose` TRUE FALSE `er3 purpose: the amount to be deducted from benefits` EQUALS FALSE

§ `reg 38 -- maternity leave, child care and compassionate care leave plans`

#ASSERT `reg 38(1) the reason is one of those listed` `pregnancy` EQUALS TRUE
#ASSERT `reg 38(1) the reason is one of those listed` `caring for a new-born or adopted child` EQUALS TRUE
#ASSERT `reg 38(1) the reason is one of those listed` `care or support of a family member` EQUALS TRUE
#ASSERT `reg 38(1) the reason is one of those listed` `care or support of a critically ill child` EQUALS TRUE
#ASSERT `reg 38(1) the reason is one of those listed` `care or support of a critically ill adult` EQUALS TRUE
-- illness, injury or quarantine is not listed in (1); a regular benefit is not either.
#ASSERT `reg 38(1) the reason is one of those listed` `a prescribed illness, injury or quarantine` EQUALS FALSE
#ASSERT `reg 38(1) the reason is one of those listed` `a reason other than those mentioned in subsection 12(3)` EQUALS FALSE
-- any combination of the listed reasons; one unlisted reason spoils it; no reason is no payment.
#ASSERT `reg 38(1) the payments are because of one or more of the reasons listed or any combination of them` (LIST `pregnancy`, `caring for a new-born or adopted child`) EQUALS TRUE
#ASSERT `reg 38(1) the payments are because of one or more of the reasons listed or any combination of them` (LIST `pregnancy`, `a prescribed illness, injury or quarantine`) EQUALS FALSE
#ASSERT `reg 38(1) the payments are because of one or more of the reasons listed or any combination of them` EMPTY EQUALS FALSE
-- the excluded portion. Normal weekly earnings 1000, the portion of the benefit rate from the employment 550:
-- the room under the cap is 450.
#ASSERT `reg 38(1) the portion of the payments excluded as earnings for the purposes of section 35` (LIST `pregnancy`) 400 0 1000 550 EQUALS 400
#ASSERT `reg 38(1) the portion of the payments excluded as earnings for the purposes of section 35` (LIST `pregnancy`) 450 0 1000 550 EQUALS 450
#ASSERT `reg 38(1) the portion of the payments excluded as earnings for the purposes of section 35` (LIST `pregnancy`) 600 0 1000 550 EQUALS 450
-- the part that reduces accumulated credits is never excluded: 600 less 250 is 350, within the 450.
#ASSERT `reg 38(1) the portion of the payments excluded as earnings for the purposes of section 35` (LIST `pregnancy`) 600 250 1000 550 EQUALS 350
#ASSERT `reg 38(1) the portion of the payments excluded as earnings for the purposes of section 35` (LIST `pregnancy`) 600 100 1000 550 EQUALS 450
-- the benefit rate portion already above normal weekly earnings: nothing is excluded.
#ASSERT `reg 38(1) the portion of the payments excluded as earnings for the purposes of section 35` (LIST `pregnancy`) 400 0 500 550 EQUALS 0
-- a reason not listed: nothing is excluded.
#ASSERT `reg 38(1) the portion of the payments excluded as earnings for the purposes of section 35` (LIST `a prescribed illness, injury or quarantine`) 400 0 1000 550 EQUALS 0
-- (2): a week in which benefits are payable by reason of illness, injury or quarantine.
#ASSERT `reg 38(2) the portion of the payments for the week is considered earnings` TRUE EQUALS TRUE
#ASSERT `reg 38(2) the portion of the payments for the week is considered earnings` FALSE EQUALS FALSE
#ASSERT `reg 38 the portion of the payments for the week that is excluded as earnings` (LIST `pregnancy`) 400 0 1000 550 TRUE EQUALS 0
#ASSERT `reg 38 the portion of the payments for the week that is excluded as earnings` (LIST `pregnancy`) 400 0 1000 550 FALSE EQUALS 400
