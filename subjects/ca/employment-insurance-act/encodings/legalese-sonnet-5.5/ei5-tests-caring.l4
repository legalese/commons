IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `ei5-caring`

-- Tests of ei5-caring (Act ss 152.06, 152.061 and 152.062). Expected values are written by hand from the text
-- beside each assertion. Calendar facts used: 2026-03-08 is a Sunday; 2026-06-07 is a Sunday.

§ `The certificate`

-- arguments: is a medical doctor or nurse practitioner, member of a prescribed class, the circumstances in the regulations exist
#ASSERT `ss 152.06(2), 152.061(2) and 152.062(2) the certificate may be issued by the practitioner` TRUE FALSE FALSE
#ASSERT `ss 152.06(2), 152.061(2) and 152.062(2) the certificate may be issued by the practitioner` FALSE TRUE TRUE
-- a member of a prescribed class, but not in the circumstances set out in the regulations
#ASSERT NOT (`ss 152.06(2), 152.061(2) and 152.062(2) the certificate may be issued by the practitioner` FALSE TRUE FALSE)
#ASSERT NOT (`ss 152.06(2), 152.061(2) and 152.062(2) the certificate may be issued by the practitioner` FALSE FALSE TRUE)

-- (4) a shorter period, if prescribed, replaces 26 weeks in (1)(a) and 52 weeks in (3)(b)(iii)
#ASSERT `s 152.06(4)(a) the number of weeks within which the certificate must state a significant risk of death` NOTHING EQUALS 26
#ASSERT `s 152.06(4)(a) the number of weeks within which the certificate must state a significant risk of death` (JUST 12) EQUALS 12
#ASSERT `s 152.06(4)(b) the number of weeks that ends the period under subparagraph (3)(b)(iii)` NOTHING EQUALS 52
#ASSERT `s 152.06(4)(b) the number of weeks that ends the period under subparagraph (3)(b)(iii)` (JUST 12) EQUALS 12

§ `152.06(1) compassionate care`

-- arguments: family member, certificate by a practitioner who may issue it, serious condition with risk of death, weeks of
-- risk stated, requires care or support of other family members, shorter period prescribed
#ASSERT `s 152.06(1) benefits are payable for the care or support of a gravely ill family member` TRUE TRUE TRUE 26 TRUE NOTHING
-- 27 weeks of risk is outside the 26 weeks
#ASSERT NOT (`s 152.06(1) benefits are payable for the care or support of a gravely ill family member` TRUE TRUE TRUE 27 TRUE NOTHING)
-- with a prescribed shorter period of 12 weeks: 12 is within, 13 is not
#ASSERT `s 152.06(1) benefits are payable for the care or support of a gravely ill family member` TRUE TRUE TRUE 12 TRUE (JUST 12)
#ASSERT NOT (`s 152.06(1) benefits are payable for the care or support of a gravely ill family member` TRUE TRUE TRUE 13 TRUE (JUST 12))
#ASSERT NOT (`s 152.06(1) benefits are payable for the care or support of a gravely ill family member` FALSE TRUE TRUE 10 TRUE NOTHING)
#ASSERT NOT (`s 152.06(1) benefits are payable for the care or support of a gravely ill family member` TRUE FALSE TRUE 10 TRUE NOTHING)
#ASSERT NOT (`s 152.06(1) benefits are payable for the care or support of a gravely ill family member` TRUE TRUE FALSE 10 TRUE NOTHING)
#ASSERT NOT (`s 152.06(1) benefits are payable for the care or support of a gravely ill family member` TRUE TRUE TRUE 10 FALSE NOTHING)

#ASSERT `s 152.06(3.1) an additional certificate is required for benefits payable after the end of the 26 weeks` TRUE
#ASSERT NOT (`s 152.06(3.1) an additional certificate is required for benefits payable after the end of the 26 weeks` FALSE)

§ `152.061(1) critically ill child and 152.062(1) critically ill adult`

#ASSERT `s 152.061(1) benefits are payable for the care or support of a critically ill child` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 152.061(1) benefits are payable for the care or support of a critically ill child` FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`s 152.061(1) benefits are payable for the care or support of a critically ill child` TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`s 152.061(1) benefits are payable for the care or support of a critically ill child` TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 152.061(1) benefits are payable for the care or support of a critically ill child` TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 152.061(1) benefits are payable for the care or support of a critically ill child` TRUE TRUE TRUE TRUE FALSE)
#ASSERT `s 152.062(1) benefits are payable for the care or support of a critically ill adult` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 152.062(1) benefits are payable for the care or support of a critically ill adult` FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`s 152.062(1) benefits are payable for the care or support of a critically ill adult` TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`s 152.062(1) benefits are payable for the care or support of a critically ill adult` TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 152.062(1) benefits are payable for the care or support of a critically ill adult` TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 152.062(1) benefits are payable for the care or support of a critically ill adult` TRUE TRUE TRUE TRUE FALSE)

§ `The period (3) and the exception (5)`

-- exception arguments: benefits exhausted when the certificate is filed, beginning already determined and filing would move it
-- earlier, other circumstances in the regulations
#ASSERT `ss 152.06(5), 152.061(5) and 152.062(4) subparagraph (3)(a)(ii) does not apply to the claim` TRUE FALSE FALSE
#ASSERT `ss 152.06(5), 152.061(5) and 152.062(4) subparagraph (3)(a)(ii) does not apply to the claim` FALSE TRUE FALSE
#ASSERT `ss 152.06(5), 152.061(5) and 152.062(4) subparagraph (3)(a)(ii) does not apply to the claim` FALSE FALSE TRUE
#ASSERT NOT (`ss 152.06(5), 152.061(5) and 152.062(4) subparagraph (3)(a)(ii) does not apply to the claim` FALSE FALSE FALSE)

-- The first certificate is issued on Wednesday 11 March 2026; the week begins on Sunday 8 March 2026. The 52 weeks
-- following that Sunday end on Saturday 6 March 2027 (8 March 2026 + 363 days).
-- arguments: day of issuance, claim made before the certificate was issued, day from which the practitioner certifies,
-- (ii) does not apply, day benefits exhausted, day of death, weeks after which the period ends
#ASSERT `ss 152.06(3), 152.061(3) and 152.062(3) the period for which benefits are payable` (YearMonthDay 2026 3 11) FALSE (YearMonthDay 2026 2 24) FALSE NOTHING NOTHING 52 EQUALS `Period of days` OF (YearMonthDay 2026 3 8), (YearMonthDay 2027 3 6)
-- benefits exhausted in the week of Wednesday 10 June 2026 (Sunday 7 June): the period ends Saturday 13 June
#ASSERT `ss 152.06(3), 152.061(3) and 152.062(3) the period for which benefits are payable` (YearMonthDay 2026 3 11) FALSE (YearMonthDay 2026 2 24) FALSE (JUST (YearMonthDay 2026 6 10)) NOTHING 52 EQUALS `Period of days` OF (YearMonthDay 2026 3 8), (YearMonthDay 2026 6 13)
-- the family member dies on Thursday 14 May 2026: the period ends Saturday 16 May
#ASSERT `ss 152.06(3), 152.061(3) and 152.062(3) the period for which benefits are payable` (YearMonthDay 2026 3 11) FALSE (YearMonthDay 2026 2 24) FALSE NOTHING (JUST (YearMonthDay 2026 5 14)) 52 EQUALS `Period of days` OF (YearMonthDay 2026 3 8), (YearMonthDay 2026 5 16)
-- both: the first to occur governs
#ASSERT `ss 152.06(3), 152.061(3) and 152.062(3) the period for which benefits are payable` (YearMonthDay 2026 3 11) FALSE (YearMonthDay 2026 2 24) FALSE (JUST (YearMonthDay 2026 6 10)) (JUST (YearMonthDay 2026 5 14)) 52 EQUALS `Period of days` OF (YearMonthDay 2026 3 8), (YearMonthDay 2026 5 16)
-- the claim was made before the certificate was issued and (ii) applies: it begins in the week of the day from which the
-- practitioner certifies, Tuesday 24 February 2026 (Sunday 22 February), and the 52 weeks end Saturday 20 February 2027
#ASSERT `ss 152.06(3), 152.061(3) and 152.062(3) the period for which benefits are payable` (YearMonthDay 2026 3 11) TRUE (YearMonthDay 2026 2 24) FALSE NOTHING NOTHING 52 EQUALS `Period of days` OF (YearMonthDay 2026 2 22), (YearMonthDay 2027 2 20)
-- the same claim but the exception applies: (ii) does not apply, so it begins with the week of issuance
#ASSERT `ss 152.06(3), 152.061(3) and 152.062(3) the period for which benefits are payable` (YearMonthDay 2026 3 11) TRUE (YearMonthDay 2026 2 24) TRUE NOTHING NOTHING 52 EQUALS `Period of days` OF (YearMonthDay 2026 3 8), (YearMonthDay 2027 3 6)
-- a shorter prescribed period of 12 weeks for s 152.06(3)(b)(iii): 8 March + 83 days = Saturday 30 May 2026
#ASSERT `ss 152.06(3), 152.061(3) and 152.062(3) the period for which benefits are payable` (YearMonthDay 2026 3 11) FALSE (YearMonthDay 2026 2 24) FALSE NOTHING NOTHING 12 EQUALS `Period of days` OF (YearMonthDay 2026 3 8), (YearMonthDay 2026 5 30)
-- an event after the 52 weeks do not lengthen it
#ASSERT `ss 152.06(3), 152.061(3) and 152.062(3) the period for which benefits are payable` (YearMonthDay 2026 3 11) FALSE (YearMonthDay 2026 2 24) FALSE (JUST (YearMonthDay 2027 6 1)) NOTHING 52 EQUALS `Period of days` OF (YearMonthDay 2026 3 8), (YearMonthDay 2027 3 6)
-- a death on the last Saturday of the 52 weeks, and on the Sunday after it
#ASSERT `ss 152.06(3), 152.061(3) and 152.062(3) the period for which benefits are payable` (YearMonthDay 2026 3 11) FALSE (YearMonthDay 2026 2 24) FALSE NOTHING (JUST (YearMonthDay 2027 3 6)) 52 EQUALS `Period of days` OF (YearMonthDay 2026 3 8), (YearMonthDay 2027 3 6)
#ASSERT `ss 152.06(3), 152.061(3) and 152.062(3) the period for which benefits are payable` (YearMonthDay 2026 3 11) FALSE (YearMonthDay 2026 2 24) FALSE NOTHING (JUST (YearMonthDay 2027 3 7)) 52 EQUALS `Period of days` OF (YearMonthDay 2026 3 8), (YearMonthDay 2027 3 6)

§ `Waiting period and division`

#ASSERT `ss 152.06(6), 152.061(6) and 152.062(5) the waiting period may be deferred` TRUE FALSE FALSE
#ASSERT `ss 152.06(6), 152.061(6) and 152.062(5) the waiting period may be deferred` FALSE TRUE FALSE
#ASSERT `ss 152.06(6), 152.061(6) and 152.062(5) the waiting period may be deferred` FALSE FALSE TRUE
#ASSERT NOT (`ss 152.06(6), 152.061(6) and 152.062(5) the waiting period may be deferred` FALSE FALSE FALSE)

#ASSERT `s 152.06(7) and (8) the maximum number of weeks that may be divided` EQUALS 26
#ASSERT `s 152.061(8) and (9) the maximum number of weeks that may be divided` EQUALS 35
#ASSERT `s 152.062(6) and (7) the maximum number of weeks that may be divided` EQUALS 15
#ASSERT `ss 152.06(7) and (8), 152.061(8) and (9) and 152.062(6) and (7) a division of the remaining weeks is within the maximum` 26 20 6
#ASSERT NOT (`ss 152.06(7) and (8), 152.061(8) and (9) and 152.062(6) and (7) a division of the remaining weeks is within the maximum` 26 20 7)
#ASSERT `ss 152.06(7) and (8), 152.061(8) and (9) and 152.062(6) and (7) a division of the remaining weeks is within the maximum` 35 35 0
#ASSERT NOT (`ss 152.06(7) and (8), 152.061(8) and (9) and 152.062(6) and (7) a division of the remaining weeks is within the maximum` 15 8 8)
#ASSERT `ss 152.06(7), 152.061(8) and 152.062(6) the weeks of benefits to be paid to a claimant after the division` TRUE 14 12 EQUALS 14
#ASSERT `ss 152.06(7), 152.061(8) and 152.062(6) the weeks of benefits to be paid to a claimant after the division` FALSE 14 12 EQUALS 12

§ `Benefits that cannot be paid together`

`the child's period` MEANS `Period of days` OF (YearMonthDay 2026 3 8), (YearMonthDay 2027 3 6)
-- arguments: benefits under s 23.1 or 152.06, in respect of that child, the period, the day
#ASSERT `ss 152.061(10) and 152.062(8) benefits under section 23.1 or 152.06 are not payable in respect of the child or adult on a day` TRUE TRUE `the child's period` (YearMonthDay 2026 6 1)
#ASSERT `ss 152.061(10) and 152.062(8) benefits under section 23.1 or 152.06 are not payable in respect of the child or adult on a day` TRUE TRUE `the child's period` (YearMonthDay 2026 3 8)
#ASSERT `ss 152.061(10) and 152.062(8) benefits under section 23.1 or 152.06 are not payable in respect of the child or adult on a day` TRUE TRUE `the child's period` (YearMonthDay 2027 3 6)
#ASSERT NOT (`ss 152.061(10) and 152.062(8) benefits under section 23.1 or 152.06 are not payable in respect of the child or adult on a day` TRUE TRUE `the child's period` (YearMonthDay 2027 3 7))
#ASSERT NOT (`ss 152.061(10) and 152.062(8) benefits under section 23.1 or 152.06 are not payable in respect of the child or adult on a day` TRUE TRUE `the child's period` (YearMonthDay 2026 3 7))
#ASSERT NOT (`ss 152.061(10) and 152.062(8) benefits under section 23.1 or 152.06 are not payable in respect of the child or adult on a day` FALSE TRUE `the child's period` (YearMonthDay 2026 6 1))
#ASSERT NOT (`ss 152.061(10) and 152.062(8) benefits under section 23.1 or 152.06 are not payable in respect of the child or adult on a day` TRUE FALSE `the child's period` (YearMonthDay 2026 6 1))

-- (10.1) arguments: benefits under 23.3 or 152.062, benefits paid under 152.061, the first day of the week, the day:
-- the 52 weeks beginning 8 March 2026 end on 6 March 2027
#ASSERT `s 152.061(10.1) benefits under section 23.3 or 152.062 are not payable on a day` TRUE TRUE (YearMonthDay 2026 3 8) (YearMonthDay 2026 3 8)
#ASSERT `s 152.061(10.1) benefits under section 23.3 or 152.062 are not payable on a day` TRUE TRUE (YearMonthDay 2026 3 8) (YearMonthDay 2027 3 6)
#ASSERT NOT (`s 152.061(10.1) benefits under section 23.3 or 152.062 are not payable on a day` TRUE TRUE (YearMonthDay 2026 3 8) (YearMonthDay 2027 3 7))
#ASSERT NOT (`s 152.061(10.1) benefits under section 23.3 or 152.062 are not payable on a day` TRUE TRUE (YearMonthDay 2026 3 8) (YearMonthDay 2026 3 7))
#ASSERT NOT (`s 152.061(10.1) benefits under section 23.3 or 152.062 are not payable on a day` TRUE FALSE (YearMonthDay 2026 3 8) (YearMonthDay 2026 6 1))
#ASSERT NOT (`s 152.061(10.1) benefits under section 23.3 or 152.062 are not payable on a day` FALSE TRUE (YearMonthDay 2026 3 8) (YearMonthDay 2026 6 1))
