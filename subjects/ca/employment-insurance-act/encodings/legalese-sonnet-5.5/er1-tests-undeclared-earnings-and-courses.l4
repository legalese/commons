IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `er1-undeclared-earnings-and-courses`

-- Tests of er1-undeclared-earnings-and-courses (Employment Insurance Regulations, regs 14.1 to 16). Piece er1.
-- Every expected value is written by hand from the text of the Regulations (../../registers/source-bundle/SOR-96-332.txt), beside the assertion,
-- before the rule was run. The argument order is the order of the rule's GIVEN lines. The money figures are invented.

§ `Regulation 14.1 - the end of the period (src:226-227)`

#ASSERT `reg 14.1 August 12, 2001` EQUALS YMD 2001 8 12
-- arguments: earnings failed to be declared are allocated to a period of paragraph 15(4)(a), (b) or (c) as it read before the date; the first day of the period; the day it was to have ended
#ASSERT `reg 14.1 the day on which the period ends` TRUE (YMD 2001 6 1) (YMD 2001 12 1) EQUALS JUST (YMD 2001 8 12)       -- began before, was to end after: ends on August 12, 2001
#ASSERT `reg 14.1 the day on which the period ends` TRUE (YMD 2001 8 11) (YMD 2001 8 12) EQUALS JUST (YMD 2001 8 12)      -- began the day before, was to end on the date: "on or after"
#ASSERT `reg 14.1 the day on which the period ends` TRUE (YMD 2001 8 11) (YMD 2001 8 11) EQUALS NOTHING                  -- was to end before the date
#ASSERT `reg 14.1 the day on which the period ends` TRUE (YMD 2001 8 12) (YMD 2001 12 1) EQUALS NOTHING                  -- began on the date, not "before that date"
#ASSERT `reg 14.1 the day on which the period ends` TRUE (YMD 2001 9 1) (YMD 2002 1 1) EQUALS NOTHING                    -- began after the date
#ASSERT `reg 14.1 the day on which the period ends` FALSE (YMD 2001 6 1) (YMD 2001 12 1) EQUALS NOTHING                  -- not earnings allocated to a period of paragraph 15(4)
#ASSERT `reg 15 repealed in this text` EQUALS "reg 15: [Repealed, SOR/2001-291, s. 2]"

§ `Regulation 16(2) - the allowances (src:233-235)`

-- arguments: total allowances payable; amounts for dependant care, travel, commuting, living away from home or disability; entitled to work-sharing benefits; amounts using financial assistance under section 61
#ASSERT `reg 16(2) the allowances referred to in subsection (1)` 1000 200 FALSE 0 EQUALS JUST 800               -- 1000 less 200 of excluded kinds
#ASSERT `reg 16(2) the allowances referred to in subsection (1)` 1000 0 FALSE 0 EQUALS JUST 1000
#ASSERT `reg 16(2) the allowances referred to in subsection (1)` 1000 200 TRUE 300 EQUALS JUST 500               -- work-sharing benefits: 300 under section 61 also left out
#ASSERT `reg 16(2) the allowances referred to in subsection (1)` 1000 200 FALSE 300 EQUALS JUST 800            -- not entitled to work-sharing benefits: the section 61 money stays in
#ASSERT `reg 16(2) the allowances referred to in subsection (1)` 1000 700 TRUE 300 EQUALS JUST 0               -- nothing left
#ASSERT `reg 16(2) the allowances referred to in subsection (1)` 1000 700 TRUE 400 EQUALS NOTHING             -- the excluded parts exceed the total: the text does not contemplate it

§ `Regulation 16(1) - a week on a course or program (src:230-232)`

-- arguments: a week of unemployment; attending the course or program during the week; the allowances are payable for the week; referred by the Commission or its designated authority; the allowances of reg 16(2)
#ASSERT `reg 16(1) the amount deducted from the benefits for a week of unemployment while attending a course or program` TRUE TRUE TRUE FALSE (JUST 800) EQUALS JUST 800
#ASSERT `reg 16(1) the amount deducted from the benefits for a week of unemployment while attending a course or program` TRUE TRUE TRUE TRUE (JUST 800) EQUALS NOTHING      -- "other than a course or program to which the Commission ... has referred the claimant"
#ASSERT `reg 16(1) the amount deducted from the benefits for a week of unemployment while attending a course or program` TRUE FALSE TRUE FALSE (JUST 800) EQUALS NOTHING     -- (a) not attending in that week
#ASSERT `reg 16(1) the amount deducted from the benefits for a week of unemployment while attending a course or program` TRUE TRUE FALSE FALSE (JUST 800) EQUALS NOTHING     -- (b) no allowances payable for that week
#ASSERT `reg 16(1) the amount deducted from the benefits for a week of unemployment while attending a course or program` FALSE TRUE TRUE FALSE (JUST 800) EQUALS NOTHING     -- not a week of unemployment
#ASSERT `reg 16(1) the amount deducted from the benefits for a week of unemployment while attending a course or program` TRUE TRUE TRUE FALSE NOTHING EQUALS NOTHING      -- the reg 16(2) amount is not defined

§ `Regulation 16(3) - Part II earnings and allowances for weeks later paid as benefits (src:236-239)`

-- arguments: does not meet the qualifying conditions of s 7 or 7.1 or the Part VIII regulations; disentitled; disqualified; paid earnings or allowances under Part II for a course; paid earnings under a 59(b) work-experience measure; later entitled to regular benefits for the same weeks; the total paid under Part II
#ASSERT `reg 16(3) the amount deducted from the benefits for the weeks for which Part II earnings or allowances were paid` TRUE FALSE FALSE TRUE FALSE TRUE 1500 EQUALS JUST 1500
#ASSERT `reg 16(3) the amount deducted from the benefits for the weeks for which Part II earnings or allowances were paid` FALSE TRUE FALSE TRUE FALSE TRUE 1500 EQUALS JUST 1500    -- (a) disentitled
#ASSERT `reg 16(3) the amount deducted from the benefits for the weeks for which Part II earnings or allowances were paid` FALSE FALSE TRUE FALSE TRUE TRUE 1500 EQUALS JUST 1500    -- (a) disqualified; (b) earnings under a 59(b) measure
#ASSERT `reg 16(3) the amount deducted from the benefits for the weeks for which Part II earnings or allowances were paid` TRUE FALSE FALSE FALSE FALSE TRUE 1500 EQUALS NOTHING      -- (b) nothing was paid under Part II
#ASSERT `reg 16(3) the amount deducted from the benefits for the weeks for which Part II earnings or allowances were paid` FALSE FALSE FALSE TRUE FALSE TRUE 1500 EQUALS NOTHING     -- (a) none of the three
#ASSERT `reg 16(3) the amount deducted from the benefits for the weeks for which Part II earnings or allowances were paid` TRUE FALSE FALSE TRUE FALSE FALSE 1500 EQUALS NOTHING     -- (c) not later entitled to regular benefits for the same weeks
