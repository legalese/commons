IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `eia-core-insurable-employment`

-- Tests for eia-core-insurable-employment.l4 (Employment Insurance Act s 5).
-- Expected values are written by hand from the paragraph quoted in that module.
-- Argument order is the order of the GIVEN parameters in the rule under test.

§ `s 5(1)(a) to (e)`

#ASSERT `s 5(1)(a) employment under a contract of service or apprenticeship` TRUE TRUE TRUE
-- outside Canada
#ASSERT NOT (`s 5(1)(a) employment under a contract of service or apprenticeship` FALSE TRUE TRUE)
-- no employer
#ASSERT NOT (`s 5(1)(a) employment under a contract of service or apprenticeship` TRUE FALSE TRUE)
-- neither an express nor an implied contract of service or apprenticeship
#ASSERT NOT (`s 5(1)(a) employment under a contract of service or apprenticeship` TRUE TRUE FALSE)
#ASSERT `s 5(1)(b) employment by Her Majesty in right of Canada` TRUE TRUE
#ASSERT NOT (`s 5(1)(b) employment by Her Majesty in right of Canada` TRUE FALSE)
#ASSERT NOT (`s 5(1)(b) employment by Her Majesty in right of Canada` FALSE TRUE)
#ASSERT `s 5(1)(c) service in the Canadian Forces or in a police force` TRUE FALSE
#ASSERT `s 5(1)(c) service in the Canadian Forces or in a police force` FALSE TRUE
#ASSERT NOT (`s 5(1)(c) service in the Canadian Forces or in a police force` FALSE FALSE)
#ASSERT `s 5(1)(d) employment included by regulations` TRUE
#ASSERT NOT (`s 5(1)(d) employment included by regulations` FALSE)
#ASSERT `s 5(1)(e) employment as the sponsor or co-ordinator of an employment support measure` TRUE TRUE FALSE
-- a measure referred to in paragraph 59(c) or (d) is left out
#ASSERT NOT (`s 5(1)(e) employment as the sponsor or co-ordinator of an employment support measure` TRUE TRUE TRUE)
#ASSERT NOT (`s 5(1)(e) employment as the sponsor or co-ordinator of an employment support measure` FALSE TRUE FALSE)
#ASSERT NOT (`s 5(1)(e) employment as the sponsor or co-ordinator of an employment support measure` TRUE FALSE FALSE)
-- any one paragraph is enough; none is not enough
#ASSERT NOT (`s 5(1) insurable employment, before subsection (2)` FALSE FALSE FALSE FALSE FALSE)
#ASSERT `s 5(1) insurable employment, before subsection (2)` TRUE FALSE FALSE FALSE FALSE
#ASSERT `s 5(1) insurable employment, before subsection (2)` FALSE FALSE FALSE TRUE FALSE
#ASSERT `s 5(1) insurable employment, before subsection (2)` FALSE FALSE FALSE FALSE TRUE

§ `s 5(2)(a) to (h)`

-- casual, and not for the purpose of the employer's trade or business
#ASSERT `s 5(2)(a) employment of a casual nature other than for the purpose of the employer's trade or business` TRUE FALSE
#ASSERT NOT (`s 5(2)(a) employment of a casual nature other than for the purpose of the employer's trade or business` TRUE TRUE)
#ASSERT NOT (`s 5(2)(a) employment of a casual nature other than for the purpose of the employer's trade or business` FALSE FALSE)
-- "more than 40%": 40% itself is not more
#ASSERT `s 5(2)(b) employment of a person by a corporation they control` TRUE (41%)
#ASSERT `s 5(2)(b) employment of a person by a corporation they control` TRUE (40.1%)
#ASSERT `s 5(2)(b) employment of a person by a corporation they control` TRUE (100%)
#ASSERT NOT (`s 5(2)(b) employment of a person by a corporation they control` TRUE (40%))
#ASSERT NOT (`s 5(2)(b) employment of a person by a corporation they control` TRUE (0%))
#ASSERT NOT (`s 5(2)(b) employment of a person by a corporation they control` FALSE (90%))
#ASSERT `s 5(2)(c) employment by Her Majesty in right of a province` TRUE TRUE FALSE
-- the province has waived the exclusion and regulations made under 5(4)(d) include it
#ASSERT NOT (`s 5(2)(c) employment by Her Majesty in right of a province` TRUE TRUE TRUE)
#ASSERT NOT (`s 5(2)(c) employment by Her Majesty in right of a province` FALSE TRUE FALSE)
#ASSERT `s 5(2)(d) employment by a foreign government` TRUE TRUE FALSE
#ASSERT NOT (`s 5(2)(d) employment by a foreign government` TRUE TRUE TRUE)
#ASSERT NOT (`s 5(2)(d) employment by a foreign government` TRUE FALSE FALSE)
#ASSERT `s 5(2)(e) employment by an international organization` TRUE TRUE FALSE
#ASSERT NOT (`s 5(2)(e) employment by an international organization` TRUE TRUE TRUE)
#ASSERT NOT (`s 5(2)(e) employment by an international organization` FALSE TRUE FALSE)
#ASSERT `s 5(2)(f) employment under an exchange program` TRUE TRUE FALSE
-- remunerated by an employer that is resident in Canada
#ASSERT NOT (`s 5(2)(f) employment under an exchange program` TRUE TRUE TRUE)
#ASSERT NOT (`s 5(2)(f) employment under an exchange program` TRUE FALSE FALSE)
#ASSERT `s 5(2)(g) employment that constitutes an exchange of work or services` TRUE
#ASSERT NOT (`s 5(2)(g) employment that constitutes an exchange of work or services` FALSE)
#ASSERT `s 5(2)(h) employment excluded by regulations` TRUE
#ASSERT NOT (`s 5(2)(h) employment excluded by regulations` FALSE)

§ `s 5(2)(i) and s 5(3) - arm's length`

-- not at arm's length under the Income Tax Act, not related, so no deeming: excluded
#ASSERT `s 5(2)(i) employment if the employer and employee are not dealing with each other at arm's length` TRUE FALSE FALSE
-- related persons, and the Minister of National Revenue is satisfied: deemed to deal at arm's length, so not excluded
#ASSERT NOT (`s 5(2)(i) employment if the employer and employee are not dealing with each other at arm's length` TRUE TRUE TRUE)
-- related persons, and the Minister is not satisfied: excluded
#ASSERT `s 5(2)(i) employment if the employer and employee are not dealing with each other at arm's length` TRUE TRUE FALSE
-- the Minister's satisfaction counts only where the employer is related to the employee
#ASSERT `s 5(2)(i) employment if the employer and employee are not dealing with each other at arm's length` TRUE FALSE TRUE
-- at arm's length under the Income Tax Act: not excluded, whatever else
#ASSERT NOT (`s 5(2)(i) employment if the employer and employee are not dealing with each other at arm's length` FALSE FALSE FALSE)
#ASSERT NOT (`s 5(2)(i) employment if the employer and employee are not dealing with each other at arm's length` FALSE TRUE FALSE)

§ `s 5(2) - any one paragraph`

#ASSERT NOT (`s 5(2) insurable employment does not include` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
#ASSERT `s 5(2) insurable employment does not include` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE
#ASSERT `s 5(2) insurable employment does not include` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE
#ASSERT `s 5(2) insurable employment does not include` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE

§ `s 5 - the whole`

#ASSERT `s 5 insurable employment` TRUE FALSE
#ASSERT NOT (`s 5 insurable employment` TRUE TRUE)
#ASSERT NOT (`s 5 insurable employment` FALSE FALSE)

-- An employee in Canada under a contract of service with a private employer, a stranger to them:
-- paragraph (a) applies, no exclusion does.
#ASSERT `s 5 insurable employment` (`s 5(1) insurable employment, before subsection (2)` (`s 5(1)(a) employment under a contract of service or apprenticeship` TRUE TRUE TRUE) FALSE FALSE FALSE FALSE) (`s 5(2) insurable employment does not include` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE (`s 5(2)(i) employment if the employer and employee are not dealing with each other at arm's length` FALSE FALSE FALSE))

-- The same employee, but the owner of 60% of the voting shares of the corporation that employs them:
-- paragraph (a) applies and s 5(2)(b) takes it out.
#ASSERT NOT (`s 5 insurable employment` (`s 5(1) insurable employment, before subsection (2)` (`s 5(1)(a) employment under a contract of service or apprenticeship` TRUE TRUE TRUE) FALSE FALSE FALSE FALSE) (`s 5(2) insurable employment does not include` FALSE (`s 5(2)(b) employment of a person by a corporation they control` TRUE (60%)) FALSE FALSE FALSE FALSE FALSE FALSE FALSE))

-- An employee of their own parent, related within the meaning of the Income Tax Act, where the Minister
-- of National Revenue is satisfied: s 5(2)(i) does not apply, so the employment stays insurable.
#ASSERT `s 5 insurable employment` (`s 5(1) insurable employment, before subsection (2)` (`s 5(1)(a) employment under a contract of service or apprenticeship` TRUE TRUE TRUE) FALSE FALSE FALSE FALSE) (`s 5(2) insurable employment does not include` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE (`s 5(2)(i) employment if the employer and employee are not dealing with each other at arm's length` TRUE TRUE TRUE))
