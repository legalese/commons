§ `Regulation 17.1(14) and (15) - claimants near the boundaries of more than one region (src:330-331)`

#ASSERT `reg 17.1(14) the highest of the regional rates for a claimant who resides near the boundaries of more than one region` (LIST 0.07, 0.09) EQUALS JUST 0.09
#ASSERT `reg 17.1(14) the highest of the regional rates for a claimant who resides near the boundaries of more than one region` EMPTY EQUALS NOTHING
#ASSERT `reg 17.1(15) the highest of the regional rates for a claimant last employed near the boundaries of more than one region` (LIST 0.07, 0.09) EQUALS JUST 0.09
#ASSERT `reg 17.1(15) the highest of the regional rates for a claimant last employed near the boundaries of more than one region` EMPTY EQUALS NOTHING

§ `Regulation 17.1(16) and (17) - when the special rates stop having effect (src:332-333)`

-- The Sunday after: 6 April 2011 is a Wednesday, so the Sunday after it is 10 April 2011; a Sunday's Sunday after is a week later.
#ASSERT `reg 17.1(16) and (17) the Sunday after the day on which the hours and weeks are exactly the same` (JUST (YearMonthDay 2011 4 6)) EQUALS JUST (YearMonthDay 2011 4 10)
#ASSERT `reg 17.1(16) and (17) the Sunday after the day on which the hours and weeks are exactly the same` (JUST (YearMonthDay 2011 4 10)) EQUALS JUST (YearMonthDay 2011 4 17)
#ASSERT `reg 17.1(16) and (17) the Sunday after the day on which the hours and weeks are exactly the same` (JUST (YearMonthDay 2011 3 13)) EQUALS JUST (YearMonthDay 2011 3 20)   -- 13 March 2011 is the first day "after March 12, 2011"
#ASSERT `reg 17.1(16) and (17) the Sunday after the day on which the hours and weeks are exactly the same` (JUST (YearMonthDay 2011 3 12)) EQUALS NOTHING               -- March 12 itself is not "after" it
#ASSERT `reg 17.1(16) and (17) the Sunday after the day on which the hours and weeks are exactly the same` (JUST (YearMonthDay 2011 1 1)) EQUALS NOTHING
#ASSERT `reg 17.1(16) and (17) the Sunday after the day on which the hours and weeks are exactly the same` NOTHING EQUALS NOTHING
-- arguments: the day; the Sunday on which the subsections cease to have effect, if they have ceased
#ASSERT `reg 17.1(16) and (17) the subsection has effect on the day` (YearMonthDay 2011 4 9) NOTHING
#ASSERT `reg 17.1(16) and (17) the subsection has effect on the day` (YearMonthDay 2011 4 9) (JUST (YearMonthDay 2011 4 10))
#ASSERT NOT (`reg 17.1(16) and (17) the subsection has effect on the day` (YearMonthDay 2011 4 10) (JUST (YearMonthDay 2011 4 10)))    -- "cease to have effect on the Sunday"
#ASSERT NOT (`reg 17.1(16) and (17) the subsection has effect on the day` (YearMonthDay 2011 4 11) (JUST (YearMonthDay 2011 4 10)))

§ `Regulation 17.1(18) - the Commission's notice (src:334)`

-- arguments: the condition of (16) or (17) is satisfied; published in the Canada Gazette; published on the Commission's website; published as soon as possible
#ASSERT `reg 17.1(18) the Commission has published the notice as required` FALSE FALSE FALSE FALSE     -- no duty has arisen
#ASSERT `reg 17.1(18) the Commission has published the notice as required` TRUE TRUE TRUE TRUE
#ASSERT NOT (`reg 17.1(18) the Commission has published the notice as required` TRUE FALSE TRUE TRUE)  -- not in the Canada Gazette
#ASSERT NOT (`reg 17.1(18) the Commission has published the notice as required` TRUE TRUE FALSE TRUE)  -- not on the website: "must also publish the notice on its website"
#ASSERT NOT (`reg 17.1(18) the Commission has published the notice as required` TRUE TRUE TRUE FALSE)  -- not as soon as possible

§ `Regulation 17 and 17.1 - the rate that applies (src:242, 258)`

#ASSERT `reg 17.1 the first answer that applies` (LIST NOTHING, (JUST 0.07), (JUST 0.09)) EQUALS JUST 0.07
#ASSERT `reg 17.1 the first answer that applies` (LIST (JUST 0.05)) EQUALS JUST 0.05
#ASSERT `reg 17.1 the first answer that applies` (LIST NOTHING, NOTHING) EQUALS NOTHING
#ASSERT `reg 17.1 the first answer that applies` EMPTY EQUALS NOTHING
-- arguments: the answer under reg 17.1; the answer under reg 17(1.1) to (3)
#ASSERT `reg 17 and reg 17.1 the regional rate of unemployment that applies to the claimant` (JUST 0.09) (JUST 0.07) EQUALS JUST 0.09
#ASSERT `reg 17 and reg 17.1 the regional rate of unemployment that applies to the claimant` NOTHING (JUST 0.07) EQUALS JUST 0.07
#ASSERT `reg 17 and reg 17.1 the regional rate of unemployment that applies to the claimant` NOTHING NOTHING EQUALS NOTHING
-- with the core: the band of the rate that applies
#ASSERT `the band of the regional rate of unemployment` 0.09 EQUALS `more than 8% but not more than 9%`
#ASSERT `the band of the regional rate of unemployment` 0.066 EQUALS `more than 6% but not more than 7%`

§ `Regulation 18 - regions (src:337-338)`

#ASSERT `reg 18(1) the region is established for the purposes of Parts I and VIII of the Act` TRUE
#ASSERT NOT (`reg 18(1) the region is established for the purposes of Parts I and VIII of the Act` FALSE)
-- arguments: the day of the most recent review (or the day subsection (1) came into force if none); the day in question
#ASSERT `reg 18(2) the Commission's review of the boundaries is not overdue` (YearMonthDay 2020 1 1) (YearMonthDay 2021 6 1)
#ASSERT `reg 18(2) the Commission's review of the boundaries is not overdue` (YearMonthDay 2020 1 1) (YearMonthDay 2025 1 1)             -- the fifth anniversary itself: "at least once every five years"
#ASSERT NOT (`reg 18(2) the Commission's review of the boundaries is not overdue` (YearMonthDay 2020 1 1) (YearMonthDay 2025 1 2))       -- one day later
#ASSERT `reg 18(2) the Commission's review of the boundaries is not overdue` (YearMonthDay 2020 2 29) (YearMonthDay 2025 2 28)            -- a 29 February review: the fifth anniversary is 28 February (the keel's `add years` convention, F1)
#ASSERT NOT (`reg 18(2) the Commission's review of the boundaries is not overdue` (YearMonthDay 2020 2 29) (YearMonthDay 2025 3 1))
