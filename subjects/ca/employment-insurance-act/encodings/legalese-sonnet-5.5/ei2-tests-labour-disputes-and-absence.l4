IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `ei2-nouns`
IMPORT `ei2-labour-disputes-and-absence`

-- Tests of ei2-labour-disputes-and-absence (ss 36 and 37). Expected values are written by hand from the text.

§ `s 36(5) - separate departments`

#ASSERT `s 36(5) each department is a separate factory or workshop` TRUE EQUALS JUST TRUE
-- Otherwise the subsection deems nothing.
#ASSERT `s 36(5) each department is a separate factory or workshop` FALSE EQUALS NOTHING

§ `s 36(1) - the disentitlement`

-- Lost the employment because of a work stoppage attributable to a labour dispute at the premises; the stoppage continues;
-- not yet regularly engaged elsewhere: not entitled.
#ASSERT `s 36(1) the claimant is not entitled to receive benefits` TRUE TRUE FALSE FALSE
-- "unable to resume" is covered by the same first limb.
#ASSERT `s 36(1) the claimant is not entitled to receive benefits` TRUE TRUE FALSE FALSE
-- (a) the end of the work stoppage ends the disentitlement
#ASSERT NOT `s 36(1) the claimant is not entitled to receive benefits` TRUE TRUE TRUE FALSE
-- (b) the day the claimant becomes regularly engaged elsewhere in insurable employment ends it ("the earlier of")
#ASSERT NOT `s 36(1) the claimant is not entitled to receive benefits` TRUE TRUE FALSE TRUE
-- both have happened
#ASSERT NOT `s 36(1) the claimant is not entitled to receive benefits` TRUE TRUE TRUE TRUE
-- the stoppage is not attributable to a labour dispute at the claimant's premises
#ASSERT NOT `s 36(1) the claimant is not entitled to receive benefits` TRUE FALSE FALSE FALSE
-- the claimant did not lose or fail to resume an employment because of it
#ASSERT NOT `s 36(1) the claimant is not entitled to receive benefits` FALSE TRUE FALSE FALSE

§ `s 36(3) - suspension`

-- (a) established as otherwise entitled to special benefits (here sickness), and (b) anticipated absence and arrangements begun
#ASSERT `s 36(3) the disentitlement is suspended for the period` TRUE `a prescribed illness, injury or quarantine` FALSE TRUE TRUE
-- (a) by virtue of section 25 instead
#ASSERT `s 36(3) the disentitlement is suspended for the period` FALSE `pregnancy` TRUE TRUE TRUE
-- regular benefits only are not special benefits
#ASSERT NOT `s 36(3) the disentitlement is suspended for the period` TRUE `a reason other than those mentioned in subsection 12(3)` FALSE TRUE TRUE
-- (a) not established
#ASSERT NOT `s 36(3) the disentitlement is suspended for the period` FALSE `pregnancy` FALSE TRUE TRUE
-- (b) not established: no anticipated absence, or no arrangements begun
#ASSERT NOT `s 36(3) the disentitlement is suspended for the period` TRUE `pregnancy` FALSE FALSE TRUE
#ASSERT NOT `s 36(3) the disentitlement is suspended for the period` TRUE `pregnancy` FALSE TRUE FALSE

§ `s 36(4) - not participating, financing or directly interested`

#ASSERT `s 36(4) this section does not apply to the claimant` TRUE TRUE TRUE
#ASSERT NOT `s 36(4) this section does not apply to the claimant` FALSE TRUE TRUE
#ASSERT NOT `s 36(4) this section does not apply to the claimant` TRUE FALSE TRUE
#ASSERT NOT `s 36(4) this section does not apply to the claimant` TRUE TRUE FALSE

§ `s 36 as a whole`

#ASSERT `s 36 the claimant is disentitled on the day` TRUE FALSE FALSE
#ASSERT NOT `s 36 the claimant is disentitled on the day` TRUE TRUE FALSE
#ASSERT NOT `s 36 the claimant is disentitled on the day` TRUE FALSE TRUE
#ASSERT NOT `s 36 the claimant is disentitled on the day` FALSE FALSE FALSE

§ `s 37 - inmates and persons outside Canada`

#ASSERT `s 37 the claimant is not entitled to receive benefits for the period` TRUE FALSE FALSE
#ASSERT `s 37 the claimant is not entitled to receive benefits for the period` FALSE TRUE FALSE
#ASSERT `s 37 the claimant is not entitled to receive benefits for the period` TRUE TRUE FALSE
-- "Except as may otherwise be prescribed": a prescribed exception covers the claimant.
#ASSERT NOT `s 37 the claimant is not entitled to receive benefits for the period` TRUE FALSE TRUE
#ASSERT NOT `s 37 the claimant is not entitled to receive benefits for the period` FALSE TRUE TRUE
-- Neither an inmate nor outside Canada.
#ASSERT NOT `s 37 the claimant is not entitled to receive benefits for the period` FALSE FALSE FALSE
