IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `ei3-part4-offences`

-- Tests of ei3-part4-offences.l4 (Act ss 106 and 107).
-- Expected values are hand-worked from the text of the section named beside each assertion. Every figure is invented.

§ `s 106(1) to (3)`

#ASSERT `s 106(1) the employer is guilty of an offence` TRUE FALSE
#ASSERT `s 106(1) the employer is guilty of an offence` FALSE TRUE
#ASSERT NOT (`s 106(1) the employer is guilty of an offence` FALSE FALSE)
-- A fine of not more than $5,000 and/or imprisonment of not more than six months.
#ASSERT `s 106(1) the punishment is within what the subsection allows on summary conviction` 5_000 6
#ASSERT `s 106(1) the punishment is within what the subsection allows on summary conviction` 0 0
#ASSERT NOT (`s 106(1) the punishment is within what the subsection allows on summary conviction` 5_001 6)
#ASSERT NOT (`s 106(1) the punishment is within what the subsection allows on summary conviction` 5_000 7)
#ASSERT `s 106(2) the person is guilty of an offence punishable on summary conviction` TRUE FALSE
#ASSERT `s 106(2) the person is guilty of an offence punishable on summary conviction` FALSE TRUE
#ASSERT NOT (`s 106(2) the person is guilty of an offence punishable on summary conviction` FALSE FALSE)
#ASSERT `s 106(3) the person is guilty of an offence` TRUE
#ASSERT NOT (`s 106(3) the person is guilty of an offence` FALSE)
-- (3) Not less than $25 a day, but not more than $1,000 in all: 10 days is 250; 40 days is 1,000; 41 days would be 1,025, so the
-- ceiling prevails (fork F-ei3-24).
#ASSERT `s 106(3) the least fine` 0 EQUALS 0
#ASSERT `s 106(3) the least fine` 10 EQUALS 250
#ASSERT `s 106(3) the least fine` 39 EQUALS 975
#ASSERT `s 106(3) the least fine` 40 EQUALS 1_000
#ASSERT `s 106(3) the least fine` 41 EQUALS 1_000
#ASSERT `s 106(3) the most the fine can be in all` EQUALS 1_000

§ `s 106(4) to (6)`

#ASSERT `s 106(4) the person is guilty of an offence` TRUE FALSE FALSE FALSE FALSE
#ASSERT `s 106(4) the person is guilty of an offence` FALSE TRUE FALSE FALSE FALSE
#ASSERT `s 106(4) the person is guilty of an offence` FALSE FALSE TRUE FALSE FALSE
#ASSERT `s 106(4) the person is guilty of an offence` FALSE FALSE FALSE TRUE FALSE
#ASSERT `s 106(4) the person is guilty of an offence` FALSE FALSE FALSE FALSE TRUE
#ASSERT NOT (`s 106(4) the person is guilty of an offence` FALSE FALSE FALSE FALSE FALSE)
-- (5) Arguments: the fine (not counting the premium addition); the addition; the premium that should have been shown or was sought to be
-- evaded; imprisonment in months. A fine of $25 to $5,000, plus up to double the premium, and up to six months.
#ASSERT `s 106(5) the punishment is within what the subsection allows on summary conviction` 25 0 100 0
#ASSERT NOT (`s 106(5) the punishment is within what the subsection allows on summary conviction` 24.99 0 100 0)
#ASSERT `s 106(5) the punishment is within what the subsection allows on summary conviction` 5_000 0 100 6
#ASSERT NOT (`s 106(5) the punishment is within what the subsection allows on summary conviction` 5_000.01 0 100 0)
#ASSERT `s 106(5) the punishment is within what the subsection allows on summary conviction` 1_000 200 100 0
#ASSERT NOT (`s 106(5) the punishment is within what the subsection allows on summary conviction` 1_000 200.01 100 0)
#ASSERT NOT (`s 106(5) the punishment is within what the subsection allows on summary conviction` 1_000 (0 MINUS 1) 100 0)
#ASSERT NOT (`s 106(5) the punishment is within what the subsection allows on summary conviction` 1_000 0 100 7)
-- (6) Convicted: not liable to the penalty too, unless assessed or demanded before the information was laid. Not convicted: silent.
#ASSERT `s 106(6) the person is liable to pay the penalty for the same contravention` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 106(6) the person is liable to pay the penalty for the same contravention` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 106(6) the person is liable to pay the penalty for the same contravention` FALSE TRUE EQUALS NOTHING
#ASSERT `s 106(6) the person is liable to pay the penalty for the same contravention` FALSE FALSE EQUALS NOTHING

§ `s 107 officers, directors and agents`

#ASSERT `s 107 the officer, director or agent is a party to and guilty of the offence and liable on conviction to the punishment` TRUE TRUE TRUE
#ASSERT NOT (`s 107 the officer, director or agent is a party to and guilty of the offence and liable on conviction to the punishment` FALSE TRUE TRUE)
#ASSERT NOT (`s 107 the officer, director or agent is a party to and guilty of the offence and liable on conviction to the punishment` TRUE FALSE TRUE)
#ASSERT NOT (`s 107 the officer, director or agent is a party to and guilty of the offence and liable on conviction to the punishment` TRUE TRUE FALSE)
