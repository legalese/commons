IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `ei5-benefit-period`

-- Tests of ei5-benefit-period (Act ss 152.1, 152.11 and 152.12). Expected values are written by hand from the text
-- beside each assertion. Calendar facts used: 2026-06-07 is a Sunday; 2026-10-24 is a Saturday.

§ `152.1 establishment`

#ASSERT `s 152.1(1) a benefit period shall be established` TRUE TRUE
#ASSERT NOT (`s 152.1(1) a benefit period shall be established` FALSE TRUE)
#ASSERT NOT (`s 152.1(1) a benefit period shall be established` TRUE FALSE)

-- benefits are payable for a week of unemployment that falls in the established benefit period
#ASSERT `s 152.1(1) benefits are payable for the week` TRUE TRUE TRUE
#ASSERT NOT (`s 152.1(1) benefits are payable for the week` FALSE TRUE TRUE)
#ASSERT NOT (`s 152.1(1) benefits are payable for the week` TRUE FALSE TRUE)
#ASSERT NOT (`s 152.1(1) benefits are payable for the week` TRUE TRUE FALSE)

#ASSERT `s 152.1(2) the conditions for establishing a benefit period are met` TRUE TRUE
#ASSERT NOT (`s 152.1(2) the conditions for establishing a benefit period are met` TRUE FALSE)
#ASSERT NOT (`s 152.1(2) the conditions for establishing a benefit period are met` FALSE TRUE)

§ `152.11(1) and (3) when it begins, and a prior benefit period`

-- Interruption of earnings on Wednesday 10 June 2026 (week of Sunday 7 June); claim on Wednesday 17 June (week of 14 June):
-- the later Sunday, 14 June
#ASSERT `s 152.11(1) the day on which a benefit period begins` (YearMonthDay 2026 6 10) (YearMonthDay 2026 6 17) EQUALS YearMonthDay 2026 6 14
-- claim made in an earlier week (Monday 1 June, week of 31 May): the interruption's Sunday, 7 June
#ASSERT `s 152.11(1) the day on which a benefit period begins` (YearMonthDay 2026 6 10) (YearMonthDay 2026 6 1) EQUALS YearMonthDay 2026 6 7
-- same week (Sunday 7 June and Saturday 13 June): that Sunday
#ASSERT `s 152.11(1) the day on which a benefit period begins` (YearMonthDay 2026 6 7) (YearMonthDay 2026 6 13) EQUALS YearMonthDay 2026 6 7
-- claim on Sunday 14 June
#ASSERT `s 152.11(1) the day on which a benefit period begins` (YearMonthDay 2026 6 10) (YearMonthDay 2026 6 14) EQUALS YearMonthDay 2026 6 14

-- (2) a benefit period of 52 whole weeks that begins on Sunday 14 June 2026 ends on the Saturday 363 days later (52 x 7 - 1),
-- 12 June 2027
#ASSERT `s 152.11(2) the day on which the benefit period would otherwise end` (YearMonthDay 2026 6 14) 52 EQUALS YearMonthDay 2027 6 12
-- 104 weeks: 14 June 2026 + 727 days = Saturday 10 June 2028 (leap day 29 February 2028 included)
#ASSERT `s 152.11(2) the day on which the benefit period would otherwise end` (YearMonthDay 2026 6 14) 104 EQUALS YearMonthDay 2028 6 10
-- 58 weeks: 14 June 2026 + 405 days = Saturday 24 July 2027
#ASSERT `s 152.11(2) the day on which the benefit period would otherwise end` (YearMonthDay 2026 6 14) 58 EQUALS YearMonthDay 2027 7 24

#ASSERT `s 152.11(3) a benefit period may be established despite a prior benefit period` FALSE
#ASSERT NOT (`s 152.11(3) a benefit period may be established despite a prior benefit period` TRUE)
-- qualifies, claims, conditions of (2) met, no prior benefit period open
#ASSERT `s 152.1 and s 152.11(3) a benefit period is established` TRUE TRUE TRUE FALSE
#ASSERT NOT (`s 152.1 and s 152.11(3) a benefit period is established` FALSE TRUE TRUE FALSE)
#ASSERT NOT (`s 152.1 and s 152.11(3) a benefit period is established` TRUE FALSE TRUE FALSE)
#ASSERT NOT (`s 152.1 and s 152.11(3) a benefit period is established` TRUE TRUE FALSE FALSE)
#ASSERT NOT (`s 152.1 and s 152.11(3) a benefit period is established` TRUE TRUE TRUE TRUE)

§ `152.11(4) to (6.2) late claims`

#ASSERT `s 152.11(5.1) that fact is good cause for a delay in making a claim` TRUE
#ASSERT NOT (`s 152.11(5.1) that fact is good cause for a delay in making a claim` FALSE)

#ASSERT `ss 152.11(6), (6.1) and (6.2) the claim is not regarded as made on an earlier day` TRUE FALSE FALSE
#ASSERT `ss 152.11(6), (6.1) and (6.2) the claim is not regarded as made on an earlier day` FALSE TRUE FALSE
#ASSERT `ss 152.11(6), (6.1) and (6.2) the claim is not regarded as made on an earlier day` FALSE FALSE TRUE
#ASSERT NOT (`ss 152.11(6), (6.1) and (6.2) the claim is not regarded as made on an earlier day` FALSE FALSE FALSE)

-- (4) arguments: day the claim was made, day the person first qualified, the earlier day claimed, qualified on the earlier day,
-- good cause shown, but for 152.07(1)(d)(i)(A) would not have qualified, (6) exception
-- claim made 17 June 2026, first qualified 1 March; regarded as made on 1 April
#ASSERT `s 152.11(4) the day on which an initial claim for benefits is regarded as having been made` (YearMonthDay 2026 6 17) (YearMonthDay 2026 3 1) (YearMonthDay 2026 4 1) TRUE TRUE FALSE FALSE EQUALS YearMonthDay 2026 4 1
-- no good cause, but the $5,000 clause (5.1) supplies it
#ASSERT `s 152.11(4) the day on which an initial claim for benefits is regarded as having been made` (YearMonthDay 2026 6 17) (YearMonthDay 2026 3 1) (YearMonthDay 2026 4 1) TRUE FALSE TRUE FALSE EQUALS YearMonthDay 2026 4 1
-- no good cause at all
#ASSERT `s 152.11(4) the day on which an initial claim for benefits is regarded as having been made` (YearMonthDay 2026 6 17) (YearMonthDay 2026 3 1) (YearMonthDay 2026 4 1) TRUE FALSE FALSE FALSE EQUALS YearMonthDay 2026 6 17
-- did not qualify on the earlier day
#ASSERT `s 152.11(4) the day on which an initial claim for benefits is regarded as having been made` (YearMonthDay 2026 6 17) (YearMonthDay 2026 3 1) (YearMonthDay 2026 4 1) FALSE TRUE FALSE FALSE EQUALS YearMonthDay 2026 6 17
-- a caring claim to which (6), (6.1) or (6.2) takes the antedating away
#ASSERT `s 152.11(4) the day on which an initial claim for benefits is regarded as having been made` (YearMonthDay 2026 6 17) (YearMonthDay 2026 3 1) (YearMonthDay 2026 4 1) TRUE TRUE FALSE TRUE EQUALS YearMonthDay 2026 6 17
-- the claim was not made after the day the person first qualified (made the same day)
#ASSERT `s 152.11(4) the day on which an initial claim for benefits is regarded as having been made` (YearMonthDay 2026 3 1) (YearMonthDay 2026 3 1) (YearMonthDay 2026 2 1) TRUE TRUE FALSE FALSE EQUALS YearMonthDay 2026 3 1
-- an "earlier" day that is not earlier
#ASSERT `s 152.11(4) the day on which an initial claim for benefits is regarded as having been made` (YearMonthDay 2026 6 17) (YearMonthDay 2026 3 1) (YearMonthDay 2026 6 17) TRUE TRUE FALSE FALSE EQUALS YearMonthDay 2026 6 17

-- (5) arguments: day the claim was made, made after the prescribed time, the earlier day, good cause shown, (5.1) fact, (6) exception
#ASSERT `s 152.11(5) the day on which a claim other than an initial claim is regarded as having been made` (YearMonthDay 2026 6 17) TRUE (YearMonthDay 2026 5 20) TRUE FALSE FALSE EQUALS YearMonthDay 2026 5 20
#ASSERT `s 152.11(5) the day on which a claim other than an initial claim is regarded as having been made` (YearMonthDay 2026 6 17) TRUE (YearMonthDay 2026 5 20) FALSE TRUE FALSE EQUALS YearMonthDay 2026 5 20
#ASSERT `s 152.11(5) the day on which a claim other than an initial claim is regarded as having been made` (YearMonthDay 2026 6 17) TRUE (YearMonthDay 2026 5 20) FALSE FALSE FALSE EQUALS YearMonthDay 2026 6 17
-- within the prescribed time: nothing to antedate
#ASSERT `s 152.11(5) the day on which a claim other than an initial claim is regarded as having been made` (YearMonthDay 2026 6 17) FALSE (YearMonthDay 2026 5 20) TRUE FALSE FALSE EQUALS YearMonthDay 2026 6 17
#ASSERT `s 152.11(5) the day on which a claim other than an initial claim is regarded as having been made` (YearMonthDay 2026 6 17) TRUE (YearMonthDay 2026 5 20) TRUE FALSE TRUE EQUALS YearMonthDay 2026 6 17

§ `152.11(7) to (10) cancelling and ending`

#ASSERT `s 152.11(7)(a) the Commission may cancel the benefit period` TRUE TRUE
#ASSERT NOT (`s 152.11(7)(a) the Commission may cancel the benefit period` FALSE TRUE)
#ASSERT NOT (`s 152.11(7)(a) the Commission may cancel the benefit period` TRUE FALSE)
#ASSERT `s 152.11(7)(b) the Commission may cancel the portion of the benefit period immediately before the first week for which benefits were paid or payable` TRUE TRUE TRUE
#ASSERT NOT (`s 152.11(7)(b) the Commission may cancel the portion of the benefit period immediately before the first week for which benefits were paid or payable` FALSE TRUE TRUE)
#ASSERT NOT (`s 152.11(7)(b) the Commission may cancel the portion of the benefit period immediately before the first week for which benefits were paid or payable` TRUE FALSE TRUE)
#ASSERT NOT (`s 152.11(7)(b) the Commission may cancel the portion of the benefit period immediately before the first week for which benefits were paid or payable` TRUE TRUE FALSE)
#ASSERT `s 152.11(8) the benefit period or portion of it is treated as having begun` FALSE
#ASSERT NOT (`s 152.11(8) the benefit period or portion of it is treated as having begun` TRUE)

-- (9)(c): the day the last of the three has happened
#ASSERT `s 152.11(9)(c) the day on which the person has requested the end of the benefit period, made a new initial claim and qualified` (JUST (YearMonthDay 2026 5 1)) (JUST (YearMonthDay 2026 5 15)) (JUST (YearMonthDay 2026 5 10)) EQUALS JUST (YearMonthDay 2026 5 15)
#ASSERT `s 152.11(9)(c) the day on which the person has requested the end of the benefit period, made a new initial claim and qualified` (JUST (YearMonthDay 2026 5 20)) (JUST (YearMonthDay 2026 5 15)) (JUST (YearMonthDay 2026 5 10)) EQUALS JUST (YearMonthDay 2026 5 20)
#ASSERT `s 152.11(9)(c) the day on which the person has requested the end of the benefit period, made a new initial claim and qualified` (JUST (YearMonthDay 2026 5 1)) (JUST (YearMonthDay 2026 5 15)) (JUST (YearMonthDay 2026 5 30)) EQUALS JUST (YearMonthDay 2026 5 30)
-- while any of the three has not happened
#ASSERT `s 152.11(9)(c) the day on which the person has requested the end of the benefit period, made a new initial claim and qualified` NOTHING (JUST (YearMonthDay 2026 5 15)) (JUST (YearMonthDay 2026 5 10)) EQUALS NOTHING
#ASSERT `s 152.11(9)(c) the day on which the person has requested the end of the benefit period, made a new initial claim and qualified` (JUST (YearMonthDay 2026 5 1)) NOTHING (JUST (YearMonthDay 2026 5 10)) EQUALS NOTHING
#ASSERT `s 152.11(9)(c) the day on which the person has requested the end of the benefit period, made a new initial claim and qualified` (JUST (YearMonthDay 2026 5 1)) (JUST (YearMonthDay 2026 5 15)) NOTHING EQUALS NOTHING

-- (9) arguments: no further benefits payable (if any), the day it would otherwise end, the (c) day (if any); the first to occur ends it
#ASSERT `s 152.11(9) the day on which the benefit period ends` (JUST (YearMonthDay 2027 3 1)) (YearMonthDay 2027 6 6) NOTHING EQUALS YearMonthDay 2027 3 1
#ASSERT `s 152.11(9) the day on which the benefit period ends` NOTHING (YearMonthDay 2027 6 6) (JUST (YearMonthDay 2027 2 1)) EQUALS YearMonthDay 2027 2 1
#ASSERT `s 152.11(9) the day on which the benefit period ends` NOTHING (YearMonthDay 2027 6 6) NOTHING EQUALS YearMonthDay 2027 6 6
-- (a) later than the ordinary end: the ordinary end comes first
#ASSERT `s 152.11(9) the day on which the benefit period ends` (JUST (YearMonthDay 2027 8 1)) (YearMonthDay 2027 6 6) NOTHING EQUALS YearMonthDay 2027 6 6
-- all three: the earliest of them
#ASSERT `s 152.11(9) the day on which the benefit period ends` (JUST (YearMonthDay 2027 3 1)) (YearMonthDay 2027 6 6) (JUST (YearMonthDay 2027 2 1)) EQUALS YearMonthDay 2027 2 1

#ASSERT `s 152.11(10) the day on which a request that the benefit period end is regarded as having been made` (YearMonthDay 2026 6 1) (YearMonthDay 2026 5 1) TRUE EQUALS YearMonthDay 2026 5 1
#ASSERT `s 152.11(10) the day on which a request that the benefit period end is regarded as having been made` (YearMonthDay 2026 6 1) (YearMonthDay 2026 5 1) FALSE EQUALS YearMonthDay 2026 6 1
#ASSERT `s 152.11(10) the day on which a request that the benefit period end is regarded as having been made` (YearMonthDay 2026 6 1) (YearMonthDay 2026 6 1) TRUE EQUALS YearMonthDay 2026 6 1

§ `152.11(2) and (11) to (16) length and extension`

-- (11) 3 weeks in jail, 2 weeks severance, 1 week workers' compensation, none for the provincial payment: 6 weeks
#ASSERT `s 152.11(11) the number of weeks by which the benefit period is extended` 3 2 1 0 EQUALS 6
#ASSERT `s 152.11(12) the number of weeks of the further extension` 2 EQUALS 2
#ASSERT `s 152.11(13) the number of weeks by which the benefit period is extended because the child or children are hospitalized` 4 EQUALS 4

-- (14) arguments: number of reasons paid, at least one paid for fewer than its maximum, the maximum total weeks
#ASSERT `s 152.11(14) the benefit period is extended so that those benefits may be paid up to the maximum total` 2 TRUE 87
#ASSERT NOT (`s 152.11(14) the benefit period is extended so that those benefits may be paid up to the maximum total` 1 TRUE 87)
#ASSERT NOT (`s 152.11(14) the benefit period is extended so that those benefits may be paid up to the maximum total` 2 FALSE 87)
#ASSERT NOT (`s 152.11(14) the benefit period is extended so that those benefits may be paid up to the maximum total` 2 TRUE 50)
#ASSERT `s 152.11(14) the benefit period is extended so that those benefits may be paid up to the maximum total` 2 TRUE 51

-- (14.1) arguments: paid for another reason, paid for (b), the election
#ASSERT `s 152.11(14.1) the number of weeks by which the benefit period is extended` FALSE TRUE `the 61-week maximum` EQUALS 26
#ASSERT `s 152.11(14.1) the number of weeks by which the benefit period is extended` TRUE TRUE `the 61-week maximum` EQUALS 0
#ASSERT `s 152.11(14.1) the number of weeks by which the benefit period is extended` FALSE FALSE `the 61-week maximum` EQUALS 0
#ASSERT `s 152.11(14.1) the number of weeks by which the benefit period is extended` FALSE TRUE `the 35-week maximum` EQUALS 0

-- (16) two weeks plus the maxima of the benefits paid: 26 (sickness) + 61 (parental) + 2 = 89
#ASSERT `s 152.11(16) the longest a benefit period extended under subsection (14) may be, in weeks` (LIST 26, 61) EQUALS 89
#ASSERT `s 152.11(16) the longest a benefit period extended under subsection (14) may be, in weeks` EMPTY EQUALS 2

-- length arguments: weeks under (11), (12), (13), the (14) extension, weeks under (14.1), the (16) limit
-- no extension: 52 weeks
#ASSERT `s 152.11(2), (15) and (16) the length of the benefit period, in weeks` 0 0 0 0 0 89 EQUALS 52
-- (11) alone: 52 + 6
#ASSERT `s 152.11(2), (15) and (16) the length of the benefit period, in weeks` 6 0 0 0 0 89 EQUALS 58
-- (11), (12) and (13): 52 + 10 + 5 + 4
#ASSERT `s 152.11(2), (15) and (16) the length of the benefit period, in weeks` 10 5 4 0 0 89 EQUALS 71
-- (14.1): 52 + 26
#ASSERT `s 152.11(2), (15) and (16) the length of the benefit period, in weeks` 0 0 0 0 26 89 EQUALS 78
-- (14) alone, 40 weeks: 92, over the (16) limit of 89, so 89
#ASSERT `s 152.11(2), (15) and (16) the length of the benefit period, in weeks` 0 0 0 40 0 89 EQUALS 89
-- (14) alone with a higher (16) limit: 92 stands
#ASSERT `s 152.11(2), (15) and (16) the length of the benefit period, in weeks` 0 0 0 40 0 100 EQUALS 92
-- (14) alone, 60 weeks: 112 is over 104, and over 89: 89
#ASSERT `s 152.11(2), (15) and (16) the length of the benefit period, in weeks` 0 0 0 60 0 89 EQUALS 89
-- (14) together with (11): the (16) limit does not apply ("unless the benefit period is also extended under (11) to (13)"): 94
#ASSERT `s 152.11(2), (15) and (16) the length of the benefit period, in weeks` 2 0 0 40 0 89 EQUALS 94
-- (15) 104 weeks at most: 52 + 52 = 104 exactly, and 53 more is still 104
#ASSERT `s 152.11(2), (15) and (16) the length of the benefit period, in weeks` 52 0 0 0 0 89 EQUALS 104
#ASSERT `s 152.11(2), (15) and (16) the length of the benefit period, in weeks` 53 0 0 0 0 89 EQUALS 104
#ASSERT `s 152.11(2), (15) and (16) the length of the benefit period, in weeks` 30 20 10 0 26 89 EQUALS 104

§ `152.12 notification`

#ASSERT `s 152.12 the person is owed a decision on whether they are qualified and notice of the decision` TRUE
#ASSERT NOT (`s 152.12 the person is owed a decision on whether they are qualified and notice of the decision` FALSE)
