IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `ei1-interpretation`

-- Tests of ei1-interpretation.l4 (Act s 6). Every expected value is written by hand from the text of the section
-- named beside the assertion; none is copied from the module's output. One #ASSERT per line.

§ `s 6(1) disentitled (src:138)`
-- Not entitled under section 13, 18, 21, 31, 32, 33, 36, 37, 49 or 50 or under the regulations: any one is enough.

#ASSERT NOT (`s 6(1) disentitled` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
#ASSERT `s 6(1) disentitled` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE   -- not entitled under section 13 alone
#ASSERT `s 6(1) disentitled` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE   -- not entitled under section 18 alone
#ASSERT `s 6(1) disentitled` FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE   -- not entitled under section 21 alone
#ASSERT `s 6(1) disentitled` FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE   -- not entitled under section 31 alone
#ASSERT `s 6(1) disentitled` FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE   -- not entitled under section 32 alone
#ASSERT `s 6(1) disentitled` FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE   -- not entitled under section 33 alone
#ASSERT `s 6(1) disentitled` FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE   -- not entitled under section 36 alone
#ASSERT `s 6(1) disentitled` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE   -- not entitled under section 37 alone
#ASSERT `s 6(1) disentitled` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE   -- not entitled under section 49 alone
#ASSERT `s 6(1) disentitled` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE   -- not entitled under section 50 alone
#ASSERT `s 6(1) disentitled` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE   -- not entitled under the regulations alone
#ASSERT `s 6(1) disentitled` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE

§ `s 6(1) disqualified (src:139)`
-- Disqualified under section 27 or 30.
#ASSERT NOT (`s 6(1) disqualified` FALSE FALSE)
#ASSERT `s 6(1) disqualified` TRUE FALSE
#ASSERT `s 6(1) disqualified` FALSE TRUE
#ASSERT `s 6(1) disqualified` TRUE TRUE

§ `s 6(1) initial claim for benefits (src:140)`
#ASSERT `s 6(1) initial claim for benefits` TRUE
#ASSERT NOT (`s 6(1) initial claim for benefits` FALSE)

§ `s 6(1) major and minor attachment claimants (src:141-142)`
-- "600 or more hours" is a major attachment claimant; "fewer than 600 hours" is a minor attachment claimant;
-- each must also be a claimant who qualifies to receive benefits.
#ASSERT `s 6(1) the number of hours of insurable employment that separates a major attachment claimant from a minor one` EQUALS 600
#ASSERT `s 6(1) major attachment claimant` TRUE 600
#ASSERT `s 6(1) major attachment claimant` TRUE 601
#ASSERT `s 6(1) major attachment claimant` TRUE 2000
#ASSERT NOT (`s 6(1) major attachment claimant` TRUE 599)
#ASSERT NOT (`s 6(1) major attachment claimant` TRUE 599.5)
#ASSERT NOT (`s 6(1) major attachment claimant` FALSE 800)
#ASSERT `s 6(1) minor attachment claimant` TRUE 599
#ASSERT `s 6(1) minor attachment claimant` TRUE 599.5
#ASSERT `s 6(1) minor attachment claimant` TRUE 0
#ASSERT NOT (`s 6(1) minor attachment claimant` TRUE 600)
#ASSERT NOT (`s 6(1) minor attachment claimant` TRUE 601)
#ASSERT NOT (`s 6(1) minor attachment claimant` FALSE 100)

§ `s 6(3) hours of insurable employment (src:148)`
-- The hours are those established under section 55 (piece ei2); this piece takes the figure as given.
#ASSERT `s 6(3) the hours of insurable employment that a claimant has in the qualifying period` 450 EQUALS 450
#ASSERT `s 6(3) the hours of insurable employment that a claimant has in the qualifying period` 0 EQUALS 0

§ `s 6(4)(a) work stoppage attributable to a labour dispute (src:150-151)`
#ASSERT `s 6(4)(a) employment arises in consequence of a work stoppage attributable to a labour dispute` TRUE
#ASSERT NOT (`s 6(4)(a) employment arises in consequence of a work stoppage attributable to a labour dispute` FALSE)

§ `s 6(4)(b) and s 6(5) benchmark (src:152, 155)`
-- By agreement between employers and employees if there is one, "in the absence of any such agreement" what good employers recognize.
-- args: there is an agreement, rate lower than the agreement's, conditions worse than the agreement's, rate lower than good employers', conditions worse than good employers'
#ASSERT `s 6(4)(b) and s 6(5) at a lower rate of earnings or on conditions less favourable than the benchmark` TRUE TRUE FALSE FALSE FALSE
#ASSERT `s 6(4)(b) and s 6(5) at a lower rate of earnings or on conditions less favourable than the benchmark` TRUE FALSE TRUE FALSE FALSE
#ASSERT NOT (`s 6(4)(b) and s 6(5) at a lower rate of earnings or on conditions less favourable than the benchmark` TRUE FALSE FALSE TRUE TRUE)
#ASSERT NOT (`s 6(4)(b) and s 6(5) at a lower rate of earnings or on conditions less favourable than the benchmark` TRUE FALSE FALSE FALSE FALSE)
#ASSERT `s 6(4)(b) and s 6(5) at a lower rate of earnings or on conditions less favourable than the benchmark` FALSE FALSE FALSE TRUE FALSE
#ASSERT `s 6(4)(b) and s 6(5) at a lower rate of earnings or on conditions less favourable than the benchmark` FALSE FALSE FALSE FALSE TRUE
#ASSERT NOT (`s 6(4)(b) and s 6(5) at a lower rate of earnings or on conditions less favourable than the benchmark` FALSE TRUE TRUE FALSE FALSE)
#ASSERT NOT (`s 6(4)(b) and s 6(5) at a lower rate of earnings or on conditions less favourable than the benchmark` FALSE FALSE FALSE FALSE FALSE)

§ `s 6(4)(b) usual occupation (src:152)`
#ASSERT `s 6(4)(b) employment in the claimant's usual occupation is at a lower rate or on less favourable conditions` TRUE TRUE
#ASSERT NOT (`s 6(4)(b) employment in the claimant's usual occupation is at a lower rate or on less favourable conditions` FALSE TRUE)
#ASSERT NOT (`s 6(4)(b) employment in the claimant's usual occupation is at a lower rate or on less favourable conditions` TRUE FALSE)

§ `s 6(4)(c) not the usual occupation (src:153)`
-- args: not in the usual occupation, lower rate than expected, less favourable conditions than expected
#ASSERT `s 6(4)(c) employment outside the claimant's usual occupation is at a lower rate or on less favourable conditions than the claimant might reasonably expect` TRUE TRUE FALSE
#ASSERT `s 6(4)(c) employment outside the claimant's usual occupation is at a lower rate or on less favourable conditions than the claimant might reasonably expect` TRUE FALSE TRUE
#ASSERT `s 6(4)(c) employment outside the claimant's usual occupation is at a lower rate or on less favourable conditions than the claimant might reasonably expect` TRUE TRUE TRUE
#ASSERT NOT (`s 6(4)(c) employment outside the claimant's usual occupation is at a lower rate or on less favourable conditions than the claimant might reasonably expect` TRUE FALSE FALSE)
#ASSERT NOT (`s 6(4)(c) employment outside the claimant's usual occupation is at a lower rate or on less favourable conditions than the claimant might reasonably expect` FALSE TRUE TRUE)

§ `s 6(5) reasonable interval (src:155)`
#ASSERT `s 6(5) paragraph 6(4)(c) does not apply after a reasonable interval` TRUE TRUE
#ASSERT NOT (`s 6(5) paragraph 6(4)(c) does not apply after a reasonable interval` FALSE TRUE)
#ASSERT NOT (`s 6(5) paragraph 6(4)(c) does not apply after a reasonable interval` TRUE FALSE)
#ASSERT NOT (`s 6(5) paragraph 6(4)(c) does not apply after a reasonable interval` FALSE FALSE)

§ `s 6(4) employment is not suitable (src:150)`
-- args: (a) applies, (b) applies, (c) applies, subsection (5) takes (c) out of play
#ASSERT `s 6(4) employment is not suitable employment` TRUE FALSE FALSE FALSE
#ASSERT `s 6(4) employment is not suitable employment` FALSE TRUE FALSE FALSE
#ASSERT `s 6(4) employment is not suitable employment` FALSE FALSE TRUE FALSE
#ASSERT NOT (`s 6(4) employment is not suitable employment` FALSE FALSE TRUE TRUE)
#ASSERT `s 6(4) employment is not suitable employment` TRUE FALSE TRUE TRUE
#ASSERT `s 6(4) employment is not suitable employment` FALSE TRUE TRUE TRUE
#ASSERT NOT (`s 6(4) employment is not suitable employment` FALSE FALSE FALSE FALSE)
#ASSERT NOT (`s 6(4) employment is not suitable employment` FALSE FALSE FALSE TRUE)
