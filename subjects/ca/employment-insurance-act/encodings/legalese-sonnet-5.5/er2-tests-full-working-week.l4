IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `er2-common`
IMPORT `er2-full-working-week`

-- Tests of er2-full-working-week (regulations 29 to 32). Every expected value is written by hand from the text of the regulation named
-- beside it and was decided before the run. One #ASSERT per line.
-- Calendar facts used: 4 March 2026 is a Wednesday, 1 October 2026 a Thursday (its week is Sunday 27 September to Saturday 3 October),
-- 31 March 2027 a Wednesday (its week is Sunday 28 March to Saturday 3 April), 25 December 2026 a Friday.

§ `Regulation 29(1) - railway employee on a mileage basis`

-- args: railway employee, mileage basis, remuneration in the two weeks, the maximum weekly insurable earnings (here 750)
#ASSERT     `reg 29(1) the claimant is considered to have worked a full working week during each week in the two-week period` TRUE TRUE 1500 750
#ASSERT NOT (`reg 29(1) the claimant is considered to have worked a full working week during each week in the two-week period` TRUE TRUE 1499.99 750)
#ASSERT     `reg 29(1) the claimant is considered to have worked a full working week during each week in the two-week period` TRUE TRUE 2000 750
#ASSERT NOT (`reg 29(1) the claimant is considered to have worked a full working week during each week in the two-week period` FALSE TRUE 2000 750)
#ASSERT NOT (`reg 29(1) the claimant is considered to have worked a full working week during each week in the two-week period` TRUE FALSE 2000 750)

§ `Regulation 29(2) - farming or horticulture`

-- args: employed in farming or horticulture, days worked, hours worked
#ASSERT     `reg 29(2) the claimant employed in farming or horticulture is considered to have worked a full working week` TRUE 5 35
#ASSERT     `reg 29(2) the claimant employed in farming or horticulture is considered to have worked a full working week` TRUE 6 40
#ASSERT NOT (`reg 29(2) the claimant employed in farming or horticulture is considered to have worked a full working week` TRUE 4 40)
#ASSERT NOT (`reg 29(2) the claimant employed in farming or horticulture is considered to have worked a full working week` TRUE 5 34.5)
#ASSERT NOT (`reg 29(2) the claimant employed in farming or horticulture is considered to have worked a full working week` FALSE 5 35)

§ `Regulation 29(3) - a holiday in the week`

-- args: does not work on a holiday, does not work the adjacent working day by reason of the holiday, remaining working days, of those, days on which at least the normal hours were worked
#ASSERT     `reg 29(3) the claimant is regarded as having worked a full working week despite a holiday` TRUE FALSE 4 4
#ASSERT NOT (`reg 29(3) the claimant is regarded as having worked a full working week despite a holiday` TRUE FALSE 4 3)
#ASSERT     `reg 29(3) the claimant is regarded as having worked a full working week despite a holiday` FALSE TRUE 3 3
#ASSERT NOT (`reg 29(3) the claimant is regarded as having worked a full working week despite a holiday` FALSE FALSE 4 4)
#ASSERT     `reg 29(3) the claimant is regarded as having worked a full working week despite a holiday` TRUE TRUE 3 3
#ASSERT     `reg 29(3) the claimant is regarded as having worked a full working week despite a holiday` TRUE FALSE 0 0

§ `Regulation 29(4) - remuneration for a period longer than a week`

`er2 test two weeks` MEANS `Period of days` OF (YearMonthDay 2026 3 1), (YearMonthDay 2026 3 14)
`er2 test a week` MEANS `Period of days` OF (YearMonthDay 2026 3 1), (YearMonthDay 2026 3 7)
`er2 test eight days` MEANS `Period of days` OF (YearMonthDay 2026 3 1), (YearMonthDay 2026 3 8)
`er2 test a ragged period` MEANS `Period of days` OF (YearMonthDay 2026 3 4), (YearMonthDay 2026 3 17)
-- args: usual remuneration is payable for the period regardless of work, the period, a day in the week
#ASSERT     `reg 29(4) the week is a full working week for the insured person` TRUE `er2 test two weeks` (YearMonthDay 2026 3 4)
#ASSERT     `reg 29(4) the week is a full working week for the insured person` TRUE `er2 test two weeks` (YearMonthDay 2026 3 10)
#ASSERT NOT (`reg 29(4) the week is a full working week for the insured person` TRUE `er2 test two weeks` (YearMonthDay 2026 3 15))
-- a week that falls only partly in the period is not one that "falls wholly" in it
#ASSERT NOT (`reg 29(4) the week is a full working week for the insured person` TRUE `er2 test a ragged period` (YearMonthDay 2026 3 4))
#ASSERT     `reg 29(4) the week is a full working week for the insured person` TRUE `er2 test a ragged period` (YearMonthDay 2026 3 10)
-- the period must be greater than a week: seven days is a week, eight days is more
#ASSERT NOT (`reg 29(4) the week is a full working week for the insured person` TRUE `er2 test a week` (YearMonthDay 2026 3 4))
#ASSERT     `reg 29(4) the week is a full working week for the insured person` TRUE `er2 test eight days` (YearMonthDay 2026 3 4)
#ASSERT NOT (`reg 29(4) the week is a full working week for the insured person` FALSE `er2 test two weeks` (YearMonthDay 2026 3 4))

§ `Regulation 30(5) - self-employed person`

-- args: is or was engaged in a business, is employed, the employer is a corporation, the portion of the voting shares the individual controls
#ASSERT     `reg 30(5) self-employed person` TRUE FALSE FALSE 0
#ASSERT     `reg 30(5) self-employed person` FALSE TRUE TRUE (41%)
#ASSERT NOT (`reg 30(5) self-employed person` FALSE TRUE TRUE (40%))
#ASSERT NOT (`reg 30(5) self-employed person` FALSE TRUE FALSE (90%))
#ASSERT NOT (`reg 30(5) self-employed person` FALSE FALSE FALSE 0)

§ `Regulation 30(1) to (3) - what is considered a full working week`

-- args: self-employed, own account, partnership, co-adventure, other employment controlling working hours
#ASSERT     `reg 30(1) the claimant's work in the week is of a kind that is considered a full working week, before subsections (2) and (4)` TRUE FALSE FALSE FALSE FALSE
#ASSERT     `reg 30(1) the claimant's work in the week is of a kind that is considered a full working week, before subsections (2) and (4)` FALSE TRUE FALSE FALSE FALSE
#ASSERT     `reg 30(1) the claimant's work in the week is of a kind that is considered a full working week, before subsections (2) and (4)` FALSE FALSE TRUE FALSE FALSE
#ASSERT     `reg 30(1) the claimant's work in the week is of a kind that is considered a full working week, before subsections (2) and (4)` FALSE FALSE FALSE TRUE FALSE
#ASSERT     `reg 30(1) the claimant's work in the week is of a kind that is considered a full working week, before subsections (2) and (4)` FALSE FALSE FALSE FALSE TRUE
#ASSERT NOT (`reg 30(1) the claimant's work in the week is of a kind that is considered a full working week, before subsections (2) and (4)` FALSE FALSE FALSE FALSE FALSE)
-- (2): a minor extent
#ASSERT     `reg 30(2) the claimant is not regarded as working a full working week in respect of that employment or engagement` TRUE TRUE
#ASSERT NOT (`reg 30(2) the claimant is not regarded as working a full working week in respect of that employment or engagement` TRUE FALSE)
#ASSERT NOT (`reg 30(2) the claimant is not regarded as working a full working week in respect of that employment or engagement` FALSE TRUE)
-- (3): the six circumstances, in the order of the paragraphs
#ASSERT count `reg 30(3) the circumstances to be considered in determining whether employment or engagement is of a minor extent` EQUALS 6
#ASSERT elem `er2 the time spent` `reg 30(3) the circumstances to be considered in determining whether employment or engagement is of a minor extent`
#ASSERT elem `er2 the claimant's intention and willingness to seek and immediately accept alternate employment` `reg 30(3) the circumstances to be considered in determining whether employment or engagement is of a minor extent`

§ `Regulation 30(4) - farming from October to March`

-- the period for the 1 October 2026: Sunday 27 September 2026 to Saturday 3 April 2027
#ASSERT `reg 30(4) the period that begins with the week in which October 1st falls and ends with the week in which the following March 31 falls` 2026 EQUALS `Period of days` OF (YearMonthDay 2026 9 27), (YearMonthDay 2027 4 3)
#ASSERT     `reg 30(4) the week falls in the period from the week of October 1st to the week of the following March 31` (YearMonthDay 2026 9 30)
#ASSERT NOT (`reg 30(4) the week falls in the period from the week of October 1st to the week of the following March 31` (YearMonthDay 2026 9 26))
#ASSERT     `reg 30(4) the week falls in the period from the week of October 1st to the week of the following March 31` (YearMonthDay 2026 12 1)
#ASSERT     `reg 30(4) the week falls in the period from the week of October 1st to the week of the following March 31` (YearMonthDay 2027 1 15)
#ASSERT     `reg 30(4) the week falls in the period from the week of October 1st to the week of the following March 31` (YearMonthDay 2027 4 3)
#ASSERT NOT (`reg 30(4) the week falls in the period from the week of October 1st to the week of the following March 31` (YearMonthDay 2027 4 4))
#ASSERT NOT (`reg 30(4) the week falls in the period from the week of October 1st to the week of the following March 31` (YearMonthDay 2026 6 15))
-- args: employed in farming, (2) does not apply, a day in the week, proves did not work, proves minor extent
#ASSERT     `reg 30(4) the claimant employed in farming is not considered to have worked a full working week in the week` TRUE TRUE (YearMonthDay 2026 12 1) TRUE FALSE
#ASSERT     `reg 30(4) the claimant employed in farming is not considered to have worked a full working week in the week` TRUE TRUE (YearMonthDay 2026 12 1) FALSE TRUE
#ASSERT NOT (`reg 30(4) the claimant employed in farming is not considered to have worked a full working week in the week` TRUE TRUE (YearMonthDay 2026 12 1) FALSE FALSE)
#ASSERT NOT (`reg 30(4) the claimant employed in farming is not considered to have worked a full working week in the week` TRUE FALSE (YearMonthDay 2026 12 1) TRUE TRUE)
#ASSERT NOT (`reg 30(4) the claimant employed in farming is not considered to have worked a full working week in the week` FALSE TRUE (YearMonthDay 2026 12 1) TRUE TRUE)
#ASSERT NOT (`reg 30(4) the claimant employed in farming is not considered to have worked a full working week in the week` TRUE TRUE (YearMonthDay 2026 6 15) TRUE TRUE)

§ `Regulation 30 - the result for a week`

-- args: kind described in (1), minor-extent judgment, employed in farming, a day in the week, proves did not work, proves minor extent
#ASSERT `reg 30 whether the claimant is considered to have worked a full working week in the week` FALSE FALSE FALSE (YearMonthDay 2026 12 1) FALSE FALSE EQUALS NOTHING
#ASSERT `reg 30 whether the claimant is considered to have worked a full working week in the week` TRUE FALSE FALSE (YearMonthDay 2026 12 1) FALSE FALSE EQUALS JUST TRUE
#ASSERT `reg 30 whether the claimant is considered to have worked a full working week in the week` TRUE TRUE FALSE (YearMonthDay 2026 12 1) FALSE FALSE EQUALS JUST FALSE
-- (4) prevails over (1) in the winter, but not in the summer, and not without proof
#ASSERT `reg 30 whether the claimant is considered to have worked a full working week in the week` TRUE FALSE TRUE (YearMonthDay 2026 12 1) TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 30 whether the claimant is considered to have worked a full working week in the week` TRUE FALSE TRUE (YearMonthDay 2026 6 15) TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 30 whether the claimant is considered to have worked a full working week in the week` TRUE FALSE TRUE (YearMonthDay 2026 12 1) FALSE FALSE EQUALS JUST TRUE
-- (4) applies only where (2) does not
#ASSERT `reg 30 whether the claimant is considered to have worked a full working week in the week` TRUE TRUE TRUE (YearMonthDay 2026 12 1) TRUE FALSE EQUALS JUST FALSE

§ `Regulation 30.1 - week of unemployment of a self-employed person`

-- args: the normal level (hours a week), the time devoted in the week. A reduction of MORE than 40% of 40 hours is more than 16 hours.
#ASSERT     `reg 30.1 the week is a week of unemployment for a self-employed person` 40 23.9
#ASSERT NOT (`reg 30.1 the week is a week of unemployment for a self-employed person` 40 24)
#ASSERT     `reg 30.1 the week is a week of unemployment for a self-employed person` 40 0
#ASSERT NOT (`reg 30.1 the week is a week of unemployment for a self-employed person` 40 40)
#ASSERT NOT (`reg 30.1 the week is a week of unemployment for a self-employed person` 0 0)

§ `Regulation 30.2 - deemed to be not working`

-- args: engaged in the normal activities of the business, engaged in the normal activities for its continuation
#ASSERT     `reg 30.2 the self-employed person is deemed to be not working` FALSE FALSE
#ASSERT NOT (`reg 30.2 the self-employed person is deemed to be not working` TRUE FALSE)
#ASSERT NOT (`reg 30.2 the self-employed person is deemed to be not working` FALSE TRUE)
#ASSERT NOT (`reg 30.2 the self-employed person is deemed to be not working` TRUE TRUE)

§ `Regulation 31 - employed persons`

-- (1): args: the claimant is referred to in section 29 or 30, the number normally worked in a calendar week by persons in the claimant's grade
#ASSERT `reg 31(1) the number of hours, days or shifts in a full working week` FALSE 40 EQUALS JUST 40
#ASSERT `reg 31(1) the number of hours, days or shifts in a full working week` TRUE 40 EQUALS NOTHING
-- (2): args: referred to in 29 or 30, the number in (1), that number is a part-time number, the full-time number in the closest employment
#ASSERT `reg 31(2) the number of hours, days or shifts that makes a full working week for a part-time claimant` FALSE 20 TRUE 37.5 EQUALS JUST 37.5
#ASSERT `reg 31(2) the number of hours, days or shifts that makes a full working week for a part-time claimant` FALSE 37.5 TRUE 37.5 EQUALS JUST 37.5
#ASSERT `reg 31(2) the number of hours, days or shifts that makes a full working week for a part-time claimant` FALSE 40 TRUE 37.5 EQUALS JUST 40
#ASSERT `reg 31(2) the number of hours, days or shifts that makes a full working week for a part-time claimant` FALSE 20 FALSE 37.5 EQUALS JUST 20
#ASSERT `reg 31(2) the number of hours, days or shifts that makes a full working week for a part-time claimant` TRUE 20 TRUE 37.5 EQUALS NOTHING
-- (3): a unit rate: the days normally worked
#ASSERT `reg 31(3) the number of days in a full working week for a claimant remunerated on a piece, mileage or other unit rate` FALSE 5 EQUALS JUST 5
#ASSERT `reg 31(3) the number of days in a full working week for a claimant remunerated on a piece, mileage or other unit rate` TRUE 5 EQUALS NOTHING
-- which subsection gives the number: args: referred to in 29 or 30, unit rate, the number in (1), part-time, the full-time number, the days normally worked
#ASSERT `reg 31 the number of hours, days or shifts that makes a full working week for the claimant` FALSE FALSE 40 FALSE 37.5 5 EQUALS JUST 40
#ASSERT `reg 31 the number of hours, days or shifts that makes a full working week for the claimant` FALSE FALSE 20 TRUE 37.5 5 EQUALS JUST 37.5
#ASSERT `reg 31 the number of hours, days or shifts that makes a full working week for the claimant` FALSE TRUE 40 FALSE 37.5 5 EQUALS JUST 5
#ASSERT `reg 31 the number of hours, days or shifts that makes a full working week for the claimant` TRUE FALSE 40 FALSE 37.5 5 EQUALS NOTHING
#ASSERT `reg 31 the number of hours, days or shifts that makes a full working week for the claimant` TRUE TRUE 40 FALSE 37.5 5 EQUALS NOTHING
-- has worked a full working week: args: the number worked, the number that makes a full working week
#ASSERT `reg 31 the claimant has worked a full working week` 37.5 (JUST 37.5) EQUALS JUST TRUE
#ASSERT `reg 31 the claimant has worked a full working week` 37.49 (JUST 37.5) EQUALS JUST FALSE
#ASSERT `reg 31 the claimant has worked a full working week` 40 (JUST 37.5) EQUALS JUST TRUE
#ASSERT `reg 31 the claimant has worked a full working week` 40 NOTHING EQUALS NOTHING

§ `Regulation 32 - working day`

#ASSERT     `reg 32 working day` (YearMonthDay 2026 3 4)
#ASSERT     `reg 32 working day` (YearMonthDay 2026 3 9)
#ASSERT NOT (`reg 32 working day` (YearMonthDay 2026 3 7))
#ASSERT NOT (`reg 32 working day` (YearMonthDay 2026 3 8))
-- a public holiday that falls on a weekday is still a working day: only Saturday and Sunday are left out
#ASSERT     `reg 32 working day` (YearMonthDay 2026 12 25)
#ASSERT NOT (`reg 32 working day` (YearMonthDay 2026 12 26))
