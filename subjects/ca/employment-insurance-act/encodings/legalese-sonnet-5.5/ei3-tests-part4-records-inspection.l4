IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `ei3-part4-records-inspection`

-- Tests of ei3-part4-records-inspection.l4 (Act ss 87 to 89).
-- Expected values are hand-worked from the text of the section named beside each assertion. Every date and figure is invented.

§ `s 87 records and books`

-- (1) Arguments: kept at place of business/residence in Canada; kept at a place the Minister designated; form and information enable the
-- determination; information includes each insured person's Social Insurance Number.
#ASSERT `s 87(1) the employer has kept the records and books of account as required` TRUE FALSE TRUE TRUE
#ASSERT `s 87(1) the employer has kept the records and books of account as required` FALSE TRUE TRUE TRUE
#ASSERT NOT (`s 87(1) the employer has kept the records and books of account as required` FALSE FALSE TRUE TRUE)
#ASSERT NOT (`s 87(1) the employer has kept the records and books of account as required` TRUE FALSE FALSE TRUE)
#ASSERT NOT (`s 87(1) the employer has kept the records and books of account as required` TRUE FALSE TRUE FALSE)
#ASSERT `s 87(2) the employer shall keep the records and books of account the Minister specifies` TRUE TRUE
#ASSERT NOT (`s 87(2) the employer shall keep the records and books of account the Minister specifies` TRUE FALSE)
#ASSERT NOT (`s 87(2) the employer shall keep the records and books of account the Minister specifies` FALSE TRUE)
-- (3) Records for 2024: kept six years after the year, to the end of 31 December 2030.
#ASSERT `s 87(3) the employer must still retain the records and books of account` 2024 NOTHING (YMD 2030 12 31)
#ASSERT NOT (`s 87(3) the employer must still retain the records and books of account` 2024 NOTHING (YMD 2031 1 1))
-- Written permission for earlier disposal given on 1 June 2027: the duty ends when it is given.
#ASSERT `s 87(3) the employer must still retain the records and books of account` 2024 (JUST (YMD 2027 6 1)) (YMD 2027 5 31)
#ASSERT NOT (`s 87(3) the employer must still retain the records and books of account` 2024 (JUST (YMD 2027 6 1)) (YMD 2027 6 1))
#ASSERT NOT (`s 87(3) the employer must still retain the records and books of account` 2024 (JUST (YMD 2027 6 1)) (YMD 2027 6 2))
-- A permission dated after the six years changes nothing.
#ASSERT NOT (`s 87(3) the employer must still retain the records and books of account` 2024 (JUST (YMD 2032 1 1)) (YMD 2031 1 1))
-- (3.1), (3.2)
#ASSERT `s 87(3.1) the employer has retained the electronic records as required` TRUE TRUE
#ASSERT NOT (`s 87(3.1) the employer has retained the electronic records as required` TRUE FALSE)
#ASSERT `s 87(3.1) the employer has retained the electronic records as required` FALSE FALSE
#ASSERT `s 87(3.2) the employer is exempt from the requirement in subsection (3.1)` TRUE TRUE
#ASSERT NOT (`s 87(3.2) the employer is exempt from the requirement in subsection (3.1)` TRUE FALSE)
#ASSERT NOT (`s 87(3.2) the employer is exempt from the requirement in subsection (3.1)` FALSE TRUE)
-- (4) Retain until the ruling is made or the appeal disposed of AND any further appeal is disposed of or the time has expired.
#ASSERT `s 87(4) the employer must still retain every record, book of account, account and voucher necessary` TRUE FALSE FALSE
#ASSERT `s 87(4) the employer must still retain every record, book of account, account and voucher necessary` TRUE TRUE FALSE
#ASSERT `s 87(4) the employer must still retain every record, book of account, account and voucher necessary` TRUE FALSE TRUE
#ASSERT NOT (`s 87(4) the employer must still retain every record, book of account, account and voucher necessary` TRUE TRUE TRUE)
#ASSERT NOT (`s 87(4) the employer must still retain every record, book of account, account and voucher necessary` FALSE FALSE FALSE)

§ `s 88(1) to (4) inspection, entry, warrant, access order`

-- (1) Arguments: authorized person; reasonable time; purpose; the document relates to the records or premiums.
#ASSERT `s 88(1) the authorized person may inspect, audit or examine the document` TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 88(1) the authorized person may inspect, audit or examine the document` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`s 88(1) the authorized person may inspect, audit or examine the document` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 88(1) the authorized person may inspect, audit or examine the document` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 88(1) the authorized person may inspect, audit or examine the document` TRUE TRUE TRUE FALSE)
-- (2) A dwelling-house: consent or a warrant, not neither.
#ASSERT `s 88(2) the authorized person may enter the dwelling-house` TRUE FALSE
#ASSERT `s 88(2) the authorized person may enter the dwelling-house` FALSE TRUE
#ASSERT NOT (`s 88(2) the authorized person may enter the dwelling-house` FALSE FALSE)
-- (1)(a) Arguments: may inspect; records kept or to be kept there; a dwelling-house; consent; warrant.
#ASSERT `s 88(1)(a) the authorized person may enter the premises or place` TRUE TRUE FALSE FALSE FALSE
#ASSERT `s 88(1)(a) the authorized person may enter the premises or place` TRUE TRUE TRUE TRUE FALSE
#ASSERT `s 88(1)(a) the authorized person may enter the premises or place` TRUE TRUE TRUE FALSE TRUE
#ASSERT NOT (`s 88(1)(a) the authorized person may enter the premises or place` TRUE TRUE TRUE FALSE FALSE)
#ASSERT NOT (`s 88(1)(a) the authorized person may enter the premises or place` TRUE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`s 88(1)(a) the authorized person may enter the premises or place` FALSE TRUE FALSE FALSE FALSE)
-- (1)(b)
#ASSERT `s 88(1)(b) the owner, occupant or person in charge must give what is required` TRUE TRUE TRUE
#ASSERT NOT (`s 88(1)(b) the owner, occupant or person in charge must give what is required` FALSE TRUE TRUE)
#ASSERT NOT (`s 88(1)(b) the owner, occupant or person in charge must give what is required` TRUE FALSE TRUE)
#ASSERT NOT (`s 88(1)(b) the owner, occupant or person in charge must give what is required` TRUE TRUE FALSE)
-- (3) A warrant needs the ex parte application and all of (a), (b), (c).
#ASSERT `s 88(3) the judge may issue a warrant authorizing an authorized person to enter the dwelling-house` TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 88(3) the judge may issue a warrant authorizing an authorized person to enter the dwelling-house` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`s 88(3) the judge may issue a warrant authorizing an authorized person to enter the dwelling-house` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 88(3) the judge may issue a warrant authorizing an authorized person to enter the dwelling-house` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 88(3) the judge may issue a warrant authorizing an authorized person to enter the dwelling-house` TRUE TRUE TRUE FALSE)
-- (4) Not satisfied that entry is necessary; access refused or expected to be; the document is or is expected to be there.
#ASSERT `s 88(4) the judge may order the occupant to provide access and make any other appropriate order` TRUE TRUE TRUE
#ASSERT NOT (`s 88(4) the judge may order the occupant to provide access and make any other appropriate order` FALSE TRUE TRUE)
#ASSERT NOT (`s 88(4) the judge may order the occupant to provide access and make any other appropriate order` TRUE FALSE TRUE)
#ASSERT NOT (`s 88(4) the judge may order the occupant to provide access and make any other appropriate order` TRUE TRUE FALSE)

§ `s 88(5) to (13) requirements, authorization, review, copies, compliance`

-- (6) Unnamed persons need a judge's prior authorization.
#ASSERT `s 88(6) the Minister may impose the requirement on the third party` FALSE FALSE
#ASSERT `s 88(6) the Minister may impose the requirement on the third party` TRUE TRUE
#ASSERT NOT (`s 88(6) the Minister may impose the requirement on the third party` TRUE FALSE)
-- (5) Arguments: purpose; served personally or by confirmed delivery service; reasonable time stated; unnamed persons; authorization.
#ASSERT `s 88(5) the Minister may require the person to provide the information or document` TRUE TRUE TRUE FALSE FALSE
#ASSERT `s 88(5) the Minister may require the person to provide the information or document` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 88(5) the Minister may require the person to provide the information or document` TRUE TRUE TRUE TRUE FALSE)
#ASSERT NOT (`s 88(5) the Minister may require the person to provide the information or document` FALSE TRUE TRUE FALSE FALSE)
#ASSERT NOT (`s 88(5) the Minister may require the person to provide the information or document` TRUE FALSE TRUE FALSE FALSE)
#ASSERT NOT (`s 88(5) the Minister may require the person to provide the information or document` TRUE TRUE FALSE FALSE FALSE)
-- (7) Ex parte application and all of (a) to (d).
#ASSERT `s 88(7) the judge may authorize the Minister to impose the requirement` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 88(7) the judge may authorize the Minister to impose the requirement` FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`s 88(7) the judge may authorize the Minister to impose the requirement` TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`s 88(7) the judge may authorize the Minister to impose the requirement` TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 88(7) the judge may authorize the Minister to impose the requirement` TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 88(7) the judge may authorize the Minister to impose the requirement` TRUE TRUE TRUE TRUE FALSE)
-- (8)
#ASSERT `s 88(8) the authorization has been served as required` FALSE FALSE
#ASSERT `s 88(8) the authorization has been served as required` TRUE TRUE
#ASSERT NOT (`s 88(8) the authorization has been served as required` TRUE FALSE)
-- (9) Served on 10 April 2026: 15 days after is 25 April 2026, and that day counts.
#ASSERT `s 88(9) the third party may apply for a review of the authorization` TRUE (YMD 2026 4 10) (YMD 2026 4 25)
#ASSERT NOT (`s 88(9) the third party may apply for a review of the authorization` TRUE (YMD 2026 4 10) (YMD 2026 4 26))
-- Served on 20 April 2026: 15 days after is 5 May 2026.
#ASSERT `s 88(9) the third party may apply for a review of the authorization` TRUE (YMD 2026 4 20) (YMD 2026 5 5)
#ASSERT NOT (`s 88(9) the third party may apply for a review of the authorization` TRUE (YMD 2026 4 20) (YMD 2026 5 6))
#ASSERT NOT (`s 88(9) the third party may apply for a review of the authorization` FALSE (YMD 2026 4 10) (YMD 2026 4 11))
-- (10)
#ASSERT `s 88(10) the judge may cancel the authorization` FALSE
#ASSERT NOT (`s 88(10) the judge may cancel the authorization` TRUE)
#ASSERT `s 88(10) the judge may confirm or vary the authorization` TRUE
#ASSERT NOT (`s 88(10) the judge may confirm or vary the authorization` FALSE)
-- (11), (12)
#ASSERT `s 88(11) the court may make such order as it considers proper to enforce compliance with the requirement` TRUE
#ASSERT NOT (`s 88(11) the court may make such order as it considers proper to enforce compliance with the requirement` FALSE)
#ASSERT `s 88(12)(a) the person may make one or more copies or have them made` TRUE TRUE
#ASSERT NOT (`s 88(12)(a) the person may make one or more copies or have them made` FALSE TRUE)
#ASSERT NOT (`s 88(12)(a) the person may make one or more copies or have them made` TRUE FALSE)
#ASSERT `s 88(12)(b) the copy is evidence of the nature and content of the original and has the same probative force` TRUE TRUE
#ASSERT NOT (`s 88(12)(b) the copy is evidence of the nature and content of the original and has the same probative force` TRUE FALSE)
#ASSERT NOT (`s 88(12)(b) the copy is evidence of the nature and content of the original and has the same probative force` FALSE TRUE)
-- (13) Arguments: hindered or prevented someone; did everything required; unable to.
#ASSERT `s 88(13) the person has complied with the subsection` FALSE TRUE FALSE
#ASSERT `s 88(13) the person has complied with the subsection` FALSE FALSE TRUE
#ASSERT NOT (`s 88(13) the person has complied with the subsection` FALSE FALSE FALSE)
#ASSERT NOT (`s 88(13) the person has complied with the subsection` TRUE TRUE FALSE)

§ `s 89 protection of the employer that deducts`

#ASSERT `s 89(1) an action lies against the person for deducting the sum` TRUE EQUALS JUST FALSE
-- A deduction not made in compliance or intended compliance: the section says nothing.
#ASSERT `s 89(1) an action lies against the person for deducting the sum` FALSE EQUALS NOTHING
-- (2) The receipt discharges the debtor's liability to the extent of the receipt: 800 against 1,000 owed; 1,200 against 1,000 owed.
#ASSERT `s 89(2) the amount of the debtor's liability that is discharged` TRUE TRUE 800 1_000 EQUALS JUST 800
#ASSERT `s 89(2) the amount of the debtor's liability that is discharged` TRUE TRUE 1_200 1_000 EQUALS JUST 1_000
#ASSERT `s 89(2) the amount of the debtor's liability that is discharged` TRUE TRUE 1_000 1_000 EQUALS JUST 1_000
#ASSERT `s 89(2) the amount of the debtor's liability that is discharged` TRUE FALSE 800 1_000 EQUALS NOTHING
#ASSERT `s 89(2) the amount of the debtor's liability that is discharged` FALSE TRUE 800 1_000 EQUALS NOTHING
