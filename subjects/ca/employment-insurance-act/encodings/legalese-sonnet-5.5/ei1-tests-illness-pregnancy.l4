IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `ei1-illness-pregnancy`

-- Tests of ei1-illness-pregnancy.l4 (Act ss 21 and 22). Every expected value is written by hand from the text of the
-- section named beside the assertion; none is copied from the module's output. Dates were worked out with a calendar
-- program that is not the encoding. One #ASSERT per line.

§ `s 21(1) a minor attachment claimant who ceases work because of illness (src:483)`
-- args: minor attachment claimant; ceases work because of illness, injury or quarantine; unable to work for that reason
#ASSERT `s 21(1) the minor attachment claimant is not entitled to receive benefits while unable to work for that reason` TRUE TRUE TRUE
#ASSERT NOT (`s 21(1) the minor attachment claimant is not entitled to receive benefits while unable to work for that reason` FALSE TRUE TRUE)
#ASSERT NOT (`s 21(1) the minor attachment claimant is not entitled to receive benefits while unable to work for that reason` TRUE FALSE TRUE)
#ASSERT NOT (`s 21(1) the minor attachment claimant is not entitled to receive benefits while unable to work for that reason` TRUE TRUE FALSE)

§ `s 21(2) a provincial law allowance reduces the benefits (src:485)`
-- args: benefits are payable because of illness; allowances payable under a provincial law; the benefits payable; the prescribed reduction
#ASSERT `s 21(2) the benefits payable to the claimant after the reduction for allowances payable under a provincial law` TRUE TRUE 400 150 EQUALS 250
#ASSERT `s 21(2) the benefits payable to the claimant after the reduction for allowances payable under a provincial law` TRUE TRUE 400 400 EQUALS 0
#ASSERT `s 21(2) the benefits payable to the claimant after the reduction for allowances payable under a provincial law` TRUE TRUE 400 500 EQUALS 0
#ASSERT `s 21(2) the benefits payable to the claimant after the reduction for allowances payable under a provincial law` TRUE FALSE 400 150 EQUALS 400
#ASSERT `s 21(2) the benefits payable to the claimant after the reduction for allowances payable under a provincial law` FALSE TRUE 400 150 EQUALS 400

§ `s 21(3) allowances under an employer's plan are deducted (src:487)`
-- args: benefits payable for the week because of illness; benefits before the deduction; allowances under the plan; the employer's premium has been reduced
#ASSERT `s 21(3) the benefits payable for the week after deducting the allowances payable under the employer's plan` TRUE 400 100 TRUE EQUALS 300
#ASSERT `s 21(3) the benefits payable for the week after deducting the allowances payable under the employer's plan` TRUE 400 500 TRUE EQUALS 0
#ASSERT `s 21(3) the benefits payable for the week after deducting the allowances payable under the employer's plan` TRUE 400 100 FALSE EQUALS 400
#ASSERT `s 21(3) the benefits payable for the week after deducting the allowances payable under the employer's plan` FALSE 400 100 TRUE EQUALS 400

§ `s 22(1) benefits for a major attachment claimant who proves her pregnancy (src:489)`
#ASSERT `s 22(1) benefits are payable to the claimant despite section 18` TRUE TRUE
#ASSERT NOT (`s 22(1) benefits are payable to the claimant despite section 18` FALSE TRUE)
#ASSERT NOT (`s 22(1) benefits are payable to the claimant despite section 18` TRUE FALSE)

§ `s 22(2) the period during which benefits are payable (src:491-497)`
-- Confinement expected on Wednesday 2026-12-16 (the week of Sunday 2026-12-13). 12 weeks before that week: Sunday 2026-09-20.
-- 17 weeks after it ends on Saturday 2027-04-17. args: a day in the week confinement is expected; a day in the week it occurs (if it has).
#ASSERT (`s 22(2) the period during which benefits are payable` (YearMonthDay 2026 12 16) NOTHING)'s `first day of the period` EQUALS YearMonthDay 2026 9 20
#ASSERT (`s 22(2) the period during which benefits are payable` (YearMonthDay 2026 12 16) NOTHING)'s `last day of the period` EQUALS YearMonthDay 2027 4 17
-- confinement in the expected week or earlier in the last weeks: the same period
#ASSERT (`s 22(2) the period during which benefits are payable` (YearMonthDay 2026 12 16) (JUST (YearMonthDay 2026 12 16)))'s `first day of the period` EQUALS YearMonthDay 2026 9 20
#ASSERT (`s 22(2) the period during which benefits are payable` (YearMonthDay 2026 12 16) (JUST (YearMonthDay 2026 12 16)))'s `last day of the period` EQUALS YearMonthDay 2027 4 17
#ASSERT (`s 22(2) the period during which benefits are payable` (YearMonthDay 2026 12 16) (JUST (YearMonthDay 2026 12 2)))'s `first day of the period` EQUALS YearMonthDay 2026 9 20
#ASSERT (`s 22(2) the period during which benefits are payable` (YearMonthDay 2026 12 16) (JUST (YearMonthDay 2026 12 2)))'s `last day of the period` EQUALS YearMonthDay 2027 4 17
-- confinement later than expected (Wednesday 2026-12-30): the end is 17 weeks after that week, Saturday 2027-05-01
#ASSERT (`s 22(2) the period during which benefits are payable` (YearMonthDay 2026 12 16) (JUST (YearMonthDay 2026 12 30)))'s `first day of the period` EQUALS YearMonthDay 2026 9 20
#ASSERT (`s 22(2) the period during which benefits are payable` (YearMonthDay 2026 12 16) (JUST (YearMonthDay 2026 12 30)))'s `last day of the period` EQUALS YearMonthDay 2027 5 1
#ASSERT (`s 22(2) the period during which benefits are payable` (YearMonthDay 2026 12 16) (JUST (YearMonthDay 2027 1 4)))'s `last day of the period` EQUALS YearMonthDay 2027 5 8
-- confinement much earlier than expected (Wednesday 2026-08-05, week of Sunday 2026-08-02): the period begins then
#ASSERT (`s 22(2) the period during which benefits are payable` (YearMonthDay 2026 12 16) (JUST (YearMonthDay 2026 8 5)))'s `first day of the period` EQUALS YearMonthDay 2026 8 2
#ASSERT (`s 22(2) the period during which benefits are payable` (YearMonthDay 2026 12 16) (JUST (YearMonthDay 2026 8 5)))'s `last day of the period` EQUALS YearMonthDay 2027 4 17

§ `s 22(3) a provincial law allowance reduces the benefits (src:499)`
#ASSERT `s 22(3) the benefits payable to the claimant after the reduction for allowances payable under a provincial law` TRUE TRUE 400 150 EQUALS 250
#ASSERT `s 22(3) the benefits payable to the claimant after the reduction for allowances payable under a provincial law` TRUE TRUE 400 500 EQUALS 0
#ASSERT `s 22(3) the benefits payable to the claimant after the reduction for allowances payable under a provincial law` TRUE FALSE 400 150 EQUALS 400
#ASSERT `s 22(3) the benefits payable to the claimant after the reduction for allowances payable under a provincial law` FALSE TRUE 400 150 EQUALS 400

§ `s 22(4) the week before the period is exempt from section 18 for section 13 (src:501)`
`ei1 test pregnancy period` MEANS `Period of days` OF (YearMonthDay 2026 9 20), (YearMonthDay 2027 4 17)
#ASSERT `s 22(4) section 18 does not apply, for the purposes of section 13, to the week` `ei1 test pregnancy period` (YearMonthDay 2026 9 13)
#ASSERT NOT (`s 22(4) section 18 does not apply, for the purposes of section 13, to the week` `ei1 test pregnancy period` (YearMonthDay 2026 9 20))
#ASSERT NOT (`s 22(4) section 18 does not apply, for the purposes of section 13, to the week` `ei1 test pregnancy period` (YearMonthDay 2026 9 6))

§ `s 22(5) allowances under an employer's plan are deducted (src:503)`
-- args: benefits payable under section 22 for the week; benefits before the deduction; allowances under the plan; the employer's premium has been reduced
#ASSERT `s 22(5) the benefits payable for the week after deducting the allowances payable under the employer's plan` TRUE 400 100 TRUE EQUALS 300
#ASSERT `s 22(5) the benefits payable for the week after deducting the allowances payable under the employer's plan` TRUE 400 500 TRUE EQUALS 0
#ASSERT `s 22(5) the benefits payable for the week after deducting the allowances payable under the employer's plan` TRUE 400 100 FALSE EQUALS 400
#ASSERT `s 22(5) the benefits payable for the week after deducting the allowances payable under the employer's plan` FALSE 400 100 TRUE EQUALS 400

§ `s 22(6) and s 22(7) the period extended for a child in hospital (src:505-507)`
-- The period of 2026-09-20 to 2027-04-17, confinement in the week of Sunday 2026-11-29 (Wednesday 2026-12-02): the latest the period may end is
-- Saturday 2027-12-04, 52 weeks after the week of confinement. Four weeks of hospital: 2027-05-15; 33 weeks: exactly 2027-12-04; 34 or 60 weeks: cut at 2027-12-04.
-- args: the period of subsection (2); weeks the child is in hospital; a day in the week of confinement
#ASSERT (`s 22(6) and s 22(7) the period during which benefits are payable, extended` `ei1 test pregnancy period` 0 (YearMonthDay 2026 12 2))'s `last day of the period` EQUALS YearMonthDay 2027 4 17
#ASSERT (`s 22(6) and s 22(7) the period during which benefits are payable, extended` `ei1 test pregnancy period` 4 (YearMonthDay 2026 12 2))'s `last day of the period` EQUALS YearMonthDay 2027 5 15
#ASSERT (`s 22(6) and s 22(7) the period during which benefits are payable, extended` `ei1 test pregnancy period` 33 (YearMonthDay 2026 12 2))'s `last day of the period` EQUALS YearMonthDay 2027 12 4
#ASSERT (`s 22(6) and s 22(7) the period during which benefits are payable, extended` `ei1 test pregnancy period` 34 (YearMonthDay 2026 12 2))'s `last day of the period` EQUALS YearMonthDay 2027 12 4
#ASSERT (`s 22(6) and s 22(7) the period during which benefits are payable, extended` `ei1 test pregnancy period` 60 (YearMonthDay 2026 12 2))'s `last day of the period` EQUALS YearMonthDay 2027 12 4
#ASSERT (`s 22(6) and s 22(7) the period during which benefits are payable, extended` `ei1 test pregnancy period` 4 (YearMonthDay 2026 12 2))'s `first day of the period` EQUALS YearMonthDay 2026 9 20
