IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `ei1-qualifying`

-- Tests of ei1-qualifying.l4 (Act ss 7, 7.1 and 8). Every expected value is written by hand from the text of the
-- section named beside the assertion (tables transcribed from src:165-174 and src:183-191); none is copied from the
-- module's output. Dates in the boundary tests were worked out with a calendar program that is not the encoding.
-- One #ASSERT per line.

§ `s 7(1) benefits are payable to an insured person who qualifies (src:159)`
#ASSERT `s 7(1) unemployment benefits are payable as provided in Part I to the insured person` TRUE TRUE
#ASSERT NOT (`s 7(1) unemployment benefits are payable as provided in Part I to the insured person` TRUE FALSE)
#ASSERT NOT (`s 7(1) unemployment benefits are payable as provided in Part I to the insured person` FALSE TRUE)

§ `s 7(2)(a) interruption of earnings (src:162)`
#ASSERT `s 7(2)(a) the insured person has had an interruption of earnings from employment` TRUE
#ASSERT NOT (`s 7(2)(a) the insured person has had an interruption of earnings from employment` FALSE)

