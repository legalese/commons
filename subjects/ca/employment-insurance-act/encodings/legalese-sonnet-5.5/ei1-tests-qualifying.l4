#ASSERT `s 8(4) the week during an extension further extends the qualifying period` TRUE TRUE
#ASSERT NOT (`s 8(4) the week during an extension further extends the qualifying period` TRUE FALSE)
#ASSERT NOT (`s 8(4) the week during an extension further extends the qualifying period` FALSE TRUE)
