IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `er5-admin-direct-deposit`

-- Tests of er5-admin-direct-deposit (reg 92). Expected values are written by hand from the text of the Regulations
-- (SOR-96-332.txt lines 1698-1707), beside each assertion, before the run.

§ `Reg 92(1) - the Direct Deposit Regulations (src:1698)`

#ASSERT `reg 92(1) the sections of the Direct Deposit Regulations that apply for the purposes of this section` EQUALS LIST 2, 4, 5, 6, 7, 8

§ `Reg 92(2) - benefits deposited directly (src:1699)`

-- The argument order is: provided the number of an account; the account is active; registered in the claimant's name; in a financial institution in Canada; refused access under subsection (7).
#ASSERT `reg 92(2) the claimant's benefits are to be deposited directly to their bank account` TRUE TRUE TRUE TRUE FALSE
-- No account number provided.
#ASSERT NOT (`reg 92(2) the claimant's benefits are to be deposited directly to their bank account` FALSE TRUE TRUE TRUE FALSE)
-- An account that is not active.
#ASSERT NOT (`reg 92(2) the claimant's benefits are to be deposited directly to their bank account` TRUE FALSE TRUE TRUE FALSE)
-- An account in someone else's name.
#ASSERT NOT (`reg 92(2) the claimant's benefits are to be deposited directly to their bank account` TRUE TRUE FALSE TRUE FALSE)
-- An account outside Canada.
#ASSERT NOT (`reg 92(2) the claimant's benefits are to be deposited directly to their bank account` TRUE TRUE TRUE FALSE FALSE)
-- Subject to subsection (7): refused access to the systems, so no direct deposit.
#ASSERT NOT (`reg 92(2) the claimant's benefits are to be deposited directly to their bank account` TRUE TRUE TRUE TRUE TRUE)

§ `Reg 92(3) - responsibility for the accuracy of the data (src:1700)`

#ASSERT `reg 92(3) the claimant is responsible for the accuracy of the data` TRUE
#ASSERT NOT (`reg 92(3) the claimant is responsible for the accuracy of the data` FALSE)

§ `Reg 92(4) - evidence (src:1701-1703)`

-- The argument order is: no evidence to the contrary; the Commission's certified extract exists; the financial institution's certified extract exists.
#ASSERT `reg 92(4) the documents together constitute evidence of the transfer of funds and the payment of benefits` TRUE TRUE TRUE EQUALS JUST TRUE
-- With evidence to the contrary the text does not say what the documents are worth.
#ASSERT `reg 92(4) the documents together constitute evidence of the transfer of funds and the payment of benefits` FALSE TRUE TRUE EQUALS NOTHING
-- With one document missing the text does not say there is no evidence.
#ASSERT `reg 92(4) the documents together constitute evidence of the transfer of funds and the payment of benefits` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `reg 92(4) the documents together constitute evidence of the transfer of funds and the payment of benefits` TRUE FALSE TRUE EQUALS NOTHING

§ `Reg 92(5) - ending the direct deposit (src:1704)`

#ASSERT `reg 92(5) the claimant must notify the Commission` TRUE
#ASSERT NOT (`reg 92(5) the claimant must notify the Commission` FALSE)
-- The argument order is: the claimant wishes to terminate; the claimant has notified the Commission.
#ASSERT `reg 92(5) the direct deposit of benefits is terminated` TRUE TRUE
-- Wishing is not enough.
#ASSERT NOT (`reg 92(5) the direct deposit of benefits is terminated` TRUE FALSE)

§ `Reg 92(6) and (7) - sections 38 and 135, and interference with the systems (src:1705-1706)`

#ASSERT `reg 92(6) sections 38 and 135 of the Act apply to the declaration` TRUE
#ASSERT NOT (`reg 92(6) sections 38 and 135 of the Act apply to the declaration` FALSE)
#ASSERT `reg 92(7) the act is deemed to be an act or omission specified in subsections 38(1) and 135(1) of the Act` TRUE
#ASSERT NOT (`reg 92(7) the act is deemed to be an act or omission specified in subsections 38(1) and 135(1) of the Act` FALSE)
#ASSERT `reg 92(7) the penalty and the punishment include the right to refuse the person access to the electronic systems used for direct deposit` TRUE
#ASSERT NOT (`reg 92(7) the penalty and the punishment include the right to refuse the person access to the electronic systems used for direct deposit` FALSE)

§ `Reg 92(8) - redirecting the deposit (src:1707)`

-- The argument order is: the claimant has otherwise advised the Commission; the deposit is to an active account whose number the claimant provided; the institution has notified a change.
#ASSERT `reg 92(8) the Commission may redirect the deposit of benefits` FALSE TRUE TRUE
-- The claimant has advised otherwise.
#ASSERT NOT (`reg 92(8) the Commission may redirect the deposit of benefits` TRUE TRUE TRUE)
-- The institution has not notified a change.
#ASSERT NOT (`reg 92(8) the Commission may redirect the deposit of benefits` FALSE TRUE FALSE)
-- The deposit is not to an account whose number the claimant provided.
#ASSERT NOT (`reg 92(8) the Commission may redirect the deposit of benefits` FALSE FALSE TRUE)
