IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `eia-core-interpretation`
IMPORT `er3-nouns`
IMPORT `er3-outside-canada`

-- Tests of er3-outside-canada (regulations 54, 55 and 55.01). Every expected value is written by hand from the
-- text of regs 54, 55 and 55.01 (SOR-96-332.txt lines 811-930) before the module was run.

`test parent` MEANS `er3 a father or mother of the claimant or of the claimant's spouse or common-law partner`
`test spouse` MEANS `er3 the claimant's spouse or common-law partner`
`test child` MEANS `er3 a child of the claimant or of the claimant's spouse or common-law partner`
`test grandparent` MEANS `er3 a grandparent of the claimant or of the claimant's spouse or common-law partner`
`test aunt or uncle` MEANS `er3 an uncle or aunt of the claimant or of the claimant's spouse or common-law partner`
`test stranger` MEANS `er3 someone else`

§ `reg 54 -- inmates`

-- (1): not self-employed, an inmate, released on parole, day parole, a temporary absence or a certificate of availability, to look for work.
#ASSERT `reg 54(1) the claimant who is an inmate is not disentitled by reason only of section 37 of the Act` FALSE TRUE `er3 release: parole` TRUE EQUALS TRUE
#ASSERT `reg 54(1) the claimant who is an inmate is not disentitled by reason only of section 37 of the Act` FALSE TRUE `er3 release: day parole` TRUE EQUALS TRUE
#ASSERT `reg 54(1) the claimant who is an inmate is not disentitled by reason only of section 37 of the Act` FALSE TRUE `er3 release: a temporary absence` TRUE EQUALS TRUE
#ASSERT `reg 54(1) the claimant who is an inmate is not disentitled by reason only of section 37 of the Act` FALSE TRUE `er3 release: a certificate of availability` TRUE EQUALS TRUE
#ASSERT `reg 54(1) the claimant who is an inmate is not disentitled by reason only of section 37 of the Act` TRUE TRUE `er3 release: parole` TRUE EQUALS FALSE
#ASSERT `reg 54(1) the claimant who is an inmate is not disentitled by reason only of section 37 of the Act` FALSE FALSE `er3 release: parole` TRUE EQUALS FALSE
#ASSERT `reg 54(1) the claimant who is an inmate is not disentitled by reason only of section 37 of the Act` FALSE TRUE `er3 release: none` TRUE EQUALS FALSE
#ASSERT `reg 54(1) the claimant who is an inmate is not disentitled by reason only of section 37 of the Act` FALSE TRUE `er3 release: parole` FALSE EQUALS FALSE
-- (2): self-employed; parole, day parole or a temporary absence; not a certificate of availability.
#ASSERT `reg 54(2) the self-employed person who is an inmate is not disentitled by reason only of section 152.2 of the Act` TRUE TRUE `er3 release: parole` EQUALS TRUE
#ASSERT `reg 54(2) the self-employed person who is an inmate is not disentitled by reason only of section 152.2 of the Act` TRUE TRUE `er3 release: day parole` EQUALS TRUE
#ASSERT `reg 54(2) the self-employed person who is an inmate is not disentitled by reason only of section 152.2 of the Act` TRUE TRUE `er3 release: a temporary absence` EQUALS TRUE
#ASSERT `reg 54(2) the self-employed person who is an inmate is not disentitled by reason only of section 152.2 of the Act` TRUE TRUE `er3 release: a certificate of availability` EQUALS FALSE
#ASSERT `reg 54(2) the self-employed person who is an inmate is not disentitled by reason only of section 152.2 of the Act` TRUE TRUE `er3 release: none` EQUALS FALSE
#ASSERT `reg 54(2) the self-employed person who is an inmate is not disentitled by reason only of section 152.2 of the Act` FALSE TRUE `er3 release: parole` EQUALS FALSE
#ASSERT `reg 54(2) the self-employed person who is an inmate is not disentitled by reason only of section 152.2 of the Act` TRUE FALSE `er3 release: parole` EQUALS FALSE

§ `reg 55(2) -- the immediate family, and the funeral list`

-- the nine constructors of the immediate family (a) to (h) are members of it.
#ASSERT `reg 55(2) a member of the claimant's immediate family` `test parent` EQUALS TRUE
#ASSERT `reg 55(2) a member of the claimant's immediate family` `er3 the spouse or common-law partner of a father or mother of the claimant or of the claimant's spouse or common-law partner` EQUALS TRUE
#ASSERT `reg 55(2) a member of the claimant's immediate family` `er3 a foster parent of the claimant or of the claimant's spouse or common-law partner` EQUALS TRUE
#ASSERT `reg 55(2) a member of the claimant's immediate family` `er3 a child of the claimant's father or mother, or of the spouse or common-law partner of the claimant's father or mother` EQUALS TRUE
#ASSERT `reg 55(2) a member of the claimant's immediate family` `test spouse` EQUALS TRUE
#ASSERT `reg 55(2) a member of the claimant's immediate family` `test child` EQUALS TRUE
#ASSERT `reg 55(2) a member of the claimant's immediate family` `er3 a ward of the claimant or of the claimant's spouse or common-law partner` EQUALS TRUE
#ASSERT `reg 55(2) a member of the claimant's immediate family` `er3 a dependant or relative residing in the claimant's household` EQUALS TRUE
#ASSERT `reg 55(2) a member of the claimant's immediate family` `er3 a relative with whom the claimant permanently resides` EQUALS TRUE
-- the persons of 55(1)(b)(i) to (vii) are not immediate family, but their funerals may be attended.
#ASSERT `reg 55(2) a member of the claimant's immediate family` `test grandparent` EQUALS FALSE
#ASSERT `reg 55(2) a member of the claimant's immediate family` `test aunt or uncle` EQUALS FALSE
#ASSERT `reg 55(2) a member of the claimant's immediate family` `test stranger` EQUALS FALSE
#ASSERT `reg 55(1)(b) a person whose funeral the claimant may attend` `test grandparent` EQUALS TRUE
#ASSERT `reg 55(1)(b) a person whose funeral the claimant may attend` `er3 a grandchild of the claimant or of the claimant's spouse or common-law partner` EQUALS TRUE
#ASSERT `reg 55(1)(b) a person whose funeral the claimant may attend` `er3 the spouse or common-law partner of the claimant's son or daughter, or of the son or daughter of the claimant's spouse or common-law partner` EQUALS TRUE
#ASSERT `reg 55(1)(b) a person whose funeral the claimant may attend` `er3 the spouse or common-law partner of a child of the claimant's father or mother, or of a child of the spouse or common-law partner of the claimant's father or mother` EQUALS TRUE
#ASSERT `reg 55(1)(b) a person whose funeral the claimant may attend` `er3 a child of the father or mother of the claimant's spouse or common-law partner, or a child of the spouse or common-law partner of that father or mother` EQUALS TRUE
#ASSERT `reg 55(1)(b) a person whose funeral the claimant may attend` `test aunt or uncle` EQUALS TRUE
#ASSERT `reg 55(1)(b) a person whose funeral the claimant may attend` `er3 a nephew or niece of the claimant or of the claimant's spouse or common-law partner` EQUALS TRUE
#ASSERT `reg 55(1)(b) a person whose funeral the claimant may attend` `test parent` EQUALS TRUE
#ASSERT `reg 55(1)(b) a person whose funeral the claimant may attend` `test stranger` EQUALS FALSE

§ `reg 55(1) -- the six reasons for a short stay outside Canada`

-- (a) treatment outside Canada, not readily available at home, at an accredited facility: no limit of days.
#ASSERT `reg 55(1)(a) outside Canada to undergo medical treatment that is not available in Canada` TRUE TRUE TRUE EQUALS TRUE
#ASSERT `reg 55(1)(a) outside Canada to undergo medical treatment that is not available in Canada` FALSE TRUE TRUE EQUALS FALSE
#ASSERT `reg 55(1)(a) outside Canada to undergo medical treatment that is not available in Canada` TRUE FALSE TRUE EQUALS FALSE
#ASSERT `reg 55(1)(a) outside Canada to undergo medical treatment that is not available in Canada` TRUE TRUE FALSE EQUALS FALSE
-- (b) a funeral, not more than seven consecutive days.
#ASSERT `reg 55(1)(b) outside Canada to attend a funeral for not more than seven consecutive days` 7 `test parent` EQUALS TRUE
#ASSERT `reg 55(1)(b) outside Canada to attend a funeral for not more than seven consecutive days` 8 `test parent` EQUALS FALSE
#ASSERT `reg 55(1)(b) outside Canada to attend a funeral for not more than seven consecutive days` 7 `test grandparent` EQUALS TRUE
#ASSERT `reg 55(1)(b) outside Canada to attend a funeral for not more than seven consecutive days` 1 `test aunt or uncle` EQUALS TRUE
#ASSERT `reg 55(1)(b) outside Canada to attend a funeral for not more than seven consecutive days` 7 `test stranger` EQUALS FALSE
-- (c) accompanying a member of the immediate family (not a grandparent) for treatment not available at their home, at an accredited facility.
#ASSERT `reg 55(1)(c) outside Canada to accompany a member of the immediate family for medical treatment for not more than seven consecutive days` 7 `test spouse` TRUE TRUE EQUALS TRUE
#ASSERT `reg 55(1)(c) outside Canada to accompany a member of the immediate family for medical treatment for not more than seven consecutive days` 8 `test spouse` TRUE TRUE EQUALS FALSE
#ASSERT `reg 55(1)(c) outside Canada to accompany a member of the immediate family for medical treatment for not more than seven consecutive days` 7 `test grandparent` TRUE TRUE EQUALS FALSE
#ASSERT `reg 55(1)(c) outside Canada to accompany a member of the immediate family for medical treatment for not more than seven consecutive days` 7 `test spouse` FALSE TRUE EQUALS FALSE
#ASSERT `reg 55(1)(c) outside Canada to accompany a member of the immediate family for medical treatment for not more than seven consecutive days` 7 `test spouse` TRUE FALSE EQUALS FALSE
-- (d) visiting a seriously ill or injured member of the immediate family.
#ASSERT `reg 55(1)(d) outside Canada to visit a member of the immediate family who is seriously ill or injured for not more than seven consecutive days` 7 `test child` TRUE EQUALS TRUE
#ASSERT `reg 55(1)(d) outside Canada to visit a member of the immediate family who is seriously ill or injured for not more than seven consecutive days` 8 `test child` TRUE EQUALS FALSE
#ASSERT `reg 55(1)(d) outside Canada to visit a member of the immediate family who is seriously ill or injured for not more than seven consecutive days` 7 `test child` FALSE EQUALS FALSE
#ASSERT `reg 55(1)(d) outside Canada to visit a member of the immediate family who is seriously ill or injured for not more than seven consecutive days` 7 `test grandparent` TRUE EQUALS FALSE
-- (e) a bona fide job interview, not more than seven days; (f) a bona fide job search, not more than 14.
#ASSERT `reg 55(1)(e) outside Canada to attend a bona fide job interview for not more than seven consecutive days` 7 TRUE EQUALS TRUE
#ASSERT `reg 55(1)(e) outside Canada to attend a bona fide job interview for not more than seven consecutive days` 8 TRUE EQUALS FALSE
#ASSERT `reg 55(1)(e) outside Canada to attend a bona fide job interview for not more than seven consecutive days` 7 FALSE EQUALS FALSE
#ASSERT `reg 55(1)(f) outside Canada to conduct a bona fide job search for not more than 14 consecutive days` 14 TRUE EQUALS TRUE
#ASSERT `reg 55(1)(f) outside Canada to conduct a bona fide job search for not more than 14 consecutive days` 15 TRUE EQUALS FALSE
#ASSERT `reg 55(1)(f) outside Canada to conduct a bona fide job search for not more than 14 consecutive days` 3 FALSE EQUALS FALSE
-- the whole of (1): the purpose picks the paragraph. Arguments: self-employed, purpose, days, relationship, treatment not available, accredited, seriously ill, bona fide.
#ASSERT `reg 55(1) the claimant who is not a self-employed person is not disentitled for the reason that they are outside Canada` FALSE `er3 purpose: undergoing medical treatment outside Canada` 30 `test stranger` TRUE TRUE FALSE FALSE EQUALS TRUE
#ASSERT `reg 55(1) the claimant who is not a self-employed person is not disentitled for the reason that they are outside Canada` FALSE `er3 purpose: attending a funeral` 7 `test parent` FALSE FALSE FALSE FALSE EQUALS TRUE
#ASSERT `reg 55(1) the claimant who is not a self-employed person is not disentitled for the reason that they are outside Canada` FALSE `er3 purpose: accompanying a member of the immediate family for medical treatment outside Canada` 7 `test spouse` TRUE TRUE FALSE FALSE EQUALS TRUE
#ASSERT `reg 55(1) the claimant who is not a self-employed person is not disentitled for the reason that they are outside Canada` FALSE `er3 purpose: visiting a member of the immediate family who is seriously ill or injured` 7 `test child` FALSE FALSE TRUE FALSE EQUALS TRUE
#ASSERT `reg 55(1) the claimant who is not a self-employed person is not disentitled for the reason that they are outside Canada` FALSE `er3 purpose: attending a bona fide job interview` 7 `test stranger` FALSE FALSE FALSE TRUE EQUALS TRUE
#ASSERT `reg 55(1) the claimant who is not a self-employed person is not disentitled for the reason that they are outside Canada` FALSE `er3 purpose: conducting a bona fide job search` 14 `test stranger` FALSE FALSE FALSE TRUE EQUALS TRUE
#ASSERT `reg 55(1) the claimant who is not a self-employed person is not disentitled for the reason that they are outside Canada` FALSE `er3 purpose: conducting a bona fide job search` 15 `test stranger` FALSE FALSE FALSE TRUE EQUALS FALSE
#ASSERT `reg 55(1) the claimant who is not a self-employed person is not disentitled for the reason that they are outside Canada` FALSE `er3 purpose: some other purpose` 3 `test stranger` TRUE TRUE TRUE TRUE EQUALS FALSE
-- a self-employed person is under 55.01, not 55(1).
#ASSERT `reg 55(1) the claimant who is not a self-employed person is not disentitled for the reason that they are outside Canada` TRUE `er3 purpose: attending a funeral` 7 `test parent` FALSE FALSE FALSE FALSE EQUALS FALSE
-- (1.1): a funeral and a visit of the same person may be cumulated (7 + 7 = 14 days); anything else may not.
#ASSERT `reg 55(1.1) the most consecutive days of a single trip that cumulates the periods of paragraphs (1)(b) and (d)` TRUE TRUE EQUALS JUST 14
#ASSERT `reg 55(1.1) the most consecutive days of a single trip that cumulates the periods of paragraphs (1)(b) and (d)` TRUE FALSE EQUALS NOTHING
#ASSERT `reg 55(1.1) the most consecutive days of a single trip that cumulates the periods of paragraphs (1)(b) and (d)` FALSE TRUE EQUALS NOTHING

§ `reg 55(4), (5), (6) -- special benefits, claimants who last worked abroad, residents of the United States`

#ASSERT `reg 55(4) the reason is one of those listed` `pregnancy` EQUALS TRUE
#ASSERT `reg 55(4) the reason is one of those listed` `caring for a new-born or adopted child` EQUALS TRUE
#ASSERT `reg 55(4) the reason is one of those listed` `care or support of a family member` EQUALS TRUE
#ASSERT `reg 55(4) the reason is one of those listed` `care or support of a critically ill child` EQUALS TRUE
#ASSERT `reg 55(4) the reason is one of those listed` `care or support of a critically ill adult` EQUALS TRUE
#ASSERT `reg 55(4) the reason is one of those listed` `a prescribed illness, injury or quarantine` EQUALS FALSE
#ASSERT `reg 55(4) the reason is one of those listed` `a reason other than those mentioned in subsection 12(3)` EQUALS FALSE
-- (4): not self-employed; a listed reason or a course; the SIN valid.
#ASSERT `reg 55(4) the claimant is not disentitled for the sole reason that they are outside Canada` FALSE `pregnancy` FALSE FALSE EQUALS TRUE
#ASSERT `reg 55(4) the claimant is not disentitled for the sole reason that they are outside Canada` FALSE `pregnancy` FALSE TRUE EQUALS FALSE
#ASSERT `reg 55(4) the claimant is not disentitled for the sole reason that they are outside Canada` FALSE `a reason other than those mentioned in subsection 12(3)` TRUE FALSE EQUALS TRUE
#ASSERT `reg 55(4) the claimant is not disentitled for the sole reason that they are outside Canada` FALSE `a reason other than those mentioned in subsection 12(3)` TRUE TRUE EQUALS FALSE
#ASSERT `reg 55(4) the claimant is not disentitled for the sole reason that they are outside Canada` FALSE `a prescribed illness, injury or quarantine` FALSE FALSE EQUALS FALSE
#ASSERT `reg 55(4) the claimant is not disentitled for the sole reason that they are outside Canada` TRUE `pregnancy` FALSE FALSE EQUALS FALSE
-- (5): arguments: major attachment, self-employed, last interruption abroad, reason, incapable of the regular employment, incapable of other suitable employment.
#ASSERT `reg 55(5) the major attachment claimant with the last interruption of earnings from insurable employment outside Canada is not disentitled for the sole reason that they are outside Canada` TRUE FALSE TRUE `pregnancy` FALSE FALSE EQUALS TRUE
#ASSERT `reg 55(5) the major attachment claimant with the last interruption of earnings from insurable employment outside Canada is not disentitled for the sole reason that they are outside Canada` TRUE FALSE TRUE `a prescribed illness, injury or quarantine` TRUE TRUE EQUALS TRUE
-- (b) read as incapable of both (fork F11): incapable of the regular employment only is not enough.
#ASSERT `reg 55(5) the major attachment claimant with the last interruption of earnings from insurable employment outside Canada is not disentitled for the sole reason that they are outside Canada` TRUE FALSE TRUE `a prescribed illness, injury or quarantine` TRUE FALSE EQUALS FALSE
#ASSERT `reg 55(5) the major attachment claimant with the last interruption of earnings from insurable employment outside Canada is not disentitled for the sole reason that they are outside Canada` FALSE FALSE TRUE `pregnancy` FALSE FALSE EQUALS FALSE
#ASSERT `reg 55(5) the major attachment claimant with the last interruption of earnings from insurable employment outside Canada is not disentitled for the sole reason that they are outside Canada` TRUE TRUE TRUE `pregnancy` FALSE FALSE EQUALS FALSE
#ASSERT `reg 55(5) the major attachment claimant with the last interruption of earnings from insurable employment outside Canada is not disentitled for the sole reason that they are outside Canada` TRUE FALSE FALSE `pregnancy` FALSE FALSE EQUALS FALSE
#ASSERT `reg 55(5) the major attachment claimant with the last interruption of earnings from insurable employment outside Canada is not disentitled for the sole reason that they are outside Canada` TRUE FALSE TRUE `a reason other than those mentioned in subsection 12(3)` FALSE FALSE EQUALS FALSE
-- (6)(a): a contiguous state, available, able to report, and reports when requested.
#ASSERT `reg 55(6)(a) the claimant resides in a state contiguous to Canada, is available and reports when requested` TRUE TRUE TRUE TRUE EQUALS TRUE
#ASSERT `reg 55(6)(a) the claimant resides in a state contiguous to Canada, is available and reports when requested` FALSE TRUE TRUE TRUE EQUALS FALSE
#ASSERT `reg 55(6)(a) the claimant resides in a state contiguous to Canada, is available and reports when requested` TRUE FALSE TRUE TRUE EQUALS FALSE
#ASSERT `reg 55(6)(a) the claimant resides in a state contiguous to Canada, is available and reports when requested` TRUE TRUE FALSE TRUE EQUALS FALSE
#ASSERT `reg 55(6)(a) the claimant resides in a state contiguous to Canada, is available and reports when requested` TRUE TRUE TRUE FALSE EQUALS FALSE
-- (6)(b): qualified under Article VI, residing in a listed place where the Agreement has not been suspended.
#ASSERT `reg 55(6)(b) the claimant is qualified under Article VI of the Canada-United States Agreement and resides in a place where it applies` TRUE TRUE TRUE EQUALS TRUE
#ASSERT `reg 55(6)(b) the claimant is qualified under Article VI of the Canada-United States Agreement and resides in a place where it applies` FALSE TRUE TRUE EQUALS FALSE
#ASSERT `reg 55(6)(b) the claimant is qualified under Article VI of the Canada-United States Agreement and resides in a place where it applies` TRUE FALSE TRUE EQUALS FALSE
#ASSERT `reg 55(6)(b) the claimant is qualified under Article VI of the Canada-United States Agreement and resides in a place where it applies` TRUE TRUE FALSE EQUALS FALSE
