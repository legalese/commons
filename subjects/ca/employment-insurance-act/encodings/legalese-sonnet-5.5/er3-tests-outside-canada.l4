#ASSERT `reg 55(6) the claimant who resides outside Canada is not disentitled for the sole reason of their residence outside Canada` FALSE TRUE FALSE FALSE FALSE EQUALS FALSE
#ASSERT `reg 55(6) the claimant who resides outside Canada is not disentitled for the sole reason of their residence outside Canada` FALSE TRUE TRUE TRUE TRUE EQUALS FALSE
#ASSERT `reg 55(6) the claimant who resides outside Canada is not disentitled for the sole reason of their residence outside Canada` TRUE TRUE FALSE TRUE TRUE EQUALS FALSE
#ASSERT `reg 55(6) the claimant who resides outside Canada is not disentitled for the sole reason of their residence outside Canada` FALSE FALSE FALSE TRUE TRUE EQUALS FALSE

