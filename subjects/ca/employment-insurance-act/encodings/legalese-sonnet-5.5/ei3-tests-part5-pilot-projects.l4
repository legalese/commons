IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `ei3-part5-pilot-projects`

-- Tests of ei3-part5-pilot-projects.l4 (Act s 110).
-- Expected values are hand-worked from the text of the section. The dates are invented.

§ `s 110 expiration of regulations`

-- A regulation that came into force on 15 March 2026 ceases to have effect on 15 March 2029, the third anniversary.
#ASSERT `s 110 the day on which a regulation made under this Part ceases to have effect` (YMD 2026 3 15) EQUALS YMD 2029 3 15
#ASSERT `s 110 the regulation has ceased to have effect on the day` FALSE (YMD 2026 3 15) (YMD 2029 3 15) EQUALS JUST TRUE
#ASSERT `s 110 the regulation has ceased to have effect on the day` FALSE (YMD 2026 3 15) (YMD 2029 3 14) EQUALS JUST FALSE
#ASSERT `s 110 the regulation has ceased to have effect on the day` FALSE (YMD 2026 3 15) (YMD 2030 1 1) EQUALS JUST TRUE
#ASSERT `s 110 the regulation has ceased to have effect on the day` FALSE (YMD 2026 3 15) (YMD 2026 3 15) EQUALS JUST FALSE
-- A repealed regulation is outside the section ("that are not repealed").
#ASSERT `s 110 the regulation has ceased to have effect on the day` TRUE (YMD 2026 3 15) (YMD 2030 1 1) EQUALS NOTHING
-- In force on 29 February 2024: the third anniversary clamps to 28 February 2027.
#ASSERT `s 110 the day on which a regulation made under this Part ceases to have effect` (YMD 2024 2 29) EQUALS YMD 2027 2 28
#ASSERT `s 110 the regulation has ceased to have effect on the day` FALSE (YMD 2024 2 29) (YMD 2027 2 28) EQUALS JUST TRUE
#ASSERT `s 110 the regulation has ceased to have effect on the day` FALSE (YMD 2024 2 29) (YMD 2027 2 27) EQUALS JUST FALSE
