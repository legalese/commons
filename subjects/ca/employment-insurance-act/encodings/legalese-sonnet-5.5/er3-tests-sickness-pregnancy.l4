IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `er3-nouns`
IMPORT `er3-sickness-pregnancy`

-- Tests of er3-sickness-pregnancy (regulations 40, 41 and 41.2). Every expected value is written by hand from
-- the text of regs 40, 41 and 41.2 (SOR-96-332.txt lines 709-734) before the module was run.

§ `reg 40(1) -- the medical certificate`

#ASSERT `reg 40(1) the medical certificate is the information and evidence required` TRUE TRUE TRUE EQUALS TRUE
#ASSERT `reg 40(1) the medical certificate is the information and evidence required` FALSE TRUE TRUE EQUALS FALSE
#ASSERT `reg 40(1) the medical certificate is the information and evidence required` TRUE FALSE TRUE EQUALS FALSE
#ASSERT `reg 40(1) the medical certificate is the information and evidence required` TRUE TRUE FALSE EQUALS FALSE

§ `reg 40(2), (3) -- a medical examination, and who pays`

#ASSERT `reg 40(2) the claimant may be required to undergo a medical examination` TRUE TRUE EQUALS TRUE
#ASSERT `reg 40(2) the claimant may be required to undergo a medical examination` TRUE FALSE EQUALS FALSE
#ASSERT `reg 40(2) the claimant may be required to undergo a medical examination` FALSE TRUE EQUALS FALSE
-- (3): reimbursed for the reasonable part of the expenses, never more than was spent.
#ASSERT `reg 40(3) the amount the claimant is reimbursed for the examination` TRUE 120 100 EQUALS JUST 100
#ASSERT `reg 40(3) the amount the claimant is reimbursed for the examination` TRUE 120 120 EQUALS JUST 120
#ASSERT `reg 40(3) the amount the claimant is reimbursed for the examination` TRUE 120 150 EQUALS JUST 120
#ASSERT `reg 40(3) the amount the claimant is reimbursed for the examination` TRUE 0 0 EQUALS JUST 0
-- an examination the Commission did not require under (2) is not covered by (3).
#ASSERT `reg 40(3) the amount the claimant is reimbursed for the examination` FALSE 120 100 EQUALS NOTHING

§ `reg 40(4), (5), (6) -- illness, a terminated pregnancy, and the waiver of the waiting period`

-- (4): incapable of the regular employment and of other suitable employment (fork F11).
#ASSERT `reg 40(4) illness, injury or quarantine` TRUE TRUE TRUE EQUALS TRUE
#ASSERT `reg 40(4) illness, injury or quarantine` TRUE TRUE FALSE EQUALS FALSE
#ASSERT `reg 40(4) illness, injury or quarantine` TRUE FALSE TRUE EQUALS FALSE
#ASSERT `reg 40(4) illness, injury or quarantine` FALSE TRUE TRUE EQUALS FALSE
-- (5): terminated within the first 19 weeks (19 weeks is within, 20 is not).
#ASSERT `reg 40(5) a pregnancy terminated within the first 19 weeks is an illness` TRUE 19 EQUALS TRUE
#ASSERT `reg 40(5) a pregnancy terminated within the first 19 weeks is an illness` TRUE 20 EQUALS FALSE
#ASSERT `reg 40(5) a pregnancy terminated within the first 19 weeks is an illness` TRUE 6 EQUALS TRUE
#ASSERT `reg 40(5) a pregnancy terminated within the first 19 weeks is an illness` FALSE 6 EQUALS FALSE
-- (6): both conditions.
#ASSERT `reg 40(6) the conditions on which the Commission may waive the waiting period are met` TRUE TRUE EQUALS TRUE
#ASSERT `reg 40(6) the conditions on which the Commission may waive the waiting period are met` TRUE FALSE EQUALS FALSE
#ASSERT `reg 40(6) the conditions on which the Commission may waive the waiting period are met` FALSE TRUE EQUALS FALSE

§ `reg 41 -- pregnancy`

-- (1)(b): required only once the child is born.
#ASSERT `reg 41(1)(b) the information regarding the actual date of the birth is given as required` FALSE FALSE FALSE EQUALS TRUE
#ASSERT `reg 41(1)(b) the information regarding the actual date of the birth is given as required` TRUE TRUE TRUE EQUALS TRUE
#ASSERT `reg 41(1)(b) the information regarding the actual date of the birth is given as required` TRUE TRUE FALSE EQUALS FALSE
#ASSERT `reg 41(1)(b) the information regarding the actual date of the birth is given as required` TRUE FALSE FALSE EQUALS FALSE
-- (1): the signed statement declaring the expected date; then, after the birth, the birth date.
#ASSERT `reg 41(1) the information and evidence of pregnancy is given` TRUE TRUE FALSE FALSE FALSE EQUALS TRUE
#ASSERT `reg 41(1) the information and evidence of pregnancy is given` FALSE TRUE FALSE FALSE FALSE EQUALS FALSE
#ASSERT `reg 41(1) the information and evidence of pregnancy is given` TRUE FALSE FALSE FALSE FALSE EQUALS FALSE
#ASSERT `reg 41(1) the information and evidence of pregnancy is given` TRUE TRUE TRUE FALSE FALSE EQUALS FALSE
#ASSERT `reg 41(1) the information and evidence of pregnancy is given` TRUE TRUE TRUE TRUE TRUE EQUALS TRUE
#ASSERT `reg 41(1) the information and evidence of pregnancy is given` TRUE TRUE TRUE TRUE FALSE EQUALS FALSE
-- (2): incapable of both (fork F11).
#ASSERT `reg 41(2) pregnancy` TRUE TRUE TRUE EQUALS TRUE
#ASSERT `reg 41(2) pregnancy` TRUE TRUE FALSE EQUALS FALSE
#ASSERT `reg 41(2) pregnancy` TRUE FALSE TRUE EQUALS FALSE
#ASSERT `reg 41(2) pregnancy` FALSE TRUE TRUE EQUALS FALSE

§ `reg 41.2 -- a medical certificate issued outside Canada`

#ASSERT `reg 41.2 the medical certificate issued outside Canada may be accepted` TRUE TRUE TRUE EQUALS TRUE
#ASSERT `reg 41.2 the medical certificate issued outside Canada may be accepted` FALSE TRUE TRUE EQUALS FALSE
#ASSERT `reg 41.2 the medical certificate issued outside Canada may be accepted` TRUE FALSE TRUE EQUALS FALSE
#ASSERT `reg 41.2 the medical certificate issued outside Canada may be accepted` TRUE TRUE FALSE EQUALS FALSE
