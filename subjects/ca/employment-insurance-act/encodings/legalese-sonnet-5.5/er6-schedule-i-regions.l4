    AND (   (`Regs Sch I place in CD No.` place 34
                  AND NOT (`Regs Sch I place in CMA` place `er6 London CMA`)
                  AND NOT (`Regs Sch I s 2(9) the place is in the region of Niagara` place))   -- (a)
         OR (`Regs Sch I place in CD No.` place 37 AND NOT (`Regs Sch I place in CMA` place `er6 Windsor CMA`))   -- (b)
         OR `Regs Sch I place in CD Nos.` place (LIST 36, 38))   -- (c)

