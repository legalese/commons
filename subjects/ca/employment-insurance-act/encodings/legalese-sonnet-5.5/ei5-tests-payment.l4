IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `ei5-payment`

-- Tests of ei5-payment (Act ss 152.13 to 152.2). Expected values are written by hand from the text beside each
-- assertion. All dollar figures are invented for the cases; none is a published figure.

§ `152.13 and 152.14 the maximum number of weeks`

-- arguments: a benefit period has been established, the week is a week of unemployment in it, weeks paid for the reason, the maximum
#ASSERT `s 152.13 benefits may be paid for the week` TRUE TRUE 10 26
-- 26 weeks already paid: the maximum of s 152.14(1)(c) is reached
#ASSERT NOT (`s 152.13 benefits may be paid for the week` TRUE TRUE 26 26)
#ASSERT `s 152.13 benefits may be paid for the week` TRUE TRUE 25 26
#ASSERT NOT (`s 152.13 benefits may be paid for the week` FALSE TRUE 10 26)
#ASSERT NOT (`s 152.13 benefits may be paid for the week` TRUE FALSE 10 26)

#ASSERT `s 152.14(1) the maximum number of weeks for which benefits may be paid in a benefit period` `pregnancy` NOTHING EQUALS JUST 15
#ASSERT `s 152.14(1) the maximum number of weeks for which benefits may be paid in a benefit period` `a prescribed illness, injury or quarantine` NOTHING EQUALS JUST 26
#ASSERT `s 152.14(1) the maximum number of weeks for which benefits may be paid in a benefit period` `care or support of a family member` NOTHING EQUALS JUST 26
#ASSERT `s 152.14(1) the maximum number of weeks for which benefits may be paid in a benefit period` `care or support of a critically ill child` NOTHING EQUALS JUST 35
#ASSERT `s 152.14(1) the maximum number of weeks for which benefits may be paid in a benefit period` `care or support of a critically ill adult` NOTHING EQUALS JUST 15
-- parental: by the election
#ASSERT `s 152.14(1) the maximum number of weeks for which benefits may be paid in a benefit period` `caring for a new-born or adopted child` (JUST `the 35-week maximum`) EQUALS JUST 35
#ASSERT `s 152.14(1) the maximum number of weeks for which benefits may be paid in a benefit period` `caring for a new-born or adopted child` (JUST `the 61-week maximum`) EQUALS JUST 61
-- parental with no election: not covered
#ASSERT `s 152.14(1) the maximum number of weeks for which benefits may be paid in a benefit period` `caring for a new-born or adopted child` NOTHING EQUALS NOTHING
-- the regular reason is not a reason under this Part: not covered
#ASSERT `s 152.14(1) the maximum number of weeks for which benefits may be paid in a benefit period` `a reason other than those mentioned in subsection 12(3)` NOTHING EQUALS NOTHING

-- (2) and (4): arguments: for the care of children of a single pregnancy or placement, the election, the weeks are divided
#ASSERT `ss 152.14(2) and (4) the maximum number of weeks for a single pregnancy or placement` FALSE `the 35-week maximum` FALSE EQUALS 15
#ASSERT `ss 152.14(2) and (4) the maximum number of weeks for a single pregnancy or placement` TRUE `the 35-week maximum` FALSE EQUALS 35
#ASSERT `ss 152.14(2) and (4) the maximum number of weeks for a single pregnancy or placement` TRUE `the 35-week maximum` TRUE EQUALS 40
#ASSERT `ss 152.14(2) and (4) the maximum number of weeks for a single pregnancy or placement` TRUE `the 61-week maximum` FALSE EQUALS 61
#ASSERT `ss 152.14(2) and (4) the maximum number of weeks for a single pregnancy or placement` TRUE `the 61-week maximum` TRUE EQUALS 69

#ASSERT `s 152.14(3) the placements are regarded as a single placement of a child or children for the purpose of adoption` TRUE TRUE
#ASSERT NOT (`s 152.14(3) the placements are regarded as a single placement of a child or children for the purpose of adoption` TRUE FALSE)
#ASSERT NOT (`s 152.14(3) the placements are regarded as a single placement of a child or children for the purpose of adoption` FALSE TRUE)

#ASSERT `ss 152.14(5), (5.1) and (5.2) the maximum number of weeks of benefits in respect of one family member, critically ill child or critically ill adult` `care or support of a family member` EQUALS JUST 26
#ASSERT `ss 152.14(5), (5.1) and (5.2) the maximum number of weeks of benefits in respect of one family member, critically ill child or critically ill adult` `care or support of a critically ill child` EQUALS JUST 35
#ASSERT `ss 152.14(5), (5.1) and (5.2) the maximum number of weeks of benefits in respect of one family member, critically ill child or critically ill adult` `care or support of a critically ill adult` EQUALS JUST 15
#ASSERT `ss 152.14(5), (5.1) and (5.2) the maximum number of weeks of benefits in respect of one family member, critically ill child or critically ill adult` `pregnancy` EQUALS NOTHING

-- (5) and (6): the 52 weeks from Sunday 8 March 2026 end on Saturday 6 March 2027; a prescribed 12 weeks end on Saturday 30 May 2026
#ASSERT `ss 152.14(5) and (6) the period during which the maximum applies` (YearMonthDay 2026 3 8) NOTHING EQUALS `Period of days` OF (YearMonthDay 2026 3 8), (YearMonthDay 2027 3 6)
#ASSERT `ss 152.14(5) and (6) the period during which the maximum applies` (YearMonthDay 2026 3 8) (JUST 12) EQUALS `Period of days` OF (YearMonthDay 2026 3 8), (YearMonthDay 2026 5 30)

#ASSERT `s 152.14(7) no further benefits are payable under section 152.06 in respect of the family member` TRUE FALSE
#ASSERT NOT (`s 152.14(7) no further benefits are payable under section 152.06 in respect of the family member` TRUE TRUE)
#ASSERT NOT (`s 152.14(7) no further benefits are payable under section 152.06 in respect of the family member` FALSE FALSE)

-- (8): 50 combined weeks; if extended under s 152.11(14), the maximum benefit period less two weeks
#ASSERT `s 152.14(8) the maximum number of combined weeks` FALSE 89 EQUALS 50
#ASSERT `s 152.14(8) the maximum number of combined weeks` TRUE 89 EQUALS 87
#ASSERT `s 152.14(8) the maximum number of combined weeks` TRUE 104 EQUALS 102
#ASSERT `s 152.14(8) the combined weeks are within the maximum` 50 FALSE 89
#ASSERT NOT (`s 152.14(8) the combined weeks are within the maximum` 51 FALSE 89)
#ASSERT `s 152.14(8) the combined weeks are within the maximum` 87 TRUE 89
#ASSERT NOT (`s 152.14(8) the combined weeks are within the maximum` 88 TRUE 89)

§ `152.15 and 152.151 the waiting period`

#ASSERT `s 152.15 the waiting period of a self-employed person, in weeks` EQUALS 1
#ASSERT NOT (`s 152.15 the person has served the waiting period and is entitled to be paid benefits` 0)
#ASSERT `s 152.15 the person has served the waiting period and is entitled to be paid benefits` 1
#ASSERT `s 152.15 the person has served the waiting period and is entitled to be paid benefits` 2

-- 152.151(1), a rate under $200: the first $50 of earnings is not deducted; the week counts while benefits after deducting the
-- rest of the earnings exceed zero. Rate 150: earnings of 199.99 leave 0.01; earnings of 200 leave nothing.
#ASSERT `s 152.151(1) the week of unemployment is deemed to be a week for which benefits would otherwise be payable` 150 0
#ASSERT `s 152.151(1) the week of unemployment is deemed to be a week for which benefits would otherwise be payable` 150 50
#ASSERT `s 152.151(1) the week of unemployment is deemed to be a week for which benefits would otherwise be payable` 150 199.99
#ASSERT NOT (`s 152.151(1) the week of unemployment is deemed to be a week for which benefits would otherwise be payable` 150 200)
-- rate 199.99 is still under $200: $50 is not deducted: 199.99 - (249.98 - 50) = 0.01
#ASSERT `s 152.151(1) the week of unemployment is deemed to be a week for which benefits would otherwise be payable` 199.99 249.98
#ASSERT NOT (`s 152.151(1) the week of unemployment is deemed to be a week for which benefits would otherwise be payable` 199.99 249.99)
-- rate 200 or more: 25% of the rate is not deducted; 25% of 200 is 50
#ASSERT `s 152.151(1) the week of unemployment is deemed to be a week for which benefits would otherwise be payable` 200 249.99
#ASSERT NOT (`s 152.151(1) the week of unemployment is deemed to be a week for which benefits would otherwise be payable` 200 250)
-- rate 400: 25% is 100; earnings of 499.99 leave 0.01
#ASSERT `s 152.151(1) the week of unemployment is deemed to be a week for which benefits would otherwise be payable` 400 499.99
#ASSERT NOT (`s 152.151(1) the week of unemployment is deemed to be a week for which benefits would otherwise be payable` 400 500)

§ `152.16 and 152.17 the rate`

-- (2) the aggregate is held to the maximum yearly insurable earnings
#ASSERT `ss 152.16(2) and 152.18(2.1) the part of the aggregate taken into account` 50000 65700 EQUALS 50000
#ASSERT `ss 152.16(2) and 152.18(2.1) the part of the aggregate taken into account` 65700 65700 EQUALS 65700
#ASSERT `ss 152.16(2) and 152.18(2.1) the part of the aggregate taken into account` 70000 65700 EQUALS 65700

-- (1) arguments: self-employed earnings, insurable earnings from employment, maximum yearly insurable earnings,
-- the week is paid under s 152.05, the election
-- 55% of 30000 / 52 = 16500 / 52 = 317.31, to 317
#ASSERT `s 152.16(1) the rate of weekly benefits payable to a self-employed person` 30000 0 65700 FALSE `the 35-week maximum` EQUALS 317
-- 55% of (30000 + 20000) / 52 = 27500 / 52 = 528.85, to 529
#ASSERT `s 152.16(1) the rate of weekly benefits payable to a self-employed person` 30000 20000 65700 FALSE `the 35-week maximum` EQUALS 529
-- held to the maximum: 55% of 65700 / 52 = 36135 / 52 = 694.90, to 695
#ASSERT `s 152.16(1) the rate of weekly benefits payable to a self-employed person` 100000 0 65700 FALSE `the 35-week maximum` EQUALS 695
-- parental weeks under the 61-week election: 33% of 50000 / 52 = 16500 / 52 = 317.31, to 317
#ASSERT `s 152.16(1) the rate of weekly benefits payable to a self-employed person` 30000 20000 65700 TRUE `the 61-week maximum` EQUALS 317
-- parental weeks under the 35-week election: 55% applies
#ASSERT `s 152.16(1) the rate of weekly benefits payable to a self-employed person` 30000 20000 65700 TRUE `the 35-week maximum` EQUALS 529
-- the 33% is only for the weeks paid under s 152.05: other weeks of a 61-week-election person are at 55%
#ASSERT `s 152.16(1) the rate of weekly benefits payable to a self-employed person` 30000 20000 65700 FALSE `the 61-week maximum` EQUALS 529
-- the rounding: 55% of 520 / 52 = 5.5, the higher dollar, 6; 519 gives 5.489, 5; 521 gives 5.51, 6
#ASSERT `s 152.16(1) the rate of weekly benefits payable to a self-employed person` 520 0 65700 FALSE `the 35-week maximum` EQUALS 6
#ASSERT `s 152.16(1) the rate of weekly benefits payable to a self-employed person` 519 0 65700 FALSE `the 35-week maximum` EQUALS 5
#ASSERT `s 152.16(1) the rate of weekly benefits payable to a self-employed person` 521 0 65700 FALSE `the 35-week maximum` EQUALS 6

-- 152.17(1): arguments: has dependent children, meets the prescribed criteria, the supplement the regulations determine
#ASSERT `s 152.17(1) the family supplement by which the rate is increased` TRUE TRUE 40 EQUALS 40
#ASSERT `s 152.17(1) the family supplement by which the rate is increased` FALSE TRUE 40 EQUALS 0
#ASSERT `s 152.17(1) the family supplement by which the rate is increased` TRUE FALSE 40 EQUALS 0
-- (4) the greatest increase: 25% of 20800 / 52 = 100; with a prescribed 30%, 120; 25% of 20000 / 52 = 96.15, 96
#ASSERT `s 152.17(4) the greatest increase in the rate of weekly benefits` 20800 NOTHING EQUALS 100
#ASSERT `s 152.17(4) the greatest increase in the rate of weekly benefits` 20800 (JUST (30%)) EQUALS 120
#ASSERT `s 152.17(4) the greatest increase in the rate of weekly benefits` 20000 NOTHING EQUALS 96
-- (5) the maximum rate: 55% of 65700 / 52 = 694.90, to 695
#ASSERT `s 152.17(5) the maximum rate of weekly benefits` 65700 EQUALS 695
-- the rate with the supplement: 400 + min(100, 80) = 480, under the maximum 695
#ASSERT `s 152.17 the rate of weekly benefits with the family supplement` 400 100 80 695 EQUALS 480
-- 650 + 100 = 750 is held to the maximum rate, 695
#ASSERT `s 152.17 the rate of weekly benefits with the family supplement` 650 100 100 695 EQUALS 695
-- no supplement
#ASSERT `s 152.17 the rate of weekly benefits with the family supplement` 400 0 80 695 EQUALS 400

§ `152.18 and 152.19 deductions`

-- (1) not exceeding the earnings: prescribed 300 against earnings of 200 gives 200; prescribed 150 gives 150
#ASSERT `s 152.18(1) the amount deducted from the benefits payable for the first three weeks` 200 300 EQUALS 200
#ASSERT `s 152.18(1) the amount deducted from the benefits payable for the first three weeks` 200 150 EQUALS 150

-- (2) an aggregate of 26000 gives a weekly figure of 500 and 90% of it is 450
-- arguments: earnings of the week, the aggregate, the maximum yearly insurable earnings
#ASSERT `s 152.18(2) the deduction for earnings in a week of unemployment` 0 26000 65700 EQUALS 0
#ASSERT `s 152.18(2) the deduction for earnings in a week of unemployment` 400 26000 65700 EQUALS 200
-- exactly 90% of the weekly figure: 50% of 450
#ASSERT `s 152.18(2) the deduction for earnings in a week of unemployment` 450 26000 65700 EQUALS 225
-- above it: 50% of 450 plus all of 50
#ASSERT `s 152.18(2) the deduction for earnings in a week of unemployment` 500 26000 65700 EQUALS 275
-- rounding: 50% of 401 is 200.5, the higher dollar, 201; 50% of 449 is 224.5, 225
#ASSERT `s 152.18(2) the deduction for earnings in a week of unemployment` 401 26000 65700 EQUALS 201
#ASSERT `s 152.18(2) the deduction for earnings in a week of unemployment` 449 26000 65700 EQUALS 225
-- (2.1) the aggregate is held to the maximum: 100000 held to 52000 gives 1000 a week and 900 at 90%; earnings of 1000: 450 + 100
#ASSERT `s 152.18(2) the deduction for earnings in a week of unemployment` 1000 100000 52000 EQUALS 550

-- (3)(a) arguments: the undeclared earnings, knowingly failed (Commission's opinion), (A), (B)
#ASSERT `s 152.18(3)(a) the amount to be deducted for undeclared earnings` 1000 TRUE 300 100 EQUALS 1000
-- otherwise: 1000 less (300 - 100) = 800
#ASSERT `s 152.18(3)(a) the amount to be deducted for undeclared earnings` 1000 FALSE 300 100 EQUALS 800
#ASSERT `s 152.18(3)(a) the amount to be deducted for undeclared earnings` 1000 FALSE 100 100 EQUALS 1000
-- the difference cannot take the amount below zero
#ASSERT `s 152.18(3)(a) the amount to be deducted for undeclared earnings` 1000 FALSE 1500 0 EQUALS 0

-- (3)(b) the deduction is taken from consecutive weeks of benefits paid: 250 from weeks of 100 is 100, 100, 50
#ASSERT `s 152.18(3)(b) the amounts deducted in consecutive weeks` 250 (LIST 100, 100, 100, 100) EQUALS LIST 100, 100, 50
#ASSERT `s 152.18(3)(b) the amounts deducted in consecutive weeks` 0 (LIST 100) EQUALS EMPTY
-- the weeks of benefits run out before the amount is recovered: 450 from two weeks of 100 takes 200
#ASSERT `s 152.18(3)(b) the amounts deducted in consecutive weeks` 450 (LIST 100, 100) EQUALS LIST 100, 100
-- weeks of different benefits
#ASSERT `s 152.18(3)(b) the amounts deducted in consecutive weeks` 300 (LIST 120, 90, 200) EQUALS LIST 120, 90, 90
#ASSERT `s 152.18(3)(b) the amounts deducted in consecutive weeks` 100 (LIST 100, 100) EQUALS LIST 100

-- 152.19: one fifth of the weekly rate for each working day: 400 / 5 = 80, two days = 160
#ASSERT `ss 152.19(1) and (2) the deduction for working days on which the person is not entitled` 400 2 EQUALS 160
-- 407 / 5 = 81.4, to 81, three days = 243
#ASSERT `ss 152.19(1) and (2) the deduction for working days on which the person is not entitled` 407 3 EQUALS 243
-- 402.5 / 5 = 80.5, the higher dollar, 81
#ASSERT `ss 152.19(1) and (2) the deduction for working days on which the person is not entitled` 402.5 1 EQUALS 81
#ASSERT `ss 152.19(1) and (2) the deduction for working days on which the person is not entitled` 400 0 EQUALS 0

§ `152.2 prison inmates and persons outside Canada`

-- arguments: an inmate of a prison or similar institution, not in Canada, a regulation otherwise provides
#ASSERT `s 152.2 the person is not entitled to receive benefits for the period` TRUE FALSE FALSE
#ASSERT `s 152.2 the person is not entitled to receive benefits for the period` FALSE TRUE FALSE
#ASSERT `s 152.2 the person is not entitled to receive benefits for the period` TRUE TRUE FALSE
#ASSERT NOT (`s 152.2 the person is not entitled to receive benefits for the period` FALSE FALSE FALSE)
-- "Except as may otherwise be prescribed": a regulation for the person's case (regs 54(2), 55.01) restores entitlement
#ASSERT NOT (`s 152.2 the person is not entitled to receive benefits for the period` TRUE FALSE TRUE)
#ASSERT NOT (`s 152.2 the person is not entitled to receive benefits for the period` FALSE TRUE TRUE)
