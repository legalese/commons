IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `er1-insurable-employment`

-- Tests of er1-insurable-employment (Employment Insurance Regulations, regs 2 to 9). Piece er1.
-- Every expected value is written by hand from the text of the Regulations (../../registers/source-bundle/SOR-96-332.txt), beside the assertion,
-- before the rule was run. The argument order is the order of the rule's GIVEN lines; each group says what the positions are.

§ `Regulation 2 - employment by a province (src:51-52)`

-- reg 2(2) arguments: in Canada; appointed under the province's public service Act; remunerated under it; employed by an agent body of the province
#ASSERT `reg 2(2) employment by Her Majesty in right of a province, for the purposes of subsection (1)` TRUE TRUE TRUE FALSE
#ASSERT `reg 2(2) employment by Her Majesty in right of a province, for the purposes of subsection (1)` TRUE FALSE FALSE TRUE
#ASSERT NOT (`reg 2(2) employment by Her Majesty in right of a province, for the purposes of subsection (1)` TRUE TRUE FALSE FALSE)  -- appointed but not remunerated under that Act: "appointed and remunerated"
#ASSERT NOT (`reg 2(2) employment by Her Majesty in right of a province, for the purposes of subsection (1)` TRUE FALSE TRUE FALSE)  -- remunerated but not appointed
#ASSERT NOT (`reg 2(2) employment by Her Majesty in right of a province, for the purposes of subsection (1)` FALSE TRUE TRUE TRUE)   -- not employment in Canada
-- reg 2(1) arguments: the four above; would but for 5(2)(c) be insurable; agreement entered into; waives exclusion; insures all its employees engaged in such employment
#ASSERT `reg 2(1) employment in Canada by Her Majesty in right of a province` TRUE TRUE TRUE FALSE TRUE TRUE TRUE TRUE
#ASSERT `reg 2(1) employment in Canada by Her Majesty in right of a province` TRUE FALSE FALSE TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`reg 2(1) employment in Canada by Her Majesty in right of a province` TRUE TRUE TRUE FALSE TRUE FALSE TRUE TRUE)   -- no agreement with the Commission
#ASSERT NOT (`reg 2(1) employment in Canada by Her Majesty in right of a province` TRUE TRUE TRUE FALSE TRUE TRUE FALSE TRUE)   -- agreement does not waive the exclusion
#ASSERT NOT (`reg 2(1) employment in Canada by Her Majesty in right of a province` TRUE TRUE TRUE FALSE TRUE TRUE TRUE FALSE)   -- agreement does not insure all its employees
#ASSERT NOT (`reg 2(1) employment in Canada by Her Majesty in right of a province` TRUE TRUE TRUE FALSE FALSE TRUE TRUE TRUE)   -- would not be insurable but for 5(2)(c)
#ASSERT NOT (`reg 2(1) employment in Canada by Her Majesty in right of a province` TRUE FALSE FALSE FALSE TRUE TRUE TRUE TRUE)  -- employee outside the "includes only" of reg 2(2)

§ `Regulation 3 - employment by a foreign government or an international organization (src:53-54)`

-- reg 3(2) arguments: a consent was given under the Unemployment Insurance Regulations as they read immediately before June 30, 1996; the consent has been revoked
#ASSERT `reg 3(2) the consent is considered to be a consent referred to in subsection (1)` TRUE FALSE
#ASSERT NOT (`reg 3(2) the consent is considered to be a consent referred to in subsection (1)` TRUE TRUE)    -- "and has not been revoked"
#ASSERT NOT (`reg 3(2) the consent is considered to be a consent referred to in subsection (1)` FALSE FALSE)
-- reg 3(1) arguments: in Canada; employer is a foreign government or subdivision; employer is an international organization; would but for 5(2)(d) and (e) be insurable; consents in writing; reg 3(2) consent
#ASSERT `reg 3(1) employment by a foreign government or an international organization` TRUE TRUE FALSE TRUE TRUE FALSE
#ASSERT `reg 3(1) employment by a foreign government or an international organization` TRUE FALSE TRUE TRUE TRUE FALSE
#ASSERT `reg 3(1) employment by a foreign government or an international organization` TRUE TRUE FALSE TRUE FALSE TRUE   -- an old consent under reg 3(2) stands in for the written consent
#ASSERT NOT (`reg 3(1) employment by a foreign government or an international organization` TRUE TRUE FALSE TRUE FALSE FALSE)  -- no consent
#ASSERT NOT (`reg 3(1) employment by a foreign government or an international organization` TRUE FALSE FALSE TRUE TRUE FALSE) -- neither a foreign government nor an international organization
#ASSERT NOT (`reg 3(1) employment by a foreign government or an international organization` TRUE TRUE FALSE FALSE TRUE FALSE) -- would not be insurable but for 5(2)(d) and (e)
#ASSERT NOT (`reg 3(1) employment by a foreign government or an international organization` FALSE TRUE FALSE TRUE TRUE FALSE) -- not in Canada

§ `Regulation 4 - employment on a ship outside Canada (src:55-60)`

-- arguments: on a ship outside or partly outside Canada; would be insurable in Canada; ship of Canadian registry or licence; regularly employed in voyages between ports outside Canada;
-- chartered to a person resident outside Canada; chartered to a person resident in Canada; regularly employed in voyages from a port in Canada; operation principally controlled in Canada;
-- owner or managing owner resides or has a place of business in Canada; employment subject to the Act by an agreement with the ship's flag jurisdiction
#ASSERT `reg 4 employment on a ship outside Canada` TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE      -- (a) a ship of Canadian registry
#ASSERT `reg 4 employment on a ship outside Canada` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE       -- (a) regularly between ports outside Canada, but not chartered to a non-resident
#ASSERT `reg 4 employment on a ship outside Canada` TRUE TRUE TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE       -- (a) chartered to a non-resident, but not regularly between ports outside Canada
#ASSERT NOT (`reg 4 employment on a ship outside Canada` TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE)   -- (a) the exception: regularly between ports outside Canada and chartered to a non-resident
#ASSERT `reg 4 employment on a ship outside Canada` TRUE TRUE FALSE FALSE FALSE TRUE TRUE FALSE FALSE FALSE       -- (b)(i) chartered to a Canadian resident and regularly sailing from a Canadian port
#ASSERT NOT (`reg 4 employment on a ship outside Canada` TRUE TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE) -- (b)(i) chartered, but not regularly sailing from a Canadian port
#ASSERT `reg 4 employment on a ship outside Canada` TRUE TRUE FALSE FALSE FALSE FALSE TRUE TRUE TRUE FALSE         -- (b)(ii) controlled in Canada, sailing from a Canadian port, owner in Canada
#ASSERT NOT (`reg 4 employment on a ship outside Canada` TRUE TRUE FALSE FALSE FALSE FALSE TRUE TRUE FALSE FALSE)  -- (b)(ii) owner not in Canada
#ASSERT NOT (`reg 4 employment on a ship outside Canada` TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE TRUE FALSE)  -- (b)(ii) not sailing regularly from a Canadian port
#ASSERT `reg 4 employment on a ship outside Canada` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE       -- (b)(iii) an agreement with the ship's flag jurisdiction
#ASSERT NOT (`reg 4 employment on a ship outside Canada` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE) -- foreign ship, none of (i) to (iii)
#ASSERT NOT (`reg 4 employment on a ship outside Canada` FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE) -- not on a ship outside Canada
#ASSERT NOT (`reg 4 employment on a ship outside Canada` TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE) -- would not be insurable if it were in Canada

§ `Regulation 5 - employment outside Canada (src:61-65)`

-- arguments: outside Canada; on a ship described in section 4; ordinarily resides in Canada; employer resident or with a place of business in Canada; would be insurable in Canada; not insurable under the other country's laws
#ASSERT `reg 5 employment outside Canada` TRUE FALSE TRUE TRUE TRUE TRUE
#ASSERT NOT (`reg 5 employment outside Canada` TRUE TRUE TRUE TRUE TRUE TRUE)     -- "other than employment on a ship described in section 4"
#ASSERT NOT (`reg 5 employment outside Canada` FALSE FALSE TRUE TRUE TRUE TRUE)   -- not outside Canada
#ASSERT NOT (`reg 5 employment outside Canada` TRUE FALSE FALSE TRUE TRUE TRUE)   -- (a) the person does not ordinarily reside in Canada
#ASSERT NOT (`reg 5 employment outside Canada` TRUE FALSE TRUE FALSE TRUE TRUE)   -- (b) the employer is not resident or doing business in Canada
#ASSERT NOT (`reg 5 employment outside Canada` TRUE FALSE TRUE TRUE FALSE TRUE)   -- (c) would not be insurable if in Canada
#ASSERT NOT (`reg 5 employment outside Canada` TRUE FALSE TRUE TRUE TRUE FALSE)   -- (d) insurable under the laws of the country where it takes place

§ `Regulation 6 - employments included (src:66-79)`

-- (a) arguments: union member employed by the union; in conducting union business; the work is picketing in a labour dispute
#ASSERT `reg 6(a) employment of a union member by the member's union` TRUE TRUE FALSE
#ASSERT NOT (`reg 6(a) employment of a union member by the member's union` TRUE TRUE TRUE)    -- "other than picketing in a labour dispute"
#ASSERT NOT (`reg 6(a) employment of a union member by the member's union` TRUE FALSE FALSE)  -- not in conducting union business
#ASSERT `reg 6(b) employment of a person as an apprentice or trainee` TRUE
#ASSERT NOT (`reg 6(b) employment of a person as an apprentice or trainee` FALSE)
-- (c) arguments: clergy; member of a religious order
#ASSERT `reg 6(c) employment of a person as a member of the clergy or of a religious order` TRUE FALSE
#ASSERT `reg 6(c) employment of a person as a member of the clergy or of a religious order` FALSE TRUE
#ASSERT NOT (`reg 6(c) employment of a person as a member of the clergy or of a religious order` FALSE FALSE)
-- (d) arguments: employed in a barbering or hairdressing establishment; provides the services normally provided there; is the owner or operator
#ASSERT `reg 6(d) employment in a barbering or hairdressing establishment` TRUE TRUE FALSE
#ASSERT NOT (`reg 6(d) employment in a barbering or hairdressing establishment` TRUE TRUE TRUE)    -- the owner or operator of the establishment
#ASSERT NOT (`reg 6(d) employment in a barbering or hairdressing establishment` TRUE FALSE FALSE)  -- does not provide the services (for instance, a bookkeeper)
-- (e) arguments: a driver of a passenger vehicle used by a business or public authority; the portion of the vehicle owned (a fraction); owner or operator of the business; operator of the public authority
#ASSERT `reg 6(e) employment as a driver of a vehicle that carries passengers` TRUE (0%) FALSE FALSE
#ASSERT `reg 6(e) employment as a driver of a vehicle that carries passengers` TRUE (50%) FALSE FALSE            -- "not the owner of more than 50 per cent": exactly 50 per cent is not more
#ASSERT NOT (`reg 6(e) employment as a driver of a vehicle that carries passengers` TRUE (51%) FALSE FALSE)     -- more than 50 per cent
#ASSERT NOT (`reg 6(e) employment as a driver of a vehicle that carries passengers` TRUE (0%) TRUE FALSE)         -- the owner or operator of the business
#ASSERT NOT (`reg 6(e) employment as a driver of a vehicle that carries passengers` TRUE (0%) FALSE TRUE)         -- the operator of the public authority
#ASSERT NOT (`reg 6(e) employment as a driver of a vehicle that carries passengers` FALSE (0%) FALSE FALSE)       -- not such a driver
-- (f) arguments: holds an office (CPP); (i) federal administration; (ii) provincial public service of an insuring province; (iii) agent body of such a province; holds office in a union or association;
-- elected by popular vote; elected or appointed in a representative capacity; already included by paragraph (a)
#ASSERT `reg 6(f) employment of a person who holds an office` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE
#ASSERT `reg 6(f) employment of a person who holds an office` TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE
#ASSERT `reg 6(f) employment of a person who holds an office` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE
#ASSERT `reg 6(f) employment of a person who holds an office` TRUE FALSE FALSE FALSE TRUE TRUE FALSE FALSE      -- (iv) elected by popular vote
#ASSERT `reg 6(f) employment of a person who holds an office` TRUE FALSE FALSE FALSE TRUE FALSE TRUE FALSE      -- (iv) elected or appointed in a representative capacity
#ASSERT NOT (`reg 6(f) employment of a person who holds an office` TRUE FALSE FALSE FALSE TRUE TRUE FALSE TRUE)  -- (iv) "not included ... by paragraph (a)"
#ASSERT NOT (`reg 6(f) employment of a person who holds an office` TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE) -- (iv) neither elected nor appointed in a representative capacity
#ASSERT NOT (`reg 6(f) employment of a person who holds an office` FALSE TRUE TRUE TRUE TRUE TRUE TRUE FALSE)   -- holds no office as the Canada Pension Plan defines it
#ASSERT NOT (`reg 6(f) employment of a person who holds an office` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
-- (g) arguments: placed by an agency; to perform services for and under the direction and control of a client; remunerated by the agency
#ASSERT `reg 6(g) employment of a person who is placed by a placement or employment agency` TRUE TRUE TRUE
#ASSERT NOT (`reg 6(g) employment of a person who is placed by a placement or employment agency` TRUE TRUE FALSE)  -- paid by the client, not by the agency
#ASSERT NOT (`reg 6(g) employment of a person who is placed by a placement or employment agency` TRUE FALSE TRUE)
#ASSERT NOT (`reg 6(g) employment of a person who is placed by a placement or employment agency` FALSE TRUE TRUE)
-- the combination: arguments (a) (b) (c) (d) (e) (f) (g); excluded by any provision of these Regulations
#ASSERT `reg 6 employment included` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE
#ASSERT `reg 6 employment included` FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE
#ASSERT NOT (`reg 6 employment included` TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE)    -- "unless it is excluded from insurable employment by any provision of these Regulations"
#ASSERT NOT (`reg 6 employment included` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE) -- none of the seven kinds
-- regs 2 to 6 together: arguments reg 2(1) reg 3(1) reg 4 reg 5 reg 6
#ASSERT `reg 2 to 6 employment included in insurable employment` TRUE FALSE FALSE FALSE FALSE
#ASSERT `reg 2 to 6 employment included in insurable employment` FALSE TRUE FALSE FALSE FALSE
#ASSERT `reg 2 to 6 employment included in insurable employment` FALSE FALSE TRUE FALSE FALSE
#ASSERT `reg 2 to 6 employment included in insurable employment` FALSE FALSE FALSE TRUE FALSE
#ASSERT `reg 2 to 6 employment included in insurable employment` FALSE FALSE FALSE FALSE TRUE
#ASSERT NOT (`reg 2 to 6 employment included in insurable employment` FALSE FALSE FALSE FALSE FALSE)

§ `Regulation 7 - employments excluded (src:82-92)`

#ASSERT `reg 7(a) repealed in this text` EQUALS "reg 7(a): [Repealed, SOR/97-310, s. 1]"
-- (b) arguments: member of a religious order; has taken a vow of poverty; remuneration paid directly to the order; paid by that person to the order
#ASSERT `reg 7(b) employment of a member of a religious order who has taken a vow of poverty` TRUE TRUE TRUE FALSE
#ASSERT `reg 7(b) employment of a member of a religious order who has taken a vow of poverty` TRUE TRUE FALSE TRUE
#ASSERT NOT (`reg 7(b) employment of a member of a religious order who has taken a vow of poverty` TRUE FALSE TRUE FALSE)   -- no vow of poverty
#ASSERT NOT (`reg 7(b) employment of a member of a religious order who has taken a vow of poverty` TRUE TRUE FALSE FALSE)   -- remuneration does not go to the order
#ASSERT NOT (`reg 7(b) employment of a member of a religious order who has taken a vow of poverty` FALSE TRUE TRUE TRUE)    -- not a member of a religious order
-- (c) arguments: premiums payable under a United States state's law; by reason of the 1942 Agreement; premiums payable under the Railroad Unemployment Insurance Act
#ASSERT `reg 7(c) employment in respect of which premiums are payable under the law of the United States` TRUE TRUE FALSE
#ASSERT `reg 7(c) employment in respect of which premiums are payable under the law of the United States` FALSE FALSE TRUE
#ASSERT NOT (`reg 7(c) employment in respect of which premiums are payable under the law of the United States` TRUE FALSE FALSE)  -- (i) needs "by reason of the Agreement"
#ASSERT NOT (`reg 7(c) employment in respect of which premiums are payable under the law of the United States` FALSE TRUE FALSE)
-- (d) arguments: in Canada; the person resides in another country; premiums payable under that country's laws for the services in Canada
#ASSERT `reg 7(d) employment in Canada of a person who resides in another country` TRUE TRUE TRUE
#ASSERT NOT (`reg 7(d) employment in Canada of a person who resides in another country` FALSE TRUE TRUE)
#ASSERT NOT (`reg 7(d) employment in Canada of a person who resides in another country` TRUE FALSE TRUE)
#ASSERT NOT (`reg 7(d) employment in Canada of a person who resides in another country` TRUE TRUE FALSE)
-- (e) arguments: for the purpose of a rescue operation; the person is regularly employed by that employer
#ASSERT `reg 7(e) employment for the purpose of a rescue operation` TRUE FALSE
#ASSERT NOT (`reg 7(e) employment for the purpose of a rescue operation` TRUE TRUE)
#ASSERT NOT (`reg 7(e) employment for the purpose of a rescue operation` FALSE FALSE)
-- (f) arguments: under a measure referred to in paragraph 59(b); under a measure that is the subject of an agreement under section 63; established to help insured participants start businesses; established to provide work experience
#ASSERT `reg 7(f) employment under an employment support measure` TRUE FALSE TRUE FALSE
#ASSERT `reg 7(f) employment under an employment support measure` FALSE TRUE FALSE TRUE
#ASSERT NOT (`reg 7(f) employment under an employment support measure` TRUE FALSE FALSE FALSE)  -- a 59(b) measure established for neither purpose
#ASSERT NOT (`reg 7(f) employment under an employment support measure` FALSE FALSE TRUE TRUE)   -- not under either kind of measure
-- the combination: arguments (b) (c) (d) (e) (f)
#ASSERT `reg 7 employment excluded` TRUE FALSE FALSE FALSE FALSE
#ASSERT `reg 7 employment excluded` FALSE FALSE FALSE FALSE TRUE
#ASSERT NOT (`reg 7 employment excluded` FALSE FALSE FALSE FALSE FALSE)

§ `Regulation 8 - short employments (src:93-103)`

-- (1)(a) arguments: connected with a circus, fair, parade etc.; as an entertainer; regularly employed by that employer; days employed in the year
#ASSERT `reg 8(1)(a) employment in connection with a circus, fair or similar activity` TRUE FALSE FALSE 6
#ASSERT NOT (`reg 8(1)(a) employment in connection with a circus, fair or similar activity` TRUE FALSE FALSE 7)    -- "less than seven days": seven is not less
#ASSERT `reg 8(1)(a) employment in connection with a circus, fair or similar activity` TRUE FALSE FALSE 0
#ASSERT NOT (`reg 8(1)(a) employment in connection with a circus, fair or similar activity` TRUE TRUE FALSE 3)     -- "other than as an entertainer"
#ASSERT NOT (`reg 8(1)(a) employment in connection with a circus, fair or similar activity` TRUE FALSE TRUE 3)     -- regularly employed by that employer
#ASSERT NOT (`reg 8(1)(a) employment in connection with a circus, fair or similar activity` FALSE FALSE FALSE 3)   -- not in connection with such an activity
#ASSERT `reg 8(1)(b) repealed in this text` EQUALS "reg 8(1)(b): [Repealed, SOR/98-588, s. 1]"
-- (1)(c) arguments: the employer is Canada, a province, a municipality or a school board; connected with a referendum or election; regularly employed; the year; hours in the year
#ASSERT `reg 8(1)(c) employment in connection with a referendum or election` TRUE TRUE FALSE 1999 34
#ASSERT NOT (`reg 8(1)(c) employment in connection with a referendum or election` TRUE TRUE FALSE 1999 35)   -- "less than 35 hours": 35 is not less
#ASSERT `reg 8(1)(c) employment in connection with a referendum or election` TRUE TRUE FALSE 2026 0
#ASSERT NOT (`reg 8(1)(c) employment in connection with a referendum or election` TRUE TRUE FALSE 1998 10)   -- "in any year after 1998": 1998 is not after 1998
#ASSERT NOT (`reg 8(1)(c) employment in connection with a referendum or election` FALSE TRUE FALSE 2010 10)  -- the employer is none of the four named employers
#ASSERT NOT (`reg 8(1)(c) employment in connection with a referendum or election` TRUE FALSE FALSE 2010 10)  -- not connected with a referendum or election
#ASSERT NOT (`reg 8(1)(c) employment in connection with a referendum or election` TRUE TRUE TRUE 2010 10)    -- regularly employed
-- (2) arguments: excluded under (1)(a) or (c); becomes a regular employment; the day and hour it became regular
#ASSERT `reg 8(2) the point from which the employment is insurable` TRUE TRUE (`er1 Day and hour` OF (YearMonthDay 2026 10 20), 9) EQUALS JUST (`er1 Day and hour` OF (YearMonthDay 2026 10 20), 9)
#ASSERT `reg 8(2) the point from which the employment is insurable` TRUE FALSE (`er1 Day and hour` OF (YearMonthDay 2026 10 20), 9) EQUALS NOTHING
#ASSERT `reg 8(2) the point from which the employment is insurable` FALSE TRUE (`er1 Day and hour` OF (YearMonthDay 2026 10 20), 9) EQUALS NOTHING
-- (3) arguments: employed by the same employer in employments excluded under (1)(a); the total period in days; the day the total period began
#ASSERT `reg 8(3) the day from which the employments taken together are insurable` TRUE 7 (YearMonthDay 2026 6 1) EQUALS JUST (YearMonthDay 2026 6 1)  -- "exceeds six days": seven does
#ASSERT `reg 8(3) the day from which the employments taken together are insurable` TRUE 6 (YearMonthDay 2026 6 1) EQUALS NOTHING             -- six does not
#ASSERT `reg 8(3) the day from which the employments taken together are insurable` FALSE 9 (YearMonthDay 2026 6 1) EQUALS NOTHING
-- (4) arguments: employed by the same employer in employments excluded under (1)(c); the total period in hours; the day and hour the total period began
#ASSERT `reg 8(4) the hour from which the employments taken together are insurable` TRUE 35 (`er1 Day and hour` OF (YearMonthDay 2026 6 1), 8) EQUALS JUST (`er1 Day and hour` OF (YearMonthDay 2026 6 1), 8)  -- "exceeds 34 hours": 35 does
#ASSERT `reg 8(4) the hour from which the employments taken together are insurable` TRUE 34 (`er1 Day and hour` OF (YearMonthDay 2026 6 1), 8) EQUALS NOTHING                                      -- 34 does not
#ASSERT `reg 8(4) the hour from which the employments taken together are insurable` FALSE 40 (`er1 Day and hour` OF (YearMonthDay 2026 6 1), 8) EQUALS NOTHING

§ `Regulation 9 - agriculture, agricultural enterprise and horticulture (src:104-129)`

-- agriculture, listed operations: arguments: the operation; carried out on a farm; the selling is incidental to those operations; those operations are incidental to the selling
#ASSERT `reg 9(1) agriculture, listed operations` `er1 (a)(i) clearing land for cultivation` TRUE FALSE FALSE
#ASSERT `reg 9(1) agriculture, listed operations` `er1 (a)(ii) cultivation of the soil` TRUE FALSE FALSE
#ASSERT `reg 9(1) agriculture, listed operations` `er1 (a)(iii) conservation of the soil, including the construction, maintenance and operation of tile drainage systems, ditches, canals, reservoirs or waterways exclusively for the purposes of farming` TRUE FALSE FALSE
#ASSERT `reg 9(1) agriculture, listed operations` `er1 (a)(iv) harvesting, storing or grading any natural product of farming` TRUE FALSE FALSE
#ASSERT `reg 9(1) agriculture, listed operations` `er1 (a)(v) preparing land for the growing and harvesting of wild berries` TRUE FALSE FALSE
#ASSERT `reg 9(1) agriculture, listed operations` `er1 (a)(vi) raising bees and producing honey` TRUE FALSE FALSE
#ASSERT `reg 9(1) agriculture, listed operations` `er1 (a)(vii) breeding or raising animals or birds, or producing eggs` TRUE FALSE FALSE
#ASSERT `reg 9(1) agriculture, listed operations` `er1 (a)(viii) dairy farming and the processing of milk, butter or cheese that is produced on that farm` TRUE FALSE FALSE
#ASSERT `reg 9(1) agriculture, listed operations` `er1 (a)(ix) producing maple sap, maple syrup or maple sugar` TRUE FALSE FALSE
#ASSERT NOT (`reg 9(1) agriculture, listed operations` `er1 (a)(ii) cultivation of the soil` FALSE TRUE TRUE)    -- paragraph (a) operations count "where carried out on a farm"
#ASSERT `reg 9(1) agriculture, listed operations` `er1 (b)(i) offering for sale or selling any of the products of the operations referred to in subparagraphs (a)(i) to (ix)` FALSE TRUE FALSE   -- (b) is "on or off a farm" if incidental
#ASSERT NOT (`reg 9(1) agriculture, listed operations` `er1 (b)(i) offering for sale or selling any of the products of the operations referred to in subparagraphs (a)(i) to (ix)` TRUE FALSE TRUE)   -- (b)(i) not incidental
#ASSERT `reg 9(1) agriculture, listed operations` `er1 (b)(ii) exhibiting, advertising, assembling, freezing, storing, grading, preparing, processing, packing and transporting the products described in subparagraph (i)` FALSE FALSE TRUE
#ASSERT NOT (`reg 9(1) agriculture, listed operations` `er1 (b)(ii) exhibiting, advertising, assembling, freezing, storing, grading, preparing, processing, packing and transporting the products described in subparagraph (i)` TRUE TRUE FALSE)   -- (b)(ii) not incidental to the selling
#ASSERT NOT (`reg 9(1) agriculture, listed operations` `er1 an operation that the definition does not list` TRUE TRUE TRUE)
-- agriculture: arguments: the operation; on a farm; (b)(i) incidental; (b)(ii) incidental; operations of farming for the benefit of a farmer
#ASSERT `reg 9(1) agriculture` `er1 an operation that the definition does not list` FALSE FALSE FALSE TRUE     -- not listed, but "the operations of farming ... for the benefit of any person who is a farmer"
#ASSERT NOT (`reg 9(1) agriculture` `er1 an operation that the definition does not list` TRUE TRUE TRUE FALSE)   -- not listed and not farming for a farmer
#ASSERT `reg 9(1) agriculture` `er1 (a)(vi) raising bees and producing honey` TRUE FALSE FALSE FALSE             -- listed: agriculture in itself ("includes")
#ASSERT NOT (`reg 9(1) agriculture` `er1 (a)(vi) raising bees and producing honey` FALSE FALSE FALSE FALSE)       -- listed, but not on a farm, and not otherwise farming for a farmer
-- agricultural enterprise: arguments: the business of agriculture; carried on for the benefit of a farmer
#ASSERT `reg 9(1) agricultural enterprise` TRUE TRUE
#ASSERT NOT (`reg 9(1) agricultural enterprise` TRUE FALSE)
#ASSERT NOT (`reg 9(1) agricultural enterprise` FALSE TRUE)
-- horticulture: arguments: the operation; landscape gardening incidental to the (a) operations; landscape gardening incidental to agriculture; services performed at the place where the operations are carried on
#ASSERT `reg 9(1) horticulture` `er1 (a)(i) propagating, producing, raising or harvesting vegetables, flowers, shrubs or ornamental grasses` FALSE FALSE FALSE
#ASSERT `reg 9(1) horticulture` `er1 (a)(ii) propagating, producing, raising or harvesting seeds, seedlings, grafts or cuttings of vegetables, flowers, shrubs or ornamental grasses` FALSE FALSE FALSE
#ASSERT `reg 9(1) horticulture` `er1 (b) landscape gardening` TRUE FALSE FALSE
#ASSERT `reg 9(1) horticulture` `er1 (b) landscape gardening` FALSE TRUE FALSE
#ASSERT NOT (`reg 9(1) horticulture` `er1 (b) landscape gardening` FALSE FALSE TRUE)                 -- landscape gardening that is not incidental to either
#ASSERT `reg 9(1) horticulture` `er1 a service incidental to carrying out those operations` FALSE FALSE TRUE
#ASSERT NOT (`reg 9(1) horticulture` `er1 a service incidental to carrying out those operations` TRUE TRUE FALSE)  -- "if the services are performed at the place where the operations are carried on"
#ASSERT NOT (`reg 9(1) horticulture` `er1 an operation that the definition does not describe` TRUE TRUE TRUE)
-- (2) arguments: would otherwise be insurable; in agriculture; in an agricultural enterprise; in horticulture; days employed in a year; paid in cash for any part
#ASSERT `reg 9(2) employment in agriculture, an agricultural enterprise or horticulture` TRUE TRUE FALSE FALSE 6 TRUE        -- (a) fewer than seven days, even if paid in cash
#ASSERT NOT (`reg 9(2) employment in agriculture, an agricultural enterprise or horticulture` TRUE TRUE FALSE FALSE 7 TRUE)  -- seven days or more and paid in cash for some of it: not excluded
#ASSERT `reg 9(2) employment in agriculture, an agricultural enterprise or horticulture` TRUE TRUE FALSE FALSE 7 FALSE       -- (b) seven days or more and no cash pay
#ASSERT `reg 9(2) employment in agriculture, an agricultural enterprise or horticulture` TRUE FALSE TRUE FALSE 30 FALSE
#ASSERT `reg 9(2) employment in agriculture, an agricultural enterprise or horticulture` TRUE FALSE FALSE TRUE 0 TRUE
#ASSERT NOT (`reg 9(2) employment in agriculture, an agricultural enterprise or horticulture` TRUE FALSE FALSE FALSE 3 FALSE)  -- not farm work
#ASSERT NOT (`reg 9(2) employment in agriculture, an agricultural enterprise or horticulture` FALSE TRUE FALSE FALSE 3 FALSE)  -- would not otherwise be insurable
-- the combination for the core's s 5(2)(h): arguments: reg 7; reg 8(1)(a); reg 8(1)(c); reg 8(2), (3) or (4) has made it insurable at the time; reg 9(2)
#ASSERT `reg 7 to 9 employment excluded from insurable employment` TRUE FALSE FALSE FALSE FALSE
#ASSERT `reg 7 to 9 employment excluded from insurable employment` FALSE TRUE FALSE FALSE FALSE
#ASSERT `reg 7 to 9 employment excluded from insurable employment` FALSE FALSE TRUE FALSE FALSE
#ASSERT `reg 7 to 9 employment excluded from insurable employment` FALSE FALSE FALSE FALSE TRUE
#ASSERT NOT (`reg 7 to 9 employment excluded from insurable employment` FALSE TRUE FALSE TRUE FALSE)   -- reg 8(2) to (4) have made it insurable by then
#ASSERT NOT (`reg 7 to 9 employment excluded from insurable employment` FALSE FALSE TRUE TRUE FALSE)
#ASSERT `reg 7 to 9 employment excluded from insurable employment` TRUE FALSE FALSE TRUE FALSE         -- reg 8(2) to (4) do not touch reg 7
#ASSERT NOT (`reg 7 to 9 employment excluded from insurable employment` FALSE FALSE FALSE FALSE FALSE)
