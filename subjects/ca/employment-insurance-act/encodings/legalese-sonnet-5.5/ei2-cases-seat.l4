-- Q38. she also lost a job for misconduct, so leaving is not her only reason
#ASSERT NOT `Does the union exception protect me` FALSE TRUE TRUE
-- Q38. staying would not have cost any union right
#ASSERT NOT `Does the union exception protect me` TRUE FALSE FALSE

§ `A work stoppage, prison and being abroad (ss 36 and 37)`

-- Q39. Gus lost his job because of a stoppage caused by a labour dispute between employer and employees about the terms of employment at his workplace; it goes on; he is not elsewhere engaged and has proved nothing (s 36(1))
#ASSERT `Am I not entitled to benefits because of a work stoppage` TRUE TRUE FALSE FALSE FALSE TRUE TRUE TRUE FALSE FALSE FALSE `a reason other than those mentioned in subsection 12(3)` FALSE FALSE FALSE FALSE FALSE FALSE
-- Q39. the stoppage has ended
#ASSERT NOT `Am I not entitled to benefits because of a work stoppage` TRUE TRUE FALSE FALSE FALSE TRUE TRUE TRUE TRUE FALSE FALSE `a reason other than those mentioned in subsection 12(3)` FALSE FALSE FALSE FALSE FALSE FALSE
-- Q39. he proves he is not participating in, financing or interested in the dispute (s 36(4))
#ASSERT NOT `Am I not entitled to benefits because of a work stoppage` TRUE TRUE FALSE FALSE FALSE TRUE TRUE TRUE FALSE FALSE FALSE `a reason other than those mentioned in subsection 12(3)` FALSE FALSE FALSE TRUE TRUE TRUE
-- Q39. the dispute is between neither employers and employees nor employees
#ASSERT NOT `Am I not entitled to benefits because of a work stoppage` TRUE FALSE FALSE FALSE FALSE TRUE TRUE TRUE FALSE FALSE FALSE `a reason other than those mentioned in subsection 12(3)` FALSE FALSE FALSE FALSE FALSE FALSE
-- Q39. his disentitlement is suspended: otherwise entitled to special benefits, absence anticipated, arrangements begun (s 36(3))
#ASSERT NOT `Am I not entitled to benefits because of a work stoppage` TRUE TRUE FALSE FALSE FALSE TRUE TRUE TRUE FALSE FALSE TRUE `pregnancy` FALSE TRUE TRUE FALSE FALSE FALSE
-- Q39. the stoppage is not attributable to the dispute
#ASSERT NOT `Am I not entitled to benefits because of a work stoppage` TRUE TRUE FALSE FALSE FALSE TRUE FALSE TRUE FALSE FALSE FALSE `a reason other than those mentioned in subsection 12(3)` FALSE FALSE FALSE FALSE FALSE FALSE
-- Q40. separate departments of a business run as separate businesses count as separate workshops (s 36(5))
#ASSERT `Does section 36(5) treat my department as a separate factory or workshop` TRUE
-- Q40. not so
#ASSERT NOT `Does section 36(5) treat my department as a separate factory or workshop` FALSE
