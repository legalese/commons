#ASSERT `s 96(8.7) the refund of part of the employer's premium for 2011` 0 TRUE 2 TRUE (YMD 2012 3 1) EQUALS `ei3 no refund is payable under the provision`
#ASSERT `s 96(8.7) the refund of part of the employer's premium for 2011` 0 TRUE 2.5 TRUE (YMD 2012 3 1) EQUALS `ei3 a refund is payable` 2.5
#ASSERT `s 96(8.8) P1 for subsection (8.7)` 8_000 TRUE EQUALS 8_000
#ASSERT `s 96(8.8) P1 for subsection (8.7)` 8_000 FALSE EQUALS 0
-- (8.91) 2012: P1 (2011) 9,000, P2 (2012) 9,800: 800.
#ASSERT `s 96(8.91) the refund of part of the employer's premium for 2012` 9_000 TRUE 9_800 TRUE (YMD 2015 12 31) EQUALS `ei3 a refund is payable` 800
#ASSERT `s 96(8.91) the refund of part of the employer's premium for 2012` 10_001 TRUE 11_000 TRUE (YMD 2013 1 1) EQUALS `ei3 no refund is payable under the provision`
#ASSERT `s 96(8.92) P1 for subsection (8.91)` 9_000 FALSE EQUALS 0
-- (8.94) 2013: $15,000 or less in 2012. P1 14,000, P2 15,500: 1,500 capped at 1,000.
#ASSERT `s 96(8.94) the refund of part of the employer's premium for 2013` 14_000 TRUE 15_500 TRUE (YMD 2016 12 31) EQUALS `ei3 a refund is payable` 1_000
#ASSERT `s 96(8.94) the refund of part of the employer's premium for 2013` 15_000 TRUE 15_300 TRUE (YMD 2014 1 1) EQUALS `ei3 a refund is payable` 300
#ASSERT `s 96(8.94) the refund of part of the employer's premium for 2013` 15_001 TRUE 16_000 TRUE (YMD 2014 1 1) EQUALS `ei3 no refund is payable under the provision`
#ASSERT `s 96(8.94) the refund of part of the employer's premium for 2013` 14_000 TRUE 15_500 TRUE (YMD 2017 1 1) EQUALS `ei3 no refund is payable under the provision`
#ASSERT `s 96(8.95) P1 for subsection (8.94)` 14_000 FALSE EQUALS 0
-- (8.97) 2015: E x 0.28% x 1.4 = E x 0.00392. E 500,000 gives 1,960; no cap is stated. Arguments: 2015 premium; E; written; day.
#ASSERT `s 96(8.97) the refund of part of the employer's premium for 2015` 12_000 500_000 TRUE (YMD 2018 12 31) EQUALS `ei3 a refund is payable` 1_960
#ASSERT `s 96(8.97) the refund of part of the employer's premium for 2015` 15_000 500_000 TRUE (YMD 2016 1 1) EQUALS `ei3 a refund is payable` 1_960
#ASSERT `s 96(8.97) the refund of part of the employer's premium for 2015` 15_001 500_000 TRUE (YMD 2016 1 1) EQUALS `ei3 no refund is payable under the provision`
#ASSERT `s 96(8.97) the refund of part of the employer's premium for 2015` 12_000 500_000 TRUE (YMD 2019 1 1) EQUALS `ei3 no refund is payable under the provision`
-- E of 500 gives 1.96, not more than $2; E of 520 gives 2.0384.
