IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `ei5-parental`

-- Tests of ei5-parental (Act s 152.05). Expected values are written by hand from the text beside each assertion.
-- 2026-06-07 is a Sunday; 2026-10-24 is a Saturday.

§ `152.05(1) to (1.3) claim and election`

#ASSERT `s 152.05(1) benefits are payable for the care of a child` TRUE FALSE
#ASSERT `s 152.05(1) benefits are payable for the care of a child` FALSE TRUE
#ASSERT NOT (`s 152.05(1) benefits are payable for the care of a child` FALSE FALSE)

-- (1.1) a claim under this section must elect; a claim not under this section need not
#ASSERT `s 152.05(1.1) the claim meets the requirement to elect` TRUE TRUE
#ASSERT NOT (`s 152.05(1.1) the claim meets the requirement to elect` TRUE FALSE)
#ASSERT `s 152.05(1.1) the claim meets the requirement to elect` FALSE FALSE

-- (1.2) irrevocable once benefits are paid under this section or section 23
#ASSERT `s 152.05(1.2) the election is irrevocable` TRUE FALSE
#ASSERT `s 152.05(1.2) the election is irrevocable` FALSE TRUE
#ASSERT NOT (`s 152.05(1.2) the election is irrevocable` FALSE FALSE)

-- (1.3) the election of the first to make a claim binds both
#ASSERT `s 152.05(1.3) the election that binds the person` `the 35-week maximum` NOTHING TRUE EQUALS `the 35-week maximum`
#ASSERT `s 152.05(1.3) the election that binds the person` `the 35-week maximum` NOTHING FALSE EQUALS `the 35-week maximum`
-- the other person elected 61 weeks: if I was first my election binds both ...
#ASSERT `s 152.05(1.3) the election that binds the person` `the 35-week maximum` (JUST `the 61-week maximum`) TRUE EQUALS `the 35-week maximum`
-- ... if they were first, theirs binds me
#ASSERT `s 152.05(1.3) the election that binds the person` `the 35-week maximum` (JUST `the 61-week maximum`) FALSE EQUALS `the 61-week maximum`
#ASSERT `s 152.05(1.3) the election that binds the person` `the 61-week maximum` (JUST `the 35-week maximum`) FALSE EQUALS `the 35-week maximum`

§ `152.05(2) to (4) the period`

-- Born on Wednesday 10 June 2026: the week begins Sunday 7 June 2026; 52 weeks later is Sunday 6 June 2027,
-- and the period ends on the Saturday of that week, 12 June 2027.
#ASSERT `s 152.05(2) the period for which parental benefits are payable` (YMD 2026 6 10) EQUALS `Period of days` OF (YMD 2026 6 7), (YMD 2027 6 12)
-- Saturday 13 June is still that week; Sunday 14 June begins the next
#ASSERT `s 152.05(2) the period for which parental benefits are payable` (YMD 2026 6 13) EQUALS `Period of days` OF (YMD 2026 6 7), (YMD 2027 6 12)
#ASSERT `s 152.05(2) the period for which parental benefits are payable` (YMD 2026 6 14) EQUALS `Period of days` OF (YMD 2026 6 14), (YMD 2027 6 19)
#ASSERT `s 152.05(2) the period for which parental benefits are payable` (YMD 2026 6 7) EQUALS `Period of days` OF (YMD 2026 6 7), (YMD 2027 6 12)

`the parental period` MEANS `Period of days` OF (YMD 2026 6 7), (YMD 2027 6 12)
-- no hospitalization: unchanged
#ASSERT `s 152.05(3) and (4) the period extended because the child or children are hospitalized` `the parental period` 0 EQUALS `the parental period`
-- 4 weeks: 12 June 2027 + 28 days = 10 July 2027
#ASSERT `s 152.05(3) and (4) the period extended because the child or children are hospitalized` `the parental period` 4 EQUALS `Period of days` OF (YMD 2026 6 7), (YMD 2027 7 10)
-- 104 weeks from 7 June 2026 end on Saturday 3 June 2028 (the leap day of 2028 falls in between);
-- 12 June 2027 + 357 days is 3 June 2028: 51 weeks reaches the limit exactly
#ASSERT `s 152.05(3) and (4) the period extended because the child or children are hospitalized` `the parental period` 50 EQUALS `Period of days` OF (YMD 2026 6 7), (YMD 2028 5 27)
#ASSERT `s 152.05(3) and (4) the period extended because the child or children are hospitalized` `the parental period` 51 EQUALS `Period of days` OF (YMD 2026 6 7), (YMD 2028 6 3)
#ASSERT `s 152.05(3) and (4) the period extended because the child or children are hospitalized` `the parental period` 52 EQUALS `Period of days` OF (YMD 2026 6 7), (YMD 2028 6 3)
#ASSERT `s 152.05(3) and (4) the period extended because the child or children are hospitalized` `the parental period` 80 EQUALS `Period of days` OF (YMD 2026 6 7), (YMD 2028 6 3)

§ `152.05(5) to (7) other extensions and their limits`

-- (5) arguments: number of reasons paid, maximum total weeks for those reasons, weeks paid for reason (b), applicable maximum
-- parental 61 weeks plus sickness 26: two reasons, total 87 (more than 50), 10 weeks paid for (b), maximum 61
#ASSERT `s 152.05(5) the period is extended so that benefits may be paid up to the applicable maximum` 2 87 10 61
-- only one reason
#ASSERT NOT (`s 152.05(5) the period is extended so that benefits may be paid up to the applicable maximum` 1 87 10 61)
-- the total is 50: not "greater than 50"
#ASSERT NOT (`s 152.05(5) the period is extended so that benefits may be paid up to the applicable maximum` 2 50 10 35)
#ASSERT `s 152.05(5) the period is extended so that benefits may be paid up to the applicable maximum` 2 51 10 35
-- no weeks paid for (b)
#ASSERT NOT (`s 152.05(5) the period is extended so that benefits may be paid up to the applicable maximum` 2 87 0 61)
-- 60 weeks paid of 61: fewer than the maximum
#ASSERT `s 152.05(5) the period is extended so that benefits may be paid up to the applicable maximum` 2 87 60 61
-- 61 weeks paid of 61: not fewer
#ASSERT NOT (`s 152.05(5) the period is extended so that benefits may be paid up to the applicable maximum` 2 87 61 61)
-- the weeks that may then be paid: 61 - 10 = 51; none when no extension
#ASSERT `s 152.05(5) the number of weeks of benefits that may be paid, up to the applicable maximum, after the extension` TRUE 10 61 EQUALS 51
#ASSERT `s 152.05(5) the number of weeks of benefits that may be paid, up to the applicable maximum, after the extension` FALSE 10 61 EQUALS 0

-- (5.1) arguments: benefits paid for another reason, benefits paid for (b), the election
#ASSERT `s 152.05(5.1) the number of weeks by which the period is extended` FALSE TRUE `the 61-week maximum` EQUALS 26
-- another reason paid: no extension
#ASSERT `s 152.05(5.1) the number of weeks by which the period is extended` TRUE TRUE `the 61-week maximum` EQUALS 0
-- nothing paid for (b)
#ASSERT `s 152.05(5.1) the number of weeks by which the period is extended` FALSE FALSE `the 61-week maximum` EQUALS 0
-- the 35-week maximum is established under (b)(i), not (b)(ii)
#ASSERT `s 152.05(5.1) the number of weeks by which the period is extended` FALSE TRUE `the 35-week maximum` EQUALS 0

-- (6) and (7) limits, in weeks
#ASSERT `s 152.05(6) the length of the period after an extension under subsection (5)` 70 80 EQUALS 70
#ASSERT `s 152.05(6) the length of the period after an extension under subsection (5)` 90 80 EQUALS 80
#ASSERT `s 152.05(6) the length of the period after an extension under subsection (5)` 80 80 EQUALS 80
#ASSERT `s 152.05(7) the length of the period after an extension under subsections 152.11(11) to (14.1)` 100 EQUALS 100
#ASSERT `s 152.05(7) the length of the period after an extension under subsections 152.11(11) to (14.1)` 104 EQUALS 104
#ASSERT `s 152.05(7) the length of the period after an extension under subsections 152.11(11) to (14.1)` 105 EQUALS 104

§ `152.05(12) to (15) division and waiting period`

#ASSERT `ss 152.05(12) and (13) the maximum number of weeks of benefits that may be divided between two claimants` `the 35-week maximum` EQUALS 40
#ASSERT `ss 152.05(12) and (13) the maximum number of weeks of benefits that may be divided between two claimants` `the 61-week maximum` EQUALS 69
#ASSERT `s 152.05(13.01) the maximum number of weeks for which benefits may be paid to a claimant` `the 35-week maximum` EQUALS 35
#ASSERT `s 152.05(13.01) the maximum number of weeks for which benefits may be paid to a claimant` `the 61-week maximum` EQUALS 61

-- 35-week election: 20 + 20 = 40, each under 35
#ASSERT `s 152.05(12), (13) and (13.01) a division of the weeks of benefits is within the limits` `the 35-week maximum` 20 20
-- 35 + 5 = 40, a share at its 35-week limit
#ASSERT `s 152.05(12), (13) and (13.01) a division of the weeks of benefits is within the limits` `the 35-week maximum` 35 5
-- 30 + 11 = 41 is over 40
#ASSERT NOT (`s 152.05(12), (13) and (13.01) a division of the weeks of benefits is within the limits` `the 35-week maximum` 30 11)
-- 36 + 4 = 40, but one share is over 35
#ASSERT NOT (`s 152.05(12), (13) and (13.01) a division of the weeks of benefits is within the limits` `the 35-week maximum` 36 4)
-- 61-week election: 35 + 34 = 69 is within; 35 + 35 = 70 is over; 62 + 1 has a share over 61; 61 + 8 = 69 is within
#ASSERT `s 152.05(12), (13) and (13.01) a division of the weeks of benefits is within the limits` `the 61-week maximum` 35 34
#ASSERT NOT (`s 152.05(12), (13) and (13.01) a division of the weeks of benefits is within the limits` `the 61-week maximum` 35 35)
#ASSERT NOT (`s 152.05(12), (13) and (13.01) a division of the weeks of benefits is within the limits` `the 61-week maximum` 62 1)
#ASSERT `s 152.05(12), (13) and (13.01) a division of the weeks of benefits is within the limits` `the 61-week maximum` 61 8

-- agreed division, or the prescribed rules when they cannot agree
#ASSERT `s 152.05(12) the weeks of benefits to be paid to a claimant after the division` TRUE 30 20 EQUALS 30
#ASSERT `s 152.05(12) the weeks of benefits to be paid to a claimant after the division` FALSE 30 20 EQUALS 20

-- (14) each of the four cases alone defers the waiting period
#ASSERT `s 152.05(14) the waiting period may be deferred` TRUE FALSE FALSE FALSE
#ASSERT `s 152.05(14) the waiting period may be deferred` FALSE TRUE FALSE FALSE
#ASSERT `s 152.05(14) the waiting period may be deferred` FALSE FALSE TRUE FALSE
#ASSERT `s 152.05(14) the waiting period may be deferred` FALSE FALSE FALSE TRUE
#ASSERT NOT (`s 152.05(14) the waiting period may be deferred` FALSE FALSE FALSE FALSE)

-- (15)(a) the self-employed person is not the one who served or elected
#ASSERT `s 152.05(15)(a) the self-employed person is not required to serve a waiting period` TRUE TRUE FALSE
#ASSERT NOT (`s 152.05(15)(a) the self-employed person is not required to serve a waiting period` TRUE TRUE TRUE)
#ASSERT NOT (`s 152.05(15)(a) the self-employed person is not required to serve a waiting period` FALSE TRUE FALSE)
#ASSERT NOT (`s 152.05(15)(a) the self-employed person is not required to serve a waiting period` TRUE FALSE FALSE)
-- (15)(b) the person claiming under section 22 or 23 is not the one who served or elected
#ASSERT `s 152.05(15)(b) the person making the claim under section 22 or 23 may have their waiting period deferred in accordance with section 23` TRUE TRUE FALSE
#ASSERT NOT (`s 152.05(15)(b) the person making the claim under section 22 or 23 may have their waiting period deferred in accordance with section 23` TRUE TRUE TRUE)
#ASSERT NOT (`s 152.05(15)(b) the person making the claim under section 22 or 23 may have their waiting period deferred in accordance with section 23` FALSE TRUE FALSE)
