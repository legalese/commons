IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `er3-nouns`
IMPORT `er3-recovery`

-- Tests of er3-recovery (regulations 56, 56.1 and 57). Every expected value is written by hand from the text of
-- regs 56, 56.1 and 57 (SOR-96-332.txt lines 944-991) before the module was run. The day reg 56.1 came into
-- force is not in the text; the tests use 2020-01-01 as an invented stand-in and claim nothing about it.

§ `reg 56(1) -- write-off`

-- (a): $100 or less in all, no benefit period running, no repayment plan.
#ASSERT `reg 56(1)(a) the amounts owing do not exceed $100 and the debtor has no benefit period running and no repayment plan` 100 FALSE FALSE EQUALS TRUE
#ASSERT `reg 56(1)(a) the amounts owing do not exceed $100 and the debtor has no benefit period running and no repayment plan` 101 FALSE FALSE EQUALS FALSE
#ASSERT `reg 56(1)(a) the amounts owing do not exceed $100 and the debtor has no benefit period running and no repayment plan` 0 FALSE FALSE EQUALS TRUE
#ASSERT `reg 56(1)(a) the amounts owing do not exceed $100 and the debtor has no benefit period running and no repayment plan` 100 TRUE FALSE EQUALS FALSE
#ASSERT `reg 56(1)(a) the amounts owing do not exceed $100 and the debtor has no benefit period running and no repayment plan` 100 FALSE TRUE EQUALS FALSE
-- (d): an undischarged bankrupt, final dividend paid, trustee discharged.
#ASSERT `reg 56(1)(d) the debtor is an undischarged bankrupt whose final dividend has been paid and whose trustee has been discharged` TRUE TRUE TRUE EQUALS TRUE
#ASSERT `reg 56(1)(d) the debtor is an undischarged bankrupt whose final dividend has been paid and whose trustee has been discharged` FALSE TRUE TRUE EQUALS FALSE
#ASSERT `reg 56(1)(d) the debtor is an undischarged bankrupt whose final dividend has been paid and whose trustee has been discharged` TRUE FALSE TRUE EQUALS FALSE
#ASSERT `reg 56(1)(d) the debtor is an undischarged bankrupt whose final dividend has been paid and whose trustee has been discharged` TRUE TRUE FALSE EQUALS FALSE
-- (e): a retrospective decision, not the debtor's error or false declaration (known to be false or not).
#ASSERT `reg 56(1)(e) the overpayment arises from a retrospective decision and not from the debtor's error or false declaration` FALSE FALSE TRUE FALSE EQUALS TRUE
#ASSERT `reg 56(1)(e) the overpayment arises from a retrospective decision and not from the debtor's error or false declaration` FALSE FALSE FALSE TRUE EQUALS TRUE
#ASSERT `reg 56(1)(e) the overpayment arises from a retrospective decision and not from the debtor's error or false declaration` TRUE FALSE TRUE FALSE EQUALS FALSE
#ASSERT `reg 56(1)(e) the overpayment arises from a retrospective decision and not from the debtor's error or false declaration` FALSE TRUE TRUE FALSE EQUALS FALSE
#ASSERT `reg 56(1)(e) the overpayment arises from a retrospective decision and not from the debtor's error or false declaration` FALSE FALSE FALSE FALSE EQUALS FALSE
-- (f): the Commission considers it uncollectable, a hardship, or not worth collecting.
#ASSERT `reg 56(1)(f) the Commission considers it uncollectable, a hardship or not worth collecting` TRUE FALSE FALSE EQUALS TRUE
#ASSERT `reg 56(1)(f) the Commission considers it uncollectable, a hardship or not worth collecting` FALSE TRUE FALSE EQUALS TRUE
#ASSERT `reg 56(1)(f) the Commission considers it uncollectable, a hardship or not worth collecting` FALSE FALSE TRUE EQUALS TRUE
#ASSERT `reg 56(1)(f) the Commission considers it uncollectable, a hardship or not worth collecting` FALSE FALSE FALSE EQUALS FALSE
-- (1): a penalty or amount of the kinds named, and any one of (a) to (f).
#ASSERT `reg 56(1) the conditions on which the Commission may write off a penalty, an amount payable or the interest are met` TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS TRUE
#ASSERT `reg 56(1) the conditions on which the Commission may write off a penalty, an amount payable or the interest are met` TRUE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS TRUE
#ASSERT `reg 56(1) the conditions on which the Commission may write off a penalty, an amount payable or the interest are met` TRUE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS TRUE
#ASSERT `reg 56(1) the conditions on which the Commission may write off a penalty, an amount payable or the interest are met` TRUE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS TRUE
#ASSERT `reg 56(1) the conditions on which the Commission may write off a penalty, an amount payable or the interest are met` TRUE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS TRUE
#ASSERT `reg 56(1) the conditions on which the Commission may write off a penalty, an amount payable or the interest are met` TRUE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS TRUE
#ASSERT `reg 56(1) the conditions on which the Commission may write off a penalty, an amount payable or the interest are met` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS FALSE
#ASSERT `reg 56(1) the conditions on which the Commission may write off a penalty, an amount payable or the interest are met` FALSE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS FALSE

§ `reg 56(2) -- benefits received more than 12 months before notification`

-- received 2024-03-15; 12 months later is 2025-03-15, so notification after that day is "more than 12 months".
#ASSERT `reg 56(2) the benefit was received more than 12 months before the Commission notified the debtor` (YearMonthDay 2024 3 15) (YearMonthDay 2025 3 16) EQUALS TRUE
#ASSERT `reg 56(2) the benefit was received more than 12 months before the Commission notified the debtor` (YearMonthDay 2024 3 15) (YearMonthDay 2025 3 15) EQUALS FALSE
#ASSERT `reg 56(2) the benefit was received more than 12 months before the Commission notified the debtor` (YearMonthDay 2024 3 15) (YearMonthDay 2025 3 14) EQUALS FALSE
-- received 29 February 2024: twelve months later is taken as 28 February 2025.
#ASSERT `reg 56(2) the benefit was received more than 12 months before the Commission notified the debtor` (YearMonthDay 2024 2 29) (YearMonthDay 2025 3 1) EQUALS TRUE
#ASSERT `reg 56(2) the benefit was received more than 12 months before the Commission notified the debtor` (YearMonthDay 2024 2 29) (YearMonthDay 2025 2 28) EQUALS FALSE
#ASSERT `reg 56(2)(a) the overpayment does not arise from the debtor's error or false declaration` FALSE FALSE EQUALS TRUE
#ASSERT `reg 56(2)(a) the overpayment does not arise from the debtor's error or false declaration` TRUE FALSE EQUALS FALSE
#ASSERT `reg 56(2)(a) the overpayment does not arise from the debtor's error or false declaration` FALSE TRUE EQUALS FALSE
#ASSERT `reg 56(2)(b) the overpayment arises as a result of one of the five causes` TRUE FALSE FALSE FALSE FALSE EQUALS TRUE
#ASSERT `reg 56(2)(b) the overpayment arises as a result of one of the five causes` FALSE TRUE FALSE FALSE FALSE EQUALS TRUE
#ASSERT `reg 56(2)(b) the overpayment arises as a result of one of the five causes` FALSE FALSE TRUE FALSE FALSE EQUALS TRUE
#ASSERT `reg 56(2)(b) the overpayment arises as a result of one of the five causes` FALSE FALSE FALSE TRUE FALSE EQUALS TRUE
#ASSERT `reg 56(2)(b) the overpayment arises as a result of one of the five causes` FALSE FALSE FALSE FALSE TRUE EQUALS TRUE
#ASSERT `reg 56(2)(b) the overpayment arises as a result of one of the five causes` FALSE FALSE FALSE FALSE FALSE EQUALS FALSE
-- the portion: notified 2025-06-01; only the 1000 received 2024-03-15 is more than 12 months old; 50 of interest on it.
`test overpaid benefits` MEANS LIST (`er3 Overpaid benefit` OF (YearMonthDay 2024 3 15), 1000), (`er3 Overpaid benefit` OF (YearMonthDay 2025 1 10), 500), (`er3 Overpaid benefit` OF (YearMonthDay 2024 12 1), 300)
#ASSERT `reg 56(2) the portion of the amount owing that may be written off` `test overpaid benefits` (YearMonthDay 2025 6 1) 50 TRUE TRUE EQUALS 1050
#ASSERT `reg 56(2) the portion of the amount owing that may be written off` `test overpaid benefits` (YearMonthDay 2025 6 1) 50 FALSE TRUE EQUALS 0
#ASSERT `reg 56(2) the portion of the amount owing that may be written off` `test overpaid benefits` (YearMonthDay 2025 6 1) 50 TRUE FALSE EQUALS 0
-- notified 2026-02-01: the 500 of 2025-01-10 (twelve months later 2026-01-10) is now old too, the 300 of 2024-12-01 as well.
#ASSERT `reg 56(2) the portion of the amount owing that may be written off` `test overpaid benefits` (YearMonthDay 2026 2 1) 0 TRUE TRUE EQUALS 1800
#ASSERT `reg 56(2) the portion of the amount owing that may be written off` EMPTY (YearMonthDay 2026 2 1) 0 TRUE TRUE EQUALS 0

§ `reg 56.1 -- interest`

-- (1): the average bank rate is the simple mean of the weekly rates (fractions); none, no mean.
#ASSERT `reg 56.1(1) the average bank rate` (LIST 0.04, 0.05) EQUALS JUST 0.045
#ASSERT `reg 56.1(1) the average bank rate` (LIST 0.0425) EQUALS JUST 0.0425
#ASSERT `reg 56.1(1) the average bank rate` EMPTY EQUALS NOTHING
-- (3): the rate is the average bank rate plus three per cent: 4.5% + 3% = 7.5%.
#ASSERT `reg 56.1(3) the annual rate of interest` (JUST 0.045) EQUALS JUST 0.075
#ASSERT `reg 56.1(3) the annual rate of interest` NOTHING EQUALS NOTHING
-- a month on a balance of 36500 at 10% with 30 days of 365: 36500 x 0.1 x 30 / 365 = 300; compounded: 36800.
#ASSERT `reg 56.1(3) the interest accruing in a month` 36500 0.1 30 365 EQUALS JUST 300
#ASSERT `reg 56.1(3) the interest accruing in a month` 36500 0.1 30 0 EQUALS NOTHING
#ASSERT `reg 56.1(3) the balance at the end of the month, after compounding` 36500 (JUST 300) EQUALS JUST 36800
#ASSERT `reg 56.1(3) the balance at the end of the month, after compounding` 36500 NOTHING EQUALS NOTHING
-- (1) "debt arising from an act or omission": an amount of s 43 etc. with a penalty, a warning or a prosecution; or an amount under s 38, 39 or 65.1; or a court judgment.
#ASSERT `reg 56.1(1) debt arising from an act or omission, before subsection (2)` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS TRUE
#ASSERT `reg 56.1(1) debt arising from an act or omission, before subsection (2)` TRUE FALSE TRUE FALSE FALSE FALSE EQUALS TRUE
#ASSERT `reg 56.1(1) debt arising from an act or omission, before subsection (2)` TRUE FALSE FALSE TRUE FALSE FALSE EQUALS TRUE
#ASSERT `reg 56.1(1) debt arising from an act or omission, before subsection (2)` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS FALSE
#ASSERT `reg 56.1(1) debt arising from an act or omission, before subsection (2)` FALSE TRUE TRUE TRUE FALSE FALSE EQUALS FALSE
#ASSERT `reg 56.1(1) debt arising from an act or omission, before subsection (2)` FALSE FALSE FALSE FALSE TRUE FALSE EQUALS TRUE
#ASSERT `reg 56.1(1) debt arising from an act or omission, before subsection (2)` FALSE FALSE FALSE FALSE FALSE TRUE EQUALS TRUE
-- (2): a rescinded penalty or warning, or an acquittal, takes the debt out.
#ASSERT `reg 56.1(2) the debt is not a debt arising from an act or omission` TRUE FALSE EQUALS TRUE
#ASSERT `reg 56.1(2) the debt is not a debt arising from an act or omission` FALSE TRUE EQUALS TRUE
#ASSERT `reg 56.1(2) the debt is not a debt arising from an act or omission` FALSE FALSE EQUALS FALSE
-- (3): owing under s 47 or 65.2 on or after the (stand-in) day the section came into force, 2020-01-01.
#ASSERT `reg 56.1(3) the debt carries interest` TRUE TRUE (YearMonthDay 2026 3 1) (YearMonthDay 2020 1 1) EQUALS TRUE
#ASSERT `reg 56.1(3) the debt carries interest` TRUE TRUE (YearMonthDay 2020 1 1) (YearMonthDay 2020 1 1) EQUALS TRUE
#ASSERT `reg 56.1(3) the debt carries interest` TRUE TRUE (YearMonthDay 2019 12 31) (YearMonthDay 2020 1 1) EQUALS FALSE
#ASSERT `reg 56.1(3) the debt carries interest` TRUE FALSE (YearMonthDay 2026 3 1) (YearMonthDay 2020 1 1) EQUALS FALSE
#ASSERT `reg 56.1(3) the debt carries interest` FALSE TRUE (YearMonthDay 2026 3 1) (YearMonthDay 2020 1 1) EQUALS FALSE
-- (4): the accrual begins on the day of notification.
#ASSERT `reg 56.1(4) the day on which interest begins to accrue` (YearMonthDay 2026 3 1) EQUALS YearMonthDay 2026 3 1
-- (5), (6): an appeal or review pending suspends interest, but a reconsideration by the Commission does not.
#ASSERT `reg 56.1(5) and (6) interest does not accrue because an appeal or review is pending` TRUE FALSE EQUALS TRUE
#ASSERT `reg 56.1(5) and (6) interest does not accrue because an appeal or review is pending` TRUE TRUE EQUALS FALSE
#ASSERT `reg 56.1(5) and (6) interest does not accrue because an appeal or review is pending` FALSE FALSE EQUALS FALSE
-- (7): the earliest of the days on which repayment is received, the debtor dies, the amount or the interest is written off.
#ASSERT `reg 56.1(7) the day on which the accrual of interest ceases` (JUST (YearMonthDay 2026 5 10)) NOTHING NOTHING NOTHING EQUALS JUST (YearMonthDay 2026 5 10)
#ASSERT `reg 56.1(7) the day on which the accrual of interest ceases` (JUST (YearMonthDay 2026 5 10)) (JUST (YearMonthDay 2026 4 1)) NOTHING NOTHING EQUALS JUST (YearMonthDay 2026 4 1)
#ASSERT `reg 56.1(7) the day on which the accrual of interest ceases` (JUST (YearMonthDay 2026 5 10)) (JUST (YearMonthDay 2026 4 1)) (JUST (YearMonthDay 2026 3 20)) (JUST (YearMonthDay 2026 3 15)) EQUALS JUST (YearMonthDay 2026 3 15)
#ASSERT `reg 56.1(7) the day on which the accrual of interest ceases` NOTHING NOTHING NOTHING NOTHING EQUALS NOTHING
-- the day of the event is the first day without interest (fork F19); the day of notification has interest.
#ASSERT `reg 56.1 interest accrues on the day` TRUE (YearMonthDay 2026 3 10) (YearMonthDay 2026 3 1) FALSE NOTHING EQUALS TRUE
#ASSERT `reg 56.1 interest accrues on the day` TRUE (YearMonthDay 2026 3 1) (YearMonthDay 2026 3 1) FALSE NOTHING EQUALS TRUE
#ASSERT `reg 56.1 interest accrues on the day` TRUE (YearMonthDay 2026 2 28) (YearMonthDay 2026 3 1) FALSE NOTHING EQUALS FALSE
#ASSERT `reg 56.1 interest accrues on the day` TRUE (YearMonthDay 2026 3 10) (YearMonthDay 2026 3 1) TRUE NOTHING EQUALS FALSE
#ASSERT `reg 56.1 interest accrues on the day` TRUE (YearMonthDay 2026 3 9) (YearMonthDay 2026 3 1) FALSE (JUST (YearMonthDay 2026 3 10)) EQUALS TRUE
#ASSERT `reg 56.1 interest accrues on the day` TRUE (YearMonthDay 2026 3 10) (YearMonthDay 2026 3 1) FALSE (JUST (YearMonthDay 2026 3 10)) EQUALS FALSE
#ASSERT `reg 56.1 interest accrues on the day` FALSE (YearMonthDay 2026 3 10) (YearMonthDay 2026 3 1) FALSE NOTHING EQUALS FALSE
-- (8): costs greater than the interest (equal does not exceed); a settled dispute; undue hardship.
#ASSERT `reg 56.1(8) the conditions on which the Commission may waive or reduce the interest are met` 120 100 FALSE FALSE EQUALS TRUE
#ASSERT `reg 56.1(8) the conditions on which the Commission may waive or reduce the interest are met` 100 100 FALSE FALSE EQUALS FALSE
#ASSERT `reg 56.1(8) the conditions on which the Commission may waive or reduce the interest are met` 50 100 TRUE FALSE EQUALS TRUE
#ASSERT `reg 56.1(8) the conditions on which the Commission may waive or reduce the interest are met` 50 100 FALSE TRUE EQUALS TRUE
#ASSERT `reg 56.1(8) the conditions on which the Commission may waive or reduce the interest are met` 50 100 FALSE FALSE EQUALS FALSE

§ `reg 57 -- deductions for payments to governments and authorities`

#ASSERT `reg 57(4) the payer is a prescribed authority` `er3 payer: the council of an Indian band` EQUALS TRUE
#ASSERT `reg 57(4) the payer is a prescribed authority` `er3 payer: a provincial government` EQUALS FALSE
#ASSERT `reg 57(2) the payer is one of those listed` `er3 payer: the Government of Canada or any of its agencies` EQUALS TRUE
#ASSERT `reg 57(2) the payer is one of those listed` `er3 payer: a provincial government` EQUALS TRUE
#ASSERT `reg 57(2) the payer is one of those listed` `er3 payer: a municipal government` EQUALS TRUE
#ASSERT `reg 57(2) the payer is one of those listed` `er3 payer: the council of an Indian band` EQUALS TRUE
#ASSERT `reg 57(2) the payer is one of those listed` `er3 payer: someone else` EQUALS FALSE
-- (3): an arrangement is in force until the Commission terminates it.
#ASSERT `reg 57(3) the arrangement is in force` TRUE FALSE EQUALS TRUE
#ASSERT `reg 57(3) the arrangement is in force` TRUE TRUE EQUALS FALSE
#ASSERT `reg 57(3) the arrangement is in force` FALSE FALSE EQUALS FALSE
-- (2): a deduction only with an arrangement AND the person's signed consent; a payment of another kind is not touched.
#ASSERT `reg 57(2) a deduction may be made from the benefits in respect of the payment` TRUE `er3 payer: the Government of Canada or any of its agencies` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 57(2) a deduction may be made from the benefits in respect of the payment` TRUE `er3 payer: the Government of Canada or any of its agencies` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 57(2) a deduction may be made from the benefits in respect of the payment` TRUE `er3 payer: a municipal government` FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 57(2) a deduction may be made from the benefits in respect of the payment` TRUE `er3 payer: the council of an Indian band` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 57(2) a deduction may be made from the benefits in respect of the payment` TRUE `er3 payer: someone else` TRUE TRUE EQUALS NOTHING
#ASSERT `reg 57(2) a deduction may be made from the benefits in respect of the payment` FALSE `er3 payer: a provincial government` TRUE TRUE EQUALS NOTHING
