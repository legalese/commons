IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `er3-nouns`
IMPORT `er3-work-sharing`

-- Tests of er3-work-sharing (regulations 42 to 49). Every expected value is written by hand from the text of
-- regs 42 to 49 (SOR-96-332.txt lines 746-757) before the module was run.

§ `reg 42 -- work-sharing benefits are payable`

#ASSERT `reg 42 work-sharing benefits are payable for the week` TRUE TRUE TRUE EQUALS TRUE
#ASSERT `reg 42 work-sharing benefits are payable for the week` FALSE TRUE TRUE EQUALS FALSE
#ASSERT `reg 42 work-sharing benefits are payable for the week` TRUE FALSE TRUE EQUALS FALSE
#ASSERT `reg 42 work-sharing benefits are payable for the week` TRUE TRUE FALSE EQUALS FALSE

§ `reg 43 -- the interruption of earnings`

-- A reduction of at least 10 per cent of 1000 is 100: earnings of 900 or less. 901 is a reduction of 99.
#ASSERT `reg 43 the reduction in the person's normal weekly earnings is at least 10 per cent` 1000 900 EQUALS JUST TRUE
#ASSERT `reg 43 the reduction in the person's normal weekly earnings is at least 10 per cent` 1000 901 EQUALS JUST FALSE
#ASSERT `reg 43 the reduction in the person's normal weekly earnings is at least 10 per cent` 1000 500 EQUALS JUST TRUE
#ASSERT `reg 43 the reduction in the person's normal weekly earnings is at least 10 per cent` 1000 1000 EQUALS JUST FALSE
-- no normal weekly earnings: no reduction to measure.
#ASSERT `reg 43 the reduction in the person's normal weekly earnings is at least 10 per cent` 0 0 EQUALS NOTHING
-- the interruption occurs at the beginning of the week: Wednesday 2026-03-04 is in the week of Sunday 2026-03-01.
#ASSERT `reg 43 the day on which the interruption of earnings occurs` (YearMonthDay 2026 3 4) EQUALS YearMonthDay 2026 3 1
#ASSERT `reg 43 the day on which the interruption of earnings occurs` (YearMonthDay 2026 3 1) EQUALS YearMonthDay 2026 3 1
#ASSERT `reg 43 the day on which the interruption of earnings occurs` (YearMonthDay 2026 3 7) EQUALS YearMonthDay 2026 3 1

§ `regs 44 to 46 -- entitlement, the benefit period, the waiting period`

#ASSERT `reg 44 the claimant is not entitled to work-sharing benefits for the week` TRUE EQUALS TRUE
#ASSERT `reg 44 the claimant is not entitled to work-sharing benefits for the week` FALSE EQUALS FALSE
-- 45: three weeks in work-sharing employment extend a benefit period ending 2026-07-04 by 21 days to 2026-07-25.
#ASSERT `reg 45 the number of weeks by which the benefit period is extended` 3 EQUALS 3
#ASSERT `reg 45 the benefit period as extended` (`Period of days` OF (YearMonthDay 2026 1 4), (YearMonthDay 2026 7 4)) 3 EQUALS `Period of days` OF (YearMonthDay 2026 1 4), (YearMonthDay 2026 7 25)
#ASSERT `reg 45 the benefit period as extended` (`Period of days` OF (YearMonthDay 2026 1 4), (YearMonthDay 2026 7 4)) 0 EQUALS `Period of days` OF (YearMonthDay 2026 1 4), (YearMonthDay 2026 7 4)
-- 46: deferred while the work-sharing employment lasts.
#ASSERT `reg 46 the serving of the waiting period is deferred` TRUE FALSE TRUE EQUALS TRUE
#ASSERT `reg 46 the serving of the waiting period is deferred` TRUE TRUE TRUE EQUALS FALSE
#ASSERT `reg 46 the serving of the waiting period is deferred` TRUE FALSE FALSE EQUALS FALSE
#ASSERT `reg 46 the serving of the waiting period is deferred` FALSE FALSE TRUE EQUALS FALSE
#ASSERT `reg 46 the deduction of earnings is deferred` TRUE FALSE TRUE EQUALS TRUE
#ASSERT `reg 46 the deduction of earnings is deferred` TRUE TRUE TRUE EQUALS FALSE
#ASSERT `reg 46 the deduction of earnings is deferred` TRUE FALSE FALSE EQUALS FALSE
#ASSERT `reg 46 the deduction of earnings is deferred` FALSE FALSE TRUE EQUALS FALSE

§ `reg 47 -- earnings`

#ASSERT `reg 47(1) the amount of earnings from work-sharing employment deducted from the work-sharing benefits` 300 EQUALS 0
#ASSERT `reg 47(2) the amount deducted from the work-sharing benefits for the week` TRUE 120 EQUALS 120
#ASSERT `reg 47(2) the amount deducted from the work-sharing benefits for the week` FALSE 120 EQUALS 0

§ `reg 48 -- the rate of weekly benefits`

-- 8 of 40 hours not worked: one fifth of the rate. 500 / 5 = 100; 450 / 5 = 90.
#ASSERT `reg 48 the rate of weekly benefits payable under a work-sharing agreement` 500 8 40 EQUALS JUST 100
#ASSERT `reg 48 the rate of weekly benefits payable under a work-sharing agreement` 450 8 40 EQUALS JUST 90
#ASSERT `reg 48 the rate of weekly benefits payable under a work-sharing agreement` 500 0 40 EQUALS JUST 0
#ASSERT `reg 48 the rate of weekly benefits payable under a work-sharing agreement` 500 40 40 EQUALS JUST 500
-- days or shifts work the same way: 1 of 5 days.
#ASSERT `reg 48 the rate of weekly benefits payable under a work-sharing agreement` 500 1 5 EQUALS JUST 100
-- no usual schedule: not covered.
#ASSERT `reg 48 the rate of weekly benefits payable under a work-sharing agreement` 500 8 0 EQUALS NOTHING

§ `reg 49 -- weeks that do not count`

#ASSERT `reg 49 the weeks of benefits paid that count, not counting weeks of work-sharing benefits` 20 5 EQUALS 15
#ASSERT `reg 49 the weeks of benefits paid that count, not counting weeks of work-sharing benefits` 5 5 EQUALS 0
#ASSERT `reg 49 the weeks of benefits paid that count, not counting weeks of work-sharing benefits` 20 0 EQUALS 20
