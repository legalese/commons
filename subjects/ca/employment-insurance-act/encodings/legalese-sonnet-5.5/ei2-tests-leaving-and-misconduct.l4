IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `ei2-nouns`
IMPORT `ei2-leaving-and-misconduct`

-- Tests of ei2-leaving-and-misconduct (ss 29 to 35). Expected values are written by hand from the text.

§ `s 29 - the words used in ss 30 to 33`

-- (a) "any employment of the claimant within their qualifying period or their benefit period"
#ASSERT `s 29(a) the employment is an employment for the purposes of sections 30 to 33` TRUE FALSE
#ASSERT `s 29(a) the employment is an employment for the purposes of sections 30 to 33` FALSE TRUE
#ASSERT NOT `s 29(a) the employment is an employment for the purposes of sections 30 to 33` FALSE FALSE

-- (b) loss includes a suspension, but not a loss or suspension on account of union membership or lawful union activity
#ASSERT `s 29(b) loss of employment` TRUE FALSE FALSE
#ASSERT `s 29(b) loss of employment` FALSE TRUE FALSE
#ASSERT NOT `s 29(b) loss of employment` TRUE FALSE TRUE
#ASSERT NOT `s 29(b) loss of employment` FALSE TRUE TRUE
#ASSERT NOT `s 29(b) loss of employment` FALSE FALSE FALSE

-- (b.1) voluntarily leaving includes three kinds of refusal
#ASSERT `s 29(b.1) voluntarily leaving an employment` TRUE FALSE FALSE FALSE
#ASSERT `s 29(b.1) voluntarily leaving an employment` FALSE TRUE FALSE FALSE
#ASSERT `s 29(b.1) voluntarily leaving an employment` FALSE FALSE TRUE FALSE
#ASSERT `s 29(b.1) voluntarily leaving an employment` FALSE FALSE FALSE TRUE
#ASSERT NOT `s 29(b.1) voluntarily leaving an employment` FALSE FALSE FALSE FALSE
-- the day the voluntary leaving occurs: (i) the day the loss of employment occurs; (ii) the day the employment was to be resumed; (iii) the day of the transfer
#ASSERT `s 29(b.1) the day on which a refusal counts as the voluntary leaving` TRUE (YMD 2026 5 29) FALSE (YMD 2026 6 1) FALSE (YMD 2026 7 1) EQUALS JUST (YMD 2026 5 29)
#ASSERT `s 29(b.1) the day on which a refusal counts as the voluntary leaving` FALSE (YMD 2026 5 29) TRUE (YMD 2026 6 1) FALSE (YMD 2026 7 1) EQUALS JUST (YMD 2026 6 1)
#ASSERT `s 29(b.1) the day on which a refusal counts as the voluntary leaving` FALSE (YMD 2026 5 29) FALSE (YMD 2026 6 1) TRUE (YMD 2026 7 1) EQUALS JUST (YMD 2026 7 1)
-- an ordinary voluntary leaving: the text gives no rule for the day
#ASSERT `s 29(b.1) the day on which a refusal counts as the voluntary leaving` FALSE (YMD 2026 5 29) FALSE (YMD 2026 6 1) FALSE (YMD 2026 7 1) EQUALS NOTHING

-- (c) just cause: the test is "no reasonable alternative, having regard to all the circumstances"
#ASSERT `s 29(c) just cause for voluntarily leaving an employment or taking leave exists` TRUE
#ASSERT NOT `s 29(c) just cause for voluntarily leaving an employment or taking leave exists` FALSE
-- Fork ei2-F4: a listed circumstance does not by itself make just cause exist (the Act: "including any of the following").
-- With the judgment FALSE the answer is FALSE however many circumstances are present.
#ASSERT NOT `s 29(c) just cause for voluntarily leaving an employment or taking leave exists` FALSE
-- The fourteen listed circumstances, each alone, then none.
-- s 29(c)(i) alone: sexual or other harassment
#ASSERT `s 29(c) one of the circumstances listed in the Act is present` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE
-- s 29(c)(ii) alone: obligation to accompany a spouse, common-law partner or dependent child to another residence
#ASSERT `s 29(c) one of the circumstances listed in the Act is present` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE
-- s 29(c)(iii) alone: discrimination on a prohibited ground
#ASSERT `s 29(c) one of the circumstances listed in the Act is present` FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE
-- s 29(c)(iv) alone: working conditions that constitute a danger to health or safety
#ASSERT `s 29(c) one of the circumstances listed in the Act is present` FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE
-- s 29(c)(v) alone: obligation to care for a child or a member of the immediate family
#ASSERT `s 29(c) one of the circumstances listed in the Act is present` FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE
-- s 29(c)(vi) alone: reasonable assurance of another employment in the immediate future
#ASSERT `s 29(c) one of the circumstances listed in the Act is present` FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE
-- s 29(c)(vii) alone: significant modification of terms and conditions respecting wages or salary
#ASSERT `s 29(c) one of the circumstances listed in the Act is present` FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE
-- s 29(c)(viii) alone: excessive overtime work or refusal to pay for overtime work
#ASSERT `s 29(c) one of the circumstances listed in the Act is present` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE
-- s 29(c)(ix) alone: significant changes in work duties
#ASSERT `s 29(c) one of the circumstances listed in the Act is present` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE
-- s 29(c)(x) alone: antagonism with a supervisor
#ASSERT `s 29(c) one of the circumstances listed in the Act is present` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE
-- s 29(c)(xi) alone: practices of an employer that are contrary to law
#ASSERT `s 29(c) one of the circumstances listed in the Act is present` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE
-- s 29(c)(xii) alone: discrimination because of membership in an association, organization or union of workers
#ASSERT `s 29(c) one of the circumstances listed in the Act is present` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE
-- s 29(c)(xiii) alone: undue pressure by an employer on the claimant to leave their employment
#ASSERT `s 29(c) one of the circumstances listed in the Act is present` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE
-- s 29(c)(xiv) alone: any other reasonable circumstances that are prescribed
#ASSERT `s 29(c) one of the circumstances listed in the Act is present` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE
#ASSERT NOT `s 29(c) one of the circumstances listed in the Act is present` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE

§ `s 30(1) - disqualification`

-- misconduct, 100 of the 600 hours needed, not disentitled under ss 31 to 33, s 35 not engaged
#ASSERT `s 30(1) the claimant is disqualified from receiving any benefits` TRUE FALSE FALSE 100 600 FALSE
-- voluntarily left without just cause, no s 35
#ASSERT `s 30(1) the claimant is disqualified from receiving any benefits` FALSE TRUE FALSE 100 600 FALSE
-- (a): since leaving, employed in insurable employment for the required hours: 600 of 600 is enough, 599 is not
#ASSERT NOT `s 30(1) the claimant is disqualified from receiving any benefits` TRUE FALSE FALSE 600 600 FALSE
#ASSERT `s 30(1) the claimant is disqualified from receiving any benefits` TRUE FALSE FALSE 599 600 FALSE
-- (b): disentitled under ss 31 to 33 in relation to the employment
#ASSERT NOT `s 30(1) the claimant is disqualified from receiving any benefits` TRUE FALSE FALSE 100 600 TRUE
-- neither limb
#ASSERT NOT `s 30(1) the claimant is disqualified from receiving any benefits` FALSE FALSE FALSE 100 600 FALSE
-- s 35 protects a claimant who disqualified only because they left or refused to accept employment ...
#ASSERT NOT `s 30(1) the claimant is disqualified from receiving any benefits` FALSE TRUE TRUE 100 600 FALSE
-- ... but not one who lost the employment for misconduct (fork ei2-F5)
#ASSERT `s 30(1) the claimant is disqualified from receiving any benefits` TRUE FALSE TRUE 100 600 FALSE
-- s 30(7), declaratory: a claimant whose last employment was not lost or left like this (200 hours since, 600 needed)
-- may still be disqualified, and whether the claim is an initial claim is not an input: the same answer as the first case above.
#ASSERT `s 30(1) the claimant is disqualified from receiving any benefits` TRUE FALSE FALSE 200 600 FALSE

§ `s 30(2) to (4) - the weeks covered`

`a benefit period of 51 weeks` MEANS `Period of days` OF (YMD 2026 1 4), (YMD 2026 12 26)
`a waiting period of one week` MEANS `Period of days` OF (YMD 2026 1 4), (YMD 2026 1 10)

-- (2) "each week of the claimant's benefit period following the waiting period"
#ASSERT NOT `s 30(2) the week is a week of the benefit period following the waiting period` (YMD 2026 1 4) `a benefit period of 51 weeks` `a waiting period of one week`
#ASSERT `s 30(2) the week is a week of the benefit period following the waiting period` (YMD 2026 1 11) `a benefit period of 51 weeks` `a waiting period of one week`
#ASSERT `s 30(2) the week is a week of the benefit period following the waiting period` (YMD 2026 12 20) `a benefit period of 51 weeks` `a waiting period of one week`
#ASSERT NOT `s 30(2) the week is a week of the benefit period following the waiting period` (YMD 2026 12 27) `a benefit period of 51 weeks` `a waiting period of one week`
-- (3) the event occurs on Thursday 12 March 2026, in the benefit period: the week of Sunday 8 March is the first week
#ASSERT NOT `s 30(3) the week is not a week before the week in which the event occurs` TRUE (YMD 2026 3 12) (YMD 2026 3 1)
#ASSERT `s 30(3) the week is not a week before the week in which the event occurs` TRUE (YMD 2026 3 12) (YMD 2026 3 8)
#ASSERT `s 30(3) the week is not a week before the week in which the event occurs` TRUE (YMD 2026 3 12) (YMD 2026 3 15)
-- (3) does not apply when the event is not in a benefit period
#ASSERT `s 30(3) the week is not a week before the week in which the event occurs` FALSE (YMD 2026 3 12) (YMD 2026 3 1)
-- (4)
#ASSERT `s 30(4) the disqualification is suspended for the week` TRUE `caring for a new-born or adopted child`
-- regular benefits are not special benefits
#ASSERT NOT `s 30(4) the disqualification is suspended for the week` TRUE `a reason other than those mentioned in subsection 12(3)`
#ASSERT NOT `s 30(4) the disqualification is suspended for the week` FALSE `pregnancy`
#ASSERT `s 30(2) to (4) the week is a week of disqualification` TRUE TRUE TRUE FALSE
#ASSERT NOT `s 30(2) to (4) the week is a week of disqualification` FALSE TRUE TRUE FALSE
#ASSERT NOT `s 30(2) to (4) the week is a week of disqualification` TRUE FALSE TRUE FALSE
#ASSERT NOT `s 30(2) to (4) the week is a week of disqualification` TRUE TRUE FALSE FALSE
#ASSERT NOT `s 30(2) to (4) the week is a week of disqualification` TRUE TRUE TRUE TRUE

§ `s 30(5), (6) - hours that may not be used`

-- (5): 1000 hours in all, 400 before the employment was lost or left, 200 in an employment subsequently lost or left: 400 may be used
#ASSERT `s 30(5) the hours that may be used to qualify under section 7 or 7.1` TRUE TRUE 1000 400 200 EQUALS JUST 400
#ASSERT `s 30(5) the hours that may be used to qualify under section 7 or 7.1` TRUE TRUE 1000 800 200 EQUALS JUST 0
-- the two groups together exceed the total: not covered
#ASSERT `s 30(5) the hours that may be used to qualify under section 7 or 7.1` TRUE TRUE 1000 800 201 EQUALS NOTHING
-- not an initial claim, or not a loss or leaving as described: (5) does not apply
#ASSERT `s 30(5) the hours that may be used to qualify under section 7 or 7.1` TRUE FALSE 1000 400 200 EQUALS NOTHING
#ASSERT `s 30(5) the hours that may be used to qualify under section 7 or 7.1` FALSE TRUE 1000 400 200 EQUALS NOTHING
-- (6)
#ASSERT `s 30(6) the hours that may be used to determine the maximum weeks and the rate of weekly benefits` 1000 300 EQUALS JUST 700
#ASSERT `s 30(6) the hours that may be used to determine the maximum weeks and the rate of weekly benefits` 1000 1000 EQUALS JUST 0
#ASSERT `s 30(6) the hours that may be used to determine the maximum weeks and the rate of weekly benefits` 1000 1001 EQUALS NOTHING

§ `s 31 - suspended for misconduct`

#ASSERT `s 31 the claimant is not entitled to receive benefits` TRUE FALSE FALSE 0 600
-- (a) the period of suspension expires
#ASSERT NOT `s 31 the claimant is not entitled to receive benefits` TRUE TRUE FALSE 0 600
-- (b) the claimant loses or voluntarily leaves the employment
#ASSERT NOT `s 31 the claimant is not entitled to receive benefits` TRUE FALSE TRUE 0 600
-- (c) accumulates the required hours with another employer: 600 ends it, 599 does not
#ASSERT NOT `s 31 the claimant is not entitled to receive benefits` TRUE FALSE FALSE 600 600
#ASSERT `s 31 the claimant is not entitled to receive benefits` TRUE FALSE FALSE 599 600
-- not suspended for misconduct
#ASSERT NOT `s 31 the claimant is not entitled to receive benefits` FALSE FALSE FALSE 0 600

§ `s 32 - leave without just cause`

#ASSERT `s 32(1) the claimant who takes leave is disentitled` TRUE TRUE TRUE
#ASSERT NOT `s 32(1) the claimant who takes leave is disentitled` FALSE TRUE TRUE
#ASSERT NOT `s 32(1) the claimant who takes leave is disentitled` TRUE FALSE TRUE
#ASSERT NOT `s 32(1) the claimant who takes leave is disentitled` TRUE TRUE FALSE
#ASSERT `s 32(2) the disentitlement has ended` TRUE FALSE 0 600
#ASSERT `s 32(2) the disentitlement has ended` FALSE TRUE 0 600
#ASSERT `s 32(2) the disentitlement has ended` FALSE FALSE 600 600
#ASSERT NOT `s 32(2) the disentitlement has ended` FALSE FALSE 599 600

§ `s 33 - anticipated loss of employment`

-- Lost for misconduct on 1 June 2026; a set term expires on 15 June 2026 (14 days later): within three weeks.
#ASSERT `s 33(1) the claimant is not entitled to receive benefits` TRUE FALSE FALSE (YMD 2026 6 1) (JUST (YMD 2026 6 15)) (NOTHING)
-- Boundary: term expires 22 June 2026; lost on 1 June (21 days before) and on 31 May (22 days before).
#ASSERT `s 33(1) the claimant is not entitled to receive benefits` TRUE FALSE FALSE (YMD 2026 6 1) (JUST (YMD 2026 6 22)) (NOTHING)
#ASSERT NOT `s 33(1) the claimant is not entitled to receive benefits` TRUE FALSE FALSE (YMD 2026 5 31) (JUST (YMD 2026 6 22)) (NOTHING)
-- On the day the term expires (fork ei2-F6) and the day after it.
#ASSERT `s 33(1) the claimant is not entitled to receive benefits` TRUE FALSE FALSE (YMD 2026 6 22) (JUST (YMD 2026 6 22)) (NOTHING)
#ASSERT NOT `s 33(1) the claimant is not entitled to receive benefits` TRUE FALSE FALSE (YMD 2026 6 23) (JUST (YMD 2026 6 22)) (NOTHING)
-- (b) a notice already given of a lay-off on 30 June 2026; left on 20 June without just cause.
#ASSERT `s 33(1) the claimant is not entitled to receive benefits` FALSE TRUE FALSE (YMD 2026 6 20) (NOTHING) (JUST (YMD 2026 6 30))
-- Neither a set term nor a notice of lay-off: no anticipated loss.
#ASSERT NOT `s 33(1) the claimant is not entitled to receive benefits` TRUE FALSE FALSE (YMD 2026 6 20) (NOTHING) (NOTHING)
-- s 35 protects a claimant who left without just cause only because of union rights, not one dismissed for misconduct.
#ASSERT NOT `s 33(1) the claimant is not entitled to receive benefits` FALSE TRUE TRUE (YMD 2026 6 20) (NOTHING) (JUST (YMD 2026 6 30))
#ASSERT `s 33(1) the claimant is not entitled to receive benefits` TRUE FALSE TRUE (YMD 2026 6 20) (NOTHING) (JUST (YMD 2026 6 30))
-- Neither a misconduct loss nor a leaving without just cause.
#ASSERT NOT `s 33(1) the claimant is not entitled to receive benefits` FALSE FALSE FALSE (YMD 2026 6 20) (NOTHING) (JUST (YMD 2026 6 30))
-- (2) the disentitlement lasts until the term expires or the lay-off day (fork ei2-F7: that day counts)
#ASSERT `s 33(2) the disentitlement is still in force on the day` TRUE (YMD 2026 6 22) (YMD 2026 6 22)
#ASSERT NOT `s 33(2) the disentitlement is still in force on the day` TRUE (YMD 2026 6 23) (YMD 2026 6 22)
#ASSERT NOT `s 33(2) the disentitlement is still in force on the day` FALSE (YMD 2026 6 1) (YMD 2026 6 22)

§ `s 34 - suspension of the disentitlement`

#ASSERT `s 34 the disentitlement is suspended for the week` TRUE TRUE `care or support of a family member`
#ASSERT NOT `s 34 the disentitlement is suspended for the week` TRUE FALSE `care or support of a family member`
#ASSERT NOT `s 34 the disentitlement is suspended for the week` FALSE TRUE `care or support of a family member`
-- regular benefits are not special benefits
#ASSERT NOT `s 34 the disentitlement is suspended for the week` TRUE TRUE `a reason other than those mentioned in subsection 12(3)`

§ `s 35 - the union exception`

#ASSERT `s 35 the claimant is not disqualified or disentitled under sections 30 to 33` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 35 the claimant is not disqualified or disentitled under sections 30 to 33` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 35 the claimant is not disqualified or disentitled under sections 30 to 33` TRUE FALSE FALSE EQUALS NOTHING
-- the reason must be only the leaving or refusal
#ASSERT `s 35 the claimant is not disqualified or disentitled under sections 30 to 33` FALSE TRUE TRUE EQUALS NOTHING
