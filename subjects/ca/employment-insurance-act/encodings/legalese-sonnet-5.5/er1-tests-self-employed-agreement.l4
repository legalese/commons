IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `er1-self-employed-agreement`

-- Tests of er1-self-employed-agreement (Employment Insurance Regulations, regs 9.01 and 9.02). Piece er1.
-- Every expected value is written by hand from the text of the Regulations (../../registers/source-bundle/SOR-96-332.txt), beside the assertion,
-- before the rule was run. The argument order is the order of the rule's GIVEN lines.

§ `Regulation 9.01 - notice to terminate the agreement (src:161)`

-- arguments: the individual gives the Commission a notice to terminate; the notice is given in writing
#ASSERT `reg 9.01 the notice to terminate the agreement is given in the form the Regulations require` TRUE TRUE
#ASSERT NOT (`reg 9.01 the notice to terminate the agreement is given in the form the Regulations require` TRUE FALSE)   -- "shall be given in writing": an oral notice is not in the required form
#ASSERT NOT (`reg 9.01 the notice to terminate the agreement is given in the form the Regulations require` FALSE TRUE)  -- nothing was given to the Commission
#ASSERT NOT (`reg 9.01 the notice to terminate the agreement is given in the form the Regulations require` FALSE FALSE)

§ `Regulation 9.02 - withdrawal of the notice (src:164)`

-- arguments: the individual gives the Commission a withdrawal of the notice; the withdrawal is given in writing
#ASSERT `reg 9.02 the withdrawal of the notice is given in the form the Regulations require` TRUE TRUE
#ASSERT NOT (`reg 9.02 the withdrawal of the notice is given in the form the Regulations require` TRUE FALSE)   -- an oral withdrawal is not in the required form
#ASSERT NOT (`reg 9.02 the withdrawal of the notice is given in the form the Regulations require` FALSE TRUE)  -- nothing was given to the Commission
#ASSERT NOT (`reg 9.02 the withdrawal of the notice is given in the form the Regulations require` FALSE FALSE)
