#ASSERT `By what day must I pay the whole premium` FALSE (YearMonthDay 2027 4 30) EQUALS JUST (YearMonthDay 2027 4 30)
#ASSERT `By what day must I pay the whole premium` TRUE (YearMonthDay 2027 4 30) EQUALS NOTHING
