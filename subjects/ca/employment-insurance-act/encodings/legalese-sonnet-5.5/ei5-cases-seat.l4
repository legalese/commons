#ASSERT NOT (`Am I owed a decision on whether I am qualified, and notice of it` FALSE)

§ `How many weeks, and how much (ss 152.13 to 152.2)`

-- Q: the maximum weeks for each reason, s 152.14(1): (a) 15, (b) 35 or 61 by the election, (c) 26, (d) 26, (e) 35, (f) 15
#ASSERT `What is the most weeks of benefits I can be paid in my benefit period for this reason` `pregnancy` FALSE `the 35-week maximum` EQUALS JUST 15
#ASSERT `What is the most weeks of benefits I can be paid in my benefit period for this reason` `caring for a new-born or adopted child` TRUE `the 35-week maximum` EQUALS JUST 35
#ASSERT `What is the most weeks of benefits I can be paid in my benefit period for this reason` `caring for a new-born or adopted child` TRUE `the 61-week maximum` EQUALS JUST 61
-- no election made: the text gives the maximum "in accordance with the election", so there is none to state
#ASSERT `What is the most weeks of benefits I can be paid in my benefit period for this reason` `caring for a new-born or adopted child` FALSE `the 35-week maximum` EQUALS NOTHING
#ASSERT `What is the most weeks of benefits I can be paid in my benefit period for this reason` `a prescribed illness, injury or quarantine` FALSE `the 35-week maximum` EQUALS JUST 26
#ASSERT `What is the most weeks of benefits I can be paid in my benefit period for this reason` `care or support of a family member` FALSE `the 35-week maximum` EQUALS JUST 26
#ASSERT `What is the most weeks of benefits I can be paid in my benefit period for this reason` `care or support of a critically ill child` FALSE `the 35-week maximum` EQUALS JUST 35
#ASSERT `What is the most weeks of benefits I can be paid in my benefit period for this reason` `care or support of a critically ill adult` FALSE `the 35-week maximum` EQUALS JUST 15
-- Q: s 152.13: the 15th week of pregnancy benefits may be paid (14 already paid); a 16th may not
#ASSERT `May benefits be paid to me for this week` TRUE TRUE 14 `pregnancy` FALSE `the 35-week maximum` EQUALS JUST TRUE
#ASSERT `May benefits be paid to me for this week` TRUE TRUE 15 `pregnancy` FALSE `the 35-week maximum` EQUALS JUST FALSE
#ASSERT `May benefits be paid to me for this week` TRUE TRUE 60 `caring for a new-born or adopted child` TRUE `the 61-week maximum` EQUALS JUST TRUE
#ASSERT `May benefits be paid to me for this week` TRUE TRUE 35 `caring for a new-born or adopted child` TRUE `the 35-week maximum` EQUALS JUST FALSE
-- no benefit period
#ASSERT `May benefits be paid to me for this week` FALSE TRUE 0 `pregnancy` FALSE `the 35-week maximum` EQUALS JUST FALSE
#ASSERT `May benefits be paid to me for this week` TRUE TRUE 0 `caring for a new-born or adopted child` FALSE `the 35-week maximum` EQUALS NOTHING
-- Q: s 152.14(2): a single pregnancy 15; the care of children 35 or 40 if divided, 61 or 69 if divided
#ASSERT `What is the most weeks I can be paid for a single pregnancy or placement` FALSE `the 35-week maximum` FALSE EQUALS 15
#ASSERT `What is the most weeks I can be paid for a single pregnancy or placement` TRUE `the 35-week maximum` FALSE EQUALS 35
#ASSERT `What is the most weeks I can be paid for a single pregnancy or placement` TRUE `the 35-week maximum` TRUE EQUALS 40
#ASSERT `What is the most weeks I can be paid for a single pregnancy or placement` TRUE `the 61-week maximum` FALSE EQUALS 61
#ASSERT `What is the most weeks I can be paid for a single pregnancy or placement` TRUE `the 61-week maximum` TRUE EQUALS 69
#ASSERT `Are two or more children placed with me at the same time a single placement` TRUE TRUE
#ASSERT NOT (`Are two or more children placed with me at the same time a single placement` TRUE FALSE)
#ASSERT NOT (`Are two or more children placed with me at the same time a single placement` FALSE TRUE)
-- Q: s 152.14(5), (5.1), (5.2)
#ASSERT `What is the most weeks I can be paid in respect of one family member, critically ill child or critically ill adult` `care or support of a family member` EQUALS JUST 26
#ASSERT `What is the most weeks I can be paid in respect of one family member, critically ill child or critically ill adult` `care or support of a critically ill child` EQUALS JUST 35
#ASSERT `What is the most weeks I can be paid in respect of one family member, critically ill child or critically ill adult` `care or support of a critically ill adult` EQUALS JUST 15
#ASSERT `What is the most weeks I can be paid in respect of one family member, critically ill child or critically ill adult` `pregnancy` EQUALS NOTHING
-- the 52 weeks that begin Sunday 8 March 2026 end on Saturday 6 March 2027; a prescribed shorter period of 12 weeks ends 30 May 2026
#ASSERT `On what day does the period end during which that maximum applies` (YearMonthDay 2026 3 8) FALSE 0 EQUALS YearMonthDay 2027 3 6
#ASSERT `On what day does the period end during which that maximum applies` (YearMonthDay 2026 3 8) TRUE 12 EQUALS YearMonthDay 2026 5 30
-- (7) the shorter period has expired and the minimum prescribed number of weeks has not yet elapsed
#ASSERT `Are no further compassionate care benefits payable to me for this family member` TRUE FALSE
#ASSERT NOT (`Are no further compassionate care benefits payable to me for this family member` TRUE TRUE)
#ASSERT NOT (`Are no further compassionate care benefits payable to me for this family member` FALSE FALSE)
-- (8) combined weeks: 50; if extended under 152.11(14), the maximum benefit period less two weeks
#ASSERT `What is the most weeks I can combine in my benefit period` FALSE 0 EQUALS 50
#ASSERT `What is the most weeks I can combine in my benefit period` TRUE 78 EQUALS 76
#ASSERT `Are the weeks I want to combine within the maximum` 50 FALSE 0
#ASSERT NOT (`Are the weeks I want to combine within the maximum` 51 FALSE 0)
#ASSERT `Are the weeks I want to combine within the maximum` 76 TRUE 78
#ASSERT NOT (`Are the weeks I want to combine within the maximum` 77 TRUE 78)
-- Q: waiting period of one week
#ASSERT `Have I served my waiting period` 1
#ASSERT NOT (`Have I served my waiting period` 0)
-- Q: s 152.151: a rate under $200 allows $50 of earnings, so rate 150 and earnings 190 leaves 150 - 140 = 10 > 0; earnings 200 leaves 0
#ASSERT `Does this week count toward my waiting period` 150 190
#ASSERT NOT (`Does this week count toward my waiting period` 150 200)
-- a rate of $200 or more allows 25% of the rate: rate 400 allows 100; earnings 450 leaves 400 - 350 = 50 > 0; earnings 500 leaves 0
#ASSERT `Does this week count toward my waiting period` 400 450
#ASSERT NOT (`Does this week count toward my waiting period` 400 500)

-- Q: s 152.16, with a maximum yearly insurable earnings of 70,000 (invented for the case).
-- 55% of 52,000 / 52 = 550; 33% for a week paid under the 61-week election: 330; 35-week election at 55%: 550
#ASSERT `What is my rate of weekly benefits` 52000 0 70000 FALSE `the 35-week maximum` EQUALS 550
#ASSERT `What is my rate of weekly benefits` 52000 0 70000 TRUE `the 61-week maximum` EQUALS 330
#ASSERT `What is my rate of weekly benefits` 52000 0 70000 TRUE `the 35-week maximum` EQUALS 550
-- 52,000 + 26,000 = 78,000 is held to 70,000: 55% of 70,000 / 52 = 740.38, to the nearest dollar 740
#ASSERT `What is my rate of weekly benefits` 52000 26000 70000 FALSE `the 35-week maximum` EQUALS 740
-- Q: s 152.17(1): a supplement of 40 for a person with dependent children who meets the criteria
#ASSERT `By how much is my weekly rate increased by the family supplement` TRUE TRUE 40 EQUALS 40
#ASSERT `By how much is my weekly rate increased by the family supplement` TRUE FALSE 40 EQUALS 0
#ASSERT `By how much is my weekly rate increased by the family supplement` FALSE TRUE 40 EQUALS 0
-- (4) 25% of 26,000 / 52 = 125; a prescribed 30% gives 150
#ASSERT `What is the greatest increase the family supplement can make to my weekly rate` 26000 FALSE 0 EQUALS 125
#ASSERT `What is the greatest increase the family supplement can make to my weekly rate` 26000 TRUE 0.3 EQUALS 150
-- (5) 55% of 70,000 / 52 = 740
#ASSERT `What is the highest weekly rate that can be paid to me` 70000 EQUALS 740
-- rate 550 + supplement 40 = 590, inside the increase limit (250) and the maximum rate (740)
#ASSERT `What is my weekly rate with the family supplement` 550 TRUE TRUE 40 52000 FALSE 0 70000 EQUALS 590
-- a supplement of 300 is held to 250 (25% of 1,000), and 800 is held to 740
#ASSERT `What is my weekly rate with the family supplement` 550 TRUE TRUE 300 52000 FALSE 0 70000 EQUALS 740
-- no dependent children: no supplement
#ASSERT `What is my weekly rate with the family supplement` 550 FALSE TRUE 40 52000 FALSE 0 70000 EQUALS 550
-- Q: s 152.18(1): not more than the earnings
#ASSERT `How much of my benefits for the first three weeks is deducted for earnings in my waiting period` 120 80 EQUALS 80
#ASSERT `How much of my benefits for the first three weeks is deducted for earnings in my waiting period` 120 150 EQUALS 120
-- (2): weekly figure 52,000 / 52 = 1,000; 90% is 900; earnings 300 at 50% = 150; earnings 1,000 = 50% of 900 + 100% of 100 = 550
#ASSERT `How much is deducted from this week's benefits for my earnings` 300 52000 0 70000 EQUALS 150
#ASSERT `How much is deducted from this week's benefits for my earnings` 1000 52000 0 70000 EQUALS 550
#ASSERT `How much is deducted from this week's benefits for my earnings` 0 52000 0 70000 EQUALS 0
-- (3)(a)(i) knowingly: the whole 1,000; (ii) otherwise 1,000 less (600 - 200) = 600
#ASSERT `How much is deducted from my benefits because I did not declare all my earnings` 1000 TRUE 600 200 EQUALS 1000
#ASSERT `How much is deducted from my benefits because I did not declare all my earnings` 1000 FALSE 600 200 EQUALS 600
-- (3)(b): 700 to deduct from weeks of benefits of 400 each: 400 in the first week, 300 in the second, nothing after
#ASSERT `How much is taken from each of my next four weeks of benefits for undeclared earnings` 700 400 400 400 400 EQUALS LIST 400, 300
-- s 152.19: one fifth of a rate of 500 for each working day: 2 days = 200
#ASSERT `How much is deducted for the working days on which I am not entitled to benefits` 500 2 EQUALS 200
#ASSERT `How much is deducted for the working days on which I am not entitled to benefits` 500 0 EQUALS 0
-- s 152.2: an inmate; outside Canada; a regulation (reg 54 or 55.01) otherwise provides
#ASSERT `Am I not entitled to benefits for a period because I am in prison or outside Canada` TRUE FALSE FALSE
#ASSERT `Am I not entitled to benefits for a period because I am in prison or outside Canada` FALSE TRUE FALSE
#ASSERT NOT (`Am I not entitled to benefits for a period because I am in prison or outside Canada` FALSE TRUE TRUE)
#ASSERT NOT (`Am I not entitled to benefits for a period because I am in prison or outside Canada` FALSE FALSE FALSE)
#ASSERT `Am I disentitled from receiving benefits` FALSE FALSE FALSE TRUE FALSE FALSE
#ASSERT NOT (`Am I disentitled from receiving benefits` FALSE FALSE FALSE FALSE FALSE FALSE)

§ `The premium I must pay, and the return I must file (ss 152.21 to 152.3)`

-- Q: s 152.21(3): a premium is required for the year of entering the agreement (2026) whatever the day, and for the year of
-- termination (2027), but not for 2025 (before) or 2028 (after)
#ASSERT `Must I pay a self-employment premium for this year` 2026 (YearMonthDay 2026 12 20) FALSE TRUE (YearMonthDay 2027 3 1)
#ASSERT `Must I pay a self-employment premium for this year` 2027 (YearMonthDay 2026 12 20) FALSE TRUE (YearMonthDay 2027 3 1)
