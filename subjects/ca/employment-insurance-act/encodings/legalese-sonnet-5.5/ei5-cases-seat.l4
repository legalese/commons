#ASSERT `What total of instalments am I deemed to have owed by this instalment day for the purposes of interest` 1 4000 3200 2000 FALSE 0 EQUALS 500
-- 15 September: the least of 3,000 (a), 2 x 500 + half of (3,200 - 1,000) = 2,100 (b) and 2,400 (d) = 2,100
#ASSERT `What total of instalments am I deemed to have owed by this instalment day for the purposes of interest` 3 4000 3200 2000 FALSE 0 EQUALS 2100
-- notices stating 400 by 15 March: 400 is less than the 500 of (b)
#ASSERT `What total of instalments am I deemed to have owed by this instalment day for the purposes of interest` 1 4000 3200 2000 TRUE 400 EQUALS 400
