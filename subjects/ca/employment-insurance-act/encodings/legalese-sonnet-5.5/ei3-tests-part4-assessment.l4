IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `ei3-part4-assessment`

-- Tests of ei3-part4-assessment.l4 (Act ss 85 and 86).
-- Expected values are hand-worked from the text of the section named beside each assertion. Every figure and date is invented.

§ `s 85(1) and (2) assessment`

#ASSERT `s 85(1) the Minister may assess the employer` TRUE
#ASSERT NOT (`s 85(1) the Minister may assess the employer` FALSE)
#ASSERT `s 85(1) the action is an assessment` TRUE
#ASSERT NOT (`s 85(1) the action is an assessment` FALSE)
-- Valid and binding once the notice is sent, unless vacated on appeal.
#ASSERT `s 85(2) the assessment is valid and binding` TRUE FALSE
#ASSERT NOT (`s 85(2) the assessment is valid and binding` FALSE FALSE)
#ASSERT NOT (`s 85(2) the assessment is valid and binding` TRUE TRUE)
#ASSERT `s 85(2) the employer is liable to pay the amount to Her Majesty without delay` TRUE FALSE
#ASSERT NOT (`s 85(2) the employer is liable to pay the amount to Her Majesty without delay` FALSE FALSE)
#ASSERT NOT (`s 85(2) the employer is liable to pay the amount to Her Majesty without delay` TRUE TRUE)

§ `s 85(3) the three-year limit`

-- A premium that should have been paid in 2024: three years after the end of 2024 is the end of 31 December 2027.
#ASSERT `s 85(3) the Minister may make the assessment on that day` 2024 (YearMonthDay 2027 12 31) FALSE
#ASSERT `s 85(3) the Minister may make the assessment on that day` 2024 (YearMonthDay 2025 1 1) FALSE
#ASSERT NOT (`s 85(3) the Minister may make the assessment on that day` 2024 (YearMonthDay 2028 1 1) FALSE)
-- Misrepresentation or fraud lifts the limit.
#ASSERT `s 85(3) the Minister may make the assessment on that day` 2024 (YearMonthDay 2035 6 1) TRUE

§ `s 85(4) and (5) when a notice is sent`

#ASSERT `s 85(4) the day of mailing or sending the notice of assessment is deemed to be` (YearMonthDay 2026 5 4) FALSE FALSE EQUALS JUST (YearMonthDay 2026 5 4)
-- Evidence to the contrary, or the Minister calling it into question: no deeming.
#ASSERT `s 85(4) the day of mailing or sending the notice of assessment is deemed to be` (YearMonthDay 2026 5 4) TRUE FALSE EQUALS NOTHING
#ASSERT `s 85(4) the day of mailing or sending the notice of assessment is deemed to be` (YearMonthDay 2026 5 4) FALSE TRUE EQUALS NOTHING
-- Arguments: made available; posted by the Minister; authorized; revoked before that date; message sent to the address most
-- recently provided; message informed them; the date of the message.
#ASSERT `s 85(5) the day on which the notice is presumed to be sent and received` TRUE TRUE TRUE FALSE TRUE TRUE (YearMonthDay 2026 7 2) EQUALS JUST (YearMonthDay 2026 7 2)
#ASSERT `s 85(5) the day on which the notice is presumed to be sent and received` FALSE TRUE TRUE FALSE TRUE TRUE (YearMonthDay 2026 7 2) EQUALS NOTHING
#ASSERT `s 85(5) the day on which the notice is presumed to be sent and received` TRUE FALSE TRUE FALSE TRUE TRUE (YearMonthDay 2026 7 2) EQUALS NOTHING
#ASSERT `s 85(5) the day on which the notice is presumed to be sent and received` TRUE TRUE FALSE FALSE TRUE TRUE (YearMonthDay 2026 7 2) EQUALS NOTHING
#ASSERT `s 85(5) the day on which the notice is presumed to be sent and received` TRUE TRUE TRUE TRUE TRUE TRUE (YearMonthDay 2026 7 2) EQUALS NOTHING
#ASSERT `s 85(5) the day on which the notice is presumed to be sent and received` TRUE TRUE TRUE FALSE FALSE TRUE (YearMonthDay 2026 7 2) EQUALS NOTHING
#ASSERT `s 85(5) the day on which the notice is presumed to be sent and received` TRUE TRUE TRUE FALSE TRUE FALSE (YearMonthDay 2026 7 2) EQUALS NOTHING

§ `s 86(1) to (2.2) debt, deemed trust, security interest`

#ASSERT `s 86(1) the amount is a debt due to Her Majesty` TRUE
#ASSERT NOT (`s 86(1) the amount is a debt due to Her Majesty` FALSE)
-- Deducted and not remitted: deemed held in trust. Remitted, or never deducted: not.
#ASSERT `s 86(2) the employer is deemed to hold the amount in trust for Her Majesty` TRUE TRUE
#ASSERT NOT (`s 86(2) the employer is deemed to hold the amount in trust for Her Majesty` TRUE FALSE)
#ASSERT NOT (`s 86(2) the employer is deemed to hold the amount in trust for Her Majesty` FALSE TRUE)
#ASSERT `s 86(2.1) property equal in value to the amount is deemed to be held in trust for Her Majesty` TRUE
#ASSERT NOT (`s 86(2.1) property equal in value to the amount is deemed to be held in trust for Her Majesty` FALSE)
-- From the time the amount was deducted.
#ASSERT `s 86(2.1)(a) the day from which the property is deemed to be held in trust` TRUE (YearMonthDay 2026 3 15) EQUALS JUST (YearMonthDay 2026 3 15)
#ASSERT `s 86(2.1)(a) the day from which the property is deemed to be held in trust` FALSE (YearMonthDay 2026 3 15) EQUALS NOTHING
#ASSERT `s 86(2.1)(b) the property is deemed to form no part of the estate or property of the employer` TRUE
#ASSERT NOT (`s 86(2.1)(b) the property is deemed to form no part of the estate or property of the employer` FALSE)
#ASSERT `s 86(2.1) the proceeds of the property shall be paid to the Receiver General in priority to all security interests` TRUE
#ASSERT NOT (`s 86(2.1) the proceeds of the property shall be paid to the Receiver General in priority to all security interests` FALSE)
-- (2.2): a prescribed security interest is not a security interest for (2) and (2.1).
#ASSERT `s 86(2.2) the interest is a security interest for the purposes of subsections (2) and (2.1)` TRUE FALSE
#ASSERT NOT (`s 86(2.2) the interest is a security interest for the purposes of subsections (2) and (2.1)` TRUE TRUE)
#ASSERT NOT (`s 86(2.2) the interest is a security interest for the purposes of subsections (2) and (2.1)` FALSE FALSE)

§ `s 86(3) to (7) responsible representatives, security, bankruptcy`

#ASSERT `s 86(3) the responsible representative shall obtain a certificate from the Minister before distributing` TRUE TRUE
#ASSERT NOT (`s 86(3) the responsible representative shall obtain a certificate from the Minister before distributing` TRUE FALSE)
#ASSERT NOT (`s 86(3) the responsible representative shall obtain a certificate from the Minister before distributing` FALSE TRUE)
#ASSERT `s 86(3) the certificate is the certificate the subsection requires` TRUE TRUE
#ASSERT NOT (`s 86(3) the certificate is the certificate the subsection requires` TRUE FALSE)
#ASSERT NOT (`s 86(3) the certificate is the certificate the subsection requires` FALSE TRUE)
-- (4): personal liability, to the extent of the value distributed: the smaller of the amounts and the value.
#ASSERT `s 86(4) the responsible representative is personally liable` TRUE TRUE
#ASSERT NOT (`s 86(4) the responsible representative is personally liable` TRUE FALSE)
#ASSERT NOT (`s 86(4) the responsible representative is personally liable` FALSE TRUE)
#ASSERT `s 86(4) the extent of the personal liability` 10_000 4_000 EQUALS 4_000
#ASSERT `s 86(4) the extent of the personal liability` 3_000 4_000 EQUALS 3_000
#ASSERT `s 86(4) the extent of the personal liability` 4_000 4_000 EQUALS 4_000
-- (5): security by mortgage, hypothec, other charge or guarantee, when the Minister considers it advisable.
#ASSERT `s 86(5) the Minister may accept the security for payment of premiums` TRUE TRUE
#ASSERT NOT (`s 86(5) the Minister may accept the security for payment of premiums` TRUE FALSE)
#ASSERT NOT (`s 86(5) the Minister may accept the security for payment of premiums` FALSE TRUE)
-- (6): the trustee of a bankrupt employer is its agent.
#ASSERT `s 86(6) the trustee in bankruptcy is deemed to be the agent of the bankrupt for the purposes of this Act` TRUE TRUE
#ASSERT NOT (`s 86(6) the trustee in bankruptcy is deemed to be the agent of the bankrupt for the purposes of this Act` TRUE FALSE)
#ASSERT NOT (`s 86(6) the trustee in bankruptcy is deemed to be the agent of the bankrupt for the purposes of this Act` FALSE TRUE)
-- (7): not a trustee in bankruptcy; one of the listed kinds; administering another's property, business or estate.
#ASSERT `s 86(7) responsible representative` FALSE TRUE TRUE
#ASSERT NOT (`s 86(7) responsible representative` TRUE TRUE TRUE)
#ASSERT NOT (`s 86(7) responsible representative` FALSE FALSE TRUE)
#ASSERT NOT (`s 86(7) responsible representative` FALSE TRUE FALSE)
