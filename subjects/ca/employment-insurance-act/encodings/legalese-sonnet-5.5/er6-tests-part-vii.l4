IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `er6-part-vii-transitional`

-- Tests of regs 94 to 95 (Part VII). Expected values are written from the text (SOR-96-332.txt lines 1724-1756), not from the rules.

§ `reg 95 -- the dates`

#ASSERT `reg 95(1) the day on which these Regulations come into force` EQUALS YearMonthDay 1996 6 30
#ASSERT `reg 95(1.1) the day on which sections 10 to 12 come into force` EQUALS YearMonthDay 1997 1 1
#ASSERT `reg 95(2) the day on which sections 19 to 21 come into force` EQUALS YearMonthDay 1997 1 1
#ASSERT `reg 95(3) the day on which sections 22 to 24 and 34, the Table to subsection 55(7) and paragraph 93(1)(c) come into force` EQUALS YearMonthDay 1997 1 5

§ `reg 95 -- which provision is in force on a day`

-- (1) "Except as otherwise provided in this Part, these Regulations come into force on June 30, 1996."
#ASSERT NOT (`reg 95 the provision is in force on the day` `er6 any other provision of these Regulations` (YearMonthDay 1996 6 29))
#ASSERT `reg 95 the provision is in force on the day` `er6 any other provision of these Regulations` (YearMonthDay 1996 6 30)
#ASSERT `reg 95 the provision is in force on the day` `er6 any other provision of these Regulations` (YearMonthDay 2026 9 30)
-- (1.1) "Sections 10 to 12 come into force on January 1, 1997."
#ASSERT NOT (`reg 95 the provision is in force on the day` `er6 sections 10 to 12` (YearMonthDay 1996 12 31))
#ASSERT `reg 95 the provision is in force on the day` `er6 sections 10 to 12` (YearMonthDay 1997 1 1)
-- (2) "Sections 19 to 21 come into force on January 1, 1997."
#ASSERT NOT (`reg 95 the provision is in force on the day` `er6 sections 19 to 21` (YearMonthDay 1996 12 31))
#ASSERT `reg 95 the provision is in force on the day` `er6 sections 19 to 21` (YearMonthDay 1997 1 1)
-- (3) "Sections 22 to 24 and 34, the Table to subsection 55(7) and paragraph 93(1)(c) come into force on January 5, 1997."
#ASSERT NOT (`reg 95 the provision is in force on the day` `er6 sections 22 to 24 and 34, the Table to subsection 55(7) and paragraph 93(1)(c)` (YearMonthDay 1997 1 4))
#ASSERT `reg 95 the provision is in force on the day` `er6 sections 22 to 24 and 34, the Table to subsection 55(7) and paragraph 93(1)(c)` (YearMonthDay 1997 1 5)

§ `reg 95(4), (4.1) and (5) -- the periods in which Schedule III applies`

-- (4) "applies during the period beginning on June 30, 1996 and ending on December 31, 1996"
#ASSERT NOT (`reg 95(4) the provision set out in Part I of Schedule III applies on the day` (YearMonthDay 1996 6 29))
#ASSERT `reg 95(4) the provision set out in Part I of Schedule III applies on the day` (YearMonthDay 1996 6 30)
#ASSERT `reg 95(4) the provision set out in Part I of Schedule III applies on the day` (YearMonthDay 1996 12 31)
#ASSERT NOT (`reg 95(4) the provision set out in Part I of Schedule III applies on the day` (YearMonthDay 1997 1 1))
-- (4.1) "during the period beginning on September 12, 1996 and ending on December 31, 1996"
#ASSERT NOT (`reg 95(4.1) the provision set out in Part I.1 of Schedule III applies in place of section 12 on the day` (YearMonthDay 1996 9 11))
#ASSERT `reg 95(4.1) the provision set out in Part I.1 of Schedule III applies in place of section 12 on the day` (YearMonthDay 1996 9 12)
#ASSERT `reg 95(4.1) the provision set out in Part I.1 of Schedule III applies in place of section 12 on the day` (YearMonthDay 1996 12 31)
#ASSERT NOT (`reg 95(4.1) the provision set out in Part I.1 of Schedule III applies in place of section 12 on the day` (YearMonthDay 1997 1 1))
-- (5) Part II applies "from June 30, 1996 until the coming into force of those provisions": sections 19 to 21 come into force on 1 January 1997, the others on 5 January 1997
#ASSERT NOT (`reg 95(5) the provisions set out in Part II of Schedule III apply in place of sections 19 to 21 on the day` (YearMonthDay 1996 6 29))
#ASSERT `reg 95(5) the provisions set out in Part II of Schedule III apply in place of sections 19 to 21 on the day` (YearMonthDay 1996 6 30)
#ASSERT `reg 95(5) the provisions set out in Part II of Schedule III apply in place of sections 19 to 21 on the day` (YearMonthDay 1996 12 31)
#ASSERT NOT (`reg 95(5) the provisions set out in Part II of Schedule III apply in place of sections 19 to 21 on the day` (YearMonthDay 1997 1 1))
#ASSERT `reg 95(5) the provisions set out in Part II of Schedule III apply in place of sections 22 to 24 and 34, the Table to subsection 55(7) and paragraph 93(1)(c) on the day` (YearMonthDay 1997 1 1)
#ASSERT `reg 95(5) the provisions set out in Part II of Schedule III apply in place of sections 22 to 24 and 34, the Table to subsection 55(7) and paragraph 93(1)(c) on the day` (YearMonthDay 1997 1 4)
#ASSERT NOT (`reg 95(5) the provisions set out in Part II of Schedule III apply in place of sections 22 to 24 and 34, the Table to subsection 55(7) and paragraph 93(1)(c) on the day` (YearMonthDay 1997 1 5))
#ASSERT NOT (`reg 95(5) the provisions set out in Part II of Schedule III apply in place of sections 22 to 24 and 34, the Table to subsection 55(7) and paragraph 93(1)(c) on the day` (YearMonthDay 1996 6 29))

§ `reg 94 -- hours read as weeks from 30 June 1996 to 4 January 1997`

-- the six provisions: (a) 35(3); (b) 35(7)(e); (c) 37(2)(c)(ii); (d) 56(2)(b)(iv); (e) section 88; (f) 93(5)
#ASSERT `reg 94 a reference to hours in the provision is read as a reference to weeks on the day` `er6 subsection 35(3)` (YearMonthDay 1996 6 30)
#ASSERT `reg 94 a reference to hours in the provision is read as a reference to weeks on the day` `er6 paragraph 35(7)(e)` (YearMonthDay 1996 9 1)
#ASSERT `reg 94 a reference to hours in the provision is read as a reference to weeks on the day` `er6 subparagraph 37(2)(c)(ii)` (YearMonthDay 1996 12 31)
#ASSERT `reg 94 a reference to hours in the provision is read as a reference to weeks on the day` `er6 subparagraph 56(2)(b)(iv)` (YearMonthDay 1997 1 4)
#ASSERT `reg 94 a reference to hours in the provision is read as a reference to weeks on the day` `er6 section 88` (YearMonthDay 1996 7 15)
#ASSERT `reg 94 a reference to hours in the provision is read as a reference to weeks on the day` `er6 subsection 93(5)` (YearMonthDay 1997 1 4)
-- "beginning on June 30, 1996 and ending on January 4, 1997": the day before and the day after are outside
#ASSERT NOT (`reg 94 a reference to hours in the provision is read as a reference to weeks on the day` `er6 subsection 93(5)` (YearMonthDay 1996 6 29))
#ASSERT NOT (`reg 94 a reference to hours in the provision is read as a reference to weeks on the day` `er6 subsection 93(5)` (YearMonthDay 1997 1 5))
#ASSERT `reg 94 the unit in which the provision counts on the day` `er6 subsection 93(5)` (YearMonthDay 1996 12 1) EQUALS `er6 weeks`
#ASSERT `reg 94 the unit in which the provision counts on the day` `er6 subsection 93(5)` (YearMonthDay 1997 1 5) EQUALS `er6 hours`
#ASSERT `reg 94 the unit in which the provision counts on the day` `er6 section 88` (YearMonthDay 1996 6 29) EQUALS `er6 hours`

§ `reg 94.1 -- a week before 1997 stands for 35 hours`

-- "in respect of a benefit period established on or after January 5, 1997 ... evidence of a week of insurable employment that occurred before January 1, 1997 ... 35 hours"
#ASSERT `reg 94.1 the hours of insurable employment that the week is considered to represent` (YearMonthDay 1997 1 5) TRUE EQUALS JUST 35
#ASSERT `reg 94.1 the hours of insurable employment that the week is considered to represent` (YearMonthDay 2010 3 1) TRUE EQUALS JUST 35
#ASSERT `reg 94.1 the hours of insurable employment that the week is considered to represent` (YearMonthDay 1997 1 4) TRUE EQUALS NOTHING
#ASSERT `reg 94.1 the hours of insurable employment that the week is considered to represent` (YearMonthDay 1997 1 5) FALSE EQUALS NOTHING
#ASSERT `reg 94.1 the section applies to the claim` (YearMonthDay 1997 1 5) TRUE
#ASSERT NOT (`reg 94.1 the section applies to the claim` (YearMonthDay 1997 1 4) TRUE)

§ `reg 94.2 -- placing the weeks, and the weeks of earnings counted`

#ASSERT `reg 94.2 the section applies to the claim` (YearMonthDay 1997 1 5) TRUE
#ASSERT NOT (`reg 94.2 the section applies to the claim` (YearMonthDay 1997 1 4) TRUE)
#ASSERT NOT (`reg 94.2 the section applies to the claim` (YearMonthDay 1997 1 5) FALSE)
-- (a): the last pay period in 1996 runs 15 to 28 December 1996. "(i) the last day of the last pay period in 1996, and (ii) the last day of
-- remunerated insurable employment if that day falls before the last pay period in 1996", whichever occurred first.
#ASSERT `reg 94.2(a) the day from which the weeks of insurable employment fall consecutively backward` (YearMonthDay 1996 12 28) (YearMonthDay 1996 12 15) (YearMonthDay 1996 12 28) EQUALS YearMonthDay 1996 12 28
#ASSERT `reg 94.2(a) the day from which the weeks of insurable employment fall consecutively backward` (YearMonthDay 1996 12 28) (YearMonthDay 1996 12 15) (YearMonthDay 1996 12 20) EQUALS YearMonthDay 1996 12 28
#ASSERT `reg 94.2(a) the day from which the weeks of insurable employment fall consecutively backward` (YearMonthDay 1996 12 28) (YearMonthDay 1996 12 15) (YearMonthDay 1996 12 15) EQUALS YearMonthDay 1996 12 28
#ASSERT `reg 94.2(a) the day from which the weeks of insurable employment fall consecutively backward` (YearMonthDay 1996 12 28) (YearMonthDay 1996 12 15) (YearMonthDay 1996 12 14) EQUALS YearMonthDay 1996 12 14
#ASSERT `reg 94.2(a) the day from which the weeks of insurable employment fall consecutively backward` (YearMonthDay 1996 12 28) (YearMonthDay 1996 12 15) (YearMonthDay 1996 10 31) EQUALS YearMonthDay 1996 10 31
-- (b): "20 or less, the insurable earnings are considered to be for that number of weeks ... greater than 20 ... the last 20 weeks"
#ASSERT `reg 94.2(b) the number of weeks for which the insurable earnings are considered to be` 0 EQUALS 0
#ASSERT `reg 94.2(b) the number of weeks for which the insurable earnings are considered to be` 19 EQUALS 19
#ASSERT `reg 94.2(b) the number of weeks for which the insurable earnings are considered to be` 20 EQUALS 20
#ASSERT `reg 94.2(b) the number of weeks for which the insurable earnings are considered to be` 21 EQUALS 20
#ASSERT `reg 94.2(b) the number of weeks for which the insurable earnings are considered to be` 52 EQUALS 20

§ `reg 94.3 -- the last pay period beginning in December 1996`

-- "where the remuneration for the last pay period beginning in December 1996 is paid ... on or after January 1, 1997"
#ASSERT `reg 94.3 the section applies to the pay period` (YearMonthDay 1997 1 1)
#ASSERT `reg 94.3 the section applies to the pay period` (YearMonthDay 1997 1 15)
#ASSERT NOT (`reg 94.3 the section applies to the pay period` (YearMonthDay 1996 12 31))
#ASSERT `reg 94.3(a) the day as at which the employer reads these Regulations to assess the insurability of the employment of the final pay period` (YearMonthDay 1997 1 1) EQUALS JUST (YearMonthDay 1997 1 1)
#ASSERT `reg 94.3(a) the day as at which the employer reads these Regulations to assess the insurability of the employment of the final pay period` (YearMonthDay 1996 12 31) EQUALS NOTHING
-- (b): each week or part of a week of the final pay period that falls in 1996 counts for the greater of 35 hours (reg 94.1) and the hours actually worked in it
#ASSERT `reg 94.3(b) the hours of insurable employment that the claimant is determined to have worked in the final pay period` (YearMonthDay 1997 1 3) (LIST 40, 20, 35) EQUALS JUST 110
#ASSERT `reg 94.3(b) the hours of insurable employment that the claimant is determined to have worked in the final pay period` (YearMonthDay 1997 1 3) (LIST 10, 10) EQUALS JUST 70
#ASSERT `reg 94.3(b) the hours of insurable employment that the claimant is determined to have worked in the final pay period` (YearMonthDay 1997 1 3) (LIST 35) EQUALS JUST 35
#ASSERT `reg 94.3(b) the hours of insurable employment that the claimant is determined to have worked in the final pay period` (YearMonthDay 1997 1 3) (LIST 36) EQUALS JUST 36
#ASSERT `reg 94.3(b) the hours of insurable employment that the claimant is determined to have worked in the final pay period` (YearMonthDay 1997 1 3) EMPTY EQUALS JUST 0
#ASSERT `reg 94.3(b) the hours of insurable employment that the claimant is determined to have worked in the final pay period` (YearMonthDay 1996 12 31) (LIST 40) EQUALS NOTHING

§ `reg 94.4 -- section 59.1 of the Unemployment Insurance Regulations`

-- "Where, after January 5, 1997, section 59.1 ... applies and where the application of that section requires the consideration of insured weeks of employment in 1996 or earlier"
#ASSERT `reg 94.4 the section applies` (YearMonthDay 1997 1 6) TRUE
#ASSERT NOT (`reg 94.4 the section applies` (YearMonthDay 1997 1 5) TRUE)
#ASSERT NOT (`reg 94.4 the section applies` (YearMonthDay 1997 1 6) FALSE)
-- "converted into an hourly equivalent by multiplying the number of weeks required by 35"
#ASSERT `reg 94.4 the hourly equivalent of the number of weeks stipulated by paragraphs 59.1(2)(a) and (b)` (YearMonthDay 1997 1 6) TRUE 12 EQUALS JUST 420
#ASSERT `reg 94.4 the hourly equivalent of the number of weeks stipulated by paragraphs 59.1(2)(a) and (b)` (YearMonthDay 1997 1 6) TRUE 52 EQUALS JUST 1820
#ASSERT `reg 94.4 the hourly equivalent of the number of weeks stipulated by paragraphs 59.1(2)(a) and (b)` (YearMonthDay 1997 1 5) TRUE 12 EQUALS NOTHING
#ASSERT `reg 94.4 the hours that the weeks of insurable employment are converted into` (YearMonthDay 1997 1 6) TRUE 10 EQUALS JUST 350
#ASSERT `reg 94.4 the hours that the weeks of insurable employment are converted into` (YearMonthDay 1997 1 6) FALSE 10 EQUALS NOTHING
