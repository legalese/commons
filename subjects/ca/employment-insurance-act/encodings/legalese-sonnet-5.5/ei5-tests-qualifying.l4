IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `eia-core-interpretation`
IMPORT `ei5-qualifying`

-- Tests of ei5-qualifying (Act ss 152.07, 152.08 and 152.09). Expected values are written by hand from the text
-- beside each assertion. Calendar facts used: five years from 24 October 2021 to 24 October 2026 are 1,826 days (one leap day,
-- 29 February 2024), so 260 weeks (1,820 days) before 24 October 2026 is 30 October 2021.

§ `152.07(1)(a) twelve months since the agreement`

-- arguments: day of the agreement, day tested, prescribed period in months (if any), deemed satisfied by the Regulations
#ASSERT NOT (`s 152.07(1)(a) at least 12 months have expired since the day on which the person entered into the agreement` (YMD 2026 1 10) (YMD 2027 1 9) NOTHING FALSE)
#ASSERT `s 152.07(1)(a) at least 12 months have expired since the day on which the person entered into the agreement` (YMD 2026 1 10) (YMD 2027 1 10) NOTHING FALSE
#ASSERT `s 152.07(1)(a) at least 12 months have expired since the day on which the person entered into the agreement` (YMD 2026 1 10) (YMD 2030 1 1) NOTHING FALSE
-- a prescribed period of 6 months takes the place of 12
#ASSERT NOT (`s 152.07(1)(a) at least 12 months have expired since the day on which the person entered into the agreement` (YMD 2026 1 10) (YMD 2026 7 9) (JUST 6) FALSE)
#ASSERT `s 152.07(1)(a) at least 12 months have expired since the day on which the person entered into the agreement` (YMD 2026 1 10) (YMD 2026 7 10) (JUST 6) FALSE
-- the Regulations deem the condition satisfied (reg 76.43)
#ASSERT `s 152.07(1)(a) at least 12 months have expired since the day on which the person entered into the agreement` (YMD 2026 1 10) (YMD 2026 2 1) NOTHING TRUE
-- an agreement of 29 February 2024: twelve months later is the clamped 28 February 2025
#ASSERT NOT (`s 152.07(1)(a) at least 12 months have expired since the day on which the person entered into the agreement` (YMD 2024 2 29) (YMD 2025 2 27) NOTHING FALSE)
#ASSERT `s 152.07(1)(a) at least 12 months have expired since the day on which the person entered into the agreement` (YMD 2024 2 29) (YMD 2025 2 28) NOTHING FALSE

#ASSERT `s 152.07(1)(b) the agreement has not been terminated or deemed to have been terminated` FALSE
#ASSERT NOT (`s 152.07(1)(b) the agreement has not been terminated or deemed to have been terminated` TRUE)
#ASSERT `s 152.07(1)(c) the person has had an interruption of earnings from self-employment` TRUE
#ASSERT NOT (`s 152.07(1)(c) the person has had an interruption of earnings from self-employment` FALSE)

§ `152.07(1)(d)(i) the amount, by the date the benefit period begins`

-- the dates themselves
#ASSERT `s 152.07(1)(d)(i)(A) the first day of the period in which a benefit period must begin for the amount of $5,000` EQUALS YMD 2021 1 3
#ASSERT `s 152.07(1)(d)(i)(A) the last day of the period in which a benefit period must begin for the amount of $5,000` EQUALS YMD 2021 9 25
#ASSERT `s 152.07(1)(d)(i)(B) the first day of the period in which a benefit period must begin for the amount of $5,289` EQUALS YMD 2021 9 26
#ASSERT `s 152.07(1)(d)(i)(B) the last day of the period in which a benefit period must begin for the amount of $5,289` EQUALS YMD 2022 9 24

-- arguments: the day the benefit period begins, the amount fixed by regulation for that qualifying period (if any)
-- the day before the first period: any other case -> $6,000, or the regulations' amount
#ASSERT `s 152.07(1)(d)(i) the amount of self-employed earnings required of a person who has not accumulated a violation` (YMD 2021 1 2) NOTHING EQUALS 6000
#ASSERT `s 152.07(1)(d)(i) the amount of self-employed earnings required of a person who has not accumulated a violation` (YMD 2021 1 2) (JUST 6200) EQUALS 6200
-- first day of period (A): $5,000 despite any regulation
#ASSERT `s 152.07(1)(d)(i) the amount of self-employed earnings required of a person who has not accumulated a violation` (YMD 2021 1 3) (JUST 6200) EQUALS 5000
#ASSERT `s 152.07(1)(d)(i) the amount of self-employed earnings required of a person who has not accumulated a violation` (YMD 2021 9 25) NOTHING EQUALS 5000
-- first day of period (B): $5,289
#ASSERT `s 152.07(1)(d)(i) the amount of self-employed earnings required of a person who has not accumulated a violation` (YMD 2021 9 26) (JUST 6200) EQUALS 5289
#ASSERT `s 152.07(1)(d)(i) the amount of self-employed earnings required of a person who has not accumulated a violation` (YMD 2022 9 24) NOTHING EQUALS 5289
-- the day after period (B): any other case again
#ASSERT `s 152.07(1)(d)(i) the amount of self-employed earnings required of a person who has not accumulated a violation` (YMD 2022 9 25) NOTHING EQUALS 6000
#ASSERT `s 152.07(1)(d)(i) the amount of self-employed earnings required of a person who has not accumulated a violation` (YMD 2022 9 25) (JUST 6300) EQUALS 6300
#ASSERT `s 152.07(1)(d)(i) the amount of self-employed earnings required of a person who has not accumulated a violation` (YMD 2026 1 4) NOTHING EQUALS 6000

§ `152.07(1)(d)(ii) the multipliers`

#ASSERT `s 152.07(1)(d)(ii) the multiplier for the class of the violation` `a minor violation` NOTHING EQUALS 1.25
#ASSERT `s 152.07(1)(d)(ii) the multiplier for the class of the violation` `a serious violation` NOTHING EQUALS 1.5
#ASSERT `s 152.07(1)(d)(ii) the multiplier for the class of the violation` `a very serious violation` NOTHING EQUALS 1.75
#ASSERT `s 152.07(1)(d)(ii) the multiplier for the class of the violation` `a subsequent violation` NOTHING EQUALS 2
-- a prescribed multiplier takes the place of the default
#ASSERT `s 152.07(1)(d)(ii) the multiplier for the class of the violation` `a minor violation` (JUST 3) EQUALS 3

-- the 260 weeks before an initial claim made on 24 October 2026: from 30 October 2021 to 23 October 2026
#ASSERT `s 152.07(1)(d) a violation was accumulated in the 260 weeks before making the initial claim` (YMD 2021 10 30) (YMD 2026 10 24)
#ASSERT NOT (`s 152.07(1)(d) a violation was accumulated in the 260 weeks before making the initial claim` (YMD 2021 10 29) (YMD 2026 10 24))
#ASSERT `s 152.07(1)(d) a violation was accumulated in the 260 weeks before making the initial claim` (YMD 2026 10 23) (YMD 2026 10 24)
#ASSERT NOT (`s 152.07(1)(d) a violation was accumulated in the 260 weeks before making the initial claim` (YMD 2026 10 24) (YMD 2026 10 24))

-- arguments: day the benefit period begins, amount fixed by regulation, class of violation in the 260 weeks (if any), prescribed multiplier
#ASSERT `s 152.07(1)(d) the amount of self-employed earnings the person must have had during their qualifying period` (YMD 2026 1 4) NOTHING NOTHING NOTHING EQUALS 6000
#ASSERT `s 152.07(1)(d) the amount of self-employed earnings the person must have had during their qualifying period` (YMD 2026 1 4) NOTHING (JUST `a minor violation`) NOTHING EQUALS 7500
#ASSERT `s 152.07(1)(d) the amount of self-employed earnings the person must have had during their qualifying period` (YMD 2026 1 4) NOTHING (JUST `a serious violation`) NOTHING EQUALS 9000
#ASSERT `s 152.07(1)(d) the amount of self-employed earnings the person must have had during their qualifying period` (YMD 2026 1 4) NOTHING (JUST `a very serious violation`) NOTHING EQUALS 10500
#ASSERT `s 152.07(1)(d) the amount of self-employed earnings the person must have had during their qualifying period` (YMD 2026 1 4) NOTHING (JUST `a subsequent violation`) NOTHING EQUALS 12000
-- the multiplier is applied to the amount that would otherwise apply, which in 2021 is $5,000
#ASSERT `s 152.07(1)(d) the amount of self-employed earnings the person must have had during their qualifying period` (YMD 2021 5 2) NOTHING (JUST `a minor violation`) NOTHING EQUALS 6250
#ASSERT `s 152.07(1)(d) the amount of self-employed earnings the person must have had during their qualifying period` (YMD 2021 5 2) NOTHING (JUST `a subsequent violation`) NOTHING EQUALS 10000
-- and in 2022 it is $5,289: 5289 x 1.5 = 7933.5
#ASSERT `s 152.07(1)(d) the amount of self-employed earnings the person must have had during their qualifying period` (YMD 2022 3 1) NOTHING (JUST `a serious violation`) NOTHING EQUALS 7933.5
-- the regulations' amount, in a later year, times 1.25: 6500 x 1.25 = 8125
#ASSERT `s 152.07(1)(d) the amount of self-employed earnings the person must have had during their qualifying period` (YMD 2026 1 4) (JUST 6500) (JUST `a minor violation`) NOTHING EQUALS 8125
-- a prescribed multiplier of 3: 6000 x 3 = 18000
#ASSERT `s 152.07(1)(d) the amount of self-employed earnings the person must have had during their qualifying period` (YMD 2026 1 4) NOTHING (JUST `a minor violation`) (JUST 3) EQUALS 18000

-- "equal to or greater than"
#ASSERT `s 152.07(1)(d) the person has had during their qualifying period an amount of self-employed earnings equal to or greater than the amount required` 6000 6000
#ASSERT `s 152.07(1)(d) the person has had during their qualifying period an amount of self-employed earnings equal to or greater than the amount required` 6000.01 6000
#ASSERT NOT (`s 152.07(1)(d) the person has had during their qualifying period an amount of self-employed earnings equal to or greater than the amount required` 5999.99 6000)

#ASSERT `s 152.07(1) a self-employed person qualifies for benefits` TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 152.07(1) a self-employed person qualifies for benefits` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`s 152.07(1) a self-employed person qualifies for benefits` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 152.07(1) a self-employed person qualifies for benefits` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 152.07(1) a self-employed person qualifies for benefits` TRUE TRUE TRUE FALSE)

§ `152.07(2) to (7) violations`

-- arguments: notice of violation issued, penalties under s 38 or 41.1, guilty of offences under s 135 or 136, guilty under the Criminal Code
#ASSERT `s 152.07(2) a self-employed person accumulates a violation` TRUE TRUE FALSE FALSE
#ASSERT `s 152.07(2) a self-employed person accumulates a violation` TRUE FALSE TRUE FALSE
#ASSERT `s 152.07(2) a self-employed person accumulates a violation` TRUE FALSE FALSE TRUE
-- no notice of violation: nothing accumulated
#ASSERT NOT (`s 152.07(2) a self-employed person accumulates a violation` FALSE TRUE TRUE TRUE)
-- a notice but none of the three circumstances
#ASSERT NOT (`s 152.07(2) a self-employed person accumulates a violation` TRUE FALSE FALSE FALSE)

-- (3)(b) and (4): arguments: disentitled, relates to qualification, weekly rate, average weeks, maximum that could have been paid
#ASSERT `s 152.07(3)(b) the weekly rate of benefits multiplied by the average number of weeks, held to the maximum of subsection (4)` TRUE FALSE 400 10 3000 EQUALS 3000
#ASSERT `s 152.07(3)(b) the weekly rate of benefits multiplied by the average number of weeks, held to the maximum of subsection (4)` TRUE FALSE 400 10 5000 EQUALS 4000
#ASSERT `s 152.07(3)(b) the weekly rate of benefits multiplied by the average number of weeks, held to the maximum of subsection (4)` FALSE TRUE 400 10 4500 EQUALS 4000
-- neither disentitled nor related to the qualification requirements: nothing under (b)
#ASSERT `s 152.07(3)(b) the weekly rate of benefits multiplied by the average number of weeks, held to the maximum of subsection (4)` FALSE FALSE 400 10 4500 EQUALS 0
-- (3) overpayment 1200 plus 3000
#ASSERT `s 152.07(3) the value of a violation` 1200 3000 EQUALS 4200
#ASSERT `s 152.07(3) the value of a violation` 1200 0 EQUALS 1200

-- (5) arguments: a warning was imposed, the value, the day the notice is issued, the day another violation was accumulated (if any)
#ASSERT `s 152.07(5) the class of a violation` TRUE 7000 (YMD 2026 6 1) NOTHING EQUALS NOTHING
#ASSERT `s 152.07(5) the class of a violation` FALSE 999.99 (YMD 2026 6 1) NOTHING EQUALS JUST `a minor violation`
#ASSERT `s 152.07(5) the class of a violation` FALSE 1000 (YMD 2026 6 1) NOTHING EQUALS JUST `a serious violation`
#ASSERT `s 152.07(5) the class of a violation` FALSE 4999.99 (YMD 2026 6 1) NOTHING EQUALS JUST `a serious violation`
#ASSERT `s 152.07(5) the class of a violation` FALSE 5000 (YMD 2026 6 1) NOTHING EQUALS JUST `a very serious violation`
-- subsequent: another violation accumulated on 1 June 2021; 260 weeks later is 26 May 2026
#ASSERT `s 152.07(5) the class of a violation` FALSE 100 (YMD 2026 5 26) (JUST (YMD 2021 6 1)) EQUALS JUST `a subsequent violation`
#ASSERT `s 152.07(5) the class of a violation` FALSE 100 (YMD 2026 5 27) (JUST (YMD 2021 6 1)) EQUALS JUST `a minor violation`
-- paragraph (b) governs a violation of any value
#ASSERT `s 152.07(5) the class of a violation` FALSE 9000 (YMD 2026 5 26) (JUST (YMD 2021 6 1)) EQUALS JUST `a subsequent violation`
-- the notice must come after the other violation
#ASSERT `s 152.07(5) the class of a violation` FALSE 100 (YMD 2026 6 1) (JUST (YMD 2026 7 1)) EQUALS JUST `a minor violation`
-- a warning leaves a violation without a class even if it would be subsequent
#ASSERT `s 152.07(5) the class of a violation` TRUE 100 (YMD 2026 5 26) (JUST (YMD 2021 6 1)) EQUALS NOTHING

-- (6) a violation accumulated under section 7.1 is deemed accumulated under this section on the day the notice was given
#ASSERT `s 152.07(6) the day on which a violation accumulated under section 7.1 is deemed to be accumulated under this section` TRUE (YMD 2026 3 3) EQUALS JUST (YMD 2026 3 3)
#ASSERT `s 152.07(6) the day on which a violation accumulated under section 7.1 is deemed to be accumulated under this section` FALSE (YMD 2026 3 3) EQUALS NOTHING

-- (7) at most two initial claims: this one may be the first or the second, not the third
#ASSERT `s 152.07(7) the violation may be taken into account under paragraph (1)(d) in this initial claim` 0
#ASSERT `s 152.07(7) the violation may be taken into account under paragraph (1)(d) in this initial claim` 1
#ASSERT NOT (`s 152.07(7) the violation may be taken into account under paragraph (1)(d) in this initial claim` 2)

§ `152.08 qualifying period`

-- the year immediately before the year in which the benefit period begins
#ASSERT `s 152.08(1) the qualifying period of a self-employed person` (YMD 2026 1 4) EQUALS `Period of days` OF (YMD 2025 1 1), (YMD 2025 12 31)
#ASSERT `s 152.08(1) the qualifying period of a self-employed person` (YMD 2026 12 31) EQUALS `Period of days` OF (YMD 2025 1 1), (YMD 2025 12 31)
#ASSERT `s 152.08(1) the qualifying period of a self-employed person` (YMD 2027 1 1) EQUALS `Period of days` OF (YMD 2026 1 1), (YMD 2026 12 31)
-- (2) the earnings may serve one initial claim only
#ASSERT `s 152.08(2) the self-employed earnings during a qualifying period may be taken into account` 0
#ASSERT NOT (`s 152.08(2) the self-employed earnings during a qualifying period may be taken into account` 1)

§ `152.09 benefits under this Part and Part I`

-- arguments: qualifies as a self-employed person, qualifies as an insured person under Part I, the Part elected (if any)
#ASSERT `s 152.09(1) the Part under which benefits are to be paid` TRUE TRUE (JUST `Part VII.1`) EQUALS JUST `Part VII.1`
#ASSERT `s 152.09(1) the Part under which benefits are to be paid` TRUE TRUE (JUST `Part I`) EQUALS JUST `Part I`
-- qualifies under both and has not elected: not decided
#ASSERT `s 152.09(1) the Part under which benefits are to be paid` TRUE TRUE NOTHING EQUALS NOTHING
-- elected a Part under which the person does not qualify
#ASSERT `s 152.09(1) the Part under which benefits are to be paid` TRUE TRUE (JUST `Part VIII`) EQUALS NOTHING
-- qualifies under one Part only: that Part, whatever was elected
#ASSERT `s 152.09(1) the Part under which benefits are to be paid` TRUE FALSE NOTHING EQUALS JUST `Part VII.1`
#ASSERT `s 152.09(1) the Part under which benefits are to be paid` FALSE TRUE NOTHING EQUALS JUST `Part I`
#ASSERT `s 152.09(1) the Part under which benefits are to be paid` FALSE FALSE NOTHING EQUALS NOTHING
#ASSERT `s 152.09(1) the individual must elect the Part under which benefits are to be paid` TRUE TRUE
#ASSERT NOT (`s 152.09(1) the individual must elect the Part under which benefits are to be paid` TRUE FALSE)
#ASSERT NOT (`s 152.09(1) the individual must elect the Part under which benefits are to be paid` FALSE TRUE)

-- (2) the election is binding for each of the six special reasons, and says nothing of the regular reason
#ASSERT `s 152.09(2) the election is binding in respect of the reason` `pregnancy`
#ASSERT `s 152.09(2) the election is binding in respect of the reason` `caring for a new-born or adopted child`
#ASSERT `s 152.09(2) the election is binding in respect of the reason` `a prescribed illness, injury or quarantine`
#ASSERT `s 152.09(2) the election is binding in respect of the reason` `care or support of a family member`
#ASSERT `s 152.09(2) the election is binding in respect of the reason` `care or support of a critically ill child`
#ASSERT `s 152.09(2) the election is binding in respect of the reason` `care or support of a critically ill adult`
#ASSERT NOT (`s 152.09(2) the election is binding in respect of the reason` `a reason other than those mentioned in subsection 12(3)`)
