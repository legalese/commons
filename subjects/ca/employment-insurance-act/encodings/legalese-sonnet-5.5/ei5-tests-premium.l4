IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `ei5-premium`

-- Tests of ei5-premium (Act ss 152.21 to 152.3). Expected values are written by hand from the text beside each
-- assertion. All dollar figures and the premium rate are invented for the cases; none is a published figure.

§ `152.21 the premium`

-- (2) the lesser of the earnings and the maximum less insurable earnings
#ASSERT `s 152.21(2) the amount on which the premium is calculated` 30000 65700 20000 EQUALS 30000
-- 65700 - 20000 = 45700 is the lesser
#ASSERT `s 152.21(2) the amount on which the premium is calculated` 50000 65700 20000 EQUALS 45700
#ASSERT `s 152.21(2) the amount on which the premium is calculated` 30000 65700 0 EQUALS 30000
-- the two are equal
#ASSERT `s 152.21(2) the amount on which the premium is calculated` 45700 65700 20000 EQUALS 45700

-- (1) 30000 x 1.64% = 492; 45700 x 1.64% = 749.48
#ASSERT `s 152.21(1) the self-employment premium for the year` 30000 (1.64%) EQUALS 492
#ASSERT `s 152.21(1) the self-employment premium for the year` 45700 (1.64%) EQUALS 749.48

-- (1) and (3) arguments: year, day the agreement was entered into, deemed never entered into, day terminated (if it was)
-- entered into on 1 March 2026 and never terminated: the year of entry and every later year
#ASSERT `s 152.21(1) and (3) a premium is required to be paid in respect of the year` 2026 (YMD 2026 3 1) FALSE NOTHING
#ASSERT `s 152.21(1) and (3) a premium is required to be paid in respect of the year` 2030 (YMD 2026 3 1) FALSE NOTHING
#ASSERT NOT (`s 152.21(1) and (3) a premium is required to be paid in respect of the year` 2025 (YMD 2026 3 1) FALSE NOTHING)
-- entered into on the last day of the year: still that year, whatever the date
#ASSERT `s 152.21(1) and (3) a premium is required to be paid in respect of the year` 2026 (YMD 2026 12 31) FALSE NOTHING
-- terminated on 1 May 2028: the year of termination is included, whatever the date, and no later year
#ASSERT `s 152.21(1) and (3) a premium is required to be paid in respect of the year` 2028 (YMD 2026 3 1) FALSE (JUST (YMD 2028 5 1))
#ASSERT `s 152.21(1) and (3) a premium is required to be paid in respect of the year` 2028 (YMD 2026 3 1) FALSE (JUST (YMD 2028 1 1))
#ASSERT NOT (`s 152.21(1) and (3) a premium is required to be paid in respect of the year` 2029 (YMD 2026 3 1) FALSE (JUST (YMD 2028 5 1)))
-- an agreement deemed never to have been entered into: no premium
#ASSERT NOT (`s 152.21(1) and (3) a premium is required to be paid in respect of the year` 2026 (YMD 2026 3 1) TRUE NOTHING)

§ `152.22 to 152.24 returns, estimate, assessment`

#ASSERT `s 152.22(1) the day on or before which the return of self-employed earnings must be filed without notice or demand` TRUE (YMD 2027 4 30) EQUALS JUST (YMD 2027 4 30)
#ASSERT `s 152.22(1) the day on or before which the return of self-employed earnings must be filed without notice or demand` FALSE (YMD 2027 4 30) EQUALS NOTHING
#ASSERT `s 152.22(1) the person's representative must file the return` TRUE
#ASSERT NOT (`s 152.22(1) the person's representative must file the return` FALSE)

-- (2) served on 1 June 2026, 30 days: 1 July 2026
#ASSERT `s 152.22(2) the day on or before which the return demanded must be filed` TRUE (YMD 2026 6 1) 30 EQUALS JUST (YMD 2026 7 1)
-- not served personally or by registered letter: no obligation
#ASSERT `s 152.22(2) the day on or before which the return demanded must be filed` FALSE (YMD 2026 6 1) 30 EQUALS NOTHING

#ASSERT `s 152.22(3) the administrator of the self-employed person's affairs must file the return` TRUE TRUE
#ASSERT NOT (`s 152.22(3) the administrator of the self-employed person's affairs must file the return` TRUE FALSE)
#ASSERT NOT (`s 152.22(3) the administrator of the self-employed person's affairs must file the return` FALSE TRUE)
#ASSERT `s 152.22(4) the return contains the information required` TRUE
#ASSERT NOT (`s 152.22(4) the return contains the information required` FALSE)
#ASSERT `s 152.23 the return contains the estimate required` TRUE
#ASSERT NOT (`s 152.23 the return contains the estimate required` FALSE)
#ASSERT `s 152.24 the person who filed the return is owed an assessment and a notice of assessment` TRUE
#ASSERT NOT (`s 152.24 the person who filed the return is owed an assessment and a notice of assessment` FALSE)

§ `152.25 payment of the premium`

-- (1) not required to pay instalments of income tax: the whole premium on the balance-due day
#ASSERT `s 152.25(1) the day on or before which the whole premium must be paid` FALSE (YMD 2027 4 30) EQUALS JUST (YMD 2027 4 30)
#ASSERT `s 152.25(1) the day on or before which the whole premium must be paid` TRUE (YMD 2027 4 30) EQUALS NOTHING

-- (2) two thirds of 3000 (the estimate) is 2000; two thirds of 2400 (the preceding year) is 1600
#ASSERT `s 152.25(2) the amount payable on or before December 31` TRUE 3000 2400 EQUALS 2000
#ASSERT `s 152.25(2) the amount payable on or before December 31` FALSE 3000 2400 EQUALS 1600

-- (3)(a) a quarter of 3000 is 750; a quarter of 2400 is 600
#ASSERT `s 152.25(3)(a) each of the four instalments` TRUE 3000 2400 EQUALS 750
#ASSERT `s 152.25(3)(a) each of the four instalments` FALSE 3000 2400 EQUALS 600
-- (3)(b)(i) a quarter of the second preceding year's 2000 is 500
#ASSERT `s 152.25(3)(b)(i) each of the instalments of March 15 and June 15` 2000 EQUALS 500
-- (3)(b)(ii) half of (2400 less half of 2000) = half of 1400 = 700; when the preceding year is less than half the second
-- preceding year the excess is nil
#ASSERT `s 152.25(3)(b)(ii) each of the instalments of September 15 and December 15` 2400 2000 EQUALS 700
#ASSERT `s 152.25(3)(b)(ii) each of the instalments of September 15 and December 15` 900 2000 EQUALS 0
#ASSERT `s 152.25(3) the days on or before which the instalments of the year are due` 2026 EQUALS LIST (YMD 2026 3 15), (YMD 2026 6 15), (YMD 2026 9 15), (YMD 2026 12 15)

-- the remainder: estimated premium 3000 less 2000 paid in instalments
#ASSERT `ss 152.25(2) and (3) the remainder of the premium payable on or before the balance-due day` 3000 2000 EQUALS 1000
#ASSERT `ss 152.25(2) and (3) the remainder of the premium payable on or before the balance-due day` 3000 3200 EQUALS 0
-- an instalment that would fall due after the person's death is not required; one due on or before the death day is
#ASSERT `ss 152.25(2) and (3) the instalment is required` (YMD 2026 6 15) NOTHING
#ASSERT `ss 152.25(2) and (3) the instalment is required` (YMD 2026 6 15) (JUST (YMD 2026 6 20))
#ASSERT `ss 152.25(2) and (3) the instalment is required` (YMD 2026 6 15) (JUST (YMD 2026 6 15))
#ASSERT NOT (`ss 152.25(2) and (3) the instalment is required` (YMD 2026 9 15) (JUST (YMD 2026 6 20)))

§ `152.26 interest`

#ASSERT `s 152.26(1) the difference on which interest is payable` 3000 2000 EQUALS 1000
#ASSERT `s 152.26(1) the difference on which interest is payable` 3000 3000 EQUALS 0
#ASSERT `s 152.26(1) the difference on which interest is payable` 3000 3500 EQUALS 0
#ASSERT `s 152.26(1) the period for which interest is payable` (YMD 2027 4 30) (YMD 2027 6 1) EQUALS `Period of days` OF (YMD 2027 4 30), (YMD 2027 6 1)

-- (2) the unpaid part of an instalment of 750 of which 500 was paid: 250; of which 800 was paid: nothing
#ASSERT `s 152.26(2) the amount of the instalment on which interest is payable` 750 500 EQUALS 250
#ASSERT `s 152.26(2) the amount of the instalment on which interest is payable` 750 800 EQUALS 0
-- the period runs to the day of payment ...
#ASSERT `s 152.26(2) the period for which interest on the unpaid instalment is payable` 750 500 (YMD 2026 6 15) (YMD 2026 8 1) NOTHING EQUALS `Period of days` OF (YMD 2026 6 15), (YMD 2026 8 1)
-- ... or to the beginning of the period under (1), whichever is earlier
#ASSERT `s 152.26(2) the period for which interest on the unpaid instalment is payable` 750 500 (YMD 2026 6 15) (YMD 2027 7 1) (JUST (YMD 2027 4 30)) EQUALS `Period of days` OF (YMD 2026 6 15), (YMD 2027 4 30)
#ASSERT `s 152.26(2) the period for which interest on the unpaid instalment is payable` 750 500 (YMD 2026 6 15) (YMD 2026 8 1) (JUST (YMD 2027 4 30)) EQUALS `Period of days` OF (YMD 2026 6 15), (YMD 2026 8 1)

-- (3) the least of two thirds of 3000 (2000), two thirds of 2400 (1600) and the notice amount
#ASSERT `s 152.26(3) the instalment on which interest is calculated for a farmer` 3000 2400 NOTHING EQUALS 1600
#ASSERT `s 152.26(3) the instalment on which interest is calculated for a farmer` 3000 2400 (JUST 1500) EQUALS 1500
#ASSERT `s 152.26(3) the instalment on which interest is calculated for a farmer` 3000 2400 (JUST 1800) EQUALS 1600

-- (4) premium for the year 4000, preceding year 3200, second preceding year 2000; k is the number of the instalment day
-- k = 1: (a) and (d) give a quarter of 4000 and of 3200, the least 800; (b) gives a quarter of 2000 = 500: 500
#ASSERT `s 152.26(4) the least total of the instalments required by the instalment day` 1 4000 3200 2000 NOTHING EQUALS 500
-- k = 2: (a)/(d) 1600; (b) 1000
#ASSERT `s 152.26(4) the least total of the instalments required by the instalment day` 2 4000 3200 2000 NOTHING EQUALS 1000
-- k = 3: (a)/(d) 2400; (b) half of 2000 plus half of (3200 - 1000) = 1000 + 1100 = 2100
#ASSERT `s 152.26(4) the least total of the instalments required by the instalment day` 3 4000 3200 2000 NOTHING EQUALS 2100
-- k = 4: (a)/(d) 3200; (b) 1000 + 2200 = 3200
#ASSERT `s 152.26(4) the least total of the instalments required by the instalment day` 4 4000 3200 2000 NOTHING EQUALS 3200
-- a notice amount of 400 at k = 1 is the least; a larger one is not
#ASSERT `s 152.26(4) the least total of the instalments required by the instalment day` 1 4000 3200 2000 (JUST 400) EQUALS 400
#ASSERT `s 152.26(4) the least total of the instalments required by the instalment day` 1 4000 3200 2000 (JUST 5000) EQUALS 500
-- with a large second preceding year (8000) and a small preceding year, (a)/(d) is the least: k = 3 gives 2400 (b would be 4000)
#ASSERT `s 152.26(4) the least total of the instalments required by the instalment day` 3 4000 3200 8000 NOTHING EQUALS 2400

§ `152.27 penalties`

#ASSERT `s 152.27(1) the penalty for failing to file a return` TRUE 1000 EQUALS 50
#ASSERT `s 152.27(1) the penalty for failing to file a return` FALSE 1000 EQUALS 0
#ASSERT `s 152.27(1) the Minister of National Revenue may reduce or remit the penalty` TRUE
#ASSERT NOT (`s 152.27(1) the Minister of National Revenue may reduce or remit the penalty` FALSE)
-- (2) $5 a day to a maximum of $50: 10 days is the maximum, 11 days stops there
#ASSERT `s 152.27(2) the penalty for failing to file a return required by subsection 152.22(3)` 0 EQUALS 0
#ASSERT `s 152.27(2) the penalty for failing to file a return required by subsection 152.22(3)` 3 EQUALS 15
#ASSERT `s 152.27(2) the penalty for failing to file a return required by subsection 152.22(3)` 10 EQUALS 50
#ASSERT `s 152.27(2) the penalty for failing to file a return required by subsection 152.22(3)` 11 EQUALS 50

§ `152.28 and 152.29`

-- arguments: Divisions I and J provision, Part XV or s 248(7), (11), this Part provides otherwise, a regulation provides otherwise
#ASSERT `s 152.28(1) the provision of the Income Tax Act applies to the premium as though it were tax` TRUE FALSE FALSE FALSE
#ASSERT `s 152.28(1) the provision of the Income Tax Act applies to the premium as though it were tax` FALSE TRUE FALSE FALSE
#ASSERT NOT (`s 152.28(1) the provision of the Income Tax Act applies to the premium as though it were tax` TRUE FALSE TRUE FALSE)
#ASSERT NOT (`s 152.28(1) the provision of the Income Tax Act applies to the premium as though it were tax` TRUE FALSE FALSE TRUE)
#ASSERT NOT (`s 152.28(1) the provision of the Income Tax Act applies to the premium as though it were tax` FALSE FALSE FALSE FALSE)

-- 152.29: 800 of the payment would go to tax; the premium owing is 500: 500 to the premium; with 1200 owing, all 800
#ASSERT `s 152.29 the part of the payment applied in payment of the premium` 800 500 EQUALS 500
#ASSERT `s 152.29 the part of the payment applied in payment of the premium` 800 1200 EQUALS 800
-- a payment of 1000 of which 500 goes to the premium leaves 500 for tax
#ASSERT `s 152.29 the part of the payment left to be applied in payment of tax under the Income Tax Act` 1000 500 EQUALS 500

§ `152.3 refund`

#ASSERT `s 152.3(1) the excess of the amount paid over the premium` 1000 800 EQUALS 200
#ASSERT `s 152.3(1) the excess of the amount paid over the premium` 700 800 EQUALS 0
-- (b) arguments: year, excess, notice of assessment sent, application in writing, day of application
-- three years after the end of 2026 is 31 December 2029, counted
#ASSERT `s 152.3(1)(b) the Minister of National Revenue shall make the refund` 2026 200 TRUE TRUE (YMD 2029 12 31)
#ASSERT NOT (`s 152.3(1)(b) the Minister of National Revenue shall make the refund` 2026 200 TRUE TRUE (YMD 2030 1 1))
#ASSERT `s 152.3(1)(b) the Minister of National Revenue shall make the refund` 2024 200 TRUE TRUE (YMD 2027 12 31)
#ASSERT NOT (`s 152.3(1)(b) the Minister of National Revenue shall make the refund` 2026 0 TRUE TRUE (YMD 2027 1 1))
#ASSERT NOT (`s 152.3(1)(b) the Minister of National Revenue shall make the refund` 2026 200 FALSE TRUE (YMD 2027 1 1))
#ASSERT NOT (`s 152.3(1)(b) the Minister of National Revenue shall make the refund` 2026 200 TRUE FALSE (YMD 2027 1 1))
#ASSERT `s 152.3(2) subsections 96(11) to (13) apply to the refund` TRUE
#ASSERT NOT (`s 152.3(2) subsections 96(11) to (13) apply to the refund` FALSE)
