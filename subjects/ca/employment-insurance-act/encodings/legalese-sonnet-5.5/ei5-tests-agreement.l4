IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `ei5-agreement`

-- Tests of ei5-agreement (Act s 152.02). Expected values are written by hand from the text beside each assertion.

§ `152.02(1) who this Part applies to`

-- a self-employed person, a Canadian citizen, with an agreement
#ASSERT `s 152.02(1) this Part applies in respect of a person` TRUE TRUE FALSE TRUE
-- a permanent resident instead of a citizen
#ASSERT `s 152.02(1) this Part applies in respect of a person` TRUE FALSE TRUE TRUE
-- neither a citizen nor a permanent resident
#ASSERT NOT (`s 152.02(1) this Part applies in respect of a person` TRUE FALSE FALSE TRUE)
-- no agreement entered into
#ASSERT NOT (`s 152.02(1) this Part applies in respect of a person` TRUE TRUE TRUE FALSE)
-- not a self-employed person
#ASSERT NOT (`s 152.02(1) this Part applies in respect of a person` FALSE TRUE FALSE TRUE)

§ `152.02(3) form and conditions fixed by the Commission`

-- nothing fixed: nothing to meet
#ASSERT `s 152.02(3) the agreement is in the form and on the conditions the Commission has fixed` FALSE FALSE FALSE
#ASSERT `s 152.02(3) the agreement is in the form and on the conditions the Commission has fixed` TRUE TRUE TRUE
#ASSERT NOT (`s 152.02(3) the agreement is in the form and on the conditions the Commission has fixed` TRUE FALSE TRUE)
#ASSERT NOT (`s 152.02(3) the agreement is in the form and on the conditions the Commission has fixed` TRUE TRUE FALSE)

§ `152.02(4) and (5) termination`

#ASSERT `s 152.02(4) the agreement is deemed to be terminated` TRUE
#ASSERT NOT (`s 152.02(4) the agreement is deemed to be terminated` FALSE)
-- notice in the prescribed form and manner, before any benefits are paid
#ASSERT `s 152.02(4) the individual may terminate the agreement by notice` TRUE FALSE FALSE
-- benefits have been paid and no prescribed circumstance exists: "may not be terminated ... at any other time"
#ASSERT NOT (`s 152.02(4) the individual may terminate the agreement by notice` TRUE TRUE FALSE)
-- benefits have been paid but a prescribed circumstance exists
#ASSERT `s 152.02(4) the individual may terminate the agreement by notice` TRUE TRUE TRUE
-- no notice in the prescribed form and manner: "may not be terminated in any other manner"
#ASSERT NOT (`s 152.02(4) the individual may terminate the agreement by notice` FALSE FALSE FALSE)
#ASSERT NOT (`s 152.02(4) the individual may terminate the agreement by notice` FALSE FALSE TRUE)
-- (5) the prescribed date
#ASSERT `s 152.02(5) the day on which an agreement deemed to be terminated is terminated` (YearMonthDay 2026 8 1) EQUALS YearMonthDay 2026 8 1

§ `152.02(6) and (7) what becomes of a notice`

-- The agreement was entered into on 10 January 2026, so the 60th day after it is 11 March 2026
-- (21 days left in January, 28 in February, 11 in March).
`the day of the agreement` MEANS YearMonthDay 2026 1 10

#ASSERT `s 152.02(6) December 31 of the year in which the notice is given` (YearMonthDay 2026 3 15) EQUALS YearMonthDay 2026 12 31

-- not given in accordance with (4): it does not terminate the agreement
#ASSERT `s 152.02(6) and (7) what becomes of a notice to terminate the agreement` FALSE `the day of the agreement` (YearMonthDay 2026 6 1) NOTHING NOTHING EQUALS `ei5 notice - not given in accordance with subsection (4), so the agreement is not terminated by it`
-- (7) notice on the 60th day: deemed never entered into
#ASSERT `s 152.02(6) and (7) what becomes of a notice to terminate the agreement` TRUE `the day of the agreement` (YearMonthDay 2026 3 11) NOTHING NOTHING EQUALS `ei5 notice - given within 60 days after the agreement was entered into, so the agreement is deemed never to have been entered into`
-- notice on the 61st day: (7) no longer applies, (6) does -> terminates on December 31
#ASSERT `s 152.02(6) and (7) what becomes of a notice to terminate the agreement` TRUE `the day of the agreement` (YearMonthDay 2026 3 12) NOTHING NOTHING EQUALS `ei5 notice - the agreement terminates on December 31 of the year in which the notice was given`
-- notice on the day the agreement was entered into: within 60 days
#ASSERT `s 152.02(6) and (7) what becomes of a notice to terminate the agreement` TRUE `the day of the agreement` (YearMonthDay 2026 1 10) NOTHING NOTHING EQUALS `ei5 notice - given within 60 days after the agreement was entered into, so the agreement is deemed never to have been entered into`
-- "Despite subsection (6)": a notice within 60 days is (7) even if a benefit period was established
#ASSERT `s 152.02(6) and (7) what becomes of a notice to terminate the agreement` TRUE `the day of the agreement` (YearMonthDay 2026 2 1) (JUST (YearMonthDay 2026 5 1)) NOTHING EQUALS `ei5 notice - given within 60 days after the agreement was entered into, so the agreement is deemed never to have been entered into`
-- (6)(a) a benefit period established on 31 December of the year of the notice: counted
#ASSERT `s 152.02(6) and (7) what becomes of a notice to terminate the agreement` TRUE `the day of the agreement` (YearMonthDay 2026 6 1) (JUST (YearMonthDay 2026 12 31)) NOTHING EQUALS `ei5 notice - deemed never to have been given, a benefit period having been established`
-- established on the day the notice was given: counted
#ASSERT `s 152.02(6) and (7) what becomes of a notice to terminate the agreement` TRUE `the day of the agreement` (YearMonthDay 2026 6 1) (JUST (YearMonthDay 2026 6 1)) NOTHING EQUALS `ei5 notice - deemed never to have been given, a benefit period having been established`
-- established on 1 January of the next year: outside the window
#ASSERT `s 152.02(6) and (7) what becomes of a notice to terminate the agreement` TRUE `the day of the agreement` (YearMonthDay 2026 6 1) (JUST (YearMonthDay 2027 1 1)) NOTHING EQUALS `ei5 notice - the agreement terminates on December 31 of the year in which the notice was given`
-- established the day before the notice: outside the window
#ASSERT `s 152.02(6) and (7) what becomes of a notice to terminate the agreement` TRUE `the day of the agreement` (YearMonthDay 2026 6 1) (JUST (YearMonthDay 2026 5 31)) NOTHING EQUALS `ei5 notice - the agreement terminates on December 31 of the year in which the notice was given`
-- (6)(b) withdrawn on 30 December: before December 31
#ASSERT `s 152.02(6) and (7) what becomes of a notice to terminate the agreement` TRUE `the day of the agreement` (YearMonthDay 2026 6 1) NOTHING (JUST (YearMonthDay 2026 12 30)) EQUALS `ei5 notice - withdrawn in the prescribed manner before December 31`
-- withdrawn on 31 December itself: not "before December 31"
#ASSERT `s 152.02(6) and (7) what becomes of a notice to terminate the agreement` TRUE `the day of the agreement` (YearMonthDay 2026 6 1) NOTHING (JUST (YearMonthDay 2026 12 31)) EQUALS `ei5 notice - the agreement terminates on December 31 of the year in which the notice was given`
-- both (a) and (b): the rule reports (a) (fork F5)
#ASSERT `s 152.02(6) and (7) what becomes of a notice to terminate the agreement` TRUE `the day of the agreement` (YearMonthDay 2026 6 1) (JUST (YearMonthDay 2026 7 1)) (JUST (YearMonthDay 2026 8 1)) EQUALS `ei5 notice - deemed never to have been given, a benefit period having been established`
-- nothing happens after the notice: the agreement terminates on December 31
#ASSERT `s 152.02(6) and (7) what becomes of a notice to terminate the agreement` TRUE `the day of the agreement` (YearMonthDay 2026 6 1) NOTHING NOTHING EQUALS `ei5 notice - the agreement terminates on December 31 of the year in which the notice was given`

§ `152.02(4) to (6) the day on which the agreement terminates`

-- a notice that ends the agreement, no deemed termination -> December 31 of the year of the notice
#ASSERT `s 152.02(4) to (6) the day on which the agreement terminates` FALSE (YearMonthDay 2026 8 1) `ei5 notice - the agreement terminates on December 31 of the year in which the notice was given` (YearMonthDay 2026 6 1) EQUALS JUST (YearMonthDay 2026 12 31)
-- a notice that was withdrawn: no termination
#ASSERT `s 152.02(4) to (6) the day on which the agreement terminates` FALSE (YearMonthDay 2026 8 1) `ei5 notice - withdrawn in the prescribed manner before December 31` (YearMonthDay 2026 6 1) EQUALS NOTHING
-- a deemed termination alone -> the prescribed date
#ASSERT `s 152.02(4) to (6) the day on which the agreement terminates` TRUE (YearMonthDay 2026 8 1) `ei5 notice - withdrawn in the prescribed manner before December 31` (YearMonthDay 2026 6 1) EQUALS JUST (YearMonthDay 2026 8 1)
-- both: the earlier day (fork F5)
#ASSERT `s 152.02(4) to (6) the day on which the agreement terminates` TRUE (YearMonthDay 2026 8 1) `ei5 notice - the agreement terminates on December 31 of the year in which the notice was given` (YearMonthDay 2026 6 1) EQUALS JUST (YearMonthDay 2026 8 1)
#ASSERT `s 152.02(4) to (6) the day on which the agreement terminates` TRUE (YearMonthDay 2027 2 1) `ei5 notice - the agreement terminates on December 31 of the year in which the notice was given` (YearMonthDay 2026 6 1) EQUALS JUST (YearMonthDay 2026 12 31)
-- a notice not given in accordance with (4) does not terminate it
#ASSERT `s 152.02(4) to (6) the day on which the agreement terminates` FALSE (YearMonthDay 2026 8 1) `ei5 notice - not given in accordance with subsection (4), so the agreement is not terminated by it` (YearMonthDay 2026 6 1) EQUALS NOTHING

§ `152.02(2) in force`

-- entered into on 10 January 2026, never terminated: indefinite duration
#ASSERT NOT (`s 152.02(2) the agreement is in force on a day` (YearMonthDay 2026 1 10) FALSE NOTHING (YearMonthDay 2026 1 9))
#ASSERT `s 152.02(2) the agreement is in force on a day` (YearMonthDay 2026 1 10) FALSE NOTHING (YearMonthDay 2026 1 10)
#ASSERT `s 152.02(2) the agreement is in force on a day` (YearMonthDay 2026 1 10) FALSE NOTHING (YearMonthDay 2040 6 1)
-- terminated on 31 December 2026: in force on the 30th, not on the 31st (fork F6)
#ASSERT `s 152.02(2) the agreement is in force on a day` (YearMonthDay 2026 1 10) FALSE (JUST (YearMonthDay 2026 12 31)) (YearMonthDay 2026 12 30)
#ASSERT NOT (`s 152.02(2) the agreement is in force on a day` (YearMonthDay 2026 1 10) FALSE (JUST (YearMonthDay 2026 12 31)) (YearMonthDay 2026 12 31))
#ASSERT NOT (`s 152.02(2) the agreement is in force on a day` (YearMonthDay 2026 1 10) FALSE (JUST (YearMonthDay 2026 12 31)) (YearMonthDay 2027 1 1))
-- deemed never to have been entered into: never in force
#ASSERT NOT (`s 152.02(2) the agreement is in force on a day` (YearMonthDay 2026 1 10) TRUE NOTHING (YearMonthDay 2026 6 1))
