IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `er3-nouns`
IMPORT `er3-information`

-- Tests of er3-information (regulations 55.1 and 55.2). Every expected value is written by hand from the text of
-- regs 55.1 and 55.2 (SOR-96-332.txt lines 933-941) before the module was run.

#ASSERT `reg 55.1 the employer must provide information about its employees electronically on a monthly basis` TRUE EQUALS TRUE
#ASSERT `reg 55.1 the employer must provide information about its employees electronically on a monthly basis` FALSE EQUALS FALSE
#ASSERT `reg 55.1 the information the employer provides about each employee each month` TRUE EQUALS LIST `er3 information: dates of commencement of employment`, `er3 information: periods of employment`, `er3 information: amounts earned during employment`
#ASSERT `reg 55.1 the information the employer provides about each employee each month` FALSE EQUALS EMPTY

-- 55.2: a benefit period established from 2009-01-04 to 2010-09-11 (both ends included), after a claim for special
-- benefits, and a week after the expiry of the benefit period that should have been established.
#ASSERT `reg 55.2 the amount paid for the week is one the Commission may ratify` (YearMonthDay 2009 6 1) TRUE TRUE EQUALS TRUE
#ASSERT `reg 55.2 the amount paid for the week is one the Commission may ratify` (YearMonthDay 2009 1 4) TRUE TRUE EQUALS TRUE
#ASSERT `reg 55.2 the amount paid for the week is one the Commission may ratify` (YearMonthDay 2009 1 3) TRUE TRUE EQUALS FALSE
#ASSERT `reg 55.2 the amount paid for the week is one the Commission may ratify` (YearMonthDay 2010 9 11) TRUE TRUE EQUALS TRUE
#ASSERT `reg 55.2 the amount paid for the week is one the Commission may ratify` (YearMonthDay 2010 9 12) TRUE TRUE EQUALS FALSE
#ASSERT `reg 55.2 the amount paid for the week is one the Commission may ratify` (YearMonthDay 2009 6 1) FALSE TRUE EQUALS FALSE
#ASSERT `reg 55.2 the amount paid for the week is one the Commission may ratify` (YearMonthDay 2009 6 1) TRUE FALSE EQUALS FALSE
