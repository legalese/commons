IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `ei2-nouns`
IMPORT `ei2-claim-procedure`

-- Tests of ei2-claim-procedure (ss 48 to 53). Expected values are written by hand from the text.

§ `s 48 - the initial claim`

#ASSERT `s 48(1) the first condition on which a benefit period may be established is met` TRUE TRUE
#ASSERT NOT `s 48(1) the first condition on which a benefit period may be established is met` FALSE TRUE
#ASSERT NOT `s 48(1) the first condition on which a benefit period may be established is met` TRUE FALSE
-- (2): form and manner, employment circumstances, interruption circumstances; other information only if the Commission requires it
#ASSERT `s 48(2) the second condition on which a benefit period may be established is met` TRUE TRUE TRUE FALSE FALSE
#ASSERT `s 48(2) the second condition on which a benefit period may be established is met` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT `s 48(2) the second condition on which a benefit period may be established is met` TRUE TRUE TRUE TRUE FALSE
#ASSERT NOT `s 48(2) the second condition on which a benefit period may be established is met` FALSE TRUE TRUE FALSE FALSE
#ASSERT NOT `s 48(2) the second condition on which a benefit period may be established is met` TRUE FALSE TRUE FALSE FALSE
#ASSERT NOT `s 48(2) the second condition on which a benefit period may be established is met` TRUE TRUE FALSE FALSE FALSE
-- (3): no claim received, nothing is owed; received and decided and notified, done; decided but not notified, not done
#ASSERT `s 48(3) the Commission has done what it must on receiving the initial claim` FALSE FALSE FALSE
#ASSERT `s 48(3) the Commission has done what it must on receiving the initial claim` TRUE TRUE TRUE
#ASSERT NOT `s 48(3) the Commission has done what it must on receiving the initial claim` TRUE TRUE FALSE
#ASSERT NOT `s 48(3) the Commission has done what it must on receiving the initial claim` TRUE FALSE FALSE

§ `s 49 - proof for a week`

#ASSERT `s 49(1) the person has done what is needed to be entitled to receive benefits for the week` TRUE TRUE TRUE
#ASSERT NOT `s 49(1) the person has done what is needed to be entitled to receive benefits for the week` FALSE TRUE TRUE
#ASSERT NOT `s 49(1) the person has done what is needed to be entitled to receive benefits for the week` TRUE FALSE TRUE
#ASSERT NOT `s 49(1) the person has done what is needed to be entitled to receive benefits for the week` TRUE TRUE FALSE
-- (2) the benefit of the doubt: on a s 30 to 33 issue with the evidence equally balanced
#ASSERT `s 49(2) the claimant is given the benefit of the doubt on the issue` TRUE TRUE EQUALS JUST TRUE
-- the evidence is not equally balanced
#ASSERT `s 49(2) the claimant is given the benefit of the doubt on the issue` TRUE FALSE EQUALS NOTHING
-- some other issue
#ASSERT `s 49(2) the claimant is given the benefit of the doubt on the issue` FALSE TRUE EQUALS NOTHING
#ASSERT `s 49(3) the Commission has done what it must on receiving the claim for the week` FALSE FALSE FALSE
#ASSERT `s 49(3) the Commission has done what it must on receiving the claim for the week` TRUE TRUE TRUE
#ASSERT NOT `s 49(3) the Commission has done what it must on receiving the claim for the week` TRUE TRUE FALSE

§ `s 50 - the conditions and requirements`

-- (2) manner directed, and either the office that serves the area or another place directed
#ASSERT `s 50(2) the claim is made as directed at the proper place` TRUE TRUE FALSE
#ASSERT `s 50(2) the claim is made as directed at the proper place` TRUE FALSE TRUE
#ASSERT NOT `s 50(2) the claim is made as directed at the proper place` TRUE FALSE FALSE
#ASSERT NOT `s 50(2) the claim is made as directed at the proper place` FALSE TRUE FALSE
#ASSERT `s 50(3) the claim is made on the proper form` TRUE TRUE
#ASSERT NOT `s 50(3) the claim is made on the proper form` TRUE FALSE
#ASSERT NOT `s 50(3) the claim is made on the proper form` FALSE TRUE
-- (4) the last day for the week is Saturday 27 June 2026 (illustrative): the day itself is in time, the next day is not
#ASSERT `s 50(4) the claim for the week is made within the prescribed time` (YearMonthDay 2026 6 27) (YearMonthDay 2026 6 27)
#ASSERT `s 50(4) the claim for the week is made within the prescribed time` (YearMonthDay 2026 6 1) (YearMonthDay 2026 6 27)
#ASSERT NOT `s 50(4) the claim for the week is made within the prescribed time` (YearMonthDay 2026 6 28) (YearMonthDay 2026 6 27)
-- (5) to (8.1): met when not required, or required and complied with
#ASSERT `s 50(5) the requirement to provide additional information is met` FALSE FALSE
#ASSERT `s 50(5) the requirement to provide additional information is met` TRUE TRUE
#ASSERT NOT `s 50(5) the requirement to provide additional information is met` TRUE FALSE
#ASSERT `s 50(6) the requirement to attend in person is met` FALSE FALSE
#ASSERT `s 50(6) the requirement to attend in person is met` TRUE TRUE
#ASSERT NOT `s 50(6) the requirement to attend in person is met` TRUE FALSE
#ASSERT `s 50(7) the requirement to register for employment is met` FALSE FALSE
#ASSERT `s 50(7) the requirement to register for employment is met` TRUE TRUE
#ASSERT NOT `s 50(7) the requirement to register for employment is met` TRUE FALSE
#ASSERT `s 50(8) the requirement to prove efforts to obtain employment is met` FALSE FALSE
#ASSERT `s 50(8) the requirement to prove efforts to obtain employment is met` TRUE TRUE
#ASSERT NOT `s 50(8) the requirement to prove efforts to obtain employment is met` TRUE FALSE
#ASSERT `s 50(8.1) the requirement to provide an additional certificate is met` FALSE FALSE
#ASSERT `s 50(8.1) the requirement to provide an additional certificate is met` TRUE TRUE
#ASSERT NOT `s 50(8.1) the requirement to provide an additional certificate is met` TRUE FALSE
-- (9) the mailing address, "unless otherwise permitted by the Commission"
#ASSERT `s 50(9) the requirement to provide a mailing address is met` TRUE FALSE
#ASSERT `s 50(9) the requirement to provide a mailing address is met` FALSE TRUE
#ASSERT NOT `s 50(9) the requirement to provide a mailing address is met` FALSE FALSE
-- (10)
#ASSERT `s 50(10) the Commission may waive or vary a condition or requirement` TRUE
#ASSERT NOT `s 50(10) the Commission may waive or vary a condition or requirement` FALSE
-- (1) not entitled while any one condition or requirement is not met
#ASSERT NOT `s 50(1) the claimant is not entitled to receive benefits for as long as a condition or requirement is not met` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE
#ASSERT `s 50(1) the claimant is not entitled to receive benefits for as long as a condition or requirement is not met` FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE
#ASSERT `s 50(1) the claimant is not entitled to receive benefits for as long as a condition or requirement is not met` TRUE FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE
#ASSERT `s 50(1) the claimant is not entitled to receive benefits for as long as a condition or requirement is not met` TRUE TRUE FALSE TRUE TRUE TRUE TRUE TRUE TRUE
#ASSERT `s 50(1) the claimant is not entitled to receive benefits for as long as a condition or requirement is not met` TRUE TRUE TRUE FALSE TRUE TRUE TRUE TRUE TRUE
#ASSERT `s 50(1) the claimant is not entitled to receive benefits for as long as a condition or requirement is not met` TRUE TRUE TRUE TRUE FALSE TRUE TRUE TRUE TRUE
#ASSERT `s 50(1) the claimant is not entitled to receive benefits for as long as a condition or requirement is not met` TRUE TRUE TRUE TRUE TRUE FALSE TRUE TRUE TRUE
#ASSERT `s 50(1) the claimant is not entitled to receive benefits for as long as a condition or requirement is not met` TRUE TRUE TRUE TRUE TRUE TRUE FALSE TRUE TRUE
#ASSERT `s 50(1) the claimant is not entitled to receive benefits for as long as a condition or requirement is not met` TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE TRUE
#ASSERT `s 50(1) the claimant is not entitled to receive benefits for as long as a condition or requirement is not met` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE

§ `ss 51 to 53`

#ASSERT `s 51(a) the claimant and the employer are to be given an opportunity to provide information about the reasons for the loss of employment` TRUE
#ASSERT NOT `s 51(a) the claimant and the employer are to be given an opportunity to provide information about the reasons for the loss of employment` FALSE
#ASSERT `s 51(b) the Commission must take the information into account in determining the claim` TRUE TRUE
#ASSERT NOT `s 51(b) the Commission must take the information into account in determining the claim` TRUE FALSE
#ASSERT NOT `s 51(b) the Commission must take the information into account in determining the claim` FALSE TRUE
-- 52(1): benefits paid on 15 January 2024: 36 months on is 15 January 2027; 72 months on is 15 January 2030
#ASSERT `s 52(1) and (5) the Commission may reconsider the claim on the day` (YearMonthDay 2024 1 15) FALSE (YearMonthDay 2027 1 15)
#ASSERT NOT `s 52(1) and (5) the Commission may reconsider the claim on the day` (YearMonthDay 2024 1 15) FALSE (YearMonthDay 2027 1 16)
-- 52(5): a false or misleading statement in the Commission's opinion: 72 months
#ASSERT `s 52(1) and (5) the Commission may reconsider the claim on the day` (YearMonthDay 2024 1 15) TRUE (YearMonthDay 2027 1 16)
#ASSERT `s 52(1) and (5) the Commission may reconsider the claim on the day` (YearMonthDay 2024 1 15) TRUE (YearMonthDay 2030 1 15)
#ASSERT NOT `s 52(1) and (5) the Commission may reconsider the claim on the day` (YearMonthDay 2024 1 15) TRUE (YearMonthDay 2030 1 16)
-- 52(2)
#ASSERT `s 52(2) the Commission must calculate the amount of the money and notify the claimant of its decision` TRUE FALSE
#ASSERT `s 52(2) the Commission must calculate the amount of the money and notify the claimant of its decision` FALSE TRUE
#ASSERT NOT `s 52(2) the Commission must calculate the amount of the money and notify the claimant of its decision` FALSE FALSE
-- 52(3)
#ASSERT `s 52(3)(a) the amount calculated is repayable under section 43` TRUE EQUALS JUST TRUE
#ASSERT `s 52(3)(a) the amount calculated is repayable under section 43` FALSE EQUALS NOTHING
#ASSERT `s 52(3)(b) the day on which the liability arises for the purposes of subsection 47(3)` TRUE (YearMonthDay 2026 8 3) EQUALS JUST (YearMonthDay 2026 8 3)
#ASSERT `s 52(3)(b) the day on which the liability arises for the purposes of subsection 47(3)` FALSE (YearMonthDay 2026 8 3) EQUALS NOTHING
-- 52(4)
#ASSERT `s 52(4) the amount payable to the claimant` TRUE TRUE 640 EQUALS JUST 640
#ASSERT `s 52(4) the amount payable to the claimant` TRUE FALSE 640 EQUALS NOTHING
#ASSERT `s 52(4) the amount payable to the claimant` FALSE TRUE 640 EQUALS NOTHING
-- 53
#ASSERT `s 53 the person may be notified in that manner` TRUE TRUE
#ASSERT NOT `s 53 the person may be notified in that manner` TRUE FALSE
#ASSERT NOT `s 53 the person may be notified in that manner` FALSE TRUE
