#ASSERT `Must the Commission calculate the amount and tell me its decision` (YearMonthDay 2020 8 1) FALSE TRUE
#ASSERT NOT (`Must the Commission calculate the amount and tell me its decision` (YearMonthDay 2020 8 1) FALSE FALSE)
