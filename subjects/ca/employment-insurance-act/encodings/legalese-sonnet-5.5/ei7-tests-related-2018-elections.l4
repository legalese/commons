IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `ei7-related-nouns`
IMPORT `ei7-related-2018-elections`

-- Tests of ei7-related-2018-elections. Every expected value is written by hand from the text of 2018, c. 12, ss. 292 to
-- 295 (src:3841-3882); none is copied from the encoding's output. Dollar figures are the section's own ($75, $188, 40%).

§ `Section 292(2)`

#ASSERT `Act RP 2018 c. 12 s. 292(2) August 11, 2018` EQUALS YearMonthDay 2018 8 11

§ `Section 293(1) - who may elect`

-- all conditions met: eligible, no election before August 12, 2018, elects on August 12, last notification July 14, earnings and a claim.
#ASSERT `Act RP 2018 c. 12 s. 293(1) the claimant may make an election under subsection (2)` TRUE FALSE (YearMonthDay 2018 8 12) (YearMonthDay 2018 7 14) TRUE TRUE
-- "after August 11, 2018": an election made on August 11 is outside.
#ASSERT NOT (`Act RP 2018 c. 12 s. 293(1) the claimant may make an election under subsection (2)` TRUE FALSE (YearMonthDay 2018 8 11) (YearMonthDay 2018 7 14) TRUE TRUE)
-- "after July 13, 2018": a last notification on July 13 is outside, July 14 is inside.
#ASSERT NOT (`Act RP 2018 c. 12 s. 293(1) the claimant may make an election under subsection (2)` TRUE FALSE (YearMonthDay 2018 8 12) (YearMonthDay 2018 7 13) TRUE TRUE)
-- one of the other conditions fails in each of the next four.
#ASSERT NOT (`Act RP 2018 c. 12 s. 293(1) the claimant may make an election under subsection (2)` FALSE FALSE (YearMonthDay 2018 8 12) (YearMonthDay 2018 7 14) TRUE TRUE)
#ASSERT NOT (`Act RP 2018 c. 12 s. 293(1) the claimant may make an election under subsection (2)` TRUE TRUE (YearMonthDay 2018 8 12) (YearMonthDay 2018 7 14) TRUE TRUE)
#ASSERT NOT (`Act RP 2018 c. 12 s. 293(1) the claimant may make an election under subsection (2)` TRUE FALSE (YearMonthDay 2018 8 12) (YearMonthDay 2018 7 14) FALSE TRUE)
#ASSERT NOT (`Act RP 2018 c. 12 s. 293(1) the claimant may make an election under subsection (2)` TRUE FALSE (YearMonthDay 2018 8 12) (YearMonthDay 2018 7 14) TRUE FALSE)

§ `Sections 293(2) and 295(2) - the amount deducted`

-- below $188 the figure is $75.
#ASSERT `Act RP 2018 c. 12 s. 293(2) and s. 295(2) the amount of a week's earnings that is not deducted` 0 EQUALS 75
#ASSERT `Act RP 2018 c. 12 s. 293(2) and s. 295(2) the amount of a week's earnings that is not deducted` 187 EQUALS 75
#ASSERT `Act RP 2018 c. 12 s. 293(2) and s. 295(2) the amount of a week's earnings that is not deducted` 187.99 EQUALS 75
-- at $188 and above it is 40% of the rate: 40% of 188 is 75.2.
#ASSERT `Act RP 2018 c. 12 s. 293(2) and s. 295(2) the amount of a week's earnings that is not deducted` 188 EQUALS 75.2
#ASSERT `Act RP 2018 c. 12 s. 293(2) and s. 295(2) the amount of a week's earnings that is not deducted` 400 EQUALS 160
#ASSERT `Act RP 2018 c. 12 s. 293(2) and s. 295(2) the amount of a week's earnings that is not deducted` 1000 EQUALS 400
-- the amount of the earnings that exceeds the figure, and nothing when they do not exceed it.
#ASSERT `Act RP 2018 c. 12 s. 293(2) and s. 295(2) the amount of a week's earnings that is deducted` 100 187 EQUALS 25
#ASSERT `Act RP 2018 c. 12 s. 293(2) and s. 295(2) the amount of a week's earnings that is deducted` 75 187 EQUALS 0
#ASSERT `Act RP 2018 c. 12 s. 293(2) and s. 295(2) the amount of a week's earnings that is deducted` 50 187 EQUALS 0
#ASSERT `Act RP 2018 c. 12 s. 293(2) and s. 295(2) the amount of a week's earnings that is deducted` 100 188 EQUALS 24.8
#ASSERT `Act RP 2018 c. 12 s. 293(2) and s. 295(2) the amount of a week's earnings that is deducted` 75.2 188 EQUALS 0
#ASSERT `Act RP 2018 c. 12 s. 293(2) and s. 295(2) the amount of a week's earnings that is deducted` 500 400 EQUALS 340
#ASSERT `Act RP 2018 c. 12 s. 293(2) and s. 295(2) the amount of a week's earnings that is deducted` 160 400 EQUALS 0
#ASSERT `Act RP 2018 c. 12 s. 293(2) and s. 295(2) the amount of a week's earnings that is deducted` 0 400 EQUALS 0

§ `Section 293(2) - the election`

-- a claimant who may elect and does: earnings $100 on a rate of $187 leave $25 to be deducted.
#ASSERT `Act RP 2018 c. 12 s. 293(2) the amount of the week's earnings deducted under the election` TRUE FALSE (YearMonthDay 2018 8 12) (YearMonthDay 2018 7 14) TRUE TRUE TRUE 100 187 EQUALS JUST 25
-- may elect but does not: section 19(2) governs, which this section does not decide.
#ASSERT `Act RP 2018 c. 12 s. 293(2) the amount of the week's earnings deducted under the election` TRUE FALSE (YearMonthDay 2018 8 12) (YearMonthDay 2018 7 14) TRUE TRUE FALSE 100 187 EQUALS NOTHING
-- elects but is not a claimant to whom the section applies.
#ASSERT `Act RP 2018 c. 12 s. 293(2) the amount of the week's earnings deducted under the election` FALSE FALSE (YearMonthDay 2018 8 12) (YearMonthDay 2018 7 14) TRUE TRUE TRUE 100 187 EQUALS NOTHING

§ `Section 293(3) - telling the Commission`

-- 30 days after September 1, 2018 is October 1, 2018.
#ASSERT `Act RP 2018 c. 12 s. 293(3) the last day on which the claimant must inform the Commission of the election` (YearMonthDay 2018 9 1) EQUALS YearMonthDay 2018 10 1
-- 30 days after December 15, 2018 is January 14, 2019.
#ASSERT `Act RP 2018 c. 12 s. 293(3) the last day on which the claimant must inform the Commission of the election` (YearMonthDay 2018 12 15) EQUALS YearMonthDay 2019 1 14
#ASSERT `Act RP 2018 c. 12 s. 293(3) the claimant informs the Commission of the election in time` (YearMonthDay 2018 9 1) (YearMonthDay 2018 9 1)
#ASSERT `Act RP 2018 c. 12 s. 293(3) the claimant informs the Commission of the election in time` (YearMonthDay 2018 9 1) (YearMonthDay 2018 10 1)
#ASSERT NOT (`Act RP 2018 c. 12 s. 293(3) the claimant informs the Commission of the election in time` (YearMonthDay 2018 9 1) (YearMonthDay 2018 10 2))
-- the election is irrevocable.
#ASSERT `Act RP 2018 c. 12 s. 293(3) the claimant may revoke the election` TRUE EQUALS JUST FALSE
#ASSERT `Act RP 2018 c. 12 s. 293(3) the claimant may revoke the election` FALSE EQUALS NOTHING

§ `Section 293(4) - a late election`

-- informs the Commission on October 2, after the deadline of October 1: considered made by the deadline if good cause is shown.
#ASSERT `Act RP 2018 c. 12 s. 293(4) the late election is considered to have been made by the deadline` (YearMonthDay 2018 9 1) (YearMonthDay 2018 10 2) TRUE
#ASSERT NOT (`Act RP 2018 c. 12 s. 293(4) the late election is considered to have been made by the deadline` (YearMonthDay 2018 9 1) (YearMonthDay 2018 10 2) FALSE)
-- informing on the deadline itself is in time: subsection (4) does not speak to it.
#ASSERT NOT (`Act RP 2018 c. 12 s. 293(4) the late election is considered to have been made by the deadline` (YearMonthDay 2018 9 1) (YearMonthDay 2018 10 1) TRUE)
-- subsections (3) and (4) together.
#ASSERT `Act RP 2018 c. 12 s. 293(3), (4) the election is treated as made by the deadline` (YearMonthDay 2018 9 1) (YearMonthDay 2018 10 1) FALSE
#ASSERT `Act RP 2018 c. 12 s. 293(3), (4) the election is treated as made by the deadline` (YearMonthDay 2018 9 1) (YearMonthDay 2018 10 2) TRUE
#ASSERT NOT (`Act RP 2018 c. 12 s. 293(3), (4) the election is treated as made by the deadline` (YearMonthDay 2018 9 1) (YearMonthDay 2018 10 2) FALSE)

-- s. 293 closes the window by nothing but the 30th day and the good-cause test: told on October 1, 2026, eight years after a
-- last notification on September 1, 2018, the election is treated as made by the deadline if good cause is shown throughout.
#ASSERT `Act RP 2018 c. 12 s. 293(3), (4) the election is treated as made by the deadline` (YearMonthDay 2018 9 1) (YearMonthDay 2026 10 1) TRUE
#ASSERT NOT (`Act RP 2018 c. 12 s. 293(3), (4) the election is treated as made by the deadline` (YearMonthDay 2018 9 1) (YearMonthDay 2026 10 1) FALSE)

§ `Section 293(5) - no reconsideration`

#ASSERT `Act RP 2018 c. 12 s. 293(5) the decision of the Commission is subject to reconsideration under section 112` TRUE EQUALS JUST FALSE
#ASSERT `Act RP 2018 c. 12 s. 293(5) the decision of the Commission is subject to reconsideration under section 112` FALSE EQUALS NOTHING

§ `Section 294 - an earlier election deemed to apply`

-- August 12, 2018 is a Sunday and August 14, 2021 a Saturday: the period is whole weeks.
#ASSERT `s 2(1) the Sunday that begins the week containing` (YearMonthDay 2018 8 12) EQUALS YearMonthDay 2018 8 12
#ASSERT `s 2(1) the Saturday that ends the week containing` (YearMonthDay 2021 8 8) EQUALS YearMonthDay 2021 8 14
#ASSERT `Act RP 2018 c. 12 s. 294 August 14, 2021` EQUALS YearMonthDay 2021 8 14
-- an election made on August 11, 2018 applies to the week that begins on August 12, 2018 ...
#ASSERT `Act RP 2018 c. 12 s. 294 the earlier election is deemed to apply to the earnings received during the week` (YearMonthDay 2018 8 11) TRUE (YearMonthDay 2018 8 12)
-- ... not to the week before it.
#ASSERT NOT (`Act RP 2018 c. 12 s. 294 the earlier election is deemed to apply to the earnings received during the week` (YearMonthDay 2018 8 11) TRUE (YearMonthDay 2018 8 5))
-- the last week of the period begins on Sunday, August 8, 2021 and ends on August 14; the next week is outside.
#ASSERT `Act RP 2018 c. 12 s. 294 the earlier election is deemed to apply to the earnings received during the week` (YearMonthDay 2018 8 11) TRUE (YearMonthDay 2021 8 8)
#ASSERT NOT (`Act RP 2018 c. 12 s. 294 the earlier election is deemed to apply to the earnings received during the week` (YearMonthDay 2018 8 11) TRUE (YearMonthDay 2021 8 15))
-- an election made on August 12, 2018 is not one "made before August 12, 2018".
#ASSERT NOT (`Act RP 2018 c. 12 s. 294 the earlier election is deemed to apply to the earnings received during the week` (YearMonthDay 2018 8 12) TRUE (YearMonthDay 2019 1 6))
-- a week that is not in the benefit period.
#ASSERT NOT (`Act RP 2018 c. 12 s. 294 the earlier election is deemed to apply to the earnings received during the week` (YearMonthDay 2018 8 11) FALSE (YearMonthDay 2019 1 6))

§ `Section 295(1) - to whom it applies`

-- (a) a 77.98 election and a last notification after August 6, 2016.
#ASSERT `Act RP 2018 c. 12 s. 295(1) section 295 applies to the claimant` TRUE (YearMonthDay 2016 8 7) FALSE FALSE
#ASSERT NOT (`Act RP 2018 c. 12 s. 295(1) section 295 applies to the claimant` TRUE (YearMonthDay 2016 8 6) FALSE FALSE)
-- (b) a 77.991(2) election alone.
#ASSERT `Act RP 2018 c. 12 s. 295(1) section 295 applies to the claimant` FALSE (YearMonthDay 2016 8 1) TRUE FALSE
-- (c) a claimant who makes an election under section 293 alone.
#ASSERT `Act RP 2018 c. 12 s. 295(1) section 295 applies to the claimant` FALSE (YearMonthDay 2016 8 1) FALSE TRUE
#ASSERT NOT (`Act RP 2018 c. 12 s. 295(1) section 295 applies to the claimant` FALSE (YearMonthDay 2016 8 1) FALSE FALSE)

§ `Section 295(2) - the election`

-- a benefit period established on August 12, 2018 (after August 11, 2018), the week of Sunday, January 6, 2019: $25 to be deducted.
#ASSERT `Act RP 2018 c. 12 s. 295(2) the amount of the week's earnings deducted under the election` TRUE (YearMonthDay 2018 8 12) (YearMonthDay 2019 1 6) TRUE 100 187 EQUALS JUST 25
#ASSERT `Act RP 2018 c. 12 s. 295(2) the amount of the week's earnings deducted under the election` TRUE (YearMonthDay 2018 8 11) (YearMonthDay 2019 1 6) TRUE 100 187 EQUALS NOTHING
#ASSERT `Act RP 2018 c. 12 s. 295(2) the amount of the week's earnings deducted under the election` TRUE (YearMonthDay 2021 8 14) (YearMonthDay 2021 8 8) TRUE 100 187 EQUALS JUST 25
#ASSERT `Act RP 2018 c. 12 s. 295(2) the amount of the week's earnings deducted under the election` TRUE (YearMonthDay 2021 8 15) (YearMonthDay 2021 8 8) TRUE 100 187 EQUALS NOTHING
-- the week of Sunday, August 8, 2021 ends on Saturday, August 14: before August 15. The week of August 15 is not.
#ASSERT `Act RP 2018 c. 12 s. 295(2) the amount of the week's earnings deducted under the election` TRUE (YearMonthDay 2021 8 14) (YearMonthDay 2021 8 15) TRUE 100 187 EQUALS NOTHING
#ASSERT `Act RP 2018 c. 12 s. 295(2) the amount of the week's earnings deducted under the election` FALSE (YearMonthDay 2018 8 12) (YearMonthDay 2019 1 6) TRUE 100 187 EQUALS NOTHING
#ASSERT `Act RP 2018 c. 12 s. 295(2) the amount of the week's earnings deducted under the election` TRUE (YearMonthDay 2018 8 12) (YearMonthDay 2019 1 6) FALSE 100 187 EQUALS NOTHING
#ASSERT `Act RP 2018 c. 12 s. 295(2) the amount of the week's earnings deducted under the election` TRUE (YearMonthDay 2018 8 12) (YearMonthDay 2019 1 6) TRUE 100 188 EQUALS JUST 24.8

§ `Section 295(3) - telling the Commission`

-- the 30th day after February 1, 2022 is March 3, 2022, later than February 19, 2022: February 19 is the earlier.
#ASSERT `Act RP 2018 c. 12 s. 295(3) the last day on which the claimant must inform the Commission of the election` (YearMonthDay 2022 2 1) EQUALS YearMonthDay 2022 2 19
-- the 30th day after January 15, 2022 is February 14, 2022, the earlier.
#ASSERT `Act RP 2018 c. 12 s. 295(3) the last day on which the claimant must inform the Commission of the election` (YearMonthDay 2022 1 15) EQUALS YearMonthDay 2022 2 14
-- the 30th day after January 20, 2022 is February 19, 2022, the same day.
#ASSERT `Act RP 2018 c. 12 s. 295(3) the last day on which the claimant must inform the Commission of the election` (YearMonthDay 2022 1 20) EQUALS YearMonthDay 2022 2 19
-- a last notification issued on March 1, 2022: the 30th day after it is March 31, 2022, the earlier is February 19, 2022, a day
-- that had already passed when the notification was issued. The deadline then expired before the notification.
#ASSERT `Act RP 2018 c. 12 s. 295(3) the last day on which the claimant must inform the Commission of the election` (YearMonthDay 2022 3 1) EQUALS YearMonthDay 2022 2 19
#ASSERT NOT (`Act RP 2018 c. 12 s. 295(3) the claimant informs the Commission of the election in time` (YearMonthDay 2022 3 1) (YearMonthDay 2022 3 1))
#ASSERT `Act RP 2018 c. 12 s. 295(3) the claimant informs the Commission of the election in time` (YearMonthDay 2022 2 1) (YearMonthDay 2022 2 19)
#ASSERT NOT (`Act RP 2018 c. 12 s. 295(3) the claimant informs the Commission of the election in time` (YearMonthDay 2022 2 1) (YearMonthDay 2022 2 20))
#ASSERT `Act RP 2018 c. 12 s. 295(3) the claimant may revoke the election` TRUE EQUALS JUST FALSE
#ASSERT `Act RP 2018 c. 12 s. 295(3) the claimant may revoke the election` FALSE EQUALS NOTHING

§ `Section 295(4) and (5) - a late election and no reconsideration`

#ASSERT `Act RP 2018 c. 12 s. 295(4) the late election is considered to have been made by the deadline` (YearMonthDay 2022 2 1) (YearMonthDay 2022 2 20) TRUE
#ASSERT NOT (`Act RP 2018 c. 12 s. 295(4) the late election is considered to have been made by the deadline` (YearMonthDay 2022 2 1) (YearMonthDay 2022 2 20) FALSE)
#ASSERT NOT (`Act RP 2018 c. 12 s. 295(4) the late election is considered to have been made by the deadline` (YearMonthDay 2022 2 1) (YearMonthDay 2022 2 19) TRUE)
#ASSERT `Act RP 2018 c. 12 s. 295(3), (4) the election is treated as made by the deadline` (YearMonthDay 2022 2 1) (YearMonthDay 2022 2 19) FALSE
#ASSERT `Act RP 2018 c. 12 s. 295(3), (4) the election is treated as made by the deadline` (YearMonthDay 2022 2 1) (YearMonthDay 2022 2 20) TRUE
#ASSERT NOT (`Act RP 2018 c. 12 s. 295(3), (4) the election is treated as made by the deadline` (YearMonthDay 2022 2 1) (YearMonthDay 2022 2 20) FALSE)
#ASSERT `Act RP 2018 c. 12 s. 295(5) the decision of the Commission is subject to reconsideration under section 112` TRUE EQUALS JUST FALSE
#ASSERT `Act RP 2018 c. 12 s. 295(5) the decision of the Commission is subject to reconsideration under section 112` FALSE EQUALS NOTHING
