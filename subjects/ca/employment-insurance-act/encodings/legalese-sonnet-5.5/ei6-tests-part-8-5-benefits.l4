IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `eia-core-interpretation`
IMPORT `ei6-part-8-5-benefits`

-- Tests of ei6-part-8-5-benefits (Act ss 153.191 to 153.195, src:3014-3076). Expected values are read from the text
-- by hand. The first argument of most rules is "Part VIII.5 has not ceased to apply under section 153.196".

§ `Section 153.191 - waiting period`

#ASSERT `s 153.191(1) the last day on which a benefit period may begin for the waiting period to be waived` EQUALS YMD 2020 10 25
-- (1): Part I, VII.1 or VIII, and a benefit period beginning on or before October 25, 2020 (src:3014).
#ASSERT `s 153.191(1) the claimant need not serve a waiting period` TRUE `Part I` (YMD 2020 10 25)
#ASSERT NOT (`s 153.191(1) the claimant need not serve a waiting period` TRUE `Part I` (YMD 2020 10 26))
#ASSERT `s 153.191(1) the claimant need not serve a waiting period` TRUE `Part VII.1` (YMD 2020 9 1)
#ASSERT `s 153.191(1) the claimant need not serve a waiting period` TRUE `Part VIII` (YMD 2020 9 1)
#ASSERT NOT (`s 153.191(1) the claimant need not serve a waiting period` TRUE `Part II` (YMD 2020 9 1))
#ASSERT NOT (`s 153.191(1) the claimant need not serve a waiting period` FALSE `Part I` (YMD 2020 9 1))
-- (1.1): benefits under section 21 or 152.03 (src:3016).
#ASSERT `s 153.191(1.1) the claimant need not serve a waiting period` TRUE TRUE
#ASSERT NOT (`s 153.191(1.1) the claimant need not serve a waiting period` TRUE FALSE)
#ASSERT NOT (`s 153.191(1.1) the claimant need not serve a waiting period` FALSE TRUE)
-- (2): may nonetheless serve it if entitled to a payment in regulation 37(1) or 38(1) (src:3018).
#ASSERT `s 153.191(2) the claimant may nonetheless serve the waiting period` TRUE TRUE
#ASSERT NOT (`s 153.191(2) the claimant may nonetheless serve the waiting period` TRUE FALSE)
#ASSERT NOT (`s 153.191(2) the claimant may nonetheless serve the waiting period` FALSE TRUE)
-- (3): regulations 40(6) and 40.1(2) do not apply to a waiting period to which (1) applies (src:3020).
#ASSERT NOT (`s 153.191(3) subsections 40(6) and 40.1(2) of the Regulations apply to the waiting period` TRUE)
#ASSERT `s 153.191(3) subsections 40(6) and 40.1(2) of the Regulations apply to the waiting period` FALSE

§ `Section 153.192 - weekly insurable earnings of at least $909`

#ASSERT `s 153.192 the floor of the weekly insurable earnings` EQUALS 909
#ASSERT `s 153.192 the first day on which a benefit period begins for the floor to apply` EQUALS YMD 2020 9 27
-- (1): the greater of earnings divided by weeks, and $909 (src:3024-3026).
#ASSERT `s 153.192(1) the weekly insurable earnings of the claimant are deemed to be` TRUE (YMD 2020 9 27) 10000 10 EQUALS JUST 1000
#ASSERT `s 153.192(1) the weekly insurable earnings of the claimant are deemed to be` TRUE (YMD 2020 9 27) 8000 10 EQUALS JUST 909
#ASSERT `s 153.192(1) the weekly insurable earnings of the claimant are deemed to be` TRUE (YMD 2020 9 27) 9090 10 EQUALS JUST 909
#ASSERT `s 153.192(1) the weekly insurable earnings of the claimant are deemed to be` TRUE (YMD 2020 9 27) 9091 10 EQUALS JUST 909.1
-- a benefit period beginning September 20, 2020 is before the day; no week of insurable earnings is not answered; ceased.
#ASSERT `s 153.192(1) the weekly insurable earnings of the claimant are deemed to be` TRUE (YMD 2020 9 20) 10000 10 EQUALS NOTHING
#ASSERT `s 153.192(1) the weekly insurable earnings of the claimant are deemed to be` TRUE (YMD 2020 9 27) 10000 0 EQUALS NOTHING
#ASSERT `s 153.192(1) the weekly insurable earnings of the claimant are deemed to be` FALSE (YMD 2020 9 27) 10000 10 EQUALS NOTHING
-- (2): a self-employed person: the result of dividing by 52 is deemed to be $909 if it is less (src:3028).
#ASSERT `s 153.192(2) the result of dividing the aggregate by 52, for a self-employed person` TRUE (YMD 2020 9 27) 52000 EQUALS JUST 1000
#ASSERT `s 153.192(2) the result of dividing the aggregate by 52, for a self-employed person` TRUE (YMD 2020 9 27) 45032 EQUALS JUST 909
#ASSERT `s 153.192(2) the result of dividing the aggregate by 52, for a self-employed person` TRUE (YMD 2020 9 27) 47268 EQUALS JUST 909
#ASSERT `s 153.192(2) the result of dividing the aggregate by 52, for a self-employed person` TRUE (YMD 2020 9 20) 52000 EQUALS NOTHING
#ASSERT `s 153.192(2) the result of dividing the aggregate by 52, for a self-employed person` FALSE (YMD 2020 9 27) 52000 EQUALS NOTHING
-- (3): a fisher: the greater of the amount under paragraph 8.1(a) and $909 (src:3030).
#ASSERT `s 153.192(3) the weekly insurable earnings of the fisher are deemed to be` TRUE (YMD 2020 9 27) 1200 EQUALS JUST 1200
#ASSERT `s 153.192(3) the weekly insurable earnings of the fisher are deemed to be` TRUE (YMD 2020 9 27) 800 EQUALS JUST 909
#ASSERT `s 153.192(3) the weekly insurable earnings of the fisher are deemed to be` TRUE (YMD 2020 9 20) 800 EQUALS NOTHING

§ `Section 153.1921 - medical certificate`

#ASSERT `s 153.1921(1) the requirement to provide a medical certificate under subsection 40(1) of the Regulations is suspended` TRUE FALSE
#ASSERT NOT (`s 153.1921(1) the requirement to provide a medical certificate under subsection 40(1) of the Regulations is suspended` TRUE TRUE)
#ASSERT NOT (`s 153.1921(1) the requirement to provide a medical certificate under subsection 40(1) of the Regulations is suspended` FALSE FALSE)
#ASSERT `s 153.1921(2) the Commission may suspend the requirement to provide a medical certificate` TRUE TRUE
#ASSERT NOT (`s 153.1921(2) the Commission may suspend the requirement to provide a medical certificate` TRUE FALSE)
#ASSERT `s 153.1921(2) the requirement to provide a medical certificate is suspended for the claimant` TRUE TRUE TRUE
#ASSERT NOT (`s 153.1921(2) the requirement to provide a medical certificate is suspended for the claimant` TRUE TRUE FALSE)
#ASSERT NOT (`s 153.1921(2) the requirement to provide a medical certificate is suspended for the claimant` TRUE FALSE TRUE)

§ `Section 153.193 - exclusions from earnings`

-- (a): arguments: not ceased; the pay is in 36(8), (9) or (19); the first day of the benefit period; the day the pay is
-- declared; the first day of the week it would have been allocated to (src:3060-3063).
#ASSERT `s 153.193(a) the pay or earnings are excluded from the earnings referred to in section 35 of the Regulations` TRUE TRUE (YMD 2020 9 27) (YMD 2020 1 1) (YMD 2020 1 5)
#ASSERT `s 153.193(a) the pay or earnings are excluded from the earnings referred to in section 35 of the Regulations` TRUE TRUE (YMD 2020 9 20) (YMD 2020 9 27) (YMD 2020 9 27)
#ASSERT NOT (`s 153.193(a) the pay or earnings are excluded from the earnings referred to in section 35 of the Regulations` TRUE TRUE (YMD 2020 9 20) (YMD 2020 9 27) (YMD 2020 9 20))
#ASSERT NOT (`s 153.193(a) the pay or earnings are excluded from the earnings referred to in section 35 of the Regulations` TRUE TRUE (YMD 2020 9 20) (YMD 2020 9 26) (YMD 2020 9 27))
#ASSERT NOT (`s 153.193(a) the pay or earnings are excluded from the earnings referred to in section 35 of the Regulations` TRUE FALSE (YMD 2020 9 27) (YMD 2020 9 27) (YMD 2020 9 27))
#ASSERT NOT (`s 153.193(a) the pay or earnings are excluded from the earnings referred to in section 35 of the Regulations` FALSE TRUE (YMD 2020 9 27) (YMD 2020 9 27) (YMD 2020 9 27))
-- (b): arguments: not ceased; waiver under 153.191(1); first week; the kind; the payment; the normal weekly earnings (src:3064-3066).
#ASSERT `s 153.193(b) the portion of the payment that is excluded from the earnings referred to in section 35 of the Regulations` TRUE TRUE TRUE `ei6 a payment referred to in subsection 37(1) of the Regulations` 1000 1000 EQUALS JUST 950
#ASSERT `s 153.193(b) the portion of the payment that is excluded from the earnings referred to in section 35 of the Regulations` TRUE TRUE TRUE `ei6 a payment referred to in subsection 37(1) of the Regulations` 900 1000 EQUALS JUST 900
#ASSERT `s 153.193(b) the portion of the payment that is excluded from the earnings referred to in section 35 of the Regulations` TRUE TRUE TRUE `ei6 a payment referred to in subsection 38(1) of the Regulations` 1200 1000 EQUALS JUST 1000
#ASSERT `s 153.193(b) the portion of the payment that is excluded from the earnings referred to in section 35 of the Regulations` TRUE TRUE TRUE `ei6 a payment referred to in subsection 38(1) of the Regulations` 800 1000 EQUALS JUST 800
#ASSERT `s 153.193(b) the portion of the payment that is excluded from the earnings referred to in section 35 of the Regulations` TRUE FALSE TRUE `ei6 a payment referred to in subsection 37(1) of the Regulations` 1000 1000 EQUALS NOTHING
#ASSERT `s 153.193(b) the portion of the payment that is excluded from the earnings referred to in section 35 of the Regulations` TRUE TRUE FALSE `ei6 a payment referred to in subsection 37(1) of the Regulations` 1000 1000 EQUALS NOTHING
#ASSERT `s 153.193(b) the portion of the payment that is excluded from the earnings referred to in section 35 of the Regulations` FALSE TRUE TRUE `ei6 a payment referred to in subsection 37(1) of the Regulations` 1000 1000 EQUALS NOTHING

§ `Section 153.194 - employment for sections 30 to 33`

-- The qualifying period runs December 29, 2019 to December 26, 2020; the Sunday of paragraph 10(1)(a) is December 27, 2020;
-- twelve weeks (84 days) before it is October 4, 2020; the benefit period is December 27, 2020 to December 25, 2021.
-- An employment that ended on October 3, 2020 is not within; one that ended on October 4, 2020 is (src:3070-3072).
#ASSERT NOT (`s 153.194 the employment is employment for the purposes of sections 30 to 33` TRUE (`Period of days` OF (YMD 2020 1 1), (YMD 2020 10 3)) (`Period of days` OF (YMD 2019 12 29), (YMD 2020 12 26)) (`Period of days` OF (YMD 2020 12 27), (YMD 2021 12 25)) (YMD 2020 12 27))
#ASSERT `s 153.194 the employment is employment for the purposes of sections 30 to 33` TRUE (`Period of days` OF (YMD 2020 1 1), (YMD 2020 10 4)) (`Period of days` OF (YMD 2019 12 29), (YMD 2020 12 26)) (`Period of days` OF (YMD 2020 12 27), (YMD 2021 12 25)) (YMD 2020 12 27)
#ASSERT `s 153.194 the employment is employment for the purposes of sections 30 to 33` TRUE (`Period of days` OF (YMD 2020 11 1), (YMD 2020 12 20)) (`Period of days` OF (YMD 2019 12 29), (YMD 2020 12 26)) (`Period of days` OF (YMD 2020 12 27), (YMD 2021 12 25)) (YMD 2020 12 27)
-- within the benefit period
#ASSERT `s 153.194 the employment is employment for the purposes of sections 30 to 33` TRUE (`Period of days` OF (YMD 2021 1 4), (YMD 2021 2 1)) (`Period of days` OF (YMD 2019 12 29), (YMD 2020 12 26)) (`Period of days` OF (YMD 2020 12 27), (YMD 2021 12 25)) (YMD 2020 12 27)
-- long before the qualifying period
#ASSERT NOT (`s 153.194 the employment is employment for the purposes of sections 30 to 33` TRUE (`Period of days` OF (YMD 2018 1 1), (YMD 2019 6 30)) (`Period of days` OF (YMD 2019 12 29), (YMD 2020 12 26)) (`Period of days` OF (YMD 2020 12 27), (YMD 2021 12 25)) (YMD 2020 12 27))
-- a qualifying period that begins after the twelve-week bound: the qualifying period's own first day governs.
#ASSERT NOT (`s 153.194 the employment is employment for the purposes of sections 30 to 33` TRUE (`Period of days` OF (YMD 2020 6 1), (YMD 2020 10 31)) (`Period of days` OF (YMD 2020 11 1), (YMD 2021 10 30)) (`Period of days` OF (YMD 2021 11 7), (YMD 2022 11 5)) (YMD 2021 11 7))
-- the Part has ceased to apply
#ASSERT NOT (`s 153.194 the employment is employment for the purposes of sections 30 to 33` FALSE (`Period of days` OF (YMD 2020 11 1), (YMD 2020 12 20)) (`Period of days` OF (YMD 2019 12 29), (YMD 2020 12 26)) (`Period of days` OF (YMD 2020 12 27), (YMD 2021 12 25)) (YMD 2020 12 27))

§ `Section 153.195 - information`

#ASSERT `s 153.195 the Commission is not required to give the claimant and the employer the opportunity referred to in paragraph 51(a)` TRUE
#ASSERT NOT (`s 153.195 the Commission is not required to give the claimant and the employer the opportunity referred to in paragraph 51(a)` FALSE)
