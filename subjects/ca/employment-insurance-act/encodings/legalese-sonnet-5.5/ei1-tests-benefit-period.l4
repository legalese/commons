§ `s 10(8) the end of a benefit period (src:273-280)`
#ASSERT `ei1 the dates in` NOTHING EQUALS EMPTY
#ASSERT `ei1 the dates in` (JUST (YearMonthDay 2026 3 8)) EQUALS LIST (YearMonthDay 2026 3 8)
-- (d): the request, the new initial claim and the qualifying must all have happened; it is the later of the two days.
-- args: the day of the request, the day of the new initial claim, the claimant qualifies
#ASSERT `s 10(8)(d) the day on which the claimant requests the end of the benefit period, makes a new initial claim and qualifies` (JUST (YearMonthDay 2026 3 1)) (JUST (YearMonthDay 2026 3 8)) TRUE EQUALS JUST (YearMonthDay 2026 3 8)
#ASSERT `s 10(8)(d) the day on which the claimant requests the end of the benefit period, makes a new initial claim and qualifies` (JUST (YearMonthDay 2026 3 8)) (JUST (YearMonthDay 2026 3 1)) TRUE EQUALS JUST (YearMonthDay 2026 3 8)
#ASSERT `s 10(8)(d) the day on which the claimant requests the end of the benefit period, makes a new initial claim and qualifies` (JUST (YearMonthDay 2026 3 1)) (JUST (YearMonthDay 2026 3 8)) FALSE EQUALS NOTHING
#ASSERT `s 10(8)(d) the day on which the claimant requests the end of the benefit period, makes a new initial claim and qualifies` NOTHING (JUST (YearMonthDay 2026 3 8)) TRUE EQUALS NOTHING
#ASSERT `s 10(8)(d) the day on which the claimant requests the end of the benefit period, makes a new initial claim and qualifies` (JUST (YearMonthDay 2026 3 1)) NOTHING TRUE EQUALS NOTHING
-- the earliest of (a), (b) and (d)
-- args: the day no further benefits are payable, the day the benefit period would otherwise end, the day under (d)
#ASSERT `s 10(8) the day on which the benefit period ends` (JUST (YearMonthDay 2026 5 1)) (YearMonthDay 2026 10 24) (JUST (YearMonthDay 2026 4 1)) EQUALS YearMonthDay 2026 4 1
#ASSERT `s 10(8) the day on which the benefit period ends` (JUST (YearMonthDay 2026 5 1)) (YearMonthDay 2026 10 24) NOTHING EQUALS YearMonthDay 2026 5 1
#ASSERT `s 10(8) the day on which the benefit period ends` NOTHING (YearMonthDay 2026 10 24) NOTHING EQUALS YearMonthDay 2026 10 24
#ASSERT `s 10(8) the day on which the benefit period ends` (JUST (YearMonthDay 2027 1 1)) (YearMonthDay 2026 10 24) (JUST (YearMonthDay 2027 2 1)) EQUALS YearMonthDay 2026 10 24
#ASSERT `s 10(8) the day on which the benefit period ends` NOTHING (YearMonthDay 2026 10 24) (JUST (YearMonthDay 2026 6 6)) EQUALS YearMonthDay 2026 6 6

