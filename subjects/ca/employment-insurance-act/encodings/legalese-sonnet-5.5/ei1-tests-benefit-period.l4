IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `ei1-payment`
IMPORT `ei1-benefit-period`

-- Tests of ei1-benefit-period.l4 (Act ss 9, 10 and 11). Every expected value is written by hand from the text of the
-- section named beside the assertion; none is copied from the module's output. Weekdays were checked with a calendar
-- program that is not the encoding. One #ASSERT per line.

§ `s 9 establishing a benefit period (src:236)`
-- args: the insured person qualifies under section 7 or 7.1, makes an initial claim
#ASSERT `s 9 a benefit period shall be established` TRUE TRUE
#ASSERT NOT (`s 9 a benefit period shall be established` TRUE FALSE)
#ASSERT NOT (`s 9 a benefit period shall be established` FALSE TRUE)
-- args: a benefit period has been established, the week is a week of unemployment that falls in the benefit period
#ASSERT `s 9 benefits are payable to the person in accordance with Part I for the week` TRUE TRUE
#ASSERT NOT (`s 9 benefits are payable to the person in accordance with Part I for the week` FALSE TRUE)
#ASSERT NOT (`s 9 benefits are payable to the person in accordance with Part I for the week` TRUE FALSE)

§ `s 10(1) the first day of a benefit period (src:238-240)`
-- The interruption of earnings on Wednesday 2026-10-21 is in the week of Sunday 2026-10-18; a claim made on Monday
-- 2026-10-26 is in the week of Sunday 2026-10-25: the later Sunday begins the benefit period.
#ASSERT `s 10(1) the first day of the benefit period` (YearMonthDay 2026 10 21) (YearMonthDay 2026 10 26) EQUALS YearMonthDay 2026 10 25
#ASSERT `s 10(1) the first day of the benefit period` (YearMonthDay 2026 10 30) (YearMonthDay 2026 10 26) EQUALS YearMonthDay 2026 10 25
#ASSERT `s 10(1) the first day of the benefit period` (YearMonthDay 2026 10 21) (YearMonthDay 2026 11 1) EQUALS YearMonthDay 2026 11 1
#ASSERT `s 10(1) the first day of the benefit period` (YearMonthDay 2026 10 21) (YearMonthDay 2026 10 14) EQUALS YearMonthDay 2026 10 18
#ASSERT `s 10(1) the first day of the benefit period` (YearMonthDay 2026 10 18) (YearMonthDay 2026 10 11) EQUALS YearMonthDay 2026 10 18

§ `s 10(2) and s 10(3) the length, and no benefit period while another has not ended (src:242, 244)`
#ASSERT `s 10(2) the length of a benefit period in weeks, before any extension` EQUALS 52
#ASSERT `s 10(3) a benefit period shall not be established for the claimant` TRUE
#ASSERT NOT (`s 10(3) a benefit period shall not be established for the claimant` FALSE)
-- args: a benefit period shall be established under section 9, shall not be established because a prior one has not ended
#ASSERT `s 9 and s 10(3) a benefit period is established for the claimant` TRUE FALSE
#ASSERT NOT (`s 9 and s 10(3) a benefit period is established for the claimant` TRUE TRUE)
#ASSERT NOT (`s 9 and s 10(3) a benefit period is established for the claimant` FALSE FALSE)

