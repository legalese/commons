IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `ei2-nouns`
IMPORT `ei2-hours-methods`

-- Tests of ei2-hours-methods (s 55(2) to (4)). Expected values are written by hand from the text.

#ASSERT `s 55(2) the Commission may authorize an alternative method of establishing how many hours of insurable employment a person has` TRUE
#ASSERT NOT `s 55(2) the Commission may authorize an alternative method of establishing how many hours of insurable employment a person has` FALSE
#ASSERT `s 55(3) the Commission may alter the authorized method or rescind the authorization` TRUE
#ASSERT NOT `s 55(3) the Commission may alter the authorized method or rescind the authorization` FALSE
#ASSERT `s 55(4) the Commission may enter into the agreement` TRUE TRUE
#ASSERT NOT `s 55(4) the Commission may enter into the agreement` FALSE TRUE
#ASSERT NOT `s 55(4) the Commission may enter into the agreement` TRUE FALSE
#ASSERT `s 55(4) the Commission may rescind the agreement` TRUE
#ASSERT NOT `s 55(4) the Commission may rescind the agreement` FALSE
