IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `er2-teachers`

-- Tests of er2-teachers (regulation 33). Every expected value is written by hand from the text of the regulation named beside it and was
-- decided before the run. One #ASSERT per line.

§ `Regulation 33(1) - definitions`

-- "teaching": args: the occupation is teaching, pre-elementary, elementary, secondary, technical or vocational
#ASSERT     `reg 33(1) teaching` TRUE FALSE TRUE FALSE FALSE
#ASSERT     `reg 33(1) teaching` TRUE TRUE FALSE FALSE FALSE
#ASSERT     `reg 33(1) teaching` TRUE FALSE FALSE TRUE FALSE
#ASSERT     `reg 33(1) teaching` TRUE FALSE FALSE FALSE TRUE
#ASSERT NOT (`reg 33(1) teaching` TRUE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`reg 33(1) teaching` FALSE FALSE FALSE TRUE FALSE)
-- "non-teaching period": args: occurs annually at regular or irregular intervals, no work by a significant number of people employed in teaching
#ASSERT     `reg 33(1) non-teaching period` TRUE TRUE
#ASSERT NOT (`reg 33(1) non-teaching period` TRUE FALSE)
#ASSERT NOT (`reg 33(1) non-teaching period` FALSE TRUE)

§ `Regulation 33(2) - benefits payable under section 22, 23, 23.1, 23.2 or 23.3`

#ASSERT     `reg 33(2) the benefits are payable under section 22, 23, 23.1, 23.2 or 23.3 of the Act` `pregnancy`
#ASSERT     `reg 33(2) the benefits are payable under section 22, 23, 23.1, 23.2 or 23.3 of the Act` `caring for a new-born or adopted child`
#ASSERT     `reg 33(2) the benefits are payable under section 22, 23, 23.1, 23.2 or 23.3 of the Act` `care or support of a family member`
#ASSERT     `reg 33(2) the benefits are payable under section 22, 23, 23.1, 23.2 or 23.3 of the Act` `care or support of a critically ill child`
#ASSERT     `reg 33(2) the benefits are payable under section 22, 23, 23.1, 23.2 or 23.3 of the Act` `care or support of a critically ill adult`
-- sickness benefits are section 21, which regulation 33(2) does not except
#ASSERT NOT (`reg 33(2) the benefits are payable under section 22, 23, 23.1, 23.2 or 23.3 of the Act` `a prescribed illness, injury or quarantine`)
#ASSERT NOT (`reg 33(2) the benefits are payable under section 22, 23, 23.1, 23.2 or 23.3 of the Act` `a reason other than those mentioned in subsection 12(3)`)

§ `Regulation 33(2) - no benefits in a non-teaching period`

-- args: taught in the qualifying period, the week falls in a non-teaching period, reason for the benefits, (a) contract terminated, (b) casual or substitute, (c) qualifies in another occupation
#ASSERT     `reg 33(2) the claimant is not entitled to receive benefits for the week of unemployment` TRUE TRUE `a reason other than those mentioned in subsection 12(3)` FALSE FALSE FALSE
-- each exception (a), (b), (c) lifts the bar
#ASSERT NOT (`reg 33(2) the claimant is not entitled to receive benefits for the week of unemployment` TRUE TRUE `a reason other than those mentioned in subsection 12(3)` TRUE FALSE FALSE)
#ASSERT NOT (`reg 33(2) the claimant is not entitled to receive benefits for the week of unemployment` TRUE TRUE `a reason other than those mentioned in subsection 12(3)` FALSE TRUE FALSE)
#ASSERT NOT (`reg 33(2) the claimant is not entitled to receive benefits for the week of unemployment` TRUE TRUE `a reason other than those mentioned in subsection 12(3)` FALSE FALSE TRUE)
-- no teaching in the qualifying period, or a week outside any non-teaching period: the bar does not arise
#ASSERT NOT (`reg 33(2) the claimant is not entitled to receive benefits for the week of unemployment` FALSE TRUE `a reason other than those mentioned in subsection 12(3)` FALSE FALSE FALSE)
#ASSERT NOT (`reg 33(2) the claimant is not entitled to receive benefits for the week of unemployment` TRUE FALSE `a reason other than those mentioned in subsection 12(3)` FALSE FALSE FALSE)
-- the benefits of sections 22, 23, 23.1, 23.2 and 23.3 are not barred
#ASSERT NOT (`reg 33(2) the claimant is not entitled to receive benefits for the week of unemployment` TRUE TRUE `pregnancy` FALSE FALSE FALSE)
#ASSERT NOT (`reg 33(2) the claimant is not entitled to receive benefits for the week of unemployment` TRUE TRUE `caring for a new-born or adopted child` FALSE FALSE FALSE)
#ASSERT NOT (`reg 33(2) the claimant is not entitled to receive benefits for the week of unemployment` TRUE TRUE `care or support of a family member` FALSE FALSE FALSE)
#ASSERT NOT (`reg 33(2) the claimant is not entitled to receive benefits for the week of unemployment` TRUE TRUE `care or support of a critically ill child` FALSE FALSE FALSE)
#ASSERT NOT (`reg 33(2) the claimant is not entitled to receive benefits for the week of unemployment` TRUE TRUE `care or support of a critically ill adult` FALSE FALSE FALSE)
-- but sickness benefits ARE barred for a teacher in a non-teaching period (a finding: section 21 is not in the list)
#ASSERT     `reg 33(2) the claimant is not entitled to receive benefits for the week of unemployment` TRUE TRUE `a prescribed illness, injury or quarantine` FALSE FALSE FALSE

§ `Regulation 33(3) - the amount limited to the other occupation`

-- args: taught in the qualifying period, qualifies in another occupation, the week falls within a non-teaching period, the amount payable for the other occupation, the amount otherwise payable
#ASSERT `reg 33(3) the amount of benefits payable for the week of unemployment` TRUE TRUE TRUE 300 450 EQUALS 300
-- limited TO that amount, not raised to it: it cannot exceed what would otherwise be payable
#ASSERT `reg 33(3) the amount of benefits payable for the week of unemployment` TRUE TRUE TRUE 500 450 EQUALS 450
#ASSERT `reg 33(3) the amount of benefits payable for the week of unemployment` TRUE TRUE TRUE 450 450 EQUALS 450
-- one of the three conditions missing: no limit
#ASSERT `reg 33(3) the amount of benefits payable for the week of unemployment` TRUE FALSE TRUE 300 450 EQUALS 450
#ASSERT `reg 33(3) the amount of benefits payable for the week of unemployment` TRUE TRUE FALSE 300 450 EQUALS 450
#ASSERT `reg 33(3) the amount of benefits payable for the week of unemployment` FALSE TRUE TRUE 300 450 EQUALS 450
