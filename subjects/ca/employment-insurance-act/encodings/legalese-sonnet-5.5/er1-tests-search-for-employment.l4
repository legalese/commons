IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `er1-search-for-employment`

-- Tests of er1-search-for-employment (Employment Insurance Regulations, regs 9.001 to 9.004). Piece er1.
-- Every expected value is written by hand from the text of the Regulations (../../registers/source-bundle/SOR-96-332.txt), beside the assertion,
-- before the rule was run. The argument order is the order of the rule's GIVEN lines.

§ `Regulation 9.001(b) - the listed kinds of effort (src:136-145)`

-- arguments: assessing opportunities; resume or cover letter; registering for job tools or banks or agencies; workshops or job fairs; networking; contacting employers; applications; interviews; evaluations
#ASSERT `reg 9.001(b) the claimant's efforts consist of one or more of the listed kinds of effort` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE
#ASSERT `reg 9.001(b) the claimant's efforts consist of one or more of the listed kinds of effort` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE
#ASSERT `reg 9.001(b) the claimant's efforts consist of one or more of the listed kinds of effort` FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE
#ASSERT `reg 9.001(b) the claimant's efforts consist of one or more of the listed kinds of effort` FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE
#ASSERT `reg 9.001(b) the claimant's efforts consist of one or more of the listed kinds of effort` FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE
#ASSERT `reg 9.001(b) the claimant's efforts consist of one or more of the listed kinds of effort` FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE
#ASSERT `reg 9.001(b) the claimant's efforts consist of one or more of the listed kinds of effort` FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE
#ASSERT `reg 9.001(b) the claimant's efforts consist of one or more of the listed kinds of effort` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE
#ASSERT `reg 9.001(b) the claimant's efforts consist of one or more of the listed kinds of effort` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE
#ASSERT `reg 9.001(b) the claimant's efforts consist of one or more of the listed kinds of effort` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`reg 9.001(b) the claimant's efforts consist of one or more of the listed kinds of effort` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)   -- none of the nine kinds

§ `Regulation 9.001 - reasonable and customary efforts (src:134-146)`

-- arguments: efforts are sustained; efforts consist of the listed kinds; efforts are directed toward obtaining suitable employment
#ASSERT `reg 9.001 the claimant's efforts to obtain suitable employment are reasonable and customary efforts` TRUE TRUE TRUE
#ASSERT NOT (`reg 9.001 the claimant's efforts to obtain suitable employment are reasonable and customary efforts` FALSE TRUE TRUE)    -- (a) not sustained
#ASSERT NOT (`reg 9.001 the claimant's efforts to obtain suitable employment are reasonable and customary efforts` TRUE FALSE TRUE)    -- (b) none of the kinds
#ASSERT NOT (`reg 9.001 the claimant's efforts to obtain suitable employment are reasonable and customary efforts` TRUE TRUE FALSE)    -- (c) not directed toward suitable employment

§ `Regulation 9.002(1) - suitable employment (src:149-152)`

-- arguments: health allows commuting; health allows performing; hours clash with family obligations; hours clash with religious beliefs; nature of work is against moral convictions; nature of work is against religious beliefs
#ASSERT `reg 9.002(1) suitable employment` TRUE TRUE FALSE FALSE FALSE FALSE
#ASSERT NOT (`reg 9.002(1) suitable employment` FALSE TRUE FALSE FALSE FALSE FALSE)   -- (a) cannot commute to the place of work
#ASSERT NOT (`reg 9.002(1) suitable employment` TRUE FALSE FALSE FALSE FALSE FALSE)   -- (a) cannot perform the work
#ASSERT NOT (`reg 9.002(1) suitable employment` TRUE TRUE TRUE FALSE FALSE FALSE)     -- (b) hours incompatible with family obligations
#ASSERT NOT (`reg 9.002(1) suitable employment` TRUE TRUE FALSE TRUE FALSE FALSE)     -- (b) hours incompatible with religious beliefs
#ASSERT NOT (`reg 9.002(1) suitable employment` TRUE TRUE FALSE FALSE TRUE FALSE)     -- (c) contrary to moral convictions
#ASSERT NOT (`reg 9.002(1) suitable employment` TRUE TRUE FALSE FALSE FALSE TRUE)     -- (c) contrary to religious beliefs

§ `Regulations 9.002 and 9.003 and 9.004 - repealed (src:153-156)`

#ASSERT `reg 9.002(1)(d) to (f) repealed in this text` EQUALS "reg 9.002(1)(d) to (f): [Repealed, SOR/2016-162, s. 1]"
#ASSERT `reg 9.002(2) and (3) repealed in this text` EQUALS "reg 9.002(2) and (3): [Repealed, SOR/2017-27, s. 1]"
#ASSERT `reg 9.003 repealed in this text` EQUALS "reg 9.003: [Repealed, SOR/2016-162, s. 2]"
#ASSERT `reg 9.004 repealed in this text` EQUALS "reg 9.004: [Repealed, SOR/2016-162, s. 2]"
