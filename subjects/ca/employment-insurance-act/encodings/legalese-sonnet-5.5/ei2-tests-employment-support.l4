IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `ei2-nouns`
IMPORT `ei2-employment-support`

-- Tests of ei2-employment-support (Part II, ss 56 to 65.2). Expected values are written by hand from the text.

§ `s 56 - the purpose is carried as text`

-- The purpose clause decides nothing; it is a STRING and nothing reads it. This checks it is the text of the section.
#ASSERT `s 56 the purpose of Part II` EQUALS "56 The purpose of this Part is to help maintain a sustainable employment insurance system through the establishment of employment support measures and the maintenance of a national employment service."

§ `s 57 - guidelines, and working in concert`

-- (d.1) "availability of assistance in either official language where there is significant demand": bites only on demand.
#ASSERT `s 57(1)(d.1) assistance is available in either official language where there is significant demand` FALSE FALSE
#ASSERT `s 57(1)(d.1) assistance is available in either official language where there is significant demand` TRUE TRUE
#ASSERT NOT `s 57(1)(d.1) assistance is available in either official language where there is significant demand` TRUE FALSE
#ASSERT `s 57(1)(d.1) assistance is available in either official language where there is significant demand` FALSE TRUE
-- (e) commitment to (i) the goals and (ii) primary responsibility; (iii) sharing the cost only "if appropriate"
#ASSERT `s 57(1)(e) the commitment expected of persons receiving assistance is made` TRUE TRUE FALSE FALSE
#ASSERT `s 57(1)(e) the commitment expected of persons receiving assistance is made` TRUE TRUE TRUE TRUE
#ASSERT NOT `s 57(1)(e) the commitment expected of persons receiving assistance is made` TRUE TRUE TRUE FALSE
#ASSERT NOT `s 57(1)(e) the commitment expected of persons receiving assistance is made` FALSE TRUE FALSE FALSE
#ASSERT NOT `s 57(1)(e) the commitment expected of persons receiving assistance is made` TRUE FALSE FALSE FALSE
-- (1): every guideline: (a), (b), (c), (d), (d.1), (e), (f)
#ASSERT `s 57(1) the measures are established in accordance with the guidelines` TRUE TRUE TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT `s 57(1) the measures are established in accordance with the guidelines` FALSE TRUE TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT `s 57(1) the measures are established in accordance with the guidelines` TRUE FALSE TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT `s 57(1) the measures are established in accordance with the guidelines` TRUE TRUE FALSE TRUE TRUE TRUE TRUE
#ASSERT NOT `s 57(1) the measures are established in accordance with the guidelines` TRUE TRUE TRUE FALSE TRUE TRUE TRUE
#ASSERT NOT `s 57(1) the measures are established in accordance with the guidelines` TRUE TRUE TRUE TRUE FALSE TRUE TRUE
#ASSERT NOT `s 57(1) the measures are established in accordance with the guidelines` TRUE TRUE TRUE TRUE TRUE FALSE TRUE
#ASSERT NOT `s 57(1) the measures are established in accordance with the guidelines` TRUE TRUE TRUE TRUE TRUE TRUE FALSE
-- (2)
#ASSERT `s 57(2) the Commission has worked in concert and consulted as the Act requires` TRUE TRUE
#ASSERT NOT `s 57(2) the Commission has worked in concert and consulted as the Act requires` TRUE FALSE
#ASSERT NOT `s 57(2) the Commission has worked in concert and consulted as the Act requires` FALSE TRUE

§ `s 58 - insured participant`

-- An insured person (employed in insurable employment) who requests assistance, a benefit period is established: an insured participant.
#ASSERT `s 58 the person is an insured participant` TRUE FALSE TRUE TRUE NOTHING 0 NOTHING (YMD 2026 6 1) FALSE
-- no benefit period now, but one ended on 1 June 2021: 60 months on is 1 June 2026, and the 60th month counts
#ASSERT `s 58 the person is an insured participant` TRUE FALSE TRUE FALSE (JUST (YMD 2021 6 1)) 0 NOTHING (YMD 2026 6 1) FALSE
#ASSERT NOT `s 58 the person is an insured participant` TRUE FALSE TRUE FALSE (JUST (YMD 2021 6 1)) 0 NOTHING (YMD 2026 6 2) FALSE
-- paid employee's premiums that did not entitle them to a refund in at least 3 of the last 10 years: 3 is enough, 2 is not
#ASSERT `s 58 the person is an insured participant` TRUE FALSE TRUE FALSE NOTHING 3 NOTHING (YMD 2026 6 1) FALSE
#ASSERT NOT `s 58 the person is an insured participant` TRUE FALSE TRUE FALSE NOTHING 2 NOTHING (YMD 2026 6 1) FALSE
-- (b) in receipt of the emergency response benefit within the previous 60 months
#ASSERT `s 58 the person is an insured participant` TRUE FALSE TRUE FALSE NOTHING 0 (JUST (YMD 2022 3 31)) (YMD 2026 6 1) FALSE
#ASSERT NOT `s 58 the person is an insured participant` TRUE FALSE TRUE FALSE NOTHING 0 (JUST (YMD 2021 3 31)) (YMD 2026 6 1) FALSE
-- a benefit period that ends after the day of the request is not "within the previous 60 months"
#ASSERT NOT `s 58 the person is an insured participant` TRUE FALSE TRUE FALSE (JUST (YMD 2026 7 1)) 0 NOTHING (YMD 2026 6 1) FALSE
-- not an insured person (never employed in insurable employment)
#ASSERT NOT `s 58 the person is an insured participant` FALSE FALSE TRUE TRUE NOTHING 10 NOTHING (YMD 2026 6 1) TRUE
-- the regulation 76.11 adaptation (fork ei2-F12)
#ASSERT `s 58 the person is an insured participant` TRUE FALSE TRUE FALSE NOTHING 0 NOTHING (YMD 2026 6 1) TRUE
-- none of the routes
#ASSERT NOT `s 58 the person is an insured participant` TRUE FALSE TRUE FALSE NOTHING 0 NOTHING (YMD 2026 6 1) FALSE

§ `s 59 - establishing measures`

#ASSERT `s 59 the Commission may establish the employment support measure` TRUE
#ASSERT NOT `s 59 the Commission may establish the employment support measure` FALSE

§ `s 60 - the National Employment Service`

#ASSERT `s 60(1) the Commission has maintained the national employment service as the Act requires` TRUE TRUE
#ASSERT NOT `s 60(1) the Commission has maintained the national employment service as the Act requires` TRUE FALSE
#ASSERT NOT `s 60(1) the Commission has maintained the national employment service as the Act requires` FALSE TRUE
#ASSERT `s 60(2)(a) the Commission has collected and made available the information as the Act requires` TRUE TRUE
#ASSERT NOT `s 60(2)(a) the Commission has collected and made available the information as the Act requires` TRUE FALSE
#ASSERT NOT `s 60(2)(a) the Commission has collected and made available the information as the Act requires` FALSE TRUE
-- (b) a referral that discriminates on a prohibited ground is not as required; political affiliation likewise
#ASSERT NOT `s 60(2)(b) the referral is as the Act requires` TRUE FALSE FALSE FALSE
#ASSERT NOT `s 60(2)(b) the referral is as the Act requires` FALSE TRUE FALSE FALSE
-- no discrimination
#ASSERT `s 60(2)(b) the referral is as the Act requires` FALSE FALSE FALSE FALSE
-- a bona fide occupational requirement, or a special programme, may be given effect
#ASSERT `s 60(2)(b) the referral is as the Act requires` TRUE FALSE TRUE FALSE
#ASSERT `s 60(2)(b) the referral is as the Act requires` TRUE FALSE FALSE TRUE
#ASSERT `s 60(2)(b) the referral is as the Act requires` FALSE TRUE TRUE FALSE

§ `ss 61 to 64`

#ASSERT `s 61 the Commission may provide the financial assistance` TRUE TRUE
#ASSERT NOT `s 61 the Commission may provide the financial assistance` FALSE TRUE
#ASSERT NOT `s 61 the Commission may provide the financial assistance` TRUE FALSE
#ASSERT `s 62 the Commission may enter into the agreement or arrangement` TRUE TRUE
#ASSERT NOT `s 62 the Commission may enter into the agreement or arrangement` FALSE TRUE
#ASSERT NOT `s 62 the Commission may enter into the agreement or arrangement` TRUE FALSE
#ASSERT `s 63(1) the Commission may enter into the agreement to pay contributions` TRUE TRUE TRUE FALSE
#ASSERT `s 63(1) the Commission may enter into the agreement to pay contributions` TRUE TRUE FALSE TRUE
#ASSERT NOT `s 63(1) the Commission may enter into the agreement to pay contributions` TRUE TRUE FALSE FALSE
#ASSERT NOT `s 63(1) the Commission may enter into the agreement to pay contributions` FALSE TRUE TRUE TRUE
#ASSERT NOT `s 63(1) the Commission may enter into the agreement to pay contributions` TRUE FALSE TRUE TRUE
-- 64: a decision in relation to a measure, not under s 65.1: no review under s 112
#ASSERT `s 64 the decision is not subject to review under section 112` TRUE FALSE EQUALS JUST TRUE
-- a decision under s 65.1 is excepted: the section says nothing about it
#ASSERT `s 64 the decision is not subject to review under section 112` TRUE TRUE EQUALS NOTHING
-- a decision not about employment support measures
#ASSERT `s 64 the decision is not subject to review under section 112` FALSE FALSE EQUALS NOTHING

§ `s 65 and s 65.1`

#ASSERT `s 65 the amount the person is liable to repay` 1000 0 0 EQUALS 1000
#ASSERT `s 65 the amount the person is liable to repay` 1000 250 80 EQUALS 1330
#ASSERT `s 65 the amount the person is liable to repay` 0 0 0 EQUALS 0
-- 65.1(1)
#ASSERT `s 65.1(1) the Commission may impose a penalty on the person` TRUE TRUE TRUE FALSE FALSE
#ASSERT `s 65.1(1) the Commission may impose a penalty on the person` TRUE TRUE FALSE TRUE FALSE
#ASSERT `s 65.1(1) the Commission may impose a penalty on the person` TRUE TRUE FALSE FALSE TRUE
#ASSERT NOT `s 65.1(1) the Commission may impose a penalty on the person` TRUE TRUE FALSE FALSE FALSE
#ASSERT NOT `s 65.1(1) the Commission may impose a penalty on the person` TRUE FALSE TRUE TRUE TRUE
#ASSERT NOT `s 65.1(1) the Commission may impose a penalty on the person` FALSE TRUE TRUE TRUE TRUE
-- 65.1(2) not more than the amount of the financial assistance provided
#ASSERT `s 65.1(2) the most the Commission may set as the amount of the penalty` 4000 EQUALS 4000
-- 65.1(3) act on 15 January 2020; 36 months on is 15 January 2023
#ASSERT NOT `s 65.1(3) the penalty shall not be imposed` FALSE (YMD 2020 1 15) (YMD 2023 1 15)
#ASSERT `s 65.1(3) the penalty shall not be imposed` FALSE (YMD 2020 1 15) (YMD 2023 1 16)
#ASSERT `s 65.1(3) the penalty shall not be imposed` TRUE (YMD 2020 1 15) (YMD 2021 1 1)
-- 65.1(4)
#ASSERT `s 65.1(4) the Commission may rescind the imposition of the penalty, or reduce it` TRUE FALSE
#ASSERT `s 65.1(4) the Commission may rescind the imposition of the penalty, or reduce it` FALSE TRUE
#ASSERT NOT `s 65.1(4) the Commission may rescind the imposition of the penalty, or reduce it` FALSE FALSE

§ `s 65.2`

#ASSERT `s 65.2(1) the amount is a debt due to Her Majesty` TRUE EQUALS JUST TRUE
#ASSERT `s 65.2(1) the amount is a debt due to Her Majesty` FALSE EQUALS NOTHING
#ASSERT `s 65.2(2) the indebtedness may be recovered out of the amount payable` TRUE TRUE
#ASSERT NOT `s 65.2(2) the indebtedness may be recovered out of the amount payable` TRUE FALSE
#ASSERT NOT `s 65.2(2) the indebtedness may be recovered out of the amount payable` FALSE TRUE
-- (3) liability arose on 1 March 2020; 72 months on is 1 March 2026
#ASSERT `s 65.2(3) the amount may still be recovered` (YMD 2020 3 1) (YMD 2026 3 1)
#ASSERT NOT `s 65.2(3) the amount may still be recovered` (YMD 2020 3 1) (YMD 2026 3 2)
-- an insured person is also one who HAS BEEN employed in insurable employment (the keel's `s 2(1) insured person`)
#ASSERT `s 58 the person is an insured participant` FALSE TRUE TRUE TRUE NOTHING 0 NOTHING (YMD 2026 6 1) FALSE
-- an insured person who does not request assistance under an employment support measure
#ASSERT NOT `s 58 the person is an insured participant` TRUE FALSE FALSE TRUE NOTHING 0 NOTHING (YMD 2026 6 1) FALSE
