IMPORT prelude
IMPORT daydate
IMPORT `eia-core`

-- Tests for eia-core.l4. Every expected value is written by hand from the text or from the calendar,
-- never copied from the output of the rule under test.
-- 2026-10-25 is a Sunday (the calendar says so); 2026-10-24 is the Saturday before and 2026-10-26 the Monday after.

§ `The date shim`

#ASSERT (YMD 2026 1 1) AT MOST (YMD 2026 1 2)
#ASSERT (YMD 2026 1 1) EQUALS (YMD 2026 1 1)
#ASSERT (YMD 2026 1 1) PLUS 1 EQUALS (YMD 2026 1 2)

§ `Weeks begin on Sunday - s 2(1)`

-- A Sunday is its own week's Sunday.
#ASSERT `s 2(1) the Sunday that begins the week containing` (YMD 2026 10 25) EQUALS YMD 2026 10 25
-- The Saturday before belongs to the week that began on Sunday the 18th.
#ASSERT `s 2(1) the Sunday that begins the week containing` (YMD 2026 10 24) EQUALS YMD 2026 10 18
-- The Monday after belongs to the week that began the day before.
#ASSERT `s 2(1) the Sunday that begins the week containing` (YMD 2026 10 26) EQUALS YMD 2026 10 25
-- A week is seven consecutive days: it ends on the Saturday six days after the Sunday.
#ASSERT `s 2(1) the Saturday that ends the week containing` (YMD 2026 10 25) EQUALS YMD 2026 10 31
#ASSERT `s 2(1) the Saturday that ends the week containing` (YMD 2026 10 31) EQUALS YMD 2026 10 31
-- Across a month and a year boundary: Thursday 1 January 2026 sits in the week that began Sunday 28 December 2025.
#ASSERT `s 2(1) the Sunday that begins the week containing` (YMD 2026 1 1) EQUALS YMD 2025 12 28

§ `A year is a calendar year - s 2(1)`

#ASSERT `s 2(1) the year containing` (YMD 2026 10 25) EQUALS 2026
#ASSERT `s 2(1) the year containing` (YMD 2025 12 31) EQUALS 2025

§ `Time limits`

#ASSERT `weeks as days` 4 EQUALS 28
#ASSERT `weeks as days` 52 EQUALS 364
#ASSERT `the last day of` 14 `days after` (YMD 2026 1 1) EQUALS YMD 2026 1 15

§ `Periods of days`

#ASSERT `the number of days in` (`Period of days` OF YMD 2026 1 1, YMD 2026 1 31) EQUALS 31
#ASSERT `the number of days in` (`Period of days` OF YMD 2026 3 15, YMD 2026 3 15) EQUALS 1
#ASSERT `the day` (YMD 2026 1 31) `falls within` (`Period of days` OF YMD 2026 1 1, YMD 2026 1 31)
#ASSERT `the day` (YMD 2026 1 1) `falls within` (`Period of days` OF YMD 2026 1 1, YMD 2026 1 31)
#ASSERT NOT (`the day` (YMD 2026 2 1) `falls within` (`Period of days` OF YMD 2026 1 1, YMD 2026 1 31))
#ASSERT NOT (`the day` (YMD 2025 12 31) `falls within` (`Period of days` OF YMD 2026 1 1, YMD 2026 1 31))

§ `Rounding to the nearest dollar, half up - s 6(2) and s 152.01(5)`

#ASSERT `s 6(2) and s 152.01(5) amount rounded to the nearest dollar` 2.5 EQUALS 3
#ASSERT `s 6(2) and s 152.01(5) amount rounded to the nearest dollar` 2.49 EQUALS 2
#ASSERT `s 6(2) and s 152.01(5) amount rounded to the nearest dollar` 6199.5 EQUALS 6200
#ASSERT `s 6(2) and s 152.01(5) amount rounded to the nearest dollar` 0.5 EQUALS 1
#ASSERT `s 6(2) and s 152.01(5) amount rounded to the nearest dollar` 700 EQUALS 700

§ `Rate bands - Schedule I`

-- Every boundary: the band is "not more than" its upper figure, so the figure itself belongs to the lower band.
#ASSERT `the band of the regional rate of unemployment` (0%) EQUALS `6% and under`
#ASSERT `the band of the regional rate of unemployment` (6%) EQUALS `6% and under`
#ASSERT `the band of the regional rate of unemployment` (6.01%) EQUALS `more than 6% but not more than 7%`
#ASSERT `the band of the regional rate of unemployment` (7%) EQUALS `more than 6% but not more than 7%`
#ASSERT `the band of the regional rate of unemployment` (7.5%) EQUALS `more than 7% but not more than 8%`
#ASSERT `the band of the regional rate of unemployment` (13%) EQUALS `more than 12% but not more than 13%`
#ASSERT `the band of the regional rate of unemployment` (13.01%) EQUALS `more than 13% but not more than 14%`
#ASSERT `the band of the regional rate of unemployment` (16%) EQUALS `more than 15% but not more than 16%`
#ASSERT `the band of the regional rate of unemployment` (16.01%) EQUALS `more than 16%`
#ASSERT `the band of the regional rate of unemployment` (25%) EQUALS `more than 16%`
#ASSERT `the number of the band` (`the band of the regional rate of unemployment` (6%)) EQUALS 1
#ASSERT `the number of the band` (`the band of the regional rate of unemployment` (13%)) EQUALS 8
#ASSERT `the number of the band` (`the band of the regional rate of unemployment` (13.01%)) EQUALS 9
#ASSERT `the number of the band` (`the band of the regional rate of unemployment` (16.01%)) EQUALS 12
