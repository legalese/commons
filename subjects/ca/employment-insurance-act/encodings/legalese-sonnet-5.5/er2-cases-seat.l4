-- Args: natural disaster at work, a day in the week, apprenticeship course, disruption of services.
-- a week in Christmas week 2026 (Sunday 20 to Saturday 26 December)
#ASSERT     `May the Commission pay my benefits for this week before the usual time` FALSE (YMD 2026 12 22) FALSE FALSE
#ASSERT NOT (`May the Commission pay my benefits for this week before the usual time` FALSE (YMD 2026 3 4) FALSE FALSE)
#ASSERT     `May the Commission pay my benefits for this week before the usual time` TRUE (YMD 2026 3 4) FALSE FALSE
