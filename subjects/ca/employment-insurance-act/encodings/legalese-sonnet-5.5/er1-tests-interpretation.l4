IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `er1-interpretation`

-- Tests of er1-interpretation (Employment Insurance Regulations, reg 1). Piece er1.
-- Every expected value is written by hand from the text of the Regulations (../../registers/source-bundle/SOR-96-332.txt), beside the assertion,
-- before the rule was run. The argument order is the order of the rule's GIVEN lines; each group says what the
-- positions are.

§ `Regulation 1(1) - pay period (src:14)`

-- arguments: the person is an insured person; earnings are paid to the person in respect of the period; earnings are enjoyed by the person in respect of the period
#ASSERT `reg 1(1) pay period` TRUE TRUE FALSE        -- earnings paid to an insured person: a pay period
#ASSERT `reg 1(1) pay period` TRUE FALSE TRUE        -- earnings enjoyed by an insured person: a pay period
#ASSERT `reg 1(1) pay period` TRUE TRUE TRUE         -- both
#ASSERT NOT (`reg 1(1) pay period` TRUE FALSE FALSE) -- earnings neither paid nor enjoyed: not a pay period
#ASSERT NOT (`reg 1(1) pay period` FALSE TRUE TRUE)  -- not an insured person: not a pay period

§ `Regulation 1(1) - self-employed person, other than in sections 30 and 35 (src:15)`

-- arguments: the word is used in section 30 or section 35; the individual is a self-employed person within the meaning of subsection 152.01(1)
#ASSERT `reg 1(1) self-employed person, other than in sections 30 and 35` FALSE TRUE EQUALS JUST TRUE    -- elsewhere: the Act's meaning
#ASSERT `reg 1(1) self-employed person, other than in sections 30 and 35` FALSE FALSE EQUALS JUST FALSE   -- elsewhere, not within the Act's meaning
#ASSERT `reg 1(1) self-employed person, other than in sections 30 and 35` TRUE TRUE EQUALS NOTHING       -- regs 30 and 35 define the word themselves: not decided here
#ASSERT `reg 1(1) self-employed person, other than in sections 30 and 35` TRUE FALSE EQUALS NOTHING

§ `Regulation 1(2) - international organization (src:16-18)`

-- arguments: specialized agency of which Canada is a member; brought into relationship with the UN under article 63; international organization of which Canada is a member; purpose is peace; purpose is economic or social well-being
#ASSERT `reg 1(2) international organization` TRUE TRUE FALSE FALSE FALSE      -- (a) a United Nations specialized agency
#ASSERT NOT (`reg 1(2) international organization` TRUE FALSE FALSE FALSE FALSE) -- an agency not brought into relationship with the UN is not within (a)
#ASSERT `reg 1(2) international organization` FALSE FALSE TRUE TRUE FALSE        -- (b) member organization whose primary purpose is peace
#ASSERT `reg 1(2) international organization` FALSE FALSE TRUE FALSE TRUE        -- (b) member organization whose primary purpose is economic or social well-being
#ASSERT NOT (`reg 1(2) international organization` FALSE FALSE TRUE FALSE FALSE) -- (b) member organization with neither purpose
#ASSERT NOT (`reg 1(2) international organization` FALSE FALSE FALSE TRUE TRUE)  -- (b) an organization Canada is not a member of

§ `Regulation 1(3) - family member (src:19-37)`

-- One field per paragraph (a) to (q); each assertion sets exactly one to TRUE (ruler: a b c d e f g h i j k l m n o p q).
`er1 test: only paragraph (a)` MEANS `er1 Relationship to an individual` OF TRUE,  FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`er1 test: only paragraph (b)` MEANS `er1 Relationship to an individual` OF FALSE, TRUE,  FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`er1 test: only paragraph (c)` MEANS `er1 Relationship to an individual` OF FALSE, FALSE, TRUE,  FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`er1 test: only paragraph (d)` MEANS `er1 Relationship to an individual` OF FALSE, FALSE, FALSE, TRUE,  FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`er1 test: only paragraph (e)` MEANS `er1 Relationship to an individual` OF FALSE, FALSE, FALSE, FALSE, TRUE,  FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`er1 test: only paragraph (f)` MEANS `er1 Relationship to an individual` OF FALSE, FALSE, FALSE, FALSE, FALSE, TRUE,  FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`er1 test: only paragraph (g)` MEANS `er1 Relationship to an individual` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE,  FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`er1 test: only paragraph (h)` MEANS `er1 Relationship to an individual` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE,  FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`er1 test: only paragraph (i)` MEANS `er1 Relationship to an individual` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE,  FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`er1 test: only paragraph (j)` MEANS `er1 Relationship to an individual` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE,  FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`er1 test: only paragraph (k)` MEANS `er1 Relationship to an individual` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE,  FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`er1 test: only paragraph (l)` MEANS `er1 Relationship to an individual` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE,  FALSE, FALSE, FALSE, FALSE, FALSE
`er1 test: only paragraph (m)` MEANS `er1 Relationship to an individual` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE,  FALSE, FALSE, FALSE, FALSE
`er1 test: only paragraph (n)` MEANS `er1 Relationship to an individual` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE,  FALSE, FALSE, FALSE
`er1 test: only paragraph (o)` MEANS `er1 Relationship to an individual` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE,  FALSE, FALSE
`er1 test: only paragraph (p)` MEANS `er1 Relationship to an individual` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE,  FALSE
`er1 test: only paragraph (q)` MEANS `er1 Relationship to an individual` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE
`er1 test: no paragraph` MEANS `er1 Relationship to an individual` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`er1 test: paragraphs (a) and (q)` MEANS `er1 Relationship to an individual` OF TRUE,  FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE

#ASSERT `reg 1(3) family member` `er1 test: only paragraph (a)`   -- a spouse or common-law partner
#ASSERT `reg 1(3) family member` `er1 test: only paragraph (b)`   -- a child of the individual or of the individual's spouse
#ASSERT `reg 1(3) family member` `er1 test: only paragraph (c)`   -- a parent, or a parent's spouse
#ASSERT `reg 1(3) family member` `er1 test: only paragraph (d)`   -- a brother or sister (child of the individual's parent)
#ASSERT `reg 1(3) family member` `er1 test: only paragraph (e)`   -- a grandparent
#ASSERT `reg 1(3) family member` `er1 test: only paragraph (f)`   -- a grandchild
#ASSERT `reg 1(3) family member` `er1 test: only paragraph (g)`   -- a child's spouse
#ASSERT `reg 1(3) family member` `er1 test: only paragraph (h)`   -- a spouse's parent
#ASSERT `reg 1(3) family member` `er1 test: only paragraph (i)`   -- the spouse of a brother or sister
#ASSERT `reg 1(3) family member` `er1 test: only paragraph (j)`   -- a child of a parent of the individual's spouse
#ASSERT `reg 1(3) family member` `er1 test: only paragraph (k)`   -- an uncle or aunt
#ASSERT `reg 1(3) family member` `er1 test: only paragraph (l)`   -- a nephew or niece
#ASSERT `reg 1(3) family member` `er1 test: only paragraph (m)`   -- a current or former foster parent
#ASSERT `reg 1(3) family member` `er1 test: only paragraph (n)`   -- a current or former foster child
#ASSERT `reg 1(3) family member` `er1 test: only paragraph (o)`   -- a current or former ward
#ASSERT `reg 1(3) family member` `er1 test: only paragraph (p)`   -- a current or former guardian
#ASSERT `reg 1(3) family member` `er1 test: only paragraph (q)`   -- someone considered like a close relative, related or not
#ASSERT `reg 1(3) family member` `er1 test: paragraphs (a) and (q)` -- falling within several paragraphs is still one family member
#ASSERT NOT (`reg 1(3) family member` `er1 test: no paragraph`)  -- a person who fits no paragraph is not a family member

§ `Regulation 1(3) - nurse practitioner (src:38)`

-- arguments: registered nurse; entitled to practise as a nurse practitioner or equivalent; make diagnoses; order and interpret tests; prescribe; treat
#ASSERT `reg 1(3) nurse practitioner` TRUE TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`reg 1(3) nurse practitioner` FALSE TRUE TRUE TRUE TRUE TRUE)   -- not a registered nurse
#ASSERT NOT (`reg 1(3) nurse practitioner` TRUE FALSE TRUE TRUE TRUE TRUE)   -- not entitled to practise as a nurse practitioner
#ASSERT NOT (`reg 1(3) nurse practitioner` TRUE TRUE FALSE TRUE TRUE TRUE)   -- cannot make diagnoses autonomously
#ASSERT NOT (`reg 1(3) nurse practitioner` TRUE TRUE TRUE FALSE TRUE TRUE)   -- cannot order and interpret tests
#ASSERT NOT (`reg 1(3) nurse practitioner` TRUE TRUE TRUE TRUE FALSE TRUE)   -- cannot prescribe substances
#ASSERT NOT (`reg 1(3) nurse practitioner` TRUE TRUE TRUE TRUE TRUE FALSE)   -- cannot treat patients

§ `Regulation 1(4) - guardian and ward (src:39)`

-- arguments of guardian: authorized for a minor; authorized for an incapable adult; a tutor; a curator; a mandatary under a protection mandate; appointed in a similar capacity
#ASSERT `reg 1(4) guardian` TRUE FALSE FALSE FALSE FALSE FALSE
#ASSERT `reg 1(4) guardian` FALSE TRUE FALSE FALSE FALSE FALSE
#ASSERT `reg 1(4) guardian` FALSE FALSE TRUE FALSE FALSE FALSE     -- "includes a tutor"
#ASSERT `reg 1(4) guardian` FALSE FALSE FALSE TRUE FALSE FALSE     -- "includes ... curator"
#ASSERT `reg 1(4) guardian` FALSE FALSE FALSE FALSE TRUE FALSE     -- "includes ... mandatary acting under a protection mandate"
#ASSERT `reg 1(4) guardian` FALSE FALSE FALSE FALSE FALSE TRUE     -- "includes ... any person who is appointed to act in a similar capacity"
#ASSERT NOT (`reg 1(4) guardian` FALSE FALSE FALSE FALSE FALSE FALSE)
#ASSERT `reg 1(4) ward` TRUE
#ASSERT NOT (`reg 1(4) ward` FALSE)

§ `Regulation 1(5) - care and support (src:40-42)`

-- arguments of care: the person needing it is a family member / critically ill child / adult; required because of the state of health; provided by a health care professional
#ASSERT `reg 1(5) care` TRUE TRUE FALSE
#ASSERT NOT (`reg 1(5) care` TRUE TRUE TRUE)     -- "other than the care provided by a health care professional"
#ASSERT NOT (`reg 1(5) care` TRUE FALSE FALSE)   -- not required because of the state of health
#ASSERT NOT (`reg 1(5) care` FALSE TRUE FALSE)   -- for someone who is none of the three
-- arguments of support: the person needing it is ...; required because of the state of health
#ASSERT `reg 1(5) support` TRUE TRUE
#ASSERT NOT (`reg 1(5) support` TRUE FALSE)
#ASSERT NOT (`reg 1(5) support` FALSE TRUE)

§ `Regulation 1(6) and (7) - critically ill child and critically ill adult (src:43-46)`

-- arguments of both: date of birth; the day the period begins; baseline state of health has significantly changed; life is at risk
#ASSERT `reg 1(6) critically ill child` (YMD 2012 3 15) (YMD 2026 10 1) TRUE TRUE      -- 14 years old on the day: a child
#ASSERT NOT (`reg 1(7) critically ill adult` (YMD 2012 3 15) (YMD 2026 10 1) TRUE TRUE)
#ASSERT `reg 1(6) critically ill child` (YMD 2008 10 25) (YMD 2026 10 24) TRUE TRUE    -- the day before the 18th birthday: still under 18
#ASSERT NOT (`reg 1(7) critically ill adult` (YMD 2008 10 25) (YMD 2026 10 24) TRUE TRUE)
#ASSERT NOT (`reg 1(6) critically ill child` (YMD 2008 10 24) (YMD 2026 10 24) TRUE TRUE)   -- the 18th birthday itself: 18 years of age, so not under 18
#ASSERT `reg 1(7) critically ill adult` (YMD 2008 10 24) (YMD 2026 10 24) TRUE TRUE         -- "18 years of age or older"
#ASSERT `reg 1(7) critically ill adult` (YMD 1980 1 1) (YMD 2026 10 24) TRUE TRUE
#ASSERT NOT (`reg 1(6) critically ill child` (YMD 1980 1 1) (YMD 2026 10 24) TRUE TRUE)
#ASSERT NOT (`reg 1(6) critically ill child` (YMD 2012 3 15) (YMD 2026 10 1) FALSE TRUE)   -- baseline state of health has not significantly changed
#ASSERT NOT (`reg 1(6) critically ill child` (YMD 2012 3 15) (YMD 2026 10 1) TRUE FALSE)   -- life is not at risk
#ASSERT NOT (`reg 1(7) critically ill adult` (YMD 1980 1 1) (YMD 2026 10 24) FALSE TRUE)
#ASSERT NOT (`reg 1(7) critically ill adult` (YMD 1980 1 1) (YMD 2026 10 24) TRUE FALSE)
-- Fork reading (NOTES.md, fork register): a person born on 29 February reaches 18 on 28 February in a year without a 29 February,
-- because `add years` clamps. The Regulations do not say; the expected values below follow that reading, not the text.
#ASSERT `reg 1(6) critically ill child` (YMD 2008 2 29) (YMD 2026 2 27) TRUE TRUE
#ASSERT `reg 1(7) critically ill adult` (YMD 2008 2 29) (YMD 2026 2 28) TRUE TRUE
