IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `ei3-part4-review`

-- Tests of ei3-part4-review.l4 (Act ss 103 to 105).
-- Expected values are hand-worked from the text of the section named beside each assertion. Every date is invented.

§ `s 103(1) the appeal to the Tax Court of Canada`

-- A decision communicated on 1 March 2026: the 90th day after is 30 May 2026 (1 March to 31 March is 30 days, to 30 April 60, to
-- 30 May 90). The application for a longer time may be made within 90 days after that, to 28 August 2026 (30 May to 30 June is 31
-- days, to 31 July 62, to 28 August 90).
-- Arguments: affected; decision communicated on; appeal brought on; application for a longer time on (if any); last day the Court allowed (if any).
#ASSERT `s 103(1) the appeal to the Tax Court of Canada is brought in time` TRUE (YearMonthDay 2026 3 1) (YearMonthDay 2026 5 30) NOTHING NOTHING
#ASSERT NOT (`s 103(1) the appeal to the Tax Court of Canada is brought in time` TRUE (YearMonthDay 2026 3 1) (YearMonthDay 2026 5 31) NOTHING NOTHING)
#ASSERT `s 103(1) the appeal to the Tax Court of Canada is brought in time` TRUE (YearMonthDay 2026 3 1) (YearMonthDay 2026 3 2) NOTHING NOTHING
-- Late, with an application made in time and a longer time allowed by the Court.
#ASSERT `s 103(1) the appeal to the Tax Court of Canada is brought in time` TRUE (YearMonthDay 2026 3 1) (YearMonthDay 2026 7 1) (JUST (YearMonthDay 2026 6 15)) (JUST (YearMonthDay 2026 9 30))
#ASSERT `s 103(1) the appeal to the Tax Court of Canada is brought in time` TRUE (YearMonthDay 2026 3 1) (YearMonthDay 2026 9 30) (JUST (YearMonthDay 2026 8 28)) (JUST (YearMonthDay 2026 9 30))
#ASSERT NOT (`s 103(1) the appeal to the Tax Court of Canada is brought in time` TRUE (YearMonthDay 2026 3 1) (YearMonthDay 2026 10 1) (JUST (YearMonthDay 2026 8 28)) (JUST (YearMonthDay 2026 9 30)))
-- The application itself must be made by the 28th of August.
#ASSERT NOT (`s 103(1) the appeal to the Tax Court of Canada is brought in time` TRUE (YearMonthDay 2026 3 1) (YearMonthDay 2026 9 1) (JUST (YearMonthDay 2026 8 29)) (JUST (YearMonthDay 2026 9 30)))
-- The Court did not allow a longer time, or no application was made: only the 90 days count.
#ASSERT NOT (`s 103(1) the appeal to the Tax Court of Canada is brought in time` TRUE (YearMonthDay 2026 3 1) (YearMonthDay 2026 7 1) (JUST (YearMonthDay 2026 6 15)) NOTHING)
#ASSERT NOT (`s 103(1) the appeal to the Tax Court of Canada is brought in time` TRUE (YearMonthDay 2026 3 1) (YearMonthDay 2026 7 1) NOTHING (JUST (YearMonthDay 2026 9 30)))
-- Only the Commission or a person affected by the decision may appeal.
#ASSERT NOT (`s 103(1) the appeal to the Tax Court of Canada is brought in time` FALSE (YearMonthDay 2026 3 1) (YearMonthDay 2026 3 2) NOTHING NOTHING)
#ASSERT `s 103(1) the application for a longer time was made in time` (YearMonthDay 2026 3 1) (JUST (YearMonthDay 2026 8 28))
#ASSERT NOT (`s 103(1) the application for a longer time was made in time` (YearMonthDay 2026 3 1) (JUST (YearMonthDay 2026 8 29)))
#ASSERT NOT (`s 103(1) the application for a longer time was made in time` (YearMonthDay 2026 3 1) NOTHING)
#ASSERT `s 103(1) the appeal is brought within the longer time the Court allowed` (YearMonthDay 2026 9 30) (JUST (YearMonthDay 2026 9 30))
#ASSERT NOT (`s 103(1) the appeal is brought within the longer time the Court allowed` (YearMonthDay 2026 10 1) (JUST (YearMonthDay 2026 9 30)))
#ASSERT NOT (`s 103(1) the appeal is brought within the longer time the Court allowed` (YearMonthDay 2026 9 1) NOTHING)
#ASSERT `s 103(1.1) section 167 of the Income Tax Act, except paragraph 167(5)(a), applies to the application` TRUE
#ASSERT NOT (`s 103(1.1) section 167 of the Income Tax Act, except paragraph 167(5)(a), applies to the application` FALSE)
#ASSERT `s 103(2) the day on which a decision on an appeal to the Minister is communicated` (JUST (YearMonthDay 2026 3 1)) EQUALS JUST (YearMonthDay 2026 3 1)
#ASSERT `s 103(2) the day on which a decision on an appeal to the Minister is communicated` NOTHING EQUALS NOTHING
-- (3)
#ASSERT `s 103(3)(a) the Court may vacate, confirm or vary the decision or the assessment` TRUE
#ASSERT NOT (`s 103(3)(a) the Court may vacate, confirm or vary the decision or the assessment` FALSE)
#ASSERT `s 103(3)(b) the Court may refer the matter back to the Minister for reconsideration and reassessment` TRUE
#ASSERT NOT (`s 103(3)(b) the Court may refer the matter back to the Minister for reconsideration and reassessment` FALSE)
#ASSERT `s 103(3)(c) the Court shall notify in writing the parties to the appeal of its decision` TRUE
#ASSERT NOT (`s 103(3)(c) the Court shall notify in writing the parties to the appeal of its decision` FALSE)
#ASSERT `s 103(3)(d) the Court's reasons must be given in writing` TRUE
#ASSERT NOT (`s 103(3)(d) the Court's reasons must be given in writing` FALSE)

§ `ss 104 and 105`

#ASSERT `s 104(1) the Tax Court of Canada and the Minister have authority to decide the question` TRUE FALSE
#ASSERT `s 104(1) the Tax Court of Canada and the Minister have authority to decide the question` FALSE TRUE
#ASSERT NOT (`s 104(1) the Tax Court of Canada and the Minister have authority to decide the question` FALSE FALSE)
#ASSERT `s 104(2) the decision or ruling is final and binding for all purposes of this Act` TRUE FALSE
#ASSERT NOT (`s 104(2) the decision or ruling is final and binding for all purposes of this Act` TRUE TRUE)
#ASSERT NOT (`s 104(2) the decision or ruling is final and binding for all purposes of this Act` FALSE FALSE)
-- (3) All four limbs.
#ASSERT `s 104(3) the person shall be paid travel and other allowances approved by the Treasury Board` TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 104(3) the person shall be paid travel and other allowances approved by the Treasury Board` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`s 104(3) the person shall be paid travel and other allowances approved by the Treasury Board` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 104(3) the person shall be paid travel and other allowances approved by the Treasury Board` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 104(3) the person shall be paid travel and other allowances approved by the Treasury Board` TRUE TRUE TRUE FALSE)
#ASSERT `s 104(3) the allowances payable` TRUE 250 EQUALS JUST 250
#ASSERT `s 104(3) the allowances payable` FALSE 250 EQUALS NOTHING
-- s 105: final, "except for an appeal under the Federal Courts Act" (outside this section: not covered).
#ASSERT `s 105 the decision is subject to appeal to or review by a court` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 105 the decision is subject to appeal to or review by a court` TRUE TRUE EQUALS NOTHING
#ASSERT `s 105 the decision is subject to appeal to or review by a court` FALSE FALSE EQUALS NOTHING
