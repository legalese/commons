#ASSERT NOT (`Regs Sch III Part II s 19(1) the employer must complete a record of employment` (YMD 1997 1 1) TRUE TRUE)
#ASSERT `Regs Sch III Part II s 19(1) the number of copies of the record of employment` EQUALS 4
-- (2)(a): "not later than five days after the later of (i) the first day of the interruption of earnings, and (ii) the day on which the employer becomes aware"
#ASSERT `Regs Sch III Part II s 19(2) the last day for delivering or mailing the copies of the record of employment` (YMD 1996 8 1) (YMD 1996 8 3) EQUALS JUST (YMD 1996 8 8)
#ASSERT `Regs Sch III Part II s 19(2) the last day for delivering or mailing the copies of the record of employment` (YMD 1996 8 5) (YMD 1996 8 1) EQUALS JUST (YMD 1996 8 10)
#ASSERT `Regs Sch III Part II s 19(2) the last day for delivering or mailing the copies of the record of employment` (YMD 1996 8 1) (YMD 1996 8 1) EQUALS JUST (YMD 1996 8 6)
#ASSERT `Regs Sch III Part II s 19(2) the last day for delivering or mailing the copies of the record of employment` (YMD 1996 8 28) (YMD 1996 9 1) EQUALS JUST (YMD 1996 9 6)
#ASSERT `Regs Sch III Part II s 19(2) the last day for delivering or mailing the copies of the record of employment` (YMD 1997 1 1) (YMD 1997 1 2) EQUALS NOTHING
#ASSERT `Regs Sch III Part II s 19(2)(c) the employer must keep the employer’s copy with its records and books of account` (YMD 1996 8 1)
#ASSERT NOT (`Regs Sch III Part II s 19(2)(c) the employer must keep the employer’s copy with its records and books of account` (YMD 1997 1 1))
-- (3): until the earlier of the request and 52 weeks after the time limit (limit 8 August 1996; 52 weeks later is 7 August 1997)
#ASSERT `Regs Sch III Part II s 19(3) the day until which the employer retains the employee’s copies` (YMD 1996 8 8) NOTHING EQUALS JUST (YMD 1997 8 7)
#ASSERT `Regs Sch III Part II s 19(3) the day until which the employer retains the employee’s copies` (YMD 1996 8 8) (JUST (YMD 1996 9 1)) EQUALS JUST (YMD 1996 9 1)
#ASSERT `Regs Sch III Part II s 19(3) the day until which the employer retains the employee’s copies` (YMD 1996 8 8) (JUST (YMD 1997 8 7)) EQUALS JUST (YMD 1997 8 7)
#ASSERT `Regs Sch III Part II s 19(3) the day until which the employer retains the employee’s copies` (YMD 1996 8 8) (JUST (YMD 1998 1 1)) EQUALS JUST (YMD 1997 8 7)
#ASSERT `Regs Sch III Part II s 19(3) the day until which the employer retains the employee’s copies` (YMD 1997 1 1) NOTHING EQUALS NOTHING
-- (4), (5)
#ASSERT `Regs Sch III Part II s 19(4) sections 35 and 36 of these Regulations do not apply to the determination of the weeks and earnings reported in a record of employment` (YMD 1996 8 1)
#ASSERT NOT (`Regs Sch III Part II s 19(4) sections 35 and 36 of these Regulations do not apply to the determination of the weeks and earnings reported in a record of employment` (YMD 1997 1 1))
#ASSERT `Regs Sch III Part II s 19(5) the employer may estimate the earnings for the pay period` (YMD 1996 8 1) TRUE TRUE
#ASSERT NOT (`Regs Sch III Part II s 19(5) the employer may estimate the earnings for the pay period` (YMD 1996 8 1) TRUE FALSE)
#ASSERT NOT (`Regs Sch III Part II s 19(5) the employer may estimate the earnings for the pay period` (YMD 1996 8 1) FALSE TRUE)
#ASSERT NOT (`Regs Sch III Part II s 19(5) the employer may estimate the earnings for the pay period` (YMD 1997 1 1) TRUE TRUE)

§ `Part II item 2 -- s 20: when the record is missing`

-- (1): the employer failed to deliver, or cannot provide because its records are destroyed or lost
#ASSERT `Regs Sch III Part II s 20(1) the claimant may provide a statement containing evidence of their employment history and insurable earnings` (YMD 1996 8 1) TRUE FALSE
#ASSERT `Regs Sch III Part II s 20(1) the claimant may provide a statement containing evidence of their employment history and insurable earnings` (YMD 1996 8 1) FALSE TRUE
#ASSERT NOT (`Regs Sch III Part II s 20(1) the claimant may provide a statement containing evidence of their employment history and insurable earnings` (YMD 1996 8 1) FALSE FALSE)
#ASSERT NOT (`Regs Sch III Part II s 20(1) the claimant may provide a statement containing evidence of their employment history and insurable earnings` (YMD 1997 1 1) TRUE TRUE)
-- (2): the weeks "immediately preceded and included the week in which the lay-off or separation occurred": four weeks ending with the week beginning Sunday 15 December 1996 begin on 24 November
#ASSERT `Regs Sch III Part II s 20(2) the Sunday that begins the first of the weeks of insurable employment` (YMD 1996 12 15) (YMD 1996 12 15) 4 EQUALS JUST (YMD 1996 11 24)
#ASSERT `Regs Sch III Part II s 20(2) the Sunday that begins the first of the weeks of insurable employment` (YMD 1996 12 15) (YMD 1996 12 15) 1 EQUALS JUST (YMD 1996 12 15)
#ASSERT `Regs Sch III Part II s 20(2) the Sunday that begins the first of the weeks of insurable employment` (YMD 1997 1 1) (YMD 1996 12 15) 4 EQUALS NOTHING
-- (3): not more than the weeks or part weeks that fall within the employment period
#ASSERT `Regs Sch III Part II s 20(3) the number of weeks of insurable employment in the employment period` (YMD 1996 8 1) 30 25 EQUALS JUST 25
#ASSERT `Regs Sch III Part II s 20(3) the number of weeks of insurable employment in the employment period` (YMD 1996 8 1) 20 25 EQUALS JUST 20
#ASSERT `Regs Sch III Part II s 20(3) the number of weeks of insurable employment in the employment period` (YMD 1996 8 1) 25 25 EQUALS JUST 25
#ASSERT `Regs Sch III Part II s 20(3) the number of weeks of insurable employment in the employment period` (YMD 1997 1 1) 30 25 EQUALS NOTHING
-- (4)
#ASSERT `Regs Sch III Part II s 20(4) the Commission may determine the insurable weeks and insurable earnings from the trustee’s payroll and personnel records` (YMD 1996 8 1) TRUE TRUE TRUE
#ASSERT NOT (`Regs Sch III Part II s 20(4) the Commission may determine the insurable weeks and insurable earnings from the trustee’s payroll and personnel records` (YMD 1996 8 1) FALSE TRUE TRUE)
#ASSERT NOT (`Regs Sch III Part II s 20(4) the Commission may determine the insurable weeks and insurable earnings from the trustee’s payroll and personnel records` (YMD 1996 8 1) TRUE FALSE TRUE)
#ASSERT NOT (`Regs Sch III Part II s 20(4) the Commission may determine the insurable weeks and insurable earnings from the trustee’s payroll and personnel records` (YMD 1996 8 1) TRUE TRUE FALSE)
#ASSERT NOT (`Regs Sch III Part II s 20(4) the Commission may determine the insurable weeks and insurable earnings from the trustee’s payroll and personnel records` (YMD 1997 1 1) TRUE TRUE TRUE)

§ `Part II item 3 -- ss 22 and 23`

-- the period of items 3 to 6 ends on 4 January 1997, the day before the provisions they replace come into force
#ASSERT `Regs Sch III Part II s 22 the earnings are taken into account in determining the average weekly insurable earnings` (YMD 1996 8 1) TRUE
#ASSERT `Regs Sch III Part II s 22 the earnings are taken into account in determining the average weekly insurable earnings` (YMD 1997 1 4) TRUE
#ASSERT NOT (`Regs Sch III Part II s 22 the earnings are taken into account in determining the average weekly insurable earnings` (YMD 1997 1 5) TRUE)
#ASSERT NOT (`Regs Sch III Part II s 22 the earnings are taken into account in determining the average weekly insurable earnings` (YMD 1996 8 1) FALSE)
-- s 23 (a): a pay period of seven consecutive days beginning on a day other than Sunday: 3 pay periods, each with 150 or 15 hours
#ASSERT `Regs Sch III Part II s 23 the number of weeks that are to be taken as weeks of insurable employment` (YMD 1996 8 1) `er6 seven consecutive days beginning on a day other than Sunday` (`test pay period facts` 150 0 TRUE FALSE) 3 750 EQUALS JUST 3
#ASSERT `Regs Sch III Part II s 23 the number of weeks that are to be taken as weeks of insurable employment` (YMD 1996 8 1) `er6 seven consecutive days beginning on a day other than Sunday` (`test pay period facts` 0 15 FALSE TRUE) 3 750 EQUALS JUST 3
#ASSERT `Regs Sch III Part II s 23 the number of weeks that are to be taken as weeks of insurable employment` (YMD 1996 8 1) `er6 seven consecutive days beginning on a day other than Sunday` (`test pay period facts` 149 14 TRUE TRUE) 3 750 EQUALS NOTHING
#ASSERT `Regs Sch III Part II s 23 the number of weeks that are to be taken as weeks of insurable employment` (YMD 1996 8 1) `er6 seven consecutive days beginning on a day other than Sunday` (`test pay period facts` 150 0 FALSE FALSE) 3 750 EQUALS NOTHING
-- s 23 (b): a pay period of more than one such period (two here): the number of periods of seven days, if 2 x 150 or 2 x 15 hours
#ASSERT `Regs Sch III Part II s 23 the number of weeks that are to be taken as weeks of insurable employment` (YMD 1996 8 1) (`er6 more than one period of seven consecutive days beginning on a day other than Sunday` 2) (`test pay period facts` 300 0 TRUE FALSE) 1 750 EQUALS JUST 2
#ASSERT `Regs Sch III Part II s 23 the number of weeks that are to be taken as weeks of insurable employment` (YMD 1996 8 1) (`er6 more than one period of seven consecutive days beginning on a day other than Sunday` 2) (`test pay period facts` 0 30 FALSE TRUE) 1 750 EQUALS JUST 2
#ASSERT `Regs Sch III Part II s 23 the number of weeks that are to be taken as weeks of insurable employment` (YMD 1996 8 1) (`er6 more than one period of seven consecutive days beginning on a day other than Sunday` 2) (`test pay period facts` 299 29 TRUE TRUE) 1 750 EQUALS NOTHING
-- the other pay periods of 6.1(2) are not in s 23, and nothing counts outside the period
#ASSERT `Regs Sch III Part II s 23 the number of weeks that are to be taken as weeks of insurable employment` (YMD 1996 8 1) `er6 a monthly pay period` (`test pay period facts` 5000 500 TRUE TRUE) 1 750 EQUALS NOTHING
#ASSERT `Regs Sch III Part II s 23 the number of weeks that are to be taken as weeks of insurable employment` (YMD 1997 1 5) `er6 seven consecutive days beginning on a day other than Sunday` (`test pay period facts` 150 0 TRUE FALSE) 3 750 EQUALS NOTHING

