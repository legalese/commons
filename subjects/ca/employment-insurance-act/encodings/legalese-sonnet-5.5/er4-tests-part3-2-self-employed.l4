IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `er4-nouns`
IMPORT `er4-part3-2-self-employed`

-- Tests of regs 76.31 to 76.45 (SOR-96-332.txt lines 1324-1392). Every expected value is written by hand from the text.
-- The Act figures the formulas read (A, C, D) are inputs; the values below are invented stand-ins, not asserted as law.

§ `Reg 76.31 -- plan established under a provincial law; provincial benefits`

-- Arguments: established under a provincial law, provides for provincial benefits, premium under s 152.21 subject to a reducing system.
#ASSERT `reg 76.31 plan established under a provincial law` TRUE TRUE TRUE
#ASSERT NOT `reg 76.31 plan established under a provincial law` FALSE TRUE TRUE
#ASSERT NOT `reg 76.31 plan established under a provincial law` TRUE FALSE TRUE
#ASSERT NOT `reg 76.31 plan established under a provincial law` TRUE TRUE FALSE
-- Arguments: paid to a self-employed person under such a plan, because of pregnancy, care of new-born children, care of children placed for adoption.
#ASSERT `reg 76.31 provincial benefits of a self-employed person` TRUE TRUE FALSE FALSE
#ASSERT `reg 76.31 provincial benefits of a self-employed person` TRUE FALSE TRUE FALSE
#ASSERT `reg 76.31 provincial benefits of a self-employed person` TRUE FALSE FALSE TRUE
#ASSERT NOT `reg 76.31 provincial benefits of a self-employed person` TRUE FALSE FALSE FALSE
#ASSERT NOT `reg 76.31 provincial benefits of a self-employed person` FALSE TRUE TRUE TRUE

§ `Reg 76.32 -- the five standards`

#ASSERT `reg 76.32 the plan established under a provincial law meets the requirements` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT `reg 76.32 the plan established under a provincial law meets the requirements` FALSE TRUE TRUE TRUE TRUE
#ASSERT NOT `reg 76.32 the plan established under a provincial law meets the requirements` TRUE FALSE TRUE TRUE TRUE
#ASSERT NOT `reg 76.32 the plan established under a provincial law meets the requirements` TRUE TRUE FALSE TRUE TRUE
#ASSERT NOT `reg 76.32 the plan established under a provincial law meets the requirements` TRUE TRUE TRUE FALSE TRUE
#ASSERT NOT `reg 76.32 the plan established under a provincial law meets the requirements` TRUE TRUE TRUE TRUE FALSE

§ `Reg 76.33 and 76.34 -- the reduction`

#ASSERT `reg 76.33 the self-employment premium payable under section 152.21 of the Act is to be reduced` TRUE
#ASSERT NOT `reg 76.33 the self-employment premium payable under section 152.21 of the Act is to be reduced` FALSE
#ASSERT `reg 76.34 the premium reduction to be applied to the self-employment premium` 40000 0.0054 EQUALS 216

§ `Reg 76.36 -- disentitlement`

#ASSERT `reg 76.36(2) subsection (1) does not apply` TRUE TRUE
#ASSERT NOT `reg 76.36(2) subsection (1) does not apply` TRUE FALSE
#ASSERT NOT `reg 76.36(2) subsection (1) does not apply` FALSE TRUE
#ASSERT `reg 76.36(1) the self-employed person is disentitled to be paid benefits under section 152.04 or 152.05 of the Act` TRUE FALSE
#ASSERT NOT `reg 76.36(1) the self-employed person is disentitled to be paid benefits under section 152.04 or 152.05 of the Act` TRUE TRUE
#ASSERT NOT `reg 76.36(1) the self-employed person is disentitled to be paid benefits under section 152.04 or 152.05 of the Act` FALSE FALSE
#ASSERT `reg 76.36(3) the self-employed person is disentitled to be paid those benefits in respect of the same week` `er4 other benefits under Part VII.1 of the Act` TRUE EQUALS JUST TRUE
#ASSERT `reg 76.36(3) the self-employed person is disentitled to be paid those benefits in respect of the same week` `er4 other benefits under Part VII.1 of the Act` FALSE EQUALS JUST FALSE
#ASSERT `reg 76.36(3) the self-employed person is disentitled to be paid those benefits in respect of the same week` `er4 benefits under section 152.04 of the Act` TRUE EQUALS JUST FALSE
#ASSERT `reg 76.36(3) the self-employed person is disentitled to be paid those benefits in respect of the same week` `er4 benefits under section 152.05 of the Act` TRUE EQUALS JUST FALSE
#ASSERT `reg 76.36(3) the self-employed person is disentitled to be paid those benefits in respect of the same week` `er4 benefits of another kind` TRUE EQUALS NOTHING
#ASSERT `reg 76.36(4) subsections (1) to (3) apply to the self-employed person whether or not they have ceased to reside in the province providing those benefits` TRUE TRUE
#ASSERT NOT `reg 76.36(4) subsections (1) to (3) apply to the self-employed person whether or not they have ceased to reside in the province providing those benefits` TRUE FALSE
#ASSERT `reg 76.36(5)(a) subsections (1) to (3) apply in respect of the other person` TRUE TRUE TRUE
#ASSERT NOT `reg 76.36(5)(a) subsections (1) to (3) apply in respect of the other person` TRUE TRUE FALSE
#ASSERT `reg 76.36(5)(b) subsections 76.09(1) to (3) apply in respect of the other person` TRUE TRUE TRUE
#ASSERT NOT `reg 76.36(5)(b) subsections 76.09(1) to (3) apply in respect of the other person` FALSE TRUE TRUE

§ `Reg 76.37 and 76.38 -- reduction of benefits`

#ASSERT `reg 76.37 the benefits payable under section 152.04 or 152.05 of the Act for the week are to be reduced` TRUE
#ASSERT NOT `reg 76.37 the benefits payable under section 152.04 or 152.05 of the Act for the week are to be reduced` FALSE
#ASSERT `reg 76.38 the benefits payable under section 152.04 or 152.05 of the Act for the week after the provincial benefits are deducted` 400 150 EQUALS JUST 250
#ASSERT `reg 76.38 the benefits payable under section 152.04 or 152.05 of the Act for the week after the provincial benefits are deducted` 150 150 EQUALS JUST 0
#ASSERT `reg 76.38 the benefits payable under section 152.04 or 152.05 of the Act for the week after the provincial benefits are deducted` 100 150 EQUALS NOTHING

§ `Reg 76.39 -- no double counting`

#ASSERT `reg 76.39 benefits paid under section 152.04 or 152.05 of the Act in respect of a week may be taken into account for that same purpose` FALSE
#ASSERT NOT `reg 76.39 benefits paid under section 152.04 or 152.05 of the Act in respect of a week may be taken into account for that same purpose` TRUE

§ `Reg 76.4 -- payment of benefits`

#ASSERT `reg 76.4(1) the provincial benefits paid for the week are considered to be benefits paid in respect of a week under the Act` TRUE
#ASSERT NOT `reg 76.4(1) the provincial benefits paid for the week are considered to be benefits paid in respect of a week under the Act` FALSE
#ASSERT `reg 76.4(1)(a) the weeks counted toward the overall maximum number of weeks under paragraphs 152.14(1)(a) and (b) of the Act taken together` 20 10 EQUALS 30
#ASSERT `reg 76.4(1)(b) the weeks counted toward the maximum number of weeks under subsection 152.14(2) of the Act` 15 20 EQUALS 35
-- Against an overall maximum of 50: 20 weeks left; exactly 50 counted leaves none; 51 counted is not answered by the text.
#ASSERT `reg 76.4(1)(a) the weeks left within the overall maximum` 50 20 10 EQUALS JUST 20
#ASSERT `reg 76.4(1)(a) the weeks left within the overall maximum` 50 40 10 EQUALS JUST 0
#ASSERT `reg 76.4(1)(a) the weeks left within the overall maximum` 50 40 11 EQUALS NOTHING
#ASSERT `reg 76.4(1)(b) the weeks left within the maximum under subsection 152.14(2)` 40 15 20 EQUALS JUST 5
#ASSERT `reg 76.4(1)(b) the weeks left within the maximum under subsection 152.14(2)` 40 15 26 EQUALS NOTHING
#ASSERT `reg 76.4(2) a benefit period is deemed to be established` TRUE
#ASSERT NOT `reg 76.4(2) a benefit period is deemed to be established` FALSE
#ASSERT `reg 76.4(2) the week in which the benefit period is deemed to have begun` TRUE (YearMonthDay 2026 3 1) TRUE EQUALS JUST (YearMonthDay 2026 3 1)
#ASSERT `reg 76.4(2) the week in which the benefit period is deemed to have begun` TRUE (YearMonthDay 2026 3 1) FALSE EQUALS NOTHING
-- 10 weeks, 35 non-accelerated over 25 accelerated: 14; with a ratio of 15/10, 5 weeks are 7.5, rounded up to 8, and 3 weeks 4.5 to 5.
#ASSERT `reg 76.4(3) the number of weeks of benefits that the weeks of provincial benefits represent under the Act, before rounding` 10 35 25 EQUALS JUST 14
#ASSERT `reg 76.4(3) the number of weeks of benefits that the weeks of provincial benefits represent under the Act, before rounding` 10 35 0 EQUALS NOTHING
#ASSERT `reg 76.4(4) the number of weeks rounded to the nearest multiple of one week, the higher multiple when equidistant` 7.5 EQUALS 8
#ASSERT `reg 76.4(4) the number of weeks rounded to the nearest multiple of one week, the higher multiple when equidistant` 7.49 EQUALS 7
#ASSERT `reg 76.4(3) and (4) the weeks of provincial benefits as weeks under the Act` TRUE 5 15 10 EQUALS JUST 8
#ASSERT `reg 76.4(3) and (4) the weeks of provincial benefits as weeks under the Act` TRUE 3 15 10 EQUALS JUST 5
#ASSERT `reg 76.4(3) and (4) the weeks of provincial benefits as weeks under the Act` FALSE 7 15 10 EQUALS JUST 7

§ `Reg 76.41 -- weeks beyond the Act's maximum`

#ASSERT `reg 76.41 the weeks of provincial benefits that are taken into account in determining the maximum number of weeks` 35 40 38 EQUALS 35
#ASSERT `reg 76.41 the weeks of provincial benefits that are taken into account in determining the maximum number of weeks` 35 40 30 EQUALS 30
#ASSERT `reg 76.41 the weeks of provincial benefits that are taken into account in determining the maximum number of weeks` 40 35 30 EQUALS 30

§ `Reg 76.42 -- two persons caring for the same child under different regimes`

#ASSERT `reg 76.42(1) subsection (2) applies in respect of the two persons` TRUE TRUE
#ASSERT NOT `reg 76.42(1) subsection (2) applies in respect of the two persons` TRUE FALSE
-- Odd 35: first-applying self-employed person gets 1 + 17 = 18; provincial applicant first gives 17; even 36 gives 18; agreement gives no number.
#ASSERT `reg 76.42(2) the number of weeks of benefits payable to the self-employed person, subject to subsection (3)` 35 `er4 the person claiming benefits under the Act made the earlier application` FALSE EQUALS JUST 18
#ASSERT `reg 76.42(2) the number of weeks of benefits payable to the self-employed person, subject to subsection (3)` 35 `er4 the provincial applicant made the earlier application` FALSE EQUALS JUST 17
#ASSERT `reg 76.42(2) the number of weeks of benefits payable to the self-employed person, subject to subsection (3)` 36 `er4 the provincial applicant made the earlier application` FALSE EQUALS JUST 18
#ASSERT `reg 76.42(2) the number of weeks of benefits payable to the self-employed person, subject to subsection (3)` 35 `er4 the provincial applicant made the earlier application` TRUE EQUALS NOTHING
-- (3): A = 40, B = 15, C = 61, D = 35 (invented stand-ins): 25 weeks for the 35-week election, floor(25 x 61/35) = 43 for the 61-week election.
#ASSERT `reg 76.42(3) the most weeks that may be paid to the self-employed person` `the 35-week maximum` 40 15 61 35 EQUALS JUST 25
#ASSERT `reg 76.42(3) the most weeks that may be paid to the self-employed person` `the 61-week maximum` 40 15 61 35 EQUALS JUST 43
#ASSERT `reg 76.42(4) the maximum number of weeks for which benefits may be paid in accordance with the election` `the 35-week maximum` 35 61 EQUALS 35
#ASSERT `reg 76.42(4) the maximum number of weeks for which benefits may be paid in accordance with the election` `the 61-week maximum` 35 61 EQUALS 61
-- All together: the share 18 is below the cap 25 and the ceiling 35.
#ASSERT `reg 76.42 the number of weeks of benefits payable to the self-employed person` 35 `er4 the person claiming benefits under the Act made the earlier application` FALSE `the 35-week maximum` 40 15 61 35 EQUALS JUST 18
-- The cap binds: 40 - 30 = 10.
#ASSERT `reg 76.42 the number of weeks of benefits payable to the self-employed person` 35 `er4 the person claiming benefits under the Act made the earlier application` FALSE `the 35-week maximum` 40 30 61 35 EQUALS JUST 10
#ASSERT `reg 76.42 the number of weeks of benefits payable to the self-employed person` 35 `er4 the provincial applicant made the earlier application` TRUE `the 35-week maximum` 40 15 61 35 EQUALS NOTHING

§ `Reg 76.421 -- the waiting period`

#ASSERT `reg 76.421 the condition of paragraph 40(6)(b), as adapted, is met` TRUE FALSE
#ASSERT `reg 76.421 the condition of paragraph 40(6)(b), as adapted, is met` FALSE TRUE
#ASSERT NOT `reg 76.421 the condition of paragraph 40(6)(b), as adapted, is met` FALSE FALSE

§ `Reg 76.43 -- interprovincial mobility`

-- The person ceased to reside in the province on 15 June 2026. An agreement exactly 12 months before is within it; a day earlier is not.
#ASSERT `reg 76.43 the agreement was entered into within 12 months before the day the self-employed person ceased to reside in the province, or within three months after that day` (YearMonthDay 2026 6 15) (YearMonthDay 2025 6 15)
#ASSERT NOT `reg 76.43 the agreement was entered into within 12 months before the day the self-employed person ceased to reside in the province, or within three months after that day` (YearMonthDay 2026 6 15) (YearMonthDay 2025 6 14)
-- On the day itself, and three months after (15 September 2026) are within; one day more is not.
#ASSERT `reg 76.43 the agreement was entered into within 12 months before the day the self-employed person ceased to reside in the province, or within three months after that day` (YearMonthDay 2026 6 15) (YearMonthDay 2026 6 15)
#ASSERT `reg 76.43 the agreement was entered into within 12 months before the day the self-employed person ceased to reside in the province, or within three months after that day` (YearMonthDay 2026 6 15) (YearMonthDay 2026 9 15)
#ASSERT NOT `reg 76.43 the agreement was entered into within 12 months before the day the self-employed person ceased to reside in the province, or within three months after that day` (YearMonthDay 2026 6 15) (YearMonthDay 2026 9 16)
-- Deemed to have satisfied 152.07(1)(a) only if also covered by the plan during the 12 months before.
#ASSERT `reg 76.43 the self-employed person is deemed to have satisfied the condition set out in paragraph 152.07(1)(a) of the Act` (YearMonthDay 2026 6 15) (YearMonthDay 2025 12 1) TRUE
#ASSERT NOT `reg 76.43 the self-employed person is deemed to have satisfied the condition set out in paragraph 152.07(1)(a) of the Act` (YearMonthDay 2026 6 15) (YearMonthDay 2025 12 1) FALSE
#ASSERT NOT `reg 76.43 the self-employed person is deemed to have satisfied the condition set out in paragraph 152.07(1)(a) of the Act` (YearMonthDay 2026 6 15) (YearMonthDay 2026 9 16) TRUE

