#ASSERT `reg 76.44 the self-employed person's social insurance number is to be used` TRUE
#ASSERT NOT `reg 76.44 the self-employed person's social insurance number is to be used` FALSE
#ASSERT `reg 76.45 the Canada Revenue Agency and the Minister of National Revenue are authorized to disclose the information to the province` TRUE TRUE TRUE
#ASSERT NOT `reg 76.45 the Canada Revenue Agency and the Minister of National Revenue are authorized to disclose the information to the province` FALSE TRUE TRUE
#ASSERT NOT `reg 76.45 the Canada Revenue Agency and the Minister of National Revenue are authorized to disclose the information to the province` TRUE FALSE TRUE
#ASSERT NOT `reg 76.45 the Canada Revenue Agency and the Minister of National Revenue are authorized to disclose the information to the province` TRUE TRUE FALSE
