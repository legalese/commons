IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `eia-core-interpretation`

-- Tests for eia-core-interpretation.l4 (Employment Insurance Act s 2).
-- Each expected value is written by hand from the definition quoted in that module.
-- Argument order is the order of the GIVEN parameters in the rule under test.

§ `affidavit - s 2(1)`

-- sworn or affirmed, and before a commissioner of oaths
#ASSERT `s 2(1) affidavit` TRUE TRUE FALSE
-- sworn or affirmed, and before another person authorized to take affidavits
#ASSERT `s 2(1) affidavit` TRUE FALSE TRUE
-- sworn or affirmed, but before neither
#ASSERT NOT (`s 2(1) affidavit` TRUE FALSE FALSE)
-- before a commissioner but neither sworn nor affirmed
#ASSERT NOT (`s 2(1) affidavit` FALSE TRUE TRUE)

§ `benefits - s 2(1)`

#ASSERT `s 2(1) benefits` `Part I`
#ASSERT `s 2(1) benefits` `Part VII.1`
#ASSERT `s 2(1) benefits` `Part VIII`
#ASSERT NOT (`s 2(1) benefits` `Part VII`)
#ASSERT NOT (`s 2(1) benefits` `Part VIII.4`)
#ASSERT NOT (`s 2(1) benefits` `Part VIII.1`)

§ `claimant - s 2(1)`

#ASSERT `s 2(1) claimant` TRUE FALSE
#ASSERT `s 2(1) claimant` FALSE TRUE
#ASSERT NOT (`s 2(1) claimant` FALSE FALSE)

§ `common-law partner - s 2(1)`

-- Exactly one year: 25 October 2025 to 25 October 2026 is a period of at least one year.
#ASSERT `s 2(1) common-law partner` TRUE (YMD 2025 10 25) (YMD 2026 10 25)
-- One day short of a year.
#ASSERT NOT (`s 2(1) common-law partner` TRUE (YMD 2025 10 25) (YMD 2026 10 24))
-- Longer than a year.
#ASSERT `s 2(1) common-law partner` TRUE (YMD 2020 1 1) (YMD 2026 10 25)
-- Not cohabiting in a conjugal relationship, however long.
#ASSERT NOT (`s 2(1) common-law partner` FALSE (YMD 2020 1 1) (YMD 2026 10 25))

§ `confirmed delivery service - s 2(1)`

#ASSERT `s 2(1) confirmed delivery service` TRUE FALSE FALSE
#ASSERT `s 2(1) confirmed delivery service` FALSE TRUE FALSE
#ASSERT `s 2(1) confirmed delivery service` FALSE FALSE TRUE
#ASSERT NOT (`s 2(1) confirmed delivery service` FALSE FALSE FALSE)

§ `documents - s 2(1)`

#ASSERT `s 2(1) documents includes` `s 2(1) documents - money` EQUALS JUST TRUE
#ASSERT `s 2(1) documents includes` `s 2(1) documents - invoices` EQUALS JUST TRUE
#ASSERT `s 2(1) documents includes` `s 2(1) documents - statements, financial or otherwise` EQUALS JUST TRUE
-- The list is open: the Act does not say that something else is not a document.
#ASSERT `s 2(1) documents includes` `s 2(1) documents - something not on the list` EQUALS NOTHING

§ `dwelling-house - s 2(1)`

-- A building or structure kept or occupied as a residence.
#ASSERT `s 2(1) dwelling-house` TRUE FALSE FALSE FALSE FALSE FALSE
-- A building within the yard, connected by a doorway.
#ASSERT `s 2(1) dwelling-house` FALSE TRUE TRUE FALSE FALSE FALSE
-- A building within the yard, connected by a covered and enclosed passageway.
#ASSERT `s 2(1) dwelling-house` FALSE TRUE FALSE TRUE FALSE FALSE
-- A building within the yard, not connected at all.
#ASSERT NOT (`s 2(1) dwelling-house` FALSE TRUE FALSE FALSE FALSE FALSE)
-- A mobile unit being used as a residence.
#ASSERT `s 2(1) dwelling-house` FALSE FALSE FALSE FALSE TRUE TRUE
-- A mobile unit designed as a residence but not being used as one.
#ASSERT NOT (`s 2(1) dwelling-house` FALSE FALSE FALSE FALSE TRUE FALSE)
#ASSERT NOT (`s 2(1) dwelling-house` FALSE FALSE FALSE FALSE FALSE FALSE)

§ `employer - s 2(1)`

#ASSERT `s 2(1) employer` TRUE FALSE FALSE FALSE
-- includes a person who has been an employer
#ASSERT `s 2(1) employer` FALSE TRUE FALSE FALSE
-- includes the sponsor or co-ordinator, in respect of that individual's remuneration
#ASSERT `s 2(1) employer` FALSE FALSE TRUE TRUE
-- the sponsor or co-ordinator is not an employer for a question about someone else's remuneration
#ASSERT NOT (`s 2(1) employer` FALSE FALSE TRUE FALSE)
#ASSERT NOT (`s 2(1) employer` FALSE FALSE FALSE FALSE)

§ `employment - s 2(1)`

#ASSERT `s 2(1) employment` TRUE FALSE
#ASSERT `s 2(1) employment` FALSE TRUE
#ASSERT NOT (`s 2(1) employment` FALSE FALSE)

§ `insured person - s 2(1)`

#ASSERT `s 2(1) insured person` TRUE FALSE
-- is or has been
#ASSERT `s 2(1) insured person` FALSE TRUE
#ASSERT NOT (`s 2(1) insured person` FALSE FALSE)

§ `labour dispute - s 2(1)`

-- employers and employees; the terms or conditions of employment
#ASSERT `s 2(1) labour dispute` TRUE FALSE FALSE FALSE TRUE
-- employees and employees; employment
#ASSERT `s 2(1) labour dispute` FALSE TRUE TRUE FALSE FALSE
-- employees and employees; non-employment
#ASSERT `s 2(1) labour dispute` FALSE TRUE FALSE TRUE FALSE
-- a dispute between neither pair is not a labour dispute
#ASSERT NOT (`s 2(1) labour dispute` FALSE FALSE TRUE TRUE TRUE)
-- a dispute between the right pair that is connected with none of the three is not either
#ASSERT NOT (`s 2(1) labour dispute` TRUE TRUE FALSE FALSE FALSE)

§ `Minister - s 2(1), s 81, s 144`

#ASSERT `s 2(1) the Minister for` `Part IV` EQUALS `the Minister of National Revenue`
#ASSERT `s 2(1) the Minister for` `Part VII` EQUALS `the Minister of National Revenue`
#ASSERT `s 2(1) the Minister for` `Part I` EQUALS `the Minister`
#ASSERT `s 2(1) the Minister for` `Part VII.1` EQUALS `the Minister`
#ASSERT `s 2(1) the Minister for` `Part VIII` EQUALS `the Minister`

§ `overpayment of benefits - s 2(1)`

#ASSERT `s 2(1) overpayment of benefits` TRUE FALSE
-- a benefit repayment as described in Part VII is not an overpayment
#ASSERT NOT (`s 2(1) overpayment of benefits` TRUE TRUE)
#ASSERT NOT (`s 2(1) overpayment of benefits` FALSE FALSE)

§ `provincial law - s 2(1)`

#ASSERT `s 2(1) provincial law` TRUE TRUE FALSE
#ASSERT `s 2(1) provincial law` TRUE FALSE TRUE
#ASSERT NOT (`s 2(1) provincial law` TRUE FALSE FALSE)
#ASSERT NOT (`s 2(1) provincial law` FALSE TRUE TRUE)

§ `special benefits and regular benefits - s 2(1)`

#ASSERT `s 2(1) special benefits` `pregnancy`
#ASSERT `s 2(1) special benefits` `caring for a new-born or adopted child`
#ASSERT `s 2(1) special benefits` `a prescribed illness, injury or quarantine`
#ASSERT `s 2(1) special benefits` `care or support of a family member`
#ASSERT `s 2(1) special benefits` `care or support of a critically ill child`
#ASSERT `s 2(1) special benefits` `care or support of a critically ill adult`
#ASSERT NOT (`s 2(1) special benefits` `a reason other than those mentioned in subsection 12(3)`)
#ASSERT `s 2(1) regular benefits` `Part I` FALSE FALSE
#ASSERT `s 2(1) regular benefits` `Part VIII` FALSE FALSE
-- Part VII.1 is neither Part I nor Part VIII
#ASSERT NOT (`s 2(1) regular benefits` `Part VII.1` FALSE FALSE)
-- special benefits under Part I are not regular benefits
#ASSERT NOT (`s 2(1) regular benefits` `Part I` TRUE FALSE)
-- benefits by virtue of section 24 or 25 are not regular benefits
#ASSERT NOT (`s 2(1) regular benefits` `Part I` FALSE TRUE)

§ `week - s 2(1)`

-- Sunday 25 October 2026 to Saturday 31 October 2026
#ASSERT `s 2(1) week` (`Period of days` OF (YMD 2026 10 25), (YMD 2026 10 31)) FALSE
-- Monday to Sunday is seven consecutive days but does not begin on a Sunday
#ASSERT NOT (`s 2(1) week` (`Period of days` OF (YMD 2026 10 26), (YMD 2026 11 1)) FALSE)
-- Sunday to the following Sunday is eight days
#ASSERT NOT (`s 2(1) week` (`Period of days` OF (YMD 2026 10 25), (YMD 2026 11 1)) FALSE)
-- "or any other prescribed period"
#ASSERT `s 2(1) week` (`Period of days` OF (YMD 2026 10 26), (YMD 2026 11 1)) TRUE

§ `rates of unemployment produced by Statistics Canada - s 2(2)`

-- Illustrative releases, not published figures.
`the January release` MEANS `Published rate of unemployment` OF (YMD 2026 1 15), 0.065
`the February release` MEANS `Published rate of unemployment` OF (YMD 2026 2 15), 0.068
`the March release` MEANS `Published rate of unemployment` OF (YMD 2026 3 15), 0.071

#ASSERT `s 2(2) the rate of unemployment most recently produced` (LIST `the January release`, `the February release`, `the March release`) (YMD 2026 2 20) EQUALS JUST 0.068
-- Out of date order: the answer does not depend on the order of the list.
#ASSERT `s 2(2) the rate of unemployment most recently produced` (LIST `the March release`, `the January release`, `the February release`) (YMD 2026 2 20) EQUALS JUST 0.068
-- Assumed, not ruled: a rate produced on the day of the final determination was produced at the time.
#ASSERT `s 2(2) the rate of unemployment most recently produced` (LIST `the January release`, `the February release`, `the March release`) (YMD 2026 2 15) EQUALS JUST 0.068
#ASSERT `s 2(2) the rate of unemployment most recently produced` (LIST `the January release`, `the February release`, `the March release`) (YMD 2027 1 1) EQUALS JUST 0.071
-- Before any release: the text does not say which rate to use.
#ASSERT `s 2(2) the rate of unemployment most recently produced` (LIST `the January release`, `the February release`, `the March release`) (YMD 2025 12 31) EQUALS NOTHING
#ASSERT `s 2(2) the rate of unemployment most recently produced` (LIST `the January release`) (YMD 2026 1 14) EQUALS NOTHING
