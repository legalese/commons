#ASSERT `Are unemployment benefits payable to me under Part I` TRUE TRUE
#ASSERT NOT (`Are unemployment benefits payable to me under Part I` TRUE FALSE)
#ASSERT NOT (`Are unemployment benefits payable to me under Part I` FALSE TRUE)
