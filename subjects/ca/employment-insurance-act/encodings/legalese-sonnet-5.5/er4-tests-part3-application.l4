IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `er4-nouns`
IMPORT `er4-part3-application`

-- Tests of regs 68 to 76 (SOR-96-332.txt lines 1127-1170). Every expected value is written by hand from the text.

§ `Reg 68(1) -- the application`

#ASSERT `reg 68(1) the application is in the form the subsection requires` TRUE TRUE TRUE TRUE
#ASSERT NOT `reg 68(1) the application is in the form the subsection requires` FALSE TRUE TRUE TRUE
#ASSERT NOT `reg 68(1) the application is in the form the subsection requires` TRUE FALSE TRUE TRUE
#ASSERT NOT `reg 68(1) the application is in the form the subsection requires` TRUE TRUE FALSE TRUE
#ASSERT NOT `reg 68(1) the application is in the form the subsection requires` TRUE TRUE TRUE FALSE

§ `Reg 68(2) -- 30 days to provide what is asked for`

-- A request on 2 March 2026: 30 days after is 1 April 2026.
#ASSERT `reg 68(2) the last day for the employer to provide the information or documentation` (YearMonthDay 2026 3 2) EQUALS YearMonthDay 2026 4 1
#ASSERT `reg 68(2) the employer provided the information or documentation within 30 days after the request` (YearMonthDay 2026 3 2) (JUST (YearMonthDay 2026 4 1))
#ASSERT NOT `reg 68(2) the employer provided the information or documentation within 30 days after the request` (YearMonthDay 2026 3 2) (JUST (YearMonthDay 2026 4 2))
#ASSERT NOT `reg 68(2) the employer provided the information or documentation within 30 days after the request` (YearMonthDay 2026 3 2) NOTHING
-- Incomplete, requested, not provided in time: an officer decides on what exists.
#ASSERT `reg 68(2) an officer of the Commission is to make a decision on the existing information or documentation` TRUE TRUE FALSE
#ASSERT NOT `reg 68(2) an officer of the Commission is to make a decision on the existing information or documentation` TRUE TRUE TRUE
#ASSERT NOT `reg 68(2) an officer of the Commission is to make a decision on the existing information or documentation` TRUE FALSE FALSE
#ASSERT NOT `reg 68(2) an officer of the Commission is to make a decision on the existing information or documentation` FALSE TRUE FALSE

§ `Reg 69(1) -- the five categories`

-- Arguments: kind of plan, the plan satisfies its section, eligibility to use paid sick leave deferred under 65(d).
#ASSERT `reg 69(1) the category the insured person is placed in` `er4 a Weekly Indemnity Plan` TRUE FALSE EQUALS `er4 insured persons covered by a plan that satisfies the requirements of section 63`
#ASSERT `reg 69(1) the category the insured person is placed in` `er4 a Special Weekly Indemnity Plan` TRUE FALSE EQUALS `er4 insured persons covered by a plan that satisfies the requirements of section 64`
#ASSERT `reg 69(1) the category the insured person is placed in` `er4 a Cumulative Paid Sick Leave Plan` TRUE FALSE EQUALS `er4 insured persons covered by a plan that satisfies the requirements of section 65, except those referred to in paragraph 65(d)`
#ASSERT `reg 69(1) the category the insured person is placed in` `er4 an Enhanced Cumulative Paid Sick Leave Plan` TRUE FALSE EQUALS `er4 insured persons covered by a plan that satisfies the requirements of section 66, except those referred to in paragraph 65(d)`
-- Those referred to in 65(d) fall into (e), "all other insured persons".
#ASSERT `reg 69(1) the category the insured person is placed in` `er4 a Cumulative Paid Sick Leave Plan` TRUE TRUE EQUALS `er4 all other insured persons, including those referred to in paragraph 65(d)`
#ASSERT `reg 69(1) the category the insured person is placed in` `er4 an Enhanced Cumulative Paid Sick Leave Plan` TRUE TRUE EQUALS `er4 all other insured persons, including those referred to in paragraph 65(d)`
-- A plan that does not satisfy its section, or is of no named kind: (e).
#ASSERT `reg 69(1) the category the insured person is placed in` `er4 a Weekly Indemnity Plan` FALSE FALSE EQUALS `er4 all other insured persons, including those referred to in paragraph 65(d)`
#ASSERT `reg 69(1) the category the insured person is placed in` `er4 another wage-loss plan` TRUE FALSE EQUALS `er4 all other insured persons, including those referred to in paragraph 65(d)`
-- The 65(d) exception does not touch a person under a plan of section 63.
#ASSERT `reg 69(1) the category the insured person is placed in` `er4 a Weekly Indemnity Plan` TRUE TRUE EQUALS `er4 insured persons covered by a plan that satisfies the requirements of section 63`

§ `Reg 69(2), (3), (4) -- account numbers and remittances`

-- Before the Commission's notification the duty has not arisen.
#ASSERT `reg 69(2) the employer has done what the subsection requires` FALSE FALSE FALSE
#ASSERT `reg 69(2) the employer has done what the subsection requires` TRUE TRUE TRUE
#ASSERT NOT `reg 69(2) the employer has done what the subsection requires` TRUE FALSE TRUE
#ASSERT NOT `reg 69(2) the employer has done what the subsection requires` TRUE TRUE FALSE
-- (3): needs a change in the categories AND the Commission's notification to arise.
#ASSERT `reg 69(3) the employer has done what the subsection requires` FALSE TRUE FALSE FALSE
#ASSERT `reg 69(3) the employer has done what the subsection requires` TRUE FALSE FALSE FALSE
#ASSERT `reg 69(3) the employer has done what the subsection requires` TRUE TRUE TRUE TRUE
#ASSERT NOT `reg 69(3) the employer has done what the subsection requires` TRUE TRUE FALSE TRUE
#ASSERT NOT `reg 69(3) the employer has done what the subsection requires` TRUE TRUE TRUE FALSE
#ASSERT `reg 69(4) the employer has done what the subsection requires for the year` TRUE TRUE
#ASSERT NOT `reg 69(4) the employer has done what the subsection requires for the year` FALSE TRUE
#ASSERT NOT `reg 69(4) the employer has done what the subsection requires for the year` TRUE FALSE

§ `Reg 70 -- 30 days to tell the Commission, and apply for a continuation`

-- A modification on 15 June 2026: 30 days after is 15 July 2026.
#ASSERT `reg 70(a) the last day for the employer to notify the Commission` (YearMonthDay 2026 6 15) EQUALS YearMonthDay 2026 7 15
#ASSERT `reg 70(a) the employer notified the Commission within 30 days after the modification or replacement` (YearMonthDay 2026 6 15) (JUST (YearMonthDay 2026 7 15))
#ASSERT NOT `reg 70(a) the employer notified the Commission within 30 days after the modification or replacement` (YearMonthDay 2026 6 15) (JUST (YearMonthDay 2026 7 16))
#ASSERT NOT `reg 70(a) the employer notified the Commission within 30 days after the modification or replacement` (YearMonthDay 2026 6 15) NOTHING
#ASSERT `reg 70 the employer has done what the section requires` TRUE TRUE
#ASSERT NOT `reg 70 the employer has done what the section requires` TRUE FALSE
#ASSERT NOT `reg 70 the employer has done what the section requires` FALSE TRUE

§ `Reg 71 -- the effective date of the reduction`

-- Initial application on or before the 15th of March: 1 April. After the 15th: 1 May.
#ASSERT `reg 71 the effective date of the reduction of the employer's premium rate` TRUE (YearMonthDay 2026 3 15) (YearMonthDay 2026 9 1) EQUALS YearMonthDay 2026 4 1
#ASSERT `reg 71 the effective date of the reduction of the employer's premium rate` TRUE (YearMonthDay 2026 3 16) (YearMonthDay 2026 9 1) EQUALS YearMonthDay 2026 5 1
#ASSERT `reg 71 the effective date of the reduction of the employer's premium rate` TRUE (YearMonthDay 2026 3 1) (YearMonthDay 2026 9 1) EQUALS YearMonthDay 2026 4 1
-- Across the year end.
#ASSERT `reg 71 the effective date of the reduction of the employer's premium rate` TRUE (YearMonthDay 2026 12 10) (YearMonthDay 2026 9 1) EQUALS YearMonthDay 2027 1 1
#ASSERT `reg 71 the effective date of the reduction of the employer's premium rate` TRUE (YearMonthDay 2026 12 20) (YearMonthDay 2026 9 1) EQUALS YearMonthDay 2027 2 1
-- A continuation: the effective date of the modification or replacement.
#ASSERT `reg 71 the effective date of the reduction of the employer's premium rate` FALSE (YearMonthDay 2026 3 16) (YearMonthDay 2026 9 1) EQUALS YearMonthDay 2026 9 1

§ `Reg 72 -- the officer`

#ASSERT `reg 72(1) an officer of the Commission is to decide whether the employer meets or continues to meet the requirements and notify the employer` TRUE
#ASSERT NOT `reg 72(1) an officer of the Commission is to decide whether the employer meets or continues to meet the requirements and notify the employer` FALSE
#ASSERT `reg 72(2) an officer of the Commission is to give the employer an opportunity to be heard, then decide and notify the employer` TRUE TRUE
#ASSERT NOT `reg 72(2) an officer of the Commission is to give the employer an opportunity to be heard, then decide and notify the employer` TRUE FALSE
#ASSERT NOT `reg 72(2) an officer of the Commission is to give the employer an opportunity to be heard, then decide and notify the employer` FALSE TRUE
-- Terminate only when the plan HAS CEASED to meet 63(d): it met it before and does not now.
#ASSERT `reg 72(3) an officer of the Commission is to terminate entitlement to the reduction and notify the employer` TRUE FALSE
#ASSERT NOT `reg 72(3) an officer of the Commission is to terminate entitlement to the reduction and notify the employer` TRUE TRUE
#ASSERT NOT `reg 72(3) an officer of the Commission is to terminate entitlement to the reduction and notify the employer` FALSE FALSE

§ `Reg 73 -- evidence on a late application`

#ASSERT `reg 73 the employer has produced the evidence the regulation requires` FALSE FALSE
#ASSERT `reg 73 the employer has produced the evidence the regulation requires` TRUE TRUE
#ASSERT NOT `reg 73 the employer has produced the evidence the regulation requires` TRUE FALSE

§ `Reg 74 -- 30 days to tell the Commission the plan has ended`

-- A plan terminated on 10 February 2026 (28 days in February): 30 days after is 12 March 2026.
#ASSERT `reg 74 the last day for the employer to notify the Commission of the termination` (YearMonthDay 2026 2 10) EQUALS YearMonthDay 2026 3 12
#ASSERT `reg 74 the employer notified the Commission of the termination within 30 days` (YearMonthDay 2026 2 10) (JUST (YearMonthDay 2026 3 12))
#ASSERT NOT `reg 74 the employer notified the Commission of the termination within 30 days` (YearMonthDay 2026 2 10) (JUST (YearMonthDay 2026 3 13))
#ASSERT NOT `reg 74 the employer notified the Commission of the termination within 30 days` (YearMonthDay 2026 2 10) NOTHING

§ `Reg 75 -- appeal within one year after notice is sent`

#ASSERT `reg 75 the last day for the employer to appeal` (YearMonthDay 2026 5 20) EQUALS YearMonthDay 2027 5 20
-- A notice sent on 29 February 2024: the year ends on 28 February 2025.
#ASSERT `reg 75 the last day for the employer to appeal` (YearMonthDay 2024 2 29) EQUALS YearMonthDay 2025 2 28
#ASSERT `reg 75 the employer may appeal to the Commission` `er4 a decision made pursuant to section 72 of these Regulations` (YearMonthDay 2026 5 20) (YearMonthDay 2027 5 20) EQUALS JUST TRUE
#ASSERT `reg 75 the employer may appeal to the Commission` `er4 a decision made pursuant to section 72 of these Regulations` (YearMonthDay 2026 5 20) (YearMonthDay 2027 5 21) EQUALS JUST FALSE
#ASSERT `reg 75 the employer may appeal to the Commission` `er4 a decision made pursuant to subsection 69(4) of the Act` (YearMonthDay 2026 5 20) (YearMonthDay 2026 6 1) EQUALS JUST TRUE
#ASSERT `reg 75 the employer may appeal to the Commission` `er4 a new decision made pursuant to subsection 69(5) of the Act` (YearMonthDay 2026 5 20) (YearMonthDay 2027 5 21) EQUALS JUST FALSE
-- A decision of another kind: the regulation does not speak.
#ASSERT `reg 75 the employer may appeal to the Commission` `er4 another decision` (YearMonthDay 2026 5 20) (YearMonthDay 2026 6 1) EQUALS NOTHING

§ `Reg 76 -- the application for the year 1995`

#ASSERT `reg 76 December 4, 1994` EQUALS YearMonthDay 1994 12 4
#ASSERT `reg 76 the Commission may reconsider the application for the year 1995` (YearMonthDay 1994 12 3) TRUE TRUE
-- "Before December 4, 1994": an application made on the day itself is not before it.
#ASSERT NOT `reg 76 the Commission may reconsider the application for the year 1995` (YearMonthDay 1994 12 4) TRUE TRUE
#ASSERT NOT `reg 76 the Commission may reconsider the application for the year 1995` (YearMonthDay 1994 11 1) FALSE TRUE
#ASSERT NOT `reg 76 the Commission may reconsider the application for the year 1995` (YearMonthDay 1994 11 1) TRUE FALSE
