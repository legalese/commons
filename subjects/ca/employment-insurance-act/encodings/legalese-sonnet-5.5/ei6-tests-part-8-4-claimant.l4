IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `eia-core-interpretation`
IMPORT `ei6-part-8-4-claimant`

-- Tests of ei6-part-8-4-claimant (Act ss 153.5 and 153.6, src:2767-2803). Expected values are read from the text by hand.
-- Sections 22 to 24 are maternity, parental, caregiving and work-sharing benefits; section 21 is illness (src:483-689).

§ `Section 153.5(1)(a) - COVID-19`

#ASSERT `s 153.5(1)(a) COVID-19` EQUALS "the coronavirus disease 2019"

§ `Section 153.5(3) - the benefits referred to`

-- (3)(a): section 152.03 (Part VII.1), or Part I other than sections 22 to 24 (src:2785).
#ASSERT `s 153.5(3)(a) the benefit is referred to in paragraph (2)(b)` `Part VII.1` 152.03
#ASSERT NOT (`s 153.5(3)(a) the benefit is referred to in paragraph (2)(b)` `Part VII.1` 152.04)
#ASSERT `s 153.5(3)(a) the benefit is referred to in paragraph (2)(b)` `Part I` 12
#ASSERT `s 153.5(3)(a) the benefit is referred to in paragraph (2)(b)` `Part I` 21
#ASSERT NOT (`s 153.5(3)(a) the benefit is referred to in paragraph (2)(b)` `Part I` 22)
#ASSERT NOT (`s 153.5(3)(a) the benefit is referred to in paragraph (2)(b)` `Part I` 23.1)
#ASSERT NOT (`s 153.5(3)(a) the benefit is referred to in paragraph (2)(b)` `Part I` 24)
#ASSERT `s 153.5(3)(a) the benefit is referred to in paragraph (2)(b)` `Part I` 25
#ASSERT NOT (`s 153.5(3)(a) the benefit is referred to in paragraph (2)(b)` `Part VIII` 12)
-- (3)(b): Part I other than sections 21 to 24 (src:2786).
#ASSERT `s 153.5(3)(b) the benefit is referred to in paragraph (2)(c)` `Part I` 20
#ASSERT NOT (`s 153.5(3)(b) the benefit is referred to in paragraph (2)(c)` `Part I` 21)
#ASSERT NOT (`s 153.5(3)(b) the benefit is referred to in paragraph (2)(c)` `Part I` 23.3)
#ASSERT NOT (`s 153.5(3)(b) the benefit is referred to in paragraph (2)(c)` `Part I` 24)
#ASSERT `s 153.5(3)(b) the benefit is referred to in paragraph (2)(c)` `Part I` 25
#ASSERT NOT (`s 153.5(3)(b) the benefit is referred to in paragraph (2)(c)` `Part VII.1` 152.03)
-- (3)(c): the scheme established under Part VIII (src:2787).
#ASSERT `s 153.5(3)(c) the benefit is referred to in paragraph (2)(d)` `Part VIII`
#ASSERT NOT (`s 153.5(3)(c) the benefit is referred to in paragraph (2)(d)` `Part I`)

§ `Section 153.5(2) - the claimant`

-- (a) (src:2773)
#ASSERT `s 153.5(2)(a) claimant who ceases working for reasons related to COVID-19` TRUE TRUE
#ASSERT NOT (`s 153.5(2)(a) claimant who ceases working for reasons related to COVID-19` TRUE FALSE)
#ASSERT NOT (`s 153.5(2)(a) claimant who ceases working for reasons related to COVID-19` FALSE TRUE)
-- (b): a benefit period established on or after March 15, 2020 (src:2774).
#ASSERT `s 153.5(2)(b) claimant who could have had a benefit period established` (YearMonthDay 2020 3 15) TRUE
#ASSERT NOT (`s 153.5(2)(b) claimant who could have had a benefit period established` (YearMonthDay 2020 3 14) TRUE)
#ASSERT NOT (`s 153.5(2)(b) claimant who could have had a benefit period established` (YearMonthDay 2020 3 15) FALSE)
-- (c) and (d): the period December 29, 2019 to October 3, 2020 (src:2775, 2779).
#ASSERT NOT (`s 153.5(2)(c) and (d) the day falls within the period` (YearMonthDay 2019 12 28))
#ASSERT `s 153.5(2)(c) and (d) the day falls within the period` (YearMonthDay 2019 12 29)
#ASSERT `s 153.5(2)(c) and (d) the day falls within the period` (YearMonthDay 2020 10 3)
#ASSERT NOT (`s 153.5(2)(c) and (d) the day falls within the period` (YearMonthDay 2020 10 4))
-- (c): unable to start working, a benefit paid or payable, and one of (i) the benefit period ended, (ii) all paid,
-- (iii) some cannot be paid by virtue of 12(6).
#ASSERT `s 153.5(2)(c) claimant who is unable to start working after benefits under Part I` TRUE TRUE TRUE FALSE FALSE
#ASSERT `s 153.5(2)(c) claimant who is unable to start working after benefits under Part I` TRUE TRUE FALSE TRUE FALSE
#ASSERT `s 153.5(2)(c) claimant who is unable to start working after benefits under Part I` TRUE TRUE FALSE FALSE TRUE
#ASSERT NOT (`s 153.5(2)(c) claimant who is unable to start working after benefits under Part I` TRUE TRUE FALSE FALSE FALSE)
#ASSERT NOT (`s 153.5(2)(c) claimant who is unable to start working after benefits under Part I` FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`s 153.5(2)(c) claimant who is unable to start working after benefits under Part I` TRUE FALSE TRUE TRUE TRUE)
-- (d): the same with a benefit referred to in (3)(c) and subsection 8(18) of the Fishing Regulations.
#ASSERT `s 153.5(2)(d) claimant who is unable to start working after benefits under Part VIII` TRUE TRUE TRUE FALSE FALSE
#ASSERT `s 153.5(2)(d) claimant who is unable to start working after benefits under Part VIII` TRUE TRUE FALSE TRUE FALSE
#ASSERT `s 153.5(2)(d) claimant who is unable to start working after benefits under Part VIII` TRUE TRUE FALSE FALSE TRUE
#ASSERT NOT (`s 153.5(2)(d) claimant who is unable to start working after benefits under Part VIII` TRUE TRUE FALSE FALSE FALSE)
#ASSERT NOT (`s 153.5(2)(d) claimant who is unable to start working after benefits under Part VIII` FALSE TRUE TRUE TRUE TRUE)
-- (2): the four paragraphs are alternatives.
#ASSERT `s 153.5(2) claimant within the meaning of Part VIII.4` TRUE FALSE FALSE FALSE
#ASSERT `s 153.5(2) claimant within the meaning of Part VIII.4` FALSE TRUE FALSE FALSE
#ASSERT `s 153.5(2) claimant within the meaning of Part VIII.4` FALSE FALSE TRUE FALSE
#ASSERT `s 153.5(2) claimant within the meaning of Part VIII.4` FALSE FALSE FALSE TRUE
#ASSERT NOT (`s 153.5(2) claimant within the meaning of Part VIII.4` FALSE FALSE FALSE FALSE)

§ `Section 153.6 - the provisions that apply`

-- The provision is built: the Regulations? (BOOLEAN), the Part of the Act, the section number, the subsection or NOTHING.
-- (a): subsections 42(1) and (2) and sections 43, 44, 47, 50 and 52 (src:2792).
#ASSERT `s 153.6(1)(a) the provision is one of subsections 42(1) and (2) and sections 43, 44, 47, 50 and 52` (`ei6 Provision cited in section 153.6` OF FALSE, `Part VI`, 42, JUST 1)
#ASSERT `s 153.6(1)(a) the provision is one of subsections 42(1) and (2) and sections 43, 44, 47, 50 and 52` (`ei6 Provision cited in section 153.6` OF FALSE, `Part VI`, 42, JUST 2)
#ASSERT NOT (`s 153.6(1)(a) the provision is one of subsections 42(1) and (2) and sections 43, 44, 47, 50 and 52` (`ei6 Provision cited in section 153.6` OF FALSE, `Part VI`, 42, JUST 3))
#ASSERT `s 153.6(1)(a) the provision is one of subsections 42(1) and (2) and sections 43, 44, 47, 50 and 52` (`ei6 Provision cited in section 153.6` OF FALSE, `Part VI`, 43, NOTHING)
#ASSERT `s 153.6(1)(a) the provision is one of subsections 42(1) and (2) and sections 43, 44, 47, 50 and 52` (`ei6 Provision cited in section 153.6` OF FALSE, `Part VI`, 52, JUST 2)
#ASSERT `s 153.6(1)(a) the provision is one of subsections 42(1) and (2) and sections 43, 44, 47, 50 and 52` (`ei6 Provision cited in section 153.6` OF FALSE, `Part VI`, 50, NOTHING)
#ASSERT NOT (`s 153.6(1)(a) the provision is one of subsections 42(1) and (2) and sections 43, 44, 47, 50 and 52` (`ei6 Provision cited in section 153.6` OF FALSE, `Part VI`, 45, NOTHING))
#ASSERT NOT (`s 153.6(1)(a) the provision is one of subsections 42(1) and (2) and sections 43, 44, 47, 50 and 52` (`ei6 Provision cited in section 153.6` OF FALSE, `Part VI`, 41, NOTHING))
-- section 43 of the Regulations is not section 43 of the Act.
#ASSERT NOT (`s 153.6(1)(a) the provision is one of subsections 42(1) and (2) and sections 43, 44, 47, 50 and 52` (`ei6 Provision cited in section 153.6` OF TRUE, `Part I`, 43, NOTHING))
-- (b), (c): Parts II, III and IV (src:2793-2794).
#ASSERT `s 153.6(1)(b) and (c) the provision is one of Parts II, III and IV` (`ei6 Provision cited in section 153.6` OF FALSE, `Part II`, 59, NOTHING)
#ASSERT `s 153.6(1)(b) and (c) the provision is one of Parts II, III and IV` (`ei6 Provision cited in section 153.6` OF FALSE, `Part III`, 66, NOTHING)
#ASSERT `s 153.6(1)(b) and (c) the provision is one of Parts II, III and IV` (`ei6 Provision cited in section 153.6` OF FALSE, `Part IV`, 82, JUST 1)
#ASSERT NOT (`s 153.6(1)(b) and (c) the provision is one of Parts II, III and IV` (`ei6 Provision cited in section 153.6` OF FALSE, `Part I`, 7, NOTHING))
#ASSERT NOT (`s 153.6(1)(b) and (c) the provision is one of Parts II, III and IV` (`ei6 Provision cited in section 153.6` OF FALSE, `Part V`, 106, NOTHING))
#ASSERT NOT (`s 153.6(1)(b) and (c) the provision is one of Parts II, III and IV` (`ei6 Provision cited in section 153.6` OF TRUE, `Part II`, 59, NOTHING))
-- (d): Part VI except subsections 112(3) and 114(2) and sections 115 and 140 (src:2795).
#ASSERT `s 153.6(1)(d) the provision is one of Part VI, except subsections 112(3) and 114(2) and sections 115 and 140` (`ei6 Provision cited in section 153.6` OF FALSE, `Part VI`, 111, NOTHING)
#ASSERT `s 153.6(1)(d) the provision is one of Part VI, except subsections 112(3) and 114(2) and sections 115 and 140` (`ei6 Provision cited in section 153.6` OF FALSE, `Part VI`, 112, JUST 2)
#ASSERT NOT (`s 153.6(1)(d) the provision is one of Part VI, except subsections 112(3) and 114(2) and sections 115 and 140` (`ei6 Provision cited in section 153.6` OF FALSE, `Part VI`, 112, JUST 3))
#ASSERT `s 153.6(1)(d) the provision is one of Part VI, except subsections 112(3) and 114(2) and sections 115 and 140` (`ei6 Provision cited in section 153.6` OF FALSE, `Part VI`, 114, JUST 1)
#ASSERT NOT (`s 153.6(1)(d) the provision is one of Part VI, except subsections 112(3) and 114(2) and sections 115 and 140` (`ei6 Provision cited in section 153.6` OF FALSE, `Part VI`, 114, JUST 2))
#ASSERT NOT (`s 153.6(1)(d) the provision is one of Part VI, except subsections 112(3) and 114(2) and sections 115 and 140` (`ei6 Provision cited in section 153.6` OF FALSE, `Part VI`, 115, NOTHING))
#ASSERT NOT (`s 153.6(1)(d) the provision is one of Part VI, except subsections 112(3) and 114(2) and sections 115 and 140` (`ei6 Provision cited in section 153.6` OF FALSE, `Part VI`, 140, NOTHING))
#ASSERT `s 153.6(1)(d) the provision is one of Part VI, except subsections 112(3) and 114(2) and sections 115 and 140` (`ei6 Provision cited in section 153.6` OF FALSE, `Part VI`, 139, NOTHING)
#ASSERT NOT (`s 153.6(1)(d) the provision is one of Part VI, except subsections 112(3) and 114(2) and sections 115 and 140` (`ei6 Provision cited in section 153.6` OF FALSE, `Part VII`, 144, NOTHING))
-- (e): section 27 and subsections 92(1) to (5) and (8) of the Regulations (src:2796).
#ASSERT `s 153.6(1)(e) the provision is section 27 or one of subsections 92(1) to (5) and (8) of the Regulations` (`ei6 Provision cited in section 153.6` OF TRUE, `Part I`, 27, NOTHING)
#ASSERT `s 153.6(1)(e) the provision is section 27 or one of subsections 92(1) to (5) and (8) of the Regulations` (`ei6 Provision cited in section 153.6` OF TRUE, `Part I`, 27, JUST 2)
#ASSERT `s 153.6(1)(e) the provision is section 27 or one of subsections 92(1) to (5) and (8) of the Regulations` (`ei6 Provision cited in section 153.6` OF TRUE, `Part I`, 92, JUST 1)
#ASSERT `s 153.6(1)(e) the provision is section 27 or one of subsections 92(1) to (5) and (8) of the Regulations` (`ei6 Provision cited in section 153.6` OF TRUE, `Part I`, 92, JUST 5)
#ASSERT NOT (`s 153.6(1)(e) the provision is section 27 or one of subsections 92(1) to (5) and (8) of the Regulations` (`ei6 Provision cited in section 153.6` OF TRUE, `Part I`, 92, JUST 6))
#ASSERT NOT (`s 153.6(1)(e) the provision is section 27 or one of subsections 92(1) to (5) and (8) of the Regulations` (`ei6 Provision cited in section 153.6` OF TRUE, `Part I`, 92, JUST 7))
#ASSERT `s 153.6(1)(e) the provision is section 27 or one of subsections 92(1) to (5) and (8) of the Regulations` (`ei6 Provision cited in section 153.6` OF TRUE, `Part I`, 92, JUST 8)
#ASSERT NOT (`s 153.6(1)(e) the provision is section 27 or one of subsections 92(1) to (5) and (8) of the Regulations` (`ei6 Provision cited in section 153.6` OF TRUE, `Part I`, 26, NOTHING))
-- section 27 of the Act is not section 27 of the Regulations.
#ASSERT NOT (`s 153.6(1)(e) the provision is section 27 or one of subsections 92(1) to (5) and (8) of the Regulations` (`ei6 Provision cited in section 153.6` OF FALSE, `Part I`, 27, NOTHING))

§ `Section 153.6(1) and (3) - the provision applies, and (2) it is adapted`

-- Section 43 of the Act applies by (1)(a); a section of Part I does not, unless it is a definition of subsection 2(1)
-- or a contrary intention appears (src:2803).
#ASSERT `s 153.6 the provision applies in respect of a claim for the emergency response benefit` (`ei6 Provision cited in section 153.6` OF FALSE, `Part VI`, 43, NOTHING) FALSE FALSE
#ASSERT NOT (`s 153.6 the provision applies in respect of a claim for the emergency response benefit` (`ei6 Provision cited in section 153.6` OF FALSE, `Part I`, 7, NOTHING) FALSE FALSE)
#ASSERT `s 153.6 the provision applies in respect of a claim for the emergency response benefit` (`ei6 Provision cited in section 153.6` OF FALSE, `Part I`, 7, NOTHING) TRUE FALSE
#ASSERT `s 153.6 the provision applies in respect of a claim for the emergency response benefit` (`ei6 Provision cited in section 153.6` OF FALSE, `Part I`, 7, NOTHING) FALSE TRUE
#ASSERT `s 153.6 the provision applies in respect of a claim for the emergency response benefit` (`ei6 Provision cited in section 153.6` OF FALSE, `Part II`, 59, NOTHING) FALSE FALSE
-- (2): the provisions of (a), (d) and (e) are adapted; those of Parts II, III and IV are not.
#ASSERT `s 153.6(2) the provision is adapted for the emergency response benefit` (`ei6 Provision cited in section 153.6` OF FALSE, `Part VI`, 44, NOTHING)
#ASSERT `s 153.6(2) the provision is adapted for the emergency response benefit` (`ei6 Provision cited in section 153.6` OF FALSE, `Part VI`, 112, JUST 1)
#ASSERT `s 153.6(2) the provision is adapted for the emergency response benefit` (`ei6 Provision cited in section 153.6` OF TRUE, `Part I`, 27, NOTHING)
#ASSERT NOT (`s 153.6(2) the provision is adapted for the emergency response benefit` (`ei6 Provision cited in section 153.6` OF FALSE, `Part II`, 59, NOTHING))
#ASSERT NOT (`s 153.6(2) the provision is adapted for the emergency response benefit` (`ei6 Provision cited in section 153.6` OF FALSE, `Part IV`, 82, NOTHING))
-- (2)(b): "entitled" means "eligible" under section 153.9.
#ASSERT `s 153.6(2)(b) the claimant is entitled for the purposes of an adapted provision` TRUE
#ASSERT NOT (`s 153.6(2)(b) the claimant is entitled for the purposes of an adapted provision` FALSE)
#ASSERT `s 153.6(2)(a) how an adapted provision reads a reference to claimants and benefits` EQUALS "the claimant within the meaning of Part VIII.4 and the employment insurance emergency response benefit provided under Part VIII.4"
#ASSERT `s 153.6(2)(c) how an adapted provision reads a reference to regulations made under the Act` EQUALS "the reference to the regulations made under the authority of the Act is read without that reference"
