IMPORT prelude
IMPORT daydate
IMPORT `eia-core`
IMPORT `ei2-nouns`
IMPORT `ei2-penalties`

-- Tests of ei2-penalties (ss 38 to 41.1). Expected values are written by hand from the text.

§ `s 38(1) - the acts or omissions`

-- The Commission's opinion is the gate: all eight acts together do nothing without it.
#ASSERT NOT `s 38(1) the Commission may impose a penalty on the claimant or a person acting for the claimant` FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE
-- Each act alone, with the Commission's opinion: (a) to (h).
#ASSERT `s 38(1) the Commission may impose a penalty on the claimant or a person acting for the claimant` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE
#ASSERT `s 38(1) the Commission may impose a penalty on the claimant or a person acting for the claimant` TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE
#ASSERT `s 38(1) the Commission may impose a penalty on the claimant or a person acting for the claimant` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE
#ASSERT `s 38(1) the Commission may impose a penalty on the claimant or a person acting for the claimant` TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE
#ASSERT `s 38(1) the Commission may impose a penalty on the claimant or a person acting for the claimant` TRUE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE
#ASSERT `s 38(1) the Commission may impose a penalty on the claimant or a person acting for the claimant` TRUE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE
#ASSERT `s 38(1) the Commission may impose a penalty on the claimant or a person acting for the claimant` TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE
#ASSERT `s 38(1) the Commission may impose a penalty on the claimant or a person acting for the claimant` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE
-- The Commission's opinion but no act.
#ASSERT NOT `s 38(1) the Commission may impose a penalty on the claimant or a person acting for the claimant` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE

§ `s 38(2) - the ceilings`

-- Weekly rate $500: (a) three times is $1,500.
#ASSERT `s 38(2)(a) three times the claimant's rate of weekly benefits` 500 EQUALS 1500
-- (b)(i) a deduction of $400: $1,200. (b)(ii) benefits of $900 that would have been paid: $2,700. (c) maximum rate $650: $1,950.
#ASSERT `s 38(2)(b)(i) three times the amount of the deduction under subsection 19(3)` 400 EQUALS 1200
#ASSERT `s 38(2)(b)(ii) three times the benefits that would have been paid` 900 EQUALS 2700
#ASSERT `s 38(2)(c) three times the maximum rate of weekly benefits in effect when the act or omission occurred` 650 EQUALS 1950
-- No benefit period was established: limb (c) alone.
#ASSERT `s 38(2) the most the Commission may set as the amount of the penalty` FALSE FALSE 0 0 0 650 EQUALS 1950
-- A benefit period, not a (1)(c) penalty: limb (a).
#ASSERT `s 38(2) the most the Commission may set as the amount of the penalty` TRUE FALSE 500 400 900 650 EQUALS 1500
-- A (1)(c) penalty: limb (b) is the lesser of its two parts, $1,200; the larger of limb (a) $1,500 and limb (b) $1,200 is $1,500 (fork ei2-F8).
#ASSERT `s 38(2) the most the Commission may set as the amount of the penalty` TRUE TRUE 500 400 900 650 EQUALS 1500
-- A (1)(c) penalty where limb (b) is the larger: weekly rate $200 (limb (a) $600), deduction $400 and would-have-paid $300: parts $1,200 and $900, lesser $900.
#ASSERT `s 38(2) the most the Commission may set as the amount of the penalty` TRUE TRUE 200 400 300 650 EQUALS 900
-- Equal limbs.
#ASSERT `s 38(2) the most the Commission may set as the amount of the penalty` TRUE TRUE 500 500 500 650 EQUALS 1500

-- (3) repaid weeks of regular benefits are deemed paid for s 145(2)
#ASSERT `s 38(3) the repaid weeks are deemed to be weeks of regular benefits paid for the purposes of subsection 145(2)` TRUE EQUALS JUST TRUE
#ASSERT `s 38(3) the repaid weeks are deemed to be weeks of regular benefits paid for the purposes of subsection 145(2)` FALSE EQUALS NOTHING

§ `s 39 - employers`

-- (1): the Commission's opinion and one of the five acts (a) to (e).
#ASSERT NOT `s 39(1) the Commission may impose a penalty on the employer or a person acting for the employer` FALSE TRUE TRUE TRUE TRUE TRUE
#ASSERT `s 39(1) the Commission may impose a penalty on the employer or a person acting for the employer` TRUE TRUE FALSE FALSE FALSE FALSE
#ASSERT `s 39(1) the Commission may impose a penalty on the employer or a person acting for the employer` TRUE FALSE TRUE FALSE FALSE FALSE
#ASSERT `s 39(1) the Commission may impose a penalty on the employer or a person acting for the employer` TRUE FALSE FALSE TRUE FALSE FALSE
#ASSERT `s 39(1) the Commission may impose a penalty on the employer or a person acting for the employer` TRUE FALSE FALSE FALSE TRUE FALSE
#ASSERT `s 39(1) the Commission may impose a penalty on the employer or a person acting for the employer` TRUE FALSE FALSE FALSE FALSE TRUE
#ASSERT NOT `s 39(1) the Commission may impose a penalty on the employer or a person acting for the employer` TRUE FALSE FALSE FALSE FALSE FALSE
-- (3): both the corporation's act and the officer's part in it.
#ASSERT `s 39(3) the Commission may impose a penalty on an officer, director or agent of the corporation` TRUE TRUE
#ASSERT NOT `s 39(3) the Commission may impose a penalty on an officer, director or agent of the corporation` TRUE FALSE
#ASSERT NOT `s 39(3) the Commission may impose a penalty on an officer, director or agent of the corporation` FALSE TRUE
-- (2): nine times a maximum rate of $650 is $5,850.
#ASSERT `s 39(2) nine times the maximum rate of weekly benefits in effect when the penalty is imposed` 650 EQUALS 5850
-- (4): the greater of $12,000 and the section 38 penalty: $11,999 and $12,000 give $12,000; $12,001 gives $12,001.
#ASSERT `s 39(4) the greater of $12,000 and the penalty imposed under section 38` 11999 EQUALS 12000
#ASSERT `s 39(4) the greater of $12,000 and the penalty imposed under section 38` 12000 EQUALS 12000
#ASSERT `s 39(4) the greater of $12,000 and the penalty imposed under section 38` 12001 EQUALS 12001
-- The most: ordinary act, (2).
#ASSERT `s 39 the most the Commission may set as the amount of the penalty` 650 FALSE 0 FALSE 0 EQUALS 5850
-- An act involving information on which entitlement depends: (4) replaces (2) "notwithstanding subsection (2)" (even where lower than (2)'s figure).
#ASSERT `s 39 the most the Commission may set as the amount of the penalty` 650 TRUE 3000 FALSE 0 EQUALS 12000
#ASSERT `s 39 the most the Commission may set as the amount of the penalty` 650 TRUE 15000 FALSE 0 EQUALS 15000
-- A major contravention: the regulations' amount.
#ASSERT `s 39 the most the Commission may set as the amount of the penalty` 650 FALSE 0 TRUE 25000 EQUALS 25000
-- Both: the greater of the two (fork ei2-F9).
#ASSERT `s 39 the most the Commission may set as the amount of the penalty` 650 TRUE 3000 TRUE 25000 EQUALS 25000
#ASSERT `s 39 the most the Commission may set as the amount of the penalty` 650 TRUE 30000 TRUE 25000 EQUALS 30000

§ `s 40 - limits on imposing a penalty`

-- (a) a prosecution has been initiated
#ASSERT `s 40 a penalty shall not be imposed` TRUE (YMD 2024 1 15) (YMD 2024 2 1)
-- (b) act on 15 January 2020: 36 months on is 15 January 2023, still within the 36 months; 16 January 2023 is after
#ASSERT NOT `s 40 a penalty shall not be imposed` FALSE (YMD 2020 1 15) (YMD 2023 1 15)
#ASSERT `s 40 a penalty shall not be imposed` FALSE (YMD 2020 1 15) (YMD 2023 1 16)
#ASSERT NOT `s 40 a penalty shall not be imposed` FALSE (YMD 2020 1 15) (YMD 2022 12 31)
-- an act on 31 January 2020: 36 months on is 31 January 2023
#ASSERT NOT `s 40 a penalty shall not be imposed` FALSE (YMD 2020 1 31) (YMD 2023 1 31)
#ASSERT `s 40 a penalty shall not be imposed` FALSE (YMD 2020 1 31) (YMD 2023 2 1)
-- an act on a leap day, 29 February 2020: the clamped anniversary is 28 February 2023
#ASSERT NOT `s 40 a penalty shall not be imposed` FALSE (YMD 2020 2 29) (YMD 2023 2 28)
#ASSERT `s 40 a penalty shall not be imposed` FALSE (YMD 2020 2 29) (YMD 2023 3 1)

§ `s 41 and s 41.1`

#ASSERT `s 41 the Commission may rescind the imposition of the penalty, or reduce it` TRUE FALSE
#ASSERT `s 41 the Commission may rescind the imposition of the penalty, or reduce it` FALSE TRUE
#ASSERT NOT `s 41 the Commission may rescind the imposition of the penalty, or reduce it` FALSE FALSE
#ASSERT `s 41.1(1) the Commission may issue a warning instead of setting the amount of a penalty` TRUE
#ASSERT NOT `s 41.1(1) the Commission may issue a warning instead of setting the amount of a penalty` FALSE
-- (2) within 72 months after the day: act on 15 January 2020, 72 months on is 15 January 2026
#ASSERT `s 41.1(2) a warning may be issued on the day` (YMD 2020 1 15) (YMD 2026 1 15)
#ASSERT NOT `s 41.1(2) a warning may be issued on the day` (YMD 2020 1 15) (YMD 2026 1 16)
-- after 36 months and before 72: a warning may be issued although a penalty may not
#ASSERT `s 41.1(2) a warning may be issued on the day` (YMD 2020 1 15) (YMD 2024 6 1)
#ASSERT `s 40 a penalty shall not be imposed` FALSE (YMD 2020 1 15) (YMD 2024 6 1)
