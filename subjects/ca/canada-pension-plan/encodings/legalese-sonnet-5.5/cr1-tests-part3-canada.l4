IMPORT prelude
IMPORT `cpp-core`
IMPORT `cr1-schedules`
IMPORT `cr1-part3-canada`

-- Tests of cr1-part3-canada.l4 (regulations 22 to 28). Every expected value is written from the text
-- (C.R.C.-c.-385.txt lines 296 to 355) before the run. The two provinces are invented.

§ `Tests of regulations 22 to 28`

§§ `Fixtures`

`cr1 test province with a plan` MEANS Province WITH
    `name of the province` IS "Province A"
    `a province providing a comprehensive pension plan` IS TRUE

`cr1 test province without a plan` MEANS Province WITH
    `name of the province` IS "Province B"
    `a province providing a comprehensive pension plan` IS FALSE

§§ `Regulation 22(1), 22(2) and 22(3)`

#ASSERT `reg 22(1) — the entire employment by an employer not resident in Canada and without an establishment in Canada is excepted` FALSE FALSE
#ASSERT NOT (`reg 22(1) — the entire employment by an employer not resident in Canada and without an establishment in Canada is excepted` TRUE FALSE)
#ASSERT NOT (`reg 22(1) — the entire employment by an employer not resident in Canada and without an establishment in Canada is excepted` FALSE TRUE)
-- (2)(a): in Canada; the person resident in Canada; the employer neither resident nor with an establishment.
#ASSERT `reg 22(2)(a) — the employment in Canada of a person resident in Canada by an employer not resident and without an establishment` TRUE TRUE FALSE FALSE
#ASSERT NOT (`reg 22(2)(a) — the employment in Canada of a person resident in Canada by an employer not resident and without an establishment` FALSE TRUE FALSE FALSE)
#ASSERT NOT (`reg 22(2)(a) — the employment in Canada of a person resident in Canada by an employer not resident and without an establishment` TRUE FALSE FALSE FALSE)
#ASSERT NOT (`reg 22(2)(a) — the employment in Canada of a person resident in Canada by an employer not resident and without an establishment` TRUE TRUE TRUE FALSE)
#ASSERT NOT (`reg 22(2)(a) — the employment in Canada of a person resident in Canada by an employer not resident and without an establishment` TRUE TRUE FALSE TRUE)
#ASSERT `reg 22(2)(b) — the part in Canada of the employment of a person resident in Canada on a motor vehicle of an enterprise of the United States` TRUE TRUE TRUE
#ASSERT NOT (`reg 22(2)(b) — the part in Canada of the employment of a person resident in Canada on a motor vehicle of an enterprise of the United States` FALSE TRUE TRUE)
#ASSERT NOT (`reg 22(2)(b) — the part in Canada of the employment of a person resident in Canada on a motor vehicle of an enterprise of the United States` TRUE FALSE TRUE)
#ASSERT NOT (`reg 22(2)(b) — the part in Canada of the employment of a person resident in Canada on a motor vehicle of an enterprise of the United States` TRUE TRUE FALSE)
-- (3): in a province with a plan the arrangements must satisfy that plan's authority, in place of the Minister.
#ASSERT `reg 22(2) and (3) — pensionable employment includes the employment of a person under an employer not resident in Canada` TRUE `cr1 test province without a plan` TRUE FALSE
#ASSERT NOT (`reg 22(2) and (3) — pensionable employment includes the employment of a person under an employer not resident in Canada` TRUE `cr1 test province without a plan` FALSE TRUE)
#ASSERT `reg 22(2) and (3) — pensionable employment includes the employment of a person under an employer not resident in Canada` TRUE `cr1 test province with a plan` FALSE TRUE
#ASSERT NOT (`reg 22(2) and (3) — pensionable employment includes the employment of a person under an employer not resident in Canada` TRUE `cr1 test province with a plan` TRUE FALSE)
#ASSERT NOT (`reg 22(2) and (3) — pensionable employment includes the employment of a person under an employer not resident in Canada` FALSE `cr1 test province without a plan` TRUE TRUE)
-- Subsection (2) applies notwithstanding (1).
#ASSERT `reg 22 — the effect of regulation 22 on the employment` TRUE TRUE EQUALS `included in pensionable employment by subsection (2)`
#ASSERT `reg 22 — the effect of regulation 22 on the employment` TRUE FALSE EQUALS `included in pensionable employment by subsection (2)`
#ASSERT `reg 22 — the effect of regulation 22 on the employment` FALSE TRUE EQUALS `excepted from pensionable employment by subsection (1)`
#ASSERT `reg 22 — the effect of regulation 22 on the employment` FALSE FALSE EQUALS `not decided by regulation 22`
#ASSERT `reg 22(4) — paragraph 15(1)(b) of the Act does not apply to the employment` TRUE
#ASSERT NOT (`reg 22(4) — paragraph 15(1)(b) of the Act does not apply to the employment` FALSE)

§§ `Regulation 22(5): the province in which the employee is deemed to report for work`

#ASSERT `reg 22(5) — the province in which the employee is deemed to report for work` TRUE FALSE (JUST `cr1 test province with a plan`) `cr1 test province without a plan` EQUALS JUST `cr1 test province with a plan`
-- (b): where (a) cannot be determined, the province where the employee resides.
#ASSERT `reg 22(5) — the province in which the employee is deemed to report for work` TRUE FALSE NOTHING `cr1 test province without a plan` EQUALS JUST `cr1 test province without a plan`
-- The subsection speaks only of an employee referred to in (2) whose employer has no establishment in Canada.
#ASSERT `reg 22(5) — the province in which the employee is deemed to report for work` TRUE TRUE (JUST `cr1 test province with a plan`) `cr1 test province without a plan` EQUALS NOTHING
#ASSERT `reg 22(5) — the province in which the employee is deemed to report for work` FALSE FALSE (JUST `cr1 test province with a plan`) `cr1 test province without a plan` EQUALS NOTHING

§§ `Regulation 23: directors resident outside Canada`

-- Arguments: ordinarily resident in Canada; employed under a contract of service or apprenticeship; tenure of another office; holds the directorship; performed wholly or partly outside Canada.
#ASSERT `reg 23 — the employment of a director not ordinarily resident in Canada is excepted` FALSE FALSE FALSE TRUE TRUE
#ASSERT NOT (`reg 23 — the employment of a director not ordinarily resident in Canada is excepted` TRUE FALSE FALSE TRUE TRUE)
-- An employee otherwise than by the directorship (a contract of service, or the tenure of another office) is not within (b).
#ASSERT NOT (`reg 23 — the employment of a director not ordinarily resident in Canada is excepted` FALSE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`reg 23 — the employment of a director not ordinarily resident in Canada is excepted` FALSE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`reg 23 — the employment of a director not ordinarily resident in Canada is excepted` FALSE FALSE FALSE FALSE TRUE)
#ASSERT NOT (`reg 23 — the employment of a director not ordinarily resident in Canada is excepted` FALSE FALSE FALSE TRUE FALSE)

§§ `Regulation 24: provinces and their agents`

#ASSERT `reg 24(1) — employment by a province named in Schedule III or its agent is included` "Province of Ontario" TRUE FALSE
#ASSERT `reg 24(1) — employment by a province named in Schedule III or its agent is included` "Province of New Brunswick" TRUE FALSE
#ASSERT NOT (`reg 24(1) — employment by a province named in Schedule III or its agent is included` "Province of Ontario" TRUE TRUE)
#ASSERT NOT (`reg 24(1) — employment by a province named in Schedule III or its agent is included` "Province of Quebec" TRUE FALSE)
#ASSERT NOT (`reg 24(1) — employment by a province named in Schedule III or its agent is included` "Province of Ontario" FALSE FALSE)
#ASSERT `reg 24(2) — employment by a province providing a comprehensive pension plan or its agent is included` `cr1 test province with a plan` TRUE TRUE
#ASSERT NOT (`reg 24(2) — employment by a province providing a comprehensive pension plan or its agent is included` `cr1 test province without a plan` TRUE TRUE)
#ASSERT NOT (`reg 24(2) — employment by a province providing a comprehensive pension plan or its agent is included` `cr1 test province with a plan` TRUE FALSE)
#ASSERT NOT (`reg 24(2) — employment by a province providing a comprehensive pension plan or its agent is included` `cr1 test province with a plan` FALSE TRUE)
#ASSERT `reg 24(3) — the Act's provisions on contributions and Part III of the Act do not apply to the employment` TRUE
#ASSERT NOT (`reg 24(3) — the Act's provisions on contributions and Part III of the Act do not apply to the employment` FALSE)

§§ `Regulations 25 and 26`

GIVEN facts IS A LIST OF STRING
GIVETH A `cr1 Person employed by an international organization`
`cr1 test organization person in part 3` facts MEANS `cr1 Person employed by an international organization` WITH
    `exempt from Canadian income tax by virtue of a Tax Convention to which Canada is a party` IS elem "convention" facts
    `exempt from Canadian income tax by virtue of paragraph 149(1)(a) of the Income Tax Act` IS elem "149a" facts
    `exempt from Canadian income tax by virtue of an order of the Governor in Council` IS elem "order" facts
    `a citizen within the meaning of section 3 of the Citizenship Act` IS elem "citizen" facts
    `a permanent resident as defined in subsection 2(1) of the Immigration Act` IS elem "resident" facts
    `an official of the Commonwealth of Learning` IS elem "official" facts

GIVEN facts IS A LIST OF STRING
GIVETH A `cr1 Person employed by a foreign government`
`cr1 test foreign person in part 3` facts MEANS `cr1 Person employed by a foreign government` WITH
    `a subject or citizen of New Zealand` IS elem "nz" facts
    `exempt from Canadian income tax by virtue of the New Zealand-Canada Tax Convention` IS elem "nz tax" facts
    `a citizen of Canada` IS elem "canadian" facts
    `permanently resident in Canada` IS elem "resident" facts
    `contributes to a pension plan of the French Republic, or has contributions made on their behalf to such a plan by the French Republic` IS elem "french plan" facts
    `exempt from Canadian income tax` IS elem "exempt" facts
    `a citizen of the United States` IS elem "us" facts
    `participates in the Civil Service Retirement System of the United States or another pension plan financed by the Government of the United States, has done so continuously since before October 1, 1983 and has elected not to participate in the Canada Pension Plan` IS elem "csrs" facts
    `a locally engaged employee of the Government of the United States` IS elem "local" facts
    `a national of Japan` IS elem "japanese" facts
    `a national of Canada` IS elem "national of canada" facts
    `exempt from Canadian income tax by virtue of the Canada-Japan Income Tax Convention Act, 1965` IS elem "japan tax" facts
    `exempt from Canadian income tax by virtue of paragraph 149(1)(a) of the Income Tax Act` IS elem "149a" facts
    `exempt from Canadian income tax by virtue of paragraph 149(1)(b) of the Income Tax Act` IS elem "149b" facts
    `participates in the Government of Malaysia's non-contributory gratuity scheme` IS elem "gratuity" facts
    `a citizen of Senegal` IS elem "senegalese" facts

-- 25: an organization in Schedule V, in Canada, unless the employment is set out in Schedule VI.
#ASSERT `reg 25 — employment in Canada by an international organization is included` TRUE "Commonwealth of Learning" (`cr1 test organization person in part 3` EMPTY)
#ASSERT NOT (`reg 25 — employment in Canada by an international organization is included` TRUE "Commonwealth of Learning" (`cr1 test organization person in part 3` (LIST "official")))
#ASSERT NOT (`reg 25 — employment in Canada by an international organization is included` TRUE "Commonwealth of Learning" (`cr1 test organization person in part 3` (LIST "149a")))
#ASSERT `reg 25 — employment in Canada by an international organization is included` TRUE "Northwest Atlantic Fisheries Organization" (`cr1 test organization person in part 3` (LIST "citizen"))
#ASSERT NOT (`reg 25 — employment in Canada by an international organization is included` TRUE "Northwest Atlantic Fisheries Organization" (`cr1 test organization person in part 3` EMPTY))
#ASSERT NOT (`reg 25 — employment in Canada by an international organization is included` TRUE "United Nations" (`cr1 test organization person in part 3` (LIST "citizen")))
#ASSERT NOT (`reg 25 — employment in Canada by an international organization is included` FALSE "Commonwealth of Learning" (`cr1 test organization person in part 3` EMPTY))
#ASSERT `reg 25 — the employment is set out in Schedule VI` "Northwest Atlantic Fisheries Organization" (`cr1 test organization person in part 3` EMPTY)
#ASSERT NOT (`reg 25 — the employment is set out in Schedule VI` "United Nations" (`cr1 test organization person in part 3` EMPTY))
-- 26: a government in Schedule VII, in Canada, unless set out in Schedule VIII.
#ASSERT `reg 26 — employment in Canada by the government of a country other than Canada is included` TRUE "Australia" (`cr1 test foreign person in part 3` (LIST "canadian", "resident"))
#ASSERT NOT (`reg 26 — employment in Canada by the government of a country other than Canada is included` TRUE "Australia" (`cr1 test foreign person in part 3` (LIST "canadian")))
#ASSERT `reg 26 — employment in Canada by the government of a country other than Canada is included` TRUE "New Zealand" (`cr1 test foreign person in part 3` EMPTY)
#ASSERT NOT (`reg 26 — employment in Canada by the government of a country other than Canada is included` TRUE "New Zealand" (`cr1 test foreign person in part 3` (LIST "nz")))
#ASSERT NOT (`reg 26 — employment in Canada by the government of a country other than Canada is included` TRUE "Germany" (`cr1 test foreign person in part 3` EMPTY))
#ASSERT NOT (`reg 26 — employment in Canada by the government of a country other than Canada is included` FALSE "Australia" (`cr1 test foreign person in part 3` (LIST "canadian", "resident")))
#ASSERT `reg 26 — the employment is set out in Schedule VIII` "Senegal" (`cr1 test foreign person in part 3` (LIST "149b"))
#ASSERT NOT (`reg 26 — the employment is set out in Schedule VIII` "Germany" (`cr1 test foreign person in part 3` (LIST "149b")))

§§ `Regulation 27`

#ASSERT `reg 27 — the employment of a member of a religious order is included in pensionable employment` TRUE `cr1 test province with a plan` TRUE
#ASSERT NOT (`reg 27 — the employment of a member of a religious order is included in pensionable employment` FALSE `cr1 test province with a plan` TRUE)
#ASSERT NOT (`reg 27 — the employment of a member of a religious order is included in pensionable employment` TRUE `cr1 test province without a plan` TRUE)
#ASSERT NOT (`reg 27 — the employment of a member of a religious order is included in pensionable employment` TRUE `cr1 test province with a plan` FALSE)

§§ `Regulation 28: employment to an inconsiderable extent`

-- Arguments of 28(2): kind; in the regular employment of the employer; an entertainer; days employed in the year; hours employed in the year.
#ASSERT `reg 28(2) — the employment is employment in which persons are ordinarily employed to an inconsiderable extent` `abating a disaster` FALSE FALSE 0 0
#ASSERT NOT (`reg 28(2) — the employment is employment in which persons are ordinarily employed to an inconsiderable extent` `abating a disaster` TRUE FALSE 0 0)
#ASSERT `reg 28(2) — the employment is employment in which persons are ordinarily employed to an inconsiderable extent` `a rescue operation` FALSE FALSE 0 0
#ASSERT NOT (`reg 28(2) — the employment is employment in which persons are ordinarily employed to an inconsiderable extent` `a rescue operation` TRUE FALSE 0 0)
-- (b): a circus or fair etc., not an entertainer, not regular, under seven days in the year.
#ASSERT `reg 28(2) — the employment is employment in which persons are ordinarily employed to an inconsiderable extent` `employment, other than as an entertainer, at a circus, fair, parade, carnival, exposition, exhibition or other like activity` FALSE FALSE 6 0
#ASSERT NOT (`reg 28(2) — the employment is employment in which persons are ordinarily employed to an inconsiderable extent` `employment, other than as an entertainer, at a circus, fair, parade, carnival, exposition, exhibition or other like activity` FALSE FALSE 7 0)
#ASSERT NOT (`reg 28(2) — the employment is employment in which persons are ordinarily employed to an inconsiderable extent` `employment, other than as an entertainer, at a circus, fair, parade, carnival, exposition, exhibition or other like activity` FALSE TRUE 3 0)
#ASSERT NOT (`reg 28(2) — the employment is employment in which persons are ordinarily employed to an inconsiderable extent` `employment, other than as an entertainer, at a circus, fair, parade, carnival, exposition, exhibition or other like activity` TRUE FALSE 3 0)
-- (d): a referendum or election, not regularly employed, under 35 hours in the year.
#ASSERT `reg 28(2) — the employment is employment in which persons are ordinarily employed to an inconsiderable extent` `employment by the Government of Canada, the government of a province, a municipality or a school board in connection with a referendum or election to public office` FALSE FALSE 0 34
#ASSERT `reg 28(2) — the employment is employment in which persons are ordinarily employed to an inconsiderable extent` `employment by the Government of Canada, the government of a province, a municipality or a school board in connection with a referendum or election to public office` FALSE FALSE 0 34.5
#ASSERT NOT (`reg 28(2) — the employment is employment in which persons are ordinarily employed to an inconsiderable extent` `employment by the Government of Canada, the government of a province, a municipality or a school board in connection with a referendum or election to public office` FALSE FALSE 0 35)
#ASSERT NOT (`reg 28(2) — the employment is employment in which persons are ordinarily employed to an inconsiderable extent` `employment by the Government of Canada, the government of a province, a municipality or a school board in connection with a referendum or election to public office` TRUE FALSE 0 10)
#ASSERT NOT (`reg 28(2) — the employment is employment in which persons are ordinarily employed to an inconsiderable extent` `another kind of employment` FALSE FALSE 1 1)
-- (3): an excluded employment under (b) or (d) that becomes regular.
#ASSERT `reg 28(3) — an employment excluded under (2)(b) or (d) that becomes regular is pensionable employment` `employment, other than as an entertainer, at a circus, fair, parade, carnival, exposition, exhibition or other like activity` TRUE
#ASSERT `reg 28(3) — an employment excluded under (2)(b) or (d) that becomes regular is pensionable employment` `employment by the Government of Canada, the government of a province, a municipality or a school board in connection with a referendum or election to public office` TRUE
#ASSERT NOT (`reg 28(3) — an employment excluded under (2)(b) or (d) that becomes regular is pensionable employment` `abating a disaster` TRUE)
#ASSERT NOT (`reg 28(3) — an employment excluded under (2)(b) or (d) that becomes regular is pensionable employment` `employment, other than as an entertainer, at a circus, fair, parade, carnival, exposition, exhibition or other like activity` FALSE)
-- (4): the (b) employments with the same employer total more than six days in the year.
#ASSERT NOT (`reg 28(4) — the employments excluded under (2)(b), taken together, are pensionable employment` `employment, other than as an entertainer, at a circus, fair, parade, carnival, exposition, exhibition or other like activity` 6)
#ASSERT `reg 28(4) — the employments excluded under (2)(b), taken together, are pensionable employment` `employment, other than as an entertainer, at a circus, fair, parade, carnival, exposition, exhibition or other like activity` 7
#ASSERT NOT (`reg 28(4) — the employments excluded under (2)(b), taken together, are pensionable employment` `abating a disaster` 30)
-- (5): the (d) employments total more than 34 hours in the year.
#ASSERT NOT (`reg 28(5) — the employments excluded under (2)(d), taken together, are pensionable employment` `employment by the Government of Canada, the government of a province, a municipality or a school board in connection with a referendum or election to public office` 34)
#ASSERT `reg 28(5) — the employments excluded under (2)(d), taken together, are pensionable employment` `employment by the Government of Canada, the government of a province, a municipality or a school board in connection with a referendum or election to public office` 34.5
#ASSERT `reg 28(5) — the employments excluded under (2)(d), taken together, are pensionable employment` `employment by the Government of Canada, the government of a province, a municipality or a school board in connection with a referendum or election to public office` 35
#ASSERT NOT (`reg 28(5) — the employments excluded under (2)(d), taken together, are pensionable employment` `abating a disaster` 100)
-- (1): excepted unless (3), (4) or (5) takes it back. Arguments: kind; regular; entertainer; days; hours; becomes regular.
#ASSERT `reg 28(1) — the employment is excepted from pensionable employment as employment to an inconsiderable extent` `abating a disaster` FALSE FALSE 0 0 FALSE
#ASSERT `reg 28(1) — the employment is excepted from pensionable employment as employment to an inconsiderable extent` `abating a disaster` FALSE FALSE 0 0 TRUE
#ASSERT `reg 28(1) — the employment is excepted from pensionable employment as employment to an inconsiderable extent` `employment, other than as an entertainer, at a circus, fair, parade, carnival, exposition, exhibition or other like activity` FALSE FALSE 6 0 FALSE
#ASSERT NOT (`reg 28(1) — the employment is excepted from pensionable employment as employment to an inconsiderable extent` `employment, other than as an entertainer, at a circus, fair, parade, carnival, exposition, exhibition or other like activity` FALSE FALSE 7 0 FALSE)
#ASSERT NOT (`reg 28(1) — the employment is excepted from pensionable employment as employment to an inconsiderable extent` `employment, other than as an entertainer, at a circus, fair, parade, carnival, exposition, exhibition or other like activity` FALSE FALSE 3 0 TRUE)
#ASSERT `reg 28(1) — the employment is excepted from pensionable employment as employment to an inconsiderable extent` `employment by the Government of Canada, the government of a province, a municipality or a school board in connection with a referendum or election to public office` FALSE FALSE 0 30 FALSE
-- Between 34 and 35 hours (2)(d) still excludes the employment but (5) takes it back (fork F14).
#ASSERT NOT (`reg 28(1) — the employment is excepted from pensionable employment as employment to an inconsiderable extent` `employment by the Government of Canada, the government of a province, a municipality or a school board in connection with a referendum or election to public office` FALSE FALSE 0 34.5 FALSE)
#ASSERT NOT (`reg 28(1) — the employment is excepted from pensionable employment as employment to an inconsiderable extent` `employment by the Government of Canada, the government of a province, a municipality or a school board in connection with a referendum or election to public office` FALSE FALSE 0 30 TRUE)
