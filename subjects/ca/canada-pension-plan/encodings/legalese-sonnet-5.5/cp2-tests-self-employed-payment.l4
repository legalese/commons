IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cpp-core-calendar`
IMPORT `cpp-core-definitions`
IMPORT `cp2-self-employed-payment`

-- Tests of cp2-self-employed-payment.l4 (Act sections 33, 34, 36 and 37).
-- Expected values were decided by reading the section, then written down; none was copied from the rule's output.
-- Interest is simple, over 365 days, counted as the difference of two dates (fork F2); the sums below are chosen so that
-- the interest comes out whole (for example 73 days is a fifth of 365).

§ `Tests -- paying the self-employed contributions`

§§ `s 33 -- which way the person pays`

-- (1): $40 or less, or not required by section 155 or 156 of the Income Tax Act to pay instalments.
#ASSERT `s 33 — how the person must pay the contributions` 30 TRUE FALSE EQUALS `pay the whole amount on or before the balance-due day (subsection 33(1))`
#ASSERT `s 33 — how the person must pay the contributions` 40 TRUE TRUE EQUALS `pay the whole amount on or before the balance-due day (subsection 33(1))`
#ASSERT `s 33 — how the person must pay the contributions` 1000 FALSE FALSE EQUALS `pay the whole amount on or before the balance-due day (subsection 33(1))`
#ASSERT `s 33 — how the person must pay the contributions` 1000 FALSE TRUE EQUALS `pay the whole amount on or before the balance-due day (subsection 33(1))`
-- One cent over $40 and required to pay instalments: (2) for a farmer or fisher, (3) for everyone else.
#ASSERT `s 33 — how the person must pay the contributions` 40.01 TRUE TRUE EQUALS `pay two thirds on or before December 31 in each year (subsection 33(2), farmers and fishers)`
#ASSERT `s 33 — how the person must pay the contributions` 1000 TRUE TRUE EQUALS `pay two thirds on or before December 31 in each year (subsection 33(2), farmers and fishers)`
#ASSERT `s 33 — how the person must pay the contributions` 40.01 TRUE FALSE EQUALS `pay four quarterly instalments in the year (subsection 33(3))`
#ASSERT `s 33 — how the person must pay the contributions` 1000 TRUE FALSE EQUALS `pay four quarterly instalments in the year (subsection 33(3))`

§§ `s 33(1) -- the balance-due day`

-- 2026: April 30 of the following year; a death from November 2026 to April 2027 gives 6 months after the death.
#ASSERT `s 33(1) — the last day for paying the whole amount of the contributions` 2026 NOTHING EQUALS YMD 2027 4 30
#ASSERT `s 33(1) — the last day for paying the whole amount of the contributions` 2026 (JUST (YMD 2026 12 15)) EQUALS YMD 2027 6 15
#ASSERT `s 33(1) — the last day for paying the whole amount of the contributions` 2026 (JUST (YMD 2027 2 10)) EQUALS YMD 2027 8 10
-- A death in October 2026 is not "after October": April 30 applies.
#ASSERT `s 33(1) — the last day for paying the whole amount of the contributions` 2026 (JUST (YMD 2026 10 20)) EQUALS YMD 2027 4 30
#ASSERT `s 33(1) — the last day for paying the whole amount of the contributions` 2026 (JUST (YMD 2026 11 1)) EQUALS YMD 2027 5 1

§§ `s 33(2) -- farmers and fishers: two thirds by December 31`

#ASSERT `s 33(2) — the amount to pay on or before December 31` `two thirds of the contributions for the year as estimated by the person` 900 1500 EQUALS 600
#ASSERT `s 33(2) — the amount to pay on or before December 31` `two thirds of the contributions for the preceding year` 900 1500 EQUALS 1000
#ASSERT `s 33(2) — the last day for the payment` 2026 EQUALS YMD 2026 12 31

§§ `s 33(3) -- everyone else: four instalments`

#ASSERT `s 33(3) — the date the nth instalment is due in the year` 1 2026 EQUALS JUST (YMD 2026 3 15)
#ASSERT `s 33(3) — the date the nth instalment is due in the year` 2 2026 EQUALS JUST (YMD 2026 6 15)
#ASSERT `s 33(3) — the date the nth instalment is due in the year` 3 2026 EQUALS JUST (YMD 2026 9 15)
#ASSERT `s 33(3) — the date the nth instalment is due in the year` 4 2026 EQUALS JUST (YMD 2026 12 15)
#ASSERT `s 33(3) — the date the nth instalment is due in the year` 5 2026 EQUALS NOTHING
#ASSERT `s 33(3) — the date the nth instalment is due in the year` 0 2026 EQUALS NOTHING

-- Estimate 2000, preceding year 1600, second preceding year 1200.
-- (a)(i): 500 each; (a)(ii): 400 each.
#ASSERT `s 33(3) — the instalment due on the nth date` `one quarter of the contributions for the year as estimated by the person on each of the four days` 1 2000 1600 1200 EQUALS JUST 500
#ASSERT `s 33(3) — the instalment due on the nth date` `one quarter of the contributions for the year as estimated by the person on each of the four days` 4 2000 1600 1200 EQUALS JUST 500
#ASSERT `s 33(3) — the instalment due on the nth date` `one quarter of the contributions for the preceding year on each of the four days` 2 2000 1600 1200 EQUALS JUST 400
-- (b): March 15 and June 15 one quarter of the second preceding year (300); September 15 and December 15 half of (1600 less 600) = 500.
#ASSERT `s 33(3) — the instalment due on the nth date` `the amounts of paragraph 33(3)(b), from the second preceding year` 1 2000 1600 1200 EQUALS JUST 300
#ASSERT `s 33(3) — the instalment due on the nth date` `the amounts of paragraph 33(3)(b), from the second preceding year` 2 2000 1600 1200 EQUALS JUST 300
#ASSERT `s 33(3) — the instalment due on the nth date` `the amounts of paragraph 33(3)(b), from the second preceding year` 3 2000 1600 1200 EQUALS JUST 500
#ASSERT `s 33(3) — the instalment due on the nth date` `the amounts of paragraph 33(3)(b), from the second preceding year` 4 2000 1600 1200 EQUALS JUST 500
-- "the amount, if any, by which" the preceding year exceeds half the second preceding year: no excess gives nothing.
#ASSERT `s 33(3) — the instalment due on the nth date` `the amounts of paragraph 33(3)(b), from the second preceding year` 3 2000 500 1200 EQUALS JUST 0
#ASSERT `s 33(3) — the instalment due on the nth date` `the amounts of paragraph 33(3)(b), from the second preceding year` 3 2000 600 1200 EQUALS JUST 0
#ASSERT `s 33(3) — the instalment due on the nth date` `the amounts of paragraph 33(3)(b), from the second preceding year` 3 2000 700 1200 EQUALS JUST 50
-- Only four instalments exist.
#ASSERT `s 33(3) — the instalment due on the nth date` `one quarter of the contributions for the year as estimated by the person on each of the four days` 5 2000 1600 1200 EQUALS NOTHING
#ASSERT `s 33(3) — the instalment due on the nth date` `the amounts of paragraph 33(3)(b), from the second preceding year` 0 2000 1600 1200 EQUALS NOTHING
-- The running totals.
#ASSERT `s 33(3) — the total of the instalments due by the nth date` `one quarter of the contributions for the year as estimated by the person on each of the four days` 3 2000 1600 1200 EQUALS JUST 1500
#ASSERT `s 33(3) — the total of the instalments due by the nth date` `one quarter of the contributions for the preceding year on each of the four days` 4 2000 1600 1200 EQUALS JUST 1600
#ASSERT `s 33(3) — the total of the instalments due by the nth date` `the amounts of paragraph 33(3)(b), from the second preceding year` 1 2000 1600 1200 EQUALS JUST 300
#ASSERT `s 33(3) — the total of the instalments due by the nth date` `the amounts of paragraph 33(3)(b), from the second preceding year` 2 2000 1600 1200 EQUALS JUST 600
#ASSERT `s 33(3) — the total of the instalments due by the nth date` `the amounts of paragraph 33(3)(b), from the second preceding year` 3 2000 1600 1200 EQUALS JUST 1100
#ASSERT `s 33(3) — the total of the instalments due by the nth date` `the amounts of paragraph 33(3)(b), from the second preceding year` 4 2000 1600 1200 EQUALS JUST 1600
#ASSERT `s 33(3) — the total of the instalments due by the nth date` `the amounts of paragraph 33(3)(b), from the second preceding year` 4 2000 500 1200 EQUALS JUST 600
#ASSERT `s 33(3) — the total of the instalments due by the nth date` `the amounts of paragraph 33(3)(b), from the second preceding year` 5 2000 1600 1200 EQUALS NOTHING

§§ `s 33(4) -- the remainder, and a death`

#ASSERT `s 33(4) — the remainder of the estimated contributions to pay on or before the balance-due day` 2000 1500 EQUALS 500
#ASSERT `s 33(4) — the remainder of the estimated contributions to pay on or before the balance-due day` 2000 2000 EQUALS 0
#ASSERT `s 33(4) — the remainder of the estimated contributions to pay on or before the balance-due day` 2000 2500 EQUALS 0
#ASSERT `s 33(4) — the remainder of the estimated contributions to pay on or before the balance-due day` 2000 0 EQUALS 2000
-- A part falling due after the death is not required; one falling due on the day of death or before is.
#ASSERT `s 33(4) — the part or instalment falling due on the day is still required` (YMD 2026 6 15) NOTHING
#ASSERT `s 33(4) — the part or instalment falling due on the day is still required` (YMD 2026 6 15) (JUST (YMD 2026 6 15))
#ASSERT `s 33(4) — the part or instalment falling due on the day is still required` (YMD 2026 6 15) (JUST (YMD 2026 7 1))
#ASSERT NOT (`s 33(4) — the part or instalment falling due on the day is still required` (YMD 2026 6 15) (JUST (YMD 2026 6 14)))
#ASSERT NOT (`s 33(4) — the part or instalment falling due on the day is still required` (YMD 2026 9 15) (JUST (YMD 2026 6 14)))

§§ `s 34(1) -- interest on contributions unpaid at the balance-due day`

-- 1000 required, 400 paid by 30 April 2027: 600 short. Paid on 12 July 2027, 73 days on: 600 x 5% x 73 / 365 = 6.
#ASSERT `s 34(1) — the interest on the contributions unpaid at the balance-due day` 1000 400 (YMD 2027 4 30) (YMD 2027 7 12) 5% EQUALS 6
-- 365 days on (30 April 2027 to 29 April 2028, because 2028 has a 29 February): 600 x 5% = 30.
#ASSERT `s 34(1) — the interest on the contributions unpaid at the balance-due day` 1000 400 (YMD 2027 4 30) (YMD 2028 4 29) 5% EQUALS 30
-- Paid in full, or more than required: no interest.
#ASSERT `s 34(1) — the interest on the contributions unpaid at the balance-due day` 1000 1000 (YMD 2027 4 30) (YMD 2027 7 12) 5% EQUALS 0
#ASSERT `s 34(1) — the interest on the contributions unpaid at the balance-due day` 1000 1200 (YMD 2027 4 30) (YMD 2027 7 12) 5% EQUALS 0
-- The difference paid on the balance-due day itself, or before: no days run.
#ASSERT `s 34(1) — the interest on the contributions unpaid at the balance-due day` 1000 400 (YMD 2027 4 30) (YMD 2027 4 30) 5% EQUALS 0
#ASSERT `s 34(1) — the interest on the contributions unpaid at the balance-due day` 1000 400 (YMD 2027 4 30) (YMD 2027 4 1) 5% EQUALS 0
-- A zero rate gives no interest.
#ASSERT `s 34(1) — the interest on the contributions unpaid at the balance-due day` 1000 400 (YMD 2027 4 30) (YMD 2027 7 12) 0 EQUALS 0

§§ `s 34(2) -- interest on a missed instalment`

-- 800 due on 31 December 2026, paid 14 March 2027 (73 days on), before the balance-due day 30 April 2027: 800 x 5% x 73 / 365 = 8.
#ASSERT `s 34(2) — the interest on a part or instalment not paid as required` 800 (YMD 2026 12 31) (YMD 2027 3 14) (YMD 2027 4 30) 5% EQUALS 8
-- Paid after the balance-due day: interest under (2) stops at the balance-due day (120 days from 31 December to 30 April), and (1) takes over.
#ASSERT `s 34(2) — the interest on a part or instalment not paid as required` 730 (YMD 2026 12 31) (YMD 2027 6 30) (YMD 2027 4 30) 5% EQUALS 12
-- Paid on the day required or before it: nothing.
#ASSERT `s 34(2) — the interest on a part or instalment not paid as required` 800 (YMD 2026 12 31) (YMD 2026 12 31) (YMD 2027 4 30) 5% EQUALS 0
#ASSERT `s 34(2) — the interest on a part or instalment not paid as required` 800 (YMD 2026 12 31) (YMD 2026 12 1) (YMD 2027 4 30) 5% EQUALS 0

§§ `s 34(3) -- the farmer's or fisher's deemed instalment`

-- The least of (a) 1000 - 40 = 960, (b) the preceding year's 800, and (c) the Minister's notice, if any.
#ASSERT `s 34(3) — the part or instalment the farmer or fisher is deemed to have been liable to pay by December 31` TRUE 1000 800 NOTHING EQUALS JUST 800
#ASSERT `s 34(3) — the part or instalment the farmer or fisher is deemed to have been liable to pay by December 31` TRUE 1000 1500 NOTHING EQUALS JUST 960
#ASSERT `s 34(3) — the part or instalment the farmer or fisher is deemed to have been liable to pay by December 31` TRUE 1000 800 (JUST 700) EQUALS JUST 700
#ASSERT `s 34(3) — the part or instalment the farmer or fisher is deemed to have been liable to pay by December 31` TRUE 1000 800 (JUST 900) EQUALS JUST 800
#ASSERT `s 34(3) — the part or instalment the farmer or fisher is deemed to have been liable to pay by December 31` TRUE 1000 1500 (JUST 950) EQUALS JUST 950
-- Not a person required by subsection 33(2): the subsection does not apply.
#ASSERT `s 34(3) — the part or instalment the farmer or fisher is deemed to have been liable to pay by December 31` FALSE 1000 800 NOTHING EQUALS NOTHING

§§ `s 34(4) -- the deemed instalments of everyone else`

-- Contributions 2000, preceding year 1600, second preceding year 1200: (a) 490 a quarter, (b) 400 a quarter, (c) 300, 600, 1100, 1600 in total.
#ASSERT `s 34(4) — the total the person is deemed liable to have paid by the nth date` TRUE 1 2000 1600 1200 NOTHING EQUALS JUST 300
#ASSERT `s 34(4) — the total the person is deemed liable to have paid by the nth date` TRUE 2 2000 1600 1200 NOTHING EQUALS JUST 600
#ASSERT `s 34(4) — the total the person is deemed liable to have paid by the nth date` TRUE 3 2000 1600 1200 NOTHING EQUALS JUST 1100
#ASSERT `s 34(4) — the total the person is deemed liable to have paid by the nth date` TRUE 4 2000 1600 1200 NOTHING EQUALS JUST 1600
#ASSERT `s 34(4) — the part the person is deemed liable to have paid on the nth date` TRUE 1 2000 1600 1200 NOTHING EQUALS JUST 300
#ASSERT `s 34(4) — the part the person is deemed liable to have paid on the nth date` TRUE 2 2000 1600 1200 NOTHING EQUALS JUST 300
#ASSERT `s 34(4) — the part the person is deemed liable to have paid on the nth date` TRUE 3 2000 1600 1200 NOTHING EQUALS JUST 500
#ASSERT `s 34(4) — the part the person is deemed liable to have paid on the nth date` TRUE 4 2000 1600 1200 NOTHING EQUALS JUST 500
-- The Minister's notices (d) name 250 on each day: 250 a day is least of all.
#ASSERT `s 34(4) — the total the person is deemed liable to have paid by the nth date` TRUE 1 2000 1600 1200 (JUST (LIST 250, 250, 250, 250)) EQUALS JUST 250
#ASSERT `s 34(4) — the total the person is deemed liable to have paid by the nth date` TRUE 4 2000 1600 1200 (JUST (LIST 250, 250, 250, 250)) EQUALS JUST 1000
#ASSERT `s 34(4) — the part the person is deemed liable to have paid on the nth date` TRUE 3 2000 1600 1200 (JUST (LIST 250, 250, 250, 250)) EQUALS JUST 250
-- Notices that name more than the other bases do not raise the total.
#ASSERT `s 34(4) — the total the person is deemed liable to have paid by the nth date` TRUE 4 2000 1600 1200 (JUST (LIST 1000, 1000, 1000, 1000)) EQUALS JUST 1600
-- Contributions 800, preceding 2000, second preceding 2000: (a) 190 a quarter is the least throughout.
#ASSERT `s 34(4) — the total the person is deemed liable to have paid by the nth date` TRUE 1 800 2000 2000 NOTHING EQUALS JUST 190
#ASSERT `s 34(4) — the total the person is deemed liable to have paid by the nth date` TRUE 4 800 2000 2000 NOTHING EQUALS JUST 760
#ASSERT `s 34(4) — the part the person is deemed liable to have paid on the nth date` TRUE 2 800 2000 2000 NOTHING EQUALS JUST 190
-- Not a person required by subsection 33(3), or a day that is not one of the four: not covered.
#ASSERT `s 34(4) — the total the person is deemed liable to have paid by the nth date` FALSE 1 2000 1600 1200 NOTHING EQUALS NOTHING
#ASSERT `s 34(4) — the total the person is deemed liable to have paid by the nth date` TRUE 5 2000 1600 1200 NOTHING EQUALS NOTHING
#ASSERT `s 34(4) — the total the person is deemed liable to have paid by the nth date` TRUE 0 2000 1600 1200 NOTHING EQUALS NOTHING
#ASSERT `s 34(4) — the part the person is deemed liable to have paid on the nth date` TRUE 5 2000 1600 1200 NOTHING EQUALS NOTHING

§§ `s 36 and 37 -- Income Tax Act provisions, and which debt a payment goes to`

#ASSERT `s 36 — the listed provisions of the Income Tax Act apply to the amount as though it were tax` TRUE FALSE
#ASSERT NOT (`s 36 — the listed provisions of the Income Tax Act apply to the amount as though it were tax` TRUE TRUE)
#ASSERT NOT (`s 36 — the listed provisions of the Income Tax Act apply to the amount as though it were tax` FALSE FALSE)

-- 1000 paid on account of tax and contributions; section 228 would apply 700 to tax; the Act applies that 700 to the contributions.
#ASSERT `s 37 — the part of the payment applied to the contributions` TRUE 1000 700 EQUALS JUST 700
#ASSERT `s 37 — the part of the payment applied to tax under the Income Tax Act` TRUE 1000 700 EQUALS JUST 300
#ASSERT `s 37 — the part of the payment applied to the contributions` TRUE 1000 0 EQUALS JUST 0
#ASSERT `s 37 — the part of the payment applied to tax under the Income Tax Act` TRUE 1000 0 EQUALS JUST 1000
#ASSERT `s 37 — the part of the payment applied to the contributions` TRUE 1000 1000 EQUALS JUST 1000
#ASSERT `s 37 — the part of the payment applied to tax under the Income Tax Act` TRUE 1000 1000 EQUALS JUST 0
-- A payment not on account of both: the section does not apply.
#ASSERT `s 37 — the part of the payment applied to the contributions` FALSE 1000 700 EQUALS NOTHING
#ASSERT `s 37 — the part of the payment applied to tax under the Income Tax Act` FALSE 1000 700 EQUALS NOTHING
