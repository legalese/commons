IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cp4-nouns`
IMPORT `cp4-death-benefit`

-- Tests of section 57 (death benefit). Every expected value is worked out by hand from the text of
-- section 57, as written beside the assertion; none is copied from the module's own output.
-- The Year's Maximum Pensionable Earnings and the other figures are invented for the test, because
-- they come from sections the piece cannot see.

§ `Tests -- section 57`

§§ `Fixtures`

-- A deceased contributor, positionally:
--   died on, retirement pension payable that month?, that pension, contributory period ended before 1976?,
--   basic number of contributory months, months in contributory period, total pensionable earnings,
--   Pension Index for the year of the month of death, Pension Index for the year the pension first became payable
`died 1986 pension payable 400, ended 1975` MEANS `cp4 Deceased contributor` OF (YearMonthDay 1986 6 1), TRUE, 400, TRUE, 90, 120, 108000, 1, 1
`died 1986 pension payable 400, ended 1980` MEANS `cp4 Deceased contributor` OF (YearMonthDay 1986 6 1), TRUE, 400, FALSE, 90, 120, 108000, 1, 1
`died 1986 none payable, earnings 60000 over 100 months` MEANS `cp4 Deceased contributor` OF (YearMonthDay 1986 6 1), FALSE, 0, FALSE, 90, 100, 60000, 1, 1
`died 1986 none payable, no months` MEANS `cp4 Deceased contributor` OF (YearMonthDay 1986 6 1), FALSE, 0, FALSE, 90, 0, 60000, 1, 1
`died 2010 none payable, earnings 108000 over 120 months` MEANS `cp4 Deceased contributor` OF (YearMonthDay 2010 3 15), FALSE, 0, FALSE, 120, 120, 108000, 1, 1
`died 2010 none payable, earnings 300000 over 120 months` MEANS `cp4 Deceased contributor` OF (YearMonthDay 2010 3 15), FALSE, 0, FALSE, 120, 120, 300000, 1, 1
`died 1995 none payable, earnings 300000 over 120 months` MEANS `cp4 Deceased contributor` OF (YearMonthDay 1995 3 15), FALSE, 0, FALSE, 120, 120, 300000, 1, 1
`died 31 December 1997 none payable, earnings 300000` MEANS `cp4 Deceased contributor` OF (YearMonthDay 1997 12 31), FALSE, 0, FALSE, 120, 120, 300000, 1, 1
`died 1 January 1998 none payable, earnings 300000` MEANS `cp4 Deceased contributor` OF (YearMonthDay 1998 1 1), FALSE, 0, FALSE, 120, 120, 300000, 1, 1
`died 2010 pension payable, index 1.2 against 1.0` MEANS `cp4 Deceased contributor` OF (YearMonthDay 2010 3 15), TRUE, 500, FALSE, 120, 120, 108000, 1.2, 1
`died 2010 pension payable, first index zero` MEANS `cp4 Deceased contributor` OF (YearMonthDay 2010 3 15), TRUE, 500, FALSE, 120, 120, 108000, 1.2, 0
`died 2010 none payable, 20 months` MEANS `cp4 Deceased contributor` OF (YearMonthDay 2010 3 15), FALSE, 0, FALSE, 36, 20, 36000, 1, 1
`died 31 December 2018` MEANS `cp4 Deceased contributor` OF (YearMonthDay 2018 12 31), FALSE, 0, FALSE, 120, 120, 108000, 1, 1
`died 1 January 2019` MEANS `cp4 Deceased contributor` OF (YearMonthDay 2019 1 1), FALSE, 0, FALSE, 120, 120, 108000, 1, 1
`died 31 December 2024` MEANS `cp4 Deceased contributor` OF (YearMonthDay 2024 12 31), FALSE, 0, FALSE, 120, 120, 108000, 1, 1
`died 1 January 2025` MEANS `cp4 Deceased contributor` OF (YearMonthDay 2025 1 1), FALSE, 0, FALSE, 120, 120, 108000, 1, 1

§§ `Section 57(2)(a) to (c) -- the retirement pension used`

-- (a): died before 1987 with a pension payable; contributory period ended before January 1976, so the
-- pension payable (400) is multiplied by the basic number of contributory months (90) over the months in
-- the contributory period (120): 400 x 90/120 = 300.
#ASSERT `s 57(2)(a) — the retirement pension used for a death before 1987 when a retirement pension was payable` `died 1986 pension payable 400, ended 1975` EQUALS JUST 300
-- (a): contributory period did not end before 1976, so the pension payable for the month is used as it is: 400.
#ASSERT `s 57(2)(a) — the retirement pension used for a death before 1987 when a retirement pension was payable` `died 1986 pension payable 400, ended 1980` EQUALS JUST 400
-- (a): no months in the contributory period is a division the text does not answer.
#ASSERT `s 57(2)(a) — the retirement pension used for a death before 1987 when a retirement pension was payable` (`cp4 Deceased contributor` OF (YearMonthDay 1986 6 1), TRUE, 400, TRUE, 90, 0, 0, 1, 1) EQUALS NOTHING
-- (b): 25% of earnings 60000 over 100 months: 25% x 600 = 150.
#ASSERT `s 57(2)(b) — the retirement pension used for a death before 1987 when none was payable` `died 1986 none payable, earnings 60000 over 100 months` EQUALS JUST 150
#ASSERT `s 57(2)(b) — the retirement pension used for a death before 1987 when none was payable` `died 1986 none payable, no months` EQUALS NOTHING
-- (b)(iii): section 51 is read with the year of death.
#ASSERT `s 57(2)(b)(iii) — the year to which section 51 refers for a death before 1987` 1986 EQUALS 1986
-- (c)(i): 25% x (108000 / max(120, 36)) = 25% x 900 = 225.
#ASSERT `s 57(2)(c)(i) — the retirement pension used for a death after 1986 when none was payable` `died 2010 none payable, earnings 108000 over 120 months` EQUALS 225
-- (c)(ii): 25% x 900 x (1.2 / 1.0) = 225 x 1.2 = 270.
#ASSERT `s 57(2)(c)(ii) — the retirement pension used for a death after 1986 when one was payable` `died 2010 pension payable, index 1.2 against 1.0` EQUALS JUST 270
-- (c)(ii): a Pension Index of zero for the year the pension first became payable is a division the text does not answer.
#ASSERT `s 57(2)(c)(ii) — the retirement pension used for a death after 1986 when one was payable` `died 2010 pension payable, first index zero` EQUALS NOTHING
-- subsection (2) chooses among (a), (b), (c)(i) and (c)(ii) on the date of death and on whether a pension was payable.
#ASSERT `s 57(2) — the retirement pension used for paragraph (1)(a)` `died 1986 pension payable 400, ended 1975` EQUALS JUST 300
#ASSERT `s 57(2) — the retirement pension used for paragraph (1)(a)` `died 1986 none payable, earnings 60000 over 100 months` EQUALS JUST 150
#ASSERT `s 57(2) — the retirement pension used for paragraph (1)(a)` `died 2010 none payable, earnings 108000 over 120 months` EQUALS JUST 225
#ASSERT `s 57(2) — the retirement pension used for paragraph (1)(a)` `died 2010 pension payable, index 1.2 against 1.0` EQUALS JUST 270

§§ `Section 57(3) -- the average monthly pensionable earnings`

-- 108000 / max(120, 36) = 900.
#ASSERT `s 57(3) — the average monthly pensionable earnings of a contributor who died after 1986` `died 2010 none payable, earnings 108000 over 120 months` EQUALS 900
-- 20 months is fewer than 36, so the divisor is 36: 36000 / 36 = 1000.
#ASSERT `s 57(3) — the average monthly pensionable earnings of a contributor who died after 1986` `died 2010 none payable, 20 months` EQUALS 1000
-- exactly 36 months: 36000 / 36 = 1000.
#ASSERT `s 57(3) — the average monthly pensionable earnings of a contributor who died after 1986` (`cp4 Deceased contributor` OF (YearMonthDay 2010 3 15), FALSE, 0, FALSE, 36, 36, 36000, 1, 1) EQUALS 1000
-- section 51 refers to the year a benefit becomes payable when a pension was payable (paragraph (a)), and to the year of death when none was (paragraph (b)).
#ASSERT `s 57(3) — the year to which section 51 refers for a death after 1986` TRUE 2005 2010 EQUALS 2005
#ASSERT `s 57(3) — the year to which section 51 refers for a death after 1986` FALSE 2005 2010 EQUALS 2010

§§ `Section 57(1) -- the lump sum`

-- Death in 2010, no pension payable: 6 x 225 = 1350; 10% of a Year's Maximum Pensionable Earnings of 40000 = 4000;
-- the lesser is 1350; the cap of 2500 (death after 1997) does not bite.
#ASSERT `s 57(1)(a) — the lump sum for a death before 2019` `died 2010 none payable, earnings 108000 over 120 months` 40000 EQUALS JUST 1350
-- 10% of a Year's Maximum Pensionable Earnings of 10000 = 1000, which is less than 1350.
#ASSERT `s 57(1)(a) — the lump sum for a death before 2019` `died 2010 none payable, earnings 108000 over 120 months` 10000 EQUALS JUST 1000
-- 25% x 2500 = 625; 6 x 625 = 3750; 10% of 40000 = 4000; the lesser is 3750 (before the cap).
#ASSERT `s 57(1)(a) — the lump sum for a death before 2019` `died 2010 none payable, earnings 300000 over 120 months` 40000 EQUALS JUST 3750
-- subsection (1.1): a death after 31 December 1997 is capped at 2500.
#ASSERT `s 57(1.1) — the lump sum of paragraph (1)(a) after the cap` (YearMonthDay 2010 3 15) (JUST 3750) EQUALS JUST 2500
#ASSERT `s 57(1.1) — the lump sum of paragraph (1)(a) after the cap` (YearMonthDay 2010 3 15) (JUST 1350) EQUALS JUST 1350
-- the boundary: 31 December 1997 is not after 31 December 1997, so no cap; 1 January 1998 is.
#ASSERT `s 57(1.1) — the lump sum of paragraph (1)(a) after the cap` (YearMonthDay 1997 12 31) (JUST 3750) EQUALS JUST 3750
#ASSERT `s 57(1.1) — the lump sum of paragraph (1)(a) after the cap` (YearMonthDay 1998 1 1) (JUST 3750) EQUALS JUST 2500
#ASSERT `s 57(1.1) — the lump sum of paragraph (1)(a) after the cap` (YearMonthDay 2010 3 15) NOTHING EQUALS NOTHING
-- paragraph (1)(b): $2,500 for a death after 31 December 2018; nothing is said for a death before 2019.
#ASSERT `s 57(1)(b) — the lump sum for a death after 2018` (YearMonthDay 2019 1 1) EQUALS JUST 2500
#ASSERT `s 57(1)(b) — the lump sum for a death after 2018` (YearMonthDay 2018 12 31) EQUALS NOTHING
-- subsection (1.2): all four conditions.
#ASSERT `s 57(1.2) — the additional amount of $5,000 applies` (YearMonthDay 2025 1 1) TRUE FALSE FALSE EQUALS TRUE
#ASSERT `s 57(1.2) — the additional amount of $5,000 applies` (YearMonthDay 2024 12 31) TRUE FALSE FALSE EQUALS FALSE
#ASSERT `s 57(1.2) — the additional amount of $5,000 applies` (YearMonthDay 2025 1 1) FALSE FALSE FALSE EQUALS FALSE
#ASSERT `s 57(1.2) — the additional amount of $5,000 applies` (YearMonthDay 2025 1 1) TRUE TRUE FALSE EQUALS FALSE
#ASSERT `s 57(1.2) — the additional amount of $5,000 applies` (YearMonthDay 2025 1 1) TRUE FALSE TRUE EQUALS FALSE
-- subsection (1): which paragraph governs.
#ASSERT `s 57(1) — the amount of the death benefit` `died 2010 none payable, earnings 108000 over 120 months` 40000 TRUE FALSE FALSE EQUALS JUST 1350
#ASSERT `s 57(1) — the amount of the death benefit` `died 2010 none payable, earnings 300000 over 120 months` 40000 TRUE FALSE FALSE EQUALS JUST 2500
#ASSERT `s 57(1) — the amount of the death benefit` `died 1995 none payable, earnings 300000 over 120 months` 40000 TRUE FALSE FALSE EQUALS JUST 3750
#ASSERT `s 57(1) — the amount of the death benefit` `died 31 December 1997 none payable, earnings 300000` 40000 TRUE FALSE FALSE EQUALS JUST 3750
#ASSERT `s 57(1) — the amount of the death benefit` `died 1 January 1998 none payable, earnings 300000` 40000 TRUE FALSE FALSE EQUALS JUST 2500
#ASSERT `s 57(1) — the amount of the death benefit` `died 31 December 2018` 40000 TRUE FALSE FALSE EQUALS JUST 1350
#ASSERT `s 57(1) — the amount of the death benefit` `died 1 January 2019` 40000 TRUE FALSE FALSE EQUALS JUST 2500
#ASSERT `s 57(1) — the amount of the death benefit` `died 31 December 2024` 40000 TRUE FALSE FALSE EQUALS JUST 2500
#ASSERT `s 57(1) — the amount of the death benefit` `died 1 January 2025` 40000 TRUE FALSE FALSE EQUALS JUST 5000
-- (1.2) fails for a contributor who received a pension: back to paragraph (1)(b).
#ASSERT `s 57(1) — the amount of the death benefit` `died 1 January 2025` 40000 TRUE TRUE FALSE EQUALS JUST 2500
#ASSERT `s 57(1) — the amount of the death benefit` `died 1 January 2025` 40000 TRUE FALSE TRUE EQUALS JUST 2500
-- not covered: a pension of unknowable size gives no lump sum for a death before 2019.
#ASSERT `s 57(1) — the amount of the death benefit` `died 1986 none payable, no months` 40000 TRUE FALSE FALSE EQUALS NOTHING
