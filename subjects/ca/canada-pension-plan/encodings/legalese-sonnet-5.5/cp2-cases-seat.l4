-- The terms are not met.
#ASSERT NOT (`Am I exempt from keeping electronic records in an electronically readable format (s 24(2.2))` TRUE FALSE)

-- Must I keep my records while a ruling or an appeal about them is open (s 24(3))
-- A ruling is pending (s 24(3)).
#ASSERT `Must I keep my records while a ruling or an appeal about them is open (s 24(3))` TRUE FALSE FALSE FALSE FALSE
-- The ruling has been made and there is no appeal.
#ASSERT NOT (`Must I keep my records while a ruling or an appeal about them is open (s 24(3))` TRUE TRUE FALSE FALSE FALSE)

-- May the Minister refund what I remitted as employer in excess of what section 9 requires (s 38(3.1))
-- Within four years after the end of 2024 (s 38(3.1)).
#ASSERT `May the Minister refund what I remitted as employer in excess of what section 9 requires (s 38(3.1))` TRUE TRUE 2024 (YMD 2028 12 31)
-- After the four years.
#ASSERT NOT (`May the Minister refund what I remitted as employer in excess of what section 9 requires (s 38(3.1))` TRUE TRUE 2024 (YMD 2029 1 1))

-- How much of what I remitted as employer is an excess I may be refunded (s 38(3.1))
-- The excess over what section 9 requires (s 38(3.1)).
#ASSERT `How much of what I remitted as employer is an excess I may be refunded (s 38(3.1))` 2000 1500 EQUALS 500

-- Does subsection 38(3.2) bar a refund of an employer's contribution that section 9 requires (s 38(3.2))
-- An employer's contribution required by section 9 is not refundable (s 38(3.2)).
#ASSERT `Does subsection 38(3.2) bar a refund of an employer's contribution that section 9 requires (s 38(3.2))` TRUE
-- Not such a contribution.
#ASSERT NOT (`Does subsection 38(3.2) bar a refund of an employer's contribution that section 9 requires (s 38(3.2))` FALSE)

-- May the Minister refund an amount I remitted that is treated as never deducted under section 21.01 (s 38(3.3))
-- Within four years after the end of the year for which it was remitted (s 38(3.3)).
#ASSERT `May the Minister refund an amount I remitted that is treated as never deducted under section 21.01 (s 38(3.3))` TRUE TRUE 2024 (YMD 2028 12 31)
-- After the four years.
#ASSERT NOT (`May the Minister refund an amount I remitted that is treated as never deducted under section 21.01 (s 38(3.3))` TRUE TRUE 2024 (YMD 2029 1 1))

-- Am I guilty of an offence as an employer if I fail to deduct and remit or to hold the amounts in trust (s 41(1))
-- Failed to comply with s 21(1) (s 41(1)).
#ASSERT `Am I guilty of an offence as an employer if I fail to deduct and remit or to hold the amounts in trust (s 41(1))` TRUE FALSE
-- Complied with both.
#ASSERT NOT (`Am I guilty of an offence as an employer if I fail to deduct and remit or to hold the amounts in trust (s 41(1))` FALSE FALSE)

-- What is the most the court may fine me as an employer for that offence (s 41(1))
