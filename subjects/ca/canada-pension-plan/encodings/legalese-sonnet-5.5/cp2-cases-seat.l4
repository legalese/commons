-- Not guilty.
#ASSERT `What is the most the court may fine me for an offence under subsection 41(2) (s 41(2))` FALSE EQUALS NOTHING

-- Am I guilty of an offence if I do not file a return or contravene an information-return regulation (s 41(3))
-- Contravening s 30 (s 41(3)).
#ASSERT `Am I guilty of an offence if I do not file a return or contravene an information-return regulation (s 41(3))` TRUE FALSE
-- Neither.
#ASSERT NOT (`Am I guilty of an offence if I do not file a return or contravene an information-return regulation (s 41(3))` FALSE FALSE)

-- What is the least the court may fine me for an offence under subsection 41(3) (s 41(3))
-- $25 a day for 10 days (s 41(3)).
#ASSERT `What is the least the court may fine me for an offence under subsection 41(3) (s 41(3))` TRUE 10 EQUALS JUST 250
-- 40 days is exactly the cap.
#ASSERT `What is the least the court may fine me for an offence under subsection 41(3) (s 41(3))` TRUE 40 EQUALS JUST 1000
-- Beyond 40 days the cap governs.
#ASSERT `What is the least the court may fine me for an offence under subsection 41(3) (s 41(3))` TRUE 41 EQUALS JUST 1000
-- Not guilty.
#ASSERT `What is the least the court may fine me for an offence under subsection 41(3) (s 41(3))` FALSE 10 EQUALS NOTHING

-- What is the most the court may fine me for an offence under subsection 41(3) (s 41(3))
-- $1,000 in all (s 41(3)).
#ASSERT `What is the most the court may fine me for an offence under subsection 41(3) (s 41(3))` TRUE EQUALS JUST 1000
-- Not guilty.
#ASSERT `What is the most the court may fine me for an offence under subsection 41(3) (s 41(3))` FALSE EQUALS NOTHING

-- Am I guilty of an offence for false statements, destroying records, false entries, evasion or conspiracy (s 41(4))
-- False statements in a return (s 41(4)(a)).
#ASSERT `Am I guilty of an offence for false statements, destroying records, false entries, evasion or conspiracy (s 41(4))` TRUE FALSE FALSE FALSE FALSE
-- None of the five.
#ASSERT NOT (`Am I guilty of an offence for false statements, destroying records, false entries, evasion or conspiracy (s 41(4))` FALSE FALSE FALSE FALSE FALSE)
-- Wilful evasion (s 41(4)(d)).
#ASSERT `Am I guilty of an offence for false statements, destroying records, false entries, evasion or conspiracy (s 41(4))` FALSE FALSE FALSE TRUE FALSE

-- What is the least the court may fine me for an offence under subsection 41(4) (s 41(4)(f))
-- Not less than $25 (s 41(4)(f)).
#ASSERT `What is the least the court may fine me for an offence under subsection 41(4) (s 41(4)(f))` TRUE EQUALS JUST 25

-- What is the most the court may fine me for an offence under subsection 41(4) (s 41(4)(f))
-- $5,000 (s 41(4)(f)).
#ASSERT `What is the most the court may fine me for an offence under subsection 41(4) (s 41(4)(f))` TRUE FALSE 800 EQUALS JUST 5000
-- Plus, in an appropriate case, double the 800.
#ASSERT `What is the most the court may fine me for an offence under subsection 41(4) (s 41(4)(f))` TRUE TRUE 800 EQUALS JUST 6600

-- What is the longest term of imprisonment, in months, that may be imposed with the fine for an offence under subsection 41(4) (s 41(4)(g))
-- Six months (s 41(4)(g)).
#ASSERT `What is the longest term of imprisonment, in months, that may be imposed with the fine for an offence under subsection 41(4) (s 41(4)(g))` TRUE EQUALS JUST 6

-- Does the saving in section 41(5) relieve me of the penalty for the same failure after my conviction (s 41(5))
-- Convicted, never assessed or demanded: not liable (s 41(5)).
#ASSERT `Does the saving in section 41(5) relieve me of the penalty for the same failure after my conviction (s 41(5))` TRUE FALSE (YMD 2026 1 1) (YMD 2026 2 1)
-- Assessed before the information was laid: still liable.
#ASSERT NOT (`Does the saving in section 41(5) relieve me of the penalty for the same failure after my conviction (s 41(5))` TRUE TRUE (YMD 2026 1 31) (YMD 2026 2 1))
-- Assessed on the day the information was laid: not before it.
#ASSERT `Does the saving in section 41(5) relieve me of the penalty for the same failure after my conviction (s 41(5))` TRUE TRUE (YMD 2026 2 1) (YMD 2026 2 1)

-- Who may lay an information or complaint against me under section 41 (s 41(6))
-- An officer of the Canada Revenue Agency (s 41(6)).
#ASSERT `Who may lay an information or complaint against me under section 41 (s 41(6))` TRUE FALSE FALSE
-- None of the three.
#ASSERT NOT (`Who may lay an information or complaint against me under section 41 (s 41(6))` FALSE FALSE FALSE)

-- May I argue that the person who laid the information against me lacked authority (s 41(6))
-- Only the Minister or a person acting for the Minister (s 41(6)).
#ASSERT `May I argue that the person who laid the information against me lacked authority (s 41(6))` TRUE TRUE EQUALS JUST TRUE
-- Anyone else may not.
#ASSERT `May I argue that the person who laid the information against me lacked authority (s 41(6))` TRUE FALSE EQUALS JUST FALSE
-- An information that does not purport to be laid under section 41: the text does not say (explicit not-covered value).
#ASSERT `May I argue that the person who laid the information against me lacked authority (s 41(6))` FALSE TRUE EQUALS NOTHING
