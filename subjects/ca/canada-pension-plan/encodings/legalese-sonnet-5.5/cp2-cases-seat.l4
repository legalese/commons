§ `If someone from the Canada Revenue Agency inspects, or asks you for information (s 25)`

-- Can an authorized person inspect, audit or examine my documents (s 25(2))
-- All four conditions (s 25(2)).
#ASSERT `Can an authorized person inspect, audit or examine my documents (s 25(2))` TRUE TRUE TRUE TRUE
-- Not authorized.
#ASSERT NOT (`Can an authorized person inspect, audit or examine my documents (s 25(2))` FALSE TRUE TRUE TRUE)

-- Is this thing a document for section 25 (s 25(1))
-- Invoices are listed (s 25(1) "documents").
#ASSERT `Is this thing a document for section 25 (s 25(1))` `invoices, whether computerized or not` EQUALS JUST TRUE
-- "Includes": a thing outside the list is not decided (explicit not-covered value).
#ASSERT `Is this thing a document for section 25 (s 25(1))` `another kind of thing` EQUALS NOTHING

-- Is this person a judge for section 25 (s 25(1))
-- A judge of a superior court having jurisdiction (s 25(1)).
#ASSERT `Is this person a judge for section 25 (s 25(1))` TRUE FALSE
-- A judge of the Federal Court.
#ASSERT `Is this person a judge for section 25 (s 25(1))` FALSE TRUE
-- Neither.
#ASSERT NOT (`Is this person a judge for section 25 (s 25(1))` FALSE FALSE)

-- May an authorized person enter this place without my consent unless they have a warrant (s 25(3))
-- A residence, no consent, no warrant (s 25(3)).
#ASSERT NOT (`May an authorized person enter this place without my consent unless they have a warrant (s 25(3))` TRUE FALSE FALSE FALSE FALSE)
-- A residence with the occupant's consent.
#ASSERT `May an authorized person enter this place without my consent unless they have a warrant (s 25(3))` TRUE FALSE FALSE TRUE FALSE
-- A mobile unit used as a residence, under a warrant.
#ASSERT `May an authorized person enter this place without my consent unless they have a warrant (s 25(3))` FALSE FALSE TRUE FALSE TRUE
-- Not a dwelling-house: subsection (3) adds no limit.
#ASSERT `May an authorized person enter this place without my consent unless they have a warrant (s 25(3))` FALSE FALSE FALSE FALSE FALSE

-- Can an authorized person enter this place to look for records (s 25(2)(a) and (3))
-- An office, not a dwelling-house (s 25(2)(a)).
#ASSERT `Can an authorized person enter this place to look for records (s 25(2)(a) and (3))` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE
-- A residence, no consent, no warrant (s 25(3)).
#ASSERT NOT (`Can an authorized person enter this place to look for records (s 25(2)(a) and (3))` TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE)
-- A residence with the occupant's consent.
#ASSERT `Can an authorized person enter this place to look for records (s 25(2)(a) and (3))` TRUE TRUE TRUE TRUE TRUE FALSE FALSE TRUE FALSE
-- A residence with a warrant.
#ASSERT `Can an authorized person enter this place to look for records (s 25(2)(a) and (3))` TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE TRUE
-- A mobile unit used as a residence is a dwelling-house: no consent, no warrant.
#ASSERT NOT (`Can an authorized person enter this place to look for records (s 25(2)(a) and (3))` TRUE TRUE TRUE TRUE FALSE FALSE TRUE FALSE FALSE)

-- Must I give reasonable assistance, answer proper questions and attend with an authorized person (s 25(2)(b))
-- The owner, occupant or person in charge (s 25(2)(b)).
#ASSERT `Must I give reasonable assistance, answer proper questions and attend with an authorized person (s 25(2)(b))` TRUE TRUE TRUE TRUE
-- Not the owner, occupant or person in charge.
#ASSERT NOT (`Must I give reasonable assistance, answer proper questions and attend with an authorized person (s 25(2)(b))` TRUE TRUE TRUE FALSE)

-- What must a judge do when the Minister applies for a warrant or an order about my home (s 25(4))
-- Grounds (a), (b) and (c) satisfied (s 25(4)).
#ASSERT `What must a judge do when the Minister applies for a warrant or an order about my home (s 25(4))` TRUE TRUE TRUE TRUE FALSE FALSE EQUALS `the judge must issue a warrant authorizing an authorized person to enter the dwelling-house`
-- Entry not found necessary, access refused: the order limb (d), (e).
#ASSERT `What must a judge do when the Minister applies for a warrant or an order about my home (s 25(4))` TRUE TRUE FALSE FALSE TRUE TRUE EQUALS `the judge must order the occupant to give an authorized person reasonable access to the documents, and make any other appropriate order`
-- Entry necessary but not refused: neither limb decides it (explicit not-covered value).
#ASSERT `What must a judge do when the Minister applies for a warrant or an order about my home (s 25(4))` TRUE TRUE TRUE FALSE FALSE FALSE EQUALS `the text does not say what the judge must do on the application`

-- Must I provide the information or document the Minister's notice requires (s 25(5) and (6))
-- A named-person requirement served personally (s 25(5)).
#ASSERT `Must I provide the information or document the Minister's notice requires (s 25(5) and (6))` TRUE TRUE FALSE TRUE FALSE FALSE
-- About unnamed persons without a judge's authorization (s 25(6)).
#ASSERT NOT (`Must I provide the information or document the Minister's notice requires (s 25(5) and (6))` TRUE TRUE FALSE TRUE TRUE FALSE)
-- About unnamed persons with the authorization.
#ASSERT `Must I provide the information or document the Minister's notice requires (s 25(5) and (6))` TRUE TRUE FALSE TRUE TRUE TRUE
-- Not served personally or by mail.
#ASSERT NOT (`Must I provide the information or document the Minister's notice requires (s 25(5) and (6))` TRUE FALSE FALSE TRUE FALSE FALSE)

