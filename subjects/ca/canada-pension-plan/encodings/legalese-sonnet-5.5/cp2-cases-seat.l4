-- Must I file a return of the self-employed earnings of the person whose affairs I administer (s 30(3))
-- (s 30(3)).
#ASSERT `Must I file a return of the self-employed earnings of the person whose affairs I administer (s 30(3))` TRUE TRUE
-- The other person has filed.
#ASSERT NOT (`Must I file a return of the self-employed earnings of the person whose affairs I administer (s 30(3))` TRUE FALSE)

-- On what day must my return say which province I lived in (s 30(4))
-- The last day of the year (s 30(4)).
#ASSERT `On what day must my return say which province I lived in (s 30(4))` 2026 EQUALS YMD 2026 12 31

-- Does my return identify the province as the Act requires (s 30(4))
-- (s 30(4)).
#ASSERT `Does my return identify the province as the Act requires (s 30(4))` "Ontario" "Ontario"
-- A different province.
#ASSERT NOT (`Does my return identify the province as the Act requires (s 30(4))` "Ontario" "Alberta")

-- Is my contribution for the year treated as zero because no return was filed and I was not assessed in four years (s 30(5))
-- No return and no assessment within four years (s 30(5)).
#ASSERT `Is my contribution for the year treated as zero because no return was filed and I was not assessed in four years (s 30(5))` (YMD 2027 4 30) FALSE (YMD 2027 4 30) FALSE (YMD 2027 4 30)
-- Filed before the four-year day.
#ASSERT NOT (`Is my contribution for the year treated as zero because no return was filed and I was not assessed in four years (s 30(5))` (YMD 2027 4 30) TRUE (YMD 2031 4 29) FALSE (YMD 2027 4 30))
-- Assessed within the four years.
#ASSERT NOT (`Is my contribution for the year treated as zero because no return was filed and I was not assessed in four years (s 30(5))` (YMD 2027 4 30) FALSE (YMD 2027 4 30) TRUE (YMD 2030 12 31))

-- How much must I contribute for the year on my self-employed earnings, after subsection 30(5) (s 30(5))
-- Deemed zero (s 30(5)).
#ASSERT `How much must I contribute for the year on my self-employed earnings, after subsection 30(5) (s 30(5))` 3200 (YMD 2027 4 30) FALSE (YMD 2027 4 30) FALSE (YMD 2027 4 30) EQUALS 0
-- Filed in time: the contribution stands.
#ASSERT `How much must I contribute for the year on my self-employed earnings, after subsection 30(5) (s 30(5))` 3200 (YMD 2027 4 30) TRUE (YMD 2027 4 30) FALSE (YMD 2027 4 30) EQUALS 3200

-- Must I estimate my contributions in my return (s 31)
-- (s 31).
#ASSERT `Must I estimate my contributions in my return (s 31)` TRUE
-- Not required to file.
#ASSERT NOT (`Must I estimate my contributions in my return (s 31)` FALSE)

-- Must the Minister examine my return, assess me and send me a notice of assessment (s 32)
-- (s 32).
#ASSERT `Must the Minister examine my return, assess me and send me a notice of assessment (s 32)` TRUE
-- No return filed.
#ASSERT NOT (`Must the Minister examine my return, assess me and send me a notice of assessment (s 32)` FALSE)

-- What total does my notice of assessment state (s 32)
-- Contributions, interest and penalties (s 32).
#ASSERT `What total does my notice of assessment state (s 32)` 3200 40 160 EQUALS 3400

-- What penalty do I owe for failing to file my return of self-employed earnings (s 35(1))
-- 5 per cent of the unpaid part (s 35(1)).
#ASSERT `What penalty do I owe for failing to file my return of self-employed earnings (s 35(1))` TRUE 2000 EQUALS 100
-- No failure.
#ASSERT `What penalty do I owe for failing to file my return of self-employed earnings (s 35(1))` FALSE 2000 EQUALS 0

-- What is my penalty for not filing, after any reduction or remission by the Minister (s 35(1))
-- Reduced by 40 because an Income Tax Act penalty applies (s 35(1)).
#ASSERT `What is my penalty for not filing, after any reduction or remission by the Minister (s 35(1))` TRUE 2000 TRUE 40 EQUALS 60
-- No Income Tax Act penalty: the Minister cannot reduce.
#ASSERT `What is my penalty for not filing, after any reduction or remission by the Minister (s 35(1))` TRUE 2000 FALSE 40 EQUALS 100

-- What penalty do I owe for not filing a return I was required to file for someone else (s 35(2))
-- Five dollars a day (s 35(2)).
#ASSERT `What penalty do I owe for not filing a return I was required to file for someone else (s 35(2))` TRUE 9 EQUALS 45
-- Capped at fifty dollars.
#ASSERT `What penalty do I owe for not filing a return I was required to file for someone else (s 35(2))` TRUE 11 EQUALS 50
-- No failure.
#ASSERT `What penalty do I owe for not filing a return I was required to file for someone else (s 35(2))` FALSE 12 EQUALS 0


§ `If you are self-employed: paying your contributions (ss 33, 34, 36, 37)`

-- How must I pay the CPP contributions on my self-employed earnings (s 33)
-- $40 or less (s 33(1)).
#ASSERT `How must I pay the CPP contributions on my self-employed earnings (s 33)` 30 TRUE FALSE EQUALS `pay the whole amount on or before the balance-due day (subsection 33(1))`
-- A farmer or fisher (s 33(2)).
#ASSERT `How must I pay the CPP contributions on my self-employed earnings (s 33)` 1000 TRUE TRUE EQUALS `pay two thirds on or before December 31 in each year (subsection 33(2), farmers and fishers)`
-- Everyone else (s 33(3)).
#ASSERT `How must I pay the CPP contributions on my self-employed earnings (s 33)` 1000 TRUE FALSE EQUALS `pay four quarterly instalments in the year (subsection 33(3))`

-- What is my balance-due day for the year (s 33(1))
-- 30 April of the following year (s 2(1)).
#ASSERT `What is my balance-due day for the year (s 33(1))` 2026 FALSE (YMD 2026 1 1) EQUALS YMD 2027 4 30
-- A death after October: six months after the death.
#ASSERT `What is my balance-due day for the year (s 33(1))` 2026 TRUE (YMD 2026 12 15) EQUALS YMD 2027 6 15

-- How much must I pay on or before December 31 (s 33(2))
-- Two thirds of the estimate (s 33(2)(a)).
#ASSERT `How much must I pay on or before December 31 (s 33(2))` `two thirds of the contributions for the year as estimated by the person` 900 1500 EQUALS 600
-- Two thirds of the preceding year (s 33(2)(b)).
#ASSERT `How much must I pay on or before December 31 (s 33(2))` `two thirds of the contributions for the preceding year` 900 1500 EQUALS 1000

-- What is the last day for the payment under subsection 33(2) (s 33(2))
-- December 31 (s 33(2)).
#ASSERT `What is the last day for the payment under subsection 33(2) (s 33(2))` 2026 EQUALS YMD 2026 12 31

-- When is each of my quarterly instalments due (s 33(3))
-- March 15 (s 33(3)(a)).
#ASSERT `When is each of my quarterly instalments due (s 33(3))` 1 2026 EQUALS JUST (YMD 2026 3 15)
-- There is no fifth instalment.
#ASSERT `When is each of my quarterly instalments due (s 33(3))` 5 2026 EQUALS NOTHING

-- How much is each of my quarterly instalments (s 33(3))
-- A quarter of the estimate (s 33(3)(a)(i)).
#ASSERT `How much is each of my quarterly instalments (s 33(3))` `one quarter of the contributions for the year as estimated by the person on each of the four days` 1 2000 1600 1200 EQUALS JUST 500
-- September 15 under (b): half of 1600 less 600.
#ASSERT `How much is each of my quarterly instalments (s 33(3))` `the amounts of paragraph 33(3)(b), from the second preceding year` 3 2000 1600 1200 EQUALS JUST 500
-- There is no fifth instalment.
#ASSERT `How much is each of my quarterly instalments (s 33(3))` `one quarter of the contributions for the year as estimated by the person on each of the four days` 5 2000 1600 1200 EQUALS NOTHING

-- What total instalments should I have paid by each due date (s 33(3))
-- 300 + 300 + 500 + 500 (s 33(3)(b)).
#ASSERT `What total instalments should I have paid by each due date (s 33(3))` `the amounts of paragraph 33(3)(b), from the second preceding year` 4 2000 1600 1200 EQUALS JUST 1600

-- How much must I pay as the remainder on or before my balance-due day (s 33(4))
-- Estimate less instalments required (s 33(4)).
#ASSERT `How much must I pay as the remainder on or before my balance-due day (s 33(4))` 2000 1500 EQUALS 500
-- Instalments exceed the estimate.
#ASSERT `How much must I pay as the remainder on or before my balance-due day (s 33(4))` 2000 2500 EQUALS 0

-- Must the estate still pay an instalment that falls due on a given day when the contributor has died (s 33(4))
-- Falling due on the day of death: still required (s 33(4)).
#ASSERT `Must the estate still pay an instalment that falls due on a given day when the contributor has died (s 33(4))` (YMD 2026 6 15) TRUE (YMD 2026 6 15)
-- Falling due after the death: not required.
#ASSERT NOT (`Must the estate still pay an instalment that falls due on a given day when the contributor has died (s 33(4))` (YMD 2026 9 15) TRUE (YMD 2026 6 14))

-- How much interest do I owe on contributions I had not paid by my balance-due day (s 34(1))
-- 600 short for 73 days at 5 per cent (s 34(1)).
#ASSERT `How much interest do I owe on contributions I had not paid by my balance-due day (s 34(1))` 1000 400 (YMD 2027 4 30) (YMD 2027 7 12) 5 EQUALS 6
-- Paid in full.
#ASSERT `How much interest do I owe on contributions I had not paid by my balance-due day (s 34(1))` 1000 1000 (YMD 2027 4 30) (YMD 2027 7 12) 5 EQUALS 0

-- How much interest do I owe on an instalment I did not pay when it was due (s 34(2))
-- 800 for 73 days at 5 per cent (s 34(2)).
#ASSERT `How much interest do I owe on an instalment I did not pay when it was due (s 34(2))` 800 (YMD 2026 12 31) (YMD 2027 3 14) (YMD 2027 4 30) 5 EQUALS 8
-- Stops at the balance-due day: 120 days.
#ASSERT `How much interest do I owe on an instalment I did not pay when it was due (s 34(2))` 730 (YMD 2026 12 31) (YMD 2027 6 30) (YMD 2027 4 30) 5 EQUALS 12

-- What part am I treated as having owed by December 31 for the limit on interest on instalments (s 34(3))
-- The least of 960, 800 (s 34(3)).
#ASSERT `What part am I treated as having owed by December 31 for the limit on interest on instalments (s 34(3))` TRUE 1000 800 FALSE 0 EQUALS JUST 800
-- The Minister's notice states 700.
#ASSERT `What part am I treated as having owed by December 31 for the limit on interest on instalments (s 34(3))` TRUE 1000 800 TRUE 700 EQUALS JUST 700
-- Not a person required by s 33(2): not covered.
#ASSERT `What part am I treated as having owed by December 31 for the limit on interest on instalments (s 34(3))` FALSE 1000 800 FALSE 0 EQUALS NOTHING

-- What total am I treated as having owed by a given quarterly due date for the limit on interest on instalments (s 34(4))
-- 300 + 300 + 500 under paragraph 33(3)(b) is least (s 34(4)).
#ASSERT `What total am I treated as having owed by a given quarterly due date for the limit on interest on instalments (s 34(4))` TRUE 3 2000 1600 1200 FALSE 0 0 0 0 EQUALS JUST 1100
-- The Minister's notices (250 a day) give the least total.
#ASSERT `What total am I treated as having owed by a given quarterly due date for the limit on interest on instalments (s 34(4))` TRUE 4 2000 1600 1200 TRUE 250 250 250 250 EQUALS JUST 1000
-- Not a person required by s 33(3): not covered.
#ASSERT `What total am I treated as having owed by a given quarterly due date for the limit on interest on instalments (s 34(4))` FALSE 1 2000 1600 1200 FALSE 0 0 0 0 EQUALS NOTHING

-- What part am I treated as having owed on a given quarterly due date for the limit on interest on instalments (s 34(4))
-- The least total by March 15 is 300 (s 34(4)).
#ASSERT `What part am I treated as having owed on a given quarterly due date for the limit on interest on instalments (s 34(4))` TRUE 1 2000 1600 1200 FALSE 0 0 0 0 EQUALS JUST 300
-- 1100 by September 15 less 600 by June 15.
#ASSERT `What part am I treated as having owed on a given quarterly due date for the limit on interest on instalments (s 34(4))` TRUE 3 2000 1600 1200 FALSE 0 0 0 0 EQUALS JUST 500
-- The Minister's notices state 250 a day.
#ASSERT `What part am I treated as having owed on a given quarterly due date for the limit on interest on instalments (s 34(4))` TRUE 4 2000 1600 1200 TRUE 250 250 250 250 EQUALS JUST 250
-- Not required by s 33(3): not covered.
#ASSERT `What part am I treated as having owed on a given quarterly due date for the limit on interest on instalments (s 34(4))` FALSE 1 2000 1600 1200 FALSE 0 0 0 0 EQUALS NOTHING
-- There is no fifth day: not covered.
#ASSERT `What part am I treated as having owed on a given quarterly due date for the limit on interest on instalments (s 34(4))` TRUE 5 2000 1600 1200 FALSE 0 0 0 0 EQUALS NOTHING

-- Do the Income Tax Act's rules on payment, assessment, objections, appeals, interest, penalties and refunds apply to my self-employed contributions (s 36)
-- They apply as though the contributions were tax (s 36).
#ASSERT `Do the Income Tax Act's rules on payment, assessment, objections, appeals, interest, penalties and refunds apply to my self-employed contributions (s 36)` TRUE FALSE
-- A regulation otherwise provides.
#ASSERT NOT (`Do the Income Tax Act's rules on payment, assessment, objections, appeals, interest, penalties and refunds apply to my self-employed contributions (s 36)` TRUE TRUE)

-- How much of a payment on account of both tax and my contributions goes to the contributions (s 37)
-- The part section 228 would apply to tax goes to the contributions (s 37).
#ASSERT `How much of a payment on account of both tax and my contributions goes to the contributions (s 37)` TRUE 1000 700 EQUALS JUST 700
-- A payment not on account of both: the section does not apply.
#ASSERT `How much of a payment on account of both tax and my contributions goes to the contributions (s 37)` FALSE 1000 700 EQUALS NOTHING

-- How much of a payment on account of both tax and my contributions goes to income tax (s 37)
-- The rest goes to tax (s 37).
#ASSERT `How much of a payment on account of both tax and my contributions goes to income tax (s 37)` TRUE 1000 700 EQUALS JUST 300


§ `If you paid more CPP than you owed: refunds (ss 38, 39)`

-- How many years after the end of the year do I have to apply for a refund (s 38(1))
-- Four years (s 38(1)).
#ASSERT `How many years after the end of the year do I have to apply for a refund (s 38(1))` FALSE (YMD 2010 1 1) EQUALS 4
-- Notified after 1 September 2010: ten years.
#ASSERT `How many years after the end of the year do I have to apply for a refund (s 38(1))` TRUE (YMD 2010 9 2) EQUALS 10
-- Notified on 1 September 2010 itself is not after it.
#ASSERT `How many years after the end of the year do I have to apply for a refund (s 38(1))` TRUE (YMD 2010 9 1) EQUALS 4

-- What is the last day I can apply for a refund of CPP I overpaid as an employee (s 38(1))
