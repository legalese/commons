-- Electronic records in a readable format (s 24(2.1)).
#ASSERT `Must I keep electronic records in an electronically readable format (s 24(2.1))` TRUE FALSE
-- Exempted.
#ASSERT NOT (`Must I keep electronic records in an electronically readable format (s 24(2.1))` TRUE TRUE)

