-- Out of time.
#ASSERT NOT (`May the Minister refund the excess deducted from my pay over what section 8 requires (s 38(3))` TRUE TRUE 2024 (YMD 2029 1 1) FALSE (YMD 2010 1 1))

-- How much is the excess deducted from my pay over what section 8 requires (s 38(3))
-- 1800 deducted, 1500 required (s 38(3)).
#ASSERT `How much is the excess deducted from my pay over what section 8 requires (s 38(3))` 1800 1500 EQUALS 300

-- May the Minister refund my overpaid self-employed contributions when it sends my notice of assessment, without my applying (s 38(4)(a))
-- On sending the notice of assessment (s 38(4)(a)).
#ASSERT `May the Minister refund my overpaid self-employed contributions when it sends my notice of assessment, without my applying (s 38(4)(a))` TRUE
-- No excess.
