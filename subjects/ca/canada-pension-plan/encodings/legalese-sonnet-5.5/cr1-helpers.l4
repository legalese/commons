IMPORT prelude
IMPORT daydate

-- Canada Pension Plan Regulations, piece cr1 -- TWO HELPERS that no provision states.
-- The prelude min and max are for numbers; the Regulations compare days ("the earlier of", "the later of") in
-- more than one Part, so the two helpers sit here, once. Their names carry the piece code so that they cannot
-- clash with another piece's helper. No @ref: no provision licenses them.

GIVEN first IS A DATE
      second IS A DATE
GIVETH A DATE
`cr1 helper: the later of two dates` first second MEANS
    IF first AT LEAST second THEN first ELSE second

GIVEN first IS A DATE
      second IS A DATE
GIVETH A DATE
`cr1 helper: the earlier of two dates` first second MEANS
    IF first AT MOST second THEN first ELSE second

-- Optional dates: the earlier and the later of two days, either of which may be absent (NOTHING).
-- When only one is present it is the answer; when neither is, there is none.
GIVEN first IS A MAYBE DATE
      second IS A MAYBE DATE
GIVETH A MAYBE DATE
`cr1 helper: the earlier of two optional dates` first second MEANS
    CONSIDER first
    WHEN NOTHING THEN second
    WHEN JUST a THEN
        CONSIDER second
        WHEN NOTHING THEN JUST a
        WHEN JUST b THEN JUST (IF a AT MOST b THEN a ELSE b)

GIVEN first IS A MAYBE DATE
      second IS A MAYBE DATE
GIVETH A MAYBE DATE
`cr1 helper: the later of two optional dates` first second MEANS
    CONSIDER first
    WHEN NOTHING THEN second
    WHEN JUST a THEN
        CONSIDER second
        WHEN NOTHING THEN JUST a
        WHEN JUST b THEN JUST (IF a AT LEAST b THEN a ELSE b)
