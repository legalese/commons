IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cpp-core-calendar`
IMPORT `cr2-nouns`
IMPORT `cr2-disability`

-- Tests of cr2-disability.l4 (regulations 68 to 72). Layer 1.
-- Every expected value was decided by reading the regulations, doing the arithmetic by hand and counting on a calendar
-- before the rules were run.

§ `Tests -- regulations 68 to 72`

`item 68(1)(a)(i)` MEANS `reg 68(1)(a)(i) — a report of the nature, extent and prognosis of the disability`
`item 68(1)(a)(ii)` MEANS `reg 68(1)(a)(ii) — a report of the findings upon which the diagnosis and prognosis were made`
`item 68(1)(a)(iii)` MEANS `reg 68(1)(a)(iii) — a report of any limitation resulting from the disability`
`item 68(1)(a)(iv)` MEANS `reg 68(1)(a)(iv) — a report of any other pertinent information, including recommendations for further diagnostic work or treatment`
`item 68(1)(b)` MEANS `reg 68(1)(b) — a statement of the person's occupation and earnings for the period commencing on the date the applicant alleges the disability commenced`
`item 68(1)(c)` MEANS `reg 68(1)(c) — a statement of the person's education, employment experience and activities of daily life`
`item 72(2)(a)` MEANS `reg 72(2)(a) — the applicant's name, address and Social Insurance Number and, if applicable, the name and address of the person making the request for the applicant and that person's relationship to the applicant`
`item 72(2)(b)` MEANS `reg 72(2)(b) — the month in which the applicant ceased to receive the disability pension or post-retirement disability benefit`
`item 72(2)(c)` MEANS `reg 72(2)(c) — the month in which the applicant became incapable again of working`
`item 72(2)(d)` MEANS `reg 72(2)(d) — the date that the applicant stopped working`
`item 72(2)(e)` MEANS `reg 72(2)(e) — the statement of a person qualified to practise medicine confirming a severe and prolonged disability that is the same as, or related to, the disability that entitled the applicant to the pension or benefit`
`item 72(2)(f)` MEANS `reg 72(2)(f) — the name of each dependent child of the applicant and whether the applicant has at least 20% of the parenting time in respect of the child`
`item 72(2)(g)(i)` MEANS `reg 72(2)(g)(i) — for each child aged 18 or more whose disabled contributor's child benefit is to be reinstated, the child's name, address and Social Insurance Number`
`item 72(2)(g)(ii)` MEANS `reg 72(2)(g)(ii) — for each such child, evidence, established in accordance with section 67, of full-time or part-time attendance at a school or university`

§§ `68(1) -- what the applicant supplies`

#ASSERT `reg 68(1) — the items the applicant has to supply` EQUALS (LIST `item 68(1)(a)(i)`, `item 68(1)(a)(ii)`, `item 68(1)(a)(iii)`, `item 68(1)(a)(iv)`, `item 68(1)(b)`, `item 68(1)(c)`)
-- Arguments: the applicant claims a disability; the items already supplied.
#ASSERT `reg 68(1) — the items the applicant still has to supply` TRUE (LIST `item 68(1)(a)(i)`, `item 68(1)(b)`) EQUALS (LIST `item 68(1)(a)(ii)`, `item 68(1)(a)(iii)`, `item 68(1)(a)(iv)`, `item 68(1)(c)`)
#ASSERT `reg 68(1) — the items the applicant still has to supply` TRUE (LIST `item 68(1)(a)(i)`, `item 68(1)(a)(ii)`, `item 68(1)(a)(iii)`, `item 68(1)(a)(iv)`, `item 68(1)(b)`, `item 68(1)(c)`) EQUALS EMPTY
#ASSERT `reg 68(1) — the items the applicant still has to supply` TRUE EMPTY EQUALS (LIST `item 68(1)(a)(i)`, `item 68(1)(a)(ii)`, `item 68(1)(a)(iii)`, `item 68(1)(a)(iv)`, `item 68(1)(b)`, `item 68(1)(c)`)
#ASSERT `reg 68(1) — the items the applicant still has to supply` FALSE EMPTY EQUALS EMPTY

§§ `68(2) to (4) -- what the Minister may require, and the cost`

#ASSERT `reg 68(2)(a) — the Minister may require the person to supply a statement of occupation and earnings for any period` TRUE
#ASSERT NOT (`reg 68(2)(a) — the Minister may require the person to supply a statement of occupation and earnings for any period` FALSE)
#ASSERT `reg 68(2)(b) — the Minister may require the person to undergo special examinations and to supply reports` TRUE TRUE
#ASSERT NOT (`reg 68(2)(b) — the Minister may require the person to undergo special examinations and to supply reports` TRUE FALSE)
#ASSERT NOT (`reg 68(2)(b) — the Minister may require the person to undergo special examinations and to supply reports` FALSE TRUE)
-- Arguments: required under subsection (2); the cost is reasonable.
#ASSERT `reg 68(3)(a) — the reasonable cost is paid by way of reimbursement or advance, as the Minister deems fit` TRUE TRUE
#ASSERT NOT (`reg 68(3)(a) — the reasonable cost is paid by way of reimbursement or advance, as the Minister deems fit` TRUE FALSE)
#ASSERT NOT (`reg 68(3)(a) — the reasonable cost is paid by way of reimbursement or advance, as the Minister deems fit` FALSE TRUE)
#ASSERT `reg 68(3)(b) — the reasonable cost is paid out of the Consolidated Revenue Fund` TRUE TRUE
#ASSERT NOT (`reg 68(3)(b) — the reasonable cost is paid out of the Consolidated Revenue Fund` FALSE TRUE)
#ASSERT `reg 68(3)(c) — the reasonable cost is charged to the Canada Pension Plan Account as a cost of administration of the Act` TRUE TRUE
#ASSERT NOT (`reg 68(3)(c) — the reasonable cost is charged to the Canada Pension Plan Account as a cost of administration of the Act` TRUE FALSE)
#ASSERT `reg 68(4) — the expense is included in the cost` TRUE TRUE
#ASSERT NOT (`reg 68(4) — the expense is included in the cost` TRUE FALSE)
#ASSERT NOT (`reg 68(4) — the expense is included in the cost` FALSE TRUE)

§§ `68.1 -- substantially gainful`

-- rounding to the nearest whole cent, the higher where equidistant
#ASSERT `reg 68.1(2) — an amount rounded to the nearest whole cent` 10.004 EQUALS 10
#ASSERT `reg 68.1(2) — an amount rounded to the nearest whole cent` 10.005 EQUALS 10.01
#ASSERT `reg 68.1(2) — an amount rounded to the nearest whole cent` 10.015 EQUALS 10.02
#ASSERT `reg 68.1(2) — an amount rounded to the nearest whole cent` 10.014999 EQUALS 10.01
#ASSERT `reg 68.1(2) — an amount rounded to the nearest whole cent` 10.01 EQUALS 10.01
-- Maximum Pensionable Earnings Average 60,000 and flat rate benefit 600: A = 15,000; A x B = 11,250; C = 7,200; total 18,450.
#ASSERT `reg 68.1(1) — the maximum annual amount a person could receive as a disability pension` 60000 600 EQUALS 18450
-- 59,999.99 and 612.37: A = 14,999.9975; A x B = 11,249.998125; C = 7,348.44; total 18,598.438125, rounded to 18,598.44.
#ASSERT `reg 68.1(1) — the maximum annual amount a person could receive as a disability pension` 59999.99 612.37 EQUALS 18598.44
-- Arguments: the salary or wages the occupation provides in a year; the Maximum Pensionable Earnings Average; the flat rate benefit.
#ASSERT `reg 68.1(1) — an occupation is substantially gainful` 18450 60000 600
#ASSERT `reg 68.1(1) — an occupation is substantially gainful` 30000 60000 600
#ASSERT NOT (`reg 68.1(1) — an occupation is substantially gainful` 18449.99 60000 600)
#ASSERT `reg 68.1(1) — an occupation is substantially gainful` 18598.44 59999.99 612.37
#ASSERT NOT (`reg 68.1(1) — an occupation is substantially gainful` 18598.43 59999.99 612.37)

§§ `69 -- the person determined to be disabled`

#ASSERT `reg 69(1) — the Minister may require the person to undergo special examinations, supply reports and supply statements of occupation and earnings` TRUE TRUE
#ASSERT NOT (`reg 69(1) — the Minister may require the person to undergo special examinations, supply reports and supply statements of occupation and earnings` TRUE FALSE)
#ASSERT NOT (`reg 69(1) — the Minister may require the person to undergo special examinations, supply reports and supply statements of occupation and earnings` FALSE TRUE)
#ASSERT `reg 69(2) — the Minister may require the person to undergo reasonable rehabilitation measures` TRUE TRUE
#ASSERT NOT (`reg 69(2) — the Minister may require the person to undergo reasonable rehabilitation measures` TRUE FALSE)
#ASSERT NOT (`reg 69(2) — the Minister may require the person to undergo reasonable rehabilitation measures` FALSE TRUE)
#ASSERT `reg 69(3)(a) — the reasonable cost is paid by way of reimbursement or advance, as the Minister deems fit` TRUE TRUE
#ASSERT NOT (`reg 69(3)(a) — the reasonable cost is paid by way of reimbursement or advance, as the Minister deems fit` FALSE TRUE)
#ASSERT `reg 69(3)(b) — the reasonable cost is paid out of the Consolidated Revenue Fund` TRUE TRUE
#ASSERT NOT (`reg 69(3)(b) — the reasonable cost is paid out of the Consolidated Revenue Fund` TRUE FALSE)
#ASSERT `reg 69(3)(c) — the reasonable cost is charged to the Canada Pension Plan Account as a cost of administration of the Act` TRUE TRUE
#ASSERT NOT (`reg 69(3)(c) — the reasonable cost is charged to the Canada Pension Plan Account as a cost of administration of the Act` TRUE FALSE)
#ASSERT `reg 69(4) — the expense is included in the cost` TRUE TRUE
#ASSERT NOT (`reg 69(4) — the expense is included in the cost` FALSE TRUE)

§§ `70 and 70.1 -- failure to comply, and return to work`

#ASSERT `reg 70(2) — the failure to comply is for good cause` TRUE
#ASSERT NOT (`reg 70(2) — the failure to comply is for good cause` FALSE)
-- Arguments: determined to be disabled; failed to comply with a requirement under section 69; compliance would present a significant risk to life or health.
#ASSERT `reg 70(1) — the person may be determined to have ceased to be disabled` TRUE TRUE FALSE
#ASSERT NOT (`reg 70(1) — the person may be determined to have ceased to be disabled` TRUE TRUE TRUE)
#ASSERT NOT (`reg 70(1) — the person may be determined to have ceased to be disabled` TRUE FALSE FALSE)
#ASSERT NOT (`reg 70(1) — the person may be determined to have ceased to be disabled` FALSE TRUE FALSE)
-- Arguments: the day of failure; the time the Minister specifies.
#ASSERT `reg 70(1) — the time the Minister specifies is not earlier than the day of failure to comply` (YMD 2026 3 1) (YMD 2026 3 1)
#ASSERT `reg 70(1) — the time the Minister specifies is not earlier than the day of failure to comply` (YMD 2026 3 1) (YMD 2026 9 1)
#ASSERT NOT (`reg 70(1) — the time the Minister specifies is not earlier than the day of failure to comply` (YMD 2026 3 1) (YMD 2026 2 28))
#ASSERT `reg 70.1 — the person must inform the Minister without delay` TRUE TRUE
#ASSERT NOT (`reg 70.1 — the person must inform the Minister without delay` TRUE FALSE)
#ASSERT NOT (`reg 70.1 — the person must inform the Minister without delay` FALSE TRUE)

§§ `71 -- the request for reinstatement`

#ASSERT `reg 71(1) — a request for reinstatement is made as the Regulations require` TRUE
#ASSERT NOT (`reg 71(1) — a request for reinstatement is made as the Regulations require` FALSE)
-- Became incapable again in March 2026: the 12 months after that month end with March 2027.
#ASSERT `reg 71(2) — the last day to make the request` (YMD 2026 3 15) EQUALS (YMD 2027 3 31)
#ASSERT `reg 71(2) — the last day to make the request` (YMD 2023 2 1) EQUALS (YMD 2024 2 29)
#ASSERT `reg 71(2) — the last day to make the request` (YMD 2026 12 31) EQUALS (YMD 2027 12 31)
-- Arguments: a day in the month the person became incapable again; the date of the request.
#ASSERT `reg 71(2) — the request is made in time` (YMD 2026 3 15) (YMD 2027 3 31)
#ASSERT `reg 71(2) — the request is made in time` (YMD 2026 3 15) (YMD 2026 3 1)
#ASSERT NOT (`reg 71(2) — the request is made in time` (YMD 2026 3 15) (YMD 2027 4 1))
#ASSERT NOT (`reg 71(2) — the request is made in time` (YMD 2026 3 15) (YMD 2026 2 28))

§§ `72 -- what goes with the request`

#ASSERT `reg 72(1) — the Minister must decide on the information and evidence furnished under subsection (2)` TRUE
#ASSERT NOT (`reg 72(1) — the Minister must decide on the information and evidence furnished under subsection (2)` FALSE)
#ASSERT `reg 72(2) — the items the applicant has to furnish` FALSE EQUALS (LIST `item 72(2)(a)`, `item 72(2)(b)`, `item 72(2)(c)`, `item 72(2)(d)`, `item 72(2)(e)`, `item 72(2)(f)`)
#ASSERT `reg 72(2) — the items the applicant has to furnish` TRUE EQUALS (LIST `item 72(2)(a)`, `item 72(2)(b)`, `item 72(2)(c)`, `item 72(2)(d)`, `item 72(2)(e)`, `item 72(2)(f)`, `item 72(2)(g)(i)`, `item 72(2)(g)(ii)`)
-- Arguments: the request includes the children's benefit for children aged 18 or more; the items already furnished.
#ASSERT `reg 72(2) — the items the applicant still has to furnish` FALSE (LIST `item 72(2)(a)`, `item 72(2)(c)`) EQUALS (LIST `item 72(2)(b)`, `item 72(2)(d)`, `item 72(2)(e)`, `item 72(2)(f)`)
#ASSERT `reg 72(2) — the items the applicant still has to furnish` TRUE (LIST `item 72(2)(a)`, `item 72(2)(b)`, `item 72(2)(c)`, `item 72(2)(d)`, `item 72(2)(e)`, `item 72(2)(f)`) EQUALS (LIST `item 72(2)(g)(i)`, `item 72(2)(g)(ii)`)
-- item (g) is not required when the request does not include the children's benefit
#ASSERT `reg 72(2) — the items the applicant still has to furnish` FALSE (LIST `item 72(2)(a)`, `item 72(2)(b)`, `item 72(2)(c)`, `item 72(2)(d)`, `item 72(2)(e)`, `item 72(2)(f)`) EQUALS EMPTY
#ASSERT `reg 72(2) — the items the applicant still has to furnish` TRUE EMPTY EQUALS (LIST `item 72(2)(a)`, `item 72(2)(b)`, `item 72(2)(c)`, `item 72(2)(d)`, `item 72(2)(e)`, `item 72(2)(f)`, `item 72(2)(g)(i)`, `item 72(2)(g)(ii)`)
