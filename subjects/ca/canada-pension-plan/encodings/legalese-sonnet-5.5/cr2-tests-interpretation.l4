IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cr2-interpretation`

-- Tests of cr2-interpretation.l4 (regulation 37). Layer 1.
-- Every expected value was decided by reading regulation 37 before the rules were run.

§ `Tests -- regulation 37`

§§ `37(1) Canada child benefit: both limbs are needed`

#ASSERT `reg 37(1) — an amount is a Canada child benefit` TRUE TRUE
-- a child aged seven or more is not a qualified dependant under seven years of age
#ASSERT NOT (`reg 37(1) — an amount is a Canada child benefit` TRUE FALSE)
-- not the deemed overpayment determined under section 122.61 of the Income Tax Act
#ASSERT NOT (`reg 37(1) — an amount is a Canada child benefit` FALSE TRUE)
#ASSERT NOT (`reg 37(1) — an amount is a Canada child benefit` FALSE FALSE)

§§ `37(1) personal representative`

-- Arguments: there is an estate; executor, administrator or heir; ownership or control of estate property;
-- there is a survivor; the person is the survivor; the person is the next of kin.
-- With an estate, the executor is the personal representative.
#ASSERT `reg 37(1) — a person is the personal representative of a deceased person` TRUE TRUE FALSE FALSE FALSE FALSE
-- With an estate, an administrator or heir is.
#ASSERT `reg 37(1) — a person is the personal representative of a deceased person` TRUE TRUE TRUE TRUE FALSE FALSE
-- With an estate, any other person having the ownership or control of its property is.
#ASSERT `reg 37(1) — a person is the personal representative of a deceased person` TRUE FALSE TRUE FALSE FALSE FALSE
-- With an estate, neither of those: the survivor is not the personal representative, even if there is one.
#ASSERT NOT (`reg 37(1) — a person is the personal representative of a deceased person` TRUE FALSE FALSE TRUE TRUE TRUE)
-- Where there is no estate, the survivor is.
#ASSERT `reg 37(1) — a person is the personal representative of a deceased person` FALSE FALSE FALSE TRUE TRUE FALSE
-- Where there is no estate but there is a survivor, the next of kin is not.
#ASSERT NOT (`reg 37(1) — a person is the personal representative of a deceased person` FALSE FALSE FALSE TRUE FALSE TRUE)
-- Where there is no estate and no survivor, the next of kin is.
#ASSERT `reg 37(1) — a person is the personal representative of a deceased person` FALSE FALSE FALSE FALSE FALSE TRUE
-- Where there is no estate and no survivor, a person who is not the next of kin is not.
#ASSERT NOT (`reg 37(1) — a person is the personal representative of a deceased person` FALSE FALSE FALSE FALSE FALSE FALSE)
-- An executor is not a personal representative where there is no estate (the first limb needs an estate).
#ASSERT NOT (`reg 37(1) — a person is the personal representative of a deceased person` FALSE TRUE TRUE FALSE FALSE FALSE)

§§ `37(2) and (3) persons entitled because authorized under regulation 57`

#ASSERT NOT (`reg 37(2) — a person is entitled to make an application for the purposes of subsection 60(2) of the Act` FALSE FALSE)
#ASSERT `reg 37(2) — a person is entitled to make an application for the purposes of subsection 60(2) of the Act` TRUE FALSE
#ASSERT `reg 37(2) — a person is entitled to make an application for the purposes of subsection 60(2) of the Act` FALSE TRUE
#ASSERT NOT (`reg 37(3) — a person is entitled to receive benefits for the purposes of subsection 60(4) of the Act` FALSE FALSE)
#ASSERT `reg 37(3) — a person is entitled to receive benefits for the purposes of subsection 60(4) of the Act` TRUE FALSE
#ASSERT `reg 37(3) — a person is entitled to receive benefits for the purposes of subsection 60(4) of the Act` FALSE TRUE

§§ `37(4) the prescribed public officer`

-- Arguments: employed in a federal institution; services required by one; casual or temporary; student employment program.
#ASSERT `reg 37(4) — an individual is a prescribed individual for the definition public officer in subsection 104(1) of the Act` TRUE FALSE TRUE FALSE
#ASSERT `reg 37(4) — an individual is a prescribed individual for the definition public officer in subsection 104(1) of the Act` FALSE TRUE FALSE TRUE
#ASSERT `reg 37(4) — an individual is a prescribed individual for the definition public officer in subsection 104(1) of the Act` TRUE TRUE TRUE TRUE
-- Employed, but on neither basis the regulation names:
#ASSERT NOT (`reg 37(4) — an individual is a prescribed individual for the definition public officer in subsection 104(1) of the Act` TRUE FALSE FALSE FALSE)
-- On a casual basis, but neither employed in nor required by a federal institution:
#ASSERT NOT (`reg 37(4) — an individual is a prescribed individual for the definition public officer in subsection 104(1) of the Act` FALSE FALSE TRUE TRUE)
