IMPORT prelude
IMPORT `cpp-core`
IMPORT `cr1-part3-transport`

-- Tests of cr1-part3-transport.l4 (regulations 17 to 21). Every expected value is written from the text
-- (C.R.C.-c.-385.txt lines 263 to 293) before the run.

§ `Tests of regulations 17 to 21`

§§ `Regulation 17`

#ASSERT `reg 17(1) — employment in international transportation described in sections 18 to 21 is pensionable employment` TRUE TRUE
#ASSERT NOT (`reg 17(1) — employment in international transportation described in sections 18 to 21 is pensionable employment` TRUE FALSE)
#ASSERT NOT (`reg 17(1) — employment in international transportation described in sections 18 to 21 is pensionable employment` FALSE TRUE)
-- Excepted unless one of the sections includes it (section 21 counted with 18, 19, 20 and 22: fork F12).
#ASSERT `reg 17(2) — employment in international transportation is excepted from pensionable employment` FALSE FALSE FALSE FALSE FALSE
#ASSERT NOT (`reg 17(2) — employment in international transportation is excepted from pensionable employment` TRUE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`reg 17(2) — employment in international transportation is excepted from pensionable employment` FALSE TRUE FALSE FALSE FALSE)
#ASSERT NOT (`reg 17(2) — employment in international transportation is excepted from pensionable employment` FALSE FALSE TRUE FALSE FALSE)
#ASSERT NOT (`reg 17(2) — employment in international transportation is excepted from pensionable employment` FALSE FALSE FALSE TRUE FALSE)
#ASSERT NOT (`reg 17(2) — employment in international transportation is excepted from pensionable employment` FALSE FALSE FALSE FALSE TRUE)

§§ `Regulation 18: ships`

-- Arguments: a Canadian citizen; a permanent resident under the Immigration and Refugee Protection Act; a place to return to as the permanent abode.
#ASSERT `reg 18(3) — a person has a place of domicile in Canada` TRUE FALSE FALSE
#ASSERT `reg 18(3) — a person has a place of domicile in Canada` FALSE TRUE TRUE
#ASSERT NOT (`reg 18(3) — a person has a place of domicile in Canada` FALSE TRUE FALSE)
#ASSERT NOT (`reg 18(3) — a person has a place of domicile in Canada` FALSE FALSE TRUE)
#ASSERT NOT (`reg 18(3) — a person has a place of domicile in Canada` FALSE FALSE FALSE)
#ASSERT `reg 18(4) — an agreement is an agreement with the crew` TRUE
#ASSERT NOT (`reg 18(4) — an agreement is an agreement with the crew` FALSE)
#ASSERT `reg 18(4) — a voyage is an inland voyage` `any river, lake or other navigable fresh waters within Canada, including the St. Lawrence River as far seaward as a straight line drawn from Cap-des-Rosiers to West Point, Anticosti Island and from Anticosti Island to the north shore of the St. Lawrence River along a meridian of longitude 63° W.`
#ASSERT `reg 18(4) — a voyage is an inland voyage` `any part of any lake or river forming part of the inland waters of Canada that lies within the United States`
#ASSERT `reg 18(4) — a voyage is an inland voyage` `Lake Michigan`
#ASSERT `reg 18(4) — a voyage is an inland voyage` `any sheltered waters on the coasts of Canada that are described in Schedule 1 to the Vessel Safety Certificates Regulations`
#ASSERT NOT (`reg 18(4) — a voyage is an inland voyage` `other waters`)
-- 18(1): employer operating in Canada; agreement with the crew entered into in Canada; inland voyage (all persons) or otherwise a person with a Canadian domicile.
#ASSERT `reg 18(1) — pensionable employment includes the employment on the ship under an agreement with the crew` TRUE TRUE TRUE FALSE
#ASSERT `reg 18(1) — pensionable employment includes the employment on the ship under an agreement with the crew` TRUE TRUE FALSE TRUE
#ASSERT NOT (`reg 18(1) — pensionable employment includes the employment on the ship under an agreement with the crew` TRUE TRUE FALSE FALSE)
#ASSERT NOT (`reg 18(1) — pensionable employment includes the employment on the ship under an agreement with the crew` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`reg 18(1) — pensionable employment includes the employment on the ship under an agreement with the crew` TRUE FALSE TRUE TRUE)
-- 18(2): no agreement with the crew at all, and operated mainly in and near Canada.
#ASSERT `reg 18(2) — pensionable employment includes the employment on the ship not under an agreement with the crew` TRUE FALSE TRUE
#ASSERT NOT (`reg 18(2) — pensionable employment includes the employment on the ship not under an agreement with the crew` TRUE TRUE TRUE)
#ASSERT NOT (`reg 18(2) — pensionable employment includes the employment on the ship not under an agreement with the crew` TRUE FALSE FALSE)
#ASSERT NOT (`reg 18(2) — pensionable employment includes the employment on the ship not under an agreement with the crew` FALSE FALSE TRUE)
-- A ship under an agreement with the crew entered into outside Canada is in neither (1) nor (2): (1) wants the agreement entered into in Canada; (2) wants no agreement.
#ASSERT NOT (`reg 18(1) — pensionable employment includes the employment on the ship under an agreement with the crew` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`reg 18(2) — pensionable employment includes the employment on the ship not under an agreement with the crew` TRUE TRUE TRUE)

§§ `Regulations 19 to 21`

#ASSERT `reg 19 — pensionable employment includes the employment on the aircraft` TRUE TRUE TRUE
#ASSERT NOT (`reg 19 — pensionable employment includes the employment on the aircraft` TRUE TRUE FALSE)
#ASSERT NOT (`reg 19 — pensionable employment includes the employment on the aircraft` TRUE FALSE TRUE)
#ASSERT NOT (`reg 19 — pensionable employment includes the employment on the aircraft` FALSE TRUE TRUE)

#ASSERT `reg 20(1) — the part of the employment on a train of a Canadian railway company that is pensionable employment` TRUE TRUE 120 TRUE EQUALS JUST 120
#ASSERT `reg 20(1) — the part of the employment on a train of a Canadian railway company that is pensionable employment` TRUE TRUE 120 FALSE EQUALS NOTHING
#ASSERT `reg 20(1) — the part of the employment on a train of a Canadian railway company that is pensionable employment` TRUE FALSE 120 TRUE EQUALS NOTHING
#ASSERT `reg 20(1) — the part of the employment on a train of a Canadian railway company that is pensionable employment` FALSE TRUE 120 TRUE EQUALS NOTHING
-- 20(2): a railway company whose principal place of business is outside Canada; only the part of a person resident in Canada.
#ASSERT `reg 20(2) — the part of the employment on a train of a foreign railway company that is pensionable employment` TRUE TRUE TRUE 35 TRUE EQUALS JUST 35
#ASSERT `reg 20(2) — the part of the employment on a train of a foreign railway company that is pensionable employment` TRUE TRUE FALSE 35 TRUE EQUALS NOTHING
#ASSERT `reg 20(2) — the part of the employment on a train of a foreign railway company that is pensionable employment` TRUE TRUE TRUE 35 FALSE EQUALS NOTHING
#ASSERT `reg 20(2) — the part of the employment on a train of a foreign railway company that is pensionable employment` TRUE FALSE TRUE 35 TRUE EQUALS NOTHING

#ASSERT `reg 21 — pensionable employment includes the employment on the motor vehicle` TRUE TRUE TRUE
#ASSERT NOT (`reg 21 — pensionable employment includes the employment on the motor vehicle` FALSE TRUE TRUE)
#ASSERT NOT (`reg 21 — pensionable employment includes the employment on the motor vehicle` TRUE FALSE TRUE)
#ASSERT NOT (`reg 21 — pensionable employment includes the employment on the motor vehicle` TRUE TRUE FALSE)
