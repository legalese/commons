IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cpp-core-calendar`
IMPORT `cpp-core-age`
IMPORT `cr2-deductions-and-family-allowance`

-- Tests of cr2-deductions-and-family-allowance.l4 (regulations 76, 76.1 and 77). Layer 1.
-- Every expected value was decided by reading the regulations and counting on a calendar before the rules were run.

§ `Tests -- regulations 76, 76.1 and 77`

§§ `76(1) -- the definitions`

#ASSERT `reg 76(1) — a body is an authority` TRUE TRUE
#ASSERT NOT (`reg 76(1) — a body is an authority` TRUE FALSE)
#ASSERT NOT (`reg 76(1) — a body is an authority` FALSE TRUE)
#ASSERT `reg 76(1) — an amount is an excess payment` TRUE TRUE
#ASSERT NOT (`reg 76(1) — an amount is an excess payment` TRUE FALSE)
#ASSERT NOT (`reg 76(1) — an amount is an excess payment` FALSE TRUE)

§§ `76(3), (4), (6) and (2) -- certification, conditions of a deduction, and the deduction`

#ASSERT `reg 76(3) — the authority has certified what the regulation requires` TRUE TRUE TRUE
#ASSERT NOT (`reg 76(3) — the authority has certified what the regulation requires` FALSE TRUE TRUE)
#ASSERT NOT (`reg 76(3) — the authority has certified what the regulation requires` TRUE FALSE TRUE)
#ASSERT NOT (`reg 76(3) — the authority has certified what the regulation requires` TRUE TRUE FALSE)
-- Arguments: irrevocable and in writing; date signed; date received. A consent signed 1 March 2025 is in time until 1 March 2026.
#ASSERT `reg 76(4)(c) — the irrevocable written consent was received in time` TRUE (YearMonthDay 2025 3 1) (YearMonthDay 2026 3 1)
#ASSERT `reg 76(4)(c) — the irrevocable written consent was received in time` TRUE (YearMonthDay 2025 3 1) (YearMonthDay 2025 3 1)
#ASSERT NOT (`reg 76(4)(c) — the irrevocable written consent was received in time` TRUE (YearMonthDay 2025 3 1) (YearMonthDay 2026 3 2))
#ASSERT NOT (`reg 76(4)(c) — the irrevocable written consent was received in time` TRUE (YearMonthDay 2025 3 1) (YearMonthDay 2025 2 28))
#ASSERT NOT (`reg 76(4)(c) — the irrevocable written consent was received in time` FALSE (YearMonthDay 2025 3 1) (YearMonthDay 2025 6 1))
-- Arguments: agreement in writing; certification received; consent irrevocable and in writing; date signed; date received; amount of the excess payment.
#ASSERT `reg 76(4) — a deduction and payment in respect of an excess payment may be authorized` TRUE TRUE TRUE (YearMonthDay 2025 3 1) (YearMonthDay 2025 9 1) 50.01
-- the excess payment must be greater than $50
#ASSERT NOT (`reg 76(4) — a deduction and payment in respect of an excess payment may be authorized` TRUE TRUE TRUE (YearMonthDay 2025 3 1) (YearMonthDay 2025 9 1) 50)
#ASSERT NOT (`reg 76(4) — a deduction and payment in respect of an excess payment may be authorized` FALSE TRUE TRUE (YearMonthDay 2025 3 1) (YearMonthDay 2025 9 1) 500)
#ASSERT NOT (`reg 76(4) — a deduction and payment in respect of an excess payment may be authorized` TRUE FALSE TRUE (YearMonthDay 2025 3 1) (YearMonthDay 2025 9 1) 500)
#ASSERT NOT (`reg 76(4) — a deduction and payment in respect of an excess payment may be authorized` TRUE TRUE FALSE (YearMonthDay 2025 3 1) (YearMonthDay 2025 9 1) 500)
#ASSERT NOT (`reg 76(4) — a deduction and payment in respect of an excess payment may be authorized` TRUE TRUE TRUE (YearMonthDay 2025 3 1) (YearMonthDay 2026 3 2) 500)
-- 76(2): arguments: the authority satisfies the Minister; a one sum amount is payable under 62(1); agreement; certification; consent in writing;
-- date signed; date received; amount of the excess payment; a deduction has already been authorized.
#ASSERT `reg 76(2) — the amount the Minister may authorize to be deducted and paid` TRUE TRUE TRUE TRUE TRUE (YearMonthDay 2025 3 1) (YearMonthDay 2025 9 1) 500 FALSE EQUALS JUST 500
#ASSERT `reg 76(2) — the amount the Minister may authorize to be deducted and paid` TRUE TRUE TRUE TRUE TRUE (YearMonthDay 2025 3 1) (YearMonthDay 2025 9 1) 500 TRUE EQUALS NOTHING
#ASSERT `reg 76(2) — the amount the Minister may authorize to be deducted and paid` TRUE FALSE TRUE TRUE TRUE (YearMonthDay 2025 3 1) (YearMonthDay 2025 9 1) 500 FALSE EQUALS NOTHING
#ASSERT `reg 76(2) — the amount the Minister may authorize to be deducted and paid` FALSE TRUE TRUE TRUE TRUE (YearMonthDay 2025 3 1) (YearMonthDay 2025 9 1) 500 FALSE EQUALS NOTHING
#ASSERT `reg 76(2) — the amount the Minister may authorize to be deducted and paid` TRUE TRUE TRUE TRUE TRUE (YearMonthDay 2025 3 1) (YearMonthDay 2025 9 1) 50 FALSE EQUALS NOTHING
#ASSERT `reg 76(2) — the amount the Minister may authorize to be deducted and paid` TRUE TRUE TRUE FALSE TRUE (YearMonthDay 2025 3 1) (YearMonthDay 2025 9 1) 500 FALSE EQUALS NOTHING
#ASSERT `reg 76(6) — the Minister must not authorize the deduction and payment of any other amount in respect of that excess payment` TRUE
#ASSERT NOT (`reg 76(6) — the Minister must not authorize the deduction and payment of any other amount in respect of that excess payment` FALSE)

§§ `76.1 -- payment to an administrator of a disability income program`

-- Arguments: the benefit; the amount is one described in 65(3); administrator approved; record and consent submitted; date signed; date received; the amount.
#ASSERT `reg 76.1(1) — the Minister may deduct an amount from a benefit and pay it to an administrator` `a disability pension` TRUE TRUE TRUE (YearMonthDay 2025 3 1) (YearMonthDay 2026 3 1) 50.01
#ASSERT `reg 76.1(1) — the Minister may deduct an amount from a benefit and pay it to an administrator` `a post-retirement disability benefit` TRUE TRUE TRUE (YearMonthDay 2025 3 1) (YearMonthDay 2025 4 1) 1000
-- another kind of benefit
#ASSERT NOT (`reg 76.1(1) — the Minister may deduct an amount from a benefit and pay it to an administrator` `a retirement pension` TRUE TRUE TRUE (YearMonthDay 2025 3 1) (YearMonthDay 2025 4 1) 1000)
#ASSERT NOT (`reg 76.1(1) — the Minister may deduct an amount from a benefit and pay it to an administrator` `a disability pension` TRUE TRUE TRUE (YearMonthDay 2025 3 1) (YearMonthDay 2025 4 1) 50)
#ASSERT NOT (`reg 76.1(1) — the Minister may deduct an amount from a benefit and pay it to an administrator` `a disability pension` TRUE TRUE TRUE (YearMonthDay 2025 3 1) (YearMonthDay 2026 3 2) 1000)
#ASSERT NOT (`reg 76.1(1) — the Minister may deduct an amount from a benefit and pay it to an administrator` `a disability pension` TRUE FALSE TRUE (YearMonthDay 2025 3 1) (YearMonthDay 2025 4 1) 1000)
#ASSERT NOT (`reg 76.1(1) — the Minister may deduct an amount from a benefit and pay it to an administrator` `a disability pension` TRUE TRUE FALSE (YearMonthDay 2025 3 1) (YearMonthDay 2025 4 1) 1000)
#ASSERT NOT (`reg 76.1(1) — the Minister may deduct an amount from a benefit and pay it to an administrator` `a disability pension` FALSE TRUE TRUE (YearMonthDay 2025 3 1) (YearMonthDay 2025 4 1) 1000)
#ASSERT `reg 76.1(2) — the Minister must not authorize any other deduction and payment` TRUE
#ASSERT NOT (`reg 76.1(2) — the Minister must not authorize any other deduction and payment` FALSE)

§§ `77 -- family allowance recipient`

-- Arguments: described in the Act's definition; spouse of such a person; the child's date of birth; the last day of the allowance period;
-- primary caregiver at home; the period is or can be excluded; Armed Forces member posted abroad; but for the posting would have received;
-- eligible individual under the Income Tax Act; would have been eligible had a notice been filed; no other person was eligible.
-- The Act's own definition.
#ASSERT `reg 77(1) — a person is a family allowance recipient for the purposes of the Act` TRUE FALSE (YearMonthDay 2015 6 15) (YearMonthDay 2022 6 30) FALSE FALSE FALSE FALSE FALSE FALSE FALSE
-- (a): a child born 15 June 2015 reaches seven on 1 July 2022 (section 2(2)); the period ended 30 June 2022, before that.
#ASSERT `reg 77(1) — a person is a family allowance recipient for the purposes of the Act` FALSE TRUE (YearMonthDay 2015 6 15) (YearMonthDay 2022 6 30) TRUE FALSE FALSE FALSE FALSE FALSE FALSE
#ASSERT NOT (`reg 77(1) — a person is a family allowance recipient for the purposes of the Act` FALSE TRUE (YearMonthDay 2015 6 15) (YearMonthDay 2022 7 1) TRUE FALSE FALSE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`reg 77(1) — a person is a family allowance recipient for the purposes of the Act` FALSE TRUE (YearMonthDay 2015 6 15) (YearMonthDay 2022 6 30) FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
-- the months are already or can be excluded under Part II, so the extension does nothing
#ASSERT NOT (`reg 77(1) — a person is a family allowance recipient for the purposes of the Act` FALSE TRUE (YearMonthDay 2015 6 15) (YearMonthDay 2022 6 30) TRUE TRUE FALSE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`reg 77(1) — a person is a family allowance recipient for the purposes of the Act` FALSE FALSE (YearMonthDay 2015 6 15) (YearMonthDay 2022 6 30) TRUE FALSE FALSE FALSE FALSE FALSE FALSE)
-- (b): a member of the Canadian Armed Forces posted abroad before 1973 who, but for the posting, would have received the allowance
#ASSERT `reg 77(1) — a person is a family allowance recipient for the purposes of the Act` FALSE FALSE (YearMonthDay 2015 6 15) (YearMonthDay 2022 6 30) FALSE FALSE TRUE TRUE FALSE FALSE FALSE
#ASSERT NOT (`reg 77(1) — a person is a family allowance recipient for the purposes of the Act` FALSE FALSE (YearMonthDay 2015 6 15) (YearMonthDay 2022 6 30) FALSE FALSE TRUE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`reg 77(1) — a person is a family allowance recipient for the purposes of the Act` FALSE FALSE (YearMonthDay 2015 6 15) (YearMonthDay 2022 6 30) FALSE FALSE FALSE TRUE FALSE FALSE FALSE)
-- (c): considered an eligible individual under section 122.62 of the Income Tax Act
#ASSERT `reg 77(1) — a person is a family allowance recipient for the purposes of the Act` FALSE FALSE (YearMonthDay 2015 6 15) (YearMonthDay 2022 6 30) FALSE FALSE FALSE FALSE TRUE FALSE FALSE
-- (d): would have been eligible had a notice been filed, and nobody else was eligible
#ASSERT `reg 77(1) — a person is a family allowance recipient for the purposes of the Act` FALSE FALSE (YearMonthDay 2015 6 15) (YearMonthDay 2022 6 30) FALSE FALSE FALSE FALSE FALSE TRUE TRUE
#ASSERT NOT (`reg 77(1) — a person is a family allowance recipient for the purposes of the Act` FALSE FALSE (YearMonthDay 2015 6 15) (YearMonthDay 2022 6 30) FALSE FALSE FALSE FALSE FALSE TRUE FALSE)
#ASSERT NOT (`reg 77(1) — a person is a family allowance recipient for the purposes of the Act` FALSE FALSE (YearMonthDay 2015 6 15) (YearMonthDay 2022 6 30) FALSE FALSE FALSE FALSE FALSE FALSE TRUE)
#ASSERT NOT (`reg 77(1) — a person is a family allowance recipient for the purposes of the Act` FALSE FALSE (YearMonthDay 2015 6 15) (YearMonthDay 2022 6 30) FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
