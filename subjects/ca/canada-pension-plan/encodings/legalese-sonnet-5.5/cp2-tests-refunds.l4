IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cpp-core-calendar`
IMPORT `cpp-core-definitions`
IMPORT `cp2-refunds`

-- Tests of cp2-refunds.l4 (Act sections 38 and 39).
-- Expected values were decided by reading the section, then written down; none was copied from the rule's output.
-- For the year 2024 the four years after the end of the year end on 31 December 2028 and the ten years on 31 December 2034.

§ `Tests -- refunds of overpayments`

§§ `s 38(1) -- the employee: four years, or ten after a disability pension decision`

-- The ten years apply only to an employee notified AFTER 1 September 2010.
#ASSERT `s 38(1) — the number of years after the end of the year within which the application must be made` NOTHING EQUALS 4
#ASSERT `s 38(1) — the number of years after the end of the year within which the application must be made` (JUST (YMD 2010 9 2)) EQUALS 10
#ASSERT `s 38(1) — the number of years after the end of the year within which the application must be made` (JUST (YMD 2010 9 1)) EQUALS 4
#ASSERT `s 38(1) — the number of years after the end of the year within which the application must be made` (JUST (YMD 2010 8 31)) EQUALS 4
#ASSERT `s 38(1) — the number of years after the end of the year within which the application must be made` (JUST (YMD 2015 1 1)) EQUALS 10
#ASSERT `s 38(1) — the last day for the employee to apply for a refund of the overpayment` 2024 NOTHING EQUALS YMD 2028 12 31
#ASSERT `s 38(1) — the last day for the employee to apply for a refund of the overpayment` 2024 (JUST (YMD 2012 3 1)) EQUALS YMD 2034 12 31
#ASSERT `s 38(1) — the last day for the employee to apply for a refund of the overpayment` 2024 (JUST (YMD 2010 9 1)) EQUALS YMD 2028 12 31

#ASSERT `s 38(1) — the Minister must refund the overpayment to the employee` TRUE TRUE 2024 (YMD 2028 12 31) NOTHING
#ASSERT `s 38(1) — the Minister must refund the overpayment to the employee` TRUE TRUE 2024 (YMD 2025 1 1) NOTHING
#ASSERT NOT (`s 38(1) — the Minister must refund the overpayment to the employee` TRUE TRUE 2024 (YMD 2029 1 1) NOTHING)
-- Ten years for the employee notified after 1 September 2010: 31 December 2034 is in time, 1 January 2035 is not.
#ASSERT `s 38(1) — the Minister must refund the overpayment to the employee` TRUE TRUE 2024 (YMD 2034 12 31) (JUST (YMD 2012 3 1))
#ASSERT NOT (`s 38(1) — the Minister must refund the overpayment to the employee` TRUE TRUE 2024 (YMD 2035 1 1) (JUST (YMD 2012 3 1)))
#ASSERT `s 38(1) — the Minister must refund the overpayment to the employee` TRUE TRUE 2024 (YMD 2029 1 1) (JUST (YMD 2012 3 1))
-- Notified on 1 September 2010 itself: four years only.
#ASSERT NOT (`s 38(1) — the Minister must refund the overpayment to the employee` TRUE TRUE 2024 (YMD 2029 1 1) (JUST (YMD 2010 9 1)))
-- No overpayment, or no application in writing.
#ASSERT NOT (`s 38(1) — the Minister must refund the overpayment to the employee` FALSE TRUE 2024 (YMD 2025 1 1) NOTHING)
#ASSERT NOT (`s 38(1) — the Minister must refund the overpayment to the employee` TRUE FALSE 2024 (YMD 2025 1 1) NOTHING)
#ASSERT `s 38(1) — the amount the Minister must refund to the employee` TRUE 250 EQUALS 250
#ASSERT `s 38(1) — the amount the Minister must refund to the employee` FALSE 250 EQUALS 0

§§ `s 38(2) -- the excess decided on appeal: 30 days`

#ASSERT `s 38(2) — the Minister must refund the excess after the decision on appeal` TRUE TRUE TRUE (YMD 2026 3 1) (YMD 2026 3 31)
#ASSERT `s 38(2) — the Minister must refund the excess after the decision on appeal` TRUE TRUE TRUE (YMD 2026 3 1) (YMD 2026 3 1)
#ASSERT NOT (`s 38(2) — the Minister must refund the excess after the decision on appeal` TRUE TRUE TRUE (YMD 2026 3 1) (YMD 2026 4 1))
#ASSERT NOT (`s 38(2) — the Minister must refund the excess after the decision on appeal` TRUE TRUE TRUE (YMD 2026 3 1) (YMD 2026 2 28))
#ASSERT NOT (`s 38(2) — the Minister must refund the excess after the decision on appeal` TRUE FALSE TRUE (YMD 2026 3 1) (YMD 2026 3 5))
#ASSERT NOT (`s 38(2) — the Minister must refund the excess after the decision on appeal` TRUE TRUE FALSE (YMD 2026 3 1) (YMD 2026 3 5))
#ASSERT NOT (`s 38(2) — the Minister must refund the excess after the decision on appeal` FALSE TRUE TRUE (YMD 2026 3 1) (YMD 2026 3 5))
#ASSERT `s 38(2) — the amount of the excess the Minister must refund` TRUE 1500 1200 EQUALS 300
#ASSERT `s 38(2) — the amount of the excess the Minister must refund` TRUE 1200 1200 EQUALS 0
#ASSERT `s 38(2) — the amount of the excess the Minister must refund` TRUE 1000 1200 EQUALS 0
#ASSERT `s 38(2) — the amount of the excess the Minister must refund` FALSE 1500 1200 EQUALS 0

§§ `s 38(3) -- the employee whose deductions exceed section 8`

#ASSERT `s 38(3) — the Minister may refund the excess to the employee` TRUE TRUE 2024 (YMD 2028 12 31) NOTHING
#ASSERT NOT (`s 38(3) — the Minister may refund the excess to the employee` TRUE TRUE 2024 (YMD 2029 1 1) NOTHING)
#ASSERT `s 38(3) — the Minister may refund the excess to the employee` TRUE TRUE 2024 (YMD 2034 12 31) (JUST (YMD 2012 3 1))
#ASSERT NOT (`s 38(3) — the Minister may refund the excess to the employee` TRUE FALSE 2024 (YMD 2025 1 1) NOTHING)
#ASSERT NOT (`s 38(3) — the Minister may refund the excess to the employee` FALSE TRUE 2024 (YMD 2025 1 1) NOTHING)
#ASSERT `s 38(3) — the amount of the excess the Minister may refund to the employee` 1800 1500 EQUALS 300
#ASSERT `s 38(3) — the amount of the excess the Minister may refund to the employee` 1500 1500 EQUALS 0
#ASSERT `s 38(3) — the amount of the excess the Minister may refund to the employee` 1500 1800 EQUALS 0

§§ `s 38(3.1) to (3.3) -- the employer`

-- The employer has four years only, however long the employee has.
#ASSERT `s 38(3.1) — the Minister may refund the excess to the employer` TRUE TRUE 2024 (YMD 2028 12 31)
#ASSERT NOT (`s 38(3.1) — the Minister may refund the excess to the employer` TRUE TRUE 2024 (YMD 2029 1 1))
#ASSERT NOT (`s 38(3.1) — the Minister may refund the excess to the employer` TRUE FALSE 2024 (YMD 2025 1 1))
#ASSERT NOT (`s 38(3.1) — the Minister may refund the excess to the employer` FALSE TRUE 2024 (YMD 2025 1 1))
#ASSERT `s 38(3.1) — the amount of the excess the Minister may refund to the employer` 2000 1500 EQUALS 500
#ASSERT `s 38(3.1) — the amount of the excess the Minister may refund to the employer` 1500 1500 EQUALS 0
-- (3.2): an employer's contribution required under section 9 is not refundable.
#ASSERT `s 38(3.2) — no refund may be made of the amount` TRUE
#ASSERT NOT (`s 38(3.2) — no refund may be made of the amount` FALSE)
#ASSERT `s 38(3.3) — the Minister may refund the section 21.01 amount to the employer` TRUE TRUE 2024 (YMD 2028 12 31)
#ASSERT NOT (`s 38(3.3) — the Minister may refund the section 21.01 amount to the employer` TRUE TRUE 2024 (YMD 2029 1 1))
#ASSERT NOT (`s 38(3.3) — the Minister may refund the section 21.01 amount to the employer` FALSE TRUE 2024 (YMD 2025 1 1))
#ASSERT NOT (`s 38(3.3) — the Minister may refund the section 21.01 amount to the employer` TRUE FALSE 2024 (YMD 2025 1 1))

§§ `s 38(4) and (4.1) -- the self-employed person`

-- (a): the Minister may refund the excess on sending the notice of assessment, with no application.
#ASSERT `s 38(4)(a) — the Minister may refund the excess on sending the notice of assessment, without any application` TRUE
#ASSERT NOT (`s 38(4)(a) — the Minister may refund the excess on sending the notice of assessment, without any application` FALSE)
-- (b): after the notice, on written application within four years (ten after a disability pension decision).
#ASSERT `s 38(4)(b) — the Minister must refund the excess after sending the notice of assessment` TRUE TRUE TRUE 2024 (YMD 2028 12 31) NOTHING
#ASSERT NOT (`s 38(4)(b) — the Minister must refund the excess after sending the notice of assessment` TRUE TRUE TRUE 2024 (YMD 2029 1 1) NOTHING)
#ASSERT `s 38(4)(b) — the Minister must refund the excess after sending the notice of assessment` TRUE TRUE TRUE 2024 (YMD 2034 12 31) (JUST (YMD 2015 1 1))
#ASSERT NOT (`s 38(4)(b) — the Minister must refund the excess after sending the notice of assessment` TRUE TRUE TRUE 2024 (YMD 2035 1 1) (JUST (YMD 2015 1 1)))
#ASSERT NOT (`s 38(4)(b) — the Minister must refund the excess after sending the notice of assessment` TRUE FALSE TRUE 2024 (YMD 2025 1 1) NOTHING)
#ASSERT NOT (`s 38(4)(b) — the Minister must refund the excess after sending the notice of assessment` TRUE TRUE FALSE 2024 (YMD 2025 1 1) NOTHING)
#ASSERT NOT (`s 38(4)(b) — the Minister must refund the excess after sending the notice of assessment` FALSE TRUE TRUE 2024 (YMD 2025 1 1) NOTHING)
#ASSERT `s 38(4) — the part of the amount paid that is in excess of the contributions` 3000 2600 EQUALS 400
#ASSERT `s 38(4) — the part of the amount paid that is in excess of the contributions` 2600 2600 EQUALS 0
#ASSERT `s 38(4) — the part of the amount paid that is in excess of the contributions` 2000 2600 EQUALS 0
#ASSERT `s 38(4.1) — the Minister may refund the excess after the Record of Earnings is corrected` TRUE TRUE
#ASSERT NOT (`s 38(4.1) — the Minister may refund the excess after the Record of Earnings is corrected` TRUE FALSE)
#ASSERT NOT (`s 38(4.1) — the Minister may refund the excess after the Record of Earnings is corrected` FALSE TRUE)

§§ `s 38(5) to (8) -- recovery, set-off and interest`

#ASSERT `s 38(5) — the excess that may be recovered at any time from the employee as a debt due to Her Majesty` TRUE 900 700 EQUALS 200
#ASSERT `s 38(5) — the excess that may be recovered at any time from the employee as a debt due to Her Majesty` TRUE 700 700 EQUALS 0
#ASSERT `s 38(5) — the excess that may be recovered at any time from the employee as a debt due to Her Majesty` TRUE 500 700 EQUALS 0
#ASSERT `s 38(5) — the excess that may be recovered at any time from the employee as a debt due to Her Majesty` FALSE 900 700 EQUALS 0
#ASSERT `s 38(6) — the Minister may apply the refund to the person's liability instead of making the refund` TRUE TRUE
#ASSERT NOT (`s 38(6) — the Minister may apply the refund to the person's liability instead of making the refund` TRUE FALSE)
#ASSERT NOT (`s 38(6) — the Minister may apply the refund to the person's liability instead of making the refund` FALSE TRUE)
#ASSERT `s 38(6) — the amount of the refund applied to the liability` TRUE 500 300 EQUALS 300
#ASSERT `s 38(6) — the amount of the refund applied to the liability` TRUE 500 800 EQUALS 500
#ASSERT `s 38(6) — the amount of the refund applied to the liability` TRUE 500 500 EQUALS 500
#ASSERT `s 38(6) — the amount of the refund applied to the liability` FALSE 500 300 EQUALS 0
#ASSERT `s 38(6) — the Minister must notify the person of the application of the refund` TRUE
#ASSERT NOT (`s 38(6) — the Minister must notify the person of the application of the refund` FALSE)

-- (7): 1000 refunded 365 days after 1 May 2027 (30 April 2028, since 2028 has a 29 February) at 5% is 50.
#ASSERT `s 38(7) — the interest paid or applied on the overpayment` TRUE 1000 (YMD 2027 5 1) (YMD 2028 4 30) (5%) FALSE FALSE EQUALS 50
-- (a): under one dollar, none. 100 at 5% for 73 days is exactly 1; for 72 days it is less than 1.
#ASSERT `s 38(7) — the interest paid or applied on the overpayment` TRUE 100 (YMD 2027 5 1) (YMD 2027 7 13) (5%) FALSE FALSE EQUALS 1
#ASSERT `s 38(7) — the interest paid or applied on the overpayment` TRUE 100 (YMD 2027 5 1) (YMD 2027 7 12) (5%) FALSE FALSE EQUALS 0
-- (b): none on an amount refundable under (4.1); (8): none on a section 21.01 amount.
#ASSERT `s 38(7) — the interest paid or applied on the overpayment` TRUE 1000 (YMD 2027 5 1) (YMD 2028 4 30) (5%) TRUE FALSE EQUALS 0
#ASSERT `s 38(7) — the interest paid or applied on the overpayment` TRUE 1000 (YMD 2027 5 1) (YMD 2028 4 30) (5%) FALSE TRUE EQUALS 0
-- No refund, or a refund before the period begins: none.
#ASSERT `s 38(7) — the interest paid or applied on the overpayment` FALSE 1000 (YMD 2027 5 1) (YMD 2028 4 30) (5%) FALSE FALSE EQUALS 0
#ASSERT `s 38(7) — the interest paid or applied on the overpayment` TRUE 1000 (YMD 2027 5 1) (YMD 2027 4 1) (5%) FALSE FALSE EQUALS 0
#ASSERT `s 38(8) — subsection 38(7) does not apply to the amount` TRUE
#ASSERT NOT (`s 38(8) — subsection 38(7) does not apply to the amount` FALSE)

§§ `s 39 -- refunds under an agreement with a province`

#ASSERT `s 39(1) — the Minister may refund the whole amount of the excess to the employee in accordance with the agreement` TRUE TRUE TRUE 2024 (YMD 2028 12 31)
#ASSERT NOT (`s 39(1) — the Minister may refund the whole amount of the excess to the employee in accordance with the agreement` TRUE TRUE TRUE 2024 (YMD 2029 1 1))
#ASSERT NOT (`s 39(1) — the Minister may refund the whole amount of the excess to the employee in accordance with the agreement` FALSE TRUE TRUE 2024 (YMD 2025 1 1))
#ASSERT NOT (`s 39(1) — the Minister may refund the whole amount of the excess to the employee in accordance with the agreement` TRUE FALSE TRUE 2024 (YMD 2025 1 1))
#ASSERT NOT (`s 39(1) — the Minister may refund the whole amount of the excess to the employee in accordance with the agreement` TRUE TRUE FALSE 2024 (YMD 2025 1 1))
#ASSERT `s 39(1) — the amount deemed to be an overpayment made by the employee under this Act` TRUE 120 EQUALS 120
#ASSERT `s 39(1) — the amount deemed to be an overpayment made by the employee under this Act` FALSE 120 EQUALS 0
#ASSERT `s 39(2) — the amount deemed to be an overpayment made by the employee under the provincial pension plan` TRUE 120 EQUALS 120
#ASSERT `s 39(2) — the amount deemed to be an overpayment made by the employee under the provincial pension plan` FALSE 120 EQUALS 0
#ASSERT `s 39(3) — the agreement may provide for the financial adjustments and for crediting or charging them to the Canada Pension Plan Account or the Additional Canada Pension Plan Account` TRUE TRUE
#ASSERT NOT (`s 39(3) — the agreement may provide for the financial adjustments and for crediting or charging them to the Canada Pension Plan Account or the Additional Canada Pension Plan Account` TRUE FALSE)
#ASSERT NOT (`s 39(3) — the agreement may provide for the financial adjustments and for crediting or charging them to the Canada Pension Plan Account or the Additional Canada Pension Plan Account` FALSE TRUE)
